1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"God i tutua ma ra kalukal,","poem":1},{"lineBreak":true},{"text":"RA Luluai ma ra nilai ra tavur.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Avat a kakailai na pite varpa tadav God,","poem":1},{"lineBreak":true},{"text":"Avat a kakailai na pite varpa;","poem":1},{"lineBreak":true},{"text":"Avat a kakailai na pite varpa tadav kada King,","poem":1},{"lineBreak":true},{"text":"Avat a kakailai na pite varpa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tago God i king ta ra rakarakan a gunagunan par,","poem":1},{"lineBreak":true},{"text":"Avat a kakailai na pite varpa ma ra mari na kakailai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"God i varkurai na king pire ra lavur vuna tarai.","poem":1},{"lineBreak":true},{"text":"God i tar ki ta kana kiki gomgom.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A umana luluai kai ra tarai dia tar ki varurung,","poem":1},{"lineBreak":true},{"text":"Diat ma ra tarai kai ra God kai Abaraam;","poem":1},{"lineBreak":true},{"text":"Tago God i kure ra lavur luluai ta ra rakarakan a gunagunan;","poem":1},{"lineBreak":true},{"text":"Ia iat i tar ngala kakit.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}