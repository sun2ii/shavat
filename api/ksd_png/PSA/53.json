{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":53,"content":[{"type":"heading","content":["A kaina mangamangana kai ra tarai (Kak 14)"]},{"type":"hebrew_subtitle","content":["Kai nina i lue ra kakailai; a tiun Makalat; a mari na kakailai kai David."]},{"type":"verse","number":1,"content":[{"text":"A papaua i varpuai ta ra balana dari: Pa ta God.","poem":1},{"lineBreak":true},{"text":"Dia ga pait ra kaina magit, a magit i milmilikuan tuna;","poem":1},{"lineBreak":true},{"text":"Pa ta na ba i pait ra boina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"God i gigira ba marama ra bala na bakut,","poem":1},{"lineBreak":true},{"text":"Ina upi ra umana natu i ra tarai,","poem":1},{"lineBreak":true},{"text":"Kan ta na dia minana","poem":1},{"lineBreak":true},{"text":"Ma dia tikan upi God.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Diat par dia tar vana rara, dia tar dur par,","poem":1},{"lineBreak":true},{"text":"Pa ta na ba i pait ra boina, maia pa, pa ta tikai ka.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dave; ra umana tena varpiam pa dia minana vang?","poem":1},{"lineBreak":true},{"text":"Diat ba dia en vue kaugu tarai da dia en ra adia magit,","poem":1},{"lineBreak":true},{"text":"Ma pa dia araring tadav God.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dia ga burut i tuna, ma pa ta vuna;","poem":1},{"lineBreak":true},{"text":"Tago God i kabu vue vanavana ra uru i diat dia tut na vinarubu ure u.","poem":1},{"lineBreak":true},{"text":"U tar varuva diat, tago God i pilak vue diat.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Boina ba ra valavalaun na ga vana rikai maro Sion!","poem":1},{"lineBreak":true},{"text":"Ba God na ben vatalil kana tarai di ga kinim vavilavilau diat,","poem":1},{"lineBreak":true},{"text":"Iakob na manga gugu, ma Israel na ga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}