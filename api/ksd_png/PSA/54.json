{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"heading","content":["A niaring upi ra varbalaurai kan ra ebar"]},{"type":"hebrew_subtitle","content":["Kai nina i lue ra kakailai; a mari na kakailai kai David, ba ra tarai Sip dia vana ma dia biti tai Saul: Dave, David pa i parau vang livuan ta vevet?"]},{"type":"verse","number":1,"content":[{"text":"God, una valaun iau ure ra iangim,","poem":1},{"lineBreak":true},{"text":"Ma una varkurai ure iau ma ra dekdekim.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"God una valongore kaugu niaring,","poem":1},{"lineBreak":true},{"text":"Ma ra tinata na ngiegu na ruk ta ra talingam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tago ra umana vaira dia tar tut ure iau,","poem":1},{"lineBreak":true},{"text":"Ma ra umana tena vinarubu dia tar mainge ba diat a ubu iau;","poem":1},{"lineBreak":true},{"text":"God pa i tur ta ra luaina mata i diat. Sela.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ea, God kaugu tena maramaravut,","poem":1},{"lineBreak":true},{"text":"A Luluai iat i tukatukal kaugu nilaun.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na bali ra kaina magit ta kaugu umana ebar;","poem":1},{"lineBreak":true},{"text":"Una vamutue diat varogop ma ra dovot na maukuam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ina vartabar piram ma ra tamarigat na vartabar;","poem":1},{"lineBreak":true},{"text":"Luluai, ina pite pa ra iangim tago i boina.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tago i tar valangalanga iau kan ra lavur magit par i monong iau;","poem":1},{"lineBreak":true},{"text":"Ma ra matagu i tar gire ra magit iau mainge pire kaugu umana ebar.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}