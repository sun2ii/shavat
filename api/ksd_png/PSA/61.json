{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"heading","content":["A niaring upi ra varbalaurai"]},{"type":"hebrew_subtitle","content":["Kai nina i lue ra kakailai; ta ra pagol; kai David."]},{"type":"verse","number":1,"content":[{"text":"Una valongore kaugu kinail, God;","poem":1},{"lineBreak":true},{"text":"Una torom ta kaugu niaring.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Maro iat ra ngu na rakarakan a gunagunan ina kail u, ba i tup ra balagu;","poem":1},{"lineBreak":true},{"text":"Una ben vatutua iau ra ul a vat ki, nina i manga tuluai urama.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tago u a rivarivan piragu,","poem":1},{"lineBreak":true},{"text":"Ma a dekdek na pal na bakbakit kan ra ebar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ina ki vatikai ta ra kubam;","poem":1},{"lineBreak":true},{"text":"Boina ba ina rivarivan ta ra vavai na bebeam. Sela.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tago u, God, u tar valongore kaugu lavur vavalima,","poem":1},{"lineBreak":true},{"text":"U tar tul tar ra tiniba tagu kadiat dia ru ra iangim.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Una ga valolovina ra nilaun kai ra king;","poem":1},{"lineBreak":true},{"text":"Kana lavur kilala diat a varogop ma ra kilala kai ra mangoro na taun tarai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Na ki vatikai ta ra luaina mata i God;","poem":1},{"lineBreak":true},{"text":"Una tul tar ra varmari ma ra dovotina upi dir a balaure.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Damana ina kakailai na pite varpa pa na mutu,","poem":1},{"lineBreak":true},{"text":"Upi ina pait ot pa kaugu umana vavalima ta ra bungbung par.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}