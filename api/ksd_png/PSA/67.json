{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"heading","content":["A kakailai na pite varpa"]},{"type":"hebrew_subtitle","content":["Kai nina i lue ra kakailai; ta ra pagol; a kakailai."]},{"type":"verse","number":1,"content":[{"text":"God, una mari avet, ma una tata vadoane avet,","poem":1},{"lineBreak":true},{"text":"A matam na pupua taun avet; Sela.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Upi da nunure kaum mangamangana ati ra pia,","poem":1},{"lineBreak":true},{"text":"Ma kaum valavalaun ta ra lavur vuna gunan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Boina ba ra lavur vuna tarai diat a pite pa u, God,","poem":1},{"lineBreak":true},{"text":"Boina ba ra lavur vuna tarai par diat a pite pa u.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Boina ba ra lavur vuna gunan diat a ga, ma diat a kakailai ure ra gugu;","poem":1},{"lineBreak":true},{"text":"Tago una ga kure ra lavur vuna tarai ma ra takodo na varkurai,","poem":1},{"lineBreak":true},{"text":"Ma una lualua ta ra lavur vuna gunan ati ra pia. Sela.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Boina ba ra lavur vuna tarai diat a pite pa u, God,","poem":1},{"lineBreak":true},{"text":"Boina ba ra lavur vuna tarai par diat a pite pa u.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"A pia i tar tul tar ra vuaina;","poem":1},{"lineBreak":true},{"text":"God, maia pa, kada God iat, na vadoane dat,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"God na vadoane dat,","poem":1},{"lineBreak":true},{"text":"Ma ra lavur ngu na rakarakan a gunagunan diat a ru ia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}