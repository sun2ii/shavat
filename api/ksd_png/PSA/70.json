{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"heading","content":["A niaring upi ra maramaravut"]},{"type":"hebrew_subtitle","content":["Kai nina i lue ra kakailai; kai David; upi ra varvanuknuk."]},{"type":"verse","number":1,"content":[{"text":"Una pampam, God, upi una valaun iau,","poem":1},{"lineBreak":true},{"text":"Una pampam, Luluai, upi una maravut iau.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Boina ba diat dia nuk upi kaugu nilaun,","poem":1},{"lineBreak":true},{"text":"Diat a vavirvir ma diat a malari;","poem":1},{"lineBreak":true},{"text":"Diat dia gugu ta kaugu kinadik,","poem":1},{"lineBreak":true},{"text":"I boina ba da pukue vatalil diat ma da varuva diat.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Boina ba diat a takap ure kadia vavirvir,","poem":1},{"lineBreak":true},{"text":"Diat ba dia biti: Ioi! Ioi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Diat dia tikatikan up u, boina ba diat a gugu, ma diat a ga par tam.","poem":1},{"lineBreak":true},{"text":"Ma diat dia mainge kaum valavalaun, diat a biti varikai dari:","poem":1},{"lineBreak":true},{"text":"Da pite vangala pa God!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ma iau, a malari na tutana ma a luveana iau,","poem":1},{"lineBreak":true},{"text":"God, una rurut ma una tadav iau.","poem":1},{"lineBreak":true},{"text":"U kaugu tena maramaravut ma kaugu tena valaun,","poem":1},{"lineBreak":true},{"text":"Luluai, koko una vavabing.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}