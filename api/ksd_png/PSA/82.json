a valangalanga diat kan ra lima i ra umana tena varpiam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Pa dia kabinana ma pa dia minana;","poem":1},{"lineBreak":true},{"text":"Dia vana vurvurbit ta ra bobotoi;","poem":1},{"lineBreak":true},{"text":"A vunapaina par kai ra rakarakan a gunagunan i tariri.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Iau ga biti: Ava da ra umana god,","poem":1},{"lineBreak":true},{"text":"Ma avat par a umana natu i ra Ngala Kakit.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"la kaka avat a mat da ra tarai,","poem":1},{"lineBreak":true},{"text":"Ma avat a virua da tika na luluai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Una tut, God, una kure ra rakarakan a gunagunan,","poem":1},{"lineBreak":true},{"text":"Tago una kale pa boko ra lavur vuna tarai par.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}