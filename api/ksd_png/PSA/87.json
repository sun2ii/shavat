{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"heading","content":["A pite varpa ure Ierusalem"]},{"type":"hebrew_subtitle","content":["A kakailai kai ra tarai Kora."]},{"type":"verse","number":1,"content":[{"text":"Ra Luluai i vung ra vunapaina iat ta ra luana gomgom,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ra Luluai i manga manane ra umana matakilalat i Sion,","poem":1},{"lineBreak":true},{"text":"Ta ra lavur pia na pal kai Iakob.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Di tatike ra lavur enana tinata ure u","poem":1},{"lineBreak":true},{"text":"Ra pia na pal kai God. Sela.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ina vatang Rab ma Babilon varurung ma diat dia nunure iau;","poem":1},{"lineBreak":true},{"text":"Gire Pilistia, ma Tiro, ma Etiopia;","poem":1},{"lineBreak":true},{"text":"Di ga kava To An aro;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Maia, da biti ure Sion:","poem":1},{"lineBreak":true},{"text":"Di ga kava go ra tutana ba nam tana.","poem":1},{"lineBreak":true},{"text":"Ma ra Ngala Kakit iat na vatur vapadikat ia.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ba i tumu vake ra tarai, ra Luluai na biti dari: Go di ga kava ie. Sela.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ma diat a kakailai, ma diat a malagene dari:","poem":1},{"lineBreak":true},{"text":"A lavur vunapai kaugu gugu dia tur piram.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}