{"translation":{"id":"ksd_png","name":"A BUK TABU A MAULANA KUNUBU ma A KALAMANA KUNUBU","website":"https://ebible.org/Scriptures/details.php?id=ksd","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ksd","licenseNotes":null,"shortName":"PNG","englishName":"Kauana Bible","language":"ksd","textDirection":"ltr","sha256":"ab470256e9a375b0a5231d91a8ea6338e40d4f2c6a3c8f4f4bfec5d03e97a5dd","availableFormats":["json"],"listOfBooksApiLink":"/api/ksd_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31095,"languageName":"Kuanua","languageEnglishName":"Kuanua"},"book":{"id":"PSA","translationId":"ksd_png","name":"A Umana Kakailai","commonName":"A Umana Kakailai","title":"A UMANA KAKAILAI","order":19,"numberOfChapters":150,"sha256":"50104c6878acbefa9b3bdebc1d0fdcef1efdb675fce8a626913bb88a2b0e5d52","firstChapterNumber":1,"firstChapterApiLink":"/api/ksd_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ksd_png/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"heading","content":["God ia ra King"]},{"type":"verse","number":1,"content":[{"text":"Ra Luluai i ki na king; i mong ma ra minamar;","poem":1},{"lineBreak":true},{"text":"Ra Luluai i mong, i vi pit ma ra niongor;","poem":1},{"lineBreak":true},{"text":"Maia, ra rakarakan a gunagunan i tur padikat ma pa na takari.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kaum kiki na king i tur padikat papa ania;","poem":1},{"lineBreak":true},{"text":"U tar laun papa amana iat.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"A lavur lovon ta dia noro, Luluai,","poem":1},{"lineBreak":true},{"text":"A lavur lovon ta dia noro muka,","poem":1},{"lineBreak":true},{"text":"A lavur lovon ta dia buabuai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ra Luluai arama liu i ngala,","poem":1},{"lineBreak":true},{"text":"I ngala ta dir ma ra roro na ta,","poem":1},{"lineBreak":true},{"text":"I ngala ta dir ma ra bobol na ta.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kaum lavur vartuluai dia dovot muka;","poem":1},{"lineBreak":true},{"text":"Luluai, a mangamangana gomgom i topa ra kubam vatikai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ksd_png/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ksd_png/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ksd_png/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}