{"translation":{"id":"kue_png","name":"YESUS KAMO WAKAI","website":"https://ebible.org/Scriptures/details.php?id=kue","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kue","licenseNotes":null,"shortName":"PNG","englishName":"Kuman NT","language":"kue","textDirection":"ltr","sha256":"dc11296c68144f21a55b3624995efd1752d81da2b0baa7bdee226fc30bf34990","availableFormats":["json"],"listOfBooksApiLink":"/api/kue_png/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7959,"languageName":"Kuman (Papua New Guinea)","languageEnglishName":"Kuman (Papua New Guinea)"},"book":{"id":"HEB","translationId":"kue_png","name":"Hibru","commonName":"Hibru","title":"HIBRU Yagl ta pepa muno bogl Hibru yomba tongwa","order":58,"numberOfChapters":13,"sha256":"8a06f4bad1168198dc57bbb62cc07e1365ec566fed77fafd6f690805f4d0bea4","firstChapterNumber":1,"firstChapterApiLink":"/api/kue_png/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/kue_png/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["God kamo yene Wam dinorkwa, ana Wam mogl mitna ende angelo engrukwa"]},{"type":"verse","number":1,"content":["Okuna imbo God enge merkinde taragl kanekane mina ka tau di nono neno kowano tongwa, i propet wagle drano mina yongo ditengwa."]},{"type":"verse","number":2,"content":["Ba enge erme i dundinagledi orko God yene Wam mina ka kaima dipene ende norkwa, i yene Wam mina dumo makan ya taragl prapra ere yongwa. Ana God yene Wam pinde indre taragl prapra inambuka pre tongwa."]},{"type":"verse","number":3,"content":["Yene Wam, Nem ambuglange i i-pene endungwa. Ana Wam yene Nem mere kuno yene kaima moglkwa, ye ka dumara i taragl prapra ake gidi pango yombuglo kande pangwa. Okuwo yomba prapra tandaglmeno koko ende kondo, ana ye ende heven suna pindre Nem yombuglo pond kaima pangwa moglmara ongo wokra amedi moglkwa."]},{"type":"heading","content":["God Wam Yaglkande kaima moglkwa"]},{"type":"verse","number":4,"content":["Nem kangiye kande yei Wam tongwa i pai mitna ende angelo wagle tongwa. Yeglpre, ye mogl mitna ende angelo wagle kangino engre atne ende tongwa."]},{"type":"verse","number":5,"content":["Okuna God ka yegl ta di angelomo wagle tekrukwa ikra Yesus pre yegl dungwa,",{"text":"“Ene na Wana, etne na ene Nen moglka.”","poem":1},"Te ka yegl ama ta dikrukwa,",{"text":"“Okuwo na ye Nem","poem":1},{"lineBreak":true},{"text":"moglmbo te ye na wana morambuka!”","poem":1}]},{"type":"verse","number":6,"content":["Kor dagl God Wam komuno ende makandle endungwa enge yegl dungwa,",{"text":"“God angelomo prapra ye","poem":1},{"lineBreak":true},{"text":"dembiye karaugl ere tenaglkwa.”","poem":1}]},{"type":"verse","number":7,"content":["Ye angelo wagle ditendre yegl dungwa,",{"text":"“Ye angelomo wagle ir","poem":1},{"lineBreak":true},{"text":"mereyegl ere yei, te","poem":1},{"lineBreak":true},{"text":"kongunmo yomba i donga","poem":1},{"lineBreak":true},{"text":"bauglo mereyegl ere yei orkwa.”","poem":1}]},{"type":"verse","number":8,"content":["Ba ye Wam pre yegl dungwa,",{"text":"“God O, ene sia kingnen","poem":1},{"lineBreak":true},{"text":"aimande kamun yenambuka.","poem":1},{"lineBreak":true},{"text":"Ene kingdomnen embriye","poem":1},{"lineBreak":true},{"text":"mambuno du-yene mina sugl motnga.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ene embriye mambuno","poem":1},{"lineBreak":true},{"text":"du-yene erikwa yomba wakai","poem":1},{"lineBreak":true},{"text":"kanga. Te mambuno kinde","poem":1},{"lineBreak":true},{"text":"erikwa ene kinde kanga.","poem":1},{"lineBreak":true},{"text":"Ene yegl etnga ipre, ene","poem":1},{"lineBreak":true},{"text":"Godnen, pinde indre kungo","poem":1},{"lineBreak":true},{"text":"ere tongo ene gun yendre","poem":1},{"lineBreak":true},{"text":"ana ene mogl-mitna ende","poem":1},{"lineBreak":true},{"text":"yombanma tau engre atne ende tenga.”","poem":1},{"noteId":0}]},{"type":"verse","number":10,"content":["Ye ama yegl dungwa,",{"text":"“Yaglkande okuna imbo","poem":1},{"lineBreak":true},{"text":"dumo makan mambuno bogl","poem":1},{"lineBreak":true},{"text":"ere yenga te kamun mitna","poem":1},{"lineBreak":true},{"text":"taragl prapra pangwa i ene","poem":1},{"text":"ongun mina ere yenga.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ana taragl prapra i","poem":1},{"lineBreak":true},{"text":"dundinambuka ba ene","poem":1},{"lineBreak":true},{"text":"aimande aimande mogl","poem":1},{"lineBreak":true},{"text":"panatnga, te taragl i prapra","poem":1},{"lineBreak":true},{"text":"kungugl gagl goglo kinde","poem":1},{"lineBreak":true},{"text":"omere yegl enaglkwa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ene makan ya kamun","poem":1},{"lineBreak":true},{"text":"mitna gagl suna olto mereyegl","poem":1},{"lineBreak":true},{"text":"ake peratnga, te makan ya","poem":1},{"lineBreak":true},{"text":"kamkua i kungugl gagl gugl","poem":1},{"lineBreak":true},{"text":"ende kor endimere yegl kor","poem":1},{"lineBreak":true},{"text":"ere yenatnga. Ba ene motnere yegl motn buglayungun ta dundikrambuka.”","poem":1}]},{"type":"verse","number":13,"content":["Okuna God ka yegl i angelomo suwarata ditekrukwa, ikra Yesus pre yegl dungwa,",{"text":"“Ene wu na onguna wokra","poem":1},{"lineBreak":true},{"text":"amedo, mogl emin ana okuwo","poem":1},{"lineBreak":true},{"text":"ene kundano ikine prapra","poem":1},{"lineBreak":true},{"text":"i-wu katn mina atnekra endinaglka.”","poem":1}]},{"type":"verse","number":14,"content":["Ana angelo wagle ye spirit wakai meglkwa pre, God eremogl yomba ta ere-inagledi prukwa mere, ana angelo wagle kongun tongo ye wu yombamo i akeple diteingwa."]}],"footnotes":[{"noteId":0,"caller":"+","text":"Buk Song 45:6,7","reference":{"chapter":1,"verse":9}}]},"thisChapterLink":"/api/kue_png/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kue_png/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kue_png/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}