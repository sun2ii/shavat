{"translation":{"id":"kue_png","name":"YESUS KAMO WAKAI","website":"https://ebible.org/Scriptures/details.php?id=kue","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kue","licenseNotes":null,"shortName":"PNG","englishName":"Kuman NT","language":"kue","textDirection":"ltr","sha256":"dc11296c68144f21a55b3624995efd1752d81da2b0baa7bdee226fc30bf34990","availableFormats":["json"],"listOfBooksApiLink":"/api/kue_png/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7959,"languageName":"Kuman (Papua New Guinea)","languageEnglishName":"Kuman (Papua New Guinea)"},"book":{"id":"LUK","translationId":"kue_png","name":"Luk","commonName":"Luk","title":"LUK Kamambuno Wakai Luk Muno Boglkwa","order":42,"numberOfChapters":24,"sha256":"bb4c749aea120a6ff233297d468cc2c1541b4cd2887b7aab1007c9add8bdad25","firstChapterNumber":1,"firstChapterApiLink":"/api/kue_png/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/kue_png/LUK/24.json","totalNumberOfVerses":1151},"chapter":{"number":3,"content":[{"type":"heading","content":["Jon Baptais kamambuno dungwa"]},{"type":"verse","number":1,"content":["Taiberias Sisa buglayungu 15 Rom kamun king moglkwa enge, Pontias Pailat ye Judia kamun gavman moglkwa, te Herot Galili kamun king moglkwa. Ye yene angigle Pilip Ituraia kamun ya te Trakonitis kamun king moglkwa, te Lisanias ye Abilini kamun king moglkwa."]},{"type":"verse","number":2,"content":["Ana Anas ya Kaiapas pris kande miurka, enge igle Sekaraia wam Jon makan waule suna moglmara God kamo ende ye mina ungwa."]},{"type":"verse","number":3,"content":["Ana Jon endpi Jodan Nigle dumo koglkoglo yei omara i pindre dipene ende tongwa, “Ene nomano yake tendre baptais erimbi, God ene tandaglmeno koko ende tenambuka.”"]},{"type":"verse","number":4,"content":["Propet Aisaia ka muno yegl boglko pangwa:",{"text":"“Makan waule suna yomba","poem":1},{"lineBreak":true},{"text":"ta wiyau endungwa,","poem":1},{"lineBreak":true},{"text":"‘Yaglkande pre konbaunamo","poem":1},{"lineBreak":true},{"text":"akekun eriyo. Ye unambuka","poem":1},{"lineBreak":true},{"text":"pre konbo si-ake du endiyo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Makan sunguno bengine","poem":1},{"lineBreak":true},{"text":"ormara sikausi kondiyo,","poem":1},{"lineBreak":true},{"text":"te makan muglo ya meglmbe","poem":1},{"lineBreak":true},{"text":"prapra si-ake daudi kondiyo.","poem":1},{"lineBreak":true},{"text":"Ana konbauna yewe-mawe","poem":1},{"lineBreak":true},{"text":"yenambuka si-ake du ende","poem":1},{"lineBreak":true},{"text":"kondiyo. Te konbauna kinde","poem":1},{"lineBreak":true},{"text":"ormara i si-ake wakai eriyo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ana yomba kanekane","poem":1},{"lineBreak":true},{"text":"God ere-inagledi orkwa i","poem":1},{"lineBreak":true},{"text":"mambuno kanaglkwa.’”","poem":1}]},{"type":"verse","number":7,"content":["Yomba merkinde kaima ende menda wu Jon moglmara baptais ere norambedi pre wingwa. Ana ye ditongwa, “Ene toki kinde wagle, God dem kumbrukwa ene mina una orkwa. Ira ene dite teke enaglkwa kuno orme dume?"]},{"type":"verse","number":8,"content":["Sragl yegl prapra ene kinde kondimbi, embriyeno wakai ombuno dinan, i ene kaima tandaglme kindekondo nomano yake teingwa. Ana enene mina suna mambuno bogl Abraham no kowano awano moglme dikraglkwa. Na ene yegl diteinga, God pra we dinan ana kombuglo i Abraham gawamo plau dinaglkwa."]},{"type":"verse","number":9,"content":["Dimaima endi prapra mambuno mina yeikondungwa. Ende prapra ta mongo wakai koglkrambuka okuwo boro gundi atne ende ana piyasi donga mina endinambuka.”"]},{"type":"verse","number":10,"content":["Ana yomba krapogl Jon teingwa, “Ana no sragl eramne?”"]},{"type":"verse","number":11,"content":["Jon yegl di ikine endungwa, “Yomba ta ye gaglsuna suwo ake ninan ta gugl yomba ta ake-nekrukwa tenambuka, te yomba ta kaiya mokna ta yenan ama yumbu suwondo.”"]},{"type":"verse","number":12,"content":["Takis ingwa yomba tau ama baptais era pre undre, ye krapeglkwa, “Beke Notnga, no sragl eramne?”"]},{"type":"verse","number":13,"content":["Ye yegl di ikine ende tongwa, “Ene takis merkinde i kawa tekriyo, gavman ditomere kuno ere i yo.”"]},{"type":"verse","number":14,"content":["Te kimbirnem tau ama undre krapogl ye teingwa, “Ana no sragl eramne?” Ye yegl di ikine ende tongwa, “Ene yomba monino yombuglo ere wausi inamunedi erekriyo, mo yomba kakimbi dite ka-tange tekriyo. Ene topono ingwa i pra kuno orkwa.”"]},{"type":"verse","number":15,"content":["Ana yomba prapra nomano poglodi pirkwa anduglko, ye mambuno bogl nomano suwo yongo, kinano gundo endingwa yongo, “Jon Mesaia moglmedi pirkwa.”"]},{"type":"verse","number":16,"content":["Yeglpre Jon yomba prapra ditongwa, “Na nigl mina ene baptais ereteinga. Ba okuwo yomba ta unambuka i yombuglomo pai mitna ende na yombura i engrukwa. Na yomba wakai ta moglmbo kade ye kagle towo mina kan tonguma pangwa i na ta pirka sinaglka kuno erekrukwa. Ye ene Holi Spirit ya te donga mina ene baptais ere tenambuka."]},{"type":"verse","number":17,"content":["Ye ikanmo sawol ake indre ungwa. Ye wit sundina prapra siplendi menda ende ana wit mongo gande i yene kaiya moknamo yungu yungugl endinambuka. Ba sundina mongo paikrambuka ye donga gongokre aimande depamara gagltenge erambuka.”"]},{"type":"verse","number":18,"content":["Ana Jon eremogl yomba nomano mina borambedi pre kamambuno wakai tau kanekane dipene ende tongwa."]},{"type":"heading","content":["Herot eremogl Jon kane sungwa"]},{"type":"verse","number":19,"content":["Ba Jon eremogl gavman Herot ka-tongwa, sraglpre okuna yene angigle embiye Herodias wike indre ana mambuno kinde tau mere ama orkwa."]},{"type":"verse","number":20,"content":["Ana Herot sragl kinde orkwa pamara ikra aine pandigl Jon sikane yungu suna endungwa."]},{"type":"heading","content":["Jon eremogl Yesus baptais eretongwa"]},{"type":"verse","number":21,"content":["Yomba prapra baptais ere kondingo, okuwo Yesus ama baptais orkwa. Ye kamange ere moglko, heven audungo,"]},{"type":"verse","number":22,"content":["Holi Spirit kua yumugl mereyegl ende atne ye moglmara ungwa. Ana heven imbo ka ta yegl dungwa, “Ene nana Wana, na ene wakai kandre nomana wakai ene teinga.”"]},{"type":"heading","content":["Yesus kowamo awamo kangino epigl"]},{"type":"verse","number":23,"content":["Yesus yene buglayungumo 30 orko, ana yomba ere-inambuka kongun mambuno bogl orkwa. Ye yagl gak moglkwa, yeglpre yomba Josep wam wedi pirkwa,",{"text":"te Josep Heli wam,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"te Heli Matat wam,","poem":1},{"lineBreak":true},{"text":"te Matat Levai wam,","poem":1},{"lineBreak":true},{"text":"te Levai Melki wam,","poem":1},{"lineBreak":true},{"text":"te Melki Janai wam,","poem":1},{"lineBreak":true},{"text":"te Janai Josep wam,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"te Josep Matatias wam,","poem":1},{"lineBreak":true},{"text":"te Matatias Amos wam,","poem":1},{"lineBreak":true},{"text":"te Amos Nahum wam,","poem":1},{"lineBreak":true},{"text":"te Nahum Esli wam,","poem":1},{"lineBreak":true},{"text":"te Esli Nagai wam,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"te Nagai Mat wam,","poem":1},{"lineBreak":true},{"text":"te Mat Matatias wam,","poem":1},{"lineBreak":true},{"text":"te Matatias Semen wam,","poem":1},{"lineBreak":true},{"text":"te Semen Josek wam,","poem":1},{"lineBreak":true},{"text":"te Josek Joda wam,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"te Joda Joanan wam,","poem":1},{"lineBreak":true},{"text":"te Joanan Resa wam,","poem":1},{"lineBreak":true},{"text":"te Resa Serubabel wam,","poem":1},{"lineBreak":true},{"text":"te Serubabel Sialtiel wam,","poem":1},{"lineBreak":true},{"text":"te Sialtiel Neri wam,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"