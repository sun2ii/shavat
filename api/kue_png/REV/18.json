{"translation":{"id":"kue_png","name":"YESUS KAMO WAKAI","website":"https://ebible.org/Scriptures/details.php?id=kue","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kue","licenseNotes":null,"shortName":"PNG","englishName":"Kuman NT","language":"kue","textDirection":"ltr","sha256":"dc11296c68144f21a55b3624995efd1752d81da2b0baa7bdee226fc30bf34990","availableFormats":["json"],"listOfBooksApiLink":"/api/kue_png/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7959,"languageName":"Kuman (Papua New Guinea)","languageEnglishName":"Kuman (Papua New Guinea)"},"book":{"id":"REV","translationId":"kue_png","name":"Ka Teke Pangwa","commonName":"Ka Teke Pangwa","title":"KA TEKE PANGWA Ka i Yesus Krais dipene ende Jon tongwa","order":66,"numberOfChapters":22,"sha256":"b6157ac5ace468d1a2d71abe35ec35a3c6016330e3ced8fc86e4e1b5abc390a1","firstChapterNumber":1,"firstChapterApiLink":"/api/kue_png/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/kue_png/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":18,"content":[{"type":"heading","content":["Babilon kamun yangesi deruwagl orkwa"]},{"type":"verse","number":1,"content":["Ana i dundungo na kaninga angelo ta heven imbo ende atne ungwa. Ye yombuglomo giglendi pango te ekinmo ambuglange pond sungo ana makan mundu ambuglange sungwa."]},{"type":"verse","number":2,"content":["Ye agle binan bogl yegl dungwa:",{"text":"“Babilon dumo kande yange","poem":1},{"lineBreak":true},{"text":"sungwa! Babilon kamun","poem":1},{"lineBreak":true},{"text":"yangesi deruwagl ere","poem":1},{"lineBreak":true},{"text":"kondungwa! Erme ye wu spirit","poem":1},{"lineBreak":true},{"text":"kinde angaimo orkwa ana","poem":1},{"lineBreak":true},{"text":"spirit kinde prapra ya kua","poem":1},{"lineBreak":true},{"text":"kinde deglmbi yeingwa akiye igle meglkwa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sraglpre, yomba makan","poem":1},{"lineBreak":true},{"text":"koglkoglo meglkwa i ye akiye","poem":1},{"lineBreak":true},{"text":"kunogl gundingwa. I ye","poem":1},{"lineBreak":true},{"text":"wainmo gigle dungwa","poem":1},{"lineBreak":true},{"text":"mereyegl neingwa, makandle","poem":1},{"lineBreak":true},{"text":"king wagle ye bogl ama","poem":1},{"lineBreak":true},{"text":"mambuno kinde erikwa. Te","poem":1},{"lineBreak":true},{"text":"makandle yomba diminge ya","poem":1},{"lineBreak":true},{"text":"kungugl gagl bona topo ere","poem":1},{"lineBreak":true},{"text":"ake nina pre kongun erikwa","poem":1},{"lineBreak":true},{"text":"yomba ye mambunomo kinde","poem":1},{"lineBreak":true},{"text":"kanekane angai goglkrukwa i","poem":1},{"lineBreak":true},{"text":"ere moni kande gundo ingwa.”","poem":1}]},{"type":"verse","number":4,"content":["Ana heven imbo ka ta atne ungo na pirka yegl dungwa:",{"text":"“Na yombanma wagle,","poem":1},{"lineBreak":true},{"text":"kamun i kindekondo ende","poem":1},{"lineBreak":true},{"text":"menda wiyo. Yegl erekrimbi ye","poem":1},{"lineBreak":true},{"text":"bogl akiye tandaglme ere","poem":1},{"lineBreak":true},{"text":"dinaglkwa te ye mambunomo","poem":1},{"lineBreak":true},{"text":"kinde orkwa i topomo ene akiye i-dinaglkwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ye tandaglme kinde orkwa i","poem":1},{"lineBreak":true},{"text":"bir tembe tembe yei ende","poem":1},{"lineBreak":true},{"text":"mitna imbo ongo heven ake","poem":1},{"lineBreak":true},{"text":"yungwa, ana mambuno kinde","poem":1},{"lineBreak":true},{"text":"orkwa i God aimande poglodi pir moglkwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ye mambuno kinde ere ene","poem":1},{"lineBreak":true},{"text":"tomere yegl ene kuno yegl","poem":1},{"lineBreak":true},{"text":"ere te ikine endinaglkwa, ye","poem":1},{"lineBreak":true},{"text":"mambuno kinde orkwa i pre","poem":1},{"lineBreak":true},{"text":"ene aglke aglke sidakagl ere","poem":1},{"lineBreak":true},{"text":"te ikine endinaglkwa. Ye nigl","poem":1},{"lineBreak":true},{"text":"gigle dungwa kap mina sikugl","poem":1},{"lineBreak":true},{"text":"magle endumere yegl ene","poem":1},{"lineBreak":true},{"text":"ama kuno yegl aglke aglke","poem":1},{"lineBreak":true},{"text":"sikugl magle ende ye","poem":1},{"lineBreak":true},{"text":"ninambuka pre tenaglkwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ye yene nendre indre","poem":1},{"lineBreak":true},{"text":"kangiye ake mitna ende te","poem":1},{"lineBreak":true},{"text":"karaugl engrukwa, ye karaugl","poem":1},{"lineBreak":true},{"text":"engrumere yegl ana ene giu","poem":1},{"lineBreak":true},{"text":"merkinde ereteiyo. Ene yegl","poem":1},{"lineBreak":true},{"text":"ereteimbi ye kai merkinde erambuka.","poem":1},{"lineBreak":true},{"text":"Ye nomane suna yegl","poem":1},{"lineBreak":true},{"text":"prukura, ‘Na ambu werai ta","poem":1},{"lineBreak":true},{"text":"moglkrika, na ambu kande","poem":1},{"lineBreak":true},{"text":"kuwin moglka. Ipre na ambu","poem":1},{"lineBreak":true},{"text":"kuwin mereyegl sia mina","poem":1},{"lineBreak":true},{"text":"amediga te kai kaima ta erekraglka.’","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ye yegl pir moran taragl","poem":1},{"lineBreak":true},{"text":"kundugl ongo kanekane i","poem":1},{"lineBreak":true},{"text":"ande enge suwarata ye mina","poem":1},{"lineBreak":true},{"text":"unongugl pi tenambuka. Kinde","poem":1},{"lineBreak":true},{"text":"imbo kanekane sinan te","poem":1},{"lineBreak":true},{"text":"kindan pond yenan ana","poem":1},{"lineBreak":true},{"text":"yomba kai mungonbugl","poem":1},{"lineBreak":true},{"text":"eraglkwa. Ana Babilon kamun","poem":1},{"lineBreak":true},{"text":"endi donga mina de","poem":1},{"lineBreak":true},{"text":"kondinambuka. Sraglpre,","poem":1},{"lineBreak":true},{"text":"Yaglkande God giglekui","poem":1},{"lineBreak":true},{"text":"dungwa eremogl ye","poem":1},{"lineBreak":true},{"text":"mambunono kinde i yumbusi","poem":1},{"lineBreak":true},{"text":"tendre ana topo te ikine endinambuka.","poem":1}]},{"type":"verse","number":9,"content":["“Makan koglkoglo king ye bogl kunogl gundingwa te ye bogl mambuno guagua kanekane erikwa ye endi donga detenge eran inge kandre kai ninga dungwa ere munburaglkwa."]},{"type":"verse","number":10,"content":["Ye giu kande yungwa ipre kundugl gogl ana ye eglkekra andigl mogl kai ere yegl dinaglkwa:",{"text":"“‘Yumbun kande pana","poem":1},{"lineBreak":true},{"text":"orkwa! Yumbun kande pana","poem":1},{"lineBreak":true},{"text":"orkwa! Babilon siti kande ene","poem":1},{"lineBreak":true},{"text":"yombutn kande pangwa","poem":1},{"lineBreak":true},{"text":"motnga. Ande kuiya suwara","poem":1},{"lineBreak":true},{"text":"mina ene topon kinde plaudi tongwa iwe!’","poem":1}]},{"type":"verse","number":11,"content":["“Makan koglkoglo yomba prapra taragl kanekane ye mina topo ere-ere erikwa yomba ye kai ninga dungwa ere ana Babilon pre munburaglkwa. Sraglpre, ye bonano aglketa topo eraglkwa. Tamanga."]},{"type":"verse","number":12,"content":["Bona gana i gol ya silva ya kombuglo wakai kaima ya bis topo kande boglkwa ya gagl alap kruwo wakai ya te gagl alap gogl kanekane ya te gagl-silka. Te endi kanekane demine wakai orkwa ya taragl kanekane bugla-elepant singiye mina bekingwa ya taragl kanekane endi mina bekigo topo kande boglkwa ya bras ya ain ya te kombuglo muno kanekane pangwa."]},{"type":"verse","number":13,"content":["Ana bona gana tau yegl. Sinamon ya neingwa gene ya endi inge demine orkwa paura ya taragl nuglo kanekane demine wakai orkwa ya wel sanda wakai ya wain ya olip nuglo te plawa wakai ya wit ya bugla-kau ya sipsip ya bugla-hos ye karmo gundo i wangwa bogl ya te nigl-kongun yoko erikwa yomba ya te yomba tau kuiyano bogl taragl i prapra ta topo eraglkwa mere manga."]},{"type":"verse","number":14,"content":["“Ye mina taragl topo ere-ere erikwa yomba yegl dinaglkwa, ‘Ene taragl mundun pango inagledi pitnga i ene kindekondo ende wu eglke ongwa. Bugla mokna wakai topo kande boglkwa ya ene ekinen wakai i prapra ene kinde kondingwa. Taragl yeglmere ene mina aglketa wu panan yomba kankraglkwa.’"]},{"type":"verse","number":15,"content":["Ana sitimo i giugl kande inan yomba taragl topo bogl indre ana minge moni kande sigundo ingwa, yomba ye kundugl pond gogl ana eglkekra andigl mogl kai ertre nomano kinde eran:"]},{"type":"verse","number":16,"content":["ana ye yegl dinaglkwa:",{"text":"“‘Yumbun kande pana","poem":1},{"lineBreak":true},{"text":"orkwa! Siti kande i yumbun","poem":1},{"lineBreak":true},{"text":"kande pana orkwa! Ene","poem":1},{"lineBreak":true},{"text":"gaglsuna wakai gogl ya kum","poem":1},{"lineBreak":true},{"text":"endungwa endindre ana gol","poem":1},{"lineBreak":true},{"text":"ya te kombuglo wakai ya bis","poem":1},{"lineBreak":true},{"text":"topo kande boglkwa ekin gatnga!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ande kuiya suwarata keme","poem":1},{"lineBreak":true},{"text":"kungugl gagl wakai ya minge","poem":1},{"lineBreak":true},{"text":"moni sragl prapra erekinde erekondungwa!’","poem":1},"“Te sip guma akingwa yomba prapra ya te sip mina waningwa yomba prapra ya te sip mina kongun erikwa yomba te sip mina taragl topo bogl i-i erikwa yomba, ye eglkekuri andigl moraglkwa."]},{"type":"verse","number":18,"content":["Ana Babilon donga denan ye inge kandre, kaglkane yegl inaglkwa, ‘Siti kande kuno yeglmere ta yomo?’"]},{"type":"verse","number":19,"content":["Ye yungum gamba bitno mina engre miriye pond gogl kai ere ama nomane kinde eriko yegl dingwa:",{"text":"“‘Yumbun kande pana orkwa!","poem":1},{"lineBreak":true},{"text":"Yumbun kande pana orkwa!","poem":1},{"lineBreak":true},{"text":"Sip mundi nigle paingwa i","poem":1},{"lineBreak":true},{"text":"ake-neingwa yomba ende","poem":1},{"lineBreak":true},{"text":"aglo eime? Ye siti i monimo","poem":1},{"lineBreak":true},{"text":"mina ye moni pond sidagl","poem":1},{"lineBreak":true},{"text":"ake-neingwa ana ande kuiya","poem":1},{"lineBreak":true},{"text":"suwara keme ye pra kinde ere kondingwa!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Heven ya God yombama","poem":1},{"lineBreak":true},{"text":"du-wakai ya aposel wagle ya","poem":1},{"lineBreak":true},{"text":"te propet wagle ene gun","poem":1},{"lineBreak":true},{"text":"pond yeiyo, ana siti i kinde","poem":1},{"lineBreak":true},{"text":"ere kondungwa! Sraglpre, ene","poem":1},{"lineBreak":true},{"text":"erekinde eretomere ikra God","poem":1},{"lineBreak":true},{"text":"mongo punduwo bagl te ikine endungwa.’”","poem":1}]},{"type":"verse","number":21,"content":["Ana angelo giglekui dungwa ta wit siderwagl erikwa kombuglo kande yeglmere ta ake i-mitna ende piyasi mundi nigl suna ende, yegl dungwa:",{"text":"“Mambuno yeglmere Babilon","poem":1},{"lineBreak":true},{"text":"siti kande muglkumdi piyasi","poem":1},{"lineBreak":true},{"text":"endimbi ende atne enan","poem":1},{"lineBreak":true},{"text":"yomba aglketa kankraglkwa.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Te gita singwa yomba","poem":1},{"lineBreak":true},{"text":"ya tambagle singwa yomba","poem":1},{"lineBreak":true},{"text":"ya puming singwa yomba","poem":1},{"lineBreak":true},{"text":"ya biukul bu dingwa yomba","poem":1},{"lineBreak":true},{"text":"i ene mina aglketa simbi","poem":1},{"lineBreak":true},{"text":"pirkraglkwa. Te kongun","poem":1},{"lineBreak":true},{"text":"kanekane beke pirkan erikwa","poem":1},{"lineBreak":true},{"text":"yomba ye aglketa ene mina","poem":1},{"lineBreak":true},{"text":"meglmbi kankraglkwa. Te wit","poem":1},{"lineBreak":true},{"text":"siderwagl erikwa kombuglo i","poem":1},{"lineBreak":true},{"text":"aglketa kiglekoi dinan pirkraglkwa.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ken-lam suwarata ene","poem":1},{"lineBreak":true},{"text":"mina aglketa ambuglange","poem":1},{"lineBreak":true},{"text":"sinan kankraglkwa. Ana yagl","poem":1},{"lineBreak":true},{"text":"ambu kor bogl inaglkwa","poem":1},{"lineBreak":true},{"text":"nunguno embriye ene mina","poem":1},{"lineBreak":true},{"text":"aglketa dimbi pirkraglkwa.","poem":1},{"lineBreak":true},{"text":"Okuna ene yombanma taragl","poem":1},{"lineBreak":true},{"text":"mere ake ne topo bogl i-i","poem":1},{"lineBreak":true},{"text":"erikwa yomba ye makandle","poem":1},{"lineBreak":true},{"text":"yomba kande meglkwa. Ene","poem":1},{"lineBreak":true},{"text":"nimbine kinde di yomba koglkoglo i-toro tenga.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ana siti suna igle propet","poem":1},{"lineBreak":true},{"text":"wagle ya God yombama duwakai ya te yomba tau","poem":1},{"lineBreak":true},{"text":"makandle sigeglkwa ye","poem":1},{"lineBreak":true},{"text":"bormaino ene mina suna","poem":1},{"lineBreak":true},{"text":"paimoglkwa pre yegl eretenaglkwa.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kue_png/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kue_png/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kue_png/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}