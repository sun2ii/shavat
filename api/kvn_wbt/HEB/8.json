{"translation":{"id":"kvn_wbt","name":"Pab tummad karta pab Jesucristobal igal-pin mezhijad","website":"https://ebible.org/Scriptures/details.php?id=kvnNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kvnNT","licenseNotes":null,"shortName":"WBT","englishName":"Border Kuna NT","language":"kvn","textDirection":"ltr","sha256":"32d2449ce91bd4006797e81bdf519e6dcea0d240ea136b9ac9518568d1cea88e","availableFormats":["json"],"listOfBooksApiLink":"/api/kvn_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7934,"languageName":"Border Kuna","languageEnglishName":"Border Kuna"},"book":{"id":"HEB","translationId":"kvn_wbt","name":"Hebreos","commonName":"Hebreos","title":"Hebreo-tulemalga Karta Nermalejad Hebreos","order":58,"numberOfChapters":13,"sha256":"f00a55f93c80cd987cb6614cf508b86fec6eea3b7466e4de2397efd854f731a1","firstChapterNumber":1,"firstChapterApiLink":"/api/kvn_wbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/kvn_wbt/HEB/13.json","totalNumberOfVerses":299},"chapter":{"number":8,"content":[{"type":"heading","content":["Jesús anmal-irwal-Pab-Tummadzhe-koled-pul-tummadga mai"]},{"type":"verse","number":1,"content":["Imi anmal chunmananimaldo: anmal tule-irwal-Pabzhe-koled-pul-tummad-nikamal. Wedin Jesús, tenal Jesús nikpa-neggin Pab-Pul-Tummad-kan-nuedzhik pato tule-tummadga chii."]},{"type":"verse","number":2,"content":["Tenal Jesús Pab-maid-neggin arpamai. Tenal we negdin Pab-maid-neg-chunchunnad, tenal Pab Tummad we neg opinnis, tulemal kwen chobzhajulmal."]},{"type":"verse","number":3,"content":["Imi tule-irwal-Pabzhe-koled-pul-tummagan-pel-kwapa nugzhales Pab Tummadga immal ukegal, tegin Pabga immal-okuggalbal. Al Jesús Pab Tummadga immal uked-wilubmo."]},{"type":"verse","number":4,"content":["Tenal iti-napkin tule-irwal-Pabzhe-kolmalad íchejul nika Moisés-igal-mamikidbal Pabga immal ukegal. Al Jesús imis iti-napkin mailen, tule-irwal-Pabzhe-koledga kwen kuszhulin."]},{"type":"verse","number":5,"content":["Tenal tule-irwal-Pabzhe-kolmaladdin iti-napkin Pab-Tummad-megwed-neggin arpananimal. Tenal we negdin pinche wilub-oyonai, nikpa Pab-maid-neggin igi arpale. Al Moisés Pab-megwed-neg chobbi-kualgu, Pab Tummad Moisésga chogzhado:",{"text":"Tenal pedin nue taker,","poem":1},{"lineBreak":true},{"text":"imi an akpene pega yalgin oyojad-yopí","poem":1},{"lineBreak":true},{"text":"pe an-neg chobmogo.","poem":1},"Ex. 25:40"]},{"type":"verse","number":6,"content":["Tenal Jesúsdin tule-irwal-Pabzhe-kolmalad-pimaladga pul arpaged-nued nika. Tenal Pab Tummad pul kaka-nuegan-ukcha-choggu, al Pab Tummad Jesúsbal pul igal-nued mezhis, Pab-akpene-Moisésbal-pul-igal-mezhijadga."]},{"type":"verse","number":7,"content":["Imi Pab kepegin tulemalbak aga igal-mezhijad nuedilen, igal-kwapid pal kwen mezhiszhulin."]},{"type":"verse","number":8,"content":["Tenal Pab Tummad takchagu tulemal kwen unnijulmal nuekwa nanegal, al Pabdin chogalzhun: “Antin igal-pid mesnebal.” Imi Pab-kartagin chogdo:",{"text":"Pab Tummad chog:","poem":1},{"lineBreak":true},{"text":"“Imi ibe noniko,","poem":1},{"lineBreak":true},{"text":"an Israel-tulemalbak","poem":1},{"lineBreak":true},{"text":"tegin Judá-tulemalbak igal-pin mesnebal.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tenal an-Egipto-akar tadgan-onosmaladgin","poem":1},{"lineBreak":true},{"text":"an igal-mezhijadyob an igal pal kwen mesnejul.","poem":1},{"lineBreak":true},{"text":"Imi teun tadgan an-igal-mezhijadyob","poem":1},{"lineBreak":true},{"text":"inniki kwen nanaszhulmal.","poem":1},{"lineBreak":true},{"text":"Al an we tulemal-ebeszhun.","poem":1},{"lineBreak":true},{"text":"Al tegidbal an igal-pin mesnejun.”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tegin Pab Tummad chogbal:","poem":1},{"lineBreak":true},{"text":"“Imi an Israel-tulemalbak igal mesne.","poem":1},{"lineBreak":true},{"text":"Tenal te-cholbal,","poem":1},{"lineBreak":true},{"text":"antin igal-mezhijadgin pinzhedi-kugal","poem":1},{"lineBreak":true},{"text":"Israel-tulemal-imako.","poem":1},{"lineBreak":true},{"text":"Tegin an Israel-tulemal-imabalo","poem":1},{"lineBreak":true},{"text":"aga ulubgin-akar we igalgin nued nanegal.","poem":1},{"lineBreak":true},{"text":"Tegin antin Israel-tulemalga","poem":1},{"lineBreak":true},{"text":"e-Pab-Tummadga kunoniko.","poem":1},{"lineBreak":true},{"text":"Tegin Israel-tulemal an-tulemalga kunonimalbalo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tenal te ibegin Israel-tulemalgin","poem":1},{"lineBreak":true},{"text":"an-chogzhadyob kunonikil,","poem":1},{"lineBreak":true},{"text":"Israel-tule e-neg-tikalbal-mamimalad-keg-pal-oturdakel,","poem":1},{"lineBreak":true},{"text":"tegin e-kwenadganga keg palchogbalil:","poem":1},{"lineBreak":true},{"text":"‘Pedin Pab-Tummad-wisguenab.’","poem":1},{"lineBreak":true},{"text":"Imi tulemal-pel-kwapa an-wisgunonimalo","poem":1},{"lineBreak":true},{"text":"tule-tummagan-ugakche","poem":1},{"lineBreak":true},{"text":"tegin tule-polgana-ugakchemo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tenal antin Israel-tulemal-iskued elio,","poem":1},{"lineBreak":true},{"text":"tegin antin Israel-tulemal-iskuedgin","poem":1},{"lineBreak":true},{"text":"pinzhedii pal kwen kuojul.”","poem":1},"Jer. 31:31-34"]},{"type":"verse","number":13,"content":["Imi Pab-igal-pin-mezhijadbal, choglenaido, we igal-chereddin pato ibga keg pal ku. Al Pab-Tummad-igal-chered-mezhijad pulejul pelgunoniko."]}],"footnotes":[]},"thisChapterLink":"/api/kvn_wbt/HEB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kvn_wbt/HEB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kvn_wbt/HEB/7.json","previousChapterAudioLinks":{},"numberOfVerses":13}