{"translation":{"id":"kvn_wbt","name":"Pab tummad karta pab Jesucristobal igal-pin mezhijad","website":"https://ebible.org/Scriptures/details.php?id=kvnNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kvnNT","licenseNotes":null,"shortName":"WBT","englishName":"Border Kuna NT","language":"kvn","textDirection":"ltr","sha256":"32d2449ce91bd4006797e81bdf519e6dcea0d240ea136b9ac9518568d1cea88e","availableFormats":["json"],"listOfBooksApiLink":"/api/kvn_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7934,"languageName":"Border Kuna","languageEnglishName":"Border Kuna"},"book":{"id":"REV","translationId":"kvn_wbt","name":"Apocalipsis","commonName":"Apocalipsis","title":"Pab-Jesús Juanga Immal-kuoed Oyojad Apocalipsis","order":66,"numberOfChapters":22,"sha256":"04f17146a71ec9b1491c5af8a8239481c59e7a022702a8728a2ffffa26800996","firstChapterNumber":1,"firstChapterApiLink":"/api/kvn_wbt/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/kvn_wbt/REV/22.json","totalNumberOfVerses":403},"chapter":{"number":18,"content":[{"type":"heading","content":["Angel chognonikid, Babilonia-neg-kwebur pato pelgus"]},{"type":"verse","number":1,"content":["Tegin an we immalmal-takchad-cholbal an takchabaldo, angel-pid Pab-neg-akar aktedani. Tenal we angel pela-pela kannaleged nika. Tegin angel-yer-taklegedbal, negdin pel-kwapa ibegwal kanoni."]},{"type":"verse","number":2,"content":["Tegin angel sapejul kolal, chogal:",{"text":"¡We neg-kwebur-tummad-Babiloniadin pato pelgus!","poem":1},{"lineBreak":true},{"text":"We negdin, nia-kaluga pes,","poem":1},{"lineBreak":true},{"text":"niamalbi ampagugal,","poem":1},{"lineBreak":true},{"text":"tegin chulub-mui-muimalga pes,","poem":1},{"lineBreak":true},{"text":"tegin immal-kukualed-iskanaga pel-kwapa pesbal.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¿Ibiga Babilonia-neg-kwebur pelgus pe ebinzhe?","poem":1},{"lineBreak":true},{"text":"Nabir.","poem":1},{"lineBreak":true},{"text":"Imi tule neg-kweburginmalad-chog-ilbal,","poem":1},{"lineBreak":true},{"text":"Babilonia-neg-kwebur immal-imanaid-takedbal","poem":1},{"lineBreak":true},{"text":"pél iskusmal,","poem":1},{"lineBreak":true},{"text":"tule-mumurgujadbal","poem":1},{"lineBreak":true},{"text":"omegin-yolenonikidgin koelenonimaladyob.","poem":1},{"lineBreak":true},{"text":"Tegin erreymal-iti-napkinmalad ampa we omegin yoledi-kujadyob,","poem":1},{"lineBreak":true},{"text":"pél iskunonimalmo.","poem":1},{"lineBreak":true},{"text":"Tegin Babilonia-neg-kweburginmalad wilub-okpis mani nikmaladbal,","poem":1},{"lineBreak":true},{"text":"tegin we tulemal pela-pela pul-immalmal-nuegan paknanimaladbal,","poem":1},{"lineBreak":true},{"text":"tule-iti-napkin-pela-pela-immalmal-uked-nikmalad","poem":1},{"lineBreak":true},{"text":"mani-ibganga kunonimal.","poem":1},{"lineBreak":true},{"text":"Al Pab Tummad, Babilonia-neg-kwebur-tummad opelononijun.","poem":1}]},{"type":"verse","number":4,"content":["Tegin an itosbal, Pab-neg-akar tule-kakapurwa-pid kolnonibal, chogal:",{"text":"Pemal-an-tulemal, pe Babilonia-neg-kwebur-akar aknimalo,","poem":1},{"lineBreak":true},{"text":"pe melle tule-iskuedgin-arkwas-pukmaladbak arkwangalmo,","poem":1},{"lineBreak":true},{"text":"tegin pe melle Babilonia-neg-kweburginmaladbak","poem":1},{"lineBreak":true},{"text":"ibe-pulegan-tanikoedgin wilemalgalmo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Imi Babilonia-neg-kweburgin-pukmalad","poem":1},{"lineBreak":true},{"text":"wilub-okpis iskuedginbi nanebukmal.","poem":1},{"lineBreak":true},{"text":"Al Pab Tummad Babilonia-neg-kweburginmalad-iskuedgin","poem":1},{"lineBreak":true},{"text":"pinzhediidbal, sapejul we tulemal-oturdanejun.","poem":1}]},{"type":"verse","number":6,"content":["Tegin an itosbal, tule-kakapurwa chogalbal:",{"text":"Pab Tummadye, imi tule-Babilonia-neg-kweburgin-pukmalad","poem":1},{"lineBreak":true},{"text":"tule-pimalad-yardajad-yopí,","poem":1},{"lineBreak":true},{"text":"pe Babilonia-tulemal-imamogoye,","poem":1},{"lineBreak":true},{"text":"tenal pe ilabogiid-wilub pe pul sapejul oturdakoye.","poem":1},{"lineBreak":true},{"text":"Tegin pedin murukkin ina-iskanagin tule-okobnaidyob,","poem":1},{"lineBreak":true},{"text":"pe ilabo ina-iskanagin Babilonia-tulemal-okobmogo,","poem":1},{"lineBreak":true},{"text":"we tulemal-owiogalye.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Imi Babilonia-neg-kweburginmalad","poem":1},{"lineBreak":true},{"text":"akpene aga tukin nug-otummosmal,","poem":1},{"lineBreak":true},{"text":"tegin peyedzhe aga tukin immalmal nikusmal","poem":1},{"lineBreak":true},{"text":"aga yer itomalgal.","poem":1},{"lineBreak":true},{"text":"Imi we tulemal","poem":1},{"lineBreak":true},{"text":"pela-pela immalmal nikanonimaladbal","poem":1},{"lineBreak":true},{"text":"aga nug-otummojad-yopí","poem":1},{"lineBreak":true},{"text":"imisgin pe chabzhul we tulemal-imamalmogo,","poem":1},{"lineBreak":true},{"text":"tegin pe pela-pela we tulemal owiomalbaloye.","poem":1},{"lineBreak":true},{"text":"Tenal tule-Babiloniagin-pukmalad","poem":1},{"lineBreak":true},{"text":"aga ulubgin tummarba-itogedgin chogmal:","poem":1},{"lineBreak":true},{"text":"“Anmal-neg-kweburdin, erreyyob chii;","poem":1},{"lineBreak":true},{"text":"egmal-neg-kweburganga pul neg-kwebur-tummad,","poem":1},{"lineBreak":true},{"text":"ome-tarbi-machered-purkwijadyobzhulid,","poem":1},{"lineBreak":true},{"text":"tegin anmal pukib-kwen-itononikojulmalbalo.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Al Pab-Pul-Tummad chogdo:","poem":1},{"lineBreak":true},{"text":"“Antin Babilonia-neg-kweburginmalad-oturdane.”","poem":1},{"lineBreak":true},{"text":"Imi Pab pela-pela kannaleged nika-choggu,","poem":1},{"lineBreak":true},{"text":"al Pab iba-kwénnagin Babilonia-neg-kweburga","poem":1},{"lineBreak":true},{"text":"pela-pela poni onononiko,","poem":1},{"lineBreak":true},{"text":"tegin tule-purkwed noniko,","poem":1},{"lineBreak":true},{"text":"tegin tulega pela-pela pukib-itoged noniko,","poem":1},{"lineBreak":true},{"text":"tegin tulega ukul-mejed naigunonibalo.","poem":1},{"lineBreak":true},{"text":"Tegidgin Babilonia-neg-kwebur chogin kummanonibalo.","poem":1}]},{"type":"verse","number":9,"content":["Tenal erreymal-iti-napkinmalad Babilonia-neg-kwebur-tummagangin yolesmal, tule omega, ome-pid-imajadyob. Tegin erreymal Babilonia-tummaganbak wilub-okpis immalmal-nuegan-nikadgin mes yer itosmalmo. Al we erreymal Babilonia-neg-kwebur-kummamaid-e-wa takalil, Babilonia-neg-kwebur-pelgujadbal pukib-itogedbal peyedzhe podamalo."]},{"type":"verse","number":10,"content":["Imi we erreymal peyedzhe neg-kwebur-oturdalenaidgin kwagyemalo. Al erreymal panna takkwismalo, tegin erreymal sapejul kolmadamalo, chogdamalo:",{"text":"Imi Babilonia-neg-kwebur-tummad,","poem":1},{"lineBreak":true},{"text":"egmal-neg-kweburganga pul kal-nika-nad.","poem":1},{"lineBreak":true},{"text":"Pe-Babilonia-neg-kweburginmalad,","poem":1},{"lineBreak":true},{"text":"peyedzhe pe wilesmalma,","poem":1},{"lineBreak":true},{"text":"pe-neg-kwebur unnila wachilgwen wis kales,","poem":1},{"lineBreak":true},{"text":"ilgwen pelgus.","poem":1}]},{"type":"verse","number":11,"content":["Tegin tule-iti-napkin-pela-pela-immal-uked-nikmalad, Babilonia-neg-kwebur-pelgujadbal peyedzhe pukib-itononimal, tule-eje-immal-paked-kwen-onojul-kujadbal."]},{"type":"verse","number":12,"content":["Imi tule-immalmal-ukmalad immalmal nikmalando ukegal: olo, mani, akwa-nugu-takleged-karked, perlas, mol-chibu, mol-kwalugiid, mol-karked-chwiligwad, mol-kinnid, pel-kwapa chowal-yer-yapanmalad, tegin immalmal-chobaled-elefante-nugalgad, immal-chobaled-chowal-karkedgad, immal-chobaled-ezha-kortigidgad, immal-chobaled-ezhagad, tegin immal-chobaled-akwa-marmolgad."]},{"type":"verse","number":13,"content":["Tegin canela, tegin ina-wawad, tegin immal-wawad-incienso, tegin immal-wawad-mirra, tegin ti-wawad, tegin vino, kwallu, madu-pur, trigo-chunnad; tegin moli-peb-nikad, ovejamal, moli-caballo tegin moli-karo, tegin tule-abgan-e-purpa-ugakche uknanimalad. Tenal tule-eje-immalmal-paked-onojulidbal tule-immal-uked-nikmalad peyedzhe poalmalzhun."]},{"type":"verse","number":14,"content":["Tegin tule-immal-uked-nikmalad chogdamalbalo: “Imi pe immalmal-nuegan-pe-peigujiid pel-kwapa pelgús. Tegin pe immal-nugu-takleged-pe-nikad pel-kwapa pelgusbal, tenal pe pal onogojul-kuo.”"]},{"type":"verse","number":15,"content":["Tegin tulemal Babilonia-neg-kweburginmaladga immal-ukmaladgin-aga-mani-kamalad panna naigumalo, Babilonia-neg-kwebur-oturdalegedgin kwagyemalo. Al tule-immal-ukmalad pela-pela pukib-itononimalo, tegin peyedzhe podamalbalo."]},{"type":"verse","number":16,"content":["Tegin tule-immalmal-ukmalad sapejul kolmadamalo, chogdamalo:",{"text":"¡Babilonia-tolgan, peyedzhe pe wilesmalma!","poem":1},{"lineBreak":true},{"text":"Imi pemal-neg-kwebur-tummadgin-pukmalad","poem":1},{"lineBreak":true},{"text":"pe mol-nuegan-yoyomalad,","poem":1},{"lineBreak":true},{"text":"pe mol-chibu-nuegan-yoyomalad,","poem":1},{"lineBreak":true},{"text":"pe mol-kwalugiid-yoyomalad,","poem":1},{"lineBreak":true},{"text":"pe mol-kinnid-yoyomalad,","poem":1},{"lineBreak":true},{"text":"pe ol-nanimalad,","poem":1},{"lineBreak":true},{"text":"pe akwa-nugu-takleged-karked-nanimalad,","poem":1},{"lineBreak":true},{"text":"tegin pe perlas-pi-pi-pip-kamalad-nanimalad,","poem":1},{"lineBreak":true},{"text":"peyedzhe pe wilesmalma.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Imi pe-pela-pela-immalmal-nikad,","poem":1},{"lineBreak":true},{"text":"pel-kwapa wachilgwen wis kales,","poem":1},{"lineBreak":true},{"text":"ilgwen pelgus.","poem":1},"Tegin tule-ulmol-e-tummagan pel-kwapa, tegin tule-ulgin-nanemalad pel-kwapa, tegin tule-ul-azhu-takmalad, tegin tule-ulgin-arpabukwadgin-mani-kamalad pel-kwapa, panna naigunonimalmogo."]},{"type":"verse","number":18,"content":["Tenal we tulemal-ulgin-nanemalad Babilonia-neg-kwebur-kummamaidbal pupurmamai e-wa takalil, kolmadamalo, chogdamalo: “¿We neg-kwebur-tummadyobid, pia pe pal onogo? Tule keg pal ono.”"]},{"type":"verse","number":19,"content":["Tegin tulemal-ulgin-arpamalad pukib-itogedbal aga nonoje nap-pur midamalo, tegin peyedzhe podamalo, tegin sapejul kotamalo, chogdamalo:",{"text":"Babilonia-neg-kweburginmalad,","poem":1},{"lineBreak":true},{"text":"peyedzhe pe wilesmalma.","poem":1},{"lineBreak":true},{"text":"Imi Babilonia-neg-kwebur-tummad,","poem":1},{"lineBreak":true},{"text":"pela-pela-mani-nika-nadbal,","poem":1},{"lineBreak":true},{"text":"tule-ul-ibgan-pel-kwapa immalmal-ukchamaladbal","poem":1},{"lineBreak":true},{"text":"mani-ibganga kunonimalmo.","poem":1},{"lineBreak":true},{"text":"Tenal Babilonia-neg-kwebur unnila wachilgwen wis kales,","poem":1},{"lineBreak":true},{"text":"e-immalmal-nikad ilgwen pelgus.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tenal pemal-Pab-neggin-pukmalad","poem":1},{"lineBreak":true},{"text":"we neg-kwebur pelgujadgin","poem":1},{"lineBreak":true},{"text":"pe welgumalo.","poem":1},{"lineBreak":true},{"text":"Tegin pemal-Pab-Jesúsbak-akenanimalad","poem":1},{"lineBreak":true},{"text":"tegin Jesús-nuggin-palmilegalmalad,","poem":1},{"lineBreak":true},{"text":"tegin Pab-kaka-palchogmalad ampa welgumalmogo.","poem":1},{"lineBreak":true},{"text":"Imi Babilonia-neg-kweburginmalad chabzhul pemal-imasmaladbal,","poem":1},{"lineBreak":true},{"text":"Pab Tummad peyedzhe","poem":1},{"lineBreak":true},{"text":"Babilonia-neg-kweburginmalad-oturdanonimo.","poem":1}]},{"type":"verse","number":21,"content":["Tegin angel-kal-ibed akwa-muun-tunkued akwa-tummad aktosgu, termalzhe mete. Tegin angel chogal:",{"text":"Imi akwa termalgin sapejul mellededyob,","poem":1},{"lineBreak":true},{"text":"Babilonia-neg-kwebur-tummad ilgwen pelgunonimogo.","poem":1},{"lineBreak":true},{"text":"Tegiguo, tule Babilonia-neg-kwebur pal kwen takojul-kuo,","poem":1},{"lineBreak":true},{"text":"ilgwen nappí peio.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tegin tulemal Babilonia-neg-kweburgin kal-ogolmalad","poem":1},{"lineBreak":true},{"text":"pelgujadbal kal-arpa,","poem":1},{"lineBreak":true},{"text":"kal-trompeta tegin kal-kammu,","poem":1},{"lineBreak":true},{"text":"pal kwen ogolojulmal.","poem":1},{"lineBreak":true},{"text":"Tegin Babilonia-neg-kweburgin tule-immal-wiis-chobdimalad,","poem":1},{"lineBreak":true},{"text":"ampa pelgusmalmo, pal kwen ampaguojulmal.","poem":1},{"lineBreak":true},{"text":"Tegin Babilonia-neg-kweburgin","poem":1},{"lineBreak":true},{"text":"tule akwa-mugin immal-ebidnai","poem":1},{"lineBreak":true},{"text":"tule pal kwen itogojulmalbal.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tegin kallen-kabbuk tule pal kwen takojul-kuo.","poem":1},{"lineBreak":true},{"text":"Tegin Babilonia-neg-kweburgin machered-ome-nikunai","poem":1},{"lineBreak":true},{"text":"tule pal kwen itogojulmalbal.","poem":1},{"lineBreak":true},{"text":"Imi Babilonia-neg-kwebur ampa pukwaun,","poem":1},{"lineBreak":true},{"text":"tule-immal-ukmalad","poem":1},{"lineBreak":true},{"text":"iti-napkin-tule-immal-ukmalad-pimaladga","poem":1},{"lineBreak":true},{"text":"pul tule-tummagan.","poem":1},{"lineBreak":true},{"text":"Tegin Babilonia-neg-kweburginmalad lel-taedyob","poem":1},{"lineBreak":true},{"text":"tule-chog-akal-akal-pinzheed kasmal,","poem":1},{"lineBreak":true},{"text":"iskuedgin nanegal.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tegin tule-Pab-kaka-palchogmalad-mechamalad","poem":1},{"lineBreak":true},{"text":"tegin tule-Pabbak-akenanimalad-mechamalad","poem":1},{"lineBreak":true},{"text":"tegin tule-pimalad-iti-napkin-mechamalad,","poem":1},{"lineBreak":true},{"text":"pel-kwapa tule-Babilonia-neg-kweburmaladgin-chii.","poem":1},{"lineBreak":true},{"text":"Al Babilonia-neg-kwebur peyedzhe oturdalenonijun.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kvn_wbt/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kvn_wbt/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kvn_wbt/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}