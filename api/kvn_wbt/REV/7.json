{"translation":{"id":"kvn_wbt","name":"Pab tummad karta pab Jesucristobal igal-pin mezhijad","website":"https://ebible.org/Scriptures/details.php?id=kvnNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kvnNT","licenseNotes":null,"shortName":"WBT","englishName":"Border Kuna NT","language":"kvn","textDirection":"ltr","sha256":"32d2449ce91bd4006797e81bdf519e6dcea0d240ea136b9ac9518568d1cea88e","availableFormats":["json"],"listOfBooksApiLink":"/api/kvn_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7934,"languageName":"Border Kuna","languageEnglishName":"Border Kuna"},"book":{"id":"REV","translationId":"kvn_wbt","name":"Apocalipsis","commonName":"Apocalipsis","title":"Pab-Jesús Juanga Immal-kuoed Oyojad Apocalipsis","order":66,"numberOfChapters":22,"sha256":"04f17146a71ec9b1491c5af8a8239481c59e7a022702a8728a2ffffa26800996","firstChapterNumber":1,"firstChapterApiLink":"/api/kvn_wbt/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/kvn_wbt/REV/22.json","totalNumberOfVerses":403},"chapter":{"number":7,"content":[{"type":"heading","content":["Israel-tulemal-144,000 sello-imakaled"]},{"type":"verse","number":1,"content":["Tegin te-cholbal an takchado, angelmal-walabake iti-nap tikal-tikalgin kwigwismal. Tenal angelmal chogbake purwa abingegwismal, melle napkin kolgal, melle termalgin yolegal, tegin chapimalgin melle yolegalbal."]},{"type":"verse","number":2,"content":["Tegin an angel-pid-takchabal, tad-nakwedbal tani, tenal Pab-Tummad-tuladgad-sello annik tani. Tegin angel-tad-nakwedzhik-nonikid, angel-nap-tegin-termal-izhomaloedzhe sapejul kote, chogal:"]},{"type":"verse","number":3,"content":["“Pe melle nap izhogo, tegin pe melle termal izhogo, tegin pe melle chapimal o-ibalo, anmal Pab-Tummad-e-mosmal-pebegin sello nazhikedzhe.”"]},{"type":"verse","number":4,"content":["Tegin an itosbal, Israel-tulemal-144,000 sello kin nazhilesmal, tenal Israel-tulemal chog-ilbal:"]},{"type":"verse","number":5,"content":[{"text":"Judágad, miliambe-kakabog;","poem":1},{"lineBreak":true},{"text":"Rubéngad, miliambe-kakabog;","poem":1},{"lineBreak":true},{"text":"Gadgad, miliambe-kakabog;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Asergad, miliambe-kakabog;","poem":1},{"lineBreak":true},{"text":"Neftalígad, miliambe-kakabog;","poem":1},{"lineBreak":true},{"text":"Manasésgad, miliambe-kakabog;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Simeóngad, miliambe-kakabog;","poem":1},{"lineBreak":true},{"text":"Levígad, miliambe-kakabog;","poem":1},{"lineBreak":true},{"text":"Isacargad, miliambe-kakabog;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zabulóngad, miliambe-kakabog;","poem":1},{"lineBreak":true},{"text":"Joségad, miliambe-kakabog;","poem":1},{"lineBreak":true},{"text":"tegin Benjamíngad, miliambe-kakabogmo.","poem":1}]},{"type":"heading","content":["Tule-ichejul Jesús-abingasmalad"]},{"type":"verse","number":9,"content":["Tegin te-cholbal an taktegu, an takal, Pab-ol-kangin-chiid-assapin tegin Oveja-chapini-assapin, tulemal-ichéjul kwigwismal, tule pel unni kwen epised-chul. Tenal we tulemal-pukmalad napa-nanimalad-ilbal, tule-chog-ilbal, tule-akal-akal-tamalad-ilbal, tegin tule-akal-akal-chunmaked-ilbal tanimal. Tenal we tulemal mol-chibugan yoyo-nadmal, tegin chunkalgin uga-ka annik-nemalbal."]},{"type":"verse","number":10,"content":["Tegin tulemal-ol-kan-nabal-pukmalad sapejul kotemal, chogalmal:",{"text":"Imi tule-abonoged","poem":1},{"lineBreak":true},{"text":"anmal-Pab-Tummad-ol-kangin-chiid-akar taniye,","poem":1},{"lineBreak":true},{"text":"tegin Oveja-chapini-akar tanibalye.","poem":1}]},{"type":"verse","number":11,"content":["Tegin angelmal-pel-kwapa tegin chelegan-tummagan tegin immal-tulgan-walbakegwad Pab-ol-kan-ebiris-pukwamalad, Pab-ol-kangin-chiid-assapin napche-tullu-imasmal Pab-otummoalmal, chogalmal:"]},{"type":"verse","number":12,"content":[{"text":"¡Nued pe chogzhamaldo!","poem":1},{"lineBreak":true},{"text":"Pabye, imi pe ilagwen-nadgu otummoledi-kuelen, nabirinye,","poem":1},{"lineBreak":true},{"text":"tegin pe-nug-okannoledi-kuelen, nabirinye,","poem":1},{"lineBreak":true},{"text":"tegin pe-pinzheed-nikalen, nabirinye,","poem":1},{"lineBreak":true},{"text":"tegin tule pega tog-nuedi chogdi-kuelen, nabirinye,","poem":1},{"lineBreak":true},{"text":"tegin tule pegin atagelen, nabirinye,","poem":1},{"lineBreak":true},{"text":"tegin pe kal-nikalen, nabirinye,","poem":1},{"lineBreak":true},{"text":"tegin pe kannaleged nikalen, nabirbalinye.","poem":1},{"lineBreak":true},{"text":"¡Pitogua!","poem":1}]},{"type":"verse","number":13,"content":["Tegin chelegan-tummagan-walgwen anche ekichial: “¿Ibi-tulemal-wede, mol-chibugan-yoyowiddé? ¿Pia tanimal-wede?”"]},{"type":"verse","number":14,"content":["Tegin antin tule-chered-tummadga chogal: “Tummad, ante wichí toa-tulemal. Tenal pedin nued wiis, ibi-tulemal.” Tegin we tummad anka chogalzhun: “We tulemal-mol-chibugan-yoyo-pe-takeddin, peyedzhe wilesmalad-akar tanimal, tegin Oveja-chapini-e-abegin aga mol enusmalbal, al chipú pesmal."]},{"type":"verse","number":15,"content":[{"text":"Al we tulemal","poem":1},{"lineBreak":true},{"text":"Pab-ol-kangin-chiid-assapin pukwamal,","poem":1},{"lineBreak":true},{"text":"mutik-ibgin Pab-maidgin","poem":1},{"lineBreak":true},{"text":"Pab-pentamalgal.","poem":1},{"lineBreak":true},{"text":"Tenal Pab-ol-kangin-chiid aga-e-negginedyob,","poem":1},{"lineBreak":true},{"text":"tule-mol-chibu-yoyomalad-akwemalo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tenal Oveja-chapini Pab-ol-kan-nabal-unid,","poem":1},{"lineBreak":true},{"text":"aga oveja-takedyob, tulemal-mol-chibu-yoyomalad-tako.","poem":1},{"lineBreak":true},{"text":"Tenal Oveja-chapini aga e-tulemal-iktudo","poem":1},{"lineBreak":true},{"text":"ti-nuedgin aga okobgal.","poem":1},{"lineBreak":true},{"text":"Tegin Pab Tummad tule-mol-chibugan-yoyomaladga","poem":1},{"lineBreak":true},{"text":"imialis elio,","poem":1},{"lineBreak":true},{"text":"melle pukib pal itomalgal.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Al tulemal-mol-chibugan-yoyomalad","poem":1},{"lineBreak":true},{"text":"ukul pal kwen itogojulmal,","poem":1},{"lineBreak":true},{"text":"tegin tad pal kwen kugojulmal,","poem":1},{"lineBreak":true},{"text":"tegin neg-ued pal kwen itogojulmalbal.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kvn_wbt/REV/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kvn_wbt/REV/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kvn_wbt/REV/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}