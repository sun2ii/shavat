type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Korakama dokopa emba neta randa nao","poem":1},{"lineBreak":true},{"text":"kukwa kana raramodokopa dopako pyuo pinya lao pira.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kamongo baame randa dupwana emba kingi raka lanyi nembo","poem":1},{"lineBreak":true},{"text":"kyawa minyara.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kamongo baame emba yulu pyuo minyuo papyuo kararene dupwana","poem":1},{"lineBreak":true},{"text":"kyawa minyuo karalu karara.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kyc_png/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kyc_png/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kyc_png/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":8}