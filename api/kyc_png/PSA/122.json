{"translation":{"id":"kyc_png","name":"BUKU BAEPOLE","website":"https://ebible.org/Scriptures/details.php?id=kyc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kyc","licenseNotes":null,"shortName":"PNG","englishName":"Kyaka Enga Bible","language":"kyc","textDirection":"ltr","sha256":"b0a79083da943a6ef00725dc62ccfffad8f722222184ecbb78dabbde1b7ae1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/kyc_png/books.json","numberOfBooks":65,"totalNumberOfChapters":680,"totalNumberOfVerses":17063,"languageName":"Kyaka","languageEnglishName":"Kyaka"},"book":{"id":"PSA","translationId":"kyc_png","name":"SAMU","commonName":"SAMU","title":"SAMU DUPWA","order":19,"numberOfChapters":59,"sha256":"2093129e2881737dfa1d115ecf1aceccbce6e1ecdcc873bac5f7dbb32863d382","firstChapterNumber":1,"firstChapterApiLink":"/api/kyc_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kyc_png/PSA/150.json","totalNumberOfVerses":964},"chapter":{"number":122,"content":[{"type":"heading","content":["Jerusaleme Lakandenge Pii"]},{"type":"verse","number":1,"content":[{"text":"Nakamame namba langyuo,","poem":1},{"lineBreak":true},{"text":"Kamongona anda dokona mwua leyaminyi dokopa namba rae maiyu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Doko epapu namwa dae angi Jerusaleme kame kambu andakarerena epo karamano.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jerusaleme taone andake doko elya pyuo pinjingi lyolope yalu pyuo kapa kapa piyaminyi au piro karamo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dopa pyuo piyaminyidokome","poem":1},{"lineBreak":true},{"text":"lowana letamo dokona palyuo","poem":1},{"lineBreak":true},{"text":"Isaraele rara dupwame","poem":1},{"lineBreak":true},{"text":"Kamongo kando ange lala epenge.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dake Isaraele wambunya kiŋi dupwame","poem":1},{"lineBreak":true},{"text":"wambunya kote pii soo peteyami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Jerusaleme doko mona kyuu lao seramopa petena lao ateŋa lakamipwape.","poem":1},{"lineBreak":true},{"text":"Wambu Jerusaleme mona nyilyaminyi dupwa yuunya amenge doko nao sikya piramo petenale.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kana kame andakare dorena mondo lao mona seramo soo","poem":1},{"lineBreak":true},{"text":"kiŋinya palenge anda dupwa moŋo see nanale.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nambana ree palupi puu minyingipi dupwana reke lao","poem":1},{"lineBreak":true},{"text":"Jerusaleme dokona mona kyuu lao seramo pisipwape, leto.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kamongo baa dae palyuo karamo dokona lao","poem":1},{"lineBreak":true},{"text":"nakamana ee yuupi ipinya lao ateŋa lakalyo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kyc_png/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kyc_png/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kyc_png/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}