{"translation":{"id":"kyc_png","name":"BUKU BAEPOLE","website":"https://ebible.org/Scriptures/details.php?id=kyc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kyc","licenseNotes":null,"shortName":"PNG","englishName":"Kyaka Enga Bible","language":"kyc","textDirection":"ltr","sha256":"b0a79083da943a6ef00725dc62ccfffad8f722222184ecbb78dabbde1b7ae1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/kyc_png/books.json","numberOfBooks":65,"totalNumberOfChapters":680,"totalNumberOfVerses":17063,"languageName":"Kyaka","languageEnglishName":"Kyaka"},"book":{"id":"PSA","translationId":"kyc_png","name":"SAMU","commonName":"SAMU","title":"SAMU DUPWA","order":19,"numberOfChapters":59,"sha256":"2093129e2881737dfa1d115ecf1aceccbce6e1ecdcc873bac5f7dbb32863d382","firstChapterNumber":1,"firstChapterApiLink":"/api/kyc_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kyc_png/PSA/150.json","totalNumberOfVerses":964},"chapter":{"number":124,"content":[{"type":"heading","content":["Anatu Baa Banya Wambu KyawaMinyuo Karenge"]},{"type":"verse","number":1,"content":[{"text":"Kamongo baa namwa role pyao kara napyali apa pipyali?","poem":1},{"lineBreak":true},{"text":"Isaraele wambu dupwame isingi lalapape.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Namwana yanda pimwai dupwame namwa pyalana piyaminyi dokopa","poem":1},{"lineBreak":true},{"text":"Anatu namwa pipya role pyao kara nayali doko","poem":1},{"lineBreak":true},{"text":"nakamame namwa lenge rao kareyamanopa","poem":1},{"lineBreak":true},{"text":"nakamana imbu singi dokome namwa lee rapeta nao goe leyamili.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dokopaapunda epo ipwa kama piyamo dokome namwa soo pao","poem":1},{"lineBreak":true},{"text":"ipwa dokome namwa yambepyao piyali.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ipwa endangi palyuo uu lao epapala namwa nyuo yalupiyasa kumuyamali.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Namwana yanda pimwai dupwa keta pinya lao suu laa nalyamo dokona","poem":1},{"lineBreak":true},{"text":"Kamongo baa lakandamanale.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nuli nenge akalinya yaka kone makanyi palyingi dokona yaka baa kuinya palipa nao wanjingi dopale ingyuo karamano.","poem":1},{"lineBreak":true},{"text":"Kone makami doko petapyasa namwa kiiramo pasi karamano.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Namwa nyisara doko","poem":1},{"lineBreak":true},{"text":"Kamongo yake yuupi wasiya doko keta epenge.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kyc_png/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kyc_png/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kyc_png/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":7}