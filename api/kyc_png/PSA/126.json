{"translation":{"id":"kyc_png","name":"BUKU BAEPOLE","website":"https://ebible.org/Scriptures/details.php?id=kyc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kyc","licenseNotes":null,"shortName":"PNG","englishName":"Kyaka Enga Bible","language":"kyc","textDirection":"ltr","sha256":"b0a79083da943a6ef00725dc62ccfffad8f722222184ecbb78dabbde1b7ae1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/kyc_png/books.json","numberOfBooks":65,"totalNumberOfChapters":680,"totalNumberOfVerses":17063,"languageName":"Kyaka","languageEnglishName":"Kyaka"},"book":{"id":"PSA","translationId":"kyc_png","name":"SAMU","commonName":"SAMU","title":"SAMU DUPWA","order":19,"numberOfChapters":59,"sha256":"2093129e2881737dfa1d115ecf1aceccbce6e1ecdcc873bac5f7dbb32863d382","firstChapterNumber":1,"firstChapterApiLink":"/api/kyc_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kyc_png/PSA/150.json","totalNumberOfVerses":964},"chapter":{"number":126,"content":[{"type":"heading","content":["Kiiramo Nyinya Lao Ateŋa Lenge Doko"]},{"type":"verse","number":1,"content":[{"text":"Kamongome yuu Sayone dokona namwa lanyuo epeyamo dokopa","poem":1},{"lineBreak":true},{"text":"mee kombeyame ingyalya ingyana piya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Namwana giyuo giyuo piyamanopape dee kenane pyao rae rae maiyamanopape dokona","poem":1},{"lineBreak":true},{"text":"yuu muu menge dupwana sepala namwana lakao","poem":1},{"lineBreak":true},{"text":"Kamongo dokome yulu andake doko pyakamilyamo, leyami.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ama kinyi kinyi baame yulu andake doko pyakayasa","poem":1},{"lineBreak":true},{"text":"namwa ama raeme kumuyama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kamongo embame namwaipwa sokwasi doko apundame range epengenyili pyamuli pyuo","poem":1},{"lineBreak":true},{"text":"namwa rangena yuunya dee lanyuo ipupi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dokona lao ee pipya karo ee waingi warapiyami dupwa","poem":1},{"lineBreak":true},{"text":"manjo nao karo dokopa rae mainyale.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wambu ee waingi manjo pao karo dokopa ee pipya manjo peyami dupwa","poem":1},{"lineBreak":true},{"text":"angi naomanjo laeyo epo dokopa","poem":1},{"lineBreak":true},{"text":"rae maiyuo kenane pyao eparami.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kyc_png/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kyc_png/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kyc_png/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":6}