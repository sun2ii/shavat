{"translation":{"id":"kyc_png","name":"BUKU BAEPOLE","website":"https://ebible.org/Scriptures/details.php?id=kyc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kyc","licenseNotes":null,"shortName":"PNG","englishName":"Kyaka Enga Bible","language":"kyc","textDirection":"ltr","sha256":"b0a79083da943a6ef00725dc62ccfffad8f722222184ecbb78dabbde1b7ae1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/kyc_png/books.json","numberOfBooks":65,"totalNumberOfChapters":680,"totalNumberOfVerses":17063,"languageName":"Kyaka","languageEnglishName":"Kyaka"},"book":{"id":"PSA","translationId":"kyc_png","name":"SAMU","commonName":"SAMU","title":"SAMU DUPWA","order":19,"numberOfChapters":59,"sha256":"2093129e2881737dfa1d115ecf1aceccbce6e1ecdcc873bac5f7dbb32863d382","firstChapterNumber":1,"firstChapterApiLink":"/api/kyc_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kyc_png/PSA/150.json","totalNumberOfVerses":964},"chapter":{"number":127,"content":[{"type":"heading","content":["Anatunya Yulu Keyange Dokona Lakandamanale"]},{"type":"verse","number":1,"content":[{"text":"Kamongome anda doko pii naramo","poem":1},{"lineBreak":true},{"text":"anda pingi akalimi iki sisu lao pirami ramo doko nakamana yulu doko mee ingyuo para.","poem":1},{"lineBreak":true},{"text":"Kamongome taone doko kando iso kara nara ramo dokopa","poem":1},{"lineBreak":true},{"text":"akali taone iso kararami dupwa mee ingyuo para.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kamongo baame mona retenge wambu dupwa kamenge luu palenge dokopa","poem":1},{"lineBreak":true},{"text":"nakama yano pilyamo dupwa maingi.","poem":1},{"lineBreak":true},{"text":"Dokona suu pyao namwa kukwako sipurao yulu andake pyuo kukwako pao palyuo pyuo kararama doko","poem":1},{"lineBreak":true},{"text":"meekopirama ingilyamo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wane wanakepe mandenge doko Kamongome mee jilyasa pingi","poem":1},{"lineBreak":true},{"text":"nakama namwa elyape keta piso jipyasa pilyamo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Akali mende wanyane ingyuo karo wane mandenge dupwa","poem":1},{"lineBreak":true},{"text":"yanda singingya kingi dokona yanda kakupi minyaro karenge dopale ingyuo karaminyi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ikinyingi malu yanda kakupi dopale ingyuo mandamo dokome","poem":1},{"lineBreak":true},{"text":"yanda pimwai dupwa kote lenge dokona nyuo anamasi minyarami ingya nalyamo dokona","poem":1},{"lineBreak":true},{"text":"raemaiyuo karara.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kyc_png/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kyc_png/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kyc_png/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}