{"translation":{"id":"kyc_png","name":"BUKU BAEPOLE","website":"https://ebible.org/Scriptures/details.php?id=kyc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kyc","licenseNotes":null,"shortName":"PNG","englishName":"Kyaka Enga Bible","language":"kyc","textDirection":"ltr","sha256":"b0a79083da943a6ef00725dc62ccfffad8f722222184ecbb78dabbde1b7ae1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/kyc_png/books.json","numberOfBooks":65,"totalNumberOfChapters":680,"totalNumberOfVerses":17063,"languageName":"Kyaka","languageEnglishName":"Kyaka"},"book":{"id":"PSA","translationId":"kyc_png","name":"SAMU","commonName":"SAMU","title":"SAMU DUPWA","order":19,"numberOfChapters":59,"sha256":"2093129e2881737dfa1d115ecf1aceccbce6e1ecdcc873bac5f7dbb32863d382","firstChapterNumber":1,"firstChapterApiLink":"/api/kyc_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kyc_png/PSA/150.json","totalNumberOfVerses":964},"chapter":{"number":130,"content":[{"type":"heading","content":["Nyisinya Lao Ateŋa Doko"]},{"type":"verse","number":1,"content":[{"text":"Namba randa sepala kata mende see napyasa panya saka napala","poem":1},{"lineBreak":true},{"text":"Kamongo emba kee leto.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Namba ee lao karo doko Kamongo embame sakape.","poem":1},{"lineBreak":true},{"text":"Nyisapili lao kyakale leto doko kaleyukupala sepe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Embame namwana koo dupwa peparae bukunya pyao reteeli","poem":1},{"lineBreak":true},{"text":"apimi kumungi renge doko wanjiyalisi?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Doko daa ingilyamo dokona embame nyuo kame sakarenepa","poem":1},{"lineBreak":true},{"text":"namwa embame lasarene lao suu suu pyao karamanale.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Namba Kamongome banya pii dokona letamodoko kinyi lao sepala","poem":1},{"lineBreak":true},{"text":"nyisaramo dokona wangu lakapala isaro karo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yuu isingi akalimi yuu yangena lao isaro karelyaminyipape","poem":1},{"lineBreak":true},{"text":"nambame Kamongo doko epena lao isaro karapu doko","poem":1},{"lineBreak":true},{"text":"mee mende andarele ingilyamo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nakama Isaraele wambu dupwame Kamongome nakama mona reto karalu karapala","poem":1},{"lineBreak":true},{"text":"baa yuu peparae nyisalana rae maipala nyiso karamo dokona","poem":1},{"lineBreak":true},{"text":"nakama Kamongo Anatu baa keta pyamalyuo karalapape.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Baame banya Isaraele wambu dupwa","poem":1},{"lineBreak":true},{"text":"nakamana koo dupwana nenge rekya lao nyera.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kyc_png/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kyc_png/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kyc_png/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":8}