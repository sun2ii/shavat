{"translation":{"id":"kyc_png","name":"BUKU BAEPOLE","website":"https://ebible.org/Scriptures/details.php?id=kyc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kyc","licenseNotes":null,"shortName":"PNG","englishName":"Kyaka Enga Bible","language":"kyc","textDirection":"ltr","sha256":"b0a79083da943a6ef00725dc62ccfffad8f722222184ecbb78dabbde1b7ae1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/kyc_png/books.json","numberOfBooks":65,"totalNumberOfChapters":680,"totalNumberOfVerses":17063,"languageName":"Kyaka","languageEnglishName":"Kyaka"},"book":{"id":"PSA","translationId":"kyc_png","name":"SAMU","commonName":"SAMU","title":"SAMU DUPWA","order":19,"numberOfChapters":59,"sha256":"2093129e2881737dfa1d115ecf1aceccbce6e1ecdcc873bac5f7dbb32863d382","firstChapterNumber":1,"firstChapterApiLink":"/api/kyc_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kyc_png/PSA/150.json","totalNumberOfVerses":964},"chapter":{"number":150,"content":[{"type":"heading","content":["Kamongo Baa Lakandamana"]},{"type":"verse","number":1,"content":[{"text":"Kamongona kingi lakando palena.","poem":1},{"lineBreak":true},{"text":"Anatu banya tembole anda dokona piso baa lakandamana.","poem":1},{"lineBreak":true},{"text":"Yake dorena banya porai renge palamo dokona lakandamana.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Banya yulu porai ingyuo piyamo dupwana lakando dokopa","poem":1},{"lineBreak":true},{"text":"baa kamame andake wakasa dokona lao lakandamana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bikuli poo lao","poem":1},{"lineBreak":true},{"text":"rambyalu lao gita pyao baa lakandamanale.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Baa laikuli pyao mali lyuo","poem":1},{"lineBreak":true},{"text":"rambyalu kurulupi lao banya kingi lakandamanale.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bange jaa lenge dupwame minyuo kele kalo lao baa lakandamana.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yuu muu dupwana wasiyamo piso pelyaminyi dupwa peparaeme Kamongo lakandalapape.","poem":1},{"lineBreak":true},{"text":"Kamongo baa lakandamana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kyc_png/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kyc_png/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kyc_png/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":6}