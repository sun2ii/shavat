{"translation":{"id":"kyc_png","name":"BUKU BAEPOLE","website":"https://ebible.org/Scriptures/details.php?id=kyc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kyc","licenseNotes":null,"shortName":"PNG","englishName":"Kyaka Enga Bible","language":"kyc","textDirection":"ltr","sha256":"b0a79083da943a6ef00725dc62ccfffad8f722222184ecbb78dabbde1b7ae1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/kyc_png/books.json","numberOfBooks":65,"totalNumberOfChapters":680,"totalNumberOfVerses":17063,"languageName":"Kyaka","languageEnglishName":"Kyaka"},"book":{"id":"PSA","translationId":"kyc_png","name":"SAMU","commonName":"SAMU","title":"SAMU DUPWA","order":19,"numberOfChapters":59,"sha256":"2093129e2881737dfa1d115ecf1aceccbce6e1ecdcc873bac5f7dbb32863d382","firstChapterNumber":1,"firstChapterApiLink":"/api/kyc_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kyc_png/PSA/150.json","totalNumberOfVerses":964},"chapter":{"number":23,"content":[{"type":"heading","content":["Kamongo Doko Namwa Mena Sipisipi Ingyuo Rapu Pyuo Karamo"]},{"type":"verse","number":1,"content":[{"text":"Kamongo doko namba mena sipisipi ingyuo rapu pyuo karamo.","poem":1},{"lineBreak":true},{"text":"Namba mendeme yangilyande daa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Baame namba yuu isako kyakange dokona imambu soo pale lao panda joo","poem":1},{"lineBreak":true},{"text":"dee ipwa pete manda rasi dokonalanyuo pao pingi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Baame namba porai renge deeko jepa pingi.","poem":1},{"lineBreak":true},{"text":"Baame dopa piro dopande pirona lao lalamuli pyuo","poem":1},{"lineBreak":true},{"text":"namba kata angi dokona lasaka pingi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nambame koo keta palirunupape","poem":1},{"lineBreak":true},{"text":"Kamongo emba role pyao karapinyi dokome","poem":1},{"lineBreak":true},{"text":"mona nembo kara naro.","poem":1},{"lineBreak":true},{"text":"Emba mena rapupingi akalinya pangalinya mendeke ingyuo namba pingi pyao kyawa minyuo paenge.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Embame nambana yanda pimwainya lenge kambu dokona","poem":1},{"lineBreak":true},{"text":"nenge andake yaowakalana rapa rapa pilini.","poem":1},{"lineBreak":true},{"text":"Embame kyawa dokona mamba kulimbwakao kisakapinyi dokome","poem":1},{"lineBreak":true},{"text":"embame upinili mende epelyamo yako lao nyingi dopale ingyuo namba laku nyingi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Namba yuu gii kararo dusipana embena keyange rengepe mona retenge rengepe dolapo namba keta soo puu paralyamo doko silyu.","poem":1},{"lineBreak":true},{"text":"Dopa piramopa embena anda yuupi doko nambana ingyuo puu parolyamo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kyc_png/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kyc_png/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kyc_png/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}