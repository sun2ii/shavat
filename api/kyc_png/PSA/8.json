{"translation":{"id":"kyc_png","name":"BUKU BAEPOLE","website":"https://ebible.org/Scriptures/details.php?id=kyc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kyc","licenseNotes":null,"shortName":"PNG","englishName":"Kyaka Enga Bible","language":"kyc","textDirection":"ltr","sha256":"b0a79083da943a6ef00725dc62ccfffad8f722222184ecbb78dabbde1b7ae1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/kyc_png/books.json","numberOfBooks":65,"totalNumberOfChapters":680,"totalNumberOfVerses":17063,"languageName":"Kyaka","languageEnglishName":"Kyaka"},"book":{"id":"PSA","translationId":"kyc_png","name":"SAMU","commonName":"SAMU","title":"SAMU DUPWA","order":19,"numberOfChapters":59,"sha256":"2093129e2881737dfa1d115ecf1aceccbce6e1ecdcc873bac5f7dbb32863d382","firstChapterNumber":1,"firstChapterApiLink":"/api/kyc_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kyc_png/PSA/150.json","totalNumberOfVerses":964},"chapter":{"number":8,"content":[{"type":"heading","content":["Anatu Range Neta Renge Ingyuo Karo Akali Kando Rungi Rungi Pingi"]},{"type":"verse","number":1,"content":[{"text":"O Kamongo, namwana Kamongo,","poem":1},{"lineBreak":true},{"text":"yuu muu peparae emba andake ingyuo pelyamo doko kandelyaminyi.","poem":1},{"lineBreak":true},{"text":"Embena kingi lakandase dokome pao yake sungwapyamosa","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"wane wanakepe nyaŋape opetaeko kenane pyao lakandelyaminyi.","poem":1},{"lineBreak":true},{"text":"Emba range kame pyuo minyaro karapisa","poem":1},{"lineBreak":true},{"text":"yanda pimwainya panda mai nalene dokona randa jerami ingya nalyamo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nambame yake panda kandapu dokopa","poem":1},{"lineBreak":true},{"text":"bui neta kanape nakamana yuu range karara lao wasiinyi dokona rao karapyamo kandelyo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wambu dupwa akinde dokona embame baa suupyale pyale karese?","poem":1},{"lineBreak":true},{"text":"Dee wambu dupwa apimawana lao embame ketae pyambuo karese?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Embame emba range mupwa wakasa ingyuo kararonopa akali baa mee mende emba yaleko ingyuo karara lao wasii.","poem":1},{"lineBreak":true},{"text":"Embame baa neta renge ingyuo ketae pyambuo lakanda minya minya pilini.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Embame bange peparaena baa kyawa nyuo karo","poem":1},{"lineBreak":true},{"text":"wasiinyi dupwana iso karena lee.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mena sipisipi bulamakao dee rae lengepe dupwa opetaeko rapu pyuo","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"oma yakape kata papingi bange peparae","poem":1},{"lineBreak":true},{"text":"ipwa kotana silyamopape dupwa isinya leeyako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"O Kamongo, namwana Kamongo,","poem":1},{"lineBreak":true},{"text":"yuumuu peparaena emba andake ingyuo pelyamo doko kandelyaminyi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kyc_png/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kyc_png/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kyc_png/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}