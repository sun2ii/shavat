{"translation":{"id":"kyc_png","name":"BUKU BAEPOLE","website":"https://ebible.org/Scriptures/details.php?id=kyc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kyc","licenseNotes":null,"shortName":"PNG","englishName":"Kyaka Enga Bible","language":"kyc","textDirection":"ltr","sha256":"b0a79083da943a6ef00725dc62ccfffad8f722222184ecbb78dabbde1b7ae1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/kyc_png/books.json","numberOfBooks":65,"totalNumberOfChapters":680,"totalNumberOfVerses":17063,"languageName":"Kyaka","languageEnglishName":"Kyaka"},"book":{"id":"PSA","translationId":"kyc_png","name":"SAMU","commonName":"SAMU","title":"SAMU DUPWA","order":19,"numberOfChapters":59,"sha256":"2093129e2881737dfa1d115ecf1aceccbce6e1ecdcc873bac5f7dbb32863d382","firstChapterNumber":1,"firstChapterApiLink":"/api/kyc_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kyc_png/PSA/150.json","totalNumberOfVerses":964},"chapter":{"number":87,"content":[{"type":"heading","content":["Yuu Jerusaleme Lakando Kenane Piyami"]},{"type":"verse","number":1,"content":[{"text":"Yuu kyau poo pyasi dokona Kamongome banya yuu taone andake wasiya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Isaraele dokona yuu wakale wakale singi dupwa nyuo isa palyuo","poem":1},{"lineBreak":true},{"text":"Anatumi Jerusaleme doko mona wakasaretenge.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wambu Anatunya taone andake dokona palaminyi dupwa","poem":1},{"lineBreak":true},{"text":"Anatumi yulu keyange pipa pipa pyakalyamo doko selapape.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nambapa kamba laa naminyi yuu dupwa yaka laronopa","poem":1},{"lineBreak":true},{"text":"Isipi Bapilonepa opetae yaka laro ingilyamo.","poem":1},{"lineBreak":true},{"text":"Pilisitia Taiya dee Itiopia wambu dusipa","poem":1},{"lineBreak":true},{"text":"Jerusaleme dopakaleko ingilyamo laro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Jerusaleme doko wambu rara wakale wakale peparaena ingilyamo lao","poem":1},{"lineBreak":true},{"text":"Anatu Porai Wakasa dokome Jerusaleme doko porainyi pyambwara, larami.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kamongo baame wambu rara peparaena yaka lao kingi pepa pyao","poem":1},{"lineBreak":true},{"text":"nakama peparae yuu Jerusaleme rangeŋe lao retara.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wambu peparae pyakalyuo pyao dopa laokyaponga pilyaminyi.","poem":1},{"lineBreak":true},{"text":"Yuu Jerusaleme dokona renge keyange dupwa peparae sipurenge lao pilyaminyi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kyc_png/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kyc_png/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kyc_png/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":7}