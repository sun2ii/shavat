{"translation":{"id":"kyc_png","name":"BUKU BAEPOLE","website":"https://ebible.org/Scriptures/details.php?id=kyc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kyc","licenseNotes":null,"shortName":"PNG","englishName":"Kyaka Enga Bible","language":"kyc","textDirection":"ltr","sha256":"b0a79083da943a6ef00725dc62ccfffad8f722222184ecbb78dabbde1b7ae1f1","availableFormats":["json"],"listOfBooksApiLink":"/api/kyc_png/books.json","numberOfBooks":65,"totalNumberOfChapters":680,"totalNumberOfVerses":17063,"languageName":"Kyaka","languageEnglishName":"Kyaka"},"book":{"id":"PSA","translationId":"kyc_png","name":"SAMU","commonName":"SAMU","title":"SAMU DUPWA","order":19,"numberOfChapters":59,"sha256":"2093129e2881737dfa1d115ecf1aceccbce6e1ecdcc873bac5f7dbb32863d382","firstChapterNumber":1,"firstChapterApiLink":"/api/kyc_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/kyc_png/PSA/150.json","totalNumberOfVerses":964},"chapter":{"number":93,"content":[{"type":"heading","content":["Anatu Baa Kiŋi"]},{"type":"verse","number":1,"content":[{"text":"Kamongo baa kiŋi.","poem":1},{"lineBreak":true},{"text":"Banya kingi kamame nyilyingi dokomepe porainya renge dokomepe range komau ingyuo pee pipala karamo.","poem":1},{"lineBreak":true},{"text":"Isa yuu dake reteyamuli pyuo porai wakasa ingyuo romo pii nao sulu soo singi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O Kamongo, embena kiŋinya yulu doko yuu kanda soo wasiyamo dokopa piso pao porai ingyuo sulu singi.","poem":1},{"lineBreak":true},{"text":"Yuu gii ene kanda sepa nayamo dokopa emba mee karalu karenge.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kamongo, ipwa kota andake ama kyuwa dokona singi dokome ama kasakole minyuo","poem":1},{"lineBreak":true},{"text":"pii lao gono gono lenge.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ipwa kota ama kasakole minyuo gono gono lao porai ingyuo silyamopape","poem":1},{"lineBreak":true},{"text":"Kamongobaa yake panda dokona mupwa karo","poem":1},{"lineBreak":true},{"text":"ama porai wakasa ingyuo iso karenge.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kamongo, embena lowa dupwa yuu peparae sulu singi.","poem":1},{"lineBreak":true},{"text":"Embena tembole anda doko ama poo pyasi wakasa ingyuo karalu karara.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/kyc_png/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kyc_png/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kyc_png/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":5}