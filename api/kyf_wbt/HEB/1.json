{"translation":{"id":"kyf_wbt","name":"ʼWʋsuslolue loluu ʼsɛbhɛ","website":"https://ebible.org/Scriptures/details.php?id=kyf","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kyf","licenseNotes":null,"shortName":"WBT","englishName":"Kouya NT","language":"kyf","textDirection":"ltr","sha256":"4351135246566334c69105ce1b44d76295ec8604bda9f313c9927c80042f5e94","availableFormats":["json"],"listOfBooksApiLink":"/api/kyf_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7880,"languageName":"Kouya","languageEnglishName":"Kouya"},"book":{"id":"HEB","translationId":"kyf_wbt","name":"Eblenya","commonName":"Eblenya","title":"'Sɛbhɛ wa 'paa Eblenya yoo","order":58,"numberOfChapters":13,"sha256":"819c2c4acc922dedaff069596d1ecf02b94dedeb584c5c27324f8d49c5503554","firstChapterNumber":1,"firstChapterApiLink":"/api/kyf_wbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/kyf_wbt/HEB/13.json","totalNumberOfVerses":302},"chapter":{"number":1,"content":[{"type":"heading","content":["-Zezuu gbɛgbɛɩn -Lagɔ gbalɩa -slɛɛn -aɩn -yla"]},{"type":"verse","number":1,"content":["Bha mɩa, -amɩaa dʋkpasɩ -yla -Lagɔ gbaa ɔ gbʋʋ -falɩpanyaa gbɛgbɛɩn. Ɔ ka wa -yla gbʋ gba -zakpa duun, we -yɔ sɔɔ 'yli -bhlo -bhlo lʋ."]},{"type":"verse","number":2,"content":["-Slɛɛn, -lu weee bhɩa bhla, ɔ 'Yuu gbɛgbɛɩn ɔ gbalɩa aɩn -yla. Ɔɔ 'Yu gbɛgbɛɩn ɔ -laa dʋdʋ la, 'ɩn ɔ nɛɛ nɩɩ, mɔ yia -lu weee 'yɩa."]},{"type":"verse","number":3,"content":["Sa -Lagɔ mɩa, ɔ ka we -aɩn -slolu, 'ɩn ɔmɔ mɩ 'ya 'sa. Ɔ wɛlɩɩ 'tɩtɛ nya ɔ kaa dʋdʋ. Ɔ ka nyɩmaa gbʋnyuu -bhasa, 'ɩn ɔ -dɩa 'tɩtɛ -ka -Lagɔɔ lilisɔlʋ la."]},{"type":"heading","content":["-Lagɔɔ 'Yu 'yli ɔ -zi 'anzɩnya"]},{"type":"verse","number":4,"content":["Nɩɩ, ɔɔ Yu mɩa, 'kadʋ -we -Lagɔ -zɛlɩa ɔ, sa we -zia 'anzɩnyaa -nʋ 'wʋ, 'sa -bhlokpadɛ 'ŋnɩ -we ɔ 'yɩa ɔ kwɛɛ -mʋʋ -zia 'anzɩnyaa 'ŋnɩ 'wʋ."]},{"type":"verse","number":5,"content":["'Lee, -Lagɔ ka -slɔ 'anzɩ yabhlo -yla gbaɛ:",{"text":"«-Ɩn mɩ na 'Yu nya, nɩɩ -zɛɛn,","poem":1},{"text":"ɩn ka -na Dide -zɛɛ»?","poem":2},"Yaayɩɩ:",{"text":"«Ɔ Dide na yia -zɛa, 'ɩn ɔmɔ 'ka na 'Yu -zɛɛ»?","poem":1}]},{"type":"verse","number":6,"content":["Da -Lagɔ tiea ɔ 'Yu tɩanʋ dʋdʋ -gʋ, ɔ nɛɛ:",{"text":"«-Lagɔɔ 'anzɩ weee -gbli 'wlu la ɔ 'yu.»","poem":1}]},{"type":"verse","number":7,"content":["Nɩɩ, -we -Lagɔ gbaa 'anzɩnyaa da, mʋ nɩ:",{"text":"«-Pɩpɛ 'bhisa 'anzɩnya yia na lubho nʋa,","poem":1},{"text":"-kosuu mɩɔ 'bhisa we yia we nʋa.»","poem":2}]},{"type":"verse","number":8,"content":["'Ɩn -Lagɔ nɛɛ ɔ 'Yu -yla:",{"text":"«-Mɩ -Lagɔ, -mɩ yia nyɩma 'wlulapɩlɩa","poem":1},{"text":"'ylɩ weee -nʋ nya.","poem":2},{"text":"Sa -na pɩlɩa nyɩma 'wlu la we tɩklɩɩ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"-We mɩa tɩklɩɩ, 'mʋ -ɩn 'yɩbhaa.","poem":1},{"lineBreak":true},{"text":"Gbʋnyuu mɩa, 'wʋ -na nyɛa we,","poem":1},{"text":"we 'dɛɛ 'gbʋ, -Lagɔ, -na -Lagɔ,","poem":2},{"lineBreak":true},{"text":"ɔ yia -bha -mɩ -sa ɔ -nʋ nya.","poem":2},{"text":"'Ɩn, ɔ yia -mɩ 'mʋna yeli -na 'bɩ -zɔnʋʋ 'nyɛnyɩe nya,","poem":1},{"text":"we 'ka -na nɔnɔnyaa -nʋ 'wʋzi.»","poem":2}]},{"type":"verse","number":10,"content":["-Lagɔ nɛɛ 'yaɛ:",{"text":"«Nyɩmaa -Kanyɔ, -lu weee gwedɩda,","poem":1},{"text":"-mɩ mɩa,","poem":2},{"text":"-mɩ -laa dʋdʋ la,","poem":1},{"text":"'ɩn -ɩn yia yalɩ lɛnʋ -na sɔ nya.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"We 'dɛ weee mɩa,","poem":1},{"text":"'plɩa we yia.","poem":2},{"text":"'Ɩn, -mɩ mɩa,","poem":1},{"text":"-ɩn mɩ -bha 'ylɩ weee nya.","poem":2},{"text":"-Bana 'bhisa we 'dɛ weee yia gɔa,","poem":1}]},{"type":"verse","number":12,"content":[{"text":"'naa 'bhisa -na yia we glɩa.","poem":2},{"text":"Gbʋzɔnʋ -wa,","poem":1},{"text":"'naa 'bhisa -na yia we 'bhitia.","poem":2},{"text":"'Ɩn -mɩ, -ɩ'ɩn 'bhiti,","poem":1},{"text":"-na 'yliyɔgagɩe 'nɩ bhloluda -ka.»","poem":2}]},{"type":"verse","number":13,"content":["-Lagɔ 'nɩ -slɔ 'anzɩ yabhlo -yla gbaɛ:",{"text":"«Yi na lilisɔlʋ ladɩlɩa,","poem":1},{"text":"'ɩn ɩn 'ka -na tʋnyɩma -na bhʋ zɔ lapalɩ.»","poem":2}]},{"type":"verse","number":14,"content":["'Anzɩnya mɩa, zuzunya -we nʋa -Lagɔɔ lubho, 'mʋ we 'dɛ weee -mɩa. We 'nɩ mʋʋ? Nɩɩ, 'mʋ -Lagɔ tiea nyɩma -wa ɔ 'kaa gbʋ 'wʋsa, we 'ka wa kwalɩ."]}],"footnotes":[]},"thisChapterLink":"/api/kyf_wbt/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kyf_wbt/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kyf_wbt/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}