{"translation":{"id":"kyf_wbt","name":"ʼWʋsuslolue loluu ʼsɛbhɛ","website":"https://ebible.org/Scriptures/details.php?id=kyf","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kyf","licenseNotes":null,"shortName":"WBT","englishName":"Kouya NT","language":"kyf","textDirection":"ltr","sha256":"4351135246566334c69105ce1b44d76295ec8604bda9f313c9927c80042f5e94","availableFormats":["json"],"listOfBooksApiLink":"/api/kyf_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7880,"languageName":"Kouya","languageEnglishName":"Kouya"},"book":{"id":"HEB","translationId":"kyf_wbt","name":"Eblenya","commonName":"Eblenya","title":"'Sɛbhɛ wa 'paa Eblenya yoo","order":58,"numberOfChapters":13,"sha256":"819c2c4acc922dedaff069596d1ecf02b94dedeb584c5c27324f8d49c5503554","firstChapterNumber":1,"firstChapterApiLink":"/api/kyf_wbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/kyf_wbt/HEB/13.json","totalNumberOfVerses":302},"chapter":{"number":8,"content":[{"type":"heading","content":["-Zezu -wa 'wʋsuslolue loluu 'kɔlʋ"]},{"type":"verse","number":1,"content":["-We -a mɩa gbada, we ji nɩ: -a ka 'sasʋkpa -Lagɔbʋbɔnyaa -kanyɔ 'kadʋ -ɔ -dɩa 'tɩtɛ -ka -Lagɔɔ 'ŋnɩmnɩkpee lilisɔlʋ la -mɔ yalɩ."]},{"type":"verse","number":2,"content":["-Lagɔɔ -mɔwlʋda ɔ nʋa lubho. -Mɔ -wa nɩmɛkupalʋʋ dɛbhie. 'Mʋ Jejitapɛ 'sʋbhaa, we 'nɩ nyɩmɛ 'sʋbha we."]},{"type":"verse","number":3,"content":["-Lagɔbʋbɔnyaa -cɩan 'kadɩ weee wa -saa -bha wa 'ka -lu wla, 'ɩn wa 'ka 'slaka -sa -Lagɔ -yla. We -ka 'sa -mɩ nɩ, da -Zezu yia, -lu -we ɔ 'kaa wla, we mɩ ɔ kwɛɛ."]},{"type":"verse","number":4,"content":["Klisɩ -ka yaa dʋdʋ -gʋ -mɩ, ɔ 'nɩa -Lagɔbʋbɔnyɔ -zɛa yi, -we ka gbʋ -wa, Moizɩɩ titee sɔlʋ, -Lagɔbʋbɔnya -wa wlaa -li -Lagɔ -yla wa mɩ dʋdʋ -gʋ."]},{"type":"verse","number":5,"content":["Waa -Lagɔbʋbɔnya mɩa, *-Lagɔbudu zɔ wa nʋa lubho. Wee -Lagɔbudu -yɔ yalɩ -nʋ 'wʋwlʋ, 'ɩn yalɩli -zɔnʋʋ zuzu -wa. Da Moizɩ 'kaa 'wʋsusloluee nɩmɛkupalʋ 'sʋbha nɩ, -Lagɔ nɛɛ ɔ -ylaɛ: «-Ɩn -mna 'wʋ, -ɩn 'sʋbha we, we 'wʋwlʋ -nʋ -we ɩn -slolua -mɩ 'klʋ -gɔgɔ 'kadʋ 'wlu 'bhisa.»"]},{"type":"verse","number":6,"content":["Sa lubho -we -Lagɔ 'nyɛa -Zezu 'ylia we -zia waa -Lagɔbʋbɔnyaa -nʋ, 'sa -bhlokpadɛ wee 'wʋsuslolue -we ka 'kɔlʋ -Zezu -mɩaa 'ylilo -zia 'wʋsusloluee tɩanʋ. -We ka gbʋ -wa, wee 'wʋsuslolue mɩa, -Lagɔɔ wlawlawɛlɩnya -gʋ we bhʋa."]},{"type":"verse","number":7,"content":["We -ka yaa nɩɩ, wee 'wʋsusloluee tɩanʋ mɩ gbada, wa 'na 'ka yaa we 'lulolu lɛnʋ."]},{"type":"verse","number":8,"content":["Nɩɩ, -Lagɔ dɩlɩa ɔ nyɩma gbʋ:",{"text":"«Jejitapɛ nɛɛ:","poem":1},{"lineBreak":true},{"text":"‹'Ylɩ -we nya ɩn 'kaa *'wʋsuslolue lolu lɛnʋ,","poem":1},{"text":"ɩn -yɔ Izlaɛlɩnyɩma -yɔ Zudaa nyɩma 'sɔ nyɩdɩ,","poem":2},{"lineBreak":true},{"text":"wee 'ylɩ mɩ yida.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"'Wʋsuslolue -we ɩn -yɔ wa dʋkpasɩ nʋa lɛ","poem":1},{"text":"-maa sɔ -yɔwʋbhulʋe -yɔ","poem":2},{"lineBreak":true},{"text":"-maa Ezipʋtʋ -nyɩmaa kwɛɛ -sasɩe nya,","poem":2},{"lineBreak":true},{"text":"wee 'wʋsuslolue -lolu -mʋnɩ -yɔ we 'na 'ka 'wʋwlʋ.","poem":2},{"text":"Wa 'nɩ wee 'wʋsuslolue 'nʋŋwɛ zʋʋ 'gbʋ,","poem":1},{"text":"'ɩn ɩn yia wa sɔ 'bɩsa,","poem":2},{"lineBreak":true},{"text":"'sa Jejitapɛ gbaa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wee 'ylɩnya -mɩnɩɩ 'bɩgʋ,","poem":1},{"text":"sa ɩn -yɔ Izlaɛlɩnyɩma 'sɔ 'kaa 'wʋsuslolu,","poem":2},{"text":"mʋ nɩ: na tite na yia wa 'wlukʋʋn zʋa,","poem":1},{"text":"'ɩn ɩn 'ka we cɛlɩ wa dlɩ zɔ,","poem":2},{"lineBreak":true},{"text":"'ɩn ɩn 'ka wa -Lagɔ -zɛ,","poem":2},{"lineBreak":true},{"text":"'ɩn wamɩa 'ka na nyɩma -zɛ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wa 'na 'ka 'maslɛɛn wa -lima gbʋ -slolu.","poem":1},{"lineBreak":true},{"text":"Nyɩmɛ yabhlogbɔɔ 'na 'ka ɔ bheli -yla gbaɛ:","poem":1},{"text":"«-Ɩn yibheli Jejitapɛ» -we ka gbʋ -wa,","poem":2},{"lineBreak":true},{"text":"we 'ka 'nyɛnyɛyua -gʋ 'bhʋ we 'ka nyɩma kpasɩ ylɩ,","poem":2},{"lineBreak":true},{"text":"yibhelia wa 'dɛ weee yia 'mɩ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wa gbʋnyii na yia 'wʋtɩa,","poem":1},{"text":"'ɩn ɩn 'na 'ka 'maslɛɛn wa lɛnʋgbʋ 'nyii dlɩ -gʋ 'pa.› »","poem":2}]},{"type":"verse","number":13,"content":["Nɩɩ, -Lagɔ -ka 'wʋsuslolue loluu gbʋ gba nɩ, -zugba ɔ ka we tɩanʋ 'sʋa -zɛlɩ. 'Ɩn -we -ka sʋa, we ka gɔ, 'ɩn la we yia daylɩ 'bhʋa."]}],"footnotes":[]},"thisChapterLink":"/api/kyf_wbt/HEB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kyf_wbt/HEB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kyf_wbt/HEB/7.json","previousChapterAudioLinks":{},"numberOfVerses":13}