{"translation":{"id":"kyf_wbt","name":"ʼWʋsuslolue loluu ʼsɛbhɛ","website":"https://ebible.org/Scriptures/details.php?id=kyf","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kyf","licenseNotes":null,"shortName":"WBT","englishName":"Kouya NT","language":"kyf","textDirection":"ltr","sha256":"4351135246566334c69105ce1b44d76295ec8604bda9f313c9927c80042f5e94","availableFormats":["json"],"listOfBooksApiLink":"/api/kyf_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7880,"languageName":"Kouya","languageEnglishName":"Kouya"},"book":{"id":"REV","translationId":"kyf_wbt","name":"Zaaan 'yliwʋgbʋnya","commonName":"Zaaan 'yliwʋgbʋnya","title":"Zaaan 'yliwʋgbʋʋ 'sɛbhɛ","order":66,"numberOfChapters":22,"sha256":"0a39f57117e18e1faf952eeae51f5b5ed169a1b6b9919887c15e40f1909d9d8c","firstChapterNumber":1,"firstChapterApiLink":"/api/kyf_wbt/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/kyf_wbt/REV/22.json","totalNumberOfVerses":402},"chapter":{"number":15,"content":[{"type":"heading","content":["'Anzɩ gbesɔ -yɔ 'wʋbhlolu -sɩasɩe gbesɔ"]},{"type":"verse","number":1,"content":["-Mʋʋ 'bɩgʋ, 'ɩn ɩn yia gwɛdilu -putu -yɔyɩ -mɔ yalɩ: we 'yli, 'ɩn we yia nyɩma ŋwɛgaga sʋbhalɩ. 'Anzɩ gbesɔ ka sɩasɩe gbesɔ kwɛɛ. Wee sɩasɩe -wa 'wʋbhlolu -sɩasɩe. Nɩɩ, mʋ nya -Lagɔ gbalɩa ɔ 'cɛ."]},{"type":"verse","number":2,"content":["Tɔʋn, ɩn yia -lu yabhlo -yɔyɩ, we 'wlʋ sa gumunyu 'sese -we -yɔ -kosu mɩ 'wʋsusloluda. -Wa lua nɩmɛ klaa, we tɛlɩtɛlɩnʋ klaa, we -yɔ we nimeloo, wa 'yligbe gumunyu -gʋ. Wa ka -Lagɔɔ -pete kwɛɛ."]},{"type":"verse","number":3,"content":["Wa mɩ -Lagɔɔ lubhonʋnyɔ *Moizɩ -yɔ Bhlabhlɛyuu lʋʋ bhlɩda. Wa nɛɛ:",{"text":"«Jejitapɛ,","poem":1},{"text":"'tɩtɛ weee -Kanyɔ -Lagɔ,","poem":2},{"lineBreak":true},{"text":"-na lɛnʋgbʋnya 'yli,","poem":2},{"lineBreak":true},{"text":"'ɩn we nanɩa 'yli.","poem":2},{"text":"Nyɩma weee 'wlulapɩlɩnyɔ,","poem":1},{"text":"-na yoo mɩ tɩklɩɩ,","poem":2},{"lineBreak":true},{"text":"'ɩn we nanɩa 'yli.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"-Ɔ 'nɩa ŋwnu ɔ 'ka -mɩ sɔ,","poem":1},{"text":"'ɩn ɔ 'ka -na 'ŋnɩ 'ylimanɩ,","poem":2},{"lineBreak":true},{"text":"-mɔɔ -kanyɔ 'nɩ -mɩ.","poem":2},{"text":"-We ka gbʋ -wa,","poem":1},{"text":"-mɩ -bhlogbɔɔ mɩa -mɔwlʋda.","poem":2},{"text":"Nɩɩ, dʋdʋgʋ -nyɩma weee yia -mɩ 'yu 'wlulagblia","poem":1},{"text":"wa 'ka -mɩ bʋbɔ,","poem":2},{"lineBreak":true},{"text":"-we ka gbʋ -wa,","poem":2},{"lineBreak":true},{"text":"wa ka -na lɛnʋgbʋ tɩklɩɩ -yɔyɩ.»","poem":2}]},{"type":"verse","number":5,"content":["-Mʋʋ 'bɩgʋ, 'ɩn ɩn yia -Lagɔbudu 'kadʋ -yɔyɩ ŋwɛkalɩda -mɔ yalɩ. -Mɔ we nʋkplɛ, -Lagɔɔ -mɔwlʋ -ladɩlɩda mɩ -mɔ."]},{"type":"verse","number":6,"content":["'Anzɩ gbesɔ -we sɩasɩe gbesɔ mɩa kwɛɛ, mʋ 'tlaa -Lagɔbudu 'kadʋ zɔ. We ka -bana 'pʋpa 'paɩnpaɩn 'wʋ. We 'kɩklɛyli mɩa, -can -cɛsli mɩa -bha."]},{"type":"verse","number":7,"content":["Wee -yliyɔgali -mnʋaa 'yabhlo 'nyɛa wee 'anzɩ gbesɔ -can -kɔpʋ gbesɔ yoo. Wee 'kɔpʋ mɩ yeda 'yliyɔga -Lagɔɔ 'cɛ nya."]},{"type":"verse","number":8,"content":["Gbeylo yabhlo 'bhʋa -mɔ -Lagɔɔ 'tɩtɛ -yɔ ɔ 'ŋnɩmnɩe 'wʋ, mʋ yea -Lagɔbudu 'kadʋ. Nɩɩ, sɩasɩe gbesɔ -we mɩa 'anzɩ gbesɔ kwɛɛ, we 'nɩ -slɔ 'plɩ nɩ, nyɩmɛ yabhlogbɔɔ 'nɩ mneni ɔ 'ka -Lagɔbudu 'kadʋ zɔ pla."]}],"footnotes":[]},"thisChapterLink":"/api/kyf_wbt/REV/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kyf_wbt/REV/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kyf_wbt/REV/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}