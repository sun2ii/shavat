{"translation":{"id":"kyf_wbt","name":"ʼWʋsuslolue loluu ʼsɛbhɛ","website":"https://ebible.org/Scriptures/details.php?id=kyf","licenseUrl":"https://ebible.org/Scriptures/details.php?id=kyf","licenseNotes":null,"shortName":"WBT","englishName":"Kouya NT","language":"kyf","textDirection":"ltr","sha256":"4351135246566334c69105ce1b44d76295ec8604bda9f313c9927c80042f5e94","availableFormats":["json"],"listOfBooksApiLink":"/api/kyf_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7880,"languageName":"Kouya","languageEnglishName":"Kouya"},"book":{"id":"REV","translationId":"kyf_wbt","name":"Zaaan 'yliwʋgbʋnya","commonName":"Zaaan 'yliwʋgbʋnya","title":"Zaaan 'yliwʋgbʋʋ 'sɛbhɛ","order":66,"numberOfChapters":22,"sha256":"0a39f57117e18e1faf952eeae51f5b5ed169a1b6b9919887c15e40f1909d9d8c","firstChapterNumber":1,"firstChapterApiLink":"/api/kyf_wbt/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/kyf_wbt/REV/22.json","totalNumberOfVerses":402},"chapter":{"number":18,"content":[{"type":"heading","content":["Babilɔnʋgbee bhlibhlie"]},{"type":"verse","number":1,"content":["-Mʋʋ 'bɩgʋ, 'ɩn ɩn yia 'anzɩ -putu -yɔyɩ yalɩ 'bhʋda. We ka 'tɩtɛ, 'ɩn we san nynia dʋdʋʋ da weee."]},{"type":"verse","number":2,"content":["We 'kpɩa 'wʋ 'tɩtɛɛ, we nɛɛ:",{"text":"«Ɔ ka bhli, Babilɔnʋgbe 'kadʋ ka bhli.","poem":1},{"lineBreak":true},{"text":"-Bha zuzu 'nyii dɩlɩa -slɛɛn la.","poem":1},{"lineBreak":true},{"text":"Pʋɩnkazuzu weee -yɔ pʋɩnkazia weee","poem":1},{"text":"-we wa nyɛa 'wʋ,","poem":2},{"text":"mʋ dɩlɩa -bha la.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nɩɩ, ɔ ka laga weee ɔ nʋ 'nyɛ sa duun,","poem":1},{"text":"'ɩn -mɔmɔ -ka ɔ nʋ 'ma,","poem":2},{"lineBreak":true},{"text":"'ɩn -mɔɔ -kanyɔ bhlilia ɔ mʋtnɩ lʋ.","poem":2},{"text":"Dʋdʋgʋ -nyɩmaa 'wlulapɩlɩnya -yɔ ɔ 'sɔ ka -budu 'wʋdɩ.","poem":1},{"lineBreak":true},{"text":"'Ya, ɔ 'ŋnɩmnɩe 'kadʋʋ 'gbʋ,","poem":1},{"text":"dʋdʋ -gʋʋ -valɛpanya ka 'gwɛzi duun 'yɩ.»","poem":2}]},{"type":"verse","number":4,"content":["'Ɩn ɩn yia wɛlɩ -putu 'bhʋa yalɩ 'nʋ, we nɛɛ:",{"text":"«Na nyɩma, a 'tla Babilɔnʋgbe nʋkplɛ.","poem":1},{"lineBreak":true},{"text":"A -ka we lɛnʋ, a 'na 'ka ɔ gbʋnyuu glaa -mɩ,","poem":1},{"text":"'ɩn sɩasɩe -we yia ɔ bhɩtɩa,","poem":2},{"lineBreak":true},{"text":"a 'na 'ka we 'wʋ -mɩ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nɩɩ, ɔ gbʋnyii ylɩa yalɩ.","poem":1},{"lineBreak":true},{"text":"-Lagɔ 'nɩ ɔ lɛnʋgbʋ 'nyii 'wʋdlʋ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sa ɔ nʋa ɔ nyɩma, a nʋ 'sa ɔ.","poem":1},{"lineBreak":true},{"text":"-We ɔ nʋa nyɩma -yla lɛ,","poem":1},{"text":"a nʋ we -zakpa 'sɔ lɛ ɔ -yla.","poem":2},{"text":"'Kɔpʋ -we 'wʋ ɔ 'nyɛnɩa nyɩma nʋ,","poem":1},{"text":"a palɩ -mɔ 'tɛlɔ nʋʋ -zakpa 'sɔ ɔ -yla.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"'Dɛɛ 'ylimanɩe -yɔ 'ŋnɩmnɩe ɔ 'yɩbhaa.","poem":1},{"lineBreak":true},{"text":"We 'dɛɛ 'gbʋ, a 'nyɛ ɔ 'sasʋkpa -sɩasɩe","poem":1},{"text":"-yɔ guwʋwlʋwlʋe.","poem":2},{"text":"Ɔ nɛɛ ɔ 'dɛ -yla:","poem":1},{"lineBreak":true},{"text":"‹Ɩn -dɩ 'ŋnɩmnɩkpe -gʋla.","poem":1},{"lineBreak":true},{"text":"Ɩn 'nɩ -dʋgbaŋwnɔ,","poem":1},{"text":"'ɩn gu 'na 'ka 'mɩ 'wʋwlʋ.›","poem":2}]},{"type":"verse","number":8,"content":[{"text":"We 'dɛɛ 'gbʋ, sɩasɩe 'kadɩ","poem":1},{"text":"-we yia ɔ ylɩa 'ylɩ -bhlo nya, mʋ nɩ:","poem":2},{"text":"nyɩmɛ -bhagu klaa, guwʋwlʋwlʋe klaa,","poem":1},{"text":"we -yɔ ŋwɔ.","poem":2},{"text":"We 'dɛ weee yia ɔ -gbɛ yia.","poem":1},{"lineBreak":true},{"text":"'Ɩn -kosu 'ka ɔ -sie.","poem":1},{"lineBreak":true},{"text":"Cɩɩn, Jejitapɛ -ɔ 'bhua ɔ -yɔgbʋ 'wʋ,","poem":1},{"text":"ɔ ka 'tɩtɛ.»","poem":2}]},{"type":"verse","number":9,"content":["Nɩɩ, dʋdʋgʋ -nyɩmaa 'wlulapɩlɩnya -yɔ ɔ ka -budu 'wʋdɩ. Wa ka ɔ 'gwɛzi li. We mɩ 'saa 'gbʋ, -kosu -we yia ɔ -siea, wa -ka we gbeylo -yɔyɩ, wia wa yia. -Gle wa yia 'paa wee 'gbee 'gbʋ."]},{"type":"verse","number":10,"content":["Wa 'na 'ka we kwesi lanyni, -we ka gbʋ -wa, nyanɔ wa yia nʋa wee sɩasɩe 'kadʋʋ 'gbʋ, 'ɩn wa 'ka gbaɛ:",{"text":"«Gbʋnyuu! Gbʋnyuu!","poem":1},{"lineBreak":true},{"text":"Babilɔnʋgbe 'kadʋ, 'gbe 'tɩtɛ,","poem":1},{"text":"-Lagɔɔ 'cɛ 'kadʋ ka ɔ lasa","poem":2},{"lineBreak":true},{"text":"'lɛlɩ -bhlogbɔɔ nya.»","poem":2}]},{"type":"verse","number":11,"content":["Nɩɩ, dʋdʋ -gʋʋ -valɛpanya mɩ wida, wa mɩ -gle 'pada wee 'gbee 'gbʋ. Wa -valɛ'ɛ zɔ -slɛɛn."]},{"type":"verse","number":12,"content":["Wa pɛlʋpa -li nɩ: -can klaa, 'gwɛzi 'pʋpa klaa, tʋkpa -zɔnʋ klaa, 'pɛlɩlɩ klaa, 'naa -zɔnʋ klaa, 'naa -zalʋ -we ka -valɛ 'tɛa klaa, -mislɔ naa klaa, we -yɔ suu 'yli -bhlo -bhlo -we wa'a 'yɩa bhebhe. Tɛlɩtɛlɩli mɩ 'ya -bha, tɔlʋa mɩ lʋɛgla nya, tɔlʋa mɩ su -zɔnʋ nya, tɔlʋa mɩ nɛtɛ -zɔnʋ nya, 'ɩn tɔlʋa mɩa tʋkpa 'nanɩ nya."]},{"type":"verse","number":13,"content":["-Zapʋʋ nnanɩli mɩ -bha, -li -we ka ŋnɛ mɛnɩa, we mɩ 'ya -bha, -mʋ -wa: *-lasiklɔ klaa, *milɩ klaa, we -yɔ 'wlɩ. Nɩɩ, nʋ klaa, 'kpɩ klaa, bleya -yɔ we bhʋbhʋ klaa, 'bhlinya klaa, bhlabhlɛnya klaa, nɩmɛsʋʋnnya klaa, we -yɔ -nɩmɛsʋʋʋn 'wʋgbizewotlonya mɩ 'ya -bha. 'Bhie, galɩ -yɔ nyɩma tɔlʋa mɩ -bha."]},{"type":"verse","number":14,"content":["Nɩɩ, -valɛpanya nɛɛ wee 'gbe -ylaɛ: «-Lu weee a 'yɩbhaa, wa'a 'yɩ -slɛɛn we amaa -gbɛ. -We ka -valɛ 'tɛa, -we nanɩa 'yli, we ka amaa -gbɛ mnɔ, wa 'na 'ka 'maslɛɛn we 'yɩ amaa -gbɛ.»"]},{"type":"verse","number":15,"content":["-Valɛpanya, -wa 'yɩa 'gwɛzi wa -valɛ 'bɩ wee 'gbe 'wʋ, wa 'na 'ka we kwesi lanyni. Nyanɔ wa yia nʋa wee sɩasɩe 'kadʋʋ 'gbʋ. Wia wa yia, -gle wa yia 'paa."]},{"type":"verse","number":16,"content":["'Wʋ wa yia 'kpɩaɛ:",{"text":"«Gbʋnyuu! Gbʋnyuu!","poem":1},{"lineBreak":true},{"text":"Gbe 'kadʋ mɩa da nɩ,","poem":1},{"text":"'naa -zɔnʋ -yɔ 'naa -zalʋ","poem":2},{"lineBreak":true},{"text":"-we ka -valɛ 'tɛa,","poem":2},{"lineBreak":true},{"text":"zlɩmɛ mʋ kaa we kuu.","poem":2},{"text":"-Can klaa, tʋkpa -zɔnʋ klaa, we -yɔ 'pɛlɩlɩ,","poem":1},{"text":"'mʋ ɔ kpelia zlɩmɛ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nɩɩ, 'lɛlɩ -bhlogbɔɔ nya","poem":1},{"text":"we -li -zɔnʋ weee 'bhʋa la.»","poem":2},"Batoo -panya weee klaa, -wa plɩlɩa gumunyu -gʋ klaa, we -yɔ -wa nʋa batoo 'wʋ lubho -yɔ -wa yɩa wanʋʋ lililu 'nyu -gʋ -valɛpapɩe 'bɩ, wa 'dɛ weee ka wee 'gbe gwevla."]},{"type":"verse","number":18,"content":["-Kosu mɩa wee 'gbe -sieda, wa -ka we gbeylo -yɔyɩ, 'ɩn wa 'kpɩa 'wʋɛ: «Gbe mɩa dɛ, we 'sɔnʋ 'nɩ -mɩ.»"]},{"type":"verse","number":19,"content":["Bla wa slua 'wluo, -zugba wa wi, wa pa -gle, wa gbaɛ:",{"text":"«Gbʋnyuu! Gbʋnyuu!","poem":1},{"lineBreak":true},{"text":"Babilɔnʋgbe 'kadʋ,","poem":1},{"lineBreak":true},{"text":"nyɩma weee -wa plɩlɩa amaa -gbɛ","poem":1},{"text":"batoo 'wʋ gumunyu -gʋ,","poem":2},{"text":"wa ka 'gwɛzi -cɩan -zɛ amaa 'gbʋ.","poem":1},{"lineBreak":true},{"text":"Ama 'bhʋa la 'lɛlɩ -bhlo nya.»","poem":1}]},{"type":"verse","number":20,"content":["Yalɩ, wee 'gbe ka labhʋ, a li 'mʋna. -Lagɔnyɩma, ɔ tietienya, ɔ gbʋʋ -falɩpanya, amɩa li 'ya 'mʋna. Nɩɩ, -Lagɔ ka wee 'gbe ɔ 'cɛ 'klʋslolu gbʋ -we we nʋa lɛ aɩn -yla, we 'gbʋ."]},{"type":"verse","number":21,"content":["Tɔʋn, 'anzɩ 'tɩtɛ yabhlo yia tʋkpa 'wʋbhu. Nɩɩ, wee tʋkpa wɔlʋ 'wʋ -glɩgbɔ 'bhisa. We 'bhua we 'wʋ, we vitelia we gumunyu lʋ, 'ɩn we nɛɛ:",{"text":"«A yla, 'sa -bhlokpadɛ wa yia Babilɔnʋgbe vitelia,","poem":1},{"text":"'ɩn we 'ka labhʋ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Wa 'na 'ka 'maslɛɛn lʋʋ 'nʋ Babilɔnʋgbe nʋkplɛ.","poem":1},{"lineBreak":true},{"text":"Wa 'na 'ka -petee wɛlɩ 'nʋ.","poem":1},{"lineBreak":true},{"text":"Wa 'na 'ka 'maslɛɛn lɛglɛ 'nʋ.","poem":1},{"lineBreak":true},{"text":"Wa 'na 'ka lubho -yɔ lubhonʋnya 'yɩ.","poem":1},{"lineBreak":true},{"text":"Wa 'na 'ka 'maslɛɛn 'wuu -jiji 'nʋ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"'Napɛɛ san 'na 'ka 'maslɛɛn lɩ","poem":1},{"text":"-mɔ Babilɔnʋgbe nʋkplɛ.","poem":2},{"text":"Wa 'na 'ka nyimeslɔyu -yɔ ɔ 'ŋwnɔɔ wɛlɩ 'nʋ.","poem":1},{"lineBreak":true},{"text":"Nɩɩ, amaa -valɛpanya 'ylia -benyi dʋdʋ weee -gʋ,","poem":1},{"text":"'ɩn a yia laga weee -dawli 'wʋnʋ","poem":2},{"lineBreak":true},{"text":"amaa ylisi nya.»","poem":2}]},{"type":"verse","number":24,"content":["Nɩɩ, -Lagɔgbʋʋ -falɩpanya -yɔ -Lagɔnyɩmaa tlɩtlɩe, we -yɔ nyɩma weee -wa wa 'bhaa dʋdʋ -gʋʋ tlɩtlɩe mɩ ɔ 'wlu."]}],"footnotes":[]},"thisChapterLink":"/api/kyf_wbt/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kyf_wbt/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/kyf_wbt/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}