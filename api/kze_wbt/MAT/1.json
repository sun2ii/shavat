,{"text":"Síátio Sérápápeomba marankówana","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sérápápeo Ápáyatimba marankówana","poem":1},{"lineBreak":true},{"text":"Ápáyati Éráyakimumba marankówana","poem":1},{"lineBreak":true},{"text":"Éráyakimu Ésomba marankówana","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Éso Sétókomba marankówana","poem":1},{"lineBreak":true},{"text":"Sétóko Ékímumba marankówana","poem":1},{"lineBreak":true},{"text":"Ékímu Éráyatimba marankówana","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Éráyati Éríesaamba marankówana","poem":1},{"lineBreak":true},{"text":"Éríesaa Mátánaamba marankówana","poem":1},{"lineBreak":true},{"text":"Mátánaa Yákópomba marankówana","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yákópo Yósépimba marankówana","poem":1},{"lineBreak":true},{"text":"Yósépi Máríyaamba awaikó úwana Máríyaa Ísumba anówamani. Ísuntavesa Áánútu usásinankaiwaiye sésa Káráísitiye kwésewe.","poem":1}]},{"type":"verse","number":17,"content":["Ááváramumo máyonka'a sísamaivakemba éíyaimba kumbaimái-kwaasi 14 kwaasi agáyówasa Tévítimo paárurenamo máyonka'a sísamaivakemba éíyaimba kumbaimái-kwaasi 14 kwaasi agáyówasa Pépírónivakewai tayí'maesa Pépíróniva'a ándáva'a mátínkarowasa máyón-kanaavimba sísamaivakemba éíyaimba kumbaimái-kwaasi 14 kwaasi agáyówana minká'á Máríyaa Ísu Káráísitimba maránkaraiye."]},{"type":"heading","content":["Ísumba maránkarain-kwasai."]},{"type":"verse","number":18,"content":["Ísu Káráísitimba marankómba maará uráiye. Ísu anówamba Yósépinka'a siváúmaresa ítámakowana Yósépi íma kwesé kurónka'a ámú'a paáruraiye. Áánútun-amanko ámú'a paárumankarowana"]},{"type":"verse","number":19,"content":["awaikó kawe'á kwéuwai séna kwaási túranka'a ai'máráanana Máríyaa aigaeyávéna iváímpo'a aúpá'á ai'mátuwanaumne-imayaa uráiye."]},{"type":"verse","number":20,"content":["mirá imáyáama kwéena aún-kwáyowana Ísóigona kwayó'nákó kwíyómpakewai kaainampá'á simámena séna Yósépiyo Tévítin-andaraken-kwaasi óne. Máríyaamo ámú'o káúvímba Áánútun-amankowe su'mai ámú'a kauwánkáímba po kwembá úwoi mayáníyompo íma áá'a kaíno."]},{"type":"verse","number":21,"content":["iyámpóímo marankánímba áwí'a Ísuwe simámiyo siráiye. mináwíkóná ááimba kwená kwaási sáwí-imayaaomo tátokaimpinkemba iyátinkaniye siráiye."]},{"type":"verse","number":22,"content":["naaóvá'á Áánútun-aai simátímakowai sirónka'a póna mirán-tántáá'á paáruraiye."]},{"type":"verse","number":23,"content":["kwemá agaimaréna séna",{"text":"moórá-inaamarugo kwaaí íma mairéna ámú'a","poem":1},{"lineBreak":true},{"text":"kaumái iyámpói marankáínasa miníyámpóígó","poem":1},{"lineBreak":true},{"text":"áwí'a Émániyueriye sénááowe","poem":1},"agaimaréna siráimba mináwíkóná ááimba Áánútu keséya máyáiye siráiye."]},{"type":"verse","number":24,"content":["Yósépi aúvínké usásinena Ísóigona kwayó'nákó kwíyómpakewai siróntemba awainínkómbá mairéna"]},{"type":"verse","number":25,"content":["íma kwesé kúmba úwoi ména kárákwirowana iyámpói marankówana Ísuwe séna áwí'a tamánkaraiye."]},{"type":"heading","content":["aaváúmó usópaken-kwaasi taawánaraan-kwasai."]}],"footnotes":[]},"thisChapterLink":"/api/kze_wbt/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/kze_wbt/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":25}