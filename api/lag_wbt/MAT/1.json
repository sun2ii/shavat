{"translation":{"id":"lag_wbt","name":"Rangi","website":"https://ebible.org/Scriptures/details.php?id=lag","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lag","licenseNotes":null,"shortName":"WBT","englishName":"Rangi NT","language":"lag","textDirection":"ltr","sha256":"95411e43b3aa6e4e76ca1acf944861d951ff3a135d58bd3109be4276b64cffdd","availableFormats":["json"],"listOfBooksApiLink":"/api/lag_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7957,"languageName":"Kɨlaangi","languageEnglishName":"Langi"},"book":{"id":"MAT","translationId":"lag_wbt","name":"Matáayo","commonName":"Matáayo","title":"Masáare Maaja ya Yéesu Kirisitʉ ja ˆvyeene yaandɨkwa nɨ Matáayo","order":40,"numberOfChapters":28,"sha256":"eda21da3565fb7b1104fa513c8bddc23083a5b6b60592e5fb435f3d47a20413a","firstChapterNumber":1,"firstChapterApiLink":"/api/lag_wbt/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/lag_wbt/MAT/28.json","totalNumberOfVerses":1071},"chapter":{"number":1,"content":[{"type":"heading","content":["Lʉkolo lwa Yéesu"]},{"type":"verse","number":1,"content":["Ɨhɨ noo nkʉmbʉkɨra ya marina ya lʉkolo lwa YéesuKirisitʉ, mwaana wa Daúdi, mwaana wa Aburaháamu."]},{"type":"verse","number":2,"content":[{"text":"Aburaháamu ajáa amʉvyaala Isaka,","poem":1},{"lineBreak":true},{"text":"Isaka akamʉvyaala Yaakúupu,","poem":1},{"lineBreak":true},{"text":"Yaakúupu akamʉvyaala Yʉ́ʉda na vaanaavo,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yʉ́ʉda akamʉvyaala Peréesi na Séera na íyo waavo nɨ Tamáari ajáa.","poem":1},{"lineBreak":true},{"text":"Peréesi akamʉvyaala Hesiróoni,","poem":1},{"lineBreak":true},{"text":"Hesiróoni akamʉvyaala Aráamu,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aráamu akamʉvyaala Aminadáabu,","poem":1},{"lineBreak":true},{"text":"Aminadáabu akamʉvyaala Nashóoni,","poem":1},{"lineBreak":true},{"text":"Nashóoni akamʉvyaala Salimóoni,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Salimóoni akamʉvyaala Boáasi, fuma kwa Raháabu.","poem":1},{"lineBreak":true},{"text":"Boáasi akamʉvyaala Obéedi fuma kwa Rúutu,","poem":1},{"lineBreak":true},{"text":"Obéedi akamʉvyaala Yéese,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ne Yéese akamʉvyaala mʉtemi Daúdi.","poem":1},{"lineBreak":true},{"text":"Daúdi akamʉvyaala Solomóoni fuma kwa muki wa Uría.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Solomóoni akamʉvyaala Rehoboáamu,","poem":1},{"lineBreak":true},{"text":"Rehoboáamu akamʉvyaala Abíya,","poem":1},{"lineBreak":true},{"text":"Abíya akamʉvyaala Áasa,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Áasa akamʉvyaala Yehoshofáati,","poem":1},{"lineBreak":true},{"text":"Yehoshofáati akamʉvyaala Yóramu,","poem":1},{"lineBreak":true},{"text":"Yóramu akamʉvyaala Usíia,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Usíia akamʉvyaala Yósamu,","poem":1},{"lineBreak":true},{"text":"Yósamu akamʉvyaala Aháasi,","poem":1},{"lineBreak":true},{"text":"Aháasi akamʉvyaala Hesekía,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hesekía akamʉvyaala Manáase,","poem":1},{"lineBreak":true},{"text":"Manáase akamʉvyaala Amóoni,","poem":1},{"lineBreak":true},{"text":"Amóoni akamʉvyaala Yosía,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yosía akamʉvyaala Yekonía na vaanaavo,","poem":1},{"lineBreak":true},{"text":"mpɨɨndɨ vaantʉ va Yʉ́ʉda ˆvakasaamiwe na ɨsɨ ya ʉyenii ya Babéeli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Lʉsaamo lwa Babéeli ˆlʉkalooke,","poem":1},{"lineBreak":true},{"text":"Yekonía akamʉvyaala Searitiéeli,","poem":1},{"lineBreak":true},{"text":"Searitiéeli akamʉvyaala Serubabéeli,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Serubabéeli akamʉvyaala Abiúudi,","poem":1},{"lineBreak":true},{"text":"Abiúudi akamʉvyaala Eliakíimu,","poem":1},{"lineBreak":true},{"text":"Eliakíimu akamʉvyaala Asóori,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Asóori akamʉvyaala Sadóoki,","poem":1},{"lineBreak":true},{"text":"Sadóoki akamʉvyaala Akíimu,","poem":1},{"lineBreak":true},{"text":"Akíimu akamʉvyaala Eliúudi,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Eliúudi akamʉvyaala Elieséeri,","poem":1},{"lineBreak":true},{"text":"Elieséeri akamʉvyaala Matáani,","poem":1},{"lineBreak":true},{"text":"Matáani akamʉvyaala Yaakúupu,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yaakúupu akamʉvyaala Yooséefu, mʉlʉme wa Maríia.","poem":1},{"lineBreak":true},{"text":"Maríia akamʉvyaala Yéesu ˆaánɨrɨrwaa Masía.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":["Jeyyo, kʉjáa kwatɨɨte mbyaala ikimi na ine (14) fuma Aburaháamu fʉʉrʉ mʉtemi Daúdi. Kei, kʉjáa kwatɨɨte mbyaala ikimi na ine fuma mʉtemi Daúdi, fʉʉrʉ lʉsaamo lwa Viisiraéeli kʉtwaalwa na ɨsɨ ya ʉyenii ya Babéeli. Na mbyaala ikimi na ine fuma lʉsaamo lwa Viisiraéeli kʉtwaalwa na ɨsɨ ya ʉyenii ya Babéeli, fʉʉrʉ kʉvyaalwa kwa Masía."]},{"type":"heading","content":["Kʉvyaalwa kwa Yéesu Kirisitʉ"]},{"type":"verse","number":18,"content":["Iji noo mbuwo ja kʉvyaalwa kwa Yéesu Kirisitʉ. Maríia íyo waala Yéesu ajáa atʉmɨrwa nɨ Yooséefu. Maa kaa, mpɨɨndɨ ˆvajáa vakaarɨ sɨ vanalʉmana ja muki na mʉlʉme, Maríia akava mawʉlʉ maruto kwa njɨra ya Mʉtɨma Mʉʉja."]},{"type":"verse","number":19,"content":["Yooséefu mʉlʉme waachwe baa neembe ajáa nɨ mʉʉntʉ mʉwoloki, sɨ asaakáa kʉmʉkwaatya soni Maríia mbere ja vaantʉ tʉkʉ, akalamʉla kʉmʉreka Maríia kimbiso."]},{"type":"verse","number":20,"content":["Mpɨɨndɨ ˆajáa akaarɨ yookiiririkana ɨrɨ isáare, murimʉ mʉʉja wa Ijʉva ʉkamʉfʉmɨra tulwii, maa ʉkamʉsea, “Yooséefu, mwaana wa Daúdi, koofa kʉmʉsʉmʉla Maríia ave muki waako tʉkʉ, sa uruto ˆatɨɨte nɨ kwa lʉvɨro lwa Mʉtɨma Mʉʉja."]},{"type":"verse","number":21,"content":["Kiichʉngʉla arɨ mwaana mʉlʉme, na mʉkemera ʉrɨ irina raachwe Yéesu, sa yeeye noo ˆarɨ valamurirya vaantʉ vaachwe fuma uvii waavo.”"]},{"type":"verse","number":22,"content":["Aya yoosi yafʉ́mɨɨre, sa masáare Ijʉva ˆalʉʉsa kwa njɨra ya mʉláali na mʉtwe waachwe yakiimane,"]},{"type":"verse","number":23,"content":[{"text":"“Laanga, mʉnjalʉ sʉmʉla arɨ ɨnda,","poem":1},{"lineBreak":true},{"text":"yeeye vyaala arɨ mwaana mʉlʉme,","poem":1},{"lineBreak":true},{"text":"novo mwaanɨrɨra varɨ irina raachwe Emanʉéeli,”","poem":1},{"lineBreak":true},{"text":"noo kʉsea, “Mʉlʉʉngʉ nɨ na suusu arɨ.”","poem":1}]},{"type":"verse","number":24,"content":["Yooséefu ˆakiinʉke fuma tulwii, akabweeyya ja viintʉ murimʉ mʉʉja wa Ijʉva ˆʉjáa ʉmʉwyɨ́ɨrɨɨre. Aho, akamʉsʉmʉla Maríia akava muki waachwe."]},{"type":"verse","number":25,"content":["Maa kaa, Yooséefu sɨ amʉseeserera Maríia tʉkʉ, fʉʉrʉ akiichʉngʉla mwaana wa kɨɨntʉ kɨlʉme. Yooséefu akamʉkemera irina raachwe Yéesu."]}],"footnotes":[]},"thisChapterLink":"/api/lag_wbt/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lag_wbt/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":25}