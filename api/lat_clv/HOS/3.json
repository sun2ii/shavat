imo dierum."]}],"footnotes":[]},"thisChapterLink":"/api/lat_clv/HOS/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lat_clv/HOS/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lat_clv/HOS/2.json","previousChapterAudioLinks":{},"numberOfVerses":5}