{"translation":{"id":"lat_clv","name":"Bibbia Vulgata Clementina na 1598","website":"https://ebible.org/Scriptures/details.php?id=latVUC","licenseUrl":"https://ebible.org/Scriptures/details.php?id=latVUC","licenseNotes":null,"shortName":"CLV","englishName":"Clementine Vulgate 1598","language":"lat","textDirection":"ltr","sha256":"691ee4765afc491123465139ae6c110d6c795514e72672a9e26956318fdfcd6f","availableFormats":["json"],"listOfBooksApiLink":"/api/lat_clv/books.json","numberOfBooks":66,"totalNumberOfChapters":1197,"totalNumberOfVerses":31434,"languageName":"Latin","languageEnglishName":"Latin","numberOfApocryphalBooks":7,"totalNumberOfApocryphalChapters":137,"totalNumberOfApocryphalVerses":4375},"book":{"id":"PSA","translationId":"lat_clv","name":"PSALMORUM","commonName":"PSALMORUM","title":"INCIPIT LIBER PSALMORUM IUXTA HEBRAICUM TRANSLATUS","order":19,"numberOfChapters":150,"sha256":"4caa96bd8360bef193b205ce2c6afa15027b4c2259877deae9d912b26ffb537b","firstChapterNumber":1,"firstChapterApiLink":"/api/lat_clv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lat_clv/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":129,"content":[{"type":"verse","number":1,"content":[{"text":"Canticum graduum. [De profundis clamavi ad te, Domine;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Domine, exaudi vocem meam. Fiant aures tuæ intendentes in vocem deprecationis meæ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Si iniquitates observaveris, Domine, Domine, quis sustinebit?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quia apud te propitiatio est; et propter legem tuam sustinui te, Domine. Sustinuit anima mea in verbo ejus:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"speravit anima mea in Domino.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A custodia matutina usque ad noctem, speret Israël in Domino.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Quia apud Dominum misericordia, et copiosa apud eum redemptio.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Et ipse redimet Israël ex omnibus iniquitatibus ejus.]","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/lat_clv/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lat_clv/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lat_clv/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}