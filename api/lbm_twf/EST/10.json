{"translation":{"id":"lbm_twf","name":"जीवन को वचन","website":"https://ebible.org/Scriptures/details.php?id=lbm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lbm","licenseNotes":null,"shortName":"TWF","englishName":"Lodhi NT","language":"lbm","textDirection":"ltr","sha256":"d6612e68751ba23efe82152593e2e1c6da7d777c582dd9d5a1dd5eee11eb1506","availableFormats":["json"],"listOfBooksApiLink":"/api/lbm_twf/books.json","numberOfBooks":37,"totalNumberOfChapters":496,"totalNumberOfVerses":14434,"languageName":"Lodhi","languageEnglishName":"Lodhi"},"book":{"id":"EST","translationId":"lbm_twf","name":"एस्तेर","commonName":"एस्तेर","title":"एस्तेर की किताब एस्तेर की किताब","order":17,"numberOfChapters":10,"sha256":"737d43547bdd2afa19af55e33cec58d7cb058b151e08be8575c1a5701e16c302","firstChapterNumber":1,"firstChapterApiLink":"/api/lbm_twf/EST/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/lbm_twf/EST/10.json","totalNumberOfVerses":167},"chapter":{"number":10,"content":[{"type":"heading","content":["राजा क्षयर्ष अऊर मोर्दकै की महानता"]},{"type":"verse","number":1,"content":["राजा क्षयर्ष न देश अऊर समुन्दर को जवर को टापू को क्षेत्र पर कर लगायो।"]},{"type":"verse","number":2,"content":["ओको सामर्थ अऊर पराक्रम को कामों, अऊर मोर्दकै की ऊ बड़ायी को पूरो ब्योरा, जो राजा न ओकी करी होती, का ऊ मादै अऊर फारस को राजावों को इतिहास की किताब म नहीं लिख्यो हय?"]},{"type":"verse","number":3,"content":["यहूदी मोर्दकै, क्षयर्ष राजा कोच खल्लो होतो, अऊर यहूदियों की नजर म बड़ो होतो, अऊर ओको सब भाऊ ओको सी खुश होतो, कहालीकि ऊ अपनो लोगों की भलायी की खोज म रहत होतो अऊर अपनो सब लोगों सी शान्ति की बाते बोलत होतो।"]}],"footnotes":[]},"thisChapterLink":"/api/lbm_twf/EST/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lbm_twf/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lbm_twf/EST/9.json","previousChapterAudioLinks":{},"numberOfVerses":3}