umber":16,"content":["(ᤀᤥᤘᤠ. ᤀᤡᤱᤃᤠ᤹ ᤛ᤻ᤋᤡᤑᤏᤛᤖᤧ ᤁᤢᤜᤡᤶᤛᤕᤱᤒᤠᤜᤠ᤹ᤀᤠᤱ ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤐᤡᤖᤢᤱᤛᤡᤱ. ᤜᤧᤰᤁᤩᤠᤱ ᤘᤣ᤹ᤜᤠ᤹ᤀᤠᤱ ᤐᤡᤖᤢᤱᤛᤡᤱᤒᤡ ᤔᤧ᤺ᤶᤒᤡ ᤂᤧᤱᤃ ᤀᤡᤱᤃᤠ᤹ ᤀᤠᤏᤡᤱᤘᤠ᤹ ᤔᤧᤕᤠᤰᤏᤧᤴᤗᤥ॥)"]},{"type":"verse","number":17,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤀᤡᤱᤃᤠ᤹ ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤐᤡᤛᤧ ᤐᤠᤱᤄᤠᤱᤒᤠ ᤔᤧ᤺ᤴᤗᤥ ᤁᤖ ᤛᤢᤏᤠᤀᤡᤱ ᤀᤡᤱᤓᤥ᤺ᤛᤧᤏᤧ ᤐᤠᤱᤄᤠᤱᤒᤠᤖᤥ॥ ᤂᤧᤴᤏᤠᤱ ᤔᤧᤴᤇᤠᤶ ᤕᤠᤵᤔᤡ ᤛᤡᤰᤁᤢᤶ ᤏᤡᤱᤘᤠ᤹ᤀᤥᤒᤠ ᤐᤠ᤺ᤴᤛᤢᤳᤗᤠᤜᤠ᤹ᤀᤥᤃ ᤔᤧ᤺ᤴᤗᤥ. ᤔᤧ᤺ᤴᤏᤧ ᤑᤠ᤹ᤃᤪ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤁᤢᤛᤡᤗᤠᤶᤛᤠᤰᤔᤠ ᤛᤡᤱᤅᤡᤴ ᤔᤢᤰᤛᤠᤶ ᤔᤧ᤺ᤴᤏᤣᤒᤠ ᤐᤥ᤺ᤱᤗᤥ॥"]},{"type":"heading","content":["ᤂᤪᤡᤛ᤻ᤋᤧᤴ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤔᤢᤰᤛᤠᤶ ᤏᤢ ᤁᤢᤛᤡᤰᤁᤢᤶ ᤏᤡᤱᤘᤠ᤹"]},{"type":"verse","number":18,"content":["ᤛᤡᤗᤠᤶᤛᤠᤰᤔᤠ ᤛᤡᤱᤅᤡᤸᤗᤧᤴ ᤛᤢᤏᤠᤀᤡᤱᤅᤡᤱᤃ ᤁᤧᤔᤧᤰᤐᤠᤖ ᤁᤧᤒᤣ᤺ᤰᤐᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤗᤠᤃᤡ ᤀᤍᤱ ᤐᤠ᤺ᤴᤗᤥ. ᤁᤖ ᤀᤠᤏᤡ᤹ ᤛᤧᤴᤗᤵ ᤁᤧᤄᤥ᤺ᤒᤠᤖ ᤁᤧᤒᤵᤐᤠᤜᤠ᤹ᤖᤧ ᤗᤠᤃᤡᤃ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤔᤢᤰᤛᤠᤶᤗᤥ॥"]},{"type":"verse","number":19,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤛᤠᤶᤕᤥᤛᤠᤵᤗᤠᤀᤥ ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤛᤠᤵᤋᤧᤀᤠᤱ ᤐᤳ.",{"text":"“ᤀᤡᤱᤃᤠ᤹ ᤛᤡᤰᤁᤢᤶᤍᤠᤱᤒᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤛᤡᤰᤁᤢᤶ ᤏᤡᤱᤘᤠ᤹ᤀᤡᤴ ᤔᤧᤰᤂᤢᤱ. ᤜᤧᤰᤁᤩᤠᤱ ᤆᤠ᤺ᤵᤐᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤆᤠ᤺ᤵᤔᤠᤴ ᤁᤢᤛᤢᤶᤔᤧᤴᤍᤶᤔᤏᤠ ᤆᤥᤃᤢᤱᤗᤥ॥”","poem":1},{"noteId":4}]},{"type":"verse","number":20,"content":["ᤛᤡᤰᤁᤢᤶᤍᤠᤱᤒᤠᤜᤠ᤹. ᤛᤠᤶᤕᤥᤌᤡᤶᤛᤠᤶᤒᤠᤜᤠ᤹ ᤏᤢ ᤛᤠᤶᤈᤡᤰ ᤔᤢᤴᤎᤢᤶᤛᤠᤒᤠᤜᤠ᤹ ᤀᤠᤳᤋᤥ ᤔᤧᤘᤠ᤹ᤒᤣ᥅ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧᤃ ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥᤒᤠ ᤁᤧᤖᤧᤰ ᤛᤡᤰᤁᤢᤶ ᤏᤡᤱᤘᤠ᤹ᤜᤠ᤹ ᤀᤍᤱ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤆᤥᤃᤢᤀᤠᤱ ᤔᤧᤘᤠ᤹ᤏᤧᤴᤒᤡ᥅"]},{"type":"verse","number":21,"content":["ᤀᤠᤒᤠᤅᤣ ᤛᤡᤰᤁᤢᤶ ᤏᤡᤱᤘᤠ᤹ᤗᤠᤶᤒᤠ ᤔᤧᤴᤇᤠᤶ ᤕᤠᤵᤔᤡᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤧ᤹ ᤁᤢᤛᤡᤱ ᤔᤧᤴᤏᤡ᤺ᤳᤋᤢᤴ ᤑᤠ᤹ᤀᤠᤱ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤛᤡᤰᤁᤢᤶ ᤏᤡᤱᤘᤠ᤹ᤀᤥ ᤏᤡᤱᤛᤣ᤺ᤰ ᤆᤥᤃᤢᤒᤠᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤀᤡᤱᤓᤥ᤺ᤔᤏᤠᤒᤠ ᤀᤍᤱ ᤐᤠ᤺ᤴᤏᤥᤗᤠᤶᤒᤠᤀᤣ ᤏᤛᤠ᤺ᤴ ᤁᤧᤈᤥ᤺ᤰᤐᤠᤜᤠ᤹ ᤋᤠᤱᤛᤧ᤺ᤵᤔᤠᤛᤡ ᤏᤡᤱᤘᤠ᤹ ᤆᤥᤃᤢᤖᤥ॥"]},{"type":"verse","number":22,"content":["ᤕᤜᤢᤍᤡᤜᤠ᤹ᤖᤧ ᤏᤡᤱᤘᤠ᤹ ᤁᤧᤔᤠᤒᤠ ᤔᤡᤰᤛᤣ᤺ᤴ ᤀᤥᤔᤧᤵᤔᤠ ᤔᤧᤃᤥ᤺ᤳᤋᤢ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤃᤪᤡᤰᤜᤠ᤹ᤖᤧ ᤛᤡᤰᤁᤢᤶᤍᤡᤱ ᤏᤡᤱᤘᤠ᤹ ᤔᤧᤃᤥ᤺ᤳᤋᤢ᤹."]},{"type":"verse","number":23,"content":["ᤁᤖ ᤀᤠᤏᤡᤃᤧᤃ ᤛᤡᤗᤠᤶᤛᤠᤰᤔᤠ ᤛᤡᤱᤛᤶᤍᤠᤱ ᤔᤧᤓᤥ᤺ᤴᤍᤢᤒᤠ ᤂᤪᤡᤛ᤻ᤋᤧᤴᤏᤣ ᤀᤡᤱᤓᤥ᤺ᤛᤢᤶᤒᤧᤖᤥ॥ ᤂᤧᤱᤃ ᤕᤜᤢᤍᤡᤜᤠ᤹ᤖᤧ ᤗᤠᤃᤡ ᤀᤠᤄᤄᤒᤠ ᤐᤠ᤺ᤴ ᤏᤢ ᤌᤡᤶᤔᤧᤴᤍᤱ ᤛᤢᤘᤠᤱᤜᤠ᤹ᤖᤧ ᤗᤠᤃᤡ ᤀᤍᤱ ᤐᤠ᤺ᤴᤗᤥ."]},{"type":"verse","number":24,"content":["ᤁᤖ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤀᤢ᤺ᤳᤋᤢᤛᤡᤒᤠ ᤏᤧᤵᤔᤠᤱ ᤕᤜᤢᤍᤡ ᤏᤢ ᤃᤪᤡᤁ ᤛᤢᤘᤠᤱᤜᤠ᤹ᤖᤧ ᤗᤠᤃᤡ ᤂᤪᤡᤛ᤻ᤋᤧᤱᤃ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤔᤢᤰᤛᤠᤶ ᤏᤢ ᤁᤢᤛᤡᤰᤁᤢᤶ ᤏᤡᤱᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":25,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤀᤍᤱ ᤐᤠ᤺ᤴᤏᤡᤱᤃ ᤔᤧᤴᤇᤠᤶ ᤕᤠᤵᤔᤡ ᤛᤡᤰᤁᤢᤶ ᤏᤡᤱᤘᤠ᤹