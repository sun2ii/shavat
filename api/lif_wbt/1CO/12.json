{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"1CO","translationId":"lif_wbt","name":"᥇ ᤁᤥᤖᤴᤌᤡ","commonName":"᥇ ᤁᤥᤖᤴᤌᤡ","title":"ᤐᤠᤘᤗᤖᤧ ᤁᤥᤖᤴᤌᤡᤜᤠ᤹ ᤜᤠᤰᤋᤢᤛᤡᤒᤠ ᤌᤡᤰᤛᤡᤃᤣ᤺ᤰᤐᤠ ᤛᤰᤀᤡᤱᤄᤱ","order":46,"numberOfChapters":16,"sha256":"abc6013c2bfb8d6f21d0ef0a3a6b5248035c7d8a137a1978e9c40a1786288aa7","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/1CO/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/lif_wbt/1CO/16.json","totalNumberOfVerses":437},"chapter":{"number":12,"content":[{"type":"heading","content":["ᤛᤣᤛᤣᤔᤠᤱᤗᤠᤶ ᤕᤠᤶᤛᤠᤶᤃᤧᤴ ᤐᤷᤎᤠ᤺ᤶᤜᤠ᤹"]},{"type":"verse","number":1,"content":["ᤀᤠᤸᤗ ᤀᤠᤔᤡ᤺ᤶ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤛᤣ. ᤛᤣᤛᤣᤔᤠᤱᤗᤠᤶᤒᤠᤒᤠ ᤕᤠᤶᤛᤠᤶᤃᤧᤴ ᤐᤷᤎᤠ᤺ᤶᤜᤠ᤹ᤖᤧ ᤁᤢᤕᤠ᤺ᤶᤒᤣᤀᤥ ᤏᤡᤱᤘᤠ᤹ ᤔᤧᤱᤄᤥᤀᤣ ᤁᤧᤘᤕᤡᤒᤠ ᤀᤠᤏᤡᤱᤘᤠ᤹ ᤜᤥ᤺ᤵᤗᤥ॥"]},{"type":"verse","number":2,"content":["ᤍᤠᤱᤒᤠ ᤕᤧᤛᤢ᤺ᤴ ᤂᤡᤏᤡ᤹ ᤏᤛᤠ᤺ᤴ ᤔᤧᤴᤈᤥ᤺ᤰᤁᤣ ᤁᤧᤘᤕᤡᤸᤗᤧ ᤁᤢᤒᤠ᤺ᤴ ᤔᤧᤴᤗ᤺ᤶᤔᤏᤠ ᤕᤖᤡᤰ ᤐᤖᤡᤰᤐᤠ ᤏᤠᤘᤠᤀᤡᤳᤗᤠᤜᤠ᤹ ᤔᤠᤱᤃᤧᤄᤕᤢᤶᤗ ᤋᤠᤵᤁᤧᤒᤧ᤹ᤖᤡᤀᤠᤱ ᤁᤧᤘᤕᤡ᤹ᤖᤥ॥"]},{"type":"verse","number":3,"content":["ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤛᤣᤛᤣᤔᤠᤱᤅᤡᤸᤗᤧ ᤗᤠᤶᤗᤥᤛᤢᤒᤠ ᤀᤠᤳᤋᤡᤸᤗᤧᤀᤠᤱ ᤕᤧᤛᤢ᤺ᤴ ᤛᤠᤱᤃᤪᤠ ᤔᤧᤵᤔᤠ ᤔᤧᤛᤢᤰᤋᤢᤴᤗᤥ. ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤸᤗᤧ ᤗᤠᤶᤔᤧᤸᤗᤥ᤺ᤀᤣ ᤌᤠᤖᤡᤰ ᤀᤠᤳᤋᤡᤸᤗᤧᤀᤠᤱ ᤕᤧᤛᤢ᤺ᤴᤏᤣ ᤍᤠᤱᤒᤠᤖᤥ ᤐᤠ᤺ᤵᤔᤠ ᤔᤧᤛᤢᤰᤋᤢᤴ ᤑᤠ᤹ᤀᤠᤱ ᤁᤢᤛᤡᤱ ᤏᤡ᤺ᤳᤋᤧᤶᤔᤧ᤹ ᤁᤧᤗ᤹ᤒᤠ ᤀᤠᤏᤡᤱᤘᤠ᤹ ᤘᤠ᤹॥"]},{"type":"verse","number":4,"content":["ᤀᤠᤸᤗ ᤕᤖᤡᤰ ᤐᤖᤡᤰᤐᤠ ᤕᤠᤶᤛᤠᤶᤃᤧᤴ ᤐᤷᤎᤠ᤺ᤶᤜᤠ᤹ ᤔᤧᤘᤠ᤹. ᤁᤖ ᤐᤷᤎᤠ᤺ᤶ ᤁᤧᤒᤡᤒᤠ ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤴ ᤗᤳᤌᤡᤰᤗᤰ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":5,"content":["ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰᤁᤣ ᤕᤖᤡᤰ ᤐᤖᤡᤰᤐᤠ ᤔᤠᤱᤛᤣᤘᤠᤜᤠ᤹ ᤔᤧᤘᤠ᤹. ᤁᤖ ᤍᤠᤱᤒᤠᤃ ᤗᤳᤌᤡᤰᤗᤰ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":6,"content":["ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰᤁᤣ ᤕᤖᤡᤰ ᤐᤖᤡᤰᤐᤠ ᤕᤠ᤺ᤶᤒᤰ ᤆᤥ᤺ᤰᤔᤠ ᤀᤠᤛᤢᤰᤋᤢᤶ. ᤁᤖ ᤒᤠ ᤗᤳᤇᤠ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤀᤠᤏᤡ᤹ ᤁᤧᤖᤧᤰᤗᤠᤶ ᤕᤠ᤺ᤶᤒᤰ ᤆᤥᤃᤢ᤹ᤖᤥ॥"]},{"type":"verse","number":7,"content":["ᤀᤠᤸᤗ ᤛᤣᤛᤣᤜᤢᤵᤗᤰᤁᤥ ᤁᤢᤓᤠ᤹ ᤐᤡᤛᤡᤱᤔᤠᤖᤧ ᤗᤠᤃᤡ ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤕᤠ᤺ᤶᤒᤰᤁᤡᤴ ᤌᤠ᤺ᤵᤗ ᤑᤠ᤹ᤀᤠᤱ ᤕᤠᤶᤛᤠᤶᤃᤧᤴ ᤐᤷᤎᤠ᤺ᤶᤜᤠ᤹ ᤁᤠᤰ ᤔᤏᤠᤜᤠ᤹ ᤗᤳᤇᤠᤀᤠᤱ ᤔᤧᤴᤇᤧᤴᤇᤡᤱᤅᤣ ᤐᤡᤖᤧᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":8,"content":["ᤀᤠᤸᤗ ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤸᤗᤧ ᤌᤡᤰᤁᤡᤴ ᤛᤡᤰᤁᤢᤶᤗᤧᤴ ᤐᤠ᤺ᤴᤈᤠᤰ ᤐᤡᤖᤢ᤹. ᤘᤣ᤹ᤛ᤻ᤔᤠᤴ ᤜᤠᤒᤠ ᤂᤧᤴ ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤖᤧᤴ ᤐᤠ᤺ᤴᤈᤠᤰ ᤐᤡᤖᤢ᤹॥"]},{"type":"verse","number":9,"content":["ᤘᤣ᤹ᤛ᤻ᤔᤠᤴ ᤜᤠᤒᤠ ᤂᤧᤴ ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤸᤗᤧ ᤏᤛᤠ᤺ᤴᤗᤧᤴ ᤕᤠ᤺ᤶᤒᤰ ᤆᤥ᤺ᤰᤔᤠ. ᤜᤧᤰᤁᤩᤠᤱ ᤘᤣ᤹ᤀᤡᤴ ᤁᤧᤍᤢᤰᤐᤠ ᤘᤣ᤺ᤶᤔᤠ ᤐᤷᤎᤠ᤺ᤶᤜᤠ᤹ ᤒᤠ ᤂᤧᤴ ᤗᤳᤇᤠ ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤸᤗᤧ ᤐᤡᤖᤢ᤹॥"]},{"type":"verse","number":10,"content":["ᤘᤣ᤹ᤛ᤻ᤔᤠᤴ ᤏᤡᤱᤘᤠ᤹ ᤁᤧᤔᤠᤒᤠ ᤕᤠ᤺ᤶᤒᤰ ᤆᤥ᤺ᤰᤔᤠ ᤐᤷᤎᤠ᤺ᤶ ᤐᤡᤖᤢ᤹. ᤘᤣ᤹ᤛ᤻ᤔᤠᤴ ᤔᤠᤱᤏᤡᤱᤘᤠ᤹ᤐᤠ᤺ᤴ ᤐᤠ᤺ᤵᤔᤠ ᤐᤷᤎᤠ᤺ᤶ ᤐᤡᤖᤢ᤹. ᤘᤣ᤹ᤛ᤻ᤔᤠᤴ ᤏᤢ᤺ᤒᤠ ᤏᤢ ᤋᤠᤵᤑᤧ᤺ᤶᤒᤠ ᤕᤠᤶᤛᤠᤶᤜᤠ᤹ ᤛᤧᤶᤔᤠ ᤐᤷᤎᤠ᤺ᤶ ᤐᤡᤖᤢ᤹. ᤐᤖᤡᤰ ᤐᤖᤡᤰᤐᤠ ᤘᤣ᤹ ᤐᤠ᤺ᤴᤍᤠᤱᤜᤠ᤹ ᤐᤠ᤺ᤵᤔᤠ ᤐᤷᤎᤠ᤺ᤶ ᤐᤡᤖᤢ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤘᤣ᤹ᤛ᤻ᤔᤠᤴ ᤂᤧᤴ ᤐᤠ᤺ᤴᤍᤠᤱᤜᤠ᤹ ᤗᤧᤱᤔᤠ ᤐᤷᤎᤠ᤺ᤶ ᤐᤡᤖᤢ᤹ᤖᤥ॥"]},{"type":"verse","number":11,"content":["ᤁᤱᤜᤠ᤹ ᤁᤧᤖᤧᤰ ᤗᤳᤇᤠ ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤕᤠ᤺ᤶᤒᤰᤛᤡᤖᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ᤃ ᤁᤢᤏᤡᤱᤘᤠ᤹ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤁᤴ ᤕᤠᤶᤛᤠᤶᤃᤧᤴ ᤐᤷᤎᤠ᤺ᤶᤜᤠ᤹ ᤗᤳᤇᤠᤀᤠᤱ ᤔᤧᤴᤇᤧᤴᤇᤡᤱᤅᤣ ᤁᤧᤖᤧᤰ ᤐᤡᤖᤢᤛᤡ᤹ᤖᤥ॥"]},{"type":"heading","content":["ᤗᤳᤌᤡᤰ ᤌᤰᤁᤥ ᤕᤖᤡᤰ ᤕᤠᤶᤗᤰᤜᤠ᤹"]},{"type":"verse","number":12,"content":["ᤏᤠᤛᤡᤱᤃᤧᤴ ᤌᤰᤁᤥ ᤕᤖᤡᤰ ᤕᤠᤶᤗᤰᤜᤠ᤹ ᤔᤧᤒᤳᤗᤥ॥ ᤁᤴ ᤘᤣ᤹ ᤘᤣ᤹ ᤕᤠᤶᤗᤰᤜᤠ᤹ᤗᤠᤶ ᤗᤳᤇᤠ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤌᤰ ᤐᤥ᤺ᤱᤗᤥ॥ ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤁᤢᤎᤰᤁᤡᤴᤏᤠᤱ ᤒᤠ ᤜᤧᤰᤋᤱᤒᤠᤀᤣ ᤆᤥ᤺ᤰᤗᤥ॥"]},{"type":"verse","number":13,"content":["ᤒᤠ ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤀᤠᤏᤡ᤹ ᤕᤜᤢᤍᤡ. ᤌᤡᤶᤔᤧᤴᤍᤱ ᤛᤢᤘᤠᤱᤒᤠ. ᤕᤥ᤺ᤰ ᤀᤡᤃᤪ ᤆᤥ᤺ᤰᤕᤢᤶᤓᤥᤒᤠ ᤀᤠᤳᤋᤡᤴᤇᤠᤱ ᤌᤡᤰ ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤸᤗᤧ ᤌᤡᤰ ᤌᤰᤁᤥ ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤀᤠᤈᤥᤃᤧᤀᤠᤱ ᤘᤠ᤹॥ ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤏᤡ᤹ ᤁᤧᤖᤧᤰᤗᤧ ᤗᤳᤇᤠ ᤛᤣᤛᤣᤔᤠᤱ ᤀᤠᤄᤥ᤺ᤛᤢᤶᤔᤠᤱ ᤀᤠᤘᤠ᤹ᤖᤥ॥",{"noteId":23}]},{"type":"verse","number":14,"content":["ᤀᤠᤸᤗ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤌᤰᤁᤡᤱᤃ ᤗᤳᤌᤡᤰ ᤕᤠᤶᤗᤰᤗᤧᤖᤰ ᤔᤧ᤺ᤴ. ᤁᤖ ᤕᤖᤡᤰ ᤕᤠᤶᤗᤰᤜᤠ᤹ᤖᤧ ᤆᤥᤃᤧᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":15,"content":["ᤀᤠᤸᤗ ᤗᤠᤱᤅᤡᤸᤗᤧ “ᤀᤡᤱᤃᤠ᤹ ᤜᤢᤰ ᤔᤧ᤺ᤴᤀᤠ. ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤁᤴ ᤌᤰᤁᤥᤒᤠ ᤕᤠᤶᤗᤰ ᤔᤧ᤺ᤴᤏᤠᤖᤥ” ᤐᤠ᤺ᤳᤋᤢ᤹ᤛᤠᤱ ᤂᤧᤴ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤌᤰᤁᤥᤒᤠ ᤕᤠᤶᤗᤰ ᤔᤧᤒᤥ᤺ᤱᤏᤧᤴᤒᤡ᥅"]},{"type":"verse","number":16,"content":["ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰᤁᤣ ᤏᤧᤰᤂᤥ᤹ᤀᤡᤸᤗᤧ “ᤀᤡᤱᤃᤠ᤹ ᤔᤡᤰ ᤔᤧ᤺ᤴᤀᤠ. ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤁᤴ ᤌᤰᤁᤥᤒᤠ ᤕᤠᤶᤗᤰ ᤔᤧ᤺ᤴᤏᤠᤖᤥ” ᤐᤠ᤺ᤳᤋᤢ᤹ᤛᤠᤱ ᤂᤧᤴ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤌᤰᤁᤥᤒ