{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"1CO","translationId":"lif_wbt","name":"᥇ ᤁᤥᤖᤴᤌᤡ","commonName":"᥇ ᤁᤥᤖᤴᤌᤡ","title":"ᤐᤠᤘᤗᤖᤧ ᤁᤥᤖᤴᤌᤡᤜᤠ᤹ ᤜᤠᤰᤋᤢᤛᤡᤒᤠ ᤌᤡᤰᤛᤡᤃᤣ᤺ᤰᤐᤠ ᤛᤰᤀᤡᤱᤄᤱ","order":46,"numberOfChapters":16,"sha256":"abc6013c2bfb8d6f21d0ef0a3a6b5248035c7d8a137a1978e9c40a1786288aa7","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/1CO/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/lif_wbt/1CO/16.json","totalNumberOfVerses":437},"chapter":{"number":13,"content":[{"type":"heading","content":["ᤁᤧᤖᤧᤰᤏᤢ᤺ᤸᤗᤧ ᤕᤶᤒᤠ ᤐᤷᤎᤠ᤺ᤶ"]},{"type":"verse","number":1,"content":["ᤀᤡᤱᤃᤠ᤹ ᤔᤧᤴᤇᤠᤶ ᤕᤠᤵᤔᤡᤜᤠ᤹ ᤏᤢ ᤔᤠᤱᤗᤠᤀᤡᤱᤒᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤐᤠ᤺ᤴᤍᤠᤱᤜᤠ᤹ᤀᤥ ᤐᤠ᤺ᤳᤋᤠᤛᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤘᤣ᤹ᤜᤠ᤹ ᤗᤢᤱᤔᤠ᤹ ᤔᤧᤍᤢᤰᤋᤢᤱᤛᤡᤱᤅᤡᤴᤏᤧ ᤑᤠ᤹ᤃᤪ ᤀᤡᤱᤃᤠ᤹ᤃ ᤜᤕᤱᤁᤡᤸᤗᤡᤱ ᤁᤧᤈᤥ᤺ᤰᤐᤠ ᤕᤶᤒᤠ ᤁᤡᤱᤏᤠ ᤏᤢ ᤏᤡᤱᤎᤧᤴᤎᤧᤴ ᤁᤧᤔᤧᤵᤐᤠ ᤔᤢᤰᤗᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰᤗᤰ ᤐᤥ᤺ᤱᤅᤠᤖᤥ॥"]},{"type":"verse","number":2,"content":["ᤀᤡᤱᤃᤠ᤹ ᤔᤠᤱᤏᤡᤱᤘᤠ᤹ᤐᤠ᤺ᤴ ᤐᤠ᤺ᤵᤔᤠ ᤐᤷᤎᤠ᤺ᤶ ᤁᤳᤋᤢᤱᤛᤠᤱ. ᤁᤧᤖᤧᤰ ᤛᤡᤃᤠᤱ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤏᤢ ᤁᤧᤖᤧᤰ ᤏᤧᤜᤡᤏᤡᤱᤘᤠ᤹ ᤁᤢᤛᤡᤱ ᤏᤡ᤺ᤵᤔᤠ ᤛᤢᤰᤋᤢᤱᤛᤠᤱ. ᤜᤧᤰᤁᤩᤠᤱ ᤁᤥ᤺ᤰᤔᤠ ᤑᤠᤱᤈᤱᤜᤠ᤹ ᤆᤵᤔᤠ ᤏᤛᤠ᤺ᤴ ᤁᤳᤋᤢᤱᤛᤠᤱ. ᤀᤡᤱᤃᤠ᤹ ᤘᤣ᤹ᤜᤠ᤹ ᤗᤢᤱᤔᤠ᤹ ᤔᤧᤍᤢᤰᤋᤢᤱᤛᤡᤱᤅᤡᤴᤏᤧ ᤑᤠ᤹ᤃᤪ ᤀᤡᤱᤃᤠ᤹ᤃ ᤌᤣᤀᤠᤱ ᤔᤧ᤺ᤴᤏᤠᤖᤥ॥"]},{"type":"verse","number":3,"content":["ᤀᤡᤱᤃᤠ᤹ ᤁᤧᤖᤧᤰ ᤀᤠᤕᤠᤱᤛᤠᤁᤢᤴᤎᤣ᤺ᤴ ᤕᤠᤱᤃᤧᤛᤠ᤹ᤒᤠᤜᤠ᤹ ᤜᤠ᤺ᤳᤋᤢᤱᤛᤡᤱᤛᤠᤱ. ᤏᤠᤛᤡᤱᤃᤧᤴ ᤀᤠᤎᤰᤁᤡᤴ ᤔᤡᤜᤠᤰᤁᤥ ᤕᤠᤰᤋᤢᤱᤛᤠᤱ. ᤀᤡᤱᤃᤠ᤹ ᤘᤣ᤹ᤜᤠ᤹ ᤗᤢᤱᤔᤠ᤹ ᤔᤧᤍᤢᤰᤋᤢᤱᤛᤡᤱᤅᤡᤴᤏᤧ ᤑᤠ᤹ᤃᤪ ᤌᤣᤀᤠᤱ ᤀᤡᤴᤎᤠ᤺ᤱ ᤔᤧᤄᤥ᤺ᤛᤢᤱᤅᤡᤴᤗᤥ॥"]},{"type":"verse","number":4,"content":["ᤔᤡ᤺ᤶᤈᤡ᤺ᤸᤗᤧ ᤏᤠᤛᤡ ᤌ᤺ᤳᤋᤢ᤹ ᤜᤧᤰᤁᤩᤠᤱ ᤗᤢᤱᤔᤠ᤹ ᤋᤢᤰᤋᤢᤛᤡ᤹॥ ᤔᤡ᤺ᤶᤈᤡ᤺ᤸᤗᤧ ᤁᤢᤏᤠ ᤔᤧᤜᤧᤴᤏᤧᤴᤗᤥ. ᤀᤡᤱᤃᤠ᤹ᤀᤣ᤺ᤰ ᤏᤢ ᤀᤠᤱᤍᤡᤱᤅᤠᤱ ᤔᤧᤗ᤹ᤏᤧᤴᤗᤥ॥"]},{"type":"verse","number":5,"content":["ᤔᤡ᤺ᤶᤈᤡ᤺ᤱᤃ ᤔᤧᤜᤧᤴᤇᤡᤱᤅᤡᤴ. ᤀᤠᤒᤠᤅᤣ ᤀᤡᤴᤎᤠ᤺ᤱ ᤏᤢ ᤀᤠᤒᤠᤅᤣ ᤐᤠ᤺ᤴᤗᤰ ᤔᤧᤃᤥ᤺ᤳᤋᤢᤴ॥ ᤔᤡ᤺ᤶᤈᤡ᤺ᤱᤃ ᤜᤠᤖᤠ ᤁᤢᤛᤡᤰ ᤔᤧᤒᤥ᤺ᤰᤏᤧᤴ. ᤑᤧᤴ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤏᤡᤱᤘᤠ᤹ᤒᤥ ᤔᤧᤕᤢᤰᤂᤢᤴ॥"]},{"type":"verse","number":6,"content":["ᤔᤡ᤺ᤶᤈᤡ᤺ᤱᤃ ᤑᤧᤴ ᤐᤠ᤺ᤴᤜᤠ᤹ᤀᤥ ᤔᤧᤛ᤺ᤳᤏᤧᤴ ᤁᤖ ᤛᤧᤰᤂᤠᤀᤥᤖᤰ ᤛ᤺ᤳᤗᤥ॥"]},{"type":"verse","number":7,"content":["ᤔᤡ᤺ᤶᤈᤡ᤺ᤸᤗᤧ ᤁᤧᤖᤧᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ᤀᤥ ᤁᤢᤓᤠ᤹ ᤐᤡᤖᤢ᤹. ᤁᤧᤖᤧᤰ ᤐᤠ᤺ᤴᤏᤡᤴ ᤏᤛᤠ᤺ᤴ ᤆᤥᤃᤢ᤹. ᤁᤧᤖᤧᤰ ᤐᤠ᤺ᤴᤏᤡᤴ ᤏᤡᤱᤛᤠᤱ ᤆᤥᤃᤢ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤁᤧᤖᤧᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤏᤠᤛᤡ ᤌ᤺ᤳᤋᤢ᤹ᤖᤥ॥"]},{"type":"verse","number":8,"content":["ᤔᤡ᤺ᤶᤈᤡᤴ ᤀᤠᤵᤑᤠᤸᤗᤧᤀᤠᤱ ᤔᤧᤏᤢᤵᤏᤧᤴ॥ ᤁᤖ ᤔᤠᤱᤏᤡᤱᤘᤠ᤹ᤐᤠ᤺ᤴᤜᤠ᤹ ᤏᤢ ᤘᤣ᤹ ᤐᤠ᤺ᤴᤍᤠᤱᤜᤠ᤹ ᤏᤢᤵ. ᤜᤧᤰᤁᤩᤠᤱ ᤏᤧᤜᤡᤏᤡᤱᤘᤠ᤹ᤀᤡᤴ ᤔᤠᤒᤣ᤺ᤰᤗᤥ॥"]},{"type":"verse","number":9,"content":["ᤀᤠᤏᤡ᤹ ᤔᤡᤛᤠᤰᤗᤰ ᤁᤢᤛᤡᤱ ᤀᤠᤏᤡ᤺ᤳᤋᤢᤶᤗᤥ. ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤏᤡ᤹ ᤔᤠᤱᤏᤡᤱᤘᤠ᤹ᤐᤠ᤺ᤴ ᤔᤡᤛᤠᤰᤗᤰ ᤀᤠᤒᤠ᤺ᤳᤋᤢᤶᤗᤥ॥"]},{"type":"verse","number":10,"content":["ᤁᤖ ᤁᤢᤗᤡᤱᤎᤥ ᤁᤧᤃᤧᤵᤐᤧᤴ ᤋᤠ᤺ᤸᤗᤧ ᤁᤢᤗᤡᤱᤎᤥ ᤔᤧᤱᤃᤧᤵᤔᤏᤠᤒᤠᤴ ᤔᤠᤒᤣ᤺ᤰᤗᤥ॥"]},{"type":"verse","number":11,"content":["ᤀᤡᤱᤃᤠ᤹ ᤜᤡᤴᤈᤠ᤹ ᤘᤕᤠᤱᤅᤡᤸᤗᤧ ᤜᤡᤴᤈᤠ᤹ ᤁᤢᤀᤡᤛᤡ᤺ᤰᤁᤣ ᤐᤠᤖᤠᤱ. ᤜᤡᤴᤈᤠ᤹ ᤁᤢᤀᤡᤛᤡ᤺ᤰᤁᤣ ᤁᤢᤛᤡᤱ ᤏᤡ᤺ᤳᤋᤢᤱ. ᤜᤡᤴᤈᤠ᤹ ᤁᤢᤀᤡᤛᤡ᤺ᤰᤁᤣ ᤀᤡ᤺ᤳᤋᤢᤱ. ᤁᤖ ᤀᤡᤱᤃᤠ᤹ ᤌᤠᤱᤒᤧᤴ ᤁᤧᤖᤠᤱᤅᤡᤸᤗᤧ ᤜᤡᤴᤈᤠ᤹ᤒᤠ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤗᤧᤖᤢᤱᤍᤣ᤺ᤛᤢᤱᤗᤥ॥"]},{"type":"verse","number":12,"content":["ᤀᤠᤸᤗᤥ ᤀᤠᤏᤡ᤹ᤃ ᤏᤢ᤺ᤖᤡᤰ ᤔᤧᤴᤎᤠ᤺ᤵᤔᤏᤠᤒᤠ ᤛᤧᤸᤗᤧᤱᤄᤥ ᤀᤠᤏᤡ᤺ᤛᤢᤶᤒᤠ ᤜᤧᤰᤁᤣᤖᤰ ᤀᤠᤏᤡ᤺ᤛᤢᤶᤗᤥ. ᤁᤖ ᤂᤧᤴ ᤕᤧᤶᤔᤥ ᤆᤡᤍᤢᤵ ᤀᤠᤏᤡ᤺ᤛᤢᤶᤗᤥ॥ ᤀᤠᤸᤗᤥ ᤀᤡᤱᤃᤠ᤹ ᤔᤡᤛᤠᤰᤗᤰ ᤁᤢᤛᤡᤱ ᤏᤡ᤺ᤳᤋᤢᤱ. ᤁᤖ ᤂᤧᤴ ᤕᤧᤶᤔᤥ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ ᤁᤢᤛᤡᤱ ᤏᤡ᤺ᤳᤋᤠᤒᤠ ᤜᤧᤰᤁᤣᤀᤣ ᤀᤡᤱᤃᤠ᤹ᤀᤠᤱ ᤁᤠᤰ ᤐᤠ᤺ᤴᤏᤡᤴ ᤛᤖᤰ ᤁᤢᤛᤡᤱ ᤏᤡ᤺ᤳᤋᤢᤱᤗᤥ॥"]},{"type":"verse","number":13,"content":["ᤀᤠᤸᤗ ᤏᤛᤠ᤺ᤴ. ᤏᤡᤱᤛᤠᤱ ᤜᤧᤰᤁᤩᤠᤱ ᤔᤡ᤺ᤶᤈᤡ ᤁᤴ ᤛᤢᤶᤛᤡ ᤐᤠ᤺ᤴᤜᤠ᤹ᤖᤰ ᤘᤠ᤹ ᤕᤠ᤺ᤰᤗᤥ॥ ᤁᤖ ᤂᤧᤱᤜᤠ᤹ᤀᤥᤃ ᤔᤡ᤺ᤶᤈᤡᤴ ᤁᤠᤰᤏᤢ᤺ᤸᤗᤧ ᤕᤶᤒᤠᤖᤥ॥"]}],"footnotes":[]},"thisChapterLink":"/api/lif_wbt/1CO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lif_wbt/1CO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lif_wbt/1CO/12.json","previousChapterAudioLinks":{},"numberOfVerses":13}