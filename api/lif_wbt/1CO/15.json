 ᤏᤠᤶ. ᤂᤣ᤺ᤶᤛᤡᤰᤜᤠ᤹ ᤔᤧᤒᤳ. ᤜᤧᤰᤁᤩᤠᤱ ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥᤀᤠᤱ ᤌᤰᤜᤠ᤹ ᤔᤧᤘᤠ᤹ᤖᤥ. ᤁᤖ ᤋᤠᤱᤛᤠᤰᤐᤥᤒᤠ ᤗᤠᤒᤠ. ᤏᤠᤶ. ᤂᤣ᤺ᤶᤛᤡᤰᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤀᤥ᤺ᤵᤔᤠᤴ ᤏᤢ ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥᤒᤠ ᤌᤰᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤂᤧᤶᤛᤡᤱᤔᤠᤴ ᤘᤣ᤹ ᤘᤣ᤹ ᤆᤥ᤺ᤰᤗᤥ॥"]},{"type":"verse","number":41,"content":["ᤏᤠᤶᤔᤡᤸᤗᤧ ᤁᤢᤀᤥ᤺ᤵᤔᤠᤴ ᤌᤡᤰ ᤐᤖᤡᤰᤗᤧᤴ. ᤗᤠᤒᤠᤸᤗᤧᤴ ᤘᤣ᤹ ᤐᤖᤡᤰᤗᤧᤴ ᤆᤥ᤺ᤰ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤣ᤺ᤶᤛᤡᤰᤐᤠᤸᤗᤧ ᤁᤢᤀᤥ᤺ᤵᤔᤠᤴ ᤘᤣ᤹ ᤐᤖᤡᤰᤗᤧᤴ ᤆᤥ᤺ᤰ॥ ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰᤁᤣ ᤌᤡᤰ ᤂᤣ᤺ᤶᤛᤡᤰᤐᤠᤸᤗᤧ ᤁᤢᤀᤥ᤺ᤵᤔᤠᤴ ᤏᤢ ᤘᤣ᤹ᤛ᤻ᤔᤠ ᤂᤣ᤺ᤶᤛᤡᤰᤐᤠᤸᤗᤧ ᤁᤢᤀᤥ᤺ᤵᤔᤠᤴ ᤘᤣ᤹ ᤘᤣ᤹ ᤆᤥ᤺ᤰᤗᤥ॥"]},{"type":"verse","number":42,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤛᤡ᤺ᤔᤧᤴᤗᤠᤶ ᤕᤠᤶᤔᤥ ᤜᤡᤱᤔᤠᤴᤏᤠᤱ ᤒᤠ ᤜᤧᤰᤋᤱᤒᤠᤀᤣ ᤆᤥ᤺ᤰᤗᤥ॥ ᤁᤴ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤌᤰᤁᤡᤴ ᤛᤡ᤹᤺ ᤜᤧᤰᤁᤩᤠᤱ ᤗᤢᤵᤔᤠᤀᤠᤱ ᤁᤡ᤹᤺. ᤁᤖ ᤛᤡ᤺ᤔᤧᤴᤗᤠᤶ ᤕᤠᤶᤔᤥ ᤁᤧᤜᤡᤱᤒᤠ ᤌᤰᤁᤡᤴ ᤀᤠᤈᤢᤏᤡ ᤐᤥ᤺ᤱᤗᤥ॥"]},{"type":"verse","number":43,"content":["ᤀᤠᤏᤡ᤹ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤌᤰᤁᤡᤴ ᤗᤢᤵᤐᤡᤸᤗᤧ ᤋᤠᤵᤑᤧ᤺ᤶᤒᤠ ᤏᤢ ᤌᤢᤶ ᤔᤧ᤺ᤴᤏᤣᤒᤠ ᤆᤥ᤺ᤰ. ᤁᤖ ᤕᤠᤶᤔᤥ ᤁᤢᤜᤡᤱᤘᤧᤳ ᤐᤥ᤺ᤱᤅᤡᤸᤗᤧ ᤏᤢ᤺ᤒᤠ ᤏᤢ ᤁᤧᤎᤢᤶᤒᤠ ᤐᤥ᤺ᤱᤗᤥ॥"]},{"type":"verse","number":44,"content":["ᤏᤠᤛᤡᤱᤃᤧᤴ ᤌᤰᤁᤡᤴ ᤗᤢᤵ. ᤜᤧᤰᤁᤩᤠᤱ ᤕᤠᤶᤛᤠᤶᤃᤧᤴ ᤌᤰᤁᤡᤴ ᤜᤡᤱᤗᤥ॥ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤌᤰ ᤘᤠ᤹ᤒᤠ ᤜᤧᤰᤁᤣᤀᤣ ᤕᤠᤶᤛᤠᤶᤃᤧᤴ ᤌᤰᤁᤡᤴᤏᤠᤱ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":45,"content":["ᤛᤠᤶᤕᤥᤛᤠᤵᤗᤠᤀᤥ ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤛᤠᤵᤋᤧᤀᤠᤱ ᤐᤳ. “ᤌᤡᤰᤛᤡᤃᤣ᤺ᤰᤛ᤻ᤔᤠ ᤔᤏᤠ ᤀᤠᤍᤶᤔᤡᤱᤃ ᤁᤢᤜᤡᤱᤘᤧᤳ ᤔᤏᤠ ᤐᤥ᤺ᤰᤂᤧ.”",{"noteId":28},"ᤕᤠᤱᤛᤡᤒᤠ ᤀᤠᤍᤶᤔᤡᤱᤃ (ᤂᤪᤡᤛ᤻ᤋ) ᤏᤧᤳᤋᤡᤃᤧᤴ ᤜᤡᤱᤔᤴ ᤁᤧᤒᤡᤒᤠ ᤕᤠᤶᤛᤠᤶ ᤐᤥ᤺ᤰᤂᤧᤖᤥ॥"]},{"type":"verse","number":46,"content":["ᤁᤧᤖᤧᤰᤏᤢ᤺ᤸᤗᤧ ᤋᤃᤡ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤌᤰᤁᤡᤴ ᤋᤠ᤺. ᤜᤧᤰᤁᤩᤠᤱᤗᤰ ᤕᤠᤶᤛᤠᤶᤃᤧᤴ ᤌᤰᤁᤡᤴ ᤋᤠ᤺ᤖᤥ॥"]},{"type":"verse","number":47,"content":["ᤌᤡᤰᤛᤡᤃᤣ᤺ᤰᤐᤠ ᤔᤏᤠ᤺ᤱᤃ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥᤒᤠ ᤂᤠᤶᤗᤠᤶᤒᤠ ᤆᤥᤃᤧᤀᤠᤱ ᤘᤕᤧ. ᤁᤖ ᤏᤡᤛᤡᤃᤣ᤺ᤰᤛ᤻ᤔᤠ ᤔᤏᤠ᤺ᤱᤃ ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱᤗᤠᤶᤒᤠᤒᤠᤖᤥ॥"]},{"type":"verse","number":48,"content":["ᤀᤡᤰᤛᤠᤒᤠ ᤔᤏᤠᤜᤠ᤹ ᤂᤠᤶᤔᤡᤸᤗᤧ ᤁᤧᤒᤥ᤺ᤱᤒᤠ ᤔᤏᤠ᤺ᤴ ᤜᤧᤰᤋᤱᤒᤠᤛᤡᤖᤥ. ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰᤁᤣ ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱᤒᤠ ᤔᤏᤠᤜᤠ᤹ ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱᤗᤠᤶ ᤁᤧᤕᤢ᤺ᤒᤠ ᤔᤏᤠ᤺ᤴ ᤜᤧᤰᤋᤱᤒᤠᤛᤡᤖᤥ॥"]},{"type":"verse","number":49,"content":["ᤀᤠᤸᤗᤥ ᤀᤠᤏᤡ᤹ ᤂᤠᤶᤔᤡᤸᤗᤧ ᤁᤧᤒᤥ᤺ᤱᤒᤠ ᤔᤏᤠ᤺ᤴ ᤜᤧᤰᤋᤱᤒᤠ ᤀᤠᤈᤥ᤺ᤰ. ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰᤁᤣ ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱᤗᤠᤶ ᤁᤧᤕᤢ᤺ᤒᤠ ᤔᤏᤠ᤺ᤴ ᤜᤧᤰᤋᤱᤒᤠ ᤀᤠᤒᤥ᤺ᤱᤗᤥ॥"]},{"type":"verse","number":50,"content":["ᤀᤠᤸᤗ ᤀᤠᤔᤡ᤺ᤶ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤛᤣ. ᤀᤡᤱᤃᤠ᤹ ᤐᤠ᤺ᤵᤔᤠ ᤁᤥ᤺ᤳᤋᤢᤱᤒᤠᤴ ᤁᤴᤗᤥ. ᤏᤧᤰᤛᤠ ᤏᤢ ᤔᤠᤰᤂᤡ᤹ᤀᤡᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤜᤠᤱᤈᤢᤶᤔᤡᤸᤗᤧᤴ ᤗᤰ ᤂᤥ᤺ᤔᤠ ᤔᤧᤛᤢᤰᤋᤢᤴᤗᤥ. ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰᤁᤣ ᤁᤧᤔᤧᤰᤐᤠ ᤁᤧᤒᤣ᤺ᤰᤐᤠᤸᤗᤧ ᤀᤠᤵᤑᤠᤸᤗᤧᤀᤠᤱ ᤔᤧᤶᤔᤧᤰᤔᤏᤠᤒᤠᤸᤗᤧᤴ ᤗᤰ ᤂᤥ᤺ᤔᤠ ᤔᤧᤛᤢᤰᤋᤢᤴᤗᤥ॥"]},{"type":"verse","number":51,"content":["ᤂᤧᤵᤛᤧᤶᤔᤧ᤹ᤀᤥ᥄ ᤀᤡᤱᤃᤠ᤹ ᤗᤳᤇᤠ ᤛᤡᤒᤡ᤹ᤒᤠ ᤐᤠ᤺ᤴᤎᤡᤰ ᤔᤧᤳᤏᤡᤱ–ᤀᤠᤏᤡ᤹ ᤁᤧᤖᤧᤰ ᤀᤠᤴᤇᤡ᤺ᤏᤧᤴᤗᤥ. ᤁᤖ ᤀᤠᤏᤡ᤹ ᤁᤧᤖᤧᤰ ᤀᤠᤗᤧᤱᤛᤡᤱ ᤀᤠᤒᤣ᤺ᤰᤗᤥ॥"]},{"type":"verse","number":52,"content":["ᤛᤵᤑᤠᤖᤧᤛᤠ. ᤔᤡᤰᤆᤡᤖᤠᤵᤐᤥᤛᤠ. ᤌᤢᤳᤌᤢᤖᤡ᤺ᤵᤐᤠᤸᤗᤧ ᤁᤢᤏᤢᤵᤐᤥᤒᤠ ᤀᤡᤰᤗᤠᤀᤥ ᤀᤠᤗᤧᤰᤛᤡᤱᤗᤥ॥ ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤧᤴ ᤕᤧᤶᤔᤥ ᤌᤢᤳᤌᤢᤖᤡ᤺ᤵᤐᤧᤴ ᤔᤢᤰ ᤜᤧᤰᤁᤩᤠᤱ ᤁᤧᤛᤡ᤺ᤒᤠ ᤁᤧᤒᤣ᤺ᤰᤐᤠᤜᤠ᤹ ᤔᤧᤶᤔᤧᤰᤔᤏᤠᤒᤠ ᤔᤧᤒᤥ᤺ᤱᤅᤠᤱ ᤔᤧᤜᤡᤱᤗᤥ. ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤏᤡ᤹ ᤁᤧᤖᤧᤰ ᤀᤠᤗᤧᤱᤛᤡᤱ ᤀᤠᤒᤣ᤺ᤰᤗᤥ॥"]},{"type":"verse","number":53,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤁᤴ ᤁᤧᤛᤡ᤺ᤒᤠ ᤁᤧᤒᤣ᤺ᤰᤐᤠ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤌᤰᤁᤡᤴ ᤀᤠᤵᤑᤠᤸᤗᤧᤀᤠᤱ ᤔᤧᤴᤏᤢᤵᤔᤏᤠᤒᤠ ᤀᤠᤈᤢᤏᤡ ᤌᤰᤁᤥ ᤗᤧᤱᤛᤡᤱᤔᤠ ᤐᤥ᤺ᤱᤗᤥ॥"]},{"type":"verse","number":54,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤁᤴ ᤁᤧᤛᤡ᤺ᤒᤠ ᤁᤧᤒᤣ᤺ᤰᤐᤠ ᤌᤰᤁᤡᤴ ᤔᤧᤴᤇᤡ᤺ᤔᤏᤠᤒᤠ ᤀᤠᤈᤢᤏᤡ ᤌᤰᤁᤥ ᤗᤧᤱᤛᤡᤱᤅᤡᤸᤗᤧ ᤁᤴ ᤛᤠᤵᤋᤧᤀᤠᤱ ᤁᤧᤒᤵᤐᤠ ᤐᤠ᤺ᤴᤈᤠᤰᤁᤡᤴ ᤁᤧᤳᤗᤥ.",{"text":"“ᤛᤡ᤺ᤔᤧᤴ ᤌᤱᤅᤥ ᤜᤠᤖᤡ ᤋᤩᤧᤀᤠᤱ ᤘᤠ᤹ᤖᤥ”","poem":1},{"noteId":29}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"“ᤛᤡ᤺ᤔᤧᤴᤏᤣ. ᤂᤧᤏᤧ᤹ ᤁᤧᤎᤱᤏᤠ᤺ᤴᤏᤡᤴ ᤀᤠᤳᤋᤥ ᤘᤠ᤹ᤒᤣ᥅","poem":1},{"lineBreak":true},{"text":"ᤛᤡ᤺ᤔᤧᤴᤏᤣ. ᤂᤧᤏᤧ᤹ ᤁᤧᤔᤢᤰᤛᤠᤶᤔᤡᤴ ᤀᤠᤳᤋᤥ ᤘᤠ᤹ᤒᤣ᥅”","poem":1},{"noteId":30}]},{"type":"verse","number":56,"content":["ᤛᤡ᤺ᤔᤧᤸᤗᤧ ᤁᤢᤔᤢᤰᤛᤠᤶᤔᤡᤴ ᤗᤠᤕᤥᤗᤠᤶ ᤂᤥ᤺ᤛᤢ᤹ᤖᤥ. ᤜᤧᤰᤁᤩᤠᤱ ᤗᤠᤕᤥ᤺ᤸᤗᤧ ᤁᤢᤔᤢᤰᤛᤠᤶᤔᤡᤱᤃ ᤛᤠᤶᤕᤥ ᤀᤡᤱᤈᤠ᤺ᤱᤗᤠᤶ ᤂᤥ᤺ᤛᤢ᤹ᤖᤥ॥"]},{"type":"verse","number":57,"content":["ᤁᤖ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤏᤥᤃᤧᤴᤗᤥ᥄ ᤂᤢᤏᤧ᤹ᤀᤣ ᤀᤠᤏᤡ᤹ ᤍᤠᤱᤒᤠ ᤕᤧᤛᤢ ᤂᤪᤡᤛ᤻ᤋᤗᤠᤶᤒᤠ ᤌᤱᤏᤠ᤺ᤴᤏᤡᤴ ᤀᤠᤒᤡ᤹ᤖᤥ॥"]},{"type":"verse","number":58,"content":["ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤀᤠᤔᤡ᤺ᤶ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤛᤣ. ᤂᤡᤏᤡ᤹ ᤁᤧᤎᤢᤶᤒᤠ ᤐᤥ᤺ᤰᤂᤧᤶᤔᤧ᤹ᤀᤠᤱ ᤔᤧᤶᤔᤢᤴᤏᤣ ᤘᤕᤧᤶᤔᤧ᤹ᤀᤥ॥ ᤍᤠᤱᤒᤠᤸᤗᤧ ᤁᤢᤕᤠ᤺ᤶᤒᤰᤁᤥ ᤛᤍᤠᤍᤡᤱ ᤐᤥ᤺ᤖᤧᤶᤔᤧ᤹ᤖ ᤐᤣᤃᤧᤶᤔᤧ᤹ᤀᤥ॥ ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤍᤠᤱᤒᤠᤸᤗᤧ ᤗᤠᤃᤡ ᤂᤡᤏᤡ᤹ ᤕᤠᤶᤒᤢᤎᤡᤰᤁᤡᤴ ᤆᤠᤔᤧᤛᤥ᤺ᤰᤏᤧᤴ ᤑᤠ᤹ᤀᤠᤱ ᤁᤧᤏᤡ᤺ᤛᤢᤶᤔᤠᤱ ᤁᤧᤘᤕᤡ᤹ᤖᤥ॥"]}],"footnotes":[{"noteId":25,"caller":"*","text":"ᤀᤠᤍᤔ ᤑᤠ᤹ᤀᤡᤴ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤆᤥᤃᤢᤒᤠ ᤌᤡᤰᤛᤡᤃᤣ᤺ᤰᤐᤠ ᤔᤏᤠᤖᤥ॥","reference":{"chapter":15,"verse":22}},{"noteId":26,"caller":"*","text":"ᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤗᤥ ᤛᤢᤶ ᥎.᥌","reference":{"chapter":15,"verse":27}},{"noteId":27,"caller":"*","text":"ᤕᤛᤤᤕᤠ ᥈᥈.᥇᥉","reference":{"chapter":15,"verse":32}},{"noteId":28,"caller":"*","text":"ᤋᤥᤗᤡᤱᤛᤥᤔᤢ ᥈.᥍","reference":{"chapter":15,"verse":45}},{"noteId":29,"caller":"*","text":"ᤕᤛᤤᤕᤠ ᥈᥋.᥎","reference":{"chapter":15,"verse":54}},{"noteId":30,"caller":