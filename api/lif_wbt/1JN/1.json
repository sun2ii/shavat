{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"1JN","translationId":"lif_wbt","name":"᥇ ᤕᤢᤜᤢᤴᤏᤠ","commonName":"᥇ ᤕᤢᤜᤢᤴᤏᤠ","title":"ᤕᤢᤜᤢᤴᤏᤠᤖᤧ ᤛᤠᤵᤋᤢᤒᤠ ᤌᤡᤰᤛᤡᤃᤣ᤺ᤰᤐᤠ ᤛᤰᤀᤡᤱᤄᤱ","order":62,"numberOfChapters":5,"sha256":"ac7deeef825e3d5a2f615888beb013f4d9d5d38ce2b2f76c8bac152e8662ce9a","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/1JN/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/lif_wbt/1JN/5.json","totalNumberOfVerses":104},"chapter":{"number":1,"content":[{"type":"heading","content":["ᤜᤡᤱᤔᤴᤗᤧ ᤐᤠ᤺ᤴᤈᤠᤰ"]},{"type":"verse","number":1,"content":["ᤋᤥᤗᤡᤱᤛᤥᤔᤢᤀᤠᤱᤎᤥᤀᤣ ᤘᤕᤧᤒᤠ. ᤀᤠᤏᤡᤃᤧ ᤂᤧᤵᤛᤢᤶᤒᤧᤀᤠᤱ ᤘᤕᤡᤃᤧᤒᤠ. ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤒᤠᤅᤣ ᤔᤡᤰᤁᤡᤸᤗᤧ ᤏᤡ᤺ᤛᤢᤶᤒᤧᤀᤠᤱ ᤘᤕᤡᤃᤧᤒᤠ. ᤏᤢ᤺ᤖᤡᤰᤁᤠᤱ ᤀᤥᤔᤧᤳᤋᤢᤶᤒᤧᤀᤠᤱ ᤘᤕᤡᤃᤧᤒᤠ. ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤒᤠᤅᤣ ᤜᤢᤰᤁᤡᤸᤗᤧ ᤛᤢ᤺ᤛᤢᤶᤒᤧᤀᤠᤱ ᤘᤕᤡᤃᤧᤒᤠ ᤜᤡᤱᤔᤴ ᤁᤧᤒᤡᤒᤠ ᤐᤠ᤺ᤴᤈᤠᤰᤁᤡᤸᤗᤧ",{"noteId":0},"ᤁᤢᤕᤠ᤺ᤶᤒᤣᤀᤥ ᤂᤡᤏᤡ᤹ ᤛᤰᤀᤡᤱᤄᤱ ᤜᤠᤰᤁᤠᤛᤡᤃᤧᤖᤥ॥"]},{"type":"verse","number":2,"content":["ᤂᤧᤴ ᤜᤡᤱᤔᤴᤏᤡᤴ ᤌᤠ᤺ᤶᤛᤡᤱ. ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤏᤡᤃᤧ ᤏᤡ᤺ᤔᤏᤠᤀᤠᤱ ᤂᤧᤸᤗᤧᤴ ᤛᤠ᤺ᤰᤂᤡ ᤐᤡᤔᤏᤠᤖᤥ॥ ᤂᤢᤏᤧ᤹ᤀᤣ ᤔᤧᤴᤏᤢᤵᤔᤏᤠᤒᤠ ᤜᤡᤱᤔᤴᤗᤥ ᤑᤠ᤹ᤀᤠᤱ ᤂᤡᤏᤡ᤹ ᤔᤧᤳᤋᤠᤛᤡᤃᤧ᤹ᤖᤥ॥ ᤂᤢᤏᤧ᤹ᤃ ᤐᤠᤏᤢᤍᤡᤱ ᤐᤠ᤺ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴᤏᤢ ᤘᤕᤧ. ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤏᤡᤃᤧᤀᤥ ᤌᤠ᤺ᤶᤛᤡᤱᤗᤥ॥"]},{"type":"verse","number":3,"content":["ᤂᤡᤏᤡ᤹ ᤀᤠᤏᤡᤃᤧᤏᤢ ᤛᤣᤛᤣ ᤋᤱᤈᤢᤶ ᤁᤧᤈᤥᤃᤢᤶᤗ ᤑᤠ᤹ᤀᤠᤱ ᤀᤠᤏᤡᤃᤧ ᤏᤡ᤺ᤔᤏᤠᤒᤠ ᤏᤢ ᤂᤧᤶᤔᤏᤠᤒᤠ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤂᤡᤏᤡ᤹ ᤔᤧᤳᤋᤠᤛᤡᤃᤧᤒᤠᤖᤥ॥ ᤀᤠᤏᤡ᤹ ᤋᤱᤈᤢᤶᤔᤡᤱᤃ ᤐᤠᤏᤢᤍᤡᤱ ᤐᤠ᤺ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴᤏᤢ ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤒᤢᤃᤧᤴ ᤁᤢᤛ᤻ᤛᤠ᤺ ᤕᤧᤛᤢ ᤂᤪᤡᤛ᤻ᤋᤧᤴᤏᤢ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":4,"content":["ᤀᤠᤏᤡᤃᤧ ᤛ᤺ᤵᤔᤠᤴ ᤁᤢᤗᤡᤱᤎᤥ ᤁᤧᤳᤗ ᤑᤠ᤹ᤀᤠᤱ ᤁᤴ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤛᤠᤵᤋᤢᤶᤒᤧᤀᤠᤱ ᤜᤠᤰᤁᤠᤛᤡᤃᤧᤒᤠᤖᤥ॥"]},{"type":"heading","content":["ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤛᤧᤴᤍᤠᤱᤃᤧᤴ ᤀᤥ᤺ᤳᤋᤡᤖᤥ"]},{"type":"verse","number":5,"content":["ᤀᤠᤸᤗ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤛᤧᤴᤍᤠᤱᤃᤧᤴ ᤀᤥ᤺ᤳᤋᤡᤖᤥ. ᤂᤢᤏᤧ᤹ᤀᤥ ᤔᤡ᤺ᤛᤠᤰᤁᤠᤱ ᤂᤠᤍᤠᤶᤔᤠᤴ ᤜᤥ᤺ᤵᤗᤥ ᤁᤧᤗ᤹ᤒᤠ ᤀᤡᤱᤄᤱᤅᤡᤴ ᤀᤠᤒᤢᤃᤧᤴ ᤁᤢᤛ᤻ᤛᤠ᤺ᤴᤗᤠᤶ ᤂᤧᤵᤛᤢᤶᤒᤧᤀᤠᤱ ᤂᤡᤏᤡ᤹ ᤔᤧᤳᤋᤠᤛᤡᤃᤧᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":6,"content":["ᤀᤠᤏᤡ᤹ ᤛᤣᤛᤣ ᤋᤱᤈᤢᤶᤔᤡᤴ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴᤏᤢ ᤘᤠ᤹ ᤗ᤹ᤖᤡᤰ ᤀᤠᤒᤠ᤺ᤳᤋᤢᤶ ᤁᤖ ᤔᤠᤰᤆᤡᤃᤧᤴ ᤂᤠᤍᤠᤶᤔᤥ ᤗᤠᤱᤄᤣ᤺ᤰᤔᤏᤠᤒᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤗᤠᤕᤥᤀᤥ ᤀᤠᤘᤠ᤹ᤏᤧ ᤑᤠ᤹ᤃᤪ ᤀᤠᤏᤡ᤹ ᤀᤡᤱᤗᤧᤰ ᤐᤠ᤺ᤴ ᤀᤠᤒᤠ᤺ᤳ ᤜᤧᤰᤁᤩᤠᤱ ᤛᤧᤰᤂᤠᤀᤥ ᤀᤠᤴᤘᤠ᤹ᤏᤧᤴᤗᤥ॥"]},{"type":"verse","number":7,"content":["ᤁᤖ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤛᤧᤴᤍᤠᤱᤃᤧᤴ ᤀᤥ᤺ᤳᤋᤡᤀᤥ ᤘᤠ᤹ᤒᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤀᤠᤏᤡ᤹ᤀᤠᤱ ᤛᤧᤴᤍᤠᤱᤃᤧᤴ ᤀᤥ᤺ᤳᤋᤡᤀᤥ ᤀᤠᤜᤡᤱᤗ ᤀᤠᤘᤠ᤹ᤏᤧ ᤑᤠ᤹ᤃᤪ ᤀᤠᤏᤡ᤹ ᤗᤢᤶᤔᤥ ᤛᤣᤛᤣ ᤋᤱᤈᤢᤶ ᤐᤥ᤺ᤱᤗᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤒᤢᤃᤧᤴ ᤁᤢᤛ᤻ᤛᤠ᤺ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤔᤠᤰᤂᤡ᤹ᤀᤡᤸᤗᤧ ᤀᤠᤏᤡ᤹ ᤁᤠᤰ ᤗᤠᤕᤥᤗᤠᤶ ᤛᤢᤳᤌᤥ ᤀᤠᤈᤥ᤺ᤰᤗᤥ॥"]},{"type":"verse","number":8,"content":["ᤁᤖ ᤀᤠᤏᤡ᤹ ᤗᤠᤕᤥ ᤔᤧ᤺ᤴᤏᤣ ᤀᤠᤘᤠ᤹ ᤗ᤹ᤖᤡᤰ ᤀᤠᤒᤠ᤺ᤳᤋᤢᤶᤏᤧ ᤑᤠ᤹ᤃᤪ ᤀᤠᤏᤡ᤹ ᤀᤠᤒᤠᤅᤣ ᤀᤡᤱᤀᤠᤗᤧᤰᤛᤡᤱᤅᤠᤱ ᤛᤧᤰᤂᤠ᤺ᤴ ᤀᤠᤏᤡ᤹ᤀᤥ ᤜᤥ᤺ᤵᤗᤥ॥"]},{"type":"verse","number":9,"content":["ᤁᤖ ᤀᤠᤏᤡ᤹ ᤗᤠᤕᤥᤜᤠ᤹ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤍᤃᤡ ᤀᤠᤒᤠ᤺ᤳᤋᤢᤶᤏᤧ ᤑᤠ᤹ᤃᤪ ᤗᤧᤵᤔᤡ ᤀᤠᤒᤡ᤹ᤖᤥ ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤏᤡ᤹ ᤁᤠᤰ ᤑᤧᤴ ᤕᤠ᤺ᤶᤒᤰᤁᤥᤗᤠᤶ ᤛᤢᤳᤌᤥ ᤀᤠᤈᤥ᤺ᤰᤗᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤢᤏᤧ᤹ᤃ ᤏᤛᤠ᤺ᤴᤛᤠᤒᤠ ᤏᤢ ᤛᤠᤶᤕᤥᤏᤡᤒᤠ ᤆᤥ᤺ᤰᤗᤥ॥"]},{"type":"verse","number":10,"content":["ᤀᤠᤏᤡ᤹ ᤗᤠᤕᤥ ᤔᤧᤴᤈᤥ᤺ᤰᤁᤣ ᤀᤠᤘᤠ᤹ ᤗ᤹ᤖᤡᤰ ᤀᤠᤒᤠ᤺ᤳᤋᤢᤶᤏᤧ ᤑᤠ᤹ᤃᤪ ᤂᤢᤏᤧ᤹ ᤀᤡᤱᤗᤧᤰ ᤁᤧᤒᤠ᤺ᤵᤐᤠ ᤀᤠᤈᤥᤃᤢᤶᤔᤠᤱ ᤂᤢᤏᤧ᤹ ᤁᤢᤒᤠ᤺ᤴᤈᤠᤰᤁᤡᤴ ᤀᤠᤏᤡ᤹ᤀᤥ ᤜᤥ᤺ᤵᤗᤥ॥"]}],"footnotes":[{"noteId":0,"caller":"*","text":"ᤜᤡᤱᤔᤴ ᤁᤧᤒᤡᤒᤠ ᤐᤠ᤺ᤴᤈᤠᤰ–ᤕᤧᤛᤢ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤗᤳᤇᤠ ᤁᤢᤔᤡᤱ॥","reference":{"chapter":1,"verse":1}}]},"thisChapterLink":"/api/lif_wbt/1JN/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lif_wbt/1JN/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lif_wbt/2PE/3.json","previousChapterAudioLinks":{},"numberOfVerses":10}