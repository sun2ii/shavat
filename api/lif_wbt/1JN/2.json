,"number":5,"content":["ᤁᤖ ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰᤁᤡᤴ ᤁᤧᤀᤡ᤺ᤵᤐᤠ ᤁᤧᤏᤠ᤺ᤵᤐᤠᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤛᤧᤰᤂᤠᤀᤣ ᤛᤠ᤹ᤖᤡᤰ ᤔᤡ᤺ᤶᤈᤡ ᤔᤧᤳᤋᤢ᤹ᤖᤥ॥ ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤀᤠᤏᤡ᤹ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴᤏᤢ ᤀᤠᤘᤠ᤹ ᤁᤧᤗ᤹ᤒᤠᤴ ᤀᤠᤏᤡ᤺ᤛᤢᤶᤗᤥ॥"]},{"type":"verse","number":6,"content":["ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤥ ᤘᤠ᤹ᤀᤠ ᤗ᤹ᤖᤡᤰ ᤁᤧᤒᤠ᤺ᤵᤐᤠᤸᤗᤧ ᤕᤧᤛᤢᤖᤧ ᤆᤥᤃᤢᤒᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤆᤥᤃᤢᤖ ᤘᤠ᤹ᤖ ᤐᤥ᤺ᤱᤗᤥ॥"]},{"type":"heading","content":["ᤁᤢᤛᤱ ᤀᤡᤱᤈᤠ᤺ᤱ"]},{"type":"verse","number":7,"content":["ᤀᤠᤔᤡ᤺ᤶ ᤀᤠᤴᤈᤢᤶᤛᤣ. ᤁᤴ ᤛᤠᤵᤋᤢᤱᤒᤠ ᤀᤡᤱᤈᤠ᤺ᤱᤅᤡᤴ ᤁᤢᤛᤱ ᤀᤡᤱᤈᤠ᤺ᤱᤃ ᤔᤧ᤺ᤴᤗᤥ॥ ᤁᤱᤃ ᤀᤢᤴᤇᤥ᤺ᤴᤏᤠᤱᤎᤥ ᤂᤡᤏᤡ᤹ᤏᤢᤀᤣ ᤁᤧᤘᤠ᤹ᤒᤠ ᤁᤧᤕᤢ᤺ᤒᤠ ᤀᤡᤱᤈᤠ᤺ᤱᤗᤥ॥ ᤁᤴ ᤀᤢᤴᤇᤥ᤺ᤴᤒᤠ ᤀᤡᤱᤈᤠ᤺ᤱᤅᤡᤱᤃ ᤁᤧᤄᤧᤵᤛᤢᤶ ᤁᤧᤛᤢᤖᤢᤶᤒᤠ ᤐᤠ᤺ᤴᤈᤠᤰᤗᤥ॥"]},{"type":"verse","number":8,"content":["ᤜᤧᤰᤁᤣᤛᤠᤱ ᤁᤴ ᤛᤠᤵᤋᤢᤱᤒᤠ ᤀᤡᤱᤈᤠ᤺ᤱᤅᤡᤱᤃ ᤁᤢᤛᤱ ᤜᤧᤰᤋᤱᤒᤠ ᤆᤥ᤺ᤰ–ᤂᤧᤸᤗᤧ ᤁᤢᤛᤧᤰᤂᤠ᤺ᤱᤃ ᤂᤪᤡᤛ᤻ᤋᤀᤥ ᤏᤢ ᤂᤡᤏᤡ᤹ᤀᤥ ᤏᤡᤎᤠ᤺ᤒᤧᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥ ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤔᤠᤰᤆᤡᤃᤧᤴ ᤂᤠᤍᤠᤶᤔᤠᤴ ᤗᤧᤰ ᤐᤣ᤺ᤰᤗ ᤐᤳ. ᤜᤧᤰᤁᤩᤠᤱ ᤛᤧᤰᤂᤠᤒᤠ ᤛᤧᤴᤍᤠᤱᤃᤧᤴ ᤀᤥ᤺ᤳᤋᤡ᤺ᤴ ᤋᤃᤡᤏᤢᤀᤣ ᤀᤥ᤺ᤳᤗ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":9,"content":["ᤀᤡᤱᤃᤠ᤹ ᤛᤧᤴᤍᤠᤱᤃᤧᤴ ᤀᤥ᤺ᤳᤋᤡᤀᤥ ᤘᤠ᤹ᤀᤠ ᤗ᤹ᤖᤡᤰ ᤁᤧᤒᤠ᤺ᤵᤐᤠᤸᤗᤧ ᤏᤛᤠᤏᤡᤒᤠ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤜᤠ᤹ ᤆᤡ᤺ᤳᤋᤢᤛᤡ᤹ᤏᤧ ᤑᤠ᤹ᤃᤪ ᤂᤧᤱᤃ ᤀᤠᤸᤗ ᤌᤠᤖᤡᤰᤛᤠᤱ ᤔᤠᤰᤆᤡᤃᤧᤴ ᤂᤠᤍᤠᤶᤔᤥᤀᤣ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":10,"content":["ᤏᤛᤠᤏᤡᤒᤠ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤜᤠ᤹ ᤗᤢᤱᤔᤠ᤹ ᤁᤧᤍᤢᤰᤐᤧᤱᤃ ᤛᤧᤴᤍᤠᤱᤃᤧᤴ ᤀᤥ᤺ᤳᤋᤡᤀᤥ ᤘᤠ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤘᤣ᤹ᤜᤠ᤹ ᤁᤧᤄ᤺ᤒᤠ ᤐᤠ᤺ᤴ ᤂᤢᤏᤧ᤹ᤀᤥ ᤌᤣᤀᤠᤱ ᤜᤥ᤺ᤵᤗᤥ॥"]},{"type":"verse","number":11,"content":["ᤁᤖ ᤏᤛᤠᤏᤡᤒᤠ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤜᤠ᤹ ᤁᤧᤈᤡ᤺ᤵᤐᤠᤱᤃ ᤂᤠᤍᤠᤶᤔᤥ ᤘᤠ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤠᤍᤠᤶᤔᤥ ᤗᤠᤱᤄᤣ᤺ᤰᤁᤡᤸᤗᤧ ᤂᤢᤏᤧ᤹ ᤀᤠᤳᤋᤠᤴ ᤗᤧᤵᤔᤠᤱ ᤐᤣ᤺ᤰᤗ ᤐᤳ ᤌᤣᤀᤠᤱ ᤏᤡᤱᤘᤠ᤹ ᤔᤧᤄᤥ᤺ᤛᤢᤴᤗᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤠᤍᤠᤶᤔᤠᤸᤗᤧ ᤂᤧᤴ ᤂᤠᤔᤧᤴᤏᤡ᤺ᤔᤏᤠᤒᤠ ᤆᤥᤃᤢᤍᤣ᤺ᤛᤢᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":12,"content":[{"text":"ᤀᤠᤔᤡ᤺ᤶ ᤜᤡᤴᤈᤠ᤹ᤒᤡᤳᤇᤠᤛᤣ. ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤆᤥᤃᤢᤒᤠ ᤁᤢᤕᤠ᤺ᤶᤒᤰᤗᤠᤶ ᤂᤡᤏᤡ᤹ ᤗᤠᤕᤥ᤺ᤴ ᤗᤧᤵᤔᤡ ᤐᤥ᤺ᤰᤂᤧᤒᤠᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤁᤴ ᤛᤰᤀᤡᤱᤄᤱᤅᤡᤴ ᤛᤠᤵᤋᤢᤱᤅᤠᤱ ᤜᤠᤰᤏᤡᤱᤗ ᤐᤳᤋᤠᤖᤥ॥","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ᤐᤠᤏᤢᤍᤡᤱ ᤐᤠ᤺ᤛᤣ. ᤋᤥᤗᤡᤱᤛᤥᤔᤢᤀᤠᤱᤎᤥᤀᤣ ᤁᤧᤘᤠ᤹ᤒᤠ ᤂᤪᤡᤛ᤻ᤋᤧᤴ ᤂᤡᤏᤡ᤹ ᤁᤢᤛᤡᤱ ᤁᤧᤏᤡ᤺ᤳᤋᤢᤶᤒᤠᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤁᤴ ᤛᤰᤀᤡᤱᤄᤱᤅᤡᤴ ᤛᤠᤵᤋᤢᤱᤅᤠᤱ ᤜᤠᤰᤏᤡᤱᤗ ᤐᤳᤋᤠᤖᤥ॥","poem":1},{"lineBreak":true},{"text":"ᤌᤠᤱᤒᤧᤴ ᤔᤧᤴᤇᤡᤕᤠ᤹ᤛᤣ. ᤔᤠᤑᤧᤴᤛᤠᤶᤔᤡᤴ ᤂᤡᤏᤡ᤹ ᤁᤧᤏᤠ᤺ᤴᤍᤢᤶᤔᤠᤱ ᤁᤧᤘᤕᤡᤒᤠᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤁᤴ ᤛᤰᤀᤡᤱᤅᤡᤴ ᤛᤠᤵᤋᤢᤱᤅᤠᤱ ᤜᤠᤰᤏᤡᤱᤗ ᤐᤳᤋᤠᤖᤥ॥","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ᤀᤠᤔᤡ᤺ᤶ ᤀᤠᤛ᤻ᤛᤠ᤺ᤛᤣ. ᤐᤠᤏᤢᤍᤡᤱ ᤐᤠ᤺ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤂᤡᤏᤡ᤹ ᤁᤢᤛᤡᤱ ᤁᤧᤏᤡ᤺ᤳᤋᤢᤶᤔᤠᤱ ᤁᤧᤘᤕᤡᤒᤠᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤁᤴ ᤛᤰᤀᤡᤱᤄᤱᤅᤡᤴ ᤛᤠᤵᤋᤢᤱᤅᤠᤱ ᤜᤠᤰᤏᤡᤱᤗ ᤐᤳᤋᤠᤖᤥ॥","poem":1},{"lineBreak":true},{"text":"ᤐᤠᤏᤢᤍᤡᤱ ᤐᤠ᤺ᤛᤣ. ᤋᤥᤗᤡᤱᤛᤥᤔᤢᤀᤠᤱᤎᤥ ᤁᤧᤘᤠ᤹ᤒᤠ ᤂᤪᤡᤛ᤻ᤋᤧᤴ ᤂᤡᤏᤡ᤹ ᤁᤢᤛᤡᤱ ᤁᤧᤏᤡ᤺ᤳᤋᤢᤶᤒᤠᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤁᤴ ᤛᤰᤀᤡᤱᤄᤱᤅᤡᤴ ᤛᤠᤵᤋᤢᤱᤅᤠᤱ ᤜᤠᤰᤏᤡᤱᤗ ᤐᤳᤋᤠᤖᤥ॥","poem":1},{"lineBreak":true},{"text":"ᤌᤠᤱᤒᤧᤴ ᤔᤧᤴᤇᤡᤕᤠ᤹ᤛᤣ. ᤂᤡᤏᤡ᤹ ᤁᤧᤎᤢᤶᤒᤠ ᤁᤧᤈᤥᤃᤡ᤹. ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰᤁᤡᤴ ᤂᤡᤏᤡ᤹ᤀᤥ ᤘᤠ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤔᤠᤑᤧᤴᤛᤠᤶᤔᤡᤴ ᤁᤧᤏᤠ᤺ᤴᤍᤢᤶᤔᤠᤱ ᤁᤧᤘᤕᤡᤒᤠᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤁᤴ ᤛᤰᤀᤡᤱᤅᤡᤴ ᤛᤠᤵᤋᤢᤱᤅᤠᤱ ᤜᤠᤰᤏᤡᤱᤗ ᤐᤳᤋᤠᤖᤥ॥","poem":1}]},{"type":"heading","content":["ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤠᤴ ᤔᤡ᤺ᤶᤈᤡ ᤔᤧᤵᤔᤠ ᤔᤧ᤺ᤴᤗᤥ"]},{"type":"verse","number":15,"content":["ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤠᤴ ᤏᤢ ᤂᤧᤵᤔᤥ ᤁᤧᤘᤠ᤹ᤒᤠ ᤆᤡᤃ᤺ᤰᤘᤠᤜᤠ᤹ ᤔᤡ᤺ᤶᤈᤡ ᤔᤧᤔᤧᤳᤋᤧᤶᤔᤡᤴᤏᤧ᤹ᤀᤥ॥ ᤀᤠᤳᤋᤡᤸᤗᤧ ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤠᤴ ᤔᤡ᤺ᤶᤈᤡ ᤔᤧᤳᤋᤢ᤹. ᤂᤧᤸᤗᤧ ᤐᤠᤏᤢᤍᤡᤱ ᤐᤠ᤺ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤔᤡ᤺ᤶᤈᤡ ᤔᤧᤵᤔᤠ ᤔᤧᤛᤢᤰᤋᤢᤴᤗᤥ॥"]},{"type":"verse","number":16,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥᤒᤠ ᤗᤠᤕᤥᤒᤠ ᤕᤠᤶᤏᤡᤱᤘᤠ᤹ᤀᤡᤴ. ᤔᤡᤰᤗᤥ ᤗᤠᤶᤔᤠᤴ. ᤜᤧᤰᤁᤩᤠᤱ ᤁᤵᤔᤏᤠᤒᤠ ᤏᤢ ᤆᤥ᤺ᤰᤔᤏᤠᤒᤠ ᤐᤠ᤺ᤴᤏᤥ ᤜᤧᤴᤇᤡᤱᤔᤠᤴ ᤐᤠᤏᤢᤍᤡᤱ ᤐᤠ᤺ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤗᤠᤶᤒᤠ ᤔᤧᤍᤠᤏᤧᤴ. ᤁᤖ ᤂᤧᤱᤃ ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥᤗᤠᤶᤒᤠᤏᤧ ᤋᤠ᤺ᤖᤥ॥"]},{"type":"verse","number":17,"content":["ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤠᤴ ᤗᤧᤰᤁᤠᤱ ᤐᤣ᤺ᤰ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤱ ᤑᤠ᤹ᤀᤠᤱ ᤀᤡ᤺ᤳᤋᤢ ᤛᤥ᤺ᤰᤋᤢᤒᤠ ᤐᤠ᤺ᤴᤜᤠ᤹ᤀᤠᤱ ᤗᤧᤰᤁᤠᤱ ᤐᤣ᤺ᤰ. ᤁᤖ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤏᤡᤱᤘᤠ᤹ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤁᤧᤈᤥ᤺ᤰᤐᤠᤱᤃ ᤛᤍᤠᤍᤡᤱ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"heading","content":["ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤁᤢᤒᤡᤑᤩᤢᤱᤒᤠᤜᤠ᤹"]},{"type":"verse","number":18,"content":["ᤀᤠᤔᤡ᤺ᤶ ᤀᤠᤛ᤻ᤛᤠ᤺ᤛᤣ. ᤁᤢᤏᤢᤵᤔᤠ ᤕᤧᤶᤔᤡᤱᤃ ᤏᤡ᤺ᤳᤋᤠᤱᤅᤣ ᤘᤠ᤹ᤖᤥ॥ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤁᤢᤒᤡᤑᤩᤢᤱᤅᤡᤱᤃ ᤋᤠ᤺ ᤗ᤹ᤖᤡᤰ ᤁᤧᤄᤧᤵᤛᤢᤶᤔᤠᤱ ᤁᤧᤘᤕᤡ᤹॥ ᤀᤠᤸᤗᤥᤛᤠ ᤂᤧᤴ ᤜᤧᤰᤋᤱᤒᤠ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤁᤢᤒᤡᤑᤩᤢᤱᤜᤠ᤹ ᤕᤖᤡᤰ ᤔᤧᤍᤩᤧ ᤔᤧᤈᤢᤖᤧᤀᤠᤱ ᤔᤧᤘᤠ᤹ᤖᤥ॥ ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤁᤴ ᤐᤠ᤺ᤴᤏᤥᤗᤠᤶ ᤁᤢᤏᤢᤵᤔᤠ ᤕᤧᤶᤔᤡᤴ ᤏᤡ᤺ᤳᤋᤠᤱᤅᤣ ᤘᤠ᤹ ᤁᤧᤗ᤹ᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤁᤢᤛᤡᤱ ᤀᤠᤏᤡ᤺ᤳᤋᤢᤶᤗᤥ॥"]},{"type":"verse","number":19,"content":["ᤂᤧᤱᤜᤠ᤹ᤃ ᤀᤠᤏᤡ᤹ᤗᤠᤶ ᤔᤧᤗ᤺ᤴᤍᤧ ᤔᤧᤒᤣ. ᤁᤖ ᤛᤧᤰᤂᤠ᤺ᤸᤗᤧᤃ ᤂᤧᤱᤜᤠ᤹ ᤀᤠᤏᤡ᤹ ᤔᤏᤠᤜᤠ᤹ ᤔᤧᤴᤘᤕᤧᤴᤗᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤧᤱᤜᤠ᤹ ᤀᤠᤏᤡ᤹ ᤔᤏᤠᤜᤠ᤹ ᤔᤧᤘᤕᤧᤸᤗᤧᤃ ᤂᤧᤱᤜᤠ᤹ ᤀᤠᤏᤡ᤹ᤏᤢᤀᤣ ᤔᤧᤕᤠ᤺ᤰᤋᤧᤒᤠ ᤔᤧ᤺ᤴᤗᤥ॥ ᤁᤖ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤐᤰᤀᤠᤶᤎᤩᤧᤀᤠᤱ ᤔᤧᤒᤣᤒᤠᤸᤗᤧ ᤂᤧᤱᤜᤠ᤹ ᤁᤧᤖᤧᤰ ᤀᤠᤏᤡ᤹ᤜᤠ᤹ ᤔᤧ᤺ᤴᤇᤡ ᤁᤧᤗ᤹ᤒᤠᤴ ᤀᤥᤛᤣ᤺ᤴᤍᤠᤱ ᤐᤥ᤺ᤰᤂᤧᤖᤥ॥"]},{"type":"verse","number":20,"content":["ᤁᤖ ᤂᤡᤏᤡ᤹ᤃ ᤛᤣᤛᤣᤒᤠ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤛᤣᤛᤣᤔᤠᤱ ᤁᤧᤒᤡᤖᤡᤀᤠᤱ ᤘᤠ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤡᤏᤡ