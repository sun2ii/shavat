pe":"verse","number":5,"content":["ᤀᤠᤏᤡ᤹ ᤗᤠᤕᤥ᤺ᤴ ᤂᤧᤵᤔᤠᤖᤧ ᤗᤠᤃᤡ ᤂᤪᤡᤛ᤻ᤋᤧᤴ ᤕᤧᤒᤠᤱᤃ ᤂᤡᤏᤡ᤹ ᤁᤢᤛᤡᤱ ᤁᤧᤏᤡ᤺ᤳᤋᤢᤶᤗᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ᤀᤥ ᤗᤠᤕᤥ ᤜᤥ᤺ᤵᤗᤥ॥"]},{"type":"verse","number":6,"content":["ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤀᤠᤳᤋᤡᤴ ᤂᤪᤡᤛ᤻ᤋᤀᤥ ᤘᤠ᤹. ᤂᤧᤸᤗᤧ ᤗᤠᤕᤥ ᤆᤥᤃᤢᤖ ᤔᤧᤘᤠ᤹ᤏᤧᤴᤗᤥ॥ ᤁᤖ ᤀᤠᤳᤋᤡᤸᤗᤧ ᤗᤠᤕᤥ ᤆᤥᤃᤢᤖ ᤘᤠ᤹. ᤂᤧᤸᤗᤧ ᤂᤢᤏᤧ᤹ ᤔᤧᤴᤏᤡᤀᤣ ᤏᤢ ᤁᤢᤛᤡᤱ ᤔᤧᤴᤏᤡ᤺ᤳᤋᤣ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":7,"content":["ᤀᤠᤔᤡ᤺ᤶ ᤀᤠᤛ᤻ᤛᤠ᤺ᤛᤣ. ᤀᤠᤳᤋᤡᤴᤜᤠ᤹ᤖᤧᤀᤠᤱ ᤂᤡᤏᤡ᤹ ᤀᤡᤱᤃᤧᤔᤧᤸᤗᤧᤰᤋᤡᤴᤗᤖᤥ॥ ᤀᤠᤳᤋᤡᤸᤗᤧ ᤏᤢ᤺ᤒᤠ ᤕᤠ᤺ᤶᤒᤰ ᤆᤥᤃᤢ᤹ ᤂᤧᤱᤃ ᤂᤪᤡᤛ᤻ᤋᤧᤴ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤛᤠᤶᤕᤥᤏᤡᤒᤠ ᤐᤥ᤺ᤱᤗᤥ॥"]},{"type":"verse","number":8,"content":["ᤗᤠᤕᤥ ᤁᤧᤈᤥ᤺ᤰᤐᤠᤖ ᤁᤧᤘᤠ᤹ᤒᤠ ᤔᤏᤠ᤺ᤱᤃ ᤔᤠᤑᤧᤴᤛᤠᤶᤔᤡᤸᤗᤧ ᤁᤢᤔᤏᤠᤖᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤔᤠᤑᤧᤴᤛᤠᤶᤔᤡᤸᤗᤧ ᤋᤥᤗᤡᤱᤛᤥᤔᤢᤀᤠᤱᤎᤥᤀᤣ ᤗᤠᤕᤥ ᤆᤥᤃᤢᤖ ᤘᤠ᤹ᤖᤥ॥ ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠ᤺ᤴ ᤔᤠᤑᤧᤴᤛᤠᤶᤔᤡᤸᤗᤧ ᤁᤢᤕᤠ᤺ᤶᤒᤰᤁᤡᤴ ᤔᤧᤱᤛᤧ ᤕᤧᤒᤠᤖᤥ॥"]},{"type":"verse","number":9,"content":["ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤗᤠᤶ ᤁᤢᤛᤱ ᤗ᤹ᤖᤡᤰ ᤛᤠᤃᤧᤘᤠ᤺ᤴᤇᤡᤱᤒᤠ ᤀᤠᤳᤋᤡᤸᤗᤧᤀᤠᤱ ᤗᤠᤕᤥ ᤆᤥᤃᤢᤖ ᤔᤧᤘᤠ᤹ᤏᤧᤴ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤏᤥᤛᤪᤱᤅᤡᤴ ᤂᤢᤏᤧ᤹ᤀᤥ ᤘᤠ᤹ᤖᤥ॥ ᤂᤢᤏᤧ᤹ ᤗᤠᤕᤥ ᤆᤥ᤺ᤰᤁᤡ ᤘᤠ᤹ᤔᤠ ᤔᤧᤛᤢᤰᤏᤧᤴᤗᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤢᤏᤧ᤹ᤃ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤗᤠᤶ ᤛᤠᤘᤠ᤺ᤴᤇᤡᤱᤅᤠᤱ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":10,"content":["ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤛ᤻ᤛᤠ᤺ᤜᤠ᤹ ᤏᤢ ᤔᤠᤑᤧᤴᤛᤠᤶᤔᤡᤸᤗᤧ ᤁᤢᤛ᤻ᤛᤠ᤺ᤜᤠ᤹ᤀᤥ ᤔᤧᤴᤍᤱᤔᤏᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤀᤠᤶᤓᤠ ᤁᤴᤗᤥ–ᤀᤠᤳᤋᤡᤸᤗᤧ ᤛᤠᤶᤕᤥᤌᤡᤶ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤏᤢ᤺ᤒᤠ ᤕᤠ᤺ᤶᤒᤰ ᤔᤧᤈᤥᤃᤢᤴ ᤜᤧᤰᤁᤩᤠᤱ ᤏᤛᤠᤏᤡᤒᤠ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤜᤠ᤹ ᤗᤢᤱᤔᤠ᤹ ᤔᤧᤍᤢᤰᤋᤢᤛᤡᤴ ᤂᤧᤱᤃ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤛ᤻ᤛᤠ᤺ ᤔᤧ᤺ᤴᤗᤥ॥"]},{"type":"heading","content":["ᤀᤠᤏᤡ᤹ ᤗᤢᤱᤔᤠ᤹ ᤋᤢᤰᤛᤡᤱᤔᤠ ᤐᤥ᤺ᤱ"]},{"type":"verse","number":11,"content":["ᤀᤠᤏᤡ᤹ ᤗᤢᤱᤔᤠ᤹ ᤋᤢᤰᤛᤡᤱᤔᤠ ᤐᤥ᤺ᤱ ᤁᤧᤗ᤹ᤒᤠ ᤀᤡᤱᤄᤱᤅᤡᤱᤃ ᤋᤃᤡᤀᤠᤱᤎᤥᤀᤣ ᤁᤧᤄᤧᤵᤛᤢᤶᤔᤠᤱ ᤁᤧᤘᤕᤡ᤹ᤖᤥ॥"]},{"type":"verse","number":12,"content":["ᤂᤡᤏᤡ᤹ᤃ ᤁᤕᤡᤏᤧᤴ",{"noteId":1},"ᤜᤧᤰᤁᤣ ᤔᤧᤒᤥ᤺ᤰᤂᤧᤶᤔᤡᤴᤏᤧ᤹ᤀᤥ॥ ᤂᤧᤱᤃ ᤔᤠᤑᤧᤴᤛᤠᤶᤔᤡᤸᤗᤧᤴ ᤘᤕᤧᤀᤠᤱ ᤂᤧᤸᤗᤧ ᤀᤠᤒᤠᤅᤣ ᤁᤢᤴᤛᤠ᤹ᤀᤡᤴ ᤛᤧᤖᤢᤖᤥ॥ ᤌᤣᤀᤠᤱ ᤛᤧᤖᤢᤒᤠᤓᤧᤸᤗᤧ ᤂᤧᤸᤗᤧ ᤀᤠᤒᤠᤅᤣ ᤁᤢᤕᤠ᤺ᤶᤒᤰᤜᤠ᤹ ᤋᤠᤵᤑᤧ᤺ᤶᤒᤠ ᤆᤥᤃᤧ. ᤁᤖ ᤁᤢᤴᤛᤠ᤹ᤖᤧ ᤁᤢᤕᤠ᤺ᤶᤒᤰᤜᤠ᤹ ᤛᤠᤶᤕᤥᤏᤡᤒᤠ ᤆᤥᤃᤧ॥"]},{"type":"verse","number":13,"content":["ᤀᤠᤔᤡ᤺ᤶ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤛᤣ. ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥᤒᤠ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤁᤧᤶᤈᤡ᤺ᤳᤋᤡᤸᤗᤧ ᤂᤡᤏᤡ᤹ ᤏᤡᤱᤘᤠ᤹ ᤔᤧᤔᤕᤧᤶᤔᤡᤴᤏᤧ᤹ᤀᤥ॥"]},{"type":"verse","number":14,"content":["ᤀᤠᤏᤡ᤹ ᤏᤛᤠᤏᤡᤒᤠ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤜᤠ᤹ ᤗᤢᤱᤔᤠ᤹ ᤀᤠᤍᤢᤰᤛᤡᤱᤒᤠᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤀᤠᤏᤡ᤹ᤃ ᤛᤡ᤺ᤔᤧᤴᤗᤠᤶ ᤔᤧᤴᤏᤢᤵᤔᤏᤠᤒᤠ ᤜᤡᤱᤔᤴᤏᤥ ᤀᤠᤈᤳᤇᤡᤱᤅᤠᤱ ᤀᤠᤘᤠ᤹ ᤑᤠ᤹ᤀᤠᤱ ᤀᤠᤏᤡ᤺ᤛᤢᤶᤗᤥ॥ ᤁᤖ ᤀᤠᤳᤋᤡᤸᤗᤧ ᤘᤣ᤹ᤜᤠ᤹ ᤗᤢᤱᤔᤠ᤹ ᤔᤧᤍᤢᤰᤋᤢᤛᤡᤴ. ᤂᤧᤱᤃ ᤀᤠᤸᤗᤥᤛᤠᤱ ᤛᤡ᤺ᤔᤧᤴᤏᤥᤀᤣ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":15,"content":["ᤀᤠᤳᤋᤡᤸᤗᤧ ᤏᤛᤠᤏᤡᤒᤠ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤜᤠ᤹ ᤆᤡ᤺ᤳᤋᤢᤛᤡ᤹. ᤂᤧᤱᤃ ᤔᤏᤠ ᤁᤧᤛᤧᤵᤐᤠᤖᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤔᤏᤠ ᤁᤧᤛᤧᤵᤐᤠ ᤁᤧᤖᤧᤰᤗᤧ ᤔᤧᤴᤏᤢᤵᤔᤏᤠᤒᤠ ᤜᤡᤱᤔᤴᤏᤡᤴ ᤔᤧᤱᤄᤥ᤺ᤛᤢᤴ ᤑᤠ᤹ᤀᤠᤱ ᤂᤡᤏᤡ᤹ ᤁᤧᤏᤡ᤺ᤛᤢᤶᤗᤥ॥"]},{"type":"verse","number":16,"content":["ᤕᤧᤛᤢ ᤂᤪᤡᤛ᤻ᤋᤧᤱᤃ ᤀᤠᤏᤡ᤹ ᤗᤧᤰᤘᤠ ᤛᤩᤧᤒᤠᤸᤗᤧ ᤛᤧᤰᤂᤠᤒᤠ ᤔᤡ᤺ᤶᤈᤡᤴ ᤀᤠᤰᤋᤱᤒᤠ ᤆᤥ᤺ᤰ ᤑᤠ᤹ᤀᤠᤱ ᤁᤢᤛᤡᤱ ᤀᤠᤏᤡ᤺ᤳᤋᤢᤶᤗᤥ॥ ᤀᤠᤏᤡ᤹ᤀᤠᤱ ᤏᤛᤠᤏᤡᤒᤠ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤗᤧᤰᤘᤠ ᤛᤡ᤺ᤔᤠᤀᤠᤱ ᤕᤠᤖᤡᤵ ᤐᤥ᤺ᤱᤔᤠ ᤐᤥ᤺ᤱᤗᤥ॥"]},{"type":"verse","number":17,"content":["ᤆᤠᤜᤠᤒᤠ ᤁᤧᤈᤥ᤺ᤰᤐᤠ ᤁᤠᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤁᤧᤃᤵᤐᤠ ᤔᤏᤠ᤺ᤸᤗᤧ ᤏᤛᤠᤏᤡᤒᤠ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤜᤠ᤹ ᤆᤠᤜᤠᤒᤠ ᤔᤧᤈᤥ᤺ᤰᤁᤠᤱ ᤔᤧᤘᤠ᤹ᤒᤠ ᤏᤡ᤺ᤛᤢᤛᤠᤱ ᤗᤢᤱᤔᤠ᤹ ᤔᤧᤍᤢᤰᤋᤢᤛᤡᤴᤏᤡᤸᤗᤧ ᤀᤠᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤂᤧᤴ ᤔᤏᤠᤀᤥ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤔᤡ᤺ᤶᤈᤡᤴ ᤘᤠ᤹ᤒᤣ᥅"]},{"type":"verse","number":18,"content":["ᤀᤠᤔᤡ᤺ᤶ ᤀᤠᤛ᤻ᤛᤠ᤺ᤛᤣ. ᤀᤠᤏᤡ᤹ᤃ ᤐᤠ᤺ᤴᤏᤥ ᤏᤢ ᤔᤢᤖᤠ᤺ᤸᤗᤧᤖᤰ ᤗᤢᤱᤔᤠ᤹ ᤋᤢᤰᤁᤠᤛᤡ ᤔᤧ᤺ᤴᤗᤥ॥ ᤀᤠᤏᤡ᤹ ᤛᤧᤰᤂᤠ ᤗᤢᤱᤔᤠ᤹ ᤋᤢᤰᤛᤡᤱᤔᤠ ᤐᤥ᤺ᤱᤗᤥ॥ ᤜᤧᤰᤋᤱᤒᤠ ᤗᤢᤱᤔᤠ᤹ ᤋᤢᤰᤛᤡᤱᤔᤠᤴ ᤕᤠ᤺ᤶᤒᤰᤁᤥᤗᤠᤶ ᤏᤡ᤺ᤍᤧᤳᤗᤥ॥"]},{"type":"verse","number":19,"content":["ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤗᤢᤱᤔᤠ᤹ ᤀᤠᤍᤢᤰᤁᤠᤛᤡᤏᤧ ᤑᤠ᤹ᤃᤪ ᤀᤠᤏᤡ᤹ᤃ ᤛᤧᤰᤂᤠ᤺ᤸᤗᤧ ᤁᤢᤔᤏᤠᤛᤡ ᤑᤠ᤹ᤀᤠᤱ ᤀᤠᤏᤡ᤺ᤛᤢᤶᤗᤥ. ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤏᤡ᤹ ᤏᤡᤱᤘᤠ᤹ᤀᤡᤸᤗᤧᤀᤣ ᤐᤠ᤺ᤴ ᤀᤠᤎᤡᤰᤛᤠᤱ ᤀᤠᤏᤡ᤹ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤍᤃᤡ ᤋᤥ᤺ᤴᤇᤡᤱᤔᤠ ᤀᤠ᤺ᤴᤇᤡᤱᤃᤧᤴ ᤜᤠᤱᤜᤠᤱ ᤀᤠᤈᤥ᤺ᤰᤗᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤱᤃ ᤀᤠᤏᤡ᤹ ᤏᤡᤱᤘᤠ᤹ᤏᤢ᤺ᤸᤗᤧᤀᤠᤱ ᤐᤕᤶ ᤕᤶᤒᤠ ᤆᤥ᤺ᤰᤗᤥ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ ᤁᤧᤖᤧᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤏᤡ᤺ᤛᤢᤖᤥ॥"]},{"type":"verse","number":21,"content":["ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤀᤠᤔᤡ᤺ᤶ ᤀᤠᤴᤈᤢᤶᤛᤣ. ᤀᤠᤏᤡ᤹ ᤏᤡᤱᤘᤠ᤹ᤀᤡᤸᤗᤧᤀᤣ ᤐᤠ᤺ᤴ ᤀᤠᤴᤎᤡᤰᤏᤧᤴᤏᤧ ᤑᤠ᤹ᤃᤪ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤍᤃᤡ ᤜᤠᤱᤜᤠᤱᤅᤠᤱ ᤀᤠᤏᤡ᤹ ᤋᤠ᤺ᤔᤠ ᤀᤠᤛᤢᤰᤗᤥ॥"]},{"type":"verse","number":22,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤏᤡ᤹ᤃ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤀᤡᤱᤈᤠ᤺ᤱᤅᤡᤴ ᤀᤠᤀᤡ᤺ᤳᤋᤢᤶ ᤀᤠᤏᤠ᤺ᤳᤋᤢᤶᤒᤠ ᤏᤢ ᤂᤢᤏᤧ᤹ ᤁᤢᤛᤡᤖᤠ᤹ ᤁᤧᤎᤠᤱᤒᤠ ᤕᤠ᤺ᤶᤒᤰ ᤀᤠᤈᤥᤃᤢᤶᤒᤠᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤀᤠᤏᤡ᤹ ᤀᤠᤏᤠ᤺ᤰᤋᤢᤶᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤂᤢᤏᤧ᤹ ᤀᤠᤒᤡ᤹ᤖᤥ॥"]},{"type":"verse","number":23,"content":["ᤂᤢᤏᤧ᤹ ᤁᤢᤀᤡᤱᤈᤠ᤺ᤱᤅᤡᤱᤃ ᤒᤠ ᤁᤴᤗᤥ–ᤀᤠᤒᤢᤃᤧᤴ ᤁᤢᤛ᤻ᤛᤠ᤺ ᤕᤧᤛᤢ ᤂᤪᤡᤛ᤻ᤋᤧᤴ ᤀᤠᤏᤡ᤹ ᤏᤛᤠ᤺ᤴ ᤆᤥ᤺ᤰᤔᤠ ᤐᤥ᤺ᤱ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ ᤀᤠᤒᤡᤖᤧᤒᤠ ᤀᤡᤱᤈᤠ᤺ᤱ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤗᤢᤱᤔᤠ᤹ ᤋᤢᤰᤛᤡᤱᤔᤠ ᤐᤥ᤺ᤱᤗᤥ॥"]},{"type":"verse","number":24,"content":["ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤀᤡᤱᤈᤠ᤺ᤱᤅᤡᤴ ᤁᤧᤀᤡ᤺ᤵᤐᤠ ᤁᤧᤏᤠ᤺ᤵᤐᤧᤴ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤥ ᤘᤠ᤹ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤸᤗᤥ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤘᤠ᤹ᤖᤥ॥ ᤀᤠᤏᤡ᤹ᤀᤥ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤘᤠ᤹ ᤑᤠ᤹ᤀᤠᤱ ᤂᤢᤏᤧ᤹ ᤀᤠᤒᤡᤖᤧᤒᤠ ᤛᤣᤛᤣᤔᤠᤱᤗᤠᤶ ᤁᤢᤛᤡᤱ ᤀᤠᤏᤡ᤺ᤳᤋᤢᤶᤗᤥ॥"]}],"footnotes":[{"noteId":1,"caller":"*","text":"ᤁᤕᤡᤏ–ᤁᤴ ᤁᤠᤰᤏᤢ ᤋᤃᤡᤒᤠ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤴᤇᤡ᤹ ᤛᤠ᤺ ᤋᤢᤶᤒᤠᤸᤗᤧ ᤁᤢᤔᤡᤱᤗᤥ॥ ᤂᤢᤏᤧ᤹ ᤁᤢᤴᤛᤠ᤹ ᤜᤠᤒᤡᤗᤧᤴ ᤏᤠᤜᤧᤳᤋᤢᤀᤠᤱ ᤛᤧᤖᤢ (ᤋᤥᤗᤡᤱᤛᤥᤔᤢ ᥊.᥇-᥇᥌)॥","reference":{"chapter":3,"verse":12}}]},"thisChapterLink":"/api/lif_wbt/1JN/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lif_wbt/1JN/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lif_wbt/1JN/2.json","previousChapterAudioLinks":{},"numberOfVerses":23}