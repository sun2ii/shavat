{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"1TI","translationId":"lif_wbt","name":"᥇ ᤋᤡᤔᤥᤌᤡ","commonName":"᥇ ᤋᤡᤔᤥᤌᤡ","title":"ᤐᤠᤘᤗᤖᤧ ᤋᤡᤔᤥᤌᤡ᤺ᤴ ᤜᤠᤰᤋᤢᤒᤠ ᤌᤡᤰᤛᤡᤃᤣ᤺ᤰᤐᤠ ᤛᤰᤀᤡᤱᤄᤱ","order":54,"numberOfChapters":6,"sha256":"73f83f639fb18149437d48392e22e4b3e14b76a03a0f9cfdd540ca89d3f9c3c5","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/1TI/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/lif_wbt/1TI/6.json","totalNumberOfVerses":110},"chapter":{"number":2,"content":[{"type":"heading","content":["ᤁᤧᤖᤧᤰᤗᤧ ᤗᤠᤃᤡ ᤋᤢᤘᤠ ᤆᤥ᤺ᤰᤔᤠ"]},{"type":"verse","number":1,"content":["ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ. ᤁᤠᤰᤏᤢ᤺ᤸᤗᤧ ᤋᤃᤡ. ᤁᤠᤰ ᤔᤧᤴᤇᤠᤶ ᤕᤠᤵᤔᤡᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤗᤠᤃᤡ ᤜᤧᤰᤁᤩᤠᤱ ᤜᤠᤱᤜᤠ᤹ ᤏᤢ ᤘᤣ᤹ ᤕᤢᤰᤛᤠᤒᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤗᤠᤃᤡ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤥ ᤐᤣᤗᤡ. ᤋᤢᤘᤠᤜᤠ᤹. ᤕᤧᤰᤐᤣᤗᤡᤃᤧᤴ ᤋᤢᤘᤠᤜᤠ᤹ ᤏᤢ ᤜᤧᤏᤠ ᤏᤥᤃᤧᤴᤜᤠ᤹ ᤋᤥ᤺ᤶᤔᤠ ᤑᤠ᤹ᤀᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤐᤣᤗᤡ ᤑᤠᤰᤏᤡᤱᤗᤥ॥ ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤀᤠᤏᤡ᤹ ᤛᤏᤠᤖᤢᤱᤅᤥ ᤏᤢ ᤕᤧᤶᤕᤧᤶᤘᤠ ᤜᤡᤱᤔᤴᤏᤥ. ᤜᤧᤰᤁᤩᤠᤱ ᤛᤠᤶᤏᤡᤔᤥ ᤏᤢ ᤔᤡᤱᤛᤥ ᤀᤡᤱᤎᤠ᤺ᤱᤅᤥ ᤜᤡᤱᤔᤠ ᤀᤠᤛᤢᤰᤗᤖᤥ॥"]},{"type":"verse","number":3,"content":["ᤁᤱᤃ ᤀᤠᤏᤡ᤹ ᤛᤧᤴᤗᤵᤍᤠᤱᤒᤠ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤏᤡᤱᤘᤠ᤹ ᤁᤧᤍᤠ᤺ᤒᤠ ᤏᤢ ᤏᤢ᤺ᤒᤠ ᤆᤥ᤺ᤰᤗᤥ॥"]},{"type":"verse","number":4,"content":["ᤂᤢᤏᤧ᤹ᤃ ᤁᤠᤰ ᤔᤧᤴᤇᤠᤶ ᤕᤠᤵᤔᤡᤜᤠ᤹ᤖᤧ ᤛᤧᤰᤂᤠ᤺ᤴ ᤁᤢᤛᤡᤱ ᤔᤧᤏᤡ᤺ᤳᤋᤢᤀᤠᤱ ᤋᤠᤱᤔᤧᤛᤧ᤺ᤵᤗ ᤁᤧᤗ᤹ᤒᤠ ᤏᤡᤱᤘᤠ᤹ ᤀᤡ᤺ᤳᤋᤢᤖᤥ॥"]},{"type":"verse","number":5,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤱᤃ ᤌᤡᤰᤗᤰ ᤘᤠ᤹ᤖᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤏᤢ ᤔᤧᤴᤇᤠᤶ ᤕᤠᤵᤔᤡ ᤗᤢᤶᤔᤥ ᤐᤠ᤺ᤴᤍᤱᤛᤠᤒᤠᤴᤏᤠᤱ ᤌᤡᤰᤗᤰ ᤘᤠ᤹ᤖᤥ॥ ᤂᤧᤴ ᤐᤠ᤺ᤴᤍᤱ ᤁᤧᤈᤥ᤺ᤰᤐᤠ ᤔᤏᤠ᤺ᤱᤃ ᤂᤪᤡᤛ᤻ᤋ ᤕᤧᤛᤢᤖᤥ॥"]},{"type":"verse","number":6,"content":["ᤂᤢᤏᤧ᤹ ᤁᤧᤖᤧᤰ ᤔᤧᤴᤇᤠᤶ ᤕᤠᤵᤔᤡᤜᤠ᤹ ᤗᤠᤕᤥᤗᤠᤶ ᤌᤧ᤹ᤔᤠ­ᤛᤡᤀᤠᤱ ᤜᤡᤱᤔᤠᤛᤡ ᤑᤠ᤹ᤀᤠᤱ ᤁᤢᤔᤧᤸᤗᤢᤱᤅᤡᤸᤗᤧ ᤁᤢᤗᤧᤰᤘᤠ ᤀᤠᤵᤑᤣ᤺ᤰ ᤐᤡᤛᤡᤱᤗᤥ॥ ᤁᤴ ᤐᤠ᤺ᤴᤏᤡᤸᤗᤧ ᤋᤥ᤺ᤴᤍᤡ᤺ᤱᤃ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤛᤢᤕᤧᤶᤔᤥ ᤐᤡᤖᤢᤀᤠᤱ ᤘᤠ᤹॥"]},{"type":"verse","number":7,"content":["ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤏᤛᤠ᤺ᤴ ᤏᤢ ᤛᤧᤰᤂᤠᤒᤠ ᤛᤢᤏᤠᤀᤡᤱ ᤀᤡᤱᤓᤥ᤺ᤛᤧ ᤀᤡᤱᤃᤠ᤹ ᤌᤡᤶᤔᤧᤴᤍᤱ ᤛᤢᤘᤠᤱᤜᤠ᤹ᤖᤥ ᤛᤣ᤺ᤰᤕᤢᤰᤔᤡᤒᤠ ᤏᤢ ᤛᤡᤰᤛᤠᤶᤒᤠ ᤑᤠ᤹ᤀᤠᤱ ᤍᤠᤱᤒᤠᤸᤗᤧ ᤛᤣ᤺ᤰᤕᤢᤰ ᤆᤥᤃᤠᤱᤗᤥ॥ ᤀᤡᤱᤃᤠ᤹ ᤀᤡᤱᤗᤧᤰ ᤔᤧᤒᤠ᤺ᤳᤋᤠᤴᤗᤥ. ᤛᤧᤰᤂᤠᤒᤠ ᤐᤠ᤺ᤴᤏᤣ ᤐᤠ᤺ᤳᤋᤢᤱᤗᤥ॥"]},{"type":"verse","number":8,"content":["ᤀᤡᤱᤃᤠ᤹ ᤁᤠᤰ ᤕᤧᤶᤒᤡᤳᤇᤠ᤹ᤛᤠ᤺ᤜᤠ᤹ᤖᤧ ᤀᤠᤳᤋᤠᤴᤇᤠᤱ ᤕᤠ᤺ᤰᤔᤧᤸᤗᤧ᤹ᤀᤣ. ᤔᤧᤱᤄᤣᤀᤣ ᤔᤧᤴᤎᤰᤁᤣ ᤜᤧᤰᤁᤩᤠᤱ ᤛᤣᤛᤣᤒᤠ ᤜᤢᤰᤜᤠ᤹ ᤔᤧᤓᤥ᤺ᤰᤂᤢᤖ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤥ ᤋᤢᤘᤠ ᤔᤧᤈᤥᤃᤢᤖ ᤑᤠ᤹ᤀᤠᤱ ᤏᤡᤱᤘᤠ᤹ ᤆᤥᤃᤢᤱᤗᤥ॥"]},{"type":"heading","content":["ᤔᤧᤴᤇᤢᤔᤠᤜᤠ᤹ᤖᤧ ᤗᤠᤃᤡ ᤀᤡᤱᤈᤠ᤺ᤱ"]},{"type":"verse","number":9,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤔᤧᤴᤇᤢᤔᤠᤜᤠ᤹ᤖᤧᤀᤠᤱ ᤛᤡᤱᤛᤡᤱᤅᤠᤱ ᤏᤢ᤺ᤖᤡᤰᤁᤠᤱ ᤆᤠᤱᤜᤠ᤹ ᤔᤧᤈᤠᤰᤂᤢᤖᤖᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤀᤥᤗᤡᤀᤥᤗᤡᤒᤠ ᤌᤠ᤺ᤰ ᤑ᤺ᤔᤠ. ᤛᤠᤶᤔᤩᤠᤱ ᤏᤢ ᤘᤣ᤹ ᤀᤡᤔᤧᤸᤗᤢᤱᤒᤠ ᤘᤠ᤺ᤳᤋᤡ. ᤜᤧᤰᤁᤩᤠᤱ ᤀᤡᤔᤧᤸᤗᤢᤱᤒᤠ ᤆᤠᤱᤜᤠ᤹ᤖᤧ ᤔᤧᤴᤈᤥ᤺ᤰᤛᤡᤱᤅᤡᤸᤗ."]},{"type":"verse","number":10,"content":["ᤂᤧᤴᤏᤢ᤺ᤸᤗᤧᤃ ᤂᤧᤱᤜᤠ᤹ ᤂᤧᤶᤍᤢ ᤗᤠ᤹ᤖᤢᤛᤡᤒᤠ ᤏᤢ᤺ᤒᤠ ᤕᤠ᤺ᤶᤒᤰᤜᤠ᤹ ᤔᤧᤈᤥᤃᤢᤏᤡᤖᤥ॥ ᤂᤧᤸᤗᤧᤃ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤛᤣᤘᤠ ᤆᤥᤃᤢᤱ ᤁᤧᤗ᤹ᤔᤠ ᤔᤧᤴᤇᤢᤔᤠᤜᤠ᤹ ᤂᤧᤶᤍᤢ ᤗᤠ᤹ᤖᤢᤛᤡᤖᤥ॥"]},{"type":"verse","number":11,"content":["ᤔᤧᤴᤇᤢᤔᤠᤜᤠ᤹ ᤛᤫᤠ᤺ᤳᤋᤠᤱ ᤕᤢᤰᤁᤥ ᤘᤠ᤹ᤔᤠᤀᤠᤱ ᤜᤢ᤹ᤛᤡᤱᤔᤠ ᤐᤥ᤺ᤱᤗᤥ॥"]},{"type":"verse","number":12,"content":["ᤀᤡᤱᤃᤠ᤹ᤃ ᤔᤧᤴᤇᤢᤔᤠᤜᤠ᤹ᤖᤧ ᤕᤧᤶᤒᤡᤳᤇᤠ᤹ᤜᤠ᤹ ᤜᤢ᤹ᤔᤠᤛᤡ ᤏᤢ ᤕᤢᤰᤁᤥ ᤁᤵᤔᤠᤛᤡ ᤕᤢᤰ ᤔᤧᤒᤡᤖᤢᤱᤛᤡᤱᤅᤡᤴᤗᤥ॥ ᤁᤖ ᤔᤧᤴᤇᤢᤔᤠᤜᤠ᤹ᤃ ᤛᤫᤠ᤺ᤳ ᤔᤧᤘᤠ᤹ᤖᤖᤥ॥"]},{"type":"verse","number":13,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤏᤠᤘᤠᤃᤧᤴ ᤆᤀᤡ᤺ᤳ ᤐᤥ᤺ᤰᤂᤧᤸᤗᤧ ᤀᤠᤍᤶᤔᤡᤴ ᤋᤃᤡ ᤜᤧᤰᤁᤩᤠᤱ ᤜᤘᤠ᤺ᤱᤃ ᤕᤠᤱᤛᤡ ᤐᤥ᤺ᤰᤂᤧᤒᤠᤖᤥ॥"]},{"type":"verse","number":14,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤍᤶᤔᤡᤴ ᤀᤡᤱᤗᤧᤰᤁᤥ ᤌᤩᤧᤒᤠ ᤔᤧ᤺ᤴ. ᤁᤖ ᤔᤧᤴᤇᤢᤔᤠ᤹ᤀᤡᤴ ᤔᤠᤑᤧᤴᤛᤠᤶᤔᤡᤸᤗᤧ ᤀᤡᤱᤗᤧᤰᤋᤢᤀᤠᤱ ᤂᤧᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤀᤡᤱᤈᤠ᤺ᤱᤅᤡᤴ ᤑᤣ᤺ᤴᤍᤢᤀᤠᤱ ᤗᤠᤕᤥ ᤆᤥᤃᤢᤖᤥ॥"]},{"type":"verse","number":15,"content":["ᤁᤖ ᤔᤧᤴᤇᤢᤔᤠ᤹ᤀᤡᤴ ᤆᤰᤔᤧᤸᤗ᤹ᤀᤣ ᤏᤛᤠ᤺ᤴᤏᤥ. ᤘᤣ᤹ᤜᤠ᤹ ᤗᤢᤱᤔᤠ᤹ ᤋᤢᤰᤔᤠᤛᤡᤀᤥ ᤜᤧᤰᤁᤩᤠᤱ ᤛᤣᤛᤣ ᤜᤡᤱᤔᤴᤏᤥ ᤘᤠ᤹ᤏᤧ ᤑᤠ᤹ᤃᤪ ᤛᤠᤃᤵᤔᤥᤗᤠᤶ ᤋᤠᤱᤛᤧ᤺ᤵᤗᤥ॥"]}],"footnotes":[]},"thisChapterLink":"/api/lif_wbt/1TI/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lif_wbt/1TI/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lif_wbt/1TI/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}