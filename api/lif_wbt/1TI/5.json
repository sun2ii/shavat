:["ᤁᤖ ᤏᤛᤠᤏᤡᤔᤠ ᤔᤧᤴᤇᤢᤔᤠ᤹ᤀᤡᤸᤗᤧ ᤁᤢᤜᤡᤶᤛᤕᤱᤅᤥ ᤔᤣᤔᤣᤍᤢᤔᤠᤜᤠ᤹ ᤔᤧᤘᤠ᤹ᤏᤧ ᤑᤠ᤹ᤃᤪ ᤜᤠᤖᤠ᤹ ᤁᤶᤒᤪᤠᤱ ᤔᤧᤳᤋᤢᤛᤡᤖᤖᤥ॥ ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤂᤧᤴ ᤋᤢᤰᤂᤣ᤺ᤴ ᤛᤣᤛᤣᤜᤢᤵᤗᤰᤁᤥ ᤔᤧᤒᤥ᤺ᤱᤏᤧᤴᤗᤖᤥ॥ ᤛᤣᤛᤣᤜᤢᤵᤗᤰᤁᤡᤸᤗᤧ ᤛᤧᤰᤂᤠᤀᤣ ᤁᤠ᤹ᤀᤡ ᤛᤥ᤹ᤎᤥ᤺ᤰ ᤁᤧᤜᤥ᤺ᤵᤔᤠᤜᤠ᤹ᤖᤰ ᤁᤢᤓᤠ᤹ ᤐᤡᤔᤠᤛᤡ ᤐᤥ᤺ᤱᤗᤥ॥"]},{"type":"heading","content":["ᤛᤣᤛᤣᤜᤢᤵᤗᤰᤐᤠ ᤋᤢᤶᤗᤠᤶᤗᤥ᤺ᤒᤠᤜᤠ᤹"]},{"type":"verse","number":17,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤏᤢ᤺ᤒᤠ ᤕᤠ᤺ᤶᤒᤰ ᤁᤧᤈᤥ᤺ᤰᤐᤠ. ᤁᤢᤏᤥ-ᤁᤢᤒᤡ᤹ᤀᤥ ᤛᤢᤏᤠᤀᤡᤱ ᤀᤡᤱᤓᤥ᤺ᤔᤠ ᤏᤢ ᤐᤣᤗᤡᤃᤧᤴ ᤐᤠ᤺ᤴᤈᤠᤰ ᤜᤢ᤹ᤔᤠᤀᤥ ᤛᤠ᤹ᤖᤡᤰ ᤕᤠᤶᤒᤢᤎᤡᤰ ᤁᤧᤈᤥ᤺ᤰᤐᤠ ᤋᤢᤶᤗᤠᤶᤗᤥ᤺ᤒᤠᤜᤠ᤹ ᤁᤢᤓᤠ᤹ ᤏᤢ ᤔᤡᤱᤛᤥ ᤀᤡᤱᤎᤠ᤺ᤱ ᤂᤥ᤺ᤔᤠ ᤗᤠ᤹ᤖᤢᤛᤡᤖᤥ॥"]},{"type":"verse","number":18,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤛᤠᤶᤕᤥᤛᤠᤵᤗᤠᤀᤥ ᤛᤠᤵᤋᤧᤀᤠᤱ ᤐᤳ. “ᤆᤠ ᤁᤧᤏᤢᤰᤐᤠ ᤐᤡᤳᤋᤡᤸᤗᤧ ᤁᤢᤔᤢᤖᤠ᤺ᤴ ᤆ᤺ᤵᤐᤡᤸᤗᤧ ᤔᤧᤛᤢ᤺ᤵᤋᤧᤴᤏᤧ᤹ᤀᤥ.” ᤜᤧᤰᤁᤩᤠᤱ “ᤕᤠ᤺ᤗᤡᤰᤁᤡᤴ ᤏᤠᤶᤕᤠᤰ ᤂᤥ᤺ᤔᤠ ᤗᤠ᤹ᤖᤢᤖᤥ॥”"]},{"type":"verse","number":19,"content":["ᤏᤧᤳᤇᤡ ᤀᤡᤃᤪ ᤛᤢᤶᤛᤡ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤔᤧᤒᤡᤖᤢᤒᤠ ᤋᤥ᤺ᤴᤍᤡᤜᤠ᤹ ᤂᤧᤵᤛᤧᤀᤠᤱᤗᤰ ᤋᤢᤶᤗᤠᤶᤗᤥ᤺ᤒᤠᤜᤠ᤹ ᤔᤧᤎᤡᤰᤋᤢᤛᤡᤒᤠ ᤀᤠᤵᤋᤡᤰᤁᤡᤴ ᤀᤥᤔᤧᤳᤋᤧ᤹ᤀᤥ॥"]},{"type":"verse","number":20,"content":["ᤗᤠᤕᤥ ᤁᤧᤈᤥ᤺ᤰᤐᤠᤖ ᤁᤧᤘᤠ᤹ᤒᤠ ᤗᤠᤶᤗᤥ᤺ᤒᤠᤜᤠ᤹ ᤁᤠᤰ ᤏᤛᤠᤏᤡᤒᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤋᤃᤡ ᤑᤧ᤺ᤰᤋᤧᤛᤧ᤹ᤀᤥ. ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤘᤣ᤹ᤜᤠ᤹ ᤗᤠᤕᤥ ᤆᤥ᤺ᤰᤔᤠ ᤔᤧᤃᤡᤏᤡᤖᤥ॥"]},{"type":"verse","number":21,"content":["ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱ ᤏᤢ ᤂᤪᤡᤛ᤻ᤋ ᤕᤧᤛᤢᤖᤧ ᤂᤢᤴᤇᤡ᤹ ᤋᤃᤡ ᤜᤧᤰᤁᤩᤠᤱ ᤔᤧᤛᤣᤃᤧᤒᤠ ᤔᤠᤱᤗᤠᤀᤡᤱᤒᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤋᤃᤡ. ᤔᤏᤠᤜᤠ᤹ ᤀᤣ᤺ᤰᤐᤀᤣ᤺ᤰ ᤆᤥ᤺ᤰᤔᤠᤛᤡ ᤏᤢ ᤔᤏᤠ ᤛᤧᤶᤔᤠᤛᤡ ᤔᤧ᤺ᤴ. ᤜᤧᤰᤁᤩᤠᤱ ᤁᤠᤰ ᤌᤡᤶᤜᤠ᤹ ᤀᤡ᤺ᤳᤋᤧ ᤏᤠ᤺ᤳᤋᤧ᤹ ᤗ᤹ᤖᤡᤰ ᤀᤡᤱᤈᤠ᤺ᤱ ᤐᤡᤏᤧᤖᤥ॥"]},{"type":"verse","number":22,"content":["ᤔᤠᤱᤛᤣᤘᤠ ᤕᤠ᤺ᤶᤒᤰᤁᤥ ᤗᤠᤶᤗᤥ᤺ᤒᤠ ᤛᤣ᤺ᤰᤕᤢᤰ ᤆᤥ᤺ᤰᤔᤠᤖᤧ ᤗᤠᤃᤡ ᤔᤏᤠᤜᤠ᤹ ᤛᤶᤍᤠᤱ ᤜᤢᤰ ᤏᤧᤔᤠ ᤕᤠ᤺ᤶᤒᤰᤁᤡᤴ ᤜᤠᤖᤠ ᤔᤧᤈᤥᤃᤧᤴᤏᤧ᤹ᤀᤥ॥ ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤘᤣ᤹ᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤗᤠᤕᤥᤀᤥ ᤔᤧᤴᤎᤠᤀᤣ ᤂᤧᤏᤧ᤹ᤃ ᤛᤣᤛᤣᤀᤣ ᤘᤕᤧ᤹ᤀᤥ॥"]},{"type":"verse","number":23,"content":["ᤂᤧᤏᤧ᤹ ᤁᤧᤛᤠᤵᤐᤥ᤺ᤰᤐᤧᤴ ᤋᤢᤰᤁᤡᤸᤗᤧ ᤆᤫᤠ᤺ᤳᤗᤰ ᤔᤧᤎᤢᤅᤧᤴᤏᤧ᤹ᤀᤥ. ᤁᤖ ᤛᤡᤍᤠ᤹ ᤐᤥ᤺ᤱᤗ ᤑᤠ᤹ᤀᤠᤱ ᤆᤧᤸᤗᤧᤰᤛᤣ᤹ ᤌᤡ᤺ᤴ ᤌᤢᤅᤧ᤹ᤀᤥ॥ ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤧᤏᤧ᤹ᤃ ᤀᤧᤳᤗᤧᤱ ᤁᤧᤍᤢᤰᤁᤠᤱ ᤁᤧᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":24,"content":["ᤁᤢᤓᤠ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤗᤠᤕᤥ᤺ᤱᤃ ᤏᤢ᤺ᤖᤡᤰ ᤌᤠ᤺ᤵᤐᤠᤱ ᤂᤠᤛᤧᤴᤏᤥ ᤔᤧᤎᤠ᤺ᤖᤥ. ᤁᤖ ᤁᤢᤓᤠᤖᤧᤱᤃ ᤕᤠᤱᤛᤡᤖᤰ ᤌᤠ᤺ᤵᤗᤥ॥"]},{"type":"verse","number":25,"content":["ᤒᤠ ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤏᤢ᤺ᤒᤠ ᤕᤠ᤺ᤶᤒᤰᤜᤠ᤹ᤀᤠᤱ ᤏᤢ᤺ᤖᤡᤰᤁᤠᤱ ᤌᤠ᤺ᤵ. ᤁᤖ ᤔᤧᤴᤎᤠ᤺ᤵᤔᤏᤠᤒᤧᤴᤏᤠᤱ ᤆᤡᤱᤛᤡᤱᤔᤠ ᤔᤧᤛᤢᤰᤏᤧᤴᤗᤥ॥"]}],"footnotes":[]},"thisChapterLink":"/api/lif_wbt/1TI/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lif_wbt/1TI/6.json","nextChapterAud