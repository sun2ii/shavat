umber":13,"content":["ᤂᤡᤏᤡ᤹ ᤏᤡ᤺ᤵᤔᤠ ᤁᤧᤴᤇᤢᤰᤋᤢᤶᤔᤡᤶᤒᤠ ᤏᤢ ᤁᤢᤛᤡᤱ ᤏᤡ᤺ᤵᤔᤠ ᤁᤧᤴᤇᤢᤰᤋᤢᤶᤔᤡᤶᤒᤠ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤛᤰᤀᤡᤱᤄᤱᤅᤥ ᤌᤣᤀᤠᤱ ᤔᤧᤛᤠᤵᤋᤢᤶᤒᤧᤴᤗᤥ॥ ᤀᤠᤸᤗᤥ ᤀᤠᤏᤡᤃᤧ ᤕᤠ᤺ᤶᤒᤣᤀᤥ ᤔᤡᤛᤠᤰᤗᤰ ᤁᤢᤛᤡᤱᤃᤧᤴᤏᤡ᤺ᤳᤋᤢᤶ. ᤁᤖ ᤌᤡᤰᤕᤧᤴ ᤂᤡᤏᤡ᤹ ᤁᤠᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤁᤢᤛᤡᤱ ᤏᤡ᤺ᤵᤔᤠ ᤁᤧᤛᤢᤰᤋᤢᤶ ᤁᤧᤗ᤹ᤒᤠ ᤀᤡᤱᤃᤠ᤹ ᤏᤡᤱᤛᤠᤱ ᤆᤥᤃᤢᤱᤗᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤍᤠᤱᤒᤠ ᤕᤧᤛᤢ᤺ᤴ ᤏᤢ᤺ᤱ ᤕᤢ᤺ᤒᤠ ᤕᤧᤴᤏᤥ ᤂᤡᤏᤡ᤹ ᤕᤠ᤺ᤶᤒᤣᤀᤥ ᤘᤣ᤹ ᤔᤏᤠᤜᤠ᤹ ᤏᤢ᤺ᤒᤠ ᤐᤠ᤺ᤴ ᤔᤧᤳᤋᤢᤶᤛᤡᤶᤒᤧᤒᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤂᤡᤏᤡ᤹ᤀᤠᤱ ᤀᤠᤏᤡᤃᤧ ᤕᤠ᤺ᤶᤒᤣᤀᤥ ᤏᤢ᤺ᤒᤠ ᤐᤠ᤺ᤴ ᤁᤧᤈᤧᤰᤋᤢᤶᤛᤡᤶᤗᤥ॥"]},{"type":"verse","number":15,"content":["ᤀᤠᤏᤡ᤹ ᤏᤢ᤺ᤖᤡᤰᤁᤠᤱ ᤁᤢᤛᤡᤱ ᤀᤠᤏᤡ᤺ᤳᤋᤠᤛᤡ ᤁᤧᤗ᤹ᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤛᤧᤰᤂᤠᤀᤣ ᤀᤡᤃᤢ ᤁᤳᤋᤢᤱᤒᤠᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤔᤢ᤹ᤀᤡᤛᤠᤶ ᤁᤧᤄᤥ᤺ᤛᤢᤶᤗ ᤑᤠ᤹ᤀᤠᤱ ᤕᤠᤶᤔᤥ ᤂᤡᤏᤡ᤹ᤀᤥ ᤋᤠ᤺ᤔᤠ ᤏᤡᤱᤘᤠ᤹ ᤆᤥᤃᤢᤱᤅᤠᤱ ᤘᤕᤠᤱᤗᤥ॥"]},{"type":"verse","number":16,"content":["ᤀᤡᤱᤃᤠ᤹ ᤔᤧᤛᤥᤍᤥᤏᤡᤕᤠ ᤋᤧᤱᤃᤵ ᤐᤣ᤺ᤰᤁᤠᤸᤗᤧ ᤂᤡᤏᤡ᤹ᤀᤥ ᤗ᤺ᤶᤔᤠᤖ ᤐᤣ᤺ᤰᤔᤠ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤵᤔᤥᤗᤠᤶ ᤏᤢ᤺ᤱᤅᤠᤀᤡᤸᤗᤧᤀᤠᤱ ᤂᤡᤏᤡ᤹ᤀᤥ ᤗ᤺ᤶᤔᤠ ᤏᤡᤱᤘᤠ᤹ ᤆᤥᤃᤢᤱᤗᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤕᤜᤢᤍᤡᤕᤠ ᤌᤢᤶ ᤐᤣ᤺ᤰᤁᤠᤸᤗᤧ ᤁᤢᤓᤠ᤹ ᤕᤠᤵᤔᤡ ᤁᤧᤒᤡᤖᤡᤖ ᤁᤧᤗ᤹ᤒᤠ ᤏᤡᤱᤘᤠ᤹ ᤆᤥᤃᤢᤱᤅᤠᤱ ᤘᤠ᤹ᤀᤠ॥"]},{"type":"verse","number":17,"content":["ᤂᤡᤏᤡ᤹ᤀᤥ ᤋᤠ᤺ᤔᤠ ᤔᤧᤴᤇᤢᤰᤐᤧᤴ. ᤁᤖ ᤀᤡᤱᤃᤠ᤹ ᤁᤴ ᤜᤏᤧ ᤏᤡᤱᤘᤠ᤹ ᤆᤥᤃᤢᤱᤒᤠ ᤔᤧ᤺ᤴ. ᤜᤧᤰᤁᤩᤠᤱ ᤀᤡᤰᤛᤠᤒᤠ ᤔᤧᤴᤇᤠᤶ ᤕᤠᤵᤔᤡ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤗᤳᤌᤡᤰ ᤔᤢᤖᤠ᤺ᤸᤗᤧ ᤀᤥ ᤏᤢ ᤔᤧ᤺ᤴ ᤗ᤹ᤖᤡᤰ ᤐᤠ᤺ᤵᤔᤠ ᤏᤡᤱᤘᤠ᤹ ᤆᤥᤃᤢᤱᤒᤠ ᤔᤧ᤺ᤴᤗᤥ॥"]},{"type":"verse","number":18,"content":["ᤁᤖ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤏᤛᤠ᤺ᤴᤛᤠᤒᤠ ᤆᤥ᤺ᤰᤐᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤀᤡᤱᤃᤠ᤹ᤀᤠᤱ ᤏᤛᤠ᤺ᤴᤛᤠᤒᤠ ᤆᤥ᤺ᤰᤁᤠ॥ ᤀᤡᤱᤃᤠ᤹ ᤆᤥᤃᤢᤱ ᤏᤢ ᤔᤧᤈᤥᤃᤢᤱᤅᤡᤴ ᤗ᤹ᤖᤡᤰ ᤁᤧᤒᤠ᤺ᤵᤐᤠ ᤔᤏᤠ ᤔᤧ᤺ᤴᤏᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":19,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹. ᤋᤡᤔᤥᤌᤡ ᤏᤢ ᤛᤡᤗᤠᤛᤗᤠᤶᤒᤠ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠ᤺ ᤕᤧᤛᤢ ᤂᤪᤡᤛ᤻ᤋᤧᤴ ᤂᤡᤏᤡ᤹ᤀᤥ ᤀᤡᤱᤓᤥ᤺ᤛᤢᤶᤒᤧᤸᤗᤧ ᤀᤥ ᤏᤢ ᤔᤧ᤺ᤴ ᤁᤧᤗ᤹ᤒᤠ ᤐᤠ᤺ᤴ ᤜᤥ᤺ᤵᤋᤧᤖᤥ॥ ᤁᤖ ᤂᤢᤏᤧ᤹ “ᤀᤥᤖᤥ” ᤐᤠ᤺ᤳᤋᤢᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤆᤥᤃᤢ᤹ᤀᤣᤖᤥ॥"]},{"type":"verse","number":20,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤆᤥᤃᤢᤒᤠ ᤀᤠᤰᤂᤧᤴ ᤔᤠᤱᤜᤧᤰᤜᤠ᤹ᤛᤠᤱ ᤂᤧᤱᤜᤠ᤹ ᤂᤪᤡᤛ᤻ᤋᤀᤥ “ᤀᤥᤖᤥ” ᤐᤥ᤺ᤱᤗᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ᤗᤠᤶᤒᤠᤀᤣ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤔᤡᤔᤡᤍᤡᤱ ᤐᤥ᤺ᤱᤗ ᤑᤠ᤹ᤀᤠᤱ ᤀᤠᤏᤡᤃᤧ “ᤀᤠᤔᤧᤴ”. (ᤀᤥᤖᤥ. ᤜᤧᤰᤁᤣ ᤐᤥ᤺ᤱᤗᤖᤥ). ᤐᤠ᤺ᤳᤋᤢᤶᤒᤧᤖᤥ॥"]},{"type":"verse","number":21,"content":["ᤀᤠᤸᤗ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤂᤪᤡᤛ᤻ᤋᤧᤴᤏᤢ ᤛᤥᤖᤡᤰ ᤀᤠᤏᤡ᤹ ᤁᤧᤖᤧᤰ ᤁᤧᤎᤢᤶᤒᤠ ᤀᤠᤈᤥ᤺ᤰ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ᤀᤣ ᤕᤠᤵᤔᤡ ᤔᤠᤱᤎᤥ᤺ᤰᤏᤠ ᤀᤠᤒᤡᤖᤧᤀᤠᤱ"]},{"type":"verse","number":22,"content":["ᤀᤠᤏᤡ᤹ ᤂᤢᤏᤧ᤹ᤀᤡᤴ ᤑᤠ᤹ᤀᤠᤱ ᤀᤥᤛᤣ᤺ᤴᤎᤠᤰᤔᤠᤖᤧ ᤗᤠᤃᤡ ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤴ ᤋᤧᤴᤕᤠᤱ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤀᤠᤏᤡ᤹ ᤛᤡᤰᤗᤢᤱᤔᤥ ᤀᤠᤒᤡᤖᤧᤀᤠᤱ ᤀᤠᤘᤠ᤹ᤖᤥ॥ ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤴ ᤀᤠᤒᤡᤖᤧᤒᤠᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤁᤠ