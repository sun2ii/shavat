ntent":["ᤅᤠᤛᤡ ᤗᤧᤱ ᤕᤜᤢᤍᤡᤜᤠ᤹ᤖᤧ ᤀᤡᤱᤃᤠ᤹ ᤛᤢᤶ-ᤑᤠᤱ (᥉᥏) ᤌᤠᤖᤡᤰ ᤋᤧ᤺ᤶᤓᤢᤰ ᤔᤧᤕᤠᤰᤋᤠᤱ."]},{"type":"verse","number":25,"content":["ᤛᤢᤶᤗᤧᤱ ᤖᤥᤔᤡᤜᤠ᤹ᤖᤧ ᤋᤰᤁᤠ᤺ᤳᤋᤡᤸᤗᤧ ᤔᤧᤜᤡᤵᤋᤠᤱ. ᤌᤡᤰᤗᤧᤱ ᤏᤡᤱᤔᤡᤜᤠ᤹ᤖᤧ ᤗᤢᤱᤅᤡᤸᤗᤧ ᤔᤧᤒ᤺ᤳᤋᤠᤱ. ᤛᤢᤶᤗᤧᤱ ᤀᤡᤱᤃᤠ᤹ ᤗᤠᤶᤍᤡ᤺ᤰ ᤆᤥᤃᤠᤱᤒᤠ ᤘᤠᤗᤠᤎᤠ᤺ᤴ ᤏᤡᤒᤧ. ᤜᤧᤰᤁᤩᤠᤱ ᤌᤡᤰᤗᤧᤱ ᤌᤡᤰ ᤕᤧᤴ ᤏᤢ ᤌᤡᤰ ᤛᤧᤴᤍᤡᤰ ᤂᤠᤖᤠᤰ ᤀᤡᤱᤃᤠ᤹ ᤘᤖᤰᤁᤥᤀᤣ ᤕᤠᤃᤠᤱᤗᤥ॥"]},{"type":"verse","number":26,"content":["ᤀᤡᤱᤃᤠ᤹ᤃ ᤕᤖᤡᤰᤗᤧᤱ ᤗᤠᤶᤍᤡ᤺ᤰ ᤆᤥᤃᤠᤱᤅᤡᤸᤗᤧ ᤘᤠᤜᤱᤅᤥ ᤜᤧᤰᤁᤩᤠᤱ ᤑᤠ᤺ᤴᤍᤠᤜᤠ᤹ᤗᤠᤶᤒᤠ. ᤀᤠᤒᤠᤅᤣ ᤗᤠᤈᤣ᤹ᤛᤠᤒᤠᤜᤠ᤹ ᤏᤢ ᤌᤡᤶᤔᤧᤴᤍᤱ ᤛᤢᤘᤠᤱᤜᤠ᤹ᤗᤠᤶᤒᤠ ᤁᤧᤛᤠᤰᤐᤠ ᤋᤢᤰᤂᤣᤜᤠ᤹ ᤋᤢᤔᤢᤱᤗᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤕᤧᤰᤕᤰᤁᤥ. ᤕᤧ᤺ᤱᤄᤠᤍᤧᤴᤏᤥ. ᤘᤖᤰᤁᤥᤒᤠ ᤁᤡᤵᤔᤠ ᤁᤧᤄᤢ᤺ᤒᤠ ᤛᤢᤖᤡᤳ ᤁᤣᤈᤱᤅᤥ. ᤜᤧᤰᤁᤩᤠᤱ ᤑᤥᤋᤩᤠᤒᤠ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ᤗᤠᤶᤒᤠᤀᤠᤱ ᤁᤧᤛᤠᤰᤐᤠ ᤋᤢᤰᤂᤣᤜᤠ᤹ ᤋᤢᤔᤢᤱᤅᤠᤱ ᤘᤠ᤹ᤀᤠᤖᤥ॥"]},{"type":"verse","number":27,"content":["ᤀᤡᤱᤃᤠ᤹ᤃ ᤕᤠᤶᤒᤢᤎᤡᤰᤁᤠᤱ ᤕᤠ᤺ᤶᤒᤰ ᤆᤥᤃᤠᤱ ᤜᤧᤰᤁᤩᤠᤱ ᤕᤖᤡᤰᤗᤧᤱ ᤛᤧᤴᤍᤡᤰ ᤔᤧᤀᤡᤵᤛᤠᤱᤅᤡᤴᤗᤥ॥ ᤛᤧᤳᤗᤠ᤺ᤰᤔᤠ ᤏᤢ ᤘᤠᤔᤡ᤺ᤔᤠᤸᤗᤧ ᤋᤖᤠᤱ ᤜᤧᤰᤁᤩᤠᤱ ᤕᤖᤡᤰᤗᤧᤱ ᤌᤣᤀᤠᤱ ᤆᤠᤔᤠ ᤌᤢᤱᤔᤠ ᤔᤧᤱᤄᤥ᤺ᤒᤠᤴᤗᤥ॥ ᤆᤢᤱᤅᤡᤸᤗᤧ ᤌᤳᤋᤠᤱ ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤁᤧᤃᤥ᤺ᤒᤠ ᤆᤠᤱᤍᤣ᤺ᤳ ᤔᤧᤱᤃᤵᤐᤧᤴᤗᤥ॥"]},{"type":"verse","number":28,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤴ ᤋᤢᤰᤂᤣᤜᤠ᤹ᤖᤰ ᤔᤧ᤺ᤴ. ᤁᤖ ᤁᤠᤰ ᤛᤣᤛᤣᤜᤢᤵᤗᤰᤜᤠ᤹ᤖᤧ ᤗᤠᤃᤡᤀᤠᤱ ᤌᤡᤰᤕᤠ᤺ᤴᤎᤰ ᤏᤡᤱᤛᤠᤶᤔᤥ ᤌᤩᤠᤱᤅᤠᤱ ᤀᤠᤏᤡᤱᤘᤠ᤹ᤒᤥ ᤋᤢᤰᤂᤣ ᤆᤩᤠᤱᤗᤥ॥"]},{"type":"verse","number":29,"content":["ᤜᤠ᤺ᤳᤋᤠᤱ ᤏᤛᤠ᤺ᤴᤏᤥ ᤁᤧᤎᤢᤶᤒᤠ ᤔᤧᤈᤥ᤺ᤰᤏᤧᤴᤏᤡᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ᤀᤠᤱ ᤀᤠᤗᤢᤱᤔᤠ᤹ ᤛᤩᤠ᤺ᤳ ᤗ᤹ᤖᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤘᤣ᤹ᤜᤠ᤹ ᤗᤠᤕᤥᤀᤥ ᤔᤧᤎᤠ᤺ᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ ᤛᤠ᤹ᤖᤡᤰ ᤀᤠᤏᤡᤱᤘᤠ᤹ ᤋᤢᤰᤗᤥ॥"]},{"type":"verse","number":30,"content":["ᤀᤡᤱᤃᤠ᤹ ᤆᤶᤛᤡᤱᤔᤠᤀᤣ ᤐᤥ᤺ᤱᤏᤧ ᤑᤠ᤹ᤃᤪ ᤀᤡᤱᤃᤠ᤹ ᤁᤧᤎᤢᤶᤒᤠ ᤔᤧᤈᤥ᤺ᤰᤁᤠᤴ ᤗ᤹ᤖᤡᤰ ᤀᤥᤛᤣ᤺ᤴᤍᤠᤱ ᤁᤧᤈᤥ᤺ᤰᤐᤠ ᤐᤠ᤺ᤴᤜᤠ᤹ᤀᤥᤏᤧ ᤆᤶᤛᤡᤱᤅᤠᤖᤥ॥"]},{"type":"verse","number":31,"content":["ᤛᤍᤠᤍᤡᤱ ᤏᤧᤶᤓᤥᤃᤧᤴ ᤁᤢᤏᤠᤖᤠ ᤑᤥ᤺ᤔᤏᤠᤒᤠ ᤍᤠᤱᤒᤠ ᤕᤧᤛᤢᤖᤧ ᤐᤠᤏᤢᤍᤡᤱ ᤁᤢᤶᤒᤠ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ ᤀᤡᤱᤗᤧᤰ ᤔᤧᤒᤠ᤺ᤳᤋᤢᤱᤅᤡᤴ ᤑᤠ᤹ᤀᤠᤱ ᤏᤡ᤺ᤛᤢ᤹ᤖᤥ॥"]},{"type":"verse","number":32,"content":["ᤍᤔᤛ᤻ᤁᤛ ᤕᤧᤰᤕᤰᤁᤥ ᤘᤕᤠᤱᤅᤡᤸᤗᤧ ᤀᤖᤡᤋᤛ ᤜᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤛᤢᤜᤠᤱᤕᤢᤰᤐᤠᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ ᤀᤠᤍᤧᤶᤛᤧ ᤕᤧᤰᤕᤰᤁᤥ ᤌᤰᤛᤢᤒᤠᤜᤠ᤹ ᤕᤧᤵᤛᤢᤛᤡᤖᤥ॥"]},{"type":"verse","number":33,"content":["ᤁᤖ ᤀᤡᤱᤃᤠ᤹ᤃ ᤗᤢᤶᤓᤢ᤹ᤀᤥ ᤔᤧᤕᤠᤰᤋᤠᤱᤅᤠᤱ ᤕᤧᤰᤕᤰᤗᤧᤴ ᤗᤢᤱᤎᤠᤰᤁᤥᤒᤠ ᤐᤣᤎᤠ᤺ᤵᤗᤠᤶᤒᤠ ᤕᤥ ᤗᤠ᤺ᤰᤁᤠᤳ ᤔᤧᤎᤠᤛᤠᤱ ᤔᤧᤗ᤺ᤳᤋᤠᤱᤗᤥ॥ ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤁᤢᤜᤢᤰᤁᤥ ᤔᤧᤴᤎᤠᤒᤠᤴᤗᤥ॥"]}],"footnotes":[{"noteId":12,"caller":"*","text":"ᤜᤘᤠ–ᤌᤡᤰᤛᤡᤃᤣ᤺ᤰᤛᤔᤠ ᤔᤧᤴᤇᤡᤔᤠ᤹॥ ᤔᤠᤑᤧᤴᤛᤠᤶᤔᤡᤴ ᤀᤛᤣ᤺ᤰ ᤗᤧᤱᤛᤡᤱᤅᤠᤱ ᤜᤘᤠ᤺ᤸᤗᤥ ᤀᤥᤛᤣ᤺ᤴᤎᤠᤰᤛᤡᤱᤅᤠᤱ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤂᤧᤴ ᤛᤡᤱᤛᤣ᤹ᤀᤡᤴ ᤆᤠᤔᤠ ᤔᤧᤏᤢ᤹ᤏᤧᤴ ᤑᤠ᤹ᤀᤠᤱ ᤐᤠ᤺ᤳᤋᤢᤒ