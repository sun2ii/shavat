:["ᤂᤪᤡᤛ᤻ᤋᤧᤴ ᤔᤧᤴᤏᤡ ᤔᤧᤴᤎᤠ᤺ᤵ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤀᤡ᤺ᤳᤗᤥ॥ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤠᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤆᤥ᤺ᤰᤔᤠᤏᤢ᤺ᤸᤗᤧ ᤋᤃᤡᤀᤣ ᤂᤢᤏᤧ᤹ ᤘᤕᤧ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ᤀᤣ ᤁᤠᤰ ᤏᤠᤘᤠᤃᤧᤴ ᤆᤀᤡ᤺ᤳ ᤛᤶᤍᤠᤱ ᤕᤢᤰᤛᤠᤒᤠ ᤆᤥ᤺ᤰᤗᤥ॥"]},{"type":"verse","number":16,"content":["ᤂᤪᤡᤛ᤻ᤋᤗᤠᤶ ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱ ᤏᤢ ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥᤒᤠ ᤁᤠᤰ ᤏᤠᤘᤠᤃᤧᤴ ᤆᤀᤡ᤺ᤳ ᤏᤧᤛ᤻ᤛᤢᤒᤠᤖᤥ॥ ᤂᤢᤏᤧ᤹ᤃ ᤏᤡᤃᤧᤎᤠ᤺ᤵᤐᤠ ᤏᤢ ᤏᤡᤔᤧᤴᤎᤠ᤺ᤵᤔᤏᤠ ᤐᤠ᤺ᤴᤜᤠ᤹. ᤜᤠᤱᤜᤠ᤹ ᤏᤢ ᤜᤠᤱᤈᤢᤶᤜᤠ᤹. ᤜᤠᤱᤃᤧᤈᤥ᤺ᤰᤐᤠᤜᤠ᤹ ᤏᤢ ᤕᤢᤰᤛᤠᤒᤠᤜᤠ᤹ᤀᤠᤱ ᤆᤥᤃᤢᤛᤡᤒᤠᤖᤥ॥ ᤁᤠᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ᤖᤧᤴ ᤏᤠᤘᤠᤃᤧᤴ ᤆᤀᤡ᤺ᤳᤋᤡᤴ ᤂᤪᤡᤛ᤻ᤋᤗᤠᤶ ᤏᤢ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤁᤢᤗᤠᤃᤡᤀᤣ ᤐᤥ᤺ᤰᤂᤧᤒᤠᤖᤥ॥"]},{"type":"verse","number":17,"content":["ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤏᤠᤘᤠᤃᤧᤴ ᤆᤀᤡ᤺ᤳ ᤏᤧᤔᤠᤏᤢ᤺ᤸᤗᤧ ᤋᤃᤡᤀᤣ ᤂᤢᤏᤧ᤹ ᤘᤕᤧ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ᤀᤥ ᤁᤠᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤛᤥᤛᤥᤖᤡᤰ ᤜᤢᤵᤛᤡᤱᤅᤠᤱ ᤐᤳᤗᤥ॥"]},{"type":"verse","number":18,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤁᤢᤎᤰᤁᤡᤴ ᤛᤣᤛᤣᤜᤢᤵᤗᤰᤗᤥ. ᤂᤧᤴ ᤛᤣᤛᤣᤜᤢᤵᤗᤰᤁᤡᤸᤗᤧ ᤁᤢᤎᤧᤃᤣ᤺ᤰᤐᤠᤱᤃ ᤂᤢᤏᤧ᤹ᤀᤣᤖᤥ॥ ᤂᤢᤏᤧ᤹ᤃ ᤋᤥᤗᤡᤱᤛᤥᤔᤢ. ᤜᤧᤰᤁᤩᤠᤱ ᤛᤡ᤺ᤔᤧᤴᤗᤠᤶ ᤕᤠᤶᤔᤥ ᤁᤧᤜᤡᤱᤒᤠ ᤁᤠᤰᤁᤥ ᤋᤢᤶᤒᤠᤖᤥ. ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰᤁᤣ ᤂᤢᤏᤧ᤹ ᤁᤠᤰ ᤛᤶᤍᤠᤱ ᤕᤢᤰᤛᤠᤒᤠ ᤆᤥ᤺ᤰᤗᤥ॥"]},{"type":"verse","number":19,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤠᤰ ᤁᤢᤗᤡᤱᤎᤥ ᤁᤧᤵᤔᤠᤴ ᤕᤧᤛᤢ ᤂᤪᤡᤛ᤻ᤋᤀᤥ ᤏᤧᤔᤠ ᤁᤢᤛᤡᤖᤠ᤹ ᤌᤠᤅᤧᤖᤥ॥"]},{"type":"verse","number":20,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤛᤡᤗᤠᤶᤛᤠᤰᤔᤠ ᤛᤡᤱᤛᤶᤍᤠᤱ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤔᤠᤰᤂᤡ᤹ᤀᤡᤴ ᤘᤠᤍᤣ᤺ᤴᤍᤢᤒᤠᤀᤥᤗᤠᤶᤒᤠ ᤀᤠᤒᤠᤅᤣᤗᤠᤃᤡ ᤛᤏᤠᤖᤢᤱ ᤆᤥᤃᤢᤀᤠᤱ ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰ ᤏᤢ ᤋᤠᤱᤛᤠᤰᤐᤥᤒᤠ ᤁᤧᤖᤧᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤕᤠᤶᤔᤥ ᤀᤠᤒᤠᤅᤣ ᤂᤢᤏᤧ᤹ᤀᤥ ᤏᤠᤍᤱ ᤆᤥᤃᤢᤀᤠᤱ ᤏᤢ᤺ᤰᤋᤢ ᤋᤠᤖᤢᤖᤥ॥"]},{"type":"verse","number":21,"content":["ᤐᤣᤒᤠ ᤕᤧᤶᤔᤥ ᤂᤡᤏᤡ᤹ ᤑᤧᤴ ᤕᤠ᤺ᤶᤒᤰᤁᤡᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤂᤡᤏᤡ᤹ ᤏᤡᤱᤘᤠ᤹ᤀᤥ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤏᤡᤱᤔᤡ ᤁᤧᤒᤥ᤺ᤰᤂᤡᤀᤠᤱ ᤁᤧᤘᤕᤡᤖᤥ॥ ᤂᤡᤏᤡ᤹ ᤂᤢᤏᤧ᤹ᤗᤠᤶᤒᤠ ᤁᤧᤛᤧᤴᤍᤡᤀᤠᤱ ᤔᤠ᤺ᤱᤄᤠ ᤁᤧᤘᤕᤡᤖᤥ॥"]},{"type":"verse","number":22,"content":["ᤁᤖ ᤀᤠᤸᤗᤥᤃ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤀᤠᤒᤠᤅᤣ ᤁᤢᤍᤃᤡ ᤛᤣᤛᤣᤛᤠᤱᤛᤠᤱ ᤏᤢ ᤀᤠᤵᤋᤡᤰ ᤔᤧ᤺ᤴᤏᤣᤒᤠ ᤆᤥ᤺ᤰᤔᤠᤛᤡ ᤑᤠ᤹ᤀᤠᤱ ᤕᤧᤛᤢ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤁᤢᤛᤡᤗᤠᤶᤛᤠᤰᤔᤠ ᤛᤡᤱᤛᤶᤍᤠᤱᤒᤠ ᤁᤢᤛᤡ᤺ᤔᤧᤴᤗᤠᤶᤒᤠ ᤏᤠᤍᤱᤅᤥ ᤁᤧᤍᤠ᤺ᤖᤡᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":23,"content":["ᤁᤖ ᤂᤡᤏᤡ᤹ ᤁᤧᤄᤧᤵᤛᤢᤶᤒᤠ ᤛᤢᤏᤠᤀᤡᤱᤅᤡᤸᤗᤧ ᤏᤡᤱᤛᤠᤱᤅᤥ ᤔᤧᤶᤔᤢᤴᤏᤣ ᤏᤢ ᤋᤠᤵᤔᤧᤶᤒᤧ᤹ᤀᤣ ᤜᤧᤰᤁᤩᤠᤱ ᤆᤰᤔᤧᤸᤗ᤹ᤀᤣ ᤏᤛᤠ᤺ᤴ ᤆᤥ᤺ᤰᤔᤠᤀᤣ ᤐᤥ᤺ᤱᤗᤥ॥ ᤜᤠᤒᤠ ᤁᤴ ᤛᤢᤏᤠᤀᤡᤱᤅᤡᤴ ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥᤒᤠ ᤁᤠᤰ ᤔᤧᤴᤇᤠᤶ ᤛᤢᤘᤠᤱᤜᤠ᤹ᤀᤥ ᤀᤡᤱᤔᤧᤓᤥ᤺ᤛᤢᤀᤠᤱ ᤘᤠ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤴ ᤛᤢᤏᤠᤀᤡᤱᤅᤡᤴ ᤀᤡᤱᤓᤥ᤺ᤔᤠ ᤑᤠ᤹ᤀᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤐᤠᤘᤗᤧᤴ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤛᤣᤘᤠᤖᤥᤒᤠ ᤐᤥ᤺ᤰᤂᤠᤱᤗᤥ॥"]},{"type":"heading","content":["ᤐᤠᤘᤗᤖᤧ ᤛᤣᤛᤣᤜᤢᤵᤗᤰᤁᤡᤸᤗᤧ ᤗᤠᤃᤡ ᤆᤥᤃᤢᤒᤠ ᤕᤠᤶᤒᤢᤎᤡᤰ"]},{"type":"verse","number":24,"content":["ᤕᤧᤛᤢ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤁᤢᤎᤰᤁᤡᤱᤃ ᤛᤣᤛᤣᤜᤢᤵᤗᤰᤗᤥ. ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ᤃ ᤂᤡᤏᤡ᤹ ᤗᤠᤃᤡ ᤀᤡᤏᤥᤃᤧᤴ ᤋᤢᤰᤂᤣᤜᤠ᤹ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤀᤠᤎᤰᤁᤥ ᤌᤶᤔᤠ ᤛ᤺ᤳᤋᤠᤖᤥ॥ ᤌᤶᤔᤠ ᤁᤧᤒᤥ᤺ᤱᤒᤠ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤀᤡᤏᤥᤃᤧᤴ ᤁᤢᤍᤢᤰᤂᤣᤜᤠ᤹ ᤀᤡᤱᤃᤠ᤹ ᤌᤖᤢᤱᤗᤥ॥"]},{"type":"verse","number":25,"content":["ᤀᤡᤱᤃᤠ᤹ ᤛᤣᤛᤣᤜᤢᤵᤗᤰᤗᤧᤴ ᤛᤣᤘᤠᤖᤥᤒᤠ ᤐᤥ᤺ᤰᤂᤠᤱᤗᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰᤁᤡᤴ ᤁᤠᤰ ᤁᤢᤎᤡᤶᤔᤥ ᤂᤡᤏᤡ᤹ᤀᤥ ᤀᤡᤱᤓᤥ᤺ᤛᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ ᤛᤣ᤺ᤰᤕᤢᤰ ᤆᤥᤃᤠᤱᤅᤠᤱ ᤘᤠ᤹ᤀᤠᤖᤥ"]},{"type":"verse","number":26,"content":["ᤁᤴ ᤛᤡᤒᤡ᤹ ᤐᤠ᤺ᤴᤜᤠ᤹ᤃ ᤀᤢᤏᤠᤜᤢᤖᤡᤀᤠᤱᤎᤥ ᤐᤣᤒᤠ ᤔᤧᤴᤇᤠᤶ ᤌᤠ᤺ᤰᤜᤠ᤹ᤀᤥ ᤆᤡᤰᤂᤢᤀᤠᤱ ᤘᤕᤧ. ᤁᤖ ᤀᤠᤸᤗᤥ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤛᤣᤛᤣ ᤁᤢᤔᤏᤠᤜᤠ᤹ ᤀᤥ᤺ᤴᤎᤠᤰᤋᤢᤛᤡᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":27,"content":["ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤔᤏᤠᤜᤠ᤹ ᤁᤢᤔᤡᤔᤡᤍᤡᤱᤃᤧᤴ ᤀᤡᤔᤧᤸᤗᤢᤱᤒᤠ ᤛᤡᤒᤡ᤹ ᤐᤠ᤺ᤴᤏᤡᤴ ᤌᤡᤶᤔᤧᤴᤍᤱ ᤛᤢᤘᤠᤱᤜᤠ᤹ ᤀᤥᤛᤣ᤺ᤴᤍᤠᤱ ᤆᤥ᤺ᤰᤔᤠ ᤂᤢᤏᤧ᤹ ᤁᤢᤛᤡᤖᤠ᤹ ᤌᤠᤅᤧᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥ ᤂᤪᤡᤛ᤻ᤋᤧᤴ ᤂᤡᤏᤡ᤹ᤀᤥ ᤘᤠ᤹ᤒᤠᤴᤏᤣ ᤛᤡᤒᤡ᤹ ᤐᤠ᤺ᤴᤗᤥ. ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤁᤧᤍᤠ᤺ᤒᤠ ᤁᤢᤔᤡᤔᤡᤍᤡᤱᤃᤧᤴ ᤗᤰᤁᤡᤴ ᤂᤡᤏᤡ᤹ ᤁᤧᤄᤥ᤺ᤛᤢᤶᤗᤥ॥"]},{"type":"verse","number":28,"content":["ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤀᤠᤳᤋᤡ ᤐᤡᤃᤡᤃᤧ᤹ᤛᤠᤱ ᤁᤠᤰ ᤔᤏᤠᤜᤠ᤹ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤁᤢᤕᤠ᤺ᤶᤒᤣᤀᤥ ᤀᤡᤱᤓᤥ᤺ᤛᤢᤶᤛᤡᤶᤒᤧ᤹ᤖᤥ॥ ᤂᤧᤱᤜᤠ᤹ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤐᤡᤖᤡᤃᤧᤒᤠ ᤁᤠᤰ ᤛᤡᤰᤁᤢᤶᤔᤡᤸᤗᤧ ᤛᤠᤶᤍᤡᤱ ᤏᤢ ᤂᤠᤜᤢᤴ ᤐᤡᤖᤢᤶᤛᤡᤶᤒᤧ᤹. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤪᤡᤛ᤻ᤋᤧᤴᤏᤢ ᤌᤡᤰᤜᤢᤵ ᤐᤥ᤺ᤱᤔᤠᤴ ᤁᤢᤗᤡᤱᤎᤥ ᤁᤧᤳᤗ ᤗ᤹ᤖᤡᤰ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤥ ᤁᤠᤰ ᤔᤧᤴᤇᤠᤶ ᤕᤠᤵᤔᤡᤜᤠ᤹ ᤋᤥ᤺ᤶᤔᤠᤛᤡ ᤀᤠᤏᤡᤃᤧ ᤏᤡᤱᤘᤠ᤹ ᤁᤳᤋᤢᤶᤒᤧᤖᤥ॥"]},{"type":"verse","number":29,"content":["ᤁᤴ ᤕᤠ᤺ᤶᤒᤰᤁᤥ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤐᤡᤖᤠᤱᤒᤠ ᤀᤠᤛᤡᤃᤠᤱ ᤕᤠ᤺ᤶᤒᤰ ᤁᤧᤈᤥ᤺ᤰᤐᤠ ᤐᤕᤶ ᤕᤶᤒᤠ ᤔᤢᤰᤛᤠᤶᤗᤠᤶ ᤕᤠᤶᤒᤢᤎᤡᤰᤁᤠᤱ ᤛᤩᤠᤱᤔᤧᤴᤍᤠᤱ ᤐᤳᤋᤠᤖᤥ॥"]}],"footnotes":[{"noteId":0,"caller":"*","text":"-2 ᤁᤗᤛ᤻ᤛᤡ–ᤁᤴ ᤕᤧᤰᤕᤰᤁᤡᤴ ᤀᤢᤴᤇᤣ᤺ᤴᤒᤠ ᤕᤧᤶᤔᤥ ᤀᤣᤛᤡᤕᤠ ᤔᤠᤀᤡᤏᤖᤒᤠ ᤗᤳᤇᤠ ᤁᤧᤕᤧᤰᤐᤠ ᤕᤧᤰᤕᤰ (ᤀᤰᤂᤣ᤺ᤸᤗᤧ ᤋᤷᤁᤡ ᤔᤧᤔᤧᤳᤋᤢ) ᤘᤕᤧᤖᤥ॥ ᤐᤠᤘᤗᤖᤧ ᤀᤣᤑᤡᤛᤛᤀᤥ ᤛᤢᤏᤠᤀᤡᤱ ᤜᤢ᤹ᤖᤢᤛᤡᤸᤗᤧ ᤂᤧᤵᤔᤥ ᤀᤣᤐᤠᤑᤪᤠᤛ ᤔᤧᤵᤔᤏᤠᤒᤠ ᤔᤏᤠᤎᤡᤰ ᤘᤕᤧ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤀᤣᤐᤠᤑᤪᤠᤛᤧᤴ ᤁᤗᤛ᤻ᤛᤡ ᤕᤧᤰᤕᤰᤁᤥ ᤐᤣᤀᤠᤱ ᤂᤧᤵᤔᤥᤒᤠ ᤔᤏᤠᤜᤠ᤹ ᤛᤢᤏᤠᤀᤡᤱ ᤜᤢ᤹ᤖᤢᤛᤡ॥","reference":{"chapter":1,"verse":1}}]},"thisChapterLink":"/api/lif_wbt/COL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lif_wbt/COL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lif_wbt/PHP/4.json","previousChapterAudioLinks":{},"numberOfVerses":28}