heading","content":["ᤆᤰᤔᤧᤸᤗ᤹ᤀᤣ ᤂᤪᤡᤛ᤻ᤋᤀᤥ ᤜᤡᤱᤔᤠ"]},{"type":"verse","number":6,"content":["ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤀᤠᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤂᤪᤡᤛ᤻ᤋ ᤕᤧᤛᤢ ᤍᤠᤱᤒᤧᤴ ᤏᤛᤠ᤺ᤴ ᤁᤧᤈᤥᤃᤢᤶ ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰᤁᤣ ᤂᤢᤏᤧ᤹ᤏᤢ ᤌᤡᤰᤜᤢᤵ ᤐᤥ᤺ᤰᤂᤧᤶᤔᤧ᤹ᤀᤠᤱ ᤆᤰᤔᤧᤸᤗ᤹ᤀᤣ ᤜᤡᤅᤧᤶᤔᤧ᤹ᤀᤥ॥"]},{"type":"verse","number":7,"content":["ᤂᤢᤏᤧ᤹ᤀᤥ. ᤁᤧᤜᤢ᤹ᤀᤠᤛᤡᤒᤠ ᤏᤡᤛᤠᤶᤔᤥ. ᤛᤠ᤺ᤵ ᤗᤣ᤺ᤳᤋᤧᤶᤔᤧ᤹ᤀᤠᤱ ᤐᤥ᤺ᤖᤧᤶᤔᤧ᤹. ᤏᤛᤠ᤺ᤴᤏᤥ ᤁᤧᤎᤢᤶᤒᤠ ᤐᤥ᤺ᤰᤂᤧᤶᤔᤧ᤹ᤖ ᤍᤠᤱᤒᤠᤴ ᤛᤍᤠᤍᤡᤱ ᤏᤥᤃᤧᤴ ᤐᤡᤖᤧᤶᤔᤧ᤹ᤀᤥ॥"]},{"type":"verse","number":8,"content":["ᤛᤡᤱᤛᤡᤱ ᤗ᤹ᤖᤧᤶᤔᤧ᤹ᤀᤥ. ᤔᤧ᤺ᤱᤃᤪ ᤔᤧᤴᤇᤠᤶ ᤕᤠᤵᤔᤡᤖᤧ ᤔᤧᤈᤥᤃᤢᤒᤠ ᤁᤢᤄᤧᤶᤃᤧᤏᤢ᤹ᤒᤠ ᤀᤡᤱᤗᤧᤰᤐᤠ ᤏᤡᤛᤠᤶᤜᤠ᤹ᤖᤧ ᤁᤧᤕᤢᤰᤋᤡ᤹ᤖᤥ॥ ᤂᤧᤴ ᤏᤡᤛᤠᤶᤜᤠ᤹ᤃ ᤂᤪᤡᤛ᤻ᤋᤗᤠᤶ ᤔᤧ᤺ᤴ. ᤁᤖ ᤔᤧᤴᤇᤠᤶᤌᤠ᤺ᤰᤗᤠᤶ ᤁᤧᤕᤢ᤺ᤒᤠ ᤌᤡᤶ ᤏᤢ ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥᤒᤠ ᤁᤢᤜᤣ᤺ᤰᤛᤡᤱᤔᤥᤒᤠ ᤜᤏᤧᤒᤠ ᤂᤠᤜᤢᤴᤗᤠᤶ ᤁᤧᤍᤠ᤺ᤒᤠᤖᤰᤗᤥ॥"]},{"type":"verse","number":9,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤪᤡᤛ᤻ᤋᤀᤥᤖᤰ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤌᤰᤁᤥ ᤁᤢᤗᤡᤱᤎᤥ ᤁᤧᤳᤗᤥ॥"]},{"type":"verse","number":10,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ᤀᤥᤀᤣ ᤂᤡᤏᤡ᤹ ᤁᤢᤗᤡᤱᤎᤥ ᤁᤧᤵᤔᤠᤴ ᤁᤧᤄᤥ᤺ᤛᤢᤶᤔᤠᤱ ᤘᤠ᤹ᤖᤥ॥ ᤂᤢᤏᤧ᤹ᤃ ᤁᤠᤰ ᤔᤢᤰᤛᤠᤶ ᤏᤢ ᤕᤢᤰ ᤛᤶᤍᤠᤱ ᤕᤢᤰᤛᤠᤒᤠᤖᤥ॥"]},{"type":"verse","number":11,"content":["ᤜᤷᤍᤥ ᤜᤧᤰᤔᤠᤸᤗᤧ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤌᤰᤗᤠᤶ ᤏᤧᤰᤛᤠ ᤛᤧᤶᤒᤣ᤺ᤰᤐᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤁᤢᤜᤷᤍᤥ ᤜᤧᤰᤔᤠᤸᤗᤧ ᤂᤡᤏᤡ᤹ ᤗᤠᤕᤥ ᤆᤥ᤺ᤰᤔᤠ ᤏᤡᤱᤘᤠ᤹ᤀᤡᤴ ᤛᤧᤴᤍᤢᤍᤣ᤹ᤖᤢᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥ ᤁᤱᤃ ᤔᤧᤴᤇᤠᤶ ᤜᤢᤰᤁᤥᤗᤠᤶ ᤐᤥ᤺ᤰᤂᤧᤒᤠ ᤔᤧ᤺ᤴ. ᤁᤖ ᤂᤪᤡᤛ᤻ᤋᤗᤠᤶ ᤐᤥ᤺ᤰᤂᤧᤒᤠᤖᤥ॥"]},{"type":"verse","number":12,"content":["ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤁᤧᤒᤥ᤺ᤰᤂᤡᤸᤗᤧ ᤂᤪᤡᤛ᤻ᤋᤧᤴᤏᤢ ᤛᤥᤖᤡᤰ ᤁᤧᤜᤢᤔᤡ. ᤜᤧᤰᤁᤩᤠᤱ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤂᤢᤏᤧ᤹ ᤁᤢᤛᤡᤘᤧᤳᤗᤠᤶ ᤁᤢᤜᤡᤱᤘᤧᤳ ᤆᤥᤃᤢᤒᤠ ᤔᤢᤰᤛᤠᤶᤔᤥ ᤂᤡᤏᤡ᤹ ᤏᤛᤠ᤺ᤴ ᤁᤧᤈᤥᤃᤢᤶᤒᤠᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤂᤢᤏᤧ᤹ᤏᤢ ᤛᤥᤖᤡᤰ ᤁᤧᤜᤡᤅᤡᤀᤠᤱ ᤁᤧᤘᤕᤡ᤹ᤖᤥ॥"]},{"type":"verse","number":13,"content":["ᤂᤡᤏᤡ᤹ᤃ ᤗᤠᤕᤥᤒᤠ ᤏᤢ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤔᤏᤠ ᤁᤧᤜᤥ᤺ᤵᤋᤡᤒᤠᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤂᤡᤏᤡ᤹ ᤕᤠᤶᤛᤠᤶᤔᤥ ᤁᤢᤛᤡᤘᤧᤳ ᤁᤧᤘᤕᤡ. ᤁᤖ ᤀᤠᤸᤗᤥᤃ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤜᤡᤱᤘᤧᤳ ᤁᤧᤈᤥᤃᤡᤀᤠᤱ ᤁᤧᤘᤕᤡ᤹ᤖᤥ॥ ᤂᤢᤏᤧ᤹ ᤀᤠᤏᤡ᤹ ᤁᤠᤰ ᤗᤠᤕᤥᤜᤠ᤹ ᤗᤧᤵᤔᤡ ᤀᤠᤒᤡᤖᤧᤀᤠᤱ ᤘᤠ᤹॥"]},{"type":"verse","number":14,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤀᤠᤏᤡ᤹ ᤋᤰᤗᤧᤱᤘᤠᤀᤥ ᤁᤧᤒᤵᤐᤠ ᤀᤠᤵᤋᤡᤰ ᤛᤰᤜᤠ᤹ ᤌᤧ᤺ᤰᤂᤢᤍᤣ᤺ᤛᤢᤀᤠᤱ ᤂᤢᤏᤧ᤹ ᤂᤧᤴ ᤁᤧᤖᤧᤰ ᤛᤡᤗᤠᤶᤛᤠᤰᤔᤠ ᤛᤡᤱᤛᤶᤍᤠᤱ ᤂᤡᤵᤛᤢᤀᤠᤱ ᤂᤧᤳᤋᤢᤍᤣ᤺ᤛᤢᤖᤥ॥"]},{"type":"verse","number":15,"content":["ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰᤁᤣ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤑᤧᤴᤛᤠᤶᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤔᤢᤰᤛᤠᤶᤜᤠ᤹ ᤏᤢ ᤕᤢᤰᤜᤠ᤹ ᤏᤠᤵᤋᤢᤛᤡᤀᤠᤱ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤁᤢᤛᤡᤗᤠᤶᤛᤠᤰᤔᤠ ᤛᤡᤱᤅᤥ ᤌᤱ ᤏᤠ᤺ᤴᤍᤢᤛᤡ. ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰᤁᤣ ᤁᤧᤖᤧᤰᤗᤧ ᤔᤧᤏᤡ᤺ᤛᤢᤖ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤏᤠᤎᤠ᤺ᤛᤢ ᤐᤡᤖᤢᤛᤡᤖᤥ॥"]},{"type":"verse","numbe