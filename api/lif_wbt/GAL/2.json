nt":["ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤂᤧᤱᤜᤠ᤹ ᤛᤢᤏᤠᤀᤡᤱᤅᤡᤸᤗᤧᤴ ᤛᤧᤰᤂᤠᤒᤠ ᤐᤠ᤺ᤴᤏᤥ ᤔᤧᤶᤒᤳᤇᤧᤶᤒᤠ ᤏᤡ᤺ᤛᤢᤱᤛᤡᤱᤅᤠᤱ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤋᤃᤡᤀᤣ ᤐᤋᤪᤢᤛᤧᤴ ᤀᤰᤂᤣ ᤔᤧᤳᤋᤢᤱᤗ ᤑᤧ᤺ᤰᤋᤢᤱ. “ᤂᤧᤏᤧ᤹ᤃ ᤕᤜᤢᤍᤡᤏᤧᤛᤠᤱ ᤕᤜᤢᤍᤡ ᤜᤧᤰᤁᤣ ᤁᤧᤴᤘᤠ᤹ᤏᤧᤴ. ᤁᤖ ᤌᤡᤶᤔᤧᤴᤍᤱ ᤛᤢᤘᤠᤱ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤁᤧᤘᤠ᤹॥ ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤂᤧᤏᤧ᤹ ᤀᤡ᤺ᤵᤔᤠ ᤏᤠ᤺ᤵᤔᤠ ᤁᤧᤗᤧᤖᤢ ᤁᤧᤍᤣ᤺ᤛᤢᤒᤠ ᤕᤜᤢᤍᤡ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤴ ᤀᤠᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤌᤡᤶᤔᤧᤴᤍᤱ ᤛᤢᤘᤠᤱᤜᤠ᤹ ᤀᤡ᤺ᤵᤔᤠ ᤏᤠ᤺ᤵᤔᤠ ᤐᤥ᤺ᤱ ᤗ᤹ᤖᤡᤰ ᤁᤧᤔᤧᤳᤋᤢᤛᤡᤒᤠᤒᤣ᥅”"]},{"type":"verse","number":15,"content":["ᤀᤠᤏᤡ᤹ ᤛᤠᤀᤠᤘᤠ᤺ᤴᤇᤡᤱᤅᤠᤱᤎᤥᤀᤣ ᤕᤜᤢᤍᤡᤛᤡ. ᤌᤡᤶᤔᤧᤴᤍᤱ ᤛᤢᤘᤠᤱ ᤜᤧᤰᤋᤱᤒᤠ “ᤗᤠᤕᤥᤒᤠᤛᤡ” ᤔᤧ᤺ᤴᤗᤥ॥"]},{"type":"verse","number":16,"content":["ᤀᤠᤳᤋᤡᤴ ᤔᤏᤠ᤺ᤴᤏᤠᤱ ᤔᤥᤛᤠᤖᤧ ᤛᤠᤵᤋᤢᤒᤠ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤴ ᤀᤡ᤺ᤳᤋᤢ ᤏᤠ᤺ᤳᤋᤢᤀᤠᤱ ᤀᤠᤵᤋᤡᤰ ᤔᤧ᤺ᤴᤏᤣᤒᤠ ᤐᤥ᤺ᤱᤔᤠ ᤔᤧᤛᤢᤰᤏᤧᤴᤗᤥ. ᤁᤖ ᤕᤧᤛᤢ ᤂᤪᤡᤛ᤻ᤋᤧᤴ ᤏᤛᤠ᤺ᤴ ᤆᤥᤃᤢᤀᤠᤱᤗᤰ ᤀᤠᤵᤋᤡᤰ ᤔᤧ᤺ᤴᤏᤣᤒᤠ ᤐᤥ᤺ᤱᤔᤠ ᤛᤢᤰ ᤁᤧᤗ᤹ᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤀᤠᤏᤡ᤹ ᤁᤢᤛᤡᤱ ᤏᤡ᤺ᤵᤔᤠ ᤐᤥ᤺ᤱᤗᤥ॥ ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤀᤠᤏᤡ᤹ᤀᤠᤱ ᤂᤪᤡᤛ᤻ᤋᤀᤥᤒᤠ ᤏᤛᤠ᤺ᤴᤗᤠᤶ ᤀᤠᤵᤋᤡᤰ ᤔᤧ᤺ᤴᤏᤣ ᤀᤠᤒᤥ᤺ᤱᤗ ᤑᤠ᤹ᤀᤠᤱ ᤕᤧᤛᤢ ᤂᤪᤡᤛ᤻ᤋᤧᤴ ᤏᤛᤠ᤺ᤴ ᤀᤠᤈᤥᤃᤢᤶᤗᤥ. ᤁᤖ ᤛᤠᤶᤕᤥᤌᤡᤶ ᤀᤡᤱᤈᤠ᤺ᤱᤅᤡᤴ ᤀᤠᤀᤡ᤺ᤳᤋᤢᤶ ᤀᤠᤏᤠ᤺ᤳᤋᤢᤶᤒᤠᤗᤠᤶ ᤔᤧ᤺ᤴᤗᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤛᤠᤶᤕᤥᤌᤡᤶ ᤀᤡᤱᤈᤠ᤺ᤱᤅᤡᤴ ᤀᤡ᤺ᤳᤋᤢ ᤏᤠ᤺ᤳᤋᤢᤀᤠᤱ ᤀᤠᤳᤋᤡᤴᤏᤠᤱ ᤀᤠᤵᤋᤡᤰ ᤔᤧ᤺ᤴᤏᤣᤒᤠ ᤔᤧᤒᤥ᤺ᤱᤏᤧᤸᤗᤥ॥"]},{"type":"verse","number":17,"content":["ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤀᤠᤏᤡ᤹ ᤂᤪᤡᤛ᤻ᤋᤧᤴ ᤏᤛᤠ᤺ᤴ ᤆᤥ᤺ᤰᤔᤠᤗᤠᤶ ᤀᤠᤵᤋᤡᤰ ᤔᤧ᤺ᤴᤏᤣᤒᤠ ᤐᤥ᤺ᤱᤔᤠ ᤀᤠᤃᤥ᤺ᤳᤋᤢᤶᤔᤡᤸᤗᤧ ᤘᤣ᤹ᤜᤠ᤹ᤖᤧ ᤂᤡᤏᤡ᤹ ᤗᤠᤕᤥᤀᤥ ᤁᤧᤘᤠ᤹ᤒᤠᤏᤡᤱ ᤀᤠᤶᤔᤧᤳᤗᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤴ ᤀᤡ᤺ᤵᤔᤠ ᤏᤠ᤺ᤵᤔᤠ ᤀᤠᤗᤧᤖᤢᤶᤔᤠᤱ ᤀᤠᤘᤠ᤹॥ ᤂᤧᤴ ᤑᤠ᤹ᤀᤡᤴ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤗᤠᤕᤥᤀᤥ ᤗᤠᤶᤀᤠᤗᤥ᤺ᤒᤠᤒᤡ᥅ ᤜᤧᤰᤁᤣ ᤔᤧ᤺ᤴᤗᤥ᥄"]},{"type":"verse","number":18,"content":["ᤂᤧᤸᤗᤧ ᤁᤢᤗᤧᤰᤘᤠ ᤀᤡᤱᤃᤠ᤹ ᤗᤧᤖᤢᤱᤍᤣ᤺ᤛᤢᤱᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤕᤠᤶᤔᤥ ᤜᤢ᤹ᤖᤢᤱᤛᤡᤱᤏᤧ ᤑᤠ᤹ᤃᤪ ᤀᤡᤱᤃᤠ᤹ ᤗᤠᤕᤥᤒᤠ ᤐᤥ᤺ᤱᤅᤠᤖᤥ॥"]},{"type":"verse","number":19,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ᤃ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤴ ᤀᤡ᤺ᤵᤔᤠ ᤏᤠ᤺ᤵᤔᤠ ᤁᤥ᤺ᤳᤋᤢᤱᤅᤡᤸᤗᤧ ᤜᤠᤒᤠ ᤂᤧᤴ ᤛᤠᤶᤕᤥᤌᤡᤶ ᤀᤡᤱᤈᤠ᤺ᤱᤅᤡᤸᤗᤧ ᤀᤠᤵᤋᤡᤰ ᤁᤢ᤺ᤳᤋᤠᤱᤗᤥ॥ ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤗᤠᤃᤡ ᤜᤡᤱᤅᤠᤖ ᤑᤠ᤹ᤀᤠᤱ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤴ ᤀᤡ᤺ᤵᤔᤠ ᤏᤠ᤺ᤵᤔᤠᤀᤠᤱ ᤛᤧᤴᤗᤵ ᤂᤥ᤺ᤔᤠ ᤋᤶᤛᤡᤴ ᤆᤥ᤺ᤰᤔᤠ ᤗᤧᤖᤢᤱᤗᤥ॥",{"noteId":2}]},{"type":"verse","number":20,"content":["ᤀᤡᤱᤃᤠ᤹ᤃ ᤂᤪᤡᤛ᤻ᤋᤧᤴᤏᤢ ᤛᤡᤗᤠᤶᤛᤠᤰᤔᤠ ᤛᤡᤱᤅᤥ ᤛᤩᤠᤱᤅᤠᤱ ᤘᤠ᤹ᤀᤠ. ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤸᤗᤀᤠᤱᤎᤥ ᤀᤡᤱᤃᤠ᤹ᤃ ᤔᤧᤜᤡᤱᤅᤠᤴ. ᤁᤖ ᤂᤪᤡᤛ᤻ᤋᤧᤴ ᤀᤡᤱᤃᤠ᤹ᤀᤥ ᤜᤡᤱᤗᤥ॥ ᤀᤡᤱᤃᤠ᤹ᤃ ᤁᤴ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤌᤰᤁᤥ ᤜᤡᤱᤅᤠᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠ᤺ᤀᤥᤒᤠ ᤏᤛᤠ᤺ᤴᤗᤠᤶ ᤜᤡᤱᤅᤠᤖᤥ॥ ᤂᤢᤏᤧ᤹ᤀᤣ ᤗᤢᤱᤔᤠ᤹ ᤋᤢᤰᤋᤠᤱ ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤗᤠᤃᤡ ᤁᤢᤜᤡᤱᤔᤴᤏᤡᤴ ᤐᤡᤖᤢᤖᤥ॥"]},{"type":"verse","number":21,"content":["ᤀᤡᤱᤃᤠ᤹ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤗᤢᤱᤃᤢᤶᤔᤡᤴ ᤌᤣᤏᤠᤎᤣᤒᤠ ᤔᤧᤀᤡ᤺ᤳᤋᤠᤴᤗᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤛᤠᤶᤕᤥᤌᤡᤶᤗᤠᤶ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤏᤡ᤺ᤔᤠᤀᤥ ᤀᤠᤵᤋᤡᤰ ᤔᤧ᤺ᤴᤏᤣᤒᤠ ᤐᤥ᤺ᤱᤔᤠ ᤀᤠᤛᤢᤰᤏᤧ ᤑᤠ᤹ᤃᤪ ᤂᤪᤡᤛ᤻ᤋᤧᤴ ᤜᤏᤧᤖᤰ ᤛᤩᤧᤖᤥ॥"]}],"footnotes":[{"noteId":2,"caller":"*","text":"ᤃᤪᤡᤁ ᤐᤠ᤺ᤴᤍᤠᤱᤅᤥ “ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ᤃ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤗᤠᤃᤡ ᤜᤡᤱᤅᤠᤏᤡ ᤑᤠ᤹ᤀᤠᤱ ᤛᤠᤶᤕᤥᤌᤡᤶ ᤀᤡᤱᤈᤠ᤺ᤱᤗᤠᤶ ᤛᤠᤶᤕᤥᤌᤡᤶ ᤀᤡᤱᤈᤠ᤺ᤱᤅᤥ ᤛᤩᤠᤱᤅᤠᤱ ᤘᤠ᤹ᤀᤠᤖᤥ” ᤐᤠ᤺ᤳᤋᤢᤀᤠᤱ ᤐᤳ॥","reference":{"chapter":2,"verse":19}}]},"thisChapterLink":"/api/lif_wbt/GAL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lif_wbt/GAL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lif_wbt/GAL/1.json","previousChapterAudioLinks":{},"numberOfVerses":21}