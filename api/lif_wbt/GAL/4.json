"number":16,"content":["ᤁᤖ ᤀᤡᤱᤃᤠ᤹ ᤛᤧᤰᤂᤠᤀᤣ ᤔᤧᤳᤏᤡᤱᤒᤠᤸᤗᤧ ᤀᤠᤸᤗᤥ ᤂᤡᤏᤡ᤹ ᤏᤡᤱᤔᤡ ᤐᤥ᤺ᤰᤂᤠᤱᤒᤠᤒᤡ᥅"]},{"type":"verse","number":17,"content":["ᤂᤧᤴ ᤔᤏᤠᤜᤠ᤹ᤖᤧᤃ",{"noteId":10},"ᤂᤡᤏᤡ᤹ ᤂᤢᤏᤡ᤹ ᤗᤧᤵᤔᤠᤱ ᤀᤢ᤺ᤱᤔᤠᤛᤡ ᤑᤠ᤹ᤀᤠᤱ ᤛᤠ᤹ᤖᤡᤰ ᤂᤢᤏᤡ᤹ ᤛᤡᤰ ᤛᤶᤗᤥ. ᤁᤖ ᤁᤴ ᤂᤡᤏᤡ᤹ᤗᤠᤃᤡ ᤏᤢ᤺ᤒᤠ ᤔᤧ᤺ᤴᤗᤥ॥ ᤂᤧᤱᤜᤠ᤹ᤖᤧᤃ ᤀᤠᤏᤡᤃᤧ ᤋᤰᤗᤧᤱᤘᤠᤀᤥ ᤁᤧᤒᤥᤃᤡᤀᤠᤱ ᤂᤧᤱᤜᤠ᤹ᤖᤰ ᤁᤧᤍᤡᤶᤍᤢᤶᤛᤡᤶᤗ ᤁᤧᤗ᤹ᤒᤠ ᤏᤡᤱᤘᤠ᤹ ᤔᤧᤈᤥᤃᤢᤀᤠᤱ ᤔᤧᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":18,"content":["ᤀᤠᤸᤗ ᤀᤡᤱᤃᤠ᤹ ᤂᤡᤏᤡ᤹ᤏᤢ ᤘᤠ᤹ᤀᤠᤸᤗᤧᤖᤰ ᤔᤧ᤺ᤴ. ᤁᤖ ᤂᤡᤏᤡ᤹ᤏᤢ ᤜᤥ᤺ᤵᤐᤠᤛᤠᤱ ᤘᤣ᤹ᤜᤠ᤹ᤖᤧ ᤂᤡᤏᤡ᤹ ᤗᤠᤃᤡ ᤏᤢ᤺ᤒᤠ ᤕᤠ᤺ᤶᤒᤰ ᤆᤥ᤺ᤰᤔᤠ ᤛᤡᤰ ᤛᤶᤏᤧ ᤑᤠ᤹ᤃᤪ ᤏᤢ᤺ᤒᤠᤖᤥ॥"]},{"type":"verse","number":19,"content":["ᤀᤠᤔᤡ᤺ᤶ ᤀᤠᤛ᤻ᤛᤠ᤺ᤛᤣ. ᤂᤪᤡᤛ᤻ᤋᤧᤴ ᤁᤢᤀᤡᤛᤡ᤺ᤰᤁᤣ ᤂᤡᤏᤡ᤹ ᤔᤧᤶᤒᤥ᤺ᤱᤅᤣ ᤌᤠᤖᤡᤰ ᤀᤡᤱᤃᤠ᤹ᤃ ᤀᤠᤸᤗᤥ ᤕᤠᤶᤔᤥ ᤛᤠᤘᤠ᤺ᤶᤔᤠ ᤋᤢᤱᤅᤡᤸᤗᤧ ᤋᤖᤢᤔᤠ ᤔᤧᤴᤇᤢᤔᤠ᤹ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤐᤥ᤺ᤰᤂᤠᤱᤅᤠᤱ ᤘᤠ᤹ᤀᤠᤖᤥ॥"]},{"type":"verse","number":20,"content":["ᤀᤡᤱᤃᤠ᤹ ᤀᤠᤸᤗᤥ ᤂᤡᤏᤡ᤹ᤏᤢ ᤘᤠ᤹ᤀᤠᤸᤗᤧ ᤀᤰᤂᤣ ᤐᤠ᤺ᤵᤔᤠ ᤔᤧᤒᤥ᤺ᤰᤂᤧᤶᤒᤠ ᤘᤕᤧᤖᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤡᤏᤡ᤹ ᤜᤧᤰᤁᤣ ᤁᤧᤗ᤹ᤖᤡᤒᤠᤀᤥ ᤀᤡᤱᤃᤠ᤹ ᤀᤠᤏᤡᤱᤘᤠ᤹ ᤋᤢᤃᤧᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"heading","content":["ᤜᤠᤃᤠᤖ ᤏᤢ ᤛᤠᤖᤠ"]},{"type":"verse","number":21,"content":["ᤂᤡᤏᤡ᤹ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤸᤗᤧ ᤁᤢᤕᤢᤰᤁᤥ ᤘᤠ᤹ᤔᤠ ᤏᤡᤱᤘᤠ᤹ ᤁᤧᤈᤥᤃᤢᤶᤒᤡ᥅ ᤂᤧᤵᤛᤧᤶᤔᤧ᤹ᤀᤥ᥄ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤸᤗᤧ ᤐᤠ᤺ᤳᤋᤢᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤁᤢᤛᤡᤱ ᤁᤧᤏᤡ᤺ᤳᤋᤢᤶᤔᤠᤱ ᤁᤧᤘᤕᤡ᤹ᤒᤡ᥅"]},{"type":"verse","number":22,"content":["ᤛᤠᤶᤕᤥᤛᤠᤵᤗᤠ᤺ᤸᤗᤧ ᤀᤒᤪᤠᤜᤠᤔᤖᤧ ᤁᤢᤛ᤻ᤛᤠ᤺ ᤕᤧᤶᤒᤡᤳᤇᤠ᤹ ᤏᤧᤳᤇᤡ ᤘᤕᤧᤳᤇᤡ ᤑᤠ᤹ᤀᤠᤱ ᤐᤠ᤺ᤳᤋᤢ᤹॥ ᤌᤡᤰᤁᤡᤴ ᤛᤣᤘᤠᤖᤥᤔᤠ",{"noteId":11},"ᤁᤢᤔᤣ᤺ᤳ ᤗᤧᤵᤔᤠᤱᤒᤠ ᤘᤕᤧ. ᤘᤣ᤹ᤛ᤻ᤔᤠᤴ ᤆᤥ᤺ᤰᤕᤢᤶᤓᤥᤔᤠ",{"noteId":12},"ᤁᤢᤔᤣ᤺ᤳ ᤗᤧᤵᤔᤠᤱᤒᤠ ᤘᤕᤧᤖᤥ॥",{"noteId":13}]},{"type":"verse","number":23,"content":["ᤜᤠᤃᤠᤖ ᤔᤧᤵᤔᤏᤠᤔᤠ ᤛᤣᤘᤠᤖᤥᤔᤠ ᤁᤢᤔᤣ᤺ᤳᤗᤠᤶ ᤛᤠᤃᤧᤘᤠ᤺ᤴᤇᤡᤱᤒᤠᤴ ᤔᤧᤴᤇᤠᤶ ᤏᤡᤱᤘᤠ᤹ᤗᤠᤶ ᤛᤠᤘᤠ᤺ᤴᤇᤡᤱᤒᤠᤖᤥ॥ ᤁᤖ ᤛᤠᤖᤠ ᤔᤧᤵᤔᤏᤠᤔᤠ ᤆᤥ᤺ᤰᤕᤢᤶᤓᤥᤔᤠ ᤀᤠᤒᤠᤅᤣ ᤁᤢᤔᤣ᤺ᤳᤗᤠᤶ ᤛᤠᤃᤧᤘᤠ᤺ᤴᤇᤡᤱᤒᤠᤱᤃ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤔᤠᤱᤜᤧᤰᤗᤠᤶ ᤐᤥ᤺ᤰᤂᤧᤒᤠᤖᤥ॥"]},{"type":"verse","number":24,"content":["ᤀᤠᤸᤗ ᤁᤴ ᤏᤧᤵᤑᤢ ᤔᤧᤴᤇᤢᤔᤠᤜᤠ᤹ᤃ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤆᤥᤃᤢᤒᤠ ᤏᤧᤳᤇᤡ ᤔᤠᤱᤜᤢᤵᤐᤡᤸᤗᤧ ᤁᤢᤒᤡᤛᤡᤖᤥ॥ ᤛᤣᤘᤠᤖᤥᤔᤠ ᤜᤠᤃᤠᤖᤖᤧᤱᤃ ᤛᤡᤏᤠᤀᤡ",{"noteId":14},"ᤁᤥ᤺ᤰᤔᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤆᤥ᤺ᤰᤗᤥ॥ ᤂᤧᤵᤔᤥ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤔᤏᤠᤜᤠ᤹ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤴ ᤐᤡᤖᤢᤛᤡ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤴ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤸᤗᤧ ᤔᤏᤠᤜᤠ᤹ ᤕᤥ᤺ᤰ ᤆᤥᤃᤢᤛᤡᤖᤥ॥"]},{"type":"verse","number":25,"content":["ᤀᤠᤸᤗ ᤀᤠᤸᤗᤥᤒᤠ ᤕᤖᤢᤛᤗᤧᤔ ᤕᤧᤰᤕᤰᤁᤡᤴ ᤀᤖᤒ ᤗᤠᤈᤣ᤹ᤒᤠ ᤛᤡᤏᤠᤀᤡ ᤁᤥ᤺ᤰᤔᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤆᤥ᤺ᤰᤗᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤧᤴ ᤕᤧᤰᤕᤰᤁᤡᤴ ᤏᤢ ᤛᤠᤶᤕᤥᤌᤡᤶ ᤁᤧᤀᤡ᤺ᤵᤐᤠ ᤁᤧᤏᤠ᤺ᤵᤐᤠ ᤁᤧᤖᤧᤰ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤸᤗᤧ ᤁᤢᤕᤥ᤺ᤰ ᤔᤧᤒᤥ᤺ᤰᤂᤧᤀᤠᤱ ᤔᤧᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":26,"content":["ᤁᤖ ᤆᤥ᤺ᤰᤕᤢᤶᤓᤥᤔᤠ ᤛᤠᤖᤠ᤺ᤱᤃ ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱᤒᤠ ᤕᤖᤢᤛᤗᤧᤔ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤆᤥ᤺ᤰᤗᤥ॥ ᤂᤢᤏᤧ᤹ᤀᤣ ᤀᤠᤏᤡ᤹ ᤔᤠᤖᤥ॥"]},{"type":"verse","number":27,"content":["ᤔᤠᤱᤏᤡᤱᤘᤠ᤹ᤐᤠ᤺ᤴ ᤁᤧᤒᤠ᤺ᤵᤐᤠ ᤕᤛᤤᤕᤠ᤺ᤸᤗᤧ ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤔᤠᤱᤏᤡᤱᤘᤠ᤹ᤐᤠ᤺ᤴ ᤐᤠ᤺ᤳᤋᤢᤀᤠᤱ ᤘᤠ᤹.",{"text":"“ᤛᤠᤔᤧᤱᤃᤵᤔᤏᤠᤔᤠᤀᤣ. ᤛ᤺ᤳᤋᤧ᤹ᤀᤥ᥄ ᤂᤧᤏᤧ᤹ ᤛᤠᤃᤧᤴᤘᤠ᤺ᤴᤍᤢᤴᤇᤠᤱ ᤛ᤺ᤳᤋᤧ᤹ᤖ ᤀ᤺ᤰᤋᤧ᤹ᤀᤥ᥄ ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤧᤴ ᤘᤣ᤹ ᤔᤧᤴᤇᤢᤔᤠ᤹ᤏᤢ᤺ᤸᤗᤧᤀᤠᤱ ᤛᤠᤔᤧᤱᤃᤵᤔᤏᤠᤔᤠᤸᤗᤧ ᤁᤢᤛ᤻ᤛᤠ᤺ᤜᤠ᤹ ᤕᤖᤡᤰ ᤔᤧᤒᤥ᤺ᤱᤗᤥ॥”","poem":1},{"noteId":15}]},{"type":"verse","number":28,"content":["ᤀᤠᤸᤗ ᤀᤠᤔᤡ᤺ᤶ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤛᤣ. ᤂᤡᤏᤡ᤹ᤃ ᤀᤡᤛᤜᤠᤁ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤔᤠᤱᤜᤧᤰ ᤆᤥᤃᤢᤒᤠ ᤔᤢ᤹ᤀᤡᤍᤠᤱᤛᤠᤏᤡᤱᤗᤥ॥"]},{"type":"verse","number":29,"content":["ᤁᤖ ᤂᤧᤴ ᤕᤥ᤺ᤰᤔᤠ ᤔᤣ᤺ᤳᤋᤡᤸᤗᤧ ᤁᤢᤛ᤻ᤛᤠ᤺ ᤀᤡᤛ᤻ᤔᤠᤀᤣᤗᤖᤧ ᤔᤠᤱᤜᤧᤰᤗᤠᤶ ᤛᤠᤃᤧᤘᤠ᤺ᤴᤇᤡᤱᤒᤠ ᤀᤡᤛᤜᤠᤰᤁᤡᤴ ᤋᤢᤰᤂᤣ ᤆᤠ᤺ᤳᤋᤢᤒᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤛᤣᤛᤣᤔᤠᤱᤗᤠᤶ ᤀᤠᤏᤡ᤹ ᤛᤠᤃᤧᤘᤠ᤺ᤴᤇᤡᤱᤒᤠᤜᤠ᤹ᤀᤠᤱ ᤛᤠᤶᤕᤥᤌᤡᤶ ᤁᤧᤀᤡ᤺ᤵᤐᤠ ᤁᤧᤏᤠ᤺ᤵᤐᤠᤜᤠ᤹ᤖᤧ ᤋᤢᤰᤂᤣ ᤀᤠᤶᤈᤠ᤺ᤳᤗᤥ॥"]},{"type":"verse","number":30,"content":["ᤁᤖ ᤛᤠᤶᤕᤥᤛᤠᤵᤗᤠ᤺ᤸᤗᤧ ᤌᤣ ᤐᤠ᤺ᤳᤋᤢ᤹᥅ “ᤛᤣᤘᤠᤖᤥᤔᤠ ᤔᤧᤴᤇᤢᤔᤠ᤹ᤀᤡᤴ ᤏᤢ ᤁᤢᤛ᤻ᤛᤠ᤺ᤴ ᤏᤠ᤺ᤳᤋᤧᤍᤣ᤺ᤛᤧᤛᤧ᤹ᤀᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤛᤣᤘᤠᤖᤥᤔᤠᤸᤗᤧ ᤁᤢᤛ᤻ᤛᤠ᤺ᤴ ᤆᤥ᤺ᤰᤕᤢᤶᤓᤥᤔᤠ ᤔᤧᤴᤇᤢᤔᤠ᤹ᤀᤡᤸᤗᤧ ᤁᤢᤛ᤻ᤛᤠ᤺ᤴᤏᤢ ᤛᤥᤖᤡᤰ ᤗᤰ ᤁᤧᤄᤥ᤺ᤒᤠ ᤐᤥ᤺ᤱᤔᤠ ᤔᤧᤛᤢᤰᤏᤧᤴᤗᤥ॥”",{"noteId":16}]},{"type":"verse","number":31,"content":["ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤀᤠᤔᤡ᤺ᤶ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤛᤣ. ᤀᤠᤏᤡ᤹ᤃ ᤛᤣᤘᤠᤖᤥᤔᤠ ᤔᤧᤴᤇᤢᤔᤠ᤹ᤀᤡᤸᤗᤧ ᤁᤢᤛ᤻ᤛᤠ᤺ᤛᤡ ᤔᤧ᤺ᤴᤗᤥ. ᤁᤖ ᤀᤠᤏᤡ᤹ᤃ ᤆᤥ᤺ᤰᤕᤢᤶᤓᤥᤔᤠ ᤔᤧᤴᤇᤢᤔᤠ᤹ᤀᤡᤸᤗᤧ ᤁᤢᤛ᤻ᤛᤠ᤺ᤛᤡᤖᤥ॥"]}],"footnotes":[{"noteId":10,"caller":"*","text":"ᤂᤧᤴ ᤑᤠ᤹ᤀᤡᤴ. “ᤀᤡᤱᤗᤧᤰᤐᤠ ᤛᤠᤶᤕᤥ ᤛᤡᤰᤛᤠᤶᤒᤠᤜᤠ᤹” ᤐᤥ᤺ᤱᤗᤥ॥ ᥇.᥇᥍ ᤀᤥᤔᤳᤋᤧ᤹ᤀᤥ॥","reference":{"chapter":4,"verse":17}},{"noteId":11,"caller":"*","text":"ᤛᤣᤘᤠᤖᤥᤔᤠ ᤁᤢᤔᤣ᤺ᤳ ᤑᤠ᤹ᤀᤡᤴ ᤀᤒᤪᤠᤜᤠᤔᤖᤧ ᤁᤢᤔᤣ᤺ᤳ ᤛᤠᤖᤠᤖᤧ ᤁᤢᤛᤣᤘᤠᤖᤥᤔᤠ ᤜᤠᤃᤠᤖᤖᤥ॥ ᤀᤡᤛ᤻ᤔᤠᤀᤣᤸᤗᤧᤴ ᤜᤠᤃᤠᤖᤖᤧ ᤁᤢᤛ᤻ᤛᤠ᤺ᤖᤥ॥","reference":{"chapter":4,"verse":22}},{"noteId":12,"caller":"*","text":"ᤆᤥ᤺ᤰᤕᤢᤶᤓᤥᤔᤠ ᤁᤢᤔᤣ᤺ᤳ ᤑᤠ᤹ᤀᤡᤴ ᤀᤒᤪᤠᤜᤠᤔᤖᤧ ᤁᤢᤔᤣ᤺ᤳ ᤛᤠᤖᤠᤖᤥ॥ ᤀᤡᤛᤜᤠᤰᤁᤧᤴ ᤛᤠᤖᤠᤖᤧ ᤁᤢᤛ᤻ᤛᤠ᤺ᤖᤥ॥","reference":{"chapter":4,"verse":22}},{"noteId":13,"caller":"*","text":"ᤋᤥᤗᤡᤱᤛᤥᤔᤢ ᥇᥌.᥇᥋. ᥈᥇.᥈-᥉","reference":{"chapter":4,"verse":22}},{"noteId":14,"caller":"*","text":"ᤛᤡᤏᤠᤀᤡ–ᤂᤧᤱᤃ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤗᤠᤶ ᤛᤠᤶᤕᤥᤌᤡᤶ ᤂᤥ᤺ᤔᤠ ᤑᤠ᤹ᤀᤠᤱ ᤔᤥᤛᤠᤖᤧ ᤗᤡᤅᤢᤒᤠ ᤁᤥ᤺ᤰᤔᤠ॥","reference":{"chapter":4,"verse":24}},{"n