{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"HEB","translationId":"lif_wbt","name":"ᤜᤡᤒᤪᤢ","commonName":"ᤜᤡᤒᤪᤢ","title":"ᤜᤡᤒᤪᤢᤜᤠ᤹ᤖᤧ ᤗᤠᤃᤡ ᤛᤰᤀᤡᤱᤄᤱ","order":58,"numberOfChapters":13,"sha256":"414f797cf01c4bdaa3690389f15c08c4542c823e36806579e381b5579d5320b8","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/lif_wbt/HEB/13.json","totalNumberOfVerses":297},"chapter":{"number":2,"content":[{"type":"heading","content":["ᤐᤕᤶ ᤛᤧᤴᤗᤵ"]},{"type":"verse","number":1,"content":["ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤀᤠᤏᤡ᤹ ᤀᤠᤄᤧᤵᤛᤢᤶᤒᤠ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤕᤠ᤺ᤶᤒᤣᤀᤥᤒᤠ ᤛᤧᤰᤂᤠ᤺ᤴ ᤀᤠᤸᤗᤛᤠᤱ ᤕᤖᤡᤰ ᤏᤢ᤺ᤖᤡᤰᤁᤠᤱ ᤏᤡᤱᤘᤠ᤹ ᤐᤡᤔᤠᤀᤣ ᤐᤥ᤺ᤱᤗᤥ. ᤔᤧ᤺ᤴᤏᤧ ᤑᤠ᤹ᤃᤪ ᤀᤠᤏᤡ᤹ ᤂᤧᤵᤔᤥᤗᤠᤶ ᤀᤠᤗᤧ᤺ᤱ ᤀᤠᤒᤣ᤺ᤰᤗᤥ॥"]},{"type":"verse","number":2,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤔᤠᤱᤗᤠᤀᤡᤱᤒᤠᤜᤠ᤹ᤖᤧ ᤀᤡᤱᤔᤧᤓᤥ᤺ᤛᤢᤒᤠ ᤀᤡᤱᤄᤱᤅᤡᤴ ᤛᤧᤰᤂᤠ ᤐᤥ᤺ᤰᤂᤧᤀᤠᤱ ᤘᤠ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤐᤠ᤺ᤴ ᤁᤧᤓᤣ᤺ᤶᤒᤠᤜᤠ᤹ ᤏᤢ ᤀᤡᤱᤈᤠ᤺ᤱ ᤂᤧᤶᤔᤠ ᤔᤧᤴᤍᤧᤶᤏᤠᤒᤠᤜᤠ᤹ ᤁᤧᤖᤧᤰ ᤂᤥ᤺ᤔᤠ ᤁᤧᤒᤥ᤺ᤱᤒᤠ ᤂᤢᤶᤍᤡᤱ ᤐᤡᤖᤢᤛᤡ॥"]},{"type":"verse","number":3,"content":["ᤀᤠᤏᤡ᤹ᤀᤠᤱ ᤁᤴ ᤐᤕᤶ ᤕᤶᤒᤠ ᤛᤧᤴᤗᤵᤐᤡᤴ ᤀᤠᤏᤠ᤹ᤖᤢᤶᤏᤧ ᤑᤠ᤹ᤃᤪ ᤀᤠᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤋᤠᤱᤔᤠ ᤀᤠᤛᤢᤰᤐᤠᤒᤣ᥅ ᤁᤴ ᤛᤧᤴᤗᤵᤐᤡᤴ ᤍᤠᤱᤒᤠᤸᤗᤧ ᤀᤠᤒᤠᤅᤣ ᤁᤠᤰᤏᤢ ᤋᤃᤡ ᤀᤡᤱᤓᤥ᤺ᤛᤢᤀᤠᤱ ᤘᤕᤧ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ᤗᤠᤶ ᤁᤧᤄᤧᤶᤒᤠᤜᤠ᤹ᤖᤧ ᤁᤴ ᤐᤠ᤺ᤴᤏᤡᤴ ᤀᤠᤏᤡ᤹ ᤏᤡ᤺ᤴᤎᤥ ᤀᤠᤶᤈᤥᤃᤧ ᤀᤠᤶᤒᤡᤖᤧᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":4,"content":["ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧᤀᤠᤱ ᤂᤢᤏᤧ᤹ ᤆᤥᤃᤢᤒᤠ ᤔᤡᤰᤛᤣ᤺ᤴᤜᤠ᤹ ᤏᤢ ᤏᤡᤱᤘᤠ᤹ ᤁᤧᤔᤠᤒᤠ ᤕᤠ᤺ᤶᤒᤰᤜᤠ᤹ᤗᤠᤶᤒᤠ ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤒᤠᤅᤣ ᤁᤢᤏᤡᤱᤘᤠ᤹ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤏᤛᤠᤏᤡᤒᤠᤜᤠ᤹ ᤜᤠ᤺ᤳᤋᤢᤛᤡᤒᤠ ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤸᤗᤧᤴ ᤐᤷᤎᤠ᤺ᤶᤜᤠ᤹ᤗᤠᤶᤒᤠ ᤁᤴ ᤐᤠ᤺ᤴᤏᤡᤴ ᤏᤡ᤺ᤴᤎᤥ ᤆᤥᤃᤢᤖᤥ॥"]},{"type":"heading","content":["ᤛᤧᤴᤗᤵᤐᤥ ᤗᤠᤶᤃᤧᤗᤥ᤺ᤒᤠ"]},{"type":"verse","number":5,"content":["ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤀᤠᤏᤡᤃᤧ ᤐᤠ᤺ᤳᤋᤢᤶᤒᤧᤒᤠ ᤁᤴ ᤁᤧᤍᤠ᤺ᤒᤠᤖ ᤁᤧᤒᤵᤐᤠ ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤠᤴ ᤔᤠᤱᤗᤠᤀᤡᤱᤒᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤕᤢᤰᤁᤥ ᤔᤧᤒᤡᤖᤢᤴᤇᤡᤴᤗᤥ॥"]},{"type":"verse","number":6,"content":["ᤁᤖ ᤛᤠᤶᤕᤥᤛᤠᤵᤗᤠᤀᤥ ᤌᤡᤰ ᤋᤧᤴᤏᤥ ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤛᤠᤵᤋᤧᤀᤠᤱ ᤐᤳ.",{"text":"“ᤔᤏᤠ᤺ᤴ ᤌᤣᤀᤠᤱ ᤏᤡᤱᤘᤠ᤹ ᤁᤧᤀᤡ᤺ᤳᤋᤢᤒᤣ. ᤀᤡᤃᤪ ᤔᤧᤴᤇᤠᤶ ᤕᤠᤵᤔᤡ᤺ᤴ ᤜᤠ᤺ᤳᤋᤠᤱ ᤁᤶᤒᤪᤠᤱ ᤁᤧᤔᤧᤳᤋᤢᤒᤣ᥅","poem":1}]},{"type":"verse","number":7,"content":[{"text":"ᤂᤧᤱᤜᤠ᤹ᤃ ᤔᤠᤱᤗᤠᤀᤡᤱᤒᤠᤜᤠ᤹ᤏᤢ᤺ᤸᤗᤧ ᤆᤩ᤹ᤖᤰ ᤕᤥᤕᤥᤰ ᤁᤧᤈᤥᤃᤢᤛᤡ. ᤂᤧᤱᤜᤠ᤹ ᤔᤡᤔᤡᤍᤡᤱ ᤏᤢ ᤔᤡᤱᤛᤥ ᤀᤡᤱᤎᤠ᤺ᤱᤗᤧ ᤋᤡᤆ᤺ᤴ ᤁᤧᤄᤢ᤺ᤰᤋᤢᤛᤡᤖᤥ॥","poem":1}]},{"type":"verse","number":8,"content":[{"text":"ᤜᤧᤰᤁᤩᤠᤱ ᤁᤠᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤕᤢᤰᤁᤥ ᤁᤧᤕᤢᤰᤂᤢᤖᤥ॥”","poem":1},{"noteId":7},"ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤠᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤕᤢᤰᤁᤥ ᤕᤢᤰᤂᤢᤸᤗᤧ ᤂᤢᤏᤧ᤹ ᤁᤢᤕᤢᤰᤁᤥ ᤔᤧᤍᤠᤖᤢᤴᤒᤠ ᤌᤣᤀᤠᤱ ᤜᤥ᤺ᤵᤗᤥ॥ ᤜᤧᤰᤁᤣᤛᤠᤱ ᤁᤴ ᤕᤧᤶᤔᤥ ᤁᤠᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤂᤢᤏᤡ᤹ ᤕᤢᤰᤁᤥ ᤘᤠ᤹ᤒᤠ ᤀᤠᤴᤏᤡ᤺ᤛᤢᤶᤔᤡᤴᤗᤥ॥"]},{"type":"verse","number":9,"content":["ᤁᤖ ᤀᤠᤏᤡ᤹ ᤕᤧᤛᤢ᤺ᤴ ᤀᤠᤏᤡ᤺ᤛᤢᤶᤗᤥ॥ ᤂᤢᤏᤧ᤹ᤃ ᤔᤠᤱᤗᤠᤀᤡᤱᤒᤠᤜᤠ᤹ᤏᤢ᤺ᤸᤗᤧᤀᤠᤱ ᤆᤩ᤹ᤖᤰ ᤕᤥᤕᤥᤰ ᤘᤕᤧ. ᤀᤠᤸᤗᤃ ᤂᤢᤏᤧ᤹ ᤛᤡ᤺ᤔᤧᤴᤏᤥ ᤋᤢᤰᤂᤣ ᤆᤩᤧᤒᤠᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤔᤡᤔᤡᤍᤡᤱ ᤏᤢ ᤔᤡᤱᤛᤥ ᤀᤡᤱᤎᤠ᤺ᤱᤅᤡᤸᤗᤧᤴ ᤋᤡᤆ᤺ᤴ ᤂᤢ᤺ᤰᤋᤢᤀᤠᤱ ᤘᤠ᤹॥ ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤗᤢᤱᤃᤢᤶᤗᤠᤶ ᤂᤢᤏᤧ᤹ ᤁᤠᤰ ᤔᤧᤴᤇᤠᤶ ᤕᤠᤵᤔᤡᤖᤧ ᤗᤠᤃᤡ ᤛᤡ᤺ᤔᤧᤴ ᤛᤠ᤹ᤖᤢᤖᤥ॥"]},{"type":"verse","number":10,"content":["ᤁᤠᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ᤃ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧᤴᤗᤥ. ᤜᤧᤰᤁᤩᤠᤱ ᤁᤠᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ᤃ ᤁᤢᤔᤢᤰᤛᤠᤶᤗᤠᤶᤒᤠ ᤏᤠᤘᤠᤃᤧᤴ ᤆᤀᤡ᤺ᤳᤋᤡᤴ ᤏᤧᤛ᤻ᤛᤧᤒᤠᤖᤥ॥ ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤕᤧᤛᤢ᤺ᤴ ᤀᤡᤏᤥᤃᤧᤴ ᤋᤢᤰᤂᤣᤗᤠᤶᤒᤠ ᤁᤢᤗᤡᤱᤎᤥ ᤁᤧᤳᤋᤢᤸᤗᤧ ᤏᤢ᤺ᤒᤠ ᤏᤢ ᤁᤢᤍᤱᤒᤠ ᤐᤠ᤺ᤴ ᤆᤥᤃᤢᤖᤥ॥ ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤕᤧᤛᤢᤖᤧ ᤕᤖᤡᤰ ᤔᤢ᤹ᤀᤡᤍᤠᤱᤛᤠᤜᤠ᤹ ᤛᤧᤴᤗᤵᤐᤥ ᤗᤠᤶᤗᤥᤛᤢᤛᤡ᤹ᤀᤠᤱ ᤁᤢᤔᤡᤔᤡᤍᤡᤱᤅᤡᤸᤗᤧᤴ ᤗᤰ ᤁᤧᤄᤥ᤺ᤒᤠ ᤔᤧᤒᤥ᤺ᤰᤂᤧᤖᤥ॥"]},{"type":"verse","number":11,"content":["ᤔᤏᤠᤜᤠ᤹ ᤗᤠᤕᤥᤗᤠᤶ ᤛᤣᤛᤣ ᤁᤧᤈᤥ᤺ᤰᤐᤠ ᤕᤧᤛᤢ᤺ᤴ ᤏᤢ ᤛᤣᤛᤣ ᤁᤧᤒᤥ᤺ᤱᤒᤠᤜᤠ᤹ᤃ ᤗᤳᤌᤡᤰ ᤜᤡᤶᤛᤕᤱᤛᤡᤖᤥ. ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤂᤧᤱᤜᤠ᤹ ᤀᤠᤴᤛᤠ᤹ᤛᤡ ᤔᤧᤵᤔᤠᤛᤡ ᤂᤢᤏᤧ᤹ ᤔᤧᤏᤢ᤺ᤴᤏᤧᤴᤗᤥ॥"]},{"type":"verse","number":12,"content":["ᤂᤢᤏᤧ᤹ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤗᤥ ᤛᤢᤶᤔᤥ ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤔᤧᤳᤋᤢ᤹.",{"text":"“ᤀᤡᤱᤃᤠ᤹ ᤁᤧᤔᤡᤱᤅᤡᤴ ᤀᤠᤴᤛᤠ᤹ᤛᤡ ᤀᤡᤱᤓᤥ᤺ᤛᤢᤱᤛᤡᤱᤗᤥ. ᤜᤧᤰᤁᤩᤠᤱ ᤁᤧᤔᤏᤠ ᤗᤢᤶᤔᤥ ᤀᤡᤱᤃᤠ᤹ ᤏᤧᤶᤓᤥᤃᤧᤴ ᤁᤧᤏᤠᤖᤠ ᤑᤥ᤺ᤛᤢᤱᤗᤥ॥”","poem":1},{"noteId":8}]},{"type":"verse","number":13,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤕᤠᤶᤔᤥ ᤐᤠ᤺ᤳᤋᤢ᤹.",{"text":"“ᤀᤡᤱᤃᤠ᤹ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤥ ᤏᤛᤠ᤺ᤴ ᤕᤢᤰᤂᤢᤱᤗᤥ॥”","poem":1},"ᤂᤢᤏᤧ