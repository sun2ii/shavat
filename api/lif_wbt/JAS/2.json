{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"JAS","translationId":"lif_wbt","name":"ᤕᤠᤁᤢᤒ","commonName":"ᤕᤠᤁᤢᤒ","title":"ᤕᤠᤁᤢᤒᤖᤧ ᤛᤠᤵᤋᤢᤒᤠ ᤛᤰᤀᤡᤱᤄᤱ","order":59,"numberOfChapters":5,"sha256":"63c0d9c5409fe50e6609f1c160d11e6956279afe3ae333005dcf6dc7504cca01","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/JAS/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/lif_wbt/JAS/5.json","totalNumberOfVerses":108},"chapter":{"number":2,"content":[{"type":"heading","content":["ᤔᤏᤠᤜᤠ᤹ ᤀᤣ᤺ᤰᤐᤀᤣ᤺ᤰ ᤆᤥ᤺ᤰᤔᤠᤛᤡ ᤔᤧ᤺ᤴ"]},{"type":"verse","number":1,"content":["ᤀᤠᤔᤡ᤺ᤶ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤛᤣ. ᤔᤡᤔᤡᤍᤡᤱᤃᤧᤴ ᤀᤠᤏᤡ᤹ ᤍᤠᤱᤒᤠ ᤕᤧᤛᤢ ᤂᤪᤡᤛ᤻ᤋᤧᤴ ᤏᤛᤠ᤺ᤴ ᤁᤧᤈᤥ᤺ᤰᤐᤠ ᤔᤏᤠᤜᤠ᤹ᤖᤧᤃ ᤘᤣ᤹ ᤔᤏᤠᤜᤠ᤹ ᤛᤧᤶᤔᤠᤛᤡ ᤔᤧᤏᤢ᤹ᤏᤧᤴᤗᤥ॥"]},{"type":"verse","number":2,"content":["ᤀᤠᤸᤗ ᤂᤡᤏᤡ᤹ ᤛᤣᤛᤣ ᤆᤢᤶᤗᤢᤱᤅᤥ ᤔᤏᤠᤎᤡᤰ ᤛᤠᤶᤔᤩᤠᤱ ᤛᤫᤠ᤺ᤃᤧᤵᤐᤡᤴ ᤏᤢ ᤏᤢ᤺ᤒᤠ ᤆᤠᤱ ᤆᤠᤰᤂᤢᤀᤠᤱ ᤋᤠ᤺. ᤜᤧᤰᤁᤩᤠᤱ ᤜᤠᤒᤠ ᤂᤧᤴ ᤕᤧᤶᤔᤥᤀᤣ ᤕᤠᤱᤃᤧᤛᤠ᤹ᤒᤠ ᤆᤡᤖᤡᤱᤗᤡᤱᤒᤠ ᤆᤠᤱ ᤁᤧᤈᤠᤱᤒᤠ ᤔᤏᤠᤎᤡᤰᤁᤠᤱ ᤋᤠᤏᤧ ᤑᤠ᤹ᤃᤪ."]},{"type":"verse","number":3,"content":["ᤂᤧᤴ ᤏᤢ᤺ᤒᤠ ᤆᤠᤱ ᤁᤧᤈᤠᤱᤒᤠ ᤔᤏᤠ᤺ᤴ ᤔᤡᤱᤛᤥ ᤀᤡᤱᤎᤠ᤺ᤱ ᤁᤧᤒᤡᤖᤢᤶᤗ “ᤁᤵᤔᤥ ᤏᤢ᤺ᤒᤠ ᤋᤧᤴᤏᤥ ᤕᤢᤅᤧ᤹ᤀᤥ” ᤁᤧᤔᤧᤳᤋᤢᤶ. ᤁᤖ ᤂᤧᤴ ᤕᤠᤱᤃᤧᤛᤠ᤹ᤒᤠᤴ “ᤂᤧᤏᤧ᤹ ᤂᤧᤳᤏᤠ ᤕᤧᤒᤧ᤹” ᤀᤡᤃᤪ “ᤁᤵᤔᤥ ᤂᤠᤶᤔᤥ ᤕᤢᤅᤧ᤹” ᤁᤧᤔᤧᤳᤋᤢᤶᤏᤧ ᤑᤠ᤹ᤃᤪ."]},{"type":"verse","number":4,"content":["ᤂᤡᤏᤡ᤹ᤃ ᤀᤠᤒᤠᤅᤣ ᤗᤢᤶᤔᤥ ᤔᤏᤠ ᤁᤧᤛᤧᤶᤒᤠ ᤏᤢ ᤑᤧᤴ ᤏᤡᤱᤘᤠ᤹ᤗᤠᤶ ᤂᤠᤛᤧᤴᤗᤥ᤺ᤶᤒᤠ ᤁᤧᤶᤒᤥ᤺ᤰᤂᤡᤴᤒᤡ᥅"]},{"type":"verse","number":5,"content":["ᤀᤠᤔᤡ᤺ᤶ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤛᤣ. ᤂᤧᤵᤛᤧᤶᤔᤧ᤹ᤀᤥ᥄ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥᤒᤠ ᤕᤠᤱᤃᤧᤛᤠ᤹ᤒᤠᤜᤠ᤹ ᤏᤛᤠ᤺ᤴᤏᤥ ᤕᤠᤱᤛᤠᤁᤢᤴᤎᤣᤛᤠᤒᤠ ᤆᤥ᤺ᤰᤛᤧ ᤏᤢ ᤁᤢᤜᤠᤱᤈᤢᤶ ᤗᤰ ᤂᤥ᤺ᤛᤧ ᤛᤣᤃᤢᤛᤡᤀᤠᤱ ᤘᤠ᤹॥ ᤂᤧᤴ ᤜᤠᤱᤈᤢᤶᤔᤡᤱᤃ ᤂᤢᤏᤧ᤹ ᤁᤠᤰ ᤔᤡ᤺ᤶᤈᤡ ᤁᤧᤔᤧᤵᤐᤠᤜᤠ᤹ ᤐᤡᤔᤠᤛᤡ ᤔᤠᤱᤜᤧᤰ ᤆᤥᤃᤢᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":6,"content":["ᤁᤖ ᤂᤡᤏᤡ᤹ᤃ ᤕᤠᤱᤃᤧᤛᤠ᤹ᤒᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤏᤠᤃᤧᤎᤠ᤺ᤛᤢᤶ ᤁᤧᤒᤡᤖᤢᤶᤛᤡᤶᤔᤠᤱ ᤁᤧᤘᤕᤡ᤹ᤖᤥ॥ ᤂᤡᤏᤡ᤹ ᤏᤡᤱᤄᤢᤶ ᤁᤧᤔᤧᤵᤐᤠᤀᤠᤱ ᤂᤠᤛᤧᤴ ᤜᤡᤶᤔᤥ ᤁᤧᤀᤢ᤺ᤱᤒᤠ ᤁᤧᤍᤣ᤹ᤒᤠᤜᤠ᤹ ᤂᤧᤴ ᤕᤠᤱᤛᤠᤁᤢᤴᤎᤣᤛᤠᤒᤠᤜᤠ᤹ᤀᤣ ᤔᤧ᤺ᤴᤇᤡᤒᤡ᥅"]},{"type":"verse","number":7,"content":["ᤂᤡᤏᤡ᤹ ᤏᤛᤠ᤺ᤴ ᤁᤧᤈᤥᤃᤢᤶᤒᤠ ᤕᤧᤛᤢ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤏᤢ᤺ᤒᤠ ᤁᤢᤔᤡᤱᤅᤡᤴ ᤆᤠ᤺ᤳᤌᤡ ᤁᤧᤍᤣ᤺ᤒᤠᤜᤠ᤹ ᤂᤧᤱᤜᤠ᤹ᤀᤣ ᤔᤧ᤺ᤴᤇᤡᤒᤡ᥅"]},{"type":"verse","number":8,"content":["ᤛᤧᤰᤂᤠᤀᤣ ᤛᤠᤶᤕᤥᤛᤠᤵᤗᤠᤀᤥ ᤛᤠᤵᤋᤧᤀᤠᤱ ᤁᤧᤒᤵᤐᤠ ᤂᤡᤏᤡ᤹ ᤐᤠᤱᤓᤣ᤹ᤛᤠᤒᤠᤜᤠ᤹ ᤀᤠᤒᤠᤅᤣ ᤁᤢᤀᤡᤛᤡ᤺ᤰᤁᤣ ᤗᤢᤱᤔᤠ᤹ ᤋᤢᤰᤋᤧᤶᤛᤡᤶᤔᤧ᤹ᤀᤥ ᤁᤧᤗ᤹ᤒᤠ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤛᤢᤜᤠᤱᤃᤧᤴ ᤌᤡᤶᤔᤡᤴ ᤁᤧᤀᤡ᤺ᤳᤋᤢᤶ ᤁᤧᤏᤠ᤺ᤳᤋᤢᤶᤏᤧ ᤑᤠ᤹ᤃᤪ ᤏᤢ᤺ᤒᤠᤀᤣ ᤁᤧᤈᤥᤃᤢᤶᤗᤥ॥"]},{"type":"verse","number":9,"content":["ᤁᤖ ᤂᤡᤏᤡ᤹ ᤔᤏᤠᤜᤠ᤹ ᤁᤧᤛᤧᤴᤍᤢᤶᤛᤡᤶᤏᤧ ᤑᤠ᤹ᤃᤪ ᤗᤠᤕᤥ ᤁᤧᤈᤥᤃᤢᤶᤔᤠᤱ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤸᤗᤧ ᤁᤢᤓᤠᤱ ᤁᤧᤓᤣ᤺ᤶᤒᤠ ᤑᤠ᤹ᤀᤠᤱ ᤀᤠᤵᤋᤡᤰ ᤁᤧᤃᤢ᤺ᤳᤋᤡ᤹ᤖᤥ॥"]},{"type":"verse","number":10,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤀᤠᤳᤋᤡᤸᤗᤧ ᤁᤧᤖᤧᤰ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤴ ᤀᤡ᤺ᤳᤋᤢ ᤏᤠ᤺ᤳᤋᤢ᤹ ᤁᤖ ᤗᤳᤌᤡᤰ ᤐᤠ᤺ᤴᤏᤡᤴ ᤑᤣ᤺ᤴᤍᤢᤏᤧ ᤑᤠ᤹ᤃᤪ. ᤂᤧᤸᤗᤧ ᤁᤧᤖᤧᤰ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤴ ᤑᤣ᤺ᤴᤍᤢᤒᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤐᤥ᤺ᤱᤗᤥ॥"]},{"type":"verse","number":11,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ “ᤆᤠᤖᤠᤶᤔᤠ ᤕᤠ᤺ᤶᤒᤰ ᤔᤧᤈᤥᤃᤧᤴᤏᤧ᤹ᤀᤥ” ᤗ᤹ᤖᤡᤰ ᤐᤠ᤺ᤳᤋᤢ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ᤀᤣ “ᤔᤏᤠ ᤔᤧᤛᤧᤖᤧᤴᤏᤧ᤹” ᤗ᤹ᤖᤡᤰᤁᤠᤱ ᤐᤠ᤺ᤳᤋᤢᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥ ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤆᤠᤖᤠᤶᤔᤠ ᤕᤠ᤺ᤶᤒᤰ ᤁᤧᤴᤈᤥᤃᤢᤴᤇᤠᤱ ᤔᤏᤠ ᤁᤧᤛᤧᤳᤏᤧ ᤑᤠ᤹ᤃᤪ. ᤂᤧᤏᤧ᤹ ᤛᤠᤶᤕᤥᤌᤡᤶ ᤁᤧᤓᤣ᤺ᤶᤒᤠ ᤁᤧᤒᤥ᤺ᤱᤗᤥ॥"]},{"type":"verse","number":12,"content":["ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤔᤧᤴᤇᤠᤶ ᤕᤠᤵᤔᤡ᤺ᤴ ᤆᤥ᤺ᤰᤕᤢᤶᤓᤥ ᤁᤧᤒᤡᤒᤠ ᤛᤠᤶᤕᤥᤌᤡᤶᤗᤠᤶ ᤂᤠᤛᤧᤴ ᤂᤥ᤺ᤔᤠ ᤁᤧᤒᤥ᤺ᤱᤒᤠ ᤔᤏᤠ᤺ᤴ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤐᤠᤖᤧᤶᤔᤧ᤹ ᤆᤥᤃᤧᤶᤔᤧ᤹ᤀᤥ."]},{"type":"verse","number":13,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤀᤠᤳᤋᤡᤴ ᤔᤏᤠ᤺ᤸᤗᤧ ᤗᤢᤱᤔᤠ᤹ ᤔᤧᤴᤍᤢᤰᤛᤡᤱᤅᤣ ᤘᤣ᤹ᤜᤠ᤹ ᤂᤠᤛᤧᤴ ᤗᤥ᤺ᤴᤍᤢᤛᤡ᤹. ᤂᤧᤸᤗᤧᤴᤏᤠᤱ ᤁᤢᤄᤠᤛᤧᤴᤏᤡᤴ ᤒᤠ ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰᤁᤣ ᤐᤥ᤺ᤱᤗᤥ॥ ᤘᤣ᤹ᤜᤠ᤹ ᤗᤢᤱᤔᤠ᤹ ᤁᤧᤍᤢᤰᤐᤠᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤂᤠᤛᤧᤴᤏᤡᤴ ᤔᤧᤃᤡᤖᤢᤴᤗᤥ᥄"]},{"type":"heading","content":["ᤕᤠ᤺ᤶᤒᤰ ᤔᤧ᤺ᤴᤏᤣᤒᤠ ᤏᤛᤠ᤺ᤴᤏᤡᤴ ᤁᤢᤗᤡᤱᤎᤥ ᤔᤧᤃᤧᤳᤏᤧᤴ"]},{"type":"verse","number":14,"content":["ᤀᤠᤔᤡ᤺ᤶ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤛᤣ. ᤀᤠᤳᤋᤡᤴ ᤔᤏᤠ᤺ᤸᤗᤧ ᤏᤛᤠ᤺ᤴ ᤁᤳᤋᤢᤱ ᤗ᤹ᤖᤡᤰ ᤐᤠ᤺ᤳᤋᤢ᤹ ᤁᤖ ᤕᤠ᤺ᤶᤒᤰ ᤔᤧᤈᤥᤃᤢᤴᤏᤧ ᤑᤠ᤹ᤃᤪ ᤌᤣ ᤐᤥ᤺ᤰᤂᤧᤀᤠᤱᤒᤣ᥅ ᤜᤧᤰᤋᤱᤒᤠ ᤏᤛᤠ᤺ᤴᤏᤡᤸᤗᤧ ᤂᤧᤴ ᤋᤠᤱᤛᤧ᤺ᤵᤔᤠ ᤛᤢᤰᤋᤢ᤹ᤒᤡ᥅"]},{"type":"verse","number":15,"content":["ᤀᤠᤸᤗ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤀᤡᤃᤪ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ ᤌᤡᤰᤗᤧ ᤆᤠᤱ ᤋᤣ᤺ᤳ ᤔᤧᤃᤳᤋᤢᤴ ᤜᤧᤰᤁᤩᤠᤱ ᤌᤡᤰᤕᤠ᤺ᤴᤎᤰᤐᤠ ᤆᤠᤔᤠ ᤌᤢᤱᤔᤠ ᤌᤣᤀᤠᤱ ᤔᤧᤃᤳᤋᤢᤴ."]},{"type":"verse","number":16,"content":["ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤂᤡᤏᤡ᤹ᤀᤥ ᤌᤡᤰᤁᤡᤸᤗᤧ “ᤏᤢ᤺ᤖᤡᤰᤁᤠᤱ ᤐᤣᤃᤧ᤹ᤀᤥ. ᤏᤢ᤺ᤖᤡᤰ ᤆᤧ᤹ ᤌᤢᤅᤧ᤹ᤀᤠᤱ ᤐᤃᤥᤃᤥ᤺ᤖ ᤘᤕᤧ᤹ᤀᤥ” ᤔᤧᤳᤋᤢ᤹. ᤁᤖ ᤂᤧᤴ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤁᤢᤎᤰᤁᤥ ᤆᤠᤜᤠᤒᤠ ᤁᤧᤈᤥ᤺ᤰᤐᤠ ᤌᤣᤀᤠᤱ ᤁᤢᤓᤠ᤹ ᤔᤧᤒᤡᤖᤢᤴᤏᤧ ᤑᤠ᤹ᤃᤪ ᤌᤣ ᤏᤢ᤺ᤒᤠ ᤐᤥ᤺ᤰᤂᤧᤀᤠᤱᤒᤣ᥅"]},{"type":"verse","number":17,"content":["ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰᤁᤣ ᤏᤛᤠ᤺ᤴᤏᤡᤴ ᤁᤧᤃᤳᤋᤢᤶᤛᤠᤱ ᤂᤧᤴ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤕᤠ᤺ᤶᤒᤰ ᤁᤧᤴᤈᤥᤃᤢᤶᤔᤡᤴᤏᤧ ᤑᤠ᤹ᤃᤪ. ᤂᤧᤴ ᤏᤛᤠ᤺ᤴᤏᤡᤱᤃ ᤁᤢᤛᤢᤶ ᤔᤧᤴᤍᤶᤔᤏᤠᤒᤠ ᤐᤥ᤺ᤱᤗᤥ॥"]},{"type":"verse","number":18,"content":["ᤀᤠᤸᤗ ᤁᤢᤓᤠᤖᤧ ᤔᤧᤒᤠ᤺ᤳᤋᤢᤒᤡᤗᤠ. “ᤂᤧᤏᤧ᤹ ᤏᤛᤠ᤺ᤴ ᤁᤧᤃᤳᤋᤢ᤹. ᤁᤖ ᤀᤡᤱᤃᤠ᤹ ᤕᤠ᤺ᤶᤒᤰ ᤁᤳᤋᤢᤱ॥” ᤁᤖ ᤀᤡᤱᤃᤠ᤹ ᤔᤧᤳᤏᤡᤱ. “ᤂᤧᤏᤧ᤹ ᤕᤠ᤺ᤶᤒᤰᤁᤡᤸᤗᤧ ᤔᤧᤃᤠᤵᤋᤢᤶᤒᤠ ᤁᤧᤏᤛᤠ᤺ᤴᤏᤡᤴ ᤀᤥᤛᤣ᤺ᤴᤎᤠᤰᤋᤠᤱᤅᤧ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤀᤡᤱᤃᤠ᤹ᤀᤠᤱ ᤀᤠᤕᤠ᤺ᤶᤒᤰᤗᤠᤶ ᤀᤠᤏᤛᤠ᤺ᤴᤏᤡᤴ ᤀᤥᤛᤣ᤺ᤴᤎᤠᤰᤏᤧ᤹ᤖᤥ॥”"]},{"type":"verse","number":19,"content":["ᤁᤢᤳᤆᤠ᤹ᤀᤣ ᤌᤡᤰᤗᤰ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤘᤠ᤹ ᤗ᤹ᤖᤡᤰ ᤏᤛᤠ᤺ᤴ ᤁᤧᤈᤥᤃᤢ᤹॥ ᤂᤧᤱᤃ ᤏᤢ᤺ᤒᤠᤖᤥ᥄ ᤑᤧᤴᤛᤠᤶᤜᤠ᤹ᤖᤧᤀᤠᤱ ᤂᤧᤴ ᤐᤠ᤺ᤴᤏᤡᤴ ᤏᤛᤠ᤺ᤴ ᤔᤧᤈᤥᤃᤢᤀᤠᤱ ᤔᤧᤃᤡᤖ ᤌᤧᤃᤰᤁᤰᤏᤠ ᤔᤧᤕᤱᤗᤥ॥"]},{"type":"verse","number":20,"content":["ᤀᤍᤱᤛᤣ. ᤕᤠ᤺ᤶᤒᤰᤁᤡᤸᤗᤧ ᤔᤧᤃᤠᤵᤋᤢᤶᤒᤠ ᤏᤛᤠ᤺ᤴᤏᤡᤴ ᤁᤢᤛᤢᤶ ᤔᤧᤴᤍᤶᤔᤏᤠᤒᤠ ᤐᤥ᤺ᤱ ᤁᤧᤗ᤹ᤒᤠ ᤐᤷᤔᤠᤱᤃᤡ᤺ᤴ ᤁᤧᤃᤥ᤺ᤳᤋᤢᤶᤒᤡ᥅"]},{"type":"verse","number":21,"content":["ᤀᤠᤏᤡ᤹ ᤋᤠᤰᤌᤧᤒᤠ ᤀᤒᤪᤠᤜᤠᤔᤖᤧ ᤁᤢᤛ᤻ᤛᤠ᤺ ᤀᤡᤛᤜᤠᤰᤁᤡᤴ ᤗᤧᤳᤋᤡᤱ ᤋᤥ᤺ᤶᤔᤠᤍᤧᤴᤏᤥ ᤛᤡᤍᤢᤱᤈᤓᤠ ᤆᤥ᤺ᤰᤛᤧ ᤋᤥ᤺ᤴᤍᤢᤒᤠ ᤕᤠ᤺ᤶᤒᤰᤁᤡᤸᤗᤧᤀᤣ ᤂᤢᤏᤧ᤹ ᤀᤠᤵᤋᤡᤰ ᤔᤧ᤺ᤴᤏᤣᤒᤠ ᤆᤥᤃᤢᤒᤠ ᤔᤧ᤺ᤶᤒᤡ᥅"]},{"type":"verse","number":22,"content":["ᤂᤢᤏᤧ᤹ ᤁᤢᤏᤛᤠ᤺ᤴᤏᤡᤴ ᤁᤢᤕᤠ᤺ᤶᤒᤰᤁᤡᤸᤗᤧ ᤁᤠᤵᤋᤢᤒᤠᤴ ᤏᤢ ᤒᤠ ᤂᤧᤴ ᤕᤠ᤺ᤶᤒᤰᤁᤡᤸᤗᤧᤀᤣ ᤁᤢᤏᤛᤠ᤺ᤴᤏᤡᤴ ᤁᤢᤗᤡᤱᤎᤥ ᤁᤧᤳᤋᤢᤒᤠᤴ ᤁᤧᤏᤡ᤺ᤛᤢᤶᤗᤥ॥"]},{"type":"verse","number":23,"content":["ᤁᤴ ᤐᤠ᤺ᤴᤏᤡᤱᤃ ᤛᤠᤶᤕᤥᤛᤠᤵᤗᤠ᤺ᤸᤗᤧ ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤐᤠ᤺ᤳᤋᤢᤒᤠᤴ ᤁᤧᤖᤧᤒᤠᤖᤥ. “ᤀᤒᤪᤠᤜᤠᤔᤖᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤏᤛᤠ᤺ᤴ ᤆᤥᤃᤢ. ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤂᤢᤏᤧ᤹ ᤛᤠᤶᤕᤥᤏᤡᤒᤠ ᤗᤣ᤺ᤳᤋᤢᤖᤥ॥”",{"noteId":2},"ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤀᤠᤴᤈᤢᤶ ᤑᤠ᤹ᤀᤠᤱ ᤔᤧᤳᤋᤢᤖᤥ॥"]},{"type":"verse","number":24,"content":["ᤏᤛᤠ᤺ᤴᤗᤠᤶᤖᤰ ᤔᤧ᤺ᤴ. ᤁᤖ ᤀᤠᤏᤡ᤹ ᤀᤠᤈᤥᤃᤢᤶᤒᤠ ᤕᤠ᤺ᤶᤒᤰᤗᤠᤶᤔᤠᤱ ᤀᤠᤵᤋᤡᤰ ᤔᤧ᤺ᤴᤏᤣᤒᤠ ᤀᤠᤒᤥ᤺ᤱ ᤑᤠ᤹ᤀᤠᤱ ᤁᤧᤏᤡ᤺ᤛᤢᤶᤗᤥ॥"]},{"type":"verse","number":25,"content":["ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰᤁᤣ ᤁᤧᤳᤏᤡᤔᤠ ᤖᤠᤜᤠᤒᤖᤧ ᤌᤥ᤺ᤶᤈᤡᤒᤠᤜᤠ᤹ ᤋᤖᤣ ᤋᤥ᤺ᤛᤢᤛᤡᤀᤠᤱ ᤂᤧᤱᤜᤠ᤹ ᤋᤠᤱᤛᤧ᤺ᤵᤛᤧ ᤘᤣ᤹ ᤗᤠᤶ ᤐᤠᤱᤄᤢᤛᤡᤒᤠ ᤁᤢᤕᤠ᤺ᤶᤒᤰᤁᤡᤸᤗᤧᤀᤣ ᤂᤧᤴ ᤀᤠᤵᤋᤡᤰ ᤔᤧ᤺ᤴᤏᤣᤔᤠ ᤐᤥ᤺ᤰᤂᤧᤖᤥ॥"]},{"type":"verse","number":26,"content":["ᤕᤠᤶᤛᤠᤶ ᤔᤧ᤺ᤴᤏᤣᤒᤠ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤌᤰᤁᤡᤴ ᤁᤢᤛᤡᤘᤧᤳ ᤐᤥ᤺ᤱᤒᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰᤁᤣ ᤕᤠ᤺ᤶᤒᤰ ᤔᤧ᤺ᤴᤏᤣᤒᤠ ᤏᤛᤠ᤺ᤴᤏᤡᤴᤏᤠᤱ ᤁᤢᤛᤡᤘᤧᤳ ᤐᤥ᤺ᤱᤗᤥ॥"]}],"footnotes":[{"noteId":2,"caller":"*","text":"ᤋᤥᤗᤡᤱᤛᤥᤔᤢ ᥇᥋.᥌","reference":{"chapter":2,"verse":23}}]},"thisChapterLink":"/api/lif_wbt/JAS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lif_wbt/JAS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lif_wbt/JAS/1.json","previousChapterAudioLinks":{},"numberOfVerses":26}