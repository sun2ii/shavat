{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"JAS","translationId":"lif_wbt","name":"ᤕᤠᤁᤢᤒ","commonName":"ᤕᤠᤁᤢᤒ","title":"ᤕᤠᤁᤢᤒᤖᤧ ᤛᤠᤵᤋᤢᤒᤠ ᤛᤰᤀᤡᤱᤄᤱ","order":59,"numberOfChapters":5,"sha256":"63c0d9c5409fe50e6609f1c160d11e6956279afe3ae333005dcf6dc7504cca01","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/JAS/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/lif_wbt/JAS/5.json","totalNumberOfVerses":108},"chapter":{"number":3,"content":[{"type":"heading","content":["ᤗᤧᤛᤥ᤺ᤵᤐᤧᤴ ᤕᤢᤰᤁᤥ ᤁᤵᤔᤠ"]},{"type":"verse","number":1,"content":["ᤀᤠᤔᤡ᤺ᤶ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤛᤣ. ᤂᤡᤏᤡ᤹ ᤗᤢᤶᤔᤥ ᤕᤖᤡᤰ ᤛᤡᤰᤛᤠᤶᤒᤠ ᤐᤥ᤺ᤱᤔᤠ ᤔᤧᤃᤥ᤺ᤳᤋᤧᤶᤔᤡᤴᤏᤧ᤹ᤀᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤀᤠᤏᤡ᤹ ᤛᤡᤰᤛᤠᤶᤒᤠᤜᤠ᤹ ᤘᤣ᤹ᤜᤠ᤹ᤏᤢ᤺ᤸᤗᤧ ᤁᤧᤛᤠᤰᤐᤠ ᤂᤠᤛᤧᤴᤏᤥ ᤀᤠᤎᤠ᤹᤺ ᤁᤧᤗ᤹ᤒᤠᤴ ᤁᤧᤏᤡ᤺ᤛᤢᤶᤗᤥ॥"]},{"type":"verse","number":2,"content":["ᤀᤠᤏᤡ᤹ ᤁᤧᤖᤧᤰ ᤕᤖᤡᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ᤀᤥ ᤀᤠᤒᤣ᤺ᤴᤗᤥ. ᤁᤖ ᤀᤠᤳᤋᤡᤴ ᤔᤏᤠ᤺ᤴ ᤀᤠᤒᤠᤅᤣ ᤐᤠ᤺ᤳᤋᤢᤒᤠ ᤐᤠ᤺ᤴᤏᤥ ᤔᤧᤒᤣ᤺ᤴᤏᤡᤴᤏᤧ ᤑᤠ᤹ᤃᤪ ᤛᤧᤰᤂᤠᤛᤠᤱ ᤂᤧᤸᤗᤧᤃ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤁᤢᤎᤰᤁᤡᤴ ᤕᤢᤰᤁᤥ ᤁᤵᤔᤠ ᤛᤢᤰᤋᤢ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤴ ᤔᤏᤠ᤺ᤴ ᤁᤢᤗᤡᤱᤎᤥ ᤁᤧᤃᤧᤵᤐᤠ ᤐᤥ᤺ᤱᤗᤥ॥"]},{"type":"verse","number":3,"content":["ᤀᤴᤏᤡᤸᤗᤧ ᤁᤢᤔᤢᤖᤠᤀᤥ ᤆᤢᤰᤛᤠ ᤁᤖᤧᤗᤡ᤺ᤴ ᤁᤣ᤺ᤵᤔᤠᤀᤠᤱ ᤂᤧᤴ ᤕᤶᤒᤠ ᤌᤰᤛᤠ᤺ᤴ ᤀᤠᤳᤋᤠᤴ ᤋᤣ᤹ᤔᤠ ᤏᤡᤱᤘᤠ᤹ ᤀᤠᤈᤥᤃᤢᤶ ᤂᤧᤵᤔᤥᤀᤣ ᤋᤣ᤹ᤔᤠ ᤀᤠᤛᤢᤰᤋᤢᤶᤗᤥ॥"]},{"type":"verse","number":4,"content":["ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰᤁᤣ ᤘᤠᤗᤠᤎᤠ᤺ᤴ ᤕᤶᤒᤠ ᤆᤥ᤺ᤰ. ᤜᤧᤰᤁᤩᤠᤱ ᤕᤶᤒᤠ ᤛᤢᤖᤡᤳᤋᤡᤸᤗᤧ ᤔᤢ᤺ᤳᤋᤢ ᤋᤣ᤹ᤖᤢᤛᤠᤱ ᤘᤠᤍᤥ ᤆᤠ᤺ᤰᤐᤠᤸᤗᤧ ᤏᤠ ᤁᤳᤏᤠ ᤁᤧᤜᤡᤒᤠ ᤆᤢᤰᤛᤠ ᤛᤠᤔᤠ᤺ᤸᤗᤧ ᤘᤠᤗᤠᤎᤠ᤺ᤴ ᤀᤠᤳᤋᤠᤴᤛᤠᤱ ᤋᤣ᤹ᤔᤠ ᤛᤢᤰᤋᤢ᤹ᤖᤥ॥"]},{"type":"verse","number":5,"content":["ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰᤁᤣ ᤗᤧᤛᤥ᤺ᤵᤐᤧᤴᤏᤠᤱ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤌᤰᤁᤥ ᤆᤢ᤺ᤰᤛᤠᤱ ᤁᤴ ᤕᤶᤒ᤻ ᤕᤶᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤸᤗᤧ ᤁᤢᤕᤠ᤺ᤶᤒᤣᤀᤥ ᤀᤠᤱᤍᤡᤱ ᤗ᤹ᤖᤥ॥ ᤆᤢᤰᤛᤠ ᤔᤡᤛᤣ᤺ᤰᤁᤡᤸᤗᤧ ᤕᤶᤒᤠ ᤋᤠᤶᤓᤢᤱᤅᤡᤴ ᤂᤠᤵᤐᤢ ᤌᤩ᤺ᤱ ᤆᤥ᤺ᤰᤔᤠ ᤛᤢᤰᤋᤢ᤹ᤖᤥ ᤗ᤹ᤖᤡᤰ ᤀᤡ᤺ᤳᤋᤧᤶᤔᤧ᤹ᤀᤥ᥄"]},{"type":"verse","number":6,"content":["ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰᤁᤣ ᤗᤧᤛᤥ᤺ᤵᤐᤠᤱᤃ ᤔᤡ ᤜᤧᤰᤋᤱᤒᤠᤖᤥ॥ ᤁᤱᤃ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤌᤰᤁᤥ ᤋᤠᤵᤑᤧ᤺ᤶᤒᤠ ᤐᤠ᤺ᤴᤜᤠ᤹ᤖᤧ ᤁᤢᤒᤢᤱᤗᤥ॥ ᤂᤧᤴ ᤗᤧᤛᤥ᤺ᤵᤐᤠᤸᤗᤧ ᤔᤏᤠ᤺ᤸᤗᤧ ᤁᤠᤰ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤁᤢᤎᤰᤁᤡᤴ ᤆᤡ᤺ᤴᤍᤢ᤹ᤀᤠᤱ ᤁᤢᤜᤡᤱᤔᤴᤏᤡᤴ ᤁᤧᤖᤧᤰ ᤔᤡᤎᤡᤰᤂᤢ᤹ᤖᤥ॥ ᤂᤧᤴ ᤔᤡᤱᤃ ᤂᤧᤔᤠᤕᤱᤛᤱᤗᤠᤶᤔᤣ ᤗ᤺ᤴᤗᤥ॥"]},{"type":"verse","number":7,"content":["ᤁᤠᤰ ᤐᤖᤡᤰᤐᤠ ᤌᤰᤛᤠ ᤐᤢᤛᤠ. ᤁᤧᤀᤢ᤺ᤱᤛᤡᤱᤒᤠ ᤁᤧᤛ᤺ᤴᤇᤡᤱᤒᤠ ᤏᤢ ᤘᤠᤜᤱᤅᤥᤒᤠ ᤌᤰᤛᤠᤜᤠ᤹ ᤂᤢᤶᤔᤠ ᤛᤢᤰᤔᤧᤍᤧᤳᤗᤥ. ᤜᤧᤰᤁᤩᤠᤱ ᤔᤧᤴᤇᤠᤶ ᤕᤠᤵᤔᤡᤜᤠ᤹ᤖᤧ ᤂᤧᤱᤜᤠ᤹ ᤔᤧᤄᤢᤶᤛᤢᤛᤡ᤹ᤖᤥ."]},{"type":"verse","number":8,"content":["ᤁᤖ ᤗᤧᤛᤥ᤺ᤵᤐᤠᤱᤃ ᤀᤠᤳᤋᤡᤴ ᤔᤏᤠ᤺ᤸᤗᤧᤀᤠᤱ ᤂᤢᤶᤔᤠ ᤔᤧᤛᤢᤰᤋᤢᤴᤗᤥ॥ ᤁᤱᤃ ᤕᤢᤰᤁᤥ ᤁᤵᤔᤠ ᤛᤢᤰᤔᤧᤴᤍᤧᤵᤔᤏᤠ ᤋᤠᤵᤑᤧ᤺ᤶᤒᤠ ᤆᤥ᤺ᤰ. ᤜᤧᤰᤁᤩᤠᤱ ᤔᤧᤴᤇᤠᤶ ᤕᤠᤵᤔᤡ ᤁᤧᤛᤧᤵᤐᤠ ᤏᤡᤱᤅᤡᤸᤗᤧ ᤁᤢᤎᤡᤶᤒᤠ ᤆᤥ᤺ᤰᤗᤥ॥"]},{"type":"verse","number":9,"content":["ᤒᤠ ᤁᤴ ᤗᤧᤛᤥ᤺ᤵᤐᤠᤸᤗᤧᤀᤣ ᤀᤠᤏᤡ᤹ ᤍᤠᤱᤒᤠ ᤏᤢ ᤐᤠᤏᤢᤍᤡᤱ ᤐᤠ᤺ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤏᤠᤖᤠ ᤀᤠᤓᤥ᤺ᤛᤢᤶ. ᤜᤧᤰᤁᤩᤠᤱ ᤒᤠ ᤁᤴᤗᤠᤶᤒᤠᤀᤣ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤀᤠᤒᤠᤅᤣ ᤁᤢᤒᤡ ᤁᤢᤀᤡᤳᤇᤠᤵᤐᤥ ᤆᤥᤃᤢᤛᤡᤒᤠ ᤔᤧᤴᤇᤠᤶ ᤕᤠᤵᤔᤡᤜᤠ᤹ ᤛᤠᤰᤔᤢᤖᤠ ᤀᤠᤔᤧᤳᤋᤢᤶᤛᤡᤶᤗᤥ॥"]},{"type":"verse","number":10,"content":["ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤗᤳᤇᤠ ᤔᤢᤖᤠᤀᤥᤗᤠᤶ ᤔᤢ᤹ᤀᤡᤛᤠᤶ ᤏᤢ ᤛᤠᤰᤔᤢᤖᤠ᤺ᤴ ᤗ᤺ᤴᤗᤥ॥ ᤀᤠᤔᤡ᤺ᤶ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤛᤣ. ᤀᤰᤂᤣ ᤐᤥ᤺ᤱᤔᤠᤃ ᤔᤧᤏᤢ᤹ᤏᤧᤴᤗᤥ॥"]},{"type":"verse","number":11,"content":["ᤗᤳᤌᤡᤰ ᤘᤠᤒᤢᤴᤏᤥᤗᤠᤶ ᤁᤢᤈᤠ ᤁᤧᤏᤢ᤹ᤒᤠ ᤏᤢ ᤁᤧᤗᤠ᤺ᤰᤐᤠ ᤆᤫᤠ᤺ᤳᤋᤡᤴ ᤐᤢᤴᤒᤡ᥅"]},{"type":"verse","number":12,"content":["ᤀᤠᤔᤡ᤺ᤶ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤛᤣ. ᤐ᤺ᤳᤇᤣ᤹ᤀᤡᤸᤗᤧ ᤁᤢᤒᤢᤱᤔᤥ ᤈᤤᤋᤢᤏᤧᤸᤗᤧ ᤁᤢᤛᤣ᤹ ᤌᤥ᤺ᤰᤐᤡ. ᤀᤡᤃᤪ ᤆᤧᤸᤗᤧᤰᤛᤣ᤹ᤀᤡᤸᤗᤧ ᤁᤢᤒᤢᤱᤔᤥ ᤐ᤺ᤳᤇᤣ᤹ᤀᤡᤴ ᤌᤥ᤺ᤰᤐᤡ᥅ ᤔᤧᤎᤥ᤺ᤰᤏᤧᤴᤗᤥ᥄ ᤜᤧᤰᤁᤩᤠᤱ ᤁᤧᤗᤠ᤺ᤰᤐᤠ ᤘᤠᤒᤢᤴᤏᤥᤗᤠᤶ ᤁᤢᤈᤠ ᤁᤧᤏᤢ᤹ᤒᤠ ᤆᤫᤠ᤺ᤳᤋᤡᤴ ᤔᤧᤒᤢᤴᤏᤧᤴᤗᤥ॥"]},{"type":"heading","content":["ᤛᤧᤰᤂᤠᤒᤠ ᤛᤡᤰᤁᤢᤶᤍᤡᤱ ᤏᤡᤱᤘᤠ᤹ᤀᤡᤴ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤗᤠᤶ ᤋᤠ᤺"]},{"type":"verse","number":13,"content":["ᤂᤡᤏᤡ᤹ ᤗᤢᤶᤔᤥ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤏᤡᤱᤘᤠ᤹ ᤜᤧᤰᤁᤣ ᤛᤡᤰᤁᤢᤶᤛᤠᤒᤠ ᤏᤢ ᤀᤡᤳᤇᤡᤱᤛᤠᤶᤛᤠᤒᤠᤸᤗᤧ ᤏᤢ᤺ᤒᤠ ᤁᤢᤜᤡᤱᤔᤴᤏᤥᤗᤠᤶ ᤜᤧᤰᤁᤩᤠᤱ ᤛᤡᤰᤁᤢᤶᤍᤡᤱ ᤏᤡᤱᤘᤠ᤹ᤗᤠᤶ ᤁᤧᤍᤠ᤺ᤒᤠ ᤆᤢᤱᤈᤡᤃᤧᤴ ᤏ᤺ᤶᤏ᤺ᤶᤔᤥ ᤆᤥᤃᤢᤒᤠ ᤕᤠ᤺ᤶᤒᤰᤁᤥᤗᤠᤶ ᤀᤥᤛᤣ᤺ᤴᤎᤠᤰᤛᤡᤱᤗᤖᤥ॥"]},{"type":"verse","number":14,"content":["ᤁᤖ ᤂᤡᤏᤡ᤹ ᤋᤡᤱᤍᤡᤱᤃᤧᤴ ᤏᤠᤜᤧᤶᤔᤠ ᤏᤢ ᤀᤠᤒᤠᤅᤣᤖᤰ ᤏᤢ᤹ᤔᤠ ᤋᤠ᤺ᤔᤠ ᤏᤡᤱᤘᤠ᤹ ᤁᤧᤃᤳᤋᤢᤶᤏᤧ ᤑᤠ᤹ᤃᤪ ᤂᤡᤏᤡ᤹ ᤛᤧᤰᤂᤠᤀᤣ ᤁᤧᤈᤥᤃᤢᤶᤒᤠ ᤗᤠᤕᤥ᤺ᤴ ᤀᤠᤱᤍᤡᤱ ᤁᤧᤗ᤹ᤖᤡᤖ ᤜᤧᤰᤁᤩᤠᤱ ᤀᤡᤱᤗᤧᤰ ᤁᤧᤒᤠᤖᤡᤖ ᤔᤧᤔᤠ᤹ᤖᤧᤶᤔᤡᤴᤏᤧ᤹ᤀᤥ॥"]},{"type":"verse","number":15,"content":["ᤀᤰᤋᤱᤒᤠ “ᤛᤡᤰᤁᤢᤶᤍᤡᤱ ᤏᤡᤱᤘᤠ᤹ᤀᤡᤱᤃ” ᤌᤠ᤺ᤱ ᤛᤠᤱᤃᤪᤠᤶᤐ