{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"JAS","translationId":"lif_wbt","name":"ᤕᤠᤁᤢᤒ","commonName":"ᤕᤠᤁᤢᤒ","title":"ᤕᤠᤁᤢᤒᤖᤧ ᤛᤠᤵᤋᤢᤒᤠ ᤛᤰᤀᤡᤱᤄᤱ","order":59,"numberOfChapters":5,"sha256":"63c0d9c5409fe50e6609f1c160d11e6956279afe3ae333005dcf6dc7504cca01","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/JAS/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/lif_wbt/JAS/5.json","totalNumberOfVerses":108},"chapter":{"number":4,"content":[{"type":"heading","content":["ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤥ ᤀᤠᤒᤠᤅᤣ ᤐᤡᤀᤠᤛᤧᤶᤔᤧ᤹ᤀᤥ"]},{"type":"verse","number":1,"content":["ᤂᤡᤏᤡ᤹ ᤗᤢᤶᤔᤥ ᤌᤧᤔᤠ᤺ᤸᤗᤧ ᤂᤣᤔᤠ ᤌᤰᤔᤠᤜᤠ᤹ ᤋᤠᤖᤢ᤹ᤒᤣ᥅ ᤂᤧᤱᤜᤠ᤹ᤃ ᤂᤡᤏᤡ᤹ ᤛᤡᤃᤠᤱ ᤌᤱ ᤁᤧᤈᤥ᤺ᤰᤐᤠ ᤑᤧᤴ ᤏᤡᤱᤘᤠ᤹ᤗᤠᤶ ᤗ᤺ᤶᤒᤠ ᤔᤧ᤺ᤶᤒᤡ᥅"]},{"type":"verse","number":2,"content":["ᤂᤡᤏᤡ᤹ ᤂᤥ᤺ᤔᤠ ᤏᤡᤱᤘᤠ᤹ ᤁᤧᤈᤥᤃᤢᤶ. ᤁᤖ ᤁᤧᤱᤄᤥ᤺ᤛᤢᤶᤔᤡᤴ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤡ᤺ᤶᤒᤪᤠᤰ ᤁᤧᤈᤥᤃᤢᤶᤔᤠᤱ ᤔᤏᤠ ᤁᤧᤛᤧᤖᤢᤶᤛᤡᤶᤗᤥ॥ ᤜᤧᤰᤁᤣᤛᤠᤱ ᤂᤡᤏᤡ᤹ ᤏᤡᤱᤘᤠ᤹ ᤁᤧᤈᤥᤃᤢᤶᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤂᤥ᤺ᤔᤠ ᤁᤧᤴᤇᤢᤰᤋᤢᤶᤔᤡᤴ ᤜᤧᤰᤁᤩᤠᤱ ᤁᤧᤄᤣ᤹ᤀᤡ ᤁᤧᤎᤰᤋᤡ᤹॥ ᤀᤠᤸᤗᤛᤠᤱ ᤁᤧᤱᤄᤥ᤺ᤛᤢᤶᤔᤡᤴ ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤡᤏᤡ᤹ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤁᤧᤴᤏᤠ᤺ᤰᤋᤢᤶᤔᤡᤴᤗᤥ॥"]},{"type":"verse","number":3,"content":["ᤂᤡᤏᤡ᤹ ᤁᤧᤏᤠ᤺ᤰᤋᤢᤶ ᤁᤖ ᤁᤧᤱᤄᤥ᤺ᤛᤢᤶᤔᤡᤴ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤡᤏᤡ᤹ ᤀᤠᤒᤠᤅᤣ ᤏᤡᤱᤘᤠ᤹ ᤐᤠ᤺ᤵᤐᤠ᤺ᤳ ᤆᤥ᤺ᤰᤔᤠ ᤑᤠ᤹ᤀᤠᤱ ᤑᤧᤴ ᤏᤡᤱᤘᤠ᤹ᤀᤡᤸᤗᤧ ᤁᤧᤏᤠ᤺ᤰᤋᤢᤶᤗᤥ॥"]},{"type":"verse","number":4,"content":["ᤏᤛᤠ᤺ᤴ ᤔᤧᤴᤈᤥ᤺ᤰᤔᤏᤠᤒᤠᤛᤣ. ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥᤒᤠ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤔᤡ᤺ᤶᤈᤡ ᤁᤧᤔᤧᤵᤐᤧᤴ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤏᤡᤱᤔᤡ ᤐᤥ᤺ᤱ ᤑᤠ᤹ᤀᤠᤱ ᤁᤢᤛᤡᤱ ᤁᤧᤴᤏᤡ᤺ᤳᤋᤢᤶᤔᤡᤴᤒᤡ᥅ ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥᤒᤠ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤔᤡ᤺ᤶᤈᤡ ᤁᤧᤔᤧᤵᤐᤧᤱᤃ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤏᤡᤱᤔᤡ ᤐᤥ᤺ᤱᤗᤥ॥"]},{"type":"verse","number":5,"content":["ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤀᤠᤏᤡ᤹ᤀᤥ ᤕᤢᤰᤂᤢᤒᤠ ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤸᤗᤧ ᤛᤠ᤹ᤖᤡᤰᤁᤣ ᤁᤢᤏᤠᤜᤧᤴ ᤑᤠ᤹ᤀᤠᤱ ᤛᤠᤶᤕᤥᤛᤠᤵᤗᤠᤀᤥ ᤛᤠᤵᤋᤧᤀᤠᤱ ᤁᤧᤒᤵᤐᤧᤴ ᤜᤏᤧᤖᤥ ᤑᤠ᤹ᤀᤠᤱ ᤁᤧᤀᤡ᤺ᤳᤋᤢᤶᤒᤡ᥅"]},{"type":"verse","number":6,"content":["ᤁᤖ ᤂᤧᤴᤏᤢ᤺ᤸᤗᤧᤀᤠᤱ ᤛᤠ᤹ᤖᤡᤰ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤗᤢᤱᤔᤠ᤹ ᤀᤠᤍᤢᤰᤗᤥ॥ ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤕᤠᤶᤔᤥ ᤛᤠᤶᤕᤥᤛᤠᤵᤗᤠ᤺ᤸᤗᤧ ᤐᤠ᤺ᤳᤋᤢ᤹.",{"text":"“ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤀᤠᤱᤍᤡᤱ ᤁᤧᤗ᤹ᤒᤠᤜᤠ᤹ ᤀᤳᤋᤢᤛᤡ᤹. ᤁᤖ ᤏ᤺ᤶᤏ᤺ᤶᤒᤠᤜᤠ᤹ ᤗᤢᤱᤔᤠ᤹ ᤋᤢᤰᤋᤢᤛᤡ᤹ᤖᤥ॥”","poem":1},{"noteId":3}]},{"type":"verse","number":7,"content":["ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤏ᤺ᤶᤏ᤺ᤶᤒᤠ ᤐᤥ᤺ᤰᤂᤧᤶᤔᤧ᤹ᤀᤠᤱ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤥ ᤀᤠᤒᤠᤅᤣ ᤐᤡᤀᤠᤛᤡᤶᤔᤧ᤹ᤀᤥ॥ ᤔᤠᤑᤧᤴᤛᤠᤶᤔᤡᤴ ᤀᤳᤋᤧᤶᤔᤧ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤴ ᤂᤡᤏᤡ᤹ᤗᤠᤶ ᤔᤠ᤺ᤱᤄᤠ ᤂᤧᤳᤇᤡᤱᤗᤥ॥"]},{"type":"verse","number":8,"content":["ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤒᤣᤛᤠᤱ ᤋᤩᤧᤶᤔᤧ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ᤀᤠᤱ ᤂᤡᤏᤡ᤹ ᤐᤣᤛᤠᤱ ᤋᤠ᤺ᤖᤥ॥ ᤂᤡᤏᤡ᤹ ᤗᤠᤕᤥᤒᤠᤛᤣ. ᤗᤠᤕᤥ ᤆᤥ᤺ᤰᤔᤠ ᤗᤧᤖᤧᤶᤔᤧ᤹ᤀᤥ. ᤜᤧᤰᤁᤩᤠᤱ ᤜᤡᤸᤗᤡᤰᤗᤡᤰᤐᤠ ᤏᤡᤱᤘᤠ᤹ ᤁᤧᤃᤵᤐᤠᤛᤣ. ᤂᤡᤏᤡ᤹ ᤛᤡᤰᤗᤢᤱᤔᤠᤴ ᤛᤣᤛᤣ ᤆᤥᤃᤧᤶᤔᤧ᤹ᤀᤥ"]},{"type":"verse","number":9,"content":["ᤗᤠᤕᤥ ᤁᤧᤈᤥᤃᤢᤶᤒᤠᤀᤥ ᤔᤣᤖᤡᤱ ᤌᤰᤋᤧᤶᤔᤧ᤹. ᤜᤠᤒᤧᤶᤔᤧ᤹ᤀᤥ॥ ᤂᤡᤏᤡ᤹ ᤀᤣ᤺ᤵᤔᤠᤴ ᤔᤣᤖᤡᤱ ᤌᤰᤔᤥ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤡᤏᤡ᤹ ᤛ᤺ᤵᤔᤧᤴ ᤋᤢᤰᤂᤣᤀᤥ ᤗᤧᤰᤂᤧᤶᤔᤧ᤹ᤀᤥ॥"]},{"type":"verse","number":10,"content":["ᤍᤠᤱᤒᤠᤸᤗᤧ ᤁᤢᤍᤃᤡ ᤏ᤺ᤶᤏ᤺ᤶᤒᤠ ᤐᤥ᤺ᤰᤂᤧᤶᤔᤧ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤡᤏᤡ᤹ ᤔᤡᤱᤛᤥ ᤀᤡᤱᤎᤠ᤺ᤱ ᤁᤧᤓᤥ᤺ᤛᤡ ᤁᤧᤒᤡᤖᤡ᤹ᤖᤥ॥"]},{"type":"heading","content":["ᤆᤧᤱᤛᤡᤱᤔᤠ ᤔᤧ᤺ᤴ"]},{"type":"verse","number":11,"content":["ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤛᤣ. ᤘᤣ᤹ᤜᤠ᤹ᤖᤧ ᤋᤰᤗᤧᤱᤘᤠᤀᤥ ᤋᤠᤵᤑᤧ᤺ᤶᤒᤠ ᤐᤠ᤺ᤴ ᤔᤧᤒᤠᤖᤧᤶᤔᤡᤴᤏᤧ᤹ᤀᤥ॥ ᤀᤠᤳᤋᤡᤴ ᤁᤢᤴᤛᤠ᤹ᤖᤧ ᤁᤢᤍᤰᤗᤧᤱᤘᤠᤀᤥ ᤋᤠᤵᤑᤧ᤺ᤶᤒᤠ ᤑᤧᤴ ᤐᤠ᤺ᤴ ᤐᤠ᤺ᤳ ᤀᤡᤃᤪ ᤀᤠᤳᤋᤡᤸᤗᤧ ᤁᤢᤴᤛᤠ᤹ ᤀᤠᤵᤋᤡᤰ ᤁᤢ᤺ᤳᤋᤢ᤹. ᤂᤧᤱᤃ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤸᤗᤧ ᤁᤢᤍᤰᤗᤧᤱᤘᤠᤀᤥ ᤐᤠ᤺ᤳᤋᤠᤱ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤴ ᤂᤠᤛᤧᤴ ᤗᤥ᤺ᤴᤍᤢ᤹ᤖᤥ॥ ᤀᤠᤸᤗ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤴ ᤂᤠᤛᤧᤴ ᤁᤧᤗᤥ᤺ᤴᤍᤢ᤹ᤏᤧ ᤑᤠ᤹ᤃᤪ. ᤛᤠᤶᤕᤥᤌᤡᤶ ᤁᤧᤀᤡ᤺ᤵᤐᤠ ᤁᤧᤏᤠ᤺ᤵᤐᤠ ᤔᤧ᤺ᤴ. ᤁᤖ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤸᤗᤧᤴ ᤂᤠᤛᤧᤴᤗᤥ᤺ᤶᤒᤠ ᤁᤧᤒᤥ᤺ᤱᤗᤥ॥"]},{"type":"verse","number":12,"content":["ᤛᤠᤶᤕᤥᤌᤡᤶ ᤁᤧᤒᤡᤒᤠ ᤏᤢ ᤂᤠᤛᤧᤴᤍᤠᤱᤒᤠᤃ ᤌᤡᤰᤗᤰ ᤘᤠ᤹ᤖᤥ॥ ᤂᤢᤏᤧ᤹ᤏᤢᤀᤣ ᤋᤠᤱᤛᤧ᤺ᤵᤔᤠ ᤏᤢ ᤔᤧᤱᤔᤠ ᤔᤢᤰᤛᤠᤶ ᤘᤠ᤹ᤖᤥ॥ ᤁᤖ ᤂᤧᤏᤧ᤹ᤃ ᤀᤠᤒᤠᤅᤣ ᤐᤠᤱᤓᤣ᤹ᤛᤠᤒᤠᤜᤠ᤹ ᤀᤠᤵᤋᤡᤰ ᤁᤧᤃᤢ᤺ᤵᤐᤧᤴ ᤜᤠ᤺ᤳᤏᤧᤒᤣ᥅"]},{"type":"heading","content":["ᤋᤠᤕᤧᤶᤔᤡᤸᤗᤧ ᤁᤢᤕᤠ᤺ᤶᤒᤣᤀᤥ ᤀᤠᤱᤍᤡᤱ ᤗ᤹ᤔᤠ ᤔᤧ᤺ᤴ"]},{"type":"verse","number":13,"content":["ᤀᤠᤀᤡᤴ ᤀᤡᤃᤪ ᤋᤠ᤺ᤴᤍᤡᤰ ᤀᤠᤏᤡᤃᤧ ᤕᤧᤰᤕᤰᤌᤡᤰᤁᤥ ᤐᤡᤃᤡᤃᤧ᤹ᤀᤠᤱ ᤂᤧᤵᤔᤥ ᤋᤱᤒᤣᤎᤡᤰ ᤘᤕᤡᤃᤧ. ᤜᤧᤰᤁᤩᤠᤱ ᤗᤧᤱᤜᤱ ᤆᤥᤃᤢᤶᤒᤧ᤹ᤀᤠᤱ ᤕᤠᤱ ᤌᤃᤢᤶᤒᤧ᤹ ᤗ᤹ᤖᤡᤰ ᤁᤧᤒᤠ᤺ᤵᤐᤠᤛᤣ. ᤏᤢ᤺ᤖᤡᤰᤁᤠᤱ ᤂᤧᤵᤛᤧᤶᤔᤧ᤹ᤀᤥ."]},{"type":"verse","number":14,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤋᤠ᤺ᤴᤍᤡᤰ ᤌᤣ ᤐᤥ᤺ᤱ ᤁᤧᤗ᤹ᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤂᤡᤏᤡ᤹ ᤁᤧᤴᤏᤡ᤺ᤛᤢᤶᤔᤡᤴᤗᤥ॥ ᤂᤡᤏᤡ᤹ ᤜᤡᤱᤔᤴᤏᤡᤱᤃ ᤛᤵᤑᤠᤎᤡᤰ ᤁᤧᤎᤠ᤺ᤵᤐᤠᤀᤠᤱ ᤁᤧᤔᤠᤒᤠ ᤁᤧᤒᤣ᤺ᤰᤐᤠ ᤋᤢᤱᤜᤡ᤺ᤰ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤆᤥ᤺ᤰᤗᤥ॥"]},{"type":"verse","number":15,"content":["ᤂᤡᤏᤡ᤹ ᤜᤧᤰᤁᤣ ᤐᤠ᤺ᤵᤔᤠᤸᤗᤧ ᤁᤢᤗᤧᤰᤘᤠᤃ ᤍᤠᤱᤒᤠᤸᤗᤧ ᤁᤢᤏᤡᤱᤘᤠ᤹ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤐᤥ᤺ᤱᤏᤧ ᤑᤠ᤹ᤃᤪ ᤜᤡᤅᤡᤃᤧᤀᤠᤱ ᤀᤰᤂᤣ ᤜᤧᤰᤁᤣ ᤆᤥᤃᤢᤶᤒᤧ᤹ ᤐᤠ᤺ᤵᤔᤠ ᤁᤧᤒᤥ᤺ᤱᤒᤠᤏᤧ ᤘᤕᤧ॥"]},{"type":"verse","number":16,"content":["ᤁᤖ ᤂᤡᤏᤡ᤹ᤃ ᤀᤠᤒᤠᤅᤣ ᤏᤡᤱᤛᤣ᤺ᤰᤁᤥᤏᤧ ᤀᤠᤱᤍᤡᤱ ᤁᤧᤗ᤹ᤖᤡᤀᤠᤱ ᤁᤧᤜᤧᤴᤏᤠ᤹ᤛᤡᤖᤥ॥ ᤂᤧᤴ ᤜᤧᤰᤋᤱᤒᤠ ᤁᤠᤰ ᤜᤧᤴᤇᤡᤱᤔᤠᤱᤃ ᤋᤠᤵᤑᤧ᤺ᤶᤒᤠ ᤐᤠ᤺ᤴᤗᤥ॥"]},{"type":"verse","number":17,"content":["ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤀᤠᤳᤋᤡᤸᤗᤧ ᤏᤢ᤺ᤒᤠ ᤕᤠ᤺ᤶᤒᤰ ᤆᤥ᤺ᤰᤔᤠ ᤗᤧᤛ᤻ᤛᤢᤀᤠᤱᤛᤠᤱ ᤔᤧᤈᤥᤃᤢᤴᤏᤧ ᤑᤠ᤹ᤃᤪ ᤂᤧᤸᤗᤧ ᤗᤠᤕᤥ ᤆᤥᤃᤢ᤹ᤖᤥ॥"]}],"footnotes":[{"noteId":3,"caller":"*","text":"ᤛᤡᤘᤠᤍᤡᤱ ᤂᤠᤜᤢᤴᤜᤠ᤹ ᥉.᥉᥊","reference":{"chapter":4,"verse":6}}]},"thisChapterLink":"/api/lif_wbt/JAS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lif_wbt/JAS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lif_wbt/JAS/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}