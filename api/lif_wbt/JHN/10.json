{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"JHN","translationId":"lif_wbt","name":"ᤕᤢᤜᤢᤴᤏᤠ","commonName":"ᤕᤢᤜᤢᤴᤏᤠ","title":"ᤕᤢᤜᤢᤴᤏᤠᤖᤧ ᤛᤠᤵᤋᤢᤒᤠ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤛᤢᤏᤠᤀᤡᤱ","order":43,"numberOfChapters":21,"sha256":"76cde455591e3db41191fa2affc08b79419b39a1977ac798177993e441380cdf","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/JHN/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/lif_wbt/JHN/21.json","totalNumberOfVerses":878},"chapter":{"number":10,"content":[{"type":"heading","content":["ᤁᤧᤏᤢ᤹ᤒᤠ ᤔᤧᤸᤗᤢᤰᤁᤶᤒᤠ"]},{"type":"verse","number":1,"content":["ᤕᤧᤛᤢᤖᤧ ᤐᤠ᤺ᤳᤋᤢ. “ᤀᤡᤱᤃᤠ᤹ ᤛᤧᤰᤂᤠᤀᤣ ᤔᤧᤳᤏᤡᤱ. ᤀᤠᤳᤋᤡᤴ ᤔᤏᤠ᤺ᤴ ᤗᤠᤶᤎᤣ᤺ᤵᤐᤥᤗᤠᤶ ᤔᤧᤸᤗᤢᤰᤂᤖᤀᤥ ᤔᤧᤗᤠ᤺ᤳᤏᤧᤴ ᤁᤖ ᤘᤣ᤹ ᤗᤧᤵᤔᤠᤱᤏᤢ ᤗᤠ᤺ᤳ ᤂᤧᤱᤃ ᤂᤢ᤺ᤴᤍᤪᤡᤰᤐᤠ ᤏᤢ ᤑᤠ᤺ᤴᤍᤠᤖᤥ॥",{"noteId":48}]},{"type":"verse","number":2,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤔᤧᤸᤗᤢᤰᤁᤶᤒᤠᤱᤃ ᤗᤠᤶᤎᤣ᤺ᤵᤐᤥᤗᤠᤶ ᤗᤠ᤺ᤳᤗᤥ॥"]},{"type":"verse","number":3,"content":["ᤗᤠᤶᤎᤣ᤺ᤵ ᤁᤧᤃᤥ᤺ᤒᤠᤸᤗᤧ ᤂᤢᤏᤧ᤹ ᤁᤢᤗᤠᤃᤡ ᤗᤠᤶᤎᤣ᤺ᤵᤐᤧᤴ ᤜᤴᤍᤢ ᤐᤡᤖᤢ ᤜᤧᤰᤁᤩᤠᤱ ᤔᤧᤸᤗᤢᤰᤜᤠ᤹ᤖᤧᤀᤠᤱ ᤂᤢᤏᤧ᤹ ᤁᤢᤀᤡᤰᤗᤠ᤺ᤴ ᤁᤢᤛᤡᤱ ᤔᤧᤏᤡ᤺ᤳᤋᤢ᤹ᤖᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤸᤗᤧ ᤁᤢᤔᤧᤸᤗᤢᤰᤜᤠ᤹ ᤂᤢᤏᤡ᤹ ᤔᤡᤱᤅᤥᤏᤢ ᤀᤢ᤺ᤳᤋᤢᤛᤡᤀᤠᤱ ᤗᤠ᤺ᤰᤁᤠᤳ ᤗᤠᤶᤗᤥᤛᤢᤛᤡ᤹ᤀᤠᤱ ᤋᤣ᤹ᤖᤢᤛᤡᤖᤥ॥"]},{"type":"verse","number":4,"content":["ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤂᤢᤏᤧ᤹ ᤁᤢᤔᤧᤸᤗᤢᤰᤜᤠ᤹ ᤗᤠ᤺ᤰᤁᤠᤳ ᤗ᤺ᤳᤋᤢᤛᤡ᤹ᤀᤠᤱ ᤋᤃᤡ ᤋᤃᤡ ᤗᤠᤱᤄᤣ᤺ᤰᤗ ᤗᤠᤶᤗᤥᤛᤢᤛᤡ᤹ᤖᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤴ ᤔᤧᤸᤗᤢᤰᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤧ᤹ ᤔᤧᤍᤡᤶᤍᤢ᤹ ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤧ᤹ ᤁᤢᤀᤡᤰᤗᤠ᤺ᤴ ᤁᤢᤛᤡᤱ ᤔᤧᤏᤡ᤺ᤳᤋᤢ᤹ᤖᤥ॥"]},{"type":"verse","number":5,"content":["ᤁᤖ ᤁᤢᤛᤡᤱ ᤔᤧᤴᤏᤡ᤺ᤳᤋᤢᤶᤒᤠᤱᤃ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤔᤧᤴᤍᤡᤶᤍᤢᤴ. ᤁᤖ ᤔᤧᤗᤥ᤺ᤰ ᤔᤧᤒᤣ᤺ᤰᤗᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤧᤸᤗᤧ ᤁᤢᤀᤡᤰᤗᤠ᤺ᤴ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤁᤢᤛᤡᤱ ᤔᤧᤴᤏᤡ᤺ᤳᤋᤢᤴᤗᤥ॥”"]},{"type":"verse","number":6,"content":["ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤕᤧᤛᤢᤖᤧ ᤁᤴ ᤐᤠ᤺ᤴᤏᤡᤴ ᤂᤧᤍᤠ᤹ᤀᤥ ᤔᤧᤳᤋᤢᤛᤡᤀᤠᤱ ᤘᤕᤧ. ᤁᤖ ᤕᤧᤛᤢᤖᤧ ᤌᤣ ᤐᤠ᤺ᤵᤔᤠ ᤏᤡᤱᤘᤠ᤹ ᤆᤥᤃᤢᤒᤠ ᤂᤧᤴ ᤐᤠ᤺ᤴᤏᤡᤸᤗᤧ ᤁᤢᤒᤣ᤺ᤴ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤁᤢᤛᤡᤱ ᤔᤧᤴᤏᤡ᤺ᤳᤋᤢᤴᤗᤥ॥"]},{"type":"verse","number":7,"content":["ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤕᤠᤶᤔᤥ ᤕᤧᤛᤢᤖᤧ ᤂᤧᤱᤜᤠ᤹ ᤔᤧᤳᤋᤢᤛᤡ. “ᤀᤡᤱᤃᤠ᤹ ᤛᤧᤰᤂᤠᤀᤣ ᤔᤧᤳᤏᤡᤱᤗᤥ. ᤀᤡᤱᤃᤠ᤹ᤀᤣ ᤔᤧᤸᤗᤢᤰᤜᤠ᤹ᤖᤧ ᤗᤠᤃᤡ ᤗᤠᤶᤎᤣ᤺ᤵᤐᤠᤀᤠᤖᤥ॥"]},{"type":"verse","number":8,"content":["ᤀᤡᤱᤃᤠ᤹ᤏᤢ᤺ᤸᤗᤧ ᤋᤃᤡ ᤁᤧᤍᤠ᤺ᤒᤠᤜᤠ᤹ ᤁᤧᤖᤧᤰ ᤂᤢ᤺ᤴᤍᤪᤡᤰᤐᤠ ᤏᤢ ᤑᤠ᤺ᤴᤍᤠᤛᤡᤖᤥ. ᤁᤖ ᤔᤧᤸᤗᤢᤰᤜᤠ᤹ᤖᤧ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤐᤠ᤺ᤴ ᤔᤧᤱᤄᤧᤵᤛᤢᤴᤗᤥ॥"]},{"type":"verse","number":9,"content":["ᤀᤡᤱᤃᤠ᤹ᤀᤣ ᤗᤠᤶᤎᤣ᤺ᤵᤐᤠᤀᤠᤖᤥ. ᤀᤡᤱᤃᤠ᤹ᤗᤠᤶ ᤛᤡᤃᤠᤱ ᤁᤧᤗᤠ᤺ᤵᤐᤠᤜᤠ᤹ ᤋᤠᤱᤔᤧᤛᤧ᤺ᤵᤗᤥ॥ ᤂᤧᤴ ᤛᤡᤃᤠᤱ ᤗᤠ᤺ᤵᤔᤠ ᤏᤢ ᤗᤠ᤺ᤰᤁᤠᤳ ᤐᤣ᤺ᤰᤔᤠ ᤛᤢᤰᤗᤥ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤸᤗᤧ ᤆᤠᤖᤠᤶᤍᤧᤴ ᤂᤥ᤺ᤛᤢ᤹ᤖᤥ॥"]},{"type":"verse","number":10,"content":["ᤂᤢ᤺ᤴᤍᤪᤡᤰᤐᤠᤱᤃ ᤂᤢ᤺ᤳᤇᤧ. ᤛᤧᤳᤇᤧ ᤏᤢ ᤔᤧᤱᤛᤧᤖᤰ ᤋᤠ᤺ᤖᤥ. ᤁᤖ ᤀᤡᤱᤃᤠ᤹ᤃ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤛᤧᤰᤂᤠᤒᤠ ᤜᤡᤱᤔᤴᤏᤡᤴ ᤔᤧᤄᤥ᤺ᤛᤢᤖ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤴᤏᤠᤱ ᤀᤠᤳᤋᤠᤳᤋᤠᤴᤏᤣ ᤕᤖᤡᤰ ᤔᤧᤄᤥ᤺ᤛᤢᤖ ᤑᤠ᤹ᤀᤠᤱ ᤋᤩᤠᤱᤒᤠᤖᤥ॥"]},{"type":"verse","number":11,"content":["ᤀᤡᤱᤃᤠ᤹ ᤁᤧᤏᤢ᤹ᤒᤠ ᤔᤧᤸᤗᤢᤰᤁᤶᤒᤠᤀᤠᤖᤥ॥ ᤁᤧᤏᤢ᤹ᤒᤠ ᤔᤧᤸᤗᤢᤰᤁᤶᤒᤠᤱᤃ ᤁᤢᤔᤧᤸᤗᤢᤰᤜᤠ᤹ᤖᤧᤗᤠᤃᤡ ᤛᤡ᤺ᤔᤠᤀᤣ ᤐᤥ᤺ᤱᤛᤠᤱ ᤔᤧᤃᤡᤏᤧᤴᤗᤥ॥"]},{"type":"verse","number":12,"content":["ᤁᤖ ᤕᤠᤱᤅᤥ ᤕᤠ᤺ᤗᤡᤰ ᤛᤠᤱᤔᤏᤠᤒᤠ ᤔᤏᤠ᤺ᤱᤃ ᤛᤧᤰᤂᤠᤒᤠ ᤔᤧᤸᤗᤢᤰᤁᤶᤒᤠ ᤏᤢ ᤔᤧᤸᤗᤢᤰᤍᤠᤱᤒᤠ ᤔᤧ᤺ᤴᤗᤥ॥ ᤂᤧᤸᤗᤧ ᤐᤖᤠᤒᤠᤴ ᤑᤧᤴᤗ ᤐᤵᤐᤠ ᤏᤡ᤺ᤛᤢᤸᤗᤧ ᤔᤧᤸᤗᤢᤰᤜᤠ᤹ ᤗᤧᤖᤢᤎᤛᤡᤀᤠᤱ ᤂᤧᤳᤇᤡᤱ ᤐᤣ᤺ᤰᤗᤥ ᤜᤧᤰᤁᤩᤠᤱ ᤐᤖᤠᤒᤠᤴ ᤋᤠᤀᤠᤱ ᤔᤧᤸᤗᤢᤰᤜᤠ᤹ ᤑᤳᤋᤢᤛᤡ᤹ᤀᤠᤱ ᤛᤧ᤺ᤛᤢᤍᤣ᤺ᤛᤢᤛᤡ᤹ᤖᤥ॥"]},{"type":"verse","number":13,"content":["ᤂᤧᤴ ᤔᤏᤠ᤺ᤴ ᤕᤠᤱᤅᤥ ᤕᤠ᤺ᤗᤡᤰ ᤛᤠᤱᤔᤏᤠᤒᤠᤀᤠᤱᤗᤰ ᤘᤠ᤹ᤒᤠᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤔᤧᤸᤗᤢᤰᤜᤠ᤹ ᤏᤢ᤺ᤖᤡᤰᤁᤠᤱ ᤀᤥᤔᤧᤔᤧᤳᤋᤢᤴᤇᤡᤴ ᤁᤖ ᤗᤧᤖᤢᤎᤛᤡᤀᤠᤱ ᤂᤧᤳᤇᤡᤱ ᤐᤣ᤺ᤰᤗᤥ॥"]},{"type":"verse","number":14,"content":["ᤀᤡᤱᤃᤠ᤹ ᤁᤧᤏᤢ᤹ᤒᤠ ᤔᤧᤸᤗᤢᤰᤁᤶᤒᤠᤀᤠᤖᤥ॥ ᤀᤡᤱᤃᤠ᤹ ᤀᤠᤔᤧᤸᤗᤢᤰᤜᤠ᤹ ᤁᤢᤛᤡᤱ ᤏᤡ᤺ᤳᤋᤢᤱᤛᤡᤱ ᤜᤧᤰᤁᤩᤠᤱ ᤐᤠᤏᤢᤍᤡᤱ ᤀᤠᤶᤒᤠᤖᤧ ᤁᤢᤛᤡᤱ ᤏᤡ᤺ᤳᤋᤠᤒᤠ ᤜᤧᤰᤁᤣᤀᤣ ᤀᤠᤔᤧᤸᤗᤢᤰᤜᤠ᤹ᤖᤧ ᤀᤡᤱᤃᤠ᤹ᤀᤠᤱ ᤁᤢᤛᤡᤱ ᤔᤧᤏᤡ᤺ᤳᤋᤠᤖᤥ–ᤀᤡᤱᤃᤠ᤹ᤀᤠᤱ ᤂᤢᤏᤧ᤹ ᤁᤢᤛᤡᤱ ᤏᤡ᤺ᤳᤋᤢᤱ. ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤔᤧᤸᤗᤢᤰᤜᤠ᤹ᤖᤧ ᤗᤠᤃᤡ ᤛᤡ᤺ᤔᤠᤀᤠᤱ ᤕᤠᤖᤡᤵ ᤘᤠ᤹ᤀᤠᤖᤥ॥"]},{"type":"verse","number":16,"content":["ᤀᤡᤱᤃᤠ᤹ ᤘᤣ᤹ ᤔᤧᤸᤗᤢᤰᤜᤠ᤹ᤀᤠᤱ ᤁᤳᤋᤢᤱᤛᤡᤱ॥ ᤂᤧᤱᤜᤠ᤹ᤃ ᤁᤴ ᤗᤢᤵᤐᤥᤒᤠ ᤔᤧ᤺ᤴᤇᤡᤖᤥ ᤁᤖ ᤂᤧᤱᤜᤠ᤹ᤀᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤗᤳᤇᤠ ᤗᤢᤵᤐᤥ ᤋᤠ᤺ᤵᤔᤠᤛᤡ ᤐᤥ᤺ᤱᤗᤥ॥ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤀᤡᤱᤃᤠ᤹ ᤀᤠᤀᤡᤰᤗᤠ᤺ᤴ ᤔᤧᤄᤧᤵᤛᤢ᤹ᤀᤠᤱ ᤂᤧᤱᤜᤠ᤹ ᤌᤡᤰ ᤗᤢᤵ ᤔᤧᤒᤥ᤺ᤱ ᤜᤧᤰᤁᤩᤠᤱ ᤔᤧᤸᤗᤢᤰᤁᤶᤒᤠᤴᤏᤠᤱ ᤗᤳᤇᤠᤖᤰ ᤐᤥ᤺ᤱᤗᤥ॥"]},{"type":"verse","number":17,"content":["ᤐᤠᤏᤢᤍᤡᤱ ᤐᤠ᤺ᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ ᤗᤢᤱᤔᤠ᤹ ᤋᤢᤰᤁᤠᤖᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ