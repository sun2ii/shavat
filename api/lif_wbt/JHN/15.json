{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"JHN","translationId":"lif_wbt","name":"ᤕᤢᤜᤢᤴᤏᤠ","commonName":"ᤕᤢᤜᤢᤴᤏᤠ","title":"ᤕᤢᤜᤢᤴᤏᤠᤖᤧ ᤛᤠᤵᤋᤢᤒᤠ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤛᤢᤏᤠᤀᤡᤱ","order":43,"numberOfChapters":21,"sha256":"76cde455591e3db41191fa2affc08b79419b39a1977ac798177993e441380cdf","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/JHN/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/lif_wbt/JHN/21.json","totalNumberOfVerses":878},"chapter":{"number":15,"content":[{"type":"heading","content":["ᤕᤧᤛᤢ᤺ᤴ ᤛᤧᤰᤂᤠᤛ᤻ᤔᤠ ᤆᤧᤸᤗᤧᤰᤛᤣ᤹ ᤒᤢᤱ"]},{"type":"verse","number":1,"content":["ᤕᤧᤛᤢᤖᤧ ᤕᤠᤶᤔᤥ ᤁᤢᤜᤢ᤹ᤛᤠᤶᤒᤠᤜᤠ᤹ ᤔᤧᤳᤋᤢᤛᤡ. “ᤀᤡᤱᤃᤠ᤹ᤃ ᤛᤧᤰᤂᤠᤛ᤻ᤔᤠ ᤆᤧᤸᤗᤧᤰᤛᤣ᤹ᤀᤡᤸᤗᤧ ᤁᤢᤒᤢᤱᤀᤠᤖᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤐᤠᤏᤢᤍᤡᤱ ᤀᤠᤶᤒᤠᤃ ᤀᤡᤰᤔ᤺ᤒᤠᤖᤥ॥"]},{"type":"verse","number":2,"content":["ᤀᤡᤱᤃᤠ᤹ᤀᤥ ᤁᤢᤈᤠ᤹ ᤔᤧᤴᤎᤥ᤺ᤰᤔᤏᤠᤒᤠ ᤁᤠᤰ ᤐᤥᤖᤠ᤺ᤰᤜᤠ᤹ᤃ ᤆᤧᤵᤋᤢᤍᤣ᤺ᤛᤢ᤹ ᤜᤧᤰᤁᤩᤠᤱ ᤁᤢᤈᤠ᤹ ᤁᤧᤎᤥ᤺ᤰᤐᤠᤜᤠ᤹ᤀᤠᤱ ᤀᤠᤸᤗᤛᤠᤱ ᤕᤖᤡᤰ ᤁᤢᤈᤠ᤹ ᤌᤥ᤺ᤰᤗ ᤑᤠ᤹ᤀᤠᤱ ᤁᤢᤒᤥᤖᤠ᤺ᤰᤜᤠ᤹ ᤆᤧᤵᤋᤢᤀᤠᤱ ᤛᤠ᤺ᤰᤋᤢᤖᤥ॥"]},{"type":"verse","number":3,"content":["ᤐᤥᤖᤠ᤺ᤰᤜᤠ᤹ ᤆᤧᤵᤔᤠᤀᤠᤱ ᤛᤠ᤺ᤰᤔᤏᤠᤒᤠ ᤆᤧᤸᤗᤧᤰᤛᤣ᤹ᤀᤡᤸᤗᤧ ᤁᤢᤒᤢᤱ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤀᤡᤱᤃᤠ᤹ ᤐᤠ᤺ᤳᤋᤢᤱᤒᤠ ᤐᤣᤗᤡᤃᤧᤴ ᤐᤠ᤺ᤴᤈᤠᤰᤁᤡᤸᤗᤧ ᤋᤃᤡᤛᤠ ᤂᤡᤏᤡ᤹ ᤛᤣᤛᤣ ᤁᤧᤒᤥ᤺ᤰᤂᤡᤀᤠᤱ ᤁᤧᤘᤕᤡ᤹ᤖᤥ॥"]},{"type":"verse","number":4,"content":["ᤀᤡᤱᤃᤠ᤹ᤀᤥ ᤘᤕᤧᤶᤔᤧ᤹ ᤜᤧᤰᤁᤩᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤂᤡᤏᤡ᤹ᤀᤥ ᤘᤠ᤹ᤀᤠᤖᤥ॥ ᤛᤡᤱ ᤐᤥᤖᤠ᤺ᤰᤁᤡᤴ ᤆᤧᤵᤔᤠᤀᤠᤱ ᤁᤢᤒᤢᤱᤔᤥᤗᤠᤶ ᤛᤧᤶᤔᤠᤏᤧ ᤑᤠ᤹ᤃᤪ ᤂᤧ᤹ᤕᤥ ᤁᤢᤈᤠ᤹ ᤌᤥ᤺ᤰᤔᤠ ᤔᤧᤛᤢᤰᤏᤧᤴᤗᤥ. ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤂᤡᤏᤡ᤹ᤀᤠᤱ ᤀᤡᤱᤃᤠ᤹ᤀᤥ ᤔᤧᤴᤘᤠ᤹ᤀᤣ ᤁᤢᤈᤠ᤹ ᤑᤶᤔᤠ ᤁᤧᤴᤇᤢᤰᤋᤢᤶᤔᤡᤸᤗᤥ॥"]},{"type":"verse","number":5,"content":["ᤀᤡᤱᤃᤠ᤹ᤃ ᤆᤧᤸᤗᤧᤰᤛᤣ᤹ᤀᤡᤸᤗᤧ ᤁᤢᤒᤢᤱᤀᤠᤖᤥ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤡᤏᤡ᤹ᤃ ᤀᤠᤒᤥᤖᤠ᤺ᤰᤏᤡᤱᤗᤥ॥ ᤂᤡᤏᤡ᤹ ᤀᤡᤱᤃᤠ᤹ᤀᤥ ᤁᤧᤘᤕᤡ᤹ᤀᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤂᤡᤏᤡ᤹ᤀᤥ