{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"JHN","translationId":"lif_wbt","name":"ᤕᤢᤜᤢᤴᤏᤠ","commonName":"ᤕᤢᤜᤢᤴᤏᤠ","title":"ᤕᤢᤜᤢᤴᤏᤠᤖᤧ ᤛᤠᤵᤋᤢᤒᤠ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤛᤢᤏᤠᤀᤡᤱ","order":43,"numberOfChapters":21,"sha256":"76cde455591e3db41191fa2affc08b79419b39a1977ac798177993e441380cdf","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/JHN/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/lif_wbt/JHN/21.json","totalNumberOfVerses":878},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":["ᤕᤧᤛᤢᤖᤧ ᤀᤠᤸᤗᤛᤠᤱ ᤔᤧᤳᤋᤢᤛᤡ. “ᤕᤠᤵᤔᤡ ᤏᤛᤠ᤺ᤴ ᤆᤥ᤺ᤰᤔᤠ ᤁᤧᤴᤗᤧᤖᤢᤶᤔᤡᤴᤗ ᤑᤠ᤹ᤀᤠᤱ ᤋᤃᤡᤛᤠ ᤁᤴ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤔᤧᤳᤏᤡᤱᤗ ᤐᤳᤋᤠᤖᤥ॥"]},{"type":"verse","number":2,"content":["ᤂᤡᤏᤡ᤹ ᤕᤜᤢᤍᤡ ᤆᤢᤶᤗᤢᤱᤜᤡᤶᤔᤥᤗᤠᤶ ᤁᤧᤶᤗ᤺ᤳᤋᤡ ᤁᤧᤶᤍᤣ᤺ᤛᤡ᤹॥ ᤜᤧᤰᤁᤩᤠᤱ ᤀᤰᤋᤱᤒᤠ ᤕᤧᤶᤔᤠᤱ ᤋᤠᤖ ᤐᤳ. ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤂᤡᤏᤡ᤹ ᤁᤧᤶᤛᤧᤖᤡᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤛᤣᤘᤠ ᤆᤥᤃᤢᤶᤒᤠᤖ ᤐᤳᤇᤡᤃᤧ ᤗ᤹ᤖᤡᤰ ᤔᤧᤀᤡ᤺ᤳᤋᤢᤖᤥ॥"]},{"type":"verse","number":3,"content":["ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤐᤠᤏᤢᤍᤡᤱ ᤐᤠ᤺ᤴ ᤀᤡᤃᤪ ᤀᤡᤱᤃᤠ᤹ ᤕᤠᤵᤔᤡ ᤁᤢᤛᤡᤱ ᤔᤧᤴᤏᤡ᤺ᤳᤋᤠᤴᤒᤠᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤂᤡᤏᤡ᤹ ᤜᤧᤰᤁᤣ ᤁᤧᤶᤔᤧᤳᤋᤡ᤹ᤖᤥ॥"]},{"type":"verse","number":4,"content":["ᤁᤴ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤋᤠ᤺ᤴᤍᤡ ᤂᤡᤏᤡ᤹ᤀᤥ ᤁᤧᤳᤋᤡᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ ᤛᤠᤶᤍᤡᤱ ᤐᤡᤏᤡᤱᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤂᤡᤏᤡ᤹ ᤏᤡᤱᤘᤠ᤹ ᤁᤧᤀᤡ᤺ᤳᤋᤢᤶᤗ ᤑᤠ᤹ᤀᤠᤱ ᤀᤰᤂᤣ ᤔᤧᤳᤏᤡᤱᤅᤠᤱ ᤘᤠ᤹ᤀᤠᤖᤥ॥ ᤋᤃᤡᤃ ᤁᤴ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤔᤧᤔᤧᤳᤏᤡᤱᤅᤡᤴᤗᤥ ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ᤃ ᤂᤡᤏᤡ᤹ᤏᤢᤀᤣ ᤘᤕᤠᤱᤗᤥ॥”"]},{"type":"heading","content":["ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤕᤠ᤺ᤶᤒᤰ"]},{"type":"verse","number":5,"content":["“ᤁᤖ ᤀᤠᤸᤗ ᤀᤡᤱᤃᤠ᤹ ᤕᤠᤵᤔᤡ ᤁᤧᤒᤠᤱᤒᤠᤸᤗᤥ ᤏᤢ᤺ᤱᤅᤠ ᤐᤣ᤺ᤰᤁᤠᤖ ᤐᤳᤋᤠ ᤜᤧᤰᤁᤣᤛᤠᤱ ᤂᤡᤏᤡ᤹ ᤀᤠᤳᤋᤡᤸᤗᤧᤀᤠᤱ ᤀᤠᤳᤋᤠᤴ ᤁᤧᤒᤣ᤺ᤰᤗ ᤁᤧᤒᤵᤐᤣ ᤑᤠ᤹ᤀᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤕᤠᤵᤔᤡ ᤛᤣ᤺ᤴᤃᤧᤴᤍᤥ᤺ᤛᤡᤴᤗᤥ॥"]},{"type":"verse","number":6,"content":["ᤀᤡᤱᤃᤠ᤹ ᤜᤧᤰᤁᤣ ᤐᤠ᤺ᤳᤋᤢᤱᤒᤠᤸᤗᤧ ᤂᤡᤏᤡ᤹ ᤏᤡᤱᤛᤠᤶᤔᤥ ᤁᤧᤎᤩᤧ᤹ᤀᤡᤀᤠᤱ ᤁᤧᤘᤕᤡ᤹ᤖᤥ॥"]},{"type":"verse","number":7,"content":["ᤁᤖ ᤀᤡᤱᤃᤠ᤹ ᤛᤧᤰᤂᤠ᤺ᤴ ᤔᤧᤳᤏᤡᤱ. ᤀᤡᤱᤃᤠ᤹ᤃ ᤐᤣ᤺ᤰᤁᤠᤒᤠᤴᤏᤣ ᤂᤡᤏᤡ᤹ ᤗᤠᤃᤡ ᤏᤢ᤺ᤒᤠ ᤐᤥ᤺ᤱᤗᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ ᤔᤧᤒᤣ᤺ᤰᤁᤠᤴᤏᤧ ᤑᤠ᤹ᤃᤪ ᤁᤢᤓᤠ᤹ ᤁᤧᤒᤡᤒᤠ ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤴ ᤂᤡᤏᤡ᤹ᤀᤥ ᤔᤧᤕᤢᤏᤧᤴᤗᤥ. ᤁᤖ ᤀᤡᤱᤃᤠ᤹ ᤐᤣ᤺ᤰᤁᤠᤀᤠᤱ ᤂᤢᤏᤧ᤹ ᤂᤡᤏᤡ᤹ᤀᤥ ᤐᤠᤱᤄᤢᤱ ᤕᤢ᤺ᤛᤢᤱᤗᤥ॥"]},{"type":"verse","number":8,"content":["ᤂᤢᤏᤧ᤹ ᤕᤢ᤺ᤀᤠᤱ ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥᤒᤠ ᤔᤧᤴᤇᤠᤶᤃᤧᤴ ᤕᤠᤵᤔᤡᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤗᤠᤕᤥᤖᤧ ᤁᤢᤕᤠ᤺ᤶᤒᤣᤀᤥ. ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤛᤠᤶᤕᤥᤏᤡᤔᤠᤴ ᤜᤧᤰᤁᤩᤠᤱ ᤁᤢᤄᤠᤛᤧᤴᤏᤡᤸᤗᤧ ᤁᤢᤕᤠ᤺ᤶᤒᤣᤀᤥ ᤐᤡᤷᤒᤣ᤺ᤴ ᤔᤧᤀᤡ᤺ᤳᤋᤢᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤀᤥᤛᤣ᤺ᤴᤎᤠᤰᤋᤢᤛᤡ᤹ᤖᤥ॥"]},{"type":"verse","number":9,"content":["ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤀᤡᤱᤃᤠ᤹ ᤏᤛᤠ᤺ᤴ ᤔᤧᤴᤈᤥ᤺ᤰᤁᤠᤴᤒᤠᤴᤏᤣ ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤠᤸᤗᤧᤴ ᤗᤠᤕᤥᤖᤥ॥"]},{"type":"verse","number":10,"content":["ᤀᤡᤱᤃᤠ᤹ ᤐᤠᤏᤢᤍᤡᤱ ᤐᤠ᤺ᤸᤗᤥ ᤐᤣ᤺ᤰᤁᤠᤒᤠᤸᤗᤧ ᤛᤠᤶᤕᤥᤏᤡᤒᤠ ᤁᤧᤒᤥ᤺ᤰᤂᤡᤖᤥ. ᤜᤧᤰᤁᤩᤠᤱᤎᤥ ᤂᤡᤏᤡ᤹ ᤕᤠᤵᤔᤡ ᤁᤧᤴᤏᤡ᤺ᤛᤡᤴᤗᤥ॥"]},{"type":"verse","number":11,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤁᤴ ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥᤒᤠ ᤜᤠᤱᤕᤢᤰ ᤁᤧᤈᤥ᤺ᤰᤐᤠᤸᤗᤧ ᤁᤢᤄᤠᤛᤧᤴ ᤐᤥ᤺ᤰᤂᤧᤀᤠᤱ ᤘᤠ᤹॥"]},{"type":"verse","number":12,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤀᤡᤱᤃᤠ᤹ᤃ ᤀᤠᤸᤗᤥ ᤂᤡᤏᤡ᤹ ᤁᤢᤛᤡᤱ ᤁᤧᤏᤡ᤺ᤳᤋᤢᤶᤒᤠᤴᤏᤢ᤺ᤸᤗᤧᤀᤠᤱ ᤕᤖᤡᤰ ᤐᤠ᤺ᤵᤔᤠ ᤁᤧᤒᤥ᤺ᤱᤒᤠ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤁᤳᤋᤢᤱᤗᤥ॥"]},{"type":"verse","number":13,"content":["ᤁᤖ ᤛᤧᤰᤂᤠᤀᤥ ᤗᤠᤶᤃᤧᤗᤥ᤺ᤒᤠ ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤴ ᤕᤢ᤺ᤀᤠᤱ ᤁᤠᤰ ᤛᤧᤰᤂᤠᤀᤥ ᤗᤠᤶᤃᤧᤗᤥ᤺ᤛᤡ᤹ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ᤃ ᤀᤠᤒᤠᤅᤣ ᤁᤢᤒᤠ᤺ᤴᤜᤠ᤹ ᤌᤣᤀᤠᤱ ᤔᤧᤒᤠ᤺ᤳᤋᤢᤴᤗᤥ. ᤁᤖ ᤂᤧᤵᤛᤢᤒᤠ ᤐᤠ᤺ᤴᤜᤠ᤹ᤖᤰ ᤂᤡᤏᤡ᤹ ᤁᤧᤔᤧᤳᤋᤡ᤹ ᤜᤧᤰᤁᤩᤠᤱ ᤋᤠ᤺ᤴᤍᤡ ᤁᤧᤒᤥ᤺ᤱᤒᤠ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤁᤧᤔᤧᤳᤋᤡ᤹ᤖᤥ॥"]},{"type":"verse","number":14,"content":["ᤂᤢᤏᤧ᤹ᤃ ᤀᤠᤒᤠ᤺ᤴᤜᤠ᤹ ᤀᤡᤱᤃᤠ᤹ᤗᤠᤶ ᤂᤥ᤺ᤛᤢᤀᤠᤱ ᤂᤡᤏᤡ᤹ ᤁᤧᤔᤧᤳᤋᤡᤸᤗᤧ ᤀᤠᤔᤡᤔᤡᤍᤡᤱ ᤆᤥᤃᤢ᤹ᤖᤥ॥"]},{"type":"verse","number":15,"content":["ᤁᤠᤰ ᤐᤠᤏᤢᤍᤡᤱ ᤐᤠ᤺ᤸᤗᤧ ᤁᤢᤒᤠ᤺ᤴᤜᤠ᤹ ᤀᤡᤱᤃᤠ᤹ᤀᤡᤴᤗᤥ. ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ᤗᤠᤶᤔᤣ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤋᤣ᤹ᤖᤢᤀᤠᤱ ᤂᤡᤏᤡ᤹ ᤁᤧᤔᤧᤳᤋᤡ᤹ᤖᤥ ᤑᤠ᤹ᤀᤠᤱ ᤐᤠ᤺ᤳᤋᤢᤱᤒᤠᤖᤥ॥”"]},{"type":"heading","content":["ᤋᤢᤰᤂᤣ᤺ᤴ ᤛ᤺ᤵᤔᤠᤀᤥ ᤗᤧᤱ"]},{"type":"verse","number":16,"content":["ᤕᤧᤛᤢᤖᤧ ᤁᤢᤜᤢ᤹ᤛᤠᤶᤒᤠᤜᤠ᤹ ᤔᤧᤳᤋᤢᤛᤡ. “ᤛᤵᤑᤠᤀᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤕᤠᤵᤔᤡ ᤁᤧᤴᤏᤡ᤺ᤛᤡᤴᤗᤥ. ᤁᤖ ᤕᤠᤱᤛᤡ ᤛᤵᤑᤠᤀᤠᤱᤃ ᤕᤠᤶᤔᤥ ᤕᤠᤵᤔᤡ ᤁᤧᤏᤡ᤺ᤛᤡ᤹ᤖᤥ॥”"]},{"type":"verse","number":17,"content":["ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤁᤢᤜᤢ᤹ᤛᤠᤶᤒᤠᤜᤠ᤹ ᤀᤰᤂᤣ ᤔᤧᤔᤧᤳᤇᤡᤱ. “ᤀᤠᤏᤡ᤹ ᤍᤠᤱᤒᤠᤸᤗᤧ ᤛᤵᤑᤠᤀᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤕᤠᤵᤔᤡ ᤀᤠᤃᤧᤴᤏᤡ᤺ᤛᤡᤴ ᤁᤖ ᤕᤠᤱᤛᤡ ᤛᤵᤑᤠᤀᤠᤱ ᤕᤠᤶᤔᤥ ᤕᤠᤵᤔᤡ ᤁᤧᤏᤡ᤺ᤛᤡ᤹ᤖᤥ ᤗ᤹ᤖᤡᤰ ᤌᤧᤔᤠ ᤐᤠ᤺ᤳᤋᤢᤒᤠᤒᤣ᥅ ᤐᤠᤏᤢᤍᤡᤱ ᤐᤠ᤺ᤸᤗᤥ ᤐᤣ᤺ᤰᤁ