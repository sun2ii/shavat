apter":6,"verse":45}},{"noteId":33,"caller":"*","text":"ᤃᤪᤡᤁ ᤐᤠ᤺ᤴᤍᤠᤱᤅᤥ “ᤀᤠᤏᤧᤰᤛᤠ” ᤛᤠᤵᤋᤧᤀᤠᤱ ᤐᤳᤗᤥ॥","reference":{"chapter":6,"verse":51}},{"noteId":34,"caller":"*","text":"ᤕᤜᤢᤍᤡ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤥ ᤔᤠᤰᤂᤡ᤹ ᤆᤠᤔᤠ ᤔᤧᤴᤏᤢ᤹ᤔᤏᤠ ᤌᤡᤶ ᤘᤕᤧ. ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤕᤧᤛᤢᤖᤧ ᤐᤠ᤺ᤳᤋᤢᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤁᤢᤜᤢ᤹ᤛᤠᤶᤒᤠᤜᤠ᤹ᤖᤧ ᤁᤢᤛᤡᤱ ᤔᤧᤴᤏᤡ᤺ᤳᤋᤢᤴ॥","reference":{"chapter":6,"verse":60}}]},"thisChapterLink":"/api/lif_wbt/JHN/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lif_wbt/JHN/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lif_wbt/JHN/5.json","previousChapterAudioLinks":{},"numberOfVerses":71}