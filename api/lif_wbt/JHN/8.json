ent":["ᤕᤜᤢᤍᤡᤜᤠ᤹ᤖᤧ ᤕᤧᤛᤢ᤺ᤴ ᤏᤥᤃᤵ ᤔᤧᤒᤡᤖᤢ. “ᤂᤧᤏᤧ᤹ ᤛᤠᤔᤖᤡ ᤛᤢᤘᤠᤱᤒᤠᤏᤧ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤏᤧ᤹ ᤑᤧᤴᤛᤠᤶᤔᤡᤸᤗᤧ ᤁᤧᤍᤖᤧᤀᤠᤱ ᤘᤠ᤹ ᤑᤠ᤹ᤀᤠᤱ ᤀᤠᤏᤡᤃᤧ ᤐᤠ᤺ᤳᤋᤢᤶᤒᤧᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤛᤧᤰᤂᤠᤀᤣᤖᤥ॥”"]},{"type":"verse","number":49,"content":["ᤕᤧᤛᤢᤖᤧ ᤂᤧᤱᤜᤠ᤹ ᤔᤧᤳᤋᤢᤛᤡ. “ᤀᤡᤱᤃᤠ᤹ᤃ ᤑᤧᤴᤛᤠᤶᤔᤡᤸᤗᤧ ᤔᤧᤴᤕᤠᤱᤅᤣ ᤘᤠ᤹ᤀᤠᤖᤥ॥ ᤀᤡᤱᤃᤠ᤹ ᤐᤠᤏᤢᤍᤡᤱ ᤀᤠᤶᤒᤠ᤺ᤴ ᤔᤡᤱᤛᤥ ᤀᤡᤱᤎᤠ᤺ᤱ ᤐᤡᤖᤢᤱ. ᤁᤖ ᤂᤡᤏᤡ᤹ᤃ ᤀᤡᤱᤃᤠ᤹ ᤀᤡᤱᤎᤠ᤺ᤱ ᤕᤠᤵᤔᤡ ᤁᤧᤶᤒᤡᤖᤡᤴᤗᤥ॥"]},{"type":"verse","number":50,"content":["ᤀᤡᤱᤃᤠ᤹ᤃ ᤀᤠᤵᤑᤣ᤺ᤰ ᤀᤠᤔᤡᤔᤡᤍᤡᤱᤅᤡᤴ ᤔᤧᤃᤥ᤺ᤳᤋᤢᤱᤅᤡᤴ. ᤁᤖ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤀᤠᤔᤡᤔᤡᤍᤡᤱᤅᤡᤴ ᤁᤥ᤺ᤳᤋᤢ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ᤀᤣ ᤂᤠᤛᤧᤴᤗᤥ᤺ᤶᤒᤠᤖᤥ॥"]},{"type":"verse","number":51,"content":["ᤀᤡᤱᤃᤠ᤹ ᤛᤧᤰᤂᤠᤀᤣ ᤔᤧᤳᤏᤡᤱ. ᤀᤠᤳᤋᤡᤸᤗᤧ ᤀᤠᤏᤡᤛᤠᤶᤔᤡᤴ ᤀᤡ᤺ᤳᤋᤢ ᤏᤠ᤺ᤳᤋᤢ᤹. ᤂᤧᤴ ᤀᤠᤵᤑᤠᤸᤗᤧᤀᤠᤱ ᤔᤧᤛᤡ᤺ᤏᤧᤴᤗᤥ॥”"]},{"type":"verse","number":52,"content":["ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤕᤜᤢᤍᤡᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤧ᤹ ᤔᤧᤔᤧᤳᤋᤢ. “ᤀᤠᤸᤗ ᤂᤧᤏᤧ᤹ ᤛᤧᤰᤂᤠᤀᤣ ᤑᤧᤴᤛᤠᤶᤔᤡᤸᤗᤧ ᤁᤧᤕᤠᤱᤄᤧᤀᤠᤱ ᤁᤧᤘᤠ᤹ ᤁᤧᤗ᤹ᤒᤠᤴ ᤁᤢᤛᤡᤱ ᤏᤡ᤺ᤳᤋᤢᤶᤒᤧᤖᤥ॥ ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤀᤒᤪᤠᤜᤠᤶᤔᤡᤴ ᤏᤢ ᤔᤠᤱᤏᤡᤱᤘᤠ᤹ᤐᤠ᤺ᤴ ᤁᤧᤒᤠ᤺ᤵᤐᤠᤜᤠ᤹ ᤁᤠᤰ ᤔᤧᤛᤩᤧ ᤔᤧᤄᤧᤖᤧ. ᤁᤖ ᤂᤧᤏᤧ᤹. ᤀᤠᤳᤋᤡᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ ᤀᤠᤏᤡᤛᤠᤶᤔᤡᤴ ᤀᤡ᤺ᤳᤋᤢ ᤏᤠ᤺ᤳᤋᤢ᤹. ᤂᤧᤴ ᤀᤠᤵᤑᤠᤸᤗᤧᤀᤠᤱ ᤔᤧᤛᤡ᤺ᤏᤧᤴᤗᤥ ᤗ᤹ᤖᤡᤰ ᤁᤧᤒᤠ᤺ᤳᤋᤢ᤹ᤖᤥ॥"]},{"type":"verse","number":53,"content":["ᤂᤧᤏᤧ᤹ ᤀᤠᤏᤡᤃᤧ ᤛᤢᤎᤧᤒᤠ ᤋᤠᤰᤌᤧᤒᤠ ᤀᤒᤪᤠᤜᤠᤶᤔᤡᤴᤏᤢ᤺ᤸᤗᤧᤀᤠᤱ ᤕᤶᤒᤠᤏᤧᤒᤡ᥅ ᤂᤢᤏᤧ᤹ᤃ ᤛᤩᤧ ᤜᤧᤰᤁᤩᤠᤱ ᤁᤠᤰ ᤔᤠᤱᤏᤡᤱᤘᤠ᤹ᤐᤠ᤺ᤴ ᤁᤧᤒᤠ᤺ᤵᤐᤠᤜᤠ᤹ᤀᤠᤱ ᤔᤧᤛᤩᤧᤖᤥ॥ ᤂᤧᤏᤧ᤹ᤃ ᤀᤠᤒᤠᤅᤣ ᤜᤠ᤺ᤳᤀᤠ ᤁᤧᤗ᤹ᤒᤣ᥅”"]},{"type":"verse","number":54,"content":["ᤕᤧᤛᤢᤖᤧ ᤏᤥᤃᤵ ᤐᤡᤖᤢᤛᤡ. “ᤀᤡᤱᤃᤠ᤹ ᤀᤠᤒᤠᤅᤣ ᤆᤶᤛᤡᤱᤅᤠᤏᤧ ᤑᤠ᤹ᤃᤪ ᤂᤧᤱᤃ ᤌᤣᤀᤠᤱ ᤔᤧ᤺ᤴᤗᤥ. ᤁᤖ ᤂᤡᤏᤡ᤹ ᤀᤠᤏᤡᤃᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱ ᤁᤧᤔᤧᤳᤋᤢᤶᤒᤠ ᤐᤠᤏᤢᤍᤡᤱ ᤀᤠᤶᤒᤠᤖᤧᤀᤣ ᤀᤡᤱᤃᤠ᤹ ᤀᤠᤔᤡᤔᤡᤍᤡᤱ ᤆᤥᤃᤢ᤹ᤖᤥ॥"]},{"type":"verse","number":55,"content":["ᤂᤡᤏᤡ᤹ᤃ ᤂᤢᤏᤧ᤹ ᤁᤢᤛᤡᤱ ᤁᤧᤴᤏᤡ᤺ᤳᤋᤢᤶᤔᤡᤴᤇᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤂᤢᤏᤧ᤹ ᤁᤢᤛᤡᤱ ᤏᤡ᤺ᤳᤋᤢᤱᤗᤥ॥ ᤀᤡᤱᤃᤠ᤹ ᤂᤢᤏᤧ᤹ ᤁᤢᤛᤡᤱ ᤔᤧᤏᤡ᤺ᤳᤋᤢᤱᤅᤡᤴ ᤗ᤹ᤖᤡᤰ ᤐᤠ᤺ᤳᤋᤢᤱᤏᤧ ᤑᤠ᤹ᤃᤪ ᤂᤡᤏᤡ᤹ ᤜᤧᤰᤁᤣᤀᤣ ᤀᤡᤱᤃᤠ᤹ ᤀᤡᤱᤗᤧᤰᤁᤣ ᤐᤥ᤺ᤱᤅᤠᤖᤥ. ᤁᤖ ᤀᤡᤱᤃᤠ᤹ ᤂᤢᤏᤧ᤹ ᤁᤢᤛᤡᤱ ᤏᤡ᤺ᤳᤋᤢᤱᤅᤠᤱ ᤁᤢᤒᤠ᤺ᤴᤈᤠᤰᤁᤡᤴ ᤀᤡ᤺ᤳᤋᤢᤱ ᤏᤠ᤺ᤳᤋᤢᤱᤗᤥ॥"]},{"type":"verse","number":56,"content":["ᤂᤡᤏᤡ᤹ ᤛᤢᤎᤧᤒᤠ ᤋᤠᤰᤌᤧᤒᤠ ᤀᤒᤪᤠᤜᤠᤔᤖᤧᤀᤠᤱ ᤁᤴ ᤀᤠᤍᤠ᤺ᤔᤠ ᤕᤧᤶᤔᤡᤴ ᤀᤥᤔᤧᤵᤔᤠ ᤑᤠ᤹ᤀᤠᤱ ᤛᤠ᤹ᤖᤡᤰ ᤁᤢᤛᤡᤰ ᤛᤔᤧᤀᤠᤱ ᤘᤕᤧ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤴ ᤕᤧᤴᤏᤡᤴ ᤏᤡ᤺ᤛᤢᤀᤠᤱ ᤛ᤺ᤳᤋᤧᤖᤥ॥”"]},{"type":"verse","number":57,"content":["ᤕᤜᤢᤍᤡᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤧ᤹ ᤔᤧᤔᤧᤳᤋᤢ. “ᤂᤧᤏᤧ᤹ᤃ ᤋᤱᤒᤣ ᤅᤠᤃᤡᤵᤐᤠᤱ (᥋᥆) ᤔᤧᤱᤃᤧᤳᤋᤣ ᤁᤧᤘᤠ᤹ ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤀᤠᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤀᤒᤪᤠᤜᤠᤶᤔᤡᤴ ᤁᤧᤏᤡ᤺ᤛᤢᤀᤠᤱ ᤁᤧᤘᤠ᤹ᤒᤣ᥅”"]},{"type":"verse","number":58,"content":["ᤕᤧᤛᤢᤖᤧ ᤂᤧᤱᤜᤠ᤹ ᤔᤧᤳᤋᤢᤛᤡ. “ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ ᤛᤧᤰᤂᤠᤀᤣ ᤔᤧᤳᤏᤡᤱᤗᤥ. ᤀᤒᤪᤠᤜᤠᤶᤔᤡᤴ ᤛᤠᤘᤠ᤺ᤴᤇᤡᤱᤔᤠᤏᤢ᤺ᤸᤗᤧ ᤋᤃᤡᤀᤠᤱᤎᤥᤀᤣ ᤀᤡᤱᤃᤠ᤹ ᤘᤠ᤹ᤀᤠᤖᤥ॥”"]},{"type":"verse","number":59,"content":["ᤜᤧᤰᤁᤣ ᤐᤠ᤺ᤳᤋᤢᤸᤗᤧ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤧ᤹ ᤗᤧᤵᤔᤠ ᤛᤧᤵᤔᤠ ᤑᤠ᤹ᤀᤠᤱ ᤗᤢᤱ ᤔᤧᤄᤵᤛᤢ.",{"noteId":45},"ᤁᤖ ᤕᤧᤛᤢ᤺ᤴ ᤆᤡᤱᤛᤡᤱᤅᤠᤱ ᤔᤠᤱᤜᤡᤶ ᤗᤰᤂᤢᤶᤔᤥᤗᤠᤶ ᤛᤫᤠ᤺ᤳᤋᤠᤱ ᤗ᤺ᤴᤍᤧ ᤐᤣᤖᤥ॥"]}],"footnotes":[{"noteId":41,"caller":"*","text":"ᤛᤠᤶᤕᤥᤌᤡᤶ ᤀᤡᤱᤈᤠ᤺ᤱᤅᤥ ᤀᤰᤋᤱᤔᤠ ᤔᤧᤴᤇᤢᤔᤠ᤹ᤀᤡᤴ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ᤏᤢ ᤑᤧᤴ ᤕᤠ᤺ᤶᤒᤰ ᤁᤧᤈᤥ᤺ᤰᤐᤠ ᤔᤏᤠ᤺ᤴᤏᤠᤱ ᤗᤢᤱᤅᤡᤸᤗᤧ ᤗᤧᤵᤔᤠ ᤛᤧᤵᤔᤠ ᤌᤡᤶ ᤘᤕᤧ (ᤗᤧᤒᤡ ᥈᥆.᥇᥆. ᤛᤠᤶᤕᤥᤌᤡᤶ ᤀᤡᤱᤈᤠ᤺ᤱ ᥈᥈.᥈᥈-᥈᥊)॥","reference":{"chapter":8,"verse":5}},{"noteId":42,"caller":"*","text":"ᤕᤜᤢᤍᤡ ᤗᤠᤶᤗᤥ᤺ᤒᤠᤜᤠ᤹ᤖᤧ ᤕᤧᤛᤢ᤺ᤴ ᤐᤠ᤺ᤴᤏᤥ ᤌᤠ᤺ᤔᤠ ᤑᤠ᤹ᤀᤠᤱ ᤏᤡᤱᤘᤠ᤹ ᤔᤧᤀᤡ᤺ᤳᤋᤢᤀᤠᤱ ᤘᤕᤧ॥ ᤕᤧᤛᤢᤖᤧ ᤗᤢᤱᤅᤡᤸᤗᤧ ᤗᤧᤵᤋᤧᤶᤔᤧ᤹ ᤐᤠ᤺ᤳᤋᤢᤏᤧ ᤑᤠ᤹ᤃᤪ ᤖᤥᤔᤡ ᤌᤡᤶᤔᤡᤸᤗᤧ ᤁᤢᤍᤰᤗᤧᤱᤘᤠ ᤐᤥ᤺ᤱ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤖᤥᤔᤡ ᤜᤠᤱᤕᤢᤰᤐᤠᤜᤠ᤹ᤏᤢ᤺ᤸᤗᤧ ᤘᤣ᤹ ᤀᤠᤳᤋᤡᤸᤗᤧᤀᤠᤱ ᤛᤧᤵᤔᤠ ᤂᤢᤶᤍᤡᤱ ᤐᤡᤔᤠ ᤕᤢᤰ ᤔᤧᤱᤃᤳᤋᤢᤴ. ᤜᤧᤰᤁᤩᤠᤱ ᤗᤢᤱᤅᤡᤸᤗᤧ ᤔᤧᤗᤧᤵᤋᤧᤶᤔᤡᤴᤏᤧ᤹ ᤐᤠ᤺ᤳᤋᤢᤏᤧ ᤑᤠ᤹ᤃᤪ ᤔᤥᤛᤠᤖᤧ ᤁᤢᤍᤰᤗᤧᤱᤘᤠ ᤐᤠ᤺ᤱᤒᤠ ᤘᤕᤧ॥","reference":{"chapter":8,"verse":6}},{"noteId":43,"caller":"*","text":"ᤛᤠᤶᤕᤥᤌᤡᤶ ᤀᤡᤱᤈᤠ᤺ᤱ ᥇᥏.᥇᥋","reference":{"chapter":8,"verse":17}},{"noteId":44,"caller":"*","text":"ᤗᤠᤶᤍᤡ᤺ᤰ ᥉.᥇᥊ ᤀᤥ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤔᤡᤱᤅᤡᤴ “ᤀᤡᤱᤃᤠ᤹ ᤂᤢᤏᤧ᤹ᤀᤠ” ᤗ᤹ᤖᤡᤰ ᤐᤠ᤺ᤳᤋᤢᤖᤥ॥","reference":{"chapter":8,"verse":24}},{"noteId":45,"caller":"*","text":"ᤕᤧᤛᤢᤖᤧ ᤁᤢᤒᤠ᤺ᤴᤗᤠᤶ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤀᤠ ᤑᤠ᤹ᤀᤠᤱ ᤐᤠ᤺ᤳᤋᤢᤒᤠ ᤏᤡᤱᤘᤠ᤹ ᤔᤧᤄᤥ᤺ᤛᤢᤖᤥ॥ ᤂᤧᤱᤃ ᤔᤠᤱᤆᤧ᤹ᤕᤠ ᤘᤕᤧᤖᤥ॥ ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤗᤢᤱᤅᤡᤸᤗᤧ ᤗᤧᤵᤔᤠ ᤔᤧᤃᤥ᤺ᤳᤋᤢ (ᤗᤧᤒᤡ ᥈᥊.᥇᥉-᥇᥌)॥","reference":{"chapter":8,"verse":59}}]},"thisChapterLink":"/api/lif_wbt/JHN/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lif_wbt/JHN/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lif_wbt/JHN/7.json","previousChapterAudioLinks":{},"numberOfVerses":59}