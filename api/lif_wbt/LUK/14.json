{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"LUK","translationId":"lif_wbt","name":"ᤗᤢᤁᤠ","commonName":"ᤗᤢᤁᤠ","title":"ᤗᤢᤁᤠᤖᤧ ᤛᤠᤵᤋᤢᤒᤠ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤛᤢᤏᤠᤀᤡᤱ","order":42,"numberOfChapters":24,"sha256":"995e3975e8022d05ad29f251822c1dac63dc43936550dd6a0048523999224f07","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/lif_wbt/LUK/24.json","totalNumberOfVerses":1134},"chapter":{"number":14,"content":[{"type":"heading","content":["ᤕᤧᤛᤢᤖᤧ ᤕᤠᤶᤔᤥ ᤏᤠ᤺ᤶᤛᤡᤱ ᤕᤧᤴᤏᤥ ᤘᤣ᤺ᤴᤍᤢᤛᤡ᤹"]},{"type":"verse","number":1,"content":["ᤌᤡᤰ ᤏᤠ᤺ᤶᤛᤡᤱ ᤕᤧᤴᤏᤥ ᤕᤧᤛᤢ᤺ᤴ ᤗᤳᤇᤠ ᤑᤖᤡᤛᤡ ᤗᤠᤶᤗᤥ᤺ᤒᤠᤸᤗᤧ ᤁᤢᤜᤡᤶᤔᤥ ᤆᤠᤈᤠᤛᤧ ᤐᤣ॥ ᤂᤧᤵᤔᤥ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤧ᤹ ᤔᤧᤎᤥ᤺ᤵᤛᤢᤀᤠᤱ ᤔᤧᤘᤕᤧ."]},{"type":"verse","number":2,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤢᤏᤧ᤹ ᤁᤢᤍᤃᤡ ᤁᤢᤗᤠᤱ ᤁᤢᤜᤢᤰ ᤜ᤺ᤵᤛᤢᤒᤠ ᤔᤏᤠᤎᤡᤰ ᤋᤩᤧ॥"]},{"type":"verse","number":3,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤕᤧᤛᤢᤖᤧ ᤛᤠᤶᤕᤥᤌᤡᤶᤛᤠᤶᤒᤠᤜᤠ᤹ ᤏᤢ ᤑᤖᤡᤛᤡᤜᤠ᤹ ᤛᤣ᤺ᤴᤍᤥᤛᤢᤛᤡ. “ᤏᤠ᤺ᤶᤛᤡᤱ ᤕᤧᤴᤏᤥ ᤁᤧᤍᤢᤰᤐᤠ ᤔᤏᤠᤜᤠ᤹ ᤘᤣ᤺ᤶᤔᤠᤛᤡ ᤏᤢ᤹ᤒᤡ᥅”"]},{"type":"verse","number":4,"content":["ᤁᤖ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤌᤣᤀᤠᤱ ᤏᤥᤃᤵ ᤔᤧᤶᤒᤡᤖᤢᤴ॥ ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤕᤧᤛᤢᤖᤧ ᤂᤧᤴ ᤔᤏᤠ᤺ᤴ ᤛᤶᤍᤠᤱ ᤁᤢᤜᤢᤰ ᤏᤧᤛ᤻ᤛᤢᤖ ᤏᤢᤛᤢᤀᤠᤱ ᤐᤠᤱᤄᤢᤍᤣ᤺ᤛᤢᤖᤥ॥"]},{"type":"verse","number":5,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤕᤧᤛᤢᤖᤧ ᤂᤧᤱᤜᤠ᤹ ᤔᤧᤳᤋᤢᤛᤡ. “ᤏᤠ᤺ᤶᤛᤡᤱ ᤕᤧᤴᤏᤥ ᤂᤡᤏᤡ᤹ ᤛᤠ᤺ ᤀᤡᤃᤪ ᤐᤡᤳᤌᤡᤰ ᤁᤣ᤺ᤶᤒᤠ ᤗᤢᤶᤒᤠ᤺ᤳᤋᤥ ᤔᤰᤌᤠ ᤗᤠ᤺ᤳᤋᤡᤸᤗᤧ ᤂᤡᤏᤡ᤹ ᤂᤡᤔᤥ ᤗᤠ᤺ᤰᤁᤠᤳ ᤁᤧᤀᤢ᤺ᤰᤂᤢᤶ ᤁᤧᤗ᤺ᤳᤋᤢᤶᤒᤡ ᤔᤧ᤺ᤶᤒᤡ᥅”"]},{"type":"verse","number":6,"content":["ᤁᤖ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤌᤣᤀᤠᤱ ᤏᤥᤃᤵ ᤐᤡᤔᤠ ᤔᤧᤴᤇᤢᤰᤋᤢᤴᤗᤥ॥"]},{"type":"heading","content":["ᤋᤖᤣᤒᤠᤖᤧ ᤂᤧᤍᤠ᤹"]},{"type":"verse","number":7,"content":["ᤕᤧᤛᤢᤖᤧ ᤂᤧᤴ ᤛᤠᤓᤠᤱᤈᤠᤀᤥ ᤀᤢ᤺ᤵᤔᤏᤠᤒᤠ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤋᤢᤶᤔᤩᤠᤱᤜᤠᤱ ᤕᤢᤰᤏᤠᤜᤠ᤹ ᤔᤧᤛᤣᤃᤢᤖ ᤔᤧᤕᤢᤅᤧᤒᤠ ᤏᤡ᤺ᤛᤢᤀᤠᤱ ᤂᤧᤱᤜᤠ᤹ ᤁᤴ ᤂᤧᤍᤠ᤹ᤀᤡᤴ ᤔᤧᤳᤋᤢᤛᤡ–"]},{"type":"verse","number":8,"content":["“ᤂᤡᤏᤡ᤹ ᤔᤣ᤺ᤰᤂᤡᤶ ᤛᤠᤓᤠᤱᤈᤠᤀᤥ ᤋᤖᤣ ᤁᤧᤶᤀᤢ᤺ᤳᤋᤡᤏᤧ ᤑᤠ᤹ᤃᤪ ᤋᤢᤶᤔᤩᤠᤱᤜᤠᤱ ᤕᤢᤰᤏᤠᤀᤥ ᤔᤧᤕᤢᤅᤧᤶᤔᤡᤴᤏᤧ᤹ᤀᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤡᤏᤡ᤹ᤏᤢ᤺ᤸᤗᤧᤀᤠᤱ ᤔᤡᤱᤛᤥᤍᤠᤱᤒᤠ ᤔᤏᤠ᤺ᤴ ᤋᤖᤣ ᤀᤢ᤺ᤳᤋᤧᤀᤠᤱ ᤘᤠ᤹ᤏᤧ ᤑᤠ᤹ᤃᤪ"]},{"type":"verse","number":9,"content":["ᤂᤧᤴ ᤜᤡᤶᤍᤠᤱᤒᤠᤴ ᤋᤠᤀᤠᤱ ‘ᤂᤧᤏᤧ᤹ ᤁᤴ ᤕᤢᤰᤏᤠ᤺ᤴ ᤂᤢᤏᤧ᤹ ᤗᤧᤖᤧᤒᤡᤖᤧ᤹ᤀᤠᤱ ᤕᤥ ᤂᤠᤶᤗᤥᤀᤥ ᤕᤢᤅᤧ᤹ᤀᤥ’ ᤁᤧᤔᤧᤳᤏᤧ ᤑᤠ᤹ᤃᤪ ᤁᤧᤏᤠᤎᤠᤖᤥ॥"]},{"type":"verse","number":10,"content":["ᤂᤧᤸᤗᤧ ᤁᤢᤗᤧᤰᤘᤠ ᤋᤖᤣ ᤁᤧᤶᤀᤢ᤺ᤳᤏᤧ ᤑᤠ᤹ᤃᤪ ᤂᤧᤏᤧ᤹ ᤕᤥ ᤂᤠᤶᤗᤥᤀᤥ ᤕᤢᤱᤛᤡᤱᤅᤧ᤹ᤀᤥ॥ ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤜᤡᤶᤍᤠᤱᤒᤧᤴ ᤋᤠᤀᤠᤱ ‘ᤔᤧ᤺ᤴ ᤀᤠᤍᤠᤱᤒᤣ. ᤂᤧᤏᤧ᤹ ᤌᤥ ᤋᤢᤶᤔᤩᤠᤱᤜᤠᤱ ᤕᤢᤰᤏᤠᤀᤥ ᤕᤢᤅᤧ᤹ᤀᤥ’ ᤁᤧᤔᤧᤳᤏᤧ ᤑᤠ᤹ᤃᤪ ᤂᤧ᤹ᤕᤥ ᤂᤡᤖᤡ ᤁᤧᤘᤠ᤹ᤒᤠ ᤋᤖᤣᤒᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤋᤃᤡ ᤂᤧᤏᤧ᤹ ᤁᤧᤔᤡᤱᤛᤥ ᤐᤥ᤺ᤖᤥ॥"]},{"type":"verse","number":11,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤜᤠ᤺ᤳ ᤕᤶᤒᤠ ᤗᤧᤱᤛᤡᤱ ᤂᤧᤴ ᤆᤢᤱᤈᤡᤃᤧᤴᤛᤠ᤺ ᤐᤥ᤺ᤱᤗᤥ. ᤜᤧᤰᤁᤩᤠᤱ ᤜᤠ᤺ᤳ ᤆᤢᤱᤈᤡᤃᤧᤴᤛᤠ᤺ ᤗᤧᤱᤛᤡᤱ ᤂᤧᤴ ᤕᤶᤗᤠᤒᤠ ᤐᤥ᤺ᤱᤗᤥ॥”"]},{"type":"verse","number":12,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤕᤧᤛᤢᤖᤧ ᤜᤡᤶᤍᤠᤱᤒᤠᤴ ᤀᤰᤂᤣ ᤔᤧᤳᤋᤢ. “ᤂᤧᤏᤧ᤹ ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤆᤠᤔᤢᤰ ᤌᤡᤔᤢᤰ ᤁᤧᤛᤧ᤺ᤛᤢᤸᤗᤧ ᤁᤧᤴᤈᤢᤶᤜᤠ᤹. ᤁᤧᤶᤓᤢ᤹ ᤁᤧᤴᤛᤠ᤹ᤜᤠ᤹. ᤁᤧᤃᤠ᤹ᤀᤡ ᤛᤥᤎᤥ᤺ᤰᤜᤠ᤹ ᤏᤢ ᤕᤠᤱᤛᤠᤁᤢᤴᤎᤣ ᤁᤧᤃᤵᤐᤠ ᤐᤠᤱᤓᤣ᤹ᤛᤠᤒᤠᤜᤠ᤹ ᤔᤧᤀᤢ᤺ᤳᤋᤧᤛᤧᤴᤏᤧ᤹ᤀᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤧᤱᤜᤠ᤹ᤖᤧᤀᤠᤱ ᤂᤧᤏᤧ᤹ ᤁᤧᤶᤀᤢ᤺ᤳᤋᤠᤱ ᤆᤠᤔᤢᤰ ᤌᤡᤔᤢᤰ ᤁᤧᤶᤒᤡᤖ ᤕᤠᤱᤏᤠ ᤁᤧᤶᤏᤢ᤺ᤰ ᤁᤧᤶᤒᤡ᤹ᤖᤥ॥"]},{"type":"verse","number":13,"content":["ᤁᤖ ᤂᤧᤏᤧ᤹ ᤆᤠᤔᤢᤰ ᤌᤡᤔᤢᤰ ᤁᤧᤛᤧ᤺ᤛᤢᤸᤗᤧ ᤕᤠᤱᤃᤧᤛᤠ᤹ᤒᤠᤜᤠ᤹. ᤁᤧᤍᤢᤰᤐᤠᤜᤠ᤹. ᤗᤠᤱᤛᤰᤐᤠᤜᤠ᤹ ᤏᤢ ᤔᤡᤰᤑ᤺ᤶᤒᤠᤜᤠ᤹ ᤀᤢ᤺ᤳᤋᤧᤛᤧ᤹ᤀᤥ॥"]},{"type":"verse","number":14,"content":["ᤜᤧᤰᤁᤣ ᤁᤧᤈᤥᤃᤢᤸᤗᤧ ᤂᤧᤏᤧ᤹ ᤔᤢ᤹ᤀᤡᤛᤠᤶ ᤁᤧᤄᤥ᤺ᤛᤢ᤹. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤌᤣᤀᤠᤱ ᤔᤧᤴᤃᤳᤋᤢᤴᤏᤠᤱ ᤂᤧᤴ ᤕᤠᤱᤏᤠ ᤜᤢᤱᤔᤠ ᤔᤧᤴᤇᤢᤰᤋᤢᤴᤗᤥ॥ ᤁᤖ ᤛᤠᤶᤕᤥᤏᤡᤒᤠ ᤔᤏᤠᤜᤠ᤹ ᤛᤡ᤺ᤔᤧᤴᤗᤠᤶ ᤕᤠᤶᤔᤥ ᤔᤧᤜᤡᤱᤅᤡᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤂᤧᤏᤧ᤹ ᤁᤠᤰ ᤏᤢ᤺ᤰᤋᤢ ᤁᤧᤒᤡ᤹ᤖᤥ॥”"]},{"type":"heading","content":["ᤐᤕᤶ ᤛᤠᤓᤠᤱᤈᤠᤖᤧᤴ ᤂᤧᤍᤠ᤹"]},{"type":"verse","number":15,"content":["ᤂᤢᤏᤧ᤹ᤏᤢᤀᤣ ᤛᤥᤖᤡᤰ ᤁᤧᤕᤢᤱᤒᤠ ᤌᤡᤰᤁᤡᤸᤗᤧ ᤁᤴ ᤐᤠ᤺ᤴᤏᤡᤴ ᤂᤧᤵᤛᤢᤀᤠᤱ ᤐᤠ᤺ᤳᤋᤢ. “ᤏᤡᤱᤘᤠ᤹ᤑᤢᤜᤠᤱᤈᤢᤶᤒᤠ ᤆᤠᤔᤢᤰ ᤌᤡᤔᤢᤰᤁᤥ ᤆᤠ ᤁᤧᤈᤠᤒᤠᤜᤠ᤹ᤃ ᤔᤢ᤹ᤀᤡᤛᤠᤒᤠᤛᤡᤖᤥ॥”"]},{"type":"verse","number":16,"content":["ᤕᤧᤛᤢᤖᤧ ᤂᤧᤴ ᤔᤧᤳᤋᤢ. “ᤌᤡᤰ ᤔᤏᤠ᤺ᤸᤗᤧ ᤕᤶᤒᤠ ᤛᤠᤓᤠᤱᤈᤠ ᤛᤧ᤺ᤔᤠ ᤏᤡᤱᤘᤠ᤹ ᤆᤥᤃᤢᤀᤠᤱ ᤕᤖᤡᤰ ᤋᤖᤣᤜᤠ᤹ ᤀᤢ᤺ᤳᤋᤢᤛᤡ॥"]},{"type":"verse","number":17,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤁᤠᤰ ᤕᤠᤖᤡᤵ ᤐᤥ᤺ᤰᤂᤧᤀᤠᤱ ᤁᤢᤛᤣᤘᤠᤖᤥᤒᤠᤎᤡᤰᤁᤡᤴ ᤆᤠᤔᤠ ᤌᤢᤱᤔᤠ ᤕᤠᤖᤡᤵ ᤐᤥ᤺ᤰᤂᤧ. ᤀᤠᤸᤗ ᤋᤩᤧᤶᤔᤧ᤹ᤀᤥ ᤑᤠ᤹ᤀᤠᤱ ᤋᤖᤣ ᤀᤢ᤺ᤳᤇᤧ ᤐᤠᤱᤄᤢᤍᤣ᤺ᤛᤢᤖᤥ॥”"]},{"type":"verse","number":18,"content":["ᤁᤖ ᤂᤧᤴ ᤔᤏᤠᤜᤠ᤹ ᤛᤠᤓᤠᤱᤈᤠᤀᤥ ᤔᤧᤶᤒᤣ᤺ᤰᤔᤏᤠ ᤔᤣᤗᤠᤶᤛᤡᤱᤗᤥ॥ ᤌᤡᤰᤛᤡᤃᤣ᤺ᤰᤐᤠᤸᤗᤧ ᤔᤧᤳᤋᤢ. “ᤀᤡᤱᤃᤠ᤹ ᤐᤩᤠᤱᤛᤡᤃᤧᤴ ᤀᤡᤰᤋᤠᤵ ᤀᤡᤅᤢᤱᤅᤠᤱ ᤘᤠ᤹ᤀᤠ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤴ ᤀᤥᤔᤧᤳᤇᤧ ᤐᤣ᤺ᤰᤔᤠ ᤐᤥ᤺ᤱ. ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤛᤠᤓᤠᤱᤈᤠᤀᤥ ᤋᤠ᤺ᤔᤠ ᤔᤧᤛᤢᤰᤁᤠᤴᤗᤥ॥ ᤗᤧᤵᤔᤡ ᤐᤡᤖᤠᤱᤅᤧ᤹ᤀᤥ॥”"]},{"type":"verse","number":19,"content":["ᤘᤣ᤹ ᤔᤏᤠ᤺ᤸᤗᤧ ᤔᤧᤳᤋᤢ. “ᤀᤡᤱᤃᤠ᤹ ᤁᤢᤃᤠᤵ ᤅᤠᤛᤡ ᤐᤡᤳᤐᤠᤜᤠ᤹ ᤀᤡᤅᤢᤱᤛᤡᤱᤅᤠᤱ ᤘᤠ᤹ᤀᤠ॥ ᤂᤧᤱᤜᤠ᤹ ᤌᤥ᤺ᤱᤔᤠ ᤛᤠ᤹ᤔᤠᤛᤡ ᤐᤥ᤺ᤱ. ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ ᤛᤠᤓᤠᤱᤈᤠᤀᤥ ᤋᤠ᤺ᤔᤠ ᤔᤧᤛᤢᤰᤁᤠᤴᤗᤥ॥ ᤗᤧᤵᤔᤡ ᤀᤠᤒᤡᤖᤧ᤹ᤀᤥ॥”"]},{"type":"verse","number":20,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤸᤗᤛᤠᤱ ᤘᤣ᤹ ᤔᤏᤠ᤺ᤸᤗᤧ ᤀᤰᤂᤣ ᤔᤧᤳᤋᤢ. “ᤀᤡᤱᤃᤠ᤹ᤃ ᤂᤠᤖᤰ ᤔᤣ᤺ᤰᤂᤡᤶ ᤆᤥᤃᤢᤱᤅᤠᤱ ᤘᤠ᤹ᤀᤠ. ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤛᤠᤓᤠᤱᤈᤠᤀᤥ ᤋᤠ᤺ᤔᤠ ᤔᤧᤛᤢᤰᤁᤠᤴᤗᤥ॥"]},{"type":"verse","number":21,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤛᤣᤘᤠᤖᤥᤒᤠᤸᤗᤧ ᤐᤣᤀᤠᤱ ᤁᤢᤴᤍᤠᤱᤒᤠᤴ ᤒᤠ ᤜᤧᤰᤁᤣ ᤂᤧᤴ ᤐᤠ᤺ᤴᤏᤡᤴ ᤔᤧᤳᤋᤢ॥ ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤂᤧᤴ ᤔᤏᤠ᤺ᤸᤗᤧ ᤛᤠ᤹ᤖᤡᤰ ᤁᤢᤛᤡᤰ ᤐᤥᤃᤧᤀᤠᤱ ᤂᤧᤴ ᤁᤢᤛᤣᤘᤠᤖᤥᤒᤠᤴ ᤔᤧᤳᤋᤢ. ‘ᤜᤠᤖᤠ ᤐᤣᤃᤧ᤹ᤀᤠᤱ ᤐᤠᤱᤈᤢᤶᤔᤥᤒᤠ ᤗᤠᤶ ᤗᤠᤶ ᤁᤧᤘᤠ᤹ᤒᤠ ᤕᤠᤱᤃᤧᤛᤠ᤹ᤒᤠᤜᤠ᤹. ᤁᤧᤍᤢᤰᤐᤠᤜᤠ᤹. ᤗᤠᤱᤛᤰᤐᤠᤜᤠ᤹ ᤏᤢ ᤔᤡᤰᤑ᤺ᤶᤒᤠᤜᤠ᤹ ᤀᤢ᤺ᤳᤋᤧ ᤋᤠᤖᤧᤛᤧ᤹॥’"]},{"type":"verse","number":22,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤴ ᤛᤣᤘᤠᤖᤥᤒᤠᤴᤏᤠᤱ ᤐᤣᤀᤠᤱ ᤒᤠ ᤜᤧᤰᤁᤣ ᤆᤥᤃᤢᤀᤠᤱ ᤏᤢ᤺ᤰᤂᤧ ᤋᤩᤧᤀᤠᤱ ᤔᤧᤳᤋᤢ. ‘ᤀᤠᤍᤠᤱᤒᤣ. ᤂᤧᤏᤧ᤹ ᤁᤧᤒᤠ᤺ᤳᤋᤢᤒᤠ ᤜᤧᤰᤁᤣᤀᤣ ᤀᤡᤱᤃᤠ᤹ ᤆᤥᤃᤢᤱ. ᤀᤠᤸᤗᤛᤠᤱ ᤕᤖᤡᤰ ᤕᤢᤱᤔᤠ ᤋᤧᤴᤜᤠ᤹ ᤏᤧᤖᤥ॥’"]},{"type":"verse","number":23,"content":["ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤁᤢᤴᤍᤠᤱᤒᤠᤸᤗᤧ ᤂᤧᤴ ᤔᤧᤳᤋᤢ. ‘ᤜᤧᤰᤁᤣᤏᤧ ᤑᤠ᤹ᤃᤪ ᤂᤧᤏᤧ᤹ ᤐᤠᤱᤓᤣ᤹ᤀᤥ ᤐᤣᤃᤧ᤹ᤀᤠᤱ ᤗᤠᤶ ᤗᤠᤶᤔᤥ ᤁᤧᤘᤠ᤹ᤒᤠ ᤔᤏᤠᤜᤠ᤹ ᤜᤠᤖᤠ ᤛᤠᤓᤠᤱᤈᤠᤀᤥ ᤔᤧᤍᤠᤖᤀᤣ ᤐᤥ᤺ᤱ ᤑᤠ᤹ᤀᤠᤱ ᤀᤢ᤺ᤳᤋᤧ ᤋᤠᤖᤧᤛᤧ᤹ᤀᤥ॥ ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤁᤴ ᤀᤠᤜᤡᤶᤔᤡᤴ ᤛᤎᤧᤰ ᤋᤡᤶᤗᤖᤥ॥’"]},{"type":"verse","number":24,"content":["ᤀᤢ᤺ᤵᤔᤏᤠᤒᤠ ᤋᤖᤣᤒᤠ ᤀᤠᤳᤋᤡᤸᤗᤧᤀᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤛᤧ᤺ᤛᤢᤱᤒᤠ ᤛᤠᤓᤠᤱᤈᤠᤀᤥ ᤆᤠᤔᤠ ᤔᤧᤄᤥ᤺ᤛᤢᤴᤗᤥ॥”"]},{"type":"heading","content":["ᤜᤢ᤹ᤛᤠᤶᤒᤠ ᤐᤥ᤺ᤱᤔᤠ ᤋᤢᤰᤂᤣ᤺ᤴ"]},{"type":"verse","number":25,"content":["ᤌᤡᤰᤗᤧᤱ ᤕᤖᤡᤰ ᤕᤖᤡᤰ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤀᤣ᤺ᤰ ᤁᤢᤀᤣ᤺ᤰ ᤔᤧᤏᤠ᤺ᤳᤋᤢᤖ ᤔᤧᤘᤕᤧᤸᤗᤧ ᤂᤢᤏᤧ᤹ ᤂᤡᤖᤡ ᤜᤡᤛᤡᤱᤅᤠᤱ ᤔᤧᤳᤋᤢᤛᤡ."]},{"type":"verse","number":26,"content":["“ᤀᤡᤱᤃᤠ᤹ ᤕᤠᤵᤔᤡ ᤁᤧᤍᤡᤶᤒᤠᤸᤗᤧ ᤁᤢᤶᤔᤠ-ᤁᤢᤶᤒᤠᤛᤡ. ᤁᤢᤔᤣ᤺ᤳ-ᤁᤢᤛ᤻ᤛᤠ᤺ᤜᤠ᤹. ᤁᤢᤶᤓᤢ᤹ ᤁᤢᤴᤛᤠ᤹ᤛᤡ. ᤁᤢᤴᤏᤧ᤹ ᤁᤢᤴᤛᤠ᤹ᤛᤡ. ᤜᤧᤰᤁᤩᤠᤱ ᤁᤢᤜᤡᤱᤔᤴᤏᤡᤴ ᤀᤡᤱᤃᤠ᤹ᤏᤢ᤺ᤸᤗᤧᤀᤠᤱ ᤛᤠ᤹ᤖᤡᤰ ᤔᤡ᤺ᤶᤈᤡ ᤔᤧᤳᤋᤢᤏᤧ ᤑᤠ᤹ᤃᤪ ᤂᤧᤱᤃ ᤀᤡᤱᤃᤠ᤹ ᤀᤠᤜᤢ᤹ᤛᤠᤶᤒᤠ ᤐᤥ᤺ᤱᤔᤠ ᤔᤧᤛᤢᤰᤏᤧᤴᤗᤥ॥"]},{"type":"verse","number":27,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤏᤧ᤹ ᤁᤧᤛᤡᤗᤠᤶᤛᤠᤰᤔᤠ ᤛᤡᤱᤅᤡᤴ ᤀᤠᤒᤠᤅᤣ ᤁᤧᤒᤱᤛᤡᤱᤅᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤁᤧᤴᤍᤡᤶᤔᤠᤴᤏᤧ ᤑᤠ᤹ᤃᤪ ᤀᤠᤜᤢ᤹ᤛᤠᤶᤒᤠ ᤐᤥ᤺ᤱᤔᤠ ᤁᤧᤴᤇᤢᤰᤏᤧᤴᤗᤥ॥"]},{"type":"verse","number":28,"content":["ᤀᤠᤸᤗ ᤏᤡᤱᤘᤠ᤹ ᤀᤡ᤺ᤳᤋᤧᤶᤔᤧ᤹. ᤂᤡᤏᤡ᤹ᤀᤥ ᤌᤡᤰᤁᤡᤸᤗᤧ ᤕᤶᤒᤠ ᤆᤱᤜᤡᤶ ᤆᤥ᤺ᤰᤔᤠ ᤏᤡᤱᤘᤠ᤹ ᤆᤥᤃᤢᤸᤗᤧ. ᤆᤥ᤺ᤰᤔᤠᤏᤢ᤺ᤸᤗᤧ ᤋᤃᤡ ᤂᤧᤴ ᤛᤢ᤺ᤵᤔᤠᤸᤗᤧ ᤀᤠᤰᤂᤧᤴ ᤕᤠᤱᤛᤠᤁᤢᤴᤎᤣ ᤆᤠᤜᤠᤒᤠ ᤆᤥ᤺ᤰ ᤗ᤹ᤖᤡᤰ ᤏᤡᤱᤛᤣ᤺ᤰ ᤆᤥᤃᤢᤒᤡ ᤔᤧ᤺ᤶᤒᤡ᥅"]},{"type":"verse","number":29,"content":["ᤔᤧ᤺ᤴᤏᤧ ᤑᤠ᤹ᤃᤪ ᤜᤡᤶ ᤐᤠᤱᤕᤰ ᤏᤧᤔᤠᤃ ᤛᤢᤰᤋᤢ. ᤁᤖ ᤂᤧᤴ ᤆᤥ᤺ᤰᤔᤠ ᤛᤢ᤺ᤵᤔᤠ ᤔᤧᤛᤢᤰᤋᤢᤴᤗᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤁᤴ ᤁᤧᤏᤡ᤺ᤒᤠ ᤁᤧᤄᤧᤶᤒᤠ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤂᤧᤴ ᤀᤰᤂᤣ ᤔᤧᤔᤧᤳᤋᤢᤖ ᤁᤡᤏᤠ᤺ᤴᤍᤡ ᤔᤧᤒᤡᤖᤢᤖᤥ. ‘ᤂᤧᤏᤧ᤹ ᤜᤣ᤺ᤰᤔᤠᤃ ᤁᤧᤜᤣ᤺ᤰᤋᤢ. ᤁᤖ ᤛᤢ᤺ᤵᤔᤠ ᤁᤧᤴᤇᤢᤰᤋᤢᤴᤗᤥ᥄’"]},{"type":"verse","number":31,"content":["ᤀᤠᤸᤗ ᤗᤳᤇᤠ ᤌᤡᤒᤥ᤺ᤱ ᤜᤧᤴᤇᤡᤱ (᥇᥆.᥆᥆᥆) ᤌᤰᤛᤢᤒᤠ ᤁᤧᤃᤵᤐᤠ ᤜᤠᤱᤅᤡᤸᤗᤧ ᤘᤣ᤹ᤛ᤻ᤔᤠ ᤏᤡᤒᤥ᤺ᤱ ᤜᤧᤴᤇᤡᤱ (᥈᥆.᥆᥆᥆) ᤌᤰᤛᤢᤒᤠ ᤁᤧᤃᤵᤐᤠ ᤜᤠᤱᤅᤡᤴᤏᤢ ᤌᤱ ᤆᤥ᤺ᤰᤛᤧ ᤐᤣ᤺ᤰᤔᤠᤏᤢ᤺ᤸᤗᤧ ᤋᤃᤡ ᤂᤧᤸᤗᤧ ᤕᤢᤱᤛᤡᤱᤅᤠᤱ ᤂᤧᤴ ᤘᤣ᤹ᤛ᤻ᤔᤠ ᤜᤠᤱᤅᤡᤴ ᤏᤠ᤺ᤶᤔᤠ ᤛᤢᤰᤋᤢ ᤒᤡ ᤔᤧ᤺ᤶᤒᤡ ᤑᤠ᤹ᤀᤠᤱ ᤏᤢ᤺ᤖᤡᤰᤁᤠᤱ ᤏᤡᤱᤘᤠ᤹ ᤀᤡ᤺ᤳᤋᤢ᤹ᤖᤥ॥"]},{"type":"verse","number":32,"content":["ᤂᤧᤸᤗᤧ ᤂᤧᤴ ᤜᤠᤱᤅᤡᤴ ᤏᤠ᤺ᤶᤔᤠ ᤔᤧᤛᤢᤰᤋᤢᤴᤒᤠ ᤏᤡ᤺ᤴᤎᤥ ᤆᤥᤃᤢᤏᤧ ᤑᤠ᤹ᤃᤪ ᤂᤧᤸᤗᤧ ᤂᤧᤴ ᤜᤠᤱᤅᤡᤴ ᤗᤠᤶᤔᤥ ᤌᤱ ᤆᤥ᤺ᤰᤛᤧ ᤑᤧᤴᤗ ᤐᤳᤋᤡᤸᤗᤧᤛᤠ ᤜᤠᤱᤗᤠᤀᤡᤱᤒᤠᤴ ᤐᤠᤱᤄᤢᤀᤠᤱ ᤏᤠᤍᤱ ᤆᤥᤃᤢ᤹ᤖᤥ॥"]},{"type":"verse","number":33,"content":["ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰᤁᤣ ᤂᤧᤏᤧ᤹ ᤁᤧᤃᤳᤋᤢᤒᤠ ᤁᤠᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤁᤧᤴᤗᤧᤖᤢᤴᤏᤧ ᤑᤠ᤹ᤃᤪ ᤀᤡᤱᤃᤠ᤹ ᤀᤠᤜᤢ᤹ᤛᤠᤶᤒᤠ ᤐᤥ᤺ᤱᤔᤠ ᤁᤧᤴᤇᤢᤰᤏᤧᤴᤗᤥ॥"]},{"type":"heading","content":["ᤔᤧᤸᤗᤡᤶᤔᤏᤠᤒᤠ ᤕᤢᤶ"]},{"type":"verse","number":34,"content":["ᤕᤢᤶᤔᤡᤱᤃ ᤏᤢ᤺ᤒᤠᤀᤣ ᤆᤥ᤺ᤰ. ᤁᤖ ᤕᤢᤶᤔᤡᤸᤗᤧ ᤁᤢᤗᤡᤶᤔᤧᤴ ᤔᤠ᤺ᤒᤣ᤺ᤰᤏᤧ ᤑᤠ᤹ᤃᤪ ᤕᤠᤶᤔᤥ ᤁᤧᤗᤡᤶᤒᤠ ᤆᤥ᤺ᤰᤔᤠ ᤛᤢᤰᤔᤧᤍᤧᤳᤏᤧᤴᤗᤥ॥"]},{"type":"verse","number":35,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤱᤃ ᤀᤡᤰᤋᤠᤵᤐᤥ ᤔ᤺ᤸᤗᤠᤱ ᤔᤧᤒᤥ᤺ᤱᤏᤧᤴ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤒᤠ ᤜᤧᤰᤁᤣᤀᤣ ᤗᤠᤵᤔᤧᤓᤢᤛᤢ ᤔᤧᤍᤣ᤺ᤛᤢᤖᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤒᤠ᤺ᤴᤏᤡᤴ ᤏᤢ᤺ᤖᤡᤰᤁᤠᤱ ᤂᤧᤵᤛᤧᤶᤔᤧ᤹ᤀᤠᤱ ᤁᤢᤛᤡᤱ ᤏᤡ᤺ᤳᤋᤧᤶᤔᤧ᤹ᤀᤥ᥄”"]}],"footnotes":[]},"thisChapterLink":"/api/lif_wbt/LUK/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lif_wbt/LUK/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lif_wbt/LUK/13.json","previousChapterAudioLinks":{},"numberOfVerses":34}