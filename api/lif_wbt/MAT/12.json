{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"MAT","translationId":"lif_wbt","name":"ᤔᤳᤋᤡ","commonName":"ᤔᤳᤋᤡ","title":"ᤔᤳᤋᤡᤖᤧ ᤛᤠᤵᤋᤢᤒᤠ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤛᤢᤏᤠᤀᤡᤱ","order":40,"numberOfChapters":28,"sha256":"92251ee343eb432e145aaeea5c2136c2828b4ff041495bf1aae6bdd263284826","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/lif_wbt/MAT/28.json","totalNumberOfVerses":1069},"chapter":{"number":12,"content":[{"type":"heading","content":["ᤏᤠ᤺ᤶᤛᤡᤱ ᤕᤧᤴᤏᤡᤸᤗᤧ ᤁᤢᤴᤍᤠᤱᤒᤠ"]},{"type":"verse","number":1,"content":["ᤌᤡᤰᤗᤧᤱ ᤕᤧᤛᤢ᤺ᤴ ᤏᤢ ᤁᤢᤜᤢ᤹ᤛᤠᤶᤒᤠᤜᤠ᤹ ᤏᤠ᤺ᤶᤛᤡᤱ ᤕᤧᤴᤏᤥ",{"noteId":47},"ᤐᤩᤠᤱᤛᤡᤃᤧᤴ ᤀᤡᤰᤋᤠᤵᤗᤢᤶᤔᤥᤏᤢ ᤔᤧᤒᤣᤖ ᤔᤧᤒᤳᤇᤧᤸᤗᤧ ᤁᤢᤜᤢ᤹ᤛᤠᤶᤒᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤛᤧᤳᤗᤠ᤺ᤰᤋᤧᤀᤠᤱ ᤛᤡ᤺ᤍᤠᤵᤔᤠᤜᤠ᤹ ᤔᤧᤍᤢᤒᤢᤀᤠᤱ ᤔᤧᤏᤢᤃᤢᤖ ᤆᤠᤔᤠ ᤔᤧᤜᤣ᤺ᤰᤋᤢᤖᤥ॥"]},{"type":"verse","number":2,"content":["ᤁᤢᤓᤠ ᤑᤖᤡᤛᤡᤜᤠ᤹ᤖᤧ ᤂᤧᤴ ᤔᤧᤏᤡ᤺ᤛᤢᤀᤠᤱ ᤕᤧᤛᤢ᤺ᤴ ᤔᤧᤔᤧᤳᤋᤢ. “ᤀᤥᤔᤧᤳᤋᤧ᤹. ᤏᤠ᤺ᤶᤛᤡᤱ ᤕᤧᤴᤏᤥ ᤕᤠ᤺ᤶᤒᤰ ᤆᤥ᤺ᤰᤔᤠ ᤔᤧᤏᤢ᤹ᤏᤧᤴ. ᤁᤖ ᤁᤧᤜᤢ᤹ᤛᤠᤶᤒᤠᤜᤠ᤹ᤖᤧᤃ ᤔᤧᤈᤥᤃᤢᤱᤃ᥄”"]},{"type":"verse","number":3,"content":["ᤕᤧᤛᤢᤖᤧ ᤂᤧᤱᤜᤠ᤹ ᤏᤥᤃᤵ ᤐᤡᤖᤢᤛᤡ. “ᤔᤧ᤺ᤶᤒᤧ᥄ ᤍᤠᤀᤢᤍ ᤜᤠᤱᤅᤡᤴ ᤏᤢ ᤁᤢᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤛᤧᤳᤗᤠ᤺ᤰᤋᤧᤸᤗᤧ ᤔᤧᤈᤥᤃᤢᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤛᤠᤶᤕᤥᤛᤠᤵᤗᤠᤀᤥ ᤔᤧᤴᤏᤡ᤺ᤳᤋᤣ ᤁᤧᤘᤕᤡ᤹ᤒᤡ᥅",{"noteId":48}]},{"type":"verse","number":4,"content":["ᤍᤠᤀᤢᤍ ᤜᤠᤱᤅᤡᤴ ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤛᤠ᤺ᤱᤃᤠᤜᤡᤶᤔᤥ ᤗᤠ᤺ᤛᤧᤀᤠᤱ ᤂᤢᤏᤧ᤹ ᤏᤢ ᤁᤢᤴᤈᤢᤶᤜᤠ᤹ᤖᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤋᤥ᤺ᤶᤔᤏᤠᤒᤠ ᤛᤣᤛᤣ ᤂᤖᤧ᤺ᤱᤅᤡᤴ ᤔᤧᤈᤖᤥ॥ ᤂᤧᤱᤃ ᤛᤠᤶᤕᤥᤌᤡᤶ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤒᤠᤜᤠ᤹ᤖᤧᤖᤰ ᤆᤠᤔᤠ ᤁᤧᤏᤢ᤹ᤒᤠ ᤘᤕᤧ. ᤁᤖ ᤘᤣ᤹ᤜᤠ᤹ᤖᤧ ᤆᤠᤔᤠ ᤔᤧᤴᤏᤢ᤹ᤔᤏᤠᤒᤠ ᤘᤕᤧᤖᤥ॥"]},{"type":"verse","number":5,"content":["ᤕᤠᤶᤔᤥ ᤔᤥᤛᤠᤖᤧ ᤛᤠᤵᤋᤢᤒᤠ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤴ ᤔᤧᤴᤏᤡ᤺ᤳᤋᤣ ᤁᤧᤘᤕᤡ᤹ᤒᤡ᥅ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤸᤗᤧ ᤕᤠ᤺ᤶᤒᤰ ᤆᤥ᤺ᤰᤔᤠ ᤔᤧᤏᤢ᤹ᤏᤧᤴ ᤐᤠ᤺ᤳᤋᤢᤛᤠᤱ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤒᤠᤜᤠ᤹ᤖᤧᤀᤠᤱ ᤏᤠ᤺ᤶᤛᤡᤱ ᤕᤧᤴᤏᤥ ᤔᤠᤱᤜᤡᤶᤔᤥ ᤕᤠ᤺ᤶᤒᤰ ᤔᤧᤈᤥᤃᤢ. ᤁᤖᤛᤠᤱ ᤀᤠᤵᤋᤡᤰ ᤔᤧ᤺ᤴᤏᤣᤒᤠ ᤔᤧᤒᤥ᤺ᤰᤂᤧᤖᤥ॥"]},{"type":"verse","number":6,"content":["ᤀᤡᤱᤃᤠ᤹ ᤛᤧᤰᤂᤠ ᤔᤧᤳᤏᤡᤱ. ᤔᤠᤱᤜᤡᤶᤔᤡᤴᤏᤢ᤺ᤸᤗᤧᤀᤠᤱ ᤕᤶᤒᤠᤴ ᤁᤵᤔᤥ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":7,"content":["ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ ᤛᤡᤍᤢᤱᤈᤓᤠ᤺ᤴ ᤆᤠᤜᤠᤒᤠ ᤔᤧᤈᤥ᤺ᤰᤁᤠᤴ ᤁᤖ ᤔᤏᤠᤜᤠ᤹ ᤗᤢᤱᤔᤠ᤹ ᤋᤢᤰᤋᤧᤶᤛᤡᤶᤔᤧ᤹ ᤑᤠ᤹ᤀᤠᤱ ᤏᤡᤱᤘᤠ᤹ ᤆᤥᤃᤢᤱ ᤗ᤹ᤖᤡᤰ ᤛᤠᤶᤕᤥᤛᤠᤵᤗᤠᤀᤥ ᤐᤠ᤺ᤳᤋᤢᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤁᤧᤏᤡ᤺ᤛᤢᤶᤔᤠᤱ ᤁᤧᤘᤕᤡᤸᤗᤧᤃ ᤑᤥᤋᤩᤠ ᤔᤧ᤺ᤴᤏᤣᤒᤠ ᤔᤏᤠᤜᤠ᤹ ᤀᤠᤵᤋᤡᤰ ᤁᤧᤴᤃᤢ᤺ᤳᤋᤢᤶᤛᤡᤶᤔᤧᤴᤒᤠ ᤘᤕᤧ ᤔᤧᤴ॥"]},{"type":"verse","number":8,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ ᤔᤧᤴᤇᤠᤶᤛᤠ᤺ᤱᤃ ᤏᤠ᤺ᤶᤛᤡᤱ ᤕᤧᤴᤏᤡᤸᤗᤧᤴᤏᤠᤱ ᤁᤢᤴᤍᤠᤱᤒᤠᤀᤠᤖᤥ॥”"]},{"type":"heading","content":["ᤕᤧᤛᤢᤖᤧ ᤏᤠ᤺ᤶᤛᤡᤱ ᤕᤧᤴᤏᤥ ᤔᤏᤠᤎᤡᤰ ᤏᤢᤛᤢ᤹"]},{"type":"verse","number":9,"content":["ᤕᤧᤛᤢ᤺ᤴ ᤂᤧᤵᤔᤥᤗᤠᤶ ᤐᤣᤀᤠᤱ ᤕᤜᤢᤍᤡ ᤆᤢᤶᤗᤢᤱᤜᤡᤶᤔᤥ ᤗᤠ᤺ᤛᤧ॥"]},{"type":"verse","number":10,"content":["ᤂᤧᤵᤔᤥ ᤁᤢᤜᤢᤰ ᤁᤧᤛᤶᤒᤠ ᤔᤏᤠᤎᤡᤰ ᤘᤕᤧ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤵᤔᤥ ᤁᤢᤓᤠ ᤕᤜᤢᤍᤡᤜᤠ᤹ᤖᤧ ᤕᤧᤛᤢ᤺ᤴ ᤀᤠᤵᤋᤡᤰ ᤁᤢ᤺ᤵᤔᤠ ᤑᤠ᤹ᤀᤠᤱ ᤔᤧᤛᤢᤃᤢᤖ ᤔᤧᤘᤕᤧᤀᤠᤱ ᤛᤣ᤺ᤴᤔᤧᤍᤥᤛᤢ. “ᤏᤠ᤺ᤶᤛᤡᤱ ᤕᤧᤴᤏᤥ ᤔᤏᤠᤜᤠ᤹ ᤘᤣ᤺ᤶᤔᤠᤛᤡ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤸᤗᤧ ᤀᤠᤒᤡ᤹ᤒᤡ ᤔᤧ᤺ᤶᤒᤡ᥅”"]},{"type":"verse","number":11,"content":["ᤕᤧᤛᤢᤖᤧ ᤂᤧᤱᤜᤠ᤹ ᤏᤥᤃᤵ ᤐᤡᤖᤢᤛᤡ. “ᤂᤡᤏᤡ᤹ ᤔᤧᤸᤗᤢᤰᤁᤡᤴ ᤏᤠ᤺ᤶᤛᤡᤱ ᤕᤧᤴᤏᤥ ᤁᤣ᤺ᤶᤒᤠ ᤗᤢᤶᤒᤠ᤺ᤳᤋᤥ ᤔᤰᤌᤠ᤺ᤸᤗᤧ ᤁᤧᤴᤀᤢ᤺ᤰᤂᤢᤶ ᤁᤧᤴᤗ᤺ᤳᤋᤢᤶᤔᤡᤴᤒᤡ᥅"]},{"type":"verse","number":12,"content":["ᤔᤧᤴᤇᤠᤶ ᤕᤠᤵᤔᤡ᤺ᤱᤃ ᤔᤧᤸᤗᤢᤰᤁᤡᤴᤏᤢ᤺ᤸᤗᤧ ᤀᤡᤔᤧᤸᤗᤢᤱᤒᤠ ᤔᤧᤈᤥ᤺ᤰᤏᤧᤴᤒᤡ᥅ ᤏᤠ᤺ᤶᤛᤡᤱ ᤕᤧᤴᤏᤥ ᤏᤢ᤺ᤒᤠ ᤕᤠ᤺ᤶᤒᤰ ᤆᤥ᤺ᤰᤔᤠ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤸᤗᤧ ᤀᤠᤒᤡ᤹ᤖᤥ॥”"]},{"type":"verse","number":13,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤕᤧᤛᤢᤖᤧ ᤂᤧᤴ ᤔᤏᤠ᤺ᤴ ᤔᤧᤳᤋᤢ. “ᤁᤧᤜᤢᤰᤁᤡᤴ ᤛᤴᤇᤧ᤹॥” ᤂᤧᤸᤗᤧ ᤁᤢᤜᤢᤰᤁᤡᤴ ᤛᤴᤇᤢᤸᤗᤧ ᤂᤡᤔᤥ ᤘᤣ᤺ᤳᤋᤧᤀᤠᤱ ᤘᤣ᤹ᤛ᤻ᤔᤠ ᤁᤢᤜᤢᤰᤁᤡᤴ ᤜᤧᤰᤁᤣᤀᤣ ᤏᤢ᤺ᤒᤠ ᤐᤥ᤺ᤰᤂᤧᤖᤥ॥"]},{"type":"verse","number":14,"content":["ᤁᤖ ᤑᤖᤡᤛᤡᤜᤠ᤹ ᤕᤜᤢᤍᤡ ᤆᤢᤶᤗᤢᤱᤜᤡᤶᤔᤥᤗᤠᤶ ᤔᤧᤗ᤺ᤴᤍᤧ ᤔᤧᤒᤣᤀᤠᤱ ᤕᤧᤛᤢ᤺ᤴ ᤀᤠᤰᤂᤣᤀᤠᤱ ᤛᤧᤵᤔᤠᤒᤣ ᤑᤠ᤹ᤀᤠᤱ ᤐᤠ᤺ᤴ ᤔᤧᤍᤱᤄᤢᤖᤥ॥"]},{"type":"heading","content":["ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤛᤣᤃᤢᤒᤠ ᤛᤣᤘᤠᤖᤥᤒᤠ"]},{"type":"verse","number":15,"content":["ᤕᤧᤛᤢᤖᤧ ᤂᤧᤴ ᤆᤧᤶᤓᤴ ᤔᤧᤈᤥᤃᤢᤒᤠᤴ ᤏᤡᤱᤘᤠ᤹ ᤂᤥ᤺ᤛᤢᤀᤠᤱ ᤂᤢᤏᤧ᤹ ᤂᤧᤵᤔᤥᤗᤠᤶ ᤐᤣᤖᤥ॥ ᤕᤖᤡᤰ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤧ᤹ ᤔᤧᤍᤡᤶᤍᤢ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤴ ᤁᤧᤍᤢᤰᤐᤠ ᤁᤧᤕ᤹ᤒᤠᤜᤠ᤹ ᤁᤧᤖᤧᤰ ᤘᤣ᤺ᤴᤍᤢᤛᤡ."]},{"type":"verse","number":16,"content":["ᤁᤖ ᤕᤧᤛᤢᤖᤧ ᤂᤧᤱᤜᤠ᤹ ᤂᤢᤏᤧ᤹ ᤁᤢᤕᤠ᤺ᤶᤒᤣᤀᤥ ᤌᤣᤀᤠᤱ ᤔᤧᤶᤒᤠ᤺ᤳᤋᤢᤴᤗ ᤑᤠ᤹ᤀᤠᤱ ᤁᤧᤛᤠᤰᤐᤠ ᤀᤡᤱᤈᤠ᤺ᤱ ᤐᤡᤖᤢᤛᤡ॥"]},{"typ