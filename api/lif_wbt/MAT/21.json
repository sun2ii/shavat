{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"MAT","translationId":"lif_wbt","name":"ᤔᤳᤋᤡ","commonName":"ᤔᤳᤋᤡ","title":"ᤔᤳᤋᤡᤖᤧ ᤛᤠᤵᤋᤢᤒᤠ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤛᤢᤏᤠᤀᤡᤱ","order":40,"numberOfChapters":28,"sha256":"92251ee343eb432e145aaeea5c2136c2828b4ff041495bf1aae6bdd263284826","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/lif_wbt/MAT/28.json","totalNumberOfVerses":1069},"chapter":{"number":21,"content":[{"type":"heading","content":["ᤕᤧᤛᤢ᤺ᤴ ᤕᤖᤢᤛᤗᤧᤶᤔᤥ ᤗᤠ᤺ᤳ"]},{"type":"verse","number":1,"content":["ᤕᤧᤛᤢ᤺ᤴ ᤏᤢ ᤁᤢᤜᤢ᤹ᤛᤠᤶᤒᤠᤜᤠ᤹ ᤕᤖᤢᤛᤗᤧᤔ ᤔᤧᤒᤣᤖ ᤔᤧᤒᤳᤇᤧᤸᤗᤧ ᤕᤖᤢᤛᤗᤧᤔ ᤏᤡ᤺ᤳᤋᤠᤱᤒᤠ ᤈᤤᤋᤢᤏ ᤁᤥ᤺ᤰᤔᤠᤸᤗᤧ ᤁᤢᤒᤣᤛᤠᤱᤒᤠ ᤒᤧᤌᤑᤠᤃᤣ ᤐᤠᤱᤓᤣ᤹ ᤏᤡ᤺ᤳᤋᤠᤱ ᤔᤧᤃᤧᤖᤧ. ᤜᤧᤰᤁᤩᤠᤱ ᤕᤧᤛᤢᤖᤧ ᤏᤧᤵᤑᤢ ᤁᤢᤜᤢ᤹ᤛᤠᤶᤒᤠᤜᤠ᤹ ᤀᤰᤂᤣ ᤔᤧᤳᤋᤢᤛᤡᤖ ᤐᤠᤱᤄᤢᤛᤡ."]},{"type":"verse","number":2,"content":["“ᤂᤡᤴᤇᤡ᤹ ᤋᤃᤠᤱᤒᤠ ᤐᤠᤱᤓᤣ᤹ᤀᤥ ᤐᤣᤛᤧ᤹. ᤂᤧᤵᤔᤥ ᤁᤧᤗᤠ᤺ᤳᤇᤡᤸᤗᤧᤛᤠ ᤀᤡᤔᤧᤄᤣ᤺ᤰᤂᤢᤔᤠ ᤀᤍᤱᤔᤠ᤺ᤸᤗᤧ ᤁᤢᤒᤣᤛᤠᤱ ᤁᤢᤛ᤻ᤛᤠ᤺ᤴ ᤕᤧᤵᤐᤠ ᤁᤧᤍᤢᤶᤛᤢ᤹॥ ᤂᤧᤴ ᤗᤧᤖᤧᤳᤇᤧ᤹ᤀᤠᤱ ᤀᤡᤱᤃᤠ᤹ᤀᤥ ᤋᤠᤖᤧᤳᤇᤧ᤹ᤀᤥ॥"]},{"type":"verse","number":3,"content":["ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤌᤣᤀᤠᤱ ᤁᤴ ᤀᤍᤱᤛᤠ᤺ᤴ ᤁᤧᤗᤧᤳᤇᤢᤒᤠᤒᤣ ᤑᤠ᤹ᤀᤠᤱ ᤛᤣ᤺ᤴᤃᤧᤶᤗᤠᤵᤛᤡᤏᤧ ᤑᤠ᤹ᤃᤪ ᤁᤱᤜᤠ᤹ ᤀᤠᤏᤡᤃᤧ ᤍᤠᤱᤒᤧᤴ ᤆᤠᤜᤠᤒᤠ ᤆᤥᤃᤧᤀᤠᤱ ᤘᤠ᤹. ᤜᤠᤖᤠᤀᤣ ᤂᤢᤏᤧ᤹ ᤕᤠᤱᤏᤠ ᤏᤢ᤺ᤰᤋᤢᤛᤡ᤹ ᤑᤠ᤹ᤀᤠᤱ ᤔᤧᤳᤋᤧᤇᤧ᤹ᤀᤥ॥”"]},{"type":"verse","number":4,"content":["ᤁᤱᤃ ᤔᤠᤱᤏᤡᤱᤘᤠ᤹ᤐᤠ᤺ᤴ ᤁᤧᤒᤠ᤺ᤵᤐᤠᤸᤗᤧ ᤀᤰᤂᤣ ᤐᤠ᤺ᤳᤋᤢᤒᤠᤴ ᤁᤧᤳᤗ ᤑᤠ᤹ᤀᤠᤱ ᤐᤥ᤺ᤰᤂᤧᤒᤠᤖᤥ–"]},{"type":"verse","number":5,"content":[{"text":"“ᤕᤖᤢᤛᤗᤧᤔᤛ᤻ᤔᤠ ᤔᤏᤠᤜᤠ᤹ ᤔᤧᤳᤋᤧᤛᤧ᤹.","poem":1},{"noteId":62},{"lineBreak":true},{"text":"ᤂᤡᤏᤡ᤹ ᤐᤕᤶ ᤜᤠᤱᤅᤡᤴ ᤂᤡᤏᤡ᤹ᤀᤥ ᤋᤠᤖ ᤐᤳ.","poem":1},{"lineBreak":true},{"text":"ᤂᤢᤏᤧ᤹ᤃ ᤆᤢᤱᤈᤡᤃᤧᤴ ᤏ᤺ᤶᤛᤡᤱᤅᤠᤱ ᤀᤍᤱᤛᤠ᤺ᤴ ᤕᤢᤰᤋᤢᤀᤠᤱ ᤋᤠ᤺.","poem":1},{"lineBreak":true},{"text":"ᤂᤢᤏᤧ᤹ᤃ ᤀᤍᤱᤛᤠ᤺ᤴᤏᤣ ᤕᤢᤰᤋᤢᤀᤠᤱ ᤋᤠᤖ ᤐᤳᤗᤥ॥”","poem":1},{"noteId":63}]},{"type":"verse","number":6,"content":["ᤂᤧᤴ ᤏᤧᤵᤑᤢ ᤜᤢ᤹ᤛᤠᤶᤒᤠᤜᤠ᤹ᤖᤧ ᤕᤧᤛᤢᤖᤧ ᤐᤠ᤺ᤳᤋᤢᤒᤠ ᤜᤧᤰᤁᤣ ᤆᤥᤃᤧᤳᤇᤢ॥"]},{"type":"verse","number":7,"content":["ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤀᤍᤱᤛᤠ᤺ᤴ ᤏᤢ ᤀᤍᤱᤔᤠ᤺ᤴ ᤋᤠᤖᤧᤳᤇᤢᤀᤠᤱ ᤂᤧᤱᤜᤠ᤹ ᤛᤶᤍᤠᤱ ᤂᤢᤏᤡ᤹ ᤋᤣ᤺ᤳᤜᤠ᤹ ᤔᤧᤏᤧᤛ᤻ᤛᤢ ᤜᤧᤰᤁᤩᤠᤱ ᤕᤧᤛᤢᤖᤧ ᤀᤍᤱᤛᤠ᤺ᤴ ᤕᤢᤰᤋᤢᤖᤥ॥"]},{"type":"verse","number":8,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤵᤔᤥ ᤕᤖᤡᤰ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤍᤃᤡ ᤁᤢᤍᤃᤡ ᤗᤠᤶᤔᤥ ᤂᤢᤏᤡ᤹ ᤋᤣ᤺ᤳᤜᤠ᤹ ᤔᤧᤓᤧᤛᤢ. ᤜᤧᤰᤁᤩᤠᤱ ᤘᤣ᤹ᤜᤠ᤹ᤖᤧ ᤆᤢᤈᤢᤰᤛᤠ ᤛᤡᤱ ᤐᤥᤖᤠ᤺ᤰᤜᤠ᤹ ᤔᤧᤈᤧᤵᤋᤢᤀᤠᤱ ᤗᤠᤶᤔᤥ ᤔᤧᤓᤧᤛᤢᤖ ᤂᤢᤏᤧ᤹ ᤗᤠᤱᤍᤠ᤺ᤰᤔᤠ ᤔᤧᤒᤡᤖᤢᤖᤥ॥"]},{"type":"verse","number":9,"content":["ᤂᤢᤏᤧ᤹ ᤁᤢᤍᤃᤡ ᤏᤢ ᤁᤢᤀᤣᤃᤠᤱ ᤁᤧᤒᤵᤐᤠ ᤕᤖᤡᤰ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤔᤧᤀ᤺ᤰᤋᤧᤖ ᤀᤰᤂᤣ ᤔᤧᤒᤠ᤺ᤳᤋᤢ.",{"text":"“ᤍᤠᤀᤢᤍᤖᤧ ᤁᤢᤛ᤻ᤛᤠ᤺ᤸᤗᤧ ᤁᤢᤏᤠᤖᤠ ᤐᤥ᤺ᤖᤖᤥ᥄","poem":1},{"lineBreak":true},{"text":"ᤕᤜᤘᤣ ᤍᤠᤱᤒᤠᤸᤗᤧ ᤁᤢᤔᤡᤱᤅᤥ ᤁᤧᤍᤠ᤺ᤒᤠᤴ ᤔᤢ᤹ᤀᤡᤛᤠᤒᤠ ᤐᤥ᤺ᤱᤗᤖᤥ᥄","poem":1},{"lineBreak":true},{"text":"ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱᤅᤥ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤏᤠᤖᤠ ᤐᤥ᤺ᤖᤖᤥ᥄”","poem":1},{"noteId":64}]},{"type":"verse","number":10,"content":["ᤕᤧᤛᤢ᤺ᤴ ᤕᤖᤢᤛᤗᤧᤔ ᤕᤧᤰᤕᤰᤁᤥ ᤗᤠ᤺ᤛᤧᤸᤗᤧ ᤕᤶᤒᤠ ᤜᤕᤱ ᤁᤡᤸᤗᤡᤱ ᤐᤥ᤺ᤰᤂᤧᤀᤠᤱ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤛᤣ᤺ᤴᤗᤠᤵᤔᤠ ᤔᤧᤜᤣ᤺ᤰᤋᤢ. “ᤁᤱᤃ ᤜᤠ᤺ᤳᤏᤡᤒᤣ᥅”"]},{"type":"verse","number":11,"content":["ᤔᤏᤠᤗᤢᤶᤔᤥᤗᤠᤶ ᤁᤢᤓᤠᤖᤧ ᤏᤥᤃᤵ ᤔᤧᤒᤡᤖᤢᤛᤡ. “ᤁᤱᤃ ᤃᤠᤗᤡᤗᤛ᤻ᤔᤠ ᤏᤠᤛᤖᤋᤗᤠᤶ ᤁᤧᤍᤠ᤺ᤒᤠ ᤔᤠᤱᤏᤡᤱᤘᤠ᤹ᤐᤠ᤺ᤴ ᤁᤧᤒᤠ᤺ᤵᤐᤠ ᤕᤧᤛᤢᤖᤥ॥”"]},{"type":"heading","content":["ᤕᤧᤛᤢ᤺ᤴ ᤔᤠᤱᤜᤡᤶᤔᤥ ᤐᤣ᤺ᤰ"]},{"type":"verse","number":12,"content":["ᤕᤧᤛᤢ᤺ᤴ ᤔᤠᤱᤜᤡᤶᤔᤥ ᤐᤣᤀᤠᤱ ᤂᤧᤵᤔᤥ ᤆᤡᤃ᤺ᤰᤘᤠ ᤁᤧᤛᤱᤒᤠ ᤁᤧᤀᤡᤱᤒᤠᤜᤠ᤹ ᤏᤠ᤺ᤵᤔᤠ ᤗ᤺ᤵᤔᤠ ᤜᤣ᤺ᤰᤋᤢᤛᤡ॥ ᤕᤠᤱ ᤁᤧᤗᤧᤰᤐᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤕᤠᤱᤗᤧᤰᤔᤠ ᤛᤠᤵᤏᤧᤳᤋᤡᤴ ᤏᤢ ᤐᤢᤳᤋᤢ᤺ᤰᤁᤣ ᤁᤧᤛᤱᤒᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤕᤢᤰᤏᤠ᤺ᤴ ᤗᤧᤰᤂᤢᤒᤡᤖᤢᤛᤡᤖᤥ॥"]},{"type":"verse","number":13,"content":["ᤕᤧᤛᤢᤖᤧ ᤂᤧᤱᤜᤠ᤹ ᤀᤰᤂᤣ ᤔᤧᤳᤋᤢᤛᤡ. “ᤛᤠᤶᤕᤥᤛᤠᤵᤗᤠᤀᤥ ᤛᤠᤵᤋᤧᤀᤠᤱ ᤐᤳ. ‘ᤀᤡᤱᤃᤠ᤹ ᤀᤠᤜᤡᤶᤔᤡᤱᤃ ᤋᤢᤘᤠ ᤆᤥ᤺ᤰᤔᤠ ᤜᤡᤶ ᤐᤥ᤺ᤱ.’ ᤁᤖ ᤂᤡᤏᤡ᤹ᤃ ᤑᤠ᤺ᤴᤍᤠᤜᤠ᤹ ᤆᤡᤱᤛᤡᤱᤔᤠ ᤋᤧᤴ ᤁᤧᤈᤥᤃᤢᤶᤔᤠᤱ ᤁᤧᤘᤕᤡ᤹ᤖᤥ᥄”"]},{"type":"verse","number":14,"content":["ᤕᤧᤛᤢ᤺ᤴ ᤔᤠᤱᤜᤡᤶᤔᤥ ᤘᤕᤧᤸᤗᤧ ᤔᤡᤰᤑ᤺ᤶᤒᤠᤜᤠ᤹ ᤏᤢ ᤗᤠᤱᤛᤰᤐᤠᤜᤠ᤹ ᤔᤧᤍᤩᤧ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤱᤜᤠ᤹ ᤁᤧᤖᤧᤰ ᤏᤢᤛᤢᤛᤡᤖᤥ॥"]},{"type":"verse","number":15,"content":["ᤁᤖ ᤋᤢᤶᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤒᤠᤜᤠ᤹ ᤏᤢ ᤛᤠᤶᤕᤥᤌᤡᤶᤛᤠᤶᤒᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤧ᤹ ᤆᤥᤃᤢᤒᤠ ᤏᤡᤱᤘᤠ᤹ ᤁᤧᤔᤠᤒᤠ ᤕᤠ᤺ᤶᤒᤰᤜᤠ᤹ ᤔᤧᤏᤡ᤺ᤛᤢ ᤜᤧᤰᤁᤩᤠᤱ ᤜᤡᤴᤈᤠ᤹ᤒᤡᤳᤇᤠᤜᤠ᤹ᤖᤧᤀᤠᤱ ᤔᤠᤱᤜᤡᤶᤔᤥ ᤍᤠᤀᤢᤍᤖᤧ ᤁᤢᤛ᤻ᤛᤠ᤺ᤸᤗᤧ ᤁᤢᤏᤠᤖᤠ ᤐᤥ᤺ᤖ ᤗ᤹ᤖᤡᤰ ᤔᤧᤀ᤺ᤰᤋᤧᤒᤠ ᤔᤧᤄᤧᤵᤛᤢᤸᤗᤧ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤛᤡᤰ ᤐᤥᤃᤧᤖᤥ॥"]},{"type":"verse","number":16,"content":["ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤧ᤹ ᤔᤧᤔᤧᤳᤋᤢ. “ᤁᤴᤜᤠ᤹ᤖᤧ ᤌᤣ ᤔᤧᤒᤠ᤺ᤳᤋᤢᤖ ᤔᤧᤒᤳ ᤁᤧᤱᤄᤧᤵᤛᤢᤴᤒᤡ᥅” ᤕᤧᤛᤢᤖᤧ ᤂᤧᤱᤜᤠ᤹ ᤔᤧᤳᤋᤢᤛᤡ. “ᤂᤧᤵᤛᤢᤱᤒᤧ. ᤁᤖ ᤛᤠᤶᤕᤥᤛᤠᤵᤗᤠᤀᤥ ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤛᤠᤵᤋᤧᤀᤠᤱ ᤁᤧᤒᤵᤐᤧᤴ ᤂᤡᤏᤡ᤹ ᤔᤧᤴᤏᤡ᤺ᤳᤋᤣ ᤁᤧᤘᤕᤡ᤹ᤒᤡ᥅",{"text":"‘ᤜᤡᤴᤈᤠ᤹ᤒᤡᤳᤇᤠᤜᤠ᤹ ᤏᤢ ᤏᤢᤃᤧᤎᤢᤱᤒᤠᤜᤠ᤹ᤗᤠᤶ ᤂᤢᤏᤧ᤹ ᤁᤧᤏᤠᤖᤠ ᤑᤥ᤺ᤔᤠ ᤐᤠᤱᤄᤢᤛᤡ’”","poem":1},{"noteId":65}]},{"type":"verse","number":17,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤕᤧᤛᤢᤖᤧ ᤂᤧᤱᤜᤠ᤹ ᤗᤧᤖᤢᤎᤛᤡᤀᤠᤱ ᤕᤧᤰᤕᤰᤗᤠᤶ ᤒᤧᤌᤠᤏᤡ ᤐᤠᤱᤈᤢᤶᤔᤥ ᤐᤣᤀᤠᤱ ᤕᤠᤱᤎᤥ᤺ᤰᤋᤧᤖᤥ॥"]},{"type":"heading","content":["ᤕᤧᤛᤢ᤺ᤴ ᤏᤢ ᤐ᤺ᤳᤇᤣ᤹ᤒᤢᤱᤔᤠ"]},{"type":"verse","number":18,"content":["ᤁᤢᤍᤠ᤺ᤴᤍᤡᤰ ᤋᤠᤏᤠᤶᤛᤠ ᤕᤧᤛᤢ᤺ᤴ ᤁᤢᤜᤢ᤹ᤛᤠᤶᤒᤠᤜᤠ᤹ᤏᤢ ᤕᤧᤰᤕᤰᤁᤥ ᤏᤢ᤺ᤰᤂᤧᤀᤠᤱ ᤐᤣᤖ ᤐᤳᤇᤧᤸᤗᤧ ᤁᤢᤛᤧᤳᤗᤠ᤺ᤰᤋᤧ॥"]},{"type":"verse","number":19,"content":["ᤗᤠᤶᤔᤡᤸᤗᤧ ᤁᤢᤒᤣᤛᤠᤱ ᤐ᤺ᤳᤇᤣ᤹ᤒᤢᤱᤔᤠᤴ ᤏᤡ᤺ᤛᤢᤀᤠᤱ ᤁᤢᤒᤣᤛᤠᤱ ᤐᤣ. ᤜᤧᤰᤁᤩᤠᤱ ᤀᤥᤔᤧᤳᤋᤢᤸᤗᤧ ᤁᤢᤓᤧᤰᤘᤠᤖᤰ ᤐᤳᤇᤧ ᤁᤖ ᤁᤢᤈᤠ᤹ ᤔᤧᤒᤳᤇᤧᤴᤗᤥ॥ ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤕᤧᤛᤢᤖᤧ ᤂᤧᤴ ᤐ᤺ᤳᤇᤣ᤹ᤒᤢᤱᤔᤠᤴ ᤔᤧᤳᤋᤢ. “ᤀᤠᤸᤗᤀᤠᤱᤎᤥ ᤀᤠᤵᤑᤠᤸᤗᤧᤀᤠᤱ ᤁᤧᤈᤠ᤹ ᤔᤧᤎᤥ᤺ᤰᤏᤧᤴᤗᤖᤥ॥” ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤴ ᤐ᤺ᤳᤇᤣ᤹ᤒᤢᤱᤔᤠᤴ ᤂᤡᤔᤥ ᤀᤡᤗᤧᤔᤧ ᤛᤩᤧᤖᤥ॥"]},{"type":"verse","number":20,"content":["ᤜᤢ᤹ᤛᤠᤶᤒᤠᤜᤠ᤹ᤖᤧ ᤂᤧᤴ ᤔᤧᤏᤡ᤺ᤛᤢᤀᤠᤱ ᤂᤢᤏᤡ᤹ ᤏᤡᤱᤘᤠ᤹ ᤔᤕᤧᤖ ᤔᤧᤒᤠᤖᤧ. “ᤀᤠᤰᤂᤧᤴ ᤜᤠᤖᤠᤏᤧ ᤁᤴ ᤐ᤺ᤳᤇᤣ᤹ᤒᤢᤱᤔᤠᤴ ᤀᤡᤗᤧᤔᤧ ᤛᤩᤧᤒᤠᤒᤣ᥄”"]},{"type":"verse","number":21,"content":["ᤕᤧᤛᤢᤖᤧ ᤂᤧᤱᤜᤠ᤹ ᤔᤧᤳᤋᤢᤛᤡ. “ᤂᤡᤏᤡ᤹ ᤀᤡᤱᤃᤠ᤹ ᤛᤧᤰᤂᤠᤀᤣ ᤔᤧᤳᤏᤡᤱ. ᤂᤡᤏᤡ᤹ ᤆᤵᤆᤡ ᤔᤧᤴᤈᤥ᤺ᤰᤁᤣ ᤏᤛᤠ᤺ᤴ ᤁᤧᤈᤥᤃᤢᤶᤏᤧ ᤑᤠ᤹ᤃᤪ ᤁᤴ ᤐ᤺ᤳᤇᤣ᤹ᤒᤢᤱᤔᤠᤴ ᤀᤡᤱᤃᤠ᤹ ᤆᤥᤃᤢᤱᤒᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤂᤡᤏᤡ᤹ᤀᤠᤱ ᤆᤥ᤺ᤰᤔᤠ ᤁᤧᤛᤢᤰᤋᤢᤶ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤶᤔᤩᤠᤰᤗᤰ ᤔᤧ᤺ᤴ. ᤁᤖ ‘ᤁᤴ ᤁᤥ᤺ᤰᤔᤠᤴ ᤜᤠ᤹ᤕᤠᤰ ᤀᤠᤃᤧ᤹ᤀᤠᤱ ᤘᤠᤜᤱᤅᤥ ᤗᤠᤵᤑᤢᤛᤡᤱᤅᤧ᤹’ ᤁᤧᤔᤧᤳᤋᤢᤶᤔᤡᤸᤗᤧ ᤂᤧᤴ ᤁᤧᤳᤗᤥ॥"]},{"type":"verse","number":22,"content":["ᤂᤡᤏᤡ᤹ ᤋᤢᤘᤠᤀᤥ ᤁᤧᤏᤠ᤺ᤰᤋᤢᤶᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤂᤥ᤺ᤛᤢᤶᤒᤧ᤹ ᤑᤠ᤹ᤀᤠᤱ ᤏᤛᤠ᤺ᤴ ᤁᤧᤈᤥᤃᤢᤶᤏᤧ ᤑᤠ᤹ᤃᤪ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤗᤠᤶ ᤁᤧᤄᤥ᤺ᤛᤢᤶᤗᤥ॥”"]},{"type":"heading","content":["ᤕᤧᤛᤢᤖᤧ ᤁᤢᤕᤢᤰᤁᤡᤸᤗᤧ ᤁᤢᤕᤠ᤺ᤶᤒᤣᤀᤥ ᤛᤣ᤺ᤴᤍᤥ"]},{"type":"verse","number":23,"content":["ᤕᤧᤛᤢ᤺ᤴ ᤔᤠᤱᤜᤡᤶᤔᤥ ᤁᤧᤖᤧᤀᤠᤱ ᤔᤏᤠᤜᤠ᤹ ᤏᤡᤛᤠᤶ ᤜᤢ᤹ᤔᤠ ᤜᤣ᤺ᤰᤋᤢᤛᤡᤸᤗᤧ ᤋᤢᤶᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤒᤠᤜᤠ᤹ ᤏᤢ ᤘᤣ᤹ ᤕᤜᤢᤍᤡ ᤋᤢᤶᤗᤠᤶᤗᤥ᤺ᤒᤠᤜᤠ᤹ ᤂᤧᤵᤔᤥ ᤔᤧᤍᤩᤧᤀᤠᤱ ᤂᤢᤏᤧ᤹ ᤛᤣ᤺ᤴᤔᤧᤍᤥᤛᤢ. “ᤂᤧᤏᤧ᤹ ᤌᤧᤔᤠ ᤕᤢᤰᤁᤡᤸᤗᤧ ᤀᤰᤋᤱᤒᤠ ᤕᤠ᤺ᤶᤒᤰᤜᤠ᤹ ᤁᤧᤈᤥᤃᤢᤖ ᤁᤧᤘᤠ᤹᥅ ᤁᤴ ᤕᤢᤰᤁᤡᤴ ᤜᤠ᤺ᤳᤗᤧ ᤁᤧᤒᤡᤖᤧ᥅”"]},{"type":"verse","number":24,"content":["ᤕᤧᤛᤢᤖᤧ ᤂᤧᤱᤜᤠ᤹ ᤔᤧᤳᤋᤢᤛᤡ. “ᤀᤡᤱᤃᤠ᤹ᤀᤠᤱ ᤗᤳᤇᤠ ᤛᤣ᤺ᤴᤗᤠᤵᤌᤡᤰ ᤛᤣ᤺ᤴᤍᤥ᤺ᤏᤡᤱᤗᤥ॥ ᤀᤡᤱᤃᤠ᤹ ᤕᤠᤵᤔᤡ ᤏᤥᤃᤵ ᤁᤧᤒᤡᤖᤡ᤹ᤏᤧ ᤑᤠ᤹ᤃᤪ ᤀᤡᤱᤃᤠ᤹ᤀᤠᤱ ᤌᤧᤔᤠ ᤕᤢᤰᤁᤡᤸᤗᤧ ᤕᤠ᤺ᤶᤒᤰ ᤆᤥᤃᤢᤱ ᤂᤧᤴ ᤔᤧᤳᤏᤡᤱᤗᤥ॥"]},{"type":"verse","number":25,"content":["ᤕᤢᤜᤢᤴᤏᤠᤖᤧ ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤐᤡᤔᤠ ᤁᤢᤕᤢᤰᤁᤡᤴ ᤀᤠᤳᤋᤥᤗᤠᤶ ᤋᤩᤧᤒᤠᤒᤣ᥅ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤗᤠᤶ ᤋᤩᤧᤒᤠᤒᤡ. ᤀᤡ ᤔᤏᤠᤗᤠᤶᤒᤡ᥅” ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤗᤢᤶᤔᤥ ᤐᤠ᤺ᤴ ᤔᤧᤎᤰᤋᤧᤖ ᤀᤰᤂᤣ ᤔᤧᤔᤧᤳᤇᤡᤱ. “ᤀᤠᤸᤗ ᤀᤠᤏᤡ᤹ ‘ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤗᤠᤶ’ ᤀᤠᤔᤧᤳᤋᤢᤶᤏᤧ ᤑᤠ᤹ᤃᤪ. ᤌᤣᤀᤠᤱ ᤏᤛᤠ᤺ᤴ ᤁᤧᤴᤈᤥᤃᤢᤶᤔᤡᤴ ᤑᤠ᤹ᤀᤠᤱ ᤛᤣ᤺ᤴᤀᤠᤗᤠᤵ॥"]},{"type":"verse","number":26,"content":["ᤁᤖ ‘ᤔᤏᤠᤜᤠ᤹ᤗᤠᤶ’ ᤀᤠᤒᤠ᤺ᤳᤋᤢᤶᤏᤧ ᤑᤠ᤹ᤃᤪ ᤔᤏᤠᤜᤠ᤹ ᤀᤠᤏᤡ᤹ ᤋᤰᤗᤧᤱᤘᤠᤀᤥ ᤔᤧᤒᤥ᤺ᤰᤐᤡ ᤑᤠ᤹ᤀᤠᤱ ᤀᤠᤃᤡᤖᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤁᤴ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤕᤢᤜᤢᤴᤏᤠ᤺ᤴ ᤔᤠᤱᤏᤡᤱᤘᤠ᤹ᤐᤠ᤺ᤴ ᤁᤧᤒᤠ᤺ᤵᤐᤠ ᤑᤠ᤹ᤀᤠᤱ ᤔᤧᤀᤡ᤺ᤳᤋᤢᤀᤠᤱ ᤔᤧᤘᤠ᤹ᤖᤥ॥”"]},{"type":"verse","number":27,"content":["ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤕᤧᤛᤢ᤺ᤴ ᤔᤧᤔᤧᤳᤋᤢ. “ᤀᤠᤏᤡᤃᤧ ᤔᤧᤏᤡ᤺ᤛᤢᤶᤒᤧᤴᤗᤥ॥” ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤕᤧᤛᤢᤖᤧ ᤂᤧᤱᤜᤠ᤹ ᤔᤧᤳᤋᤢᤛᤡ. “ᤜᤧᤰᤁᤣᤏᤧ ᤑᤠ᤹ᤃᤪ ᤌᤧᤔᤠ ᤕᤢᤰᤁᤡᤸᤗᤧ ᤀᤰᤋᤱᤒᤠ ᤕᤠ᤺ᤶᤒᤰᤜᤠ᤹ ᤆᤥᤃᤢᤱ ᤂᤧᤴ ᤀᤡᤱᤃᤠ᤹ᤀᤠᤱ ᤔᤧᤔᤧᤳᤏᤡᤱᤅᤡᤴᤗᤥ॥”"]},{"type":"heading","content":["ᤕᤧᤛᤢᤖᤧ ᤏᤧᤵᤑᤢ ᤛᤠ᤺ᤜᤠ᤹ᤖᤧᤴ ᤂᤧᤍᤠ᤹ᤀᤡᤴ ᤐᤠ᤺ᤳᤋᤢ᤹"]},{"type":"verse","number":28,"content":["ᤕᤠᤶᤔᤥ ᤕᤧᤛᤢᤖᤧ ᤂᤧᤴ ᤋᤢᤶᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤒᤠᤜᤠ᤹ ᤏᤢ ᤕᤜᤢᤍᤡ ᤗᤠᤶᤗᤥ᤺ᤒᤠᤜᤠ᤹ ᤔᤧᤳᤋᤢᤛᤡ. “ᤂᤡᤏᤡ᤹ ᤂᤧᤍᤠ᤹ᤎᤡᤰ ᤔᤧᤳᤏᤡᤱ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤸᤗᤧ ᤁᤢᤕᤠ᤺ᤶᤒᤣᤀᤥ ᤌᤣ ᤁᤧᤀᤡ᤺ᤳᤋᤢᤶ ᤀᤠᤔᤧᤳᤋᤧᤶᤔᤧ᤹ᤀᤥ॥ ᤗᤳᤇᤠ ᤔᤏᤠᤎᤡᤰ ᤘᤕᤧ. ᤂᤧᤸᤗᤧ ᤏᤧᤵᤑᤢ ᤁᤢᤛ᤻ᤛᤠ᤺ ᤕᤧᤶᤒᤡᤳᤇᤠ᤹ᤜᤠ᤹ ᤘᤕᤧᤳᤇᤡ॥ ᤂᤧᤴ ᤔᤏᤠ᤺ᤴ ᤁᤢᤛ᤻ᤛᤠ᤺ ᤋᤢᤶᤒᤠᤸᤗᤥ ᤐᤣᤀᤠᤱ ᤔᤧᤳᤋᤢ. ‘ᤀᤠᤛ᤻ᤛᤠ᤺ᤀᤣ. ᤐᤣᤃᤧ᤹ᤀᤠᤱ ᤆᤧᤸᤗᤧᤰᤛᤣ᤹ ᤀᤡᤰᤁᤥ ᤕᤠ᤺ᤶᤒᤰ ᤆᤥᤃᤧ᤹ᤀᤥ॥’"]},{"type":"verse","number":29,"content":["ᤂᤧᤴ ᤁᤢᤛ᤻ᤛᤠ᤺ᤸᤗᤧ ᤋᤃᤡᤃ ‘ᤔᤧᤈᤥ᤺ᤰᤁᤠᤴᤗᤥ’ ᤔᤧᤳᤋᤢ. ᤁᤖ ᤕᤠᤱᤛᤡ ᤁᤢᤏᤡᤱᤘᤠ᤹ ᤏᤢ᤺ᤰᤂᤧ. ᤜᤧᤰᤁᤩᤠᤱ ᤐᤣᤀᤠᤱ ᤕᤠ᤺ᤶᤒᤰ ᤆᤥᤃᤢᤖᤥ॥"]},{"type":"verse","number":30,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤁᤢᤶᤒᤠ᤺ᤴ ᤁᤢᤛ᤻ᤛᤠ᤺ ᤑᤥ᤹ᤒᤠᤸᤗᤥ ᤐᤣᤀᤠᤱ ᤒᤠ ᤜᤧᤰᤁᤣᤀᤣ ᤔᤧᤳᤋᤢ॥ ᤂᤧᤴ ᤁᤢᤛ᤻ᤛᤠ᤺ ᤑᤥ᤹ᤒᤠᤸᤗᤧᤀᤠᤱ. ‘ᤐᤥ᤺ᤱ ᤀᤠᤍᤠᤱᤒᤣ. ᤐᤣ᤺ᤰᤁᤠᤖᤥ’ ᤔᤧᤳᤋᤢ. ᤁᤖ ᤂᤧᤴ ᤕᤠ᤺ᤶᤒᤰᤁᤥ ᤔᤧᤒᤣᤏᤧᤴᤗᤥ॥"]},{"type":"verse","number":31,"content":["ᤀᤠᤸᤗ ᤂᤧᤴ ᤏᤧᤵᤑᤢᤀᤥ ᤀᤠᤳᤋᤡᤸᤗᤧ ᤂᤢᤴᤇᤡ᤹ ᤐᤠ᤺ᤸᤗᤧ ᤁᤢᤏᤡᤱᤘᤠ᤹ ᤜᤧᤰᤁᤣ ᤆᤥᤃᤧᤳᤇᤢᤒᤣ᥅” ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤏᤥᤃᤵ ᤔᤧᤒᤡᤖᤢ. “ᤋᤢᤶᤒᤠᤸᤗᤧᤖᤥ॥” ᤕᤧᤛᤢᤖᤧ ᤂᤧᤱᤜᤠ᤹ ᤔᤧᤳᤋᤢᤛᤡ. “ᤀᤡᤱᤃᤠ᤹ ᤛᤧᤰᤂᤠᤀᤣ ᤔᤧᤳᤏᤡᤱ. ᤏᤡᤱᤘᤠ᤹ᤑᤢᤜᤠᤱᤈᤢᤶᤔᤥ ᤀᤣ᤺ᤱᤕᤠᤱ ᤁᤧᤓᤥ᤺ᤱᤒᤠᤜᤠ᤹ ᤏᤢ ᤁᤧᤳᤏᤡᤔᤠᤜᤠ᤹ ᤂᤡᤏᤡ᤹ᤏᤢ᤺ᤸᤗᤧᤀᤠᤱ ᤋᤃᤡ ᤔᤧᤗᤠ᤺ᤳᤗᤥ॥"]},{"type":"verse","number":32,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤁᤧᤒᤡᤒᤠ ᤕᤢᤜᤢᤴᤏᤠ᤺ᤴ ᤂᤡᤏᤡ᤹ ᤛᤠᤶᤕᤥᤏᤡᤒᤠ ᤗᤠᤶ ᤀᤥᤛᤣ᤺ᤴᤎᤠᤰᤛᤧ ᤋᤩᤧᤒᤠᤖᤥ. ᤜᤧᤰᤁᤣᤛᤠᤱ ᤂᤢᤏᤧ᤹ ᤛᤶᤍᤠᤱ ᤂᤡᤏᤡ᤹ ᤏᤛᤠ᤺ᤴ ᤁᤧᤴᤈᤥᤃᤢᤶᤔᤡᤴᤗᤥ॥ ᤁᤖ ᤀᤣ᤺ᤱᤕᤠᤱ ᤁᤧᤓᤥ᤺ᤱᤒᤠᤜᤠ᤹ ᤏᤢ ᤁᤧᤳᤏᤡᤔᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤧ᤹ ᤏᤛᤠ᤺ᤴ ᤔᤧᤈᤥᤃᤢᤀᤠᤱ ᤔᤧᤘᤠ᤹ᤖᤥ॥ ᤂᤧᤴ ᤁᤧᤏᤡ᤺ᤛᤢᤶᤛᤠᤱ ᤂᤡᤏᤡ᤹ ᤗᤠᤕᤥᤗᤠᤶ ᤁᤧᤴᤜᤡᤴᤍᤡᤴᤏᤠᤱ ᤂᤢᤏᤧ᤹ ᤏᤛᤠ᤺ᤴᤏᤠᤱ ᤁᤧᤴᤈᤥᤃᤢᤶᤔᤡᤴᤗᤥ॥”"]},{"type":"heading","content":["ᤕᤧᤛᤢᤖᤧ ᤋᤠᤵᤑᤧ᤺ᤶᤒᤠ ᤁᤢᤓᤪᤧ᤺ᤱ ᤀᤡᤰᤔ᤺ᤒᤠᤜᤠ᤹ᤖᤧᤴ ᤂᤧᤍᤠ᤹ᤀᤡᤴ ᤐᤠ᤺ᤳᤋᤢ᤹"]},{"type":"verse","number":33,"content":["ᤕᤧᤛᤢᤖᤧ ᤕᤠᤶᤔᤥ ᤂᤧᤱᤜᤠ᤹ ᤔᤧᤳᤋᤢᤛᤡ. “ᤘᤣ᤹ᤛ᤻ᤔᤠ ᤂᤧᤍᤠ᤹ᤎᤡᤰ ᤂᤧᤵᤛᤧᤶᤔᤧ᤹ᤀᤥ॥ ᤌᤡᤰᤗᤧᤱ ᤕᤶᤒᤠ ᤗᤠᤈᤣ᤹ᤍᤠᤱᤒᤠᤎᤡᤰ ᤘᤕᤧ. ᤂᤧᤸᤗᤧ ᤗᤳᤇᤠ ᤀᤡᤰᤁᤥ ᤆᤧᤸᤗᤧᤰᤛᤣ᤹ ᤗᤣ᤺ᤳᤋᤢᤀᤠᤱ ᤁᤢᤄᤡᤖᤡ ᤗᤢᤱᤎᤠᤰ ᤛᤧᤳᤋᤢᤖ ᤑᤠᤅᤢ. ᤜᤧᤰᤁᤩᤠᤱ ᤁᤢᤗᤢᤶᤔᤥ ᤗᤢᤶᤒᤠ᤺ᤳ ᤋᤕᤢᤀᤠᤱ ᤂᤧᤵᤔᤥ ᤆᤧᤸᤗᤧᤰᤛᤣ᤹ ᤀᤣ᤺ᤶᤔᤠ ᤋᤧᤴᤎᤡᤰ ᤆᤥᤃᤢ॥ ᤀᤡᤰ ᤁᤥᤔᤠ ᤕᤠᤰᤛᤠᤎᤡᤰᤁᤠᤱ ᤆᤥᤃᤢ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤴ ᤆᤧᤸᤗᤧᤰᤛᤣ᤹ ᤀᤡᤰᤁᤡᤴ ᤁᤢᤓᤪᤧ᤺ᤱ ᤗᤰ ᤂᤥ᤺ᤔᤠᤖᤧ ᤗᤠᤃᤡ ᤀᤡᤰᤔᤛᤠᤒᤠᤜᤠ᤹ ᤐᤡᤖᤢᤛᤡᤀᤠᤱ ᤂᤢᤏᤧ᤹ ᤗᤠᤶᤍᤡ᤺ᤰ ᤆᤥ᤺ᤰᤛᤧ ᤐᤣᤖᤥ॥"]},{"type":"verse","number":34,"content":["ᤆᤧᤸᤗᤧᤰᤛᤣ᤹ ᤋᤢᤵᤔᤠ ᤕᤧᤶ ᤋᤩᤧ᤺ᤸᤗᤧ ᤁᤢᤗᤰ ᤗᤠ᤺ᤛᤧ ᤁᤢᤛᤣᤘᤠᤖᤥᤒᤠᤜᤠ᤹ ᤀᤡᤰᤔ᤺ᤒᤠᤜᤠ᤹ᤖᤥ ᤐᤠᤱᤄᤢᤛᤡᤖᤥ॥"]},{"type":"verse","number":35,"content":["ᤂᤧᤴ ᤀᤡᤰᤔ᤺ᤒᤠᤜᤠ᤹ᤖᤧ ᤁᤢᤛᤣᤘᤠᤖᤥᤒᤠᤜᤠ᤹ ᤔᤧᤍᤧᤶᤛᤢᤛᤡ ᤜᤧᤰᤁᤩᤠᤱ ᤌᤡᤰᤛᤡᤃᤣ᤺ᤰᤐᤠᤴ ᤔᤧᤜᤡᤵᤋᤢ. ᤏᤡᤛᤡᤃᤣ᤺ᤰᤐᤠᤴ ᤔᤧᤛᤧᤖᤢᤀᤠᤱ ᤛᤢᤶᤛᤡᤃᤣ᤺ᤰᤐᤠᤴ ᤗᤢᤱᤅᤡᤸᤗᤧ ᤔᤧᤒ᤺ᤳᤋᤢ ᤔᤧᤛᤧᤖᤢᤖᤥ॥"]},{"type":"verse","number":36,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤸᤗᤧ ᤋᤃᤡᤏᤢ᤺ᤸᤗᤧᤀᤠᤱ ᤕᤖᤡᤰ ᤁᤢᤛᤣᤘᤠᤖᤥᤒᤠᤜᤠ᤹ ᤐᤠᤱᤄᤢᤛᤡ. ᤁᤖ ᤂᤧᤴ ᤀᤡᤰᤔ᤺ᤒᤠᤜᤠ᤹ᤖᤧ ᤂᤧᤱᤜᤠ᤹ᤀᤠᤱ ᤒᤠ ᤜᤧᤰᤁᤣᤀᤣ ᤔᤧᤔᤧᤳᤋᤢᤛᤡ॥"]},{"type":"verse","number":37,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤁᤢᤏᤢᤵᤔᤥ ᤂᤧᤴ ᤀᤡᤰᤁᤧᤸᤗᤧ ᤁᤢᤴᤍᤠᤱᤒᤠᤸᤗᤧ ᤀᤠᤸᤗ ᤁᤴ ᤗᤢᤱᤔᤠ᤹ ᤋᤢᤰᤋᤢᤱᤒᤠ ᤀᤠᤛ᤻ᤛᤠ᤺ᤴ ᤐᤠᤱᤄᤢᤱᤅᤡᤸᤗᤧᤃ ᤛᤧᤰᤂᤠᤛᤠᤱ ᤁᤢᤏᤠ ᤔᤧᤛᤠ᤹ᤖᤢᤒᤡᤗᤠ ᤑᤠ᤹ᤀᤠᤱ ᤀᤡ᤺ᤳᤋᤢᤀᤠᤱ ᤁᤢᤛ᤻ᤛᤠ᤺ᤴ ᤐᤠᤱᤄᤢ॥"]},{"type":"verse","number":38,"content":["ᤁᤖ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤁᤢᤛ᤻ᤛᤠ᤺ᤴ ᤔᤧᤏᤡ᤺ᤛᤢᤀᤠᤱ ᤀᤰᤂᤣ ᤔᤧᤔᤧᤳᤇᤡᤱ. ‘ᤁᤱᤃ ᤁᤢᤶᤒᤠᤖᤧ ᤁᤢᤗᤰ ᤁᤧᤄᤥ᤺ᤒᤠᤖᤥ. ᤁᤴ ᤛᤧᤖᤢᤶᤔᤠᤱ ᤁᤢᤗᤠᤈᤣ᤹ ᤛᤡᤱᤒᤢᤱᤜᤠ᤹ ᤀᤠᤏᤡ᤹ ᤜᤢᤰᤁᤠᤵᤐᤠᤛᤡᤖᤥ॥’"]},{"type":"verse","number":39,"content":["ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤧ᤹ ᤔᤧᤍᤧᤶᤛᤢᤀᤠᤱ ᤆᤧᤸᤗᤧᤰᤛᤣ᤹ ᤀᤡᤰᤁᤥᤗᤠᤶ ᤗᤠ᤺ᤰᤁᤠᤳ ᤔᤧᤗ᤺ᤳᤋᤢᤀᤠᤱ ᤔᤧᤛᤧᤖᤢᤖᤥ॥”"]},{"type":"verse","number":40,"content":["ᤕᤧᤛᤢᤖᤧ ᤂᤧᤱᤜᤠ᤹ ᤛᤣ᤺ᤴᤍᤥᤛᤢᤛᤡ. “ᤀᤠᤸᤗ ᤆᤧᤸᤗᤧᤰᤛᤣ᤹ ᤀᤡᤰᤁᤧᤸᤗᤧ ᤁᤢᤴᤍᤠᤱᤒᤠᤴ ᤋᤠᤀᤠᤱ ᤂᤧᤴ ᤀᤡᤰᤔ᤺ᤒᤠᤜᤠ᤹ ᤀᤠᤰᤂᤣ ᤔᤧᤳᤋᤢᤛᤡ᤹ᤒᤣ᥅”"]},{"type":"verse","number":41,"content":["ᤂᤧᤴ ᤋᤢᤶᤕᤰᤕᤠᤒᤠᤜᤠ᤹ ᤏᤢ ᤕᤜᤢᤍᤡ ᤗᤠᤶᤗᤥ᤺ᤒᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤧ᤹ ᤏᤥᤃᤵ ᤔᤧᤒᤡᤖᤢ. “ᤂᤢᤏᤧ᤹ ᤋᤠᤀᤠᤱ ᤂᤧᤴ ᤋᤠᤰᤁᤧᤓᤧ᤹ᤒᤠ ᤔᤏᤠᤜᤠ᤹ ᤛᤧᤰᤂᤠᤛᤠᤱ ᤛᤠ᤹ᤖᤡᤰ ᤋᤢᤰᤂᤣ ᤆᤠ᤺ᤳᤋᤢᤛᤡᤖ ᤛᤧᤖᤢᤛᤡ᤹ᤖᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤆᤧᤸᤗᤧᤰᤛᤣ᤹ ᤀᤡᤰᤁᤡᤴ ᤁᤢᤓᤪᤧ᤺ᤱ ᤗᤰ ᤂᤥ᤺ᤔᤠᤖᤧ ᤗᤠᤃᤡ ᤘᤣ᤹ ᤀᤡᤰᤔ᤺ᤒᤠᤜᤠ᤹ ᤐᤡᤖᤢᤛᤡᤀᤠᤱ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤆᤧᤸᤗᤧᤰᤛᤣ᤹ ᤋᤢᤶᤔᤡᤸᤗᤧ ᤁᤢᤗᤰᤁᤡᤴ ᤔᤧᤒᤡᤖᤢ᤹ᤖᤥ॥”"]},{"type":"verse","number":42,"content":["ᤕᤧᤛᤢᤖᤧ ᤂᤧᤱᤜᤠ᤹ ᤔᤧᤳᤋᤢᤛᤡ. “ᤂᤡᤏᤡ᤹ ᤛᤠᤶᤕᤥᤛᤠᤵᤗᤠᤀᤥ ᤔᤧᤴᤏᤡ᤺ᤳᤋᤣ ᤁᤧᤘᤕᤡᤒᤡ᥅",{"text":"‘ᤗᤢᤱᤃᤠᤶᤒᤠᤜᤠ᤹ᤖᤧ ᤔᤧᤏᤠ᤹ᤖᤢᤒᤠ ᤗᤢᤱᤅᤡᤴ","poem":1},{"lineBreak":true},{"text":"ᤁᤧᤖᤧᤰᤏᤢ᤺ᤸᤗᤧ ᤁᤧᤕᤧᤰᤐᤠ ᤁᤢᤶᤔᤠ ᤗᤢᤱ ᤐᤥ᤺ᤰᤂᤧᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥","poem":1},{"lineBreak":true},{"text":"ᤁᤱᤃ ᤕᤜᤘᤣ ᤍᤠᤱᤒᤠᤸᤗᤧᤀᤣ ᤆᤥᤃᤢᤒᤠᤖᤥ.","poem":1},{"lineBreak":true},{"text":"ᤜᤧᤰᤁᤩᤠᤱ ᤁᤴ ᤀᤠᤏᤡ᤹ ᤏᤡ᤺ᤔᤥ ᤏᤡᤱᤘᤠ᤹ ᤁᤧᤔᤠᤒᤠ ᤆᤥ᤺ᤰᤗᤥ॥’","poem":1},{"noteId":66}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤂᤡᤏᤡ᤹ ᤔᤧᤳᤏᤡᤱ. ᤂᤡᤏᤡ᤹ᤀᤥᤗᤠᤶ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤜᤠᤱᤈᤢᤶᤔᤡᤴ ᤏᤠᤵᤐᤠᤱ ᤂᤧᤴᤏᤡᤴ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤏᤡᤱᤘᤠ᤹ ᤜᤧᤰᤁᤣ ᤁᤧᤈᤥ᤺ᤰᤐᤠ ᤔᤏᤠᤜᤠ᤹ ᤐᤡᤖᤢᤛᤡᤖᤥ॥","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"‘ᤀᤠᤳᤋᤡᤴᤜᤠ᤹ ᤂᤧᤴ ᤗᤢᤱ ᤛᤶᤍᤠᤱ ᤔᤰᤔᤧᤎᤠ᤹᤺. ᤂᤧᤱᤜᤠ᤹ ᤔᤧᤓᤰ ᤔᤧᤛᤡ᤺ᤖᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤳᤋᤡᤴᤜᤠ᤹ ᤛᤶᤍᤠᤱ ᤂᤧᤴ ᤗᤢᤱᤅᤡᤴ ᤔᤰᤌᤠ᤹᤺. ᤂᤧᤱᤜᤠ᤹ ᤔᤧᤓᤧᤰ ᤔᤧᤛᤡ᤺ᤖᤥ॥’”","poem":1}]},{"type":"verse","number":45,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤵᤔᤥ ᤋᤢᤶᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤒᤠᤜᤠ᤹ ᤏᤢ ᤑᤖᤡᤛᤡᤜᤠ᤹ᤖᤧ ᤁᤴ ᤂᤧᤍᤠ᤹ᤀᤡᤴ ᤔᤧᤄᤧᤵᤛᤢᤀᤠᤱ ᤁᤱᤃ ᤀᤠᤏᤡᤃᤧ ᤕᤠ᤺ᤶᤒᤣᤀᤥᤀᤣ ᤕᤧᤛᤢᤖᤧ ᤐᤠ᤺ᤳᤋᤢᤖ ᤐᤳ ᤑᤠ᤹ᤀᤠᤱ ᤏᤡᤱᤘᤠ᤹ ᤔᤧᤄᤥ᤺ᤛᤢᤖᤥ॥"]},{"type":"verse","number":46,"content":["ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤧ᤹ ᤋᤧᤶᤔᤠ ᤏᤡᤱᤘᤠ᤹ ᤔᤧᤈᤥᤃᤢ. ᤁᤖ ᤔᤏᤠᤜᤠ᤹ ᤔᤧᤃᤡᤖᤢᤛᤡ ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤕᤧᤛᤢ᤺ᤱᤃ ᤔᤠᤱᤏᤡᤱᤘᤠ᤹ᤐᤠ᤺ᤴ ᤁᤧᤒᤠ᤺ᤵᤐᤠ ᤑᤠ᤹ᤀᤠᤱ ᤔᤧᤀᤡ᤺ᤳᤋᤢᤀᤠᤱ ᤔᤧᤘᤕᤧᤖᤥ॥"]}],"footnotes":[{"noteId":62,"caller":"*","text":"ᤃᤪᤡᤁ ᤐᤠ᤺ᤴᤍᤠᤱᤅᤥ “ᤛᤡᤕᤥᤏᤖᤧ ᤁᤢᤛ᤻ᤛᤠ᤺ ᤔᤧᤴᤇᤢᤔᤠ᤹ᤀᤡᤴ ᤔᤧᤳᤋᤧ᤹॥” ᤛᤡᤕᤥᤏᤖᤧ ᤁᤥ᤺ᤰᤔᤠᤀᤥ ᤕᤖᤢᤛᤗᤧᤔ ᤕᤧᤰᤕᤰᤁᤡᤴ ᤏᤧ᤹᤺॥","reference":{"chapter":21,"verse":5}},{"noteId":63,"caller":"*","text":"ᤈᤁᤖᤡᤕᤠ ᥏.᥏","reference":{"chapter":21,"verse":5}},{"noteId":64,"caller":"*","text":"ᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤗᤥ ᤛᤢᤶ ᥇᥇᥎.᥈᥋-᥈᥌","reference":{"chapter":21,"verse":9}},{"noteId":65,"caller":"*","text":"ᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤗᤥ ᤛᤢᤶ ᥎.᥈","reference":{"chapter":21,"verse":16}},{"noteId":66,"caller":"*","text":"ᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤗᤥ ᤛᤢᤶ ᥇᥇᥎.᥈᥈-᥈᥉","reference":{"chapter":21,"verse":42}}]},"thisChapterLink":"/api/lif_wbt/MAT/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lif_wbt/MAT/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lif_wbt/MAT/20.json","previousChapterAudioLinks":{},"numberOfVerses":46}