{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"MAT","translationId":"lif_wbt","name":"ᤔᤳᤋᤡ","commonName":"ᤔᤳᤋᤡ","title":"ᤔᤳᤋᤡᤖᤧ ᤛᤠᤵᤋᤢᤒᤠ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤛᤢᤏᤠᤀᤡᤱ","order":40,"numberOfChapters":28,"sha256":"92251ee343eb432e145aaeea5c2136c2828b4ff041495bf1aae6bdd263284826","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/lif_wbt/MAT/28.json","totalNumberOfVerses":1069},"chapter":{"number":26,"content":[{"type":"heading","content":["ᤕᤧᤛᤢ᤺ᤴ ᤛᤧᤵᤔᤠ ᤆᤧᤶᤓᤴ"]},{"type":"verse","number":1,"content":["ᤕᤧᤛᤢᤖᤧ ᤁᤴ ᤁᤧᤖᤧᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤐᤠ᤺ᤳᤋᤢ ᤛᤢᤖᤢᤀᤠᤱ ᤂᤢᤏᤧ᤹ ᤁᤢᤜᤢ᤹ᤛᤠᤶᤒᤠᤜᤠ᤹ ᤀᤰᤂᤣ ᤔᤧᤳᤋᤢᤛᤡ."]},{"type":"verse","number":2,"content":["“ᤕᤜᤢᤍᤡ ᤆᤥ᤺ᤰᤕᤢᤶᤓᤥ ᤋᤱᤏᤠᤶᤔᤡᤴ ᤋᤠ᤺ᤔᤠ ᤏᤡᤕᤧᤴᤗᤰ ᤘᤠ᤹ᤒᤠᤃ ᤂᤡᤏᤡ᤹ ᤁᤧᤏᤡ᤺ᤛᤢᤶᤔᤣᤖᤥ. ᤜᤧᤰᤁᤩᤠᤱ ᤔᤧᤴᤇᤠᤶᤛᤠ᤺ᤴ ᤛᤡᤗᤠᤶᤛᤠᤰᤔᤠ ᤛᤡᤱᤅᤥ ᤑᤥ᤺ᤴᤇᤧ ᤜᤢᤰᤔᤧᤛᤢᤵᤋᤢ᤹ᤖᤥ॥”"]},{"type":"verse","number":3,"content":["ᤂᤧᤴ ᤕᤧᤶᤔᤥ ᤋᤢᤶᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤒᤠᤜᤠ᤹ ᤏᤢ ᤕᤜᤢᤍᤡ ᤋᤢᤶᤗᤠᤶᤗᤥ᤺ᤒᤠᤜᤠ᤹ ᤔᤠᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤒᤠᤸᤗᤧ ᤁᤢᤜᤡᤶᤔᤥ ᤔᤧᤈᤢᤵᤛᤧ॥ ᤂᤧᤸᤗᤧ ᤁᤢᤔᤡᤱᤃ ᤁᤤᤕᤠᤑᤠᤛ ᤘᤕᤧ॥"]},{"type":"verse","number":4,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤕᤧᤛᤢ᤺ᤴ ᤀᤠᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤛᤫᤠ᤺ᤳᤋᤠᤱ ᤋᤧᤶᤔᤠᤀᤠᤱ ᤛᤧᤵᤔᤠᤒᤣ ᤑᤠ᤹ᤀᤠᤱ ᤆᤧᤶᤓᤴ ᤔᤧᤈᤥᤃᤢᤖᤥ॥"]},{"type":"verse","number":5,"content":["ᤁᤖ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤔᤧᤒᤠ᤺ᤳᤋᤢ. “ᤁᤴ ᤋᤱᤏᤠᤶᤔᤥᤃ ᤀᤠᤏᤡ᤹ ᤜᤧᤰᤁᤣ ᤆᤥ᤺ᤰᤔᤠ ᤔᤧᤏᤢ᤹ᤏᤧᤴᤗᤥ. ᤔᤧ᤺ᤴᤏᤧ ᤑᤠ᤹ᤃᤪ ᤁᤴ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤜᤕᤱᤁᤡᤸᤗᤡᤱ ᤔᤧᤈᤥᤃᤢ᤹ᤖᤥ॥”"]},{"type":"heading","content":["ᤕᤧᤛ᤺ᤴ ᤑᤢᤱᤏᤠᤶ ᤔᤧᤜᤢ᤺ᤳᤋᤢ᤹"]},{"type":"verse","number":6,"content":["ᤂᤧᤴ ᤕᤧᤶᤔᤥ ᤕᤧᤛᤢ᤺ᤴ ᤒᤧᤌᤠᤏᤡ ᤐᤠᤱᤓᤣ᤹ᤀᤥ ᤗᤥᤃᤣ᤹ ᤋᤢᤰᤔᤠᤗᤠᤶ ᤁᤧᤘᤣ᤺ᤵᤐᤠ ᤛᤡᤔᤥᤏᤖᤧ ᤁᤢᤜᤡᤶᤔᤥ ᤘᤕᤧᤖᤥ॥"]},{"type":"verse","number":7,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤆᤠᤈᤠᤏᤢ ᤕᤢᤅᤧᤸᤗᤧ ᤔᤧᤴᤇᤢᤔᤠ᤹ᤎᤡᤰ ᤀᤡᤔᤧᤸᤗᤢᤱᤒᤠ ᤑᤢᤱᤏᤠᤶ ᤁᤧᤕᤠᤰᤐᤠ ᤗᤧᤶᤓᤠᤗᤢᤱ ᤐᤷᤕᤠᤔᤠᤏᤢ ᤋᤩᤧᤀᤠᤱ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤎᤧᤃᤣ᤺ᤰᤐᤥ ᤜᤢᤰᤂᤢᤖᤥ॥"]},{"type":"verse","number":8,"content":["ᤂᤧᤴ ᤔᤧᤏᤡ᤺ᤛᤢᤀᤠᤱ ᤁᤢᤜᤢ᤹ᤛᤠᤶᤒᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤛᤡᤰ ᤐᤥᤃᤧᤀᤠᤱ ᤀᤰᤂᤣ ᤔᤧᤒᤠ᤺ᤳᤋᤢ. “ᤌᤣᤀᤠᤱ ᤁᤴ ᤑᤢᤱᤏᤠᤶᤔᤡᤴ ᤆᤠᤛᤥ᤺ᤰᤂᤢᤒᤠᤒᤣ᥅"]},{"type":"verse","number":9,"content":["ᤁᤱᤃ ᤕᤖᤡᤰ ᤕᤠᤱᤅᤥ ᤛᤱᤔᤠᤀᤠᤱ ᤕᤠᤱᤃᤧᤛᤠ᤹ᤒᤠᤜᤠ᤹ ᤐᤡ᤺ᤔᤏᤠᤛᤡᤸᤗᤧ ᤐᤥ᤺ᤰᤂᤧᤒᤠᤖᤥ॥”"]},{"type":"verse","number":10,"content":["ᤕᤧᤛᤢᤖᤧ ᤁᤴ ᤏᤡᤱᤘᤠ᤹ ᤂᤥ᤺ᤛᤢᤀᤠᤱ ᤂᤧᤱᤜᤠ᤹ ᤏᤥᤃᤵ ᤐᤡᤖᤢᤛᤡ. “ᤌᤣᤀᤠᤱ ᤁᤴ ᤔᤧᤴᤇᤢᤔᤠ᤹ᤀᤡᤴ ᤋᤢᤰᤂᤣ ᤁᤧᤈᤠ᤺ᤳᤋᤢᤶᤒᤠᤒᤣ᥅ ᤂᤧᤸᤗᤧᤃ ᤀᤠᤗᤠᤃᤡ ᤏᤢ᤺ᤒᤠ ᤆᤥᤃᤢᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":11,"content":["ᤕᤠᤱᤃᤧᤛᤠ᤹ᤒᤠᤜᤠ᤹ᤃ ᤛᤍᤠᤍᤡᤱ ᤂᤡᤏᤡ᤹ᤏᤢ ᤔᤧᤘᤠ᤹ᤖᤥ॥ ᤁᤖ ᤀᤡᤱᤃᤠ᤹ᤃ ᤛᤍᤠᤍᤡᤱ ᤂᤡᤏᤡ᤹ᤏᤢ ᤔᤧᤘᤠ᤹ᤀᤠᤴᤗᤥ॥"]},{"type":"verse","number":12,"content":["ᤂᤧᤸᤗᤧ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤀᤠᤎᤰᤁᤥ ᤑᤢᤱᤏᤠᤶᤔᤡᤴ ᤜᤢᤰᤂᤢᤀᤠᤱ ᤀᤠᤗᤢᤵᤔᤠᤸᤗᤧᤴ ᤕᤠᤖᤡᤵ ᤆᤥᤃᤢᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":13,"content":["ᤀᤡᤱᤃᤠ᤹ ᤛᤧᤰᤂᤠᤀᤣ ᤔᤧᤳᤏᤡᤱ. ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥ ᤀᤠᤳᤋᤡᤛᤠᤱ ᤛᤢᤏᤠᤀᤡᤱ ᤀᤡᤱᤓᤥ᤺ᤸᤗᤧ. ᤂᤧᤵᤔᤥ ᤁᤴ ᤔᤧᤴᤇᤢᤔᤠ᤹ᤀᤡᤸᤗᤧ ᤆᤥᤃᤢᤒᤠ ᤁᤢᤕᤠ᤺ᤶᤒᤰᤁᤡᤴ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤔᤧᤈᤧᤰᤂᤢᤀᤠᤱ ᤏᤡᤱᤘᤠ᤹ ᤔᤧᤀᤡ᤺ᤳᤋᤢᤖᤥ॥”"]},{"type":"heading","content":["ᤕᤜᤢᤍᤠ ᤀᤡᤛ᤻ᤁᤖᤡᤕᤥᤋᤧᤴ ᤕᤧᤛᤢ᤺ᤴ ᤀᤡᤱᤗᤧᤰᤔᤠ ᤐᤠ᤺ᤴᤏᤥ ᤋᤧᤴ"]},{"type":"verse","number":14,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤌᤡᤰ-ᤏᤧᤳ ᤁᤢᤜᤢ᤹ᤛᤠᤶᤒᤠᤜᤠ᤹ᤀᤥ ᤕᤜᤢᤍᤠ ᤀᤡᤛ᤻ᤁᤖᤡᤕᤥᤋ ᤔᤧᤵᤔᤏᤠᤒᤧᤴ ᤋᤢᤶᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤒᤠᤜᤠ᤹ᤖᤥ ᤐᤣᤀᤠᤱ"]},{"type":"verse","number":15,"content":["ᤔᤧᤳᤋᤛᤡ. “ᤕᤧᤛᤢ᤺ᤴ ᤁᤧᤍᤧᤶᤛᤢᤶᤗ ᤑᤠ᤹ᤀᤠᤱ ᤂᤡᤏᤡ᤹ ᤜᤢᤰᤁᤥ ᤌᤠ᤺ᤛᤢᤱ ᤐᤡᤏᤡᤱᤅᤡᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ ᤌᤣ ᤕᤠᤵᤔᤡ ᤀᤠᤃᤧᤒᤡᤖᤡᤒᤣ᥅” ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤛᤢᤶᤒᤥ᤺ᤱ (᥉᥆) ᤕᤢᤵᤐᤠᤕᤠᤱ ᤂᤧᤴ ᤔᤧᤒᤡᤖᤢᤖᤥ॥"]},{"type":"verse","number":16,"content":["ᤂᤧᤴ ᤕᤧᤶᤔᤠᤱᤎᤥ ᤕᤜᤢᤍᤠ᤺ᤸᤗᤧ ᤕᤧᤛᤢ᤺ᤴ ᤀᤡᤱᤗᤧᤰᤔᤠ ᤑᤠ᤹ᤀᤠᤱ ᤛᤢᤕᤧᤶ ᤁᤥ᤺ᤵᤔᤠ ᤜᤣ᤺ᤰᤋᤢᤖᤥ॥"]},{"type":"heading","content":["ᤕᤧᤛᤢᤖᤧ ᤕᤜᤢᤍᤡ ᤆᤥ᤺ᤰᤕᤢᤶᤓᤥ ᤋᤱᤏᤠᤶᤔᤥ ᤆᤠ ᤆ᤹᤺"]},{"type":"verse","number":17,"content":["ᤀᤠᤸᤗ ᤛᤡᤍᤠ᤹ ᤔᤧᤴᤓ᤺ᤴᤏᤣᤒᤠ ᤂᤖᤧ᤺ᤱ ᤆᤠᤔᤠ ᤋᤱᤏᤠᤶᤔᤡᤸᤗᤧ ᤌᤡᤰᤛᤡᤃᤣ᤺ᤰᤐᤠ ᤕᤧᤴᤏᤥ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤜᤢ᤹ᤛᤠᤶᤒᤠᤜᤠ᤹ ᤂᤢᤏᤧ᤹ᤀᤥ ᤔᤧᤍᤩᤧᤀᤠᤱ ᤛᤣ᤺ᤴᤔᤧᤍᤥᤛᤢ. “ᤍᤠᤱᤒᤣ. ᤕᤜᤢᤍᤡ ᤆᤥ᤺ᤰᤕᤢᤶᤓᤥ ᤋᤱᤏᤠᤶᤖᤧᤴ",{"noteId":84},"ᤆᤠᤔᤠ ᤌᤢᤱᤔᤠ ᤀᤠᤳᤋᤥ ᤕᤠᤖᤡᤵ ᤆᤥ᤺ᤰᤔᤠ ᤁᤧᤗ᤹ᤒᤠ ᤏᤡᤱᤘᤠ᤹ ᤁᤧᤀᤡ᤺ᤳᤋᤢᤀᤠᤱ ᤘᤠ᤹ᤒᤣ᥅”"]},{"type":"verse","number":18,"content":["ᤕᤧᤛᤢᤖᤧ ᤂᤧᤱᤜᤠ᤹ ᤏᤥᤃᤵ ᤐᤡᤖᤢᤛᤡ. “ᤂᤡᤏᤡ᤹ ᤕᤧᤰᤕᤰᤁᤥ ᤐᤣᤃᤧᤶᤔᤧ᤹. ᤂᤧᤵᤔᤥ ᤗᤳᤇᤠ ᤔᤏᤠᤎᤡᤰ ᤁᤧᤍᤢᤔᤢᤶ॥ ᤂᤧᤴ ᤀᤰᤂᤣ ᤔᤧᤳᤋᤧᤶᤔᤧ᤹. ‘ᤍᤠᤱᤒᤠᤸᤗᤧ ᤀᤰᤂᤣ ᤐᤠ᤺ᤳᤋᤢᤀᤠᤱ ᤘᤠ᤹. ᤀᤡᤱ