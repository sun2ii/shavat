{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"MAT","translationId":"lif_wbt","name":"ᤔᤳᤋᤡ","commonName":"ᤔᤳᤋᤡ","title":"ᤔᤳᤋᤡᤖᤧ ᤛᤠᤵᤋᤢᤒᤠ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤛᤢᤏᤠᤀᤡᤱ","order":40,"numberOfChapters":28,"sha256":"92251ee343eb432e145aaeea5c2136c2828b4ff041495bf1aae6bdd263284826","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/lif_wbt/MAT/28.json","totalNumberOfVerses":1069},"chapter":{"number":27,"content":[{"type":"heading","content":["ᤕᤧᤛᤢ᤺ᤴ ᤛᤢᤜᤠᤱᤃᤧᤶᤒᤠ ᤐᤡᤗᤠᤋᤛᤖᤥ ᤔᤧᤍᤣ᤹ᤖᤢ"]},{"type":"verse","number":1,"content":["ᤁᤢᤏᤠᤶᤍᤠ᤺ᤵᤔᤠ ᤂᤠᤀᤥ᤺ᤳᤋᤧᤖ ᤐᤳᤇᤧᤸᤗᤧᤛᤠ ᤋᤢᤶᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤒᤠᤜᤠ᤹ ᤏᤢ ᤕᤜᤢᤍᤡ ᤋᤢᤶᤗᤠᤶᤗᤥ᤺ᤒᤠᤜᤠ᤹ᤖᤧ ᤀᤠᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤕᤧᤛᤢᤖᤧ ᤛᤡ᤺ᤔᤧᤸᤗᤧᤴ ᤂᤢᤶᤍᤡᤱ ᤂᤥ᤺ᤛᤢᤖ ᤕᤠ᤺ᤶᤔᤠᤒᤣ ᤑᤠ᤹ᤀᤠᤱ ᤏᤡᤱᤛᤣ᤺ᤰ ᤔᤧᤈᤥᤃᤢᤖᤥ॥"]},{"type":"verse","number":2,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤕᤧᤛᤢ᤺ᤴ ᤀᤡᤔᤧᤄᤣ᤺ᤰᤂᤢ ᤜᤧᤰᤁᤩᤠᤱ ᤖᤥᤔᤡ ᤛᤢᤜᤠᤱᤃᤧᤶᤒᤠ ᤐᤡᤗᤠᤋᤛᤖᤥ ᤔᤧᤍᤣ᤹ᤖᤢᤖᤥ॥"]},{"type":"heading","content":["ᤕᤜᤢᤍᤠ ᤀᤡᤛ᤻ᤁᤖᤡᤕᤥᤋᤡᤴ ᤀᤠᤒᤠᤅᤣ ᤑᤥ᤺ᤴᤇᤡᤱ ᤛᤡ᤹᤺"]},{"type":"verse","number":3,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ ᤀᤡᤱᤃᤧᤗᤧᤰᤐᤠ ᤕᤜᤢᤍᤠ᤺ᤸᤗᤧ ᤕᤧᤛᤢ᤺ᤴ ᤛᤡ᤺ᤔᤧᤸᤗᤧᤴ ᤂᤢᤶᤍᤡᤱ ᤔᤧᤒᤡᤖᤢ ᤁᤧᤗ᤹ᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤏᤡ᤺ᤛᤢᤀᤠᤱ ᤛᤠ᤹ᤖᤡᤰ ᤁᤢᤏᤡᤱᤘᤠ᤹ ᤗᤥ᤺ᤖᤧ. ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤂᤧᤴ ᤛᤢᤶᤒᤥ᤺ᤱ ᤕᤢᤵᤐᤠᤕᤠᤱᤅᤡᤴ ᤋᤣ᤹ᤖᤢᤀᤠᤱ ᤋᤢᤶᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤒᤠᤜᤠ᤹ ᤏᤢ ᤕᤜᤢᤍᤡ ᤋᤢᤶᤗᤠᤶᤗᤥ᤺ᤒᤠᤜᤠ᤹ ᤀᤰᤂᤣ ᤔᤧᤳᤋᤢᤛᤡᤖ ᤏᤢ᤺ᤰᤋᤢ ᤐᤡᤖᤢᤛᤡ."]},{"type":"verse","number":4,"content":["“ᤀᤡᤱᤃᤠ᤹ᤃ ᤗᤠᤕᤥ ᤆᤥᤃᤢᤱᤅᤠᤱ ᤘᤠ᤹ᤀᤠᤖᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤀᤠᤵᤑᤠᤸᤗᤧᤀᤠᤱ ᤑᤧᤴ ᤕᤠ᤺ᤶᤒᤰ ᤔᤧᤴᤈᤥ᤺ᤰᤁᤣ ᤁᤧᤘᤠ᤹ᤒᤠ ᤔᤏᤠ᤺ᤴ ᤀᤡᤱᤗᤧᤰᤋᤢᤱᤗᤥ॥” ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤏᤥᤃᤵ ᤔᤧᤒᤡᤖᤢ. “ᤀᤠᤏᤡᤃᤧ ᤌᤣᤀᤠᤱ ᤆᤥᤃᤢᤶᤒᤧᤒᤠ ᤜᤥ᤺ᤵᤗᤥ॥ ᤂᤧᤱᤃ ᤂᤧᤏᤧ᤹ ᤀᤠᤒᤠᤅᤣ ᤁᤧᤈᤥᤃᤢᤒᤠᤖᤥ॥”"]},{"type":"verse","number":5,"content":["ᤂᤧᤴ ᤂᤧᤵᤛᤢᤀᤠᤱ ᤕᤜᤢᤍᤠ᤺ᤸᤗᤧ ᤂᤧᤴ ᤕᤢᤵᤐᤠᤕᤠᤱᤅᤡᤴ ᤔᤠᤱᤜᤡᤶᤔᤥ ᤗᤠᤵᤑᤢᤛᤢᤎ. ᤜᤧᤰᤁᤩᤠᤱ ᤗ᤺ᤴᤍᤧ ᤐᤣᤀᤠᤱ ᤀᤠᤒᤠᤅᤣ ᤑᤥ᤺ᤴᤇᤡᤱ ᤛᤩᤧᤖᤥ॥"]},{"type":"verse","number":6,"content":["ᤋᤢᤶᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤒᤠᤜᤠ᤹ᤖᤧ ᤂᤧᤴ ᤕᤢᤵᤐᤠᤕᤠᤱᤅᤡᤴ ᤔᤧᤄᤵᤛᤢᤀᤠᤱ ᤔᤧᤒᤠ᤺ᤳᤋᤢ. “ᤁᤱᤃ ᤔᤏᤠ ᤛᤧᤳᤇᤧ ᤐᤡᤔᤏᤠᤒᤠ ᤕᤠᤱᤗᤥ. ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤔᤠᤱᤜᤡᤶ ᤕᤠᤱᤓᤢᤱᤔᤠᤀᤥ ᤁᤣ᤺ᤵᤔᤠ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤸᤗᤧ ᤀᤠᤶᤒᤡᤏᤧᤴᤗᤥ॥”"]},{"type":"verse","number":7,"content":["ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤁᤥ᤺ᤶᤓᤗᤣᤖᤧ ᤁᤢᤀᤡᤰᤋᤠᤵᤐᤡᤴ ᤋᤠᤰᤁᤴᤏᤡᤒᤠᤜᤠ᤹ ᤔᤧᤛᤡ᤺ᤸᤗᤧ ᤗᤢᤵᤔᤠᤛᤡ ᤑᤠ᤹ᤀᤠᤱ ᤀᤡᤱᤔᤠ ᤏᤡ᤺ᤴᤎᤥ ᤔᤧᤈᤥᤃᤢ॥"]},{"type":"verse","number":8,"content":["ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤀᤠᤀᤡᤴ ᤌᤠᤖᤡᤰᤛᤠᤱ ᤂᤧᤴ ᤀᤡᤰᤋᤠᤵᤐᤡᤴ ᤔᤠᤰᤂᤡ᤹ᤖᤧ ᤀᤡᤱᤔᤏᤠᤒᤠ ᤀᤡᤰᤋᤠᤵ ᤗ᤹ᤖᤡᤰ ᤔᤧᤔᤧᤳᤋᤢᤖᤥ॥"]},{"type":"verse","number":9,"content":["ᤁᤱᤃ ᤔᤠᤱᤏᤡᤱᤘᤠ᤹ᤐᤠ᤺ᤴ ᤁᤧᤒᤠ᤺ᤵᤐᤠ ᤕᤷᤔᤡᤕᤠ᤺ᤸᤗᤧ ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤐᤠ᤺ᤳᤋᤢᤒᤠᤴ ᤁᤧᤖᤧᤒᤠᤖᤥ–",{"text":"“ᤀᤡᤛᤪᤠᤀᤡᤗᤡᤜᤠ᤹ᤖᤧ ᤔᤧᤜᤧᤴᤍᤢᤒᤠ ᤁᤢᤔᤧᤸᤗᤢᤱ ᤛᤢᤶᤒᤥ᤺ᤱ ᤕᤢᤵᤐᤠᤕᤠᤱ ᤔᤧᤍᤠ᤺ᤰᤋᤢᤖᤥ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ᤜᤧᤰᤁᤩᤠᤱ ᤍᤠᤱᤒᤧᤸᤗᤧ ᤀᤥ᤺ᤴᤎᤠᤰᤋᤠᤱᤒᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤁᤥ᤺ᤶᤓᤗᤣᤖᤧ ᤁᤢᤀᤡᤰᤋᤠᤵᤐᤡᤴ ᤔᤧᤀᤡᤅᤢᤖᤥ॥”","poem":1},{"noteId":90}]},{"type":"heading","content":["ᤕᤧᤛᤢ᤺ᤴ ᤛᤢᤜᤠᤱᤃᤧᤶᤒᤠ ᤐᤡᤗᤠᤋᤛᤖᤧ ᤁᤢᤍᤃᤡ"]},{"type":"verse","number":11,"content":["ᤀᤠᤸᤗ ᤕᤧᤛᤢ᤺ᤴ ᤖᤥᤔᤡ ᤛᤢᤜᤠᤱᤃᤧᤶᤒᤠ ᤐᤡᤗᤠᤋᤛᤖᤧ ᤁᤢᤍᤃᤡ ᤕᤧᤒᤧᤸᤗᤧ ᤛᤢᤜᤠᤱᤃᤧᤶᤒᤧᤸᤗᤧ ᤂᤢᤏᤧ᤹ ᤛᤣ᤺ᤴᤍᤥᤛᤢ. “ᤛᤧᤰᤂᤠ ᤂᤧᤏᤧ᤹ ᤕᤜᤢᤍᤡ ᤜᤠᤱᤏᤧᤒᤡ᥅” ᤕᤧᤛᤢᤖᤧ ᤏᤥᤃᤵ ᤐᤡᤖᤢ. “ᤂᤧᤱᤃ ᤂᤧᤏᤧ᤹ᤀᤣ ᤁᤧᤒᤠ᤺ᤳᤋᤢᤖ ᤁᤧᤒᤳᤗᤥ॥”"]},{"type":"verse","number":12,"content":["ᤁᤖ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤍᤰᤗᤧᤱᤘᤠᤀᤥ ᤋᤢᤶᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤒᤠᤜᤠ᤹ ᤏᤢ ᤕᤜᤢᤍᤡ ᤋᤢᤶᤗᤠᤶᤗᤥ᤺ᤒᤠᤜᤠ᤹ᤖᤧ ᤀᤠᤵᤋᤡᤰ ᤔᤧᤃᤢ᤺ᤳᤋᤢᤸᤗᤧ ᤂᤢᤏᤧ᤹ ᤔᤧᤶᤒᤠ᤺ᤳᤋᤣ ᤕᤧᤒᤧᤖᤥ॥"]},{"type":"verse","number":13,"content":["ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤐᤡᤗᤠᤋᤛᤖᤧ ᤛᤣ᤺ᤴᤍᤥᤛᤢ. “ᤂᤧᤏᤧ᤹ ᤁᤧᤍᤰᤗᤧᤱᤘᤠᤀᤥ ᤁᤧᤶᤃᤢ᤺ᤳᤋᤧᤒᤠ ᤀᤠᤵᤋᤡᤰᤁᤡᤴ ᤁᤧᤱᤄᤧᤵᤛᤢᤴᤒᤡ᥅”"]},{"type":"verse","number":14,"content":["ᤁᤖ ᤕᤧᤛᤢ᤺ᤴ ᤐᤠ᤺ᤴᤎᤡᤰᤁᤠᤱ ᤔᤧᤶᤒᤠ᤺ᤳᤋᤣ ᤕᤧᤒᤧ. ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤛᤢᤜᤠᤱᤃᤧᤶᤒᤠᤸᤗᤧ ᤛᤠ᤹ᤖᤡᤰ ᤁᤢᤏᤡᤱᤘᤠ᤹ ᤔᤕᤧᤖᤥ॥"]},{"type":"verse","number":15,"content":["ᤀᤠᤸᤗ ᤕᤜᤢᤍᤡ ᤆᤥ᤺ᤰᤕᤢᤶᤓᤥ ᤋᤱᤏᤠᤶᤔᤥ ᤗᤳᤇᤠ ᤛᤠᤰᤐᤠ ᤁᤧᤎᤠ᤺ᤒᤠ ᤔᤏᤠ᤺ᤴ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤗᤧᤖᤧ ᤀᤠᤒᤡᤖᤧ᤹ ᤑᤠ᤹ᤀᤠᤱ ᤐᤣᤗᤡ ᤔᤧᤓᤠᤰᤋᤢᤸᤗᤧ ᤛᤢᤜᤠᤱᤃᤧᤶᤒᤠᤸᤗᤧ ᤗᤧᤵᤔᤠ ᤌᤡᤶ ᤁᤳᤋᤢᤖᤥ॥"]},{"type":"verse","number":16,"content":["ᤂᤧᤴ ᤕᤧᤶᤔᤥ ᤒᤖᤒ᤻ᤒᤠᤛ ᤔᤧᤵᤔᤏᤠᤒᤠ ᤁᤧᤀᤡᤱᤒᤠ ᤁᤢ᤹ᤀᤡᤃᤧᤓᤧ᤹ᤒᤠᤴ ᤐᤢᤱᤗᤠᤜᤡᤶᤔᤥ ᤛᤠᤰᤋᤧᤀᤠᤱ ᤘᤕᤧ॥"]},{"type":"verse","number":17,"content":["ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤔᤏᤠᤜᤠ