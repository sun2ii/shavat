{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"MAT","translationId":"lif_wbt","name":"ᤔᤳᤋᤡ","commonName":"ᤔᤳᤋᤡ","title":"ᤔᤳᤋᤡᤖᤧ ᤛᤠᤵᤋᤢᤒᤠ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤛᤢᤏᤠᤀᤡᤱ","order":40,"numberOfChapters":28,"sha256":"92251ee343eb432e145aaeea5c2136c2828b4ff041495bf1aae6bdd263284826","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/lif_wbt/MAT/28.json","totalNumberOfVerses":1069},"chapter":{"number":28,"content":[{"type":"heading","content":["ᤕᤧᤛᤢ᤺ᤴ ᤕᤠᤶᤔᤥ ᤁᤢᤜᤡᤱᤘᤧᤳ ᤐᤥ᤺ᤱ"]},{"type":"verse","number":1,"content":["ᤏᤠ᤺ᤶᤛᤡᤱ ᤕᤧᤴᤏᤡᤸᤗᤧ ᤁᤢᤍᤠ᤺ᤴᤍᤡᤰᤔᤥ. ᤋᤧᤏᤧᤒᤠ ᤕᤧᤴᤏᤥ ᤂᤠᤀᤥ᤺ᤳᤋᤧᤖ ᤐᤳᤇᤧᤸᤗᤧ ᤔᤖᤡᤕᤔ ᤔᤃ᤻ᤍᤗᤡᤏᤡ᤺ᤴ ᤏᤢ ᤘᤣ᤹ᤛ᤻ᤔᤠ ᤔᤖᤡᤕᤶᤔᤡᤴ ᤕᤧᤛᤢ᤺ᤴ ᤔᤧᤏᤧᤛ᤻ᤛᤢᤒᤠ ᤀᤡᤵᤐᤢᤱᤅᤡᤴ ᤀᤥᤔᤧᤳᤇᤧ ᤐᤣᤛᤡᤖᤥ॥"]},{"type":"verse","number":2,"content":["ᤜᤰᤆᤄᤳ ᤛᤠ᤹ᤖᤡᤰ ᤁᤡᤵᤔᤠ ᤁᤧᤄᤢ᤺ᤒᤠ ᤗᤢᤵᤗᤡ ᤌᤠᤅᤧ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤕᤜᤘᤣ ᤍᤠᤱᤒᤠᤸᤗᤧ ᤁᤢᤔᤠᤱᤗᤠᤀᤡᤱᤒᤠᤎᤡᤰ ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱᤗᤠᤶ ᤕᤥ ᤌᤩᤧᤀᤠᤱ ᤀᤡᤵᤐᤢᤱᤅᤡᤸᤗᤧ ᤁᤢᤔᤢᤖᤠᤀᤥ ᤁᤧᤕᤧᤵᤐᤠ ᤂᤧᤴ ᤕᤶᤒᤠ ᤗᤢᤱᤅᤡᤴ ᤌᤡᤰ ᤗᤧᤵᤔᤠᤱ ᤀᤡᤛᤢᤀᤠᤱ ᤂᤧᤴ ᤛᤶᤍᤠᤱ ᤕᤢᤱᤛᤡᤱᤗᤥ॥"]},{"type":"verse","number":3,"content":["ᤂᤧᤸᤗᤧ ᤁᤢᤏᤠᤖᤠ᤺ᤴ ᤛᤠ᤺ᤶᤓᤣ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤗᤧᤰᤋᤧ. ᤜᤧᤰᤁᤩᤠᤱ ᤁᤢᤍᤣ᤺ᤳᤜᤠ᤹ ᤏᤠ᤺ᤱ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤑ᤺ ᤗ᤹ᤖᤧᤖᤥ॥"]},{"type":"verse","number":4,"content":["ᤂᤧᤴ ᤀᤡ᤺ᤵᤐᤢᤱ ᤁᤧᤃᤥ᤺ᤒᤠ ᤌᤰᤛᤢᤒᤠᤜᤠ᤹ ᤁᤡ᤺ᤔᤠᤸᤗᤧ ᤔᤧᤕᤰᤂᤧᤖ ᤜᤷᤃᤢᤵ ᤔᤧᤈᤥ᤺ᤴᤍᤧᤀᤠᤱ ᤁᤢᤛᤡᤘᤧᤳ ᤔᤏᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤔᤧᤒᤥ᤺ᤰᤂᤧᤖᤥ॥"]},{"type":"verse","number":5,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤔᤠᤱᤗᤠᤀᤡᤱᤒᤠᤸᤗᤧ ᤂᤧᤴ ᤔᤧᤴᤇᤢᤔᤠᤜᤠ᤹ ᤔᤧᤳᤋᤢᤛᤡ. “ᤔᤧᤃᤡᤛᤧᤳᤇᤧᤴᤏᤧ᤹ᤀᤥ. ᤂᤡᤴᤇᤡ᤹ ᤛᤡᤗᤠᤶᤛᤠᤰᤔᤠ ᤛᤡᤱᤛᤶᤍᤠᤱ ᤔᤧᤓᤥ᤺ᤴᤍᤢᤒᤠ ᤕᤧᤛᤢ᤺ᤴ ᤁᤧᤃᤥ᤺ᤳᤇᤢᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤁᤢᤛᤡᤱ ᤏᤡ᤺ᤳᤋᤢᤱᤗᤥ॥"]},{"type":"verse","number":6,"content":["ᤂᤢᤏᤧ᤹ᤃ ᤁᤵᤔᤥ ᤜᤥ᤺ᤵᤗᤥ. ᤂᤢᤏᤧ᤹ ᤐᤠ᤺ᤳᤋᤢᤒᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰᤁᤣ ᤁᤢᤛᤡᤘᤧᤳᤗᤠᤶ ᤁᤢᤜᤡᤱᤘᤧᤳ ᤐᤥ᤺ᤰᤂᤧᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥ ᤑᤧᤖᤧᤳᤇᤧ᤹ᤀᤠᤱ ᤁᤢᤎᤰᤁᤡᤴ ᤏᤧᤛ᤻ᤛᤧᤒᤠ ᤋᤧᤴᤏᤡᤴ ᤀᤥᤔᤧᤳᤋᤧᤳᤇᤧᤏᤠ॥"]},{"type":"verse","number":7,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤜᤠᤖᤠ ᤐᤣᤃᤧᤳᤇᤧ᤹ᤀᤠᤱ ᤁᤢᤜᤢ᤹ᤛᤠᤶᤒᤠᤜᤠ᤹ ᤀᤰᤂᤣ ᤔᤧᤳᤋᤧᤇᤧ᤹ᤀᤥ. ‘ᤂᤢᤏᤧ᤹ᤃ ᤁᤢᤛᤡᤘᤧᤳᤗᤠᤶ ᤁᤢᤜᤡᤱᤘᤧᤳ ᤐᤥ᤺ᤰᤂᤧᤀᤠᤱ ᤘᤠ᤹ᤖᤥ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤱᤜᤠ᤹ᤏᤢ᤺ᤸᤗᤧ ᤋᤃᤡ ᤃᤠᤗᤡᤗᤀᤥ ᤐᤣ᤺ᤰᤗ ᤐᤳᤗᤥ॥ ᤂᤢᤏᤧ᤹ ᤂᤧᤵᤔᤥᤀᤣ ᤂᤡᤏᤡ᤹ ᤁᤧᤍᤢᤔᤢᤶᤗᤥ॥’ ᤀᤥᤔᤧᤳᤋᤧᤳᤇᤧ᤹ᤀᤥ. ᤁᤴ ᤐᤠ᤺ᤴᤏᤡᤴ ᤂᤡᤴᤇᤡ᤹ ᤔᤧᤳᤏᤧᤳᤇᤡᤱᤅᤠᤱ ᤘᤠ᤹ᤀᤠᤖᤥ॥”"]},{"type":"verse","number":8,"content":["ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤂᤧᤴ ᤔᤧᤴᤇᤢᤔᤠᤜᤠ᤹ ᤁᤡ᤺ᤛᤧᤳᤇᤡᤛᤠᤱ ᤀᤥᤔᤢᤗ᤹ᤖᤧᤳᤇᤡᤖ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤜᤢ᤹ᤛᤠᤶᤒᤠᤜᤠ᤹ ᤔᤧᤘᤕᤧᤒᤠ ᤋᤧᤴᤏᤥ ᤂᤧᤴ ᤐᤠ᤺ᤴᤏᤡᤴ ᤔᤧᤳᤇᤧ ᤀᤡᤵᤐᤢᤱᤗᤠᤶ ᤆᤠᤳᤋᤧᤳᤇᤡᤖ ᤐᤣᤛᤡᤖᤥ॥"]},{"type":"verse","number":9,"content":["ᤜᤰᤆᤄᤳ ᤕᤧᤛᤢᤖᤧ ᤂᤧᤱᤜᤠ᤹ ᤋᤢᤔᤢᤛᤡᤀᤠᤱ “ᤛᤣᤘᤠᤖᤥ” ᤔᤧᤳᤋᤢᤛᤡ. ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤂᤧᤱᤜᤠ᤹ ᤕᤧᤛᤢᤖᤥ ᤋᤩᤧᤳᤇᤡᤀᤠᤱ ᤁᤢᤗᤠᤱᤜᤠ᤹ ᤋᤧᤶᤛᤧᤳᤇᤢᤖ ᤛᤣᤘᤠ ᤆᤥᤃᤧᤳᤇᤢ॥"]},{"type":"verse","number":10,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤕᤧᤛᤢᤖᤧ ᤂᤧᤱᤜᤠ᤹ ᤔᤧᤳᤋᤢᤛᤡ. “ᤂᤡᤴᤇᤡ᤹ ᤔᤧᤃᤡᤛᤧᤳᤇᤧᤴᤏᤧ᤹ᤀᤥ. ᤐᤣᤃᤧᤳᤇᤧ᤹ᤀᤠᤱ ᤀᤠᤴᤛᤠ᤹ᤛᤡ ᤃᤠᤗᤡᤗᤀᤥ ᤁᤧᤒᤣᤃᤡᤔᤢ ᤔᤧᤳᤋᤧᤇᤧᤛᤧ᤹ᤀᤥ. ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤀᤡᤱᤃᤠ᤹ ᤂᤧᤳᤌᤥᤀᤣ ᤔᤧᤍᤢᤶᤔᤠ᤹ᤖᤥ॥”"]},{"type":"heading","content":["ᤌᤰᤛᤢᤒᤠᤜᤠ᤹ᤖᤧ ᤁᤴ ᤜᤡᤴᤍᤥ᤺ᤰᤁᤡᤴ ᤋᤢᤶᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤒᤠᤜᤠ᤹ ᤔᤧᤈᤧᤰᤋᤢᤛᤡ᤹"]},{"type":"verse","number":11,"content":["ᤂᤧᤴ ᤔᤧᤴᤇᤢᤔᤠᤜᤠ᤹ ᤕᤧᤰᤕᤰᤁᤥ ᤏᤢ᤺ᤰᤂᤧᤳᤇᤡ ᤐᤣᤛᤧᤳᤇᤡᤸᤗᤧ ᤁᤢᤓᤠ ᤌᤰᤛᤢᤒᤠᤜᤠ᤹ ᤔᤧᤒᤣᤀᤠᤱ ᤐᤥ᤺ᤰᤂᤧᤒᤠ ᤁᤧᤖᤧᤰ ᤜᤡᤴᤍᤥ᤺ᤰᤁᤡᤴ ᤋᤢᤶᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤒᤠᤜᤠ᤹ ᤔᤧᤈᤧᤰᤋᤢᤛᤡᤖᤥ॥"]},{"type":"verse","number":12,"content":["ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤋᤢᤶᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤒᤠᤜᤠ᤹ ᤏᤢ ᤕᤜᤢᤍᤡ ᤋᤢᤶᤗᤠᤶᤗᤥ᤺ᤒᤠᤜᤠ᤹ ᤔᤧᤈᤢᤵᤛᤧᤀᤠᤱ ᤀᤡᤱᤔᤧᤍᤱᤄᤢ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤌᤰᤛᤢᤒᤠᤜᤠ᤹ ᤕᤖᤡᤰ ᤕᤠᤱ ᤔᤧᤒᤡᤖᤢᤛᤡᤖ"]},{"type":"verse","number":13,"content":["ᤀᤰᤂᤣ ᤔᤧᤔᤧᤳᤋᤢᤛᤡ. “ᤀᤠᤏᤡᤃᤧ ᤛᤧᤴᤍᤡᤰ ᤀᤡᤵᤛᤡᤃᤧᤀᤠᤱ ᤏᤧᤛ᤻ᤛᤡᤃᤧᤸᤗᤧ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤜᤢ᤹ᤛᤠᤶᤒᤠᤜᤠ᤹ ᤔᤧᤍᤩᤧᤀᤠᤱ ᤁᤢᤎᤰᤁᤡᤴ ᤔᤧᤄᤢ᤺ᤳᤋᤢᤀᤠᤱ ᤔᤧᤍᤣ᤹ᤖᤢᤖᤥ ᤗ᤹ᤖᤡᤰ ᤂᤡᤏᤡ᤹ ᤁᤧᤒᤠ᤺ᤳᤋᤢᤶᤗ ᤐᤥ᤺ᤱᤗᤥ॥"]},{"type":"verse","number":14,"content":["ᤁᤴ ᤐᤠ᤺ᤴᤏᤡᤴ ᤛᤢᤜᤠᤱᤃᤧᤶᤒᤠᤸᤗᤧ ᤂᤧᤵᤛᤢᤏᤧ ᤑᤠ᤹ᤃᤪ ᤂᤢᤏᤧ᤹ ᤁᤢᤏᤡᤱᤘᤠ᤹ ᤋᤠᤛᤢᤶᤒᤧᤀᤠᤱ ᤂᤡᤏᤡ᤹ ᤏᤠᤱᤅᤠᤛᤡᤃᤧ᤹ᤖᤥ॥”"]},{"type":"verse","number":15,"content":["ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤌᤰᤛᤢᤒᤠᤜᤠ᤹ᤖᤧ ᤕᤖᤡᤰ ᤕᤠᤱ ᤔᤧᤍᤠ᤺ᤰᤋᤢᤀᤠᤱ ᤂᤧᤱᤜᤠ᤹ ᤔᤧᤔᤧᤳᤋᤢᤛᤡᤒᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰᤁᤣ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤔᤧᤒᤠ᤺ᤳᤋᤢᤖᤥ॥ ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤁᤴ ᤐᤠ᤺ᤴᤏᤡᤱᤃ ᤛᤧ᤺ᤖᤧᤀᤠᤱ ᤀᤠᤀᤡᤴ ᤌᤠᤖᤡᤰᤛᤠᤱ ᤕᤜᤢᤍᤡᤜᤠ᤹ᤖᤧ ᤔᤧᤒᤠ᤺ᤳᤋᤢᤖᤥ॥"]},{"type":"heading","content":["ᤔᤠᤱᤛᤣᤘᤠ ᤕᤠ᤺ᤶᤒᤰ ᤆᤥ᤺ᤰᤔᤠ ᤐᤕᤶ ᤀᤡᤱᤈᤠ᤺ᤱ"]},{"type":"verse","number":16,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤌᤡᤰ-ᤌᤡᤰ (᥇᥇