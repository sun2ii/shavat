{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"MAT","translationId":"lif_wbt","name":"ᤔᤳᤋᤡ","commonName":"ᤔᤳᤋᤡ","title":"ᤔᤳᤋᤡᤖᤧ ᤛᤠᤵᤋᤢᤒᤠ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤛᤢᤏᤠᤀᤡᤱ","order":40,"numberOfChapters":28,"sha256":"92251ee343eb432e145aaeea5c2136c2828b4ff041495bf1aae6bdd263284826","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/lif_wbt/MAT/28.json","totalNumberOfVerses":1069},"chapter":{"number":3,"content":[{"type":"heading","content":["ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤁᤧᤒᤡᤒᤠ ᤕᤢᤜᤢᤴᤏᤠ᤺ᤸᤗᤧ ᤍᤠᤱᤒᤠᤸᤗᤧ ᤁᤢᤗᤠᤶᤔᤡᤴ ᤕᤠᤖᤡᤵ ᤆᤥᤃᤢ᤹"]},{"type":"verse","number":1,"content":["ᤂᤧᤴ ᤕᤧᤶᤔᤥ",{"noteId":13},"ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤁᤧᤒᤡᤒᤠ ᤕᤢᤜᤢᤴᤏᤠ ᤔᤧᤵᤔᤏᤠᤒᤠ ᤔᤏᤠ᤺ᤴ ᤕᤜᤢᤍᤡᤕᤠ ᤌᤢᤶᤔᤥᤒᤠ ᤀᤣ᤺ᤰᤛᤠᤍᤧᤴᤏᤥ ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤀᤡᤱᤓᤴ ᤆᤥᤃᤢᤖ ᤋᤩᤧ."]},{"type":"verse","number":2,"content":["“ᤂᤡᤏᤡ᤹ ᤗᤠᤕᤥᤗᤠᤶ ᤜᤡᤴᤍᤧᤶᤔᤧ᤹ᤀᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱᤒᤠ ᤜᤠᤱᤈᤢᤶᤔᤡᤴ",{"noteId":14},"ᤏᤡ᤺ᤳᤋᤠᤱᤅᤣ ᤋᤩᤧᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥”"]},{"type":"verse","number":3,"content":["ᤂᤢᤏᤧ᤹ ᤁᤢᤕᤠ᤺ᤶᤒᤣᤀᤥ ᤔᤠᤱᤏᤡᤱᤘᤠ᤹ᤐᤠ᤺ᤴ ᤁᤧᤒᤠ᤺ᤵᤐᤠ ᤕᤛᤤᤕᤠ᤺ᤸᤗᤧ ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤐᤠ᤺ᤳᤋᤢᤀᤠᤱ ᤘᤠ᤹ᤖᤥ.",{"text":"“ᤂᤢᤏᤧ᤹ ᤀᤣ᤺ᤰᤛᤠᤍᤧᤴᤏᤥ ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤁᤧᤀ᤺ᤰᤐᤠ ᤀᤡᤰᤗᤠᤖᤥ.","poem":1},{"lineBreak":true},{"text":"‘ᤍᤠᤱᤒᤠᤸᤗᤧ ᤁᤢᤔᤠᤖᤠᤶᤔᤡᤴ ᤕᤠᤖᤡᤵ ᤆᤥᤃᤧᤶᤔᤧ᤹ᤀᤠᤱ ᤁᤢᤗᤠᤶᤜᤠ᤹ ᤋᤥ᤺ᤴᤍᤥ᤺ᤴ ᤆᤥᤃᤧᤶᤔᤧ᤹᥄’”","poem":1},{"noteId":15}]},{"type":"verse","number":4,"content":["ᤀᤠᤸᤗ ᤕᤢᤜᤢᤴᤏᤠ᤺ᤸᤗᤧ ᤀᤢᤔᤣᤖᤧ ᤁᤢᤔᤢᤖᤡᤰᤗᤠᤶ ᤌᤠᤰᤔᤏᤠᤒᤠ ᤋᤣ᤺ᤳᤋᤡᤴ ᤆᤠᤰᤂᤢᤀᤠᤱ ᤛᤧᤜᤥᤒᤠ ᤑ᤹ᤀᤡ ᤕᤢᤵᤛᤢᤖᤥ॥ ᤂᤢᤏᤧ᤹ ᤁᤢᤈᤠᤔᤠᤱᤃ ᤏᤡ᤺ᤱᤄᤢ᤺ᤰᤘᤠ ᤏᤢ ᤋᤠᤶᤓᤢᤱ ᤛᤰᤘᤠᤄᤢ ᤘᤕᤧᤖᤥ॥"]},{"type":"verse","number":5,"content":["ᤕᤖᤢᤛᤗᤧᤔ ᤕᤧᤰᤕᤰᤗᤠᤶ ᤏᤢ ᤕᤜᤢᤍᤡᤕᤠ ᤌᤢᤶ ᤜᤧᤰᤁᤩᤠᤱ ᤕᤷᤍᤏ ᤕᤱᤄᤱ ᤂᤡᤖᤡᤒᤠ ᤁᤧᤖᤧᤰ ᤌᤢᤶᤜᤠ᤹ᤀᤥᤗᤠᤶ ᤔᤏᤠᤜᤠ᤹ ᤁᤢᤍᤢᤶᤛᤧ"]},{"type":"verse","number":6,"content":["ᤔᤧᤍᤩᤧᤀᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤗᤠᤕᤥᤒᤠᤀᤠᤖᤥ ᤔᤧᤒᤠ᤺ᤳᤋᤢᤖ ᤕᤷᤍᤏ ᤕᤱᤄᤱᤅᤥ ᤂᤢᤏᤧ᤹ᤗᤠᤶ ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤔᤧᤒᤥ᤺ᤰᤂᤧᤖᤥ॥"]},{"type":"verse","number":7,"content":["ᤁᤖ ᤕᤖᤡᤰ ᤑᤖᤡᤛᤡᤜᤠ᤹ ᤏᤢ ᤛᤍᤢᤁᤡᤜᤠ᤹",{"noteId":16},"ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤐᤥ᤺ᤱᤛᤧ ᤂᤢᤏᤧ᤹ᤀᤥ ᤔᤧᤍᤩᤧᤖ ᤔᤧᤒᤳᤇᤧᤒᤠ ᤏᤡ᤺ᤛᤢᤛᤡᤀᤠᤱ ᤀᤰᤂᤣ ᤔᤧᤳᤋᤢᤛᤡᤖ ᤑᤧ᤺ᤰᤋᤢᤛᤡ. “ᤀᤛᤣ᤺ᤰᤛᤠᤛᤣ. ᤂᤡᤏᤡ᤹ ᤁᤴ ᤁᤧᤍᤠ᤺ᤒᤠᤖ ᤁᤧᤒᤵᤐᤠ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤄᤢᤶᤍᤡᤱᤗᤠᤶ ᤂᤧᤳᤇᤡᤱᤅᤧᤶᤔᤧ᤹ ᤑᤠ᤹ᤀᤠᤱ ᤜᤠ᤺ᤳᤗᤧ ᤁᤧᤔᤧᤳᤋᤡᤒᤣ᥅"]},{"type":"verse","number":8,"content":["ᤗᤠᤕᤥᤗᤠᤶ ᤁᤧᤜᤡᤴᤍᤡᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤀᤥᤛᤣ᤺ᤴᤍᤠᤱ ᤆᤥ᤺ᤰᤛᤧ ᤏᤢ᤺ᤒᤠ ᤕᤠ᤺ᤶᤒᤰ ᤆᤥᤃᤧᤶᤔᤧ᤹ᤀᤥ॥"]},{"type":"verse","number":9,"content":["ᤀᤠᤏᤡᤃᤧᤃ ᤀᤒᤪᤠᤜᤠᤔᤖᤧ ᤁᤢᤛ᤻ᤛᤠ᤺ᤛᤡᤃᤧ. ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤂᤢᤶᤍᤡᤱᤗᤠᤶ ᤂᤧᤳᤇᤡᤱᤔᤠ ᤛᤢᤰᤋᤡᤃᤧ᤹ ᤑᤠ᤹ᤀᤠᤱ ᤏᤡᤱᤘᤠ᤹ ᤔᤧᤀᤡ᤺ᤳᤋᤧᤶᤔᤡᤴᤏᤧ᤹ᤀᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧᤃ ᤁᤴ ᤗᤢᤱᤜᤠ᤹ᤀᤠᤱ ᤀᤒᤪᤠᤜᤠᤔᤖᤧ ᤁᤢᤛ᤻ᤛᤠ᤺ ᤆᤥ᤺ᤰᤔᤠ ᤛᤢᤰᤋᤢᤛᤡ᤹ᤖᤥ॥"]},{"type":"verse","number":10,"content":["ᤀᤠᤸᤗᤥᤛᤠ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤄᤠᤛᤧᤴᤏᤡᤸᤗᤧ ᤋ᤺ᤴᤍᤡᤱᤃ ᤛᤡᤱᤒᤢᤱᤔᤥ",{"noteId":17},"ᤂᤠ ᤆᤢᤰᤔᤠ ᤀᤡ᤺ᤳᤋᤧᤀᤠᤱ ᤘᤠ᤹॥ ᤏᤢ᤺ᤒᤠ ᤛᤡᤱᤛᤣ᤹ ᤔᤧᤴᤎᤥ᤺ᤰᤔᤏᤠᤒᤠ ᤛᤡᤱᤒᤢᤱᤜᤠ᤹ ᤁᤧᤖᤧᤰ ᤋᤠᤱᤔᤠᤀᤠᤱ ᤔᤡᤀᤥ ᤗᤠᤵᤑᤢᤔᤠ ᤐᤥ᤺ᤱᤗᤥ॥"]},{"type":"verse","number":11,"content":["ᤗᤠᤕᤥᤗᤠᤶ ᤁᤧᤜᤡᤴᤍᤡᤀᤠᤱ ᤀᤡᤱᤃᤠ᤹ᤃ ᤆᤫᤠ᤺ᤳᤋᤡᤸᤗᤧ ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤐᤡᤏᤡᤱᤗᤥ. ᤁᤖ ᤀᤠᤀᤣᤃᤠᤱ ᤁᤧᤍᤠ᤺ᤒᤧᤱᤃ ᤀᤡᤱᤃᤠ᤹ᤏᤢ᤺ᤸᤗᤧᤀᤠᤱ ᤔᤢᤰᤛᤠᤶᤛᤠᤒᤠ ᤆᤥ᤺ᤰᤗᤥ॥ ᤂᤢᤏᤧ᤹ ᤁᤢᤗᤠᤱᤛᤢ᤺ᤵᤜᤠ᤹ ᤀᤡᤱᤃᤠ᤹ ᤕᤥ᤺ᤰ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤐᤱᤔᤠᤀᤠᤱ ᤔᤧᤗᤠ᤹ᤀᤠᤴᤗᤥ॥ ᤂᤢᤏᤧ᤹ ᤛᤣᤛᤣᤔᤠᤱ ᤏᤢ ᤔᤡ᤺ᤸᤗᤧ ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤁᤧᤒᤡᤖᤡ᤹ᤖᤥ॥"]},{"type":"verse","number":12,"content":["ᤁᤢᤓ᤹ᤀᤣ᤺ᤳᤋᤡᤸᤗᤧ ᤛᤡ᤺ᤴ ᤀᤠ᤺ᤶᤔᤠ ᤑᤠ᤹ᤀᤠᤱ ᤂᤢᤏᤧ᤹ ᤕᤠᤖᤡᤵ ᤘᤠ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ ᤋᤢᤃᤢᤖ ᤛᤢᤵᤛᤢᤀᤠᤱ ᤛᤡ᤺ᤴ ᤆᤠᤎᤥ᤺ᤰᤗᤠᤀᤥ ᤆᤡᤰᤂᤢ᤹ ᤜᤧᤰᤁᤩᤠᤱ ᤁᤢᤜᤰᤜᤠ᤹ ᤀᤠᤵᤑᤠᤸᤗᤧᤀᤠᤱ ᤔᤧᤴᤇᤡ᤺ᤔᤏᤠᤒᤠ ᤔᤡᤀᤥ ᤜᤠ᤺ᤴᤍᤢᤍᤣ᤺ᤛᤢ᤹ᤖᤥ॥”"]},{"type":"heading","content":["ᤕᤢᤜᤢᤴᤏᤠ᤺ᤸᤗᤧ ᤕᤧᤛᤢ᤺ᤴ ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤐᤡᤖᤢ᤹"]},{"type":"verse","number":13,"content":["ᤂᤧᤴ ᤕᤧᤶᤔᤥ ᤕᤧᤛᤢ᤺ᤴ ᤃᤠᤗᤡᤗ ᤌᤢᤶᤔᤥᤗᤠᤶ ᤕᤷᤍᤏ ᤕᤱᤄᤱᤅᤥ ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤐᤥ᤺ᤱᤛᤧ ᤕᤢᤜᤢᤴᤏᤠᤖᤥ ᤋᤩᤧᤖᤥ."]},{"type":"verse","number":14,"content":["ᤁᤖ ᤕᤢᤜᤢᤴᤏᤠᤖᤧ ᤀᤳᤋᤢᤖ ᤂᤢᤏᤧ᤹ ᤀᤰᤂᤣ ᤔᤧᤳᤋᤢ. “ᤀᤡᤱᤃᤠ᤹ᤏᤧ ᤂᤧᤏᤧ᤹ᤏᤢ ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤐᤥ᤺ᤱᤔᤠ ᤁᤧᤒᤥ᤺ᤱᤒᤠ. ᤀᤠᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤂᤧᤏᤧ᤹ ᤀᤡᤱᤃᤠ᤹ᤀᤥ ᤁᤧᤍᤩᤧᤒᤠᤒᤣ᥅”"]},{"type":"verse","number":15,"content":["ᤕᤧᤛᤢᤖᤧ ᤏᤥᤃᤵ ᤐᤡᤖᤢ. “ᤀᤠᤸᤗᤥᤖᤧ ᤗᤠᤃᤡ ᤀᤰᤂᤣᤀᤣ ᤐᤥ᤺ᤱᤗᤖᤥ. ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤧᤖᤧᤰ ᤏᤡᤱᤘᤠ᤹ ᤆᤥᤃᤢᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤁᤧᤳᤗᤖᤥ॥” ᤜᤧᤰᤁᤩᤠᤱ ᤕᤢᤜᤢᤴᤏᤠ᤺ᤴ ᤋᤧᤴᤍᤧᤀᤠᤱ ᤂᤢᤏᤧ᤹ ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤐᤡᤖᤢᤖᤥ॥"]},{"type":"verse","number":16,"content":["ᤕᤧᤛᤢ᤺ᤴ ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤐᤥ᤺ᤰᤂᤧᤀᤠᤱ ᤆᤫᤠ᤺ᤳᤋᤥᤗᤠᤶ ᤗᤠ᤺ᤰᤁᤠᤳ ᤗ᤺ᤴᤍᤧᤏᤢᤔᤧ᤺ᤴᤏᤣ ᤋᤠᤱᤛᤠᤰᤐᤧᤴ ᤜᤖᤧᤀᤠᤱ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤛᤣᤛᤣᤔᤠᤱᤅᤡᤴ ᤐᤢᤳᤋᤢ᤺ᤰᤁᤣ ᤜᤧᤰᤁᤣ ᤂᤢᤏᤧ᤹ ᤁᤢᤛᤶᤍᤠᤱ ᤕᤧ᤺ᤖ ᤐᤳᤇᤧᤒᤠ ᤏᤡ᤺ᤛᤢᤖᤥ॥"]},{"type":"verse","number":17,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱᤗᤠᤶ ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤀᤡᤰᤗᤠᤎᤡᤰ ᤋᤩᤧ. “ᤁᤴ ᤀᤠᤔᤡ᤺ᤶ ᤀᤠᤛ᤻ᤛᤠ᤺ᤖᤥ. ᤀᤡᤱᤃᤠ᤹ ᤂᤢᤏᤧ᤹ᤏᤢ ᤛᤠ᤹ᤖᤡᤰ ᤛ᤺ᤳᤋᤠᤱᤅᤠᤱ ᤘᤠ᤹ᤀᤠᤖᤥ॥”"]}],"footnotes":[{"noteId":13,"caller":"*","text":"ᤏᤠ᤺ᤳᤗᤠ ᤛᤢᤶᤛᤡᤀᤥᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤏᤠ᤺ᤳᤗᤠ ᤏᤧᤳᤇᤡᤏᤢ᤺ᤸᤗᤧ ᤋᤱᤒᤣ ᥈᥎ ᤀᤣᤃᤠᤱ ᤐᤥ᤺ᤰᤂᤧᤒᤠᤖᤥ॥","reference":{"chapter":3,"verse":1}},{"noteId":14,"caller":"*","text":"ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱᤒᤠ ᤜᤠᤱᤈᤢᤶᤔᤡᤴ ᤏᤢ ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤜᤠᤱᤈᤢᤶᤔᤡᤴ ᤗᤳᤇᤠᤛᤡ॥ ᤕᤜᤢᤍᤡᤜᤠ᤹ᤖᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤔᤡᤱᤅᤡᤴ ᤔᤧᤶᤒᤠ᤺ᤳᤋᤢᤴ. ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤜᤠᤱᤈᤢᤶ ᤔᤧ᤺ᤴ. ᤁᤖ ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱᤒᤠ ᤜᤠᤱᤈᤢᤶ ᤔᤧᤒᤠ᤺ᤳᤋᤢ᤹॥","reference":{"chapter":3,"verse":2}},{"noteId":15,"caller":"*","text":"ᤕᤛᤤᤕᤠ ᥊᥆.᥉","reference":{"chapter":3,"verse":3}},{"noteId":16,"caller":"*","text":"ᤑᤖᤡᤛᤡᤜᤠ᤹ ᤏᤢ ᤛᤍᤢᤁᤡᤜᤠ᤹ ᤘᤣ᤹ ᤘᤣ᤹ ᤐᤖᤡᤰᤐᤠ ᤕᤜᤢᤍᤡ ᤛᤠᤶᤕᤥ ᤁᤧᤏᤠ᤺ᤵᤐᤠ ᤔᤏᤠ ᤔᤧᤘᤕᤧ॥ ᤁᤱᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤕᤠ᤺ᤶᤒᤣᤀᤥ ᤏᤢ᤺ᤖᤡᤰᤁᤠᤱ ᤗᤧᤔᤠᤖᤧ ᤗᤠᤃᤡ ᤐᤠ᤺ᤴᤛᤢᤳᤗᤠᤀᤥ ᤀᤥᤔᤳᤋᤧ᤹ᤀᤥ॥","reference":{"chapter":3,"verse":7}},{"noteId":17,"caller":"*","text":"ᤁᤵᤔᤥ ᤛᤡᤱᤒᤢᤱᤅᤡᤴ ᤔᤏᤠᤏᤢ ᤔᤧᤍᤱᤄᤢᤀᤠᤱ ᤘᤠ᤹॥ ᤛᤡᤱᤒᤢᤱᤅᤥ ᤏᤢ᤺ᤒᤠ ᤁᤢᤈᤠ᤹ ᤔᤧᤎᤥ᤺ᤰᤏᤧᤴᤒᤠᤸᤗᤧ ᤂᤧᤴ ᤋᤠᤱᤔᤏᤠᤒᤠ ᤜᤧᤰᤁᤣ ᤏᤢ᤺ᤒᤠ ᤕᤠ᤺ᤶᤒᤰ ᤔᤧᤴᤈᤥ᤺ᤰᤔᤏᤠ ᤔᤏᤠᤜᤠ᤹ ᤂᤢᤶᤍᤡᤱ ᤔᤧᤒᤡᤖᤢᤛᤡᤖᤥ॥","reference":{"chapter":3,"verse":10}}]},"thisChapterLink":"/api/lif_wbt/MAT/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lif_wbt/MAT/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lif_wbt/MAT/2.json","previousChapterAudioLinks":{},"numberOfVerses":17}