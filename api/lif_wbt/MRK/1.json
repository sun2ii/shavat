{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"MRK","translationId":"lif_wbt","name":"ᤔᤷᤁᤢᤛ","commonName":"ᤔᤷᤁᤢᤛ","title":"ᤔᤷᤁᤢᤛᤖᤧ ᤛᤠᤵᤋᤢᤒᤠ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤛᤢᤏᤠᤀᤡᤱ","order":41,"numberOfChapters":16,"sha256":"b2060868822844e783adc1c46e31426b08db82e9e63c16700ae81ee716def694","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/lif_wbt/MRK/16.json","totalNumberOfVerses":661},"chapter":{"number":1,"content":[{"type":"heading","content":["ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤁᤧᤒᤡᤒᤠ ᤕᤢᤜᤢᤴᤏ:ᤸᤗᤧ ᤆᤥᤃᤢᤒᤠ ᤀᤡᤱᤓᤴ"]},{"type":"verse","number":1,"content":["ᤁᤱᤃ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠ᤺",{"noteId":0},"ᤕᤧᤛᤢ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤁᤢᤛᤢᤏᤠᤀᤡᤱᤅᤡᤸᤗᤧ ᤁᤢᤜᤣ᤺ᤰᤛᤡᤱᤔᤠᤖᤥ॥"]},{"type":"verse","number":2,"content":["ᤔᤠᤱᤏᤡᤱᤘᤠ᤹ᤐᤠ᤺ᤴ ᤁᤧᤒᤠ᤺ᤵᤐᤠ ᤕᤛᤤᤕᤠ᤺ᤸᤗᤧ ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤛᤠᤵᤋᤢᤀᤠᤱ ᤐᤳ.",{"noteId":1},{"text":"“ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤐᤠ᤺ᤳᤋᤢ.","poem":1},{"lineBreak":true},{"text":"‘ᤂᤧᤏᤧ᤹ ᤁᤧᤗᤠᤶᤔᤡᤴ ᤕᤠᤖᤡᤵ ᤆᤥᤃᤢᤖ ᤑᤠ᤹ᤀᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤀᤠᤀᤡᤱᤛᤠᤒᤧᤴ ᤁᤧᤍᤃᤡ ᤐᤠᤱᤄᤢᤱ ᤕᤢ᤺ᤛᤢᤱᤗᤥ॥’","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ᤂᤢᤏᤧ᤹ ᤀᤣ᤺ᤰᤛᤠᤍᤧᤴᤏᤥ ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤁᤧᤀ᤺ᤰᤐᤠ ᤀᤡᤰᤗᤠᤖᤥ.","poem":1},{"lineBreak":true},{"text":"‘ᤍᤠᤱᤒᤠᤸᤗᤧ ᤁᤢᤔᤠᤖᤠᤶᤔᤡᤴ ᤕᤠᤖᤡᤵ ᤆᤥᤃᤧᤶᤔᤧ᤹ᤀᤠᤱ ᤁᤢᤗᤠᤶᤜᤠ᤹ ᤋᤥ᤺ᤴᤍᤥ᤺ᤴ ᤆᤥᤃᤧᤶᤔᤧ᤹᥄’”","poem":1},{"noteId":2}]},{"type":"verse","number":4,"content":["ᤔᤠᤱᤏᤡᤱᤘᤠ᤹ᤐᤠ᤺ᤴ ᤁᤧᤒᤠ᤺ᤵᤐᤠ ᤕᤛᤤᤕᤠ᤺ᤸᤗᤧ ᤛᤠᤵᤋᤢᤒᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤁᤧᤒᤡᤒᤠ ᤕᤢᤜᤢᤴᤏᤠ᤺ᤴ ᤀᤣ᤺ᤰᤛᤠᤍᤧᤴᤏᤥ ᤋᤩᤧᤀᤠᤱ ᤗᤠᤕᤥᤗᤠᤶ ᤜᤡᤴᤍᤧᤶᤔᤧ᤹ᤀᤠᤱ ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤐᤥ᤺ᤰᤂᤧᤶᤔᤧ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤂᤡᤏᤡ᤹ ᤗᤠᤕᤥ᤺ᤴ ᤗᤧᤵᤔᤡ ᤁᤧᤒᤡᤖᤡ᤹ ᤗ᤹ᤖᤡᤰ ᤀᤡᤱᤓᤴ ᤆᤥᤃᤢᤖᤥ॥"]},{"type":"verse","number":5,"content":["ᤕᤜᤢᤍᤡᤕᤠ ᤌᤢᤶ ᤏᤢ ᤕᤖᤢᤛᤗᤧᤔ ᤕᤧᤰᤕᤰᤗᤠᤶ ᤕᤖᤡᤰ ᤔᤏᤠᤜᤠ᤹ ᤂᤢᤏᤧ᤹ᤀᤥ ᤔᤧᤍᤩᤧᤀᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤗᤠᤕᤥᤒᤠᤀᤠᤖᤥ ᤔᤧᤒᤠ᤺ᤳᤋᤢᤖ ᤕᤷᤍᤏ ᤕᤱᤄᤱᤅᤥ ᤂᤢᤏᤧ᤹ᤗᤠᤶ ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤔᤧᤒᤥ᤺ᤰᤂᤧᤖᤥ॥"]},{"type":"verse","number":6,"content":["ᤀᤠᤸᤗ ᤕᤢᤜᤢᤴᤏᤠ᤺ᤱᤃ ᤀᤢᤔᤧ᤺ᤸᤗᤧ ᤁᤢᤔᤢᤖᤡᤰᤗᤠᤶ ᤌᤠᤰᤔᤏᤠᤒᤠ ᤋᤣ᤺ᤳ ᤁᤧᤈᤠᤱᤒᤠ ᤏᤢ ᤛᤧᤜᤥᤒᤠ ᤑ᤹ᤀᤡ ᤁᤧᤕᤢᤶᤒᤠ ᤆᤥᤃᤧ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ᤃ ᤏᤡ᤺ᤱᤄᤢ᤺ᤰᤘᤠ ᤏᤢ ᤋᤠᤶᤓᤢᤱ ᤛᤰᤘᤠᤄᤢ ᤁᤧᤈᤠᤒᤠ ᤘᤕᤧᤖᤥ॥"]},{"type":"verse","number":7,"content":["ᤕᤢᤜᤢᤴᤏᤠ᤺ᤸᤗᤧ ᤀᤰᤂᤣ ᤐᤠ᤺ᤳᤋᤢᤖ ᤀᤡᤱᤓᤥ᤺ᤛᤢ. “ᤀᤡᤱᤃᤠ᤹ ᤀᤠᤀᤣᤃᤠᤱ ᤀᤡᤱᤃᤠ᤹ᤏᤢ᤺ᤸᤗᤧᤀᤠᤱ ᤔᤢᤰᤛᤠᤶᤛᤠᤒᤠᤴ ᤋᤠ᤺ᤖᤥ॥ ᤀᤡᤱᤃᤠ᤹ᤃ ᤕᤥ᤺ᤰ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤁᤢᤗᤠᤱᤛᤢ᤺ᤵ ᤏᤠᤶᤜᤠ᤹ ᤑᤠ᤺ᤱᤔᤠᤀᤠᤱ ᤔᤧᤗᤠ᤹ᤀᤠᤴᤗᤥ॥"]},{"type":"verse","number":8,"content":["ᤀᤡᤱᤃᤠ᤹ᤃ ᤂᤡᤏᤡ᤹ ᤆᤫᤠ᤺ᤳᤋᤡᤸᤗᤧ ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤐᤡᤏᤡᤱᤗ ᤐᤳᤋᤠ. ᤁᤖ ᤂᤢᤏᤧ᤹ᤃ ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤸᤗᤧ ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤁᤧᤒᤡᤖᤡ᤹ᤖᤥ॥”"]},{"type":"heading","content":["ᤕᤧᤛᤢ᤺ᤴ ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤐᤥ᤺ᤰᤂᤧᤀᤠᤱ ᤔᤠᤑᤧᤴᤛᤠᤶᤔᤡᤸᤗᤧ ᤁᤢᤏᤡᤱᤘᤠ᤹ ᤛᤠ᤹ᤖᤢ"]},{"type":"verse","number":9,"content":["ᤂᤧᤴ ᤕᤧᤶᤔᤥ ᤕᤧᤛᤢ᤺ᤴ ᤃᤠᤗᤡᤗ ᤌᤢᤶᤔᤥᤒᤠ ᤏᤠᤛᤖᤋᤗᤠᤶ ᤋᤩᤧᤀᤠᤱ ᤕᤢᤜᤢᤴᤏᤠᤗᤠᤶ ᤕᤷᤍᤏ ᤕᤱᤄᤱᤅᤥ ᤒᤵᤋᤡᤛ᤻ᤔᤠ ᤐᤥ᤺ᤰᤂᤧ॥"]},{"type":"verse","number":10,"content":["ᤂᤢᤏᤧ᤹ ᤆᤫᤠ᤺ᤳᤋᤥᤗᤠᤶ ᤗ᤺ᤴᤍᤧᤏᤢᤔᤧ᤺ᤴᤏᤣ ᤋᤠᤱᤛᤠᤰᤐᤧᤴ ᤜᤖᤧᤀᤠᤱ ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤴ ᤐᤢᤳᤋᤢ᤺ᤰᤁᤣ ᤜᤧᤰᤁᤣ ᤂᤢᤏᤧ᤹ ᤁᤢᤛᤶᤍᤠᤱ ᤕᤧ᤺ᤖ ᤐᤳᤇᤧᤒᤠ ᤏᤡ᤺ᤛᤢᤖᤥ॥"]},{"type":"verse","number":11,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱᤗᤠᤶ ᤀᤡᤰᤗᤠᤎᤡᤰ ᤋᤩᤧ. “ᤂᤧᤏᤧ᤹ ᤀᤠᤔᤡ᤺ᤶ ᤀᤠᤛ᤻ᤛᤠ᤺ᤏᤧᤖᤥ. ᤂᤧᤏᤧ᤹ᤏᤢ ᤀᤡᤱᤃᤠ᤹ ᤛᤠ᤹ᤖᤡᤰ ᤛ᤺ᤳᤋᤠᤱᤅᤠᤱ ᤘᤠ᤹ᤀᤠᤖᤥ॥”"]},{"type":"verse","number":12,"content":["ᤂᤡᤔᤥ ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤸᤗᤧ ᤂᤢᤏᤧ᤹ ᤀᤣ᤺ᤰᤛᤠᤍᤧᤴᤏᤥ ᤐᤣ᤺ᤰᤔᤠᤀᤣ ᤐᤥ᤺ᤱ ᤑᤠ᤹ᤀᤠᤱ ᤋᤣ᤹ᤖᤢ॥"]},{"type":"verse","number":13,"content":["ᤂᤢᤏᤧ᤹ ᤂᤧᤵᤔᤥ ᤗᤡᤒᤥ᤺ᤱ (᥊᥆) ᤕᤧᤴ ᤌᤠᤖᤡᤰ ᤘᤕᤧᤸᤗᤧ ᤔᤠᤑᤧᤴᤛᤠᤶ ᤛᤤᤋᤠᤏᤡᤸᤗᤧ ᤂᤢᤏᤧ᤹ ᤑᤧᤴ ᤕᤠ᤺ᤶᤒᤰ ᤆᤥ᤺ᤰᤐᤠᤱᤔᤠ ᤑᤠ᤹ᤀᤠᤱ ᤁᤢᤏᤡᤱᤘᤠ᤹ ᤛᤠ᤹ᤖᤢ॥ ᤂᤧᤵᤔᤥ ᤂᤢᤏᤧ᤹ ᤋᤠᤶᤓᤢᤱᤌᤰᤛᤠᤜᤠ᤹ᤏᤢ ᤘᤕᤧ. ᤜᤧᤰᤁᤩᤠᤱ ᤔᤠᤱᤗᤠᤀᤡᤱᤒᤠᤜᤠ᤹ᤖᤧ",{"noteId":3},"ᤂᤢᤏᤧ᤹ ᤁᤶᤒᤪᤠᤱ ᤔᤧᤔᤧᤳᤋᤢᤖᤥ॥"]},{"type":"heading","content":["ᤕᤧᤛᤢᤖᤧ ᤜᤢ᤹ᤛᤠᤶᤒᤠᤜᤠ᤹ ᤛᤣᤃᤢᤛᤡ᤹"]},{"type":"verse","number":14,"content":["ᤀᤠᤸᤗ ᤕᤢᤜᤢᤴᤏᤠ᤺ᤴ ᤐᤢᤱᤗᤠᤜᤡᤶᤔᤥ ᤔᤧᤛᤠᤰᤋᤢᤀᤠᤱ ᤕᤠᤃᤧᤸᤗᤧ ᤕᤧᤛᤢ᤺ᤴ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤛᤢᤏᤠᤀᤡᤱᤅᤡᤴ ᤀᤡᤱᤓᤴ ᤛᤧ᤺ᤛᤢᤖ ᤃᤠᤗᤡᤗ ᤌᤢᤶᤔᤥ ᤋᤩᤧᤖᤥ॥"]},{"type":"verse","number":15,"content":["ᤂᤢᤏᤧ᤹ ᤀᤰᤂᤣ ᤐᤠ᤺ᤳᤋᤢᤖ ᤀᤡᤱᤓᤴ ᤛᤧ᤺ᤛᤢ. “ᤁᤴ ᤛᤢᤕᤧᤶᤔᤡᤴ ᤋᤩᤧᤀᤠᤱ ᤘᤠ᤹. ᤏᤡᤱᤘᤠ᤹ᤑᤢᤜᤠᤱᤈᤢᤶᤔᤡᤴ ᤏᤡ᤺ᤳᤋᤠᤱᤅᤣ ᤘᤠ᤹ᤖᤥ. ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤂᤡᤏᤡ᤹ ᤗᤠᤕᤥᤗᤠᤶ ᤜᤡᤴᤍᤧᤶᤔᤧ᤹ᤀᤠᤱ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤛᤢᤏᤠᤀᤡᤱᤅᤡᤴ ᤏᤛᤠ᤺ᤴ ᤆᤥᤃᤧᤶᤔᤧ᤹ᤀᤥ॥”"]},{"type":"verse","