content":["ᤁᤖ ᤕᤧᤛᤢᤖᤧ ᤌᤣᤀᤠᤱ ᤏᤥᤃᤵ ᤔᤧᤶᤒᤡᤛᤡᤱᤅᤣ ᤛᤫᤠ᤺ᤳ ᤕᤧᤒᤧ॥ ᤕᤠᤶᤔᤥ ᤔᤠᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤒᤠᤸᤗᤧ ᤛᤣ᤺ᤴᤍᤥᤛᤢ. “ᤂᤧᤏᤧ᤹ ᤔᤢ᤹ᤀᤡᤛᤠᤶᤍᤠᤱᤒᤠ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠ᤺ ᤂᤪᤡᤛ᤻ᤋᤏᤧᤒᤡ᥅”"]},{"type":"verse","number":62,"content":["ᤕᤧᤛᤢᤖᤧ ᤂᤧᤱᤜᤠ᤹ ᤔᤧᤳᤋᤢᤛᤡ. “ᤀᤥᤖᤥ. ᤀᤡᤱᤃᤠ᤹ᤀᤠᤖᤥ᥄ ᤁᤖ ᤀᤡᤱᤃᤠ᤹ ᤔᤧᤳᤏᤡᤱ. ᤀᤡᤱᤃᤠ᤹ ᤔᤧᤴᤇᤠᤶᤛᤠ᤺ᤴ ᤔᤢᤰᤛᤠᤶᤍᤠᤱᤒᤠ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤈᤢᤵᤛᤠᤱ ᤗᤧᤵᤔᤠᤱ ᤕᤢᤱᤅᤠᤒᤠ ᤏᤢ ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱᤅᤥᤏᤢ ᤂᤠᤵᤔᤡ᤺ᤳᤋᤥ ᤕᤢ᤺ᤀᤠᤒᤠ ᤁᤧᤏᤡ᤺ᤛᤢᤶᤗᤥ॥”"]},{"type":"verse","number":63,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤔᤠᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤒᤠᤸᤗᤧ ᤁᤢᤛᤠᤰᤁᤧᤴ ᤀᤥᤛᤣ᤺ᤴᤎᤠᤰᤋᤢᤛᤡᤖ ᤀᤠᤒᤠᤅᤣ ᤁᤢᤍᤣ᤺ᤳᤋᤡᤴ ᤌᤧ᤺ᤰᤂᤢᤀᤠᤱ ᤀᤰᤂᤣ ᤐᤠ᤺ᤳᤋᤢ. “ᤀᤠᤸᤗ ᤀᤠᤏᤡ᤹ ᤘᤣ᤹ ᤋᤥ᤺ᤴᤍᤡᤜᤠ᤹ ᤌᤣᤀᤠᤱ ᤆᤠᤜᤠᤒᤠ ᤀᤠᤈᤥᤃᤧᤒᤣ᥅"]},{"type":"verse","number":64,"content":["ᤁᤸᤗᤧᤃ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤍᤰᤗᤧᤱᤘᤠᤀᤥ ᤔᤠᤱᤆᤧ᤹ᤕᤠ ᤐᤠ᤺ᤴ ᤐᤠ᤺ᤳᤋᤢᤒᤠᤴ ᤂᤡᤏᤡ᤹ ᤁᤧᤄᤧᤵᤛᤢᤶᤗᤥ॥ ᤀᤠᤸᤗ ᤌᤧᤔᤠ ᤁᤧᤀᤡ᤺ᤳᤋᤢᤶᤒᤣ᥅” ᤂᤧᤵᤔᤥ ᤁᤧᤘᤠ᤹ᤒᤠ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤧ᤹ ᤛᤡ᤺ᤔᤧᤸᤗᤧ ᤂᤢᤶᤍᤡᤱ ᤂᤥ᤺ᤔᤠᤀᤣ ᤐᤥ᤺ᤱ ᤑᤠ᤹ᤀᤠᤱ ᤔᤧᤔᤧᤳᤋᤢ॥"]},{"type":"verse","number":65,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤁᤢᤓᤠᤖᤧ ᤂᤢᤏᤧ᤹ ᤌᤩᤠ᤺ᤳ ᤔᤧᤎᤥ᤺ᤰᤂᤢᤀᤠᤱ ᤁᤢᤓᤠᤖᤧ ᤁᤢᤔᤡᤰᤁᤧᤴ ᤔᤧᤍᤧᤵᤋᤢᤀᤠᤱ ᤂᤢᤏᤡ᤹ ᤜᤢᤰᤐᤢᤳᤋᤡᤸᤗᤧ ᤔᤧᤗᤰᤋᤢᤖ “ᤔᤠᤱᤏᤡᤱᤘᤠ᤹ᤐᤠ᤺ᤴ ᤐᤠᤖᤧ᤹. ᤜᤠ᤺ᤳᤗᤧ ᤁᤧᤜᤡᤵᤋᤧᤒᤣ᥅” ᤔᤧᤔᤧᤳᤋᤢ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ ᤁᤧᤃᤥ᤺ᤒᤠ ᤌᤰᤛᤢᤒᤠᤜᤠ᤹ᤖᤧ ᤔᤧᤍᤣ᤹ᤖᤢᤀᤠᤱ ᤔᤧᤜᤡᤵᤋᤢᤖᤥ॥"]},{"type":"heading","content":["ᤐᤋᤪᤢᤛᤖᤧ ᤕᤧᤛᤢ᤺ᤴ ᤏᤠ᤹ᤖᤢ᤹"]},{"type":"verse","number":66,"content":["ᤐᤋᤪᤢᤛᤧᤴ ᤕᤥ ᤗᤰᤂᤢᤶᤔᤥ ᤘᤕᤧᤸᤗᤧ ᤔᤠᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤒᤠᤸᤗᤧ ᤁᤢᤛᤣᤘᤠᤖᤥᤔᤠ ᤆᤢᤰᤔᤠᤎᤡᤰ ᤂᤧᤵᤔᤥ ᤋᤩᤧᤀᤠᤱ"]},{"type":"verse","number":67,"content":["ᤐᤋᤪᤢᤛᤧᤴ ᤔᤡᤈᤠ᤹ᤏᤢ ᤕᤢᤅᤧᤒᤠ ᤏᤡ᤺ᤛᤢᤀᤠᤱ ᤁᤢᤒᤣᤛᤠᤱ ᤐᤣᤀᤠᤱ ᤏᤢ᤺ᤖᤡᤰ ᤀᤥᤔᤧᤳᤋᤢᤖ ᤔᤧᤳᤋᤢ. “ᤂᤧᤏᤧ᤹ᤃ ᤏᤠᤛᤖᤡ ᤕᤧᤛᤢ᤺ᤴᤏᤢ ᤁᤧᤘᤕᤧ ᤔᤧ᤺ᤶᤒᤡ᥅”"]},{"type":"verse","number":68,"content":["ᤁᤖ ᤐᤋᤪᤢᤛᤖᤧ ᤂᤧᤴ ᤏᤠ᤹ᤖᤢᤖ ᤔᤧᤳᤋᤢ. “ᤀᤡᤱᤃᤠ᤹ ᤂᤢᤏᤧ᤹ ᤁᤢᤛᤡᤱ ᤔᤧᤏᤡ᤺ᤳᤋᤢᤱᤅᤡᤴᤗᤥ᥄ ᤂᤧᤏᤧ᤹ ᤌᤣ ᤁᤧᤒᤠ᤺ᤳᤋᤢᤒᤠ ᤀᤡ᥅” ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ ᤗᤠ᤺ᤰᤁᤠᤳ ᤐᤣ᤺ᤰᤔᤠ ᤗᤠᤶᤎᤣ᤺ᤵ ᤗᤧᤵᤔᤠᤱ ᤆᤳᤇᤡᤱ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤒᤠ ᤂᤧᤴ ᤕᤧᤶᤔᤥ ᤀᤡᤱᤘᤠ ᤁᤠ᤺ᤛᤧ॥"]},{"type":"verse","number":69,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤴ ᤛᤣᤘᤠᤖᤥᤔᤠ ᤆᤢᤰᤔᤧᤴ ᤕᤠᤶᤔᤥ ᤋᤩᤧᤀᤠᤱ ᤂᤧᤵᤔᤥ ᤐᤋᤪᤢᤛᤧᤴ ᤏᤡ᤺ᤛᤢᤀᤠᤱ ᤁᤢᤄᤡᤖᤡ ᤁᤧᤕᤧᤵᤐᤠ ᤔᤏᤠᤜᤠ᤹ ᤔᤧᤳᤋᤢᤛᤡ. “ᤁᤴ ᤔᤏᤠ᤺ᤱᤃ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤜᤢ᤹ᤛᤠᤶᤒᤠᤜᤠ᤹ᤀᤥ ᤌᤡᤰᤗᤥ॥”"]},{"type":"verse","number":70,"content":["ᤁᤖ ᤐᤋᤪᤢᤛᤖᤧ ᤕᤠᤶᤔᤥ ᤏᤠ᤹ᤖᤢ॥ ᤕᤠᤱᤛᤡ ᤂᤧᤵᤔᤥ ᤁᤧᤘᤠ᤹ᤒᤠ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤧ᤹ ᤔᤧᤏᤡ᤺ᤛᤢᤀᤠᤱ ᤔᤧᤔᤧᤳᤋᤢ. “ᤛᤧᤰᤂᤠᤛᤠᤱ ᤂᤧᤱᤜᤠ᤹ᤀᤥ ᤂᤧᤏᤧ᤹ ᤌᤡᤰᤏᤧᤖᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤧᤏᤧ᤹ᤀᤠᤱ ᤃᤠᤗᤡᤗᤗᤠᤶ ᤁᤧᤍᤩᤧᤒᤠᤖᤥ॥”"]},{"type":"verse","number":71,"content":["ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤐᤋᤪᤢᤛᤖᤧ ᤔᤠᤱᤜᤧᤰᤛᤡᤱᤗ ᤀᤰᤂᤣ ᤔᤧᤳᤋᤢᤛᤡ. “ᤁᤴ ᤔᤏᤠ᤺ᤴ ᤜᤠ᤺ᤳ ᤀᤡ ᤑᤠ᤹ᤀᤠᤱ ᤔᤧᤏᤡ᤺ᤛᤢᤱᤅᤡᤴᤗᤥ᥄ ᤂᤡᤏᤡ᤹ ᤌᤧᤔᤠ ᤁᤧᤒᤠ᤺ᤳᤋᤢᤶᤒᤠ ᤀᤡ᥅”"]},{"type":"verse","number":72,"content":["ᤂᤡᤔᤥ ᤀᤡᤱᤘᤠ᤺ᤴ ᤏᤡᤛᤡᤃᤣ᤺ᤰ ᤗᤧᤱ ᤁᤠ᤺ᤛᤧᤖᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤐᤋᤪᤢᤛᤖᤧ “ᤏᤡᤗᤧᤱ ᤀᤡᤱᤘᤠ ᤁᤠ᤺ᤔᤠᤏᤢ᤺ᤸᤗᤧ ᤋᤃᤡ ᤂᤧᤏᤧ᤹ ᤛᤢᤶᤗᤧᤱ ᤁᤧᤏᤠ᤹ᤀᤠᤖᤥ” ᤑᤠ᤹ᤀᤠᤱ ᤕᤧᤛᤢᤖᤧ ᤔᤧᤳᤋᤢᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤏᤡᤱᤘᤠ᤹ ᤀᤡ᤺ᤳᤋᤢᤀᤠᤱ ᤛᤠ᤹ᤖᤡᤰ ᤜᤠᤒᤧᤖᤥ॥"]}],"footnotes":[{"noteId":33,"caller":"*","text":"ᤕᤜᤢᤍᤡ ᤆᤥ᤺ᤰᤕᤢᤶᤓᤥ ᤋᤱᤏᤠᤶ–ᤐᤧᤴᤏᤡᤒᤠ᤺ᤴᤏᤥ ᤁᤴ ᤋᤱᤏᤠᤶ “ᤏᤡᤛ᤻ᤋᤠᤖ” ᤔᤧᤵᤔᤏᤠᤒᤠᤖᤥ॥ ᤁᤴ ᤋᤱᤏᤠᤶᤔᤡᤴ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤔᤡᤛᤪ ᤗᤠᤈᤣ᤹ᤗᤠᤶ ᤀᤡᤛᤪᤠᤀᤡᤗᤡᤜᤠ᤹ ᤗ᤺ᤳᤋᤢᤛᤡᤒᤠ ᤔᤡᤱᤛᤥᤀᤥ ᤔᤧᤀᤡ᤺ᤳᤋᤢᤒᤠ ᤋᤱᤏᤠᤶᤗᤥ॥","reference":{"chapter":14,"verse":1}},{"noteId":34,"caller":"*","text":"ᤗᤥᤃᤣ᤹–ᤂᤧᤴ ᤑᤠ᤹ᤀᤡᤴ ᤂᤢᤏᤧ᤹ ᤐᤠᤖᤠᤔ ᤛᤠᤶᤔᤠᤱᤅᤡᤸᤗᤧ ᤕᤠᤱᤄᤢᤒᤠ ᤔᤏᤠ ᤘᤕᤧ॥","reference":{"chapter":14,"verse":3}},{"noteId":35,"caller":"*","text":"ᤁᤡᤵ ᤛᤢᤶᤛᤡ ᤕᤢᤵᤐᤠᤕᤠᤱ–ᤃᤪᤡᤁ ᤐᤠ᤺ᤴᤍᤠᤱᤅᤥ “ᤍᤡᤏᤠᤖ”॥ ᤁᤴ ᤑᤠ᤹ᤀᤡᤴ ᤌᤡᤰ ᤔᤏᤠ᤺ᤸᤗᤧ ᤋᤱᤒᤣᤎᤡᤰᤗᤧ ᤁᤢᤏᤠᤶᤕᤠᤰᤗᤥ॥","reference":{"chapter":14,"verse":5}},{"noteId":36,"caller":"*","text":"ᤈᤁᤖᤡᤕᤠ ᥇᥉.᥍","reference":{"chapter":14,"verse":27}}]},"thisChapterLink":"/api/lif_wbt/MRK/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lif_wbt/MRK/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lif_wbt/MRK/13.json","previousChapterAudioLinks":{},"numberOfVerses":71}