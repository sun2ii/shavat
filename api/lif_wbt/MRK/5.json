ntent":["ᤂᤧᤸᤗᤧ ᤕᤶᤒᤠ ᤀᤡᤰᤗᤠᤀᤥ ᤀ᤺ᤰᤋᤧᤖ ᤕᤧᤛᤢ᤺ᤴ ᤔᤧᤳᤋᤢ. “ᤁᤧᤖᤧᤰᤏᤢ᤺ᤸᤗᤧ ᤐᤕᤶ ᤕᤶᤒᤠ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤛ᤻ᤛᤠ᤺ ᤕᤧᤛᤢᤀᤣ. ᤂᤧᤏᤧ᤹ ᤀᤡᤱᤃᤠ᤹ᤏᤢ ᤌᤣ ᤁᤧᤃᤥ᤺ᤳᤋᤢᤒᤠᤒᤣ᥅ ᤀᤡᤱᤃᤠ᤹ ᤋᤢᤰᤂᤣ ᤔᤧᤈᤠ᤺ᤳᤋᤠᤱᤅᤡᤴᤏᤧ᤹ ᤑᤠ᤹ᤀᤠᤱ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤔᤡᤱᤅᤥ ᤐᤣᤗᤡ ᤑᤠᤰᤏᤧ᤹ᤖᤥ॥”"]},{"type":"verse","number":8,"content":["(ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤋᤃᤡ ᤕᤧᤛᤢᤖᤧ ᤂᤧᤴ ᤑᤧᤴᤛᤠᤶᤔᤡᤴ ᤂᤧᤏᤧ᤹ ᤂᤧᤴ ᤔᤏᤠᤀᤥᤗᤠᤶ ᤗᤠ᤺ᤰᤁᤠᤳ ᤗ᤺ᤴᤍᤧ ᤐᤣᤃᤧ᤹ ᤑᤠ᤹ᤀᤠᤱ ᤔᤧᤳᤋᤢᤀᤠᤱ ᤘᤕᤧᤖᤥ॥)"]},{"type":"verse","number":9,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤕᤧᤛᤢᤖᤧ ᤂᤧᤴ ᤛᤣ᤺ᤴᤍᤥᤛᤢ. “ᤁᤧᤔᤡᤱ ᤌᤧᤔᤠᤒᤣ᥅” ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤸᤗᤧ ᤏᤥᤃᤵ ᤐᤡᤖᤢ. “ᤀᤡᤱᤃᤠ᤹ ᤀᤠᤔᤡᤱ ᤋᤢᤖᤠᤖᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤁᤴ ᤔᤏᤠᤀᤥ ᤀᤠᤏᤡᤃᤧ ᤕᤖᤡᤰ ᤕᤠᤃᤡᤃᤧ॥”"]},{"type":"verse","number":10,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤸᤗᤧ ᤕᤧᤛᤢ᤺ᤴ ᤐᤣᤗᤡ ᤑᤠᤰᤋᤢ. “ᤁᤴ ᤌᤢᤶᤔᤥᤗᤠᤶ ᤀᤠᤏᤡᤃᤧ ᤀᤠᤶᤒᤠᤱᤄᤧᤴᤏᤧ᤹ᤀᤥ॥”"]},{"type":"verse","number":11,"content":["ᤀᤠᤸᤗ ᤂᤧᤴ ᤁᤥ᤺ᤰᤔᤠᤀᤥ ᤕᤖᤡᤰ ᤑᤠᤰᤜᤠ᤹ ᤆᤠᤔᤧᤖᤠᤔᤧᤖ ᤔᤧᤕᤧᤒᤧ॥"]},{"type":"verse","number":12,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤴ ᤑᤧᤴᤛᤠᤶᤜᤠ᤹ᤖᤧ ᤕᤧᤛᤢ᤺ᤴ ᤐᤣᤗᤡ ᤔᤧᤓᤠᤰᤋᤢ. “ᤀᤠᤏᤡᤃᤧ ᤂᤧᤴ ᤑᤠᤰᤜᤠ᤹ᤀᤥ ᤗᤠ᤺ᤵᤔᤠ ᤀᤠᤒᤠᤱᤄᤧ᤹ᤀᤥ॥ ᤀᤠᤏᤡᤃᤧ ᤂᤧᤱᤜᤠ᤹ᤀᤥ ᤗᤠ᤺ᤛᤡᤃᤧ᤹॥”"]},{"type":"verse","number":13,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤕᤧᤛᤢᤖᤧᤀᤠᤱ ᤂᤧᤱᤜᤠ᤹ ᤗᤠ᤺ᤵᤔᤠ ᤐᤠᤱᤄᤢᤛᤡᤀᤠᤱ ᤑᤧᤴᤛᤠᤶᤜᤠ᤹ ᤂᤧᤴ ᤔᤏᤠᤀᤥᤗᤠᤶ ᤔᤧᤗ᤺ᤴᤍᤧ ᤔᤧᤒᤣᤀᤠᤱ ᤑᤠᤰᤜᤠ᤹ᤀᤥ ᤔᤧᤗᤠ᤺ᤛᤧ॥ ᤂᤧᤴ ᤜᤧᤴᤇᤡᤱ ᤏᤧᤳᤇᤡ ᤕᤠᤖᤡᤰ ᤑᤠᤰᤜᤠ᤹ ᤛᤱᤔᤠᤱᤅᤣ ᤛᤱᤔᤠᤱ ᤔᤧᤗᤥ᤺ᤰᤋᤧᤖ ᤕᤠᤰᤐᤧᤀᤥᤏᤢ ᤔᤰᤔᤧᤎᤩᤧᤀᤠᤱ ᤘᤖᤰᤁᤥ ᤔᤧᤜᤢᤔᤧ ᤔᤧᤛᤩᤧᤖᤥ॥"]},{"type":"verse","number":14,"content":["ᤂᤧᤵᤔᤥ ᤑᤠᤰ ᤁᤧᤃᤶᤒᤠᤜᤠ᤹ᤀᤠᤱ ᤔᤧᤘᤕᤧ॥ ᤂᤧᤱᤜᤠ᤹ ᤔᤧᤗᤥ᤺ᤰᤋᤧᤖ ᤔᤧᤒᤣᤀᤠᤱ ᤐᤠᤱᤈᤢᤶᤔᤥ ᤏᤢ ᤂᤧᤴ ᤂᤡᤖᤡᤒᤠ ᤐᤠᤱᤓᤣ᤹ᤜᤠ᤹ᤀᤥ ᤁᤴ ᤐᤠ᤺ᤴᤏᤡᤴ ᤔᤧᤛᤧ᤺ᤛᤢ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤔᤏᤠᤜᤠ᤹ ᤌᤣ᤺ᤴᤏᤧ ᤐᤥ᤺ᤰᤂᤧᤒᤣ ᤑᤠ᤹ᤀᤠᤱ ᤀᤥᤔᤧᤳᤇᤧ"]},{"type":"verse","number":15,"content":["ᤕᤧᤛᤢ᤺ᤴ ᤘᤕᤧᤒᤠ ᤋᤧᤴᤏᤥ ᤔᤧᤍᤩᤧᤖᤥ॥ ᤂᤧᤵᤔᤥ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤋᤃᤡ ᤑᤧᤴᤛᤠᤶᤔᤡᤸᤗᤧ ᤕᤠᤱᤄᤢᤒᤠ ᤔᤏᤠ᤺ᤴ ᤘᤣ᤺ᤳᤋᤧᤀᤠᤱ ᤏᤢ᤺ᤖᤡᤰᤁᤠᤱ ᤋᤣ᤺ᤳ ᤆᤠᤰᤂᤢᤀᤠᤱ ᤕᤢᤅᤧᤒᤠ ᤔᤧᤏᤡ᤺ᤛᤢ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤴ ᤔᤏᤠ᤺ᤴ ᤏᤢ ᤑᤠᤰᤜᤠ᤹ ᤌᤣ ᤔᤧᤒᤥ᤺ᤰᤂᤧ ᤑᤠ᤹ᤀᤠᤱ ᤁᤧᤏᤡ᤺ᤒᤠ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤔᤧᤈᤧᤰᤋᤢᤛᤡ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤱᤜᤠ᤹ ᤛᤠ᤹ᤖᤡᤰ ᤔᤧᤃᤡᤛᤧ॥"]},{"type":"verse","number":17,"content":["ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤕᤧᤛᤢ᤺ᤴ ᤀᤠᤏᤡᤃᤧ ᤌᤢᤶᤔᤥᤗᤠᤶ ᤗ᤺ᤴᤍᤧ ᤐᤣᤃᤧ᤹ ᤑᤠ᤹ᤀᤠᤱ ᤐᤣᤗᤡ ᤔᤧᤓᤠᤰᤋᤢᤖᤥ॥"]},{"type":"verse","number":18,"content":["ᤕᤧᤛᤢ᤺ᤴ ᤂ᤺ᤱᤒᤣᤀᤥ ᤗᤠ᤺ᤛᤧᤖ ᤐᤳᤇᤧᤸᤗᤧ ᤋᤃᤡ ᤑᤧᤴᤛᤠᤶᤔᤡᤸᤗᤧ ᤕᤠᤱᤄᤢᤒᤠ ᤔᤏᤠ᤺ᤴ ᤕᤧᤛᤢᤖᤧ ᤁᤢᤒᤣᤛᤠᤱ ᤋᤩᤧᤀᤠᤱ. ᤀᤠᤍᤠᤱᤒᤣ. ᤀᤡᤱᤃᤠ᤹ᤀᤠᤱ ᤂᤧᤏᤧ᤹ᤏᤢᤀᤣ ᤋᤣ᤹ᤖᤠᤱᤅᤧ᤹ᤀᤥ ᤑᤠ᤹ᤀᤠᤱ ᤐᤣᤗᤡ ᤑᤠᤰᤋᤢ॥"]},{"type":"verse","number":19,"content":["ᤁᤖ ᤕᤧᤛᤢᤖᤧ ᤔᤧᤍᤧᤴᤍᤧᤴᤗ ᤀᤰᤂᤣ ᤔᤧᤳᤋᤢ. “ᤂᤧᤏᤧ᤹ ᤏᤢ᤺ᤰᤂᤧ ᤐᤣᤃᤧ᤹ᤀ