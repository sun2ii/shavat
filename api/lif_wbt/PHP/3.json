{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"PHP","translationId":"lif_wbt","name":"ᤑᤡᤗᤡᤵᤐᤡ","commonName":"ᤑᤡᤗᤡᤵᤐᤡ","title":"ᤐᤠᤘᤗᤖᤧ ᤑᤡᤗᤡᤵᤐᤡᤜᤠ᤹ ᤜᤠᤰᤋᤢᤛᤡᤒᤠ ᤛᤰᤀᤡᤱᤄᤱ","order":50,"numberOfChapters":4,"sha256":"4be006928f1af52ecf82794381bd059eaa4ff4d5fffb3e3b7d8dc2dc0c80ad0f","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/PHP/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/lif_wbt/PHP/4.json","totalNumberOfVerses":104},"chapter":{"number":3,"content":[{"type":"heading","content":["ᤁᤠᤰᤏᤢ᤺ᤸᤗᤧ ᤁᤧᤕᤧᤰᤐᤠ ᤂᤪᤡᤛ᤻ᤋ"]},{"type":"verse","number":1,"content":["ᤀᤠᤸᤗ ᤁᤢᤏᤢᤵᤔᤥ. ᤀᤠᤔᤡ᤺ᤶ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤛᤣ. ᤍᤠᤱᤒᤠᤀᤥ ᤛ᤺ᤳᤋᤧᤶᤔᤧ᤹ᤀᤥ॥ ᤕᤠᤶᤔᤥ ᤒᤠ ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤗᤳᤇᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤛᤠᤵᤔᤠᤖ ᤏᤧᤔᤠᤃ ᤀᤠᤗᤠᤃᤡ ᤌᤣᤀᤠᤱ ᤋᤢᤰᤂᤣ ᤔᤧᤒᤥ᤺ᤱᤏᤧᤴ. ᤜᤧᤰᤁᤩᤠᤱ ᤁᤸᤗᤧᤃ ᤂᤡᤏᤡ᤹ ᤏᤛᤠ᤺ᤴᤏᤡᤴ ᤋᤠᤱᤛᤧ᤺ᤵᤗᤥ॥"]},{"type":"verse","number":2,"content":["ᤜᤷᤍᤥ ᤜᤧᤰᤔᤠ ᤁᤧᤒᤠᤱᤒᤠᤜᤠ᤹ᤏᤢ ᤛᤡᤱᤛᤡᤱ ᤗ᤹ᤖᤧᤶᤔᤧ᤹ᤀᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤧᤱᤜᤠ᤹ᤃ ᤁᤡᤵᤔᤠ ᤁᤧᤄᤢ᤺ᤒᤠ ᤂᤩᤠᤒᤠ ᤜᤧᤰᤋᤱᤒᤠᤛᤡᤖᤥ॥"]},{"type":"verse","number":3,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤀᤠᤏᤡ᤹ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤛᤣᤛᤣᤔᤠᤱᤗᤠᤶ ᤛᤣᤘᤠ ᤁᤧᤈᤥ᤺ᤰᤐᤠᤜᤠ᤹ᤖᤰ ᤛᤧᤰᤂᤠ ᤜᤷᤍᤥ ᤁᤧᤜᤧᤰᤐᤠᤛᤡᤖᤥ॥ ᤀᤠᤏᤡ᤹ᤃ ᤔᤧᤴᤇᤠᤶ ᤕᤠ᤺ᤶᤒᤰᤁᤥ ᤋᤠ᤺ᤰᤐᤥ ᤀᤠᤴᤕᤢᤰᤂᤢᤶᤔᤡᤸᤗᤥ. ᤂᤧᤸᤗᤧ ᤁᤢᤗᤧᤰᤘᤠ ᤀᤠᤏᤡ᤹ᤗᤠᤃᤡ ᤂᤪᤡᤛ᤻ᤋ ᤕᤧᤛᤢᤖᤧ ᤆᤥᤃᤢᤒᤠ ᤐᤠ᤺ᤴᤏᤥᤏᤧ ᤀᤠᤛ᤺ᤳᤗᤥ॥"]},{"type":"verse","number":4,"content":["ᤜᤧᤰᤁᤣᤛᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤀᤠᤒᤠᤅᤣ ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤋᤠ᤺ᤰᤐᤥ ᤕᤢᤱᤔᤠ ᤛᤢᤰᤋᤢᤱᤒᤡᤗᤠ॥ ᤀᤠᤳᤋᤡᤸᤗᤧ ᤔᤧᤴᤇᤠᤶ ᤕᤠ᤺ᤶᤒᤰᤁᤥ ᤋᤠ᤺ᤰᤐᤥ ᤕᤢᤱᤔᤠ ᤛᤢᤰᤋᤢᤱ ᤗ᤹ᤖᤡᤰ ᤀᤡ᤺ᤳᤋᤢ᤹. ᤂᤧᤴᤏᤢ᤺ᤸᤗᤧᤀᤠᤱ ᤕᤖᤡᤰ ᤀᤡᤱᤃᤠ᤹ ᤋᤠ᤺ᤰᤐᤥ ᤕᤢᤱᤔᤠ ᤛᤢᤰᤋᤢᤱ–"]},{"type":"verse","number":5,"content":["ᤛᤠᤘᤠ᤺ᤴᤇᤡᤱᤅᤠᤱᤒᤠ ᤕᤧᤳᤇᤡ (᥎) ᤕᤧᤴᤏᤥ ᤜᤷᤍᤥ ᤔᤧᤜᤧᤃᤠᤱ ᤔᤧᤒᤡᤖᤠᤱ. ᤀᤡᤱᤃᤠ᤹ ᤔᤡᤱᤛᤥ ᤀᤡᤱᤎᤠ᤺ᤱᤒᤠ ᤒᤧᤴᤈᤠᤔᤡᤏ",{"noteId":5},"ᤛᤢᤘᤠᤱᤛ᤻ᤔᤠ ᤀᤡᤛᤪᤠᤀᤡᤗᤡ ᤔᤏᤠᤀᤠ. ᤜᤡᤒᤪᤢᤜᤠ᤹ᤀᤥ ᤛᤠ᤹ᤖᤡᤰ ᤛᤠᤶᤕᤥᤌᤡᤶ ᤁᤧᤀᤡ᤺ᤵᤐᤠ ᤁᤧᤏᤠ᤺ᤵᤐᤠ ᤜᤡᤒᤪᤢᤀᤠ. ᤛᤠᤶᤕᤥᤌᤡᤶ ᤀᤡ᤺ᤵᤔᤠ ᤏᤠ᤺ᤵᤔᤠᤀᤥᤃ ᤀᤡᤱᤃᤠ᤹ ᤁᤧᤏᤡ᤺ᤒᤠ ᤁᤧᤗᤧᤒᤠ ᤑᤖᤡᤛᤡᤀᤠᤖᤥ",{"noteId":6}]},{"type":"verse","number":6,"content":["ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤴ ᤀᤡ᤺ᤵᤔᤠ ᤏᤠ᤺ᤵᤔᤠᤀᤥ ᤛᤡᤰᤁᤧᤛᤶᤒᤠ ᤘᤕᤠᤱ. ᤜᤧᤰᤁᤩᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤛᤣᤛᤣᤜᤢᤵᤗᤰᤁᤡᤴ ᤋᤢᤰᤂᤣ ᤆᤠ᤺ᤳᤋᤢᤱᤗᤥ॥ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤏᤡᤱᤘᤠ᤹ ᤋᤠᤖ ᤑᤠ᤹ᤀᤠᤱ ᤁᤠᤰ ᤛᤠᤶᤕᤥᤌᤡᤶ ᤀᤡᤱᤈᤠ᤺ᤱᤅᤡᤱᤃ ᤏᤢ᤺ᤖᤡᤰᤁᤠᤱ ᤀᤡ᤺ᤳᤋᤢᤱ ᤏᤠ᤺ᤳᤋᤢᤱ॥"]},{"type":"verse","number":7,"content":["ᤁᤖ ᤀᤠᤳᤋᤡᤴ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤀᤠᤗᤠᤃᤡ ᤀᤡᤱᤎᤠ᤺ᤱᤒᤠ ᤆᤥᤃᤧ. ᤂᤧᤱᤜᤠ᤹ ᤁᤧᤖᤧᤰ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤁᤢᤔᤧᤸᤗᤢᤱ ᤔᤧ᤺ᤴᤏᤣᤒᤠ ᤀᤡ᤺ᤳᤋᤢᤱᤗᤥ॥"]},{"type":"verse","number":8,"content":["ᤂᤧᤴᤗᤰ ᤔᤧ᤺ᤴ. ᤁᤖ ᤀᤠᤍᤠᤱᤒᤠ ᤂᤪᤡᤛ᤻ᤋ ᤕᤧᤛᤢ᤺ᤴ ᤁᤢᤛᤡᤱ ᤏᤡ᤺ᤵᤔᤠ ᤂᤥ᤺ᤔᤠᤱᤃ ᤁᤠᤰᤏᤢ᤺ᤸᤗᤧ ᤏᤢ᤺ᤒᤠ ᤐᤠ᤺ᤴ ᤐᤥ᤺ᤰᤂᤧᤒᤠᤸᤗᤧ ᤁᤠᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ᤃ ᤜᤏᤧᤒᤠᤀᤣ ᤀᤡ᤺ᤳᤋᤢᤱᤅᤠᤱ ᤂᤢᤏᤧ᤹ ᤁᤢᤗᤠᤃᤡ ᤗᤠᤱ ᤜᤠᤰᤋᤢᤱᤍᤣ᤺ᤛᤢᤱᤗᤥ॥ ᤂᤪᤡᤛ᤻ᤋᤧᤴ ᤂᤥ᤺ᤔᤠ ᤑᤠ᤹ᤀᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤂᤧᤱᤜᤠ᤹ ᤋᤠᤶᤈᤡᤖᤰ ᤀᤡ᤺ᤳᤋᤢᤱᤗᤥ॥"]},{"type":"verse","number":9,"content":["ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤀᤡᤱᤃᤠ᤹ ᤂᤢᤏᤧ᤹ᤀᤡᤴ ᤐᤥ᤺ᤱᤅᤠᤏᤡ ᤑᤠ᤹ᤀᤠᤱ ᤜᤧᤰᤁᤣ ᤀᤡ᤺ᤳᤋᤢᤱᤗᤥ॥ ᤀᤡᤱᤃᤠ᤹ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤴ ᤀᤡ᤺ᤳᤋᤢᤱ ᤏᤠ᤺ᤳᤋᤢᤱᤅᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤏᤡ᤺ᤔᤠᤀᤥ ᤛᤠᤶᤕᤥᤏᤡᤒᤠ ᤐᤥ᤺ᤱᤔᤠ ᤔᤧᤴᤇᤢᤰᤐᤧᤴᤗᤥ. ᤁᤖ ᤂᤪᤡᤛ᤻ᤋᤧᤴ ᤏᤛᤠ᤺ᤴ ᤆᤥᤃᤢᤱᤒᤠᤸᤗᤧᤀᤣ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤛᤠᤶᤕᤥᤏᤡᤒᤠ ᤆᤥ᤺ᤰᤁᤠᤖᤥ॥"]},{"type":"verse","number":10,"content":["ᤀᤡᤱᤃᤠ᤹ᤃ ᤂᤪᤡᤛ᤻ᤋᤧᤴ ᤏᤢ ᤛᤡ᤺ᤔᤧᤴᤗᤠᤶ ᤕᤠᤶᤔᤥ ᤁᤢᤜᤡᤱᤘᤧᤳ ᤁᤧᤈᤥ᤺ᤰᤐᤠ ᤔᤢᤰᤛᤠᤶᤔᤡᤴ ᤁᤢᤛᤡᤱ ᤏᤡ᤺ᤵᤔᤠ ᤏᤡᤱᤘᤠ᤹ ᤆᤥᤃᤢᤱᤗᤥ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ ᤀᤡᤏᤥᤃᤧᤴ ᤋᤢᤰᤂᤣ ᤆᤩᤧᤒᤠ ᤜᤧᤰᤁᤣ ᤀᤡᤱᤃᤠ᤹ᤀᤠᤱ ᤋᤢᤰᤂᤣ ᤆᤠᤔᤠᤀᤠᤱ ᤁᤢᤛᤡ᤺ᤔᤧᤴᤏᤥ ᤛᤥᤖᤡᤰ ᤐᤥ᤺ᤱᤔᤠ ᤏᤡᤱᤘᤠ᤹ ᤆᤥᤃᤢᤱ."]},{"type":"verse","number":11,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤰᤂᤣᤗ᤹ᤖᤡᤰᤛᤠᤱ ᤛᤡ᤺ᤔᤧᤴᤗᤠᤶ ᤕᤠᤶᤔᤥ ᤜᤡᤱᤔᤠᤱᤃ ᤂᤥ᤺ᤔᤠ ᤛᤢᤰᤋᤢᤱᤗ ᤁᤧᤗ᤹ᤒᤠ ᤏᤡᤱᤛᤠᤱ ᤁᤳᤋᤢᤱᤗᤥ॥"]},{"type":"heading","content":["ᤋᤠᤖᤵᤐᤥ ᤋᤃᤡ ᤐᤥ᤺ᤔᤠ"]},{"type":"verse","number":12,"content":["ᤀᤡᤱᤃᤠ᤹ ᤁᤴ ᤁᤧᤖᤧᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤂᤥ᤺ᤛᤢᤱ ᤀᤡᤃᤪ ᤁᤢᤛᤠᤱ ᤗᤛ᤻ᤛᤢᤱ ᤛᤢᤖᤢᤱᤅᤠᤱ ᤘᤠ᤹ᤀᤠ ᤁᤧᤗ᤹ᤒᤠᤃ ᤔᤧ᤺ᤴᤗᤥ. ᤁᤖ ᤀᤡᤱᤃᤠ᤹ᤃ ᤁᤴ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤂᤥ᤺ᤔᤠ ᤑᤠ᤹ᤀᤠᤱ ᤋᤃᤡ ᤐᤥᤀᤠᤖ ᤐᤳᤋᤠᤖᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤒᤠ ᤂᤧᤸᤗᤧ ᤗᤠᤃᤡ ᤂᤪᤡᤛ᤻ᤋ ᤕᤧᤛᤢᤖᤧ ᤋᤠᤱᤛᤧ᤺ᤵᤋᤠᤱᤒᤠᤖᤥ॥"]},{"type":"verse","number":13,"content":["ᤀᤠᤔᤡ᤺ᤶ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤛᤣ. ᤀᤡᤱᤃᤠ᤹ᤃ ᤀᤠᤸᤗᤛᤠᤱ ᤁᤠᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤔᤧᤱᤄᤥᤀᤣ ᤘᤠ᤹ᤀᤠᤖᤥ॥ ᤁᤖ ᤀᤡᤱᤃᤠ᤹ ᤗᤳᤇᤠ ᤕᤠ᤺ᤶᤒᤰᤁᤡᤴ ᤆᤥᤃᤢᤱ–ᤐᤣᤕᤧᤶᤒᤠ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤏᤡᤱᤘᤠ᤹ ᤑᤧ᤺ᤳᤇᤢᤱᤅᤠᤱ ᤀᤡᤱᤃᤠ᤹ᤃ ᤋᤃᤡ ᤗᤧᤵᤔᤠᤱᤏᤧ ᤗᤢᤒᤢᤒᤢ ᤐᤥᤀᤠᤖᤥ॥"]},{"type":"verse","number":14,"content":["ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤛᤠᤱᤃᤪ