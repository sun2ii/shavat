{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"REV","translationId":"lif_wbt","name":"ᤛᤢᤑᤥ","commonName":"ᤛᤢᤑᤥ","title":"ᤕᤢᤜᤢᤴᤏᤠᤖᤧ ᤏᤡ᤺ᤛᤢᤒᤠ ᤛᤢᤑᤥ","order":66,"numberOfChapters":22,"sha256":"fecd46133e75bd47eb645280f500eb8d9e0cf837315af00323d1027d84fbb837","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/lif_wbt/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":10,"content":[{"type":"heading","content":["ᤔᤠᤱᤗᤠᤀᤡᤱᤒᤠ ᤏᤢ ᤆᤢᤰᤛᤠ ᤛᤠᤵᤁᤡᤳᤋᤡᤴ"]},{"type":"verse","number":1,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤘᤣ᤹ ᤔᤢᤰᤛᤠᤶᤍᤠᤱᤒᤠ ᤔᤠᤱᤗᤠᤀᤡᤱᤒᤠᤎᤡᤰ ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱᤗᤠᤶ ᤕᤧ᤺ᤖ ᤐᤳᤇᤧᤒᤠ ᤏᤡ᤺ᤛᤢᤱ॥ ᤂᤧᤴ ᤂᤠᤵᤔᤡ᤺ᤳᤋᤡᤸᤗᤧ ᤐᤴᤇᤡᤱᤅᤠᤱ ᤘᤕᤧ. ᤁᤢᤎᤧᤃᤣ᤺ᤰ ᤛᤶᤍᤠᤱᤃ ᤏᤠᤶᤎᤡᤱᤃᤥ᤺ᤴ ᤐᤳᤇᤧ. ᤂᤢᤏᤧ᤹ ᤁᤢᤏᤠᤖᤠ᤺ᤱᤃ ᤏᤠᤶᤔᤡᤴ ᤜᤧᤰᤁᤣ ᤔᤡᤰ ᤁᤧᤈᤧᤶᤒᤠ ᤆᤥᤃᤧ. ᤜᤧᤰᤁᤩᤠᤱ ᤁᤢᤗᤠᤱᤜᤠ᤹ᤃ ᤔᤡ ᤁᤧᤍᤡ᤺ᤵᤐᤠ ᤛᤡᤳᤗᤠᤱ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤆᤥᤃᤧᤖᤥ॥"]},{"type":"verse","number":2,"content":["ᤂᤧᤸᤗᤧ ᤁᤢᤜᤢᤰᤁᤥ ᤆᤢᤰᤛᤠ ᤑᤠ᤺ᤱᤔᤏᤠᤒᤠ ᤛᤠᤵᤁᤡᤳᤌᤡᤰ ᤁᤳᤋᤢ॥ ᤂᤧᤸᤗᤧ ᤁᤢᤈᤢᤵᤛᤠᤱ ᤗᤠᤱᤅᤡᤸᤗᤧ ᤘᤠᤜᤱᤅᤥ ᤏᤢ ᤁᤢᤓᤧᤴᤇᤠᤱ ᤗᤠᤱᤅᤡᤸᤗᤧ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥ ᤋᤥ᤹ᤖᤢᤀᤠᤱ ᤕᤧᤒᤧᤖᤥ॥"]},{"type":"verse","number":3,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤴ ᤔᤠᤱᤗᤠᤀᤡᤱᤒᤠᤴ ᤌᤧᤖᤡᤱᤒᤠᤴ ᤜᤢ᤺ᤰᤋᤧᤒᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰᤁᤣ ᤕᤶᤒᤠ ᤀᤡᤰᤗᤠᤀᤥ ᤀ᤺ᤰᤋᤧᤖᤥ॥ ᤂᤢᤏᤧ᤹ ᤀ᤺ᤰᤋᤧᤸᤗᤧ ᤋᤠᤱᤛᤠᤰᤐᤧᤴ ᤏᤢᤛᤡᤗᤧᤱ ᤗᤥ᤺ᤰᤂᤢᤖᤥ॥"]},{"type":"verse","number":4,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤂᤧᤴ ᤋᤠᤱᤛᤠᤰᤐᤠ ᤁᤧᤗᤥ᤺ᤱᤒᤠᤸᤗᤧ ᤁᤢᤒᤠ᤺ᤴᤏᤡᤴ ᤛᤠᤵᤔᤠᤀᤣ ᤀᤡ᤺ᤳᤋᤢᤱᤅᤠᤱ ᤐᤳᤇᤠᤱ. ᤁᤖ ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱᤗᤠᤶ ᤂᤧᤴ ᤏᤢᤛᤡ ᤂᤧᤖᤧᤱ ᤄᤢᤖᤢᤱ ᤁᤧᤗ᤹ᤒᤠᤸᤗᤧ ᤁᤢᤒᤠ᤺ᤴᤏᤡᤴ ᤔᤧᤛᤠᤵᤋᤧᤴᤏᤧ᤹. ᤁᤖ ᤂᤧᤱᤜᤠ᤹ ᤔᤠ᤹ᤖᤧᤀᤠᤱ ᤁᤳᤋᤧ᤹ᤀᤥ ᤁᤧᤗ᤹ᤒᤠ ᤀᤡᤰᤗᤠᤎᤡᤰ ᤂᤧᤵᤛᤢᤱ॥"]},{"type":"verse","number":5,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤏᤡ᤺ᤛᤢᤱᤒᤠ ᤂᤧᤴ ᤘᤠᤜᤱᤅᤥ ᤏᤢ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥ ᤁᤧᤕᤧᤵᤐᤠ ᤔᤠᤱᤗᤠᤀᤡᤱᤒᤠᤸᤗᤧ ᤁᤢᤈᤢᤵᤛᤠᤱ ᤜᤢᤰᤁᤡᤴ ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱ ᤗᤧᤵᤔᤠᤱ ᤑᤥ᤺ᤰᤂᤢᤖ"]},{"type":"verse","number":6,"content":["ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱ. ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰ ᤏᤢ ᤘᤠᤜᤱ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤵᤔᤥ ᤁᤧᤘᤠ᤹ᤒᤠ ᤁᤠᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ᤖᤧᤴ ᤏᤠᤘᤠᤃᤧᤴ ᤆᤀᤡ᤺ᤳ ᤁᤧᤏᤧᤒᤠ ᤛᤍᤠᤍᤡᤱ ᤁᤢᤜᤡᤱᤘᤧᤳ ᤁᤧᤘᤠ᤹ᤒᤠ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤔᤡᤱᤅᤥ ᤔᤠᤱᤜᤧᤰᤛᤡᤱᤗᤥ॥ ᤂᤧᤴ ᤔᤠᤱᤗᤠᤀᤡᤱᤒᤠᤸᤗᤧ ᤐᤠ᤺ᤳᤋᤢ. “ᤀᤠᤸᤗ ᤂᤧᤴ ᤕᤧᤶᤔᤡᤴ ᤋᤠ᤺ᤔᤠ ᤕᤖᤡᤰ ᤜᤥ᤺ᤵᤗᤥ."]},{"type":"verse","number":7,"content":["ᤁᤖ ᤏᤢᤛᤡᤃᤣ᤺ᤰᤐᤠ ᤔᤠᤱᤗᤠᤀᤡᤱᤒᤠᤸᤗᤧ ᤁᤢᤎᤢᤳᤌᤢᤖᤡ᤺ᤵᤐᤧᤴ ᤔᤢ᤺ᤳᤋᤢᤸᤗᤧ ᤔᤠᤱᤏᤡᤱᤘᤠ᤹ᤐᤠ᤺ᤴ ᤁᤧᤒᤠ᤺ᤵᤐᤠ",{"noteId":7},"ᤁᤢᤛᤣᤘᤠᤖᤥᤒᤠᤜᤠ᤹ ᤋᤃᤡ ᤀᤡᤱᤓᤴ ᤆᤥᤃᤢᤛᤡᤒᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤛᤡᤒᤡ᤹ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤁᤧᤳᤗᤥ॥”"]},{"type":"verse","number":8,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱᤗᤠᤶ ᤂᤧᤵᤛᤢᤱᤒᤠ ᤀᤡᤰᤗᤠ᤺ᤸᤗᤧ ᤕᤠᤶᤔᤥ ᤀᤰᤂᤣ ᤔᤧᤳᤋᤠᤱ. “ᤐᤣᤃᤧ᤹ᤀᤠᤱ ᤂᤧᤴ ᤘᤠᤜᤱᤅᤥ ᤏᤢ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥ ᤁᤧᤕᤧᤵᤐᤠ ᤔᤠᤱᤗᤠᤀᤡᤱᤒᤠᤸᤗᤧ ᤁᤢᤜᤢᤰᤁᤥ ᤁᤳᤋᤢᤒᤠ ᤂᤧᤴ ᤁᤧᤒᤠ᤺ᤱᤒᤠ ᤛᤠᤵᤁᤡᤳᤋᤡᤴ ᤋᤠ᤺ᤰᤋᤧ᤹॥”"]},{"type":"verse","number":9,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤀᤡᤱᤃᤠ᤹ᤀᤠᤱ ᤂᤧᤴ ᤔᤠᤱᤗᤠᤀᤡᤱᤒᤠᤸᤗᤥ ᤐᤣᤃᤠᤱᤅᤠᤱ ᤂᤧᤴ ᤆᤢᤰᤛᤠ ᤛᤠᤵᤁᤡᤳᤋᤡᤴ ᤏᤠ᤺ᤰᤋᤢᤱ॥ ᤂᤧᤸᤗᤧ ᤔᤧᤳᤋᤠᤱ. “ᤁᤫᤧ᥄ ᤁᤴ ᤋᤠ᤺ᤰᤋᤧ᤹ᤀᤠᤱ ᤆᤩᤧ᤹. ᤁᤴ ᤁᤧᤈ᤺ᤸᤗᤧ ᤁᤧᤔᤢᤖᤠᤀᤥ ᤛᤰᤘᤠᤄᤢ ᤜᤧᤰᤁᤣ ᤐᤗᤡᤶᤗᤡᤶᤛᤠᤱ ᤁᤧᤛᤠᤵᤐᤥ᤺ᤰᤐᤥ ᤗᤠ᤺ᤳᤋᤠᤱ ᤐᤄᤡ᤺ᤰᤂᤡ᤺ᤰᤗᤥ॥”"]},{"type":"verse","number":10,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤴ ᤆᤢᤰᤛᤠ ᤛᤠᤵᤁᤡᤳᤋᤡᤴ ᤁᤢᤜᤢᤰᤁᤥᤗᤠᤶ ᤋᤠ᤺ᤰᤋᤢᤱᤅᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤆᤠᤱ॥ ᤂᤧᤴ ᤆᤠᤱᤅᤡᤸᤗᤧ ᤀᤠᤔᤢᤖᤠᤀᤥ ᤐᤗᤡᤶᤗᤡᤶᤍᤧ. ᤁᤖ ᤀᤠᤛᤠᤵᤐᤥ᤺ᤰᤐᤥ ᤗᤠ᤺ᤛᤧᤀᤠᤱ ᤐᤄᤡ᤺ᤰᤂᤡ᤺ᤰᤋᤧᤖᤥ॥"]},{"type":"verse","number":11,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ ᤀᤰᤂᤣ ᤔᤧᤳᤋᤠᤱ. “ᤂᤧᤏᤧ᤹ ᤕᤖᤡᤰ ᤔᤏᤠᤜᤠ᤹. ᤔᤧᤴᤇᤠᤶ ᤛᤢᤘᤠᤱᤜᤠ᤹. ᤕᤖᤡᤰ ᤐᤠ᤺ᤴᤍᤠᤱᤜᤠ᤹ ᤏᤢ ᤜᤠᤱᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤕᤠ᤺ᤶᤒᤣᤀᤥ ᤕᤠᤶᤔᤥ ᤔᤠᤱᤏᤡᤱᤘᤠ᤹ᤐᤠ᤺ᤴ ᤁᤧᤒᤠ᤺ᤳᤋᤢᤖᤀᤣ ᤐᤥ᤺ᤱᤗᤥ॥”"]}],"footnotes":[{"noteId":7,"caller":"*","text":"ᤔᤠᤱᤏᤡᤱᤘᤠ᤹ᤐᤠ᤺ᤴ ᤁᤧᤒᤠ᤺ᤵᤐᤠᤴ–ᤂᤢᤏᤧ᤹ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤗᤠᤶᤒᤠᤒᤠ ᤀᤡᤱᤄᤱ ᤁᤧᤒᤠ᤺ᤵᤐᤠ ᤔᤏᤠᤖᤥ॥ ᤁᤢᤓᤠ ᤕᤧᤶᤔᤥ ᤋᤠ᤺ᤴᤍᤡ ᤁᤧᤒᤥ᤺ᤱᤒᤠ ᤐᤠ᤺ᤴᤏᤠᤱ ᤂᤢᤏᤧ᤹ ᤐᤠ᤺ᤳᤋᤢᤖᤥ॥","reference":{"chapter":10,"verse":7}}]},"thisChapterLink":"/api/lif_wbt/REV/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lif_wbt/REV/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lif_wbt/REV/9.json","previousChapterAudioLinks":{},"numberOfVerses":11}