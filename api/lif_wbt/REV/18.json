e","number":11,"content":["ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥᤒᤠ ᤗᤧᤱᤜᤱᤒᤠᤜᤠ᤹ ᤔᤧᤜᤠ᤺ᤵᤗ ᤔᤣᤖᤡᤱ ᤔᤧᤎᤰᤗᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤢᤏᤡ᤹ ᤆᤡᤃ᤺ᤰᤘᤠᤜᤠ᤹ ᤕᤠᤶᤔᤥ ᤀᤠᤳᤋᤡᤴᤜᤠ᤹ᤖᤧᤀᤠᤱ ᤔᤧᤴᤀᤡᤅᤢᤴᤗᤥ॥"]},{"type":"verse","number":12,"content":["ᤀᤠᤳᤋᤡᤴᤜᤠ᤹ᤖᤧᤀᤠᤱ ᤂᤢᤏᤡ᤹ ᤛᤠᤶᤔᤩᤠᤱ. ᤕᤢᤵᤐᤠ. ᤔᤢᤎᤡᤱᤗᤢᤱ. ᤋᤧᤰᤛᤣ᤺ᤰ. ᤜᤧᤰᤁᤩᤠᤱ ᤏᤢ᤺ᤒ᤻ ᤏᤢ᤺ᤒᤠ ᤏᤠᤀᤡᤏᤠᤛᤢ᤺ᤳ. ᤐᤖᤠᤴᤗᤠ ᤏᤢ ᤜᤧ᤺ᤳ ᤁᤧᤗ᤹ᤒᤠ ᤋᤣ᤺ᤳᤜᤠ᤹. ᤀᤛᤣ᤺ᤰᤂᤡ ᤋᤣ᤺ᤳ. ᤜᤧᤰᤁᤩᤠᤱ ᤁᤠᤰ ᤐᤖᤡᤰᤗᤧᤴ ᤁᤢᤏᤠᤶ ᤁᤧᤏᤢ᤹ᤒᤠ ᤛᤡᤱᤜᤠ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤋᤰᤔᤡᤒᤠᤸᤗᤧ ᤁᤢᤃᤣ᤺ᤱ. ᤀᤡᤔᤧᤸᤗᤢᤱᤒᤠ ᤛᤡᤱᤜᤠ᤹ᤗᤠᤔ. ᤌᤳᤏᤠᤔᤠᤜᤠ᤹ᤗᤠᤔ. ᤑᤧᤴᤈᤣ᤹ᤗᤠᤔ ᤏᤢ ᤘᤠᤗᤧᤱᤗᤢᤱᤗᤠᤶ ᤆᤥ᤺ᤰᤔᤏᤠᤒᤠ ᤁᤠᤰ ᤐᤖᤡᤰᤗᤧᤴ ᤆᤡᤃ᤺ᤰᤘᤠᤜᤠ᤹."]},{"type":"verse","number":13,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤏᤠᤶᤛᤡᤱ ᤜᤰ. ᤔᤠᤖᤢᤰᤜᤠ᤹. ᤁᤢᤏᤠᤶ ᤁᤧᤏᤢ᤹ᤒᤠ ᤛᤠᤱᤛᤡᤱ. ᤔᤢᤷᤖ. ᤐᤠᤱᤒ᤺ᤳ ᤑᤢᤱᤔᤠ. ᤆᤧᤸᤗᤧᤰᤛᤣ᤹ ᤌᤡ᤺. ᤈᤤᤋᤢᤏ ᤏᤡ᤺ᤱᤃᤣ᤺ᤴ. ᤑᤧ᤹ᤖᤢᤶ. ᤛᤡ᤺. ᤜᤧᤰᤁᤩᤠᤱ ᤐᤡᤳ ᤛᤠ᤺ᤱᤘᤧᤳ. ᤔᤧᤸᤗᤢᤰᤜᤠ᤹. ᤀᤴᤜᤠ᤹. ᤀᤴᤗᤠᤜᤠ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤕᤥ᤺ᤰᤐᤠ ᤕᤥ᤺ᤰᤔᤠᤜᤠ᤹ ᤏᤢ ᤌᤱᤅᤥ ᤔᤧᤏᤠᤵᤋᤢᤛᤡᤒᤠ ᤔᤏᤠᤜᤠ᤹ᤀᤠᤱ ᤔᤧᤴᤀᤡᤅᤢᤴᤇᤡᤴᤗᤥ॥"]},{"type":"verse","number":14,"content":["ᤗᤧᤱᤜᤱᤒᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤧ᤹ ᤀᤰᤂᤣ ᤔᤧᤔᤧᤳᤋᤢ᤹ᤖᤥ. “ᤂᤧᤏᤧ᤹ ᤁᤠᤰ ᤀᤠᤒᤠᤅᤣ ᤁᤵᤔᤠ ᤏᤡᤱᤘᤠ᤹ ᤁᤧᤈᤥᤃᤢᤒᤠ ᤏᤢ᤺ᤒ᤻ ᤏᤢ᤺ᤒᤠ ᤆᤡᤃ᤺ᤰᤘᤠᤜᤠ᤹ ᤁᤠᤰ ᤔᤧᤔᤕᤧ ᤔᤧᤒᤣᤖᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤁᤧᤕᤠᤱᤛᤠᤁᤢᤴᤎᤣ ᤏᤢ ᤁᤧᤄᤧᤶᤛᤡᤱᤔᤠᤜᤠ᤹ᤀᤠᤱ ᤔᤕᤧᤒᤣᤖᤥ॥ ᤂᤧᤱᤜᤠ᤹ᤃ ᤂᤧᤏᤧ᤹ ᤕᤠᤶᤔᤥ ᤀᤠᤵᤑᤠᤸᤗᤧᤀᤠᤱ ᤁᤧᤱᤄᤥ᤺ᤛᤢᤴᤗᤥ॥”"]},{"type":"verse","number":15,"content":["ᤂᤧᤴ ᤕᤧᤰᤕᤰᤁᤥ ᤗᤧᤱᤜᤱ ᤆᤥ᤺ᤰᤛᤧ ᤁᤧᤍᤠ᤺ᤒᤠᤀᤠᤱ ᤕᤠᤱᤛᤠᤁᤢᤴᤎᤣᤛᤠᤒᤠ ᤁᤧᤒᤥ᤺ᤱᤒᤠ ᤗᤧᤱᤜᤱᤒᤠᤜᤠ᤹ᤃ ᤔᤠ᤺ᤱᤄᤠᤀᤣ ᤔᤧᤕᤧᤵᤗᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤧᤱᤜᤠ᤹ ᤂᤧᤸᤗᤧ ᤁᤢᤍᤢᤰᤂᤣ᤺ᤴᤏᤢ ᤛᤠ᤹ᤖᤡᤰ ᤔᤧᤃᤡᤖᤥ॥ ᤂᤧᤱᤜᤠ᤹ ᤔᤧᤜᤠ᤺ᤵᤗ ᤔᤣᤖᤡᤱ ᤌᤰᤏᤢ"]},{"type":"verse","number":16,"content":["ᤀᤰᤂᤣ ᤔᤧᤗ᤹ᤖᤥ.",{"text":"“ᤀᤠᤕᤠᤰᤁᤥ. ᤀᤠᤕᤠᤰᤁᤥ᥄ ᤂᤧᤴ ᤐᤕᤶ ᤕᤶᤒᤠ ᤕᤧᤰᤕᤰᤁᤡᤱᤃ ᤏᤢ᤺ᤒ᤻ ᤏᤢ᤺ᤒᤠ ᤏᤠᤀᤡᤏᤠᤛᤢ᤺ᤳ. ᤐᤖᤠᤴᤗᤠ ᤏᤢ ᤜᤧ᤺ᤳ ᤁᤧᤗ᤹ᤒᤠ ᤋᤣ᤺ᤳ ᤑᤢᤱᤜᤠ᤹ ᤆᤠᤰᤛᤡᤱᤅᤠᤱ ᤛᤠᤶᤔᤩᤠᤱᤜᤠ᤹. ᤀᤡᤔᤧᤸᤗᤢᤱᤒᤠ ᤔᤢᤎᤡᤱᤗᤢᤱᤜᤠ᤹ ᤜᤧᤰᤁᤩᤠᤱ ᤋᤧᤰᤛᤣ᤺ᤰᤁᤡᤸᤗᤧᤴ ᤘᤠ᤺ᤳᤋᤡᤜᤠ᤹ ᤁᤧᤘᤠ᤺ᤵᤔᤠ ᤔᤧᤴᤇᤢᤔᤠ᤹ᤀᤡᤴ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤛᤠ᤹ᤖᤡᤰ ᤏᤢ᤺ᤒᤠ ᤆᤥᤃᤧᤖᤥ॥","poem":1}]},{"type":"verse","number":17,"content":[{"text":"ᤛᤵᤑᤠᤖᤧᤛᤠ ᤁᤠᤰ ᤁᤢᤕᤠᤱᤛᤠᤁᤢᤴᤎᤣᤜᤠ᤹ ᤂᤧᤸᤗᤧ ᤔᤠ᤺ᤛᤢᤍᤣ᤺ᤛᤢᤖᤥ᥄”","poem":1},"ᤁᤠᤰ ᤘᤠᤗᤠᤎᤠ ᤍᤠᤱᤒᤠᤜᤠ᤹. ᤘᤠᤗᤠᤶᤍᤡ᤺ᤰᤐᤠᤜᤠ᤹. ᤘᤠᤗᤠᤎᤠ ᤆᤠ᤺ᤰᤐᤠᤜᤠ᤹ ᤏᤢ ᤘᤠᤜᤱᤅᤥ ᤕᤠ᤺ᤶᤒᤰ ᤁᤧᤈᤥ᤺ᤰᤐᤠ ᤁᤧᤈᤠᤒᤠᤜᤠ᤹ ᤔᤠ᤺ᤱᤄᤠ ᤔᤧᤕᤧᤵᤐᤠᤱ"]},{"type":"verse","number":18,"content":["ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤂᤧᤴ ᤐᤕᤶ ᤕᤶᤒᤠ ᤕᤧᤰᤕᤰᤁᤡᤴ ᤔᤡᤍᤡᤃᤧᤀᤠᤱ ᤁᤧᤗ᤺ᤶᤒᤠ ᤔᤡ᤺ᤰᤂᤢ᤹ᤀᤡᤴ ᤔᤧᤏᤡ᤺ᤛᤢᤀᤠᤱ ᤀᤰᤂᤣ ᤔᤧᤒᤠ᤺ᤳᤋᤢᤖ ᤔᤧᤀ᤺ᤰ.",{"text":"“ᤁᤴ ᤐᤕᤶ ᤕᤶᤒᤠ ᤕᤧᤰᤕᤰ ᤜᤧᤰᤋᤱᤒᤠ ᤕᤧᤰᤕᤰᤁᤡᤱᤃ ᤀᤠᤳᤋᤡᤴᤏᤠᤱ ᤜᤥ᤺ᤵᤋᤧᤖᤥ᥄”","poem":1}]},{"type":"verse","number":19,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤂᤠᤶᤜᤡ᤺ᤰᤁᤡᤴ ᤂᤢᤏᤡ᤹ ᤌᤧᤃᤣ᤺ᤰ ᤛᤶᤍᤠᤱ ᤔᤧᤈᤢ᤺ᤳᤇᤡᤱᤅᤠᤱ ᤔᤧᤜᤠ᤺ᤵᤗ. ᤔᤧᤓᤡ᤺ᤰᤗ. ᤔᤣᤖᤡᤱ ᤌᤰᤏᤢ ᤀᤰᤂᤣ ᤔᤧᤒᤠ᤺ᤳᤋᤢ᤹ᤖᤥ.",{"text":"“ᤀᤠᤕᤠᤰᤁᤥ. ᤀᤠᤕᤠᤰᤁᤥ᥄ ᤁᤴ ᤐᤕᤶ ᤕᤶᤒᤠ ᤕᤧᤰᤕᤰᤁᤥᤃ. ᤕᤖᤡᤰ ᤘᤠᤗᤠᤎᤠ ᤍᤠᤱᤒᤠᤜᤠ᤹ᤖᤧ ᤂᤧᤸᤗᤧ ᤁᤢᤕᤠᤱᤛᤠᤁᤢᤴᤎᤣᤗᤠᤶ ᤕᤠᤱᤛᤠᤁᤢᤴᤎᤣᤛᤠᤒᤠ ᤔᤧᤒᤥ᤺ᤰᤂᤧᤖᤥ॥ ᤁᤖ ᤛᤵᤑᤠᤖᤧᤛᤠ ᤂᤧᤴ ᤕᤧᤰᤕᤰᤁᤡᤴ ᤁᤠᤰ ᤔᤧᤃᤧᤖᤥ॥","poem":1}]},{"type":"verse","number":20,"content":[{"text":"ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱᤅᤥ ᤁᤧᤘᤠ᤹ᤒᤠᤛᤣ. ᤂᤧᤴ ᤔᤧᤃᤧᤒᤠᤀᤥ ᤛ᤺ᤳᤋᤧᤶᤔᤧ᤹ᤀᤥ᥄ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤛᤣᤛᤣ ᤁᤢᤔᤏᤠᤜᤠ᤹. ᤛᤣ᤺ᤰᤕᤢᤰᤔᤡᤒᤠᤜᤠ᤹ ᤜᤧᤰᤁᤩᤠᤱ ᤔᤠᤱᤏᤡᤱᤘᤠ᤹ᤐᤠ᤺ᤴ ᤁᤧᤒᤠ᤺ᤵᤐᤠᤛᤣ. ᤛ᤺ᤳᤋᤧᤶᤔᤧ᤹ᤀᤥ᥄ ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤡᤏᤡ᤹ ᤏᤡᤱᤄᤢᤶ ᤁᤧᤔᤧᤳᤋᤡᤒᤠᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤂᤧᤴ ᤂᤢᤶᤍᤡᤱ ᤐᤡᤖᤢᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥”","poem":1}]},{"type":"verse","number":21,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤔᤢᤰᤛᤠᤶᤍᤠᤱᤒᤠ ᤔᤠᤱᤗᤠᤀᤡᤱᤒᤠᤎᤡᤰᤗᤧ ᤐᤕᤶ ᤕᤶᤒᤠ ᤗᤢᤱᤛᤢᤶ ᤜᤧᤰᤋᤱᤒᤠ ᤗᤢᤱᤎᤡᤰ ᤐᤰᤂᤢᤀᤠᤱ ᤕᤥ ᤘᤠᤜᤱᤅᤥ ᤗᤠᤵᤑᤢᤛᤢ ᤌᤠ᤺ᤛᤢᤖ ᤀᤰᤂᤣ ᤐᤠ᤺ᤳᤋᤢᤖᤥ.",{"text":"“ᤐᤕᤶ ᤕᤶᤒᤠ ᤕᤧᤰᤕᤰ ᤒᤧᤒᤡᤗᤥᤏᤡᤴᤏᤠᤱ ᤒᤠ ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰᤁᤣ ᤗᤠᤵᤑᤢᤖᤥ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤴ ᤕᤠᤶᤔᤥ ᤀᤠᤵᤑᤠᤸᤗᤧᤀᤠᤱ ᤏᤡᤔᤧᤎᤠ᤺ᤵᤏᤧᤴᤗᤥ॥","poem":1}]},{"type":"verse","number":22,"content":[{"text":"ᤜᤧᤰᤁᤩᤠᤱ ᤛᤠᤖᤠᤱᤃᤡ. ᤔᤧᤵᤑᤪᤠᤔᤠ ᤏᤢ ᤌᤢᤳᤋᤢᤖᤡ᤺ᤵᤐᤠ ᤔᤢᤰᤐᤠ ᤀᤡᤰᤗᤠ᤺ᤴ ᤜᤧᤰᤁᤩᤠᤱ ᤛᤠᤶᤃᤧᤗᤥᤒᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤛᤠᤶᤗᤥᤜᤠ᤹ ᤂᤧᤏᤧ᤹ᤀᤥ ᤕᤠᤶᤔᤥ ᤀᤠᤵᤑᤠᤸᤗᤧᤀᤠᤱ ᤂᤧᤶ ᤔᤧᤍᤧᤳᤏᤧᤴᤗᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤁᤠᤰ ᤐᤖᤡᤰᤐᤠ ᤛᤠᤵᤆᤥ᤺ᤰᤃᤧᤶᤒᤠᤜᤠ᤹ ᤂᤧᤏᤧ᤹ᤀᤥ ᤕᤠᤶᤔᤥ ᤀᤠᤵᤑᤠᤸᤗᤧᤀᤠᤱ ᤂᤥᤔᤧᤴᤍᤣᤳᤏᤧᤴᤗᤥ॥ ᤕᤠᤶᤔᤥ ᤗᤢᤱᤛᤢᤶ ᤕᤢ᤺ᤵᤔᤏᤠᤒᤠᤀᤠᤱ ᤂᤧᤏᤧ᤹ᤀᤥ ᤕᤠᤶᤔᤥ ᤀᤠᤵᤑᤠᤸᤗᤧᤀᤠᤱ ᤂᤧᤶ ᤔᤧᤍᤧᤳᤏᤧᤴᤗᤥ॥","poem":1}]},{"type":"verse","number":23,"content":[{"text":"ᤂᤧᤏᤧ᤹ᤀᤥ ᤕᤠᤶᤔᤥ ᤀᤠᤵᤑᤠᤸᤗᤧᤀᤠᤱ ᤛᤣᤔᤡ ᤔᤧᤀᤥ᤺ᤳᤏᤧᤴᤗᤥ. ᤜᤧᤰᤁᤩᤠᤱ ᤛᤡᤛᤠᤔᤣ᤺ᤳ ᤏᤢ ᤏᤠᤗᤡᤛᤠᤱᤅᤡᤸᤗᤧ ᤂᤢᤴᤇᤡ᤹ ᤀᤡᤰᤗᤠ᤺ᤴᤏᤠᤱ ᤂᤧᤏᤧ᤹ᤀᤥ ᤕᤠᤶᤔᤥ ᤀᤠᤵᤑᤠᤸᤗᤧᤀᤠᤱ ᤂᤧᤶ ᤔᤧᤍᤧᤳᤏᤧᤴᤗᤥ॥ ᤂᤧᤏᤧ᤹ ᤁᤧᤗᤧᤱᤜᤱᤒᤠᤜᤠ᤹ᤃ ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥ ᤔᤢᤰᤛᤠᤶᤛᤠᤒᤠ ᤏᤢ ᤁᤧᤀᤡᤱᤒᤠ ᤁᤧᤎᤢᤶᤒᤠᤜᤠ᤹ ᤔᤧᤘᤕᤧ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤏᤧ᤹ ᤑᤧᤴᤛᤠᤶ ᤔᤢᤴᤎᤢᤶᤗᤠᤶ ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥᤒᤠ ᤁᤠᤰ ᤔᤧᤴᤇᤠᤶ ᤛᤢᤘᤠᤱᤜᤠ᤹ ᤀᤡᤱᤃᤧᤗᤧᤰᤋᤢᤛᤡᤖᤥ॥","poem":1}]},{"type":"verse","number":24,"content":[{"text":"ᤒᤧᤒᤡᤗᤥᤏᤣ. ᤂᤧᤏᤧ᤹ ᤁᤧᤔᤠᤖᤠᤶᤜᤠ᤹ᤀᤥᤀᤣ ᤔᤠᤱᤏᤡᤱᤘᤠ᤹ᤐᤠ᤺ᤴ ᤁᤧᤒᤠ᤺ᤵᤐᤠᤜᤠ᤹. ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤛᤣᤛᤣ ᤁᤢᤔᤏᤠᤜᤠ᤹ ᤏᤢ ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥᤒᤠ ᤁᤠᤰ ᤛᤧᤵᤔᤏᤠᤒᤠ ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤔᤠᤰᤂᤡ᤹ᤀᤡᤴ ᤛᤧ᤺ᤖᤧᤀᤠᤱ ᤘᤕᤧᤖᤥ॥”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/lif_wbt/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lif_wbt/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lif_wbt/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}