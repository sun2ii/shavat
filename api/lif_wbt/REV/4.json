{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"REV","translationId":"lif_wbt","name":"ᤛᤢᤑᤥ","commonName":"ᤛᤢᤑᤥ","title":"ᤕᤢᤜᤢᤴᤏᤠᤖᤧ ᤏᤡ᤺ᤛᤢᤒᤠ ᤛᤢᤑᤥ","order":66,"numberOfChapters":22,"sha256":"fecd46133e75bd47eb645280f500eb8d9e0cf837315af00323d1027d84fbb837","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/lif_wbt/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":4,"content":[{"type":"heading","content":["ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱᤒᤠ ᤜᤠᤱᤕᤢᤰᤏᤠ᤺ᤸᤗᤧᤴ ᤛᤢᤑᤥ"]},{"type":"verse","number":1,"content":["ᤁᤴ ᤀᤣᤃᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱᤅᤥ ᤗᤠᤶᤎᤣ᤺ᤵᤐᤧᤴ ᤜᤸᤗᤧᤰ ᤜᤖᤧᤀᤠᤱ ᤐᤳᤇᤧᤒᤠ ᤏᤡ᤺ᤛᤢᤱᤗᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤋᤃᤡ ᤂᤧᤵᤛᤢᤱᤒᤠ ᤌᤢᤳᤌᤢᤖᤡ᤺ᤵᤐᤠᤸᤗᤧ ᤁᤢᤀᤡᤰᤗᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤕᤠᤶᤔᤥ ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤀᤡᤱᤃᤠ᤹ᤏᤢ ᤐᤠᤖᤧᤖᤥ. “ᤁᤳᤌᤥ ᤌᤠᤅᤧ᤹ᤀᤥ. ᤀᤠᤸᤗ ᤀᤡᤱᤃᤠ᤹ ᤋᤠ᤺ᤴᤍᤡ ᤁᤧᤒᤥ᤺ᤱᤒᤠ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤀᤥ᤺ᤴᤎᤠᤰᤏᤧ᤹ᤖᤥ॥”"]},{"type":"verse","number":2,"content":["ᤂᤡᤔᤥ ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ ᤌᤢᤰᤋᤠᤱ. ᤜᤧᤰᤁᤩᤠᤱ ᤀᤡᤱᤃᤠ᤹ ᤀᤠᤍᤃᤠᤱ ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱᤅᤥᤒᤠ ᤜᤠᤱᤕᤢᤰᤏᤠᤀᤥ ᤁᤧᤕᤢᤱᤒᤠᤎᤡᤰ ᤏᤡ᤺ᤛᤢᤱ."]},{"type":"verse","number":3,"content":["ᤂᤧᤵᤔᤥ ᤁᤧᤕᤢᤱᤒᤠᤸᤗᤧ ᤁᤢᤏᤠᤖᤠ᤺ᤱᤃ ᤁᤧᤀᤥ᤺ᤵᤐᤠ ᤔᤠᤱᤗᤢᤱ ᤏᤢ ᤁᤢᤜᤧ᤺ᤳᤗᤢᤱ. ᤀᤡᤔᤧᤸᤗᤢᤱᤒᤠ ᤗᤢᤱ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤀᤥ᤺ᤳᤋᤧᤖᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤜᤠᤱᤕᤢᤰᤏᤠ᤺ᤸᤗᤧ ᤁᤢᤄᤡᤖᤡ ᤗᤢᤱᤛᤣ᤺ᤰᤁᤢᤶ ᤔᤠᤱᤗᤢᤱ ᤜᤧᤰᤁᤣ ᤁᤧᤗᤧᤰᤐᤠ ᤏᤠᤶᤎᤡᤱᤃᤥ ᤐᤳᤇᤧ॥"]},{"type":"verse","number":4,"content":["ᤜᤠᤱᤕᤢᤰᤏᤠ᤺ᤸᤗᤧ ᤁᤢᤄᤡᤖᤡ ᤏᤧᤳ-ᤗᤡ (᥈᥊) ᤘᤣ᤹ ᤜᤠᤱᤕᤢᤰᤏᤠᤜᤠ᤹ ᤔᤧᤕᤢᤅᤧ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤵᤔᤥ ᤑ᤺ᤃᤧᤗ᤹ᤒᤠ ᤋᤣ᤺ᤳ ᤁᤧᤈᤠᤱᤒᤠ ᤛᤠᤶᤔᤩᤠᤱ ᤋᤡᤆ᤺ ᤁᤧᤄᤢ᤺ᤱᤒᤠ ᤏᤧᤳ-ᤗᤡ ᤋᤢᤶᤗᤠᤶᤗᤥ᤺ᤒᤠᤜᤠ᤹ ᤔᤧᤕᤢᤅᤧᤖᤥ॥"]},{"type":"verse","number":5,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤜᤠᤱᤕᤢᤰᤏᤠᤗᤠᤶ ᤛᤠ᤺ᤶᤓᤣ ᤗᤧᤰᤋᤧ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤵᤔᤥᤗᤠᤶ ᤂᤧᤖᤧᤱ ᤄᤢᤖᤢᤱ ᤗ᤹ᤖᤡᤰ ᤋᤠᤱᤛᤠᤱ ᤁᤧᤗᤥ᤺ᤱᤒᤠ ᤀᤡᤰᤗᤠᤜᤠ᤹ ᤗ᤺ᤴᤍᤧᤖᤥ॥ ᤂᤧᤵᤔᤥ ᤜᤠᤱᤕᤢᤰᤏᤠ᤺ᤸᤗᤧ ᤁᤢᤍᤃᤠᤱ ᤏᤢᤛᤡ ᤛᤣᤔᤡᤜᤠ᤹",{"noteId":4},"ᤔᤧᤍᤡᤖᤧᤖ ᤔᤧᤕᤢᤅᤧ॥ ᤂᤧᤱᤜᤠ᤹ᤃ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤏᤢᤛᤡ ᤁᤢᤛᤣᤛᤣᤔᤠᤱᤛᤡᤖᤥ॥"]},{"type":"verse","number":6,"content":["ᤜᤠᤱᤕᤢᤰᤏᤠ᤺ᤸᤗᤧ ᤁᤢᤍᤃᤠᤱ ᤛᤡᤛᤠ ᤜᤧᤰᤋᤱᤒᤠ ᤘᤜ᤺ᤱ ᤏᤧᤛ᤻ᤛᤧᤖᤥ॥ ᤂᤧᤱᤃ ᤔᤠᤱᤗᤢᤱ ᤜᤧᤰᤁᤣ ᤛᤧᤸᤗᤧᤱ ᤁᤧᤗᤧᤰᤐᤠ ᤆᤥᤃᤧ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤁᤢᤗᤢᤶᤔᤥ. ᤜᤠᤱᤕᤢᤰᤏᤠ᤺ᤸᤗᤧ ᤁᤢᤄᤡᤖᤡ. ᤀᤣᤃᤠᤱ ᤋᤃᤠᤱ ᤁᤠᤰ ᤐᤡᤛᤠᤱ ᤔᤡᤰ ᤀᤡᤛ᤻ᤛᤣ᤺ᤱ ᤁᤧᤒᤵᤐᤠ ᤗᤡᤛᤡ ᤁᤢᤜᤡᤱᤘᤧᤳ ᤐᤠᤌᤢᤱᤛᤠᤜᤠ᤹ ᤔᤧᤕᤧᤒᤧᤖᤥ॥"]},{"type":"verse","number":7,"content":["ᤌᤡᤰᤛᤡᤃᤣ᤺ᤰᤐᤠ ᤁᤢᤜᤡᤱᤘᤧᤳ ᤐᤠᤌᤢᤱᤛᤠ᤺ᤱᤃ ᤌᤡᤖᤡᤱᤒᤠᤴ ᤜᤧᤰᤁᤣ ᤗ᤹ᤖᤧ॥ ᤏᤡᤛᤡᤃᤣ᤺ᤰᤐᤧᤴ ᤐᤡᤳ ᤜᤧᤰᤁᤣ ᤗ᤹ᤖᤧ॥ ᤛᤢᤶᤛᤡᤃᤣ᤺ᤰᤐᤠᤸᤗᤧ ᤁᤢᤏᤠᤖᤠ᤺ᤴ ᤔᤧᤴᤇᤠᤶ ᤕᤠᤵᤔᤡ ᤏᤠᤖᤠ ᤜᤧᤰᤁᤣ ᤗ᤹ᤖᤧ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤗᤡᤛᤡᤃᤣ᤺ᤰᤐᤠᤱᤃ ᤁᤧᤒᤧᤒᤠᤖ ᤁᤧᤒᤵᤐᤠ ᤔᤢᤕᤠ ᤜᤧᤰᤋᤱᤒᤠ ᤆᤥᤃᤧᤖᤥ॥"]},{"type":"verse","number":8,"content":["ᤂᤧᤴ ᤗᤡᤛᤡ ᤁᤢᤜᤡᤱᤘᤧᤳ ᤐᤠᤌᤢᤱᤛᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤌᤰᤁᤥ ᤋᤢᤰᤛᤡ ᤗᤠᤵᤜᤠ᤹ ᤔᤧᤒᤳᤇᤧ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤡ᤹ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤌᤰᤁᤡᤴ ᤏᤢ ᤗᤠᤵᤐᤡᤸᤗᤧ ᤁᤢᤎᤡᤶ ᤁᤠᤰ ᤐᤡᤛᤠᤱ ᤔᤡᤰ ᤀᤡᤛ᤻ᤛᤣ᤺ᤱ ᤐᤳᤇᤧᤖᤥ॥ ᤂᤧᤱᤜᤠ᤹ ᤛᤧᤴᤍᤡᤰ ᤗᤧᤴᤍᤡᤰ ᤆᤰᤔᤧᤸᤗ᤹ᤀᤣ ᤀᤰᤂᤣ ᤔᤧᤒᤠ᤺ᤳᤋᤢᤖ ᤛᤠᤶᤔᤧᤗᤥ᤹᤺. “ᤔᤢᤰᤛᤠᤶᤍᤠᤱᤒᤠ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤛᤣᤛᤣ. ᤛᤣᤛᤣ. ᤛᤣᤛᤣᤒᤠ ᤆᤥ᤺ᤰᤗᤥ॥ ᤂᤢᤏᤧ᤹ ᤀᤢᤏᤠᤜᤢᤖᤡᤀᤥ ᤘᤕᤧ. ᤀᤠᤸᤗᤥᤀᤠᤱ ᤘᤠ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤋᤠ᤺ᤴᤍᤡᤀᤠᤱ ᤋᤠ᤺ᤖᤥ॥”"]},{"type":"verse","number":9,"content":["ᤂᤧᤴ ᤗᤡᤛᤡ ᤁᤢᤜᤡᤱᤘᤧᤳ ᤐᤠᤌᤢᤱᤛᤠᤜᤠ᤹ᤖᤧ ᤛᤍᤠᤍᤡᤱ ᤏᤢ ᤛᤍᤠᤍᤡᤱ ᤁᤧᤘᤠ᤹ᤒᤠᤀᤠᤱ ᤜᤠᤱᤕᤢᤰᤏᤠᤀᤥ ᤁᤧᤕᤢᤱᤒᤠᤴ ᤔᤡᤔᤡᤍᤡᤱ. ᤔᤡᤱᤛᤥ ᤀᤡᤱᤎᤠ᤺ᤱ. ᤏᤢ ᤏᤥᤃᤧᤴᤖᤧᤴ ᤛᤠᤶᤗᤥ᤺ᤴ ᤛᤠᤶᤔᤧᤔᤧᤳᤋᤢᤸᤗᤧ"]},{"type":"verse","number":10,"content":["ᤂᤧᤴ ᤏᤧᤳ-ᤗᤡ (᥈᥊) ᤋᤢᤶᤗᤠᤶᤗᤥ᤺ᤒᤠᤜᤠ᤹ᤖᤧ ᤛᤠᤶᤒᤥ᤺ᤴ ᤔᤧᤓᤴᤇᤡᤱᤗ ᤛᤍᤠᤍᤡᤱ ᤏᤢ ᤛᤍᤠᤍᤡᤱ ᤁᤧᤘᤠ᤹ᤒᤠᤀᤠᤱ ᤜᤠᤱᤕᤢᤰᤏᤠᤀᤥ ᤁᤧᤕᤢᤱᤒᤠᤴ ᤛᤣᤘᤠ ᤔᤧᤈᤥᤃᤢ᤹ᤖᤥ॥ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤋᤡᤆ᤺ᤴ ᤜᤠᤱᤕᤢᤰᤏᤠ᤺ᤸᤗᤧ ᤁᤢᤍᤃᤠᤱ ᤔᤧᤏᤧᤛ᤻ᤛᤢᤖ ᤀᤰᤂᤣ ᤔᤧᤒᤠ᤺ᤳᤋᤢ᤹ᤖᤥ."]},{"type":"verse","number":11,"content":[{"text":"“ᤂᤧᤏᤧ᤹ᤃ ᤀᤠᤏᤡᤃᤧ ᤍᤠᤱᤒᤠ ᤏᤢ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤏᤧ᤹ᤖᤥ॥","poem":1},{"lineBreak":true},{"text":"ᤂᤧᤏᤧ᤹ᤃ ᤔᤡᤔᤡᤍᤡᤱ ᤏᤢ ᤔᤡᤱᤛᤥ ᤀᤡᤱᤎᤠ᤺ᤱ","poem":1},{"lineBreak":true},{"text":"ᤜᤧᤰᤁᤩᤠᤱ ᤔᤢᤰᤛᤠᤶᤖᤧᤴ ᤏᤠᤖᤠ ᤑᤥ᤺ᤛᤢᤶᤒᤧᤒᤠ ᤀᤠᤏᤡᤃᤧ ᤛᤣᤘᤠᤃᤧᤴ ᤛᤠᤶᤗᤥ᤺ᤴ ᤋᤠ᤺ᤰᤔᤠ ᤛᤢᤶᤒᤥᤎᤠᤛᤠᤒᤠ ᤁᤧᤈᤥ᤺ᤰᤗᤥ.","poem":1},{"lineBreak":true},{"text":"ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤧᤏᤧ᤹ᤃ ᤁᤠᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤏᤠᤘᤠᤃᤧᤴ ᤆᤀᤡ᤺ᤳ ᤁᤧᤈᤥᤃᤢ. ᤜᤧᤰᤁᤩᤠᤱ ᤛᤡᤰᤁᤢᤶᤍᤡᤱ ᤁᤧᤏᤡᤱᤘᤠ᤹ᤗᤠᤶ ᤂᤧᤱᤜᤠ᤹ ᤔᤧᤒᤥ᤺ᤰᤂᤣ. ᤜᤧᤰᤁᤩᤠᤱ ᤜᤡᤱᤔᤴ ᤁᤧᤒᤡᤖᤢᤛᤡᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥”","poem":1}]}],"footnotes":[{"noteId":4,"caller":"*","text":"ᤏᤢᤛᤡ ᤛᤣᤔᤡᤜᤠ᤹–ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤴ ᤀᤥᤛᤣ᤺ᤴᤎᤠᤰᤔᤠ ᤔᤡᤰᤛᤣ᤺ᤴ॥","reference":{"chapter":4,"verse":5}}]},"thisChapterLink":"/api/lif_wbt/REV/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lif_wbt/REV/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lif_wbt/REV/3.json","previousChapterAudioLinks":{},"numberOfVerses":11}