᤹ᤖᤥ॥”"]}],"footnotes":[]},"thisChapterLink":"/api/lif_wbt/REV/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lif_wbt/REV/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lif_wbt/REV/7.json","previousChapterAudioLinks":{},"numberOfVerses":13}