nt":["ᤂᤡᤏᤡ᤹ᤀᤠᤱ ᤂᤧᤱᤜᤠ᤹ᤏᤢᤀᤣ ᤕᤧᤛᤢ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤁᤢᤀᤡᤱᤈᤠ᤺ᤱ ᤁᤧᤀᤡ᤺ᤵᤐᤠ ᤁᤧᤏᤠ᤺ᤵᤐᤠ ᤁᤢᤔᤏᤠ ᤐᤥ᤺ᤱᤛᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤧᤀᤢ᤺ᤳᤋᤡᤀᤠᤱ ᤁᤧᤘᤕᤡ᤹ᤖᤥ॥"]},{"type":"verse","number":7,"content":["ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤛᤠ᤹ᤖᤡᤰ ᤔᤡ᤺ᤶᤈᤡ ᤁᤧᤔᤧᤳᤋᤡ᤹ᤀᤠᤱ ᤀᤠᤒᤠᤅᤣ ᤁᤢᤛᤣᤛᤣ ᤔᤏᤠ ᤐᤥ᤺ᤱᤛᤧ ᤁᤧᤀᤢ᤺ᤳᤋᤡᤒᤠ ᤖᤥᤔ",{"noteId":0},"ᤕᤧᤰᤕᤰᤁᤥᤒᤠ ᤀᤠᤔᤡ᤺ᤶ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤛᤣ. ᤀᤠᤏᤡ᤹ ᤐᤠᤏᤢᤍᤡᤱ ᤐᤠ᤺ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱ ᤏᤢ ᤍᤠᤱᤒᤠ ᤕᤧᤛᤢ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤜᤠᤖᤠ᤹ ᤗᤢᤱᤃᤢᤶ ᤏᤢ ᤛᤏᤠᤖᤢᤱ ᤁᤧᤒᤡᤖᤡᤖᤖᤥ॥"]},{"type":"heading","content":["ᤐᤠᤘᤗᤖᤧ ᤖᤥᤔ ᤕᤧᤰᤕᤰᤁᤥ ᤐᤣ᤺ᤰᤔᤠ ᤏᤡᤱᤘᤠ᤹ ᤆᤥᤃᤢ᤹"]},{"type":"verse","number":8,"content":["ᤁᤠᤰᤏᤢ᤺ᤸᤗᤧ ᤋᤃᤡ ᤂᤡᤏᤡ᤹ ᤁᤧᤖᤧᤰᤗᤧ ᤗᤠᤃᤡ ᤛᤣᤘᤠ ᤆᤥᤃᤢᤱᤒᤠ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤕᤧᤛᤢ ᤂᤪᤡᤛ᤻ᤋᤗᤠᤶᤒᤠ ᤏᤥᤃᤧᤴ ᤐᤡᤖᤢᤱᤗᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤥ ᤁᤧᤘᤠ᤹ᤒᤠ ᤂᤡᤏᤡ᤹ ᤏᤛᤠ᤺ᤴᤏᤡᤸᤗᤧ ᤁᤢᤕᤠ᤺ᤶᤒᤣᤀᤥᤒᤠ ᤀᤡᤱᤄᤱᤅᤡᤴ ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤥ ᤁᤠᤰ ᤐᤡᤛᤠᤱ ᤛᤧ᤺ᤖᤧᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":9,"content":["ᤂᤢᤏᤧ᤹ ᤁᤢᤛ᤻ᤛᤠ᤺ᤸᤗᤧ ᤁᤢᤕᤠ᤺ᤶᤒᤣᤀᤥ ᤛᤢᤏᤠᤀᤡᤱ ᤀᤡᤱᤓᤥ᤺ᤛᤢᤱᤗ ᤁᤧᤖᤧᤰ ᤀᤠᤏᤡᤱᤘᤠ᤹ᤗᤠᤶᤒᤠ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤛᤣᤘᤠ ᤆᤥᤃᤢᤱᤗᤥ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ᤀᤣ ᤂᤡᤏᤡ᤹ ᤗᤠᤃᤡ ᤀᤧᤳᤗᤧᤱ ᤋᤢᤘᤠ ᤆᤥᤃᤢᤱᤒᤠᤴ ᤏᤡ᤺ᤛᤢᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":10,"content":["ᤛᤍᤠᤍᤡᤱ ᤀᤡᤱᤃᤠ᤹ ᤆᤥᤃᤢᤱᤒᤠ ᤋᤢᤘᤠᤀᤥ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤏᤡᤱᤘᤠ᤹ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤀᤠᤰᤂᤣᤗ᤹ᤖᤡᤰᤛᤠᤱ ᤗᤠᤶ ᤂᤥ᤺ᤛᤢᤱᤅᤠᤱ ᤂᤡᤏᤡ᤹ᤀᤥ ᤋᤠ᤺ᤔᤠ ᤛᤢᤰᤁᤠᤖ ᤑᤠ᤹ᤀᤠᤱ ᤐᤣᤗᤡᤃᤧᤴ ᤋᤢᤘᤠ ᤆᤥ᤺ᤰᤁᤠᤖᤥ॥"]},{"type":"verse","number":11,"content":["ᤀᤡᤱᤃᤠ᤹ ᤂᤡᤏᤡ᤹ ᤏᤛᤠ᤺ᤴᤏᤥ ᤁᤧᤎᤢᤶᤒᤠ ᤆᤥ᤺ᤰᤛᤧ ᤕᤠᤶᤛᤠᤶᤃᤧᤴ ᤐᤷᤎᤠ᤺ᤶᤔᤡᤴ ᤂᤡᤏᤡ᤹ᤏᤢ ᤜᤠ᤺ᤔᤠ ᤑᤠ᤹ᤀᤠᤱ ᤛᤠ᤹ᤖᤡᤰᤁᤣ ᤂᤡᤏᤡ᤹ᤏᤢ ᤋᤢᤶᤔᤠ ᤏᤡᤱᤘᤠ᤹ ᤆᤥᤃᤢᤱᤅᤠᤱ ᤘᤠ᤹ᤀᤠᤖᤥ॥"]},{"type":"verse","number":12,"content":["ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤀᤠᤏᤡ᤹ ᤁᤧᤖᤧᤰᤗᤧ ᤏᤛᤠ᤺ᤴᤗᤠᤶᤒᤠ ᤜᤠᤱᤜᤠᤱ ᤀᤠᤔᤧᤳᤇᤡᤱᤗᤥ॥"]},{"type":"verse","number":13,"content":["ᤀᤠᤔᤡ᤺ᤶ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤛᤣ. ᤂᤡᤏᤡ᤹ᤀᤥ ᤋᤠ᤺ᤔᤠ ᤕᤖᤡᤰᤗᤧᤱ ᤏᤡᤱᤘᤠ᤹ ᤆᤥᤃᤢᤱ. ᤁᤖ ᤀᤠᤸᤗᤥ ᤌᤠᤖᤡᤰ ᤋᤠ᤺ᤔᤠ ᤔᤧᤴᤇᤢᤰᤐᤧᤴ ᤁᤧᤗ᤹ᤒᤠᤴ ᤏᤡᤱᤘᤠ᤹ ᤂᤥ᤺ᤛᤧᤶᤔᤧ᤹ ᤁᤧᤗ᤹ᤒᤠ ᤏᤡᤱᤘᤠ᤹ ᤀᤡ᤺ᤳᤋᤢᤱᤗᤥ॥ ᤀᤡᤱᤃᤠ᤹ ᤘᤣ᤹ ᤌᤡᤶᤔᤧᤴᤍᤱ ᤛᤢᤘᤠᤱᤜᤠ᤹ ᤂᤪᤡᤛ᤻ᤋᤀᤥ ᤋᤠᤖᤢᤱᤛᤡᤱᤒᤠ ᤜᤧᤰᤁᤣ ᤂᤡᤏᤡ᤹ᤀᤥᤗᤠᤶᤔᤠᤱ ᤕᤖᤡᤰ ᤔᤏᤠᤜᤠ᤹ ᤋᤠ᤺ᤵᤔᤠᤛᤡ ᤀᤠᤏᤡᤱᤘᤠ᤹ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":14,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ᤃ ᤂᤠᤛᤠᤶᤒᤠᤜᤠ᤹ ᤏᤢ ᤂᤠᤛᤠᤶ ᤔᤧ᤺ᤶᤒᤠᤜᤠ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤛᤡᤰᤁᤢᤶᤛᤠᤒᤠᤜᤠ᤹ ᤏᤢ ᤛᤎ᤺ᤰᤐᤠᤜᤠ᤹. ᤁᤧᤖᤧᤰᤗᤧ ᤗᤠᤃᤡ ᤛᤢᤏᤠᤀᤡᤱ ᤀᤡᤱᤓᤥ᤺ᤔᤠᤀᤣ ᤐᤥ᤺ᤱᤗᤥ॥"]},{"type":"verse","number":15,"content":["ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤂᤡᤏᤡ᤹ ᤖᤥᤶᤔᤥ ᤁᤧᤘᤠ᤹ᤒᤠᤜᤠ᤹ᤀᤠᤱ ᤛᤢᤏᤠᤀᤡᤱ ᤀᤡᤱᤓᤥ᤺ᤔᤠᤏᤡᤱ ᤛᤠ᤹ᤖᤡᤰ ᤀᤠᤛᤡᤰ ᤛᤔᤧᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":16,"content":["ᤁᤴ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤁᤢᤛᤢᤏᤠᤀᤡᤱᤅᤡᤴ ᤀᤡᤱᤓᤥ᤺ᤔᤠ ᤔᤧᤏᤢ᤺ᤴᤏᤠᤴᤗᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤁᤴ ᤛᤢᤏᤠᤀᤡᤱᤅᤡᤴ ᤏᤛᤠ᤺ᤴ ᤁᤧᤈᤥ᤺ᤰᤐᤠ ᤁᤠᤰ ᤔᤏᤠᤜᤠ᤹. ᤋᤃᤡ ᤕᤜᤢᤍᤡᤜᤠ᤹",{"noteId":1},"ᤜᤧᤰᤁᤩᤠᤱ ᤕᤠᤱᤛᤡ ᤌᤡᤶᤔᤧᤴᤍᤱ ᤛᤢᤘᤠᤱᤜᤠ᤹ ᤋᤠᤱᤛᤧ᤺ᤵᤔᤠᤛᤡ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤔᤢᤰᤛᤠᤶᤗᤥ॥"]},{"type":"verse","number":17,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤏᤡ᤺ᤔᤠᤀᤥ ᤀᤠᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤀᤠᤵᤋᤡᤰ ᤔᤧ᤺ᤴᤏᤣᤒᤠ ᤀᤠᤈᤥ᤺ᤰ ᤑᤠ᤹ᤀᤠᤱ ᤁᤴ ᤛᤢᤏᤠᤀᤡᤱᤅᤡᤸᤗᤧ ᤀᤥᤛᤣ᤺ᤴᤀᤠᤎᤠᤰᤗᤥ. ᤜᤧᤰᤁᤩᤠᤱ ᤁᤱᤃ ᤏᤛᤠ᤺ᤴᤗᤠᤶ ᤜᤣ᤺ᤰᤛᤡᤱᤅᤠᤱ ᤏᤛᤠ᤺ᤴᤗᤠᤶᤒᤠᤀᤣ ᤁᤢᤗᤡᤱᤎᤥ ᤁᤧᤳᤗᤥ॥ ᤛᤠᤶᤕᤥᤛᤠᤵᤗᤠᤀᤥ ᤀᤰᤂᤣᤗ᤹ᤖᤡᤰ ᤛᤠᤵᤋᤧᤀᤠᤱ ᤐᤳ. “ᤛᤠᤶᤕᤥᤏᤡᤒᤠᤱᤃ ᤏᤛᤠ᤺ᤶᤗᤠᤶᤒᤠᤀᤣ ᤜᤡᤱᤗᤥ॥”",{"noteId":2}]},{"type":"heading","content":["ᤗᤠᤕᤥ᤺ᤸᤗᤧ ᤁᤢᤍᤰᤗᤧᤱᤘᤠᤀᤥ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤛᤠᤰᤁᤧᤴ"]},{"type":"verse","number":18,"content":["ᤛᤠᤱᤃᤪᤠᤶᤐᤣᤍᤠᤱᤗᤠᤶ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤛᤠᤰᤁᤧᤴᤏᤡᤴ ᤗᤠᤕᤥᤒᤠ ᤏᤢ ᤑᤧᤴ ᤕᤠ᤺ᤶᤒᤰᤁᤡᤸᤗᤧ ᤁᤢᤎᤡᤶᤒᤠ ᤁᤧᤖᤧᤰ ᤔᤧᤴᤇᤠᤶ ᤕᤠᤵᤔᤡ ᤛᤶᤍᤠᤱ ᤆᤢᤰᤋᤧᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥ ᤜᤠᤒᤠ ᤁᤴ ᤔᤏᤠᤜᤠ᤹ᤖᤧᤀᤣ ᤂᤢᤏᤡ᤹ ᤋᤠᤵᤑᤧ᤺ᤶᤒᤠ ᤕᤠ᤺ᤶᤒᤰᤁᤡᤸᤗᤧ ᤛᤧᤰᤂᤠ᤺ᤴ ᤌᤣ᤺ᤰᤋᤢᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":19,"content":["ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤂᤧᤱᤜᤠ᤹ ᤂᤢᤶᤍᤡᤱ ᤐᤡᤖᤢᤛᤡ᤹ᤖᤥ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤕᤠ᤺ᤶᤒᤣᤀᤥ ᤁᤢᤛᤡᤱ ᤏᤡ᤺ᤵᤔᤠ ᤁᤧᤒᤥ᤺ᤱᤒᤠ ᤁᤠᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ᤃ ᤀᤠᤒᤠᤅᤣ ᤂᤧᤱᤜᤠ᤹ ᤀᤥᤛᤣ᤺ᤴᤎᤠᤰᤋᤢᤛᤡᤀᤠᤱ ᤘᤠ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤏᤢ᤺ᤖᤡᤰᤁᤠᤱ ᤁᤢᤛᤡᤱ ᤔᤧᤏᤡ᤺ᤳᤋᤢᤀᤠᤱ ᤔᤧᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":20,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤀᤡᤰᤛᤠᤍᤡᤱ ᤂᤠᤶᤒᤣ᤺ᤰᤔᤠᤸᤗᤧ ᤏᤠᤘᤠᤃᤧᤴ ᤆᤀᤡ᤺ᤳ ᤐᤥ᤺ᤰᤂᤧᤀᤠᤱᤎᤥᤀᤣ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤏᤡ᤺ᤔᤧᤴᤍᤧᤵᤔᤏᤠᤒᤠ ᤁᤢᤛᤢᤶᤒᤥ᤺ᤴ–ᤔᤧᤴᤏᤢᤵᤔᤏᤠᤒᤠ ᤁᤢᤔᤢᤰᤛᤠᤶ ᤏᤢ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤃᤧᤴ ᤏᤥᤛᤪᤱᤅᤡᤴ–ᤏᤢ᤺ᤖᤡᤰᤁᤠᤱ ᤏᤡ᤺ᤍᤧᤳᤗᤥ॥ ᤂᤧᤱᤜᤠ᤹ᤃ ᤏᤠᤘᤠᤃᤧᤴ ᤆᤀᤡ᤺ᤳ ᤐᤥ᤺ᤰᤂᤧᤒᤠ ᤐᤠ᤺ᤴᤜᤠ᤹ᤗᤠᤶᤔᤣ ᤏᤢ᤺ᤖᤡᤰᤁᤠᤱ ᤁᤢᤛᤡᤱ ᤏᤡ᤺ᤳᤋᤧᤳᤋᤧᤀᤠᤅ ᤘᤠ᤹ᤖᤥ॥ ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤔᤧᤴᤇᤠᤶ ᤕᤠᤵᤔᤡᤜᤠ᤹ᤖᤧ ᤔᤧᤴᤏᤡ᤺ᤔᤏᤠ ᤗᤠᤶᤛᤡᤱᤔᤠ ᤐᤠ᤺ᤴ ᤌᤣᤀᤠᤱ ᤜᤥ᤺ᤵᤗᤥ॥"]},{"type":"verse","number":21,"content":["ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤁᤢᤛᤡᤱ ᤔᤧᤏᤡ᤺ᤳᤋᤢᤛᤠᤱ ᤂᤢᤏᤧ᤹ ᤐᤡᤔᤠ ᤁᤧᤒᤥ᤺ᤱᤒᤠ ᤔᤡᤱᤛᤥ ᤀᤡᤱᤎᤠ᤺ᤱ ᤔᤧᤶᤒᤡᤖᤢᤴ ᤜᤧᤰᤁᤩᤠᤱ ᤏᤥᤃᤧᤴᤏᤠᤱ ᤔᤧᤶᤒᤡᤖᤢᤴᤗᤥ॥ ᤁᤖ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤀᤡ᤺ᤳᤇᤡᤱᤛᤠᤶᤔᤡᤴ ᤑᤧ᤺ᤳᤗᤠ᤹ᤖᤧ ᤐᤣᤖᤥ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤡ᤹ ᤀᤍᤱ ᤏᤡᤱᤘᤠ᤹ᤀᤡᤴ ᤂᤠᤍᤠᤵᤋᤢᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":22,"content":["ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤀᤠᤏᤡᤃᤧ ᤛᤡᤰᤁᤢᤶᤛᤠᤒᤠ ᤘᤕᤡᤃᤧ ᤔᤧᤗ᤹ᤛᤠᤱ ᤂᤧᤱᤜᤠ᤹ᤃ ᤀᤍᤱ ᤔᤧᤒᤥ᤺ᤰᤂᤧᤖᤥ॥"]},{"type":"verse","number":23,"content":["ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤀᤠᤈᤢᤏᤡᤒᤠ ᤔᤡᤔᤡᤍᤡᤱᤃᤧᤴ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤛᤣᤘᤠ ᤆᤥ᤺ᤰᤔᤠᤸᤗᤧ ᤁᤢᤗᤧᤰᤘᤠ ᤁᤧᤛᤡ᤺ᤒᤠ ᤁᤧᤒᤣ᤺ᤰᤐᤠ ᤔᤧᤴᤇᤠᤶ ᤕᤠᤵᤔᤡ. ᤌᤰᤛᤠ. ᤐᤢᤛᤠ ᤏᤢ ᤁᤧᤛ᤺ᤴᤇᤡᤱᤒᤠ ᤌᤰᤛᤠᤜᤠ᤹ ᤜᤧᤰᤋᤱᤒᤠ ᤏᤠᤘᤠᤀᤡᤳᤗᤠ᤺ᤴ ᤛᤣᤘᤠ ᤔᤧᤈᤥᤃᤢᤖᤥ॥"]},{"type":"verse","number":24,"content":["ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤂᤧᤱᤜᤠ᤹ ᤂᤢᤏᤡ᤹ ᤀᤠᤒᤠᤅᤣ ᤏᤡᤱᤘᤠ᤹ᤒᤠᤸᤗᤧ ᤁᤥ᤺ᤳᤋᤢᤒᤠ ᤛᤡᤰᤁᤧᤗᤧ᤺ᤱᤒᤠ ᤕᤠᤰᤏᤠᤶᤔᤥᤀᤣ ᤘᤠ᤹ᤔᤠ ᤐᤠᤱᤄᤢᤛᤡ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤡ᤹ ᤀᤠᤒᤠᤅᤣ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤌᤰᤁᤥ ᤛᤡᤖᤡᤱ ᤔ᤺ᤔᤠ ᤕᤠ᤺ᤶᤒᤰ ᤔᤧᤈᤥ᤺ᤰᤛᤡᤱᤗᤥ॥"]},{"type":"verse","number":25,"content":["ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤛᤧᤰᤂᤠ᤺ᤴ ᤏᤛᤠ᤺ᤴ ᤆᤥ᤺ᤰᤔᤠᤸᤗᤧ ᤁᤢᤗᤧᤰᤘᤠ ᤏᤡ᤺ᤏᤡ᤺ᤒᤠᤀᤣ ᤀᤡᤱᤗᤧᤰᤐᤠ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤏᤛᤠ᤺ᤴ ᤔᤧᤈᤥᤃᤢᤖᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤏᤠᤘᤠᤃᤧᤴ ᤆᤀᤡ᤺ᤳ ᤁᤧᤏᤧᤒᤠ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤗᤧᤰᤘᤠ ᤏᤠᤘᤠᤃᤧᤴ ᤆᤀᤡ᤺ᤳᤋᤡᤴ ᤛᤣᤘᤠ ᤔᤧᤈᤥᤃᤢᤖᤥ॥ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤱᤃ ᤛᤍᤠᤍᤡᤱ ᤏᤧᤶᤓᤥᤃᤧᤴ ᤏᤠᤖᤠ ᤑᤥ᤺ᤔᤠ ᤗᤠ᤹ᤖᤢᤖᤥ॥ ᤀᤠᤔᤧᤴ॥"]},{"type":"verse","number":26,"content":["ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤂᤧᤱᤜᤠ᤹ ᤛᤡᤖᤡᤱ ᤀᤠᤔ᤺ᤒᤠ ᤕᤠᤶᤒᤥ᤺ᤵᤔᤠ ᤏᤡᤱᤘᤠ᤹ᤀᤥ ᤗᤧᤖᤢᤛᤡᤖᤥ॥ ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤔᤧᤴᤇᤢᤔᤠᤜᤠ᤹ᤖᤧᤀᤠᤱ ᤁᤧᤒᤥ᤺ᤱᤒᤠ ᤁᤧᤕᤢ᤺ᤒᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤕᤧᤶᤒᤡᤳᤇᤠ᤹ᤜᤠ᤹ᤏᤢ ᤀᤡᤶᤔᤠᤸᤗᤧ ᤁᤢᤗᤧᤰᤘᤠ ᤔᤧᤴᤇᤢᤔᤠᤜᤠ᤹ᤏᤢᤀᤣ ᤑᤧᤴ ᤕᤠ᤺ᤶᤒᤰ ᤔᤧᤈᤥᤃᤢ॥"]},{"type":"verse","number":27,"content":["ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰ ᤕᤧᤶᤒᤡᤳᤇᤠ᤹ᤜᤠ᤹ᤖᤧᤀᤠᤱ ᤁᤧᤒᤥ᤺ᤱᤒᤠ ᤁᤧᤕᤢ᤺ᤒᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤔᤧᤴᤇᤢᤔᤠᤜᤠ᤹ᤏᤢ ᤀᤡᤶᤔᤠᤸᤗᤧ ᤁᤢᤗᤧᤰᤘᤠ ᤘᤣ᤹ ᤕᤧᤶᤒᤡᤳᤇᤠ᤹ᤜᤠ᤹ᤏᤢ ᤕᤠᤶᤒᤥ᤺ᤵᤔᤠ ᤏᤡᤱᤘᤠ᤹ᤀᤡᤸᤗᤧ ᤕᤠ᤺ᤴᤍᤢᤛᤡᤀᤠᤱ ᤋᤠᤵᤑᤧ᤺ᤶᤒᤠ ᤕᤠ᤺ᤶᤒᤰ ᤔᤧᤈᤥᤃᤢᤖᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤱᤜᤠ᤹ᤖᤧᤃ ᤔᤧᤈᤥᤃᤢᤒᤠ ᤂᤧᤴ ᤋᤠᤵᤑᤧ᤺ᤶᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤸᤗᤧᤴ ᤂᤢᤶᤍᤡᤱ ᤀᤠᤒᤠᤅᤣ ᤌᤰᤁᤥ ᤔᤧᤄᤥ᤺ᤛᤢᤖᤥ॥"]},{"type":"verse","number":28,"content":["ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤕᤠ᤺ᤶᤒᤣᤀᤥ ᤔᤧᤏᤡ᤺ᤛᤢ ᤔᤧᤎᤠ᤺ᤛᤢᤒᤠ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤔᤧᤏᤠ᤹ᤖᤢᤒᤠᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤂᤢᤏᤧ᤹ ᤂᤧᤱᤜᤠ᤹ ᤑᤧᤴ ᤏᤡᤱᤘᤠ᤹ᤀᤥ ᤗᤧᤖᤢᤛᤡᤖᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤆᤥ᤺ᤰᤔᤠ ᤔᤧᤴᤏᤢ᤹ᤔᤏᤠ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤔᤧᤈᤥᤃᤢᤖᤥ॥"]},{"type":"verse","number":29,"content":["ᤂᤧᤱᤜᤠ᤹ ᤁᤠᤰ ᤐᤖᤡᤰᤐᤠ ᤁᤢᤀᤡᤓᤧᤶᤔᤠ. ᤑᤧᤴ ᤏᤡᤱᤘᤠ᤹. ᤂᤡ᤺ᤶᤔᤠ ᤜᤧᤰᤁᤩᤠᤱ ᤆᤡ᤺ᤳᤇᤡᤱᤔᤠ. ᤏᤠᤜᤧᤶᤔᤠ. ᤔᤏᤠ ᤛᤧᤵᤔᤠ. ᤂᤣᤔᤠ ᤌᤰᤔᤠ. ᤀᤡᤱᤗᤧᤰᤔᤠ. ᤔᤏᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤏᤡᤱᤘᤠ᤹ ᤋᤢᤰᤗ ᤆᤥ᤺ᤰᤔᤠ ᤐᤠ᤺ᤴᤜᤠ᤹ᤖᤰ ᤔᤧᤀᤡ᤺ᤳᤋᤢ᤹ᤖᤥ॥ ᤜᤧᤰᤁᤩᤠᤱ ᤂᤧᤱᤜᤠ᤹ ᤔᤏᤠ ᤁᤧᤈᤧᤱᤒᤠ."]},{"type":"verse","number":30,"content":["ᤔᤏᤠ ᤆᤠ᤺ᤳᤌᤡ ᤁᤧᤍᤣ᤺ᤒᤠ. ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤁᤧᤈᤡ᤺ᤵᤐᤠ. ᤔᤏᤠ ᤋᤠᤵᤑᤧ᤺ᤸᤗᤡᤰ ᤁᤧᤔᤧᤵᤐᤠ. ᤀᤠᤱᤍᤡᤱ ᤁᤧᤗ᤹ᤒᤠ ᤜᤧᤰᤁᤩᤠᤱ ᤁᤧᤜᤧᤴᤇᤡᤱᤒᤠ ᤔᤧᤒᤥ᤺ᤰᤂᤧᤀᤠᤱ ᤔᤧᤘᤠ᤹ᤖᤥ॥ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤑᤧᤴ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤆᤥ᤺ᤰᤔᤠ ᤁᤢᤛᤱ ᤗᤠᤶ ᤔᤧᤃᤥ᤺ᤳᤋᤢ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤔᤠᤒᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤐᤠ᤺ᤴ ᤔᤧᤱᤄᤧᤵᤛᤢᤴ॥"]},{"type":"verse","number":31,"content":["ᤂᤧᤱᤜᤠ᤹ ᤀᤍᤱ ᤔᤧᤈᤥ᤺ᤰ. ᤔᤧᤈᤥᤃᤢᤒᤠ ᤔᤠᤱᤜᤧᤰᤜᤠ᤹ ᤔᤧᤱᤃᤧᤳᤋᤢᤴ. ᤔᤏᤠᤜᤠ᤹ ᤗᤢᤱᤔᤠ᤹ ᤔᤧᤴᤍᤢᤰᤋᤢᤴᤇᤡᤴ. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤡ᤹ ᤗᤢᤱᤔᤠ᤹ ᤛᤩᤠ᤺ᤳ ᤔᤧᤗ᤹ᤏᤧᤴᤗᤥ॥"]},{"type":"verse","number":32,"content":["ᤀᤰᤋᤱᤒᤠ ᤕᤠ᤺ᤶᤒᤰ ᤁᤧᤈᤥ᤺ᤰᤐᤠᤜᤠ᤹ᤃ ᤛᤡ᤺ᤔᤧᤸᤗᤧᤴ ᤂᤢᤶᤍᤡᤱ ᤂᤥ᤺ᤔᤠ ᤗᤠ