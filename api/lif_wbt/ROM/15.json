᤺ᤛᤢ᤹.","poem":1},{"lineBreak":true},{"text":"ᤜᤧᤰᤁᤩᤠᤱ ᤂᤢᤏᤧ᤹ ᤁᤢᤕᤠ᤺ᤶᤒᤣᤀᤥ ᤔᤧᤱᤄᤧᤶᤔᤣ ᤁᤧᤘᤠ᤹ᤒᤠᤜᤠ᤹ᤖᤧ ᤁᤢᤛᤡᤱ ᤔᤧᤏᤡ᤺ᤳᤋᤢ᤹ᤖᤥ॥”","poem":1},{"noteId":59}]},{"type":"heading","content":["ᤐᤠᤘᤗᤖᤧ ᤖᤥᤔ ᤐᤣ᤺ᤰᤔᤠ ᤏᤡᤱᤘᤠ᤹ ᤆᤥᤃᤢ᤹"]},{"type":"verse","number":22,"content":["ᤒᤠ ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ ᤘᤣ᤹ ᤋᤧᤴᤏᤥ ᤂᤪᤡᤛ᤻ᤋᤧᤴ ᤀᤡᤱᤓᤥ᤺ᤛᤢᤱᤒᤠᤸᤗᤧ ᤂᤡᤏᤡ᤹ᤀᤥ ᤋᤠ᤺ᤔᤠ ᤔᤧᤴᤇᤢᤰᤁᤣ ᤘᤠ᤹ᤀᤠᤖᤥ॥"]},{"type":"verse","number":23,"content":["ᤁᤖ ᤁᤴ ᤌᤢᤶᤔᤥ ᤁᤠᤰ ᤐᤡᤛᤠᤱ ᤛᤢᤏᤠᤀᤡᤱ ᤀᤡᤱᤓᤥ᤺ᤔᤠ ᤕᤠ᤺ᤶᤒᤰᤜᤠ᤹ ᤆᤥᤃᤢᤱ ᤛᤢᤖᤢᤱᤅᤠᤱ ᤘᤠ᤹ᤀᤠ. ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤸᤗ ᤕᤖᤡᤰ ᤋᤱᤒᤣᤀᤠᤱᤎᤥ ᤂᤡᤏᤡ᤹ᤀᤥ ᤋᤠ᤺ᤔᤠ ᤏᤡᤱᤘᤠ᤹ ᤆᤥᤃᤢᤱᤒᤠᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ."]},{"type":"verse","number":24,"content":["ᤀᤡᤱᤃᤠ᤹ ᤀᤡᤛ᤻ᤐᤧᤏ ᤗᤠᤈᤣ᤹ ᤐᤣ᤺ᤰᤁᤠᤸᤗᤧ ᤂᤡᤏᤡ᤹ ᤋᤢᤶᤛᤧ ᤖᤥᤔ ᤕᤧᤰᤕᤰᤁᤥ ᤗ᤺ᤶᤔᤠ ᤋᤠ᤺ᤔᤠ ᤀᤠᤏᤡᤱᤘᤠ᤹ ᤘᤠ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤡᤏᤡ᤹ᤏᤢ ᤁᤢᤓᤠ ᤕᤧᤴ ᤛ᤺ᤳᤋᤠᤖ ᤘᤠ᤹ᤀᤠᤀᤠᤱ ᤐᤣ᤺ᤰᤁᤠᤀᤡᤸᤗᤧ ᤕᤠᤶᤔᤥ ᤀᤠᤗᤠᤶᤍᤡ᤺ᤰᤁᤥ ᤁᤢᤓᤠ᤹ ᤕᤠᤵᤔᤡ ᤁᤧᤒᤡᤖᤡ᤹ ᤁᤧᤗ᤹ᤒᤠ ᤏᤡᤱᤘᤠ᤹ ᤆᤥᤃᤢᤱᤅᤠᤱ ᤘᤠ᤹ᤀᤠᤖᤥ॥"]},{"type":"verse","number":25,"content":["ᤁᤖ ᤀᤠᤸᤗ ᤕᤖᤢᤛᤗᤧᤶᤔᤥᤒᤠ ᤕᤠᤱᤃᤧᤛᤠ᤹ᤒᤠ ᤏᤛᤠᤏᤡᤒᤠᤜᤠ᤹ᤖᤧ ᤗᤠᤃᤡ ᤀᤰᤂᤤᤕᤠ ᤏᤢ ᤔᤧᤛᤣᤍᤥᤏᤡᤕᤠ ᤌᤢᤶᤔᤥᤒᤠ ᤏᤛᤠᤏᤡᤒᤠᤜᤠ᤹ᤖᤧ ᤔᤧᤛᤢᤵᤛᤢᤒᤠ ᤑᤠ᤹ᤕᤠᤱᤅᤡᤴ ᤛᤠ᤺ᤛᤧ ᤀᤡᤱᤃᤠ᤹ ᤕᤖᤢᤛᤗᤧᤔ ᤐᤣ᤺ᤰᤁᤠᤖ ᤐᤳᤋᤠᤖᤥ॥"]},{"type":"verse","number":27,"content":["ᤂᤧᤱᤜᤠ᤹ᤖᤧᤃ ᤀᤰᤂᤣ ᤆᤥ᤺ᤰᤔᤠ ᤂᤢᤏᤡ᤹ ᤛᤡᤖᤠ᤹ ᤌᤠᤅᤧᤀᤠᤱ ᤘᤕᤧᤖᤥ॥ ᤛᤧᤰᤂᤠ᤺ᤸᤗᤧ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤕᤜᤢᤍᤡ ᤏᤛᤠᤏᤡᤒᤠᤜᤠ᤹ᤖᤧ ᤂᤢᤏᤡ᤹ ᤜᤡᤱᤔᤴᤏᤥ ᤆᤠᤜᤠᤒᤠ ᤁᤧᤈᤥ᤺ᤰᤐᤠ ᤐᤠ᤺ᤴᤜᤠ᤹ ᤁᤢᤓᤠ᤹ ᤐᤡᤔᤠᤛᤡ ᤁᤧᤒᤥ᤺ᤱᤒᤠᤀᤣ ᤘᤕᤧ. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤕᤜᤢᤍᤡ ᤏᤛᤠᤏᤡᤒᤠᤜᤠ᤹ᤗᤠᤶ ᤁᤧᤍᤠ᤺ᤒᤠ ᤛᤢᤏᤠᤀᤡᤱᤅᤡᤸᤗᤧᤴ ᤕᤠᤶᤛᤠᤶᤃᤧᤴ ᤔᤢ᤹ᤀᤡᤛᤠᤶᤔᤡᤴ ᤌᤡᤶᤔᤧᤴᤍᤱ ᤛᤢᤘᤠᤱᤜᤠ᤹ᤖᤧ ᤔᤧᤄᤥ᤺ᤛᤢᤀᤠᤱ ᤔᤧᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":28,"content":["ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ ᤂᤧᤴ ᤑᤠ᤹ᤕᤠᤱᤅᤡᤴ ᤕᤖᤢᤛᤗᤧᤶᤔᤥ ᤋᤣ᤹ᤖᤢᤱᤅᤠᤱ ᤂᤧᤴ ᤔᤧᤄᤥ᤺ᤛᤢ᤹ ᤁᤧᤗ᤹ᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤴ ᤏᤡ᤺ᤴᤎᤥ ᤆᤥᤃᤢᤱ ᤜᤧᤰᤁᤩᤠᤱ ᤀᤡᤛ᤻ᤐᤧᤏ ᤐᤣ᤺ᤰᤁᤠᤸᤗᤧ ᤂᤡᤏᤡ᤹ᤀᤥ ᤗ᤺ᤴᤏᤠ᤹ ᤋᤠᤀᤠᤖᤥ॥"]},{"type":"verse","number":29,"content":["ᤀᤡᤱᤃᤠ᤹ ᤂᤡᤏᤡ᤹ᤀᤥ ᤋᤠᤀᤠᤸᤗᤧ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤔᤢᤸᤗᤢᤰ ᤁᤢᤔᤢ᤹ᤀᤡᤛᤠᤶᤔᤡᤴᤏᤢ ᤋᤠ᤺ᤀᤠ ᤁᤧᤗ᤹ᤒᤠᤴ ᤏᤡ᤺ᤛᤢᤱᤗᤥ॥"]},{"type":"verse","number":30,"content":["ᤀᤠᤔᤡ᤺ᤶ ᤑᤢ᤹ᤏᤢᤛᤠ᤹ ᤏᤢ ᤏᤧ᤹ᤏᤢᤛᤠ᤹ᤛᤣ. ᤍᤠᤱᤒᤠ ᤕᤧᤛᤢ ᤂᤪᤡᤛ᤻ᤋᤖᤧ ᤁᤢᤔᤏᤠ ᤀᤠᤒᤥ᤺ᤰᤂᤧᤒᤠᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤜᤧᤰᤁᤩᤠᤱ ᤛᤣᤛᤣᤔᤠᤱᤅᤡᤸᤗᤧ ᤗᤢᤱᤔᤠ᤹ ᤀᤠᤍᤢᤰᤋᤧᤒᤠᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤥ ᤋᤢᤘᤠ ᤀᤠᤈᤥᤃᤧᤶ ᤀᤠᤒᤡᤖᤧᤶᤔᤧ᤹ᤖ ᤀᤡᤱᤃᤠ᤹ ᤀᤡᤏᤥᤃᤧᤴ ᤀᤠᤍᤢᤰᤂᤣᤀᤥ ᤆᤢᤶ ᤀᤠᤔᤧᤳᤋᤧᤶᤔᤧ᤹ ᤑᤠ᤹ᤀᤠᤱ ᤐᤣᤗᤡ ᤑᤠᤰᤏᤡᤱᤗᤥ॥"]},{"type":"verse","number":31,"content":["ᤕᤜᤢᤍᤡᤕᤠ ᤌᤢᤶᤔᤥᤒᤠ ᤏᤛᤠ᤺ᤴ ᤔᤧᤴᤈᤥ᤺ᤰᤔᤏᤠᤒᤠᤜᤠ᤹ᤗᤠᤶᤒᤠ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤀᤡᤱᤃᤠ᤹ ᤋᤠᤱᤛᤧ᤺ᤵᤐᤠᤖ ᤜᤧᤰᤁᤩᤠᤱ ᤕᤖᤢᤛᤗᤧᤔᤒᤠ ᤏᤛᤠᤏᤡᤒᤠᤜᤠ᤹ᤖᤧ ᤗᤠᤃᤡ ᤋᤣ᤹ᤖᤢᤱᤒᤠ ᤁᤢᤓᤠ᤹ ᤕᤠᤱᤅᤡᤴ ᤂᤧᤱᤜᤠ᤹ᤖᤧ ᤔᤧᤍᤠ᤺ᤰᤋᤢᤖ ᤑᤠ᤹ᤀᤠᤱᤅᤠᤱ ᤋᤢᤘᤠ ᤆᤥᤃᤧᤶ ᤀᤠᤒᤡᤖᤧᤶᤔᤧ᤹ᤀᤥ॥"]},{"type":"verse","number":32,"content":["ᤜᤧᤰᤁᤩᤠᤱ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤏᤡᤱᤘᤠ᤹ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤂᤡᤏᤡ᤹ᤀᤥ ᤛ᤺ᤳᤋᤠᤖ ᤋᤠᤀᤠᤀᤠᤱ ᤛᤥᤛᤥᤖᤡᤰ ᤜᤠᤱᤜᤠᤱ ᤀᤠᤔᤧᤳᤇᤡᤱᤗ ᤑᤠ᤹ᤀᤠᤱ ᤋᤢᤘᤠ ᤆᤥᤃᤧᤶᤔᤧ᤹ᤀᤥ॥"]},{"type":"verse","number":33,"content":["ᤛᤏᤠᤖᤢᤱ ᤁᤧᤒᤡᤒᤠ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤂᤡᤏᤡ᤹ ᤁᤧᤖᤧᤰᤏᤢ ᤘᤠ᤹ᤖᤖᤥ॥ ᤀᤠᤔᤧᤴ॥"]}],"footnotes":[{"noteId":54,"caller":"*","text":"ᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤗᤥ ᤛᤢᤶ ᥌᥏.᥏","reference":{"chapter":15,"verse":3}},{"noteId":55,"caller":"*","text":"ᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤗᤥ ᤛᤢᤶ ᥇᥎.᥊᥏","reference":{"chapter":15,"verse":9}},{"noteId":56,"caller":"*","text":"ᤛᤠᤶᤕᤥᤌᤡᤶ ᤀᤡᤱᤈᤠ᤺ᤱ ᥉᥈.᥊᥉","reference":{"chapter":15,"verse":10}},{"noteId":57,"caller":"*","text":"ᤏᤡᤱᤘᤠ᤹ᤑᤢᤛᤠᤶᤗᤥ ᤛᤢᤶ ᥇᥇᥍.᥇","reference":{"chapter":15,"verse":11}},{"noteId":58,"caller":"*","text":"ᤕᤛᤤᤕᤠ ᥇᥇.᥇᥆","reference":{"chapter":15,"verse":12}},{"noteId":59,"caller":"*","text":"ᤕᤛᤤᤕᤠ ᥋᥈.᥇᥋","reference":{"chapter":15,"verse":21}}]},"thisChapterLink":"/api/lif_wbt/ROM/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lif_wbt/ROM/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lif_wbt/ROM/14.json","previousChapterAudioLinks":{},"numberOfVerses":32}