{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"ROM","translationId":"lif_wbt","name":"ᤖᤥᤔᤡ","commonName":"ᤖᤥᤔᤡ","title":"ᤐᤠᤘᤗᤖᤧ ᤖᤥᤔᤡᤜᤠ᤹ ᤜᤠᤰᤋᤢᤛᤡᤒᤠ ᤛᤰᤀᤡᤱᤄᤱ","order":45,"numberOfChapters":16,"sha256":"08f5740bcc3c9859e3a12d6b0e8268f706fa951b14bb8e051d4b487152489304","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/ROM/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/lif_wbt/ROM/16.json","totalNumberOfVerses":427},"chapter":{"number":15,"content":[{"type":"heading","content":["ᤏᤛᤠ᤺ᤴ ᤁᤧᤛᤢ᤺ᤶᤒᤠᤜᤠ᤹ ᤁᤢᤓᤠ ᤐᤡᤔᤠ"]},{"type":"verse","number":1,"content":["ᤀᤠᤏᤡ᤹ ᤏᤛᤠ᤺ᤴᤏᤥ ᤁᤧᤎᤢᤶᤒᤠᤜᤠ᤹ᤖᤧ ᤀᤠᤒᤠᤅᤣ ᤏᤡᤱᤘᤠ᤹ ᤋᤠ᤺ᤔᤠ ᤔᤧᤏᤢ᤹ᤏᤧᤴ. ᤁᤖ ᤏᤛᤠ᤺ᤴ ᤁᤧᤛᤢ᤺ᤶᤒᤠᤜᤠ᤹ ᤁᤢᤓᤠ᤹ ᤐᤡᤔᤠᤛᤡ ᤐᤥ᤺ᤱᤗᤥ॥"]},{"type":"verse","number":2,"content":["ᤀᤠᤏᤡ᤹ ᤁᤧᤖᤧᤰᤗᤧ ᤘᤣ᤹ᤜᤠ᤹ᤖᤧ ᤗᤠᤃᤡ ᤏᤢ᤺ᤒᤠ ᤆᤥ᤺ᤰᤔᤠᤀᤠᤱ ᤂᤢᤏᤡ᤹ ᤏᤛᤠ᤺ᤴᤏᤥ ᤁᤧᤎᤢᤶᤒᤠ ᤆᤥ᤺ᤰᤔᤠᤛᤡ ᤑᤠ᤹ᤀᤠᤱ ᤂᤢᤏᤡ᤹ ᤏᤡᤱᤘᤠ᤹ ᤋᤠ᤺ᤔᤠ ᤐᤡᤔᤠᤛᤡ ᤐᤥ᤺ᤱᤗᤥ॥"]},{"type":"verse","number":3,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤛᤠᤶᤕᤥᤛᤠᤵᤗᤠᤀᤥ ᤂᤡᤏᤡ᤹ ᤜᤡᤏᤠ᤺ᤶ ᤁᤧᤔᤧᤵᤐᤠᤜᤠ᤹ᤖᤧ ᤁᤧᤶᤔᤧᤳᤋᤡᤒᤠ ᤜᤡᤏᤠ᤺ᤶᤔᤡᤱᤃ ᤀᤡᤱᤃᤠ᤹ ᤀᤠᤛᤶᤍᤠᤱ ᤆᤢᤰᤋᤧᤀᤠᤱ ᤘᤠ᤹ᤖᤥ",{"noteId":54},"ᤗ᤹ᤖᤡᤰ ᤛᤠᤵᤋᤧᤀᤠᤱ ᤐᤵᤐᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤂᤪᤡᤛ᤻ᤋᤖᤧᤀᤠᤱ ᤀᤠᤒᤠᤅᤣ ᤁᤢᤏᤡᤱᤘᤠ᤹ ᤁᤧᤍᤠ᤺ᤒᤠ ᤕᤠ᤺ᤶᤒᤰ ᤔᤧᤈᤥᤃᤢᤴᤗᤥ॥"]},{"type":"verse","number":4,"content":["ᤐᤣ ᤕᤧᤶᤔᤥ ᤛᤠᤶᤕᤥᤛᤠᤵᤗᤠᤀᤥ ᤛᤠᤵᤋᤧᤒᤠ ᤁᤠᤰ ᤐᤠ᤺ᤴᤜᤠ᤹ᤖᤧ ᤀᤠᤏᤡ᤹ ᤏᤡᤛᤠᤶ ᤀᤠᤜᤢ᤹ᤖ ᤑᤠ᤹ᤀᤠᤱ ᤛᤠᤵᤋᤧᤒᤠᤖᤥ॥ ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰᤁᤣ ᤏᤠᤛᤡ ᤀᤠᤎ᤺ᤳᤋᤢᤶᤔᤡᤸᤗᤧ ᤜᤧᤰᤁᤩᤠᤱ ᤛᤠᤶᤕᤥᤛᤠᤵᤗᤠᤗᤠᤶ ᤀᤠᤏᤡ᤹ ᤜᤠᤱᤜᤠᤱ ᤀᤠᤗ᤹ᤀᤡᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤀᤠᤒᤡᤖᤧᤒᤠ ᤔᤠᤱᤜᤧᤰᤜᤠ᤹ ᤁᤧᤳ ᤑᤠ᤹ᤀᤠᤱ ᤏᤡᤛ᤻ᤛᤣᤀᤣ ᤏᤡᤱᤛᤠᤱ ᤀᤠᤈᤥᤃᤢᤶᤗᤥ॥"]},{"type":"verse","number":5,"content":["ᤀᤠᤸᤗ ᤏᤠᤛᤡ ᤌ᤺ᤵᤔᤠ ᤁᤧᤒᤠᤱᤒᤠ ᤏᤢ ᤜᤠᤱᤜᤠᤱ ᤕᤠᤵᤔᤡ ᤁᤧᤔᤧᤵᤐᤠ ᤏᤡᤱᤘᤠ᤹ᤑᤢ