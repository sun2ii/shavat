{"translation":{"id":"lif_wbt","name":"ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤐᤠ᤺ᤴᤈᤠᤰ ᤁᤢᤛᤱ ᤔᤠᤱᤜᤢᤵ","website":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lifNT","licenseNotes":null,"shortName":"WBT","englishName":"Limbu NT (Limbu Script)","language":"lif","textDirection":"ltr","sha256":"6116919e88a76086a83bb2f30e555928fb0b93d877561f10c5d7384878062fd6","availableFormats":["json"],"listOfBooksApiLink":"/api/lif_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7875,"languageName":"Limbu","languageEnglishName":"Limbu"},"book":{"id":"ROM","translationId":"lif_wbt","name":"ᤖᤥᤔᤡ","commonName":"ᤖᤥᤔᤡ","title":"ᤐᤠᤘᤗᤖᤧ ᤖᤥᤔᤡᤜᤠ᤹ ᤜᤠᤰᤋᤢᤛᤡᤒᤠ ᤛᤰᤀᤡᤱᤄᤱ","order":45,"numberOfChapters":16,"sha256":"08f5740bcc3c9859e3a12d6b0e8268f706fa951b14bb8e051d4b487152489304","firstChapterNumber":1,"firstChapterApiLink":"/api/lif_wbt/ROM/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/lif_wbt/ROM/16.json","totalNumberOfVerses":427},"chapter":{"number":4,"content":[{"type":"heading","content":["ᤀᤒᤪᤠᤜᤠᤔᤖᤧ ᤁᤢᤏᤛᤠ᤺ᤴ"]},{"type":"verse","number":1,"content":["ᤜᤧᤰᤁᤣᤏᤧ ᤑᤠ᤹ᤃᤪ ᤀᤠᤏᤡ᤹ ᤕᤜᤢᤍᤡᤜᤠ᤹ᤖᤧ ᤐᤠᤎᤧᤒᤠ ᤀᤒᤪᤠᤜᤠᤔᤖᤧ ᤏᤡ᤺ᤛᤢ ᤌᤠ᤺ᤛᤢᤒᤠ ᤐᤠ᤺ᤴᤏᤡᤸᤗᤧ ᤁᤢᤕᤠ᤺ᤶᤒᤣᤀᤥ ᤌᤣ ᤐᤠ᤺ᤵᤔᤠᤒᤣ᥅"]},{"type":"verse","number":2,"content":["ᤛᤧᤰᤂᤠᤀᤣ ᤀᤒᤪᤠᤜᤠᤶᤔᤡᤱᤃ ᤂᤢᤏᤧ᤹ ᤆᤥᤃᤢᤒᤠ ᤏᤢ᤺ᤒᤠ ᤕᤠ᤺ᤶᤒᤰᤗᤠᤶ ᤀᤠᤵᤋᤡᤰ ᤔᤧ᤺ᤴᤏᤣᤒᤠ ᤆᤥᤃᤧᤀᤠᤱ ᤘᤕᤧᤸᤗᤧᤃ ᤀᤠᤱᤍᤡᤱ ᤗ᤹ᤔᤠ ᤛᤢᤰᤋᤢᤒᤠᤔᤧᤴ. ᤁᤖ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤏᤡ᤺ᤔᤠᤀᤥᤃ ᤔᤧ᤺ᤴᤗᤥ."]},{"type":"verse","number":3,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤛᤠᤶᤕᤥᤛᤠᤵᤗᤠ᤺ᤸᤗᤧᤃ ᤀᤰᤂᤣᤏᤧ ᤐᤠ᤺ᤳᤋᤢ᤹ᤖᤥ. “ᤀᤒᤪᤠᤜᤠᤔᤖᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤏᤛᤠ᤺ᤴ ᤆᤥᤃᤢᤒᤠᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤂᤢᤏᤧ᤹ ᤛᤠᤶᤕᤥᤏᤡᤒᤠ ᤗᤣ᤺ᤳᤋᤢᤖᤥ॥”",{"noteId":12}]},{"type":"verse","number":4,"content":["ᤀᤠᤸᤗ ᤕᤠ᤺ᤶᤒᤰ ᤁᤧᤈᤥ᤺ᤰᤐᤠ ᤔᤏᤠ᤺ᤸᤗᤧ ᤁᤢᤏᤠᤶᤕᤠᤰᤁᤡᤴ ᤗᤢᤱᤔᤠ᤹ ᤋᤢᤰᤔᤠᤗᤠᤶ ᤂᤥ᤺ᤛᤢᤒᤠ ᤔᤧ᤺ᤴ. ᤁᤖ ᤂᤧᤱᤃ ᤂᤢᤏᤧ᤹ ᤂᤥ᤺ᤔᤠ ᤁᤧᤒᤥ᤺ᤱᤒᤠ ᤁᤢᤗᤰᤗᤥ॥"]},{"type":"verse","number":5,"content":["ᤀᤠᤳᤋᤡᤴ ᤔᤏᤠ᤺ᤸᤗᤧᤀᤠᤱ ᤀᤠᤒᤠᤅᤣ ᤕᤠ᤺ᤶᤒᤰ ᤆᤥᤃᤢᤒᤠᤸᤗᤧ ᤔᤧ᤺ᤴ. ᤁᤖ ᤗᤠᤕᤥᤒᤠ ᤔᤏᤠ᤺ᤴ ᤀᤠᤵᤋᤡᤰ ᤔᤧ᤺ᤴᤏᤣᤒᤠ ᤁᤧᤈᤥ᤺ᤰᤐᤠ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤴ ᤂᤧᤸᤗᤧ ᤏᤛᤠ᤺ᤴ ᤆᤥᤃᤢᤒᤠᤸᤗᤧ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤂᤢᤏᤧ᤹ ᤛᤠᤶᤕᤥᤏᤡᤒᤠ ᤗᤣ᤺ᤳᤋᤢᤖᤥ॥"]},{"type":"verse","number":6,"content":["ᤍᤠᤀ