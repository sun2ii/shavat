,"content":["ᤗᤠᤕᤥ᤺ᤸᤗᤧ ᤁᤢᤕᤢᤰᤁᤡᤴ ᤀᤠᤏᤡ᤹ ᤜᤡᤱᤔᤴᤏᤥᤗᤠᤶ ᤔᤧᤰᤗ ᤜᤧᤰᤁᤩᤠᤱ ᤀᤠᤸᤗᤀᤠᤱᤎᤥ ᤗᤠᤕᤥᤖᤧ ᤁᤢᤕᤥ᤺ᤰᤐᤠ ᤀᤠᤶᤒᤥ᤺ᤱᤅᤡᤴᤗ ᤑᤠ᤹ᤀᤠᤱ ᤀᤠᤏᤡ᤹ ᤋᤃᤡᤛ᤻ᤔᤠ ᤜᤡᤱᤔᤴᤏᤡᤴ ᤂᤪᤡᤛ᤻ᤋᤧᤴᤏᤢ ᤛᤡᤗᤠᤶᤛᤠᤰᤔᤠ ᤛᤡᤱᤅᤥ ᤑᤥ᤺ᤴᤍᤧᤀᤠᤱ ᤘᤠ᤹ ᤁᤧᤗ᤹ᤒᤠᤴ ᤁᤢᤛᤡᤱ ᤀᤠᤏᤡ᤺ᤳᤋᤢᤶ."]},{"type":"verse","number":7,"content":["ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤀᤠᤳᤋᤡᤴ ᤛᤩᤧᤀᤠᤱ ᤘᤠ᤹ ᤂᤧᤴ ᤗᤠᤕᤥ᤺ᤸᤗᤧ ᤁᤢᤕᤢᤰᤁᤥᤏᤢ ᤆᤥ᤺ᤰᤕᤢᤶᤓᤥᤒᤠ ᤐᤥ᤺ᤰᤂᤧᤀᤠᤱ ᤘᤠ᤹ᤖᤥ॥"]},{"type":"verse","number":8,"content":["ᤀᤠᤸᤗ ᤀᤠᤏᤡ᤹ ᤂᤪᤡᤛ᤻ᤋᤧᤴᤏᤢ ᤛᤥᤖᤡᤰ ᤀᤠᤛᤩᤧᤀᤠᤱ ᤀᤠᤘᤠ᤹ᤏᤧ ᤑᤠ᤹ᤃᤪ ᤂᤢᤏᤧ᤹ᤏᤢᤀᤣ ᤀᤠᤏᤡ᤹ᤀᤠᤱ ᤕᤠᤶᤔᤥ ᤀᤠᤜᤡᤱᤗᤥ ᤑᤠ᤹ᤀᤠᤱ ᤏᤛᤠ᤺ᤴ ᤀᤠᤈᤥᤃᤢᤶᤗᤥ॥"]},{"type":"verse","number":9,"content":["ᤂᤪᤡᤛ᤻ᤋᤧᤱᤃ ᤛᤩᤧᤀᤠᤱ ᤁᤢᤜᤡᤱᤘᤧᤳ ᤐᤥ᤺ᤰᤂᤧᤒᤠᤸᤗᤧ ᤀᤠᤸᤗ ᤕᤠᤶᤔᤥ ᤔᤧᤛᤡ᤺ᤏᤧᤴᤗᤥ ᤁᤧᤗ᤹ᤒᤠᤴ ᤀᤠᤏᤡ᤹ ᤀᤠᤏᤡ᤺ᤛᤢᤶᤗᤥ॥ ᤜᤧᤰᤁᤣ᤺ᤸᤗᤧ ᤀᤠᤸᤗᤀᤠᤱᤎᤥ ᤂᤢᤏᤧ᤹ ᤛᤶᤍᤠᤱ ᤛᤡ᤺ᤔᤧᤸᤗᤧ ᤕᤢᤰ ᤔᤧᤃᤳᤋᤢᤴᤗᤥ॥"]},{"type":"verse","number":10,"content":["ᤂᤪᤡᤛ᤻ᤋᤧᤴ ᤛᤩᤧᤸᤗᤧ ᤗᤠᤕᤥ᤺ᤸᤗᤧ ᤁᤢᤔᤢᤰᤛᤠᤶᤔᤡᤴ ᤏᤠ᤺ᤶᤔᤠ ᤑᤠ᤹ᤀᤠᤱ ᤛᤍᤠᤍᤡᤱᤖᤧ ᤗᤠᤃᤡ ᤂᤢᤏᤧ᤹ ᤌᤡᤰᤗᤧᤱᤅᤥ ᤛᤩᤧ. ᤁᤖ ᤀᤠᤸᤗ ᤂᤢᤏᤧ᤹ ᤁᤢᤜᤡᤱᤘᤧᤳ ᤘᤠ᤹ᤖᤥ. ᤜᤧᤰᤁᤩᤠᤱ ᤁᤢᤜᤡᤱᤔᤴᤏᤡᤴ ᤂᤢᤏᤧ᤹ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤏᤡᤱᤘᤠ᤹ ᤋᤠ᤺ᤔᤠ ᤑᤠ᤹ᤀᤠᤱ ᤜᤡᤱᤗᤥ॥"]},{"type":"verse","number":11,"content":["ᤜᤧᤰᤁᤣᤗ᤹ᤖᤡᤰᤁᤣ ᤁᤢᤛᤡᤘᤧᤳ ᤔᤏᤠ᤺ᤸᤗᤧ ᤗᤠᤕᤥ ᤔᤧᤈᤥᤃᤢᤶᤒᤠ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤂᤡᤏᤡ᤹ ᤗᤠᤕᤥ ᤆᤥ᤺ᤰᤔᤠᤀᤥ ᤁᤧᤛᤩᤧ᤹ᤀᤡ ᤁᤖ ᤂᤪᤡᤛ᤻ᤋ ᤕᤧᤛᤢ᤺ᤴᤏᤢ ᤌᤡᤰᤜᤢᤵ ᤁᤧᤒᤥ᤺ᤰᤂᤡᤀᤠᤱ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤡᤸᤗᤧ ᤁᤢᤏᤡᤱᤘᤠ᤹ ᤋᤠ᤺ᤔᤠᤖᤧ ᤗᤠᤃᤡ ᤁᤧᤜᤡᤅᤡᤒᤠ ᤑᤠ᤹ᤀᤠᤱ ᤏᤡᤱᤘᤠ᤹ ᤀᤡ᤺ᤳᤋᤧᤶᤔᤧ᤹ᤀᤥ॥"]},{"type":"verse","number":12,"content":["ᤂᤧᤸᤗᤧ ᤆᤥᤃᤢᤸᤗᤧ ᤗᤠᤕᤥ᤺ᤸᤗᤧ ᤂᤡᤏᤡ᤹ ᤏᤠᤛᤡᤱᤃᤧᤴ ᤌᤰᤁᤡᤴ ᤕᤢᤰᤔᤠ ᤔᤧᤒᤠᤱᤄᤧᤶᤔᤡᤴᤏᤧ᤹ᤀᤥ. ᤔᤧ᤺ᤴᤏᤧ ᤑᤠ᤹ᤃᤪ ᤑᤧᤴ ᤏᤡᤱᤘᤠ᤹ᤀᤡᤸᤗᤧ ᤁᤢᤒᤠ᤺ᤴᤏᤡᤴ ᤋᤧᤴᤍᤡᤱ ᤁᤧᤈᤥᤃᤢᤶᤗᤥ॥"]},{"type":"verse","number":13,"content":["ᤂᤡᤏᤡ᤹ ᤌᤰᤁᤥᤒᤠ ᤕᤠᤶᤗᤰᤜᤠ᤹ ᤋᤠᤵᤑᤧ᤺ᤶᤒᤠ ᤕᤠ᤺ᤶᤒᤰ ᤆᤥ᤺ᤰᤔᤠᤖᤧ ᤗᤠᤃᤡ ᤗᤠᤕᤥ᤺ᤴ ᤔᤧᤍᤥ᤺ᤴᤍᤧᤶ ᤔᤧᤒᤡᤖᤧᤶᤔᤡᤴᤏᤧ᤹॥ ᤂᤧᤸᤗᤧ ᤁᤢᤗᤧᤰᤘᤠ ᤛᤡ᤺ᤔᤧᤴᤗᤠᤶ ᤜᤡᤱᤔᤴᤏᤥ ᤁᤧᤍᤠ᤺ᤒᤠ ᤔᤏᤠᤜᤠ᤹ ᤁᤢᤀᤡᤛᤡ᤺ᤰ ᤂᤡᤏᤡ᤹ ᤀᤠᤒᤠᤅᤣ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤥ ᤋᤥ᤺ᤴᤏᤠ᤹ᤛᤡᤶᤔᤧ᤹. ᤜᤧᤰᤁᤩᤠᤱ ᤂᤡᤏᤡ᤹ ᤕᤠᤶᤗᤰᤜᤠ᤹ ᤛᤠᤶᤕᤥᤏᤡᤒᤠ ᤕᤠ᤺ᤶᤒᤰ ᤆᤥ᤺ᤰᤔᤠᤖᤧ ᤗᤠᤃᤡ ᤏᤡᤱᤘᤠ᤹ᤑᤢᤔᤠᤱᤅᤥ ᤋᤥ᤺ᤴᤍᤧᤶᤔᤧ᤹ᤀᤥ॥"]},{"type":"verse","number":14,"content":["ᤂᤡᤏᤡ᤹ ᤛᤶᤍᤠᤱ ᤗᤠᤕᤥ᤺ᤴ ᤕᤢᤰ ᤆᤥ᤺ᤰ ᤔᤧᤒᤠᤱᤄᤧᤶᤔᤡᤴᤏᤧ᤹. ᤌᤣᤀᤠᤱᤓᤧᤸᤗᤧ ᤂᤡᤏᤡ᤹ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤸᤗᤧ ᤁᤢᤕᤢᤰᤁᤥ ᤁᤧᤜᤥ᤺ᤵᤋᤡ᤹. ᤁᤖ ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤗᤢᤱᤃᤢᤶᤔᤡᤸᤗᤧ ᤁᤢᤕᤢᤰᤁᤥ ᤁᤧᤘᤕᤡ᤹ᤖᤥ॥"]},{"type":"heading","content":["ᤛᤠᤶᤕᤥᤏᤡᤔᤠᤸᤗᤧ ᤁᤢᤕᤥ᤺ᤰᤐᤠ"]},{"type":"verse","number":15,"content":["ᤁᤴ ᤁᤠᤰ ᤑᤠ᤹ᤀᤡᤱᤃ ᤌᤧᤔᤠᤒᤣ᥅ ᤀᤠᤏᤡ᤹ ᤛᤠᤶᤕᤥᤌᤡᤶᤔᤡᤸᤗᤧ ᤁᤢᤕᤢᤰᤁᤥ ᤀᤠᤜᤥ᤺ᤵ ᤁᤖ ᤏᤡᤱᤘᤠ᤹ᤑᤢ ᤗᤢᤱᤃᤢᤶᤔᤡᤸᤗᤧ ᤁᤢᤕᤢᤰᤁᤥ ᤀᤠᤘᤠ᤹ᤒᤠᤸᤗᤧ ᤗᤠᤕᤥ ᤆᤥᤃᤢᤶᤒᤡ᥅ ᤀᤠᤵᤑᤠᤸᤗᤧᤀᤠᤱ