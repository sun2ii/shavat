{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"HAB","translationId":"lin_bib","name":"Abakuki","commonName":"Abakuki","title":"Abakuki","order":35,"numberOfChapters":3,"sha256":"3a761a58049a9edd75ab51c65b3b43b35a3e57045fa1cb10cd61a64999d173f9","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/lin_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":1,"content":[{"type":"heading","content":["Loyembo ya liboso ya mawa"]},{"type":"verse","number":1,"content":["Tala liloba oyo mosakoli Abakuki azwaki na emoniseli :"]},{"type":"verse","number":2,"content":[{"text":"Oh Yawe, kino tango nini","poem":1},{"text":"nasengeli kobelela Yo mpo ete osunga,","poem":2},{"text":"kasi ozali koyoka te ?","poem":1},{"text":"Nazali koganga epai na Yo : « Minyoko eleki ! »","poem":2},{"lineBreak":true},{"text":"kasi ozali kaka kobikisa te !","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mpo na nini ozali kolakisa ngai","poem":1},{"text":"makambo mabe ya boye ?","poem":2},{"text":"Mpo na nini ozali kosala eloko moko te ?","poem":1},{"text":"Liboso na ngai, nazali kaka komona libebi","poem":2},{"text":"mpe makambo mabe,","poem":1},{"text":"bato bazali kaka koswana mpe kofundana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yango wana bato bazali kotosa lisusu mibeko te,","poem":1},{"text":"bazali kokata lisusu makambo na bosembo te.","poem":2},{"text":"Bato mabe bazali kolonga liboso ya bato ya sembo,","poem":1},{"text":"makambo ezali lisusu kokatama na bosembo te.","poem":2}]},{"type":"heading","content":["Eyano ya Yawe"]},{"type":"verse","number":5,"content":[{"text":"Botala nanu malamu bikolo mosusu","poem":1},{"text":"mpe bokokamwa penza,","poem":2},{"text":"pamba te nakosala likambo moko na tango na bino,","poem":1},{"text":"likambo oyo bokondima te","poem":2},{"lineBreak":true},{"text":"soki bayebisi bino yango.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nakotindela bino bato ya Babiloni,","poem":1},{"text":"bato ya mitema mabe,","poem":2},{"text":"oyo bayokelaka bato mawa te :","poem":1},{"text":"batambolaka mokili mobimba","poem":2},{"text":"mpo na kobotola bato bisika na bango","poem":1},{"text":"ya losambo na makasi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bazali bato ya somo mpe bato oyo babangisaka,","poem":1},{"text":"basalaka makambo nyonso","poem":2},{"text":"oyo bazali na yango posa,","poem":1},{"text":"mpe moto moko te amekaka kotelemela bango.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bampunda na bango ekimaka mbangu","poem":1},{"text":"koleka ata nkoyi,","poem":2},{"text":"ezalaka na kanda makasi","poem":1},{"text":"koleka ata mbwa ya zamba oyo ebimaka na pokwa","poem":2},{"text":"mpo na koluka nyama ya kolia.","poem":1},{"text":"Basoda na bango oyo batambolaka likolo ya bampunda","poem":2},{"text":"batambolaka mbangu makasi","poem":1},{"text":"mpe bawutaka mosika penza,","poem":2},{"text":"bapumbwaka lokola mpongo","poem":1},{"text":"soki ezali kokita na elulu","poem":2},{"lineBreak":true},{"text":"mpo na kokanga nyama ya kolia.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bango nyonso bayaka nzela moko","poem":1},{"text":"mpo na kotia mobulu,","poem":2},{"text":"bakendaka kaka liboso lokola mopepe ya este,","poem":1},{"text":"bazwaka bakangami ebele","poem":2},{"lineBreak":true},{"text":"ndenge balokotaka mbuma ya zelo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Batiolaka bakonzi mpe basekaka bakambi,","poem":1},{"text":"basekaka bingumba batonga makasi,","poem":2},{"text":"batondisaka mabele pembeni ya bamir","poem":1},{"text":"mpo ete bamata likolo na yango","poem":2},{"lineBreak":true},{"text":"mpe bakota na engumba mpo na kobotola yango,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"balekaka lokola mopepe","poem":1},{"text":"mpe bakobaka nzela na bango,","poem":2},{"text":"basepelaka kosala mabe,","poem":1},{"text":"mpe makasi na bango nde ezali nzambe na bango.","poem":2}]},{"type":"heading","content":["Loyembo ya mibale ya mawa"]},{"type":"verse","number":12,"content":[{"text":"Boni, ozali Yawe te wuta na ebandeli ?","poem":1},{"text":"Ozali Nzambe na ngai, Mosantu na ngai,","poem":2},{"text":"okufaka te.","poem":1},{"text":"Oh Yawe, oponaki bango mpo na kosambisa biso ;","poem":2},{"text":"mpe Yo Libanga na ngai, olendisaki bango","poem":1},{"text":"mpo na kopesa biso etumbu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Miso na Yo ezali peto koleka,","poem":1},{"text":"okoki kotala mabe te.","poem":2},{"text":"Mpo na nini ozali kotala makambo mabe ?","poem":1},{"text":"Mpo na nini ozali kotala bato mabe na miso ?","poem":2},{"text":"Mpo na nini ovandi kimia","poem":1},{"text":"wana bato mabe bazali konyokola","poem":2},{"lineBreak":true},{"text":"bato oyo baleki bango na bosembo ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Okomisi bato lokola bambisi ya ebale,","poem":1},{"text":"lokola banyama oyo etambolaka na libumu","poem":2},{"lineBreak":true},{"text":"mpe ezanga mokonzi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Moto mabe azwaka yango nyonso na ndobo,","poem":1},{"text":"akangaka yango na monyama","poem":2},{"text":"mpe atiaka yango na kitunga.","poem":1},{"text":"Yango wana asepelaka","poem":2},{"lineBreak":true},{"text":"mpe atondaka na esengo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bongo abonzelaka monyama na ye mbeka,","poem":1},{"text":"atumbelaka kitunga na ye ansa ;","poem":2},{"text":"pamba te na nzela ya monyama mpe ya kitunga na ye,","poem":1},{"text":"azwaka bambisi ebele mpe bilei ya kitoko.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Boni, akosepela solo kotika","poem":1},{"text":"ete monyama na ye ezanga mbisi","poem":2},{"lineBreak":true},{"text":"na kokoba koboma bato na mawa te ?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/NAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}