{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"ISA","translationId":"lin_bib","name":"Ezayi","commonName":"Ezayi","title":"Ezayi","order":23,"numberOfChapters":66,"sha256":"6aad041eb0f85299ee6f42f0effb96885a8b2806996ff5211d589868ab842fa4","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lin_bib/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Emoniseli oyo Ezayi, mwana mobali ya Amotsi, amonaki na tina na mokili ya Yuda mpe ya engumba Yelusalemi tango Oziasi, Yotami, Akazi mpe Ezekiasi bazalaki bakonzi ya Yuda."]},{"type":"heading","content":["Isalaele atombokeli Yawe"]},{"type":"verse","number":2,"content":[{"text":"Oh Lola, yoka !","poem":1},{"text":"Mabele, pesa matoyi mpo na koyoka !","poem":2},{"text":"Pamba te Yawe nde azali koloba :","poem":1},{"text":"« Nabokoli bana mpe nakolisi bango,","poem":2},{"lineBreak":true},{"text":"kasi batombokeli Ngai.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngombe eyebi nkolo na yango,","poem":1},{"text":"ane mpe eyebi elielo oyo nkolo na yango","poem":2},{"text":"apeselaka yango bilei ;","poem":1},{"text":"kasi Isalaele ayebi te,","poem":2},{"lineBreak":true},{"text":"bato na Ngai basosoli te. »","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mawa na yo, ekolo ya bato ya masumu,","poem":1},{"text":"bato oyo batonda na mabe,","poem":2},{"text":"libota oyo esalaka mabe mpe bana mabe !","poem":1},{"text":"Batiki Yawe,","poem":2},{"text":"batioli Mosantu ya Isalaele","poem":1},{"text":"mpe bapesi Ye mokongo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Boni, babeta bino lisusu wapi,","poem":1},{"text":"bino bato oyo botingami kaka na botomboki ?","poem":2},{"text":"Moto na yo mobimba ezali kobela,","poem":1},{"text":"motema na yo mobimba ezali na pasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Longwa na litambe kino na moto,","poem":1},{"text":"eloko moko te ezali malamu,","poem":2},{"text":"kaka bapota mpe matutu oyo basukola te,","poem":1},{"text":"batia kisi te mpe bapakola mafuta te.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mokili na bino ebebisami,","poem":1},{"text":"bingumba na bino esili kozika na moto ;","poem":2},{"text":"bapaya bazali kobebisa bilanga na bino","poem":1},{"text":"na miso na bino,","poem":2},{"text":"nyonso ebebisami solo,","poem":1},{"text":"lokola tango bapanzaka yango na moto ya mobulu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Siona, mboka kitoko, etikali kaka yango moko","poem":1},{"text":"lokola mwa ndako moko ya matiti","poem":2},{"text":"kati na elanga ya vino,","poem":1},{"text":"lokola ndako ya kobombamela","poem":2},{"text":"kati na bilanga ya bapasiteki,","poem":1},{"text":"lokola engumba oyo ebatelami.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Soki Yawe, Mokonzi ya mampinga,","poem":1},{"text":"abikisaki te ndambo ya bato kati na biso,","poem":2},{"text":"tolingaki kokoma lokola engumba Sodome,","poem":1},{"text":"tolingaki kokokana na engumba Gomore.","poem":2}]},{"type":"heading","content":["Losambo oyo Yawe andimaka"]},{"type":"verse","number":10,"content":[{"text":"Boyoka Liloba na Yawe,","poem":1},{"text":"bino bakambi ya engumba Sodome !","poem":2},{"text":"Boyoka mobeko ya Nzambe na biso,","poem":1},{"text":"bino bato ya engumba Gomore !","poem":2}]},{"type":"verse","number":11,"content":[{"text":"« Ebele ya bambeka na bino ekosala Ngai nini, »","poem":1},{"text":"elobi Yawe ?","poem":2},{"text":"« Nasili kolemba bambeka na bino ya kotumba,","poem":1},{"text":"bambeka na bino ya bameme ya mibali","poem":2},{"text":"mpe mafuta ya bibwele na bino ya mafuta ;","poem":1},{"text":"nazali kosepela ata moke te","poem":2},{"text":"na makila ya bangombe ya mibali,","poem":1},{"text":"ya bana meme mpe ya bantaba ya mibali.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tango boyaka liboso na Ngai,","poem":1},{"text":"nani abengaka bino ete boya kokota","poem":2},{"lineBreak":true},{"text":"na lopango na Ngai ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Botika komemela Ngai makabo oyo ezanga tina !","poem":1},{"text":"Nazali koyoka malasi na bino ya ansa nkele.","poem":2},{"text":"Bafeti na bino ya ebandeli ya sanza,","poem":1},{"text":"ya Saba mpe mayangani na bino :","poem":2},{"text":"bafeti wana ya mabe,","poem":1},{"text":"nazali kokoka yango lisusu te.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Motema na Ngai eyini","poem":1},{"text":"bafeti na bino wana ya ebandeli ya sanza","poem":2},{"text":"mpe bafeti na bino wana ekatama.","poem":1},{"text":"Ekomi penza mokumba mpo na Ngai,","poem":2},{"lineBreak":true},{"text":"nalembi komema yango.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tango bokotombola maboko na bino mpo na kobondela,","poem":1},{"text":"nakolongola miso na Ngai likolo na bino ;","poem":2},{"text":"ezala soki bosambeli mingi,","poem":1},{"text":"nakoyoka bino te,","poem":2},{"lineBreak":true},{"text":"pamba te maboko na bino etondi na makila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bomisukola mpe bomipetola,","poem":1},{"text":"bolongola misala mabe na bino na miso na Ngai !","poem":2},{"lineBreak":true},{"text":"Botika kosala mabe !","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Boyekola nde kosala malamu,","poem":1},{"text":"boluka bosembo, bosunga moto oyo bazali konyokola,","poem":2},{"text":"bobundela mwana etike,","poem":1},{"text":"bokotela mwasi oyo akufisa mobali !","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Boya sik’oyo, tosilisa likambo, »","poem":1},{"text":"elobi Yawe.","poem":2},{"text":"« Ezala masumu na bino ezali motane makasi,","poem":1},{"text":"ekokoma pembe lokola mvula ya pembe ;","poem":2},{"text":"ata ezali motane lokola ngola,","poem":1},{"text":"ekokoma lokola bapwale ya meme.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Soki bozwi mokano ya kotosa Ngai,","poem":1},{"text":"bokolia mbuma kitoko ya mokili.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kasi soki kaka botie moto makasi mpe botomboki,","poem":1},{"text":"bokokufa na mopanga. »","poem":2},{"lineBreak":true},{"text":"Pamba te monoko ya Yawe nde elobi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tala ndenge nini engumba ya boyengebene ekomi","poem":1},{"text":"lokola mwasi ya ndumba !","poem":2},{"text":"Ezalaki liboso engumba etonda na bosembo,","poem":1},{"text":"boyengebene ezalaki kovanda kati na yango ;","poem":2},{"lineBreak":true},{"text":"kasi lelo oyo ekomi kobomba babomi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Palata na yo ekomi bosoto,","poem":1},{"text":"vino na yo ya kitoko ekomi mayi-mayi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bakambi na yo bazali batomboki,","poem":1},{"text":"baninga ya miyibi ;","poem":2},{"text":"bango nyonso balingaka kaka kanyaka","poem":1},{"text":"mpe batonda na lokoso ya lifuti.","poem":2},{"text":"Bakotelaka mwana etike te,","poem":1},{"text":"mpe likambo ya mwasi oyo akufisa mobali etalaka bango te.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Yango wana, Yawe, Mokonzi ya mampinga,","poem":1},{"text":"Elombe ya Isalaele alobi :","poem":2},{"text":"Ah, mawa ! Nakosepela na pasi na bino, bino bayini na Ngai ;","poem":1},{"text":"mpe nakofutisa bino masumu, bino banguna na Ngai !","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nakotelemela bino,","poem":1},{"text":"nakopetola bosoto ya palata na bino","poem":2},{"lineBreak":true},{"text":"mpe nakolongola salite na bino,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"nakokomisa lisusu basambisi na bino","poem":1},{"text":"malamu lokola na tango ya kala ;","poem":2},{"text":"mpe bapesi toli na bino, ndenge ezalaka na ebandeli.","poem":1},{"text":"Sima na yango, bakobenga bino lisusu","poem":2},{"text":"Engumba ya Bosembo,","poem":1},{"text":"Engumba ya Boyengebene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Siona ekosikolama na nzela ya boyengebene,","poem":1},{"text":"mpe bato na yango oyo bakobongola mitema","poem":2},{"lineBreak":true},{"text":"bakobika na nzela ya bosembo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kasi batomboki mpe bato ya masumu bakobebisama,","poem":1},{"text":"bato oyo bakobosana Yawe bakosila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"« Bokoyoka soni mpo na banzete ya terebente","poem":1},{"text":"oyo bozalaki kolinga mingi ;","poem":2},{"text":"bokoyoka pasi na mitema","poem":1},{"text":"mpo na bilanga oyo boponaki ;","poem":2}]},{"type":"verse","number":30,"content":[{"text":"bokokoma lokola nzete ya terebente","poem":1},{"text":"oyo ekawuka makasa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Moto ya makasi akokoma moto ya bolembu,","poem":1},{"text":"mpe mosala na ye ekokoma lokola mokalikali ;","poem":2},{"text":"bango mibale bakozika nzela moko na moto,","poem":1},{"text":"mpe moto oyo koboma yango akozala te. »","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}