{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"ISA","translationId":"lin_bib","name":"Ezayi","commonName":"Ezayi","title":"Ezayi","order":23,"numberOfChapters":66,"sha256":"6aad041eb0f85299ee6f42f0effb96885a8b2806996ff5211d589868ab842fa4","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lin_bib/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":12,"content":[{"type":"heading","content":["Nzembo mpo na kokumisa Yawe"]},{"type":"verse","number":1,"content":[{"text":"Na mokolo wana, okoloba :","poem":1},{"text":"« Oh Yawe, nazali kosanzola Yo,","poem":2},{"text":"pamba te ata osilikelaki ngai,","poem":1},{"text":"kanda na Yo elongwaki likolo na ngai","poem":2},{"lineBreak":true},{"text":"mpe obondisaki ngai !","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Solo, Nzambe azali lobiko na ngai ;","poem":1},{"text":"nakotia elikya na ngai epai na Ye","poem":2},{"text":"mpe nakobanga lisusu te.","poem":1},{"text":"Nkolo Yawe azali makasi mpe nguya na ngai ;","poem":2},{"lineBreak":true},{"text":"azali lobiko na ngai. »","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yango wana, botoka mayi na esengo","poem":1},{"text":"na etima ya lobiko.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Na mokolo wana bokoloba :","poem":1},{"text":"« Bosanzola Yawe, bobelela Kombo na Ye,","poem":2},{"text":"bosakola misala na Ye kati na bikolo","poem":1},{"text":"mpe botatola ete Kombo na Ye ezali likolo na nyonso.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Boyemba loyembo mpo na Yawe,","poem":1},{"text":"pamba te asali makambo ya kokamwa.","poem":2},{"lineBreak":true},{"text":"Tika ete mokili mobimba eyeba yango !","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bino bato ya Siona, bobeta milolo mpe boyemba loyembo na esengo,","poem":1},{"text":"pamba te Mosantu ya Isalaele azali monene kati na bino ! »","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}