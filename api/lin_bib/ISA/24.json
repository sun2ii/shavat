{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"ISA","translationId":"lin_bib","name":"Ezayi","commonName":"Ezayi","title":"Ezayi","order":23,"numberOfChapters":66,"sha256":"6aad041eb0f85299ee6f42f0effb96885a8b2806996ff5211d589868ab842fa4","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lin_bib/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":24,"content":[{"type":"heading","content":["Yawe akobebisa mokili"]},{"type":"verse","number":1,"content":[{"text":"Tala, Yawe akobebisa mokili","poem":1},{"text":"mpe akokomisa yango lokola esobe ;","poem":2},{"text":"akokotisa mobulu kati na yango","poem":1},{"text":"mpe akopanza bato na yango.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ekozala mpe kaka ndenge moko","poem":1},{"text":"mpo na Banganga-Nzambe mpe bato,","poem":2},{"text":"mpo na nkolo mpe mowumbu na ye,","poem":1},{"text":"mpo na nkolo ya mwasi mpe mwasi mosali na ye,","poem":2},{"text":"mpo na moteki mpe mosombi,","poem":1},{"text":"mpo na modefisi mpe modefi,","poem":2},{"text":"mpo na moto oyo bakofuta ye niongo","poem":1},{"text":"mpe mpo na moto oyo akofuta niongo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mokili ekobebisama penza nye","poem":1},{"text":"mpe bakopanza yango nyonso.","poem":2},{"lineBreak":true},{"text":"Yawe nde alobaki yango.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mokili ezali na matanga mpe ekawuki,","poem":1},{"text":"mokili mobimba ebebi mpe ekawuki ;","poem":2},{"lineBreak":true},{"text":"ezala likolo mpe ebebi elongo na mokili !","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bato ya mokili bakomisi yango mbindo,","poem":1},{"text":"bazali kotosa mibeko te ;","poem":2},{"text":"banyati-nyati bikateli","poem":1},{"text":"mpe babuki boyokani ya seko.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mpo na yango, bilakeli mabe ezali kozikisa mokili ;","poem":1},{"text":"bato na yango bakomema mokumba ya mabe na bango.","poem":2},{"text":"Yango wana, bato ya mokili bazali kokufa,","poem":1},{"text":"mpe ndambo moke kaka nde etikali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Vino ya sika ezali na matanga,","poem":1},{"text":"elanga ya vino ekawuki ;","poem":2},{"text":"bato nyonso oyo bamesana na esengo","poem":1},{"text":"bakomi kolela na pasi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Esengo ya mbonda esili,","poem":1},{"text":"makelele ya bato ya biyenga esili,","poem":2},{"lineBreak":true},{"text":"esengo ya lindanda esili ;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"komela vino etikali lisusu na banzembo te,","poem":1},{"text":"masanga ya makasi ekomi bololo","poem":2},{"lineBreak":true},{"text":"mpo na bato oyo bamelaka yango.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Engumba oyo ebeba etikali pamba,","poem":1},{"text":"bikuke ya bandako nyonso ekangami.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Na babalabala, koganga na koganga ete vino ezali lisusu te,","poem":1},{"text":"kosepela nyonso ebongwani molili,","poem":2},{"lineBreak":true},{"text":"esengo nyonso elongwe na mokili.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Libebi kaka nde etikali kati na engumba,","poem":1},{"text":"babuki-buki bikuke na yango na biteni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Pamba te ekosalema kati na mokili mpe kati na bikolo","poem":1},{"text":"ndenge esalemaka tango babukaka bambuma ya olive na nzete","poem":2},{"text":"to tango balokotaka bambuma ya vino","poem":1},{"text":"soki basilisi kobuka yango.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bamoko bakotombola mingongo na bango","poem":1},{"text":"mpe bakoganga na esengo ;","poem":2},{"text":"wuta na weste ya mayi monene,","poem":1},{"text":"bakobeta milolo mpo na lokumu na Yawe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yango wana, kuna na ngambo ya este,","poem":1},{"text":"bopesa nkembo na Yawe ;","poem":2},{"text":"bonetola Kombo ya Yawe, Nzambe ya Isalaele,","poem":1},{"text":"kati na bisanga ya ebale monene.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wuta na suka ya mokili,","poem":1},{"text":"tozali koyoka banzembo :","poem":2},{"text":"« Nkembo epai ya Nkolo-Na-Bosembo. »","poem":1},{"text":"Kasi nalobaki : « Nakomi na suka, nakomi na suka !","poem":2},{"text":"Mawa mpo na ngai !","poem":1},{"text":"Bazoba bateki mboka, na bozoba penza,","poem":2},{"lineBreak":true},{"text":"bazoba bateki mboka ! »","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Oh bato ya mokili,","poem":1},{"text":"somo, libulu mpe motambo","poem":2},{"lineBreak":true},{"text":"ezali kozela bino.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Moto nyonso oyo akokima na lokito ya somo","poem":1},{"text":"akokweya na libulu,","poem":2},{"text":"mpe oyo akoluka kobima kati na libulu","poem":1},{"text":"akokangama na motambo.","poem":2},{"text":"Maninisa ya likolo esili kofungwama,","poem":1},{"text":"makonzi ya mokili ezali koningana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mokili ebukani-bukani,","poem":1},{"text":"mokili epanzani,","poem":2},{"lineBreak":true},{"text":"mokili eningani makasi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mokili ekomi kotenga-tenga","poem":1},{"text":"lokola moto oyo alangwe masanga,","poem":2},{"text":"ezali koningana na mopepe lokola ndako ya matiti.","poem":1},{"text":"Mokumba ya botomboki na ye ezali likolo na ye,","poem":2},{"lineBreak":true},{"text":"esili kokweya mpe ekotelema lisusu te.","poem":2}]},{"type":"heading","content":["Suka mpe ebandeli"]},{"type":"verse","number":21,"content":[{"text":"Kasi na mokolo wana, Yawe akopesa etumbu","poem":1},{"text":"na mampinga ya lola kuna na likolo,","poem":2},{"lineBreak":true},{"text":"mpe na bakonzi ya mokili na se.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bakosangisa bango elongo kati na libulu","poem":1},{"text":"ndenge basangisaka bakangami na boloko,","poem":2},{"text":"bakokangela bango na boloko","poem":1},{"text":"mpe bakozwa etumbu sima na mikolo ebele.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Sanza ekokoma motane,","poem":1},{"text":"mpe moyi ekoyoka soni,","poem":2},{"text":"pamba te Yawe, Mokonzi ya mampinga,","poem":1},{"text":"akokonza na ngomba Siona mpe kati na Yelusalemi,","poem":2},{"lineBreak":true},{"text":"liboso ya bampaka na yango, na nkembo makasi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}