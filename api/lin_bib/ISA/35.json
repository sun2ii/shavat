{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"ISA","translationId":"lin_bib","name":"Ezayi","commonName":"Ezayi","title":"Ezayi","order":23,"numberOfChapters":66,"sha256":"6aad041eb0f85299ee6f42f0effb96885a8b2806996ff5211d589868ab842fa4","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lin_bib/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":35,"content":[{"type":"heading","content":["Kobima ya sika"]},{"type":"verse","number":1,"content":[{"text":"Tika ete esobe mpe mabele ya kokawuka esepela !","poem":1},{"text":"Tika ete esobe eyoka esengo","poem":2},{"lineBreak":true},{"text":"mpe ebimisa fololo ya motane lokola roze !","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ekobota fololo mingi penza mpe ekosepela,","poem":1},{"text":"ekosepela mpe ekoganga na esengo.","poem":2},{"text":"Nkembo ya Libani, lokumu ya Karimeli","poem":1},{"text":"mpe ya Saroni ekopesamela yango ;","poem":2},{"text":"boye bakomona nkembo ya Yawe,","poem":1},{"text":"lokumu ya Nzambe na biso.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pesa makasi na maboko oyo elembi,","poem":1},{"text":"lendisa mabolongo oyo ezali kolenga ;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Loba na bato oyo bazali kobanga :","poem":1},{"text":"« Bozala makasi, bobanga te,","poem":2},{"text":"Nzambe na bino akoya,","poem":1},{"text":"akoya kozongisa mabe na mabe,","poem":2},{"text":"akoya na lifuti ya Nzambe.","poem":1},{"text":"Ye moko akoya kobikisa bino. »","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Boye, bakufi miso bakomona","poem":1},{"text":"mpe bakufi matoyi bakoyoka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Moto ya tengu-tengu akopumbwa lokola mboloko,","poem":1},{"text":"mpe lolemo ya baba ekoyemba na esengo.","poem":2},{"text":"Mayi ekobima na esobe,","poem":1},{"text":"mpe bibale, na bisika ya kokawuka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Zelo ya esobe ekobongwana liziba ya mayi,","poem":1},{"text":"mpe mabele ya kokawuka ekokoma bitima ya mayi.","poem":2},{"text":"Matiti, nzete oyo ebotaka na mayi","poem":1},{"text":"mpe papirisi","poem":2},{"noteId":5},{"text":"ekobota na bisika oyo","poem":2},{"lineBreak":true},{"text":"mbwa ya zamba elalaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nzela moko ya monene ekoleka wana,","poem":1},{"text":"bakobenga yango Balabala ya Bosantu.","poem":2},{"text":"Moto moko te ya mbindo akoleka wana,","poem":1},{"text":"pamba te ebongisamaki kaka mpo na bato ya Yawe.","poem":2},{"lineBreak":true},{"text":"Boye ata zoba akoki te kobunga na nzela yango.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nkosi ekozala te na nzela yango,","poem":1},{"text":"ata nyama moko te ya mabe","poem":2},{"text":"ekoleka na nzela yango,","poem":1},{"text":"ekotikala komonana kuna te.","poem":2},{"text":"Kasi basikolami kaka nde","poem":1},{"text":"bakotambola na nzela yango.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Boye, bakangolami na Yawe bakozonga,","poem":1},{"text":"bakokota na Siona na nzembo ya elonga,","poem":2},{"text":"mpe esengo ya suka te ekozala","poem":1},{"text":"na likolo ya mito na bango lokola mitole.","poem":2},{"text":"Esengo mpe kosepela ekopesamela bango,","poem":1},{"text":"nzokande mawa mpe kolela ekosila.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"35.7 Papirisi ezali poso ya nzete oyo bato bazalaki kosalela na tango ya kala mpo na kokoma makomi.","reference":{"chapter":35,"verse":7}}]},"thisChapterLink":"/api/lin_bib/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}