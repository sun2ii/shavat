{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"ISA","translationId":"lin_bib","name":"Ezayi","commonName":"Ezayi","title":"Ezayi","order":23,"numberOfChapters":66,"sha256":"6aad041eb0f85299ee6f42f0effb96885a8b2806996ff5211d589868ab842fa4","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lin_bib/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":47,"content":[{"type":"heading","content":["Kokweya ya Babiloni"]},{"type":"verse","number":1,"content":[{"text":"Kita mpe vanda na putulu,","poem":1},{"text":"Babiloni, mboka kitoko !","poem":2},{"text":"Vanda na mabele, kiti ya bokonzi ezali te,","poem":1},{"text":"Babiloni, mboka kitoko !","poem":2},{"text":"Moto moko te akobenga yo lisusu","poem":1},{"text":"« mwasi bonzenga » to « mwasi kitoko. »","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kamata mabanga oyo banikelaka ble","poem":1},{"text":"mpe sala farine,","poem":2},{"text":"longola kitambala na yo,","poem":1},{"text":"tombola nzambala na yo,","poem":2},{"text":"mpe mipende na yo emonana,","poem":1},{"text":"bongo katisa bibale !","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bolumbu na yo ekomonana,","poem":1},{"text":"mpe soni na yo ekobombama te.","poem":2},{"text":"Nakozongisa mabe na mabe,","poem":1},{"text":"mpe moto moko te akopekisa Ngai.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mosikoli na biso, Kombo na Ye :","poem":1},{"text":"Yawe, Mokonzi ya mampinga,","poem":2},{"lineBreak":true},{"text":"Mosantu ya Isalaele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vanda kimia, kende na molili,","poem":1},{"text":"Babiloni, mboka kitoko,","poem":2},{"text":"pamba te bakobenga yo lisusu te","poem":1},{"text":"« mwasi mokonzi ya bikolo. »","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nasilikelaki bato na Ngai,","poem":1},{"text":"nasambwisaki libula na Ngai ;","poem":2},{"text":"nakabaki bango na maboko na yo,","poem":1},{"text":"mpe oyokelaki bango mawa te ;","poem":2},{"lineBreak":true},{"text":"bongo omemisaki ata mibange ekangiseli ya kilo makasi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Olobaki : « Nakozala mwasi mokonzi mpo na libela ! »","poem":1},{"text":"Kasi motema na yo ekanisaki te tina ya makambo oyo","poem":2},{"lineBreak":true},{"text":"mpe ndenge nini ekosukela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yoka sik’oyo, yo mwasi ya biyenga,","poem":1},{"text":"oyo omesana kovanda na kimia","poem":2},{"text":"mpe omilobelaka : « Ngai nde nazali, mosusu azali te.","poem":1},{"text":"Nakotikala kokoma te mwasi akufisa mobali","poem":2},{"lineBreak":true},{"text":"mpe nakotikala kokufisa bana te ! »","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Makambo mibale oyo ekokomela yo","poem":1},{"text":"mbala moko mpe kaka na mokolo moko :","poem":2},{"text":"kozanga bana mpe kokufisa mobali.","poem":1},{"text":"Makambo oyo eleka ndelo nde ekokomela yo,","poem":2},{"text":"ata kindoki na yo ezali makasi","poem":1},{"text":"mpe bakisi na yo ezali na nguya.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Otiaki elikya na makambo na yo ya mabe,","poem":1},{"text":"olobaki : « Moto moko te azali komona ngai ! »","poem":2},{"text":"Bwanya mpe mayele na yo epengwisaki yo","poem":1},{"text":"tango ozalaki komilobela : « Ngai nde nazali, mosusu azali te ! »","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Pasi ekokomela yo,","poem":1},{"text":"mpe okoyeba te ndenge ya kolongola yango ;","poem":2},{"text":"mikakatano ekokomela yo","poem":1},{"text":"mpe okokoka komibatela te ;","poem":2},{"lineBreak":true},{"text":"libebi oyo oyebaki te ekokomela yo na pwasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kangama kaka na bonganga","poem":1},{"text":"mpe na kindoki na yo, oyo omonelaka pasi","poem":2},{"text":"wuta bolenge na yo !","poem":1},{"text":"Tango mosusu okozwela yango litomba,","poem":2},{"lineBreak":true},{"text":"tango mosusu okokoka kobangisa bato.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Batoli nyonso oyo osili kozwa","poem":1},{"text":"epai na bango elembisi yo nzoto !","poem":2},{"text":"Tika ete bato ya soloka oyo bayekolaka","poem":1},{"text":"bikelamu nyonso ya likolo : moyi, sanza, minzoto mpe biloko mosusu,","poem":2},{"text":"mpe bayebisaka na ebandeli nyonso ya sanza makambo oyo ekoya,","poem":1},{"text":"batelema wana mpe babikisa yo !","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tala, bakozala solo lokola matiti ya kokawuka,","poem":1},{"text":"matiti oyo moto ekotumba ;","poem":2},{"text":"bakokoka kobikisa ata milimo na bango moko te","poem":1},{"text":"na nguya ya moto :","poem":2},{"text":"Ekozala lisusu te lokola makala ya moto mpo na koyetola","poem":1},{"text":"to moto mpo na kovanda zingazinga na yango.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ezali bongo nde bakokoma liboso na yo,","poem":1},{"text":"bato nyonso oyo ozalaki komonela pasi,","poem":2},{"text":"mpe bato oyo ozalaki kosala elongo na bango","poem":1},{"text":"wuta bolenge na yo.","poem":2},{"text":"Moko na moko na bango akoyengayenga na ngambo na ye,","poem":1},{"text":"moko te akobikisa yo !","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}