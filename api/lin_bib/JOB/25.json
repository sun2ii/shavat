{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"JOB","translationId":"lin_bib","name":"Yobo","commonName":"Yobo","title":"Yobo","order":18,"numberOfChapters":42,"sha256":"11f46570803d0c2ffcb37ea1090224cd8194388232b38d488f1674789fc08b16","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lin_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["Maloba ya misato ya Bilidadi"]},{"type":"verse","number":1,"content":["Bilidadi, moto ya Shuwa, azwaki maloba mpe alobaki :"]},{"type":"verse","number":2,"content":[{"text":"« Bokonzi mpe somo ezali ya Nzambe ;","poem":1},{"text":"atiaka kimia na bisika na Ye ya likolo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Boni, bakoki kotanga mampinga na Ye ya lola ?","poem":1},{"text":"Na likolo ya nani pole ya Nzambe engengaka te ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndenge nini moto akoki kozala sembo na miso ya Nzambe ?","poem":1},{"text":"Ndenge nini moto oyo abotami na mwasi akoki kozala peto ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Soki kutu sanza ezali kongenga te,","poem":1},{"text":"mpe minzoto ezali peto te, na miso na Ye,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"toloba nini mpo na moto oyo azali se mutsopi,","poem":1},{"text":"mpo na mwana na moto oyo azali kaka nyama moke ya pamba ! »","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}