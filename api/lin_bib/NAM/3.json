{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"NAM","translationId":"lin_bib","name":"Naumi","commonName":"Naumi","title":"Naumi","order":34,"numberOfChapters":3,"sha256":"b7c1f1c24c1593b43f785ca2b691eb990623c9ac1d55d01c64888a98b1698125","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/lin_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["Engumba ya babomi ebebisami"]},{"type":"verse","number":1,"content":[{"text":"Mawa na engumba oyo mosala na yango","poem":1},{"text":"kosopa makila ya bato,","poem":2},{"text":"engumba oyo etonda","poem":1},{"text":"na makambo ya lokuta mpe na moyibi,","poem":2},{"lineBreak":true},{"text":"engumba oyo ezangaka te koboma bato !","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tango nyonso, kaka makelele ya bafimbu,","poem":1},{"text":"makelele ya bapine :","poem":2},{"text":"bampunda ezali kopumbwa,","poem":1},{"text":"mpe bashar ezali koningana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Basoda oyo batambolaka likolo ya bampunda","poem":1},{"text":"bazali kotambola-tambola,","poem":2},{"text":"mipanga ezali kongenga,","poem":1},{"text":"makonga ezali koleka-leka lokola mikalikali !","poem":2},{"text":"Bato bazali kozoka, kokufa ebele penza !","poem":1},{"text":"Bongo bibembe elali-lali bisika nyonso,","poem":2},{"text":"mpe makolo ya bato ekomi kotuta bibembe","poem":1},{"text":"tango bazali kotambola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Makambo oyo nyonso esalemi","poem":1},{"text":"likolo ya makambo ya nkele ya engumba","poem":2},{"text":"oyo etonda na kindumba,","poem":1},{"text":"engumba ya kitoko makasi","poem":2},{"text":"kasi etonda na misala ya soloka,","poem":1},{"text":"engumba oyo epengwisaka bikolo","poem":2},{"text":"na nzela ya kindumba na yango","poem":1},{"text":"mpe epengwisaka bato","poem":2},{"lineBreak":true},{"text":"na nzela ya misala na yango ya soloka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"« Natombokeli yo, »","poem":1},{"text":"elobi Yawe, Mokonzi ya mampinga ;","poem":2},{"text":"« nakotombola yo elamba kino na elongi,","poem":1},{"text":"nakolakisa bolumbu na yo","poem":2},{"text":"na miso ya bikolo mosusu","poem":1},{"text":"mpe nakoyokisa yo soni","poem":2},{"lineBreak":true},{"text":"na miso ya bamboka nyonso.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nakobwakela yo bosoto,","poem":1},{"text":"nakosambwisa yo","poem":2},{"lineBreak":true},{"text":"mpe nakokomisa yo eloko ya maseki.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bato nyonso oyo bakomona yo","poem":1},{"text":"bakokima mpe bakoganga :","poem":2},{"text":"‹ Engumba Ninive ebebisami boye !","poem":1},{"text":"Nani akoyokela yango mawa ? › »","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Boni, okanisi ete ozali kitoko","poem":1},{"text":"koleka engumba Tebesi","poem":2},{"text":"oyo ezalaka pembeni ya ebale Nili","poem":1},{"text":"mpe ezingelama na mayi,","poem":2},{"text":"bongo ebale ebatelaka yango","poem":1},{"text":"mpe mayi ezalaka lokola mir","poem":2},{"lineBreak":true},{"text":"oyo ebombaka yango ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Makasi na yango ezalaki kowuta","poem":1},{"text":"na Kushi mpe na Ejipito ;","poem":2},{"lineBreak":true},{"text":"bato ya Puti mpe ya Libi bazalaki kosunga yango.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nzokande, yango mpe ekweyaki,","poem":1},{"text":"mpe bamemaki bato na yango na bowumbu.","poem":2},{"text":"Bakataki-kataki na biteni","poem":1},{"text":"bana na bango na babalabala nyonso,","poem":2},{"text":"babetaki zeke mpo na kopona","poem":1},{"text":"bato na yango ya lokumu","poem":2},{"text":"mpo ete bamema bango na bowumbu,","poem":1},{"text":"mpe bakangaki bakambi na yango minyololo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yo mpe okokoma lokola moto","poem":1},{"text":"oyo alangwe masanga,","poem":2},{"text":"yo mpe okoluka ekimelo","poem":1},{"text":"mpo na kokima banguna na yo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bandako na yo nyonso, oyo batonga makasi","poem":1},{"text":"ezali lokola banzete ya figi etonda","poem":2},{"text":"na bambuma ya liboso ekomela ;","poem":1},{"text":"soki kaka bameki koningisa yango,","poem":2},{"lineBreak":true},{"text":"bambuma ekweyaka kino na monoko ya moto ya lokoso.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tala malamu mampinga na yo,","poem":1},{"text":"balemba lokola basi ;","poem":2},{"text":"bikuke ya mokili na yo ezali polele","poem":1},{"text":"liboso ya banguna na yo,","poem":2},{"lineBreak":true},{"text":"pamba te moto ezikisi bikangelo na yango.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bino bato ya engumba oyo,","poem":1},{"text":"bomitokela libela mayi","poem":2},{"text":"mpo ete bakozingela bino ;","poem":1},{"text":"bolendisa libela bamir","poem":2},{"text":"oyo ebatelaka engumba na bino ;","poem":1},{"text":"bokamata mabele oyo batongelaka bandako,","poem":2},{"text":"bosangisa yango mpo ete ekoma potopoto,","poem":1},{"text":"bongo bobeta babiliki mpe botumba yango.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kuna nde moto ekoya kozikisa yo,","poem":1},{"text":"mopanga ekoya koboma yo","poem":2},{"text":"mpe kosilisa yo lokola mabanki.","poem":1},{"text":"Tika ete bato na yo bakoma ebele lokola mabanki,","poem":2},{"lineBreak":true},{"text":"bakoma lisusu ebele makasi lokola mankoko.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Okomisi motango ya bato na yo ya mombongo","poem":1},{"text":"ebele koleka ata minzoto ya likolo,","poem":2},{"text":"kasi babebisi mokili nyonso","poem":1},{"text":"mpe bapumbwe na bango","poem":2},{"lineBreak":true},{"text":"ndenge kaka mankoko esalaka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bakengeli na yo bazali lokola mankoko,","poem":1},{"text":"bakonzi ya basoda na yo bazali","poem":2},{"text":"lokola maboke ya mabanki","poem":1},{"text":"oyo eyaka kovanda na bamir ya lopango","poem":2},{"text":"na tango ya malili ;","poem":1},{"text":"kasi soki kaka moyi ebimi, yango nyonso epanzani,","poem":2},{"lineBreak":true},{"text":"mpe moto moko te ayebaka esika yango ekendaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Oh mokonzi ya Asiri,","poem":1},{"text":"bakambi na yo bazali kolala pongi,","poem":2},{"text":"basoda na yo ya mpiko balali pongi ya makasi,","poem":1},{"text":"mampinga na yo bapalangani na bangomba","poem":2},{"lineBreak":true},{"text":"mpe moto akosangisa bango azali komonana te.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ezali ata na kisi moko te","poem":1},{"text":"oyo ekoki kobikisa pota na yo ;","poem":2},{"text":"pota na yo ezali monene makasi !","poem":1},{"text":"Moto nyonso oyo akoyoka sango","poem":2},{"text":"ya makambo oyo ekomeli yo","poem":1},{"text":"akobeta maboko mpo na kokweyisama na yo.","poem":2},{"lineBreak":true},{"text":"Pamba te nani oyo ozangaki kosala mabe ?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}