{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":1,"content":[{"type":"heading","content":["Mibeko ya Yawe ezali etima ya mapamboli"]},{"type":"verse","number":1,"content":[{"text":"Esengo na moto oyo alandaka te toli ya bato mabe,","poem":1},{"lineBreak":true},{"text":"atelemaka te na nzela ya bato ya masumu,","poem":1},{"text":"mpe avandaka te esika moko na batioli,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kasi asepelaka na mibeko ya Yawe","poem":1},{"text":"mpe akanisaka yango butu mpe moyi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Azali lokola nzete oyo balona pene ya mayi,","poem":1},{"text":"oyo ebotaka mbuma na eleko na yango,","poem":2},{"text":"mpe makasa na yango ekawukaka te ;","poem":1},{"text":"misala na ye nyonso etambolaka malamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kasi ezali bongo te mpo na bato mabe !","poem":1},{"text":"Bazali lokola matiti ya kokawuka","poem":2},{"lineBreak":true},{"text":"oyo mopepe epanzaka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yango wana bato mabe bakolonga te","poem":1},{"text":"kotelema na kosambisama,","poem":2},{"text":"mpe bato ya masumu bakowumelaka te","poem":1},{"text":"kati na lisanga ya bato ya sembo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Solo, Yawe ayebi nzela ya bato ya sembo,","poem":1},{"text":"kasi nzela ya bato mabe ememaka na libebi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}