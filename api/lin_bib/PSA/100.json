{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":100,"content":[{"type":"heading","content":["Yawe asanzolamaka kati na bato na Ye"]},{"type":"verse","number":1,"content":[{"text":"Nzembo ya kozongisa matondi.","descriptive":true},{"text":"Bino nyonso bato ya mokili mobimba,","poem":1},{"text":"boganga na esengo epai na Yawe !","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bosalela Yawe na esengo,","poem":1},{"text":"mpe boya liboso na Ye na banzembo ya esengo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Boyeba ete Yawe nde azali Nzambe ;","poem":1},{"text":"Ye nde asala biso, mpe tozali bato na Ye.","poem":2},{"lineBreak":true},{"text":"Solo, tozali bato na Ye mpe etonga oyo aleisaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bokota na bikuke na Ye na kozongisa matondi,","poem":1},{"text":"bokota na lopango na Ye na kokumisa.","poem":2},{"lineBreak":true},{"text":"Bosanzola Ye, bopambola Kombo na Ye.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pamba te Yawe azali malamu ;","poem":1},{"text":"bolingo na Ye ewumelaka seko na seko,","poem":2},{"lineBreak":true},{"text":"mpe boyengebene na Ye, libela na libela.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}