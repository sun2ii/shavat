{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":102,"content":[{"type":"heading","content":["Libondeli ya moto na pasi"]},{"type":"verse","number":1,"content":[{"text":"Libondeli ya moto na pasi, oyo abungisi elikya mpe azali kolela liboso ya Yawe.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Yawe, yoka libondeli na ngai !","poem":1},{"text":"Tika ete koganga na ngai ekoma kino epai na Yo !","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kobombela ngai elongi na Yo te,","poem":1},{"text":"wana nazali na pasi.","poem":2},{"text":"Yoka libondeli na ngai","poem":1},{"text":"na mokolo oyo nazali kobelela Yo ;","poem":2},{"lineBreak":true},{"text":"yanola ngai noki !","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Pamba te mikolo ya bomoi na ngai ezali kolimwa","poem":1},{"text":"lokola molinga,","poem":2},{"text":"mikuwa na ngai ezali kozika","poem":1},{"text":"lokola makala ya moto.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Motema na ngai ebungisi elikya","poem":1},{"text":"mpe ezali komitungisa lokola matiti oyo bakati ;","poem":2},{"text":"mpo na yango, nakomi ata kobosana","poem":1},{"text":"kolia bilei na ngai.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mpo ete naleli makasi,","poem":1},{"text":"natikali kaka na poso ya nzoto likolo ya mikuwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nakomi lokola esulungutu ya esobe,","poem":1},{"text":"lokola esulungutu ya bisika oyo ebeba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pongi ekimi ngai ;","poem":1},{"text":"nakomi lokola ndeke oyo etikali yango moko","poem":2},{"lineBreak":true},{"text":"na likolo ya ndako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Banguna na ngai batombokeli ngai,","poem":1},{"text":"bazali kofinga ngai tango nyonso","poem":2},{"text":"mpe bazali kosalela kombo na ngai","poem":1},{"text":"mpo na kolakela bato mabe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nakomi kolia putulu na esika ya bilei,","poem":1},{"text":"mpe komela mayi esangana na mpinzoli na ngai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mpo na kanda monene na Yo,","poem":1},{"text":"otombokeli ngai mpe obwaki ngai mosika.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mikolo ya bomoi na ngai ezali kokima lokola elili,","poem":1},{"text":"mpe nakawuki lokola matiti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kasi Yo Yawe, ozali Mokonzi","poem":1},{"text":"mpo na libela,","poem":2},{"lineBreak":true},{"text":"ozali Nzambe seko na seko.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Okotelema solo mpo na Siona,","poem":1},{"text":"pamba te ekomi tango ya koyokela yango mawa ;","poem":2},{"lineBreak":true},{"text":"tango oyo ekatama ekoki.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Pamba te biso basali na Yo, tosepelaka","poem":1},{"text":"na mabanga na yango,","poem":2},{"lineBreak":true},{"text":"mpe toyokelaka putulu na yango mawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bikolo ekotosa Yawe,","poem":1},{"text":"mpe bakonzi nyonso ya mokili bakondima","poem":2},{"lineBreak":true},{"text":"nkembo na Yo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Pamba te Yawe akotonga lisusu Siona","poem":1},{"text":"mpe akomonana kati na nkembo na Ye.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Akoyanola libondeli ya bato","poem":1},{"text":"oyo babungisaki biloko,","poem":2},{"lineBreak":true},{"text":"mpe akondima mabondeli na bango.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Tika ete bakoma yango","poem":1},{"text":"mpo na ekeke oyo ekolanda,","poem":2},{"lineBreak":true},{"text":"mpo ete bikelamu ya sika ekumisa Yawe.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wuta na Esika na Ye ya bule,","poem":1},{"text":"wuta na likolo, Yawe atalaki biso","poem":2},{"lineBreak":true},{"text":"awa na mokili","poem":2}]},{"type":"verse","number":21,"content":[{"text":"mpo na koyoka kolela ya bakangami","poem":1},{"text":"kati na boloko","poem":2},{"lineBreak":true},{"text":"mpe kokangola bato oyo bazwaki etumbu ya kufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kombo ya Yawe ekokende sango","poem":1},{"text":"kati na Siona,","poem":2},{"lineBreak":true},{"text":"mpe masanzoli na Ye, kati na Yelusalemi","poem":2}]},{"type":"verse","number":23,"content":[{"text":"tango bato mpe bikolo bakosangana","poem":1},{"text":"mpo na kogumbamela Yawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Na bomoi na ngai, abukaki lolendo","poem":1},{"text":"ya makasi na ngai,","poem":2},{"lineBreak":true},{"text":"mpe akitisaki motango ya mikolo ya bomoi na ngai.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nalobaki :","poem":1},{"text":"« Nzambe na ngai,","poem":2},{"text":"Yo oyo ozali na bomoi seko na seko,","poem":1},{"text":"koboma ngai te na kati-kati ya mikolo","poem":2},{"lineBreak":true},{"text":"ya bomoi na ngai !","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Na kala, otiaki miboko ya mokili,","poem":1},{"text":"mpe maboko na Yo esalaki Likolo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bango, bakokufa ;","poem":1},{"text":"kasi Yo, okotikala seko na seko.","poem":2},{"text":"Nzoto na bango ekolemba lokola elamba ;","poem":1},{"text":"okobongola bango lokola kazaka, mpe bakolimwa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kasi Yo, ozali ndenge moko,","poem":1},{"text":"mibu na Yo ekotikala kosuka te.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Bana ya basali na Yo bakozwa esika ya kovanda,","poem":1},{"text":"mpe bakitani na bango bakowumela liboso na Yo. »","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":29}