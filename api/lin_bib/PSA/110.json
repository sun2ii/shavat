{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":110,"content":[{"type":"heading","content":["Mokonzi mpe Nganga-Nzambe"]},{"type":"verse","number":1,"content":[{"text":"Nzembo ya Davidi.","descriptive":true},{"text":"Maloba ya Yawe epai ya nkolo na ngai :","poem":1},{"text":"« Vanda na ngambo ya loboko na Ngai ya mobali","poem":2},{"lineBreak":true},{"text":"kino nakomisa banguna na yo enyatelo makolo na yo. »","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wuta na Siona, Yawe akosala","poem":1},{"text":"ete nguya na yo ya bokonzi ekende mosika,","poem":2},{"lineBreak":true},{"text":"mpe okokonza kati na banguna na Yo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Na mokolo oyo okotanda basoda na yo","poem":1},{"text":"na molongo mpo na bitumba,","poem":2},{"text":"bato na yo bakotonda na mpiko,","poem":1},{"text":"bilenge basoda na yo nyonso bakoya na lombangu","poem":2},{"lineBreak":true},{"text":"epai na yo ndenge mamwe ebimaka na tongo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawe alapaki ndayi oyo,","poem":1},{"text":"akobongola maloba na Ye te :","poem":2},{"text":"« Ozali Nganga-Nzambe mpo na libela","poem":1},{"text":"kolanda molongo ya Melishisedeki ! »","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nkolo azali na ngambo ya loboko na yo ya mobali,","poem":1},{"text":"akopanza bakonzi na mokolo ya kanda na Ye.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Akopesa bikolo etumbu :","poem":1},{"text":"bikolo nyonso ekotonda na bibembe,","poem":2},{"lineBreak":true},{"text":"mpe akonyata bakambi kati na mokili mobimba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Na nzela, mokonzi amelaka mayi na mwa moluka ;","poem":1},{"text":"yango wana atombolaka moto.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}