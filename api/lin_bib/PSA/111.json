{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":111,"content":[{"type":"heading","content":["Mosali makambo ya kokamwa"]},{"type":"verse","number":1,"content":[{"text":"Bokumisa Yawe !","poem":1},{"lineBreak":true},{"text":"Nakokumisa Yawe","poem":1},{"text":"na motema na ngai mobimba","poem":2},{"text":"kati na likita ya bato ya sembo","poem":1},{"text":"mpe kati na mayangani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yawe asalaka makambo minene ;","poem":1},{"text":"bato nyonso oyo balingaka yango","poem":2},{"lineBreak":true},{"text":"bakanisaka yango.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Misala na Ye emonisaka","poem":1},{"text":"nkembo mpe lokumu na Ye,","poem":2},{"lineBreak":true},{"text":"mpe bosembo na Ye ewumelaka libela na libela.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Alingaka ete bakanisa bikamwa na Ye.","poem":1},{"text":"Yawe atondi na mawa","poem":2},{"lineBreak":true},{"text":"mpe atalisaka ngolu na Ye.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Apesaka bato oyo batosaka Ye bilei ;","poem":1},{"text":"akanisaka Boyokani na Ye tango nyonso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Amonisaki nguya na Ye epai ya bato na Ye","poem":1},{"text":"na nzela ya misala na Ye","poem":2},{"text":"tango apesaki bango libula","poem":1},{"text":"ya bato ya bikolo mosusu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Misala na Ye nyonso elakisaka","poem":1},{"text":"boyengebene mpe bosembo na Ye ;","poem":2},{"lineBreak":true},{"text":"mibeko na Ye nyonso ebongi na kondima yango.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Epesama mpo na libela,","poem":1},{"text":"mpe esengeli kotosa yango","poem":2},{"lineBreak":true},{"text":"na bosembo mpe na bosolo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akangolaki bato na Ye,","poem":1},{"text":"mpe asalaki Boyokani ya libela elongo na bango.","poem":2},{"lineBreak":true},{"text":"Azali Nzambe Mosantu mpe Nzambe ya somo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kotosa Yawe ezali mosisa ya bwanya ;","poem":1},{"text":"bato nyonso oyo batosaka Yawe","poem":2},{"text":"bazali na mayele ya peto.","poem":1},{"text":"Lokumu ya Yawe ezali ya libela na libela.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}