{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":112,"content":[{"type":"heading","content":["Bolamu ya bayengebene"]},{"type":"verse","number":1,"content":[{"text":"Bokumisa Yawe !","poem":1},{"lineBreak":true},{"text":"Esengo na moto oyo atosaka Yawe","poem":1},{"text":"mpe asepelaka makasi na mibeko na Ye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bana na ye bakozala bato na nguya","poem":1},{"text":"kati na mokili ;","poem":2},{"lineBreak":true},{"text":"ekeke ya bato ya sembo ekopambolama.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndako na ye ezali na bokolongono","poem":1},{"text":"mpe na bomengo,","poem":2},{"lineBreak":true},{"text":"mpe bosembo na ye ewumelaka mpo na seko.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pole engengaka kati na molili","poem":1},{"text":"mpo na bato ya alima,","poem":2},{"text":"mpo na moto oyo alimbisaka baninga,","poem":1},{"text":"ayokelaka bato mawa mpe azali sembo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Esengo na moto oyo","poem":1},{"text":"ayokelaka bato mawa mpe adefisaka,","poem":2},{"lineBreak":true},{"text":"mpe asalaka misala na ye kolanda bosembo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Solo, aninganaka ata moke te.","poem":1},{"text":"Bakanisaka misala ya moto ya sembo tango nyonso.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abangaka basango ya mabe te ;","poem":1},{"text":"motema na ye ezali na kimia,","poem":2},{"lineBreak":true},{"text":"atiaka elikya na ye kati na Yawe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Motema na ye eninganaka te,","poem":1},{"text":"abangaka te kino akomona banguna na ye","poem":2},{"lineBreak":true},{"text":"kozwa etumbu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akabelaka babola na motema ya esengo ;","poem":1},{"text":"bosembo na ye ewumelaka libela na libela,","poem":2},{"lineBreak":true},{"text":"lokumu na ye ekitaka te.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Moto mabe amonaka yango","poem":1},{"text":"mpe asilikaka na zuwa,","poem":2},{"text":"aliaka minu mpe alembaka nzoto.","poem":1},{"text":"Posa ya bato mabe elimwaka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}