{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":113,"content":[{"type":"heading","content":["Moko te akokani na Nzambe"]},{"type":"verse","number":1,"content":[{"text":"Bokumisa Yawe !","poem":1},{"lineBreak":true},{"text":"Bino basali ya Yawe, bokumisa Ye ;","poem":1},{"text":"bokumisa Yawe !","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tika ete Kombo ya Yawe epambolama","poem":1},{"text":"kobanda sik’oyo kino libela na libela !","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Longwa na este kino na weste,","poem":1},{"text":"tika ete Kombo ya Yawe epambolama !","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawe azali na likolo ya bikolo nyonso,","poem":1},{"text":"nkembo na Ye ezali na likolo koleka Lola.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nani akokani na Yawe, Nzambe na biso,","poem":1},{"text":"oyo avandi na Kiti ya Bokonzi","poem":2},{"lineBreak":true},{"text":"kati na bisika oyo eleki likolo ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Agumbamaka mpo na kotala","poem":1},{"text":"likolo mpe mokili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wuta na putulu, atombolaka","poem":1},{"text":"moto oyo akelela ;","poem":2},{"text":"wuta na fulu ya matiti,","poem":1},{"text":"abimisaka mobola","poem":2}]},{"type":"verse","number":8,"content":[{"text":"mpo na kovandisa ye esika moko na bakambi,","poem":1},{"text":"na bankumu ya bato na Ye.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Avandisaka mwasi ekomba kati na ndako na ye,","poem":1},{"text":"lokola mama ya esengo kati na bana na ye.","poem":2},{"lineBreak":true},{"text":"Bokumisa Yawe !","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}