{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":114,"content":[{"type":"heading","content":["Tango Isalaele abimaki wuta na Ejipito"]},{"type":"verse","number":1,"content":[{"text":"Tango Isalaele abimaki wuta na Ejipito,","poem":1},{"text":"tango libota ya Jakobi elongwaki","poem":2},{"lineBreak":true},{"text":"na ekolo ya bapaya,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yuda ekomaki Esika ya bule ya Yawe,","poem":1},{"text":"mpe Isalaele ekomaki mabele na Ye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ebale monene emonaki yango mpe ekimaki,","poem":1},{"text":"mayi ya Yordani ezongaki na sima,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"bangomba epumbwaki lokola bameme,","poem":1},{"text":"bangomba mike epumbwaki lokola bana ya ntaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ebale monene, nini ezalaki kati na yo","poem":1},{"text":"mpo ete okima ?","poem":2},{"lineBreak":true},{"text":"Yordani, mpo na nini ozongaki na sima ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bino bangomba, mpo nini bopumbwaki","poem":1},{"text":"lokola bameme ?","poem":2},{"text":"Bongo bino bangomba mike, mpo na nini bopumbwaki","poem":1},{"text":"lokola bana ya ntaba ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mokili, lenga liboso ya Yawe,","poem":1},{"text":"liboso ya Nzambe ya Jakobi,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"oyo abongolaka libanga monene liziba,","poem":1},{"text":"mpe libanga etima.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}