{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":116,"content":[{"type":"heading","content":["Yawe ayokaka ngai"]},{"type":"verse","number":1,"content":[{"text":"Nalingaka Yawe, pamba te ayokaka","poem":1},{"text":"mongongo mpe mabondeli na ngai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ayokaki ngai ;","poem":1},{"text":"boye nakobelela Ye bomoi na ngai mobimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Minyololo ya kufa ezingelaki ngai,","poem":1},{"text":"somo ya mboka ya bakufi ekangaki ngai ;","poem":2},{"lineBreak":true},{"text":"nakomaki moto ya pasi mpe ya mawa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kasi nabelelaki Kombo ya Yawe :","poem":1},{"text":"« Yawe, nabondeli Yo, bikisa ngai ! »","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yawe asalaka ngolu mpe azali sembo,","poem":1},{"text":"Nzambe na biso ayokelaka bato mawa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yawe abatelaka bato oyo bazangi mayele.","poem":1},{"text":"Nalembaki nzoto, kasi abikisi ngai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Molimo na ngai, zongela kimia na yo,","poem":1},{"text":"pamba te Yawe asaleli yo bolamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Solo, okangoli ngai na kufa,","poem":1},{"text":"okawusi mpinzoli na ngai","poem":2},{"lineBreak":true},{"text":"mpe obateli makolo na ngai ete ekweya te.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nakotambola liboso ya Yawe","poem":1},{"text":"kati na mokili ya bato ya bomoi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Solo, nazalaka na elikya, ezala soki nalobaka :","poem":1},{"text":"« Nazali moto na pasi makasi. »","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kati na mitungisi na ngai, nazalaki komilobela :","poem":1},{"text":"« Bato nyonso bazali bakosi. »","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nini nakoki kozongisela Yawe","poem":1},{"text":"mpo na bolamu na Ye nyonso epai na ngai ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nakotombola kopo ya elonga","poem":1},{"text":"mpe nakobelela Kombo ya Yawe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nakokokisa bandayi na ngai epai na Yawe","poem":1},{"text":"na miso ya bato na Ye nyonso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kufa ya bayengebene ya Yawe","poem":1},{"text":"ezali na motuya makasi na miso na Ye.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yawe, yoka ngai, nazali mosali na Yo.","poem":1},{"text":"Nazali mosali na Yo,","poem":2},{"text":"mwana mobali ya mwasi mosali na Yo.","poem":1},{"text":"Ofungoli minyololo oyo ekangaki ngai.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nakobonzela Yo mbeka","poem":1},{"text":"mpo na kozongisa matondi,","poem":2},{"lineBreak":true},{"text":"mpe nakobelela Kombo ya Yawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Nakokokisa bandayi na ngai epai na Yawe","poem":1},{"text":"na miso ya bato na Ye nyonso,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"kati na lopango ya Tempelo ya Yawe ;","poem":1},{"text":"kati na yo, Yelusalemi.","poem":2},{"lineBreak":true},{"text":"Bokumisa Yawe !","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}