{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":120,"content":[{"type":"heading","content":["Kangola ngai"]},{"type":"verse","number":1,"content":[{"text":"Nzembo ya mobembo tango bazalaki kokende na Tempelo ya Yawe.","descriptive":true},{"text":"Kati na pasi na ngai, nabelelaki Yawe,","poem":1},{"text":"mpe ayanolaki ngai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Oh Yawe, kangola ngai","poem":1},{"text":"wuta na maboko ya bakosi","poem":2},{"lineBreak":true},{"text":"mpe wuta na lolemo ya lokuta !","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yo, lolemo ya lokuta,","poem":1},{"text":"Yawe akopesa yo nini,","poem":2},{"lineBreak":true},{"text":"akofuta yo nini ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Akobeta yo na makonga ya elombe ya bitumba,","poem":1},{"text":"oyo ezali ya songe,","poem":2},{"lineBreak":true},{"text":"elongo na makala ya moto ya nzete ya nzube.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mawa na ngai, mpo ete navandi","poem":1},{"text":"lokola mopaya kati na Mesheki,","poem":2},{"lineBreak":true},{"text":"kati na bandako ya kapo ya Kedari.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Navandaki tango molayi","poem":1},{"text":"kati na bato oyo balingaka kimia te.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngai, nazali moto ya kimia ;","poem":1},{"text":"kasi soki kaka nameki koloba na tina na kimia,","poem":2},{"lineBreak":true},{"text":"bango baponaka mbala moko bitumba.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}