{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":121,"content":[{"type":"heading","content":["Yawe, Mosungi mpe Mobateli na ngai"]},{"type":"verse","number":1,"content":[{"text":"Nzembo ya mobembo tango bazalaki kokende na Tempelo ya Yawe.","descriptive":true},{"text":"Natomboli miso na ngai na ngambo ya bangomba :","poem":1},{"text":"lisungi na ngai ekowuta wapi ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lisungi na ngai ewutaka na Yawe","poem":1},{"text":"oyo akela likolo mpe mabele.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Akotika te ete lokolo na yo eselumuka ;","poem":1},{"text":"Ye oyo abatelaka yo animbaka te.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Te, Ye oyo abatelaka Isalaele","poem":1},{"text":"animbaka te mpe alalaka pongi te !","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawe azali mobateli na yo ;","poem":1},{"text":"Yawe azali, na ngambo ya loboko na yo ya mobali,","poem":2},{"lineBreak":true},{"text":"lokola elili oyo ebatelaka yo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ezala na moyi to na butu,","poem":1},{"text":"moyi mpe sanza ekosala yo mabe ata moke te !","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yawe akobatela yo na mabe nyonso,","poem":1},{"text":"akobatela bomoi na yo ;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yawe akobatela kokende","poem":1},{"text":"mpe kozonga na yo,","poem":2},{"lineBreak":true},{"text":"sik’oyo mpe libela na libela.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}