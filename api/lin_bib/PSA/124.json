{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":124,"content":[{"type":"heading","content":["Lisungi na biso ewutaka epai ya Yawe"]},{"type":"verse","number":1,"content":[{"text":"Nzembo ya Davidi. Nzembo ya mobembo mpo na kokende na Tempelo ya Yawe.","descriptive":true},{"text":"Soki Yawe abatelaki biso te ;","poem":1},{"text":"tika ete Isalaele aloba bongo !","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Soki Yawe abatelaki biso te","poem":1},{"text":"tango bato babundisaki biso,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"mbele bamelaki biso ya bomoi","poem":1},{"text":"tango basilikelaki biso makasi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Boye mayi elingaki kozindisa biso,","poem":1},{"text":"mbonge makasi elingaki komema biso.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mayi makasi elingaki kozindisa biso.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tika ete Yawe apambolama,","poem":1},{"text":"Ye oyo andimaki te ete minu na bango epasola biso !","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tobikaki lokola ndeke liboso ya motambo","poem":1},{"text":"ya mokangi bandeke ;","poem":2},{"lineBreak":true},{"text":"motambo ekatanaki, mpe tokimaki.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lisungi na biso ezali kati na Kombo na Yawe","poem":1},{"text":"oyo akela likolo mpe mabele.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}