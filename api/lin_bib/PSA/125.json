{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":125,"content":[{"type":"heading","content":["Kimia ya solo"]},{"type":"verse","number":1,"content":[{"text":"Nzembo ya mobembo mpo na kokende na Ndako ya Yawe.","descriptive":true},{"text":"Bato oyo batiaka elikya kati na Yawe","poem":1},{"text":"bazali lokola ngomba Siona oyo eninganaka te,","poem":2},{"lineBreak":true},{"text":"oyo epikama mpo na libela.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndenge bangomba ezingeli Yelusalemi,","poem":1},{"text":"ndenge wana mpe Yawe azingeli bato na Ye,","poem":2},{"lineBreak":true},{"text":"kobanda sik’oyo kino libela na libela.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bokonzi ya mabe ekowumela te na etuka ya bato ya sembo,","poem":1},{"text":"mpo ete basangana te na mabe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawe, zala malamu mpo na bato malamu","poem":1},{"text":"mpe mpo na bato oyo bazali alima na mitema !","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kasi tika ete Yawe abengana","poem":1},{"text":"bato ya kilikili elongo na bato ya misala mabe !","poem":2},{"lineBreak":true},{"text":"Tika ete kimia ezala na Isalaele !","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}