{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":126,"content":[{"type":"heading","content":["Tango ya kolona mpe tango ya kobuka"]},{"type":"verse","number":1,"content":[{"text":"Nzembo ya mobembo mpo na kokende na Tempelo ya Yawe.","descriptive":true},{"text":"Tango Yawe azongisaki bato ya Siona","poem":1},{"text":"longwa na bowumbu,","poem":2},{"lineBreak":true},{"text":"tozalaki lokola bato oyo bazali kolota ndoto.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Boye, tozalaki koganga mpe koyemba na esengo.","poem":1},{"text":"Bongo, maloba oyo ekomaki kolobama kati na bikolo :","poem":2},{"lineBreak":true},{"text":"« Yawe asaleli bango makambo minene ! »","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Solo, Yawe asaleli biso makambo minene,","poem":1},{"text":"mpe tozali kosepela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawe, yaka kobongisa makambo na biso","poem":1},{"text":"ndenge kaka otondisaka lisusu miluka ya Negevi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bato oyo balonaka na mpinzoli","poem":1},{"text":"babukaka na banzembo ya esengo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Moto oyo akendaka na kolela,","poem":1},{"text":"tango amemi milona na ye,","poem":2},{"text":"azongaka na esengo","poem":1},{"text":"wana amemi maboke na ye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}