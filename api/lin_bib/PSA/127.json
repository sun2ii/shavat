{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":127,"content":[{"type":"heading","content":["Nani asalaka nyonso"]},{"type":"verse","number":1,"content":[{"text":"Nzembo ya Salomo. Nzembo ya mobembo mpo na kokende na Tempelo ya Yawe.","descriptive":true},{"text":"Soki Yawe atongi ndako te,","poem":1},{"text":"batongi ndako bazali kosala mosala ya pamba ;","poem":2},{"text":"soki Yawe akengeli engumba te,","poem":1},{"text":"bakengeli bazali kosala na pamba.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ezali na pamba nde, bino mpe,","poem":1},{"text":"bolamukaka na tongo makasi,","poem":2},{"text":"bolalaka noki te mpe bosalaka makasi","poem":1},{"text":"mpo na kozwa bilei ;","poem":2},{"text":"pamba te Nzambe apesaka bilei yango","poem":1},{"text":"kaka na balingami na Ye,","poem":2},{"lineBreak":true},{"text":"wana bazali nanu kolala pongi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bana bazali libula kowuta na Yawe,","poem":1},{"text":"mpe kobota bana ezali lifuti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndenge makonga ezali kati na maboko ya mobundi bitumba,","poem":1},{"text":"ndenge wana mpe bana oyo moto aboti","poem":2},{"lineBreak":true},{"text":"na bolenge na ye bazali.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Esengo na moto oyo atondisi makonga","poem":1},{"text":"kati na ebombelo na ye ya makonga !","poem":2},{"text":"Akokufa soni ata moke te","poem":1},{"text":"tango akosamba elongo na banguna na ye","poem":2},{"lineBreak":true},{"text":"na ekuke ya engumba.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}