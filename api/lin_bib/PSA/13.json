{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":13,"content":[{"type":"heading","content":["Kobanga mpe kolikya"]},{"type":"verse","number":1,"content":[{"text":"Wuta na buku ya mokambi ya bayembi. Nzembo ya Davidi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Yawe, kino tango nini okobosana ngai mpo na libela ?","poem":1},{"text":"Kino tango nini okobomba elongi na Yo mpo ete namona Yo te ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kino tango nini nakozala mawa-mawa","poem":1},{"text":"kati na motema na ngai","poem":2},{"text":"mpe nakomitungisa mikolo nyonso ?","poem":1},{"text":"Kino tango nini monguna na ngai akolonga ngai ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawe, Nzambe na ngai, tala mpe yanola ngai.","poem":1},{"text":"Sala ete miso na ngai emona malamu ;","poem":2},{"lineBreak":true},{"text":"soki te, nakokufa,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"bongo monguna na ngai akoloba :","poem":1},{"text":"« Nalongi ye, »","poem":2},{"lineBreak":true},{"text":"mpe bayini na ngai bakosepela soki nakweyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kasi ngai, natie elikya na ngai kati na bolingo na Yo,","poem":1},{"text":"mpe motema na ngai ezali kosepela kati na lobiko na Yo.","poem":2},{"text":"Nakoyemba mpo na lokumu ya Yawe,","poem":1},{"text":"pamba te asaleli ngai bolamu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}