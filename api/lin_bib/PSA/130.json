{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":130,"content":[{"type":"heading","content":["Wuta na mozindo ya pasi"]},{"type":"verse","number":1,"content":[{"text":"Nzembo ya mobembo mpo na kokende na Ndako ya Nkolo.","descriptive":true},{"text":"Nkolo, nazali kobelela Yo wuta na mozindo ya pasi !","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nkolo, yoka ngai !","poem":1},{"text":"Yoka mabondeli na ngai !","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yawe, soki obosanaka masumu te,","poem":1},{"text":"Nkolo, nani akokaki kotelema ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kasi bolimbisi ezali epai na Yo,","poem":1},{"text":"yango wana basengeli kotosa Yo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Na motema na ngai mobimba,","poem":1},{"text":"nazali na elikya kati na Yawe,","poem":2},{"text":"nazali penza na elikya ;","poem":1},{"lineBreak":true},{"text":"nazali kozela maloba na Ye.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nazali na elikya kati na Nkolo","poem":1},{"text":"koleka kutu ndenge mokengeli azelaka kotana ya tongo,","poem":2},{"lineBreak":true},{"text":"koleka penza ndenge mokengeli azelaka kotana ya tongo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Isalaele, tia elikya kati na Yawe,","poem":1},{"text":"pamba te azali bolingo,","poem":2},{"lineBreak":true},{"text":"mpe kokangolama ya kokoka ezali elongo na Ye.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ye nde akokangola Isalaele","poem":1},{"text":"na bambeba na yango nyonso.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}