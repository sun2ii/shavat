{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":133,"content":[{"type":"heading","content":["Tango bandeko basangani"]},{"type":"verse","number":1,"content":[{"text":"Nzembo ya Davidi. Nzembo ya mobembo mpo na kokende na Tempelo ya Yawe.","descriptive":true},{"text":"Tala ndenge ezali malamu mpe ndenge ezali kitoko","poem":1},{"text":"mpo na bandeko kozala lisanga kati na bomoko !","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ezali lokola malasi ya motuya","poem":1},{"text":"oyo basopi na moto,","poem":2},{"text":"bongo ezali kokita na mandefu, na mandefu ya Aron,","poem":1},{"text":"ezali kokita kino na songe ya bilamba na ye.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ezali lokola mamwe ya Erimoni,","poem":1},{"text":"oyo ekitaka na bangomba ya Siona.","poem":2},{"text":"Pamba te kuna, Yawe apesaka lipamboli na Ye,","poem":1},{"text":"mpe bomoi, mpo na libela.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/134.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/132.json","previousChapterAudioLinks":{},"numberOfVerses":3}