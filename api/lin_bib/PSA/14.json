{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":14,"content":[{"type":"heading","content":["Mokili ezali ya kobeba"]},{"type":"verse","number":1,"content":[{"text":"Wuta na buku ya mokambi ya bayembi. Nzembo ya Davidi.","descriptive":true},{"text":"Bazoba bamilobelaka :","poem":1},{"text":"« Nzambe azali te. »","poem":2},{"text":"Makanisi na bango esila kobeba,","poem":1},{"text":"basalaka makambo ya nkele,","poem":2},{"lineBreak":true},{"text":"mpe moko te asalaka bolamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Wuta na Likolo, Yawe atalaka bato","poem":1},{"text":"mpo na koluka koyeba","poem":2},{"text":"soki ezali ata na moko oyo azali na mayele,","poem":1},{"text":"oyo atalelaka Nzambe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bango nyonso babunga nzela,","poem":1},{"text":"bango nyonso bamibebisa ;","poem":2},{"text":"moko te asalaka bolamu,","poem":1},{"text":"ata moto moko te !","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Boni, bato wana nyonso ya misala mabe bayebi eloko te ?","poem":1},{"lineBreak":true},{"text":"Bato baliaka bato na ngai ndenge baliaka lipa,","poem":1},{"text":"babelelaka Yawe te !","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Somo monene ekangi bango,","poem":1},{"text":"pamba te Nzambe azali kati na bato ya sembo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bino, bato ya misala mabe, bobebisaka mabongisi ya mobola","poem":1},{"text":"kasi Yawe azali ebombamelo na ye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tika ete lobiko ya Isalaele ebimela na Siona !","poem":1},{"text":"Tango Yawe akobongisa bato na Ye,","poem":2},{"lineBreak":true},{"text":"bakitani ya Jakobi bakosepela, mpe Isalaele ekozala na esengo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}