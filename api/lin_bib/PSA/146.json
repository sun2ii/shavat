{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":146,"content":[{"type":"heading","content":["Nzambe alongisaka banyokolami"]},{"type":"verse","number":1,"content":[{"text":"Bokumisa Yawe !","poem":1},{"lineBreak":true},{"text":"Oh molimo na ngai, kumisa Yawe !","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nakokumisa Yawe bomoi na ngai mobimba,","poem":1},{"text":"nakosanzola Nzambe na ngai tango nyonso","poem":2},{"lineBreak":true},{"text":"nakozala na bomoi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Botia elikya te na bakambi","poem":1},{"text":"to na bato oyo bazangi makoki ya kobikisa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Soki bakufi, bazongaka na mabele,","poem":1},{"text":"mpe, mbala moko, mabongisi na bango elimwaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Esengo na moto oyo Nzambe ya Jakobi azali mosungi na ye,","poem":1},{"text":"oyo atiaka elikya na ye kati na Yawe, Nzambe na ye !","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yawe akelaki Likolo mpe mabele,","poem":1},{"text":"ebale monene mpe nyonso oyo ezali kati na yango ;","poem":2},{"lineBreak":true},{"text":"azali sembo seko na seko.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yawe akataka na sembo makambo ya banyokolami","poem":1},{"text":"mpe apesaka bilei na bato oyo bazali na nzala ;","poem":2},{"lineBreak":true},{"text":"abimisaka bakangami na boloko.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yawe abikisaka miso ya bakufi miso ;","poem":1},{"text":"Yawe asembolaka bato oyo bazali ya kogumbama ;","poem":2},{"lineBreak":true},{"text":"Yawe alingaka bato ya sembo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawe abatelaka bapaya,","poem":1},{"text":"asungaka mwana etike mpe mwasi oyo akufisa mobali,","poem":2},{"lineBreak":true},{"text":"kasi abebisaka banzela ya bato mabe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yawe azali Mokonzi seko na seko ;","poem":1},{"text":"Nzambe na yo, oh Siona, libela na libela !","poem":2},{"lineBreak":true},{"text":"Bokumisa Yawe !","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}