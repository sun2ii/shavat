oem":1},{"text":"mpe abongolaka mokano na ye te ;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"asengaka mileki te soki adefisi mbongo,","poem":1},{"text":"andimaka kanyaka te","poem":2},{"lineBreak":true},{"text":"mpo na kokweyisa moto oyo asali mabe te.","poem":2},{"lineBreak":true},{"text":"Moto nyonso oyo atambolaka bongo","poem":1},{"text":"akotikala kopengwa te.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}