{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":23,"content":[{"type":"heading","content":["Yawe azali Mobateli na ngai"]},{"type":"verse","number":1,"content":[{"text":"Nzembo ya Davidi.","descriptive":true},{"text":"Yawe azali mobateli na ngai,","poem":1},{"text":"nakozanga ata eloko moko te.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Apemisaka ngai na matiti ya mobesu,","poem":1},{"text":"mpe amemaka ngai pembeni ya mayi ya kimia.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ayeisaka sika makasi ya bomoi na ngai,","poem":1},{"text":"akambaka ngai na banzela ya bosembo","poem":2},{"lineBreak":true},{"text":"mpo na lokumu ya Kombo na Ye.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ata soki nasengeli kokatisa lubwaku","poem":1},{"text":"oyo etondi na molili ya kufa,","poem":2},{"text":"nakobanga mabe ata moko te,","poem":1},{"text":"pamba te ozali elongo na ngai,","poem":2},{"text":"nzete na Yo ya mobateli ekambaka ngai,","poem":1},{"text":"mpe lingenda na Yo ebatelaka ngai.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Obongisaka mesa mpo na ngai","poem":1},{"text":"na miso ya bayini na ngai,","poem":2},{"text":"opakolaka moto na ngai mafuta","poem":1},{"text":"mpe otondisaka kopo na ngai kino kosopana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Solo, na mikolo nyonso ya bomoi na ngai,","poem":1},{"text":"esengo mpe bolingo na Yo ekobanda kolanda ngai ;","poem":2},{"text":"mpe nakovanda kati na Tempelo ya Yawe","poem":1},{"text":"kino suka ya bomoi na ngai.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}