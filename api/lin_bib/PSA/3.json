{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":3,"content":[{"type":"heading","content":["Yawe Abikisaka"]},{"type":"verse","number":1,"content":[{"text":"Nzembo ya Davidi. Ayembaki yango tango azalaki kokima Abisalomi, mwana na ye.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Oh Yawe, banguna na ngai bazali motango boni !","poem":1},{"text":"Banguna boni oyo bazali kobundisa ngai !","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ebele bazali koloba na tina na ngai :","poem":1},{"text":"« Nzambe akobikisa ye te ! »","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nzokande Yo, Yawe, ozali nguba mpe nkembo na ngai,","poem":1},{"text":"Yo nde omatisaka lokumu na ngai.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nabelelaka Yawe,","poem":1},{"text":"mpe ayanolaka ngai wuta na ngomba na Ye ya bule.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nalalaka mpe nazwaka pongi ;","poem":1},{"text":"nalamukaka lisusu,","poem":2},{"lineBreak":true},{"text":"pamba te Yawe azali makasi na ngai.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nakobanga te atako ebele ya bankoto","poem":1},{"text":"bazingeli ngai na bangambo nyonso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawe, telema !","poem":1},{"text":"Nzambe na ngai, kangola ngai !","poem":2},{"text":"Beta banguna na ngai nyonso bambata,","poem":1},{"text":"buka bato mabe minu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kokangolama na ngai ewutaka na Yawe.","poem":1},{"text":"Tika ete lipamboli na Yo ewumela","poem":2},{"lineBreak":true},{"text":"kati na bato na Yo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}