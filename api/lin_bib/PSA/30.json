{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":30,"content":[{"type":"heading","content":["Yawe azongisi ngai na bomoi"]},{"type":"verse","number":1,"content":[{"text":"Nzembo ya Davidi mpo na libulisi ya Tempelo.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Yawe, nanetoli Yo,","poem":1},{"text":"pamba te obimisaki ngai na libulu ya mozindo","poem":2},{"lineBreak":true},{"text":"mpe otikaki te banguna na ngai kosepela na tina na ngai.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yawe, Nzambe na ngai, nabelelaki Yo","poem":1},{"text":"mpo na kosenga lisungi,","poem":2},{"lineBreak":true},{"text":"mpe obikisaki ngai na bokono.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yawe, obimisaki ngai na mboka ya bakufi,","poem":1},{"text":"obatelaki bomoi na ngai","poem":2},{"lineBreak":true},{"text":"mosika na bato oyo bazali kokita na libulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Boyemba banzembo mpo na lokumu ya Yawe,","poem":1},{"text":"bino babulami na Ye ;","poem":2},{"lineBreak":true},{"text":"bokumisa Kombo na Ye ya bule.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pamba te kanda makasi na Ye ewumelaka","poem":1},{"text":"mpo na mwa tango moke,","poem":2},{"lineBreak":true},{"text":"kasi ngolu na Ye ewumelaka seko na seko ;","poem":2},{"text":"kolela ekoki kowumela kino na pokwa,","poem":1},{"text":"kasi kosepela ekokota na tongo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tango nazalaki na kimia, nalobaki :","poem":1},{"text":"« Nakotikala kokweya te. »","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yawe, tango osalelaki ngai ngolu,","poem":1},{"text":"olendisaki ngomba na ngai ;","poem":2},{"text":"kasi tango obombelaki ngai elongi,","poem":1},{"text":"nabungisaki elikya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yawe, nabelelaki Yo ;","poem":1},{"text":"nabelelaki Yawe mpo na kosenga lisungi :","poem":2}]},{"type":"verse","number":10,"content":[{"text":"« Litomba nini ezali soki nakufi,","poem":1},{"text":"soki nakiti na libulu ?","poem":2},{"text":"Boni, putulu ekokumisa Yo ?","poem":1},{"text":"Boni, ekosakola boyengebene na Yo ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yawe, yoka ngai mpe salela ngai ngolu ;","poem":1},{"text":"Yawe, zala lisungi na ngai. »","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Obongoli kolela na ngai, okomisi yango mabina ;","poem":1},{"text":"olongoli mokumba na ngai mpe olatisi ngai esengo,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"mpo ete molimo na ngai ekumisa Yo na banzembo,","poem":1},{"text":"kasi navanda nye te.","poem":2},{"text":"Yawe, Nzambe na ngai, nakokumisa Yo","poem":1},{"text":"libela na libela.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":13}