{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":4,"content":[{"type":"heading","content":["Yawe apesaka kimia"]},{"type":"verse","number":1,"content":[{"text":"Wuta na buku ya mokambi ya bayembi. Nzembo ya Davidi ; ezali ya koyemba na lindanda.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Nzambe, bosembo na ngai,","poem":1},{"text":"soki nabeleli Yo, yanola ngai.","poem":2},{"text":"Kangola ngai na pasi,","poem":1},{"text":"salela ngai ngolu,","poem":2},{"lineBreak":true},{"text":"mpe yoka libondeli na ngai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bino bato, kino tango nini bokoyokisa","poem":1},{"text":"nkembo na ngai soni ?","poem":2},{"text":"Kino tango nini bokomisepelisa","poem":1},{"text":"na makambo ya pamba","poem":2},{"lineBreak":true},{"text":"mpe bokolanda makambo ya lokuta ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Boyeba ete Yawe abulisi mpo na Ye moko","poem":1},{"text":"mosali oyo azali sembo na miso na Ye ;","poem":2},{"text":"Yawe ayokaka ngai tango nabelelaka Ye.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Soki bosiliki, bosalaka masumu te ;","poem":1},{"text":"soki bolali na mbeto,","poem":2},{"text":"bolukaka kososola makambo","poem":1},{"text":"mpe bovandaka kimia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bobonzaka bambeka kolanda mibeko","poem":1},{"text":"mpe botiaka elikya na bino kati na Yawe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bato mingi bazali kotuna :","poem":1},{"text":"« Nani akomemela biso bolamu ? »","poem":2},{"lineBreak":true},{"text":"Oh Yawe, ngengisela biso elongi na Yo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tondisa motema na ngai na esengo","poem":1},{"text":"soki bafuluki na bambuma ya ble elongo na vino ya sika.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nakolala mpe nakozwa pongi na kimia,","poem":1},{"text":"pamba te, Yo moko Yawe, osalaka","poem":2},{"lineBreak":true},{"text":"ete navanda na kimia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":9}