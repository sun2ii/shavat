{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":43,"content":[{"type":"heading","content":["Kotia elikya kati na Yawe"]},{"type":"verse","number":1,"content":[{"text":"Oh Nzambe, longisa ngai mpe lobela ngai","poem":1},{"text":"liboso ya ekolo oyo etosaka makambo na Yo te ;","poem":2},{"text":"kangola ngai wuta na maboko","poem":1},{"text":"ya bakosi mpe ya bato mabe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nzambe, Yo nde ozali ndako na ngai,","poem":1},{"text":"oyo batonga makasi ;","poem":2},{"text":"mpo na nini osundoli ngai ?","poem":1},{"text":"Mpo na nini nasengeli kotambola na pasi boye,","poem":2},{"lineBreak":true},{"text":"na se ya minyoko ya monguna ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tinda mwinda mpe solo na Yo","poem":1},{"text":"mpo ete ekamba mpe emema ngai","poem":2},{"lineBreak":true},{"text":"na ngomba na Yo ya bule epai wapi ovandaka ;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"bongo nakokende na etumbelo","poem":1},{"text":"epai ya Nzambe, esengo mpe bomengo na ngai.","poem":2},{"text":"Oh Yawe, Nzambe na ngai,","poem":1},{"text":"nakosanzola Yo na lindanda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Oh molimo na ngai, mpo na nini olembi boye ?","poem":1},{"text":"Mpo na nini ozali komitungisa kati na ngai ?","poem":2},{"text":"Tia elikya na yo kati na Nzambe,","poem":1},{"text":"pamba te nakosanzola Ye lisusu,","poem":2},{"lineBreak":true},{"text":"Mobikisi mpe Nzambe na ngai.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}