{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":48,"content":[{"type":"heading","content":["Engumba ya Nzambe"]},{"type":"verse","number":1,"content":[{"text":"Nzembo ya bana ya Kore.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Yawe azali monene mpe abongi na lokumu,","poem":1},{"text":"kati na engumba ya Nzambe na biso,","poem":2},{"lineBreak":true},{"text":"ngomba na Ye ya bule.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ezali kitoko, ngomba moke oyo esalaka","poem":1},{"text":"esengo ya mokili mobimba,","poem":2},{"lineBreak":true},{"text":"ngomba Siona !","poem":2},{"text":"Ngambo na yango ya Nor nde ezali","poem":1},{"text":"engumba ya Mokonzi Monene.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nzambe azali kati na bandako na yango ya bokonzi,","poem":1},{"text":"amimonisi lokola ndako batonga makasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Pamba te bakonzi basanganaki,","poem":1},{"text":"batambolaki nzela moko.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kasi tango kaka bamonaki yango,","poem":1},{"text":"bakamwaki mpe bakimaki na somo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mbala moko, bakomaki kolenga wana","poem":1},{"text":"lokola mwasi oyo azali na pasi ya kobota","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"to lokola mopepe ya Este oyo apanzaka masuwa ya Tarsisi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ndenge kaka bayebisaki biso,","poem":1},{"text":"ndenge mpe tomonaki kati na engumba ya","poem":2},{"lineBreak":true},{"text":"Yawe, Mokonzi ya mampinga,","poem":2},{"text":"kati na engumba ya Nzambe na biso ;","poem":1},{"text":"Nzambe alendisaka yango seko na seko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nzambe, kati na Tempelo na Yo,","poem":1},{"text":"tokanisaka bolingo na Yo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nzambe, lokumu na Yo epanzani kino na suka ya mokili,","poem":1},{"text":"ndenge moko na Kombo na Yo ;","poem":2},{"lineBreak":true},{"text":"loboko na Yo ya mobali etondi na bosembo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngomba ya Siona ezali kosepela,","poem":1},{"text":"bamboka ya Yuda etondi na esengo","poem":2},{"lineBreak":true},{"text":"mpo na mikano na Yo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Botambola pembeni ya Siona,","poem":1},{"text":"bokende zingazinga na yango,","poem":2},{"lineBreak":true},{"text":"botanga bandako na yango ya milayi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Botala lopango na yango,","poem":1},{"text":"botala malamu bandako na yango","poem":2},{"text":"mpo ete bopesa sango","poem":1},{"text":"epai ya bato oyo bakoya na sima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Pamba te Nzambe wana azali Nzambe na biso","poem":1},{"text":"seko na seko mpe libela na libela ;","poem":2},{"lineBreak":true},{"text":"akotambolisa biso, ezala kino na kufa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":15}