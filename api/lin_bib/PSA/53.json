{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":53,"content":[{"type":"heading","content":["Bato nyonso babungi nzela"]},{"type":"verse","number":1,"content":[{"text":"Nzembo ya Davidi. Wuta na buku ya mokambi ya bayembi. Eyembamaki na flite.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Bazoba bamilobelaka :","poem":1},{"text":"« Nzambe azali te. »","poem":2},{"text":"Makanisi na bango esila kobeba,","poem":1},{"text":"basalaka makambo mabe mpe ya nkele ;","poem":2},{"lineBreak":true},{"text":"moko te asalaka bolamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wuta na likolo, Nzambe atalaka bato","poem":1},{"text":"mpo na koluka koyeba","poem":2},{"text":"soki ezali ata na moko ya mayele,","poem":1},{"text":"oyo atalelaka Nzambe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bango nyonso bazali batomboki,","poem":1},{"text":"bango nyonso bamibebisa ;","poem":2},{"text":"moko te asalaka bolamu,","poem":1},{"text":"ata moto moko te.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Boni, bato nyonso ya misala mabe bayebi eloko te ?","poem":1},{"lineBreak":true},{"text":"Baliaka bato na ngai ndenge baliaka lipa","poem":1},{"text":"mpe batikala nanu kobelela Nzambe te,","poem":2},{"lineBreak":true},{"text":"bazali penza kososola eloko moko te ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Somo monene ekokanga bango","poem":1},{"text":"na esika oyo ezali ata na eloko moko te","poem":2},{"text":"oyo ekoki kopesa bango somo,","poem":1},{"text":"pamba te Nzambe apanzi mikuwa ya bato","poem":2},{"text":"oyo bayei kobundisa yo.","poem":1},{"lineBreak":true},{"text":"Okoyokisa bango soni,","poem":1},{"text":"pamba te Nzambe abwaka bango.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tika ete lobiko ya Isalaele ebimela na Siona !","poem":1},{"text":"Tango Nzambe akobimisa bato na Ye na bowumbu,","poem":2},{"text":"bakitani ya Jakobi bakosepela,","poem":1},{"text":"mpe Isalaele ekozala na esengo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":7}