{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":54,"content":[{"type":"heading","content":["Nzambe akangoli ngai"]},{"type":"verse","number":1,"content":[{"text":"Nzembo ya Davidi. Wuta na buku ya mokambi ya bayembi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Eyembamaki na lindanda tango bato ya Zifi bayaki koyebisa Saulo : « Davidi abombami kati na biso. »","descriptive":true}]},{"type":"verse","number":3,"content":[{"text":"Oh Nzambe, bikisa ngai na nzela ya Kombo na Yo,","poem":1},{"text":"longisa ngai na nzela ya nguya na Yo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Oh Nzambe, yoka libondeli na ngai,","poem":1},{"text":"yoka maloba ya monoko na ngai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bapaya batelemi mpo na kobundisa ngai ;","poem":1},{"text":"mpe bato na kanza bazali koluka koboma ngai,","poem":2},{"lineBreak":true},{"text":"batalelaka Nzambe te.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tala, Nzambe azali lisungi na ngai,","poem":1},{"text":"Nkolo azali eyekamelo na ngai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tika ete akweyisela bayini na ngai mabe !","poem":1},{"text":"Kati na boyengebene na Yo, bebisa bango.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nakobonzela Yo mbeka na motema malamu,","poem":1},{"text":"nakokumisa Kombo na Yo, Oh Yawe,","poem":2},{"lineBreak":true},{"text":"pamba te ozali malamu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Okangoli ngai na pasi nyonso ;","poem":1},{"text":"mpe miso na ngai etali","poem":2},{"lineBreak":true},{"text":"lokola molongi ya banguna na ngai.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":9}