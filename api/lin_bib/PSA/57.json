{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":57,"content":[{"type":"heading","content":["Kimia na kati ya banguna"]},{"type":"verse","number":1,"content":[{"text":"Wuta na buku ya mokambi ya bayembi. Eyembamaki ndenge moko na nzembo « Koboma te. » Nzembo ya Davidi, tango Saulo azalaki kolanda ye, mpe tango Davidi abombamaki kati na libulu.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Oh Nzambe, yokela ngai mawa !","poem":1},{"text":"Yokela ngai mawa,","poem":2},{"text":"pamba te nazali koluka ebombamelo ;","poem":1},{"text":"nazali koluka ebombamelo na se ya mapapu na Yo,","poem":2},{"lineBreak":true},{"text":"kino tango ya pasi ekoleka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nazali koganga epai ya Nzambe-Oyo-Aleki-Likolo,","poem":1},{"text":"epai ya Nzambe oyo asalelaka ngai bolamu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Akotinda wuta na likolo mpe akobikisa ngai,","poem":1},{"text":"akopamela bato oyo batungisaka ngai.","poem":2},{"text":"Nzambe akomonisa bolingo","poem":1},{"text":"mpe boyengebene na Ye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nazali na kati-kati ya bankosi ;","poem":1},{"text":"nalali na kati-kati ya bato","poem":2},{"text":"oyo babomaka mpe baliaka bato,","poem":1},{"text":"oyo minu na bango ezali makonga mpe batolotolo,","poem":2},{"lineBreak":true},{"text":"mpe lolemo na bango ezali mopanga ya minu makasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Oh Nzambe, tika ete omitombola na likolo ya Lola ;","poem":1},{"text":"tika ete nkembo na Yo ezala","poem":2},{"lineBreak":true},{"text":"awa na mokili mobimba !","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Batiaki monyama na makolo na ngai","poem":1},{"text":"mpo ete nakangama,","poem":2},{"text":"batimolaki libulu liboso na ngai,","poem":1},{"text":"kasi bango moko nde bakweyaki kati na libulu yango.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nzambe, lendisa motema na ngai ;","poem":1},{"text":"Nzambe, lendisa motema na ngai.","poem":2},{"text":"Nakoyembela Yo mpe nakosanzola Yo na mindule.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lokumu na ngai, lamuka !","poem":1},{"text":"Lindanda mpe nzenze, bolamuka !","poem":2},{"lineBreak":true},{"text":"Nalingi kolamusa tongo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nkolo, nakosanzola Yo kati na mabota,","poem":1},{"text":"nakosanzola Yo na mindule kati na bikolo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Pamba te bolingo na Yo ezali monene,","poem":1},{"text":"ekenda kino na Lola ;","poem":2},{"lineBreak":true},{"text":"mpe bosembo na Yo ekenda kino na mapata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nzambe, tika ete omitombola na likolo ya Lola ;","poem":1},{"text":"mpe tika ete nkembo na Yo etonda na mokili mobimba !","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":12}