{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":64,"content":[{"type":"heading","content":["Batela ngai"]},{"type":"verse","number":1,"content":[{"text":"Wuta na buku ya mokambi ya bayembi. Nzembo ya Davidi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Oh Nzambe, yoka mongongo na ngai","poem":1},{"text":"kati kolela na ngai,","poem":2},{"text":"batela ngai mosika ya monguna","poem":1},{"text":"oyo azali kopesa ngai somo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bomba ngai mosika ya mikano ya bato mabe,","poem":1},{"text":"mosika ya makita ya bato ya misala mabe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bapelisaka lolemo na bango","poem":1},{"text":"ndenge bapelisaka mopanga,","poem":2},{"lineBreak":true},{"text":"babimisaka maloba ya bololo lokola makonga","poem":2}]},{"type":"verse","number":5,"content":[{"text":"mpo na kobwakela, na kobombama,","poem":1},{"text":"moto oyo azangi pamela ;","poem":2},{"lineBreak":true},{"text":"babangaka te kobwakela ye yango na mbalakata.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Balendisanaka mpo na mabongisi mabe,","poem":1},{"text":"bayokanaka kotia mitambo ;","poem":2},{"lineBreak":true},{"text":"balobaka : « Nani akomona yango ? »","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Basalaka mabongisi ya kosala bato mabe,","poem":1},{"text":"balobaka : « Toselingwi na mabongisi na biso ! »","poem":2},{"lineBreak":true},{"text":"Makanisi mpe motema ya moto ezali mozindo makasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kasi Nzambe akobwakela bango","poem":1},{"text":"makonga na Ye na mbalakata ;","poem":2},{"lineBreak":true},{"text":"ekozwa mpe ekozokisa bango.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Maloba na bango moko ekobalukela bango","poem":1},{"text":"mpe ekomema bango na libebi ;","poem":2},{"text":"mpe moto nyonso oyo akomona bango","poem":1},{"text":"akoningisa moto.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bato nyonso bakokoma kobanga,","poem":1},{"text":"kopanza sango ya misala ya Nzambe","poem":2},{"lineBreak":true},{"text":"mpe kososola makambo oyo asalaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Moto ya sembo akosepela","poem":1},{"text":"mpe akomibomba kati na Yawe ;","poem":2},{"text":"bato nyonso oyo bazali na mitema alima","poem":1},{"text":"bakomikumisa mpo na yango.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":11}