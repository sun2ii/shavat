{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":67,"content":[{"type":"heading","content":["Tika ete bikolo nyonso ekumisa Nzambe"]},{"type":"verse","number":1,"content":[{"text":"Wuta na buku ya mokambi ya bayembi : nzembo ya koyemba na lindanda. Loyembo.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Tika ete Nzambe asalela biso ngolu","poem":1},{"text":"mpe apambola biso,","poem":2},{"lineBreak":true},{"text":"tika ete angengisela biso elongi na Ye ;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"mpo ete toyeba nzela na Yo kati na mokili,","poem":1},{"text":"mpe lobiko na Yo kati na bikolo nyonso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Oh Nzambe, tika ete bikolo ekumisa Yo ;","poem":1},{"text":"tika ete bikolo nyonso ekumisa Yo !","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tika ete bato basepela,","poem":1},{"text":"tika ete babeta milolo ya esengo,","poem":2},{"text":"pamba te okambaka bikolo na bosembo,","poem":1},{"text":"mpe otambolisaka bato awa na mabele.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Oh Nzambe, tika ete bikolo ekumisa Yo ;","poem":1},{"text":"tika ete bikolo nyonso ekumisa Yo !","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mabele eboti bambuma na yango ;","poem":1},{"text":"tika ete Nzambe, Nzambe na biso, apambola biso.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tika ete Nzambe apambola biso ;","poem":1},{"text":"tika ete mokili mobimba etosa Ye !","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":8}