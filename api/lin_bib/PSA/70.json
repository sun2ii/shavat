{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":70,"content":[{"type":"heading","content":["Nzambe, yaka kosunga ngai"]},{"type":"verse","number":1,"content":[{"text":"Wuta na buku ya mokambi ya bayembi. Nzembo ya Davidi mpo na kokanisa misala ya Nzambe.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Nzambe, yaka noki mpo na kangola ngai !","poem":1},{"text":"Yawe, yaka noki mpo na kosunga ngai !","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tika ete bato oyo balukaka kufa na ngai","poem":1},{"text":"bakufa soni mpe basambwa !","poem":2},{"text":"Tika ete bato oyo bazelaka libebi na ngai","poem":1},{"text":"bazonga sima mpe bayokisama soni !","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tika ete bato oyo balobaka na ngai :","poem":1},{"text":"« Ah ! Ah ! » bazonga mpo na soni !","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tika ete bato nyonso oyo balukaka Yo","poem":1},{"text":"batonda na esengo mpe basepela kati na Yo !","poem":2},{"text":"Tika ete ba-oyo balingaka lobiko na Yo","poem":1},{"text":"balobaka tango nyonso :","poem":2},{"lineBreak":true},{"text":"« Nzambe azali monene ! »","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mpo ete nazali mobola mpe moto akelela,","poem":1},{"text":"Nzambe, yaka noki mpo na kosunga ngai.","poem":2},{"text":"Yawe, ozali Lisungi mpe Mokangoli na ngai,","poem":1},{"text":"kowumela te !","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":6}