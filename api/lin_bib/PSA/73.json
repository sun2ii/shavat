{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":73,"content":[{"type":"heading","content":["Mpo na nini bato mabe bakendaka liboso ?"]},{"type":"verse","number":1,"content":[{"text":"Nzembo ya Azafi.","descriptive":true},{"text":"Solo, Nzambe azali malamu mpo na Isalaele,","poem":1},{"text":"mpo na bato oyo bazali mitema peto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nzokande mpo na ngai,","poem":1},{"text":"etikalaki moke ete makolo na ngai eselumuka,","poem":2},{"lineBreak":true},{"text":"etikalaki moke ete nakweya,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"pamba te nazalaki kolula bato ya lofundu","poem":1},{"text":"tango nazalaki komona kimia ya bato mabe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kino na kufa na bango,","poem":1},{"text":"bazalaka na mitungisi te,","poem":2},{"lineBreak":true},{"text":"nzoto na bango ezalaka sembesembe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kati na bango, moko te amonaka pasi","poem":1},{"text":"oyo bato nyonso bamonaka ;","poem":2},{"lineBreak":true},{"text":"babelaka te bokono oyo ezwaka bato.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yango wana, lolendo ekoma","poem":1},{"text":"lokola mayaka na bakingo na bango,","poem":2},{"text":"mpe makambo na kanza ekoma","poem":1},{"text":"lokola elamba na bango.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Miso na bango engengaka","poem":1},{"text":"na bilongi etonda na mafuta ;","poem":2},{"text":"mitema na bango esalaka kaka","poem":1},{"text":"mabongisi ya mabe ;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"batiolaka mpe balobaka mabe,","poem":1},{"text":"bagangelaka minyoko.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Minoko na bango etombokelaka Likolo,","poem":1},{"text":"mpe lolemo na bango esakanelaka mokili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yango wana bato balandaka bango","poem":1},{"text":"mpe bamelaka maloba na bango lokola mayi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Balobaka : « Nzambe akoyeba ndenge nini ?","poem":1},{"text":"Ye-Oyo-Aleki-Likolo azali ata na boyebi ? »","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tala ndenge bato mabe bazalaka :","poem":1},{"text":"tango nyonso, bazalaka na mitungisi te,","poem":2},{"lineBreak":true},{"text":"mpe bomengo na bango emataka se komata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Solo, ezali kaka na pamba nde","poem":1},{"text":"nabatelaki motema na ngai peto ;","poem":2},{"text":"ezali kaka na pamba nde","poem":1},{"text":"nasukolaki maboko na ngai","poem":2},{"lineBreak":true},{"text":"mpo ete nasala mabe te !","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mikolo nyonso, nanyokwamaka ;","poem":1},{"text":"mpe tongo nyonso, nazwaka etumbu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Soki nalobi : « Nakoloba lokola bango, »","poem":1},{"text":"wana nateki penza lokumu ya libota na Yo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Tango nakanisaki mpo na koluka kososola,","poem":1},{"text":"nayokaki pasi na motema","poem":2}]},{"type":"verse","number":17,"content":[{"text":"kino nakendeki na Esika ya bule ya Nzambe","poem":1},{"text":"mpe nasosolaki ndenge nini bakosuka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Solo, otielaka bango biloko ya moselu,","poem":1},{"text":"okweyisaka bango kati na libebi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ndenge nini babebisamaka mbala moko,","poem":1},{"text":"bakomaka na suka,","poem":2},{"lineBreak":true},{"text":"mpe somo elimwisaka bango !","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ndenge ndoto elimwaka","poem":1},{"text":"soki moto alamuki na pongi,","poem":2},{"text":"Nkolo, olimwisaka lisolo ya bomoi na bango","poem":1},{"text":"tango kaka otelemaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tango motema na ngai ezalaki kotomboka","poem":1},{"text":"mpe molimo na ngai emitungisaki,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"nasilaki mayele, nakomaki lokola zoba,","poem":1},{"text":"nakomaki lokola nyama liboso na Yo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Nzokande, nazalaka tango nyonso elongo na Yo ;","poem":1},{"text":"osimba ngai na loboko na ngai ya mobali.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Otambolisaka ngai na nzela ya toli na Yo,","poem":1},{"text":"mpe, na sima, okoyamba ngai kati na nkembo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kuna na Likolo, nani azali mpo na ngai","poem":1},{"text":"soki Yo te ?","poem":2},{"text":"Mpe awa na mokili, nasepela na nani","poem":1},{"text":"soki na Yo te ?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nzoto na ngai ekoki kobeba,","poem":1},{"text":"mpe motema na ngai ekoki kolemba ;","poem":2},{"text":"kasi Nzambe azali Libanga","poem":1},{"text":"mpe libula na ngai mpo na tango nyonso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Bato nyonso oyo bazali mosika na Yo bakokufa ;","poem":1},{"text":"obebisaka bato nyonso oyo batosaka Yo te.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kasi mpo na ngai, ezali malamu","poem":1},{"text":"kozala pene ya Nzambe.","poem":2},{"text":"Nakomisi Nkolo Yawe ebombamelo na ngai,","poem":1},{"text":"mpo na kopanza sango ya misala na Yo nyonso.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}