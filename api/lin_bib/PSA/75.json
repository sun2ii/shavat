{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":75,"content":[{"type":"heading","content":["Nzambe akosambisa mokili"]},{"type":"verse","number":1,"content":[{"text":"Wuta na buku ya mokambi ya bayembi. Nzembo ya koyemba lokola « Koboma te ! » Nzembo ya Azafi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Nzambe, tozali kosanzola Yo,","poem":1},{"text":"tozali kosanzola Kombo na Yo ;","poem":2},{"text":"mpo ete Kombo na Yo ezali pene,","poem":1},{"text":"bato bazali kotatola bikamwa na Yo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Olobaki :","poem":1},{"text":"« Na tango oyo ngai moko nakobongisa,","poem":2},{"lineBreak":true},{"text":"nakokata makambo na bosembo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mokili ekoki kolenga","poem":1},{"text":"elongo na bavandi na yango nyonso,","poem":2},{"text":"kasi ezali ngai nde nalendisaka","poem":1},{"text":"makonzi na yango. »","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nazali koloba na moto ya lofundu :","poem":1},{"text":"« Kotombola lisusu mapeka te ; »","poem":2},{"text":"mpe na bato mabe :","poem":1},{"text":"« Bosala lisusu lolendo te.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bomeka lisusu te kosala lofundu","poem":1},{"text":"mpe koloba na lolendo. »","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Botombwami ewutaka na Este te, na Weste te,","poem":1},{"text":"ewutaka mpe na esobe te.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pamba te ezali Nzambe nde akataka makambo :","poem":1},{"text":"akitisaka moto songolo","poem":2},{"lineBreak":true},{"text":"mpe atombolaka moto pakala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Loboko na Yawe esimbi kopo","poem":1},{"text":"oyo etondi na vino ya makasi mpe ya bololo.","poem":2},{"text":"Azali kosopa yango,","poem":1},{"text":"mpe bato mabe nyonso ya mokili","poem":2},{"text":"bazali komeka mpe komela yango","poem":1},{"text":"kino na mbindo oyo etikalaka na se ya kopo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mpo na ngai, nakotatola makambo oyo","poem":1},{"text":"tango nyonso,","poem":2},{"lineBreak":true},{"text":"nakoyemba mpo na lokumu ya Nzambe ya Jakobi,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"oyo azali koloba :","poem":1},{"text":"« Nakosilisa makasi nyonso ya bato mabe ;","poem":2},{"text":"kasi nguya ya bato ya sembo","poem":1},{"text":"ekomata lisusu makasi. »","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":11}