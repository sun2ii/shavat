{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":77,"content":[{"type":"heading","content":["Nzambe abongwani to te ?"]},{"type":"verse","number":1,"content":[{"text":"Wuta na buku ya mokambi ya bayembi, kolanda Yedutuni. Nzembo ya Azafi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Nabelelaka Nzambe na koganga ;","poem":1},{"text":"nabelelaka Nzambe mpo ete ayoka ngai !","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tango nazalaka na pasi, nalukaka Nkolo ;","poem":1},{"text":"na butu, nalembaka te kotombola maboko na ngai","poem":2},{"lineBreak":true},{"text":"mpe naboyaka kobondisama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nakanisaka Nzambe mpe nalelaka,","poem":1},{"text":"nakotaka na mozindo ya makanisi","poem":2},{"lineBreak":true},{"text":"mpe nalembaka nzoto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Opimelaka miso na ngai pongi,","poem":1},{"text":"namitungisaka mpe nayebaka lisusu te","poem":2},{"lineBreak":true},{"text":"eloko ya koloba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nakanisaka lisusu mikolo ya kala,","poem":1},{"text":"mibu nyonso oyo eleka ;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Na butu, nakanisaka lisusu banzembo na ngai ;","poem":1},{"text":"motema na ngai ezongelaka kokanisa,","poem":2},{"lineBreak":true},{"text":"mpe molimo na ngai ekomaka komituna :","poem":2}]},{"type":"verse","number":8,"content":[{"text":"« Boni, Nkolo akobwaka biso penza","poem":1},{"text":"mpo na libela ?","poem":2},{"lineBreak":true},{"text":"Akosalela biso lisusu bolamu te ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bolingo na Ye esili penza mpo na libela ?","poem":1},{"text":"Bilaka na Ye ekokokisama te mpo na libela ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nzambe abosani solo kosala ngolu ?","poem":1},{"text":"Akangi penza motema na Ye mpo na kanda ? »","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mpe namilobelaka :","poem":1},{"text":"« Tala likambo oyo ezali kosala ngai pasi :","poem":2},{"text":"loboko ya mobali ya Ye-Oyo-Aleki-Likolo","poem":1},{"text":"ebongwani ! »","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nakanisaka misala minene ya Yawe,","poem":1},{"text":"bikamwa na Yo ya kala.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nakanisaka nyonso oyo osalaki","poem":1},{"text":"kino na bikamwa na Yo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Oh Nzambe, banzela na Yo ezali bule ;","poem":1},{"text":"nzambe nini akokani na Yo na monene ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ozali Nzambe oyo asalaka bikamwa ;","poem":1},{"text":"olakisi nguya na Yo kati na bikolo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Na nguya ya loboko na Yo,","poem":1},{"text":"okangolaki bato na Yo,","poem":2},{"lineBreak":true},{"text":"bakitani ya Jakobi mpe ya Jozefi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Oh Nzambe, mayi emonaki Yo !","poem":1},{"text":"Mayi emonaki Yo mpe ekomaki kolenga ;","poem":2},{"lineBreak":true},{"text":"ezala mozindo ya mayi eninganaki.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mapata esopaki mayi ebele,","poem":1},{"text":"likolo eyokisaki lokito ya kake,","poem":2},{"text":"mpe makonga na Yo ezalaki koleka-leka","poem":1},{"text":"na bangambo nyonso.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Na lokito ya kake na Yo,","poem":1},{"text":"mikalikali engengisaki mokili,","poem":2},{"lineBreak":true},{"text":"mabele eninganaki mpe elengaki.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Opasolaki nzela kati na ebale monene,","poem":1},{"text":"balabala na Yo kati na mayi monene,","poem":2},{"text":"mpe moto moko te amonaki bilembo","poem":1},{"text":"ya matambe na Yo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Otambolisaki bato na Yo lokola etonga,","poem":1},{"text":"na loboko ya Moyize mpe ya Aron.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":21}