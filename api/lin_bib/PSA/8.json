{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":8,"content":[{"type":"heading","content":["Nkembo ya Nzambe"]},{"type":"verse","number":1,"content":[{"text":"Wuta na buku ya mokambi ya bayembi. Nzembo ya Davidi ; ezali ya koyemba na lindanda ya bato ya Gati.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Oh Yawe, Nkolo na biso,","poem":1},{"text":"Kombo na Yo ezali monene kati na mokili mobimba !","poem":2},{"lineBreak":true},{"text":"Ovandisi nkembo na Yo","poem":1},{"text":"kati na Lola.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Na nzela ya masanzoli ya bana mpe bana mike,","poem":1},{"text":"otelemisi ndako batonga makasi,","poem":2},{"text":"mpo na kotelemela bayini na Yo","poem":1},{"text":"mpe kokanga monoko ya monguna","poem":2},{"lineBreak":true},{"text":"mpe ya moto oyo alingaka kozongisa mabe na mabe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tango natalaka Lola na Yo,","poem":1},{"text":"mosala ya misapi na Yo,","poem":2},{"lineBreak":true},{"text":"sanza mpe minzoto oyo otia,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"namitunaka : Moto azali nini mpo ete okanisa ye,","poem":1},{"text":"mpe moto azali nani mpo ete obatela ye ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Osalaki ye moke koleka ba-anjelu","poem":1},{"text":"mpe olatisaka ye motole ya nkembo mpe ya lokumu ;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"otia ye moyangeli ya misala ya maboko na Yo,","poem":1},{"text":"otia nyonso na se ya matambe na ye :","poem":2}]},{"type":"verse","number":8,"content":[{"text":"bameme, bantaba,","poem":1},{"text":"bangombe mpe banyama ya zamba,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"bandeke ya likolo,","poem":1},{"text":"mbisi ya ebale monene","poem":2},{"lineBreak":true},{"text":"mpe nyonso oyo etambolaka na bibale.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Oh Yawe, Nkolo na biso,","poem":1},{"text":"Kombo na Yo ezali monene","poem":2},{"lineBreak":true},{"text":"kati na mokili mobimba !","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":10}