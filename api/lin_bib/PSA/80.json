{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":80,"content":[{"type":"heading","content":["Eh Yawe, kino tango nini ?"]},{"type":"verse","number":1,"content":[{"text":"Wuta na buku ya mokambi ya bayembi. Ezali ya koyemba lokola « Lisi ya Mobeko. » Litatoli. Nzembo ya Azafi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Mobateli ya Isalaele,","poem":1},{"text":"Yo oyo otambolisaka Jozefi","poem":2},{"text":"lokola etonga ya bameme, yoka ;","poem":1},{"text":"Yo oyo Kiti ya Bokonzi na Yo ezali","poem":2},{"lineBreak":true},{"text":"kati na basheribe, mimonisa","poem":2}]},{"type":"verse","number":3,"content":[{"text":"liboso ya Efrayimi, ya Benjame","poem":1},{"text":"mpe ya Manase.","poem":2},{"text":"Monisa nguya na Yo","poem":1},{"text":"mpe yaka kobikisa biso !","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Oh Nzambe, sala ete tozongela ndenge tozalaki,","poem":1},{"text":"ngengisela biso elongi na Yo mpo ete tobika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Eh Yawe, Nzambe-Na-Nguya-Nyonso,","poem":1},{"text":"kino tango nini okotombokela","poem":2},{"lineBreak":true},{"text":"mabondeli ya bato na Yo ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Oleisaki bango lipa esangana na mayi ya miso","poem":1},{"text":"mpe olangwisaki bango na kopo","poem":2},{"lineBreak":true},{"text":"etonda na mpinzoli ;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"okomisaki biso eloko ya kotiola","poem":1},{"text":"mpo na bazalani na biso,","poem":2},{"lineBreak":true},{"text":"mpe banguna na biso bakomi kotiola biso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nzambe-Na-Nguya-Nyonso,","poem":1},{"text":"sala ete tozongela ndenge tozalaki,","poem":2},{"text":"ngengisela biso elongi na Yo","poem":1},{"text":"mpo ete tobika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nzete ya vino oyo opikolaki wuta na Ejipito,","poem":1},{"text":"olonaki yango wana obenganaki bikolo ebele.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Obongiselaki yango mabele","poem":1},{"text":"mpo ete ezwa misisa mpe etondisa mokili.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Elili na yango ezipaki bangomba,","poem":1},{"text":"bitape na yango ezalaki","poem":2},{"lineBreak":true},{"text":"lokola banzete minene ya sedele.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Epanzaki bitape na yango kino na ebale monene,","poem":1},{"text":"mpe mito na yango ya sika kino na ebale.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mpo na nini otoboli madusu","poem":1},{"text":"kati na bamir na yango ?","poem":2},{"text":"Tala ndenge baleki nzela bazali kobuka","poem":1},{"text":"bambuma na yango !","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngulu ya zamba ezali kobebisa yango,","poem":1},{"text":"mpe nyama ya zamba ezali kolia yango.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Zongela biso lisusu,","poem":1},{"text":"Nzambe-Na-Nguya-Nyonso !","poem":2},{"text":"Wuta na likolo, tala mpe mona !","poem":1},{"text":"Senzela mpo na nzete oyo ya vino !","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Batela nzete oyo loboko na Yo ya mobali elonaki,","poem":1},{"text":"batela solo mwana oyo Yo moko obokolaki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Bakati nzete na Yo ya vino","poem":1},{"text":"mpe batumbi yango na moto ;","poem":2},{"lineBreak":true},{"text":"tika ete bakufa na pamela ya elongi na Yo !","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tika ete loboko na Yo ezala na likolo ya mokonzi","poem":1},{"text":"oyo avandi na ngambo ya loboko na Yo ya mobali,","poem":2},{"text":"mpe na likolo ya mwana na moto","poem":1},{"text":"oyo Yo moko okomisaki makasi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Boye, tokozala lisusu mosika na Yo te ;","poem":1},{"text":"zongisela biso lisusu bomoi,","poem":2},{"lineBreak":true},{"text":"mpe tokobelela Kombo na Yo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yawe, Nzambe-Na-Nguya-Nyonso,","poem":1},{"text":"sala ete tozongela ndenge tozalaki,","poem":2},{"lineBreak":true},{"text":"ngengisela biso elongi na Yo mpo ete tobika.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":20}