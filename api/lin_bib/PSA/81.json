{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":81,"content":[{"type":"heading","content":["Soki bato na ngai bazalaki koyokela ngai…"]},{"type":"verse","number":1,"content":[{"text":"Wuta na buku ya mokambi ya bayembi. Nzembo ya Azafi. Ezali ya koyemba na lindanda ya bato ya Gati.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Boganga na esengo","poem":1},{"text":"epai ya Nzambe, makasi na biso !","poem":2},{"lineBreak":true},{"text":"Bobetela Nzambe ya Jakobi maboko !","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Boyemba banzembo, bobeta bambunda mike,","poem":1},{"text":"lindanda oyo ebimisaka lokito kitoko mpe nzenze !","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bobeta kelelo na ebandeli ya sanza,","poem":1},{"text":"na tango oyo sanza mobimba engengaka,","poem":2},{"lineBreak":true},{"text":"mpo na mokolo ya feti na biso !","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Pamba te ezali mobeko mpo na Isalaele,","poem":1},{"text":"mpe mokano ya Nzambe ya Jakobi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Atiaki yango lokola mobeko mpo na Jozefi","poem":1},{"text":"tango abundisaki Ejipito.","poem":2},{"lineBreak":true},{"text":"Nazali koyoka lokota oyo nayebi te :","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"« Nalongolaki mokumba","poem":1},{"text":"oyo ezalaki na mapeka na ye,","poem":2},{"text":"mpe maboko na ye elongwaki","poem":1},{"text":"na bowumbu ya kosimba bitunga. »","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tango ozalaki koganga mpo na pasi,","poem":1},{"text":"nakangolaki yo,","poem":2},{"lineBreak":true},{"text":"nayanolaki yo kati na kake","poem":2},{"text":"epai wapi nabombamaki,","poem":1},{"text":"namekaki yo pembeni ya mayi ya Meriba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bato na ngai, boyoka ngai !","poem":1},{"text":"Mpe nakokebisa bino.","poem":2},{"lineBreak":true},{"text":"Ah Isalaele, soki kaka ozalaki koyokela ngai !","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Okozala na nzambe ya mopaya te kati na yo,","poem":1},{"text":"okogumbamela nzambe mosusu te,","poem":2},{"lineBreak":true},{"text":"longola kaka ngai !","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nazali Yawe, Nzambe na yo,","poem":1},{"text":"oyo abimisaki yo na Ejipito ;","poem":2},{"text":"fungola malamu monoko na yo,","poem":1},{"text":"mpe nakotondisa yango.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kasi bato na ngai bayokaki mongongo na ngai te,","poem":1},{"text":"Isalaele aboyaki kotosa ngai.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mpo na yango, natikaki bango kotambola","poem":1},{"text":"kolanda baposa ya mitema makasi na bango ;","poem":2},{"lineBreak":true},{"text":"mpe balandaki makanisi na bango.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Soki bato na ngai bazalaki koyokela ngai,","poem":1},{"text":"soki Isalaele azalaki kolanda banzela na ngai,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"nalingaki mbala moko koyokisa","poem":1},{"text":"banguna na bango soni","poem":2},{"lineBreak":true},{"text":"mpe kobundisa bayini na bango.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mpe bato oyo bayinaka Yawe","poem":1},{"text":"balingaki komikitisa liboso na Ye,","poem":2},{"text":"mpe etumbu na bango elingaki kowumela","poem":1},{"text":"mpo na libela.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yawe alingaki koleisa Isalaele","poem":1},{"text":"bilei ya kitoko","poem":2},{"lineBreak":true},{"text":"mpe kotondisa bango na mafuta ya nzoyi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":17}