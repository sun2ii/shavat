{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":82,"content":[{"type":"heading","content":["Nzambe asambisaka bakambi ya bikolo"]},{"type":"verse","number":1,"content":[{"text":"Nzembo ya Azafi.","descriptive":true},{"text":"Nzambe atelemi kati na lisanga na Ye,","poem":1},{"text":"azali kokata makambo kati na banzambe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kino tango nini bokokata makambo","poem":1},{"text":"na bosembo te","poem":2},{"lineBreak":true},{"text":"mpe bokokotela bato mabe ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bolongisa moto oyo azangi makasi","poem":1},{"text":"mpe mwana etike,","poem":2},{"text":"bokata likambo ya moto ya mawa","poem":1},{"text":"mpe ya mobola ;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"bopesa bonsomi na moto oyo azangi makasi","poem":1},{"text":"mpe na mobola,","poem":2},{"lineBreak":true},{"text":"bokangola bango wuta na maboko ya bato mabe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bazangi boyebi mpe bososoli,","poem":1},{"text":"bazali koyengayenga kati na molili ;","poem":2},{"lineBreak":true},{"text":"miboko nyonso ya mokili ezali koningana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nalobaki : « Bozali banzambe,","poem":1},{"text":"bozali bino nyonso bana","poem":2},{"lineBreak":true},{"text":"ya Ye-Oyo-Aleki-Likolo ! »","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nzokande, bokufaka lokola bato nyonso","poem":1},{"text":"mpe bokweyaka lokola bakambi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nzambe, telema, sambisa mokili ;","poem":1},{"text":"pamba te bikolo nyonso ezali libula na Yo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}