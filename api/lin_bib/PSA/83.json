{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":83,"content":[{"type":"heading","content":["Telemela banguna na Yo"]},{"type":"verse","number":1,"content":[{"text":"Nzembo ya Azafi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Oh Nzambe, kovanda nye te !","poem":1},{"text":"Nzambe, kokanga monoko na Yo te,","poem":2},{"lineBreak":true},{"text":"kotikala kimia te !","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tala ndenge banguna na Yo bazali kotomboka ;","poem":1},{"text":"tala ndenge bayini na Yo bazali kotombola","poem":2},{"lineBreak":true},{"text":"mito na bango !","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bazali kosalela bato na Yo likita,","poem":1},{"text":"kokanela bato oyo obatelaka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bazali koloba : « Boya, toboma bango nyonso","poem":1},{"text":"mpo ete ekolo na bango ezala lisusu te,","poem":2},{"lineBreak":true},{"text":"mpo ete batanga lisusu kombo ya Isalaele te. »","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Basangani mpe bayokani,","poem":1},{"text":"basali boyokani mpo na kotelemela Yo :","poem":2}]},{"type":"verse","number":7,"content":[{"text":"bato ya Edomi mpe bato ya Isimaeli,","poem":1},{"text":"bato ya Moabi mpe bato ya Agari,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gebali, Amoni mpe Amaleki,","poem":1},{"text":"bato ya Filisitia elongo na bato ya Tiri.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bato ya Asiri mpe basangani elongo na bango","poem":1},{"text":"mpo na kobakisa bakitani ya Loti makasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Sala bango ndenge osalaki Madiani,","poem":1},{"text":"ndenge osalaki Sisera mpe Yabini,","poem":2},{"lineBreak":true},{"text":"kuna na mayi ya Kishoni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Babebisamaki na Eyini-Dori,","poem":1},{"text":"bakomaki lokola matiti ya kopola mpo na mabele.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sala bato na bango ya lokumu","poem":1},{"text":"ndenge osalaki Orebi mpe Zeebi ;","poem":2},{"text":"mpe sala bakambi na bango","poem":1},{"text":"ndenge osalaki Zeba mpe Tsalimuna","poem":2}]},{"type":"verse","number":13,"content":[{"text":"oyo bazalaki koloba :","poem":1},{"text":"« Tobotola mabele ya Nzambe ! »","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Nzambe na ngai, balola bango","poem":1},{"text":"lokola matiti oyo mopepe ezali kopumbwisa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndenge moto ezikisaka zamba,","poem":1},{"text":"ndenge moto makasi ezikisaka bangomba,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"landa bango na nzela ya mopepe na Yo","poem":1},{"text":"mpe bangisa bango","poem":2},{"lineBreak":true},{"text":"na nzela ya mopepe makasi na Yo !","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Yawe, tondisa bilongi na bango na soni","poem":1},{"text":"mpo ete baluka Kombo na Yo !","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tika ete soni mpe somo makasi elata bango","poem":1},{"text":"mpo na libela !","poem":2},{"lineBreak":true},{"text":"Tika ete bakufa na soni !","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tika bayeba ete Yo,","poem":1},{"text":"oyo Kombo na Yo ezali Yawe,","poem":2},{"text":"ozali Ye-Oyo-Aleki-Likolo","poem":1},{"text":"kati na mokili mobimba !","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":19}