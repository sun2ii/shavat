{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":84,"content":[{"type":"heading","content":["Nazali na posa makasi ya Tempelo na Yo"]},{"type":"verse","number":1,"content":[{"text":"Wuta na buku ya mokambi ya bayembi. Nzembo ya bana ya Kore. Ezali ya koyemba na lindanda ya bato ya Gati.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Yawe, Mokonzi ya mampinga,","poem":1},{"text":"tala ndenge bisika oyo ovandaka","poem":2},{"lineBreak":true},{"text":"ezali kopesa posa !","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nzoto na ngai mobimba ebukani pene nakufa","poem":1},{"text":"mpo na posa makasi ya lopango ya Yawe !","poem":2},{"text":"Motema mpe nzoto na ngai ezali koganga","poem":1},{"text":"epai ya Nzambe na bomoi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ndeke ya moke ezwaka esika ya kovanda,","poem":1},{"text":"mpe mbilambila esalaka zala","poem":2},{"text":"epai wapi etiaka bana na yango,","poem":1},{"text":"pene ya bitumbelo na Yo,","poem":2},{"text":"Yawe, Mokonzi ya mampinga,","poem":1},{"text":"Mokonzi na ngai mpe Nzambe na ngai.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Esengo na bavandi ya Ndako na Yo !","poem":1},{"text":"Bakokumisa Yo tango nyonso !","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Esengo na bato oyo bazwaka makasi kati na Yo ;","poem":1},{"text":"bakendaka na esengo na Tempelo na Yo !","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tango bakatisaka Lubwaku ya Baka,","poem":1},{"text":"bakomisaka yango esika oyo etonda na bitima ya mayi,","poem":2},{"lineBreak":true},{"text":"mpe mvula etondisaka yango na mapamboli.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Makasi na bango ebakisamaka tango nyonso","poem":1},{"text":"kino bakomaka na Siona, liboso ya Nzambe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawe, Nzambe-Na-Nguya-Nyonso,","poem":1},{"text":"yoka losambo na ngai !","poem":2},{"lineBreak":true},{"text":"Nzambe ya Jakobi, yoka ngai !","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Oh Nzambe, Yo oyo ozali nguba na biso, tala !","poem":1},{"text":"Tala elongi ya mopakolami na Yo !","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Lokola kovanda mokolo moko","poem":1},{"text":"kati na lopango na Yo","poem":2},{"text":"eleki kovanda mikolo nkoto moko","poem":1},{"text":"na esika mosusu,","poem":2},{"text":"naponaki kotelema na ekotelo","poem":1},{"text":"ya Ndako ya Nzambe na ngai","poem":2},{"text":"na esika ete navanda kati na bandako ya kapo","poem":1},{"text":"ya bato mabe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Pamba te, mpo na biso,","poem":1},{"text":"Yawe Nzambe azali moyi mpe nguba ;","poem":2},{"text":"Yawe apesaka ngolu mpe nkembo,","poem":1},{"text":"aboyaka kopesa eloko moko te","poem":2},{"lineBreak":true},{"text":"epai ya bato oyo batambolaka bazanga pamela.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yawe, Mokonzi ya mampinga,","poem":1},{"text":"esengo na moto oyo atiaka elikya kati na Yo !","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":13}