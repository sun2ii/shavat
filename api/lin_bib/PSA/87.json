{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":87,"content":[{"type":"heading","content":["Siona, etima ya bikolo nyonso"]},{"type":"verse","number":1,"content":[{"text":"Nzembo ya bana ya Kore.","descriptive":true},{"text":"Yawe atia moboko ya Siona","poem":1},{"text":"na likolo ya bangomba ya bule.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawe alingaka bikuke ya Siona","poem":1},{"text":"koleka bandako nyonso ya Jakobi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Oh engumba ya Nzambe,","poem":1},{"text":"maloba ya nkembo ezali kolobama na tina na yo !","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kati na bato oyo bayebi ngai,","poem":1},{"text":"natangi Rahavi mpe Babiloni.","poem":2},{"text":"Ezali kuna na Siona nde Filisitia, Tiri","poem":1},{"text":"mpe Kushi ebimela.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Na tina na Siona, maloba oyo ekolobama :","poem":1},{"text":"« Bato nyonso babimela awa,","poem":2},{"text":"mpe ezali Ye-Oyo-Aleki-Likolo","poem":1},{"text":"nde alendisaka yango. »","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tango Yawe akomaki","poem":1},{"text":"kati na buku ya bikolo,","poem":2},{"text":"akomaki boye mpo na moko na moko kati na bango :","poem":1},{"text":"« Moto songolo abotama kati na Siona ! »","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mpe tango bayembaka mpe babinaka, balobaka :","poem":1},{"text":"« Bitima na ngai nyonso ezali kati na yo ! »","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}