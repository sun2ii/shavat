{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":92,"content":[{"type":"heading","content":["Ezali malamu kokumisa Yawe"]},{"type":"verse","number":1,"content":[{"text":"Nzembo ya koyemba na mokolo ya Saba.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Tala ndenge ezali malamu kosanzola Yawe","poem":1},{"text":"mpe koyemba mpo na lokumu ya Kombo na","poem":2},{"lineBreak":true},{"text":"Yo-Oyo-Oleki-Likolo !","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tala ndenge ezali malamu kosakola bolingo na Yo,","poem":1},{"text":"na tongo,","poem":2},{"lineBreak":true},{"text":"mpe boyengebene na Yo, na butu,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"na lindanda ya basinga zomi","poem":1},{"text":"mpe na nzenze !","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawe, misala na Yo esepelisaka ngai !","poem":1},{"text":"Nagangaka na esengo liboso ya misala","poem":2},{"lineBreak":true},{"text":"ya maboko na Yo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yawe, misala na Yo ezali minene,","poem":1},{"text":"mpe makanisi na Yo ezali mozindo !","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Moto ya kilikili ayebaka te,","poem":1},{"text":"mpe zoba asosolaka eloko moko te.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tango bato mabe bakolaka lokola matiti,","poem":1},{"text":"mpe bato nyonso ya misala mabe bafulukaka,","poem":2},{"lineBreak":true},{"text":"ezalaka nde mpo ete babebisama libela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kasi Yo, kuna na likolo,","poem":1},{"text":"ozali Yawe mpo na libela.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yawe, banguna na Yo,","poem":1},{"text":"banguna na Yo bakokufa penza ;","poem":2},{"lineBreak":true},{"text":"bato nyonso ya misala mabe bakolimwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Okomisi ngai makasi lokola mpakasa,","poem":1},{"text":"opakoli ngai mafuta ya sika.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Miso na ngai ekomi komona bayini na ngai,","poem":1},{"text":"mpe matoyi na ngai ekomi koyoka","poem":2},{"text":"banguna na ngai nyonso, oyo bamibongisa","poem":1},{"text":"mpo na kosala ngai mabe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bato ya sembo bafulukaka lokola nzete ya mbila,","poem":1},{"text":"bakolaka lokola nzete ya sedele ya Libani.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Lokola bapikama ngwi","poem":1},{"text":"kati na Tempelo ya Yawe,","poem":2},{"text":"bamonaka bolamu kati na lopango","poem":1},{"text":"ya Nzambe na biso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ata bakomi mibange, babotaka kaka,","poem":1},{"text":"bazalaka kaka makasi mpe kitoko,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"basakolaka : « Yawe azali alima,","poem":1},{"text":"azali Libanga na biso ;","poem":2},{"lineBreak":true},{"text":"kati na Ye, mabe ezali te ! »","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":16}