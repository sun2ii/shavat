{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":93,"content":[{"type":"heading","content":["Yawe akonzaka mpo na libela na libela"]},{"type":"verse","number":1,"content":[{"text":"Yawe azali kokonza, alati lokumu monene ;","poem":1},{"text":"Yawe alati penza lokumu monene","poem":2},{"lineBreak":true},{"text":"mpe amizingeli na nguya.","poem":2},{"lineBreak":true},{"text":"Solo, mokili etelema ngwi, eninganaka te.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kiti ya Bokonzi na Yo epikama wuta kala ;","poem":1},{"text":"seko na seko, ozali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yawe, bibale egangaka !","poem":1},{"text":"Bibale etombolaka lokito na yango ;","poem":2},{"lineBreak":true},{"text":"bibale etombolaka makelele na yango.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawe azali monene makasi,","poem":1},{"text":"na bisika ya likolo ;","poem":2},{"text":"aleki lokito ya mayi minene,","poem":1},{"text":"mpe bambonge milayi ya ebale monene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yawe, malako na Yo ezali penza ya solo ;","poem":1},{"text":"bosantu elati Ndako na Yo mpo na libela.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}