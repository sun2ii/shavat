{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":95,"content":[{"type":"heading","content":["Mokili mobimba ezali kati na maboko ya Yawe"]},{"type":"verse","number":1,"content":[{"text":"Boya, toganga na esengo mpo na Yawe !","poem":1},{"text":"Tobetela Libanga na biso maboko,","poem":2},{"lineBreak":true},{"text":"pamba te azali Mobikisi na biso !","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tokende liboso na Ye","poem":1},{"text":"elongo na mabondeli ya kozongisa matondi,","poem":2},{"lineBreak":true},{"text":"tobetela Ye maboko elongo na banzembo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pamba te Yawe azali Nzambe Monene,","poem":1},{"text":"azali Mokonzi Monene,","poem":2},{"lineBreak":true},{"text":"na likolo ya banzambe nyonso.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Asimbi mozindo ya mokili kati na loboko na Ye ;","poem":1},{"text":"mpe basonge ya bangomba ezali ya Ye.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ebale monene ezali ya Ye,","poem":1},{"text":"azali Mokeli na yango ;","poem":2},{"text":"mabele ya kokawuka ezali mpe ya Ye,","poem":1},{"text":"asala yango na maboko na Ye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Boya, togumbama mpe tofukama,","poem":1},{"text":"tobuka mabolongo na biso liboso ya Yawe,","poem":2},{"lineBreak":true},{"text":"Mokeli na biso !","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Pamba te azali Nzambe na biso ;","poem":1},{"text":"tozali bato oyo aleisaka,","poem":2},{"lineBreak":true},{"text":"etonga oyo abatelaka.","poem":2},{"lineBreak":true},{"text":"Lelo, soki boyoki mongongo na Ye,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"« boyeisa mitema na bino mabanga te,","poem":2},{"lineBreak":true},{"text":"ndenge bosalaki na Meriba ;","poem":2},{"text":"ndenge bosalaki na mokolo wana","poem":1},{"text":"ya Masa kati na esobe","poem":2}]},{"type":"verse","number":9,"content":[{"text":"epai wapi batata na bino batombokelaki ngai","poem":1},{"text":"mpe bamekaki ngai atako bamonaki ngai kosala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mibu tuku minei, nayinaki bato","poem":1},{"text":"ya ekeke wana mpe nalobaki :","poem":2},{"text":"‹ Bazali bato oyo mitema na bango ebeba,","poem":1},{"text":"bayebaka banzela na ngai te. ›","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yango wana, kati na kanda na ngai, nakati seleka :","poem":1},{"text":"‹ Bakotikala kokota te","poem":2},{"lineBreak":true},{"text":"kati na bopemi na ngai ! › »","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}