{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":96,"content":[{"type":"heading","content":["Mokili mobimba esanzolaka Yawe, Mokonzi na yango"]},{"type":"verse","number":1,"content":[{"text":"Boyembela Yawe nzembo ya sika !","poem":1},{"text":"Bino nyonso, bato ya mokili mobimba,","poem":2},{"lineBreak":true},{"text":"boyembela Yawe !","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Boyembela Yawe,","poem":1},{"text":"bopambola Kombo na Ye !","poem":2},{"text":"Bopanza sango ya lobiko na Ye,","poem":1},{"text":"mokolo na mokolo !","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bopanza sango ya nkembo na Ye kati na mabota !","poem":1},{"text":"Boyebisa bato misala na Ye ya kokamwa","poem":2},{"lineBreak":true},{"text":"kati na bikolo nyonso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Pamba te Yawe azali monene","poem":1},{"text":"mpe abongi na lokumu,","poem":2},{"lineBreak":true},{"text":"azali somo makasi mpe aleki banzambe nyonso.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Banzambe nyonso ya bikolo ezali bikeko ya pamba,","poem":1},{"text":"nzokande Yawe akela likolo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kongenga mpe nkembo monene ezali liboso na Ye,","poem":1},{"text":"nguya mpe nkembo ezali","poem":2},{"lineBreak":true},{"text":"kati na Esika na Ye ya bule.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bino bituka ya mabota, bosanzola Yawe ;","poem":1},{"text":"bosanzola Yawe na kopanza","poem":2},{"lineBreak":true},{"text":"sango ya nkembo mpe nguya na Ye !","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bosanzola Yawe mpe bopesa","poem":1},{"text":"Kombo na Ye nkembo !","poem":2},{"text":"Bomema makabo na bino,","poem":1},{"text":"bokota na lopango na Ye !","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bogumbama liboso ya Yawe","poem":1},{"text":"oyo bosantu na Ye ezali kongenga makasi !","poem":2},{"text":"Bino bavandi ya mokili mobimba,","poem":1},{"text":"bolenga liboso na Ye !","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Boloba kati na mabota :","poem":1},{"text":"« Yawe azali Mokonzi !","poem":2},{"text":"Mokili elendisama makasi, ekoningana te.","poem":1},{"text":"Yawe asambisaka bato na bosembo. »","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tika ete likolo esepela,","poem":1},{"text":"mpe mabele ezala kati na esengo !","poem":2},{"text":"Tika ete ebale monene elongo na nyonso","poem":1},{"text":"oyo ezali kati na yango epesa lokito !","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tika ete zamba mobimba elongo na nyonso","poem":1},{"text":"oyo ezali kati na yango esepela,","poem":2},{"text":"mpe tika ete banzete nyonso ya zamba eganga","poem":1},{"text":"na esengo","poem":2}]},{"type":"verse","number":13,"content":[{"text":"liboso ya Yawe, pamba te azali koya !","poem":1},{"text":"Solo, azali koya kosambisa mabele ;","poem":2},{"text":"akosambisa mokili na bosembo,","poem":1},{"text":"mpe bikolo kolanda boyengebene na Ye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}