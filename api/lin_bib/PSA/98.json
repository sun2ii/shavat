{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":98,"content":[{"type":"heading","content":["Nzambe azali koya kosambisa mabele"]},{"type":"verse","number":1,"content":[{"text":"Nzembo.","descriptive":true},{"text":"Boyembela Yawe nzembo ya sika,","poem":1},{"text":"pamba te asalaka makambo ya kokamwa !","poem":2},{"text":"Na nguya mpe na bokonzi na Ye ya bonzambe,","poem":1},{"text":"alongaki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yawe atalisaki elonga na Ye,","poem":1},{"text":"amonisaki bosembo na Ye epai ya bikolo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Akanisaki bolingo mpe bosembo na Ye","poem":1},{"text":"mpo na libota ya Isalaele.","poem":2},{"text":"Kino na suka ya mokili,","poem":1},{"text":"elonga ya Nzambe na biso emonanaki.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mokili mobimba, bobetela Yawe maboko,","poem":1},{"text":"boyemba banzembo ya esengo","poem":2},{"lineBreak":true},{"text":"mpe bobeta mindule !","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bobetela Yawe lindanda,","poem":1},{"text":"boyembela Ye banzembo na lokito ya nzenze !","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bobeta maboko liboso ya Yawe, Mokonzi,","poem":1},{"text":"na lokito ya bakelelo mpe ya maseke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tika ete ebale monene elongo na nyonso","poem":1},{"text":"oyo ezali kati na yango,","poem":2},{"lineBreak":true},{"text":"mokili mpe bavandi na yango, bapesa lokito !","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tika ete bibale ebeta maboko","poem":1},{"text":"mpe bangomba nyonso eganga na esengo","poem":2}]},{"type":"verse","number":9,"content":[{"text":"liboso ya Yawe, pamba te azali koya","poem":1},{"text":"kosambisa mabele !","poem":2},{"lineBreak":true},{"text":"Akokata makambo na yango na bosembo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}