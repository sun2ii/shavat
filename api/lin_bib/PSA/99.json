{"translation":{"id":"lin_bib","name":"Biblica® Salela na bonsomi Mokanda na Bomoi","website":"https://ebible.org/Scriptures/details.php?id=lin","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lin","licenseNotes":null,"shortName":"BIB","englishName":"Lingala Bible","language":"lin","textDirection":"ltr","sha256":"bee8826cc0b45aeb7959d28d2a589a0268f8851a3934cbf2ef5983840d05a44c","availableFormats":["json"],"listOfBooksApiLink":"/api/lin_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31169,"languageName":"lingála","languageEnglishName":"Lingala"},"book":{"id":"PSA","translationId":"lin_bib","name":"Banzembo","commonName":"Banzembo","title":"Banzembo","order":19,"numberOfChapters":150,"sha256":"3abd2bbf39d822bc221feacca64e58c9b1281ae36c15c976ee0d778051532fde","firstChapterNumber":1,"firstChapterApiLink":"/api/lin_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lin_bib/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":99,"content":[{"type":"heading","content":["Bogumbamela Yawe, pamba te azali Mosantu"]},{"type":"verse","number":1,"content":[{"text":"Yawe azali kokonza ;","poem":1},{"text":"tika ete bato balenga !","poem":2},{"text":"Avandi na Kiti ya Bokonzi kati na basheribe ;","poem":1},{"text":"tika ete mabele eningana !","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawe azali monene kati na Siona,","poem":1},{"text":"mpe Bokonzi na Ye ezali likolo ya bikolo nyonso.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tika ete Kombo na Yo ya monene","poem":1},{"text":"mpe ya somo esanzolama ;","poem":2},{"lineBreak":true},{"text":"ezali bule !","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mokonzi azali na nguya, alingaka bosolo.","poem":1},{"text":"Olendisaka bosembo.","poem":2},{"lineBreak":true},{"text":"Osalaki bosembo mpe bosolo kati na Jakobi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bonetola Yawe, Nzambe na biso,","poem":1},{"text":"mpe bogumbama liboso ya enyatelo makolo na Ye ;","poem":2},{"lineBreak":true},{"text":"azali Mosantu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Moyize mpe Aron kati na Banganga-Nzambe na Ye,","poem":1},{"text":"mpe Samuele kati na bato","poem":2},{"text":"oyo bazalaki kobelela Kombo na Ye,","poem":1},{"text":"bazalaki kobelela Yawe,","poem":2},{"lineBreak":true},{"text":"mpe Ye azalaki koyanola bango.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Azalaki koloba na bango kati na likonzi ya lipata.","poem":1},{"text":"Babatelaki malako na Ye","poem":2},{"lineBreak":true},{"text":"mpe mibeko oyo apesaki bango.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yawe, Nzambe na biso, oyanolaki bango.","poem":1},{"text":"Mpo na bango, ozalaki Nzambe oyo alimbisaka","poem":2},{"text":"atako opesaki bango etumbu","poem":1},{"text":"mpo na misala na bango ya mabe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bonetola Yawe, Nzambe na biso,","poem":1},{"text":"mpe bogumbama na kotala","poem":2},{"text":"na ngambo ya ngomba na Ye ya bule.","poem":1},{"text":"Pamba te Yawe, Nzambe na biso, azali bule.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lin_bib/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lin_bib/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lin_bib/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}