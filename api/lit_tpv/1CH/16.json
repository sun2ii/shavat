{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"1CH","translationId":"lit_tpv","name":"I Metraščių","commonName":"I Metraščių","title":"Metraščių pirma knyga","order":13,"numberOfChapters":10,"sha256":"043556dca4ba59dd231b4a4b1f4799e6f040415d608415c75c5c1d4f2fddb50b","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/lit_tpv/1CH/29.json","totalNumberOfVerses":21},"chapter":{"number":16,"content":[{"type":"verse","number":12,"content":["Atsiminkite jo nuostabius darbus, kuriuos jis padarė, jo stebuklus ir jo burnos nuosprendžius,"]},{"type":"verse","number":29,"content":[{"noteId":6},"Suteikite VIEŠPAČIUI",{"noteId":7},"šlovę, priklausančią jo vardui, atneškite auką ir ateikite jo akivaizdon,",{"noteId":8},"garbinkite VIEŠPATĮ",{"noteId":9},"šventumo grožyje."]},{"type":"verse","number":34,"content":["Dėkokite VIEŠPAČIUI, nes jis geras, nes jo",{"noteId":10},"gailestingumas išlieka per amžius!"]},{"type":"verse","number":35,"content":["Ir sakykite: „Išgelbėk mus, o mūsų išgelbėjimo Dieve, ir surink mus ir išvaduok iš kitataučių, kad dėkotume tavo šventajam vardui ir kad girtumėmės tavo",{"noteId":11},"girtinais veiksmais."]}],"footnotes":[{"noteId":6,"caller":"+","text":"„Suteikite“ – Pagonybės paveikti žmonės suteikdavo duonai stebuklingų galių, bet Dievo apreiškimo paveikti žmonės turi suteikti (pripažinti) VIEŠPAČIUI stebuklingų savybių. Plg. Ps 29:1-2, 96:7-8; Apr 4:9, 11:13, 14:7, 16:9, 19:7.","reference":{"chapter":16,"verse":29}},{"noteId":7,"caller":"+","text":"„šlovę, priklausančią jo vardui“ – Arba „jo vardo šlovę“.","reference":{"chapter":16,"verse":29}},{"noteId":8,"caller":"+","text":"„garbinkite“ – Arba „nusilenkite VIEŠPAČIUI“, „parpulkite VIEŠPAČIUI“.","reference":{"chapter":16,"verse":29}},{"noteId":9,"caller":"+","text":"„šventumo grožyje“ – žr. II Met 20:21; Ps 29:2; Ps 96:9; Ps 110:3.","reference":{"chapter":16,"verse":29}},{"noteId":10,"caller":"+","text":"„gailestingumas“ – Arba „geranoriškumas“, „palankumas“.","reference":{"chapter":16,"verse":34}},{"noteId":11,"caller":"+","text":"„girtinais veiksmais“ – T. „gyriuje“ arba „gyriumi“. Atrodo, kad reikšmė ta, kad jie turi pagrindą didžiuoti ne savimi, bet Dievo darbais, kurie verti gyriaus. Plg. Iš 15:11.","reference":{"chapter":16,"verse":35}}]},"thisChapterLink":"/api/lit_tpv/1CH/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/1CH/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/1CH/11.json","previousChapterAudioLinks":{},"numberOfVerses":4}