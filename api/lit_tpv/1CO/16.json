{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"1CO","translationId":"lit_tpv","name":"I Korintiečiams","commonName":"I Korintiečiams","title":"Pirmas laiškas korintiečiams","order":46,"numberOfChapters":16,"sha256":"ce54587b06c47ce7ff11a7121b3b46faf02748fe579dcc8702cd62c50af76306","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/1CO/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/lit_tpv/1CO/16.json","totalNumberOfVerses":228},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":["O dėl rinkliavos šventiesiems: kaip nurodžiau Galatijos bažnyčioms, taip ir jūs darykite."]},{"type":"verse","number":4,"content":["Ir jeigu",{"noteId":189},"bus tinkama, kad ir aš keliaučiau, tai jie keliaus su manimi."]},{"type":"verse","number":9,"content":["nes",{"noteId":190},"man yra atsiverusios plačios ir",{"noteId":191},"veiksmingos durys, – o priešininkų daug."]},{"type":"verse","number":13,"content":["Budėkite, tvirtai stovėkite tikėjime,",{"noteId":192},"elkitės vyriškai, būkite stiprūs."]},{"type":"verse","number":14,"content":["Viską, ką darote, darykite su meile."]},{"type":"verse","number":15,"content":[{"noteId":193},"Maldauju jus, broliai (jūs pažįstate Stepono šeimyną, kad ji yra Achajos pirmasis vaisius, ir kad jie",{"noteId":194},"atsidavė",{"noteId":195},"tarnauti šventiesiems),"]},{"type":"verse","number":16,"content":["kad jūs taip pat tokiems elgtumėtės pavaldžiai ir kiekvienam bendradarbiaujančiam ir triūsiančiam."]},{"type":"verse","number":17,"content":["Džiaugiuosi Stepono, Fortunato ir Achaiko atvykimu dėl to, kad",{"noteId":196},"jie parūpino",{"noteId":197},"tai, ko trūko iš jūsų pusės,"]},{"type":"verse","number":18,"content":["nes jie atgaivino mano dvasią – taip pat jūsų. Tad pripažinkite tokius žmones!"]}],"footnotes":[{"noteId":189,"caller":"+","text":"„bus tinkama“ – Arba „priderės“.","reference":{"chapter":16,"verse":4}},{"noteId":190,"caller":"+","text":"„man yra atsiverusios plačios ir veiksmingos durys“ t. y. man atsirado proga (arba „galimybė“) plačiai ir veiksmingai (arba „stropiai dirbdamas“).","reference":{"chapter":16,"verse":9}},{"noteId":191,"caller":"+","text":"„veiksmingos durys“ – Arba „pilnos darbų“, „paveiklios“.","reference":{"chapter":16,"verse":9}},{"noteId":192,"caller":"+","text":"„elkitės vyriškai“ t. y. vykdykite pareigas kaip vyrai; žr. 1Sa 4:9.","reference":{"chapter":16,"verse":13}},{"noteId":193,"caller":"+","text":"„Maldauju“ – Arba „Įspėdamas bei padrąsindamas raginu“.","reference":{"chapter":16,"verse":15}},{"noteId":194,"caller":"+","text":"„atsidavė“ – Arba „paskyrė save“.","reference":{"chapter":16,"verse":15}},{"noteId":195,"caller":"+","text":"„tarnauti šventiesiems“ – T. „šventųjų tarnavimui“.","reference":{"chapter":16,"verse":15}},{"noteId":196,"caller":"+","text":"„jie parūpino“ – T. „užpildė“. Gr. žodis ἀναπληρόω (anaplėróō) vartojamas panašia prasme Flp 2:30.","reference":{"chapter":16,"verse":17}},{"noteId":197,"caller":"+","text":"„tai, ko trūko iš jūsų pusės“ – Nekalbama apie pinigus ar materialius daiktus, nes Paulius neimdavo iš korintiečių ir buvo nusistatęs neimti iš jų (II Kor 11:7-9). Vieni mano, kad Paulius kalba apie artimą, betarpišką draugystę, kuri būti jei Paulius būtų pas juos ar jie pas jį. Kiti mano, kad truko žinių apie Korinto bažnyčios būklę.","reference":{"chapter":16,"verse":17}}]},"thisChapterLink":"/api/lit_tpv/1CO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/2CO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/1CO/15.json","previousChapterAudioLinks":{},"numberOfVerses":9}