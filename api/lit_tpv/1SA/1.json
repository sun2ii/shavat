{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"1SA","translationId":"lit_tpv","name":"I Samuelio","commonName":"I Samuelio","title":"Samuelio pirma knyga","order":9,"numberOfChapters":10,"sha256":"f0055150dab75b5e0d3a488a970eaeaced8d3df6ac778ecbc40d4aa2c9f9a56f","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/1SA/1.json","lastChapterNumber":18,"lastChapterApiLink":"/api/lit_tpv/1SA/18.json","totalNumberOfVerses":23},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"noteId":0},"Štai buvo tam tikras vyras iš",{"noteId":1},"Ramataim-Cofimų, iš Efraimo kalnyno, vardu Elkana,",{"noteId":2},"efratiečio Cūfo sūnaus Tohuvo sūnaus Elihuvo sūnaus Jerohamo sūnus."]},{"type":"verse","number":2,"content":["Ir jis turėjo dvi žmonas: pirmosios vardas buvo",{"noteId":3},"Ona, o antrosios vardas – Penina. Penina turėjo vaikų, bet Ona neturėjo vaikų."]},{"type":"verse","number":3,"content":["Ir šis vyras",{"noteId":4},"kasmet iš savo miesto",{"noteId":5},"eidavo aukštyn garbinti ir aukoti kareivijų VIEŠPAČIUI Šilojyje. Ir ten buvo du Elio sūnūs, Hofnis ir Finehasas, VIEŠPATIES kunigai."]}],"footnotes":[{"noteId":0,"caller":"+","text":"„Štai“ t. „Ir“.","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"„Ramataim-Cofimų“ – Arba „Cofimų (Sargybinių) Ramataimų (dviejų aukštumų)“.","reference":{"chapter":1,"verse":1}},{"noteId":2,"caller":"+","text":"„efratiečio“ – hbr. tekste nėra visai aišku, ar „efratietis“ gramatiškai apibūdina Elkaną arba jo proprosenelį Cūfą; jei apibūdina Elkaną, vertimas būtų toks: „[…] tam tikras vyras – efratietis – iš […] vardu Elkana, Cūfo […]“.","reference":{"chapter":1,"verse":1}},{"noteId":3,"caller":"+","text":"„Ona“ – Arba „Chana“.","reference":{"chapter":1,"verse":2}},{"noteId":4,"caller":"+","text":"„kasmet“ – hbr. „nuo metų iki metų“ arba „nuo dienų iki dienų“.","reference":{"chapter":1,"verse":3}},{"noteId":5,"caller":"+","text":"„eidavo aukštyn“ – Arba „kildavo“.","reference":{"chapter":1,"verse":3}}]},"thisChapterLink":"/api/lit_tpv/1SA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/1SA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/RUT/2.json","previousChapterAudioLinks":{},"numberOfVerses":3}