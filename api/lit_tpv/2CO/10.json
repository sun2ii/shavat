{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"2CO","translationId":"lit_tpv","name":"II Korintiečiams","commonName":"II Korintiečiams","title":"Antras laiškas korintiečiams","order":47,"numberOfChapters":13,"sha256":"e3b15443bdbb60bc18e9f87ed39226577207972e96e88cf9d4cc3570ea67931b","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/2CO/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/lit_tpv/2CO/13.json","totalNumberOfVerses":80},"chapter":{"number":10,"content":[{"type":"verse","number":3,"content":["Nes, nors vaikščiojame",{"noteId":71},"kūne, kovojame ne pagal kūniškumą,"]},{"type":"verse","number":4,"content":["(nes mūsų kovos ginklai nėra kūniški, bet galingi",{"noteId":72},"per Dievą tvirtovėms griauti)"]},{"type":"verse","number":5,"content":["nuversdami sumanymus ir visa, kas aukšta, kas išsikelia prieš Dievo pažinimą, ir atvesdami nelaisvėn kiekvieną mintį, kad paklustų Kristui"]},{"type":"verse","number":6,"content":["ir būdami pasirengę",{"noteId":73},"atlyginti už kiekvieną neklusnumą, kai jūsų klusnumas bus",{"noteId":74},"visiškas."]},{"type":"verse","number":12,"content":["Nes nedrįstame savęs gretinti ar palyginti su kai kuriais, kurie save teigiamai pristato. Bet jie, matuodami save pagal save pačius ir palygindami save",{"noteId":75},"su savimi,",{"noteId":76},"nedaro išmingtingų išvadų."]},{"type":"verse","number":17,"content":["O KAS GIRIASI,",{"noteId":77},"TESIGIRIA VIEŠPAČIU."]},{"type":"verse","number":18,"content":["Nes ne tas",{"noteId":78},"pripažintas tinkamu, kuris teigiamai pristato save, bet kurį teigiamai pristato Viešpats."]}],"footnotes":[{"noteId":71,"caller":"+","text":"„kūne“, „kūniškumą“ – Gr. σάρξ (sárx) šioje eilutėje vartojamas du kartus. Žodis σάρξ turi ne vieną apibrėžtį ir čia vartojamas dviem skirtingomis reikšmėmis. Pirmu atveju kalbama apie fizinį kūną, kuriame arba kuriuo žmogus užsiima gyvenimu materialiame pasaulyje. Antru atveju, žodis σάρξ akivaizdžiai turi kitą, neigiamą, reikšmę. Ten nurodo (1) kūniškumą arba (2) kūniškąjį aš arba (3) fizinius (grynai kūno) dalykus, kurie lemia vertybes ir sprendimus. Žodis σάρξ vartojamas neigiama prasme NT ir čia: Rom 8:1, 4, 5, 12-13; II Kor 10:2.","reference":{"chapter":10,"verse":3}},{"noteId":72,"caller":"+","text":"„per Dievą“ – Arba „Dievui“.","reference":{"chapter":10,"verse":4}},{"noteId":73,"caller":"+","text":"„atlyginti“ – Arba „atkeršyti“, t. y. nubausti.","reference":{"chapter":10,"verse":6}},{"noteId":74,"caller":"+","text":"„visiškas“ – Arba „užbaigtas“, „be trūkumų“, „netrūktinas“; gr. žodis rodo į pilnatvę.","reference":{"chapter":10,"verse":6}},{"noteId":75,"caller":"+","text":"„su savimi“ – Arba „tarpusavyje“.","reference":{"chapter":10,"verse":12}},{"noteId":76,"caller":"+","text":"„nedaro išmintingų išvadų“ – Arba „nedaro protingų išvadų“, „nesusigaudo“ (šnek.).","reference":{"chapter":10,"verse":12}},{"noteId":77,"caller":"+","text":"„tesigiria“ – Arba „turi girtis“.","reference":{"chapter":10,"verse":17}},{"noteId":78,"caller":"+","text":"„pripažintas tinkamu“ – Arba „išlaikęs tyrimą“.","reference":{"chapter":10,"verse":18}}]},"thisChapterLink":"/api/lit_tpv/2CO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/2CO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/2CO/9.json","previousChapterAudioLinks":{},"numberOfVerses":7}