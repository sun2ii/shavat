{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"2CO","translationId":"lit_tpv","name":"II Korintiečiams","commonName":"II Korintiečiams","title":"Antras laiškas korintiečiams","order":47,"numberOfChapters":13,"sha256":"e3b15443bdbb60bc18e9f87ed39226577207972e96e88cf9d4cc3570ea67931b","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/2CO/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/lit_tpv/2CO/13.json","totalNumberOfVerses":80},"chapter":{"number":12,"content":[{"type":"verse","number":7,"content":["Ir kad nebūčiau perdėm išaukštintas dėl apreiškimų",{"noteId":82},"gausybės, man buvo duotas dyglys kūne, Šėtono pasiuntinys, kad mane smūgiuotų tam tikslui, kad nebūčiau perdėm išaukštintas."]},{"type":"verse","number":8,"content":["Už tai tris kartus maldavau Viešpatį, kad tai nuo manęs atitrauktų."]},{"type":"verse","number":9,"content":["Bet jis man tarė:",{"text":"„Pakanka tau mano malonės, nes mano jėga","wordsOfJesus":true},{"noteId":83},{"text":"tampa tobula silpnume.“","wordsOfJesus":true},"Todėl verčiau mieliausiai girsiuosi savo silpnumais, kad Kristaus jėga",{"noteId":84},"apgaubtų mane."]},{"type":"verse","number":10,"content":["Todėl",{"noteId":85},"gėriuosi silpnumais, įžeidimais,",{"noteId":86},"priverstiniais dalykais, persekiojimais,",{"noteId":87},"sielvartais dėl Kristaus, nes, kai esu silpnas, tada esu",{"noteId":88},"stiprus."]},{"type":"verse","number":20,"content":["Mat aš bijau, kad kartais atvykęs nerasčiau jūsų tokių, kokių nenoriu, ir kad",{"noteId":89},"jūs nerastumėte manęs tokio, kokio jūs nenorite, kad kartais nebūtų nesutarimų,",{"noteId":90},"pavyduliavimų, pykčio proveržių, priešiškų norų pirmauti, apkalbų, šnibždėtų paskalų, pasipūtimų,",{"noteId":91},"sumišimų,"]}],"footnotes":[{"noteId":82,"caller":"+","text":"„gausybės“ – Arba „didingumo“.","reference":{"chapter":12,"verse":7}},{"noteId":83,"caller":"+","text":"„tampa tobula“ – Arba „pasiekia tikslą“.","reference":{"chapter":12,"verse":9}},{"noteId":84,"caller":"+","text":"„apgaubtų mane“ – T. y. prasiskėstų ant manęs kaip palapinė apgaubia stovyklautojus.","reference":{"chapter":12,"verse":9}},{"noteId":85,"caller":"+","text":"„gėriuosi silpnumais“ – T. y., „jaučiu malonumą per savo silpnumus (negalias)“, „džiaugiuosi silpnumais (negaliomis)“.","reference":{"chapter":12,"verse":10}},{"noteId":86,"caller":"+","text":"„priverstiniais dalykais“ – Arba „būtinumais“, „prievartomis“, „prievarta priskirtais dalykais“; gal „poreikiais“.","reference":{"chapter":12,"verse":10}},{"noteId":87,"caller":"+","text":"„sielvartais“ – Gal „priespaudomis“.","reference":{"chapter":12,"verse":10}},{"noteId":88,"caller":"+","text":"„stiprus“ – Arba „galingas“, „pajėgus“.","reference":{"chapter":12,"verse":10}},{"noteId":89,"caller":"+","text":"„jūs nerastumėte manęs tokio, kokio jūs nenorite“ – T. „jums nebūčiau rastas toks, kokio jūs nenorite“.","reference":{"chapter":12,"verse":20}},{"noteId":90,"caller":"+","text":"„pavyduliavimų“ – Arba „rungtyniavimų“, „uolaus pirmenybės siekimo atvejų“","reference":{"chapter":12,"verse":20}},{"noteId":91,"caller":"+","text":"„sumišimų“ – Arba „sumaisčių“, „sąmyšių“.","reference":{"chapter":12,"verse":20}}]},"thisChapterLink":"/api/lit_tpv/2CO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/2CO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/2CO/11.json","previousChapterAudioLinks":{},