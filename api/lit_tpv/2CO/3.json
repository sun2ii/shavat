{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"2CO","translationId":"lit_tpv","name":"II Korintiečiams","commonName":"II Korintiečiams","title":"Antras laiškas korintiečiams","order":47,"numberOfChapters":13,"sha256":"e3b15443bdbb60bc18e9f87ed39226577207972e96e88cf9d4cc3570ea67931b","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/2CO/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/lit_tpv/2CO/13.json","totalNumberOfVerses":80},"chapter":{"number":3,"content":[{"type":"verse","number":5,"content":["Ne todėl, kad būtume savaime tinkami ką nors sumanyti tarytum iš savęs, bet mūsų",{"noteId":13},"tinkamumas yra iš Dievo,"]},{"type":"verse","number":6,"content":["kuris taip pat padarė mus",{"noteId":14},"tinkamais naujos sandaros tarnais – ne raidės, bet Dvasios, nes raidė užmuša, bet Dvasia duoda gyvybę."]},{"type":"verse","number":8,"content":["tai kaip gi Dvasios tarnystė nebus dar labiau šlovinga?!"]},{"type":"verse","number":16,"content":["Tačiau kada tik",{"noteId":15},"ji atsiverčia į Viešpatį,",{"noteId":16},"šydas nuimamas."]},{"type":"verse","number":17,"content":["Viešpats gi yra ta Dvasia, ir kur Viešpaties Dvasia, ten laisvė."]},{"type":"verse","number":18,"content":["Bet mes visi, atidengtu veidu žiūrėdami lyg veidrodyje į Viešpaties šlovę, kaip tik",{"noteId":17},"Viešpaties,",{"noteId":18},"tai yra Dvasios, veikimu esame",{"noteId":19},"perkeičiami į tą patį atvaizdą iš šlovės į šlovę."]}],"footnotes":[{"noteId":13,"caller":"+","text":"„tinkamumas“ – Arba „sugebėjimas“, „atitikimas tarno pareigų reikalavimus“.","reference":{"chapter":3,"verse":5}},{"noteId":14,"caller":"+","text":"„tinkamais“ – Arba „sugebančiais“.","reference":{"chapter":3,"verse":6}},{"noteId":15,"caller":"+","text":"„ji“ t. y., „širdis“.","reference":{"chapter":3,"verse":16}},{"noteId":16,"caller":"+","text":"„šydas“ – Arba „gobtuvas“.","reference":{"chapter":3,"verse":16}},{"noteId":17,"caller":"+","text":"arba: Viešpaties Dvasios.","reference":{"chapter":3,"verse":18}},{"noteId":18,"caller":"+","text":"arba: kuris yra Dvasia / dvasia.","reference":{"chapter":3,"verse":18}},{"noteId":19,"caller":"+","text":"arba: permainomi.","reference":{"chapter":3,"verse":18}}]},"thisChapterLink":"/api/lit_tpv/2CO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/2CO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/2CO/2.json","previousChapterAudioLinks":{},"numberOfVerses":6}