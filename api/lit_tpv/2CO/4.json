{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"2CO","translationId":"lit_tpv","name":"II Korintiečiams","commonName":"II Korintiečiams","title":"Antras laiškas korintiečiams","order":47,"numberOfChapters":13,"sha256":"e3b15443bdbb60bc18e9f87ed39226577207972e96e88cf9d4cc3570ea67931b","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/2CO/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/lit_tpv/2CO/13.json","totalNumberOfVerses":80},"chapter":{"number":4,"content":[{"type":"verse","number":3,"content":["Bet jei ir mūsų evangelija yra",{"noteId":20},"paslėpta, ji yra paslėpta žūstantiems,"]},{"type":"verse","number":4,"content":["kurių atveju šio",{"noteId":21},"pasaulio dievas apakino jų kaip netikinčių protus, kad jiems nenušvistų Kristaus, kuris yra Dievo atvaizdas,",{"noteId":22},"šlovingos evangelijos šviesa."]},{"type":"verse","number":5,"content":["Mat ne save pačius skelbiame, bet Kristų Jėzų – Viešpatį, o save – jūsų",{"noteId":23},"tarnais Jėzaus dėlei."]},{"type":"verse","number":6,"content":["Nes Dievas, kuris liepė šviesai iš tamsos nušvisti, mūsų širdyse nušvito, kad suteiktų Dievo šlovės pažinimo šviesą Jėzaus Kristaus veide."]},{"type":"verse","number":8,"content":["Mes visaip spaudžiami, tačiau nepriverčiami sielvartauti; sutrikdomi, bet nenusivylę;"]},{"type":"verse","number":9,"content":["persekiojami, bet neapleidžiami; mes parbloškiami, bet nesunaikinami,"]},{"type":"verse","number":10,"content":["visuomet šen ir ten nešiodamiesi kūne Viešpaties Jėzaus mirimą, kad ir Jėzaus gyvybė apsireikštų mūsų kūne."]},{"type":"verse","number":11,"content":["Nes mes, gyvieji, dėl Jėzaus esame nuolat atiduodami mirčiai, kad ir Jėzaus gyvybė apsireikštų mūsų mirtingame kūne."]},{"type":"verse","number":16,"content":["Todėl mes nepailstame. Atvirkščiai, nors mūsų išorinis žmogus ir",{"noteId":24},"genda, tačiau vidinis atnaujinamas diena iš dienos."]},{"type":"verse","number":17,"content":["Nes mūsų",{"noteId":25},"lengvas prispaudimas, trunkantis tik akimirksnį, paruošia mums visa didžiai pranokstantį amžiną šlovės svorį,"]},{"type":"verse","number":18,"content":["mums žiūrint ne į regimus dalykus, bet į neregimus, nes regimieji dalykai yra laikini, bet neregimieji yra amžini."]}],"footnotes":[{"noteId":20,"caller":"+","text":"„paslėpta“ – Arba „uždengta“.","reference":{"chapter":4,"verse":3}},{"noteId":21,"caller":"+","text":"„pasaulio“ – Arba „amžiaus“.","reference":{"chapter":4,"verse":4}},{"noteId":22,"caller":"+","text":"„šlovingos“ – T. „šlovės“; plg. I Tim 1:11.","reference":{"chapter":4,"verse":4}},{"noteId":23,"caller":"+","text":"„tarnais“ – Arba „vergais“.","reference":{"chapter":4,"verse":5}},{"noteId":24,"caller":"+","text":"„genda“ – Žr. I Kor 15:50, Judo 10.","reference":{"chapter":4,"verse":16}},{"noteId":25,"caller":"+","text":"„lengvas prispaudimas“ – T. „prispaudimo lengvumas“.","reference":{"chapter":4,"verse":17}}]},"thisChapterLink":"/api/lit_tpv/2CO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/2CO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/2CO/3.json","previousChapterAudioLinks":{},"numberOfVerses":11}