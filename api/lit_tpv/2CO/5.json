{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"2CO","translationId":"lit_tpv","name":"II Korintiečiams","commonName":"II Korintiečiams","title":"Antras laiškas korintiečiams","order":47,"numberOfChapters":13,"sha256":"e3b15443bdbb60bc18e9f87ed39226577207972e96e88cf9d4cc3570ea67931b","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/2CO/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/lit_tpv/2CO/13.json","totalNumberOfVerses":80},"chapter":{"number":5,"content":[{"type":"verse","number":6,"content":["Taigi visuomet būdami drąsiai nusiteikę ir žinodami, kad, kol gyvename namie, kūne, gyvename svetur nuo Viešpaties –"]},{"type":"verse","number":7,"content":["(nes",{"noteId":26},"vaikščiojame",{"noteId":27},"tikėjimu, ne regėjimu) –"]},{"type":"verse","number":8,"content":["mes esame drąsiai nusiteikę ir mieliau norėtume nebegyventi kūno namuose ir gyventi namie pas Viešpatį."]},{"type":"verse","number":9,"content":["Todėl, ar būdami namie, ar svetur, uoliai stengiamės jam patikti."]},{"type":"verse","number":10,"content":["Nes mes visi turime pasirodyti prieš Kristaus teismo krasę, kad kiekvienas gautų atlygį už",{"noteId":28},"kūnu padarytus dalykus, pagal",{"noteId":29},"tai, ką jis padarė, ar tai būtų gera ar bloga."]},{"type":"verse","number":14,"content":["Nes Kristaus meilė verčia veikti mus, padariusius išvadą, kad",{"noteId":30},"jeigu vienas mirė už visus, tai visi",{"noteId":31},"mirė;"]},{"type":"verse","number":15,"content":["ir jis mirė už visus, kad tie, kurie gyvena, nuo šiol nebe sau gyventų, bet tam, kuris už juos mirė ir prisikėlė."]},{"type":"verse","number":17,"content":["Taigi, jei kas yra Kristuje, tas yra naujas kūrinys; kas sena, praėjo, štai visa yra pasidariusi nauja."]},{"type":"verse","number":18,"content":["Ir",{"noteId":32},"visa tai yra iš Dievo, kuris mus per Jėzų Kristų sutaikino su savimi ir davė mums sutaikinimo tarnystę,"]},{"type":"verse","number":19,"content":[{"noteId":33},"būtent, kad Dievas buvo Kristuje sutaikindamas pasaulį su savimi, neįskaitydamas jiems jų",{"noteId":34},"nusižengimų, ir mums patikėdamas sutaikinimo",{"noteId":35},"žodį."]},{"type":"verse","number":20,"content":["Taigi esame pasiuntiniai atstovaudami Kristui, tarsi per mus",{"noteId":36},"įspėdamas ragintų pats Dievas; atstovaudami Kristui jus meldžiame: „Susitaikykite su Dievu!“"]},{"type":"verse","number":21,"content":["Nes mūsų labui",{"noteId":37},"jis pavertė nuodėme",{"noteId":38},"tą, kuris",{"noteId":39},"nepadarė nuodėmės, kad mes",{"noteId":40},"jame taptume Dievo teisumu."]}],"footnotes":[{"noteId":26,"caller":"+","text":"„vaikščiojame“ – T. y. „elgiamės“.","reference":{"chapter":5,"verse":7}},{"noteId":27,"caller":"+","text":"„tikėjimu, ne regėjimu“ – T. „per tikėjimą, ne per regėjimą“.","reference":{"chapter":5,"verse":7}},{"noteId":28,"caller":"+","text":"„kūnu“ – Gal „kūne“; t. „per kūną“.","reference":{"chapter":5,"verse":10}},{"noteId":29,"caller":"+","text":"„tai“ – Irgi dgs. gr. žodis, kaip ir žodis anksčiau išverstas „dalykus“.","reference":{"chapter":5,"verse":10}},{"noteId":30,"caller":"+","text":"„jeigu“ – Arba „kadangi“.","reference":{"chapter":5,"verse":14}},{"noteId":31,"caller":"+","text":"„mirė“ t. y., mirė su Juo arba Jame.","reference":{"chapter":5,"verse":14}},{"noteId":32,"caller":"+","text":"„visa tai“ – Gr. dgs.","reference":{"chapter":5,"verse":18}},{"noteId":33,"caller":"+","text":"„būtent, kad“ – Arba „kaip kad“, „būtent šitaip:“.","reference":{"chapter":5,"verse":19}},{"noteId":34,"caller":"+","text":"„nusižengimų“ – Arba „nusikaltimų“.","reference":{"chapter":5,"verse":19}},{"noteId":35,"caller":"+","text":"„žodį“ t. y., „žinią“, „pranešimą“.","reference":{"chapter":5,"verse":19}},{"noteId":36,"caller":"+","text":"„įspėdamas ragintų“ – Tai vienas gr. žodis „parakaleo“.","reference":{"chapter":5,"verse":20}},{"noteId":37,"caller":"+","text":"„jis“ – T. y. Dievas Tėvas.","reference":{"chapter":5,"verse":21}},{"noteId":38,"caller":"+","text":"„tą“ – T. y. Jėzų Kristų (Dievą Sūnų).","reference":{"chapter":5,"verse":21}},{"noteId":39,"caller":"+","text":"„nepadarė nuodėmės“ – T. „nepažino nuodėmės“.","reference":{"chapter":5,"verse":21}},{"noteId":40,"caller":"+","text":"„jame“ – T. y. Jėzuje Kristuje.","reference":{"chapter":5,"verse":21}}]},"thisChapterLink":"/api/lit_tpv/2CO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/2CO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/2CO/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}