{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"ACT","translationId":"lit_tpv","name":"Apaštalų darbai","commonName":"Apaštalų darbai","title":"Apaštalų darbų knyga","order":44,"numberOfChapters":26,"sha256":"c9cb34b1ba29986c694593b553b785994b29bbcd05471cec8100f857cdf6d82b","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/ACT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/lit_tpv/ACT/28.json","totalNumberOfVerses":227},"chapter":{"number":11,"content":[{"type":"heading","content":["Petras paaiškina žydų kilmės broliams apie Evangelijos skelbimą kitataučiams"]},{"type":"verse","number":1,"content":["Ir apaštalai ir broliai, kurie buvo Judėjoje, išgirdo, kad ir",{"noteId":93},"kitataučiai priėmė Dievo žodį."]},{"type":"verse","number":16,"content":["Tada prisiminiau Viešpaties žodį, kaip jis",{"noteId":94},"sakydavo:",{"text":"‚Jonas,","wordsOfJesus":true},{"noteId":95},{"text":"žinoma, vandeniu krikštijo, bet jūs būsite pakrikštyti Šventąja Dvasia.‘","wordsOfJesus":true}]},{"type":"verse","number":18,"content":["Ir tai išgirdę, jie nutilo ir šlovino Dievą, sakydami: „Tad ir nežydams Dievas suteikė",{"noteId":96},{"noteId":97},"atgailą, kad gyventų.“"]},{"type":"verse","number":19,"content":["Tie gi, kurie buvo išsklaidyti į išeiviją dėl",{"noteId":98},"persekiojimo, kilusio dėl Stepono, nukeliavo iki Finikijos ir Kipro ir Antiochijos, skelbdami žodį niekam kitam, o vien tik žydams."]},{"type":"verse","number":21,"content":["Ir",{"noteId":99},"Viešpaties ranka buvo su jais,",{"noteId":100},"ir didelis skaičius įtikėjo ir atsivertė į Viešpatį."]},{"type":"verse","number":23,"content":["Atvykęs ir pamatęs Dievo malonę, jis apsidžiaugė ir ragino juos visus, kad",{"noteId":101},"ryžtinga širdimi jie liktų atsidavę Viešpačiui."]}],"footnotes":[{"noteId":93,"caller":"+","text":"„kitataučiai“ – Arba „nežydai“.","reference":{"chapter":11,"verse":1}},{"noteId":94,"caller":"+","text":"„sakydavo“ – Žr. Apd 1:5.","reference":{"chapter":11,"verse":16}},{"noteId":95,"caller":"+","text":"„žinoma“ – Arba „tiesa“, „gi“.","reference":{"chapter":11,"verse":16}},{"noteId":96,"caller":"+","text":"„atgailą“ – Arba „atgailavimo progą“.","reference":{"chapter":11,"verse":18}},{"noteId":97,"caller":"+","text":"„atgailą, kad gyventų“ – T. „atgailą į gyvenimą“.","reference":{"chapter":11,"verse":18}},{"noteId":98,"caller":"+","text":"„persekiojimo“ – Arba „prispaudimo“.","reference":{"chapter":11,"verse":19}},{"noteId":99,"caller":"+","text":"„Viešpaties ranka buvo su jais“ – Plg. Lk 1:66.","reference":{"chapter":11,"verse":21}},{"noteId":100,"caller":"+","text":"„ir“ – Gal „tai“.","reference":{"chapter":11,"verse":21}},{"noteId":101,"caller":"+","text":"„ryžtinga širdimi“ – Arba „širdies ryžtu“.","reference":{"chapter":11,"verse":23}}]},"thisChapterLink":"/api/lit_tpv/ACT/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/ACT/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/ACT/10.json","previousChapterAudioLinks":{},"numberOfVerses":6}