{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"ACT","translationId":"lit_tpv","name":"Apaštalų darbai","commonName":"Apaštalų darbai","title":"Apaštalų darbų knyga","order":44,"numberOfChapters":26,"sha256":"c9cb34b1ba29986c694593b553b785994b29bbcd05471cec8100f857cdf6d82b","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/ACT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/lit_tpv/ACT/28.json","totalNumberOfVerses":227},"chapter":{"number":5,"content":[{"type":"heading","content":["Atpildas už melagingą elgesį"]},{"type":"verse","number":1,"content":["Bet tam tikras žmogus, vardu Ananijas, su savo žmona Sapfyra pardavė nuosavybę"]},{"type":"verse","number":17,"content":["Tada, pakilo vyriausiasis kunigas, taip pat visi kiti su juo (tai yra sadukiejų sekta), ir jie pasidarė pilni",{"noteId":77},"pavydaus uolumo"]},{"type":"verse","number":24,"content":["O kai vyriausiasis kunigas, šventyklos sargybos vadas ir aukštieji kunigai išgirdo šituos žodžius, jie dėl jų sumišo, nežinodami,",{"noteId":78},"kas iš to išeis."]},{"type":"verse","number":29,"content":["Tada Petras ir kiti apaštalai atsakydami tarė: „Reikia labiau klausyti Dievo negu žmonių."]},{"type":"verse","number":30,"content":["Mūsų",{"noteId":79},"tėvų Dievas prikėlė Jėzų, kurį jūs nužudėte,",{"noteId":80},"pakabindami ant medžio."]},{"type":"verse","number":31,"content":["Jį Dievas išaukštino savo dešine ranka, kad būtų Kunigaikštis ir Išgelbėtojas, kad suteiktų Izraeliui atgailą ir nuodėmių atleidimą."]},{"type":"verse","number":36,"content":["Nes pirmiau šių dienų",{"noteId":81},"prieš kiek laiko iškilo Teudas, kuris pasisakė esąs kažkas nepaprastas. Prie jo prisijungė tam tikras vyrų skaičius – apie keturis šimtus. Jis buvo nužudytas, ir visi, kurie",{"noteId":82},"tikėjo juo, išsisklaidė ir nuėjo niekais."]},{"type":"verse","number":41,"content":["Taigi jie, žinoma, išėjo iš tarybos akivaizdos džiaugdamiesi, kad buvo palaikyti vertais dėl",{"noteId":83},"jo vardo patirti",{"noteId":84},"paniekinimą."]}],"footnotes":[{"noteId":77,"caller":"+","text":"„pavydaus uolumo“ – Žr. Apd 13:45.","reference":{"chapter":5,"verse":17}},{"noteId":78,"caller":"+","text":"„kas iš to išeis“ – T. „kuo tai pasidarytų“.","reference":{"chapter":5,"verse":24}},{"noteId":79,"caller":"+","text":"„tėvų“ – Arba „protėvių“.","reference":{"chapter":5,"verse":30}},{"noteId":80,"caller":"+","text":"„pakabindami“ – Arba „pakabinę“.","reference":{"chapter":5,"verse":30}},{"noteId":81,"caller":"+","text":"„prieš kiek laiko“ – T. „pirmiau šių dienų“.","reference":{"chapter":5,"verse":36}},{"noteId":82,"caller":"+","text":"„tikėjo juo“ – Arba „klausė jo“, „buvo jo įtikinti“.","reference":{"chapter":5,"verse":36}},{"noteId":83,"caller":"+","text":"„jo“ – T. y., Jėzaus.","reference":{"chapter":5,"verse":41}},{"noteId":84,"caller":"+","text":"„paniekinimą“ – Arba „negarbę“.","reference":{"chapter":5,"verse":41}}]},"thisChapterLink":"/api/lit_tpv/ACT/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/ACT/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/ACT/4.json","previousChapterAudioLinks":{},"numberOfVerses":8}