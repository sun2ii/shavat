{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"DEU","translationId":"lit_tpv","name":"Pakartotas Įstatymas","commonName":"Pakartotas Įstatymas","title":"Pakartoto Įstatymo knyga","order":5,"numberOfChapters":24,"sha256":"d6a956c9382c123054a8df71a8d8423c111d39791f3783d381cad8514adfd498","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/DEU/1.json","lastChapterNumber":33,"lastChapterApiLink":"/api/lit_tpv/DEU/33.json","totalNumberOfVerses":59},"chapter":{"number":32,"content":[{"type":"verse","number":4,"content":["Jis yra Uola. Tobulas jo darbas, nes visi jo keliai teisingi – ištikimas Dievas ir be",{"noteId":39},"neteisybės, jis teisingas ir tiesus."]},{"type":"verse","number":10,"content":["Jis rado jį dykumos šalyje kaukiančioje tyrlaukio dykynėje,",{"noteId":40},"apglėbė jį,",{"noteId":41},"mokė jį, saugojo jį kaip savo akies vyzdį."]},{"type":"verse","number":21,"content":["Jie sukėlė mano pavydą tuo, kas ne Dievas; jie pykdė mane savo",{"noteId":42},"tuštybėmis;",{"noteId":43},"tai aš sukelsiu jų pavydą per netautą, aš pykdysiu juos per kvailą tautą."]},{"type":"verse","number":29,"content":["O, kad jie būtų išmintingi, kad suprastų tai, kad jie",{"noteId":44},"įžvelgtų,",{"noteId":45},"koks bus jų galas!"]},{"type":"verse","number":35,"content":["Atkeršijimas ir atmokėjimas yra mano – jų koja paslys tinkamu laiku, nes jų didžiulės nelaimės diena yra arti, ir atskuba tai, kas juos ištiks."]}],"footnotes":[{"noteId":39,"caller":"+","text":"„neteisybės“ – Arba „blogio“, „blogadarybės“.","reference":{"chapter":32,"verse":4}},{"noteId":40,"caller":"+","text":"„apglėbė jį“ – Arba „aplinkui vedžiojo jį“.","reference":{"chapter":32,"verse":10}},{"noteId":41,"caller":"+","text":"„mokė jį“ – Arba „rūpinsi juo“.","reference":{"chapter":32,"verse":10}},{"noteId":42,"caller":"+","text":"„tuštybėmis“ t. y. „stabais“.","reference":{"chapter":32,"verse":21}},{"noteId":43,"caller":"+","text":"„tai“ – Arba „ir“.","reference":{"chapter":32,"verse":21}},{"noteId":44,"caller":"+","text":"„įžvelgtų“ – Arba „suvoktų“.","reference":{"chapter":32,"verse":29}},{"noteId":45,"caller":"+","text":"„koks bus jų galas“ – T. „savo galą“.","reference":{"chapter":32,"verse":29}}]},"thisChapterLink":"/api/lit_tpv/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":5}