{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"ECC","translationId":"lit_tpv","name":"Mokytojo","commonName":"Mokytojo","title":"Mokytojo knyga","order":21,"numberOfChapters":10,"sha256":"2a3f158162fac278a5fde8b3655d7d1921fa7d74c26703cb38a6a0c5f4859c08","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/lit_tpv/ECC/12.json","totalNumberOfVerses":84},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"noteId":48},"Elkis apdairiai, kai keli koją į Dievo namus, ir būk labiau pasiruošęs klausytis, negu atnašauti kvailių auką, nes jie nesusivokia, kad daro bloga."]},{"type":"verse","number":2,"content":["Nebūk ūmus savo burna, ir neleisk savo širdžiai skubiai tarti žodžio Dievo akivaizdoje, nes Dievas yra danguje, o tu žemėje. Todėl tavo žodžių tebūna nedaug."]},{"type":"verse","number":3,"content":["Juk sapnas",{"noteId":49},"atsiranda dėl daugybės vargingų darbų, ir kvailio neapgalvotas",{"noteId":50},"pasakymas dėl daugybės žodžių."]},{"type":"verse","number":10,"content":["Kas myli",{"noteId":51},"pinigus, nepasisotins",{"noteId":52},"pinigais, nė mylintis turtingumą – pelnu; tai irgi tuštybė!"]},{"type":"verse","number":16,"content":["O tai irgi yra skaudi blogybė: kaip jis atėjo, lygiai taip nueis,",{"noteId":53},"tad kokia pasiliekanti nauda tam, kuris triūsė vėjais?"]}],"footnotes":[{"noteId":48,"caller":"+","text":"„Elkis apdairiai, kai keli koją“ – Hebraizmas: „Saugok savo žingsnius, kai eini“.","reference":{"chapter":5,"verse":1}},{"noteId":49,"caller":"+","text":"„atsiranda“ – Arba „ateina“.","reference":{"chapter":5,"verse":3}},{"noteId":50,"caller":"+","text":"„pasakymas“ – Hbr. „balsas“, kuris čia rodo į tai, kas pasakytą balsu, t. y. greitą, neapgalvotą dalyką (žr. tolesnį kontekstą).","reference":{"chapter":5,"verse":3}},{"noteId":51,"caller":"+","text":"„pinigus“ – Arba „sidabrą“.","reference":{"chapter":5,"verse":10}},{"noteId":52,"caller":"+","text":"„pinigais“ – Arba „sidabru“.","reference":{"chapter":5,"verse":10}},{"noteId":53,"caller":"+","text":"„tad“ – Arba „ir“.","reference":{"chapter":5,"verse":16}}]},"thisChapterLink":"/api/lit_tpv/ECC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/ECC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/ECC/3.json","previousChapterAudioLinks":{},"numberOfVerses":5}