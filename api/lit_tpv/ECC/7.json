{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"ECC","translationId":"lit_tpv","name":"Mokytojo","commonName":"Mokytojo","title":"Mokytojo knyga","order":21,"numberOfChapters":10,"sha256":"2a3f158162fac278a5fde8b3655d7d1921fa7d74c26703cb38a6a0c5f4859c08","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/lit_tpv/ECC/12.json","totalNumberOfVerses":84},"chapter":{"number":7,"content":[{"type":"verse","number":2,"content":["Geriau eiti į gedulo namus, negu eiti į pokylių namus, nes",{"noteId":54},"toks kiekvieno žmogaus galas, ir gyvas žmogus tai dėsis į širdį."]},{"type":"verse","number":5,"content":["Geriau išgirsti išmintingojo pabarimą, negu klausytis kvailųjų dainos."]},{"type":"verse","number":6,"content":["Nes kaip erškėčių spragsėjimas po puodu, taip kvailio kvatojimasis. O tai irgi tuštybė!"]},{"type":"verse","number":8,"content":["Geresnė",{"noteId":55},"reikalo pabaiga negu jo pradžia, kantri dvasia geresnė negu išpuikusi dvasia."]},{"type":"verse","number":9,"content":["Savo dvasioje nebūk greitas pykti, nes pyktis glūdi kvailių užantyje."]},{"type":"verse","number":13,"content":["Apsvarstyk Dievo darbą: kas gali ištiesinti, ką jis sukreivino?"]},{"type":"verse","number":16,"content":["Neperdėk, laikydamasis normos, ir nepasirodyk pernelyg išmintingas! Kodėl turėtum save pražudyti?"]},{"type":"verse","number":20,"cont