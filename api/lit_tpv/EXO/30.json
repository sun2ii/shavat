{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"EXO","translationId":"lit_tpv","name":"Išėjimo","commonName":"Išėjimo","title":"Išėjimo knyga","order":2,"numberOfChapters":30,"sha256":"1c93e62e006f5f6c51975f3aa2de1082785b8b3930cdd04394b4ceff065f465c","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/lit_tpv/EXO/40.json","totalNumberOfVerses":116},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":["Ir padaryk aukurą smilkalams deginti; padaryk jį iš akacijos medžio."]},{"type":"verse","number":2,"content":["Jo ilgis bus viena uolektis, ir jo plotis bus viena uolektis – jis bus kvadratinis – ir jo aukštis bus dvi uolektys; jo ragai turi būti",{"noteId":47},"iš to paties gabalo."]},{"type":"verse","number":3,"content":["Taip pat aptrauk jį grynu auksu – jo viršų, jo šonus aplinkui ir jo ragus; ir jam aplinkui padaryk aukso atbrailą."]},{"type":"verse","number":11,"content":["Ir VIEŠPATS kalbėjo Mozei, sakydamas:"]},{"type":"verse","number":12,"content":["„Kai surašysite Izraelio vaikus pagal jų skaičių,",{"noteId":48},"tada kiekvienas vyras duos VIEŠPAČIUI išpirką už savo sielą, kai juos skaičiuosi, kad tarp jų nebūtų rykštės, kai juos skaičiuosi."]},{"type":"verse","number":13,"content":["Štai ką duos kiekvienas, kuris",{"noteId":49},"pereis į suskaičiuotuosius: pusę šekelio pagal šventovės šekelį (šekelis yra dvidešimt gerų); pusė šekelio bus",{"noteId":50},"atnaša VIEŠPAČIUI."]},{"type":"verse","number":14,"content":["Kiekvienas, kuris",{"noteId":51},"pereis į suskaičiuotuosius (",{"noteId":52},"dvidešimtmetis ar vyresnis), turi duoti VIEŠPATIES atnašą."]},{"type":"verse","number":15,"content":["Duodant VIEŠPATIES atnašą, kad atliktų atpirkimą už jūsų sielas, turtingasis neturi duoti daugiau, ir vargšas neturi duoti mažiau kaip pusę šekelio."]},{"type":"verse","number":16,"content":["Ir paimk iš Izraelio vaikų atpirkimo pinigus ir paskirk juos susitikimo palapinės tarnavimui. Izraelio vaikams tai bus priminimas VIEŠPATIES akivaizdoje, kad atpirktų jūsų sielas.“"]},{"type":"verse","number":17,"content":["Ir VIEŠPATS kalbėjo Mozei, sakydamas:"]}],"footnotes":[{"noteId":47,"caller":"+","text":"„vientisi“ – T. „iš jo“; arba „vientisi su juo“.","reference":{"chapter":30,"verse":2}},{"noteId":48,"caller":"+","text":"„tada kiekvienas vyras“ – Arba „kiekvienas vyras ir“.","reference":{"chapter":30,"verse":12}},{"noteId":49,"caller":"+","text":"„pereis“ – Arba „pereina“.","reference":{"chapter":30,"verse":13}},{"noteId":50,"caller":"+","text":"„atnaša“ – Arba „auką“, „dovaną“; gal „įnašas“.","reference":{"chapter":30,"verse":13}},{"noteId":51,"caller":"+","text":"„pereis“ – Arba „pereina“.","reference":{"chapter":30,"verse":14}},{"noteId":52,"caller":"+","text":"„dvidešimtmetis ar vyresnis“ – Hbr. „dvidešimties ar daugiau metų sūnus“.","reference":{"chapter":30,"verse":14}}]},"thisChapterLink":"/api/lit_tpv/EXO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/EXO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/EXO/29.json","previousChapterAudioLinks":{},"numberOfVerses":10}