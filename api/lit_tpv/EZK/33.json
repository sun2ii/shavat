rtime dažniai paliekamas žodis „kelias“, kai rodo į elgseną, bet čia klaidintų skaitytoją, tarsi Dievas vaikščiotų nelygu keliu, kai iš tikro rodoma į Jo veiksmus žmonių atžvilgiu.","reference":{"chapter":33,"verse":20}},{"noteId":27,"caller":"+","text":"„elgesį“ t. „kelią“.","reference":{"chapter":33,"verse":20}}]},"thisChapterLink":"/api/lit_tpv/EZK/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/EZK/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/EZK/28.json","previousChapterAudioLinks":{},"numberOfVerses":2}