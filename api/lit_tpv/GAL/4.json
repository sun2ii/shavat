{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"GAL","translationId":"lit_tpv","name":"Galatams","commonName":"Galatams","title":"Laiškas galatams","order":48,"numberOfChapters":6,"sha256":"2a10502e388308b45abf910f426201fbd166487a1196b374fe10b4ba5c264401","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/GAL/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/lit_tpv/GAL/6.json","totalNumberOfVerses":70},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":["Dabar sakau, kad, kol paveldėtojas yra nepilnametis, jis niekuo nesiskiria nuo tarno, nors yra visa ko šeimininkas,"]},{"type":"verse","number":2,"content":["bet yra globėjų ir prievaizdų valdžioje iki tėvo nustatyto laiko."]},{"type":"verse","number":3,"content":["Taip ir mes, kai buvome nepilnamečiai, buvome",{"noteId":33},"laikomi priverstiniam tarnavimui pasaulio pradmenims."]},{"type":"verse","number":4,"content":["Bet, atėjus laiko pilnatvei, Dievas atsiuntė savo Sūnų,",{"noteId":34},"gimusį iš moters,",{"noteId":35},"gimusį įstatymo valdžioje,"]},{"type":"verse","number":5,"content":["kad išpirktų esančius įstatymo valdžioje, kad įgytume įsūnijimą."]},{"type":"verse","number":6,"content":["Ir kadangi esate sūnūs, Dievas atsiuntė į jūsų širdis savo Sūnaus Dvasią, šaukiančią: „Aba, Tėve!"]},{"type":"verse","number":7,"content":["Taigi tu jau nebesi priverstinis tarnas, bet sūnus; o jeigu sūnus, tai ir Dievo paveldėtojas per Kristų."]}],"footnotes":[{"noteId":33,"caller":"+","text":"„laikomi priverstiniam tarnavimui“ – Arba „pavergti“.","reference":{"chapter":4,"verse":3}},{"noteId":34,"caller":"+","text":"„gimusį“ – Arba „pasidarusį“.","reference":{"chapter":4,"verse":4}},{"noteId":35,"caller":"+","text":"„gimusį“ – Arba „pasidarusį“.","reference":{"chapter":4,"verse":4}}]},"thisChapterLink":"/api/lit_tpv/GAL/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/GAL/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/GAL/3.json","previousChapterAudioLinks":{},"numberOfVerses":7}