{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"GEN","translationId":"lit_tpv","name":"Pradžios","commonName":"Pradžios","title":"Pradžios knyga","order":1,"numberOfChapters":32,"sha256":"6d76ffa8401973fe4e9e16ad87de94f8738b54b93c58b49d10de0603f717ac75","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/lit_tpv/GEN/50.json","totalNumberOfVerses":343},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":["Ir VIEŠPATS buvo taręs Abramui: „Eik iš savo šalies ir iš savo giminės ir iš savo tėvo namų į šalį, kurią tau parodysiu."]},{"type":"verse","number":2,"content":["Ir padarysiu iš tavęs didelę tautą ir laiminsiu tave, ir padarysiu didį tavo vardą, ir tu",{"noteId":194},"būsi palaiminimas."]},{"type":"verse","number":3,"content":["Ir",{"noteId":195},"laiminsiu tave laiminančius, bet",{"noteId":196},"prakeiksiu",{"noteId":197},"tave prakeikiantį; ir",{"noteId":198},"tavyje bus",{"noteId":199},"palaimintos visos žemės šeimų grupės.“"]},{"type":"verse","number":4,"content":["Taigi Abramas išvyko, kaip VIEŠPATS jam buvo pasakęs, ir su juo vyko Lotas; ir Abramas buvo septyniasdešimt penkerių metų, kai išvyko iš Harano."]},{"type":"verse","number":5,"content":["Ir Abramas pasiėmė savo žmoną Sarają ir savo brolio sūnų Lotą ir visą jų turtą, kurį jie buvo sukaupę, ir asmenis, kuriuos jie buvo įsigiję Harane. Ir jie išvyko, kad nukeliautų į Kanaano šalį, ir atvyko į Kanaano šalį."]},{"type":"verse","number":6,"content":["Ir Abramas perėjo per tą šalį iki Šechemo vietovės, iki Morės",{"noteId":200},"lygumos. O anuomet kanaaniečiai buvo toje šalyje."]},{"type":"verse","number":7,"content":["Ir VIEŠPATS pasirodė Abramui ir tarė: „Tavo",{"noteId":201},"sėklai aš duosiu šitą šalį.“ Ir jis ten pastatė aukurą VIEŠPAČIUI, kuris jam pasirodė."]},{"type":"verse","number":17,"content":["Ir VIEŠPATS užgavo faraoną ir jo namus didelėmis rykštėmis dėl Sarajos, Abramo žmonos."]}],"footnotes":[{"noteId":194,"caller":"+","text":"„būsi“ – Arba „būk“.","reference":{"chapter":12,"verse":2}},{"noteId":195,"caller":"+","text":"„laiminsiu […]“ – Prd 27:29, Sk 24:9.","reference":{"chapter":12,"verse":3}},{"noteId":196,"caller":"+","text":"„prakeiksiu“ – Arba „įsipareigoju pašalinti nuo palaiminimo“.","reference":{"chapter":12,"verse":3}},{"noteId":197,"caller":"+","text":"„tave prakeikiantį“ – Arba „tą, kuris lengvabūdiškai elgiasi su tavimi“.","reference":{"chapter":12,"verse":3}},{"noteId":198,"caller":"+","text":"„tavyje […]“ – Prd 22:18, 26:4, 28:14; Apd 3:25; Gal 3:8.","reference":{"chapter":12,"verse":3}},{"noteId":199,"caller":"+","text":"„palaimintos visos […] šeimų grupės“ – Arba „palaiminti visi […] klanai“.","reference":{"chapter":12,"verse":3}},{"noteId":200,"caller":"+","text":"„lygumos“ – Gal „ąžuolo“.","reference":{"chapter":12,"verse":6}},{"noteId":201,"caller":"+","text":"„sėklai“ – T. y. „palikuoniui“, „palikuonims“, „ainiui“, „ainijai“.","reference":{"chapter":12,"verse":7}}]},"thisChapterLink":"/api/lit_tpv/GEN/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/GEN/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/GEN/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}