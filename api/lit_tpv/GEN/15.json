{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"GEN","translationId":"lit_tpv","name":"Pradžios","commonName":"Pradžios","title":"Pradžios knyga","order":1,"numberOfChapters":32,"sha256":"6d76ffa8401973fe4e9e16ad87de94f8738b54b93c58b49d10de0603f717ac75","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/lit_tpv/GEN/50.json","totalNumberOfVerses":343},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":["Po šių dalykų VIEŠPATIES žodis atėjo Abramui regėjime, sakydamas: „Nebijok, Abramai! Aš esu tavo skydas, tavo labai apstus atlygis.“"]},{"type":"verse","number":5,"content":["Ir, išvedęs jį laukan, tarė: „Malonėk įbesti akis į dangų ir suskaičiuoti žvaigždes, jei gali jas suskaičiuoti!“ Ir jis jam tarė: „Tokia bus tavo",{"noteId":211},"sėkla.“"]},{"type":"verse","number":6,"content":["Ir jis",{"noteId":212},"pasitikėjo VIEŠPAČIU, o jis įskaitė tai jam kaip teisumą."]},{"type":"verse","number":13,"content":["Ir jis tarė Abramui: „Žinok užtikrintai, kad keturis šimtus metų tavo",{"noteId":213},"palikuonija bus ateivis ne nesavoje šalyje (jie gi",{"noteId":214},"svetimiesiems tarnaus, o",{"noteId":215},"anie juos kamuos)."]},{"type":"verse","number":14,"content":["Bet ir tautai, kuriai jie tarnaus, aš įvykdysiu teisingumą, o po to jie išvyks su dideliu turtu."]},{"type":"verse","number":15,"content":["O tu nueisi pas savo",{"noteId":216},"tėvus ramybėje; tu būsi palaidotas žiloje senatvėje."]},{"type":"verse","number":16,"content":["Bet ketvirtoje kartoje jie čia sugrįš, nes amoritų blogybės saikas dar nepilnas.“"]},{"type":"verse","number":18,"content":["Tą pačią dieną VIEŠPATS tvirtino su Abramu sandorą, sakydamas: „Tavo sėklai aš daviau šitą šalį nuo Egipto upės iki didžiosios upės, – Eufrato upės –"]}],"footnotes":[{"noteId":211,"caller":"+","text":"„sėkla“ – Arba „ainis“ (palikuonis), „ainija“ (palikuonys).","reference":{"chapter":15,"verse":5}},{"noteId":212,"caller":"+","text":"„pasitikėjo“ – Hbr. k. gramatika duoda suprasti, kad Abramas buvo ir anksčiau tikėjęs VIEŠPAČIU, kaip tvirtina Laiškas hebrajams 11:8 (Thomas D. Ross, 2018).","reference":{"chapter":15,"verse":6}},{"noteId":213,"caller":"+","text":"„palikuonija“ – T. „sėkla“.","reference":{"chapter":15,"verse":13}},{"noteId":214,"caller":"+","text":"„svetimiesiems“ – T. „jiems“.","reference":{"chapter":15,"verse":13}},{"noteId":215,"caller":"+","text":"„anie“ – T. „jie“.","reference":{"chapter":15,"verse":13}},{"noteId":216,"caller":"+","text":"„tėvus“ – T. y „protėvius“.","reference":{"chapter":15,"verse":15}}]},"thisChapterLink":"/api/lit_tpv/GEN/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/GEN/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/GEN/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}