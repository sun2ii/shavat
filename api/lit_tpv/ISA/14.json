{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"ISA","translationId":"lit_tpv","name":"Izaijo","commonName":"Izaijo","title":"Izaijo knyga","order":23,"numberOfChapters":50,"sha256":"f250b449978adede4d23d0511f9665ef14f4f8d9bf231701eab477df833f2ba1","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lit_tpv/ISA/66.json","totalNumberOfVerses":162},"chapter":{"number":14,"content":[{"type":"verse","number":11,"content":["Nustumta žemyn į",{"noteId":26},"kapą tavo puikybė, tavo styginių instrumentų skambesys. Po tavimi lervos yra ištiestos tarsi guolis, ir kirmėlės tave apkloja."]},{"type":"verse","number":12,"content":["Kaip tu iškritai iš dangaus, o",{"noteId":27},"Liuciferi,",{"noteId":28},"aušros sūnau! Tu esi nukirstas žemėn, kuris nusilpninai tautas!"]},{"type":"verse","number":13,"content":["Nes tu sakei savo širdyje: „Aš pakilsiu į dangų, aš iškelsiu savo sostą viršum",{"noteId":29},"Dievo žvaigždžių, ir aš atsisėsiu ant",{"noteId":30},"susirinkimo kalno",{"noteId":31},"Šiaurės tolimiausiose vietose,"]},{"type":"verse","number":14,"content":["aš pakilsiu virš debesų aukštybių, aš prilygsiu Aukščiausiajam!"]},{"type":"verse","number":15,"content":["Tačiau tu būsi nustumtas į",{"noteId":32},"pragarą, į tolimiausias duobės vietas."]},{"type":"verse","number":16,"content":["Tie, kurie tave matys, spoksos į tave ir apžiūrinės tave, klausdami: „Ar tai tas vyras, kuris sudrebino žemę, kuris sukrėtė karalystes,"]},{"type":"verse","number":17,"content":["kuris pasaulį padarė kaip dykumą ir sugriovė jo miestus, kuris savo belaisvių nepaleido namo?"]}],"footnotes":[{"noteId":26,"caller":"+","text":"„kapą“ – T. „Šeolą“. Arba „Pragarą“, „Mirusiųjų buveinę“.","reference":{"chapter":14,"verse":11}},{"noteId":27,"caller":"+","text":"„Liuciferi“ – Arba „Šviečiantysis“, „Šviesnešy“.","reference":{"chapter":14,"verse":12}},{"noteId":28,"caller":"+","text":"„aušros sūnau“ – Plg. Apr 22:16, kur Mesijas, Viešpats Jėzus Kristus, yra vadinamas „šviesi ir aušrinė žvaigždė“. Šėtonas geidžia užimti Jo vietą.","reference":{"chapter":14,"verse":12}},{"noteId":29,"caller":"+","text":"„Dievo žvaigždžių“ – T. y. Dievo angelai (Job 38:7).","reference":{"chapter":14,"verse":13}},{"noteId":30,"caller":"+","text":"„susirinkimo kalno“ – T. y. vieta, kur teismas vyksta; plg. Ps 82:1.","reference":{"chapter":14,"verse":13}},{"noteId":31,"caller":"+","text":"„Šiaurės“ – Poetiškai tai rodo į Dangų, į Dievo buveinę.","reference":{"chapter":14,"verse":13}},{"noteId":32,"caller":"+","text":"„pragarą“ – Hbr. „šeolą“.","reference":{"chapter":14,"verse":15}}]},"thisChapterLink":"/api/lit_tpv/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/ISA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":7}