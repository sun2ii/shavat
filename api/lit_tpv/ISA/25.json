{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"ISA","translationId":"lit_tpv","name":"Izaijo","commonName":"Izaijo","title":"Izaijo knyga","order":23,"numberOfChapters":50,"sha256":"f250b449978adede4d23d0511f9665ef14f4f8d9bf231701eab477df833f2ba1","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lit_tpv/ISA/66.json","totalNumberOfVerses":162},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":["O VIEŠPATIE, tu esi mano Dievas! Aš aukštinsiu tave, aš girsiu tavo vardą, nes tu padarei nuostabius dalykus, seniai sugalvotus patikimus ir",{"noteId":34},"neabejojamus planus."]},{"type":"verse","number":4,"content":["Nes tu buvai",{"noteId":35},"stiprybė",{"noteId":36},"bejėgiui, stiprybė",{"noteId":37},"stokojančiam jo varge, priebėga nuo audros, ūksmė nuo kaitros. Mat",{"noteId":38},"bauginančių galingųjų siautulys – kaip audra, atsimušianti į sieną."]},{"type":"verse","number":8,"content":["Jis pergalėje praris mirtį ir Viešpats JEHOVA nušluostys ašaras nuo visų veidų ir savo tautos gėdą jis pašalins nuo visos žemės, nes VIEŠPATS tai pasakė."]},{"type":"verse","number":9,"content":["Tądien jie sakys: „Štai mūsų Dievas, kurio laukėme, ir jis mus išgelbsti! Tai VIEŠPATS, kurio laukėme! Džiūgaukime ir linksminkimės dėl jo išgelbėjimo!"]}],"footnotes":[{"noteId":34,"caller":"+","text":"„neabejojamus“ – Arba „tiesą atitinkančius“.","reference":{"chapter":25,"verse":1}},{"noteId":35,"caller":"+","text":"„stiprybė“ – Arba „tvirtovė“ (2 k.).","reference":{"chapter":25,"verse":4}},{"noteId":36,"caller":"+","text":"„bejėgiui“ – T. y., neturinčiam nė turto, nė įtakos.","reference":{"chapter":25,"verse":4}},{"noteId":37,"caller":"+","text":"„stokojančiam“ – T. y., tam, kuriam reikia materialinės pagalbos arba apsaugos.","reference":{"chapter":25,"verse":4}},{"noteId":38,"caller":"+","text":"„bauginančių galingųjų“ – Arba „nuožmiųjų“, „aršiųjų“, „smurtininkų“.","reference":{"chapter":25,"verse":4}}]},"thisChapterLink":"/api/lit_tpv/ISA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/ISA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/ISA/17.json","previousChapterAudioLinks":{},"numberOfVerses":4}