{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"ISA","translationId":"lit_tpv","name":"Izaijo","commonName":"Izaijo","title":"Izaijo knyga","order":23,"numberOfChapters":50,"sha256":"f250b449978adede4d23d0511f9665ef14f4f8d9bf231701eab477df833f2ba1","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lit_tpv/ISA/66.json","totalNumberOfVerses":162},"chapter":{"number":26,"content":[{"type":"verse","number":3,"content":["Tu išlaikysi",{"noteId":39},"tobuloje ramybėje tą, kurio",{"noteId":40},"mąstymas",{"noteId":41},"nesvyruoja nuo tavęs, nes jis pasitiki tavimi."]},{"type":"verse","number":4,"content":["Pasitikėkite VIEŠPAČIU per amžius, nes",{"noteId":42},"VIEŠPATYJE JEHOVOJE yra amžina",{"noteId":43},"uola."]},{"type":"verse","number":8,"content":["Be to, mes laukėme tavęs, o VIEŠPATIE, tavo teismo nuosprendžių kelyje;",{"noteId":44},"siela žavisi tavo vardu ir tavo atminimu."]}],"footnotes":[{"noteId":39,"caller":"+","text":"„tobuloje ramybėje“ – Hbr. „ramybėje, ramybėje“.","reference":{"chapter":26,"verse":3}},{"noteId":40,"caller":"+","text":"„mąstymas“ – Arba „planas“, „sumanymas“; gal „tikslas“.","reference":{"chapter":26,"verse":3}},{"noteId":41,"caller":"+","text":"„nesvyruoja“ – T. „yra tvirtas“.","reference":{"chapter":26,"verse":3}},{"noteId":42,"caller":"+","text":"„VIEŠPATYJE JEHOVOJE“ – Arba „JEHOVOJE, būtent JEHOVOJE“; žr. Iz 12:2.","reference":{"chapter":26,"verse":4}},{"noteId":43,"caller":"+","text":"„uola“ t. y. „stiprybė“, „nepajudinamumas“.","reference":{"chapter":26,"verse":4}},{"noteId":44,"caller":"+","text":"„siela žavisi“ – hbr. „sielos žavesys (arba „ilgesys“) yra į“.","reference":{"chapter":26,"verse":8}}]},"thisChapterLink":"/api/lit_tpv/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":3}