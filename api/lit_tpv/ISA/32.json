{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"ISA","translationId":"lit_tpv","name":"Izaijo","commonName":"Izaijo","title":"Izaijo knyga","order":23,"numberOfChapters":50,"sha256":"f250b449978adede4d23d0511f9665ef14f4f8d9bf231701eab477df833f2ba1","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lit_tpv/ISA/66.json","totalNumberOfVerses":162},"chapter":{"number":32,"content":[{"type":"verse","number":2,"content":["Ir",{"noteId":51},"žmogus bus lyg prieglobstis nuo vėjo ir lyg slėptuvė nuo audros, lyg vandens upeliai sausoje dykvietėje, kaip didžiulės uolos šešėlis saulės nudegintame krašte."]},{"type":"verse","number":7,"content":["Ir niekšo priemonės blogos; jis sumano nedorų planų, kad pražudytų",{"noteId":52},"varguolius melagingais žodžiais, net kai",{"noteId":53},"vargšas kalba teisybę."]},{"type":"verse","number":17,"content":["Teisumo poveikis bus taika, o teisumo padarinys – ramumas ir saugumas amžinai."]},{"type":"verse","number":18,"content":["Tada mano tauta gyvens ramioje buveinėje, saugiuose",{"noteId":54},"namuose, atvangiose atilsio vietose,"]}],"footnotes":[{"noteId":51,"caller":"+","text":"„žmogus“ – Hbr. אִישׁ (iš); arba „vyras“. Remiantis tuo, kas parašyta Iz 32:1, čia nurodoma į karalių (Mesiją) ir į Jo tarnus, kurie valdo kartu su Juo.","reference":{"chapter":32,"verse":2}},{"noteId":52,"caller":"+","text":"„varguolius“ – Arba „prispaustuosius“, „nuolankiuosius“, „romiuosius“, „nužemintuosius“.","reference":{"chapter":32,"verse":7}},{"noteId":53,"caller":"+","text":"„vargšas kalba teisinga“ t. „vargšo kalbėjimas yra teisingas“.","reference":{"chapter":32,"verse":7}},{"noteId":54,"caller":"+","text":"„namuose“ – Arba „buveinėse“.","reference":{"chapter":32,"verse":18}}]},"thisChapterLink":"/api/lit_tpv/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/ISA/30.json","previousChapterAudioLinks":{},"numberOfVerses":4}