{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"ISA","translationId":"lit_tpv","name":"Izaijo","commonName":"Izaijo","title":"Izaijo knyga","order":23,"numberOfChapters":50,"sha256":"f250b449978adede4d23d0511f9665ef14f4f8d9bf231701eab477df833f2ba1","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lit_tpv/ISA/66.json","totalNumberOfVerses":162},"chapter":{"number":34,"content":[{"type":"verse","number":16,"content":["Suieškokite VIEŠPATIES",{"noteId":55},"knygoje ir skaitykite:",{"noteId":56},"nei vieno iš jų netrūks, nei vienas nepasiges savo",{"noteId":57},"patelės; nes",{"noteId":58},"tai įsakė mano burna, ir jo dvasia jas surinko."]}],"footnotes":[{"noteId":55,"caller":"+","text":"„knygoje“ – Arba „ritinyje“.","reference":{"chapter":34,"verse":16}},{"noteId":56,"caller":"+","text":"„nei vieno […] nei vienas“, „juos“, „savo“ – Hbr. kalboje moteriškos giminės žodžiai, todėl gali būti „nei vienos […] nei viena“, „jas“, „savo“; gali rodyti vien tik į Iz 34:15b eilutėje išvardintus paukštus, kurių visi pavadinimai hbr. yra mot. gim., arba gali rodyti į visus gyvūnus, išvardintus Iz 34:14b-15, nes ir jų hbr. pavadinimai yra vien tik mot. gim.","reference":{"chapter":34,"verse":16}},{"noteId":57,"caller":"+","text":"„patelės“ – Arba „antrosios pusės“.","reference":{"chapter":34,"verse":16}},{"noteId":58,"caller":"+","text":"„tai įsakė mano burna“ – kadangi hbr. tekstas gali reikšti „mano burna tai įsakė“ arba „Jis tai įsakė per mano burną“, parinktas tokia liet. teksto žodžių tvarka, kuri leidžia suprasti „burna“ kaip arba vardininko arba įnagininko linksnio.","reference":{"chapter":34,"verse":16}}]},"thisChapterLink":"/api/lit_tpv/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":1}