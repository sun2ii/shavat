{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"ISA","translationId":"lit_tpv","name":"Izaijo","commonName":"Izaijo","title":"Izaijo knyga","order":23,"numberOfChapters":50,"sha256":"f250b449978adede4d23d0511f9665ef14f4f8d9bf231701eab477df833f2ba1","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lit_tpv/ISA/66.json","totalNumberOfVerses":162},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":["Bet dabar taip sako VIEŠPATS, kuris sukūrė tave, o Jokūbai, tai yra tas, kuris supavidalino tave, o Izraeli: „Nebijok, nes aš išpirkau tave,",{"noteId":78},"pašaukiau tave vardu, tu esi mano!"]},{"type":"verse","number":2,"content":["Kai tu eisi per vandenis, aš būsiu su tavim, ir kai eisi per upes, jos tavęs nepaskandins. Kai žengsi per ugnį, nesudegsi, ir liepsna",{"noteId":79},"tavęs neapdegins."]},{"type":"verse","number":10,"content":["Jūs esate mano liudytojai, – sako VIEŠPATS, – ir mano tarnas, kurį išsirinkau, kad pažintumėte mane ir manimi tikėtumėte ir suprastumėte, jog aš esu",{"noteId":80},"tas. Pirma manęs nebuvo supavidalintas joks dievas ir po manęs jokio nebus."]},{"type":"verse","number":11,"content":["Aš, aš esu VIEŠPATS, ir be manęs nėra išgelbėtojo."]},{"type":"verse","number":25,"content":["Aš, aš esu tas, kuris išdildau tavo nusižengimus dėl savęs, ir tavo nuodėmių neatminsiu."]}],"footnotes":[{"noteId":78,"caller":"+","text":"„pašaukiau tave vardu“ – T. „tavo vardu pašaukiau“.","reference":{"chapter":43,"verse":1}},{"noteId":79,"caller":"+","text":"„tavęs neapdegins“ – Hbr. „tavyje nedegs“.","reference":{"chapter":43,"verse":2}},{"noteId":80,"caller":"+","text":"„tas“ – T. y. tikras Dievas, kuris iš anksto praneša apie būsimus dalykus.","reference":{"chapter":43,"verse":10}}]},"thisChapterLink":"/api/lit_tpv/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}