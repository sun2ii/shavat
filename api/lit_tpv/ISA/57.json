{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"ISA","translationId":"lit_tpv","name":"Izaijo","commonName":"Izaijo","title":"Izaijo knyga","order":23,"numberOfChapters":50,"sha256":"f250b449978adede4d23d0511f9665ef14f4f8d9bf231701eab477df833f2ba1","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lit_tpv/ISA/66.json","totalNumberOfVerses":162},"chapter":{"number":57,"content":[{"type":"verse","number":15,"content":["Nes taip sako Aukštasis ir",{"noteId":126},"Prakilnusis,",{"noteId":127},"turintis nuolatinę buveinę amžinybėje, kurio vardas yra Šventasis: „Aš",{"noteId":128},"turiu nuolatinę buveinę aukštoje ir šventoje vietoje, taip pat pas tą, kuris yra palaužtos ir nusižeminusios dvasios, kad",{"noteId":129},"atgaivinčiau nusižeminusiųjų dvasią ir atgaivinčiau palaužtųjų širdį."]},{"type":"verse","number":18,"content":["Aš mačiau jo kelius, bet aš išgydysiu jį ir vedžiosiu jį, taip pat grąžinsiu paguodos jam ir tiems, kurie raudojo dėl jo."]},{"type":"verse","number":19,"content":["Aš kuriu lūpų vaisių: Ramybė, ramybė esančiam toli ir esančiam arti! – sako VIEŠPATS, – ir aš jį išgydysiu."]},{"type":"verse","number":20,"content":["Bet nedorėliai yra kaip sudrumsta jūra, kai ji negali nurimti, kurios vandenys išmeta dumblą ir purvą."]},{"type":"verse","number":21,"content":["Nedorėliui nėra ramybės“, „sako mano Dievas."]}],"footnotes":[{"noteId":126,"caller":"+","text":"„Prakilnusis“ – Arba „Išaukštintasis“.","reference":{"chapter":57,"verse":15}},{"noteId":127,"caller":"+","text":"„turintis nuolatinę buveinę“ – Arba „gyvenantis“.","reference":{"chapter":57,"verse":15}},{"noteId":128,"caller":"+","text":"„turiu nuolatinę buveinę“ – Arba „gyvenu“.","reference":{"chapter":57,"verse":15}},{"noteId":129,"caller":"+","text":"„atgaivinčiau […] dvasią ir atgaivinčiau […] širdį“ – Arba „naujai suteikčiau gyvybę / gyvybingumą […] dvasiai ir naujai suteikčiau gyvybę / gyvybingumą […] širdžiai“.","reference":{"chapter":57,"verse":15}}]},"thisChapterLink":"/api/lit_tpv/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":5}