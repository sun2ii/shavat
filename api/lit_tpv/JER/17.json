{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"JER","translationId":"lit_tpv","name":"Jeremijo","commonName":"Jeremijo","title":"Jeremijo knyga","order":24,"numberOfChapters":20,"sha256":"6597556696084e8bda2ec77de019784d28552e2bce766413a6c0f134b73b550e","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/JER/1.json","lastChapterNumber":45,"lastChapterApiLink":"/api/lit_tpv/JER/45.json","totalNumberOfVerses":38},"chapter":{"number":17,"content":[{"type":"verse","number":5,"content":["Taip sako VIEŠPATS: „Prakeiktas žmogus, kuris pasitiki",{"noteId":11},"žmogumi ir laiko mirtingą kūną savo",{"noteId":12},"stiprybe, ir kurio širdis nukrypsta nuo VIEŠPATIES."]},{"type":"verse","number":7,"content":["Palaimintas žmogus, kuris pasitiki VIEŠPAČIU, būtent VIEŠPATS yra jo užtikrintumas!"]},{"type":"verse","number":9,"content":["Širdis už viską klastingesnė ir",{"noteId":13},"neišgydomai nedora. Kas gali ją perprasti?"]},{"type":"verse","number":14,"content":["Gydyk mane, VIEŠPATIE, ir būsiu išgydytas; išgelbėk mane, ir būsiu išgelbėtas, nes tu esi mano gyrius."]},{"type":"verse","number":23,"content":["Tačiau jie",{"noteId":14},"nepakluso ir nepalenkė savo ausies, bet sukietino savo sprandą, kad neklausytų ir nepriimtų",{"noteId":15},"pataisančio ugdymo."]}],"footnotes":[{"noteId":11,"caller":"+","text":"„žmogumi“ – Gal „žmonėmis“, jei hbr. vns. yra kuopinis.","reference":{"chapter":17,"verse":5}},{"noteId":12,"caller":"+","text":"„stiprybe“ – T. „ranka“.","reference":{"chapter":17,"verse":5}},{"noteId":13,"caller":"+","text":"„neišgydomai nedora“ – Hbr. žodis אָנַשׁ (anaš) vartojamas II Sam 12:15; Job 34:6; Iz 17:11; Jer 15:18, 17:9, 17:16, 30:12, 30:15; Mch 1:9. Dėl naujos širdies, žr. Eze 18:31, 36:26","reference":{"chapter":17,"verse":9}},{"noteId":14,"caller":"+","text":"„nepakluso“ – Arba „neklaũsė“; tas pats hbr. žodis išverstas toliau šioje eilutėje „neklausytų“.","reference":{"chapter":17,"verse":23}},{"noteId":15,"caller":"+","text":"„pataisančio ugdymo“ – Arba „drausmės“.","reference":{"chapter":17,"verse":23}}]},"thisChapterLink":"/api/lit_tpv/JER/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/JER/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/JER/15.json","previousChapterAudioLinks":{},"numberOfVerses":5}