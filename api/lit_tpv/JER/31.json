{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"JER","translationId":"lit_tpv","name":"Jeremijo","commonName":"Jeremijo","title":"Jeremijo knyga","order":24,"numberOfChapters":20,"sha256":"6597556696084e8bda2ec77de019784d28552e2bce766413a6c0f134b73b550e","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/JER/1.json","lastChapterNumber":45,"lastChapterApiLink":"/api/lit_tpv/JER/45.json","totalNumberOfVerses":38},"chapter":{"number":31,"content":[{"type":"verse","number":3,"content":["Nuo",{"noteId":21},"seno man pasirodė VIEŠPATS, sakydamas: „Aš amžina meile tave mylėjau, todėl",{"noteId":22},"mielaširdiškumu aš pritraukiau tave."]},{"type":"verse","number":15,"content":["Taip sako VIEŠPATS:",{"noteId":23},"„Triukšmas pasigirdo Ramoje, rauda, kartus verksmas. Rachelė verkdama savo vaikų nesileidžia guodžiama dėl savo",{"noteId":24},"vaikų, nes jų nebėra.“"]},{"type":"verse","number":34,"content":["Ir jie nebemokys kiekvienas žmogus savo",{"noteId":25},"artimo ir kiekvienas žmogus savo brolio, sakydami: „Pažinkite VIEŠPATĮ!“, nes jie visi mane pažins, nuo jų mažiausiojo net iki jų didžiausiojo, – sako VIEŠPATS, – nes aš atleisiu jų",{"noteId":26},"kaltes ir jų",{"noteId":27},"nuodėmių nebeatminsiu.“"]}],"footnotes":[{"noteId":21,"caller":"+","text":"„seno“ – Hbr. „toli“.","reference":{"chapter":31,"verse":3}},{"noteId":22,"caller":"+","text":"„mielaširdiškumu“ – Arba „geranoriškumu“, „gailestingumu“.","reference":{"chapter":31,"verse":3}},{"noteId":23,"caller":"+","text":"„Triukšmas“ – Arba „Garsas“, „Balsas“. Žr. Mt 2:18.","reference":{"chapter":31,"verse":15}},{"noteId":24,"caller":"+","text":"„vaikų“ – Arba „sūnų“.","reference":{"chapter":31,"verse":15}},{"noteId":25,"caller":"+","text":"„artimo“ – Arba „bičiulio“.","reference":{"chapter":31,"verse":34}},{"noteId":26,"caller":"+","text":"„kaltes“ – Arba „blogadarybes“, „neteisybes“, „nedorybes“; hbr. kuopinis vns.","reference":{"chapter":31,"verse":34}},{"noteId":27,"caller":"+","text":"„nuodėmių“ – Hbr. kuopinis vns.","reference":{"chapter":31,"verse":34}}]},"thisChapterLink":"/api/lit_tpv/JER/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/JER/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/JER/30.json","previousChapterAudioLinks":{},"numberOfVerses":3}