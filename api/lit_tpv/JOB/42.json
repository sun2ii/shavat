{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"JOB","translationId":"lit_tpv","name":"Jobo","commonName":"Jobo","title":"Jobo knyga","order":18,"numberOfChapters":34,"sha256":"e89b73c32fea24bfec9583a09dd8e817f4a64fd43de34c54a6fe3b1d531d6a1a","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lit_tpv/JOB/42.json","totalNumberOfVerses":72},"chapter":{"number":42,"content":[{"type":"verse","number":1,"content":["Tada Jobas atsiliepdamas VIEŠPAČIUI tarė:"]},{"type":"verse","number":2,"content":["„Žinau, kad tu pajėgi padaryti visa ir kad",{"noteId":36},"joks tavo sumanymas nebus sukliudytas."]},{"type":"verse","number":6,"content":["Todėl aš",{"noteId":37},"bjauriuosi savimi ir",{"noteId":38},"atgailauju dulkėse ir pelenuose."]},{"type":"verse","number":17,"content":["Ir Jobas mirė senas ir pasisotinęs dienomis."]}],"footnotes":[{"noteId":36,"caller":"+","text":"„joks tavo sumanymas nebus sukliudytas“ – Arba „joks sumanymas nebus tau sukliudomas“, „nuo tavęs jokia mintis (joks sumanymas) nebus nepasiekiama“.","reference":{"chapter":42,"verse":2}},{"noteId":37,"caller":"+","text":"„bjauriuosi savimi“ – Arba „šlykščiuosi savimi“. Arba „atmetu savo žodžius“, t. y. jų atsižadu.","reference":{"chapter":42,"verse":6}},{"noteId":38,"caller":"+","text":"„atgailauju“ – Arba „apsigalvojęs gailiuosi“; hbr. žodis נָחַם (nacham, „giliai atsidusti“) turi įvairias reikšmes; svarbiausia – kontekstas.","reference":{"chapter":42,"verse":6}}]},"thisChapterLink":"/api/lit_tpv/JOB/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":4}