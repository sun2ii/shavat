{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"LAM","translationId":"lit_tpv","name":"Raudos","commonName":"Raudos","title":"Raudų knyga","order":25,"numberOfChapters":3,"sha256":"cb6ed615ddc188d13837300763db7675d7bb0efea55340f7f0e09bddf61cebab","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/LAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/lit_tpv/LAM/3.json","totalNumberOfVerses":11},"chapter":{"number":3,"content":[{"type":"verse","number":14,"content":["Aš buvau pajuoka visai savo tautai, jų pašaipos daina visą dieną."]},{"type":"verse","number":22,"content":["Dėl VIEŠPATIES",{"noteId":1},"gailestingumo gausybės mums neatėjo galas, nes jo",{"noteId":2},"apstus meilingumas nesibaigia –"]},{"type":"verse","number":23,"content":[{"noteId":3},"atsinaujina kas rytą. Didelė tavo ištikimybė!"]},{"type":"verse","number":24,"content":["VIEŠPATS yra mano dalis, „sako mano siela, „todėl sudedu viltis į Jį."]},{"type":"verse","number":25,"content":["VIEŠPATS yra geras tiems, kurie jo laukia, jis geras tai sielai, kuri jo ieško."]},{"type":"verse","number":26,"content":["Gera ir sudėti viltis į VIEŠPATIES išgelbėjimą ir",{"noteId":4},"tyliai to laukti."]},{"type":"verse","number":33,"content":["nes jis",{"noteId":5},"ne iš širdies prispaudžia ir nuliūdina žmones."]},{"type":"verse","number":40,"content":["Ištirkime ir išmėginkime savo",{"noteId":6},"kelius ir gręžkimės į VIEŠPATĮ!"]},{"type":"verse","number":51,"content":["Mano akis skaudina mano",{"noteId":7},"širdį dėl visų mano miesto dukterų."]}],"footnotes":[{"noteId":1,"caller":"+","text":"„gailestingumo gausybės“ – Hbr. dgs. „gailestingumų“.","reference":{"chapter":3,"verse":22}},{"noteId":2,"caller":"+","text":"„apstus meilingumas“ – Hbr. dgs.; arba „gailesčiai“, „širdingas prielankumas“, „meilingumai“.","reference":{"chapter":3,"verse":22}},{"noteId":3,"caller":"+","text":"„atsinaujina kas rytą“ – T. „nauji rytais“.","reference":{"chapter":3,"verse":23}},{"noteId":4,"caller":"+","text":"„tyliai“ – Arba „ramiai“, „be judesio“.","reference":{"chapter":3,"verse":26}},{"noteId":5,"caller":"+","text":"„ne iš širdies …“ – T. y. Dievui nekelia malonumo tai, kad reikia prispausti ir nuliūdinti žmones, bet Jis supranta, kad tai būtina sąlyga mūsų ugdymui. Plg. Job 38-42 skyriuose; Ps 119:67, 71; Jok 5:11.","reference":{"chapter":3,"verse":33}},{"noteId":6,"caller":"+","text":"„kelius“ – T. y. „elgseną“.","reference":{"chapter":3,"verse":40}},{"noteId":7,"caller":"+","text":"„širdį“ – Heb. „sielą“.","reference":{"chapter":3,"verse":51}}]},"thisChapterLink":"/api/lit_tpv/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}