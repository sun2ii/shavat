{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"LUK","translationId":"lit_tpv","name":"Luko","commonName":"Luko","title":"Evangelija pagal Luką","order":42,"numberOfChapters":24,"sha256":"7d7d828a306e9210c131f2577e6ce3a8720e74e17189cb11ff5a27454fb02510","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/lit_tpv/LUK/24.json","totalNumberOfVerses":419},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":["Ir šabo dieną jam įėjus į vieno fariziejų valdytojų namus valgyti duonos, taip įvyko, kad jie kruopščiai stebėjo jį."]},{"type":"verse","number":2,"content":["Ir štai ten priešais jį buvo vienas žmogus, sergantis vandenlige."]},{"type":"verse","number":3,"content":["Ir Jėzus atsakydamas kalbėjo įstatymininkams ir fariziejams, sakydamas: „Ar teisėta gydyti šabo dieną?“"]},{"type":"verse","number":4,"content":["Bet jie tylėjo. Tada jis ėmė, išgydė jį ir paleido."]},{"type":"verse","number":5,"content":["Ir atsakydamas jiems jis tarė: „Kuris iš jūsų turės asilą arba jautį, įkritusį į duobę, ir tuojau jo neištrauks per šabo dieną?“"]},{"type":"verse","number":6,"content":["Ir jie",{"noteId":163},"nesugebėjo jam į tai",{"noteId":164},"atkirsti."]},{"type":"verse","number":7,"content":["Ir jis pakviestiesiems pasakė palyginimą, atkreipdamas dėmesį į tai, kaip jie rinkosi garbingiausias vietas, sakydamas jiems:"]},{"type":"verse","number":8,"content":[{"text":"„Kai esi kieno nors pakviestas į vestuves, nesisėsk","wordsOfJesus":true},{"noteId":165},{"text":"garbingiausioje vietoje, kad kartais nebūtų jo pakviestas už tave labiau","wordsOfJesus":true},{"noteId":166},{"text":"pripažinamas žmogus","wordsOfJesus":true}]}],"footnotes":[{"noteId":163,"caller":"+","text":"„nesugebėjo“ – Arba „neįstengė“.","reference":{"chapter":14,"verse":6}},{"noteId":164,"caller":"+","text":"„atkirsti“ – Arba „priešingai atsakyti“. Žr. tą patį gr. žodį Rom 9:20.","reference":{"chapter":14,"verse":6}},{"noteId":165,"caller":"+","text":"„garbingiausioje“ – T. „aukščiausioje“.","reference":{"chapter":14,"verse":8}},{"noteId":166,"caller":"+","text":"„pripažinamas“ – Arba „branginamas“.","reference":{"chapter":14,"verse":8}}]},"thisChapterLink":"/api/lit_tpv/LUK/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/LUK/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/LUK/13.json","previousChapterAudioLinks":{},"numberOfVerses":8}