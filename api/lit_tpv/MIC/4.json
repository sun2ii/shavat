{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"MIC","translationId":"lit_tpv","name":"Michėjo","commonName":"Michėjo","title":"Michėjo knyga","order":33,"numberOfChapters":6,"sha256":"a5904b0bcab0f0d985fffa63a53e85fe97b5086766b05ba8f91c52b3a3b1c583","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/lit_tpv/MIC/7.json","totalNumberOfVerses":12},"chapter":{"number":4,"content":[{"type":"verse","number":5,"content":["Nors visos tautos – kiekvienas žmogus –",{"noteId":1},"vaikščioja savo dievo vardu, tačiau mes vaikščiosime VIEŠPATIES, savo Dievo, vardu per amžių amžius."]},{"type":"verse","number":8,"content":["O tu,",{"noteId":2},"kaimenės bokšte,",{"noteId":3},"Siono dukters",{"noteId":4},"tvirtove, pas tave ji ateis, būtent pirmoji valdžia",{"noteId":5},"įsitvirtins – Jeruzalės dukters karalystė!"]}],"footnotes":[{"noteId":1,"caller":"+","text":"„vaikščioja“ – T. y. elgiasi pasitikėdamas savo „dievu“ ir pagal to „dievo“ normas.","reference":{"chapter":4,"verse":5}},{"noteId":2,"caller":"+","text":"„kaimenės bokšte“ – Hbr. „Migdal-ederas“.","reference":{"chapter":4,"verse":8}},{"noteId":3,"caller":"+","text":"„Siono dukters“ yra Dovydo miestas, t. y. Jeruzalė arba karališkoji jos dalis.","reference":{"chapter":4,"verse":8}},{"noteId":4,"caller":"+","text":"„tvirtove“ – Arba „aukšta vieta“, „kalva“.","reference":{"chapter":4,"verse":8}},{"noteId":5,"caller":"+","text":"„įsitvirtins“ – Arba „užeis“, „ateis“, bet kitas hbr. žodis anksčiau šioje eilutėje yra išverstas „ateis“.","reference":{"chapter":4,"verse":8}}]},"thisChapterLink":"/api/lit_tpv/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":2}