{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"MRK","translationId":"lit_tpv","name":"Morkaus","commonName":"Morkaus","title":"Evangelija pagal Morkų","order":41,"numberOfChapters":16,"sha256":"d9de83f1091d15fb642a7224c67637638ff058082675664e45f64a66db1e4b21","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/lit_tpv/MRK/16.json","totalNumberOfVerses":273},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Ir po kelių dienų jis vėl įėjo į Kapernaumą, ir buvo girdėta, kad jis yra namuose."]},{"type":"verse","number":2,"content":["Ir tuojau susirinko tiek daug, kad nebebuvo vietos, netgi prie durų. Ir jis skelbė jiems žodį."]},{"type":"verse","number":3,"content":["Ir kai kurie atėjo pas jį atnešdami vieną paralyžiuotą žmogų, kurį nešė",{"noteId":13},"keturiese."]},{"type":"verse","number":5,"content":["O",{"noteId":14},"matydamas jų tikėjimą, Jėzus tarė paralyžiuotajam: „Sūnau, tavo nuodėmės tau atleistos."]},{"type":"verse","number":10,"content":["Bet kad žinotumėte, jog Žmogaus Sūnus turi",{"noteId":15},"valdymo galią nuodėmėms atleisti žemėje „jis tarė sergančiam paralyžiumi –"]},{"type":"verse","number":11,"content":["sakau tau, kelkis, ir pasiimk savo gultą ir eik į savo namus."]},{"type":"verse","number":17,"content":["Tai išgirdęs Jėzus sako jiems: „Ne sveikiesiems reikia gydytojo, bet ligoniams; aš atėjau ne teisiųjų šaukti į atgailą, bet nusidėjėlių.“"]},{"type":"verse","number":22,"content":["Ir niekas nepila",{"noteId":16},"naujo vyno į senus vynmaišius. Antraip naujas vynas suplėšia vynmaišius, ir vynas išsipila, ir vynmaišiai bus sugadinti. Priešingai, naujas vynas piltinas į naujus vynmaišius."]},{"type":"verse","number":27,"content":["Ir jis tarė jiems: „Šabas atsirado žmogui, o ne žmogus šabui;"]},{"type":"verse","number":28,"content":["taigi Žmogaus Sūnus yra ir šabo Viešpats.“"]}],"footnotes":[{"noteId":13,"caller":"+","text":"„keturiese“ – Gr. „keturi“.","reference":{"chapter":2,"verse":3}},{"noteId":14,"caller":"+","text":"„matydamas“ – Arba „suvokdamas“.","reference":{"chapter":2,"verse":5}},{"noteId":15,"caller":"+","text":"„valdymo galią“ – Arba „teisę“, „valdžią“, „įgaliojimą“.","reference":{"chapter":2,"verse":10}},{"noteId":16,"caller":"+","text":"„naujo vyno“ (2 k.) – Arba „šviežių vynuogių sulčių (sunkos)“.","reference":{"chapter":2,"verse":22}}]},"thisChapterLink":"/api/lit_tpv/MRK/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/MRK/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/MRK/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}