{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PRO","translationId":"lit_tpv","name":"Patarlių","commonName":"Patarlių","title":"Patarlių knyga","order":20,"numberOfChapters":31,"sha256":"c56b9864ee09664d2cc093e272ed79e36aeff415187ebb905e9b939c62645e26","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lit_tpv/PRO/31.json","totalNumberOfVerses":485},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"noteId":233},"Apgaulingos svarstyklės – bjaurastis VIEŠPAČIUI, bet",{"noteId":234},"tikslus svarstis",{"noteId":235},"jam patinka."]},{"type":"verse","number":2,"content":["Atėjus išdidumui, ateina ir gėda, bet su nuolankiaisiais yra išmintis."]},{"type":"verse","number":14,"content":["Kai nėra išmintingo kreipimo, tauta žlunga, bet saugumas",{"noteId":236},"ten, kur daug patarėjų."]},{"type":"verse","number":18,"content":["Nedorėlis daro",{"noteId":237},"apgaulingą darbą, bet kas sėja teisumą, tam bus",{"noteId":238},"užtikrintas užmokestis."]},{"type":"verse","number":21,"content":[{"noteId":239},"Ranka į ranką",{"noteId":240},"blogas žmogus neliks nenubaustas, bet teisųjų",{"noteId":241},"sėkla bus išvaduota."]},{"type":"verse","number":24,"content":[{"noteId":242},"Vienas plačiai išskirsto, bet vis dėlto turtėja, o kitas pasilaiko tai, ką turėtų atiduoti, bet tik nuskursta."]},{"type":"verse","number":25,"content":[{"noteId":243},"Dosni siela",{"noteId":244},"bus praturtintas, ir kas pagirdo, pats bus pagirdytas."]},{"type":"verse","number":29,"content":["Kas",{"noteId":245},"vargina savo",{"noteId":246},"šeimyną, tas paveldės vėją, ir toks kvailys tampa išmintingos širdies žmogaus tarnu."]},{"type":"verse","number":30,"content":["Teisiojo vaisius yra gyvybės medis, ir kas laimi sielų, yra išmintingas."]}],"footnotes":[{"noteId":233,"caller":"+","text":"„Apgaulingos“ – Arba „Melagingos“.","reference":{"chapter":11,"verse":1}},{"noteId":234,"caller":"+","text":"„tikslus svarstis“ – T. „tobulas akmuo“.","reference":{"chapter":11,"verse":1}},{"noteId":235,"caller":"+","text":"„jam patinka“ – Hbr. „jo pasigėrėjimas“.","reference":{"chapter":11,"verse":1}},{"noteId":236,"caller":"+","text":"„ten, kur daug patarėjų“ – Arba „būna per daugelį patarėjų“.","reference":{"chapter":11,"verse":14}},{"noteId":237,"caller":"+","text":"„apgaulingą“ – Arba „melagingą“.","reference":{"chapter":11,"verse":18}},{"noteId":238,"caller":"+","text":"„užtikrintas“ – Arba „tvirtas“, „tikras“.","reference":{"chapter":11,"verse":18}},{"noteId":239,"caller":"+","text":"„Ranka į ranką“ – hbr. idiomos reikšmė gali būti „Net esant ranka į ranką patvirtintam sutarimui“ arba „neišvengiamai“ (todėl, kad patvirtinta).","reference":{"chapter":11,"verse":21}},{"noteId":240,"caller":"+","text":"„nedorėlis“ – „blogas žmogus“.","reference":{"chapter":11,"verse":21}},{"noteId":241,"caller":"+","text":"„sėkla“ t. y., „palikuonys“.","reference":{"chapter":11,"verse":21}},{"noteId":242,"caller":"+","text":"„Vienas …“ t. „Būna plačiai išskirstantis, bet vis dėlto turtėjantis, taip pat pasilaikantis tai, ką turėtų atiduoti, bet tik nuskurstantis.“","reference":{"chapter":11,"verse":24}},{"noteId":243,"caller":"+","text":"„Dosni siela“ – Arba „Siela, kuri dosnumu palaimina,“.","reference":{"chapter":11,"verse":25}},{"noteId":244,"caller":"+","text":"„bus praturtintas“ t. „bus nutukinamas“. Šis hebraizmas rodo į materialią gerovę. Plg. Įst 32:15.","reference":{"chapter":11,"verse":25}},{"noteId":245,"caller":"+","text":"„vargina“ – Arba „kamuoja“.","reference":{"chapter":11,"verse":29}},{"noteId":246,"caller":"+","text":"„šeimyną“ – Arba „namus“, „namiškius“, „namų ūkį“.","reference":{"chapter":11,"verse":29}}]},"thisChapterLink":"/api/lit_tpv/PRO/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PRO/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PRO/10.json","previousChapterAudioLinks":{},"numberOfVerses":9}