{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PRO","translationId":"lit_tpv","name":"Patarlių","commonName":"Patarlių","title":"Patarlių knyga","order":20,"numberOfChapters":31,"sha256":"c56b9864ee09664d2cc093e272ed79e36aeff415187ebb905e9b939c62645e26","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lit_tpv/PRO/31.json","totalNumberOfVerses":485},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":["Išmintingas sūnus klauso savo tėvo",{"noteId":258},"drausminančio pamokymo, bet šaipūnas neklauso barimo."]},{"type":"verse","number":2,"content":["Iš savo burnos vaisiaus žmogus valgys tai, kas gera, bet",{"noteId":259},"klastūnų siela valgys smurtą."]},{"type":"verse","number":3,"content":["Kas",{"noteId":260},"sulaiko savo burną, tas apsaugo savo gyvybę, bet kas plačiai atveria savo lūpas, tam bus pražūtis."]},{"type":"verse","number":9,"content":["Teisiųjų šviesa džiūgauja, bet nedorėlių žibintas bus užgęsintas."]},{"type":"verse","number":10,"content":["Tik per išdidumą kyla ginčas, bet išmintis yra su tais, kurie priima gerą patarimą."]},{"type":"verse","number":12,"content":["Atidėta viltis susargdina širdį, o įgyvendintas troškimas yra gyvybės medis."]},{"type":"verse","number":14,"content":["Išmintingojo įstatymas –",{"noteId":261},"gyvybės šaltinis, kad pavyktų išvengti mirties žabangų."]},{"type":"verse","number":20,"content":["Kas vaikščioja su išmintingais, bus išmintingas, bet kas draugauja su kvailais,",{"noteId":262},"sužlugs."]},{"type":"verse","number":24,"content":["Kas gailisi savo rykštelės, nekenčia savo sūnaus, bet kas jį myli, drausmina jį",{"noteId":263},"anksti."]},{"type":"verse","number":25,"content":["Teisusis valgo iki savo sielos soties, bet nedorėlių pilvas stokos."]}],"footnotes":[{"noteId":258,"caller":"+","text":"„drausminančio pamokymo“ – Arba „pataisančio auklėjimo“, „drausmės“.","reference":{"chapter":13,"verse":1}},{"noteId":259,"caller":"+","text":"„klastūnų“ – Arba „klastingųjų“, „neištikimųjų“ „išdavikų“.","reference":{"chapter":13,"verse":2}},{"noteId":260,"caller":"+","text":"„sulaiko“, „apsaugo“ – Abudu žodžiai išversti iš to pačio hbr. žodžio, kuris įvairiai verčiamas; plg. Pat 21:23.","reference":{"chapter":13,"verse":3}},{"noteId":261,"caller":"+","text":"„gyvybės“ – Arba „gyvenimo“.","reference":{"chapter":13,"verse":14}},{"noteId":262,"caller":"+","text":"„sužlugs“ – Arba „sulūš“.","reference":{"chapter":13,"verse":20}},{"noteId":263,"caller":"+","text":"„anksti“ – Reikšmė yra arba kol ne vėlu (laiku) arba ankstyvoje vaikystėje.","reference":{"chapter":13,"verse":24}}]},"thisChapterLink":"/api/lit_tpv/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":10}