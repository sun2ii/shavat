{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PRO","translationId":"lit_tpv","name":"Patarlių","commonName":"Patarlių","title":"Patarlių knyga","order":20,"numberOfChapters":31,"sha256":"c56b9864ee09664d2cc093e272ed79e36aeff415187ebb905e9b939c62645e26","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lit_tpv/PRO/31.json","totalNumberOfVerses":485},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":["Vynas yra išjuokėjas, stiprus gėrimas yra triukšmingas siautėjas; ir kiekvienas, kuris juo apsigauna, yra neišmintingas."]},{"type":"verse","number":2,"content":["Karaliaus sukelta baimė yra kaip",{"noteId":351},"liūto riaumojimas; kas",{"noteId":352},"jį supykdo, nusideda prieš savo gyvybę."]},{"type":"verse","number":3,"content":["Tai yra garbė žmogui",{"noteId":353},"vengti vaido, bet kiekvienas kvailys ginčijasi."]},{"type":"verse","number":6,"content":["Dauguma žmonių skelbia savo pačių",{"noteId":354},"gerumą, bet kas gali rasti patikimą žmogų?!"]},{"type":"verse","number":7,"content":["Teisusis",{"noteId":355},"vaikšto savo",{"noteId":356},"vientisumo dorybėje; po jo yra labai palaiminti jo vaikai."]},{"type":"verse","number":17,"content":["Žmogui gardi",{"noteId":357},"apgavystės duona, bet vėliau jo burna taps pilna žvyro."]},{"type":"verse","number":20,"content":["Kas keikia savo tėvą ar savo motiną, to žibintas bus užgesintas juodžiausioje tamsoje."]},{"type":"verse","number":22,"content":["Nesakyk: „Atlyginsiu blogu už bloga.“ Lauk VIEŠPATIES, ir jis tave išgelbės."]},{"type":"verse","number":27,"content":["Žmogaus dvasia yra VIEŠPATIES žibintas, tiriantis",{"noteId":358},"žmogaus asmenybės gelmes."]},{"type":"verse","number":30,"content":["Sumušimo randai nuvalo nuo blogio, ir kirčiai nuvalo",{"noteId":359},"žmogaus asmenybės gelmes."]}],"footnotes":[{"noteId":351,"caller":"+","text":"„liūto“ – Arba „jauno liūto“.","reference":{"chapter":20,"verse":2}},{"noteId":352,"caller":"+","text":"„jį supykdo“ – Hbr. „peržengia“, t. y. peržengia karaliaus nustatytas ribas.","reference":{"chapter":20,"verse":2}},{"noteId":353,"caller":"+","text":"„vengti“ – Arba „pasilikti atokiau nuo“.","reference":{"chapter":20,"verse":3}},{"noteId":354,"caller":"+","text":"„gerumą“ – gal „ištikimumą“, „geranoriškumą“, t. y. draugiškumą, rūpinimąsi kitais žmonėmis.","reference":{"chapter":20,"verse":6}},{"noteId":355,"caller":"+","text":"„vaikšto“ – T. y. pasižymi tokia gyvensena.","reference":{"chapter":20,"verse":7}},{"noteId":356,"caller":"+","text":"„vientisumo dorybėje“ – Hbr. prieveiksmiška sandara „vientisai“, „dorai“, „be nukrypimų“, t. y. visa širdimi – ne puse širdies – vykdo Dievo valią.","reference":{"chapter":20,"verse":7}},{"noteId":357,"caller":"+","text":"„apgavystės duona“ – Plg. Pat 4:17, „nedorybės duoną“.","reference":{"chapter":20,"verse":17}},{"noteId":358,"caller":"+","text":"„žmogaus asmenybės gelmes“ – T. „pilvo vidinius kambarius“ (hbr. idioma). Gal „žmogaus psichinių savybių visumą (būdą)“.","reference":{"chapter":20,"verse":27}},{"noteId":359,"caller":"+","text":"„žmogaus asmenybės gelmes“ – T. „pilvo vidinius kambarius“ (hbr. idioma). Gal „žmogaus psichinių savybių visumą (būdą)“.","reference":{"chapter":20,"verse":30}}]},"thisChapterLink":"/api/lit_tpv/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":10}