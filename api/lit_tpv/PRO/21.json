{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PRO","translationId":"lit_tpv","name":"Patarlių","commonName":"Patarlių","title":"Patarlių knyga","order":20,"numberOfChapters":31,"sha256":"c56b9864ee09664d2cc093e272ed79e36aeff415187ebb905e9b939c62645e26","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lit_tpv/PRO/31.json","totalNumberOfVerses":485},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":["Karaliaus širdis – tai vandens upeliai VIEŠPATIES rankoje: jis nukreipia ją, kur tik nori."]},{"type":"verse","number":2,"content":["Kiekvienas žmogaus kelias yra teisingas jo paties akyse, bet VIEŠPATS",{"noteId":360},"pasveria širdis."]},{"type":"verse","number":15,"content":["Teisingumo vykdymas – teisiojo džiaugsmas, bet blogadarių žlugimas."]},{"type":"verse","number":20,"content":["Išmintingo žmogaus buveinėje yra branginamo lobio ir aliejaus, bet kvailas žmogus tai",{"noteId":361},"išeikvoja."]},{"type":"verse","number":23,"content":["Kas",{"noteId":362},"sulaiko savo burną ir savo liežuvį, apsaugo savo sielą nuo",{"noteId":363},"bėdų."]},{"type":"verse","number":24,"content":["Kas pasinaudoja išdidžia rūstybe, to vardas – išdidus ir išpuikęs išjuokėjas."]},{"type":"verse","number":25,"content":["Tinginio troškimas jį nužudo, nes jo rankos atsisako dirbti."]},{"type":"verse","number":26,"content":["Jis godžiai geidžia visą dieną, bet teisusis duoda ir nešykšti."]},{"type":"verse","number":29,"content":["Nedorėlis",{"noteId":364},"rodo kietą veidą, bet",{"noteId":365},"doras žmogus",{"noteId":366},"nustato savo",{"noteId":367},"keliui tvirtą pagrindą."]},{"type":"verse","number":30,"content":["Jokia išmintis, joks supratimas ir joks patarimas",{"noteId":368},"negali atsispirti VIEŠPAČIUI."]}],"footnotes":[{"noteId":360,"caller":"+","text":"„pasveria“ t. y., vertina, ištiria.","reference":{"chapter":21,"verse":2}},{"noteId":361,"caller":"+","text":"„išeikvoja“ – T. „suryja“.","reference":{"chapter":21,"verse":20}},{"noteId":362,"caller":"+","text":"„sulaiko“, „apsaugo“ – Abudu žodžiai išversti iš to pačio hbr. žodžio, kuris įvairiai verčiamas; plg. Pat 13:3.","reference":{"chapter":21,"verse":23}},{"noteId":363,"caller":"+","text":"„bėdų“ – Arba „sielvarto“, „vargų“ (hbr. žodis yra dgs.).","reference":{"chapter":21,"verse":23}},{"noteId":364,"caller":"+","text":"„rodo kietą veidą“ – T. „kietina savo veidą“. Plg. Pat 7:13.","reference":{"chapter":21,"verse":29}},{"noteId":365,"caller":"+","text":"„doras žmogus“ – T. „tiesusis“.","reference":{"chapter":21,"verse":29}},{"noteId":366,"caller":"+","text":"„nustato savo keliui tvirtą pagrindą“ – T. „sutvirtina savo kelią“. Hbr. kalbos teksto paraštėje (qere): „apsvarsto savo kelią“.","reference":{"chapter":21,"verse":29}},{"noteId":367,"caller":"+","text":"„keliui“ – T. y. „elgsenai“, „gyvensenai“.","reference":{"chapter":21,"verse":29}},{"noteId":368,"caller":"+","text":"„negali atsispirti“ – Arba „negali prilygti“.","reference":{"chapter":21,"verse":30}}]},"thisChapterLink":"/api/lit_tpv/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":10}