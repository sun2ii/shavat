{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PRO","translationId":"lit_tpv","name":"Patarlių","commonName":"Patarlių","title":"Patarlių knyga","order":20,"numberOfChapters":31,"sha256":"c56b9864ee09664d2cc093e272ed79e36aeff415187ebb905e9b939c62645e26","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lit_tpv/PRO/31.json","totalNumberOfVerses":485},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":["Šitos irgi yra Saliamono patarlės, kuriuos perrašė Judo karaliaus Chezekijo vyrai."]},{"type":"verse","number":11,"content":["Kaip aukso obuoliai",{"noteId":420},"sidabro puošmenose, taip",{"noteId":421},"tinkamai pasakytas žodis."]},{"type":"verse","number":12,"content":["Kaip auksinis žiedas ir gryno aukso papuošalas, taip išmintingas",{"noteId":422},"pabarėjas",{"noteId":423},"paklusniai ausiai."]},{"type":"verse","number":14,"content":["Kaip debesys ir vėjas be lietaus yra tas, kuris giriasi",{"noteId":424},"nebūta dovana."]},{"type":"verse","number":19,"content":["Pasitikėjimas neištikimu žmogumi bėdos metu yra kaip sugedęs dantis ir",{"noteId":425},"raiša koja."]},{"type":"verse","number":28,"content":["Kaip sugriautas miestas be sienų yra žmogus, kuris nesuvaldo savo dvasios."]}],"footnotes":[{"noteId":420,"caller":"+","text":"„sidabro puošmenose“ – gal „sidabro aptaisuose“, „sidabro atvaizduose“, „sidabro rėmuose“, „sidabriniuose filigraniškuose kūriniuose“.","reference":{"chapter":25,"verse":11}},{"noteId":421,"caller":"+","text":"„vykusiai“ – Arba „laiku“, „vykusiai“.","reference":{"chapter":25,"verse":11}},{"noteId":422,"caller":"+","text":"„pabarėjas“ – Arba „sudraudėjas“.","reference":{"chapter":25,"verse":12}},{"noteId":423,"caller":"+","text":"„paklusniai“ – Arba „atidžiai klausančiai“.","reference":{"chapter":25,"verse":12}},{"noteId":424,"caller":"+","text":"„nebūta dovana“ – T. y. „dovana, kurios neduoda“, t. y. giriasi, kad duos dovaną, bet neištesi pažado; t. – apgavystės dovana.","reference":{"chapter":25,"verse":14}},{"noteId":425,"caller":"+","text":"„raiša“ – Arba „sverdėjanti“, „išnirusi“.","reference":{"chapter":25,"verse":19}}]},"thisChapterLink":"/api/lit_tpv/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}