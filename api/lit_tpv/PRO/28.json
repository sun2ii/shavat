{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PRO","translationId":"lit_tpv","name":"Patarlių","commonName":"Patarlių","title":"Patarlių knyga","order":20,"numberOfChapters":31,"sha256":"c56b9864ee09664d2cc093e272ed79e36aeff415187ebb905e9b939c62645e26","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lit_tpv/PRO/31.json","totalNumberOfVerses":485},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":["Nedorėliai bėga niekam nesivejant, bet teisieji",{"noteId":437},"yra drąsūs kaip liūtas."]},{"type":"verse","number":4,"content":["Kurie palieka įstatymą, giria",{"noteId":438},"nedorėlius, bet kurie laikosi įstatymo, priešinasi jiems."]},{"type":"verse","number":5,"content":["Blogi žmonės nesupranta, ką reiškia teisingumas, bet tie, kurie ieško VIEŠPATIES, viską supranta."]},{"type":"verse","number":9,"content":["Kas nukreipia savo ausį, kad nesiklausytų įstatymo, net jo malda yra bjaurastis."]},{"type":"verse","number":13,"content":["Kas slepia savo nuodėmes, tam nesiseka, bet kas",{"noteId":439},"jas išpažįsta ir palieka, tas susilaukia gailestingumo."]},{"type":"verse","number":20,"content":["Ištikimas žmogus turės daug palaiminimų, bet kas skuba praturtėti, tas neliks nenubaustas."]},{"type":"verse","number":24,"content":["Kas apiplėšia savo tėvą ar savo motiną ir sako: „Nėra",{"noteId":440},"nusižengimo!“, – tas yra niokotojo",{"noteId":441},"draugas."]},{"type":"verse","number":25,"content":["Kas yra išdidžios",{"noteId":442},"širdies, sukelia vaidus; bet, kas pasitiki VIEŠPAČIU, bus",{"noteId":443},"praturtintas."]},{"type":"verse","number":26,"content":["Kas pasitiki savo širdimi, yra kvailys, bet kas išmintingai",{"noteId":444},"elgiasi, tas bus išvaduotas."]}],"footnotes":[{"noteId":437,"caller":"+","text":"„yra drąsūs“ – Arba „elgiasi tvirtai“, t. y., yra tikri, kad viskas baigsis gerai.","reference":{"chapter":28,"verse":1}},{"noteId":438,"caller":"+","text":"„nedorėlius“ – Hbr. kuopinis vns.","reference":{"chapter":28,"verse":4}},{"noteId":439,"caller":"+","text":"„jas išpažįsta ir palieka“ – Arba „jas išpažįsta ir jų atsisako (išsižada, atsižada)“; žodžiai „atsisakyti“, „išsižadėti“, ir „atsižadėti“ tinka tiktai, jeigu jais pareiškiama žodžiais tai, kas daroma veiksmais.","reference":{"chapter":28,"verse":13}},{"noteId":440,"caller":"+","text":"„nusižengimo“ – Arba „maištavimo prieš įstatymą“.","reference":{"chapter":28,"verse":24}},{"noteId":441,"caller":"+","text":"„draugas“ – Arba „sėbras“.","reference":{"chapter":28,"verse":24}},{"noteId":442,"caller":"+","text":"„širdies“ – Arba „sielos“.","reference":{"chapter":28,"verse":25}},{"noteId":443,"caller":"+","text":"„praturtintas“ – Arba „nutukintas“, „nupenėtas“.","reference":{"chapter":28,"verse":25}},{"noteId":444,"caller":"+","text":"„elgiasi“ – T. „vaikščioja“.","reference":{"chapter":28,"verse":26}}]},"thisChapterLink":"/api/lit_tpv/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PRO/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}