{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PRO","translationId":"lit_tpv","name":"Patarlių","commonName":"Patarlių","title":"Patarlių knyga","order":20,"numberOfChapters":31,"sha256":"c56b9864ee09664d2cc093e272ed79e36aeff415187ebb905e9b939c62645e26","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lit_tpv/PRO/31.json","totalNumberOfVerses":485},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"noteId":445},"Dažnai peikiamas žmogus, kuris užkietina savo sprandą, bus staiga",{"noteId":446},"nukirstas – ir neišgydomai."]},{"type":"verse","number":2,"content":["Teisiesiems",{"noteId":447},"įsigalint, tauta džiaugiasi, bet nedorėliui valdant, tauta",{"noteId":448},"dejuoja."]},{"type":"verse","number":3,"content":["Kas myli išmintį, džiugina savo tėvą, bet kas bičiulauja su paleistuvėmis, eikvoja savo turtą."]},{"type":"verse","number":4,"content":["Karalius teisingumu įtvirtina",{"noteId":449},"šalį, bet",{"noteId":450},"kas ima kyšius, ją sugriauna."]},{"type":"verse","number":5,"content":["Žmogus, kuris pataikauja savo artimui, ištiesia tinklą",{"noteId":451},"jo kojoms."]},{"type":"verse","number":15,"content":["Rykštelė ir pabarimas teikia išminties, bet",{"noteId":452},"vaikas, paliktas sau, daro gėdą savo motinai."]},{"type":"verse","number":18,"content":["Kur nėra",{"noteId":453},"Dievo duoto apreiškimo,",{"noteId":454},"tauta",{"noteId":455},"sulaukėja, bet kas laikosi įstatymo, tas palaimintas."]},{"type":"verse","number":21,"content":["Kas lepina savo tarną nuo mažens, tam jis galiausiai taps sūnumi."]},{"type":"verse","number":22,"content":["Piktas žmogus sukelia nesantaiką ir karštakošis",{"noteId":456},"pridaro daug nusižengimų."]},{"type":"verse","number":23,"content":["Žmogaus išdidumas jį nužemins, bet",{"noteId":457},"kas nuolankios dvasios, palaikys pagarbą."]},{"type":"verse","number":25,"content":["Žmonių baimė",{"noteId":458},"spendžia žabangus, bet kas pasitiki VIEŠPAČIU, bus",{"noteId":459},"saugus."]}],"footnotes":[{"noteId":445,"caller":"+","text":"„Dažnai peikiamas žmogus“ – T. „Papeikimų žmogus“.","reference":{"chapter":29,"verse":1}},{"noteId":446,"caller":"+","text":"„nukirstas“ – Arba „sudaužytas“, „galutiniai palaužtas“.","reference":{"chapter":29,"verse":1}},{"noteId":447,"caller":"+","text":"„įsigalint“ – Arba „daugėjant“.","reference":{"chapter":29,"verse":2}},{"noteId":448,"caller":"+","text":"„dejuoja“ – Arba „vaitoja“.","reference":{"chapter":29,"verse":2}},{"noteId":449,"caller":"+","text":"„šalį“ – Arba „kraštą“.","reference":{"chapter":29,"verse":4}},{"noteId":450,"caller":"+","text":"„kas ima kyšius“ t. „atnašų (atnašavimų) žmogus“, „dovanų žmogus“, „kyšių žmogus“.","reference":{"chapter":29,"verse":4}},{"noteId":451,"caller":"+","text":"„jo“ – gal „savo“.","reference":{"chapter":29,"verse":5}},{"noteId":452,"caller":"+","text":"„vaikas, paliktas sau“ – T. „išsiųstas“, „paleistas“; arba „nesuvaržytas“, „kuriam leidžiama nesilaikyti nustatytų ribų“.","reference":{"chapter":29,"verse":15}},{"noteId":453,"caller":"+","text":"„Dievo duoto apreiškimo“ – Arba „pranašiško regėjimo“.","reference":{"chapter":29,"verse":18}},{"noteId":454,"caller":"+","text":"„tauta“ – Arba „žmonių grupė“.","reference":{"chapter":29,"verse":18}},{"noteId":455,"caller":"+","text":"„sulaukėja“ – Arba „atsisako ribų“, „nesiduoda suvaldomi“.","reference":{"chapter":29,"verse":18}},{"noteId":456,"caller":"+","text":"„pridaro“ – Arba „turi“, „sukelia“; žr. paralelizmą su pirma eilutės dalimi.","reference":{"chapter":29,"verse":22}},{"noteId":457,"caller":"+","text":"„kas nuolankios dvasios, palaikys pagarbą“ – Arba „pagarba palaikys tą, kuris nuolankios dvasios“.","reference":{"chapter":29,"verse":23}},{"noteId":458,"caller":"+","text":"„spendžia“ – T. „duoda“.","reference":{"chapter":29,"verse":25}},{"noteId":459,"caller":"+","text":"„saugus“ – Hbr. „bus pakeltas aukštai“, būtent į saugią, nepasiekiamą vietą.","reference":{"chapter":29,"verse":25}}]},"thisChapterLink":"/api/lit_tpv/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}