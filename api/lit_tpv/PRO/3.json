{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PRO","translationId":"lit_tpv","name":"Patarlių","commonName":"Patarlių","title":"Patarlių knyga","order":20,"numberOfChapters":31,"sha256":"c56b9864ee09664d2cc093e272ed79e36aeff415187ebb905e9b939c62645e26","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lit_tpv/PRO/31.json","totalNumberOfVerses":485},"chapter":{"number":3,"content":[{"type":"heading","content":["Trečioji kalba sūnui"]},{"type":"verse","number":1,"content":["Mano sūnau, nepamiršk mano įstatymo, bet tavo širdis tesaugo mano įsakymus,"]},{"type":"verse","number":2,"content":["nes jie tau pridės",{"noteId":64},"ilgai besitęsiančias dienas ir",{"noteId":65},"gyvybingų metų ir",{"noteId":66},"ramybės."]},{"type":"verse","number":3,"content":["Gailestingumas ir tiesa tenepalieka tavęs; užsirišk juos sau ant kaklo, įsirašyk juos savo širdies plokštėje;"]},{"type":"verse","number":4,"content":[{"noteId":67},"to padarinys toks:",{"noteId":68},"įgysi",{"noteId":69},"maloningumą ir",{"noteId":70},"puikią įžvalgą, kurie matysis Dievo ir žmonių akyse."]},{"type":"verse","number":5,"content":["Visa savo širdimi pasitikėk VIEŠPAČIU, o savo supratimu",{"noteId":71},"nesiremk."]},{"type":"verse","number":6,"content":["Visuose savo keliuose",{"noteId":72},"pripažink jį, ir jis",{"noteId":73},"nukreips tavo takus."]},{"type":"verse","number":7,"content":["Nebūk išmintingas savo akyse: bijok VIEŠPATIES ir venk blogio."]},{"type":"verse","number":8,"content":["Tai bus",{"noteId":74},"sveikata tavo",{"noteId":75},"bambai ir",{"noteId":76},"smegenų drėgmė tavo kaulams."]},{"type":"verse","number":9,"content":["Gerbk VIEŠPATĮ savo turtu ir viso savo prieaugio pirmaisiais vaisiais,"]},{"type":"verse","number":10,"content":["tai tavo svirnai bus gausiai pripildyti, ir šviežias vynas liesis per surinkimo talpyklų kraštus."]},{"type":"verse","number":11,"content":["Mano sūnau,",{"noteId":77},"nepaniekink VIEŠPATIES",{"noteId":78},"drausmės, nesipiktink dėl jo pabarimo,"]},{"type":"verse","number":12,"content":["nes ką VIEŠPATS myli, tą sudraudžia kaip tėvas sūnų, kuriuo gėrisi."]},{"type":"verse","number":13,"content":["Koks didžiai palaimintas žmogus, kuris randa išmintį, ir žmogus, kuris įgyja supratimo,"]},{"type":"verse","number":14,"content":["nes",{"noteId":79},"nauda iš to, ką",{"noteId":80},"ji teikia, yra vertingesnė negu nauda iš to, ką teikia sidabras, ir",{"noteId":81},"pelnas iš jos yra vertingesnis už auksą."]},{"type":"verse","number":15,"content":["Ji brangesnė už brangakmenius, ir",{"noteId":82},"visa, ko trokšti, negali jai prilygti."]},{"type":"verse","number":16,"content":[{"noteId":83},"Ilgai besitęsiančios dienos – jos dešinėje, jos kairėje – turtai ir garbė."]},{"type":"verse","number":17,"content":["Jos keliai – malonūs keliai, ir visi jos takai –",{"noteId":84},"ramybė."]},{"type":"verse","number":18,"content":["Ji yra",{"noteId":85},"gyvybės medis tiems, kurie ją nutveria, ir",{"noteId":86},"laimingas kiekvienas, kuris jos laikosi."]},{"type":"verse","number":19,"content":["VIEŠPATS išmintimi",{"noteId":87},"pastatė žemę, supratimu įtvirtino dangus."]},{"type":"verse","number":20,"content":["Jo pažinimu perskirti požeminiai vandenys, ir debesys lašina rasą."]},{"type":"verse","number":21,"content":["Mano sūnau,",{"noteId":88},"neišleisk",{"noteId":89},"jų iš savo akių,",{"noteId":90},"laikykis sveikos išminties ir nuovokumo,"]},{"type":"verse","number":22,"content":["taip jie bus gyvybė tavo",{"noteId":91},"sielai ir gražmena tavo kaklui."]},{"type":"verse","number":23,"content":["Tada saugiai eisi savo keliu, ir tavo koja nesuklups."]},{"type":"verse","number":24,"content":["Kai gulsiesi pailsėti,",{"noteId":92},"nebijosi, bet atsigulsi, ir tavo miegas bus saldus."]},{"type":"verse","number":25,"content":["Nebijok staigaus siaubo ir",{"noteId":93},"nedorėlių niokojimo, kai jis ateis,"]},{"type":"verse","number":26,"content":["nes VIEŠPATS bus",{"noteId":94},"tavo pasitikėjimas ir apsaugos tavo koją nuo sugavimo spąstuose."]},{"type":"heading","content":["Ketvirtoji kalba sūnui"]},{"type":"verse","number":27,"content":["Nesulaikyk gero nuo to, kuriam tai priklauso, kai tavo rankos pajėgia tai padaryti."]},{"type":"verse","number":28,"content":["Nesakyk savo artimui: „Eik ir sugrįžk, ir rytoj tau duosiu“,",{"noteId":95},"kai tu dabar turi tai pas save."]},{"type":"verse","number":29,"content":["Nesumanyk",{"noteId":96},"bloga prieš savo",{"noteId":97},"artimą, jam",{"noteId":98},"saugiai gyvenant šalia tavęs."]},{"type":"verse","number":30,"content":["Nesivaidyk be reikalo su žmogumi, jei jis tau nieko blogo nėra padaręs."]},{"type":"verse","number":31,"content":["Nepavydėk smurtininkui ir nepasirink nė vieno iš jo kelių,"]},{"type":"verse","number":32,"content":["nes",{"noteId":99},"suktas žmogus yra bjaurastis VIEŠPAČIUI, bet",{"noteId":100},"jo paslaptis yra pas",{"noteId":101},"doruosius."]},{"type":"verse","number":33,"content":["VIEŠPATIES",{"noteId":102},"prakeikimas tvyro ant nedorėlio namų, bet teisiųjų",{"noteId":103},"buveinę jis laimina."]},{"type":"verse","number":34,"content":["Tikrai jis pašiepia šaipūnus, bet",{"noteId":104},"nuolankiesiems duoda malonę."]},{"type":"verse","number":35,"content":["Išmintingieji paveldės šlovę, bet",{"noteId":105},"negarbė „iškels“ kvailius."]}],"footnotes":[{"noteId":64,"caller":"+","text":"„ilgai besitęsiančias dienas“ – Hbr. „dienų ilgumo“; gal „prailgintų dienų“, t. y., ilgą gyvenimo trukmę.","reference":{"chapter":3,"verse":2}},{"noteId":65,"caller":"+","text":"„gyvybingų metų“ – Arba „gyvenimo metų“.","reference":{"chapter":3,"verse":2}},{"noteId":66,"caller":"+","text":"„ramybės“ – Hbr. žodis „šalom“ apima ramybę, gerovę, saugumą, sėkmę ir kt.","reference":{"chapter":3,"verse":2}},{"noteId":67,"caller":"+","text":"„to padarinys toks:“ – Arba „taip“, „tokiu būdu“.","reference":{"chapter":3,"verse":4}},{"noteId":68,"caller":"+","text":"„įgysi“ – Arba „rasi“.","reference":{"chapter":3,"verse":4}},{"noteId":69,"caller":"+","text":"„maloningumą“ – Arba „palankumą“, „malonę“.","reference":{"chapter":3,"verse":4}},{"noteId":70,"caller":"+","text":"„puikią įžvalgą“ – Arba „gerą apdairumą“, „gerą (puikų) supratimą“.","reference":{"chapter":3,"verse":4}},{"noteId":71,"caller":"+","text":"„nesiremk“ – Arba „nepasikliauk“. Žr. II Met 14:11.","reference":{"chapter":3,"verse":5}},{"noteId":72,"caller":"+","text":"„pripažink“ – Arba „paisyk“, „atkreipk dėmesį į“, „pažink“ (tas pat hbr. žodis vartojamas daugiau kaip 30 k. Patarlių knygoje). Dažniausiai verčiamas „pažinti“.","reference":{"chapter":3,"verse":6}},{"noteId":73,"caller":"+","text":"„nukreips tavo takus“ – Arba „ištiesins tavo takus“.","reference":{"chapter":3,"verse":6}},{"noteId":74,"caller":"+","text":"„sveikata“ – Arba „išgydymas“, „pasveikimas“, „vaistai“.","reference":{"chapter":3,"verse":8}},{"noteId":75,"caller":"+","text":"„bambai“ – Arba „pilvo vidurio duobelei“; turbūt rodo į viso kūną atgaivinimą (sinekdocha – retorinė figūra, kai visuma reiškiama dalimi arba dalis reiškiama visuma).","reference":{"chapter":3,"verse":8}},{"noteId":76,"caller":"+","text":"„smegenų drėgmė“ – Plg. Job 21:24, kurioje rašoma, kad „kaulai drėgni nuo smegenų“.","reference":{"chapter":3,"verse":8}},{"noteId":77,"caller":"+","text":"„nepaniekink“ – Arba „neatmesk“.","reference":{"chapter":3,"verse":11}},{"noteId":78,"caller":"+","text":"„drausmės“ – Arba „pataisančio auklėjimo“.","reference":{"chapter":3,"verse":11}},{"noteId":79,"caller":"+","text":"„nauda iš to, ką ji teikia“ – T. „jos prekybinės pajamos“.","reference":{"chapter":3,"verse":14}},{"noteId":80,"caller":"+","text":"„ji“, „jos“ – Šie įvardžiai rodo į išmintį ir supratimą kartu, kaip vieną dalyką (jie čia pateikti kaip sinonimai). 13-tos eilutės žodžiai חׇכְמָה (išmintis) ir תָּבוּן (supratimas) abudu yra mot. gim. vns.","reference":{"chapter":3,"verse":14}},{"noteId":81,"caller":"+","text":"„pelnas iš jos“ – T. „jos pelnas“.","reference":{"chapter":3,"verse":14}},{"noteId":82,"caller":"+","text":"„visa, ko trokšti“ – T. „visi tavo troškimai“.","reference":{"chapter":3,"verse":15}},{"noteId":83,"caller":"+","text":"„Ilgai besitęsiančios dienos“ – Hbr. „dienų ilgumas“; gal „prailgintos dienos“, t. y., ilga gyvenimo trukmė.","reference":{"chapter":3,"verse":16}},{"noteId":84,"caller":"+","text":"„ramybė“ – Arba „ramumas“, „rami vidinė nuostata (nusistatymas)“.","reference":{"chapter":3,"verse":17}},{"noteId":85,"caller":"+","text":"„gyvybės“ – Arba „apstaus gyvenimo“, „apsčios gyvybės“.","reference":{"chapter":3,"verse":18}},{"noteId":86,"caller":"+","text":"„laimingas“ – Arba „vadintinas laimingu“.","reference":{"chapter":3,"verse":18}},{"noteId":87,"caller":"+","text":"„pastatė“ – Arba „pastatė ant pamatų“.","reference":{"chapter":3,"verse":19}},{"noteId":88,"caller":"+","text":"„neišleisk jų“ – T. „jos tegul nenueina“.","reference":{"chapter":3,"verse":21}},{"noteId":89,"caller":"+","text":"„jų“ – Turbūt įvardis „jų“ atstoja 13-tos eilutės išmintį ir supratimą.","reference":{"chapter":3,"verse":21}},{"noteId":90,"caller":"+","text":"„laikykis“ – Arba „saugok“.","reference":{"chapter":3,"verse":21}},{"noteId":91,"caller":"+","text":"„sielai […] kaklui“ – Siela rodo į vidinį žmogų, kaklas rodo į jo kūną; kartu čia pateikti šie žodžiai rodo į žmogaus visumą.","reference":{"chapter":3,"verse":22}},{"noteId":92,"caller":"+","text":"„nebijosi“ – Arba „nebūsi išgąsdintas“, „nedrebėsi iš baimės“.","reference":{"chapter":3,"verse":24}},{"noteId":93,"caller":"+","text":"„nedorėlių niokojimo“ – Hbr. gramatinė sandara leidžia suprasti dvejaip: (1) niokojimas, kuris užklups nedorėlius, bet nelies tų, kurie laikosi išminties ir nuovokumo (21 eil.) arba (2) niokojimas, kurį sukels nedorėliai.","reference":{"chapter":3,"verse":25}},{"noteId":94,"caller":"+","text":"„tavo pasitikėjimas“ – Arba (1) Dievas yra tas, kuriuo tuo atveju pasitikėsi arba (2) Dievas yra tas, kuris tuo atveju tau suteiks tikėjimą (arba pagrindą tikėti), kad esi saugus. Dėl teksto paralelizmo, antras variantas atrodo tinkamesnis.","reference":{"chapter":3,"verse":26}},{"noteId":95,"caller":"+","text":"„kai tu dabar turi tai pas save“ – T. „ir tai yra pas tave“.","reference":{"chapter":3,"verse":28}},{"noteId":96,"caller":"+","text":"„bloga“ – Arba „žalos“.","reference":{"chapter":3,"verse":29}},{"noteId":97,"caller":"+","text":"„artimą“ – Arba „kaimyną“.","reference":{"chapter":3,"verse":29}},{"noteId":98,"caller":"+","text":"„saugiai“ – T. y. manydamas, jog yra saugus. Hbr. žodis rodo į prieglaudą, prieglobstį, saugią vietą.","reference":{"chapter":3,"verse":29}},{"noteId":99,"caller":"+","text":"„suktas žmogus“ – T. „tas, kuris nukrypęs“.","reference":{"chapter":3,"verse":32}},{"noteId":100,"caller":"+","text":"„jo paslaptis yra pas doruosius“ – T. y. dorieji yra Dievo patikimųjų žmonių rate.","reference":{"chapter":3,"verse":32}},{"noteId":101,"caller":"+","text":"„doruosius“ – T. „tiesiuosius“.","reference":{"chapter":3,"verse":32}},{"noteId":102,"caller":"+","text":"„prakeikimas“ – T. y. trukdymas, pasisekimo užkirtimas.","reference":{"chapter":3,"verse":33}},{"noteId":103,"caller":"+","text":"„buveinę“ – Hbr. žodis gali būti verčiamas ir „ganykla“, „gardas“, „gyvenvietė“, „lanka“, „apsistojimo vieta“.","reference":{"chapter":3,"verse":33}},{"noteId":104,"caller":"+","text":"„nuolankiesiems“ – Arba „nusižeminusiems“, „romiesiems“; kitose kontekstuose tiktų ir „varguoliams“, „prispaustiesiems“.","reference":{"chapter":3,"verse":34}},{"noteId":105,"caller":"+","text":"„negarbė“ – Arba „gėda“.","reference":{"chapter":3,"verse":35}}]},"thisChapterLink":"/api/lit_tpv/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}