{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PRO","translationId":"lit_tpv","name":"Patarlių","commonName":"Patarlių","title":"Patarlių knyga","order":20,"numberOfChapters":31,"sha256":"c56b9864ee09664d2cc093e272ed79e36aeff415187ebb905e9b939c62645e26","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lit_tpv/PRO/31.json","totalNumberOfVerses":485},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["Karaliaus Lemuelio žodžiai,",{"noteId":464},"pranašiškas pranešimas, kurio jo motina pamokė jį:"]},{"type":"verse","number":2,"content":["Ką, mano sūnau? Ir ką, mano įsčių sūnau? Ir ką, mano įžadų sūnau?"]},{"type":"verse","number":3,"content":["Neatiduok savo",{"noteId":465},"šaunumo moterims, nė savo kelių",{"noteId":466},"tam dalykui, kuris sunaikina karalius."]},{"type":"verse","number":4,"content":["Ne karaliams, o Lemueli, ne karaliams gerti vyną, nė",{"noteId":467},"valdovams",{"noteId":468},"stiprų gėrimą."]},{"type":"verse","number":5,"content":["Priešingu atveju,",{"noteId":469},"toksai gers ir pamirš tai, kas buvo įsakyta, ir",{"noteId":470},"iškraipys teisingumą",{"noteId":471},"prispaustųjų atžvilgiu."]},{"type":"verse","number":6,"content":["Duokite",{"noteId":472},"stipraus gėrimo bepražūstančiam ir vyno tiems,",{"noteId":473},"kurie patys karčiai merdi."]},{"type":"verse","number":7,"content":[{"noteId":474},"Toksai tegul geria ir pamiršta savo skurdą ir savo vargo tenebeatsimena."]},{"type":"verse","number":8,"content":["Atverk savo burną už",{"noteId":475},"tą, kuris pats už save negali kalbėti, tai yra už teises visų",{"noteId":476},"negalinčių apsiginti."]},{"type":"verse","number":9,"content":["Atverk savo burną, teisk teisingai ir gink",{"noteId":477},"varguolių bei vargšų teises."]},{"type":"verse","number":10,"content":["Kas gali rasti šaunią moterį? Juk jos vertė daug didesnė už",{"noteId":478},"brangakmenius."]},{"type":"verse","number":11,"content":["Jos vyro širdis",{"noteId":479},"visiškai pasitiki ja, ir",{"noteId":480},"jam neprireiks grobio."]},{"type":"verse","number":12,"content":["Ji darys jam gera, o ne bloga, per visas savo gyvenimo dienas."]},{"type":"verse","number":13,"content":["Ji ieško vilnos bei linų ir mielai darbuojasi savo rankomis."]},{"type":"verse","number":14,"content":["Ji yra kaip",{"noteId":481},"pirklių laivai: iš toli ji pargabena savo maistą."]},{"type":"verse","number":15,"content":["Ji ir keliasi, kai dar naktis, ir duoda maisto savo šeimynai bei dalį savo tarnaitėms."]},{"type":"verse","number":16,"content":["Ji apsvarsto lauką ir jį nuperka; savo rankų",{"noteId":482},"atlygiu ji įveisia vynuogyną."]},{"type":"verse","number":17,"content":["Ji sujuosia savo strėnas stiprybe ir sustiprina savo rankas."]},{"type":"verse","number":18,"content":["Ji",{"noteId":483},"jaučia, kad jos",{"noteId":484},"pelnas geras; jos žibintas neužgęsta naktį."]},{"type":"verse","number":19,"content":["Ji ištiesia savo rankas į verpstę, ir jos rankos laiko ratelį."]},{"type":"verse","number":20,"content":["Savo delną ji atidaro",{"noteId":485},"varguoliams ir ištiesia savo rankas",{"noteId":486},"stokojantiems."]},{"type":"verse","number":21,"content":["Ji nebijo sniego dėl savo šeimynos, nes visa jos šeimyna aprengta",{"noteId":487},"skaisčiai raudonais drabužiais."]},{"type":"verse","number":22,"content":["Ji pasigamina sau",{"noteId":488},"užtiesalų; jos apdaras –",{"noteId":489},"aukštos kokybės drobė ir",{"noteId":490},"purpuras."]},{"type":"verse","number":23,"content":["Jos vyras yra žinomas vartuose, kai jis",{"noteId":491},"posėdžiauja su šalies",{"noteId":492},"vyresniaisiais."]},{"type":"verse","number":24,"content":["Ji",{"noteId":493},"padaro ir parduoda ploną drobę, ir pristato juostų",{"noteId":494},"pirkliams."]},{"type":"verse","number":25,"content":["Stiprybė ir kilnumas – jos apdaras, ir",{"noteId":495},"ji džiaugiasi ateitimi."]},{"type":"verse","number":26,"content":["Ji atveria savo burną",{"noteId":496},"vadovaudamasi išmintimi, ir ant jos liežuvio –",{"noteId":497},"maloningumo įstatymas."]},{"type":"verse","number":27,"content":["Ji gerai prižiūri savo šeimynos takus ir nevalgo tinginystės duonos."]},{"type":"verse","number":28,"content":["Jos vaikai pakyla ir vadina ją palaiminta, jos vyras irgi giria ją:"]},{"type":"verse","number":29,"content":["„Daug dukterų elgėsi šauniai, bet tu viršiji jas visas!“"]},{"type":"verse","number":30,"content":["Žavumas apgaulingas, ir grožis tuščias; bet moteris, kuri bijo VIEŠPATIES, bus giriama."]},{"type":"verse","number":31,"content":["Duokite jai jos rankų atlygį, ir jos darbai tegul giria ją vartuose."]}],"footnotes":[{"noteId":464,"caller":"+","text":"„pranašiškas pranešimas“ – Dažnai ST šis hbr. žodis verčiamas „našta“.","reference":{"chapter":31,"verse":1}},{"noteId":465,"caller":"+","text":"„šaunumo“ – Plačios reikšmės hbr. žodis gali reikšti „šaunumas“, „pranašumas“, „garbingumas“, „stiprybė“, „jėga“ arba kt. Kontekstas rodo, kad čia ne tik fizinė stiprybė turima omenyje.","reference":{"chapter":31,"verse":3}},{"noteId":466,"caller":"+","text":"„tam dalykui, kuris sunaikina karalius“ – T. „karalių sunaikinimui“.","reference":{"chapter":31,"verse":3}},{"noteId":467,"caller":"+","text":"„valdovams“ – Arba „kunigaikščiams“.","reference":{"chapter":31,"verse":4}},{"noteId":468,"caller":"+","text":"„stiprų gėrimą“ – Arba „svaigalus“.","reference":{"chapter":31,"verse":4}},{"noteId":469,"caller":"+","text":"„toksai“ – T. „Jis“, t. y. įspėjimo nepaisęs valdovas.","reference":{"chapter":31,"verse":5}},{"noteId":470,"caller":"+","text":"„iškraipys teisingumą“ – Arba „pakeis nutartį“, t. y. prispaustų (išnaudotų) žmonėms palankų ankstesnį teismo nutarimą koreguos jų priešų naudai.","reference":{"chapter":31,"verse":5}},{"noteId":471,"caller":"+","text":"„prispaustųjų“ – T. „nelaimės sūnų“.","reference":{"chapter":31,"verse":5}},{"noteId":472,"caller":"+","text":"„stipraus gėrimo“ – Arba „svaigalų“.","reference":{"chapter":31,"verse":6}},{"noteId":473,"caller":"+","text":"„kurie patys karčiai merdi“ – Arba „kurių siela apkartusi“; frazė vartojamas ir Job 3:20, kur kalbama irgi apie žmones, kurių mirtis numatyta netrukus.","reference":{"chapter":31,"verse":6}},{"noteId":474,"caller":"+","text":"„Toksai“ t. „Jis“.","reference":{"chapter":31,"verse":7}},{"noteId":475,"caller":"+","text":"„tą, kuris pats už save negali kalbėti“ – T. „nebylį“; bet kontekstas rodo ne į fizinę negalią, bet į teisinę padėtį.","reference":{"chapter":31,"verse":8}},{"noteId":476,"caller":"+","text":"„negalinčių apsiginti“ – T. „laikinumo sūnų“, „išnykimo sūnų“.","reference":{"chapter":31,"verse":8}},{"noteId":477,"caller":"+","text":"„varguolių“ – Arba „prispaustųjų“, „nužemintųjų“, „nuolankiųjų“, „romiųjų“; hbr. kuopinis vns.","reference":{"chapter":31,"verse":9}},{"noteId":478,"caller":"+","text":"„brangakmenius“ – Arba „koralus“.","reference":{"chapter":31,"verse":10}},{"noteId":479,"caller":"+","text":"„visiškai“ – Arba „užtikrintai“, „garantuotai“.","reference":{"chapter":31,"verse":11}},{"noteId":480,"caller":"+","text":"„jam neprireiks grobio“ – Gal „jam netrūks pelno“.","reference":{"chapter":31,"verse":11}},{"noteId":481,"caller":"+","text":"„pirklių“ – Arba „prekybiniai“; hbr. k. žodis yra vns.","reference":{"chapter":31,"verse":14}},{"noteId":482,"caller":"+","text":"„atlygiu“ – T. „vaisiumi„; plg. Pat 31:31.","reference":{"chapter":31,"verse":16}},{"noteId":483,"caller":"+","text":"„jaučia“ – T. „ragauja“.","reference":{"chapter":31,"verse":18}},{"noteId":484,"caller":"+","text":"„pelnas“ – Arba „prekybinis pelnas“.","reference":{"chapter":31,"verse":18}},{"noteId":485,"caller":"+","text":"„varguoliams“ – Arba „prispaustiesiems“, „nužemintiesiems“, „nuolankiesiems“, „romiesiems“.","reference":{"chapter":31,"verse":20}},{"noteId":486,"caller":"+","text":"„stokojantiems“ – Arba „neturtėliams“, „beturčiams“, „vargšams“, „skurdžiams“; hbr. žodis yra kuopinis vns.","reference":{"chapter":31,"verse":20}},{"noteId":487,"caller":"+","text":"„skaisčiai raudonais drabužiais“ – Turbūt nurodoma į labai aukštos kokybės drabužius, kurie ir žiemą apsaugotų nuo šalčio (plg. II Sam 1:24, Iš 26:1, 26:31, 28:33).","reference":{"chapter":31,"verse":21}},{"noteId":488,"caller":"+","text":"„užtiesalų“ – Arba „antklodžių“. Hbr. žodis vartojamas tik čia yra Pat 7:16.","reference":{"chapter":31,"verse":22}},{"noteId":489,"caller":"+","text":"„plona drobė“ – Gal „šilkinė drobė“.","reference":{"chapter":31,"verse":22}},{"noteId":490,"caller":"+","text":"„purpuras“ – T. y. tamsiai raudonai dažytas audinys.","reference":{"chapter":31,"verse":22}},{"noteId":491,"caller":"+","text":"„posėdžiauja“ – Arba „sėdi“.","reference":{"chapter":31,"verse":23}},{"noteId":492,"caller":"+","text":"„vyresniaisiais“ – Arba „seniūnais“.","reference":{"chapter":31,"verse":23}},{"noteId":493,"caller":"+","text":"„padaro“ – Arba „gamina“.","reference":{"chapter":31,"verse":24}},{"noteId":494,"caller":"+","text":"„pirkliams“ – T. „pirkliui“; hbr. žodis yra kuopinis vns.","reference":{"chapter":31,"verse":24}},{"noteId":495,"caller":"+","text":"„ji džiaugiasi ateitimi“ – Arba „ji juokiasi iš ateities“, t. y., jaučiasi saugiai žiūrėdama į ateitį, nes dėl darbštumo jos šeima finansiškai patvari („stiprybė“, plg. Pat 10:15, 18:11) ir kilni.","reference":{"chapter":31,"verse":25}},{"noteId":496,"caller":"+","text":"„vadovaudamasi išmintimi“ – T. „su išmintimi“.","reference":{"chapter":31,"verse":26}},{"noteId":497,"caller":"+","text":"„maloningumo“ – Hbr. „chesed“, galimai verčiamas „gailestingumas“, „geranoriškumas“ ir pan.","reference":{"chapter":31,"verse":26}}]},"thisChapterLink":"/api/lit_tpv/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}