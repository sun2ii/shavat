{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":100,"content":[{"type":"verse","number":1,"content":[{"noteId":515},{"text":"Gyriaus psalmė.","descriptive":true},"O",{"noteId":516},"visos šalys, kelkite džiaugsmingą skambų garsą VIEŠPAČIUI!"]},{"type":"verse","number":2,"content":["Tarnaukite VIEŠPAČIUI su džiaugsmu! Įeikite jo akivaizdon su krykštavimu!"]},{"type":"verse","number":3,"content":["Žinokite, kad VIEŠPATS, jis yra Dievas! Padarė mus jis, o ne mes patys; mes esame jo",{"noteId":517},"tauta ir jo ganyklos avys."]},{"type":"verse","number":4,"content":["Įeikite pro jo vartus su dėkojimu, į jo kiemus su gyriumi; dėkokite jam, laiminkite jo vardą."]},{"type":"verse","number":5,"content":["Nes VIEŠPATS yra geras, jo gailestingumas yra amžinas, ir jo",{"noteId":518},"tiesa išlieka kartų kartoms."]}],"footnotes":[{"noteId":515,"caller":"+","text":"„Gyriaus“ – Arba „Padėkos“. Hbr. žodžio šaknies reikšmė yra „girti“, bet žodis nusako ir padėką.","reference":{"chapter":100,"verse":1}},{"noteId":516,"caller":"+","text":"„visos šalys“ – T. „visa žemė“, „visas krašte“, „visa salie“.","reference":{"chapter":100,"verse":1}},{"noteId":517,"caller":"+","text":"„tauta“ – Arba „žmonės“, „žmonių sambūris“.","reference":{"chapter":100,"verse":3}},{"noteId":518,"caller":"+","text":"„tiesa“ – Arba „patvarumas“, „tvirtumas“, „nekintamumas“, „ištikimybė“.","reference":{"chapter":100,"verse":5}}]},"thisChapterLink":"/api/lit_tpv/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}