{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":103,"content":[{"type":"verse","number":1,"content":[{"text":"Dovydo.","descriptive":true},"O mano siela, laimink VIEŠPATĮ, ir visa, kas manyje, laimink jo šventą vardą!"]},{"type":"verse","number":2,"content":["O mano siela, laimink VIEŠPATĮ ir nepamiršk visų jo geradarysčių!"]},{"type":"verse","number":3,"content":["Jis – tas, kuris atleidžia visą tavo kaltę, kuris gydo visas tavo ligas,"]},{"type":"verse","number":4,"content":["kuris atperka tavo gyvybę iš",{"noteId":527},"pražūties, kuris",{"noteId":528},"apgaubia tave gailestingumu ir",{"noteId":529},"apsčiu meilumu,"]},{"type":"verse","number":8,"content":["Gailestingas ir maloningas yra VIEŠPATS, lėtas pykti ir kupinas gailestingumo."]},{"type":"verse","number":12,"content":["Kaip toli rytai yra nuo vakarų, taip jis nuo mūsų atitolino mūsų nusižengimus."]},{"type":"verse","number":13,"content":["Kaip tėvas gailisi savo vaikų, taip VIEŠPATS gailisi tų, kurie jo bijo."]},{"type":"verse","number":15,"content":["Mirtingasis – jo dienos panašios į žolę, jis klesti taip, kaip lauko gėlė:"]},{"type":"verse","number":16,"content":["juk vėjas virš jos vos pučia, ir jos jau nebėra, ir",{"noteId":530},"jos vieta daugiau jos nebepažins."]},{"type":"verse","number":17,"content":["Bet VIEŠPATIES gailestingumas būna nuo amžinybės iki amžinybės ant tų, kurie jo bijo, ir jo teisumas vaikų vaikams –"]},{"type":"verse","number":20,"content":["Laiminkite VIEŠPATĮ, jo angelai, jūs",{"noteId":531},"veiksmingi galingieji, kurie vykdote jo žodį, klausydami jo žodžio",{"noteId":532},"balso."]},{"type":"verse","number":21,"content":["Laiminkite VIEŠPATĮ, jūs, visos jo kareivijos, jūs, jo tarnai, kurie vykdote",{"noteId":533},"jo valią."]}],"footnotes":[{"noteId":527,"caller":"+","text":"„pražūties“ – „duobės“.","reference":{"chapter":103,"verse":4}},{"noteId":528,"caller":"+","text":"„apgaubia“ – Arba „vainikuoja“.","reference":{"chapter":103,"verse":4}},{"noteId":529,"caller":"+","text":"„apstu meilumu“ t. dgs., „meilumais“; arba „apsčia atjauta“; t. y. giliausiais meilės, apsaugojimo ir palankumo jausmais.","reference":{"chapter":103,"verse":4}},{"noteId":530,"caller":"+","text":"„jos vieta daugiau jos nebepažins“ – Plg. Job 7:10.","reference":{"chapter":103,"verse":16}},{"noteId":531,"caller":"+","text":"„veiksmingi galingieji“ – T. „stiprybės galingieji / didvyriai / karžygiai / stipruoliai“.","reference":{"chapter":103,"verse":20}},{"noteId":532,"caller":"+","text":"„balso“ – Arba „garso“.","reference":{"chapter":103,"verse":20}},{"noteId":533,"caller":"+","text":"„jo valią“ – Arba „tai, kas jam patinka“.","reference":{"chapter":103,"verse":21}}]},"thisChapterLink":"/api/lit_tpv/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":12}