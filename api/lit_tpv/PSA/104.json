{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":104,"content":[{"type":"verse","number":6,"content":["Tu ją apdengei gelme kaip drabužiu, vandenys stovėjo virš kalnų."]},{"type":"verse","number":7,"content":["Tau barantis jie bėgo, nuo tavo griaustinio balso jie išskubėjo."]},{"type":"verse","number":8,"content":["Kalnai pakilo, nusileido slėniai į vietą, į kurią jiems pastatei pamatą."]},{"type":"verse","number":9,"content":["Tu nustatei ribą: jie negali peržengti, jie nebegali sugrįžti žemės apdengti."]},{"type":"verse","number":19,"content":["Jis padarė mėnulį",{"noteId":534},"laikams nustatyti; saulė",{"noteId":535},"žino, kada nusileisti."]},{"type":"verse","number":24,"content":["Viešpatie, kokia daugybė tavo darbų! Savo išmintimi juos padarei! Tavo kūrinių pilna žemė!"]},{"type":"verse","number":31,"content":["VIEŠPATIES šlovė",{"noteId":536},"pasiliks per amžius, VIEŠPATS džiaugsis savo",{"noteId":537},"darbais."]},{"type":"verse","number":33,"content":["Giedosiu VIEŠPAČIUI, kol gyvas būsiu, giedosiu gyrių savo Dievui, kol gyvuos manasis aš."]},{"type":"verse","number":34,"content":["Tebūna malonus mano apmąstymas apie jį, aš džiaugsiuosi VIEŠPAČIU."]}],"footnotes":[{"noteId":534,"caller":"+","text":"„laikams nustatyti“ – Arba „nustatytiems laikams“, „laikams žymėti“. Hbr žodis, kuris čia išverstas „laikams nustatyti“ rodo į nustatytą vietą arba nustatytą laiką.","reference":{"chapter":104,"verse":19}},{"noteId":535,"caller":"+","text":"„žino, kada nusileisti“ – Hbr. „savo nusileidimą“.","reference":{"chapter":104,"verse":19}},{"noteId":536,"caller":"+","text":"„pasiliks“ – Arba „būna“.","reference":{"chapter":104,"verse":31}},{"noteId":537,"caller":"+","text":"„darbais“ – Arba „kūriniais“.","reference":{"chapter":104,"verse":31}}]},"thisChapterLink":"/api/lit_tpv/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":9}