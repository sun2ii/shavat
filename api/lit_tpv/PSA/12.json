{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Vyriausiajam muzikui.","descriptive":true},{"noteId":122},{"text":"Pagal šeminitą. Dovydo psalmė.","descriptive":true},"Išgelbėk, o VIEŠPATIE, nes nebėra dievotojo, nes ištikimieji pradingsta tarp",{"noteId":123},"žmonių palikuonių."]},{"type":"verse","number":2,"content":["Jie kiekvienas su savo kaimynu kalba",{"noteId":124},"netiesą, jie kalba pataikaujančiomis lūpomis ir",{"noteId":125},"dvilype širdimi."]},{"type":"verse","number":3,"content":["VIEŠPATS pribaigs pataikaujančias lūpas, didžiakalbį liežuvį –"]},{"type":"verse","number":4,"content":["tuos, kurie yra pasakę: „Mes turime stiprų liežuvį; mūsų lūpos yra",{"noteId":126},"mūsų pačių.",{"noteId":127},"Kas gali mums viešpatauti?“"]},{"type":"verse","number":5,"content":["„Dėl smurto prieš prispaustuosius, dėl vargšų dejavimo aš pakilsiu dabar, – sako VIEŠPATS. – Aš suteiksiu saugumą nuo to, kuris į jį prunkščia“."]},{"type":"verse","number":6,"content":["VIEŠPATIES žodžiai yra tyri žodžiai, kaip",{"noteId":128},"molio lydykloje grynintas sidabras, septynis kartus nuskaistintas."]},{"type":"verse","number":7,"content":["Tu juos saugosi, o VIEŠPATIE, tu",{"noteId":129},"kiekvieną iš jų išlaikysi nuo šitos kartos per amžius."]},{"type":"verse","number":8,"content":["Nedorėliai vaikščioja visur aplinkui, kai",{"noteId":130},"niekšiški žmonės yra išaukštinti."]}],"footnotes":[{"noteId":122,"caller":"+","text":"„Pagal šeminitą“ – T. „Ant aštuntojo“, kuris gali rodyti į oktavą arba boso partiją, arba gali būti kitas nurodymas, susijęs su muzikiniu atlikimu.","reference":{"chapter":12,"verse":1}},{"noteId":123,"caller":"+","text":"„žmonių palikuonių“ – Arba „Adomo sūnų / vaikų / palikuonių“, „žmonijos“.","reference":{"chapter":12,"verse":1}},{"noteId":124,"caller":"+","text":"„netiesą“ – Arba „tuštybę“, „nebūtus dalykus“.","reference":{"chapter":12,"verse":2}},{"noteId":125,"caller":"+","text":"„dvilype širdimi“ – Plg. I Met 12:33, Jok 1:8.","reference":{"chapter":12,"verse":2}},{"noteId":126,"caller":"+","text":"„mūsų pačių“ – T. „su mumis“.","reference":{"chapter":12,"verse":4}},{"noteId":127,"caller":"+","text":"„Kas gali mums viešpatauti“ – T. „Kas yra Viešpats / Valdovas virš mūsų“.","reference":{"chapter":12,"verse":4}},{"noteId":128,"caller":"+","text":"„molio“ – Arba „žemės“, t. y. lydykloje, padarytoje iš žemės dulkių arba ant žemės.","reference":{"chapter":12,"verse":6}},{"noteId":129,"caller":"+","text":"„kiekvieną iš jų“ – Hbr. „jį“ (kuopinis dkt.).","reference":{"chapter":12,"verse":7}},{"noteId":130,"caller":"+","text":"„niekšiški“ – Arba „niekam tikę“.","reference":{"chapter":12,"verse":8}}]},"thisChapterLink":"/api/lit_tpv/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}