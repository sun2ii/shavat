{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":127,"content":[{"type":"verse","number":1,"content":[{"noteId":630},{"text":"Užkopimų giesmė Saliamonui.","descriptive":true},"Jeigu VIEŠPATS nestato namų, veltui triūsia jų statytojai; jeigu VIEŠPATS nesaugo miesto, veltui budi sargas."]},{"type":"verse","number":2,"content":["Veltui jums anksti keltis,",{"noteId":631},"vėlai eiti gulti, valgyti",{"noteId":632},"sunkiu darbu įgytą duoną – jis gi duoda miegą",{"noteId":633},"tiems, kuriuos myli."]},{"type":"verse","number":3,"content":["Štai vaikai yra paveldas nuo VIEŠPATIES, įsčių vaisius – atlygis nuo jo."]},{"type":"verse","number":4,"content":["Kaip strėlės karžygio rankoje, taip jaunystės vaikai."]},{"type":"verse","number":5,"content":["Kokie didžiai palaimintas žmogus, kuris turi jų pilną savo strėlinę!",{"noteId":634},"Tokie nebus sugėdinti,",{"noteId":635},"bet jie kalbėsis su priešais vartuose."]}],"footnotes":[{"noteId":630,"caller":"+","text":"„Užkopimų giesmė Saliamonui.“ – Arba „Užkopimų giesmė. Saliamono.“","reference":{"chapter":127,"verse":1}},{"noteId":631,"caller":"+","text":"„vėlai eiti gulti“ – T. „atidėti atsisėdimą“.","reference":{"chapter":127,"verse":2}},{"noteId":632,"caller":"+","text":"„sunkiu darbu įgytą duoną“ – Arba „vargais įgytą duoną“; t. „vargų duoną“.","reference":{"chapter":127,"verse":2}},{"noteId":633,"caller":"+","text":"„tiems, kuriuos myli“ – Hbr. forma yra vns. (savo mylimajam), bet turbūt kuopinis vns., todėl verčiamas čia kaip dgs.","reference":{"chapter":127,"verse":2}},{"noteId":634,"caller":"+","text":"„Tokie“ – T. „jie“, t. y. „tėvai“.","reference":{"chapter":127,"verse":5}},{"noteId":635,"caller":"+","text":"„bet“ – Arba „kai“; hbr. priešdėlis turi įvairias reikšmes, įskaitant „bet“, „kai“, „nors“, „jeigu“, „kadangi“, „nors“.","reference":{"chapter":127,"verse":5}}]},"thisChapterLink":"/api/lit_tpv/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}