{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Vyriausiajam muzikui. Dovydo psalmė.","descriptive":true},{"noteId":131},"Kiek ilgai, VIEŠPATIE? Ar pamirši mane amžinai? Kiek ilgai slėpsi savo veidą nuo manęs?"]},{"type":"verse","number":2,"content":["Kiek ilgai teks man patarimų dėti sau į sielą, liūdesiui užėmus mano širdį dienos metu? Kiek ilgai mano priešas bus išaukštintas virš manęs?"]},{"type":"verse","number":3,"content":["Pažvelk, išklausyk mane, VIEŠPATIE, mano Dieve! Padaryk šviesias man akis, kad mirties miegu neužmigčiau!"]},{"type":"verse","number":4,"content":["Kad mano priešas nesakytų: „Aš jį nugalėjau“ ir mano",{"noteId":132},"prispaudėjai nedžiūgautų dėl to, kad svyruoju."]},{"type":"verse","number":5,"content":["Bet aš pasitikėjau tavo gailestingumu. Mano širdis džiūgaus dėl tavo išgelbėjimo."]},{"type":"verse","number":6,"content":["Aš giedosiu VIEŠPAČIUI, nes jis dosniai padarė man gera."]}],"footnotes":[{"noteId":131,"caller":"+","text":"„Kiek ilgai“ (2 k.) – Arba „Kaip dar ilgai“, „Kaip ilgai“.","reference":{"chapter":13,"verse":1}},{"noteId":132,"caller":"+","text":"„prispaudėjai“ – Arba „vargintojai“, „priešininkai“ ir pan.","reference":{"chapter":13,"verse":4}}]},"thisChapterLink":"/api/lit_tpv/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}