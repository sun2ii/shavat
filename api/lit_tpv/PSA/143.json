{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":143,"content":[{"type":"verse","number":1,"content":[{"text":"Dovydo psalmė.","descriptive":true},"O VIEŠPATIE, išgirsk mano maldą, klausykis mano",{"noteId":664},"maldavimų! Atsakyk man",{"noteId":665},"vadovaudamasis savo ištikimumu ir savo teisumu!"]},{"type":"verse","number":2,"content":["Ir neik į teismą su savo tarnu, nes",{"noteId":666},"kiekvienas iš gyvųjų yra neišteisintinas tavo akyse."]},{"type":"verse","number":8,"content":["Duok man jau rytmetį išgirsti tavo meilingumą, nes tavimi pasitikiu. Parodyk man kelią, kuriuo turiu eiti, nes",{"noteId":667},"į tave keliu savo sielą."]},{"type":"verse","number":10,"content":["Mokyk mane vykdyti tavo valią, nes tu esi mano Dievas. Tavo geroji dvasia tegul veda mane į",{"noteId":668},"teisumo kraštą."]}],"footnotes":[{"noteId":664,"caller":"+","text":"„maldavimų“ – Arba „pagalbos šauksmų“; t. y. emocingas kreipimasis pagalbos.","reference":{"chapter":143,"verse":1}},{"noteId":665,"caller":"+","text":"„vadovaudamasis savo ištikimu ir savo teisumu“ – Arba „dėl savo ištikimumo ir savo teisumo“.","reference":{"chapter":143,"verse":1}},{"noteId":666,"caller":"+","text":"„kiekvienas …“ – Užuomina į šį tekstą yra Rom 3:20.","reference":{"chapter":143,"verse":2}},{"noteId":667,"caller":"+","text":"„į tave keliu savo sielą“ – T. y. „trokštu tavęs“.","reference":{"chapter":143,"verse":8}},{"noteId":668,"caller":"+","text":"„teisumo“ – Arba „lygumo“.","reference":{"chapter":143,"verse":10}}]},"thisChapterLink":"/api/lit_tpv/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":4}