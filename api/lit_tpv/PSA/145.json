{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":145,"content":[{"type":"verse","number":1,"content":[{"text":"Dovydo pareikštas gyrius.","descriptive":true},"Tave vis išaukštinsiu, mano Dieve, o karaliau! Ιr vis laiminsiu tavo vardą per amžių amžius!"]},{"type":"verse","number":2,"content":["Kasdien laiminsiu tave ir girsiu tavo vardą per amžių amžius!"]},{"type":"verse","number":3,"content":["VIEŠPATS yra didis ir didžiai girtinas, ir jo didybė neištiriama."]},{"type":"verse","number":8,"content":["VIEŠPATS yra maloningas ir kupinas gailesčio, lėtas pykti ir didžiai gailestingas."]},{"type":"verse","number":9,"content":["VIEŠPATS yra geras visiems,",{"noteId":674},"jam giliai rūpi visi jo kūriniai."]},{"type":"verse","number":18,"content":["VIEŠPATS yra arti visų, kurie jo šaukiasi, visų, kurie jo šaukiasi reikšdami tiesą."]},{"type":"verse","number":19,"content":["Jis",{"noteId":675},"išpildys norą tų, kurie jo bijo; jis gi išgirs jų šauksmą ir juos išgelbės."]},{"type":"verse","number":20,"content":["VIE