{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"Dovydo psalmė.","descriptive":true},"Viešpatie, kas gali",{"noteId":140},"pabūti tavo padangtėje? Kas gali gyventi tavo šventajame kalne?"]},{"type":"verse","number":2,"content":["Tas, kuris",{"noteId":141},"vaikščioja vientisumo dorybėje, daro, kas teisu, ir",{"noteId":142},"kalba tiesą savo širdyje."]},{"type":"verse","number":3,"content":["Toks nešmeižia savo liežuviu, nedaro savo",{"noteId":143},"artimui blogo, ir",{"noteId":144},"nesityčioja iš savo",{"noteId":145},"kaimyno."]},{"type":"verse","number":4,"content":["Jo akyse tas, kurį reikia atmesti, yra laikomas niekam tikusiu, bet toksai gerbia tuos, kurie bijo VIEŠPATIES; jis, prisiekęs savo paties žalai, net nedaro pakeitimų."]},{"type":"verse","number":5,"content":["Jis savo pinigų neskolina su palūkanomis ir kyšių prieš nekaltąjį neima. Kas šiuos dalykus daro",{"noteId":146},"niekada nebus parblokštas."]}],"footnotes":[{"noteId":140,"caller":"+","text":"„pabūti“ – Arba „pagyventi“, „apsistoti“, t. y. užeiti ir pasilikti būdamas iš svetimos šalies.","reference":{"chapter":15,"verse":1}},{"noteId":141,"caller":"+","text":"„vaikščioja vientisumo dorybėje“ t. y., „elgiasi nepeiktinai“, t. y. kurių elgesys rodo, kad turi vieną gryną ir teisingą siekį.","reference":{"chapter":15,"verse":2}},{"noteId":142,"caller":"+","text":"„kalba tiesą savo širdyje“ – Arba „kalba tiesą iš širdies“.","reference":{"chapter":15,"verse":2}},{"noteId":143,"caller":"+","text":"„artimui“ – Arba „bičiuliui“, „draugui“.","reference":{"chapter":15,"verse":3}},{"noteId":144,"caller":"+","text":"„nesityčioja“ – Arba „nekelia prieš savo kaimyną užgaulės“.","reference":{"chapter":15,"verse":3}},{"noteId":145,"caller":"+","text":"„kaimyno“ – Arba „giminaičio“.","reference":{"chapter":15,"verse":3}},{"noteId":146,"caller":"+","text":"„niekada nebus parblokštas“ – Arba „nebus parblokštas per amžius“.","reference":{"chapter":15,"verse":5}}]},"thisChapterLink":"/api/lit_tpv/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}