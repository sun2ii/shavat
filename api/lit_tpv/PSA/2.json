{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":2,"content":[{"type":"heading","content":["Žmonės maištauja, bet Dievo Mesijas turi galutinę valdžią"]},{"type":"heading","content":["Bergždžias tautų maištas"]},{"type":"verse","number":1,"content":["Kodėl",{"noteId":5},"kitataučiai",{"noteId":6},"siaučia ir",{"noteId":7},"tautos",{"noteId":8},"apmąsto tuštybę?"]},{"type":"verse","number":2,"content":["Žemės karaliai",{"noteId":9},"stoja į kovą, ir valdovai išvien tariasi prieš VIEŠPATĮ ir prieš jo pateptąjį, sakydami:"]},{"type":"verse","number":3,"content":["„Sutraukykime jų pančius, numeskime nuo savęs jų virves!“"]},{"type":"heading","content":["Dievo Tėvo atsakas maištui"]},{"type":"verse","number":4,"content":["Tas, kuris",{"noteId":10},"sėdi danguose, juokiasi; Viešpats tyčiojasi iš jų."]},{"type":"verse","number":5,"content":["Tada jis kalbės jiems",{"noteId":11},"rūstaudamas ir",{"noteId":12},"įnirtęs juos",{"noteId":13},"išgąsdins:"]},{"type":"verse","number":6,"content":[{"noteId":14},"„O aš pats",{"noteId":15},"pastačiau savo karalių ant Siono, savo švento kalno!“"]},{"type":"heading","content":["Dievo Sūnaus atsakas maištui"]},{"type":"verse","number":7,"content":[{"noteId":16},"„Paskelbsiu įsaką; VIEŠPATS man tarė:",{"noteId":17},"„Tu esi mano Sūnus, šiandien aš tave pagimdžiau."]},{"type":"verse","number":8,"content":["Prašyk manęs, ir aš tau duosiu kitataučius, – tavo veldinį, ir tolimiausius žemės kraštus, – tavo nuosavybę."]},{"type":"verse","number":9,"content":["Tu daužysi juos geležine lazda, kaip puodžiaus indą juos",{"noteId":18},"daužysi į šukes!“"]},{"type":"heading","content":["Štai ką įsidėmėti"]},{"type":"verse","number":10,"content":["Taigi dabar, o karaliai, būkite išmintingi; duokitės",{"noteId":19},"įspėjami jūs, žemės teisėjai."]},{"type":"verse","number":11,"content":["Tarnaukite VIEŠPAČIUI su baime ir džiūgaukite drebėdami."]},{"type":"verse","number":12,"content":["Bučiuokite Sūnų, kad jis nerūstautų ir kelyje nežūtumėte, jo pykčiui",{"noteId":20},"truputį užsidegus. Kokie didžiai palaiminti visi, kurie bėga prieglaudon pas jį!"]}],"footnotes":[{"noteId":5,"caller":"+","text":"„kitataučiai“ – Arba „pagonys“, „tautos“.","reference":{"chapter":2,"verse":1}},{"noteId":6,"caller":"+","text":"„siaučia“ – Arba „bruzdėdami renkasi“.","reference":{"chapter":2,"verse":1}},{"noteId":7,"caller":"+","text":"„tautos“ – Arba „žmonių bendruomenės“, „žmonės“.","reference":{"chapter":2,"verse":1}},{"noteId":8,"caller":"+","text":"„apmąsto“ – Arba „sutelkia dėmesį į“, „susikaupia į“; gal „sumąsto“.","reference":{"chapter":2,"verse":1}},{"noteId":9,"caller":"+","text":"„stoja į kovą“ – Arba „išsirikiuoja“.","reference":{"chapter":2,"verse":2}},{"noteId":10,"caller":"+","text":"„sėdi“ – T. y. kurio sostas yra dangūs.","reference":{"chapter":2,"verse":4}},{"noteId":11,"caller":"+","text":"„rūstaudamas“ – T. „savo rūstybėje“.","reference":{"chapter":2,"verse":5}},{"noteId":12,"caller":"+","text":"„įnirtęs“ – „savo įnirtyje“.","reference":{"chapter":2,"verse":5}},{"noteId":13,"caller":"+","text":"„išgąsdins“ – Arba „sukrės“.","reference":{"chapter":2,"verse":5}},{"noteId":14,"caller":"+","text":"„O aš pats“ t. „O aš, aš“.","reference":{"chapter":2,"verse":6}},{"noteId":15,"caller":"+","text":"„pastačiau“ – Arba „patepiau“, t. y. įgalinau, kaip einantį pareigas.","reference":{"chapter":2,"verse":6}},{"noteId":16,"caller":"+","text":"„Paskelbsiu įsaką“ – Arba „Pranešiu apie įsaką“, „Paskelbsiu įsako patvirtinimą“.","reference":{"chapter":2,"verse":7}},{"noteId":17,"caller":"+","text":"„Tu esi […]“ – Dievo galia įvyksiantis Mesijo išėjimas iš kapo rūsio (prisikėlimas) lyginimas su kūdikio išėjimo iš motinos įsčių; Apd 13:33; I Kor 15:4; Hbr 1:5, 5:5.","reference":{"chapter":2,"verse":7}},{"noteId":18,"caller":"+","text":"„daužysi į šukes“ – Arba „sukulsi“, „sutrupinsi“.","reference":{"chapter":2,"verse":9}},{"noteId":19,"caller":"+","text":"„įspėjami“ – Arba „sudraudžiami“.","reference":{"chapter":2,"verse":10}},{"noteId":20,"caller":"+","text":"„truputį“ – Arba „trumpam“.","reference":{"chapter":2,"verse":12}}]},"thisChapterLink":"/api/lit_tpv/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}