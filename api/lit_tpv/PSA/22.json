{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"Vyriausiajam muzikui. Atliekama pagal melodiją „Aušros elnė“. Dovydo psalmė.","descriptive":true},"Mano Dieve, mano Dieve, kodėl mane",{"noteId":204},"apleidai, būdamas toli nuo mano išvadavimo, nuo mano",{"noteId":205},"dejonės žodžių?"]},{"type":"verse","number":4,"content":["Tavimi pasitikėjo mūsų tėvai; jie pasitikėjo, ir tu juos",{"noteId":206},"išvadavai."]},{"type":"verse","number":6,"content":["Bet aš esu kirminas, o ne žmogus;",{"noteId":207},"žmonių",{"noteId":208},"patyčių objektas ir tautos niekinamas."]},{"type":"verse","number":16,"content":["Nes mane apsupo šunys, blogadarių gauja mane apspito; jie perdūrė mano rankas ir mano kojas."]},{"type":"verse","number":17,"content":["Galiu suskaičiuoti visus savo kaulus.",{"noteId":209},"Tie spokso, žiūri į mane,"]},{"type":"verse","number":18,"content":["dalijasi tarpusavyje mano drabužius ir dėl mano apdaro meta burtą."]},{"type":"verse","number":19,"content":["Bet tu, VIEŠPATIE, nebūk toli! Mano stiprybe, skubėk man padėti!"]},{"type":"verse","number":22,"content":["Aš paskelbsiu tavo vardą savo broliams, susirinkimo viduryje tave girsiu."]},{"type":"verse","number":23,"content":["Jūs, kurie bijote VIEŠPATIES, girkite jį! Visi, kurie Jokūbo sėkla, šlovinkite jį! Ir visi, kurie Izraelio sėkla, bijokitės jo!"]}],"footnotes":[{"noteId":204,"caller":"+","text":"„apleidai“ – Arba „palikai“.","reference":{"chapter":22,"verse":1}},{"noteId":205,"caller":"+","text":"dejonės„“ – Arba „aimanos“.","reference":{"chapter":22,"verse":1}},{"noteId":206,"caller":"+","text":"„išvadavai“ – Arba „išlaisvinai“, „išgelbėjai“.","reference":{"chapter":22,"verse":4}},{"noteId":207,"caller":"+","text":"„žmonių“ – Hbr. אָדַם (adam); arba „žemiškųjų asmenų“.","reference":{"chapter":22,"verse":6}},{"noteId":208,"caller":"+","text":"„patyčių objektas“ – Arba „pajuoka“, „gėda“.","reference":{"chapter":22,"verse":6}},{"noteId":209,"caller":"+","text":"„Tie“ – Arba „jie“, t. y. Ps 22:16 minėti „šunys“ ir „blogadariai“.","reference":{"chapter":22,"verse":17}}]},"thisChapterLink":"/api/lit_tpv/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":9}