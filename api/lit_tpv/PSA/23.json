{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"Dovydo psalmė.","descriptive":true},"VIEŠPATS yra mano ganytojas, aš nestokosiu."]},{"type":"verse","number":2,"content":["Jis",{"noteId":210},"guldo mane žaliuojančiose pievose,",{"noteId":211},"švelniai vedžioja mane prie",{"noteId":212},"atilsio vietovių vandenų."]},{"type":"verse","number":3,"content":["Jis",{"noteId":213},"atgaivina mano sielą, jis veda mane teisumo takais dėl savo vardo."]},{"type":"verse","number":4,"content":["Be to,",{"noteId":214},"nors eičiau per mirties šešėlio slėnį, blogo nebijosiu, nes tu pats esi su manimi; tavo vėzdas ir tavo lazda patys paguodžia mane."]},{"type":"verse","number":5,"content":["Tu paruoši ties manimi stalą mano priešų akivaizdoje, tu aliejumi man",{"noteId":215},"patepi galvą; mano taurė sklidina."]},{"type":"verse","number":6,"content":["Tikrai gerumas ir gailestingumas",{"noteId":216},"lydės mane per visas mano gyvenimo dienas, ir aš pasiliksiu VIEŠPATIES namuose amžinai."]}],"footnotes":[{"noteId":210,"caller":"+","text":"„guldo“ – Arba „duoda man gulėti“.","reference":{"chapter":23,"verse":2}},{"noteId":211,"caller":"+","text":"„švelniai vedžioja“ – Arba „nuveda“, „gano“, t. y. saugiai ir švelniai nukreipia mane. Žr. Ps 31:3, Iz 40:11 ir kt.","reference":{"chapter":23,"verse":2}},{"noteId":212,"caller":"+","text":"„atilsio vietovių“ – Arba „atgaivinimo vietovių“, „tylių“; plg. Sk 10:33, Iz 32:18.","reference":{"chapter":23,"verse":2}},{"noteId":213,"caller":"+","text":"„atgaivina mano sielą“ – Arba „grąžina mano sielą atgal“, „atstato mano sielą į teisingą kryptį“; žr. Ps 19:7.","reference":{"chapter":23,"verse":3}},{"noteId":214,"caller":"+","text":"„nors eičiau“ – Arba „kai einu“.","reference":{"chapter":23,"verse":4}},{"noteId":215,"caller":"+","text":"„patepi“ – Veiksmažodis čia nevartojamas žymint skyrimą į pareigas, verčiau rodo į davėjo dosnumą, į gausius Dievo suteiktus palaiminimus.","reference":{"chapter":23,"verse":5}},{"noteId":216,"caller":"+","text":"„lydės“ t. „vysis“.","reference":{"chapter":23,"verse":6}}]},"thisChapterLink":"/api/lit_tpv/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}