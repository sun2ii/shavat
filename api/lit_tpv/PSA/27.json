{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"Dovydo.","descriptive":true},"VIEŠPATS yra mano šviesa ir mano išgelbėjimas – kurio asmens man bijoti? VIEŠPATS yra mano gyvenimo",{"noteId":233},"tvirtovė – kurio asmens man išsigąsti?"]},{"type":"verse","number":2,"content":["Kai blogadariai, – mano",{"noteId":234},"prispaudėjai ir mano priešai, –",{"noteId":235},"užpuolė mane, kad suėstų mano kūną, jie suklupo ir krito."]},{"type":"verse","number":3,"content":["Nors stovyklautų prieš mane",{"noteId":236},"kariuomenė, nenusigąs mano širdis, ir nors karas kiltų prieš mane,",{"noteId":237},"šiame dalyke liksiu tikintis."]},{"type":"verse","number":4,"content":["Vieno teprašiau iš VIEŠPATIES, to vieno sieksiu: likti VIEŠPATIES namuose per visas savo gyvenimo dienas, kad stebėčiau VIEŠPATIES",{"noteId":238},"pasigėrėjimą",{"noteId":239},"ir",{"noteId":240},"susikaupčiau jo šventykloje."]},{"type":"verse","number":8,"content":[{"noteId":241},"Mano širdis už tave tarė:",{"noteId":242},"„Ieškokite mano veido.“ Tavo veido, VIEŠPATIE, aš",{"noteId":243},"ieškosiu."]},{"type":"verse","number":9,"content":["Neslėpk savo veido nuo manęs, neatstumk supykęs savo tarno! Tu",{"noteId":244},"esi mano pagalba, neatmesk manęs ir nepalik manęs, o mano išgelbėjimo Dieve!"]},{"type":"verse","number":11,"content":["VIEŠPATIE, mokyk mane savo kelio, dėl",{"noteId":245},"mano priešų vesk mane",{"noteId":246},"lygiu taku."]},{"type":"verse","number":12,"content":["Neatiduok manęs mano priešų valiai, nes melagingi liudytojai sukilo prieš mane ir iškvepia smurtą."]},{"type":"verse","number":14,"content":["Lauk VIEŠPATIES! Būk",{"noteId":247},"stiprus, ir jis",{"noteId":248},"sutvirtins tavo širdį. Lauk, aš sakau, VIEŠPATIES!"]}],"footnotes":[{"noteId":233,"caller":"+","text":"„tvirtovė“ – Arba „prieglauda“, „stiprybės vieta“.","reference":{"chapter":27,"verse":1}},{"noteId":234,"caller":"+","text":"„prispaudėjai“ – Arba „vargintojai“, „priešininkai“ ir pan.","reference":{"chapter":27,"verse":2}},{"noteId":235,"caller":"+","text":"„užpuolė“ – T. „priėjo prieš“","reference":{"chapter":27,"verse":2}},{"noteId":236,"caller":"+","text":"„kariuomenė“ – T. „kareivių stovykla“.","reference":{"chapter":27,"verse":3}},{"noteId":237,"caller":"+","text":"„šiame dalyke – Greičiausiai aplinkybėje, kad Dievas yra tikinčiojo apsauga (Ps 27:1); galbūt karo aplinkybėje. Galima išversti įnagininku („šiuo dalyku pasitikėsiu“), kaip įprastai verčiamas hbr. prielinksnis ב (bet) su vksm. בָּטַח (batach). Reiškia, kad liksiu tikintis, kad VIEŠPATS yra mano šviesa, išgelbėjimas ir tvirtovė ir todėl nereikia bijoti žmonių.","reference":{"chapter":27,"verse":3}},{"noteId":238,"caller":"+","text":"„pasigėrėjimą“ – Arba „meilumą“, „maloningumą“, „palankų nusiteikimą“; turbūt Dovydas turėjo omeny matyti, kaip Dievas atsilieps į aukojimą, atliktą teisingu nusistatymu.","reference":{"chapter":27,"verse":4}},{"noteId":239,"caller":"+","text":"„ir“ – Arba „tai yra“.","reference":{"chapter":27,"verse":4}},{"noteId":240,"caller":"+","text":"„susikaupčiau“ – Arba „ieškočiau VIEŠPATIES veido / artumo“","reference":{"chapter":27,"verse":4}},{"noteId":241,"caller":"+","text":"„Mano širdis už tave tarė“ – Dievoto žmogaus širdis aidi Dievo noro, todėl taria „už“ jį, t. y. kartoja paties Dievo jam sakytus žodžius.","reference":{"chapter":27,"verse":8}},{"noteId":242,"caller":"+","text":"„Ieškokite“ – Arba „Norėkite“, „Prašykite“, „Siekite“.","reference":{"chapter":27,"verse":8}},{"noteId":243,"caller":"+","text":"„ieškosiu“ – Arba „norėsiu“, „prašysiu“, „sieksiu“.","reference":{"chapter":27,"verse":8}},{"noteId":244,"caller":"+","text":"„esi“ – hbr. ≈ „esi buvęs“ arba „buvai“; tiesiogiai versti į lietuvių kalbą neįmanoma; aišku, kad tebėra Dovydo pagalba, todėl vartojamas „esi“ čia.","reference":{"chapter":27,"verse":9}},{"noteId":245,"caller":"+","text":"arba: tų, kurie stebi mane.","reference":{"chapter":27,"verse":11}},{"noteId":246,"caller":"+","text":"„lygiu“ – Arba „teisumo“, „teisingu“.","reference":{"chapter":27,"verse":11}},{"noteId":247,"caller":"+","text":"„stiprus“ – Arba „drąsus“.","reference":{"chapter":27,"verse":14}},{"noteId":248,"caller":"+","text":"„sutvirtins“ – Arba „stiprins“; gal „duos drąsos“, „suteiks narsumo“.","reference":{"chapter":27,"verse":14}}]},"thisChapterLink":"/api/lit_tpv/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":9}