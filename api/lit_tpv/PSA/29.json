{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"Dovydo psalmė.","descriptive":true},"Duokite VIEŠPAČIUI, o",{"noteId":251},"Galingojo sūnūs, duokite VIEŠPAČIUI šlovę ir galybę!"]},{"type":"verse","number":2,"content":["Duokite VIEŠPAČIUI",{"noteId":252},"šlovę, priklausančią jo vardui,",{"noteId":253},"garbinkite VIEŠPATĮ",{"noteId":254},"šventumo grožyje."]},{"type":"verse","number":3,"content":["VIEŠPATIES balsas viršum vandenų! Šlovės Dievas sugriaudė. VIEŠPATS viršum didžių vandenų!"]},{"type":"verse","number":4,"content":["VIEŠPATIES balsas galingas, VIEŠPATIES balsas didingas."]},{"type":"verse","number":5,"content":["VIEŠPATIES balsas laužo kedrus, VIEŠPATS gi laužo Libano kedrus."]},{"type":"verse","number":6,"content":["Jis šokdina juos lyg veršį, šokdina Libaną ir",{"noteId":255},"Sirjoną lyg jauną laukinį jautį."]},{"type":"verse","number":7,"content":["VIEŠPATIES balsas išskelia ugnies liepsnas."]},{"type":"verse","number":8,"content":["VIEŠPATIES balsas sudrebina dykumą, VIEŠPATS sudrebina Kadešo dykumą."]},{"type":"verse","number":9,"content":["VIEŠPATIES balsas sukelia gimdymo skausmus elnėms ir daro miškus plikus, o jo šventykloje",{"noteId":256},"visi kalba apie jo šlovę."]},{"type":"verse","number":10,"content":["VIEŠPATS sėdi viršum tvano, VIEŠPATS gi sėdi kaip Karalius per amžius."]},{"type":"verse","number":11,"content":["VIEŠPATS suteiks stiprybę savo tautai! VIEŠPATS palaimins savo tautą",{"noteId":257},"taika!"]}],"footnotes":[{"noteId":251,"caller":"+","text":"„Galingojo“ – Arba „Dievo“. Kalbama angelams.","reference":{"chapter":29,"verse":1}},{"noteId":252,"caller":"+","text":"„šlovę, priklausančią jo vardui“ – Arba „jo vardo šlovę“.","reference":{"chapter":29,"verse":2}},{"noteId":253,"caller":"+","text":"„garbinkite“ – Arba „nusilenkite VIEŠPAČIUI“, „parpulkite VIEŠPAČIUI“.","reference":{"chapter":29,"verse":2}},{"noteId":254,"caller":"+","text":"„šventumo grožyje“ – žr. I Met 16:29, II Met 20:21; Ps 96:9; Ps 110:3.","reference":{"chapter":29,"verse":2}},{"noteId":255,"caller":"+","text":"„Sirjoną“ – Tai Hermono kalnas; žr. Įst 3:9.","reference":{"chapter":29,"verse":6}},{"noteId":256,"caller":"+","text":"„visi kalba apie jo šlovę“ – Arba „visa tai sako: „Šlovė!““.","reference":{"chapter":29,"verse":9}},{"noteId":257,"caller":"+","text":"„taika“ – Arba „ramybe“, „gerove“, „sėkme“.","reference":{"chapter":29,"verse":11}}]},"thisChapterLink":"/api/lit_tpv/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}