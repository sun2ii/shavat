{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Dovydo psalmė, jam bėgant nuo savo sūnaus Abšalomo veido.","descriptive":true},"O VIEŠPATIE, kaip padaugėjo mano priešų! Daug tų, kurie sukyla prieš mane!"]},{"type":"verse","number":2,"content":["Daug tų, kurie sako apie mano sielą: „Jam",{"noteId":21},"iš Dievo nėra išgelbėjimo!“ Sela."]},{"type":"verse","number":3,"content":["Bet Tu, VIEŠPATIE, esi skydas",{"noteId":22},"aplink mane, mano šlovė ir tas,",{"noteId":23},"kuris pakelia mano galvą."]},{"type":"verse","number":4,"content":["Savo balsu",{"noteId":24},"ne kartą šaukiausi VIEŠPATIES, ir jis nuo savo",{"noteId":25},"šventojo kalno",{"noteId":26},"išklausė mane. Sela."]},{"type":"verse","number":5,"content":["Aš – aš atsiguliau ir užmigau. Atsibudau, nes VIEŠPATS mane",{"noteId":27},"palaikė."]},{"type":"verse","number":6,"content":["Nebijau",{"noteId":28},"dešimt tūkstančių žmonių, kurie yra sustoję prieš mane iš visų pusių."]},{"type":"verse","number":7,"content":["Kelkis, o VIEŠPATIE! Išgelbėk mane, o mano Dieve! Juk tu visiems mano priešams smogei į žandą, nedorėlių dantis sutrupinai."]},{"type":"verse","number":8,"content":["VIEŠPAČIUI priklauso išgelbėjimas! Tavo tautai tebūna tavo palaiminimas! Sela."]}],"footnotes":[{"noteId":21,"caller":"+","text":"„iš Dievo“ – T. „Dieve“ (viet.).","reference":{"chapter":3,"verse":2}},{"noteId":22,"caller":"+","text":"„aplinka“ – Arba „padengiantis“.","reference":{"chapter":3,"verse":3}},{"noteId":23,"caller":"+","text":"„kuris pakelia mano galvą“ – T. y. kuris išvaduoja mane iš bėdų.","reference":{"chapter":3,"verse":3}},{"noteId":24,"caller":"+","text":"„ne kartą šaukiausi“ ir „išklausė mane“ – Hbr. k. veiksmažodžių forma gali rodyti į kartojamą veiksmą, arba praeityje arba dabartyje.","reference":{"chapter":3,"verse":4}},{"noteId":25,"caller":"+","text":"„šventojo“ – Arba „šventumo“.","reference":{"chapter":3,"verse":4}},{"noteId":26,"caller":"+","text":"„išklausė mane“ – Arba „atsiliepė man“.","reference":{"chapter":3,"verse":4}},{"noteId":27,"caller":"+","text":"„palaikė“ – Arba „palaiko“.","reference":{"chapter":3,"verse":5}},{"noteId":28,"caller":"+","text":"„dešimt“ – Arba „dešimčių“.","reference":{"chapter":3,"verse":6}}]},"thisChapterLink":"/api/lit_tpv/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}