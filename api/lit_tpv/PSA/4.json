{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Vyriausiajam muzikui. Su","descriptive":true},{"noteId":29},{"text":"styginiais instrumentais. Dovydo psalmė.","descriptive":true},"Kai šaukiuosi, išklausyk mane, mano teisumo Dieve! Kai būdavau prispaustas, Tu suteikdavai man erdvės. Būk man maloningas ir išgirsk mano maldą!"]},{"type":"verse","number":2,"content":["O žmonių sūnūs, kaip ilgai mano šlovę versite į gėdinimą? Kaip ilgai mylėsite tuštybę ir ieškosite to, kas melaginga? Sela."]},{"type":"verse","number":3,"content":["Bet žinokite, kad dievotąjį VIEŠPATS atskyrė sau; VIEŠPATS išgirsta, kai jo šaukiuosi."]},{"type":"verse","number":4,"content":[{"noteId":30},"Bijokite ir nenusidėkite; apmąstykite savo širdyje būdami savo lovoje ir",{"noteId":31},"nusiraminkite. Sela."]},{"type":"verse","number":5,"content":["Aukokite teisingas aukas ir pasitikėkite VIEŠPAČIU!"]},{"type":"verse","number":6,"content":["Daugelis sako: „Kas parodys mums gera? O VIEŠPATIE, pakelk virš mūsų savo veido šviesą!"]},{"type":"verse","number":7,"content":["Tu į mano širdį įdėjai daugiau džiaugsmo negu tuo metu, kai padaugėjo",{"noteId":32},"anų javų ir anų",{"noteId":33},"šviežio vyno."]},{"type":"verse","number":8,"content":["Ramus aš atsigulsiu ir taip pat užmigsiu, nes tu",{"noteId":34},"vienas, o VIEŠPATIE,",{"noteId":35},"darai taip, kad saugiai gyvenu."]}],"footnotes":[{"noteId":29,"caller":"+","text":"„styginiais instrumentais“ – Arba „rankomis grojamais instrumentais“.","reference":{"chapter":4,"verse":1}},{"noteId":30,"caller":"+","text":"„Bijokite“ – Arba „Drebėkite“.","reference":{"chapter":4,"verse":4}},{"noteId":31,"caller":"+","text":"„nusiraminkite“ – Arba „būkite ramūs“, „būkite tylūs“, t. y. baikite tuščiai ir melagingai gyvenę (žr. Ps 4:2).","reference":{"chapter":4,"verse":4}},{"noteId":32,"caller":"+","text":"„anų“ (2 k.) – T. „jų“.","reference":{"chapter":4,"verse":7}},{"noteId":33,"caller":"+","text":"„šviežio vyno“ – Hbr. „tyjroš“.","reference":{"chapter":4,"verse":7}},{"noteId":34,"caller":"+","text":"„vienas“ – Gali būti kad „vienas“ rodo į Dovydą; jeigu taip, prasmė tokia: „tu, VIEŠPATIE, užtikrini man, esančiam vienišas […]“.","reference":{"chapter":4,"verse":8}},{"noteId":35,"caller":"+","text":"„darai taip, kad saugiai gyvenu“ – Arba „užtikrini man saugų pabuvimą / apsistojimą / gyvenimą“.","reference":{"chapter":4,"verse":8}}]},"thisChapterLink":"/api/lit_tpv/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}