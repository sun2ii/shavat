{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":[{"text":"Vyriausiajam muzikui. Dovydo psalmė.","descriptive":true},"Aš",{"noteId":314},"laukte laukiau Viešpaties; jis pasilenkė prie manęs ir išgirdo mano šauksmą."]},{"type":"verse","number":2,"content":["Jis ištraukė mane iš",{"noteId":315},"triukšmingos duobės, iš klampaus dumblo, ir pastatė ant uolos mano kojas, sutvirtino mano žingsnius."]},{"type":"verse","number":3,"content":["Jis įdėjo man į burną naują giesmę – gyrių mūsų Dievui. Daugelis",{"noteId":316},"matys ir bijos, ir pasitikės VIEŠPAČIU."]},{"type":"verse","number":7,"content":["Tada tariau: „Štai ateinu! Knygos ritinyje parašyta apie mane."]},{"type":"verse","number":8,"content":["Mėgstu vykdyti tavo valią, mano Dieve, ir tavo įstatymas yra pačiame mano viduje.“"]},{"type":"verse","number":17,"content":["Nors aš",{"noteId":317},"prispaustas as ir vargingas, Viešpats galvoja apie mane. Tu mano pagalba ir mano",{"noteId":318},"išvaduotojas; mano Dieve, nedelsk!"]}],"footnotes":[{"noteId":314,"caller":"+","text":"„laukte laukiau“ – Arba „kantriai laukiau“.","reference":{"chapter":40,"verse":1}},{"noteId":315,"caller":"+","text":"„triukšmingos“ – T. „triukšmo“.","reference":{"chapter":40,"verse":2}},{"noteId":316,"caller":"+","text":"„matys“ – T. y. „supras“, „susivoks“, „susigaudys“ (šnek.).","reference":{"chapter":40,"verse":3}},{"noteId":317,"caller":"+","text":"„prispaustas“ – Arba „varguolis“, „nužemintas“, „neturtingas“.","reference":{"chapter":40,"verse":17}},{"noteId":318,"caller":"+","text":"„išvaduotojas“ – Arba „išlaisvintojas“.","reference":{"chapter":40,"verse":17}}]},"thisChapterLink":"/api/lit_tpv/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":6}