{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"Vyriausiajam muzikui. Dovydo psalmė.","descriptive":true},"Koks didžiai palaimintas tas, kuris supratingai elgiasi su",{"noteId":319},"vargšais; nelaimės dieną VIEŠPATS jį išgelbės."]},{"type":"verse","number":2,"content":["VIEŠPATS jį apsaugos ir išlaikys gyvą, jis bus palaimintas žemėje, ir",{"noteId":320},"tu jo neatiduosi į jo priešų valią."]},{"type":"verse","number":4,"content":["Sakiau: „VIEŠPATIE, pasigailėk manęs, išgydyk mano sielą, nes esu nusidėjęs tau."]},{"type":"verse","number":9,"content":["Netgi mano artimas draugas, kuriuo pasitikėjau,",{"noteId":321},"kuris valgė mano duonos, pakėlė kulną prieš mane."]}],"footnotes":[{"noteId":319,"caller":"+","text":"„vargšais“ – Hbr. kuopinis vns.","reference":{"chapter":41,"verse":1}},{"noteId":320,"caller":"+","text":"„tu jo neatiduosi“ – Arba „jo neatiduok“.","reference":{"chapter":41,"verse":2}},{"noteId":321,"caller":"+","text":"„kuris valgė …“ – Jn 13:18.","reference":{"chapter":41,"verse":9}}]},"thisChapterLink":"/api/lit_tpv/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":4}