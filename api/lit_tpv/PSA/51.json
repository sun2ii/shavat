{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":[{"text":"Vyriausiajam muzikui. Dovydo psalmė. Kai pranašas Natanas atėjo pas jį po to, kai tas buvo įėjęs pas Batšebą.","descriptive":true},"Pasigailėk manęs, o Dieve, pagal savo mielaširdystę, pagal savo meilumo apstybę išdildyk mano",{"noteId":353},"nusižengimus."]},{"type":"verse","number":2,"content":["Visai nuplauk nuo manęs mano kaltę ir nuo mano nuodėmės apvalyk mane."]},{"type":"verse","number":3,"content":["Nes aš pripažįstu savo",{"noteId":354},"nusižengimus, ir mano nuodėmė",{"noteId":355},"man yra nuolat prieš akis –"]},{"type":"verse","number":4,"content":["tau nusidėjau, tiktai tau, ir padariau, kas bloga tavo akyse, – kad būtum",{"noteId":356},"išteisintas",{"noteId":357},"kalbėdamas,",{"noteId":358},"nepeiktinas",{"noteId":359},"teisdamas."]},{"type":"verse","number":5,"content":["Štai aš buvau",{"noteId":360},"pagimdytas jau",{"noteId":361},"nukrypęs nuo to, kas teisinga, ir nuodėmingą mane pradėjo mano motina."]},{"type":"verse","number":6,"content":["Štai tu trokšti matyti tiesą žmogaus viduje, ir duosi man pažinti išmintį",{"noteId":362},"mano slaptame „aš“."]},{"type":"verse","number":7,"content":["Apvalyk mane yzopu, ir būsiu švarus, nuplauk mane, ir būsiu baltesnis už sniegą."]},{"type":"verse","number":8,"content":["Duok man išgirsti džiaugsmo ir linksmybės žinią, kad džiūgautų kaulai, kuriuos sudaužei!"]},{"type":"verse","number":9,"content":["Paslėpk savo veidą nuo mano nuodėmių ir išdildyk visas mano kaltes."]},{"type":"verse","number":10,"content":["Sukurk man tyrą širdį, o Dieve, ir",{"noteId":363},"teisingą dvasią atnaujink manyje."]},{"type":"verse","number":11,"content":["Nenumesk manęs iš savo akivaizdos, ir savo",{"noteId":364},"Šventosios Dvasios neatimk nuo manęs."]},{"type":"verse","number":12,"content":["Grąžink man džiaugsmą, kilusį iš tavo išgelbėjimo, ir paremk mane savo",{"noteId":365},"noringa Dvasia."]},{"type":"verse","number":13,"content":["Mokysiu",{"noteId":366},"nusižengėlius tavo kelių, ir nusidėjėliai",{"noteId":367},"atsivers į tave."]},{"type":"verse","number":14,"content":["Išlaisvink mane nuo kraujo kaltės, o Dieve, mano išgelbėjimo Dieve, ir mano liežuvis džiaugsmingai šūkaus apie tavo teisumą."]},{"type":"verse","number":15,"content":["O Viešpatie, praverk mano lūpas, ir mano burna skelbs tavo gyrių!"]},{"type":"verse","number":16,"content":["Nes tu",{"noteId":368},"nenori aukos, – priešingu atveju tau ją atnašaučiau, – tavęs nedžiugina deginamoji auka."]},{"type":"verse","number":17,"content":["Dievui tinkamos aukos – sudužusi dvasia; sudužusios ir palaužtos širdies tu, Dieve, nepaniekinsi."]},{"type":"verse","number":18,"content":["Savo gera valia daryk gera Sionui: pastatyk Jeruzalės sienas!"]},{"type":"verse","number":19,"content":["Tada tu būsi patenkintas teisingomis aukomis, tai yra deginamąja auka ir visai sudeginama auka, tada jaučiai bus atnašaujami ant tavo aukuro."]}],"footnotes":[{"noteId":353,"caller":"+","text":"„nusižengimus“ – Arba „maištavimus“.","reference":{"chapter":51,"verse":1}},{"noteId":354,"caller":"+","text":"„nusižengimus“ – Arba „maištavimus“.","reference":{"chapter":51,"verse":3}},{"noteId":355,"caller":"+","text":"„man yra nuolat prieš akis“ – T. „nuolat yra prieš mane“.","reference":{"chapter":51,"verse":3}},{"noteId":356,"caller":"+","text":"„išteisintas“ – T. y. „pripažintas esant nekaltinamas“.","reference":{"chapter":51,"verse":4}},{"noteId":357,"caller":"+","text":"„kalbėdamas“ – T. „savo žodžiuose“.","reference":{"chapter":51,"verse":4}},{"noteId":358,"caller":"+","text":"„nepeiktinas“ – Arba „tyras“.","reference":{"chapter":51,"verse":4}},{"noteId":359,"caller":"+","text":"„teisdamas“ – T. „savo teisime“.","reference":{"chapter":51,"verse":4}},{"noteId":360,"caller":"+","text":"„pagimdytas“ – Arba „supavidalintas“.","reference":{"chapter":51,"verse":5}},{"noteId":361,"caller":"+","text":"„nukrypęs nuo to, kas teisinga“ – Arba „nedoras“.","reference":{"chapter":51,"verse":5}},{"noteId":362,"caller":"+","text":"„mano slaptame „aš““ – T. „slaptojoje vietoje“.","reference":{"chapter":51,"verse":6}},{"noteId":363,"caller":"+","text":"„teisingą“ – Arba „tvirtą“.","reference":{"chapter":51,"verse":10}},{"noteId":364,"caller":"+","text":"„Šventosios Dvasios“ – Arba „šventumo Dvasios“. Plg. Iz 63:10-11.","reference":{"chapter":51,"verse":11}},{"noteId":365,"caller":"+","text":"„noringa“ – Gal „kilnia“, „dosnia“.","reference":{"chapter":51,"verse":12}},{"noteId":366,"caller":"+","text":"„nusižengėlius“ – Arba „maištautojus“.","reference":{"chapter":51,"verse":13}},{"noteId":367,"caller":"+","text":"„atsivers“ – Arba „atsigręš“.","reference":{"chapter":51,"verse":13}},{"noteId":368,"caller":"+","text":"„nenori aukos“ – Arba „nesigėri auka“.","reference":{"chapter":51,"verse":16}}]},"thisChapterLink":"/api/lit_tpv/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}