urėsiu prieglobstį“.","reference":{"chapter":57,"verse":1}},{"noteId":388,"caller":"+","text":"„didžiulė nelaimė“ – Hbr. „nelaimės“ (intensyvus daugiskaitinis).","reference":{"chapter":57,"verse":1}}]},"thisChapterLink":"/api/lit_tpv/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":3}