{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Vyriausiajam muzikui. Su styginiais instrumentais","descriptive":true},{"noteId":50},{"text":"pagal šeminitą. Dovydo psalmė.","descriptive":true},"O VIEŠPATIE, nebark manęs rūstaudamas, ir nedrausmink manęs įtūždamas!"]},{"type":"verse","number":2,"content":["Pasigailėk manęs, o VIEŠPATIE, nes aš silpnas; pagydyk mane, o VIEŠPATIE, nes mano kaulai sukrėsti,"]},{"type":"verse","number":3,"content":["ir mano siela labai sukrėsta! Bet tu, o VIEŠPATIE, – kiek ilgai?"]},{"type":"verse","number":4,"content":["Atsigręžk, o VIEŠPATIE! Išvaduok mano sielą! Išgelbėk mane dėl savo gailestingumo!"]},{"type":"verse","number":5,"content":["Nes mirtyje nėra tavo atminimo; kas kape tau dėkos?"]},{"type":"verse","number":6,"content":["Nuvargau",{"noteId":51},"bedejuodamas, kasnakt aptvindau savo lovą, ašaromis",{"noteId":52},"aplieju savo patalą."]},{"type":"verse","number":7,"content":["Nuo sielvarto sunyko mano",{"noteId":53},"akys, paseno dėl visų mano priešų."]},{"type":"verse","number":8,"content":["Atsitraukite nuo manęs, visi blogadariai! Nes VIEŠPATS išgirdo mano verksmo balsą."]},{"type":"verse","number":9,"content":["VIEŠPATS išgirdo mano palankumo prašymą, VIEŠPATS priima mano maldą."]},{"type":"verse","number":10,"content":["Tegul visi mano priešai susigėsta ir tebūna labai sukrėsti; tegul jie atsigręžia ir susigėsta staiga!"]}],"footnotes":[{"noteId":50,"caller":"+","text":"„pagal šeminitą“ – T. „ant aštuntojo“, kuris gali rodyti į oktavą arba boso partiją, arba gali būti kitas nurodymas, susijęs su muzikiniu atlikimu.","reference":{"chapter":6,"verse":1}},{"noteId":51,"caller":"+","text":"„bedejuodamas“ – T. „su savo dejone“.","reference":{"chapter":6,"verse":6}},{"noteId":52,"caller":"+","text":"„aplieju“ – Arba „ištirpinu“.","reference":{"chapter":6,"verse":6}},{"noteId":53,"caller":"+","text":"„akys“ – T. „akis“.","reference":{"chapter":6,"verse":7}}]},"thisChapterLink":"/api/lit_tpv/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}