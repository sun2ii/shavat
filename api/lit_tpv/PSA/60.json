{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":60,"content":[{"type":"verse","number":1,"content":[{"text":"Vyriausiajam muzikui. Atliekama pagal melodiją","descriptive":true},{"noteId":389},{"text":"„Šošanim-edut“. Dovydo","descriptive":true},{"noteId":390},{"text":"miktamas. Pamokymui. Kai jis kariavo su","descriptive":true},{"noteId":391},{"text":"Aram-naharaimais","descriptive":true},{"noteId":392},{"text":"ir","descriptive":true},{"noteId":393},{"text":"Aram-zoba ir kai Joabas apsisuko ir sumušė Druskos slėnyje dvylika tūkstančių iš Edomo.","descriptive":true},"O Dieve, tu mus atstūmei,",{"noteId":394},"ant mūsų išsiveržei, tu užsirūstinai – o",{"noteId":395},"atstatyk mus!"]},{"type":"verse","number":5,"content":["Kad tavo mylimieji būtų išvaduoti, išgelbėk savo dešine ir išklausyk mane!"]},{"type":"verse","number":12,"content":["Su Dievu mes veiksime galingai, nes jis sumindys mūsų priešus."]}],"footnotes":[{"noteId":389,"caller":"+","text":"Hbr. „Liudijimas apie lelijas“, „Liudijimo lelijos“ arba pan.","reference":{"chapter":60,"verse":1}},{"noteId":390,"caller":"+","text":"„miktamas“ – Žr. Ps 16:1 išnašą.","reference":{"chapter":60,"verse":1}},{"noteId":391,"caller":"+","text":"„Aram Naharaimais“ – „dviejų upių Aramu“ arba „dviejų upių Sirija“.","reference":{"chapter":60,"verse":1}},{"noteId":392,"caller":"+","text":"„ir“ – Arba „tai yra“.","reference":{"chapter":60,"verse":1}},{"noteId":393,"caller":"+","text":"„Aram-zoba“ – Arba „Aram-coba“; žr. IΙ Sam 8:3 ir toliau, kur kalbama apie Zobos (arba Cobos) kraštą.","reference":{"chapter":60,"verse":1}},{"noteId":394,"caller":"+","text":"„ant mūsų išsiveržei“ – Arba „mus išsklaidei“, „mus sulaužei“.","reference":{"chapter":60,"verse":1}},{"noteId":395,"caller":"+","text":"„atstatyk mus“ – „grąžink mus atgal“; gal „atsigręžk į mus vėl“; žr. Ps 23:3.","reference":{"chapter":60,"verse":1}}]},"thisChapterLink":"/api/lit_tpv/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":3}