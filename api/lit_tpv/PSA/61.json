{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":[{"text":"Vyriausiajam muzikui. Su","descriptive":true},{"noteId":396},{"text":"styginiu instrumentu. Dovydo.","descriptive":true},"O Dieve, išgirsk mano šauksmą, klausykis mano maldos!"]},{"type":"verse","number":2,"content":["Iš žemės pakraščio šaukiuosi tavęs, mano širdžiai",{"noteId":397},"alpstant – vesk mane į uolą, aukštesnę už mane!"]},{"type":"verse","number":3,"content":["Juk tu buvai ir tebesi man prieglauda ir stiprus bokštas",{"noteId":398},"gintis nuo priešo."]},{"type":"verse","number":4,"content":["Aš gyvensiu tavo padangtėje amžinai,",{"noteId":399},"liksiu bėgęs prieglaudon į tavo sparnų slėptuvę. Sela."]},{"type":"verse","number":5,"content":["Nes tu, o Dieve, girdėjai mano įžadus; tu davei man paveldą",{"noteId":400},"su tais, kurie bijo tavo vardo."]},{"type":"verse","number":6,"content":["Pridėsi dienų prie karaliaus",{"noteId":401},"gyvenimo, pridėsi metų lyg iš kartos į kartą."]},{"type":"verse","number":7,"content":["Jis",{"noteId":402},"sėdės per amžius Dievo akivaizdoje; paskirk",{"noteId":403},"gerumą ir tiesą, kurie jį apsaugos."]},{"type":"verse","number":8,"content":["Tada aš giedosiu gyrių tavo vardui per amžius, kad kasdien vykdyčiau savo įžadus."]}],"footnotes":[{"noteId":396,"caller":"+","text":"„styginiu instrumentu“ – Arba „rankomis grojamu instrumentu“.","reference":{"chapter":61,"verse":1}},{"noteId":397,"caller":"+","text":"„alpstant“ – Arba „esant jausmų užlietai“.","reference":{"chapter":61,"verse":2}},{"noteId":398,"caller":"+","text":"„gintis nuo priešo“ – T. „nuo priešo veido“.","reference":{"chapter":61,"verse":3}},{"noteId":399,"caller":"+","text":"„liksiu bėgęs prieglaudon į tavo sparnų slėptuvę“ – Arba „pasitikėsiu tavo sparnų slėptuve“.","reference":{"chapter":61,"verse":4}},{"noteId":400,"caller":"+","text":"„su tais“ – T. „tų“, bet jeigu taip išversta, gali atrodyti, kad Dievas atėmė iš vienų, kad duotų Dovydui.","reference":{"chapter":61,"verse":5}},{"noteId":401,"caller":"+","text":"„gyvenimo“ – Hbr. „dienų“.","reference":{"chapter":61,"verse":6}},{"noteId":402,"caller":"+","text":"„sėdės“ – Gal „sėdės soste“.","reference":{"chapter":61,"verse":7}},{"noteId":403,"caller":"+","text":"„gerumą“ – Arba „palankumą“, „gailestingumą“, „mielaširdystę“, „meilingą rūpinimąsi“.","reference":{"chapter":61,"verse":7}}]},"thisChapterLink":"/api/lit_tpv/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}