{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":65,"content":[{"type":"verse","number":1,"content":[{"text":"Vyriausiajam muzikui. Dovydo psalmė. Giesmė.","descriptive":true},"Gyrius",{"noteId":410},"laukia tavęs Sione, o Dieve, ir tau bus įvykdytas",{"noteId":411},"įžadas."]},{"type":"verse","number":4,"content":["Koks didžiai palaimintas žmogus, kurį tu išsirenki ir artini prie savęs, kad gyventų tavo kiemuose! Pasitenkinsime tavo namų, tavo",{"noteId":412},"šventų rūmų,",{"noteId":413},"gėrybėmis."]},{"type":"verse","number":11,"content":["Tu apvainikuoji metus savo gerumu, ir tavo vežimų provėžos trykšta riebalais."]}],"footnotes":[{"noteId":410,"caller":"+","text":"„laukia tavęs“ – Arba „tyliai laukia tavęs“, „Tau gyrius yra tylus laukimas“.","reference":{"chapter":65,"verse":1}},{"noteId":411,"caller":"+","text":"„įžadas“ – hbr. vienaskaitinis žodis, bet jei čia tai kuopinis daiktavardis, gali būti išversta „įžadai“.","reference":{"chapter":65,"verse":1}},{"noteId":412,"caller":"+","text":"„šventų rūmų“ – Arba „šventos šventyklos“.","reference":{"chapter":65,"verse":4}},{"noteId":413,"caller":"+","text":"„gėrybėmis“ – Arba „gerumu“, gal „puikumu“.","reference":{"chapter":65,"verse":4}}]},"thisChapterLink":"/api/lit_tpv/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":3}