{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":66,"content":[{"type":"verse","number":1,"content":[{"text":"Vyriausiajam muzikui.","descriptive":true},{"noteId":414},{"text":"Giesmė. Psalmė.","descriptive":true},"O",{"noteId":415},"visos šalys, kelkite džiaugsmingą skambų garsą VIEŠPAČIUI!"]},{"type":"verse","number":2,"content":["Apgiedokite jo vardo šlovę;",{"noteId":416},"girkite jį šlovingai."]},{"type":"verse","number":18,"content":["Jei būčiau",{"noteId":417},"pritaręs nedorybei savo širdyje, tai Viešpats nebūtų manęs išklausęs."]},{"type":"verse","number":20,"content":["Tebūna palaimintas Dievas, kuris neatmetė mano maldos ir neatitraukė savo gailestingumo nuo manęs."]}],"footnotes":[{"noteId":414,"caller":"+","text":"„Giesmė. Psalmė.“ – Kai abudu terminai vartojami psalmių antraštėse, galbūt „giesmė“ nurodo muzikinį kūrinį, atliekamą balsais, t. y. choru, o „psalmė“ nurodo muzikinį kūrinį, atliekamą instrumentais.","reference":{"chapter":66,"verse":1}},{"noteId":415,"caller":"+","text":"„visos šalys“ – T. „visa žemė“, „visas krašte“, „visa salie“.","reference":{"chapter":66,"verse":1}},{"noteId":416,"caller":"+","text":"„girkite jį šlovingai“ t. „padarykite jo gyrių šlovingą“.","reference":{"chapter":66,"verse":2}},{"noteId":417,"caller":"+","text":"„pritaręs“ – Hbr. „matęs“, bet prasmė yra matyti ir neimti veiksmų pašalinti.","reference":{"chapter":66,"verse":18}}]},"thisChapterLink":"/api/lit_tpv/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":4}