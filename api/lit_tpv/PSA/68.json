{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":68,"content":[{"type":"verse","number":5,"content":["Našlaičių tėvas ir našlių",{"noteId":418},"gynėjas – tai Dievas savo šventoje buveinėje."]},{"type":"verse","number":6,"content":["Dievas apgyvendina vienišus šeimose, jis išveda",{"noteId":419},"belaisvius, sukaustytus grandinėmis, bet",{"noteId":420},"maištininkams tenka gyventi išdegusioje vietovėje."]},{"type":"verse","number":9,"content":["Tu, o Dieve, siuntei gausų lietų, kuriuo tu sutvirtinai savo veldinį, kai jis buvo nuvargęs."]},{"type":"verse","number":11,"content":["Viešpats davė žodį, tos geros žinios",{"noteId":421},"pranešėjų",{"noteId":422},"būrys buvo didžiulis."]},{"type":"verse","number":19,"content":["Tebūna palaimintas Viešpats, kuris diena iš dienos",{"noteId":423},"apkrauna mus geradarystėmis; Dievas yra mūsų išgelbėjimas! Sela."]},{"type":"verse","number":20,"content":["Mūsų Dievas yra išgelbėjimo Dievas, ir JEHOVAI, Viešpačiui, priklauso išeitys iš mirties."]},{"type":"verse","number":28,"content":[{"noteId":424},"Tavo Dievas yra tavo stiprybės priežastis; pasirodyk stiprus, O Dieve",{"noteId":425},"– tu tai darei mūsų labui!"]}],"footnotes":[{"noteId":418,"caller":"+","text":"„gynėjas“ – Arba „teisėjas“ (plg. I Sam 24:15 (hbr.)).","reference":{"chapter":68,"verse":5}},{"noteId":419,"caller":"+","text":"„belaisvius, sukaustytus grandinėmis“ – Gal „belaisvius į gerovę“. Hbr. žodis, išverstas „sukaustytus grandinėmis“, vartojamas tik čia ST.","reference":{"chapter":68,"verse":6}},{"noteId":420,"caller":"+","text":"„maištininkams tenka gyventi“ – T. „maištininkai gyvena“.","reference":{"chapter":68,"verse":6}},{"noteId":421,"caller":"+","text":"„geros žinios pranešėjų“ – Hbr. mot. gim.","reference":{"chapter":68,"verse":11}},{"noteId":422,"caller":"+","text":"„būrys“ – Arba „kariuomenė“, „kareivija“.","reference":{"chapter":68,"verse":11}},{"noteId":423,"caller":"+","text":"„apkrauna mus geradarystėmis“ – T. „mūsų labui apkrauna“; gal „mus nešioja“ (plg. Iz 46:4, 63:9) arba „neša mūsų naštas“.","reference":{"chapter":68,"verse":19}},{"noteId":424,"caller":"+","text":"„Tavo Dievas yra tavo stiprybės priežastis“ – Arba „Tavo Dievas įsakė tavo stiprybei atsirasti“; arba „Dėl tavo Dievo paliepimo egzistuoja tavo stiprybė.“","reference":{"chapter":68,"verse":28}},{"noteId":425,"caller":"+","text":"„tu tai darei mūsų labui“– Arba: „tuo, ka darei musu labui!“","reference":{"chapter":68,"verse":28}}]},"thisChapterLink":"/api/lit_tpv/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":7}