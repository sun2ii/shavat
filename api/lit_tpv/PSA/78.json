{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":78,"content":[{"type":"verse","number":1,"content":[{"text":"Asafo","descriptive":true},{"noteId":445},{"text":"maskilas.","descriptive":true},"Klausykis, o mano tauta, mano įstatymo; palenkite savo ausis prie mano burnos žodžių!"]},{"type":"verse","number":2,"content":["Atversiu savo burną palyginimu, išliesiu senovės mįsles,"]},{"type":"verse","number":22,"content":["nes jie netikėjo Dievu ir",{"noteId":446},"nepasitikėjo Jo išgelbėjimu."]},{"type":"verse","number":34,"content":["Kai jis juos",{"noteId":447},"mirtinai smogė, tada jie jo ieškojo: jie gi",{"noteId":448},"atsigręžė ir",{"noteId":449},"rimtai kreipėsi į Dievą."]},{"type":"verse","number":35,"content":["Ir jie atsiminė, kad Dievas yra jų uola ir aukščiausiasis Dievas jų išpirkėjas."]},{"type":"verse","number":41,"content":["Taip, jie",{"noteId":450},"nusigręždavo ir gundydavo Dievą, ir",{"noteId":451},"apribodavo Izraelio Šventąjį."]},{"type":"verse","number":53,"content":["Ir jis saugiai juos vedė,",{"noteId":452},"todėl jie neišsigando; bet jūra",{"noteId":453},"užtvindė jų priešus."]}],"footnotes":[{"noteId":445,"caller":"+","text":"„maskilas“ – Arba „išmintis, įžvalgumas“; gal „išmintingo proto ugdymui“; ši antraštė gali būti kreipinys skaitytojui klausytis ir pasidaryti išmintingas.","reference":{"chapter":78,"verse":1}},{"noteId":446,"caller":"+","text":"„nepasitikėjo Jo išgelbėjimu“ – Arba „nebėgo prieglaudon į Jo išgelbėjimą“.","reference":{"chapter":78,"verse":22}},{"noteId":447,"caller":"+","text":"„mirtinai smogė“ – Arba „žudė“.","reference":{"chapter":78,"verse":34}},{"noteId":448,"caller":"+","text":"„atsigręžė“ – Arba „nusisuko“, „apsisuko“.","reference":{"chapter":78,"verse":34}},{"noteId":449,"caller":"+","text":"„rimtai“ – Arba „anksti“, „kol dar liko laiko“.","reference":{"chapter":78,"verse":34}},{"noteId":450,"caller":"+","text":"„nusigręždavo ir“ – Jei hbr. vksm. čia vartojama kaip prieveiksmis, gali būti išversta „vis iš naujo“, „nuolat“.","reference":{"chapter":78,"verse":41}},{"noteId":451,"caller":"+","text":"„apribodavo“ – Hbr. žodis vartojamas tik čia ST; kiti siūlomi vertimai: „supykdydavo“, „skaudindavo“.","reference":{"chapter":78,"verse":41}},{"noteId":452,"caller":"+","text":"„todėl“ t. „ir“.","reference":{"chapter":78,"verse":53}},{"noteId":453,"caller":"+","text":"„užtvindė“ – Arba „apdengė“.","reference":{"chapter":78,"verse":53}}]},"thisChapterLink":"/api/lit_tpv/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":7}