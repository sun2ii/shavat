{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":90,"content":[{"type":"verse","number":1,"content":[{"text":"Dievo vyro Mozės malda.","descriptive":true},"Viešpatie, tu",{"noteId":480},"esi mūsų",{"noteId":481},"buveinė per kartų kartas."]},{"type":"verse","number":2,"content":["Prieš gimstant kalnams ir prieš tau gimdant žemę bei pasaulį, nuo amžinybės iki amžinybės tu esi Dievas."]},{"type":"verse","number":8,"content":["Tu statei mūsų",{"noteId":482},"neteisybes prieš save, savo veido šviesoje mūsų slaptas nuodėmes."]},{"type":"verse","number":9,"content":["Nes visos mūsų dienos praslenka tau rūstaujant; mes",{"noteId":483},"eikvojame savo metus kaip atodūsį."]},{"type":"verse","number":12,"content":["Taigi pamokyk mus skaičiuoti savo dienas, kad",{"noteId":484},"priartintume savo širdis prie išminties."]},{"type":"verse","number":16,"content":["Tebūna matoma tavo tarnams tavo veikla ir jų vaikams tavo",{"noteId":485},"šlovė!"]},{"type":"verse","number":17,"content":["Ir tegul VIEŠPATIES, mūsų Dievo,",{"noteId":486},"pasigėrėjimas būna ant mūsų; ir mūsų labui",{"noteId":487},"padaryk nepajudinamą mūsų rankų darbą; taip, padaryk nepajudinamą mūsų rankų darbą."]}],"footnotes":[{"noteId":480,"caller":"+","text":"„esi“ – Arba „buvai ir tebesi“.","reference":{"chapter":90,"verse":1}},{"noteId":481,"caller":"+","text":"„buveinė“ – Gal „gyvenamoji vieta“, „gyvavimo erdvė“, „erdvė gyvenimui“; gyvenimas užtikrintas esant pas Dievą.","reference":{"chapter":90,"verse":1}},{"noteId":482,"caller":"+","text":"„neteisybes“ – Arba „kaltes“, „nedorybes“, „blogadarybes“, „kaltės vertus veiksmus“, „blogus veiksmus“; t. y. nukrypimai nuo to, kas teisinga, nuo Dievo nustatytos normos.","reference":{"chapter":90,"verse":8}},{"noteId":483,"caller":"+","text":"„eikvojame“ – Arba „baigiame“, „praleidžiame“.","reference":{"chapter":90,"verse":9}},{"noteId":484,"caller":"+","text":"„priartintume“ – Arba „atvestume“.","reference":{"chapter":90,"verse":12}},{"noteId":485,"caller":"+","text":"šlovė„“ – Arba „didybė“.","reference":{"chapter":90,"verse":16}},{"noteId":486,"caller":"+","text":"„pasigėrėjimas“ – Arba „grožybė“, „labai palankus nusiteikimas“.","reference":{"chapter":90,"verse":17}},{"noteId":487,"caller":"+","text":"„padaryk nepajudinamą“ – Arba „įtvirtink“.","reference":{"chapter":90,"verse":17}}]},"thisChapterLink":"/api/lit_tpv/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":7}