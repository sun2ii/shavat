{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"PSA","translationId":"lit_tpv","name":"Psalmynas","commonName":"Psalmynas","title":"Psalmynas","order":19,"numberOfChapters":137,"sha256":"c1e5c0957b2c3cc97cc4c342200b5667c143d534c0bb4bce72ff9ca4b0e00f37","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lit_tpv/PSA/150.json","totalNumberOfVerses":850},"chapter":{"number":91,"content":[{"type":"heading","content":["Bendra taisyklė"]},{"type":"verse","number":1,"content":["Kas gyvena Aukščiausiojo",{"noteId":488},"slaptavietėje, tas pasiliks Visagalio",{"noteId":489},"šešėlyje."]},{"type":"verse","number":2,"content":["Aš sakysiu VIEŠPAČIUI: „Mano prieglauda ir mano tvirtove, mano Dieve! Pasitikiu juo.“"]},{"type":"verse","number":4,"content":["Savo plunksnomis jis uždengs tave ir po jo sparnais turėsi prieglaudą. Jo",{"noteId":490},"tiesa yra",{"noteId":491},"didysis skydas ir",{"noteId":492},"apskritasis skydas."]},{"type":"verse","number":11,"content":["Nes jis savo angelams įsakys apie tave, kad saugotų tave visuose tavo keliuose."]},{"type":"verse","number":12,"content":["Ant rankų jie nešios tave, kad neužsigautum kojos į akmenį."]}],"footnotes":[{"noteId":488,"caller":"+","text":"„slaptavietėje“ – Hbr. žodis סֵתֶר (sether) čia nurodo padėtį, kai žmogus yra Dievo apsaugomas, „uždengtas“ taip, kad yra nepaliečiamas.","reference":{"chapter":91,"verse":1}},{"noteId":489,"caller":"+","text":"„šešėlyje“ – Arba „paūksmėje“.","reference":{"chapter":91,"verse":1}},{"noteId":490,"caller":"+","text":"„tiesa“ – Arba „patvarumas“, „tvirtumas“, „nekintamumas“, „ištikimybė“.","reference":{"chapter":91,"verse":4}},{"noteId":491,"caller":"+","text":"„didysis skydas“ – T. y. maždaug 1,2 m. aukšto skydas, kuriuo dengiamas kone visas kario kūnas.","reference":{"chapter":91,"verse":4}},{"noteId":492,"caller":"+","text":"„apskritasis skydas“ – T. y. lėkštės formos skydas, kuris dengia kario kūno vietą, į kurią dabar taikoma.","reference":{"chapter":91,"verse":4}}]},"thisChapterLink":"/api/lit_tpv/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lit_tpv/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lit_tpv/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":5}