{"translation":{"id":"lit_tpv","name":"Tikinčiųjų paveldo vertimas","website":"https://ebible.org/Scriptures/details.php?id=lit","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lit","licenseNotes":null,"shortName":"TPV","englishName":"Lithuanian Believers' Heritage Translation","language":"lit","textDirection":"ltr","sha256":"eee5c3235dc2d0ec011c1d606ee00658b1bda5d213d719939ece17020126d8a3","availableFormats":["json"],"listOfBooksApiLink":"/api/lit_tpv/books.json","numberOfBooks":66,"totalNumberOfChapters":769,"totalNumberOfVerses":7005,"languageName":"lietuvių","languageEnglishName":"Lithuanian"},"book":{"id":"REV","translationId":"lit_tpv","name":"Apreiškimas","commonName":"Apreiškimas","title":"Apreiškimas Jonui","order":66,"numberOfChapters":2,"sha256":"25edb02d471ce0b6ed708802a75a4c30a72fb715c14a30ee410c27eb2b91b7fe","firstChapterNumber":1,"firstChapterApiLink":"/api/lit_tpv/REV/1.json","lastChapterNumber":2,"lastChapterApiLink":"/api/lit_tpv/REV/2.json","totalNumberOfVerses":25},"chapter":{"number":2,"content":[{"type":"heading","content":["Laiškas Efezo miesto bažnyčiai"]},{"type":"verse","number":1,"content":[{"text":"Efezo bažnyčios angelui rašyk: Šiuos dalykus sako tas, kuris laiko savo dešinėje septynias žvaigždes, kuris vaikščioja tarp septynių auksinių žibintuvų.","wordsOfJesus":true}]},{"type":"verse","number":2,"content":[{"text":"Žinau tavo darbus ir tavo triūsą, ir tavo kantrybę, ir kaip negali pakęsti blogaširdžių, ir ištyrei tuos, kurie sakosi esą apaštalai, tačiau nėra, ir radai juos esant melagius,","wordsOfJesus":true}]},{"type":"verse","number":3,"content":[{"text":"ir nešei naštas , ir","wordsOfJesus":true},{"noteId":12},{"text":"esi ištvermingas, ir triūsei dėl mano vardo, ir","wordsOfJesus":true},{"noteId":13},{"text":"nenusilpai.","wordsOfJesus":true}]},{"type":"verse","number":4,"content":[{"text":"Bet turiu prieš tave tai, kad palikai savo pirmąją meilę.","wordsOfJesus":true}]},{"type":"verse","number":5,"content":[{"text":"Todėl prisimink, nuo kur 2:5 „esi nupuolęs“ – Gr. vksm. ἐκπίπτω (ekpíptō) yra vartojamas panašia prasme šiose eilutėse: Gal 5:4, II Pt 3:17.esi nupuolęs, ir atgailauk, ir","wordsOfJesus":true}]}],"footnotes":[{"noteId":12,"caller":"+","text":"„esi ištvermingas“ – T. „turi ištvermę“.","reference":{"chapter":2,"verse":3}},{"noteId":13,"caller":"+","text":"„nenusilpai“ – Arba „nenuvargai“, „nepailsai“.","reference":{"chapter":2,"verse":3}}]},"thisChapterLink":"/api/lit_tpv/REV/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":null,"nextChapterAudioLinks":null,"previousChapterApiLink":"/api/lit_tpv/REV/1.json","previousChapterAudioLinks":{},"numberOfVerses":5}