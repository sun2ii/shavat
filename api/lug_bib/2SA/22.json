{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"2SA","translationId":"lug_bib","name":"2 Samwiri","commonName":"2 Samwiri","title":"Ekitabo Ekiyitibwa Samwiri Ekyokubiri","order":10,"numberOfChapters":24,"sha256":"8adaf1dbb589b01c901982138cf07208e63442cc023e7e34a25325a9fe8c5439","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/lug_bib/2SA/24.json","totalNumberOfVerses":695},"chapter":{"number":22,"content":[{"type":"heading","content":["Oluyimba lwa Dawudi olw’Okutendereza"]},{"type":"verse","number":1,"content":["Awo Dawudi n’ayimbira Mukama ebigambo eby’oluyimba luno, Mukama bwe yamulokola mu mukono gw’abalabe be ne mu mukono gwa Sawulo."]},{"type":"verse","number":2,"content":["N’ayogera nti,",{"text":"“Mukama lwe lwazi lwange, era ekigo kyange era omulokozi wange;","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Katonda wange lwe lwazi lwange, omwo mwe neekweka,","poem":2},{"lineBreak":true},{"text":"ye ngabo yange era amaanyi ge bwe bulokozi bwange.","poem":2},{"text":"Kye kiddukiro kyange, mwe nneekweka era ye mulokozi wange;","poem":1},{"text":"ggwe ondokola eri abantu ababi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nkaabira Mukama asaanidde okutenderezebwa,","poem":1},{"text":"n’andokola eri abalabe bange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Amayengo ag’okufa ganzingiza;","poem":1},{"text":"embuyaga ez’okusaanawo zansaanikira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ebisiba eby’amagombe byanneetooloola;","poem":1},{"text":"n’emitego gy’okufa ne ginjolekera.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mu nnaku yange nakoowoola Mukama;","poem":1},{"text":"nakoowoola Katonda wange.","poem":2},{"text":"Yawulira eddoboozi lyange ng’ali mu yeekaalu ye;","poem":1},{"text":"n’okukaaba kwange kwamutuukako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ensi n’ekankana n’ejjugumira,","poem":1},{"text":"emisingi gy’eggulu ne ginyeenyezebwa,","poem":2},{"lineBreak":true},{"text":"ne gikankanyizibwa kubanga yali asunguwadde.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Omukka ne gunyooka okuva mu nnyindo ze,","poem":1},{"text":"n’omuliro ne guva mu kamwa ke,","poem":2},{"lineBreak":true},{"text":"n’amanda agaaliko omuliro ne gava mu ye.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yayabuluza eggulu n’akka wansi;","poem":1},{"text":"ebire ebikutte nga biri wansi w’ebigere bye.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne yeebagala kerubi n’abuuka,","poem":1},{"text":"n’aseeyeeyeza ku biwaawaatiro by’empewo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yafuula ekizikiza ekyamwetooloolanga okuba enkuufiira,","poem":1},{"text":"n’ebire ebikutte okuba ekitaba ky’amazzi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Okumasamasa okwali mu maaso ge","poem":1},{"text":"kwayakisa amanda ag’omuliro.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mukama yabwatuka ng’asinziira mu ggulu;","poem":1},{"text":"Ali Waggulu Ennyo n’ayogera mu ddoboozi lye.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yalasa obusaale n’asaasaanya abalabe","poem":1},{"text":"n’okumyansa okw’eggulu, n’abawangula.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ebiwonvu eby’omu nnyanja ne bibikkulwa","poem":1},{"text":"n’emisingi gy’ensi ne gyeruka","poem":2},{"text":"olw’okunenya kwa Mukama","poem":1},{"text":"n’olw’okubwatuka kw’omukka ogw’omu nnyindo ze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Yasinzira waggulu n’antwala","poem":1},{"text":"n’ansika mu mazzi amangi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yamponya abalabe bange ab’amaanyi abankyawa,","poem":1},{"text":"abo abaali bansinza amaanyi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bannumba mu nnaku yange","poem":1},{"text":"naye Mukama n’ampanirira.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yandeeta mu kifo ekigazi;","poem":1},{"text":"yandokola kubanga yansanyukira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Mukama yampa empeera yange ng’obutuukirivu bwange bwe bwali;","poem":1},{"text":"n’ansasula ng’obulongoofu bwe ngalo zange bwe buli.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ntambulidde mu kkubo lya Mukama,","poem":1},{"text":"era sivanga ku Katonda wange okukola ebitali bya butuukirivu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Amateeka ge gonna gaali mu maaso gange,","poem":1},{"text":"era ssaava ku biragiro bye.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Sizzanga na musango mu maaso ge,","poem":1},{"text":"era neekuumye eri obutali butuukirivu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mukama kyavudde ansasula ng’obutuukirivu bwange bwe buli,","poem":1},{"text":"era ng’obulongoofu bwange bwe buli mu maaso ge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Eri abeesigwa weeraga okuba omwesigwa;","poem":1},{"text":"n’eri abatalina musango ne weeraga obutaba na musango;","poem":2}]},{"type":"verse","number":27,"content":[{"text":"eri omulongoofu weeraga okuba omulongoofu","poem":1},{"text":"n’eri omukujjukujju ne weeraga okuba omukujjukujju okumusinga.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Olokola abantu abawombeefu,","poem":1},{"text":"naye amaaso go ganoonya ab’amalala n’obakkakkanya.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Oli ttaala yange, Ayi Mukama","poem":1},{"text":"era Mukama wange yammulisiza mu nzikiza yange.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ku lulwe mpangula eggye,","poem":1},{"text":"era ku lwa Katonda wange mbuuka bbugwe.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ekkubo lya Katonda golokofu,","poem":1},{"text":"n’ekigambo kye kituukirira;","poem":2},{"text":"era ngabo eri abo bonna","poem":1},{"text":"abaddukira gy’ali.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Kubanga ani Katonda wabula Mukama,","poem":1},{"text":"era ani lwazi okuggyako Katonda waffe?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Katonda kye kiddukiro kyange,","poem":1},{"text":"era alongoosa ekkubo lyange.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ebigere byange abifuula okuba ng’eby’ennangaazi,","poem":1},{"text":"era ampanirira mu bifo ebya waggulu.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Anteekateeka okulwana entalo,","poem":1},{"text":"era n’ansobozesa okulasa obusaale obw’ebikomo.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ompadde engabo ey’obulokozi bwo,","poem":1},{"text":"ne weefeebya ne wessa wansi olyoke onfuule ow’ekitiibwa.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Ogaziyizza ekkubo mwe mpita,","poem":1},{"text":"n’obukongovvule bwange tebukoonagana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"“Nagoba abalabe bange ne mbazikiriza,","poem":1},{"text":"so saakyuka kudda mabega okutuusa lwe baamalibwawo.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Na babetentera ddala ne batayinza kuyimuka,","poem":1},{"text":"era bali wansi w’ebigere byange.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Wampa amaanyi okulwana entalo,","poem":1},{"text":"n’oteeka abo abanjigganya wansi wange.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Waleetera abalabe bange okunziruka,","poem":1},{"text":"ne nsanyaawo abo abankyawa.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Baalindirira okuyambibwa naye ne wataba n’omu ababeera,","poem":1},{"text":"ne bakaabira Mukama, naye n’atabaanukula.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Nabasekulasekula ne bafuuka ng’enfuufu ey’oku nsi,","poem":1},{"text":"ne mbabetenta, ne mbalinnyirira ne bafuuka ng’ebitosi eby’omu nguudo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"“Ondokodde mu nnumbagana ez’abantu bange,","poem":1},{"text":"n’onfuula omukulu w’amawanga;","poem":2},{"text":"abantu be saamanya be bampeereza.","poem":1}]},{"type":"verse","number":45,"content":[{"text":"Bannaggwanga bajja gye ndi nga beegayirira,","poem":2},{"lineBreak":true},{"text":"bwe bawulira eddoboozi lyange ne baŋŋondera.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Bonna baggwaamu omwoyo,","poem":1},{"text":"ne bajja nga bakankana okuva gye beekwese.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“Mukama mulamu! Olwazi lwange yeebazibwe.","poem":1},{"text":"Agulumizibwe Katonda wange, olwazi lwange, era obulokozi bwange.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Oyo ye Katonda ampalanira eggwanga,","poem":1},{"text":"era ateeka amawanga wansi wange;","poem":2}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"anziggya mu balabe bange.","poem":2},{"text":"Wangulumiza okusinga abalabe bange,","poem":1},{"text":"n’ondokola okuva mu basajja abakambwe.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Kyenaava nkutenderezanga, Ayi Mukama Katonda, mu mawanga gonna,","poem":1},{"text":"era nnaayimbanga nga ntendereza erinnya lyo.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Kabaka we amuwadde obuwanguzi obw’amaanyi,","poem":1},{"text":"era alaze okwagala okutayogerekeka eri oyo gwe yafukako amafuta,","poem":2},{"lineBreak":true},{"text":"eri Dawudi n’ezzadde lye emirembe gyonna.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}