{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"AMO","translationId":"lug_bib","name":"Amosi","commonName":"Amosi","title":"Ekitabo Ekiyitibwa Amosi","order":30,"numberOfChapters":9,"sha256":"ffc5260d1a7100dc9e7ca01b41a9b2522f90939bd05323828971aa3d39c1dd78","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/lug_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Bino bye bigambo Amosi eyali omu ku balunzi b’endiga mu bitundu by’e Tekowa bye yabikkulirwa, musisi amale ajje nga wakayitawo emyaka ebiri, mu mirembe gya Uzziya kabaka wa Yuda, era nga gy’emirembe gya kabaka Yerobowaamu mutabani wa Yowaasi nga y’afuga Isirayiri."]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":["Amosi yagamba nti,",{"text":"“Mukama awuluguma ng’asinziira mu Sayuuni,","poem":1},{"text":"era eddoboozi lye liwulirwa nga libwatukira mu Yerusaalemi;","poem":2},{"text":"omuddo mu malundiro gulikala","poem":1},{"text":"n’entikko y’olusozi Kalumeeri erisigala njereere.”","poem":2}]},{"type":"heading","content":["Okulamulwa kwa Baliraanwa ba Isirayiri"]},{"type":"verse","number":3,"content":["Bw’ati bw’ayogera Mukama nti,",{"text":"“Olw’ebyonoono bya Ddamasiko ebisatu,","poem":1},{"text":"weewaawo ebina, siriggyawo busungu bwange.","poem":2},{"text":"Kubanga baabonereza nnyo abantu b’e Gireyaadi","poem":1},{"text":"nga babasalaasala n’ebyuma.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndiweereza omuliro mu lubiri lwa kabaka Kazayeeri","poem":1},{"text":"era njokye n’ebigo bya kabaka Benikadadi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Era ndimenya enzigi z’ekibuga Ddamasiko","poem":1},{"text":"era ndizikiriza kabaka ali mu Kiwonvu ky’e Aveni,","poem":2},{"text":"oyo akwata omuggo ogw’obwakabaka mu Besiadeni.","poem":1},{"text":"Abantu b’e Busuuli balitwalibwa mu buwaŋŋanguse mu Kiri,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":6,"content":["Bw’ati bw’ayogera Mukama nti,",{"text":"“Olw’ebyonoono bya Gaza ebisatu,","poem":1},{"text":"weewaawo ebina, siriggyawo busungu bwange.","poem":2},{"text":"Kubanga yatwala eggwanga ddamba mu busibe","poem":1},{"text":"n’alitunda eri Edomu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndiweereza omuliro ku bbugwe wa Gaza","poem":1},{"text":"ogulyokya ebigo byakyo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndizikiriza atuula mu Asudodi,","poem":1},{"text":"n’oyo akwata omuggo gw’obwakabaka ndimumalawo okuva mu Asukulooni.","poem":2},{"text":"Ndibonereza Ekuloni","poem":1},{"text":"okutuusa lwe ndimalirawo ddala Abafirisuuti,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":9,"content":["Mukama bw’ati bw’ayogera nti,",{"text":"“Olw’ebyonoono bya Ttuulo ebisatu,","poem":1},{"text":"weewaawo ebina, siriggyawo busungu bwange.","poem":2},{"text":"Kubanga yatunda eggwanga ddamba erya Edomu mu busibe","poem":1},{"text":"n’amenya endagaano ey’obwaseruganda eyali ekoleddwa,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"kyenaava mpeereza omuliro ku bbugwe wa Ttuulo,","poem":1},{"text":"ogunaayokya ebigo byakyo.”","poem":2}]},{"type":"verse","number":11,"content":["Bw’ati bw’ayogera Mukama nti,",{"text":"“Olw’ebyonoono bya Edomu ebisatu,","poem":1},{"text":"weewaawo ebina, siriggyawo busungu bwange.","poem":2},{"text":"Kubanga yayigganya muganda we n’ekitala","poem":1},{"text":"awatali kusaasira,","poem":2},{"text":"obusungu bwabwe ne bubuubuuka obutakoma","poem":1},{"text":"era ne batabusalako.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndiweereza omuliro ku Temani","poem":1},{"text":"oguliyokya ebigo bya Bozula.”","poem":2}]},{"type":"verse","number":13,"content":["Bw’ati bw’ayogera Mukama nti,",{"text":"“Olw’ebyonoono bya Amoni ebisatu","poem":1},{"text":"weewaawo ebina, siriggyawo busungu bwange.","poem":2},{"text":"Mu ntalo ez’okugaziya ensi ye,","poem":1},{"text":"yabaaga abakazi abaali embuto ab’e Giriyaadi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndiweereza omuliro ku bbugwe wa Labba,","poem":1},{"text":"era gulyokya ebigo byakyo.","poem":2},{"text":"Walibaawo n’oluyoogaano olunene ku lunaku olw’olutalo","poem":1},{"text":"mu mpewo ey’amaanyi, kibuyaga ng’akunta.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kabaka waakyo alitwalibwa mu buwaŋŋanguse,","poem":1},{"text":"ye n’abakungu be bonna,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}