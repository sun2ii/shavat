{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"AMO","translationId":"lug_bib","name":"Amosi","commonName":"Amosi","title":"Ekitabo Ekiyitibwa Amosi","order":30,"numberOfChapters":9,"sha256":"ffc5260d1a7100dc9e7ca01b41a9b2522f90939bd05323828971aa3d39c1dd78","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/lug_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Bw’ati bw’ayogera Mukama nti,",{"text":"“Olw’ebyonoono bya Mowaabu ebisatu","poem":1},{"text":"weewaawo ebina, siriggyawo busungu bwange.","poem":2},{"text":"Kubanga yayokya amagumba ga kabaka wa Edomu","poem":1},{"text":"ne gafuuka evvu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndiweereza omuliro ku Mowaabu","poem":1},{"text":"era gulyokya ebigo bya Keriyoosi.","poem":2},{"text":"Abantu ba Mowaabu balifiira","poem":1},{"text":"wakati mu kusasamala okungi omuliba okuleekaana n’okufuuwa amakondeere.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndizikiriza omukulembeze wa Mowaabu","poem":1},{"text":"n’abakungu baamu bonna, ndibatta,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bw’ati bw’ayogera Mukama nti,","poem":1},{"lineBreak":true},{"text":"“Olw’ebyonoono bya Yuda ebisatu","poem":1},{"text":"weewaawo ebina, siriggyawo busungu bwange.","poem":2},{"text":"Kubanga banyoomye amateeka ga Mukama,","poem":1},{"text":"ne batakuuma biragiro bye nabawa","poem":2},{"text":"ne bagondera bakatonda ab’obulimba","poem":1},{"text":"bajjajjaabwe be baagobereranga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndiweereza omuliro ku Yuda","poem":1},{"text":"ne njokya ebigo bya Yerusaalemi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bw’ati bw’ayogera Mukama nti,","poem":1},{"lineBreak":true},{"text":"“Olw’ebyonoono bya Isirayiri ebisatu","poem":1},{"text":"weewaawo ebina, siriggyawo busungu bwange.","poem":2},{"text":"Batunda obutuukirivu bafune ffeeza,","poem":1},{"text":"ne batunda n’abaavu olw’omugogo gw’engatto.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Balinnyiririra emitwe gy’abaavu","poem":1},{"text":"mu nfuufu,","poem":2},{"lineBreak":true},{"text":"n’abajoogebwa ne batalamulwa mu bwenkanya.","poem":2},{"text":"Omwana ne kitaawe bayingira eri omuwala omu","poem":1},{"text":"ne boonoona erinnya lyange.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bagalamira okumpi ne buli kyoto","poem":1},{"text":"ku ngoye ezaweebwayo ng’obweyamo.","poem":2},{"text":"Mu nnyumba ya bakatonda baabwe","poem":1},{"text":"mwe banywera omwenge oguleetebwa abatanziddwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Nazikiriza Abamoli ku lwabwe","poem":1},{"text":"newaakubadde nga baali bawanvu ng’emivule","poem":2},{"lineBreak":true},{"text":"era nga ba maanyi ng’emyera.","poem":2},{"text":"Nazikiriza ebibala ebyali waggulu","poem":1},{"text":"okutuuka ku mirandira egyali wansi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nakuggya mu nsi y’e Misiri,","poem":1},{"text":"ne nkukulemberera emyaka amakumi ana mu ddungu,","poem":2},{"lineBreak":true},{"text":"weetwalire ensi y’Abamoli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Nayimusa abamu ku batabani bammwe okubeera bannabbi,","poem":1},{"text":"ne ku balenzi bammwe okuba Abawonge ba Mukama.","poem":2},{"text":"Si bwe kiri bwe kityo abantu ba Isirayiri?”","poem":1},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Naye mmwe ne mudda mu kuwa Abawonge ba Mukama omwenge okunywa,","poem":1},{"text":"ne muwa bannabbi amateeka nga mubagamba nti temuwa byabunnabbi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Laba, ndibasesebbula","poem":1},{"text":"ng’eggaali eryettisse ebinywa by’emmere ey’empeke bwe lisesebbula ekiri mu kkubo lyalyo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abanguwa tebaliwona,","poem":1},{"text":"n’ab’amaanyi tebalikuŋŋaanya maanyi gaabwe","poem":2},{"lineBreak":true},{"text":"era n’omuzira nnamige talisobola kuwonya bulamu bwe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Omukubi w’obusaale omukugu taliyimirira kunywera,","poem":1},{"text":"n’omuserikale ow’ebigere nnakinku talisobola kuwenyuka.","poem":2},{"lineBreak":true},{"text":"Abo abasajja abazira abeebagazi b’embalaasi tebalisobola kuwonya bulamu bwabwe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ku lunaku olwo abalwanyi abazira nnamige","poem":1},{"text":"balidduka bukunya!”","poem":2},{"lineBreak":true},{"text":"bw’atyo bw’ayogera Mukama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}