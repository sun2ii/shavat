{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"AMO","translationId":"lug_bib","name":"Amosi","commonName":"Amosi","title":"Ekitabo Ekiyitibwa Amosi","order":30,"numberOfChapters":9,"sha256":"ffc5260d1a7100dc9e7ca01b41a9b2522f90939bd05323828971aa3d39c1dd78","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/lug_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"heading","content":["Okulabula Abantu ba Isirayiri"]},{"type":"verse","number":1,"content":["Muwulire ekigambo kino Mukama ky’aboogerako mmwe abaana ba Isirayiri, ennyumba yonna gye naggya mu Misiri."]},{"type":"verse","number":2,"content":[{"text":"“Mu bantu bonna abali ku nsi,","poem":1},{"text":"mmwe mwekka be nalonda.","poem":2},{"text":"Kyendiva mbabonereza","poem":1},{"text":"olw’ebibi byammwe byonna.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abantu ababiri bayinza okutambulira awamu","poem":1},{"text":"wabula nga bakkiriziganyizza?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Empologoma ewulugumira mu kisaka","poem":1},{"text":"nga terina muyiggo?","poem":2},{"text":"Empologoma ento ekaabira mu mpuku yaayo","poem":1},{"text":"nga teriiko ky’ekutte?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Akanyonyi kayinza okugwa mu mutego","poem":1},{"text":"nga tewali kikasikirizza?","poem":2},{"text":"Omutego gumasuka","poem":1},{"text":"nga teguliiko kye gukwasizza?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Akagombe kavugira mu kibuga","poem":1},{"text":"abantu ne batatya?","poem":2},{"text":"Akabenje kagwa mu kibuga","poem":1},{"text":"nga Mukama si y’akaleese?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Naye ddala Mukama Katonda takola kintu kyonna","poem":1},{"text":"nga tasoose kukibikkulira","poem":2},{"lineBreak":true},{"text":"baweereza be, bannabbi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Empologoma ewulugumye,","poem":1},{"text":"ani ataatye?","poem":2},{"text":"Mukama Katonda ayogedde","poem":1},{"text":"ani ataawe bubaka bwe?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Langirira eri ebigo by’e Asudodi","poem":1},{"text":"n’eri ebigo by’e Misiri nti,","poem":2},{"text":"“Mujje mukuŋŋaanire ku nsozi z’e Samaliya","poem":1},{"text":"mulabe akajagalalo akanene akali eyo","poem":2},{"lineBreak":true},{"text":"n’abantu be nga bwe bajoogebwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mukama agamba nti, “Abantu abajjuzza","poem":1},{"text":"ebigo byabwe n’ebintu ebinyage,","poem":2},{"lineBreak":true},{"text":"tebamanyi kukola kituufu.”","poem":2}]},{"type":"verse","number":11,"content":["Noolwekyo bw’ati bw’ayogera Mukama Katonda nti,",{"text":"“Omulabe alirumba ensi,","poem":1},{"text":"n’amenyaamenya ebigo byo eby’amaanyi","poem":2},{"lineBreak":true},{"text":"era n’abinyagulula.”","poem":2}]},{"type":"verse","number":12,"content":["Bw’ati bw’ayogera Mukama nti,",{"text":"“Ng’omusumba bw’agezaako okutaasa endiga ye okuva mu kamwa k’empologoma","poem":1},{"text":"n’asikayo amagulu abiri obubiri n’ekitundu ky’okutu,","poem":2},{"lineBreak":true},{"text":"bwe batyo Abayisirayiri bwe balinunulibwa,","poem":2},{"text":"abo abatuula mu Samaliya","poem":1},{"text":"ku nkomerero y’ebitanda byabwe","poem":2},{"lineBreak":true},{"text":"ne ku bitanda byabwe mu Ddamasiko.","poem":2}]},{"type":"verse","number":13,"content":["“Muwulirize kino era mulumirize enju ya Yakobo yonna,” bw’ayogera Mukama Katonda Ayinzabyonna."]},{"type":"verse","number":14,"content":[{"text":"“Ku lunaku lwe lumu lwe ndibonereza Isirayiri olw’ebibi bye,","poem":1},{"text":"ndisaanyaawo ebyoto by’e Beseri,","poem":2},{"text":"n’amayembe g’ekyoto galisalibwako","poem":1},{"text":"ne gagwa wansi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Era ndisaanyaawo ennyumba ebeerwamu mu biseera eby’obutiti,","poem":1},{"text":"awamu n’ennyumba ebeerwamu mu biseera ey’ebbugumu;","poem":2},{"text":"era ndimenyaamenya n’ennyumba ezayolebwa n’amasanga,","poem":1},{"text":"ne nsanyaawo n’embiri,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}