{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"AMO","translationId":"lug_bib","name":"Amosi","commonName":"Amosi","title":"Ekitabo Ekiyitibwa Amosi","order":30,"numberOfChapters":9,"sha256":"ffc5260d1a7100dc9e7ca01b41a9b2522f90939bd05323828971aa3d39c1dd78","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/lug_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":4,"content":[{"type":"heading","content":["Katonda Yeerayirira Okuzikiriza Abantu"]},{"type":"verse","number":1,"content":[{"text":"Muwulire kino mmwe ente ez’omu Basani ezibeera ku Lusozi Samaliya,","poem":1},{"text":"mmwe abakazi abajooga abaavu ne munyigiriza abanaku,","poem":2},{"lineBreak":true},{"text":"era abagamba ba bbaabwe nti, “Mutuletereyo ekyokunywa.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mu butukuvu bwe Mukama Katonda alayidde nti,","poem":1},{"text":"“Ekiseera kijja","poem":2},{"text":"lwe balibasika n’amalobo,","poem":1},{"text":"era abalisembayo ku mmwe ne basikibwa n’amalobo agavuba.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mulisikibwa okuva mu mayumba gammwe","poem":1},{"text":"ne musuulibwa ebweru nga muyisibwa mu bituli ebibotoddwa mu bbugwe,","poem":2},{"lineBreak":true},{"text":"musuulibwe ku Kalumooni,","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kale mmwe mugende e Beseri mukoleyo ebitasaana;","poem":1},{"text":"era mugende ne Girugaali mwongere okukola ebibi.","poem":2},{"text":"Mutwalengayo ssaddaaka zammwe buli nkya,","poem":1},{"text":"n’ekimu eky’ekkumi buli myaka esatu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Muweeyo ekiweebwayo eky’okwebaza eky’emigaati egizimbulukusibbwa,","poem":1},{"text":"mulangirire n’ebiweebwayo eby’ekyeyagalire;","poem":2},{"text":"mwe mwenyumiririza, mmwe Abayisirayiri","poem":1},{"text":"kubanga ekyo kye mwagala,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda Ayinzabyonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Nabaleetera enjala embuto zammwe ne ziba njereere mu buli kibuga,","poem":1},{"text":"ne ssibawa kyakulya mu buli kabuga,","poem":2},{"lineBreak":true},{"text":"naye era ne mugaana okudda gye ndi,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ne mbamma enkuba","poem":1},{"text":"ng’ekyabulayo emyezi esatu amakungula gatuuke.","poem":2},{"text":"Ne ntonnyesa enkuba mu kibuga ekimu","poem":1},{"text":"ne ngiziyiza mu kirala.","poem":2},{"text":"Yatonnyanga mu nnimiro emu,","poem":1},{"text":"mu ndala n’etatonnya, ebirime ne biwotoka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abantu ne bavanga mu kibuga ekimu ne balaga mu kirala nga banoonya amazzi banyweko,","poem":1},{"text":"naye ne gababula;","poem":2},{"lineBreak":true},{"text":"naye era ne mutakyuka kudda gye ndi,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Emirundi mingi ebirime byammwe n’ennimiro zammwe ez’emizabbibu na bigengewaza.","poem":1},{"text":"Nabileetako obulwadde.","poem":2},{"text":"Enzige nazo ne zirya emitiini gyammwe n’emizeeyituuni gyammwe,","poem":1},{"text":"naye era temwadda gye ndi,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Nabasindikira kawumpuli","poem":1},{"text":"nga gwe nasindika mu Misiri.","poem":2},{"text":"Abavubuka bammwe ne mbattira mu lutalo n’ekitala","poem":1},{"text":"awamu n’embalaasi zammwe ze mwawamba.","poem":2},{"text":"Okuwunya kw’olusisira lwammwe ne kuyitirira nnyo","poem":1},{"text":"naye era ne mugaana okudda gye ndi,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Nazikiriza abamu ku mmwe","poem":1},{"text":"nga bwe nakola Sodomu ne Ggomola,","poem":2},{"text":"ne muba ng’olumuli olusikiddwa mu muliro ogwaka","poem":1},{"text":"naye era ne mulema okudda gye ndi,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Kyendiva nkukola bwe ntyo, ggwe Isirayiri,","poem":1},{"text":"era ndikwongerako ebibonoobono.","poem":2},{"lineBreak":true},{"text":"Noolwekyo weetegeke okusisinkana Katonda wo, ggwe Isirayiri.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kubanga laba, oyo eyatonda ensozi","poem":1},{"text":"era ye yatonda n’embuyaga","poem":2},{"lineBreak":true},{"text":"era abikkulira omuntu ebirowoozo bye.","poem":2},{"text":"Yafuula enkya okubeera ekiro,","poem":1},{"text":"era alinnya mu bifo ebigulumivu eby’ensi.","poem":2},{"lineBreak":true},{"text":"Mukama Katonda ow’Eggye lye linnya lye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}