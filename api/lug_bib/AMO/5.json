{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"AMO","translationId":"lug_bib","name":"Amosi","commonName":"Amosi","title":"Ekitabo Ekiyitibwa Amosi","order":30,"numberOfChapters":9,"sha256":"ffc5260d1a7100dc9e7ca01b41a9b2522f90939bd05323828971aa3d39c1dd78","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/lug_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["Okukuba Omulanga ogw’Okukungubaga n’Okwenenya mu Isirayiri"]},{"type":"verse","number":1,"content":["Muwulirize mmwe abantu ba Isirayiri ekigambo kino eky’ennaku ekibakwatako."]},{"type":"verse","number":2,"content":[{"text":"“Isirayiri embeerera agudde","poem":1},{"text":"obutayimuka nate.","poem":2},{"text":"Bamwabulidde","poem":1},{"text":"era tewali amuyimusa.”","poem":2}]},{"type":"verse","number":3,"content":["Bw’ati bw’ayogera Mukama Katonda nti,",{"text":"“Ekibuga ekiyungula abalwanyi olukumi okugenda mu lutalo","poem":1},{"text":"kirisigazaawo kikumi bokka,","poem":2},{"text":"n’ekyo ekiweereza ekikumi,","poem":1},{"text":"kirizza kkumi bokka!”","poem":2}]},{"type":"verse","number":4,"content":["Bw’ati bw’ayogera Mukama eri ennyumba ya Isirayiri nti,",{"text":"“Munnoonye kale munaabanga balamu.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Temunnoonyeza Beseri","poem":2},{"text":"so temulaga Girugaali","poem":1},{"text":"wadde okulaga e Beeruseba.","poem":2},{"text":"Kubanga abantu b’e Girugaali balitwalibwa mu buwaŋŋanguse","poem":1},{"text":"era ne Beseri kiriggwaawo.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Munoonye Mukama munaabanga balamu","poem":1},{"text":"aleme okubuubuuka ng’omuliro ku nnyumba ya Yusufu;","poem":2},{"text":"guligyokya","poem":1},{"text":"nga tewali wa kuguzikiza mu Beseri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mmwe abantu ba Isirayiri abafuula obwenkanya okuba eky’okufumwa obufumwa","poem":1},{"text":"mutulugunya obutuukirivu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Oyo eyakola ettendo eriri mu mmunyeenye ezaaka ng’ebizungirizi","poem":1},{"text":"era afuula ekisiikirize okubeera enkya","poem":2},{"lineBreak":true},{"text":"era akyusa obudde ne buva mu kitangaala ne bufuuka ekiro,","poem":2},{"text":"ayita amazzi g’omu nnyanja","poem":1},{"text":"ne gafukirira ensi ng’enkuba,","poem":2},{"lineBreak":true},{"text":"Mukama lye linnya lye.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Okutemya n’okuzibula aleeta okuzikirira ku b’amaanyi","poem":1},{"text":"era n’asaanyaawo ebibuga ebiriko ebigo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mukyawa abalamuzi abasalawo mu bwenkanya","poem":1},{"text":"era munyooma n’abo aboogera amazima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Olinnyirira omwavu,","poem":1},{"text":"n’omuwaliriza okukuwa emmere ey’empeke.","poem":2},{"text":"Newaakubadde nga mwezimbidde amayumba ag’amayinja,","poem":1},{"text":"temuligabeeramu;","poem":2},{"text":"era newaakubadde nga mwesimbidde ennimiro z’emizabbibu ennungi,","poem":1},{"text":"temulinywa ku wayini waamu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ebibi byammwe mbimanyi,","poem":1},{"text":"nga bingi ate nga bisasamaza.","poem":2},{"lineBreak":true},{"text":"Munyigiriza omutuukirivu ne mulya n’enguzi,","poem":1},{"text":"abaavu temubasalira musango mu bwenkanya.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Noolwekyo oyo alina amagezi kyaliva asirika obusirisi mu biseera ng’ebyo","poem":1},{"text":"kubanga ennaku mbi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Munoonyenga okukola obulungi, so si obubi","poem":1},{"text":"munaabeeranga balamu!","poem":2},{"text":"Bw’atyo Mukama Katonda ow’Eggye anaabeeranga mubeezi wammwe","poem":1},{"text":"nga bulijjo bwe mumuyita.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mukyawe ekibi, mwagalenga ekirungi","poem":1},{"text":"era embuga z’amateeka zibeerengamu obwenkanya.","poem":2},{"text":"Oboolyawo Mukama Katonda ow’Eggye anaabakwatirwa ekisa","poem":1},{"text":"abantu abo abaasigalawo ku Yusufu.","poem":2}]},{"type":"verse","number":16,"content":["Noolwekyo bw’ati bw’ayogera Mukama Katonda ow’Eggye nti,",{"text":"“Walibeerawo okwaziirana mu nguudo","poem":1},{"text":"n’okukaaba mu buli kibangirizi eky’omu kibuga.","poem":2},{"text":"N’abalimi baliyitibwa, bakaabe,","poem":1},{"text":"n’abakungubazi bakube ebiwoobe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Walibaawo okukaaba mu buli nnimiro ya mizabbibu","poem":1},{"text":"kubanga nzija okuyita wakati mu mmwe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Zibasanze mmwe abasuubira","poem":1},{"text":"olunaku lwa Mukama.","poem":2},{"text":"Lwaki mwesunga olunaku lwa Mukama?","poem":1},{"text":"Olunaku olwo luliba kizikiza so si kitangaala.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Olunaku olwo lulibeera ng’omusajja adduka empologoma","poem":1},{"text":"n’asisinkana eddubu,","poem":2},{"text":"bw’aba ng’ayingira mu nnyumba","poem":1},{"text":"ne yeekwata ku kisenge,","poem":2},{"lineBreak":true},{"text":"ate n’abojjebwa omusota.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Olunaku lwa Mukama, teruliba kizikiza awatali kitangaala n’akatono,","poem":1},{"text":"ng’ekizikiza ekikutte ennyo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Nkyawa, era nnyooma embaga zammwe n’emikolo gyammwe egy’eddiini","poem":1},{"text":"so sisanyukira kukuŋŋaana kwammwe.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Weewaawo, ne bwe munaawaayo gye ndi ebiweebwayo byammwe ebyokebwa n’ebiweebwayo eby’emmere ey’empeke,","poem":1},{"text":"sijja kubikkiriza.","poem":2},{"text":"Ne bwe mulireeta ebiweebwayo olw’emirembe ebisinga obulungi,","poem":1},{"text":"siribikkiriza.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Muggyeewo ennyimba zammwe ez’okutendereza.","poem":1},{"text":"Siriwuliriza na bivuga ng’entongooli zammwe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kye njagala okulaba ge mazima n’obwenkanya nga bikulukuta ng’amazzi,","poem":1},{"text":"n’obutuukirivu nga bukulukuta ng’omugga ogw’amaanyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Mwandeeteranga ssaddaaka n’ebiweebwayo mu ddungu","poem":1},{"text":"emyaka gyonna amakumi ana, ggw’ennyumba ya Isirayiri?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Muyimusizza essabo lya kabaka wammwe,","poem":1},{"text":"amaanyi ga bakatonda bammwe,","poem":2},{"lineBreak":true},{"text":"n’emmunyeenye ya katonda wammwe,","poem":2},{"lineBreak":true},{"text":"bye mwekolera mmwe.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kyendiva mbawaŋŋangusa okusukka Ddamasiko,”","poem":1},{"text":"bw’ayogera Mukama, ayitibwa Katonda Ayinzabyonna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}