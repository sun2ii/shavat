{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"AMO","translationId":"lug_bib","name":"Amosi","commonName":"Amosi","title":"Ekitabo Ekiyitibwa Amosi","order":30,"numberOfChapters":9,"sha256":"ffc5260d1a7100dc9e7ca01b41a9b2522f90939bd05323828971aa3d39c1dd78","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/lug_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":6,"content":[{"type":"heading","content":["Mukama Anenya Abali mu Mirembe"]},{"type":"verse","number":1,"content":[{"text":"Zibasanze abo abateefiirayo mu Sayuuni,","poem":1},{"text":"n’abo abawulira emirembe ku lusozi lw’e Samaliya.","poem":2},{"text":"Mmwe abasajja abeekitiibwa ab’ensi enkulembeze,","poem":1},{"text":"abantu ba Isirayiri gye beeyuna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mugende mulabe e Kalune;","poem":1},{"text":"muveeyo mulage mu Kamasi ekikulu,","poem":2},{"lineBreak":true},{"text":"ate era muserengete mu kibuga ky’Abafirisuuti eky’e Gaasi.","poem":2},{"text":"Basinga obwakabaka bwammwe obubiri?","poem":1},{"text":"Ensi yaabwe esinga eyammwe obunene?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mulindiriza olunaku olw’ekibi,","poem":1},{"text":"ate ne musembeza effugabbi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mugalamira ku bitanda ebyakolebwa mu masanga","poem":1},{"text":"ne muwummulira mu ntebe ennyonvu","poem":2},{"text":"nga muvaabira ennyama y’endiga","poem":1},{"text":"n’ey’ennyana ensava.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mwekubira ennanga nga Dawudi bwe yakolanga,","poem":1},{"text":"ne muyiiya n’ennyimba ku bivuga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mwekatankira wayini,","poem":1},{"text":"ne mwesiiga n’ebizigo ebirungi,","poem":2},{"lineBreak":true},{"text":"naye temukaabira kubonaabona kwa Yusufu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Noolwekyo mmwe mulisooka okugenda mu buwaŋŋanguse.","poem":1},{"text":"Era embaga zammwe n’okwewummuza birikoma.","poem":2}]},{"type":"verse","number":8,"content":["Mukama Katonda ow’Eggye alayidde, Mukama Katonda Ayinzabyonna agamba nti,",{"text":"“Neetamiddwa amalala ga Yakobo,","poem":1},{"text":"nkyawa ebigo bye,","poem":2},{"text":"era nzija kuwaayo ekibuga","poem":1},{"text":"ne byonna ebikirimu eri abalabe baakyo.”","poem":2}]},{"type":"verse","number":9,"content":["Era singa ennyumba eneeba ekyalinawo abasajja ekkumi abasigaddewo, nabo balifa."]},{"type":"verse","number":10,"content":["Era singa ow’ekika akola ku by’okuziika, anaaba afulumya amagumba n’abuuza oba waliwo omuntu yenna eyeekwese munda mu nnyumba, oba alina gwe yeekwese naye, n’addamu nti, “Nedda,” olwo omuziisi anaamusirisa ng’agamba nti, “Sirika; tetwogera ku linnya lya Mukama.”"]},{"type":"verse","number":11,"content":[{"text":"Laba Mukama alagidde,","poem":1},{"text":"ennyumba ennene erimenyebwamenyebwa,","poem":2},{"lineBreak":true},{"text":"n’ennyumba entono erimenyebwamenyebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kisoboka embalaasi okuddukira ku mayinja?","poem":1},{"text":"Waali wabaddewo abalima ku mayinja n’enkumbi ezisikibwa ente?","poem":2},{"text":"Naye obwenkanya mubufudde obutwa","poem":1},{"text":"n’ekibala eky’obutuukirivu ne mukifuula ekikaawa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mwenyumiririza bwereere nti muli b’amaanyi olw’okuba nga mwawamba ekibuga Lodeba.","poem":1},{"text":"Mwogera nti, “Tetwawamba Kanayimu n’amaanyi gaffe?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mukama Katonda ow’Eggye agamba nti,","poem":1},{"text":"“Ndibasindikira eggwanga libalumbe, mmwe ennyumba ya Isirayiri;","poem":2},{"text":"liribajooga ebbanga lyonna","poem":1},{"text":"okuva e Lebo Kamasi okutuuka mu kiwonvu kye Alaba.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/AMO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/AMO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/AMO/5.json","previousChapterAudioLinks":{},"numberOfVerses":14}