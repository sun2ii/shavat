{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"AMO","translationId":"lug_bib","name":"Amosi","commonName":"Amosi","title":"Ekitabo Ekiyitibwa Amosi","order":30,"numberOfChapters":9,"sha256":"ffc5260d1a7100dc9e7ca01b41a9b2522f90939bd05323828971aa3d39c1dd78","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/lug_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":8,"content":[{"type":"heading","content":["Ekisero ky’Ebibala"]},{"type":"verse","number":1,"content":["Bino Mukama Katonda bye yandaga. Ne ndaba ekisero ekirimu ebibala ebyengedde."]},{"type":"verse","number":2,"content":["Mukama n’ambuuza nti, “Amosi, kiki ky’olaba?” Ne muddamu nti, “Ndaba ekisero ky’ebibala ebyengedde.” Mukama n’alyoka aŋŋamba nti, “Ekiseera eky’okubonereza abaana ba Isirayiri kituuse. Siribasonyiwa nate."]},{"type":"verse","number":3,"content":["“Ku lunaku olwo,” bw’ayogera Mukama Katonda, “okuyimba kw’omu yeekaalu kulifuuka kukungubaga. Walibeerawo okufa okuyitirivu, emirambo nga gibunye wonna. Walibaawo akasiriikiriro.”"]},{"type":"verse","number":4,"content":[{"text":"Muwulire bino mmwe abalinnyirira abateesobola,","poem":1},{"text":"era abasaanyaawo abanaku b’omu nsi,","poem":2}]},{"type":"verse","number":5,"content":["nga mwogera nti,",{"text":"“Ennaku enkulu ez’Omwezi ogwa kaboneka ziggwaako ddi,","poem":1},{"text":"tulyoke tutunde emmere yaffe ey’empeke,","poem":2},{"text":"era ne Ssabbiiti eggwaako ddi,","poem":1},{"text":"tutunde eŋŋaano yaffe?”","poem":2},{"text":"Mukozesa minzaani enkyamu","poem":1},{"text":"ne mwongera emiwendo","poem":2},{"lineBreak":true},{"text":"ne mukozesa n’ebipimo ebitatuuse,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"mmwe abagula abaavu n’effeeza","poem":1},{"text":"n’abanaku ne mubagula n’omugogo gw’engatto,","poem":2},{"lineBreak":true},{"text":"ne mutundira ebisaaniiko mu ŋŋaano.","poem":2}]},{"type":"verse","number":7,"content":["Mukama yeeweredde amalala ga Yakobo ng’agamba nti, “Sigenda kwerabira bintu bye bakoze."]},{"type":"verse","number":8,"content":[{"text":"“Ensi terikankana olw’ekyo,","poem":1},{"text":"na buli abeeramu n’akungubaga?","poem":2},{"text":"Ensi yonna eritumbiira ng’omugga Kiyira","poem":1},{"text":"n’ekka ng’amazzi","poem":2},{"lineBreak":true},{"text":"ag’omugga gw’e Misiri bwe gakola.”","poem":2}]},{"type":"verse","number":9,"content":["Mukama Katonda agamba nti,",{"text":"“Ku lunaku olwo, enjuba erigwiira mu ttuntu","poem":1},{"text":"era ensi erikwata ekizikiza emisana ttuku.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Embaga zammwe ez’eddini ndizifuula mikolo gya kukungubaga","poem":1},{"text":"era okuyimba kwammwe kwonna kulifuuka kukaaba.","poem":2},{"text":"Mwenna nzija kubatuusa ku kwambala ebibukutu","poem":1},{"text":"n’emitwe gyammwe mugimwe.","poem":2},{"text":"Olunaku olwo ndilufuula ng’olw’okukungubagira omwana owoobulenzi omu yekka,","poem":1},{"text":"era n’enkomerero yaabyo ekaayire ddala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ekiseera kijja,” bw’ayogera Mukama Katonda,","poem":1},{"text":"“lwe ndisindika enjala mu nsi yonna,","poem":2},{"text":"teriba njala ya mmere oba nnyonta y’amazzi,","poem":1},{"text":"naye eriba enjala y’ekigambo kya Katonda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abantu balibundabunda okuva ku nnyanja emu okudda ku ndala,","poem":1},{"text":"bave mu bukiikakkono badde mu bukiikaddyo","poem":2},{"text":"nga banoonya ekigambo kya Mukama,","poem":1},{"text":"naye tebalikifuna.","poem":2}]},{"type":"verse","number":13,"content":["“Mu biro ebyo,",{"text":"“abawala ababalagavu n’abalenzi ab’amaanyi","poem":1},{"text":"balizirika olw’ennyonta.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abo abaalayira eby’ensonyi eby’e Samaliya","poem":1},{"text":"oba abaayogera nti, ‘Nga katonda wo bw’ali omulamu ggwe Ddaani,’","poem":2},{"lineBreak":true},{"text":"oba nti, ‘Nga katonda w’e Beeruseba bw’ali omulamu,’","poem":2},{"lineBreak":true},{"text":"baligwa obutayimuka nate.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/AMO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/AMO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/AMO/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}