1},{"text":"ndiragira ogusota ne gubalumirayo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne bwe balitwalibwa abalabe baabwe mu buwaŋŋanguse,","poem":1},{"text":"era nayo ndiragira ekitala ne kibattirayo.","poem":2},{"text":"Ndibasimba amaaso","poem":1},{"text":"ne batuukibwako bibi so si birungi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Era Mukama, Mukama ow’Eggye,","poem":1},{"text":"akwata ku nsi n’esaanuuka,","poem":2},{"lineBreak":true},{"text":"abantu baayo bonna abagibeeramu ne bakungubaga,","poem":2},{"text":"ensi yonna n’etumbiira nga Kiyira","poem":1},{"text":"ate n’ekka ng’amazzi g’omugga gw’e Misiri;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"oyo eyazimba olubiri lwe olulungi ennyo mu ggulu,","poem":1},{"text":"omusingi gwalwo ne gubeera ku nsi,","poem":2},{"text":"ayita amazzi g’ennyanja,","poem":1},{"text":"n’agayiwa wansi ku lukalu,","poem":2},{"lineBreak":true},{"text":"Mukama lye linnya lye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mukama ayongera n’agamba nti,","poem":1},{"text":"“Mmwe abaana ba Isirayiri temuli ng’Abakuusi gye ndi?","poem":2},{"text":"Ssabaggya mu nsi y’e Misiri","poem":1},{"text":"nga bwe naggya Abafirisuuti e Katufoli,","poem":2},{"lineBreak":true},{"text":"n’Abasuuli e Kiri?”","poem":2}]},{"type":"heading","content":["Essuubi lya Isirayiri"]},{"type":"verse","number":8,"content":[{"text":"“Ddala ddala amaaso ga Mukama Katonda,","poem":1},{"text":"gatunuulidde nkaliriza obwakabaka obwonoonyi.","poem":2},{"text":"Ndibuzikiriza ne mbusaasaanya","poem":1},{"text":"okuva ku nsi.","poem":2},{"text":"Kyokka sirizikiririza ddala","poem":1},{"text":"ennyumba ya Yakobo okugimalawo,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Kubanga ndiwa ekiragiro,","poem":1},{"text":"ennyumba ya Isirayiri erinyeenyezebwa","poem":2},{"lineBreak":true},{"text":"mu mawanga gonna,","poem":2},{"text":"ng’emmere ey’empeke bwe kuŋŋutibwa mu kakuŋŋunta","poem":1},{"text":"era tewaliba kayinja akaligwa wansi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Aboonoonyi bonna mu bantu bange,","poem":1},{"text":"balifa kitala,","poem":2},{"text":"abo bonna aboogera nti,","poem":1},{"text":"‘Akabi tekalitutuukako.’ ”","poem":2}]},{"type":"heading","content":["Isirayiri Edda Obuggya"]},{"type":"verse","number":11,"content":[{"text":"“Mu biro ebyo ndizzaawo","poem":1},{"text":"ennyumba ya Dawudi eyagwa","poem":2},{"text":"era ndiddaabiriza ebifo ebyamenyebwamenyebwa,","poem":1},{"text":"ne nzizaawo ebyali amatongo,","poem":2},{"lineBreak":true},{"text":"ne biba nga bwe byabeeranga,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"balyoke batwale ekitundu kya Edomu ekyasigalawo","poem":1},{"text":"n’amawanga gonna ge nayita okuba abantu bange,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama alikola ebintu ebyo byonna.","poem":2}]},{"type":"verse","number":13,"content":["“Ennaku zijja,” bw’ayogera Mukama,",{"text":"“akungula lw’alisinga asiga,","poem":1},{"text":"n’asiga ensigo lw’alisinga atunda emizabbibu.","poem":2},{"text":"Wayini omuggya alitonnya okuva mu nsozi,","poem":1},{"text":"n’akulukuta okuva mu busozi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndikomyawo abantu bange Isirayiri okuva mu buwaŋŋanguse,","poem":1},{"text":"ne bazimba nate ebibuga ebyamenyebwa, babibeeremu.","poem":2},{"text":"Balisimba ennimiro zaabwe ez’emizabbibu ne banywa wayini avaamu,","poem":1},{"text":"era balisimba ennimiro balye ebibala byamu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndisimba Isirayiri mu nsi yaabwe,","poem":1},{"text":"era tebaliggibwa nate","poem":2},{"lineBreak":true},{"text":"mu nsi gye nabawa,”","poem":2},"bw’ayogera Mukama Katonda wammwe."]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bi