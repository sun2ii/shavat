{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"DEU","translationId":"lug_bib","name":"Ekyamateeka Olwokubiri","commonName":"Ekyamateeka Olwokubiri","title":"Ekitabo Ekiyitibwa Ekyamateeka Olwokubiri","order":5,"numberOfChapters":34,"sha256":"5dc1df338d01c284fcb39ca9b6aabef38eb35c873fec57c056d7a043e4a3de5c","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/lug_bib/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":[{"text":"Tega okutu ggwe eggulu, nange nnaayogera,","poem":1},{"text":"wulira ebigambo by’omu kamwa kange.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Okuyigiriza kwange ka kutonnye ng’enkuba,","poem":1},{"text":"n’ebigambo byange bigwe ng’omusulo,","poem":2},{"text":"bigwe ng’obufuuyirize ku muddo,","poem":1},{"text":"ng’oluwandagirize ku bisimbe ebito.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kubanga ndirangirira erinnya lya Mukama;","poem":1},{"text":"mutendereze ekitiibwa kya Katonda waffe!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lwe lwazi, emirimu gye mituukirivu,","poem":1},{"text":"n’ebikolwa bye byonna bya bwenkanya.","poem":2},{"text":"Ye Katonda omwesigwa, ataliiko bukuusa,","poem":1},{"text":"omwenkanya era omutereevu mu byonna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Beeyisizza ng’abagwenyufu gy’ali,","poem":1},{"text":"baswavu era tebakyali baana be,","poem":2},{"lineBreak":true},{"text":"wabula omulembe omukyamu era ogw’amawaggali.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bwe mutyo bwe musasula Mukama Katonda,","poem":1},{"text":"mmwe abantu abasirusiru era abatalina magezi?","poem":2},{"text":"Si ye kitaawo eyakutonda,","poem":1},{"text":"n’akussaawo n’akunyweza?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jjukira ebiseera eby’edda,","poem":1},{"text":"fumiitiriza ku myaka egyayita edda.","poem":2},{"text":"Buuza kitaawo ajja kukubuulira","poem":1},{"text":"ne bakadde bo abakulembeze bajja kukutegeeza.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ali Waggulu Ennyo bwe yagabanyiza amawanga ensi zaago","poem":1},{"text":"abantu bonna bwe yabayawulayawulamu,","poem":2},{"text":"yategeka ensalo z’amawanga","poem":1},{"text":"ng’omuwendo gw’abaana ba Isirayiri bwe gwali.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Omugabo gwa Mukama Katonda be bantu be,","poem":1},{"text":"Yakobo bwe busika bwe bwe yagabana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yamuyisanga mu ddungu,","poem":1},{"text":"mu nsi enkalu eya kikuŋŋunta.","poem":2},{"text":"Yamuzibiranga, n’amulabiriranga,","poem":1},{"text":"n’amukuumanga ng’emmunye ey’eriiso lye.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ng’empungu bw’enyegenya ku kisu kyayo,","poem":1},{"text":"n’epaapaalira waggulu w’obwana bwayo,","poem":2},{"text":"era nga bw’eyanjuluza ebiwaawaatiro byayo, n’ebusitula,","poem":1},{"text":"n’ebutumbiiza ku biwaawaatiro byayo,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mukama Katonda yekka ye yamukulemberanga;","poem":1},{"text":"so tewabangawo katonda mulala.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yamuteeka ku ntikko z’ensozi ez’ensi eyo,","poem":1},{"text":"n’amuliisanga ku bibala by’omu nnimiro.","poem":2},{"text":"Yamukulizanga ku mubisi gw’enjuki ogw’omu njatika z’enjazi","poem":1},{"text":"n’amafuta agaavanga mu mayinja amagumu","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ne bbongo eyavanga mu biraalo, n’amata okuva mu bisibo,","poem":1},{"text":"n’amasavu ag’endiga ento n’ennume,","poem":2},{"text":"n’embuzi ennume n’enduusi ez’e Basani,","poem":1},{"text":"awamu n’eŋŋaano esinga obulungi,","poem":2},{"text":"wanywanga wayini ow’ejjovu eyavanga mu mizabbibu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Yesuluuni yakkuta n’agejja n’asambagala;","poem":1},{"text":"ng’ojjudde emmere nga weezitoowerera n’oggwaamu amaanyi.","poem":2},{"text":"Yava ku Katonda eyamukola,","poem":1},{"text":"n’alekulira Olwazi olw’Obulokozi bwe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Baamukwasa obuggya olwa bakatonda abalala","poem":1},{"text":"ne bamusunguwaza ne bakatonda abalala.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Baawaayo ssaddaaka eri baddayimooni, so si eri Katonda,","poem":1},{"text":"eri bakatonda be batamanyangako,","poem":2},{"lineBreak":true},{"text":"bakatonda abaggya abaali baakatuuka","poem":2},{"lineBreak":true},{"text":"bakatonda abo bajjajjammwe be bataatyanga.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Weerabira Olwazi eyakuzaala,","poem":1},{"text":"weerabira Katonda eyakuzaala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mukama Katonda bwe yakiraba n’abeegobako","poem":1},{"text":"kubanga yasunguwazibwa batabani be ne bawala be.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"N’agamba nti, Nzija kubakweka amaaso gange","poem":1},{"text":"ndabe ebinaabatuukako;","poem":2},{"text":"kubanga omulembe gwabwe mwonoonefu,","poem":1},{"text":"abaana abatalinaamu bwesigwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bankwasa obuggya ne bakatonda abalala,","poem":1},{"text":"ne banyiiza n’ebifaananyi byabwe omutali nsa.","poem":2},{"text":"Ndibakwasa obuggya olw’abo abatali ggwanga,","poem":1},{"text":"ndibakwasa obusungu olw’eggwanga eritategeera.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kubanga obusungu bwange bukumye omuliro,","poem":1},{"text":"ne gwaka okutuukira ddala wansi mu magombe,","poem":2},{"text":"gusenkenya ensi n’ebibala byayo,","poem":1},{"text":"ne gwokya amasozi okutandikira ku bikolo byago.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Nzija kubatuumangako emitawaana","poem":1},{"text":"ne mbayiwangako obusaale bwange.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nnaabasindikiranga enjala namuzisa,","poem":1},{"text":"n’obulwadde obwokya, ne kawumpuli omuzikiriza;","poem":2},{"text":"ndibaweereza ebisolo eby’amannyo amasongovu","poem":1},{"text":"n’ebyewalula mu nfuufu eby’obusagwa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ekitala kinaabamalangako abaana baabwe","poem":1},{"text":"ne mu maka gaabwe eneebanga ntiisa njereere.","poem":2},{"text":"Abavubuka abalenzi n’abawala balizikirira","poem":1},{"text":"abaana abawere n’abasajja ab’envi bonna batyo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nalowoozaako ku ky’okubasaasaanya","poem":1},{"text":"wabulewo akyabajjukiranga ku nsi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Naye ne saagala abalabe baabwe kubasosonkereza,","poem":1},{"text":"kubanga abaabalumbagana bandiremeddwa okukitegeera,","poem":2},{"text":"ne beewaana nti, “Ffe tuwangudde,","poem":1},{"text":"Mukama ebyo byonna si ye yabikoze.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Lye ggwanga omutali magezi,","poem":1},{"text":"mu bo temuliimu kutegeera.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Singa baali bagezi ekyo bandikitegedde,","poem":1},{"text":"ne balowooza ku biribatuukako ku nkomerero.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Omusajja omu yandisobodde atya okugoba abantu olukumi,","poem":1},{"text":"oba ababiri okudumya omutwalo ne badduka,","poem":2},{"text":"wabula nga Lwazi waabwe y’abatunzeeyo,","poem":1},{"text":"Mukama Katonda ng’abawaddeyo?","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kya mazima lwazi waabwe tali nga Lwazi waffe,","poem":1},{"text":"abalabe baffe bakiriziganya naffe.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Wayini waabwe ava mu terekero lya wayini wa Sodomu,","poem":1},{"text":"n’ennimiro z’emizabbibu za Ggomola;","poem":2},{"text":"ezzabbibu zaabwe zabbibu za butwa,","poem":1},{"text":"ebirimba byazo bikaawa;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"wayini waazo bwe butwa bw’emisota","poem":1},{"text":"obusagwa obukambwe obw’amasalambwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Ekyo saakyeterekera,","poem":1},{"text":"nga kuliko n’envumbo mu mawanika gange?","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Okuwoolera eggwanga kwange, nze ndisasula.","poem":1},{"text":"Luliba lumu ebigere byabwe ne biseerera,","poem":2},{"text":"obudde bwabwe obw’okuzikirira busembedde,","poem":1},{"text":"n’okubonerezebwa kwabwe kubafubutukirako.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Mukama Katonda alisalira abantu omusango mu bwenkanya,","poem":1},{"text":"alisaasira abaweereza be,","poem":2},{"text":"bw’aliraba ng’amaanyi gonna gabaweddemu,","poem":1},{"text":"omuddu n’ow’eddembe nga tewasigadde n’omu.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"N’alyoka abuuza nti, Kale nno bakatonda baabwe bali ludda wa,","poem":1},{"text":"olwazi mwe beekweka.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Baani abaalyanga amasavu ku ssaddaaka zaabwe,","poem":1},{"text":"ne banywa envinnyo ey’ekiweebwayo ekyokunywa?","poem":2},{"text":"Basituke bajje babayambe,","poem":1},{"text":"kale babawe obubudamo babakuume!","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Mulabe kaakano, nga nze kennyini, nze Ye!","poem":1},{"text":"Tewali katonda mulala wabula Nze;","poem":2},{"text":"nzita era ne nzuukiza,","poem":1},{"text":"nfumita era ne mponya;","poem":2},{"lineBreak":true},{"text":"era tewali atangira mukono gwange nga gukola.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Ngolola omukono gwange eri eggulu ne nangirira nti,","poem":1},{"text":"ddala ddala nga bwe ndi omulamu emirembe gyonna","poem":2}]},{"type":"verse","number":41,"content":[{"text":"bwe mpagala ekitala kyange ekimasamasa,","poem":1},{"text":"n’omukono gwange ne gukikwata nga nsala emisango,","poem":2},{"text":"nnaawalananga abalabe bange,","poem":1},{"text":"ne neesasuzanga eri abanaankyawanga.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Obusaale bwange ndibutamiiza omusaayi,","poem":1},{"text":"n’ekitala kyange kirirya ennyama,","poem":2},{"text":"n’omusaayi gw’abattiddwa n’abawambiddwa,","poem":1},{"text":"n’ogw’emitwe egy’abakulembeze b’abalabe.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Mujaguze mmwe amawanga awamu n’abantu be,","poem":1},{"text":"kubanga aliwalanira omusaayi gw’abaweereza be,","poem":2},{"text":"aliwalana abalabe be,","poem":1},{"text":"era alitangirira olw’ensi ye n’abantu be.","poem":2}]},{"type":"verse","number":44,"content":["Awo Musa n’ajja awamu ne Yoswa mutabani wa Nuuni, n’addamu ebigambo byonna eby’oluyimba olwo ng’abantu bonna bawulira."]},{"type":"verse","number":45,"content":["Musa bwe yamala okuddamu ebigambo ebyo byonna eri abaana ba Isirayiri,"]},{"type":"verse","number":46,"content":["n’abagamba nti, “Mukwate ku mutima gwammwe ebigambo byonna bye mbategeezezza leero n’obuwombeefu obungi, mulyoke mulagire abaana bammwe bagonderenga n’obwegendereza ebigambo byonna eby’amateeka gano."]},{"type":"verse","number":47,"content":["Ebigambo ebyo si bya kusaagasaaga, wabula bye bigambo ebikwatira ddala ku bulamu bwammwe bwennyini. Okusinziira ku bigambo bino, mugenda kuwangaala nga muli mu nsi gye mugenda okusomokera omugga Yoludaani okugifuna.”"]},{"type":"heading","content":["Okufa kwa Musa Kulangibwa"]},{"type":"verse","number":48,"content":["Ku lunaku olwo lwennyini Mukama Katonda n’agamba Musa bw’ati nti,"]},{"type":"verse","number":49,"content":["“Yambuka olinnyerinnye ku Lusozi Nebo oluli mu nsozi za Abalimu mu nsi ya Mowaabu, osusse amaaso Yeriko olengere ensi ya Kanani gy’empa abaana ba Isirayiri okuba obutaka bwabwe obw’enkalakkalira."]},{"type":"verse","number":50,"content":["Ku lusozi olwo lw’ojja okulinnya kw’olifiira okuŋŋaanyizibwe eri abantu bo, nga muganda wo Alooni bwe yafiira ku lusozi Koola, n’akuŋŋaanyizibwa eri abantu be."]},{"type":"verse","number":51,"content":["Kubanga mwembi mwanziggyamu obwesige mu maaso g’abaana ba Isirayiri ku mazzi g’e Meriba-Kadesi mu ddungu ly’e Zini, olw’okulemwa okussa ekitiibwa ekituukiridde mu butukuvu bwange mu maaso g’abaana ba Isirayiri."]},{"type":"verse","number":52,"content":["Noolwekyo ensi ojja kugirengera bulengezi, so toligiyingiramu, ensi gye mpa abaana ba Isirayiri.”"]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":52}