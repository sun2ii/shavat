{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"DEU","translationId":"lug_bib","name":"Ekyamateeka Olwokubiri","commonName":"Ekyamateeka Olwokubiri","title":"Ekitabo Ekiyitibwa Ekyamateeka Olwokubiri","order":5,"numberOfChapters":34,"sha256":"5dc1df338d01c284fcb39ca9b6aabef38eb35c873fec57c056d7a043e4a3de5c","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/lug_bib/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":33,"content":[{"type":"heading","content":["Musa Asabira Ebika bya Isirayiri Omukisa Omulundi gwe Ogwasembayo"]},{"type":"verse","number":1,"content":["Guno gwe mukisa, Musa musajja wa Katonda gwe yasabira abaana ba Isirayiri nga tannafa."]},{"type":"verse","number":2,"content":["Yagamba nti,",{"text":"“Mukama Katonda yajja gye tuli ng’ava ku Sinaayi","poem":1},{"text":"n’atutuukako ng’ava ku Seyiri;","poem":2},{"lineBreak":true},{"text":"yamasamasa ng’ava ku Lusozi Palani.","poem":2},{"text":"Yajja n’obufukunya bw’abatukuvu","poem":1},{"text":"okuva ku bukiika obwaddyo obw’ensozi ze.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mazima gw’oyagala abantu,","poem":1},{"text":"abatukuvu bonna bali mu mikono gyo.","poem":2},{"text":"Bavuunama wansi ku bigere byo","poem":1},{"text":"ne bawulira ebiragiro by’obawa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ge mateeka Musa ge yatuwa","poem":1},{"text":"ng’ekyokufuna eky’ekibiina kya Yakobo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Waasitukawo kabaka mu Yesuluuni","poem":1},{"text":"abakulembeze b’abantu bwe baakuŋŋaana","poem":2},{"lineBreak":true},{"text":"nga bye bika bya Isirayiri ebyegasse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Lewubeeni abenga mulamu; alemenga kuggwaawo","poem":1},{"text":"n’omuwendo gw’abasajja be gulemenga kukendeera.”","poem":2}]},{"type":"verse","number":7,"content":["Kino kye yayogera ku Yuda:",{"text":"“Wulira, Ayi Mukama Katonda okukaaba kwa Yuda;","poem":1},{"text":"omuleete eri abantu be.","poem":2},{"text":"Yeerwaneko n’emikono gye.","poem":1},{"text":"Omuyambenga ng’alwanyisa abalabe be!”","poem":2}]},{"type":"verse","number":8,"content":["Bino bye yayogera ku Leevi:",{"text":"“Sumimu wo ne Ulimu wo","poem":1},{"text":"biwe omusajja oyo gw’oyagala ennyo.","poem":2},{"text":"Wamukebera e Masa","poem":1},{"text":"n’omugezesa ku mazzi ag’e Meriba.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yayogera ku kitaawe ne nnyina nti,","poem":1},{"text":"‘Abo sibafaako.’","poem":2},{"text":"Baganda be teyabategeeranga","poem":1},{"text":"wadde okusembeza abaana be;","poem":2},{"text":"baalabiriranga ekigambo kyo","poem":1},{"text":"ne bakuumanga endagaano yo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Banaayigirizanga Yakobo ebiragiro byo","poem":1},{"text":"ne Isirayiri amateeka go.","poem":2},{"text":"Banaanyookezanga obubaane mu maaso go,","poem":1},{"text":"n’ebiweebwayo ebyokebwa ku kyoto kyo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ayi Mukama Katonda owe omukisa byonna by’akola,","poem":1},{"text":"era okkirize emirimu gy’emikono gye.","poem":2},{"text":"Okubirenga ddala abo abamugolokokerako","poem":1},{"text":"okubenga abalabe be balemenga kwongera kumulumbanga.”","poem":2}]},{"type":"verse","number":12,"content":["Bye yayogera ku Benyamini:",{"text":"“Omwagalwa wa Mukama Katonda abeerenga wanywevu,","poem":1},{"text":"Katonda Ali Waggulu ng’amwebulungudde bulijjo,","poem":2},{"lineBreak":true},{"text":"omwagalwa anaagalamiranga wakati ku bibegabega bye.”","poem":2}]},{"type":"verse","number":13,"content":["Yayogera bw’ati ku Yusufu:",{"text":"“Ettaka lye Mukama Katonda aliwe omukisa,","poem":1},{"text":"n’omusulo omulungi ennyo ogunaavanga waggulu mu ggulu","poem":2},{"lineBreak":true},{"text":"n’amazzi mu nzizi empanvu mu ttaka wansi,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"n’ebibala ebigimu ennyo ebinaavanga mu musana,","poem":1},{"text":"n’amakungula aganaasinganga mu myezi gyonna;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"n’ebibala ebinaakiranga obulungi ku nsozi ez’edda,","poem":1},{"text":"n’okwala kw’ebirime ku nsozi ez’emirembe gyonna;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"n’ebirabo ebisinga byonna mu nsi n’okujjula kwayo,","poem":1},{"text":"n’obuganzi obunaavanga eri oyo ow’omu kisaka ekyaka.","poem":2},{"text":"Ebyo byonna ka bijjenga ku mutwe gwa Yusufu,","poem":1},{"text":"mu kyenyi ky’omulangira mu baganda be.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mu kitiibwa anaabanga ente ennume embereberye","poem":1},{"text":"amayembe ge, ng’amayembe ga sseddume endalu;","poem":2},{"text":"anaagatomezanga amawanga n’agayuzaayuza,","poem":1},{"text":"n’agagoberanga ku nkomerero y’ensi.","poem":2},{"text":"Obwo bwe bunaabanga obukumi bwa Efulayimu","poem":1},{"text":"nga ze nkumi za Manase.”","poem":2}]},{"type":"verse","number":18,"content":["Yayogera bw’ati ku Zebbulooni:",{"text":"“Jaguzanga, ggwe Zebbulooni, bw’onoofulumanga;","poem":1},{"text":"ne Isakaali ng’ali mu weema zo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Banaakoowoolanga amawanga okwambuka ku nsozi","poem":1},{"text":"ne baweerangayo eyo ssaddaaka ez’obutuukirivu,","poem":2},{"text":"banaalyanga eby’obugagga ebya mayanja,","poem":1},{"text":"nga beeyambisa n’ebyobugagga ebikweke mu musenyu.”","poem":2}]},{"type":"verse","number":20,"content":["Yayogera bw’ati ku Gaadi:",{"text":"“Alina omukisa oyo agaziya ensalo z’omugabo gwa Gaadi,","poem":1},{"text":"Gaadi omwo mw’abeera ng’empologoma","poem":2},{"lineBreak":true},{"text":"ng’ayuza omukono n’omutwe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yeerondera omugabo gw’ettaka erisinga obulungi,","poem":1},{"text":"omugabo gw’omukulembeze gwe gwamukuumirwa.","poem":2},{"text":"Abakulembeze b’abantu bwe baakuŋŋaana","poem":1},{"text":"ye yabasalira emisango gya Mukama,","poem":2},{"lineBreak":true},{"text":"n’okukwasa Isirayiri amateeka ga Mukama Katonda.”","poem":2}]},{"type":"verse","number":22,"content":["Yayogera bw’ati ku Ddaani:",{"text":"“Ddaani mwana gwa mpologoma,","poem":1},{"text":"ogubuuka nga guva mu Basani.”","poem":2}]},{"type":"verse","number":23,"content":["Yayogera bw’ati ku Nafutaali:",{"text":"“Ggwe Nafutaali ajjudde obuganzi bwa Mukama Katonda","poem":1},{"text":"era ng’ojjudde emikisa gye,","poem":2},{"lineBreak":true},{"text":"onoosikira obukiikaddyo okutuuka ku nnyanja.”","poem":2}]},{"type":"verse","number":24,"content":["Yayogera bw’ati ku Aseri:",{"text":"“Asinga okuweebwa omukisa mu batabani ye Aseri,","poem":1},{"text":"ku baganda be gwe babanga basinga okwagala","poem":2},{"lineBreak":true},{"text":"era emizabbibu","poem":2},{"noteId":14},{"text":"gigimuke nnyo mu ttaka lye.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Enzigi z’ebibuga byo zinaasibwanga n’eminyolo egy’ekyuma n’ekikomo","poem":1},{"text":"n’amaanyi go ganenkananga n’obuwangaazi bwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Tewali afaanana nga Katonda wa Yesuluuni","poem":1},{"text":"eyeebagala waggulu ku ggulu ng’ajja okukuyamba","poem":2},{"lineBreak":true},{"text":"ne ku bire mu kitiibwa kye.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Katonda ataggwaawo bwe buddukiro bwo,","poem":1},{"text":"era akuwanirira n’emikono gye emirembe gyonna.","poem":2},{"text":"Anaagobanga abalabe bo nga naawe olaba,","poem":1},{"text":"n’agamba nti, ‘Bazikirize!’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Bw’atyo Isirayiri anaabeeranga mu mirembe yekka,","poem":1},{"text":"ezzadde lya Yakobo linaabeeranga wanywevu,","poem":2},{"text":"mu nsi erimu emmere y’empeke ne wayini,","poem":1},{"text":"eggulu mwe linaatonnyezanga omusulo.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nga weesiimye, Ayi Isirayiri!","poem":1},{"text":"Ani akufaanana,","poem":2},{"lineBreak":true},{"text":"ggwe eggwanga Mukama Katonda lye yalokola?","poem":2},{"text":"Ye ngabo yo era omubeezi wo,","poem":1},{"text":"era kye kitala kyo ekisinga byonna.","poem":2},{"text":"Abalabe bo banaakuvuunamiranga,","poem":1},{"text":"era onoobalinnyiriranga.”","poem":2}]}],"footnotes":[{"noteId":14,"caller":"+","text":"Waabangawo amafuta agaggibwanga mu mizabbibu, era amafuta ago kaali kabonero akalaga obugagga.","reference":{"chapter":33,"verse":24}}]},"thisChapterLink":"/api/lug_bib/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}