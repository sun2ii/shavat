{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ECC","translationId":"lug_bib","name":"Omubuulizi","commonName":"Omubuulizi","title":"Ekitabo Ekiyitibwa Omubuulizi","order":21,"numberOfChapters":12,"sha256":"c3dc2328a3df47242b8de1dc43c8f5f51173813f94f3d66316770f95a80f45f1","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/lug_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":1,"content":[{"type":"heading","content":["Obutaliimu bw’Amagezi g’Abantu"]},{"type":"verse","number":1,"content":["Ebigambo by’Omubuulizi, mutabani wa Dawudi kabaka mu Yerusaalemi."]},{"type":"verse","number":2,"content":[{"text":"“Obutaliimu! Obutaliimu!” bw’ayogera Omubuulizi.","poem":1},{"text":"Byonna butaliimu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Omuntu afuna ki mu byonna by’akola,","poem":1},{"text":"mu byonna ebimukooya wansi w’enjuba?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Omulembe ogumu gugenda, omulala ne gujja,","poem":1},{"text":"naye ensi ebeerera emirembe gyonna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Enjuba evaayo era n’egwa,","poem":1},{"text":"ate n’eyanguwa okutuuka mu kifo mw’eviirayo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Empewo ekunta ng’eraga obukiikaddyo,","poem":1},{"text":"ne yeetooloola okutuuka obukiikakkono;","poem":2},{"text":"empewo yeetooloola ne yeetooloola,","poem":1},{"text":"n’ekomerawo ku biwaawaatiro byayo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Emigga gyonna gikulukuta nga giraga mu nnyanja,","poem":1},{"text":"naye ennyanja tejjula;","poem":2},{"text":"ekifo emigga gye gikulukutira","poem":1},{"text":"era gye gyeyongera okukulukutira.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ebintu byonna bijjudde obukoowu","poem":1},{"text":"omuntu bw’atasobola kutenda!","poem":2},{"text":"Eriiso terimatira kulaba,","poem":1},{"text":"wadde okutu okukoowa okuwulira.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ekyo ekyabaawo era kye kigenda okubaawo,","poem":1},{"text":"n’ekyo ekikoleddwa era kye kigenda okukolebwa;","poem":2},{"lineBreak":true},{"text":"era tewali kintu kiggya wansi w’enjuba.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Waali wabaddewo ekintu ekyali kigambiddwa nti,","poem":1},{"text":"“Laba kino kiggya”?","poem":2},{"text":"Kyaliwo dda","poem":1},{"text":"mu mirembe egyatusooka?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tewali kujjukira bintu byasooka","poem":1},{"text":"era tewaliba kujjukira bintu ebyo ebitanabaawo mu ebyo ebijja oluvannyuma.","poem":2}]},{"type":"heading","content":["Amagezi Agatali ga Katonda Butaliimu"]},{"type":"verse","number":12,"content":["Nze Omubuulizi nali kabaka wa Isirayiri mu Yerusaalemi."]},{"type":"verse","number":13,"content":["Nagezaako n’omutima gwange okuyiga n’okwetegereza n’amagezi gange gonna mu ebyo ebikolebwa wansi w’eggulu; omulimu Katonda gwe yawa abaana b’abantu okukola, guteganya."]},{"type":"verse","number":14,"content":["Ndabye ebintu byonna ebikolebwa wansi w’enjuba; era laba, byonna butaliimu na kugoberera mpewo."]},{"type":"verse","number":15,"content":[{"text":"Ekyo ekyakyama tekisoboka kugololebwa,","poem":1},{"text":"n’ekibulako tekibalibwa.","poem":2}]},{"type":"verse","number":16,"content":["Nayogera munda yange nti, “Nfunye amagezi mangi agasinga ag’abo bonna abaali babadde mu Yerusaalemi, era nfunye amagezi n’okumanya kungi.”"]},{"type":"verse","number":17,"content":["Era omutima gwange ne gumanya okwawula amagezi n’eddalu, n’obutategeera. Ne ntegeera nti na kino nakyo kugoberera mpewo."]},{"type":"verse","number":18,"content":[{"text":"Kubanga mu magezi amangi mujjiramu okunakuwala kungi;","poem":1},{"text":"amagezi gye gakoma obungi, n’okunakuwala gye gukoma.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}