{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ECC","translationId":"lug_bib","name":"Omubuulizi","commonName":"Omubuulizi","title":"Ekitabo Ekiyitibwa Omubuulizi","order":21,"numberOfChapters":12,"sha256":"c3dc2328a3df47242b8de1dc43c8f5f51173813f94f3d66316770f95a80f45f1","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/lug_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":10,"content":[{"type":"heading","content":["Omugezi n’Omusirusiru"]},{"type":"verse","number":1,"content":[{"text":"Nga ensowera enfu bwe zoonoona akaloosa akawunya obulungi,","poem":1},{"text":"bwe katyo akasobyo akatono bwe koonoona amagezi n’ekitiibwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Omutima gw’omuntu ow’amagezi gumukozesa ekituufu,","poem":1},{"text":"naye ogw’omusirusiru gumutwala kukola bitasaana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne bw’aba ng’atambula,","poem":1},{"text":"amanyibwa nga talina magezi,","poem":2},{"lineBreak":true},{"text":"era buli amulaba agamba nti musirusiru.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mukama wo bw’akunyiigiranga,","poem":1},{"text":"tomulaganga busungu;","poem":2},{"lineBreak":true},{"text":"okuddamu n’eggonjebwa kukyusa ekiruyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ekibi ekirala kye nalaba,","poem":1},{"text":"kye kikwata ku nsobi y’omufuzi:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"nalaba ng’abasirusiru baweebwa ebifo ebisava,","poem":1},{"text":"naye ng’abagagga bo baweebwa ebyo ebya wansi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ate nalaba ng’abaddu beebagala embalaasi,","poem":1},{"text":"songa abalangira batambuza bigere ng’abaddu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Asima ekinnya alikigwamu,","poem":1},{"text":"n’oyo amenya ekisenge omusota gulimubojja.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Oyo ayasa amayinja gamulumya,","poem":1},{"text":"n’oyo ayasa enku zimulumya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Embazzi bwe tebaako bwogi,","poem":1},{"text":"n’etewagalwa,","poem":2},{"text":"agitemya ateekwa okufuba ennyo,","poem":1},{"text":"naye obumanyirivu bwe buwangula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Omusota bwe guluma nga tegunnakola bya bufuusa,","poem":1},{"text":"omufuusa talina kyafunamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ebigambo ebiva mu kamwa k’omuntu ow’amagezi bya muwendo nnyo eri abo ababiwulira,","poem":1},{"text":"naye akamwa k’omusirusiru kamusuula mu ntata.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Entandikwa y’ebigambo bye nga temuli nsa,","poem":1},{"text":"ne ku nkomerero yaabyo biba mususa.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Omusirusiru asavuwaza ebigambo.","poem":2},{"lineBreak":true},{"text":"Tewali amanyi birijja,","poem":1},{"text":"kale ani asobola okumubuulira ebiribaawo oluvannyuma lwe?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Omusirusiru aterebuka mangu olw’ekitamugendedde bulungi,","poem":1},{"text":"n’abulwa n’ekkubo erimutwala mu kibuga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Zikusanze gw’ensi kabaka bw’aba nga yali muddu,","poem":1},{"text":"nga n’abalangira bakeera kwetamiirira!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Olina omukisa gw’ensi kabaka wo bw’aba nga wa lulyo lulangira,","poem":1},{"text":"ate nga n’abalangira bo bamanyi ekiseera eky’okuliiramu,","poem":2},{"lineBreak":true},{"text":"olw’okufuna amaanyi so si lwa kutamiira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Obugayaavu buleetera akasolya k’ennyumba okutonnya,","poem":1},{"text":"n’emikono egitayagala kukola gireetera ennyumba okutonnya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ekijjulo kikolebwa lwa kusanyuka,","poem":1},{"text":"ne wayini yeeyagaza obulamu,","poem":2},{"lineBreak":true},{"text":"naye ensimbi y’esobola byonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tokolimira kabaka mu mutima gwo","poem":1},{"text":"newaakubadde okukolimira omugagga mu kisenge kyo,","poem":2},{"text":"kubanga ennyonyi ey’omu bbanga eyinza okwetikka ebigambo byo","poem":1},{"text":"nga biwandiikiddwa ku biwaawaatiro byayo n’ebibatuusaako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ECC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ECC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ECC/9.json","previousChapterAudioLinks":{},"numberOfVerses":20}