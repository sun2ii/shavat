{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ECC","translationId":"lug_bib","name":"Omubuulizi","commonName":"Omubuulizi","title":"Ekitabo Ekiyitibwa Omubuulizi","order":21,"numberOfChapters":12,"sha256":"c3dc2328a3df47242b8de1dc43c8f5f51173813f94f3d66316770f95a80f45f1","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/lug_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":11,"content":[{"type":"heading","content":["Bw’ogaba Katonda Akuddizaawo"]},{"type":"verse","number":1,"content":[{"text":"Siganga emmere yo ng’enkuba etonnya,","poem":1},{"text":"kubanga ebbanga lyayo bwe lirituuka olikungula.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gabiranga musanvu weewaawo munaana,","poem":1},{"text":"kubanga mu biseera eby’oluvannyuma oyinza okubeera mu kwetaaga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ebire bwe bijjula amazzi,","poem":1},{"text":"bitonnyesa enkuba ku nsi;","poem":2},{"text":"n’omuti bwe gugwa nga gwolekedde obukiikaddyo oba obukiikakkono,","poem":1},{"text":"mu kifo mwe gugwa mwe gulibeera.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Oyo alabirira embuyaga talisiga;","poem":1},{"text":"n’oyo atunuulira ebire talikungula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nga bw’otosobola kutegeera kkubo mpewo,","poem":1},{"text":"oba omubiri nga bwe guzimbibwa ku mwana ali mu lubuto;","poem":2},{"text":"bw’otyo bw’otosobola kutegeera Katonda","poem":1},{"text":"Omutonzi wa byonna by’akola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ku makya siga ensigo zo,","poem":1},{"text":"n’akawungeezi toddiriza mukono gwo;","poem":2},{"text":"kubanga tomanyi eziryala,","poem":1},{"text":"zino oba ziri,","poem":2},{"lineBreak":true},{"text":"oba zombi ziriba nnungi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ekitangaala kirungi,","poem":1},{"text":"era okulaba ku musana kisanyusa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kale omuntu bw’awangaala emyaka emingi,","poem":1},{"text":"agisanyukirengamu gyonna,","poem":2},{"text":"naye ajjukirenga nti waliwo ennaku ez’ekizikiza","poem":1},{"text":"nnyingi ezijja.","poem":2},{"lineBreak":true},{"text":"Ebyo byonna ebijja butaliimu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Omuvubuka sanyukiranga mu buvubuka bwo,","poem":1},{"text":"n’omutima gwo gusanyukenga mu nnaku ez’obuvubuka bwo;","poem":2},{"text":"tambulira mu makubo g’omutima gwo","poem":1},{"text":"ne mu kulaba kw’amaaso go.","poem":2},{"text":"Naye manya nga mu byonna,","poem":1},{"text":"Katonda agenda kukusalira omusango.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Noolwekyo ggyawo okweraliikirira mu mutima","poem":1},{"text":"era weggyeko emitawaana mu ggwe,","poem":2},{"lineBreak":true},{"text":"kubanga obuvubuka n’amaanyi gaabwe butaliimu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}