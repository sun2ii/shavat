{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ECC","translationId":"lug_bib","name":"Omubuulizi","commonName":"Omubuulizi","title":"Ekitabo Ekiyitibwa Omubuulizi","order":21,"numberOfChapters":12,"sha256":"c3dc2328a3df47242b8de1dc43c8f5f51173813f94f3d66316770f95a80f45f1","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/lug_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":12,"content":[{"type":"heading","content":["Ennaku ze Tumala ku Nsi"]},{"type":"verse","number":1,"content":[{"text":"Jjukiranga omutonzi wo mu nnaku ez’obuvubuka bwo,","poem":1},{"lineBreak":true},{"text":"ng’ennaku embi tezinnakutuukako","poem":1},{"text":"n’emyaka nga teginnasembera,","poem":2},{"lineBreak":true},{"text":"mw’olyogerera nti, “Sizisanyukira”;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ng’enjuba n’obutangaavu,","poem":1},{"text":"omwezi n’emmunyeenye nga tebinnafuuka kizikiza;","poem":2},{"lineBreak":true},{"text":"nga n’ebire biweddemu enkuba;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"abakuumi b’enju mwe balikankanira,","poem":1},{"text":"n’abasajja ab’amaanyi mwe bakutamizibwa,","poem":2},{"text":"nga n’abo abasa baleseeyo okusa, kubanga batono,","poem":1},{"text":"n’abo abalingiza mu butuli nga tebakyalaba;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"nga n’enzigi ez’olekedde enguudo zigaddwawo,","poem":1},{"text":"n’eddoboozi ly’okusa nga livumbedde;","poem":2},{"text":"ng’abasajja bagolokoka olw’eddoboozi ly’ennyonyi,","poem":1},{"text":"naye nga ennyimba zaabwe zivumbedde;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"nga batya buli kiwanvu","poem":1},{"text":"n’akabi akali mu nguudo,","poem":2},{"text":"ng’omubira gumulisizza,","poem":1},{"text":"ng’enseenene yeewalula era nga tewakyali alimu keetaaga kino oba kiri.","poem":2},{"text":"Omuntu n’agenda mu nnyumba ye gy’alimala ekiseera ekiwanvu","poem":1},{"text":"n’abakungubazi ne babuna enguudo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Jjukira omutonzi wo ng’omuguwa gwa ffeeza tegunnakutuka","poem":1},{"text":"oba ebbakuli eya zaabu nga tennayatika,","poem":2},{"text":"ng’ensuwa tennayatikira ku luzzi","poem":1},{"text":"obanga ne nnamuziga tennamenyekera ku luzzi,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ng’enfuufu edda mu ttaka mwe yava,","poem":1},{"text":"n’omwoyo ne gudda eri Katonda eyaguwa omuntu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Obutaliimu! Obutaliimu! Omubuulizi bw’agamba,","poem":1},{"text":"“Buli kintu butaliimu.”","poem":2}]},{"type":"heading","content":["Ebikomererayo"]},{"type":"verse","number":9,"content":["Omubuulizi teyali mugezi kyokka, wabula yayigiriza n’abantu eby’amagezi. Yalowooza n’anoonyereza n’ayiiyaayo engero nnyingi."]},{"type":"verse","number":10,"content":["Omubuulizi yanoonyereza n’afuna ebigambo ebituufu byennyini, ne bye yawandiika byali byesimbu era nga bya mazima."]},{"type":"verse","number":11,"content":["Ebigambo by’abantu abagezi biri ng’emiwunda, engero zino ezakuŋŋaanyizibwa omusumba omu ziri ng’emisumaali egyakomererwa ne ginywezebwa ennyo."]},{"type":"verse","number":12,"content":["Mwana wange weekuume ekintu kyonna ekyongerwako. Okuwandiika ebitabo ebingi tekukoma, n’okuyiga okungi kukooya omubiri."]},{"type":"verse","number":13,"content":[{"text":"Kale byonna biwuliddwa;","poem":1},{"text":"eno y’enkomerero yaabyo:","poem":2},{"text":"Tyanga Katonda okwatenga amateeka ge,","poem":1},{"text":"kubanga ekyo omuntu ky’agwanira okukola.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kubanga Katonda alisala omusango olwa buli kikolwa;","poem":1},{"text":"ekyo ekyakwekebwa,","poem":2},{"lineBreak":true},{"text":"nga kirungi oba nga kibi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ECC/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/SNG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ECC/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}