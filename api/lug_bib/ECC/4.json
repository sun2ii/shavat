{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ECC","translationId":"lug_bib","name":"Omubuulizi","commonName":"Omubuulizi","title":"Ekitabo Ekiyitibwa Omubuulizi","order":21,"numberOfChapters":12,"sha256":"c3dc2328a3df47242b8de1dc43c8f5f51173813f94f3d66316770f95a80f45f1","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/lug_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":4,"content":[{"type":"heading","content":["Amaziga g’Abanyigirizibwa"]},{"type":"verse","number":1,"content":["Ate nalaba okunnyigirizibwa kwonna okukolebwa wansi w’enjuba.",{"text":"Ate laba, amaziga gaabo abanyigirizibwa,","poem":1},{"text":"era nga tebalina wakugabasangulako!","poem":2},{"text":"Ababanyigiriza baalina obuyinza,","poem":1},{"text":"kyokka nga tewali asobola kubagambako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne ndowooza ku abo abaafa,","poem":1},{"lineBreak":true},{"text":"nga baali ba mukisa okusinga","poem":1},{"text":"abo abakyali abalamu;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"naye abasinga abo,","poem":1},{"text":"y’oyo atannaba kuzaalibwa,","poem":2},{"text":"atannalaba bibi","poem":1},{"text":"obukolebwa wansi w’enjuba.","poem":2}]},{"type":"verse","number":4,"content":["Awo ne ndaba ng’okutegana, n’okutuukiriza mu bikolebwa, kuva mu kukwatirwa obuggya muliraanwa. Na kino butaliimu na kugoberera mpewo."]},{"type":"verse","number":5,"content":[{"text":"Omusirusiru awumba emikono gye,","poem":1},{"text":"ne yeezikiriza yekka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kirungi okuba n’emirembe emijjuvu","poem":1},{"text":"okusinga okujjula okubonaabona","poem":2},{"lineBreak":true},{"text":"n’okugoberera empewo.","poem":2}]},{"type":"verse","number":7,"content":["Ate era ne ndaba obutaliimu wansi w’enjuba:"]},{"type":"verse","number":8,"content":[{"text":"nalaba omuntu ng’ali bwannamunigina,","poem":1},{"text":"nga talina mwana wabulenzi wadde muganda we, naye ng’ategana okukamala, nga tamatira na bugagga bwe,","poem":2},{"lineBreak":true},{"text":"ne yeebuuza nti, “Nteganira ani","poem":2},{"lineBreak":true},{"text":"ne neefiiriza essanyu?","poem":2},{"text":"Kino nakyo butaliimu,","poem":1},{"text":"era tekiriiko kye kigasa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ababiri basinga omu,","poem":1},{"text":"kubanga bagasibwa nnyo mu kukola kwabwe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kubanga singa omu agwa,","poem":1},{"text":"munne amuyimusa.","poem":2},{"text":"Naye zimusanze oyo ali obw’omu,","poem":1},{"text":"bw’agwa tabaako amuyimusa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ababiri bwe bagalamira bombi awamu babuguma;","poem":1},{"text":"naye oyo ali obw’omu, ayinza atya okubuguma?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Omu awangulwa mangu,","poem":1},{"text":"kyokka ababiri bayinza okwerwanako.","poem":2},{"text":"Kubanga omuguwa ogw’emiyondo esatu tegukutuka mangu.","poem":1}]},{"type":"verse","number":13,"content":["Omuvubuka omwavu nga mugezi, akira kabaka amusinga emyaka nga musirusiru, atafaayo ku kubuulirirwa."]},{"type":"verse","number":14,"content":["Omuvubuka ayinza okuba ng’avudde mu kkomera n’alya obwakabaka, oba okulya obwakabaka ng’abadde mwavu."]},{"type":"verse","number":15,"content":["Nalaba abalamu bonna abatambula wansi w’enjuba nga bagoberera omuvubuka oyo ow’okulya obwakabaka."]},{"type":"verse","number":16,"content":["Abantu be yafuganga baali bangi nnyo. Naye abo abajja oluvannyuma lwe tebaamusiima. Na kino nakyo butaliimu na kugoberera mpewo."]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ECC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ECC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ECC/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}