{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ECC","translationId":"lug_bib","name":"Omubuulizi","commonName":"Omubuulizi","title":"Ekitabo Ekiyitibwa Omubuulizi","order":21,"numberOfChapters":12,"sha256":"c3dc2328a3df47242b8de1dc43c8f5f51173813f94f3d66316770f95a80f45f1","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/lug_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":7,"content":[{"type":"heading","content":["Okulondawo Ekisinga Obulungi"]},{"type":"verse","number":1,"content":[{"text":"Obwatiikirivu bw’erinnya eddungi businga eby’akawoowo ebirungi;","poem":1},{"text":"n’olunaku olw’okufa lusinga olwo olw’okuzaalirwako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kirungi okulaga mu nnyumba ey’abakungubaga","poem":1},{"text":"okusinga okulaga mu nnyumba ey’ebyassava.","poem":2},{"text":"Kubanga buli omu wa kufa,","poem":1},{"text":"ekyo kiteekwa okuba ku mutima gwa buli muntu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Okunakuwala kusinga okuseka,","poem":1},{"text":"kubanga amaaso amanakuwavu gazzaamu omutima amaanyi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Omutima gw’omugezi guba wamu n’abo abali mu nnaku;","poem":1},{"text":"naye ogw’omusirusiru guba mu kusanyuka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kirungi okussaayo omwoyo ku kunenya kw’omuntu ow’amagezi","poem":1},{"text":"okusinga okuwuliriza ennyimba z’abasirusiru.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Okuseka kw’abasirusiru","poem":1},{"text":"kuli ng’okutulikatulika kw’amaggwa agali mu muliro gw’entamu","poem":2},{"noteId":0},{"text":";","poem":2},{"lineBreak":true},{"text":"na kino nakyo butaliimu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kya mazima, okunyigirizibwa kufuula ow’amagezi okuba omusirusiru,","poem":1},{"text":"n’enguzi efaafaaganya okutegeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Enkomerero y’ekintu esinga entandikwa yaakyo,","poem":1},{"text":"n’omugumiikiriza asinga ow’amalala.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tosunguwalanga mangu nga waliwo akusokaasoka,","poem":1},{"text":"kubanga obusungu bubeera munda y’abasirusiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Teweebuuzanga nti, “Lwaki ennaku ziri ez’edda zisinga zino?”","poem":1},{"text":"Kubanga si kya magezi okwebuuza ekibuuzo ng’ekyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Amagezi kintu kirungi, okufaanana ng’eky’obugagga ky’obusika,","poem":1},{"text":"era kigasa abo abakyalaba enjuba.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Amagezi kiwummulo,","poem":1},{"text":"ng’ensimbi bwe ziri ekiwummulo,","poem":2},{"text":"naye enkizo y’okumanya y’eno:","poem":1},{"text":"amagezi gakuuma obulamu bw’oyo agalina.","poem":2}]},{"type":"verse","number":13,"content":["Lowooza ku Katonda ky’akoze:",{"text":"ani ayinza okugolola ekyo ekyakyama Katonda kye yakola?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ebiseera bwe biba ebirungi, sanyuka;","poem":1},{"text":"naye bwe biba ebibi, kirowoozeeko;","poem":2},{"text":"Katonda eyakola ekimu","poem":1},{"text":"era ye yakola ne kinnaakyo.","poem":2},{"text":"Noolwekyo omuntu tayinza kuzuula kirimubaako","poem":1},{"text":"mu nnaku ze ez’omu maaso.","poem":2}]},{"type":"verse","number":15,"content":["Mu bulamu bwange buno obutaliimu ndabye bino byombi:",{"text":"omutuukirivu azikiririra mu butuukirivu bwe,","poem":1},{"text":"n’omukozi w’ebibi n’awangaalira mu bibi bye.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Teweefuulanga mutuukirivu ayitiridde","poem":1},{"text":"wadde okwefuula ow’amagezi ow’ekitalo;","poem":2},{"lineBreak":true},{"text":"oleme okwezikiriza.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tobanga mwonoonyi kakuzzi","poem":1},{"text":"wadde okuba omusirusiru;","poem":2},{"lineBreak":true},{"text":"oleme okufa ng’ekiseera kyo tekinnatuuka.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ekyo kirungi okiyige, na kiri oleme kukibuusa maaso,","poem":1},{"text":"kubanga oyo atya Katonda abyewala okubiyitiriza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ow’amagezi ne bw’aba omu mu kibuga,","poem":1},{"text":"aba w’amaanyi okusinga abakulembeze ekkumi ab’omu kibuga ekyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ddala ku nsi tekuli muntu mutuukirivu,","poem":1},{"text":"atakola bibi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Towulirizanga buli kigambo, bantu kye boogera,","poem":1},{"text":"si kulwa ng’owulira omuweereza wo ng’akukolimira,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"kubanga naawe okimanyidde ddala mu mutima gwo,","poem":1},{"text":"ng’emirundi mingi okolimidde abalala.","poem":2}]},{"type":"verse","number":23,"content":["Ebyo byonna nabyekenneenya n’amagezi ne ŋŋamba nti,",{"text":"“Mmaliridde okuba omugezi,”","poem":1},{"text":"wabula kino kyandi wala.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Amagezi ne bwe gaba ga kikula ki, gali wala nnyo era tegalojjeka,","poem":1},{"text":"kale ani ayinza okugavumbula?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bwe ntyo ne nkyusa omutima gwange nnoonye okutegeera,","poem":1},{"text":"nekkanye, era nnoonyereze amagezi ndowooze ne ku bintu nga bwe biri,","poem":2},{"text":"n’okutegeera obusirusiru bw’okukola ebibi:","poem":1},{"text":"n’eddalu ery’obusirusiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ekintu kye nalaba eky’obulabe ekisinga okufa,","poem":1},{"text":"ye mukazi alina omutima ogusendasenda,","poem":2},{"text":"era ogusikiriza,","poem":1},{"text":"era emikono gye gisiba ng’enjegere.","poem":2},{"text":"Oyo ayagala Katonda, y’awona omukazi oyo,","poem":1},{"text":"kyokka ye omwonoonyi talema kugwa mu mutego gwe.","poem":2}]},{"type":"verse","number":27,"content":["Omubuulizi agamba nti, “Laba, kino kyenvumbudde:",{"text":"“Okugatta ekintu ku kinnaakyo, okuzuula enkola y’ebintu,","poem":1}]},{"type":"verse","number":28,"content":[{"text":"bwe nnali nga nkyanoonyereza","poem":2},{"lineBreak":true},{"text":"nabulako kye nzuula,","poem":2},{"text":"okuggyako okulaba omusajja omwesimbu omu mu basajja lukumi,","poem":1},{"text":"kyokka mu bakazi bonna ssaalabamu n’omu atuukiridde.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Wabula kino kyokka kye nalaba:","poem":1},{"text":"Katonda yatonda omuntu nga mugolokofu,","poem":2},{"lineBreak":true},{"text":"naye abantu ne beenoonyeza ebintu ebirala bingi.”","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Amaggwa bwe gaba gookebwa, gatulikatulika, ne gavaamu n’omukka, kyokka ebbugumu ly’omuliro gwago tegubugumya bagwota mu biseera eby’obutiti.","reference":{"chapter":7,"verse":6}}]},"thisChapterLink":"/api/lug_bib/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ECC/6.json","previousChapterAudioLinks":{},"numberOfVerses":29}