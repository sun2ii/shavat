{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"EXO","translationId":"lug_bib","name":"Okuva","commonName":"Okuva","title":"Ekitabo Ekiyitibwa Okuva","order":2,"numberOfChapters":40,"sha256":"79d8ff187e311e3f6c065b01d00ec37bebde90fc4213a920d863e2710afb9143","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/lug_bib/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":15,"content":[{"type":"heading","content":["Oluyimba lwa Musa"]},{"type":"verse","number":1,"content":["Awo Musa n’abaana ba Isirayiri ne bayimbira Mukama oluyimba luno nga bagamba nti,",{"text":"“Nnaayimbiranga Mukama,","poem":1},{"text":"kubanga awangudde n’ekitiibwa kingi.","poem":2},{"text":"Asudde mu nnyanja","poem":1},{"text":"embalaasi n’omwebagazi waayo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mukama ge maanyi gange era lwe luyimba lwange,","poem":1},{"text":"era afuuse obulokozi bwange.","poem":2},{"text":"Ye Katonda wange, nange nnaamutenderezanga,","poem":1},{"text":"ye Katonda wa kitange, nange nnaamugulumizanga.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mukama mulwanyi;","poem":1},{"text":"Mukama, ly’erinnya lye.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amagaali ga Falaawo n’eggye lye","poem":1},{"text":"abisudde mu nnyanja;","poem":2},{"text":"n’abaduumizi b’amaggye ge abalondemu","poem":1},{"text":"basaanyeewo mu Nnyanja Emyufu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Obuziba bubasaanikidde;","poem":1},{"text":"basse okutuuka ku ntobo ng’ejjinja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Omukono gwo ogwa ddyo, Ayi Mukama,","poem":1},{"text":"gwalina amaanyi n’ekitiibwa;","poem":2},{"text":"omukono gwo ogwa ddyo, Ayi Mukama,","poem":1},{"text":"gwasesebbula omulabe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mu bukulu obw’ekitiibwa kyo,","poem":1},{"text":"wamegga abalabe bo,","poem":2},{"text":"wabalaga obusungu bwo,","poem":1},{"text":"ne bubasiriiza ng’ebisasiro.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Omukka bwe gwava mu nnyindo zo,","poem":1},{"text":"amazzi ne geetuuma;","poem":2},{"lineBreak":true},{"text":"amazzi g’ebuziba ne geekwata ng’ekisenge wakati mu nnyanja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Omulabe n’ayogera nti,","poem":1},{"text":"‘Ka mbagobe, mbakwate.","poem":2},{"text":"Nnaagabana omunyago;","poem":1},{"text":"mbeemalireko eggoga.","poem":2},{"text":"Nnaasowolayo ekitala kyange,","poem":1},{"text":"ndyoke mbazikirize.’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Naye wakunsa embuyaga zo,","poem":1},{"text":"ennyanja n’ebasaanikira.","poem":2},{"text":"Bakka ng’ekyuma,","poem":1},{"text":"ne basaanawo mu mazzi amangi ag’amaanyi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani akufaanana, Ayi Mukama,","poem":1},{"text":"mu bakatonda bonna?","poem":2},{"text":"Ani akufaanana, ggwe,","poem":1},{"text":"Omutukuvu Oweekitiibwa,","poem":2},{"text":"atiibwa era atenderezebwa,","poem":1},{"text":"akola ebyamagero?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Wagolola omukono gwo ogwa ddyo,","poem":1},{"text":"ensi n’ebamira.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mu kwagala kwo okutaggwaawo,","poem":1},{"text":"abantu be wanunula olibakulembera.","poem":2},{"text":"Mu maanyi go,","poem":1},{"text":"olibatuusa mu kifo kyo ekitukuvu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Amawanga galikiwulira ne gakankana,","poem":1},{"text":"ababeera mu Bufirisuuti balijjula ennaku.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Abakungu b’omu Edomu balitangaalirira nga batidde;","poem":1},{"text":"abakulembeze ab’amaanyi aba Mowaabu balikankana;","poem":2},{"text":"abatuuze b’omu Kanani baliggwaamu endasi.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Okwesisiwala n’entiisa biribajjira.","poem":2},{"text":"Olw’omukono gwo ogw’amaanyi tebalinyega,","poem":1},{"text":"balisirika ng’ejjinja okutuusa abantu bo lwe baliyitawo, Ayi Mukama,","poem":2},{"text":"okutuusa abantu bo, be wanunula,","poem":1},{"text":"lwe baliyitawo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Olibayingiza n’obassa ku lusozi lwo lwe weerondera,","poem":1},{"text":"kye kifo, Ayi Mukama kye weekolera mw’onoobeeranga,","poem":2},{"text":"ekifo kyo Ekitukuvu,","poem":1},{"text":"kye weekolera, Ayi Mukama, n’emikono gyo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mukama anaafuganga","poem":1},{"text":"emirembe n’emirembe.”","poem":2}]},{"type":"heading","content":["Oluyimba lwa Miryamu"]},{"type":"verse","number":19,"content":["Embalaasi za Falaawo, n’amagaali ge, ne basajja be abeebagadde embalaasi bwe baayingira mu nnyanja, Mukama n’akomyawo amazzi ag’ennyanja ne gabasaanikira; naye nga bo abaana ba Isirayiri batambulira ku ttaka kkalu wakati mu nnyanja."]},{"type":"verse","number":20,"content":["Awo Miryamu, nnabbi omukazi era mwannyina wa Alooni, n’akwata ekitaasa; n’abakazi abalala ne bamugoberera nga balina ebitaasa era nga bwe bazina."]},{"type":"verse","number":21,"content":["Miryamu n’abayimbira bw’ati nti,",{"text":"“Muyimbire Mukama,","poem":1},{"text":"kubanga awangudde n’ekitiibwa kingi.","poem":2},{"text":"Asudde mu nnyanja","poem":1},{"text":"embalaasi n’agyebagadde.”","poem":2}]},{"type":"heading","content":["Amazzi g’e Mala n’aga Erimu"]},{"type":"verse","number":22,"content":["Awo Musa n’akulembera Isirayiri, n’abaggya ku Nnyanja Emyufu, ne bayingirira eddungu ly’e Ssuuli. Ne batambulira ennaku ssatu mu ddungu nga tebalabye ku mazzi."]},{"type":"verse","number":23,"content":["Bwe baatuuka e Mala, ne batasobola kunywa ku mazzi gaawo, kubanga gaali gakaawa: era eyo y’ensonga eyatuumisa ekifo ekyo Mala."]},{"type":"verse","number":24,"content":["Abantu ne beemulugunyiza Musa, ne bamubuuza nti, “Tunywe ki?”"]},{"type":"verse","number":25,"content":["Musa ne yeegayirira Mukama; Mukama n’amulaga ekitundu ky’omuti. Bwe yakisuula mu mazzi, amazzi ne gaba malungi okunywa. Mu kifo kino Mukama we yabaweera ekiragiro kino n’etteeka, era n’abagezesa"]},{"type":"verse","number":26,"content":["ng’agamba nti, “Singa muwuliriza eddoboozi lya Mukama Katonda wammwe n’obwegendereza, ne mukola ebyo by’alaba nga bituufu, ne mussaayo omwoyo ku biragiro bye, era ne mugondera amateeka ge, sigenda kubaleetako ndwadde n’emu, ng’ezo ze naleetera Abamisiri, kubanga nze Mukama, nze mbawonya endwadde zammwe.”"]},{"type":"verse","number":27,"content":["Awo ne batuuka mu Erimu, awaali ensulo ekkumi n’ebbiri, n’enkindu ensanvu; ne bakuba awo eweema zaabwe okumpi n’amazzi."]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}