{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"EZK","translationId":"lug_bib","name":"Ezeekyeri","commonName":"Ezeekyeri","title":"Ekitabo Ekiyitibwa Ezeekyeri","order":26,"numberOfChapters":48,"sha256":"04ecc7e187128cd28f4c7f047ab531d6cbf9ab0e5179bf846174a828c32588f3","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/lug_bib/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":19,"content":[{"type":"heading","content":["Okukungubagira Abalangira ba Isirayiri"]},{"type":"verse","number":1,"content":["Kungubagira abalangira ba Isirayiri,"]},{"type":"verse","number":2,"content":["oyogere nti,",{"text":"“ ‘Maama wo nga yali mpologoma nkazi,","poem":1},{"text":"mu mpologoma!","poem":2},{"text":"Yagalamiranga wakati mu mpologoma ento,","poem":1},{"text":"n’erabirira abaana baayo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"N’ekuza emu ku baana baayo","poem":1},{"text":"n’efuuka empologoma ey’amaanyi,","poem":2},{"text":"n’eyiga okuyigga ebisolo,","poem":1},{"text":"n’okulya abantu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amawanga gaawulira ebimufaako,","poem":1},{"text":"n’akwatirwa mu kinnya kye yali asimye,","poem":2},{"text":"ne bamusibamu amalobo","poem":1},{"text":"ne bamuleeta mu nsi y’e Misiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ ‘Awo bwe yalaba essuubi lye nga terituukiridde,","poem":1},{"text":"ne bye yali alindirira nga biyise,","poem":2},{"text":"n’eddira emu ku baana baayo ab’empologoma endala,","poem":1},{"text":"n’egifuula empologoma ey’amaanyi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"N’etambulatambula mu mpologoma,","poem":1},{"text":"kubanga yali efuuse empologoma ey’amaanyi,","poem":2},{"text":"era n’eyiga okuyigga ensolo,","poem":1},{"text":"n’okulya abantu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"N’emenyaamenya ebifo byabwe eby’amaanyi,","poem":1},{"text":"n’ezikiriza n’ebibuga byabwe;","poem":2},{"text":"ensi n’abo bonna abaagibeerangamu,","poem":1},{"text":"ne batya olw’okuwuluguma kwayo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Awo amawanga gonna ne gagirumba,","poem":1},{"text":"okuva mu bitundu ebyali byetooloddewo,","poem":2},{"text":"ne bayanjuluza ekitimba kyabwe,","poem":1},{"text":"ne bagikwatira mu kinnya kyabwe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne bakozesa amalobo okugisikayo,","poem":1},{"text":"ne bagiteeka mu kayumba ak’ebyuma,","poem":2},{"text":"ne bagitwala eri kabaka w’e Babulooni;","poem":1},{"text":"n’eteekebwa mu kkomera,","poem":2},{"lineBreak":true},{"text":"n’etaddayo kuwulikika nate ku nsozi za Isirayiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Maama wo yali ng’omuzabbibu mu nnimiro","poem":1},{"text":"ogwasimbibwa okumpi n’amazzi;","poem":2},{"text":"ne gubala ebibala ne bijjula amatabi,","poem":1},{"text":"kubanga waaliwo amazzi mangi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amatabi gaagwo gaali magumu,","poem":1},{"text":"era nga gasaanira okukolebwamu omuggo gw’obwakabaka.","poem":2},{"text":"Omuzabbibu ogwo gwali muwanvu ne guyitamu","poem":1},{"text":"okusinga emiti emirala,","poem":2},{"text":"ne gumanyibwa olw’obuwanvu bwagwo,","poem":1},{"text":"n’olw’amatabi gaagwo amangi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Naye gwasigulibwa n’ekiruyi","poem":1},{"text":"ne gusuulibwa wansi;","poem":2},{"text":"embuyaga ez’Ebuvanjuba ne zigukaza,","poem":1},{"text":"ebibala byagwo ne biggwaako,","poem":2},{"text":"n’amatabi gaakwo amagumu ne gakala,","poem":1},{"text":"era ne gwokebwa omuliro.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kaakano gusimbiddwa mu ddungu,","poem":1},{"text":"awakalu awatali mazzi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Omuliro gwava ku limu ku matabi,","poem":1},{"text":"ne gwokya amatabi gaagwo n’ebibala byagwo.","poem":2},{"text":"Tewasigadde ttabi ggumu na limu ku gwo","poem":1},{"text":"eriyinza okukolwamu omuggo ogw’obwakabaka.’","poem":2},"Kuno kukungubaga, era kukozesebwa ng’okukungubaga.”"]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}