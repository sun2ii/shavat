{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"EZK","translationId":"lug_bib","name":"Ezeekyeri","commonName":"Ezeekyeri","title":"Ekitabo Ekiyitibwa Ezeekyeri","order":26,"numberOfChapters":48,"sha256":"04ecc7e187128cd28f4c7f047ab531d6cbf9ab0e5179bf846174a828c32588f3","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/lug_bib/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":28,"content":[{"type":"heading","content":["Obunnabbi ku Kabaka w’e Ttuulo"]},{"type":"verse","number":1,"content":["Awo ekigambo kya Mukama Katonda ne kinzijira, n’aŋŋamba nti,"]},{"type":"verse","number":2,"content":["“Omwana w’omuntu, gamba omufuzi w’e Ttuulo nti,",{"text":"“Bw’ati bw’ayogera Mukama Katonda nti,","poem":1},{"text":"Kubanga olina amalala mu mutima gwo kyova oyogera nti,","poem":2},{"text":"‘Ndi katonda,","poem":1},{"text":"era ntuula ku ntebe ey’obwakabaka eya Katonda wakati mu nnyanja,’","poem":2},{"text":"songa oli muntu buntu, so si katonda,","poem":1},{"text":"newaakubadde ng’olowooza nga oli mugezi nga katonda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Oli mugezi okusinga Danyeri?","poem":1},{"text":"Tewali kyama kikukwekeddwa?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mu magezi go ne mu kutegeera kwo","poem":1},{"text":"weefunidde eby’obugagga,","poem":2},{"text":"n’okuŋŋaanya ezaabu n’effeeza","poem":1},{"text":"n’obitereka mu mawanika go.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Olw’obukujjukujju bwo mu by’obusuubuzi","poem":1},{"text":"oyongedde okugaggawala,","poem":2},{"text":"era n’omutima gwo","poem":1},{"text":"gwenyumiririza mu byobugagga bwo.”","poem":2}]},{"type":"verse","number":6,"content":["Mukama Katonda kyava ayogera nti,",{"text":"“Kubanga olowooza ng’oli mugezi,","poem":1},{"text":"ng’oli mugezi nga katonda,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kyendiva nkuleetera bannaggwanga ne bakulumba,","poem":1},{"text":"ab’omu mawanga agasinga obukambwe,","poem":2},{"text":"ne basowola ebitala byabwe eri obulungi n’amagezi go,","poem":1},{"text":"ne boonoona okumasamasa kwo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Balikusuula mu bunnya","poem":1},{"text":"n’ofiira eyo okufa okubi","poem":2},{"lineBreak":true},{"text":"wakati mu gayanja.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Olyogera nate nti, ‘Ndi katonda,’","poem":1},{"text":"mu maaso gaabo abakutta?","poem":2},{"text":"Oliba muntu buntu so si katonda","poem":1},{"text":"mu mikono gy’abo abakutta.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Olifa okufa okw’abatali bakomole, mu mikono gya bannaggwanga,","poem":1},{"text":"nze nkyogedde, bw’ayogera Mukama Katonda.”","poem":2}]},{"type":"verse","number":11,"content":["Ekigambo kya Mukama ne kinzijira, n’aŋŋamba nti,"]},{"type":"verse","number":12,"content":["“Omwana w’omuntu kungubagira kabaka w’e Ttuulo, omutegeeze nti, Bw’ati bw’ayogera Mukama Katonda nti,",{"text":"“ ‘Ggwe wali ekyokulabirako ekituukiridde ng’ojjudde amagezi","poem":1},{"text":"era nga watuukirira mu bulungi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wali mu Adeni,","poem":1},{"text":"ennimiro ya Katonda;","poem":2},{"text":"buli jjinja ery’omuwendo nga likubikako,","poem":1},{"text":"sadio, topazi, alimasi, berulo,","poem":2},{"lineBreak":true},{"text":"onuku, yasipero, safiro,","poem":2},{"lineBreak":true},{"text":"ejjinja erya nnawandagala.","poem":2},{"text":"Okuteekebwateekebwa kwo n’ebikunyweza byakolebwa mu zaabu.","poem":1},{"text":"Era ku lunaku lwe watondebwa, byategekebwa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wali kerubi omukuumi eyafukibwako amafuta,","poem":1},{"text":"nakwawula lwa nsonga eyo.","poem":2},{"text":"Wabeeranga ku lusozi olutukuvu olwa Katonda,","poem":1},{"text":"n’otambulira wakati mu mayinja ag’omuliro.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tewaliiko kya kunenyezebwa kyonna","poem":1},{"text":"okuva ku lunaku lwe watondebwa,","poem":2},{"lineBreak":true},{"text":"okutuusa obutali butuukirivu bwe bwalabika mu ggwe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mu bikolwa byo ebingi,","poem":1},{"text":"wajjula empisa embi,","poem":2},{"lineBreak":true},{"text":"era n’okola ebibi.","poem":2},{"text":"Kyennava nkugoba ku lusozi lwa Katonda,","poem":1},{"text":"mu buswavu obungi ne nkugoba ggwe kerubi eyakuumanga","poem":2},{"lineBreak":true},{"text":"okuva mu mayinja ag’omuliro.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Omutima gwo gwalina amalala","poem":1},{"text":"olw’obulungi bwo,","poem":2},{"text":"ne weelimbalimba","poem":1},{"text":"olw’ekitiibwa kyo.","poem":2},{"text":"Kyennava nkukanyuga ku nsi ne nkufuula","poem":1},{"text":"eky’okusekererwa mu maaso ga bakabaka.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Olw’ebibi byo ebingi n’olw’obukumpanya bwo","poem":1},{"text":"oyonoonye ebifo byo ebitukuvu.","poem":2},{"text":"Kyenava nziggya omuliro mu ggwe","poem":1},{"text":"ne gukusaanyaawo,","poem":2},{"text":"ne nkufuula evvu ku nsi","poem":1},{"text":"wakati mu abo bonna abaakulabanga.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Amawanga gonna agaakumanya","poem":1},{"text":"gaatya nnyo;","poem":2},{"text":"otuuse ku nkomerero embi,","poem":1},{"text":"so tolibeerawo nate ennaku zonna.’ ”","poem":2}]},{"type":"heading","content":["Obunnabbi ku Sidoni"]},{"type":"verse","number":20,"content":["Ekigambo kya Mukama ne kinzijira, n’aŋŋamba nti,"]},{"type":"verse","number":21,"content":["“Omwana w’omuntu kyuka otunuulire Sidoni, obawe obunnabbi,"]},{"type":"verse","number":22,"content":["oyogere nti, ‘Bw’ati bw’ayogera Mukama Katonda nti,",{"text":"“ ‘Nkulinako ensonga, ggwe Sidoni,","poem":1},{"text":"era ndyegulumiza mu ggwe.","poem":2},{"text":"Balimanya nga nze Mukama","poem":1},{"text":"bwe ndimubonereza,","poem":2},{"lineBreak":true},{"text":"ne neeraga mu ye okuba omutukuvu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ndiweereza kawumpuli ku ye, era ndikulukusa","poem":1},{"text":"omusaayi mu nguudo ze.","poem":2},{"text":"Abafu baligwa wakati mu ye,","poem":1},{"text":"ekitala kimulumbe enjuuyi zonna.","poem":2},{"text":"Olwo balimanya nga nze Mukama.","poem":1}]},{"type":"verse","number":24,"content":["“ ‘Tewalibaawo nate eri ennyumba ya Isirayiri omweramannyo ogufumita newaakubadde eriggwa eribafumita okuva mu baliraanwa abalina ettima. Era balimanya nga nze Katonda Ayinzabyonna."]},{"type":"verse","number":25,"content":["“ ‘Bw’ati bw’ayogera Mukama Katonda nti, Bwe ndikuŋŋaanya abantu ba Isirayiri okubaggya mu mawanga gye baasaasaanyizibwa, nditukuzibwa mu bo mu maaso g’amawanga, era balituula mu nsi eyaabwe gye nawa omuddu wange Yakobo."]},{"type":"verse","number":26,"content":["Balituula omwo mirembe, era balizimba amayumba ne basimba n’ennimiro ez’emizabbibu. Bwe ndibonereza baliraanwa baabwe bonna abaabayisa obubi, bo baliba batudde mirembe. Olwo balimanya nga nze Mukama Katonda waabwe.’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/EZK/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/EZK/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/EZK/27.json","previousChapterAudioLinks":{},"numberOfVerses":26}