{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"EZK","translationId":"lug_bib","name":"Ezeekyeri","commonName":"Ezeekyeri","title":"Ekitabo Ekiyitibwa Ezeekyeri","order":26,"numberOfChapters":48,"sha256":"04ecc7e187128cd28f4c7f047ab531d6cbf9ab0e5179bf846174a828c32588f3","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/lug_bib/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":30,"content":[{"type":"heading","content":["Okukungubagira Misiri"]},{"type":"verse","number":1,"content":["Awo ekigambo kya Mukama Katonda ne kinzijira n’aŋŋamba nti,"]},{"type":"verse","number":2,"content":["“Omwana w’omuntu, wa obunnabbi oyogere nti: ‘Bw’ati bw’ayogera Mukama Katonda nti,",{"text":"“ ‘Mwekaabireko mwogere nti,","poem":1},{"text":"“Zibasanze ku lunaku olwo”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"kubanga olunaku luli kumpi,","poem":1},{"text":"olunaku lwa Mukama luli kumpi,","poem":2},{"text":"olunaku olw’ebire","poem":1},{"text":"eri bannaggwanga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ekitala kirirumba Misiri,","poem":1},{"text":"n’ennaku eribeera mu Buwesiyopya.","poem":2},{"text":"Bwe balifiira mu Misiri,","poem":1},{"text":"obugagga bwe bulitwalibwa","poem":2},{"lineBreak":true},{"text":"n’emisingi gyayo girimenyebwa.’","poem":2}]},{"type":"verse","number":5,"content":["Obuwesiyopya, ne Puuti",{"noteId":3},", ne Luudi ne Buwalabu yonna, ne Kubu n’abantu bonna ab’ensi ey’endagaano balittibwa ekitala awamu ne Misiri."]},{"type":"verse","number":6,"content":["“ ‘Bw’ati bw’ayogera Mukama nti,",{"text":"“ ‘Abawagira Misiri baligwa,","poem":1},{"text":"n’amaanyi ge yeewaana nago galimuggwa.","poem":2},{"text":"Okuva ku mulongooti ogw’e Sevene","poem":1},{"text":"baligwa n’ekitala,","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Balirekebwawo","poem":1},{"text":"wakati mu nsi endala ezalekebwawo,","poem":2},{"text":"n’ebibuga byabwe","poem":1},{"text":"biribeera ebimu ku ebyo ebyasaanawo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Olwo balimanya nga nze Mukama","poem":1},{"text":"bwe ndikuma ku Misiri omuliro,","poem":2},{"lineBreak":true},{"text":"n’ababeezi baayo bonna balibetentebwa.","poem":2}]},{"type":"verse","number":9,"content":["“ ‘Ku lunaku olwo ndiweereza ababaka mu byombo okutiisatiisa Obuwesiyopya buve mu bugayaavu bwabwo. Entiisa eribakwata ku lunaku Misiri lwe linakuwala, kubanga entiisa erina okujja."]},{"type":"line_break"},{"type":"verse","number":10,"content":["“ ‘Bw’ati bw’ayogera Mukama Katonda nti,",{"text":"“ ‘Ndimalawo ebibinja by’Abamisiri","poem":1},{"text":"nga nkozesa omukono gwa Nebukadduneeza kabaka w’e Babulooni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ye n’eggye lye, ensi esinga okuba enkambwe mu mawanga,","poem":1},{"text":"balireetebwa okuzikiriza ensi.","poem":2},{"text":"Baligyayo ebitala byabwe","poem":1},{"text":"ne bajjuza ensi ey’e Misiri emirambo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndikaza emigga gya Kiyira,","poem":1},{"text":"ne ntunda ensi eri abantu ababi;","poem":2},{"text":"nga nkozesa bannaggwanga,","poem":1},{"text":"ndizikiriza ensi na buli kintu ekigirimu.","poem":2},"Nze Mukama nkyogedde."]},{"type":"line_break"},{"type":"verse","number":13,"content":["“ ‘Bw’ati bw’ayogera Mukama Katonda nti,",{"text":"“ ‘Ndizikiriza bakatonda baabwe","poem":1},{"text":"ne nzikiriza bakatonda abakole n’emikono mu Noofu.","poem":2},{"text":"Temulibaamu mulangira mu nsi ey’e Misiri nate,","poem":1},{"text":"era ensi yonna ndigireetako entiisa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndifuula Pasulo okuba amatongo,","poem":1},{"text":"ne Zowani ndikikumako omuliro","poem":2},{"lineBreak":true},{"text":"ne mbonereza n’ab’omu No.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndifuka ekiruyi kyange ku Sini,","poem":1},{"text":"ekigo kya Misiri eky’amaanyi,","poem":2},{"lineBreak":true},{"text":"era ndimalawo n’ebibinja bya No.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndikuma omuliro ku Misiri,","poem":1},{"text":"ne Sini baliba mu bubalagaze bungi,","poem":2},{"text":"ne No balitwalibwa omuyaga,","poem":1},{"text":"ne Noofu baliba mu kubonaabona okw’olubeerera.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abavubuka ab’e Oni n’ab’e Pibesesi","poem":1},{"text":"baligwa n’ekitala,","poem":2},{"lineBreak":true},{"text":"n’ebibuga biriwambibwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Enzikiza eriba ku Tapaneese emisana,","poem":1},{"text":"bwe ndimenya ekikoligo kya Misiri,","poem":2},{"lineBreak":true},{"text":"era n’amaanyi ge yeewaana nago galimuggwaamu.","poem":2},{"text":"Alibikkibwa n’ebire","poem":1},{"text":"era n’ebyalo bye biriwambibwa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bwe ntyo bwe ndibonereza Misiri,","poem":1},{"text":"bategeere nga nze Mukama.’ ”","poem":2}]},{"type":"verse","number":20,"content":["Awo mu mwaka ogw’ekkumi n’ogumu, mu mwezi ogw’olubereberye ku lunaku olw’omusanvu, ekigambo kya Mukama ne kinzijira n’aŋŋamba nti,"]},{"type":"verse","number":21,"content":["“Omwana w’omuntu, mmenye omukono gwa Falaawo, ye kabaka w’e Misiri, era laba tegusibiddwa okusiigako eddagala, n’okugussaako ekiwero okugusiba, guleme okufuna amaanyi okukwata ekitala."]},{"type":"verse","number":22,"content":["Mukama Katonda kyava ayogera nti, Nnina ensonga ne Falaawo, ye kabaka w’e Misiri, era ndimenya emikono gye, omulamu ogw’amaanyi n’ogwo ogwamenyekako, ne nsuula ekitala okuva mu mukono gwe."]},{"type":"verse","number":23,"content":["Ndisaasaanya Abamisiri mu mawanga ne mu nsi ennyingi."]},{"type":"verse","number":24,"content":["Ndinyweza emikono gya kabaka w’e Babulooni ne nteeka ekitala mu mukono gwe, naye ndimenya emikono gya Falaawo, era alisindira mu maaso ga kabaka w’e Babulooni, ng’omuntu afumitiddwa anaatera okufa."]},{"type":"verse","number":25,"content":["Ndinyweza emikono gya kabaka w’e Babulooni, naye emikono gya Falaawo giriremala, balyoke bamanye nga nze Mukama. Nditeeka ekitala mu mikono gya kabaka w’e Babulooni, n’akigololera ku nsi y’e Misiri."]},{"type":"verse","number":26,"content":["Ndibunya Abamisiri mu mawanga ne mbasaasaanya ne mu nsi yonna, era balimanya nga nze Mukama.”"]}],"footnotes":[{"noteId":3,"caller":"+","text":"Puuli ne Puuti bye bimu. Puuti ye Libiya oba ekitundu ekyetoolodde n’okutuukira ddala ku Somaliya","reference":{"chapter":30,"verse":5}}]},"thisChapterLink":"/api/lug_bib/EZK/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/EZK/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/EZK/29.json","previousChapterAudioLinks":{},"numberOfVerses":26}