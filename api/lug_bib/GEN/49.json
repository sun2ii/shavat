{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"GEN","translationId":"lug_bib","name":"Olubereberye","commonName":"Olubereberye","title":"Ekitabo Ekiyitibwa Olubereberye","order":1,"numberOfChapters":50,"sha256":"1851219882dbc1ec8c055d0b7ecb1840ba24847b4bade5731b3c5293e8022609","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/lug_bib/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":49,"content":[{"type":"heading","content":["Yakobo Asabira Batabani be Omukisa"]},{"type":"verse","number":1,"content":["Awo Yakobo n’ayita batabani be n’abagamba nti, Mukuŋŋaane, ndyoke mbategeeze ebiribabaako mu nnaku ezijja."]},{"type":"verse","number":2,"content":[{"text":"Mukuŋŋaane muwulire, mwe abaana ba Yakobo,","poem":1},{"text":"muwulirize Isirayiri kitammwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Lewubeeni ggwe mubereberye wange,","poem":1},{"text":"amaanyi gange, ebibala ebibereberye eby’amaanyi gange,","poem":2},{"lineBreak":true},{"text":"ekitiibwa n’obuyinza ebiyitirivu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Naye tafugika, oli ng’amayengo g’ennyanja, naye tokyali wa kitiibwa,","poem":1},{"text":"kubanga walinnya ekitanda kya kitaawo,","poem":2},{"lineBreak":true},{"text":"mu nnyumba yange, n’okyonoona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Simyoni ne Leevi baaluganda,","poem":1},{"text":"ebitala byabwe byakulwanyisa bya maanyi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ayi omwoyo gwange teweetaba mu kuteesa kwabwe.","poem":1},{"text":"Ayi omwoyo gwange teweegatta nabo.","poem":2},{"text":"Kubanga mu busungu bwabwe batta abantu,","poem":1},{"text":"olw’okwekulumbaza kwabwe baatema ente olunywa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Obusungu bwabwe bukolimirwe, kubanga bungi;","poem":1},{"text":"n’obukambwe bwabwe, kubanga bwa ttima.","poem":2},{"text":"Ndibaawula mu Yakobo,","poem":1},{"text":"ndibasaasaanya mu Isirayiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yuda gwe baganda bo banaakutenderezanga.","poem":1},{"text":"Omukono gwo gunaatulugunyanga abalabe bo.","poem":2},{"lineBreak":true},{"text":"Abaana ba kitaawo banaakuvuunamiranga.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yuda, mwana w’empologoma.","poem":1},{"text":"Oyambuse mwana wange, ng’ovudde ku muyiggo.","poem":2},{"text":"Yakutama, yabwama ng’empologoma.","poem":1},{"text":"Ddala ng’empologoma enkazi, ani anaakweŋŋanga?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Era omuggo gw’omufuzi teguuvenga wakati wa bigere bya Yuda,","poem":1},{"text":"okutuusa Siiro lw’alijja;","poem":2},{"text":"era oyo amawanga gonna","poem":1},{"text":"gwe ganaawuliranga.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Alisiba endogoyi ku muzabbibu,","poem":1},{"text":"n’omwana gw’endogoyi ku muzabbibu ogusinga obulungi,","poem":2},{"text":"ayoza ebyambalo bye mu nvinnyo,","poem":1},{"text":"n’engoye ze mu musaayi gwe zabbibu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Amaaso ge galimyuka wayini,","poem":1},{"text":"n’amannyo ge galitukula okusinga amata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Zebbulooni alibeera ku mabbali ga nnyanja;","poem":1},{"text":"anaabanga mwalo gw’amaato,","poem":2},{"lineBreak":true},{"text":"ensalo ze ziriba ku Sidoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Isakaali ndogoyi ya maanyi,","poem":1},{"text":"ng’akutama wakati mu bisibo by’endiga;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"yalaba ng’ekifo ky’okuwummuliramu kirungi;","poem":1},{"text":"nga n’ensi esanyusa;","poem":2},{"text":"n’alyoka akkakkanya ekibegabega kye okusitula,","poem":1},{"text":"n’afuuka omuddu ow’okukozesebwanga emirimu egy’obuwaze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ddaani anaalamulanga mu bwenkanya abantu be","poem":1},{"text":"ng’ekika ekimu ku bika bya Isirayiri.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ddaani anaaba musota mu kkubo,","poem":1},{"text":"essalambwa ku kkubo,","poem":2},{"text":"eriruma ebisinziiro by’embalaasi,","poem":1},{"text":"omwebagazi waayo alyoke agwe emabega waayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Nnindirira obulokozi bwo, Ayi Mukama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Gaadi alirumbibwa ogubiina gw’abanyazi,","poem":1},{"text":"naye ye, alibafubutukira emabega.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Aseri emmere ye eneebanga ngimu,","poem":1},{"text":"era anaagemuliranga kabaka ebyokulya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Nafutaali mpeewo ya ddembe,","poem":1},{"text":"avaamu ebigambo ebirungi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yusufu lye ttabi eribala ennyo,","poem":1},{"text":"ettabi eribala ennyo eriri ku mugga;","poem":2},{"lineBreak":true},{"text":"abaana be babuna bbugwe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Abalasa obusaale baamulumba bubi nnyo,","poem":1},{"text":"baamulasa ne bamulumya nnyo;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"naye omutego gwe ne gunywera,","poem":1},{"text":"n’emikono gye ne gitasagaasagana.","poem":2},{"text":"Olw’omukono gwa Ayinzabyonna owa Yakobo,","poem":1},{"text":"olw’Omusumba, Olwazi lwa Isirayiri,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"olwa Katonda wa kitaawo, akuyamba,","poem":1},{"text":"olwa Ayinzabyonna akuwa omukisa,","poem":2},{"text":"omukisa oguva waggulu mu ggulu,","poem":1},{"text":"omukisa ogwa wansi mu buziba,","poem":2},{"lineBreak":true},{"text":"omukisa ogw’omu lubuto ne mu mabeere.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Omukisa gwa kitaawo","poem":1},{"text":"gusinga omukisa gwa bajjajjange,","poem":2},{"lineBreak":true},{"text":"gusinga egyo egyaweebwa bajjajja ab’edda.","poem":2},{"text":"Gino gyonna gibeere ku mutwe gwa Yusufu,","poem":1},{"text":"gibeere ne ku bukowekowe bw’oyo eyayawukanyizibwa ne baganda be.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Benyamini musege ogunyaga,","poem":1},{"text":"mu makya alya omuyiggo,","poem":2},{"lineBreak":true},{"text":"mu kawungeezi n’agaba omunyago.","poem":2}]},{"type":"verse","number":28,"content":["Ebyo byonna by’ebika ekkumi n’ebiriri ebya Isirayiri, era ebyo kitaabwe bye yayogera nabo ng’abasabira omukisa. Buli omu ng’amusabira omukisa ogumusaanira."]},{"type":"heading","content":["Okufa kwa Yakobo"]},{"type":"verse","number":29,"content":["Oluvannyuma n’abakuutira n’abagamba nti, “Nditwalibwa eri abantu bange gye baatwalibwa. Munziikanga wamu ne bajjajjange, mu mpuku eri mu nnimiro ya Efulooni Omukiiti,"]},{"type":"verse","number":30,"content":["mu mpuku eri mu nnimiro ya Makupeera, okumpi ne Mamule, mu nsi ya Kanani, Ibulayimu gye yagulira mu nnimiro, okuva ku Efulooni Omukiiti. Yagigula okuba obutaka bw’okuziikangamu."]},{"type":"verse","number":31,"content":["Awo we waaziikibwa Ibulayimu ne Saala mukazi we, era ne Isaaka ne Lebbeeka mukazi we, we baaziikwa, era awo we naziika Leeya."]},{"type":"verse","number":32,"content":["Ennimiro n’empuku erimu byagulibwa okuva ku baana ba Kesi.”"]},{"type":"verse","number":33,"content":["Yakobo bwe yamala okukuutira batabani be, n’azaayo ebigere bye mu kitanda, n’assa omukka ogw’enkomerero n’afa n’akuŋŋaanyizibwa eri abantu be."]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}