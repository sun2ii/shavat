{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"HAB","translationId":"lug_bib","name":"Kaabakuuku","commonName":"Kaabakuuku","title":"Ekitabo Ekiyitibwa Kaabakuuku","order":35,"numberOfChapters":3,"sha256":"063e5f5d2a92f45f59155816e522b64009cae323179e365d82ba36090a2f7f12","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/lug_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Buno bwe bubaka bwa Mukama, Kaabakuuku nnabbi bwe yafuna."]},{"type":"line_break"},{"type":"heading","content":["Kaabakuuku Yeemulugunya olw’Obutali Bwenkanya"]},{"type":"verse","number":2,"content":[{"text":"Ayi Mukama, ndituusa ddi okukukaabirira","poem":1},{"text":"naye nga tompuliriza?","poem":2},{"text":"Lwaki nkukaabirira nti, “Ebikolwa eby’obukambwe bimpitiriddeko,”","poem":1},{"text":"naye n’otonnyamba?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lwaki ondaga obutali bwenkanya","poem":1},{"text":"era lwaki ogumiikiriza obukyamu?","poem":2},{"text":"Kubanga okuzikiriza n’ebikolwa eby’obukambwe biri mu maaso gange,","poem":1},{"text":"empaka n’ennyombo byeyongede.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amateeka kyegavudde gatagonderwa","poem":1},{"text":"era n’obwenkanya ne butakolebwa.","poem":2},{"text":"Ababi be basinga abatuukirivu obungi era babeebunguludde,","poem":1},{"text":"n’obwenkanya ne bulinnyirirwa.","poem":2}]},{"type":"heading","content":["Okuddamu kwa Mukama"]},{"type":"verse","number":5,"content":[{"text":"“Mutunuulire amawanga, mwetegereze. Mwewuunyize ddala nnyo.","poem":1},{"lineBreak":true},{"text":"Kubanga ŋŋenda kukola omulimu mu nnaku zammwe","poem":1},{"text":"gwe mutalikkiriza","poem":2},{"lineBreak":true},{"text":"newaakubadde nga mugubuuliddwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kubanga laba, nkuyimusiza Abakaludaaya,","poem":1},{"text":"eggwanga eryo eririna ettima era ekkambwe,","poem":2},{"text":"ababunye ensi eno n’eri","poem":1},{"text":"nga bawamba amawanga agatali gaabwe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ba ntiisa, batiibwa,","poem":1},{"text":"be beetekera amateeka gaabwe era be bagassa mu nkola,","poem":2},{"lineBreak":true},{"text":"nga balwanirira ekitiibwa kyabwe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Embalaasi zaabwe zidduka okukira engo,","poem":1},{"text":"era mu bukambwe zikira emisege egy’ekiro.","poem":2},{"text":"Abasajja abeebagala embalaasi bava mu nsi ey’ewala","poem":1},{"text":"era bajja beesaasaanyizza","poem":2},{"text":"ne banguwa okutuuka ng’ensega bw’erumba ky’eneerya.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Bajja n’eryanyi bonna,","poem":2},{"text":"ebibinja byabwe birumba ng’embuyaga ey’omu ddungu;","poem":1},{"text":"ne balyoka bayoola abawambe abangi ng’omusenyu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Weewaawo, basekerera bakabaka","poem":1},{"text":"ne baduulira n’abakungu.","poem":2},{"text":"Basekerera buli kibuga ekiriko ekigo","poem":1},{"text":"ne bakituumako ebifunfugu ne balinnyira okwo, ne bakiwamba.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Awo ne bayita nga bakunta ng’embuyaga;","poem":1},{"text":"abantu bano omusango be gwasinga, eryanyi lyabwe ye katonda waabwe.”","poem":2}]},{"type":"heading","content":["Kaabakuuku Yeemulugunya Ogwokubiri"]},{"type":"verse","number":12,"content":[{"text":"Ayi Mukama toli wa mirembe na mirembe,","poem":1},{"text":"ggwe Mukama Katonda wange, si ggwe Mutukuvu wange? Tetulifa.","poem":2},{"text":"Ayi Mukama ggwe wabateekawo n’obawa amaanyi batusalire emisango.","poem":1},{"text":"Era ggwe Olwazi, wabateekawo kubonereza.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Amaaso go gajjudde obulongoofu tegatunula ku kibi,","poem":1},{"text":"so toyinza kugumiikiriza bukyamu.","poem":2},{"text":"Kale lwaki ggwe ogumiikiriza ab’enkwe,","poem":1},{"text":"n’osirika ng’omubi amalirawo ddala","poem":2},{"lineBreak":true},{"text":"omuntu amusinga obutuukirivu?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kubanga abantu obafudde ng’ebyennyanja eby’omu nnyanja,","poem":1},{"text":"ng’ebitonde eby’omu nnyanja ebitaliiko abifuga.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Omulabe omubi abakwata bonna ng’eddobo,","poem":1},{"text":"oluusi n’abawalula mu katimba ke,","poem":2},{"text":"n’abakuŋŋaanya mu kiragala kye","poem":1},{"text":"n’alyoka asanyuka n’ajaguza.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kyava awaayo ssaddaaka eri akatimba ke","poem":1},{"text":"n’ayotereza n’ekiragala kye obubaane;","poem":2},{"text":"akatimba ke kamuwa obulamu obw’okwejalabya,","poem":1},{"text":"n’alya emmere ey’ekigagga.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kale, bwe batyo bwe banaalekebwa okutikkula obutimba bwabwe,","poem":1},{"text":"n’okusaanyaawo amawanga awatali kusaasira?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/NAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}