{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"HAB","translationId":"lug_bib","name":"Kaabakuuku","commonName":"Kaabakuuku","title":"Ekitabo Ekiyitibwa Kaabakuuku","order":35,"numberOfChapters":3,"sha256":"063e5f5d2a92f45f59155816e522b64009cae323179e365d82ba36090a2f7f12","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/lug_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":2,"content":[{"type":"heading","content":["Obulamu eri Abatuukirivu"]},{"type":"verse","number":1,"content":[{"text":"Kale ndiyimirira mu kifo kyange we ntera okubeera","poem":1},{"text":"ntunule nga ndi waggulu eyo ku ggulumu","poem":2},{"text":"nnindirire ky’aliŋŋamba,","poem":1},{"text":"era ne kye ndimuddamu ekikwata ku kwemulugunya kw’abantu.","poem":2}]},{"type":"verse","number":2,"content":["Awo Mukama n’anziramu n’ayogera nti,",{"text":"“Wandiika okwolesebwa okwo ku bipande.","poem":1},{"text":"Kuwandiike bulungi","poem":2},{"lineBreak":true},{"text":"ate omubaka gwe banaatuma, akutwale bunnambiro.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kubanga okwolesebwa okwo kujja mu kiseera kyakwo ekigere.","poem":1},{"text":"Kwogera ku by’enkomerero","poem":2},{"lineBreak":true},{"text":"ate si kwa bulimba.","poem":2},{"text":"Bwe kunaaba ng’okuluddewo, mukulindirire,","poem":1},{"text":"kujja kutuukirira, tekugya kulwa.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Laba oyo ow’emmeeme eteri nnongoofu wa kugwa,","poem":1},{"text":"naye omutuukirivu aliba mulamu olw’obwesigwa bwe.”","poem":2}]},{"type":"heading","content":["Akabi eri Aboonoonyi"]},{"type":"verse","number":5,"content":[{"text":"Weewaawo, omwenge mulimba","poem":1},{"text":"guleetera omuntu amalala, ate taguwummulako.","poem":2},{"text":"Ate olwokubanga gwa mululu ng’emagombe, mu butakkuta gufaanana okufa.","poem":1},{"text":"Era okufaanana ng’olumbe, tegukkuta,","poem":2},{"text":"amawanga gonna gugeekuŋŋanyizaako","poem":1},{"text":"ne gugafuula abasibe.","poem":2}]},{"type":"verse","number":6,"content":["“Bano bonna si be balimugererako engero bamusekerere nga bagamba nti,",{"text":"“ ‘Zimusanze oyo eyeyongeza ebitali bibye!","poem":1},{"text":"Oyo eyeetuumako obugagga obuva mu nguzi!’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abakubanja tebalikuyimukirako nga tomanyiridde,","poem":1},{"text":"era tebalizuukuka ne bakweraliikiriza?","poem":2},{"lineBreak":true},{"text":"Oliba togudde mu mikono gyabwe?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kubanga onyaze amawanga mangi,","poem":1},{"text":"abantu abasigaddewo balikunyaga;","poem":2},{"text":"Oyiye omusaayi gw’abantu,","poem":1},{"text":"n’oyonoona ensi n’ebibuga n’abantu bonna ababibeeramu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Zimusanze oyo azimbira amaka ge ku bikolwa ebibi,","poem":1},{"text":"azimba ekisu kye waggulu,","poem":2},{"lineBreak":true},{"text":"okwekuuma obutatuukwako kabi!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wategeka okuzikirira kw’abantu bangi,","poem":1},{"text":"n’oswaza ennyumba yo ne weefiiriza obulamu bwo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amayinja g’oku bbugwe galikaaba,","poem":1},{"text":"n’emikiikiro gy’ebibajje girikyasanguza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Zimusanze oyo azimba ekibuga n’omusaayi,","poem":1},{"text":"atandika ekibuga n’obutali butuukirivu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tekyategekebwa Mukama ow’Eggye","poem":1},{"text":"nti okutegana kw’abantu nku buku za muliro,","poem":2},{"lineBreak":true},{"text":"n’amawanga geemalamu ensa olw’ebintu ebitaliimu?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kubanga ensi erijjula okumanya ekitiibwa kya Mukama,","poem":1},{"text":"ng’amazzi bwe ganjaala ku nnyanja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Zimusanze oyo awa baliraanwa be ekitamiiza","poem":1},{"text":"n’akibafukira okuva mu kita n’abawa banywe okutuusa lwe batamiira","poem":2},{"lineBreak":true},{"text":"asobole okutunuulira ensonyi zaabwe!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Olijjuzibwa ensonyi mu kifo ky’ekitiibwa.","poem":1},{"text":"Naawe olinywa n’oswala.","poem":2},{"text":"Ekikompe eky’omu mukono gwa Mukama ogwa ddyo kirikyusibwa kidde gy’oli,","poem":1},{"text":"n’ensonyi ez’obuwemu zisaanikire ekitiibwa kyo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ebikolwa eby’obukambwe bye watuusa ku Lebanooni,","poem":1},{"text":"n’okutta ensolo, birikutiisa.","poem":2},{"text":"Osse abantu","poem":1},{"text":"n’ozikkiriza ensi n’ebibuga n’abantu ababibeeramu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Ekifaananyi ekyole kigasa ki? Anti kibajje bubazzi.","poem":1},{"text":"Oba ekifaananyi eky’ekyuma, ekisomesa obulimba?","poem":2},{"text":"Kubanga omuweesi yeesiga mirimu gya mikono gye","poem":1},{"text":"nga akola ebifaananyi ebitayogera!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Zimusanze oyo agamba omuti nti, ‘Lamuka;’","poem":1},{"text":"agamba ejjinja nti, ‘Golokoka!’","poem":2},{"text":"Kino kisobola okuluŋŋamya?","poem":1},{"text":"Kibikiddwa zaabu ne ffeeza,","poem":2},{"lineBreak":true},{"text":"so tekiriimu bulamu n’akatono.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Naye Mukama ali mu yeekaalu ye entukuvu:","poem":1},{"text":"ensi zonna zisiriikirire mu maaso ge.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/HAB/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/HAB/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/HAB/1.json","previousChapterAudioLinks":{},"numberOfVerses":20}