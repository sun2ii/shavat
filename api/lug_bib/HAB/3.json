{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"HAB","translationId":"lug_bib","name":"Kaabakuuku","commonName":"Kaabakuuku","title":"Ekitabo Ekiyitibwa Kaabakuuku","order":35,"numberOfChapters":3,"sha256":"063e5f5d2a92f45f59155816e522b64009cae323179e365d82ba36090a2f7f12","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/lug_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["Okusaba kwa Kaabakuuku"]},{"type":"verse","number":1,"content":[{"text":"Okusaba kwa nnabbi Kaabakuuku, okw’Ekisigiyonosi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ayi Mukama, mpulidde ebigambo byo;","poem":1},{"text":"mpulidde ettutumu lyo Ayi Mukama, ne ntya.","poem":2},{"text":"Bizze buggya mu nnaku zaffe,","poem":1},{"text":"bimanyise mu biro bino,","poem":2},{"lineBreak":true},{"text":"era mu busungu jjukira okusaasira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Katonda yajja ng’ava e Temani,","poem":1},{"text":"Omutukuvu oyo ng’ava ku lusozi Palani.","poem":2},{"text":"Ekitiibwa kye kyatimbibwa ku ggulu,","poem":1},{"text":"ensi n’eryoka ejjula ettendo lye.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Okumasamasa kwe ne kulyoka kubeera ng’enjuba evaayo.","poem":1},{"text":"Ebimyanso byayakanga okuva mu mukono gwe,","poem":2},{"lineBreak":true},{"text":"era omwo mwe mwasinziiranga amaanyi ge ag’ekitalo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kawumpuli ye yakulembera,","poem":1},{"text":"Endwadde endala zinaamutta ne zigoberera.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yayimirira n’anyeenyanyeenya ensi;","poem":1},{"text":"Yatunula n’akankanya amawanga.","poem":2},{"text":"Ensozi ez’edda za merenguka,","poem":1},{"text":"obusozi obw’edda ne buggwaawo. Engeri ze, za mirembe na mirembe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nalaba eweema z’e Kusani nga ziri mu nnaku:","poem":1},{"text":"n’entimbe ez’ensi ya Midiyaani nga zijugumira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ayi Mukama, wanyiigira emigga?","poem":1},{"text":"Obusungu bwo bwali ku bugga obutono?","poem":2},{"text":"Wanyiigira ennyanja","poem":1},{"text":"bwe weebagala embalaasi zo,","poem":2},{"lineBreak":true},{"text":"n’olinnya ku magaali go ag’obuwanguzi?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wasowolayo akasaale ko,","poem":1},{"text":"wategeka okulasa obusaale;","poem":2},{"text":"ensi n’ogyawulayawulamu n’emigga.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Ensozi zaakulaba, ne zeenyogootola;","poem":2},{"text":"Amataba ne gayitawo mbiro,","poem":1},{"text":"obuziba bw’ennyanja ne buwuluguma,","poem":2},{"lineBreak":true},{"text":"ne busitula amayengo gaayo waggulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Enjuba n’omwezi ne biyimirira butengerera mu bifo byabyo,","poem":1},{"text":"olw’okumyansa kw’obusaale bwo nga buwenyuka,","poem":2},{"lineBreak":true},{"text":"n’olw’okumyansa kw’effumu lyo eritemagana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Watambula okuyita mu nsi ng’ojjudde ekiruyi,","poem":1},{"text":"wasambirirasambirira amawanga mu busungu bwo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wavaayo oleetere abantu bo obulokozi,","poem":1},{"text":"olokole gwe wafukako amafuta;","poem":2},{"text":"Wabetenta omukulembeze w’ensi ekola ebibi,","poem":1},{"text":"ng’omwerulira ddala okuva ku mutwe okutuuka ku bigere.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wafumita omutwe gwe n’effumu lye ye,","poem":1},{"text":"abalwanyi be bwe baavaayo okutugoba,","poem":2},{"text":"nga bali ng’abanaatumalawo,","poem":1},{"text":"ffe abaali baweddemu essuubi nga twekwese.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Walinnyirira ennyanja n’embalaasi zo,","poem":1},{"text":"n’otabangula amazzi amangi.","poem":2}]},{"type":"heading","content":["Okusanyukira mu Mukama"]},{"type":"verse","number":16,"content":[{"text":"Nawulira, n’omutima gwange ne gukankana","poem":1},{"text":"n’emimwa gyange gijugumira olw’eddoboozi eryo;","poem":2},{"text":"Obuvundu ne buyingira mu magumba gange,","poem":1},{"text":"amagulu gange ne gakankana.","poem":2},{"text":"Naye nnaalindirira n’obugumiikiriza olunaku olw’okulabiramu ennaku","poem":1},{"text":"bwe lulijjira eggwanga eritulumba.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wadde omutiini tegutojjera,","poem":1},{"text":"so n’emizabbibu nga tegiriiko bibala,","poem":2},{"text":"amakungula g’emizeeyituuni ne gabula,","poem":1},{"text":"ennimiro ne zitabala mmere n’akamu,","poem":2},{"text":"endiga nga ziweddemu mu kisibo,","poem":1},{"text":"nga n’ente tezikyalimu mu biraalo,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"kyokka ndijaguliza Mukama,","poem":1},{"text":"ne nsanyukira mu Katonda Omulokozi wange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mukama Katonda, ge maanyi gange;","poem":1},{"text":"afuula ebigere byange okuba ng’eby’empeewo,","poem":2},{"lineBreak":true},{"text":"era ansobozesa okutambulira mu bifo ebigulumivu.","poem":2},{"text":"Ya Mukulu wa Bayimbi, ku bivuga byange ebirina enkoba.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}