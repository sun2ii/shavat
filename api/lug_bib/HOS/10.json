{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"HOS","translationId":"lug_bib","name":"Koseya","commonName":"Koseya","title":"Ekitabo Ekiyitibwa Koseya","order":28,"numberOfChapters":14,"sha256":"31314e24a9fef7d5827cf0e23af5780e2452e57642755c09adbba337e88eebd1","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/lug_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Isirayiri yali muzabbibu ogwagaagadde,","poem":1},{"text":"ogwabala ebibala byagwo.","poem":2},{"text":"Ebibala bye gye byeyongera obungi,","poem":1},{"text":"naye gye yeeyongera okuzimba ebyoto;","poem":2},{"text":"n’ensi ye gye yeeyongera okuba engagga,","poem":1},{"text":"gye yeeyongera okulungiya empagi ze.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Omutima gwabwe mulimba,","poem":1},{"text":"era ekiseera kituuse omusango gubasinge.","poem":2},{"text":"Mukama alimenya ebyoto byabwe,","poem":1},{"text":"era alizikiriza empagi zaabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Olwo balyogera nti, “Tetulina kabaka","poem":1},{"text":"kubanga tetwatya Mukama.","poem":2},{"text":"Naye ne bwe twandibadde ne kabaka,","poem":1},{"text":"yanditukoleddeyo ki?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Basuubiza bingi,","poem":1},{"text":"ne balayirira obwereere","poem":2},{"lineBreak":true},{"text":"nga bakola endagaano;","poem":2},{"text":"emisango kyegiva givaayo","poem":1},{"text":"ng’omuddo ogw’obutwa mu nnimiro ennime.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abatuuze b’e Samaliya bali mu ntiisa","poem":1},{"text":"olw’ennyana ensaanuuse ey’e Besaveni.","poem":2},{"text":"Abantu baayo baligikungubagira,","poem":1},{"text":"ne bakabona baayo abaweereza bakatonda abalala,","poem":2},{"text":"abaasanyukanga olw’ekitiibwa kyayo baligikungubagira,","poem":1},{"text":"kubanga ekitiibwa kyayo kigivuddeko.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Erisutulibwa n’etwalibwa e Bwasuli","poem":1},{"text":"n’eweebwa kabaka omukulu ng’ekirabo.","poem":2},{"text":"Efulayimu aliswazibwa","poem":1},{"text":"ne Isirayiri alikwatibwa ensonyi olw’ekiteeso kye.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Samaliya ne kabaka we balitwalibwa","poem":1},{"text":"ng’ekibajjo eky’omuti ku mazzi n’azikirizibwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ebifo ebigulumivu eby’obutali butuukirivu birisaanyizibwawo,","poem":1},{"text":"kye kibi kya Isirayiri.","poem":2},{"text":"Amaggwa n’amatovu galimera ku byoto byabwe,","poem":1},{"text":"ne gabibikka.","poem":2},{"text":"Olwo ne bagamba ensozi nti, “Mutubuutikire,”","poem":1},{"text":"n’obusozi nti, “Mutugweko.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Okuva mu nnaku za Gibea, wayonoona, ggwe Isirayiri","poem":1},{"text":"era eyo gye wagugubira.","poem":2},{"text":"Entalo tezakwatira abakozi b’ebibi mu Gibea?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bwe ndiba nga njagadde, ndibabonereza;","poem":1},{"text":"amawanga galikuŋŋaana okulwana nabo,","poem":2},{"lineBreak":true},{"text":"ne basibibwa mu masanga olw’ebibi byabwe eby’emirundi ebiri.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efulayimu nnyana ntendeke","poem":1},{"text":"eyagala okuwuula;","poem":2},{"text":"kyendiva nteeka ekikoligo","poem":1},{"text":"mu nsingo ye ennungi.","poem":2},{"text":"Ndigoba Efulayimu","poem":1},{"text":"ne Yuda ateekwa okulima","poem":2},{"lineBreak":true},{"text":"ne Yakobo ateekwa okukabala.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Musige ensigo ez’obutuukirivu,","poem":1},{"text":"mukungule ebibala eby’okwagala okutaggwaawo;","poem":2},{"text":"mukabale ettaka lyammwe eritali ddime,","poem":1},{"text":"kubanga ekiseera kituuse okunoonya Mukama,","poem":2},{"text":"okutuusa lw’alidda","poem":1},{"text":"n’abafukako obutuukirivu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Naye mwasimba obutali butuukirivu","poem":1},{"text":"ne mukungula ebibi,","poem":2},{"lineBreak":true},{"text":"era mulidde ebibala eby’obulimba.","poem":2},{"text":"Olw’okwesiga amaanyi go,","poem":1},{"text":"n’abalwanyi bo abangi,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"olutalo kyeluliva lubawuumira mu matu,","poem":1},{"text":"n’ebigo byammwe byonna ne bizikirizibwa,","poem":2},{"text":"nga Sulemaani bwe yazikiriza Beswaluberi ku lunaku olw’olutalo,","poem":1},{"text":"abakyala ba nnakazadde lwe baggundwa ku ttaka n’abaana baabwe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bwe kityo bwe kiribeera, ggwe Besweri","poem":1},{"text":"kubanga ekibi kyo kinene nnyo.","poem":2},{"text":"Olunaku olwo bwe lulituuka,","poem":1},{"text":"kabaka wa Isirayiri alizikiririzibwa ddala.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}