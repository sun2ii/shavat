{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"HOS","translationId":"lug_bib","name":"Koseya","commonName":"Koseya","title":"Ekitabo Ekiyitibwa Koseya","order":28,"numberOfChapters":14,"sha256":"31314e24a9fef7d5827cf0e23af5780e2452e57642755c09adbba337e88eebd1","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/lug_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["Okwagala kwa Katonda eri Isirayiri"]},{"type":"verse","number":1,"content":[{"text":"“Isirayiri bwe yali omwana omuto, namwagala,","poem":1},{"text":"era namuyita okuva mu Misiri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Naye buli lwe nayongeranga okuyita Isirayiri,","poem":1},{"text":"nabo gye beeyongeranga okusemberayo","poem":2},{"text":"ne bawaayo ssaddaaka eri Babaali,","poem":1},{"text":"ne bootereza ebifaananyi ebyole obubaane.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nze nayigiriza Efulayimu okutambula,","poem":1},{"text":"nga mbakwata ku mukono;","poem":2},{"text":"naye tebategeera","poem":1},{"text":"nga nze nabawonya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nabakulembera n’emiguwa egy’okusaasira okw’obuntu,","poem":1},{"text":"n’ebisiba eby’okwagala.","poem":2},{"text":"Naggya ekikoligo mu bulago bwabwe","poem":1},{"text":"ne neetoowaza ne mbaliisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Tebaliddayo mu nsi ya Misiri,","poem":1},{"text":"era Obwasuli tebulibafuga","poem":2},{"lineBreak":true},{"text":"kubanga baagaana okwenenya?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ekitala kirimyansiza mu bibuga byabwe","poem":1},{"text":"ne kizikiriza ebisiba ebya wankaaki waabwe,","poem":2},{"lineBreak":true},{"text":"ne kikomya enteekateeka zaabwe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abantu bange bamaliridde okunvaako.","poem":1},{"text":"Ne bwe banaakoowoola oyo Ali Waggulu Ennyo,","poem":2},{"lineBreak":true},{"text":"taabagulumize.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Nnyinza ntya okukuleka ggwe Efulayimu?","poem":1},{"text":"Nnyinza ntya okukuwaayo ggwe Isirayiri?","poem":2},{"text":"Nnyinza ntya okukufuula nga Aduma?","poem":1},{"text":"Nnyinza ntya okukukola nga Zeboyimu?","poem":2},{"text":"Omutima gwange gwekyusiza munda yange,","poem":1},{"text":"Mpulira nkukwatiddwa ekisa kingi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Siikole ng’obusungu bwange obungi bwe buli,","poem":1},{"text":"so siridda kuzikiriza Efulayimu;","poem":2},{"text":"kubanga siri muntu wabula ndi Katonda,","poem":1},{"text":"Omutukuvu wakati mu mmwe:","poem":2},{"lineBreak":true},{"text":"sirijja na busungu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Baligoberera Mukama;","poem":1},{"text":"era aliwuluguma ng’empologoma.","poem":2},{"text":"Bw’aliwuluguma,","poem":1},{"text":"abaana be balijja nga bakankana okuva ebugwanjuba.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Balijja nga bakankana","poem":1},{"text":"ng’ebinyonyi ebiva e Misiri,","poem":2},{"lineBreak":true},{"text":"era ng’enjiibwa eziva mu Bwasuli.","poem":2},{"text":"Ndibafuula abatuuze mu maka gaabwe,”","poem":1},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"heading","content":["Ekibi kya Isirayiri"]},{"type":"verse","number":12,"content":[{"text":"Efulayimu aneebunguluzza obulimba,","poem":1},{"text":"n’ennyumba ya Isirayiri eneebunguluzza obukuusa,","poem":2},{"text":"ne Yuda ajeemedde Katonda,","poem":1},{"text":"ajeemedde omwesigwa Omutukuvu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}