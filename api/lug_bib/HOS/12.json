{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"HOS","translationId":"lug_bib","name":"Koseya","commonName":"Koseya","title":"Ekitabo Ekiyitibwa Koseya","order":28,"numberOfChapters":14,"sha256":"31314e24a9fef7d5827cf0e23af5780e2452e57642755c09adbba337e88eebd1","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/lug_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Efulayimu alya mpewo;","poem":1},{"text":"agoba empewo ez’ebuvanjuba olunaku lwonna,","poem":2},{"lineBreak":true},{"text":"era bongera ku bulimba ne ku ttemu.","poem":2},{"text":"Bakola endagaano n’Obwasuli,","poem":1},{"text":"n’aweereza n’amafuta e Misiri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mukama alina ensonga ne Yuda,","poem":1},{"text":"era alibonereza Yakobo ng’engeri ze bwe ziri.","poem":2},{"lineBreak":true},{"text":"Amusasule ng’ebikolwa bye bwe biri.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bwe yali mu lubuto lwa nnyina yakwata muganda we ku kisinziiro,","poem":1},{"text":"ne mu bukulu bwe n’ameggana ne Katonda.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yameggana ne malayika n’amuwangula,","poem":1},{"text":"n’akaaba n’amwegayirira.","poem":2},{"text":"Yamusisinkana e Beseri,","poem":1},{"lineBreak":true},{"text":"n’ayogera naye.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mukama Katonda ow’Eggye,","poem":1},{"text":"Mukama ly’erinnya lye erijjukirwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Naye oteekwa okudda eri Katonda wo;","poem":1},{"text":"kuuma okwagala n’obwenkanya,","poem":2},{"lineBreak":true},{"text":"olindirirenga Katonda wo ennaku zonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Omusuubuzi akozesa ebipimo eby’obulimba,","poem":1},{"text":"era anyumirwa okukumpanya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Efulayimu yeewaana ng’ayogera nti,","poem":1},{"text":"“Ndi mugagga nnyo, nfunye ebintu bingi.","poem":2},{"text":"Mu bugagga bwange bwonna, tebayinza kundabamu kibi","poem":1},{"text":"wadde okwonoona kwonna.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nze Mukama Katonda wo,","poem":1},{"text":"eyakuggya mu Misiri;","poem":2},{"text":"ndikuzzaayo n’obeera mu weema nate,","poem":1},{"text":"nga mu nnaku ez’embaga ezaalagirwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nayogera eri bannabbi,","poem":1},{"text":"ne mbawa okwolesebwa kungi,","poem":2},{"lineBreak":true},{"text":"ne mbagerera engero nga mpita mu bo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gireyaadi butali butuukirivu","poem":1},{"text":"era n’abantu baamu butaliimu.","poem":2},{"text":"Mu Gireyaadi basalirayo ente ennume ne baziwaayo nga ssaddaaka,","poem":1},{"text":"era ebyoto byabwe binaaba ng’entuumo ey’amayinja mu nnimiro ennime.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yakobo yaddukira mu nsi ya Alamu;","poem":1},{"noteId":5},{"text":"Isirayiri yaweereza okufuna omukazi,","poem":2},{"lineBreak":true},{"text":"era okumufuna yalundanga ndiga.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mukama yakozesa nnabbi okuggya Isirayiri mu Misiri,","poem":1},{"text":"era n’akozesa nnabbi okumukuuma.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Naye Efulayimu amusoomoozezza era amusunguwazizza,","poem":1},{"text":"Mukama we kyaliva amutekako omusango olw’omusaayi gwe yayiwa,","poem":2},{"lineBreak":true},{"text":"n’amusasula olw’obunyoomi bwe.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Alamu bwe bukiikakkono obw’ebugwanjuba bwa Mesopotamiya","reference":{"chapter":12,"verse":12}}]},"thisChapterLink":"/api/lug_bib/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}