{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"HOS","translationId":"lug_bib","name":"Koseya","commonName":"Koseya","title":"Ekitabo Ekiyitibwa Koseya","order":28,"numberOfChapters":14,"sha256":"31314e24a9fef7d5827cf0e23af5780e2452e57642755c09adbba337e88eebd1","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/lug_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"heading","content":["Mukama Asunguwalira Isirayiri"]},{"type":"verse","number":1,"content":[{"text":"Efulayimu buli lwe yayogeranga, abantu baakankananga.","poem":1},{"text":"Yagulumizibwanga mu Isirayiri.","poem":2},{"lineBreak":true},{"text":"Naye bwe yayonoona olw’okusinza Baali, n’afa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne kaakano bongera okwonoona;","poem":1},{"text":"ne beekolera ebifaananyi ebisaanuuse mu ffeeza yaabwe,","poem":2},{"text":"ng’okutegeera kwabwe bwe kuli,","poem":1},{"text":"nga byonna mulimu gw’abaweesi.","poem":2},{"text":"Kigambibwa nti,","poem":1},{"text":"“Bawaayo ssaddaaka ez’abantu,","poem":2},{"lineBreak":true},{"text":"ne banywegera ebifaananyi eby’ennyana.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kyebaliva babeera ng’olufu olw’oku makya,","poem":1},{"text":"oba ng’omusulo oguvaawo amangu,","poem":2},{"lineBreak":true},{"text":"ng’ebisusunku embuyaga ze bifumuula okubiggya mu gguuliro,","poem":2},{"lineBreak":true},{"text":"oba ng’omukka ogufulumira mu ddirisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Nze Mukama Katonda wo","poem":1},{"text":"eyakuggya mu nsi ya Misiri;","poem":2},{"text":"so tolimanya Katonda mulala wabula nze,","poem":1},{"text":"so tewali mulokozi wabula nze.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nakulabirira mu ddungu,","poem":1},{"text":"mu nsi ey’ekyeya ekingi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bwe nabaliisa, bakkuta;","poem":1},{"text":"bwe bakkuta ne beegulumiza,","poem":2},{"lineBreak":true},{"text":"bwe batyo ne banneerabira.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kyendiva mbalumba ng’empologoma,","poem":1},{"text":"era ndibateegera ku kkubo ng’engo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ng’eddubu erinyagiddwako abaana baalyo,","poem":1},{"text":"ndibalumba ne mbataagulataagula.","poem":2},{"text":"Era okufaananako ng’empologoma bw’ekola ndibaliira eyo,","poem":1},{"text":"ensolo ey’omu nsiko eribataagulataagula.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndibazikiriza mmwe Isirayiri,","poem":1},{"text":"kubanga munnwanyisa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kabaka wammwe ali wa, abalokole?","poem":1},{"text":"Abafuzi ab’omu bibuga byo byonna bali ludda wa,","poem":2},{"text":"be wayogerako nti,","poem":1},{"text":"‘Tuwe kabaka n’abafuzi?’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nabawa kabaka nga nsunguwadde,","poem":1},{"text":"ate ne mmubaggyako nga ndiko ekiruyi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Omusango gwa Efulayimu guterekeddwa,","poem":1},{"text":"era n’ekibi kye kimanyiddwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Obubalagaze ng’obw’omukyala alumwa okuzaala bumujjira,","poem":1},{"text":"naye omwana olw’obutaba n’amagezi,","poem":2},{"text":"ekiseera bwe kituuka,","poem":1},{"text":"tavaayo mu lubuto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Ndibanunulayo mu maanyi g’emagombe,","poem":1},{"text":"era ndibalokola mu kufa.","poem":2},{"text":"Ggwe kufa, endwadde zo ziri ludda wa?","poem":1},{"text":"Ggwe Magombe, okuzikiriza kwo kuli ludda wa?","poem":2},{"lineBreak":true},{"text":"“Sirimusaasira,","poem":1}]},{"type":"verse","number":15,"content":[{"text":"ne bw’anaakulaakulana mu baganda be.","poem":2},{"text":"Empewo ey’ebuvanjuba erijja okuva eri Mukama,","poem":1},{"text":"ng’eva mu ddungu,","poem":2},{"text":"n’ensulo ze ne zikalira,","poem":1},{"text":"n’oluzzi lwe ne lukalira.","poem":2},{"text":"Eggwanika lye lirinyagibwa,","poem":1},{"text":"eby’omuwendo byonna ne bitwalibwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abantu b’e Samaliya balivunaanibwa omusango gwabwe","poem":1},{"text":"kubanga bajeemedde Katonda waabwe.","poem":2},{"text":"Balittibwa n’ekitala, n’abaana baabwe abato balibetentebwa,","poem":1},{"text":"n’abakyala baabwe abali embuto balibaagibwa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":16}