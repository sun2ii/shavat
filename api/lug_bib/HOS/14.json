{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"HOS","translationId":"lug_bib","name":"Koseya","commonName":"Koseya","title":"Ekitabo Ekiyitibwa Koseya","order":28,"numberOfChapters":14,"sha256":"31314e24a9fef7d5827cf0e23af5780e2452e57642755c09adbba337e88eebd1","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/lug_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"heading","content":["Okwenenya Kuleeta Omukisa"]},{"type":"verse","number":1,"content":[{"text":"Mudde eri Mukama Katonda wammwe, ggwe Isirayiri.","poem":1},{"text":"Ebibi byammwe bye bibaleetedde okugwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mudde eri Mukama","poem":1},{"text":"nga mwogera ebigambo bino nti,","poem":2},{"text":"“Tusonyiwe ebibi byaffe byonna,","poem":1},{"text":"otwanirize n’ekisa,","poem":2},{"lineBreak":true},{"text":"bwe tutyo tunaawaayo ebibala by’akamwa kaffe, ng’ebiweebwayo eby’ente ennume.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Obwasuli tebusobola kutulokola;","poem":1},{"text":"Tetujja kwebagala mbalaasi ez’omu ntalo.","poem":2},{"text":"Tetuliddayo kwogera nate nti, ‘Bakatonda baffe,’","poem":1},{"text":"nga twogera ku bintu bye twekoledde n’emikono gyaffe,","poem":2},{"lineBreak":true},{"text":"kubanga mu ggwe, bamulekwa mwe bajja okusaasirwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ndibalekesaayo empisa zaabwe embi,","poem":1},{"text":"ne mbaagala awatali kye mbasalidde kya kusasula.","poem":2},{"lineBreak":true},{"text":"Kubanga obusungu bwange butanudde okubavaako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndifaanana ng’omusulo eri Isirayiri:","poem":1},{"text":"alimulisa ng’eddanga,","poem":2},{"text":"era alisimba emirandira ng’emivule gy’e Lebanooni.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Amatabi ge amato galikula;","poem":2},{"text":"n’obulungi bwe buliba ng’omuzeyituuni,","poem":1},{"text":"n’akaloosa ke kaliba ng’akaloosa k’omuvule gw’e Lebanooni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abantu balibeera nate wansi w’ekisiikirize kye,","poem":1},{"text":"era alibala ng’emmere ey’empeke.","poem":2},{"text":"Alimulisa ng’omuzabbibu,","poem":1},{"text":"era alyatiikirira nga wayini ow’e Lebanooni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ggwe Efulayimu mugabo ki gwe nnina mu bakatonda bo?","poem":1},{"text":"Ndimwanukula ne mulabirira.","poem":2},{"text":"Nninga omuberosi omugimu, era n’ebibala byo biva mu nze.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abalina amagezi bategeera ensonga zino,","poem":1},{"text":"era abakabakaba balibimanya.","poem":2},{"text":"Amakuba ga Mukama matuufu,","poem":1},{"text":"n’abatuukirivu bagatambuliramu,","poem":2},{"lineBreak":true},{"text":"naye abajeemu bageesittaliramu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}