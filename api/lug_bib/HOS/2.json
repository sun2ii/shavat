{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"HOS","translationId":"lug_bib","name":"Koseya","commonName":"Koseya","title":"Ekitabo Ekiyitibwa Koseya","order":28,"numberOfChapters":14,"sha256":"31314e24a9fef7d5827cf0e23af5780e2452e57642755c09adbba337e88eebd1","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/lug_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["“Mwogere ku baganda bammwe nti, ‘bantu bange,’ mwogere ne ku bannyinammwe nti, ‘baagalwa bange.’ ”"]},{"type":"heading","content":["Okubonerezebwa kwa Isirayiri, n’Okuzzibwa Obuggya kwabwe"]},{"type":"verse","number":2,"content":[{"text":"Munenye nnyammwe,","poem":1},{"text":"mumunenye,","poem":2},{"lineBreak":true},{"text":"kubanga si mukazi wange, so nange siri bba.","poem":2},{"text":"Aggyewo obukaba obuli mu maaso ge,","poem":1},{"text":"n’obwenzi obuva wakati w’amabeere ge;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"nneme okumwambulira ddala","poem":1},{"text":"ne mmulekeraawo nga bwe yali ku lunaku kwe yazaalibwa;","poem":2},{"text":"ne mmufuula ng’eddungu,","poem":1},{"text":"ne mmulekawo ng’ensi enkalu eteriiko ky’egasa,","poem":2},{"lineBreak":true},{"text":"ne mmussa ennyonta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sirilaga kwagala kwange eri abaana be,","poem":1},{"text":"kubanga baana ba bwenzi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nnyabwe yakola obwenzi,","poem":1},{"text":"n’abazaalira mu buwemu.","poem":2},{"text":"Yayogera nti, “Ndigenda eri baganzi bange abampa emmere n’amazzi,","poem":1},{"text":"n’ebimbugumya n’ebyokwambala,","poem":2},{"lineBreak":true},{"text":"n’amafuta n’ekyokunywa.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kyendiva nziba ekkubo lye n’amaggwa,","poem":1},{"text":"ne mmuzimbako bbugwe okumwetooloola, aleme okulaba ekkubo wayitira.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aligezaako okugoberera baganzi be abakwate,","poem":1},{"text":"naye talibatuukako, alibanoonya naye talibalaba.","poem":2},{"text":"Oluvannyuma alyogera nti, “Naagenda eri bba wange eyasooka,","poem":1},{"text":"kubanga mu biro ebyo nabanga bulungi","poem":2},{"lineBreak":true},{"text":"okusinga bwe ndi kaakano.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tajjukira nga nze namuwanga eŋŋaano,","poem":1},{"text":"ne wayini n’amafuta,","poem":2},{"text":"era eyamuwa effeeza ne zaabu","poem":1},{"text":"bye baakozesanga okuweerezanga Baali.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Kyendiva neddiza emmere yange ey’empeke ng’eyengedde,","poem":1},{"text":"ne wayini wange ng’atuuse;","poem":2},{"text":"era nzija kumuggyako ebyambalo byange eby’ebbugumu n’ebyambalo byange ebya bulijjo,","poem":1},{"text":"bye yayambalanga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Era kyenaava nyanika obukaba bwe","poem":1},{"text":"mu maaso ga baganzi be,","poem":2},{"lineBreak":true},{"text":"so tewaliba amuwonya mu mukono gwange.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndikomya ebinyumu bye byonna, n’embaga ze eza buli mwaka,","poem":1},{"text":"n’embaga ze ez’emyezi egyakaboneka, ne ssabbiiti ze,","poem":2},{"lineBreak":true},{"text":"n’enkuŋŋaana ze zonna entukuvu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndizikiriza emizabbibu gye n’emitiini gye,","poem":1},{"text":"gye yayogerako nti, ‘Guno gwe musaala baganzi bange gwe bansasula.’","poem":2},{"text":"Ndibizisa,","poem":1},{"text":"era n’ensolo ez’omu nsiko ziribyonoona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndimubonereza olw’ennaku","poem":1},{"text":"ze yayotereza obubaane eri Babaali,","poem":2},{"text":"ne yeeyambaza empeta n’ebintu eby’omuwendo ennyo,","poem":1},{"text":"n’agenda eri baganzi be,","poem":2},{"lineBreak":true},{"text":"naye nze n’aneerabira,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kale kyendiva musendasenda,","poem":1},{"text":"ne mmutwala mu ddungu,","poem":2},{"lineBreak":true},{"text":"ne njogera naye n’eggonjebwa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Era eyo ndimuddiza ennimiro ze ez’emizabbibu,","poem":1},{"text":"ne nfuula Ekiwonvu kya Akoli","poem":2},{"noteId":0},{"text":"oluggi olw’essuubi.","poem":2},{"text":"Alimpuliriza nga bwe yampulirizanga mu nnaku ez’obuvubuka bwe,","poem":1},{"text":"era nga mu biro bye yaviira mu nsi ya Misiri.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Ku lunaku olwo,” bw’ayogera Mukama,","poem":1},{"text":"“olimpita nti, ‘mwami wange;’","poem":2},{"lineBreak":true},{"text":"toliddayo nate kumpita, ‘Mukama wange.’ ”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndiggya amannya ga Babaali mu kamwa ke,","poem":1},{"text":"so taliddayo nate okwasanguza amannya gaabwe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ku lunaku olwo ndibakolera endagaano","poem":1},{"text":"n’ensolo ez’omu nsiko n’ennyonyi ez’omu bbanga,","poem":2},{"lineBreak":true},{"text":"n’ebyewalula ku ttaka,","poem":2},{"text":"era ndiggyawo obusaale, n’ekitala, n’entalo mu nsi,","poem":1},{"text":"bonna ne batuula mirembe.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Era ndikwogereza ennaku zonna,","poem":1},{"text":"ndikwogereza mu butuukirivu, ne mu mazima,","poem":2},{"lineBreak":true},{"text":"ne mu kwagala ne mu kusaasira.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ndikwogereza mu bwesigwa,","poem":1},{"text":"era olimanya Mukama.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“Ku lunaku olwo,","poem":1},{"text":"ndyanukula eggulu,","poem":2},{"text":"nalyo ne lyanukula ensi;","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ensi erimeramu emmere ey’empeke,","poem":1},{"text":"ne wayini n’amafuta,","poem":2},{"text":"nabyo ne bifunibwa Yezuleeri,","poem":1},{"noteId":1},{"text":"”","poem":1},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“Ndimwesimbira mu nsi,","poem":1},{"text":"ndisaasira oyo eyayitibwanga nti, atasaasirwa,","poem":2},{"text":"era ndigamba abataali bantu bange nti, ‘Bantu bange,’","poem":1},{"text":"era nabo balyogera nti, ‘Ggwe Katonda wange.’ ”","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Akoli kitegeeza emitawaana","reference":{"chapter":2,"verse":15}},{"noteId":1,"caller":"+","text":"Yezuleeri kitegeeza Katonda asimba","reference":{"chapter":2,"verse":22}}]},"thisChapterLink":"/api/lug_bib/HOS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/HOS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/HOS/1.json","previousChapterAudioLinks":{},"numberOfVerses":23}