{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"HOS","translationId":"lug_bib","name":"Koseya","commonName":"Koseya","title":"Ekitabo Ekiyitibwa Koseya","order":28,"numberOfChapters":14,"sha256":"31314e24a9fef7d5827cf0e23af5780e2452e57642755c09adbba337e88eebd1","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/lug_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["Okulabula eri Isirayiri"]},{"type":"verse","number":1,"content":[{"text":"Muwulire ekigambo kya Mukama, mmwe abantu ba Isirayiri,","poem":1},{"text":"kubanga Mukama abalinako ensonga","poem":2},{"lineBreak":true},{"text":"mmwe abatuula mu nsi.","poem":2},{"text":"“Obwesigwa n’okwagala Katonda,","poem":1},{"text":"n’okumumanya bikendedde mu nsi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Waliwo okukolima, n’okulimba, n’okutta,","poem":1},{"text":"n’okubba, n’okukola eby’obwenzi;","poem":2},{"text":"bawaguza,","poem":1},{"text":"era bayiwa omusaayi obutakoma.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ensi kyeneeva ekaaba,","poem":1},{"text":"ne bonna abagibeeramu ne bafuuka ekitagasa;","poem":2},{"text":"n’ensolo enkambwe ez’omu nsiko zirifa, n’ennyonyi ez’omu bbanga nazo zirifa,","poem":1},{"text":"n’ebyennyanja ebiri mu nnyanja ne bifa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Naye temuloopagana,","poem":1},{"text":"so tewabaawo muntu avunaana munne,","poem":2},{"text":"kubanga ensonga","poem":1},{"text":"ngivunaana gwe kabona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wakola ebibi emisana n’ekiro,","poem":1},{"text":"ne bannabbi ne babikolera wamu naawe;","poem":2},{"text":"kyendiva nzikiriza maama","poem":1},{"noteId":2},{"text":"wo.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Abantu bange bazikiridde olw’obutamanya.","poem":2},{"lineBreak":true},{"text":"“Kyemunaava mulema","poem":1},{"text":"okubeera bakabona bange;","poem":2},{"text":"era olw’okulagajjalira etteeka lya Katonda wo,","poem":1},{"text":"nange kyendiva ndagajjalira abaana bo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gye beeyongera okuba abangi,","poem":1},{"text":"gye baakoma n’okukola ebibi;","poem":2},{"lineBreak":true},{"text":"baasuula ekitiibwa kyabwe ne banswaza.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bagaggawalira ku bibi by’abantu bange,","poem":1},{"text":"era basemba okwonoona kwabwe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Era bwe kityo bwe kiriba eri abantu n’eri bakabona:","poem":1},{"text":"ndibabonereza olw’enneeyisa yaabwe,","poem":2},{"lineBreak":true},{"text":"era ne mbasasula ng’ebikolwa byabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Balirya naye tebalikkuta,","poem":1},{"text":"balikola ebibi eby’obwenzi kyokka tebalyeyongera bungi,","poem":2},{"text":"kubanga bavudde ku Mukama ne beewaayo","poem":1}]},{"type":"verse","number":11,"content":[{"text":"eri obwenzi,","poem":1},{"lineBreak":true},{"text":"wayini omukadde n’omusu,","poem":1},{"text":"ne bibamalamu okutegeera.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abantu bange","poem":2},{"text":"beebuuza ku kikonge ky’omuti,","poem":1},{"text":"ne baddibwamu omuti.","poem":2},{"text":"Omwoyo ogw’obwenzi gubasendasenda","poem":1},{"text":"ne gubaleetera obutaba beesigwa eri Katonda waabwe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Baweerayo ssaddaaka ku ntikko z’ensozi,","poem":1},{"text":"ne baweerayo ebiweebwayo ebyokebwa ku busozi,","poem":2},{"text":"wansi w’emyalooni, n’emiribine n’emyera","poem":1},{"text":"awali ekisiikirize ekirungi.","poem":2},{"text":"Bawala bammwe kyebava baba bamalaaya,","poem":1},{"text":"ne baka baana bammwe ne bakola obwenzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Siribonereza bawala bammwe","poem":1},{"text":"olw’okubeera bamalaaya,","poem":2},{"text":"newaakubadde baka baana bammwe","poem":1},{"text":"okukola eby’obwenzi,","poem":2},{"text":"kubanga abasajja bennyini bassa bumu ne bamalaaya,","poem":1},{"text":"ne baweerayo ssaddaaka ne bamalaaya ab’omu masabo;","poem":2},{"lineBreak":true},{"text":"abantu abatategeera balizikirira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Newaakubadde ggwe Isirayiri oyenda,","poem":1},{"text":"omusango guleme okuba ku Yuda.","poem":2},{"text":"Togenda Girugaali,","poem":1},{"text":"newaakubadde okwambuka e Besaveni.","poem":2},{"noteId":3},{"lineBreak":true},{"text":"Tolayiranga nti, ‘Nga Katonda bw’ali omulamu.’","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abayisirayiri bakakanyavu mu mitima","poem":1},{"text":"ng’ennyana endalu.","poem":2},{"text":"Olwo Mukama ayinza atya okubalabirira","poem":1},{"text":"ng’abaana b’endiga abali mu kisibo?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Efulayimu yeegasse n’abasinza ebifaananyi,","poem":1},{"text":"mumuleke abeere yekka.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ebyokunywa ne bwe bibaggwaako,","poem":1},{"text":"beeyongera mu bwamalaaya;","poem":2},{"lineBreak":true},{"text":"n’abakulembeze baabwe baagala nnyo eby’ensonyi:","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Embuyaga kyeziriva zibatwala,","poem":1},{"text":"ne ssaddaaka zaabwe ne zibaswaza.”","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"maama kitegeeza Obwakabaka bwa Isirayiri","reference":{"chapter":4,"verse":5}},{"noteId":3,"caller":"+","text":"Besaveni kitegeeza ennyumba ey’abakozi b’ebibi","reference":{"chapter":4,"verse":15}}]},"thisChapterLink":"/api/lug_bib/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}