{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"HOS","translationId":"lug_bib","name":"Koseya","commonName":"Koseya","title":"Ekitabo Ekiyitibwa Koseya","order":28,"numberOfChapters":14,"sha256":"31314e24a9fef7d5827cf0e23af5780e2452e57642755c09adbba337e88eebd1","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/lug_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["Isirayiri Asalirwa Omusango"]},{"type":"verse","number":1,"content":[{"text":"Muwulire kino mmwe bakabona!","poem":1},{"text":"Musseeyo omwoyo, mmwe Isirayiri!","poem":2},{"text":"Muwulirize, mmwe ennyumba ya Kabaka!","poem":1},{"text":"Omusango guli ku mmwe:","poem":2},{"text":"Mubadde kyambika e Mizupa,","poem":1},{"text":"era ekitimba ekitegeddwa ku Taboli.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abajeemu bamaliridde okutta,","poem":1},{"text":"naye ndibabonereza bonna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mmanyi byonna ebikwata ku Efulayimu,","poem":1},{"text":"so ne Isirayiri tankisibwa.","poem":2},{"text":"Efulayimu weewaddeyo okukuba obwamalaaya,","poem":1},{"text":"ne Isirayiri yeeyonoonye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ebikolwa byabwe tebibaganya","poem":1},{"text":"kudda eri Katonda waabwe,","poem":2},{"text":"kubanga omwoyo ogw’obwamalaaya guli mu mitima gyabwe,","poem":1},{"text":"so tebamanyi Mukama.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Amalala ga Isirayiri gabalumiriza;","poem":1},{"text":"Abayisirayiri ne Efulayimu balyesittala olw’omusango gwabwe;","poem":2},{"lineBreak":true},{"text":"ne Yuda alyesittalira wamu nabo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bwe baligenda n’ebisibo byabwe n’amagana gaabwe","poem":1},{"text":"okunoonya Mukama,","poem":2},{"text":"tebalimulaba;","poem":1},{"text":"abaviiridde, abeeyawuddeko.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tebabadde beesigwa eri Mukama;","poem":1},{"text":"bazadde abaana aboobwenzi.","poem":2},{"text":"Embaga ez’omwezi ogwakaboneka","poem":1},{"text":"kyeziriva zibamalawo, n’ennimiro zaabwe ne ziragajjalirwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mufuuwe eŋŋombe mu Gibea,","poem":1},{"text":"n’ekkondeere mu Laama.","poem":2},{"text":"Muyimuse amaloboozi e Besaveni;","poem":1},{"text":"mutukulembere mmwe Benyamini.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Efulayimu alifuuka matongo","poem":1},{"text":"ku lunaku olw’okubonerezebwa.","poem":2},{"text":"Nnangirira ebiribaawo","poem":1},{"text":"mu bika bya Isirayiri.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abakulembeze ba Yuda bali ng’abo","poem":1},{"text":"abajjulula ensalo,","poem":2},{"text":"era ndibafukako obusungu bwange","poem":1},{"text":"ng’omujjuzo gw’amazzi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efulayimu anyigirizibwa,","poem":1},{"text":"era omusango gumumezze,","poem":2},{"lineBreak":true},{"text":"kubanga yamalirira okugoberera bakatonda abalala.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kyenvudde nfuuka ng’ennyenje eri Efulayimu,","poem":1},{"text":"n’eri ennyumba ya Yuda n’emba ng’ekintu ekivundu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Efulayimu bwe yalaba obulwadde bwe,","poem":1},{"text":"ne Yuda n’alaba ekivundu kye,","poem":2},{"text":"Efulayimu n’addukira mu Bwasuli,","poem":1},{"text":"n’atumya obuyambi okuva eri kabaka waayo omukulu.","poem":2},{"text":"Naye tasobola kubawonya","poem":1},{"text":"newaakubadde okubajjanjaba ebiwundu byabwe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kyendiva mbeera ng’empologoma eri Efulayimu,","poem":1},{"text":"era ng’empologoma ey’amaanyi eri ennyumba ya Yuda.","poem":2},{"text":"Ndibataagulataagula ne ŋŋenda;","poem":1},{"text":"ndibeetikka ne mbatwala, ne babulwako ayinza okubawonya.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndiddayo mu kifo kyange,","poem":1},{"text":"okutuusa lwe balikkiriza omusango gwabwe.","poem":2},{"text":"Balinnoonya,","poem":1},{"text":"mu buyinike bwabwe, balinnoonya n’omutima gwabwe gwonna.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}