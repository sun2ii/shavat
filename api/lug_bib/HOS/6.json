{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"HOS","translationId":"lug_bib","name":"Koseya","commonName":"Koseya","title":"Ekitabo Ekiyitibwa Koseya","order":28,"numberOfChapters":14,"sha256":"31314e24a9fef7d5827cf0e23af5780e2452e57642755c09adbba337e88eebd1","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/lug_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["Obujeemu bwa Isirayiri"]},{"type":"verse","number":1,"content":[{"text":"“Mujje, tudde eri Mukama.","poem":1},{"lineBreak":true},{"text":"Atutaaguddetaagudde,","poem":1},{"text":"naye alituwonya;","poem":2},{"text":"atuleeseeko ebiwundu,","poem":1},{"text":"naye ebiwundu alibinyiga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Oluvannyuma olw’ennaku bbiri alituzzaamu obulamu, era ku lunaku","poem":1},{"text":"olwokusatu alituzza buggya,","poem":2},{"lineBreak":true},{"text":"ne tubeera balamu mu maaso ge.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tumanye Mukama;","poem":1},{"text":"tunyiikire okumumanya.","poem":2},{"text":"Ng’enjuba bw’evaayo enkya,","poem":1},{"text":"bw’atyo bw’alirabika;","poem":2},{"text":"alijja gye tuli ng’enkuba ey’omu kiseera ky’omuzira,","poem":1},{"text":"era ng’enkuba eya ddumbi efukirira ettaka.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nkukolere ki, Efulayimu?","poem":1},{"text":"Nkukolere ki, Yuda?","poem":2},{"text":"Okwagala kwo kuli ng’olufu olw’enkya,","poem":1},{"text":"era ng’omusulo ogw’enkya ogukala amangu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kyenvudde nkozesa bannabbi okubasalaasala ebitundutundu,","poem":1},{"text":"ne mbatta n’ebigambo eby’omu kamwa kange,","poem":2},{"lineBreak":true},{"text":"era ne mbasalira emisango ng’okumyansa okw’eggulu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kubanga njagala ekisa so si ssaddaaka,","poem":1},{"text":"era n’okumanya Katonda, okusinga ebiweebwayo ebyokebwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Okufaanana nga Adamu, bamenye endagaano,","poem":1},{"text":"tebaali beesigwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gireyaadi kibuga ky’abakozi ba bibi,","poem":1},{"text":"era engalo zaabwe zijjudde omusaayi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ng’abatemu bwe bateegerera omuntu mu kkubo,","poem":1},{"text":"n’ebibiina bya bakabona","poem":2},{"text":"bwe bityo bwe bittira ku luguudo olugenda e Sekemu,","poem":1},{"text":"ne bazza emisango egy’obuswavu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndabye eby’ekivve","poem":1},{"text":"mu nnyumba ya Isirayiri;","poem":2},{"text":"era eyo Efulayimu gye yeeweereddeyo mu bwamalaaya,","poem":1},{"text":"ne Isirayiri gy’ayonoonekedde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Naawe Yuda,","poem":1},{"text":"amakungula gatuuse.","poem":2},{"lineBreak":true},{"text":"“Bwe ndikomyawo emikisa gy’abantu bange,","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}