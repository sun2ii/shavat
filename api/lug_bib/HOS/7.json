{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"HOS","translationId":"lug_bib","name":"Koseya","commonName":"Koseya","title":"Ekitabo Ekiyitibwa Koseya","order":28,"numberOfChapters":14,"sha256":"31314e24a9fef7d5827cf0e23af5780e2452e57642755c09adbba337e88eebd1","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/lug_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"na buli lwe nawonyanga Isirayiri,","poem":2},{"text":"ebibi bya Efulayimu ne birabika,","poem":1},{"text":"n’ebikolwa eby’ekyejo ebya Samaliya nabyo ne birabika.","poem":2},{"text":"Balimba,","poem":1},{"text":"bamenya ne bayingira mu mayumba,","poem":2},{"lineBreak":true},{"text":"era batemu abateega abantu mu makubo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Naye tebalowooza","poem":1},{"text":"nga nzijukira ebikolwa byabwe byonna ebibi.","poem":2},{"text":"Ebibi byabwe bibazingizza,","poem":1},{"text":"era mbiraba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Kabaka asanyukira obutali butuukirivu bwabwe,","poem":1},{"text":"n’abakungu basanyukira obulimba bwabwe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bonna benzi;","poem":1},{"text":"bali ng’ekyoto ekyaka omuliro,","poem":2},{"text":"omufumbi w’emigaati gw’ateetaaga kuseesaamu","poem":1},{"text":"okutuusa obutta bw’agoye, lwabuusa ku kyoto ne buzimbulukuka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ku lunaku kabaka lw’agabula embaga,","poem":1},{"text":"abakungu ettamiiro lya wayini ne libalwaza,","poem":2},{"lineBreak":true},{"text":"kabaka ne yeegatta n’abanyoomi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Emitima gyabwe gyokerera nga oveni","poem":1},{"text":"mu busungu bwabwe;","poem":2},{"text":"Obusungu bwabwe bubuguumirira ekiro kyonna;","poem":1},{"text":"mu makya ne bwaka ng’omuliro.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bonna bookya nga oveni,","poem":1},{"text":"era bazikiriza abakulembeze baabwe.","poem":2},{"text":"Bakabaka baabwe bonna bagudde;","poem":1},{"text":"tewali n’omu ku bo ankowoola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Efulayimu yeegattika ne bannaggwanga;","poem":1},{"text":"Efulayimu mugaati oguyiddeko oluuyi olumu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bannaggwanga banyuunyunta amaanyi ge","poem":1},{"text":"naye takimanyi.","poem":2},{"text":"Mu nviiri ze mulimu envi,","poem":1},{"text":"naye takiraba.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Okwekulumbaza kwa Isirayiri kwe kubalumiriza,","poem":1},{"text":"naye newaakubadde ng’ebyo byonna bimutuuseeko","poem":2},{"text":"tadda eri Mukama Katonda we","poem":1},{"text":"newaakubadde okumunoonya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Efulayimu ali ng’ejjiba,","poem":1},{"text":"alimbibwalimbibwa mangu era talina magezi;","poem":2},{"text":"bakaabira Misiri,","poem":1},{"text":"era bagenda eri Obwasuli.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bwe baliba balaga eyo, ndibasuulako akatimba,","poem":1},{"text":"era ndibassa wansi ng’ennyonyi ez’omu bbanga.","poem":2},{"text":"Bwe ndiwulira nga bakuŋŋaana, ndibaziyiza.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zibasanze,","poem":1},{"text":"kubanga bawabye ne banvaako.","poem":2},{"text":"Baakuzikirira","poem":1},{"text":"kubanga banjemedde.","poem":2},{"text":"Njagala nnyo okubanunula,","poem":1},{"text":"naye banjogerako eby’obulimba.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tebankaabira n’emitima gyabwe,","poem":1},{"text":"wabula ebiwoobe babikubira ku bitanda byabwe.","poem":2},{"text":"Bakuŋŋaana awamu olw’emmere ey’empeke ne wayini,","poem":1},{"text":"naye ne banjeemera.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nabayigiriza ne mbawa n’amaanyi,","poem":1},{"text":"naye bansalira enkwe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tebakyukira oyo Ali Waggulu Ennyo;","poem":1},{"text":"bafuuse ng’omutego gw’akasaale ogwayonooneka;","poem":2},{"text":"abakulembeze baabwe balifa kitala,","poem":1},{"text":"olw’ebigambo byabwe ebya kalebule.","poem":2},{"text":"Era kyebaliva babasekerera","poem":1},{"text":"mu nsi y’e Misiri.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}