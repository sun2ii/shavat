{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"HOS","translationId":"lug_bib","name":"Koseya","commonName":"Koseya","title":"Ekitabo Ekiyitibwa Koseya","order":28,"numberOfChapters":14,"sha256":"31314e24a9fef7d5827cf0e23af5780e2452e57642755c09adbba337e88eebd1","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/lug_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["Isirayiri Akungula Embuyaga"]},{"type":"verse","number":1,"content":[{"text":"“Ffuwa ekkondeere.","poem":1},{"text":"Empungu eri ku nnyumba ya Mukama","poem":2},{"text":"kubanga abantu bamenye endagaano yange","poem":1},{"text":"ne bajeemera amateeka gange.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isirayiri bankaabira nga boogera nti,","poem":1},{"text":"‘Katonda waffe, tukumanyi.’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Naye Isirayiri baleseeyo ekirungi;","poem":1},{"text":"omulabe kyaliva abayigganya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Balonda bakabaka nga sikkirizza,","poem":1},{"text":"balonda abakulembeze be sikakasizza.","poem":2},{"text":"Beekolera ebifaananyi ebyole","poem":1},{"text":"mu ffeeza yaabwe ne mu zaabu yaabwe ebiribaleetera okuzikirira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kanyuga ebweru ekifaananyi ky’ennyana yo, ggwe Samaliya.","poem":1},{"text":"Obusungu bwange bubabuubuukirako.","poem":2},{"text":"Balituusa ddi okuba abatali batuukirivu?","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Bava mu Isirayiri.","poem":2},{"text":"Ennyana eyo omuntu eyakuguka mu by’okuweesa, ye yagikola","poem":1},{"text":"so si Katonda.","poem":2},{"text":"Era ennyana eyo eya Samaliya","poem":1},{"text":"eribetentebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Basiga empewo,","poem":1},{"text":"ne bakungula embuyaga.","poem":2},{"text":"Ekikolo olw’obutaba na mutwe,","poem":1},{"text":"kyekiriva kirema okubala ensigo.","poem":2},{"text":"Naye ne bwe kyandibaze,","poem":1},{"text":"bannaggwanga bandigiridde.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Isirayiri amaliddwawo;","poem":1},{"text":"ali wakati mu mawanga","poem":2},{"lineBreak":true},{"text":"ng’ekintu ekitagasa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bambuse ne bagenda eri Obwasuli,","poem":1},{"text":"ng’endogoyi ey’omu nsiko eri yokka.","poem":2},{"lineBreak":true},{"text":"Efulayimu aguliridde abaganzi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Newaakubadde nga beetunze eri amawanga,","poem":1},{"text":"ndibakuŋŋaanya,","poem":2},{"text":"era ndibawaayo eri okubonaabona","poem":1},{"text":"nga banyigirizibwa kabaka ow’amaanyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Newaakubadde nga Efulayimu baazimba ebyoto bingi eby’ebiweebwayo olw’ekibi,","poem":1},{"text":"bifuuse byoto bya kukolerako bibi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nabawandiikira ebintu bingi mu mateeka gange,","poem":1},{"text":"naye ne babifuula ekintu ekigwira.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bawaayo ebiweebwayo gye ndi,","poem":1},{"text":"ne balya ennyama yaabyo,","poem":2},{"lineBreak":true},{"text":"Mukama tabasanyukira.","poem":2},{"text":"Kaakano alijukira obutali butuukirivu bwabwe","poem":1},{"text":"n’ababonereza olw’ebibi byabwe:","poem":2},{"lineBreak":true},{"text":"Baliddayo e Misiri.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Isirayiri yeerabidde omutonzi we,","poem":1},{"text":"n’azimba embiri,","poem":2},{"lineBreak":true},{"text":"ne Yuda ne yeeyongera okuzimba ebibuga ebiriko bbugwe;","poem":2},{"text":"naye ndisindika omuliro ku bibuga byabwe,","poem":1},{"text":"ne gwokya ebigo byabwe.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}