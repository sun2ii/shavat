{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"HOS","translationId":"lug_bib","name":"Koseya","commonName":"Koseya","title":"Ekitabo Ekiyitibwa Koseya","order":28,"numberOfChapters":14,"sha256":"31314e24a9fef7d5827cf0e23af5780e2452e57642755c09adbba337e88eebd1","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/lug_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["Okubonerezebwa kwa Isirayiri"]},{"type":"verse","number":1,"content":[{"text":"Tosanyuka ggwe Isirayiri;","poem":1},{"text":"tojaguza ng’amawanga amalala,","poem":2},{"text":"kubanga tobadde mwesigwa eri Katonda wo,","poem":1},{"text":"weegomba empeera eya malaaya","poem":2},{"lineBreak":true},{"text":"ku buli gguuliro.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Egguuliro n’essogolero tebiribaliisa,","poem":1},{"text":"ne wayini omusu alibaggwaako.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tebalisigala mu nsi ya Mukama;","poem":1},{"text":"Efulayimu aliddayo e Misiri","poem":2},{"lineBreak":true},{"text":"n’alya emmere etali nnongoofu mu Bwasuli.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tebaliwaayo biweebwayo ebya wayini eri Mukama,","poem":1},{"text":"so ne ssaddaaka zaabwe tezirimusanyusa.","poem":2},{"text":"Ssaddaaka zaabwe ziriba ng’emmere ey’abakungubazi,","poem":1},{"text":"ne bonna abaliziryako balifuuka abatali balongoofu.","poem":2},{"text":"Emmere eyo eriba yaabwe bo,","poem":1},{"text":"so teriyingizibwa mu yeekaalu ya Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kiki ky’olikola ku lunaku olw’embaga ezaalondebwa,","poem":1},{"text":"ku lunaku olw’embaga ya Mukama?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne bwe baliwona okuzikirira,","poem":1},{"text":"Misiri alibakuŋŋaanya,","poem":2},{"lineBreak":true},{"text":"ne Menfisi alibaziika.","poem":2},{"text":"Eby’obugagga byabwe ebya ffeeza birizika,","poem":1},{"lineBreak":true},{"text":"n’eweema zaabwe zirimeramu amaggwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ennaku ez’okubonerezebwa zijja,","poem":1},{"text":"ennaku ez’okusasulirwamu ziri kumpi.","poem":2},{"lineBreak":true},{"text":"Ekyo Isirayiri akimanye.","poem":2},{"text":"Olw’ebibi byammwe okuba ebingi ennyo,","poem":1},{"text":"n’obukambwe bwammwe obungi,","poem":2},{"text":"nnabbi ayitibwa musirusiru,","poem":1},{"text":"n’oyo eyabikkulirwa mumuyita mugu wa ddalu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nnabbi awamu ne Katonda wange","poem":1},{"text":"ye mukuumi wa Efulayimu,","poem":2},{"noteId":4},{"text":"newaakubadde nga waliwo emitego mu kkubo lye,","poem":1},{"text":"n’obukambwe mu nnyumba ya Katonda we.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Boonoonye nnyo nnyini","poem":1},{"text":"nga mu nnaku ez’e Gibea.","poem":2},{"text":"Katonda alijjukira obutali butuukirivu bwabwe,","poem":1},{"text":"n’ababonereza olw’ebibi byabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"We nasangira Isirayiri,","poem":1},{"text":"kyali nga kulaba zabbibu mu ddungu.","poem":2},{"text":"Bwe nalaba bajjajjammwe,","poem":1},{"text":"kyali nga kulaba ebibala ebisooka ku mutiini.","poem":2},{"text":"Naye bwe bajja e Baalipyoli,","poem":1},{"text":"beewonga eri ekifaananyi eky’ensonyi,","poem":2},{"lineBreak":true},{"text":"ne bafuuka ekyenyinnyalwa ng’ekifaananyi kye baayagala.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ekitiibwa kya Efulayimu kiribuuka ne kigenda ng’ekinyonyi","poem":1},{"text":"nga tewali kuzaala, newaakubadde okuba olubuto newaakubadde okufuna olubuto.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne bwe balikuza abaana baabwe,","poem":1},{"text":"ndibabaggyako bonna.","poem":2},{"text":"Ziribasanga","poem":1},{"text":"bwe ndibavaako.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nalaba Efulayimu","poem":1},{"text":"ng’asimbiddwa mu kifo ekirungi, nga Ttuulo bw’ali.","poem":2},{"text":"Naye Efulayimu alifulumya","poem":1},{"text":"abaana be ne battibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Bawe Ayi Mukama Katonda.","poem":1},{"text":"Olibawa ki?","poem":2},{"text":"Leetera embuto zaabwe okuvaamu","poem":1},{"text":"obawe n’amabeere amakalu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Olw’ebibi byabwe byonna mu Girugaali,","poem":1},{"text":"kyennava mbakyayira eyo.","poem":2},{"text":"Olw’ebikolwa byabwe ebitali bya butuukirivu,","poem":1},{"text":"kyendiva mbagoba mu nnyumba yange.","poem":2},{"text":"Siribaagala nate;","poem":1},{"text":"abakulembeze baabwe bonna bajeemu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Efulayimu balwadde,","poem":1},{"text":"emirandira gyabwe gikaze,","poem":2},{"lineBreak":true},{"text":"tebakyabala bibala.","poem":2},{"text":"Ne bwe balizaala abaana baabwe,","poem":1},{"text":"nditta ezzadde lyabwe lye baagala ennyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Katonda wange alibavaako","poem":1},{"text":"kubanga tebamugondedde;","poem":2},{"lineBreak":true},{"text":"baliba momboze mu mawanga.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Efulayimu be bantu ba Katonda","reference":{"chapter":9,"verse":8}}]},"thisChapterLink":"/api/lug_bib/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}