{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Okwolesebwa kwa Isaaya, mutabani wa Amozi, kwe yafuna okukwata ku Yuda ne Yerusaalemi mu bufuzi bwa Uzziya, ne Yosamu, ne Akazi ne Keezeekiya, bassekabaka ba Yuda."]},{"type":"heading","content":["Eggwanga Ejjeemu"]},{"type":"verse","number":2,"content":[{"text":"Wulira ggwe eggulu, mpuliriza ggwe ensi,","poem":1},{"text":"kubanga bw’ati Mukama bw’ayogera nti,","poem":2},{"text":"“Nayonsa ne ndera abaana","poem":1},{"text":"naye ne banjeemera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ente emanya nannyini yo","poem":1},{"text":"n’endogoyi emanya ekisibo kya mukama waayo,","poem":2},{"text":"naye Isirayiri tammanyi,","poem":1},{"text":"abantu bange tebantegeera.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Woowe! Eggwanga erijjudde ebibi,","poem":1},{"text":"abantu abajjudde obutali butuukirivu,","poem":2},{"text":"ezzadde eryabakola ebibi,","poem":1},{"text":"abaana aboonoonyi!","poem":2},{"text":"Balese Mukama","poem":1},{"text":"banyoomye Omutukuvu wa Isirayiri,","poem":2},{"lineBreak":true},{"text":"basenguse bamuvuddeko bamukubye amabega.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lwaki mweyongera okujeema?","poem":1},{"text":"Mwagala mwongere okubonerezebwa?","poem":2},{"text":"Omutwe gwonna mulwadde,","poem":1},{"text":"n’omutima gwonna gunafuye.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Okuva mu mala g’ekigere okutuuka ku mutwe","poem":1},{"text":"temuli bulamu","poem":2},{"text":"wabula ebiwundu, n’okuzimba,","poem":1},{"text":"n’amabwa agatiiriika amasira","poem":2},{"text":"agatanyigibwanga, okusibibwa,","poem":1},{"text":"wadde okuteekebwako eddagala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ensi yammwe esigadde matongo,","poem":1},{"text":"ebibuga byammwe byokeddwa omuliro,","poem":2},{"text":"nga nammwe bennyini mulaba.","poem":1},{"text":"Bannamawanga","poem":2},{"noteId":0},{"text":"balidde ensi yammwe,","poem":2},{"lineBreak":true},{"text":"era ezise kubanga bannaggwanga bagisudde.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Omuwala wa Sayuuni alekeddwa","poem":1},{"text":"ng’ensiisira esigadde mu nnimiro y’emizabbibu,","poem":2},{"text":"ng’ekiwummulirwamu mu nnimiro y’emyungu","poem":1},{"noteId":1},{"text":",","poem":1},{"text":"ng’ekibuga ekizingiziddwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Singa Mukama ow’Eggye","poem":1},{"text":"teyatulekerawo bantu abatonotono abaasigalawo","poem":2},{"text":"twandibadde nga Sodomu,","poem":1},{"text":"twandifuuse nga Ggomola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Muwulirize ekigambo kya Katonda","poem":1},{"text":"mmwe abafuzi ba Sodomu!","poem":2},{"text":"Musseeyo omwoyo eri okuyigiriza kwa Katonda waffe","poem":1},{"text":"mmwe abantu b’e Ggomola!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Ssaddaaka enkumu ze munsalira","poem":1},{"text":"zingasa ki?","poem":2},{"text":"Nkooye endiga ennume","poem":1},{"text":"enjokye eziweebwayo,","poem":2},{"text":"so sisanyukira musaayi gwa nte,","poem":1},{"text":"newaakubadde ogw’abaana b’endiga, newaakubadde ogw’embuzi ennume,” bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bwe mujja mu maaso gange,","poem":1},{"text":"ani aba abayise","poem":2},{"lineBreak":true},{"text":"ne mujja okulinnyirira empya zange?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mulekeraawo okuleeta ssaddaaka zammwe ezitaliimu;","poem":1},{"text":"obubaane bwammwe bwa muzizo gye ndi.","poem":2},{"text":"Omwezi Ogubonese ne Ssabbiiti n’enkuŋŋaana zammwe","poem":1},{"text":"zijjudde obutali butuukirivu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Emyezi gyammwe Egibonese n’embaga zammwe ez’ennaku entukuvu,","poem":1},{"text":"emmeeme yange ebikyaye,","poem":2},{"text":"binfuukidde omugugu,","poem":1},{"text":"nkooye okubigumiikiriza.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bwe munaayimusanga emikono gyammwe musabe","poem":1},{"text":"nnaabakwekanga amaaso gange,","poem":2},{"text":"era ne bwe munaasabanga ennyo","poem":1},{"text":"siiwulirenga","poem":2},{"text":"kubanga emikono gyammwe gisaabaanye omusaayi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Munaabe, mwetukuze","poem":1},{"text":"muggirewo ddala ebikolwa byammwe ebibi gye ndi,","poem":2},{"lineBreak":true},{"text":"mulekeraawo okukola ebibi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Muyige okukola obulungi, musalenga emisango n’amazima,","poem":1},{"text":"mudduukirirenga abajoogebwa,","poem":2},{"text":"musalenga omusango gw’atalina kitaawe,","poem":1},{"text":"muwolerezenga bannamwandu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Mujje nno tukubaganye ebirowoozo,”","poem":1},{"text":"bw’ayogera Mukama;","poem":2},{"text":"“ebibi byammwe ne bwe biba ng’olugoye olumyufu","poem":1},{"text":"binaafuuka byeru ng’omuzira,","poem":2},{"text":"ne bwe binaaba bitwakaavu nga langi emyufu enkwafu,","poem":1},{"text":"binaatukula ng’ebyoya by’endiga.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bwe munaagondanga ne muwulira,","poem":1},{"text":"munaalyanga ebirungi eby’ensi;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"naye bwe munaagaananga ne mujeemanga","poem":1},{"text":"ekitala kinaabalyanga,”","poem":2},{"text":"kubanga akamwa ka Mukama ke kakyogedde.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Laba ekibuga ekyesigwa","poem":1},{"text":"bwe kifuuse ng’omwenzi!","poem":2},{"text":"Oyo eyasalanga emisango mu bwenkanya!","poem":1},{"text":"Obutuukirivu bwatuulanga mu ye,","poem":2},{"lineBreak":true},{"text":"naye kaakano batemu bennyini nnyini!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Effeeza yo efuuse masengere,","poem":1},{"text":"wayini wo afuuse wa lujjulungu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Abafuzi bo bajeemu,","poem":1},{"text":"mikwano gya babbi,","poem":2},{"text":"bonna bawoomerwa enguzi,","poem":1},{"text":"era banoonya kuweebwa birabo;","poem":2},{"text":"tebayamba batalina ba kitaabwe,","poem":1},{"text":"so n’ensonga za bannamwandu tebazifaako.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Noolwekyo kyava ayogera Mukama, Mukama ow’Eggye,","poem":1},{"text":"ow’amaanyi owa Isirayiri nti,","poem":2},{"text":"“Ndifuka obusungu ku balabe bange,","poem":1},{"text":"era ne nesasuza abo abankyawa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Era ndikukwatamu n’omukono gwange,","poem":1},{"text":"ne nnoongoosereza ddala amasengere go gonna","poem":2},{"lineBreak":true},{"text":"ne nkuggyamu ebitali birungi byonna.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Era ndikomyawo abalamuzi bo ng’olubereberye","poem":1},{"text":"n’abo abakuwa amagezi, nga bwe kyali okusooka.","poem":2},{"text":"Olwo olyoke oyitibwe","poem":1},{"text":"ekibuga eky’obutuukirivu,","poem":2},{"lineBreak":true},{"text":"ekibuga ekyesigwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Sayuuni alinunulibwa lwa bwenkanya,","poem":1},{"text":"n’abantu baamu abalyenenya mu butuukirivu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Naye abeewaggula n’abakozi b’ebibi balizikirizibwa wamu,","poem":1},{"text":"n’abo abava ku Mukama Katonda, balimalibwawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Kubanga mulikwatibwa ensonyi olw’emiti","poem":1},{"text":"mwe mwenyumiririzanga,","poem":2},{"text":"n’olw’ennimiro","poem":1},{"text":"ze mweroboza.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kubanga mulibeera ng’omuvule oguwotoka","poem":1},{"text":"era ng’ennimiro etaliimu mazzi.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"N’omusajja ow’amaanyi alifuuka ng’enfuuzi,","poem":1},{"text":"n’omulimu gwe ng’akasasi akavudde ku lyanda,","poem":2},{"text":"era byombi biriggiira wamu","poem":1},{"text":"so tewaliba azikiza omuliro ogwo.”","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Kino kyogera ku kulumbibwa kw’abantu b’omu Bwasuli mu biro bya Sennakeribu (2Bk 18:13).","reference":{"chapter":1,"verse":7}},{"noteId":1,"caller":"+","text":"emyungu ziba bika bya nsujju; emu eyitibwa omungu","reference":{"chapter":1,"verse":8}}]},"thisChapterLink":"/api/lug_bib/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}