{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Nga zibasanze abo abateeka amateeka agatali ga bwenkanya,","poem":1},{"text":"n’abo abawa ebiragiro ebinyigiriza,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"okulemesa abaavu ne batafuna nsala ebagwanidde;","poem":1},{"text":"era n’okunyaga ku bantu bange abaavu ebyabwe,","poem":2},{"text":"ne bafuula bannamwandu omunyago gwabwe,","poem":1},{"text":"n’abatalina ba kitaabwe omuyiggo gwabwe!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mulikola mutya ku lunaku Mukama lwalisalirako omusango","poem":1},{"text":"ne mu kuzikirira okuliva ewala?","poem":2},{"text":"Muliddukira w’ani alibayamba?","poem":1},{"text":"Obugagga bwammwe mulibuleka wa?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Muliba temusigazza kya kukola kirala wabula okutwalibwa nga mukutaamiridde mu busibe","poem":1},{"text":"oba okuba mu abo abattiddwa.","poem":2},{"lineBreak":true},{"text":"Naye wadde nga biri bityo, obusungu bwe buliba tebunnaggwaawo,","poem":1},{"text":"era n’omukono gwe guliba gukyagoloddwa.","poem":2}]},{"type":"heading","content":["Omusango Katonda Gwalisalira Bwasuli"]},{"type":"verse","number":5,"content":[{"text":"“Zikusanze Bwasuli, omuggo gw’obusungu bwange,","poem":1},{"text":"era omuggo gw’ekiruyi kyange.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mmutuma okulumba eggwanga eritatya Mukama,","poem":1},{"text":"era mmusindika eri abantu abansunguwazizza,","poem":2},{"text":"abanyage, ababbire ddala,","poem":1},{"text":"n’okubasambirira abasambirire ng’ebitoomi eby’omu nguudo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Naye kino si kye kigendererwa kye,","poem":1},{"text":"kino si ky’alowooza.","poem":2},{"text":"Ekigendererwa kye kwe kuzikiriza,","poem":1},{"text":"okumalirawo ddala amawanga mangi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"‘Abaduumizi bange bonna tebenkana bakabaka?’ bw’atyo bw’ayogera.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"‘Kalino tetwakizikiriza nga Kalukemisi,","poem":2},{"text":"ne Kamasi nga Alupaadi,","poem":1},{"text":"ne Samaliya nga Ddamasiko?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ng’omukono gwange bwe gwawamba obwakabaka obusinza bakatonda ababajje,","poem":1},{"text":"abasinga n’abo ab’omu Yerusaalemi ne Samaliya,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"nga bwe nakola Samaliya ne bakatonda baabwe abalala","poem":1},{"text":"si bwe nnaakola Yerusaalemi ne bakatonda baabwe ababajje?’ ”","poem":2}]},{"type":"verse","number":12,"content":["Mukama bw’alimaliriza omulimu gwe ku lusozi Sayuuni era ne ku Yerusaalemi n’alyoka abonereza kabaka w’e Bwasuli olw’okwewaana n’okuduula kwe n’entunula ye ey’amalala."]},{"type":"verse","number":13,"content":["Kubanga yayogera nti,",{"text":"“ ‘Bino byonna mbikoze olw’amaanyi g’omukono gwange,","poem":1},{"text":"era n’olw’amagezi gange,","poem":2},{"text":"kubanga ndi mukalabakalaba:","poem":1},{"text":"Najjulula ensalo z’amawanga ne nnyaga obugagga bwabwe,","poem":2},{"lineBreak":true},{"text":"ng’ow’amaanyi omuzira ne nzikakkanya bakabaka baabwe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ng’omuntu bw’akwata mu kisu,","poem":1},{"text":"omukono gwange gw’akunuukiriza ne gukwata mu bugagga bw’amawanga;","poem":2},{"text":"ng’abantu bwe balondalonda amagi agalekeddwawo,","poem":1},{"text":"bwe ntyo bwe nakuŋŋaanya amawanga gonna,","poem":2},{"text":"tewali na limu lyayanjuluza ku kiwaawaatiro,","poem":1},{"text":"newaakubadde eryayasamya akamwa kaalyo okukaaba.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Embazzi eyinza okweyita ey’ekitalo okusinga oyo agitemesa?","poem":1},{"text":"Omusumeeno gulyekuza okusinga oyo agusazisa?","poem":2},{"text":"Gy’obeera nti oluga luyinza okuwuuba omuntu alukozesa,","poem":1},{"text":"oba omuggo okusitula oyo atali muti.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Noolwekyo Mukama, Mukama Katonda Ayinzabyonna,","poem":1},{"text":"kyaliva aweereza obukovvu bulye abasajja be abaagejja,","poem":2},{"text":"era wansi w’okujaganya n’ekitiibwa kye akoleeze wo omuliro","poem":1},{"text":"ogwokya ng’oluyiira.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ekitangaala kya Isirayiri kirifuuka omuliro,","poem":1},{"text":"n’Omutukuvu waabwe abeere olulimi lw’omuliro,","poem":2},{"text":"mu lunaku lumu kyokye kimalirewo ddala","poem":1},{"text":"amaggwa ge n’emyeramannyo gye.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Era kiryokya ne kimalirawo ddala ekitiibwa ky’ebibira bye,","poem":1},{"text":"n’ennimiro ze, engimu,","poem":2},{"lineBreak":true},{"text":"ng’omusajja omulwadde bwaggweerawo ddala.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"N’emiti egy’omu kibira kye egirisigalawo giriba mitono nnyo","poem":1},{"text":"nga n’omwana ayinza okugibala.","poem":2}]},{"type":"heading","content":["Abalisigalawo ku Isirayiri"]},{"type":"verse","number":20,"content":[{"text":"Awo olulituuka ku lunaku olwo, abaliba bafisseewo ku Isirayiri,","poem":1},{"text":"n’abo abaliba bawonye ku nnyumba ya Yakobo","poem":2},{"text":"nga tebakyeyinulira ku oyo","poem":1},{"noteId":12},{"text":"eyabakuba","poem":2},{"text":"naye nga beesigama ku Mukama Katonda,","poem":1},{"text":"omutukuvu wa Isirayiri mu mazima.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ekitundu ekirifikkawo kirikomawo, ekitundu kya Yakobo","poem":1},{"text":"kirikomawo eri Katonda ow’amaanyi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kubanga wadde abantu bo bangi ng’omusenyu gw’ennyanja,","poem":1},{"text":"abalikomawo nga balamu baliba batono.","poem":2},{"text":"Okuzikirira kwo kwa kubaawo","poem":1},{"text":"kubanga kusaanidde.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kubanga Mukama, Mukama Katonda ow’Eggye alireeta","poem":1},{"text":"enkomerero eteriiko kubuusabuusa nga bwe yateekateeka entuuko mu nsi yonna.","poem":2}]},{"type":"verse","number":24,"content":["Noolwekyo Mukama, Mukama Katonda ow’Eggye kyava ayogera nti,",{"text":"“Mmwe abantu bange ababeera mu Sayuuni,","poem":1},{"text":"temutyanga Abasuli,","poem":2},{"text":"newaakubadde nga babakuba n’oluga","poem":1},{"text":"era nga babagololera omuggo nga Abamisiri bwe baakola.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kubanga mu kaseera katono nnyo","poem":1},{"text":"obusungu bwange gy’oli bujja kukoma era ekiruyi kyange kiribazikiriza.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Mukama Katonda ow’Eggye alibakuba n’akaswanyu","poem":1},{"text":"nga bwe yakuba aba Midiyaani ku lwazi lw’e Olebu.","poem":2},{"text":"Era aligololera oluga lwe ku nnyanja","poem":1},{"text":"nga bwe yakola e Misiri.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ku lunaku olwo, omugugu gwe guliggyibwa ku bibegabega byo,","poem":1},{"text":"n’ekikoligo kye kive ku nsingo yo;","poem":2},{"text":"ekikoligo kirimenyebwa","poem":1},{"text":"olw’obugevvu bwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Laba eggye ly’omulabe lituuse liwambye Yagasi,","poem":1},{"text":"liyise mu Migulooni,","poem":2},{"lineBreak":true},{"text":"era mu Mikumasi gye balireka emigugu gyabwe.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Bayise awavvuunukirwa, e Geba","poem":1},{"text":"ne basulayo ekiro kimu,","poem":2},{"text":"Laama akankana,","poem":1},{"text":"Gibea wa Sawulo adduse.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kaaba n’eddoboozi ery’omwanguka ggwe omuwala wa Galimu!","poem":1},{"text":"Ggwe Layisa wuliriza!","poem":2},{"lineBreak":true},{"text":"Ng’olabye Anasosi!","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Madumena adduse,","poem":1},{"text":"abantu b’e Gebimu beekukumye.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Olwa leero bajja kusibira Nobu,","poem":1},{"text":"balyolekeza ekikonde kyabwe","poem":2},{"text":"eri olusozi lwa Muwala wa Sayuuni,","poem":1},{"text":"akasozi ka Yerusaalemi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Laba, Mukama, Mukama Katonda ow’Eggye,","poem":1},{"text":"alitema amatabi n’entiisa","poem":2},{"text":"n’emiti emiwanvu n’emiwagguufu giritemerwa ddala,","poem":1},{"text":"n’emiti emiwanvu girikkakkanyizibwa.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Era alitemera ddala n’embazzi ebisaka by’omu kibira;","poem":1},{"text":"Lebanooni aligwa mu maaso g’oyo Ayinzabyonna.","poem":2}]}],"footnotes":[{"noteId":12,"caller":"+","text":"Kino kyogera ku bantu ba Bwasuli","reference":{"chapter":10,"verse":20}}]},"thisChapterLink":"/api/lug_bib/ISA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/9.json","previousChapterAudioLinks":{},"numberOfVerses":34}