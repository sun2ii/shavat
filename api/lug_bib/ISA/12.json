{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["Okwebaza Mukama olw’Obulokozi bwe"]},{"type":"verse","number":1,"content":[{"text":"Ku lunaku olwo oligamba nti,","poem":1},{"text":"“Nnaakwebazanga ayi Mukama Katonda;","poem":2},{"text":"newaakubadde nga wansunguwalira,","poem":1},{"text":"obusungu bwo bwaggwaawo era onzizizzaamu amaanyi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Laba Katonda bwe bulokozi bwange;","poem":1},{"text":"nzija kumwesiga era siritya;","poem":2},{"text":"kubanga Mukama Katonda ge maanyi gange era lwe luyimba lwange,","poem":1},{"text":"era afuuse obulokozi bwange.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Munaasenanga n’essanyu amazzi","poem":1},{"text":"okuva mu nzizi ez’obulokozi.","poem":2}]},{"type":"verse","number":4,"content":["Era ku lunaku olwo mulyogera nti,",{"text":"“Mwebaze Mukama Katonda, mukoowoole erinnya lye,","poem":1},{"text":"mubuulire ebikolwa bye mu mawanga,","poem":2},{"lineBreak":true},{"text":"mwogere nti erinnya lye ligulumizibwe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mumuyimbire Mukama Katonda ettendo kubanga akoze eby’ettendo;","poem":1},{"text":"muleke kino kimanyibwe mu mawanga gonna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Leekaana n’eddoboozi ery’omwanguka oyimbe n’essanyu ggwe omuntu w’omu Sayuuni,","poem":1},{"text":"kubanga Omutukuvu wa Isirayiri ali wakati mu ggwe mukulu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}