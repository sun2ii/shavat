{"text":"Mukama Katonda ow’Eggye ateekateeka","poem":1},{"text":"eggye lye okulwana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bava wala mu nsi ezeewala ennya","poem":1},{"text":"okuva ku nkomerero y’eggulu.","poem":2},{"text":"Mu busungu bwe Mukama Katonda aleese ebyokulwanyisa","poem":1},{"text":"eby’okuzikiriza ensi yonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mukungubage, kubanga olunaku lwa Mukama luli kumpi,","poem":1},{"text":"lulijja ng’okuzikirira okuva eri Mukama Katonda bwe kuba!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Emikono gyonna kyegiriva giggwaamu amaanyi,","poem":1},{"text":"na buli mutima gwa muntu gulisaanuuka;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"era bakeŋŋentererwe n’okubalagala kulibakwata, balyoke balumwe ng’omukazi alumwa okuzaala.","poem":1},{"text":"Balitunulaganako nga bawuniikiridde amaaso gaabwe nga gatangaalirira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Laba olunaku lwa Mukama lujja,","poem":1},{"text":"olunaku olubi ennyo olw’ekiruyi n’obusungu obubuubuuka","poem":2},{"text":"okufuula ensi amatongo,","poem":1},{"text":"n’okuzikiriza abakozi b’ebibi okubamalamu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kubanga emmunyeenye ez’omu ggulu n’ebibiina byazo","poem":1},{"text":"tebiryaka;","poem":2},{"text":"enjuba nayo teryaka nga bw’ekola bulijjo,","poem":1},{"text":"n’omwezi nagwo tegulyaka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndibonereza ensi olw’okwonoona kw’ayo,","poem":1},{"text":"n’abakozi b’ebibi olw’ebyonoono byabwe.","poem":2},{"text":"Era ndimalawo okweyisa kw’ab’amalala","poem":1},{"text":"era nzikakkanya okwenyumiriza kw’abo abakambwe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abantu ndibafuula abebbula","poem":1},{"text":"okusinga zaabu ennongoose eya ofiri.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Noolwekyo ndikankanya eggulu,","poem":1},{"text":"era n’ensi ngiyuuguumye okuva mu kifo kyayo,","poem":2},{"text":"olw’obusungu bwa Mukama Katonda ow’Eggye,","poem":1},{"text":"ku lunaku lw’obusungu bwe obungi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Era ng’empeewo eyiggibwa,","poem":1},{"text":"ng’endiga eteriiko agirunda,","poem":2},{"text":"buli muntu aliddukira eri abantu be","poem":1},{"text":"buli muntu aliddukira mu nsi y’ewaabwe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Buli anaalabwangako ng’ekitala kimuyitamu,","poem":1},{"text":"buli gwe banaakwatangako ng’attibwa n’ekitala.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"N’abaana baabwe abawere banabetenterwanga mu maaso gaabwe nga balaba;","poem":1},{"text":"ennyumba zaabwe zinyagibwe, n’abakazi baabwe bakwatibwe olw’empaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Laba, ndibayimbulira Abameedi,","poem":1},{"text":"abatafa ku ffeeza","poem":2},{"lineBreak":true},{"text":"era abateeguya zaabu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Emitego gyabwe girikuba abavubuka","poem":1},{"text":"era tebaliba na kisa eri abawere.","poem":2},{"lineBreak":true},{"text":"Amaaso gaabwe tegalisaasira baana bato.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ne Babulooni, ekitiibwa eky’obwakabaka,","poem":1},{"text":"obulungi obw’okwemanya kw’Abakaludaaya,","poem":2},{"text":"kiriba nga Sodomu ne Ggomola","poem":1},{"text":"Katonda bye yawamba.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Tekiriddamu kusulwamu ennaku zonna,","poem":1},{"text":"so tekiribeerwamu emirembe n’emirembe,","poem":2},{"text":"so teri Muwalabu alisimbayo weema ye,","poem":1},{"text":"teri musumba aligalamizaayo ggana lye kuwummulirayo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Naye ensolo enkambwe ez’omu ddungu ze zinaagalamirangayo;","poem":1},{"text":"ennyumba zijjule ebintu ebiwoowoola;","poem":2},{"text":"bammaaya banaabeeranga eyo,","poem":1},{"text":"n’ebikulekule bibuukire eyo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"N’empisi zinaakaabiranga mu bigulumu by’ebigo byabwe,","poem":1},{"text":"ebibe bikaabire mu mbiri zaabwe ezitemagana.","poem":2},{"text":"Ekiseera kyakyo kinaatera okutuuka,","poem":1},{"text":"ennaku ze teziryongerwako.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}