{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Mukama Katonda alikwatirwa Yakobo ekisa,","poem":1},{"text":"addemu alonde Isirayiri","poem":2},{"lineBreak":true},{"text":"abazze ku ttaka lyabwe.","poem":2},{"text":"Ne bannamawanga balibeegattako","poem":1},{"text":"era babeere wamu nga babeeyungiddeko ddala.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"N’amawanga mangi galibayamba","poem":1},{"text":"okudda mu nsi yaabwe,","poem":2},{"text":"n’ennyumba ya Isirayiri ebeere n’abantu","poem":1},{"text":"abamawanga amangi mu nsi ya Mukama Katonda, nga baweereza baabwe abasajja n’abakazi.","poem":2},{"text":"Baliwamba abaali babawambye,","poem":1},{"text":"bafuge abo abaabakijjanyanga.","poem":2}]},{"type":"verse","number":3,"content":["Awo olunaku Mukama Katonda lw’alibawa okuwummula okuva mu kulumwa kwammwe n’okukijjanyizibwa kwe mubaddemu nga mukozesebwa,"]},{"type":"verse","number":4,"content":["oligera olugero luno ku kabaka w’e Babulooni n’oyogera nti:",{"text":"Omujoozi ng’agudde n’aggwaawo!","poem":1},{"text":"Ekibuga ekya zaabu ekibadde kitutigomya nga tekikyaliwo!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mukama Katonda amenye omuggo ogw’abakozi b’ebibi,","poem":1},{"text":"omuggo gw’obwakabaka ogw’abo abafuga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ogwakubanga olutata","poem":1},{"text":"amawanga n’obusungu,","poem":2},{"text":"ogwafugisanga amawanga ekiruyi,","poem":1},{"text":"ne gubayigganyanga nga tewali aguziyiza.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ensi yonna ewummudde eri mu mirembe,","poem":1},{"text":"era batandise okuyimba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Si ekyo kyokka n’enfugo n’emivule gya Lebanooni,","poem":1},{"text":"nagyo gikuyeeyeereza nti,","poem":2},{"text":"“Kasookanga ogwa","poem":1},{"text":"tebangayo ajja kututema.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Amagombe wansi gagugumuka ku lulwo","poem":1},{"text":"okukusisinkana ng’ojja,","poem":2},{"text":"gagolokosa emyoyo gy’abafu ku lulwo,","poem":1},{"text":"bonna abaali abakulembeze b’ensi;","poem":2},{"text":"gayimusizza bakabaka ku ntebe zaabwe,","poem":1},{"text":"bonna abaali bakabaka baamawanga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abo bonna balyogera","poem":1},{"text":"ne bakugamba nti,","poem":2},{"text":"“Naawe oweddemu amaanyi nga ffe!","poem":1},{"text":"Naawe ofuuse nga ffe!”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ekitiibwa kyo kyonna kissibbwa emagombe,","poem":1},{"text":"awamu n’amaloboozi g’ennanga zo;","poem":2},{"text":"bakwalidde envunyu,","poem":1},{"text":"n’ensiriŋŋanyi zikubisseeko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ng’ogudde okuva mu ggulu,","poem":1},{"text":"ggwe emunyeenye ey’enkya, omwana w’emambya!","poem":2},{"text":"Ng’otemeddwa n’ogwa ku ttaka,","poem":1},{"text":"ggwe eyamegganga amawanga!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wayogera mu mutima gwo nti,","poem":1},{"text":"“Ndirinnya mu ggulu,","poem":2},{"text":"ndigulumiza entebe yange","poem":1},{"text":"okusinga emunyeenye za Katonda;","poem":2},{"text":"era nditeeka entebe yange waggulu ntuule","poem":1},{"text":"ku lusozi olw’okukuŋŋaanirako ku njuyi ez’enkomerero ez’obukiikakkono;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ndyambuka okusinga ebire we bikoma,","poem":1},{"text":"ndyoke nfuuke ng’oyo ali waggulu ennyo.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Naye ossibbwa wansi emagombe,","poem":1},{"text":"ku ntobo y’obunnya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Abo abanaakulabanga banaakwekalirizanga","poem":1},{"text":"bakwewuunye nga bagamba nti,","poem":2},{"text":"“Ono si ye musajja eyayugumyanga ensi,","poem":1},{"text":"ng’anyeenyanyeenya obwakabaka!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Eyafuula ensi okuba eddungu","poem":1},{"text":"n’asuula ebibuga byayo,","poem":2},{"lineBreak":true},{"text":"atakkirizanga bawambe kudda waabwe!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Bakabaka bonna ab’ensi bagalamidde mu kitiibwa,","poem":1},{"text":"buli omu mu ntaana ye,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"naye osuulibbwa okukuggya mu malaalo go","poem":1},{"text":"ng’ettabi ery’omuzizo eryakyayibwa,","poem":2},{"text":"ng’oteekeddwa wamu n’abattibwa, abaafumitibwa n’ekitala,","poem":1},{"text":"abakka eri amayinja g’obunnya;","poem":2},{"lineBreak":true},{"text":"ng’omulambo ogulinyiriddwa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Toligattibwa n’abo mu kuziikibwa","poem":1},{"text":"kubanga wazikiriza ensi yo n’otta abantu bo;","poem":2},{"text":"ezzadde ly’abo abaakola ebibi","poem":1},{"text":"teriryongerwako n’akatono.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mutegeke ekifo batabani be we banattirwa","poem":1},{"text":"olw’obutali butuukirivu bwa bakitaabwe,","poem":2},{"text":"baleme okugolokoka ne balya ensi,","poem":1},{"text":"ne bajjuza ensi yonna ebibuga byabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Nange ndibagolokokerako,” bw’ayogera Mukama Katonda ow’Eggye,","poem":1},{"text":"“ne mmalawo mu Babulooni erinnya lye, n’abalifikkawo,","poem":2},{"text":"n’omwana n’omuzzukulu,”","poem":1},{"text":"bw’ayogera Mukama Katonda.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“Era ndimufuula obutaka bw’ebiwuugulu,","poem":1},{"text":"n’entobazzi","poem":2},{"text":"era mwere n’olweyo oluzikiriza,”","poem":1},{"text":"bw’ayogera Mukama Katonda ow’Eggye.","poem":2}]},{"type":"heading","content":["Obunnabbi bw’Okusuulibwa kwa Bwasuli"]},{"type":"verse","number":24,"content":["Mukama Katonda ow’Eggye alayidde n’ayogera nti,",{"text":"“Ddala nga bwe nalowooza, bwe kirituukirira bwe kityo","poem":1},{"lineBreak":true},{"text":"era nga bwe nateesa,","poem":1},{"text":"bwe kirinywera bwe kityo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ndimenyera Omwasuli mu nsi yange,","poem":1},{"text":"era ndimulinnyirira ku nsozi zange.","poem":2},{"text":"Ekikoligo kye kiribavaako,","poem":1},{"text":"n’omugugu gwe guliggyibwa ku kibegabega kye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Eno y’entegeka eyategekerwa ensi yonna:","poem":1},{"text":"era guno gwe mukono ogwagololwa ku mawanga gonna.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kubanga Mukama Katonda ow’Eggye ye yateesa, kale ani ayinza okukijjulula?","poem":1},{"text":"Omukono gwe gugoloddwa, kale ani ayinza okuguzzaayo?","poem":2}]},{"type":"heading","content":["Obunnabbi Obukwata ku Bufirisuuti"]},{"type":"verse","number":28,"content":["Mu mwaka kabaka Akazi mwe yafiira ne wabaawo obubaka buno."]},{"type":"verse","number":29,"content":[{"text":"Tosanyuka ggwe Bufirisuuti yonna,","poem":1},{"text":"kubanga omuggo ogwakukuba gumenyese,","poem":2},{"text":"ne ku kikolo ky’omusota kulivaako enswera,","poem":1},{"text":"n’ezzadde lyalyo liriba musota ogw’obusagwa oguwalabuka.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Abasingirayo ddala okuba abaavu balifuna ekyokulya,","poem":1},{"text":"n’abali mu kwetaaga balifuna ku tulo","poem":2},{"text":"naye ekikolo kyo ndikittisa enjala","poem":1},{"text":"ate abo abalisigalawo mbattise ekitala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Leekaana ggwe wankaaki, kaaba ggwe ekibuga,","poem":1},{"text":"osaanuuke olw’entiisa ggwe Bufirisuuti yonna!","poem":2},{"text":"Kubanga mu bukiikakkono muvaamu omukka,","poem":1},{"text":"eggye ery’abalwanyi omutali munafu.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Kale kiki kye banaddamu","poem":1},{"text":"ababaka b’eggwanga eryo?","poem":2},{"text":"“Mukama yassaawo Sayuuni,","poem":1},{"text":"ne mu kyo abantu be ababonyaabonyezebwa mwe balifuna obuddukiro.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/13.json","previousChapterAudioLinks":{},"numberOfVerses":32}