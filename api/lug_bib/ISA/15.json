{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":15,"content":[{"type":"heading","content":["Obunnabbi Obukwata ku Mowaabu"]},{"type":"verse","number":1,"content":[{"text":"Mu kiro kimu kyokka Ali ekya Mowaabu kirizikirizibwa","poem":1},{"text":"ne kimalibwawo.","poem":2},{"text":"Kiiri","poem":1},{"noteId":14},{"text":"ekya Mowaabu nakyo","poem":1},{"text":"ne kizikirizibwa mu kiro!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abantu b’e Diboni bambuse ku lusozi","poem":1},{"text":"okukaabira mu ssabo lyabwe.","poem":2},{"lineBreak":true},{"text":"Abantu ba Mowaabu bakaaba bakungubagira ebibuga byabwe ebya Nebo ne Medeba.","poem":2},{"text":"Buli mutwe gwonna gumwereddwako enviiri","poem":1},{"text":"na buli kirevu kyonna kimwereddwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Beesibye ebibukutu mu nguudo;","poem":1},{"text":"ku nnyumba waggulu era ne mu bibangirize ebinene eby’omu bibuga bakaaba.","poem":2},{"text":"Buli muntu atema emiranga","poem":1},{"text":"n’abikaabira amaziga amayitirivu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kesuboni ne Ereyale bakaaba mu ddoboozi ery’omwanguka,","poem":1},{"text":"n’amaloboozi gaabwe gawulikika e Yakazi.","poem":2},{"text":"Abasajja ba Mowaabu abalina ebyokulwanyisa kyebava bakaaba mu ddoboozi ery’omwanguka,","poem":1},{"text":"emmeeme ekankanira munda mu Mowaabu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Omutima gwange gukaabira Mowaabu;","poem":1},{"text":"abantu be babundabunda, baddukira e Zowaali","poem":2},{"lineBreak":true},{"text":"ne Yegulasuserisiya.","poem":2},{"text":"Bambuka e Lakisi","poem":1},{"text":"nga bwe bakaaba;","poem":2},{"text":"bakaabira mu kkubo ery’e Kolonayimu","poem":1},{"text":"nga boogera ku kuzikirizibwa kwabwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amazzi g’e Nimulimu gakalidde,","poem":1},{"text":"omuddo guwotose,","poem":2},{"text":"omuddo omugonvu, guggwaawo,","poem":1},{"text":"tewali kintu kimera.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abantu basomoka akagga ak’enzingu","poem":1},{"text":"nga badduka n’ebintu byabwe bye baafuna ne babitereka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Okukaaba kwetooloodde ensalo za Mowaabu;","poem":1},{"text":"amaloboozi gatuuse e Yegalayimu,","poem":2},{"lineBreak":true},{"text":"n’ebiwoobe ne bituuka e Beererimu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Amazzi g’e Diboni gajjudde omusaayi,","poem":1},{"text":"naye ndyongera okuleeta ebirala ku Diboni;","poem":2},{"text":"empologoma egwe ku abo abalisigalawo mu Mowaabu,","poem":1},{"text":"ne ku abo abalisigalawo ku nsi.","poem":2}]}],"footnotes":[{"noteId":14,"caller":"+","text":"Ali ne Kiiri bye bibuga ebikulu eby’Abamowaabu.","reference":{"chapter":15,"verse":1}}]},"thisChapterLink":"/api/lug_bib/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}