{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"“Muweereze abaana b’endiga","poem":1},{"text":"eri oyo afuga ensi,","poem":2},{"text":"okuva e Seera, ng’oyita mu ddungu,","poem":1},{"text":"okutuuka ku lusozi lwa Muwala wa Sayuuni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ng’ennyonyi ezabulwako ekisu","poem":1},{"text":"n’ezisaasaana nga zidda eno n’eri,","poem":2},{"text":"bwe batyo bwe baliba abawala ba Mowaabu","poem":1},{"text":"awasomokerwa Alunooni.","poem":2},{"noteId":15}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Tuwe ku magezi,","poem":1},{"text":"tubuulire, tukole tutya?","poem":2},{"text":"Mutusiikirize mubeere ng’ekittuluze","poem":1},{"text":"wakati mu ttuntu,","poem":2},{"text":"Abajja bagobebwa mubakweke,","poem":1},{"text":"abajja badaaga temubalyamu lukwe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Muleke aba Mowaabu abajja bagobebwa babeere nammwe.","poem":1},{"text":"Mubataakirize oyo ayagala okubamalawo.”","poem":2},{"lineBreak":true},{"text":"Omujoozi bw’aweddewo,","poem":1},{"text":"n’okubetentebwa ne kuggwaawo;","poem":2},{"lineBreak":true},{"text":"omulumbaganyi aliggwaawo mu nsi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Entebe ey’obwakabaka eryoke etekebwewo mu kwagala,","poem":1},{"text":"era ku yo kutuuleko omufuzi ow’omu nnyumba ya Dawudi","poem":2},{"lineBreak":true},{"text":"alamula mu bwesigwa","poem":2},{"text":"era anoonya obwenkanya","poem":1},{"text":"era ayanguwa okukola eby’obutuukirivu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tuwulidde amalala ga Mowaabu,","poem":1},{"text":"nga bw’ajjudde okwemanya,","poem":2},{"text":"n’amalala ge n’okuvuma;","poem":1},{"text":"naye okwemanya kwe tekugasa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Noolwekyo leka Mowaabu akaabe,","poem":1},{"text":"leka buli muntu akaabire ku Mowaabu.","poem":2},{"text":"Mukungubage,","poem":1},{"text":"musaalirwe obugaati bw’emizabbibu egy’e Kirukalesesi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ennimiro ez’e Kesuboni zikaze,","poem":1},{"text":"n’emizabbibu gy’e Sibuma giweddewo.","poem":2},{"text":"Abafuzi b’amawanga batemeddewo ddala","poem":1},{"text":"emiti gyabwe egyasinganga obulungi,","poem":2},{"text":"egyabunanga ne gituuka e Yazeri","poem":1},{"text":"nga giggukira mu ddungu","poem":2},{"text":"n’emitunsi nga gibuna","poem":1},{"text":"nga gituukira ddala mu nnyanja.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Noolwekyo kyenva nkaaba amaziga nga Yazeri bw’akaaba","poem":1},{"text":"olw’omuzabbibu ogw’e Sibuma.","poem":2},{"text":"Nakufukirira nkutobye n’amaziga gange,","poem":1},{"text":"ggwe Kesuboni ne Ereyale:","poem":2},{"text":"kubanga essanyu ery’ebibala byo","poem":1},{"text":"n’ebyokukungula byo lizikiziddwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ennimiro engimu ziweddemu essanyu n’okweyagala;","poem":1},{"text":"ne mu nnimiro z’emizabbibu temuliba ayimba wadde aleekaana;","poem":2},{"text":"mu masogolero temulibaamu musogozi asogoleramu nvinnyo;","poem":1},{"text":"okuleekaana kw’omusogozi ng’asogola kukomye.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Omutima gwange kyeguva gukaabira Mowaabu mu ddoboozi ng’ery’ennanga,","poem":1},{"text":"emmeeme yange munda n’ekaabira Kirukeresi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Awo Mowaabu bw’alyeyanjula, mu bifo ebigulumivu,","poem":1},{"text":"alyekooya yekka;","poem":2},{"text":"bw’aligenda okusamira,","poem":1},{"text":"tekirimuyamba.","poem":2}]},{"type":"verse","number":13,"content":["Ekyo kye kigambo Mukama kye yayogera ku Mowaabu mu biro eby’edda."]},{"type":"verse","number":14,"content":["Naye kaakano Mukama Katonda agamba nti, “Mu myaka esatu, ng’omukozi gwe bapangisizza bwe yandigibaze, ekitiibwa kya Mowaabu kijja kuba nga kifuuse ekivume ekinyoomebwa, newaakubadde ng’alina ekibiina ekinene; era walisigalawo abantu batono ate nga banafu ddala.”"]}],"footnotes":[{"noteId":15,"caller":"+","text":"Alunooni mugga mukulu mu Mowaabu; guli nsalo ey’obukiikakkono","reference":{"chapter":16,"verse":2}}]},"thisChapterLink":"/api/lug_bib/ISA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/15.json","previousChapterAudioLinks":{},"numberOfVerses":14}