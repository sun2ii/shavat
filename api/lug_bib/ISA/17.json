{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":17,"content":[{"type":"heading","content":["Obubaka Obukwata ku Ddamasiko"]},{"type":"verse","number":1,"content":[{"text":"“Laba Ddamasiko tekikyali kibuga,","poem":1},{"text":"kifuuse matongo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ebibuga bya Aloweri babidduseemu:","poem":1},{"text":"birirekerwa ensolo mwe zinaagalamiranga","poem":2},{"lineBreak":true},{"text":"nga tewali azikanga.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ekigo eky’amaanyi kirisaanyizibwawo mu Efulayimu,","poem":1},{"text":"n’obwakabaka mu Ddamasiko bulimalibwawo;","poem":2},{"text":"naye abalisigalawo mu Busuuli,","poem":1},{"text":"baliba n’ekitiibwa ng’eky’abaana ba Isirayiri,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda ow’Eggye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Awo olulituuka ku lunaku luli, ekitiibwa kya Yakobo kirikendeera;","poem":1},{"text":"era akoggere ddala.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne kiba ng’omukunguzi bw’akuŋŋaanya eŋŋaano,","poem":1},{"text":"n’omukono gwe ne gukungula empeke;","poem":2},{"text":"weewaawo kiriba ng’omuntu bw’alonda ebinywa by’eŋŋaano","poem":1},{"text":"mu Kiwonvu kya Lefayimu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Naye mulisigalamu ebinywa ebirondererwa","poem":1},{"text":"ng’omuzeyituuni bwe gubeera nga gukubiddwa,","poem":2},{"text":"ne guleka ebibala bibiri oba bisatu waggulu ku busongezo,","poem":1},{"text":"bina oba bitaano ku busongezo bw’omuti omugimu,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama, Katonda wa Isirayiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ku lunaku luli abantu balirowooza ku Mutonzi waabwe,","poem":1},{"text":"n’amaaso gaabwe galikyukira Omutukuvu wa Isirayiri.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"So tebalirowooza ku byoto bya balubaale baabwe,","poem":1},{"text":"emirimu gy’emikono gyabwe, be beekolera,","poem":2},{"text":"oba empagi za katonda wa Baasera","poem":1},{"text":"oba ebyoto kwe bootereza obubaane.","poem":2}]},{"type":"verse","number":9,"content":["Mu biro ebyo ebibuga byabwe eby’amaanyi Abayisirayiri bye baabalesa, biriba ng’ebifo ebyameramu ebisaka ne kalandalugo. Byonna birisigala matongo."]},{"type":"verse","number":10,"content":[{"text":"Weerabidde Katonda Omulokozi wo,","poem":1},{"text":"so tojjukidde Lwazi lwa maanyi go;","poem":2},{"text":"kyova osimbamu ebisimbe eby’okukusanyusa","poem":1},{"text":"n’osigamu omuzabbibu oguvudde ebweru.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wadde obisimba bulungi nnyo ne bimera ku lunaku lw’obisimbye,","poem":1},{"text":"era ne bimerusa ensigo ku makya kwennyini kwe bisimbiddwa,","poem":2},{"text":"tolibaako ky’okungula","poem":1},{"text":"wabula obulumi obutawonyezeka n’ennaku ey’ekitalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Woowe oluyoogaano olw’amawanga amangi,","poem":1},{"text":"bawuluguma ng’okuwuluguma kw’ennyanja esiikuuse!","poem":2},{"text":"Okuwuluguma kw’abantu,","poem":1},{"text":"bawuluguma ng’amazzi agayiika n’amaanyi amangi!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wadde amawanga galiwuuma n’okuwulikika ne gawulikika ng’amazzi agayiika n’amaanyi amangi,","poem":1},{"text":"Mukama bw’aligagoba, galibulawo mbagirawo.","poem":2},{"text":"Galiba ng’ebisusunku bwe bitwalibwa empewo;","poem":1},{"text":"era ng’enfuufu ekunta nga yeetooloola, enkuba ng’eneetera okutonnya.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Entiisa ey’amaanyi eribagwako akawungeezi.","poem":1},{"text":"Buliba tebunnakya ng’abalabe bonna tewakyali.","poem":2},{"text":"Guno gwe mugabo gw’abo abatunyaga,","poem":1},{"text":"era y’empeera y’abo abatunyagako ebyaffe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/16.json","previousChapterAudioLinks":{},"numberOfVerses":14}