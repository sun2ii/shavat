{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":18,"content":[{"type":"heading","content":["Obunnabbi Obukwata ku Kuusi"]},{"type":"verse","number":1,"content":[{"text":"Zikusanze, ggwe ensi ey’ebiwaawaatiro ebikwakwaya,","poem":1},{"text":"eri emitala w’emigga gya Kuusi,","poem":2},{"noteId":16}]},{"type":"verse","number":2,"content":[{"text":"etuma ababaka ne bagendera mu maato","poem":1},{"text":"ag’ebitoogo ku nnyanja.","poem":2},{"lineBreak":true},{"text":"Mugende mmwe ababaka abangu, eri abantu abawanvu ab’emibiri emiweweevu,","poem":1},{"text":"eri abantu abatiibwa abeewala n’ab’okumpi,","poem":2},{"text":"eggwanga ery’amaanyi eryogera olulimi olutamanyiddwa,","poem":1},{"text":"ensi eyawulwamu emigga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mmwe mwenna abantu abali mu nsi,","poem":1},{"text":"mmwe ababeera ku nsi,","poem":2},{"text":"bendera lweriwanikibwa ku nsozi,","poem":1},{"text":"muligiraba,","poem":2},{"text":"era ekkondeere bwe lirifuuyibwa,","poem":1},{"text":"muliriwulira.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kubanga bw’atyo Mukama bw’aŋŋambye nti,","poem":1},{"text":"“Ndyesirikira ntunule nga nsinziira ewange,","poem":2},{"text":"ng’olubugumu olutemagana mu musana,","poem":1},{"text":"ng’ekire ky’omusulo mu lubugumu olw’omu biro eby’amakungula.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kubanga okukungula kuliba tekunatuuka,","poem":1},{"text":"okumulisa nga kuwedde, n’ekimuli nga kifuuka zabbibu eyengedde,","poem":2},{"text":"aliwawaagula obutabi n’ebiwabyo,","poem":1},{"text":"n’amatabi agalanda aligasalira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gonna galirekerwa ennyonyi ez’oku nsozi ezirya ebiramu","poem":1},{"text":"n’ensolo ez’ensi.","poem":2},{"text":"Era ennyonyi ezirya ebiramu zirye okwo mu biseera by’ekyeya,","poem":1},{"text":"n’ensolo zonna ez’omu nsiko zirye okwo mu biseera by’obunnyogovu.","poem":2}]},{"type":"verse","number":7,"content":["Mu kiseera ekyo Mukama Katonda ow’Eggye balimuleetera ebirabo,",{"text":"ensi ey’abantu abawanvu ab’emibiri emiweweevu,","poem":1},{"text":"abantu abatiibwa abeewala n’abookumpi,","poem":2},{"text":"ensi ey’eryanyi,","poem":1},{"text":"eyawulwamu emigga,","poem":2},"ku lusozi Sayuuni ekifo ky’erinnya lya Mukama Ayinzabyonna."]}],"footnotes":[{"noteId":16,"caller":"+","text":"Mu biro bya Isaaya, waaliwo bafalaawo aba Esiyopya abaafuganga Misiri. Abo be baanoonya okubeerwa okuva eri Abapalesitayini, balwanyise Bwasuli","reference":{"chapter":18,"verse":1}}]},"thisChapterLink":"/api/lug_bib/ISA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/17.json","previousChapterAudioLinks":{},"numberOfVerses":7}