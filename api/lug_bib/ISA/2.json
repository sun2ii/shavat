{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":2,"content":[{"type":"heading","content":["Olusozi lwa Mukama"]},{"type":"verse","number":1,"content":["Kuno kwe kwolesebwa Isaaya omwana wa Amozi kwe yalaba ku Yuda ne Yerusaalemi."]},{"type":"line_break"},{"type":"verse","number":2,"content":["Olulituuka mu nnaku ez’oluvannyuma",{"text":"olusozi okuli ennyumba ya Mukama Katonda","poem":1},{"text":"lulinywezebwa lusinge ensozi zonna okugulumira,","poem":2},{"text":"luliyimusibwa lusukke ku ndala zonna,","poem":1},{"text":"era amawanga gonna galilwolekera.","poem":2}]},{"type":"verse","number":3,"content":["Abantu bangi balijja bagambe nti,",{"text":"Mujje twambuke tulinnye ku lusozi lwa Mukama,","poem":1},{"text":"mu nnyumba ya Katonda wa Yakobo,","poem":2},{"text":"alyoke atuyigirize amakubo ge,","poem":1},{"text":"tulyoke tutambulire mu mateeka ge.","poem":2},{"text":"Kubanga Mukama aliteeka amateeka ng’asinziira mu Sayuuni,","poem":1},{"text":"era mu Yerusaalemi abayigirize ekigambo kye.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Alisala enkaayana z’amawanga,","poem":1},{"text":"aliramula emisango gy’abantu bangi,","poem":2},{"text":"era ebitala byabwe balibiwesaamu enkumbi,","poem":1},{"text":"n’amafumu gaabwe bagaweeseemu ebiwabyo.","poem":2},{"text":"Eggwanga teririyimusa kitala ku ggwanga linnaalyo,","poem":1},{"text":"so tebalyetegeka kulwana ntalo nate.","poem":2}]},{"type":"heading","content":["Mukama Ayita Ennyumba Ya Yakobo Okwenenya"]},{"type":"verse","number":5,"content":[{"text":"Ggwe ennyumba ya Yakobo,","poem":1},{"text":"mujje tutambulire mu kitangaala kya Mukama Katonda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wayabulira abantu bo","poem":1},{"text":"ab’ennyumba ya Yakobo,","poem":2},{"text":"kubanga eggwanga lijjudde obusamize obuva mu buvanjuba,","poem":1},{"text":"n’obulaguzi obuli nga obw’omu Bafirisuuti,","poem":2},{"lineBreak":true},{"text":"era basizza kimu ne bannamawanga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ensi yaabwe ejjudde effeeza ne zaabu,","poem":1},{"text":"n’obugagga bwabwe tebuliiko kkomo:","poem":2},{"text":"ensi yaabwe ejjudde embalaasi,","poem":1},{"text":"era erimu n’amagaali g’embalaasi mangi nnyo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ensi yaabwe ejjudde bakatonda ababumbe,","poem":1},{"text":"basinza omulimu gw’emikono gyabwe bo,","poem":2},{"lineBreak":true},{"text":"engalo zaabwe gwe zeekolera.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kale omuntu wa kukkakkanyizibwa,","poem":1},{"text":"omuntu wa kussibwa wansi.","poem":2},{"lineBreak":true},{"text":"Mukama, tobasonyiwa!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mugende mwekweke mu njazi,","poem":1},{"text":"mwekweke mu binnya wansi mu ttaka,","poem":2},{"text":"nga mudduka entiisa ya Mukama Katonda,","poem":1},{"text":"nga mudduka entiisa y’ekitiibwa ky’obukulu bwe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Olunaku lujja okweyisa kw’omuntu","poem":1},{"text":"n’amalala ge lwe birizikirizibwa,","poem":2},{"text":"era Mukama Katonda yekka yaligulumizibwa ku olwo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kubanga Mukama Katonda ow’Eggye alina olunaku lw’ategese","poem":1},{"text":"eri abo bonna ab’amalala era abeewanise,","poem":2},{"lineBreak":true},{"text":"eri ebyo byonna eby’egulumiza ebijjudde","poem":2},{"lineBreak":true},{"text":"okwemanya n’okwewulira.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Alizikiriza emiti gy’omu Lebanooni,","poem":1},{"noteId":2},{"text":"emiwanvu emigulumivu,","poem":1},{"text":"n’emivule gyonna egya Basani.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Era n’ensozi zonna empanvu,","poem":1},{"text":"n’obusozi bwonna obugulumivu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Na buli mulongooti gwonna omuwanvu,","poem":1},{"text":"na buli bbugwe gwe bakomese.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Alizikiriza emmeeri zonna ez’e Talusiisi,","poem":1},{"text":"n’ebifaananyi byonna ebisiige eby’omuwendo omungi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Era okwegulumiza kw’abantu kulijemulukuka,","poem":1},{"text":"n’amalala g’abantu galissibwa;","poem":2},{"text":"era Mukama Katonda yekka yaligulumizibwa ku lunaku olwo.","poem":1}]},{"type":"verse","number":18,"content":[{"text":"N’ebifaananyi bye basinza birizikiririzibwa ddala ku olwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Abantu balidduka ne beekweka mu mpuku mu mayinja,","poem":1},{"text":"ne mu binnya mu ttaka,","poem":2},{"text":"nga badduka entiisa","poem":1},{"text":"n’ekitiibwa ky’obukulu bwa Mukama Katonda,","poem":2},{"lineBreak":true},{"text":"bwaliyimuka okukankanya ensi n’amaanyi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ku lunaku olwo abantu balisuulira ddala","poem":1},{"text":"bakatonda baabwe abakole mu ffeeza, n’abakole mu zaabu,","poem":2},{"text":"be beekolera nga ba kusinzanga,","poem":1},{"text":"ne babakanyuga eri emmese n’eri ebinyira.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Balidduka ne beekukuma mu mpuku","poem":1},{"text":"ez’amayinja amaatifu","poem":2},{"text":"nga badduka entiisa","poem":1},{"text":"n’ekitiibwa ky’obukulu bwa Mukama Katonda,","poem":2},{"lineBreak":true},{"text":"bwaliyimuka okukankanya ensi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Mulekeraawo okwesiga omuntu","poem":1},{"text":"alina omukka obukka mu nnyindo ze.","poem":2},{"text":"Kiki ennyo kyali?","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Lebanooni kitundu ekiri mu buvanjuba bwa Yoludaani, ekimanyiddwa olw’emivule gyayo n’ente ennyingi","reference":{"chapter":2,"verse":13}}]},"thisChapterLink":"/api/lug_bib/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}