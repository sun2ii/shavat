{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":21,"content":[{"type":"heading","content":["Obunnabbi Obukwata ku Babulooni"]},{"type":"verse","number":1,"content":["Obunnabbi obukwata ku Ddungu eririraanye ennyanja:",{"text":"Ng’embuyaga bwe zikunta nga ziyita mu nsi ey’obukiikaddyo,","poem":1},{"text":"bw’atyo alumba bw’ava mu ddungu","poem":2},{"lineBreak":true},{"text":"eririraanye ensi etiisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nfunye okwolesebwa okw’entiisa:","poem":1},{"text":"alyamu olukwe akola omulimu gwe, n’omunyazi anyaga.","poem":2},{"text":"Eramu, lumba! Obumeedi zingiza!","poem":1},{"text":"Ndikomya okusinda kwonna kwe yaleeta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Omubiri gwange kyeguvudde gulumwa,","poem":1},{"text":"n’obulumi bunkwata, ng’omukazi alumwa okuzaala;","poem":2},{"text":"nnyiize olw’ebyo bye mpulira,","poem":1},{"text":"bye ndaba bimazeemu amaanyi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Omutima gwange gutya,","poem":1},{"text":"Entiisa endetera okukankana;","poem":2},{"text":"Akasendabazaana ke nnali njayaanira,","poem":1},{"text":"kanfukidde ekikankano.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bateekateeka olujjuliro,","poem":1},{"text":"bayalirira ebiwempe,","poem":2},{"lineBreak":true},{"text":"ne balya, ne banywa!","poem":2},{"text":"Mugolokoke mmwe abakulembeze,","poem":1},{"text":"musiige engabo amafuta.","poem":2}]},{"type":"verse","number":6,"content":["Kino Mukama ky’aŋŋamba nti,",{"text":"“Genda ofune omukuumi","poem":1},{"text":"akuleetere amawulire ku ebyo by’alaba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bw’alaba amagaali","poem":1},{"text":"n’ebibinja by’embalaasi,","poem":2},{"text":"n’abeebagazi ku ndogoyi","poem":1},{"text":"oba abeebagazi ku ŋŋamira","poem":2},{"text":"yeekuume,","poem":1},{"text":"era yeegendereze.”","poem":2}]},{"type":"verse","number":8,"content":["Awo omukuumi n’ayogera mu ddoboozi ery’omwanguka ng’agamba nti,",{"text":"“Mukama wange, buli lunaku nnyimirira ku munaala,","poem":1},{"text":"buli kiro mbeera ku mulimu gwange.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Laba omusajja wuuno ajjira mu ggaali,","poem":1},{"text":"ng’alina n’ekibinja ky’embalaasi.","poem":2},{"text":"Era ayanukula bw’ati nti,","poem":1},{"text":"‘Babulooni kigudde, weewaawo kigudde.","poem":2},{"text":"Ebifaananyi bya bakatonda baakyo byonna","poem":1},{"text":"bibetenteddwa wansi ku ttaka.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Abantu bange, abasesebbuddwa ku gguuliro,","poem":1},{"text":"mbategeeza kyempulidde okuva eri Mukama Katonda ow’Eggye, Katonda wa Isirayiri.","poem":2}]},{"type":"heading","content":["Obunnabbi Obukwata ku Edomu"]},{"type":"verse","number":11,"content":["Obunnabbi obukwata ku Duuma:",{"text":"Waliwo ankowoola okuva mu Seyiri ng’ayogera nti,","poem":1},{"text":"“Omukuumi, bunaakya ddi?","poem":2},{"lineBreak":true},{"text":"Omukuumi, bunaakya ddi?”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Omukuumi ayanukula bw’ati nti,","poem":1},{"text":"“Bulikya, era buliziba.","poem":2},{"text":"Bw’obaako ne ky’obuuza kibuuze","poem":1},{"text":"okomewo nate.”","poem":2}]},{"type":"heading","content":["Obunnabbi Obukwata ku Buwalabu"]},{"type":"verse","number":13,"content":["Obunnabbi obukwata ku Buwalabu:",{"text":"Mmwe Abadedeni abatambulira mu bibinja,","poem":1},{"text":"abasiisira mu bisaka bya Buwalabu,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"muleetere abalumwa ennyonta amazzi; mmwe ababeera mu Teema, muleetere abanoonyi b’obubudamu emmere.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Badduka ekitala,","poem":1},{"text":"badduka ekitala ekisowole,","poem":2},{"text":"badduka omutego ogunaanuddwa,","poem":1},{"text":"badduka n’akabi k’entalo.","poem":2}]},{"type":"verse","number":16,"content":["Bw’ati Mukama bw’aŋŋamba nti, “Mu mwaka gumu, ng’endagaano gye bakolera omukozi bw’eba, ekitiibwa kyonna ekya Kedali kirikoma."]},{"type":"verse","number":17,"content":["Ku b’obusaale abaliwona, ne ku basajja abalwanyi abazira ab’e Kedali, walisigalawo batono.” Mukama Katonda wa Isirayiri ayogedde."]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}