{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":22,"content":[{"type":"heading","content":["Obunnabbi Obufa ku Yerusaalemi"]},{"type":"verse","number":1,"content":["Obunnabbi obukwata ku Kiwonvu ky’Okwolesebwa:",{"text":"Kiki ekikutawanya kaakano,","poem":1},{"text":"n’okulinnya n’olinnya waggulu ku busolya,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ggwe ekibuga ekijjudde oluyoogaano,","poem":1},{"text":"ggwe ekibuga eky’amasanyu era eky’ebinyumu?","poem":2},{"text":"Abantu bo abattibwa,","poem":1},{"text":"tebaafa kitala newaakubadde okufiira mu lutalo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abakulembeze bo bonna baddukidde wamu;","poem":1},{"text":"bawambiddwa awatali kulwana.","poem":2},{"text":"Bonna baakwatibwa ne batwalibwa wamu nga basibe,","poem":1},{"text":"kubanga badduka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kyenava njogera nti, “Munveeko,","poem":1},{"text":"mundeke nkaabire ddala nnyo.","poem":2},{"text":"Temugezaako kunsaasira","poem":1},{"text":"olw’okuzikirizibwa kw’omuwala w’abantu bange.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mukama, Mukama Katonda ow’Eggye alina olunaku","poem":1},{"text":"olw’akatabanguko,","poem":2},{"lineBreak":true},{"text":"olw’okulinyirirwa n’entiisa mu Kiwonvu ky’Okwolesebwa;","poem":2},{"text":"olunaku olw’okumenya bbugwe,","poem":1},{"text":"n’okukaabirira ensozi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eramu ayambalidde omufuko gw’obusaale,","poem":1},{"text":"n’atwala n’abavuzi b’amagaali ge n’embalaasi,","poem":2},{"lineBreak":true},{"text":"Kiri","poem":2},{"noteId":18},{"text":"asabuukulula engabo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ebiwonvu byo ebisinga obulungi bijjudde amagaali,","poem":1},{"text":"n’abeebagala embalaasi bassibbwa ku wankaaki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Okwerinda kwa Yuda kuggyiddwawo.","poem":1},{"text":"Ku lunaku olwo watunuulira","poem":2},{"lineBreak":true},{"text":"ebyokulwanyisa eby’omu Lubiri olw’Ekibira.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Walaba amabanga agaali mu kwerinda","poem":1},{"text":"kw’Ekibuga kya Dawudi,","poem":2},{"text":"wakuŋŋaanya amazzi","poem":1},{"text":"mu Kidiba eky’Emmanga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wabala ebizimbe mu Yerusaalemi","poem":1},{"text":"n’omenya amayumba okusobola okunyweza bbugwe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wasima ekidiba omuterekebwa amazzi wakati w’ebisenge ebibiri,","poem":1},{"text":"n’okuŋŋaanya ag’ekidiba ekikadde,","poem":2},{"text":"naye tewatunuulira Oyo eyakisima,","poem":1},{"text":"wadde okussaamu ekitiibwa Oyo eyakiteekateeka mu biro eby’edda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ku lunaku olwo Mukama Katonda ow’Eggye","poem":1},{"text":"yalangirira okukaaba n’okukuba ebiwoobe,","poem":2},{"text":"n’okwemwako enviiri","poem":1},{"text":"n’okwambala ebibukutu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Naye laba, ssanyu na kujaguza,","poem":1},{"text":"okubaaga ente n’okutta endiga,","poem":2},{"lineBreak":true},{"text":"okulya ennyama n’okunywa envinnyo.","poem":2},{"text":"Mwogere nti, “Leka tulye, era tunywe","poem":1},{"text":"kubanga enkya tunaafa.”","poem":2}]},{"type":"verse","number":14,"content":["Mukama ow’Eggye akimbikulidde n’aŋŋamba nti, “Ekibi kino tekirisonyiyibwa wadde okuggyibwawo okutuusa lw’olifa,” bw’ayogera Mukama Katonda ow’Eggye."]},{"type":"verse","number":15,"content":["Bw’ati bw’ayogera Mukama Katonda ow’Eggye nti,",{"text":"“Genda eri omuwanika oyo,","poem":1},{"text":"eri Sabuna avunaanyizibwa olubiri omugambe nti,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Okola ki wano era ani yakuwadde olukusa","poem":1},{"text":"okwetemera entaana wano,","poem":2},{"text":"n’otema n’amaanyi entaana yo waggulu mu lwazi,","poem":1},{"text":"ne weerongoosereza eyo ekifo eky’okuwummuliramu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Weegendereze Mukama Katonda anaatera okukuvumbagira,","poem":1},{"text":"akuggyewo ggwe omusajja ow’amaanyi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Alikuzingazingako,","poem":1},{"text":"n’akukanyuga mu nsi engazi, nga bwe yandikanyuze omupiira ogusambwa.","poem":2},{"text":"Eyo gy’olifiira,","poem":1},{"text":"era eyo amagaali go ag’ekitiibwa gye galisigala,","poem":2},{"lineBreak":true},{"text":"ggwe ensonyi ez’ennyumba ya Mukama wo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ndikuggya ku ntebe yo,","poem":1},{"text":"era oliggyibwa mu kifo kyo.","poem":2}]},{"type":"verse","number":20,"content":["“Mu biro ebyo nditumya omuweereza wange Eriyakimu mutabani wa Kirukiya."]},{"type":"verse","number":21,"content":["Ndimwambaza ekyambalo kyo, ne munyweza n’olukoba lwo, ne mukwasa obuyinza bwo. Aliba kitaawe w’abo ababeera mu Yerusaalemi, n’eri ennyumba ya Yuda."]},{"type":"verse","number":22,"content":["Ndimukwasa ekisumuluzo ky’ennyumba ya Dawudi; bw’aliggulawo tewaliba aggalawo, bw’aliggalawo tewaliba aggulawo."]},{"type":"verse","number":23,"content":["Ndimunyweza mu kifo ng’enkondo ennene, era aliba ntebe ya kitiibwa eri ennyumba ya kitaawe."]},{"type":"verse","number":24,"content":["Ekitiibwa ky’ennyumba ye kiribeera ku nnyumba ye, ne ku zadde lye ne ku nda ye yonna, ne ku bintu bye ebinywerwamu, okuva ku bibya okutuuka ku nsumbi.”"]},{"type":"verse","number":25,"content":["Bw’ati bw’ayogera Katonda ow’Eggye nti, “Ku lunaku olwo, enkondo ennene eyakomererwa mu kifo n’enywera erisalibwa, n’eneguka, n’egwa, n’omugugu gw’ekutte gulisarwako.” Mukama ayogedde."]}],"footnotes":[{"noteId":18,"caller":"+","text":"Kiri Kifo ekisangibwa mu Bwasuli","reference":{"chapter":22,"verse":6}}]},"thisChapterLink":"/api/lug_bib/ISA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/21.json","previousChapterAudioLinks":{},"numberOfVerses":25}