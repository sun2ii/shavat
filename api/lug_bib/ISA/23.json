{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":23,"content":[{"type":"heading","content":["Obunnabbi Obukwata ku Tuulo"]},{"type":"verse","number":1,"content":["Obunnabbi obukwata ku Tuulo:",{"text":"Mukube ebiwoobe, mmwe ebyombo by’e Talusiisi,","poem":1},{"text":"kubanga Tuulo kizikirizibbwa","poem":2},{"lineBreak":true},{"text":"ne mutasigala nnyumba newaakubadde ebyombo we biyinza okugobera.","poem":2},{"text":"Ekigambo kyababikulirwa","poem":1},{"text":"okuva mu nsi ya Kittimu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Musirike mmwe ab’oku kizinga","poem":1},{"text":"nammwe abasuubuzi b’e Sidoni","poem":2},{"lineBreak":true},{"text":"abagaggawalidde ku nnyanja.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ku nnyanja ennene","poem":1},{"text":"kwajjirako ensigo za Sikoli,","poem":2},{"text":"n’ebyamakungula bya Kiyira bye byali amagoba ga Tuulo,","poem":1},{"text":"era yafuuka akatale k’amawanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Okwatibwe ensonyi ggwe Sidoni naawe ggwe ekigo ky’ennyanja,","poem":1},{"text":"kubanga ennyanja eyogedde nti:","poem":2},{"text":"“Sirumwangako kuzaala wadde okuzaalako.","poem":1},{"text":"Sirabiriranga baana babulenzi newaakubadde okukuza abaana aboobuwala.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ekigambo bwe kirijja eri Misiri,","poem":1},{"text":"balinakuwalira ebigambo ebiva e Tuulo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Muwunguke mugende e Talusiisi,","poem":1},{"text":"mukube ebiwoobe mmwe abantu ab’oku kizinga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kino kye kibuga kyammwe eky’amasanyu,","poem":1},{"text":"ekibuga ekikadde,","poem":2},{"text":"ekyagenda okusenga","poem":1},{"text":"mu nsi eyeewala?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ani eyateekateeka kino okutuuka ku Tuulo,","poem":1},{"text":"Tuulo ekitikkira engule,","poem":2},{"text":"ekibuga ekirina abasuubuzi abalangira,","poem":1},{"text":"ekirina abasuubuzi abamanyifu mu nsi?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mukama Katonda ow’Eggye yakiteekateeka,","poem":1},{"text":"amuggyemu amalala n’ekitiibwa kyonna,","poem":2},{"lineBreak":true},{"text":"akkakkanye n’abo bonna abamanyifu ku nsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ne bw’otambula ku lukalu lwonna olw’omugga Kiyira,","poem":1},{"text":"tokyalina kifo ebyombo we bituukira ggwe muwala wa Talusiisi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mukama Katonda agolodde omukono gwe eri ennyanja,","poem":1},{"text":"n’akankanya obwakabaka bwayo.","poem":2},{"text":"Awadde ekiragiro ekikwata ku Kanani","poem":1},{"text":"nti ebigo byakyo birizikirizibwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yayogera nti, “Tokyaddayo kukola bya masanyu nate,","poem":1},{"text":"ggwe muwala wa Sidoni embeerera obetenteddwa.","poem":2},{"text":"Yambuka osomoke ogende e Kittimu,","poem":1},{"text":"naye nayo tolifunirayo kuwummula.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Laba ensi ey’Abakaludaaya","poem":1},{"text":"abantu abo abatakyaliwo.","poem":2},{"text":"Omwasuli agifudde","poem":1},{"text":"ekifo ekibeeramu ensolo ez’omu ddungu.","poem":2},{"text":"Baayimusa eminaala gyabwe,","poem":1},{"text":"ne bamenya ebigo byabwe,","poem":2},{"lineBreak":true},{"text":"era n’abazikiriza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mukube ebiwoobe mmwe ebyombo by’e Talusiisi,","poem":1},{"text":"ekigo kyo kizikiriziddwa.","poem":2}]},{"type":"verse","number":15,"content":["Mu biro ebyo Tuulo kiryerabirwa okumala emyaka nsanvu, gy’emyaka kabaka gy’awangaala. Naye oluvannyuma lw’emyaka egyo ensanvu, ekirituuka ku Tuulo kiriba ng’ekiri mu luyimba olw’omwenzi."]},{"type":"verse","number":16,"content":[{"text":"“Kwata ennanga, otambulire mu kibuga,","poem":1},{"text":"ggwe omwenzi eyeerabiddwa.","poem":2},{"text":"Ennanga gikube bulungi,","poem":1},{"text":"oyimbe ennyimba nnyingi olyoke ojjukirwe.”","poem":2}]},{"type":"verse","number":17,"content":["Oluvannyuma lw’emyaka ensanvu, Mukama alikyalira Tuulo. Aliddayo ku mulimu gwe ogw’obwamalaaya, era alibukola mu bwakabaka bwonna obuli ku nsi."]},{"type":"verse","number":18,"content":["Wabula amagoba ge ne byalifunamu biriyawulibwako bibe bya Mukama, tebiriterekebwa newaakubadde okukwekebwa, omuntu okubikozesa by’ayagala. Amagoba ge galigenda eri abo ababeera mu maaso ga Mukama, basobole okuba n’emmere emala, n’okuba n’ebyambalo ebirungi."]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}