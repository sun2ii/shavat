{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":24,"content":[{"type":"heading","content":["Mukama Ayogera ku Kuzikiriza Ensi"]},{"type":"verse","number":1,"content":[{"text":"Laba Mukama alifuula ensi amatongo,","poem":1},{"text":"agimalirewo ddala,","poem":2},{"text":"era azikirize n’obwenyi bwayo","poem":1},{"text":"era asaasaanye n’abagibeeramu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bwe kityo bwe kiriba,","poem":1},{"text":"ekiriba ku kabona kye kiriba ne ku bantu,","poem":2},{"lineBreak":true},{"text":"ekiriba ku mwami kye kiriba ne ku muweereza omusajja,","poem":2},{"lineBreak":true},{"text":"ekiriba ku mugole we kye kiriba ne ku muweereza we omukazi,","poem":2},{"lineBreak":true},{"text":"ekiriba ku atunda kye kiriba ne ku muguzi,","poem":2},{"lineBreak":true},{"text":"ekiriba ku awola kye kiriba ne ku yeewola,","poem":2},{"lineBreak":true},{"text":"ekiriba ku abanja kye kiriba ne ku abanjibwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Okumalibwamu ensa, ensi erimalibwamu ddala ensa,","poem":1},{"text":"n’okunyagibwa, erinyagibwa.","poem":2},{"text":"Mukama Katonda y’akyogedde.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ensi ekala n’eggwaamu obulamu,","poem":1},{"text":"ensi ekala n’ewuubaala,","poem":2},{"lineBreak":true},{"text":"abantu ab’ekitiibwa baggwaamu amaanyi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ensi eyonooneddwa abantu baayo,","poem":1},{"text":"bajeemedde amateeka,","poem":2},{"text":"bamenye ebiragiro,","poem":1},{"text":"ne bamenyawo n’endagaano ey’emirembe n’emirembe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Noolwekyo ekikolimo kimalawo ensi;","poem":1},{"text":"n’abantu baayo bateekwa okusasula olw’omusango ogwabasinga.","poem":2},{"text":"Abatuuze b’ensi bayidde,","poem":1},{"text":"Era abatono be basigaddewo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wayini omusu aggwaamu, n’omuzabbibu gukala,","poem":1},{"text":"ab’amasanyu bonna bakaaba olw’obulumi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Okujaguza kw’ebitaasa kusirise,","poem":1},{"text":"n’oluyoogaano lw’abo ababeera mu masanyu lusirise,","poem":2},{"lineBreak":true},{"text":"entongooli esanyusa esirise.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tebakyanywa nvinnyo nga bwe bayimba,","poem":1},{"text":"n’omwenge gukaayira abagunywa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ekibuga ekyazikirizibwa kisigadde nga matongo,","poem":1},{"text":"na buli mulyango oguyingira mu nnyumba guzibiddwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bakaabira envinnyo mu nguudo,","poem":1},{"text":"n’essanyu lyonna liweddewo,","poem":2},{"lineBreak":true},{"text":"n’okujaguza kwonna tekukyaliwo mu nsi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ekibuga kizikiridde","poem":1},{"text":"wankaaki waakyo amenyeddwamenyeddwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bwe kityo bwe kiriba ku nsi","poem":1},{"text":"ne mu mawanga","poem":2},{"text":"ng’omuzeyituuni bwe gunyeenyezebwa","poem":1},{"text":"oba ng’ebinywa ebisigaddewo bwe bibeera oluvannyuma lw’okukungula kw’ezabbibu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Bayimusa amaloboozi gaabwe, baleekaana olw’essanyu,","poem":1},{"text":"batendereza ekitiibwa kya Mukama Katonda okuva mu bugwanjuba.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Noolwekyo abo abali mu buvanjuba mugulumize Mukama,","poem":1},{"text":"mutendereze erinnya lya Mukama Katonda wa Isirayiri,","poem":2},{"lineBreak":true},{"text":"mu bizinga eby’ennyanja.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tuwulira okuyimba okuva ku nkomerero y’ensi,","poem":1},{"text":"“Ekitiibwa kibeere eri Omutuukirivu.”","poem":2},{"lineBreak":true},{"text":"Naye ne njogera nti, “Nsanawo, nsanawo.","poem":1},{"text":"Zinsaze.","poem":2},{"text":"Ab’olukwe balya mu bannaabwe olukwe,","poem":1},{"text":"Ab’enkwe bakozesa enkwe okulya mu bannaabwe olukwe.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Entiisa n’obunnya n’omutego bibalindiridde,","poem":1},{"text":"mmwe abantu b’ensi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Buli alidduka eddoboozi ery’entiisa,","poem":1},{"text":"aligwa mu kinnya,","poem":2},{"text":"na buli alirinnya n’ava mu kinnya","poem":1},{"text":"alikwatibwa mu mutego.","poem":2},{"lineBreak":true},{"text":"Enzigi z’eggulu ziguddwawo,","poem":1},{"text":"N’emisingi gy’ensi gikankana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ensi emenyeddwamenyeddwa,","poem":1},{"text":"ensi eyawuliddwamu,","poem":2},{"lineBreak":true},{"text":"ensi ekankanira ddala.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ensi etagala ng’omutamiivu,","poem":1},{"text":"eyuugayuuga ng’akasiisira bwe kayuugayuuga mu kibuyaga,","poem":2},{"text":"omusango gwe gumulumiriza nnyo olw’obujeemu bwe,","poem":1},{"text":"era ensi egwa n’etaddamu kuyimuka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ku lunaku olwo Mukama Katonda alibonereza","poem":1},{"text":"ab’amaanyi abali waggulu mu bwengula,","poem":2},{"lineBreak":true},{"text":"ne bakabaka abali wansi ku nsi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Balikuŋŋaanyirizibwa wamu","poem":1},{"text":"ng’abasibe bwe bakuŋŋanyirizibwa mu kkomera,","poem":2},{"text":"era baliweebwa ekibonerezo","poem":1},{"text":"eky’okuggalirwa mu kkomera ennaku ennyingi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Omwezi gulitabulwatabulwa, n’enjuba eriswazibwa;","poem":1},{"text":"Mukama Katonda ow’Eggye alifugira mu kitiibwa","poem":2},{"text":"ku Lusozi Sayuuni ne mu Yerusaalemi,","poem":1},{"text":"ne mu maaso g’abakadde.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}