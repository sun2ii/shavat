{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":[{"text":"Ggwe, Ayi Mukama, gwe Katonda wange;","poem":1},{"text":"ndikugulumiza ne ntendereza erinnya lyo,","poem":2},{"text":"kubanga okoze ebintu eby’ettendo,","poem":1},{"text":"ebintu bye wateekateeka edda,","poem":2},{"lineBreak":true},{"text":"mu bwesigwa bwo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ekibuga okifudde ntuumu ya bisasiro,","poem":1},{"text":"ekibuga ekiriko ekigo okifudde matongo,","poem":2},{"text":"ekibuga omwaddukiranga bannaggwanga tekikyali kibuga,","poem":1},{"text":"tekirizimbibwa nate.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abantu ab’amaanyi kyebaliva bakussaamu ekitiibwa","poem":1},{"text":"n’ebibuga eby’amawanga ag’entiisa birikutya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ddala obadde kiddukiro eri abaavu,","poem":1},{"text":"ekiddukiro eri oyo eyeetaaga,","poem":2},{"text":"ekiddukiro ng’eriyo embuyaga","poem":1},{"text":"n’ekisiikirize awali ebbugumu.","poem":2},{"text":"Omukka gw’ab’entiisa","poem":1},{"text":"guli ng’embuyaga ekuntira ku kisenge","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"era ng’ebbugumu ery’omu ddungu.","poem":2},{"text":"Osirisa oluyoogaano lw’abannaggwanga,","poem":1},{"text":"era ng’ekisiikirize eky’ekire bwe kikendeeza ebbugumu,","poem":2},{"lineBreak":true},{"text":"n’oluyimba lw’abakambwe bwe lusirisibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ku lusozi luno Mukama Katonda ow’Eggye aliteekerateekerako","poem":1},{"text":"abantu bonna ekijjulo eky’emmere ennungi,","poem":2},{"text":"n’embaga eya wayini omuka","poem":1},{"text":"n’ennyama esingayo obulungi, ne wayini asinga obulungi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ku lusozi luno alizikiriza","poem":1},{"text":"ekibikka ekyetoolodde abantu bonna,","poem":2},{"text":"n’eggigi eribikka amawanga gonna,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"era alimalirawo ddala okufa.","poem":2},{"text":"Mukama Katonda alisangula amaziga","poem":1},{"text":"mu maaso gonna,","poem":2},{"text":"era aliggyawo okuswazibwa kw’abantu be","poem":1},{"text":"mu nsi yonna.","poem":2},{"text":"Mukama ayogedde.","poem":1}]},{"type":"verse","number":9,"content":["Mu biro ebyo balyogera nti,",{"text":"“Eky’amazima oyo ye Katonda waffe;","poem":1},{"text":"twamwesiga n’atulokola.","poem":2},{"text":"Ono ye Mukama Katonda twamwesiga;","poem":1},{"text":"tusanyukire mu bulokozi bwe, era tumujagulizeemu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ddala omukono gwa Mukama Katonda guliwummulira ku lusozi luno,","poem":1},{"text":"naye Mowaabu alirinnyirirwa wansi we,","poem":2},{"lineBreak":true},{"text":"ng’essubi bwe lirinnyirirwa okukolamu ebijimusa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Aligolola emikono gye,","poem":1},{"text":"ng’omuwuzi bw’agolola emikono gye ng’awuga.","poem":2},{"text":"Katonda alikkakkanya amalala ge","poem":1},{"text":"newaakubadde ng’emikono gye gikola eby’amagezi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Alimenya bbugwe omuwanvu,","poem":1},{"text":"n’amusuula,","poem":2},{"text":"alimusuula ku ttaka,","poem":1},{"text":"mu nfuufu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}