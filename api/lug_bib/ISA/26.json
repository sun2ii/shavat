{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":26,"content":[{"type":"heading","content":["Oluyimba olw’Okutendereza"]},{"type":"verse","number":1,"content":["Mu biro ebyo oluyimba luno luliyimbibwa mu nsi ya Yuda.",{"text":"Tulina ekibuga eky’amaanyi;","poem":1},{"text":"Katonda assaawo obulokozi","poem":2},{"lineBreak":true},{"text":"okuba bbugwe waakyo n’ekigo kyakyo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ggulawo wankaaki,","poem":1},{"text":"eggwanga ettukuvu liyingire,","poem":2},{"lineBreak":true},{"text":"eggwanga erikuuma okukkiriza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mukama alikuuma mirembe","poem":1},{"text":"oyo amaliridde okumwesiga mu mutima gwe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Weesigenga Mukama ennaku zonna,","poem":1},{"text":"kubanga emirembe giri waggulu mu Mukama, Mukama Katonda oyo atoowaza.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mukama lwe lwazi olutaggwaawo,","poem":1},{"text":"akkakkanya ekibuga eky’amalala,","poem":2},{"text":"akissa wansi ku ttaka,","poem":1},{"text":"n’akisuula mu nfuufu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kirinnyirirwa","poem":1},{"text":"ebigere by’abanyigirizibwa,","poem":2},{"lineBreak":true},{"text":"n’ebisinde by’abaavu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ekkubo ly’abatuukirivu ttereevu;","poem":1},{"text":"Ggwe atuukiridde, olongoosa olugendo lw’omutuukirivu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Weewaawo Mukama Katonda tukulindirira","poem":1},{"text":"nga tutambulira mu mateeka go,","poem":2},{"text":"era erinnya lyo n’okumanyibwa kwo","poem":1},{"text":"kwe kwegomba kw’emitima gyaffe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Omwoyo gwange gukuyaayaanira mu kiro,","poem":1},{"text":"omwoyo gwange gukunoonyeza ddala.","poem":2},{"text":"Bw’osalira ensi omusango,","poem":1},{"text":"abantu b’ensi bayiga obutuukirivu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Omukozi w’ebibi ne bw’akolerwa ebyekisa,","poem":1},{"text":"tayiga butuukirivu.","poem":2},{"text":"Ne bw’abeera mu nsi ey’abatuukiridde,","poem":1},{"text":"yeeyongera kukola bibi, era talaba kitiibwa kya Mukama Katonda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mukama Katonda omukono gwo guyimusibbwa waggulu,","poem":1},{"text":"naye tebagulaba.","poem":2},{"text":"Ka balabe obunyiikivu bwo eri abantu bo baswazibwe,","poem":1},{"text":"omuliro ogwaterekerwa abalabe bo ka gubamalewo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mukama Katonda, otuteekerateekera emirembe,","poem":1},{"text":"n’ebyo byonna bye tukoze, ggw’obitukoledde.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ayi Mukama Katonda waffe, abafuzi abalala batufuze nga wooli naye erinnya lyo lyokka lye tussaamu ekitiibwa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Baafa, tebakyali balamu;","poem":1},{"text":"egyo emyoyo egyagenda tegikyagolokoka.","poem":2},{"text":"Wababonereza n’obazikiriza,","poem":1},{"text":"wabasaanyizaawo ddala bonna, ne watabaawo akyabajjukira.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ogaziyizza eggwanga, Ayi Mukama Katonda","poem":1},{"text":"ogaziyizza eggwanga.","poem":2},{"text":"Weefunidde ekitiibwa,","poem":1},{"text":"era ogaziyizza ensalo zonna ez’ensi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mukama Katonda, bajja gy’oli mu nnaku yaabwe,","poem":1},{"text":"bwe wabakangavvula,","poem":2},{"lineBreak":true},{"text":"tebaasobola na kukusaba mu kaama.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ng’omukyala ow’olubuto anaatera okuzaala,","poem":1},{"text":"bw’alumwa n’akaaba mu bulumi,","poem":2},{"lineBreak":true},{"text":"bwe tutyo bwe twali mu maaso go, Ayi Mukama Katonda.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Twali lubuto, twalumwa,","poem":1},{"text":"naye twazaala mpewo","poem":2},{"text":"Tetwaleeta bulokozi ku nsi,","poem":1},{"text":"tetwazaala bantu ba nsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Naye abafiira mu ggwe balirama,","poem":1},{"text":"emibiri gyabwe girizuukira.","poem":2},{"text":"Mugolokoke,","poem":1},{"text":"muleekaane olw’essanyu.","poem":2},{"text":"Ssuulwe wo ali ng’omusulo ogw’oku makya,","poem":1},{"text":"ensi erizaala abafudde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mugende abantu bange muyingire mu bisenge byammwe","poem":1},{"text":"muggalewo enzigi zammwe.","poem":2},{"text":"Mwekweke okumala akabanga katono,","poem":1},{"text":"okutuusa ekiruyi kye lwe kirimuggwaako.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Weewaawo laba Mukama Katonda ava mu kifo kye gy’abeera","poem":1},{"text":"okubonereza abantu b’ensi olw’ebibi byabwe.","poem":2},{"text":"Ensi erikwekula omusaayi ogwagiyiikako,","poem":1},{"text":"era teriddayo nate kukweka abattibwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}