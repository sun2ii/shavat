{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":27,"content":[{"type":"heading","content":["Okununulibwa kwa Isirayiri"]},{"type":"verse","number":1,"content":["Mu biro ebyo,",{"text":"Mukama Katonda alibonereza n’ekitala kye,","poem":1},{"text":"ekitala kye eky’amaanyi, ekikambwe era ekinene,","poem":2},{"text":"alibonereza Lukwata omusota ogwekulungula,","poem":1},{"text":"Lukwata omusota ogwezinga,","poem":2},{"text":"atte n’ogusota gw’ennyanja.","poem":1}]},{"type":"verse","number":2,"content":["Mu biro ebyo",{"text":"“Yimba oluyimba ku bibala eby’ennimiro ey’emizabbibu ebaze ebibala.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Nze Mukama Katonda, ennimiro nze ngirabirira","poem":2},{"lineBreak":true},{"text":"era nze ngifukirira buli kiseera.","poem":2},{"text":"Ngikuuma emisana n’ekiro","poem":1},{"text":"Waleme kubaawo n’omu agikola akabi.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Siri munyiivu.","poem":2},{"text":"Singa katazamiti n’amaggwa binnumba,","poem":1},{"text":"nandibitabadde mu lutalo?","poem":2},{"lineBreak":true},{"text":"Byonna nandibyokezza omuliro.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Oba si weewaawo ajje gye ndi afune obuddukiro, tutabagane,","poem":1},{"text":"weewaawo tutabagane.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mu biro ebijja Yakobo alisimba emirandira,","poem":1},{"text":"Isirayiri aliroka n’amulisa","poem":2},{"lineBreak":true},{"text":"n’ajjuza ensi yonna ebibala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mukama amukubye omuggo","poem":1},{"text":"ng’akuba abo abaamukuba?","poem":2},{"text":"Attiddwa","poem":1},{"text":"nga be yatta, bwe battibwa?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Olwanagana naye n’omusobola,","poem":1},{"text":"n’omuwaŋŋangusa, omugoba n’okuwuuma okw’amaanyi,","poem":2},{"lineBreak":true},{"text":"ng’embuyaga ey’ebuvanjuba bw’efuuwa ku lunaku lwayo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ekyo kye kiriggyawo omusango gwa Yakobo,","poem":1},{"text":"era ekyo kye kiriba ekibala ekijjuvu ekiriggyawo ekibi kye.","poem":2},{"text":"Bw’aliddira amayinja gonna ag’ekyoto okuba amayinja ag’ennoni","poem":1},{"text":"agayasiddwayasiddwa,","poem":2},{"text":"tewaliba Baasera newaakubadde ebyoto eby’okwoterezaako obubaane","poem":1},{"text":"ebirisigala biyimiridde.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ddala ddala ekibuga ekyaliko enkomera kaakano matongo,","poem":1},{"text":"ekirekeddwa awo ng’eddungu.","poem":2},{"text":"Eyo ennyana gy’eriira era gy’egalamira,","poem":1},{"text":"n’erya amalagala gonna ku matabi gaago.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amatabi gaakyo bwe gakala,","poem":1},{"text":"gamenyebwako, abakazi ne bagakuŋŋaanya ne bagakumisa omuliro.","poem":2},{"text":"Bano bantu abatategeera,","poem":1},{"text":"eyamukola tamusaasira,","poem":2},{"lineBreak":true},{"text":"n’eyamutonda tamukwatirwa kisa.","poem":2}]},{"type":"verse","number":12,"content":["Mu biro ebyo Mukama alikusengejja okuva mu mazzi agakulukuta ag’Omugga Fulaati okutuuka ku mugga gw’e Misiri we guyiwa, era mmwe abaana ba Isirayiri mulikuŋŋaanyizibwa kinnoomu."]},{"type":"verse","number":13,"content":["Era mu biro ebyo ekkondeere eddene lirivuga, n’abo abaali boolekedde okuzikiririra mu nsi y’e Bwasuli, n’abo abaali baawaŋŋangusizibbwa mu Misiri balikomawo ne basinza Mukama ku lusozi olutukuvu e Yerusaalemi."]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}