{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":28,"content":[{"type":"heading","content":["Zikusanze Efulayimu"]},{"type":"verse","number":1,"content":[{"text":"Zikusanze engule ey’amalala g’abatamiivu aba Efulayimu,","poem":1},{"text":"zikusanze ekimuli ekiwotoka","poem":2},{"noteId":19},{"text":"eky’obulungi bw’ekitiibwa kye,","poem":2},{"text":"ekiri ku mutwe gw’ekiwonvu ekigimu,","poem":1},{"text":"Zikusanze ekibuga ky’abo abatamiivu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Laba, Mukama wa maanyi mangi ddala,","poem":1},{"text":"ng’embuyaga ey’omuzira n’embuyaga ezikiriza,","poem":2},{"text":"ng’enkuba ey’amaanyi ereeta amataba,","poem":1},{"text":"bwe ndisuula ekibuga ekyo n’amaanyi mangi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Engule ey’amalala ey’abatamiivu ba Efulayimu","poem":1},{"text":"aligibetenta n’ebigere bye.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ekimuli ekyo ekiwotoka eky’obulungi bw’ekitiibwa kye","poem":1},{"text":"ekiri waggulu w’ekiwonvu ekigimu,","poem":2},{"text":"kiriba ng’ettiini erisooka okwengera nga n’amakungula tegannatuuka,","poem":1},{"text":"era omuntu bw’aliraba alinoga n’alirya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mu biro ebyo Mukama Katonda ow’Eggye","poem":1},{"text":"aliba ngule ya kitiibwa,","poem":2},{"text":"engule ennungi","poem":1},{"text":"ey’abantu be abaasigalawo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Aliba n’omwoyo ogw’okusala ensonga mu bwenkanya","poem":1},{"text":"oyo atuula n’asala emisango,","poem":2},{"text":"Aliba nsibuko ya maanyi","poem":1},{"text":"eri abo abawoza olutabaalo ku wankaaki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ne bano nabo batagala olw’omwenge,","poem":1},{"text":"era bawabye olw’ekitamiiza;","poem":2},{"text":"Bakabona ne bannabbi batagala olw’ekitamiiza,","poem":1},{"text":"era bawabye olw’omwenge;","poem":2},{"text":"bawabye olw’ekitamiiza,","poem":1},{"text":"batagala ne bava mu kwolesebwa,","poem":2},{"lineBreak":true},{"text":"era tebasalawo nsonga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Weewaawo emmeeza zonna ziriko ebisesemye,","poem":1},{"text":"tewakyali kifo kiyonjo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ani gw’agezaako okuyigiriza?","poem":1},{"text":"Ani gw’annyonnyola obubaka bwe?","poem":2},{"text":"Abaana abaakalekayo okuyonka","poem":1},{"text":"oba abo abaakaggibwa ku mabeere?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kubanga kola okole, kola okole","poem":1},{"text":"Ekiragiro ku kiragiro, ekiragiro ku kiragiro,","poem":2},{"lineBreak":true},{"text":"Wano katono na wali katono.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Weewaawo, Katonda alyogera eri abantu abo","poem":1},{"text":"n’emimwa emigenyi mu lulimi olugwira,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"abo be yagamba nti,","poem":1},{"text":"Kino kye kifo eky’okuwummuliramu eri oyo akooye,","poem":2},{"text":"era kye kifo eky’okuwerera","poem":1},{"text":"naye ne bagaana okuwuliriza.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Noolwekyo ekigambo kya Mukama kyekiriva kibeera gye bali","poem":1},{"text":"kola okole, kola okole,","poem":2},{"lineBreak":true},{"text":"ekiragiro ku kiragiro, ekiragiro ku kiragiro,","poem":2},{"lineBreak":true},{"text":"wano katono na wali katono,","poem":2},{"text":"balyoke bagende bagwe kya bugazi,","poem":1},{"text":"era balitegebwa, era ne batuukako ebisago ne bawambibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Noolwekyo muwulire ekigambo kya Mukama Katonda mmwe abantu abanyoomi,","poem":1},{"text":"mmwe abafuga abantu ababeera mu Yerusaalemi ne mubanyooma.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Weewaawo mwewaana nga bwe mugamba nti, “Twakola endagaano n’okufa, era twalagaana n’amagombe. Ekikangabwa eky’amaanyi ne bwe kijja, tekirina kye kiyinza kutukola, kubanga tufudde obulimba ekiddukiro kyaffe, era mu bukuusa mwe twekwese.”","poem":1}]},{"type":"verse","number":16,"content":["Mukama Katonda Ayinzabyonna kyava agamba nti,",{"text":"“Laba, nteeka mu Sayuuni ejjinja,","poem":1},{"text":"ejjinja eryagezesebwa, ery’oku nsonda,","poem":2},{"text":"ery’omuwendo, okuba omusingi;","poem":1},{"text":"oyo alyesiga taliterebuka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndifuula obwenkanya okuba omuguwa ogupima,","poem":1},{"text":"n’obutuukirivu okuba omuguwa ogutereeza,","poem":2},{"text":"era omuzira gulyera ekiddukiro ekyobulimba,","poem":1},{"text":"n’amazzi galyanjaala ku kifo eky’okwekwekamu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"N’endagaano gye walagaana n’okufa erijjulukuka,","poem":1},{"text":"n’endagaano gye walagaana n’amagombe terinywera.","poem":2},{"text":"Ekikangabwa eky’amaanyi bwe kirijja,","poem":1},{"text":"kiribagwira.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Weewaawo buli lwe kinaayitanga,","poem":1},{"text":"kinaabagwiranga","poem":2},{"lineBreak":true},{"text":"buli lukya emisana n’ekiro.”","poem":2},{"lineBreak":true},{"text":"Era okutegeera obubaka buno","poem":1},{"text":"kirireeta ntiisa njereere.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Weewaawo ekitanda kimpi okwegololerako,","poem":1},{"text":"ne bulangiti nnyimpi okwebikka.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Weewaawo Mukama aligolokoka nga bwe yagolokoka ku Lusozi Perazimu,","poem":1},{"text":"era alisunguwala nga bwe yasunguwalira mu Kiwonvu eky’e Gibyoni,","poem":2},{"text":"alyoke akole omulimu gwe, omulimu gwe ogwewuunyisa,","poem":1},{"text":"atuukirize omulimu gwe, omulimu gwe ogwewuunyisa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Noolwekyo mulekeraawo okunyooma, enjegere zammwe zireme kweyongera kubazitoowerera.","poem":1},{"lineBreak":true},{"text":"Nawulira okuva eri Mukama Katonda ow’Eggye","poem":1},{"text":"ng’awa ekiragiro ekizikiriza ensi yonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Muwulirize, era muwulire eddoboozi lyange;","poem":1},{"text":"Musseeyo omwoyo, muwulire kye ŋŋamba.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Omulimi bw’alima nga yeetegekera okusimba, alima lutata?","poem":1},{"text":"Alima bw’ayimirira n’atema amavuunike mu ttaka?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bw’amala okulyanjaala, tasigamu mpinnamuti, n’asaasaanya kumino?","poem":1},{"text":"Tasiga ŋŋaano mu kifo kyayo,","poem":2},{"text":"ne sayiri mu kibanja kyayo,","poem":1},{"text":"n’omukyere mu nnimiro yaagwo?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Katonda we amuwa ebiragiro,","poem":1},{"text":"n’amuyigiriza ekkubo etuufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Empinnamuti teziwuulibwa na luso,","poem":1},{"text":"newaakubadde okunyiga kumino ne nnamuziga w’eggaali.","poem":2},{"text":"Empinnamuti zikubibwa na muggo","poem":1},{"text":"ne kumino n’ekubibwa n’oluga.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Empeke eteekwa okuseebwa okuvaamu omugaati,","poem":1},{"text":"So n’omuntu tagiwuula butamala.","poem":2},{"text":"Newaakubadde ng’agitambulizaako nnamuziga w’eggaali lye eriwuula,","poem":1},{"text":"Embalaasi ze si zeezigisa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Bino byonna nabyo biva eri Mukama Katonda ow’Eggye,","poem":1},{"text":"ow’ekitalo mu kuteesa ebigambo,","poem":2},{"lineBreak":true},{"text":"asinga amagezi.","poem":2}]}],"footnotes":[{"noteId":19,"caller":"+","text":"Ekimuli ekiwotoka, ye Samaliya.","reference":{"chapter":28,"verse":1}}]},"thisChapterLink":"/api/lug_bib/ISA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/27.json","previousChapterAudioLinks":{},"numberOfVerses":29}