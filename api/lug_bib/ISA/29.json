{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":29,"content":[{"type":"heading","content":["Zikusanze Ekibuga kya Dawudi"]},{"type":"verse","number":1,"content":[{"text":"Zikusanze ggwe Alyeri","poem":1},{"noteId":20},{"text":",","poem":1},{"text":"Alyeri ekibuga Dawudi kye yabeeramu,","poem":2},{"text":"yongera omwaka ku mwaka,","poem":1},{"text":"n’entuuko zo ez’embaga zigende mu maaso.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wabula ndizingiza Alyeri,","poem":1},{"text":"alikuba ebiwoobe era alikungubaga,","poem":2},{"lineBreak":true},{"text":"era aliba gye ndi ng’ekyoto kya Alyeri.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndikuba olusiisira okukwetooloola wonna,","poem":1},{"text":"era ndikwetoolooza eminaala,","poem":2},{"lineBreak":true},{"text":"ne nkusaako ebifunvu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Olikkakkanyizibwa era olyogera ng’oli mu ttaka,","poem":1},{"text":"n’ebigambo byo biriwulikika nga biri wansi nnyo ng’oli mu nfuufu.","poem":2},{"text":"Eddoboozi lyo liriba ng’ery’oyo aliko akazimu nga liva mu ttaka,","poem":1},{"text":"n’ebigambo byo biriba bya kyama nga biva mu nfuufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Naye abalabe bo abangi","poem":1},{"text":"baliba ng’enfuufu eweweddwa,","poem":2},{"text":"n’ebibinja by’abakozi b’ebibi abasingayo obubi","poem":1},{"text":"bibe ng’ebisasiro ebifuumuuka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amangwago mu kaseera katono Mukama Katonda ow’Eggye alikukyalira","poem":1},{"text":"mu kubwatuuka ne mu musisi,","poem":2},{"text":"ne mu ddoboozi ery’omwanguka,","poem":1},{"text":"ne mu kibuyaga ne mu nnimi z’omuliro omukambwe oguzikiriza.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Awo ebibinja by’amawanga gonna ebirwana ne Alyeri birimulumba,","poem":1},{"text":"birirumba n’ekigo kye ne bimutaayiza;","poem":2},{"text":"kiriba ng’ekirooto,","poem":1},{"text":"ng’okwolesebwa mu kiro","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ng’omuntu alumwa enjala bw’aloota ng’alya","poem":1},{"text":"naye bw’agolokoka n’asigala ng’akyalumwa enjala;","poem":2},{"text":"oba ng’omuntu alumwa ennyonta bw’aloota ng’anywa","poem":1},{"text":"naye n’agolokoka nga munafu ng’akyalumwa ennyonta.","poem":2},{"text":"Ekyo kye kirituuka ku bibinja by’amawanga gonna","poem":1},{"text":"agalwana n’Olusozi Sayuuni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Muwuniikirire era mwewuunye","poem":1},{"text":"Muzibirire era muzibe amaaso;","poem":2},{"text":"Batamiire, naye si na nvinnyo,","poem":1},{"text":"batagala, naye si lwa mwenge.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mukama akuwadde otulo tungi,","poem":1},{"text":"azibye amaaso gammwe bannabbi,","poem":2},{"lineBreak":true},{"text":"era abisse emitwe gyammwe abalabi.","poem":2}]},{"type":"verse","number":11,"content":["Okwolesebwa kuno kwonna tekulina makulu gy’oli okuggyako okuba ebigambo ebissibwako akabonero mu muzingo. Omuzingo bw’oguwa omuntu, asobola okusoma n’omugamba nti, “Nkwegayiridde kino kisome,” ajja kukuddamu nti, “Sisobola, kuliko akabonero.”"]},{"type":"verse","number":12,"content":["Oba omuzingo bw’oguwa omuntu atasobola kusoma, n’omugamba nti, “Nkwegayiridde kino kisome,” ajja kukuddamu nti, “Simanyi kusoma.”"]},{"type":"verse","number":13,"content":["Mukama agamba nti,",{"text":"“Abantu bano bansemberera n’akamwa kaabwe,","poem":1},{"text":"ne banzisaamu ekitiibwa n’emimwa gyabwe,","poem":2},{"lineBreak":true},{"text":"naye ng’emitima gyabwe gindi wala.","poem":2},{"text":"Okunsinza kwe bansinza,","poem":1},{"text":"biragiro abantu bye baayigiriza.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Noolwekyo, laba ŋŋenda kwewuunyisa abantu bano.","poem":1},{"text":"Amagezi g’abagezi galizikirira,","poem":2},{"text":"n’okutegeera kw’abategeevu","poem":1},{"text":"kuliggwaawo.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Zibasanze abo abakola kyonna kye basobola","poem":1},{"text":"okukweka Mukama enteekateeka zaabwe,","poem":2},{"text":"abo abakola emirimu gyabwe mu kizikiza nga bagamba nti,","poem":1},{"text":"“Ani atulaba? Ani alimanya?”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mufuula ebintu","poem":1},{"text":"ne birabika ng’omubumbi alowoozebwa okwenkanankana n’ebbumba.","poem":2},{"text":"Ekyakolebwa kiyinza okwogera ku eyakikola nti,","poem":1},{"text":"“Teyankola”?","poem":2},{"text":"Ensuwa eyinza okugamba omubumbi nti,","poem":1},{"text":"“Talina ky’amanyi”?","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mu kiseera kitono, Lebanooni tekirifuulibwa nnimiro ngimu,","poem":1},{"text":"n’ennimiro engimu n’erabika ng’ekibira?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mu biro ebyo abaggavu b’amatu baliwulira ebigambo by’omuzingo,","poem":1},{"text":"n’amaaso g’abazibe galizibuka okuva mu kiseera ekizibu ne mu kizikiza.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Abawombeefu balisanyukira mu Mukama nate,","poem":1},{"text":"n’abeetaaga balisanyukira mu Mutukuvu wa Isirayiri.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Weewaawo asinga obubi aliggwaawo,","poem":1},{"text":"n’omunyoomi alibula,","poem":2},{"lineBreak":true},{"text":"n’abo bonna abeesunga okukola obutali butuukirivu,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"abo abakozesa ebigambo okufuula omuntu omusobya,","poem":1},{"text":"abatega eyeerwanako mu mbuga z’amateeka, abawa obujulizi obw’obulimba,","poem":2},{"lineBreak":true},{"text":"ne baleetera abataliiko musango obutawulirwa mu mbuga z’amateeka, balisalibwako.","poem":2}]},{"type":"verse","number":22,"content":["Noolwekyo Mukama eyanunula Ibulayimu bw’ati bw’ayogera eri ennyumba ya Yakobo nti,",{"text":"Yakobo taliddayo kuswazibwa,","poem":1},{"text":"n’obwenyi bwabwe tebulisiiwuuka.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bwe baliraba omulimu gw’emikono gyange mu baana baabwe,","poem":1},{"text":"balikuuma erinnya lyange nga ttukuvu.","poem":2},{"text":"Balikakasa obutuukirivu bw’Omutukuvu wa Yakobo","poem":1},{"text":"era baliyimirira","poem":2},{"lineBreak":true},{"text":"ne beewuunya Katonda wa Isirayiri.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Abo abaabula mu mwoyo balifuna okutegeera,","poem":1},{"text":"n’abo abeemulugunya balikkiriza okuyigirizibwa.","poem":2}]}],"footnotes":[{"noteId":20,"caller":"+","text":"Alyeri lye linnya eryaweebwa Yerusaalemi.","reference":{"chapter":29,"verse":1}}]},"thisChapterLink":"/api/lug_bib/ISA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/28.json","previousChapterAudioLinks":{},"numberOfVerses":24}