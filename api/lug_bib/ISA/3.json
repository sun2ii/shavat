{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":3,"content":[{"type":"heading","content":["Yerusaalemi ne Yuda Bisalirwa Omusango"]},{"type":"verse","number":1,"content":[{"text":"Laba kaakano, Mukama,","poem":1},{"text":"Mukama Katonda ow’Eggye,","poem":2},{"text":"aggya ku Yerusaalemi ne ku Yuda","poem":1},{"text":"ekibeesiguza ne kwe banyweredde,","poem":2},{"text":"ekibeesiguza kyonna k’ebeere mmere, ka gabe mazzi.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Omusajja ow’amaanyi, n’omusajja omulwanyi omuzira,","poem":2},{"text":"omulamuzi, ne nnabbi,","poem":1},{"text":"n’omulaguzi, n’omukadde.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Omuduumizi akulira ekibinja ky’amakumi ataano,","poem":1},{"text":"n’omuwi w’amagezi, omulogo, omufuusa omugezigezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Era ndifuula abalenzi obulenzi okuba abafuzi baabwe,","poem":1},{"text":"n’abaana obwana balibafuga.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Era abantu balijooga bannaabwe,","poem":1},{"text":"buli muntu anyigirize munne, ne muliraanwa anyigirize muliraanwa we.","poem":2},{"text":"Abato baliyisa mu bakulu amaaso","poem":1},{"text":"n’oyo omuntu ataliiko bw’ali ajooge omuntu ow’ekitiibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ekiseera kirituuka","poem":1},{"text":"omusajja agambe muganda we nti,","poem":2},{"text":"“Ggwe alina ku ngoye ba omukulembeze waffe,","poem":1},{"text":"n’ebizibu bino ggwe oba obyetikka!”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Naye ku olwo lwennyini aliddamu nti,","poem":1},{"text":"“Si nze n’aba ow’okubawonya,","poem":2},{"text":"mu nnyumba yange temuli mmere, wadde ebyambalo.","poem":1},{"text":"Temumpa kukulembera bantu!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kubanga Yerusaalemi kizikiridde","poem":1},{"text":"ne Yuda agudde!","poem":2},{"text":"Kubanga ebigambo byabwe byonna n’ebikolwa biwakanya Mukama Katonda,","poem":1},{"text":"bityoboola ekitiibwa kye.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Engeri gye batunulamu eragira ddala nga bwe balina omusango,","poem":1},{"text":"era boolesa ekibi kyabwe nga Sodomu","poem":2},{"noteId":3},{"lineBreak":true},{"text":"awatali kukweka n’akatono.","poem":2},{"text":"Zibasanze!","poem":1},{"text":"Kubanga bo bennyini be beereeteedde okuzikirira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Gamba abatuukirivu nti bo tebaabeeko mutawaana,","poem":1},{"text":"kubanga baakuwoomerwa ebibala by’ebikolwa byabwe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Zisanze abakozi b’ebivve! Banaatuuka mu kuzikirira!","poem":1},{"lineBreak":true},{"text":"Balisasulibwa emikono gyabwe kye gikoze.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Abantu bange banyigirizibwa abaana abato,","poem":1},{"text":"abakazi kaakano be babafuga.","poem":2},{"text":"Woowe! Abantu bange bakyamizibwa abakulembeze baabwe","poem":1},{"text":"era babatabulatabula okubaggya mu kkubo ettuufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mukama Katonda ali mu kifo kye mu mbuga,","poem":1},{"text":"ayimiridde okusalira abantu be omusango.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mukama Katonda asala omusango","poem":1},{"text":"gw’abakadde n’abakulembeze b’abantu be.","poem":2},{"text":"“Mmwe mwayonoona ennimiro yange ey’emizabbibu.","poem":1},{"text":"Ebyanyagibwa ku baavu biri mu nnyumba zammwe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lwaki mulinnyirira abantu bange,","poem":1},{"text":"lwaki mutulugunya abaavu?” bw’ayogera Mukama Katonda Ayinzabyonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mukama Katonda agamba nti,","poem":1},{"text":"“Abakazi b’omu Sayuuni","poem":2},{"noteId":4},{"text":"beemanyi,","poem":2},{"text":"era batambula balalambazza ensingo","poem":1},{"text":"nga batunuza bukaba.","poem":2},{"text":"Batambula basiira","poem":1},{"text":"nga bavuza obukomo bw’oku magulu gaabwe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mukama kyaliva aleeta amabwa ku mitwe gy’abakazi ba Sayuuni,","poem":1},{"text":"ne gifuuka gya biwalaata.”","poem":2}]},{"type":"verse","number":18,"content":["Olunaku lujja Mukama lwaliggya ku bakazi b’omu Yerusaalemi ebintu byonna ebibaleetera amalala, ebikomo by’oku magulu, ebitambaala ebibikka ku mitwe, n’obukuufiira,"]},{"type":"verse","number":19,"content":["ebyokumatu, ebyambalwa mu bulago, n’obutimba bw’omu maaso,"]},{"type":"verse","number":20,"content":["ebyokumitwe, ebyokumikono, ebyomukiwato,"]},{"type":"verse","number":21,"content":["empeta ez’oku ngalo n’ez’omu nnyindo,"]},{"type":"verse","number":22,"content":["engoye ennungi, n’eminagiro, n’amaganduula, n’obusawo,"]},{"type":"verse","number":23,"content":["n’endabirwamu, n’engoye ez’obutimba, n’eza linena, n’ebitambaala eby’oku mitwe ebinaanikiddwa n’amayinja ag’omuwendo, n’engoye ezibabikka."]},{"type":"verse","number":24,"content":[{"text":"Mu kifo ky’akaloosa walibaawo kuwunya kivundu,","poem":1},{"text":"awandibadde enkoba ennungi wabeewo biguwa,","poem":2},{"text":"n’awaali enviiri ennongoose obulungi wabeewo kiwalaata,","poem":1},{"text":"mu kifo ky’engoye babeere mu nziina,","poem":2},{"lineBreak":true},{"text":"n’awaali obulungi waddewo obulambe.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Abasajja bo balittibwa kitala,","poem":1},{"text":"abalwanyi bo abazira bagwire mu lutalo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"N’enzigi za Sayuuni zirikaaba ne zikungubaga","poem":1},{"text":"era ekibuga kyennyini kiriba ng’omukazi alekeddwa obwereere ng’atudde mu ttaka.","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Sodomu ky’ekibuga ekiriraanye ekifo Lutti gye yassa eweema ye, bwe yali ayawukanye ne Ibulaamu, oluvannyuma eyayitibwa Ibulayimu. Mukama yasaanyaawo Sodomu ne Gomora n’omuliro ogwa salufa ogwava mu ggulu kubanga abatuuze baayo baayonoona nnyo eri Mukama (Lub 13:12)","reference":{"chapter":3,"verse":9}},{"noteId":4,"caller":"+","text":"Sayuuni lusozi olusangibwa mu Yerusaalemi","reference":{"chapter":3,"verse":16}}]},"thisChapterLink":"/api/lug_bib/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}