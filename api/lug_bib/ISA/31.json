{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":31,"content":[{"type":"heading","content":["Zibasanze abo Abeesiga Misiri"]},{"type":"verse","number":1,"content":[{"text":"Zibasanze abo abaserengeta e Misiri okuyambibwa,","poem":1},{"text":"abeesiga embalaasi,","poem":2},{"text":"abeesiga amagaali gaabwe amangi,","poem":1},{"text":"abeesiga amaanyi amangi ag’abeebagala embalaasi","poem":2},{"text":"ne batatunuulira Omutukuvu wa Isirayiri","poem":1},{"text":"wadde okunoonya obuyambi bwa Mukama.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kyokka Mukama mugezi era asobola okuleeta akabi;","poem":1},{"text":"tajjulula bigambo bye.","poem":2},{"text":"Aligolokokera ku nnyumba y’abatali batuukirivu,","poem":1},{"text":"ne ku abo abayamba abakozi b’ebibi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Naye Abamisiri bantu buntu si Katonda","poem":1},{"text":"n’embalaasi zaabwe mibiri bubiri.","poem":2},{"text":"Katonda bw’agolola omukono gwe","poem":1},{"text":"oyo ayamba, alyesittala,","poem":2},{"lineBreak":true},{"text":"n’oyo ayambibwa aligwa","poem":2},{"lineBreak":true},{"text":"era bombi balizikiririra wamu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ddala ddala bw’ati bw’ayogera Mukama gye ndi nti,","poem":1},{"lineBreak":true},{"text":"“Ng’empologoma bwe wuluguma,","poem":1},{"text":"empologoma ey’amaanyi bwe wulugumira ku muyiggo gwayo","poem":2},{"text":"era newaakubadde ng’ekibinja ky’abasumba","poem":1},{"text":"kiyitibwa awamu okugirumba,","poem":2},{"text":"tetiisibwatiisibwa kuwowogana kwabwe,","poem":1},{"text":"newaakubadde oluyoogaano lwabwe.","poem":2},{"text":"Bw’atyo ne Mukama Katonda ow’Eggye bw’aliserengeta,","poem":1},{"text":"okulwanira ku lusozi Sayuuni ne ku busozi bwa lwo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ng’ebinyonyi bwe bibuukira waggulu,","poem":1},{"text":"bw’atyo Mukama Katonda ow’Eggye bw’alisaanikira Yerusaalemi;","poem":2},{"text":"alikikuuma, n’akiwonya,","poem":1},{"text":"alikiyitamu n’akirokola.”","poem":2}]},{"type":"verse","number":6,"content":["Mudde eri oyo gwe mwajeemera ennyo, mmwe abaana ba Isirayiri."]},{"type":"verse","number":7,"content":["Mu biro ebyo buli omu ku mmwe alisuulira ddala wala ebitali Katonda ebya ffeeza ne zaabu, emikono gyo egitali mituukirivu gye byakola."]},{"type":"verse","number":8,"content":[{"text":"“Bwasuli kirigwa n’ekitala ekitali kya muntu;","poem":1},{"text":"ekitala ekitali ky’abo abafa kirimusaanyaawo.","poem":2},{"text":"Alidduka ekitala,","poem":1},{"text":"n’abavubuka be balikozesebwa emirimu egy’amaanyi n’obuwaze.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ekigo kyabwe kirigwa olw’okutya,","poem":1},{"text":"n’abaduumizi baabwe balitekemuka omutima olw’okulaba ebbendera ey’olutalo,”","poem":2},{"text":"bw’ayogera Mukama","poem":1},{"text":"nannyini muliro oguli mu Sayuuni,","poem":2},{"lineBreak":true},{"text":"era nannyini kikoomi ekiri mu Yerusaalemi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/30.json","previousChapterAudioLinks":{},"numberOfVerses":9}