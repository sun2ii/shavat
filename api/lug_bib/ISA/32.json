{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":32,"content":[{"type":"heading","content":["Obwakabaka obw’Obutuukirivu"]},{"type":"verse","number":1,"content":[{"text":"Laba, Kabaka alifuga mu butuukirivu,","poem":1},{"text":"n’abafuzi balifuga mu bwenkanya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Buli muntu aliba ng’ekifo eky’okwekwekamu empewo,","poem":1},{"text":"ng’ekiddukiro okuva eri kibuyaga,","poem":2},{"text":"ng’emigga gy’amazzi mu ddungu,","poem":1},{"text":"ng’ekisiikirize eky’olwazi olunene mu nsi ey’ennyonta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Olwo amaaso gaabo abalaba tegaliziba,","poem":1},{"text":"n’amatu g’abo abawulira galiwuliriza.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Omutima gw’abatali bagumiikiriza gulimanya era gulitegeera,","poem":1},{"text":"n’olulimi olw’abanaanaagira lulitereera ne boogera bulungi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Omusirusiru taliddayo kuyitibwa wa kitiibwa,","poem":1},{"text":"newaakubadde omuntu omwonoonyi okuteekebwamu ekitiibwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Omusirusiru ayogera bya busirusiru,","poem":1},{"text":"n’omutima gwe gwemalira ku kukola ebitali bya butuukirivu.","poem":2},{"text":"Akola eby’obutatya Katonda,","poem":1},{"text":"era ayogera bya bulimba ku Mukama,","poem":2},{"text":"n’abayala abaleka tebalina kintu,","poem":1},{"text":"n’abalumwa ennyonta abamma amazzi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Empisa z’omwonoonyi si za butuukirivu. Akola entegeka ezitali za butuukirivu, alyoke azikirize abaavu n’ebigambo eby’obulimba, ensonga y’abali mu kwetaaga ne bw’eba nga ntuufu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Naye omuntu ow’ekitiibwa akola entegeka za kitiibwa,","poem":1},{"text":"era ku bikolwa bye eby’ekitiibwa kw’anywerera.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mmwe abakazi abateefiirayo,","poem":1},{"text":"mugolokoke muwulirize eddoboozi lyange;","poem":2},{"text":"mmwe abawala abawulira nga muli wanywevu,","poem":1},{"text":"muwulire bye ŋŋamba.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mu mwaka gumu oba n’okusingawo,","poem":1},{"text":"mmwe abawulira nga muli wanywevu, mulitya,","poem":2},{"text":"amakungula g’emizabbibu galifa,","poem":1},{"text":"n’amakungula g’ebibala tegalijja.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mutye mmwe abakazi abateefiirayo,","poem":1},{"text":"mukankane mmwe abawala abawulira nga muli wanywevu.","poem":2},{"text":"Muggyeko engoye zammwe,","poem":1},{"text":"mwesibe ebibukutu mu biwato byammwe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Munakuwalire ennimiro ezaali zisanyusa,","poem":1},{"text":"olw’emizabbibu egyabalanga,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"n’olw’ensi ey’abantu bange,","poem":1},{"text":"ensi eyamerangamu amaggwa ne katazamiti.","poem":2},{"text":"Weewaawo mukaabire ennyumba zonna ezaali ez’amasanyu,","poem":1},{"text":"na kino ekibuga ekyali eky’amasanyu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Weewaawo ekigo kirirekebwawo,","poem":1},{"text":"ekibuga ekirimu oluyoogaano kirifuuka kifulukwa.","poem":2},{"text":"Ebigo n’eminaala birifuuka ebitagasa ennaku zonna,","poem":1},{"text":"ekifo ekisanyusa endogoyi, eddundiro ly’ebisibo,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"okutuusa Omwoyo lw’alitufukibwako okuva waggulu,","poem":1},{"text":"n’eddungu ne lifuuka ennimiro engimu,","poem":2},{"lineBreak":true},{"text":"n’ennimiro engimu n’erabika ng’ekibira.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Obwenkanya bulituula mu ddungu,","poem":1},{"text":"n’obutuukirivu bulibeera mu nnimiro engimu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ekibala ky’obutuukirivu kiriba mirembe,","poem":1},{"text":"n’ekiriva mu butuukirivu kiriba kusiriikirira na bwesige emirembe gyonna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Abantu bange balibeera mu bifo eby’emirembe,","poem":1},{"text":"mu maka amateefu","poem":2},{"lineBreak":true},{"text":"mu bifo eby’okuwummuliramu ebitatawaanyizibwa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Omuzira ne bwe guligwa ne gukuba ekibira okukimalawo,","poem":1},{"text":"n’ekibuga ne kiggirwawo ddala,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ggwe oliraba omukisa,","poem":1},{"text":"ng’osiga ensigo y’oku migga gyonna,","poem":2},{"lineBreak":true},{"text":"n’ente zo n’endogoyi zo ne zirya nga zeeyagala.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}