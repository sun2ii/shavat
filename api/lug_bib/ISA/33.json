{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"Zikusanze ggwe omuzikiriza","poem":1},{"text":"ggwe atazikirizibwanga.","poem":2},{"text":"Zikusanze ggwe alya olukwe mu balala,","poem":1},{"text":"ggwe, gwe batalyangamu lukwe,","poem":2},{"text":"bw’olirekaraawo okuzikiriza,","poem":1},{"text":"olizikirizibwa.","poem":2},{"text":"Bw’olirekeraawo okulya mu balala olukwe,","poem":1},{"text":"balikulyamu olukwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ayi Mukama tusaasire,","poem":1},{"text":"tukuyaayaanira.","poem":2},{"text":"Obeere amaanyi gaffe buli makya,","poem":1},{"text":"obulokozi bwaffe mu biro eby’okulabiramu ennaku.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Olw’eddoboozi ery’okubwatuka, abantu balidduka,","poem":1},{"text":"bw’ogolokoka, amawanga gasaasaana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Omunyago gwo, gukungulwa enzige ento,","poem":1},{"text":"era abantu bagugwako ng’ekibinja ky’enzige.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mukama agulumizibwe, kubanga atuula waggulu,","poem":1},{"text":"alijjuza Sayuuni n’obwenkanya n’obutuukirivu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Y’aliba omusingi omugumu mu biro byo,","poem":1},{"text":"nga lye tterekero eggagga ery’obulokozi, n’amagezi n’okumanya.","poem":2},{"lineBreak":true},{"text":"Okutya Mukama kye kisumuluzo kye tterekero ly’obugagga obwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Laba abasajja abazira ab’amaanyi bakaabira mu nguudo mu ddoboozi ery’omwanguka,","poem":1},{"text":"n’ababaka ab’emirembe bakaaba nnyo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enguudo ennene tezitambulirwako,","poem":1},{"text":"tewali azitambulirako.","poem":2},{"text":"Endagaano yamenyebwa,","poem":1},{"text":"n’abajulizi baayo banyoomebwa,","poem":2},{"lineBreak":true},{"text":"tewali assibwamu kitiibwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ensi ekungubaga era eyongobera,","poem":1},{"text":"Lebanooni aswadde era awotose;","poem":2},{"text":"Saloni ali ng’eddungu,","poem":1},{"text":"ng’asuula Basani ne Kalumeeri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mukama agamba nti, “Kaakano nnaagolokoka,","poem":1},{"text":"kaakano nnaagulumizibwa,","poem":2},{"lineBreak":true},{"text":"kaakano nnaayimusibwa waggulu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ofuna olubuto olw’ebisusunku,","poem":1},{"text":"ozaala ssubi,","poem":2},{"lineBreak":true},{"text":"omukka gwo, muliro ogukusaanyaawo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abantu balyokebwa nga layimu bw’ayokebwa,","poem":1},{"text":"balyokebwa omuliro ng’ebisaka by’amaggwa amasale.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mmwe abali ewala, mutegeere kye nkoze.","poem":1},{"text":"Mmwe abali okumpi, mukkirize amaanyi gange.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abakozi b’ebibi ab’omu Sayuuni batidde,","poem":1},{"text":"okutya kujjidde abatalina Katonda.","poem":2},{"text":"“Ani ku ffe ayinza okubeera awamu n’omuliro ogusaanyaawo?","poem":1},{"text":"Ani ku ffe ayinza okubeera awamu n’omuliro ogutaliggwaawo?”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Atambulira mu butuukirivu,","poem":1},{"text":"n’ayogera ebituufu,","poem":2},{"text":"oyo atatwala magoba agava mu bubbi,","poem":1},{"text":"n’akuuma emikono gye obutakkiriza nguzi,","poem":2},{"text":"aziba amatu ge n’atawulira ntegeka za kutta,","poem":1},{"text":"n’aziba amaaso ge obutalaba nteekateeka ezitali za butuukirivu,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ye muntu alituula waggulu mu bifo ebya waggulu,","poem":1},{"text":"n’obuddukiro bwe buliba ebigo eby’omu nsozi.","poem":2},{"text":"Aliweebwa emmere,","poem":1},{"text":"n’amazzi tegalimuggwaako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Amaaso go galiraba kabaka mu bulungi bwe,","poem":1},{"text":"ne galaba ensi eyeewala.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Omutima gwo gulifumiitiriza ku ntiisa ng’ogamba nti,","poem":1},{"text":"“Omukungu omukulu ali ludda wa?","poem":2},{"lineBreak":true},{"text":"Ali ludda wa eyasoloozanga omusolo?","poem":2},{"lineBreak":true},{"text":"Omukungu avunaanyizibwa eminaala ali ludda wa?”","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Toliddayo kulaba bantu abo ab’amalala,","poem":1},{"text":"abantu ab’olulimi olutamanyiddwa,","poem":2},{"lineBreak":true},{"text":"olulimi olutategeerekeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tunuulira Sayuuni ekibuga eky’embaga zaffe,","poem":1},{"text":"amaaso go galiraba Yerusaalemi,","poem":2},{"lineBreak":true},{"text":"ekifo eky’emirembe, eweema etalisimbulwa","poem":2},{"text":"enkondo zaayo tezirisimbulwa,","poem":1},{"text":"newaakubadde emiguwa gyayo okukutulwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Weewaawo Mukama aliba Amaanyi gaffe","poem":1},{"text":"era aliba ekifo eky’emigga emigazi n’ensulo engazi.","poem":2},{"text":"Temuliyitamu lyato","poem":1},{"text":"newaakubadde ekyombo ekinene tekiriseeyeeyeramu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kubanga Mukama ye mulamuzi waffe,","poem":1},{"text":"Mukama y’atuwa amateeka,","poem":2},{"text":"Mukama ye Kabaka waffe,","poem":1},{"text":"y’alitulokola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Emiguwa gyo gisumulukuse","poem":1},{"text":"n’omulongooti si munywevu,","poem":2},{"lineBreak":true},{"text":"n’ettanga si lyanjuluze.","poem":2},{"text":"Awo omugabo omungi guligabanyizibwamu,","poem":1},{"text":"n’abalala balitwala eby’omunyago.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Tewali abeera mu Sayuuni alyogera nti, “Ndi mulwadde,”","poem":1},{"text":"n’abo ababeeramu balisonyiyibwa ekibi kyabwe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}