{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":34,"content":[{"type":"heading","content":["Amawanga Gasalirwa Omusango"]},{"type":"verse","number":1,"content":[{"text":"Musembere mmwe amawanga muwulirize.","poem":1},{"text":"Musseeyo omwoyo mmwe abantu.","poem":2},{"text":"Ensi ewulirize, ne byonna ebigirimu,","poem":1},{"text":"ensi ne byonna ebigivaamu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mukama anyiigidde amawanga gonna,","poem":1},{"text":"ekiruyi kye kiri ku magye gaabwe gonna.","poem":2},{"text":"Alibazikiririza ddala,","poem":1},{"text":"alibawaayo okuttibwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abantu baabwe abattibwa balisuulibwa ebweru,","poem":1},{"text":"n’emirambo gyabwe giriwunya,","poem":2},{"lineBreak":true},{"text":"n’ensozi zirinnyikira omusaayi gwabwe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Emmunyeenye zonna ez’omu ggulu zirisaanuuka,","poem":1},{"text":"n’eggulu liryezingako ng’omuzingo;","poem":2},{"text":"n’eggye ery’omu ggulu lirigwa,","poem":1},{"text":"ng’ebikoola ebiwotose ebiva ku muzabbibu,","poem":2},{"lineBreak":true},{"text":"ng’ebirimba ebyayongobera ebiva ku mutiini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Weewaawo ekitala kyange kinywedde ne kijjuzibwa mu ggulu,","poem":1},{"text":"era laba, kikkira ku Edomu okusala omusango,","poem":2},{"lineBreak":true},{"text":"abantu be mmaliddewo ddala.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ekitala kya Mukama kisaabye omusaayi,","poem":1},{"text":"kiriko amasavu,","poem":2},{"text":"omusaayi gw’abaana b’endiga n’embuzi,","poem":1},{"text":"amasavu agava mu nsingo za sseddume.","poem":2},{"text":"Mukama alina ekiweebwayo mu Bozula,","poem":1},{"text":"era waliyo n’okuttibwa okw’amaanyi mu Edomu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Embogo zirifiira wamu nazo,","poem":1},{"text":"n’obute obulume, ne ziseddume zirifiira wamu nazo.","poem":2},{"text":"Ensi yaabwe erijjula omusaayi,","poem":1},{"text":"n’enfuufu erinnyikira amasavu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mukama alina olunaku olw’okuwalanirako eggwanga,","poem":1},{"text":"omwaka ogw’okwesasuza, olw’ensonga eya Sayuuni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Emigga gya Edomu girikalira ne gifuuka bulimbo,","poem":1},{"noteId":23},{"text":"n’enfuufu ye erifuuka ng’obuwunga bwa salufa ayokya.","poem":2},{"lineBreak":true},{"text":"Ensi ye erifuuka ng’obulimbo","poem":2},{"noteId":24},{"text":"obuggya omuliro.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Talizikizibwa emisana n’ekiro,","poem":1},{"text":"n’omukka gwe gulinyooka ennaku zonna.","poem":2},{"text":"Edomu alisigala kifulukwa emirembe n’emirembe,","poem":1},{"text":"era tewaliba n’omu ayita mu nsi eyo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ekiwuugulu eky’omu ddungu n’ekiwuugulu ekireekaana, birikibeeramu.","poem":1},{"text":"Ekiwuugulu ekinene ne namuŋŋoona birizimbamu ebisu byabyo.","poem":2},{"text":"Katonda aligololera ekipimo eky’okwewunika,","poem":1},{"text":"n’ekipimo ekinaaleka Edomu nga njereere.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abakungu be tebalibaako kye bayita bwakabaka,","poem":1},{"text":"n’abalangira be bonna baliggwaawo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Amaggwa galimera ku minaala egy’ekibuga kye,","poem":1},{"text":"n’emyennyango n’amatovu ne bimera mu bigo bye ebyanywezebwa.","poem":2},{"text":"Aliyiggibwa ebibe,","poem":1},{"text":"era ebiwuugulu birimufuula ekifo eky’okuwummulirangamu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ensolo ez’omu ddungu gye zirisisinkana empisi,","poem":1},{"text":"n’embuzi enkambwe ez’omu nsiko gye ziriramusiganyiza.","poem":2},{"text":"Era eyo ebisolo ebitambula ekiro nabyo biriwummula","poem":1},{"text":"nga byefunidde ekifo eky’okuwummulirangamu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ekiwuugulu kiribiikira eyo amagi,","poem":1},{"text":"ne kigaalula,","poem":2},{"text":"ne kirabirira abaana baakyo wansi w’ekisiikirize kyakyo.","poem":1},{"text":"Era eyo ne kamunye gy’alikuŋŋaanira, empanga n’enseera.","poem":2}]},{"type":"verse","number":16,"content":["Tunula mu muzingo gwa Mukama osome.",{"text":"Tewali na kimu ku ebyo ekiribulayo,","poem":1},{"text":"era ekirume kiriba n’ekikazi, n’ekikazi ne kiba n’ekirume.","poem":2},{"text":"Akamwa ka Mukama ke kalagidde,","poem":1},{"text":"era Omwoyo we yalibikuŋŋaanya.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Agabira buli kimu omugabo gwakyo,","poem":1},{"text":"era omukono gwe gubigabanyiza mu kigera.","poem":2},{"text":"Birikibeeramu ennaku zonna,","poem":1},{"text":"bibeere omwo emirembe n’emirembe.","poem":2}]}],"footnotes":[{"noteId":23,"caller":"+","text":"bulimbo kifaanana ng’ennoni","reference":{"chapter":34,"verse":9}},{"noteId":24,"caller":"+","text":"bulimbo kifaanana ng’ennoni","reference":{"chapter":34,"verse":9}}]},"thisChapterLink":"/api/lug_bib/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}