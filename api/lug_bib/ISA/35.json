temutya:","poem":2},{"text":"laba Katonda wammwe alijja;","poem":1},{"text":"alibalwanirira,","poem":2},{"text":"alage abalabe bammwe obusungu obw’Obwakatonda,","poem":1},{"text":"era alibalokola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Olwo amaaso g’abazibe galiraba,","poem":1},{"text":"era n’amatu ga bakiggala galigguka;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"omulema alibuuka ng’ennangaazi,","poem":1},{"text":"n’olulimi lw’abatayogera luliyimba n’essanyu.","poem":2},{"text":"Amazzi galifubutuka","poem":1},{"text":"ne gakulukutira mu lukoola n’emigga mu ddungu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"N’omusenyu ogwokya gulifuuka ekidiba,","poem":1},{"text":"n’ensi eyakala edda n’etiiriika ensulo ez’amazzi.","poem":2},{"text":"Ebibe we byagalamiranga walimera omuddo,","poem":1},{"text":"n’essaalu, n’ebitoogo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Era eribaayo oluguudo olunene, n’ekkubo,","poem":1},{"text":"eririyitibwa Ekkubo Ettukuvu.","poem":2},{"text":"Abatali balongoofu tebaliriyitamu,","poem":1},{"text":"liriba ly’abali abalongoofu,","poem":2},{"lineBreak":true},{"text":"kubanga abasirusiru abatali balongoofu tebaliriyitamu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Teribaayo mpologoma,","poem":1},{"text":"so teririnnyayo nsolo yonna nkambwe;","poem":2},{"lineBreak":true},{"text":"tezirirabikayo,","poem":2},{"text":"naye abanunule balitambulira eyo.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"N’abantu ba Mukama abaanunulibwa balikomawo, ne bajja mu Sayuuni nga bayimba,","poem":2},{"lineBreak":true},{"text":"n’essanyu eritaggwaawo nga libajjudde.","poem":2},{"text":"Balifuna essanyu lingi nnyo n’okujaguza,","poem":1},{"text":"okunakuwala n’okusinda nga biggweereddewo ddala.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}