{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":40,"content":[{"type":"heading","content":["Ebigambo eby’Essuubi"]},{"type":"verse","number":1,"content":[{"text":"Mugumye, mugumye abantu bange,","poem":1},{"text":"bw’ayogera Katonda wammwe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Muzzeemu Yerusaalemi amaanyi mumubuulire nti,","poem":1},{"text":"entalo ze ziweddewo,","poem":2},{"text":"n’obutali butuukirivu bwe","poem":1},{"text":"busasuliddwa.","poem":2},{"text":"Era Mukama amusasudde emirundi ebiri","poem":1},{"text":"olw’ebibi bye byonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Eddoboozi ly’oyo ayogera","poem":1},{"text":"liwulikika ng’agamba nti,","poem":2},{"text":"“Muteeketeeke ekkubo lya Mukama mu ddungu,","poem":1},{"text":"mutereeze oluguudo lwe mu ddungu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Buli kiwonvu kirigulumizibwa,","poem":1},{"text":"na buli lusozi n’akasozi ne bikkakkanyizibwa.","poem":2},{"text":"N’obukyamu buligololwa,","poem":1},{"text":"ebifo ebitali bisende ne bitereezebwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ekitiibwa kya Mukama kiribikkulwa,","poem":1},{"text":"ne bonna abalina omubiri balikirabira wamu,","poem":2},{"text":"kubanga akamwa ka Mukama ke kakyogedde.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ne mpulira eddoboozi nga ligamba nti,","poem":1},{"text":"“Yogera mu ddoboozi ery’omwanguka.”","poem":2},{"lineBreak":true},{"text":"Ne ŋŋamba nti, “Nnaayogera ki?” Ne linziramu nti, gamba nti,","poem":1},{"text":"“Abantu bonna bali nga muddo, n’obulungi bwabwe bumala ennaku ntono ng’ebimuli eby’omu nnimiro.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Omuddo guwotoka, ekimuli kiyongobera,","poem":1},{"text":"omukka gwa Mukama bwe gugufuuwako.","poem":2},{"lineBreak":true},{"text":"Mazima abantu muddo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Omuddo guwotoka, ekimuli kiyongobera,","poem":1},{"text":"naye ekigambo kya Katonda waffe kibeerera emirembe gyonna.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ggwe abuulira Sayuuni ebigambo ebirungi,","poem":1},{"text":"werinnyire ku lusozi oluwanvu;","poem":2},{"text":"ggwe abuulira Yerusaalemi ebigambo ebirungi,","poem":1},{"text":"yimusa eddoboozi lyo n’amaanyi, liyimuse oyogere, totya.","poem":2},{"lineBreak":true},{"text":"Gamba ebibuga bya Yuda nti, “Laba Katonda wammwe ajja!”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Laba, Mukama Katonda ajja n’amaanyi mangi","poem":1},{"text":"era afuga n’omukono gwe ogw’amaanyi ag’ekitalo.","poem":2},{"text":"Laba empeera ye eri mu mukono gwe,","poem":1},{"text":"buli muntu afune nga bw’akoze.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Aliisa ekisibo kye ng’omusumba,","poem":1},{"text":"akuŋŋaanya abaana b’endiga mu mukono gwe","poem":2},{"text":"n’abasitula mu kifuba kye,","poem":1},{"text":"n’akulembera mpola mpola ezibayonsa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ani eyali ageze amazzi g’ennyanja mu kibatu kye,","poem":1},{"text":"n’apima eggulu n’oluta,","poem":2},{"text":"n’apima enfuufu y’oku nsi mu kibbo,","poem":1},{"text":"oba n’apima ensozi ku minzaani,","poem":2},{"lineBreak":true},{"text":"n’obusozi ku kipima?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani eyali aluŋŋamizza Omwoyo wa Mukama?","poem":1},{"text":"Ani ayinza okumuyigiriza n’amuwa amagezi?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ani gwe yali yeebuuzizzako amuwe ku magezi,","poem":1},{"text":"era ani eyali amuyigirizza ekkubo ettuufu?","poem":2},{"text":"Ani eyali amusomesezza eby’amagezi n’amulaga okuyiga,","poem":1},{"text":"n’okumanya n’okutegeera?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Laba amawanga gali ng’ettondo eriri mu nsuwa,","poem":1},{"text":"era ng’enfuufu ekutte ku minzaani,","poem":2},{"lineBreak":true},{"text":"apima ebizinga ng’apima olufuufu ku minzaani.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"N’ensolo zonna ez’omu kibira kya Lebanooni tezimala kubeera kiweebwayo eri Katonda waffe,","poem":1},{"text":"n’emiti gyamu gyonna mitono nnyo tegisobola kuvaamu nku zimala.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Amawanga gonna ag’omu nsi","poem":1},{"text":"gabalibwa mu maaso ge,","poem":2},{"lineBreak":true},{"text":"gy’ali gabalibwa nga si kintu n’akamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kale ani gwe mulifaananya Katonda?","poem":1},{"text":"Oba kifaananyi ki kye mulimugeraageranyizaako?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ekifaananyi ekyole omukozi akifumba,","poem":1},{"text":"n’omuweesi wa zaabu n’akibikkako zaabu,","poem":2},{"lineBreak":true},{"text":"n’akibikkako n’emikuufu egya ffeeza.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Oyo omwavu atasobola kufuna ffeeza","poem":1},{"text":"oba zaabu afuna omuti omugumu ogutavunda","poem":2},{"text":"ne yenoonyeza omukozi omugezigezi","poem":1},{"text":"okusimba n’okunyweza ekifaananyi ekyole.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Temunnamanya,","poem":1},{"text":"temunnawulira,","poem":2},{"text":"temubuulirwanga","poem":1},{"text":"okuva ku kutondebwa kw’ensi?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Katonda atuula ku nsi enneekulungirivu,","poem":1},{"text":"era gy’ali abantu bali ng’amayanzi.","poem":2},{"text":"Atimba eggulu ng’olutimbe","poem":1},{"text":"era alibamba ng’eweema ey’okubeeramu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Afuula abafuzi obutaba kintu,","poem":1},{"text":"afuula n’abalamuzi mu nsi okuba ekitaliimu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bali ng’ebisimbe ebyakamera biba bya kasimbibwa,","poem":1},{"text":"biba byakasigibwa,","poem":2},{"lineBreak":true},{"text":"biba byakaleeta emirandira,","poem":2},{"text":"nga abifuuwa nga biwotoka,","poem":1},{"text":"ng’embuyaga ebitwalira ddala ng’ebisasiro.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"“Kale mulinfaananya ani,","poem":1},{"text":"ani gwe mulinnenkanya?” bw’ayogera Omutukuvu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Muyimuse amaaso gammwe mulabe ebiri ku ggulu.","poem":1},{"text":"Ani eyatonda ebyo byonna?","poem":2},{"text":"Oyo afulumya ebyaka eby’omu bbanga afulumya kina kimu,","poem":1},{"text":"byonna nga bwe biri, n’abiyita amannya gaabyo.","poem":2},{"text":"Olw’obukulu bw’obuyinza bwe era kubanga wa maanyi ga nsusso,","poem":1},{"text":"tewali na kimu kibulako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Lwaki ogamba ggwe Yakobo era ne wemulugunya ggwe Isirayiri nti,","poem":1},{"text":"“Mukama tamanyi mitawaana gye mpitamu,","poem":2},{"text":"era tafaayo nga tuggyibwako","poem":1},{"text":"eddembe lyaffe ery’obwebange”?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Tonnamanya?","poem":1},{"text":"Tonnawulira?","poem":2},{"text":"Mukama, ye Katonda ataliggwaawo.","poem":1},{"text":"Omutonzi w’enkomerero y’ensi.","poem":2},{"text":"Tazirika so takoowa","poem":1},{"text":"era n’amagezi ge tewali n’omu ayinza kugapima.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Awa amaanyi abazirika,","poem":1},{"text":"n’oyo atalina buyinza amwongerako amaanyi.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Abavubuka bazirika, bakoowa,","poem":1},{"text":"n’abalenzi bagwira ddala.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Naye abo abalindirira Mukama","poem":1},{"text":"baliddamu buggya amaanyi gaabwe,","poem":2},{"text":"balitumbiira n’ebiwaawaatiro ng’empungu;","poem":1},{"text":"balidduka mbiro ne batakoowa,","poem":2},{"lineBreak":true},{"text":"balitambula naye ne batazirika.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}