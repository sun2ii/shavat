{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":41,"content":[{"type":"heading","content":["Katonda Agumya Isirayiri"]},{"type":"verse","number":1,"content":[{"text":"“Musirike mumpulirize mmwe ebizinga,","poem":1},{"text":"amawanga gaddemu amaanyi.","poem":2},{"text":"Mwetegeke okuleeta emisango gyammwe mu mbuga mujja kufuna obwogerero.","poem":1},{"text":"Tukuŋŋaane tulabeko omutuufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Ani eyayita omuweereza we okuva mu buvanjuba,","poem":1},{"text":"eyamuyita akole emirimu gye amuweereze mu butuukirivu?","poem":2},{"text":"Ani eyamuwa obuwanguzi ku bakabaka ne ku mawanga,","poem":1},{"text":"n’abafuula ng’enfuufu n’ekitala kye,","poem":2},{"text":"obusaale bwe ne bubafuula ebisasiro","poem":1},{"text":"ebitwalibwa empewo?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"N’agenda ng’abagoba embiro n’ayita bulungi mu makubo","poem":1},{"text":"ebigere bye gye by’ali bitayitanga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ani eyakola kino ng’ayita emirembe gy’abantu","poem":1},{"text":"okuva ku lubereberye?","poem":2},{"text":"Nze Mukama ow’olubereberye","poem":1},{"text":"era ow’enkomerero, nze wuuyo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ebizinga by’alaba ne bitya;","poem":1},{"text":"n’ensi yonna n’ekankana: baasembera kumpi ne batuuka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Buli muntu yayamba muliraanwa we ng’agamba nti;","poem":1},{"text":"“Guma omwoyo!”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Awo omubazzi n’agumya omuweesi wa zaabu omwoyo,","poem":1},{"text":"n’oyo ayooyoota n’akayondo","poem":2},{"lineBreak":true},{"text":"n’agumya oyo akuba ku luyijja","poem":2},{"text":"ng’ayogera ku kyuma ekigatta nti, “Nga kirungi,”","poem":1},{"text":"era ne bakikomerera n’emisumaali kireme okusagaasagana.","poem":2}]},{"type":"heading","content":["Isirayiri Yalondebwa Katonda"]},{"type":"verse","number":8,"content":[{"text":"“Naye ggwe Isirayiri omuweereza wange,","poem":1},{"text":"Yakobo gwe nalonda,","poem":2},{"lineBreak":true},{"text":"ezzadde lya Ibulayimu mukwano gwange,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ggwe, gwe naggya ku nkomerero y’ensi","poem":1},{"text":"ne nkuyita okuva mu bitundu by’ensi ebikomererayo ddala,","poem":2},{"text":"ne nkugamba nti, ‘Oli muddu wange,’","poem":1},{"text":"nze nakulonda so sikusuulanga:","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Totya kubanga nze ndi wamu naawe;","poem":1},{"text":"tokeŋŋentererwa, kubanga nze Katonda wo.","poem":2},{"text":"Nnaakuwanga amaanyi.","poem":1},{"text":"Wewaawo nnaakuyambanga n’omukono ogwa ddyo ogw’obutuukirivu bwange.”","poem":2}]},{"type":"heading","content":["Isirayiri Alinnya ku Balabe be"]},{"type":"verse","number":11,"content":[{"text":"“Laba, abo bonna abakukambuwalidde","poem":1},{"text":"balikwatibwa ensonyi ne balaba ennaku.","poem":2},{"text":"Abo abakuwakanya balifuuka ekitagasa","poem":1},{"text":"ne baggwaawo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Olibanoonya abo abaakukijjanyanga","poem":1},{"text":"naye n’otobalaba.","poem":2},{"text":"Abo abaakulwanyisanga","poem":1},{"text":"baliggwaamu ensa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kubanga nze Mukama Katonda wo","poem":1},{"text":"akukwata ku mukono ogwa ddyo,","poem":2},{"text":"nze nkugamba nti,","poem":1},{"text":"Totya nze nzija kukuyamba.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wadde ng’oli lusiriŋŋanyi","poem":1},{"text":"totya, ggwe Isirayiri,","poem":2},{"text":"kubanga nnaakuyamba,” bw’ayogera Mukama Omununuzi wo,","poem":1},{"text":"Omutukuvu wa Isirayiri.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Laba ndikufuula ng’ekyuma ekiggya ekisala ennyo,","poem":1},{"text":"ekyogi eky’amannyo amangi.","poem":2},{"text":"Muliwuula ensozi ne muzimementulira ddala,","poem":1},{"text":"obusozi ne mubufuula ebisusunku.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Oliziwewa empewo n’ezifuumula,","poem":1},{"text":"embuyaga ezifuumuka zizisaasaanye.","poem":2},{"text":"Era naawe olisanyukira mu Mukama,","poem":1},{"text":"era mu Mutukuvu wa Isirayiri mw’olyenyumiririza.”","poem":2}]},{"type":"heading","content":["Mukama Ayimusa Isirayiri"]},{"type":"verse","number":17,"content":[{"text":"“Abaavu n’abali mu bwetaavu bwe baneetaganga amazzi","poem":1},{"text":"ne baganoonya naye ne gababula,","poem":2},{"lineBreak":true},{"text":"ate nga ennimi zaabwe zikaze,","poem":2},{"text":"nze Mukama ndibawulira,","poem":1},{"text":"nze Katonda wa Isirayiri siribaleka.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndikola emigga ku busozi obutaliiko kantu,","poem":1},{"text":"era n’ensulo wakati mu biwonvu.","poem":2},{"text":"Olukoola ndirufuula ennyanja,","poem":1},{"text":"n’eddungu lirivaamu enzizi z’amazzi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ndisimba mu lukoola omuvule ne akasiya,","poem":1},{"text":"omumwanyi n’omuzeyituuni,","poem":2},{"text":"ate nsimbe mu ddungu","poem":1},{"text":"enfugo n’omuyovu awamu ne namukago.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Abantu balyoke balabe bamanye,","poem":1},{"text":"balowooze","poem":2},{"text":"era batuuke bonna okutegeera nti omukono gwa Mukama gwe gukoze kino,","poem":1},{"text":"nti Omutukuvu wa Isirayiri yakikoze.”","poem":2}]},{"type":"heading","content":["Mukama Asoomooza Bakatonda Abalala"]},{"type":"verse","number":21,"content":[{"text":"Bw’ati bw’ayogera Mukama Katonda gye muli mmwe nti,","poem":1},{"text":"“Mmwe bakatonda baamawanga, mujje nammwe mwogere.","poem":2},{"text":"Muleete ensonga zammwe tuziwulire,” bw’ayogera Kabaka wa Yakobo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"“Baleete bakatonda bwabwe","poem":1},{"text":"batubuulire ebigenda okubaawo.","poem":2},{"text":"Batubuulire n’ebyaliwo emabega,","poem":1},{"text":"tusobole okubimanya,","poem":2},{"lineBreak":true},{"text":"n’okubirowoozaako","poem":2},{"text":"n’okumanya ebinaavaamu oba okutubuulira ebigenda okujja.","poem":1}]},{"type":"verse","number":23,"content":[{"text":"Mutubuulire ebigenda okubaawo","poem":2},{"lineBreak":true},{"text":"tulyoke tumanye nga muli bakatonda.","poem":2},{"text":"Mubeeko kye mukola ekirungi oba ekibi","poem":1},{"text":"tulyoke tutye era tukeŋŋentererwe mu mutima.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Laba, temuliiko bwe muli","poem":1},{"text":"ne bye mukola tebigasa.","poem":2},{"lineBreak":true},{"text":"Abo ababasinza bennyamiza.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nonze omuntu alifuluma mu bukiikakkono akoowoola erinnya lyange,","poem":1},{"text":"abeera mu buvanjuba.","poem":2},{"text":"Alirinnyirira abafuzi ng’asamba ettaka,","poem":1},{"text":"abe ng’omubumbi asamba ebbumba.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ani eyakyogera nti kiribeerawo tulyoke tumanye,","poem":1},{"text":"eyakyogera edda tulyoke tugambe nti, ‘Wali mutuufu?’","poem":2},{"text":"Tewali n’omu yakyogerako,","poem":1},{"text":"tewali n’omu yakimanya","poem":2},{"lineBreak":true},{"text":"era tewali n’omu yawulira kigambo na kimu okuva gye muli.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nasooka okubuulira Sayuuni","poem":1},{"text":"era ne mpeereza omubaka e Yerusaalemi ababuulire amawulire amalungi.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Naye tewali n’omu mu bakatonda bammwe eyabategeeza kino.","poem":1},{"text":"Tewali n’omu awa bigambo biruŋŋamya,","poem":2},{"lineBreak":true},{"text":"tewali n’omu addamu bwe mbuuza.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Laba, bonna temuli nsa!","poem":1},{"text":"Bye bakola byonna tebigasa.","poem":2},{"lineBreak":true},{"text":"Ebifaananyi byabwe byonna ebibajje, mpewo na butaliimu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}