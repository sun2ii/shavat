{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":42,"content":[{"type":"heading","content":["Omuweereza wa Katonda"]},{"type":"verse","number":1,"content":[{"text":"Laba omuweereza wange gwe mpanirira,","poem":1},{"text":"omulonde wange gwe nsanyukira ennyo.","poem":2},{"text":"Ndimuwa Omwoyo wange","poem":1},{"text":"era alireeta obwenkanya eri amawanga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Talireekaana","poem":1},{"text":"wadde okuyimusa eddoboozi lye mu luguudo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Talimenya lumuli lubetentefu","poem":1},{"text":"oba okuzikiza olutambi olwaka empola ennyo;","poem":2},{"text":"mu bwesigwa alireeta obwenkanya.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Taliremererwa oba okuggwaamu essuubi okutuusa ng’aleesewo obutebenkevu ku nsi.","poem":2},{"text":"N’ebizinga eby’ewala","poem":1},{"text":"biririndirira amateeka ge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bw’atyo bw’ayogera Mukama Katonda,","poem":1},{"lineBreak":true},{"text":"eyatonda eggulu n’alibamba.","poem":1},{"text":"Eyayanjuluza ensi ne byonna ebigivaamu;","poem":2},{"text":"awa omukka abantu baakwo","poem":1},{"text":"era n’obulamu eri bonna abagitambulirako.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Nze Mukama,","poem":1},{"text":"nakuyita mu butuukirivu.","poem":2},{"text":"Ndikukwata ku mukono era ndikukuuma.","poem":1},{"text":"Ndikufuula okuba endagaano eri abantu,","poem":2},{"lineBreak":true},{"text":"era omusana eri bannamawanga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Okuzibula amaaso g’abazibe,","poem":1},{"text":"okuta abasibe okuva mu makomera","poem":2},{"lineBreak":true},{"text":"n’okuggya abo abali mu bunnya, abo abali mu kizikiza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Nze Mukama,","poem":1},{"text":"eryo lye linnya lyange, n’ekitiibwa kyange sirikiwa mulala,","poem":2},{"lineBreak":true},{"text":"newaakubadde ettendo lyange okukiwa bakatonda abalala.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Laba, ebyo bye nagamba nti","poem":1},{"text":"biribaawo bituuse,","poem":2},{"text":"kaakano mbabuulira ku bigenda okujja;","poem":1},{"text":"mbibategeeza nga tebinnabaawo.”","poem":2}]},{"type":"heading","content":["Oluyimba olw’Okutendereza Mukama"]},{"type":"verse","number":10,"content":[{"text":"Muyimbire Mukama oluyimba oluggya,","poem":1},{"text":"ettendo lye okuva ku nkomerero y’ensi!","poem":2},{"text":"Mmwe abasaabala ku nnyanja ne byonna ebigirimu,","poem":1},{"text":"mmwe ebizinga ne bonna ababibeeramu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Leka eddungu n’ebibuga byamu biyimuse amaloboozi gaabyo,","poem":1},{"text":"ebyalo Kedali mw’atuula.","poem":2},{"text":"Leka abantu b’e Seera bayimbe n’essanyu.","poem":1},{"text":"Leka baleekaanire waggulu ku ntikko z’ensozi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Leka Mukama bamuwe ekitiibwa","poem":1},{"text":"era balangirire ettendo lye mu bizinga.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mukama, anafuluma okulwana ng’omutabaazi ow’amaanyi,","poem":1},{"text":"era ng’omutabaazi ow’amaanyi alijja yeeswanta,","poem":2},{"text":"n’okuleekaana ng’alangirira olutalo.","poem":1},{"text":"Era aliwangula abalabe be.","poem":2}]},{"type":"heading","content":["Katonda Asuubiza Okuyamba Abantu be"]},{"type":"verse","number":14,"content":[{"text":"“Ebbanga ggwanvu nga siriiko kye ŋŋamba,","poem":1},{"text":"nga nsirise neekuumye.","poem":2},{"text":"Naye okufaanana ng’omukazi alumwa okuzaala,","poem":1},{"text":"nkaaba, mpejjawejja era nzisa ebikkowe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndizikiriza ensozi n’obusozi,","poem":1},{"text":"egyo emiddo gyakwo gyonna ndi wakugiwotosa.","poem":2},{"text":"Era ndikaza ebinywa byabwe byonna","poem":1},{"text":"n’emigga ndigifuula ebizinga.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Era ndikulembera abantu bange abazibe ba maaso mu kkubo lye batamanyi","poem":1},{"text":"n’abayise mbaluŋŋamize mu makubo ge batamanyidde.","poem":2},{"text":"Ndifuula ekizikiza okuba omusana mu maaso gaabwe","poem":1},{"text":"n’ebifo ebizibu okuyitamu ndibirongoosa.","poem":2},{"text":"Ebyo by’ebintu bye ndikola,","poem":1},{"text":"sirireka bantu bange.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Naye abo abeesiga bakatonda abalala, ababagamba nti,","poem":1},{"text":"‘Mwe bakatonda baffe,’ balikwasibwa ensonyi,","poem":2},{"lineBreak":true},{"text":"era baligobebwa, mu buswavu obungi.”","poem":2}]},{"type":"heading","content":["Ekibi ky’Eggwanga n’Okubonerezebwa"]},{"type":"verse","number":18,"content":[{"text":"“Muwulire mmwe bakiggala,","poem":1},{"text":"mutunule mmwe bamuzibe, mulabe.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ani muzibe okuggyako omuweereza wange,","poem":1},{"text":"oba kiggala okuggyako omubaka wange gwe ntuma?","poem":2},{"text":"Eriyo eyaziba amaaso asinga oyo eyeewaayo gye ndi,","poem":1},{"text":"oba omuzibe ng’omuweereza wa Mukama?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Olabye ebintu bingi naye tobifuddeko,","poem":1},{"text":"amatu go maggule naye tolina ky’owulira.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kyasanyusa Mukama olw’obulungi obw’obutuukirivu bwe","poem":1},{"text":"okukuza amateeka ge","poem":2},{"lineBreak":true},{"text":"n’okugassaamu ekitiibwa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Naye bano, bantu be,","poem":1},{"text":"ababbibwa ne banyagibwa bonna","poem":2},{"lineBreak":true},{"text":"ne basibibwa mu binnya oba abasibibwa mu makomera.","poem":2},{"text":"Bafuuka munyago","poem":1},{"text":"nga tewali n’omu abanunula,","poem":2},{"text":"bafuuliddwa abanyage","poem":1},{"text":"nga tewali n’omu agamba nti, “Bateebwe baddeyo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ani ku mmwe anaawuliriza kino,","poem":1},{"text":"oba anaafaayo ennyo n’awuliriza mu biro ebigenda okujja?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ani eyawaayo Yakobo okuba omunyago","poem":1},{"text":"ne Isirayiri eri abanyazi?","poem":2},{"text":"Teyali Mukama gwe twayonoona?","poem":1},{"text":"Ekyo yakikola","poem":2},{"text":"kubanga tebaagoberera makubo ge.","poem":1},{"text":"Tebaagondera mateeka ge.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kyeyava abafukako obusungu bwe obubuubuuka","poem":1},{"text":"n’obulumi bw’entalo.","poem":2},{"text":"Beebungululwa ennimi z’omuliro naye tebaategeera.","poem":1},{"text":"Gwabookya naye ne batakissaako mwoyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}