{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":43,"content":[{"type":"heading","content":["Omulokozi wa Isirayiri Ali Omu Yekka"]},{"type":"verse","number":1,"content":[{"text":"Naye kaakano bw’atyo bw’ayogera Mukama oyo eyakutonda,","poem":1},{"text":"ggwe Yakobo,","poem":2},{"lineBreak":true},{"text":"eyakukola ggwe Isirayiri:","poem":2},{"text":"“Totya kubanga nkununudde,","poem":1},{"text":"nakuyita nga mpitira ddala erinnya lyo, oli wange.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bw’onooyitanga mu mazzi amawanvu","poem":1},{"text":"nnaabeeranga naawe,","poem":2},{"text":"ne bw’onooyitanga mu migga","poem":1},{"text":"tegirikusaanyaawo;","poem":2},{"text":"bw’onooyitanga mu muliro","poem":1},{"text":"tegukwokyenga,","poem":2},{"lineBreak":true},{"text":"ennimi z’omuliro tezirikwokya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kubanga nze Mukama Katonda wo,","poem":1},{"text":"Katonda Omutukuvu owa Isirayiri; Omulokozi wo.","poem":2},{"text":"Mpayo Misiri ggwe osobole okuteebwa,","poem":1},{"text":"era Kuusi ne Seba mbiwaayo gwe ofune emirembe gyo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kubanga oli wa muwendo gye ndi, ow’ekitiibwa,","poem":1},{"text":"era kubanga nkwagala,","poem":2},{"text":"ndiwaayo abasajja ku lulwo","poem":1},{"text":"mpeeyo n’abantu ku lw’obulamu bwo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Totya, kubanga nze ndi nawe,","poem":1},{"text":"ndireeta ezzadde lyo okuva ebuvanjuba","poem":2},{"lineBreak":true},{"text":"era nkukuŋŋaanye okuva ebugwanjuba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndigamba obukiikakkono nti, ‘Waayo b’olina,’","poem":1},{"text":"n’obukiikaddyo nti, ‘Tobagaanira.’","poem":2},{"text":"Leeta batabani bange okuva ewala","poem":1},{"text":"ne bawala bange okuva ku nkomerero y’ensi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Buli muntu yenna ayitibwa erinnya lyange,","poem":1},{"text":"gwe natonda olw’ekitiibwa kyange,","poem":2},{"lineBreak":true},{"text":"gwe nakola gwe natonda.”","poem":2}]},{"type":"heading","content":["Eggwanga Erirondeddwa nga Omujulirwa"]},{"type":"verse","number":8,"content":[{"text":"Fulumya abo abalina amaaso naye nga tebalaba,","poem":1},{"text":"abalina amatu naye nga tebawulira.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Amawanga gonna ka gakuŋŋaane","poem":1},{"text":"n’abantu bajje.","poem":2},{"text":"Ani ku bo eyali ayogedde ku bintu bino?","poem":1},{"text":"Ani ku bo eyali alangiridde ebyaliwo?","poem":2},{"text":"Leka baleete abajulizi okukakasa nti baali batuufu","poem":1},{"text":"abawulira bagambe nti, “Ddala bwe kiri.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Muli bajulirwa bange,” bw’ayogera Mukama,","poem":1},{"text":"“omuweereza wange gwe nalonda:","poem":2},{"text":"mulyoke mummanye, munzikirize,","poem":1},{"text":"mutegeere nga Nze wuuyo:","poem":2},{"text":"Tewali Katonda eyansooka","poem":1},{"text":"era teriba mulala alinzirira.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nze, Nze mwene, nze Mukama;","poem":1},{"text":"okuggyako nze tewali Mulokozi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nze naleeta okwolesebwa ne nangirira ne ndokola;","poem":1},{"text":"nze so si katonda mulala mugwira mu mmwe.","poem":2},{"text":"Muli bajulirwa bange,” bw’ayogera Mukama.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"“Weewaawo, okuva mu nnaku ez’edda Nze Nzuuyo;","poem":2},{"text":"tewali n’omu ayinza okuwonya omuntu mu mukono gwange.","poem":1},{"text":"Kye nkola ani ayinza okukikyusa?”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bw’ati bw’ayogera Mukama,","poem":1},{"text":"Omununuzi wammwe, Omutukuvu wa Isirayiri nti,","poem":2},{"text":"“Ku lwammwe nditumya e Babulooni,","poem":1},{"text":"ndeetere ab’e Babulooni bonna nga bawambe","poem":2},{"lineBreak":true},{"text":"mu byombo ebyabeewanya.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nze Mukama, Omutukuvu wammwe,","poem":1},{"text":"Omutonzi wa Isirayiri, Kabaka wammwe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bw’ati bw’ayogera Mukama,","poem":1},{"text":"oyo eyakola ekkubo mu nnyanja,","poem":2},{"lineBreak":true},{"text":"n’oluguudo mu mazzi amangi ennyo,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"eyaleetera amagaali, n’embalaasi n’eggye, n’abaali bazze okubayamba,","poem":1},{"text":"byonna awamu okugwa omwo,","poem":2},{"text":"ne bitaddamu kusituka, nga bizikiridde,","poem":1},{"text":"nga bikomye ng’akatambi akabadde kaaka:","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Mwerabire eby’emabega,","poem":1},{"text":"so temulowooza ku by’ayita.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Laba, nkola ekintu ekiggya!","poem":1},{"text":"Kaakano kitandise okulabika, temukiraba?","poem":2},{"text":"Nkola oluguudo mu ddungu","poem":1},{"text":"ne ndeeta emigga mu lukoola.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ensolo ez’omu nsiko zinzisaamu ekitiibwa,","poem":1},{"text":"ebibe n’ebiwuugulu;","poem":2},{"text":"kubanga nze ngaba amazzi mu ddungu,","poem":1},{"text":"n’emigga mu lukoola,","poem":2},{"text":"okunywesa abantu bange, abalonde bange,","poem":1}]},{"type":"verse","number":21,"content":[{"text":"abantu be nnekolera","poem":2},{"lineBreak":true},{"text":"balangirire ettendo lyange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“So tonkowodde ggwe, Yakobo,","poem":1},{"text":"era teweekooyeza ggwe Isirayiri.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Tondeetedde ndiga ey’ebiweebwayo ebyokebwa,","poem":1},{"text":"wadde okunzisaamu ekitiibwa ne ssaddaaka zo.","poem":2},{"text":"Sikukaluubirizanga nga nkusaba ebiweebwayo ebyempeke","poem":1},{"text":"wadde okukukooya n’obubaane.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Tondeeteddeeyo bubaane buwunya kawoowo","poem":1},{"text":"wadde okunzikusa n’amasavu ga ssaddaaka zo,","poem":2},{"text":"naye onkoyesezza n’ebibi byo,","poem":1},{"text":"era n’onteganya n’obutali butuukirivu bwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Nze, Nze mwene,","poem":1},{"text":"nze wuuyo asangula ebyonoono byo ku lwange nze,","poem":2},{"lineBreak":true},{"text":"so sirijjukira bibi byo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nzijukiza eby’edda, tuwoze ffembi,","poem":1},{"text":"jjangu ensonga tuzoogereko fembi,","poem":2},{"lineBreak":true},{"text":"yogera ebiraga nga toliiko musango.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kitaawo eyasooka yasobya,","poem":1},{"text":"abakulembeze bo baanjemera.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kyendiva ndiswaza abakungu ba yeekaalu yo,","poem":1},{"text":"era ndiwaayo Yakobo azikirizibwe","poem":2},{"lineBreak":true},{"text":"ne Isirayiri aswazibwe.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":28}