{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":44,"content":[{"type":"heading","content":["Isirayiri Eyalondebwa"]},{"type":"verse","number":1,"content":[{"text":"“Naye kaakano ggwe Yakobo omuweereza wange, wuliriza,","poem":1},{"text":"ggwe Isirayiri gwe nalonda.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bw’ati bw’ayogera Mukama oyo,","poem":1},{"text":"eyakutonda era eyakubumba mu lubuto,","poem":2},{"lineBreak":true},{"text":"ajja kukuyamba.","poem":2},{"text":"Totya ggwe Yakobo,","poem":1},{"noteId":27},{"text":"omuweereza wange,","poem":1},{"text":"ggwe Yesuruni gwe nalonda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kubanga ndifuka amazzi ku ttaka","poem":1},{"text":"eririna ennyonta n’enzizi ku ttaka ekkalu.","poem":2},{"text":"Ndifuka Omwoyo wange ku zadde lyo,","poem":1},{"text":"era n’omukisa gwange ku bazzukulu bo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Era balimera ng’omuddo ku mabbali g’enzizi,","poem":1},{"text":"babe ng’emiti egiri ku mabbali g’emigga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Omu aligamba nti, ‘Nze ndi wa Mukama,’","poem":1},{"text":"n’omulala ne yeeyita erinnya lya Yakobo,","poem":2},{"text":"n’omulala ne yeewandiikako nti, ‘Wa Mukama,’","poem":1},{"text":"ne yeetuuma Isirayiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Bw’ati bw’ayogera Mukama kabaka wa Isirayiri era Omununuzi we,","poem":1},{"text":"Mukama Katonda ow’Eggye:","poem":2},{"text":"Nze w’olubereberye era nze nkomererayo","poem":1},{"text":"era tewali Katonda mulala we ndi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani afaanana nga nze,","poem":1},{"text":"akirangirire,","poem":2},{"text":"eyali asobola okumanya n’alangirira ebigenda okubaawo","poem":1},{"text":"okuviira ddala ku ntandikwa?","poem":2},{"lineBreak":true},{"text":"Leka batubuulire ebigenda okubaawo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Temutya wadde okuggwaamu amaanyi.","poem":1},{"text":"Saakirangirira ne ntegeeza ebigenda okujja?","poem":2},{"text":"Mmwe bajulirwa bange.","poem":1},{"text":"Eriyo Katonda omulala okuggyako nze? Nedda.","poem":2},{"text":"Tewali Lwazi lulala,","poem":1},{"text":"sirina lwe mmanyi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abo abakola bakatonda abakole n’emikono tebaliimu nsa,","poem":1},{"text":"era ebyo bye basanyukira okukola tebirina kye bigasa.","poem":2},{"text":"Abajulirwa baabwe tebalaba so tebalina kye bamanyi,","poem":1},{"text":"balyoke bakwatibwe ensonyi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani akola Katonda omubajje oba asaanuusa ekifaananyi ekyole ekitaliiko kye kiyamba?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Laba ye ne banne balikwatibwa ensonyi.","poem":1},{"text":"N’ababazzi nabo bantu buntu.","poem":2},{"text":"Leka bonna bakuŋŋaane, banjolekere; balikwatibwa ensonyi n’entiisa.","poem":1},{"text":"Ensonyi ziribatta bonna era bagwemu entiisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Omuweesi akwata ekitundu ky’ekyuma","poem":1},{"text":"n’akiyisa mu manda, agaliko omuliro.","poem":2},{"text":"Akikolako n’akitereeza n’ennyondo mu maanyi ge.","poem":1},{"text":"Enjala emuluma,","poem":2},{"text":"n’aggwaamu amaanyi,","poem":1},{"text":"tanywa mazzi era akoowa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Omubazzi akozesa olukoba okupima olubaawo","poem":1},{"text":"era n’alamba n’ekkalaamu.","poem":2},{"text":"Akinyiriza ne landa,","poem":1},{"text":"n’akiramba kyonna n’ekyuma ekigera,","poem":2},{"text":"n’akikolamu ekifaananyi ky’omuntu ng’omuntu bw’afaanana,","poem":1},{"text":"kiryoke kiteekebwe mu nnyumba.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Atema emivule oba n’addira enzo oba omuyovu n’agusimba","poem":1},{"text":"oba n’aguleka gukule n’emiti mu kibira,","poem":2},{"text":"oba n’asimba enkanaga,","poem":1},{"text":"enkuba n’egikuza.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Abantu bagukozesa ng’enku,","poem":1},{"text":"ezimu n’azitwala n’azikozesa okukuma omuliro ne yeebugumya.","poem":2},{"lineBreak":true},{"text":"Akuma omuliro n’afumba emigaati.","poem":2},{"text":"Naye ekitundu ekirala akikolamu katonda n’amusinza,","poem":1},{"text":"akola ekifaananyi ekikole n’emikono n’akivuunamira.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ekitundu ky’olubaawo akyokya mu muliro,","poem":1},{"text":"ekitundu ekirala akyokesa ennyama","poem":2},{"lineBreak":true},{"text":"n’agirya n’akutta.","poem":2},{"text":"Ayotako n’abuguma nga bw’agamba nti,","poem":1},{"text":"“Mbugumye, omuliro ngutegedde!”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ekitundu ekisigaddewo akikolamu katonda,","poem":1},{"text":"ekifaananyi ekikole n’emikono,","poem":2},{"text":"era n’akivuunamira n’akisinza n’akyegayirira n’agamba nti,","poem":1},{"text":"“Mponya, kubanga ggwe katonda wange.”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tebaliiko kye bamanyi so tebaliiko kye bategeera,","poem":1},{"text":"amaaso gaabwe gazibye n’okuyinza ne batayinza kulaba,","poem":2},{"lineBreak":true},{"text":"n’okutegeera ne batayinza kutegeera.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tewali n’omu ayimirira n’alowooza,","poem":1},{"text":"tewali n’omu amanyi wadde ategeera okugamba nti,","poem":2},{"text":"“Ekimu ekyokubiri ekyakwo nkyokezza mu muliro,","poem":1},{"text":"era ne nfumba n’obugaati ku manda gaakyo,","poem":2},{"lineBreak":true},{"text":"njokezzaako n’ennyama n’engirya.","poem":2},{"text":"Ekitundu kyakyo kifuuse eky’omuzizo?","poem":1},{"text":"Nvuunamire ekisiki ky’omuti?”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Alya vvu. Omutima gwe gumulimbalimba,","poem":1},{"text":"tasobola kwerokola wadde okwebuuza nti,","poem":2},{"lineBreak":true},{"text":"“Kino ekiri mu mukono gwange ogwa ddyo si bulimba?”","poem":2}]},{"type":"heading","content":["Mukama, Omutonzi era Omulokozi"]},{"type":"verse","number":21,"content":[{"text":"“Jjukira ebintu bino, ggwe Yakobo;","poem":1},{"text":"oli muweereza wange ggwe Isirayiri.","poem":2},{"text":"Nze nakubumba, oli muweereza wange,","poem":1},{"text":"ggwe Isirayiri sirikwerabira.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ebyonoono byo mbyezeewo n’embisenda ng’ekire, n’ebibi byo ne mbyerawo ng’olufu olw’omu makya. Komawo gye ndi kubanga nakununula.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Yimba n’essanyu ggwe eggulu","poem":1},{"text":"kubanga ekyo Mukama yakikoze.","poem":2},{"text":"Muleekaane n’essanyu mmwe abali wansi ku nsi.","poem":1},{"text":"Muyimbe mmwe ensozi, mmwe ebibira na buli muti ogulimu.","poem":2},{"text":"Mukama anunudde Yakobo","poem":1},{"text":"era yeegulumiriza mu Isirayiri.","poem":2}]},{"type":"heading","content":["Yerusaalemi kya Kuzzibwawo"]},{"type":"verse","number":24,"content":[{"text":"“Bw’ati bw’ayogera Mukama Omulokozi wo,","poem":1},{"text":"eyakutondera mu lubuto.","poem":2},{"lineBreak":true},{"text":"“Nze Mukama,","poem":1},{"text":"eyatonda ebintu byonna,","poem":2},{"lineBreak":true},{"text":"eyabamba eggulu nzekka,","poem":2},{"lineBreak":true},{"text":"eyayanjuluza ensi obwomu,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"asazaamu abalaguzi bye balagudde","poem":1},{"text":"era abalogo abafuula abasirusiru.","poem":2},{"text":"Asaabulula eby’abagezi","poem":1},{"text":"n’afuula bye balowoozezza okuba eby’obusirusiru.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Anyweza ekigambo ky’omuweereza we","poem":1},{"text":"n’atuukiriza obubaka bwa babaka bange.","poem":2},{"lineBreak":true},{"text":"“Ayogera ku Yerusaalemi nti, ‘Kirituulibwamu,’","poem":1},{"text":"ne ku bibuga bya Yuda nti, ‘Birizimbibwa,’","poem":2},{"lineBreak":true},{"text":"ne ku bifo ebyazika nti, ‘Ndibizzaawo.’","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Agamba amazzi g’obuziba bwe nnyanja nti, ‘Kalira,","poem":1},{"text":"era ndikaliza emigga gyo.’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ayogera ku Kuulo nti, ‘Musumba wange","poem":1},{"text":"era alituukiriza bye njagala byonna.’","poem":2},{"text":"Alyogera ku Yerusaalemi nti, ‘Kizimbibwe,’","poem":1},{"text":"ne ku yeekaalu nti, ‘Emisingi gyayo gizimbibwe.’ ”","poem":2}]}],"footnotes":[{"noteId":27,"caller":"+","text":"Wano Yakobo kitegeeza Isirayiri","reference":{"chapter":44,"verse":2}}]},"thisChapterLink":"/api/lug_bib/ISA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/43.json","previousChapterAudioLinks":{},"numberOfVerses":28}