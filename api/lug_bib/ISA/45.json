{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":45,"content":[{"type":"verse","number":1,"content":[{"text":"“Bw’ati Mukama bw’agamba Kuulo gwe yafukako amafuta,","poem":1},{"text":"oyo gwe mpadde amaanyi mu mukono gwe ogwa ddyo","poem":2},{"text":"okujeemulula amawanga mu maaso ge","poem":1},{"text":"era n’okwambula bakabaka ebyokulwanyisa byabwe,","poem":2},{"text":"okuggulawo enzigi ezimuli mu maaso,","poem":1},{"text":"emiryango eminene gireme kuggalwawo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndikukulembera","poem":1},{"text":"ne ntereeza ebifo ebigulumivu.","poem":2},{"text":"Ndimenyaamenya emiryango egy’ebikomo","poem":1},{"text":"ne ntemaatema ebisiba eby’ekyuma.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Era ndikuwa obugagga obwakwekebwa mu bifo ebyekusifu","poem":1},{"text":"era n’ebintu ebyakwekebwa mu bifo ebyekyama","poem":2},{"text":"olyoke omanye nga nze Mukama,","poem":1},{"text":"Katonda wa Isirayiri akuyitira ddala erinnya lyo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ku lwa Yakobo omuweereza wange ne ku lwa Isirayiri omulonde wange","poem":1},{"text":"kyenvudde nkuyita erinnya,","poem":2},{"text":"ne nkuwa ekitiibwa","poem":1},{"text":"wadde nga tonzisaako mwoyo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nze Mukama, tewali mulala.","poem":1},{"text":"Tewali katonda mulala wabula nze.","poem":2},{"text":"Ndikuwa amaanyi","poem":1},{"text":"wadde nga tonzisaako mwoyo,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"balyoke bamanye nga okuva enjuba gy’eva okutuuka gyegenda","poem":1},{"text":"tewali mulala wabula nze.","poem":2},{"text":"Nze Mukama,","poem":1},{"text":"tewali mulala.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nze nteekawo ekitangaala","poem":1},{"text":"ne ntonda ekizikiza.","poem":2},{"lineBreak":true},{"text":"Nze ndeeta okukulaakulana n’okubonaabona.","poem":2},{"text":"Nze Mukama akola ebyo byonna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Mmwe eggulu eriri waggulu,","poem":1},{"text":"mutonnyese obutuukirivu.","poem":2},{"text":"Ebire bitonnyese obutuukirivu.","poem":1},{"text":"Ensi egguke n’obulokozi bumeruke,","poem":2},{"text":"ereete obutuukirivu.","poem":1},{"text":"Nze Mukama nze nagitonda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Zimusanze oyo ayomba n’omutonzi we!","poem":1},{"text":"Zimusanze oyo oluggyo mu nzigyo z’ensi.","poem":2},{"text":"Bbumba ki eribuuza oyo alibumba nti,","poem":1},{"text":"‘Obumba ki?’","poem":2},{"text":"Oba omulimu gwo okukubuuza nti,","poem":1},{"text":"‘Aliko emikono?’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Zimusanze oyo agamba kitaawe nti,","poem":1},{"text":"‘Wazaala ki?’","poem":2},{"text":"Oba nnyina nti,","poem":1},{"text":"‘Kiki ky’ozadde?’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Bw’ati bw’ayogera Mukama Omutukuvu wa Isirayiri","poem":1},{"text":"era Omutonzi we nti,","poem":2},{"text":"‘Lwaki mumbuuza ebigenda okujja,","poem":1},{"text":"oba ebikwata ku baana bange,","poem":2},{"lineBreak":true},{"text":"oba okumpa ebiragiro ku bikwata ku mirimu gy’emikono gyange?’","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nze nakola ensi ne ngitonderamu abantu. Emikono gyange gyennyini gye gyayanjuluza eggulu, era ne ndagira eby’omu bwengula byonna bitondebwewo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ndiyimusa Kuulo mu butuukirivu","poem":1},{"text":"era nditereeza amakubo ge gonna.","poem":2},{"text":"Alizimba ekibuga kyange","poem":1},{"text":"n’asumulula abantu bange abaawaŋŋangusibwa;","poem":2},{"text":"naye si lwa mpeera oba ekirabo,”","poem":1},{"text":"bw’ayogera Mukama Katonda ow’Eggye.","poem":2}]},{"type":"verse","number":14,"content":["Bw’ati bw’ayogera Mukama nti,",{"text":"“Ebiva mu Misiri n’ebyamaguzi bya Kuusi birireetebwa,","poem":1},{"text":"n’abo Abasabeya abawanvu","poem":2},{"text":"balijja","poem":1},{"text":"babeere abaddu bo,","poem":2},{"text":"bajje nga bakugoberera","poem":1},{"text":"nga basibiddwa mu njegere.","poem":2},{"text":"Balikuvuunamira bakwegayirire nga bagamba nti,","poem":1},{"text":"‘Ddala Katonda ali naawe, ye Katonda yekka, tewali Katonda mulala.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ddala oli Katonda eyeekweka,","poem":1},{"text":"ggwe Katonda wa Isirayiri era Omulokozi we.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bonna abakola bakatonda abakole n’emikono baliswazibwa,","poem":1},{"text":"balikwatibwa ensonyi, bonna balikwata ekkubo limu nga baswadde.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Naye Isirayiri alirokolebwa Mukama","poem":1},{"text":"n’obulokozi obutaliggwaawo.","poem":2},{"text":"Temuukwatibwenga nsonyi,","poem":1},{"text":"temuuswalenga emirembe gyonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kubanga bw’atyo bw’ayogera Mukama eyatonda eggulu,","poem":1},{"lineBreak":true},{"text":"ye Katonda eyabumba ensi n’agikola.","poem":1},{"text":"Ye yassaawo emisingi gyayo.","poem":2},{"text":"Teyagitonda kubeera nkalu","poem":1},{"lineBreak":true},{"text":"naye yagikola etuulwemu.","poem":1},{"text":"Ye yagamba nti, “Nze Mukama so tewali mulala.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Soogereranga mu kyama,","poem":1},{"text":"oba mu nsi eyeekizikiza.","poem":2},{"text":"Sigambanga bazzukulu ba Yakobo nti,","poem":1},{"text":"‘Munoonyeze bwereere.’","poem":2},{"text":"Nze Mukama njogera mazima,","poem":1},{"text":"mbuulira ebigambo eby’ensonga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Mwekuŋŋaanye mujje,","poem":1},{"text":"mukuŋŋaane, mmwe abasigaddewo mu mawanga.","poem":2},{"text":"Tebalina magezi abo abasitula ebifaananyi ebibajje,","poem":1},{"text":"abasaba eri katonda atasobola kubalokola.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mukuŋŋaane muleete ensonga zammwe.","poem":1},{"text":"Muteese muyambagane.","poem":2},{"text":"Ani eyayogera nti kino kiribaawo?","poem":1},{"text":"Ani eyakyogerako edda?","poem":2},{"text":"Si nze Mukama?","poem":1},{"text":"Tewali Katonda mulala wabula nze,","poem":2},{"text":"Katonda omutuukirivu era Omulokozi,","poem":1},{"text":"tewali mulala wabula nze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Mudde gye ndi, mulokoke,","poem":1},{"text":"mmwe mwenna abali ku nkomerero z’ensi,","poem":2},{"lineBreak":true},{"text":"kubanga nze Katonda so tewali mulala.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Neerayiridde,","poem":1},{"text":"ekigambo kivudde mu kamwa kange mu mazima","poem":2},{"lineBreak":true},{"text":"so tekiriggibwawo mu maaso gange.","poem":2},{"text":"Buli vviivi lirifukamira,","poem":1},{"text":"na buli lulimi lulirayira!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Balinjogerako nti, ‘Mu Mukama mwokka mwe muli obutuukirivu n’amaanyi.’ ”","poem":1},{"lineBreak":true},{"text":"Bonna abaamusunguwalira","poem":1},{"text":"balijja gy’ali nga baswadde.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Naye mu Mukama ezzadde lyonna erya Isirayiri mwe liriweerwa obutuukirivu","poem":1},{"text":"era mwe liryenyumiririza.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}