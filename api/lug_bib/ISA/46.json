{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":46,"content":[{"type":"heading","content":["Bakatonda b’e Babulooni"]},{"type":"verse","number":1,"content":[{"text":"Beri avunnama,","poem":1},{"text":"Nebo akutamye!","poem":2},{"text":"Ebifaananyi bya bakatonda baabwe biteekeddwa ku nsolo ez’omu nsiko, era ne ku nte.","poem":1},{"text":"Ebifaananyi bya bakatonda baabwe migugu mizito ddala ku ndogoyi ezikooye.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bikutamye byonna bivuunamye.","poem":1},{"text":"Tebiyinza kuyamba ku mbeera,","poem":2},{"lineBreak":true},{"text":"byo byennyini bitwaliddwa mu busibe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Mumpulire mmwe, ennyumba ya Yakobo","poem":1},{"text":"n’abantu bonna abasigaddewo mu nnyumba ya Isirayiri.","poem":2},{"text":"Mmwe be nnalera okuva lwe mwava mu lubuto,","poem":1},{"text":"be nasitula okuva lwe mwazaalibwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne mu bukadde bwammwe nzija kusigala nga ye nze Nzuuyo.","poem":1},{"text":"Ne bwe muliba mulina envi nnaabasitulanga.","poem":2},{"text":"Nze nabakola era nze nnaabawekanga.","poem":1},{"text":"Nnaabasitulanga era nnaabanunulanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Ani gwe mulinfaananya era gwe mulinnenkanya","poem":1},{"text":"era gwe mulingerageranyaako tufaanane?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eriyo abaggya zaabu ennyingi mu nsawo zaabwe","poem":1},{"text":"ne bapima ne ffeeza ku minzaani.","poem":2},{"text":"Olwo ne bapangisa omuweesi wa zaabu n’agiweesaamu katonda waabwe,","poem":1},{"text":"ne bagwa wansi ne basinza.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Katonda waabwe ne bamusitulira ku kibegabega, ne bamuwa ekifo w’anaayimiriranga.","poem":1},{"text":"N’ayimirira awo,","poem":2},{"lineBreak":true},{"text":"n’atava mu kifo kye.","poem":2},{"text":"Oli ne bw’amukaabirira tayinza kumuddamu,","poem":1},{"text":"tayinza kumuwonya mu mitawaana gye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Mujjukire kino mmwe, mulowooze mu mitima gyammwe.","poem":1},{"text":"Mwekube mu kifuba, mmwe abajeemu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mujjukire ebigambo ebyasooka eby’edda ennyo.","poem":1},{"text":"Kubanga nze Katonda, teri mulala.","poem":2},{"lineBreak":true},{"text":"Nze Katonda, teri ali nga nze;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"alanga ku ntandikwa ebigenda okubaawo.","poem":1},{"text":"Okuva ku mirembe egy’edda ennyo,","poem":2},{"text":"nalanga ebintu ebitannabaawo, nga ŋŋamba nti, ‘Enteekateeka zange zijja kubaawo","poem":1},{"text":"era ndituukiriza byonna bye nategeka.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mpita ekinyonyi ekikwakkula ebiramu ebirala.","poem":1},{"text":"Omusajja","poem":2},{"noteId":28},{"text":"ava ebuvanjuba mu nsi eyewala, anaakola bye njagala.","poem":2},{"text":"Weewaawo njogedde era nnaatuukiriza.","poem":1},{"text":"Nga bwe nategeka bwe nnaakola.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mumpulirize mmwe abalina emitima emikakanyavu,","poem":1},{"text":"abakyama ennyo ne bava mu kkubo ly’obutuukirivu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nsembeza kumpi obutuukirivu bwange,","poem":1},{"text":"tebuli wala.","poem":2},{"lineBreak":true},{"text":"N’obulokozi bwange tebuulwewo.","poem":2},{"text":"Ndireeta obulokozi mu Sayuuni,","poem":1},{"text":"ne nzizaawo ekitiibwa kyange mu Isirayiri.”","poem":2}]}],"footnotes":[{"noteId":28,"caller":"+","text":"Kino kyogera ku Kuulo","reference":{"chapter":46,"verse":11}}]},"thisChapterLink":"/api/lug_bib/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}