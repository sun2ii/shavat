{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":47,"content":[{"type":"heading","content":["Babulooni Esalirwa Omusango"]},{"type":"verse","number":1,"content":[{"text":"“Omuwala wa Babulooni embeerera,","poem":1},{"text":"kakkana wansi otuule mu nfuufu,","poem":2},{"text":"tuula wansi awatali ntebe ya bwakabaka,","poem":1},{"text":"ggwe omuwala w’Abakaludaaya.","poem":2},{"text":"Ekibuga ekitawangulwangako.","poem":1},{"text":"Toliddayo nate kuyitibwa kyatika oba nnalulungi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ddira olubengo ose obutta.","poem":1},{"text":"Ggyako akatimba ku maaso,","poem":2},{"text":"situla ku ngoye z’oku magulu","poem":1},{"text":"oyite mu mazzi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Obwereere bwo bulibikkulwa;","poem":1},{"text":"obusungu bwo bulyeraga.","poem":2},{"text":"Nzija kuwoolera eggwanga;","poem":1},{"text":"tewali muntu yenna gwe ndirekawo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Omununuzi waffe Mukama Katonda ow’Eggye lye linnya lye,","poem":1},{"text":"ye Mutukuvu wa Isirayiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Tuula mu kasirise","poem":1},{"text":"yingira mu kizikiza ggwe omuwala w’Abakaludaaya,","poem":2},{"text":"tebakyakuyita kabaka omukazi","poem":1},{"text":"afuga obwakabaka obungi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nnali nsunguwalidde abantu bange,","poem":1},{"text":"ne nyonoonesa omugabo gwange.","poem":2},{"text":"Nabawaayo mu mikono gyo,","poem":1},{"text":"n’otobasaasira n’akatono.","poem":2},{"text":"N’abakadde wabateekako ekikoligo ekinene ennyo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wayogera nti,","poem":1},{"text":"‘Nzija kubeera kabaka omukazi emirembe gyonna,’","poem":2},{"text":"naye n’otolowooza ku bintu bino","poem":1},{"text":"wadde okulowooza ku kyali kigenda okubaawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Kale nno kaakano wuliriza kino,","poem":1},{"text":"ggwe awoomerwa amasanyu","poem":2},{"text":"ggwe ateredde mu mirembe gyo,","poem":1},{"text":"ng’oyogera mu mutima gwo nti,","poem":2},{"text":"‘Nze ndiwo era tewali mulala wabula nze.","poem":1},{"text":"Siribeera nnamwandu","poem":2},{"lineBreak":true},{"text":"wadde okufiirwa abaana.’","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ebintu bino byombi birikutuukako mangu nnyo mu lunaku lumu,","poem":1},{"text":"eky’okufiirwa abaana","poem":2},{"lineBreak":true},{"text":"n’okufuuka nnamwandu.","poem":2},{"text":"Birikutuukako mu kigera kyabyo ekituufu,","poem":1},{"text":"newaakubadde obulogo bwo nga bungi okuyitirira,","poem":2},{"lineBreak":true},{"text":"n’eby’obufumu byo nga bigenze wala.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Weesiga obutali butuukirivu bwo,","poem":1},{"text":"n’olowooza nti, ‘Siriiko annondoola.’","poem":2},{"text":"Amagezi go era n’okumanya kwo byakuwabya,","poem":1},{"text":"bwe wayogera nti, ‘Nze ndiwo, era teri mulala wabula nze.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kyokka ensasagge erikujjira","poem":1},{"text":"era tolimanya ngeri yakugyeggyako;","poem":2},{"text":"n’okuzikirira kw’otoliyinza kweggyako na muwendo gwa nsimbi;","poem":1},{"text":"akabi k’otolirabirawo kalikutuukako amangu ddala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Weeyongere nno n’obulogo bwo","poem":1},{"text":"n’obufumu bwo obwayinga obungi,","poem":2},{"lineBreak":true},{"text":"bwe wanyiikiriramu okuva mu buto bwo.","poem":2},{"text":"Oboolyawo olibaako kyoggyamu,","poem":1},{"text":"oboolyawo olikolawo ekyobulabe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Amagezi ago g’ofuna gakukooya bukooya.","poem":1},{"text":"Abalagulira ku munyeenye basembera,","poem":2},{"text":"n’abo abakebera emmunyeenye,","poem":1},{"text":"era aboogera ebiribaawo buli mwezi, babadduukirire mu bigenda okubatuukako.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Laba, bali ng’ebisusunku","poem":1},{"text":"era omuliro gulibookya!","poem":2},{"text":"Tebalyewonya","poem":1},{"text":"maanyi ga muliro.","poem":2},{"text":"Tewaliiwo manda ga kukubugumya","poem":1},{"text":"wadde omuliro ogw’okwota!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ekyo kye bayinza okukukolera kyokka;","poem":1},{"text":"b’obonyeebonye nabo","poem":2},{"lineBreak":true},{"text":"b’oteganidde okuva mu buto bwo.","poem":2},{"text":"Buli muntu alikwata ekkubo lye nga yeeyongera okukola ebibi bye","poem":1},{"text":"era tewali n’omu ayinza okukulokola.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}