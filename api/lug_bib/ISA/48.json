{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":48,"content":[{"type":"heading","content":["Katonda bye Yayogera Bituukirira"]},{"type":"verse","number":1,"content":[{"text":"“Muwulire kino, mmwe ennyumba ya Yakobo,","poem":1},{"text":"abayitibwa erinnya lya Isirayiri,","poem":2},{"lineBreak":true},{"text":"era abaava mu nda ya Yuda.","poem":2},{"text":"Mmwe abalayirira mu linnya lya Mukama,","poem":1},{"text":"era abaatula Katonda wa Isirayiri,","poem":2},{"lineBreak":true},{"text":"naye si mu mazima wadde mu butuukirivu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kubanga beeyita ab’ekibuga ekitukuvu,","poem":1},{"text":"abeesiga Katonda wa Isirayiri,","poem":2},{"lineBreak":true},{"text":"Mukama Katonda ow’Eggye lye linnya lye.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Okuva ku ntandikwa, nayasanguza ebyali bigenda okubaawo;","poem":1},{"text":"byava mu kamwa kange ne mbyogera.","poem":2},{"lineBreak":true},{"text":"Amangwago ne tubikola ne bituukirira.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kubanga namanya obukakanyavu bwammwe;","poem":1},{"text":"ebinywa by’ensingo nga bikakanyavu ng’ekyuma;","poem":2},{"lineBreak":true},{"text":"ekyenyi ng’ekikomo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nabamanyisizaawo edda ebyali bigenda okujja nga tebinnabaawo,","poem":1},{"text":"muleme kugamba nti,","poem":2},{"text":"“Bakatonda bange be baabikola:","poem":1},{"text":"Ekifaananyi kyange ekyole","poem":2},{"lineBreak":true},{"text":"n’ekifaananyi ekisaanuuse bye byakikola.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mulabe ebintu bino nabibagamba dda,","poem":1},{"text":"era temubikkirize?","poem":2},{"lineBreak":true},{"text":"“Okuva leero nzija kubabuulira ku bintu ebiggya ebigenda okujja,","poem":1},{"text":"eby’ekyama bye mutawulirangako.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mbikola kaakano,","poem":1},{"text":"so si ekiseera ekyayita:","poem":2},{"text":"mwali temubiwulirangako mu biseera eby’emabega","poem":1},{"text":"si kulwa nga mugamba nti, ‘Laba nnali mbimanyi.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Towulirangako wadde okutegeera.","poem":1},{"text":"Okuva edda n’edda okutu kwo tekuggukanga.","poem":2},{"text":"Kubanga namanya nti wali kyewaggula,","poem":1},{"text":"okuva ku kuzaalibwa kwo wayitibwa mujeemu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Olw’erinnya lyange","poem":1},{"text":"ndwawo okusunguwala. Olw’ettendo lyange","poem":2},{"lineBreak":true},{"text":"ndwawo okukusunguwalira nneme okukuzikiriza.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Laba nkugezesezza naye si nga ffeeza.","poem":1},{"text":"Nkugezesezza mu kirombe ky’okubonaabona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ku lwange nze,","poem":1},{"text":"ku lwange nze ndikikola. Erinnya lyange nga livumiddwa.","poem":2},{"lineBreak":true},{"text":"Ekitiibwa kyange sirikiwa mulala.","poem":2}]},{"type":"heading","content":["Isirayiri Enunulibwa"]},{"type":"verse","number":12,"content":[{"text":"“Mpuliriza ggwe Yakobo.","poem":1},{"text":"Isirayiri gwe nalonda.","poem":2},{"text":"Nze Nzuuyo.","poem":1},{"text":"Nze ow’olubereberye era nze ow’enkomerero.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Omukono gwange gwe gwateekawo omusingi gw’ensi,","poem":1},{"text":"era omukono gwange ogwa ddyo ne gwanjuluza eggulu.","poem":2},{"text":"Bwe mbiyita","poem":1},{"text":"byombi bijja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Mwekuŋŋaanye mwenna","poem":1},{"text":"mujje muwulire!","poem":2},{"text":"Ani ku bo eyali alangiridde ebintu bino?","poem":1},{"text":"Mukama amwagala; ajja kutuukiriza ekigendererwa kye e Babulooni,","poem":2},{"lineBreak":true},{"text":"era omukono gwe gwolekere Abakaludaaya.","poem":2},{"noteId":29}]},{"type":"verse","number":15,"content":[{"text":"Nze; Nze nzennyini nze njogedde.","poem":1},{"text":"Nze namuyita.","poem":2},{"text":"Ndimuleeta","poem":1},{"text":"era alituukiriza omulimu gwe.","poem":2}]},{"type":"verse","number":16,"content":["“Munsemberere muwulirize bino.",{"text":"“Okuva ku lubereberye saayogera mu kyama.","poem":1},{"text":"Nze mbaddewo okuviira ddala ku ntandikwa.”","poem":2},{"lineBreak":true},{"text":"Era kaakano Mukama Ayinzabyonna","poem":1},{"text":"n’Omwoyo we antumye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Bw’atyo bw’ayogera Mukama, Omununuzi wammwe,","poem":1},{"text":"Omutukuvu wa Isirayiri nti,","poem":2},{"text":"“Nze Mukama Katonda wo","poem":1},{"text":"akuyigiriza okukulaakulana,","poem":2},{"lineBreak":true},{"text":"akukulembera mu kkubo ly’oteekwa okutambuliramu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Singa kale wali owulirizza ebiragiro byange!","poem":1},{"text":"Wandibadde n’emirembe egikulukuta ng’omugga!","poem":2},{"lineBreak":true},{"text":"Era n’obutuukirivu bwo ng’amayengo g’ennyanja,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ezzadde lyo lyandibadde ng’omusenyu","poem":1},{"text":"abaana bo ng’obuweke bwagwo.","poem":2},{"text":"Erinnya lyabwe teryandivuddewo","poem":1},{"text":"wadde okuzikirira nga wendi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Muve mu Babulooni,","poem":1},{"text":"mudduke Abakaludaaya.","poem":2},{"text":"Mugende nga mutegeeza amawulire gano n’essanyu.","poem":1},{"text":"Mugalangirire wonna wonna","poem":2},{"lineBreak":true},{"text":"n’okutuusa ku nkomerero y’ensi.","poem":2},{"text":"Mugambe nti, “Mukama anunudde omuddu we Yakobo!”","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"So tebaalumwa nnyonta bwe yabayisa mu malungu.","poem":1},{"text":"Yabakulukusiza amazzi mu lwazi:","poem":2},{"text":"yayasa olwazi","poem":1},{"text":"amazzi ne gavaamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Tewali mirembe eri aboonoonyi,” bw’ayogera Mukama.","poem":1}]}],"footnotes":[{"noteId":29,"caller":"+","text":"Abakaludaaya be Bababulooni","reference":{"chapter":48,"verse":14}}]},"thisChapterLink":"/api/lug_bib/ISA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/47.json","previousChapterAudioLinks":{},"numberOfVerses":22}