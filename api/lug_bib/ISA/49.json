{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":49,"content":[{"type":"heading","content":["Omuweereza wa Mukama"]},{"type":"verse","number":1,"content":[{"text":"Mumpulirize mmwe ebizinga,","poem":1},{"text":"mmwe muwulire kino amawanga agali ewala.","poem":2},{"text":"Nnali sinazaalibwa Mukama n’ampita.","poem":1},{"text":"Bwe nnali nkyali mu lubuto lwa mmange n’ayatula erinnya lyange.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yakola akamwa kange ng’ekitala eky’obwogi,","poem":1},{"text":"nankweka mu kisiikirize ky’omukono gwe.","poem":2},{"text":"Yanfuula akasaale akazigule","poem":1},{"text":"era nankweka mu mufuko gwe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Era n’aŋŋamba nti, “Ggwe muweereza wange, Isirayiri,","poem":1},{"text":"mu ggwe mwe ndiweerwa ekitiibwa.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Naye ne njogera nti, “Nteganidde bwereere,","poem":1},{"text":"amaanyi gange ng’amalidde bwereere era gafudde busa.","poem":2},{"text":"Kyokka ate Mukama yannamula,","poem":1},{"text":"n’empeera yange eri ne Katonda wange!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Era kaakano Mukama ayogera,","poem":1},{"text":"oyo eyammumba mu lubuto okubeera omuweereza we,","poem":2},{"text":"okukomyawo Yakobo gy’ali","poem":1},{"text":"era n’okukuŋŋaanya Isirayiri gy’ali.","poem":2},{"text":"Kubanga ndi wa kitiibwa mu maaso ga Mukama","poem":1},{"text":"era Katonda wange afuuse amaanyi gange.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mukama agamba nti,","poem":1},{"lineBreak":true},{"text":"“Eky’okubeera omuweereza wange","poem":1},{"text":"n’okuzza amawanga ga Yakobo","poem":2},{"lineBreak":true},{"text":"era n’okukomyawo abantu ba Isirayiri kintu kitono nnyo.","poem":2},{"text":"Nzija kukufuula ekitangaala eri abamawanga,","poem":1},{"text":"olyoke oleete obulokozi bwange eri ensi yonna.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bw’ati bw’ayogera Mukama,","poem":1},{"text":"Omununuzi era Omutukuvu wa Isirayiri,","poem":2},{"text":"eri oyo eyanyoomebwa n’akyayibwa amawanga,","poem":1},{"text":"eri omuweereza w’abafuzi nti,","poem":2},{"text":"“Bakabaka baliyimirira ne bakuwa ekitiibwa,","poem":1},{"text":"abalangira balikulaba ne bakuvuunamira.","poem":2},{"text":"Kino kiribaawo ku lwa Mukama, omwesigwa Omutukuvu wa Isirayiri,","poem":1},{"text":"oyo akulonze.”","poem":2}]},{"type":"heading","content":["Isirayiri Azzibwawo"]},{"type":"verse","number":8,"content":["Bw’ati bw’ayogera Mukama nti,",{"text":"“Ndikwanukula mu biro mwe ndisiimira,","poem":1},{"text":"ku lunaku olw’obulokozi ndikuyamba.","poem":2},{"text":"Ndikukuuma ne nkufuula endagaano eri abantu,","poem":1},{"text":"muliddayo ku ttaka lyammwe ne muddizibwa ebitundu byammwe ebyazika,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"nga mugamba abasibe nti, ‘Muveemu,’","poem":1},{"text":"n’abo abali mu kizikiza nti, ‘Mube n’eddembe!’","poem":2},{"lineBreak":true},{"text":"“Banaaliranga ku mabbali g’ekkubo,","poem":1},{"text":"ne ku ntikko z’obusozi bwonna obwereere banasangangako omuddo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tebaalumwenga njala newaakubadde ennyonta,","poem":1},{"text":"ebbugumu ly’omu ddungu teriibakwatenga newaakubadde omusana okubookya.","poem":2},{"text":"Oyo abakwatirwa ekisa alibakulembera,","poem":1},{"text":"anaabatwalanga awali enzizi z’amazzi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Era ndifuula ensozi zange zonna okuba amakubo","poem":1},{"text":"era enguudo zange ennene zirigulumizibwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Laba, abantu bange balidda okuva ewala,","poem":1},{"text":"abamu, baliva mu bukiikakkono","poem":2},{"lineBreak":true},{"text":"n’abalala ebuvanjuba, n’abalala bave mu nsi ye Sinimu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yogerera waggulu n’essanyu, era jjaguza ggwe ensi.","poem":1},{"text":"Muyimbe mmwe ensozi!","poem":2},{"lineBreak":true},{"text":"Kubanga Mukama agumya abantu be era alisaasira abantu be ababonyaabonyezebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Naye Sayuuni n’ayogera nti, “Mukama andese,","poem":1},{"text":"era Mukama wange anneerabidde.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Nnyina w’omwana ayinza okwerabira omwana we gw’ayonsa,","poem":1},{"text":"n’atasaasira mwana eyava mu lubuto lwe?","poem":2},{"text":"Weewaawo, wadde ng’ayinza okumwerabira","poem":1},{"text":"naye nze sirikwerabira.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Laba, nkuwandiise mu bibatu by’engalo zange;","poem":1},{"text":"ebisenge byo binaabeeranga mu maaso gange.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abaana bo banguwa okujja era abakuzimba balisukkuluma ku bakuzikiriza","poem":1},{"text":"era abo abaakuzikirizanga balikuvaamu bagende.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yimusa amaaso go otunule enjuuyi zonna olabe.","poem":1},{"text":"Abantu bo beekuŋŋaanya bajja gy’oli.","poem":2},{"text":"Nga bwe ndi Katonda omulamu,","poem":1},{"text":"balikwesiimisa, obambale ng’ebikomo n’emidaali ebyebbeeyi","poem":2},{"lineBreak":true},{"text":"ng’omugole bw’ayambala malidaadi,” bw’ayogera Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Wadde nga wazika n’olekebwa awo ensi yo n’ezikirizibwa,","poem":1},{"text":"kaakano ojja kubeera mufunda nga toja mu bantu bo,","poem":2},{"text":"era abo abakuteganya","poem":1},{"text":"banaakubeeranga wala.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Abantu bo abazaalibwa mu buwaŋŋanguse","poem":1},{"text":"lumu balyogera ng’owulira nti,","poem":2},{"text":"‘Ekifo kino nga kifuuse kifunda bulala;","poem":1},{"text":"tuwe ekifo aw’okubeera.’","poem":2}]},{"type":"verse","number":21,"content":[{"text":"N’olyoka oyogera mu mutima gwo nti,","poem":1},{"text":"‘Ani eyanzaalira abaana bano bonna?","poem":2},{"text":"Nafiirwa abaana bange bonna ng’ate ndi mugumba.","poem":1},{"text":"Nawaŋŋangusibwa ne nsigala nzekka.","poem":2},{"lineBreak":true},{"text":"Bano baava ludda wa?","poem":2},{"text":"Nasigala nzekka,","poem":1},{"text":"naye ate bano, baava wa?’ ”","poem":2}]},{"type":"heading","content":["Okuzzibwawo kwa Isirayiri mu Kitiibwa"]},{"type":"verse","number":22,"content":[{"text":"Bw’atyo bw’ayogera Mukama Katonda nti, “Laba, ndikolera abamawanga obubonero","poem":1},{"text":"era ndiyimusiza abantu ebbendera yange:","poem":2},{"text":"era balireeta batabani bo nga babasitulidde mu bifuba","poem":1},{"text":"ne bawala bo nga babasitulidde ku bibegabega byabwe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Era bakabaka be balibeera ba kitammwe babalabirire,","poem":1},{"text":"ne bannabagereka babeere bamaama ababayonsa.","poem":2},{"text":"Balivuunama mu maaso go nga batunudde wansi;","poem":1},{"text":"balikomba enfuufu y’omu bigere byo.","poem":2},{"text":"Olwo lw’olimanya nti nze Mukama,","poem":1},{"text":"abo bonna abannindirira n’abansuubiriramu tebalikwatibwa nsonyi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Omunyago guyinza okuggyibwa ku mutabaazi,","poem":1},{"text":"oba omuwambe omutuukirivu okuwona omutabaazi?","poem":2}]},{"type":"verse","number":25,"content":["Naye bw’ati bw’ayogera Mukama:",{"text":"“N’oyo eyawambibwa omutabaazi alisumululwa ateebwe,","poem":1},{"text":"n’omunyago guggyibwe ku mulabe wo,","poem":2},{"text":"kubanga ndiyomba n’oyo ayomba naawe,","poem":1},{"text":"era ndirokola mponye abaana bo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ndiriisa abakujooga ennyama yaabwe bo.","poem":1},{"text":"Era balittiŋŋana batamiire omusaayi gwabwe, nga wayini.","poem":2},{"text":"Olwo abalina omubiri bonna bamanye nti nze Mukama Omulokozi wo,","poem":1},{"text":"Omununuzi wo,","poem":2},{"lineBreak":true},{"text":"ow’Amaanyi owa Yakobo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/48.json","previousChapterAudioLinks":{},"numberOfVerses":26}