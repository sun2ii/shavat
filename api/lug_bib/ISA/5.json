{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":5,"content":[{"type":"heading","content":["Olugero lw’Ennimiro y’Emizabbibu"]},{"type":"verse","number":1,"content":[{"text":"Ka nnyimbire omwagalwa wange oluyimba","poem":1},{"text":"olukwata ku nnimiro ye ey’emizabbibu.","poem":2},{"text":"Omwagalwa wange yalina nnimiro ey’emizabbibu","poem":1},{"text":"ku lusozi olugimu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Era n’agirima n’agiggyamu amayinja gonna,","poem":1},{"text":"n’agisimbamu emizabbibu egisinga obulungi.","poem":2},{"text":"Era wakati mu yo n’azimbamu ebigulumu okulengererwa.","poem":1},{"text":"N’agisimamu n’essogolero","poem":2},{"text":"n’agisuubira okubala emizabbibu emirungi","poem":1},{"text":"naye n’ebala emizabbibu nga si mirungi n’akatono.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Era kaakano abatuuze b’omu Yerusaalemi n’abasajja b’omu Yuda,","poem":1},{"text":"munsalirewo nze n’ennimiro yange ey’emizabbibu.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ate kiki kye nandikoledde ennimiro yange eno,","poem":1},{"text":"kye ssaagikolera?","poem":2},{"text":"Bwe naginoonyamu emizabbibu emirungi,","poem":1},{"text":"lwaki saalabamu mirungi?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kaakano muleke mbabuulire","poem":1},{"text":"kye nnaakola ennimiro yange ey’emizabbibu.","poem":2},{"text":"Nzija kugiggyako olukomera eyonooneke.","poem":1},{"text":"Ndimenya ekisenge kyayo yonna erinnyirirwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Era ndigireka n’ezika,","poem":1},{"text":"sirigirima wadde okugisalira.","poem":2},{"lineBreak":true},{"text":"Naye ndigireka n’emeramu emyeeramannyo n’amaggwa.","poem":2},{"text":"Ndiragira n’ebire","poem":1},{"text":"obutatonnyesaamu nkuba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ennyumba ya Isirayiri","poem":1},{"text":"y’ennimiro ya Mukama Katonda Ayinzabyonna ey’emizabbibu.","poem":2},{"text":"Abantu ba Yuda","poem":1},{"text":"y’ennimiro gye yasiima.","poem":2},{"text":"Yali abasuubiramu bwenkanya naye yabalabamu kuyiwa musaayi.","poem":1},{"text":"Yabasuubiramu butuukirivu naye nawulira kukaaba na kulaajana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Zibasanze mmwe aboongera amayumba ku ge mulina,","poem":1},{"text":"n’ennimiro ne muzongerako endala","poem":2},{"text":"ne wataba kafo konna kasigadde,","poem":1},{"text":"ne mubeera mwekka wakati mu nsi!","poem":2}]},{"type":"verse","number":9,"content":["Mukama Katonda alayidde nga mpulira nti,",{"text":"“Mu mazima ennyumba nnyingi zirifuuka bifulukkwa,","poem":1},{"text":"n’ezo ennene ez’ebbeeyi zibulemu abantu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kubanga yika kkumi ez’ennimiro y’emizabbibu zinaavangamu ekibbo kimu,","poem":1},{"text":"n’ogusero ogw’ensigo, kabbo bubbo ak’amakungula.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Zibasanze abo abakeera enkya ku makya","poem":1},{"text":"banoonye ekitamiiza,","poem":2},{"text":"abalwawo nga banywa omwenge ettumbi ly’obudde,","poem":1},{"text":"okutuusa omwenge lwe gubalalusa!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ababeera n’ennanga n’entongooli, ebitaasa n’endere,","poem":1},{"text":"n’omwenge ku mbaga zaabwe;","poem":2},{"text":"naye ne batalowooza ku mulimu gwa Mukama Katonda,","poem":1},{"text":"wadde okussa ekitiibwa mu ebyo bye yatonda.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Abantu bange kyebavudde bagenda mu buwaŋŋanguse","poem":1},{"text":"kubanga tebalina kutegeera.","poem":2},{"text":"Abantu baabwe ab’ekitiibwa bafe enjala,","poem":1},{"text":"n’abantu aba bulijjo bafe ennyonta.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Amagombe kyegavudde gagaziya omumiro gwago,","poem":1},{"text":"era ne gaasamya akamwa kaago awatali kkomo.","poem":2},{"text":"Mu ko mwe munaagenda abakungu baabwe","poem":1},{"text":"n’abantu baabwe abaabulijjo, n’ab’effujjo n’abatamiivu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Buli muntu alitoowazibwa,","poem":1},{"text":"abantu bonna balikkakkanyizibwa","poem":2},{"lineBreak":true},{"text":"era amaaso g’abo abeemanyi nago gakkakkanyizibwe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Naye Mukama Katonda ow’Eggye aligulumizibwa olw’obwenkanya,","poem":1},{"text":"era Katonda Omutukuvu yeerage nga bw’ali omutukuvu mu butuukirivu bwe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Endiga ento ziryoke zirye ng’eziri mu malundiro gaazo,","poem":1},{"text":"n’ensolo engenyi ziriire mu bifo ebyalekebwa awo, ebyalundirwangamu eza ssava.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Zibasanze abo abasikaasikanya ebibi byabwe","poem":1},{"text":"ng’embalaasi bw’esika ekigaali.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Aboogera nti, “Ayanguyeeko, ayite mu bwangu tulabe ky’anaakola.","poem":1},{"text":"Entegeka z’omutukuvu wa Isirayiri nazo zijje,","poem":2},{"lineBreak":true},{"text":"zituuke nazo tuzimanye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Zibasanze abo abayita ekibi ekirungi","poem":1},{"text":"n’ekirungi ekibi,","poem":2},{"text":"abafuula ekizikiza okuba ekitangaala,","poem":1},{"text":"n’ekitangaala okuba ekizikiza,","poem":2},{"text":"abafuula ekikaawa okuba ekiwoomerera","poem":1},{"text":"n’ekiwoomerera okuba ekikaawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Zibasanze abo abeeraba ng’abalina amagezi,","poem":1},{"text":"era abagezigezi bo nga bwe balaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Zibasanze abo abazira mu kunywa omwenge","poem":1},{"text":"era mu kutabula ekitamiiza,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"abejjeereza abatemu olw’enguzi","poem":1},{"text":"era abamma abatuukirivu obwenkanya obubagwanidde.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kale ng’olulimi lw’omuliro bwe lwokya ekisagazi ekikalu,","poem":1},{"text":"era ng’omuddo omukalu bwe guggweerera mu muliro,","poem":2},{"text":"bwe gityo n’emirandira gyabwe bwe girivunda,","poem":1},{"text":"era n’ebimuli byabwe bifuumuuke ng’enfuufu;","poem":2},{"text":"kubanga baajeemera etteeka lya Mukama Katonda ow’Eggye,","poem":1},{"text":"era ne banyooma ekigambo ky’Omutukuvu wa Isirayiri.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Noolwekyo obusungu bwa Mukama Katonda bubuubuukira ku bantu be,","poem":1},{"text":"n’agolola omukono gwe n’abasanjaga,","poem":2},{"text":"ensozi ne zikankana","poem":1},{"text":"era n’emirambo gyabwe ne gibeera ng’ebisasiro wakati mu nguudo.","poem":2},{"lineBreak":true},{"text":"Naye wadde nga biri bwe bityo, obusungu bwa Mukama Katonda tebunnakakkana","poem":1},{"text":"era omukono gwe gukyagoloddwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Era aliyimusiza eggwanga eriri ewala bbendera,","poem":1},{"text":"alibakoowoola ng’asinziira ku nkomerero y’ensi,","poem":2},{"text":"era laba,","poem":1},{"text":"balyanguwako okujja.","poem":2},{"noteId":5}]},{"type":"verse","number":27,"content":[{"text":"Tewali n’omu akooye, tewali n’omu yeesittala.","poem":1},{"text":"Tewali n’omu asumagira wadde okwebaka.","poem":2},{"text":"Tewali aliba yeesibye lukoba olutanywedde mu kiwato kye,","poem":1},{"text":"wadde aliba n’olukoba lw’engatto olulikutuka.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Obusaale bwabwe bwogi,","poem":1},{"text":"n’emitego gyabwe gyonna mireege.","poem":2},{"text":"Ebinuulo by’embalaasi zaabwe biriba ng’amayinja ag’embaalebaale,","poem":1},{"text":"Ne nnamuziga w’amagaali gaabwe ng’adduka ng’embuyaga y’akazimu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Okuwuluguma kwabwe kuliba nga okw’empologoma,","poem":1},{"text":"balikaaba ng’empologoma ento:","poem":2},{"text":"weewaawo baliwuluguma bakwate omuyiggo gwabwe","poem":1},{"text":"bagutwalire ddala awatali adduukirira.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Era ku lunaku olwo baliwuumira ku munyago gwabwe","poem":1},{"text":"ng’ennyanja eyira.","poem":2},{"text":"Omuntu yenna bw’alitunuulira ensi,","poem":1},{"text":"aliraba ekizikiza n’ennaku;","poem":2},{"lineBreak":true},{"text":"n’ekitangaala kiribuutikirwa ebire ebikutte.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Abalirumba baliba Basuuli.","reference":{"chapter":5,"verse":26}}]},"thisChapterLink":"/api/lug_bib/ISA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/4.json","previousChapterAudioLinks":{},"numberOfVerses":30}