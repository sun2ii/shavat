{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":50,"content":[{"type":"heading","content":["Ekibi Kyawukanya Isirayiri ku Katonda"]},{"type":"verse","number":1,"content":["Bw’ati bw’ayogera Mukama nti,",{"text":"“Ebbaluwa egoba nnyammwe, kwe namugobera eri ludda wa?","poem":1},{"text":"Oba nabatunda eri ani?","poem":2},{"text":"Mwatundibwa lwa bikolwa byammwe ebibi;","poem":1},{"text":"olw’obutali butuukirivu bwammwe nnyammwe kyeyava agobwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lwaki bwe najja tewaali muntu n’omu?","poem":1},{"text":"Bwe nakoowoola lwaki tewaali muntu n’omu annyanukula?","poem":2},{"text":"Omukono gwange gwali mumpi nnyo okukununula?","poem":1},{"text":"Mbuliddwa amaanyi agakununula?","poem":2},{"text":"Laba nnyinza okwogera obwogezi ennyanja n’ekalira,","poem":1},{"text":"emigga ne ngifuula eddungu,","poem":2},{"text":"ebyennyanja byamu ne bifa ennyonta,","poem":1},{"text":"ne bivunda olw’okubulwa amazzi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nyambaza eggulu,","poem":1},{"text":"n’ekizikiza ne nkiwa ebibukutu okulibikka.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mukama Ayinzabyonna ampadde olulimi","poem":1},{"text":"oluyigirizibbwa, mmanye ebigambo ebigumya abo abakooye.","poem":2},{"text":"Anzukusa buli nkya,","poem":1},{"text":"buli nkya anzukusa okuwulira by’anjigiriza.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mukama Ayinzabyonna azibudde okutu kwange","poem":1},{"text":"ne siba mujeemu.","poem":2},{"lineBreak":true},{"text":"Sizzeeyo mabega.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"N’awaayo omugongo gwange eri abankuba,","poem":1},{"text":"n’amatama gange eri abo abankunyuulako ekirevu.","poem":2},{"text":"Saakweka maaso gange eri abo abansekerera","poem":1},{"text":"n’eri abo abanfujjira amalusu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kubanga Mukama Ayinzabyonna anyamba","poem":1},{"text":"kyennaava siswazibwa.","poem":2},{"text":"Noolwekyo kyenvudde n’egumya","poem":1},{"text":"era mmanyi nti siriswazibwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kubanga oyo ampolereza ali kumpi.","poem":1},{"text":"Ani alinnumiriza omusango?","poem":2},{"lineBreak":true},{"text":"Twolekagane obwenyi.","poem":2},{"text":"Ani annumiriza?","poem":1},{"text":"Ajje annumbe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mukama Ayinzabyonna y’anyamba.","poem":1},{"text":"Ani alinsalira omusango?","poem":2},{"text":"Bonna balikaddiwa bayulike ng’ekyambalo;","poem":1},{"text":"ennyenje ziribalya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ani ku mmwe atya Mukama,","poem":1},{"text":"agondera ekigambo ky’omuweereza we?","poem":2},{"text":"Oyo atambulira mu kizikiza,","poem":1},{"text":"atalina kitangaala","poem":2},{"text":"yeesige erinnya lya Mukama","poem":1},{"text":"era yeesigame ku Katonda we.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Naye mmwe mwenna abakoleeza omuliro,","poem":1},{"text":"ne mwekoleereza ettaala z’omuliro,","poem":2},{"text":"mutambulire mu kitangaala ky’omuliro gwammwe,","poem":1},{"text":"ne mu kitangaala kye ttaala ze mukoleezeza.","poem":2},{"text":"Naye kino kye munaafuna okuva mu mukono gwange;","poem":1},{"text":"muligalamira mu nnaku.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}