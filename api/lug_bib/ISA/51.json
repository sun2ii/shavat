{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":51,"content":[{"type":"heading","content":["Okukubirizibwa Okwesiga Katonda"]},{"type":"verse","number":1,"content":[{"text":"“Mumpulirize,","poem":1},{"text":"mmwe abanoonya obutuukirivu, mmwe abanoonya Mukama:","poem":2},{"text":"Mutunuulire olwazi lwe mwatemebwako,","poem":1},{"text":"n’obunnya bw’ekirombe gye mwasimibwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mulowooze ku Ibulayimu jjajjammwe","poem":1},{"text":"ne Saala eyabazaala.","poem":2},{"text":"Kubanga we namuyitira yali bw’omu","poem":1},{"text":"ne mmuwa omukisa ne mmwaza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kubanga ddala Mukama alikubagiza Sayuuni;","poem":1},{"text":"akwatirwe ekisa ebifo byakyo byonna ebyazika","poem":2},{"text":"era afuule olukoola lwe lwonna okuba Adeni,","poem":1},{"text":"n’eddungu libeere ng’ennimiro ya Mukama;","poem":2},{"text":"Essanyu n’okujaguza biryoke bibeere omwo,","poem":1},{"text":"okwebaza n’amaloboozi ag’okuyimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Mumpulirize, mmwe abantu bange;","poem":1},{"text":"era muntegere okutu mmwe ensi yange.","poem":2},{"text":"Kubanga etteeka lifuluma okuva gye ndi,","poem":1},{"text":"obwenkanya bwange bubeere omusana eri amawanga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Obutuukirivu bwange","poem":1},{"text":"busembera mangu nnyo,","poem":2},{"lineBreak":true},{"text":"obulokozi bwange buli mu kkubo.","poem":2},{"text":"Era omukono gwange gujja kuleeta obwenkanya eri amawanga.","poem":1},{"text":"Ebizinga birinnindirira era birindirire n’essuubi omukono gwange okubirokola.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Muyimuse amaaso gammwe eri eggulu,","poem":1},{"text":"mutunuulire ensi wansi!","poem":2},{"text":"Kubanga eggulu lirivaawo ng’omukka","poem":1},{"text":"n’ensi ekaddiwe ng’ekyambalo.","poem":2},{"lineBreak":true},{"text":"Abagituulamu balifa ng’ensowera.","poem":2},{"text":"Naye obulokozi bwange bunaabeereranga emirembe gyonna,","poem":1},{"text":"so n’obutuukirivu bwange tebujjulukukenga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Mumpulirize,","poem":1},{"text":"mmwe abamanyi obutuukirivu,","poem":2},{"text":"eggwanga eririna amateeka gange","poem":1},{"text":"mu mitima gyammwe.","poem":2},{"text":"Temutya kuvumibwa bantu","poem":1},{"text":"wadde okukeŋŋentererwa olw’okuyomba kwabwe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kubanga ennyenje ziribalya nga bwe zirya ebyambalo.","poem":1},{"text":"N’obuwuka bubalye ng’obulya ebyoya by’endiga.","poem":2},{"text":"Naye obutuukirivu bwange bunaabeereranga ennaku zonna.","poem":1},{"text":"Obulokozi bwange bunywere emirembe gyonna.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Zuukuka,","poem":1},{"text":"zuukuka oyimuke otuyambe Ayi Mukama Katonda.","poem":2},{"text":"Kozesa amaanyi go otuyambe.","poem":1},{"text":"Gakozese nga edda.","poem":2},{"text":"Si ggwe wuuyo eyatemaatemamu Lakabu obufiififi?","poem":1},{"text":"Si ye ggwe eyafumita ogusota?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Si ggwe wuuyo eyakaliza ennyanja,","poem":1},{"text":"amazzi ag’obuziba obuwanvu ennyo","poem":2},{"text":"ne gafuuka ekkubo","poem":1},{"text":"abantu be wanunula bayitewo?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"N’abo Mukama be wawonya","poem":1},{"text":"balikomawo","poem":2},{"lineBreak":true},{"text":"ne bajja mu Sayuuni nga bayimba.","poem":2},{"text":"Essanyu ery’emirembe n’emirembe liriba nga ngule ku mitwe gyabwe.","poem":1},{"text":"Balisanyuka ne bajaguza; ennaku n’okusinda bibadduke.","poem":2}]},{"type":"heading","content":["Mukama Alinunula Abantu be"]},{"type":"verse","number":12,"content":[{"text":"“Nze, nze mwene, nze nzuuno abawa amaanyi.","poem":1},{"text":"Mmwe baani abatya omuntu alifa,","poem":2},{"lineBreak":true},{"text":"n’omwana w’omuntu ali ng’omuddo,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ne weerabira Mukama Omutonzi wo","poem":1},{"text":"eyabamba eggulu,","poem":2},{"lineBreak":true},{"text":"n’ateekawo n’emisingi gy’ensi,","poem":2},{"text":"ebbanga lyonna ne mubeera mu kutya","poem":1},{"text":"obusungu bw’abo abakunyigiriza,","poem":2},{"lineBreak":true},{"text":"oyo eyemalidde mu kuzikiriza?","poem":2},{"text":"Kubanga kale buliruddawa obulabe bw’oyo abanyigiriza?","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Abo be bawamba ne basibibwa banaatera okuteebwa,","poem":2},{"text":"tebalifiira mu bunnya,","poem":1},{"text":"era tebalibulwa mmere gye balya.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kubanga nze Mukama Katonda wo,","poem":1},{"text":"asiikuula amayengo g’ennyanja ne gawuluguma:","poem":2},{"lineBreak":true},{"text":"Mukama ow’Eggye lye linnya lye.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ntadde ebigambo byange mu kamwa ko,","poem":1},{"text":"era nkubisse mu kisiikirize ky’omukono gwange.","poem":2},{"text":"Nze nakola eggulu ne nteekawo emisingi gy’ensi;","poem":1},{"text":"era nze wuuyo agamba Sayuuni nti,","poem":2},{"lineBreak":true},{"text":"‘Muli bantu bange!’ ”","poem":2}]},{"type":"heading","content":["Ekikopo ky’Obusungu bwa Mukama"]},{"type":"verse","number":17,"content":[{"text":"Zuukuka, zuukuka, oyimirire ggwe Yerusaalemi","poem":1},{"text":"eyanywa okuva eri Mukama ekikompe eky’obusungu bwe,","poem":2},{"text":"eyanywa n’omaliramu ddala","poem":1},{"text":"ekibya ekitagaza.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ku baana aboobulenzi bonna be yazaala","poem":1},{"text":"tewali n’omu wa kumukulembera.","poem":2},{"text":"Ku baana bonna aboobulenzi be yakuza","poem":1},{"text":"tewali n’omu wa kumukwata ku mukono.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ebintu bino ebibiri bikuguddeko","poem":1},{"text":"ani anaakunakuwalirako?","poem":2},{"text":"Okuzika n’okuzikirira, enjala, n’ekitala,","poem":1},{"text":"ani anaakubeesabeesa?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Batabani bo bazirise,","poem":1},{"text":"bagudde ku buli nsonda y’oluguudo","poem":2},{"lineBreak":true},{"text":"ng’engabi egudde mu kitimba.","poem":2},{"text":"Babuutikiddwa ekiruyi kya Mukama,","poem":1},{"text":"n’okunenyezebwa kwa Katonda wo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Noolwekyo wulira kino ggwe, atamidde naye si lwa mwenge.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Bw’atyo bw’ayogera Mukama Ayinzabyonna,","poem":1},{"text":"Katonda wo alwanirira abantu be.","poem":2},{"text":"“Laba mbaggyeeko ekikompe kye nabawa","poem":1},{"text":"olw’ekiruyi kye nalina, ekyabatagaza.","poem":2},{"text":"Temuliddayo","poem":1},{"text":"kukinywa nate.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ndikiteeka mu mikono gy’abo abaababonyaabonya abaabagamba nti,","poem":1},{"text":"‘Mugwe wansi mwegolole tubatambulireko.’","poem":2},{"text":"Emigongo gyammwe gibe ng’ettaka,","poem":1},{"text":"ng’oluguudo olw’okulinnyirira.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}