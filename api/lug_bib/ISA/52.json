{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":52,"content":[{"type":"heading","content":["Katonda Alizzaawo Yerusaalemi"]},{"type":"verse","number":1,"content":[{"text":"Zuukuka, zuukuka,","poem":1},{"text":"oyambale amaanyi go, ggwe Sayuuni.","poem":2},{"text":"Ggwe Yerusaalemi ekibuga ekitukuvu,","poem":1},{"text":"teekako ebyambalo byo ebitemagana.","poem":2},{"text":"Kubanga okuva leero mu miryango gyo","poem":1},{"text":"temukyayingira mu atali mukomole n’atali mulongoofu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Weekunkumuleko enfuufu,","poem":1},{"text":"yimuka otuule ku ntebe ey’obwakabaka ggwe Yerusaalemi.","poem":2},{"text":"Weesumulule enjegere mu bulago bwo,","poem":1},{"text":"ggwe Omuwala wa Sayuuni eyanyagibwa.","poem":2}]},{"type":"verse","number":3,"content":["Kubanga bw’ati bw’ayogera Mukama nti,",{"text":"“Mwatundibwa bwereere","poem":1},{"text":"era mujja kununulibwa awatali kusasula nsimbi.”","poem":2}]},{"type":"verse","number":4,"content":["Kubanga bw’ati bw’ayogera Mukama Ayinzabyonna nti,",{"text":"“Omulundi ogwasooka abantu bange baagenda e Misiri okusengayo,","poem":1},{"text":"oluvannyuma, Omwasuli n’abajooga.","poem":2}]},{"type":"verse","number":5,"content":["“Kaakano kiki ate kye ndaba wano?",{"text":"“Kubanga abantu bange baatwalirwa bwereere","poem":1},{"text":"era abo ababafuga babasekerera,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2},{"text":"“Erinnya lyange","poem":1},{"text":"livvoolebwa olunaku lwonna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mu biseera ebijja abantu bange balimmanya.","poem":1},{"text":"Olunaku lujja lwe balitegeera nga nze nakyogera.","poem":2},{"text":"Weewaawo, Nze.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nga birungi ku nsozi ebigere by’oyo aleeta amawulire amalungi,","poem":1},{"text":"alangirira emirembe,","poem":2},{"lineBreak":true},{"text":"aleeta ebigambo ebirungi,","poem":2},{"text":"alangirira obulokozi,","poem":1},{"text":"agamba Sayuuni nti, “Katonda wo afuga.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wuliriza!","poem":1},{"text":"Amaloboozi g’abakuumi bo gawulikika, gayimusiddwa.","poem":2},{"text":"Bonna awamu bajaguza olw’essanyu.","poem":1},{"text":"Kubanga okudda kwa Mukama mu Sayuuni balikulaba n’amaaso gaabwe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mubaguke okuyimba ennyimba ez’essanyu mwenna,","poem":1},{"text":"mmwe ebifo bya Yerusaalemi ebyazika.","poem":2},{"text":"Kubanga Mukama asanyusizza abantu be,","poem":1},{"text":"anunudde Yerusaalemi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mukama aliraga omukono gwe omutukuvu eri amawanga gonna,","poem":1},{"text":"bagulabe.","poem":2},{"text":"Enkomerero z’ensi zonna","poem":1},{"text":"ziriraba obulokozi bwa Katonda waffe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mugende, mugende muveewo awo.","poem":1},{"text":"Temukwata ku kintu kyonna kitali kirongoofu.","poem":2},{"text":"Mukifulumemu mubeere balongoofu","poem":1},{"text":"mmwe abasitula ebyombo bya Mukama.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Naye temulivaamu nga mwanguyiriza","poem":1},{"text":"so temuligenda nga mudduka;","poem":2},{"text":"kubanga Mukama alibakulembera abasookeyo;","poem":1},{"text":"Katonda wa Isirayiri y’alibakuuma.","poem":2}]},{"type":"heading","content":["Okubonaabona n’Ekitiibwa ky’Omuweereza wa Mukama"]},{"type":"verse","number":13,"content":[{"text":"Laba, omuweereza wange by’akola alibikozesa magezi,","poem":1},{"text":"aliyimusibwa asitulibwe, era assibwemu nnyo ekitiibwa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ng’abaamulaba ne bennyamira bwe baali abangi,","poem":1},{"text":"endabika ye ng’eyonoonese nnyo nga takyafaananika,","poem":2},{"lineBreak":true},{"text":"era ng’eyonoonese evudde ku y’abantu,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"bw’atyo bw’anawuniikiriza amawanga mangi;","poem":1},{"text":"bakabaka balibunira ku lulwe;","poem":2},{"text":"kubanga ekyo ekitababulirwanga balikiraba,","poem":1},{"text":"era ekyo kye batawulirangako, balikitegeera.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}