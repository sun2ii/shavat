{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"Ani akkiriza ebigambo byaffe,","poem":1},{"text":"era ani abikkuliddwa omukono gwa Mukama?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kubanga yakulira mu maaso ga Mukama ng’ekisimbe ekigonvu","poem":1},{"text":"era ng’omulandira oguva mu ttaka ekkalu.","poem":2},{"text":"Teyalina kitiibwa wadde obulungi obutusikiriza tulage gy’ali;","poem":1},{"text":"tewaali kalungi mu ye katumwegombesa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yanyoomebwa n’agaanibwa abantu; omuntu eyagumira ennaku n’obuyinike.","poem":1},{"text":"Tetwayagala na kumutunulako,","poem":2},{"text":"ng’omuntu gwe wandikubye amabega ng’ayitawo,","poem":1},{"text":"bwe twamunyooma ne tutamuyitamu ka buntu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mazima ddala yeetikka obuyinike bwaffe, n’atwala ennaku yaffe,","poem":1},{"text":"obulumi obwanditulumye bwe bwamunyiga.","poem":2},{"text":"Ate nga twalowooza nti okubonaabona kwe","poem":1},{"text":"kyali kibonerezo okuva eri Katonda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Naye yafumitibwa olw’okusobya kwaffe.","poem":1},{"text":"Yabetentebwa olw’obutali butuukirivu bwaffe.","poem":2},{"text":"Yeetikka ekibonerezo ffe tusobole okubeera n’emirembe.","poem":1},{"text":"Ebiwundu bye, bye bituwonya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ffenna twawaba ng’endiga;","poem":1},{"text":"buli omu ku ffe n’akwata ekkubo lye;","poem":2},{"text":"Mukama n’amuteekako","poem":1},{"text":"obutali butuukirivu bwaffe ffenna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yanyigirizibwa era n’obonyaabonyezebwa","poem":1},{"text":"naye talina kye yanyega,","poem":2},{"text":"yali ng’omwana gw’endiga ogutwalibwa okuttibwa,","poem":1},{"text":"era ng’endiga bwesirika obusirisi mu maaso g’abo abagisalako ebyoya bwesirika,","poem":2},{"lineBreak":true},{"text":"bw’atyo bwe yasirika.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mu kunyigirizibwa n’okusalirwa omusango yatwalibwa.","poem":1},{"text":"Ani amanyi ku bye zadde lye?","poem":2},{"text":"Yaggyibwa mu nsi y’abalamu,","poem":1},{"text":"ng’akubiddwa olw’okusobya kw’abantu, bange.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne bamussa mu ntaana n’abakozi b’ebibi,","poem":1},{"text":"n’aziikibwa n’abagagga mu kufa kwe,","poem":2},{"text":"newaakubadde nga teyazza musango","poem":1},{"text":"wadde akamwa ke okwogera eby’obulimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Songa ate yali nteekateeka ya Mukama okumubetenta,","poem":1},{"text":"era n’okumuleetera okubonaabona.","poem":2},{"text":"Naye wadde nga Mukama yafuula obulamu bwe, okuba ekiweebwayo olw’ekibi, aliraba ezzadde,","poem":1},{"text":"era obulamu bwe bulyongerwako, n’ebyo Mukama by’asiima biriraba omukisa mu mukono gwe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Oluvannyuma lw’okubonaabona kw’obulamu bwe,","poem":1},{"text":"bw’aliraba ku ebyo ebiva mu kubonaabona kwe, omutima gwe gulitereera.","poem":2},{"text":"Era olw’ebyo bye yayitamu omuweereza wange omutuukirivu alireetera bangi okubalirwa obutuukirivu;","poem":1},{"text":"era alyetikka obutali butuukirivu bwabwe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kyendiva mmuwa ekifo eky’ekitiibwa mu bangi,","poem":1},{"text":"era aligabira bangi omunyago","poem":2},{"text":"kubanga yafuka obulamu bwe okutuusa okufa,","poem":1},{"text":"n’abalirwa wamu n’abakozi b’ebibi.","poem":2},{"text":"Era yeetikka ebibi by’abangi","poem":1},{"text":"era ne yeegayiririra abakozi b’ebibi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}