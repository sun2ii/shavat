{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":54,"content":[{"type":"heading","content":["Ekitiibwa Kya Sayuuni eky’Oluvannyuma"]},{"type":"verse","number":1,"content":[{"text":"“Yimba ggwe omugumba","poem":1},{"text":"atazaalanga;","poem":2},{"text":"tandika okuyimbira mu ddoboozi ery’omwanguka osanyukire ddala","poem":1},{"text":"ggwe atalumwanga kuzaala.","poem":2},{"text":"Kubanga ggwe eyalekebwa","poem":1},{"text":"ojja kuba n’abaana bangi okusinga oyo akyalina bba,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Gaziya weema yo, owanvuye emiguwa gyayo,","poem":1},{"lineBreak":true},{"text":"tokwata mpola;","poem":1},{"text":"nyweza enkondo zo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kubanga olisaasaanira","poem":1},{"text":"ku mukono gwo ogwa ddyo","poem":2},{"lineBreak":true},{"text":"era n’ogwa kkono,","poem":2},{"text":"n’ezzadde lyo lirirya amawanga,","poem":1},{"text":"era abantu bo balituula mu bibuga ebyalekebwa awo ebyereere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Totya kubanga toliddayo kukwatibwa nsonyi.","poem":1},{"text":"Toggwaamu maanyi kubanga togenda kuswazibwa.","poem":2},{"text":"Olyerabira ensonyi z’obuvubuka bwo,","poem":1},{"text":"n’ekivume ky’obwannamwandu bwo tolikijjukira nate.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kubanga Omutonzi wo ye balo,","poem":1},{"text":"Mukama Katonda ow’Eggye lye linnya lye.","poem":2},{"text":"Omutukuvu wa Isirayiri ye Mununuzi wo,","poem":1},{"text":"Katonda ow’ensi yonna, bw’ayitibwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kubanga Mukama Katonda yakuyita okomewo,","poem":1},{"text":"ng’omukazi eyali alekeddwawo ng’alina ennaku ku mutima;","poem":2},{"text":"omukazi eyafumbirwa ng’akyali muto, n’alekebwawo,”","poem":1},{"text":"bw’ayogera Katonda wo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Nakulekako akaseera katono nnyo;","poem":1},{"text":"naye ndikukuŋŋaanya n’okusaasira okungi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Obusungu obubuubuuka bwe bwankwata","poem":1},{"text":"nakweka amaaso gange okumala ekiseera,","poem":2},{"text":"naye ndikukwatirwa ekisa n’okwagala okutaliggwaawo,”","poem":1},{"text":"bw’ayogera Mukama Katonda,","poem":2},{"lineBreak":true},{"text":"Omununuzi wo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Kubanga gye ndi,","poem":1},{"text":"bino biri nga bwe byali mu biseera bya Nuuwa.","poem":2},{"text":"Nga bwe nalayira nti amazzi ga Nuuwa tegagenda kuddamu kulabikako ku nsi,","poem":1},{"text":"bwe ntyo ndayira nti siriddayo kukusunguwalira wadde okukunenya.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kubanga ensozi ziyinza okuvaawo n’obusozi okuggyibwawo","poem":1},{"text":"naye okwagala kwange okutaggwaawo tekulisagaasagana","poem":2},{"text":"so n’endagaano yange ey’emirembe","poem":1},{"text":"teriggyibwawo,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda akusaasira.","poem":2}]},{"type":"heading","content":["Yerusaalemi eky’Ebiro Ebijja"]},{"type":"verse","number":11,"content":[{"text":"Mukama agamba nti,","poem":1},{"text":"“Ggwe Yerusaalemi ekibuga ekibonyaabonyezebwa, ekisuukundibwa emiyaga awatali kulaba ku mirembe;","poem":2},{"lineBreak":true},{"text":"laba ndikuzimba buto n’amayinja ag’amabala amalungi,","poem":2},{"lineBreak":true},{"text":"emisingi gyo ne gizimbibwa ne safiro.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ebitikkiro byo ndibikola n’amayinja amatwakaavu,","poem":1},{"text":"n’emiryango gyo ne ngikola ne kabunkulo,","poem":2},{"lineBreak":true},{"text":"ne bbugwe yenna ne mwetoolooza amayinja ag’omuwendo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"N’abaana bo bonna baliyigirizibwa Mukama;","poem":1},{"text":"n’emirembe gy’abaana bo giriba mingi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Olinywezebwa mu butuukirivu","poem":1},{"text":"era toojoogebwenga,","poem":2},{"text":"kubanga tolitya,","poem":1},{"text":"onoobanga wala n’entiisa kubanga terikusemberera.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Omuntu yenna bwakulumbanga kiriba tekivudde gye ndi.","poem":1},{"text":"Buli anaakulumbanga anaawangulwanga ku lulwo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Laba nze natonda omuweesi,","poem":1},{"text":"awujja amanda agaliko omuliro","poem":2},{"lineBreak":true},{"text":"n’aweesa ekyokulwanyisa olw’omugaso gwakyo.","poem":2},{"text":"Era nze natonda abazikiriza abakozesa ekyokulwanyisa okumalawo obulamu.","poem":1}]},{"type":"verse","number":17,"content":[{"text":"Naye teri kyakulwanyisa kye baliweesa ekirikwolekera ne kikusobola,","poem":2},{"lineBreak":true},{"text":"era oliwangula buli lulimi olulikuvunaana era oluwoza naawe.","poem":2},{"text":"Guno gwe mugabo gw’abaddu ba Mukama,","poem":1},{"text":"n’obutuukirivu bwabwe obuva gye ndi,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}