{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":55,"content":[{"type":"heading","content":["Abalumwa Ennyonta Bayitibwa"]},{"type":"verse","number":1,"content":[{"text":"“Kale mujje,","poem":1},{"text":"mmwe mwenna abalumwa ennyonta, mujje eri amazzi.","poem":2},{"text":"Mujje mmwe abatalina ssente zigula,","poem":1},{"text":"mujje muweebwe bye mwagala,","poem":2},{"text":"envinnyo oba amata ebitali bya kugula","poem":1},{"text":"ebitaliiko miwendo gya kusasula.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lwaki musaasaanya ensimbi zammwe ku ebyo ebitali bya kulya","poem":1},{"text":"muteganira ebyo ebitakkusa?","poem":2},{"text":"Mumpulirize, mumpulirize n’obwegendereza mulye ebyo ebirungi,","poem":1},{"text":"emmeeme yammwe eneesanyuka nnyo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mumpulirize mujje gye ndi.","poem":1},{"text":"Muwulirize mubeere balamu;","poem":2},{"text":"nnaabakolera endagaano ey’olubeerera,","poem":1},{"text":"era egyo gy’emikisa gyange n’okwagala bye nasuubiza Dawudi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Laba namufuula omujulirwa eri abantu,","poem":1},{"text":"omukulembeze era omugabe w’abantu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Laba oliyita amawanga g’otomanyi,","poem":1},{"text":"era amawanga g’otomanyi galyanguwa okujja gy’oli.","poem":2},{"text":"Kiribaawo olw’obuyinza bwa Mukama Katonda wo","poem":1},{"text":"era Omutukuvu wa Isirayiri","poem":2},{"lineBreak":true},{"text":"kubanga akugulumizza.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Munoonye Mukama nga bw’akyayinzika okulabika,","poem":1},{"text":"mumukaabirire nga bw’akyali okumpi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Omubi aleke ekkubo lye,","poem":1},{"text":"n’atali mutuukirivu aleke ebirowoozo bye.","poem":2},{"text":"Leka adde eri Mukama naye anaamusaasira, adde eri Katonda waffe","poem":1},{"text":"kubanga anaamusonyiyira ddala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Kubanga ebirowoozo byange si birowoozo byammwe","poem":1},{"text":"era n’amakubo gammwe si ge makubo gange,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Ng’eggulu bwe liri waggulu okukira n’ensi,","poem":1},{"text":"bwe gatyo amakubo gange bwe gali ewala ennyo n’amakubo gammwe,","poem":2},{"lineBreak":true},{"text":"n’ebirowoozo byange bwe biri eri ebirowoozo byammwe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Era ng’enkuba bwetonnya","poem":1},{"text":"n’omuzira ne gugwa okuva mu ggulu","poem":2},{"text":"n’ebitaddayo,","poem":1},{"text":"wabula ne bifukirira ettaka, ebirime ne bikula,","poem":2},{"text":"ne bimerusa ensigo z’omusizi,","poem":1},{"text":"era ne biwa omuli emmere,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"bwe kityo ekigambo kyange ekiva mu kamwa kange bwe kiri;","poem":1},{"text":"tekiriddayo bwereere,","poem":2},{"text":"naye kirikola ekyo kye njagala","poem":1},{"text":"era kirituukiriza ekyo kye nakituma.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kubanga mulifuluma n’essanyu","poem":1},{"text":"ne mugenda mirembe,","poem":2},{"text":"ensozi n’obusozi nabyo","poem":1},{"text":"ne bitandika okuyimba nga bibalabye,","poem":2},{"text":"n’emiti gyonna","poem":1},{"text":"ne gitendereza n’essanyu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mu kifo ky’omweramannyo mulimeramu olusambya,","poem":1},{"text":"ne mu kifo ky’omutovu mulimeramu omumwanyi.","poem":2},{"text":"Era kino kiribaawo erinnya lya Mukama limanyibwe","poem":1},{"text":"era ako ke kaliba akabonero akataliggwaawo","poem":2},{"lineBreak":true},{"text":"ak’emirembe n’emirembe.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}