{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":56,"content":[{"type":"heading","content":["Abantu ba Katonda Baliva mu Mawanga Gonna"]},{"type":"verse","number":1,"content":["Bw’ati bw’ayogera Mukama nti,",{"text":"“Mukolenga obwenkanya era ebituufu,","poem":1},{"text":"kubanga obulokozi bwange bunaatera okujja,","poem":2},{"text":"n’obutuukirivu bwange","poem":1},{"text":"bunatera okubikkulibwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Alina omukisa omuntu akola ekyo,","poem":1},{"text":"n’omwana w’omuntu akinyweererako.","poem":2},{"text":"Akwata ssabbiiti obutagyonoona,","poem":1},{"text":"n’akuuma omukono gwe obutakola kibi na kimu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Era ne munnaggwanga eyeegatta ku Mukama tayogeranga nti,","poem":1},{"text":"“Mukama, oboolyawo alinjawula ku bantu be,”","poem":2},{"text":"so n’omulaawe okugamba nti,","poem":1},{"text":"“Ndi muti mukalu.”","poem":2}]},{"type":"verse","number":4,"content":["Kubanga bw’atyo bw’ayogera Mukama nti,",{"text":"“Eri abalaawe abakwata ssabbiiti zange","poem":1},{"text":"ne basalawo okugoberera ebyo ebinsanyusa,","poem":2},{"lineBreak":true},{"text":"ne bakuuma endagaano yange,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"amannya gaabwe galijjukirwa","poem":1},{"text":"mu yeekaalu yange mu bisenge byamu, ng’ekijjukizo","poem":2},{"lineBreak":true},{"text":"n’okusinga bwe mwandibadde n’abaana aboobulenzi n’aboobuwala.","poem":2},{"text":"Ndibawa erinnya eritaliggwaawo","poem":1},{"text":"ery’emirembe n’emirembe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"N’abo bannaggwanga abasalawo okwegatta ku Mukama,","poem":1},{"text":"okumuweereza era n’okwagala erinnya lya Mukama","poem":2},{"text":"era n’okubeera abaweereza be,","poem":1},{"text":"abakwata ssabbiiti","poem":2},{"text":"ne batagyonoona","poem":1},{"text":"era ne banyweza endagaano yange,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"bano ndibaleeta ku lusozi lwange olutukuvu","poem":1},{"text":"era ne mbawa essanyu mu nnyumba yange ey’okusabiramu.","poem":2},{"text":"Ebiweebwayo byabwe ebyokebwa ne ssaddaaka zaabwe","poem":1},{"text":"birikkirizibwa ku kyoto kyange.","poem":2},{"text":"Kubanga ennyumba yange eriyitibwa nnyumba ya kusabiramu","poem":1},{"text":"eri amawanga gonna.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bw’ati bw’ayogera Mukama Ayinzabyonna,","poem":1},{"text":"akuŋŋaanya Abayisirayiri abaawaŋŋangusibwa nti,","poem":2},{"text":"“Ndikuŋŋaanyaayo abantu abalala","poem":1},{"text":"ng’oggyeko abantu bange aba Isirayiri be nkuŋŋaanyizza.”","poem":2}]},{"type":"heading","content":["Katonda Alumiriza Abakulembeze ba Isirayiri Ebibi byabwe"]},{"type":"verse","number":9,"content":[{"text":"Mukama agamba amawanga amalala okujja","poem":1},{"text":"ng’ensolo ez’omu nsiko, galye abantu be.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kubanga abakulembeze ba Isirayiri bazibe ba maaso,","poem":1},{"text":"bonna tebalina magezi,","poem":2},{"text":"bonna mbwa","poem":1},{"text":"ezitasobola kuboggola,","poem":2},{"text":"zibeera mu kuloota nakugalaamirira","poem":1},{"text":"ezaagala okwebaka obwebasi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Embwa ezirina omululu omuyitirivu","poem":1},{"text":"ezitakkuta.","poem":2},{"text":"Basumba abatayinza kutegeera,","poem":1},{"text":"bonna abakyamye mu makubo gaabwe;","poem":2},{"lineBreak":true},{"text":"buli muntu ng’afa ku kwenoonyeza ky’anaalya.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bagambagana nti,","poem":1},{"text":"“Mujje, leka tukime omwenge tunywe tutamiire.","poem":2},{"text":"N’olw’enkya lunaku ng’olwa leero,","poem":1},{"text":"oba n’okusingawo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}