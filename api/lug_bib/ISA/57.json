{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":57,"content":[{"type":"verse","number":1,"content":[{"text":"Abantu abatuukirivu bazikirira,","poem":1},{"text":"naye tewali akirowoozako n’akatono.","poem":2},{"text":"Abantu abeewaddeyo eri Katonda","poem":1},{"text":"batwalibwa nga tewali n’afuddeyo kukirowoozaako.","poem":2},{"text":"Kubanga omutuukirivu aggyibwawo","poem":1},{"text":"olw’akabi akagenda okujja.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ayingira mu mirembe","poem":1},{"text":"n’afuna okuwummulira mu kufa kwe,","poem":2},{"lineBreak":true},{"text":"ne bawummula ga beebase, abo abatambulira mu bugolokofu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Naye mmwe mujje musembere wano batabani b’omukazi omufumu","poem":1},{"text":"ezzadde ly’omwenzi omukazi eyeetunda.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Muzannyira ku ani?","poem":1},{"text":"Ani gwe mukongoola","poem":2},{"lineBreak":true},{"text":"ne mumusoomooza?","poem":2},{"text":"Temuli baana ba bujeemu,","poem":1},{"text":"ezzadde eryobulimba?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mwaka ne mwegombera wansi w’emiti","poem":1},{"text":"na buli wansi wa buli muti oguyimiridde;","poem":2},{"text":"mmwe abasaddaaka abaana bammwe mu biwonvu","poem":1},{"text":"ne wansi w’enjatika z’enjazi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bakatonda bo ge mayinja amaweweevu","poem":1},{"noteId":30},{"text":"gosinziza mu biwonvu,","poem":1},{"text":"abo be babo, obusika bwo;","poem":2},{"text":"abo b’ofukira ekiweebwayo ekyokunywa","poem":1},{"text":"era n’ebiweebwayo eby’empeke.","poem":2},{"lineBreak":true},{"text":"Nga weemalidde mu kukola bino byonna, olowooza nnyinza okusanyuka?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mwambuka ku ntikko z’ensozi okwenda","poem":1},{"text":"nga mugenze okuwaayo ssaddaaka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Emabega w’enzigi zammwe","poem":1},{"text":"we muteeka ebibumbe eby’obuwemu bye musinza.","poem":2},{"text":"Mwandeka ne mukola eby’obuwemu","poem":1},{"text":"mu bitanda byammwe ebigazi.","poem":2},{"text":"Eyo gye mweyambulira ne mukola endagaano","poem":1},{"text":"n’abo be mwagala be muleeta mu bitanda byammwe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne weekuba kalifuuwa omuyitirivu","poem":1},{"text":"ng’ogenda okutwala amafuta ag’omuzeeyituuni ewa Moleki katonda wo,","poem":2},{"text":"n’otuma ababaka bo ewala ennyo banoonye bakatonda,","poem":1},{"text":"kumpi batuuke n’emagombe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Amakubo go gonna gakuteganya ne gakukooya nnyo","poem":1},{"text":"naye teweegamba nako nti,","poem":2},{"text":"‘Nteganira ki atalina kyeŋŋanyurwa?’","poem":1},{"text":"Singa tewanoonya bikuzaamu maanyi, wandizirise.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“B’ani abo be watya n’otekemuka n’obawuliriza,","poem":1},{"text":"n’olyoka olimba,","poem":2},{"text":"nze n’otonzijukira n’akatono","poem":1},{"text":"wadde okundowoozaako?","poem":2},{"text":"Olw’okubanga nsirise n’esikunyega","poem":1},{"text":"ky’ekikuyinudde n’onneerabira n’ompisaamu amaaso.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nnaayolesa obutuukirivu bwo ne by’okola,","poem":1},{"text":"naye tebigenda kukugasa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bw’okaabanga nga weetaaga obuyambi,","poem":1},{"text":"leka bakatonda bo be wakuŋŋaanya bakununule;","poem":2},{"text":"naye empewo eribatwala,","poem":1},{"text":"omukka obukka abantu gwe bassa gulibaggirawo ddala bonna.","poem":2},{"text":"Naye oyo anfuula ekiddukiro kye","poem":1},{"text":"alirya ensi","poem":2},{"lineBreak":true},{"text":"era alitwala olusozi lwange olutukuvu.”","poem":2}]},{"type":"heading","content":["Ekisa eri Abeenenya"]},{"type":"verse","number":14,"content":["Era kiryogerwa nti,",{"text":"“Muzimbe, muzimbe, mulongoose ekkubo!","poem":1},{"text":"Muggyeewo enkonge zonna mu kkubo ly’abantu bange.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kubanga bw’atyo bw’ayogera oyo ali waggulu","poem":1},{"text":"omugulumivu omulamu emirembe n’emirembe,","poem":2},{"text":"ow’erinnya ettukuvu nti,","poem":1},{"text":"“Ntuula mu kifo ekigulumivu ekitukuvu","poem":2},{"text":"awamu n’oyo alina omwoyo oguboneredde ogwetoowaza,","poem":1},{"text":"okuzzaamu amaanyi","poem":2},{"text":"omwoyo gw’abakkakkamu,","poem":1},{"text":"era n’ogw’abo ababoneredde.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kubanga sirirumiriza bantu bange emirembe n’emirembe","poem":1},{"text":"era siribasunguwalira bbanga lyonna.","poem":2},{"text":"Kubanga omutima gw’omuntu gwandigwereddewo mu maaso gange nga ndaba,","poem":1},{"text":"emmeeme y’omuntu nze gye nakola.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Olw’okwegomba kwe okw’obutali butuukirivu nnali nzijjudde obusungu.","poem":1},{"text":"Namubonereza ne nkweka amaaso gange olw’obusungu obungi","poem":2},{"lineBreak":true},{"text":"naye yeeyongera okugenda mu maaso mu makubo amabi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nalaba by’akola, naye ndimuwonya.","poem":1},{"text":"Ndimuluŋŋamya ne muddiza emirembe era ne mbeesabeesa abo abakungubaga.","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mirembe, era mirembe,","poem":2},{"text":"eri abo abali ewala n’eri abo abali okumpi,","poem":1},{"text":"era ndibawonya,” bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Naye ababi bali ng’ennyanja esiikuuse,","poem":1},{"text":"eteyinza kutereera,","poem":2},{"lineBreak":true},{"text":"ey’amayengo agasiikuula ebitosi n’ebitaka.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“Tewali mirembe, eri aboonoonyi,” bw’ayogera Katonda wange.","poem":1}]}],"footnotes":[{"noteId":30,"caller":"+","text":"Amayinja amaweweevu gaakozesebwanga mu kusinza balubaale","reference":{"chapter":57,"verse":6}}]},"thisChapterLink":"/api/lug_bib/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}