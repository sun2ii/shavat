{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":58,"content":[{"type":"heading","content":["Okusiiba okw’Amazima"]},{"type":"verse","number":1,"content":[{"text":"Kyogere mu ddoboozi ery’omwanguka,","poem":1},{"text":"tokisirikira.","poem":2},{"text":"Yimusa eddoboozi lyo ng’ekkondeere,","poem":1},{"noteId":31},{"text":"obuulire abantu bange okusobya kwabwe, n’ennyumba ya Yakobo ebibi byabwe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kubanga bannoonya buli lunaku","poem":1},{"text":"era beegomba okumanya amakubo gange,","poem":2},{"text":"nga bali ng’abantu abakola eby’obutuukirivu","poem":1},{"text":"so si abaaleka edda ebiragiro bya Katonda waabwe.","poem":2},{"text":"Bambuuza ensala ennuŋŋamu,","poem":1},{"text":"ne basanyukira Katonda okusembera gye bali.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Beebuuza nti, “Lwaki twasiiba, naye ggwe n’otokifaako?","poem":1},{"text":"Lwaki twetoowaza naye ggwe n’otokissaako mwoyo?”","poem":2},{"text":"Musooke mulabe,","poem":1},{"text":"ennaku ze musiiba","poem":2},{"text":"muba munoonya ssanyu lyammwe ku bwammwe,","poem":1},{"text":"musigala munyigiriza abakozi bammwe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Njagala mulabe.","poem":1},{"text":"Kalungi ki akali mu kusiiba ng’ate mugenda kudda mu nnyombo,","poem":2},{"text":"n’okukaayana n’okukuba bannammwe agakonde.","poem":1},{"text":"Temuyinza kusiiba nga bwe mukola kaakano eddoboozi lyammwe ne liwulirwa mu ggulu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Okusiiba kwe nalonda bwe kutyo bwe kufaanana?","poem":1},{"text":"Olunaku omuntu lw’eyetoowalizaako?","poem":2},{"text":"Kukutamya bukutamya mutwe,","poem":1},{"text":"kuguweta nga lumuli n’okugalamira mu bibukutu mu vvu?","poem":2},{"text":"Okwo kwe muyita okusiiba,","poem":1},{"text":"olunaku olusiimibwa Mukama?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kuno kwe kusiiba kwe nalonda;","poem":1},{"lineBreak":true},{"text":"okusumulula enjegere ezinyigiriza abantu,","poem":1},{"text":"n’okuggyawo emiguwa gy’ekikoligo,","poem":2},{"text":"n’okuta abo abanyigirizibwa,","poem":1},{"text":"n’okumenya buli kikoligo?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Si kugabira bayala ku mmere yo,","poem":1},{"text":"n’okusembeza abaavu abatalina maka mu nnyumba yo;","poem":2},{"text":"bw’olaba ali obwereere, n’omwambaza","poem":1},{"text":"n’otekweka baŋŋanda zo abeetaaga obuyambi bwo?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Awo omusana gwo gulyoke guveeyo","poem":1},{"text":"gwake ng’emmambya esala, era okuwonyezebwa kwo kujje mangu;","poem":2},{"text":"obutuukirivu bwo bukukulembere,","poem":1},{"text":"era ekitiibwa kya Katonda kikuveeko emabega.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Olwo olikoowoola, Mukama n’akuddamu;","poem":1},{"text":"olikaaba naye n’akuddamu nti, Ndi wano.","poem":2},{"lineBreak":true},{"text":"“Bwe muliggyawo ekikoligo ekinyigiriza","poem":1},{"text":"n’okusonga ennwe, n’okwogera n’ejjoogo;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"bw’olyewaayo okuyamba abayala","poem":1},{"text":"n’odduukirira abali mu buzibu,","poem":2},{"text":"olwo omusana gwo gulyaka n’ova mu kizikiza,","poem":1},{"text":"ekibadde ekiro kifuuke ettuntu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Era Mukama anaakuluŋŋamyanga ennaku zonna,","poem":1},{"text":"n’akuwa ebintu ebirungi obulamu bwo bye bwetaaga,","poem":2},{"lineBreak":true},{"text":"amagumba go aligongeramu amaanyi;","poem":2},{"text":"era olibeera ng’ennimiro enfukirire obulungi,","poem":1},{"text":"era ng’oluzzi olw’amazzi agatakalira.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"N’abantu bo balizimba ebifo eby’edda ebyazika","poem":1},{"text":"era baddemu okuzimba emisingi egy’edda.","poem":2},{"text":"Olyoke oyitibwe omuddaabiriza wa bbugwe eyamenyeka,","poem":1},{"text":"omuddaabiriza wa mayumba ag’okusulamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Bw’oneekuumanga obutayonoona Ssabbiiti,","poem":1},{"text":"obutakola nga bw’oyagala ku lunaku lwange olutukuvu,","poem":2},{"text":"bw’onooluyitanga olw’essanyu","poem":1},{"text":"era olunaku lwa Mukama olw’ekitiibwa,","poem":2},{"text":"singa muluwa ekitiibwa ne mutakwata makubo gammwe","poem":1},{"text":"oba obutakola nga bwe mwagala oba okwogera ebigambo eby’okubalaata,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"awo olifuna essanyu eriva eri Mukama","poem":1},{"text":"era olitambulira mu bifo by’ensi ebya waggulu","poem":2},{"lineBreak":true},{"text":"era ndikuwa obusika bwa kitaawo Yakobo”","poem":2},{"text":"Akamwa ka Mukama ke kakyogedde.","poem":1}]}],"footnotes":[{"noteId":31,"caller":"+","text":"Ekkondeere lyafuuyibwanga okukuŋŋaanya abaserikale beetegeke okulaga mu lutalo","reference":{"chapter":58,"verse":1}}]},"thisChapterLink":"/api/lug_bib/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/57.json","previousChapterAudioLinks":{},"numberOfVerses":14}