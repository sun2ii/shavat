{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":59,"content":[{"type":"heading","content":["Ekibi, Okwatula Ebibi, n’Okusonyiyibwa"]},{"type":"verse","number":1,"content":[{"text":"Mulabe, omukono gwa Mukama teguyimpawadde n’okuyinza ne gutayinza kulokola,","poem":1},{"text":"era si muzibe wa matu nti tawulira.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Naye obutali butuukirivu bwammwe","poem":1},{"text":"bwe bubaawudde ku Katonda wammwe.","poem":2},{"text":"Ebibi byammwe bye bimukwesezza amaaso ge,","poem":1},{"text":"n’atawulira.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kubanga emikono gyammwe gibunye omusaayi","poem":1},{"text":"n’engalo zammwe zibunye obutali butuukirivu,","poem":2},{"text":"emimwa gyammwe gyogedde eby’obulimba,","poem":1},{"text":"n’ennimi zammwe z’ogedde eby’ekko.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tewali awaaba bya nsonga","poem":1},{"text":"so tewali awoza mu mazima;","poem":2},{"text":"Beesiga ensonga ezitaliimu, ne boogera eby’obulimba,","poem":1},{"text":"ne baleeta emitawaana ne bazaala obulabe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Baalula amagi ag’essalambwa","poem":1},{"text":"ne balanga ewuzi za nnabbubi:","poem":2},{"text":"alya ku magi gaabwe afa","poem":1},{"text":"n’eryo eriba lyatise livaamu mbalasaasa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Naye enkwe zaabwe ze bakola tezibayamba,","poem":1},{"text":"ziri ng’engoye enkole mu wuzi za nnabbubi!","poem":2},{"text":"Tebasobola kuzeebikka.","poem":1},{"text":"Emirimu gyabwe mirimu gya kwonoona, n’ebikolwa byabwe bulabe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ebigere byabwe byanguyirira bikole ebibi","poem":1},{"text":"era bapapirira bayiwe omusaayi ogutalina musango.","poem":2},{"text":"Ebirowoozo byabwe birowoozo bya bubi,","poem":1},{"text":"n’okuzika n’okuzikiriza bye biba buli we bagenda.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ekkubo ery’emirembe tebalimanyi","poem":1},{"text":"wadde okukozesa obwenkanya mu makubo gaabwe.","poem":2},{"text":"Beekubidde amakubo,","poem":1},{"text":"tewali n’omu agayitamu afuna emirembe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Amazima gatuli wala,","poem":1},{"text":"n’obutuukirivu tetubufunye.","poem":2},{"text":"Tunoonyezza omusana naye ekizikiza kitwesibyeko,","poem":1},{"text":"we tusuubira obutangaavu, tutambulidde mu bisiikirize byereere.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tuwammantawammanta bbugwe ng’abazibe,","poem":1},{"text":"ne tukwatakwata ng’abatalina maaso;","poem":2},{"text":"twesittala mu ttuntu ng’ekiro mu abo abalina amaanyi","poem":1},{"text":"ne tuba ng’abafu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ffenna tuwuluguma ng’eddubu","poem":1},{"text":"ne tusinda nga bukaamukuukulu.","poem":2},{"text":"Tusuubira okuggyibwa mu kunyigirizibwa naye nga bwereere,","poem":1},{"text":"n’obulokozi butuliwala.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kubanga ebisobyo byaffe bingi mu maaso go","poem":1},{"text":"era ebibi byaffe bitulumiriza,","poem":2},{"text":"kubanga ebisobyo byaffe biri naffe,","poem":1},{"text":"era tumanyi obutali butuukirivu bwaffe;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"obujeemu n’enkwe eri Mukama","poem":1},{"text":"era n’okulekeraawo okugoberera Katonda waffe.","poem":2},{"text":"Okutegeka obwediimo n’okunyigiriza,","poem":1},{"text":"okwogera eby’obulimba n’emitima gyaffe bye girowoozezza.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Obwenkanya buddiridde","poem":1},{"text":"n’obutuukirivu ne bubeera wala.","poem":2},{"text":"Amazima geesitalidde mu luguudo, n’obwesimbu tebuyinza kuyingira.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tewali w’oyinza kusanga mazima,","poem":1},{"text":"era oyo ava ku kibi asuulibwa.","poem":2},{"lineBreak":true},{"text":"Mukama yakiraba n’atasanyuka","poem":1},{"text":"kubanga tewaali bwenkanya.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"N’alaba nga tewali muntu,","poem":1},{"text":"ne yennyamira nti tewali muntu ayinza kudduukirira.","poem":2},{"text":"Noolwekyo kwe kusalawo okukozesa omukono gwe ye kennyini","poem":1},{"text":"okuleeta obulokozi n’obutuukirivu bwe okuwangula.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yayambala obutuukirivu bwe ng’eky’omu kifuba,","poem":1},{"text":"era n’enkuufiira ey’obulokozi ku mutwe gwe;","poem":2},{"text":"n’ateekako ebyambalo by’okuwoolera eggwanga","poem":1},{"text":"era n’ayambala obunyiikivu ng’omunagiro.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ng’ebikolwa byabwe bwe biri","poem":1},{"text":"bwalisasula ekiruyi ku balabe be,","poem":2},{"text":"n’abamukyawa","poem":1},{"text":"alibawa empeera yaabwe,","poem":2},{"lineBreak":true},{"text":"n’abo abali ewala mu bizinga abasasule.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Noolwekyo balitya erinnya lya Mukama okuva ebugwanjuba,","poem":1},{"text":"n’ekitiibwa kye okuva ebuvanjuba,","poem":2},{"text":"kubanga alijja ng’omugga ogukulukuta n’amaanyi,","poem":1},{"text":"omukka gwa Mukama gwe gutwala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Era Omununuzi alijja mu Sayuuni,","poem":1},{"text":"eri abo abeenenya ebibi byabwe mu Yakobo,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":21,"content":["“Era, eno y’endagaano yange gye nkola nabo,” bw’ayogera Mukama. “Omwoyo wange ali ku ggwe era n’ebigambo byange bye ntadde mu kamwa ko, tebiivenga mu kamwa ko, oba mu kamwa k’abaana bo, wadde mu kamwa k’abaana b’abaana bo, okuva kaakano okutuusa emirembe n’emirembe,” bw’ayogera Mukama."]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/58.json","previousChapterAudioLinks":{},"numberOfVerses":21}