{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":60,"content":[{"type":"heading","content":["Ekitiibwa kya Sayuuni Ekijja"]},{"type":"verse","number":1,"content":[{"text":"“Yimuka, oyake, kubanga ekitangaala kyo kizze kyase","poem":1},{"text":"era ekitiibwa kya Mukama kikwakirako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kubanga laba ensi eribikkibwa ekizikiza","poem":1},{"text":"era n’ekizikiza ekikutte ennyo kibikke abantu baamawanga gonna,","poem":2},{"text":"naye ggwe Mukama alikwakirako","poem":1},{"text":"era ekitiibwa kye kikulabikeko.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Amawanga galijja eri omusana gwo","poem":1},{"text":"ne bakabaka eri okumasamasa okunaakubangako ng’ojja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Yimusa amaaso go olabe;","poem":1},{"text":"abantu bo bonna bakuŋŋaana okujja gy’oli","poem":2},{"text":"batabani bo abava ewala ne bawala bo","poem":1},{"text":"abasituliddwa mu mikono.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kino oli wakukirabako ojjule essanyu,","poem":1},{"text":"omutima gwo, gujjule okweyagala n’okujaguza.","poem":2},{"text":"Obugagga bw’amawanga bulyoke bukuleetebwe,","poem":1},{"text":"era n’ebirungi byonna eby’omu nnyanja birikweyuna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ebisibo by’eŋŋamira birijjula ensi yammwe,","poem":1},{"text":"eŋŋamira ento ez’e Midiyaani ne Efa.","poem":2},{"noteId":32},{"text":"Era ne zonna ez’e Seba zirijja nga zeetisse zaabu n’obubaane","poem":1},{"text":"okulangirira ettendo lya Katonda.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"N’ebisibo byonna eby’e Kedali birikukuŋŋanyizibwa,","poem":1},{"text":"endiga ennume ez’e Nebayoosi zirikuweereza.","poem":2},{"text":"Zirikkirizibwa ng’ekiweebwayo ku kyoto kyange","poem":1},{"text":"era ndyolesa ekitiibwa kyange mu yeekaalu yange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Bano baani abaseyeeya nga ebire,","poem":1},{"text":"ng’amayiba agadda mu bisu byago?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ddala ddala ebizinga bitunuulidde nze;","poem":1},{"text":"ebidyeri by’e Talusiisi bye bikulembedde","poem":2},{"text":"bireete batabani bammwe okubaggya ewala","poem":1},{"text":"awamu ne zaabu yaabwe ne ffeeza,","poem":2},{"text":"olw’ekitiibwa kya Mukama Katonda wammwe,","poem":1},{"text":"Omutukuvu wa Isirayiri,","poem":2},{"lineBreak":true},{"text":"kubanga akufudde ow’ekitiibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Abaana b’abamawanga amalala balizimba bbugwe wo,","poem":1},{"text":"era bakabaka baabwe bakuweereze;","poem":2},{"text":"Olw’obusungu bwange, nakukuba,","poem":1},{"text":"naye mu kusaasira kwange ndikukwatirwa ekisa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Emiryango gyo ginaabanga miggule bulijjo,","poem":1},{"text":"emisana n’ekiro tegiggalwenga,","poem":2},{"text":"abantu balyoke bakuleeterenga obugagga obw’amawanga gaabwe","poem":1},{"text":"nga bakulembeddwamu bakabaka baabwe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kubanga eggwanga oba obwakabaka ebitakuweereze byakuzikirira.","poem":1},{"text":"Ensi ezo zijja kuggweerawo ddala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Ekitiibwa kya Lebanooni kirikujjira,","poem":1},{"text":"emiti egy’ettendo egy’enfugo,","poem":2},{"text":"omuyovu ne namukago gireetebwe okutukuza ekifo eky’awatukuvu wange,","poem":1},{"text":"ekifo ebigere byange we biwummulira eky’ettendo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Batabani baabo abaakunyigirizanga balijja okukuvuunamira;","poem":1},{"text":"era bonna abaakusekereranga balivuunamira ku bigere byo.","poem":2},{"text":"Balikuyita kibuga kya Katonda,","poem":1},{"text":"Sayuuni ey’Omutukuvu wa Katonda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Wadde nga wali olekeddwa awo ng’okyayibbwa,","poem":1},{"text":"nga tewali n’omu akuyitamu,","poem":2},{"text":"ndikufuula ow’ettendo,","poem":1},{"text":"essanyu ery’emirembe gyonna.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Olinywa amata ag’amawanga.","poem":1},{"text":"Ku mabeere ga bakungu kw’onooyonkanga,","poem":2},{"text":"era olimanyira ddala nti,","poem":1},{"text":"Nze, nze Mukama,","poem":2},{"text":"nze Mulokozi wo era Omununuzi wo,","poem":1},{"text":"ow’Amaanyi owa Yakobo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mu kifo ky’ekikomo ndireeta zaabu,","poem":1},{"text":"mu kifo ky’ekyuma ndireeta effeeza,","poem":2},{"text":"mu kifo ky’omuti ndireeta kikomo,","poem":1},{"text":"ne mu kifo ky’amayinja ndeete ekyuma.","poem":2},{"text":"Emirembe gye girifuuka omufuzi wo","poem":1},{"text":"n’obutuukirivu ne buba omukulembeze wo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Okutabukatabuka tekuddeyo kuwulirwa mu nsi yo,","poem":1},{"text":"wadde okwonoona n’okuzikiriza munda mu nsalo zo.","poem":2},{"text":"Ebisenge byo olibiyita Bulokozi,","poem":1},{"text":"Era n’enzigi zo, Kutendereza.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Enjuba si yeenekumulisizanga emisana,","poem":1},{"text":"oba omwezi okukumulisizanga ekiro.","poem":2},{"text":"Kubanga Mukama y’anaabeeranga ekitangaala kyo eky’emirembe n’emirembe,","poem":1},{"text":"era Katonda wo y’anaabeeranga ekitiibwa kyo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Enjuba yo terigwa nate,","poem":1},{"text":"n’omwezi gwo tegulibula;","poem":2},{"text":"Mukama y’anaabeeranga ekitangaala kyo eky’emirembe n’emirembe","poem":1},{"text":"era ennaku zo ez’okukungubanga zikome.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Abantu bo babeere batuukirivu,","poem":1},{"text":"ensi ebeere yaabwe emirembe n’emirembe.","poem":2},{"text":"Ekisimbe kye nnesimbira;","poem":1},{"text":"omulimu gw’emikono gyange,","poem":2},{"lineBreak":true},{"text":"olw’okulaga ekitiibwa kyange.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Asembayo okuba owa wansi alyala n’aba lukumi,","poem":1},{"text":"n’asembayo obutono afuuke eggwanga ery’amaanyi.","poem":2},{"text":"Nze Mukama,","poem":1},{"text":"ndikyanguya mu biseera byakyo.”","poem":2}]}],"footnotes":[{"noteId":32,"caller":"+","text":"Midiyaani lyali ggwanga lya balunzi ba nsolo abaatambulatambulanga mu bukiikaddyo bw’obugwanjuba bwa Yoludaani. Efa ye yali mutabani wa Midiyaani","reference":{"chapter":60,"verse":6}}]},"thisChapterLink":"/api/lug_bib/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/59.json","previousChapterAudioLinks":{},"numberOfVerses":22}