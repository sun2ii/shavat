{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":61,"content":[{"type":"heading","content":["Amawulire Amalungi ag’Obulokozi"]},{"type":"verse","number":1,"content":[{"text":"Omwoyo wa Mukama Katonda ali ku nze,","poem":1},{"text":"kubanga Mukama anfuseeko amafuta okubuulira abaavu n’abali obubi ebigambo ebirungi,","poem":2},{"lineBreak":true},{"text":"antumye okuyimusa abalina emitima egimenyese.","poem":2},{"text":"Okulangirira eddembe eri abawambe,","poem":1},{"text":"n’abasibe bateebwe","poem":2},{"lineBreak":true},{"text":"bave mu makomera.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Okulangirira omwaka gwa Mukama","poem":1},{"text":"ogw’okulabiramu obulungi bwe;","poem":2},{"text":"olunaku lwa Mukama olw’okuwalanirako eggwanga","poem":1},{"text":"era n’okuzzaamu amaanyi abo bonna abakungubaga.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Okugabirira abo bonna abali mu Sayuuni abakungubaga,","poem":2},{"text":"okubawa engule ey’obubalagavu mu kifo ky’evvu,","poem":1},{"text":"n’amafuta ag’essanyu mu kifo ky’ennaku.","poem":2},{"text":"Ekyambalo ky’okutendereza","poem":1},{"text":"mu kifo ky’omwoyo w’okukeŋŋeentererwa","poem":2},{"text":"balyoke bayitibwe miti gy’abutuukirivu, ebisimbe bya Mukama,","poem":1},{"text":"balyoke baweebwe ekitiibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Baliddamu","poem":1},{"text":"bazimbe ebyali bizise,","poem":2},{"text":"balirongoosa ebibuga","poem":1},{"text":"ebyali byerabirwa edda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abaamawanga balibalundira ebisibo byammwe,","poem":1},{"text":"abagwira babakolere mu nnimiro zammwe ne mu nnimiro z’emizabbibu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Era muyitibwe bakabona ba Mukama,","poem":1},{"text":"abantu baliboogerako ng’abaweereza ba Mukama,","poem":2},{"text":"mulirya obugagga bw’amawanga,","poem":1},{"text":"era mu bugagga bwabwe mwe mulyenyumiririza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mu kifo ky’ensonyi,","poem":1},{"text":"abantu bange baliddizibwawo emirundi ebiri.","poem":2},{"text":"Mu kifo ky’okuswala","poem":1},{"text":"basanyuke olw’ebyo bye balifuna","poem":2},{"text":"era balifuna omugabo gwa mirundi ebiri,","poem":1},{"text":"essanyu lyabwe liribeerera emirembe gyonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Kubanga nze, Mukama, njagala obwenkanya,","poem":1},{"text":"nkyawa okunyaga era n’obutali butuukirivu.","poem":2},{"text":"Mu bwesigwa bwange ndibasasula","poem":1},{"text":"era nkole nabo endagaano ey’emirembe n’emirembe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"N’ezzadde lyabwe liritutumuka nnyo mu mawanga","poem":1},{"text":"n’abaana baabwe eri abantu.","poem":2},{"text":"Abo bonna abalibalaba balibamanya,","poem":1},{"text":"nti bantu Mukama be yawa omukisa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nsanyukira nnyo mu Mukama,","poem":1},{"text":"emmeeme yange esanyukira mu Katonda wange.","poem":2},{"text":"Kubanga annyambazizza ebyambalo eby’obulokozi","poem":1},{"text":"era n’anteekako n’omunagiro ogw’obutuukirivu,","poem":2},{"text":"ng’omugole omusajja bw’ayambala engule nga kabona,","poem":1},{"text":"ng’omugole omukazi bw’ayambala amayinja ge ag’omuwendo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kuba nga ettaka bwe livaamu ebimera,","poem":1},{"text":"era ng’ennimiro bwereetera ensigo okumeruka,","poem":2},{"text":"bw’atyo Mukama Katonda bwalireeta obutuukirivu n’ettendo okumeruka,","poem":1},{"text":"ensi zonna zikirabe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}