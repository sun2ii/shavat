{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":62,"content":[{"type":"heading","content":["Erinnya lya Sayuuni Eriggya"]},{"type":"verse","number":1,"content":[{"text":"Ku lwa Sayuuni ssiisirike,","poem":1},{"text":"era ku lwa Yerusaalemi ssiiwummule,","poem":2},{"text":"okutuusa nga obutuukirivu bwe butemagana ng’emmambya esala,","poem":1},{"text":"obulokozi bwe ng’ettaala eyaka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amawanga galiraba obutuukirivu bwo,","poem":1},{"text":"era ne bakabaka bonna baliraba ekitiibwa kyo.","poem":2},{"text":"Oliyitibwa erinnya epya","poem":1},{"text":"akamwa ka Mukama lye kalikuwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Olibeera ngule etemagana mu mikono gya Mukama,","poem":1},{"text":"enkuufiira y’obwakabaka mu mukono gwa Katonda wo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ataliddayo kuyitibwa nti, Eyalekebwa,","poem":1},{"text":"ensi yo teriddamu kuyitibwa nti, Yazika.","poem":2},{"text":"Naye oliyitibwa nti, Gwe nsanyukira,","poem":1},{"text":"n’ensi yo eyitibwe nti, Eyafumbirwa.","poem":2},{"text":"Kubanga Mukama akusanyukira","poem":1},{"text":"era ensi yo eribeera ng’omukazi afumbiddwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kubanga ng’omuvubuka bwawasa omuwala omuto","poem":1},{"text":"bw’atyo eyakutonda bwalikulabirira.","poem":2},{"text":"Nga omugole omusajja bwasanyukira oyo gw’awasizza,","poem":1},{"text":"bw’atyo Katonda bwalikusanyukira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ntadde abakuumi ku bbugwe wo,","poem":1},{"text":"ggwe Yerusaalemi abataasirike emisana n’ekiro.","poem":2},{"text":"Mmwe abakoowoola Mukama","poem":1},{"text":"temuwummula.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Era temumuganya kuwummula okutuusa nga azimbye Yerusaalemi","poem":1},{"text":"era ng’agifudde ettendo mu nsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mukama yalayira n’omukono gwe ogwa ddyo","poem":1},{"text":"era n’omukono gwe ogw’amaanyi:","poem":2},{"text":"“Siriddayo nate kuwaayo ŋŋaano yo kubeera mmere y’abalabe bo,","poem":1},{"text":"era bannaggwanga tebaddeyo kunywa nvinnyo yo gy’otawaanidde.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Naye abo abagikungula be baligirya","poem":1},{"text":"ne batendereza Mukama,","poem":2},{"text":"n’abo abanoga emizabbibu","poem":1},{"text":"be baliginywera mu mpya z’omu watukuvu wange.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Muyiteemu, muyite mu miryango mugende!","poem":1},{"lineBreak":true},{"text":"Muzimbe oluguudo,","poem":1},{"text":"mulugyemu amayinja.","poem":2},{"text":"Muyimusize amawanga ebbendera.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Laba Mukama alangiridde","poem":1},{"text":"eyo yonna ensi gy’ekoma,","poem":2},{"text":"nti, “Gamba omuwala wa Sayuuni nti,","poem":1},{"text":"‘Laba omulokozi wo ajja,","poem":2},{"text":"Laba aleeta n’ebirabo bingi,","poem":1},{"text":"n’abantu b’anunudde bamukulembedde.’ ”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Era baliyitibwa Abantu Abatukuvu,","poem":1},{"text":"Abanunule ba Mukama,","poem":2},{"text":"ne Yerusaalemi kiyitibwe, Ekibuga Mukama ky’ayagala,","poem":1},{"text":"Ekibuga Ekitakyali ttayo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}