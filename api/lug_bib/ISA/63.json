{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":63,"content":[{"type":"heading","content":["Katonda lw’Aliwoolera Eggwanga n’Okununula Abantu be"]},{"type":"verse","number":1,"content":[{"text":"Ani ono ava mu Edomu mu kibuga Bozula","poem":1},{"text":"anekaanekanye mu ngoye emyufu.","poem":2},{"text":"Ani ono ali mu ngoye za bakabaka","poem":1},{"text":"akumba mu bukulu bw’ekitiibwa kye?","poem":2},{"lineBreak":true},{"text":"“Ye nze alangirira obutuukirivu,","poem":1},{"text":"ow’amaanyi okulokola.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Lwaki oyambadde ebyambalo ebimyufu","poem":1},{"text":"ng’eby’omusogozi w’omu ssogolero lya wayini?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Nva kulinnyirira amawanga nga emizabbibu,","poem":1},{"text":"tewali n’omu yajja kunnyambako.","poem":2},{"text":"Nabalinnyiririra mu busungu","poem":1},{"text":"era omusaayi gwabwe","poem":2},{"text":"ne gusammukira ku ngoye zange,","poem":1},{"text":"era guyiise ku byambalo byange.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kubanga olunaku olw’okununula abantu bange lwali lutuuse,","poem":1},{"text":"olunaku olw’okuwoolera eggwanga abalabe baabwe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Natunula naye nga tewali n’omu ayinza kunnyamba,","poem":1},{"text":"newuunya okulaba nga tewaali n’omu ayinza kunkwatirako.","poem":2},{"text":"Kale omukono gwange ne gundeetera obuwanguzi,","poem":1},{"text":"era obusungu bwange ne bunnyweza.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mu busungu bwange nalinnyirira abantu,","poem":1},{"text":"mu kiruyi kyange ne mbatamiiza,","poem":2},{"lineBreak":true},{"text":"omusaayi gwabwe ne nguyiwa ku ttaka.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ndibuulira ku bulungi bwa Mukama,","poem":1},{"text":"ebikolwa ebyamugwanyisa okutenderezebwa,","poem":2},{"lineBreak":true},{"text":"okusinziira ku byonna Mukama by’atukoledde;","poem":2},{"text":"weewaawo ebirungi ebingi by’akoledde ennyumba ya Isirayiri,","poem":1},{"text":"okusinziira ku kisa kye,","poem":2},{"lineBreak":true},{"text":"okusinziira ku bungi bw’okwagala kwe okutajjulukuka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yagamba nti, “Ddala bantu bange,","poem":1},{"text":"abaana aboobulenzi abatannimbelimbe,”","poem":2},{"lineBreak":true},{"text":"era bw’atyo n’afuuka omulokozi waabwe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yabonaabonera wamu nabo mu kubonaabona kwabwe kwonna,","poem":1},{"text":"era malayika ayimirira mu maaso ge n’abawonya.","poem":2},{"text":"Mu kwagala kwe n’ekisa kye yabanunula;","poem":1},{"text":"yabayimusa","poem":2},{"lineBreak":true},{"text":"n’abeetikka mu nnaku zonna ez’edda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Naye baajeema","poem":1},{"text":"ne banyiiza Mwoyo Mutukuvu,","poem":2},{"text":"kyeyava abakyukira n’afuuka omulabe waabwe","poem":1},{"text":"era ye kennyini n’abalwanyisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ne balyoka bajjukira ennaku ez’edda,","poem":1},{"text":"ennaku ez’edda eza Musa n’abantu be;","poem":2},{"text":"aluwa oyo eyabayisa mu nnyanja n’omulunzi w’ekisibo kye.","poem":1},{"text":"Aluwa oyo eyateeka Mwoyo Mutukuvu wakati mu bo","poem":2}]},{"type":"verse","number":12,"content":[{"text":"eyatuma omukono gwe ogw’ekitiibwa","poem":1},{"text":"ogw’amaanyi okubeera ku mukono gwa Musa ogwa ddyo,","poem":2},{"text":"eyayawulamu amazzi nga balaba,","poem":1},{"text":"yeekolere erinnya ery’emirembe n’emirembe?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani eyabakulembera n’abayisa mu buziba?","poem":1},{"text":"Ng’embalaasi mu nsi eyeetadde enjereere tebeesittala.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ng’ente ezigenda mu nsi eyeetadde,","poem":1},{"text":"Omwoyo wa Mukama yabawummuza.","poem":2},{"text":"Bw’otyo bwe wakulembera abantu bo","poem":1},{"text":"okwekolera erinnya ery’ettendo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tunula wansi ng’oli waggulu mu ggulu olabe,","poem":1},{"text":"ng’oli ku ntebe yo ey’ekitiibwa egulumidde entukuvu.","poem":2},{"text":"Obunyiikivu bwo n’ebikolwa byo eby’amaanyi biri ludda wa?","poem":1},{"text":"Obulungi bwo n’ekisa bitukwekeddwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ggwe Kitaffe,","poem":1},{"text":"wadde nga Ibulayimu tatumanyi","poem":2},{"lineBreak":true},{"text":"era nga Isirayiri tatutegeera,","poem":2},{"text":"Ayi Mukama Katonda, ggwe Kitaffe Omununuzi waffe","poem":1},{"text":"okuva edda n’edda lye linnya lyo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ayi Mukama Katonda, lwaki otuleka ne tuva ku makubo go,","poem":1},{"text":"n’okakanyaza omutima gwaffe, ne tutakutya?","poem":2},{"text":"Komawo olw’obulungi bw’abaddu bo","poem":1},{"text":"amawanga g’omugabo gwo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Abantu bo abatukuvu baali mu kifo kyo ekitukuvu akaseera katono,","poem":1},{"text":"naye kaakano abalabe baffe bakirinnyiridde.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ffe tuli bantu bo okuva edda n’edda;","poem":1},{"text":"naye bo tobafuganga,","poem":2},{"lineBreak":true},{"text":"tebayitibwanga linnya lyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/62.json","previousChapterAudioLinks":{},"numberOfVerses":19}