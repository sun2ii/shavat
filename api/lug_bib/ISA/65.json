{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":65,"content":[{"type":"heading","content":["Omusango n’Obulokozi"]},{"type":"verse","number":1,"content":[{"text":"Mukama n’alyoka agamba nti,","poem":1},{"text":"“Nze nnali mwetegefu okweyoleka eri abo abaali tebannoonya.","poem":2},{"text":"Neeraga abo abaali tebannoonya.","poem":1},{"text":"Eri eggwanga eryali litakoowoola linnya lyange nneyoleka gye bali ng’aŋŋamba nti, ‘Ndi wano, Ndi wano.’","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nagolola emikono gyange olunaku lwonna okutuusa obudde okuziba","poem":1},{"text":"eri abantu abeewagguzze,","poem":2},{"text":"abatambulira mu makubo amabi","poem":1},{"text":"abagoberera entegeka ezaabwe ku bwabwe;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"abantu bulijjo","poem":1},{"text":"abansomooza mu maaso gange gennyini","poem":2},{"text":"nga bawaayo ebiweebwayo mu nnimiro","poem":1},{"text":"ne bookera n’ebiweebwayo ku byoto eby’amatoffaali;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"abatuula mu malaalo","poem":1},{"text":"ne bamalako ekiro kyonna mu bifo ebyekusifu,","poem":2},{"text":"abalya ennyama y’embizzi,","poem":1},{"text":"era n’amaseffuliya gaabwe gajjudde ennyama etali nnongoofu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bagamba nti, ‘Beera wala, tojja kumpi nange,","poem":1},{"text":"kubanga ndi mutuukirivu nnyo ggwe okunsaanira!’","poem":2},{"text":"Abantu bwe batyo mukka mu nnyindo zange,","poem":1},{"text":"omuliro ogwaka olunaku lwonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Laba kiwandiikiddwa mu maaso gange.","poem":1},{"text":"Sijja kusirika naye nzija kusasula mu bujjuvu,","poem":2},{"lineBreak":true},{"text":"nzija kubasasula bibatuukireko ddala;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"olw’ebibi byammwe byonna era n’olw’ebibi bya bakitammwe,”","poem":1},{"text":"bw’ayogera Mukama Katonda.","poem":2},{"text":"“Kubanga baayokera ebiweebwayo byabwe ku lusozi","poem":1},{"text":"era ne bannyoomera ku busozi,","poem":2},{"text":"ndibalira mu mikono gyabwe empeera yennyini enzijuvu","poem":1},{"text":"ey’ebikolwa byabwe eby’edda.”","poem":2}]},{"type":"verse","number":8,"content":["Bw’atyo bw’ayogera Mukama:",{"text":"“Ng’omubisi bwe gusangibwa mu kirimba ky’emizabbibu","poem":1},{"text":"abantu ne bagamba nti, ‘Togwonoona,","poem":2},{"lineBreak":true},{"text":"gukyalimu akalungi,’","poem":2},{"text":"bwe ntyo bwe ndikibakolera olw’obulungi bw’abaweereza bange.","poem":1},{"text":"Sijja kubasaanyaawo bonna.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndiggya ezzadde okuva mu Yakobo","poem":1},{"text":"era ne mu Yuda abo abalitwala ensozi zange;","poem":2},{"text":"abantu bange abalonde balizigabana,","poem":1},{"text":"era eyo abaweereza bange gye balibeera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Awo Saloni kiribeera ddundiro lya bisibo,","poem":1},{"text":"era n’ekiwonvu kya Akoli kifo kya nte we zigalamira","poem":2},{"lineBreak":true},{"text":"olw’abantu bange abannoonya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Naye mmwe abava ku Mukama","poem":1},{"text":"ne mwerabira olusozi lwange olutukuvu","poem":2},{"text":"ne muteekerateekera emmeeza katonda wammwe, Mukisa,","poem":1},{"text":"ne mujuliza katonda wammwe, Kusalawo, ebikopo eby’envinnyo,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ndibawaayo eri ekitala","poem":1},{"text":"era mwenna mukutaamirire musalibwe,","poem":2},{"text":"kubanga nabayita naye temwayitaba,","poem":1},{"text":"nayogera naye temwampuliriza.","poem":2},{"text":"Mwakola ebitasaana","poem":1},{"text":"era ne musalawo okukola ebitansanyusa.”","poem":2}]},{"type":"verse","number":13,"content":["Noolwekyo kino Mukama Ayinzabyonna ky’agamba:",{"text":"“Abaweereza bange bajja kulya,","poem":1},{"text":"naye mmwe mujja kulumwa enjala,","poem":2},{"text":"abaweereza bange bajja kunywa,","poem":1},{"text":"naye mmwe mulumwe ennyonta;","poem":2},{"text":"abaweereza bange bajja kujaguza,","poem":1},{"text":"naye mmwe mukwatibwe ensonyi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abaweereza bange bajja kuyimba","poem":1},{"text":"olw’essanyu erinaaba mu mitima gyabwe,","poem":2},{"text":"naye mmwe muli ba kukaaba olw’okulumwa okunaabeera mu mitima gyammwe","poem":1},{"text":"era mukaabe olw’okulumwa emyoyo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ekikolimo kiryoke kibagwire,","poem":1},{"text":"Nze Mukama Katonda ow’Eggye mbatte","poem":2},{"text":"amannya gammwe geerabirwe,","poem":1},{"text":"naye mpe amannya amaggya abo abaŋŋondera.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kiryoke kibeere nti buli muntu ananoonya okufuna omukisa","poem":1},{"text":"anaagunoonya kuva eri Katonda Ow’amazima","poem":2},{"text":"buli anaalayiranga mu ggwanga","poem":1},{"text":"anaalayiranga Katonda ow’amazima.","poem":2},{"text":"Kubanga emitawaana egyayita gya kwerabirwa","poem":1},{"text":"gikwekebwe okuva mu maaso gange.","poem":2}]},{"type":"heading","content":["Eggulu Epya n’Ensi Empya"]},{"type":"verse","number":17,"content":[{"text":"“Laba nditonda eggulu eriggya","poem":1},{"text":"n’ensi empya.","poem":2},{"text":"Ebintu eby’edda tebijja kujjukirwa","poem":1},{"text":"wadde okulowoozebwako mu mutima.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Naye musanyukire ekyo kye ntonda","poem":1},{"text":"mujaguze emirembe n’emirembe,","poem":2},{"text":"kubanga nditonda Yerusaalemi okuba essanyu","poem":1},{"text":"n’abantu baamu okuba okujaguza.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ndijaguza olwa Yerusaalemi","poem":1},{"text":"era nsanyukire abantu bange;","poem":2},{"text":"amaloboozi ag’okukaaba","poem":1},{"text":"tegaliddayo kuwulirwamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Teriddayo kuba mu kyo mwana muwere","poem":1},{"text":"anaaberawo ennaku obunaku,","poem":2},{"lineBreak":true},{"text":"oba omusajja omukulu ataamalengayo myaka gye;","poem":2},{"text":"oyo alifiira ku myaka ekikumi","poem":1},{"text":"alitwalibwa ng’omuvubuka obuvubuka.","poem":2},{"text":"Oyo atalituusa kikumi","poem":1},{"text":"abalibwe ng’eyakolimirwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Balizimba ennyumba bazisulemu,","poem":1},{"text":"balisimba emizabbibu balye ebibala byagyo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Tebalizimba nnyumba ate omulala agisulemu,","poem":1},{"text":"tebalisimba ate omulala abirye.","poem":2},{"text":"Kubanga emyaka gy’emiti nga bwe giba","poem":1},{"text":"bwe gityo bwe giribeera emyaka gy’abantu bange.","poem":2},{"text":"Abalonde bange balirwawo nga bawoomerwa","poem":1},{"text":"emirimu gy’emikono gyabwe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Tebalikolera bwereere","poem":1},{"text":"oba okuzaala abaana ab’okugwa mu katyabaga,","poem":2},{"text":"kubanga balibeera abantu abaweebwa Mukama Katonda omukisa,","poem":1},{"text":"bo awamu n’ab’enda yaabwe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nga tebanakoowoola ndibaddamu,","poem":1},{"text":"nga bakyayogera bati mbaddemu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Omusege n’omwana gw’endiga biriire wamu,","poem":1},{"text":"era empologoma erye omuddo ng’ennume,","poem":2},{"lineBreak":true},{"text":"era ettaka libeere emmere y’omusota.","poem":2},{"text":"Tewaliba kulumya","poem":1},{"text":"wadde kuzikiriza ku lusozi lwange olutukuvu,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/64.json","previousChapterAudioLinks":{},"numberOfVerses":25}