{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ISA","translationId":"lug_bib","name":"Isaaya","commonName":"Isaaya","title":"Ekitabo Ekiyitibwa Isaaya","order":23,"numberOfChapters":66,"sha256":"bb50a3193f3d7f73d2e19102d3312eecf60dedb87f4ba1b1536610a51cf3b94b","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/lug_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":9,"content":[{"type":"heading","content":["Omulokozi Atuzaaliddwa"]},{"type":"verse","number":1,"content":["Naye tewaliba kizikiza eri oyo eyali mu kubonaabona. Edda yatoowaza ensi ya Zebbulooni n’ensi ya Nafutaali, naye mu kiseera ekijja aliwa Ggaliraaya ekitiibwa, ensi ey’abamawanga emitala wa Yoludaani, awali ekkubo erigenda ku nnyanja."]},{"type":"verse","number":2,"content":[{"text":"Abantu abaatambuliranga mu kizikiza","poem":1},{"text":"balabye ekitangaala eky’amaanyi,","poem":2},{"text":"abo abaatuulanga mu nsi ey’ekizikiza ekingi,","poem":1},{"text":"omusana gubaakidde.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Oyazizza eggwanga,","poem":1},{"text":"obongedde essanyu,","poem":2},{"text":"basanyukira mu maaso go ng’abantu bwe basanyuka mu biseera eby’amakungula,","poem":1},{"text":"ng’abasajja bwe basanyuka nga bagabana omunyago.","poem":2},{"noteId":10}]},{"type":"verse","number":4,"content":[{"text":"Nga ku lunaku Abamidiyaani lwe baawangulwa,","poem":1},{"text":"omenye ekikoligo ekyamuzitoowereranga,","poem":2},{"text":"n’ekiti eky’oku kibegabega kye,","poem":1},{"text":"n’oluga lw’oyo amunyigiriza.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kubanga buli ngatto ya mulwanyi ekozesebwa mu lutalo","poem":1},{"text":"na buli kyambalo ekibunye omusaayi,","poem":2},{"text":"biriba bya kwokebwa,","poem":1},{"text":"bye birikozesebwa okukoleeza omuliro.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kubanga omwana atuzaaliddwa ffe,","poem":1},{"text":"omwana owoobulenzi atuweereddwa ffe,","poem":2},{"lineBreak":true},{"text":"n’okufuga kunaabanga ku bibegabega bye.","poem":2},{"text":"N’erinnya lye aliyitibwa nti,","poem":1},{"text":"Wa kitalo, Omuwi w’amagezi, Katonda Ayinzabyonna,","poem":2},{"lineBreak":true},{"text":"Kitaffe ow’Emirembe Gyonna, Omulangira w’Emirembe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Okufuga kwe n’emirembe","poem":1},{"text":"biryeyongeranga obutakoma.","poem":2},{"text":"Alifugira ku ntebe ya Dawudi ne ku bwakabaka bwe,","poem":1},{"text":"n’okubuwanirira n’obwenkanya n’obutuukirivu","poem":2},{"lineBreak":true},{"text":"okuva leero okutuusa emirembe gyonna.","poem":2},{"text":"Obumalirivu bwa Mukama Katonda ow’Eggye","poem":1},{"text":"bulikituukiriza ekyo.","poem":2}]},{"type":"heading","content":["Obusungu bwa Mukama Ku Isirayiri"]},{"type":"verse","number":8,"content":[{"text":"Mukama yaweereza obubaka obukwata ku Yakobo,","poem":1},{"noteId":11},{"text":"ku birituuka ku Isirayiri.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Era abantu bonna balibumanya,","poem":1},{"text":"Efulayimu n’abantu b’omu Samaliya","poem":2},{"text":"aboogera n’amalala","poem":1},{"text":"n’omutima omukakanyavu,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"nti, “Amatoffaali gagudde wansi","poem":1},{"text":"naye tulizimbya amayinja amateme,","poem":2},{"text":"emisukamooli gitemeddwawo","poem":1},{"text":"naye tulizzaawo emivule.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mukama Katonda kyaliva awa abalabe ba Lezini amaanyi bamulumbe;","poem":1},{"text":"alibakumaakuma bamulumbe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abasuuli balisinziira mu buvanjuba, n’Abafirisuuti bave ebugwanjuba,","poem":1},{"text":"balyoke basaanyeewo Isirayiri n’akamwa akaasamye.","poem":2},{"lineBreak":true},{"text":"Newaakubadde nga biri bityo, obusungu bwa Mukama buliba tebunnavaawo","poem":1},{"text":"era omukono gwe guliba gukyagoloddwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kubanga abantu tebakyuse kudda","poem":1},{"text":"wadde okunoonya Mukama Katonda ow’Eggye eyabakuba.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bw’atyo Mukama Katonda kyaliva asala ku Isirayiri, omutwe n’omukira,","poem":1},{"text":"ettabi n’olukindu mu lunaku lumu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Omutwe be bakadde n’abantu ab’ekitiibwa,","poem":1},{"text":"n’omukira be bannabbi abayigiriza eby’obulimba.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kubanga abakulembera abantu bano bababuzaabuuza,","poem":1},{"text":"n’abo abakulemberwa babuzibwabuzibwa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Noolwekyo, Mukama tajja kusanyukira bavubuka,","poem":1},{"text":"wadde okukwatirwa ekisa abo abataliiko ba kitaabwe wadde bannamwandu;","poem":2},{"text":"kubanga buli omu mukozi wa bibi,","poem":1},{"text":"era buli kamwa konna kogera eby’obuwemu.","poem":2},{"lineBreak":true},{"text":"Olwa bino byonna, obusungu bwa Mukama tebunakyusibwa kubavaako,","poem":1},{"text":"era omukono gwe gukyagoloddwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ddala ekibi kyokya ng’omuliro;","poem":1},{"text":"gumalawo emyeramannyo n’obusaana.","poem":2},{"text":"Era gukoleeza eby’omu kibira,","poem":1},{"text":"omukka ne gunyooka ne gutumbiira waggulu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Olw’obusungu bwa Mukama Katonda ow’Eggye","poem":1},{"text":"ensi eggiiridde ddala,","poem":2},{"text":"era n’abantu bali ng’enku ez’okukuma omuliro,","poem":1},{"text":"tewali muntu alekawo muganda we.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Balimalawo eby’oku mukono ogwa ddyo,","poem":1},{"text":"naye balisigala bayala;","poem":2},{"text":"balirya n’eby’oku kkono,","poem":1},{"text":"naye tebalikkuta.","poem":2},{"text":"Buli omu alirya ku mubiri gw’ezzadde lye.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Manase alirya Efulayimu ne Efulayimu n’alya Manase","poem":2},{"lineBreak":true},{"text":"ate bombi ne balya Yuda.","poem":2},{"lineBreak":true},{"text":"Naye wadde nga biri bityo, obusungu bwa Mukama buliba tebunnavaawo,","poem":1},{"text":"era n’omukono gwe guliba gukyagoloddwa.","poem":2}]}],"footnotes":[{"noteId":10,"caller":"+","text":"Kino kyogera ku Gidyoni bwe yawanguka Abamidiyaani","reference":{"chapter":9,"verse":3}},{"noteId":11,"caller":"+","text":"Yakobo, ne Isirayiri, ne Efulayimu ne Samaliya, byonna byogera ku Bwakabaka bw’omu Bukiikakkono, era ekibuga kyayo ekikulu ye Samaliya.","reference":{"chapter":9,"verse":8}}]},"thisChapterLink":"/api/lug_bib/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}