{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JER","translationId":"lug_bib","name":"Yeremiya","commonName":"Yeremiya","title":"Ekitabo Ekiyitibwa Yeremiya","order":24,"numberOfChapters":52,"sha256":"f8475c6af126ce22c11be3d946827f2314cf169add6e19d26e7f0730358afae7","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/lug_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":10,"content":[{"type":"heading","content":["Katonda ne Bakatonda Abalala"]},{"type":"verse","number":1,"content":["Muwulire ekigambo Katonda ky’abagamba, mmwe ennyumba ya Isirayiri."]},{"type":"verse","number":2,"content":["Bw’ati bw’ayogera Mukama nti,",{"text":"“Temugobereranga makubo g’amawanga","poem":1},{"text":"oba okweraliikirira obubonero obw’oku ku ggulu,","poem":2},{"lineBreak":true},{"text":"kubanga amawanga ge byeraliikirira.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kubanga empisa ez’amawanga tezigasa;","poem":1},{"text":"batema omuti mu kibira,","poem":2},{"lineBreak":true},{"text":"omubazzi n’aguyooyoota n’ebyuma bye.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bagunyiriza ne ffeeza ne zaabu,","poem":1},{"text":"bagukomerera n’enninga n’ennyondo","poem":2},{"lineBreak":true},{"text":"guleme okunyeenyanyeenya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bakatonda bafaanana nga ssemufu","poem":1},{"text":"mu nnimiro y’ebibala,","poem":2},{"text":"era tebasobola kwogera","poem":1},{"text":"kubanga basitulwa busitulwa tebasobola kutambula.","poem":2},{"text":"Tobatya,","poem":1},{"text":"tebayinza kukukola kabi konna,","poem":2},{"lineBreak":true},{"text":"wadde okukola akalungi n’akamu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tewali ali nga ggwe, Ayi Mukama Katonda.","poem":1},{"text":"Oli mukulu,","poem":2},{"lineBreak":true},{"text":"era erinnya lyo ly’amaanyi nnyo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani ataakutye,","poem":1},{"text":"Ayi Kabaka w’amawanga?","poem":2},{"lineBreak":true},{"text":"Kubanga kino kye kikugwanira.","poem":2},{"text":"Kubanga mu bagezigezi bonna bannaggwanga","poem":1},{"text":"ne mu bwakabaka bwabwe bwonna","poem":2},{"lineBreak":true},{"text":"tewali ali nga ggwe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bonna tebalina magezi basirusiru,","poem":1},{"text":"abo abayigira ku bakatonda ababajje mu miti.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ffeeza eyaweesebwa ey’empewere eggyibwa e Talusiisi,","poem":1},{"text":"ne zaabu eva e Yufazi,","poem":2},{"text":"ffundi n’omuweesi wa zaabu bye bakoze","poem":1},{"text":"byambazibwa engoye eza kaniki ne z’effulungu.","poem":2},{"lineBreak":true},{"text":"Gino gyonna mirimu gy’abasajja abakalabakalaba.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Naye Mukama ye Katonda ddala, ye Katonda omulamu,","poem":1},{"text":"era Kabaka ow’emirembe gyonna.","poem":2},{"text":"Bw’asunguwala, ensi ekankana,","poem":1},{"text":"amawanga tegasobola kugumira busungu bwe.","poem":2}]},{"type":"heading","content":["Katonda Omulamu ne Bakatonda Abataliimu"]},{"type":"verse","number":11,"content":["“Bw’oti bw’oba obagamba nti, ‘Bakatonda abataakola ggulu na nsi ba kuzikirira bave ku nsi ne wansi w’eggulu.’ ”"]},{"type":"verse","number":12,"content":[{"text":"Mukama yakola ensi n’amaanyi ge,","poem":1},{"text":"n’atonda ebitonde byonna n’amagezi ge,","poem":2},{"lineBreak":true},{"text":"era okutegeera kwe, kwe kwayanjuluza eggulu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bw’afulumya eddoboozi lye, amazzi agali mu bire gawuluguma,","poem":1},{"text":"asobozesa ebire okusituka nga biva ku nkomerero y’ensi.","poem":2},{"text":"Amyansisa eggulu mu nkuba,","poem":1},{"text":"era n’aggya empewo mu mawanika ge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Buli muntu talina magezi era taliimu kutegeera;","poem":1},{"text":"buli muweesi wa zaabu aswala olw’ekifaananyi ky’akoze.","poem":2},{"text":"Kubanga ebifaananyi bye ebisaanuuse bulimba,","poem":1},{"text":"era tebiriimu bulamu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tebiriiko kye bigasa, ebisaanye okunyoomebwa","poem":1},{"text":"ebirizikirizibwa nga Mukama azze okusala omusango.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Oyo Katonda Omugabo gwa Yakobo tali ng’ebyo,","poem":1},{"text":"ye Mutonzi w’ebintu byonna,","poem":2},{"text":"era owa Isirayiri, eggwanga ery’omugabo gwe,","poem":1},{"text":"Mukama Katonda ow’Eggye lye linnya lye.","poem":2}]},{"type":"heading","content":["Okuzikirira Okujja"]},{"type":"verse","number":17,"content":[{"text":"Mukuŋŋaanye ebyammwe muve mu nsi,","poem":1},{"text":"mmwe abazingiziddwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kubanga bw’ati bw’ayogera Mukama Katonda nti,","poem":1},{"text":"“Laba nfuumuula abantu","poem":2},{"lineBreak":true},{"text":"mbaggye mu nsi eno,","poem":2},{"text":"era ndibaleetako ennaku","poem":1},{"text":"balyoke bawambibwe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Zinsanze nze olw’ekiwundu kyange","poem":1},{"text":"ekinnuma ennyo.","poem":2},{"text":"Naye ate ne ŋŋamba nti,","poem":1},{"text":"“Eno ndwadde yange, nteekwa okugigumira.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Eweema yange eyonooneddwa,","poem":1},{"text":"era emiguwa gyonna gikutuse, abaana bange bandese, tewakyali.","poem":2},{"text":"Tewali n’omu asigaddewo kaakano","poem":1},{"text":"kuzimba weema yange","poem":2},{"lineBreak":true},{"text":"wadde okuzimba ekigango kyange.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kubanga abasumba bafuuse ng’ensolo","poem":1},{"text":"tebakyebuuza ku Mukama.","poem":2},{"text":"Noolwekyo tebakulaakulana","poem":1},{"text":"era endiga zaabwe zonna zisaasaanye.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Wuliriza!","poem":1},{"text":"Amawulire gatuuse,","poem":2},{"text":"waliwo akeegugungo ak’amaanyi okuva mu nsi ey’omu bukiikakkono,","poem":1},{"text":"kajja kufuula ebibuga bya Yuda amatongo, ebisulo by’ebibe.","poem":2}]},{"type":"heading","content":["Okusaba kwa Yeremiya"]},{"type":"verse","number":23,"content":[{"text":"Mmanyi Ayi Mukama Katonda ng’obulamu bw’omuntu si bubwe,","poem":1},{"text":"omuntu si y’aluŋŋamya amakubo ge.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nnuŋŋamya, Mukama Katonda naye mu kigera ekisaanidde,","poem":1},{"text":"si mu busungu bwo,","poem":2},{"lineBreak":true},{"text":"si kulwa ng’onfuula ekitaliimu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yiwa obusungu bwo ku mawanga agatakumanyi,","poem":1},{"text":"agatakutwala ng’ekikulu,","poem":2},{"lineBreak":true},{"text":"ku bantu abatakoowoola linnya lyo.","poem":2},{"text":"Kubanga bamazeewo Yakobo,","poem":1},{"text":"bamuliiridde ddala","poem":2},{"lineBreak":true},{"text":"era ne boonoona ensi ye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JER/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JER/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JER/9.json","previousChapterAudioLinks":{},"numberOfVerses":25}