{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JER","translationId":"lug_bib","name":"Yeremiya","commonName":"Yeremiya","title":"Ekitabo Ekiyitibwa Yeremiya","order":24,"numberOfChapters":52,"sha256":"f8475c6af126ce22c11be3d946827f2314cf169add6e19d26e7f0730358afae7","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/lug_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":12,"content":[{"type":"heading","content":["Okwemulugunya kwa Yeremiya"]},{"type":"verse","number":1,"content":[{"text":"Bulijjo oba mutuukirivu, Ayi Mukama Katonda,","poem":1},{"text":"bwe nkuleetera ensonga yange.","poem":2},{"text":"Noolwekyo nnaaleeta ensonga yange gy’oli.","poem":1},{"text":"Lwaki abakozi b’ebibi baba mu kwesiima?","poem":2},{"lineBreak":true},{"text":"Lwaki abalimbalimba bonna baba mu bulamu obw’emirembe?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wabasimba, emirandira ne ginywera,","poem":1},{"text":"bakula ne baleeta ebibala.","poem":2},{"text":"Tova ku mimwa gyabwe bulijjo","poem":1},{"text":"wadde ng’oliwala n’emitima gyabwe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ate ng’ommanyi Ayi Mukama Katonda,","poem":1},{"text":"ondaba era otegeera bye nkulowoozaako.","poem":2},{"text":"Sika otwale abasajja bano ababi ng’endiga ezigenda okuttibwa.","poem":1},{"text":"Bategekere olunaku lwe balisanjagirwako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ensi erikoma ddi okwonooneka,","poem":1},{"text":"n’omuddo mu buli nnimiro okukala?","poem":2},{"text":"Kubanga abo abali mu nsi bakozi ba bibi,","poem":1},{"text":"ensolo n’ebinyonyi bizikiridde,","poem":2},{"text":"kubanga abantu bagamba nti,","poem":1},{"text":"“Katonda taalabe binaatutuukako.”","poem":2}]},{"type":"heading","content":["Katonda Addamu"]},{"type":"verse","number":5,"content":[{"text":"“Bw’oba owakana n’abaddusi b’embiro","poem":1},{"text":"n’oggwaamu amaanyi","poem":2},{"lineBreak":true},{"text":"oyinza otya okudduka n’embalaasi?","poem":2},{"text":"Obanga mu nsi entereevu weesitadde n’ogwa bugwi,","poem":1},{"text":"onoosobolayo otya mu nsiko y’oku Yoludaani?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne baganda bo n’ab’omu nnyumba ya kitaawo","poem":1},{"text":"nabo bennyini bakwefuukidde,","poem":2},{"lineBreak":true},{"text":"beegasse ku abo abawowoggana nga bakulangiriza.","poem":2},{"text":"Tobeesiga","poem":1},{"text":"wadde nga bakwogerako bulungi.”","poem":2}]},{"type":"heading","content":["Ennaku ya Mukama olw’Abantu be"]},{"type":"verse","number":7,"content":[{"text":"“Njabulidde ennyumba yange,","poem":1},{"text":"ne ndeka omugabo gwange;","poem":2},{"text":"mpaddeyo abo emmeeme yange b’eyagala,","poem":1},{"text":"mu mikono gy’abalabe baabwe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abantu bange be nalonda","poem":1},{"text":"banfuukidde ng’empologoma eri mu kibira;","poem":2},{"text":"empulugumira,","poem":1},{"text":"noolwekyo mbakyaye.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abantu bange be nalonda","poem":1},{"text":"tebanfuukidde ng’ennyonyi erya ginnaazo ey’amabala,","poem":2},{"lineBreak":true},{"text":"ebinyonyi ebirala ebirya binaabyo gye bizingiza ne bigirumba?","poem":2},{"text":"Mugende mukuŋŋaanye ensolo zonna ez’omu nsiko","poem":1},{"text":"muzireete zirye.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abasumba bangi","poem":1},{"text":"boonoonye ennimiro yange ey’emizabbibu,","poem":2},{"text":"balinnyiridde ennimiro yange,","poem":1},{"text":"ensi yange ennungi bagirese njereere.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Eyonooneddwa efuuse ddungu","poem":1},{"text":"esigadde awo ng’enkaabirira.","poem":2},{"text":"Ensi yonna efuuse matongo","poem":1},{"text":"kubanga tewali muntu n’omu agifaako.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abanyazi bazze","poem":1},{"text":"batuuse ku nsozi zonna ez’omu ddungu,","poem":2},{"text":"kubanga ekitala kya Mukama kijja kulya","poem":1},{"text":"okuva ku nsonda emu ey’ensi okutuuka ku ndala,","poem":2},{"lineBreak":true},{"text":"awataliiwo n’omu kuwona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Basize eŋŋaano, ne bakungula amaggwa.","poem":1},{"text":"Bakooyedde bwereere ne bataba na kebaggyamu.","poem":2},{"text":"Bakwatiddwa ensonyi olw’ebibala bye bakunguddeyo,","poem":1},{"text":"kubanga ebyo Mukama y’abikoze olw’obusungu bwe obungi.”","poem":2}]},{"type":"verse","number":14,"content":["Bw’ati bw’ayogera Mukama nti, “Ebikwata ku baliraanwa bange ababi nga bifa ku mugabo gwe nawa abantu bange Isirayiri okuba ogwabwe, laba ndibasiguukulula okuva mu nsi yaabwe, era ndiggya ennyumba ya Yuda mu bo."]},{"type":"verse","number":15,"content":["Naye nga mmaze okubasiguukululamu, ndibakwatirwa ekisa ne mbakomyawo buli omu eri omugabo gwe mu nsi ye."]},{"type":"verse","number":16,"content":["Era nga bwe bayigiriza abantu bange okulayirira mu linnya lya Baali bwe batyo balikwatira ddala empisa z’abantu bange, okulayirira mu linnya lyange nga boogera nti, ‘Nga Mukama bw’ali omulamu,’ olwo balizimbibwa wakati mu bantu bange."]},{"type":"verse","number":17,"content":["Naye eggwanga bwe litalissaayo mwoyo, ndirisiguukulula ne ndisaanyizaawo ddala,” bw’ayogera Mukama."]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JER/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JER/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JER/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}