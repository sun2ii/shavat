{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JER","translationId":"lug_bib","name":"Yeremiya","commonName":"Yeremiya","title":"Ekitabo Ekiyitibwa Yeremiya","order":24,"numberOfChapters":52,"sha256":"f8475c6af126ce22c11be3d946827f2314cf169add6e19d26e7f0730358afae7","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/lug_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":14,"content":[{"type":"heading","content":["Ekyeya, Enjala, n’Ekitala"]},{"type":"verse","number":1,"content":["Ekigambo kya Mukama ekyajjira Yerusaalemi ekikwata ku kyeya."]},{"type":"verse","number":2,"content":[{"text":"“Yuda ekungubaga n’ebibuga byayo bifaafaaganye,","poem":1},{"text":"bakaabira ensi,","poem":2},{"text":"era omulanga","poem":1},{"text":"gusimbuse mu Yerusaalemi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abakungu batuma abaddu baabwe okuleeta amazzi;","poem":1},{"text":"bagenda mu ttanka ez’omu ttaka nga temuli kantu,","poem":2},{"lineBreak":true},{"text":"bakomawo n’ebintu ebikalu;","poem":2},{"text":"ensonyi nga zibakutte","poem":1},{"text":"n’essuubi nga libaweddemu;","poem":2},{"lineBreak":true},{"text":"babikka amaaso gaabwe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ettaka lyatise","poem":1},{"text":"kubanga enkuba tekyatonnya,","poem":2},{"text":"abalimi baweddemu amaanyi,","poem":1},{"text":"babikka ku mitwe gyabwe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"N’empeewo ku ttale ezaala","poem":1},{"text":"n’ereka awo omwana gwayo","poem":2},{"lineBreak":true},{"text":"kubanga tewali muddo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"N’ennyumbu ez’omu nsiko ziyimirira ku busozi obukalu","poem":1},{"text":"nga ziwejjawejja ng’ebibe,","poem":2},{"text":"amaaso gaazo nga tegalaba bulungi","poem":1},{"text":"kubanga tezirina kye zirya.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wadde obutali butuukirivu bwaffe butulumiriza, Ayi Mukama,","poem":1},{"text":"baako ky’okola olw’erinnya lyo.","poem":2},{"text":"Kubanga tuzze ennyuma emirundi mingi,","poem":1},{"text":"tukwonoonye nnyo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ayi ggwe essuubi lya Isirayiri,","poem":1},{"text":"Omulokozi waalyo mu biseera eby’okulabiramu ennaku,","poem":2},{"text":"lwaki oli ng’omuyise mu nsi,","poem":1},{"text":"ng’omutambuze asula ekiro ekimu?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Lwaki oli ng’omuntu gwe baguddeko obugwi,","poem":1},{"text":"ng’omulwanyi ataliimu maanyi ganunula?","poem":2},{"text":"Ggwe, Ayi Mukama Katonda, oli wakati mu ffe,","poem":1},{"text":"era tuyitibwa linnya lyo.","poem":2},{"lineBreak":true},{"text":"Totuleka.","poem":2}]},{"type":"verse","number":10,"content":["Bw’ati bw’ayogera Mukama Katonda ku bantu be nti,",{"text":"“Baagala nnyo okubula,","poem":1},{"text":"tebaziyiza bigere byabwe.","poem":2},{"text":"Noolwekyo Mukama tabakkiriza","poem":1},{"text":"era kaakano wakujjukira obutali butuukirivu bwabwe","poem":2},{"lineBreak":true},{"text":"era ababonereze olw’ebibi byabwe.”","poem":2}]},{"type":"verse","number":11,"content":["Awo Mukama Katonda n’aŋŋamba nti, “Tosabira bantu bano kubeera bulungi."]},{"type":"verse","number":12,"content":["Newaakubadde nga basiiba, sijja kuwulira kukaaba kwabwe, era wadde bawaayo ebiweebwayo ebyokebwa n’ebiweebwayo eby’empeke, sijja kubikkiriza. Naye nnaabazikiriza n’ekitala, n’enjala ne kawumpuli.”"]},{"type":"verse","number":13,"content":["Naye ne njogera nti, “Woowe, Mukama Katonda, bannabbi abalala babagamba nti, ‘Tewajja kubaawo lutalo wadde okulumwa enjala. Naye nzija kuleeta mirembe egitakoma mu kifo kino.’ ”"]},{"type":"verse","number":14,"content":["Awo Mukama n’alyoka aŋŋamba nti, “Bannabbi bawa obunnabbi obw’obulimba mu linnya lyange, sibatumanga wadde okubalagira okwogera nabo. Babategeeza okwolesebwa okw’obulimba n’obunnabbi obutaliimu, n’obutaliimu bw’emitima gyabwe."]},{"type":"verse","number":15,"content":["Noolwekyo, bw’atyo bw’ayogera Mukama, ebikwata ku bannabbi abategeeza ebyobunnabbi mu linnya lyange wadde nga sibatumanga, era abagamba nti, ‘Ekitala n’enjala tebijja kujja mu nsi eno.’ Bannabbi abo bennyini bajja kuzikirizibwa ekitala n’enjala."]},{"type":"verse","number":16,"content":["N’abantu be bategeezezza obunnabbi balifa enjala n’ekitala ne bakasukibwa mu nguudo babulweko abaziika, bo ne bakazi baabwe, ne batabani baabwe, n’abawala. Kubanga ndibayiwako obusungu obubasaanira."]},{"type":"verse","number":17,"content":["“Kino ky’oba obagamba nti,",{"text":"“ ‘Leka amaaso gange gakulukute amaziga","poem":1},{"text":"emisana n’ekiro awatali kukoma;","poem":2},{"text":"kubanga muwala wange embeerera, abantu bange,","poem":1},{"text":"bafunye ekiwundu ekinene,","poem":2},{"lineBreak":true},{"text":"ekintu eky’amaanyi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bwe ŋŋenda mu byalo","poem":1},{"text":"ndaba abafumitiddwa n’ekitala!","poem":2},{"text":"Bwe ŋŋenda mu kibuga","poem":1},{"text":"ndaba okutaagulwataagulwa okw’enjala.","poem":2},{"text":"Naye nnabbi ne kabona beeyongera okukola emirimu gyabwe mu ggwanga","poem":1},{"text":"kyokka nga bye boogera bya bulimba.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yuda ogigaanidde ddala?","poem":1},{"text":"Sayuuni ogyetamiriddwa ddala?","poem":2},{"text":"Otufumitidde ddala awatali kuwonyezebwa?","poem":1},{"text":"Twasuubira emirembe naye tewali kalungi ke tufunye,","poem":2},{"text":"ekiseera eky’okuwonyezebwa","poem":1},{"text":"naye laba tufunye bulabe bwereere.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ayi Mukama tukkiriza ebibi byaffe","poem":1},{"text":"era n’obutali butuukirivu bwa bajjajjaffe,","poem":2},{"lineBreak":true},{"text":"kubanga ddala twayonoona gy’oli.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Olw’erinnya lyo totugoba,","poem":1},{"text":"tovumaganyisa ntebe yo ey’obwakabaka ey’ekitiibwa.","poem":2},{"text":"Jjukira endagaano gye wakola naffe,","poem":1},{"text":"togimenya, gituukirize.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Waliwo ku bakatonda ababajje bannaggwanga asobola okutonnyesa enkuba?","poem":1},{"text":"Eggulu ku bw’alyo lisobola okuleeta enkuba?","poem":2},{"text":"Nedda, wabula ggwe, Ayi Mukama Katonda waffe.","poem":1},{"text":"Noolwekyo essuubi lyaffe liri mu ggwe,","poem":2},{"lineBreak":true},{"text":"kubanga ggwe okola bino byonna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JER/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JER/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JER/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}