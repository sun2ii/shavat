{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JER","translationId":"lug_bib","name":"Yeremiya","commonName":"Yeremiya","title":"Ekitabo Ekiyitibwa Yeremiya","order":24,"numberOfChapters":52,"sha256":"f8475c6af126ce22c11be3d946827f2314cf169add6e19d26e7f0730358afae7","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/lug_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":15,"content":[{"type":"heading","content":["Yuda Wakuzikirira"]},{"type":"verse","number":1,"content":["Awo Mukama n’alyoka aŋŋamba nti, “Musa ne Samwiri ne bwe bandiyimiridde okunneegayirira, sandisonyiye bantu bano. Bagobe okuva mu maaso gange, banviire."]},{"type":"verse","number":2,"content":["Era bwe bakubuuza nti, ‘Tunaagenda wa?’",{"text":"“Bagambe nti, ‘Kino Mukama kyagamba nti,","poem":1},{"lineBreak":true},{"text":"Ab’okuttibwa bagenda kuttibwa,","poem":1},{"lineBreak":true},{"text":"n’ab’ekitala bafe ekitala, n’ab’enjala bafe enjala,","poem":1},{"lineBreak":true},{"text":"n’ab’okuwambibwa bawambibwe.’","poem":1}]},{"type":"verse","number":3,"content":["“Ndiweereza engeri nnya ez’okubazikiriza,” bw’ayogera Mukama. “Ekitala kya kufumita, embwa zikulule, ebinyonyi eby’omu bbanga n’ensolo ez’omu nsiko zirye n’okuzikiriza."]},{"type":"verse","number":4,"content":["Era ndibawaayo babeetamwe eruuyi n’eruuyi mu bwakabaka bwonna obw’omu nsi olw’ekyo Manase mutabani wa Keezeekiya kabaka wa Yuda kye yakola mu Yerusaalemi."]},{"type":"verse","number":5,"content":[{"text":"“Ani alikukwatirwa ekisa ggwe Yerusaalemi?","poem":1},{"text":"Oba ani alikukungubagira?","poem":2},{"lineBreak":true},{"text":"Oba ani alikyama okubuuza ebikufaako?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mwanneegaana,” bw’ayogera Mukama.","poem":1},{"text":"“Temutya kudda nnyuma.","poem":2},{"text":"Noolwekyo mbagololeddeko omukono gwange","poem":1},{"text":"ne mbazikiriza.","poem":2},{"text":"Sikyasobola","poem":1},{"text":"kukukwatirwa kisa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Era ndibakuŋŋunta n’ekitiiyo eky’amannyo","poem":1},{"text":"mu miryango gy’ebibuga eby’omu nsi.","poem":2},{"text":"Ndizikiriza abantu bange ne mbamalawo","poem":1},{"text":"kubanga tebaaleka makubo gaabwe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bannamwandu beeyongedde obungi","poem":1},{"text":"okusinga n’omusenyu gw’ennyanja.","poem":2},{"text":"Mu ttuntu mbaleetedde omuzikiriza","poem":1},{"text":"amalewo ababazaalira abalenzi abato.","poem":2},{"text":"Mbakubiddewo","poem":1},{"text":"obubalagaze n’entiisa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Eyazaala omusanvu ayongobedde,","poem":1},{"text":"awejjawejja.","poem":2},{"text":"Enjuba ye egudde nga bukyali misana,","poem":1},{"text":"amaanyi gamuwedde, ensonyi zimukutte, awuunze, awuubadde.","poem":2},{"text":"N’abo abawonyeewo ndi wa kubasogga ekitala,","poem":1},{"text":"mu maaso ga balabe baabwe,”","poem":2},{"lineBreak":true},{"text":"bwayogera Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Zinsanze, mmange lwaki wanzaala","poem":1},{"text":"omuntu eggwanga lyonna gwe lirwanyisa ne likuluusanya?","poem":2},{"text":"Siwolanga wadde okweyazika,","poem":1},{"text":"kyokka buli muntu ankolimira.","poem":2}]},{"type":"verse","number":11,"content":["Mukama agamba nti,",{"text":"“Ddala ndikununula olw’ekigendererwa ekirungi,","poem":1},{"text":"ddala ndireetera abalabe bo okukwegayirira,","poem":2},{"lineBreak":true},{"text":"mu biseera eby’okuluma obujiji, mu biseera eby’akabi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Omusajja ayinza okumenya ekikomo","poem":1},{"text":"oba ekyuma eky’omu bukiikakkono?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Ndiwaayo eby’obugagga byo n’ebintu byo eby’omuwendo ennyo","poem":1},{"text":"binyagibwe awatali kusasulwa,","poem":2},{"text":"olw’ebibi byo byonna","poem":1},{"text":"ebikoleddwa mu ggwanga lyonna.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndibafuula abasibe b’abalabe bammwe","poem":1},{"text":"mu ggwanga lye mutamanyi,","poem":2},{"text":"kubanga obusungu bwange bwakukoleeza omuliro","poem":1},{"text":"ogunaabookya gubamalewo.”","poem":2}]},{"type":"heading","content":["Yeremiya Yeekaabirako"]},{"type":"verse","number":15,"content":[{"text":"Ayi Mukama ggwe omanyi byonna.","poem":1},{"text":"Nzijukira ondabirire.","poem":2},{"lineBreak":true},{"text":"Ompalanire eggwanga ku abo abanjigganya.","poem":2},{"text":"Mu kugumiikiriza kwo okunene tontwala.","poem":1},{"text":"Lowooza ku ngeri gye mbonyeebonye ku lulwo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ebigambo byo bwe byanzijira, ne mbirya,","poem":1},{"text":"byali ssanyu era okujaguza kw’omutima gwange.","poem":2},{"text":"Kubanga mpitibwa linnya lyo,","poem":1},{"text":"Ayi Mukama Katonda ow’Eggye.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Situulangako mu kuŋŋaaniro ly’abo ab’ebinyumu","poem":1},{"text":"era sibeerangako mu biduula nabo.","poem":2},{"text":"Natuulanga nzekka kubanga naliko omukono gwo,","poem":1},{"text":"era wandeetera okwekyawa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Lwaki okulumwa kwange tekukoma","poem":1},{"text":"era n’ekiwundu kyange ne kitawona?","poem":2},{"text":"Onomberera ng’akagga akalimbalimba","poem":1},{"text":"ng’ensulo ekalira?","poem":2}]},{"type":"verse","number":19,"content":["Noolwekyo kino Mukama ky’agamba nti,",{"text":"“Bwe muneenenya,","poem":1},{"text":"ndibakomyawo musobole okumpeereza;","poem":2},{"text":"bwe mulyogera ebigambo ebisaana so si ebitasaanidde,","poem":1},{"text":"mulibeera boogezi bange.","poem":2},{"text":"Leka abantu bano be baba bajja gy’oli,","poem":1},{"text":"so si ggwe okugenda gye bali.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ndikufuula ekisenge eri abantu bano,","poem":1},{"text":"ekisenge ekinywezebbwa eky’ekikomo.","poem":2},{"text":"Balikulwanyisa","poem":1},{"text":"naye tebalikuwangula,","poem":2},{"text":"kubanga ndi naawe,","poem":1},{"text":"okukununula, n’okukulokola,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“Ndikununula okuva mu mukono gw’abakozi b’ebibi","poem":1},{"text":"era n’enkuggya mu mukono gw’abasajja abakambwe,” bw’ayogera Mukama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JER/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JER/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JER/14.json","previousChapterAudioLinks":{},"numberOfVerses":21}