{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JER","translationId":"lug_bib","name":"Yeremiya","commonName":"Yeremiya","title":"Ekitabo Ekiyitibwa Yeremiya","order":24,"numberOfChapters":52,"sha256":"f8475c6af126ce22c11be3d946827f2314cf169add6e19d26e7f0730358afae7","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/lug_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":2,"content":[{"type":"heading","content":["Isirayiri eva ku Katonda"]},{"type":"verse","number":1,"content":["Ekigambo kya Mukama Katonda ne kinzijira nga kigamba nti,"]},{"type":"verse","number":2,"content":["“Genda olangirire nga Yerusaalemi ewulira nti:",{"lineBreak":true},"“Bw’ati bw’ayogera Mukama Katonda nti,",{"text":"“ ‘Nzijukira okwewaayo kwe weewaayo ng’okyali muto,","poem":1},{"text":"engeri gye wanjagalamu nga twakafumbiriganwa,","poem":2},{"text":"wangoberera mu ddungu","poem":1},{"text":"mu nsi etali nnime.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isirayiri wali mutukuvu wa Mukama,","poem":1},{"text":"ebibala ebibereberye ebyamakungula ge;","poem":2},{"text":"bonna abaakulyangako nga bazzizza omusango,","poem":1},{"text":"akabi nga kabatuukako,’ ”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Muwulirize ekigambo kya Mukama mwe ezzadde lya Yakobo,","poem":1},{"text":"era n’ab’enju zonna ez’ebika eby’omu Isirayiri.","poem":2}]},{"type":"verse","number":5,"content":["Bw’ati bw’ayogera Mukama nti,",{"text":"Kibi ki bakitammwe kye bansangamu ne banvaako","poem":1},{"text":"ne bagenda ewala ennyo bwe batyo?","poem":2},{"text":"Baagoberera ebifaananyi bya bakatonda abakole n’emikono ebitaliimu","poem":1},{"text":"nabo bennyini ne bafuuka ebitaliimu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne batagamba nako nti; “Ali ludda wa Mukama eyatuggya mu nsi y’e Misiri;","poem":1},{"text":"eyatuyisa mu lukoola,","poem":2},{"text":"mu nsi ey’amalungu n’obunnya, mu nsi enkalu n’ekisiikirize eky’okufa,","poem":1},{"text":"mu nsi omutali muntu n’omu, so n’omuntu yenna mw’atayinza kuyita?”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne mbaleeta mu nsi engimu,","poem":1},{"text":"mulye ebibala byamu n’ebintu ebirungi.","poem":2},{"text":"Naye bwe mwajja ne mwonoona ensi yange,","poem":1},{"text":"ne mufuula omugabo gwange ekivume.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bakabona ne batabuuzaako nti, “Mukama ali ludda wa?”","poem":1},{"text":"Abo abakola ku mateeka tebammanya.","poem":2},{"text":"Abakulembeze ne banjeemera.","poem":1},{"text":"Bannabbi nga baweereza ku lwa Baali, ne bagoberera ebitagasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Kyenva nnyongera okubalumiriza,”","poem":1},{"text":"bw’ayogera Mukama,","poem":2},{"lineBreak":true},{"text":"“Era ndirumiriza n’abaana b’abaana bammwe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Muwunguke ennyanja mugende ku bizinga bya Kittimu mulabe;","poem":1},{"text":"era mutume e Kedali, mwetegereze.","poem":2},{"lineBreak":true},{"text":"Mujja kulaba nga tekibangawo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Waali wabaddewo eggwanga erikyusa bakatonda baalyo,","poem":1},{"text":"wadde nga si bakatonda, naye nga bitaliimu?","poem":2},{"text":"Naye abantu bange baawaanyisa ekitiibwa kyabwe","poem":1},{"text":"n’ebitagasa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wewuunye ggwe eggulu,","poem":1},{"text":"era okankane n’entiisa ey’amaanyi,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Kubanga abantu bange bakoze ebibi bibiri,","poem":1},{"lineBreak":true},{"text":"banvuddeko","poem":1},{"text":"nze ensulo ey’amazzi amalamu","poem":2},{"text":"ne beesimira ettanka ez’omu ttaka,","poem":1},{"text":"ettanka ez’omu ttaka ezirimu enjatika ezitanyweeramu mazzi.”","poem":2}]},{"type":"heading","content":["Ebyava mu Kubula kwa Isirayiri"]},{"type":"verse","number":14,"content":[{"text":"“Isirayiri muddu, omuddu omuzaale?","poem":1},{"text":"Kale lwaki afuuse omuyiggo?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bamuwulugumirako ng’empologoma bw’ewuluguma,","poem":1},{"text":"abalabe bawulugumye nnyo.","poem":2},{"text":"Ensi ye efuuse matongo,","poem":1},{"text":"ebibuga bye bigyiridde ddala omuliro birekeddwa ttayo, nga temukyali muntu n’omu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ate era abasajja b’e Noofu n’e Tapeneesi","poem":1},{"text":"bamaliddewo ddala ekitiibwa kyo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Si ggwe weeretedde bino ng’ova ku Mukama Katonda wo,","poem":1},{"text":"eyakukulemberanga","poem":2},{"lineBreak":true},{"text":"akulage ekkubo?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kaakano olowooza onooganyulwamu ki","poem":1},{"text":"okugenda okukolagana ne Misiri?","poem":2},{"text":"Olowooza kiki ky’onoganyulwa","poem":1},{"text":"bw’onogenda okukolagana ne Bwasuli?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ebibi byo byennyini bye biri kubonereza,","poem":1},{"text":"n’okudda kwo emabega kwe kulikusalira omusango.","poem":2},{"text":"Kale lowooza era otegeere nga bwe kiri ekibi era eky’omutawaana gy’oli bw’ova ku Mukama Katonda wo,","poem":1},{"text":"n’oba nga tokyantya,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama, Katonda ow’eggye.","poem":2}]},{"type":"heading","content":["Isirayiri Ebonerezebwa olw’Okusinza Bakatonda Abalala"]},{"type":"verse","number":20,"content":["Mukama ow’eggye agamba nti,",{"text":"“Isirayiri, ebbanga ddene eriyiseewo bukya weggya mu buyinza bwange,","poem":1},{"text":"n’ogamba nti, ‘Sijja kukugondera.’","poem":2},{"text":"Era ddala, ku buli kasozi era na buli wansi w’omuti oguyimiridde","poem":1},{"text":"wakuba obwamalaaya","poem":2},{"lineBreak":true},{"text":"ng’ovuunamira bakatonda abalala.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Songa nnali nkusimbye ng’oli muzabbibu omulungi,","poem":1},{"text":"ensigo eteriimu kikyamu n’akatono,","poem":2},{"text":"naye ate lwaki oyonoonese","poem":1},{"text":"n’ofuuka ng’omuzabbibu ogw’omu nsiko?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kubanga ne bw’onaaba n’oluvu n’okozesa ne sabbuuni omungi,","poem":1},{"text":"naye era ebbala lyo n’obutali butuukirivu bwo","poem":2},{"lineBreak":true},{"text":"bisigala bikyalabika,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Oyinza otya okugamba nti, “Sseeyonoonanga,","poem":1},{"text":"sigobereranga ba Baali?”","poem":2},{"text":"Jjukira bwe weeyisa ng’oli mu kiwonvu;","poem":1},{"text":"tegeera kye wakola.","poem":2},{"text":"Oli ng’eŋŋamira enkazi efuumuuka embiro","poem":1},{"text":"ngeraga eno n’eri,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ng’endogoyi ey’omu nsiko","poem":1},{"text":"eddukira mu ddungu mw’emanyidde,","poem":2},{"text":"ng’ewunyiriza mu bbanga eno n’eri mu kwaka kwayo,","poem":1},{"text":"mu kiseera ekyo ani ayinza okugiziyiza?","poem":2},{"text":"Ensajja zonna ezigyetaaga tezeetaaga kwekooya;","poem":1},{"text":"mu biseera by’okulabaganiramu za kugifuna.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Tokooya bigere byo,","poem":1},{"text":"era tokaza mimiro gyo.","poem":2},{"text":"Naye n’oddamu nti, “Ebyo bya bwereere,","poem":1},{"text":"sisobola kukyuka, nayagala bakatonda abalala,","poem":2},{"lineBreak":true},{"text":"nteekwa okubanoonya.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ng’omubbi bw’aswala ng’akwatiddwa,","poem":1},{"text":"n’ennyumba ya Isirayiri bw’eswala bw’etyo,","poem":2},{"text":"bakabaka baayo, n’abalangira baayo, ne bakabona baayo,","poem":1},{"text":"era ne bannabbi baayo,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"nga bagamba emiti nti, “Ggwe kitange,”","poem":1},{"text":"era n’ejjinja nti, “Ggwe wanzaala.”","poem":2},{"text":"Bankubye amabega,","poem":1},{"text":"naye bwe balaba ennaku bankaabirira nti, “Yimuka ojje otulokole.”","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kale bakatonda be weekolera baluwa?","poem":1},{"text":"Leka bajje, bwe baba basobola okukulokola mu biseera eby’emitawaana.","poem":2},{"text":"Kubanga obungi bwa bakatonda bammwe","poem":1},{"text":"bwenkanankana n’ebibuga byo ggwe Yuda.","poem":2}]},{"type":"heading","content":["Okubonerezebwa Kutuuse"]},{"type":"verse","number":29,"content":[{"text":"“Lwaki munneemulugunyiza?","poem":1},{"text":"Mwenna mwanneeddiimira,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Abaana bammwe nababonereza naye nga bwerere,","poem":1},{"text":"tebakkiriza kugololwa.","poem":2},{"text":"Mmwe bennyini ne mwettira bannabbi bammwe","poem":1},{"text":"ng’empologoma bw’etta.","poem":2}]},{"type":"verse","number":31,"content":["Mmwe ab’omulembe guno muwulirize ekigambo kya Katonda.",{"text":"Mbadde nga ddungu gye muli","poem":1},{"text":"ng’ensi ejjudde ekizikiza eky’amaanyi?","poem":2},{"text":"Kale lwaki abantu bange bagamba nti,","poem":1},{"text":"“Tulina eddembe, tetukyadda gy’oli?”","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Omuwala omuto ayinza okwerabira ebikomo,","poem":1},{"text":"oba omugole okwerabira ekyambalo kye?","poem":2},{"text":"Naye ng’ate abantu bange","poem":1},{"text":"Bannerabidde!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ng’omanyi nnyo okukuba amakubo ag’okunoonya abanaakwagala!","poem":1},{"text":"N’asembayo okuba omukugu mu bamalaaya aba alina kuyigira ku ggwe.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Engoye zo zijjudde omusaayi gw’abaavu","poem":1},{"text":"n’abatalina musango,","poem":2},{"text":"awatali kugamba nti","poem":1},{"text":"bakwatibwa nga babba.","poem":2},{"text":"Ate nga wadde byonna biri bwe bityo","poem":1}]},{"type":"verse","number":35,"content":[{"text":"ogamba nti, “Sirina musango,","poem":2},{"lineBreak":true},{"text":"ddala takyanninako busungu!”","poem":2},{"text":"Laba, ŋŋenda kukusalira omusango","poem":1},{"text":"olw’okugamba nti, “Sirina kibi kye nkoze.”","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Lwaki ogenda ng’okyusakyusa","poem":1},{"text":"amakubo go!","poem":2},{"text":"Misiri ejja kukuswaza","poem":1},{"text":"nga Bwasuli bwe yakuswaza.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Era n’eyo olivaayo","poem":1},{"text":"ng’emikono ogyetisse ku mutwe,","poem":2},{"text":"kubanga Mukama agaanye abo be weesiga;","poem":1},{"text":"tagenda kukuyamba.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JER/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}