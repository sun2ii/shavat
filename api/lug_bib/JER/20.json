{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JER","translationId":"lug_bib","name":"Yeremiya","commonName":"Yeremiya","title":"Ekitabo Ekiyitibwa Yeremiya","order":24,"numberOfChapters":52,"sha256":"f8475c6af126ce22c11be3d946827f2314cf169add6e19d26e7f0730358afae7","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/lug_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":20,"content":[{"type":"heading","content":["Yeremiya Ayigganyizibwa ng’Abuulira"]},{"type":"verse","number":1,"content":["Awo Pasukuli eyali kabona mutabani wa Immeri, eyali omukulu mu yeekaalu ya Mukama, yawulira nga Yeremiya awa obubaka buno,"]},{"type":"verse","number":2,"content":["n’alagira Yeremiya akubibwe. N’asibibwa mu nvuba eyali mu mulyango ogw’ekyengulu ogwa Benyamini ku yeekaalu ya Mukama."]},{"type":"verse","number":3,"content":["Olunaku olwaddirira, nga Pasukuli amusumuludde mu nvuba, Yeremiya n’amugamba nti, “Mukama takyakuyita Pasukuli, naye Magolumissabibu."]},{"type":"verse","number":4,"content":["Kubanga bw’ati bw’ayogera Mukama nti, ‘Laba, ndikufuula eky’entiisa, ekikangabwa, eri ggwe n’eri mikwano gyo bonna; era balifa ekitala ky’abalabe baabwe, n’amaaso go galikiraba, era Yuda yonna ndigiwaayo mu mukono gwa kabaka w’e Babulooni, alibatwala e Babulooni oba okubattisa ekitala."]},{"type":"verse","number":5,"content":["Era ndigabula obugagga bw’ekibuga kino bwonna obulimu, n’eby’omuwendo omungi era n’eby’obugagga byonna ebya bakabaka ba Yuda mu mukono gw’abalabe baabwe. Balibutwala babwetikke ng’omunyago mu Babulooni."]},{"type":"verse","number":6,"content":["Era ggwe Pasukuli, era n’abo bonna ab’omu nnyumba yo balitwalibwa mu busibe, e Babulooni. Eyo gy’olifiira era oziikibwe, ggwe ne mikwano gyo bonna b’otegeezezza obunnabbi obw’obulimba.’ ”"]},{"type":"heading","content":["Okwemulugunya kwa Yeremiya"]},{"type":"verse","number":7,"content":[{"text":"Ayi Mukama, wannimba era n’ennimbibwa,","poem":1},{"text":"wansinza amaanyi n’ompangula.","poem":2},{"text":"Nvumibwa okuva ku makya okuzibya obudde,","poem":1},{"text":"buli muntu ankudaalira.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Buli lwe njogera,","poem":1},{"text":"ndeekaana ne nnangirira akatabanguko n’okuzikirira.","poem":2},{"text":"Kale ekigambo kya Mukama kindeetera","poem":1},{"text":"kuvumwa na kusekererwa buli lunaku.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Naye bwe ŋŋamba nti,","poem":1},{"text":"“Sijja kumwogerako oba okweyongera okwogera mu linnya lye,”","poem":2},{"text":"ekigambo kye mu mutima gwange kiri ng’omuliro ogwaka,","poem":1},{"text":"ogukwekeddwa mu magumba gange.","poem":2},{"text":"Nkooye okukizibiikiriza","poem":1},{"text":"era ddala sisobola.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mpulira bangi nga beegeya nti, “Akabi kali enjuuyi zonna.","poem":1},{"text":"Mumuloope.","poem":2},{"lineBreak":true},{"text":"Leka naffe tumuloope.”","poem":2},{"text":"Mikwano gyange bonna","poem":1},{"text":"banninda ngwe,","poem":2},{"text":"nga bagamba nti, “Oboolyawo anaasobya,","poem":1},{"text":"tumugweko","poem":2},{"lineBreak":true},{"text":"tuwoolere eggwanga.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Naye Mukama ali nange ng’omulwanyi ow’amaanyi ow’entiisa,","poem":1},{"text":"kale abanjigganya kyebaliva bagwa ne bataddayo kuyimirira.","poem":2},{"text":"Baakulemererwa era baswalire ddala","poem":1},{"text":"n’okuswala kwabwe tekulyerabirwa emirembe gyonna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ayi Mukama Katonda ow’Eggye oyo agezesa abatuukirivu,","poem":1},{"text":"alaba ebiri munda mu mitima era n’ebirowoozo,","poem":2},{"text":"kale leka ndabe bw’obawoolererako eggwanga,","poem":1},{"text":"kubanga ensonga zange nzitadde mu mikono gyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Muyimbire Mukama Katonda.","poem":1},{"text":"Mumuwe ettendo.","poem":2},{"text":"Kubanga awonyezza obulamu bw’omunaku","poem":1},{"text":"mu mikono gy’abo abakozi b’ebibi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Lukolimirwe","poem":1},{"text":"olunaku kwe nazaalirwa!","poem":2},{"text":"Olunaku mmange kwe yanzaalira","poem":1},{"text":"luleme kuweebwa mukisa!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Akolimirwe eyaleetera kitange amawulire,","poem":1},{"text":"agaamusanyusa ennyo,","poem":2},{"lineBreak":true},{"text":"ng’agamba nti, “Omwana omulenzi akuzaaliddwa.”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Omusajja oyo abeere ng’ebibuga Mukama bye yamenyaamenya","poem":1},{"text":"awatali kusaasira kwonna.","poem":2},{"text":"Okukaaba kuwulirwe ku makya,","poem":1},{"text":"ne nduulu z’abalwanyi mu ttuntu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yandinzitidde mu lubuto lwa mmange.","poem":1},{"text":"Mmange yandibadde entaana yange,","poem":2},{"lineBreak":true},{"text":"olubuto lwe ne luba lunene emirembe gyonna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Lwaki nava mu lubuto","poem":1},{"text":"okulaba emitawaana n’obuyinike","poem":2},{"lineBreak":true},{"text":"era ennaku zange ne nzimala mu buswavu?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JER/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JER/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JER/19.json","previousChapterAudioLinks":{},"numberOfVerses":18}