{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JER","translationId":"lug_bib","name":"Yeremiya","commonName":"Yeremiya","title":"Ekitabo Ekiyitibwa Yeremiya","order":24,"numberOfChapters":52,"sha256":"f8475c6af126ce22c11be3d946827f2314cf169add6e19d26e7f0730358afae7","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/lug_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":30,"content":[{"type":"heading","content":["Isirayiri Azzibwawo"]},{"type":"verse","number":1,"content":["Kino kye kigambo kya Mukama ekyajjira Yeremiya nti,"]},{"type":"verse","number":2,"content":["“Bw’ati bw’ayogera Mukama Katonda wa Isirayiri nti, ‘Wandiika ku muzingo ebigambo byonna bye njogedde naawe."]},{"type":"verse","number":3,"content":["Ennaku zijja, lwe ndikomyawo abantu bange Isirayiri ne Yuda okuva mu busibe, mbazzeeyo mu nsi gye nawa bajjajjaabwe babeere omwo,’ bw’ayogera Mukama.”"]},{"type":"verse","number":4,"content":["Bino bye bigambo Mukama bye yayogera ebikwata ku Isirayiri ne Yuda nti,"]},{"type":"verse","number":5,"content":["“Bw’ati bw’ayogera Mukama nti,",{"text":"“ ‘Emiranga egy’okutya giwulirwa,","poem":1},{"text":"bulabe teri mirembe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mubuuze mulabe.","poem":1},{"text":"Omusajja alumwa okuzaala?","poem":2},{"text":"Kale lwaki ndaba buli musajja ow’amaanyi","poem":1},{"text":"ng’atadde emikono gye ku lubuto ng’omukazi alumwa okuzaala,","poem":2},{"lineBreak":true},{"text":"buli muntu mu maaso yenna asiiwuuse ng’agenda okufa?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nga luliba lwa nnaku olunaku olwo!","poem":1},{"text":"Tewali lulirufaanana.","poem":2},{"text":"Kiriba kiseera kya kabi eri Yakobo,","poem":1},{"text":"naye aliwona n’akiyitamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ ‘Olulituuka ku lunaku olwo,","poem":1},{"text":"ndimenya ekikoligo okuva mu nsingo zaabwe","poem":2},{"text":"era ne mbasaleko amasamba,","poem":1},{"text":"ab’amawanga nga tebakyaddayo kubafuula baddu,’ bw’ayogera Mukama ow’Eggye.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wabula, bajja kuweerezanga Mukama Katonda waabwe","poem":1},{"text":"ne Dawudi kabaka waabwe","poem":2},{"lineBreak":true},{"text":"gwe ndibayimusiza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Noolwekyo totya, ggwe Yakobo omuweereza wange,","poem":1},{"text":"toggwaamu maanyi ggwe Isirayiri,’","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2},{"text":"‘Ddala ddala ndibalokola okubaggya mu kifo eky’ewala,","poem":1},{"text":"nziggye ezzadde lyammwe okuva mu nsi ey’obuwaŋŋanguse.","poem":2},{"text":"Yakobo aliddamu okuba n’emirembe n’obutebenkevu,","poem":1},{"text":"era tewali n’omu alimutiisatiisa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndi wamu nammwe","poem":1},{"text":"era ndibalokola,","poem":2},{"text":"wadde nga ndizikiririza ddala amawanga gye mbagobedde,","poem":1},{"text":"siribazikiririza ddala mmwe,’","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2},{"text":"Ndibakangavvula n’obwenkanya,","poem":1},{"text":"siribaleka nga temubonerezebbwa n’akatono.","poem":2}]},{"type":"verse","number":12,"content":["“Bw’ati bw’ayogera Mukama nti,",{"text":"“ ‘Ekiwundu kyo tekiwonyezeka,","poem":1},{"text":"Ebisago byo si byakuwona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tewali n’omu wa kukuwolereza,","poem":1},{"text":"tewali ddagala lya kiwundu kyo, toowonyezebwe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abakuyamba bonna bakwerabidde","poem":1},{"text":"tebakufaako.","poem":2},{"text":"Nkukubye ng’omulabe bwe yandikoze","poem":1},{"text":"ne nkubonereza ng’owettima bwe yandikoze,","poem":2},{"text":"kubanga omusango gw’ozzizza munene nnyo","poem":1},{"text":"n’ebibi byo bingi ddala.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lwaki okaaba olw’ekiwundu kyo,","poem":1},{"text":"obulumi bwo obutaliiko ddagala?","poem":2},{"text":"Olw’okwonoona kwo okunene n’ebibi byo ebingi ennyo","poem":1},{"text":"nkuleeseeko ebintu bino.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“ ‘Naye bonna abakumira nabo baliriibwa,","poem":1},{"text":"abalabe bo bonna baligenda mu buwaŋŋanguse.","poem":2},{"text":"Abo abaakunyaga balinyagibwa,","poem":1},{"text":"abo abaakwelula balyelulwa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Naye ndikuzzaawo owone,","poem":1},{"text":"ndiwonya ebiwundu byo,’ bw’ayogera Mukama,","poem":2},{"text":"‘kubanga oyitibwa eyasuulibwa,","poem":1},{"text":"Sayuuni atalina n’omu amufaako.’","poem":2}]},{"type":"verse","number":18,"content":["“Bw’ati bw’ayogera Mukama nti,",{"text":"“ ‘Ndizzaawo eby’obugagga by’eweema za Yakobo","poem":1},{"text":"era mbeere n’ekisa ku kifo kyammwe kye mwabeerangamu.","poem":2},{"text":"Ekibuga kirizimbibwa awaali amatongo gaakyo,","poem":1},{"text":"n’olubiri luzzibwe mu kifo kyalwo ekituufu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mu bo mulivaamu ennyimba ez’okwebaza","poem":1},{"text":"era n’eddoboozi ery’okujaguza,","poem":2},{"text":"ndibaaza, era tebaliba batono,","poem":1},{"text":"ndibawa ekitiibwa, tebalinyoomebwa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Abaana baabwe baliba nga bwe baali mu nnaku ez’edda,","poem":1},{"text":"era n’ebitundu byabwe mwe baabeeranga bizimbibwe nga ndaba.","poem":2},{"lineBreak":true},{"text":"Ndibonereza bonna ababanyigiriza.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Omukulembeze waabwe aliba omu ku bo;","poem":1},{"text":"omukulembeze waabwe aliyimuka okuva mu bo.","poem":2},{"text":"Ndimuleeta wendi era musembeze kumpi nange,","poem":1},{"text":"kubanga ani oyo alyewaayo","poem":2},{"lineBreak":true},{"text":"okunyiikira okubeera okumpi nange?’","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"‘Noolwekyo munaabeeranga bantu bange,","poem":1},{"text":"nange n’abeeranga Katonda wammwe.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Laba, omuyaga gwa Mukama","poem":1},{"text":"gulikuntira mu kiruyi,","poem":2},{"text":"empewo ey’amaanyi","poem":1},{"text":"eyeetooloolera ku mitwe gy’abakozi b’ebibi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Obusungu bwa Mukama obubuubuuka","poem":1},{"text":"tebujja kukoma okutuusa ng’atuukirizza","poem":2},{"lineBreak":true},{"text":"ekigendererwa ky’omutima gwe.","poem":2},{"text":"Mu nnaku ezirijja,","poem":1},{"text":"kino mulikitegeera.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}