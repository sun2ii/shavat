{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JER","translationId":"lug_bib","name":"Yeremiya","commonName":"Yeremiya","title":"Ekitabo Ekiyitibwa Yeremiya","order":24,"numberOfChapters":52,"sha256":"f8475c6af126ce22c11be3d946827f2314cf169add6e19d26e7f0730358afae7","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/lug_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"“Bw’oba odda, ggwe Isirayiri,” bw’ayogera Mukama,","poem":1},{"text":"“eri nze gy’olina okudda.","poem":2},{"text":"Bw’oneggyako eby’omuzizo byonna","poem":1},{"text":"n’otosagaasagana,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"era singa olayira mu mazima, mu bwenkanya","poem":1},{"text":"era mu ngeri entuufu yennyini nti, ‘Ddala nga Mukama bw’ali omulamu,’","poem":2},{"text":"olwo amawanga gonna mu ye mwe gajja okuweerwa omukisa","poem":1},{"text":"era mu ye mwe ganeenyumiririzanga.”","poem":2}]},{"type":"verse","number":3,"content":["Kubanga bw’ati bw’ayogera Mukama eri abantu ba Yuda era n’eri abantu b’omu Yerusaalemi nti,",{"text":"“Mulime ennimiro zammwe ezitali nnime,","poem":1},{"text":"temusiga mu maggwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mukoowoole Mukama,","poem":1},{"text":"mweweeyo mutukuze emitima gyammwe","poem":2},{"lineBreak":true},{"text":"mwe abantu ba Yuda ne Yerusaalemi,","poem":2},{"text":"obusungu bwange buleme okubuubuuka ng’omuliro, olw’ebikolwa byammwe ebibi,","poem":1},{"text":"ne wataba ayinza kubuzikiza.”","poem":2}]},{"type":"heading","content":["Yuda Erumbibwa"]},{"type":"verse","number":5,"content":[{"text":"“Kirangirire mu Yuda","poem":1},{"text":"era okitegeeze mu Yerusaalemi ogambe nti,","poem":2},{"text":"‘Mufuuwe ekkondeere mu nsi yonna!","poem":1},{"text":"Mulangirire nga mugamba nti, Mukuŋŋaane,","poem":2},{"lineBreak":true},{"text":"tuddukire mu bibuga ebiriko ebigo!’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Weereza obubaka eri Sayuuni nti,","poem":1},{"text":"Mudduke temulwa,","poem":2},{"text":"kubanga ndireeta okuzikiriza okuva mu bukiikakkono,","poem":1},{"text":"okuzikiriza okw’amaanyi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Empologoma evudde mu kisaka kyayo,","poem":1},{"text":"omuzikiriza w’amawanga afulumye gy’abeera, azze okumalawo ensi yo.","poem":2},{"text":"Ebibuga byammwe bijja kuzikirizibwa","poem":1},{"text":"bibuleko abibeeramu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Noolwekyo mwambale ebibukutu mukungubage,","poem":1},{"text":"mukube ebiwoobe","poem":2},{"text":"kubanga obusungu bwa Mukama obw’amaanyi tebutuvuddeeko.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mukama n’agamba nti, “Ku lunaku olwo,","poem":1},{"text":"kabaka n’omukungu baliggwaamu omwoyo,","poem":2},{"text":"bakabona basamaalirire","poem":1},{"text":"ne bannabbi beewuunye.”","poem":2}]},{"type":"verse","number":10,"content":["Ne ndyoka ŋŋamba nti, “Woowe Mukama Katonda, mazima olimbidde ddala abantu bano ne Yerusaalemi ng’ogamba nti, ‘Mulibeera n’emirembe,’ ate nga ekitala kiri ddala ku mimiro gyaffe.”"]},{"type":"verse","number":11,"content":["Mu biseera ebyo abantu bano ne Yerusaalemi balibuulirwa nti, “Embuyaga ezookya eziva ku nsozi ezaakala ez’omu ddungu zifuuwa abantu bange nga teziwujja buwuzzi wadde okulongoosa obulongoosa"]},{"type":"verse","number":12,"content":["embuyaga ezisingako awo ze ziriva gye ndi. Era kaakano mbasalira emisango.”"]},{"type":"verse","number":13,"content":[{"text":"Laba ajja ng’ebire,","poem":1},{"text":"amagaali ge ng’empewo y’akazimu,","poem":2},{"text":"embalaasi ze zidduka okusinga empungu;","poem":1},{"text":"zitusanze ffe kubanga tuzikiridde!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ayi Yerusaalemi, naaza omutima gwo guve mu kukola ebibi olyoke olokolebwe.","poem":1},{"text":"Olikomya ddi ebirowoozo ebibi?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Eddoboozi lyawulirwa okuva mu Ddaani,","poem":1},{"text":"nga lirangirira okuzikirizibwa okuva mu nsozi za Efulayimu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Labula amawanga nti ajja:","poem":1},{"text":"kirangirirwe mu Yerusaalemi nti,","poem":2},{"text":"‘Abalabe bajja okuva mu nsi ey’ewala nga bayimba ennyimba ez’entalo","poem":1},{"text":"nga balumba ebibuga bya Yuda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bakyetoolodde ng’abasajja abakuuma ennimiro","poem":1},{"text":"kubanga Yuda yanjeemera,’ ”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Empisa zammwe,","poem":1},{"text":"n’ebikolwa byammwe bye bibaleeseeko bino.","poem":2},{"text":"Kino kye kibonerezo kyammwe.","poem":1},{"text":"Nga kya bulumi!","poem":2},{"lineBreak":true},{"text":"Nga kifumita omutima.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Obulumi, Ayi Obulumi!","poem":1},{"text":"Neenyoolera mu bulumi!","poem":2},{"text":"Ayi obulumi bw’omutima gwange!","poem":1},{"text":"Omutima gunkubagana munda, sisobola kusirika,","poem":2},{"text":"kubanga mpulidde eddoboozi ly’ekkondeere,","poem":1},{"text":"mpulidde enduulu z’olutalo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Okuzikirizibwa kweyongeddeko","poem":1},{"text":"era ensi yonna eyonooneddwa.","poem":2},{"text":"Eweema zange zisaanyiziddwawo mu kaseera buseera,","poem":1},{"text":"n’entimbe zange nga kutemya kikowe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ndituusa ddi nga ndaba bbendera z’olutalo","poem":1},{"text":"n’okuwulira amaloboozi g’amakondeere?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Kubanga abantu bange basirusiru,","poem":1},{"text":"tebammanyi.","poem":2},{"text":"Baana abatalina magezi;","poem":1},{"text":"abatategeera.","poem":2},{"text":"Bakagezimunnyu mu kukola ebibi,","poem":1},{"text":"tebamanyi kukola birungi.”","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Natunuulira ensi,","poem":1},{"text":"nga njereere,","poem":2},{"text":"ate ne ntunula ne ku ggulu,","poem":1},{"text":"ng’ekitangaala kigenze.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Natunuulira agasozi","poem":1},{"text":"nga gajugumira,","poem":2},{"lineBreak":true},{"text":"n’ensozi zonna zaali ziyuuguuma.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Natunula, era laba, waali tewasigadde muntu n’omu,","poem":1},{"text":"era n’ebinyonyi byonna eby’omu bbanga byali bidduse.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Natunula, era laba, ensi ey’ebibala ebingi ng’efuuse ddungu,","poem":1},{"text":"era n’ebibuga byayo byonna nga byonoonese, mu maaso ga Mukama,","poem":2},{"lineBreak":true},{"text":"olw’obusungu bwe obungi.","poem":2}]},{"type":"verse","number":27,"content":["Kubanga bw’atyo bw’ayogera Mukama nti,",{"text":"“Ensi yonna eriyonoonebwa,","poem":1},{"text":"wadde nga sirigizikiririza ddala.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Noolwekyo ensi erikungubaga","poem":1},{"text":"era n’eggulu waggulu lirikwata ekizikiza,","poem":2},{"text":"kubanga njogedde","poem":1},{"text":"era maliridde sijja kwejjusa wadde okukyusaamu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Olw’okuyoogona kw’abeebagazi b’embalaasi n’abalasa obusaale,","poem":1},{"text":"ebibuga byonna biribuna emiwabo,","poem":2},{"text":"abamu beesogge ebisaka;","poem":1},{"text":"n’abalala balinnye waggulu ku njazi.","poem":2},{"text":"Ebibuga byonna birekeddwa ttayo;","poem":1},{"text":"tewali abibeeramu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Okola ki ggwe,","poem":1},{"text":"ggwe eyayonoonebwa?","poem":2},{"lineBreak":true},{"text":"Lwaki oyambala engoye entwakaavu,","poem":2},{"text":"ne weeteekako eby’obugagga ebya zaabu,","poem":1},{"text":"n’amaaso n’ogasiiga langi?","poem":2},{"text":"Omala biseera nga weeyonja.","poem":1},{"text":"Baganzi bo bakunyoomoola; era baagala kukutta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Mpulira okukaaba ng’okw’omukazi alumwa okuzaala,","poem":1},{"text":"okusinda ng’okw’oyo asindika omwana we asooka,","poem":2},{"text":"okukaaba kw’omuwala wa Sayuuni ng’awejjawejja anoonya w’anassiza omukka,","poem":1},{"text":"ng’agolola emikono gye ng’agamba nti,","poem":2},{"text":"“Zinsanze nze, nzirika.","poem":1},{"text":"Obulamu bwange buweereddwayo mu batemu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}