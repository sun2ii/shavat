{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JER","translationId":"lug_bib","name":"Yeremiya","commonName":"Yeremiya","title":"Ekitabo Ekiyitibwa Yeremiya","order":24,"numberOfChapters":52,"sha256":"f8475c6af126ce22c11be3d946827f2314cf169add6e19d26e7f0730358afae7","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/lug_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":46,"content":[{"type":"heading","content":["Obubaka Obukwata ku Misiri"]},{"type":"verse","number":1,"content":["Kino kye kigambo kya Mukama Katonda ekyajjira nnabbi Yeremiya ekikwata ku mawanga:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["Ebikwata ku Misiri:",{"lineBreak":true},"Buno bwe bubaka obukwata ku ggye lya Falaawo Neko kabaka w’e Misiri, eryawangulwa e Kalukemisi, Nebukadduneeza kabaka w’e Babulooni lye yakuba mu mwaka ogwokuna ogw’obufuzi bwa Yekoyakimu mutabani wa Yosiya kabaka wa Yuda ku Mugga Fulaati."]},{"type":"verse","number":3,"content":[{"text":"“Mutegeke engabo zammwe,","poem":1},{"text":"ennene n’entono mukumbe okugenda mu lutalo!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mutegeke embalaasi","poem":1},{"text":"muzeebagale!","poem":2},{"text":"Muyimirire mu bifo byammwe","poem":1},{"text":"n’esseppeewo zammwe!","poem":2},{"text":"Muzigule amafumu,","poem":1},{"text":"mwambale ebizibaawo eby’ebyuma!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kiki kye ndaba?","poem":1},{"text":"Batidde,","poem":2},{"text":"badda ennyuma,","poem":1},{"text":"abalwanyi baabwe bawanguddwa.","poem":2},{"text":"Badduka mu bwangu","poem":1},{"text":"awatali kutunula mabega,","poem":2},{"lineBreak":true},{"text":"era waliwo okufa ku buli luuyi,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Abawenyusi b’embiro tebasobola kuwona","poem":1},{"text":"n’ab’amaanyi tebasobola kwewonya.","poem":2},{"text":"Beesittala","poem":1},{"text":"ne bagwa mu bukiikakkono obw’Omugga Fulaati.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ani oyo ayimuka ng’omugga Kiyira,","poem":1},{"text":"ng’emigga egy’amazzi agabimba?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Misiri eyimuka nga Kiyira,","poem":1},{"text":"ng’emigga egy’amazzi agabimba.","poem":2},{"text":"Agamba nti, ‘Ndisituka ne mbuutikira ensi yonna.","poem":1},{"text":"Ndizikiriza ebibuga n’abantu baabyo.’","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mulumbe, mmwe embalaasi!","poem":1},{"text":"Muzidduse n’amaanyi, mmwe abalwanyi b’oku mbalaasi!","poem":2},{"text":"Mukumbe mmwe abalwanyi,","poem":1},{"text":"abasajja b’e Kuusi ne Puuti","poem":2},{"noteId":2},{"text":"abeettika engabo,","poem":2},{"lineBreak":true},{"text":"abasajja b’e Luudi abakozesa obusaale.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Naye olunaku olwo lwa Mukama, Mukama Katonda ow’Eggye,","poem":1},{"text":"olunaku olw’okuwalanirako eggwanga, olw’okusalira abalabe omusango.","poem":2},{"text":"Ekitala kijja kulya nga kimaliddwa,","poem":1},{"text":"okutuusa nga kyemazeeko ennyonta y’omusaayi.","poem":2},{"text":"Kubanga Mukama, Mukama Katonda ow’Eggye,","poem":1},{"text":"alibawaayo babeere ng’ekiweebwayo mu nsi ey’obukiikakkono ku Mugga Fulaati.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Genda e Gireyaadi ofune eddagala ery’okusaaba,","poem":1},{"text":"ggwe Omuwala Embeerera owa Misiri.","poem":2},{"text":"Naye mwongerera bwereere obujjanjabi;","poem":1},{"text":"temujja kuwonyezebwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Amawanga gajja kuwulira obuswavu bwammwe;","poem":1},{"text":"emiranga gyammwe gijja kujjuza ensi.","poem":2},{"text":"Omulwanyi omu alitomera omulala","poem":1},{"text":"bombi ne bagwa.”","poem":2}]},{"type":"verse","number":13,"content":["Buno bwe bubaka Mukama Katonda bwe yayogera eri nnabbi Yeremiya ku bikwata ku kujja kwa Nebukadduneeza kabaka w’e Babulooni okulumba Misiri:"]},{"type":"verse","number":14,"content":[{"text":"“Langirira kino mu Misiri, era okyogere e Migudooli;","poem":1},{"text":"kirangirire e Tapaneese ne Noofu nti,","poem":2},{"text":"‘Muyimirire mu bifo byammwe mwetegeke","poem":1},{"text":"kubanga ekitala kirya abo ababeetoolodde.’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lwaki abalwanyi bo bagudde wansi?","poem":1},{"text":"Tebasobola kuyimirira, kubanga Mukama Katonda ajja kubasindika wansi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Balyesittala emirundi egiwera;","poem":1},{"text":"baligwiragana.","poem":2},{"text":"Bagambe nti, ‘Yimuka, tuddeyo","poem":1},{"text":"eri abantu baffe era n’ensi zaffe,","poem":2},{"lineBreak":true},{"text":"tuve awali ekitala ky’oyo atunyigiriza.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Eyo gye baliwowogganira nti,","poem":1},{"text":"‘Falaawo kabaka w’e Misiri mulekaanyi bulekaanyi","poem":2},{"lineBreak":true},{"text":"afiiriddwa omukisa gwe.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Nga bwe ndi omulamu,” bw’ayogera oyo Kabaka","poem":1},{"text":"ayitibwa Mukama Katonda ow’Eggye,","poem":2},{"text":"“Waliwo alijja ali nga Taboli wakati mu nsozi,","poem":1},{"text":"nga Kulumeeri ku nnyanja.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Musibe engugu zammwe muwaŋŋanguke,","poem":1},{"text":"mmwe abali mu Misiri","poem":2},{"text":"kubanga Noofu kirifuuka matongo,","poem":1},{"text":"ekiryaawo omutali bantu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Misiri nte nduusi nnungi nnyo,","poem":1},{"text":"naye kawawa avudde mu bukiikakkono azze okumulumba.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"N’abajaasi be abapangise","poem":1},{"text":"bagezze ng’ennyana.","poem":2},{"text":"Nabo bajja kukyuka badduke,","poem":1},{"text":"tebaasobole kuyimirirawo,","poem":2},{"text":"kubanga olunaku olw’ekikangabwa lubajjira,","poem":1},{"text":"ekiseera kyabwe eky’okubonerezebwa kisembedde.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Misiri alikaaba ng’omusota ogudduka,","poem":1},{"text":"omulabe alimulumba mu maanyi,","poem":2},{"text":"amujjire n’embazzi,","poem":1},{"text":"ng’abatemi b’emiti.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Balitema ekibira kye,” bw’ayogera Mukama Katonda,","poem":1},{"text":"“newaakubadde nga kikutte nnyo.","poem":2},{"text":"Bangi n’okusinga enzige,","poem":1},{"text":"tebasobola kubalika.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Muwala wa Misiri aliswazibwa,","poem":1},{"text":"aweebweyo mu mukono gw’abo abava mu bukiikakkono.”","poem":2}]},{"type":"verse","number":25,"content":["Mukama ow’Eggye, Katonda wa Isirayiri, agamba nti, “Nnaatera okuleeta ekibonerezo ku Amoni katonda w’e Tebeesi, ne ku Falaawo, ne ku Misiri, ne ku bakatonda be, ne ku bakabaka be, ne ku abo abeesiga Falaawo."]},{"type":"verse","number":26,"content":["Ndibawaayo eri abo abaagala okubatta, eri Nebukadduneeza kabaka w’e Babulooni n’abakungu be. Wabula oluvannyuma, Misiri eribeeramu abantu nga bwe yali edda,” bw’ayogera Mukama Katonda."]},{"type":"verse","number":27,"content":[{"text":"“Totya, ggwe Yakobo omuweereza wange;","poem":1},{"text":"toggwaamu maanyi, ggwe Isirayiri.","poem":2},{"text":"Ddala ddala ndikununula okuva mu kifo eky’ewala,","poem":1},{"text":"n’ezzadde lyo ndinunule okuva mu nsi ey’obuwaŋŋanguse bwalyo.","poem":2},{"text":"Yakobo aliddamu okufuna emirembe n’atebenkera,","poem":1},{"text":"era tewali alimutiisa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Totya, ggwe Yakobo omuddu wange,","poem":1},{"text":"kubanga ndi naawe,” bw’ayogera Mukama.","poem":2},{"text":"“Wadde nga nazikiririza ddala amawanga gonna","poem":1},{"text":"gye nabasaasaanyiza,","poem":2},{"lineBreak":true},{"text":"naye mmwe siribazikiririza ddala.","poem":2},{"text":"Ndibabonereza naye mu bwenkanya;","poem":1},{"text":"siribaleka nga temubonerezebbwa.”","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Puuli ne Puuti bye bimu. Puuti ye Libiya oba ekitundu ekyetoolodde n’okutuukira ddala ku Somaliya","reference":{"chapter":46,"verse":9}}]},"thisChapterLink":"/api/lug_bib/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}