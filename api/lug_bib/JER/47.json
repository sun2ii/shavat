{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JER","translationId":"lug_bib","name":"Yeremiya","commonName":"Yeremiya","title":"Ekitabo Ekiyitibwa Yeremiya","order":24,"numberOfChapters":52,"sha256":"f8475c6af126ce22c11be3d946827f2314cf169add6e19d26e7f0730358afae7","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/lug_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["Obubaka Obukwata ku Bafirisuuti"]},{"type":"verse","number":1,"content":["Kino kye kigambo kya Mukama Katonda ekyajjira nnabbi Yeremiya ekikwata ku Bafirisuuti nga Falaawo tannalumba Gaza nga kigamba nti:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["Bw’ati bw’ayogera Mukama Katonda nti,",{"text":"“Laba amazzi agatumbira mu bukiikakkono,","poem":1},{"text":"galifuuka omugga ogwanjaala.","poem":2},{"text":"Galyanjaala ku nsi","poem":1},{"text":"ne mu bibuga byonna ebigirimu n’ababituulamu.","poem":2},{"text":"Abantu balikaaba;","poem":1},{"text":"bonna abali mu nsi baliwowoggana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Olw’emisinde gy’embalaasi ezidduka","poem":1},{"text":"n’okufuumuuka kw’amagaali g’omulabe","poem":2},{"lineBreak":true},{"text":"era n’okuwuuma kwa nnamuziga,","poem":2},{"text":"bakitaabwe tebajja kukyuka kuyamba baana baabwe,","poem":1},{"text":"emikono gyabwe gya kulebera.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kubanga olunaku lutuuse","poem":1},{"text":"okuzikiriza Abafirisuuti bonna,","poem":2},{"text":"n’okusalako bonna abandisigaddewo","poem":1},{"text":"abandiyambye Ttuulo ne Sidoni.","poem":2},{"text":"Mukama wa kuzikiriza Abafirisuuti","poem":1},{"text":"abaasigalawo ku mbalama z’ekizinga Kafutoli.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gaza alimwa omutwe gwe ng’akungubaga.","poem":1},{"text":"Asukulooni alisirisibwa.","poem":2},{"text":"Ggwe eyasigala mu kiwonvu,","poem":1},{"text":"olituusa ddi okwesalaasala?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ ‘Ayi ggwe ekitala kya Mukama Katonda, okaaba,","poem":1},{"text":"obudde bunaatuuka ddi owummule?","poem":2},{"text":"Ddayo mu kiraato kyo","poem":1},{"text":"sirika teweenyeenya.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Naye kiyinza kitya okuwummula","poem":1},{"text":"nga Mukama y’akiragidde,","poem":2},{"text":"ng’akiragidde","poem":1},{"text":"okulumba Asukulooni n’olubalama lw’ennyanja?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}