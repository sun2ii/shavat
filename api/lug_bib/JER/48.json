{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JER","translationId":"lug_bib","name":"Yeremiya","commonName":"Yeremiya","title":"Ekitabo Ekiyitibwa Yeremiya","order":24,"numberOfChapters":52,"sha256":"f8475c6af126ce22c11be3d946827f2314cf169add6e19d26e7f0730358afae7","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/lug_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":48,"content":[{"type":"heading","content":["Obubaka Obukwata ku Mowaabu"]},{"type":"verse","number":1,"content":["Ebikwata ku Mowaabu:",{"lineBreak":true},"Bw’ati bw’ayogera Mukama ow’Eggye, Katonda wa Isirayiri nti,",{"text":"“Zikisanze Nebo, kubanga kijja kuzikirizibwa,","poem":1},{"text":"Kiriyasayimu kiswale kiwambibwe,","poem":2},{"lineBreak":true},{"text":"ekigo eky’amaanyi kijja kuswala kimenyebwe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mowaabu taddeyo kutenderezebwa;","poem":1},{"text":"mu Kesuboni abantu balitegeka okugwa kwe, nga boogera nti,","poem":2},{"lineBreak":true},{"text":"‘Mujje, tumalewo ensi eyo.’","poem":2},{"text":"Nammwe, mmwe Madumeni mulisirisibwa,","poem":1},{"text":"n’ekitala kirikugoberera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Muwulirize emiranga egiva e Kolonayimu,","poem":1},{"text":"okwonoonekerwa n’okuzikirizibwa okunene.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mowaabu alimenyebwa;","poem":1},{"text":"abawere ne bakaaba.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bakwata ekkubo erigenda e Lukisi,","poem":1},{"text":"nga bwe bakungubaga","poem":2},{"text":"ku luguudo olugenda e Kolonayimu,","poem":1},{"text":"emiranga egy’okuzikirizibwa giwulirwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mudduke! Muwonye obulamu bwammwe;","poem":1},{"text":"mubeere ng’ebisaka mu ddungu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kubanga mwesiga ebikolwa byammwe n’obugagga bwammwe,","poem":1},{"text":"nammwe mulitwalibwa ng’abaddu,","poem":2},{"text":"ne Kemosi alitwalibwa mu buwaŋŋanguse","poem":1},{"text":"awamu ne bakabona be n’abakungu be.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Omuzikiriza alirumba buli kibuga,","poem":1},{"text":"era tewali kibuga kiriwona.","poem":2},{"text":"Ekiwonvu kiryonoonebwa","poem":1},{"text":"n’olusenyu luzikirizibwe","poem":2},{"lineBreak":true},{"text":"kubanga Mukama ayogedde.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Muwe Mowaabu ebiwaawaatiro abuuke agende","poem":1},{"text":"kubanga alifuuka matongo,","poem":2},{"text":"ebibuga bye birizikirizibwa,","poem":1},{"text":"nga tewali abibeeramu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Akolimirwe oyo agayaalira omulimu gwa Mukama Katonda.","poem":1},{"text":"Akolimirwe oyo aziyiza ekitala kye okuyiwa omusaayi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Mowaabu abadde mirembe okuva mu buvubuka bwe,","poem":1},{"text":"nga wayini gwe batasengezze,","poem":2},{"text":"gwe bataggye mu kibya ekimu okumuyiwa mu kirala,","poem":1},{"text":"tagenzeko mu buwaŋŋanguse.","poem":2},{"text":"Kale awooma ng’edda,","poem":1},{"text":"n’akawoowo ke tekakyukanga.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Naye ennaku zijja,”","poem":1},{"text":"bw’ayogera Mukama Katonda,","poem":2},{"text":"“lwe ndituma basajja bange abaggya wayini mu bibya,","poem":1},{"text":"era balimuyiwa ebweru;","poem":2},{"text":"balittulula ensuwa ze","poem":1},{"text":"baase n’ebibya bye.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Awo Mowaabu alikwatibwa ensonyi olwa Kemosi,","poem":1},{"text":"ng’ennyumba ya Isirayiri bwe yaswala","poem":2},{"lineBreak":true},{"text":"bwe yeesiga Beseri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Oyinza otya okugamba nti, ‘Tuli balwanyi,","poem":1},{"text":"abasajja abazira mu ntalo?’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mowaabu alizindibwa n’ebibuga bye ne bizikirizibwa;","poem":1},{"text":"abavubuka be abato bagende battibwe,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Kabaka, erinnya lye ye Mukama Katonda ow’Eggye.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Okugwa kwa Mowaabu kusembedde;","poem":1},{"text":"akabi katuuse.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mumubeesebeese mwenna abamwetoolodde,","poem":1},{"text":"mwenna abamanyi ettutumu lye;","poem":2},{"text":"mugambe nti, ‘Ng’Omuggo ogw’amaanyi ogw’obwakabaka gumenyese,","poem":1},{"text":"ng’oluga olw’ekitiibwa lumenyese!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Mukke muve mu kitiibwa kyammwe","poem":1},{"text":"mutuule ku ttaka,","poem":2},{"lineBreak":true},{"text":"mmwe abatuuze b’Omuwala w’e Diboni,","poem":2},{"text":"kubanga oyo azikiriza Mowaabu","poem":1},{"text":"alibajjira azikirize ebibuga byammwe ebya bbugwe.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Muyimirire ku luguudo mulabe,","poem":1},{"text":"mmwe ababeera mu Aloweri.","poem":2},{"text":"Mubuuze omusajja adduka, n’omukazi atoloka,","poem":1},{"text":"mubabuuze nti, ‘Kiki ekiguddewo?’","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mowaabu aswadde kubanga amenyesemenyese.","poem":1},{"text":"Mukaabe muleekaane!","poem":2},{"text":"Mulangiririre mu Alunoni","poem":1},{"text":"nti Mowaabu kizikiridde.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Okusala omusango kutuuse mu nsi ey’ensenyi","poem":1},{"text":"ku Koloni ne ku Yaza ne ku Mefaasi,","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ne ku Diboni, ne ku Nebo ne ku Besudibulasayimu,","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ne ku Kiriyasayimu ne ku Besugamuli ne ku Besumyoni;","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ne ku Keriyoosi ne ku Bozula","poem":2},{"lineBreak":true},{"text":"ne ku bibuga byonna eby’omu nsi ya Mowaabu ebiri ewala n’ebiri okumpi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ejjembe lya Mowaabu lisaliddwako,","poem":1},{"text":"n’omukono gwe gumenyese,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Mumutamiize;","poem":1},{"text":"kubanga ajeemedde Mukama.","poem":2},{"text":"Ka Mowaabu yekulukuunyize mu bisesemye bye,","poem":1},{"text":"era asekererwe.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Isirayiri tewagisekereranga?","poem":1},{"text":"Baali bamukutte mu bubbi,","poem":2},{"text":"olyoke onyeenye omutwe gwo ng’omusekerera","poem":1},{"text":"buli lw’omwogerako?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Muve mu bibuga byammwe mubeere mu njazi,","poem":1},{"text":"mmwe ababeera mu Mowaabu.","poem":2},{"text":"Mubeere ng’ejjiba erikola ekisu kyalyo","poem":1},{"text":"ku mumwa gw’empuku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Tuwulidde amalala ga Mowaabu","poem":1},{"text":"amalala ge agayitiridde n’okwemanya,","poem":2},{"text":"okwewulira kwe era n’okweyisa kwe","poem":1},{"text":"era n’okwegulumiza kwe okw’omutima.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Mmanyi obusungu bwe obutaliimu,” bw’ayogera Mukama Katonda,","poem":1},{"text":"“okwenyumiriza kwe okutaliiko kye kugasa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Noolwekyo nkaabirira Mowaabu,","poem":1},{"text":"olwa Mowaabu yenna nkaaba,","poem":2},{"lineBreak":true},{"text":"nkungubagira abasajja ab’e Kirukeresi.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Nkukaabira ggwe amaziga, nga Yazeri bw’akaaba,","poem":1},{"text":"ggwe omuzabbibu gw’e Sibuna.","poem":2},{"text":"Amatabi gammwe geegolola okutuuka ku nnyanja;","poem":1},{"text":"gatuuka ku nnyanja y’e Yazeri.","poem":2},{"text":"Omuzikiriza agudde ku bibala byo","poem":1},{"text":"ebyengedde era n’emizabbibu.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Essanyu n’okujaguza biggiddwa ku nnimiro","poem":1},{"text":"ne ku bibanja bya Mowaabu.","poem":2},{"text":"Nziyizza okukulukuta kwa wayini mu masogolero;","poem":1},{"text":"tewali asogola ng’aleekaana olw’essanyu.","poem":2},{"text":"Newaakubadde nga waliyo okuleekaana,","poem":1},{"text":"okuleekaana okwo si kwa ssanyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Amaloboozi g’okukaaba kwabwe galinnye","poem":1},{"text":"okuva e Kesuboni okutuuka ku Ereyale, n’okutuuka ku Yakazi.","poem":2},{"text":"Okuva e Zowaali okutuuka e Kolanayimu n’e Egulasuserisiya,","poem":1},{"text":"kubanga n’amazzi g’e Nimulimu gakalidde.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ndiggyawo","poem":1},{"text":"abo abawaayo ebiweebwayo mu bifo ebigulumivu e Mowaabu,","poem":2},{"lineBreak":true},{"text":"ne bootereza n’obubaane eri bakatonda baabwe,” bw’ayogera Mukama Katonda.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"“Noolwekyo omutima gwange gukaabira Mowaabu ng’endere;","poem":1},{"text":"gukaaba ng’endere olw’abasajja b’e Kirukesi.","poem":2},{"lineBreak":true},{"text":"Obugagga bwe baafuna buweddewo.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Buli mutwe mumwe","poem":1},{"text":"na buli kirevu kisaliddwako;","poem":2},{"text":"buli mukono gutemeddwako","poem":1},{"text":"na buli kiwato kisibiddwamu ebibukutu.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ku buli kasolya ka nnyumba e Mowaabu","poem":1},{"text":"ne mu bifo awakuŋŋaanirwa,","poem":2},{"text":"tewaliwo kintu kirala wabula okukungubaga,","poem":1},{"text":"kubanga njasizzayasizza Mowaabu","poem":2},{"lineBreak":true},{"text":"ng’ekibya ekitaliiko akyagala,” bw’ayogera Mukama Katonda.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"“Ng’amenyeddwamenyeddwa! Nga bakaaba!","poem":1},{"text":"Mowaabu ng’akyusa omugongo gwe olw’obuswavu!","poem":2},{"text":"Mowaabu afuuse kyakusekererwa,","poem":1},{"text":"ekyekango eri bonna abamwetoolodde.”","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Bw’ati bw’ayogera Mukama Katonda nti:","poem":1},{"lineBreak":true},{"text":"“Laba! Empungu ekka,","poem":1},{"text":"ng’eyanjuluza ebiwaawaatiro byayo ku Mowaabu.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Ebibuga birikwatibwa","poem":1},{"text":"n’ebigo biwambibwe.","poem":2},{"text":"Ku lunaku olwo emitima gy’abalwanyi ba Mowaabu","poem":1},{"text":"giribeera ng’omutima gw’omukazi alumwa okuzaala.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Mowaabu alizikirizibwa,","poem":1},{"text":"kubanga yajeemera Mukama.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Entiisa n’obunnya n’omutego bibalindiridde,","poem":1},{"text":"mmwe abantu ba Mowaabu,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"“Buli alidduka entiisa","poem":1},{"text":"aligwa mu bunnya,","poem":2},{"text":"n’oyo aliba avudde mu bunnya","poem":1},{"text":"alikwatibwa omutego;","poem":2},{"text":"kubanga ndireeta ku Mowaabu","poem":1},{"text":"omwaka gw’okubonaabona kwe,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“Mu kisiikirize kya Kesuboni,","poem":1},{"text":"abadduka mwe bayimirira nga tebalina maanyi,","poem":2},{"text":"kubanga omuliro guvudde mu Kesuboni,","poem":1},{"text":"ennimi z’omuliro wakati mu Sikoni,","poem":2},{"text":"era gw’okezza ebyenyi bya Mowaabu,","poem":1},{"text":"n’obuwanga bw’abo abaleekaana nga beewaanawaana.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Zikusanze ggwe, Mowaabu.","poem":1},{"text":"Abantu b’e Kemosi bazikiridde,","poem":2},{"text":"batabani bo batwaliddwa mu buwaŋŋanguse","poem":1},{"text":"ne bawala bammwe mu busibe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“Ndikomyawo nate obugagga bwa Mowaabu","poem":1},{"text":"mu nnaku ezijja,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda.","poem":2},"Omusango Mowaabu gw’asaliddwa gukoma wano."]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}