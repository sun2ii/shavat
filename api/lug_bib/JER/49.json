{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JER","translationId":"lug_bib","name":"Yeremiya","commonName":"Yeremiya","title":"Ekitabo Ekiyitibwa Yeremiya","order":24,"numberOfChapters":52,"sha256":"f8475c6af126ce22c11be3d946827f2314cf169add6e19d26e7f0730358afae7","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/lug_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":49,"content":[{"type":"heading","content":["Obubaka Obukwata ku Amoni"]},{"type":"verse","number":1,"content":["Ebikwata ku baana ba Amoni bye bino. Bw’ati bw’ayogera Mukama Katonda nti,",{"text":"“Isirayiri terina baana balenzi?","poem":1},{"text":"Terina basika?","poem":2},{"text":"Lwaki Malukamu atutte Gaadi?","poem":1},{"text":"Lwaki abantu be batutte ebibuga by’e Gaadi?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Naye ennaku zijja,” bw’ayogera Mukama Katonda,","poem":1},{"lineBreak":true},{"text":"“lwe ndiraya eŋŋoma ezirangirira olutalo","poem":1},{"text":"ku Labba eky’abawala ba Amoni.","poem":2},{"text":"Kirifuuka ntuumu ya mafunfugu,","poem":1},{"text":"n’ebyalo ebiriraanyeewo byokebwe omuliro.","poem":2},{"text":"Isirayiri eryoke egobere ebweru","poem":1},{"text":"abo abagigoba,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Kaaba, ggwe Kesuboni, kubanga Ayi kizikiridde!","poem":1},{"text":"Mukaabe mmwe abatuuze b’omu Labba!","poem":2},{"text":"Mwesibe ebibukutu mukungubage.","poem":1},{"text":"Mudduke mudde eno n’eri mu bisenge by’ekibuga,","poem":2},{"text":"kubanga Malukamu alitwalibwa mu busibe,","poem":1},{"text":"awamu ne bakabona n’abakungu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lwaki mwenyumiriza olw’ebiwonvu byammwe,","poem":1},{"text":"ne mwenyumiriza olw’ebiwonvu ebigimu?","poem":2},{"text":"Ggwe omuwala atali mwesigwa,","poem":1},{"text":"weesiga obugagga bwo n’ogamba nti,","poem":2},{"lineBreak":true},{"text":"‘Ani alinnumba?’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndikuleetako entiisa,","poem":1},{"text":"okuva mu abo bonna abakwetoolodde,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama, Mukama Katonda ow’Eggye.","poem":2},{"text":"“Buli omu ku mmwe aligobebwa,","poem":1},{"text":"era tewali n’omu alikuŋŋaanya abadduka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Naye oluvannyuma ndikomyawo nate omukisa gy’abaana ba Amoni,”","poem":1},{"text":"bw’ayogera Mukama Katonda.","poem":2}]},{"type":"heading","content":["Obubaka Obukwata ku Edomu"]},{"type":"verse","number":7,"content":["Bw’ati bw’ayogera Mukama Katonda ow’Eggye nti,",{"text":"“Tewakyali magezi mu Temani?","poem":1},{"text":"Abeegendereza babuliddwa okutegeera?","poem":2},{"lineBreak":true},{"text":"Amagezi gaabwe gaweddemu ensa?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mukyuke mudduke mwekweke mu mpuku eziri ewala","poem":1},{"text":"mmwe abatuuze b’e Dedani,","poem":2},{"text":"kubanga ndireeta ekikangabwa ku Esawu,","poem":1},{"text":"mu kiseera bwe ndimubonerereza.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abanozi b’emizabbibu singa bazze gy’oli,","poem":1},{"text":"tebandikuleseeko mizabbibu mibale bubazi?","poem":2},{"text":"Singa ababbi bazze ekiro,","poem":1},{"text":"tebandibbye byonna bye beetaaga?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Naye ndyambula Esawu mwerule;","poem":1},{"text":"ndizuula ebifo bye mwe yeekweka,","poem":2},{"lineBreak":true},{"text":"aleme kwekweka.","poem":2},{"text":"Abaana be, n’ab’eŋŋanda ze n’ab’omuliraano baakuzikirira,","poem":1},{"text":"era wa kuggwaawo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bamulekwa mu mmwe mubaleke, ndibalabirira.","poem":1},{"text":"Ne bannamwandu mu mmwe banneesige.”","poem":2}]},{"type":"verse","number":12,"content":["Bw’ati bw’ayogera Mukama Katonda nti, “Obanga abo abatandinywedde ku kikompe bawaliriziddwa okukinywako, lwaki mmwe temubonerezebwa? Temuuleme kubonerezebwa, mulina okukinywa."]},{"type":"verse","number":13,"content":["Neerayirira,” bw’ayogera Mukama Katonda nti, “Bozula alifuuka matongo era ekibuga ekijjudde entiisa, ekinyoomebwa era ekikolimire, era ebibuga bye byonna biriba matongo emirembe gyonna.”"]},{"type":"verse","number":14,"content":[{"text":"Mpulidde obubaka okuva eri Mukama Katonda.","poem":1},{"text":"Omubaka yatumibwa eri amawanga okugamba nti,","poem":2},{"text":"“Mwekuŋŋaanye mukirumbe!","poem":1},{"text":"Mugolokoke mukole olutalo!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Kaakano ndibafuula aba wansi ennyo mu mawanga,","poem":1},{"text":"abanyoomebwa mu bantu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Entiisa gy’oleeta","poem":1},{"text":"n’amalala g’omutima gwo bikulimbye,","poem":2},{"text":"mmwe ababeera mu bunnya bw’amayinja,","poem":1},{"text":"mmwe ababeera waggulu mu nsozi.","poem":2},{"text":"Wadde nga muzimba ebisu byammwe okubeera waggulu nga eby’empungu,","poem":1},{"text":"ndibawanulayo ne mbasuula wansi,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Edomu kirifuuka kyerolerwa,","poem":1},{"text":"abo bonna abayitawo balyewuunya batye","poem":2},{"lineBreak":true},{"text":"olw’ebiwundu bye byonna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nga Sodomu ne Ggomola bwe byayonoonebwa,","poem":1},{"text":"wamu n’ebibuga ebirala ebiriraanyeewo,” bw’ayogera Mukama Katonda,","poem":2},{"text":"“tewaliba n’omu abibeeramu;","poem":1},{"text":"tewali musajja alikituulamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Ng’empologoma eva mu bisaka by’omu Yoludaani","poem":1},{"text":"okugenda mu muddo omugimu,","poem":2},{"text":"ndigoba Edomu mu nsi ye amangu n’embiro.","poem":1},{"text":"Ani oyo omulonde gwe nnaateekawo akole kino?","poem":2},{"text":"Ani ali nga nze era ani ayinza okunsomooza?","poem":1},{"text":"Era musumba wa ndiga ki ayinza okunjolekera?”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Noolwekyo, muwulire Mukama Katonda kyategese okuleeta ku Edomu,","poem":1},{"text":"kyategekedde abo abatuula mu Temani.","poem":2},{"text":"Endiga ento mu bisibo za kuwalulwa,","poem":1},{"text":"alyonoonera ddala ebisibo byazo ku lwabwe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bwe baligwa ensi erikankana,","poem":1},{"text":"emiranga gyabwe giriwulirwa mu Nnyanja Emyufu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Laba, alibuuka mu bire ng’empungu n’atumbiira,","poem":1},{"text":"n’alyoka akka ng’ayanjululiza ebiwaawaatiro bye ku Bozula.","poem":2},{"text":"Ku lunaku olwo emitima gy’abalwanyi ba Edomu","poem":1},{"text":"giribeewanika ng’ogw’omukazi alumwa okuzaala.","poem":2}]},{"type":"heading","content":["Obubaka Obukwata ku Damasiko"]},{"type":"verse","number":23,"content":["Ebikwata ku Damasiko:",{"text":"“Kamasi ne Alupaadi biweddemu amaanyi,","poem":1},{"text":"kubanga biwulidde amawulire amabi.","poem":2},{"text":"Bakeŋŋentereddwa,","poem":1},{"text":"batabuddwa ng’ennyanja esiikuuse, tebasobola kutereera.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ddamasiko ayongobedde,","poem":1},{"text":"akyuse adduke","poem":2},{"lineBreak":true},{"text":"era okutya kumukutte;","poem":2},{"text":"obubalagaze n’obuyinike bimunyweezezza,","poem":1},{"text":"obulumi nga obw’omukazi alumwa okuzaala.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Lwaki ekibuga ekimanyiddwa tebakidduse,","poem":1},{"text":"ekibuga mwe nsanyukira?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ddala abavubuka baakyo baligwa mu nguudo,","poem":1},{"text":"n’abalwanyi baakyo bonna ku olwo baakusirisibwa,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda ow’Eggye.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"“Ndiyokya bbugwe wa Ddamasiko omuliro;","poem":1},{"text":"gwakumalawo n’embiri za Benukadaadi.”","poem":2}]},{"type":"heading","content":["Obubaka Obukwata ku Kedali ne Kazoli"]},{"type":"verse","number":28,"content":["Bino bye bikwata ku Kedali n’obwakabaka bwa Kazoli, obwalumbibwa Nebukadduneeza kabaka w’e Babulooni. Bw’ati bw’ayogera Mukama Katonda nti,",{"text":"“Golokoka, olumbe Kedali","poem":1},{"text":"ozikirize abantu be bugwanjuba.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Weema zaabwe n’ebisibo byabwe bya kutwalibwa;","poem":1},{"text":"enju zaabwe ziryetikkibwa","poem":2},{"lineBreak":true},{"text":"n’ebintu byabwe byonna n’eŋŋamira zaabwe.","poem":2},{"text":"Abasajja balibakanga nga bawowoggana nti,","poem":1},{"text":"‘Akabi kavudde ku buli ludda!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“Mudduke mwekukume mangu!","poem":1},{"text":"Mubeere mu mpuku empanvu, mmwe abatuuze b’omu Kazoli,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda.","poem":2},{"text":"“Nebukadduneeza kabaka w’e Babulooni abasalidde olukwe;","poem":1},{"text":"ategese okubalumba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Golokoka olumbe eggwanga eriri mu ggandaalo,","poem":1},{"text":"eriri mu kweyagala,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda,","poem":2},{"text":"“eggwanga eritalina miryango gisibwa wadde ebyuma;","poem":1},{"text":"abantu baalyo babeera awo bokka.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Eŋŋamira zaabwe zaakunyagibwa,","poem":1},{"text":"n’amagana gaabwe amanene gatwalibwe.","poem":2},{"text":"Ndibasaasaanya eri empewo, abo abali mu bifo eby’ewala,","poem":1},{"text":"mbaleeteko akabi okuva ku buli ludda,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"“Kazoli alifuuka kifo kya bibe,","poem":1},{"text":"ekifo eky’amatongo eky’emirembe n’emirembe.","poem":2},{"text":"Tewali alikibeeramu;","poem":1},{"text":"tewali muntu alikituulamu.”","poem":2}]},{"type":"heading","content":["Obubaka Obukwata ku Eramu"]},{"type":"verse","number":34,"content":["Kino kye kigambo kya Mukama Katonda ekyajjira nnabbi Yeremiya ekikwata ku Eramu, nga Zeddekiya kabaka wa Yuda kyajje alye obwakabaka."]},{"type":"line_break"},{"type":"verse","number":35,"content":["Bw’ati bw’ayogera Mukama Katonda ow’Eggye nti,",{"text":"“Laba, ndimenya omutego gwa Eramu,","poem":1},{"text":"amaanyi gaabwe mwe gasinga okwesigibwa.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Era ndireeta ku Eramu empewo ennya,","poem":1},{"text":"okuva mu bitundu ebina eby’eggulu;","poem":2},{"text":"ndibasaasaanyiza eri empewo ezo ennya,","poem":1},{"text":"era tewaliba nsi n’emu","poem":2},{"lineBreak":true},{"text":"abawaŋŋanguse ba Eramu gye bataliddukiramu.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Ndimenyeramenyera Eramu mu maaso g’abalabe be,","poem":1},{"text":"mu maaso gaabo abamunoonya okumutta;","poem":2},{"text":"ndibatuusaako ekikangabwa,","poem":1},{"text":"n’obusungu bwange obungi ennyo,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda.","poem":2},{"text":"“Ndibawondera n’ekitala","poem":1},{"text":"okutuusa lwe ndibamalirawo ddala.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Nditeeka entebe yange ey’obwakabaka mu Eramu","poem":1},{"text":"era nzikirize kabaka we n’abakungu be,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“Wabula ekiseera kijja,","poem":1},{"text":"lwe ndiddiramu Eramu,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JER/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JER/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JER/48.json","previousChapterAudioLinks":{},"numberOfVerses":39}