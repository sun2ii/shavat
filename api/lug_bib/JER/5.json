{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JER","translationId":"lug_bib","name":"Yeremiya","commonName":"Yeremiya","title":"Ekitabo Ekiyitibwa Yeremiya","order":24,"numberOfChapters":52,"sha256":"f8475c6af126ce22c11be3d946827f2314cf169add6e19d26e7f0730358afae7","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/lug_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":5,"content":[{"type":"heading","content":["Tewali n’Omu Mugolokofu"]},{"type":"verse","number":1,"content":[{"text":"“Dduka ogende eno n’eri mu nguudo za Yerusaalemi,","poem":1},{"text":"tunulatunula olabe,","poem":2},{"lineBreak":true},{"text":"noonya wonna we bakuŋŋaanira,","poem":2},{"text":"bw’onoosanga omuntu omu bw’ati","poem":1},{"text":"omwesimbu ow’amazima,","poem":2},{"lineBreak":true},{"text":"nnaasonyiwa ekibuga kino.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne bwe boogera nti, ‘Nga Mukama bwali omulamu;’","poem":1},{"text":"baba balayirira bwereere.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ayi Mukama Katonda, amaaso go teganoonya mazima?","poem":1},{"text":"Wabakuba naye ne batawulira bulumi wababetenta,","poem":2},{"lineBreak":true},{"text":"naye ne bagaana okukangavvulwa.","poem":2},{"text":"Beeyongedde kukakanyala, bagubye obwenyi okusinga n’amayinja;","poem":1},{"text":"era bagaanyi okwenenya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne njogera nti,","poem":1},{"text":"“Bano baavu abasirusiru.","poem":2},{"text":"Kubanga tebamanyi kkubo lya Mukama,","poem":1},{"text":"amateeka ga Katonda waabwe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kale ndigenda eri abakulembeze","poem":1},{"text":"njogere nabo;","poem":2},{"text":"Kubanga bamanyi ekkubo lya Mukama,","poem":1},{"text":"amateeka ga Katonda waabwe.”","poem":2},{"text":"Naye nabo bwe batyo baali baamenya dda ekikoligo","poem":1},{"text":"nga baakutula ebisiba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Noolwekyo empologoma eriva mu kibira n’ebalya,","poem":1},{"text":"n’omusege ogw’omu ddungu gulibasaanyaawo.","poem":2},{"text":"Engo erikuumira okumpi n’ebibuga byabwe,","poem":1},{"text":"buli muntu abifuluma ayuzibweyuzibwe;","poem":2},{"text":"Kubanga ebibi byabwe bingi,","poem":1},{"text":"okudda ennyuma kunene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Mbasonyiwe ntya?","poem":1},{"text":"Abaana bammwe banvuddeko,","poem":2},{"lineBreak":true},{"text":"ne balayiririra bakatonda abatali bakatonda.","poem":2},{"text":"Bwe nabaliisa ne bakkuta, badda mu kwenda,","poem":1},{"text":"ne beekuŋŋaanya ku nnyumba z’abenzi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Baali ng’embalaasi ennume ezikkuse ezitaamye,","poem":1},{"text":"buli muntu ng’akaayanira muka munne.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Lwaki sibabonereza olw’ebintu ebyo?","poem":1},{"text":"bw’ayogera Mukama,","poem":2},{"text":"Lwaki siwoolera ggwanga ku nsi","poem":1},{"text":"efaanana bw’etyo?”","poem":2}]},{"type":"heading","content":["Ekiragiro ky’Okulumba Yuda"]},{"type":"verse","number":10,"content":[{"text":"“Yita mu nnimiro z’emizabbibu gyabwe ogyonooneyonoone,","poem":1},{"text":"naye togimalirawo ddala.","poem":2},{"text":"Giggyeeko amatabi gaagyo,","poem":1},{"text":"kubanga si bantu ba Mukama.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kubanga ennyumba ya Isirayiri n’ennyumba ya Yuda","poem":1},{"text":"zifuukidde ddala njeemu gye ndi,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Boogedde eby’obulimba ku Mukama ne bagamba nti,","poem":1},{"text":"“Talina kyajja kukola,","poem":2},{"text":"tewali kabi kanaatugwako,","poem":1},{"text":"era tetujja kulaba wadde kitala oba kyeya.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bannabbi mpewo buwewo","poem":1},{"text":"era ekigambo tekibaliimu;","poem":2},{"lineBreak":true},{"text":"noolwekyo leka kye boogera kikolebwe ku bo.”","poem":2}]},{"type":"verse","number":14,"content":["Noolwekyo bw’ati bw’ayogera Mukama, Katonda ow’Eggye nti,",{"text":"“Kubanga abantu boogedde ebigambo bino,","poem":1},{"text":"ndifuula ekigambo kyange mu kamwa kammwe okuba ng’omuliro,","poem":2},{"lineBreak":true},{"text":"n’abantu bano okuba enku era omuliro gubookye.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Laba, mbaleetera eggwanga eriva ewala,","poem":1},{"text":"ggwe ennyumba ya Isirayiri,” bw’ayogera Mukama.","poem":2},{"text":"Ensi eyaguma ey’edda,","poem":1},{"text":"abantu ab’olulimi lwe mutamanyi","poem":2},{"lineBreak":true},{"text":"aboogera bye mutategeera","poem":2}]},{"type":"verse","number":16,"content":[{"text":"omufuko gwabwe ogw’obusaale guli ng’entaana eyasaamiridde,","poem":1},{"text":"bonna balwanyi nnamige.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Balirya amakungula gammwe n’emmere yammwe;","poem":1},{"text":"balirya batabani bammwe era ne bawala bammwe;","poem":2},{"text":"balye emizabbibu n’emitiini gyammwe,","poem":1},{"text":"ebibuga byammwe ebiriko bbugwe bye mwesiga birizikirizibwa n’ebitala.","poem":2}]},{"type":"verse","number":18,"content":["Bw’ati bw’ayogera Mukama nti, “Naye ne mu nnaku ezo sigenda kubazikiririza ddala kubamalawo."]},{"type":"verse","number":19,"content":["Era abantu bammwe bwe bagamba nti, ‘Lwaki Katonda waffe atukoze ebintu bino byonna?’ Onoobagamba nti, ‘Nga bwe mwanvaako ne muweereza bakatonda abalala mu nsi yammwe, mujja kuweereza bakatonda abagwira mu nsi eteri yammwe.’"]},{"type":"verse","number":20,"content":[{"text":"“Langirira kino mu nnyumba ya Yakobo,","poem":1},{"text":"kirangirire mu Yuda.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wulira kino, mmwe abantu abasirusiru abatalina kutegeera,","poem":1},{"text":"abalina amaaso naye nga tebalaba,","poem":2},{"lineBreak":true},{"text":"abalina amatu naye nga tebawulira.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Temuntya?” bw’ayogera Mukama;","poem":1},{"text":"“temunkankanira?","poem":2},{"text":"Nateeka omusenyu okuba ensalo y’ennyanja,","poem":1},{"text":"olukomera olutaliggwaawo, lwetasobola kuvvuunuka;","poem":2},{"text":"wadde ng’amayengo galukubaakuba, tegasobola kuluwaguza,","poem":1},{"text":"gayinza okuwuluguma, naye tegasobola kuluyitako.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Naye abantu bano balina omutima omwewagguze era omujeemu.","poem":1},{"text":"Bajeemye banvuddeko.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Abateekuba mu kifuba kugamba nti, ‘Tutye Mukama Katonda waffe agaba enkuba,","poem":1},{"lineBreak":true},{"text":"eya ddumbi n’eya ttoggo,","poem":1},{"text":"mu ntuuko zaayo;","poem":2},{"lineBreak":true},{"text":"atugerekera ssabbiiti ez’okukunguliramu.’ ”","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Obutali butuukirivu bwammwe bubibakwese","poem":1},{"text":"ebibi byammwe bibaggyeeko ebirungi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Kubanga abasajja abakozi b’ebibi basangibwa mu bantu bange;","poem":1},{"text":"abagalamira ne balindirira ng’abasajja abatezi b’obunyonyi.","poem":2},{"lineBreak":true},{"text":"Batega abantu omutego.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ng’ebisero ebijjudde ebinyonyi,","poem":1},{"text":"enju zaabwe bwe zijjudde eby’enkwe.","poem":2},{"text":"Noolwekyo bafuuse ab’amaanyi abagagga,","poem":1},{"text":"ne bagejja era ne banyirira.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ekibi kyabwe tekiriiko kkomo, tebasala misango mu bwenkanya,","poem":1},{"text":"abatawolereza bataliiko ba kitaabwe okubayamba basinge emisango,","poem":2},{"lineBreak":true},{"text":"era abatafaayo ku ddembe lya bakateeyamba.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Lwaki sibabonereza olw’ebintu ebyo?”","poem":1},{"text":"bw’ayogera Mukama.","poem":2},{"text":"“Nneme okwesasuza ku ggwanga","poem":1},{"text":"eriri nga eryo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“Ekigambo eky’ekitalo","poem":1},{"text":"era eky’ekivve kigudde mu nsi:","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Bannabbi bawa obunnabbi obw’obulimba,","poem":1},{"text":"bakabona bafugisa buyinza bwabwe ate abantu bange bwe batyo bwe bakyagala.","poem":2},{"text":"Naye ku nkomerero","poem":1},{"text":"munaakola mutya?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JER/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JER/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JER/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}