{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JER","translationId":"lug_bib","name":"Yeremiya","commonName":"Yeremiya","title":"Ekitabo Ekiyitibwa Yeremiya","order":24,"numberOfChapters":52,"sha256":"f8475c6af126ce22c11be3d946827f2314cf169add6e19d26e7f0730358afae7","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/lug_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":50,"content":[{"type":"heading","content":["Obubaka Obukwata ku Babulooni"]},{"type":"verse","number":1,"content":["Kino kye kigambo Mukama Katonda kye yayogerera mu nnabbi Yeremiya ekikwata ku Babulooni n’ensi ey’Abakaludaaya."]},{"type":"verse","number":2,"content":[{"text":"“Buulira mu mawanga era olangirire,","poem":1},{"text":"yimusa bendera olangirire,","poem":2},{"lineBreak":true},{"text":"tolekaayo kintu kyonna ogambe nti,","poem":2},{"text":"‘Babulooni eriwambibwa;","poem":1},{"text":"Beri kiswale,","poem":2},{"lineBreak":true},{"text":"ne Meroddaaki kijjule entiisa.","poem":2},{"text":"Ebifaananyi bya bakatonda abakole n’emikono bijja kuswala","poem":1},{"text":"era bitye.’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Eggwanga okuva mu bukiikakkono lijja kukirumba","poem":1},{"text":"lyonoone ensi y’Abakaludaaya.","poem":2},{"text":"Tewali muntu alisigalamu;","poem":1},{"text":"abantu bonna balikiddukamu era n’ensolo zonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Mu nnaku ezo, era mu kiseera ekyo,”","poem":1},{"text":"bw’ayogera Mukama,","poem":2},{"text":"“abantu ba Isirayiri awamu n’abantu ba Yuda","poem":1},{"text":"balikaaba amaziga nga banoonya Mukama Katonda waabwe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Balibuuza ekkubo eridda e Sayuuni","poem":1},{"text":"era bakyuse obwenyi bwabwe okukitunuulira, nga boogera nti,","poem":2},{"text":"Mujje twesibe ku Mukama Katonda","poem":1},{"text":"mu ndagaano ey’emirembe gyonna","poem":2},{"lineBreak":true},{"text":"etegenda kwerabirwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Abantu bange babadde ndiga ezibuze;","poem":1},{"text":"abasumba baabwe babawabizza","poem":2},{"lineBreak":true},{"text":"ne babatuusa ku kutaataaganira ku nsozi.","poem":2},{"text":"Baava ku lusozi ne badda ku kasozi","poem":1},{"text":"ne beerabira ekifo kyabwe eky’okuwummuliramu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Buli eyabasanganga nga abatulugunya;","poem":1},{"text":"abalabe baabwe ne bagamba nti, ‘Tetulina musango gwe tuzza,","poem":2},{"text":"kubanga baajeemera Mukama Katonda, obuddukiro bwabwe obwa nnama ddala,","poem":1},{"text":"ye Mukama, essuubi lya bakitaabwe.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Mudduke okuva e Babulooni;","poem":1},{"text":"muleke ensi y’Abakaludaaya,","poem":2},{"lineBreak":true},{"text":"mubeere ng’embuzi ezikulembera ekisibo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kubanga, laba, ndigolokosa ekibiina ky’amawanga amanene","poem":1},{"text":"okuva mu nsi ey’obukiikakkono okulumba Babulooni.","poem":2},{"text":"Baliyimirira mu nnyiriri zaabwe bakirumbe,","poem":1},{"text":"bakiwambe nga basinzira mu bukiikakkono.","poem":2},{"text":"Obusaale bwabwe buliba ng’obw’abalwanyi abakugu,","poem":1},{"text":"abataddira awo ngalo nsa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Noolwekyo ensi y’Abakaludaaya erinyagibwa;","poem":1},{"text":"abo bonna abaliginyaga balitwala byonna bye baagala,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Kubanga musanyuka ne mujaguza,","poem":1},{"text":"mmwe abaanyaga omugabo gwabwe,","poem":2},{"text":"kubanga muligita ng’ente enduusi ewuula emmere ey’empeke,","poem":1},{"text":"ne muleekaana ng’embalaasi ennume enkulu,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"nnyammwe alikwatibwa ensonyi;","poem":1},{"text":"oyo eyakuzaala aliswazibwa.","poem":2},{"text":"Aliba ensi esemberayo ddala,","poem":1},{"text":"ensiko, ensi enkalu, eddungu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Olw’obusungu bwa Mukama Katonda tajja kubeeramu bantu,","poem":1},{"text":"naye alisigala matongo.","poem":2},{"text":"Bonna abayita e Babulooni balyewuunya batye era bakisooze","poem":1},{"text":"olw’ebiwundu bye byonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Musimbe ennyiriri okwetooloola Babulooni,","poem":1},{"text":"mwenna abanaanuula omutego.","poem":2},{"text":"Mumulase! Temulekaawo kasaale n’akamu,","poem":1},{"text":"kubanga yajeemera Mukama Katonda.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mumukube olube ku buli ludda.","poem":1},{"text":"Ajeemulukuse, eminaala gye gigwa,","poem":2},{"lineBreak":true},{"text":"n’ebisenge bye bimenyeddwa.","poem":2},{"text":"Kubanga kuno kwe kwesasuza kwa Mukama Katonda,","poem":1},{"text":"mumwesasuzeeko;","poem":2},{"lineBreak":true},{"text":"mumukole nga bw’akoze abalala.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Asiga mumuggye mu Babulooni,","poem":1},{"text":"n’omukunguzi oyo akwata ekiwabyo mumuggye mu makungula.","poem":2},{"text":"Olw’ekitala ky’omujoozi,","poem":1},{"text":"leka buli omu addukire mu nsi y’ewaabwe,","poem":2},{"lineBreak":true},{"text":"buli muntu adde eri abantu be.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Isirayiri kisibo kya ndiga ezisaasaanye,","poem":1},{"text":"empologoma kye zigobye.","poem":2},{"text":"Eyasooka okumulya","poem":1},{"text":"yali kabaka wa Bwasuli;","poem":2},{"text":"eyasembayo okumenya amagumba ge","poem":1},{"text":"yali Nebukadduneeza kabaka w’e Babulooni.”","poem":2}]},{"type":"verse","number":18,"content":["Noolwekyo bw’ati bw’ayogera Mukama ow’Eggye, Katonda wa Isirayiri nti,",{"text":"“Ndibonereza kabaka w’e Babulooni n’ensi ye","poem":1},{"text":"nga bwe nabonereza kabaka w’e Bwasuli.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Naye ndikomyawo Isirayiri mu kisibo kye","poem":1},{"text":"era aliriira ku Kalumeeri ne Basani;","poem":2},{"text":"alikuttira","poem":1},{"text":"ku busozi bwa Efulayimu, ne mu Gireyaadi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mu nnaku ezo, era mu biseera ebyo,” bw’ayogera Mukama Katonda, “omusango ku Isirayiri gulinoonyezebwa, naye tegulibaawo, era n’ebibi bya Yuda birinoonyezebwa, naye tewaliba na kimu, kubanga ndisonyiwa abo bendeseewo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Mulumbe ensi ye Merasayimu","poem":1},{"text":"n’abo abali mu Pekodi.","poem":2},{"text":"Mubagoberere mubatte, mubazikiririze ddala,”","poem":1},{"text":"bw’ayogera Mukama Katonda.","poem":2},{"lineBreak":true},{"text":"“Mukole byonna bye mbalagidde.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Oluyoogaano lw’olutalo luwulirwa mu ggwanga,","poem":1},{"text":"eddoboozi ery’okuzikiriza okunene!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ennyondo y’ensi yonna","poem":1},{"text":"ng’ekubiddwa n’emenyeka!","poem":2},{"text":"Babulooni kifuuse matongo","poem":1},{"text":"mu mawanga!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nakutegera omutego, ggwe Babulooni,","poem":1},{"text":"babagwiikiriza ne babakwata nga tebategedde,","poem":2},{"text":"baakukwata ne bakuwamba","poem":1},{"text":"kubanga wawakanya Mukama.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mukama agguddewo etterekero ly’ebyokulwanyisa bye","poem":1},{"text":"naggyamu ebyokulwanyisa eby’ekiruyi kye,","poem":2},{"text":"kubanga Mukama Katonda ow’Eggye alina omulimu ogw’okukola","poem":1},{"text":"mu nsi y’Abakaludaaya.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mujje mumulumbe mmwe abava mu buli nsonda,","poem":1},{"text":"mumenye ebyagi eby’emmere y’empeke,","poem":2},{"lineBreak":true},{"text":"mumukuŋŋaanye abe ng’entuumo y’emmere y’empeke.","poem":2},{"text":"Mumuzikiririze ddala;","poem":1},{"text":"waleme kusigalawo n’omu ku bo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mutte ennume zaabwe zonna,","poem":1},{"text":"muzitwale zittibwe.","poem":2},{"text":"Zibasanze kubanga olunaku lwabwe lutuuse,","poem":1},{"text":"kye kiseera kyabwe eky’okubonerezebwa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Muwulire eby’abadduka n’abanoonyi b’obubudamu okuva mu Babulooni","poem":1},{"text":"nga balangirira mu Sayuuni","poem":2},{"text":"engeri Mukama Katonda waffe gye yeesasuzza,","poem":1},{"text":"gye yeesasuzza olwa yeekaalu ye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Koowoola abalasi b’obusaale balumbe Babulooni,","poem":1},{"text":"ne bonna abanaanuula omutego.","poem":2},{"text":"Mumwetooloole yenna;","poem":1},{"text":"tewaba n’omu awona.","poem":2},{"text":"Mumusasule olw’ebikolwa bye byonna;","poem":1},{"text":"mumukole nga bwe yakola banne.","poem":2},{"text":"Kubanga yanyooma Mukama,","poem":1},{"text":"Omutukuvu wa Isirayiri.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Noolwekyo, abavubuka be baligwa mu nguudo;","poem":1},{"text":"abaserikale be balisirisibwa ku lunaku olwo,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"“Laba, ndi mulabe wo, ggwe ow’amalala,”","poem":1},{"text":"bw’ayogera Mukama, Mukama Katonda ow’Eggye,","poem":2},{"text":"“Kubanga olunaku lwo lutuuse,","poem":1},{"text":"ekiseera ky’on’obonerezebwamu.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Oyo ow’amalala alyesittala agwe","poem":1},{"text":"era teri n’omu alimuyamba kuyimuka;","poem":2},{"text":"Ndikoleeza omuliro mu bibuga bye","poem":1},{"text":"oguliyokya bonna abamwetoolodde.”","poem":2}]},{"type":"verse","number":33,"content":["Bw’ati bw’ayogera Mukama Katonda ow’Eggye nti,",{"text":"“Abantu ba Isirayiri banyigirizibwa","poem":1},{"text":"awamu n’abantu ba Yuda;","poem":2},{"text":"Bonna ababawambye babanywezezza,","poem":1},{"text":"bagaanye okubata.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Omununuzi waabwe w’amaanyi,","poem":1},{"text":"Mukama Katonda ow’Eggye lye linnya lye.","poem":2},{"text":"Alirwanirira ensonga zaabwe awatali kubuusabuusa,","poem":1},{"text":"alyoke aleete emirembe mu nsi yaabwe;","poem":2},{"lineBreak":true},{"text":"wabula alireeta okutabukatabuka mu bantu ba Babulooni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"“Ekitala kyolekedde Abakaludaaya,”","poem":1},{"text":"bw’ayogera Mukama,","poem":2},{"text":"“n’eri abo ababeera mu Babulooni,","poem":1},{"text":"n’abakungu baabwe n’abasajja baabwe abajjudde amagezi!","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ekitala kyolekedde bannabbi baabwe ab’obulimba!","poem":1},{"text":"Balifuuka balisiriwala,","poem":2},{"text":"ekitala kyolekedde abalwanyi baabwe.","poem":1},{"text":"Balijjula entiisa.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Ekitala kyolekedde embalaasi ze n’amagaali","poem":1},{"text":"n’abagwira bonna abamubeeramu!","poem":2},{"lineBreak":true},{"text":"Balifuuka banafu ng’abakazi.","poem":2},{"text":"Ekitala kyolekedde eby’obugagga bwe!","poem":1},{"text":"Birinyagibwa!","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ekyeya kyolekedde amazzi gaamu!","poem":1},{"text":"Galikalira.","poem":2},{"text":"Kubanga ggwanga erisinza ebifaananyi,","poem":1},{"text":"ebifaananyi ebirigwa eddalu olw’entiisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“Noolwekyo ensolo z’omu nsiko ziribeera eyo n’empisi,","poem":1},{"text":"era eyo ekiwuugulu nakyo gye kiribeera.","poem":2},{"text":"Ekibuga ekyo tekiriddamu kubeeramu bantu","poem":1},{"text":"wadde kutuulwamu bantu emirembe gyonna.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Katonda nga bwe yazikiriza Sodomu ne Ggomola","poem":1},{"text":"n’ebibuga ebiriraanyeewo,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama,","poem":2},{"text":"“bw’atyo bw’alikikola ne mutaba muntu n’omu alikibeeramu;","poem":1},{"text":"tewaliba n’omu alikisigalamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“Laba, eggye liva mu bukiikakkono;","poem":1},{"text":"ensi ey’amaanyi ne bakabaka bangi,","poem":2},{"lineBreak":true},{"text":"bakuŋŋaana okuva ku nkomerero y’ensi.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Balina obusaale n’amafumu,","poem":1},{"text":"bakambwe si ba kisa.","poem":2},{"text":"Beebagadde embalaasi zaabwe","poem":1},{"text":"ne baba ng’amayengo agawuluguma mu nnyanja;","poem":2},{"text":"bali ng’abasajja abalwanyi abajjira mu nnyiriri z’entalo","poem":1},{"text":"okukulumba, ggwe Muwala wa Babulooni.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Kabaka w’e Babulooni afunye amawulire agabafaako,","poem":1},{"text":"n’emikono gye girebedde.","poem":2},{"text":"Entiisa emugwiridde,","poem":1},{"text":"ng’omukazi alumwa okuzaala.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Ng’empologoma eva mu kibira kya Yoludaani","poem":1},{"text":"okugenda mu ddundiro eggimu,","poem":2},{"text":"Babulooni ndimugoba mu nsi ye awatali kutemya kikowe.","poem":1},{"text":"Ani oyo omulonde gwe nnaawa okukola kino?","poem":2},{"text":"Ani ali nga nze, era ani ayinza okunsomooza?","poem":1},{"text":"Era musumba ki ayinza okuyimirirawo okumpakanya?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"Noolwekyo, wulira Mukama ky’ategekedde Babulooni,","poem":1},{"text":"ky’ategese okuleeta ku nsi y’Abakaludaaya.","poem":2},{"text":"Obwana bw’ebisibo byabwe bulitwalibwa,","poem":1},{"text":"alizikiririza ddala ebisibo byabwe ng’abalanga obujeemu bwabwe.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Olw’oluyoogaano lw’okuwambibwa kwa Babulooni, ensi erikankana;","poem":1},{"text":"okukaaba kwe kuliwulirwa mu mawanga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JER/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JER/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JER/49.json","previousChapterAudioLinks":{},"numberOfVerses":46}