:"verse","number":5,"content":[{"text":"Kubanga Yuda ne Isirayiri tebinnalekebwa","poem":1},{"text":"Katonda waabwe, oyo Mukama Katonda ow’Eggye,","poem":2},{"text":"wadde ng’ensi yaabwe esingiddwa omusango","poem":1},{"text":"mu maaso g’Omutukuvu wa Isirayiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Mudduke Babulooni.","poem":1},{"text":"Mudduke okuwonya obulamu bwammwe.","poem":2},{"lineBreak":true},{"text":"Temusaanawo olw’ebibi bye.","poem":2},{"text":"Kiseera kya Mukama okwesasuza;","poem":1},{"text":"alimusasula ekyo ekimusaanira.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Babulooni yali kikompe kya zaabu mu mukono gwa Mukama;","poem":1},{"text":"yatamiiza ensi yonna.","poem":2},{"text":"Amawanga gaanywa wayini we,","poem":1},{"text":"kyegavudde galaluka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Babulooni kirigwa mangu ago ne kimenyekamenyeka.","poem":1},{"text":"Mukikungubagire.","poem":2},{"text":"Munoonye eddagala olw’obulumi bw’akyo","poem":1},{"text":"oboolyawo anaawonyezebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ ‘Twandiwonyezza Babulooni,","poem":1},{"text":"naye tayinza kuwonyezeka.","poem":2},{"text":"Leka tumuleke buli muntu adde mu nsi ye,","poem":1},{"text":"kubanga omusango gwe gutuuse mu bwengula,","poem":2},{"lineBreak":true},{"text":"gusituse gulinnye okutuuka ku bire.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Mukama atulwaniridde,","poem":1},{"text":"mujje tukitegeeze mu Sayuuni","poem":2},{"lineBreak":true},{"text":"ekyo Mukama Katonda waffe ky’akoze.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Muwagale obusaale,","poem":1},{"text":"mukwate engabo!","poem":2},{"text":"Mukama ayungudde bakabaka ab’e Bumeedi,","poem":1},{"text":"kubanga ekigendererwa kye kuzikiriza Babulooni.","poem":2},{"text":"Mukama aliwalana eggwanga,","poem":1},{"text":"aliwalana eggwanga olwa yeekaalu ye.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Muyimuse bendera mwolekere bbugwe wa Babulooni!","poem":1},{"text":"Mwongereko abakuumi,","poem":2},{"text":"muteekeko abaserikale,","poem":1},{"text":"mutegeke okulumba mbagirawo!","poem":2},{"text":"Mukama alituukiriza ekigendererwa bye,","poem":1},{"text":"ensala ye okwolekera abantu ba Babulooni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gwe abeera okumpi n’amazzi amangi,","poem":1},{"text":"omugagga mu bintu eby’omuwendo,","poem":2},{"text":"enkomerero yo etuuse,","poem":1},{"text":"ekiseera kyo eky’okuzikirizibwa kituuse.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mukama Katonda ow’Eggye yeerayiridde ku lulwe;","poem":1},{"text":"ddala ndikujjuza abasajja, ng’ebibinja by’enzige,","poem":2},{"lineBreak":true},{"text":"era balireekaana nga bakuwangudde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Ensi yagikola n’amaanyi ge;","poem":1},{"text":"yagiteekawo n’amagezi ge,","poem":2},{"lineBreak":true},{"text":"n’ayanjuluza eggulu n’okutegeera kwe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bw’abwatuka, amazzi ag’omu ggulu gawuluguma;","poem":1},{"text":"ayimusa ebire okuva ku nkomerero y’ensi.","poem":2},{"text":"Amyansisa eggulu mu nkuba","poem":1},{"text":"era n’aggya empewo mu mawanika ge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Buli muntu talina magezi wadde okutegeera;","poem":1},{"text":"Buli muweesi aswadde olw’ebifaananyi bya bakatonda by’akoze n’emikono gye.","poem":2},{"text":"Ebifaananyi bye bya bulimba;","poem":1},{"text":"tebirina mukka.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tebiriiko kye bigasa, ebisaanye okunyoomebwa","poem":1},{"text":"ebirizikirizibwa nga Mukama azze okusala omusango.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Oyo omugabo gwa Yakobo tali nga bano,","poem":1},{"text":"kubanga yakola ebintu byonna,","poem":2},{"text":"nga mwotwalidde n’eggwanga ly’omugabo gwe,","poem":1},{"text":"n’erinnya lye ye Mukama Katonda ow’Eggye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Muli mbazzi yange,","poem":1},{"text":"ekyokulwanyisa kyange eky’olutalo,","poem":2},{"text":"mmwe be nkozesa okubetenta amawanga,","poem":1},{"text":"mmwe be nkozesa okuzikiriza obwakabaka,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"era ggwe gwe ndikozesa okubetenta embalaasi n’omwebagazi,","poem":1},{"text":"ggwe gwe ndikozesa okubetenta ekigaali n’omuvuzi waakyo,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"era ggwe gwe ndikozesa okubetenta omusajja n’omukazi,","poem":1},{"text":"era ggwe ndikozesa okubetenta omukadde n’omuvubuka,","poem":2},{"lineBreak":true},{"text":"era ggwe gwe ndikozesa okubetenta omuvubuka n’omuwala omuto.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ggwe gwe ndikozesa okubetenta omusumba n’ekisibo kye,","poem":1},{"text":"ggwe gwe ndikozesa okubetenta omulimi n’ente ennume,","poem":2},{"lineBreak":true},{"text":"ggwe gwe ndikozesa okubetenta bagavana n’abakungu.","poem":2}]},{"type":"verse","number":24,"content":["“Ndisasula Babulooni ne bonna ababeeramu nga mulaba olw’ebibi byonna bye baakola mu Sayuuni,” bw’ayogera Mukama."]},{"type":"verse","number":25,"content":[{"text":"“Mbalinako ensonga, ggwe olusozi oluzikiriza,","poem":1},{"text":"mmwe abazikiriza ensi yonna,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2},{"text":"“Ndikugolererako omukono gwange,","poem":1},{"text":"nkusuule ku mayinja g’ensozi,","poem":2},{"lineBreak":true},{"text":"nkufuule olusozi olutakyayaka.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Tewali jjinja lirikuggibwako kukola jjinja lya ku nsonda,","poem":1},{"text":"wadde ejjinja lyonna okukola omusingi,","poem":2},{"lineBreak":true},{"text":"kubanga olibeera matongo emirembe gyonna,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Yimusa bendera mu ggwanga!","poem":1},{"text":"Fuuwa omulere mu mawanga!","poem":2},{"text":"Tegeka amawanga okumulwanyisa;","poem":1},{"text":"koowoola obwakabaka buno bumulumbe:","poem":2},{"lineBreak":true},{"text":"obwa Alalati ne Mini ne Asukenaazi.","poem":2},{"text":"Londa omuduumizi amulumba,","poem":1},{"text":"weereza embalaasi eziri ng’ekibinja ky’enzige.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Teekateeka amawanga okumulwanyisa;","poem":1},{"text":"bakabaka Abameedi,","poem":2},{"text":"bagavana baabwe era n’abakungu baabwe bonna,","poem":1},{"text":"n’amawanga ge bafuga.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ensi ekankana ne yeenyola olw’obulumi,","poem":1},{"text":"kubanga ebigendererwa bya Mukama eri Babulooni tebikyuka,","poem":2},{"text":"okuzikiriza ensi ya Babulooni","poem":1},{"text":"waleme kubaawo agibeeramu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Abalwanyi ba Babulooni balekedde awo okulwana;","poem":1},{"text":"basigadde mu bigo byabwe.","poem":2},{"text":"Baweddemu amaanyi;","poem":1},{"text":"bafuuse nga bakazi.","poem":2},{"text":"Ebifo bye mw’abeera byokeddwa omuliro;","poem":1},{"text":"emitayimbwa gy’oku nzigi ze gimenyeddwa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Matalisi omu agoberera omulala,","poem":1},{"text":"omubaka omu n’agoberera munne,","poem":2},{"text":"okulangirira eri kabaka w’e Babulooni nti","poem":1},{"text":"ekibuga kye kyonna kiwambiddwa,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"entindo z’emigga baziwambye,","poem":1},{"text":"ensenyi ziyidde omuliro,","poem":2},{"lineBreak":true},{"text":"n’abaserikale batidde.”","poem":2}]},{"type":"verse","number":33,"content":["Bw’ati bw’ayogera Mukama ow’Eggye, Katonda wa Isirayiri nti,",{"text":"“Muwala wa Babulooni ali ng’eg