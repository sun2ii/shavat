pe":"line_break"},{"type":"verse","number":41,"content":[{"text":"“Sesaki nga kiriwambibwa,","poem":1},{"text":"okujaguza kw’ensi yonna kugwewo.","poem":2},{"text":"Babulooni kifuuse matongo eri amawanga!","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Ennyanja eribuutikira Babulooni;","poem":1},{"text":"amayengo gaayo agawuluguma galigisaanikira.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Ebibuga bye birisigala matongo,","poem":1},{"text":"ensi enkalu ey’eddungu,","poem":2},{"text":"ensi eteriimu muntu,","poem":1},{"text":"eteyitamu muntu yenna.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Ndibonereza Beri mu Babulooni,","poem":1},{"text":"mmusesemye bye yali amize.","poem":2},{"text":"Amawanga nga tegakyesomba kugenda gyali.","poem":1},{"text":"Ne bbugwe wa Babulooni aligwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“Mukiveemu, abantu bange!","poem":1},{"text":"Mudduke muwonye obulamu bwammwe!","poem":2},{"lineBreak":true},{"text":"Mudduke muwone obusungu bwa Mukama obubuubuuka.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Temutya wadde okuggwaamu amaanyi","poem":1},{"text":"ng’eŋŋambo ziyitiŋŋana mu nsi;","poem":2},{"text":"olugambo olumu lujja omwaka guno, olulala omwaka ogujja,","poem":1},{"text":"eŋŋambo z’entalo mu ggwanga,","poem":2},{"lineBreak":true},{"text":"era ez’omufuzi ng’alwana ne mufuzi munne.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Kubanga ekiseera kijja","poem":1},{"text":"lwe ndibonereza ebifaananyi bya bakatonda ba Babulooni abaakolebwa n’emikono;","poem":2},{"text":"ensi eyo yonna eritabanguka,","poem":1},{"text":"n’emirambo gy’abantu baayo abattiddwa gyonna gibeere omwo.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Eggulu n’ensi ne byonna ebibirimu","poem":1},{"text":"birireekana olw’essanyu olwa Babulooni,","poem":2},{"text":"abalimuzikiriza balimulumba","poem":1},{"text":"okuva mu bukiikakkono,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"“Babulooni kirigwa olw’Abayisirayiri abaafa,","poem":1},{"text":"nga bonna abaafa mu nsi yonna","poem":2},{"lineBreak":true},{"text":"bwe baweddewo olwa Babulooni.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Mmwe abawonye ekitala,","poem":1},{"text":"mwanguwe okugenda!","poem":2},{"text":"Mujjukire Mukama nga muli mu nsi ey’ewala,","poem":1},{"text":"mulowooze ku Yerusaalemi.”","poem":2}]},{"type":"verse","number":51,"content":[{"text":"“Tuweddemu amaanyi","poem":1},{"text":"kubanga tuvumiddwa","poem":2},{"lineBreak":true},{"text":"era tukwatiddwa ensonyi,","poem":2},{"text":"kubanga abagwira bayingidde","poem":1},{"text":"mu bifo ebitukuvu eby’ennyumba ya Mukama.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"“Naye ennaku zijja,” bw’ayogera Mukama,","poem":1},{"text":"“lwe ndibonereza ebifaananyi bya bakatonda be, be yakola n’emikono,","poem":2},{"text":"era mu nsi ye yonna,","poem":1},{"text":"abaliko ebisago balisinda.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Newaakubadde nga Babulooni atuuka ku bire","poem":1},{"text":"era ne yeenyweza n’ebigo bye eby’amaanyi,","poem":2},{"lineBreak":true},{"text":"ndimusindikira abazikiriza,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"“Eddoboozi ly’okukaaba liva mu Babulooni,","poem":1},{"text":"eddoboozi ery’okuzikirira okunene","poem":2},{"lineBreak":true},{"text":"okuva mu nsi y’Abakaludaaya.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Mukama alizikiriza Babulooni,","poem":1},{"text":"alizikiza oluyoogaano lwakyo olunene.","poem":2},{"text":"Amayengo g’abalabe galijja ng’amazzi amangi;","poem":1},{"text":"okuwuluguma kw’amaloboozi kuliwulirwa.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Omuzikiriza alirumba Babulooni;","poem":1},{"text":"abalwanyi be baliwambibwa,","poem":2},{"lineBreak":true},{"text":"n’emitego gyabwe girimenyebwa.","poem":2},{"text":"Kubanga Mukama Katonda asasula,","poem":1},{"text":"alisasula mu bujjuvu.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Nditamiiza abakungu be n’abasajja be abajjudde amagezi,","poem":1},{"text":"ne bagavana, ab’ebitongole awamu n’abalwanyi;","poem":2},{"text":"balyebaka emirembe gyonna era tebalizuukuka,”","poem":1},{"text":"bw’ayogera Kabaka ayitibwa Mukama Katonda ow’Eggye.","poem":2}]},{"type":"verse","number":58,"content":["Bw’ati bw’ayogera Mukama Katonda ow’Eggye nti,",{"text":"“Bbugwe wa Babulooni omunene alisendebwa","poem":1},{"text":"era n’emiryango gye emiwanvu gyokebwe;","poem":2},{"text":"abantu beetawanyiza bwerere nga bafuba,","poem":1},{"text":"okutawaana kw’eggwanga kuliba nku za muliro.”","poem":2}]},{"type":"verse","number":59,"content":["Buno bwe bubaka Yeremiya bwe yawa omukungu Seraya mutabani wa Neriya, mutabani wa Maseya, bwe yagenda e Babulooni ne Zeddekiya kabaka wa Yuda, nga Zeddekiya afuga mu mwaka gwe ogwokuna. Seraya ye yali omu ku bakungu abakulu."]},{"type":"verse","number":60,"content":["Yeremiya yali awandiise mu muzingo ebikangabwa byonna ebyali bigenda okutuuka ku Babulooni, byonna ebyali biwandiikiddwa ebyali bikwata ku Babulooni."]},{"type":"verse","number":61,"content":["Yagamba Seraya nti, “Bw’otuuka mu Babulooni, laba ng’osoma mu ddoboozi ery’omwanguka ebigambo bino byonna."]},{"type":"verse","number":62,"content":["Olwo ogambe nti, ‘Ayi Mukama, ogambye nti olizikiriza ekifo kino, nti tewali nsolo oba muntu alikibeeramu; kibeere matongo emirembe gyonna.’"]},{"type":"verse","number":63,"content":["Bw’omalanga okusoma omuzingo guno gusibeeko ejjinja ogukanyuge mu mugga Fulaati."]},{"type":"verse","number":64,"content":["Olyoke ogambe nti, ‘Bw’ati Babulooni bwalisaanawo aleme kubbulukuka olw’akabi ke ndimuleetako. N’abantu be balizikirira.’ ” Ebigambo bya Yeremiya bikoma awo."]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}