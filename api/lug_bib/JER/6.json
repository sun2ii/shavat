{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JER","translationId":"lug_bib","name":"Yeremiya","commonName":"Yeremiya","title":"Ekitabo Ekiyitibwa Yeremiya","order":24,"numberOfChapters":52,"sha256":"f8475c6af126ce22c11be3d946827f2314cf169add6e19d26e7f0730358afae7","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/lug_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":6,"content":[{"type":"heading","content":["Abeesigwa Bagambibwa Okudduka"]},{"type":"verse","number":1,"content":[{"text":"Mwekuŋŋaanye mudduke mmwe abantu ba Benyamini!","poem":1},{"text":"Mmudduke muve mu Yerusaalemi.","poem":2},{"text":"Fuuwa ekkondeere mu Tekowa,","poem":1},{"text":"era yimusa ebbendera mu Besukakkeremu:","poem":2},{"text":"kubanga akacwano kasinzidde mu bukiikakkono,","poem":1},{"text":"okuzikirira okw’entiisa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndizikiriza omuwala wa Sayuuni,","poem":1},{"text":"omulungi oyo omubalagavu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abasumba balimulumba n’ebisibo byabwe.","poem":1},{"text":"Balimwetoolooza weema zaabwe zimwolekere enjuuyi zonna,","poem":2},{"lineBreak":true},{"text":"buli omu yeezimbire w’ayagala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Mwetegeke mumulwanyise!","poem":1},{"text":"Muyimuke, tumulumbe mu ttuntu!","poem":2},{"text":"Naye, nedda, omusana gugenda guggwaayo,","poem":1},{"text":"n’ebisiikirize by’akawungeezi biwanvuye!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tugende, tulumbe kiro","poem":1},{"text":"tuzikirize amayumba ge.”","poem":2}]},{"type":"verse","number":6,"content":["Bw’ati Mukama Katonda ow’Eggye bw’agamba nti,",{"text":"“Muteme emiti mukole entuumo","poem":1},{"text":"muzingize Yerusaalemi.","poem":2},{"text":"Ekibuga kino kiteekwa okubonerezebwa kyonna,","poem":1},{"text":"kubanga kijjudde bujoozi bwerere.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ng’oluzzi bwe lukulukusa amazzi, bwe kityo bwe kikulukusa ebibi byakyo,","poem":1},{"text":"entalo era n’okuzikirira biwulirwa munda waakyo.","poem":2},{"text":"Obulwadde n’ebiwundu","poem":1},{"text":"bye ndaba buli bbanga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nkulabula,","poem":1},{"text":"ggwe Yerusaalemi,","poem":2},{"text":"emmeeme yange ereme okwawukana naawe,","poem":1},{"text":"si kulwa ng’ofuuka amatongo.”","poem":2}]},{"type":"verse","number":9,"content":["Bw’ati bw’ayogera Mukama Katonda ow’Eggye nti,",{"text":"“Balisusumbulira ddala n’abo abatono","poem":1},{"text":"abaliba basigaddewo mu Isirayiri.","poem":2},{"text":"Ddamu oyise omukono mu matabi","poem":1},{"text":"ng’omunozi we zabbibu bw’akola.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ndyogera eri ani gwe ndirabula?","poem":1},{"text":"Ani alimpuliriza?","poem":2},{"text":"Amatu gaabwe gagaddwa","poem":1},{"text":"ne batasobola kuwulira.","poem":2},{"text":"Ekigambo kya Mukama kiri nga kyakusesa gye bali,","poem":1},{"text":"tebakisanyukira n’akamu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kyenva nzijula ekiruyi","poem":1},{"text":"sikyasobola kukizibiikiriza.","poem":2},{"lineBreak":true},{"text":"“Kiyiwe ku baana abali mu luguudo,","poem":1},{"text":"ne ku bavubuka abakuŋŋaanye;","poem":2},{"text":"abaami awamu n’abakazi n’abakadde","poem":1},{"text":"abo abawezezza emyaka emingi baliwambibwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Enju zaabwe","poem":1},{"text":"ziritwalibwa abalala,","poem":2},{"text":"n’ennimiro zaabwe awamu ne bakazi baabwe;","poem":1},{"text":"kubanga ndigolola omukono gwange ku abo abali mu nsi,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Kubanga okuva ku asembayo wansi okutuusa ku asingayo waggulu,","poem":1},{"text":"buli omu alulunkanira kufuna.","poem":2},{"text":"Nnabbi ne kabona bonna","poem":1},{"text":"boogera eby’obulimba.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ekiwundu ky’abantu bange","poem":1},{"text":"bakijjanjaba ng’ekitali ky’amaanyi.","poem":2},{"text":"Boogera nti, ‘Mirembe, mirembe.’","poem":1},{"text":"So nga tewali mirembe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bakwatibwa ensonyi olw’ebikolwa byabwe eby’emizizo?","poem":1},{"text":"Nedda.","poem":2},{"lineBreak":true},{"text":"Tebakwatibwa nsonyi n’akatono.","poem":2},{"text":"Noolwekyo baligwira wamu n’abo abaligwa;","poem":1},{"text":"balisuulibwa wansi bwe ndibabonereza,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":16,"content":["Kino Mukama ky’agamba nti,",{"text":"“Yimirira mu masaŋŋanzira otunule.","poem":1},{"text":"Buuza amakubo ag’edda, buuza ekkubo eddungi gye liri,","poem":2},{"text":"era otambulire omwo,","poem":1},{"text":"emmeeme yammwe erifuna ekiwummulo.","poem":2},{"lineBreak":true},{"text":"Naye ne mugamba nti, ‘Tetujja kulitambuliramu.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nabateerawo abakuumi babategeeze nti,","poem":1},{"text":"Muwulirize eddoboozi ly’ekkondeere,","poem":2},{"lineBreak":true},{"text":"naye ne mugamba nti, ‘Tetujja kuwuliriza.’","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kale muwulire,","poem":1},{"text":"mmwe amawanga","poem":2},{"lineBreak":true},{"text":"era mulabe mmwe ab’ekkuŋŋaaniro ekyo ekiribatuukako.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wuliriza, ggwe ensi:","poem":1},{"lineBreak":true},{"text":"laba, ndeeta akabi ku bantu bano,","poem":1},{"text":"by’ebibala by’enkwe zaabwe,","poem":2},{"text":"kubanga tebafuddeeyo ku bigambo byange","poem":1},{"text":"n’etteeka lyange baligaanye.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Omugavu oguva e Seeba bampa gwa ki?","poem":1},{"text":"Oba zino emmuli ezakaloosa eziva mu nsi ey’ewala?","poem":2},{"text":"Ebiweebwayo byammwe ebyokebwa sijja kubikkiriza,","poem":1},{"text":"n’essaddaaka zammwe tezinsanyusa.”","poem":2}]},{"type":"verse","number":21,"content":["Noolwekyo bw’ati bw’ayogera Mukama nti,",{"text":"“Laba nditeeka enkonge mu maaso g’abantu bano;","poem":1},{"text":"bakitaabwe ne batabani baabwe bonna bazesittaleko.","poem":2},{"lineBreak":true},{"text":"Muliraanwa we ne mukwano gwe balizikirira.”","poem":2}]},{"type":"verse","number":22,"content":["Bw’ati bw’ayogera Mukama, nti,",{"text":"“Laba, eggye lijja","poem":1},{"text":"eriva mu nsi ey’omu bukiikakkono,","poem":2},{"text":"eggwanga ery’amaanyi","poem":1},{"text":"liyimusibwa okuva ku nkomerero z’ensi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bakutte omutego n’effumu,","poem":1},{"text":"abakambwe abatalina kusaasira.","poem":2},{"text":"Bawulikika ng’ennyanja ewuuma,","poem":1},{"text":"nga beebagadde embalaasi zaabwe:","poem":2},{"text":"bajja ng’abalwanyi mu byambalo by’olutalo","poem":1},{"text":"okulumba ggwe Muwala wa Sayuuni!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Tuwulidde ettutumu lyabwe;","poem":1},{"text":"era emikono gyaffe giweddemu amaanyi","poem":2},{"text":"okulumwa okunene kutukutte","poem":1},{"text":"n’okulumwa ng’okw’omukazi alumwa okuzaala.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Togeza kugenda mu nnimiro","poem":1},{"text":"newaakubadde okutambulira mu kkubo;","poem":2},{"text":"kubanga omulabe abunye wonna wonna","poem":1},{"text":"n’entiisa ejjudde mu bantu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kale nno mmwe abantu,","poem":1},{"text":"mwambale ebibukutu era mwevulunge mu vvu;","poem":2},{"text":"mukungubage ng’abakaabira","poem":1},{"text":"omwana owoobulenzi omu yekka.","poem":2},{"text":"Kubanga oyo agenda okuzikiriza","poem":1},{"text":"ajja kutugwako mavumbavumba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Nkufudde ekigezesa","poem":1},{"text":"abantu bange n’ekyuma,","poem":2},{"text":"osobole okulaba n’okugezesa","poem":1},{"text":"amakubo gaabwe.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Bonna bakyewaggula","poem":1},{"text":"abakakanyavu abagenda bawaayiriza,","poem":2},{"text":"bikomo era kyuma,","poem":1},{"text":"bonna boonoonefu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Emivubo bagifukuta n’amaanyi,","poem":1},{"text":"omuliro gumalawo essasi,","poem":2},{"text":"naye balongoosereza bwereere","poem":1},{"text":"kubanga ababi tebaggyibwamu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Baliyitibwa masengere ga ffeeza,","poem":1},{"text":"kubanga Mukama abalese.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}