{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JER","translationId":"lug_bib","name":"Yeremiya","commonName":"Yeremiya","title":"Ekitabo Ekiyitibwa Yeremiya","order":24,"numberOfChapters":52,"sha256":"f8475c6af126ce22c11be3d946827f2314cf169add6e19d26e7f0730358afae7","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/lug_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["“Mu kiseera ekyo, bw’ayogera Mukama, amagumba ga bakabaka ba Yuda, n’amagumba g’abalangira, n’amagumba ga bakabona, n’amagumba ga bannabbi, n’amagumba g’abatuuze b’omu Yerusaalemi galiggyibwa mu ntaana zaago."]},{"type":"verse","number":2,"content":["Kale galyanikibwa mu musana, eri omwezi n’emmunyeenye ez’omu ggulu, ze baayagala era ne baaweereza era ze baagoberera ne beebuuzaako ne basinza. Tebalikuŋŋaanyizibwa wadde okuziikibwa naye balibeera ng’ebisasiro wansi ku ttaka."]},{"type":"verse","number":3,"content":["N’abantu b’ensi eno ennyonoonyi bw’etyo abalisigalawo, be ndiba nsasaanyizza mu mawanga, balyegomba okufa okusinga okuba abalamu,” bw’ayogera Mukama Katonda ow’Eggye."]},{"type":"heading","content":["Ekibi n’Okubonerezebwa"]},{"type":"verse","number":4,"content":["“Bategeeze nti, Bw’ati bw’ayogera Mukama nti,",{"text":"“Omuntu bw’agwa, tayimuka?","poem":1},{"text":"Oba omuntu bw’ava mu kkubo ettuufu, takyusa n’adda?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kale lwaki abantu bange bano","poem":1},{"text":"banvaako ne bagendera ddala?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nawuliriza n’obwegendereza","poem":1},{"text":"naye tebayogera mazima;","poem":2},{"text":"tewali muntu yenna yeenenya bibi byakoze n’okwebuuza nti,","poem":1},{"text":"‘Kiki kino kye nkoze?’","poem":2},{"text":"Buli muntu akwata kkubo lye","poem":1},{"text":"ng’embalaasi efubutuka ng’etwalibwa mu lutalo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ebinyonyi ebibuukira mu bbanga","poem":1},{"text":"bimanyi ebiseera mwe bitambulira;","poem":2},{"text":"ne kaamukuukulu n’akataayi ne ssekanyolya","poem":1},{"text":"bimanyi ebiseera mwe bikomerawo,","poem":2},{"text":"naye abantu bange","poem":1},{"text":"tebamanyi biragiro bya Mukama.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Muyinza mutya okwogera nti,","poem":1},{"text":"“Tuli bagezi nnyo, n’amateeka ga Mukama tugalina,","poem":2},{"text":"ate nga ekkalaamu y’abawandiisi ey’obulimba","poem":1},{"text":"yeebikyusizza.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abagezigezi baliswala ne bakeŋŋentererwa","poem":1},{"text":"era balitwalibwa.","poem":2},{"text":"Bagaanyi ekigambo kya Mukama,","poem":1},{"text":"magezi ki ge balina?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Noolwekyo bakazi baabwe","poem":1},{"text":"ndibagabira abasajja abalala","poem":2},{"text":"n’ennimiro zaabwe","poem":1},{"text":"zitwalibwe abantu abalala.","poem":2},{"text":"Bonna ba mululu okuva ku asembayo wansi okutuuka ku akomererayo waggulu,","poem":1},{"text":"nnabbi ne kabona bonna balimba ne babba abantu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ebiwundu by’abantu bange babijjanjaba nga tebafaayo,","poem":1},{"text":"babikomya kungulu nga boogera nti,","poem":2},{"lineBreak":true},{"text":"Mirembe, Mirembe, ate nga teri mirembe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Baakwatibwa ensonyi bwe baakola ebivve?","poem":1},{"text":"Nedda tebakwatibwa nsonyi wadde,","poem":2},{"lineBreak":true},{"text":"so tebamanyi wadde okulimbalimba.","poem":2},{"text":"Noolwekyo baligwira mu bagudde,","poem":1},{"text":"balikka lwe balibonerezebwa,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Ndimalirawo ddala amakungula gaabwe,”","poem":1},{"text":"bw’ayogera Mukama.","poem":2},{"lineBreak":true},{"text":"Tewaliba zabbibu,","poem":2},{"text":"na mutiini,","poem":1},{"text":"n’ebikoola byabwe biriwotoka.","poem":2},{"text":"Bye mbawadde","poem":1},{"text":"biribaggyibwako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kiki ekitutuuzizza wano obutuuza?","poem":1},{"text":"Mukuŋŋaane.","poem":2},{"text":"Tuddukire mu bibuga ebiriko bbugwe","poem":1},{"text":"tuzikiririre eyo.","poem":2},{"text":"Mukama Katonda atuwaddeyo tuzikirire","poem":1},{"text":"era atuwadde amazzi agalimu obutwa tuganywe,","poem":2},{"lineBreak":true},{"text":"kubanga twonoonye mu maaso ge.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Twasuubira mirembe","poem":1},{"text":"naye tewali bulungi bwajja;","poem":2},{"text":"twasuubira ekiseera eky’okuwonyezebwa","poem":1},{"text":"naye waaliwo ntiisa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Okukaaba kw’embalaasi z’omulabe kuwulirwa mu Ddaani;","poem":1},{"text":"ensi yonna yakankana olw’okukaaba kw’embalaasi.","poem":2},{"text":"Bajja okuzikiriza","poem":1},{"text":"ensi ne byonna ebigirimu,","poem":2},{"lineBreak":true},{"text":"ekibuga ne bonna abakibeeramu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Laba, ndikusindikira emisota egy’obusagwa,","poem":1},{"text":"amasalambwa g’otasobola kufuga,","poem":2},{"lineBreak":true},{"text":"emisota egyo girikuluma,”","poem":2},{"lineBreak":true},{"text":"bwayogera Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Nnina ennaku etewonyezeka,","poem":1},{"text":"omutima gwange gwennyise.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wuliriza okukaaba kw’abantu bange","poem":1},{"text":"okuva mu nsi ey’ewala.","poem":2},{"text":"“Mukama taliimu mu Sayuuni?","poem":1},{"text":"Kabaka we takyalimu?”","poem":2},{"lineBreak":true},{"text":"“Lwaki bansunguwaza n’ebifaananyi byabwe,","poem":1},{"text":"bakatonda abalala abatagasa?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Amakungula gayise,","poem":1},{"text":"n’ekyeya kiyise,","poem":2},{"lineBreak":true},{"text":"tetulokolebbwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Nnumiziddwa olw’okulumizibwa kwa muwala wange.","poem":1},{"text":"Nkaaba ne nzijula ennaku.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Teri ddagala mu Gireyaadi?","poem":1},{"text":"Teriiyo musawo?","poem":2},{"text":"Lwaki ekiwundu ky’abantu bange","poem":1},{"text":"tekiwonyezebwa?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}