{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JER","translationId":"lug_bib","name":"Yeremiya","commonName":"Yeremiya","title":"Ekitabo Ekiyitibwa Yeremiya","order":24,"numberOfChapters":52,"sha256":"f8475c6af126ce22c11be3d946827f2314cf169add6e19d26e7f0730358afae7","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/lug_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"Woowe, singa omutwe gwange gubadde mugga","poem":1},{"text":"n’amaaso gange luzzi lwa maziga,","poem":2},{"text":"nnandikaabye emisana n’ekiro","poem":1},{"text":"olw’abantu bange be batta!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Woowe singa mbadde n’ekisulo","poem":1},{"text":"ky’abatambuze mu ddungu,","poem":2},{"text":"nnandivudde ku bantu bange","poem":1},{"text":"ne mbaleka","poem":2},{"text":"kubanga bonna benzi,","poem":1},{"text":"bibiina by’abasajja ab’enkwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Bategeka olulimi lwabwe","poem":1},{"text":"ng’omutego ogunasula obulimba;","poem":2},{"text":"bakulaakulanye mu ggwanga","poem":1},{"text":"naye nga tebayimiridde ku mazima,","poem":2},{"text":"kubanga bakola ekibi kino ate ne bongera ekirala;","poem":1},{"text":"era tebammanyi,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Mwegendereze mikwano gyammwe","poem":1},{"text":"era temwesiganga baganda bammwe:","poem":2},{"text":"kubanga buli wa luganda mulimba","poem":1},{"text":"na buli wamukwano agenda awaayiriza buwaayiriza.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Buli muntu alimba muliraanwa we","poem":1},{"text":"era tewali n’omu ayogera mazima.","poem":2},{"text":"Bayigirizza ennimi zaabwe okulimba","poem":1},{"text":"ne beemalamu amaanyi nga bakola ebitali bya butuukirivu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mubeera wakati mu bulimba;","poem":1},{"text":"mu bulimba bwabwe bagaana okummanya,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama Katonda.","poem":2}]},{"type":"verse","number":7,"content":["Noolwekyo bw’ati bw’ayogera Mukama Katonda ow’Eggye nti,",{"text":"“Laba, ndibalongoosa ne mbagezesa,","poem":1},{"text":"kiki ate kye nnaakolera abantu bange","poem":2},{"lineBreak":true},{"text":"kubanga boonoonye?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Olulimi lwabwe kasaale akatta,","poem":1},{"text":"lwogera bya bulimba,","poem":2},{"text":"buli muntu ayogeza mirembe n’akamwa ke,","poem":1},{"text":"naye mu mutima gwe ategeka kumutega.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nneme okubabonereza olw’ebintu bino?”","poem":1},{"text":"bw’ayogera Mukama.","poem":2},{"text":"“Seesasuze ku ggwanga","poem":1},{"text":"eriri nga lino?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ndikaaba ne nkungubagira ensozi","poem":1},{"text":"era ne nkungubagira amalundiro ag’omu ddungu.","poem":2},{"text":"Galekeddwa awo era tegayitwamu,","poem":1},{"text":"n’okukaaba kw’ente tekuwulirwa.","poem":2},{"text":"Ebinyonyi eby’omu bbanga tebikyawulirwa","poem":1},{"text":"n’ensolo ez’omu nsiko zidduse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ndifuula Yerusaalemi entuumu y’ebifunfugu,","poem":1},{"text":"ekisulo ky’ebibe.","poem":2},{"text":"Era ndyonoona ebibuga bya Yuda","poem":1},{"text":"waleme kubaawo muntu yenna abeeramu.”","poem":2}]},{"type":"verse","number":12,"content":["Mugezigezi ki anaayinza okutegeera kino? Ani oyo Mukama gw’abuulidde alyoke akinnyonnyole? Lwaki ensi eyonoonese ng’eddungu ne wataba agiyitamu?"]},{"type":"verse","number":13,"content":["Mukama n’agamba nti, “Kubanga balese amateeka gange, ge nabateekerawo. Tebaŋŋondedde wadde okugoberera amateeka gange."]},{"type":"verse","number":14,"content":["Naye, bagoberedde obukakanyavu bw’emitima gyabwe ne basinza ebifaananyi bya Babaali nga bajjajjaabwe bwe baabayigiriza.”"]},{"type":"verse","number":15,"content":["Noolwekyo bw’ati bw’ayogera Mukama ow’Eggye, Katonda wa Isirayiri nti, “Laba ndiriisa abantu bano emmere ekaawa ne mbanyweesa n’amazzi ag’obutwa."]},{"type":"verse","number":16,"content":["Ndibasaasaanya mu mawanga bakitaabwe ge bataamanya; era ndibasindiikiriza n’ekitala, okutuusa nga mbazikirizza.”"]},{"type":"verse","number":17,"content":["Bw’ati bw’ayogera Mukama Katonda ow’Eggye nti,",{"text":"“Mulowooze kaakano, muyite abakazi abakungubazi, bajje;","poem":1},{"text":"era mutumye abasingayo obumanyirivu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Leka bajje mangu","poem":1},{"text":"batukaabireko","poem":2},{"text":"okutuusa amaaso gaffe lwe ganaakulukuta amaziga,","poem":1},{"text":"n’obukoowekoowe bwaffe ne butiiriika amazzi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kubanga amaloboozi ag’okukungubaga gawuliddwa mu Sayuuni;","poem":1},{"text":"‘Nga tunyagiddwa!","poem":2},{"lineBreak":true},{"text":"Nga tuswadde nnyo!","poem":2},{"text":"Tuteekwa okuva mu nsi yaffe","poem":1},{"text":"kubanga amayumba gaffe gazikiriziddwa.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kaakano mmwe abakazi, muwulirize ekigambo kya Katonda,","poem":1},{"text":"era mutege okutu kwammwe kuwulire ekigambo ky’akamwa ke.","poem":2},{"text":"Muyigirize bawala bammwe okukaaba,","poem":1},{"text":"era buli muntu ayigirize munne okukungubaga.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kubanga okufa kutuyingiridde mu madirisa,","poem":1},{"text":"kuyingidde mu mbiri zaffe,","poem":2},{"text":"okugoba abaana okubaggya ku nguudo,","poem":1},{"text":"n’abavubuka okubaggya mu bifo ebisanyukirwamu.","poem":2}]},{"type":"verse","number":22,"content":["“Yogera,” bw’atyo bw’ayogera Mukama nti,",{"text":"“ ‘Emirambo gy’abasajja abafudde","poem":1},{"text":"gijja kugwa ng’obusa ku ttale","poem":2},{"text":"ng’ebinywa by’eŋŋaano ensale bwe bigwa","poem":1},{"text":"emabega w’omukunguzi nga tebiriiko alonda.’ ”","poem":2}]},{"type":"verse","number":23,"content":["Bw’ati bw’ayogera Mukama nti,",{"text":"“Omusajja omugezi aleme kwenyumiririza mu magezi ge,","poem":1},{"text":"oba omusajja ow’amaanyi okwenyumiririza mu maanyi ge","poem":2},{"lineBreak":true},{"text":"oba omugagga mu bugagga bwe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Naye leka oyo eyeenyumiriza yeenyumirizenga mu kino:","poem":1},{"text":"nti antegeera era ammanyi,","poem":2},{"text":"nti nze Mukama akola ebyekisa","poem":1},{"text":"n’eby’ensonga n’eby’obutuukirivu mu nsi,","poem":2},{"lineBreak":true},{"text":"kubanga mu byo mwe nsanyukira,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":25,"content":["“Ennaku zijja,” bw’ayogera Mukama, “lwe ndibonereza abo bonna abakomole obukomozi mu mubiri:"]},{"type":"verse","number":26,"content":["Misiri, ne Yuda, ne Edomu, n’abaana ba Amoni, ne Mowaabu, era n’abo bonna ababeera mu ddungu mu bifo eby’ewala. Kubanga amawanga gano gonna ddala si makomole, ate era n’ennyumba ya Isirayiri yonna si nkomole mu mutima.”"]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JER/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JER/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JER/8.json","previousChapterAudioLinks":{},"numberOfVerses":26}