{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"“Obulamu bwange mbukyayidde ddala,","poem":1},{"text":"noolwekyo leka nfukumule okwemulugunya kwange,","poem":2},{"lineBreak":true},{"text":"njogerere mu kulumwa kw’emmeeme yange.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nnaagamba Katonda nti, Tonsalira musango ne gunsinga,","poem":1},{"text":"ntegeeza ky’onvunaana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kikusanyusa okunnyigiriza,","poem":1},{"text":"okunyooma omulimu gw’emikono gyo,","poem":2},{"lineBreak":true},{"text":"n’owagira emirimu gy’abakozi b’ebibi?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amaaso go ga mubiri?","poem":1},{"text":"Olaba ng’omuntu bw’alaba?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ennaku zo zisinga ez’omuntu,","poem":1},{"text":"n’emyaka gyo gisinga egy’omuntu,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"olyoke onoonye ebisobyo byange","poem":1},{"text":"era obuulirize ekibi kye nkoze,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"newaakubadde ng’omanyi nti sirina musango","poem":1},{"text":"era nga tewali n’omu ayinza kunzigya mu mukono gwo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Emikono gyo gye gyammumba, gye gyankola.","poem":1},{"text":"Ate kaakano onookyuka okunsanyaawo?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jjukira nti wammumba ng’ebbumba,","poem":1},{"text":"ate kaakano onoonfuula ng’enfuufu?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tewanzitulula ng’amata","poem":1},{"text":"n’onkwasa ng’omuzigo?”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tewannyambaza omubiri n’olususu,","poem":1},{"text":"n’oluka amagumba n’ebinywa n’ongatta?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kale wampa okuganja mu maaso go,","poem":1},{"text":"era walabirira, n’omwoyo gwange.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Naye bino wabikweka mu mutima gwo,","poem":1},{"text":"era mmanyi nga byali mu birowoozo byo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Singa nyonoona, ondaba","poem":1},{"text":"era tewandindese n’otombonereza.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bwe mba nga nsingibbwa omusango,","poem":1},{"text":"zinsanze nze!","poem":2},{"text":"Newaakubadde nga sirina musango, sisobola kuyimusa mutwe gwange,","poem":1},{"text":"kubanga nzijjudde obuswavu era mu kunyigirizibwa kwange, mwe nsaanikiddwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bwe mba ng’asituka, n’onjigga ng’empologoma,","poem":1},{"text":"era n’onnumba n’amaanyi go amangi ennyo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Oleeta abajulizi abajja okunnumiriza,","poem":1},{"text":"era obusungu bwo ne bweyongera gye ndi;","poem":2},{"lineBreak":true},{"text":"amayengo ne gajja okunnumba olutata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Kale lwaki wanziggya mu lubuto lwa mmange?","poem":1},{"text":"Wandindese nga tewannabaawo liiso lyonna lindabyeko.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Singa satondebwa,","poem":1},{"text":"oba singa natwalibwa butereevu okuva mu lubuto ne nzikibwa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ennaku zange entono kumpi teziweddeeko?","poem":1},{"text":"Ndeka mbeeko n’akaseera ak’okusanyuka,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"nga sinnaba kugenda mu kifo eteri kudda,","poem":1},{"text":"ekiri mu nsi ejjudde ekizikiza, n’ekisiikirize eky’ebuziba,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"y’ensi ey’ekizikiza ekikutte, eyeekisiikirize eky’ebuziba","poem":1},{"text":"era n’okutabukatabuka,","poem":2},{"lineBreak":true},{"text":"ng’omusana gwayo guli nga ekizikiza.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}