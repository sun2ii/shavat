{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":11,"content":[{"type":"heading","content":["Zofali Ayogera"]},{"type":"verse","number":1,"content":["Awo Zofali Omunaamasi n’ayogera nti,"]},{"type":"verse","number":2,"content":[{"text":"“Ebigambo ebyo byonna bisigale nga tebiddiddwamu?","poem":1},{"text":"Omwogezi ono anaabalibwa ng’ataliiko musango?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Okwogera kwo okutaliimu kunaatusirisa?","poem":1},{"text":"Oduule bw’otyo wabulewo akunenya?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ogamba Katonda nti, ‘Ebirowoozo byange tebirina nsobi,","poem":1},{"text":"era ndi mutukuvu mu maaso go.’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Naye, singa Katonda ayogera,","poem":1},{"text":"singa abikkula akamwa ke n’akuddamu,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"n’akubikkulira ebyama by’amagezi;","poem":1},{"text":"kubanga amagezi amatuufu ddala galiko enjuuyi bbiri.","poem":2},{"lineBreak":true},{"text":"Manya kino: Katonda n’okwerabira yeerabira ebimu ku bibi byo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Osobola okupima ebyama bya Katonda?","poem":1},{"text":"Oyinza okunoonyereza ku Ayinzabyonna n’omumalayo?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bigulumivu okusinga eggulu, kiki ky’osobola okukola?","poem":1},{"text":"Bikka okusinga obuziba bw’emagombe, kiki ky’osobola okumanya?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Obuwanvu bwabyo businga ensi","poem":1},{"text":"era bugazi okusinga ennyanja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Singa ajja n’akusibira mu kkomera era n’atuuza olukiiko,","poem":1},{"text":"ani ayinza okumuwakanya?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mazima ddala amanya abantu abalimba.","poem":1},{"text":"Bw’alaba ebibi, tabifaako?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Naye omuntu omusirusiru, talifuna magezi,","poem":1},{"text":"ng’omwana gw’endogoyi ogw’omu nsi bwe gutayinza kuzaalibwa nga gusobola okufugibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Naye bw’owaayo omutima gwo gy’ali,","poem":1},{"text":"n’ogolola emikono gyo gy’ali,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"singa oggyawo ekibi ekiri mu mukono gwo,","poem":1},{"text":"n’otokkiriza kibi kubeera mu weema yo,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"olwo onoositula omutwe n’obwenyi bwo nga tokwatibwa nsonyi,","poem":1},{"text":"era oyimirire ng’oli munywevu awatali kutya.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mazima ddala ojja kwerabira emitawaana gyo,","poem":1},{"text":"olijjukira bujjukizi ng’amazzi agaayita edda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Obulamu bujja kwaka okusinga omusana ogw’omu ttuntu,","poem":1},{"text":"n’ekizikiza kijja kufuuka ng’obudde obw’oku nkya.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Olibeera munywevu, kubanga olibeera n’essuubi;","poem":1},{"text":"olitunuulira ebikwetooloodde n’owummulira mu mirembe.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Oligalamira nga tewali n’omu akutiisa,","poem":1},{"text":"era bangi abalikunoonyaako omukisa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Naye amaaso g’abakozi b’ebibi galiremererwa,","poem":1},{"text":"era tebalisobola kuwona,","poem":2},{"lineBreak":true},{"text":"essuubi lyabwe libeere ng’omukka ogw’enkomerero.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}