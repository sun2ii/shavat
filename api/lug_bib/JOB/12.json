{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":12,"content":[{"type":"heading","content":["Yobu Ayanukula"]},{"type":"verse","number":1,"content":["Awo Yobu n’amuddamu nti,"]},{"type":"verse","number":2,"content":[{"text":"“Awatali kubuusabuusa muli bantu.","poem":1},{"text":"Bwe mulifa n’amagezi gammwe ne gafa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Naye nange nnina amagezi ntegeera,","poem":1},{"text":"temunsinga.","poem":2},{"lineBreak":true},{"text":"Ani atabimanyi ebyo byonna?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nfuuse ekisekererwa eri mikwano gyange.","poem":1},{"text":"Nze eyakoowolanga Katonda n’anziramu,","poem":2},{"lineBreak":true},{"text":"ne nsekererwa obusekererwa, ate nga ndi mutukuvu ataliiko musango!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abantu abali mu ddembe lyabwe batera okusekerera abali mu mitawaana,","poem":1},{"text":"ng’ebizibu bwe biba ku abo ababa batuuse awazibu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Weema z’abanyazi tezibaako mutawaana,","poem":1},{"text":"era abo abanyiiza Katonda babeera mu ddembe","poem":2},{"lineBreak":true},{"text":"abo abeetikka katonda waabwe mu mikono gyabwe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Naye buuza ensolo zijja kukuyigiriza,","poem":1},{"text":"oba ebinyonyi eby’omu bbanga binaakubuulira.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Oba yogera n’ettaka linaakusomesa","poem":1},{"text":"oba ebyennyanja eby’omu nnyanja binaakunnyonnyola.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Biki ku bino ebitamanyi nti,","poem":1},{"text":"omukono gwa Mukama gwe gukoze ebyo?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Buli bulamu bwa kitonde buli mu mukono gwe,","poem":1},{"text":"na buli mukka ogussibwa abantu bonna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Okutu tekugezesa bigambo","poem":1},{"text":"ng’olulimi bwe lukomba ku mmere?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Amagezi tegasangibwa mu bakaddiye?","poem":1},{"text":"Okuwangaala tekuleeta kutegeera?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Katonda y’alina amagezi n’amaanyi;","poem":1},{"text":"y’ateesa ebigambo era y’alina okutegeera.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ky’amenya teri ayinza kuddamu kukizimba;","poem":1},{"text":"ky’asiba mu kkomera tekiyinza kuteebwa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bw’aziyiza amazzi, ekyeeya kijja,","poem":1},{"text":"bw’agata gazikiriza ensi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ye, ye nannyini maanyi n’obuwanguzi,","poem":1},{"text":"abalimba n’abalimbibwa bonna babe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Aggyawo abawi b’amagezi nga tebalina kantu,","poem":1},{"text":"abalamuzi n’abafuula abasirusiru.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bakabaka abaggyako enjegere ze beesiba ebiwato byabwe,","poem":1},{"text":"n’abasibamu obukete.","poem":2},{"noteId":6}]},{"type":"verse","number":19,"content":[{"text":"Bakabona abatwala nga tebalina kantu,","poem":1},{"text":"n’asuula abasajja abaanywera.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Aziba emimwa egy’abawi b’amagezi abeesigwa,","poem":1},{"text":"era n’aggyawo okwolesebwa kw’abakadde.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ayiwa ekivume ku bakungu,","poem":1},{"text":"era n’aggya ebyokulwanyisa ku b’amaanyi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Abikkula ebintu eby’ebuziba eby’ekizikiza,","poem":1},{"text":"n’aleeta n’ebisiikirize eby’amaanyi mu kitangaala.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Afuula amawanga okuba ag’amaanyi, era n’agazikiriza;","poem":1},{"text":"agaziya amawanga n’agasaasaanya.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Abakulembeze baamawanga abaggyako okukola ebisaanidde;","poem":1},{"text":"n’abasindika nga bagwirana mu ddungu eritaliimu kkubo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bawammantira mu kizikiza awatali kitangaala;","poem":1},{"text":"abaleetera okutagala ng’abatamiivu.”","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"Obukete bwe bugoye bwokka abaddu abawambe bwe bakkirizibwanga okwambala.","reference":{"chapter":12,"verse":18}}]},"thisChapterLink":"/api/lug_bib/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}