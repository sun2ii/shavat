{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"“Laba, eriiso lyange lyalaba ebyo byonna,","poem":1},{"text":"n’okutu kwange ne kuwulira ne mbitegeera.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kye mumanyi nange kye mmanyi;","poem":1},{"text":"siri wa wansi ku mmwe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Naye neegomba okwogera n’oyo Ayinzabyonna,","poem":1},{"text":"era n’okuleeta ensonga zange mu maaso ga Katonda.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Naye mmwe mumpayiriza;","poem":1},{"text":"muli basawo abatagasa mmwe mwenna!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kale singa musirika!","poem":1},{"text":"Olwo lwe mwandibadde n’amagezi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Muwulire kaakano endowooza yange,","poem":1},{"text":"muwulirize okwegayirira kw’emimwa gyange.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Katonda munaamwogerera nga mwogera ebitali bya butuukirivu?","poem":1},{"text":"Munaamwogerera eby’obulimba?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Munaamulaga ng’ataliiko luuyi,","poem":1},{"text":"munaamuwoleza ensonga ze.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Singa akukebera, anaakusanga oli bulungi?","poem":1},{"text":"Oyinza okumulimba nga bw’oyinza okulimba abantu?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tayinza butakunenya,","poem":1},{"text":"singa osaliriza mu bubba.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ekitiibwa kye ekisukiridde tekyandikutiisizza?","poem":1},{"text":"Entiisa ye teyandikuguddeko?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ebigambo byammwe ebijjukirwa ngero za vvu,","poem":1},{"text":"n’okwewolereza kwammwe kwa bbumba.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Musirike nze njogere;","poem":1},{"text":"kyonna ekinantukako kale kintuukeko.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Lwaki neeteeka mu mitawaana,","poem":1},{"text":"obulamu bwange ne mbutwalira mu mikono gyange?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ne bw’anzita, mu ye mwe nnina essuubi,","poem":1},{"text":"ddala ddala nditwala ensonga zange mu maaso ge.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ddala kino kinaavaamu okusumululwa kwange,","poem":1},{"text":"kubanga teri muntu atatya Katonda ayinza kwetantala kujja mu maaso ge!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Muwulirize ebigambo byange n’obwegendereza;","poem":1},{"text":"amatu gammwe gawulire bye ŋŋamba.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kaakano nga bwe ntegese empoza yange,","poem":1},{"text":"mmanyi nti nzija kwejeerera.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Waliwo ayinza okuleeta emisango gye nvunaanibwa?","poem":1},{"text":"Bwe kiba bwe kityo, nzija kusirika nfe.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ebintu ebyo ebibiri byokka by’oba ompa, Ayi Katonda,","poem":1},{"text":"awo sijja kukwekweka.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nzigyako omukono gwo,","poem":1},{"text":"olekere awo okuntiisatiisa n’okunkangakanga.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kale nno ompite nzija kukuddamu,","poem":1},{"text":"oba leka njogere ggwe onziremu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nsobi meka era bibi bimeka bye nkoze?","poem":1},{"text":"Ndaga ekibi kyange era n’omusango gwange.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Lwaki okweka amaaso go,","poem":1},{"text":"n’onfuula omulabe wo?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Onoobonyaabonya ekikoola ekifuuyiddwa omuyaga?","poem":1},{"text":"Onooyigga ebisasiro ebikaze?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kubanga ompadiikako ebintu ebiruma,","poem":1},{"text":"n’ondeetera okuddamu okwetikka ebibi byange eby’omu buvubuka.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Oteeka ebigere byange mu nvuba,","poem":1},{"text":"era okuuma butiribiri amakubo gange mwe mpita","poem":2},{"lineBreak":true},{"text":"ng’oteeka obubonero ku bisinziiro by’ebigere byange.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Bw’atyo omuntu bw’aggwaawo ng’ekintu ekivundu,","poem":1},{"text":"ng’olugoye oluliiriddwa ennyenje.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}