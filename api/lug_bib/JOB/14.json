{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"“Omuntu azaalibwa omukazi,","poem":1},{"text":"abeera ku nsi akaseera katono era abeera mu kutegana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amulisa ng’ekimuli n’awotoka;","poem":1},{"text":"abulawo mangu ng’ekisiikirize, tabeerera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Otunuulira omuntu afaanana bw’atyo?","poem":1},{"text":"Olimuleeta gy’oli asalirwe omusango?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ani ayinza okuggya ekirongoofu mu kitali kirongoofu?","poem":1},{"text":"Tewali n’omu!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ennaku z’omuntu zaagererwa,","poem":1},{"text":"wagera obungi bw’emyezi gye","poem":2},{"lineBreak":true},{"text":"era n’oteekawo ekkomo ly’atasobola kusukka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kale tomufaako muleke yekka,","poem":1},{"text":"okutuusa lw’alimala okutuukiriza emirimu gye ng’omupakasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Wakiri waliwo essuubi ng’omuti guloka:","poem":1},{"text":"Bwe gutemebwa, guloka nate,","poem":2},{"lineBreak":true},{"text":"era ekikolo kyagwo ekiggya tekifa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Emirandira gyagwo gyandikaddiyidde mu ttaka","poem":1},{"text":"era n’ekikonge ne kifiira mu ttaka,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"naye olw’emirandira okutambula ne ginoonya amazzi kimulisa","poem":1},{"text":"ne kireeta amatabi ng’ekisimbe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Naye omuntu afa era n’agalamizibwa,","poem":1},{"text":"assa ogw’enkomerero n’akoma.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ng’amazzi bwe gaggwa mu nnyanja","poem":1},{"text":"oba omugga bwe gukalira ne guggwaawo,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"bw’atyo omuntu bw’agalamira,","poem":1},{"text":"era n’atasituka okutuusa eggulu bwe linaggwaawo,","poem":2},{"lineBreak":true},{"text":"abantu tebajja kuzuukuka oba kuggyibwa mu tulo twabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Singa kale onkweka emagombe","poem":1},{"text":"era n’onziika okutuusa obusungu bwo lwe buliggwaawo!","poem":2},{"text":"Singa ongerera ekiseera","poem":1},{"text":"n’onzijukira!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Omuntu bw’afa, addamu n’abeera omulamu?","poem":1},{"text":"Ennaku zange zonna ez’okuweereza","poem":2},{"lineBreak":true},{"text":"nnaalindanga okuwona kwange kujje.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Olimpita nange ndikuyitaba;","poem":1},{"text":"olyegomba ekitonde emikono gyo kye gyatonda.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ddala ku olwo bw’olibala ebigere byange,","poem":1},{"text":"naye tolyekaliriza bibi byange.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ebisobyo byange biriba bisibiddwa mu kisawo;","poem":1},{"text":"olibikka ku kibi kyange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Naye ng’olusozi bwe luseebengerera ne luggwaawo,","poem":1},{"text":"era ng’ejjinja bwe liva mu kifo kyalyo,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ng’amazzi bwe gaggwereeza amayinja","poem":1},{"text":"era ng’okwanjaala kwago bwe kutwala ettaka ly’oku nsi;","poem":2},{"lineBreak":true},{"text":"bw’atyo bw’azikiriza essuubi ly’omuntu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Omumalamu amaanyi omuwangula lumu n’aggweerawo ddala;","poem":1},{"text":"okyusa enfaanana ye n’omugoba.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Abaana be bwe bafuna ekitiibwa, takimanya,","poem":1},{"text":"bwe bagwa, takiraba.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Obulamu bw’omubiri gwe bwokka bw’awulira","poem":1},{"text":"ne yeekungubagira yekka.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}