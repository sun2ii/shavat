{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":15,"content":[{"type":"heading","content":["Erifaazi Ayogera"]},{"type":"verse","number":1,"content":["Awo Erifaazi Omutemani n’addamu n’ayogera nti,"]},{"type":"verse","number":2,"content":[{"text":"“Omuntu ow’amagezi yandizzeemu n’amagezi agataliimu,","poem":1},{"text":"oba n’ajjuza olubuto lwe embuyaga ez’ebuvanjuba?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yandiwakanye n’ebigambo ebitaliiko kye bigasa,","poem":1},{"text":"oba okwogera ebigambo ebitalina kye bikola?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Naye onyooma Katonda","poem":1},{"text":"n’oziyiza okwewaayo eri Katonda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kubanga obutali butuukirivu bwo bwe buyigiriza akamwa ko,","poem":1},{"text":"era olonzeewo okukozesa olulimi lw’abalimba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Akamwa ko kennyini ke kakusalira omusango si nze,","poem":1},{"text":"emimwa gyo gyennyini gye gikulumiriza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Gwe wasooka abantu bonna okuzaalibwa?","poem":1},{"text":"Oba ggwe wazaalibwa ensozi nga tezinnabaawo?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ofaayo okuwuliriza okuteesa kwa Katonda?","poem":1},{"text":"Olowooza gwe mugezi wekka?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kiki ky’omanyi kye tutamanyi?","poem":1},{"text":"Kubikkulirwa ki kw’olina ffe kwe tutalina?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ab’envi abakaddiye bali ku ludda lwaffe,","poem":1},{"text":"abasajja abakulu n’okusinga kitaawo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Katonda by’akugambye ebikuzzaamu amaanyi bitono nnyo tebikumala,","poem":1},{"text":"ebigambo ebikubuuliddwa mu bukkakkamu?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lwaki omutima gwo gukubuzizza,","poem":1},{"text":"amaaso go ne gatemereza","poem":2}]},{"type":"verse","number":13,"content":[{"text":"n’olyoka ofuka obusungu bwo eri Katonda,","poem":1},{"text":"n’ofukumula ebigambo bwe bityo okuva mu kamwa ko?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Omuntu ye ani, alyoke abeere omutukuvu,","poem":1},{"text":"oba oyo azaalibwa omukazi nti ayinza okuba omutuukirivu?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Katonda bw’aba tassa bwesige mu batukuvu be,","poem":1},{"text":"n’eggulu ne liba nga si ttukuvu mu maaso ge,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"oba oleeta otya omuntu obuntu, omugwagwa era omuvundu,","poem":1},{"text":"anywa obutali butuukirivu nga amazzi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Mpuliriza nnaakunnyonnyola,","poem":1},{"text":"leka nkubuulire kye ndabye:","poem":2}]},{"type":"verse","number":18,"content":[{"text":"abasajja ab’amagezi kye bagambye","poem":1},{"text":"nga tebalina kye bakwese ku kye baafuna okuva eri bakadde baabwe","poem":2}]},{"type":"verse","number":19,"content":[{"text":"abo bokka abaweebwa ensi","poem":1},{"text":"nga tewali mugwira agiyitamu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Omuntu omukozi w’ebibi, aba mu kubonaabona ennaku ze zonna,","poem":1},{"text":"n’anyigirizibwa emyaka gyonna egyamutegekerwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Amaloboozi agatiisa gajjuza amatu ge;","poem":1},{"text":"byonna bwe biba ng’ebiteredde, abanyazi ne bamulumba.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Atya okuva mu kizikiza adde,","poem":1},{"text":"ekitala kiba kimulinze okumusala.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Adda eno n’eri ng’anoonya ky’anaalya,","poem":1},{"text":"amanyi ng’olunaku olw’ekizikiza lumutuukiridde.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Okweraliikirira n’obubalagaze bimubuutikira,","poem":1},{"text":"bimujjula nga kabaka eyetegekedde olutalo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kubanga anyeenyerezza Katonda ekikonde,","poem":1},{"text":"ne yeegereegeranya ku oyo Ayinzabyonna,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"n’agenda n’ekyejo amulumbe,","poem":1},{"text":"n’engabo ennene enzito.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Wadde nga yenna yagejja amaaso","poem":1},{"text":"ng’ajjudde amasavu mu mbiriizi,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"wakubeera mu bibuga eby’amatongo,","poem":1},{"text":"ne mu bifulukwa,","poem":2},{"lineBreak":true},{"text":"ennyumba ezigwa okufuuka ebifunfugu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Taddeyo kugaggawala,","poem":1},{"text":"n’obugagga bwe tebulirwawo,","poem":2},{"lineBreak":true},{"text":"n’ebintu by’alina tebirifuna mirandira mu ttaka.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Taliwona kizikiza,","poem":1},{"text":"olulimi lw’omuliro lunaakazanga amatabi ge,","poem":2},{"lineBreak":true},{"text":"era omukka gw’omu kamwa gulimugobera wala.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Alemenga okwerimba nga yeesiga ebitaliimu,","poem":1},{"text":"kubanga talina ky’ajja kuganyulwa.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Wa kusasulwa byonna ng’obudde tebunnatuuka,","poem":1},{"text":"n’amatabi ge tegalikula.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Aliba ng’omuzabbibu ogugiddwako emizabbibu egitannaba kwengera,","poem":1},{"text":"ng’omuzeyituuni ogukunkumula ebikoola byagwo.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Kubanga ekibiina ky’abatatya Katonda kinaabeeranga kigumba,","poem":1},{"text":"era omuliro gunaayokyanga weema ezinaabangamu enguzi.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Baba embuto ez’ekibi ne bazaala obutali butuukirivu,","poem":1},{"text":"embuto zaabwe zizaala obulimba.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}