{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":16,"content":[{"type":"heading","content":["Yobu Ayanukula"]},{"type":"verse","number":1,"content":["Yobu n’addamu nti,"]},{"type":"verse","number":2,"content":[{"text":"“Mpulidde ebintu bingi ebiri nga bino;","poem":1},{"text":"mwenna muli mikwano gyange egitagasa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ebigambo byammwe bingi, tebiikome?","poem":1},{"text":"Kiki ekibaluma ne mutalekeraawo kuwakana?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nange nandyogedde nga mmwe, singa mmwe mubadde mu kifo kyange;","poem":1},{"text":"nandyogedde ebigambo ebisengeke obulungi ebibanyiga, ne mbanyeenyeza n’omutwe","poem":2},{"noteId":7},{"text":"gwange.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Naye akamwa kange kandibazizzaamu amaanyi;","poem":1},{"text":"ebigambo eby’essuubi okuva mu kamwa kange byandibaleetedde eddembe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Ate bwe njogera, obulumi bwange tebuwona,","poem":1},{"text":"bwe nsirika era busigalawo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mazima ddala, Ayi Katonda, ommazeemu amaanyi;","poem":1},{"text":"osaanyiririzzaawo ddala ennyumba yange yonna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Onsibye n’onyweza ekinnumiririza ddala,","poem":1},{"text":"obukovvu bwange bwe bukulaga bwe ndi, kirabika ne ku maaso.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Katonda annumba n’obusungu bwe n’anjuzaayuza,","poem":1},{"text":"annumira emba;","poem":2},{"lineBreak":true},{"text":"omulabe wange antunuulira nkaliriza n’amaaso ge agafumita.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abantu bayasamya emimwa gyabwe ne bansekerera;","poem":1},{"text":"bankuŋŋaanirako ne bankuba empi ku matama.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Katonda ampaddeyo eri omukozi w’ebibi,","poem":1},{"text":"era n’ansuula mu mikono gy’ababi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nnali bulungi, n’anjuzaamu wakati;","poem":1},{"text":"yankwata ku nsingo n’ammenyamu.","poem":2},{"text":"Anfudde ssabbaawa,","poem":1}]},{"type":"verse","number":13,"content":[{"text":"abakubi b’obusaale banneetoolodde.","poem":2},{"text":"Awatali kusaasira, afumita ensigo zange,","poem":1},{"text":"omususa gwange ne guyiika ku ttaka.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Annumba, emirundi n’emirundi,","poem":1},{"text":"n’anfubutukirako ng’omulwanyi omuzira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Neetungidde ebikutiya eby’okukungubagiramu,","poem":1},{"text":"ne nkweka obwenyi bwange mu nfuufu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nzenna mmyuse amaaso olw’okukaaba,","poem":1},{"text":"ekisiikirize ekikwafu ennyo kyetoolodde amaaso gange,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"newaakubadde ng’emikono gyange tegirina bibi bye gikoze,","poem":1},{"text":"n’okusaba kwange nga kutukuvu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Ggwe ensi, tobikka ku musaayi gwange;","poem":1},{"text":"nneme okusirisibwa!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Era kaakano omujulirwa wange ali mu ggulu;","poem":1},{"text":"omuwolereza wange ali waggulu nnyo ddala.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mikwano gyange bansekerera,","poem":1},{"text":"amaaso gange nga gakulukusa amaziga eri Katonda.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ku lw’omuntu, yeegayirira eri Katonda","poem":1},{"text":"ng’omuntu bwe yeegayiririra mukwano gwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Emyaka mitono eginaayitawo","poem":1},{"text":"nga sinnakwata lugendo olw’obutadda.”","poem":2}]}],"footnotes":[{"noteId":7,"caller":"+","text":"Okunyeenyeza omuntu omutwe kyalaganga nga bw’onyoomye omuntu oyo. Kyali kivumo","reference":{"chapter":16,"verse":4}}]},"thisChapterLink":"/api/lug_bib/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}