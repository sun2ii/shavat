{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"Omutima gwange gwennyise,","poem":1},{"text":"ennaku zange zisalibbwaako,","poem":2},{"lineBreak":true},{"text":"entaana enninze.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ddala abansekerera bannetoolodde;","poem":1},{"text":"amaaso gange gabeekengera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Ompe, Ayi Katonda akakalu k’onsaba.","poem":1},{"text":"Ani omulala ayinza okunneeyimirira?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ozibye emitima gyabwe obutategeera;","poem":1},{"text":"noolwekyo toobakkirize kuwangula.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Omusajja avumirira mikwano gye olw’empeera","poem":1},{"text":"alireetera amaaso g’abaana be okuziba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Katonda anfudde ekisekererwa eri buli omu,","poem":1},{"text":"anfudde buli omu gw’afujjira amalusu mu maaso.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Amaaso gange gayimbadde olw’okunakuwala;","poem":1},{"text":"omubiri gwange gwonna kaakano guli nga kisiikirize.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abantu ab’amazima beesisiwala olwa kino;","poem":1},{"text":"atalina musango agolokokedde ku oyo atatya Katonda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Naye era abatuukirivu banaakwatanga amakubo gaabwe,","poem":1},{"text":"n’abo ab’emikono emirongoofu baneeyongeranga amaanyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Naye mukomeewo mwenna kaakano, mujje,","poem":1},{"text":"naye siraba muntu mugezi mu mmwe!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ennaku zange ziyise entegeka zange zoonoonese,","poem":1},{"text":"era bwe kityo n’okwegomba kw’omutima gwange.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abantu bano ekiro bakifuula emisana;","poem":1},{"text":"mu kizikiza mwennyini mwe bagambira nti, Ekitangaala kinaatera okujja.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Amagombe bwe gaba nga ge maka mwe nnina essuubi,","poem":1},{"text":"bwe njala obuliri bwange mu kizikiza,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ne ŋŋamba amagombe nti, ‘Ggwe kitange,’","poem":1},{"text":"era n’eri envunyu nti, ‘Ggwe mmange,’ oba nti, ‘Ggwe mwannyinaze,’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"kale essuubi lyange liba ludda wa?","poem":1},{"text":"Ani ayinza okuliraba?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nalyo lirigenda eri enzigi z’emagombe","poem":1},{"text":"Oba tuligenda ffenna mu nfuufu?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}