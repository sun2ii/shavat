{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"heading","content":["Birudaadi Ayanukula"]},{"type":"verse","number":1,"content":["Awo Birudaadi Omusukusi n’ayanukula n’agamba nti,"]},{"type":"verse","number":2,"content":[{"text":"“Mulikomya ddi okufuulafuula ebigambo?","poem":1},{"text":"Muddeemu amagezi, tulyoke twogere.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lwaki tutwalibwa ng’ente","poem":1},{"text":"era ne tulowoozebwa okuba abasirusiru mu maaso gammwe?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ggwe eyeyuzayuza olw’obusungu,","poem":1},{"text":"abantu ensi bagiveeko ku lulwo, oba enjazi zive mu bifo byazo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Ddala etabaaza y’omukozi w’ebibi ezikidde,","poem":1},{"text":"era n’omuliro gw’ekyoto kye tegukyayaka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ekitangaala kivudde mu weema ye;","poem":1},{"text":"n’ettaala eri ku mabbali ge nayo ezikidde.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Amaanyi gamuwedde, ebigere bye tebikyali bya maanyi,","poem":1},{"text":"era enkwe ze, ze zimusuula.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Eky’amazima ebigere bye byamusuula mu kitimba","poem":1},{"text":"era n’atangatanga mu butimba.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Omutego gumukwata ekisinziiro;","poem":1},{"text":"akamasu ne kamunyweeza.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Omuguwa gumukwekerwa mu ttaka;","poem":1},{"text":"akatego kamulindirira mu kkubo lye.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Entiisa emukanga enjuuyi zonna","poem":1},{"text":"era n’emugoba kigere ku kigere.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Emitawaana gimwesunga;","poem":1},{"text":"ekikangabwa kirindiridde okugwa kwe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kirya ebitundu by’olususu lwe;","poem":1},{"text":"omubereberye wa walumbe amulyako emikono n’ebigere.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Aggyibwa mu bukuumi bwa weema ye","poem":1},{"text":"era n’atwalibwa eri kabaka w’ebikangabwa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Omuliro gumalirawo ddala byonna eby’omu weema ye;","poem":1},{"text":"ekibiriiti kyakira mu kifo mw’abeera.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Emirandira gye gikala wansi,","poem":1},{"text":"n’amatabi ge gakala waggulu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ekijjukizo kye kibula ku nsi;","poem":1},{"text":"talina linnya mu nsi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Agobebwa okuva mu kitangaala, agenda mu kizikiza","poem":1},{"text":"n’aggyibwa mu nsi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Talina mwana wadde omuzzukulu mu bantu be,","poem":1},{"text":"newaakubadde ekifo mwabeera.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Abantu ab’ebugwanjuba beewuunya ebyamutuukako;","poem":1},{"text":"n’ab’ebuvanjuba ne bakwatibwa ekikangabwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ddala bw’etyo bw’ebeera ennyumba y’omukozi w’ebibi;","poem":1},{"text":"bwe gaba bwe gatyo amaka g’oyo atamanyi Katonda.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}