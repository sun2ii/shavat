{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":19,"content":[{"type":"heading","content":["Yobu Amuddamu"]},{"type":"verse","number":1,"content":["Awo Yobu n’addamu nti:"]},{"type":"verse","number":2,"content":[{"text":"“Mulikomya ddi okunnyigiriza","poem":1},{"text":"ne mummenya n’ebigambo?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Emirundi kkumi nga munvuma;","poem":1},{"text":"temukwatiddwa nsonyi kunnumba.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bwe kiba nga kituufu nti nawaba,","poem":1},{"text":"obukyamu bwange, bwange nzekka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bwe muba munneegulumiririzaako","poem":1},{"text":"ne mukozesa obulumi bwange okunfeebya,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"mumanye nga Katonda ankoze bubi","poem":1},{"text":"era anzingizza mu kitimba kye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Wadde nga nkaaba nti, ‘Mpisiddwa bubi,’ siddibwamu;","poem":1},{"text":"ne bwe nkuba enduulu, tewali antaasa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Azibye ekkubo lyange sisobola kuyita;","poem":1},{"text":"amakubo gange agalese mu kizikiza.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anziggyeeko ekitiibwa kyange","poem":1},{"text":"n’anziggyako n’engule ku mutwe gwange.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Anjuzaayuza ku buli ludda okutuusa lwe watasigalawo kantu,","poem":1},{"text":"asigula essuubi lyange ng’omuti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Obusungu bwe bumbubuukirako;","poem":1},{"text":"ambala ng’omu ku balabe be.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Amaggye ge galumba n’amaanyi;","poem":1},{"text":"ganzimbako enkomera","poem":2},{"lineBreak":true},{"text":"ne gagumba okwetooloola weema yange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Anziggyeeko baganda bange;","poem":1},{"text":"abo bwe twali tumanyiganye banviiriddeko ddala.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ab’ekika kyange banviiriddeko ddala,","poem":1},{"text":"mikwano gyange ginneerabidde.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Abagenyi bange n’abaweereza bange abawala, bampisa nga gwe batamanyi,","poem":1},{"text":"ne bandaba nga munnagwanga.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mpita omuddu wange naye tawulira,","poem":1},{"text":"wadde nga mwegayirira n’akamwa kange.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Omukka gwange gwe nzisa, guwunyira bubi mukyala wange;","poem":1},{"text":"nakyayibwa baganda bange bennyini.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"N’obulenzi obuto bunsekerera;","poem":1},{"text":"buli lwe bundaba bunvuma.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mikwano gyange gyonna enfirabulago gya nkyawa;","poem":1},{"text":"abo be nnayagalanga banneefuukira.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Siriiko bwe ndi wabula ndi ddiba na magumba:","poem":1},{"text":"nsigazzaawo bibuno byokka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Munkwatirwe ekisa mikwano gyange, munkwatirwe ekisa,","poem":1},{"text":"kubanga omukono gwa Katonda gunkubye.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Lwaki munjigga nga Katonda bw’anjigga?","poem":1},{"text":"Omubiri gwe mufunye tegumala?","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“Singa nno ebigambo byange byawandiikibwa,","poem":1},{"text":"Singa byawandiikibwa ku muzingo, bandiguwadde ani?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Singa byawandiikibwa n’ekyuma ku lubaati,","poem":1},{"text":"oba okuwandiikibwa ku lwazi ne bibeerawo emirembe n’emirembe!","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mmanyi nga Omununuzi wange mulamu,","poem":1},{"text":"era nga ku nkomerero aliyimirira ku nsi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Era ng’olususu lwange bwe luweddewo,","poem":1},{"text":"kyokka mu mubiri gwange ndiraba Katonda;","poem":2}]},{"type":"verse","number":27,"content":[{"text":"nze mwene ndimulaba,","poem":1},{"text":"n’amaaso gange, Nze, so si mulala.","poem":2},{"lineBreak":true},{"text":"Emmeeme yange ng’eyaayaana munda mu nze!","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Bwe mugamba nti, ‘Tujja kumuyigganya,","poem":1},{"text":"kubanga ensibuko y’emitawaana eri mu ye;’","poem":2}]},{"type":"verse","number":29,"content":[{"text":"nammwe bennyini musaana mutye ekitala.","poem":1},{"text":"Kubanga obusungu buleeta okubonereza okw’ekitala,","poem":2},{"lineBreak":true},{"text":"olwo mulyoke mumanye ng’eriyo okusalirwa omusango.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}