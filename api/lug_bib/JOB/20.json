{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":20,"content":[{"type":"heading","content":["Zofali Addamu"]},{"type":"verse","number":1,"content":["Awo Zofali Omunaamasi n’amuddamu nti,"]},{"type":"verse","number":2,"content":[{"text":"“Ebirowoozo byange ebiteganyiziddwa binkubiriza okukuddamu","poem":1},{"text":"kubanga nteganyizibbwa nnyo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mpulidde nga nswadde olw’okunenya,","poem":1},{"text":"okutegeera kwange kunkubiriza okuddamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ddala omanyi nga bwe byali okuva edda,","poem":1},{"text":"okuva omuntu lwe yateekebwa ku nsi,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"nti Enseko z’omwonoonyi ziba z’akaseera katono,","poem":1},{"text":"era n’essanyu ly’abatamanyi Katonda terirwawo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Newaakubadde ng’amalala ge gatuuka ku ggulu","poem":1},{"text":"n’omutwe gwe ne gutuuka ku bire,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"alizikirira emirembe n’emirembe nga empitambi ye:","poem":1},{"text":"abo abamulaba babuuze nti, ‘Ali ludda wa?’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abulawo ng’ekirooto, n’ataddayo kulabika;","poem":1},{"text":"abuzeewo ng’okwolesebwa kw’ekiro.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Eriiso eryamulaba teririddayo kumulaba,","poem":1},{"text":"taliddayo kulaba kifo kye nate.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abaana be basaana bakolagane n’abaavu,","poem":1},{"text":"emikono gye gyennyini gye gisaana okuwaayo obugagga bwe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amaanyi ag’ekivubuka agajjudde amagumba ge,","poem":1},{"text":"ge ganaagalamiranga naye mu nfuufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Okukola ebibi kuwoomerera mu kamwa ke","poem":1},{"text":"era akukweka wansi w’olulimi lwe,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"tayagala kukuleka,","poem":1},{"text":"wadde okukuta era akukuumira mu kamwa ke.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Naye emmere ye erimwonoonekera mu byenda,","poem":1},{"text":"era erifuuka butwa bwa nsweera munda ye.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Aliwandula eby’obugagga bye yamira;","poem":1},{"text":"Katonda alireetera olubuto lwe okubisesema.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Alinywa obutwa bw’ensweera;","poem":1},{"text":"amannyo g’essalambwa galimutta.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Alisubwa obugga,","poem":1},{"text":"n’emigga egikulukuta n’omubisi gw’enjuki n’amata.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bye yateganira alina okubiwaayo nga tabiridde;","poem":1},{"text":"talinyumirwa magoba ga kusuubula kwe,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"kubanga yanyigiriza abaavu n’abaleka nga bakaaba,","poem":1},{"text":"yawamba amayumba g’ataazimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Ddala ddala talifuna kikkusa mululu gwe,","poem":1},{"text":"wadde okuwonya n’ebyo bye yeeterekera.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tewali kimulekeddwawo ky’anaalya;","poem":1},{"text":"obugagga bwe tebujja kusigalawo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Wakati mu kufuna ebingi okulaba ennaku kumujjira;","poem":1},{"text":"alibonaabonera ddala nnyo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ng’amaze okujjuza olubuto lwe,","poem":1},{"text":"Katonda alyoke amusumulurire obusungu bwe amukube ebikonde ebitagambika.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bw’alidduka ekyokulwanyisa eky’ekyuma,","poem":1},{"text":"akasaale ak’ekikomo kalimufumita.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Akasaale kaliviirayo mu mugongo gwe,","poem":1},{"text":"omumwa gwako ogumasamasa gusikibwe mu kibumba.","poem":2},{"text":"Entiisa erimujjira.","poem":1}]},{"type":"verse","number":26,"content":[{"text":"Ekizikiza ekikutte kye kirindiridde obugagga bwe.","poem":2},{"text":"Omuliro ogutazikira gwe gulimumalawo,","poem":1},{"text":"gwokye ebisigadde mu weema ye.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Eggulu liryolesa obutali butuukirivu bwe;","poem":1},{"text":"ensi erimusitukirako n’emujeemera.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ebintu by’ennyumba biritwalibwa,","poem":1},{"text":"biribulira ku lunaku lw’obusungu bwa Katonda.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Eyo y’engeri Katonda gy’asasulamu abakozi b’ebibi,","poem":1},{"text":"nga gwe mugabo Katonda gwe yabategekera.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}