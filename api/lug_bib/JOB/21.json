{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":21,"content":[{"type":"heading","content":["Yobu Ayanukula"]},{"type":"verse","number":1,"content":["Awo Yobu n’addamu n’ayogera nti,"]},{"type":"verse","number":2,"content":[{"text":"“Muwulirize n’obwegendereza ebigambo byange,","poem":1},{"text":"era kino kibazzeemu amaanyi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mungumiikirizeeko nga njogera,","poem":1},{"text":"oluvannyuma museke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Okwemulugunya kwange nkw’olekezza muntu?","poem":1},{"text":"Lwaki okugumiikiriza tekunzigwako?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Muntunuulire mwewuunye,","poem":1},{"text":"mujja kukwata ne ku mumwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bwe ndowooza ku kino, nfuna entiisa;","poem":1},{"text":"omubiri gwange ne gukankana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lwaki abakozi b’ebibi bawangaala,","poem":1},{"text":"ne bakaddiwa ne beeyongera n’amaanyi?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Balaba abaana baabwe bwe banywezebbwa,","poem":1},{"text":"ezzadde lyabwe nga balaba.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Amaka gaabwe gaba n’emirembe nga temuli kutya;","poem":1},{"text":"omuggo gwa Katonda tegubabeerako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ennume zaabwe teziremererwa,","poem":1},{"text":"ente zaabwe enkazi zizaala awatali kusowola mwana gwazo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abaana baabwe bagendera wamu nga kisibo;","poem":1},{"text":"obuto ne bubeera mu kuzina.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bayimbira ku bitaasa n’ennanga,","poem":1},{"text":"ne basanyukira eddoboozi ly’omulere.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Emyaka gyabwe gyonna babeera bulungi,","poem":1},{"text":"mangwago ne bakka mu ntaana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kyokka bagamba Katonda nti, ‘Tulekere emirembe gyaffe!","poem":1},{"text":"Tetwegomba kumanya makubo go.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ayinzabyonna ye ani tulyoke tumuweereze?","poem":1},{"text":"Kiki kye tuganyulwa bwe tumusaba?’","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Naye obugagga bwabwe tebuli mu mikono gyabwe,","poem":1},{"text":"noolwekyo amagezi g’abakozi b’ebibi ganneewunyisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Ettaala y’abakozi b’ebibi yo, ezikira emirundi emeka?","poem":1},{"text":"Ennaku ebajjira emirundi emeka?","poem":2},{"lineBreak":true},{"text":"Katonda abatuusaako obulumi, ng’abasunguwalidde.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bali ng’ebisasiro ebitwaalibwa empewo;","poem":1},{"text":"ng’ebisusunku embuyaga bye zitwala.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Katonda abonereza abaana olw’ekibi kya bakitaabwe.","poem":1},{"text":"Asasule omuntu yennyini oyo alyoke ategeere!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Leka amaaso ge ye yennyini galabe okuzikirira;","poem":1},{"text":"leka anywe ku kiruyi kya Ayinzabyonna.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kubanga aba afaayo ki ku maka g’aba alese,","poem":1},{"text":"nga emyezi gye egyamutegekerwa giweddeko?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Eriyo ayinza okuyigiriza Katonda amagezi,","poem":1},{"text":"kubanga asalira omusango n’abo abasinga okuba aba waggulu?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Omusajja omu afiira w’abeerera ow’amaanyi,","poem":1},{"text":"nga munywevu ddala ali mu mirembe gye,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"omubiri gwe nga guliisiddwa bulungi,","poem":1},{"text":"amagumba ge nga gajjudde obusomyo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Omusajja omulala n’afa ng’alina obulumi ku mutima,","poem":1},{"text":"nga teyafuna kintu kyonna kirungi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ne beebaka kye kimu mu ttaka,","poem":1},{"text":"envunyu ne zibabikka bombi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Mmanyi bulungi ddala kye mulowooza,","poem":1},{"text":"enkwe ze mwagala okunsalira.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Mugamba nti, ‘Kaakano eruwa ennyumba y’omusajja ow’amaanyi,","poem":1},{"text":"eweema abasajja abakozi b’ebibi mwe baabeeranga?’","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Temwebuuzanga ku abo abatambula eŋŋendo?","poem":1},{"text":"Temukkiriza bye babagamba,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"nti omusajja omukozi w’ebibi awona ku lunaku olw’emitawaana,","poem":1},{"text":"era awona ku lunaku olw’ekiruyi?","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ani avumirira ebikolwa bye maaso ku maaso,","poem":1},{"text":"ani amusasula ebyo by’akoze?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Atwalibwa ku ntaana,","poem":1},{"text":"era amalaalo ge gakuumibwa.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ettaka eriri mu lusenyi limuwoomera,","poem":1},{"text":"abantu bonna bamugoberera,","poem":2},{"lineBreak":true},{"text":"n’abalala abatamanyiddwa muwendo ne bamukulembera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Kaakano musobola mutya okuŋŋumya n’ebitaliimu?","poem":1},{"text":"Tewali kisigaddeyo ku bye mwanzizeemu wabula obulimba!”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}