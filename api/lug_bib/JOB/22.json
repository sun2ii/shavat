{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":22,"content":[{"type":"heading","content":["Erifaazi Addamu"]},{"type":"verse","number":1,"content":["Awo Erifaazi Omutemani n’addamu n’ayogera nti,"]},{"type":"verse","number":2,"content":[{"text":"“Omuntu ayinza okugasa Katonda?","poem":1},{"text":"Wadde oyo ow’amagezi ayinza okumuyamba?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ayinzabyonna yandifunye kwesiima ki singa wali mutuukirivu?","poem":1},{"text":"Yandiganyuddwa ki singa amakubo go gaali magolokofu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Akukangavvula lwa kumutya","poem":1},{"text":"era kyava akuvunaana?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Okwonoona kwo si kunene nnyo?","poem":1},{"text":"Ebibi byo si bingi nnyo?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kubanga waggya ku muganda wo emisingo awatali nsonga;","poem":1},{"text":"waggya engoye ku bantu, n’obaleka bwereere.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tewawa bakoowu mazzi,","poem":1},{"text":"abaagala wabamma emmere,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"wadde nga wali musajja wa maanyi, eyalina ettaka,","poem":1},{"text":"omusajja ow’ekitiibwa, era nga byonna ggwe nnyini byo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Weegobako bannamwandu bagende nga toliiko ky’obawadde;","poem":1},{"text":"abatalina bakitaabwe n’obamalamu amaanyi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Emitego kyegivudde gikwetooloola.","poem":1},{"text":"Lwaki entiisa ey’amangu ekujjira?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Lwaki enzikiza ekutte nnyo tosobola kulaba,","poem":1},{"text":"era lwaki amataba gakubikkako?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Katonda tali waggulu mu ggulu?","poem":1},{"text":"Era laba, emmunyeenye ezisingayo okuba waggulu, nga bwe ziri ewala!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ate n’ogamba nti, ‘Katonda amanyi ki?","poem":1},{"text":"Ayinza okulamulira mu kizikiza?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ebire ebikutte bimubikkako, n’aba ng’atatulaba","poem":1},{"text":"bw’aba atambula mu bifo by’omu ggulu.’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Onoosigala mu kkubo ery’edda","poem":1},{"text":"abasajja abakozi b’ebibi lye baakwata?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Baatwalibwa ng’ekiseera kyabwe tekinnatuuka,","poem":1},{"text":"emisingi gyabwe gyatwalibwa amataba.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Be bagamba Katonda nti, ‘Tulekere emirembe!","poem":1},{"text":"Ayinzabyonna ayinza kutukola ki?’","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ate nga ye, ye yajjuza ennyumba zaabwe ebintu ebirungi,","poem":1},{"text":"noolwekyo neewuunya nnyo amagezi g’abakozi b’ebibi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Abatuukirivu balaba okuzikirira kwabwe ne bajaguza;","poem":1},{"text":"abataliiko musango babasekerera nga bagamba nti,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"‘Ddala abalabe baffe bazikiridde,","poem":1},{"text":"era omuliro gulidde obugagga bwabwe.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Gonderanga Katonda ofunenga emirembe;","poem":1},{"text":"mu ngeri eno ebirungi lwe binajjanga gy’oli.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kkiriza ebiragiro ebiva mu kamwa ke","poem":1},{"text":"era oteeke ebigambo bye mu mutima gwo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bw’onodda eri oyo Ayinzabyonna, onodda buggya,","poem":1},{"text":"bwonooteeka ebibi ewala ne weema yo,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"n’oteeka n’amayinja go ag’omuwendo mu ttaka,","poem":1},{"text":"zaabu yo eya Ofiri ku njazi z’omu mugga,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"awo Ayinzabyonna anaabeeranga zaabu yo,","poem":1},{"text":"era ffeeza esingayo obulungi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ddala ddala olisanyukira mu oyo Ayinzabyonna","poem":1},{"text":"era oyimuse amaaso go eri Katonda.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Olimusaba, alikuwulira,","poem":1},{"text":"era olituukiriza obweyamo bwo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ky’olisalawo kirikolebwa,","poem":1},{"text":"era ekitangaala kirimulisa amakubo go.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Abantu abalala bwe balisuulibwa n’ogamba nti, ‘Bayimuse!’","poem":1},{"text":"Olwo alirokola abagudde.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Alinunula n’oyo aliko omusango,","poem":1},{"text":"alinunulwa olw’obulongoofu bw’emikono gyo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}