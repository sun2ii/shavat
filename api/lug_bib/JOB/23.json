{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"heading","content":["Yobu Ayanukula"]},{"type":"verse","number":1,"content":["Awo Yobu n’addamu nti,"]},{"type":"verse","number":2,"content":[{"text":"“N’okutuusa leero okwemulugunya kwange kubalagala,","poem":1},{"text":"omukono gwe gunzitoowerera wadde mbadde mu kusinda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Singa nnali mmanyi aw’okumusanga","poem":1},{"text":"nandisobodde okulaga gy’abeera!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nanditutte empoza yange gy’ali,","poem":1},{"text":"akamwa kange nga nkajjuzizza ensonga zange.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nanditegedde kye yandinzizeemu,","poem":1},{"text":"ne neetegereza kye yandiŋŋambye.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yandimpakanyizza n’amaanyi mangi?","poem":1},{"text":"Nedda, teyandinteeseko musango.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Eyo omuntu omutuukirivu asobola okutwalayo ensonga ye,","poem":1},{"text":"era nandisumuluddwa omulamuzi wange emirembe n’emirembe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Bwe ŋŋenda ebuvanjuba, nga taliiyo;","poem":1},{"text":"ne bwe ŋŋenda ebugwanjuba, simusangayo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bw’aba akola mu bukiikakkono simulaba,","poem":1},{"text":"bw’adda mu bukiikaddyo, simulabako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Naye amanyi amakubo mwe mpita,","poem":1},{"text":"bw’anaamala okungezesa, nzija kuvaamu nga zaabu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ebigere byange bimugoberedde;","poem":1},{"text":"ntambulidde mu makubo ge nga sikyamakyama.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Saava ku biragiro by’akamwa ke.","poem":1},{"text":"Nayagala ebigambo by’akamwa ke okusinga emmere yange gyendya bulijjo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Naye yeemalirira, ani ayinza okumuwakanya?","poem":1},{"text":"Akola kyonna ekimusanyusa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Weewaawo ajja kutuukiriza by’asazzeewo okunjolekeza,","poem":1},{"text":"era bingi byategese by’akyaleeta.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kyenva mba n’entiisa nga ndi mu maaso ge;","poem":1},{"text":"bwe ndowooza ku bino byonna, ne mmutya.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Katonda anafuyizza nnyo omutima gwange,","poem":1},{"text":"Ayinzabyonna antiisizza nnyo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Naye ekizikiza tekinsirisizza,","poem":1},{"text":"ekizikiza ekikutte ennyo ekibisse amaaso gange.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}