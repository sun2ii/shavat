{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"“Lwaki Ayinzabyonna tagera biseera?","poem":1},{"text":"Lwaki abo abamumanyi tebalaba nnaku zaageze?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abantu bajjulula amayinja agalamba ensalo,","poem":1},{"text":"ne balunda ebisolo bye babbye.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Batwala endogoyi ya mulekwa","poem":1},{"text":"ne batwala ennume ya nnamwandu ng’omusingo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Basindiikiriza omunaku ne bamuggya mu kkubo,","poem":1},{"text":"ne bawaliriza abaavu bonna mu ggwanga okwekweka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Endogoyi ez’omu ddungu nga bwe zeeyisa,","poem":1},{"text":"n’abaavu bagenda bategana nnyo nga balondalonda obumere;","poem":2},{"lineBreak":true},{"text":"mu ddungu mwe balonderera emmere y’abaana baabwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Essubi eririibwa ensolo zaabwe baliggya ku ttale lye,","poem":1},{"text":"ne banoga n’emizabbibu gy’aboonoonyi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Olw’okubulwa engoye, basula bwereere;","poem":1},{"text":"tebalina kye beebikka mu mpewo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enkuba y’oku nsozi ebatobya,","poem":1},{"text":"ne banywegera enjazi olw’okubulwa we beggama.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Omwana atalina kitaawe bamusika ku mabeere;","poem":1},{"text":"omwana omuwere ow’omwavu bamuwamba olw’ebbanja.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Olw’okubulwa engoye bayita bwereere;","poem":1},{"text":"betikka ebinywa by’emmere naye basigala tebalidde.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Basogolera emizabbibu ku mayinja,","poem":1},{"text":"ne basambira mu ssogolero, naye ne basigala nga balumwa ennyonta.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Okusinda kw’abantu kuwulirwa mu kibuga,","poem":1},{"text":"n’emmeeme z’abafunye ebisago zikaabira obuyambi.","poem":2},{"lineBreak":true},{"text":"Naye Katonda talina gw’asinzisa musango.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Waliwo abo abajeemera omusana,","poem":1},{"text":"abatamanyi makubo ge,","poem":2},{"lineBreak":true},{"text":"abatasigala mu kwaka kwagwo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Omutemu agolokoka nga obudde buzibye","poem":1},{"text":"n’atta omwavu n’ali mu kwetaaga;","poem":2},{"lineBreak":true},{"text":"ekiro abbira ddala.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Eriiso ly’omwenzi lirinda buzibe,","poem":1},{"text":"ng’agamba nti, ‘Tewali liiso linandaba,’","poem":2},{"lineBreak":true},{"text":"n’abikka ne ku maaso ge.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mu kizikiza mwe basimira amayumba,","poem":1},{"text":"kyokka emisana baba beggalidde.","poem":2},{"lineBreak":true},{"text":"Tebaagala kitangaala.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Eri abo bonna ekizikiza ekikutte bwe budde bwabwe obw’oku makya.","poem":1},{"text":"Kubanga bakola omukwano n’ebitiisa eby’omu nzikiza.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bali ng’ebyovu ebiri kungulu ku mazzi,","poem":1},{"text":"era omugabo gwabwe mukolimire mu nsi.","poem":2},{"lineBreak":true},{"text":"Tewali musogozi n’omu alaga mu nnimiro zaabwe ez’emizabbibu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nga ekyeeya n’ebbugumu bwe bimalawo amazzi agava mu muzira,","poem":1},{"text":"aboonoonyi bwe batyo bwe bamalibwawo emagombe.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Olubuto lunaamwerabiranga;","poem":1},{"text":"envunyu eneemulyanga n’ewoomerwa.","poem":2},{"text":"Tajjukirwenga nate,","poem":1},{"text":"omukozi w’ebibi amenyeka ng’omuti.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bayiikiriza ne banyaga omugumba atazaala.","poem":1},{"text":"Tebakolera nnamwandu bya kisa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Naye Katonda awalula ab’amaanyi olw’obuyinza bwe.","poem":1},{"text":"Newaakubadde nga bakulaakulana, kyokka tebalina bukakafu ku bulamu bwabwe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ayinza okubaleka ne babeera mu mirembe","poem":1},{"text":"n’amaaso ge gabeera ku makubo gaabwe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bayimusibwa akaseera katono, oluvannyuma nga tebakyaliwo.","poem":1},{"text":"Bakkakkanyizibwa ne bakala ne baggyibwawo nga abalala bonna.","poem":2},{"lineBreak":true},{"text":"Basalibwa ng’emitwe gy’ebirimba by’eŋŋaano.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Bwe kiba nga si bwe kiri, ani anannumiriza obulimba,","poem":1},{"text":"n’afuula okwogera kwange okutaliimu?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}