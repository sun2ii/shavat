{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"heading","content":["Yobu Ayanukula"]},{"type":"verse","number":1,"content":["Awo Yobu n’addamu nti,"]},{"type":"verse","number":2,"content":[{"text":"“Ng’oyambye oyo atalina maanyi!","poem":1},{"text":"Ng’oyambye omukono ogwo ogutalina maanyi!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ng’amagezi ga kitalo ago g’owadde oyo atalina magezi!","poem":1},{"text":"Ng’owadde okuluŋŋamizibwa okuyitirivu!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ani akuyambye okwogera ebigambo ebyo?","poem":1},{"text":"Era mwoyo ki ogwogeredde mu kamwa ko?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Abafu kye balimu tekigumiikirizika,","poem":1},{"text":"n’abo abali wansi w’amazzi ne bonna abagabeeramu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amagombe gali bwereere mu maaso ga Katonda;","poem":1},{"text":"n’okuzikiriza tekulina kikubisse.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ayanjuluza eggulu ery’obukiikakkono mu bbanga ejjereere,","poem":1},{"text":"awanika ensi awatali kigiwanirira.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asiba amazzi mu bire bye;","poem":1},{"text":"ate ebire tebyabika olw’okuzitoowererwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abikka obwenyi bw’omwezi,","poem":1},{"text":"agwanjululizaako ebire bye.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ateekawo ekipimo ekiraga waggulu amazzi g’ennyanja we gayita,","poem":1},{"text":"ng’ensalo eyawula ekitangaala n’ekizikiza.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Empagi z’eggulu zikankana,","poem":1},{"text":"zeewuunya olw’okunenya kwe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Afuukuula ennyanja n’obuyinza bwe,","poem":1},{"text":"n’asalaasala Lakabu mu bitundutundu n’amagezi ge.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yafuuwa omukka ogwatereeza eggulu,","poem":1},{"text":"omukono gwe gwafumita omusota oguwulukuka.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Naye nga bino katundu butundu ku bye yakola.","poem":1},{"text":"Nga kye tumuwulirako katundu butundu ku ekyo ky’ali!","poem":2},{"lineBreak":true},{"text":"Ani ayinza okutegeera okubwatuka kw’obuyinza bwe?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}