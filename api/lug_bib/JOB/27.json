{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":["Yobu n’ayongera okwogera kwe bw’ati nti,"]},{"type":"verse","number":2,"content":[{"text":"“Nga Katonda bw’ali omulamu, agaanye okusala ensonga yange mu mazima,","poem":1},{"text":"oyo Ayinzabyonna, aleetedde emmeeme yange okulumwa,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"gye nkomye okuba nga nkyalina obulamu mu nze,","poem":1},{"text":"omukka gwa Katonda nga gukyali mu nnyindo zange,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"emimwa gyange tegijja kwogera butali butuukirivu,","poem":1},{"text":"era olulimi lwange terujja kwogera bulimba.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sirikkiriza nti muli batuufu;","poem":1},{"text":"okutuusa lwe ndifa, siryeggyako bugolokofu bwange.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nzija kwongera okunywerera ku butuukirivu bwange obutabuleka;","poem":1},{"text":"omutima gwange tegunsalira musango nga nkyali mulamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Abalabe bange babeere ng’abakozi b’ebibi,","poem":1},{"text":"n’abo abangolokokerako babeere ng’abatali batuukirivu!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kubanga ssuubi ki oyo atalina Katonda ly’aba nalyo ng’asaliddwako,","poem":1},{"text":"nga Katonda amuggyeko obulamu?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Katonda awulira okukaaba kwe","poem":1},{"text":"ng’ennaku emujjidde?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Alifuna essanyu mu oyo Ayinzabyonna?","poem":1},{"text":"Aliyita Katonda ebbanga lyonna?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nzija kubayigiriza ebikwata ku maanyi ga Katonda;","poem":1},{"text":"ebikwata ku oyo Ayinzabyonna sijja kubikweka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Weekalirize bino byonna bye mwerabiddeko,","poem":1},{"text":"lwaki kaakano okwogera ebyo ebitalina makulu?","poem":2}]},{"type":"heading","content":["Empeera y’Abakozi b’Ebibi"]},{"type":"verse","number":13,"content":[{"text":"“Eno y’empeera Katonda gy’awa abakozi b’ebibi,","poem":1},{"text":"omugabo omuntu omujoozi gw’afuna okuva eri oyo Ayinzabyonna:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abaana be ne bwe baba bangi batya, enkomerero yaabwe kitala;","poem":1},{"text":"ezzadde lye teririfuna byakulya bibamala.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Abo abaliwona kawumpuli, balifa ne baziikibwa,","poem":1},{"text":"ne bannamwandu baabwe tebalibakaabira.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wadde ng’atereka effeeza ng’enfuufu,","poem":1},{"text":"n’engoye ng’entuumo y’ebbumba,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ebyo bye yeeterekera omutuukirivu y’alibyambala,","poem":1},{"text":"era abo abatalina musango be baligabana effeeza ye.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ennyumba gy’azimba eribeera ng’ey’ekiwojjolo;","poem":1},{"text":"ng’akasiisira akazimbiddwa omukuumi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Agenda okwebaka nga mugagga, naye ekyo tekiddemu kubaawo,","poem":1},{"text":"kubanga alizuukuka nga byonna biweddewo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Entiisa erimuzingako ng’amataba;","poem":1},{"text":"kibuyaga amutwala ekiro mu kyama.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Embuyaga ey’ebuvanjuba emutwalira ddala n’agenda;","poem":1},{"text":"emuggya mu kifo kye n’amaanyi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Emukuba awatali kusaasira,","poem":1},{"text":"ng’adduka ave mu maanyi gaayo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Erimukubira engalo zaayo,","poem":1},{"text":"n’emusiiya okuva mu kifo kye.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}