{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"“Ddala ddala waliwo ebirombe mwe basima effeeza,","poem":1},{"text":"n’ekifo gye balongooseza effeeza.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ekyuma kisimibwa mu ttaka,","poem":1},{"text":"n’ekikomo ne bakisaanuusa okukiggya mu mayinja.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Omuntu agoberera enzikiza n’anoonya eyo mu ttaka wansi,","poem":1},{"text":"asime ekyuma mu kizikiza ekiri wansi ennyo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Asima ekinnya ekiri ewala n’abantu gye babeera,","poem":1},{"text":"mu bifo eteyita bantu,","poem":2},{"lineBreak":true},{"text":"ewala okuva abantu gye bayita.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ensi evaamu emmere,","poem":1},{"text":"naye wansi waayo yafuusibwa nga muliro.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Safira eva mu mayinja gaayo,","poem":1},{"text":"era enfuufu yaayo erimu zaabu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tewali kinyonyi kiyizzi kimanyi kkubo lino,","poem":1},{"text":"wadde n’amaaso ga kamunye tegarirabanga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ekibinja ky’empologoma ento tekituukangayo,","poem":1},{"text":"tewali mpologoma yali eyiseeyo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Omuntu ayasa n’omukono gwe ejjinja ery’embaalebaale,","poem":1},{"text":"n’avuunika ensozi okuviira ddala we zisibuka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Asima ensalosalo ku njazi;","poem":1},{"text":"n’amaaso ge galaba eby’omuwendo byonna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anoonya wansi mu migga,","poem":1},{"text":"n’aggyayo ebintu ebyakwekebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Naye amagezi gasangibwa wa?","poem":1},{"text":"Okutegeera kuva wa?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Omuntu tayinza kutegeera mugaso gwago;","poem":1},{"text":"tegasangibwa mu nsi y’abalamu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Obuziba bwogera nti, ‘Tegali mu nze,’","poem":1},{"text":"ennyanja eyogera nti, ‘Tegali mu nze.’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tegayinza kugulibwa na zaabu asingayo obulungi,","poem":1},{"text":"wadde omuwendo gwago okupimibwa mu ffeeza.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tegayinza kugulibwa na zaabu wa Ofiri,","poem":1},{"text":"mu mayinja ag’omuwendo aga onuku oba safiro.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Zaabu n’endabirwamu tebiyinza kugenkana:","poem":1},{"text":"so tegayinza kugeraageranyizibwa n’amayinja ag’omuwendo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kolali n’amayinja ag’endabirwamu tebyogerwa nako;","poem":1},{"text":"omuwendo ogugula amagezi gusinga amayinja amatwakaavu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Topazi eva mu Esiyopya teyinza kugenkana,","poem":1},{"text":"tegayinza wadde okugulibwa mu zaabu etetabikiddwamu kantu konna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Kale amagezi gava ludda wa?","poem":1},{"text":"N’okutegeera kubeera ludda wa?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Gakwekebwa okuva mu maaso g’ebintu byonna ebiramu,","poem":1},{"text":"era gakwekeddwa ebinyonyi by’omu bbanga.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Okuzikiriza n’Okufa kwogera nti,","poem":1},{"text":"‘Nawulirako buwulizi ku lugambo lwakwo mu matu gange.’","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Katonda ategeera ekkubo erigatuukako","poem":1},{"text":"era ye yekka y’amanyi gye gabeera,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"kubanga alaba enkomerero y’ensi","poem":1},{"text":"era alaba ebintu byonna wansi w’eggulu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bwe yateekawo amaanyi g’empewo,","poem":1},{"text":"n’apima n’amazzi,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"bwe yateekera enkuba etteeka","poem":1},{"text":"era n’ekkubo eggulu we linaayitanga nga limyansa,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"olwo n’atunuulira amagezi n’agalangirira;","poem":1},{"text":"n’agateekawo, n’agagezesa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"N’agamba omuntu nti,","poem":1},{"text":"‘Laba, okutya Mukama, ge magezi,","poem":2},{"lineBreak":true},{"text":"n’okuleka ekibi, kwe kutegeera.’ ”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}