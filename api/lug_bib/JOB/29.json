{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":["Yobu n’ayongera okwogera nti,"]},{"type":"verse","number":2,"content":[{"text":"“Nga nneegomba emyezi egyayita,","poem":1},{"text":"ennaku Katonda mwe yali nga y’andabirira,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ettaala ye bwe yayakiranga omutwe gwange,","poem":1},{"text":"n’ekitangaala kye bwe kyanjakiranga nga ntambulira mu kizikiza.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mu biro we nabeerera ow’amaanyi,","poem":1},{"text":"omukwano gwa Katonda omuyitirivu nga gukuuma amaka gange,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ayinzabyonna bwe yali ng’akyali nange","poem":1},{"text":"n’abaana bange nga bakyanneetoolodde,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"n’ekkubo lyange nga lisiigiddwa omuzigo","poem":1},{"text":"n’olwazi nga lunfukirira omugga ogw’amafuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Bwe nalaganga ku mulyango gw’ekibuga","poem":1},{"text":"ne ntuula ku ntebe mu kifo we baakubiranga enkiiko,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"abavubuka abato bandabanga ne badda ebbali,","poem":1},{"text":"abakadde ne basituka ne bayimirira;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"abakungu ab’oku ntikko ne balekeraawo okwogera,","poem":1},{"text":"ne bakwata ne ku mimwa;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ab’ebitiibwa ne balekeraawo okwogera,","poem":1},{"text":"ennimi zaabwe ne zeesibira waggulu mu kamwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Buli kutu okwampuliranga nga kwesiima,","poem":1},{"text":"era n’abo abandabanga nga basiima","poem":2}]},{"type":"verse","number":12,"content":[{"text":"kubanga nawonyanga abaavu abaakaabiranga obuyambi,","poem":1},{"text":"n’abatalina bakitaabwe abatalina abayamba.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Omusajja ng’afa, y’ansabira omukisa,","poem":1},{"text":"ne ndeetera omutima gwa nnamwandu okuyimba.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ne nnyambala obutuukirivu ng’engoye zange,","poem":1},{"text":"obwenkanya bwe bwali omunagiro gwange era ekitambala kye neesiba ku mutwe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nnali maaso g’abamuzibe","poem":1},{"text":"era ebigere by’abalema.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nnali kitaawe w’abanaku,","poem":1},{"text":"ne nneyama okuwolereza besimanyiiko.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Namenyanga amannyo g’abakozi b’ebibi,","poem":1},{"text":"ne nziggya mu kamwa kaabwe, be baali bakutte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Nalowooza nti, ‘Ndifiira mu nnyumba yange","poem":1},{"text":"nga mpezezza ennaku zange nga nnyingi ng’omusenyu ogw’oku nnyanja.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Omulandira gwange gulituuka mu mazzi,","poem":1},{"text":"era n’omusulo gulibeera ku ttabi lyange okukeesa obudde.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ekitiibwa kyange tekirikaddiwa mu nze,","poem":1},{"text":"n’omutego gwange ogw’akasaale gusigale nga tegukaddiye mu mukono gwange.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Abantu beesunganga okumpuliriza,","poem":1},{"text":"nga balindirira mu kasirise amagezi gange.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bwe namalanga okwogera, nga tewaba addayo kwogera,","poem":1},{"text":"ebigambo byange byagwanga mpola mpola mu matu gaabwe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bannindiriranga ng’enkuba","poem":1},{"text":"ne banywa ebigambo byange ng’enkuba eya ttoggo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bwe nabamwenyeranga nga tebakikkiriza;","poem":1},{"text":"ekitangaala ky’oku maaso gange kyali kya muwendo gye bali.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nabasalirangawo eky’okukola,","poem":1},{"text":"ne ntuula nga kabaka n’amaggye ge;","poem":2},{"lineBreak":true},{"text":"nnali ng’abo ababeesabeesa abakungubazi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}