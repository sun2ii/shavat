{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":3,"content":[{"type":"heading","content":["Yobu Akolimira Olunaku kwe Yazaalirwa"]},{"type":"verse","number":1,"content":["Oluvannyuma lw’ebyo, Yobu n’ayasamya akamwa ke n’akolimira olunaku kwe yazaalirwa."]},{"type":"verse","number":2,"content":["N’agamba nti,"]},{"type":"verse","number":3,"content":[{"text":"“Olunaku kwe nazaalirwa luzikirire,","poem":1},{"text":"n’ekiro lwe kyalangirirwa nti omwana mulenzi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Olunaku olwo lubuutikirwe ekizikiza,","poem":1},{"text":"omusana guleme okulwakako,","poem":2},{"lineBreak":true},{"text":"Katonda aleme okulufaako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ekizikiza n’ekisiikirize eky’okufa birujjule,","poem":1},{"text":"ekire kirutuuleko,","poem":2},{"lineBreak":true},{"text":"ekizikiza kikankanye ekitangaala kyalwo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ekizikiza ekikutte be zigizigi kirunyage,","poem":1},{"text":"luleme okubalirwa awamu n’ennaku eziri mu mwaka,","poem":2},{"lineBreak":true},{"text":"wadde okuyingizibwa mu ezo eziri mu mwezi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yee, lubeere lugumba,","poem":1},{"text":"waleme okuba eddoboozi lyonna ery’essanyu eririwulirwako.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abo abakolimira ennyanja n’ennaku balukolimire,","poem":1},{"text":"n’abo abamanyi okuzuukusa agasolo galukwata mu nnyanja, balukolimire.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Emmunyeenye ez’omu matulutulu gaalwo zibe ekizikiza,","poem":1},{"text":"lulindirire ekitangaala kirubulwe,","poem":2},{"lineBreak":true},{"text":"luleme okulaba ebikowe by’oku nkya.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kubanga terwaggala nzigi za lubuto lwa mmange,","poem":1},{"text":"nneme okulaba obuyinike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Lwaki saafa nga nzalibwa,","poem":1},{"text":"oba ne nfa nga nva mu lubuto lwa mmange?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lwaki amaviivi ganzikiriza okugatuulako","poem":1},{"text":"era n’amabeere okugayonka?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kaakano nandibadde ngalamidde nga neesirikidde,","poem":1},{"text":"nandibadde neebase nga neewummulidde,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"wamu ne bakabaka n’abakungu ab’ensi,","poem":1},{"text":"abezimbira embiri kaakano amatongo,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"oba n’abalangira abaalina zaabu,","poem":1},{"text":"abajjuzanga ffeeza mu nnyumba zaabwe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Oba lwaki saaziikibwa ng’omwana azaaliddwa ng’afudde,","poem":1},{"text":"atalabye ku kitangaala?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Eyo ababi gye batatawaanyizibwa,","poem":1},{"text":"era n’abakooye gye bawummulira.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Abasibe gye bawummulira awamu,","poem":1},{"text":"gye batawulirira kiragiro ky’oyo abaduumira.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Abakopi n’abakungu gye babeera;","poem":1},{"text":"abaddu gye batatuntuzibwa bakama baabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Lwaki omuyinike aweebwa ekitangaala,","poem":1},{"text":"ne kimulisiza oyo alumwa mu mwoyo,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"era lwaki yeegomba okufa naye ne kutajja,","poem":1},{"text":"n’akunoonya okusinga obugagga obuziikiddwa,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"abajaguza ekisukkiridde,","poem":1},{"text":"ne basanyuka ng’atuuse ku ntaana?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Lwaki okuwa ekitangaala oyo,","poem":1},{"text":"atayinza kulaba kkubo,","poem":2},{"lineBreak":true},{"text":"Katonda gw’akomedde?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kubanga nkaaba mu kifo ky’okulya,","poem":1},{"text":"n’okusinda kwange kufukumuka ng’amazzi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ekintu kye nantiiranga ddala","poem":1},{"text":"era kye nakyawa kye kyantukako.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Siwummudde wadde okusiriikirira wadde okuba n’emirembe,","poem":1},{"text":"wabula buzibu bwereere bwe bunzijidde.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}