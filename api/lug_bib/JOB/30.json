{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":[{"text":"“Naye kaakano bansekerera;","poem":1},{"text":"abantu abansinga obuto,","poem":2},{"text":"bakitaabwe be nnandibadde nteeka","poem":1},{"text":"wamu n’embwa ezikuuma endiga zange.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amaanyi g’emikono gyabwe gaali gangasa ki?","poem":1},{"text":"Abantu abaali baweddemu amaanyi ag’obuvubuka bwabwe,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"abakoozimbye abaali mu bwetaavu era abayala,","poem":1},{"text":"bameketa ettaka ekkalu mu nsi enjereere mu budde obw’ekiro.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Banoga ebiragala ebiwoomerera ng’omunnyo mu bisaka,","poem":1},{"text":"enkolokolo ez’omwoloola y’emmere yaabwe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Baagobebwa bave mu bantu bannaabwe,","poem":1},{"text":"ne babaleekaanira gy’obeera nti, baali babbi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Baawalirizibwa okubeera mu migga egyakalira,","poem":1},{"text":"mu njazi ne mu binnya wansi mu ttaka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Baakaabira mu bisaka ng’ensolo","poem":1},{"text":"ne beekweka mu bikoola by’emiti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ezzadde ly’abasirusiru abatalina bwe bayitibwa,","poem":1},{"text":"baagobebwa mu nsi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Naye kaakano abaana baabwe bansekerera nga bannyimba;","poem":1},{"text":"nfuuse ekyenyinyalwa gye bali,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"abatanjagala abanneesalako,","poem":1},{"text":"banguwa okunfujjira amalusu mu maaso.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kaakano Katonda nga bw’atagguludde akasaale kange, ammazeemu amaanyi;","poem":1},{"text":"beeyisizza nga bwe balaba mu maaso gange.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abantu bano bannumba ku mukono gwange ogwa ddyo;","poem":1},{"text":"bategera ebigere byange emitego,","poem":2},{"lineBreak":true},{"text":"ne baziba amakubo banzikirize.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Banzingiza","poem":1},{"text":"ne banzikiriza,","poem":2},{"lineBreak":true},{"text":"nga tewali n’omu abayambye.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Banzingiza ng’abayita mu kituli ekigazi,","poem":1},{"text":"bayingira nga bayita mu muwaatwa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nnumbiddwa ebitiisa eby’amaanyi;","poem":1},{"text":"ekitiibwa kyange kifuumuuse ng’ekifuuyiddwa empewo,","poem":2},{"lineBreak":true},{"text":"era n’obukuumi bwange ne bubulawo ng’ekire.”","poem":2}]},{"type":"heading","content":["Okubonaabona kwa Yobu"]},{"type":"verse","number":16,"content":[{"text":"“Era kaakano obulamu bwange buseebengerera buggwaawo,","poem":1},{"text":"ennaku ez’okubonaabona zinzijjidde.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ekiro kifumita amagumba gange","poem":1},{"text":"era obulumi bwe nnina tebukoma.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mu maanyi ge amangi Katonda abeera ng’olugoye lwe nneebikka,","poem":1},{"text":"n’ensibibwa ng’ekitogi ky’ekyambalo kyange.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ansuula mu bitosi,","poem":1},{"text":"ne nfuuka ng’enfuufu n’evvu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Nkukaabirira nti, Ayi Katonda, naye toddamu;","poem":1},{"text":"nnyimirira, naye ontunuulira butunuulizi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Onkyukira n’obusungu;","poem":1},{"text":"onnumba n’omukono gwo ogw’amaanyi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Onsitula mu bbanga n’ongobesa empewo,","poem":1},{"text":"n’onziza eno n’eri mu muyaga.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mmanyi nga olintuusa mu kufa,","poem":1},{"text":"mu kifo kye wateekerawo abalamu bonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Ddala tewali ayamba muntu anyigirizibwa","poem":1},{"text":"ng’akaaba mu kunyigirizibwa kwe.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Saakaabira abo abaali mu buzibu?","poem":1},{"text":"Emmeeme yange teyalumirirwa abaavu?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Naye bwe nanoonya obulungi, ekibi kye kyajja;","poem":1},{"text":"bwe nanoonya ekitangaala, ekizikiza kye kyajja.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Olubuto lwange lutokota, terusirika;","poem":1},{"text":"ennaku ez’okubonaabona kwange zinjolekedde.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Nzenna ŋŋenda nzirugala naye si lwa kwokebwa musana;","poem":1},{"text":"nnyimirira mu lukuŋŋaana, ne nsaba obuyambi.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nfuuse muganda w’ebibe,","poem":1},{"text":"munne w’ebiwuugulu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Olususu lwange luddugadde, era lususumbuka;","poem":1},{"text":"n’omubiri gwange gwokerera.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ettendo lyange lifuuseemu kukaaba","poem":1},{"text":"n’akalere kange ne kavaamu eddoboozi ery’ebiwoobe.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}