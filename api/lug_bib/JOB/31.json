{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":31,"content":[{"type":"heading","content":["Obutukuvu bwa Yobu"]},{"type":"verse","number":1,"content":[{"text":"“Nakola endagaano n’amaaso gange;","poem":1},{"text":"obutatunuulira muwala n’amaaso ag’obukaba.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kiki Katonda kye yandinsasudde okuva waggulu,","poem":1},{"text":"omugabo ogwandivudde eri oyo Ayinzabyonna ali waggulu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Emitawaana tegijjira abo abatali batukuvu,","poem":1},{"text":"n’okulaba ennaku ne kujjira abakola eby’obujeemu?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amakubo gange gonna tagalaba,","poem":1},{"text":"era tamanyi ntambula yange?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Obanga natambulira mu bulimba","poem":1},{"text":"era nga n’ekigere kyange kyayanguyiriza okukola obukuusa;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"leka mpimibwe ku minzaani ya Katonda","poem":1},{"text":"amanye obutuukirivu bwange.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Obanga ekigere kyange kyali kikyamye okuva mu kkubo,","poem":1},{"text":"n’omutima gwange ne gugoberera amaaso gange,","poem":2},{"lineBreak":true},{"text":"engalo zange ne zibaako ebbala lyonna;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"kale nsige, omulala abirye,","poem":1},{"text":"weewaawo ebirime byange bikuulibwe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Obanga omutima gwange gwali gusendeddwasendeddwa omukazi,","poem":1},{"text":"oba ne mmuteegera ku mulyango gwa muliraanwa,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"kale omukazi wange ase eŋŋaano y’omusajja omulala,","poem":1},{"text":"n’abasajja abalala beebake naye.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kubanga ekyo kyandibadde kya kivve,","poem":1},{"text":"ekibi ekiŋŋwanira okubonerezebwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ogwo gwandibadde muliro ogwokya okutuusa mu kuzikirira,","poem":1},{"text":"ogwandyokezza ebyange byonna bye nasimba.”","poem":2}]},{"type":"heading","content":["Abaddu n’Abaavu Okubassaako Omwoyo"]},{"type":"verse","number":13,"content":[{"text":"“Obanga nnali nnyoomye ensonga y’omuddu wange oba omuddu wange omukazi,","poem":1},{"text":"bwe banninaako ensonga,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"kale ndikola ntya Katonda bw’alinnyimukiramu?","poem":1},{"text":"Era bw’alimbuuza, ndimuddamu ki?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Eyantonda mu lubuto nabo si ye yabatonda?","poem":1},{"text":"Ffenna si ye yatukola mu mbuto za bannyaffe?","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Obanga nnamma omwavu ekintu kyonna,","poem":1},{"text":"era obanga nakaabya nnamwandu;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"obanga nnali ndidde akamere kange nzekka","poem":1},{"text":"atalina kitaawe n’atalyako,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"kubanga okuva mu buto bwange namulera nga kitaawe,","poem":1},{"text":"era okuva mu lubuto lwa mmange nayamba nnamwandu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Obanga nnali ndabye omuntu yenna ng’afa olw’okubulwa ebyambalo,","poem":1},{"text":"oba ali mu kwetaaga atalina kye yeebikka;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"mpozzi omutima gwe, gwe gutansiima,","poem":1},{"text":"olw’okumubugumya n’ebyoya by’endiga zange;","poem":2}]},{"type":"verse","number":21,"content":[{"text":"obanga nayimusa omukono gwange eri abatalina bakitaabwe,","poem":1},{"text":"kubanga mmanyi nti, mmanyiganye n’ab’obuyinza,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"kale omukono gwange gukutuke ku kibegabega kyange,","poem":1},{"text":"leka gukutukireyo mu kinywa we guyungira.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Olw’okutya okuzikirizibwa Katonda n’olw’obukulu bwe,","poem":1},{"text":"nnali sisobola kukola bintu ng’ebyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Obanga nateeka obweyamo bwange mu zaabu","poem":1},{"text":"oba ne ŋŋamba zaabu ennongoose nti, ‘Ggwe bwesige bwange;’","poem":2}]},{"type":"verse","number":25,"content":[{"text":"obanga neeyagala olw’okuba n’obugagga obungi,","poem":1},{"text":"oba olw’okuba emikono gyange gy’ali ginfunyisizza bingi;","poem":2}]},{"type":"verse","number":26,"content":[{"text":"obanga nnali ntunuulidde enjuba,","poem":1},{"text":"oba omwezi nga byaka mu kitiibwa,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"omutima gwange ne gusendebwasendebwa mu kyama,","poem":1},{"text":"ne mbinywegera nga mbisaamu ekitiibwa,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"era n’ekyo kyandibadde kibi ekiŋŋwanyiza okusalirwa omusango","poem":1},{"text":"olw’obutaba mwesigwa eri Katonda ali waggulu.”","poem":2}]},{"type":"heading","content":["Abalabe n’Abagwira Okubassaako Omwoyo"]},{"type":"verse","number":29,"content":[{"text":"“Obanga nasanyuka ng’omulabe wange afunye emitawaana","poem":1},{"text":"oba ne njaguza olw’ebizibu ebyamutuukako,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"sakkiriza kamwa kange kwonoona","poem":1},{"text":"nga nkolimira obulamu bwe.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Abantu b’omu nnyumba yange bwe baba tebabuuzanga nti,","poem":1},{"text":"‘Ani atakkuse nnyama?’","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Tewali mutambuze yasula ku kkubo,","poem":1},{"text":"kubanga oluggi lwange lwali luggule eri buli muyise.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Obanga nakweka ekibi kyange ng’abantu bwe bakola,","poem":1},{"text":"nga nkweka obutali butuukirivu bwange mu mutima gwange,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"olw’okutya ekibiina,","poem":1},{"text":"nga ntya okuswala mu kika,","poem":2},{"lineBreak":true},{"text":"ne nsirika ne ntya n’okufuluma ebweru,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"so nga waliwo ayinza okumpulira,","poem":1},{"text":"leka nteekeko omukono ku mpoza yange, leka Ayinzabyonna anziremu;","poem":2},{"lineBreak":true},{"text":"n’oyo ampawaabira abiteeke mu buwandiike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"“Ddala ddala nandibyambadde ku kibegabega kyange,","poem":1},{"text":"nandibyambadde ku mutwe ng’engule.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Nandimunnyonnyodde buli kifo we nalinnya ekigere,","poem":1},{"text":"nandimusemberedde ng’omulangira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"“Singa ettaka lyange linkaabirira,","poem":1},{"text":"n’ebinnya byalyo bye nsimye ne bitotobala n’amaziga;","poem":2}]},{"type":"verse","number":39,"content":[{"text":"obanga ndiddemu ebibala awatali kusasula,","poem":1},{"text":"era ne ndeetera bannannyini lyo okufa,","poem":2}]},{"type":"verse","number":40,"content":[{"text":"leka omwennyango gumere mu kifo ky’eŋŋaano,","poem":1},{"text":"n’omuddo oguwunya gumere mu kifo kya sayiri.”","poem":2},"Ebigambo bya Yobu byakoma wano."]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}