{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":32,"content":[{"type":"heading","content":["Eriku Ayogera"]},{"type":"verse","number":1,"content":["Awo abasajja abo abasatu ne balekeraawo okwogera ne Yobu, kubanga yali yeeraba nga mutuukirivu."]},{"type":"verse","number":2,"content":["Naye Eriku, mutabani wa Balakeri Omubuzi, ow’omu kika kya Laamu, n’anyiigira nnyo Yobu olw’okweraba ng’atalina musango, naye n’anenya Katonda."]},{"type":"verse","number":3,"content":["Yanyiigira ne mikwano gye abasatu, kubanga baalemwa okulumiriza Yobu kyokka nga baali bamusingisizza omusango."]},{"type":"verse","number":4,"content":["Eriku yali alinzeeko okwogera ne Yobu kubanga banne baali bakulu okumusinga."]},{"type":"verse","number":5,"content":["Naye bwe yalaba ng’abasajja bano abasatu tebakyalina kirala kya kwogera, n’anyiiga."]},{"type":"verse","number":6,"content":["Awo Eriku mutabani wa Balakeri Omubuzi n’addamu n’ayogera nti,",{"text":"“Nze ndi muto mu myaka,","poem":1},{"text":"mmwe muli bakulu,","poem":2},{"text":"kyenavudde ntya","poem":1},{"text":"okubabuulira kye ndowooza.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nalowoozezza nti, Emyaka gye gisaanye okwogera,","poem":1},{"text":"n’emyaka emingi gye gisaanye okuyigiriza amagezi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kyokka omwoyo oguli mu muntu,","poem":1},{"text":"nga gwe mukka gw’oyo Ayinzabyonna, gwe guwa omuntu okutegeera.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abakadde si be bokka abalina amagezi,","poem":1},{"text":"wadde abakulu bokka okuba nga be bategeera ekituufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Kyenva ŋŋamba nti, Mumpulirize,","poem":1},{"text":"nange mbabuulire kye mmanyi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nassizzaayo omwoyo nga mwogera,","poem":1},{"text":"nawulirizza ensonga ze mwawadde nga munoonya eby’okwogera.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nabawulirizza bulungi.","poem":1},{"lineBreak":true},{"text":"Kyokka tewali n’omu ku mmwe yalaze Yobu bw’ali omukyamu;","poem":1},{"text":"tewali n’omu ku mmwe eyayanukudde ebigambo bye.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mwegendereze temugamba nti, ‘Tusanze omuntu ow’amagezi;","poem":1},{"text":"muleke Katonda amuwangule so si bantu.’","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kyokka Yobu ebigambo bye tabyolekezza nze,","poem":1},{"text":"era sijja kumuddamu na bigambo byammwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Basobeddwa, tebalina kya kwogera,","poem":1},{"text":"ebigambo bibaweddeko.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kaakano nsirike busirisi,","poem":1},{"text":"nga bayimiridde buyimirizi, nga tebalina kye boogera?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nange nnina eky’okwogera,","poem":1},{"text":"era nnaayogera kye mmanyi,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"kubanga nzijjudde ebigambo,","poem":1},{"text":"era omwoyo ogwange gumpaliriza okwogera.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Munda mu nze omutima guli nga wayini, asaanikiddwa mu ccupa,","poem":1},{"text":"ng’amaliba amaggya agalindiridde okwabika.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nteekwa okwogera, nsobole okufuna eddembe,","poem":1},{"text":"nteekwa okwasamya akamwa kange mbeeko kye njogera.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Sijja kubaako gwe nkwatirwa nsonyi,","poem":1},{"text":"era sijja na kuwaana muntu yenna.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kubanga singa mpaaniriza,","poem":1},{"text":"Omutonzi wange yandyanguye okunziggyawo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}