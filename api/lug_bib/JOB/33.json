{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"“Kaakano ggwe Yobu, wuliriza ebigambo byange:","poem":1},{"text":"ssaayo omwoyo ku byonna bye njogera.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Laba nnaatera okwasamya akamwa kange,","poem":1},{"text":"ebigambo byange bindi ku lulimi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ebigambo byange biva mu mutima omulongoofu;","poem":1},{"text":"olulimi lwange, mu bwesimbu, lwogera bye mmanyi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Omwoyo wa Katonda ye yankola,","poem":1},{"text":"era omukka gw’oyo Ayinzabyonna gumpa obulamu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Onnyanukule nno bw’oba osobola,","poem":1},{"text":"teekateeka ebigambo byo onjolekere.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Laba, nange ndi ggwe mu maaso ga Katonda.","poem":1},{"text":"Nange nava mu bbumba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tobaako ky’otya,","poem":1},{"text":"sijja kukunyigiriza.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ddala ddala oyogedde mpulira,","poem":1},{"text":"ebigambo byennyini mbiwulidde ng’ogamba nti,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndi mulongoofu sirina kibi,","poem":1},{"text":"siriiko musango so mu nze temuli butali butuukirivu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kyokka Katonda anteekako omusango,","poem":1},{"text":"anfudde omulabe we.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Asiba ebigere byange mu nvuba,","poem":1},{"text":"antwala okuba omulabe we.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Naye leka nkubuulire, mu kino toli mutuufu.","poem":1},{"text":"Katonda asinga omuntu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lwaki omwemulugunyiza nti,","poem":1},{"text":"taddamu bigambo bya muntu yenna?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kubanga Katonda ayogerera mu ngeri emu, n’awalala n’ayogerera mu ngeri endala,","poem":1},{"text":"wadde ng’omuntu tassaayo mwoyo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mu kirooto mu kwolesebwa ekiro","poem":1},{"text":"ng’otulo tungi tukutte abantu","poem":2},{"lineBreak":true},{"text":"nga beebase ku bitanda byabwe,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"aggula amatu g’abantu,","poem":1},{"text":"n’abalabula n’ebyekango,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"alyoke akyuse omuntu okumuggya mu bikolwa ebibi","poem":1},{"text":"n’amalala,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"aziyize emmeeme ye okukka mu bunnya,","poem":1},{"text":"n’obulamu bwe buleme okuzikirira n’ekitala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Omuntu ayinza okubonerezebwa, olumbe ne lumulumira ku kitanda kye,","poem":1},{"text":"n’alumwa olutatadde mu magumba ge,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"obulamu bwe ne bwetamira ddala emmere,","poem":1},{"text":"emmeeme ye n’ekyayira ddala ebyassava.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Omubiri gwe gugwako ku magumba,","poem":1},{"text":"n’amagumba ge ne gafubutukayo gye gaali geekwese,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"emmeeme ye n’esembera kumpi n’obunnya;","poem":1},{"text":"obulamu bwe ne bulaga eri abo abaleeta okufa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Singa wabaawo malayika ku ludda lwe,","poem":1},{"text":"amuwolereza, omu ku lukumi,","poem":2},{"lineBreak":true},{"text":"okubuulira omuntu ekigwanidde;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"yandimukwatiddwa ekisa n’amugamba nti,","poem":1},{"text":"‘Muwonye aleme kusuulibwa magombe,","poem":2},{"lineBreak":true},{"text":"mmusasulidde omutango,’","poem":2}]},{"type":"verse","number":25,"content":[{"text":"omubiri gwe guzzibwa buggya ng’ogw’omwana omuwere,","poem":1},{"text":"era guddayo ne gubeera nga bwe gwali mu nnaku ze ez’obuvubuka.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Omuntu asaba Katonda, Katonda n’amukwatirwa ekisa.","poem":1},{"text":"Alaba amaaso ga Katonda n’ajaguza n’essanyu,","poem":2},{"lineBreak":true},{"text":"Katonda n’amuddiza nate ekifo kye eky’obutuukirivu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Awo omuntu n’akomawo eri abantu n’abagamba nti,","poem":1},{"text":"Nayonoona, ne nkola ekyo ekitaali kirungi,","poem":2},{"lineBreak":true},{"text":"naye ne sibonerezebwa nga bwe kyali kiŋŋwanidde.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Yanunula emmeeme yange n’amponya okukka mu bunnya;","poem":1},{"text":"kyenaava mbeera omulamu ne nsigala nga mpoomerwa ekitangaala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Bw’atyo Katonda bw’akola omuntu","poem":1},{"text":"emirundi ebiri oba esatu,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"okuzza emmeeme ye ng’agiggya emagombe,","poem":1},{"text":"ekitangaala eky’obulamu kimwakire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Yobu, weetegereze nnyo, ompulirize;","poem":1},{"text":"siriikirira nkubuulire.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Bw’oba ng’olina eky’okwogera kyonna, nziraamu;","poem":1},{"text":"yogera kubanga njagala wejjeerere.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Bwe kitaba kityo, mpuliriza;","poem":1},{"text":"sirika nange nnaakuyigiriza amagezi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}