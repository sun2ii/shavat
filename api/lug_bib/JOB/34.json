{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":34,"content":[{"type":"verse","number":1,"content":["Awo Eriku ne yeeyongera okwogera nti,"]},{"type":"verse","number":2,"content":[{"text":"“Muwulire ebigambo byange, mmwe abasajja ab’amagezi;","poem":1},{"text":"mumpulirize mmwe abayivu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kubanga okutu kugezesa ebigambo","poem":1},{"text":"ng’olulimi bwe lugezesa emmere.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Leka twesalirewo ekituufu;","poem":1},{"text":"muleke tulondewo ekisaanidde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Yobu agamba nti, ‘Siriiko musango,","poem":1},{"text":"naye Katonda agaanye okusala omusango gwange mu mazima.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wadde nga ndi mutuufu,","poem":1},{"text":"ntwalibwa okuba omulimba,","poem":2},{"text":"wadde nga siriiko musango,","poem":1},{"text":"akasaale ke kanteseeko ekiwundu ekitawonyezeka.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Musajja ki ali nga Yobu,","poem":1},{"text":"anywa okunyoomebwa ng’anywa amazzi?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Atambula n’abakozi b’ebibi,","poem":1},{"text":"mukwano gw’abo abakola ebitali bya butuukirivu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kubanga agambye nti, ‘Omuntu talina kyaganyulwa","poem":1},{"text":"bw’agezaako okusanyusa Katonda.’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Noolwekyo mumpulirize mmwe abasajja abalina okutegeera.","poem":1},{"text":"Kikafuuwe Katonda okukola ebibi,","poem":2},{"lineBreak":true},{"text":"wadde Ayinzabyonna okukola ebikyamu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Asasula omuntu olw’ekyo ky’aba akoze;","poem":1},{"text":"n’amutuusaako ebyo ebimusaanidde olw’empisa ze.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Weewaawo amazima gali nti, Katonda tasobya.","poem":1},{"text":"Ayinzabyonna tasaliriza musango.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Obuyinza yabuggya eri ani okukulembera ensi?","poem":1},{"text":"Ani eyamuwa olukusa okufuga ensi yonna?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Singa asalawo n’atwala omwoyo gw’omuntu","poem":1},{"text":"awamu n’omukka gwe,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"abantu bonna bandizikiriridde wamu,","poem":1},{"text":"era omuntu yandizzeeyo mu nfuufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Bw’oba olina okutegeera, wuliriza kino;","poem":1},{"text":"wuliriza kye ŋŋamba.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Oyo atayagala bwenkanya asobola okufuga?","poem":1},{"text":"Onoosalira abatuukirivu n’oyo ow’amaanyi omusango?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Oyo si ye agamba bakabaka nti, ‘Tolina mugaso,’","poem":1},{"text":"n’abakungu nti, ‘Oli mukozi wa bibi,’","poem":2}]},{"type":"verse","number":19,"content":[{"text":"atattira balangira ku liiso","poem":1},{"text":"era nga tafa ku bagagga kusinga bw’afa ku baavu,","poem":2},{"lineBreak":true},{"text":"kubanga egyo gye mirimu gy’emikono gye?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mu kaseera buseera baba bafiiridde wakati mu ttumbi.","poem":1},{"text":"Abantu banyeenyezebwa ne baggyibwawo.","poem":2},{"lineBreak":true},{"text":"Abo ab’amaanyi batwalibwa n’omukono ogutali gw’abantu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Amaaso ge gatunuulira amakubo g’abantu;","poem":1},{"text":"atunuulira buli kigere kye batambula.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Teri kifo kikwafu wadde ekisiikirize eky’amaanyi,","poem":1},{"text":"ababi gye bayinza okwekweka.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Katonda teyeetaaga kwongera kwekebejja bantu","poem":1},{"text":"okulabika mu maaso ge okusalirwa omusango.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Awatali kwebuuza ku muntu yenna, amenyaamenya ab’amaanyi","poem":1},{"text":"n’ateekawo abalala mu kifo kyabwe.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Olw’okubanga amanyi ebikolwa byabwe,","poem":1},{"text":"abamalamu amaanyi ekiro ne babetentebwa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ababonereza olw’ebikolwa byabwe ebibi","poem":1},{"text":"abantu bonna nga balaba,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"kubanga baamuvaako ne balekeraawo okumugoberera","poem":1},{"text":"ne bataddayo kufaayo n’akatono ku makubo ge gonna.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Baleetera abaavu okukaaba, ne kumutuukako","poem":1},{"text":"era n’awulira okukaaba kw’abanyigirizibwa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Naye bw’asalawo obutabaako ky’ayogera, ani ayinza okumunenya?","poem":1},{"text":"Bwakweka amaaso ge ani ayinza okumulaba?","poem":2},{"text":"Eggwanga n’omuntu abalinako obuyinza bwe bumu;","poem":1}]},{"type":"verse","number":30,"content":[{"text":"aziyiza omuntu atatya Katonda okufuga,","poem":2},{"lineBreak":true},{"text":"aleme okutega abantu emitego.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Singa omuntu agamba Katonda nti,","poem":1},{"text":"gunsinze, sikyaddayo kwonoona,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"kye sitegeera kinjigirize,","poem":1},{"text":"bwe mba nga nsobezza sikyaddayo kukikola,","poem":2}]},{"type":"verse","number":33,"content":[{"text":"olwo Katonda akuddemu nga bw’oyagala,","poem":1},{"text":"akuleke ng’ogaanye okwenenya?","poem":2},{"text":"Kaakano ggwe olina okusalawo, so sinze;","poem":1},{"text":"noolwekyo mbuulira ggwe ky’omanyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Abantu abalina okutegeera mumbuulire,","poem":1},{"text":"abasajja abagezi abawulira muntegeeze,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"‘Yobu ayogeza butamanya","poem":1},{"text":"ebigambo bye tebiriimu kwolesebwa.’","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Singa Yobu agezesebbwa okutuusa ku nkomerero,","poem":1},{"text":"olw’okwogera ng’abasajja abakozi b’ebibi!","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Kubanga ku kibi kye ayongeddeko obujeemu,","poem":1},{"text":"n’akuba mu ngalo wakati mu ffe,","poem":2},{"lineBreak":true},{"text":"n’ayongera okwogera ng’awakanya Katonda.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}