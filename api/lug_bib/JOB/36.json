{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":36,"content":[{"type":"verse","number":1,"content":["Eriku ne yeeyongera okwogera nti,"]},{"type":"verse","number":2,"content":[{"text":"“Yongera okuŋŋumiikirizaako katono nkulage,","poem":1},{"text":"nkyalina bye nnina okwogera ebifa ku Katonda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Amagezi ge nnina gava wala,","poem":1},{"text":"era mmanyi nga Omutonzi wange alamula mu bwenkanya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Eky’amazima ebigambo byange si bikyamu,","poem":1},{"text":"oyo akakasa by’amanyi y’ayogera naawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Laba, Katonda wa buyinza, tanyooma bantu;","poem":1},{"text":"w’amaanyi, anywerera ku bigendererwa bye.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Talamya bakozi ba bibi,","poem":1},{"text":"era awa ababonyaabonyezebwa ebibasaanira.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Taggya maaso ge ku batuukirivu,","poem":1},{"text":"abatuuza ku ntebe ey’obwakabaka","poem":2},{"lineBreak":true},{"text":"n’abagulumiza emirembe n’emirembe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Naye abantu bwe baba basibiddwa enjegere","poem":1},{"text":"nga banywezeddwa n’emiguwa egy’okulumwa","poem":2}]},{"type":"verse","number":9,"content":[{"text":"n’abategeeza ensobi zaabwe, n’okwonoona kwabwe,","poem":1},{"text":"nti, beewaggudde,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"aggula amatu gaabwe bawulirize okunenyezebwa","poem":1},{"text":"n’abalagira beenenye ekibi kyabwe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bwe bamugondera ne bamuweereza,","poem":1},{"text":"ennaku zaabwe zonna balizimala mu kwesiima,","poem":2},{"lineBreak":true},{"text":"era n’emyaka gyabwe mu kusanyuka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Naye bwe batamugondera,","poem":1},{"text":"baalizikirizibwa n’ekitala,","poem":2},{"lineBreak":true},{"text":"bafe nga tebalina magezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Ab’emitima egitatya Katonda baba n’obukyayi.","poem":1},{"text":"Ne bw’abasiba, tebamukaabirira abasumulule.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bafiira mu buvubuka bwabwe","poem":1},{"text":"era obulamu bwabwe buzikiririra mu basajja abenzi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Anunula anyigirizibwa mu kubonaabona kwe,","poem":1},{"text":"n’aggula okutu kwe mu kujoogebwa kwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Akusendasenda okukuggya mu kamwa k’okubonaabona,","poem":1},{"text":"akuteeke mu kifo ekigazi ekitaliimu kuziyizibwa,","poem":2},{"lineBreak":true},{"text":"omanye emirembe gy’emeeza yo ejjudde emmere ennungi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Naye kaakano weetisse omugugu ogw’okusalirwa omusango abakozi b’ebibi gwe basaanira;","poem":1},{"text":"okusalirwa omusango n’obwenkanya byakunyweza.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Weegendereze oleme kukkiriza kusendebwasendebwa;","poem":1},{"text":"obunene bw’enguzi buleme okukukyamya.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Obugagga bwo","poem":1},{"text":"oba okufuba kwo kwonna","poem":2},{"lineBreak":true},{"text":"binaakuyamba okukuggya mu buyinike?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Teweegomba budde bwa kiro","poem":1},{"text":"olyoke owalule abantu okuva mu bifo byabwe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Weegendereze oleme kukola bitali bya butuukirivu,","poem":1},{"text":"by’osinga okwagala okukira okubonyaabonyezebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Laba Katonda yagulumira mu maanyi ge;","poem":1},{"text":"ani ayigiriza nga ye?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ani eyali amukubidde amakubo,","poem":1},{"text":"oba okumugamba nti, ‘Ky’okoze si kituufu?’","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Jjukira ng’oteekwa okugulumizanga emirimu gye,","poem":1},{"text":"abantu gye bayimba mu nnyimba.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Abantu bonna baagiraba,","poem":1},{"text":"omuntu agirengerera wala.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Laba, Katonda agulumizibwe! Assukiridde okutegeera kwaffe;","poem":1},{"text":"obungi bw’emyaka gye tebunoonyezeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Kubanga akuŋŋaanya amatondo g’amazzi,","poem":1},{"text":"agafuuka enkuba etonnya mu bugga;","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ebire bivaamu amazzi gaabyo,","poem":1},{"text":"enkuba n’ekuba abantu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ani ayinza okutegeera engeri gy’asaasaanyamu ebire,","poem":1},{"text":"okubwatuka okuva ku kituuti kye?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Laba, asaasaanya okumyansa kw’eggulu,","poem":1},{"text":"era n’abikka obuziba bw’ennyanja.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Eyo y’engeri gy’afugamu amawanga,","poem":1},{"text":"n’agawa emmere mu bungi.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Emikono gye agijjuza eraddu,","poem":1},{"text":"n’agiragira ekube ebifo bye yeerondeddemu.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Okubwatuka kwayo kulangirira kibuyaga ajja,","poem":1},{"text":"n’ente ne zirangirira okujja kwayo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}