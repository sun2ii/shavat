{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":[{"text":"“Kino kikankanya omutima gwange,","poem":1},{"text":"ne gubuuka okuva mu kifo kyagwo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wuliriza okubwatuka kw’eddoboozi lye,","poem":1},{"text":"n’okuwuluguma okuva mu kamwa ke.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asumulula eggulu ne limyansa wansi w’eggulu wonna,","poem":1},{"text":"n’aliragira ligende ku nkomerero y’ensi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kino oluggwa, okuwuluguma kw’eddoboozi lye kwe kuddako,","poem":1},{"text":"abwatuka n’eddoboozi lye ery’omwanguka,","poem":2},{"text":"era eddoboozi lye bwe liwulirwa,","poem":1},{"text":"tewabaawo kisigala nga bwe kibadde.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eddoboozi lya Katonda libwatuka mu ngeri ey’ekitalo;","poem":1},{"text":"akola ebintu ebikulu ebisukka okutegeera kwaffe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Agamba omuzira nti, ‘Ggwa ku nsi,’","poem":1},{"text":"ate eri enkuba etonnya nti, ‘Ttonnya nnyo.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Emirimu gya buli muntu giyimirira,","poem":1},{"text":"buli omu n’alyoka amanya amaanyi ga Katonda.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ensolo ne ziryoka zessogga empuku zaazo,","poem":1},{"text":"ne zigenda zeekukuma.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Omuyaga ne gulyoka guva mu nnyumba yaagwo,","poem":1},{"text":"n’obunnyogovu ne buva mu mpewo ekuŋŋunta.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Omuzira ne guva mu mukka gwa Katonda","poem":1},{"text":"n’amazzi amangi ne gekwata kitole.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ebire abijjuza amatondo g’amazzi,","poem":1},{"text":"n’asaasaanya okumyansa kw’eggulu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Byetooloolatooloola nga y’abiragira,","poem":1},{"text":"ne bituukiriza byonna by’abiragira,","poem":2},{"lineBreak":true},{"text":"ku nsi yonna okubeera abantu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bwe kuba kubonereza, oba okufukirira ensi","poem":1},{"text":"oba okulaga okwagala kwe, atonnyesa enkuba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Wuliriza kino Yobu;","poem":1},{"text":"sooka oyimirire olowooze ku bikolwa bya Katonda eby’ettendo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Omanyi Katonda engeri gy’alagiramu ebire,","poem":1},{"text":"n’aleetera eggulu okumyansa?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Omanyi engeri ebire gye bituulamu mu bbanga,","poem":1},{"lineBreak":true},{"text":"amakula g’emirimu gy’oyo eyatuukirira mu kumanya?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ggwe alina ebyambalo ebibuguma,","poem":1},{"text":"ensi bw’eba ng’ekkakkanyizibbwa embuyaga ez’obukiikaddyo,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"oyinza okumwegattako ne mubamba eggulu,","poem":1},{"text":"eryaguma ne libeera ng’endabirwamu ensanuuse?","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Tubuulire kye tunaamugamba;","poem":1},{"text":"tetusobola kuwoza nsonga zaffe gy’ali olw’ekizikiza kye tulimu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Asaanidde okubuulirwa kye njagala okwogera?","poem":1},{"text":"Eriyo omuntu yenna ayinza okusaba okumalibwawo?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kaakano tewali n’omu ayinza kutunula mu njuba,","poem":1},{"text":"olw’engeri gy’eyakamu ku ggulu,","poem":2},{"lineBreak":true},{"text":"ng’empewo emaze okuyita, n’eyelula ebire.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mu bukiikakkono evaayo zaabu;","poem":1},{"text":"Katonda ajja mu kitiibwa eky’amaanyi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ayinzabyonna tatuukikako era agulumidde mu maanyi,","poem":1},{"text":"mu bwenkanya bwe era ne butuukirivu bwe, tawaliriza muntu yenna.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Noolwekyo abantu bamutya,","poem":1},{"text":"takitwala ng’ekikulu olw’abo abeerowooza okuba abagezi mu mitima gyabwe.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}