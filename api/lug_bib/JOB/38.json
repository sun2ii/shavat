{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":38,"content":[{"type":"heading","content":["Mukama Ayogera"]},{"type":"verse","number":1,"content":["Mukama n’addamu Yobu ng’ayita mu muyaga, n’ayogera nti,"]},{"type":"verse","number":2,"content":[{"text":"“Ani ono aleeta ekizikiza ku kuteesa kwange,","poem":1},{"text":"n’ebigambo ebitaliimu magezi?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yambala ebyambalo byo ng’omusajja,","poem":1},{"text":"mbeeko bye nkubuuza","poem":2},{"lineBreak":true},{"text":"naawe onziremu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Wali ludda wa nga nteekawo emisingi gy’ensi?","poem":1},{"text":"Mbuulira bw’oba otegeera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ani eyasalawo ebipimo byayo? Ddala oteekwa okuba ng’omanyi!","poem":1},{"text":"Oba ani eyagipima n’olukoba?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Entobo zaayo zaateekebwa ku ki?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Emunyeenye ez’oku makya bwe zaali ziyimba,","poem":1},{"text":"era n’abaana ba Katonda bonna nga baleekaana olw’essanyu,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ani eyasiba enzigi n’aggalira ennyanja,","poem":1},{"text":"bwe yava mu lubuto lwayo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Bwe nakolera ebire ekyambalo kyabyo,","poem":1},{"text":"ne mbisibira mu kizikiza ekikwafu,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"bwe n’abiteekerawo we bikoma","poem":1},{"text":"ne mbiteerako emitayimbwa n’enzigi,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"bwe nagamba nti, Wano we mutuuse we munaakoma temujja kweyongerayo,","poem":1},{"text":"era wano amayengo gammwe ag’amalala we ganaakoma?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Oba wali olagidde ku budde okukya kasookedde obaawo ku nsi,","poem":1},{"text":"oba emmambya okugiraga ekifo kyayo,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"eryoke ekwate ensi w’ekoma","poem":1},{"text":"eginyeenye esuule eri ababi bagiveeko bagwe eri?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ensi eggyayo ebyafaayo byayo n’eba ng’ebbumba wansi w’akabonero,","poem":1},{"text":"ebyafaayo ebyo ne byefaananyiriza olugoye.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Abakozi b’ebibi bammibwa ekitangaala kyabwe,","poem":1},{"text":"n’omukono gwabwe gwe bayimusa gumenyebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Wali otuuseeko ku nsulo ennyanja w’esibuka,","poem":1},{"text":"oba n’olaga mu buziba bw’ennyanja?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wali obikuliddwa enzigi z’emagombe?","poem":1},{"text":"Oba wali olabye enzigi z’ekisiikirize ky’okufa?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wali otegedde obugazi bw’ensi?","poem":1},{"text":"Byogere, oba bino byonna obimanyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Ekkubo eridda mu nnyumba omusana gye gusula liri ludda wa?","poem":1},{"text":"N’ekifo ekizikiza gye kisula kye kiruwa?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ddala, osobola okubitwala gye bibeera?","poem":1},{"text":"Omanyi ekkubo erigenda gye bisula?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ddala oteekwa okuba ng’obimanyi,","poem":1},{"text":"kubanga wali wazaalibwa dda!","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Wali oyingidde amazzi agakwata mu butiti, gye gaterekebwa,","poem":1},{"text":"oba wali olabye omuzira gye guterekebwa?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bye nterekera ebiseera eby’emitawaana,","poem":1},{"text":"bikozesebwe mu nnaku ez’entalo n’okulwana?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kkubo ki erituusa ekitangaala ky’omusana gye kisaasaanira,","poem":1},{"text":"oba empewo ey’ebuvanjuba gy’esaasaanira ku nsi?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ani akubira amataba emikutu mwe ganaayita,","poem":1},{"text":"oba ekkubo eggulu eribwatuka mwe liyita?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ani atonnyesa enkuba mu nsi abantu mwe batabeera,","poem":1},{"text":"eddungu omutali muntu yenna,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"n’okufukirira ettaka eryalekebwa awo, eryazika,","poem":1},{"text":"n’okulimezaako omuddo?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Enkuba erina kitaawe waayo?","poem":1},{"text":"Ani azaala amatondo ag’omusulo?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Omuzira guva mu lubuto lw’ani?","poem":1},{"text":"Ani azaala obutiti obukwafu obw’omu ggulu,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"amazzi mwe gakwatira ne gakaluba ng’amayinja,","poem":1},{"text":"ne kungulu kw’obuziba ne kukwata?","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Oyinza okuziyiza okwakaayakana kwa Kakaaga,","poem":1},{"text":"oba okutaggulula enkoba za Ntungalugoye?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Oyinza okufulumya emunyeenye ziveeyo zaake ng’ekiseera kyazo kituuse,","poem":1},{"text":"oba okuluŋŋamya eddubu n’abaana balyo?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Omanyi amateeka n’obufuzi bw’eggulu?","poem":1},{"text":"Oyinza okuteekawo obufuzi bw’alyo oba obwa Katonda ku nsi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Oyinza okuyimusa eddoboozi lyo oleekaanire ebire,","poem":1},{"text":"olyoke obiggyemu amataba gakubikke?","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ggwe otuma eggulu limyanse era libwatuke?","poem":1},{"text":"Lisobola okukweyanjulira nti, ‘Tuutuno tuli wano’?","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ani eyateeka amagezi mu mutima gw’omuntu,","poem":1},{"text":"oba eyateeka okutegeera mu mmeeme?","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Ani alina amagezi agabala ebire?","poem":1},{"text":"Ani ayinza okuwunzika ebibya by’amazzi eby’omu ggulu,","poem":2}]},{"type":"verse","number":38,"content":[{"text":"enfuufu ng’efuuse ettaka ekkalu,","poem":1},{"text":"era amafunfugu ne geegattira ddala?","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“Empologoma enkazi, oyinza okugiyiggira ky’eneerya,","poem":1},{"text":"oba okuliisa empologoma n’ozimalako enjala,","poem":2}]},{"type":"verse","number":40,"content":[{"text":"bwe zeezinga mu mpuku zaazo,","poem":1},{"text":"oba bwe zigalamira nga ziteeze mu bisaka?","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Ani awa namuŋŋoona emmere,","poem":1},{"text":"abaana baayo bwe bakaabirira Katonda,","poem":2},{"lineBreak":true},{"text":"nga batambulatambula nga babuliddwa emmere?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/37.json","previousChapterAudioLinks":{},"numberOfVerses":41}