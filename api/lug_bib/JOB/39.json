{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"“Omanyi ebiro embuzi z’oku nsozi mwe zizaalira?","poem":1},{"text":"Oba oyinza okumanya empeewo we ziwakira?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Oyinza okubala emyezi gye zimala zizaale?","poem":1},{"text":"Omanyi obudde mwe zizaalira?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Zikutama ne zizaala abaana baazo,","poem":1},{"text":"ne ziwona obulumi bw’okuzaala.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abaana baazo bakula ne bagejjera ku ttale,","poem":1},{"text":"batambula ne bagenda obutadda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Ani eyaleka entulege okwetambulira mu ddembe lyayo?","poem":1},{"text":"Ani eyasumulula emiguwa gyayo,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"gye nawa ensi ey’omuddo okuba amaka gaayo,","poem":1},{"text":"n’ensi ey’omunnyo okubeerangamu?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Esekerera oluyoogaano lw’ekibuga,","poem":1},{"text":"tewuliriza kulekaana kw’abavuzi ba bidduka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ebuna ensozi, ly’eddundiro lyayo,","poem":1},{"text":"ng’enoonya ekintu kyonna ekibisi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Embogo eyinza okukkiriza okuba omuweereza wo,","poem":1},{"text":"n’esula ekiro mu kisibo kyo?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Oyinza okugisiba ku muguwa n’ogirimisa olubimbi?","poem":1},{"text":"Eyinza okukuvaako emabega ng’erima mu kiwonvu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Oyinza okugyesiga olw’amaanyi gaayo amangi?","poem":1},{"text":"Oyinza okugirekera emirimu gyo egy’amaanyi?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Oyinza okugyesiga okukuleetera emmere yo ey’empeke,","poem":1},{"text":"oba okukuleetera eŋŋaano mu gguuliro lyo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Ebiwaawaatiro bya maaya bisanyusa nga byewujja,","poem":1},{"text":"naye ebiwaawaatiro n’ebyoya bya kalooli tebiraga kisa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kubanga emaaya ebiika amagi gaayo ku ttaka,","poem":1},{"text":"n’egaleka ne gabugumira mu musenyu,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ne yeerabira nti, ekigere kisobola okugaasa,","poem":1},{"text":"era nga ensolo ey’omu nsiko eyinza okugalinnya.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Obwana bwayo ebuyisa bubi ng’obutali bwayo","poem":1},{"text":"gy’obeera nti, yazaalira bwereere.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kubanga Katonda teyagiwa magezi","poem":1},{"text":"wadde okutegeera.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ate bw’eyanjuluza ebiwaawaatiro byayo edduke","poem":1},{"text":"esoomooza embalaasi n’omugoba waayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Embalaasi ggwe ogiwa amaanyi,","poem":1},{"text":"oba ggwe oyambaza ensingo yaayo obwoya obwewumba?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ggwe ogisobozesa okubuuka ng’enzige","poem":1},{"text":"n’ekanga n’okukaaba kwayo okw’entiisa?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Etakula ettaka mu kiwonvu, nga yeeyagala olw’amaanyi gaayo,","poem":1},{"text":"n’eryoka efuluma okusisinkana abalwanyi abakutte ebyokulwanyisa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Esekerera okutya, n’eteba na kigitiisa.","poem":1},{"text":"Ekitala tekigitiisa kugizza mabega.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Omufuko ogujjudde obusaale gwesuukundira ku lubuto lwayo,","poem":1},{"text":"awamu n’effumu erimasamasa, n’akasaale.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mu busungu obungi emira ettaka,","poem":1},{"text":"tesobola kusigala mu kifo kimu ng’ekkondeere livuze.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ekkondeere bwe livuga n’egamba nti, ‘Awo!’","poem":1},{"text":"N’ewunyiriza olutalo olukyali ewala,","poem":2},{"lineBreak":true},{"text":"n’ewulira n’okuleekaana kwa baduumizi b’amaggye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Amagezi go ge gabuusa kamunye,","poem":1},{"text":"n’ayanjuluza ebiwaawaatiro bye e bukiikaddyo?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ggwe olagira empungu okubuukira ewala mu bbanga,","poem":1},{"text":"era n’ezimba n’ekisu kyayo waggulu ennyo?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ku lwazi kw’ezimba amaka gaayo ekiro n’esula okwo,","poem":1},{"text":"ku lwazi olunywevu olutabetentebwa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Eyo gy’ekettera omuyiggo gw’eneerya,","poem":1},{"text":"eriiso lyayo ligulengerera wala.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Obwana bwayo bunywa omusaayi,","poem":1},{"text":"era awali emirambo w’ebeera.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}