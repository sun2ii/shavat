{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":4,"content":[{"type":"heading","content":["Erifaazi Ayogera"]},{"type":"verse","number":1,"content":["Awo Erifaazi Omutemani n’ayanukula ng’agamba nti,"]},{"type":"verse","number":2,"content":[{"text":"“Omuntu bw’anaayogera naawe onoonyiiga?","poem":1},{"text":"Naye ani ayinza okusirika obusirisi?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Laba, wayigiriza bangi,","poem":1},{"text":"emikono eminafu wagizzaamu amaanyi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ebigambo byo byanyweza abaali bagwa,","poem":1},{"text":"era ng’ozzaamu amaanyi amaviivi agaali gakankana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Naye kaakano kikutuuseeko, oweddemu amaanyi;","poem":1},{"text":"kikutte ku ggwe n’oggwaawo!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Okutya Katonda wo si bwe bwesige bwo,","poem":1},{"text":"n’obwesimbu bwo si ly’essuubi lyo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Kaakano lowooza; ani ataliiko musango eyali azikiridde?","poem":1},{"text":"Oba wa abatuukirivu gye baali bamaliddwawo?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Okusinziira ku kyendabye; abo abateekateeka okukola ebibi era ne basiga ebitali bya butuukirivu,","poem":1},{"text":"bakungula bizibu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bazikirizibwa omukka Katonda gw’assa,","poem":1},{"text":"bamalibwawo obusungu bwe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Okuwuluguma kw’empologoma, n’eddoboozi ly’empologoma enkambwe,","poem":1},{"text":"n’amannyo g’empologoma ento gamenyeka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Empologoma ey’amaanyi ezikirira olw’okubulwa omuyiggo,","poem":1},{"text":"n’obwana bw’empologoma busaasaana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Nategeezebwa ekigambo eky’ekyama,","poem":1},{"text":"ne nkitegera okutu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wakati mu birowoozo n’okwolesebwa kw’ekiro","poem":1},{"text":"ng’otulo otungi tukutte omuntu,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"okutya n’okukankana byankwata ne bireetera amagumba gange okunyegenya.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Omwoyo gw’ayita mu maaso gange,","poem":1},{"text":"obwoya bw’oku mubiri gwange ne buyimirira.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ne buyimirira butengerera,","poem":1},{"text":"naye saasobola kwetegereza ndabika yaabwo,","poem":2},{"text":"n’ekifaananyi kyali mu maaso gange, ne wabaawo akasiriikiriro,","poem":1},{"text":"ne ndyoka mpulira eddoboozi nga ligamba nti,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"‘Omuntu afa ayinza okuba omutuukirivu okusinga Katonda?","poem":1},{"text":"Omuntu ayinza okuba omulongoofu okusinga Omutonzi we?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Obanga abaddu be tabeesiga,","poem":1},{"text":"nga bamalayika be abalanga ensobi","poem":2}]},{"type":"verse","number":19,"content":[{"text":"kale kiriba kitya,","poem":1},{"text":"abo abasula mu z’ebbumba ezirina emisingi egiri mu nfuufu,","poem":2},{"lineBreak":true},{"text":"ababetentebwa n’okusinga ekiwojjolo?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bamalibwawo wakati w’amakya n’akawungeezi,","poem":1},{"text":"bazikirira emirembe n’emirembe awatali abafaako.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Omuguwa gwa weema yaabwe gusimbulwa munda,","poem":1},{"text":"ne bafa ng’abasirusiru.’ ”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}