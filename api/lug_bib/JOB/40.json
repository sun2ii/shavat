{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":["Awo Mukama n’agamba Yobu nti,"]},{"type":"verse","number":2,"content":[{"text":"“Oyo anoonya okuyombera ebitaliimu anaayombesa Ayinzabyonna?","poem":1},{"text":"Oyo aleeta empaka ku Katonda, amuddemu.”","poem":2}]},{"type":"verse","number":3,"content":["Awo Yobu n’addamu Mukama nti,"]},{"type":"verse","number":4,"content":[{"text":"“Laba, sisaanidde, kiki kye nnaakuddamu?","poem":1},{"text":"Emimwa kangibikkeko n’engalo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Njogedde omulundi gumu, so siddemu;","poem":1},{"text":"weewaawo emirundi ebiri sseeyongere mulundi mulala.”","poem":2}]},{"type":"verse","number":6,"content":["Awo Mukama ng’ali mu muyaga ogw’amaanyi n’addamu Yobu nti,"]},{"type":"verse","number":7,"content":[{"text":"“Weesibe engoye zo onywere ng’omusajja.","poem":1},{"text":"Ka nkubuuze,","poem":2},{"lineBreak":true},{"text":"naawe onziremu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Onojjulula ensala yange ey’emisango;","poem":1},{"text":"ononsingisa omusango ggwe atuukiridde?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Olina omukono ng’ogwa Katonda,","poem":1},{"text":"eddoboozi lyo lisobola okubwatuka ng’erirye?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kale nno yambala ekitiibwa n’obukulu","poem":1},{"text":"weesibe ekitiibwa n’okusukkuluma osukkulume.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yolesa obusungu bw’ekiruyi kyo","poem":1},{"text":"otunuulire buli wa malala omusse wansi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tunuulira buli musajja ow’amalala omukkakkanye","poem":1},{"text":"era olinnyirire abakozi b’ebibi obabetentere we bali.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bonna baziikire wamu mu nfuufu,","poem":1},{"text":"emitwe gyabwe ogibikkire mu ntaana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nange kennyini ndyoke nzikirize,","poem":1},{"text":"ng’omukono gwo ogwa ddyo, gusobola okukuwa amaanyi.”","poem":2}]},{"type":"heading","content":["Amaanyi g’Envubu"]},{"type":"verse","number":15,"content":[{"text":"“Laba ekisolo ekyefaananyiriza ng’envubu","poem":1},{"text":"kye natonda nga ggwe,","poem":2},{"lineBreak":true},{"text":"erya omuddo ng’ente,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"nga kirina amaanyi mayitirivu mu kiwato kyakyo","poem":1},{"text":"amaanyi mangi mu binywa by’olubuto lwakyo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kiwuuba omukira gwakyo ne guba ng’omukira gw’omuvule","poem":1},{"text":"Ebinywa by’ebisambi byakyo byakwatagana nnyo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Amagumba gaakyo gali ng’enseke ez’ebikomo;","poem":1},{"text":"amagulu n’emikono ng’emitayimbwa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kibalibwa mu bitonde bya Katonda ebisooka,","poem":1},{"text":"ate nga Katonda eyakitonda asobola okukisemberera n’ekitala kye.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Weewaawo ensozi zikireetera emmere,","poem":1},{"text":"eyo ku nsozi, ensolo ez’omu nsiko zonna gye zizannyira.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wansi w’ebisiikirize by’emiti egy’amaggwa, we kyebaka,","poem":1},{"text":"ne kyekweka mu bitoogo ne mu bitosi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ebisiikirize by’emiti bikibikkako,","poem":1},{"text":"emiti egiri ku mabbali g’omugga ne gikibikkako.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Laba omugga ne bwe gusiikuuka tekyekanga;","poem":1},{"text":"kiba kinywevu, Yoludaani ne bwajjula n’abooga.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Eriyo omuntu yenna ayinza okukikwata,","poem":1},{"text":"oba okuyuza ennyindo yaakyo n’akasaale?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}