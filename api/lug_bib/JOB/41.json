{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":41,"content":[{"type":"heading","content":["Amaanyi ga Lukwata"]},{"type":"verse","number":1,"content":[{"text":"“Oyinza okusikayo lukwata n’eddobo,","poem":1},{"text":"oba okusiba olulimi lwayo n’omuguwa?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Oyinza okuyingiza omuguwa mu nnyindo zaayo,","poem":1},{"text":"oba okuwummula oluba lwayo n’eddobo?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Eneekwegayirira ng’ekusaba nti, ogikwatirwe ekisa?","poem":1},{"text":"Eneeyogera naawe mu bigambo ebigonvu?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Eneekola naawe endagaano","poem":1},{"text":"ogitwale ekuweereze obulamu bwayo bwonna?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Onoozannya nayo nga bw’ozannya n’akanyonyi,","poem":1},{"text":"oba okugisiba n’olukoba ng’agisibira bawala bo?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abasuubuzi banaagiramuza,","poem":1},{"text":"oba banaagibala ng’ekyamaguzi?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Oyinza okuvuba eddiba lyayo n’olijjuza amalobo,","poem":1},{"text":"oba omutwe okugufumita n’amafumu agafumita ebyennyanja?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bw’oligissaako engalo zo ekirivaamu tolikyerabira,","poem":1},{"text":"toliddayo kukikola!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Essuubi lyonna ery’okugiwangula ffu,","poem":1},{"text":"okugirabako obulabi kimalamu amaanyi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Teri n’omu mukambwe nnyo asobola kugyaŋŋanga.","poem":1},{"text":"Kale, ani oyo asobola okuyimirira mu maaso gange?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani alina kye yali ampoze musasule?","poem":1},{"text":"Byonna ebiri wansi w’eggulu byange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Ku bikwata ku mikono n’ebigere byayo siisirike,","poem":1},{"text":"amaanyi gaayo n’ekikula kyayo bya ssimbo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ani ayinza okugiggyako eddiba lyayo ery’oku ngulu?","poem":1},{"text":"Ani ayinza okuyuza ekizibaawo kyayo eky’amaliba abiri?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ani ayinza okuggula enzigi z’akamwa kaayo?","poem":1},{"text":"Amannyo gaayo geetooloddwa entiisa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Omugongo gwe gujjudde enkalala z’engabo","poem":1},{"text":"ezisibiddwa okumukumu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Zonna zisibaganye nga tewali mpewo weeyita.","poem":1}]},{"type":"verse","number":17,"content":[{"text":"Zakwatagana,","poem":2},{"lineBreak":true},{"text":"ziri ku zinnaazo era tezisobola kwawulibwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bw’eyasimula, ebimyanso bijja,","poem":1},{"text":"n’amaaso gaayo gali nga enjuba ng’egwa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mu kamwa kaayo muvaamu ebiriro ebyaka.","poem":1},{"text":"Kavaamu ensasi ez’omuliro.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mu nnyindo zaayo muvaamu omukka","poem":1},{"text":"ng’ogwentamu eyeesera eri ku muliro ogw’emmuli ezaaka.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Omukka oguva mu nnyindo zaayo","poem":1},{"text":"gukoleeza Amanda.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mu nsingo yaayo mulimu amaanyi,","poem":1},{"text":"n’entiisa eri mu maaso gaayo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Emiwula gy’ennyama yaayo gyegasse;","poem":1},{"text":"gikutte nnyo era tegisobola kwenyeenya.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ekifuba kyayo kigumu ng’olwazi,","poem":1},{"text":"kigumu ng’olubengo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bwesituka ab’amaanyi batya.","poem":1},{"text":"Badduka olw’okubwatuka kwayo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ekitala bwe kigituukako tekirina kye kiyinza kumukolako,","poem":1},{"text":"oba ffumu, oba omuwunda wadde akasaale akasongovu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Emenya ebyuma gy’obeera nti ekutulakutula bisasiro,","poem":1},{"text":"ebyo ebikomo ebimenyaamenya ng’emiti emivundu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Akasaale tekayinza kugiddusa,","poem":1},{"text":"amayinja ag’envumuulo gaba nga biti gy’eri.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Embukuuli nayo eri ng’ebisusunku gy’eri.","poem":1},{"text":"Esekerera amafumu agakasukibwa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Amagalagamba g’oku lubuto lwayo gali ng’engyo z’ensuwa.","poem":1},{"text":"Bwe yeekulula mu bitosi ebeera ng’ekyuma ekiwuula.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ereetera obuziba bw’ennyanja okuba ng’entamu eyeesera.","poem":1},{"text":"Ennyanja n’eba ng’entamu y’omuzigo ogufumbibwa.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Mu mazzi mw’eyise, erekamu ekkubo ery’amayengo ameeru;","poem":1},{"text":"ne kireeta n’ekirowoozo nti obuziba bulina envi.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Tewali kigyenkana ku nsi;","poem":1},{"text":"ekitonde ekitatya.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Enyooma buli kisolo.","poem":1},{"text":"Ye kabaka w’abo bonna ab’amalala.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":34}