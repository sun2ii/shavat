{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"“Koowoola kaakano, waliwo anaakuyitaba?","poem":1},{"text":"Era ani ku batukuvu gw’onoolaajaanira?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Obukyayi butta atalina magezi,","poem":1},{"text":"n’obuggya butta omusirusiru.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndabye abasirusiru nga banywevu,","poem":1},{"text":"naye mangu ddala ne nkolimira ekifo kye batuulamu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abaana baabwe tebalina bukuumi,","poem":1},{"text":"babetenterwa mu luggya nga tewali abawolereza.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Omuyala alya amakungula gaabwe","poem":1},{"text":"era atwala n’ag’omu maggwa","poem":2},{"lineBreak":true},{"text":"era awankirawankira eby’obugagga byabwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kubanga okulaba ennaku tekuva mu nsi,","poem":1},{"text":"wadde obuzibu okuva mu ttaka,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"wabula abantu bazaalibwa kulaba nnaku,","poem":1},{"text":"ng’ensasi bwe zibuuka waggulu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Naye nze, nzija kunoonya Katonda","poem":1},{"text":"era mmulekere ensonga zange.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akola ebikulu, ebitanoonyezeka,","poem":1},{"text":"ebyewuunyisa ebitabalika.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Atonnyesa enkuba ku nsi,","poem":1},{"text":"n’aweereza amazzi mu byalo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ayimusa abo abanyigirizibwa","poem":1},{"text":"n’abo abakaaba ne basitulibwa mu mirembe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Aziyiza enkwe z’ababi,","poem":1},{"text":"emikono gyabwe gireme okutuukiriza bye bateesa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Agwikiririza abagezigezi mu bukujjukujju bwabwe,","poem":1},{"text":"n’enkwe zaabwe n’aziziyiriza ddala.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ekizikiza kibabuutikira emisana,","poem":1},{"text":"ne bawammanta mu ttuntu ng’ekiro.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Naye aggya abali mu bwetaavu mu mukono gw’abo ab’amaanyi,","poem":1},{"text":"n’abawonya ekitala kyabwe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abaavu ne balyoka baba n’essuubi,","poem":1},{"text":"n’akamwa k’abatali benkanya ne kazibibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Alina omukisa omuntu Katonda gw’abuulirira;","poem":1},{"text":"noolwekyo tonyooma kukangavvula kw’oyo Ayinzabyonna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kubanga ye y’afumita ate era y’anyiga,","poem":1},{"text":"y’alumya era y’awonya.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Alikuwonya mu buzibu bwa ngeri mukaaga.","poem":1},{"text":"Weewaawo ne mu ngeri musanvu tootuukibwengako kulumizibwa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mu njala alikuwonya okufa,","poem":1},{"text":"era anaakuwonyanga mu lutalo olw’ekitala.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Onookuumibwanga eri olulimi olukambwe,","poem":1},{"text":"era tootyenga okuzikirira bwe kunaabanga kujja gy’oli.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Oliseka ng’okuzikirira n’enjala bizze,","poem":1},{"text":"era tootyenga nsolo nkambwe ez’oku nsi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Onoobanga n’enkolagana n’amayinja ag’omu nnimiro,","poem":1},{"text":"era onoobanga n’emirembe awali ensolo enkambwe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Olimanya nti, ensiisira yo eri mirembe;","poem":1},{"text":"era eby’obugagga byo olibibala n’olaba nga tewali kibuzeeko.","poem":2}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Olimanya ng’ezzadde lyo liriba ddene,","poem":2},{"lineBreak":true},{"text":"ne bazzukulu bo baliba bangi ng’omuddo ogw’oku nsi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Olituusibwa ku ntaana yo nga wakaddiyira ddala,","poem":1},{"text":"ng’eŋŋaano bwe tuukira mu kiseera kyayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Ekyo twakyekenneenya, kituufu.","poem":1},{"text":"Kimanye nga kikwata ku ggwe.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}