{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":6,"content":[{"type":"heading","content":["Yobu Ayanukula"]},{"type":"verse","number":1,"content":["Yobu n’ayanukula ng’agamba nti,"]},{"type":"verse","number":2,"content":[{"text":"“Singa okweraliikirira kwange,","poem":1},{"text":"n’okubonaabona kwange bipimibwa ne biteekebwa ku minzaani!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Weewaawo byandisinze omusenyu gw’ennyanja okuzitowa;","poem":1},{"text":"ebigambo byange kyenvudde mbyanguyiriza.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Obusaale bwa Ayinzabyonna buli mu nze","poem":1},{"text":"n’omwoyo gwange gunywedde obusagwa bwabwo:","poem":2},{"lineBreak":true},{"text":"entiisa ya Katonda erwana nange.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Entulege ekaaba awali omuddo,","poem":1},{"text":"oba ente ennume eŋŋooŋŋa awali emmere yaayo?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Emmere etaliimu nsa eriika omutali munnyo,","poem":1},{"text":"oba amazzi g’eggi okubaamu akawoomerera?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Omutima gwange tegusikirizibwa kubikombako,","poem":1},{"text":"biri ng’emmere etangasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Singa Katonda ampa kye nsaba,","poem":1},{"text":"n’ampa kye nsuubira,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"yandisiimye okumbetenta","poem":1},{"text":"ne mmalibwawo omukono gwe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kino kyandikkakkanyizza","poem":1},{"text":"obulumi obutakoma","poem":2},{"lineBreak":true},{"text":"kubanga sigaanye bigambo bya Mutukuvu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amaanyi ngaggya wa, ndyoke mbe n’essuubi?","poem":1},{"text":"Era enkomerero yange, eruwa ndyoke ngumiikirize?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Amaanyi gange ga mayinja","poem":1},{"text":"oba omubiri gwange gwa kikomo?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mu mazima sirina maanyi","poem":1},{"text":"n’obusobozi bwanzigwako.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Oyo agaana ebyekisa okuva eri mukwano gwe","poem":1},{"text":"tafaayo kutya Ayinzabyonna.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Baganda bange tebeesigika, bali ng’akagga akabooga","poem":1},{"text":"ate ne kakalira,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"akaddugalirira","poem":1},{"text":"buli lwe kakwata, ng’omuzira,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ate ne kaggwaawo","poem":1},{"text":"buli lwe wabaawo ebbugumu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ebibinja by’abatambuze we biviira ku mugendo","poem":1},{"text":"ne biraga mu ddungu ne bizikirira.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Abatambuze b’e Teema banoonya,","poem":1},{"text":"bo ab’e Seeba ne balindirira n’essuubi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Baalina essuubi","poem":1},{"text":"naye bwe baatuukayo ne banyolwa nnyo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kaakano bwe mundabye ne mutya","poem":1},{"text":"ne mukakasizza ddala nga temuliiko kye muyinza kukola.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nnali mbagambye nti, ‘Mumpe ekirabo,’","poem":1},{"text":"oba nti, ‘Mumpeereyo ekintu ku by’obugagga bwammwe,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"okumponya nve mu mukono gw’omulabe,","poem":1},{"text":"n’okumpeerayo ekintu mpone emitego gy’abakambwe’?","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Njigiriza nange n’aba musirise;","poem":1},{"text":"ndaga we nsobezza.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ebigambo eby’amazima nga bya bulumi!","poem":1},{"text":"Naye okuwakana kwammwe kukakasa ki?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mugezaako okugolola ebigambo byange,","poem":1},{"text":"ne mufuula ebigambo by’omuntu ali obubi okuba ng’empewo?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mukubira ne bamulekwa akalulu","poem":1},{"text":"ate ne mukubira ne mukwano gwammwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Naye kaakano mubeere ba kisa muntunuulire.","poem":1},{"text":"Ndabika ng’omulimba?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Mufumiitirize, temusuula bwenkanya;","poem":1},{"text":"Mukirowoozeeko, kubanga obujulirwa bwange buli ku kalebwerebwe.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Emimwa gyange girabika ng’egirimba?","poem":1},{"text":"Emimwa gyange tegisobola kutegeera ttima?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}