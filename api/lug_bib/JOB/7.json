{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"“Ebiseera by’omuntu ku nsi, tebyagerebwa?","poem":1},{"text":"Ennaku ze tezaagerebwa nga ez’omupakasi?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ng’omuddu eyeegomba ekisiikirize okujja,","poem":1},{"text":"ng’omupakasi bwe yeesunga empeera ye;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"bwe ntyo bwe nnaweebwa emyezi egy’okubonaabona,","poem":1},{"text":"ebiro ebyokutegana bwe byangererwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bwe ngalamira neebake, njogera nti, ‘Ndiyimuka ddi, ekiro kinaakoma ddi?’","poem":1},{"text":"Nga nzijudde okukulungutana okutuusa obudde lwe bukya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Omubiri gwange gujjudde envunyu n’ebikakampa,","poem":1},{"text":"n’olususu lwange lukutusekutuse era lulabika bubi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Ennaku zange zidduka okusinga ekyuma ky’omulusi w’engoye bw’atambuza ky’alusisa engoye ze;","poem":1},{"text":"era zikoma awatali ssuubi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ojjukira Ayi Katonda, nti obulamu bwange tebuliimu, wabula mukka bukka,","poem":1},{"text":"amaaso gange tegaliddayo kulaba bulungi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Eriiso ly’oyo eryali lindabyeko teririddayo kundaba;","poem":1},{"text":"amaaso gammwe galinnoonya, naye nga sikyaliwo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nga ekire bwe kibulawo ne kigenda,","poem":1},{"text":"bw’atyo n’aziikwa mu ntaana talivaayo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Taliddayo mu nnyumba ye,","poem":1},{"text":"amaka ge tegaliddayo kumumanya nate.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Noolwekyo sijja kuziyiza kamwa kange, nzija kwogera okulumwa kw’omutima gwange;","poem":1},{"text":"nzija kwemulugunyiza mu bulumi bw’emmeeme yange.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndi nnyanja oba ndi lukwata ow’omu buziba,","poem":1},{"text":"olyoke onkuume?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bwe ndowooza nti, obuliri bwange bunampa ku mirembe,","poem":1},{"text":"ekiriri kyange kinakendeeza ku kulumwa kwange;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"n’olyoka ontiisa n’ebirooto","poem":1},{"text":"era n’onkanga okuyita mu kwolesebwa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Emmeeme yange ne yeegomba okwetuga,","poem":1},{"text":"nfe okusinga okuba omulamu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Sikyeyagala, neetamiddwa. Sijja kubeera mulamu emirembe gyonna.","poem":1},{"text":"Ndeka; kubanga ennaku zange butaliimu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Omuntu kye ki ggwe okumugulumiza,","poem":1},{"text":"n’omulowoozaako?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bw’otyo n’omwekebejja buli makya,","poem":1},{"text":"n’omugezesa buli kaseera?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Olituusa ddi nga tonvuddeeko","poem":1},{"text":"n’ondeka ne mmira ku malusu?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nyonoonye;","poem":1},{"text":"kiki kye nakukola, ggwe omukuumi w’abantu?","poem":2},{"text":"Lwaki onfudde nga akabonero ak’obulabe gy’oli,","poem":1},{"text":"ne neefuukira omugugu?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Era lwaki tosonyiwa kwonoona kwange,","poem":1},{"text":"n’oggyawo obutali butuukirivu bwange?","poem":2},{"text":"Kubanga kaakano nzija kwebaka mu ntaana;","poem":1},{"text":"era ojja kunnoonya ku makya naye naaba sikyaliwo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}