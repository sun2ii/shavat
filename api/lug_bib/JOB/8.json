{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":8,"content":[{"type":"heading","content":["Birudaadi Ayogera"]},{"type":"verse","number":1,"content":["Awo Birudaadi Omusukusi n’addamu n’agamba nti,"]},{"type":"verse","number":2,"content":[{"text":"“Onookoma ddi okwogera ebintu bino?","poem":1},{"text":"Era ebigambo bino by’oyogera n’akamwa ko binaakoma ddi okuba ng’empewo ey’amaanyi?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Katonda akyusakyusa mu nsala ye?","poem":1},{"text":"Oba oyo Ayinzabyonna akyusakyusa amazima?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abaana bo bwe baayonoona eri Mukama,","poem":1},{"text":"n’abawaayo eri empeera y’ekibi kyabwe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kyokka bw’onoonoonya Katonda,","poem":1},{"text":"ne weegayirira oyo Ayinzabyonna,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"bw’onooba omulongoofu era ow’amazima,","poem":1},{"text":"ddala ddala anaakuddiramu","poem":2},{"lineBreak":true},{"text":"n’akuzzaayo mu kifo kyo ekituufu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wadde ng’entandikwa yo yali ntono,","poem":1},{"text":"embeera yo ey’enkomerero ejja kuba nnungi ddala.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Buuza ku mirembe egy’edda,","poem":1},{"text":"era onoonyereze ku bakitaabwe bye baayiga;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"kubanga ffe twazaalibwa jjuuzi era tetulina kye tumanyi,","poem":1},{"text":"era ne nnaku ze twakamala ku nsi ziri ng’ekisiikirize.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tebaakulage bakumanyise era bakutegeeze ebigambo bye mitima gyabwe","poem":1},{"text":"oba by’okutegeera kwabwe?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ebitoogo biyinza okumera","poem":1},{"text":"awatali bitosi?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Biba bikyakula nga tebinnasalibwa,","poem":1},{"text":"bikala mangu okusinga omuddo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bw’etyo enkomerero bw’ebeera ey’abo bonna abeerabira Katonda,","poem":1},{"text":"essuubi ly’abatatya Katonda bwe libula.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ebyo bye yeesiga byatika mangu,","poem":1},{"text":"ebyo bye yeesiga, nnyumba ya nnabbubi!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yeesigama wuzi za nnabbubi ne zikutuka","poem":1},{"text":"azeekwatako nnyo naye ne zitanywera.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ali ng’ekimera ekifukirire obulungi ekiri mu musana,","poem":1},{"text":"nga kyanjadde amatabi gaakyo mu nnimiro;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"emirandira gyakyo nga gyezingiridde, okwetooloola entuumu y’amayinja,","poem":1},{"text":"nga ginoonya ekifo mu mayinja.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Naye bwe bakiggya mu kifo kyakyo,","poem":1},{"text":"ekifo ekyo kikyegaana ne kigamba nti, Sikulabangako.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mazima ddala essanyu lyakyo liggwaawo,","poem":1},{"text":"ebirime ebirala ne bikula okuva mu ttaka.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mazima ddala Katonda talekerera muntu ataliiko musango,","poem":1},{"text":"era tanyweza mukono gw’abakola ebibi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ajja kuddamu ajjuze akamwa ko enseko,","poem":1},{"text":"n’emimwa gyo amaloboozi ag’essanyu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Abalabe bo balijjula obuswavu,","poem":1},{"text":"era n’ennyumba z’abakozi b’ebibi zirimalibwawo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}