{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOB","translationId":"lug_bib","name":"Yobu","commonName":"Yobu","title":"Ekitabo Ekiyitibwa Yobu","order":18,"numberOfChapters":42,"sha256":"12b1616c6c788ac5f82f8a48641f9cc35759b85d654a99e9b4b0c0782951fa30","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/lug_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":9,"content":[{"type":"heading","content":["Yobu Ayanukula"]},{"type":"verse","number":1,"content":["Yobu n’alyoka addamu nti,"]},{"type":"verse","number":2,"content":[{"text":"“Ddala nkimanyi nga kino kituufu.","poem":1},{"text":"Naye omuntu asobola atya okuba omutuukirivu eri Katonda?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wadde ng’omuntu yandyagadde okuwakana naye,","poem":1},{"text":"tayinza kumuddamu kibuuzo na kimu ku bibuuzo olukumi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amagezi ge ga nsusso, amaanyi ge mangi nnyo;","poem":1},{"text":"ani eyali amuwakanyizza n’avaayo nga taliiko binuubule?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Asimbula ensozi ne zivaayo nga tezimanyiridde","poem":1},{"text":"era n’azivuunika ng’asunguwadde.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ensi aginyeenya n’eva mu kifo kyayo","poem":1},{"text":"era n’akankanya empagi zaayo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ayogera eri enjuba ne teyaka,","poem":1},{"text":"akugira n’alemesa ekitangaala ky’emmunyeenye okulabika.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ye yekka abamba eggulu","poem":1},{"text":"era n’atambulira ku mayengo g’ennyanja.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ye mukozi wa Nabaliyo, entungalugoye ne Kakaaga,","poem":1},{"text":"n’ebibinja eby’emunyeenye eby’obukiikaddyo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Akola ebyewuunyo ebizibu okunnyonnyola,","poem":1},{"text":"n’akola n’ebyamagero ebitabalika.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bw’ayita we ndi sisobola kumulaba,","poem":1},{"text":"bw’ampitako, sisobola kumutegeera.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bw’aba alina ky’aggya ku muntu, ani ayinza okumuziyiza?","poem":1},{"text":"Ani ayinza okumubuuza nti kiki ky’okola?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Katonda taziyiza busungu bwe;","poem":1},{"text":"n’ebibinja bya Lakabu byakankanira wansi w’ebigere bye.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kaakano nnyinza ntya okuwakana naye?","poem":1},{"text":"Nnyinza ntya okufuna ebigambo mpakane naye?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wadde nga siriiko musango, sisobola kubaako kye muddamu,","poem":1},{"text":"mba nnyinza kwegayirira bwegayirizi oyo Omulamuzi wange ankwatirwe ekisa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ne bwe na ndimukoowodde n’ampitaba,","poem":1},{"text":"sirowooza nti yandimpadde ekiseera n’ampuliriza.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yandimenyeemenye mu muyaga","poem":1},{"text":"nannyongerako ebiwundu awatali nsonga.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Teyandindese kuddamu mukka","poem":1},{"text":"naye yandimmaliddewo ddala nga mbonaabona.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bwe kiba nga kigambo kya maanyi bwanyi, ye wa maanyi.","poem":1},{"text":"Era bwe kiba kya kusala musango, ani alimuyita?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ne bwe sandibaddeko musango, akamwa kange kandigunsalidde.","poem":1},{"text":"Ne bwe bandinnangiridde nti siriiko kyakunenyezebwa, kandirangiridde nti gunsinze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Wadde nga sirina kyakunenyezebwa,","poem":1},{"text":"sikyefaako,","poem":2},{"lineBreak":true},{"text":"obulamu bwange mbunyooma.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Byonna kye kimu, kyenva ŋŋamba nti,","poem":1},{"text":"Azikiriza bonna abataliiko musango awamu n’abakozi b’ebibi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kawumpuli bw’aba asse mbagirawo,","poem":1},{"text":"Mukama asekerera okubonaabona kw’abatalina musango.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ensi yaweebwayo mu mukono gw’abakozi b’ebibi.","poem":1},{"text":"Abikka ku maaso g’abagiramula.","poem":2},{"lineBreak":true},{"text":"Bw’aba nga si Mukama, kale ani?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kaakano ennaku zange zidduka okusinga omuddusi,","poem":1},{"text":"zifuumuuka, tezirina kalungi ke ziraba.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Zifuumuuka ng’amaato ag’ebitoogo","poem":1},{"noteId":5},{"text":"agadduka ennyo,","poem":1},{"text":"ng’empungu eyanguyiriza okugenda eri omuyiggo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bwe ŋŋamba nti, Leka neerabire okusinda kwange,","poem":1},{"text":"oba nti neerabire obunyiikaavu bwange, nsekemu,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ne neekokkola okubonaabona kwange,","poem":1},{"text":"mmanyi nga Mukama tombale ng’ataliiko musango.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Omusango gunsinze,","poem":1},{"text":"lwaki nteganira obwereere?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ne bwe nandinaabye sabbuuni","poem":1},{"text":"n’engalo zange ne nzitukuza,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"era wandinsudde mu kinnya,","poem":1},{"text":"n’engoye zange zennyini ne zinneetamwa.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Kubanga Mukama si muntu nga nze bwe ndi nti muddemu,","poem":1},{"text":"era nti tusisinkane tuwozaŋŋanye mu mbuga z’amateeka.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Tewali mutabaganya","poem":1},{"text":"ayinza kututeekako mukono gwe ffembi,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"eyandizigyeko omuggo gwa Katonda","poem":1},{"text":"entiisa ye n’erekeraawo okunzijira.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Olwo nno nandyogedde nga simutya;","poem":1},{"text":"naye nga bwe kiri kaakano, sisobola.”","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Amaato ag’ebitoogo gaakolebwanga mu Misiri","reference":{"chapter":9,"verse":26}}]},"thisChapterLink":"/api/lug_bib/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}