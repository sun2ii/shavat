{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOL","translationId":"lug_bib","name":"Yoweeri","commonName":"Yoweeri","title":"Ekitabo Ekiyitibwa Yoweeri","order":29,"numberOfChapters":3,"sha256":"88c8b74707ab2f4afe59080a538d6fd532f4e459756dafb53887a6318fc3f82d","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/lug_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Buno bwe bubaka bwa Mukama obwajjira Yoweeri mutabani wa Pesweri."]},{"type":"verse","number":2,"content":[{"text":"Muwulirize mmwe abakadde ba Isirayiri,","poem":1},{"text":"buli ali mu nsi naye awulirize.","poem":2},{"text":"Kino kyali kibaddewo mu biseera byammwe,","poem":1},{"text":"oba mu biseera bya bakitammwe?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mukibuulire abaana bammwe,","poem":1},{"text":"nabo balikibuulira abaana baabwe,","poem":2},{"lineBreak":true},{"text":"nabo balikibuulira ab’emirembe egiriddawo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ebibinja by’enzige ebisooka bye zitalidde,","poem":1},{"text":"enzige eziddirira zibirumbye,","poem":2},{"text":"ate ezo bye zireseewo,","poem":1},{"text":"enzige ento bye ziridde,","poem":2},{"text":"ate zino bye zireseewo,","poem":1},{"text":"enzige endala ne zibizikiririza ddala byonna!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Muzuukuke, mmwe abatamiivu, mwekaabire amaziga;","poem":1},{"text":"mukube ebiwoobe mmwe mwenna abanywi b’omwenge,","poem":2},{"text":"mukube ebiwoobe kubanga akamwa kammwe","poem":1},{"text":"katuuse okwerabira omwenge omusu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eggwanga lirumbye ensi yange,","poem":1},{"text":"ery’amaanyi ennyo era ery’abantu abatabalika.","poem":2},{"text":"Amannyo gaalyo gali ng’ag’empologoma,","poem":1},{"text":"n’amasongezo gaalyo ng’ag’empologoma enkazi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Eggwanga eryo lizikirizza emizabbibu gyange,","poem":1},{"text":"ne limalawo emitiini gyange.","poem":2},{"text":"Lisusumbudde ebikuta byagyo,","poem":1},{"text":"byonna biri ku ttaka,","poem":2},{"lineBreak":true},{"text":"amatabi gaagyo gasigadde gatukuuliridde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mukungubage nga nnamwandu omuto afiiriddwa bba,","poem":1},{"text":"ng’ayambadde ebibukutu olw’ennaku.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ebiweebwayo eby’emmere ey’empeke n’ebiweebwayo eby’okunywa","poem":1},{"text":"tewakyali kirabikako mu nnyumba ya Mukama.","poem":2},{"text":"Bakabona abaweerereza mu maaso ga Katonda","poem":1},{"text":"bakungubaga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ennimiro ziweddemu ebirime;","poem":1},{"text":"ettaka likaze,","poem":2},{"text":"Emmere ey’empeke eweddewo,","poem":1},{"text":"omwenge omusu n’amafuta g’emizeeyituuni ne bibulira ddala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mmwe abalimi mukwatibwe entiisa,","poem":1},{"text":"mmwe abalima emizabbibu mukaabe.","poem":2},{"text":"Mukaabire eŋŋaano ne sayiri,","poem":1},{"text":"kubanga ebyandikunguddwa byonna biweddewo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Omuzabbibu gukaze","poem":1},{"text":"n’omutiini guyongobedde.","poem":2},{"text":"Omukomamawanga, n’olukindu ne apo","poem":1},{"text":"n’emiti gyonna egy’omu nnimiro giwotose.","poem":2},{"text":"Abantu tebakyalina ssanyu.","poem":1}]},{"type":"heading","content":["Abantu Bayitibwa Okwenenya"]},{"type":"verse","number":13,"content":[{"text":"Mmwe bakabona, mwesibe mwambale ebibukutu mukungubage.","poem":1},{"text":"Mmwe abaweereza ba Katonda wange ab’oku kyoto,","poem":2},{"text":"mweyale wansi awali ekyoto,","poem":1},{"text":"musule awo ekiro kyonna nga mukuba ebiwoobe,","poem":2},{"text":"kubanga mu nnyumba ya Katonda wammwe temukyali kiweebwayo kyonna,","poem":1},{"text":"eky’emmere ey’empeke oba eky’envinnyo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mulangirire okusiiba okutukuvu","poem":1},{"text":"n’okukuŋŋaana mu maaso ga Katonda.","poem":2},{"text":"Muyite abakulu abakulembeze","poem":1},{"text":"n’abantu bonna ababeera mu nsi,","poem":2},{"text":"bajje mu nnyumba ya Mukama Katonda waabwe","poem":1},{"text":"bamukaabirire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Zitusanze olw’olunaku luli!","poem":1},{"text":"Kubanga olunaku lwa Mukama olw’entiisa lusembedde.","poem":2},{"text":"Lulijja, ng’okuzikiriza","poem":1},{"text":"okuva eri Ayinzabyonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Emmere tetuweddeeko","poem":1},{"text":"nga tulaba?","poem":2},{"text":"Essanyu n’okujaguza","poem":1},{"text":"mu nnyumba ya Katonda waffe tebikomye?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ensigo ziwotokedde","poem":1},{"text":"mu ttaka,","poem":2},{"text":"amawanika makalu","poem":1},{"text":"n’ebyagi by’emmere bikaze,","poem":2},{"lineBreak":true},{"text":"kubanga emmere ey’empeke eweddewo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ensolo nga zisinda!","poem":1},{"text":"Amagana gabuliddwa amagezi;","poem":2},{"text":"kubanga tewali muddo,","poem":1},{"text":"n’endiga nazo zidooba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ayi Mukama, Ggwe gwe nkaabirira,","poem":1},{"text":"kubanga omuddo gwonna gumaliddwawo empiira,","poem":2},{"text":"n’emiti gyonna egy’omu nnimiro","poem":1},{"text":"nagyo giyidde.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ensolo ez’omu nsiko nazo zikukaabira okuziyamba,","poem":1},{"text":"emigga gikalidde,","poem":2},{"lineBreak":true},{"text":"ne gye ziriira, omuddo gwonna guyidde.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}