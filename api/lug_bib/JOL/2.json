{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOL","translationId":"lug_bib","name":"Yoweeri","commonName":"Yoweeri","title":"Ekitabo Ekiyitibwa Yoweeri","order":29,"numberOfChapters":3,"sha256":"88c8b74707ab2f4afe59080a538d6fd532f4e459756dafb53887a6318fc3f82d","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/lug_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["Okulabula ku Lunaku lwa Mukama Olujja"]},{"type":"verse","number":1,"content":[{"text":"Bakabona mufuuyire ekkondeere mu Sayuuni.","poem":1},{"text":"N’akagombe ak’okulabula kavugire ku lusozi lwange olutukuvu.","poem":2},{"lineBreak":true},{"text":"Buli muntu yenna mu ggwanga akankane olw’entiisa,","poem":1},{"text":"kubanga olunaku lwa Mukama lusembedde,","poem":2},{"text":"era lunaatera okutuuka.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Luliba olunaku olutaliiko ssanyu, olw’ekizikiza;","poem":2},{"lineBreak":true},{"text":"olunaku olw’ebire ebingi n’ekizikiza ekikutte.","poem":2},{"text":"Eggye ery’enzige ery’amaanyi ennyo,","poem":1},{"text":"ng’ery’abantu abalwanyi ab’ekitalo, libuutikidde ensozi.","poem":2},{"text":"Tewabangawo ggye lirifaanana mu biro byonna eby’edda,","poem":1},{"text":"era teribaayo liryenkana mu mirembe gyonna egiriddawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Enzige ezikulembedde zirya ng’omuliro ogwokya buli wantu,","poem":1},{"text":"n’ezizivaako emabega nazo zibizikiririze ddala ng’ennimi z’omuliro.","poem":2},{"text":"Mu maaso gye ziraga ensi erabika bulungi ng’ennimiro ya Adeni,","poem":1},{"text":"naye gye ziva buli kimu zikiridde;","poem":2},{"lineBreak":true},{"text":"ensi yonna zigirese nga ddungu jjereere.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zifaanana ng’embalaasi,","poem":1},{"text":"era zidduka ng’embalaasi ez’entalo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zigenda zibuuka ku nsozi","poem":1},{"text":"nga zikekera ng’amagaali agasikibwa embalaasi bwe gakekera;","poem":2},{"text":"ne ziwuuma nga bwe zitulikatulika ng’omuliro ogwokya ebisubi ebikalu; era nga","poem":1},{"text":"ziri ng’eggye eddene mu lutalo eryetegekedde okulumba omulabe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Abantu abazirabyeko nga zisembera bali mu bulumi bungi,","poem":1},{"text":"era bonna beeraliikirivu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Zirumba n’amaanyi ng’eggye ery’abalwanyi,","poem":1},{"text":"ne ziwalampa ebisenge ng’abajaasi.","poem":2},{"text":"Zikumbira mu nnyiriri zaazo nga zitereera bulungi","poem":1},{"text":"awatali kuwaba n’akamu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tezirinnyaganako,","poem":1},{"text":"buli emu ekumbira mu kkubo lyayo.","poem":2},{"text":"Ziwaguza mu buli kyakulwanyisa kyonna,","poem":1},{"text":"ne watabaawo kisobola kuziziyiza.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Zifubutuka ne zigwira ekibuga.","poem":1},{"text":"Zikiwalampa ne zibuna bbugwe waakyo.","poem":2},{"text":"Zirinnya amayumba","poem":1},{"text":"ne ziyingirira mu madirisa ng’ababbi bwe bakola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Zikankanya ensi","poem":1},{"text":"era n’eggulu ne lijugumira.","poem":2},{"text":"Zibuutikira enjuba n’omwezi,","poem":1},{"text":"era n’emmunyeenye tezikyayaka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mukama akulembera eggye lye","poem":1},{"text":"n’eddoboozi eribwatuuka.","poem":2},{"text":"Eggye lya Mukama ddene nnyo era lya maanyi.","poem":1},{"text":"Abalirimu abatuukiriza ebiragiro bye ba maanyi.","poem":2},{"text":"Kubanga olunaku lwa Mukama lukulu","poem":1},{"text":"era lwa ntiisa nnyo.","poem":2},{"lineBreak":true},{"text":"Ani ayinza okulugumira?","poem":2}]},{"type":"heading","content":["Abantu Bayitibwa Okwenenya"]},{"type":"verse","number":12,"content":[{"text":"Mukama kyava agamba nti,","poem":1},{"text":"“Mukomeewo gye ndi n’omutima gwammwe gwonna.","poem":2},{"lineBreak":true},{"text":"Mukomeewo n’okusiiba n’okukaaba awamu n’okukungubaga.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Muyuze emitima gyammwe","poem":1},{"text":"so si byambalo byammwe.","poem":2},{"text":"Mudde eri Mukama Katonda wammwe,","poem":1},{"text":"kubanga ajjudde ekisa n’okusaasira,","poem":2},{"text":"era tasunguwala mangu; ajjudde okwagala okutaggwaawo;","poem":1},{"text":"n’abandisaanidde okubonerezebwa abasonyiwa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ani amanyi obanga anaakyuka n’abasonyiwa,","poem":1},{"text":"n’abawa omukisa gwe","poem":2},{"text":"ne musobola n’okuwaayo eri Mukama Katonda wammwe","poem":1},{"text":"ekiweebwayo eky’emmere enkalu, n’ekiweebwayo eky’ekyokunywa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mufuuyire ekkondeere mu Sayuuni,","poem":1},{"text":"mulangirire okusiiba okutukuvu.","poem":2},{"lineBreak":true},{"text":"Muyite olukuŋŋaana olussaamu Katonda ekitiibwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mukuŋŋaanye abantu bonna.","poem":1},{"text":"Mutukuze ekibiina ekyo ekikuŋŋaanye.","poem":2},{"text":"Muyite abakulu abakulembeze.","poem":1},{"text":"Muleete abaana abato","poem":2},{"lineBreak":true},{"text":"n’abo abakyali ku mabeere.","poem":2},{"text":"N’oyo eyakawasa aveeyo mu kisenge kye,","poem":1},{"text":"n’eyakafumbirwa naye aveeyo gy’ali.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bakabona abaweereza ba Mukama","poem":1},{"text":"bayimirire wakati w’ekisasi kya yeekaalu n’ekyoto,","poem":2},{"text":"bakaabirire Mukama nga bamusaba nti, “Saasira abantu bo, Ayi Mukama;","poem":1},{"text":"abantu b’obusika bwo tobaleka kugwa mu mikono gya bannamawanga okubafuga","poem":2},{"lineBreak":true},{"text":"era n’okubasekerera.","poem":2},{"text":"Bannamawanga baleme kuduula nga boogera nti,","poem":1},{"text":"‘Katonda waabwe ali ludda wa?’ ”","poem":2}]},{"type":"heading","content":["Mukama Asaasira Abantu Be"]},{"type":"verse","number":18,"content":[{"text":"Awo Mukama n’akwatirwa ensi ye ekisa,","poem":1},{"text":"n’asaasira abantu be.","poem":2}]},{"type":"verse","number":19,"content":["N’ayanukula abantu be nti,",{"text":"“Muwulirize, nzija kubaweereza emmere enkalu, n’envinnyo, n’amafuta,","poem":1},{"text":"ebimala okubakkusiza ddala,","poem":2},{"text":"era siriddayo kubaleka, ne mufuuka ekivume,","poem":1},{"text":"bannaggwanga amalala ne babasekerera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Ndibagobako eggye ery’omu bukiikakkono","poem":1},{"text":"ne ndigobera mu ddungu ery’ewala ennyo.","poem":2},{"text":"Ekibinja ekikulembeddemu ndikigobera mu nnyanja ey’Ebuvanjuba,","poem":1},{"text":"n’ekibinja eky’emabega ndikigobera mu nnyanja ey’Ebugwanjuba.","poem":2},{"text":"Ekivundu n’okuwunya birituuka wala","poem":1},{"text":"okusinga ebyo byonna bye libakoze.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mwe abali mu nsi, temutya.","poem":1},{"text":"Musanyuke era mujaguze;","poem":2},{"text":"kubanga Mukama abakoledde ebikulu.","poem":1}]},{"type":"verse","number":22,"content":[{"text":"Nammwe ensolo ez’omu nsiko temutya;","poem":2},{"lineBreak":true},{"text":"kubanga omuddo gwonna mu nsiko gusibukidde.","poem":2},{"text":"Emiti gibaze ebibala byagyo,","poem":1},{"text":"era emitiini n’emizabbibu nagyo gibaze ebibala bingi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Musanyuke mmwe abaana ba Sayuuni;","poem":1},{"text":"mujagulize Mukama Katonda wammwe.","poem":2},{"text":"Kubanga abawadde","poem":1},{"text":"enkuba esooka mu butuukirivu.","poem":2},{"text":"Era abawadde enkuba nnyingi esooka n’esembayo","poem":1},{"text":"mu mwaka ng’obw’edda.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Amawuuliro gammwe galijjula eŋŋaano,","poem":1},{"text":"n’amasogolero gammwe galijjula envinnyo n’amafuta n’okubooga ne gabooga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Ndibaddizaawo byonna enzige bye zaalya mu myaka egyo.","poem":1},{"text":"Lyali ggye lyange ery’amaanyi lye nabasindikira nga lirimu lusejjera,","poem":2},{"lineBreak":true},{"text":"n’enzige ezisala obusazi,","poem":2},{"lineBreak":true},{"text":"awamu n’ezo ezizikiririza ddala.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kale, munaabanga n’ebyokulya bingi nga bwe muneetaaganga.","poem":1},{"text":"Munaatenderezanga erinnya lya Mukama Katonda wammwe","poem":2},{"lineBreak":true},{"text":"abakoledde ebintu ebirungi bwe bityo.","poem":2},{"text":"Era abantu bange tebakyaddayo kuswazibwa.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mulimanya nga ndi wakati mu Isirayiri,","poem":1},{"text":"era nga Nze, Mukama, Nze Katonda wammwe,","poem":2},{"lineBreak":true},{"text":"so tewali mulala;","poem":2},{"text":"n’abantu bange tebakyaddayo kuswazibwa.","poem":1}]},{"type":"heading","content":["Mukama Afuka Omwoyo We ku Bantu Be"]},{"type":"verse","number":28,"content":[{"text":"“Awo olulituuka oluvannyuma lw’ebyo,","poem":1},{"text":"ndifuka Omwoyo wange ku bantu bonna.","poem":2},{"text":"Batabani bammwe ne bawala bammwe balitegeeza eby’omu maaso;","poem":1},{"text":"abakadde baliroota ebirooto,","poem":2},{"lineBreak":true},{"text":"n’abavubuka bammwe balyolesebwa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Mu biro ebyo","poem":1},{"text":"ndifuka Omwoyo wange ku baweereza bange abasajja n’abakazi.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Era ndyolesa ebyamagero mu ggulu","poem":1},{"text":"ne ku nsi:","poem":2},{"lineBreak":true},{"text":"omusaayi n’omuliro n’ekikoomi eky’omukka.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Enjuba erifuuka ekizikiza,","poem":1},{"text":"n’omwezi gulimyuka ng’omusaayi,","poem":2},{"lineBreak":true},{"text":"olunaku lwa Mukama olukulu era olw’entiisa nga terunnatuuka.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Awo olulituuka buli alikoowoola","poem":1},{"text":"erinnya lya Mukama okusaasirwa alirokoka.","poem":2},{"text":"Kubanga mu lusozi Sayuuni ne mu Yerusaalemi","poem":1},{"text":"walibaawo abaliwona","poem":2},{"lineBreak":true},{"text":"nga Mukama bw’ayogedde,","poem":2},{"text":"ne mu abo abalifikkawo","poem":1},{"text":"mulibaamu abo Mukama b’aliyita.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}