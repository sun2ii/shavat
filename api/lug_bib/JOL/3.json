{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JOL","translationId":"lug_bib","name":"Yoweeri","commonName":"Yoweeri","title":"Ekitabo Ekiyitibwa Yoweeri","order":29,"numberOfChapters":3,"sha256":"88c8b74707ab2f4afe59080a538d6fd532f4e459756dafb53887a6318fc3f82d","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/lug_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["Abalabe ba Isirayiri Basalirwa Omusango"]},{"type":"verse","number":1,"content":[{"text":"“Mu nnaku ezo, era mu biseera ebyo,","poem":1},{"text":"Yuda n’ekibuga Yerusaalemi ndibiddiza emikisa gyabyo nga bwe gyabanga edda.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndikuŋŋaanya abamawanga bonna","poem":1},{"text":"ne mbaserengesa mu kiwonvu Yekosafaati,","poem":2},{"text":"ne mbasalira omusango","poem":1},{"text":"olwa byonna bye baakola abantu bange Abayisirayiri ab’obusika bwange.","poem":2},{"text":"Kubanga baasaasaanya Abayisirayiri mu mawanga,","poem":1},{"text":"ne bagabana ensi yange.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Baagabana abantu bange nga babakubirako obululu;","poem":1},{"text":"ne batunda abalenzi olw’abakazi bamalaaya,","poem":2},{"text":"n’abawala ne babatundamu omwenge","poem":1},{"text":"ne beenywera.","poem":2}]},{"type":"verse","number":4,"content":["“Mwe Ttuulo ne Sidoni n’enjuyi zonna ez’Abafirisuuti, mmwe b’ani ku Nze? Nnina kye nabakola kye mugezaako okwesasuza? Bwe munaaba nga mugezaako kwesasuza, ebikolwa byammwe nzija kubibakyusizaako mangwago."]},{"type":"verse","number":5,"content":["Kubanga mwatwala effeeza yange ne zaabu yange n’ebintu byange eby’omuwendo omungi ne mubissa mu masabo gammwe."]},{"type":"verse","number":6,"content":["Mwatwala abantu b’omu Yuda ne mu Yerusaalemi ne mubatunza Abayonaani."]},{"type":"verse","number":7,"content":["“Laba, ndibaggyayo mu mawanga gye mwabatunda; mmwe mbakole nga bwe mwabakola."]},{"type":"verse","number":8,"content":["Batabani bammwe ne bawala bammwe ndibaguza batabani ba Yuda, nabo balibaguza abantu ab’omu ggwanga ery’ewala ennyo, ery’e Seba.” Ebyo Mukama y’abyogedde."]},{"type":"heading","content":["Bakabona Balangirira Omusango eri Abaamawanga"]},{"type":"verse","number":9,"content":[{"text":"Bakabona mulangirire mu mawanga bwe muti nti,","poem":1},{"text":"Mwetegekere olutalo!","poem":2},{"text":"Muyite abalwanyi bammwe ab’amaanyi,","poem":1},{"text":"buli mulwanyi yenna asembere ajje mu lutalo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Enkumbi zammwe muziweeseemu ebitala,","poem":1},{"text":"n’obwambe bwammwe mubuweeseemu amafumu;","poem":2},{"text":"omunafu agambe nti,","poem":1},{"text":"“Ndi wa maanyi.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mujje mangu mwe mwenna abamawanga agatwetoolodde,","poem":1},{"text":"mukuŋŋaanire mu kiwonvu.","poem":2},{"text":"Ayi Mukama, weereza eggye lyo libalumbe.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"“Amawanga geeteeketeeke","poem":1},{"text":"gajje mu kiwonvu ekya Yekosafaati;","poem":2},{"text":"kubanga eyo gye ndisinzira","poem":1},{"text":"ne nsalira amawanga gonna ageetoolodde wano omusango.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kozesa oluwabyo lwo,","poem":1},{"text":"kubanga ekiseera eky’amakungula kituuse.","poem":2},{"text":"Mujje mubabetente nga bwe mulinnyirira emizabbibu mu ssogolero","poem":1},{"text":"okutuusa envinnyo lw’ekulukuta,","poem":2},{"lineBreak":true},{"text":"ekibi kyabwe kinene nnyo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Abantu bukadde na bukadde","poem":1},{"text":"abali mu kiwonvu eky’okusalirwamu omusango!","poem":2},{"text":"Kubanga olunaku lwa Mukama lusembedde","poem":1},{"text":"lwaliramulirako mu kiwonvu eky’okusalirwamu omusango.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ekizikiza kibuutikidde enjuba n’omwezi,","poem":1},{"text":"n’emmunyeenye tezikyayaka.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mukama aliwuluguma ng’ayima ku Sayuuni;","poem":1},{"text":"alibwatuka n’eddoboozi lye ng’asinziira mu Yerusaalemi.","poem":2},{"lineBreak":true},{"text":"Eggulu n’ensi birikankana.","poem":2},{"text":"Naye Mukama aliba ekiddukiro ky’abantu be,","poem":1},{"text":"era ekigo ky’abaana ba Isirayiri eky’amaanyi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Kale mulimanya nga Nze Mukama Katonda wammwe,","poem":1},{"text":"abeera ku lusozi lwange olutukuvu Sayuuni.","poem":2},{"text":"Era Yerusaalemi kinaabeeranga kitukuvu,","poem":1},{"text":"nga ne bannamawanga tebakyakirumba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Olunaku luli bwe lulituuka, ensozi ziritonnyesa wayini omuggya,","poem":1},{"text":"n’obusozi bulikulukusa amata,","poem":2},{"lineBreak":true},{"text":"n’emigga gyonna egya Yuda emikalu girikulukusa amazzi.","poem":2},{"text":"Ensulo eriva mu nnyumba ya Mukama","poem":1},{"text":"n’efukirira ekiwonvu kya Sittimu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Misiri erifuuka amatongo","poem":1},{"text":"n’ensi ya Edomu erifuuka ddungu jjereere","poem":2},{"text":"olw’ebikolobero bye baakola ku bantu ba Yuda,","poem":1},{"text":"ensi mwe battira abantu abatalina musango.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Naye mu Yuda mulibeeramu abantu ennaku zonna,","poem":1},{"text":"ne Yerusaalemi kiribeerawo emirembe gyonna.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ndyesasuza olw’omusaayi ogw’abo abattibwa,","poem":1},{"text":"era teriba mutemu asonyiyibwa.","poem":2},"Kubanga Mukama abeera mu Sayuuni.”"]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}