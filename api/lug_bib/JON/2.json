{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"JON","translationId":"lug_bib","name":"Yona","commonName":"Yona","title":"Ekitabo Ekiyitibwa Yona","order":32,"numberOfChapters":4,"sha256":"da0c3ebc18e782e05a1a1736e242fda17da06afb31798d63455be85f1c745067","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/lug_bib/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Okusaba kwa Yona"]},{"type":"verse","number":1,"content":["Awo Yona n’asinziira mu kyennyanja n’asaba Mukama Katonda we, ng’agamba"]},{"type":"verse","number":2,"content":["nti,",{"text":"“Mu nnaku yange ennyingi","poem":1},{"text":"nakaabirira Mukama n’anziramu;","poem":2},{"text":"mu buziba ewala mu magombe nakukoowoola,","poem":1},{"text":"era n’owulira eddoboozi lyange!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kubanga wansuula ewala mu buziba mu nnyanja,","poem":1},{"text":"ne nzika, amayengo gonna,","poem":2},{"lineBreak":true},{"text":"ensozi n’ensozi z’amazzi ebikunta","poem":2},{"text":"ne bimbikka","poem":1},{"text":"ne binneetooloola.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne ndyoka njogera nti, ‘Ngobeddwa","poem":1},{"text":"mu maaso go;","poem":2},{"text":"Ddala ndiddayo nate","poem":1},{"text":"okulaba yeekaalu yo entukuvu?’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nakkira ddala ku ntobo wansi w’amayengo, okufa ne kumbeerera ddala kumpi;","poem":1},{"text":"Amazzi nga ganneetoolodde","poem":2},{"lineBreak":true},{"text":"era ng’omuddo gw’omu nnyanja gunneezingiridde ku mutwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne ŋŋendera ddala ku ntobo, ensozi z’omu nnyanja gye zisibuka, eyo,","poem":1},{"text":"ensi n’ensibirayo emirembe n’emirembe.","poem":2},{"text":"Naye ggwe Mukama Katonda wange, onzigye mu bunnya,","poem":1},{"text":"Ayi Mukama Katonda wange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Bwe nnali nga mpweddemu essuubi, emmeeme yange ng’ezirika","poem":1},{"text":"ne nkujjukira, Ayi Mukama Katonda.","poem":2},{"text":"Awo okusaba kwange entakeera ne kutuuka","poem":1},{"text":"mu yeekaalu yo entukuvu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Abo abassaayo omwoyo ku balubaale ne bakatonda abataliimu ne babasinza,","poem":1},{"text":"beefiiriza okusaasirwa kwa Katonda okubalindiridde!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Naye nze, n’oluyimba olw’okukutendereza,","poem":1},{"text":"ndikuwa ssaddaaka.","poem":2},{"text":"Ddala ndituukiriza obweyamo bwange","poem":1},{"text":"kubanga obulokozi buva eri Mukama Katonda.”","poem":2}]},{"type":"verse","number":10,"content":["Awo Mukama Katonda n’alagira ekyennyanja ne kiwandula Yona n’agwa ettale ku lukalu."]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}