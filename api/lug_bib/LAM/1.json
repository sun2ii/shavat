{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"LAM","translationId":"lug_bib","name":"Okukungubaga","commonName":"Okukungubaga","title":"Ekitabo Ekiyitibwa Okukungubaga","order":25,"numberOfChapters":5,"sha256":"c2fc22941823ec1b6865fda7ef5350700c967f0df02447282a7ad3e7668ebe33","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/lug_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"heading","content":["Yerusaalemi Kifuuse Matongo"]},{"type":"verse","number":1,"content":["Ekibuga ekyajjulanga abantu nga kyabuliddwa!",{"text":"Ekyabanga eky’amaanyi mu mawanga,","poem":1},{"text":"nga kifuuse nga nnamwandu!","poem":2},{"text":"Eyali kabaka omukazi ng’alina amasaza,","poem":1},{"text":"afuuse omuddu omukazi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ekiro akaaba nnyo nnyini,","poem":1},{"text":"n’amaziga ne gakulukuta ku matama ge.","poem":2},{"text":"Mu baganzi be bonna,","poem":1},{"text":"talina n’omu amubeesabeesa.","poem":2},{"text":"Mikwano gye bonna bamuliddemu olukwe,","poem":1},{"text":"bafuuse balabe be.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yuda agenze mu buwaŋŋanguse","poem":1},{"text":"oluvannyuma lw’okubonaabona n’okukozesebwa n’obukambwe ng’omuddu.","poem":2},{"text":"Kati abeera mu bannamawanga,","poem":1},{"text":"talaba kifo kya kuwummuliramu.","poem":2},{"text":"Bonna abamunoonya bamusanga","poem":1},{"text":"mu nnaku ye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Enguudo za Sayuuni zikungubaga,","poem":1},{"text":"kubanga tewali n’omu ajja ku mbaga zaakyo ezaalagibwa.","poem":2},{"text":"Emiryango gye gyonna girekeddwa awo,","poem":1},{"text":"bakabona be, basinda;","poem":2},{"text":"bawala be abaweereza bali mu buyinike,","poem":1},{"text":"naye yennyini ali mu nnaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Abamuyigganya bafuuse bakama be;","poem":1},{"text":"abalabe be beeyagala,","poem":2},{"text":"kubanga Mukama amuleeseeko ennaku,","poem":1},{"text":"olw’ebibi bye ebingi.","poem":2},{"text":"Abaana be batwalibbwa mu buwaŋŋanguse,","poem":1},{"text":"bawambiddwa omulabe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ekitiibwa kyonna ekyali ku muwala wa Sayuuni","poem":1},{"text":"kimuweddeko,","poem":2},{"text":"abalangira be bafuuse ng’ennangaazi","poem":1},{"text":"ezibuliddwa omuddo;","poem":2},{"text":"mu bunafu,","poem":1},{"text":"badduse ababagoba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mu nnaku ez’okubonaabona kwe ng’asagaasagana,","poem":1},{"text":"Yerusaalemi ajjukira ebintu eby’omuwendo byonna","poem":2},{"lineBreak":true},{"text":"bye yalinanga mu nnaku ez’edda.","poem":2},{"text":"Abantu be bwe baagwa mu mikono gy’omulabe,","poem":1},{"text":"tewaali n’omu amubeera;","poem":2},{"text":"abalabe be ne bamutunuulira","poem":1},{"text":"ne bamusekerera olw’okugwa kwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yerusaalemi yayonoona nnyo nnyini,","poem":1},{"text":"bw’atyo n’afuuka atali mulongoofu.","poem":2},{"text":"Bonna abaamussangamu ekitiibwa bamunyooma,","poem":1},{"text":"kubanga balabye bw’asigalidde awo;","poem":2},{"text":"ye yennyini asinda,","poem":1},{"text":"era akwatibwa ensonyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Obutali bulongoofu bwe bwali mu birenge bye;","poem":1},{"text":"teyassaayo mwoyo ku bulamu bwe obw’ebiseera ebijja.","poem":2},{"text":"Okugwa kwe kwali kwa kyewuunyo;","poem":1},{"text":"tewaali n’omu amubeesabeesa.","poem":2},{"text":"“Ayi Mukama, tunuulira okubonaabona kwange,","poem":1},{"text":"kubanga omulabe awangudde.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Omulabe yagololera omukono","poem":1},{"text":"ku bintu bya Yerusaalemi byonna eby’omuwendo;","poem":2},{"text":"yalaba amawanga amakaafiiri","poem":1},{"text":"nga gayingira awatukuvu we,","poem":2},{"text":"beebo be wali ogaanye","poem":1},{"text":"okuyingira mu kuŋŋaaniro lyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Abantu be bonna basinda","poem":1},{"text":"nga bwe banoonya ekyokulya;","poem":2},{"text":"eby’obugagga byabwe babiwanyisaamu emmere,","poem":1},{"text":"okusobola okuba abalamu.","poem":2},{"text":"“Laba, Ayi Mukama Katonda, onziseeko omwoyo","poem":1},{"text":"kubanga nnyoomebwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Mmwe tekibakwatako, mmwe mwenna abayitawo?","poem":1},{"text":"mwetegereze mulabe","poem":2},{"text":"obanga waliwo obuyinike obwenkana,","poem":1},{"text":"obwantukako,","poem":2},{"text":"Mukama bwe yanteekako","poem":1},{"text":"ku lunaku olw’obusungu bwe obungi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Yaweereza omuliro okuva waggulu,","poem":1},{"text":"ne gukka mu magumba gange.","poem":2},{"text":"Yatega ebigere byange akatimba,","poem":1},{"text":"n’anzizaayo emabega.","poem":2},{"text":"Yandeka mpuubadde,","poem":1},{"text":"nga nzirise olunaku lwonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Ebibi byange binfuukidde ekikoligo;","poem":1},{"text":"bisibiddwa ne binywezebwa omukono gwe.","poem":2},{"text":"Binzitoowerera mu bulago,","poem":1},{"text":"era bimmazeemu amaanyi.","poem":2},{"text":"Mukama ampaddeyo mu mikono gy’abo","poem":1},{"text":"be siyinza kugumiikiriza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Mukama anyoomye","poem":1},{"text":"abalwanyi abazira bonna abaali nange;","poem":2},{"text":"akuŋŋaanyizza eggye okunwanyisa,","poem":1},{"text":"okuzikiriza abavubuka bange.","poem":2},{"text":"Mukama alinnyiridde Omuwala Embeerera owa Yuda,","poem":1},{"text":"ng’omuntu bw’asambirira ezabbibu mu lyato ng’asogola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Kyenva nkaaba,","poem":1},{"text":"amaaso gange ne gajjula amaziga,","poem":2},{"text":"kubanga tewali n’omu andi kumpi okumbeesabeesa,","poem":1},{"text":"ayinza okunzizaamu amaanyi.","poem":2},{"text":"Abaana bange banakuwavu","poem":1},{"text":"kubanga omulabe awangudde.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Sayuuni agolola emikono gye,","poem":1},{"text":"naye tewali n’omu amudduukirira.","poem":2},{"text":"Mukama awadde ekiragiro ku Yakobo","poem":1},{"text":"baliraanwa be babeere balabe be;","poem":2},{"text":"Yerusaalemi afuuse","poem":1},{"text":"ekintu ekitali kirongoofu wakati mu bo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Mukama mutuukirivu,","poem":1},{"text":"newaakubadde nga najeemera ekiragiro kye.","poem":2},{"text":"Muwulirize mmwe amawanga gonna,","poem":1},{"text":"mutunuulire okubonaabona kwange;","poem":2},{"text":"Abavubuka bange ne bawala bange","poem":1},{"text":"batwalibbwa mu busibe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Nakoowoola bannange bannyambe,","poem":1},{"text":"naye tebanfaako;","poem":2},{"text":"bakabona bange n’abakadde b’ekibuga kyange","poem":1},{"text":"bazikiririra mu kibuga","poem":2},{"text":"nga banoonya ekyokulya","poem":1},{"text":"baddemu amaanyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Laba, Ayi Mukama Katonda bwe ndi omunakuwavu!","poem":1},{"text":"Ndi mu kubonaabona,","poem":2},{"text":"n’omutima gwange teguteredde","poem":1},{"text":"kubanga njeemye nnyo ekiyitiridde.","poem":2},{"text":"Ebweru ekitala kirindiridde okunsanyaawo,","poem":1},{"text":"ne mu nnyumba mulimu kufa kwereere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Abantu bawulidde okusinda kwange,","poem":1},{"text":"naye tewali n’omu ananyamba.","poem":2},{"text":"Abalabe bange bonna bawulidde okusinda kwange;","poem":1},{"text":"basanyukidde ekyo ky’okoze.","poem":2},{"text":"Olunaku lwe walangirira,","poem":1},{"text":"lubatuukeko, babeere nga nze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Obabonereze olw’obutali butuukirivu bwabwe bwonna,","poem":1},{"text":"nga nze bwe wambonereza.","poem":2},{"text":"Okusinda kwange kungi","poem":1},{"text":"n’omutima gwange guzirika.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}