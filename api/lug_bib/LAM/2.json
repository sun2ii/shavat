{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"LAM","translationId":"lug_bib","name":"Okukungubaga","commonName":"Okukungubaga","title":"Ekitabo Ekiyitibwa Okukungubaga","order":25,"numberOfChapters":5,"sha256":"c2fc22941823ec1b6865fda7ef5350700c967f0df02447282a7ad3e7668ebe33","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/lug_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Obusungu bwa Mukama nga bubuubuukidde ku Muwala wa Sayuuni","poem":1},{"text":"ne bumussa wansi w’ekire!","poem":2},{"text":"Ekitiibwa kya Isirayiri, Mukama akissizza wansi","poem":1},{"text":"okuva mu ggulu okutuuka ku nsi;","poem":2},{"text":"ne yeerabira entebe ey’ebigere bye","poem":1},{"text":"ku lunaku lwe yasunguwalirako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mukama azikirizza","poem":1},{"text":"abatuula mu Yakobo bonna awatali kubasaasira;","poem":2},{"text":"mu busungu bwe amenye","poem":1},{"text":"ebigo eby’amaanyi eby’omuwala wa Yuda;","poem":2},{"text":"assizza wansi obwakabaka bwe n’abakungu be","poem":1},{"text":"n’abamalamu ekitiibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mu busungu obungi","poem":1},{"text":"amaanyi gonna aga Isirayiri agakendeezezza;","poem":2},{"text":"bw’alabye omulabe ng’asembera,","poem":1},{"text":"n’aggyawo omukono gwe ogwa ddyo;","poem":2},{"text":"anyiigidde Yakobo okufaanana ng’omuliro","poem":1},{"text":"bwe gubumbujja ne gwokya buli ekiguliraanye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Anaanudde omutego gwe okufaanana nga ogw’omulabe,","poem":1},{"text":"era omukono gwe ogwa ddyo mweteefuteefu.","poem":2},{"text":"Azikirizza ebyo byonna ebisanyusa amaaso","poem":1},{"text":"mu weema ey’omuwala wa Sayuuni,","poem":2},{"text":"okufaanana ng’omulabe bwe yandikoze;","poem":1},{"text":"obusungu bwe bubuubuuka ng’omuliro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mukama afuuse ng’omulabe;","poem":1},{"text":"azikirizza Isirayiri,","poem":2},{"text":"n’azikiriza embiri ze,","poem":1},{"text":"n’azikiriza n’ebifo bye eby’amaanyi.","poem":2},{"text":"Aleetedde muwala wa Yuda","poem":1},{"text":"okweyongera okukaaba n’okukungubaga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Asaanyizzaawo eweema ye n’efaanana ng’ennimiro,","poem":1},{"text":"era azikirizza n’ekifo kye eky’Okukuŋŋaanirangamu.","poem":2},{"text":"Mukama yeerabizza Sayuuni","poem":1},{"text":"embaga ze entukuvu ne ssabbiiti,","poem":2},{"text":"era mu busungu bwe obungi","poem":1},{"text":"anyoomye kabaka ne kabona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mukama atamiddwa ekyoto kye,","poem":1},{"text":"n’alekulira n’ekifo kye ekitukuvu.","poem":2},{"text":"Awaddeyo bbugwe w’embiri ze eri omulabe;","poem":1},{"text":"era baleekaanidde mu nnyumba ya Mukama,","poem":2},{"text":"ne baleetamu oluyoogaano","poem":1},{"text":"nga ku lunaku olw’embaga entukuvu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mukama yamalirira okumenya","poem":1},{"text":"bbugwe eyeetoolodde muwala wa Sayuuni,","poem":2},{"text":"n’agolola omuguwa ogupima,","poem":1},{"text":"Omukono gwe ne guteewala kuzikiriza.","poem":2},{"text":"Yaleetera enkomera ne bbugwe okukungubaga,","poem":1},{"text":"byonna ne biggweerera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Emiryango gye gisse mu ttaka,","poem":1},{"text":"n’emitayimbwa gyagyo agimenye n’agyonoona.","poem":2},{"text":"Kabaka we n’abakungu be baawaŋŋangusizibwa,","poem":1},{"text":"eteri mateeka gaabwe agabafuga,","poem":2},{"text":"era ne bannabbi be tebakyafuna","poem":1},{"text":"kwolesebwa kuva eri Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Abakadde b’Omuwala wa Sayuuni","poem":1},{"text":"batuula wansi ku ttaka nga basiriikiridde;","poem":2},{"text":"bayiye enfuufu ku mitwe gyabwe","poem":1},{"text":"era beesibye ebibukutu;","poem":2},{"text":"n’abawala ba Yerusaalemi","poem":1},{"text":"bakotese emitwe gyabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Amaaso gange gakooye olw’okukaaba","poem":1},{"text":"n’emmeeme yange enyiikadde","poem":2},{"text":"n’omutima gwange gulumwa","poem":1},{"text":"olw’okuzikirizibwa kw’abantu bange,","poem":2},{"text":"n’olw’abaana abato n’abaana abawere okuzirikira","poem":1},{"text":"wakati mu nguudo ez’omu kibuga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bakaabirira bannyaabwe nga bwe boogera nti,","poem":1},{"text":"“Omugaati n’envinnyo biri ludda wa?”","poem":2},{"text":"nga bwe bazirika okufaanana ng’abaliko ebiwundu","poem":1},{"text":"mu nguudo ez’ekibuga,","poem":2},{"text":"nga bwe bakaabira","poem":1},{"text":"mu bifuba bya bannyaabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nnyinza kugamba ki,","poem":1},{"text":"era kiki kye nnyinza okukugeraageranyaako","poem":2},{"lineBreak":true},{"text":"ggwe Omuwala wa Yerusaalemi?","poem":2},{"text":"Kiki kye nnyinza okukufaananya,","poem":1},{"text":"okukusanyusa ggwe","poem":2},{"lineBreak":true},{"text":"Omuwala Embeerera owa Sayuuni?","poem":2},{"text":"Ekiwundu kyo kinene nnyo,","poem":1},{"text":"kale ani ayinza okukiwonya?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Okwolesebwa bannabbi bo kwe baafuna,","poem":1},{"text":"kwali kwa bulimba era kwa butaliimu;","poem":2},{"text":"tebaakutegeeza obutali butuukirivu bwo","poem":1},{"text":"okukuwonya obusibe.","poem":2},{"text":"Engero ze baabanyumizanga","poem":1},{"text":"zaali za bulimba era eziwabya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Bonna abayitawo","poem":1},{"text":"babakubira mu ngalo","poem":2},{"text":"ne bafuuwa empa ne banyeenyeza","poem":1},{"text":"omuwala wa Yerusaalemi emitwe gyabwe nga boogera nti,","poem":2},{"text":"“Kino kye kibuga ekyayitibwanga","poem":1},{"text":"ekituukiridde,","poem":2},{"lineBreak":true},{"text":"era essanyu ly’ensi zonna?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Abalabe bo bonna","poem":1},{"text":"baasaamiridde nga beewuunya;","poem":2},{"text":"nga bafuuwa empa, era baluma amannyo","poem":1},{"text":"nga boogera nti, “Tumuzikirizza.","poem":2},{"text":"Luno lwe lunaku lwe twalindirira,","poem":1},{"text":"kaakano lutuukiridde, era tululabye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mukama akoze kye yateekateeka,","poem":1},{"text":"era atuukirizza ekigambo kye","poem":2},{"lineBreak":true},{"text":"kye yalagira mu nnaku ez’edda.","poem":2},{"text":"Akuzikirizza awatali kukusaasira,","poem":1},{"text":"aleetedde omulabe wo okukusekerera,","poem":2},{"lineBreak":true},{"text":"n’amaanyi g’abalabe bo agagulumizza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kaabirira Mukama","poem":1},{"text":"n’eddoboozi ery’omwanguka","poem":2},{"text":"ggwe Omuwala wa Sayuuni.","poem":1},{"text":"Leka amaziga go gakulukute ng’omugga","poem":2},{"lineBreak":true},{"text":"emisana n’ekiro.","poem":2},{"text":"Teweewummuza so toganya","poem":1},{"text":"maaso go kuwummula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Golokoka, okaabe ekiro","poem":1},{"text":"obudde nga bwa kaziba;","poem":2},{"text":"Fuka emmeeme yo ng’amazzi","poem":1},{"text":"mu maaso ga Mukama.","poem":2},{"text":"Yimusa emikono gyo gy’ali,","poem":1},{"text":"olw’obulamu bw’abaana bo abato","poem":2},{"text":"abazirise olw’enjala","poem":1},{"text":"mu buli luguudo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Tunula, Ayi Mukama Katonda osaasire!","poem":1},{"text":"Ani gwe wali obonerezza bw’otyo?","poem":2},{"text":"Ddala, abakyala balye ebibala by’embuto zaabwe,","poem":1},{"text":"abaana be bakuzizza?","poem":2},{"text":"Ddala, bakabona ne bannabbi battibwe","poem":1},{"text":"mu watukuvu wa Mukama?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Abato n’abakulu bonna bafiiridde wamu","poem":1},{"text":"mu nfuufu ey’enguudo;","poem":2},{"text":"abavubuka bange ne bawala bange","poem":1},{"text":"battiddwa n’ekitala;","poem":2},{"text":"obattidde ku lunaku olw’obusungu bwo,","poem":1},{"text":"era obasse awatali kusaasira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Nga bw’oyita abantu ku lunaku olw’embaga,","poem":1},{"text":"bw’otyo bw’ompitidde ebikemo ku njuyi zonna;","poem":2},{"text":"era ku lunaku olw’obusungu bwa Mukama,","poem":1},{"text":"tewali n’omu eyasimattuka newaakubadde eyasigalawo;","poem":2},{"text":"abo be nalabirira ne nkuza,","poem":1},{"text":"omulabe wange be yazikiriza.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}