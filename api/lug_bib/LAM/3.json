{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"LAM","translationId":"lug_bib","name":"Okukungubaga","commonName":"Okukungubaga","title":"Ekitabo Ekiyitibwa Okukungubaga","order":25,"numberOfChapters":5,"sha256":"c2fc22941823ec1b6865fda7ef5350700c967f0df02447282a7ad3e7668ebe33","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/lug_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Nze muntu eyakangavvulwa","poem":1},{"text":"n’omuggo ogw’obusungu bwe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Angobye mu maaso ge n’antambuliza","poem":1},{"text":"mu kizikiza, awatali kitangaala;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ddala, omukono gwe gunnwanyisizza","poem":1},{"text":"emirundi egiddiriŋŋanwa olunaku lwonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Akaddiyizza omubiri gwange n’eddiba lyange","poem":1},{"text":"era amenye n’amagumba gange.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Antaayizza n’anzijuza","poem":1},{"text":"obulumi n’okubonaabona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Antadde mu kizikiza","poem":1},{"text":"ng’abafu abaafa edda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ankomedde n’okuyinza ne siyinza kudduka,","poem":1},{"text":"ansibye enjegere ezizitowa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne bwe mukoowoola ne mukaabira nga mmusaba anyambe,","poem":1},{"text":"okusaba kwange akuggalira bweru.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anteeredde amayinja mu kkubo lyange","poem":1},{"text":"era akyamizza amakubo gange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ng’eddubu bwe liteega,","poem":1},{"text":"n’empologoma bwe yeekweka","poem":2}]},{"type":"verse","number":11,"content":[{"text":"yansikambula n’anziggya mu kkubo lyange n’antaagulataagula","poem":1},{"text":"n’andeka awo nga sirina anyamba.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yanaanuula omutego gwe,","poem":1},{"text":"n’anteekawo okuba ssabbaawa ey’obusaale bwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yafumita omutima gwange","poem":1},{"text":"n’obusaale okuva mu mufuko gwe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nafuuka ekisekererwa eri abantu bonna,","poem":1},{"text":"era bannyooma nga bannyimbirira okuzibya obudde.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Anzijuzza ebikaawa","poem":1},{"text":"era ampadde ekikompe eky’obubalagaze nkinywe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ampadde oluyinjayinja okululya amannyo gange ne gamenyeka;","poem":1},{"text":"anninnyiridde mu nfuufu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Emmeeme yange terina mirembe,","poem":1},{"text":"n’okujjukira sijjukira bugagga bwe bufaanana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Era njogera nti, “Ekitiibwa kyange kigenze,","poem":1},{"text":"n’essuubi lyonna lye nalina mu Mukama limpeddeko.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Nzijukira okubonaabona kwange n’okuwankawanka kwange,","poem":1},{"text":"n’obulumi n’obubalagaze.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mbijjukira bulungi","poem":1},{"text":"era bwe mbirowoozaako omutima gwange gulumwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ebyo byonna mbijjukira,","poem":1},{"text":"kyenvudde mbeera n’essuubi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Olw’okwagala kwa Mukama okutaggwaawo,","poem":1},{"text":"tetulimalibwawo, kubanga ekisa kye tekiggwaawo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Buli lukya ekisa kyo kiba kiggya;","poem":1},{"text":"n’obwesigwa bwo bwa lubeerera.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Njogera mu mutima gwange nti, “Mukama gwe mugabo gwange,","poem":1},{"text":"kyenaava mbeera n’essuubi mu ye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Mukama mulungi eri abo abamulinamu essuubi,","poem":1},{"text":"eri oyo amunoonya.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kirungi omuntu okulindirira","poem":1},{"text":"obulokozi bwa Mukama n’obukkakkamu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kirungi omuntu okwetikka ekikoligo kye","poem":1},{"text":"mu buvubuka bwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Atuulenga yekka mu kasirise","poem":1},{"text":"kubanga Mukama y’akimwambiseemu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Leka akweke amaaso ge mu nfuufu, mpozi wanaabaawo essuubi.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Leka aweeyo oluba lwe okukubibwa,","poem":1},{"text":"era amalibwe n’okuvumibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Kubanga Mukama taligobera bantu bweru","poem":1},{"text":"ebbanga lyonna.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Newaakubadde ng’aleeta obulumi, aliraga ekisa","poem":1},{"text":"kubanga okwagala kwe kungi nnyo tekuggwaawo.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Tagenderera kuleeta bulumi","poem":1},{"text":"newaakubadde okubonaabona ku baana ba bantu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Mukama akkiriziganya","poem":1},{"text":"n’okulinnyirira abasibe,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"n’okuggyako omuntu obwetwaze bwe","poem":1},{"text":"mu maaso g’Oyo Ali Waggulu Ennyo,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"oba n’obutaba na bwenkanya eri omuntu?","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Ani ayinza okwogera ekintu ne kituukirira,","poem":1},{"text":"Mukama nga takiragidde?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Mu kamwa k’oyo Ali Waggulu Ennyo,","poem":1},{"text":"si mmwe muva ebigambo eby’okubeerwa n’eby’okubonereza?","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Lwaki omuntu omulamu yeemulugunya,","poem":1},{"text":"bw’abonerezebwa olw’ebibi bye?","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Twekebere engeri zaffe, era tuzeetegereze,","poem":1},{"text":"tudde eri Mukama.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Tuyimuse emitima gyaffe n’emikono gyaffe","poem":1},{"text":"eri Katonda mu ggulu, twogere nti,","poem":2}]},{"type":"verse","number":42,"content":[{"text":"“Twayonoona ne tujeema,","poem":1},{"text":"tokyerabiranga era tonatusonyiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"“Ojjudde obusungu n’otugobaganya,","poem":1},{"text":"n’otutta awatali kutusaasira.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Weebisseeko ekire,","poem":1},{"text":"waleme okubaawo okusaba n’okumu okutuuka gy’oli.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Otufudde obusa n’ebisasiro","poem":1},{"text":"mu mawanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"“Abalabe baffe bonna batwogerako","poem":1},{"text":"ebigambo ebibi.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Tubonyeebonye olw’entiisa n’emitego","poem":1},{"text":"n’okunyagibwa n’okuzikirizibwa.”","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Amaaso gange gakulukuta emigga gy’amaziga","poem":1},{"text":"olw’okuzikirira kw’abantu bange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Era amaaso gange ganeeyongeranga okukulukuta amaziga","poem":1},{"text":"awatali kusirika,","poem":2}]},{"type":"verse","number":50,"content":[{"text":"okutuusa Mukama lw’alisinzira","poem":1},{"text":"mu ggulu n’alaba.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Bye ndaba bireeta ennaku ku mutima gwange,","poem":1},{"text":"olw’ebyo ebyatuuka ku bawala b’ekibuga kyange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Abalabe bange banjigganya olutata","poem":1},{"text":"ne baba ng’abayigga ennyonyi.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Bagezaako okuzikiririza obulamu bwange mu bunnya,","poem":1},{"text":"ne bankasuukirira amayinja;","poem":2}]},{"type":"verse","number":54,"content":[{"text":"amazzi gaabikka omutwe gwange,","poem":1},{"text":"ne ndowooza nti, nsanyeewo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"“Nakoowoola erinnya lyo, Ayi Mukama,","poem":1},{"text":"nga ndi mu bunnya wansi ennyo;","poem":2}]},{"type":"verse","number":56,"content":[{"text":"wawulira okwegayirira kwange: toziba matu go","poem":1},{"text":"eri okukaaba kwange.”","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Bwe nakukoowoola wansemberera","poem":1},{"text":"n’oyogera nti, “Totya!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"Mukama watunula mu nsonga yange,","poem":1},{"text":"era n’onunula obulamu bwange.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Ayi Mukama, walaba ebibi bye bankola,","poem":1},{"text":"obasalire omusango nga bwe kibagwanira.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Walaba bwe bampalana,","poem":1},{"text":"n’enkwe zaabwe zonna ze bansalira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"Wawulira bye banvuma, Ayi Mukama Katonda,","poem":1},{"text":"n’enkwe zaabwe zonna ze bansalira,","poem":2}]},{"type":"verse","number":62,"content":[{"text":"obwama n’ebirowoozo eby’abalabe bange","poem":1},{"text":"bye bantesaako obudde okuziba.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Batunuulire mu kutuula kwabwe ne mu kuyimirira kwabwe;","poem":1},{"text":"bannyooma nga bwe bannyimbirira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"Obasasule nga bwe kibagwanira Ayi Mukama Katonda,","poem":1},{"text":"olw’ebikolwa eby’emikono gyabwe.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Osseeko ekibikka ku mitima gyabwe,","poem":1},{"text":"n’ekikolimo kyo kibabeereko.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Obayigganye mu busungu bwo obazikirize","poem":1},{"text":"ng’osinziira mu ggulu lya Mukama Katonda.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}