{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"LAM","translationId":"lug_bib","name":"Okukungubaga","commonName":"Okukungubaga","title":"Ekitabo Ekiyitibwa Okukungubaga","order":25,"numberOfChapters":5,"sha256":"c2fc22941823ec1b6865fda7ef5350700c967f0df02447282a7ad3e7668ebe33","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/lug_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Zaabu ng’ettalazze!","poem":1},{"text":"Zaabu ennungi ng’efuuse!","poem":2},{"text":"Amayinja ag’omuwendo gasaasaanye","poem":1},{"text":"buli luguudo we lutandikira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Abaana ba Sayuuni ab’omuwendo","poem":1},{"text":"abaali beenkana nga zaabu ennungi,","poem":2},{"text":"kaakano bali ng’ensuwa ez’ebbumba,","poem":1},{"text":"omulimu gw’emikono gy’omubumbi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ebibe biyonsa","poem":1},{"text":"abaana baabyo,","poem":2},{"text":"naye abantu bange bafuuse ng’abatalina kisa,","poem":1},{"text":"bafaanana nga bammaaya mu ddungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Olw’ennyonta omwana ayonka gy’alina,","poem":1},{"text":"olulimi lwe lukwatira ku kibuno ky’akamwa ke;","poem":2},{"text":"abaana basaba emmere","poem":1},{"text":"naye tewali n’omu agibawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Abaalyanga ebiwoomerera","poem":1},{"text":"basabiriza ku nguudo;","poem":2},{"text":"n’abo abaakuzibwa ng’abambala engoye ezinekaaneka","poem":1},{"text":"bali ku ntuumu ez’ebisasiro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ekibonerezo ky’abantu bange","poem":1},{"text":"kisinga ekya Sodomu,","poem":2},{"text":"ekyawambibwa mu kaseera akatono,","poem":1},{"text":"nga tewali n’omu azze kukibeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Abalangira baabwe baatukula nnyo okusinga omuzira,","poem":1},{"text":"nga beeru okusinga amata;","poem":2},{"text":"n’emibiri gyabwe nga mimyufu okusinga amayinja amatwakaavu,","poem":1},{"text":"era banyirivu nga safiro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Naye kaakano badduggala okusinga enziro,","poem":1},{"text":"era tebakyasobola kutegeerekeka mu nguudo.","poem":2},{"text":"Olususu lwabwe lukalidde ku magumba gaabwe;","poem":1},{"text":"lukaze ng’ekiti ekikalu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abafa ekitala bafa bulungi","poem":1},{"text":"okusinga abafa enjala,","poem":2},{"text":"kubanga abafa enjala bayongobera ne baggwaawo","poem":1},{"text":"olw’obutaba na mmere mu nnimiro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Abakazi ab’ekisa abaagala abaana","poem":1},{"text":"bafumbye abaana baabwe;","poem":2},{"text":"abaana abaafuuka emmere","poem":1},{"text":"abantu bange bwe baazikirizibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mukama akituukirizza mu busungu bwe obungi,","poem":1},{"text":"era abayiyeeko obusungu bwe obungi.","poem":2},{"text":"Yakoleeza omuliro mu Sayuuni","poem":1},{"text":"ogwayokya emisingi gyakyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bakabaka b’ensi","poem":1},{"text":"n’abantu ab’ensi endala tebakkiriza,","poem":2},{"text":"nti abalabe n’ababakyawa baliyingira","poem":1},{"text":"mu wankaaki wa Yerusaalemi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ebyo byabatuukako olw’ebibi bya bannabbi be,","poem":1},{"text":"n’olw’obutali butuukirivu bwa bakabona be,","poem":2},{"text":"abaayiwa omusaayi","poem":1},{"text":"gw’abatuukirivu abaababeerangamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Badoobera mu nguudo","poem":1},{"text":"nga bamuzibe;","poem":2},{"text":"bajjudde omusaayi","poem":1},{"text":"so tewali ayaŋŋanga okukwata ku byambalo byabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Abantu baabagobaganya nga boogera nti, “Muveewo, mmwe abatali balongoofu!","poem":1},{"text":"Muviireewo ddala, so temutukwatako!”","poem":2},{"text":"Bwe baafuuka emmombooze,","poem":1},{"text":"amawanga gabagobaganya nga boogera nti,","poem":2},{"lineBreak":true},{"text":"“Tebakyasaana kubeera wano.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mukama yennyini abasaasaanyizza,","poem":1},{"text":"takyabafaako.","poem":2},{"text":"Bakabona tebakyassibwamu kitiibwa,","poem":1},{"text":"newaakubadde abakadde okuweebwa ebifo eby’oku mwanjo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Amaaso gaffe gakooye","poem":1},{"text":"olw’okulindirira okubeerwa okutajja;","poem":2},{"text":"nga tulindirira","poem":1},{"text":"eggwanga eriyinza okutulokola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Baatucocca","poem":1},{"text":"ne batulemesa okutambulira mu nguudo zaffe;","poem":2},{"text":"enkomerero yaffe n’eba kumpi,","poem":1},{"text":"n’ennaku zaffe ne ziggwaayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Abaatuyiganyanga baatusinga embiro","poem":1},{"text":"okusinga n’empungu ez’omu bbanga.","poem":2},{"text":"Baatugobera mu nsozi","poem":1},{"text":"ne batuteegera mu ddungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Oyo Mukama gwe yafukako amafuta","poem":1},{"text":"yagwa mu mitego gyabwe.","poem":2},{"text":"Twalowooza nga tulikwekebwa mu kisiikirize kye","poem":1},{"text":"ne tubeeranga mu mawanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Sanyuka ojaguze, ggwe Omuwala wa Edomu,","poem":1},{"text":"abeera mu nsi ya Uzi;","poem":2},{"text":"naye lumu olinywa ku kikompe","poem":1},{"text":"n’otamiira ne weeyambula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ggwe Muwala wa Sayuuni, ekibonerezo kyo kikomye awo,","poem":1},{"text":"talikwongerayo mu busibe.","poem":2},{"text":"Naye ggwe omuwala wa Edomu, Mukama alikubonereza,","poem":1},{"text":"n’ayanika ekibi kyo mu lujjudde.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}