{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"LAM","translationId":"lug_bib","name":"Okukungubaga","commonName":"Okukungubaga","title":"Ekitabo Ekiyitibwa Okukungubaga","order":25,"numberOfChapters":5,"sha256":"c2fc22941823ec1b6865fda7ef5350700c967f0df02447282a7ad3e7668ebe33","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/lug_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Jjukira Ayi Mukama ekitutuuseeko.","poem":1},{"text":"Tunula olabe ennaku yaffe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Omugabo gwaffe guweereddwa bannamawanga,","poem":1},{"text":"n’amaka gaffe gatwaliddwa abatali ba mu nnyumba.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tufuuse bamulekwa abatalina bakitaabwe,","poem":1},{"text":"ne bannyaffe bafuuse bannamwandu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tusasulira amazzi ge tunywa;","poem":1},{"text":"n’enku tuteekwa okuzigula.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abatucocca batugobaganya;","poem":1},{"text":"tukooye ate nga tetulina wa kuwummulira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Twakola endagaano ne Misiri n’Abasuuli","poem":1},{"text":"okutufuniranga ku mmere.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bajjajjaffe baayonoona, ne bafa,","poem":1},{"text":"naye tubonerezebwa olw’ebikolwa byabwe ebitaali bya butuukirivu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abaddu be batufuga,","poem":1},{"text":"tewali n’omu ayinza okutulokola mu mukono gwabwe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tuba kumpi n’okuttibwa nga tunoonya emmere,","poem":1},{"text":"olw’ekitala ekiri mu ddungu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Olususu lwaffe luddugadde ng’enziro","poem":1},{"text":"olw’enjala ennyingi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abakyala ba Sayuuni,","poem":1},{"text":"n’abawala embeerera ab’omu bibuga bya Yuda bakwatiddwa olw’amaanyi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abalangira bawanikibbwa baleebeetera ku mikono gyabwe","poem":1},{"text":"n’abakadde tewali abassaamu kitiibwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Abavubuka bawalirizibwa okusa emmere ku jjinja ne ku lubengo,","poem":1},{"text":"n’abalenzi batagala nga beetisse entuumu z’enku.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abakadde tebakyatuula mu wankaaki w’ekibuga,","poem":1},{"text":"n’abavubuka tebakyayimba.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Emitima gyaffe tegikyasanyuka,","poem":1},{"text":"n’okuzina kwaffe kufuuse kukungubaga.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Engule egudde okuva ku mitwe gyaffe.","poem":1},{"text":"Zitusanze kubanga twonoonye!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Emitima gyaffe kyegivudde gizirika,","poem":1},{"text":"era n’amaaso gaffe kyegavudde gayimbaala.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Olw’okuba nga olusozi Sayuuni lulekeddwa nga lwereere,","poem":1},{"text":"ebibe kyebivudde bitambulirako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ggwe, Ayi Mukama obeerera ennaku zonna;","poem":1},{"text":"entebe yo ey’obwakabaka ya mirembe na mirembe.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Lwaki otwelabiririra ddala okumala ennaku ezo zonna?","poem":1},{"text":"Tuddiremu, Ayi Mukama, tudde gy’oli.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tukomyewo gy’oli Ayi Mukama,","poem":1},{"text":"otuzze buggya ng’edda;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"wabula ng’otusuulidde ddala,","poem":1},{"text":"era ng’otusunguwalidde nnyo nnyini obutayagala na kutuddiramu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}