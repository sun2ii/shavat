{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"MIC","translationId":"lug_bib","name":"Mikka","commonName":"Mikka","title":"Ekitabo Ekiyitibwa Mikka","order":33,"numberOfChapters":7,"sha256":"af40252ba0cce77c718da7568e1ca2e35da189528e3001ee0684cf00266575de","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/lug_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Mu mirembe Yuda gye yagenda efugibwa bakabaka bano: Yosamu, ne Akazi, ne Keezeekiya, Mikka eyali Omumolasuuti, yafuna obubaka obuva eri Mukama, obukwata ku kibuga Samaliya ne Yerusaalemi."]},{"type":"verse","number":2,"content":[{"text":"Muwulire mmwe abantu mwenna,","poem":1},{"text":"muwulire mmwe ebintu byonna ebiri mu nsi, ne bonna abagirimu,","poem":2},{"text":"Mukama Ayinzabyonna asinziira mu yeekaalu ye entukuvu,","poem":1},{"text":"ng’alina by’abalumiriza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mulabe, Mukama ajja ng’ava mu ggulu ku ntebe ye","poem":1},{"text":"ng’akka ku nsi ng’atambulira ku nsozi waggulu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"N’ensozi zirisaanuukira wansi w’ebigere bye","poem":1},{"text":"era n’ebiwonvu ne byatika ne bisaanuuka","poem":2},{"text":"ng’ebisenge by’emizindu by’enjuki ebyokeddwa omuliro,","poem":1},{"text":"ng’amazzi g’ekiyiriro bwe gakulukuta ku lusozi nga gayirira ku bbangabanga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bino byonna biribeerawo olw’okwonoona kwa Yakobo,","poem":1},{"text":"olw’ebibi by’ennyumba ya Isirayiri.","poem":2},{"text":"Ekibi kya Yakobo kye kiruwa?","poem":1},{"text":"Si ye Samaliya?","poem":2},{"text":"Kifo ki ekigulumivu ekya Yuda?","poem":1},{"text":"Si Yerusaalemi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Noolwekyo nzija kubetenta Samaliya ngifuule ebifunfugu,","poem":1},{"text":"kifuuke nga ennimiro ey’okusimbamu emizabbibu.","poem":2},{"text":"Ndiyiwa amayinja gaakyo mu kiwonvu","poem":1},{"text":"N’emisingi gyakyo ne ngireka nga gyasamye.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bakatonda baakyo bonna be basinza, balisekulwasekulwa;","poem":1},{"text":"ebintu byonna ebyaweebwayo ng’ebirabo mu yeekaalu biriggya omuliro;","poem":2},{"lineBreak":true},{"text":"ndizikiriza bakatonda baakyo bonna be beekolera.","poem":2},{"text":"Ng’ebirabo ebyo bwe byafunibwa mu bwenzi,","poem":1},{"text":"bwe bityo bwe biritwalibwa mu bwenzi ne bikozesebwa.”","poem":2}]},{"type":"heading","content":["Okukaaba n’Okukungubaga"]},{"type":"verse","number":8,"content":[{"text":"Kyendiva nkaaba ne nkuba ebiwoobe,","poem":1},{"text":"ne ntambula nga sambadde ngatto, era nga ndi bukunya.","poem":2},{"text":"Ndikaaba ng’ekibe,","poem":1},{"text":"ne nkuba ebiwoobe ng’abaana b’ekiwuugulu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ekiwundu kye tekiwonyezeka,","poem":1},{"text":"ne Yuda ky’alwadde.","poem":2},{"text":"Kituukidde ddala ku mulyango gw’abantu bange,","poem":1},{"text":"ne ku Yerusaalemi yennyini.","poem":2}]},{"type":"heading","content":["Omulabe Asemberera Yerusaalemi"]},{"type":"verse","number":10,"content":[{"text":"Temukibuulira mu Gaasi,","poem":1},{"text":"temukaaba maziga n’akatono.","poem":2},{"text":"Mwevulungulire mu nfuufu","poem":1},{"text":"mu Besuleyafula.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Muyiteewo nga muli bwereere nga muswadde,","poem":1},{"text":"mmwe ababeera mu Safiri.","poem":2},{"text":"Ababeera mu Zanani","poem":1},{"text":"tebalifuluma.","poem":2},{"text":"Beswezeeri ekuba ebiwoobe,","poem":1},{"text":"kubanga tokyalinayo buddukiro.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abo ab’omu Malosi bali mu kulumwa okw’amaanyi","poem":1},{"text":"nga balindirira okubeerwa,","poem":2},{"text":"kubanga ekibonoobono kivudde eri Mukama,","poem":1},{"text":"ne kituuka ne ku mulyango gwa Yerusaalemi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mwanguwe okusiba amagaali ku mbalaasi","poem":1},{"text":"mmwe ababeera mu Lakisi.","poem":2},{"text":"Mmwe nsibuko y’ekibi","poem":1},{"text":"mu Bawala ba Sayuuni,","poem":2},{"text":"kubanga ebibi bya Isirayiri byasangibwa mu mmwe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Noolwekyo muligabira Molesesu eky’e Gaasi","poem":1},{"text":"ebirabo ebimusiibula.","poem":2},{"text":"Ebibuga by’e Akuzibu birikakasibwa nga bya bulimba","poem":1},{"text":"eri bakabaka ba Isirayiri.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mmwe abantu b’omu Malesa,","poem":1},{"text":"ndibasindikira alibawangula n’abafuga.","poem":2},{"text":"Oyo ekitiibwa kya Isirayiri","poem":1},{"text":"alijja mu Adulamu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mukungubage, n’emitwe mugimwe","poem":1},{"text":"olw’abaana bammwe be mwesiimisa;","poem":2},{"text":"mumwe enviiri zammwe nga mukungubaga, emitwe gyammwe gibe ng’egy’ensega,","poem":1},{"text":"kubanga abaana bammwe balibaggyibwako ne batwalibwa mu buwaŋŋanguse.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}