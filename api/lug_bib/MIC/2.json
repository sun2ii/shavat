{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"MIC","translationId":"lug_bib","name":"Mikka","commonName":"Mikka","title":"Ekitabo Ekiyitibwa Mikka","order":33,"numberOfChapters":7,"sha256":"af40252ba0cce77c718da7568e1ca2e35da189528e3001ee0684cf00266575de","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/lug_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Zibasanze mmwe abateesa okukola ebitali bya butuukirivu","poem":1},{"text":"era abateesa okukola ebibi nga bali ku buliri bwabwe;","poem":2},{"text":"Obudde bwe bukya ne batuukiriza entegeka zaabwe,","poem":1},{"text":"kubanga kiri mu nteekateeka yaabwe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Beegomba ebyalo ne babitwala,","poem":1},{"text":"ne beegomba ennyumba nazo ne bazitwala.","poem":2},{"text":"Banyigiriza omuntu ne batwala amaka ge olw’amaanyi,","poem":1},{"text":"ne bamubbako ebyobusika bwe.","poem":2}]},{"type":"verse","number":3,"content":["Mukama kyava agamba nti,",{"text":"“Laba, ndireeta akabi ku bantu abo,","poem":1},{"text":"ke mutagenda kweggyamu.","poem":2},{"text":"Temuliddayo kubeera n’amalala nate","poem":1},{"text":"kubanga kiriba kiseera kya mitawaana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Olwo abantu balikusekerera;","poem":1},{"text":"Balikuyeeyereza nga bayimba oluyimba luno olw’okukungubaga nti:","poem":2},{"text":"‘Tugwereddewo ddala;","poem":1},{"text":"ebintu by’abantu bange bigabanyizibbwamu.","poem":2},{"text":"Mukama anziggirako ddala ettaka lyange,","poem":1},{"text":"n’aliwa abo abatulyamu enkwe.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Noolwekyo tewalisigalawo muntu n’omu mu kuŋŋaaniro lya Mukama,","poem":1},{"text":"aligabanyaamu ettaka ku bululu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bannabbi baabwe boogera nti, “Temuwa bunnabbi,","poem":1},{"text":"Temuwa bunnabbi ku bintu ebyo;","poem":2},{"lineBreak":true},{"text":"tewali kabi kagenda kututuukako.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ekyo kye ky’okuddamu ggwe ennyumba ya Yakobo?","poem":1},{"text":"Olowooza Omwoyo wa Mukama asunguwalira bwereere, si lwa bulungi bwo?","poem":2},{"lineBreak":true},{"text":"Ebigambo bye tebiba birungi eri abo abakola obulungi?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ennaku zino abantu bange bannyimukiddeko","poem":1},{"text":"ng’omulabe.","poem":2},{"text":"Basika ne bambula eminagiro emirungi","poem":1},{"text":"ne baggigya ku migongo gy’abayise ababa beetambulira mu mirembe,","poem":2},{"lineBreak":true},{"text":"ng’abasajja abakomawo okuva mu lutabaalo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bakazi b’abantu bange mubagoba","poem":1},{"text":"mu mayumba gaabwe amalungi,","poem":2},{"text":"abaana baabwe ne mubaggyirako ddala buli mukisa","poem":1},{"text":"oguva eri Katonda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Muyimuke mugende,","poem":1},{"text":"kubanga kino tekikyali kiwummulo kyammwe;","poem":2},{"text":"olw’ebikolwa ebibi bye mukijjuzza,","poem":1},{"text":"kyonoonese obutaddayo kuddaabirizika.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Omuntu bw’ajja n’omwoyo ogw’obulimba, n’agamba nti,","poem":1},{"text":"“Ka mbabuulire ku ssanyu ly’omwenge gwe baagala era gwe banoonya,”","poem":2},{"lineBreak":true},{"text":"oyo y’aba nnabbi w’abantu abo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Ddala ddala ndibakuŋŋaanya mwenna, ggwe Yakobo;","poem":1},{"text":"ndikuŋŋaanya abo abaasigalawo ku Isirayiri.","poem":2},{"text":"Ndibakuŋŋaanya ng’akuŋŋaanya endiga ez’omu ddundiro,","poem":1},{"text":"ng’ekisibo mu ddundiro lyakyo,","poem":2},{"lineBreak":true},{"text":"ekifo kirijjula abantu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Oyo aggulawo ekkubo alibakulembera okubaggya mu buwaŋŋanguse,","poem":1},{"text":"abayise mu mulyango abafulumye.","poem":2},{"text":"Era kabaka waabwe alibakulembera,","poem":1},{"text":"Mukama alibakulembera.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}