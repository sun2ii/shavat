{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"MIC","translationId":"lug_bib","name":"Mikka","commonName":"Mikka","title":"Ekitabo Ekiyitibwa Mikka","order":33,"numberOfChapters":7,"sha256":"af40252ba0cce77c718da7568e1ca2e35da189528e3001ee0684cf00266575de","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/lug_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["Ekibi kya Isirayiri"]},{"type":"verse","number":1,"content":["Ne ndyoka ŋŋamba nti,",{"text":"“Muwulire mmwe abakulembeze ba Yakobo,","poem":1},{"text":"mmwe abafuzi b’ennyumba ya Isirayiri.","poem":2},{"text":"Si mmwe mwandisaanidde okumanya obwenkanya,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"mmwe abakyawa ekirungi ne mwagala ekibi;","poem":2},{"text":"mmwe ababaagako abantu bange eddiba","poem":1},{"text":"ne mubaggyako ennyama ku magumba?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mulya ennyama yaabwe,","poem":1},{"text":"ne mubabaagako eddiba,","poem":2},{"lineBreak":true},{"text":"amagumba gaabwe ne mugamenyaamenya,","poem":2},{"text":"era ne mubasalaasala ng’ennyama","poem":1},{"text":"eneefumbibwa mu nsaka.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Balikoowoola Mukama,","poem":1},{"text":"naye talibaanukula.","poem":2},{"text":"Mu biro ebyo alibakweka amaaso ge","poem":1},{"text":"olw’ebibi bye bakoze.","poem":2}]},{"type":"verse","number":5,"content":["Bw’atyo bw’ayogera Mukama nti,",{"text":"“Bannabbi ababuzaabuza abantu","poem":1},{"text":"balangirira nti, ‘Mirembe,’ eri oyo abaliisa,","poem":2},{"text":"naye oyo atabaliisa bamuggulako olutalo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Noolwekyo ekiro kiribajjira, awatali kwolesebwa,","poem":1},{"text":"n’enzikiza ebajjire awatali kulagulwa.","poem":2},{"text":"Enjuba erigwa nga bannabbi balaba,","poem":1},{"text":"n’obudde bubazibirire.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abalabi baliswazibwa","poem":1},{"text":"n’abalaguzi bakwatibwe ensonyi.","poem":2},{"text":"Bonna balibikka amaaso gaabwe","poem":1},{"text":"kubanga Katonda tabaanukula.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Naye nze, nzijjudde amaanyi","poem":1},{"text":"n’Omwoyo wa Mukama,","poem":2},{"lineBreak":true},{"text":"okwekaliriza ensonga n’obuvumu,","poem":2},{"text":"njasanguze eri Yakobo olw’ebikolwa bye ebibi by’akola,","poem":1},{"text":"olw’ekibi kya Isirayiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mumpulirize mmwe abakulembeze b’ennyumba ya Yakobo,","poem":1},{"text":"Mmwe abafuzi b’ennyumba ya Isirayiri,","poem":2},{"text":"Mmwe abanyooma obwenkanya","poem":1},{"text":"Ne mukyusa ekituufu ne mukifuula ekikyamu;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"mmwe abazimbidde Sayuuni ku musaayi,","poem":1},{"text":"Ne Yerusaalemi ne mugizimbira ku butali butuukirivu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abakulembeze be, balya enguzi ne basala omusango nga beekubiira,","poem":1},{"text":"bakabona be, baggya ensimbi ku bantu balyoke bayigirize,","poem":2},{"lineBreak":true},{"text":"ne bannabbi be, baagala okuwa obunnabbi nga bamaze kusasulwa.","poem":2},{"text":"Kyokka bajuliza Mukama nga boogera nti,","poem":1},{"text":"“Mukama tali naffe?","poem":2},{"lineBreak":true},{"text":"Tewali kinaatutuukako.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Noolwekyo ku lwammwe,","poem":1},{"text":"Sayuuni eririmibwa ng’ennimiro,","poem":2},{"text":"ne Yerusaalemi erifuuka ntuumu ya bifunfugu,","poem":1},{"text":"n’akasozi okuli yeekaalu kafuuke ng’akabira akakutte.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}