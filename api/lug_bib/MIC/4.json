{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"MIC","translationId":"lug_bib","name":"Mikka","commonName":"Mikka","title":"Ekitabo Ekiyitibwa Mikka","order":33,"numberOfChapters":7,"sha256":"af40252ba0cce77c718da7568e1ca2e35da189528e3001ee0684cf00266575de","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/lug_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["Obufuzi bwa Mukama eri Amawanga Gonna"]},{"type":"verse","number":1,"content":[{"text":"Mu nnaku ez’oluvannyuma","poem":1},{"text":"olusozi lw’ennyumba ya Mukama luligulumizibwa","poem":2},{"lineBreak":true},{"text":"okusinga ensozi zonna;","poem":2},{"text":"lulisitulibwa waggulu okusukkuluma ku busozi,","poem":1},{"text":"era abantu balisimba ennyiriri nga balaga gye luli.","poem":2}]},{"type":"verse","number":2,"content":["Amawanga mangi galiragayo ne googera nti,",{"text":"“Mujje twambuke ku lusozi lwa Mukama,","poem":1},{"text":"mu nnyumba ya Katonda wa Yakobo.","poem":2},{"text":"Alituyigiriza by’ayagala","poem":1},{"text":"tulyoke tutambulire mu makubo ge.”","poem":2},{"text":"Alisinziira mu Sayuuni okuwa abantu etteeka lye,","poem":1},{"text":"n’ekigambo kya Mukama kiriva mu Yerusaalemi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aliramula amawanga","poem":1},{"text":"atereeze ensonga wakati w’amawanga gakirimaanyi ag’ewala.","poem":2},{"text":"Baliddira ebitala byabwe ne babiweesaamu enkumbi,","poem":1},{"text":"n’amafumu gaabwe ne bagaweesaamu ebiwabyo.","poem":2},{"text":"Eggwanga teririyimusa kitala ku ggwanga linnaalyo,","poem":1},{"text":"so tebalyetegeka kulwana ntalo nate.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Buli muntu aliba mu ddembe wansi w’omuzabbibu gwe","poem":1},{"text":"ne mu mutiini gwe.","poem":2},{"text":"Tewalibaawo abatiisa","poem":1},{"text":"kubanga akamwa ka Mukama Ayinzabyonna ke kakyogedde.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Newaakubadde nga amawanga gonna","poem":1},{"text":"galigoberera bakatonda baago,","poem":2},{"text":"naye ffe tunaatambuliranga mu linnya lya Mukama","poem":1},{"text":"Katonda waffe emirembe n’emirembe.","poem":2}]},{"type":"heading","content":["Isirayiri Ewona Obusibe"]},{"type":"verse","number":6,"content":["“Ku lunaku olwo,” bw’ayogera Mukama,",{"text":"“Ndikuŋŋaanya abalema,","poem":1},{"text":"n’abo abaawaŋŋangusibwa","poem":2},{"lineBreak":true},{"text":"n’abo abali mu nnaku.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abalema ndibafuula abalonde,","poem":1},{"text":"n’abo be nagoba, mbafuule eggwanga ery’amaanyi.","poem":2},{"text":"Mukama alibafugira mu Lusozi Sayuuni","poem":1},{"text":"okuva ku lunaku olwo okutuusa emirembe gyonna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ggwe omunaala oguyimirirwamu okulabirira endiga,","poem":1},{"text":"ggwe ekigo eky’amaanyi ekya Muwala wa Sayuuni,","poem":2},{"text":"ekitiibwa kyo eky’edda kirikuddira,","poem":1},{"text":"n’obwakabaka ne bukomawo eri Muwala wa Sayuuni.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Naye kaakano kiki ekibakaabya ennyo bwe mutyo?","poem":1},{"text":"Temulina kabaka abakulembera?","poem":2},{"text":"Omuwi w’amagezi wammwe yafa,","poem":1},{"text":"ennaku eryoke ebakwate ng’omukazi alumwa okuzaala?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lumwa, weenyoole ggwe Omuwala wa Sayuuni","poem":1},{"text":"ng’omukazi alumwa okuzaala.","poem":2},{"text":"Kubanga kaakano oteekwa okuva mu kibuga","poem":1},{"text":"ogende obeere ku ttale.","poem":2},{"text":"Mulitwalibwa mu buwaŋŋanguse mu Babulooni,","poem":1},{"text":"era eyo gye ndibalokolera.","poem":2},{"text":"Ndibanunulira eyo","poem":1},{"text":"okuva mu mukono gw’omulabe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kyokka kaakano amawanga mangi","poem":1},{"text":"gakuŋŋaanye okubalwanyisa.","poem":2},{"text":"Boogera nti, Ayonoonebwe,","poem":1},{"text":"n’amaaso gaffe geelolere Sayuuni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Naye tebamanyi","poem":1},{"text":"birowoozo bya Mukama;","poem":2},{"text":"tebategeera kuteesa kwe;","poem":1},{"text":"oyo akuŋŋaanya abalabe be ng’ebinywa by’eŋŋaano bwe bikuŋŋaanyizibwa mu gguuliro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Golokoka otandike okusa ggwe Omuwala wa Sayuuni,","poem":1},{"text":"kubanga ejjembe lyo ndirifuula ekyuma;","poem":2},{"text":"ndikuwa ebigere eby’ekyuma eky’ekikomo","poem":1},{"text":"era olibetenta amawanga mangi.”","poem":2},{"lineBreak":true},{"text":"Amagoba gaabwe n’ebintu byabwe bye bafunye mu makubo amakyamu olibiwaayo eri Mukama,","poem":1},{"text":"n’obugagga bwabwe n’obuwaayo eri Mukama w’ensi zonna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}