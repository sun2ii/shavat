{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"MIC","translationId":"lug_bib","name":"Mikka","commonName":"Mikka","title":"Ekitabo Ekiyitibwa Mikka","order":33,"numberOfChapters":7,"sha256":"af40252ba0cce77c718da7568e1ca2e35da189528e3001ee0684cf00266575de","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/lug_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"heading","content":["Omufuzi Ava mu Besirekemu"]},{"type":"verse","number":1,"content":[{"text":"Kuŋŋaanya amaggye go, ggwe ekibuga ekirina amaggye,","poem":1},{"text":"kubanga tulumbiddwa.","poem":2},{"text":"Omukulembeze wa Isirayiri","poem":1},{"text":"balimukuba omuggo ku luba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Naye ggwe Besirekemu Efulasa,","poem":1},{"text":"newaakubadde ng’oli mutono mu bika bya Yuda,","poem":2},{"text":"mu ggwe mwe muliva alibeera","poem":1},{"text":"omufuzi wange mu Isirayiri.","poem":2},{"text":"Oyo yaliwo okuva edda n’edda,","poem":1},{"text":"ng’ensi tennabaawo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mukama kyaliva awaayo Isirayiri eri abalabe baayo","poem":1},{"text":"okutuusa omukyala alumwa okuzaala lwalizaala omwana,","poem":2},{"text":"era baganda be abaasigalawo ne balyoka bakomawo","poem":1},{"text":"eri bannaabwe mu Isirayiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Aliyimirira n’anyweera n’aliisa ekisibo kye","poem":1},{"text":"mu maanyi ga Mukama,","poem":2},{"lineBreak":true},{"text":"mu kitiibwa ky’erinnya lya Mukama Katonda we.","poem":2},{"text":"Era abantu be tebalibaako abateganya, kubanga aliba mukulu","poem":1},{"text":"okutuusa ku nkomerero y’ensi.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Omukulu oyo aliba mirembe gyabwe.","poem":2},{"text":"Omwasuli bw’alirumba ensi yaffe","poem":1},{"text":"n’abuna ebigo byaffe,","poem":2},{"text":"tulimuyimbulira abasumba musanvu,","poem":1},{"text":"n’abakulembeze munaana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abo be balifuga ensi ya Asuli n’ekitala","poem":1},{"text":"era ensi ya Nimuloodi nayo bagyonoone.","poem":2},{"text":"Naye alitulokola eri Omwasuli","poem":1},{"text":"bw’alitulumba mu nsi yaffe","poem":2},{"lineBreak":true},{"text":"era bw’aliyingira mu nsalo zaffe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Abantu ba Isirayiri abalisigalawo balibeera","poem":1},{"text":"wakati mu mawanga agabeetoolodde,","poem":2},{"text":"babe ng’omusulo oguva eri Mukama,","poem":1},{"text":"ng’obukubakuba obutonnyeredde ku muddo","poem":2},{"text":"obutalindirira muntu","poem":1},{"text":"oba abaana b’abantu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ng’empologoma bw’ebeera n’ensolo endala ez’omu nsiko,","poem":1},{"text":"abantu abaasigalawo aba Yakobo balibeera mu mawanga mangi agabeetoolodde;","poem":2},{"text":"ate era ng’empologoma ento mu bisibo by’endiga,","poem":1},{"text":"bw’egenda n’eyitamu n’etaagulataagula","poem":2},{"lineBreak":true},{"text":"ne wataba n’omu aziwonya.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Omukono gwo guliwangula abalabe bo,","poem":1},{"text":"ne bonna abakuyigganya balizikirizibwa.","poem":2}]},{"type":"verse","number":10,"content":["“Ku lunaku olwo,” bw’ayogera Mukama,",{"text":"“Ndizikiriza embalaasi zo","poem":1},{"text":"ne nsanyaawo n’amagaali go.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndizikiriza ebibuga eby’omu nsi yo","poem":1},{"text":"era mmenyemenye n’ebigo byo byonna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Obulogo bwo ndibumalawo","poem":1},{"text":"era toliddayo kukolima nate.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"N’ebibumbe bye musinza ndibizikiriza.","poem":1},{"text":"Ne nziggyawo n’amayinja ge mwawonga;","poem":2},{"text":"temuliddayo nate kuvuunamira bakatonda","poem":1},{"text":"be mwekoledde n’emikono gyammwe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Era ndisigula Baasera okuva mu mmwe,","poem":1},{"text":"ebibuga byammwe n’embizikiriza.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Era ndyesasuza ku mawanga agataŋŋondedde","poem":1},{"text":"n’obusungu n’ekiruyi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}