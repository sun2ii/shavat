{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"MIC","translationId":"lug_bib","name":"Mikka","commonName":"Mikka","title":"Ekitabo Ekiyitibwa Mikka","order":33,"numberOfChapters":7,"sha256":"af40252ba0cce77c718da7568e1ca2e35da189528e3001ee0684cf00266575de","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/lug_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["Muwulire Mukama by’ayogera ng’agamba nti,",{"text":"“Muyimuke leero tuwoze ensonga zammwe mu maaso g’ensozi,","poem":1},{"text":"n’obusozi buwulire bye mugamba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Kaakano mmwe ensozi muwulire Mukama ky’abavunaana;","poem":1},{"text":"nammwe emisingi gy’ensi egy’olubeerera muwulire.","poem":2},{"text":"Mukama alina ensonga ku bantu be","poem":1},{"text":"era agenda kuwawabira Isirayiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Mmwe abantu bange kiki kye nnali mbakoze?","poem":1},{"text":"Nnali mbazitooweredde? Munziremu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nabaggya mu nsi ye Misiri","poem":1},{"text":"ne mbanunula mu nsi ey’obuddu,","poem":2},{"text":"ne mbawa Musa,","poem":1},{"text":"ne Alooni ne Miryamu okubakulembera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mmwe abantu bange mujjukire","poem":1},{"text":"ekigendererwa kya Balaki kabaka wa Mowaabu","poem":2},{"lineBreak":true},{"text":"n’ebigambo, Balamu omwana wa Byoli bye yayogera.","poem":2},{"text":"Mujjukire bye nabakolera okuva e Sittimu okutuuka e Girugaali","poem":1},{"text":"mulyoke mumanye ebikolwa bya Mukama eby’obutuukirivu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mwebuuza nti kiki kye nnaaleeta mu maaso ga Mukama","poem":1},{"text":"nvuuname mu maaso ga Katonda agulumizibwa?","poem":2},{"text":"Mmusemberere n’ebiweebwayo ebyokebwa,","poem":1},{"text":"n’ennyana ezaakamala omwaka ogumu?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mukama alisiima endiga eza sseddume olukumi,","poem":1},{"text":"oba emitwalo gy’emigga gy’amafuta?","poem":2},{"text":"Mpeeyo omwana wange omubereberye olw’ebibi byange,","poem":1},{"text":"nga mpaayo ekibala ky’omubiri gwange olw’ekibi eky’emmeeme yange?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mukama akulaze, ggwe omuntu, ekirungi ky’oteekwa okukola.","poem":1},{"text":"Kaakano, Mukama kiki ky’akwetaaza,","poem":2},{"text":"okuggyako okukola eby’ensonga, okuba n’ekisa","poem":1},{"text":"era n’okutambulira mu buwombeefu ne Katonda wo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wuliriza, Mukama akoowoola ekibuga mu ddoboozi ery’omwanguka.","poem":1},{"text":"“Kya magezi ddala okutya erinnya lye,","poem":2},{"lineBreak":true},{"text":"n’okussaayo omwoyo eri okukangavvula n’eri oyo akangavvula.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nnyinza okwerabira eby’obugagga bye mwefunira,","poem":1},{"text":"mmwe ennyumba erina obutali butuukirivu,","poem":2},{"lineBreak":true},{"text":"erina n’ekigera ekitatuuka eky’omuzizo?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nnyinza okusonyiwa omuntu alina ebigera ebitatuuse,","poem":1},{"text":"alina ensawo ez’ebipimo eby’obulimba?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abagagga baakyo bakambwe","poem":1},{"text":"n’abatuuze baamu balimba","poem":2},{"lineBreak":true},{"text":"n’ennimi zaabwe tezoogera mazima.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nange kyenvudde ntandika okukuzikiriza,","poem":1},{"text":"nkumalewo olw’ebibi byo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Onoolyanga, naye n’otokutta,","poem":1},{"text":"era olubuto lwo lulisigala lutokota nga lukubanja.","poem":2},{"text":"Oligezaako okukuŋŋaanya, weeterekere, naye tolibaako na kimu ky’otereka","poem":1},{"text":"kubanga byonna ndibiwaayo eri ekitala.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Olisiga naye tolikungula,","poem":1},{"text":"oligezaako okusogola emizeeyituuni weggyiremu amafuta naye tolifuna mafuta gamala kusaabako,","poem":2},{"lineBreak":true},{"text":"olisogola emizabbibu naye toliggyamu kyakunywa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Olw’okuba ng’okolera ku biragiro bya Omuli","poem":1},{"text":"n’ogoberera n’ebikolwa byonna eby’ennyumba ya Akabu","poem":2},{"lineBreak":true},{"text":"n’ogoberera n’emizizo gyabwe,","poem":2},{"text":"kyendiva nkufuula ekifulukwa,","poem":1},{"text":"n’abantu bo bonna babeere eky’okuduulirwa","poem":2},{"lineBreak":true},{"text":"era olibaako ekivume ky’amawanga.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/MIC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/MIC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/MIC/5.json","previousChapterAudioLinks":{},"numberOfVerses":16}