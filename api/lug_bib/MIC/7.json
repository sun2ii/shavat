{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"MIC","translationId":"lug_bib","name":"Mikka","commonName":"Mikka","title":"Ekitabo Ekiyitibwa Mikka","order":33,"numberOfChapters":7,"sha256":"af40252ba0cce77c718da7568e1ca2e35da189528e3001ee0684cf00266575de","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/lug_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Ddala zinsanze nze.","poem":1},{"text":"Ndi ng’omuntu akungula ebibala","poem":2},{"lineBreak":true},{"text":"okuva mu bifo eby’enjawulo eby’ennimiro y’emizabbibu;","poem":2},{"text":"tewali kirimba kya mizabbibu kulyako,","poem":1},{"text":"wadde emizeeyituuni egisooka okwengera gye njagala ennyo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abantu abatya Katonda, baweddewo mu nsi;","poem":1},{"text":"tewali n’omu mulongoofu asigaddewo.","poem":2},{"text":"Bonna banoonya okuyiwa omusaayi,","poem":1},{"text":"buli omu anoonya okutega muganda we ekitimba.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Emikono gyabwe gyombi mikugu mu kukola ebibi;","poem":1},{"text":"omufuzi asaba ebirabo,","poem":2},{"text":"n’omulamuzi alya enguzi,","poem":1},{"text":"n’ab’amaanyi mu nsi, beekolera kye baagala","poem":2},{"lineBreak":true},{"text":"nga basala enkwe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mu abo bonna asingamu obulungi, afaanana ng’omweramannyo;","poem":1},{"text":"asingamu ku mazima y’asinga olukomera lw’amaggwa obubi.","poem":2},{"text":"Naye olunaku lw’abakuumi bammwe lutuuse,","poem":1},{"text":"era kino kye kiseera eky’okutabukatabuka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tewesiga muntu n’omu,","poem":1},{"text":"wadde mukwano gwo,","poem":2},{"text":"newaakubadde mukazi wo,","poem":1},{"text":"Weegendereze by’oyogera.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kubanga omulenzi agaya kitaawe,","poem":1},{"text":"n’omwana alwanyisa nnyina,","poem":2},{"text":"muka mwana n’alwanyisa nnyazaala we.","poem":1},{"text":"Abalabe b’omuntu, bantu be, ab’omu nju ye bennyini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Naye nze nnindirira Mukama nga nnina essuubi,","poem":1},{"text":"nnindirira Katonda Omulokozi wange;","poem":2},{"text":"Katonda wange anampulira.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tonjeeyereza ggwe omulabe wange,","poem":1},{"text":"kubanga wadde ngudde, nnaayimuka.","poem":2},{"text":"Ne bwe naatuula mu kizikiza,","poem":1},{"text":"Mukama anaabeera ekitangaala kyange.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nnaagumikirizanga Mukama bw’anaabanga ambonereza,","poem":1},{"text":"kubanga nnyonoonye mu maaso ge,","poem":2},{"text":"okutuusa lw’alimpolereza,","poem":1},{"text":"n’anziza buggya.","poem":2},{"text":"Alindeeta mu kitangaala,","poem":1},{"text":"era ndiraba obutuukirivu bwe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Olwo omulabe wange alikiraba,","poem":1},{"text":"n’aswala,","poem":2},{"text":"oyo eyanjeeyerezanga ng’agamba nti,","poem":1},{"text":"“Ali ludda wa Mukama Katonda wo?”","poem":2},{"text":"Ndisanyuka ng’agudde,","poem":1},{"text":"era alirinnyirirwa ng’ebitoomi eby’omu nguudo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Olunaku olw’okuzimba bbugwe wo lulituuka,","poem":1},{"text":"olunaku olw’okugaziya ensalo yo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mu biro ebyo abantu balijja gy’oli","poem":1},{"text":"nga bava mu Bwasuli ne mu bibuga by’e Misiri,","poem":2},{"text":"n’okuva e Misiri okutuuka ku mugga Fulaati,","poem":1},{"text":"n’okuva ku nnyanja emu okutuuka ku nnyanja endala,","poem":2},{"text":"n’okuva ku lusozi olumu okutuuka ku lusozi olulala.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ensi erifuuka matongo,","poem":1},{"text":"olw’ebikolwa by’abantu abagibeeramu.","poem":2}]},{"type":"heading","content":["Okusaba n’Okutendereza"]},{"type":"verse","number":14,"content":[{"text":"Lunda abantu bo n’omuggo gwo,","poem":1},{"text":"ekisibo kye weeroboza,","poem":2},{"text":"ababeera bokka mu kibira","poem":1},{"text":"mu malundiro amagimu.","poem":2},{"text":"Baleke baliire mu Basani ne Gireyaadi, nga mu biseera eby’edda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Nga bwe kyali mu nnaku ze mwaviiramu mu Misiri,","poem":1},{"text":"nzija kubalaga ebikulu eby’ekitalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Amawanga galikiraba ne gakwatibwa ensonyi,","poem":1},{"text":"ne gamalibwamu amaanyi.","poem":2},{"text":"Abantu baago balikwata ku mimwa gyabwe","poem":1},{"text":"n’amatu gaabwe ne gaziba.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Balirya enfuufu ng’omusota,","poem":1},{"text":"ng’ebisolo ebyewalula.","poem":2},{"text":"Balifuluma obunnya bwabwe nga bakankana","poem":1},{"text":"ne bakyuka okudda eri Mukama Katonda waffe, ne babatya.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Katonda ki omulala ali nga ggwe,","poem":1},{"text":"asonyiwa ekibi era n’asonyiwa ebyonoono byabo","poem":2},{"lineBreak":true},{"text":"abaasigalawo ku bantu be?","poem":2},{"text":"Obusungu bwe tebubeerera emirembe gyonna,","poem":1},{"text":"naye asanyukira okusaasira.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Alikyuka n’atukwatirwa ekisa nate; alirinnyirira ebibi byaffe,","poem":1},{"text":"n’asuula ebyonoono byaffe byonna mu buziba bw’ennyanja.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Olikola eby’amazima bye wasuubiza Yakobo,","poem":1},{"text":"n’ebyekisa bye wasuubiza Ibulayimu,","poem":2},{"text":"nga bwe weeyama eri bajjajjaffe","poem":1},{"text":"okuva mu nnaku ez’edda.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}