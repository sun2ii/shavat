{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"NAM","translationId":"lug_bib","name":"Nakkumu","commonName":"Nakkumu","title":"Ekitabo Ekiyitibwa Nakkumu","order":34,"numberOfChapters":3,"sha256":"266d3ec242ac07193b6cb0d4784389c300b65db186d27916b2e71a152a3abd02","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/lug_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Kuno kwe kwolesebwa Katonda kwe yalaga Nakkumu, Omwerukoosi okukwata ku bibambulira ebyali bijjira Nineeve."]},{"type":"heading","content":["Obusungu bwa Mukama ku Nineeve"]},{"type":"verse","number":2,"content":[{"text":"Katonda wa buggya era Mukama awalana eggwanga.","poem":1},{"text":"Mukama awalana eggwanga era ajudde ekiruyi.","poem":2},{"text":"Mukama yeesasuza ku balabe be","poem":1},{"text":"era aterekera abamuwakanya obusungu bwe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mukama tatera kusunguwala, ate nga wa maanyi mangi","poem":1},{"text":"era tayinza n’akatono butabonereza oyo gwe gusinze.","poem":2},{"text":"Ekkubo lye liri mu mpewo ey’akazimu ne mu kibuyaga,","poem":1},{"text":"n’ebire ye nfuufu y’ebigere bye.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Akangavvula ennyanja n’agikaza","poem":1},{"text":"era akaza emigga gyonna,","poem":2},{"text":"ennimiro ez’omu Basani zikala, olusozi Kalumeeri lwonna lukayuse,","poem":1},{"text":"n’ebimuli bya Lebanooni biwotose.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ensozi zikankanira mu maaso ga Katonda,","poem":1},{"text":"obusozi ne busaanuuka,","poem":2},{"text":"ettaka ne lyatikayatika mu maaso ge,","poem":1},{"text":"ensi n’ekankana n’abantu bonna abagirimu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ani ayinza okuyimirira mu maaso ge ng’asunguwadde?","poem":1},{"text":"Ani ayinza okugumira obusungu bwe obw’amaanyi?","poem":2},{"text":"Ekiruyi kye kibuubuuka ng’omuliro,","poem":1},{"text":"n’enjazi n’eziyatikayatika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mukama mulungi,","poem":1},{"text":"kiddukiro mu kiseera eky’okulabiramu ennaku,","poem":2},{"text":"era alabirira abo bonna abamwesiga.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Naye alisaanyaawo abalabe be mu mataba amazibu,","poem":2},{"text":"ekizikiza kiribawondera.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Buli kye mwekobaana okukola Mukama,","poem":1},{"text":"alikikomya.","poem":2},{"lineBreak":true},{"text":"Akabi tekalijja mulundi gwakubiri.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kubanga baliba ng’amaggwa agakwataganye,","poem":1},{"text":"era nga batamidde,","poem":2},{"lineBreak":true},{"text":"balyoke bookebwe omuliro ng’ekisambu ekikalu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mu ggwe Nineeve muvuddemu omuntu","poem":1},{"text":"alowooza akabi","poem":2},{"lineBreak":true},{"text":"era ateesa ebibi ku Mukama.","poem":2}]},{"type":"verse","number":12,"content":["Bw’ati bw’ayogera Mukama nti,",{"text":"“Newaakubadde nga balina be bakolagana nabo bangi, ate nga bangi,","poem":1},{"text":"balizikirizibwa ne baggwaawo.","poem":2},{"text":"Newaakubadde nga mbabonereza mmwe abantu bange,","poem":1},{"text":"siriddayo kukikola nate.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kaakano nzija kumenya ekikoligo kyabwe nkibaggyeko","poem":1},{"text":"era n’ebibasibye nnaabikutulakutula.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kino Mukama ky’alagidde ekikwata ku Nineeve:","poem":1},{"text":"“Erinnya lyo terikyayala nate.","poem":2},{"text":"Ndizikiriza ekifaananyi ekyole n’ekifaananyi ekisaanuuse","poem":1},{"text":"ebiri mu masabo g’abakatonda bo;","poem":2},{"text":"ndisima entaana yo","poem":1},{"text":"kubanga oyinze obugwagwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Yimusa amaaso, tunula ku nsozi, laba,","poem":1},{"text":"ebigere ebirungi eby’oyo aleese amawulire amalungi,","poem":2},{"lineBreak":true},{"text":"alangirira emirembe.","poem":2},{"text":"Ggwe Yuda kwata embaga zo entukuvu,","poem":1},{"text":"era otuukirize obweyamo bwo;","poem":2},{"text":"omubi kaakano takyakulumba,","poem":1},{"text":"azikiririzibbwa ddala, tolimulaba nate.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}