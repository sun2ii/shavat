{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"NAM","translationId":"lug_bib","name":"Nakkumu","commonName":"Nakkumu","title":"Ekitabo Ekiyitibwa Nakkumu","order":34,"numberOfChapters":3,"sha256":"266d3ec242ac07193b6cb0d4784389c300b65db186d27916b2e71a152a3abd02","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/lug_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Okugwa kwa Nineeve"]},{"type":"verse","number":1,"content":[{"text":"Nineeve, olumbiddwa omulabe;","poem":1},{"text":"kuuma ekigo,","poem":2},{"lineBreak":true},{"text":"Kuuma ekkubo,","poem":2},{"lineBreak":true},{"text":"weesibire ddala onywere mu kiwato,","poem":2},{"lineBreak":true},{"text":"kuŋŋaanya amaanyi go gonna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kubanga Mukama alizzaawo ekitiibwa kya Yakobo,","poem":1},{"text":"kibe ng’ekitiibwa kya Isirayiri,","poem":2},{"text":"newaakubadde ng’abazikiriza baabasaanyawo,","poem":1},{"text":"ne boonoona emizabbibu gyabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Engabo z’eggye erikutabadde zonna myufu","poem":1},{"text":"n’engoye ze bambadde nazo bwe zityo.","poem":2},{"text":"Amagaali g’ebyuuma gamasamasa","poem":1},{"text":"ku lunaku lwe gategekebwa,","poem":2},{"lineBreak":true},{"text":"era n’amafumu gagalulwa mu ngeri ey’entiisa!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amagaali g’abalwanyi gatayira mu nguudo,","poem":1},{"text":"gadda eno n’eri,","poem":2},{"text":"galabika ng’emimuli egyaka,","poem":1},{"text":"gamyansa ng’eggulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Omuduumizi bw’ayita abalwanyi be","poem":1},{"text":"bajja bagwirana.","poem":2},{"text":"Badduka mbiro ku bbugwe w’ekibuga","poem":1},{"text":"we beetegekera okwerwanako.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enzigi ez’omugga zigguddwawo,","poem":1},{"text":"amazzi ne gasaanyaawo olubiri.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Etteeka lyayisibwa ku kibuga","poem":1},{"text":"nti kiriwaŋŋangusibwa,","poem":2},{"text":"abaddu abakazi bakungubaga ng’amayiba,","poem":1},{"text":"nga bwe beekuba mu bifuba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ab’omu Nineeve bafaanana ng’ekidiba","poem":1},{"text":"eky’amazzi agakalira.","poem":2},{"text":"Wadde nga babakoowoola nti, “Muyimirire, muyimirire!”","poem":1},{"text":"bo beeyongerayo bweyongezi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ffeeza yaakyo temugirekaawo,","poem":1},{"text":"ne zaabu nayo mugitwalire ddala,","poem":2},{"text":"omunyago teguggwaayo,","poem":1},{"text":"eby’obugagga byakyo ebitabalika ebirungi ddala.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ekibuga kisigadde kyangaala!","poem":1},{"text":"Abantu bonna emitima gibeewanise, emibiri gibakankana,","poem":2},{"lineBreak":true},{"text":"amaviivi gabakubagana, basiiwuuse ne mu maaso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Eri ludda wa empuku y’empologoma,","poem":1},{"text":"ekifo we ziriisiza empologoma zaazo ento,","poem":2},{"text":"empologoma ensajja, n’enkazi,","poem":1},{"text":"n’ento we zaatambuliranga nga tewali kizikanga?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Empologoma ensajja yayigganga ennyama y’abaana ebamala,","poem":1},{"text":"n’enkazi n’ezittira eyaazo,","poem":2},{"text":"n’ejjuza empuku n’omuyiggo,","poem":1},{"text":"ne mu bisulo ne mujjula ennyama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Laba nze Mukama ow’Eggye","poem":1},{"text":"nkwolekedde,","poem":2},{"text":"era ndyokya amagaali go gonna ne ganyooka,","poem":1},{"text":"n’ekitala kirizikiriza empologoma zo ento.","poem":2},{"lineBreak":true},{"text":"Era tolifuna munyago mulala nate ku nsi,","poem":2},{"text":"n’eddoboozi ly’ababaka bo","poem":1},{"text":"teririddayo kuwulirwa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}