{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"NAM","translationId":"lug_bib","name":"Nakkumu","commonName":"Nakkumu","title":"Ekitabo Ekiyitibwa Nakkumu","order":34,"numberOfChapters":3,"sha256":"266d3ec242ac07193b6cb0d4784389c300b65db186d27916b2e71a152a3abd02","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/lug_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["Ebibi bya Nineeve"]},{"type":"verse","number":1,"content":[{"text":"Zikusanze ggwe ekibuga eky’omusaayi!","poem":1},{"text":"Kyonna ekijjudde eby’obulimba","poem":2},{"text":"n’obunyazi,","poem":1},{"text":"ekitaggwaamu banyagiddwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Muwulire okuvuga kw’embooko,","poem":1},{"text":"n’okuvuuma kwa namuziga z’amagaali","poem":2},{"text":"n’ebigere by’embalaasi nga bwe bivuga","poem":1},{"text":"n’amagaali nga gakubaganira mu nguudo!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Laba eggye ery’embalaasi erirumba,","poem":1},{"text":"n’ebitala ebitemagana,","poem":2},{"lineBreak":true},{"text":"n’amafumu agamyansa.","poem":2},{"text":"Abatuukiddwako ebisago nga bayitirivu,","poem":1},{"text":"ne ntuumu ennene ez’emirambo","poem":2},{"text":"egitamanyiddwa muwendo;","poem":1},{"text":"abantu bagirinnyirira.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bino byonna biri bityo kubanga Nineeve yeeweerayo ddala okwetunda eri abalabe ba Katonda obutasalako, nga malaaya omukulu,","poem":1},{"text":"kye kibuga ekikyaamu ekitali kyesigwa ekyawubisa ebirala, omukulu w’obufumu,","poem":2},{"text":"ekyafuula amawanga abaddu baakyo olw’obwamalaaya bwakyo,","poem":1},{"text":"n’olw’obulogo bwakyo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Laba nkwolekedde,” bw’ayogera Mukama ow’Eggye,","poem":1},{"text":"“era nditikka engoye zo ne zidda ku mutwe gwo.","poem":2},{"text":"Ensi zonna ziriraba obwereere bwo","poem":1},{"text":"n’obwakabaka bwonna bulabe ensonyi zo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndikukanyugira kazambi,","poem":1},{"text":"era ndikufuula ekyenyinyalwa","poem":2},{"lineBreak":true},{"text":"ne nkufuula eky’okwelolera.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Awo bonna abalikutunuulira balikwesamba ne bagamba nti,","poem":1},{"text":"‘Nineeve kifuuse matongo, ani anakikungubagira?’","poem":2},{"lineBreak":true},{"text":"Abalikikubagiza baliva wa?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ggwe Nineeve ggw’osinga Tebesi","poem":1},{"text":"ekyali kizimbiddwa ku mugga Kiyira","poem":2},{"lineBreak":true},{"text":"ng’amazzi gakyetoolodde okukikuuma ku njuyi zonna?","poem":2},{"text":"Olukomera lwakyo gwali mugga","poem":1},{"text":"era amazzi ge gaali bbugwe waakyo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Esiyopya ne Misiri ze zaakiwagiranga.","poem":1},{"text":"Ate nga Abapuuti","poem":2},{"noteId":0},{"text":"n’ab’omu Libiya nabo nga bakiyamba.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kyawambibwa, ne kitwalibwa mu buwaŋŋanguse.","poem":1},{"text":"Abaana bwakyo abawere babetentebwa mu ntandikwa ya buli luguudo.","poem":2},{"text":"Abakungu baakyo baakubirwa obululu,","poem":1},{"text":"n’abasajja be ab’amaanyi baasibibwa mu njegere.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nineeve naawe olitamiira,","poem":1},{"text":"olyekweka","poem":2},{"lineBreak":true},{"text":"ng’onoonya obuddukiro owone omulabe wo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ebigo byo byonna biri ng’emitiini","poem":1},{"text":"egiriko ebibala ebisooka okwengera;","poem":2},{"text":"bwe ginyeenyezebwa","poem":1},{"text":"ne bigwa mu kamwa k’oyo anaabirya.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Laba abalwanyi bammwe balinafuwa","poem":1},{"text":"ne batiitiira ng’abakazi.","poem":2},{"text":"Enzigi z’ensi yo","poem":1},{"text":"nzigule eri abalabe bo.","poem":2},{"lineBreak":true},{"text":"Era omuliro gwokezza emikiikiro gyazo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Weenyweze bajja kukulumba!","poem":1},{"text":"Weeterekere ku mazzi g’onoonywako.","poem":2},{"text":"Nyweza ebisenge byo.","poem":1},{"text":"Noonya ettaka olisambe","poem":2},{"lineBreak":true},{"text":"oddaabirize ekisenge eky’amatoffaali.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Omuliro gulikulya,","poem":1},{"text":"ekitala kirikuzikiriza.","poem":2},{"lineBreak":true},{"text":"Wenna oliriibwa ng’enzige bwe zirya ebirime.","poem":2},{"text":"Mweyongere obungi ng’enseenene,","poem":1},{"text":"mwale ng’enzige.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mwongedde ku bungi bwa basuubuzi bammwe","poem":1},{"text":"okusinga emmunyeenye ez’oku ggulu.","poem":2},{"text":"Naye ensi baligikaza okufaanana ng’enzige bwe zimalawo ensi","poem":1},{"text":"ne ziryoka zibuuka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abakuumi bammwe bali ng’enzige,","poem":1},{"text":"n’abakungu bammwe ng’ebibinja by’enzige","poem":2},{"lineBreak":true},{"text":"ezibeera ku bisenge ku lunaku olw’obutiti.","poem":2},{"text":"Enjuba bw’evaayo zibuuka","poem":1},{"text":"ne ziraga etamanyiddwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Abasumba bo nga babongoota, ggwe kabaka wa Bwasuli,","poem":1},{"text":"n’abakungu abeekitiibwa bagalamidde nga bawumuddeko.","poem":2},{"text":"Abantu bo basaasaanira ku nsozi","poem":1},{"text":"nga tewali n’omu abakuŋŋaanya.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tewali kisobola kuwonya","poem":1},{"text":"kiwundu kyo ekinene bwe kityo.","poem":2},{"text":"Bonna abawulira ebikuguddeko","poem":1},{"text":"bakuba bukubi mu ngalo olw’okugwa kwo.","poem":2},{"text":"Ani ataakosebwa","poem":1},{"text":"olw’ettima lyo eringi?","poem":2},"Kubanga muntu ki ataatuusibwako bukambwe bwo obwa buli kakedde?"]}],"footnotes":[{"noteId":0,"caller":"+","text":"Abapuuti ne Abapuuli balabika nga baali bantu ba mu kitundu kye kimu. Puuti ye Libiya oba ekitundu ekyetoolodde n’okutuukira ddala ku Somaliya","reference":{"chapter":3,"verse":9}}]},"thisChapterLink":"/api/lug_bib/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}