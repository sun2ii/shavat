{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"NUM","translationId":"lug_bib","name":"Okubala","commonName":"Okubala","title":"Ekitabo Ekiyitibwa Okubala","order":4,"numberOfChapters":36,"sha256":"a2b66745332fe53af5a0345d18c546be4ab9666a313939e2c54645039b272e29","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/lug_bib/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["Awo Balamu bwe yalaba nga Mukama Katonda asiimye okuwa Isirayiri omukisa, n’ataddayo kunoonya bya bulaguzi, nga bwe yakola ku mirundi emirala, naye n’ayolekeza amaaso ge eddungu."]},{"type":"verse","number":2,"content":["Balamu n’alengera ewala, n’alaba Isirayiri gye yasiisira ng’ebika bwe byali, n’ajjirwa Omwoyo wa Katonda,"]},{"type":"verse","number":3,"content":["n’alagula nti,",{"text":"“Okulagula kwa Balamu mutabani wa Byoli,","poem":1},{"text":"okulagula kw’omuntu azibuddwa amaaso,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"okulagula kw’oyo awulira ekigambo kya Katonda","poem":1},{"text":"alaba okwolesebwa kw’Ayinzabyonna,","poem":2},{"lineBreak":true},{"text":"eyeeyaze wansi, n’amaaso ge nga gatunula:","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Eweema zo nga nnungi, Ayi Yakobo,","poem":1},{"text":"ebifo byo mw’obeera, Ayi Isirayiri!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Byeyaliiridde ng’ebiwonvu,","poem":1},{"text":"ng’ennimiro ku mabbali g’omugga,","poem":2},{"text":"ng’emigavu egisimbiddwa Mukama","poem":1},{"text":"ng’emivule egiri okumpi n’amazzi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Amazzi ganaakulukutanga mu bulobo bwabwe; ne gabooga","poem":1},{"text":"ensigo zaabwe zirifunanga amazzi mangi.","poem":2},{"lineBreak":true},{"text":"“Kabaka waabwe aliba wa kitiibwa okukira Agagi","poem":1},{"text":"obwakabaka bwabwe bunaagulumizibwanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Katonda ye yabaggya mu Misiri","poem":1},{"text":"balina amaanyi nga aga sseddume ey’omu nsiko.","poem":2},{"text":"Basaanyaawo amawanga g’abalabe","poem":1},{"text":"ne bamenyaamenya amagumba gaabwe mu butundutundu,","poem":2},{"lineBreak":true},{"text":"ne babalasa n’obusaale bwabwe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ng’empologoma ensajja, beekulula ne bagalamira wansi,","poem":1},{"text":"ng’empologoma enkazi; ani ayaŋŋanga okubagolokosa?","poem":2},{"lineBreak":true},{"text":"“Akusabiranga omukisa aweebwenga omukisa","poem":1},{"text":"n’oyo akukolimira akolimirwenga!”","poem":2}]},{"type":"verse","number":10,"content":["Awo obusungu bwa Balaki ne bubuubuukira ku Balamu. N’akuba mu ngalo omulundi gumu, n’amugamba nti, “Nakuyita okolimire abalabe bange, naye obasabidde mukisa emirundi gino gyonsatule."]},{"type":"verse","number":11,"content":["Kale nno situka oddeyo ewammwe! Nagamba nti nnandikuwadde ebitiibwa bingi, naye Mukama akuziyizza okuweebwa ebitiibwa ebyo.”"]},{"type":"verse","number":12,"content":["Balamu n’agamba Balaki nti, “Ababaka bo be wantumira, saabagamba nti,"]},{"type":"verse","number":13,"content":["‘Balaki ne bw’alimpa ennyumba ye ng’ejjudde zaabu ne ffeeza, sigenda kusukka kiragiro kya Mukama ne nkola ekyange ku bwange oba nga kirungi oba nga kibi, wabula nga ndyogera ebyo byokka Mukama by’alindagira okwogera?’"]},{"type":"verse","number":14,"content":["Kaakano nno nzirayo ewaffe mu bantu bange, naye wuliriza nga nkulabula abantu bano kye balikola abantu bo mu nnaku ezijja.”"]},{"type":"heading","content":["Okulagula kwa Balamu Okwokuna"]},{"type":"verse","number":15,"content":["N’alagula bw’ati nti,",{"text":"“Okulagula kwa Balamu mutabani wa Byoli,","poem":1},{"text":"okulagula kw’omuntu azibuddwa amaaso,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"okulagula kw’oyo awulira ekigambo kya Katonda,","poem":1},{"text":"aggya okutegeera eri oyo Ali Waggulu Ennyo","poem":2},{"text":"alaba okulabikirwa kw’Ayinzabyonna","poem":1},{"text":"eyeeyaze wansi, n’amaaso ge nga gatunula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Mmulaba, naye si kaakano;","poem":1},{"text":"mmutunuulira, naye tali kumpi.","poem":2},{"text":"Emmunyeenye eriva ewa Yakobo;","poem":1},{"text":"omufuzi alisituka ng’ava mu Isirayiri.","poem":2},{"text":"Alibetenta Mowaabu,","poem":1},{"text":"obuwanga bw’abatabani ba Seezi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Edomu","poem":1},{"noteId":14},{"text":"aliwangulwa;","poem":1},{"text":"Seyiri, omulabe we, aliwangulwa,","poem":2},{"lineBreak":true},{"text":"naye Isirayiri alyeyongera amaanyi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Omufuzi alisituka ng’ava mu Yakobo","poem":1},{"text":"n’azikiriza ab’omu kibuga abaliba bawonyeewo.”","poem":2}]},{"type":"heading","content":["Okulagula kwa Balamu Okusembayo"]},{"type":"verse","number":20,"content":["Balamu n’alaba Amaleki, n’alagula nti,",{"text":"“Amaleki ye yakulemberanga mu mawanga,","poem":1},{"text":"naye ku nkomerero agenda kuzikirira.”","poem":2}]},{"type":"verse","number":21,"content":["N’alaba Abakeeni, n’alagula nti:",{"text":"“Ekifo kyo w’obeera wagumu,","poem":1},{"text":"ekisu kyo kiri mu lwazi","poem":2}]},{"type":"verse","number":22,"content":[{"text":"naye era mmwe Abakeeni mugenda kuzikirizibwa","poem":1},{"text":"Asuli bw’alibatwala mu busibe.”","poem":2}]},{"type":"verse","number":23,"content":["Ate n’alagula nti,",{"text":"“Woowe! Ani aba omulamu nga Katonda asazeewo eky’okukola?","poem":1}]},{"type":"verse","number":24,"content":[{"text":"Ebyombo birijja nga biva ku mbalama za Kittimu;","poem":2},{"text":"birifufuggaza Asuli ne Eberi","poem":1},{"noteId":15},{"text":",","poem":1},{"text":"naye nabyo birizikirira.”","poem":2}]},{"type":"verse","number":25,"content":["Awo Balamu n’asituka n’addayo ewaabwe, ne Balaki n’akwata agage."]}],"footnotes":[{"noteId":14,"caller":"+","text":"Edomu Abayedomu bazzukulu ba Esawu.","reference":{"chapter":24,"verse":18}},{"noteId":15,"caller":"+","text":"Eberi ye jjajja w’Abaebbulaniya (1By 1:25-27).","reference":{"chapter":24,"verse":24}}]},"thisChapterLink":"/api/lug_bib/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/NUM/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}