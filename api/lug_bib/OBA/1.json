{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"OBA","translationId":"lug_bib","name":"Obadiya","commonName":"Obadiya","title":"Ekitabo Ekiyitibwa Obadiya","order":31,"numberOfChapters":1,"sha256":"d03cdd37b36aa8c7dd10d8e2333bcc947e5f793d2a01caf52f6f743f736c4517","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/OBA/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/lug_bib/OBA/1.json","totalNumberOfVerses":21},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Kuno kwe kwolesebwa kwa Obadiya.",{"lineBreak":true},{"lineBreak":true},"Mukama Ayinzabyonna kwe yamuwa ku bikwata ku nsi ya Edomu.",{"text":"Tuwulidde obubaka obuva eri Katonda,","poem":1},{"text":"Katonda yaweereza omubaka eri amawanga n’obubaka buno nti,","poem":2},{"text":"“Mugolokoke tulumbe Edomu tumulwanyise.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Laba, ndibafuula aba wansi ennyo mu mawanga,","poem":1},{"text":"era olinyoomererwa ddala.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mwelimbye n’amalala agali mu mitima gyammwe,","poem":1},{"text":"mmwe abasula mu mpuku ez’omu njazi,","poem":2},{"lineBreak":true},{"text":"era ne muzimba amaka gammwe waggulu ku njazi.","poem":2},{"text":"Mmwe aboogera nti,","poem":1},{"text":"‘Ani alituwanulayo n’atussa wansi?’","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wadde nga mwewanika waggulu ng’empungu","poem":1},{"text":"era ne muzimba ebisu byammwe wakati w’emmunyeenye,","poem":2},{"lineBreak":true},{"text":"ndibawanulayo ne mbasuula wansi,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Singa ababbi babajjira,","poem":1},{"text":"n’abanyazi ne babalumba ekiro,","poem":2},{"text":"akabi nga kaba kabatuuseeko.","poem":1},{"text":"Tebandibabbyeko byonna bye baagala?","poem":2},{"text":"Oba singa abanozi b’emizabbibu bakujjiridde,","poem":1},{"text":"tebandireseeko obuzabbibu butono nnyo?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Esawu alinyagulurwa,","poem":1},{"text":"eby’obugagga bye ebikusike birinyagibwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abaalagaana naawe balikusindiikiriza ku nsalo,","poem":1},{"text":"Mikwano gyo balikulimbalimba ne bakuwangula;","poem":2},{"text":"abo abalya emmere yo balikutega omutego,","poem":1},{"text":"balikutega omutego kyokka toliguvumbula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ku lunaku olwo,","poem":1},{"text":"sirizikiriza bagezi b’e Edomu,","poem":2},{"lineBreak":true},{"text":"abantu ab’amagezi ababeera mu nsozi za Esawu?” bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Abalwanyi bo abazira ggwe, Temani, balitya,","poem":1},{"text":"era na buli muntu mu nsozi za Esawu","poem":2},{"lineBreak":true},{"text":"alittibwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Olw’ebikolwa eby’obukambwe ebyo bye wakola muganda wo Yakobo,","poem":1},{"text":"oliswazibwa.","poem":2},{"lineBreak":true},{"text":"Olizikirizibwa n’otaddayo kuwulirwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ku lunaku lwe wayimirira ku bbali n’otofaayo,","poem":1},{"text":"nga banyaga obugagga bwa Isirayiri,","poem":2},{"text":"ne bannaggwanga ne bayingira mu miryango gye,","poem":1},{"text":"ne bakuba obululu okulaba atwala Yerusaalemi,","poem":2},{"lineBreak":true},{"text":"wali omu ku bo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tosaanye kusekerera muganda wo","poem":1},{"text":"mu biseera bye eby’okulaba ennaku,","poem":2},{"text":"wadde okusanyuka ku lunaku","poem":1},{"text":"olw’okuzikirira kw’abantu ba Yuda,","poem":2},{"text":"newaakubadde okwewaana ennyo","poem":1},{"text":"ku lunaku lwe baatawaanyizibwa ennyo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Temukumba nga muyita mu miryango gy’abantu bange","poem":1},{"text":"ku lunaku kwe baalabira obuyinike,","poem":2},{"text":"wadde okubasekerera","poem":1},{"text":"ku lunaku kwe baabonaabonera,","poem":2},{"text":"newaakubadde okutwala obugagga bwabwe","poem":1},{"text":"ku lunaku lwe baatuukibwako akabi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Temulindira mu masaŋŋanzira","poem":1},{"text":"okutta abo abadduka,","poem":2},{"text":"wadde okuwaayo abawonyeewo","poem":1},{"text":"mu biro eby’okulabiramu ennaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Olunaku luli kumpi kwe ndisalira","poem":1},{"text":"amawanga gonna omusango.","poem":2},{"text":"Nga bwe mwakola abalala, nammwe bwe mulikolebwa.","poem":1},{"text":"Ebikolwa byammwe biribaddira.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ng’abantu bange bwe baanywa ekikompe eky’ekibonerezo ku lusozi lwange olutukuvu","poem":1},{"text":"n’amawanga ageetooloddewo bwe galikinywa obutakoma;","poem":2},{"text":"balikinywa,","poem":1},{"text":"babe ng’abataganywangako.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Naye ku Lusozi Sayuuni baliwona,","poem":1},{"text":"kubanga lutukuvu,","poem":2},{"text":"n’ennyumba ya Yakobo","poem":1},{"text":"eritwala omugabo gwabwe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ennyumba ya Yakobo eriba omuliro,","poem":1},{"text":"n’ennyumba ya Yusufu olulimi olw’omuliro.","poem":2},{"text":"Ennyumba ya Esawu eriba bisusunku,","poem":1},{"text":"era baligyokya n’eggwaawo.","poem":2},{"text":"Tewaliba muntu wa nnyumba ya Esawu","poem":1},{"text":"n’omu alisigalawo,","poem":2},{"text":"kubanga Mukama akyogedde.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Abantu b’e Negebu balitwala","poem":1},{"text":"olusozi Esawu,","poem":2},{"text":"n’abantu ab’omu biwonvu balitwala","poem":1},{"text":"ensi y’Abafirisuuti.","poem":2},{"text":"Balyetwalira n’ennimiro ez’omu Efulayimu ne Samaliya,","poem":1},{"text":"ne Benyamini ne yeetwalira Gireyaadi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ekibiina ky’Abayisirayiri abaali mu buwaŋŋanguse e Kanani,","poem":1},{"text":"balyetwalira ensi, okutuukira ddala ku Zalefaasi;","poem":2},{"text":"abawaŋŋanguse abaava mu Yerusaalemi abali mu Sefalaadi,","poem":1},{"text":"balyetwalira ebibuga mu Negebu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Abanunuzi balyambuka ku Lusozi Sayuuni,","poem":1},{"text":"okufuga ensozi za Esawu.","poem":2},{"lineBreak":true},{"text":"Obwakabaka buliba bwa Mukama.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/OBA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/AMO/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}