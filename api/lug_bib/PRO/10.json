{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PRO","translationId":"lug_bib","name":"Engero","commonName":"Engero","title":"Ekitabo Ekiyitibwa Engero","order":20,"numberOfChapters":31,"sha256":"74bebdc5ccdfc2b9b104ec7fe764cc09b398d5a80da6220ba11f5830f71163ac","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lug_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":10,"content":[{"type":"heading","content":["Engero za Sulemaani"]},{"type":"verse","number":1,"content":["Engero za Sulemaani:",{"text":"Omwana ow’amagezi asanyusa kitaawe;","poem":1},{"text":"naye omwana omusirusiru anakuwaza nnyina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Eby’obugagga ebifuniddwa mu makubo amakyamu tebirina kye bigasa,","poem":1},{"text":"naye abatuukirivu banunulwa okuva mu kufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mukama taalekenga mutuukirivu we kufa njala,","poem":1},{"text":"naye aziyiza abakozi b’ebibi okufuna bye beetaaga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Emikono emigayaavu gyavuwaza,","poem":1},{"text":"naye emikono eminyiikivu gireeta obugagga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Omuvubuka ow’amagezi akungulira mu biseera ebituufu,","poem":1},{"text":"naye oyo eyeebakira mu biro eby’okukunguliramu mwana aswaza ennyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Omukisa gubeera ku mutwe gw’omutuukirivu,","poem":1},{"text":"naye akamwa k’omukozi w’ebibi kajjula obukambwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Omutuukirivu anajjukirwanga n’essanyu,","poem":1},{"text":"naye erinnya ly’omubi linaavundanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Alina omutima ogw’amagezi agondera ebiragiro,","poem":1},{"text":"naye omusirusiru ayogerayogera, azikirizibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Atambulira mu bwesimbu y’atambula emirembe,","poem":1},{"text":"naye akwata amakubo amakyamu alitegeerebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Oyo atta ku liiso ng’akweka amazima aleeta ennaku,","poem":1},{"text":"n’omusirusiru ayogerayogera alizikirizibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Akamwa ak’omutuukirivu nsulo ya bulamu,","poem":1},{"text":"naye akamwa k’omukozi w’ebibi kajjula bulabe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Obukyayi buleeta enjawukana,","poem":1},{"text":"naye okwagala kubikka ku bibi bingi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Amagezi gasangibwa ku mimwa gy’oyo alina okutegeera,","poem":1},{"text":"naye omuggo gukangavvula oyo atamanyi kusalawo bulungi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Abantu ab’amagezi batereka okumanya,","poem":1},{"text":"naye akamwa k’omusirusiru kaaniriza kuzikirira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Obugagga bw’omugagga kye kibuga kye ekiriko ebigo,","poem":1},{"text":"naye obwavu kwe kuzikirira kw’omwavu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Empeera y’omutuukirivu bulamu,","poem":1},{"text":"naye empeera y’omukozi w’ebibi emuleetera kubonerezebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Oyo assaayo omwoyo eri okubuulirirwa aba mu kkubo ery’obulamu,","poem":1},{"text":"naye oyo atassaayo mwoyo ku kunenyezebwa aleetera abalala okuwaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Oyo akisa obukyayi alina emimwa egirimba,","poem":1},{"text":"era omuntu akonjera, musirusiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mu bigambo ebingi temubula kwonoona,","poem":1},{"text":"naye akuuma olulimi lwe aba wa magezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Olulimi lw’omutuukirivu ffeeza ya muwendo,","poem":1},{"text":"naye omutima gw’omukozi w’ebibi gugasa katono.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ebigambo by’omutuukirivu biriisa abantu bangi,","poem":1},{"text":"naye abasirusiru bazikirira olw’okubulwa amagezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Omukisa gwa Mukama guleeta obugagga","poem":1},{"text":"era tagwongerako buyinike.","poem":2}]},{"type":"heading","content":["Okuwangaala Okuli mu Kutya Mukama"]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Omusirusiru asanyukira okukola ebibi,","poem":1},{"text":"naye omuntu alina okutegeera asanyukira eby’amagezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Omukozi w’ebibi ky’atayagala kirimutuukako,","poem":1},{"text":"naye abatuukirivu bye baagala biribaweebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Embuyaga bw’ejja, abakozi b’ebibi batwalibwa,","poem":1},{"text":"naye abatuukirivu banywera emirembe gyonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ng’omususa bwe gunyeenyeza amannyo, n’omukka nga bwe gubalagala mu maaso,","poem":1},{"text":"n’omugayaavu bw’abeera bw’atyo eri abamutuma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Okutya Mukama kuwangaaza omuntu,","poem":1},{"text":"naye emyaka gy’ababi girisalibwako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Essuubi ly’abatuukirivu livaamu ssanyu,","poem":1},{"text":"naye okusuubira kw’abakozi b’ebibi tekulivaamu kantu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ekkubo lya Mukama kye kiddukiro ky’abatuukirivu, naye abakozi b’ebibi libasaanyaawo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Abatuukirivu tebajjululwenga ennaku zonna,","poem":1},{"text":"naye abakozi b’ebibi tebalisigala mu nsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Akamwa k’omutuukirivu koogera eby’amagezi,","poem":1},{"text":"naye olulimi olwogera eby’obubambavu lulisalibwamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Emimwa gy’omutuukirivu gyogera ebisaanidde;","poem":1},{"text":"naye emimwa gy’omukozi w’ebibi gyogera eby’obubambavu.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}