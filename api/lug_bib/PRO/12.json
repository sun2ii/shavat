{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PRO","translationId":"lug_bib","name":"Engero","commonName":"Engero","title":"Ekitabo Ekiyitibwa Engero","order":20,"numberOfChapters":31,"sha256":"74bebdc5ccdfc2b9b104ec7fe764cc09b398d5a80da6220ba11f5830f71163ac","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lug_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Buli asanyukira okukangavvulwa ayagala amagezi;","poem":1},{"text":"naye oyo akyawa okunenyezebwa musirusiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Omuntu omulungi aganja mu maaso ga Mukama,","poem":1},{"text":"naye Mukama asalira omusango omuntu ow’enkwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Omuntu tanywezebwa lwa kukola bitali bya butuukirivu,","poem":1},{"text":"naye omulandira gw’omutuukirivu tegulisigulwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Omukyala ow’empisa ennungi ssanyu era ngule ya mwami we,","poem":1},{"text":"naye omukazi eyeeyisa obubi ali nga kookolo mu magumba ga bba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Enteekateeka z’omutuukirivu ziba za mazima,","poem":1},{"text":"naye amagezi g’abakozi b’ebibi ge bawa gaba ga bulimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ebiteeso by’abakozi b’ebibi kuyiwa musaayi,","poem":1},{"text":"naye ebigambo by’abatuukirivu bye bibawonya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Abakozi b’ebibi bagwa ne basaanirawo ddala,","poem":1},{"text":"naye ennyumba y’omutuukirivu teesagaasaganenga emirembe gyonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ebigambo by’omugezi bimuleetera okusiimibwa,","poem":1},{"text":"naye eby’omusirusiru bimunyoomesa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Omuntu eyeetoowaza ne yeekolera,","poem":1},{"text":"asinga oyo eyeegulumiza n’abulwa ky’alya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Omutuukirivu afaayo ku bisolo bye,","poem":1},{"text":"naye omukozi w’ebibi abiraga bukambwe bwereere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Oyo eyeerimira aliba n’emmere nnyingi,","poem":1},{"text":"naye oyo anoonya ebitaliimu talina magezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Abakozi b’ebibi baagala okubba omunyago gwa babbi bannaabwe,","poem":1},{"text":"naye omulandira gw’abatuukirivu gunywera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ebigambo by’omukozi w’ebibi bimusuula mu mitawaana,","poem":1},{"text":"naye omutuukirivu awona akabi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Omuntu ajjuzibwa ebirungi okuva mu bibala bye bigambo by’akamwa ke,","poem":1},{"text":"n’emirimu gy’emikono gye gimusasula bulungi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ekkubo ly’omusirusiru ddungi mu kulaba kwe ye,","poem":1},{"text":"naye omugezi assaayo omwoyo ku magezi agamuweebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Omusirusiru alaga mangu obusungu bwe,","poem":1},{"text":"naye omutegeevu tassa mwoyo ku kivume.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Omujulizi ow’amazima awa obujulizi obutuufu,","poem":1},{"text":"naye omujulizi ow’obulimba ayogera bya bulimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ebigambo ebyanguyirize bisala ng’ekitala ekyogi,","poem":1},{"text":"naye olulimi lw’omuntu omugezi luwonya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Emimwa egyogera amazima gibeerera emirembe gyonna,","poem":1},{"text":"naye olulimi olulimba lwa kiseera buseera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Obulimba buli mu mitima gyabo abategeka okukola ebibi,","poem":1},{"text":"naye essanyu liri n’abo abakolerera emirembe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tewali kabi konna kagwa ku batuukirivu,","poem":1},{"text":"naye abakozi b’ebibi tebaggwaako mitawaana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Mukama akyawa emimwa egirimba,","poem":1},{"text":"naye asanyukira ab’amazima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Omuntu omutegeevu talaga nnyo by’amanyi,","poem":1},{"text":"naye abasirusiru balaga obutamanya bwabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Omukono gw’omunyiikivu gulimufuula omufuzi,","poem":1},{"text":"naye obugayaavu bufuula omuntu omuddu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Omutima ogweraliikirira guleetera omuntu okwennyika,","poem":1},{"text":"naye ekigambo eky’ekisa kimusanyusa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Omutuukirivu yeegendereza mu mikwano gye,","poem":1},{"text":"naye ekkubo ly’ababi libabuza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Omuntu omugayaavu tayokya muyiggo gwe,","poem":1},{"text":"naye omunyiikivu kyayizze, kiba kya muwendo gyali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Mu kkubo ery’obutuukirivu mulimu obulamu,","poem":1},{"text":"era mu kkubo eryo temuli kufa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}