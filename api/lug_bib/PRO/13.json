{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PRO","translationId":"lug_bib","name":"Engero","commonName":"Engero","title":"Ekitabo Ekiyitibwa Engero","order":20,"numberOfChapters":31,"sha256":"74bebdc5ccdfc2b9b104ec7fe764cc09b398d5a80da6220ba11f5830f71163ac","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lug_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":13,"content":[{"type":"heading","content":["Ensibuko y’Obugagga Obungi"]},{"type":"verse","number":1,"content":[{"text":"Omwana omugezi assaayo omwoyo eri ebiragiro bya kitaawe,","poem":1},{"text":"naye omunyoomi tafaayo ku kunenyezebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Omuntu asanyuka olw’ebirungi ebiva mu bibala bya kamwa ke,","poem":1},{"text":"naye atali mwesigwa yeegomba kuleeta ntalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Oyo eyeegendereza by’ayogera akuuma obulamu bwe,","poem":1},{"text":"naye oyo amala googera, alizikirira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Omuntu omugayaavu yeegomba kyokka n’atabaako ky’afuna,","poem":1},{"text":"naye omunyiikivu byayagala byonna abifuna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Omuntu omutuukirivu akyawa obulimba,","poem":1},{"text":"naye omukozi w’ebibi yeereetera kunyoomebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Obutuukirivu bukuuma omuntu omwesimbu,","poem":1},{"text":"naye okukola ebibi kuzikiriza omwonoonyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Omuntu omu ayinza okwefuula omugagga ate nga taliiko ky’alina,","poem":1},{"text":"ate omulala ne yeefuula okuba omwavu so nga mugagga nnyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Obugagga bw’omuntu buyinza okumununula,","poem":1},{"text":"naye omwavu talina ky’atya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ekitangaala ky’abatuukirivu kyaka nnyo,","poem":1},{"text":"naye ettaala y’abakozi b’ebibi ezikira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Amalala gazaala buzaazi nnyombo,","poem":1},{"text":"naye amagezi gasangibwa mu abo abakkiriza okulabulwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ensimbi enkumpanye ziggwaawo,","poem":1},{"text":"naye ezijja empolampola zeeyongera obungi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Essuubi erirwawo okutuukirira lirwaza omutima,","poem":1},{"text":"naye ekyegombebwa bwe kituukirira kiba muti gwa bulamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Omuntu anyooma ebiragiro aligwa mu mitawaana,","poem":1},{"text":"naye oyo awuliriza ebimulagirwa aliweebwa empeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Okuyigiriza kw’omuntu alina amagezi nsulo ya bulamu,","poem":1},{"text":"era kuggya omuntu mu mitego gy’okufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Okutegeera okulungi kuleeta okuganja,","poem":1},{"text":"naye ekkubo ly’abateesigibwa liba zzibu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Omuntu omwegendereza akola amaze kulowooza,","poem":1},{"text":"naye omusirusiru alaga obutamanya bwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Omubaka omubi yeesuula mu mitawaana,","poem":1},{"text":"naye omubaka omwesigwa aleeta kuwonyezebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Anyooma okukangavvulwa yeereetako obwavu n’obuswavu,","poem":1},{"text":"naye oyo assaayo omwoyo ku kunenyezebwa aweebwa ekitiibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ekyegombebwa bwe kituukirira kisanyusa omutima,","poem":1},{"text":"naye okulekayo okukola ebibi kya muzizo eri abasirusiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Oyo atambula n’abantu abagezi ageziwala,","poem":1},{"text":"naye oyo atambula n’abasirusiru alaba ennaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Emitawaana gigoberera aboonoonyi,","poem":1},{"text":"naye okukulaakulana y’empeera y’abatuukirivu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Omuntu omulungi alekera bazzukulu be ebyobusika,","poem":1},{"text":"naye obugagga bw’omwonoonyi buterekerwa omutuukirivu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ennimiro z’abaavu ziyinza okuvaamu emmere nnyingi,","poem":1},{"text":"naye obutali bwenkanya ne bugyera yonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Atakozesa kaggo akyawa omwana we,","poem":1},{"text":"naye oyo amwagala afaayo okumukangavvula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Omutuukirivu alya emmere ye n’akkuta,","poem":1},{"text":"naye abakozi b’ebibi basigala nga bayala.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}