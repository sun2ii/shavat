{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PRO","translationId":"lug_bib","name":"Engero","commonName":"Engero","title":"Ekitabo Ekiyitibwa Engero","order":20,"numberOfChapters":31,"sha256":"74bebdc5ccdfc2b9b104ec7fe764cc09b398d5a80da6220ba11f5830f71163ac","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lug_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Omukazi ow’amagezi yeezimbira ennyumba ye,","poem":1},{"text":"naye omusirusiru eyiye agyemenyera n’emikono gye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Omuntu atambulira mu bugolokofu atya Mukama,","poem":1},{"text":"naye ow’amakubo amakyamu anyooma Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ebigambo by’omusirusiru bye bimuviirako okukubwa,","poem":1},{"text":"naye eby’abatuukirivu binaabakuumanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Awataba nte nnume ezirima ebyagi biba bikalu,","poem":1},{"text":"naye emmere ennyingi eva mu maanyi gaazo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Omujulizi ow’amazima talimba,","poem":1},{"text":"naye ow’obulimba ayogera bya bulimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Omukudaazi anoonya amagezi n’atagalaba,","poem":1},{"text":"naye okumanya kwanguyira omuntu ategeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Teweeretereza muntu musirusiru,","poem":1},{"text":"kubanga tewali by’amagezi biva mu kamwa ke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Omutegeevu mugezi kubanga afaayo okutegeera by’akola,","poem":1},{"text":"naye atalina magezi musirusiru kubanga yeerimba nti amanyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abasirusiru banyooma okugololwa nga bakoze ensobi,","poem":1},{"text":"naye abalongoofu baagala emirembe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Buli mutima gumanya okulumwa kwagwo,","poem":1},{"text":"tewali ayinza kugusanyukirako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ennyumba y’abakozi b’ebibi erizikirizibwa,","poem":1},{"text":"naye eweema y’abatuukirivu erikulaakulana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Waliwo ekkubo erirabika nga ttuufu eri omuntu,","poem":1},{"text":"naye ng’enkomerero yaalyo kufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Enseko zandibaawo naye ng’omutima gujjudde ennaku,","poem":1},{"text":"era n’enkomerero y’essanyu eyinza okufuuka obuyinike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Omuntu atalina kukkiriza alisasulwa empeera emusaanira olw’ebikolwa bye,","poem":1},{"text":"n’omuntu omulungi naye alisasulwa eyiye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ow’amagezi amatono amala gakkiriza buli kigambo ky’awulira,","poem":1},{"text":"naye omuntu omutegeevu yeegendereza amakubo ge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Omuntu ow’amagezi atya Mukama n’aleka okukola ebibi,","poem":1},{"text":"naye omusirusiru yeepankapanka era teyeegendereza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Omuntu asunguwala amangu akola eby’obusirusiru,","poem":1},{"text":"n’omukalabakalaba akyayibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Abatalina magezi basikira butaliimu,","poem":1},{"text":"naye abategeevu batikkirwa engule ey’okumanya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Abakozi b’ebibi balivuunamira abatuukirivu,","poem":1},{"text":"n’aboonoonyi ne bavuunama mu miryango gy’abatuukirivu.","poem":2}]},{"type":"heading","content":["Omugagga n’Omwavu"]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Omwavu alagajjalirwa abantu nga ne muliraanwa we omutwaliddemu,","poem":1},{"text":"naye abagagga baba n’emikwano mingi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Anyooma muliraanwa we akola kibi,","poem":1},{"text":"naye alina omukisa oyo asaasira abaavu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Abateekateeka okukola ebibi, tebawaba?","poem":1},{"text":"Naye okwagala n’amazima binaabeeranga n’abo abateesa okukola obulungi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Buli mulimu ogukolebwa n’amaanyi gubaako amagoba,","poem":1},{"text":"naye okwogera obwogezi kireeta bwavu bwokka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Abagezi bafuna engule ey’obugagga,","poem":1},{"text":"naye obusirusiru bw’abatalina magezi buzaala busirusiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Omujulizi ow’amazima awonya obulamu bw’abantu,","poem":1},{"text":"naye omujulizi ow’obulimba aba mulimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Atya Mukama alina ekiddukiro eky’amaanyi,","poem":1},{"text":"era n’abaana be balibeera n’obuddukiro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Okutya Mukama ye nsulo y’obulamu,","poem":1},{"text":"kuleetera omuntu okwewala emitego gy’okufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ekitiibwa kya kabaka kiri mu kuba n’abantu bangi,","poem":1},{"text":"naye omukulembeze ataba n’abantu abeera mu kabi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Omuntu omugumiikiriza aba n’okutegeera kungi,","poem":1},{"text":"naye oyo asunguwala amangu ayolesa obusirusiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Omutima ogulina emirembe guwangaaza omuntu,","poem":1},{"text":"naye obuggya buvunza amagumba ge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Omuntu atulugunya abaavu anyooma oyo eyabatonda,","poem":1},{"text":"naye buli abakwatirwa ekisa, agulumiza Katonda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Akacwano bwe kajja, omukozi w’ebibi agwa,","poem":1},{"text":"naye omutuukirivu ne mu kufa aba n’obuddukiro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Amagezi gabeera mu mutima gw’omuntu alina okutegeera,","poem":1},{"text":"era yeeyoleka ne mu basirusiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Obutuukirivu buzimba eggwanga,","poem":1},{"text":"naye ekibi kiswaza abantu ab’engeri zonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Kabaka asanyukira omuddu akola eby’amagezi,","poem":1},{"text":"naye obusungu bwa kabaka bunaabuubuukiranga ku oyo akola ebiswaza.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}