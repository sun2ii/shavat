{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PRO","translationId":"lug_bib","name":"Engero","commonName":"Engero","title":"Ekitabo Ekiyitibwa Engero","order":20,"numberOfChapters":31,"sha256":"74bebdc5ccdfc2b9b104ec7fe764cc09b398d5a80da6220ba11f5830f71163ac","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lug_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"Okuddamu n’eggonjebwa kumalawo ekiruyi,","poem":1},{"text":"naye ekigambo eky’obukambwe kisaanuula obusungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Olulimi lw’omugezi lwogera by’amagezi,","poem":1},{"text":"naye akamwa k’abasirusiru kafukumula busirusiru bwereere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Amaaso ga Mukama galaba buli wantu,","poem":1},{"text":"alaba abatuukirivu n’abakozi b’ebibi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Olulimi oluzimba muti gwa bulamu,","poem":1},{"text":"naye olulimi olulimba lubetenta omutima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Omusirusiru anyooma okubuulirirwa kwa kitaawe,","poem":1},{"text":"naye omutegeevu assaayo omwoyo eri okunenyezebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mu nnyumba y’omutuukirivu mubaamu obugagga bungi,","poem":1},{"text":"naye omukozi w’ebibi by’afuna, bimuleetera emitawaana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Akamwa k’amagezi kabunyisa okumanya,","poem":1},{"text":"naye omutima gw’abasirusiru si bwe gukola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ssaddaaka y’aboonoonyi ya muzizo eri Mukama,","poem":1},{"text":"naye okusaba kw’abalongoofu lye ssanyu lye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ekkubo ly’omwonoonyi lya muzizo eri Mukama,","poem":1},{"text":"naye Mukama ayagala oyo anoonya obutuukirivu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Oyo aleka ekkubo ettuufu alikangavvulwa n’amaanyi,","poem":1},{"text":"n’oyo akyawa okunenyezebwa alifa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Okufa n’okuzikirira biri mu maaso ga Mukama,","poem":1},{"text":"n’okulaba alaba nnyo emitima gy’abaana b’abantu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Omunyoomi tayagala kunenyezebwa,","poem":1},{"text":"era teeyeebuuza ku b’amagezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Omutima omusanyufu guleeta essanyu ku maaso,","poem":1},{"text":"naye omutima omunyiikaavu gunafuya emmeeme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Omutima omutegeevu gunoonya okumanya,","poem":1},{"text":"naye akamwa k’abasirusiru kalya busirusiru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Omuntu bw’aba omunyiikaavu, buli kimu kimwononekera,","poem":1},{"text":"naye omutima omusanyufu gujaguza buli kaseera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Okuba n’akatono ng’otya Mukama,","poem":1},{"text":"kusinga okuba n’ebingi naye ng’oli mu mitawaana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Okulya emmere ng’eriko enva endiirwa awali okwagalana,","poem":1},{"text":"kisinga okuliirako ebyassava awali obukyayi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Omuntu asunguwala amangu asaanuula oluyombo,","poem":1},{"text":"naye omugumiikiriza akakkanya embeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ekkubo ly’omugayaavu lijjula amaggwa,","poem":1},{"text":"naye ekkubo ly’omutuukirivu golokofu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Omwana omugezi asanyusa kitaawe,","poem":1},{"text":"naye omuntu omusirusiru anyooma nnyina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Obusirusiru ssanyu eri oyo atalina magezi,","poem":1},{"text":"naye omuntu ategeera atambulira mu kkubo eggolokofu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Awatali kuluŋŋamizibwa entegeka zifa,","poem":1},{"text":"naye awali abawi b’amagezi abangi ziyitamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Okuddamu obulungi kisanyusa,","poem":1},{"text":"era kirungi ekigambo ekirungi okujjira mu kiseera ekituufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ekkubo ery’obulamu liyimusa omugezi,","poem":1},{"text":"ne limuziyiza okukka emagombe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Mukama azikiriza ennyumba y’ab’amalala,","poem":1},{"text":"kyokka akuuma ensalo za nnamwandu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Enkwe za muzizo eri Mukama,","poem":1},{"text":"naye ebigambo ebisaanidde, bimusanyusa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Oyo anoonya okugaggawalira mu bukyamu aleetera ennyumba ye emitawaana,","poem":1},{"text":"naye oyo akyawa enguzi aliba mulamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Omutima gw’omutuukirivu gufumiitiriza bye gunaayanukula,","poem":1},{"text":"naye akamwa k’omwonoonyi kafubutula ebitasaana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Mukama ali wala n’aboonoonyi,","poem":1},{"text":"naye awulira okusaba kw’abatuukirivu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Amaaso agajjudde essanyu gasanyusa omutima,","poem":1},{"text":"n’amawulire amalungi galeetera amagumba obulamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Oyo assaayo omwoyo eri okunenyezebwa okuleeta obulamu,","poem":1},{"text":"alituula wamu n’abagezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Agayaalirira okubuulirirwa yeerumya yekka,","poem":1},{"text":"naye oyo assaayo omwoyo eri okunenyezebwa afuna okutegeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Okutya Mukama kuyigiriza omuntu amagezi,","poem":1},{"text":"n’obwetoowaze kye kitiibwa ky’omuntu oyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}