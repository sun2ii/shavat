{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PRO","translationId":"lug_bib","name":"Engero","commonName":"Engero","title":"Ekitabo Ekiyitibwa Engero","order":20,"numberOfChapters":31,"sha256":"74bebdc5ccdfc2b9b104ec7fe764cc09b398d5a80da6220ba11f5830f71163ac","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lug_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"Okulya akamere akaluma awali emirembe,","poem":1},{"text":"kisinga okuba mu nnyumba ejjudde ebyassava nga mulimu entalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Omuddu omugezi alifuga omwana wa bowo akwasa ensonyi,","poem":1},{"text":"era alifuna ebyobusika ng’omu ku baana b’awaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Entamu erongoosa yakolebwa lwa ffeeza, n’ekikoomi ky’okulongoosa lwa zaabu,","poem":1},{"text":"naye Mukama agezesa emitima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Omubi assaayo omwoyo eri eby’obulimba,","poem":1},{"text":"era n’omulimba awuliriza olulimi olukuusa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Oyo akudaalira omwavu avvoola eyamutonda,","poem":1},{"text":"n’oyo asanyukira obuyinike bw’abalala talirema kubonerezebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Abazzukulu ngule ya bajjajjaabwe,","poem":1},{"text":"era n’abaana beenyumiririza mu bakadde baabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Enjogerannungi teba ya musirusiru,","poem":1},{"text":"ng’oweekitiibwa bw’atasaana kwogera bya bulimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Enguzi eri ng’ejjinja ery’omufuusa mu maaso g’oyo agigaba,","poem":1},{"text":"alowooza nti buli gy’akyukira eneemuyamba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Okwagala tekulondoola nsobi,","poem":1},{"text":"naye oyo atasonyiwa nsobi akyawaganya ab’omukwano enfirabulago.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Okunenya kuyamba nnyo omuntu ategeera,","poem":1},{"text":"okusinga okukuba omusirusiru embooko ekikumi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Omukozi w’ebibi anoonya bujeemu bwereere,","poem":1},{"text":"era kyaliva asindikirwa omubaka omukambwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Okusisinkana eddubu enyagiddwako abaana baayo,","poem":1},{"text":"kisinga okusisinkana omusirusiru mu busirusiru bwe.","poem":2}]},{"type":"heading","content":["Ebbeeyi y’Amagezi"]},{"type":"verse","number":13,"content":[{"text":"Omuntu bw’asasula ekibi olw’obulungi,","poem":1},{"text":"ekibi tekiriva mu nnyumba ye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Okutandika oluyombo kuli ng’omuntu bw’asumulula omudumu gw’amazzi,","poem":1},{"text":"noolwekyo vvaawo ng’oluyombo terunnatandika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Eyejjeereza omukozi w’ebibi n’oyo avumirira omutuukirivu,","poem":1},{"text":"bombi ba muzizo eri Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Omusirusiru agasibwa ki okuba ne ssente ezisasulibwa amagezi,","poem":1},{"text":"ng’ate ye talina mutima gwegomba magezi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Omukwano ogw’amagezi guba gwa lubeerera,","poem":1},{"text":"era owooluganda yeesigibwa mu biro eby’ennaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Omuntu atalina magezi awa obweyamo","poem":1},{"text":"ne yeetema okusasula amabanja ga muliraanwa we.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Oyo ayagala ekibi anyumirwa ennyombo,","poem":1},{"text":"n’oyo akola omulyango omunene ogw’omu maaso gwa bbugwe ye nga guyitiridde obunene gulimuteganya nnyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Omuntu ow’omutima omubambaavu takulaakulana,","poem":1},{"text":"n’oyo ow’olulimi olulimba agwa mu katyabaga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Omwana omusirusiru aleetera kitaawe obuyinike,","poem":1},{"text":"kitaawe w’omusirusiru taba na ssanyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Omutima ogw’essanyu ddagala ddungi,","poem":1},{"text":"naye omwoyo omunyiikaavu gukozza omubiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Omuntu omubi alya enguzi mu kyama,","poem":1},{"text":"alyoke aziyize amazima okweyoleka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Omuntu omutegeevu, ebirowoozo abissa eri amagezi,","poem":1},{"text":"naye amaaso g’omusirusiru gasamaalirira ensi gy’ekoma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Omwana omusirusiru buyinike eri kitaawe,","poem":1},{"text":"era aleeta ennaku eri nnyina eyamuzaala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Si kirungi okuweesa omutuukirivu engassi ey’obwereere","poem":1},{"text":"wadde okukuba ab’ekitiibwa embooko olw’obwesimbu bwabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Omuntu omwegendereza mu bigambo bye abeera n’okutegeera,","poem":1},{"text":"n’oyo alina omwoyo omuteefu aba muntu wa magezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Omusirusiru bw’asirika alowoozebwa okuba n’amugezi,","poem":1},{"text":"era aba mutegeevu bw’afuga akamwa ke.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PRO/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/16.json","previousChapterAudioLinks":{},"numberOfVerses":28}