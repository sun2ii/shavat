{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PRO","translationId":"lug_bib","name":"Engero","commonName":"Engero","title":"Ekitabo Ekiyitibwa Engero","order":20,"numberOfChapters":31,"sha256":"74bebdc5ccdfc2b9b104ec7fe764cc09b398d5a80da6220ba11f5830f71163ac","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lug_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":18,"content":[{"type":"heading","content":["Ebigambo by’Abagezi n’Abasirusiru"]},{"type":"verse","number":1,"content":[{"text":"Eyeggya ku banne aba yeerowoozako yekka,","poem":1},{"text":"era tawuliriza magezi gamuweebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Omusirusiru tasanyukira kutegeera,","poem":1},{"text":"ky’asanyukira kyokka kwe kwogera by’alowooza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Okukola ekibi bwe kujja n’okunyooma kujjirako,","poem":1},{"text":"era awali okuyisaamu omuntu amaaso wabaawo okunyoomoola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ebigambo by’omu kamwa k’omuntu mazzi ga buziba,","poem":1},{"text":"naye ensulo ey’amagezi mugga ogukulukuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Si kirungi kuttira mubi ku liiso,","poem":1},{"text":"oba okusaliriza omutuukirivu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Akamwa k’omusirusiru kamuleetera entalo","poem":1},{"text":"era akamwa ke kamuleetera okukubwa emiggo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Akamwa k’omusirusiru ke kamuleetera okuzikirira,","poem":1},{"text":"era n’emimwa gye mutego eri emmeeme ye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ebigambo by’omuntu ageya biri ng’emmere ewoomerera,","poem":1},{"text":"bigenda mu bitundu by’omubiri eby’ewala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Omuntu omugayaavu mu mirimu gy’akola,","poem":1},{"text":"waluganda n’oyo azikiriza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Erinnya lya Mukama kigo ky’amaanyi,","poem":1},{"text":"omutuukirivu addukira omwo n’afuna emirembe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Obugagga bw’omugagga, kye kibuga kye ekiriko bbugwe ow’amaanyi,","poem":1},{"text":"era mu kulaba kwe, kigo kye ekigumu ekitarinnyika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Omuntu nga tannagwa, omutima gwe gwegulumiza, naye okwetoowaza kumuweesa ekitiibwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Oyo addamu amangu mu nsonga gy’ateetegerezza,","poem":1},{"text":"buba busirusiru bwe era buswavu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Omwoyo gw’omuntu gumuwanirira mu bulwadde,","poem":1},{"text":"naye emmeeme eyennyise ani ayinza okugigumiikiriza?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Omutima gw’omwegendereza guyiga okumanya,","poem":1},{"text":"amatu g’omuntu omugezi gawuliriza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ekirabo ky’omuntu kimuseguliza,","poem":1},{"text":"era kimutuusa ne mu maaso g’abeekitiibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Asooka okweyogerako y’afaanana ng’omutuufu,","poem":1},{"text":"okutuusa omulala lw’amubuuza ebibuuzo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Okukuba akalulu kimalawo empaka,","poem":1},{"text":"era kisalawo eggoye wakati w’abawakana ab’amaanyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kyangu okuwamba ekibuga ekiriko bbugwe ow’amaanyi, okusinga okukomyawo owooluganda anyiize,","poem":1},{"text":"era ennyombo ziba ng’empagi z’ekigo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Omuntu anakkutanga ebigambo ebiva mu kamwa ke;","poem":1},{"text":"ebibala ebijjula akamwa ke bye binamukkusanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Olulimi lulina obuyinza okuwa obulamu oba okutta,","poem":1},{"text":"era n’abo abalwagala balirya ebibala byalwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Azuula omukazi omulungi ow’okuwasa aba azudde ekirungi,","poem":1},{"text":"era aganja eri Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Omwavu yeegayirira,","poem":1},{"text":"naye omugagga addamu na bbogo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Akwana emikwano emingi yeereetera okuzikirira,","poem":1},{"text":"naye wabaawo ow’omukwano akwagala ennyo okusinga owooluganda.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}