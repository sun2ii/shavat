{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PRO","translationId":"lug_bib","name":"Engero","commonName":"Engero","title":"Ekitabo Ekiyitibwa Engero","order":20,"numberOfChapters":31,"sha256":"74bebdc5ccdfc2b9b104ec7fe764cc09b398d5a80da6220ba11f5830f71163ac","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lug_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":2,"content":[{"type":"heading","content":["Empeera y’Okunoonya Amagezi"]},{"type":"verse","number":1,"content":[{"text":"Mwana wange, bw’onookwatanga ebigambo byange,","poem":1},{"text":"n’otereka ebiragiro byange mu bulamu bwo,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"era n’ossaayo omwoyo eri amagezi,","poem":1},{"text":"era n’ossa omutima gwo eri okutegeera,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ddala ddala singa oyaayaanira okumanya","poem":1},{"text":"era n’oyimusa eddoboozi lyo osabe okutegeera,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"bw’onooganoonyanga nga ffeeza,","poem":1},{"text":"era n’oganoonyanga ng’ekyobugagga ekyakwekebwa,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"awo w’olitegeerera okutya Mukama,","poem":1},{"text":"era n’ovumbula okumanya Katonda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kubanga Mukama awa amagezi;","poem":1},{"text":"era mu kamwa ke muvaamu okumanya n’okutegeera.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mukama aterekera abatuukirivu amagezi amalungi,","poem":1},{"text":"era aba ngabo y’abo abatambulira mu bugolokofu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abatambuliza mu makubo ag’obwenkanya,","poem":1},{"text":"era bw’atyo Mukama akuuma ekkubo ly’abatukuvu be.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Olwo lw’olitegeera obutuukirivu, amazima n’obwenkanya;","poem":1},{"text":"weewaawo buli kkubo eddungi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kubanga amagezi galiyingira mu mutima gwo,","poem":1},{"text":"n’okumanya kulisanyusa omwoyo gwo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Okwesalirawo obulungi kunaakulabiriranga","poem":1},{"text":"n’okutegeera kunaakukuumanga:","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Amagezi ganaakuwonyanga ekkubo ly’omubi,","poem":1},{"text":"n’abantu aboogera eby’obugwagwa,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"abaleka amakubo ag’obutuukirivu","poem":1},{"text":"ne batambulira mu makubo ag’ekizikiza,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"abasanyukira okukola ebikolwa ebibi,","poem":1},{"text":"abanyumirwa eby’obusirusiru,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"abantu abo be b’amakubo amakyamu,","poem":1},{"text":"era abakujjukujju mu ngeri zaabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Amagezi Mukama g’awa ge gokka agajja okukuwonya ekkubo ly’omukazi omwenzi,","poem":1},{"text":"n’okukuwonya ebigambo bye ebisendasenda,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"eyaleka bba ow’omu buvubuka bwe","poem":1},{"text":"era eyeerabira endagaano gye yakola mu maaso ga Katonda we.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kubanga ennyumba ye ekka mu kufa,","poem":1},{"text":"n’amakubo ge galaga eri abafu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tewali n’omu agenda ewuwe adda","poem":1},{"text":"wadde okufunirayo amakubo g’obulamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kale tambuliranga mu kkubo ly’abo abatya Katonda","poem":1},{"text":"era onywerere mu makubo g’abatuukirivu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kubanga abatuukirivu balituula mu nsi,","poem":1},{"text":"era abo abagolokofu baligisigalamu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Naye abakozi b’ebibi balifiirwa ebirungi eby’ensi,","poem":1},{"text":"n’abatali beesigwa balizikirizibwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}