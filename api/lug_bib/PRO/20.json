{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PRO","translationId":"lug_bib","name":"Engero","commonName":"Engero","title":"Ekitabo Ekiyitibwa Engero","order":20,"numberOfChapters":31,"sha256":"74bebdc5ccdfc2b9b104ec7fe764cc09b398d5a80da6220ba11f5830f71163ac","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lug_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"Omwenge mukudaazi, ekitamiiza muleekaanyi,","poem":1},{"text":"era buli alaga mu kkubo ekyamu olw’ebyo talina magezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Obusungu bwa kabaka buli ng’okuwuluguma kw’empologoma,","poem":1},{"text":"n’oyo amusunguwaza yeefiiriza bulamu bwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kya kitiibwa omuntu okwewala entalo,","poem":1},{"text":"naye buli musirusiru ayagala okuyomba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Omugayaavu talima mu budde butuufu,","poem":1},{"text":"kyanaavanga anoonya eby’amakungula nga talina kantu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ebigendererwa ebiba mu mutima gw’omuntu biba ng’amazzi ag’ebuziba,","poem":1},{"text":"naye omuntu alina okutegeera alibiggyayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Abantu bangi bagamba nti balina okwagala okutaggwaawo,","poem":1},{"text":"naye ani ayinza okuzuula omuntu omwesigwa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Omuntu omutuukirivu, atambulira mu bulamu obutaliiko kyakunenyezebwa;","poem":1},{"text":"ba mukisa abaana be abalimuddira mu bigere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kabaka bw’atuula ku ntebe ye ey’obwakabaka ng’asala emisango,","poem":1},{"text":"amaaso ge gasunsulamu ne gaggyamu ebibi byonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ani ayinza okugamba nti, “Ntukuzza omutima gwange,","poem":1},{"text":"ndi mulongoofu era sirina kibi?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ebipima obuzito ebitatuuka n’ebigera ebikyamu,","poem":1},{"text":"byombi bya muzizo eri Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Omuvubuka naye amanyibwa olw’ebikolwa bye,","poem":1},{"text":"obanga birongoofu era nga birungi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Okutu okuwulira n’eriiso eriraba","poem":1},{"text":"byombi Mukama ye y’abikola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Toyagalanga kwebaka oleme kwavuwala,","poem":1},{"text":"tunula, obeerenga n’ebyokulya bingi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Si kirungi, si kirungi,” bw’ayogera agula;","poem":1},{"text":"naye bw’agenda n’alyoka yeenyumiririza mu ky’aguze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Zaabu n’amayinja ag’omuwendo weebiri,","poem":1},{"text":"naye emimwa egyogera eby’amagezi kye ky’omuwendo ekisingako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Omuntu bw’aleeta ekyambalo kye ne yeeyimiririra gw’atamanyi,","poem":1},{"text":"kitwalire ddala, na ddala bw’abanga yeeyimiririra omukazi omubambaavu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Emmere enfune mu bukyamu ewooma mu kulya,","poem":1},{"text":"naye emufuukira amayinja mu kamwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kola entegeka nga weebuuza ku magezi,","poem":1},{"text":"bw’oba onoolangirira olutalo sooka weebuuze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Oyo agenda ng’asaasaanya olugambo abotola ebyama,","poem":1},{"text":"noolwekyo weewale omuntu ayogerayogera ennyo ebitaliimu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Omuntu akolimira kitaawe oba nnyina,","poem":1},{"text":"ettabaaza ye erizikizibwa n’asigala mu kizikiza ekikutte ennyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Eby’obusika ebifune ng’ekiseera kyabyo tekinnatuuka,","poem":1},{"text":"ku nkomerero tebiba na mukisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Toyogera nti, “Nzija kukusasula olw’ekibi kino!”","poem":1},{"text":"Lindirira Mukama alikuyamba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ebipima ebikyamu bya muzizo eri Mukama,","poem":1},{"text":"ne minzaani ez’obulimba tezisanyusa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Amakubo g’omuntu gategekebwa Mukama,","poem":1},{"text":"omuntu ayinza atya okutegeera ekkubo lya Mukama?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Kyambika eri omuntu okwanguyiriza okweyama eri Mukama,","poem":1},{"text":"naye oluvannyuma n’afumiitiriza ku bye yeeyamye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Kabaka omugezi asengejja n’aggyamu abakozi b’ebibi,","poem":1},{"text":"n’ababonereza awatali kusaasira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ettabaaza ya Mukama ekebera omwoyo gw’omuntu,","poem":1},{"text":"n’enoonya mu bitundu eby’omunda ennyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Okwagala n’obwesigwa bikuuma kabaka mu butebenkevu,","poem":1},{"text":"era obufuzi bwe bunywezebwa na kwagala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Amaanyi kye kitiibwa ky’abavubuka,","poem":1},{"text":"envi kye kitiibwa ky’abakadde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Emiggo n’ebiwundu biggyawo ebibi,","poem":1},{"text":"n’embooko zitereeza ebifo eby’omunda ennyo.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":30}