{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PRO","translationId":"lug_bib","name":"Engero","commonName":"Engero","title":"Ekitabo Ekiyitibwa Engero","order":20,"numberOfChapters":31,"sha256":"74bebdc5ccdfc2b9b104ec7fe764cc09b398d5a80da6220ba11f5830f71163ac","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lug_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"Omutima gwa kabaka guli ng’amazzi agakulukutira mu mukono gwa Mukama,","poem":1},{"text":"era agukyusiza gy’ayagala yonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Buli kkubo lya muntu liba ng’ettuufu mu maaso ge,","poem":1},{"text":"naye Mukama apima omutima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Okukola ebituufu n’eby’amazima","poem":1},{"text":"kisanyusa Mukama okusinga ssaddaaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Amaaso ageegulumiza, n’omutima ogw’amalala,","poem":1},{"text":"ye ttabaaza y’ababi, era ebyo kwonoona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Enteekateeka z’omunyiikivu zivaamu magoba meereere,","poem":1},{"text":"naye okwanguyiriza okutalina nteekateeka kuvaamu bwavu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Okufuna obugagga n’olulimi olulimba,","poem":1},{"text":"mpewo buwewo etwalibwa eruuyi n’eruuyi era mutego gwa kufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Obukambwe bw’ababi bulibamalawo,","poem":1},{"text":"kubanga bagaana okukola eby’ensonga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ekkubo ly’abazza emisango liba kyamu,","poem":1},{"text":"naye ery’abataliiko musango liba golokofu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Okusula ku kasolya k’ennyumba,","poem":1},{"text":"kisinga okubeera mu nnyumba n’omukazi omuyombi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Emmeeme y’omubi yeegomba okukola ebibi;","poem":1},{"text":"talaga muliraanwa we kisa n’akatono.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Omukudaazi bw’abonerezebwa, atalina magezi agafuna;","poem":1},{"text":"n’ow’amagezi bw’ayigirizibwa afuna okutegeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Katonda alaba ebifa mu nnyumba y’omubi,","poem":1},{"text":"era abakozi b’ebibi abazikkiririza ddala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Oyo aziba amatu ge eri okulaajana kw’omwavu,","poem":1},{"text":"naye alikoowoola nga talina amwanukula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ekirabo ekigabire mu kyama kikakkanya obusungu obungi,","poem":1},{"text":"n’enguzi ebikiddwa mu munagiro eggyawo ekiruyi ekingi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ensonga bwe zisalibwa mu bwenkanya, lye ssanyu eri abatuukirivu,","poem":1},{"text":"naye kiba kyekango eri abakozi b’ebibi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Omuntu awaba okuva mu kkubo ly’okutegeera,","poem":1},{"text":"agukira mu bafu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Aganza eby’amasanyu anaabanga mwavu, n’oyo","poem":1},{"text":"ayagala omwenge n’amafuta taligaggawala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Abakozi b’ebibi batuukibwako emitawaana egyandigudde ku balungi,","poem":1},{"text":"n’ekyandituuse ku b’amazima kituuka ku batali beesigwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Okubeera mu ddungu,","poem":1},{"text":"kisinga okubeera n’omukazi omuyombi anyiiganyiiga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mu nnyumba y’omutuukirivu mubaamu eby’obugagga eby’omuwendo,","poem":1},{"text":"naye omusirusiru ebibye byonna abyonoona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Agoberera obutuukirivu n’ekisa,","poem":1},{"text":"alibeera n’obulamu obukulaakulana n’ekitiibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Omuntu ow’amagezi alumba ekibuga eky’abazira nnamige,","poem":1},{"text":"era n’asesebbula enfo yaabwe gye beesiga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Afuga akamwa ke n’olulimi lwe,","poem":1},{"text":"yeewoonya emitawaana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Mukudaazi,” lye linnya ly’ab’amalala abeeraga,","poem":1},{"text":"abeetwalira mu kwemanya okw’ekitalo mwe batambulira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Okwetaaga kw’omugayaavu lwe luliba olumbe lwe,","poem":1},{"text":"kubanga emikono gye tegyagala kukola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Olunaku lwonna aba yeegomba kweyongezaako,","poem":1},{"text":"naye omutuukirivu agaba awatali kwebalira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ssaddaaka y’omubi ya muzizo,","poem":1},{"text":"na ddala bw’agireeta ng’alina ekigendererwa ekitali kirungi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Omujulizi ow’obulimba alizikirira,","poem":1},{"text":"naye ekigambo ky’oyo ayogera eby’amazima kiribeerera emirembe gyonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Omuntu omubi yeekazaakaza,","poem":1},{"text":"naye omuntu ow’amazima yeegendereza amakubo ge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Tewali magezi, newaakubadde okutegeera, wadde ebiteeso","poem":1},{"text":"ebiyinza okulemesa Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Embalaasi etegekerwa olunaku olw’olutalo,","poem":1},{"text":"naye obuwanguzi buva eri Mukama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}