{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PRO","translationId":"lug_bib","name":"Engero","commonName":"Engero","title":"Ekitabo Ekiyitibwa Engero","order":20,"numberOfChapters":31,"sha256":"74bebdc5ccdfc2b9b104ec7fe764cc09b398d5a80da6220ba11f5830f71163ac","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lug_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":22,"content":[{"type":"heading","content":["Omugaso gw’Erinnya Eddungi"]},{"type":"verse","number":1,"content":[{"text":"Erinnya eddungi lyagalibwa okusinga eby’obugagga ebingi,","poem":1},{"text":"n’okuganja kusinga ffeeza oba zaabu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Abagagga n’abaavu balina kimu ekibagatta,","poem":1},{"text":"Mukama ye Mutonzi waabwe bonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Omuntu omutegeevu bw’alaba akabi yeekweka,","poem":1},{"text":"naye abatalina magezi bagenda bugenzi mu maaso ne balumizibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Obugagga n’ekitiibwa n’obulamu","poem":1},{"text":"y’empeera ey’okwetoowazanga n’okutyanga Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Amaggwa n’emitego biri mu kkubo ly’omubambaavu;","poem":1},{"text":"naye oyo akuuma emmeeme ye anaabyewalanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Manyiiriza omwana mu kkubo erimugwanira okutambulirangamu,","poem":1},{"text":"ne bw’alikula talirivaamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Omugagga afuga abaavu,","poem":1},{"text":"naye eyeewola aba muddu w’oyo amuwola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Asiga obutali butuukirivu akungula mitawaana,","poem":1},{"text":"n’oluga olw’obusungu bwe lulizikirizibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Omuntu omugabi anaabanga n’omukisa,","poem":1},{"text":"kubanga emmere ye agirya n’abaavu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Goba omunyoomi, entalo zinaagenda,","poem":1},{"text":"ennyombo n’okuvumagana binaakoma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Omuntu eyeegomba omutima omulongoofu","poem":1},{"text":"era ayogera n’eggonjebwa, talirema kuganja ewa kabaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Amaaso ga Mukama galabirira amazima,","poem":1},{"text":"era adibya entegeka z’abatali beesigwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Omugayaavu ayogera nti, “Ebweru eriyo empologoma,”","poem":1},{"text":"oba nti, “Nnyinza okutemulirwa mu kkubo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Malaaya mutego gwa kabi,","poem":1},{"text":"akolimiddwa Mukama mw’afiira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Obusirusiru busibiddwa ku mutima gw’omwana omuto,","poem":1},{"text":"naye omuggo ogukangavvula gulimuwonyeza ddala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Omuntu atulugunya abaavu ne yeeyongera okugaggawala,","poem":1},{"text":"n’oyo agabira omugagga awa abagagga enguzi, enkomerero ya bombi bwavu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ossangayo omwoyo okuwuliriza ebigambo by’omugezi,","poem":1},{"text":"n’omutima gwo eri ebyo bye njigiriza.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kibeera kya ssanyu bw’obikwata ku mutima gwo,","poem":1},{"text":"n’oba mwetegefu okubiddamu byonna.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mbikumanyisa leero ggwe,","poem":1},{"text":"obwesige bwo bubeerenga mu Mukama.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kale sikuwandiikidde ebintu amakumi asatu ebikuwabula","poem":1},{"text":"era ebikuwa okumanya?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Sikulaze ekirungi n’ekituufu,","poem":1},{"text":"olyoke obe n’eky’okuddamu eri oyo eyakutuma?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Tonyaganga mwavu, kubanga mwavu,","poem":1},{"text":"oba okutulugunyanga aleeteddwa mu mbuga.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kubanga Mukama alibawolereza,","poem":1},{"text":"n’abo ababanyaga alibanyaga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Tokwananga muntu wa busungu,","poem":1},{"text":"oba okuyitanga n’omuntu anyiiganyiiga amangu,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"oleme okuyiga amakubo ge","poem":1},{"text":"ne weesuula mu mitawaana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Teweegattanga ku abo abeeyama,","poem":1},{"text":"newaakubadde ku abo abeeyimirira ab’amabanja.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bw’oliba nga tolina kya kusasula","poem":1},{"text":"ekitanda kyo kyennyini kye kirikuggyibwako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Tojjululanga nsalo","poem":1},{"text":"bajjajjaabo gye bassaawo edda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Omanyi omuntu omunyiikivu era omukugu mu mulimu gwe?","poem":1},{"text":"Aliweereza bakabaka; taliweereza bantu batamanyiddwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}