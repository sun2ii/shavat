{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PRO","translationId":"lug_bib","name":"Engero","commonName":"Engero","title":"Ekitabo Ekiyitibwa Engero","order":20,"numberOfChapters":31,"sha256":"74bebdc5ccdfc2b9b104ec7fe764cc09b398d5a80da6220ba11f5830f71163ac","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lug_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"Bw’otuulanga okulya n’omufuzi,","poem":1},{"text":"weetegerezanga ebiri mu maaso go;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"era weegendereze","poem":1},{"text":"bw’obanga omanyi ng’olulunkanira ebyokulya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tolulunkanira mmere ye ennungi,","poem":1},{"text":"kubanga erimbalimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Teweemalangako mirembe ng’oyaayaanira obugagga;","poem":1},{"text":"weefuge obeere mukkakkamu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eby’obugagga obikubako eriiso limu nga by’agenze dda,","poem":1},{"text":"kubanga ddala bimera ebiwaawaatiro","poem":2},{"lineBreak":true},{"text":"ne bibuuka mu bbanga ng’empungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tolyanga mmere ya muntu mukodo,","poem":1},{"text":"wadde okwegomba ebirungi by’alya.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kubanga ye muntu","poem":1},{"text":"abalirira ensimbi z’asaasaanyizza,","poem":2},{"lineBreak":true},{"text":"n’akugamba nti, “Weeriire, weenywere,”","poem":2},{"lineBreak":true},{"text":"naye ng’omutima gwe tegukusanyukira.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Akatono k’onooba olidde onookasesema,","poem":1},{"text":"ebigambo byo ebirungi eby’okwebaza bibe bya bwereere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Totegana kubuulirira musirusiru,","poem":1},{"text":"kubanga ajja kunyooma ebigambo byo eby’amagezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tojjululanga nsalo ey’edda,","poem":1},{"text":"so toyingiriranga nnimiro za bamulekwa,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"kubanga abalwanirira w’amaanyi,","poem":1},{"text":"alikuggulako omusango.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ossangayo omwoyo eri okuyigirizibwa,","poem":1},{"text":"n’amatu go eri ebigambo by’okutegeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tolekangayo kukangavvula mwana,","poem":1},{"text":"bw’omubonereza n’akaggo tekimutta.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mubonerezenga n’akaggo,","poem":1},{"text":"kiwonye emmeeme ye okufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mwana wange, bw’oba n’omutima ogw’amagezi,","poem":1},{"text":"kinsanyusa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nnaajjaguzanga okuva ku ntobo y’omutima gwange,","poem":1},{"text":"bw’onooyogeranga ebituufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Omutima gwo gulemenga okukwatirwa aboonoonyi obuggya,","poem":1},{"text":"kyokka nyiikira okutya Mukama ebbanga lyonna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mazima ddala onoobanga n’essuubi mu biseera eby’omu maaso,","poem":1},{"text":"n’essuubi lyo eryo teririggwaawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mwana wange wulirizanga, obeerenga n’amagezi,","poem":1},{"text":"okumenga omutima gwo mu kkubo ettuufu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Teweegattanga ku abo abeekamirira omwenge,","poem":1},{"text":"n’abalulunkanira ennyama:","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kubanga omutamiivu n’omuluvu baavuwala,","poem":1},{"text":"n’okubongoota olutata kubambaza enziina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Wulirizanga kitaawo eyakuzaala,","poem":1},{"text":"so togayanga nnyoko ng’akaddiye.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Gula amazima so togatunda,","poem":1},{"text":"ffuna amagezi, n’okuyigirizibwa n’okutegeera.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kitaawe w’omutuukirivu alina essanyu lingi,","poem":1},{"text":"n’oyo azaala omwana ow’amagezi amwenyumiririzaamu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Leka kitaawo ne nnyoko basanyuke,","poem":1},{"text":"omukazi eyakuzaala ajaguzenga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Mwana wange mpa omutima gwo,","poem":1},{"text":"n’amaaso go geekalirize amakubo gange,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"kubanga omukazi omwenzi lukonko luwanvu,","poem":1},{"text":"n’omukazi omubambaavu luzzi lufunda.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ateega ng’omutemu,","poem":1},{"text":"n’ayongera ku muwendo gw’abasajja abatali beesigwa eri bakazi baabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ani alina obuyinike? Ani alina ennaku?","poem":1},{"text":"Ani alina ennyombo? Ani alina okwemulugunya?","poem":2},{"lineBreak":true},{"text":"Ani alina ebiwundu eby’obwereere? Ani amyuse amaaso?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Abo abatava ku mwenge,","poem":1},{"text":"nga bagenda baloza ku mwenge omutabule.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Totunuulira wayini ng’amyuse,","poem":1},{"text":"bw’atemaganira mu ggiraasi","poem":2},{"lineBreak":true},{"text":"ng’akka empolampola;","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ku nkomerero aluma ng’omusota,","poem":1},{"text":"wa busagwa ng’essalambwa.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Amaaso go galiraba ebyewuunyo,","poem":1},{"text":"n’omutwe gwo ne gulowooza ebitategeerekeka.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Oliba ng’omuntu eyeebase wakati mu nnyanja,","poem":1},{"text":"obanga oyo alengejjera waggulu ku mulongooti.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Olyogera nti, “Bankubye, naye sirumiddwa.","poem":1},{"text":"Bankubye naye sirina kye mpuliddemu.","poem":2},{"text":"Nnaazuukuka ddi,","poem":1},{"text":"neeyongere okunywa?”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}