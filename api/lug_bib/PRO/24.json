{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PRO","translationId":"lug_bib","name":"Engero","commonName":"Engero","title":"Ekitabo Ekiyitibwa Engero","order":20,"numberOfChapters":31,"sha256":"74bebdc5ccdfc2b9b104ec7fe764cc09b398d5a80da6220ba11f5830f71163ac","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lug_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"Teweegombanga bakozi ba bibi","poem":1},{"text":"era tobeesemberezanga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kubanga emitima gyabwe giteesa kukola bya butemu,","poem":1},{"text":"era akamwa kaabwe koogera ku kukola bya ffujjo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Amagezi ge gazimba ennyumba,","poem":1},{"text":"n’okutegeera kwe kugiggumiza.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Olw’amagezi ebisenge by’ayo bijjula ebintu ebirungi,","poem":1},{"text":"eby’obugagga ebitalabikalabika eby’omuwendo omungi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Omuntu ow’amagezi aba n’obuyinza,","poem":1},{"text":"n’omuntu alina okumanya yeeyongera amaanyi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kubanga okulwana olutalo weetaaga okuluŋŋamizibwa,","poem":1},{"text":"n’okuluwangula, weetaaga abawi b’amagezi bangi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Amagezi gasukkirira nnyo omusirusiru,","poem":1},{"text":"talina ky’asobola kwogera mu lukuŋŋaana olw’oku wankaaki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Oyo asala enkwe ez’okukola ebibi,","poem":1},{"text":"aliyitibwa mukujjukujju.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Entegeka ez’obusirusiru muvaamu kwonoona,","poem":1},{"text":"abantu beetamwa omukudaazi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bw’oyongobera mu kiseera eky’ebizibu,","poem":1},{"text":"olwo ng’olina amaanyi matono!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Odduukiriranga n’owonya abo abatwalibwa okuttibwa,","poem":1},{"text":"n’abo abali ku njegoyego z’okuttibwa, obawonye okuttirwa obwemage.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bw’ogambanga nti, “Laba kino twali tetukimanyi,”","poem":1},{"text":"oyo akebera emitima aba talaba?","poem":2},{"text":"Oyo akuuma obulamu bwo takimanyi?","poem":1},{"text":"Talisasula buli muntu ng’omulimu gwe bwe guli?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mwana wange olyanga omubisi gw’enjuki kubanga mulungi,","poem":1},{"text":"omubisi oguva mu bisenge byagwo guwoomerera.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Era manya nti amagezi gawoomera emmeeme yo,","poem":1},{"text":"bw’onoogafuna onoobeera n’essuubi mu bulamu obw’omu maaso,","poem":2},{"lineBreak":true},{"text":"n’essuubi lyo teririkoma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Toteeganga, ng’omunyazi bw’akola ku nnyumba y’omutuukirivu,","poem":1},{"text":"tonyaganga maka ge.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Omuntu omutuukirivu ne bw’agwa emirundi omusanvu, addamu n’ayimuka,","poem":1},{"text":"naye abakozi b’ebibi basuulibwa mu mitawaana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tosanyukanga ng’omulabe wo agudde,","poem":1},{"text":"bwe yeesittalanga omutima gwo gulemenga okujaguza.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Si kulwa nga Mukama akiraba ne kitamusanyusa,","poem":1},{"text":"n’amusunguwalira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Teweeraliikiriranga olw’abo abakola ebibi,","poem":1},{"text":"so abakozi b’ebibi tobakwatirwanga buggya.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kubanga omuntu omubi talina ssuubi mu maaso,","poem":1},{"text":"ettabaaza y’abakozi b’ebibi erizikizibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mwana wange otyanga Mukama, ne kabaka,","poem":1},{"text":"era teweetabanga na bajeemu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kubanga obusungu bwabwe bulibuubuukira ku bajeemu","poem":1},{"text":"era ani amaanyi akabi akalibatuukako?","poem":2}]},{"type":"heading","content":["Ebigambo Eby’amagezi"]},{"type":"verse","number":23,"content":[{"text":"Bino nabyo era bigambo by’abalina amagezi.","poem":1},{"text":"Okwekubiira ng’osala emisango si kirungi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kale oyo agamba azizza omusango nti, “Toliiko ky’ovunaanibwa,”","poem":1},{"text":"abantu banaamukolimiranga, n’amawanga ganaamwetamwanga.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Naye abo abasalira omusobya omusango ne gumusinga banaabanga n’essanyu,","poem":1},{"text":"n’omukisa omulungi gulibatuukako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Eky’okuddamu eky’amazima,","poem":1},{"text":"kiri ng’okunywegerwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Malirizanga omulimu gwo ogw’ebweru,","poem":1},{"text":"oteeketeeke ennimiro zo,","poem":2},{"lineBreak":true},{"text":"n’oluvannyuma olyoke weezimbire ennyumba yo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Towanga bujulizi bwa bulimba ku muliraanwa wo,","poem":1},{"text":"so akamwa ko tekalimbanga.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Toyogeranga nti, “Omuntu oyo ndimukola nga bw’ankoze,","poem":1},{"text":"era ndimusasuza nga bw’ampisizza.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Nayita ku nnimiro ey’omugayaavu,","poem":1},{"text":"ne mpita ne ku nnimiro y’emizabbibu ey’oyo atalina kutegeera.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kale laba, ng’ennimiro eyo ebunye amaggwa,","poem":1},{"text":"wansi wonna nga wabikkiddwa omuddo,","poem":2},{"lineBreak":true},{"text":"n’olukomera lwayo olw’amayinja nga lugudde.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ne neekaliriza ne ntegeera","poem":1},{"text":"ne nfuna ekyokuyiga mu bye nalaba.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Otulo otutonotono, n’okusumagira akatono,","poem":1},{"text":"n’okufunya emikono okuwummulako,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"obwavu bulikutuukako ng’omutemu,","poem":1},{"text":"era n’obwetaavu ng’omutemu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}