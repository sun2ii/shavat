{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PRO","translationId":"lug_bib","name":"Engero","commonName":"Engero","title":"Ekitabo Ekiyitibwa Engero","order":20,"numberOfChapters":31,"sha256":"74bebdc5ccdfc2b9b104ec7fe764cc09b398d5a80da6220ba11f5830f71163ac","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lug_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":27,"content":[{"type":"heading","content":["Amagezi aga Leero n’Ebiseera eby’omu mu Maaso"]},{"type":"verse","number":1,"content":[{"text":"Teweenyumirizanga mu bya nkya,","poem":1},{"text":"kubanga olunaku bye lunaaleeta tobimanyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Leka omulala akutenderezenga so si kamwa ko ggwe,","poem":1},{"text":"omuntu omulala so si mimwa gyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ejjinja lizitowa, n’omusenyu muzito,","poem":1},{"text":"naye obulumbaganyi bw’omusirusiru businga byonna okuzitowa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Obusungu bwa ttima, n’ekiruyi kifugira ddala nnyo,","poem":1},{"text":"naye ani ayinza okwolekera amaaso g’obuggya?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Okunenya mu lwatu,","poem":1},{"text":"kisinga okwagala okukisibbwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Okunywegera kw’omulabe kwandiba okungi,","poem":1},{"text":"naye ebiwundu by’okunenya kw’owoomukwano tebitiisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Oyo akkuse akyawa omubisi gw’enjuki,","poem":1},{"text":"naye eri omuyala n’ekikaawa kiba kiwoomerera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ng’akanyonyi akadduka mu kisu kyako,","poem":1},{"text":"bw’atyo bw’abeera omuntu abula mu maka ge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ebyakaloosa bisanyusa omutima,","poem":1},{"text":"n’obuwoomerevu bw’omukwano gw’omuntu bwe butyo bwe buvaamu okubuulirira okw’amazima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mukwano gwo ne mukwano gwa kitaawo tobaabuuliranga,","poem":1},{"text":"olemenga okutawaana okuswala ewa muganda wo ng’ogudde mu mitawaana.","poem":2},{"lineBreak":true},{"text":"Muliraanwa wo akira muganda wo akuli ewala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Beeranga n’amagezi mwana wange, osanyusenga omutima gwange,","poem":1},{"text":"ndyoke nyanukule oyo yenna ansekerera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Omuntu omutegeevu alaba akabenje ne yeekweka,","poem":1},{"text":"naye abatalina magezi batambula butambuzi ne bagwa mu kabi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Twalanga ekyambalo ky’oyo eyeeyimirira gw’atamanyi,","poem":1},{"text":"era kwatanga eky’oyo eyeeyimirira omukazi omwenzi kye yeeyamye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Okulamusa ku muliraanwa wo mu makya ennyo, ng’oleekaana,","poem":1},{"text":"obanga amukolimidde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Omukazi omuyombi ali ng’enkuba etonnya olutata,","poem":1},{"text":"ku lunaku olw’enkuba ennyingi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Okumuziyiza obanga aziyiza empewo oba","poem":1},{"text":"ng’anyweza omuzigo mu ngalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ng’ekyuma bwe kiwagala ekyuma,","poem":1},{"text":"n’omuntu bw’abangula muntu munne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Buli alabirira omutiini alirya ku bibala byagwo,","poem":1},{"text":"n’oyo aweereza mukama we alissibwamu ekitiibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ng’amazzi bwe galaga omuntu bw’afaanana mu maaso,","poem":1},{"text":"bwe gutyo omutima gw’omuntu bwe gulaga omuntu bw’afaanana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Amagombe ne ggeyeena tebikkuta,","poem":1},{"text":"n’amaaso g’abantu nago bwe gatyo tegakkuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Entamu erongoosa ya ffeeza n’ekikoomi kikola ku zaabu,","poem":1},{"text":"naye omuntu ekimugezesa kutenderezebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ne bw’osekula omusirusiru mu kinu,","poem":1},{"text":"nga bw’osekula emmere y’empeke mu kinu,","poem":2},{"lineBreak":true},{"text":"obusirusiru bwe tobumuggyaamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Okakasanga nti omanyi bulungi embeera z’ekisibo kyo,","poem":1},{"text":"ossangayo omwoyo ku ggana lyo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kubanga eby’obugagga tebibeerera mirembe gyonna,","poem":1},{"text":"n’engule tebeerera mirembe gyonna.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ng’omuddo gw’ensolo omukulu gumaze okusalibwawo, ng’omutoototo gutandise okusibukawo,","poem":1},{"text":"nga n’omuddo ogw’omu busozi guleeteddwa,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"abaana b’endiga balikuwa engoye ez’okwambala,","poem":1},{"text":"n’embuzi ziritundibwa ne zivaamu ensimbi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Olibeera n’amata mangi g’onoggyanga mu mbuzi, okukuliisa ggwe n’ab’omu nnyumba yo,","poem":1},{"text":"n’okuliisa abaweereza bo abawala.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}