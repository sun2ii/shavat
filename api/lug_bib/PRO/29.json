{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PRO","translationId":"lug_bib","name":"Engero","commonName":"Engero","title":"Ekitabo Ekiyitibwa Engero","order":20,"numberOfChapters":31,"sha256":"74bebdc5ccdfc2b9b104ec7fe764cc09b398d5a80da6220ba11f5830f71163ac","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lug_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":29,"content":[{"type":"heading","content":["Obukulembeze bw’Abatuukirivu"]},{"type":"verse","number":1,"content":[{"text":"Omuntu akakanyaza omutima gwe oluvannyuma lw’okunenyezebwa emirundi emingi,","poem":1},{"text":"alizikirira ng’atamanyiridde awatali kuwona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Abatuukirivu bwe bakulaakulana, abantu basanyuka,","poem":1},{"text":"naye abakakanyalira mu kukola ebikyamu bwe bafuga abantu babeera mu kusinda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ayagala amagezi asanyusa kitaawe,","poem":1},{"text":"naye munne w’abamalaaya ayiwaayiwa obugagga bwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kabaka afuga n’obwenkanya, abantu be baba mu butebenkevu,","poem":1},{"text":"naye oyo alulunkanira enguzi, ensi agyonoona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Omuntu awaanawaana munne,","poem":1},{"text":"aba yeetega yekka ekitimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ebibi by’omwonoonyi bye bimutega,","poem":1},{"text":"naye omutuukirivu abeera mu kuyimba na kusanyuka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Omutuukirivu afaayo ku nsonga z’abaavu,","poem":1},{"text":"naye abakozi b’ebibi tebakola bwe batyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Abakudaazi basasamaza ekibuga,","poem":1},{"text":"naye abantu abalina amagezi baziyiza entalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Omuntu ow’amagezi bw’awoza n’omusirusiru,","poem":1},{"text":"omusirusiru ayongera kusunguwala, n’okujerega ne wataba mirembe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Abeegomba okuyiwa omusaayi bakyawa omuntu ow’amazima,","poem":1},{"text":"era banoonya okusaanyaawo obulamu bwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Omusirusiru alaga obusungu bwe bwonna,","poem":1},{"text":"naye omuntu ow’amagezi abuziyiza n’abukkakkanya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Omufuzi bw’awuliriza eby’obulimba,","poem":1},{"text":"abakungu be bonna bafuuka babi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Omwavu n’oyo amubonyaabonya balina ekibagatta:","poem":1},{"text":"Mukama bombi ye yabawa amaaso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kabaka bw’asalira abaavu emisango n’obwesigwa,","poem":1},{"text":"obufuzi bwe bubeerera emirembe gyonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Akaggo akakangavvula, kaleeta amagezi,","poem":1},{"text":"naye omwana alekeddwa awo, aswaza nnyina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Abakozi b’ebibi bwe beeyongera obungi, okumenya amateeka kweyongera,","poem":1},{"text":"naye abatuukirivu baliraba okugwa kwabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kangavvula omwana wo, alikuwa emirembe,","poem":1},{"text":"alireetera emmeeme yo essanyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Awatali kwolesebwa abantu tebaba beegendereza,","poem":1},{"text":"naye wa mukisa oyo akuuma amateeka ga Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Omuweereza tayinza kubuulirirwa na bigambo byokka;","poem":1},{"text":"ne bw’aba ategedde tafaayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Olaba omuntu ayanguyiriza ebigambo bye?","poem":1},{"text":"Omusirusiru alina essuubi okumusinga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Atiitiibya omuweereza we ekiyitiridde ng’akyali mwana muto,","poem":1},{"text":"oluvannyuma omuweereza aleetera mukama we obuyinike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Omuntu ow’obusungu aleeta ennyombo,","poem":1},{"text":"n’omuntu asunguwala amangu ayonoona nnyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Amalala g’omuntu galimuleetera okugwa,","poem":1},{"text":"naye omuntu ow’omwoyo ogwetoowaza alifuna ekitiibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Buli assa ekimu n’omubbi akyawa obulamu bwe ye,","poem":1},{"text":"era ne bw’alayizibwa tasaanira kubaako ky’ayogera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Okutya omuntu kuleeta ekyambika,","poem":1},{"text":"naye buli eyeesiga Mukama anaabanga mirembe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Bangi abanoonya okuganja mu maaso g’omufuzi,","poem":1},{"text":"naye obwenkanya obwa nnama ddala buva eri Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Atali mutuukirivu wa muzizo eri abatuukirivu;","poem":1},{"text":"era omwesimbu wa muzizo eri abakozi b’ebibi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":27}