{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PRO","translationId":"lug_bib","name":"Engero","commonName":"Engero","title":"Ekitabo Ekiyitibwa Engero","order":20,"numberOfChapters":31,"sha256":"74bebdc5ccdfc2b9b104ec7fe764cc09b398d5a80da6220ba11f5830f71163ac","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lug_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":3,"content":[{"type":"heading","content":["Emikisa Egiva mu kuba n’Amagezi"]},{"type":"verse","number":1,"content":[{"text":"Mwana wange, teweerabiranga bintu bye nakuyigiriza,","poem":1},{"text":"era okuumanga ebiragiro byange mu mutima gwo,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kubanga bijja kuwangaaza obulamu bwo ku nsi,","poem":1},{"text":"era bikukulaakulanye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Amazima n’ekisa tobyerabiranga;","poem":1},{"text":"byesibe mu bulago bwo,","poem":2},{"lineBreak":true},{"text":"obiwandiike ku mutima gwo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bw’otyo bw’onoofuna okuganja n’okusiimibwa","poem":1},{"text":"eri Katonda n’eri abantu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Weesige Mukama n’omutima gwo gwonna,","poem":1},{"text":"so teweesigamanga ku magezi go gokka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mukama mukulembezenga mu by’okola byonna,","poem":1},{"text":"naye anaakuluŋŋamyanga n’owangula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Amagezi go tegakusigulanga,","poem":1},{"text":"naye otyanga Mukama, era weewale okukola ebibi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Onoofunanga obulamu mu mubiri gwo","poem":1},{"text":"n’amagumba go ne gadda buggya.","poem":2}]},{"type":"heading","content":["Amagezi n’Obugagga"]},{"type":"verse","number":9,"content":[{"text":"Mukama mugulumizenga n’eby’obugagga byo; n’ebibala ebisooka eby’ebintu byo byonna eby’omu nnimiro yo,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"olwo amaterekero go lwe ganajjulanga ebintu enkumu,","poem":1},{"text":"era n’amasenero go ne gajjula ne gabooga omwenge omusu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mwana wange tonyoomanga kukangavvula kwa Mukama,","poem":1},{"text":"n’okunenya kwe kulemenga okukukooya,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"kubanga Mukama anenya oyo gw’ayagala,","poem":1},{"text":"nga kitaawe w’omwana bw’anenya mutabani we gwe yeenyumiririzaamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Aweereddwa omukisa oyo afuna amagezi,","poem":1},{"text":"omuntu oyo afuna okutegeera,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"kubanga amagezi gasinga ffeeza","poem":1},{"text":"era galimu amagoba okusinga zaabu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Amagezi ga muwendo mungi okusinga amayinja ag’omuwendo omungi:","poem":1},{"text":"era tewali kyegombebwa kiyinza kugeraageranyizibwa nago.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mu mukono gwago ogwa ddyo mwe muli obuwanguzi;","poem":1},{"text":"ne mu mukono gwago ogwa kkono ne mubaamu obugagga n’ekitiibwa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mu magezi mulimu essanyu,","poem":1},{"text":"era n’amakubo gaago ga mirembe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Amagezi muti gwa bulamu eri abo abagakwata ne baganyweza;","poem":1},{"text":"abo abagakwata ne baganyweza baliweebwa omukisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Amagezi, Mukama ge yakozesa okuteekawo emisingi gy’ensi;","poem":1},{"text":"n’okutegeera kwe yakozesa okuteekawo eggulu;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"n’okumanya kwe, kwe yakozesa okwawula obuziba bw’ennyanja,","poem":1},{"text":"era n’ebire ne bivaamu omusulo.","poem":2}]},{"type":"heading","content":["Ab’amagezi Baweebwa Ekitiibwa"]},{"type":"verse","number":21,"content":[{"text":"Mwana wange, beeranga n’okuteesa okulungi n’okusalawo ebisaana,","poem":1},{"text":"ebyo biremenga okukuvaako,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"binaabeeranga obulamu eri emmeeme yo,","poem":1},{"text":"era ekyokwambala ekirungi ekinaawoomesanga obulago bwo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bw’otyo bw’onootambulanga nga onyweredde mu kkubo lyo,","poem":1},{"text":"era ekigere kyo tekijjanga kwesittala.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bw’onoogalamiranga toobenga na kutya,","poem":1},{"text":"weewaawo bw’oneebakanga otulo tunaakuwoomeranga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Totyanga kabenje kootomanyiridde,","poem":1},{"text":"wadde okuzikirira okujjira abakozi b’ebibi,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kubanga Mukama y’anaabeeranga obwesigwa bwo,","poem":1},{"text":"era anaalabiriranga ekigere kyo ne kitakwatibwa mu mutego.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Tommanga birungi abo be bisaanira","poem":1},{"text":"bwe kibeera mu buyinza bwo okukikola.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Togambanga muliraanwa wo nti,","poem":1},{"text":"“Genda, onodda enkya ne nkuwa,”","poem":2},{"lineBreak":true},{"text":"ate nga kye yeetaaga okirina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Totegekanga kukola bulabe ku muliraanwa wo,","poem":1},{"text":"atudde emirembe ng’akwesiga.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Tovunaananga muntu n’omu awatali nsonga","poem":1},{"text":"nga talina kabi k’akukoze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Tokwatirwanga obuggya omuntu ayigganya abalala,","poem":1},{"text":"era tokolanga nga ye bw’akola,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"kubanga omuntu omugwagwa wa muzizo eri Mukama,","poem":1},{"text":"naye abo abagolokofu abalinamu obwesige.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Ekikolimo kya Mukama kiri ku nnyumba y’ababi,","poem":1},{"text":"naye awa omukisa ennyumba y’abatuukirivu.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ddala ddala, Mukama anyooma abanyoomi,","poem":1},{"text":"naye abeetoowaza abawa ekisa.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ab’amagezi balisikira ekitiibwa,","poem":1},{"text":"naye abasirusiru baliswazibwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}