{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PRO","translationId":"lug_bib","name":"Engero","commonName":"Engero","title":"Ekitabo Ekiyitibwa Engero","order":20,"numberOfChapters":31,"sha256":"74bebdc5ccdfc2b9b104ec7fe764cc09b398d5a80da6220ba11f5830f71163ac","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lug_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":31,"content":[{"type":"heading","content":["Okulabula ku Kunywa Ekitamiiza"]},{"type":"verse","number":1,"content":["Ebigambo bya kabaka Lemweri bye yayogera, nnyina bye yamuyigiriza."]},{"type":"verse","number":2,"content":[{"text":"Ggwe mutabani wange, ggwe mutabani w’enda yange,","poem":1},{"text":"ggwe mutabani w’obweyamo bwange.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tomaliranga maanyi go ku bakazi,","poem":1},{"noteId":2},{"text":"newaakubadde amaanyi go ku abo abazikiriza bakabaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ggwe Lemweri, si kya bakabaka,","poem":1},{"text":"si kya bakabaka okunywanga omwenge,","poem":2},{"lineBreak":true},{"text":"so si kya balangira okwegombanga omwenge,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"si kulwa nga bagunywa ne beerabira amateeka,","poem":1},{"text":"ne batalamula mu bwenkanya abantu baabwe abatulugunyizibwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ekitamiiza mukiwenga oyo ayagala okufa,","poem":1},{"text":"n’omwenge oyo alina emmeeme eriko obuyinike.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mumuleke anywenga yeerabire obwavu bwe,","poem":1},{"text":"alemenga kujjukira nate buyinike bwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yogereranga abo abatasobola kweyogerera,","poem":1},{"text":"otunulenga mu nsonga z’abo bonna abaasigala ettayo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yogera olamulenga n’obwenkanya,","poem":1},{"text":"olwanirirenga abaavu n’abali mu bwetaavu.","poem":2}]},{"type":"heading","content":["Omukazi ow’Amagezi"]},{"type":"verse","number":10,"content":[{"text":"Omukazi omwegendereza ani ayinza okumulaba?","poem":1},{"text":"Wa muwendo nnyo okusinga amayinja ag’omuwendo ennyo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bba amwesiga n’omutima gwe gwonna,","poem":1},{"text":"era bba talina kyonna kya muwendo ky’abulwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Aleetera bba essanyu so tamukola kabi,","poem":1},{"text":"obulamu bwe bwonna.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Anoonya ebyoya by’endiga n’anoonya ne ppamba,","poem":1},{"text":"n’akola emirimu gye mu ssanyu eritayogerekeka.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ali ng’ebyombo by’abasuubuzi,","poem":1},{"text":"aleeta emmere okuva mu nsi ezeewala.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Agolokoka tebunnakya,","poem":1},{"text":"n’awa ab’omu nnyumba ye ebyokulya,","poem":2},{"lineBreak":true},{"text":"n’agabira abaweereza be abawala be abaweereza emirimu egy’okukola.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Alowooza ku nnimiro n’agigula;","poem":1},{"text":"asimba ennimiro ey’emizabbibu n’ebibala by’emikono gye.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Omukazi oyo akola n’amaanyi omulimu gwe,","poem":1},{"text":"emikono gye gikwata n’amaanyi emirimu gye.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ayiiya ebyamaguzi ebirimu amagoba n’abisuubula,","poem":1},{"text":"era n’ettabaaza ye ekiro tezikira.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Anyweza omuti oguluka ppamba mu mukono gwe,","poem":1},{"text":"engalo ze ne zikwata akati akalanga.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ayanjululiza abaavu omukono gwe,","poem":1},{"text":"n’agololera omukono gwe oyo ali mu bwetaavu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mu biseera by’obutiti taba na kutya,","poem":1},{"text":"kubanga ab’omu nnyumba ye bonna baba n’engoye ez’okwambala.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yeekolera ebibikka obuliri bwe,","poem":1},{"text":"era engoye ze za linena omulungi, za ffulungu.","poem":2},{"noteId":3}]},{"type":"verse","number":23,"content":[{"text":"Bba amanyibbwa,","poem":1},{"text":"y’omu ku bakulu abakulembera ensi, era ateeseza mu nkiiko enkulu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Omukazi atunga ebyambalo ebya linena n’abitunda,","poem":1},{"text":"n’aguza abasuubuzi enkoba.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Amaanyi n’ekitiibwa bye byambalo bye,","poem":1},{"text":"era tatya ebiro ebigenda okujja.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ayogera n’amagezi,","poem":1},{"text":"era ayigiriza ebyekisa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Alabirira nnyo empisa z’ab’omu nnyumba ye,","poem":1},{"text":"era talya mmere ya bugayaavu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Abaana be bagolokoka ne bamuyita wa mukisa,","poem":1},{"text":"ne bba n’amutendereza ng’ayogera nti,","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“Abakazi bangi abakola eby’ekitiibwa","poem":1},{"text":"naye bonna ggwe obasinga.”","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Obubalagavu bulimba n’endabika ennungi teriiko kyegasa,","poem":1},{"text":"naye omukazi atya Mukama anaatenderezebwanga.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Mumusasule empeera gy’akoleredde,","poem":1},{"text":"n’emirimu gye gimuweesenga ettendo ku miryango gy’ekibuga.","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Abakazi aboogerwako wano be baweereza abakazi abangi ababeera mu lubiri; batabulatabula kabaka ng’akola emirimu gye","reference":{"chapter":31,"verse":3}},{"noteId":3,"caller":"+","text":"Engoye za ffulungu zaali za bbeeyi era nga kabonero ka kikungu","reference":{"chapter":31,"verse":22}}]},"thisChapterLink":"/api/lug_bib/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}