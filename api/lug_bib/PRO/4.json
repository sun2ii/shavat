{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PRO","translationId":"lug_bib","name":"Engero","commonName":"Engero","title":"Ekitabo Ekiyitibwa Engero","order":20,"numberOfChapters":31,"sha256":"74bebdc5ccdfc2b9b104ec7fe764cc09b398d5a80da6220ba11f5830f71163ac","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lug_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":4,"content":[{"type":"heading","content":["Amagezi ge gali ku Ntikko"]},{"type":"verse","number":1,"content":[{"text":"Muwulirize baana bange okuyigiriza kwange ng’okwa kitammwe,","poem":1},{"text":"era musseeyo omwoyo mufune okutegeera.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kubanga mbawa okuyigiriza okulungi;","poem":1},{"text":"temulekanga biragiro byange.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bwe nnali omuvubuka nga ndi ne kitange,","poem":1},{"text":"omwana omu yekka omwagalwa, owa mmange,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"yanjigiriza n’aŋŋamba nti, “Ebigambo byange bikuumenga ku mutima gwo,","poem":1},{"text":"kuuma ebiragiro byange obeere mulamu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Funa amagezi; funa okutegeera,","poem":1},{"text":"teweerabiranga era tovanga ku bigambo bya mu kamwa kange.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Togalekanga, nago ganaakukuumanga,","poem":1},{"text":"gaagale nago ganaakulabiriranga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ddala amagezi kye kintu ekisingira ddala obukulu;","poem":1},{"text":"noolwekyo fuba ofune amagezi, era fubira ddala nnyo ofune okutegeera.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Amagezi gagulumize, nago gajja kukuyimusa,","poem":1},{"text":"gaanirize, nago gajja kukuweesa ekitiibwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Amagezi gajja kukutikkira engule ey’ekisa,","poem":1},{"text":"era gakuwe n’engule ey’ekitiibwa.”","poem":2}]},{"type":"heading","content":["Enjawulo wakati w’Ab’amagezi n’Abagwenyufu"]},{"type":"verse","number":10,"content":[{"text":"Wuliriza ggwe, mutabani, era okkirize ebigambo byange","poem":1},{"text":"olyoke owangaalire ku nsi n’essanyu eringi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nkuluŋŋamya mu kkubo ery’amagezi,","poem":1},{"text":"ne nkukulembera mu makubo ag’obutuukirivu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bw’onootambulanga, ekigere kyo kireme okuziyizibwa;","poem":1},{"text":"era bw’onoddukanga, tojjanga kwesittala.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nywerezanga ddala okuyigirizibwa, tokutanga:","poem":1},{"text":"kukuumenga kubanga bwe bulamu bwo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Toyingiranga mu kkubo ly’abakozi b’ebibi,","poem":1},{"text":"wadde okutambulira mu kkubo ly’abantu aboonoonyi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lyewalenga, tolitambulirangamu,","poem":1},{"text":"liveeko okwate ekkubo lyo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kubanga abakozi b’ebibi tebayinza kwebaka okuggyako nga bakoze ebibi,","poem":1},{"text":"era otulo tubabulira ddala bwe baba tebalina gwe bakozeeko bulabe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Okukola ebibi y’emmere yaabwe,","poem":1},{"text":"n’okukozesa eryanyi kye kyokunywa kyabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ekkubo ly’abatuukirivu liri ng’enjuba eyakavaayo,","poem":1},{"text":"eyeeyongera okwaka okutuusa obudde lwe butangaalira ddala.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Naye ekkubo ly’ababi liri ng’ekizikiza ekikutte,","poem":1},{"text":"tebamanyi kibaleetera kwesittala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mutabani wange wuliriza n’obwegendereza ebigambo byange;","poem":1},{"text":"osseeyo omwoyo eri bye nkutegeeza;","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ebigambo bino tebikuvangako,","poem":1},{"text":"bikuumire ddala mu mutima gwo,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"kubanga bya bulamu eri abo ababifuna,","poem":1},{"text":"era biwonya omubiri gwabwe gwonna.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ekisinga byonna kuuma omutima gwo,","poem":1},{"text":"kubanga y’ensulo y’obulamu bwo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Weewalire ddala eby’obubambavu","poem":1},{"text":"era n’okwogera ebya swakaba.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Amaaso go gatunulenga butereevu,","poem":1},{"text":"era otunulenga n’obumalirivu eyo gy’olaga.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ttereeza bulungi amakubo go;","poem":1},{"text":"okwate amakubo ageesigika gokka.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Tokyamanga ku mukono ogwa ddyo oba ogwa kkono;","poem":1},{"text":"ebigere byo byewalenga ekkubo ekyamu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}