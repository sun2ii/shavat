{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PRO","translationId":"lug_bib","name":"Engero","commonName":"Engero","title":"Ekitabo Ekiyitibwa Engero","order":20,"numberOfChapters":31,"sha256":"74bebdc5ccdfc2b9b104ec7fe764cc09b398d5a80da6220ba11f5830f71163ac","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lug_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":6,"content":[{"type":"heading","content":["Okulabula ku Butamanya n’Obusirusiru"]},{"type":"verse","number":1,"content":[{"text":"Mutabani obanga weeyimirira muliraanwa wo,","poem":1},{"text":"ne weeyama okuyamba omuntu gw’otomanyi, oli mu katyabaga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Obanga weesibye n’ebigambo ggwe kennyini bye wayogera,","poem":1},{"text":"ng’ebigambo by’omu kamwa ko bikusibye,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"kino mwana wange ky’oba okola okusobola okwewonya,","poem":1},{"text":"kubanga kaakano oli mu buyinza bwa muliraanwa wo:","poem":2},{"text":"Yanguwa, ogende weetoowaze,","poem":1},{"text":"weegayirire muliraanwa wo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amaaso go togaganya kwebaka,","poem":1},{"text":"wadde ebikowe byo okubongoota.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Onunule obulamu bwo ng’empeewo bw’edduka okuva mu ngalo z’omuyizzi,","poem":1},{"text":"era ng’ekinyonyi, bwe kiva mu mutego gw’omutezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yigira ku biwuka, mugayaavu ggwe;","poem":1},{"text":"fumiitiriza engeri gye bikolamu obiyigireko.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tebirina mukulembeze,","poem":1},{"text":"mukungu oba mufuzi yenna abikulembera,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"kyokka byekuŋŋaanyiza emmere mu biseera eby’amakungula,","poem":1},{"text":"ne bitereka emmere mu biseera ebituufu mu mwaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Olituusa ddi okwebaka mugayaavu ggwe?","poem":1},{"text":"Oligolokoka ddi n’ova mu tulo two?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Otulo otutonotono, n’okusumagira akatono,","poem":1},{"text":"n’okufunya emikono okuwummulako,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"obwavu bulikutuukako ng’omutemu,","poem":1},{"text":"era n’obwetaavu ng’omutemu.","poem":2}]},{"type":"heading","content":["Okulabula eri Omuntu Omutabuzitabuzi"]},{"type":"verse","number":12,"content":[{"text":"Omuntu ataliiko ky’agasa, omusajja omubi","poem":1},{"text":"agenda ayogera ebigambo ebitabulatabula,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"agenda atemyatemya ku liiso,","poem":1},{"text":"nga bw’akuba ebigere","poem":2},{"lineBreak":true},{"text":"ate nga bw’asongasonga olunwe,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"olw’omutima omukyamu, ateekateeka okukola ebibi,","poem":2},{"lineBreak":true},{"text":"bulijjo aleeta obutakkaanya mu bantu!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Noolwekyo okuzikirira kulimujjira mbagirawo,","poem":1},{"text":"mu kaseera buseera alibetentebwa awatali kuwona.","poem":2}]},{"type":"heading","content":["Okulabula ku Bibi Omusanvu"]},{"type":"verse","number":16,"content":["Waliwo ebintu mukaaga Mukama by’akyawa, weewaawo musanvu eby’omuzizo gy’ali."]},{"type":"verse","number":17,"content":["Amaaso ag’amalala, emimwa egirimba, okuttira abantu obwereere;"]},{"type":"verse","number":18,"content":["omutima ogutegeka okukola ebibi, ebigere ebyanguwa okukola ebibi,"]},{"type":"verse","number":19,"content":["obujulizi obw’obulimba, n’omuntu aleeta obutakkaanya mu booluganda."]},{"type":"heading","content":["Okulabula Ku Bwenzi"]},{"type":"verse","number":20,"content":[{"text":"Mwana wange nyweza ebiragiro bya kitaawo,","poem":1},{"text":"era togayaalirira kuyigiriza kwa maama wo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bisibenga ku mutima gwo ennaku zonna","poem":1},{"text":"era obisibe binywerere mu bulago bwo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bijja kukuluŋŋamyanga buli gy’onoolaganga,","poem":1},{"text":"ne bw’onoobanga weebase binaakukuumanga,","poem":2},{"lineBreak":true},{"text":"ate ng’ozuukuse binaabanga naawe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kubanga amateeka ttabaaza,","poem":1},{"text":"era n’okuyigiriza kitangaala,","poem":2},{"text":"okukulabula olw’okukuluŋŋamya,","poem":1},{"text":"ly’ekkubo ery’obulamu,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"okukuwonya omukazi ow’ebibi,","poem":1},{"text":"okukuggya mu kunyumiikiriza kw’omukazi omwenzi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Teweegombanga bulungi bwe mu mutima gwo,","poem":1},{"text":"wadde okumukkiriza okukuwamba n’amaaso ge,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"kubanga malaaya akussa ku muwendo ogugula omugaati,","poem":1},{"text":"era omukazi omwenzi anoonya kuzikiririza ddala bulamu bwo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Omuntu ayinza okuwambaatira omuliro mu kifuba kye,","poem":1},{"text":"ebyambalo bye ne bitaggya?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Oba omuntu ayinza okutambulira ku manda agookya,","poem":1},{"text":"ebigere bye ne bitasiriira?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Bwe kityo bwe kiri eri omusajja agenda ne muka muliraanwa we,","poem":1},{"text":"buli akwata ku mukazi ng’oyo talirema kubonerezebwa olw’ekibi kye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Abantu tebasekerera muntu bw’abba,","poem":1},{"text":"olw’okwewonya enjala.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Naye bwe bamukwata aba alina okuwa engassi ya mirundi musanvu;","poem":1},{"text":"ne bwe kiba nga kimumalako ebintu bye byonna eby’omu nju ye.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Naye buli ayenda ku mukazi talina magezi;","poem":1},{"text":"kubanga azikiririza ddala emmeeme ye ye.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Alifuna ebiwundu n’okunyoomebwa;","poem":1},{"text":"n’obuswavu tebulimusangulibwako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Kubanga obuggya buleetera omusajja okuswakira,","poem":1},{"text":"era taliba na kisa n’akatono nga yeesasuza.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Talikkiriza mutango gwonna,","poem":1},{"text":"wadde okuwooyawooyezebwa enguzi ennene.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}