{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PRO","translationId":"lug_bib","name":"Engero","commonName":"Engero","title":"Ekitabo Ekiyitibwa Engero","order":20,"numberOfChapters":31,"sha256":"74bebdc5ccdfc2b9b104ec7fe764cc09b398d5a80da6220ba11f5830f71163ac","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lug_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":7,"content":[{"type":"heading","content":["Emitawaana Egiva mu Kukwana Omukazi Omwenzi"]},{"type":"verse","number":1,"content":[{"text":"Mutabani nyweeza ebigambo byange,","poem":1},{"text":"era okuumenga ebiragiro byange.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kwata ebiragiro byange obeere mulamu,","poem":1},{"text":"n’amateeka gange ogakuume ng’emmunye y’eriiso lyo;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"togalekanga kuva mu ngalo zo,","poem":1},{"text":"gawandiike ku mutima gwo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amagezi gatwalire ddala nga mwannyoko,","poem":1},{"text":"n’okutegeera, ng’owooluganda ow’omu kika kyo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Binaakuwonyanga omukazi omwenzi,","poem":1},{"text":"omukazi omutambuze awaanawaana n’ebigambo ebisendasenda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lumu nnali nnyimiridde","poem":1},{"text":"ku ddirisa ly’ennyumba yange.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne ndaba mu bavubuka abatoototo,","poem":1},{"text":"omulenzi atalina magezi,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ng’ayita mu luguudo okumpi n’akafo k’omukazi omwenzi,","poem":1},{"text":"n’akwata ekkubo eridda ku nnyumba y’omukazi oyo,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"olw’eggulo ng’obudde buzibye,","poem":1},{"text":"ekizikiza nga kikutte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Awo omukazi n’ajja okumusisinkana","poem":1},{"text":"ng’ayambadde nga malaaya, ng’ajjudde ebirowoozo eby’obukaba mu mutima gwe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Omukazi omukalukalu,","poem":1},{"text":"atambulatambula ennyo atabeerako waka,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"wuuyo mu luguudo, wuuyo mu bifo ebikuŋŋaanirwamu,","poem":1},{"text":"mu buli kafo konna ng’ateega!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"N’amuvumbagira, n’amunywegera","poem":1},{"text":"era ng’amutunuulidde nkaliriza n’amaaso agatatya n’amugamba nti:","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Nnina ssaddaaka ez’ebiweebwayo olw’emirembe,","poem":1},{"text":"leero ntukiriza obweyamo bwange.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Noolwekyo nzize okukusisinkana,","poem":1},{"text":"mbadde njagala nnyo okukulaba, era kaakano nkusanze.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Obuliri bwange mbwaze bulungi","poem":1},{"text":"n’engoye eza linena ava mu Misiri.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mbukubye n’akaloosa,","poem":1},{"text":"n’omugavu, n’obubaane, ne kinamoni, ne kalifuuwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Jjangu tuwoomerwe omukwano okutuusa obudde okukya;","poem":1},{"text":"leka twesanyuse ffembi mu mukwano.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kubanga baze taliiyo eka;","poem":1},{"text":"yatambula olugendo luwanvu:","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yagenda n’ensawo y’ensimbi;","poem":1},{"text":"era alikomawo nga wayiseewo wiiki bbiri.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Yamusendasenda n’ebigambo ebisikiriza;","poem":1},{"text":"n’amuwabya n’ebigambo ebiwoomerera.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Amangwago omuvubuka n’amugoberera","poem":1},{"text":"ng’ente etwalibwa okuttibwa","poem":2},{"text":"obanga empeewo egwa mu mutego,","poem":1}]},{"type":"verse","number":23,"content":[{"text":"okutuusa akasaale lwe kafumita ekibumba kyayo,","poem":2},{"text":"ng’akanyonyi bwe kanguwa okugwa mu mutego,","poem":1},{"text":"so tamanyi ng’alifiirwa obulamu bwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kaakano nno batabani bange mumpulirize,","poem":1},{"text":"era musseeyo nnyo omwoyo eri ebigambo byange.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Temukkiriza mitima gyammwe kugoberera bigambo bye;","poem":1},{"text":"temukkiriza bigere byammwe kukyamira mu makubo ge.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kubanga bangi bazikiridde,","poem":1},{"text":"ddala ab’amaanyi bangi bagudde.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ennyumba ye, lye kkubo eridda emagombe,","poem":1},{"text":"nga likka mu bisenge eby’okufa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}