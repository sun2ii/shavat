{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PRO","translationId":"lug_bib","name":"Engero","commonName":"Engero","title":"Ekitabo Ekiyitibwa Engero","order":20,"numberOfChapters":31,"sha256":"74bebdc5ccdfc2b9b104ec7fe764cc09b398d5a80da6220ba11f5830f71163ac","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lug_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":8,"content":[{"type":"heading","content":["Amagezi Gakoowoola"]},{"type":"verse","number":1,"content":[{"text":"Amagezi tegakoowoolera waggulu,","poem":1},{"text":"n’okutegeera ne kuyimusa eddoboozi lyakwo?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ku ntikko y’ebifo ebigulumivu okumpi n’ekkubo,","poem":1},{"text":"mu masaŋŋanzira, amagezi we gayimirira butengerera,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ku mabbali g’enzigi eziyingira mu kibuga,","poem":1},{"text":"ku miryango, gakoowoolera waggulu nga gagamba nti,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mmwe abantu, mmwe b’empita;","poem":1},{"text":"nnyimusa eddoboozi lyange eri buli omu ali ku nsi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mmwe abatategeera mufune okutegeera;","poem":1},{"text":"nammwe abasirusiru mufune amagezi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Muwulirize kubanga nnina ebintu ebikulu eby’okubagamba,","poem":1},{"text":"era mu kamwa kange muvaamu ebituufu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Akamwa kange koogera bituufu byereere;","poem":1},{"text":"kubanga emimwa gyange gikyawa ebitali bya butuukirivu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ebigambo by’emimwa gyange byonna bya bwenkanya","poem":1},{"text":"tewali na kimu kikyamu oba kya bukuusa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ebigambo byange byonna bitegeerekeka eri oyo ategeera,","poem":1},{"text":"era tebirina kabi eri oyo alina amagezi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mu kifo kya ffeeza, londawo okuyigiriza kwange,","poem":1},{"text":"era n’okumanya mu kifo kya zaabu ennongoose obulungi,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"kubanga amagezi gasinga amayinja ag’omuwendo omungi,","poem":1},{"text":"era n’ebyo byonna bye weegomba tebiyinza kugeraageranyizibwa nago.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nze Magezi, mbeera wamu n’okuteesa okulungi,","poem":1},{"text":"era mu nze mulimu okumanya n’okwawula ekirungi n’ekibi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Okutya Mukama kwe kukyawa ekibi;","poem":1},{"text":"nkyawa amalala n’okwemanya,","poem":2},{"lineBreak":true},{"text":"n’obuteeyisa bulungi n’enjogera ey’obubambaavu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Okuteesa okulungi n’okusalawo okw’amagezi bye byange;","poem":1},{"text":"ntegeera era ndi wa buyinza.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ku bwange, Magezi, bakabaka bafuga,","poem":1},{"text":"abafuzi ne bakola amateeka ag’obwenkanya.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abalangira bafuga ku bwange,","poem":1},{"text":"n’abakungu bonna abafuga ku nsi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Njagala abo abanjagala,","poem":1},{"text":"n’abo abanyiikira okunnoonya bandaba.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Obugagga n’ekitiibwa biri mu nze,","poem":1},{"text":"obugagga obutakoma n’okukulaakulana.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ekibala kyange kisinga zaabu ennongoose,","poem":1},{"text":"n’ebinvaamu bisinga ffeeza ey’omuwendo omungi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ntambulira mu kkubo ery’obutuukirivu,","poem":1},{"text":"mu kkubo ery’obwenkanya,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"n’abo abanjagala mbagaggawaza","poem":1},{"text":"era nzijuza amawanika gaabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Mukama nze gwe yasooka okwoleka","poem":1},{"text":"nga tannabaako kirala ky’akola.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nateekebwawo dda nnyo,","poem":1},{"text":"ku lubereberye ng’ensi tennabaawo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nateekebwawo ng’obuziba bw’ennyanja tebunnateekebwawo,","poem":1},{"text":"nga n’emigga egireeta amazzi teginnabaawo,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ng’ensozi tezinnateekebwa mu bifo byazo,","poem":1},{"text":"nga n’obusozi tebunnabaawo;","poem":2}]},{"type":"verse","number":26,"content":[{"text":"nga tannakola nsi newaakubadde amalundiro gaakwo,","poem":1},{"text":"wadde enfuufu eyasooka ey’oku nsi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Naliwo ng’ateekawo eggulu mu kifo kyalyo,","poem":1},{"text":"ne bwe yakola enkulungo kungulu ku buziba,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ate ne bwe yawanika ebire n’abinywereza waggulu mu bbanga,","poem":1},{"text":"n’anywereza ddala ensulo z’amazzi,","poem":2}]},{"type":"verse","number":29,"content":[{"text":"bwe yawa ennyanja ensalo zaazo we zikoma,","poem":1},{"text":"amazzi galeme kusukka we yagalagira,","poem":2},{"lineBreak":true},{"text":"ne bwe yali ng’alamba emisingi gy’ensi.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Nnali naye ng’omukozi omukugu,","poem":1},{"text":"nga nzijudde essanyu lye erya buli lunaku,","poem":2},{"lineBreak":true},{"text":"nga nsanyukira mu maaso ge bulijjo,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"nga nsanyukira mu nsi ye yonna,","poem":1},{"text":"era nga ne nesiima olw’abaana b’abantu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Kale nno, batabani bange mumpulirize;","poem":1},{"text":"balina omukisa abo abakwata amakubo gange!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Muwulirizenga okuyigirizibwa, mubenga n’amagezi,","poem":1},{"text":"so temugalekanga.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Alina omukisa omuntu ampuliriza,","poem":1},{"text":"alindirira nga bw’akuuma ku nzigi zange","poem":2},{"lineBreak":true},{"text":"buli lunaku.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Kubanga buli andaba afuna obulamu,","poem":1},{"text":"era afuna okuganja eri Mukama.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Oyo atannoonya yeerumya yekka,","poem":1},{"text":"era n’abo bonna abankyawa banoonya kufa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}