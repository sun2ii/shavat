{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PRO","translationId":"lug_bib","name":"Engero","commonName":"Engero","title":"Ekitabo Ekiyitibwa Engero","order":20,"numberOfChapters":31,"sha256":"74bebdc5ccdfc2b9b104ec7fe764cc09b398d5a80da6220ba11f5830f71163ac","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/lug_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"heading","content":["Empagi z’Amagezi Omusanvu"]},{"type":"verse","number":1,"content":[{"text":"Amagezi gazimbye ennyumba yaago,","poem":1},{"text":"gagizimbidde ku mpagi musanvu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gategese ennyama yaago ne wayini","poem":1},{"noteId":0},{"text":"waago;","poem":1},{"text":"gategese ekijjulo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gatumye abawala abaweereza bakoowoolere","poem":1},{"text":"mu bifo ebigulumivu nti,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Buli atalina kutegeera akyameko wano!”","poem":1},{"text":"Eri abo abatalina magezi gabagamba nti,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Mujje mulye ku mmere yange","poem":1},{"text":"era munywe ne ku nvinnyo gwe ntabudde.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mulekeraawo obutaba na kutegeera mubeere balamu,","poem":1},{"text":"era mutambulire mu kkubo ly’okumanya.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Oyo anenya omunyoomi ayolekera kuvumwa,","poem":1},{"text":"n’oyo abuulirira omukozi w’ebibi yeeretera kuvumibwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tonenyanga munyoomi, aleme okukukyawa, naye","poem":1},{"text":"nenya ow’amagezi naye anaakwagalanga.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yigirizanga ow’amagezi naye aneeyongeranga okuba n’amagezi,","poem":1},{"text":"yigirizanga omutuukirivu, aneeyongerangako okuyiga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Mu kutya Mukama amagezi mwe gasookera,","poem":1},{"text":"era n’okumanya oyo Omutukuvu Katonda, kwe kutegeera.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ku lwange oliwangaala emyaka mingi nnyo,","poem":1},{"text":"era olyongerwako emyaka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bw’obeera omugezi, amagezi go gakuyamba,","poem":1},{"text":"naye bw’onyooma amagezi weerumya wekka.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Omukazi omusirusiru aleekaana,","poem":1},{"text":"taba na mpisa era taba na magezi!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Era atuula mu mulyango gw’ennyumba ye,","poem":1},{"text":"ne ku ntebe mu bifo eby’ekibuga ebisinga obugulumivu,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ng’akoowoola abo abayitawo,","poem":1},{"text":"ababa batambula amakubo gaabwe abali ku byabwe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abagamba nti, “Buli alina okumanya okutono ajje muno.”","poem":1},{"text":"Era eri oyo atalina kutegeera agamba nti,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Amazzi amabbe nga gawooma!","poem":1},{"text":"emmere eriibwa mu kyama ng’ewooma!”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Naye oyo agwa mu kitimba kye tamanya nti nnyumba yakuzikirira,","poem":1},{"text":"era nti abagenyi be bali mu buziba obw’emagombe.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Wayini yatabulwangamu ebyakaloosa aka mooli, yeeyongere okuwoomerera.","reference":{"chapter":9,"verse":2}}]},"thisChapterLink":"/api/lug_bib/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}