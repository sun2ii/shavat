{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Alina omukisa omuntu","poem":1},{"text":"atatambulira mu kuteesa kw’ababi,","poem":2},{"text":"era atayimirira mu kibiina ky’ababi,","poem":1},{"text":"newaakubadde okutuula n’abo abanyooma ebya Katonda.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Naye asanyukira okugondera amateeka ga Mukama,","poem":1},{"text":"era mu mateeka ago mw’alowooleza emisana n’ekiro.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Afaanana ng’omuti ogwasimbibwa ku mabbali g’omugga,","poem":1},{"text":"ogubala ebibala byagwo mu ntuuko zaabyo,","poem":2},{"text":"n’ebikoola byagwo tebiwotoka.","poem":1},{"text":"Na buli ky’akola kivaamu birungi byereere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Naye abakola ebibi tebakola bwe batyo.","poem":1},{"text":"Bali ng’ebisusunku ebifuumuuliddwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Noolwekyo abakola ebibi tebaligumira lunaku lwa kusalirako musango;","poem":1},{"text":"newaakubadde aboonoonyi okuyimirira mu kibiina ky’abatuukirivu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kubanga Mukama alabirira ekkubo ly’abatuukirivu,","poem":1},{"text":"naye ekkubo ly’abakola ebibi liribula.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}