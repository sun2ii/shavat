{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Lwaki otwekwese, Ayi Mukama?","poem":1},{"text":"Lwaki otwekwese mu biseera eby’emitawaana?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Omubi, mu malala ge, ayigganya abanafu;","poem":1},{"text":"muleke agwe mu nkwe ezo z’asaze.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kubanga omubi yeewaana ng’anyumya ku bibi ebiri mu mutima gwe,","poem":1},{"text":"agabula aboomululu n’avuma Mukama.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Omubi mu malala ge","poem":1},{"text":"tanoonya Katonda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Buli ky’akola kimugendera bulungi.","poem":1},{"text":"Amateeka go tagafaako,","poem":2},{"lineBreak":true},{"text":"era n’abalabe be abanyooma.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ayogera mu mutima gwe nti, “Sikangibwa,","poem":1},{"text":"nzija kusanyuka emirembe gyonna.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mu kamwa ke mujjudde okukolima n’obulimba awamu n’okutiisatiisa;","poem":1},{"text":"ebigambo bye bya mutawaana era bibi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yeekukuma mu byalo","poem":1},{"text":"okutemula abantu abataliiko musango.","poem":2},{"lineBreak":true},{"text":"Yeekweka ng’aliimisa b’anatta.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Asooba mu kyama ng’empologoma,","poem":1},{"text":"ng’alindirira okuzinduukiriza abateesobola.","poem":2},{"lineBreak":true},{"text":"Abakwasa n’abatwalira mu kitimba kye.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"B’abonyaabonya bagwa wansi","poem":1},{"text":"ne babetentebwa ng’amaanyi g’omubi gabasukkiridde.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ayogera mu mutima gwe nti, “Katonda yeerabidde, amaaso ge agakwese,","poem":1},{"text":"era takyaddayo kubiraba.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Golokoka, Ayi Mukama, ozikirize omubi, Ayi Katonda;","poem":1},{"text":"abanaku tobeerabiranga.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Omuntu omubi ayinza atya okukunyooma, Ayi Katonda,","poem":1},{"text":"n’agamba mu mutima gwe nti","poem":2},{"lineBreak":true},{"text":"“Sigenda kwennyonnyolako?”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Naye ggwe, Ayi Katonda, ennaku zaabwe n’okubonaabona kwabwe obiraba","poem":1},{"text":"era ojja kubikolako.","poem":2},{"text":"Ateesobola yeewaayo mu mikono gyo,","poem":1},{"text":"kubanga gwe mubeezi w’abatalina bakitaabwe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Malawo amaanyi g’omwonoonyi,","poem":1},{"text":"muyite abyogere ebyo","poem":2},{"lineBreak":true},{"text":"ebibadde bitajja kuzuulwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mukama ye Kabaka emirembe n’emirembe.","poem":1},{"text":"Amawanga galizikirizibwa mu nsi ye.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mukama awulira okwetaaga kw’ababonyaabonyezebwa, ogumye emitima gyabwe;","poem":1},{"text":"otege okutu kwo obaanukule.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Olwanirira abataliiko bakitaabwe n’abajoogebwa;","poem":1},{"text":"omuntu obuntu ow’oku nsi n’ataddayo kubatiisa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}