{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":102,"content":[{"type":"hebrew_subtitle","content":["Okusaba kw’oyo ali mu buyinike ng’ayigganyizibwa nga yeeyongedde okunafuwa, n’afukumula byonna ebimuli ku mutima mu maaso ga Mukama."]},{"type":"verse","number":1,"content":[{"text":"Wulira okusaba kwange, Ayi Mukama,","poem":1},{"text":"okkirize okukoowoola kwange kutuuke gy’oli.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tonneekweka","poem":1},{"text":"mu biseera eby’obuyinike bwange.","poem":2},{"text":"Ntegera okutu kwo","poem":1},{"text":"onnyanukule mangu bwe nkukoowoola!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kubanga ennaku zange zifuumuuka ng’omukka,","poem":1},{"text":"n’amagumba gange gaaka ng’amanda.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Omutima gwange gulinnyirirwa ng’omuddo, era guwotose;","poem":1},{"text":"neerabira n’okulya emmere yange.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Olw’okwaziirana kwange okunene,","poem":1},{"text":"nzenna nfuuse ŋŋumbagumba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndi ng’ekiwuugulu eky’omu ddungu,","poem":1},{"text":"era ng’ekiwuugulu eky’omu nsiko.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nsula ntunula,","poem":1},{"text":"nga ndi ng’ekinyonyi ekitudde kyokka ku kasolya k’ennyumba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abalabe bange banvuma olunaku lwonna;","poem":1},{"text":"abo abanduulira bakozesa linnya lyange nga bakolima.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kubanga ndya evvu ng’alya emmere,","poem":1},{"text":"n’amaziga gange ne geegattika mu kyokunywa kyange.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Olw’obusungu n’okunyiiga kwo;","poem":1},{"text":"onneegobyeko n’onsuula eyo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ennaku zange ziri ng’ekisiikirize ky’olweggulo nga buziba;","poem":1},{"text":"mpotoka ng’omuddo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Naye ggwe, Ayi Mukama, obeera mu ntebe yo ey’obwakabaka emirembe n’emirembe;","poem":1},{"text":"erinnya lyo linajjukirwanga ab’omu mirembe gyonna.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Olisituka n’osaasira Sayuuni,","poem":1},{"text":"kino kye kiseera okulaga Sayuuni omukwano;","poem":2},{"lineBreak":true},{"text":"ekiseera kye wateekateeka kituuse.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kubanga amayinja gaakyo abaweereza bo bagaagala nnyo,","poem":1},{"text":"n’enfuufu y’omu kibuga ekyo ebakwasa ekisa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Amawanga gonna ganaatyanga erinnya lya Mukama;","poem":1},{"text":"ne bakabaka bonna ab’ensi banaakankananga olw’ekitiibwa kyo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kubanga Mukama alizimba Sayuuni buto,","poem":1},{"text":"era n’alabika mu kitiibwa kye.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Alyanukula okusaba kw’abanaku;","poem":1},{"text":"talinyooma kwegayirira kwabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Bino leka biwandiikirwe ab’omu mirembe egirijja,","poem":1},{"text":"abantu abatannatondebwa bwe balibisoma balyoke batendereze Mukama.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bategeere nti Mukama yatunula wansi ng’asinziira waggulu mu kifo kye ekitukuvu;","poem":1},{"text":"Mukama yasinzira mu ggulu n’atunuulira ensi,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"okuwulira okusinda kw’abasibe,","poem":1},{"text":"n’okusumulula abo abasaliddwa ogw’okufa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Erinnya lya Mukama, liryoke litenderezebwe mu Sayuuni,","poem":1},{"text":"bamutenderezenga mu Yerusaalemi;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"abantu nga bakuŋŋaanye, awamu n’obwakabaka,","poem":1},{"text":"okusinza Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Mukama ammazeemu amaanyi nga nkyali muvubuka;","poem":1},{"text":"akendeezezza ku nnaku z’obulamu bwange.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ne ndyoka mmukaabira nti,","poem":1},{"text":"“Ayi Katonda wange, tontwala nga nkyali mu makkati g’emyaka gy’obulamu bwange,","poem":2},{"lineBreak":true},{"text":"ggw’abeera omulamu emirembe gyonna.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ku ntandikwa wassaawo omusingi gw’ensi;","poem":1},{"text":"n’eggulu gy’emirimu gy’emikono gyo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Byonna biriggwaawo, naye ggwe oli wa lubeerera.","poem":1},{"text":"Byonna birikaddiwa ng’ebyambalo.","poem":2},{"lineBreak":true},{"text":"Olibikyusa ng’ebyambalo, ne bisuulibwa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Naye ggwe tokyuka oli wa lubeerera","poem":1},{"text":"n’emyaka gyo tegirikoma.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Abaana b’abaweereza bo baliba mu ddembe;","poem":1},{"text":"ne bazzukulu baabwe banaabeeranga w’oli nga tebalina kye batya.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}