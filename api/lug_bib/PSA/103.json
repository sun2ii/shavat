asala mu butuukirivu ne mu bwenkanya,","poem":1},{"text":"ensonga z’abo bonna abajoogebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yamanyisa Musa ebyo by’ayagala,","poem":1},{"text":"n’alaga abaana ba Isirayiri ebikolwa bye.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mukama wa kisa era ajjudde okusaasira,","poem":1},{"text":"tasunguwala mangu, era alina okwagala okutaggwaawo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Taasibenga busungu ku mwoyo,","poem":1},{"text":"era tasunguwala kumala bbanga lyonna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tatukola ng’okwonoona kwaffe bwe kuli,","poem":1},{"text":"wadde okutusasula ng’ebikolwa byaffe ebitali bya butuukirivu bwe biri.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ng’eggulu bwe litumbidde ennyo waggulu w’ensi,","poem":1},{"text":"n’okwagala kwe bwe kuli okunene bwe kutyo eri abo abamutya.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ebibi byaffe abituggyako","poem":1},{"text":"n’abitwala wala ng’ebuvanjuba bw’eri ewala okuva ebugwanjuba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kitaawe w’abaana nga bw’asaasira abaana be,","poem":1},{"text":"ne Mukama bw’atyo bw’asaasira abo abamutya.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kubanga amanyi nga bwe twakolebwa","poem":1},{"text":"era ng’ajjukira nti tuli nfuufu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wabula omuntu, ennaku z’obulamu bwe ziri ng’omuddo;","poem":1},{"text":"akula n’agimuka ng’ekimuli eky’omu nnimiro;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"empewo ekifuuwa, ne kifa;","poem":1},{"text":"nga ne we kyali tewakyajjukirwa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Naye okwagala kwa Katonda eri abo abamutya tekuggwaawo","poem":1},{"text":"emirembe gyonna,","poem":2},{"lineBreak":true},{"text":"n’obulokozi bwe eri abaana b’abaana baabwe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Be bo abakuuma endagaano ye","poem":1},{"text":"ne bajjukira okugondera amateeka ge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mukama anywezezza entebe ye ey’obwakabaka mu ggulu,","poem":1},{"text":"n’obwakabaka bwe bufuga ensi yonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mwebaze Mukama mmwe bamalayika be,","poem":1},{"text":"mmwe ab’amaanyi abakola ky’agamba,","poem":2},{"lineBreak":true},{"text":"era abagondera ekigambo kye.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mwebaze Mukama mmwe amaggye ge ag’omu ggulu,","poem":1},{"text":"mmwe abaweereza be abakola by’ayagala.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mwebaze Mukama, mmwe ebitonde bye byonna","poem":1},{"text":"ebiri mu matwale ge gonna.","poem":2},{"lineBreak":true},{"text":"Weebaze Mukama, ggwe emmeeme yange.","poem":1}]}],"footnotes":[{"noteId":22,"caller":"+","text":"Empungu emanyiddwa olw’amaanyi gaayo n’olw’obuwangaazi bwayo.","reference":{"chapter":103,"verse":5}}]},"thisChapterLink":"/api/lug_bib/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}