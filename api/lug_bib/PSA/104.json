{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":104,"content":[{"type":"verse","number":1,"content":[{"text":"Weebaze Mukama, ggwe emmeeme yange.","poem":1},{"lineBreak":true},{"text":"Ayi Mukama Katonda wange, oli mukulu nnyo;","poem":1},{"text":"ojjudde obukulu n’ekitiibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yeebika ekitangaala ng’ayeebikka ekyambalo","poem":1},{"text":"n’abamba eggulu ng’eweema,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"n’ateeka akasolya k’ebisulo bye eby’oku ntikko kungulu ku mazzi;","poem":2},{"text":"ebire abifuula amagaali ge,","poem":1},{"text":"ne yeebagala ebiwaawaatiro by’empewo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Afuula empewo ababaka be,","poem":1},{"text":"n’ennimi z’omuliro ogwaka abaweereza be.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yassaawo ensi ku misingi gyayo;","poem":1},{"text":"teyinza kunyeenyezebwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wagibikkako obuziba ng’ekyambalo;","poem":1},{"text":"amazzi ne gatumbiira okuyisa ensozi ennene.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bwe wagaboggolera ne gadduka;","poem":1},{"text":"bwe gaawulira okubwatuka kwo ne gaddukira ddala;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"gaakulukutira ku nsozi ennene,","poem":1},{"text":"ne gakkirira wansi mu biwonvu","poem":2},{"lineBreak":true},{"text":"mu bifo bye wagategekera.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wagassizaawo ensalo ze gatasaana kusukka,","poem":1},{"text":"na kuddayo kubuutikira nsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Alagira ensulo ne zisindika amazzi mu biwonvu;","poem":1},{"text":"ne gakulukutira wakati w’ensozi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne ganywesa ebisolo byonna eby’omu nsiko;","poem":1},{"text":"n’endogoyi ne gazimalako ennyonta.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ebinyonyi eby’omu bbanga bizimba ebisu byabyo ku mabbali g’amazzi,","poem":1},{"text":"ne biyimbira mu matabi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Afukirira ensozi ennene ng’osinziira waggulu gy’obeera;","poem":1},{"text":"ensi n’ekkuta ebibala by’emirimu gyo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Olagira omuddo ne gukula okuliisa ente,","poem":1},{"text":"n’ebirime abantu bye balima,","poem":2},{"lineBreak":true},{"text":"balyoke bafune ebyokulya okuva mu ttaka.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ne wayini okusanyusa omutima gwe,","poem":1},{"text":"n’ebizigo okwesiiga awoomye endabika ye,","poem":2},{"lineBreak":true},{"text":"n’emmere okumuwa obulamu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Emiti gya Mukama gifuna amazzi mangi;","poem":1},{"text":"gy’emivule gy’e Lebanooni gye yasimba.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Omwo ebinyonyi mwe bizimba ebisu byabyo;","poem":1},{"text":"ne ssekanyolya asula mu miti omwo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ku nsozi empanvu eyo embulabuzi ez’omu nsiko gye zibeera;","poem":1},{"text":"n’enjazi kye kiddukiro ky’obumyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Wakola omwezi okutegeeza ebiro;","poem":1},{"text":"n’enjuba bw’egwa n’eraga olunaku.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Oleeta ekizikiza, ne buba ekiro;","poem":1},{"text":"olwo ebisolo byonna eby’omu bibira ne biryoka bivaayo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Empologoma ento zikaabira emmere gye zinaalya;","poem":1},{"text":"nga zinoonya ebyokulya okuva eri Katonda.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Enjuba bw’evaayo ne zigenda, n’oluvannyuma","poem":1},{"text":"ne zikomawo ne zigalamira mu mpuku zaazo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Abantu ne bagenda ku mirimu gyabwe,","poem":1},{"text":"ne bakola okutuusa akawungeezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ayi Mukama, ebintu bye wakola nga bingi nnyo!","poem":1},{"text":"Byonna wabikola n’amagezi ag’ekitalo;","poem":2},{"lineBreak":true},{"text":"ensi ejjudde ebitonde byo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Waliwo ennyanja, nnene era ngazi,","poem":1},{"text":"ejjudde ebitonde ebitabalika,","poem":2},{"lineBreak":true},{"text":"ebintu ebirina obulamu ebinene era n’ebitono.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Okwo amaato kwe gaseeyeeyera nga galaga eno n’eri;","poem":1},{"text":"ne galukwata ge wakola mwe gabeera okuzannyiranga omwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ebyo byonna bitunuulira ggwe","poem":1},{"text":"okubiwa emmere yaabyo ng’ekiseera kituuse.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Bw’ogibiwa,","poem":1},{"text":"nga bigikuŋŋaanya;","poem":2},{"text":"bw’oyanjuluza engalo zo n’obigabira ebintu ebirungi","poem":1},{"text":"ne bikkusibwa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Bw’okweka amaaso go","poem":1},{"text":"ne byeraliikirira nnyo;","poem":2},{"text":"bw’obiggyamu omukka nga bifa,","poem":1},{"text":"nga biddayo mu nfuufu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Bw’oweereza Omwoyo wo,","poem":1},{"text":"ne bifuna obulamu obuggya;","poem":2},{"lineBreak":true},{"text":"olwo ensi n’ogizza buggya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ekitiibwa kya Katonda kibeerengawo emirembe gyonna;","poem":1},{"text":"era Mukama asanyukirenga ebyo bye yakola.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Atunuulira ensi, n’ekankana;","poem":1},{"text":"bw’akwata ku nsozi ennene, ne zinyooka omukka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Nnaayimbiranga Mukama obulamu bwange bwonna;","poem":1},{"text":"nnaayimbanga nga ntendereza Katonda wange ennaku zonna ze ndimala nga nkyali mulamu.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ebirowoozo byange, nga nfumiitiriza, bimusanyusenga;","poem":1},{"text":"kubanga mu Mukama mwe neeyagalira.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Naye abakola ebibi baggweewo ku nsi;","poem":1},{"text":"aboonoonyi baleme kulabikirako ddala.","poem":2},{"lineBreak":true},{"text":"Weebaze Mukama, gwe emmeeme yange.","poem":1},{"lineBreak":true},{"text":"Mumutenderezenga Mukama.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}