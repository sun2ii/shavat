{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":105,"content":[{"type":"verse","number":1,"content":[{"text":"Mwebaze Mukama, mukoowoole erinnya lye;","poem":1},{"text":"amawanga gonna mugategeeze by’akoze.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mumuyimbire, mumutendereze;","poem":1},{"text":"muyimbe ku byamagero bye.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mumusuute, ng’erinnya lye ettukuvu muligulumiza;","poem":1},{"text":"emitima gy’abo abanoonya Mukama gijjule essanyu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Munoonye Mukama n’amaanyi ge;","poem":1},{"text":"mumunoonyenga ennaku zonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mujjukirenga eby’ekitalo bye yakola,","poem":1},{"text":"ebyamagero bye, n’emisango gye yasala;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"mmwe abazzukulu ba Ibulayimu, abaweereza be","poem":1},{"text":"mmwe abaana ba Yakobo, abalonde be.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ye Mukama Katonda waffe;","poem":1},{"text":"ye alamula mu nsi yonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ajjukira endagaano ye emirembe gyonna,","poem":1},{"text":"kye kigambo kye yalagira, ekyakamala emirembe olukumi,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ye ndagaano gye yakola ne Ibulayimu,","poem":1},{"text":"era kye kisuubizo kye yalayirira Isaaka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yakikakasa Yakobo ng’etteeka,","poem":1},{"text":"n’akiwa Isirayiri ng’endagaano eteriggwaawo nti,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Ndikuwa ggwe ensi ya Kanani","poem":1},{"text":"okuba omugabo gwo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bwe baali bakyali batono,","poem":1},{"text":"nga si bangi n’akamu, era nga bagwira mu nsi omwo,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"baatambulatambulanga okuva mu ggwanga erimu okulaga mu ddala,","poem":1},{"text":"ne bavanga mu bwakabaka obumu ne balaga mu bulala.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Teyaganya muntu yenna kubayisa bubi;","poem":1},{"text":"n’alabulanga bakabaka ku lwabwe nti,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Abalonde bange,","poem":1},{"text":"ne bannabbi bange temubakolangako kabi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yaleeta enjala mu nsi,","poem":1},{"text":"emmere yaabwe yonna n’agizikiriza.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"N’atuma omuntu okubeesooka mu maaso,","poem":1},{"text":"ye Yusufu eyatundibwa ng’omuddu,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ebigere bye ne binuubulwa enjegere ze baamusibya,","poem":1},{"text":"obulago bwe ne buteekebwa mu byuma,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"okutuusa bye yategeeza lwe byatuukirira,","poem":1},{"text":"okutuusa ekigambo kya Mukama lwe kyamukakasa nti bye yayogera bya mazima.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kabaka n’atuma ne bamusumulula;","poem":1},{"text":"omufuzi w’ensi eyo yamuggya mu kkomera.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yamufuula omukulu w’eby’omu maka ge,","poem":1},{"text":"n’akulira byonna omufuzi oyo bye yalina;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"okukangavvulanga abalangira be nga bwe yalabanga,","poem":1},{"text":"n’okuyigiriza abakulu eby’amagezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Oluvannyuma Isirayiri n’ajja mu Misiri;","poem":1},{"text":"Yakobo bw’atyo n’atuula mu nsi ya Kaamu nga munnaggwanga.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mukama n’ayaza nnyo abantu be;","poem":1},{"text":"ne baba bangi nnyo, n’abalabe baabwe ne beeraliikirira,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"n’akyusa emitima gyabwe ne bakyawa abantu be,","poem":1},{"text":"ne basalira abaweereza be enkwe.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Yatuma abaweereza be Musa","poem":1},{"text":"ne Alooni, be yalonda.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ne bakola obubonero bwe obw’ekitalo mu bantu abo;","poem":1},{"text":"ne bakolera ebyamagero bye mu nsi ya Kaamu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Yaleeta ekizikiza ensi yonna n’ekwata,","poem":1},{"text":"kubanga baali bajeemedde ekigambo kye.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Amazzi gaabwe yagafuula omusaayi,","poem":1},{"text":"ne kireetera ebyennyanja byabwe okufa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ensi yaabwe yajjula ebikere,","poem":1},{"text":"ebyatuukira ddala ne mu bisenge by’abafuzi baabwe.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Yalagira, ebiwuka ebya buli ngeri ne bijja,","poem":1},{"text":"n’ensekere ne zeeyiwa mu bitundu byonna eby’ensi yaabwe.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Yafuula enkuba okuba amayinja g’omuzira;","poem":1},{"text":"eggulu ne libwatuka mu nsi yaabwe yonna.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Yakuba emizeeyituuni n’emizabbibu,","poem":1},{"text":"n’azikiriza emiti gy’omu nsi yaabwe.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Yalagira, enzige ne zijja","poem":1},{"text":"ne bulusejjera obutabalika muwendo.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ne birya buli kimera kyonna mu nsi yaabwe,","poem":1},{"text":"na buli kisimbe kyonna mu ttaka lyabwe ne kiriibwa.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"N’azikiriza abaana ababereberye bonna mu nsi yaabwe,","poem":1},{"text":"nga bye bibala ebisooka eby’obuvubuka bwabwe.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Yaggya Abayisirayiri mu nsi eyo nga balina ffeeza nnyingi ne zaabu;","poem":1},{"text":"era bonna baali ba maanyi.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Abamisiri baasanyuka bwe baalaba Abayisirayiri nga bagenze,","poem":1},{"text":"kubanga baali batandise okubatiira ddala.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Yayanjuluzanga ekire ne kibabikka,","poem":1},{"text":"n’omuliro ne gubamulisiza ekiro.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Baamusaba, n’abaweereza enkwale","poem":1},{"text":"era n’abaliisanga emmere eva mu ggulu ne bakkuta.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Yayasa olwazi, amazzi ne gatiiriika,","poem":1},{"text":"ne gakulukuta mu ddungu ng’omugga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":42,"content":[{"text":"Kubanga yajjukira ekisuubizo kye ekitukuvu","poem":1},{"text":"kye yawa omuweereza we Ibulayimu.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Abantu be yabaggyayo nga bajaguza,","poem":1},{"text":"abalonde be nga bayimba olw’essanyu.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Yabawa ensi eyali ey’amawanga amalala,","poem":1},{"text":"ne basikira ebyo abalala bye baakolerera;","poem":2}]},{"type":"verse","number":45,"content":[{"text":"balyoke bakwatenga amateeka ge,","poem":1},{"text":"era bagonderenga ebiragiro bye.","poem":2},{"lineBreak":true},{"text":"Mumutendereze Mukama.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":45}