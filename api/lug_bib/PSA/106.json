{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":106,"content":[{"type":"verse","number":1,"content":[{"text":"Mumutendereze Mukama!","poem":1},{"lineBreak":true},{"text":"Mwebaze Mukama kubanga mulungi,","poem":1},{"text":"kubanga okwagala kwe tekuggwaawo emirembe gyonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ani ayinza okwogera ku bikulu Mukama by’akola n’abimalayo,","poem":1},{"text":"oba okumutendereza obulungi nga bw’asaanira?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Balina omukisa abalina obwenkanya,","poem":1},{"text":"era abakola ebituufu bulijjo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Onzijukiranga, Ayi Mukama, bw’obanga okolera abantu bo ebirungi;","poem":1},{"text":"nange onnyambe bw’olibalokola,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ndyoke neeyagalire wamu n’abalonde bo nga bafunye ebirungi,","poem":1},{"text":"nsanyukire wamu n’eggwanga lyo,","poem":2},{"lineBreak":true},{"text":"era ntendererezenga mu bantu bo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Twonoonye, nga bajjajjaffe bwe baakola;","poem":1},{"text":"tukoze ebibi ne tusobya nnyo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bakadde baffe","poem":1},{"text":"tebaafaayo kujjukira ebyamagero bye wakola nga bali mu Misiri;","poem":2},{"text":"n’ebyekisa ebingi bye wabakolera tebaabijjukira,","poem":1},{"text":"bwe baatuuka ku Nnyanja Emyufu ne bakujeemera.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Naye Mukama n’abalokola, olw’erinnya lye,","poem":1},{"text":"alyoke amanyise amaanyi g’obuyinza bwe obungi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yaboggolera Ennyanja Emyufu, n’ekalira;","poem":1},{"text":"n’abakulembera okubayisa mu buziba ng’abayita ku lukalu mu ddungu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yabawonya abalabe baabwe;","poem":1},{"text":"n’abanunula mu mikono gy’abo ababakyawa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amazzi ne gabuutikira abalabe baabwe;","poem":1},{"text":"ne wataba n’omu awona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Olwo ne bakkiriza ebigambo bye, bye yabasuubiza;","poem":1},{"text":"ne bayimba nga bamutendereza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Waayita akabanga katono ne beerabira ebyo byonna bye yakola;","poem":1},{"text":"ne batawulirizanga kubuulirira kwe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bwe baatuuka mu ddungu, okwegomba ne kubasukkirira;","poem":1},{"text":"ne bagezesa Katonda nga bali mu lukoola olwo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bw’atyo n’abawa kye baasaba,","poem":1},{"text":"kyokka n’abaleetera n’olumbe olw’amaanyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nga bali mu lusiisira baakwatirwa obuggya eri Musa","poem":1},{"text":"ne Alooni abalonde ba Mukama.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ettaka ne lyasama ne limira Dasani;","poem":1},{"text":"Abiraamu ne banne ne libasaanyaawo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Omuliro ne gukoleera ne gukwata abagoberezi baabwe;","poem":1},{"text":"ennimi z’omuliro ne zookya aboonoonyi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bwe baali e Kolebu ne beekolera ennyana;","poem":1},{"text":"ne basinza ekifaananyi ekyo kye baakola mu byuma bye baasaanuusa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ekitiibwa kya Katonda","poem":1},{"text":"ne bakiwaanyisaamu ekibumbe ekifaanana ente erya omuddo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ne beerabira Katonda eyabanunula,","poem":1},{"text":"eyabakolera ebintu ebikulu bwe bityo mu Misiri,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ebyamagero bye yabakolera mu nsi ya Kaamu,","poem":1},{"text":"n’ebikolwa eby’entiisa ku Nnyanja Emyufu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"N’agamba nti,","poem":1},{"text":"Ajja kubazikiriza.","poem":2},{"text":"Naye Musa, omulonde we, n’ayimirira mu maaso ge","poem":1},{"text":"n’amwegayirira, obusungu bwe ne bumuggwaako n’atabazikiriza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Baanyooma eby’ensi ennungi,","poem":1},{"text":"kubanga ekisuubizo kye tebaakirinaamu bwesige.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Beemulugunyiriza mu weema zaabwe,","poem":1},{"text":"ne batagondera ddoboozi lya Mukama.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kyeyava yeerayirira","poem":1},{"text":"nti alibazikiririza mu ddungu,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"era nga n’abaana baabwe","poem":1},{"text":"balisaasaanira mu mawanga ne bafiira eyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Baatandika okusinza Baali e Peoli;","poem":1},{"text":"ne balya ebyaweebwangayo eri bakatonda abataliimu bulamu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ne banyiiza Katonda olw’ebikolwa byabwe ebibi;","poem":1},{"text":"kawumpuli kyeyava abagwamu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Naye Finekaasi n’ayimirira wakati waabwe ne Katonda,","poem":1},{"text":"kawumpuli n’agenda.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ekyo ne kimubalirwa nga kya butuukirivu","poem":1},{"text":"emirembe gyonna.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Bwe baatuuka okumpi n’amazzi ag’e Meriba ne banyiiza Mukama,","poem":1},{"text":"ne baleetera Musa emitawaana;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"kubanga baajeemera ebiragiro bye,","poem":1},{"text":"ne kimwogeza n’ebigambo ebitaali bya magezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Abantu be baalwanyisa tebaabazikiriza","poem":1},{"text":"nga Mukama bwe yali abalagidde,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"naye beetabika n’abannaggwanga ago","poem":1},{"text":"ne bayiga empisa zaabwe.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Baasinza ebifaananyi ebikole n’emikono eby’amawanga ago","poem":1},{"text":"ne bibafuukira omutego.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Baawaayo batabani baabwe","poem":1},{"text":"ne bawala baabwe eri bakatonda abo.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ne bayiwa omusaayi gwa batabani baabwe ne bawala baabwe","poem":1},{"text":"abataliiko musango,","poem":2},{"text":"be baawangayo eri ebifaananyi ebikole n’emikono Abakanani bye baakola,","poem":1},{"text":"ensi n’eyonoonebwa n’omusaayi gwabwe.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Beeyonoona olw’ebyo bye baakola,","poem":1},{"text":"ebikolwa byabwe ne bibafuula abataliimu nsa nga bavudde ku Katonda waabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Mukama kyeyava asunguwalira abantu be,","poem":1},{"text":"n’akyawa ezzadde lye.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"N’abawaayo eri amawanga amalala,","poem":1},{"text":"abalabe ne babafuga.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Abalabe baabwe ne babanyigiriza,","poem":1},{"text":"ne babatuntuza nnyo ddala.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Yabawonyanga abalabe baabwe emirundi mingi,","poem":1},{"text":"naye obujeemu ne bubalemeramu,","poem":2},{"lineBreak":true},{"text":"ebibi byabwe ne bigenda nga bibasaanyaawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"Naye bwe yawulira okukaaba kwabwe,","poem":1},{"text":"n’abakwatirwa ekisa;","poem":2}]},{"type":"verse","number":45,"content":[{"text":"ku lwabwe, n’ajjukira endagaano ye;","poem":1},{"text":"okwagala kwe okungi ne kumuleetera okukyusa ekirowoozo kye.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"N’abaleetera okusaasirwa","poem":1},{"text":"abo abaabawambanga.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Ayi Mukama Katonda,","poem":1},{"text":"otulokole, otukuŋŋaanye, otuggye mu mawanga,","poem":2},{"text":"tulyoke twebazenga erinnya lyo ettukuvu,","poem":1},{"text":"era tusanyukenga nga tukutendereza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"Mukama atenderezebwenga, Katonda wa Isirayiri,","poem":1},{"text":"emirembe n’emirembe.","poem":2},{"lineBreak":true},{"text":"Abantu bonna ka boogere nti, “Amiina!”","poem":1},{"lineBreak":true},{"text":"Mumutendereze Mukama.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}