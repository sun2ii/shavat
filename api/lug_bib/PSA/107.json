{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":107,"content":[{"type":"verse","number":1,"content":[{"text":"Mwebaze Mukama, kubanga mulungi;","poem":1},{"text":"okwagala kwe kubeerera emirembe gyonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kale abanunule ba Mukama boogere bwe batyo;","poem":1},{"text":"abo be yanunula mu mikono gy’abalabe;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"abo be yakuŋŋaanya mu mawanga; okuva Ebugwanjuba n’Ebuvanjuba,","poem":1},{"text":"n’okuva obukiikakkono ne mu bukiikaddyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Abamu baataataaganira mu malungu","poem":1},{"text":"nga babuliddwa ekkubo eribatwala ku kibuga gye banaabeeranga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Baalumwa ennyonta n’enjala,","poem":1},{"text":"obulamu bwabwe ne butandika okusereba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bwe batyo ne bakaabira Mukama nga bali mu kabi;","poem":1},{"text":"n’abawonya mu kweraliikirira kwabwe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yabakulembera butereevu","poem":1},{"text":"n’abatuusa mu kibuga mwe baabeera.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kale singa beebazanga Mukama olw’okwagala kwe okutaggwaawo,","poem":1},{"text":"n’olw’eby’ekitalo by’akolera abaana b’abantu!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kubanga abalina ennyonta abanywesa,","poem":1},{"text":"n’abayala abakkusa ebirungi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Abamu baatuulanga mu kizikiza ne mu kisiikirize eky’okufa;","poem":1},{"text":"abasibiddwa mu byuma era abali mu nnaku ennyingi;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"kubanga baajeemera ekigambo kya Katonda,","poem":1},{"text":"ne banyoomoola amagezi g’oyo Ali Waggulu Ennyo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Baakozesebwa emirimu egy’amaanyi, emitima gyabwe ne gijjula obuyinike;","poem":1},{"text":"baagwanga wansi, naye nga tebalina abasitulawo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bwe batyo ne bakaabirira Mukama nga bali mu bizibu byabwe,","poem":1},{"text":"era n’abawonya;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"n’abaggya mu kizikiza ne mu kisiikirize eky’okufa;","poem":1},{"text":"n’enjegere ezaali zibasibye n’azikutula.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kale singa beebazanga Mukama olw’okwagala kwe okutaggwaawo,","poem":1},{"text":"n’olwebikolwa bye eby’ekitalo by’akolera abaana b’abantu!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kubanga enzigi ez’ebikomo azaasaayasa,","poem":1},{"text":"n’emitayimbwa egy’ekyuma agimenyamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Abamu baafuuka basirusiru olw’obujeemu bwabwe;","poem":1},{"text":"ne babonaabona olw’ebikolwa byabwe ebibi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ne batamwa emmere yonna, ne babulako katono ddala okufa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Bwe batyo ne bakaabirira Mukama nga bali mu buzibu obwo,","poem":1},{"text":"n’abawonya.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yabatumira ekigambo kye, n’awonya endwadde zaabwe;","poem":1},{"text":"n’abalokola mu kuzikirira.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kale singa beebazanga Mukama olw’okwagala kwe okutaggwaawo,","poem":1},{"text":"n’olw’ebikolwa bye eby’ekyewuunyo by’akolera abaana b’abantu!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bamuleeterenga ebiweebwayo eby’okwebaza,","poem":1},{"text":"era batendenga ebikolwa bye n’ennyimba ez’essanyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Abalala baasaabalira mu maato ku nnyanja;","poem":1},{"text":"baali basuubuzi b’oku gayanja aganene.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Baalaba Mukama bye yakola,","poem":1},{"text":"ebikolwa bye eby’ekitalo mu buziba bw’ennyanja.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kubanga yalagira omuyaga","poem":1},{"text":"ne gusitula amayengo waggulu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ne gagulumira okutuuka ku ggulu, ate ne gakka wansi mu ddubi;","poem":1},{"text":"akabenje ne kabayitirira, ne baggwaamu amaanyi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ne beesunda, eruuyi n’eruuyi ne baba ng’omutamiivu atagala;","poem":1},{"text":"n’amagezi ne gabaggwaako.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Bwe batyo ne bakaabira Mukama nga bali mu buzibu;","poem":1},{"text":"n’abawonya mu kweraliikirira kwabwe.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Omuyaga yagusirisa,","poem":1},{"text":"ennyanja n’etteeka.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ne bajjula essanyu kubanga ennyanja yateeka;","poem":1},{"text":"n’abakulembera n’abatuusa bulungi ku mwalo gwabwe.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kale singa abantu beebazanga Mukama olw’okwagala kwe okutaggwaawo,","poem":1},{"text":"n’olw’ebikolwa bye eby’ekyewuunyo by’akolera abaana b’abantu!","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Bamugulumizenga ng’abantu bakuŋŋaanye,","poem":1},{"text":"era bamutenderezenga mu lukiiko lw’abakulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Afuula emigga amalungu,","poem":1},{"text":"n’emikutu gy’amazzi ne giba ng’ettaka ekkalu,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ensi engimu n’agifuula olukoola olw’olunnyo","poem":1},{"text":"olw’obwonoonyi bw’abantu baamu.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Eddungu yalijjuza ebidiba by’amazzi,","poem":1},{"text":"n’ensi enkalu n’agikulukusizaamu amazzi,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"abalina enjala n’abateeka omwo,","poem":1},{"text":"ne beezimbira ekibuga eky’okubeeramu,","poem":2}]},{"type":"verse","number":37,"content":[{"text":"ennimiro zaabwe ne bazisigamu emmere, ne basimba emizabbibu,","poem":1},{"text":"ne bakungula ebibala bingi.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Yabawa omukisa gwe, ne beeyongera obungi;","poem":1},{"text":"n’ebisibo byabwe n’atabiganya kukendeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Ate ne bakendeera obungi, ne bakkakkanyizibwa","poem":1},{"text":"olw’okujeezebwa, n’okujoogebwa n’okulaba ennaku;","poem":2}]},{"type":"verse","number":40,"content":[{"text":"oyo anyooma n’abakungu,","poem":1},{"text":"n’ababungeetanyiza mu lukoola omutali kantu.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Naye abaali mu kwetaaga yabamalako ennaku n’okubonaabona,","poem":1},{"text":"n’ayaza ezzadde lyabwe ng’ebisibo.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Abagolokofu, bino babiraba ne basanyuka;","poem":1},{"text":"naye abakola ebibi bo basirika busirisi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Abalina amagezi bonna, bagondere ebigambo bino","poem":1},{"text":"era bategeere okwagala kwa Mukama okutaggwaawo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":43}