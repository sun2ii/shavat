{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"hebrew_subtitle","content":["Oluyimba. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Omutima gwange munywevu, Ayi Katonda;","poem":1},{"text":"nnaayimbanga ne nkutendereza n’omwoyo gwange gwonna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Muzuukuke, mmwe entongooli n’ennanga ey’enkoba,","poem":1},{"text":"nzija kuyimba okukeesa obudde.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nnaakutenderezanga, Ayi Mukama, mu bantu bonna,","poem":1},{"text":"nnaakuyimbiranga mu mawanga gonna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Okwagala kwo kunene, kutumbiira okutuuka ku ggulu;","poem":1},{"text":"n’obwesigwa bwo butuuka ku bire.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ogulumizibwenga, Ayi Katonda, okuyisa eggulu;","poem":1},{"text":"n’ekitiibwa kyo kibune ensi yonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tulokole otuyambe n’omukono gwo ogwa ddyo,","poem":1},{"text":"abo booyagala banunulibwe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Katonda ayogedde ng’asinziira mu kifo kye ekitukuvu n’agamba nti,","poem":1},{"text":"“Nga nzijudde essanyu, ndisala mu Sekemu,","poem":2},{"lineBreak":true},{"text":"era n’Ekiwonvu kya Sukkosi ndikigabanyagabanyaamu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ensi ya Gireyaadi yange, n’eya Manase nayo yange.","poem":1},{"text":"Efulayimu mwe muli abalwanyi bange abazira;","poem":2},{"lineBreak":true},{"text":"ate mu Yuda mwe munaavanga bakabaka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mowaabu be baweereza bange abawulize;","poem":1},{"text":"ate Edomu be baddu bange;","poem":2},{"lineBreak":true},{"text":"Abafirisuuti ndibaleekaanira mu ddoboozi ery’omwanguka ery’obuwanguzi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ani anantuusa ku kibuga ekigumu ekinywevu?","poem":1},{"text":"Ani anankulembera okunnyingiza mu Edomu?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Si ggwe, ayi Katonda, atusudde,","poem":1},{"text":"atakyatabaala n’amaggye gaffe?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tudduukirire nga tulwanyisa abalabe baffe,","poem":1},{"text":"kubanga obuyambi bw’abantu temuli nsa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bwe tunaabeeranga ne Katonda tunaabanga bawanguzi;","poem":1},{"text":"kubanga y’anaalinnyiriranga abalabe baffe wansi w’ebigere bye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}