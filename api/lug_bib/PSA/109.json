{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":109,"content":[{"type":"hebrew_subtitle","content":["Ya Makulu wa Bayimbi. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Ayi Katonda wange gwe ntendereza,","poem":1},{"text":"tonsiriikirira.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kubanga abantu abakola ebibi era abalimba,","poem":1},{"text":"banjogeddeko eby’obulimba.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Banfukumulidde ebigambo eby’obukyayi,","poem":1},{"text":"ne bannumbagana awatali nsonga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bwe mbalaga omukwano, bo bandaga bukyayi;","poem":1},{"text":"kyokka nze mbasabira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bwe mbakolera ebirungi bo bansasulamu bibi;","poem":1},{"text":"bwe mbalaga okwagala bo bankyawa bukyayi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mumulabire omuntu omukozi w’ebibi amwolekere;","poem":1},{"text":"wabeewo amuwawaabira.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bwe banaawoza, omusango gumusinge;","poem":1},{"text":"n’okusaba kwe kufuuke kwonoona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Aleme kuwangaala;","poem":1},{"text":"omuntu omulala amusikire.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abaana be basigalire awo nga tebaliiko kitaabwe,","poem":1},{"text":"ne mukyala we afuuke nnamwandu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abaana be bataataaganenga nga bagenda basabiriza;","poem":1},{"text":"bagobebwe ne mu bifulukwa mwe basula.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amubanja ajje awambe ebibye byonna;","poem":1},{"text":"n’abagwira bamunyageko ebintu bye byonna bye yakolerera.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Waleme kubaawo amusaasira,","poem":1},{"text":"wadde akolera abaana be ebyekisa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ezzadde lye lizikirizibwe,","poem":1},{"text":"n’amannya g’abazzukulu be gasangulwe mu ago ag’omu mulembe oguliddirira.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mukama ajjukirenga ebyonoono bya bakadde be;","poem":1},{"text":"n’ekibi kya nnyina kireme kwerabirwanga.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mukama ajjukirenga ebyonoono byabwe bulijjo,","poem":1},{"text":"n’ensi ebeerabirire ddala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kubanga talowoozangako kukolera muntu yenna kya kisa;","poem":1},{"text":"naye yayigganyanga abaavu, n’abeetaaga,","poem":2},{"lineBreak":true},{"text":"n’abanakuwavu n’abatuusa ne ku kufa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yayagalanga nnyo okukolima; kale ebikolimo bimwefuulire. Teyayagalanga mikisa; kale gimwesambire ddala!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yeeteekako okukolima ng’ekyambalo,","poem":1},{"text":"ne kumutobya ng’amazzi,","poem":2},{"lineBreak":true},{"text":"ne kuyingira mu magumba ge ng’amafuta.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kubeerenga ng’ekyambalo ky’ayambadde,","poem":1},{"text":"era ng’olukoba lwe yeesibye emirembe gyonna.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ebyo byonna y’eba ebeera empeera, Mukama gy’awa abo abandoopaloopa,","poem":1},{"text":"era abanjogerako eby’akabi ebyereere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Naye ggwe, Ayi Mukama Katonda wange,","poem":1},{"text":"nnwanirira olw’erinnya lyo;","poem":2},{"lineBreak":true},{"text":"era omponye olw’okwagala kwo okulungi okutaggwaawo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kubanga ndi mwavu era ali mu kwetaaga,","poem":1},{"text":"n’omutima gwange gunyolwa nnyo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Sikyaliwo, ndi ng’ekisiikirize eky’akawungeezi;","poem":1},{"text":"mmansuddwa eri ng’enzige.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Amaviivi gange ganafuye olw’okusiiba;","poem":1},{"text":"omubiri gwange gukozze ne guggwaamu ensa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Abandoopaloopa bansekerera;","poem":1},{"text":"bwe bandaba nga banyeenyeza omutwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Mbeera, Ayi Mukama Katonda wange!","poem":1},{"text":"Ondokole ng’okwagala kwo okutaggwaawo bwe kuli.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Baleke bategeere nti ggwe okikoze,","poem":1},{"text":"n’omukono gwo Ayi Mukama.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Balikoma, naye ggwe olimpa omukisa!","poem":1},{"text":"Leka abannumbagana baswale,","poem":2},{"lineBreak":true},{"text":"naye nze omuddu wo nga nsanyuka!","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Abandoopa baswazibwe,","poem":1},{"text":"n’ensonyi zaabwe zibabuzeeko obwekyusizo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Nneebazanga Mukama n’akamwa kange;","poem":1},{"text":"nnaamutenderezanga wakati mu kibiina ekinene.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kubanga alwanirira omunaku ali mu kwetaaga,","poem":1},{"text":"n’amuwonya abo abaagala afe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}