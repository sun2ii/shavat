{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"Mutendereze Mukama!","poem":1},{"lineBreak":true},{"text":"Nneebazanga Mukama n’omutima gwange gwonna,","poem":1},{"text":"mu lukiiko lw’abalongoofu, era ne mu lukuŋŋaana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mukama by’akola bikulu;","poem":1},{"text":"bifumiitirizibwako abo bonna ababisanyukira.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Emirimu gye mikulu nnyo era gya kitiibwa,","poem":1},{"text":"n’obutuukirivu bwe tebuggwaawo emirembe gyonna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ayamba abantu okujjukira ebyamagero bye,","poem":1},{"text":"Mukama wa kisa era ajjudde okusaasira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Agabira abamutya emmere;","poem":1},{"text":"era ajjukira endagaano ye buli kiseera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Abantu be abalaze ng’ebikolwa bye bwe biri eby’amaanyi;","poem":1},{"text":"n’abagabira ensi eyali ey’abannaggwanga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"By’akola byonna bya bwesigwa era bya bwenkanya;","poem":1},{"text":"n’amateeka ge gonna ga bwesigwa,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"manywevu emirembe gyonna;","poem":1},{"text":"era yagassaawo nga ga bwesigwa era nga ga mazima.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yanunula abantu be;","poem":1},{"text":"n’alagira endagaano ye ebeerewo emirembe gyonna.","poem":2},{"lineBreak":true},{"text":"Erinnya lye ttukuvu era lya ntiisa!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mu kutya Mukama amagezi mwe gasookera","poem":1},{"text":"era abo abagondera ebigambo ebyo bajjudde obutegeevu.","poem":2},{"lineBreak":true},{"text":"Mukama atenderezebwenga emirembe gyonna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}