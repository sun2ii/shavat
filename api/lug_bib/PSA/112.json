{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"Mutendereze Mukama!","poem":1},{"noteId":24},{"lineBreak":true},{"text":"Alina omukisa omuntu atya Katonda,","poem":1},{"text":"era asanyukira ennyo mu mateeka ge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Abaana be baliba ba kitiibwa mu nsi;","poem":1},{"text":"omulembe gw’abalongoofu guliweebwa omukisa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ennyumba ye enejjulanga ebintu n’obugagga obungi;","poem":1},{"text":"era anaabanga mutuukirivu ennaku zonna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne mu kizikiza, ekitangaala kyakira omulongoofu,","poem":1},{"text":"alina ekisa, n’oyo alina okusaasira, era omutuukirivu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Omuntu oyo agabira abeetaaga, era tawolera magoba,","poem":1},{"text":"era akola emirimu gye gyonna n’obwenkanya, alifuna ebirungi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Omutuukirivu talinyeenyezebwa,","poem":1},{"text":"era anajjukirwanga ennaku zonna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Amawulire amabi tegaamutiisenga,","poem":1},{"text":"kubanga omutima gwe munywevu gwesiga Mukama.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Omutima gwe guteredde, tewali ky’anaatyanga,","poem":1},{"text":"era oluvannyuma alitunuulira abalabe be n’amaaso ag’obuwanguzi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Agabidde abaavu bye beetaaga;","poem":1},{"text":"mutuukirivu ebbanga lyonna;","poem":2},{"lineBreak":true},{"text":"era bonna banaamussangamu ekitiibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Omubi anaabirabanga ebyo, n’asunguwala,","poem":1},{"text":"n’aluma abugigi, naye nga talina kya kukola.","poem":2},{"lineBreak":true},{"text":"Okwegomba kw’ababi tekuubengako kye kubagasa.","poem":2}]}],"footnotes":[{"noteId":24,"caller":"+","text":"Mu Lwebbulaniya Aleruuya","reference":{"chapter":112,"verse":1}}]},"thisChapterLink":"/api/lug_bib/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}