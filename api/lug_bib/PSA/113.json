{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Mutendereze Mukama!","poem":1},{"lineBreak":true},{"text":"Mumutendereze, mmwe abaweereza be,","poem":1},{"text":"mutendereze erinnya lya Mukama.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Erinnya lya Mukama litenderezebwe","poem":1},{"text":"okuva leero n’okutuusa emirembe gyonna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Enjuba weeviirayo okutuusa bw’egwa,","poem":1},{"text":"erinnya lya Mukama litenderezebwenga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mukama agulumizibwa okusinga amawanga gonna,","poem":1},{"text":"era n’ekitiibwa kye kisinga eggulu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ani afaanana nga Mukama Katonda waffe,","poem":1},{"text":"atuula ku ntebe ye ey’obwakabaka eri waggulu ennyo,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ne yeetoowaza","poem":1},{"text":"okutunuulira eggulu n’ensi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Abaavu abayimusa n’abaggya mu nfuufu;","poem":1},{"text":"n’abali mu kwetaaga n’abasitula ng’abaggya mu vvu,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"n’abatuuza wamu n’abalangira,","poem":1},{"text":"awamu n’abalangira abo abafuga abantu be.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Omukazi omugumba amuwa abaana,","poem":1},{"text":"n’abeera mu maka ge n’ezzadde lye ng’ajjudde essanyu.","poem":2},{"lineBreak":true},{"text":"Mutendereze Mukama!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}