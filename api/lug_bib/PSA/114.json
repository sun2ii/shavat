{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Isirayiri bwe yava mu Misiri,","poem":1},{"text":"abaana ba Yakobo abo, ne bava mu bantu abaayogeranga olulimi olutali lwabwe;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yuda n’afuuka omutukuvu wa Katonda,","poem":1},{"text":"Isirayiri n’afuuka amatwale ge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ennyanja bwe yabalaba n’edduka;","poem":1},{"text":"Omugga Yoludaani ne gudda emabega.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ensozi ne zibuukabuuka ng’endiga zisseddume,","poem":1},{"text":"n’obusozi obutono ng’obuliga obuto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ggwe ennyanja, lwaki wadduka?","poem":1},{"text":"Ggwe Yoludaani, lwaki wadda emabega?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mmwe ensozi, lwaki mwabuukabuuka ng’endiga zisseddume,","poem":1},{"text":"nammwe obusozi obutono ng’obuliga obuto?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kankana, ggwe ensi, mu maaso ga Mukama,","poem":1},{"text":"mu maaso ga Katonda wa Yakobo,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"eyafuula olwazi ekidiba eky’amazzi,","poem":1},{"text":"n’olwazi olugumu n’aluggyamu ensulo ez’amazzi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}