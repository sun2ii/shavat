{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"Si ffe, Ayi Mukama, si ffe.","poem":1},{"text":"Wabula erinnya lyo lye ligwana okuweebwanga ekitiibwa,","poem":2},{"lineBreak":true},{"text":"olw’okwagala kwo n’olw’obwesigwa bwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Lwaki amawanga gabuuza nti,","poem":1},{"text":"“Katonda waabwe ali ludda wa?”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Katonda waffe ali mu ggulu;","poem":1},{"text":"akola buli ky’ayagala.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bakatonda baabwe bakole mu ffeeza ne zaabu,","poem":1},{"text":"ebikolebwa n’emikono gy’abantu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Birina emimwa, naye tebyogera;","poem":1},{"text":"birina amaaso, naye tebiraba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Birina amatu, naye tebiwulira;","poem":1},{"text":"birina ennyindo, naye tebiwunyiriza.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Birina engalo, naye tebikwata;","poem":1},{"text":"birina ebigere, naye tebitambula;","poem":2},{"lineBreak":true},{"text":"ne mu bulago bwabyo temuvaamu ddoboozi n’akamu,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"abakozi ababikola,","poem":1},{"text":"n’abo bonna ababyesiga balibifaanana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mmwe ennyumba ya Isirayiri mwesigenga Mukama,","poem":1},{"text":"ye mubeezi wammwe era ye ngabo yammwe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mmwe ennyumba ya Alooni mwesigenga Mukama,","poem":1},{"text":"ye mubeezi wammwe era ye ngabo yammwe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mmwe abamutya, mwesigenga Mukama,","poem":1},{"text":"ye mubeezi wammwe, era ye ngabo yammwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mukama anaatujjukiranga, era anaatuwanga omukisa.","poem":1},{"text":"Ab’ennyumba ya Isirayiri anaabawanga omukisa;","poem":2},{"lineBreak":true},{"text":"ab’omu nnyumba ya Alooni anaabawanga omukisa;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"n’abo abamutya, ab’ekitiibwa n’abatali ba kitiibwa,","poem":1},{"text":"Mukama anaabawanga omukisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mukama abaaze mweyongere nnyo obungi,","poem":1},{"text":"mmwe n’abaana bammwe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mukama, eyakola eggulu n’ensi,","poem":1},{"text":"abawe omukisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Eggulu ery’oku ntikko lya Mukama,","poem":1},{"text":"naye ensi yagiwa abantu bonna.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abafu tebatendereza Mukama,","poem":1},{"text":"wadde abo abaserengeta emagombe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Naye ffe tunaatenderezanga Mukama,","poem":1},{"text":"okuva leero n’okutuusa emirembe gyonna.","poem":2},{"lineBreak":true},{"text":"Mutendereze Mukama!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}