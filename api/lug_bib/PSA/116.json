{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"Mukama mmwagala,","poem":1},{"text":"kubanga awulidde eddoboozi lyange n’okwegayirira kwange.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kubanga ateze okutu kwe gye ndi,","poem":1},{"text":"kyennaavanga mmukoowoola ebbanga lyonna lye ndimala nga nkyali mulamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Emiguwa gy’okufa gyansiba,","poem":1},{"text":"n’okulumwa okw’emagombe kwankwata;","poem":2},{"lineBreak":true},{"text":"ne nzijula ennaku nnyingi n’okutya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne ndyoka nkoowoola erinnya lya Mukama nti,","poem":1},{"text":"“Ayi Mukama, ndokola.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mukama wa kisa, era mutuukirivu;","poem":1},{"text":"Katonda waffe ajjudde okusaasira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mukama alabirira abantu abaabulijjo;","poem":1},{"text":"bwe nnali mu buzibu obunene, n’andokola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wummula ggwe emmeeme yange,","poem":1},{"text":"kubanga Mukama abadde mulungi gy’oli.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kubanga ggwe, Ayi Mukama, owonyezza omwoyo gwange okufa,","poem":1},{"text":"n’amaaso gange ogawonyezza okukaaba;","poem":2},{"lineBreak":true},{"text":"n’ebigere byange n’obiwonya okwesittala,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ndyoke ntambulirenga mu maaso ga Mukama","poem":1},{"text":"mu nsi ey’abalamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nakkiriza kyennava njogera nti,","poem":1},{"text":"“Numizibbwa nnyo.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ne njogera nga nterebuse nti,","poem":1},{"text":"“Abantu bonna baliraba.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mukama ndimusasula ntya","poem":1},{"text":"olw’ebirungi bye ebingi bwe bityo by’ankoledde?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nditoola ekikompe eky’obulokozi,","poem":1},{"text":"ne nkoowoola erinnya lya Mukama.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ndituukiriza obweyamo bwange eri Mukama,","poem":1},{"text":"mu maaso g’abantu be bonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Okufa kw’abatukuvu ba Mukama kwa muwendo nnyo eri Mukama.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ayi Mukama,","poem":1},{"text":"onsumuluddeko ebyansiba n’onfuula wa ddembe,","poem":2},{"lineBreak":true},{"text":"nange nnaakuweerezanga ennaku zonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ndiwaayo ekiweebwayo eky’okwebaza,","poem":1},{"text":"ne nkoowoola erinnya lya Mukama.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndituukiriza obweyamo bwange eri Mukama,","poem":1},{"text":"mu maaso g’abantu be bonna,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"mu mpya z’ennyumba ya Mukama;","poem":1},{"text":"wakati wo, ggwe Yerusaalemi.","poem":2},{"lineBreak":true},{"text":"Mutendereze Mukama.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}