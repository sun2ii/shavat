{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":118,"content":[{"type":"verse","number":1,"content":[{"text":"Mwebaze Mukama, kubanga mulungi;","poem":1},{"text":"okwagala kwe kubeerera emirembe gyonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kale Isirayiri ayogere nti,","poem":1},{"text":"“Okwagala kwa Mukama kubeerera emirembe gyonna.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"N’ab’ennyumba ya Alooni boogere nti,","poem":1},{"text":"“Okwagala kwe kubeerera emirembe gyonna.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abo abatya Mukama boogere nti,","poem":1},{"text":"“Okwagala kwe kubeerera emirembe gyonna.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bwe nnali mu nnaku empitirivu, nakoowoola Mukama,","poem":1},{"text":"n’annyanukula, n’agimponya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mukama ali ku ludda lwange, siriiko kye ntya.","poem":1},{"text":"Abantu bayinza kunkolako ki?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mukama ali nange, ye anyamba.","poem":1},{"text":"Abalabe bange nnaabatunuuliranga n’amaaso ag’obuwanguzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kirungi okwesiga Mukama","poem":1},{"text":"okusinga okwesiga omuntu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kirungi okuddukira eri Mukama","poem":1},{"text":"okusinga okwesiga abalangira.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ensi zonna zanzinda ne zinneebungulula,","poem":1},{"text":"naye mu linnya lya Mukama naziwangula.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Banneebungulula enjuuyi zonna;","poem":1},{"text":"naye mu linnya lya Mukama nabawangula.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bankuŋŋaanirako ne banneebungulula ng’enjuki;","poem":1},{"text":"naye ne basirikka ng’amaggwa agakutte omuliro;","poem":2},{"lineBreak":true},{"text":"mu linnya lya Mukama nabawangula.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bannumba n’amaanyi mangi, ne mbulako katono okugwa;","poem":1},{"text":"naye Mukama n’annyamba.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mukama ge maanyi gange, era lwe luyimba lwange,","poem":1},{"text":"afuuse obulokozi bwange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Muwulire ennyimba ez’essanyu ez’obuwanguzi,","poem":1},{"text":"nga ziyimbirwa mu weema z’abatuukirivu nti,","poem":2},{"lineBreak":true},{"text":"“Omukono gwa Mukama ogwa ddyo gutukoledde ebikulu!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Omukono gwa Mukama ogwa ddyo gugulumizibbwa;","poem":1},{"text":"omukono gwa Mukama ogwa ddyo gutukoledde ebikulu!”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sijja kufa, wabula nzija kuba mulamu,","poem":1},{"text":"ndyoke ntegeeze ebyo byonna Mukama by’akoze.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mukama ambonerezza nnyo,","poem":1},{"text":"naye tandese kufa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Munzigulirewo emiryango egy’obutuukirivu,","poem":1},{"text":"nnyingire, neebaze Mukama.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Guno gwe mulyango omunene ogwa Mukama,","poem":1},{"text":"abatuukirivu mmwe banaayingiriranga.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nkwebaza kubanga onnyanukudde","poem":1},{"text":"n’ofuuka obulokozi bwange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ejjinja abazimbi lye baagaana lye","poem":1},{"text":"lifuuse ejjinja ekkulu ery’oku nsonda.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kino Mukama ye yakikola;","poem":1},{"text":"era ffe tukiraba nga kya kitalo mu maaso gaffe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Luno lwe lunaku Mukama lw’akoze;","poem":1},{"text":"tusanyuke tulujagulizeeko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ayi Mukama tukwegayiridde, tulokole,","poem":1},{"text":"Ayi Mukama tukwegayiridde otuwe obuwanguzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Alina omukisa oyo ajja mu linnya lya Mukama.","poem":1},{"text":"Tubasabidde omukisa nga tuli mu nnyumba ya Mukama.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mukama ye Katonda,","poem":1},{"text":"y’atwakiza omusana.","poem":2},{"text":"Mukumbire wamu nga mukutte amatabi mu ngalo zammwe n’ekiweebwayo kyammwe","poem":1},{"text":"kituukire ddala ku mayembe g’ekyoto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ggwe Katonda wange, nnaakwebazanga;","poem":1},{"text":"ggwe Katonda wange, nange nnaakugulumizanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Mwebaze Mukama kubanga mulungi,","poem":1},{"text":"n’okwagala kwe kubeerera emirembe gyonna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}