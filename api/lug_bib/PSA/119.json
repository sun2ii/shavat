{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":119,"content":[{"type":"verse","number":1,"content":[{"text":"Balina omukisa abo abatambulira mu butuukirivu;","poem":1},{"text":"abatambulira mu mateeka ga Mukama.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Balina omukisa abo abagondera ebiragiro bye,","poem":1},{"text":"era abanoonya Mukama n’omutima gwabwe gwonna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abo abatasobya, era abatambulira mu makubo ge.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ggwe wateekawo ebiragiro byo;","poem":1},{"text":"n’olagira bigonderwenga n’obwegendereza bungi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ayi Mukama, nsaba mbeerenga munywevu bulijjo;","poem":1},{"text":"nga nkuuma bye walagira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bwe ntyo siriswazibwa, amaaso gange nga","poem":1},{"text":"ngasimbye ku ebyo bye walagira byonna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nga njiga ebiragiro byo ebitukuvu,","poem":1},{"text":"nnaakutenderezanga n’omutima omulungi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nnaakwatanga amateeka go;","poem":1},{"text":"Ayi Mukama, tonsuulira ddala.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Omuvubuka anaakuumanga atya ekkubo lye nga ttereevu?","poem":1},{"text":"Anaalikuumanga ng’agoberera ekigambo kyo nga bwe kiri.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nkunoonya n’omutima gwange gwonna;","poem":1},{"text":"tonzikiriza kuva ku mateeka go.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ntadde ekigambo kyo mu mutima gwange;","poem":1},{"text":"ndyoke nneme okwonoona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ogulumizibwe, Ayi Mukama;","poem":1},{"text":"onjigirize amateeka go.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Njatula n’akamwa kange","poem":1},{"text":"amateeka go gonna ge walagira.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nsanyukira okugondera ebiragiro byo,","poem":1},{"text":"ng’asanyukira eby’obugagga.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nnaafumiitirizanga ku biragiro byo,","poem":1},{"text":"ne nzisaayo omwoyo ku makubo go.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nnaasanyukiranga amateeka go,","poem":1},{"text":"era siigeerabirenga.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Omuddu wo omukolere ebirungi, mbe omulamu,","poem":1},{"text":"ngobererenga ekigambo kyo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ozibule amaaso gange, nsobole okulaba","poem":1},{"text":"eby’ekitalo ebiri mu mateeka go.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nze ndi muyise ku nsi;","poem":1},{"text":"tonkisa bye walagira.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bulijjo emmeeme yange","poem":1},{"text":"eyaayaanira amateeka go.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Onenya ab’amalala, abaakolimirwa,","poem":1},{"text":"abaleka amateeka go.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mponya okuduula kwabwe n’okunyooma kwabwe;","poem":1},{"text":"kubanga bye walagira mbigondera.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Newaakubadde ng’abalangira bansalira enkwe;","poem":1},{"text":"naye nze, omuweereza wo, nnaafumiitirizanga ku biragiro byo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Amateeka go lye ssanyu lyange,","poem":1},{"text":"era ge gannuŋŋamya.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nzigweddemu amaanyi, ndi wansi mu nfuufu;","poem":1},{"text":"nkusaba onzizeemu endasi ng’ekigambo kyo bwe kiri.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nakutegeeza bye nteesezza okukola, n’onnyanukula;","poem":1},{"text":"onjigirize amateeka go.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Njigiriza amateeka go bye gagamba,","poem":1},{"text":"nange nnaafumiitirizanga ku byamagero byo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Emmeeme empweddemu ensa olw’okunakuwala;","poem":1},{"text":"onzizeemu amaanyi ng’ekigambo kyo bwe kiri.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nzigiraako ddala ebyo ebitali bya butuukirivu;","poem":1},{"text":"olw’ekisa kyo njigiriza amateeka go.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Nonzeewo okubeera omwesigwa;","poem":1},{"text":"ntambulire mu ebyo bye walagira.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Nnyweredde ku biragiro byo, Ayi Mukama,","poem":1},{"text":"tondeka kuswazibwa.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Bw’onoosumulula omutima gwange,","poem":1},{"text":"nnaatambuliranga mu makubo go ng’ebiragiro byo bwe biri.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Njigiriza, Ayi Mukama, okugonderanga ebiragiro byo;","poem":1},{"text":"ndyoke mbinywezenga ennaku zonna ez’obulamu bwange.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Mpa okutegeera ndyoke nkuume amateeka go","poem":1},{"text":"era ngakwate n’omutima gwange gwonna.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ntambuliza mu mateeka go,","poem":1},{"text":"kubanga mwe nsanyukira.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Okyuse omutima gwange ogulaze eri ebyo bye walagira;","poem":1},{"text":"so si eri eby’okufuna ebitaliimu.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Kyusa amaaso gange galeme okunneegombesa ebitaliimu;","poem":1},{"text":"obulamu bwange obufuule obuggya ng’ekigambo kyo bwe kiri.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Tuukiriza kye wasuubiza omuddu wo,","poem":1},{"text":"kubanga ekyo kye wasuubiza abo abakutya.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Nziggyako okunyoomebwa kuno kwe ntya,","poem":1},{"text":"kubanga ebiragiro byo birungi.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Laba, njayaanira ebiragiro byo;","poem":1},{"text":"onkomyewo mu butuukirivu bwo.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Okwagala kwo okutaggwaawo kujje gye ndi, Ayi Mukama;","poem":1},{"text":"ompe obulokozi bwo nga bwe wasuubiza;","poem":2}]},{"type":"verse","number":42,"content":[{"text":"ndyoke mbeere n’eky’okwanukula abo abambonyaabonya;","poem":1},{"text":"kubanga neesiga kigambo kyo.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Toganya kigambo ekitali kya mazima okuva mu kamwa kange;","poem":1},{"text":"kubanga essuubi lyange liri mu ebyo bye walagira.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Nnaagonderanga amateeka go ennaku zonna,","poem":1},{"text":"emirembe n’emirembe.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Era nnaatambulanga n’emirembe,","poem":1},{"text":"kubanga ngoberedde ebyo bye walagira.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Era nnaayogeranga ku biragiro by’omu maaso ga bakabaka,","poem":1},{"text":"nga sikwatibwa nsonyi.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Kubanga nsanyukira amateeka go,","poem":1},{"text":"era ngaagala.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Nzisaamu nnyo ekitiibwa ebiragiro byo era mbyagala.","poem":1},{"text":"Nnaafumiitirizanga ku mateeka go.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Jjukira ekigambo kye wansuubiza, nze omuddu wo,","poem":1},{"text":"kubanga gwe wampa essuubi.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Ekiwummuza omutima gwange nga ndi mu bulumi","poem":1},{"text":"kye kisuubizo kyo ekimpa obulamu.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Ab’amalala banduulira obutamala,","poem":1},{"text":"naye nze siva ku mateeka go.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Bwe ndowooza ku biragiro byo eby’edda, Ayi Mukama,","poem":1},{"text":"biwummuza omutima gwange.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Nkyawa nnyo abakola ebibi,","poem":1},{"text":"abaleka amateeka go.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Ebiragiro byo binfuukidde ennyimba","poem":1},{"text":"buli we nsula nga ndi mu lugendo lwange.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Mu kiro nzijukira erinnya lyo, Ayi Mukama,","poem":1},{"text":"ne neekuuma amateeka go.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Olw’okukugonderanga","poem":1},{"text":"nfunye emikisa gyo mingi.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Ggwe mugabo gwange, Ayi Mukama;","poem":1},{"text":"nasuubiza okukugonderanga.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Nkwegayirira n’omutima gwange gwonna,","poem":1},{"text":"ondage ekisa kyo nga bwe wasuubiza.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Bwe ndabye amakubo amakyamu ge nkutte,","poem":1},{"text":"ne nkyuka okugoberera ebiragiro byo.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Nyanguwa nnyo okugondera amateeka go,","poem":1},{"text":"so seekunya.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"Newaakubadde ng’emiguwa gy’ababi ginsibye,","poem":1},{"text":"naye seerabirenga mateeka go.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Nzuukuka mu ttumbi okukwebaza,","poem":1},{"text":"olw’ebiragiro byo ebituukirivu.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Ntambula n’abo abakutya,","poem":1},{"text":"abo bonna abakwata amateeka go.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"Ensi, Ayi Mukama, ejjudde okwagala kwo;","poem":1},{"text":"onjigirize amateeka go.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Okoze bulungi omuddu wo, Ayi Mukama,","poem":1},{"text":"ng’ekigambo kyo bwe kiri.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Njigiriza okumanya n’okwawula ekirungi n’ekibi, era ompe okumanya;","poem":1},{"text":"kubanga nzikiririza mu mateeka go.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Bwe wali tonnambonereza nakyama nnyo,","poem":1},{"text":"naye kaakano ŋŋondera ekigambo kyo.","poem":2}]},{"type":"verse","number":68,"content":[{"text":"Ayi Mukama, oli mulungi era okola ebirungi;","poem":1},{"text":"onjigirize amateeka go.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Ab’amalala banjogeddeko nnyo eby’obulimba,","poem":1},{"text":"naye nze nkwata ebyo bye walagira, n’omutima gwange gwonna.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"Omutima gwabwe gugezze ne gusavuwala;","poem":1},{"text":"naye nze nsanyukira amateeka go.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"Okubonerezebwa kwangasa,","poem":1},{"text":"ndyoke njige amateeka go.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"Amateeka go ge walagira ga mugaso nnyo gye ndi","poem":1},{"text":"okusinga enkumi n’enkumi eza ffeeza ne zaabu.","poem":2}]},{"type":"verse","number":73,"content":[{"text":"Emikono gyo gye gyankola ne gimmumba,","poem":1},{"text":"mpa okutegeera ndyoke njige amateeka go.","poem":2}]},{"type":"verse","number":74,"content":[{"text":"Abo abakutya banandabanga ne basanyuka,","poem":1},{"text":"kubanga essuubi lyange liri mu kigambo kyo.","poem":2}]},{"type":"verse","number":75,"content":[{"text":"Mmanyi, Ayi Mukama, ng’amateeka go matukuvu,","poem":1},{"text":"era wali mutuufu okumbonereza.","poem":2}]},{"type":"verse","number":76,"content":[{"text":"Kale okwagala kwo okutaggwaawo kumbeere kumpi kunsanyuse,","poem":1},{"text":"nga bwe wansuubiza, nze omuddu wo.","poem":2}]},{"type":"verse","number":77,"content":[{"text":"Kkiriza okusaasira kwo kuntuukeko ndyoke mbeere mulamu;","poem":1},{"text":"kubanga mu mateeka go mwe nsanyukira.","poem":2}]},{"type":"verse","number":78,"content":[{"text":"Ab’amalala baswazibwe, kubanga bampisizza bubi nga siriiko kye nkoze.","poem":1},{"text":"Naye nze nnaafumiitirizanga ku biragiro byo.","poem":2}]},{"type":"verse","number":79,"content":[{"text":"Abo abakutya bajje gye ndi,","poem":1},{"text":"abategeera amateeka go.","poem":2}]},{"type":"verse","number":80,"content":[{"text":"Mbeera, omutima gwange guleme kubaako kya kunenyezebwa mu mateeka go,","poem":1},{"text":"nneme kuswazibwa!","poem":2}]},{"type":"verse","number":81,"content":[{"text":"Emmeeme yange erumwa nnyo ennyonta ng’eyaayaanira obulokozi bwo,","poem":1},{"text":"essuubi lyange liri mu kigambo kyo.","poem":2}]},{"type":"verse","number":82,"content":[{"text":"Ntunuulidde ebbanga ddene n’amaaso gange ne ganfuuyirira nga nninda okutuukirira kw’ekisuubizo kyo;","poem":1},{"text":"ne neebuuza nti, “Olinsanyusa ddi?”","poem":2}]},{"type":"verse","number":83,"content":[{"text":"Newaakubadde nga nfuuse ng’ensawo ey’eddiba, eya wayini eri mu mukka","poem":1},{"noteId":25},{"text":",","poem":1},{"text":"naye seerabira bye walagira.","poem":2}]},{"type":"verse","number":84,"content":[{"text":"Ayi Mukama, nze omuddu wo nnaalindirira kutuusa ddi","poem":1},{"text":"nga tonnabonereza abo abanjigganya?","poem":2}]},{"type":"verse","number":85,"content":[{"text":"Abantu ab’amalala abatatya Katonda bansimidde ebinnya mu kkubo;","poem":1},{"text":"be bo abatagondera mateeka go.","poem":2}]},{"type":"verse","number":86,"content":[{"text":"Amateeka go gonna geesigibwa;","poem":1},{"text":"abo abatakwagala banjigganyiza bwereere; nkusaba onnyambe!","poem":2}]},{"type":"verse","number":87,"content":[{"text":"Baali kumpi okunzikiririza ddala ku nsi kuno;","poem":1},{"text":"naye nze sivudde ku ebyo bye walagira.","poem":2}]},{"type":"verse","number":88,"content":[{"text":"Olw’okwagala kwo okutaggwaawo ndekera obulamu bwange,","poem":1},{"text":"ndyoke nkuume ebyo bye walagira ebiva mu kamwa ko.","poem":2}]},{"type":"verse","number":89,"content":[{"text":"Ayi Mukama, Ekigambo kyo kinywevu mu ggulu,","poem":1},{"text":"kya mirembe gyonna.","poem":2}]},{"type":"verse","number":90,"content":[{"text":"Obwesigwa bwo tebuggwaawo emirembe gyonna;","poem":1},{"text":"watonda ensi era enyweredde ddala.","poem":2}]},{"type":"verse","number":91,"content":[{"text":"Amateeka go na buli kati manywevu;","poem":1},{"text":"kubanga ebintu byonna bikuweereza.","poem":2}]},{"type":"verse","number":92,"content":[{"text":"Singa nnali sisanyukira mu mateeka go,","poem":1},{"text":"nandizikiridde olw’obulumi bwe nalimu.","poem":2}]},{"type":"verse","number":93,"content":[{"text":"Siyinza kwerabira biragiro byo;","poem":1},{"text":"kubanga mu ebyo obulamu bwange mw’obufuulidde obuggya.","poem":2}]},{"type":"verse","number":94,"content":[{"text":"Ndi wuwo, ndokola,","poem":1},{"text":"kubanga neekuumye bye walagira.","poem":2}]},{"type":"verse","number":95,"content":[{"text":"Newaakubadde ng’abakola ebibi beekukumye nga banteeze okunzikiriza;","poem":1},{"text":"naye nze nyweredde ku ebyo bye walagira.","poem":2}]},{"type":"verse","number":96,"content":[{"text":"Ebintu byonna biriko we bikoma","poem":1},{"text":"naye amateeka go tegakugirwa.","poem":2}]},{"type":"verse","number":97,"content":[{"text":"Amateeka go nga ngagala nnyo!","poem":1},{"text":"Ngafumiitirizaako olunaku lwonna.","poem":2}]},{"type":"verse","number":98,"content":[{"text":"Amateeka go ganfuula mugezi okusinga abalabe bange,","poem":1},{"text":"kubanga ge gannuŋŋamya bulijjo.","poem":2}]},{"type":"verse","number":99,"content":[{"text":"Ntegeera okusinga abasomesa bange bonna,","poem":1},{"text":"kubanga nfumiitiriza nnyo ebyo bye walagira.","poem":2}]},{"type":"verse","number":100,"content":[{"text":"Ntegeera okusinga abakadde;","poem":1},{"text":"kubanga ŋŋondera ebyo bye walagira.","poem":2}]},{"type":"verse","number":101,"content":[{"text":"Neekuumye obutatambulira mu kkubo lyonna ekyamu,","poem":1},{"text":"nsobole okugondera ekigambo kyo.","poem":2}]},{"type":"verse","number":102,"content":[{"text":"Sivudde ku mateeka go,","poem":1},{"text":"kubanga ggwe waganjigiriza.","poem":2}]},{"type":"verse","number":103,"content":[{"text":"Ebisuubizo byo nga bimpoomera nnyo!","poem":1},{"text":"Biwoomera akamwa kange okusinga omubisi gw’enjuki.","poem":2}]},{"type":"verse","number":104,"content":[{"text":"Mu biragiro byo mwe nfunira okutegeera;","poem":1},{"text":"kyenva nkyawa ekkubo lyonna ekyamu.","poem":2}]},{"type":"verse","number":105,"content":[{"text":"Ekigambo kyo ye ttaala eri ebigere byange,","poem":1},{"text":"era kye kimulisa ekkubo lyange.","poem":2}]},{"type":"verse","number":106,"content":[{"text":"Ndayidde ekirayiro era nkikakasizza","poem":1},{"text":"nga nnaakwatanga amateeka ag’obutuukirivu bwo.","poem":2}]},{"type":"verse","number":107,"content":[{"text":"Nnumizibwa nnyo;","poem":1},{"text":"nzizaamu obulamu, Ayi Mukama, ng’ekigambo kyo bwe kiri.","poem":2}]},{"type":"verse","number":108,"content":[{"text":"Okkirize Ayi Mukama ettendo akamwa kange lye kakuwa;","poem":1},{"text":"era onjigirize amateeka go.","poem":2}]},{"type":"verse","number":109,"content":[{"text":"Newaakubadde ng’obulamu bwange ntera okubutambuza nga bwe njagala,","poem":1},{"text":"naye seerabira mateeka go.","poem":2}]},{"type":"verse","number":110,"content":[{"text":"Abakola ebibi banteze omutego,","poem":1},{"text":"naye sikyamye kuva ku ebyo bye walagira.","poem":2}]},{"type":"verse","number":111,"content":[{"text":"Ebiragiro byo gwe mugabo gwange emirembe gyonna;","poem":1},{"text":"weewaawo, ebyo bye bisanyusa omutima gwange.","poem":2}]},{"type":"verse","number":112,"content":[{"text":"Omutima gwange gweteeseteese okukwatanga ebiragiro byo","poem":1},{"text":"ennaku zonna ez’obulamu bwange.","poem":2}]},{"type":"verse","number":113,"content":[{"text":"Nkyawa abalina emitima egisagaasagana,","poem":1},{"text":"naye nze njagala amateeka go.","poem":2}]},{"type":"verse","number":114,"content":[{"text":"Ggwe kiddukiro kyange era ggwe ngabo yange;","poem":1},{"text":"essuubi lyange liri mu kigambo kyo.","poem":2}]},{"type":"verse","number":115,"content":[{"text":"Muve we ndi mmwe abakola ebitali bya butuukirivu,","poem":1},{"text":"mundeke nkwate ebiragiro bya Katonda wange.","poem":2}]},{"type":"verse","number":116,"content":[{"text":"Onnyweze nga bwe wasuubiza, ndyoke mbeere omulamu;","poem":1},{"text":"nneme kuswazibwa ne nzigwamu essuubi.","poem":2}]},{"type":"verse","number":117,"content":[{"text":"Onnyweze ndyoke nfuuke ow’eddembe,","poem":1},{"text":"era nkwatenga ebiragiro byo bulijjo.","poem":2}]},{"type":"verse","number":118,"content":[{"text":"Onyooma abo bonna abaleka ebiragiro byo;","poem":1},{"text":"weewaawo obugezigezi bwabwe tebuliimu kantu.","poem":2}]},{"type":"verse","number":119,"content":[{"text":"Abakola ebibi bonna mu nsi obalaba ng’ebisasiro;","poem":1},{"text":"nze kyenva njagala ebyo bye walagira.","poem":2}]},{"type":"verse","number":120,"content":[{"text":"Nkankana nzenna nga nkutya,","poem":1},{"text":"era ntya amateeka go.","poem":2}]},{"type":"verse","number":121,"content":[{"text":"Nkoze eby’obwenkanya era eby’obutuukirivu;","poem":1},{"text":"tondeka mu mikono gy’abo abanjooga.","poem":2}]},{"type":"verse","number":122,"content":[{"text":"Okakase okundaganga ekisa kyo bulijjo,","poem":1},{"text":"oleme kukkiriza ababi okunjooganga.","poem":2}]},{"type":"verse","number":123,"content":[{"text":"Amaaso gange ganfuuyiririra, nga nnindirira obulokozi bwo","poem":1},{"text":"n’ebyo bye wasuubiza mu butuukirivu bwo.","poem":2}]},{"type":"verse","number":124,"content":[{"text":"Nze omuddu wo nkolaako ng’okwagala kwo bwe kuli;","poem":1},{"text":"era onjigirize amateeka go.","poem":2}]},{"type":"verse","number":125,"content":[{"text":"Ndi muddu wo, mpa okwawula ekirungi n’ekibi;","poem":1},{"text":"ndyoke ntegeere ebiragiro byo.","poem":2}]},{"type":"verse","number":126,"content":[{"text":"Ekiseera kituuse, Ayi Mukama, okubaako ky’okola,","poem":1},{"text":"kubanga amateeka go gamenyeddwa.","poem":2}]},{"type":"verse","number":127,"content":[{"text":"Naye nze njagala amateeka go","poem":1},{"text":"okusinga zaabu, wadde zaabu omulongoose.","poem":2}]},{"type":"verse","number":128,"content":[{"text":"Kubanga mmanyi ng’ebiragiro byo byonna bituufu;","poem":1},{"text":"nkyawa buli kkubo lyonna ekyamu.","poem":2}]},{"type":"verse","number":129,"content":[{"text":"Ebiragiro byo bya kitalo;","poem":1},{"text":"kyenva mbigondera.","poem":2}]},{"type":"verse","number":130,"content":[{"text":"Ebigambo byo bwe binnyonnyolwa bireeta omusana;","poem":1},{"text":"n’atategeera bulungi bimugeziwaza.","poem":2}]},{"type":"verse","number":131,"content":[{"text":"Njasamya akamwa kange ne mpejjawejja","poem":1},{"text":"nga njaayaanira amateeka go.","poem":2}]},{"type":"verse","number":132,"content":[{"text":"Nkyukira, onkwatirwe ekisa,","poem":1},{"text":"nga bw’okolera bulijjo abo abaagala erinnya lyo.","poem":2}]},{"type":"verse","number":133,"content":[{"text":"Oluŋŋamye ebigere byange ng’ekigambo kyo bwe kiri,","poem":1},{"text":"era tokkiriza kibi kyonna kunfuga.","poem":2}]},{"type":"verse","number":134,"content":[{"text":"Mponya okujooga kw’abantu,","poem":1},{"text":"bwe ntyo nkwatenga ebiragiro byo.","poem":2}]},{"type":"verse","number":135,"content":[{"text":"Ontunuulire, nze omuddu wo, n’amaaso ag’ekisa,","poem":1},{"text":"era onjigirizenga amateeka go.","poem":2}]},{"type":"verse","number":136,"content":[{"text":"Amaziga gakulukuta mu maaso gange ng’omugga,","poem":1},{"text":"olw’abo abatakwata mateeka go.","poem":2}]},{"type":"verse","number":137,"content":[{"text":"Oli mutuukirivu, Ayi Katonda,","poem":1},{"text":"era amateeka go matuufu.","poem":2}]},{"type":"verse","number":138,"content":[{"text":"Ebiragiro byo bye wateekawo bituukirivu,","poem":1},{"text":"era byesigibwa.","poem":2}]},{"type":"verse","number":139,"content":[{"text":"Nnyiikadde nnyo munda yange,","poem":1},{"text":"olw’abalabe bange abatassaayo mwoyo eri ebiragiro byo.","poem":2}]},{"type":"verse","number":140,"content":[{"text":"Ebisuubizo byo byetegerezebwa nnyo,","poem":1},{"text":"kyenva mbyagala.","poem":2}]},{"type":"verse","number":141,"content":[{"text":"Newaakubadde ndi muntu wa bulijjo era anyoomebwa, naye seerabira biragiro byo.","poem":1}]},{"type":"verse","number":142,"content":[{"lineBreak":true},{"text":"Obutuukirivu bwo bwa lubeerera,","poem":1},{"text":"n’amateeka go ga mazima.","poem":2}]},{"type":"verse","number":143,"content":[{"text":"Newaakubadde nga ndi mu kulumwa n’okutegana okungi,","poem":1},{"text":"amateeka go ge gansanyusa.","poem":2}]},{"type":"verse","number":144,"content":[{"text":"Ebiragiro byo bituufu emirembe gyonna;","poem":1},{"text":"onjigirize okubitegeera ndyoke mbeere omulamu.","poem":2}]},{"type":"verse","number":145,"content":[{"text":"Nkoowoola n’omutima gwange gwonna, Ayi Mukama, onnyanukule!","poem":1},{"text":"Nnaagonderanga amateeka go.","poem":2}]},{"type":"verse","number":146,"content":[{"text":"Nkukaabirira, ondokole,","poem":1},{"text":"nkwate ebiragiro byo.","poem":2}]},{"type":"verse","number":147,"content":[{"text":"Ngolokoka bunatera okukya ne nkukaabirira onnyambe;","poem":1},{"text":"essuubi lyange liri mu kigambo kyo.","poem":2}]},{"type":"verse","number":148,"content":[{"text":"Seebaka ekiro kyonna","poem":1},{"text":"nga nfumiitiriza ku ebyo bye wasuubiza.","poem":2}]},{"type":"verse","number":149,"content":[{"text":"Olw’okwagala kwo okutaggwaawo wulira eddoboozi lyange, Ayi Mukama,","poem":1},{"text":"ompe obulamu obuggya ng’amateeka go bwe gali.","poem":2}]},{"type":"verse","number":150,"content":[{"text":"Abo ab’enkwe era abatakwata mateeka go bansemberedde,","poem":1},{"text":"kyokka bali wala n’amateeka go.","poem":2}]},{"type":"verse","number":151,"content":[{"text":"Naye ggwe, Ayi Mukama, oli kumpi nange,","poem":1},{"text":"era n’amateeka go gonna ga mazima.","poem":2}]},{"type":"verse","number":152,"content":[{"text":"Okuva edda n’edda nayiga mu biragiro byo,","poem":1},{"text":"nga wabissaawo bibeerewo emirembe gyonna.","poem":2}]},{"type":"verse","number":153,"content":[{"text":"Tunuulira okubonaabona kwange omponye,","poem":1},{"text":"kubanga seerabira mateeka go.","poem":2}]},{"type":"verse","number":154,"content":[{"text":"Ompolereze, onnunule,","poem":1},{"text":"onzizeemu obulamu nga bwe wasuubiza.","poem":2}]},{"type":"verse","number":155,"content":[{"text":"Abakola ebibi obulokozi bubabeera wala,","poem":1},{"text":"kubanga tebanoonya mateeka go.","poem":2}]},{"type":"verse","number":156,"content":[{"text":"Ekisa kyo kinene, Ayi Mukama,","poem":1},{"text":"onzizeemu obulamu nga bwe wasuubiza.","poem":2}]},{"type":"verse","number":157,"content":[{"text":"Abalabe abanjigganya bangi,","poem":1},{"text":"naye nze siivenga ku biragiro byo.","poem":2}]},{"type":"verse","number":158,"content":[{"text":"Nnakuwalira abo abatakwesiga,","poem":1},{"text":"kubanga tebakwata biragiro byo.","poem":2}]},{"type":"verse","number":159,"content":[{"text":"Laba, Ayi Mukama, bwe njagala ebiragiro byo!","poem":1},{"text":"Onkuumenga ng’okwagala kwo bwe kuli.","poem":2}]},{"type":"verse","number":160,"content":[{"text":"Ebigambo byo byonna bya mazima meereere;","poem":1},{"text":"n’amateeka go ga lubeerera.","poem":2}]},{"type":"verse","number":161,"content":[{"text":"Abafuzi banjigganyiza bwereere,","poem":1},{"text":"naye ekigambo kyo nkissaamu ekitiibwa.","poem":2}]},{"type":"verse","number":162,"content":[{"text":"Nsanyukira ekisuubizo kyo okufaanana","poem":1},{"text":"ng’oyo afunye obugagga obungi.","poem":2}]},{"type":"verse","number":163,"content":[{"text":"Nkyawa era ntamwa obulimba,","poem":1},{"text":"naye amateeka go ngagala.","poem":2}]},{"type":"verse","number":164,"content":[{"text":"Mu lunaku nkutendereza emirundi musanvu","poem":1},{"text":"olw’amateeka go amatuukirivu.","poem":2}]},{"type":"verse","number":165,"content":[{"text":"Abo abaagala amateeka go bali mu ddembe lingi;","poem":1},{"text":"tewali kisobola kubeesittaza.","poem":2}]},{"type":"verse","number":166,"content":[{"text":"Nnindirira obulokozi bwo, Ayi Mukama,","poem":1},{"text":"era mu biragiro byo mwe ntambulira.","poem":2}]},{"type":"verse","number":167,"content":[{"text":"Ŋŋondera ebiragiro byo,","poem":1},{"text":"mbyagala nnyo nnyini.","poem":2}]},{"type":"verse","number":168,"content":[{"text":"Buli kye nkola okimanyi,","poem":1},{"text":"era olaba nga bwe nkwata ebiragiro byo.","poem":2}]},{"type":"verse","number":169,"content":[{"text":"Okukaaba kwange kutuuke gy’oli, Ayi Mukama,","poem":1},{"text":"ompe okutegeera ng’ekigambo kyo bwe kiri.","poem":2}]},{"type":"verse","number":170,"content":[{"text":"Okwegayirira kwange kutuuke gy’oli,","poem":1},{"text":"onnunule nga bwe wasuubiza.","poem":2}]},{"type":"verse","number":171,"content":[{"text":"Akamwa kange kanaakutenderezanga,","poem":1},{"text":"kubanga gw’onjigiriza amateeka go.","poem":2}]},{"type":"verse","number":172,"content":[{"text":"Olulimi lwange lunaayimbanga ekigambo kyo,","poem":1},{"text":"kubanga bye walagira byonna bya butuukirivu.","poem":2}]},{"type":"verse","number":173,"content":[{"text":"Omukono gwo gumbeerenga,","poem":1},{"text":"kubanga nnonzeewo okukwatanga ebiragiro byo.","poem":2}]},{"type":"verse","number":174,"content":[{"text":"Neegomba nnyo obulokozi bwo, Ayi Mukama,","poem":1},{"text":"era amateeka go lye ssanyu lyange.","poem":2}]},{"type":"verse","number":175,"content":[{"text":"Ompe obulamu nkutenderezenga,","poem":1},{"text":"era amateeka go gampanirirenga.","poem":2}]},{"type":"verse","number":176,"content":[{"text":"Ndi ng’endiga ebuze.","poem":1},{"text":"Onoonye omuddu wo,","poem":2},{"lineBreak":true},{"text":"kubanga seerabidde mateeka go.","poem":2}]}],"footnotes":[{"noteId":25,"caller":"+","text":"Ensawo ez’eddiba eza wayini atanakaatuuka, zaawanikibwanga waggulu omukka guziyiteko, wayini akaatuuke mangu. Oluvannyuma, ensawo ey’eddiba teyakozesebwanga nate, era yasuulibwanga","reference":{"chapter":119,"verse":83}}]},"thisChapterLink":"/api/lug_bib/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":176}