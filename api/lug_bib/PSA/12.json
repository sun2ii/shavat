{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Tuyambe, Ayi Mukama, kubanga tewakyali n’omu amanyi Katonda;","poem":1},{"text":"abantu abeesigwa bonna baweddewo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Buli muntu alimba munne;","poem":1},{"text":"akamwa kaabwe akawaana koogera bya bulimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mukama, osirise akamwa k’abo bonna abeewaanawaana,","poem":1},{"text":"na buli lulimi olwenyumiriza;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"nga boogera nti, “Tujja kuwangula n’olulimi lwaffe, era tufune byonna bye twetaaga n’akamwa kaffe,","poem":1},{"text":"kubanga ani alitukuba ku mukono.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mukama ayogera nti, “Olw’okujoogebwa kw’abanafu,","poem":1},{"text":"n’olw’okusinda kw’abali mu bwetaavu,","poem":2},{"text":"nnaasituka kaakano","poem":1},{"text":"ne nnwanirira abo abalumbibwa.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ebigambo bya Mukama bya bwesigwa era bya mazima.","poem":1},{"text":"Bigeraageranyizibwa n’effeeza","poem":2},{"lineBreak":true},{"text":"erongoosebbwa obulungi emirundi musanvu mu kyoto eky’ebbumba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ayi Mukama, tukwesiga ng’onootukuumanga,","poem":1},{"text":"n’otuwonya abantu abali ng’abo emirembe gyonna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ababi beeyisaayisa","poem":1},{"text":"nga bagulumiza ebitaliimu nsa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}