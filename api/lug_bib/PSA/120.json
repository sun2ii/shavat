text":"Ndudde nnyo","poem":1},{"text":"mu bantu abakyawa eddembe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nze njagala mirembe,","poem":1},{"text":"naye bwe njogera bo baagala ntalo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}