iro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mukama anaakukuumanga mu buli kabi;","poem":1},{"text":"anaalabiriranga obulamu bwo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mukama anaakukumanga amagenda go n’amadda,","poem":1},{"text":"okuva leero n’okutuusa emirembe gyonna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}