{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["Oluyimba nga balinnya amadaala. Lwa Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Nasanyuka bwe baŋŋamba nti,","poem":1},{"text":"“Tugende mu nnyumba ya Mukama!”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ebigere byaffe biyimiridde","poem":1},{"text":"mu miryango gyo, Ayi Yerusaalemi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yerusaalemi yazimbibwa okuba","poem":1},{"text":"ekibuga ekinywevu ekiyimiridde awamu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Eyo ebika byonna gye biraga,","poem":1},{"text":"ebika bya Mukama,","poem":2},{"text":"okutendereza erinnya lya Mukama","poem":1},{"text":"ng’ebiragiro ebyaweebwa Isirayiri bwe biri.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eyo entebe ez’okusalirako emisango gye zaateekebwa;","poem":1},{"text":"z’entebe ez’obwakabaka ez’ennyumba ya Dawudi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Musabirenga Yerusaalemi emirembe:","poem":1},{"text":"“Abo abakwagala bafune ebirungi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Emirembe gibeerenga munda w’ebisenge byo;","poem":1},{"text":"n’amayumba go amanene gabeerenga n’omukisa era nga manywevu.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Olwa baganda bange ne mikwano gyange","poem":1},{"text":"nnaayogeranga nti, “Emirembe gibeerenga mu ggwe.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Olw’obulungi bw’ennyumba ya Mukama Katonda waffe, nnaanoonyanga okukulaakulana kwa Yerusaalemi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}