"verse","number":5,"content":[{"text":"Naye abo abalaga mu makubo gaabwe amakyamu,","poem":1},{"text":"Mukama alibawaŋŋangusa wamu n’abakola ebitali bya butuukirivu.","poem":2},{"lineBreak":true},{"text":"Emirembe gibe ku Isirayiri.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}