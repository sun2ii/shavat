ent":[{"text":"Babeere ng’omuddo ogumera waggulu ku nnyumba","poem":1},{"noteId":27},{"text":",","poem":1},{"text":"oguwotoka nga tegunnakula.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Omukunguzi tagufaako, n’oyo asiba ebinywa agunyooma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wadde abayitawo baleme kwogera nti,","poem":1},{"text":"“Omukisa gwa Mukama gube ku mmwe.","poem":2},{"lineBreak":true},{"text":"Tubasabidde omukisa mu linnya lya Mukama.”","poem":2}]}],"footnotes":[{"noteId":27,"caller":"+","text":"Obusolya bw’ennyumba z’omu Isirayiri zaalina ettaka waggulu ku zo eryali litabuddwamu evvu n’omusenyu. Enkuba bwe yatonnyanga, mwamerangamu omuddo, kyokka omuddo ogwo gwakalanga mangu ddala olw’omusana okugwakako kubanga emirandira gyagwo tegyagendanga wala wansi mu kasolya","reference":{"chapter":129,"verse":6}}]},"thisChapterLink":"/api/lug_bib/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}