{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Olinneerabira kutuusa ddi, Ayi Mukama? Okutuusa emirembe gyonna?","poem":1},{"text":"Olikomya ddi okunkweka amaaso go?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Okulumwa mu mmeeme yange kulikoma ddi,","poem":1},{"text":"n’okunyolwa okwa buli lunaku mu mutima gwange kuliggwaamu ddi?","poem":2},{"lineBreak":true},{"text":"Abalabe bange balikomya ddi okumpangulanga nga beegulumiza?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Onnyanukule, Ayi Mukama Katonda wange;","poem":1},{"text":"onzizeemu amaanyi nneme okufa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Si kulwa ng’omulabe wange yeewaana nti, “Mmuwangudde;”","poem":1},{"text":"abalabe bange ne bajaguza nga ngudde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Naye nze neesiga okwagala kwo okutajjulukuka;","poem":1},{"text":"era omutima gwange gunaasanyukiranga mu bulokozi bwo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nnaayimbiranga Mukama,","poem":1},{"text":"kubanga ankoledde ebirungi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}