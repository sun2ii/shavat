{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["Oluyimba nga balinnya amadaala."]},{"type":"verse","number":1,"content":[{"text":"Ayi Mukama, nkukaabira nga nsobeddwa nnyo.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Ayi Mukama, wulira eddoboozi lyange;","poem":2},{"text":"otege amatu go","poem":1},{"text":"eri eddoboozi ly’okwegayirira kwange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ayi Mukama, singa otubalira obutali butuukirivu bwaffe,","poem":1},{"text":"ani eyandiyimiridde mu maaso go?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Naye osonyiwa;","poem":1},{"text":"noolwekyo ossibwamu ekitiibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nnindirira Mukama, emmeeme yange erindirira","poem":1},{"text":"era essuubi lyange liri mu kigambo kye.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Emmeeme yange erindirira Mukama;","poem":1},{"text":"mmulindirira okusinga ng’abakuumi bwe balindirira obudde okukya;","poem":2},{"lineBreak":true},{"text":"okusingira ddala ng’abakuumi bwe balindirira obudde okukya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ayi Isirayiri, weesigenga Mukama,","poem":1},{"text":"kubanga Mukama y’alina okwagala okutaggwaawo;","poem":2},{"lineBreak":true},{"text":"era y’alina okununula okutuukiridde.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mukama y’alinunula Isirayiri n’amuggya","poem":1},{"text":"mu byonoono bye byonna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}