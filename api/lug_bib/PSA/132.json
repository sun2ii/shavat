{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"hebrew_subtitle","content":["Oluyimba nga balinnya amadaala."]},{"type":"verse","number":1,"content":[{"text":"Ayi Mukama jjukira Dawudi","poem":1},{"text":"n’okubonaabona kwe yagumiikiriza kwonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nga bwe yalayirira Mukama,","poem":1},{"text":"ne yeeyama eri Katonda Ayinzabyonna, Katonda wa Yakobo,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ng’agamba nti, “Siriyingira mu nnyumba yange,","poem":1},{"text":"wadde okulinnya ku kitanda kyange.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sirikkiriza tulo kunkwata","poem":1},{"text":"newaakubadde okuzibiriza amaaso gange,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"okutuusa lwe ndimala okufunira Mukama ekifo;","poem":1},{"text":"ekifo eky’okubeeramu ekya Katonda Ayinzabyonna, Katonda wa Yakobo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Laba, twakiwulirako mu Efulasa,","poem":1},{"text":"ne tukizuula mu nnimiro ya Jaali.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kale tugende mu kifo kye mw’abeera,","poem":1},{"text":"tumusinzirize awali entebe y’ebigere bye.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Golokoka, Ayi Mukama, ogende mu kifo kyo mw’owummulira;","poem":1},{"text":"ggwe n’Essanduuko yo ey’Endagaano, eraga obuyinza bwo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bakabona bo bambazibwe obutuukirivu,","poem":1},{"text":"n’abatukuvu bo bayimbe n’essanyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ku lulwe Dawudi omuddu wo,","poem":1},{"text":"tomugaana oyo gwe wafukako amafuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mukama Katonda yalayirira Dawudi","poem":1},{"text":"ekirayiro ekitaliggwaawo, era talikivaako.","poem":2},{"text":"Kubanga yamugamba nti, “Omu ku batabani bo","poem":1},{"text":"gwe ndituuza ku ntebe yo ey’obwakabaka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Batabani bo bwe banaakuumanga Endagaano yange","poem":1},{"text":"n’ebiragiro byange bye nnaabayigirizanga,","poem":2},{"text":"ne batabani baabwe nabo banaatuulanga","poem":1},{"text":"ku ntebe yo ey’obwakabaka emirembe gyonna.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kubanga Mukama yalonda Sayuuni,","poem":1},{"text":"nga kye yasiima okutuulangamu, n’agamba nti:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“Kino kye kifo mwe nnaawummuliranga emirembe gyonna;","poem":1},{"text":"omwo mwe nnaatuulanga nga ndi ku ntebe ey’obwakabaka kubanga nkisiimye.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nnaakiwanga omukisa ne nkiwa n’ebirungi,","poem":1},{"text":"era n’abaavu baamu nnaabakkusanga ebyokulya.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bakabona baakyo, obulokozi bunaabanga kyambalo kyabwe;","poem":1},{"text":"n’abatukuvu baakyo banaayimbanga ennyimba ez’essanyu n’essanyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Eyo gye ndyaliza batabani ba Dawudi obuyinza;","poem":1},{"text":"ne muteekerawo ettabaaza olw’oyo gwe nayiwako amafuta.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Abalabe be ndibajjuza ensonyi,","poem":1},{"text":"naye ye ndimwambaza engule ey’ekitiibwa ekingi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}