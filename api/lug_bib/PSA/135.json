{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":135,"content":[{"type":"verse","number":1,"content":[{"text":"Mutendereze Mukama.","poem":1},{"lineBreak":true},{"text":"Mutendereze erinnya lya Mukama.","poem":1},{"text":"Mumutendereze mmwe abaddu ba Mukama;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"mmwe abaweereza mu nnyumba ya Mukama,","poem":1},{"text":"mu mpya z’ennyumba ya Katonda waffe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mutendereze Mukama, kubanga Mukama mulungi;","poem":1},{"text":"mutendereze erinnya lye kubanga ekyo kisanyusa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kubanga Mukama yeerondera Yakobo okuba owuwe;","poem":1},{"text":"ye Isirayiri gwe yeeroboza okuba eky’omuwendo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mmanyi nga Mukama mukulu wa kitiibwa,","poem":1},{"text":"era nga Mukama oyo y’asinga bakatonda bonna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mukama kyonna ky’asiima ky’akola,","poem":1},{"text":"mu ggulu ne ku nsi;","poem":2},{"lineBreak":true},{"text":"mu nnyanja ne mu buziba bwayo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Alagira ebire ne byekuluumulula okuva ku nkomerero y’ensi;","poem":1},{"text":"atonnyesa enkuba erimu okumyansa,","poem":2},{"lineBreak":true},{"text":"n’asumulula empewo okuva mu mawanika ge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ye yakuba ababereberye ab’e Misiri;","poem":1},{"text":"ababereberye b’abantu n’ebibereberye by’ebisolo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ye yaweereza obubonero n’ebyewuunyo wakati wo, ggwe Misiri,","poem":1},{"text":"eri Falaawo n’abaweereza be bonna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ye yakuba amawanga amangi,","poem":1},{"text":"n’atta bakabaka ab’amaanyi era be bano,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sikoni kabaka w’Abamoli,","poem":1},{"text":"ne Ogi kabaka w’e Basani","poem":2},{"lineBreak":true},{"text":"ne bakabaka bonna ab’e Kanani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ensi yaabwe n’agiwaayo ng’obusika,","poem":1},{"text":"okuba obusika bw’abantu be Isirayiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ayi Mukama, erinnya lyo lya lubeerera,","poem":1},{"text":"era n’obukulu bwo bumanyibwa emirembe gyonna.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kubanga Katonda aliggyako abantu be omusango,","poem":1},{"text":"era alisaasira abaweereza be.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Abamawanga ebifaananyi byonna ebyole bye basinza,","poem":1},{"text":"ebyakolebwa n’emikono gy’abantu mu ffeeza ne zaabu,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"birina emimwa, naye tebyogera;","poem":1},{"text":"birina amaaso, naye tebiraba;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"birina amatu naye tebiwulira;","poem":1},{"text":"so ne mu kamwa kaabyo temuyitamu mukka.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ababikola balibifaanana;","poem":1},{"text":"na buli abyesiga alibifaanana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ayi ennyumba ya Isirayiri mutendereze Mukama;","poem":1},{"text":"mmwe ennyumba ya Alooni mutendereze Mukama.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mmwe ennyumba ya Leevi mutendereze Mukama;","poem":1},{"text":"mmwe abatya Mukama mutendereze Mukama.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mukama ali mu Sayuuni yeebazibwe;","poem":1},{"text":"yeebazibwe oyo abeera mu Yerusaalemi.","poem":2},{"lineBreak":true},{"text":"Mutendereze Mukama.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}