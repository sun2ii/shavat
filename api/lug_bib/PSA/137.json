{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"Twatuula ku mabbali g’emigga gy’e Babulooni,","poem":1},{"text":"ne tukaaba amaziga bwe twajjukira Sayuuni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne tuwanika ennanga zaffe","poem":1},{"text":"ku miti egyali awo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abaatunyaga ne batulagira okuyimba,","poem":1},{"text":"abaatubonyaabonya ne batulagira okusanyuka;","poem":2},{"lineBreak":true},{"text":"nga bagamba nti, “Mutuyimbireyo lumu ku nnyimba za Sayuuni.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tunaayimba tutya oluyimba lwa Mukama","poem":1},{"text":"mu nsi eteri yaffe?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bwe nnaakwerabiranga, ggwe Yerusaalemi,","poem":1},{"text":"omukono gwange ogwa ddyo gukale!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Olulimi lwange lwesibire waggulu w’ekibuno kyange","poem":1},{"text":"singa nkwerabira,","poem":2},{"text":"ggwe Yerusaalemi, ne sikulowoozaako","poem":1},{"text":"okusinga ebintu ebirala byonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Jjukira, Ayi Mukama, batabani ba Edomu kye baakola,","poem":1},{"noteId":28},{"text":"ku lunaku Yerusaalemi lwe kyawambibwa;","poem":2},{"text":"ne baleekaana nti, “Kisuule,","poem":1},{"text":"kimalirewo ddala n’emisingi gyakyo.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ggwe omuwala wa Babulooni, agenda okuzikirizibwa,","poem":1},{"text":"yeesiimye oyo alikusasula ebyo","poem":2},{"lineBreak":true},{"text":"nga naawe bye watukola.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yeesiimye oyo aliddira abaana bo","poem":1},{"text":"n’ababetentera","poem":2},{"noteId":29},{"text":"ku lwazi.","poem":2}]}],"footnotes":[{"noteId":28,"caller":"+","text":"Nebukadduneeza bwe yazikiriza Yerusaalemi, bazzukulu ba Edomu baasanyuka okulaba ng’abalabe baabwe Abayisirayiri bazikiridde. Kino kyali kibi nnyo kubanga Abayisirayiri ne bazzukulu ba Edomu baaluganda. Bazzukulu ba Edomu bava mu Esawu","reference":{"chapter":137,"verse":7}},{"noteId":29,"caller":"+","text":"Okukakasa nga tewaba n’omu ku b’omu kibuga ekiwambiddwa asigalawo, abaakiwambanga baabetentanga emitwe gy’abaana abato ab’omu kibuga ekyo ku lwazi","reference":{"chapter":137,"verse":9}}]},"thisChapterLink":"/api/lug_bib/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}