{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"hebrew_subtitle","content":["Zabbuli Ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Nnaakutenderezanga Ayi Mukama, n’omutima gwange gwonna;","poem":1},{"text":"ne mu maaso ga bakatonda abalala nnaayimbanga okukutendereza.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nvuunama nga njolekedde Yeekaalu yo Entukuvu,","poem":1},{"text":"ne ntendereza erinnya lyo","poem":2},{"lineBreak":true},{"text":"olw’okwagala kwo n’olw’obwesigwa bwo;","poem":2},{"text":"kubanga wagulumiza ekigambo kyo","poem":1},{"text":"n’erinnya lyo okusinga ebintu byonna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Olunaku lwe nakukoowoolerako wannyanukula;","poem":1},{"text":"n’onnyongeramu amaanyi mu mwoyo gwange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bakabaka bonna ab’omu nsi banaakutenderezanga, Ayi Mukama,","poem":1},{"text":"nga bawulidde ebigambo ebiva mu kamwa ko.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Banaatenderezanga ebikolwa byo Ayi Mukama;","poem":1},{"text":"kubanga ekitiibwa kya Mukama kinene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Newaakubadde nga Mukama asukkulumye,","poem":1},{"text":"naye afaayo eri abo abeetoowaza; naye abeegulumiza ababeera wala.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Newaakubadde nga neetooloddwa ebizibu,","poem":1},{"text":"naye ggwe okuuma obulamu bwange;","poem":2},{"text":"ogolola omukono gwo eri abalabe bange abakambwe,","poem":1},{"text":"era omukono gwo ogwa ddyo ne gumponya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mukama alituukiriza ebyo by’anteekeddeteekedde;","poem":1},{"text":"kubanga okwagala kwo, Ayi Mukama, kubeerera emirembe gyonna.","poem":2},{"lineBreak":true},{"text":"Tolekulira ebyo bye watonda.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}