{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":139,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Ayi Mukama, okebedde omutima gwange,","poem":1},{"text":"n’otegeera byonna ebiri munda yange.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bwe ntuula omanya, ne bwe ngolokoka omanya;","poem":1},{"text":"era otegeera byonna bye ndowooza, ne bwe mbeera ewala ennyo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Otegeera okutambula kwange kwonna n’okuwummula kwange.","poem":1},{"text":"Omanyi amakubo gange gonna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ekigambo kye nnaayogera, Ayi Mukama,","poem":1},{"text":"okimanya nga sinnaba na kukyogera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ondi mu maaso n’emabega,","poem":1},{"text":"era ontaddeko omukono gwo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Okumanya okw’engeri eyo kunsukkiridde,","poem":1},{"text":"era nkwewuunya nnyo, kunnema okutegeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nnaagenda wa Omwoyo wo gy’atali?","poem":1},{"text":"Oba nnaagenda wa ggwe gy’otoli?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bwe nnaalinya mu ggulu, nga gy’oli;","poem":1},{"text":"bwe nnakka emagombe, nayo nga gy’oli.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bwe nneebagala empewo ez’oku makya ne zintwala","poem":1},{"text":"ne mbeera mu bitundu by’ennyanja ebisinga okuba ewala;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"era n’eyo omukono gwo gunannuŋŋamya,","poem":1},{"text":"omukono gwo ogwa ddyo gunannywezanga.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bwe nnaagamba nti, “Ekizikiza kimbuutikire,","poem":1},{"text":"n’obudde obw’emisana bwe ndimu bufuuke ekiro.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Naye era ekizikiza gy’oli tekiba kizikiza,","poem":1},{"text":"ekiro kyakaayakana ng’emisana;","poem":2},{"lineBreak":true},{"text":"kubanga gy’oli ekizikiza n’omusana bifaanana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ggwe watonda byonna ebiri munda mu nze;","poem":1},{"text":"ggwe wammumbira mu lubuto lwa mmange.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nkutendereza, kubanga wankola mu ngeri ey’entiisa era ey’ekitalo;","poem":1},{"text":"emirimu gyo gya kyewuunyo;","poem":2},{"lineBreak":true},{"text":"era ekyo nkimanyidde ddala bulungi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wammanya nga ntondebwa,","poem":1},{"text":"bwe nakolerwa mu kyama;","poem":2},{"text":"bwe natondebwa mu buziba bw’ensi n’amagezi go amangi.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Wandaba nga si natondebwa.","poem":2},{"text":"Ennaku zange zonna ze wanteekerateekera","poem":1},{"text":"zawandiikibwa mu kitabo kyo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"By’ondowooleza nga bya muwendo munene, Ayi Katonda!","poem":1},{"text":"Omuwendo gwabyo munene!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Singa ngezaako okubibala","poem":1},{"text":"bisinga omusenyu obungi.","poem":2},{"text":"Ne bwe ngolokoka mu makya","poem":1},{"text":"oba okyandowoozaako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Abakola ebibi batte, Ayi Katonda;","poem":1},{"text":"abasajja abassi b’abantu banveeko.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Abantu abo bakwogerako bibi;","poem":1},{"text":"bakwegulumiririzaako mu butategeera bwabwe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Abakukyawa, Ayi Mukama, nange mbakyawa;","poem":1},{"text":"abo abakwegulumiririzaako bansunguwaza.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mbakyayira ddala nnyo,","poem":1},{"text":"era mbayita balabe bange.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nkebera, Ayi Katonda, otegeere omutima gwange.","poem":1},{"text":"Ngezesa omanye ebirowoozo byange.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Olabe obanga mu nze mulimu engeri yonna enkyamu;","poem":1},{"text":"era onkulembere mu kkubo erintuusa mu bulamu obutaggwaawo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}