{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":140,"content":[{"type":"hebrew_subtitle","content":["Ya mukulu w’okuyimba. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Omponye abakola ebibi, Ayi Mukama,","poem":1},{"text":"omponye abantu abakambwe;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"abateesa mu mitima gyabwe okukola ebibi;","poem":1},{"text":"abanoonya entalo buli kiseera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ebigambo byabwe byogi ng’ennimi z’emisota;","poem":1},{"text":"ebiva mu kamwa kaabwe busagwa ng’obw’essalambwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Onkuume abakola ebibi baleme okunkwatako, Ayi Mukama;","poem":1},{"text":"omponye abantu abakambwe","poem":2},{"lineBreak":true},{"text":"abateesa okunkyamya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abantu ab’amalala banteze omutego;","poem":1},{"text":"banjuluzza ekitimba kyabwe;","poem":2},{"lineBreak":true},{"text":"ne batega emitego mu kkubo lyange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nagamba Mukama nti, “Ggwe oli Katonda wange.”","poem":1},{"text":"Wulira okwegayirira kwange, onsaasire, Ayi Mukama!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ayi Mukama, Mukama wange, ggw’omponya n’amaanyi go,","poem":1},{"text":"ggwe engabo yange mu lutalo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ayi Mukama, abakola ebibi tobawa bye beetaaga,","poem":1},{"text":"era tokkiriza ntekateeka zaabwe kutuukirira;","poem":2},{"lineBreak":true},{"text":"baleme kuba na malala wadde okwenyumiriza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abanneetoolodde baleke enkwe zaabwe","poem":1},{"text":"zibeekyusizeeko baboneebone.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Amanda agaaka omuliro gabagwire;","poem":1},{"text":"basuulibwe mu muliro,","poem":2},{"lineBreak":true},{"text":"bakasukibwe mu bunnya obutakoma mwe bataliva emirembe gyonna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tokkiriza balimba kweyongera bungi;","poem":1},{"text":"abakambwe bayigganyizibwe bazikirire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mmanyi nga Mukama ayamba abo ababonaabona, y’ayamba abanaku okuyisibwa mu bwenkanya.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Abatuukirivu banaakutenderezanga,","poem":1},{"text":"era w’oli we banaabeeranga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}