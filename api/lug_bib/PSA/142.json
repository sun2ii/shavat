{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["Okusaba kwa Dawudi bwe yali mu mpuku."]},{"type":"verse","number":1,"content":[{"text":"Nkaabirira Mukama n’eddoboozi ery’omwanguka;","poem":1},{"text":"neegayirira Mukama ansaasire.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mmutegeeza byonna ebinneemulugunyisa,","poem":1},{"text":"ne mmwanjulira ebinteganya byonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Omwoyo gwange bwe gunnennyika,","poem":1},{"text":"gw’omanyi eky’okunkolera.","poem":2},{"text":"Banteze omutego mu kkubo lyange mwe mpita.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bwe ntunula ku mukono gwange ogwa ddyo, sirabayo anambeera;","poem":1},{"text":"sirina wa kwekweka, era tewali n’omu anfaako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nkaabirira ggwe, Ayi Mukama,","poem":1},{"text":"nga ŋŋamba nti, “Ggwe kiddukiro kyange,","poem":2},{"lineBreak":true},{"text":"ggwe mugabo gwange mu nsi muno.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Owulire okukaaba kwange,","poem":1},{"text":"kubanga njeezebwa nnyo!","poem":2},{"text":"Mponya abanjigganya,","poem":1},{"text":"kubanga bansinza nnyo amaanyi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nziggya mu kkomera,","poem":1},{"text":"ndyoke nkwebaze nga ntendereza erinnya lyo.","poem":2},{"text":"Abatuukirivu balinneetooloola,","poem":1},{"text":"ng’onkoledde ebyekisa ekingi ebingi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}