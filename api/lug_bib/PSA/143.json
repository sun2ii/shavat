{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"hebrew_subtitle","content":["Zabbuli Ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Wulira okusaba kwange, Ayi Mukama,","poem":1},{"text":"wulira okwegayirira kwange!","poem":2},{"text":"Ggwe omwesigwa","poem":1},{"text":"era omutuukirivu jjangu ombeere.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tonsalira musango,","poem":1},{"text":"kubanga mu maaso go tewali n’omu atuukiridde.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Omulabe wange angoba n’ankwata n’ansuula wansi;","poem":1},{"text":"anteeka mu kizikiza ne nfaanana ng’abaafa edda.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Noolwekyo omwoyo gwange guweddemu endasi,","poem":1},{"text":"n’omutima gwange gwennyise.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nzijukira ennaku ez’edda,","poem":1},{"text":"ne nfumiitiriza ku ebyo bye wakola byonna,","poem":2},{"lineBreak":true},{"text":"ne ndowooza ku mirimu gy’emikono gyo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngolola emikono gyange gy’oli,","poem":1},{"text":"ne nkuyaayaanira ng’ettaka ekkalu bwe liyaayaanira enkuba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yanguwa okunziramu, Ayi Mukama,","poem":1},{"text":"kubanga omwoyo gwange guggwaamu amaanyi.","poem":2},{"text":"Tonkisa maaso go,","poem":1},{"text":"nneme okufaanana ng’abafu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Obudde nga bukedde, nsaba ondage okwagala kwo okutaggwaawo;","poem":1},{"text":"kubanga ggwe gwe neesiga.","poem":2},{"text":"Njigiriza ekkubo lye nsaana okutambuliramu,","poem":1},{"text":"kubanga omwoyo gwange gwonna guli gy’oli.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mponya, Ayi Mukama, abalabe bange,","poem":1},{"text":"kubanga ggwe kiddukiro kyange.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Njigiriza okukola by’oyagala,","poem":1},{"text":"kubanga ggwe Katonda wange!","poem":2},{"text":"Omwoyo wo omulungi ankulembere,","poem":1},{"text":"antambulize mu kkubo eddungi ery’omuseetwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Olw’erinnya lyo, Ayi Mukama, onkuume,","poem":1},{"text":"mu butuukirivu bwo onzigye mu kabi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Omalewo abalabe bange olw’okwagala kwo,","poem":1},{"text":"ozikirize n’abanjigganya bonna,","poem":2},{"lineBreak":true},{"text":"kubanga nze ndi muddu wo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}