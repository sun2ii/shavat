{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":144,"content":[{"type":"hebrew_subtitle","content":["Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Atenderezebwe Mukama, olwazi lwange,","poem":1},{"text":"atendeka emikono gyange okulwana,","poem":2},{"lineBreak":true},{"text":"era ateekerateekera engalo zange olutalo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mukama anjagala ye Katonda wange era kye kiddukiro kyange,","poem":1},{"text":"ge maanyi gange amangi era ye mulokozi wange.","poem":2},{"text":"Ye ngabo yange mwe neekweka.","poem":1},{"text":"Awangula amawanga n’agassa wansi w’ebigere byange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ayi Mukama, omuntu kye ki ggwe okumufaako,","poem":1},{"text":"oba omwana w’omuntu, ggwe okumulowoozaako?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Omuntu ali nga mukka.","poem":1},{"text":"Ennaku ze ziri ng’ekisiikirize ekiyita obuyisi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yawula mu ggulu lyo, Ayi Mukama, okke!","poem":1},{"text":"Kwata ku nsozi zinyooke omukka!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Myansa abalabe basaasaane,","poem":1},{"text":"era lasa obusaale bwo obazikirize.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ogolole omukono gwo ng’osinziira waggulu ennyo,","poem":1},{"text":"omponye,","poem":2},{"text":"onzigye mu mazzi amangi,","poem":1},{"text":"era onzigye mu mikono gya bannamawanga;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ab’emimwa egyogera eby’obulimba,","poem":1},{"text":"abalayira nti kya mazima, so nga bulimba bwereere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ayi Mukama, nnaakuyimbiranga oluyimba oluggya;","poem":1},{"text":"nnaakukubiranga ennanga ey’enkoba ekkumi,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ggwe awa bakabaka obuwanguzi;","poem":1},{"text":"amponya, nze omuddu wo Dawudi, ekitala ekyogi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ndokola, omponye onzigye","poem":1},{"text":"mu mukono gwa bannamawanga bano","poem":2},{"text":"ab’emimwa egyogera eby’obulimba,","poem":1},{"text":"era omukono gwabwe ogwa ddyo gwa bulimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Batabani baffe mu buvubuka bwabwe, Ayi Mukama,","poem":1},{"text":"babeere ng’ebisimbe ebikulidde ddala obulungi,","poem":2},{"text":"ne bawala baffe babe ng’empagi ennungi ez’oku nsonda","poem":1},{"text":"okuzimbirwa ennyumba ya kabaka mu lubiri.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Amawanika gaffe gajjule ebibala","poem":1},{"text":"ebya buli ngeri.","poem":2},{"text":"Endiga zaffe zizaale","poem":1},{"text":"enkumi n’obukumi zijjule amalundiro gaffe.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ente zaffe ziwalule ebizito.","poem":2},{"text":"Ebisenge by’ekibuga bireme kumenyebwa.","poem":1},{"text":"Waleme kubaawo kukaaba","poem":2},{"lineBreak":true},{"text":"n’okwaziirana kwonna mu nguudo ez’omu bibuga byaffe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Abantu abaweereddwa emikisa egyo beesiimye!","poem":1},{"text":"Balina omukisa abantu abo abalina Katonda waabwe nga ye Mukama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}