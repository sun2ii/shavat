{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":145,"content":[{"type":"hebrew_subtitle","content":["Oluyimba lwa Dawudi olw’okutendereza."]},{"type":"verse","number":1,"content":[{"text":"Nnaakugulumizanga ggwe Katonda wange, era Kabaka wange;","poem":1},{"text":"era nnaatenderezanga erinnya lyo buli lunaku emirembe n’emirembe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nnaakutenderezanga buli lunaku;","poem":1},{"text":"era nnaasuutanga erinnya lyo emirembe n’emirembe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mukama mukulu, wa kitiibwa, era asaanira okutenderezebwanga ennyo,","poem":1},{"text":"n’obukulu bwe tebwogerekeka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Buli mulembe gunaatenderanga gunnaagwo ebikolwa byo,","poem":1},{"text":"era gunaatendanga emirimu gyo egy’amaanyi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nnaatendanga obukulu n’obulungi bw’ekitiibwa kyo,","poem":1},{"text":"era nnaafumiitirizanga ku bikolwa byo ebyewuunyisa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abantu banaatendanga amaanyi g’ebikolwa byo eby’ekitalo,","poem":1},{"text":"nange nnaatendanga obukulu bwo obw’ekitiibwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Banaayogeranga ku bulungi bwo obw’ekitalo nga bajaguza;","poem":1},{"text":"era banaayimbanga olw’obutuukirivu bwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mukama wa kisa, ajudde okusaasira,","poem":1},{"text":"alwawo okusunguwala era ajudde okwagala okutaggwaawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mukama mulungi eri buli muntu,","poem":1},{"text":"era okusaasira kwe kubuna byonna bye yatonda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Byonna bye watonda binaakutenderezanga, Ayi Mukama;","poem":1},{"text":"n’abatukuvu bo banaakugulumizanga.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Banaayogeranga ku kitiibwa ky’obwakabaka bwo,","poem":1},{"text":"era banaatendanga amaanyi go.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Balyoke bategeeze abantu bonna ebikolwa byo eby’amaanyi,","poem":1},{"text":"n’ekitiibwa ky’obukulu obw’obwakabaka bwo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Obwakabaka bwo, bwakabaka bwa lubeerera,","poem":1},{"text":"n’obufuzi bwo bwa mirembe na mirembe.","poem":2},{"lineBreak":true},{"text":"Mukama by’ayogera byonna bya bwesigwa,","poem":1},{"text":"n’ebikolwa bye bijjudde okusaasira.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mukama awanirira abo bonna abazitoowereddwa,","poem":1},{"text":"era ayimusa bonna abagwa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Amaaso g’abantu bonna gatunuulira ggwe, Ayi Mukama,","poem":1},{"text":"era bonna gw’obawa ebyokulya mu biseera byabyo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Oyanjuluza engalo zo,","poem":1},{"text":"ebiramu byonna n’obigabira bye byetaaga ne bikkuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mukama mutuukirivu mu bikolwa bye byonna","poem":1},{"text":"era ayagala byonna bye yatonda.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mukama abeera kumpi n’abo bonna abamukoowoola;","poem":1},{"text":"abo bonna abamukoowoola mu mazima.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Abo bonna abamussaamu ekitiibwa abawa bye baagala,","poem":1},{"text":"era awulira okukaaba kwabwe n’abawonya.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mukama akuuma bonna abamwagala,","poem":1},{"text":"naye abakola ebibi alibazikiriza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Akamwa kange kanaatenderezanga Mukama,","poem":1},{"text":"era na buli kitonde kinaatenderezanga erinnya lye ettukuvu","poem":2},{"lineBreak":true},{"text":"emirembe n’emirembe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}