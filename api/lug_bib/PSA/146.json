{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Tendereza Mukama!","poem":1},{"lineBreak":true},{"text":"Tendereza Mukama ggwe emmeeme yange!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nnaatenderezanga Mukama ennaku zonna ez’obulamu bwange;","poem":1},{"text":"nnaayimbanga okutendereza Katonda wange nga nkyali mulamu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Teweesiganga bafuzi,","poem":1},{"text":"wadde abantu obuntu omutali buyambi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kubanga bafa ne bakka emagombe;","poem":1},{"text":"ne ku lunaku olwo lwennyini, byonna bye baba bateeseteese ne bifa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yeesiimye oyo ayambibwa Katonda wa Yakobo;","poem":1},{"text":"ng’essuubi lye liri mu Mukama Katonda we,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"eyakola eggulu n’ensi","poem":1},{"text":"n’ennyanja ne byonna ebirimu,","poem":2},{"lineBreak":true},{"text":"era omwesigwa emirembe gyonna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Atereeza ensonga z’abajoogebwa mu bwenkanya,","poem":1},{"text":"n’abalumwa enjala abawa ebyokulya.","poem":2},{"text":"Mukama asumulula abasibe.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Mukama azibula amaaso ga bamuzibe,","poem":2},{"text":"era awanirira abazitoowereddwa.","poem":1},{"text":"Mukama ayagala abatuukirivu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mukama alabirira bannamawanga,","poem":1},{"text":"era ayamba bamulekwa ne bannamwandu;","poem":2},{"lineBreak":true},{"text":"naye ekkubo ly’abakola ebibi alifaafaaganya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mukama anaafuganga emirembe gyonna,","poem":1},{"text":"Katonda wo, Ayi Sayuuni, anaabanga Katonda wa buli mulembe.","poem":2},{"lineBreak":true},{"text":"Mutendereze Mukama!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}