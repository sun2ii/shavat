{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":147,"content":[{"type":"verse","number":1,"content":[{"text":"Mutendereze Mukama!","poem":1},{"lineBreak":true},{"text":"Kubanga kirungi okutenderezanga Katonda waffe;","poem":1},{"text":"kubanga ajjudde ekisa, n’oluyimba olw’okumutenderezanga lumusaanira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mukama azimba Yerusaalemi;","poem":1},{"text":"era akuŋŋaanya Abayisirayiri abaali mu buwaŋŋanguse.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Azzaamu amaanyi abo abalina emitima egimenyese,","poem":1},{"text":"era ajjanjaba ebiwundu byabwe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mukama ategeka omuwendo gw’emmunyeenye;","poem":1},{"text":"era buli emu n’agituuma erinnya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mukama waffe mukulu era wa kitiibwa; amaanyi g’obuyinza bwe tegatendeka,","poem":1},{"text":"n’okutegeera kwe tekuliiko kkomo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mukama awanirira abawombeefu,","poem":1},{"text":"naye abakola ebibi abasuulira ddala wansi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Muyimbire Mukama ennyimba ez’okumwebaza;","poem":1},{"text":"mumukubire entongooli ezivuga obulungi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mukama abikka eggulu n’ebire,","poem":1},{"text":"ensi agitonnyeseza enkuba,","poem":2},{"lineBreak":true},{"text":"n’ameza omuddo ne gukula ku nsozi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ente aziwa emmere, ne bannamuŋŋoona abato abakaaba abaliisa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Essanyu lya Mukama teriri mu maanyi ga mbalaasi,","poem":1},{"text":"wadde mu magulu g’omuntu,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"wabula Mukama asanyukira abo abamussaamu ekitiibwa,","poem":1},{"text":"era abalina essuubi mu kwagala kwe okutaggwaawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tendereza Mukama ggwe Yerusaalemi,","poem":1},{"text":"tendereza Katonda wo ggwe Sayuuni,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"kubanga ebisiba enzigi zo, ye abinyweza,","poem":1},{"text":"n’abantu bo abasulamu n’abawa omukisa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Aleeta emirembe ku nsalo zo;","poem":1},{"text":"n’akukkusa eŋŋaano esinga obulungi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Aweereza ekiragiro kye ku nsi;","poem":1},{"text":"ekigambo kye ne kibuna mangu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ayaliira omuzira ku ttaka ne gutukula ng’ebyoya by’endiga enjeru,","poem":1},{"text":"n’omusulo ogukutte n’agusaasaanya ng’evvu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Omuzira agukanyuga ng’obuyinjayinja;","poem":1},{"text":"bw’aleeta obutiti ani ayinza okubusobola?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mukama aweereza ekigambo kye, omuzira ne gusaanuuka;","poem":1},{"text":"n’akunsa empewo, amazzi ne gakulukuta.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yategeeza Yakobo ekigambo kye;","poem":1},{"text":"Isirayiri n’amanya amateeka ga Mukama n’ebiragiro bye.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Tewali ggwanga na limu lye yali akolaganye nalyo bw’atyo;","poem":1},{"text":"amawanga amalala tegamanyi mateeka ge.","poem":2},{"lineBreak":true},{"text":"Mutendereze Mukama!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}