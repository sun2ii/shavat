{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"Mutendereze Mukama!","poem":1},{"lineBreak":true},{"text":"Mumutendereze nga musinziira mu ggulu,","poem":1},{"text":"mumutenderereze mu bifo ebiri waggulu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mumutendereze mmwe mwenna bamalayika be,","poem":1},{"text":"mumutendereze mmwe mwenna eggye lye ery’omu ggulu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mmwe enjuba n’omwezi mutendereze Mukama,","poem":1},{"text":"nammwe mwenna emmunyeenye ezaaka mumutendereze.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tendereza Mukama ggwe eggulu eriri waggulu ennyo,","poem":1},{"text":"naawe amazzi agali waggulu w’eggulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Leka byonna bitendereze erinnya lya Mukama!","poem":1},{"text":"Kubanga ye yalagira, ne bitondebwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yabinywereza ddala mu bifo byabyo ennaku zonna,","poem":1},{"text":"n’ateekawo etteeka eritaliggwaawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mumutendereze nga musinziira ku nsi,","poem":1},{"text":"mmwe balukwata n’ebifo byonna eby’omu buziba bw’ennyanja,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"mmwe okumyansa, n’omuzira ogw’amakerenda, n’omuzira ogukutte era n’olufu,","poem":1},{"text":"naawe kikuŋŋunta, mugondere ekiragiro kye,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"mmwe agasozi n’obusozi,","poem":1},{"text":"emiti egy’ebibala n’emivule;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ensolo ez’omu nsiko era n’ente zonna,","poem":1},{"text":"ebyewalula n’ebinyonyi ebibuuka,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"bakabaka b’ensi n’amawanga gonna,","poem":1},{"text":"abalangira n’abafuzi bonna ab’ensi,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"abavubuka abalenzi n’abawala;","poem":1},{"text":"abantu abakulu n’abaana abato.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bitendereze erinnya lya Mukama,","poem":1},{"text":"kubanga erinnya lye lyokka lye ligulumizibwa;","poem":2},{"lineBreak":true},{"text":"ekitiibwa kye kisinga byonna eby’omu nsi n’eby’omu ggulu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abantu be abawadde amaanyi,","poem":1},{"text":"era agulumizizza abatukuvu be,","poem":2},{"lineBreak":true},{"text":"be bantu be Isirayiri abakolagana naye.","poem":2},{"lineBreak":true},{"text":"Mutendereze Mukama.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}