e","number":6,"content":[{"text":"Batenderezenga Katonda waabwe,","poem":1},{"text":"bakwate ekitala eky’obwogi obubiri,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"bawoolere eggwanga,","poem":1},{"text":"babonereze n’amawanga,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"bateeke bakabaka baago mu njegere,","poem":1},{"text":"n’abakungu baago babasibe amagulu n’ebyuma,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"babasalire omusango ogwabawandiikirwa.","poem":1},{"text":"Kino kye kitiibwa ky’abatukuvu be bonna.","poem":2},{"lineBreak":true},{"text":"Mutendereze Mukama.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}