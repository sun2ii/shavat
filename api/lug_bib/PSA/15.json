w’awola tasaba magoba;","poem":1},{"text":"so takkiriza kulya nguzi ku muntu yenna.","poem":2},{"lineBreak":true},{"text":"Oyo akola ebyo","poem":1},{"text":"aliba munywevu emirembe gyonna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}