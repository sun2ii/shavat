{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"hebrew_subtitle","content":["Ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Onkuume, Ayi Katonda,","poem":1},{"text":"kubanga ggwe buddukiro bwange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nagamba Mukama nti, “Ggwe Mukama wange,","poem":1},{"text":"ebirungi byonna bye nnina biva gy’oli.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abatukuvu abali mu nsi be njagala","poem":1},{"text":"era mu bo mwe nsanyukira.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ennaku y’abo abagoberera bakatonda abalala","poem":1},{"text":"yeeyongera.","poem":2},{"text":"Siriwaayo ssaddaaka zaabwe ez’omusaayi,","poem":1},{"noteId":1},{"text":"wadde okusinza bakatonda baabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mukama, ggwe mugabo gwange,","poem":1},{"text":"era ggw’oliisa obulamu bwange; era ggw’olabirira ebyange.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ensalo zange ziri mu bifo ebisanyusa,","poem":1},{"text":"ddala ddala omugabo omulungi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nnaatenderezanga Mukama kubanga annuŋŋamya","poem":1},{"text":"ne mu kiro ayigiriza omutima gwange.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nkulembeza Mukama buli kiseera,","poem":1},{"text":"era ali ku mukono gwange ogwa ddyo,","poem":2},{"lineBreak":true},{"text":"siinyeenyezebwenga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Noolwekyo omutima gwange gusanyuka, n’akamwa kange ne kajaguza;","poem":1},{"text":"era n’omubiri gwange gunaabeeranga mu mirembe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kubanga omwoyo gwange toliguleka magombe,","poem":1},{"text":"wadde okukkiriza Omutukuvu wo okuvunda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Olindaga ekkubo ery’obulamu;","poem":1},{"text":"w’oli we wanaabanga essanyu erijjuvu,","poem":2},{"lineBreak":true},{"text":"era mu mukono gwo ogwa ddyo nga mwe muli ebisanyusa emirembe gyonna.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Ssaddaaka ez’omusaayi zaaweebwangayo mu kusinza balubaale, era yali mpisa y’abo abaasinzanga balubaale. Empisa eyo, omuwandiisi wa Zabbuli gyavumirira","reference":{"chapter":16,"verse":4}}]},"thisChapterLink":"/api/lug_bib/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}