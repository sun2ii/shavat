{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":17,"content":[{"type":"hebrew_subtitle","content":["Okusaba kwa Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Wulira, Ayi Mukama, okukoowoola kwange nga nneegayirira,","poem":1},{"text":"wuliriza okukaaba kwange.","poem":2},{"text":"Tega okutu owulirize okukoowoola kwange,","poem":1},{"text":"kubanga tekuva ku mimwa gya bulimba.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nzigyako omusango;","poem":1},{"text":"kubanga olaba ekituufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Weekenneenyezza omutima gwange era n’onkebera n’ekiro.","poem":1},{"text":"Ne bw’onongezesa toobeeko kibi ky’onsangamu;","poem":2},{"lineBreak":true},{"text":"kubanga mmaliridde obutayogeranga bya bulimba.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ggwe, gwe nkoowoola,","poem":1},{"text":"ngoberedde ebigambo by’akamwa ko,","poem":2},{"text":"ne neewala","poem":1},{"text":"ebikolwa by’abantu abakambwe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nnyweredde mu makubo go,","poem":1},{"text":"era ebigere byange tebiigalekenga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nkukoowoola, Ayi Katonda, kubanga mmanyi ng’onnyanukula;","poem":1},{"text":"ontegere okutu kwo owulire okusaba kwange.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndaga okwagala kwo okutaggwaawo, okwewuunyisa,","poem":1},{"text":"ggwe alokola n’omukono gwo ogwa ddyo","poem":2},{"lineBreak":true},{"text":"abo bonna abakweyuna nga badduka abalabe baabwe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Onkuume ng’emmunye ey’eriiso lyo; onkweke mu kisiikirize ky’ebiwaawaatiro byo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Omponye ababi abannumba,","poem":1},{"text":"n’abalabe bange abanneetoolodde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Omutima gwabwe mukakanyavu,","poem":1},{"text":"n’akamwa kaabwe koogera by’amalala.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Banzingizza era banneetoolodde;","poem":1},{"text":"bansimbye amaaso nga beeteeseteese okunsuula wansi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bali ng’empologoma enjala gy’eruma eyeeteeseteese okutaagula omuyiggo gwayo","poem":1},{"text":"era ng’empologoma enkulu eteeze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Golokoka n’ekitala kyo, Ayi Mukama,","poem":1},{"text":"oyolekere abalabe bange obawangule, omponye ababi abo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ayi Mukama, mponya abantu,","poem":1},{"text":"abantu ab’ensi n’omukono gwo, kubanga balowooleza mu bya bulamu buno byokka, n’emigabo gyabwe giri mu nsi.","poem":2},{"lineBreak":true},{"text":"Embuto zaabwe zigezze,","poem":1},{"text":"obagaggawazizza ne baterekera n’abaana baabwe","poem":2},{"lineBreak":true},{"text":"ne bazzukulu baabwe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nze ndikulaba n’amaaso mu butuukirivu","poem":1},{"text":"era ndimatira, bwe ndiraba obwenyi bwo nga nzuukuse.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}