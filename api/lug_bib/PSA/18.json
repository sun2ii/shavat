{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":18,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi gye yayimbira Mukama bwe yamuwonya abalabe be ne Sawulo."]},{"type":"verse","number":1,"content":[{"text":"Nkwagala Ayi Mukama kubanga ggwe maanyi gange.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mukama lwe lwazi lwange, ky’ekigo kyange ekigumu era ye mununuzi wange,","poem":1},{"text":"ye Katonda wange era lwe lwazi lwange mwe neekweka;","poem":2},{"lineBreak":true},{"text":"ye ngabo yange era ye mulokozi wange ow’amaanyi, era kye kigo kyange ekinywevu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nkoowoola Mukama asaana okutenderezebwa,","poem":1},{"text":"era amponya eri abalabe bange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Emiguwa gy’okufa gyanneetooloola;","poem":1},{"text":"embuyaga ez’okusaanawo zansaanikira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ebisiba eby’amagombe byanneetooloola;","poem":1},{"text":"n’emitego gy’okufa ne ginjolekera.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mu nnaku yange nakoowoola Mukama;","poem":1},{"text":"ne nkaabirira Katonda wange annyambe.","poem":2},{"text":"Yawulira eddoboozi lyange ng’ali mu yeekaalu ye;","poem":1},{"text":"omulanga gwange ne gutuuka mu matu ge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Emisingi gy’ensi ne gikankana ne giyuuguuma;","poem":1},{"text":"ensozi ne zinyeenyezebwa ne ziseeseetuka,","poem":2},{"lineBreak":true},{"text":"kubanga yali asunguwadde.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Omukka ne gunyooka nga guva mu nnyindo ze.","poem":1},{"text":"Omuliro ne guva mu kamwa ke,","poem":2},{"lineBreak":true},{"text":"ne gukoleeza amanda ne gabuubuuka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yayabuluza eggulu n’akka wansi;","poem":1},{"text":"ebire ebikutte nga biri wansi w’ebigere bye.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yeebagala kerubi n’abuuka,","poem":1},{"noteId":2},{"text":"n’aseeyeeyeza ku biwaawaatiro by’empewo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yafuula ekizikiza ekyamwetooloolanga","poem":1},{"text":"okuba enkuufiira ey’ebire ebijjudde amazzi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Okumasamasa okwali mu maaso ge ne kuva mu bire bye,","poem":1},{"text":"n’okumyansa kw’eggulu n’omuzira.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mukama yabwatuka ng’asinziira mu ggulu; oyo Ali Waggulu Ennyo yayogera;","poem":1},{"text":"mu kamwa ke ne muvaamu omuzira n’okumyansa kw’eggulu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yalasa obusaale bwe n’asaasaanya abalabe;","poem":1},{"text":"n’okumyansa okw’eggulu n’abawangula.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ebiwonvu eby’omu nnyanja ne bibikkulwa","poem":1},{"text":"n’emisingi gy’ensi ne gyeyerula","poem":2},{"text":"olw’okunenya kwo Ayi Mukama","poem":1},{"text":"n’olw’okubwatuka kw’omukka ogw’omu nnyindo zo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mukama yagolola omukono gwe ng’ali waggulu,","poem":1},{"text":"n’ankwata n’annyinyulula mu mazzi amangi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yamponya abalabe bange ab’amaanyi,","poem":1},{"text":"abankyawa, abo abaali bansinza amaanyi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bannumba nga ndi mu buzibu,","poem":1},{"text":"naye Mukama n’annyamba.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"N’antwala mu kifo ekigazi n’amponya,","poem":1},{"text":"kubanga yansanyukira nnyo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mukama ankoledde ng’obutuukirivu bwange bwe buli,","poem":1},{"text":"ansasudde ng’ebikolwa byange ebirungi bwe biri.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kubanga ntambulidde mu makubo ga Mukama,","poem":1},{"text":"ne sikola kibi eri Katonda wange.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ddala ddala amateeka ga Mukama gonna ngagondedde,","poem":1},{"text":"era ne siva ku biragiro bye.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Sisobyanga mu maaso ge","poem":1},{"text":"era nneekuuma obutayonoona.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Noolwekyo, Mukama ansasudde ng’obutuukirivu bwange bwe buli,","poem":1},{"text":"era ng’ebikolwa byange ebirungi bwe biri by’alaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Eri omwesigwa weeraga ng’oli mwesigwa,","poem":1},{"text":"n’eri atalina musango weeraga nga tolina musango.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Eri abalongoofu weeraga ng’oli mulongoofu,","poem":1},{"text":"n’eri abakyamu weeraga ng’obasinza amagezi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Owonya abawombeefu,","poem":1},{"text":"naye abeegulumiza obakkakkanya.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Okoleezezza ettaala yange;","poem":1},{"text":"Ayi Mukama Katonda wange, ekizikiza kyange okimulisizza.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Bwe mbeera naawe nsobola okulumba abalabe bange;","poem":1},{"text":"nga ndi ne Katonda wange nsobola okuwalampa bbugwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Katonda byonna by’akola bigolokofu;","poem":1},{"text":"Mukama ky’asuubiza akituukiriza;","poem":2},{"text":"era bwe buddukiro","poem":1},{"text":"bw’abo bonna abamwekwekamu.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kale, ani Katonda, wabula Mukama?","poem":1},{"text":"Era ani Lwazi, wabula Katonda waffe?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Oyo ye Katonda ampa amaanyi era aluŋŋamya ekkubo lyange.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Ebigere byange abinyweza ng’eby’empeewo,","poem":1},{"text":"n’ansobozesa okuyimirira ku ntikko z’ensozi.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Anjigiriza okulwana entalo,","poem":1},{"text":"ne nsobola n’okuleega omutego ogw’obusaale ogw’ekikomo.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ompadde obulokozi bwo okuba engabo yange;","poem":1},{"text":"era ompaniridde n’omukono gwo ogwa ddyo;","poem":2},{"lineBreak":true},{"text":"weetoowazizza n’ongulumiza.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ongaziyirizza ekkubo ebigere byange we biyita,","poem":1},{"text":"obukongovvule bwange ne butanuuka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Nagoba abalabe bange embiro,","poem":1},{"text":"ne mbakwata ne sidda mabega okutuusa nga mbazikirizza.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Nababetenta ne batasobola na kugolokoka,","poem":1},{"text":"ne mbalinnyako ebigere byange.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Ompadde amaanyi ag’okulwana;","poem":1},{"text":"abalabe bange ne banvuunamira.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Okyusizza abalabe bange ne bankuba amabega ne badduka,","poem":1},{"text":"ne ndyoka nsanyaawo abo bonna abankyawa.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Baalaajana naye tewaali yabawonya;","poem":1},{"text":"ne bakaabirira Mukama, naye n’atabaddamu.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Ne mbamerengula ng’enfuufu empewo gy’efuumuula;","poem":1},{"text":"ne mbasammula eri ng’ebisooto by’omu luguudo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Omponyezza obulumbaganyi bw’abantu;","poem":1},{"text":"n’onfuula omufuzi w’amawanga.","poem":2},{"lineBreak":true},{"text":"Abantu be nnali simanyi ne bafuuka abaweereza bange.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Olumpulira ne baŋŋondera,","poem":1},{"text":"bannamawanga ne bajugumira mu maaso gange.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Bannamawanga baggwaamu omutima","poem":1},{"text":"ne bava mu bigo byabwe nga bakankana.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Mukama mulamu! Atenderezebwe, Olwazi lwange;","poem":1},{"text":"era agulumizibwe Katonda w’obulokozi bwange.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Ye Katonda, asasula ku lwange abankola obubi","poem":1},{"text":"era akakkanya amawanga ne ngafuga.","poem":2},{"lineBreak":true},{"text":"Amponyeza abalabe bange.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Ayi Mukama, ongulumizizza okusinga abalabe bange,","poem":1},{"text":"n’onkuuma abakambwe ne batankwatako.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Noolwekyo, Ayi Mukama, nnaakutenderezanga mu mawanga,","poem":1},{"text":"era nnaayimbanga nga ntendereza erinnya lyo.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Awa kabaka obuwanguzi obw’amaanyi,","poem":1},{"text":"amulaga ebyekisa emirembe gyonna oyo gwe yafukako amafuta,","poem":2},{"lineBreak":true},{"text":"eri Dawudi n’eri ezzadde lye.","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Bakerubi batonde ba Katonda era babeera mu kitiibwa kye. Be balabirira Entebe ey’Obwakabaka ey’Obwakatonda.","reference":{"chapter":18,"verse":10}}]},"thisChapterLink":"/api/lug_bib/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":50}