{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":19,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Eggulu litegeeza ekitiibwa kya Katonda,","poem":1},{"text":"ebbanga ne litegeeza emirimu gy’emikono gye.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Buli lunaku litegeeza ekitiibwa kye,","poem":1},{"text":"era liraga amagezi ge buli kiro.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tewali bigambo oba olulimi olwogerwa,","poem":1},{"text":"era n’eddoboozi lyabyo teriwulikika.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Naye obubaka bwabyo","poem":1},{"text":"bubunye mu nsi yonna.","poem":2},{"text":"Mu ggulu omwo Katonda mwe yasimbira enjuba eweema.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Evaayo ng’awasa omugole bw’ava mu nju ye,","poem":2},{"lineBreak":true},{"text":"era ng’omuddusi asinga bonna bw’ajjula essanyu ng’agenda mu mpaka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Evaayo ku ludda olumu olw’eggulu,","poem":1},{"text":"ne yeetooloola okutuuka ku nkomerero yaalyo,","poem":2},{"lineBreak":true},{"text":"era tewali kyekweka bbugumu lyayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ekiragiro kya Mukama kirimu byonna,","poem":1},{"text":"era kizzaamu amaanyi mu mwoyo.","poem":2},{"text":"Etteeka lya Mukama lyesigika,","poem":1},{"text":"ligeziwaza abatalina magezi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Okuyigiriza kwa Mukama kutuufu,","poem":1},{"text":"kusanyusa omutima gw’oyo akugondera.","poem":2},{"text":"Ebiragiro bya Mukama bimulisiza amaaso,","poem":1},{"text":"bye galaba.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Okutya Mukama kirungi,","poem":1},{"text":"era kya mirembe gyonna.","poem":2},{"text":"Ebiragiro bya Mukama bya bwenkanya,","poem":1},{"text":"era bya butuukirivu ddala.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ebyo byonna bisaana okuyaayaanirwa okusinga zaabu,","poem":1},{"text":"okusingira ddala zaabu ennungi ennyo.","poem":2},{"text":"Biwoomerera okusinga omubisi gw’enjuki,","poem":1},{"text":"okusukkirira omubisi gw’enjuki ogutonnya nga guva mu bisenge byagwo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ebyo bye birabula omuddu wo,","poem":1},{"text":"era mu kubigondera muvaamu empeera ennene.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ani asobola okulaba ebyonoono bye?","poem":1},{"text":"Onsonyiwe, Ayi Mukama, ebibi ebinkisiddwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Era omuddu wo omuwonye okukola ebibi ebigenderere,","poem":1},{"text":"bireme kunfuga.","poem":2},{"text":"Bwe ntyo mbeere ng’ataliiko kyakunenyezebwa","poem":1},{"text":"nneme okuzza omusango omunene ogw’ekibi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nsaba ebigambo by’omu kamwa kange, n’okulowooza okw’omu mutima gwange,","poem":1},{"text":"bisiimibwe mu maaso go,","poem":2},{"lineBreak":true},{"text":"Ayi Mukama, Olwazi lwange, era Omununuzi wange.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}