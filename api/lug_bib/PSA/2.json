{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Lwaki amawanga geegugunga","poem":1},{"text":"n’abantu ne bateganira obwereere okusala enkwe?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bakabaka ab’ensi bakuŋŋaanye,","poem":1},{"text":"n’abafuzi ne bateeseza wamu","poem":2},{"text":"ku Mukama","poem":1},{"text":"ne ku Kristo we, nga bagamba nti,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Ka tukutule enjegere zaabwe,","poem":1},{"text":"era tweyambulemu ekikoligo kyabwe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Naye Katonda oyo atuula mu ggulu,","poem":1},{"text":"abasekerera busekerezi, n’enkwe zaabwe ezitaliimu zimusesa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"N’alyoka abanenya ng’ajjudde obusungu,","poem":1},{"text":"n’abatiisa nnyo ng’aswakidde.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"N’abagamba nti, “Ddala ddala nateekawo kabaka owange","poem":1},{"text":"ku lusozi lwange Sayuuni olutukuvu.”","poem":2}]},{"type":"verse","number":7,"content":["Nzija kulangirira ekiragiro kya Mukama:",{"text":"kubanga yaŋŋamba nti, “Ggwe oli Mwana wange,","poem":1},{"text":"olwa leero nfuuse kitaawo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nsaba,","poem":1},{"text":"nange ndikuwa amawanga gonna okuba obusika bwo,","poem":2},{"lineBreak":true},{"text":"era n’ensi yonna gy’ekoma okuba amatwale go.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Olibafugisa omuggo ogw’ekyuma,","poem":1},{"text":"era olibabetenta ng’entamu y’omubumbi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kale nno mubeere n’amagezi mmwe bakabaka;","poem":1},{"text":"muyige okulabulwa mmwe abafuzi b’ensi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Muweereze Mukama nga mumutya,","poem":1},{"text":"era musanyuke n’okukankana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mwanirize Omwana, mumusembeze Mukama aleme okubasunguwalira","poem":1},{"text":"n’okubazikiriza nga muli mu kkubo lyammwe;","poem":2},{"text":"kubanga obusungu bwe bubuubuuka mangu.","poem":1},{"text":"Kyokka bonna abaddukira gy’ali balina omukisa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}