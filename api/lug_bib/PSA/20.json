{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Mukama akwanukulenga ng’oli mu buzibu.","poem":1},{"text":"Erinnya lya Katonda wa Yakobo likukuumenga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akuweerezenga obuyambi obuva mu kifo kye ekitukuvu;","poem":1},{"text":"akudduukirirenga okuva ku lusozi Sayuuni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ajjukirenga ssaddaaka zo zonna z’omuwa,","poem":1},{"text":"era asiimenga ebiweebwayo byo ebyokebwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Akuwenga omutima gwo bye gwetaaga,","poem":1},{"text":"era atuukirizenga by’oteekateeka byonna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tulijaganya olw’obuwanguzi bwo,","poem":1},{"text":"ne tuwuuba ebendera zaffe mu linnya lya Katonda waffe.","poem":2},{"lineBreak":true},{"text":"Mukama akuwenga byonna by’omusaba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kaakano ntegedde nga Mukama awanguza oyo gwe yafukako amafuta,","poem":1},{"text":"amwanukula ng’amuwa obuwanguzi n’omukono gwe ogwa ddyo,","poem":2},{"lineBreak":true},{"text":"ng’asinziira mu ggulu lye ettukuvu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abamu beesiga amagaali, n’abalala beesiga embalaasi,","poem":1},{"text":"naye ffe twesiga erinnya lya Mukama Katonda waffe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Batalantuka ne bagwa wansi ne balemerawo,","poem":1},{"text":"naye ffe tugolokoka ne tuyimirira nga tuli banywevu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ayi Mukama, lokola kabaka,","poem":1},{"text":"otwanukule bwe tukukoowoola.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}