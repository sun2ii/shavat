{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":21,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Ayi Mukama, kabaka ajaguliza mu maanyi go.","poem":1},{"text":"Obuwanguzi bw’omuwadde nga bumuleetedde essanyu lingi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Omuwadde omutima gwe bye gwetaaga,","poem":1},{"text":"era buli ky’asabye n’akamwa ke tokimummye.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ddala ddala wamwaniriza n’emikisa gyo egijjudde ebirungi,","poem":1},{"text":"n’omutikkira engule eya zaabu omuka ennyo ku mutwe gwe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yakusaba obulamu, era n’obumuwa,","poem":1},{"text":"ennaku ennyingi ez’emirembe n’emirembe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Obuwanguzi bwe wamuwa bumuleetedde ekitiibwa kinene.","poem":1},{"text":"Omuwadde ekitiibwa n’oyatiikirira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ddala omuwadde emikisa gyo egy’olubeerera,","poem":1},{"text":"n’omujjuza essanyu ng’oli naye buli kiseera.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kubanga kabaka yeesiga Mukama,","poem":1},{"text":"era olw’okwagala okutaggwaawo okw’oyo Ali Waggulu Ennyo,","poem":2},{"lineBreak":true},{"text":"kabaka tagenda kunyeenyezebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Omukono gwo guliwamba abalabe bo bonna;","poem":1},{"text":"omukono gwo ogwa ddyo gulikwata abo abakukyawa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bw’olirabika, Ayi Mukama,","poem":1},{"text":"olibasiriiza n’omuliro ng’ogw’omu kyoto ekyengeredde.","poem":2},{"text":"Mukama, ng’ajjudde obusungu, alibamira bonna,","poem":1},{"text":"era alibamalirawo ddala.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Olizikiriza ezzadde lyabwe ku nsi,","poem":1},{"text":"n’abaana baabwe bonna n’obamalawo mu baana b’abantu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Newaakubadde nga bakusalira enkwe,","poem":1},{"text":"ne bateekateeka ebikolwa ebibi, kyokka tewali kye basobola kutuukiriza.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Balikyuka ne bakudduka bwe baliraba","poem":1},{"text":"ng’obaleezeemu omutego gwo ogw’obusaale.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ogulumizibwenga, Ayi Mukama, mu maanyi go.","poem":1},{"text":"Tunaayimbanga nga tutendereza obuyinza bwo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}