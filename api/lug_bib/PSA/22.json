{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":22,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Katonda wange, Katonda wange, lwaki onjabulidde?","poem":1},{"text":"Lwaki ogaana okunnyamba","poem":2},{"lineBreak":true},{"text":"wadde okuwuliriza okwaziirana kwange?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ayi Katonda wange, emisana nkukoowoola, naye tonnyanukula;","poem":1},{"text":"n’ekiro bwe ntyo, naye siweerako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Songa ggwe Mutukuvu atudde ku Ntebe,","poem":1},{"text":"era ettendo lya Isirayiri yonna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bajjajjaffe baakwesiganga;","poem":1},{"text":"baakwesiga naawe n’obawonya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Baakukoowoolanga n’obalokola;","poem":1},{"text":"era baakwesiganga ne batajulirira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Naye nze ndi lusiriŋŋanyi, siri muntu;","poem":1},{"text":"abantu bampisaamu amaaso, n’abalala bannyooma.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bonna abandaba banduulira,","poem":1},{"text":"era banvuma nga bwe banyeenyeza omutwe nga bagamba nti,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Yeesiga Mukama;","poem":1},{"text":"kale amuwonye.","poem":2},{"text":"Obanga Mukama amwagala,","poem":1},{"text":"kale nno amulokole!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Naye ggwe wanziggya mu lubuto lwa mmange,","poem":1},{"text":"era wampa okukwesiga","poem":2},{"lineBreak":true},{"text":"ne mu buto bwange bwonna nga nkyayonka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Olwazaalibwa ne nteekebwa mu mikono gyo;","poem":1},{"text":"olwava mu lubuto lwa mmange n’obeera Katonda wange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tobeera wala nange,","poem":1},{"text":"kubanga emitawaana ginsemberedde,","poem":2},{"lineBreak":true},{"text":"ate nga tewali mulala n’omu asobola kunnyamba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Zisseddume nnyingi zinneetoolodde,","poem":1},{"text":"zisseddume enkambwe ez’e Basani","poem":2},{"noteId":3},{"text":"zinzingizizza.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Banjasamiza akamwa kaabwe","poem":1},{"text":"ng’empologoma bw’ewuluguma ng’etaagulataagula omuyiggo gwayo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngiyiddwa ng’amazzi,","poem":1},{"text":"n’amagumba gange gasowose mu nnyingo zaago.","poem":2},{"text":"Omutima gwange guli ng’obubaane,","poem":1},{"text":"era gusaanuukidde mu mubiri gwange.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Amaanyi gampweddemu, gakaze ng’oluggyo;","poem":1},{"text":"n’olulimi lwange lukutte waggulu mu kibuno kyange.","poem":2},{"lineBreak":true},{"text":"Ondese awo mu nfuufu ng’omufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Abantu ababi banneetoolodde;","poem":1},{"text":"banneebunguludde ng’embwa ennyingi;","poem":2},{"lineBreak":true},{"text":"banfumise ne bawummula ebibatu byange n’ebigere byange.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Amagumba gansowose nnyinza n’okugabala.","poem":1},{"text":"Abalabe bange bantunuulira nga bannyoomoola.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bagabana engoye zange;","poem":1},{"text":"era ekyambalo kyange bakikubira akalulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Naye ggwe, Ayi Mukama, tobeera wala nange.","poem":1},{"text":"Ggwe, Amaanyi gange, yanguwa okunnyamba!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Omponye okuttibwa n’ekitala;","poem":1},{"text":"obulamu bwange obw’omuwendo butaase mu maanyi g’embwa!","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nzigya mu kamwa k’empologoma,","poem":1},{"text":"omponye amayembe g’embogo enkambwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Nnaategezanga ku linnya lyo mu booluganda;","poem":1},{"text":"nnaakutenderezanga mu kibiina ky’abantu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mmwe abatya Mukama, mumutenderezenga.","poem":1},{"text":"Abaana ba Yakobo mwenna mumugulumizenga;","poem":2},{"lineBreak":true},{"text":"era mumussengamu ekitiibwa nga mumutya, mmwe abaana ba Isirayiri mwenna.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kubanga tanyooma kwaziirana","poem":1},{"text":"kw’abo abali mu nnaku,","poem":2},{"text":"era tabeekweka,","poem":1},{"text":"wabula abaanukula bwe bamukoowoola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Mu ggwe mwe muva ettendo lyange mu kibiina ekinene, ne nkutendereza olw’ebyo by’onkoledde.","poem":1},{"text":"Obweyamo bwange nnaabutuukirizanga mu maaso gaabo abakutya.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Abaavu banaalyanga ne bakkuta,","poem":1},{"text":"abo abanoonya Mukama banaamutenderezanga.","poem":2},{"lineBreak":true},{"text":"Emitima gyabwe ginaajaguzanga emirembe gyonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ensi zonna zirijjukira","poem":1},{"text":"ne zikyukira Mukama,","poem":2},{"text":"ebika byonna eby’amawanga gonna","poem":1},{"text":"birimuvuunamira.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kubanga obwakabaka bwonna bwa Mukama,","poem":1},{"text":"era y’afuga amawanga gonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Abagagga bonna ab’omu nsi balirya embaga, ne bamusinza.","poem":1},{"text":"Bonna abagenda mu nfuufu, balimufukaamirira,","poem":2},{"lineBreak":true},{"text":"abatakyali balamu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ezadde lyabwe lirimuweereza;","poem":1},{"text":"abaliddawo balibuulirwa ekigambo kya Mukama.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"N’abo abatannazaalibwa","poem":1},{"text":"balibuulirwa obutuukirivu bwe nti,","poem":2},{"lineBreak":true},{"text":"“Ekyo yakikoze.”","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Basani kyali kifo ekyali ku luuyi olw’obukiikakkono obw’ebuvanjuba, era kyali kimanyiddwa olw’ente zisseddume ez’amaanyi ate nga nsava.","reference":{"chapter":22,"verse":12}}]},"thisChapterLink":"/api/lug_bib/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}