{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Mukama ye Musumba wange, seetaagenga.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Angalamiza ne mpummulira mu ddundiro ly’omuddo omuto.","poem":2},{"text":"Antwala awali amazzi amateefu.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Akomyawo emmeeme yange.","poem":2},{"text":"Annuŋŋamya okukola eby’obutuukirivu","poem":1},{"text":"olw’erinnya lye.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Newaakubadde nga ntambulira mu kiwonvu eky’ekisiikirize eky’olumbe, siritya kabi konna;","poem":1},{"text":"kubanga ggwe oli nange.","poem":2},{"text":"Oluga lwo n’omuggo gwo","poem":1},{"text":"bye binsanyusa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Onsosootolera emmere","poem":1},{"text":"abalabe bange nga balaba;","poem":2},{"text":"onsiize amafuta ku mutwe,","poem":1},{"noteId":4},{"text":"ekikompe kyange kiyiwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ddala ddala obulungi n’okwagala okutaggwaawo binaagendanga nange","poem":1},{"text":"ennaku zonna ez’obulamu bwange;","poem":2},{"text":"nange nnaabeeranga mu nnyumba ya Mukama,","poem":1},{"text":"ennaku zonna.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Okusiiga omuntu amafuta ku mutwe, kaali kabonero akalaga nti omugenyi ayanirizibbwa ku mukolo.","reference":{"chapter":23,"verse":5}}]},"thisChapterLink":"/api/lug_bib/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}