{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"hebrew_subtitle","content":["Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Ensi ya Mukama n’ebigirimu byonna,","poem":1},{"text":"n’ensi zonna n’abo abazibeeramu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kubanga yasimba emisingi gyayo mu nnyanja,","poem":1},{"text":"n’agizimba ku mazzi amangi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Alyambuka ku lusozi lwa Mukama ye afaanana atya?","poem":1},{"text":"Era wa ngeri ki aliyingira n’ayimirira mu nnyumba ye entukuvu?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Oyo alina omutima omulongoofu, nga n’emikono gye mirongoofu;","poem":1},{"text":"atasinza bakatonda abalala,","poem":2},{"lineBreak":true},{"text":"era atalayirira bwereere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Oyo Mukama anaamuwanga omukisa,","poem":1},{"text":"n’obutuukirivu okuva eri Katonda ow’obulokozi bwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ogwo gwe mulembe gw’abo abakunoonya,","poem":1},{"text":"Ayi Katonda wa Yakobo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mweggulewo, mmwe bawankaaki!","poem":1},{"text":"Muggulwewo, mmwe enzigi ez’edda,","poem":2},{"lineBreak":true},{"text":"Kabaka ow’ekitiibwa ayingire.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kabaka ow’ekitiibwa ye ani?","poem":1},{"text":"Ye Mukama ow’amaanyi era ow’obuyinza,","poem":2},{"lineBreak":true},{"text":"omuwanguzi mu ntalo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mweggulewo, mmwe bawankaaki,","poem":1},{"text":"muggulwewo mmwe enzigi ez’edda!","poem":2},{"lineBreak":true},{"text":"Kabaka ow’ekitiibwa ayingire.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kabaka ow’ekitiibwa oyo ye ani?","poem":1},{"text":"Mukama Ayinzabyonna;","poem":2},{"lineBreak":true},{"text":"oyo ye Kabaka ow’ekitiibwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}