{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":25,"content":[{"type":"hebrew_subtitle","content":["Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Eri ggwe, Ayi Mukama,","poem":1},{"text":"gye ndeeta okusaba kwange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Neesiga ggwe, Ayi Mukama, tondeka kuswala mu maaso g’abalabe bange. Tobaganya kumpangula.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ddala ddala abakwesiga tebaajulirirenga,","poem":1},{"text":"naye ab’enkwe baliswazibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Njigiriza nga bwe nnaakolanga, Ayi Mukama,","poem":1},{"text":"ondage amakubo go mwe nnaatambuliranga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Onjigirizenga okunywerera ku mazima go, era onkulemberenga mu byonna;","poem":1},{"text":"kubanga ggwe Katonda, ow’obulokozi bwange","poem":2},{"lineBreak":true},{"text":"era essuubi lyange liri mu ggwe olunaku lwonna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Jjukira, Ayi Mukama, okusaasira kwo okunene, n’okwagala kwo okungi,","poem":1},{"text":"kubanga byava dda.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tojjukira bibi byange","poem":1},{"text":"n’obujeemu bwange eby’omu buvubuka bwange.","poem":2},{"text":"Onzijukire, Ayi Mukama,","poem":1},{"text":"ng’okwagala kwo gye ndi bwe kuli, kubanga oli mulungi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mukama mulungi, era wa mazima,","poem":1},{"text":"noolwekyo ayigiriza aboonoonyi ekkubo lye.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abawombeefu abaluŋŋamya mu kkubo ettuufu","poem":1},{"text":"n’abayigiriza ekkubo lye.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Amakubo ga Mukama gonna gajjudde okwagala n’amazima","poem":1},{"text":"eri abo abagondera endagaano ye n’ebiragiro bye.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Olw’erinnya lyo, Ayi Mukama,","poem":1},{"text":"onsonyiwe ebibi byange, kubanga bingi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Omuntu wa ngeri ki atya Katonda?","poem":1},{"text":"Oyo gw’anaayigirizanga okukwata ekkubo lye yamulondera.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Obulamu bwe bunajjuzibwanga emikisa gya Katonda,","poem":1},{"text":"era bazzukulu be ensi eriba yaabwe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mikwano gya Mukama be bo abamugondera;","poem":1},{"text":"anaababikkuliranga ekyama eky’endagaano ye.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ntunuulira Mukama buli kiseera,","poem":1},{"text":"kubanga yekka y’anzigya mu kabi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nkyukira, Ayi Mukama, onkwatirwe ekisa,","poem":1},{"text":"kubanga nsigadde bw’omu, era ndi munafu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Obuyinike bweyongedde mu mutima gwange;","poem":1},{"text":"mponya okweraliikirira kwange.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tunuulira ennaku endiko, weetegereze obulumi bwange;","poem":1},{"text":"onzigyeko ebibi byange byonna.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Laba abalabe bange nga bwe beeyongedde obungi","poem":1},{"text":"n’okunkyawa kwe bankyawamu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Labiriranga obulamu bwange, obamponye;","poem":1},{"text":"tondekanga mu buswavu,","poem":2},{"lineBreak":true},{"text":"kubanga ggwe kiddukiro kyange.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Amazima n’obulongoofu bindabirirenga,","poem":1},{"text":"essubi lyange liri mu ggwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Nunula Isirayiri, Ayi Katonda,","poem":1},{"text":"omuwonye emitawaana gye gyonna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}