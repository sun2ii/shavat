{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Onnejjeereze, Ayi Mukama,","poem":1},{"text":"kubanga obulamu bwange tebuliiko kya kunenyezebwa;","poem":2},{"text":"nneesiga ggwe, Ayi Mukama,","poem":1},{"text":"nga sibuusabuusa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Neetegereza, Ayi Mukama, ongezese;","poem":1},{"text":"weekalirize ebiri mu mutima gwange ne mu mmeeme yange.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kubanga okwagala kwo kwe kunkulembera,","poem":1},{"text":"era mu mazima go mwe ntambulira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Situula na bantu balimba,","poem":1},{"text":"so siteesaganya na bakuusa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nkyawa ekibiina ky’aboonoonyi;","poem":1},{"text":"so situula na bakozi ba bibi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Naaba mu ngalo zange okulaga nga bwe sirina misango;","poem":1},{"noteId":5},{"text":"ne ndyoka nzija ku Kyoto kyo, Ayi Mukama;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ne nnyimba oluyimba olw’okwebaza,","poem":1},{"text":"olwogera ku bikolwa byo ebyewuunyisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ennyumba yo mw’obeera njagala, Ayi Mukama,","poem":1},{"text":"kye kifo ekijjudde ekitiibwa kyo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tombalira mu boonoonyi,","poem":1},{"text":"wadde mu batemu,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"abakozesa emikono gyabwe okutegeka ebikolwa ebibi,","poem":1},{"text":"era abali b’enguzi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Naye nze ntambula nga siriiko kye nnenyezebwa;","poem":1},{"text":"nkwatirwa ekisa, Ayi Mukama, ondokole.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nnyimiridde watereevu.","poem":1},{"text":"Nnaatenderezanga Mukama mu kibiina ky’abantu ekinene.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Okunaaba mu ngalo mu lujjudde, kaali kabonero akalaga ng’omuntu oyo bw’atalina musango","reference":{"chapter":26,"verse":6}}]},"thisChapterLink":"/api/lug_bib/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}