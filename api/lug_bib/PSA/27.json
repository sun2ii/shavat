{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":27,"content":[{"type":"hebrew_subtitle","content":["Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Mukama gwe musana gwange n’obulokozi bwange;","poem":1},{"text":"ani gwe nnaatyanga?","poem":2},{"text":"Mukama ge maanyi ag’obulamu bwange;","poem":1},{"text":"ani asobola okuntiisa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Abalabe bange n’abantu ababi bonna","poem":1},{"text":"bwe banannumba nga baagala okunzita,","poem":2},{"text":"baneesittala","poem":1},{"text":"ne bagwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Newaakubadde ng’eggye linaasiisira okunneebungulula,","poem":1},{"text":"omutima gwange teguutyenga;","poem":2},{"text":"olutalo ne bwe lunansitukirangako,","poem":1},{"text":"nnaabanga mugumu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ekintu kimu kye nsaba Mukama,","poem":1},{"text":"era ekyo kye nnoonya:","poem":2},{"text":"okubeeranga mu nnyumba ya Mukama","poem":1},{"text":"ennaku zonna ez’obulamu bwange,","poem":2},{"text":"ne ndabanga obulungi bwa Mukama,","poem":1},{"text":"era ne nsinzizanga mu Yeekaalu ye.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kubanga mu biseera eby’obuzibu","poem":1},{"text":"anansuzanga mu nju ye;","poem":2},{"text":"anankwekanga mu weema ye,","poem":1},{"text":"n’ankuumira ku lwazi olugulumivu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Olwo ononnyimusanga","poem":1},{"text":"waggulu w’abalabe bange abanneetoolodde.","poem":2},{"text":"Nnaaweerangayo ssaddaaka mu weema ye nga bwe ntendereza n’eddoboozi ery’omwanguka olw’essanyu;","poem":1},{"text":"nnaayimbiranga Mukama ennyimba ez’okumutenderezanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wulira eddoboozi lyange, Ayi Mukama, nga nkukoowoola;","poem":1},{"text":"onkwatirwe ekisa onnyanukule!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Omutima gwange guwulidde eddoboozi lyo nga lyogera nti, “Munnoonye, munsinze.”","poem":1},{"text":"Omutima gwange ne guddamu nti, “Nnaakunoonyanga, Ayi Mukama.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tonneekweka,","poem":1},{"text":"so tonyiigira muweereza wo,","poem":2},{"lineBreak":true},{"text":"kubanga ggw’obadde omubeezi wange bulijjo.","poem":2},{"text":"Tonneggyaako, so tonsuula,","poem":1},{"text":"Ayi Katonda, Omulokozi wange.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kitange ne mmange bwe balindeka,","poem":1},{"text":"Mukama anandabiriranga.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Njigiriza, Ayi Mukama, by’oyagala nkole,","poem":1},{"text":"era onkulembere mu kkubo lyo,","poem":2},{"lineBreak":true},{"text":"kubanga abalabe bange banneetoolodde.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tompaayo mu balabe bange,","poem":1},{"text":"kubanga abajulizi ab’obulimba bansitukiddeko n’enkwe zaabwe,","poem":2},{"lineBreak":true},{"text":"okunkambuwalira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nkyakakasiza ddala","poem":1},{"text":"nga ndiraba obulungi bwa Mukama","poem":2},{"lineBreak":true},{"text":"mu nsi ey’abalamu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Lindirira Mukama.","poem":1},{"text":"Ddamu amaanyi, ogume omwoyo.","poem":2},{"lineBreak":true},{"text":"Weewaawo, lindirira Mukama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}