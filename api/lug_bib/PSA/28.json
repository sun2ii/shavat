{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":28,"content":[{"type":"hebrew_subtitle","content":["Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Nkukoowoola ggwe, Ayi Mukama, Olwazi lwange,","poem":1},{"text":"tolema kumpuliriza;","poem":2},{"text":"kubanga bw’onoonsiriikirira","poem":1},{"text":"nzija kuba nga bali abakkirira mu kinnya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Owulire eddoboozi ery’okwegayirira kwange,","poem":1},{"text":"nga mpanise emikono gyange","poem":2},{"text":"okwolekera ekifo kyo ekisinga byonna obutukuvu,","poem":1},{"text":"nga nkukaabirira okunnyamba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tontwalira mu boonoonyi,","poem":1},{"text":"abakola ebibi;","poem":2},{"text":"abanyumya obulungi ne bannaabwe,","poem":1},{"text":"so ng’emitima gyabwe gijjudde bukyayi bwerere.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Basasule ng’ebikolwa byabwe bwe biri,","poem":1},{"text":"n’olw’ebyambyone bye bakoze.","poem":2},{"text":"Basasule olwa byonna emikono gyabwe gye bisobezza,","poem":1},{"text":"obabonereze nga bwe basaanidde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Olwokubanga tebafaayo ku mirimu gya Mukama,","poem":1},{"text":"oba ku ebyo bye yakola n’emikono gye,","poem":2},{"text":"alibazikiririza ddala,","poem":1},{"text":"era talibaddiramu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Atenderezebwe Mukama,","poem":1},{"text":"kubanga awulidde eddoboozi ly’okwegayirira kwange.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mukama ge maanyi gange,","poem":1},{"text":"era ye ngabo yange, ye gwe neesiga.","poem":2},{"text":"Bwe ntyo ne nyambibwa.","poem":1},{"text":"Omutima gwange gunaajaguzanga, ne mmuyimbira ennyimba ez’okumwebazanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mukama y’awa abantu be amaanyi,","poem":1},{"text":"era kye kiddukiro eky’obulokozi bw’oyo gwe yafukako amafuta.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Olokole abantu bo, obawe omukisa abalonde bo.","poem":1},{"text":"Obakulemberenga ng’omusumba, era obawanirirenga emirembe gyonna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}