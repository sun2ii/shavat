{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"hebrew_subtitle","content":["Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Mutendereze Mukama, mmwe abaana b’ab’amaanyi.","poem":1},{"text":"Mutendereze Mukama n’ekitiibwa n’amaanyi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mutendereze Mukama n’ekitiibwa ekisaanira erinnya lye;","poem":1},{"text":"musinze Mukama mu kitiibwa eky’obutukuvu bwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Eddoboozi lya Mukama liwulirwa ku mazzi;","poem":1},{"text":"Katonda ow’ekitiibwa abwatuka,","poem":2},{"lineBreak":true},{"text":"n’eddoboozi lye ne liwulirwa ku mazzi amangi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Eddoboozi lya Mukama ly’amaanyi;","poem":1},{"text":"eddoboozi lya Mukama lijjudde ekitiibwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eddoboozi lya Mukama limenya emivule;","poem":1},{"text":"Mukama amenyaamenya emivule gya Lebanooni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Aleetera Lebanooni okubuukabuuka ng’akayana,","poem":1},{"text":"ne Siriyooni","poem":2},{"noteId":6},{"text":"ng’ennyana y’embogo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Eddoboozi lya Mukama","poem":1},{"text":"libwatukira mu kumyansa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Eddoboozi lya Mukama likankanya eddungu;","poem":1},{"text":"Mukama akankanya eddungu lya Kadesi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Eddoboozi lya Mukama linyoolanyoola emivule,","poem":1},{"text":"n’emiti mu bibira ne gitasigalako makoola.","poem":2},{"text":"Mu Yeekaalu ye, abantu bonna boogerera waggulu nti, “Ekitiibwa kibe eri Mukama!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mukama atuula waggulu w’amataba ku ntebe ye ey’obwakabaka.","poem":1},{"text":"Mukama ye Kabaka afuga emirembe gyonna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mukama awa abantu be amaanyi;","poem":1},{"text":"Mukama awa abantu be emirembe.","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"Siriyooni linnya eribbulwa mu bitundu bya Kalumooni. Kalumooni ye yali ensalo ey’omu bukiikakkono obw’ensi ensuubize","reference":{"chapter":29,"verse":6}}]},"thisChapterLink":"/api/lug_bib/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}