{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["Zabbuli ya Dawudi bwe yadduka mutabani we Abusaalomu."]},{"type":"verse","number":1,"content":[{"text":"Ayi Mukama, abalabe bange nga beeyongedde obungi!","poem":1},{"text":"Abanfubutukiddeko okunnumba nga bangi!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bangi abanjogerako nti,","poem":1},{"text":"“Katonda tagenda kumununula.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Naye ggwe, Ayi Mukama, ggwe ngabo yange enkuuma;","poem":1},{"text":"ggwe kitiibwa kyange, era gw’onzizaamu amaanyi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nkoowoola Mukama n’eddoboozi ery’omwanguka,","poem":1},{"text":"n’annyanukula ng’asinziira ku lusozi lwe olutukuvu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ngalamira ne neebaka, era ne nzuukuka bulungi,","poem":1},{"text":"kubanga Mukama ye ampanirira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Siityenga enkumi n’enkumi z’abalabe bange","poem":1},{"text":"abanneetoolodde, okunnumba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Golokoka, Ayi Mukama,","poem":1},{"text":"ondokole Ayi Katonda wange","poem":2},{"text":"okube abalabe bange bonna","poem":1},{"text":"omenye oluba lw’abakola ebibi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Obulokozi buva gy’oli, Ayi Mukama.","poem":1},{"text":"Emikisa gyo gibeerenga ku bantu bo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}