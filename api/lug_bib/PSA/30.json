{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"hebrew_subtitle","content":["Zabbuli n’Oluyimba. Okuwaayo Yeekaalu. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Nnaakugulumizanga, Ayi Mukama,","poem":1},{"text":"kubanga wannyimusa;","poem":2},{"lineBreak":true},{"text":"n’otoganya balabe bange kunneeyagalirako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ayi Mukama, nakukaabirira onnyambe,","poem":1},{"text":"n’omponya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ayi Mukama, omwoyo gwange waguggya emagombe,","poem":1},{"text":"n’omponya ekinnya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Muyimbire Mukama nga mumutendereza, mmwe abatukuvu be;","poem":1},{"text":"mutendereze erinnya lye ettukuvu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kubanga obusungu bwe bwa kiseera buseera,","poem":1},{"text":"naye obulungi bwe bwa mirembe gyonna.","poem":2},{"text":"Amaziga gayinza okubaawo ekiro kyokka","poem":1},{"text":"essanyu ne lijja nga bukedde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bwe namala okunywera","poem":1},{"text":"ne njogera nti, “Sigenda kusiguukululwa.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ayi Mukama, bwe wanjagala,","poem":1},{"text":"wanyweza olusozi lwange;","poem":2},{"text":"naye bwe wankweka amaaso go","poem":1},{"text":"ne neeraliikirira.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ggwe gwe nakoowoola, Ayi Mukama;","poem":1},{"text":"ne nkukaabirira Mukama, onsaasire.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Kingasa ki bwe nzika mu kinnya","poem":1},{"text":"ne nzikirira?","poem":2},{"text":"Enfuufu eneekutenderezanga","poem":1},{"text":"n’etegeeza abantu obwesigwa bwo?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mpuliriza, Ayi Mukama, onsaasire;","poem":1},{"text":"Ayi Mukama, onnyambe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ofudde okwaziirana kwange amazina;","poem":1},{"text":"onnyambuddemu ebibukutu, n’onnyambaza essanyu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Omutima gwange gulemenga kusirika busirisi, wabula gukuyimbirenga ennyimba ez’okukutenderezanga.","poem":1},{"text":"Ayi Mukama, Katonda wange, nnaakwebazanga emirembe gyonna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}