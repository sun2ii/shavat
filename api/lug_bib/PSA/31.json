{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":31,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Ayi Mukama, ggwe kiddukiro kyange,","poem":1},{"text":"leka nneme kuswazibwa.","poem":2},{"lineBreak":true},{"text":"Ndokola mu butuukirivu bwo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ontegere okutu kwo","poem":1},{"text":"oyanguwe okunziruukirira.","poem":2},{"text":"Beera ekiddukiro kyange eky’olwazi","poem":1},{"text":"era ekigo eky’amaanyi eky’okumponya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nga bw’oli olwazi lwange era ekigo kyange;","poem":1},{"text":"olw’erinnya lyo onkulembebere era onnuŋŋamye.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Omponye mu mutego gwe banteze;","poem":1},{"text":"kubanga ggwe kiddukiro kyange.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nteeka omwoyo gwange mu mikono gyo;","poem":1},{"text":"ondokole, Ayi Mukama, Katonda ow’amazima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nkyawa abo abeesiga bakatonda abalala;","poem":1},{"text":"nze nneesiga Mukama.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nnaajaguzanga ne nsanyukira mu kwagala kwo,","poem":1},{"text":"kubanga olabye okubonaabona kwange","poem":2},{"lineBreak":true},{"text":"era omanyi ennaku endi ku mwoyo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tompaddeeyo mu balabe bange,","poem":1},{"text":"naye otadde ebigere byange mu kifo ekigazi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Onsaasire, Ayi Mukama, kubanga ndi mu nnaku nnyingi;","poem":1},{"text":"amaaso gange gakooye olw’ennaku;","poem":2},{"lineBreak":true},{"text":"omwoyo gwange n’omubiri gwange nabyo binafuye olw’obuyinike.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Obulamu bwange buweddewo olw’obunaku n’emyaka gyange","poem":1},{"text":"ne giggwaawo olw’okusinda.","poem":2},{"text":"Amaanyi gampweddemu olw’okwonoona kwange,","poem":1},{"text":"n’amagumba ganafuye.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abalabe bange bonna bansekerera,","poem":1},{"text":"banneetamiddwa.","poem":2},{"text":"Nfuuse ekyenyinyalwa mu mikwano gyange,","poem":1},{"text":"n’abandaba mu kkubo banziruka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nneerabiddwa ng’eyafa edda;","poem":1},{"text":"nfuuse ng’ekibumbe ekyatifu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Buli ludda mpulirayo obwama","poem":1},{"text":"nga bangeya;","poem":2},{"text":"bye banteesaako","poem":1},{"text":"nga basala olukwe okunzita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Naye nneesiga ggwe, Ayi Mukama;","poem":1},{"text":"nga njogera nti, “Oli Katonda wange.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Entuuko zange ziri mu mikono gyo;","poem":1},{"text":"ondokole mu mikono gy’abalabe bange","poem":2},{"lineBreak":true},{"text":"n’abangigganya.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Amaaso go ogatunuulize omuweereza wo;","poem":1},{"text":"ondokole n’okwagala kwo okutaggwaawo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ayi Mukama tondeka kuswazibwa,","poem":1},{"text":"kubanga nkukoowoola;","poem":2},{"text":"leka abo ababi baswale,","poem":1},{"text":"era bagalamire emagombe nga basirise.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Akamwa kaabwe akayogera eby’obulimba","poem":1},{"text":"kasirisibwe,","poem":2},{"text":"kubanga boogera ebitaliimu ku batuukirivu bo,","poem":1},{"text":"nga babyogeza amalala n’okunyooma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Obulungi bwo,","poem":1},{"text":"bwe waterekera abo abakutya nga buyitirivu,","poem":2},{"text":"n’obuwa mu lwatu","poem":1},{"text":"abo abaddukira gy’oli.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Obalabirira n’obawonya enkwe z’abalabe baabwe,","poem":1},{"text":"n’obakuuma bulungi mu nnyumba yo,","poem":2},{"text":"n’ennyombo z’abantu","poem":1},{"text":"ne zitabatuukako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mukama atenderezebwenga","poem":1},{"text":"kubanga yandaga okwagala kwe okungi,","poem":2},{"lineBreak":true},{"text":"bwe nnali mu kibuga kye baali bazingizza.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bwe natya ennyo","poem":1},{"text":"ne njogera nti, “Ngobeddwa mu maaso go.”","poem":2},{"text":"Kyokka wampulira nga nkukaabirira","poem":1},{"text":"n’onsaasira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Mwagalenga Mukama abatukuvu be mwenna!","poem":1},{"text":"Mukama akuuma abo abamwesiga,","poem":2},{"lineBreak":true},{"text":"naye ab’amalala ababonereza mu bujjuvu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Muddeemu amaanyi mugume omwoyo","poem":1},{"text":"mmwe mwenna abalina essuubi mu Mukama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}