{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":32,"content":[{"type":"hebrew_subtitle","content":["Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Alina omukisa oyo","poem":1},{"text":"asonyiyiddwa ebyonoono bye","poem":2},{"lineBreak":true},{"text":"ekibi ne kiggyibwawo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Alina omukisa omuntu oyo","poem":1},{"text":"Mukama gw’atakyabalira kibi kye,","poem":2},{"lineBreak":true},{"text":"ne mu mutima gwe nga temuli bukuusa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bwe nasirikiranga ekibi kyange,","poem":1},{"text":"ne nkogga,","poem":2},{"lineBreak":true},{"text":"kubanga nasindanga olunaku lwonna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wambonerezanga","poem":1},{"text":"emisana n’ekiro,","poem":2},{"text":"amaanyi ne ganzigwamu","poem":1},{"text":"ng’amazzi bwe gakalira mu kyeya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Awo ne nkwatulira ekibi kyange,","poem":1},{"text":"ne sibikkirira kwonoona kwange.","poem":2},{"text":"Ne njogera nti,","poem":1},{"text":"“Leka neenenyeze Mukama ebibi byange.”","poem":2},{"text":"Bw’otyo n’onsonyiwa,","poem":1},{"text":"n’onziggyako omusango gw’ebibi byange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Noolwekyo abaweereza bo bonna abeesigwa","poem":1},{"text":"bakwegayirire ng’okyalabika;","poem":2},{"text":"oluvannyuma ebizibu bwe birijja,","poem":1},{"text":"ng’amazzi ag’amaanyi amangi tebiribatuukako.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Oli kifo kyange mwe nneekweka,","poem":1},{"text":"ononkuumanga ne situukwako kabi","poem":2},{"lineBreak":true},{"text":"era ononneetooloozanga ennyimba ez’obulokozi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nnaakulagiranga era ne nkuyigiriza ekkubo mw’onootambuliranga;","poem":1},{"text":"nnaakuwanga amagezi nga bwe nkulabirira.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Temubeeranga ng’embalaasi","poem":1},{"text":"oba ennyumbu ezitategeera,","poem":2},{"text":"ze bateekwa okussa ekyuma mu kamwa ekisibwa ku lukoba,","poem":1},{"text":"ziryoke zifugibwe zijje gy’oli.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ababi balaba ennaku nnyingi;","poem":1},{"text":"naye abeesiga Mukama bakuumirwa","poem":2},{"lineBreak":true},{"text":"mu kwagala kwe okutaggwaawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Musanyukire mu Mukama era mujaguze mmwe abatuukirivu,","poem":1},{"text":"era muyimbire waggulu n’essanyu mmwe abalina omutima omulongoofu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}