{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":33,"content":[{"type":"hebrew_subtitle","content":["Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Muyimbire Mukama n’essanyu mmwe abatuukirivu;","poem":1},{"text":"kisaanira abalongoofu okumutenderezanga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mutendereze Mukama n’ennanga,","poem":1},{"text":"mumukubire ennyimba ku ntongooli ey’enkoba ekkumi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mumuyimbire oluyimba oluggya;","poem":1},{"text":"musune enkoba ze ntongooli n’amagezi nga bwe muyimba mu ddoboozi ery’omwanguka olw’essanyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kubanga ekigambo kya Mukama kituufu era kya mazima;","poem":1},{"text":"mwesigwa mu buli ky’akola.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mukama ayagala obutuukirivu n’obwenkanya.","poem":1},{"text":"Ensi ejjudde okwagala kwa Mukama okutaggwaawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mukama yayogera kigambo, eggulu ne likolebwa;","poem":1},{"text":"n’assiza omukka mu kamwa ke eggye lyonna ery’omu ggulu ne litondebwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yakuŋŋaanya amazzi g’ennyanja mu ntuumu,","poem":1},{"text":"agayanja n’agasibira mu masitoowa gaago.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ensi yonna esaana etyenga Mukama,","poem":1},{"text":"n’abantu ab’omu mawanga gonna bamussengamu ekitiibwa;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"kubanga yayogera bwogezi n’etondebwa,","poem":1},{"text":"n’alagira n’eyimirira nga nywevu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mukama asansulula enteekateeka y’amawanga;","poem":1},{"text":"alemesa abantu okutuukiriza bye bagenderera.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Naye enteekateeka za Mukama zibeerawo nga nywevu emirembe gyonna;","poem":1},{"text":"n’ebigendererwa by’omutima gwe bya lubeerera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Lirina omukisa eggwanga eririna Katonda nga ye Mukama waalyo,","poem":1},{"text":"ng’abantu baalyo yabalonda babeere bantu be.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mukama asinziira mu ggulu","poem":1},{"text":"n’alaba abaana b’abantu bonna;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"asinziira mu kifo kye mw’abeera","poem":1},{"text":"n’alaba abantu bonna abali ku nsi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ye y’ategeka ebirowoozo byabwe bonna","poem":1},{"text":"ne yeetegereza byonna bye bakola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Tewali kabaka asobola kuwona olw’obunene bw’eggye lye;","poem":1},{"text":"era tewali mulwanyi ayinza kuwona olw’amaanyi ge amangi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Okusuubira embalaasi yokka okukuwanguza olutalo kuteganira bwerere;","poem":1},{"text":"newaakubadde erina amaanyi mangi naye tesobola kulokola.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Naye amaaso ga Mukama galabirira abo abamutya;","poem":1},{"text":"abalina essuubi mu kwagala kwe okutaggwaawo,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"abawonya okufa,","poem":1},{"text":"era abawonya enjala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tulindirira Mukama nga tulina essuubi,","poem":1},{"text":"kubanga ye mubeezi waffe era ye ngabo yaffe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mu ye emitima gyaffe mwe gijaguliza,","poem":1},{"text":"kubanga twesiga erinnya lye ettukuvu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Okwagala kwo okutaggwaawo kubeerenga mu ffe,","poem":1},{"text":"Ayi Mukama, ng’essuubi lyaffe bwe liri mu ggwe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}