{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":34,"content":[{"type":"hebrew_subtitle","content":["Ya Dawudi. Bwe yeefuula okuba omugu w’eddalu mu maaso ga Abimereki, oluvannyuma eyamugoba, era naye n’amuviira."]},{"type":"verse","number":1,"content":[{"text":"Nnaagulumizanga Mukama buli kiseera,","poem":1},{"text":"akamwa kange kanaamutenderezanga bulijjo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Omwoyo gwange guneenyumiririzanga mu Mukama;","poem":1},{"text":"ababonyaabonyezebwa bawulire bajaguzenga.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kale tutendereze Mukama,","poem":1},{"text":"ffenna tugulumizenga erinnya lye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nanoonya Mukama, n’annyanukula;","poem":1},{"text":"n’ammalamu okutya kwonna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abamwesiga banajjulanga essanyu,","poem":1},{"text":"era tebaaswalenga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Omunaku ono yakoowoola Mukama n’amwanukula,","poem":1},{"text":"n’amumalako ebyali bimuteganya byonna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Malayika wa Mukama yeebungulula abo abatya Mukama,","poem":1},{"text":"n’abawonya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mulegeeko mulabe nga Mukama bw’ali omulungi!","poem":1},{"text":"Balina omukisa abaddukira gy’ali.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Musseemu Mukama ekitiibwa mmwe abatukuvu be,","poem":1},{"text":"kubanga abamutya tebaajulenga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Empologoma zirumwa enjala ne ziggwaamu amaanyi;","poem":1},{"text":"naye abo abanoonya Mukama, ebirungi tebiibaggwengako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mujje wano baana bange, mumpulirize;","poem":1},{"text":"mbayigirize okutya Mukama.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Oyagala okuwangaala mu bulamu obulungi,","poem":1},{"text":"okuba mu ssanyu emyaka emingi?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Olulimi lwo lukuumenga luleme okwogera ebitasaana,","poem":1},{"text":"n’akamwa ko kaleme okwogera eby’obulimba.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Lekeraawo okukola ebibi, okolenga ebirungi;","poem":1},{"text":"noonya emirembe era ogigobererenga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Amaaso ga Mukama gatunuulira abo abatuukirivu,","poem":1},{"text":"n’amatu ge gawulira okukaaba kwabwe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mukama amaliridde okumalawo abakola ebibi,","poem":1},{"text":"okubasaanyizaawo ddala n’obutaddayo kujjukirwa ku nsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Abatuukirivu bakoowoola Mukama n’abawulira","poem":1},{"text":"n’abawonya mu byonna ebiba bibateganya.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mukama abeera kumpi n’abalina emitima egimenyese, era alokola abo abalina emyoyo egyennyise.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Omuntu omutuukirivu ayinza n’okuba n’ebizibu bingi,","poem":1},{"text":"naye byonna Mukama abimuyisaamu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Amagumba ge gonna Mukama agakuuma,","poem":1},{"text":"ne watabaawo na limu limenyeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ekibi kiritta abakola ebibi,","poem":1},{"text":"n’abalabe b’abatuukirivu balibonerezebwa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mukama anunula abaweereza be;","poem":1},{"text":"so tewali n’omu ku abo abaddukira gy’ali alibonerezebwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}