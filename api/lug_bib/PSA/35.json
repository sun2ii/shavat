{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":35,"content":[{"type":"hebrew_subtitle","content":["Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Ayi Mukama, wakanya abo abampakanya,","poem":1},{"text":"lwanyisa abo abannwanyisa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Golokoka okwate engabo,","poem":1},{"text":"n’akagabo onziruukirire.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Galula effumu,","poem":1},{"text":"abangigganya obazibire ekkubo;","poem":2},{"text":"otegeeze omwoyo gwange nti,","poem":1},{"text":"“Nze bulokozi bwo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Abo bonna abannoonya okunzita bajolongebwe","poem":1},{"text":"era baswazibwe;","poem":2},{"text":"abo abateesa okunsanyaawo","poem":1},{"text":"bazzibweyo ennyuma babune emiwabo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Babe ng’ebisusunku ebifuumuulibwa empewo,","poem":1},{"text":"malayika wa Mukama ng’abagoba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ekkubo lyabwe libe lya kizikiza era lijjule obuseerezi, ne malayika wa Mukama ng’abagoba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nga bwe bantega omutego nga siriiko kye mbakoze,","poem":1},{"text":"ne bansimira n’ekinnya mu kkubo lyange awatali nsonga,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"bazikirizibwe nga tebategedde,","poem":1},{"text":"n’omutego gwe banteze be baba bagugwamu,","poem":2},{"lineBreak":true},{"text":"era bagwe ne mu kinnya kiri bazikirire.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Omwoyo gwange ne gulyoka gujaguliza mu Mukama,","poem":1},{"text":"ne gusanyukira mu bulokozi bwe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Amagumba gange galyogera nti,","poem":1},{"text":"“Ani afaanana nga ggwe, Ayi Mukama?","poem":2},{"text":"Kubanga abaavu obadduukirira n’obawonya ababasinza amaanyi,","poem":1},{"text":"n’abali mu kwetaaga n’obawonya abanyazi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Abajulizi abakambwe bagolokoka","poem":1},{"text":"ne bambuuza ebintu bye sirinaako kye mmanyi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bwe mbayisa obulungi bo bampisa bubi,","poem":1},{"text":"ne banakuwaza omwoyo gwange.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"So nga bwe baalwala nanakuwala ne nnyambala ebibukutu,","poem":1},{"text":"ne neerumya nga nsiiba, ne nsaba Mukama nga nkotese omutwe,","poem":2},{"text":"naye okusaba kwange bwe kutaddibwamu,","poem":1}]},{"type":"verse","number":14,"content":[{"text":"ne mbeera mu nnaku","poem":2},{"lineBreak":true},{"text":"ng’ankungubagira ow’omukwano","poem":2},{"text":"oba owooluganda nkoteka omutwe gwange mu buyinike","poem":1},{"text":"ng’akaabira nnyina.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Naye bwe nagwa mu kabi ne beekuŋŋaanya nga basanyuse;","poem":1},{"text":"ne bannumba nga simanyi,","poem":2},{"lineBreak":true},{"text":"ne bampayiriza obutata.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Banduulidde n’ettima ng’abatamanyi Katonda bwe bakola,","poem":1},{"text":"ne bannumira obujiji.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ayi Mukama, olituusa ddi ng’otunula butunuzi?","poem":1},{"text":"Nziruukirira nga bannumba, obulamu bwange obuwonye okutaagulwataagulwa,","poem":2},{"lineBreak":true},{"text":"obulamu bwange obw’omuwendo eri empologoma zino.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nnaakwebalizanga mu lukuŋŋaana olukulu,","poem":1},{"text":"ne nkutenderezanga mu kibiina ky’abantu abangi ennyo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tokkiriza balabe bange kunneeyagalirako,","poem":1},{"text":"abankyawa awatali nsonga;","poem":2},{"text":"abankyayira obwereere","poem":1},{"text":"tobakkiriza kunziimuula.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Teboogera bya mirembe,","poem":1},{"text":"wabula okuwaayiriza abantu abeetuulidde emirembe mu nsi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Banjasamiza akamwa kaabwe ne boogera nti,","poem":1},{"text":"“Leero luno, ky’okoze tukirabye n’amaaso gaffe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Bino byonna obirabye, Ayi Mukama.","poem":1},{"text":"Noolwekyo tosirika. Tonsuulirira, Ayi Mukama.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Golokoka ojje onnyambe;","poem":1},{"text":"nnwanirira Ayi Katonda wange era Mukama wange.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mu butuukirivu bwo nnejjeereza, Ayi Mukama Katonda wange,","poem":1},{"text":"tobaganya kunneeyagalirako.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Tobaleka kulowooza nti, “Leero luno! Kino kye twali twagala!”","poem":1},{"text":"Oba nti, “Tumusaanyizzaawo!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Abo bonna abanneeyagalirako olw’ennaku yange ne beesanyusa,","poem":1},{"text":"batabulwetabulwe era baswazibwe;","poem":2},{"text":"abo bonna abanneegulumirizaako","poem":1},{"text":"baswazibwe era banyoomebwe.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Abo abasanyuka ng’annejjeereza,","poem":1},{"text":"baleekaanire waggulu olw’essanyu n’okujaganya;","poem":2},{"text":"era boogerenga nti, “Mukama agulumizibwe,","poem":1},{"text":"asanyuka omuweereza we ng’atebenkedde.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Olulimi lwange lunaayogeranga ku butuukirivu bwo,","poem":1},{"text":"era nnaakutenderezanga olunaku lwonna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}