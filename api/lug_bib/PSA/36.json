{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":36,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Nnina obubaka mu mutima gwange","poem":1},{"text":"obukwata ku bwonoonyi bw’omukozi w’ebibi.","poem":2},{"text":"N’okutya","poem":1},{"text":"tatya Katonda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ye nga bw’alaba yeewaanawaana n’atasobola kutegeera","poem":1},{"text":"oba okukyawa ekibi kye.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ebigambo ebiva mu kamwa ke biba bibi era nga bya bulimba;","poem":1},{"text":"takyalina magezi era takyakola birungi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne ku kitanda kye afumiitiriza ebibi by’anaakola;","poem":1},{"text":"amalirira okutambuliranga mu kkubo ekyamu,","poem":2},{"lineBreak":true},{"text":"era ebitali bituufu tabyewala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Okwagala kwo, Ayi Mukama, kutuuka ne ku ggulu;","poem":1},{"text":"obwesigwa bwo butuuka ku bire.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Obutuukirivu bwo bugulumivu ng’agasozi aganene,","poem":1},{"text":"n’obwenkanya bwo buwanvu nnyo ng’ennyanja ennene ennyo.","poem":2},{"text":"Ayi Mukama, olabirira abantu n’ebisolo.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Okwagala kwo okutaggwaawo nga tekugeraageranyizika.","poem":2},{"text":"Ab’ebitiibwa n’abatali ba bitiibwa","poem":1},{"text":"baddukira mu biwaawaatiro byo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Balya ku bingi eby’omu nnyumba yo ne bakkuta;","poem":1},{"text":"obawa ebyokunywa by’omugga gwo ogwesiimisa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kubanga gw’olina ensulo ey’obulamu,","poem":1},{"text":"era gw’otwakiza omusana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yongeranga okwagala abo abakutegeera,","poem":1},{"text":"era n’obutuukirivu bwo eri abo abalina emitima emirongoofu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ab’amalala baleme okunninnyirira,","poem":1},{"text":"wadde ababi okunsindiikiriza.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Laba, ababi nga bwe bagudde!","poem":1},{"text":"Basuuliddwa wansi era tebasobola na ku golokokawo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}