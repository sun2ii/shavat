{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":37,"content":[{"type":"hebrew_subtitle","content":["Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Teweeraliikiriranga olw’abantu ababi,","poem":1},{"text":"so tokwatirwanga buggya abo abakola ebitasaana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kubanga bagenda kuwotoka ng’omuddo,","poem":1},{"text":"bafiire ddala ng’essubi ekkalu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Weesigenga Mukama okolenga bulungi,","poem":1},{"text":"onoobeeranga n’emirembe mu nsi n’ofuna ebirungi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sanyukiranga mu Mukama,","poem":1},{"text":"anaakuwanga omutima gwo bye gwetaaga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"By’okola byonna byesigamyenga ku Mukama;","poem":1},{"text":"mwesigenga, anaakukoleranga ky’oyagala.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Anaayolekanga obutuukirivu bwo ng’omusana,","poem":1},{"text":"n’obwenkanya bw’ebikolwa byo ne bwakaayakana ng’enjuba ey’omu ttuntu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Siriikirira awali Mukama,","poem":1},{"text":"ogumiikirize ng’olindirira ky’anaakola.","poem":2},{"lineBreak":true},{"text":"Tofangayo ng’abalala bafunye ebirungi nga bayita mu kutetenkanya kwabwe okubi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tonyiiganga era weewale ekiruyi;","poem":1},{"text":"teweeraliikiriranga kubanga bivaamu bibi byereere.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kubanga ababi balisalibwako,","poem":1},{"text":"naye abeesiga Mukama baligabana ensi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wanaayitawo akabanga katono ababi baggweerewo ddala;","poem":1},{"text":"wadde mulibanoonya temulibalabako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Naye abateefu baligabana ensi","poem":1},{"text":"ne beeyagalira mu ddembe eritatendeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ababi basalira abatuukirivu enkwe,","poem":1},{"text":"ne babalumira obujiji.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Naye Mukama asekerera ababi,","poem":1},{"text":"kubanga amanyi ng’entuuko zaabwe ziri kumpi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ababi basowoddeyo ebitala byabwe","poem":1},{"text":"ne baleega emitego gy’obusaale,","poem":2},{"text":"batte abaavu n’abali mu kwetaaga","poem":1},{"text":"era basaanyeewo abo abatambulira mu kkubo eggolokofu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Naye ebitala byabwe birifumita mitima gyabwe gyennyini,","poem":1},{"text":"n’emitego gyabwe egy’obusaale girimenyebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ebitono omutuukirivu by’alina","poem":1},{"text":"bisinga obugagga bw’ababi abangi;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"kubanga amaanyi g’abakola ebibi galikoma,","poem":1},{"text":"naye Mukama anaawaniriranga abatuukirivu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ennaku z’abataliiko kya kunenyezebwa, zimanyibwa Mukama,","poem":1},{"text":"era omugabo gwabwe gunaabanga gwa lubeerera.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mu biseera eby’akabi ebyakatyabaga tebaayongoberenga,","poem":1},{"text":"ne mu biro eby’enjala banakkusibwanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Naye ababi balizikirira;","poem":1},{"text":"abalabe ba Mukama balifaanana ng’obulungi bwe ttale,","poem":2},{"lineBreak":true},{"text":"era baliggwaawo, baliggwaawo ng’omukka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ababi beewola, ne batasasula;","poem":1},{"text":"naye abatuukirivu basaasira era bagaba bingi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Abo Mukama b’awa omukisa baligabana ensi,","poem":1},{"text":"naye abo b’akolimira balizikirizibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Mukama bw’asanyukira ekkubo ly’omuntu,","poem":1},{"text":"aluŋŋamya entambula ye.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ne bw’aneesittalanga, taagwenga wansi,","poem":1},{"text":"kubanga omukono gwa Mukama gumuwanirira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Nnali muto kati nkaddiye,","poem":1},{"text":"naye sirabanga batuukirivu nga balekeddwa ttayo,","poem":2},{"lineBreak":true},{"text":"wadde abaana baabwe nga basabiriza ekyokulya.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bagaba bingi bulijjo, era baazika ku byabwe n’essanyu.","poem":1},{"text":"Abaana baabwe banaaweebwanga omukisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Muve mu bibi, mukolenga ebirungi,","poem":1},{"text":"munaabanga balamu emirembe gyonna.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kubanga Mukama ayagala ab’amazima,","poem":1},{"text":"n’abeesigwa be taabaabulirenga.","poem":2},{"text":"Banaalabirirwanga emirembe gyonna;","poem":1},{"text":"naye ezzadde ly’ababi lirizikirizibwa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Abatuukirivu baligabana ensi","poem":1},{"text":"ne babeeranga omwo emirembe gyonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Akamwa k’omutuukirivu koogera bya magezi,","poem":1},{"text":"n’olulimi lwe lwogera bya mazima.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Amateeka ga Katonda we gali mu mutima gwe,","poem":1},{"text":"era ebigere bye tebiseerera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Omubi ateega omutuukirivu","poem":1},{"text":"ng’anoonya okumutta,","poem":2}]},{"type":"verse","number":33,"content":[{"text":"naye Mukama taliganya babi kuwangula,","poem":1},{"text":"wadde okukkiriza abatuukirivu okusingibwa omusango.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Lindirira Mukama n’okugumiikiriza,","poem":1},{"text":"otambulirenga mu makubo ge;","poem":2},{"text":"naye alikugulumiza n’akuwa ensi;","poem":1},{"text":"ababi bwe balisalirwako olikitegeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Nalaba omuntu omubi era omukambwe ennyo, naye nga buli ky’akola kimugendera bulungi,","poem":1},{"text":"ng’agimuse ng’omuti ogukulidde mu ttaka eggimu,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"naye teyalwawo n’abula,","poem":1},{"text":"ne mmumagamaga buli wantu, nga talabikako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Tunuulira omuntu ataliiko kya kunenyezebwa, wekkaanye oyo omulongoofu;","poem":1},{"text":"obulamu bwe bunajjulanga emirembe.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Naye aboonoonyi bonna balizikirizibwa;","poem":1},{"text":"ezzadde ly’ababi lirisaanyizibwawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Obulokozi bw’abatuukirivu buva eri Mukama;","poem":1},{"text":"ye ky’ekigo kyabwe ekinywevu gye baddukira mu kiseera eky’emitawaana.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Mukama abayamba n’abalokola;","poem":1},{"text":"abaggya mu mikono gy’ababi n’abalokola,","poem":2},{"lineBreak":true},{"text":"kubanga gy’ali gye baddukira.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}