{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":38,"content":[{"type":"hebrew_subtitle","content":["Zabbuli ya Dawudi, ey’okujjukiza."]},{"type":"verse","number":1,"content":[{"text":"Ayi Mukama tonnenya ng’okyaliko obusungu,","poem":1},{"text":"oba okunkangavvula ng’oliko ekiruyi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kubanga obusaale bwo bunfumise,","poem":1},{"text":"n’omuggo gwo gunkubye nnyo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Obusungu bwo bundwazizza nzenna,","poem":1},{"text":"n’amagumba gange gonna gansagala olw’ebyonoono byange.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Omusango gwe nzizizza guyitiridde,","poem":1},{"text":"gunzitoowerera ng’omugugu omunene oguteetikkika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ebiwundu byange bitanye era biwunya,","poem":1},{"text":"olw’okwonoona kwange okw’obusirusiru.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nkootakoota era mpweddemu ensa,","poem":1},{"text":"ŋŋenda nsinda obudde okuziba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Omugongo gunnuma nnyo,","poem":1},{"text":"ne mu mubiri gwange temukyali bulamu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sikyalimu maanyi era nzenna mmenyesemenyese;","poem":1},{"text":"nsinda buli bbanga olw’obulumi mu mutima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mukama, bye neetaaga byonna obimanyi,","poem":1},{"text":"n’okusinda kwange okuwulira.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Omutima gumpejjawejja, amaanyi gampweddemu;","poem":1},{"text":"n’okulaba sikyalaba.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mikwano gyange ne be nayitanga nabo banneewala olw’amabwa gange;","poem":1},{"text":"ne bannange tebakyansemberera.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abaagala okunzita bantega emitego,","poem":1},{"text":"n’abo abangigganya bateesa okummalawo.","poem":2},{"lineBreak":true},{"text":"Buli bbanga baba bateesa kunkola kabi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ndi ng’omuggavu w’amatu, atawulira;","poem":1},{"text":"nga kiggala, atayogera.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nfuuse ng’omuntu atalina ky’awulira,","poem":1},{"text":"atasobola kwanukula.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ddala ddala nnindirira ggwe, Ayi Mukama,","poem":1},{"text":"onnyanukule, Ayi Mukama Katonda wange.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tobakkiriza kunneeyagalirako,","poem":1},{"text":"oba okunneegulumirizaako ng’ekigere kyange kiseeredde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kubanga nsemberedde okugwa,","poem":1},{"text":"era nga nnumwa buli kiseera.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ddala ddala njatula ebyonoono byange;","poem":1},{"text":"nnumirizibwa ekibi kyange.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Abalabe bange bangi era ba maanyi;","poem":1},{"text":"n’abo abankyayira obwereere bangi nnyo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Abalabe bange bankyawa olw’okuba omulongoofu,","poem":1},{"text":"era bwe nkola ebirungi banjogerako ebitasaana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ayi Mukama, tonjabulira;","poem":1},{"text":"tobeera wala nange, Ayi Katonda wange.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ayi Mukama Omulokozi wange,","poem":1},{"text":"yanguwa okumbeera.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}