{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":39,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi: Ya Yedusuni. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Nagamba nti, “Nneekuumanga mu bye nkola,","poem":1},{"text":"n’olulimi lwange lulemenga okwogera ebitali birongoofu.","poem":2},{"text":"Abakola ebitali bya butuukirivu bwe banaabanga awamu nange","poem":1},{"text":"nnaabuniranga bubunizi ne soogera.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Naye bwe nasirika","poem":1},{"text":"ne sibaako kye njogedde wadde ekirungi,","poem":2},{"lineBreak":true},{"text":"ate obuyinike bwange ne bweyongera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Omutima gwange ne gumbabuukirira munda yange.","poem":1},{"text":"Bwe nnali nkyakifumiitirizaako, omuliro ne gukoleera munda yange;","poem":2},{"lineBreak":true},{"text":"kyenava njogera nti:","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ayi Mukama, ntegeeza entuuko zange nga bwe ziriba,","poem":1},{"text":"n’ennaku ze nsigazza;","poem":2},{"lineBreak":true},{"text":"ommanyise ebiseera byange mu bulamu buno bwe biri ebimpi ennyo.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ennaku z’obulamu bwange wazitegeka ziri ng’oluta.","poem":1},{"text":"Obungi bw’emyaka gyange tobulabamu kantu.","poem":2},{"lineBreak":true},{"text":"Buli muntu, mukka bukka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ddala ddala omuntu ku nsi ali ng’ekisiikirize.","poem":1},{"text":"Atawaana mu kino ne mu kiri, naye byonna butaliimu.","poem":2},{"lineBreak":true},{"text":"Akuŋŋaanya obugagga, so nga tamanyi agenda kubutwala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Naye kaakano, Ayi Mukama, nnoonya ki? Essuubi lyange liri mu ggwe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ondokole mu bibi byange byonna,","poem":1},{"text":"abasirusiru baleme okunsekerera.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nasirika busirisi, saayasamya kamwa kange;","poem":1},{"text":"kubanga kino ggwe wakikola.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Olekere awo okunkuba,","poem":1},{"text":"emiggo gy’onkubye giyitiridde!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Onenya omuntu ng’omukangavvula olw’ekibi kye ky’akola,","poem":1},{"text":"omumaliramu ddala ensa, ng’ennyenje bw’ekola olugoye.","poem":2},{"lineBreak":true},{"text":"Ddala omuntu mukka bukka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ayi Mukama, wulira okusaba kwange,","poem":1},{"text":"owulire okukaaba kwange onnyambe.","poem":2},{"lineBreak":true},{"text":"Tonsiriikirira nga nkukaabirira.","poem":2},{"text":"Kubanga ndi mugenyi bugenyi, omutambuze,","poem":1},{"text":"nga bajjajjange bonna bwe baali.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndeka nsanyukemu, nga sinnava mu nsi muno,","poem":1},{"text":"ne mbulirawo ddala.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}