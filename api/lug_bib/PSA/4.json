{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"hebrew_subtitle","content":["Ya mukulu wa Bayimbi. Eyimbibwa n’ebivuga eby’enkoba. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Bwe nkukoowoola onnyanukule,","poem":1},{"text":"Ayi Katonda wange omutuukirivu.","poem":2},{"text":"Bwe mba mu nnaku, onnyambe.","poem":1},{"text":"Onkwatirwe ekisa owulire okusaba kwange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mmwe abaana b’abantu, mulituusa wa okuswazanga ekitiibwa kyange?","poem":1},{"text":"Mulituusa ddi okugoberera okwagala ebitaliimu, n’okunoonya eby’obulimba?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Naye mutegeere nga Mukama yeerondeddemu abo abamugondera.","poem":1},{"text":"Bwe nnaamukoowoolanga anampuliranga era anannyanukulanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ne bwe munyiiga ennyo, temusaana kwonoona; musiriikirire,","poem":1},{"text":"mwekebere era mufumiitirize mu mitima gyammwe nga mugalamidde ku bitanda byammwe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Muweeyo ebiweebwayo ebisaanidde;","poem":1},{"text":"era mwesigenga Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Waliwo bangi abasaba nti, “Oyongere okutulaga ebirungi, Ayi Mukama,","poem":1},{"text":"otumulisize omusana gw’amaaso go.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ondeetedde essanyu lingi mu mutima gwange","poem":1},{"text":"erisinga ne lye bafuna mu makungula nga batunuulira ku bibala byabwe ebingi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nnaagalamira ne nneebaka mirembe;","poem":1},{"text":"kubanga ggwe wekka, Ayi Mukama,","poem":2},{"lineBreak":true},{"text":"ggwe ondabirira akabi ne katantuukako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}