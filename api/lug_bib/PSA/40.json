{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":40,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Nalindirira Mukama n’obugumiikiriza,","poem":1},{"text":"n’antegera okutu, n’awulira okukoowoola kwange,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"n’anziggya mu kinnya eky’entiisa,","poem":1},{"text":"n’annyinyulula mu bitosi,","poem":2},{"text":"n’anteeka ku lwazi olugumu","poem":1},{"text":"kwe nyimiridde.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Anjigirizza oluyimba oluggya,","poem":1},{"text":"oluyimba olw’okutenderezanga Katonda waffe.","poem":2},{"text":"Bangi bino balibiraba ne batandika okutya Mukama","poem":1},{"text":"n’okumwesiganga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Balina omukisa","poem":1},{"text":"abo abeesiga Mukama,","poem":2},{"text":"abatagoberera ba malala","poem":1},{"text":"abasinza bakatonda ab’obulimba.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ayi Mukama Katonda wange,","poem":1},{"text":"otukoledde eby’ewunyisa bingi.","poem":2},{"text":"Ebintu by’otuteekeddeteekedde","poem":1},{"text":"tewali ayinza kubikutegeeza.","poem":2},{"text":"Singa ngezaako okubittottola,","poem":1},{"text":"sisobola kubimalayo byonna olw’obungi bwabyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ssaddaaka n’ebiweebwayo tewabyagala.","poem":1},{"text":"Ebiweebwayo ebyokebwa olw’okutangirira ebibi,","poem":2},{"text":"tobyetaaga.","poem":1},{"text":"Naye onzigudde amatu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kyenava njogera nti, “Nzuuno,","poem":1},{"text":"nzize nga bwe kyampandiikibwako mu muzingo gw’ekitabo.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nsanyukira okukola ky’oyagala, Ayi Katonda wange,","poem":1},{"text":"kubanga amateeka go gali mu mutima gwange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ntegeeza obutuukirivu mu lukuŋŋaana olunene.","poem":1},{"text":"Sisirika busirisi,","poem":2},{"lineBreak":true},{"text":"nga naawe bw’omanyi, Ayi Mukama.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bye mmanyi ku butuukirivu bwo sisirika nabyo mu mutima gwange,","poem":1},{"text":"naye ntegeeza ku bwesigwa bwo n’obulokozi bwo.","poem":2},{"text":"Abantu nga bakuŋŋaanye,","poem":1},{"text":"sirema kubategeeza ku mazima go n’okwagala kwo okungi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Onsasirenga bulijjo, Ayi Mukama,","poem":1},{"text":"amazima n’okwagala kwo byeyongerenga okunkuuma.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kubanga ebizibu bye siyinza na kubala binneetoolodde;","poem":1},{"text":"ebibi byange binsukiridde, sikyasobola na kulaba;","poem":2},{"text":"bisinga enviiri ez’oku mutwe gwange obungi,","poem":1},{"text":"mpweddemu amaanyi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Onsasire ayi Mukama ondokole;","poem":1},{"text":"Ayi Mukama, oyanguwe okumbeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Abo abaagala okunzita batabuketabuke baswale;","poem":1},{"text":"n’abo bonna abagenderera okummalawo bagobebwe nga baswadde.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Abo abankubira akasonso baswazibwe nnyo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Naye abo abakunoonya basanyuke","poem":1},{"text":"era bajaguze;","poem":2},{"text":"abo abaagala obulokozi bwo boogerenga bulijjo nti,","poem":1},{"text":"“Mukama agulumizibwenga.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ndi mwavu, eyeetaaga ennyo.","poem":1},{"text":"Mukama ondowoozeeko.","poem":2},{"text":"Tolwawo, Ayi Katonda wange.","poem":1},{"text":"Ggwe mubeezi wange era Omulokozi wange.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}