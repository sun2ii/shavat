{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":41,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Alina omukisa asaasira omunaku;","poem":1},{"text":"Mukama amulokola ku lunaku olw’akabi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mukama anaamukuumanga anaawonyanga obulamu bwe,","poem":1},{"text":"era anaamuwanga omukisa mu nsi;","poem":2},{"lineBreak":true},{"text":"n’atamuwaayo eri okwegomba kw’abalabe be.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mukama anaamujjanjabanga nga mulwadde;","poem":1},{"text":"n’amuwonya mu bulumi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nayogera nti, “Ayi Mukama onsaasire omponye; kubanga nnyonoonye mu maaso go.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Abalabe bange boogeza obukyayi nti,","poem":1},{"text":"“Alifa ddi n’okwerabirwa ne yeerabirwa?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bwe bajja okundaba beefuula mikwano gyange;","poem":1},{"text":"naye munda yaabwe bankyawa era basanyuka okulaba nga ngalamidde awo nnumwa.","poem":2},{"lineBreak":true},{"text":"Bwe bansiibula bagenda beesekera nga bwe baduula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Abalabe bange bonna abo bateesa mu kaama;","poem":1},{"text":"nga banjogerako ebitali birungi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Boogera nti, “Endwadde emukutte mbi nnyo,","poem":1},{"text":"emukubye wansi tayinza kuwona.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Era ne mukwano gwange gwe neesiganga","poem":1},{"text":"bwe twalyanga,","poem":2},{"lineBreak":true},{"text":"anneefuukidde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Naye ggwe, Ayi Mukama, onsaasire,","poem":1},{"text":"onzizeemu amaanyi ndyoke nneesasuze.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mmanyi ng’onsanyukira,","poem":1},{"text":"kubanga omulabe wange tampangudde.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Onnywezezza mu bwesimbu bwange,","poem":1},{"text":"ne mbeera mu maaso go ennaku zonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Atenderezebwenga Mukama Katonda wa Isirayiri,","poem":1},{"text":"oyo eyabaawo okuva edda n’edda lyonna n’okutuusa emirembe gyonna.","poem":2},"Amiina era Amiina."]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}