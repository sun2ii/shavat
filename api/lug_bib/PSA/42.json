{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":42,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi: Zabbuli ya Batabani ba Koola."]},{"type":"verse","number":1,"content":[{"text":"Ng’empeewo bw’ewejjawejja olw’amazzi,","poem":1},{"text":"n’emmeeme yange bw’etyo bwe wejjawejja ku lulwo, Ayi Katonda.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Emmeeme yange eyaayaanira Katonda, Katonda omulamu.","poem":1},{"text":"Ndigenda ddi ne nsisinkana Katonda?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nkaabirira Mukama","poem":1},{"text":"emisana n’ekiro.","poem":2},{"text":"Amaziga gange gabadde emmere yange emisana n’ekiro,","poem":1},{"text":"abantu ne baŋŋamba nti, “Katonda wo ali ludda wa?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bino mbijjukira nga nfuka emmeeme yange","poem":1},{"text":"nga bwe nagendanga n’ekibiina ekinene,","poem":2},{"text":"ne nkulembera ennyiriri z’abantu empanvu,","poem":1},{"text":"nga tugenda mu nnyumba ya Katonda,","poem":2},{"text":"nga tuyimba mu ddoboozi ery’omwanguka","poem":1},{"text":"n’okwebaza mu kibiina ekijaguza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lwaki oweddemu amaanyi ggwe emmeeme yange?","poem":1},{"text":"Lwaki otabusetabuse mu nda yange?","poem":2},{"text":"Essuubi lyo liteeke mu Katonda,","poem":1},{"text":"kubanga natenderezanga omulokozi wange era Katonda wange;","poem":2},{"lineBreak":true},{"text":"ye mubeezi wange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ayi Katonda wange, emmeeme yange yennyise,","poem":1},{"text":"yeeraliikiridde;","poem":2},{"text":"naye nkujjukira olw’ebyo bye wakola mu nsi ya Yoludaani","poem":1},{"text":"ne ku nsozi engulumivu eza Kalumooni","poem":2},{"noteId":7},{"text":"ne ku Lusozi Mizali.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Obuziba bukoowoola obuziba,","poem":1},{"text":"olw’okuwuluguma kw’ebiyiriro","poem":2},{"text":"amayengo n’amasingisira go","poem":1},{"text":"bimpiseeko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mukama alaga okwagala kwe emisana n’ekiro","poem":1},{"text":"ne muyimbira oluyimba lwe;","poem":2},{"lineBreak":true},{"text":"y’essaala eri Katonda w’obulamu bwange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ŋŋamba Katonda, olwazi lwange nti,","poem":1},{"text":"“Lwaki onneerabidde?","poem":2},{"text":"Lwaki ŋŋenda nkungubaga","poem":1},{"text":"olw’okujoogebwa abalabe bange?”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mbonyaabonyezebwa ng’abalabe bange","poem":1},{"text":"bancocca,","poem":2},{"text":"nga bwe bagamba buli kiseera nti,","poem":1},{"text":"“Katonda wo ali ludda wa?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Lwaki wennyise Ayi ggwe emmeeme yange?","poem":1},{"text":"Lwaki otabusetabuse mu nda yange?","poem":2},{"text":"Weesigenga Katonda,","poem":1},{"text":"kubanga nnaamutenderezanga,","poem":2},{"lineBreak":true},{"text":"Omulokozi wange era ye Katonda wange.","poem":2}]}],"footnotes":[{"noteId":7,"caller":"+","text":"Kalumooni ye yali ensalo ey’omu bukiikakkono ey’ensi ensuubize","reference":{"chapter":42,"verse":6}}]},"thisChapterLink":"/api/lug_bib/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}