{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Ayi Katonda, onnejjeereze","poem":1},{"text":"omponye eggwanga eritatya Katonda","poem":2},{"lineBreak":true},{"text":"ondokole mu mikono gy’abantu abalimba, abakola ebibi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ddala ddala ggwe Katonda, ekigo kyange eky’amaanyi.","poem":1},{"text":"Lwaki ondese?","poem":2},{"text":"Lwaki ŋŋenda nkaaba","poem":1},{"text":"nga nnyigirizibwa omulabe?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kale tuma omusana gwo n’amazima","poem":1},{"text":"binnuŋŋamye;","poem":2},{"text":"bindeete ku lusozi lwo olutukuvu,","poem":1},{"text":"mu kifo mw’obeera.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne ndyoka ndaga ku kyoto kya Katonda,","poem":1},{"text":"eri Katonda wange era essanyu lyange eritasingika.","poem":2},{"text":"Weewaawo nnaakutenderezanga n’ennanga,","poem":1},{"text":"Ayi Katonda, Katonda wange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lwaki wennyise ggwe emmeeme yange?","poem":1},{"text":"Lwaki otabusetabuse munda yange?","poem":2},{"text":"Weesige Katonda; kubanga nnaamutenderezanga,","poem":1},{"text":"Omulokozi wange era Katonda wange.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}