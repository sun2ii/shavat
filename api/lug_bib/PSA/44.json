{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":44,"content":[{"type":"hebrew_subtitle","content":["Ya mukulu wa bayimbi. Zabbuli ya Batabani ba Koola."]},{"type":"verse","number":1,"content":[{"text":"Ayi Katonda, twawulira n’amatu gaffe,","poem":1},{"text":"bajjajjaffe baatubuulira,","poem":2},{"text":"ebyo bye wakola mu biro byabwe,","poem":1},{"text":"mu nnaku ez’edda ezaayita.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nga bwe wagoba amawanga mu nsi","poem":1},{"text":"n’ogiwa bajjajjaffe,","poem":2},{"text":"wasaanyaawo amawanga","poem":1},{"text":"n’okulaakulanya bajjajjaffe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ekitala kyabwe si kye kyabaleetera okuwangula ensi,","poem":1},{"text":"n’omukono gwabwe si gwe gwabalokola;","poem":2},{"text":"wabula baawangula n’omukono gwo ogwa ddyo","poem":1},{"text":"awamu n’obulungi bwo, kubanga wabaagala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ggwe oli Kabaka wange, era Katonda wange;","poem":1},{"text":"awa Yakobo obuwanguzi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ku lulwo tunaawangulanga abalabe baffe;","poem":1},{"text":"ku lw’erinnya lyo tunaalinnyiriranga abalabe baffe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ddala ddala omutego gwange ogw’obusaale si gwe neesiga,","poem":1},{"text":"n’ekitala kyange si kye kimpa obuwanguzi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wabula ggwe otulokola mu balabe baffe,","poem":1},{"text":"n’oswaza abo abatuyigganya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Twenyumiririza mu Katonda olunaku lwonna.","poem":1},{"text":"Era tunaatenderezanga erinnya lyo emirembe gyonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Naye kaakano otusudde ne tuswala;","poem":1},{"text":"era tokyatabaala na magye gaffe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Watuzza emabega okuva mu bifo mwe twali ng’abalabe baffe balaba,","poem":1},{"text":"abatuyigganya ne batunyaga.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Watuwaayo okuliibwa ng’endiga;","poem":1},{"text":"n’otusaasaanya mu mawanga.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Watunda abantu bo omuwendo mutono nnyo,","poem":1},{"text":"n’otobaako ky’oganyulwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Watufuula ekivume eri baliraanwa baffe,","poem":1},{"text":"ekinyoomebwa era ekisekererwa abo abatwetoolodde.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Otufudde ekinyoomebwa mu mawanga gonna;","poem":1},{"text":"era abantu banyeenya emitwe gyabwe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nswazibwa obudde okuziba,","poem":1},{"text":"amaaso gange ne gajjula ensonyi,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"olw’abo abangigganya, abanvuma nga tebandabamu ka buntu,","poem":1},{"text":"olw’omulabe amaliridde okuwoolera eggwanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ebyo byonna bitutuseeko,","poem":1},{"text":"newaakubadde nga tetukwerabidde,","poem":2},{"lineBreak":true},{"text":"wadde obutagondera ndagaano yo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Omutima gwaffe tegukuvuddeeko,","poem":1},{"text":"so tetugaanyi kutambulira mu kkubo lyo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Naye ggwe otubonerezza n’otulekera emisege,","poem":1},{"text":"n’otuleka mu kizikiza ekikutte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ddala singa twerabira erinnya lya Katonda waffe,","poem":1},{"text":"ne tusinza katonda omulala,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ekyo Katonda waffe teyandikizudde?","poem":1},{"text":"Kubanga ye amanyi n’ebikisibwa mu mutima.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Katonda waffe, tetukuvuddeeko, kubanga ku lulwo tuttibwa obudde okuziba,","poem":1},{"text":"era tuli ng’endiga ez’okusalibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Golokoka Ayi Mukama, lwaki weebase?","poem":1},{"text":"Zuukuka! Totusuula Ayi Mukama!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Lwaki otwekwese?","poem":1},{"text":"Lwaki tofaayo ku kulumwa kwaffe n’okujoogebwa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ddala ddala tusuuliddwa mu nfuufu;","poem":1},{"text":"tuli ku ttaka.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Golokoka otuyambe;","poem":1},{"text":"tulokole olw’okwagala kwo okutaggwaawo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}