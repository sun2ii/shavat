{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":45,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Oluyimba “olw’Amalanga.” Zabbuli ya Batabani ba Koola."]},{"type":"verse","number":1,"content":[{"text":"Omutima gwange gujjudde ebigambo ebirungi","poem":1},{"text":"nga nnyimba oluyimba lwa Kabaka.","poem":2},{"lineBreak":true},{"text":"Olulimi lwange kkalaamu y’omuwandiisi omukugu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ggw’osinga abaana b’abantu obulungi;","poem":1},{"text":"n’akamwa ko nga kafukiddwako amafuta ag’ekisa.","poem":2},{"lineBreak":true},{"text":"Kubanga Katonda akuwadde omukisa emirembe gyonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Weesibe ekitala kyo, Ayi ggwe ow’amaanyi,","poem":1},{"text":"yambala ekitiibwa kyo n’obukulu bwo!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Weebagale embalaasi yo mu kitiibwa kyo eky’obuwanguzi,","poem":1},{"text":"ng’olwanirira amazima, obuwombeefu, n’obutuukirivu.","poem":2},{"lineBreak":true},{"text":"Omukono gwo ogwa ddyo gukole ebyewuunyisa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Obusaale bwo obwogi bufumite emitima gy’abalabe ba kabaka;","poem":1},{"text":"afuge amawanga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Entebe yo ey’obwakabaka, Ayi Katonda, ya lubeerera;","poem":1},{"text":"n’omuggo ogw’obwenkanya gwe guliba ogw’obwakabaka bwo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Oyagala obutuukirivu n’okyawa okukola ebibi;","poem":1},{"text":"noolwekyo Katonda, Katonda wo, kyavudde akugulumiza","poem":2},{"lineBreak":true},{"text":"n’akufukako amafuta ag’essanyu okusinga bakabaka banno bonna.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ebyambalo byo birina akawoowo ka mmooli ne alowe, ne kasiya.","poem":1},{"text":"Ebivuga eby’enkoba bikusanyusiza","poem":2},{"lineBreak":true},{"text":"mu mbiri zo ez’amasanga.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mu bakyala bo mulimu abambejja;","poem":1},{"text":"namasole ali ku mukono gwo ogwa ddyo ng’ayambadde ebya zaabu ya Ofiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Muwala, wuliriza bye nkugamba:","poem":1},{"text":"“Weerabire ab’ewammwe n’ab’omu nnyumba ya kitaawo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kabaka akulowoozaako nnyo, kubanga walungiwa n’oyitirira;","poem":1},{"text":"nga bw’ali mukama wo, muwenga ekitiibwa.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Muwala w’e Ttuulo","poem":1},{"noteId":8},{"text":"alijja n’ekirabo,","poem":1},{"text":"abasajja abagagga balikwegayirira obalage ekisa kyo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Omuwala wa kabaka ajjudde ekitiibwa mu kisenge kye,","poem":1},{"text":"ng’ayambadde ekyambalo ekyalukibwa ne zaabu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Aleetebwa mu maaso ga kabaka ng’ayambadde ebyambalo eby’emidalizo emingi.","poem":1},{"text":"Emperekeze ze zimuwerekerako;","poem":2},{"lineBreak":true},{"text":"bonna ne bajja gy’oli.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Baleetebwa nga bajjudde essanyu n’okweyagala,","poem":1},{"text":"ne bayingira mu lubiri lwa kabaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Batabani bo baliweebwa ebifo bya bajjajjaabwe,","poem":1},{"text":"olibafuula ng’abalangira mu nsi omwo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Erinnya lyo linajjukirwanga emirembe gyonna.","poem":1},{"text":"Amawanga kyeganaavanga gakutendereza emirembe n’emirembe.","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"Kabaka w’e Tuulo ye kabaka eyasooka okukkiriza enju ya Dawudi okulya entebe ey’obwakabaka bwa Isirayiri. Sulemaani yasigaza omukwano ogwo ne kabaka w’e Tuulo, era Tuulo kyali kibuga ky’aby’amaguzi kikulu ku Nnyanja Ennene eya Meditereniyaani.","reference":{"chapter":45,"verse":12}}]},"thisChapterLink":"/api/lug_bib/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}