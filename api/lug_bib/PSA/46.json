{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi: Zabbuli ya Batabani ba Koola."]},{"type":"verse","number":1,"content":[{"text":"Katonda kye kiddukiro kyaffe, era ge maanyi gaffe;","poem":1},{"text":"omubeezi ddala atabulawo mu kulaba ennaku.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kyetunaavanga tulema okutya, ensi ne bw’eneeyuuguumanga,","poem":1},{"text":"ensozi ne bwe zinaasiguulukukanga ne zigwa mu buziba bw’ennyanja;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"amazzi g’ennyanja ne bwe ganaayiranga ne gabimba ejjovu","poem":1},{"text":"ensozi ne zikankana olw’okwetabula kwago.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Waliwo omugga, emyala gyagwo gisanyusa ekibuga kya Katonda,","poem":1},{"text":"kye kifo ekitukuvu ekya Katonda Ali Waggulu Ennyo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tekirigwa kubanga Katonda mw’abeera.","poem":1},{"text":"Katonda anaakirwaniriranga ng’obudde bunaatera okukya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amawanga geetabula, obwakabaka bugwa;","poem":1},{"text":"ayimusa eddoboozi lye ensi n’esaanuuka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mukama ow’Eggye ali naffe,","poem":1},{"text":"Katonda wa Yakobo kye kigo kyaffe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mujje, mulabe Mukama by’akola,","poem":1},{"text":"mulabe nga bw’afaafaaganya ensi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Y’akomya entalo mu nsi yonna;","poem":1},{"text":"akutula emitego gy’obusaale, effumu alimenyaamenya;","poem":2},{"lineBreak":true},{"text":"amagaali n’engabo abyokya omuliro.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Musiriikirire mutegeere nga nze Katonda.","poem":1},{"text":"Nnaagulumizibwanga mu mawanga.","poem":2},{"lineBreak":true},{"text":"Nnaagulumizibwanga mu nsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Katonda ow’Eggye ali naffe;","poem":1},{"text":"Katonda wa Yakobo kye kigo kyaffe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}