se","number":6,"content":[{"text":"Mutendereze Katonda, mumutendereze.","poem":1},{"text":"Mumutendereze Kabaka waffe, mumutendereze.","poem":2},{"noteId":9}]},{"type":"verse","number":7,"content":[{"text":"Kubanga Katonda ye Kabaka w’ensi yonna,","poem":1},{"text":"mumutendereze ne Zabbuli ey’ettendo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Katonda afuga amawanga gonna;","poem":1},{"text":"afuga amawanga ng’atudde ku ntebe ye entukuvu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abakungu bannaggwanga bakuŋŋanye","poem":1},{"text":"ng’abantu ba Katonda wa Ibulayimu;","poem":2},{"text":"kubanga Katonda y’afuga abakulembeze b’ensi.","poem":1},{"text":"Katonda agulumizibwenga nnyo.","poem":2}]}],"footnotes":[{"noteId":9,"caller":"+","text":"Okutenderezebwa kwakolebwanga ne Siyofa, ejjembe eryafuuyibwanga okulangirira Omwaka Omuggya","reference":{"chapter":47,"verse":6}}]},"thisChapterLink":"/api/lug_bib/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}