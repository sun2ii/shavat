{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"hebrew_subtitle","content":["Oluyimba. Zabbuli ya Batabani ba Koola."]},{"type":"verse","number":1,"content":[{"text":"Mukama mukulu, asaanira okutenderezebwa ennyo","poem":1},{"text":"mu kibuga kya Katonda waffe, ku lusozi lwe olutukuvu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sayuuni lwe lusozi lwe olulungi olugulumivu,","poem":1},{"text":"olusanyusa ensi yonna.","poem":2},{"text":"Ku ntikko Zafoni kwe kuli","poem":1},{"text":"ekibuga kya Kabaka Omukulu;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Katonda mw’abeera;","poem":1},{"text":"yeeraze okuba ekigo kye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kale laba, bakabaka b’ensi baakuŋŋaana","poem":1},{"text":"ne bakyolekera bakirumbe;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"bwe baakituukako ne bakyewuunya,","poem":1},{"text":"ne batya nnyo ne badduka;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"nga bakankana,","poem":1},{"text":"ne bajjula obulumi ng’omukazi alumwa okuzaala.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wabazikiriza ng’omuyaga ogw’ebuvanjuba","poem":1},{"text":"bwe guzikiriza ebyombo by’e Talusiisi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ebyo bye twawuliranga obuwulizi,","poem":1},{"text":"kaakano tubirabye","poem":2},{"text":"mu kibuga kya Mukama ow’Eggye,","poem":1},{"text":"mu kibuga kya Katonda waffe,","poem":2},{"lineBreak":true},{"text":"kyalinywereza ddala emirembe gyonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ayi Katonda, tufumiitiriza ku kwagala kwo okutaggwaawo","poem":1},{"text":"nga tuli mu Yeekaalu yo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Erinnya lyo nga bwe liri ekkulu, Ayi Katonda,","poem":1},{"text":"bw’otyo bw’otenderezebwa mu nsi yonna.","poem":2},{"lineBreak":true},{"text":"Omukono gwo ogwa ddyo gujjudde obuwanguzi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sanyuka gwe Sayuuni,","poem":1},{"text":"musanyuke mmwe ebibuga bya Yuda;","poem":2},{"lineBreak":true},{"text":"kubanga Katonda alamula bya nsonga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mutambule mu Sayuuni, mukibune;","poem":1},{"text":"mubale n’ebigo byakyo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mwekalirize nnyo munda wa bbugwe waakyo","poem":1},{"text":"n’olusiisira lw’amaggye lwamu lwonna;","poem":2},{"lineBreak":true},{"text":"mulyoke mutegeeze ab’emirembe egiriddawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kubanga Katonda ono, ye Katonda waffe emirembe gyonna;","poem":1},{"text":"y’anaatuluŋŋamyanga ennaku zonna okutuusa okufa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}