{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":49,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Batabani ba Koola."]},{"type":"verse","number":1,"content":[{"text":"Muwulire mmwe amawanga gonna,","poem":1},{"text":"mutege amatu mmwe mwenna abali mu nsi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ab’ekitiibwa n’abakopi, abagagga n’abaavu, mwenna;","poem":1},{"text":"muwulirize ebigambo byange.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kubanga ebigambo by’omu kamwa kange bya magezi,","poem":1},{"text":"ebiva mu mutima gwange bijjudde okutegeera.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nnaakozesanga ebikwata ku ngero,","poem":1},{"text":"nga nnyinnyonnyola amakulu gaazo n’oluyimba ku nnanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Siityenga ne bwe nnaabanga mu buzibu;","poem":1},{"text":"newaakubadde ng’abalabe bange banneetoolodde,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"abantu abeesiga obugagga bwabwe","poem":1},{"text":"beenyumiririza mu bintu ebingi bye balina.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ddala ddala, tewali muntu ayinza kununula bulamu bwa munne,","poem":1},{"text":"wadde okwegula okuva eri Katonda.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kubanga omuwendo ogununula obulamu munene nnyo,","poem":1},{"text":"tewali n’omu agusobola;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"alyoke awangaale ennaku zonna","poem":1},{"text":"nga tatuuse magombe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kubanga n’abantu abagezi bafa;","poem":1},{"text":"abasirusiru n’abatalina magezi bonna baaggwaawo,","poem":2},{"lineBreak":true},{"text":"obugagga bwabwe ne babulekera abalala.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Entaana zaabwe ge ganaabanga amaka gaabwe ennaku zonna;","poem":1},{"text":"nga bye bisulo ebya buli mulembe oguliddawo;","poem":2},{"lineBreak":true},{"text":"baafuna ettaka mu mannya gaabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Omuntu tabeerera mirembe gyonna, ne bw’aba mugagga atya,","poem":1},{"text":"alifa ng’ensolo bwe zifa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ako ke kabi akatuuka ku beesiga ebitaliimu,","poem":1},{"text":"era ye nkomerero y’abo abeesiga obugagga bwabwe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Okufaanana ng’endiga, bateekwa kufa;","poem":1},{"text":"olumbe ne lubalya.","poem":2},{"text":"Bakka butereevu emagombe,","poem":1},{"text":"obulungi bwabwe ne bubula,","poem":2},{"lineBreak":true},{"text":"amagombe ne gafuuka amaka gaabwe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Naye Katonda alinunula emmeeme yange mu magombe,","poem":1},{"text":"ddala ddala alintwala gy’ali.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Omuntu bw’agaggawalanga n’ekitiibwa ky’ennyumba ye nga kyeyongedde,","poem":1},{"text":"tomutyanga,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"kubanga bw’alifa taliiko ky’alitwala, wadde n’ekitiibwa kye tekirigenda naye.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Newaakubadde nga mu bulamu yeerowoozaako ng’aweereddwa omukisa","poem":1},{"text":"kubanga omugagga abantu bamugulumiza,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"kyokka alikka emagombe eri bajjajjaabe,","poem":1},{"text":"n’ayingira mu kizikiza ekikutte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Omuntu omugagga naye nga simutegeevu tabeerera mirembe gyonna,","poem":1},{"text":"alizikirira ng’ensolo ez’omu nsiko.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}