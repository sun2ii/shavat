{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":5,"content":[{"type":"hebrew_subtitle","content":["Ya mukulu wa Bayimbi. Ya ndere. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Otege okutu eri ebigambo byange, Ayi Mukama;","poem":1},{"text":"olowooze ku kunyolwa kwange.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wuliriza eddoboozi ly’omulanga gwange,","poem":1},{"text":"Ayi Kabaka wange era Katonda wange:","poem":2},{"lineBreak":true},{"text":"kubanga ggwe gwe nsaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ayi Mukama, buli nkya owulira eddoboozi lyange;","poem":1},{"text":"buli nkya ndeeta gy’oli okusaba kwange,","poem":2},{"lineBreak":true},{"text":"ne nnindirira onziremu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kubanga ggwe Ayi Katonda, tosanyukira bibi:","poem":1},{"text":"n’ebitasaana tobigumiikiriza.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ab’amalala era abakola ebibi tobeetaaga mu maaso go:","poem":1},{"text":"kubanga okyawa abakola ebibi bonna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abalimba bonna obazikiriza;","poem":1},{"text":"Mukama akyawa abatemu","poem":2},{"lineBreak":true},{"text":"era n’abalimba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Naye olw’ekisa kyo ekingi,","poem":1},{"text":"nze nnaayingiranga mu nnyumba yo:","poem":2},{"text":"ne nkusinziza mu Yeekaalu yo Entukuvu","poem":1},{"text":"n’okutya okungi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Onkulembere, Ayi Mukama, mu butuukirivu bwo,","poem":1},{"text":"olw’abalabe bange,","poem":2},{"lineBreak":true},{"text":"ondage ekkubo eggolokofu ery’okutambulirangamu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abalabe bange bye boogera tebyesigibwa;","poem":1},{"text":"emitima gyabwe gijjudde bussi bwereere.","poem":2},{"text":"Emimiro gyabwe ntaana eyasaamiridde:","poem":1},{"text":"akamwa kaabwe koogera bya bulimba.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Basalire omusango gubasinge, Ayi Katonda;","poem":1},{"text":"baleke bagwe mu mitego gyabwe.","poem":2},{"text":"Bagobe","poem":1},{"text":"kubanga baakujeemera.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Naye leka abo bonna abakwesiga basanyukenga;","poem":1},{"text":"ennaku zonna bayimbenga n’essanyu,","poem":2},{"text":"obakuumenga,","poem":1},{"text":"abo abaagala erinnya lyo basanyukirenga mu ggwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kubanga, Ayi Mukama, omutuukirivu omuwa omukisa;","poem":1},{"text":"era omukuuma, n’omwetoolooza okwagala ng’engabo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}