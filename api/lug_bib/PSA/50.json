{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":50,"content":[{"type":"hebrew_subtitle","content":["Zabbuli ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Oyo Owaamaanyi, Mukama Katonda,","poem":1},{"text":"akoowoola ensi","poem":2},{"lineBreak":true},{"text":"okuva enjuba gy’eva okutuuka gy’egwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Katonda ayakaayakana","poem":1},{"text":"ng’ava mu Sayuuni n’obulungi bw’ekitiibwa kye ekituukiridde.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Katonda waffe ajja, naye tajja kasirise,","poem":1},{"text":"omuliro ogusaanyaawo buli kintu gwe gumukulembera,","poem":2},{"lineBreak":true},{"text":"n’omuyaga ogw’amaanyi ne gumwetooloola.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Akoowoola abali mu ggulu ne ku nsi,","poem":1},{"text":"azze okusalira abantu be omusango.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Agamba nti, “Munkuŋŋaanyize abantu bange abaayawulibwa,","poem":1},{"text":"abaakola nange endagaano nga bawaayo ssaddaaka.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eggulu litegeeza obutuukirivu bwa Katonda","poem":1},{"text":"kubanga Katonda yennyini ye mulamuzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Muwulirize, mmwe abantu bange, nange nnaayogera.","poem":1},{"text":"Ggwe Isirayiri bino bye nkuvunaana:","poem":2},{"lineBreak":true},{"text":"Nze Katonda, Katonda wo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sikunenya lwa ssaddaaka zo,","poem":1},{"text":"oba ebiweebwayo ebyokebwa by’ossa mu maaso gange bulijjo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sikyakkiriza nte nnume n’emu evudde mu kiralo kyo,","poem":1},{"text":"wadde embuzi ennume ezivudde mu bisibo byo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kubanga buli nsolo ey’omu kibira yange,","poem":1},{"text":"awamu n’ente eziri ku nsozi olukumi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ennyonyi zonna ez’oku nsozi nzimanyi,","poem":1},{"text":"n’ebiramu byonna eby’omu nsiko byange.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Singa nnumwa enjala sandikubuulidde:","poem":1},{"text":"kubanga ensi n’ebigirimu byonna byange.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndya ennyama y’ente ennume,","poem":1},{"text":"wadde okunywa omusaayi gw’embuzi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Owangayo ssaddaaka ey’okwebaza eri Katonda;","poem":1},{"text":"era otuukirizanga obweyamo bwo eri oyo Ali Waggulu Ennyo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bw’obanga mu buzibu,","poem":1},{"text":"nnaakuwonyanga, naawe onongulumizanga.”","poem":2}]},{"type":"verse","number":16,"content":["Naye omubi Katonda amugamba nti,",{"text":"“Lekeraawo okwatulanga amateeka gange,","poem":1},{"text":"n’endagaano yange togyogerangako.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kubanga okyawa okuluŋŋamizibwa,","poem":1},{"text":"n’ebigambo byange tobissaako mwoyo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bw’olaba omubbi, ng’omukwana;","poem":1},{"text":"era weetaba n’abenzi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Okolima era olimba;","poem":1},{"text":"olulimi lwo lwogera ebitali bya butuukirivu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Muganda wo omwogerako bibi byereere buli kiseera,","poem":1},{"text":"era owayiriza omwana wa nnyoko yennyini.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ebyo byonna obikoze, ne nsirika,","poem":1},{"text":"n’olowooza nti twenkanankana.","poem":2},{"text":"Naye kaakano ka nkunenye,","poem":1},{"text":"ebisobyo byonna mbikulage.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Ggwe eyeerabira Katonda, ebyo bisseeko omwoyo,","poem":1},{"text":"nneme kukuyuzaayuza nga tewali na wa kukuwonya.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Oyo awaayo ssaddaaka ey’okwebaza angulumiza,","poem":1},{"text":"era ateekateeka ekkubo","poem":2},{"lineBreak":true},{"text":"ndyoke mulage obulokozi bwa Katonda.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}