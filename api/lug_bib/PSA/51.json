{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":51,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi. Nnabbi Nasani bwe yajja eri Dawudi, Dawudi ng’amaze okutwala Basuseba n’okutemula bba, Uliya."]},{"type":"verse","number":1,"content":[{"text":"Onsaasire, Ayi Mukama,","poem":1},{"text":"ggwe alina okwagala okutaggwaawo.","poem":2},{"text":"Olw’okusaasira kwo okungi","poem":1},{"text":"nziggyaako ebyonoono byange byonna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nnaazaako obutali butuukirivu bwange,","poem":1},{"text":"ontukulize ddala okuva mu kibi kyange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ebyonoono byange mbikkiriza,","poem":1},{"text":"era ebibi byange mbimanyi bulijjo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ggwe wennyini ggwe nnyonoonye,","poem":1},{"text":"ne nkola ebitali bya butuukirivu mu maaso go ng’olaba;","poem":2},{"text":"noolwekyo by’oyogera bituufu,","poem":1},{"text":"era n’ensala yo ey’omusango ya bwenkanya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ddala, nazaalibwa mu kibi;","poem":1},{"text":"kasookedde ntondebwa mu lubuto lwa mmange ndi mwonoonyi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Oyagala amazima agaviira ddala mu mutima gwange.","poem":1},{"text":"Ompe amagezi munda ddala mu nze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Onnaaze n’ezobu","poem":1},{"noteId":10},{"text":"ntukule","poem":1},{"text":"onnaaze ntukule n’okusinga omuzira.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Onzirize essanyu n’okwesiima,","poem":1},{"text":"amagumba gange ge wamenyaamenya gasanyuke.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Totunuulira bibi byange,","poem":1},{"text":"era osangule ebyonoono byange byonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ontondemu omutima omulongoofu, Ayi Katonda,","poem":1},{"text":"era onteekemu omwoyo omulungi munda yange.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tongoba w’oli,","poem":1},{"text":"era tonzigyako Mwoyo wo Omutukuvu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Onkomezeewo essanyu ery’obulokozi bwo,","poem":1},{"text":"era ompe omutima ogugondera by’oyagala,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ndyoke njigirizenga aboonoonyi amakubo go,","poem":1},{"text":"n’abakola ebibi bakukyukirenga bakomewo gy’oli.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ondokole mu kibi eky’okuyiwa omusaayi, Ayi Katonda,","poem":1},{"text":"ggwe Katonda ow’obulokozi bwange;","poem":2},{"lineBreak":true},{"text":"olulimi lwange lunaatenderezanga obutuukirivu bwo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ayi Mukama, yasamya emimwa gyange,","poem":1},{"text":"n’akamwa kange kanaakutenderezanga.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tosanyukira ssaddaaka, nandigikuleetedde;","poem":1},{"text":"n’ebiweebwayo ebyokebwa tobisanyukira.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ssaddaaka Katonda gy’ayagala gwe mwoyo ogutegedde okusobya kwagwo.","poem":1},{"text":"Omutima ogumenyese era oguboneredde,","poem":2},{"lineBreak":true},{"text":"Ayi Katonda, toogugayenga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Okulaakulanye Sayuuni nga bw’osiima.","poem":1},{"text":"Yerusaalemi okizzeeko bbugwe waakyo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Olyoke osanyukire ssaddaaka ey’obutuukirivu,","poem":1},{"text":"ebiweebwayo ebyokebwa ebikusanyusa;","poem":2},{"lineBreak":true},{"text":"n’ente ziweebweyo ku kyoto kyo.","poem":2}]}],"footnotes":[{"noteId":10,"caller":"+","text":"Ezobu kimera ekisangibwa mu Asiya, era kikozesebwa okutuukiriza obulombolombo obw’enjawulo okutukuzibwa, mu Baebbulaniya","reference":{"chapter":51,"verse":7}}]},"thisChapterLink":"/api/lug_bib/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}