{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi Dowegi Omwedomu bwe yagenda n’abuulira Sawulo nti, “Dawudi alaze mu nnyumba ya Akimereki.”"]},{"type":"verse","number":1,"content":[{"text":"Lwaki weenyumiririza mu kibi ggwe omusajja ow’amaanyi?","poem":1},{"text":"Endagaano ya Katonda ey’obwesigwa ebeerera emirembe n’emirembe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Oteekateeka enkwe ez’okuzikiriza.","poem":1},{"text":"Olulimi lwo lwogi nga kkirita","poem":2},{"lineBreak":true},{"text":"era buli kiseera lwogera bya bulimba.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Oyagala okukola ebibi okusinga okukola ebirungi,","poem":1},{"text":"n’okulimba okusinga okwogera amazima.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Osanyukira nnyo okwogera ebirumya.","poem":1},{"text":"Ggwe olulimi kalimbira!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kyokka Katonda alikuzikiriza emirembe gyonna;","poem":1},{"text":"alikusikula, akuggye mu maka go;","poem":2},{"lineBreak":true},{"text":"alikugoba mu nsi y’abalamu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bino abatuukirivu balibiraba, ne babitunuulira nga batidde.","poem":1},{"text":"Naye balikusekerera, nga bwe bagamba nti,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Mumulabe omusajja","poem":1},{"text":"ateesiga Katonda okuba ekiddukiro kye,","poem":2},{"text":"naye ne yeesiganga obugagga bwe obungi,","poem":1},{"text":"ne yeeyongera n’amaanyi ng’azikiriza abalala.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Naye nze nfaanana ng’omuti omuzeyituuni","poem":1},{"text":"ogukulira mu nnyumba ya Katonda.","poem":2},{"text":"Neesiga okwagala kwa Katonda okutaggwaawo","poem":1},{"text":"emirembe n’emirembe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nnaakwebazanga emirembe gyonna olw’ekyo ky’okoze.","poem":1},{"text":"Nneesiganga erinnya lyo kubanga erinnya lyo ddungi;","poem":2},{"lineBreak":true},{"text":"era nnaakutendererezanga awali abatuukirivu bo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}