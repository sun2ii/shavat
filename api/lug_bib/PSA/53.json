,{"text":"so tebakoowoola Katonda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Balitya okutya okutagambika;","poem":1},{"text":"kubanga Katonda alisaasaanya amagumba g’abalabe be.","poem":2},{"text":"Baliswazibwa","poem":1},{"text":"kubanga Katonda yabanyooma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Singa obulokozi bwa Isirayiri bufuluma mu Sayuuni,","poem":1},{"text":"Katonda n’akomyawo emirembe eri abantu be,","poem":2},{"lineBreak":true},{"text":"Yakobo asanyuka ne Isirayiri n’ajaguza.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}