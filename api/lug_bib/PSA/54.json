{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Eyimbibwa n’ebivuga eby’enkoba. Zabbuli ya Dawudi, Abazifu bwe bajja ne babuulira Sawulo nti, “Dawudi yeekwese mu ffe.”"]},{"type":"verse","number":1,"content":[{"text":"Olw’erinnya lyo ondokole, Ayi Katonda,","poem":1},{"text":"n’amaanyi go amangi onzigyeko omusango.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wulira okusaba kwange, Ayi Katonda,","poem":1},{"text":"owulirize ebigambo by’omu kamwa kange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Abantu be simanyi bannumba;","poem":1},{"text":"abantu abalina ettima abatatya Katonda;","poem":2},{"lineBreak":true},{"text":"bannoonya okunzita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Laba, Katonda ye mubeezi wange,","poem":1},{"text":"Mukama ye mukuumi wange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Leka ebintu ebibi byonna bye bantegekera, bibeekyusize,","poem":1},{"text":"obazikirize olw’obwesigwa bwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nnaakuleeteranga ssaddaaka ey’ekyeyagalire;","poem":1},{"text":"ne ntendereza erinnya lyo, Ayi Mukama,","poem":2},{"lineBreak":true},{"text":"kubanga ddungi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kubanga Katonda amponyezza ebizibu byange byonna;","poem":1},{"text":"era amaaso gange galabye ng’awangula abalabe bange.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}