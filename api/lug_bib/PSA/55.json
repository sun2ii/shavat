{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":55,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Eyimbibwa n’ebivuga eby’enkoba. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Owulirize okusaba kwange, Ayi Katonda,","poem":1},{"text":"togaya kwegayirira kwange.","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ompulire era onziremu,","poem":2},{"text":"kubanga ndi mu buzibu, nga nsinda olw’okweraliikirira okunene.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Mpulira amaloboozi g’abalabe bange;","poem":2},{"lineBreak":true},{"text":"ababi bankanulidde amaaso","poem":2},{"text":"ne banvuma nga bajjudde obusungu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Omutima gwange gulumwa nnyo munda yange;","poem":1},{"text":"entiisa y’okufa entuukiridde.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Okutya n’okukankana binnumbye;","poem":1},{"text":"entiisa empitiridde.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne njogera nti, Singa nnina ebiwaawaatiro ng’ejjiba,","poem":1},{"text":"nandibuuse ne ŋŋenda mpummulako.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Nandiraze wala nnyo,","poem":1},{"text":"ne mbeera eyo mu ddungu;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"nandiyanguye ne ntuuka mu kifo kyange eky’okuwummuliramu,","poem":1},{"text":"eteri kibuyaga na mpewo ekunta n’amaanyi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mukama tabulatabula ennimi z’ababi, ozikirize enkwe zaabwe;","poem":1},{"text":"kubanga ndaba obukambwe n’okulwanagana mu kibuga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Beetooloola bbugwe waakyo emisana n’ekiro,","poem":1},{"text":"ne munda mu kyo mujjudde ettima n’ebikolwa ebibi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Obutemu n’obussi obwa buli ngeri biri mu kibuga omwo.","poem":1},{"text":"Buli lw’oyita mu nguudo zaakyo osanga bulimba bwereere na kutiisibwatiisibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Singa omulabe wange y’abadde anvuma,","poem":1},{"text":"nandikigumiikirizza;","poem":2},{"text":"singa oyo atakkiriziganya nange y’annumbaganye n’anduulira,","poem":1},{"text":"nandimwekwese.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Naye ggwe munnange,","poem":1},{"text":"bwe tuyita, era mukwano gwange ddala!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Gwe twabanga naye mu ssanyu ng’abooluganda,","poem":1},{"text":"nga tutambulira mu kibiina ekinene mu nnyumba ya Katonda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Okufa kubatuukirire,","poem":1},{"text":"bakke emagombe nga bakyali balamu;","poem":2},{"lineBreak":true},{"text":"kubanga bajjudde okukola ebibi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Naye nze nkoowoola Mukama Katonda,","poem":1},{"text":"n’andokola.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ekiro, ne mu makya ne mu ttuntu,","poem":1},{"text":"ndaajana nga bwe nsinda;","poem":2},{"lineBreak":true},{"text":"n’awulira eddoboozi lyange.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Amponyezza mu lutalo","poem":1},{"text":"nga siriiko kintuseeko","poem":2},{"lineBreak":true},{"text":"newaakubadde ng’abannwanyisizza babadde bangi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Katonda oyo atudde ku ntebe ye ebbanga lyonna,","poem":1},{"text":"aliwulira n’ababonereza","poem":2},{"text":"abo abatakyusa makubo gaabwe","poem":1},{"text":"era abatatya Katonda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Agololera emikono gye ku mikwano gye;","poem":1},{"text":"n’amenya endagaano ye.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"By’ayogera bigonvu okusinga omuzigo,","poem":1},{"text":"so nga mu mutima gwe alowooza lutalo;","poem":2},{"text":"ebigambo bye biweweera okusinga amafuta,","poem":1},{"text":"so nga munda mu mutima gwe asowodde bitala byennyini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ebizibu byo byonna bireete eri Mukama,","poem":1},{"text":"ajja kukuwanirira;","poem":2},{"lineBreak":true},{"text":"kubanga talireka mutuukirivu kugwa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Naye ggwe, Ayi Katonda,","poem":1},{"text":"olisuula abakola ebibi mu kinnya eky’okuzikirira;","poem":2},{"text":"era abatemu n’abalimba bonna","poem":1},{"text":"tebagenda kuwangaala kimu kyakubiri eky’obulamu bwabwe.","poem":2},{"lineBreak":true},{"text":"Naye nze, neesiga ggwe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}