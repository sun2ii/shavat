{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":56,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi. Abafirisuuti bwe baamukwatira mu Gaasi."]},{"type":"verse","number":1,"content":[{"text":"Onsaasire, Ayi Katonda, kubanga abalabe bange banjigganya;","poem":1},{"text":"buli lunaku bannumba n’amaanyi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abalabe bange bannondoola,","poem":1},{"text":"bangi bannwanyisa nga bajjudde amalala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Buli lwe ntya,","poem":1},{"text":"neesiga ggwe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nditendereza Katonda ne nyweerera mu kigambo kye,","poem":1},{"text":"ye Katonda gwe neesiga; siityenga.","poem":2},{"lineBreak":true},{"text":"Abantu obuntu bagenda kunkolako ki?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Olunaku lwonna bye njogera babifuulafuula;","poem":1},{"text":"ebbanga lyonna baba basala nkwe kunkola kabi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Beekobaana ne bateesa,","poem":1},{"text":"banneekwekerera ne bawuliriza enswagiro zange;","poem":2},{"lineBreak":true},{"text":"nga bannindirira banzite.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tobakkiriza kudduka ne bawona;","poem":1},{"text":"mu busungu bwo, Ayi Katonda, osuule amawanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Emirundi gye ntawaanyizibwa nga njaziirana ogimanyi;","poem":1},{"text":"amaziga gange gateeke mu ccupa yo!","poem":2},{"lineBreak":true},{"text":"Wagawandiika.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bwe nkukoowoola,","poem":1},{"text":"abalabe bange nga badduka.","poem":2},{"lineBreak":true},{"text":"Kino nkimanyi kubanga Katonda ali ku ludda lwange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Katonda gwe ntendereza olw’ekisuubizo kye;","poem":1},{"text":"Mukama gwe ntendereza olw’ekisuubizo kye;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Katonda oyo gwe neesiga, siityenga.","poem":1},{"text":"Abantu bayinza kunkolako ki?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ndituukiriza obweyamo bwange gy’oli, Ayi Katonda;","poem":1},{"text":"ndikuleetera ebirabo eby’okukwebaza.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kubanga emmeeme yange ogiwonyezza okufa.","poem":1},{"text":"Ebigere byange tobiwonyezza okwesittala;","poem":2},{"text":"ne ndyoka ntambulira mu maaso ga Katonda","poem":1},{"text":"mu musana nga ndi mulamu?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}