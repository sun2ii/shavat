{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":57,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Ku ddoboozi, “Tozikiriza.” Zabbuli ya Dawudi bwe yadduka Sawulo, n’alaga mu mpuku."]},{"type":"verse","number":1,"content":[{"text":"Onsaasire, Ayi Katonda, onsaasire,","poem":1},{"text":"kubanga neesiga ggwe.","poem":2},{"text":"Nzija kwekweka mu kisiikirize ky’ebiwaawaatiro byo","poem":1},{"text":"okutuusa okuzikirira bwe kulikoma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nkoowoola Katonda Ali Waggulu Ennyo,","poem":1},{"text":"Katonda atuukiriza bye yantegekera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Alisinzira mu ggulu n’andokola,","poem":1},{"text":"n’amponya abo abampalana.","poem":2},{"lineBreak":true},{"text":"Katonda anandaganga obwesigwa bwe n’okwagala kwe okutaggwaawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mbeera wakati mu mpologoma,","poem":1},{"text":"nsula mu bisolo ebirya abaana b’abantu.","poem":2},{"text":"Amannyo g’abalabe bange gali ng’amafumu n’obusaale.","poem":1},{"text":"Ennimi zaabwe ziri ng’ebitala ebyogi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ayi Katonda, ogulumizibwenga okusinga eggulu;","poem":1},{"text":"n’ekitiibwa kyo kibune ensi yonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Baatega ekitimba mu kkubo lyange,","poem":1},{"text":"ne ntya nnyo;","poem":2},{"text":"ne basimamu obunnya,","poem":1},{"text":"ate bo bennyini ne babugwamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Omutima gwange munywevu, Ayi Katonda,","poem":1},{"text":"omutima gwange munywevu.","poem":2},{"lineBreak":true},{"text":"Nnaakutenderezanga n’ennyimba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zuukuka, ggwe omwoyo gwange!","poem":1},{"text":"Zuukuka ggwe ennanga ey’enkoba, naawe entongooli,","poem":2},{"lineBreak":true},{"text":"ndyoke nnyimbe okukeesa obudde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ayi Mukama, ndikwebaza mu mawanga;","poem":1},{"text":"ndiyimba nga nkutendereza mu bantu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kubanga okwagala kwo kungi nnyo, kutuuka ne ku ggulu;","poem":1},{"text":"n’obwesigwa bwo butuuka ku bire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ogulumizibwenga, Ayi Katonda, okusinga eggulu;","poem":1},{"text":"n’ekitiibwa kyo kibune ensi yonna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}