{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":59,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Ku ddoboozi, “Tozikiriza.” Zabbuli ya Dawudi, Sawulo bwe yatuma bakuume enju ya Dawudi bamutte."]},{"type":"verse","number":1,"content":[{"text":"Ayi Katonda wange, mponya abalabe bange;","poem":1},{"text":"onnwanirire, abantu bwe bangolokokerako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Omponye abakola ebitali bya butuukirivu,","poem":1},{"text":"era ondokole mu batemu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Laba banneekwekeredde nga banteega okunzita.","poem":1},{"text":"Abasajja ab’amaanyi abakambwe banneekobera, Ayi Mukama,","poem":2},{"lineBreak":true},{"text":"so nga soonoonye wadde okubaako ne kye nsobezza.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sirina kye nsobezza, naye bateekateeka okunnumba.","poem":1},{"text":"Tunuulira obuzibu bwange, osituke, onnyambe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ayi Mukama Katonda ow’Eggye, Katonda wa Isirayiri,","poem":1},{"text":"golokoka obonereze amawanga gonna;","poem":2},{"lineBreak":true},{"text":"abo bonna abasala enkwe tobasaasira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bakomawo buli kiro,","poem":1},{"text":"nga babolooga ng’embwa,","poem":2},{"lineBreak":true},{"text":"ne batambulatambula mu kibuga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Laba, bwe bavuma!","poem":1},{"text":"Ebigambo biwamatuka mu kamwa kaabwe ng’ebitala,","poem":2},{"lineBreak":true},{"text":"nga boogera nti, “Ani atuwulira?”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Naye ggwe, Ayi Mukama, obasekerera,","poem":1},{"text":"era amawanga ago gonna oganyooma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ayi Katonda, Amaanyi gange, nnaakwesiganga","poem":1},{"text":"era nnaakutenderezanga, kubanga ggwe kigo kyange ekinywevu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Katonda wange anjagala","poem":2},{"text":"anankulemberanga,","poem":1},{"text":"ne ndyoka neeyagalira ku balabe bange.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tobatta, Ayi Mukama, engabo yaffe,","poem":1},{"text":"abantu bange baleme kwerabira;","poem":2},{"text":"mu buyinza bwo obungi, baleke batangetange;","poem":1},{"text":"n’oluvannyuma obakkakkanyize ddala.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Amalala gaabwe n’ebyonoono ebiva mu kamwa kaabwe,","poem":1},{"text":"n’ebigambo by’oku mimwa gyabwe","poem":2},{"lineBreak":true},{"text":"leka byonna bibatege ng’omutego.","poem":2},{"text":"Kubanga bakolima era ne boogera eby’obulimba.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"Bamaleewo n’ekiruyi kyo,","poem":2},{"lineBreak":true},{"text":"bamalirewo ddala;","poem":2},{"text":"amawanga gonna galyoke gategeere","poem":1},{"text":"nga Katonda wa Yakobo y’afuga ensi yonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Bakomawo nga buwungedde","poem":1},{"text":"nga babolooga ng’embwa,","poem":2},{"lineBreak":true},{"text":"ne batambulatambula mu kibuga.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Banoonya emmere buli wantu mu kibuga,","poem":1},{"text":"ne bawowoggana bwe batakkuta.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Naye nze nnaayimbanga nga ntendereza amaanyi go;","poem":1},{"text":"mu makya nnaayimbanga ku kwagala kwo;","poem":2},{"text":"kubanga ggwe kigo kyange,","poem":1},{"text":"era ggwe kiddukiro kyange mu buzibu bwange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ggwe, Ayi Katonda, Amaanyi gange, nnaakuyimbiranga nga nkutendereza;","poem":1},{"text":"kubanga ggwe kigo kyange, era ggwe Katonda wange, anjagala.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}