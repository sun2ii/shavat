{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"hebrew_subtitle","content":["Eri Omukulu wa Bayimbi. Eyimbibwa n’ebivuga eby’enkoba. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Ayi Mukama, tonnenya ng’ojjudde obusungu;","poem":1},{"text":"so tombonereza mu kiruyi kyo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Onsaasire, Ayi Mukama, kubanga ndi munafu.","poem":1},{"text":"Omponye, Ayi Mukama, kubanga amagumba gange gali mu bulumi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Emmeeme yange ejjudde ennaku.","poem":1},{"text":"Olirindirira kutuusa ddi olyoke onnyambe?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Onkyukire, Ayi Mukama, olokole omwoyo gwange;","poem":1},{"text":"omponye okufa olw’okwagala kwo okungi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kubanga tewali ayinza kukujjukira ng’amaze okufa.","poem":1},{"text":"Ani alikutendereza ng’asinziira emagombe?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mpweddemu amaanyi olw’okusinda.","poem":1},{"lineBreak":true},{"text":"Buli kiro obuliri bwange bujjula amaziga gange","poem":1},{"text":"n’omutto ne gutoba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Amaaso gange ganafuye olw’okunyolwa,","poem":1},{"text":"tegakyalaba bulungi olw’abalabe bange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Muve we ndi mmwe mwenna abakola ebibi;","poem":1},{"text":"kubanga Mukama awulidde okukaaba kwange.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mukama awulidde okwegayirira kwange,","poem":1},{"text":"n’okusaba kwange akukkirizza.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abalabe bange bonna baliswazibwa era balitya nnyo;","poem":1},{"text":"bazzibwe emabega nga bajjudde obuswavu mangu ago.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}