{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":60,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Ku ddoboozi, “Eddanga ery’Endagaano.” Zabbuli ya Dawudi. Yakuyigiriza. Dawudi bwe yalwana n’Abaalamu abaava e Nakalayimu n’abaava e Zoba, Yowaabu n’akomawo n’atta Abayedomu omutwalo gumu mu enkumi bbiri mu Kiwonvu eky’Omunnyo."]},{"type":"verse","number":1,"content":[{"text":"Otusudde, Ayi Katonda, otumazeemu amaanyi,","poem":1},{"text":"otunyiigidde. Tukwegayiridde otuzze gy’oli.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ensi ogiyuuguumizza n’ogyasaayasa;","poem":1},{"text":"tukwegayirira enjatika ozizibe, kubanga ekankana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Obadde mukambwe nnyo eri abantu bo;","poem":1},{"text":"tuli nga b’owadde omwenge omungi ne gututagaza.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Naye abo abakutya obawanikidde ebbendera okuba akabonero akabakuŋŋaanya awamu,","poem":1},{"text":"era akatiisa abalabe baabwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Otulokole era otuyambe n’omukono gwo ogwa ddyo,","poem":1},{"text":"abakwagala baleme kutuukibwako kabi konna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Katonda ayogedde ng’asinziira mu kifo kye ekitukuvu, n’agamba nti,","poem":1},{"text":"“Mu buwanguzi, ndisala mu Sekemu,","poem":2},{"lineBreak":true},{"text":"era n’ekiwonvu kya Sukkosi ndikigabanyagabanyaamu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ensi ya Gireyaadi yange, n’eya Manase nayo yange.","poem":1},{"text":"Efulayimu ye nkufiira ey’oku mutwe gwange;","poem":2},{"lineBreak":true},{"text":"ate Yuda gwe muggo gwange ogw’okufuga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mowaabu kye kinaabirwamu kyange,","poem":1},{"text":"ate Edomu gye nkasuka engatto yange:","poem":2},{"lineBreak":true},{"text":"ne ku Bafirisuuti ndeekaana mu buwanguzi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ani anantuusa ku kibuga ekigumu ekinywevu?","poem":1},{"text":"Ani anankulembera okunnyingiza mu Edomu?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Si ggwe Ayi Katonda, atusudde,","poem":1},{"text":"atakyatabaala na magye gaffe?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tudduukirire, nga tulwanyisa abalabe baffe,","poem":1},{"text":"kubanga obuyambi bw’abantu temuli nsa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bwe tunaabeeranga ne Katonda, tunaabanga bawanguzi,","poem":1},{"text":"kubanga ye y’anaalinnyiriranga abalabe baffe wansi w’ebigere bye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}