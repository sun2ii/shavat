{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":62,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Ya Yedusuni. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Emmeeme yange ewummulira mu Katonda yekka;","poem":1},{"text":"oyo obulokozi bwange mwe buva.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ye yekka, lwe lwazi lwange era bwe bulokozi bwange;","poem":1},{"text":"ye kye kigo kyange siinyeenyezebwenga n’akatono.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mulituusa ddi nga mulumba omuntu,","poem":1},{"text":"mmwe mwenna okwagala okumusuula wansi","poem":2},{"lineBreak":true},{"text":"ng’ekisenge ekyewunzise era ng’olukomera oluyuuguuma?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bateesa okumuggya","poem":1},{"text":"mu kifo kye ekinywevu,","poem":2},{"lineBreak":true},{"text":"basanyukira eby’obulimba.","poem":2},{"text":"Basaba omukisa n’emimwa gyabwe","poem":1},{"text":"so nga munda bakolima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Emmeeme yange ewummulire mu Katonda yekka;","poem":1},{"text":"kubanga mu ye mwe muli essuubi lyange.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ye yekka lwe lwazi lwange era bwe bulokozi bwange,","poem":1},{"text":"ye kye kigo kyange, siinyeenyezebwenga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Okulokolebwa kwange n’ekitiibwa kyange biri mu Katonda yekka;","poem":1},{"text":"ye lwe lwazi lwange olw’amaanyi era kye kiddukiro kyange.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mumwesigenga bulijjo mmwe abantu,","poem":1},{"text":"mumutegeezenga byonna ebiri mu mitima gyammwe,","poem":2},{"lineBreak":true},{"text":"kubanga Katonda kye kiddukiro kyaffe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abaana b’abantu mukka bukka,","poem":1},{"text":"abazaalibwa mu bugagga bulimba bwereere;","poem":2},{"text":"ne bwe bageraageranyizibwa ku minzaani,","poem":1},{"text":"n’omukka gubasinga okuzitowa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Temwesigamanga ku bujoozi","poem":1},{"text":"wadde ku bintu ebibbe.","poem":2},{"text":"Temuyitirira okwewaanirawaanira mu bugagga bwammwe ne bwe bweyongeranga,","poem":1},{"text":"era temubumalirangako mwoyo gwammwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Katonda ayogedde ekintu kimu,","poem":1},{"text":"kyokka nze nziggyemu ebintu bibiri nti:","poem":2},{"text":"Katonda, oli w’amaanyi,","poem":1}]},{"type":"verse","number":12,"content":[{"text":"era ggwe, Ayi Mukama, ojjudde okwagala.","poem":2},{"text":"Ddala olisasula buli muntu","poem":1},{"text":"ng’ebikolwa bye bwe biri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}