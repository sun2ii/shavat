{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"hebrew_subtitle","content":["Zabbuli ya Dawudi, bwe yali mu ddungu lya Yuda."]},{"type":"verse","number":1,"content":[{"text":"Ayi Katonda, oli Katonda wange,","poem":1},{"text":"nkunoonya n’omutima gwange gwonna;","poem":2},{"text":"emmeeme yange ekwetaaga,","poem":1},{"text":"omubiri gwange gwonna gukuyaayaanira,","poem":2},{"text":"nga nnina ennyonta ng’ali","poem":1},{"text":"mu nsi enkalu omutali mazzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nkulabye ng’oli mu kifo kyo ekitukuvu,","poem":1},{"text":"ne ndaba amaanyi go n’ekitiibwa kyo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kubanga okwagala kwo okutaggwaawo kusinga obulamu;","poem":1},{"text":"akamwa kange kanaakutenderezanga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bwe ntyo nnaakutenderezanga obulamu bwange bwonna;","poem":1},{"text":"nnaayimusanga emikono gyange mu linnya lyo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Emmeeme yange enekkutanga ebyassava n’obugagga;","poem":1},{"text":"nnaayimbanga nga nkutendereza n’emimwa egy’essanyu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nkujjukira nga ndi ku kitanda kyange,","poem":1},{"text":"era nkufumiitirizaako mu ssaawa ez’ekiro.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Olw’okuba ng’oli mubeezi wange,","poem":1},{"text":"nnyimba nga ndi mu kisiikirize ky’ebiwaawaatiro byo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Emmeeme yange yeekwata ku ggwe;","poem":1},{"text":"omukono gwo ogwa ddyo gumpanirira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Naye abo abannoonya okunzita balizikirizibwa,","poem":1},{"text":"baliserengeta emagombe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Balisaanawo n’ekitala;","poem":1},{"text":"ne bafuuka emmere y’ebibe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Naye ye kabaka anaajagulizanga mu Katonda;","poem":1},{"text":"bonna abalayira mu linnya lya Katonda banaatenderezanga Katonda,","poem":2},{"lineBreak":true},{"text":"naye akamwa k’abalimba kalisirisibwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}