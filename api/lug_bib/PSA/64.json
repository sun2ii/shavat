{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Ayi Katonda, owulire eddoboozi lyange, ery’okwemulugunya kwange;","poem":1},{"text":"okuume obulamu bwange eri okutiisibwatiisibwa omulabe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Onkweke mpone enkwe z’abakola ebibi,","poem":1},{"text":"onzigye mu kibinja ky’aboonoonyi, abaleekaana","poem":2}]},{"type":"verse","number":3,"content":[{"text":"abawagala ennimi zaabwe ng’ebitala,","poem":1},{"text":"ne balasa ebigambo byabwe ng’obusaale obutta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Beekweka ne bateega oyo atalina musango bamulase;","poem":1},{"text":"amangwago ne bamulasa nga tebatya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bawagiragana mu kigendererwa kyabwe ekibi","poem":1},{"text":"ne bateesa okutega emitego mu kyama;","poem":2},{"lineBreak":true},{"text":"ne boogera nti, “Ani asobola okutulaba?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Beekobaana okukola ebitali bya bwenkanya, ne boogera nti,","poem":1},{"text":"“Tukoze enteekateeka empitirivu.”","poem":2},{"lineBreak":true},{"text":"Ddala ddala ebirowoozo by’omuntu n’omutima gwe byekusifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Naye Katonda alibalasa n’obusaale bwe;","poem":1},{"text":"alibafumita, mangwago ne bagwa ku ttaka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ebyo bye boogera biribaddira,","poem":1},{"text":"ne bibazikiriza,","poem":2},{"lineBreak":true},{"text":"ababalaba ne babanyeenyeza emitwe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Olwo abantu bonna ne batya,","poem":1},{"text":"ne bategeeza abalala omulimu gwa Katonda,","poem":2},{"lineBreak":true},{"text":"ne bafumiitiriza ku ebyo by’akoze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Omutuukirivu ajagulizenga mu Mukama,","poem":1},{"text":"era yeekwekenga mu ye.","poem":2},{"lineBreak":true},{"text":"Abo bonna abalina omutima omulongoofu bamutenderezenga!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}