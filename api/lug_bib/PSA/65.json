{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":65,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Oluyimba, Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Osaanira okutenderezebwanga, Ayi Katonda, ali mu Sayuuni;","poem":1},{"text":"tunaatuukiririzanga obweyamo bwaffe gy’oli.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ayi ggwe awulira okusaba kw’abantu bo,","poem":1},{"text":"abantu bonna banajjanga gy’oli olw’ebibi byabwe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ebibi byaffe bwe byatusukkirira,","poem":1},{"text":"n’otutangiririra.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Alina omukisa oyo gw’olonda","poem":1},{"text":"n’omusembeza okumpi naawe, abeerenga mu mpya zo.","poem":2},{"text":"Tunaamalibwanga ebirungi eby’omu nnyumba yo;","poem":1},{"text":"eby’omu Yeekaalu yo entukuvu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Otwanukula n’ebikolwa byo eby’obutuukirivu eby’entiisa n’otulokola,","poem":1},{"text":"Ayi Katonda ow’obulokozi bwaffe;","poem":2},{"text":"ggwe ssuubi ly’abo abali mu nsi yonna n’abo bonna","poem":1},{"text":"abali ewala mu nnyanja zonna,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ggwe, eyakola ensozi n’obuyinza bwo,","poem":1},{"text":"n’ozinyweza n’amaanyi go,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ggwe, asirisa okusiikuuka kw’ennyanja,","poem":1},{"text":"n’okkakkanya okwetabula kw’amayengo gaayo,","poem":2},{"lineBreak":true},{"text":"era ggw’okkakkanya okwegugunga kw’amawanga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abo bonna ababeera ewala balaba ne batya ebyewuunyo byo;","poem":1},{"text":"ne bakuyimbira ennyimba ez’essanyu","poem":2},{"lineBreak":true},{"text":"okuva ku makya okutuusa akawungeezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ensi ogirabirira n’ogifukirira","poem":1},{"text":"n’egimuka nnyo.","poem":2},{"text":"Emigga gya Katonda gijjudde amazzi,","poem":1},{"text":"okuwa abantu emmere ey’empeke,","poem":2},{"lineBreak":true},{"text":"kubanga bw’otyo bwe wakiteekateeka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Otonnyesa enkuba mu nnimiro,","poem":1},{"text":"n’ojjuza ebitaba byamu;","poem":2},{"text":"n’ogonza ettaka,","poem":1},{"text":"ebibala by’omu nsi n’obiwa omukisa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ofundikira omwaka n’amakungula amangi,","poem":1},{"text":"ebigaali ne bigenda nga byetisse ebibala nga bikubyeko.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ebifo awali omuddo mu ddungu bijjula amazzi,","poem":1},{"text":"n’obusozi ne bulabika bulungi nga bweyagala.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Amalundiro gajjula ebisibo,","poem":1},{"text":"n’ebiwonvu ne bijjula emmere ey’empeke.","poem":2},{"lineBreak":true},{"text":"Ensi yonna eyimba mu ddoboozi ery’omwanguka ng’ejjudde essanyu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}