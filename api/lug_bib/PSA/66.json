{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":66,"content":[{"type":"hebrew_subtitle","content":["Ya mukulu wa bayimbi. Oluyimba, Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Yimbira Mukama n’eddoboozi ery’omwanguka, ggwe ensi yonna.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Muyimbe ekitiibwa ky’erinnya lye.","poem":2},{"lineBreak":true},{"text":"Mumuyimbire ennyimba ezimusuuta.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gamba Katonda nti, “Ebikolwa byo nga bya ntiisa!","poem":1},{"text":"Olw’amaanyi go amangi","poem":2},{"lineBreak":true},{"text":"abalabe bo bakujeemulukukira.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ab’omu nsi yonna bakuvuunamira,","poem":1},{"text":"bakutendereza,","poem":2},{"lineBreak":true},{"text":"bayimba nga bagulumiza erinnya lyo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mujje mulabe Katonda ky’akoze;","poem":1},{"text":"mulabe eby’entiisa by’akoledde abaana b’abantu!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ennyanja yagifuula olukalu.","poem":1},{"text":"Abantu baasomoka omugga n’ebigere nga temuli mazzi,","poem":2},{"lineBreak":true},{"text":"kyetuva tujaguza.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Afuga n’amaanyi ge emirembe gyonna;","poem":1},{"text":"amaaso ge agasimba ku mawanga,","poem":2},{"lineBreak":true},{"text":"ab’omutima omujeemu baleme okumujeemera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mutendereze Katonda waffe, mmwe amawanga;","poem":1},{"text":"eddoboozi ery’okumutendereza liwulirwe wonna.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Oyo y’atukuumye ne tuba balamu,","poem":1},{"text":"n’ataganya bigere byaffe kuseerera.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kubanga ggwe, Ayi Katonda, otugezesezza,","poem":1},{"text":"n’otulongoosa nga bwe bakola ffeeza mu muliro.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Watuteeka mu kkomera,","poem":1},{"text":"n’otutikka emigugu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Waleka abantu ne batulinnyirira;","poem":1},{"text":"ne tuyita mu muliro ne mu mazzi,","poem":2},{"lineBreak":true},{"text":"n’otutuusa mu kifo eky’okwesiima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nnaayambukanga mu yeekaalu yo n’ebiweebwayo ebyokebwa,","poem":1},{"text":"ntuukirize obweyamo bwange gy’oli,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"nga ndeeta ekyo emimwa gyange kye gyasuubiza;","poem":1},{"text":"akamwa kange kye kaayogera bwe nnali mu kabi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nnaawaayo gy’oli ssaddaaka ez’ensolo ensava,","poem":1},{"text":"mpeeyo ne ssaddaaka ey’endiga ennume;","poem":2},{"lineBreak":true},{"text":"mpeeyo ente ennume n’embuzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mujje muwulire, mmwe mwenna abatya Katonda,","poem":1},{"text":"mbategeeze ebyo by’ankoledde.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Namukaabirira n’akamwa kange,","poem":1},{"text":"ne mutendereza n’olulimi lwange.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Singa nnali nsirikidde ekibi mu mutima gwange,","poem":1},{"text":"Mukama teyandimpulirizza;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ddala ddala Katonda yampuliriza era n’awulira eddoboozi lyange nga nsaba.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Katonda atenderezebwenga,","poem":1},{"text":"atagobye kusaba kwange,","poem":2},{"lineBreak":true},{"text":"wadde okunziggyako okwagala kwe okutaggwaawo!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}