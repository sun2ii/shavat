rezenga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ensi erireeta amakungula gaayo;","poem":1},{"text":"era Katonda, Katonda waffe, anaatuwanga omukisa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Katonda anaatuwanga omukisa;","poem":1},{"text":"n’enkomerero z’ensi zinaamutyanga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}