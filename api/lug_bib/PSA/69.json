{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":69,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Mu ddoboozi ery’Amalanga. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Ondokole, Ayi Katonda,","poem":1},{"text":"kubanga amazzi gandi mu bulago.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ntubira mu bitosi","poem":1},{"text":"nga sirina we nnywereza kigere.","poem":2},{"text":"Ntuuse ebuziba","poem":1},{"text":"n’amataba gansaanikira.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ndajanye ne nkoowa,","poem":1},{"text":"n’emimiro ginkaze.","poem":2},{"text":"Amaaso ganzizeeko ekifu gakooye","poem":1},{"text":"olw’okutunula enkaliriza nga nnindirira Katonda wange.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abo abankyayira obwereere","poem":1},{"text":"bangi okusinga enviiri ez’oku mutwe gwange;","poem":2},{"text":"abalabe bange bangi","poem":1},{"text":"abannoonya okunzita awatali nsonga;","poem":2},{"text":"ne mpalirizibwa mbaddizeewo","poem":1},{"text":"ekyo kye sibbanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ayi Katonda, omanyi obusirusiru bwange,","poem":1},{"text":"n’okusobya kwange tekukukwekeddwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sisaana kuswaza","poem":1},{"text":"abo abakwesiga,","poem":2},{"lineBreak":true},{"text":"Ayi Mukama, Mukama ow’Eggye.","poem":2},{"text":"Abo abakunoonya","poem":1},{"text":"baleme kuswazibwa ku lwange,","poem":2},{"lineBreak":true},{"text":"Ayi Katonda wa Isirayiri.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngumiikirizza okuvumwa ku lulwo,","poem":1},{"text":"n’amaaso gange ne gajjula ensonyi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nfuuse nga omugwira eri baganda bange,","poem":1},{"text":"munnaggwanga eri abaana ba mmange.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nzijudde obuggya olw’ennyumba yo,","poem":1},{"text":"n’abo abakuvuma bavuma nze.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bwe nkaaba ne nsiiba,","poem":1},{"text":"ekyo nakyo ne kinvumisa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bwe nnyambala ebibukutu ne nfuuka eky’okuzanyisa kyabwe.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Abo abatuula ku mulyango gw’ekibuga banduulira,","poem":1},{"text":"era nfuuse luyimba lw’abatamiivu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Naye nze, Ayi Mukama, nsaba ggwe,","poem":1},{"text":"mu kiseera eky’ekisa kyo.","poem":2},{"text":"Olw’okwagala kwo okungi, onnyanukule, Ayi Katonda,","poem":1},{"text":"ondokole nga bwe wasuubiza.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Onnyinyulule mu ttosi","poem":1},{"text":"nneme okutubira;","poem":2},{"text":"omponye abankyawa,","poem":1},{"text":"onzigye mu mazzi amangi;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"amataba galeme okumbuutikira","poem":1},{"text":"n’obuziba okunsanyaawo,","poem":2},{"lineBreak":true},{"text":"n’ennyanja ereme okummira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Onnyanukule, Ayi Mukama olw’obulungi bw’okwagala kwo;","poem":1},{"text":"onkyukire olw’okusaasira kwo okungi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tokisa muddu wo maaso go; yanguwa okunziramu,","poem":1},{"text":"kubanga ndi mu kabi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Onsemberere onziruukirire,","poem":1},{"text":"onnunule mu balabe bange.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Omanyi bwe nsekererwa, ne bwe nswazibwa ne bwe siteekebwamu kitiibwa,","poem":1},{"text":"era n’abalabe bange bonna obamanyi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Okusekererwa kunkutudde omutima","poem":1},{"text":"era kummazeemu amaanyi.","poem":2},{"text":"Nanoonya okusaasirwa ne kumbula,","poem":1},{"text":"n’ow’okumpooyawooya naye nga simulaba.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mu kifo ky’emmere bampa mususa,","poem":1},{"text":"era bwe nalumwa ennyonta bampa nkaatu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Emmere yaabwe gye bategese okulya ebafuukire ekyambika,","poem":1},{"text":"n’embaga zaabwe ez’ebiweebwayo zibafuukire omutego.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Amaaso gaabwe gazibe baleme okulaba,","poem":1},{"text":"n’emigongo gyabwe gyewetenga ennaku zonna.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bayiweeko ekiruyi kyo,","poem":1},{"text":"obamalewo n’obusungu obw’amaanyi go obungi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ebifo byabwe bifuuke bifulukwa,","poem":1},{"text":"waleme kubaawo n’omu abeera mu weema zaabwe.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kubanga bayigganya oyo gw’ofumise,","poem":1},{"text":"ne boogera ku bulumi bw’oyo gw’olumizza.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bavunaane omusango kina gumu,","poem":1},{"text":"era tobaganya kugabana ku bulokozi bwo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Bawanduukululwe mu kitabo ky’obulamu;","poem":1},{"text":"baleme kulabika ku lukalala lw’abatuukirivu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ndi mu bulumi era mu nnaku;","poem":1},{"text":"obulokozi bwo, Ayi Katonda, bunkuume.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Nnaatenderezanga erinnya lya Katonda nga nnyimba;","poem":1},{"text":"nnaamugulumizanga n’okwebaza.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kino kinaasanyusanga Mukama okusinga okumuwa ente ennume,","poem":1},{"text":"oba okumuwa seddume n’amayembe gaayo, n’ebigere byayo.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Abaavu banaakirabanga ne basanyuka;","poem":1},{"text":"mmwe abanoonya Katonda omutima gwammwe ne gubeera omulamu.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Kubanga Mukama awulira abo abali mu kwetaaga,","poem":1},{"text":"era ababe ne bwe baba mu busibe, tabanyooma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Kale eggulu n’ensi bimutenderezenga","poem":1},{"text":"awamu n’ennyanja zonna n’ebyo ebizirimu.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Kubanga Katonda alirokola Sayuuni,","poem":1},{"text":"n’ebibuga bya Yuda n’abizimba buggya,","poem":2},{"text":"abantu ne babibeerangamu nga byabwe.","poem":1}]},{"type":"verse","number":36,"content":[{"text":"Abaana b’abaweereza be balikisikira;","poem":2},{"lineBreak":true},{"text":"n’abo abaagala erinnya lya Mukama omwo mmwe banaabeeranga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}