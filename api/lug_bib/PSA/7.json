{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":7,"content":[{"type":"hebrew_subtitle","content":["Zabbuli ya Dawudi gye yayimbira Mukama ng’efa ku Kuusi Omubenyamini."]},{"type":"verse","number":1,"content":[{"text":"Ayi Mukama, Katonda wange, neesiga ggwe:","poem":1},{"text":"ngobaako bonna abangigganya era omponye,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"si kulwa nga bantagulataagula ng’empologoma","poem":1},{"text":"ne bankutulakutula obufiififi ne watabaawo amponya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ayi Mukama, Katonda wange, obanga nkoze kino,","poem":1},{"text":"era ng’engalo zange ziriko omusango,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"obanga waliwo andaze ebirungi nze ne si muyisa bulungi,","poem":1},{"text":"oba nzibye omulabe wange awatali nsonga:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kale, abalabe bange baleke bangoberere bankwate,","poem":1},{"text":"bankube wansi banninnyirire,","poem":2},{"lineBreak":true},{"text":"banzitire mu nfuufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Golokoka, Ayi Mukama, mu busungu bwo oziyize abalabe bange abajjudde obukambwe.","poem":1},{"text":"Golokoka, Ayi Katonda wange,","poem":2},{"lineBreak":true},{"text":"onnyambe ggwe asala omusango mu bwenkanya.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kuŋŋaanya bannaggwanga bonna okukwetooloola;","poem":1},{"text":"obafuge ng’oli waggulu ennyo.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ggwe, Ayi Mukama, Ali Waggulu Ennyo,","poem":2},{"lineBreak":true},{"text":"asalira amawanga gonna emisango,","poem":2},{"text":"osale omusango gwange Ayi Mukama Ali Waggulu Ennyo ng’obutuukirivu bwange bwe buli,","poem":1},{"text":"era n’amazima agali mu nze bwe gali.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ayi Katonda omutukuvu,","poem":1},{"text":"akebera emitima n’emmeeme;","poem":2},{"text":"okomye ebikolwa by’abakola ebibi:","poem":1},{"text":"era onyweze abatuukirivu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Katonda Ali Waggulu Ennyo ye ngabo yange;","poem":1},{"text":"alokola abo abalina omutima omulongoofu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Katonda mulamuzi wa mazima;","poem":1},{"text":"era alaga ekiruyi kye buli lunaku.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mukama awagala ekitala kye","poem":1},{"text":"n’aleega omutego gwe","poem":2},{"lineBreak":true},{"text":"ogw’obusaale.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Era ategese ebyokulwanyisa ebissi;","poem":1},{"text":"era akozesa obusaale obw’omuliro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Omuntu ajjudde ebibi afuna emitawaana,","poem":1},{"text":"n’azaala obulimba.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Asima ekinnya, n’akiwanvuya nnyo;","poem":1},{"text":"ate n’akigwamu ye kye yasimye.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Emitawaana gye gimwebunguludde;","poem":1},{"text":"n’obukambwe bwe bumuddire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Nneebazanga Mukama olw’obutuukirivu bwe;","poem":1},{"text":"nnaayimbanga nga ntendereza erinnya lya Mukama Ali Waggulu Ennyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}