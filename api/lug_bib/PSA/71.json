{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":71,"content":[{"type":"verse","number":1,"content":[{"text":"Mu ggwe, Ayi Mukama, mwe neekweka,","poem":1},{"text":"tondeka kuswazibwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mu butuukirivu bwo ondokole, omponye;","poem":1},{"text":"ontegere okutu ondokole.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Onfuukire olwazi obuddukiro bwange,","poem":1},{"text":"ekifo eky’amaanyi;","poem":2},{"text":"ondokole","poem":1},{"text":"kubanga oli lwazi lwange era ekiddukiro kyange.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ayi Katonda wange omponye mu mukono gw’ababi,","poem":1},{"text":"omponye abantu abatali batuukirivu era abakambwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kubanga ggwe, Ayi Mukama, ggwe ssuubi lyange;","poem":1},{"text":"ggwe, ggwe neesiga, okuviira ddala mu buvubuka bwange.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Neesiga ggwe kasookedde nzalibwa;","poem":1},{"text":"ggwe wanziggya mu lubuto lwa mmange.","poem":2},{"lineBreak":true},{"text":"Nnaakutenderezanga ennaku zonna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Eri abangi nafuuka;","poem":1},{"text":"naye ggwe kiddukiro kyange eky’amaanyi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Akamwa kange kajjudde ettendo lyo,","poem":1},{"text":"nga ntenda ekitiibwa kyo obudde okuziba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tonsuula mu kiseera kyange eky’obukadde.","poem":1},{"text":"Tondekerera ng’amaanyi gampweddemu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kubanga abalabe bange banjogerako;","poem":1},{"text":"abo abaagala okunzita bansalira olukwe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bagamba nti, “Katonda amulese,","poem":1},{"text":"ka tumugobe tumukwate,","poem":2},{"lineBreak":true},{"text":"kubanga taliiko anaamuwonya.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ayi Katonda, tombera wala, Ayi Katonda wange,","poem":1},{"text":"yanguwa ojje ombeere.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Abo abampawaabira bazikirizibwe nga bajjudde ensonyi,","poem":1},{"text":"abanoonya okunnumya baswale","poem":2},{"lineBreak":true},{"text":"era banyoomebwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Naye nze nnaabanga n’essuubi ennaku zonna.","poem":1},{"text":"Era nneeyongeranga okukutenderezanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Akamwa kange kanaayogeranga ku bikolwa byo eby’obutuukirivu obudde okuziba;","poem":1},{"text":"nnaayogeranga ku bulokozi bwo,","poem":2},{"lineBreak":true},{"text":"wadde siyinza kubupima.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nnaatambuliranga mu maanyi go, Ayi Mukama Katonda,","poem":1},{"text":"era ne ntegeezanga nti ggwe wekka ggwe mutuukirivu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ayi Katonda, ggwe wanjigiriza okuva mu buvubuka bwange;","poem":1},{"text":"n’okutuusa leero nkyatenda ebikolwa byo eby’ekitalo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ne bwe ndiba nga nkaddiye nga mmeze n’envi,","poem":1},{"text":"tonjabuliranga, Ayi Katonda,","poem":2},{"text":"okutuusiza ddala nga mmaze okutendera abo abaliddawo amaanyi go amangi,","poem":1},{"text":"n’okumanyisa emirembe egigenda okujja obuyinza bwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"N’obutuukirivu bwo, Ayi Katonda, butuuka mu ggulu.","poem":1},{"text":"Ggw’okoze ebikulu,","poem":2},{"lineBreak":true},{"text":"Ayi Katonda, ani akwenkana?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Newaakubadde wandeka ne mbonaabona nnyo bwe ntyo,","poem":1},{"text":"ggw’olinzizaamu obulamu,","poem":2},{"text":"n’ompa amaanyi amaggya,","poem":1},{"text":"n’onnyimusa okuva mu kinnya ekiwanvu ennyo wansi w’ensi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Olinnyongerako ekitiibwa","poem":1},{"text":"n’oddamu okunsanyusa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Nnaakutenderezanga ne nnanga ey’enkoba","poem":1},{"text":"olw’obwesigwa bwo, Ayi Katonda wange;","poem":2},{"text":"nnaakutenderezanga n’entongooli,","poem":1},{"text":"Ayi ggwe Omutukuvu wa Isirayiri.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nnaayimusanga eddoboozi lyange olw’essanyu","poem":1},{"text":"nga nkutendereza,","poem":2},{"lineBreak":true},{"text":"nze gw’onunudde!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Olulimi lwange nalwo lunaayogeranga ku bikolwa byo eby’obutuukirivu","poem":1},{"text":"obudde okuziba,","poem":2},{"text":"kubanga abo ababadde baagala okunkola akabi","poem":1},{"text":"otabuddetabudde enkwe zaabwe ne baswazibwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}