{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":72,"content":[{"type":"hebrew_subtitle","content":["Zabbuli ya Sulemaani."]},{"type":"verse","number":1,"content":[{"text":"Ayi Katonda, kabaka omuwe okuba omwenkanya,","poem":1},{"text":"ne mutabani we omuwe obutuukirivu,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"alyoke alamulenga abantu bo mu butuukirivu,","poem":1},{"text":"n’abaavu abalamulenga mu mazima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ensozi zireeterenga abantu bo okukulaakulana","poem":1},{"text":"n’obusozi bubaleetere obutuukirivu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Anaalwaniriranga abaavu,","poem":1},{"text":"n’atereeza abaana b’abo abeetaaga,","poem":2},{"lineBreak":true},{"text":"n’omujoozi n’amusaanyaawo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abantu bakutyenga ng’enjuba n’omwezi gye bikoma","poem":1},{"text":"okwaka mu mirembe gyonna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abeere ng’enkuba bw’etonnya ku muddo ogusaliddwa,","poem":1},{"text":"afaanane ng’oluwandaggirize olufukirira ensi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Obutuukirivu bweyongere nnyo mu mulembe gwe,","poem":1},{"text":"n’okufuga kwe kujjule emirembe okutuusa omwezi lwe gulikoma okwaka!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Afugenga okuva ku nnyanja okutuuka ku nnyanja,","poem":1},{"noteId":11},{"text":"n’okuva ku mugga Fulaati","poem":2},{"noteId":12},{"text":"okutuuka ku nkomerero z’ensi!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ebika eby’omu malungu bimugonderenga,","poem":1},{"text":"n’abalabe be bamujeemulukukire beekulukuunye ne mu nfuufu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bakabaka b’e Talusiisi","poem":1},{"noteId":13},{"text":"n’ab’oku bizinga eby’ewala","poem":1},{"text":"bamuwenga omusolo;","poem":2},{"text":"bakabaka b’e Syeba n’ab’e Seeba","poem":1},{"noteId":14},{"text":"bamutonerenga ebirabo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bakabaka bonna banaavuunamanga mu maaso ge;","poem":1},{"text":"amawanga gonna ganaamuweerezanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kubanga anaawonyanga eyeetaaga bw’anaamukoowoolanga,","poem":1},{"text":"n’omwavu ne kateeyamba ataliiko mwasirizi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Anaasaasiranga omunafu n’omwavu;","poem":1},{"text":"n’awonya obulamu bwa kateeyamba.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Anaabanunulanga mu mikono gy’omujoozi n’abawonya obukambwe bwe;","poem":1},{"text":"kubanga obulamu bwabwe bwa muwendo mungi gy’ali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Awangaale!","poem":1},{"text":"Aleeterwe zaabu okuva e Syeba.","poem":2},{"text":"Abantu bamwegayiririrenga","poem":1},{"text":"era bamusabirenga emikisa buli lunaku.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Eŋŋaano ebale nnyingi nnyo mu nsi,","poem":1},{"text":"ebikke n’entikko z’ensozi.","poem":2},{"text":"Ebibala byayo byale ng’eby’e Lebanooni;","poem":1},{"text":"n’abantu baale mu bibuga ng’omuddo ogw’oku ttale.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Erinnya lye libeerengawo ennaku zonna,","poem":1},{"text":"n’okwatiikirira kwe kube kwa nkalakkalira ng’enjuba.","poem":2},{"lineBreak":true},{"text":"Amawanga gonna ganaaweebwanga omukisa ku lu lw’erinnya lye,","poem":1},{"text":"era abantu bonna bamuyitenga aweereddwa omukisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mukama Katonda agulumizibwe, Katonda wa Isirayiri,","poem":1},{"text":"oyo yekka akola ebyewuunyisa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Erinnya lye ekkulu ligulumizibwenga emirembe n’emirembe!","poem":1},{"text":"Ensi yonna ejjule ekitiibwa kye.","poem":2},"Amiina era Amiina!"]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Okusaba kwa Dawudi mutabani wa Yese kukomye awo.","poem":1}]}],"footnotes":[{"noteId":11,"caller":"+","text":"Kyalowoozebwanga nti ensi yakomanga ku Nnyanja ey’Omunnyo okumpi n’Ennyanja Ennene, eya Meditereniyaani.","reference":{"chapter":72,"verse":8}},{"noteId":12,"caller":"+","text":"Omugga Fulaati gwe gwali ensalo ku luuyi olw’ebuvanjuba bwa Isirayiri, mu bufuzi bwa Sulemaani. Kyali kyasuubizibwa Abayisirayiri mu biro eby’okuva mu Misiri.","reference":{"chapter":72,"verse":8}},{"noteId":13,"caller":"+","text":"Talusiisi kyali mu Esupaniya, era eyo ye yalowoozebwa okuba enkomerero y’ensi.","reference":{"chapter":72,"verse":10}},{"noteId":14,"caller":"+","text":"Syeba kiri mu Buwalabu, ate Seeba kiri mu Afirika.","reference":{"chapter":72,"verse":10}}]},"thisChapterLink":"/api/lug_bib/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}