{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":73,"content":[{"type":"hebrew_subtitle","content":["Zabbuli ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Ddala Katonda mulungi eri Isirayiri","poem":1},{"text":"n’eri abo abalina omutima omulongoofu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Naye nze amagulu gange gaali kumpi okutagala","poem":1},{"text":"era n’ebigere byange okuseerera.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kubanga nakwatirwa ab’amalala obuggya;","poem":1},{"text":"bwe nalaba ababi nga bagaggawala nnyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kubanga tebalina kibaluma;","poem":1},{"text":"emibiri gyabwe miramu era minyirivu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tebeeraliikirira kabi konna ng’abalala.","poem":1},{"text":"So tebalina kibabonyaabonya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amalala kyegavudde gabafuukira ng’omukuufu ogw’omu bulago,","poem":1},{"text":"n’obukambwe ne bubafuukira ekyambalo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bagezze n’amaaso gaabwe ne gazimbagatana;","poem":1},{"text":"balina bingi okusinga bye beetaaga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Baduula era emboozi zaabwe zijjudde eby’okujooga.","poem":1},{"text":"Batiisatiisa abalala n’okubeeragirako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Emimwa gyabwe gyolekedde eggulu;","poem":1},{"text":"n’ennimi zaabwe zoogera eby’okwewaanawaana buli wantu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abantu ba Katonda kyebava babakyukira","poem":1},{"text":"ne banywa amazzi mangi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Era ne beebuuza nti, “Katonda bino abimanyi atya?","poem":1},{"text":"Ali Waggulu Ennyo abitegeera?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Aboonoonyi bwe bafaanana bwe batyo;","poem":1},{"text":"bulijjo babeera mu ddembe, nga beeyongera kugaggawala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ddala omutima gwange ngukuumidde bwereere obutayonoona,","poem":1},{"text":"n’engalo zange ne nzinaaba obutaba na musango.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Naye mbonaabona obudde okuziba,","poem":1},{"text":"era buli nkya mbonerezebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Singa ŋŋamba nti njogere bwe nti,","poem":1},{"text":"nandibadde mukuusa eri omulembe guno ogw’abaana bo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bwe nafumiitiriza ntegeere ensonga eyo;","poem":1},{"text":"nakisanga nga kizibu nnyo,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"okutuusa lwe nalaga mu watukuvu wa Katonda,","poem":1},{"text":"ne ntegeera enkomerero y’ababi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ddala obatadde mu bifo ebiseerera;","poem":1},{"text":"obasudde n’obafaafaaganya.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nga bazikirizibwa mangu nga kutemya kikowe!","poem":1},{"text":"Entiisa n’ebamalirawo ddala!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bali ng’omuntu azuukuse n’ategeera nti yaloose buloosi;","poem":1},{"text":"era naawe bw’otyo, Ayi Mukama,","poem":2},{"lineBreak":true},{"text":"bw’oligolokoka olinyooma embeera yaabwe omutali nsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Omutima gwange bwe gwanyiikaala,","poem":1},{"text":"n’omwoyo gwange ne gujjula obubalagaze,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"n’aggwaamu okutegeera ne nfuuka ataliiko kye mmanyi,","poem":1},{"text":"ne mba ng’ensolo obusolo mu maaso go.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Newaakubadde ebyo biri bwe bityo naye ndi naawe bulijjo;","poem":1},{"text":"gw’onkwata ku mukono gwange ogwa ddyo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mu kuteesa kwo onkulembera,","poem":1},{"text":"era olintuusa mu kitiibwa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ani gwe nnina mu ggulu, wabula ggwe?","poem":1},{"text":"Era tewali na kimu ku nsi kye neetaaga bwe mba naawe.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Omubiri gwange n’omutima gwange biyinza okulemwa;","poem":1},{"text":"naye Katonda ge maanyi g’omutima gwange,","poem":2},{"lineBreak":true},{"text":"era ye wange ennaku zonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Kale laba, abo bonna abatakussaako mwoyo balizikirira;","poem":1},{"text":"kubanga bonna abatakwesiga obamalirawo ddala.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Naye nze kye nsinga okwetaaga kwe kubeera okumpi ne Katonda wange.","poem":1},{"text":"Ayi Mukama Katonda, nkufudde ekiddukiro kyange;","poem":2},{"lineBreak":true},{"text":"ndyoke ntegeezenga abantu bonna ebikolwa byo eby’ekyewuunyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}