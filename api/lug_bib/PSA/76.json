{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Eyimbibwa n’ebivuga eby’enkoba. Zabbuli ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Katonda amanyiddwa mu Yuda;","poem":1},{"text":"erinnya lye kkulu mu Isirayiri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Eweema ye eri mu Yerusaalemi;","poem":1},{"text":"era abeera mu Sayuuni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Eyo gy’asinziira n’amenyaamenya obusaale bw’omulabe obujja bwesooza;","poem":1},{"text":"n’engabo n’ebitala n’ebyokulwanyisa byonna eby’olutalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Owa ekitangaala,","poem":1},{"text":"oli wa kitiibwa okusinga ensozi ennene eziriko ensolo eziyiggibwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ab’amaanyi bagalamira nga banyaguluddwa,","poem":1},{"text":"beebaka ne batasobola kugolokoka,","poem":2},{"text":"ne watabaawo n’omu asobola","poem":1},{"text":"okuyimusa omukono gwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bw’obaboggolera, Ayi Katonda wa Yakobo,","poem":1},{"text":"abeebagala embalaasi ezisika ebigaali bagwiira wamu n’ebigaali ne batagolokoka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ggwe ayi Katonda, osaanira okutiibwanga.","poem":1},{"text":"Ani ayinza okuyimirira mu maaso go ng’osunguwadde?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Osalira abantu emisango ng’osinziira mu ggulu,","poem":1},{"text":"ensi n’etya n’ekankana n’esirika olw’obusungu bwo,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"bw’ogolokoka okusala omusango,","poem":1},{"text":"okuwonya ababonyaabonyezebwa mu nsi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bw’osunguwalira omuntu kikuleetera okutenderezebwa,","poem":1},{"text":"n’abo b’otasunguwalidde ne beegendereza.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mweyame obweyamo bwammwe eri Mukama Katonda wammwe, era mubutuukirizenga;","poem":1},{"text":"bonna abamuli okumpi bamuleetere ebirabo,","poem":2},{"lineBreak":true},{"text":"kubanga asaanidde okutiibwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mukama akkakkanya abalangira,","poem":1},{"text":"ne bakabaka b’ensi bamutya.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}