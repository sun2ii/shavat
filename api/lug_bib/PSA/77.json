{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":77,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Nnaakaabirira Katonda ambeere,","poem":1},{"text":"ddala nnaakaabirira Katonda nga musaba ampulire.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bwe nnali mu nnaku, nanoonya Mukama,","poem":1},{"text":"ekiro kyonna ne ngolola emikono gyange obutakoowa;","poem":2},{"lineBreak":true},{"text":"emmeeme yange neegaana okusanyusibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nakujjukiranga, Ayi Katonda ne nsinda,","poem":1},{"text":"ne nfumiitiriza emmeeme yange n’ezirika.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tewaŋŋanya kwebaka; natawaanyizibwa nnyo ne sisobola kwogera.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ne ndowooza ku biseera eby’edda,","poem":1},{"text":"ne nzijukira emyaka egyayita.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Najjukiranga ennyimba zange ekiro,","poem":1},{"text":"ne nfumiitiriza nga bwe neebuuza mu mutima gwange nti:","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Mukama anaatusuuliranga ddala ennaku zonna","poem":1},{"text":"naataddayo kutulaga kisa kye?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Okwagala kwe okutaggwaawo kukomedde ddala?","poem":1},{"text":"Kye yasuubiza kibulidde ddala emirembe n’emirembe?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Katonda yeerabidde ekisa kye?","poem":1},{"text":"Asunguwalidde ddala ne yeggyako n’okusaasira kwe?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Awo ne ndowooza nti, “Ebyo bye mmanyi","poem":1},{"text":"eby’emyaka emingi eby’omukono ogwa ddyo ogw’oyo Ali Waggulu Ennyo.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nnajjukiranga ebikolwa bya Mukama,","poem":1},{"text":"weewaawo, nnajjukiranga ebyamagero byo eby’edda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nnaafumiitirizanga ku bikolwa byo byonna eby’amaanyi;","poem":1},{"text":"nnaalowoozanga ku byamagero byo byonna.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ekkubo lyo, Ayi Katonda, liri mu watukuvu.","poem":1},{"text":"Tewali katonda yenkana Katonda waffe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ggwe Katonda akola eby’amagero;","poem":1},{"text":"era amaanyi go ogalaga mu mawanga.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wanunula abantu bo n’omukono gwo,","poem":1},{"text":"abazzukulu ba Yakobo ne Yusufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Amazzi gaakulaba, Ayi Katonda;","poem":1},{"text":"amazzi bwe gaakulaba ne gatya,","poem":2},{"lineBreak":true},{"text":"n’obuziba ne bukankanira ddala.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ebire byayiwa amazzi","poem":1},{"text":"ne bivaamu n’okubwatuka,","poem":2},{"lineBreak":true},{"text":"era n’obusaale bwo ne bubuna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Eddoboozi lyo ery’okubwatuka lyawulirwa mu kikuŋŋunta","poem":1},{"text":"okumyansa kwo ne kumulisa ensi.","poem":2},{"lineBreak":true},{"text":"Ensi n’ekankana n’enyeenyezebwa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ekkubo lyo lyali mu nnyanja;","poem":1},{"text":"wayita mu mazzi amangi,","poem":2},{"lineBreak":true},{"text":"naye ebigere mwe walinnya tebyalabika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Wakulembera abantu bo ng’ekisibo,","poem":1},{"text":"nga bali mu mikono gya Musa ne Alooni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}