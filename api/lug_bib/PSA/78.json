{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":78,"content":[{"type":"hebrew_subtitle","content":["Oluyimba lwa Asafu."]},{"type":"verse","number":1,"content":[{"text":"Muwulire okuyigiriza kwange mmwe abantu bange,","poem":1},{"text":"musseeyo omwoyo ku bye njogera.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ndyogerera mu ngero,","poem":1},{"text":"njogere ebintu eby’ekyama ebyaliwo edda,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ebintu bye twawulira ne tumanya;","poem":1},{"text":"ebintu bajjajjaffe bye baatutegeeza.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tetuubikisenga baana baabwe,","poem":1},{"text":"naye tunaabuuliranga buli mulembe ogunnaddangawo","poem":2},{"text":"ebikolwa bya Mukama eby’ekitalo,","poem":1},{"text":"n’amaanyi ge n’ebyamagero bye yakola.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawa Yakobo ebiragiro,","poem":1},{"text":"n’ateeka amateeka mu Isirayiri;","poem":2},{"text":"n’alagira bajjajjaffe","poem":1},{"text":"babiyigirizenga abaana baabwe,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ab’omu mulembe oguliddirira nabo babimanye,","poem":1},{"text":"n’abaana abalizaalibwa,","poem":2},{"lineBreak":true},{"text":"nabo babiyigirize abaana baabwe,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"balyoke beesigenga Katonda,","poem":1},{"text":"era balemenga okwerabira ebyo byonna Katonda bye yakola;","poem":2},{"lineBreak":true},{"text":"naye bagonderenga ebiragiro bye.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Baleme okuba nga bajjajjaabwe,","poem":1},{"text":"omulembe ogw’abakakanyavu","poem":2},{"text":"era abajeemu abatali bawulize,","poem":1},{"text":"ab’emyoyo egitali myesigwa eri Katonda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abaana ba Efulayimu abaalina obusaale obw’okulwanyisa,","poem":1},{"text":"naye ne badduka mu lutalo,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"tebaatuukiriza ndagaano ya Katonda;","poem":1},{"text":"ne bagaana okugondera amateeka ga Mukama.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Beerabira ebyo bye yakola,","poem":1},{"text":"n’ebyamagero bye yabalaga.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yakola ebyamagero mu maaso ga bajjajjaabwe nga bali","poem":1},{"text":"mu nsi y’e Misiri, mu kitundu kya Zowani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ennyanja yajaawulamu,","poem":1},{"text":"amazzi ne geetuuma ebbali n’ebbali ng’ebisenge.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Emisana yabakulemberanga n’ekire,","poem":1},{"text":"n’ekiro n’abakulemberanga n’empagi ey’omuliro.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yayasa enjazi mu ddungu,","poem":1},{"text":"n’abawa amazzi amangi agaali ng’agava mu buziba bw’ennyanja.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yaggya ensulo mu lwazi,","poem":1},{"text":"n’akulukusa amazzi ng’emigga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Naye bo ne beeyongera bweyongezi okwonoona,","poem":1},{"text":"ne bajeemera Oyo Ali Waggulu Ennyo nga bali mu ddungu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ne bagezesa Katonda mu bugenderevu,","poem":1},{"text":"nga bamusaba emmere gye baalulunkanira.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Era ne boogera ku Katonda; nga bagamba nti,","poem":1},{"text":"“Katonda asobola okutuliisiza mu ddungu?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Weewaawo yakuba olwazi,","poem":1},{"text":"amazzi ne gakulukuta ng’emigga;","poem":2},{"text":"naye anaatuwa emmere?","poem":1},{"text":"Anaawa abantu be ennyama?”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Awo Mukama bwe yawulira ebyo n’asunguwala nnyo;","poem":1},{"text":"omuliro gwe ne gwaka ku Yakobo,","poem":2},{"lineBreak":true},{"text":"n’obusungu bwe ne bubuubuukira ku Isirayiri.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kubanga tebakkiriza Katonda,","poem":1},{"text":"era tebeesiga maanyi ge agalokola.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Naye era n’alagira eggulu;","poem":1},{"text":"n’aggulawo enzigi z’omu ggulu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"N’abaweereza maanu okuva mu ggulu balye.","poem":1},{"text":"Yabawa emmere eyava mu ggulu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Abantu ne balya emmere ya bamalayika;","poem":1},{"text":"Mukama n’abawanga emmere nnyingi eyabamaliranga ddala.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"N’akunsa empewo ey’Ebuvanjuba okuva mu ggulu,","poem":1},{"text":"era n’aweereza empewo okuva obukiika obwaddyo n’amaanyi ge.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Yatonnyesa ennyama okuva mu ggulu ennyingi ennyo ng’enfuufu;","poem":1},{"text":"n’abaweereza n’obunyonyi enkumu ennyo ng’omusenyu gw’okulubalama lw’ennyanja.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ebyokulya ebyo n’abisuula wakati mu lusiisira lwabwe;","poem":1},{"text":"okwetooloola eweema zaabwe.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Awo ne balya ne bakkuta nnyo;","poem":1},{"text":"kubanga yabawa kye baali bayaayaanira.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Naye bwe baali nga bakyalulunkana,","poem":1},{"text":"nga n’emmere ekyali mu kamwa kaabwe,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"obusungu bwa Mukama ne bubabuubuukirako,","poem":1},{"text":"n’abattamu abasajja abasinga amaanyi;","poem":2},{"lineBreak":true},{"text":"abavubuka ba Isirayiri ne bazikirizibwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Naye newaakubadde ebyo byonna byabatuukako, kyokka beeyongera okwonoona;","poem":1},{"text":"newaakubadde nga yabakolera ebyamagero, naye tebakkiriza.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Mukama kyeyava asala ku myaka gyabwe,","poem":1},{"text":"n’abaleetako okuzikirizibwa okw’amangu era okw’entiisa.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Bwe yattanga abamu ku bo, ne balyoka bamunoonya,","poem":1},{"text":"ne beenenya ne badda gy’ali.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ne bajjukira nti Katonda lwe Lwazi lwabwe;","poem":1},{"text":"era nti Katonda Ali Waggulu Ennyo ye Mununuzi waabwe.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Kyokka baamuwaananga n’emimwa gyabwe,","poem":1},{"text":"nga bwe bamulimba n’ennimi zaabwe,","poem":2}]},{"type":"verse","number":37,"content":[{"text":"so tebaali beesigwa mu mitima gyabwe,","poem":1},{"text":"era nga tebatuukiriza ndagaano ye.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Naye ye n’abakwatirwanga ekisa","poem":1},{"text":"n’abasonyiwanga,","poem":2},{"lineBreak":true},{"text":"n’atabazikiriza;","poem":2},{"text":"emirundi n’emirundi ng’akoma ku busungu bwe,","poem":1},{"text":"n’atabamalirako kiruyi kye okubazikiririza ddala.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Yajjukira nga baali mubiri bubiri;","poem":1},{"text":"ng’empewo egenda n’etedda!","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Baamujeemeranga nnyo bwe baali mu ddungu;","poem":1},{"text":"ne banakuwaza nnyo omutima gwe.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Ne baddamu ne bakema Katonda,","poem":1},{"text":"ne banyiiza Omutukuvu wa Isirayiri.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Tebajjukira buyinza bwe;","poem":1},{"text":"wadde olunaku lwe yabanunulirako mu mikono gy’omulabe;","poem":2}]},{"type":"verse","number":43,"content":[{"text":"bwe yalaga obubonero bwe mu Misiri,","poem":1},{"text":"n’ebyamagero bye mu kitundu kya Zowani,","poem":2}]},{"type":"verse","number":44,"content":[{"text":"yafuula amazzi g’emigga gyabwe omusaayi,","poem":1},{"text":"ne batanywa mazzi gaagyo.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Yabaweereza agabinja g’ensowera ne zibaluma,","poem":1},{"text":"n’abaweereza n’ebikere ne bibadaaza.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Ebirime n’ebibala byabwe yabiwa enzige","poem":1},{"text":"ne bulusejjera.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Yazikiriza emizabbibu gyabwe n’omuzira,","poem":1},{"text":"era ne gukuba n’emisukomooli gyabwe.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Yatta ente zaabwe n’amayinja g’omuzira;","poem":1},{"text":"n’ebisibo byabwe ne bittibwa eraddu.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Obusungu bwe obungi bwababuubuukirako,","poem":1},{"text":"n’ekiruyi kye n’obukambwe ne bibamalamu ensa.","poem":2},{"lineBreak":true},{"text":"N’alyoka abasindikira ekibinja kya bamalayika okubazikiriza.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Yabalaga obusungu bwe,","poem":1},{"text":"n’atabasonyiwa kufa,","poem":2},{"lineBreak":true},{"text":"n’abasindikira kawumpuli.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Yatta ababereberye bonna ab’omu Misiri,","poem":1},{"text":"nga be bavubuka ab’ebibala ebibereberye eby’omu nnyumba ya Kaamu.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"N’alyoka afulumya abantu be ng’endiga,","poem":1},{"text":"n’abatambuza mu ddungu ng’ekisibo.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"N’abaluŋŋamya mu mirembe nga tebatya,","poem":1},{"text":"ennyanja n’esaanyaawo abalabe baabwe.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"N’abatuusa ku nsalo y’ensi entukuvu;","poem":1},{"text":"ku lusozi lwe yeewangulira, n’omukono gwe ogwa ddyo.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Yagobamu amawanga nga balaba,","poem":1},{"text":"n’abagabanyiza ebitundu by’ensi eyo;","poem":2},{"lineBreak":true},{"text":"n’atuuza bulungi ebika bya Isirayiri mu maka gaabyo.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Naye era ne bakema Katonda;","poem":1},{"text":"ne bamujeemera oyo Ali Waggulu Ennyo,","poem":2},{"lineBreak":true},{"text":"ne bagaana okugondera ebiragiro bye.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Ne bamuvaako ne baba bakuusa nga bajjajjaabwe bwe baali,","poem":1},{"text":"ne baggwaamu obwesigwa ng’omutego gw’obusaale omukyamu.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Kubanga baasunguwaza Katonda olw’ebifo ebigulumivu bo bye beegunjira okusinzizangamu,","poem":1},{"text":"ne bamukwasa obuggya olwa bakatonda baabwe abalala.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Katonda bwe yabiraba n’asunguwala nnyo, n’aviira ddala ku Isirayiri.","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"N’ava mu weema ey’omu Siiro","poem":1},{"noteId":15},{"text":",","poem":1},{"text":"eweema mwe yabeeranga ng’ali mu bantu be.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"N’awaayo amaanyi ge mu busibe,","poem":1},{"text":"n’ekitiibwa kye n’akiwaayo eri omulabe.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Abantu be yabaleka ne battibwa n’ekitala,","poem":1},{"text":"n’asunguwalira omugabo gwe.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Omuliro ne gusaanyaawo abavubuka baabwe abalenzi,","poem":1},{"text":"ne bawala baabwe ne babulwa ow’okubawasa.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"Bakabona baabwe battibwa n’ekitala, ne bannamwandu baabwe tebaasobola kubakungubagira.","poem":1}]},{"type":"line_break"},{"type":"verse","number":65,"content":[{"text":"Awo Mukama n’alyoka agolokoka ng’ali nga ava mu tulo,","poem":1},{"text":"ng’omusajja omuzira azuukuka mu tulo ng’atamidde.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"N’akuba abalabe be ne badduka;","poem":1},{"text":"n’abaswaza emirembe gyonna.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Mukama yaleka ennyumba ya Yusufu,","poem":1},{"text":"n’ekika kya Efulayimu n’atakironda;","poem":2}]},{"type":"verse","number":68,"content":[{"text":"naye n’alonda ekika kya Yuda,","poem":1},{"text":"lwe lusozi Sayuuni lwe yayagala.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"N’azimba awatukuvu we ne wagulumira ng’ensozi empanvu;","poem":1},{"text":"ne waba ng’ensi gye yanyweza emirembe gyonna.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"Yalonda Dawudi omuweereza we;","poem":1},{"text":"n’amuggya mu kulunda endiga.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"Ave mu kuliisa endiga,","poem":1},{"text":"naye alundenga Yakobo, be bantu be,","poem":2},{"lineBreak":true},{"text":"era alabirirenga Isirayiri omugabo gwe, gwe yeerondera.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"N’abalabirira n’omutima ogutaliimu bukuusa,","poem":1},{"text":"n’abakulembera n’amagezi g’emikono gye.","poem":2}]}],"footnotes":[{"noteId":15,"caller":"+","text":"Siiro kye kyali ekifo ekitukuvu awasinzibwanga edda mu biro bya Yoswa. Kyali mu bitundu bya Efulayimu wakati wa Beseri ne Sekemu. Essanduuko y’Endagaano yaterekebwanga eyo okutuusa mu biro bya Samwiri; kyokka Abafirisuuti baakizikiriza","reference":{"chapter":78,"verse":60}}]},"thisChapterLink":"/api/lug_bib/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":72}