,{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ayi Mukama olitusunguwalira kutuusa ddi, nnaku zonna?","poem":1},{"text":"Obuggya bwo bunaabuubuukanga ng’omuliro?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Obusungu bwo bubuubuukire ku mawanga","poem":1},{"text":"agatakumanyi,","poem":2},{"text":"ne ku bwakabaka","poem":1},{"text":"obutakoowoola linnya lyo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kubanga bazikirizza Yakobo,","poem":1},{"text":"ne basaanyaawo ensi ye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Totubalira kibi kya bajjajjaffe;","poem":1},{"text":"tukusaba oyanguwe okutusaasira","poem":2},{"lineBreak":true},{"text":"kubanga tuli mu bwetaavu bungi nnyo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tuyambe olw’ekitiibwa ky’erinnya lyo,","poem":1},{"text":"Ayi Katonda ow’obulokozi bwaffe;","poem":2},{"text":"otuwonye era otutangiririre olw’ebibi byaffe","poem":1},{"text":"olw’erinnya lyo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lwaki abamawanga babuuza nti,","poem":1},{"text":"“Katonda waabwe ali ludda wa?”","poem":2},{"lineBreak":true},{"text":"Kkiriza okuwalana eggwanga olw’omusaayi gw’abaweereza bo ogwayiyibwa,","poem":1},{"text":"kumanyibwe mu mawanga gonna nga naffe tulaba.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wuliriza okusinda kw’omusibe;","poem":1},{"text":"okozese omukono gwo ogw’amaanyi","poem":2},{"lineBreak":true},{"text":"owonye abo abasaliddwa ogw’okufa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ayi Mukama, baliraanwa baffe abakuduulira,","poem":1},{"text":"bawalane emirundi musanvu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kale nno, ffe abantu bo era endiga ez’omu ddundiro lyo,","poem":1},{"text":"tulyoke tukutenderezenga emirembe gyonna;","poem":2},{"lineBreak":true},{"text":"buli mulembe gulyoke gukutenderezenga emirembe gyonna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}