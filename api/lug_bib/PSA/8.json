{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Ayi Mukama, Mukama waffe,","poem":1},{"text":"erinnya lyo nga ddungi era kkulu nnyo mu nsi yonna!","poem":2},{"lineBreak":true},{"text":"Ekitiibwa kyo kitenderezebwa","poem":1},{"text":"okutuuka waggulu mu ggulu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abaana abato n’abawere","poem":1},{"text":"wabawa amaanyi okukutendereza;","poem":2},{"text":"ne basirisa omulabe wo","poem":1},{"text":"n’oyo ayagala okwesasuza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bwe ntunuulira eggulu lyo,","poem":1},{"text":"omulimu gw’engalo zo,","poem":2},{"text":"omwezi n’emmunyeenye","poem":1},{"text":"bye watonda;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"omuntu kye ki ggwe okumujjukira,","poem":1},{"text":"omuntu obuntu ggwe okumussaako omwoyo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kubanga wamukola n’abulako katono okuba nga Katonda;","poem":1},{"text":"n’omussaako engule ey’obukulu n’ekitiibwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wamukwasa okufuga ebintu byonna bye wakola n’emikono gyo:","poem":1},{"text":"byonna wabissa wansi w’ebigere bye,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ebisibo n’amagana ag’ebisolo byonna eby’omu nsiko,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"n’ennyonyi ez’omu bbanga,","poem":1},{"text":"n’ebyennyanja eby’omu nnyanja;","poem":2},{"lineBreak":true},{"text":"era na buli kiramu kyonna ekiyita mu nnyanja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ayi Mukama, Mukama waffe, erinnya lyo nga ddungi","poem":1},{"text":"era kkulu nnyo mu nsi yonna!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}