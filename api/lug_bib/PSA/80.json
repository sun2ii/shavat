{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":80,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Ku ddoboozi, “Amalanga g’Endagaano.” Zabbuli ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Wulira, Ayi Omusumba wa Isirayiri;","poem":1},{"text":"ggwe akulembera Yusufu ng’alunda ekisibo kyo;","poem":2},{"text":"ggwe atudde ku ntebe ey’obwakabaka mu bakerubi, twakire.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Amaanyi go galabike mu Efulayimu,","poem":2},{"text":"ne mu Benyamini ne mu Manase,","poem":1},{"noteId":16},{"text":"ojje otulokole.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tukomyewo gy’oli, Ayi Katonda,","poem":1},{"text":"otutunuulize amaaso ag’ekisa,","poem":2},{"lineBreak":true},{"text":"otulokole.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ayi Katonda, Mukama ow’Eggye,","poem":1},{"text":"olituusa ddi okusunguwalira okusaba kw’abantu bo?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wabaliisa emmere ejjudde amaziga;","poem":1},{"text":"n’obanywesa ebikopo by’amaziga musera.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Otufudde eky’okusekererwa mu baliraanwa baffe,","poem":1},{"text":"n’abalabe baffe ne batuduulira.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tukomyewo gy’oli, Ayi Mukama ow’Eggye,","poem":1},{"text":"otutunuulize amaaso go ag’ekisa,","poem":2},{"lineBreak":true},{"text":"tulokolebwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Waleeta omuzabbibu ng’oguggya mu Misiri;","poem":1},{"text":"n’ogobamu amawanga agaali mu nsi muno n’ogusimba.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wagulongooseza ettaka, ne gumera,","poem":1},{"text":"emirandira ne ginywera bulungi, ne gwagaagala mu nsi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ekisiikirize kyagwo ne kibikka ensozi,","poem":1},{"text":"n’amatabi gaagwo ne gaba ng’emivule egy’amaanyi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amatabi gaagwo ne gatuuka ku Nnyanja eya Wakati","poem":1},{"text":"n’amatabi g’ennyanja gaayo ne gatuuka ku Mugga Fulaati.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kale wamenyera ki ebisenge byagwo,","poem":1},{"text":"abayitawo bonna ne beenogera ebibala byagwo?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Embizzi ez’omu kibira zigwonoona,","poem":1},{"text":"na buli nsolo ey’omu nsiko egulya.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tukyukire, Ayi Katonda ow’Eggye,","poem":1},{"text":"otunuulire ensi ng’osinziira mu ggulu;","poem":2},{"text":"olabirire omuzabbibu guno.","poem":1}]},{"type":"verse","number":15,"content":[{"text":"Gwe wagwesimbira n’omukono gwo ogwa ddyo,","poem":2},{"lineBreak":true},{"text":"era ggwe weerondera omwana wo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bagutemye, ne bagwokya omuliro;","poem":1},{"text":"abakoze ekyo banenye mu bukambwe, obazikirize.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Naye muwe amaanyi omusajja oyo gw’oyagala","poem":1},{"text":"era omwana oyo gwe weerondera.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bwe tutyo tuleme okukuvaako, n’okukukuba amabega.","poem":1},{"text":"Otuzzeemu amaanyi, naffe tunaakoowoolanga erinnya lyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Otukomyewo gy’oli, Ayi Mukama Katonda ow’Eggye,","poem":1},{"text":"otutunuulize amaaso go ag’ekisa,","poem":2},{"lineBreak":true},{"text":"tulyoke tulokolebwe.","poem":2}]}],"footnotes":[{"noteId":16,"caller":"+","text":"Ebika ebyo ebisatu, bazzukulu ba Lakeeri; baagoberera Essanduuko y’Endagaano nga bakumba okulaga mu nsi ensuubize.","reference":{"chapter":80,"verse":2}}]},"thisChapterLink":"/api/lug_bib/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}