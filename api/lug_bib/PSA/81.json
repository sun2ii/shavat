{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":81,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Mumuyimbire nnyo n’essanyu Katonda amaanyi gaffe;","poem":1},{"text":"muyimuse waggulu amaloboozi gammwe eri Katonda wa Yakobo!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mutandike okuyimba, mukube ebitaasa","poem":1},{"text":"n’ennanga evuga obulungi ey’enkoba awamu n’entongooli.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mufuuwe eŋŋombe ng’omwezi gwakaboneka,","poem":1},{"text":"era mugifuuwe nga gwa ggabogabo, ku lunaku olw’embaga yaffe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ekyo kye kiragiro eri Isirayiri,","poem":1},{"text":"lye tteeka lya Katonda wa Yakobo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yaliteekera Yusufu,","poem":1},{"text":"Katonda bwe yalumba ensi ya Misiri;","poem":2},{"lineBreak":true},{"text":"gye nawulirira olulimi olwannema okutegeera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Nnamutikkula omugugu okuva ku kibegabega kye;","poem":1},{"text":"n’emikono gye ne ngiwummuza okusitula ebisero.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mwankoowoola nga muli mu nnaku ne mbadduukirira ne mbawonya,","poem":1},{"text":"nabaanukulira mu kubwatuka mu kire;","poem":2},{"lineBreak":true},{"text":"ne mbagezesa ku mazzi ag’e Meriba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Muwulire, mmwe abantu bange, nga mbalabula.","poem":1},{"text":"Singa onompuliriza, ggwe Isirayiri!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Temubeeranga na katonda mulala,","poem":1},{"text":"wadde okuvuunamira katonda omulala yenna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nze Mukama Katonda wo,","poem":1},{"text":"eyakuggya mu nsi y’e Misiri.","poem":2},{"lineBreak":true},{"text":"Yasamya akamwa ko, nange nnaakajjuza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Naye abantu bange tebampuliriza;","poem":1},{"text":"Isirayiri teyaŋŋondera.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nange ne mbawaayo eri obujeemu bw’omutima gwabwe,","poem":1},{"text":"okugoberera ebyo bye baagala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Singa abantu bange bampuliriza;","poem":1},{"text":"singa Isirayiri agondera ebiragiro byange,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"mangwago nandirwanyisizza abalabe baabwe,","poem":1},{"text":"ne mbawangula.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Abo abakyawa Mukama ne beegonza gy’ali;","poem":1},{"text":"ekibonerezo kyabwe kya mirembe gyonna.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Naye ggwe, Isirayiri, nandikuliisizza eŋŋaano esingira ddala obulungi,","poem":1},{"text":"ne nkukkusa omubisi gw’enjuki nga guva mu lwazi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}