{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["Zabbuli ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Katonda akubiriza olukiiko lwe olukulu olw’omu ggulu,","poem":1},{"text":"ng’alamula bakatonda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mulituusa ddi okusala emisango n’obukuusa,","poem":1},{"text":"nga musalira abanafu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abanafu n’abatalina bakitaabwe mubalamulenga mu bwenkanya;","poem":1},{"text":"abaavu n’abanyigirizibwa mubayambenga mu bwenkanya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mulwanirire abatalina maanyi n’abali mu kwetaaga, mubawonye;","poem":1},{"text":"mubanunule nga mubaggya mu mikono gy’ababi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tebalina kye bamanyi, era tebategeera.","poem":1},{"text":"Batambulira mu kizikiza;","poem":2},{"lineBreak":true},{"text":"emisingi gy’ensi gyonna ginyeenyezebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Njogedde nti, Muli bakatonda,","poem":1},{"text":"era mwenna muli baana b’oyo Ali Waggulu Ennyo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Naye mugenda kufa ng’abantu obuntu;","poem":1},{"text":"muliggwaawo ng’abafuzi abalala bonna bwe baggwaawo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ogolokoke, Ayi Katonda, olamule ensi;","poem":1},{"text":"kubanga amawanga gonna gago.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}