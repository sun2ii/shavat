{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":83,"content":[{"type":"hebrew_subtitle","content":["Oluyimba. Zabbuli ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Ayi Katonda, tosirika busirisi n’etebaayo kanyego.","poem":1},{"text":"Tosirika, Ayi Katonda, n’otobaako ky’okola.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wuliriza oluyoogaano oluva mu balabe bo;","poem":1},{"text":"abo abaagala okukulwanyisa bali mu keetalo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bateesa n’obujagujagu okulumba abantu bo;","poem":1},{"text":"basalira enkwe abo b’oyagala ennyo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bagamba nti, “Mujje eggwanga lyabwe tulizikirize,","poem":1},{"text":"n’erinnya lya Isirayiri lireme okujjukirwanga emirembe gyonna!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Basala olukwe n’omwoyo gumu;","poem":1},{"text":"beegasse wamu bakulwanyise.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abantu b’omu weema za Edomu, n’ez’Abayisimayiri,","poem":1},{"text":"n’eza Mowaabu, n’Abakagale;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gebali ne Amoni, ne Amaleki,","poem":1},{"text":"n’Abafirisuuti n’abantu b’omu Ttuulo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Era ne Asiriya yeegasse nabo,","poem":1},{"text":"okuyamba bazzukulu ba Lutti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bakoleko nga bwe wakola Midiyaani,","poem":1},{"text":"era nga bwe wakola Sisera ne Yabini","poem":2},{"noteId":17},{"text":"ku mugga Kisoni,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"abaazikiririra mu Endoli","poem":1},{"text":"ne bafuuka ng’obusa ku ttaka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abakungu baabwe bafuule nga Olebu ne Zeebu,","poem":1},{"noteId":18},{"text":"n’abalangira baabwe bonna bafuuke nga Zeba ne Zalumunna,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"abaagamba nti, “Ka tutwale","poem":1},{"text":"amalundiro ga Katonda, tugeefunire.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ayi Katonda wange, bafuumuule ng’enfuufu,","poem":1},{"text":"obasaasaanye ng’ebisusunku mu mbuyaga.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ng’omuliro bwe gwokya ekibira;","poem":1},{"text":"n’ennimi z’omuliro ne zikoleeza ensozi,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"naawe bw’otyo bw’oba obawondera n’omuyaga gwo,","poem":1},{"text":"obatiise ne kibuyaga wo ow’amaanyi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Baswaze nnyo,","poem":1},{"text":"balyoke banoonyenga erinnya lyo, Ayi Mukama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Bajjule ensonyi n’okutya,","poem":1},{"text":"bazikirire nga baswadde nnyo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Balyoke bategeere nti, Ggwe wekka, Ayi Mukama, ggw’oyitibwa Yakuwa,","poem":1},{"text":"gw’obeera waggulu ennyo ng’ofuga ensi yonna.","poem":2}]}],"footnotes":[{"noteId":17,"caller":"+","text":"Yabini yali kabaka w’Abakanani, ate nga Sisera mutabani we. Yawangulibwa Debola","reference":{"chapter":83,"verse":9}},{"noteId":18,"caller":"+","text":"Olebu ne Zeebu baali bakabaka b’Abamidiyaani, Gidyoni be yawangula","reference":{"chapter":83,"verse":11}}]},"thisChapterLink":"/api/lug_bib/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}