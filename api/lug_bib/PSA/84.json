{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":84,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Batabani ba Koola."]},{"type":"verse","number":1,"content":[{"text":"Eweema zo nga nnungi,","poem":1},{"text":"Ayi Mukama ow’Eggye!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Omwoyo gwange guyaayaana,","poem":1},{"text":"gwagala na kuzirika,","poem":2},{"text":"olw’empya za Mukama,","poem":1},{"text":"omutima gwange n’omubiri gwange bikoowoola Katonda omulamu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Weewaawo,","poem":1},{"text":"ne nkazaluggya yeekoledde ekisu,","poem":2},{"lineBreak":true},{"text":"n’akataayi ennyumba mwe binaakulizanga abaana baabyo","poem":2},{"text":"awo okumpi n’Ebyoto byo,","poem":1},{"text":"Ayi Mukama Ayinzabyonna, Kabaka wange, era Katonda wange.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Balina omukisa ababeera mu nnyumba yo,","poem":1},{"text":"banaakutenderezanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Alina omukisa omuntu eyeesiga amaanyi go,","poem":1},{"text":"era assaayo omwoyo okutambulira mu makubo go.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bayita mu kiwonvu Baka,","poem":1},{"text":"ne bakifuula ekifo ky’ensulo;","poem":2},{"lineBreak":true},{"text":"n’enkuba ya ddumbi n’ejjuza ebidiba byakyo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bagenda beeyongera amaanyi,","poem":1},{"text":"okutuusa lwe batuuka mu maaso ga Katonda mu Sayuuni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wulira okusaba kwange, Ayi Mukama Katonda ow’Eggye;","poem":1},{"text":"mpuliriza, Ayi Katonda wa Yakobo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ayi Katonda, Engabo yaffe,","poem":1},{"text":"tunuulira kabaka wo n’okusaasira oyo gwe wafukako amafuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Okumala olunaku olumu mu mpya zo,","poem":1},{"text":"kisinga okubeera emyaka olukumi mu bifo ebirala.","poem":2},{"text":"Njagala okuba omuggazi mu nnyumba ya Katonda wange,","poem":1},{"text":"okusinga okubeeranga mu weema z’abakola ebibi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kubanga Mukama Katonda ye njuba yaffe era ye ngabo yaffe;","poem":1},{"text":"atuwa emikisa gye awamu n’ekitiibwa;","poem":2},{"text":"tewaliiwo kirungi na kimu ky’ataawa","poem":1},{"text":"abo abatambulira mu makubo ge nga tebaliiko kyakunenyezebwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ayi Mukama ow’Eggye","poem":1},{"text":"alina omukisa omuntu akwesiga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}