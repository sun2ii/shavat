{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":85,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Batabani ba Koola."]},{"type":"verse","number":1,"content":[{"text":"Ensi yo ogikoledde ebyekisa Ayi Mukama;","poem":1},{"text":"Yakobo omuddizza ebibye.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abantu bo obasonyiye ebyonoono byabwe,","poem":1},{"text":"n’ebibi byabwe byonna n’obibikkako.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ekiruyi kyo kyonna okirese,","poem":1},{"text":"n’oleka n’obusungu bwo obubuubuuka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tukomyewo gy’oli, Ayi Katonda w’obulokozi bwaffe,","poem":1},{"text":"oleke okutusunguwalira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Onootusunguwaliranga emirembe gyonna?","poem":1},{"text":"Onootunyiigiranga emirembe n’emirembe?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tolituzaamu ndasi,","poem":1},{"text":"abantu bo basanyukirenga mu ggwe?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tulage okwagala kwo okutaggwaawo Ayi Katonda,","poem":1},{"text":"era otuwe obulokozi bwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nnaawulirizanga Mukama Katonda by’agamba;","poem":1},{"text":"asuubiza abantu be, be batukuvu be, okubawa emirembe;","poem":2},{"lineBreak":true},{"text":"naye tebaddayo mu byonoono byabwe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ddala ddala obulokozi bwe busemberera abo abamutya,","poem":1},{"text":"ensi yaffe n’eryoka ejjula ekitiibwa kye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Okwagala n’obwesigwa bisisinkanye;","poem":1},{"text":"obutuukirivu n’emirembe binywegeraganye.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Obwesigwa bulose mu nsi,","poem":1},{"text":"n’obutukuvu ne butunuulira ensi nga businzira mu ggulu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ddala ddala Katonda anaatuwanga ebirungi,","poem":1},{"text":"n’ensi yaffe eneebalanga ebibala bingi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Obutuukirivu bunaamukulemberanga,","poem":1},{"text":"era bunaateekateekanga ekkubo mw’anaayitanga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}