{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":86,"content":[{"type":"hebrew_subtitle","content":["Okusaba kwa Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Otege okutu kwo, Ayi Mukama, owulire okusaba kwange, onnyanukule,","poem":1},{"text":"kubanga ndi mwavu atalina kintu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Okuume obulamu bwange, kubanga nkuweereza n’obwesigwa.","poem":1},{"text":"Katonda wange, ondokole","poem":2},{"lineBreak":true},{"text":"nze omuddu wo akwesiga.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Onsaasire, Ayi Mukama,","poem":1},{"text":"kubanga olunaku lwonna nsiiba nkukoowoola.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Osanyuse omuweereza wo Ayi Mukama;","poem":1},{"text":"kubanga omwoyo gwange","poem":2},{"lineBreak":true},{"text":"nguyimusa eyo gy’oli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ddala ddala olina ekisa era osonyiwa, Ayi Mukama;","poem":1},{"text":"n’abo bonna abakukoowoola obaagala nnyo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Owulire okusaba kwange, Ayi Mukama;","poem":1},{"text":"owulirize eddoboozi erikaabirira ekisa kyo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bwe nnaabanga mu buzibu nnaakukoowoolanga;","poem":1},{"text":"kubanga ononnyanukulanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mu bakatonda bonna tewali ali nga ggwe, Ayi Mukama;","poem":1},{"text":"era teriiyo akola bikolwa ng’ebibyo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ayi Mukama amawanga gonna ge watonda","poem":1},{"text":"ganajjanga mu maaso go ne gakusinza;","poem":2},{"lineBreak":true},{"text":"era ne bagulumiza erinnya lyo ery’ekitiibwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kubanga oli mukulu, era okola ebyewunyisa;","poem":1},{"text":"ggwe wekka ggwe Katonda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Onjigirize ekkubo lyo, Ayi Mukama,","poem":1},{"text":"ntambulirenga mu mazima go;","poem":2},{"text":"ompe omutima omunywevu ogutasagaasagana,","poem":1},{"text":"ntyenga erinnya lyo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nnaakutenderezanga, Ayi Mukama Katonda wange, n’omutima gwange gwonna;","poem":1},{"text":"erinnya lyo nnaaligulumizanga emirembe gyonna.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Okwagala kwo okutaggwaawo kungi nnyo gye ndi;","poem":1},{"text":"wawonya omwoyo gwange amagombe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ayi Katonda, ab’amalala bannumba,","poem":1},{"text":"ekibinja ky’abantu abataliimu kusaasira bannoonya okunzita,","poem":2},{"lineBreak":true},{"text":"be bantu abatakufiirako ddala.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Naye ggwe, Mukama Katonda oli musaasizi era ow’ekisa,","poem":1},{"text":"olwawo okusunguwala, ojjudde okwagala n’obwesigwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Onkyukire, onsaasire,","poem":1},{"text":"ompe amaanyi go nze omuweereza wo;","poem":2},{"lineBreak":true},{"text":"nze omwana w’omuweereza wo omukazi ondokole.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nkolera akabonero akalaga ebirungi byo,","poem":1},{"text":"abalabe bange bakalabe baswale;","poem":2},{"lineBreak":true},{"text":"kubanga ggwe, Ayi Mukama, onnyambye era onzizizzaamu amaanyi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}