{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["Zabbuli ya Batabani ba Koola. Oluyimba."]},{"type":"verse","number":1,"content":[{"text":"Atadde emisingi gye ku lusozi olutukuvu.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Mukama ayagala emiryango gya Sayuuni","poem":2},{"lineBreak":true},{"text":"okusinga ennyumba zonna eza Yakobo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ebintu eby’ekitiibwa bikwogerwako,","poem":1},{"text":"ggwe ekibuga kya Katonda.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Mu mawanga ge mmanyi mwe muli Lakabu,","poem":1},{"text":"ne Babulooni;","poem":2},{"text":"era ndyogera ku Bufirisuuti, ne ku Ttuulo","poem":1},{"text":"ne ku Esiyopya nti, ‘Ono yazaalirwa mu Sayuuni.’ ”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bwe baliba boogera ku Sayuuni baligamba nti,","poem":1},{"text":"“Ono n’oli baazaalirwa omwo,”","poem":2},{"lineBreak":true},{"text":"n’oyo Ali Waggulu Ennyo alikinyweza.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mukama aliwandiika mu kitabo bw’ati,","poem":1},{"text":"omuli amannya g’abantu nti, “Ono yazaalibwa omwo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Banaakubanga ebivuga nga bwe bayimba nti,","poem":1},{"text":"“Ensulo zange zonna ziri mu ggwe.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}