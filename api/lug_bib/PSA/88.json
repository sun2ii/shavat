{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":88,"content":[{"type":"hebrew_subtitle","content":["Ya Mukulu wa Bayimbi. Zabbuli ya Batabani ba Koola."]},{"type":"verse","number":1,"content":[{"text":"Ayi Mukama Katonda, Omulokozi wange,","poem":1},{"text":"nkaaba emisana n’ekiro mu maaso go.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kkiriza okusaba kwange kutuuke gy’oli;","poem":1},{"text":"otege okutu kwo nga nkukoowoola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kubanga emmeeme yange ejjudde ebizibu,","poem":1},{"text":"era nsemberedde okufa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mbalirwa mu abo abaserengeta emagombe;","poem":1},{"text":"nfaanana ng’omuntu atalina maanyi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bandese wano ng’afudde,","poem":1},{"text":"nga ndi ng’abo be basse abalinda obulinzi entaana,","poem":2},{"text":"nga tokyaddayo kubajjukira,","poem":1},{"text":"era nga tewakyali kya kubakolera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ontadde mu kinnya ekisinga obuwanvu,","poem":1},{"text":"era eky’ekizikiza ekikutte ennyo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Obusungu bwo bumbuubuukiddeko nnyo,","poem":1},{"text":"ng’ennyanja esiikuuse n’amayengo gaayo ne gankuba okusukkirira.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ab’emikwano abasingira ddala okunjagala obammazeeko,","poem":1},{"text":"n’onfuula ekyenyinyalwa gye bali.","poem":2},{"text":"Nsibiddwa, so sisobola kwesumattula.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Amaaso gange gayimbadde olw’ennaku.","poem":2},{"lineBreak":true},{"text":"Nkukoowoola buli lunaku, Ayi Mukama,","poem":1},{"text":"ne ngolola emikono gyange gy’oli nga nkwegayirira.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ebyamagero byo onoobikoleranga bafu?","poem":1},{"text":"Abafudde banaagolokokanga ne bakutendereza?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Okwagala kwo onookulaganga abali emagombe","poem":1},{"text":"n’obwesigwa bwo abo abali mu kifo eky’okuzikirira?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ebyamagero byo binaamanyibwanga mu kifo ekyo eky’ekizikiza?","poem":1},{"text":"Oba ebikolwa byo eby’obutuukirivu bwo bye binaamanyibwanga mu nsi eyamala edda okwerabirwa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Naye nze, Ayi Mukama, naakabiriranga ggwe okunnyamba;","poem":1},{"text":"buli nkya okusaba kwange kunaatuukanga gy’oli.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ayi Mukama, onsuulidde ki?","poem":1},{"text":"Onkwekedde ki amaaso go?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ombonyaabonyezza okuviira ddala mu buvubuka bwange, era nga mbeera kumpi n’okufa;","poem":1},{"text":"ngumiikirizza nnyo entiisa yo, era kaakano mpweddemu essuubi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Obusungu bwo obubuubuuka bunzigwereddeko era bunzikkiriza.","poem":1},{"text":"Entiisa yo tendeseemu ka buntu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Binzingiza nga mukoka olunaku lwonna;","poem":1},{"text":"binsaanikiridde ddala.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ommazeeko ab’emikwano n’abo abanjagala ennyo;","poem":1},{"text":"nsigazza nzikiza yokka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}