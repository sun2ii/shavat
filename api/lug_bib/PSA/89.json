{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":89,"content":[{"type":"hebrew_subtitle","content":["Endagaano ya Katonda ne Dawudi."]},{"type":"verse","number":1,"content":[{"text":"Nnaayimbanga ku kwagala kwo okungi, Ayi Mukama, emirembe gyonna.","poem":1},{"text":"Nnaatenderezanga obwesigwa bwo n’akamwa kange, bumanyibwe ab’emirembe gyonna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ddala ddala nnaategeezanga nti okwagala kwo tekuggwaawo ennaku zonna;","poem":1},{"text":"n’obwesigwa bwo bunywevu ng’eggulu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nakola endagaano n’omulonde wange;","poem":1},{"text":"nalayirira omuweereza wange Dawudi nti,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Ezadde lyo nnaalinywezanga ennaku zonna,","poem":1},{"text":"era entebe yo ey’obwakabaka nnaaginywezanga emirembe gyonna.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Eggulu linaatenderezanga ebyamagero byo n’obwesigwa bwo,","poem":1},{"text":"Ayi Mukama, mu kibiina ky’abatukuvu bo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kale, mu ggulu waggulu, ani ageraageranyizika ne Mukama?","poem":1},{"text":"Ani afaanana nga Mukama, mu abo ababeera mu ggulu?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Katonda atiibwa nnyo mu lukiiko olw’abatukuvu;","poem":1},{"text":"era wa ntiisa okusinga bonna abamwetooloola.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ayi Mukama Katonda ow’Eggye, ani akufaanana?","poem":1},{"text":"Oli wa buyinza, Ayi Mukama, ojjudde obwesigwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ggwe ofuga amalala g’ennyanja;","poem":1},{"text":"amayengo gaayo bwe geekuluumulula ogakkakkanya.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lakabu wamubetentera ddala;","poem":1},{"text":"abalabe bo n’obasaasaanya n’omukono gwo ogw’amaanyi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Eggulu liryo, n’ensi yiyo;","poem":1},{"text":"ensi yonna gwe wagitonda ne byonna ebigirimu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Watonda obukiikakkono n’obukiikaddyo;","poem":1},{"text":"ensozi Taboli ne Kerumooni zitendereza erinnya lyo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Oli wa buyinza bungi nnyo; omukono gwo gwa maanyi,","poem":1},{"text":"omukono gwo ogwa ddyo gunaagulumizibwanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Obutuukirivu n’obwenkanya gwe musingi gw’obwakabaka bwo.","poem":1},{"text":"Okwagala n’obwesigwa bye binaakukulemberanga.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Balina omukisa abantu abamanyi okukutendereza Mukama n’amaloboozi ag’essanyu;","poem":1},{"text":"Ayi Mukama, banaatambuliranga mu ssanyu lyo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Banaasanyukiranga mu linnya lyo okuzibya obudde,","poem":1},{"text":"n’obutuukirivu bwo banaabugulumizanga.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kubanga gw’obawa amaanyi ne bafuna ekitiibwa.","poem":1},{"text":"Olw’okwagala kwo otutuusa ku buwanguzi olw’ekisa kyo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ddala ddala, Mukama ye ngabo yaffe,","poem":1},{"text":"Omutukuvu wa Isirayiri kabaka waffe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mu biro biri eby’edda wayogera n’omuweereza wo","poem":1},{"text":"omwesigwa mu kwolesebwa nti, Ngulumizizza omuzira ow’amaanyi;","poem":2},{"text":"ngulumizizza omuvubuka","poem":1},{"text":"okuva mu bantu abaabulijjo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nalaba Dawudi, omuweereza wange;","poem":1},{"text":"ne mufukako amafuta gange amatukuvu okuba kabaka.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nnaamukulemberanga,","poem":1},{"text":"n’omukono gwange gunaamunywezanga.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Tewaliba mulabe we alimuwangula,","poem":1},{"text":"so n’aboonoonyi tebaamunyigirizenga.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Abalabe be n’abamukyawa ndibamerengula,","poem":1},{"text":"n’amaggye agamulwanyisa ndigabetenta.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Obwesigwa bwange n’okwagala kwange kunaabanga naye,","poem":1},{"text":"ne mu linnya lyange aneeyongeranga okuba ow’amaanyi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Alifuga okuva ku migga","poem":1},{"text":"okutuuka ku nnyanja ennene.","poem":2},{"noteId":19}]},{"type":"verse","number":26,"content":[{"text":"Anankowoolanga ng’agamba nti, Ggwe Kitange era Katonda wange,","poem":1},{"text":"ggwe Lwazi olw’Obulokozi bwange.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ndimufuula omwana wange omubereberye,","poem":1},{"text":"era kabaka asinga okugulumizibwa mu bakabaka bonna ab’ensi.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Okwagala kwange kunaabeeranga naye ennaku zonna;","poem":1},{"text":"n’endagaano gye nkoze naye teeremenga kutuukirira.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ezzadde lye teririggwaawo emirembe gyonna,","poem":1},{"text":"n’obwakabaka bunaavanga mu kika kye ennaku zonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Abaana be bwe banaanyoomanga amateeka gange,","poem":1},{"text":"ne batagoberera biragiro byange;","poem":2}]},{"type":"verse","number":31,"content":[{"text":"bwe banaamenyanga ebiragiro byange,","poem":1},{"text":"ne batagondera mateeka gange,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ndibabonereza n’omuggo olw’ebibi byabwe,","poem":1},{"text":"ne mbakuba emiggo olw’ebyonoono byabwe.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Naye ssirirekayo kumwagala,","poem":1},{"text":"wadde okumenyawo obwesigwa bwange gy’ali.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Sigenda kulemwa kutuukiriza ndagaano yange,","poem":1},{"text":"wadde okukyusa ku ebyo akamwa kange bye koogedde.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Nalayira omulundi gumu, ng’obutuukirivu bwange bwe buli,","poem":1},{"text":"nti, “Dawudi sigenda kumulimba.”","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ezzadde lye teririggwaawo emirembe gyonna;","poem":1},{"text":"n’entebe ye ey’obwakabaka enaabeerangawo emirembe gyonna okufaanana ng’enjuba.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Entebe ye ey’obwakabaka erinywezebwa emirembe n’emirembe,","poem":1},{"text":"ng’omwezi ku ggulu era nga ye mujulirwa wange omwesigwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"Naye kaakano, gwe wafukako amafuta omusudde,","poem":1},{"text":"omukyaye era omunyiigidde.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Endagaano gye wakola n’omuweereza wo wagimenyawo,","poem":1},{"text":"n’engule ye n’ogisuula eri mu nfuufu.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Wamenyaamenya bbugwe we yenna,","poem":1},{"text":"n’oggyawo n’ebigo bye.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Abatambuze baanyaga ebintu bye;","poem":1},{"text":"n’afuuka ekisekererwa mu baliraanwa be.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Wayimusa omukono gw’abalabe be ogwa ddyo,","poem":1},{"text":"n’osanyusa abalabe be bonna.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Wakyusa ekitala kye","poem":1},{"text":"n’otomuyamba mu lutalo.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Ekitiibwa kye wakikomya;","poem":1},{"text":"entebe ye ey’obwakabaka n’ogisuula wansi.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Ennaku z’obuvuka bwe wazisalako,","poem":1},{"text":"n’omuswaza.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Ayi Mukama, olyekweka ennaku zonna?","poem":1},{"text":"Obusungu bwo obubuubuuka ng’omuliro bulikoma ddi?","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Jjukira ekiseera ky’obulamu bwange nga bwe kiri ekimpi.","poem":1},{"text":"Wateganira bwereere okutonda abantu bonna!","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Muntu ki omulamu atalifa, omuntu asobola okwewonya okufa","poem":1},{"text":"n’awangula amaanyi g’emagombe?","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Ayi Mukama, okwagala kwo okw’edda okutaggwaawo,","poem":1},{"text":"kwe walayirira Dawudi mu bwesigwa bwo, kuli luuyi wa?","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Ayi Mukama, jjukira abaweereza bo nga basekererwa,","poem":1},{"text":"engeri abantu ab’omu mawanga amangi, bwe banzitoowerera mu mutima nga banvuma;","poem":2}]},{"type":"verse","number":51,"content":[{"text":"abalabe bo banvuma, Ayi Mukama;","poem":1},{"text":"ne bajerega oyo gwe wafukako amafuta, nga bamukijjanya buli gy’alaga.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Mukama atenderezebwenga emirembe gyonna!","poem":1},"Amiina era Amiina!"]}],"footnotes":[{"noteId":19,"caller":"+","text":"Ennyanja eyogerwako wano ye ya Meditereniyaani, n’emigga gya Fulaati n’amatabi gaayo. Eyo ye yali ensalo ey’ensi eyasuubizibwa Dawudi ne Sulemaani.","reference":{"chapter":89,"verse":25}}]},"thisChapterLink":"/api/lug_bib/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}