{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":90,"content":[{"type":"hebrew_subtitle","content":["Okusaba kwa Musa, omusajja wa Katonda."]},{"type":"verse","number":1,"content":[{"text":"Ayi Mukama, obadde kifo kyaffe eky’okubeeramu","poem":1},{"text":"emirembe gyonna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ensozi nga tezinnabaawo,","poem":1},{"text":"n’ensi yonna nga tonnagitonda;","poem":2},{"lineBreak":true},{"text":"okuva ku ntandikwa okutuusa ku nkomerero y’emirembe gyonna, ggwe Katonda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Omuntu omuzzaayo mu nfuufu,","poem":1},{"text":"n’oyogera nti, “Mudde mu nfuufu, mmwe abaana b’abantu.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kubanga emyaka olukumi,","poem":1},{"text":"gy’oli giri ng’olunaku olumu olwayita,","poem":2},{"lineBreak":true},{"text":"oba ng’ekisisimuka mu kiro.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Obeera n’obamalirawo ddala nga bali mu tulo otw’okufa.","poem":1},{"text":"Ku makya baba ng’omuddo omuto.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ku makya guba munyirivu,","poem":1},{"text":"naye olw’eggulo ne guwotoka ne gukala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ddala ddala obusungu bwo butumalawo,","poem":1},{"text":"n’obukambwe bwo bututiisa nnyo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ebyonoono byaffe obyanjadde mu maaso go,","poem":1},{"text":"n’ebyo bye tukoze mu kyama obyanise awo w’oli.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ddala ddala tumala ennaku z’obulamu bwaffe zonna ng’otunyiigidde;","poem":1},{"text":"tukomekkereza emyaka gyaffe n’okusinda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Obungi bw’ennaku zaffe gy’emyaka nsanvu,","poem":1},{"text":"oba kinaana bwe tubaamu amaanyi.","poem":2},{"text":"Naye emyaka egyo gijjula ennaku n’okutegana,","poem":1},{"text":"era giyita mangu, olwo nga tuggwaawo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ani amanyi amaanyi g’obusungu bwo?","poem":1},{"text":"Kubanga ekiruyi kyo kingi ng’ekitiibwa kye tusaana okukuwa bwe kyenkana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Otuyigirize okutegeeranga obulungi ennaku zaffe,","poem":1},{"text":"tulyoke tubeere n’omutima ogw’amagezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ayi Mukama, komawo gye tuli. Olitusuula kutuusa ddi?","poem":1},{"text":"Abaweereza bo bakwatirwe ekisa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tujjuze okwagala kwo okutaggwaawo ku makya,","poem":1},{"text":"tulyoke tuyimbenga nga tujaguza n’essanyu era tusanyukenga obulamu bwaffe bwonna.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tusanyuse, Ayi Mukama, okumala ennaku nga ze tumaze ng’otubonyaabonya,","poem":1},{"text":"era n’okumala emyaka nga gye tumaze nga tulaba ennaku.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ebikolwa byo biragibwe abaweereza bo,","poem":1},{"text":"n’abaana baabwe balabe ekitiibwa kyo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Okusaasira kwo, Ayi Mukama Katonda waffe, kubeerenga ku ffe,","poem":1},{"text":"otusobozesenga okutuukiriza obulungi emirimu gyaffe;","poem":2},{"lineBreak":true},{"text":"weewaawo, otusobozesenga okutuukiriza obulungi emirimu gyaffe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}