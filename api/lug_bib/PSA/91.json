{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":91,"content":[{"type":"hebrew_subtitle","content":["Obwesige bw’oyo atya Katonda."]},{"type":"verse","number":1,"content":[{"text":"Oyo abeera mu kifo eky’ekyama eky’oyo Ali Waggulu Ennyo;","poem":1},{"text":"aliwumulira mu kisiikirize kya Katonda Ayinzabyonna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nnaayogeranga ku Mukama nti, Oli kiddukiro kyange era ekigo kyange;","poem":1},{"text":"ggwe Katonda wange gwe nneesiga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ddala ddala y’anaakuwonyanga omutego gw’omuyizzi,","poem":1},{"text":"ne kawumpuli azikiriza.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Alikubikka n’ebyoya bye,","poem":1},{"text":"era mu biwaawaatiro bye mw’onoddukiranga;","poem":2},{"lineBreak":true},{"text":"obwesigwa bwe bunaabanga ngabo yo okukukuumanga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tootyenga ntiisa ya kiro,","poem":1},{"text":"wadde akasaale akalasibwa emisana;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"newaakubadde olumbe olusoobasooba mu kizikiza,","poem":1},{"text":"wadde kawumpuli azikiriza mu ttuntu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abantu olukumi balifiira ku lusegere lwo,","poem":1},{"text":"n’omutwalo ne bafiira ku mukono gwo ogwa ddyo,","poem":2},{"lineBreak":true},{"text":"naye olumbe terulikutuukako.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Olitunuulira butunuulizi n’amaaso go;","poem":1},{"text":"n’olaba ekibonerezo ky’omukozi w’ebibi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kubanga bw’olifuula Mukama ekiddukiro kyo;","poem":1},{"text":"Ali Waggulu Ennyo n’omufuula ekifo kyo mw’obeera,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"tewali kabi kalikutuukako,","poem":1},{"text":"so tewali kibonoobono kirisemberera nnyumba yo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kubanga Mukama aliragira bamalayika be","poem":1},{"text":"bakukuume mu makubo go gonna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Balikuwanirira mu mikono gyabwe;","poem":1},{"text":"oleme okwekoona ekigere kyo ku jjinja.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Olirinnya ku mpologoma ne ku nswera;","poem":1},{"text":"olirinnyirira empologoma ey’amaanyi, n’omusota.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Olw’okuba nga njagala kyendiva muwonya;","poem":1},{"text":"nnaamukuumanga, kubanga amanyi erinnya lyange.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Anankowoolanga ne muyitabanga;","poem":1},{"text":"nnaabeeranga naye mu biseera eby’akabi.","poem":2},{"lineBreak":true},{"text":"Ndimuwonya era ndimuwa ekitiibwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ndimuwangaaza n’asanyuka","poem":1},{"text":"era ndimulaga obulokozi bwange.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}