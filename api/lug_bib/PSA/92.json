{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":92,"content":[{"type":"hebrew_subtitle","content":["Zabbuli. Oluyimba lwa Ssabbiiti."]},{"type":"verse","number":1,"content":[{"text":"Kirungi okwebazanga Mukama,","poem":1},{"text":"n’okuyimba ennyimba n’okutenderezanga erinnya lyo, Ayi Ggwe, Ali Waggulu Ennyo;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"okutendanga okwagala kwo okutakoma buli nkya,","poem":1},{"text":"n’okutendanga obwesigwa bwo buli kiro.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Okukutenderezanga n’amaloboozi g’enkoba z’ennanga","poem":1},{"text":"n’endere awamu n’entongooli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kubanga ggwe, Ayi Mukama, onkoledde ebinsanyusizza;","poem":1},{"text":"kyenva nkuyimbira n’essanyu olw’emirimu gy’emikono gyo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Emirimu gyo nga mikulu, Ayi Mukama;","poem":1},{"text":"ebirowoozo byo nga tebitegeerekeka!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Omuntu atalina magezi tamanyi;","poem":1},{"text":"n’omusirusiru kino tasobola kukitegeera;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"newaakubadde ng’abakola ebibi baloka ng’omuddo,","poem":1},{"text":"n’aboonoonyi bonna ne bafuna ebirungi,","poem":2},{"text":"boolekedde okuzikirira okw’emirembe n’emirembe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Naye ggwe, Ayi Mukama, ogulumizibwa emirembe gyonna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kubanga abalabe bo, Ayi Mukama,","poem":1},{"text":"abalabe bo balizikirira,","poem":2},{"lineBreak":true},{"text":"abakola ebibi bonna balisaasaanyizibwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Naye nze wanfuula wa maanyi okwenkana embogo,","poem":1},{"text":"n’onfukako amafuta amalungi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amaaso gaalaba bbugwe ng’agwa ku balabe bange;","poem":1},{"text":"n’amatu gange gawulidde akabi akatuuse ku abo abanjigganya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Abatuukirivu balyegolola ng’enkindu,","poem":1},{"text":"ne bakula ne bawanvuwa ng’emivule gy’e Lebanooni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Egisimbibwa mu nnyumba ya Mukama.","poem":1},{"text":"Baligimukira mu mpya za Katonda waffe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ne mu bukadde bwabwe balibala ebibala;","poem":1},{"text":"baliba balamu era abagimu,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"kiryoke kitegeeze nti, Mukama w’amazima,","poem":1},{"text":"lwe Lwazi lwange era mu ye temuli butali butuukirivu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}