":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ayi Mukama ebiragiro byo binywevu,","poem":1},{"text":"n’obutukuvu bujjudde ennyumba yo,","poem":2},{"lineBreak":true},{"text":"ennaku zonna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}