{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":94,"content":[{"type":"verse","number":1,"content":[{"text":"Ayi Mukama, ggwe Katonda awalana eggwanga,","poem":1},{"text":"ggwe Katonda awalana eggwanga, labika omasemase.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Golokoka, Ayi ggwe Omulamuzi w’ensi,","poem":1},{"text":"osasule ab’amalala nga bwe kibagwanidde.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ayi Mukama, omukozi w’ebibi alikomya ddi?","poem":1},{"text":"Omukozi w’ebibi alituusa ddi ng’asanyuka?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bafukumula ebigambo eby’okwewaanawaana;","poem":1},{"text":"abakola ebibi bonna beepankapanka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Babetenta abantu bo, Ayi Mukama,","poem":1},{"text":"babonyaabonya ezzadde lyo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Batta nnamwandu n’omutambuze;","poem":1},{"text":"ne batemula ataliiko kitaawe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne boogera nti, “Katonda talaba;","poem":1},{"text":"Katonda wa Yakobo tafaayo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mwerinde mmwe abantu abatategeera.","poem":1},{"text":"Mmwe abasirusiru muligeziwala ddi?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Oyo eyatonda okutu tawulira?","poem":1},{"text":"Oyo eyakola eriiso talaba?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Oyo akangavvula amawanga, taakubonereze?","poem":1},{"text":"Oyo ayigiriza abantu talina ky’amanyi?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mukama amanyi ebirowoozo by’abantu;","poem":1},{"text":"amanyi nga mukka bukka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ayi Mukama, alina omukisa oyo gw’ogunjula,","poem":1},{"text":"gw’oyigiriza eby’omu mateeka go;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"omuwummuzaako mu kabi kaalimu,","poem":1},{"text":"okutuusa abakola ebibi lwe balisimirwa ekinnya.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kubanga Mukama talireka bantu be;","poem":1},{"text":"talyabulira zzadde lye.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Aliramula mu butuukirivu,","poem":1},{"text":"n’abo abalina emitima emigolokofu bwe banaakolanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ani alinnwanyisizaako abakola ebibi?","poem":1},{"text":"Ani alinnwanirira eri abakola ebibi?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Singa Mukama teyali mubeezi wange,","poem":1},{"text":"omwoyo gwange gwandiserengese emagombe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bwe naleekaana nti, “Nseerera!”","poem":1},{"text":"Okwagala kwo okutaggwaawo, Ayi Mukama, ne kumpanirira.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ebyeraliikiriza omutima gwange bwe byayitirira obungi,","poem":1},{"text":"okusaasira kwo ne kuzzaamu omwoyo gwange amaanyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Oyinza okukolagana n’obufuzi obukyamu,","poem":1},{"text":"obukaabya abantu n’amateeka gaabwe?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Abakola ebibi beegatta ne balumbagana abatuukirivu;","poem":1},{"text":"atasobezza ne bamusalira ogw’okufa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Naye Mukama afuuse ekiddukiro kyange eky’amaanyi;","poem":1},{"text":"ye Katonda wange, era Olwazi lwange mwe neekweka.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mukama alibabonereza olw’ebibi byabwe,","poem":1},{"text":"n’abazikiriza olw’ebyonoono byabwe;","poem":2},{"lineBreak":true},{"text":"Mukama Katonda waffe alibamalirawo ddala.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}