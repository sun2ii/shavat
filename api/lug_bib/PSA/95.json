{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"Mujje tuyimbire Mukama;","poem":1},{"text":"tuyimbire waggulu n’essanyu nga tutendereza Mukama Olwazi olw’obulokozi bwaffe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tujje mu maaso ge n’okwebaza;","poem":1},{"text":"tumuyimbire ennyimba ez’okumutendereza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kubanga Mukama ye Katonda Omukulu;","poem":1},{"text":"era Kabaka Omukulu asinga bakatonda bonna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Enkonko ez’ensi ziri mu mukono gwe;","poem":1},{"text":"n’entikko z’ensozi nazo zize.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ennyanja yiye, kubanga ye yagikola;","poem":1},{"text":"n’emikono gye, gye gyabumba olukalu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mujje tusinze tuvuuname mu maaso ge;","poem":1},{"text":"tufukamire mu maaso ga Mukama, Omutonzi waffe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kubanga ye Katonda waffe,","poem":1},{"text":"naffe tuli bantu ab’omu ddundiro lye,","poem":2},{"lineBreak":true},{"text":"era tuli ndiga ze z’alabirira.","poem":2},{"lineBreak":true},{"text":"Olwa leero bwe muwulira eddoboozi lye,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"“Temukakanyaza mitima gyammwe nga bwe kyali e Meriba","poem":2},{"noteId":20},{"text":",","poem":2},{"lineBreak":true},{"text":"ne ku lunaku luli e Maasa","poem":2},{"noteId":21},{"text":"mu ddungu;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"bajjajjammwe gye bangezesa;","poem":1},{"text":"newaakubadde baali baalaba dda ebyamagero bye nakola.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abantu b’omulembe ogwo ne mbasunguwalira okumala emyaka amakumi ana;","poem":1},{"text":"ne ŋŋamba nti, ‘Be bantu abakyama mu mutima gwabwe,","poem":2},{"lineBreak":true},{"text":"era tebamanyi makubo gange.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kyennava ndayira nga nsunguwadde nti,","poem":1},{"text":"‘Tebaliyingira mu kiwummulo kyange.’ ”","poem":2}]}],"footnotes":[{"noteId":20,"caller":"+","text":"Meriba kitegeeza okwemulugunya","reference":{"chapter":95,"verse":8}},{"noteId":21,"caller":"+","text":"Maasa kitegeeza kugezesa","reference":{"chapter":95,"verse":8}}]},"thisChapterLink":"/api/lug_bib/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}