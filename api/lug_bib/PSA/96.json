{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":96,"content":[{"type":"verse","number":1,"content":[{"text":"Muyimbire Mukama oluyimba oluggya;","poem":1},{"text":"muyimbire Mukama mmwe ensi yonna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Muyimbire Mukama; mutendereze erinnya lye,","poem":1},{"text":"mulangirire obulokozi bwe buli lukya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mutende ekitiibwa kye mu mawanga gonna,","poem":1},{"text":"eby’amagero bye mubimanyise abantu bonna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kubanga Mukama mukulu era asaanira nnyo okutenderezebwa;","poem":1},{"text":"asaana okutiibwa okusinga bakatonda bonna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kubanga bakatonda bonna abakolebwa abantu bifaananyi bufaananyi;","poem":1},{"text":"naye Mukama ye yakola eggulu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ekitiibwa n’obukulu bimwetooloola;","poem":1},{"text":"amaanyi n’obulungi biri mu nnyumba ye entukuvu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mugulumize Mukama mmwe ebika eby’amawanga byonna;","poem":1},{"text":"mutende ekitiibwa kya Mukama awamu n’amaanyi ge.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mugulumize Mukama mu ngeri esaanira erinnya lye;","poem":1},{"text":"muleete ekiweebwayo mujje mu mbuga ze.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Musinze Mukama mu kitiibwa eky’obutuukirivu bwe.","poem":1},{"text":"Ensi yonna esinze Mukama n’okukankana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mutegeeze amawanga gonna nti Mukama y’afuga.","poem":1},{"text":"Ensi nnywevu, tewali asobola kuginyeenyaako;","poem":2},{"lineBreak":true},{"text":"Mukama aliramula abantu mu bwenkanya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kale eggulu lisanyuke n’ensi ejaguze;","poem":1},{"text":"ennyanja eyire ne byonna ebigirimu.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ennimiro n’ebirime ebizirimu bijaguze;","poem":2},{"text":"n’emiti gyonna egy’omu kibira nagyo gimutendereze n’ennyimba ez’essanyu.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"Kubanga Mukama ajja;","poem":2},{"lineBreak":true},{"text":"ajja okusalira ensi omusango.","poem":2},{"text":"Mukama aliramula ensi mu butuukirivu,","poem":1},{"text":"n’abantu bonna abalamule mu mazima.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}