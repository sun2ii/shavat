{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"Mukama afuga; ensi esanyuke,","poem":1},{"text":"n’embalama eziri ewala zijaguze.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ebire n’ekizikiza bimwetooloola;","poem":1},{"text":"obutuukirivu n’obwenkanya gwe musingi gw’entebe y’obwakabaka bwe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Omuliro gumukulembera","poem":1},{"text":"ne gwokya abalabe be ku njuyi zonna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Okumyansa kwe kumulisa ensi;","poem":1},{"text":"ensi n’ekulaba n’ekankana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ensozi zisaanuuka ng’envumbo awali Mukama,","poem":1},{"text":"mu maaso ga Mukama ow’ensi yonna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eggulu lirangirira obutuukirivu bwe;","poem":1},{"text":"n’abantu bonna ne balaba ekitiibwa kye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Abasinza ebifaananyi ebikole n’emikono bonna baswadde,","poem":1},{"text":"abo abeenyumiririza mu bifaananyi ebyole.","poem":2},{"lineBreak":true},{"text":"Mumusinze mwe mwenna bakatonda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Sayuuni akiwulira n’asanyuka,","poem":1},{"text":"n’ebyalo bya Yuda bijaguza;","poem":2},{"lineBreak":true},{"text":"kubanga ogoberera eby’ensonga, Ayi Katonda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kubanga ggwe, Ayi Mukama, oli waggulu nnyo okusinga ensi;","poem":1},{"text":"ogulumizibwa okusinga bakatonda bonna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abo abaagala Mukama bakyawa ekibi,","poem":1},{"text":"akuuma obulamu bw’abamwesiga,","poem":2},{"lineBreak":true},{"text":"n’abawonya okuva mu mukono gw’omukozi w’ebibi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Omusana gwe gwakira abatuukirivu,","poem":1},{"text":"n’abalina omutima ogw’amazima bajjula essanyu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Musanyukirenga mu Mukama mmwe abatuukirivu,","poem":1},{"text":"era mwebazenga erinnya lye ettukuvu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}