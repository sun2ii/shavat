{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["Zabbuli."]},{"type":"verse","number":1,"content":[{"text":"Muyimbire Mukama oluyimba oluggya,","poem":1},{"text":"kubanga akoze eby’ekitalo.","poem":2},{"text":"Omukono gwe ogwa ddyo,","poem":1},{"text":"era omukono omutukuvu, gumuwadde obuwanguzi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mukama ayolesezza obulokozi bwe,","poem":1},{"text":"era abikkulidde amawanga obutuukirivu bwe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ajjukidde okwagala kwe okutakoma","poem":1},{"text":"n’obwesigwa bwe eri ennyumba ya Isirayiri.","poem":2},{"text":"Enkomerero z’ensi yonna zirabye","poem":1},{"text":"obulokozi bwa Katonda waffe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Muyimbire Mukama n’essanyu lingi mwe ensi yonna;","poem":1},{"text":"muyimbe ennyimba mu maloboozi ag’essanyu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mutendereze Mukama n’ennanga ez’enkoba;","poem":1},{"text":"n’ennanga ez’enkoba n’amaloboozi ag’okuyimba,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"n’amakondeere n’eddoboozi ly’eŋŋombe.","poem":1},{"text":"Muyimbe n’essanyu mu maaso ga Mukama era Kabaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ennyanja eyire ne byonna ebigirimu,","poem":1},{"text":"n’ensi ne byonna ebigirimu bijaguze.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Emigga gikube mu ngalo","poem":1},{"text":"n’ensozi zonna ziyimbire wamu olw’essanyu;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"byonna biyimbe mu maaso ga Mukama,","poem":1},{"text":"kubanga ajja okulamula ensi.","poem":2},{"text":"Aliramula ensi mu butuukirivu;","poem":1},{"text":"aliramula amawanga mu bwenkanya.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}