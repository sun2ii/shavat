{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"PSA","translationId":"lug_bib","name":"Zabbuli","commonName":"Zabbuli","title":"Zabbuli","order":19,"numberOfChapters":150,"sha256":"66c3ef0dcc738de62ad72c6406cfedda50caae3caabfa55fabd42884f943bbfb","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/lug_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"Mukama afuga,","poem":1},{"text":"amawanga gakankane;","poem":2},{"text":"atuula wakati wa bakerubi,","poem":1},{"text":"ensi ekankane.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mukama mukulu mu Sayuuni;","poem":1},{"text":"agulumizibwa mu mawanga gonna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Amawanga gonna gatendereze erinnya lyo ekkulu era ery’entiisa.","poem":1},{"text":"Mukama mutukuvu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ye Kabaka ow’amaanyi, ayagala obwenkanya.","poem":1},{"text":"Onywezezza obwenkanya;","poem":2},{"text":"era by’okoledde Yakobo bya bwenkanya","poem":1},{"text":"era bituufu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mumugulumize Mukama Katonda waffe;","poem":1},{"text":"mumusinzize wansi w’entebe y’ebigere bye.","poem":2},{"lineBreak":true},{"text":"Mukama mutukuvu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Musa ne Alooni baali bamu ku bakabona be;","poem":1},{"text":"ne Samwiri yali mu abo abaakoowoolanga erinnya lye;","poem":2},{"text":"baasabanga Mukama","poem":1},{"text":"n’abaanukula.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yayogera nabo mu mpagi ey’ekire;","poem":1},{"text":"baagondera amateeka ge n’ebiragiro bye, bye yabawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ayi Mukama Katonda waffe,","poem":1},{"text":"wabaanukulanga;","poem":2},{"text":"n’obeeranga Katonda asonyiwa eri Isirayiri,","poem":1},{"text":"newaakubadde wababonerezanga olw’ebikolwa byabwe ebibi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mugulumizenga Mukama Katonda waffe,","poem":1},{"text":"mumusinzizenga ku lusozi lwe olutukuvu,","poem":2},{"lineBreak":true},{"text":"kubanga Mukama Katonda waffe mutukuvu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}