{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"SNG","translationId":"lug_bib","name":"Oluyimba","commonName":"Oluyimba","title":"Ekitabo Ekiyitibwa Oluyimba","order":22,"numberOfChapters":8,"sha256":"3448ae9f1b90dea97dc15e5add00f50e580d6cd874be489d820ae3bfe336845f","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/lug_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Oluyimba lwa Sulemaani olusinga ennyimba zonna."]},{"type":"verse","number":2,"content":[{"text":"Leka annywegere n’emimwa gye","poem":1},{"text":"kubanga okwagala kwo kusinga envinnyo,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"n’amafuta go gawunya akaloosa akalungi;","poem":1},{"text":"erinnya lyo liri ng’amafuta agattululwa,","poem":2},{"lineBreak":true},{"text":"era abawala kyebava bakwagala.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Baako ne gy’ontwala, yanguwa!","poem":1},{"text":"Kabaka ansembezezza kumpi nnyo antutte mu bisenge bye.","poem":2},"Abemikwano",{"text":"Tunaasanyuka ne tukujagulizaamu;","poem":1},{"text":"era tunaatendereza okwagala kwo okusinga envinnyo.","poem":2},"Omwagalwa",{"text":"Nga batuufu okukwegomba!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ndi muddugavu, ndi mulungi,","poem":1},{"text":"Mmwe abawala ba Yerusaalemi","poem":2},{"text":"muli ng’eweema ez’e Kedali,","poem":1},{"noteId":0},{"text":"era ng’entimbe za Sulemaani.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Temuntunuulira kubanga ndi muddugavu,","poem":1},{"text":"olw’okuba omusana gunjokezza.","poem":2},{"text":"Batabani ba mmange baansunguwalira;","poem":1},{"text":"ne bandagira okukuuma ennimiro ez’emizabbibu.","poem":2},{"lineBreak":true},{"text":"Ennimiro yange ngigayaaliridde.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ntegeeza ggwe gwe njagala, gy’oliisiza ekisibo kyo,","poem":1},{"text":"ne gy’owumuliza endiga zo mu ssaawa ez’omu ttuntu.","poem":2},{"text":"Lwaki mbeera ng’omukazi eyeebisse amaaso","poem":1},{"text":"nga nninaanye ebisibo eby’abanywanyi bo?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bw’oba nga tomanyi, ggwe omukyala asinga bonna obulungi,","poem":1},{"text":"goberera ekkubo endiga lye zikutte,","poem":2},{"text":"ogende oliisize embuzi zo ento,","poem":1},{"text":"okumpi n’eweema z’abasumba.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Omwagalwa wange,","poem":1},{"text":"nkugeraageranya n’embalaasi esika amagaali ga Falaawo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Amatama go galabika bulungi ng’oyambadde ebikomo eby’oku matu,","poem":1},{"text":"n’ensingo yo nerabika bulungi ng’erimu eby’omu bulago eby’omuwendo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tunaakukolera eby’oku matu ebya zaabu,","poem":1},{"text":"nga birina amapeesa aga ffeeza.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kabaka bwe yali ng’atudde ku mmeeza ye,","poem":1},{"text":"akawoowo kange ne kamuwunyira bulungi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Muganzi wange ali ng’ensawo eya kaloosa aka mooli","poem":1},{"noteId":1},{"text":"gye ndi,","poem":1},{"text":"ng’awummulidde mu kifuba kyange.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Muganzi wange ali ng’ekiganda eky’ebimuli ebya kofera","poem":1},{"noteId":2},{"text":"ebivudde mu nnimiro ez’emizabbibu ez’e Engedi.","poem":2},{"noteId":3}]},{"type":"verse","number":15,"content":[{"text":"Laba, oli mubalagavu, omwagalwa wange","poem":1},{"text":"oli mubalagavu olabika bulungi.","poem":2},{"lineBreak":true},{"text":"Amaaso go mayiba.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Olabika bulungi muganzi wange,","poem":1},{"text":"era onsanyusa.","poem":2},{"lineBreak":true},{"text":"Ekitanda kyaffe kya muddo muto.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Emikiikiro gy’ennyumba yaffe mivule,","poem":1},{"text":"n’enzooba zaffe nkanaga.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Abantu b’e Kedali baali Bawalabu abaabeeranga mu bukiikaddyo obw’obuvanjuba wa Edomu. Baabeeranga mu weema ze baakolanga mu maliba g’embuzi enzirugavu.","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"+","text":"Mooli kaloosa kalungi nnyo akakolebwa okuva mu balusamu nga kasangibwa mu Esiyopya, ne mu Buyindi, ne mu nsi za Buwalabu. Mooli yakozesebwanga ng’obuwoowo mu biseera ebyo","reference":{"chapter":1,"verse":13}},{"noteId":2,"caller":"+","text":"Kofera kimuli ky’akaloosa kalungi, era kikolebwamu obuwoowo.","reference":{"chapter":1,"verse":14}},{"noteId":3,"caller":"+","text":"Engedi nsulo y’amazzi esangibwa ku luuyi olw’obugwanjuba bw’Ennyanja ey’Omunnyo, era we luli wamerawo ebimera ebyakaloosa bingi.","reference":{"chapter":1,"verse":14}}]},"thisChapterLink":"/api/lug_bib/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}