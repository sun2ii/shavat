{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"SNG","translationId":"lug_bib","name":"Oluyimba","commonName":"Oluyimba","title":"Ekitabo Ekiyitibwa Oluyimba","order":22,"numberOfChapters":8,"sha256":"3448ae9f1b90dea97dc15e5add00f50e580d6cd874be489d820ae3bfe336845f","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/lug_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Ndi kimuli kya looza ekya Saloni,","poem":1},{"noteId":4},{"text":"eddanga ery’omu biwonvu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ng’eddanga mu maggwa,","poem":1},{"text":"gwe njagala ennyo bw’ali bw’atyo mu baweereza abakazi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ng’omucungwa mu miti egy’omu kibira,","poem":1},{"text":"aŋŋanza bw’ali bw’atyo mu bavubuka.","poem":2},{"text":"Neesiima okutuula mu kisiikirize kye,","poem":1},{"text":"n’ekibala kye kimpomera.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yantwala ku kijjulo,","poem":1},{"text":"n’okwagala kwe ne ku mmaamira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Munzizeemu amaanyi n’ezabbibu enkalu,","poem":1},{"text":"mumbuddeebudde n’emicungwa","poem":2},{"lineBreak":true},{"text":"kubanga okwagala kunzirisizza.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Omukono gwe ogwa kkono guli wansi wa mutwe gwange,","poem":1},{"text":"n’omukono gwe ogwa ddyo gumpambatira.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mmwe abawala ba Yerusaalemi, mbakuutira,","poem":1},{"text":"ng’empeewo n’enjaza ez’omu ttale,","poem":2},{"text":"temusisimula newaakubadde okuzuukusa okwagala","poem":1},{"text":"okutuusa nga kweyagalidde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wuliriza omwagalwa wange,","poem":1},{"text":"Laba, ajja","poem":2},{"text":"ng’abuukirabuukira ku nsozi,","poem":1},{"text":"ng’azinira ku busozi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Omwagalwa wange ali ng’empeewo oba ennangaazi ento.","poem":1},{"text":"Laba ayimiridde emabega w’olukomera lwaffe,","poem":2},{"text":"Alingiza mu madirisa,","poem":1},{"text":"alabikira mu mulimu ogulukibwa ogw’omu ddirisa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Omwagalwa wange yaŋŋamba nti,","poem":1},{"text":"“Golokoka, Owoomukwano,","poem":2},{"lineBreak":true},{"text":"omulungi wange, ojje tugende,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"kubanga laba ttoggo aweddeko,","poem":1},{"text":"n’enkuba eweddeyo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ebimuli bimulisizza,","poem":1},{"text":"n’ebiro eby’okuyimba bituuse,","poem":2},{"text":"era n’okukaaba kw’amayiba","poem":1},{"text":"kuwulirwa mu nsi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Omutiini","poem":1},{"noteId":5},{"text":"gubala ettiini zaagwo,","poem":1},{"text":"n’emizabbibu gimulisizza ne gibunya akawoowo kaagyo.","poem":2},{"text":"Golokoka Owoomukwano,","poem":1},{"text":"omulungi wange ojje tugende.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ggwe ejjiba lyange, eribeera mu njatika ez’omu njazi,","poem":1},{"text":"mu bwekwekero obw’amayinja,","poem":2},{"text":"ndaga amaaso go,","poem":1},{"text":"ka mpulire eddoboozi lyo,","poem":2},{"text":"kubanga eddoboozi lyo ddungi nnyo,","poem":1},{"text":"n’amaaso go gasanyusa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tukwatire ebibe,","poem":1},{"text":"obube obutono,","poem":2},{"text":"obwonoona ennimiro ez’emizabbibu,","poem":1},{"text":"kubanga ennimiro zaffe ez’emizabbibu zimulisizza.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Muganzi wange, wange nzekka, era nange ndi wuwe;","poem":1},{"text":"aliisiza ekisibo kye mu malanga,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"okutuusa obudde nga bukedde","poem":1},{"text":"n’ebisiikirize nga biddukidde ddala;","poem":2},{"text":"okyuke omwagalwa wange obe ng’empeewo","poem":1},{"text":"oba ennangaazi ento ku busozi obw’e Beseri.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Ekimuli kya Looza ekya Saloni kimera ekisangibwa mu nsenyi z’omu bukiikaddyo bwa Kalumeeri.","reference":{"chapter":2,"verse":1}},{"noteId":5,"caller":"+","text":"Emitiini mu Isirayiri gibala emirundi ebiri mu mwaka. Amakungula agasinga galingawo mu biseera ebya ttoggo","reference":{"chapter":2,"verse":13}}]},"thisChapterLink":"/api/lug_bib/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}