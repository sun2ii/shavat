{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"SNG","translationId":"lug_bib","name":"Oluyimba","commonName":"Oluyimba","title":"Ekitabo Ekiyitibwa Oluyimba","order":22,"numberOfChapters":8,"sha256":"3448ae9f1b90dea97dc15e5add00f50e580d6cd874be489d820ae3bfe336845f","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/lug_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Ekiro kyonna nga ndi ku kitanda kyange,","poem":1},{"text":"nalindirira emmeeme yange gw’eyagala,","poem":2},{"lineBreak":true},{"text":"ne munoonya naye saamulaba.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nnaagolokoka ne ntambulatambulako mu kibuga,","poem":1},{"text":"mu nguudo ne mu bifo ebigazi;","poem":2},{"text":"nanoonya emmeeme yange gw’eyagala,","poem":1},{"text":"ne nnindirira naye saamulaba.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abakuumi b’ekibuga","poem":1},{"text":"abaali balawuna mu kibuga, ne bansisinkana, ne mbabuuza nti,","poem":2},{"lineBreak":true},{"text":"“Mundabidde ku oyo emmeeme yange gw’eyagala?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Twali twakayisiŋŋanya,","poem":1},{"text":"ne ndaba oyo emmeeme yange gw’eyagala.","poem":2},{"text":"Ne munnywegera ne simuganya kugenda,","poem":1},{"text":"okutuusa lwe namuleeta mu nnyumba ya mmange,","poem":2},{"lineBreak":true},{"text":"ne mutwala mu kisenge ky’oyo eyanzaala.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mbakuutira mmwe abawala ba Yerusaalemi,","poem":1},{"text":"ng’empeewo n’enjaza ez’oku ttale,","poem":2},{"text":"temusisimula newaakubadde okuzuukusa okwagala","poem":1},{"text":"okutuusa nga kwesiimidde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ani oyo ajja ng’ava mu ddungu,","poem":1},{"text":"afaanana ng’empagi ey’omukka,","poem":2},{"text":"asaabye ebyakaloosa ebya mooli n’omugavu,","poem":1},{"text":"okuva mu byakaloosa byonna eby’omusuubuzi?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Laba, kye kigaali kya Sulemaani,","poem":1},{"text":"ekiwerekeddwako abasajja ab’amaanyi nga nkaaga,","poem":2},{"lineBreak":true},{"text":"abalwanyi abazira abasingayo mu Isirayiri,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"bonna balina ebitala,","poem":1},{"text":"era bamanyirivu mu kulwana;","poem":2},{"text":"buli omu n’ekitala kye mu kiwato kye,","poem":1},{"text":"nga beetegekedde entiisa ey’ekiro.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kabaka Sulemaani yeekolera ekigaali","poem":1},{"text":"eky’emiti egy’omu Lebanooni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Empagi zaakyo yazisiigako ffeeza,","poem":1},{"text":"ne wansi waakyo nga wa zaabu,","poem":2},{"text":"n’entebe yaamu ng’eriko olugoye lwa ffulungu;","poem":1},{"text":"ne munda nga mwaliire bulungi n’okwagala,","poem":2},{"lineBreak":true},{"text":"okw’abawala ba Yerusaalemi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mufulume, mmwe abawala ba Sayuuni,","poem":1},{"text":"mulabe ku Kabaka Sulemaani ng’ayambadde engule,","poem":2},{"lineBreak":true},{"text":"engule nnyina gye yamutikkira","poem":2},{"text":"ku lunaku olw’embaga ye,","poem":1},{"text":"ku lunaku omutima gwe kwe gwasanyukira.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}