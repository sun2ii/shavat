{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"SNG","translationId":"lug_bib","name":"Oluyimba","commonName":"Oluyimba","title":"Ekitabo Ekiyitibwa Oluyimba","order":22,"numberOfChapters":8,"sha256":"3448ae9f1b90dea97dc15e5add00f50e580d6cd874be489d820ae3bfe336845f","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/lug_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Ng’olabika bulungi, gwe njagala, laba ondabikidde bulungi.","poem":1},{"text":"Amaaso go mayiba mu lugoye mw’ogabisse.","poem":2},{"text":"Enviiri zo ziri ng’eggana ly’embuzi","poem":1},{"text":"eziserengeta okuva ku lusozi Gireyaadi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amannyo go gali ng’ekisibo ky’endiga nga kye zijje zisalibweko ebyoya,","poem":1},{"text":"nga ziva okunaazibwa.","poem":2},{"text":"Buli emu nnongo eri n’ennongo ginnaayo,","poem":1},{"text":"so tewali eri yokka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Emimwa gyo giri ng’ewuzi ey’olugoye olutwakaavu;","poem":1},{"text":"n’akamwa ko kandabikira bulungi.","poem":2},{"text":"Amatama go mu lugoye lw’ogabisseeko","poem":1},{"text":"gali ng’ekitundu ky’ekkomamawanga.","poem":2},{"noteId":6}]},{"type":"verse","number":4,"content":[{"text":"Ensingo yo eri ng’omulongooti gwa Dawudi,","poem":1},{"text":"ogwatereezebwa obulungi;","poem":2},{"text":"ne ku gwo nga kuliko engabo lukumi,","poem":1},{"text":"zonna nga ngabo z’abasajja abalwanyi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Amabeere go gombi gali ng’abaana b’empeewo,","poem":1},{"text":"ab’empeewo, nga balongo,","poem":2},{"lineBreak":true},{"text":"abaliira mu malanga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Okutuusa obudde nga bukedde,","poem":1},{"text":"n’ebisiikirize nga biweddewo,","poem":2},{"text":"ndigenda ku lusozi olunene olwa mooli","poem":1},{"text":"ne ku kasozi ak’omugavu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ng’olabika bulungi wenna, omwagalwa wange,","poem":1},{"text":"toliiko bbala na limu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jjangu tuve mu Lebanooni, omugole wange,","poem":1},{"text":"jjangu tuve mu Lebanooni.","poem":2},{"text":"Lengera okuva ku ntikko ya Amana,","poem":1},{"text":"n’okuva ku ntikko ya Seniri ne ku ntikko ya Kerumooni,","poem":2},{"text":"n’okuva mu mpuku ey’empologoma,","poem":1},{"text":"ne ku nsozi ez’engo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Osenzesenze omutima gwange,","poem":1},{"text":"mwannyinaze, omugole wange;","poem":2},{"text":"otutte omutima gwange, ne munye y’eriiso lyo gy’onkubye,","poem":1},{"text":"n’omukuufu ogumu ogw’omu bulago bwo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ng’okwagala kwo kulungi mwannyinaze, omugole wange,","poem":1},{"text":"okwagala kwo nga kusinga nnyo envinnyo,","poem":2},{"lineBreak":true},{"text":"n’akawoowo ak’amafuta go kasinga eby’akawoowo eby’engeri zonna obulungi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Emimwa gyo gitonnya obuwoomi ng’ebisenge eby’omubisi gw’enjuki, omugole wange;","poem":1},{"text":"amata n’omubisi gw’enjuki biri wansi w’olulimi lwo.","poem":2},{"lineBreak":true},{"text":"Akaloosa ak’ebyambalo byo kali ng’akawoowo ak’e Lebanooni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Oli nnimiro eyasimbibwa, mwannyinaze, omugole wange,","poem":1},{"text":"era oli luzzi olwasibibwa","poem":2},{"noteId":7},{"text":", ensulo eyateekebwako akabonero.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ebimera byo nnimiro ya mikomamawanga,","poem":1},{"text":"erina ebibala byonna eby’omuwendo,","poem":2},{"lineBreak":true},{"text":"ne kofera n’emiti egy’omugavu","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"n’omugavu ne kalikomu,","poem":2},{"lineBreak":true},{"text":"ne kalamo ne kinamoni,","poem":2},{"lineBreak":true},{"text":"n’emiti egy’ebika by’omugavu byonna,","poem":2},{"lineBreak":true},{"text":"ne mooli ne alowe,","poem":2},{"lineBreak":true},{"text":"wamu n’eby’akawoowo byonna ebisinga obulungi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Oli nsulo ya nnimiro,","poem":1},{"text":"oluzzi olw’amazzi amalamu,","poem":2},{"lineBreak":true},{"text":"olukulukuta okuva mu Lebanooni.","poem":2},{"noteId":8}]},{"type":"verse","number":16,"content":[{"text":"Zuukuka gwe empewo ey’obukiikakkono,","poem":1},{"text":"naawe empewo ey’obukiikaddyo jjangu.","poem":2},{"noteId":9},{"text":"Mukuntire ku nnimiro yange,","poem":1},{"text":"akaloosa, kaayo akalungi kasaasaane wonna,","poem":2},{"text":"Muleke muganzi wange ajje mu nnimiro ye,","poem":1},{"text":"alye ebibala byamu eby’omuwendo.","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"Amakomamawanga mamyufu","reference":{"chapter":4,"verse":3}},{"noteId":7,"caller":"+","text":"Enzizi zaasibibwanga okukuuma amazzi gaamu nga mayonjo.","reference":{"chapter":4,"verse":12}},{"noteId":8,"caller":"+","text":"Ku ntikko y’Olusozi lwa Lebanooni lwalingako omuzira, ng’eyo amazzi gye gava ne gakola emigga egikulukuta amazzi agatakalira","reference":{"chapter":4,"verse":15}},{"noteId":9,"caller":"+","text":"Empewo ey’obukiikakkono ereeta obunnyogovu era ereka ebibala biramu bulungi. Empewo ey’obukiikaddyo ereeta kibuguumirize, era eyengeza ebibala. Empewo ez’engeri zombi zireeta akawoowo akalungi mu nnimiro","reference":{"chapter":4,"verse":16}}]},"thisChapterLink":"/api/lug_bib/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}