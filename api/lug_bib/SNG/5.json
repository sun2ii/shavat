{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"SNG","translationId":"lug_bib","name":"Oluyimba","commonName":"Oluyimba","title":"Ekitabo Ekiyitibwa Oluyimba","order":22,"numberOfChapters":8,"sha256":"3448ae9f1b90dea97dc15e5add00f50e580d6cd874be489d820ae3bfe336845f","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/lug_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Nzize mu nnimiro yange mwannyinaze, omugole wange;","poem":1},{"text":"nkuŋŋaanyiza mooli yange n’eby’akawoowo byange.","poem":2},{"text":"Ndidde ebisenge byange eby’omubisi gw’enjuki gwange ne nywa n’omubisi gwange,","poem":1},{"text":"Nywedde wayini wange n’amata gange.","poem":2},"Abemikwano",{"text":"Abemikwano mulye munywe, munywere ddala, mmwe abaagalana.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Nnali ngalamidde, ng’omutima gwange guwulira.","poem":1},{"text":"Ne mpulira muganzi wange ng’akonkona, n’ayogera nti,","poem":2},{"text":"“Nziguliraawo mwannyinaze, Owoomukwano, ejjiba lyange,","poem":1},{"text":"owe wange ataliiko bbala,","poem":2},{"text":"kubanga omutwe gwange gutobye omusulo,","poem":1},{"text":"n’enviiri zange zibisiwadde olw’obunnyogovu.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nziggyeko ekkooti yange,","poem":1},{"text":"nnaagyambala ntya nate?","poem":2},{"text":"Nanaabye ebigere,","poem":1},{"text":"nnaddayo ntya mu ttaka gye binaddugalira?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Muganzi wange bwe yakwata ku munyolo,","poem":1},{"text":"omutima gwange ne gubuukabuuka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne ngolokoka okuggulirawo muganzi wange,","poem":1},{"text":"emikono gyange nga gitonnya mooli,","poem":2},{"text":"n’engalo zange nga zikulukuta mooli,","poem":1},{"text":"ku minyolo gy’ekufulu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne ŋŋenda okuggulirawo muganzi wange,","poem":1},{"text":"naye muganzi wange ng’avuddewo,","poem":2},{"lineBreak":true},{"text":"yeetambulidde.","poem":2},{"text":"Omutima gwange gwasanyuka bwe nnawulira eddoboozi lye.","poem":1},{"text":"Ne munoonya naye n’ambula, ne mukoowoola naye nga taddamu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abakuumi baansanga","poem":1},{"text":"bwe baali nga balawuna mu kibuga;","poem":2},{"text":"baankuba, ne bandeetako ebinuubule,","poem":1},{"text":"ne batwala n’ekyambalo kyange,","poem":2},{"lineBreak":true},{"text":"abasajja abo abakuuma bbugwe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mmwe abawala ba Yerusaalemi,","poem":1},{"text":"mbakuutira nti bwe mulaba ku muganzi wange,","poem":2},{"text":"mumutegeeze ng’okwagala kwange","poem":1},{"text":"gy’ali bwe kunzita.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Owange, kiki muganzi wo ky’alina","poem":1},{"text":"kyasinza abalungi abalala ggwe omukazi akira abalala obulungi?","poem":2},{"text":"Kiki muganzi wo kyasinza abalala","poem":1},{"text":"n’okutukuutira n’otukuutira bw’otyo?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Muganzi wange alabika bulungi nnyo era mumyufu,","poem":1},{"text":"atabula ne mu bantu omutwalo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Omutwe gwe gwa zaabu ennongoose ennyo;","poem":1},{"text":"n’enviiri ze zirimu amayengo,","poem":2},{"lineBreak":true},{"text":"era nzirugavu nga nnamuŋŋoona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Amaaso ge gali ng’amayiba","poem":1},{"text":"ku mabbali g’emigga egy’amazzi,","poem":2},{"text":"agaanaazibwa n’amata,","poem":1},{"text":"ne gaba ng’amayinja ag’omuwendo omungi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Amatama ge gali ng’emisiri egy’obuwoowo,","poem":1},{"text":"obuleeta akaloosa akalungi.","poem":2},{"text":"Emimwa gye giri ng’amalanga","poem":1},{"text":"agakulukuta mooli.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Emikono gye giri ng’emitayimbwa egya zaabu","poem":1},{"text":"egiteekebwamu amayinja ag’omuwendo.","poem":2},{"text":"Omubiri gwe guli ng’amasanga","poem":1},{"text":"amayooyote agatoneddwa ne safiro.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Amagulu ge gali ng’empagi ez’amayinja aganyirira","poem":1},{"text":"ezisimbibwa mu zaabu ennungi.","poem":2},{"text":"Mu ndabika afaanana Lebanooni","poem":1},{"text":"omulungi ng’emivule gyayo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Enjogera ye mpomerevu,","poem":1},{"text":"weewaawo awamu n’ebyo byonna ayagalibwa.","poem":2},{"text":"Ono ye muganzi wange, ye mukwano gwange;","poem":1},{"text":"mmwe abawala ba Yerusaalemi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}