{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"SNG","translationId":"lug_bib","name":"Oluyimba","commonName":"Oluyimba","title":"Ekitabo Ekiyitibwa Oluyimba","order":22,"numberOfChapters":8,"sha256":"3448ae9f1b90dea97dc15e5add00f50e580d6cd874be489d820ae3bfe336845f","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/lug_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Muganzi wo alaze wa,","poem":1},{"text":"ggwe akira abakyala bonna obulungi?","poem":2},{"text":"Muganzi wo yakutte lya wa","poem":1},{"text":"tumukunoonyezeeko?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Muganzi wange aserengese mu nnimiro ye,","poem":1},{"text":"mu misiri egy’ebirime ebyakaloosa,","poem":2},{"text":"okulabirira ennimiro ye","poem":1},{"text":"n’okunoga amalanga.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Muganzi wange, wange, nange ndi wuwe;","poem":1},{"text":"anoonyeza mu malanga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Oli mubalagavu nga Tiruza,","poem":1},{"noteId":10},{"text":"omwagalwa wange, omulungi nga Yerusaalemi,","poem":2},{"lineBreak":true},{"text":"era ow’ekitiibwa ng’eggye eririna ebendera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tontunuulira nnyo","poem":1},{"text":"kubanga amaaso go gantawanya.","poem":2},{"text":"Enviiri zo ziri ng’ekisibo eky’embuzi,","poem":1},{"text":"eziserengeta okuva e Gireyaadi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amannyo go gali ng’ekisibo eky’endiga","poem":1},{"text":"eziva okunaazibwa;","poem":2},{"text":"buli emu nnongo eri n’ennongo ginnaayo,","poem":1},{"text":"so tewali eri yokka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Obwenyi bwo bw’obisse mu lugoye,","poem":1},{"text":"buli ng’ebitundu by’amakomamawanga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ne bwe walibeerawo bakabaka abakazi nkaaga,","poem":1},{"text":"n’abazaana kinaana,","poem":2},{"lineBreak":true},{"text":"n’abawala embeerera abatamanyiddwa muwendo,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ejjiba lyange, owange ataliiko bbala, ow’enjawulo,","poem":1},{"text":"mwana muwala eyazaalibwa yekka, ayagalibwa ennyo nnyina","poem":2},{"lineBreak":true},{"text":"okusinga abalala, y’ansingira mu bonna.","poem":2},{"text":"Abawala baamulaba ne bamuyita wa mukisa;","poem":1},{"text":"bakabaka abakazi n’abazaana baamutenda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani ono alabika ng’emmambya,","poem":1},{"text":"omulungi ng’omwezi, atangalijja ng’enjuba,","poem":2},{"lineBreak":true},{"text":"alina ekitiibwa ng’eky’emunnyeenye?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Naserengeta mu nnimiro ey’emiti egy’ensigo okwetegereza","poem":1},{"text":"okumulisa okw’ebimera eby’omu kiwonvu,","poem":2},{"text":"okulaba omuzabbibu obanga gwamulisa,","poem":1},{"text":"n’okulaba emikomamawanga oba nga gyamera.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bwe nnali nkyali awo","poem":1},{"text":"emmeeme yange n’egenda eri amagaali ag’obwakabaka ag’omu bantu bange.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Komawo, Komawo, ggwe Omusulamu;","poem":1},{"text":"komawo, komawo tukutunuleko.","poem":2},"Owoomukwano",{"text":"Lwaki mutunuulira Omusulamu","poem":1},{"text":"ng’abali ku mazina ga Makanayimu?","poem":2}]}],"footnotes":[{"noteId":10,"caller":"+","text":"Tiruza kyali kibuga kya dda mu Kanani ekyalondebwa Yerobowaamu mu 930-909 bc okuba ekibuga ekikulu eky’Obwakabaka bw’omu Bukiikakkono","reference":{"chapter":6,"verse":4}}]},"thisChapterLink":"/api/lug_bib/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}