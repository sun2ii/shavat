{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"SNG","translationId":"lug_bib","name":"Oluyimba","commonName":"Oluyimba","title":"Ekitabo Ekiyitibwa Oluyimba","order":22,"numberOfChapters":8,"sha256":"3448ae9f1b90dea97dc15e5add00f50e580d6cd874be489d820ae3bfe336845f","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/lug_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Ebigere byo nga birabika bulungi mu ngatto,","poem":1},{"text":"ggwe omumbejja!","poem":2},{"text":"Amagulu go gali ng’amayinja ag’omuwendo,","poem":1},{"text":"omulimu gw’omuweesi omukalabakalaba.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ekkundi lyo kibya kyekulungirivu,","poem":1},{"text":"ekitaggwaamu nvinnyo entabule obulungi.","poem":2},{"text":"Ekiwato kyo ntuumu ya ŋŋaano","poem":1},{"text":"eyeetooloddwa amalanga.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Amabeere go gali ng’abaana b’empeewo,","poem":1},{"text":"abalongo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ensingo yo eri ng’omunaala ogw’amasanga.","poem":1},{"lineBreak":true},{"text":"Amaaso go gali ng’ebidiba eby’omu Kesuboni","poem":1},{"text":"ebiri ku mulyango ogw’e Basulabbimu.","poem":2},{"text":"Ennyindo yo eri ng’omulongooti ogw’e Lebanooni","poem":1},{"text":"ogwolekera Ddamasiko.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Omutwe gwo gukuwoomera ng’olusozi Kalumeeri,","poem":1},{"text":"n’enviiri zo ziranga emiguwa egy’effulungu;","poem":2},{"lineBreak":true},{"text":"Kabaka asendebwasendebwa ebintu byakwo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ng’olabika bulungi, ng’osanyusa","poem":1},{"text":"ggwe omwagalwa n’obulungi bwo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Oli muwanvu ng’olukindu,","poem":1},{"text":"n’amabeere go gali ng’ebirimba eby’ebibala byakwo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nayogera nti, “Ndirinnya olukindu,","poem":1},{"text":"era ndikwata ebibala byalwo.”","poem":2},{"text":"Amabeere go gabeere ng’ebirimba eby’oku muzabbibu,","poem":1},{"text":"n’akawoowo ak’omu kamwa ko ng’ebibala eby’omucungwa","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"n’akamwa ko nga nvinnyo esinga obulungi.","poem":2},"Omwagalwa",{"text":"Ne wayini amirwe bulungi muganzi wange,","poem":1},{"text":"ng’akulukuta mpola mpola ku mimwa gy’abo abeebase.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndi wa muganzi wange,","poem":1},{"text":"era naye anjagala nnyo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jjangu, muganzi wange tugende ebweru w’ekibuga,","poem":1},{"text":"tusuleko mu byalo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tukeere tugende mu nnimiro z’emizabbibu,","poem":1},{"text":"tulabe obanga emizabbibu gimulisizza,","poem":2},{"text":"obanga n’ebimuli byagwo byanjuluzza,","poem":1},{"text":"obanga n’emikomamawanga gimulisizza,","poem":2},{"lineBreak":true},{"text":"era eyo gye nnaakulagira okwagala kwange.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Amadudayimu","poem":1},{"noteId":11},{"text":"gawunya akawoowo,","poem":1},{"text":"ne ku miryango gyaffe waliwo ebibala ebisinga obulungi,","poem":2},{"text":"Ebyakanogebwa awamu n’ebikadde,","poem":1},{"text":"bye nkuterekedde muganzi wange.","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"Amadudayimu gayamba mu by’okuzaala","reference":{"chapter":7,"verse":13}}]},"thisChapterLink":"/api/lug_bib/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}