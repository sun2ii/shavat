{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"SNG","translationId":"lug_bib","name":"Oluyimba","commonName":"Oluyimba","title":"Ekitabo Ekiyitibwa Oluyimba","order":22,"numberOfChapters":8,"sha256":"3448ae9f1b90dea97dc15e5add00f50e580d6cd874be489d820ae3bfe336845f","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/lug_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Singa wali muganda wange eyakuzibwa mmange","poem":1},{"text":"era eyayonka amabeere ga mmange,","poem":2},{"text":"nandikusanze ebweru","poem":1},{"text":"nandikunywegedde","poem":2},{"lineBreak":true},{"text":"ne wataba n’omu annyooma.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nandikukulembedde","poem":1},{"text":"ne nkuleeta mu nnyumba ya mmange,","poem":2},{"lineBreak":true},{"text":"oyo eyangigiriza.","poem":2},{"text":"Nandikuwadde wayini okunywa ng’alimu ebyakaloosa,","poem":1},{"text":"omubisi ogw’amakomamawanga gange.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Omukono gwe ogwa kkono guli wansi wa mutwe gwange","poem":1},{"text":"n’omukono gwe ogwa ddyo gumpambaatira.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mmwe abawala ba Yerusaalemi mbakuutira,","poem":1},{"text":"temusiikuula newaakubadde okuzuukusa okwagala","poem":2},{"lineBreak":true},{"text":"okutuusa ng’ekiseera ekituufu kituuse.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ani oyo gwe tulengera ng’ava mu ddungu","poem":1},{"text":"nga yeesigamye muganzi we?","poem":2},"Omwagalwa",{"text":"Nakuzuukusa ng’oli wansi w’omuti ogw’omucungwa.","poem":1},{"text":"Eyo maama wo gye yafunira olubuto era eyo","poem":2},{"lineBreak":true},{"text":"maama wo gye yakuzaalira mu bulumi obungi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nteeka ng’akabonero ku mutima gwo,","poem":1},{"text":"era ng’akabonero ku mukono gwo,","poem":2},{"text":"kubanga okwagala kwa maanyi ng’okufa,","poem":1},{"text":"obuggya bwakwo buli ng’obusungu obw’emagombe.","poem":2},{"text":"Kwaka ng’ennimi ez’omuliro,","poem":1},{"text":"omuliro ogwaka n’amaanyi ennyo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Amazzi amangi tegamalaawo nnyonta ya kwagala","poem":1},{"text":"n’emigga tegiyinza kukumalawo.","poem":2},{"text":"Singa omuntu awaayo","poem":1},{"text":"obugagga bwe bwonna obw’ennyumba ye okufuna okwagala,","poem":2},{"lineBreak":true},{"text":"asekererwa nnyo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tulina muto waffe","poem":1},{"text":"atannamera mabeere,","poem":2},{"text":"naye tulikola tutya","poem":1},{"text":"bw’alituuka okwogerezebwa?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Singa abadde bbugwe","poem":1},{"text":"twandimuzimbyeko eminaala egya ffeeza,","poem":2},{"text":"singa abadde luggi","poem":1},{"text":"twandimuggalidde na mivule.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndi bbugwe","poem":1},{"text":"era n’amabeere gange gali ng’ekitikkiro,","poem":2},{"text":"noolwekyo mu maaso ge,","poem":1},{"text":"mmufuukidde aleeta emirembe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sulemaani yalina ennimiro y’emizabbibu e Baaluka Kamooni,","poem":1},{"text":"n’agisigira abalimi.","poem":2},{"text":"Buli omu ku bo yamusalira","poem":1},{"text":"ebitundu bya ffeeza lukumi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ennimiro yange ey’emizabbibu, yange,","poem":1},{"text":"ebitundu olukumi bibyo ggwe Sulemaani,","poem":2},{"lineBreak":true},{"text":"ebitundu ebikumi bibiri by’abo abalabirira ennimiro.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ggwe abeera mu nnimiro","poem":1},{"text":"ne mikwano gyo nga weebali,","poem":2},{"lineBreak":true},{"text":"ka mpulire eddoboozi lyo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yanguwa okuvaayo eyo,","poem":1},{"text":"odduke mangu ng’empeewo","poem":2},{"text":"oba ng’ennangaazi ento,","poem":1},{"text":"oddukire ku nsozi ezijjudde ebyakaloosa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}