{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ZEC","translationId":"lug_bib","name":"Zekkaliya","commonName":"Zekkaliya","title":"Ekitabo Ekiyitibwa Zekkaliya","order":38,"numberOfChapters":14,"sha256":"c52760de6816e477fd535393eb8bee03c31a28a1042826b6935bd35f6982580e","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/lug_bib/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":10,"content":[{"type":"heading","content":["Mukama Alirabirira Yuda"]},{"type":"verse","number":1,"content":[{"text":"Musabe Mukama enkuba mu biseera byayo;","poem":1},{"text":"kubanga Mukama y’akola ebire","poem":2},{"text":"enkuba n’etonnya,","poem":1},{"text":"olwo buli muntu n’afuna ebirime.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kubanga bakatonda abalala","poem":1},{"text":"n’abalaguzi balaba okwolesebwa okw’obulimba;","poem":2},{"text":"ne baloota ebirooto eby’obulimba,","poem":1},{"text":"ne bagumya abantu eby’obulimba.","poem":2},{"text":"Abantu kyebava bazuŋŋana ng’endiga,","poem":1},{"text":"nga banyigirizibwa olw’obutaba na musumba.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Obusungu bwange bubuubuukidde ku basumba","poem":1},{"text":"era nzija kubonereza abakulembeze ba Yuda,","poem":2},{"text":"kubanga Mukama ow’Eggye ajja","poem":1},{"text":"kulabirira endiga ze, ennyumba ya Yuda,","poem":2},{"lineBreak":true},{"text":"era alibafuula ng’embalaasi ye emwenyumiririzaamu ennyo mu lutalo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mu Yuda mulivaamu ejjinja ery’oku nsonda,","poem":1},{"text":"muveemu n’enkondo enyweza weema,","poem":2},{"lineBreak":true},{"text":"muveemu n’omutego ogw’akasaale","poem":2},{"lineBreak":true},{"text":"era muveemu na buli mufuzi yenna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bonna awamu balyoke babe ng’abasajja abazira ennyo mu lutalo","poem":1},{"text":"abatambulira mu bitoomi by’omu nguudo mu biseera eby’entalo.","poem":2},{"text":"Kubanga Mukama ali nabo,","poem":1},{"text":"balirwana ne bawangula eggye eryebagadde embalaasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Ndiwa ennyumba ya Yuda amaanyi","poem":1},{"text":"era ndiwonya ennyumba ya Yusufu,","poem":2},{"text":"ndibakomyawo","poem":1},{"text":"kubanga mbakwatiddwa ekisa.","poem":2},{"text":"Balibeera","poem":1},{"text":"nga be sseegaanangako","poem":2},{"text":"era ndibawulira","poem":1},{"text":"kubanga nze Mukama Katonda waabwe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Olwo aba Efulayimu baliba ng’abasajja ab’amaanyi,","poem":1},{"text":"emitima gyabwe ne gisanyuka nnyo ng’abanywedde wayini.","poem":2},{"text":"Abaana baabwe balikiraba ne basanyuka,","poem":1},{"text":"omutima gwabwe gulisanyukira mu Mukama.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ddala ndibawonya","poem":1},{"text":"ne mbakuŋŋaanya.","poem":2},{"text":"Ddala ndibanunula,","poem":1},{"text":"baddeyo babeere bangi nga bwe baabanga.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Newaakubadde nga nabasaasaanyiza mu mawanga,","poem":1},{"text":"naye balisinzira eyo mu nsi ezeewala ne banzijukira.","poem":2},{"text":"Bo n’abaana baabwe baliba balamu","poem":1},{"text":"era ne bakomawo gye ndi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndibakomyawo okuva mu Misiri,","poem":1},{"text":"mbakuŋŋaanye okuva mu Bwasuli.","poem":2},{"text":"Ndibaleeta mu Gireyaadi ne Lebanooni","poem":1},{"text":"ne bajjula ensi ezo ne watasigalawo kabanga ka kubeeramu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Baliyita mu nnyanja ey’okubonaabona;","poem":1},{"text":"ennyanja ewuluguma erikkakkanyizibwa,","poem":2},{"lineBreak":true},{"text":"n’obuziba bwa Kiyira bwonna bulikala.","poem":2},{"text":"Amalala ga Bwasuli galibaggwaamu","poem":1},{"text":"n’omugo ogw’obufuzi bwa Misiri gulimenyebwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndibafuula ba maanyi mu Mukama","poem":1},{"text":"era nabo balitambulira mu linnya lyange,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}