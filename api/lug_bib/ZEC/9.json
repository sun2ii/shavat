{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ZEC","translationId":"lug_bib","name":"Zekkaliya","commonName":"Zekkaliya","title":"Ekitabo Ekiyitibwa Zekkaliya","order":38,"numberOfChapters":14,"sha256":"c52760de6816e477fd535393eb8bee03c31a28a1042826b6935bd35f6982580e","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/lug_bib/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"Ekigambo kya Katonda kyolekedde ensi ya Kadulaki","poem":1},{"text":"era kirituuka e Ddamasiko.","poem":2},{"text":"Kubanga abantu bonna n’ebika byonna ebya Isirayiri","poem":1},{"text":"batunuulidde Mukama,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"era ne Kamasi ekiriraanyeewo nakyo bwe kityo,","poem":1},{"text":"ne Ttuulo ne Sidoni wadde nga birina amagezi mangi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ttuulo kyezimbira ekigo","poem":1},{"text":"ne kituuma ffeeza n’eba ng’enfuufu,","poem":2},{"lineBreak":true},{"text":"ne zaabu n’eba nnyingi ng’ettaka ery’omu kkubo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Laba, Mukama alikyambulako ebintu byakyo,","poem":1},{"text":"alizikiriza amaanyi gaakyo ag’oku nnyanja,","poem":2},{"lineBreak":true},{"text":"era kiryokebwa omuliro.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Asukulooni bino kiribiraba ne kitya;","poem":1},{"text":"ne Gaza bwe kityo kiribeera mu kulumwa okw’amaanyi.","poem":2},{"lineBreak":true},{"text":"Era n’essuubi lya Ekuloni liriggwaawo;","poem":2},{"text":"Gaza aliggyibwako kabaka we,","poem":1},{"text":"ne Asukulooni tekiribaamu bantu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abagwira balitwala Asudodi,","poem":1},{"text":"era n’amalala g’Abafirisuuti ndigamalawo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Era ndiggya omusaayi mu kamwa ke","poem":1},{"text":"n’emmere ey’omuzizo okuva wakati mu mannyo ge.","poem":2},{"text":"N’abo bonna abalisigalawo mu kyo baliba bantu ba Katonda waffe,","poem":1},{"text":"balifuuka bakulembeze mu Yuda,","poem":2},{"lineBreak":true},{"text":"ne Ekuloni kiriba nga Abayebusi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Naye ndirwanirira ennyumba yange","poem":1},{"text":"eri eggye eddumbaganyi,","poem":2},{"text":"so tewaliba mulumbaganyi aliddayo kujooga bantu bange","poem":1},{"text":"kubanga kaakano mbalabirira.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sanyuka nnyo ggwe omuwala wa Sayuuni:","poem":1},{"text":"leekaana nnyo, ggwe omuwala wa Yerusaalemi;","poem":2},{"text":"laba, kabaka wo ajja gy’oli;","poem":1},{"text":"mutuukirivu era muwanguzi;","poem":2},{"lineBreak":true},{"text":"muwombeefu era yeebagadde endogoyi,","poem":2},{"lineBreak":true},{"text":"endogoyi ento, omwana gw’endogoyi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Efulayimu ndimuggyako amagaali,","poem":1},{"text":"ne Yerusaalemi muggyeko embalaasi ennwanyi,","poem":2},{"lineBreak":true},{"text":"n’omutego gw’obusaale gulimenyebwa","poem":2},{"text":"era alireeta emirembe mu mawanga,","poem":1},{"text":"n’obufuzi bwe buliva ku nnyanja emu butuuke ku nnyanja endala","poem":2},{"lineBreak":true},{"text":"era buve ku mugga Fulaati butuuke ku nkomerero z’ensi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Naawe ggwe, olw’omusaayi gw’endagaano gye nakola naawe,","poem":1},{"text":"ndisumulula abasibe bo okuva mu bunnya obutaliimu mazzi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mudde mu nkambi yammwe mmwe abasibe abalina essuubi;","poem":1},{"text":"nangirira leero nti ndibadizaawo emirundi ebiri.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yuda ndigiweta ng’omutego ogw’obusaale","poem":1},{"text":"ngujjuze Efulayimu.","poem":2},{"text":"Ndiyimusa batabani ba Sayuuni,","poem":1},{"text":"balwane n’abaana bo, ggwe Buyonaani,","poem":2},{"lineBreak":true},{"text":"mbakozese ng’ekitala eky’omutabaazi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Era Mukama alirabika ng’ali waggulu waabwe,","poem":1},{"text":"akasaale ke kamyanse ng’okumyansa kw’eggulu.","poem":2},{"text":"Mukama Katonda alifuuwa ekkondeere,","poem":1},{"text":"n’akumbira mu muyaga ogw’omu bukiikaddyo.","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mukama ow’Eggye alibakuuma.","poem":2},{"text":"Balirinnyirira ne bawangula envuumuulo,","poem":1},{"text":"balinywa ne baleekaana ng’abatamiivu.","poem":2},{"lineBreak":true},{"text":"Balijjula ng’ekibya ekikozesebwa okumansira ku nsonda z’ekyoto.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ku lunaku olwo Mukama Katonda alirokola abantu be","poem":1},{"text":"ng’omusumba bw’alokola ekisibo ky’endiga ze.","poem":2},{"text":"Balitangalijja mu nsi ye,","poem":1},{"text":"ng’amayinja ag’omuwendo bwe gatemagana mu ngule.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nga baliba balungi era abatuukirivu!","poem":1},{"text":"Emmere ey’empeke erireetera abavubuka abalenzi obulamu obweyagaza,","poem":2},{"lineBreak":true},{"text":"n’abawala nabo beeyagale olwa wayini omuggya.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ZEC/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ZEC/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}