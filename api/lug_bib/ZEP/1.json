{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ZEP","translationId":"lug_bib","name":"Zeffaniya","commonName":"Zeffaniya","title":"Ekitabo Ekiyitibwa Zeffaniya","order":36,"numberOfChapters":3,"sha256":"918a41c9eaf5257648499785d42a8c7ca4bf4fa981d966b470e7925fa41c2f61","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/lug_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Ekigambo kya Mukama ekyajjira Zeffaniya mutabani wa Kuusi, muzzukulu wa Gedaliya, muzzukulu wa Amaliya, muzzukulu wa Keezeekiya, mu mirembe gya Yosiya mutabani wa Amoni, Kabaka wa Yuda."]},{"type":"heading","content":["Okulabula kw’Omusango n’Okuzikirizibwa kwa Yuda"]},{"type":"verse","number":2,"content":[{"text":"“Ndizikiririza ddala byonna okuva ku nsi,” bw’ayogera Mukama.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"“Ndizikiriza abantu wamu n’ensolo;","poem":1},{"text":"ndizikiriza ebinyonyi eby’omu bbanga","poem":2},{"lineBreak":true},{"text":"n’ebyennyanja;","poem":2},{"text":"ababi balisigaza ntuumu ya kafakalimbo;","poem":1},{"text":"bwe ndimalawo abantu okuva ku nsi,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndigololera ku Yuda omukono gwange,","poem":1},{"text":"era ne ku abo bonna abali mu Yerusaalemi;","poem":2},{"text":"era ekitundu kya Baali ekifisseewo n’ennyumba ya Bakemali,","poem":1},{"text":"bakabona abasinza ebifaananyi, ndibazikiriza okuva mu kifo kino,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"abo abavuunamira eggye ery’omu ggulu","poem":1},{"text":"ku nnyumba waggulu,","poem":2},{"text":"ne balisinza n’abo abalayira mu linnya lya Mukama,","poem":1},{"text":"ate nga balayira ne mu linnya lya Malukamu,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"abo abadda emabega obutagoberera Mukama,","poem":1},{"text":"wadde abo abatamunoonya newaakubadde okumwebuuzaako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Siriikirira awali Mukama Katonda,","poem":1},{"text":"kubanga olunaku lwa Mukama luli kumpi.","poem":2},{"text":"Mukama ategese ssaddaaka,","poem":1},{"text":"era atukuzizza abagenyi be.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ku lunaku olwa ssaddaaka ya Mukama,","poem":1},{"text":"ndibonereza abakungu","poem":2},{"lineBreak":true},{"text":"n’abaana ba Kabaka,","poem":2},{"text":"n’abo bonna abambadde","poem":1},{"text":"ebyambalo ebitasaana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Awo ku lunaku olwo ndibonereza","poem":1},{"text":"abo bonna abeewala okulinnya ku muziziko,","poem":2},{"text":"n’abo abajjuza ennyumba ya Mukama waabwe","poem":1},{"text":"ebikolwa eby’obukambwe n’obulimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ku lunaku olwo, bw’ayogera Mukama,","poem":1},{"text":"eddoboozi ery’okukaaba liriwulikika ku Mulyango ogw’Ebyennyanja,","poem":2},{"lineBreak":true},{"text":"okukaaba okuva ku luuyi olwokubiri,","poem":2},{"lineBreak":true},{"text":"n’okubwatuka okunene okuva ku nsozi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mwekaabireko, mmwe abali mu matwale g’akatale;","poem":1},{"text":"abasuubuzi bammwe bonna zibasanze,","poem":2},{"lineBreak":true},{"text":"n’abo abeebinika ffeeza balizikirizibwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Awo olulituuka mu biro ebyo ndimulisa Yerusaalemi n’ettabaaza nga nnoonya,","poem":1},{"text":"mbonereze abo bonna abalagajjavu","poem":2},{"lineBreak":true},{"text":"abali ng’omwenge ogutanasengejjebwa,","poem":2},{"text":"abalowooza nti Mukama","poem":1},{"text":"talibaako ne ky’akolawo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Obugagga bwabwe bulinyagibwa,","poem":1},{"text":"n’ennyumba zaabwe zimenyebwemenyebwe.","poem":2},{"text":"Ne bwe balizimba ennyumba","poem":1},{"text":"tebalizituulamu,","poem":2},{"text":"era balisimba ennimiro ez’emizabbibu nazo","poem":1},{"text":"tebalinywa wayini wamu.","poem":2}]},{"type":"heading","content":["Olunaku lwa Mukama Olukulu"]},{"type":"verse","number":14,"content":[{"text":"Olunaku lwa Mukama olukulu luli kumpi;","poem":1},{"text":"ddala lunaatera okutuuka.","poem":2},{"text":"Wuliriza! Omulwanyi alikaabira eyo ng’aliko obuyinike bungi,","poem":1},{"text":"n’okukaaba ku lunaku lwa Mukama kujja kuba kungi nnyo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Olunaku olwo lunaku lwa busungu,","poem":1},{"text":"lunaku lwa buyinike n’okulaba ennaku,","poem":2},{"text":"lunaku lwa mutawaana n’okuzikirira,","poem":1},{"text":"olunaku olw’ekikome n’ekizikiza,","poem":2},{"lineBreak":true},{"text":"olunaku lw’ebire n’ekizikiza ekikutte ennyo;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"olunaku olw’okufuuwa ekkondeere n’okulangirira olutalo","poem":1},{"text":"ku bibuga ebiriko ebigo","poem":2},{"lineBreak":true},{"text":"n’eri eminaala emigulumivu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ndireeta, obuyinike ku bantu,","poem":1},{"text":"batambule ng’abazibe b’amaaso,","poem":2},{"lineBreak":true},{"text":"kubanga bakoze ebibi mu maaso ga Mukama,","poem":2},{"text":"omusaayi gwabwe guliyiyibwa ng’enfuufu,","poem":1},{"text":"n’ebyenda byabwe bivundire kungulu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Effeeza yaabwe ne zaabu yaabwe","poem":1},{"text":"tebiriyinza kubataasa","poem":2},{"lineBreak":true},{"text":"ku lunaku olw’obusungu bwa Mukama.","poem":2},{"lineBreak":true},{"text":"Ensi yonna erizikirizibwa","poem":1},{"text":"omuliro gw’obuggya bwe,","poem":2},{"text":"era alimalirawo ddala","poem":1},{"text":"abo bonna abali mu nsi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}