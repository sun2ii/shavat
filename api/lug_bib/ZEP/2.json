{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ZEP","translationId":"lug_bib","name":"Zeffaniya","commonName":"Zeffaniya","title":"Ekitabo Ekiyitibwa Zeffaniya","order":36,"numberOfChapters":3,"sha256":"918a41c9eaf5257648499785d42a8c7ca4bf4fa981d966b470e7925fa41c2f61","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/lug_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"heading","content":["Abalabe ba Isirayiri Basalirwa Omusango"]},{"type":"verse","number":1,"content":[{"text":"Mukuŋŋaane, weewaawo, mukuŋŋaane,","poem":1},{"text":"mmwe eggwanga eritalina nsonyi,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ekiseera ekyategekebwa nga tekinnatuuka,","poem":1},{"text":"olunaku ne luba ng’ebisusunku ebifuumulibwa,","poem":2},{"text":"obusungu bwa Mukama nga tebunnabatuukako,","poem":1},{"text":"ng’olunaku olw’obusungu bwa Mukama terunnabatuukako.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Munoonye Mukama, mmwe mwenna abawombeefu ab’omu nsi,","poem":1},{"text":"abakola by’alagira;","poem":2},{"text":"munoonye obutuukirivu n’obuwombeefu;","poem":1},{"text":"mpozzi mulikwekebwa","poem":2},{"lineBreak":true},{"text":"ku lunaku olw’obusungu bwe.","poem":2}]},{"type":"heading","content":["Obubaka eri Abafirisuuti"]},{"type":"verse","number":4,"content":[{"text":"Gaza kirirekebwawo,","poem":1},{"text":"ne Asukulooni kiriba matongo:","poem":2},{"text":"abantu ba Asudodi baligobebwamu mu ttuntu,","poem":1},{"text":"ne Ekuloni kirisimbulibwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zibasanze mmwe ababeera ku lubalama lw’ennyanja,","poem":1},{"text":"eggwanga ery’Abakeresi!","poem":2},{"text":"Ekigambo kya Mukama kikwolekedde,","poem":1},{"text":"ggwe Kanani, ensi ey’Abafirisuuti.","poem":2},{"text":"Ndikuzikiriza","poem":1},{"text":"so tewaliba asigalawo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Olubalama lw’ennyanja ab’Akeresi gye babeera","poem":1},{"text":"luliba malundiro g’abasumba n’ebisulo by’endiga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Olubalama lw’ennyanja luliba lwa kitundu ky’ennyumba ya Yuda ekyasigalawo","poem":1},{"text":"era we banaalundiranga,","poem":2},{"text":"ne mu nnyumba za Asukulooni","poem":1},{"text":"mwe banaagalamiranga akawungeezi.","poem":2},{"text":"Mukama Katonda waabwe alibalabirira,","poem":1},{"text":"n’akomyawo obugagga bwabwe.","poem":2}]},{"type":"heading","content":["Obubaka eri Abamowaabu n’Abamoni"]},{"type":"verse","number":8,"content":[{"text":"Mpulidde okuvuma kwa Mowaabu","poem":1},{"text":"n’okusekerera kw’Abamoni","poem":2},{"text":"kwe bavumye abantu bange","poem":1},{"text":"ne batiisatiisa ensi yaabwe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kale nga bwe ndi omulamu,","poem":1},{"text":"bw’ayogera Mukama Ayinzabyonna, Katonda wa Isirayiri,","poem":2},{"text":"ddala Mowaabu aliba nga Sodomu,","poem":1},{"text":"n’abaana ba Amoni nga Ggomola,","poem":2},{"text":"ekifo emyennyango kye gyemala, n’ebirombe by’omunnyo,","poem":1},{"text":"amatongo agolubeerera. Balinyagibwa abantu bange abaliba basigaddewo,","poem":2},{"text":"n’ekitundu ky’eggwanga lyange ekifisseewo kiritwala ensi yaabwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Eno y’eriba empeera yaabwe olw’amalala gaabwe,","poem":1},{"text":"kubanga bavumye ne banyooma abantu ba Mukama Ayinzabyonna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mukama aliba wa ntiisa gye bali","poem":1},{"text":"bw’alizikiriza bakatonda bonna ab’ensi.","poem":2},{"text":"Amawanga gonna ag’oku mbalama zonna galimusinza,","poem":1},{"text":"buli muntu ng’asinziira mu nsi ye.","poem":2}]},{"type":"heading","content":["Obubaka eri Abaesiyopiya"]},{"type":"verse","number":12,"content":[{"text":"Nammwe Abaesiyopiya, mulittibwa n’ekitala kyange.","poem":1}]},{"type":"heading","content":["Obubaka eri Obwasuli"]},{"type":"verse","number":13,"content":[{"text":"Aligololera omukono gwe ku bukiikakkono","poem":1},{"text":"n’azikiriza Obwasuli;","poem":2},{"text":"n’afuula Nineeve amatongo","poem":1},{"text":"era ekikalu ng’eddungu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ente n’endiga zinaagalamiranga wakati mu kyo,","poem":1},{"text":"n’ensolo zonna eza buli kika:","poem":2},{"text":"ekiwuugulu era ne nnamunnungu","poem":1},{"text":"banaasulanga ku mpagi zaakyo.","poem":2},{"text":"Amaloboozi gaabyo ganaawulikikanga mu madirisa;","poem":1},{"text":"kafakalimbo ajjudde mu miryango,","poem":2},{"lineBreak":true},{"text":"n’emikiikiro egy’emivule giryelulwa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kino kye kibuga ekya kyetwala,","poem":1},{"text":"ekyayogeranga mu mutima gwakyo nti,","poem":2},{"lineBreak":true},{"text":"Nze we ndi, tewali mulala wabula nze:","poem":2},{"text":"nga kifuuse bifulukwa,","poem":1},{"text":"ekifo ensolo ez’omu nsiko we zigalamira!","poem":2},{"text":"Buli muntu akiyitako aneesoozanga","poem":1},{"text":"n’akinyoomoola.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}