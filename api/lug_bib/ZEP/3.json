{"translation":{"id":"lug_bib","name":"Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™","website":"https://ebible.org/Scriptures/details.php?id=lug","licenseUrl":"https://ebible.org/Scriptures/details.php?id=lug","licenseNotes":null,"shortName":"BIB","englishName":"Luganda Bible","language":"lug","textDirection":"ltr","sha256":"339ec515be0910b15254e12315aa6f99385e17dca03a5d4ffb08f6b701f66562","availableFormats":["json"],"listOfBooksApiLink":"/api/lug_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Luganda","languageEnglishName":"Ganda"},"book":{"id":"ZEP","translationId":"lug_bib","name":"Zeffaniya","commonName":"Zeffaniya","title":"Ekitabo Ekiyitibwa Zeffaniya","order":36,"numberOfChapters":3,"sha256":"918a41c9eaf5257648499785d42a8c7ca4bf4fa981d966b470e7925fa41c2f61","firstChapterNumber":1,"firstChapterApiLink":"/api/lug_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/lug_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["Obujeemu bwa Yerusaalemi"]},{"type":"verse","number":1,"content":[{"text":"Zikisanze ekibuga ekijooga,","poem":1},{"text":"ekijeemu era ekyonoonefu!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tekigondera ddoboozi lya Mukama,","poem":1},{"text":"wadde okukkiriza okubuulirirwa;","poem":2},{"text":"tekyesiga Mukama;","poem":1},{"text":"wadde okusemberera Katonda waakyo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abakungu baakyo mpologoma eziwuluguma,","poem":1},{"text":"era n’abalamuzi baakyo misege gya kiro,","poem":2},{"lineBreak":true},{"text":"bakirimululu abatafissaawo kantu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bannabbi baakyo si ba buvunaanyizibwa","poem":1},{"text":"era ba nkwe;","poem":2},{"text":"bakabona baakyo baweebuusizza ekifo ekitukuvu,","poem":1},{"text":"era bamenya amateeka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mukama ali wakati mu kyo, mutuukirivu","poem":1},{"text":"era tasobya.","poem":2},{"text":"Buli nkya alamula mu bwenkanya,","poem":1},{"text":"era buli lukya talemwa;","poem":2},{"lineBreak":true},{"text":"naye atali mutuukirivu taswala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Nsanyizzaawo amawanga,","poem":1},{"text":"era ebigo byabwe bifufuggaziddwa;","poem":2},{"text":"nzisizza enguudo zaabwe,","poem":1},{"text":"ne wataba ayitamu.","poem":2},{"text":"Ebibuga byabwe bizikiridde,","poem":1},{"text":"ne watabaawo muntu n’omu abeeramu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nagamba eri ekibuga nti,","poem":1},{"text":"‘Ddala onontya,","poem":2},{"lineBreak":true},{"text":"era onokkiriza okubuulirirwa.’","poem":2},{"text":"Ennyumba zaakyo tezandimaliddwawo,","poem":1},{"text":"n’ebibonerezo byange byonna tebyandimutuuseeko.","poem":2},{"text":"Naye beesunganga nnyo","poem":1},{"text":"okukola ebitasaana mu byonna bye baakolanga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Noolwekyo munnindirire,” bw’ayogera Mukama.","poem":1},{"text":"Olunaku lwe ndiyimirira ne ntegeeza byonna","poem":2},{"text":"kubanga mmaliridde okukuŋŋaanya amawanga,","poem":1},{"text":"ndireeta obwakabaka wamu","poem":2},{"text":"okubayiwako obusungu bwange,","poem":1},{"text":"n’ekiruyi kyange kyonna.","poem":2},{"text":"Omuliro ogw’obuggya bwange","poem":1},{"text":"gulisaanyaawo ensi yonna.","poem":2}]},{"type":"heading","content":["Essuubi lya Isirayiri"]},{"type":"verse","number":9,"content":[{"text":"“Mu biro ebyo ndirongoosa enjogera ey’amawanga;","poem":1},{"text":"bonna balikoowoola erinnya lya Mukama,","poem":2},{"lineBreak":true},{"text":"okumuweereza n’omwoyo gumu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Okuva emitala w’emigga egy’Obuwesiyopya,","poem":1},{"text":"abo abansinza, abantu bange abasaasaana,","poem":2},{"lineBreak":true},{"text":"balindeetera ssaddaaka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ku lunaku olwo toliswala","poem":1},{"text":"olw’ebyo byonna by’osobezza gye ndi:","poem":2},{"text":"kubanga ndiggya wakati mu ggwe","poem":1},{"text":"abo abeenyumiririza mu malala,","poem":2},{"text":"toliddayo nate kwegulumiza","poem":1},{"text":"ku lusozi lwange olutukuvu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Naye ndireka wakati mu ggwe","poem":1},{"text":"abantu abakakkamu era abeetoowaze,","poem":2},{"lineBreak":true},{"text":"abo abesiga erinnya lya Mukama.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ekitundu kya Isirayiri ekirisigalawo tebalikola bitali bya butuukirivu","poem":1},{"text":"so tebalyogera bya bulimba","poem":2},{"lineBreak":true},{"text":"wadde okuba abakuusa.","poem":2},{"text":"Balirya, baligalamira,","poem":1},{"text":"so tewaliba alibatiisa.”","poem":2}]},{"type":"heading","content":["Oluyimba olw’Essanyu"]},{"type":"verse","number":14,"content":[{"text":"Yimba, ggwe omuwala wa Sayuuni;","poem":1},{"text":"yogerera waggulu, ggwe Isirayiri;","poem":2},{"text":"sanyuka ojaguze n’omutima gwo gwonna,","poem":1},{"text":"ggwe omuwala wa Yerusaalemi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mukama akuggyeeko ekibonerezo kyo,","poem":1},{"text":"agobyewo omulabe wo.","poem":2},{"text":"Kabaka wa Isirayiri, Mukama, ali naawe;","poem":1},{"text":"tokyaddayo kutya kabi konna.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ku lunaku olwo Yerusaalemi kirigambibwa nti,","poem":1},{"text":"“Totya, ggwe Sayuuni;","poem":2},{"lineBreak":true},{"text":"emikono gyo gireme okuddirira.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mukama Katonda ali naawe,","poem":1},{"text":"ow’amaanyi alokola:","poem":2},{"text":"alikusanyukira,","poem":1},{"text":"alikukkakkanyiza mu kwagala kwe,","poem":2},{"lineBreak":true},{"text":"alikusanyukira n’okuyimba.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Ennaku eyabakwatanga olw’embaga ezabakuŋŋaanyanga","poem":1},{"text":"ndigibaggyako;","poem":2},{"lineBreak":true},{"text":"kubanga kibafuukidde omugugu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Laba, mu biro ebyo ndibonereza","poem":1},{"text":"abo bonna abaakubonyaabonya:","poem":2},{"text":"era ndinunula omulema,","poem":1},{"text":"ne nkuŋŋaanya n’abo abaasaasaanyizibwa;","poem":2},{"text":"era ndibafuula ettendo ne mbawa ekitiibwa","poem":1},{"text":"mu nsi zonna gye baaswazibwa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mu biro ebyo ndibakuŋŋaanya;","poem":1},{"text":"mu kiseera ekyo ndibazza eka.","poem":2},{"text":"Weewaawo ndibawa ekitiibwa n’ettendo","poem":1},{"text":"mu mawanga gonna ag’omu nsi zonna,","poem":2},{"text":"bwe ndikomyawo obugagga bwammwe","poem":1},{"text":"nga mulaba,”","poem":2},{"lineBreak":true},{"text":"bw’ayogera Mukama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/lug_bib/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/lug_bib/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/lug_bib/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}