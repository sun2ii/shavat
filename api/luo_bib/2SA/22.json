{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"2SA","translationId":"luo_bib","name":"2 Samuel","commonName":"2 Samuel","title":"Samuel Mar Ariyo","order":10,"numberOfChapters":24,"sha256":"10de90048e6dd11f0fca5090c4bbf4645c895c4af4235bd89eb89b65ed7ce8ad","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/luo_bib/2SA/24.json","totalNumberOfVerses":695},"chapter":{"number":22,"content":[{"type":"heading","content":["Wend Daudi mar pak"]},{"type":"verse","number":1,"content":["Kane Jehova Nyasaye osereso Daudi e lwet wasike duto kod e lwet Saulo, Daudi nowerne Jehova Nyasaye kopake gi weche mag wendni."]},{"type":"verse","number":2,"content":["Nowacho ni:",{"text":"“Jehova Nyasaye en lwandana,","poem":1},{"text":"en ohingana kendo en e jaresna;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nyasacha e lwandana, kuome ema apondoe,","poem":1},{"text":"kendo en e okumbana kendo en e teko mar warruokna.","poem":2},{"text":"En e ohingana, kar pondana,","poem":1},{"text":"kendo jawarna en ema oresa kuom jo-mahundu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Aluongo Jehova Nyasaye, mowinjore pako,","poem":1},{"text":"kendo oresa kuom wasika.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Apaka mag tho nolwora;","poem":1},{"text":"kendo oula mar kethruok nohewa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tonde mag tho nondhoga morida","poem":1},{"text":"kendo obadho mar tho nochika tir.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“E chandruokna ne aluongo Jehova Nyasaye","poem":1},{"text":"kendo naluongo Nyasacha.","poem":2},{"text":"Nowinjo dwonda ka en e hekalu mare","poem":1},{"text":"kendo ywakna nochopo e ite.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Piny notetni kendo oyiengni,","poem":1},{"text":"mise mag polo noyiengni;","poem":2},{"lineBreak":true},{"text":"negitetni nikech nokecho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iro nowuok e ume;","poem":1},{"text":"mach mangʼangʼni nowuokie dhoge,","poem":2},{"lineBreak":true},{"text":"mirni maliel maliet bende nowuok kuome.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nobaro polo mobiro e piny;","poem":1},{"text":"rumbi molil ti nonyono gi tiende.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Noidho kerubi","poem":1},{"text":"mi ofuyogo ka kalausi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Noloso mudho obedo ka hema molwore,","poem":1},{"text":"ma en rumbi motwere mar koth manie polo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ler nowuok kama entie","poem":1},{"text":"mamil ka mil polo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jehova Nyasaye nomor gie polo;","poem":1},{"text":"dwond Nyasaye Man Malo Moloyo nowuo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nodiro aserni mokeyo wasigu,","poem":1},{"text":"mor polo gi mil polo noriembogi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kude mag nam","poem":1},{"text":"kod mise mag piny noelore,","poem":2},{"text":"kane Jehova Nyasaye okwerogi","poem":1},{"text":"kokudho gi much ume.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Norieyo bade ka en malo momaka,","poem":1},{"text":"nogola ei pige matut.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Noresa e lwet jasika maratego,","poem":1},{"text":"kuom jowasika, mane tek moloya.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Negimonja e kinde mane an gi masira,","poem":1},{"text":"to Jehova Nyasaye ema nokonya.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nokela kama ni thuolo;","poem":1},{"text":"noresa nikech nomor koda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Jehova Nyasaye osetimona mana maromre gi timna makare;","poem":1},{"text":"osechula kaluwore gi tich lweta maler.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nimar aserito yore Jehova Nyasaye;","poem":1},{"text":"ok asetimo marach kuom weyo Nyasacha.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Chikene duto ni e nyima;","poem":1},{"text":"pok alokora aweyo buchene.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Asebedo maonge ketho e nyime,","poem":1},{"text":"kendo aseritora mondo kik atim richo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Jehova Nyasaye osemiya pokna mowinjore gi timna makare,","poem":1},{"text":"mana machal gi kaka aler e wangʼe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Ne jo-adiera, ibedonegi ja-adiera,","poem":1},{"text":"to ni joma onge ketho, to ibedonegi maonge ketho,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ne jomaler, inyisori kaka ngʼama ler,","poem":1},{"text":"to ne joma yoregi obam, inyisori kaka ngʼama rach.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ireso joma muol,","poem":1},{"text":"to wangʼi rango josunga mondo idwokgi piny.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"In e tacha, yaye Jehova Nyasaye","poem":1},{"text":"Jehova Nyasaye loko mudho momaka bedo ler.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ka ikonya to anyalo loyo jolweny momonja;","poem":1},{"text":"ka an gi Nyasacha to anyalo lwenyo ohinga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Yor Nyasaye en yo malongʼo;","poem":1},{"text":"wach Jehova Nyasaye onge ketho.","poem":2},{"lineBreak":true},{"text":"En okumba ni jogo duto mopondo kuome.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ere Nyasaye moro makmana Jehova Nyasaye?","poem":1},{"text":"Kendo en ngʼatno ma en Lwanda makmana Nyasachwa?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Nyasaye ema miya teko","poem":1},{"text":"kendo omiyo yora bedo mokwe.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Omiyo tiendena bedo mayot ka tiende mwanda;","poem":1},{"text":"kendo en ema omiyo achungʼ kuonde man malo maboyo.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Otiego lwetena ne lweny;","poem":1},{"text":"bedena nyalo ywayo atungʼ mar nyinyo.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Imiya okumbani mar loch;","poem":1},{"text":"ikulori piny mondo imi abed maduongʼ.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Imiyo yo mawuothoe bedo malach,","poem":1},{"text":"mondo tiendena kik ba yo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"“Ne alawo wasika mi atiekogi;","poem":1},{"text":"ne ok aweyogi nyaka negirumo.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Ne atiekogi chuth, mane ok ginyal chungʼ;","poem":1},{"text":"negipodho e tienda.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Ne imiya teko mar kedo lweny;","poem":1},{"text":"ne imiyo jomamon koda kulore e nyima.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Ne imiyo wasika oringo kadhi,","poem":1},{"text":"mine atieko joma ok dwara.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Ne giywak mondo okonygi,","poem":1},{"text":"to ne onge ngʼama ne nyalo resogi;","poem":2},{"text":"ne giywakne Jehova Nyasaye,","poem":1},{"text":"to ne ok odwokogi.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Ne agoyogi ma giregore ka buru mayom mar lowo;","poem":1},{"text":"nanyonogi mawuotho kuomgi ka chwodho man e yo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"“Iseresa e lwet jowa mane monja;","poem":1},{"text":"iserita kaka jatelo mar ogendini.","poem":2},{"text":"Joma ne ok angʼeyo nobet e bwo lochna,","poem":1}]},{"type":"verse","number":45,"content":[{"text":"kendo jopinje mamoko biro ira kobolore,","poem":2},{"lineBreak":true},{"text":"ka awuoyo to giwinja kendo gitimo gima adwaro.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Negibiro ka gitetni; kendo ka chunygi ool,","poem":1},{"text":"ka gia kuondegi mag pondo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“Jehova Nyasaye ngima! Pak obed ne Lwandana!","poem":1},{"text":"Duongʼ obed ni Nyasaye, ma Lwanda kendo ma Jawarna.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"En e Nyasaye ma chulona kuor,","poem":1},{"text":"maketo ogendini e bwoya,","poem":2}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"ma gonya e lwet wasika.","poem":2},{"text":"Nitingʼa malo moloyo wasika;","poem":1},{"text":"ne iresa e lwet jo-mahundu.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Emomiyo anapaki e kind ogendini, yaye Jehova Nyasaye,","poem":1},{"text":"kendo anawer wende mapako nyingi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"“Jehova Nyasaye kelo resruok maduongʼ ne ruoth moketo;","poem":1},{"text":"onyiso ngʼwonone mogundho ma ok rum ne ngʼate mowir,","poem":2},{"lineBreak":true},{"text":"ni Daudi gi nyikwaye nyaka chiengʼ.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}