mana kuno anachik thuol mikagi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kata dabed ni wasikgi oterogi e twech,","poem":1},{"text":"to kata mana kuno abiro oro ligangla mondo otiekgi.","poem":2},{"lineBreak":true},{"text":"“Anachom wangʼa kuomgi","poem":1},{"text":"mondo atimnegi marach to ok maber.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ruoth Nyasaye, ma en Jehova Nyasaye Maratego,","poem":1},{"text":"ma komulo piny, to piny leny,","poem":2},{"lineBreak":true},{"text":"kendo ji duto modak e piny ywak.","poem":2},{"text":"Piny duto tingʼore malo,","poem":1},{"text":"bangʼe to opie ka aora Nael man Misri!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Jehova Nyasaye gero ute e polo","poem":1},{"text":"kendo orenjo mise mag polo e piny,","poem":2},{"text":"bangʼe oluongo pi nam mondo obi","poem":1},{"text":"kendo oologi e piny, Jehova Nyasaye e nyinge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Donge jo-Israel chalo","poem":1},{"text":"mana gi jo-Kush?” Jehova Nyasaye owacho.","poem":2},{"text":"“Donge an ema ne agolo jo-Israel koa Misri,","poem":1},{"text":"jo-Filistia koa Kaftor,","poem":2},{"lineBreak":true},{"text":"kendo jo-Aram koa Kir?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Adier wangʼ Jehova Nyasaye Manyalo Gik Moko Duto","poem":1},{"text":"rango pinyruoth motimo richo.","poem":2},{"text":"Abiro ketho pinyruodhno e wangʼ piny,","poem":1},{"text":"to kata kamano,","poem":2},{"text":"ok anatiek","poem":1},{"text":"joka Jakobo duto,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye ema owacho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Anagol chik","poem":1},{"text":"kendo abiro piedho jo-Israel,","poem":2},{"lineBreak":true},{"text":"e kind ogendini duto,","poem":2},{"text":"ka cham mipiedho e odheru,","poem":1},{"text":"kendo kata wangʼ cham achiel ok nolwar piny.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Joga duto ma joketho","poem":1},{"text":"ibiro nego gi ligangla,","poem":2},{"text":"kata mana mago mawacho ni,","poem":1},{"text":"‘Masira ok noyudwa kata chopo kuomwa.’","poem":2}]},{"type":"heading","content":["Israel ibiro reso"]},{"type":"verse","number":11,"content":[{"text":"“Chiengʼno anachung od Daudi","poem":1},{"text":"mosepodho.","poem":2},{"text":"Analos ohingane kod","poem":1},{"text":"kuondene momukore duto.","poem":2},{"text":"Anachak agere","poem":1},{"text":"mi ochal kaka,","poem":2},{"lineBreak":true},{"text":"ne entie chon,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"mondo jo-Israel okaw jo-Edom modongʼ kaka margi","poem":1},{"text":"kod ogendini mamoko maluongo nyinga,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye mabiro miyo gima kamano timore ema owacho.","poem":2}]},{"type":"verse","number":13,"content":["Jehova Nyasaye wacho niya,",{"text":"“Ndalo biro ma cham biro bedo mangʼeny,","poem":1},{"text":"ibiro golo pur ka ji pod keyo,","poem":2},{"text":"kendo mzabibu nonyagi mathoth,","poem":1},{"text":"kendo gibiro keto kodhi ka ji pod loso divai.","poem":2},{"text":"Yiend mzabibu mangʼeny maber nonyag mathoth e gode duto","poem":1},{"text":"mi unubed gi divai mangʼeny.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bangʼe abiro miyo joga Israel duogi.","poem":1},{"lineBreak":true},{"text":"“Kendo gibiro gero miechgi mane olokore gundni ma ginidagie,","poem":1},{"text":"eka gibiro pidho yiend mzabibu,","poem":2},{"lineBreak":true},{"text":"kendo madho divai mare.","poem":2},{"text":"Gibiro puro puothegi,","poem":1},{"text":"kendo chamo nyak margi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Abiro guro jo-Israel","poem":1},{"text":"e pinygi mane amiyogi,","poem":2},{"lineBreak":true},{"text":"kendo onge ngʼama nochak ogolgi kendo,”","poem":2},"Jehova Nyasaye ma Nyasachi owacho."]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/OBA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}