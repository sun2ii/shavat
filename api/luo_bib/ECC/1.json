{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"ECC","translationId":"luo_bib","name":"Eklesiastes","commonName":"Eklesiastes","title":"Eklesiastes kata Jayalo","order":21,"numberOfChapters":12,"sha256":"b449525533af996d156e575ec150b4acda2bbe908d1b2d1dc38edd6925800635","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/luo_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":1,"content":[{"type":"heading","content":["Gik moko duto konon to onge tiendgi"]},{"type":"verse","number":1,"content":["Magi e weche mane jayalo ma wuod Daudi, mane ruodh Jerusalem owacho."]},{"type":"verse","number":2,"content":[{"text":"Jayalo wacho niya,","poem":1},{"text":"“Ngima en gima nono!","poem":2},{"text":"Chutho en gima nono!","poem":1},{"text":"Gik moko duto onge tiendgi!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"En ohala mane ma dhano yudo kuom tije duto motiyo","poem":1},{"text":"kendo mochandore godo e bwo wangʼ chiengʼ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tiengʼ ka tiengʼ biro kendo kadho,","poem":1},{"text":"to piny to osiko mana kaka en.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Chiengʼ wuok kendo chiengʼ podho,","poem":1},{"text":"kendo oridore piyo piyo kodok kuma owuokie.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yamo futo kochiko yo milambo","poem":1},{"text":"kendo okudho kochiko yo nyandwat;","poem":2},{"text":"odhi kolworore,","poem":1},{"text":"ndalo duto koduogo kare mapile.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aore duto mol kadhi ei nam,","poem":1},{"text":"to kata kamano nam ok pongʼ.","poem":2},{"text":"To kuma aorego oaye,","poem":1},{"text":"kanyo ema gidwogoe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gik moko duto gin tingʼ mapek,","poem":1},{"text":"moingo ngʼato wacho.","poem":2},{"text":"Kata obedo ni wangʼ neno,","poem":1},{"text":"to gik moneno ok rome,","poem":2},{"text":"to it bende kata obedo ni owinjo gik moko,","poem":1},{"text":"to gik mowinjo ok rome.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gima osebedo biro bedo kendo,","poem":1},{"text":"gima osetim ibiro tim kendo;","poem":2},{"lineBreak":true},{"text":"kendo onge gino manyien e bwo wangʼ chiengʼ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bende nitiere gima ngʼato nyalo wacho ni","poem":1},{"text":"ma en gima nyien?","poem":2},{"text":"Ooyo ok gima nyien, nimar nyalo bedo ni gino nosetimore chon","poem":1},{"text":"kane pok onywolwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Joma chon ok par ngangʼ","poem":1},{"text":"mana kaka tiengʼni bende,","poem":2},{"text":"ok nopar","poem":1},{"text":"gi joma biro luwo bangʼ-gi.","poem":2}]},{"type":"heading","content":["Rieko onge tiende"]},{"type":"verse","number":12,"content":["An, jayalo, asebedo ruodh Israel kadak Jerusalem."]},{"type":"verse","number":13,"content":["Ne achiwora mondo atiegra kendo anon matut kod rieko gigo duto mitimo e bwo polo. Mano doko tingʼ mapek ma Nyasaye oyieyo kuom ji!"]},{"type":"verse","number":14,"content":["Aseneno gik moko mitimo e bwo wangʼ chiengʼ, giduto gionge tiendgi, kendo gichalo mana yamo."]},{"type":"verse","number":15,"content":[{"text":"Gima odol ok nyal rie;","poem":1},{"text":"kendo gima onge ok kwan.","poem":2}]},{"type":"verse","number":16,"content":["Ne aparo e chunya niya, “Koro, asedongo kendo amedora e rieko moloyo ngʼato angʼata moserito Jerusalem motelona; kendo asebedo gi lony e rieko kod ngʼeyo.”"]},{"type":"verse","number":17,"content":["Eka ne achiwora ne winjo tiend rieko, ngʼeyo pogruok manie kind rieko, memruok kod fuwo, to ne afwenyo ni magi gin mana lawo bangʼ yamo mafuto."]},{"type":"verse","number":18,"content":[{"text":"Nimar ne afwenyo ni rieko mangʼeny kelo kuyo;","poem":1},{"text":"kendo ngʼeyo mangʼeny medo mana chuny lit.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}