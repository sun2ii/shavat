{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"EXO","translationId":"luo_bib","name":"Wuok","commonName":"Wuok","title":"Wuok","order":2,"numberOfChapters":40,"sha256":"588d1d97d37e975a8dbdfc68fe90641e3a72f3cc66268e17b7eb05d6665f9640","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/luo_bib/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":15,"content":[{"type":"heading","content":["Wend Musa gi Miriam"]},{"type":"verse","number":1,"content":["Eka Musa gi jo-Israel nowero wendni ni Jehova Nyasaye:",{"text":"“Abiro wer ni Jehova Nyasaye,","poem":1},{"text":"nimar nyinge oromo mi duongʼ.","poem":2},{"text":"Oseumo faras kod jariembne","poem":1},{"text":"ei nam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Jehova Nyasaye e tekrena bende en e wenda;","poem":1},{"text":"kendo osebedo warruokna.","poem":2},{"text":"Anapake nimar en Nyasacha,","poem":1},{"text":"ma Nyasach wuora, kendo abiro miyo nyinge duongʼ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jehova Nyasaye en jalweny;","poem":1},{"text":"Jehova Nyasaye e nyinge.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Noimo geche Farao kod jolwenje","poem":1},{"text":"ei Nam Makwar.","poem":2},{"text":"Jodong Farao mogen","poem":1},{"text":"duto noimo e nam makwar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pige matut oseimogi duto,","poem":1},{"text":"kendo gisenimo nyaka e bwo pi mana ka kidi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Yaye Jehova Nyasaye, lweti ma korachwich","poem":1},{"text":"ne nigi teko maduongʼ.","poem":2},{"text":"Yaye, Jehova Nyasaye lweti ma korachwich","poem":1},{"text":"ema isetiekogo wasigu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Kuom tekoni maduongʼ,","poem":1},{"text":"ne iloyo jogo mane opiem kodi.","poem":2},{"text":"Ne inyiso mirimbi mager","poem":1},{"text":"mi nomwonyogi kaka lum.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Muya mawuok e umi nomiyo","poem":1},{"text":"pige ogingore malo.","poem":2},{"text":"Apaka mar pi nogingore mochungʼ ka kor ot;","poem":1},{"text":"pige man kuonde matut nochokore e chuny nam.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jawasigu nosungore kawacho niya,","poem":1},{"text":"“Abiro lawogi, abiro jukogi.","poem":2},{"text":"Abiro pogo mwandugi;","poem":1},{"text":"abiro yako gimoro amora.","poem":2},{"text":"Abiro golo liganglana","poem":1},{"text":"kendo lweta biro tiekogi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kane ikudho muchi kende,","poem":1},{"text":"to nam noimogi.","poem":2},{"text":"Ne ginimo ka chuma","poem":1},{"text":"e apaka maduongʼ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“En ngʼa machal kodi e kind nyiseche,","poem":1},{"text":"yaye Jehova Nyasaye?","poem":2},{"text":"En ngʼa machalo kodi:","poem":1},{"text":"in miler moloyo,","poem":2},{"text":"in ma in-gi duongʼ moloyo","poem":1},{"text":"kendo matimo honni?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne irieyo badi ma korachwich","poem":1},{"text":"ma piny omwonyogi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Kuom herani ma ok rum,","poem":1},{"text":"ibiro telone oganda ma isereso.","poem":2},{"text":"Kuom tekoni ibiro telonegi","poem":1},{"text":"nyaka kar dakni maler.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Pinje biro winjo mi tetni,","poem":1},{"text":"kihondko biro mako jo-Filistia.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Jodong Edom kibaji biro goyo,","poem":1},{"text":"bende jotend Moab biro tetni,","poem":2},{"text":"to jo-Kanaan chunygi biro nyosore;","poem":1}]},{"type":"verse","number":16,"content":[{"text":"kibaji kod kihondko biro biro kuomgi.","poem":2},{"text":"Kuom teko mar lweti","poem":1},{"text":"gibiro lingʼ thi ka kidi,","poem":2},{"text":"nyaka ogandani kadhi, yaye Jehova Nyasaye,","poem":1},{"text":"nyaka jogi mane ichweyo kadhi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yaye Jehova Nyasaye, ibiro kelogi mi gidonji","poem":1},{"text":"kendo ibiro miyo gibedi ewi godi mar girkeni,","poem":2},{"text":"ma en kama ne iloso kaka kar dakni,","poem":1},{"text":"kendo kama ler mar lemo mane iloso gi lweti,","poem":2},{"lineBreak":true},{"text":"yaye Ruoth Nyasaye.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Jehova Nyasaye biro locho","poem":1},{"text":"nyaka chiengʼ.”","poem":2}]},{"type":"verse","number":19,"content":["Ka farese Farao gi gecheni kod joidh faresene ne odhi e nam, Jehova Nyasaye nomiyo pi nam odok e wangʼe mi oimogi, to jo-Israel nongʼado nam kawuotho ewi lowo motwo."]},{"type":"verse","number":20,"content":["Eka Miriam janabi madhako ma nyamin Harun, nokawo oyieke e lwete kendo mon duto noluwo bangʼe ka gin gi oyieke kendo ka gimiel."]},{"type":"verse","number":21,"content":["Miriam nowernegi niya,",{"text":"“Weruru ni Jehova Nyasaye,","poem":1},{"text":"nimar otingʼe malo ahinya.","poem":2},{"text":"Oseimo faras gi jaithne","poem":1},{"text":"ei nam.”","poem":2}]},{"type":"heading","content":["Pige mag Mara gi Elim"]},{"type":"verse","number":22,"content":["Eka Musa notelo ni Israel kagiwuok e Nam Makwar kendo negidhi ei thim mar Shur. Kuom ndalo adek ne giwuotho e thim ma ok giyudo pi."]},{"type":"verse","number":23,"content":["Kane gichopo Mara, ne ok ginyal modho pi makanyo nikech nokech. (Mano emomiyo kanyo iluongo ni Mara.)"]},{"type":"verse","number":24,"content":["Kuom mano ogandano nongʼur ne Musa kawacho niya, “Wabiro modho angʼo?”"]},{"type":"verse","number":25,"content":["Eka Musa noywak ne Jehova Nyasaye kendo Jehova Nyasaye nonyise yien moro. Nobole ei pi mi pi obedo mamit. Kanyo ema Jehova Nyasaye nomiyogie buche kod chike kendo notemogi."]},{"type":"verse","number":26,"content":["Nowachonegi niya, “Ka uchiko itu maber ne wach Jehova Nyasaye ma Nyasachu ma utimo gima kare e nyim wangʼe, ka urito chikene kendo umako buchene duto, to ok anakel kuomu tuo moro amora mane akelo ne jo-Misri, nimar an Jehova Nyasaye machangou.”"]},{"type":"verse","number":27,"content":["Eka negichopo Elim, kama ne nitie sokni apar gariyo kod yiende mag othidhe piero abiriyo mine gibworo kanyo machiegni gi pi."]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}