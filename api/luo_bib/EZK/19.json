{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"EZK","translationId":"luo_bib","name":"Ezekiel","commonName":"Ezekiel","title":"Ezekiel","order":26,"numberOfChapters":48,"sha256":"030346344d68d3c9f86d325766599b9f4806c1507cd0f688d221331a33bc4cc5","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/luo_bib/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":19,"content":[{"type":"heading","content":["Ywak miywagogo yawuot ruodhi mag Israel"]},{"type":"verse","number":1,"content":["“Chwog wend ywak moro mondo iywag-go yawuot ruodhi mag Israel,"]},{"type":"verse","number":2,"content":["kendo iywag kiwacho niya,",{"text":"“ ‘Mano kaka minu ne en sibuor madhako malich","poem":1},{"text":"e dier sibuoche!","poem":2},{"text":"Ne onindo e dier sibuoche matindo","poem":1},{"text":"kendo ne opidho nyithinde.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne opidho achiel kuom nyithinde","poem":1},{"text":"mi odoko sibuor maratego.","poem":2},{"text":"Ne opuonjore mako le","poem":1},{"text":"kendo odoko jacham ji.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pinje nowinjo humbe","poem":1},{"text":"kendo ne gikunyone bur mi onyumore.","poem":2},{"text":"Ne giywaye gi nyororo","poem":1},{"text":"mi gitere nyaka e piny Misri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ ‘Kane oneno ka genone ok ochopo,","poem":1},{"text":"ka gik mane ogeno yudo oyombe,","poem":2},{"text":"nokawo nyathine machielo,","poem":1},{"text":"kendo nolose obedo sibuor maratego.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne oruto e dier sibuoche,","poem":1},{"text":"nikech koro nosedoko sibuor maratego.","poem":2},{"text":"Nopuonjore mako le","poem":1},{"text":"kendo nodoko jacham ji.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne omuko ohinga mag-gi motegno","poem":1},{"text":"kendo noketho miechgi chuth.","poem":2},{"text":"Piny kaachiel gi ji duto mane ni e iye","poem":1},{"text":"luoro nomako kane giwinje koruto.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Eka pinje noriworene momonje,","poem":1},{"text":"pinje duto mane oa e gwenge molwore.","poem":2},{"text":"Ne gikunyone bur","poem":1},{"text":"mi onyumore.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ne gitweye gi nyororo mi giywaye oko","poem":1},{"text":"kendo negikele ne ruodh Babulon.","poem":2},{"text":"Ne gitere e od twech,","poem":1},{"text":"mondo omi ruto mare kik winjre,","poem":2},{"lineBreak":true},{"text":"kendo ewi gode mag Israel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Minu ne chalo gi yiend mzabibu e puothi mar mzabibu","poem":1},{"text":"mopidhi but pi;","poem":2},{"text":"ne onyak maber kendo nopongʼ gi bedene","poem":1},{"text":"nikech pi mane ngʼeny.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bedene ne otegno,","poem":1},{"text":"kendo noromo bedo ludh loch mar ruoth.","poem":2},{"text":"Nodongo marabora","poem":1},{"text":"moyombo yiende duto,","poem":2},{"text":"kendo nochungʼ maonge yien mipimego","poem":1},{"text":"nikech bedene mathoth mane en-go,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"To kata kamano, ne opudhe gi mirima mager","poem":1},{"text":"mi ogoye piny.","poem":2},{"text":"Yamo ma aa yo wuok chiengʼ nomiyo oner;","poem":1},{"text":"olembege ne olwer mogol kuome;","poem":2},{"text":"kendo bedene maroteke bende notwo","poem":1},{"text":"mi mach nowangʼogi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Koro tinde opidhe e piny motimo ongoro,","poem":1},{"text":"ma en piny motwo kendo man-gi riyo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mach nolandore koa e achiel kuom bedene madongo","poem":1},{"text":"mi nowangʼo olembene.","poem":2},{"text":"Onge bade motegno mane owe kuome","poem":1},{"text":"moromo bedo ludh loch mar jatelo.’","poem":2},"Ma en wend ywak kendo onego oti kode kaka wend ywak.”"]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}