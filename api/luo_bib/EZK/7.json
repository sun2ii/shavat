to wacho:",{"text":"“ ‘Masiche mapok one biro makou!","poem":1},{"text":"Neuru obiro!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Giko osechopo!","poem":1},{"text":"Giko osechopo!","poem":2},{"text":"Osechopo mondo otieki.","poem":1},{"text":"Osechopo adier!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Chandruok osechopo kuomu,","poem":1},{"text":"un joma odak e piny.","poem":2},{"text":"Kinde osechopo! Odiechiengʼ okayo machiegni.","poem":1},{"text":"Nitie luoro maduongʼ, ewi gode, to ok mor.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Achiegni olo mirimba mager kuomu","poem":1},{"text":"kendo abiro toyo mirimba kuomu.","poem":2},{"text":"Abiro ngʼadonu bura kaluwore gi yoreu","poem":1},{"text":"kendo abiro chulou kaluwore gi timbeu duto mamono.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ok abi timonu ngʼwono;","poem":1},{"text":"bende ok abi weyou ma ok akumou.","poem":2},{"text":"Abiro kumou kaluwore gi yoreu","poem":1},{"text":"kod timbeu mamono manie dieru.","poem":2},"Eka unungʼe ni an Jehova Nyasaye, ema akumou."]},{"type":"verse","number":10,"content":[{"text":"“ ‘Neuru odiechiengʼno!","poem":1},{"text":"Odiechiengno koro osechopo!","poem":2},{"text":"Chandruok osechopo,","poem":1},{"text":"kum osedonjo,","poem":2},{"lineBreak":true},{"text":"kendo sunga maru osenenore ratiro!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Timbeu manono osemedore,","poem":1},{"text":"molokore gima ingʼadonugo bura.","poem":2},{"text":"Onge ngʼama ibiro we kuom ji,","poem":1},{"text":"kata kuom ogandano,","poem":2},{"text":"kata mwandu,","poem":1},{"text":"kata gimoro amora maber notieki.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kinde osechopo,","poem":1},{"text":"kendo odiechiengʼ osetundo.","poem":2},{"text":"Kik jangʼiewo bed mamor","poem":1},{"text":"kata jauso kik bed mokuyo,","poem":2},{"lineBreak":true},{"text":"nikech mirimba ni kuom oganda duto.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Jauso ok bi dwokne lowo","poem":1},{"text":"kaponi pod gingima giduto.","poem":2},{"text":"Nikech wach mokor kuom oganda duto","poem":1},{"text":"ok bi loki.","poem":2},{"text":"Onge kata ngʼato achiel","poem":1},{"text":"mabiro reso ngimagi nikech richogi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ ‘Kata gigo turumbete,","poem":1},{"text":"kendo giik gik moko duto mag lweny,","poem":2},{"text":"to onge ngʼama biro dhi e lweny,","poem":1},{"text":"nikech mirimba ni kuom oganda duto.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wasigu ni oko gi ligangla;","poem":1},{"text":"to tuoche kod kech ni e mier.","poem":2},{"text":"Joma ni e gwengʼ","poem":1},{"text":"noneg gi ligangla;","poem":2},{"text":"to joma ni ei dala maduongʼ","poem":1},{"text":"kech gi tuoche nonegi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Joma otony modongʼ","poem":1},{"text":"noringi kadhi ei gode.","poem":2},{"text":"Ginichur ka akuche modak ei holo,","poem":1},{"text":"giduto giniywagi,","poem":2},{"lineBreak":true},{"text":"nikech richogi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bede duto biro wengni;","poem":1},{"text":"kendo chonge duto biro nyosore.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gibiro rwakore gi piende gugru","poem":1},{"text":"kendo midhiero biro pongʼo chunygi.","poem":2},{"text":"Ginibed gi wichkuot,","poem":1},{"text":"kendo ibiro liel yie wigi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“ ‘Gibiro wito fedha mag-gi e wangʼ yore,","poem":1},{"text":"kendo dhahabu mag-gi biro lokore nigi gima ogak.","poem":2},{"text":"Fedha gi dhahabu mag-gi","poem":1},{"text":"ok bi resogi,","poem":2},{"lineBreak":true},{"text":"e odiechiengʼ mar mirimb Jehova Nyasaye.","poem":2},{"text":"Gigo ok notieknegi kech","poem":1},{"text":"kata migi giyiengʼ,","poem":2},{"lineBreak":true},{"text":"nikech gigo osemiyo gidonjo e richo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Negidoko jongʼayi nikech ne gin gi kite ma nengogi tek,","poem":1},{"text":"kendo negitiyo kodgi kuom loso nyiseche manono.","poem":2},{"text":"Negitiyo kodgi kuom loso kido manono;","poem":1},{"text":"emomiyo abiro miyo gigi dokonegi gima ogak.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Abiro kawe mi achiwe ni jopinje mamoko kaka gik mope,","poem":1},{"text":"kendo kaka gik moyaki,","poem":2},{"text":"nachiwe ne joma timbegi mono modak e piny,","poem":1},{"text":"kendo gini dwanye.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Abiro jwangʼogi","poem":1},{"text":"kendo jomecho biro dwanyo kara mageno.","poem":2},{"text":"Gibiro donjo e iye kanyo","poem":1},{"text":"mi gidwanye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“ ‘Losuru nyoroche,","poem":1},{"text":"nikech piny opongʼ gi remo mosechwer,","poem":2},{"lineBreak":true},{"text":"kendo dala maduongʼ opongʼ gi mahundu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Abiro kelo piny ma timbene mono mogik","poem":1},{"text":"mondo okaw miechgi.","poem":2},{"text":"Abiro tieko ngʼayi mar joma roteke,","poem":1},{"text":"kendo ibiro dwanyo kuonde maler mag-gi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ka masira obiro,","poem":1},{"text":"to ginidwar kwe to ok giniyudi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Masira nobi ewi masira,","poem":1},{"text":"kendo weche mifwongʼo mabwogo ji nowinji kuonde duto.","poem":2},{"text":"Ginitem mondo giyud fweny moa kuom janabi,","poem":1},{"text":"gi puonj mag chike moa kuom jadolo,","poem":2},{"text":"kod rieko ma jodongo ngʼado,","poem":1},{"text":"to mago duto nobed maonge.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ruoth noywagi,","poem":1},{"text":"wuod ruoth makawo loch kare chunye nonyosre,","poem":2},{"lineBreak":true},{"text":"kendo bede ji manie piny notetni.","poem":2},{"text":"Abiro tiyo kodgi kaluwore gi timbegi,","poem":1},{"text":"kendo abiro ngʼadonegi bura kaluwore gi chikegi.","poem":2},"Eka giningʼe ni An e Jehova Nyasaye.’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/EZK/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/EZK/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/EZK/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}