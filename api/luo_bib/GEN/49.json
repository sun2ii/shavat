{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"GEN","translationId":"luo_bib","name":"Chakruok","commonName":"Chakruok","title":"Chakruok","order":1,"numberOfChapters":50,"sha256":"885b73236cad1ad612c4c2d05514ab8b3dea920b2dadb84defb88ab90756d107","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/luo_bib/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":49,"content":[{"type":"heading","content":["Jakobo ogwedho yawuote"]},{"type":"verse","number":1,"content":["Eka Jakobo noluongo yawuote mowachonegi niya, “Biuru machiegni mondo anyisu gima biro timorenu e ndalo mabiro."]},{"type":"verse","number":2,"content":[{"text":"“Un yawuot Jakobo","poem":1},{"text":"chokreuru buta kendo uchik itu; winjuru Israel wuonu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Reuben, in e wuoda makayo,","poem":1},{"text":"kendo in e tekona kendo in e ranyisi mokwongo mar tekra,","poem":2},{"lineBreak":true},{"text":"bende in giluor mangʼeny kod teko mangʼeny.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ijamuomri ka pi aora, to ok inibed gi duongʼ,","poem":1},{"text":"nikech isedonjori,","poem":2},{"lineBreak":true},{"text":"gi kitanda wuonu ma ichido.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Simeon gi Lawi gin owete,","poem":1},{"text":"gisetimo timbe mag lweny gi liganglagi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ok nariwra kodgi e buchegi,","poem":1},{"text":"ok nariwra kodgi e chokruogegi,","poem":2},{"text":"nikech ka mirima omakogi to ginego ji","poem":1},{"text":"kendo gingʼado odond dhok sa asaya ka gihero.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Okwongʼ mirimbgi nikech en mirima mager","poem":1},{"text":"kendo makwiny.","poem":2},{"text":"Anakegi e kind joka Jakobo","poem":1},{"text":"kendo akegi e piny Israel duto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Juda, oweteni biro paki;","poem":1},{"text":"bende inimak wasiki gi ngʼutgi,","poem":2},{"lineBreak":true},{"text":"kendo oweteni biro kuloreni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yaye Juda nyathina, ichalo nyathi sibuor,","poem":1},{"text":"modwogo koa dwar.","poem":2},{"text":"Obuto ka sibuor madhako monindo piny,","poem":1},{"text":"maonge ngʼama nyalo chiewo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ludh duongʼ ok noa e lwet Juda","poem":1},{"text":"kata odunga mar teko ok noa e tiende,","poem":2},{"text":"nyaka wuon loch ma biro rito ogendini duto chopi","poem":1},{"text":"kendo luor mar ogendini nobed kuome.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Obiro tweyo pundane e kor mzabibu,","poem":1},{"text":"enotue nyathi pundane e mzabibu moyier;","poem":2},{"text":"kendo obiro luoko","poem":1},{"text":"lepe gi divai makwar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wangʼe nobed makwar moloyo divai","poem":1},{"text":"kendo lake nobed matar ka chak.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Zebulun nodag e dho nam","poem":1},{"text":"kama yiedhi gowe,","poem":2},{"lineBreak":true},{"text":"kendo tongʼ mare nodhi nyaka Sidon.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Isakar en punda maratego","poem":1},{"text":"ma nindo piny e dier misikene.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kane oneno kaka dalane ber,","poem":1},{"text":"kendo kaka pinyno ber,","poem":2},{"text":"noyie tingʼo misigo","poem":1},{"text":"modoko misumba matiyo tich matek.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Dan nobed jangʼad bura ne joge","poem":1},{"text":"mana kaka achiel kuom oganda Israel.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dan nobed ka thuol man e dir yo,","poem":1},{"text":"thuol man-gi kwiri mager e yo,","poem":2},{"text":"ma kayo ombongʼ Faras","poem":1},{"text":"mondo ngʼama oidhe ochwanyre magore piny gi kangʼeye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Aserito warruok yaye Jehova Nyasaye.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Gad to nomonj gi jomecho,","poem":1},{"text":"to noriembgi kolawogi matek.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Asher nobed gi chiemo mamit;","poem":1},{"text":"nobed gi chiemo moromo ruoth chamo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Naftali to en mwanda mogony,","poem":1},{"text":"ma nywolo nyithindo mabeyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Josef en mzabibu manyago olemo","poem":1},{"text":"mopidh e bath thidhna,","poem":2},{"lineBreak":true},{"text":"ma bedene ogawore e kor ot.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Jodir asere nolawe matek kokecho,","poem":1},{"text":"ne gibaye gi asere ka igi owangʼ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kata kamano, Nyasaye Maratego ma Nyasach Jakobo","poem":1},{"text":"noturo atungegi,","poem":2},{"text":"kendo Jakwath, ma Lwanda mar Israel,","poem":1},{"text":"nochodo leche mag ogich bedegi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nyasach wuonuno","poem":1},{"text":"ma en Nyasaye Maratego,","poem":2},{"text":"mondo ogwedhi gi gweth mag polo","poem":1},{"text":"gi gweth mag nyak mag lowo,","poem":2},{"lineBreak":true},{"text":"gi gweth mag nyithindo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Gweth mag wuoro dongo moloyo","poem":1},{"text":"gweth mag gode madongo machon,","poem":2},{"lineBreak":true},{"text":"kendo moloyo gik mabeyo duto mag gode mosiko.","poem":2},{"text":"Gwethgi mondo obi ne Josef,","poem":1},{"text":"ngʼat mane opog gi jowetene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Benjamin en ondiek ma kech kayo;","poem":1},{"text":"gima osenego ochamo gokinyi,","poem":2},{"lineBreak":true},{"text":"kendo godhiambo okidho matindo tindo gima osemako.”","poem":2}]},{"type":"verse","number":28,"content":["Magi e dhout Israel apar gariyo duto kendo mae gima ne wuon-gi owachonegi kane ogwedhogi, ka omiyo moro ka moro gweth moromore kode."]},{"type":"heading","content":["Tho mar Jakobo"]},{"type":"verse","number":29,"content":["Eka Jakobo nochiko yawuote kowachonegi niya, “An koro achiegni tho mondo adhi ariwra gi jowetena, yikauru but kwerena e rogo man e puoth Efron ja-Hiti."]},{"type":"verse","number":30,"content":["Rogo man e puodho man Makpela, machiegni gi Mamre e piny Kanaan, ema ne Ibrahim ongʼiewo kaka kar yiko kaachiel gi puodhono duto koa kuom Efron ja-Hiti."]},{"type":"verse","number":31,"content":["Kanyo ema ne oike Ibrahim kod Sara chiege, kanyo bende ema ne oikie Isaka kod Rebeka chiege, kendo kanyo ema ne aikoe Lea."]},{"type":"verse","number":32,"content":["Puodhono kod rogo duto mane ni e iye nongʼiew koa kuom jo-Hiti.”"]},{"type":"verse","number":33,"content":["Kane Jakobo osetieko wacho wechegi ni yawuote kamano nodwoko tiende e kitanda, mi chunye nochot kendo noluwo kwerene."]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}