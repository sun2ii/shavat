{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"HEB","translationId":"luo_bib","name":"Jo-Hibrania","commonName":"Jo-Hibrania","title":"Jo-Hibrania","order":58,"numberOfChapters":13,"sha256":"3f39d1daf874c39b5b37014801a893347dfcdf9609f0179c73d958aec95630e6","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/luo_bib/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Wuowi nigi duongʼ moloyo malaike"]},{"type":"verse","number":1,"content":["Kinde machon Nyasaye nowuoyo gi kwerewa e yore mangʼeny kendo mopogore opogore, kokalo kuom jonabi,"]},{"type":"verse","number":2,"content":["to e ndalo mogikgi osewuoyo kodwa kokalo kuom Wuode owuon. Wuodeno ema oseketo mwandune duto e lwete, kendo en ema nochweyo gik moko duto kuome."]},{"type":"verse","number":3,"content":["Wuowi ema rieny gi duongʼ maler mar Nyasaye, kendo en e kit Nyasaye hie momako gik moko duto gi wachne man-gi teko. Kane oseloso yor pwodhruok e richo to nobet piny e polo, e bat korachwich mar Nyasaye Man Malo Moloyo duto."]},{"type":"verse","number":4,"content":["Kuom mano, nobedo gi duongʼ moloyo malaike mana kaka nying mane omiye bende nigi duongʼ moloyo malaika."]},{"type":"verse","number":5,"content":["Koso gin malaike mage mane Nyasaye onyiso niya,",{"text":"“In Wuoda;","poem":1},{"text":"kawuono asedoko Wuonu”","poem":2},{"noteId":0},{"text":"?","poem":2},"Kata ni,",{"text":"“Anabed Wuon-gi","poem":1},{"text":"to enobed Wuoda”","poem":2},{"noteId":1},{"text":"?","poem":2}]},{"type":"verse","number":6,"content":["To bende, ka Nyasaye kelo Wuode makayo e piny to owacho niya,",{"text":"“Malaike duto mag Nyasaye mondo olame.”","poem":1},{"noteId":2}]},{"type":"verse","number":7,"content":["Kowuoyo kuom malaike to owacho niya,",{"text":"“Omiyo malaikane bedo yembe,","poem":1},{"text":"kendo jotichne kaka ligek mach.”","poem":2},{"noteId":3}]},{"type":"verse","number":8,"content":["To kuom Wuowi to owuoye niya,",{"text":"“Lochni nosik nyaka chiengʼ, yaye Nyasaye,","poem":1},{"text":"kendo tim makare ema nobed kaka ludh loch e pinyruodhi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isehero tim makare to imon gi timbe maricho;","poem":1},{"text":"emomiyo Nyasaye ma Nyasachi osetingʼi malo moyombo jowadu,","poem":2},{"lineBreak":true},{"text":"nikech osewiri gi mo mamiyi mor.”","poem":2},{"noteId":4}]},{"type":"verse","number":10,"content":["Kamachielo bende owachoe niya,",{"text":"“Yaye Ruoth, kar chakruok ne iketo mise mag piny","poem":1},{"text":"kendo polo bende gin tij lweti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gin to ginilal nono, In to isiko manyaka chiengʼ,","poem":1},{"text":"giduto giniti mana kaka law ti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Iniban-gi giduto mana kaka ibano kandho,","poem":1},{"text":"kendo inilokgi mana kaka iloko nanga.","poem":2},{"text":"In to isiko ichalri mana kaka in,","poem":1},{"text":"kendo hiki ok norum.”","poem":2},{"noteId":5}]},{"type":"verse","number":13,"content":["Koso gin malaike mage ma Nyasaye nonyiso niya,",{"text":"“Bed e bada ma korachwich,","poem":1},{"text":"nyaka chop aket wasiki,","poem":2},{"lineBreak":true},{"text":"e bwo tiendi”?","poem":2},{"noteId":6}]},{"type":"verse","number":14,"content":["Donge malaike duto gin roho ma Nyasaye oketo mondo oti ni joma Nyasaye biro reso?"]}],"footnotes":[{"noteId":0,"caller":"+","text":"Zab 2:7","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"+","text":"2Sam 7:14; 1We 17:13","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"Rap 32:43","reference":{"chapter":1,"verse":6}},{"noteId":3,"caller":"+","text":"Zab 104:4","reference":{"chapter":1,"verse":7}},{"noteId":4,"caller":"+","text":"Zab 45:6,7","reference":{"chapter":1,"verse":9}},{"noteId":5,"caller":"+","text":"Zab 102:25-27","reference":{"chapter":1,"verse":12}},{"noteId":6,"caller":"+","text":"Zab 110:1","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/luo_bib/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}