{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"HOS","translationId":"luo_bib","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"eb092fa2ebe3ba23223df813ce2729d5a6bc40fe936c1ab5cf035427a731b3cd","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/luo_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Israel ne en mzabibu malandore;","poem":1},{"text":"ne onyago olembene owuon.","poem":2},{"text":"Ka olembene ne medore,","poem":1},{"text":"nomedo gero kende mag misango;","poem":2},{"text":"kendo ka pinye ne medo mewo,","poem":1},{"text":"to nomedo loso kido milamo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Chunygi opongʼ gi miriambo","poem":1},{"text":"kendo koro nyaka gitingʼ mana kum marom kodgi.","poem":2},{"text":"Jehova Nyasaye nomuk kendegi mag misango","poem":1},{"text":"kendo kitegi ma gilamo bende nokethi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Eka giniwachi, “Waonge ruoth","poem":1},{"text":"nikech watamore miyo Jehova Nyasaye luor.","poem":2},{"text":"To kata kane wan gi ruoth,","poem":1},{"text":"to dotimonwa angʼo?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Githoro wacho weche manono","poem":1},{"text":"ka gikwongʼore gi miriambo,","poem":2},{"lineBreak":true},{"text":"kendo giloso winjruok ma ok nyal konyogi;","poem":2},{"text":"emomiyo buche mag larruok medore","poem":1},{"text":"mana ka buya malandore e puothe mosepur.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ji modak Samaria luoro osemako","poem":1},{"text":"nikech nyaroya molos gi dhahabu mar Beth Aven.","poem":2},{"text":"Joge noywage,","poem":1},{"text":"kamano bende e kaka jodologe malamo nyiseche manono noywage,","poem":2},{"text":"mago mosebedo gi mor kuom berne","poem":1},{"text":"nikech osegole kuomgi kitere e twech.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enotingʼe kitere Asuria","poem":1},{"text":"kaka mich ne ruoth maduongʼ.","poem":2},{"text":"Efraim noma duongʼne to Israel nokuod wiye","poem":1},{"text":"nikech nyisechene molos gi bao.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Samaria kod ruodhige nolew gi malo","poem":1},{"text":"mana ka bad yien malewo gi malo ewi pi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kuonde motingʼore malo mag anjawo nokethi,","poem":1},{"text":"en emomiyo jo-Israel timo richo.","poem":2},{"text":"Kuthe kod buya ema biro dongo","poem":1},{"text":"maim kendegi mag misango.","poem":2},{"text":"Eka giniwach ne gode madongo niya, “Umwauru!”","poem":1},{"text":"Kendo ne gode matindo niya, “Rwombreuru kuomwa!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Nyaka aa ndalo mar Gibea,","poem":1},{"text":"isebedo ka itimo richo, yaye Israel,","poem":2},{"lineBreak":true},{"text":"to kanyo ema isesike.","poem":2},{"text":"Donge lweny notieko","poem":1},{"text":"jotim richo man Gibea?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ka ahero to abiro kumogi;","poem":1},{"text":"ogendini nonywaknegi,","poem":2},{"lineBreak":true},{"text":"maketgi e twech kuom richogi duto.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efraim en nyaroya mobo","poem":1},{"text":"mohero dino cham;","poem":2},{"text":"omiyo anatwe jok","poem":1},{"text":"e ngʼute maberno.","poem":2},{"text":"Anariemb Efraim,","poem":1},{"text":"to Juda nyaka pur,","poem":2},{"lineBreak":true},{"text":"kendo Jakobo biro baro lowo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Chwouru adiera ne un uwegi,","poem":1},{"text":"kaa-uru olemo mar hera ma ok rum,","poem":2},{"text":"kendo baruru lopu mapok opur,","poem":1},{"text":"nimar en kinde mar manyo Jehova Nyasaye,","poem":2},{"text":"nyaka chop","poem":1},{"text":"ool tim makare kuomu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"To nikech usechwoyo anjawo,","poem":1},{"text":"usekayo timbe maricho,","poem":2},{"lineBreak":true},{"text":"kendo usechamo olemb miriambo.","poem":2},{"text":"Nikech usegeno kuom tekou uwegi","poem":1},{"text":"kendo kuom jolwenju mangʼeny,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"kuom mano koko mar lweny biro monjo jou,","poem":1},{"text":"ma mi kuondeu mochiel motegno nomuki,","poem":2},{"text":"mana kaka Shalman nomuko Beth Arbel e odiechieng lweny,","poem":1},{"text":"kama mine kod nyithindgi nodhir mopodho.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ma e kaka notimre ne un bende, yaye Bethel,","poem":1},{"text":"nikech anjawo maru duongʼ.","poem":2},{"text":"Ka odiechiengno ochopo,","poem":1},{"text":"ruodh Israel notiek chuth.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}