{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"HOS","translationId":"luo_bib","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"eb092fa2ebe3ba23223df813ce2729d5a6bc40fe936c1ab5cf035427a731b3cd","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/luo_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["Hera ma Nyasaye oherogo Israel"]},{"type":"verse","number":1,"content":[{"text":"“Ka Israel ne pod nyathi, ne ahere,","poem":1},{"text":"kendo ne aluongo wuoda ka agolo Misri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"To kaka ne amedo luongo Israel","poem":1},{"text":"e kaka nomedo dhi mabor koda.","poem":2},{"text":"Negichiwo misengini ne Baal","poem":1},{"text":"kendo wangʼo ubani ne kido molosi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"An owuon ema napuonjo Efraim wuotho,","poem":1},{"text":"ka amakogi gi bedegi,","poem":2},{"text":"to ne ok gifwenyo ni ne en","poem":1},{"text":"An mane ochangogi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne atelonegi gi ngʼwono mathoth","poem":1},{"text":"kaachiel gihera ma ok rum;","poem":2},{"text":"ne agolo jok mapek e ngʼutgi","poem":1},{"text":"kendo akulora piny mondo apidhgi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Donge ginidog Misri","poem":1},{"text":"kendo Asuria nobedi gi loch kuomgi,","poem":2},{"lineBreak":true},{"text":"nikech gitamore weyo richogi?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ligangla nomil e miechgi madongo","poem":1},{"text":"manoketh lodi mag rangeyegi,","poem":2},{"lineBreak":true},{"text":"kendo chenro duto magin-go norum.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Joga oramo chuth mondo oweya.","poem":1},{"text":"Kata giluong Nyasaye Man Malo Moloyo,","poem":2},{"lineBreak":true},{"text":"to ok notingʼ-gi malo e yo moro amora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ere kaka anyalo jwangʼou, Efraim?","poem":1},{"text":"Ere kaka dabolu Israel?","poem":2},{"text":"Ere kaka datiu ka Adma?","poem":1},{"text":"Ere kaka damiu ubed machal gi Zeboim?","poem":2},{"text":"Ok anyal timonu kamano;","poem":1},{"text":"nikech aseloko pacha kendo akechou.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ok anaol mirimba mager","poem":1},{"text":"bende ok analokra mi aketh Efraim bende.","poem":2},{"text":"Nimar an Nyasaye, ok an dhano,","poem":1},{"text":"Jal Maler e dieru.","poem":2},{"lineBreak":true},{"text":"Ok anabi gi mirima.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gibiro luwo Jehova Nyasaye,","poem":1},{"text":"noruti ka sibuor.","poem":2},{"text":"Kuruto,","poem":1},{"text":"to nyithinde duto nobi ire katetni kagiwuok yo podho chiengʼ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ginibi ire ka gitetni","poem":1},{"text":"ka winy moa Misri,","poem":2},{"lineBreak":true},{"text":"ka akuche moa Asuria.","poem":2},{"text":"Anami gibed e miechgi,”","poem":1},{"text":"Jehova Nyasaye owacho.","poem":2}]},{"type":"heading","content":["Richo jo-Israel"]},{"type":"verse","number":12,"content":[{"text":"Efraim oselwora gi miriambo,","poem":1},{"text":"od jo-Israel en kar wuond.","poem":2},{"text":"Juda ok winj Nyasaye;","poem":1},{"text":"adier ok giwinj Jal Maler ma ja-adiera.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}