{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"HOS","translationId":"luo_bib","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"eb092fa2ebe3ba23223df813ce2729d5a6bc40fe936c1ab5cf035427a731b3cd","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/luo_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Efraim geno gima onge,","poem":1},{"text":"olawo yamb wuok chiengʼ odiechiengʼ duto,","poem":2},{"lineBreak":true},{"text":"kendo omedo miriambo kod gero.","poem":2},{"text":"Oketo winjruok gi Asuria","poem":1},{"text":"kendo ooro mor zeituni ne jo-Misri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jehova Nyasaye nigi bura kuom jo-Juda;","poem":1},{"text":"enokum Jakobo kaluwore gi yorene;","poem":2},{"lineBreak":true},{"text":"kendo enochule kaluwore gi timbene.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kane pod en ei min nomako tiend owadgi,","poem":1},{"text":"kaka dhano nomako amen gi Nyasaye.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne oii gi malaika mi oloye;","poem":1},{"text":"eka noywak kendo kwayo mondo otimne ngʼwono.","poem":2},{"text":"Noyude Bethel","poem":1},{"text":"kendo mowuoyo kode kanyo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Jehova Nyasaye Maratego,","poem":1},{"text":"Jehova Nyasaye e nyinge mongʼerego!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"To nyaka uduog ir Nyasachu;","poem":1},{"text":"beduru johera kendo joma ngʼado bura makare,","poem":2},{"lineBreak":true},{"text":"bende keturu chunyu kuom Nyasachu kinde duto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Jalok ohala tiyo gi ratinde mag miriambo;","poem":1},{"text":"ohero mecho.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Efraim sungore kawacho ni,","poem":1},{"text":"“An jamoko momewo, kendo asebedo ja-mwandu.","poem":2},{"text":"Gi mwanduna duto ok giniyud gimoro kuoma","poem":1},{"text":"ma miganga kata richo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“An Jehova Nyasaye Nyasachu mane ogolou e piny Misri,","poem":1},{"text":"anami udagi e hembeu kendo,","poem":2},{"text":"mana kaka ndalo","poem":1},{"text":"mane utimoe nyasi mag sawo mau.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne awuoyo kod jonabi,","poem":1},{"text":"ka anyisogi fweny mangʼeny,","poem":2},{"lineBreak":true},{"text":"kendo kawacho ngeche kokalo kuomgi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bende Gilead nigi anjawo?","poem":1},{"text":"Joge gin joma nono!","poem":2},{"text":"Bende gitimo misengini gi rwedhi, Gilgal?","poem":1},{"text":"Kendegi mag misengini biro chalo,","poem":2},{"lineBreak":true},{"text":"kaka kite modhurore e puodho mopur.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Jakobo noringo modhi e piny mar Aram;","poem":1},{"text":"Israel notiyo mondo oyud dhako,","poem":2},{"lineBreak":true},{"text":"kendo nochulo nengo mare kokwayo rombe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Jehova Nyasaye nokonyore gi janabi ma ogolo Israel oa Misri,","poem":1},{"text":"adier ne ooro janabi mondo orite.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"To Efraim osemiye obedo mager mobedo gi mirima;","poem":1},{"text":"Ruodhe nowe timbene maricho mag chwero remo e wiye,","poem":2},{"lineBreak":true},{"text":"kendo nochule kuom ngʼanyone.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}