{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"HOS","translationId":"luo_bib","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"eb092fa2ebe3ba23223df813ce2729d5a6bc40fe936c1ab5cf035427a731b3cd","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/luo_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"heading","content":["Mirimb Jehova Nyasaye kuom jo-Israel"]},{"type":"verse","number":1,"content":[{"text":"Kane Efraim owuoyo, to ji ne tetni,","poem":1},{"text":"nodhiale e piny Israel.","poem":2},{"lineBreak":true},{"text":"To notimo richo kuom lamo Baal, mi notho.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Koro gimedo timo richo,","poem":1},{"text":"bende giloso nyisechegi mag fedha mondo gilam,","poem":2},{"text":"ma gin kido molos gi rieko mangʼeny,","poem":1},{"text":"magi duto gin tich jopa bepe.","poem":2},{"text":"Wachore kuom jogi niya,","poem":1},{"text":"“Gitimo misango gi dhano,","poem":2},{"lineBreak":true},{"text":"kendo ginyodho kido molos mar nyaroya.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Emomiyo ginichal mana kaka ongʼwengʼo mokinyi,","poem":1},{"text":"bende kaka thoo mar okinyi malal nono ka nyango owuok,","poem":2},{"lineBreak":true},{"text":"bende kaka mihudhwe ma yamo keyo kar dino,","poem":2},{"lineBreak":true},{"text":"bende kaka iro mawuok e dirisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“To An e Jehova Nyasaye ma Nyasachu","poem":1},{"text":"mane ogolou ua e piny Misri.","poem":2},{"text":"Ok unyal yango Nyasaye moro amora ma ok An,","poem":1},{"text":"onge Jawar machielo makmana An.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne aritou e piny motwo,","poem":1},{"text":"maliel ka mach.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kane apidhogi ne giyiengʼ chuth;","poem":1},{"text":"kane giseyiengʼ to sunga nomakogi;","poem":2},{"lineBreak":true},{"text":"ma wigi owil koda.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Omiyo anabi irgi ka sibuor,","poem":1},{"text":"kendo ka kwach abiro buto negi e bath yo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Anamonjgi mi ayiechgi matindo tindo","poem":1},{"text":"mana ka ondiek ma omaa nyithinde.","poem":2},{"text":"Anatiekgi mana ka sibuor,","poem":1},{"text":"bende le mag bungu noyiechgi matindo tindo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Osetieku yaye Israel, nikech ok udwara,","poem":1},{"text":"ok udwar jakonyu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ere ruodhu mondo koro oresu?","poem":1},{"text":"Ere jotendu e miechu,","poem":2},{"text":"mane usekwayo ni,","poem":1},{"text":"‘Miwa ruodh kod jotendwa?’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kuom ich wangʼ mare ne amiyou ruoth","poem":1},{"text":"kendo e mirimba ne agole oko.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Timbe mamono mag Efraim osekan,","poem":1},{"text":"kendo richoge osendik e kitabu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Rem machalo gi mar dhako mamuoch kayo nobine,","poem":1},{"text":"to en nyathi maonge gi rieko,","poem":2},{"text":"ma ka sa ochopo monego owuog e ich","poem":1},{"text":"to okia kama iwuok godo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Abiro resogi kuom teko mar piny joma otho","poem":1},{"text":"kendo anakonygi kuom tho.","poem":2},{"text":"In tho, ere masicheni duto,","poem":1},{"text":"kata in piny joma otho, ere kethruokni?","poem":2},{"lineBreak":true},{"text":"“Ok anakeche,","poem":1}]},{"type":"verse","number":15,"content":[{"text":"kata ka obedo ni odhi maber kamano e kind owetene.","poem":2},{"text":"Yamb yor wuok chiengʼ moa ir Jehova Nyasaye nobi,","poem":1},{"text":"kakudho koa e piny motwo,","poem":2},{"text":"ma pigene mag sokni mamol nodwon,","poem":1},{"text":"kod yewni mokuny bende nodwon.","poem":2},{"text":"Mwandune manie dechege","poem":1},{"text":"noyaki duto.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Jo-Samaria nokum kuom richogi","poem":1},{"text":"nikech gisengʼanyo ne Nyasachgi.","poem":2},{"text":"Noneg-gi gi ligangla;","poem":1},{"text":"nyithindgi matindo nochwad piny,","poem":2},{"lineBreak":true},{"text":"to mondgi mapek nobar iyegi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":16}