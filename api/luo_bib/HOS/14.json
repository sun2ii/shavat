{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"HOS","translationId":"luo_bib","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"eb092fa2ebe3ba23223df813ce2729d5a6bc40fe936c1ab5cf035427a731b3cd","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/luo_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"heading","content":["Lokruok kuom richo kelo gweth"]},{"type":"verse","number":1,"content":[{"text":"Dwoguru ir Jehova Nyasaye ma Nyasachu, yaye Israel.","poem":1},{"text":"Richou ema osemiyo upodho.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kaw wechegi","poem":1},{"text":"kendo uduog ir Jehova Nyasaye!","poem":2},{"text":"Wachne kama:","poem":1},{"text":"“Wenwa richowa duto,","poem":2},{"text":"kendo yie irwakwa gi ngʼwono,","poem":1},{"text":"mi wanapaki gi dhowa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asuria ok nyal resowa,","poem":1},{"text":"bende ok wana idhi faresegi mag lweny.","poem":2},{"text":"Ok wanachak wawach kendo ni,","poem":1},{"text":"‘Nyisechewa’ ne gik mwaloso gi lwetwa wawegi,","poem":2},{"lineBreak":true},{"text":"nimar kuomi, ema, nyithi kiye yude kech.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Anachang-gi kuom baro margi mane gibarogo,","poem":1},{"text":"kendo anahergi maonge achuna,","poem":2},{"lineBreak":true},{"text":"nimar mirimba osewuok kuomgi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Anachal mana ka thoo mar okinyi ne Israel;","poem":1},{"text":"kendo nolodhi mana ka ondanyo,","poem":2},{"text":"kendo tiende nokar","poem":1},{"text":"mana ka yiend Lebanon;","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"bade nolodhi makee.","poem":2},{"text":"Enobed maber ka yiend zeituni,","poem":1},{"text":"kendo nodungʼ mangʼwe ngʼar ka yiend Lebanon.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ji nochak odag e tipone.","poem":1},{"text":"Nonyaa maber mana ka cham,","poem":2},{"text":"kendo nonyag maber ka mzabibu","poem":1},{"text":"mi nobed gi huma ka divai moa Lebanon.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yaye Efraim en angʼo ma datim gi nyiseche manonogi kendo?","poem":1},{"text":"Anadwoke kendo rite,","poem":2},{"text":"achalo gi obudo mangʼich,","poem":1},{"text":"nyak mari aa kuoma.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"En ngʼat mane mariek?","poem":1},{"text":"Obiro fwenyo tiend gigi.","poem":2},{"text":"En ngʼat mane manyalo fwenyo tiend wechegi?","poem":1},{"text":"Obiro ngʼeyogi.","poem":2},{"text":"Yore mag Jehova Nyasaye nikare,","poem":1},{"text":"joma nikare ema wuothoe,","poem":2},{"lineBreak":true},{"text":"to joma jendeke to chwanyore.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}