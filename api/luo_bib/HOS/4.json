{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"HOS","translationId":"luo_bib","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"eb092fa2ebe3ba23223df813ce2729d5a6bc40fe936c1ab5cf035427a731b3cd","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/luo_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["Bura mondonjnego jo-Israel"]},{"type":"verse","number":1,"content":[{"text":"Winjuru wach Jehova Nyasaye, un jo-Israel,","poem":1},{"text":"nikech Jehova Nyasaye nigi wach modonjonugo,","poem":2},{"lineBreak":true},{"text":"un ji modak e piny:","poem":2},{"text":"“Onge adiera, onge hera,","poem":1},{"text":"bende udagi yie ni Nyasaye nitie e piny.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nitie mana kwongʼ, miriambo kod nek,","poem":1},{"text":"kuo gi chode;","poem":2},{"text":"kendo giketho singruok duto,","poem":1},{"text":"kendo chwero remo timore monwore.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nikech ma, piny opongʼ gi kuyo","poem":1},{"text":"kendo ji modak e iye dhero kendo tho;","poem":2},{"text":"ondiegi manie thim gi winy mafuyo e kor polo","poem":1},{"text":"gi rech manie nembe tho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Kik ngʼato kel wach mar donjo,","poem":1},{"text":"kik ngʼato donjne wadgi,","poem":2},{"text":"nimar jou chalo","poem":1},{"text":"mana ka joma donjo ni jadolo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Uchwanyoru odiechiengʼ gotieno","poem":1},{"text":"to jonabi bende chwanyore mana kaka un.","poem":2},{"text":"Omiyo abiro tieko minu.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Joga itieko nikech chando ngʼeyo.","poem":2},{"lineBreak":true},{"text":"“Nikech utamoru dwaro ngʼeyo,","poem":1},{"text":"an bende adagiu kaka jodolona;","poem":2},{"text":"nikech usejwangʼo chike mag Nyasachu,","poem":1},{"text":"an bende anajwangʼ nyithindu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kaka jodolo medore,","poem":1},{"text":"e kaka gimedo timo richo e nyima;","poem":2},{"lineBreak":true},{"text":"gisewilo duongʼ margi gi gima kelo wichkuot.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Giyiengʼ gi richo mag joga,","poem":1},{"text":"bende gimor gi timbegi maricho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kendo obiro bet ni: Kaka ji chalo e","poem":1},{"text":"kaka jodolo bende chalo.","poem":2},{"text":"To abiro kumogi kuom yoregigo,","poem":1},{"text":"kendo anachulgi machal gi timbegi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Gibiro chiemo to ok giniyiengʼ;","poem":1},{"text":"gibiro chodo to ok gini nywolre,","poem":2},{"text":"nikech giseweyo Jehova Nyasaye,","poem":1},{"text":"mondo gichiwre","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ne chode,","poem":2},{"text":"ne kongʼo machon kod kongʼo manyien,","poem":1},{"text":"magolo winjo mar joga.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gipenjo wach kuom nyasaye molos gi bao","poem":1},{"text":"kendo idwokogi gi yien mopa.","poem":2},{"text":"Chuny mar chode terogi mabor;","poem":1},{"text":"ok gin jo-adier ne Nyasachgi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gitimo misango ewi gode maboyo","poem":1},{"text":"kendo gitimo Sewni kuonde motingʼore gi malo,","poem":2},{"text":"e tiend yiend ober, gi omburi kod yiende mamoko madongo dongo kendo boyo,","poem":1},{"text":"kama otimo tipo maber.","poem":2},{"text":"Emomiyo nyiu lokore ochode","poem":1},{"text":"to mond yawuotu to donjo e chode.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Ok anakum nyiu","poem":1},{"text":"ka gibedo ochode,","poem":2},{"text":"kata mond yawuotu","poem":1},{"text":"ka terore,","poem":2},{"text":"nikech chwo giwegi","poem":1},{"text":"ema dhi ir mon ma jochode,","poem":2},{"lineBreak":true},{"text":"gi mon manie hekalu mar Baal.","poem":2},{"text":"Joma onge ngʼeyo","poem":1},{"text":"biro yudo chandruok!","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Yaye Israel, kata obedo ni utimo anjawo mar chode,","poem":1},{"text":"kik umi Juda donj e timbego.","poem":2},{"lineBreak":true},{"text":"“Kik udhi Gilgal;","poem":1},{"text":"kik udhi Beth Aven.","poem":2},{"lineBreak":true},{"text":"Kendo kik ukwongʼru kuwacho niya,","poem":2},{"text":"‘Akwongʼora gi nying Jehova Nyasaye mangima!’","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Jo-Israel wigi tek","poem":1},{"text":"mana ka roya bwongʼ ma wiye tek.","poem":2},{"text":"Ere kaka Jehova Nyasaye nyalo kwayogi e lek","poem":1},{"text":"kaka ikwayo rombe e lek man-gi lum?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Jo-Efraim oriwore gi nyiseche manono;","poem":1},{"text":"weyeuru kamano!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kata ka kong-gi orumo,","poem":1},{"text":"to gidhi nyime gi timbegi mag chode;","poem":2},{"lineBreak":true},{"text":"jotendgi ohero timbe makelo wichkuot.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kalausi biro tingʼogi matergi mabor,","poem":1},{"text":"kendo misenginigi nokelnegi wichkuot.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}