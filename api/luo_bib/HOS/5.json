{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"HOS","translationId":"luo_bib","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"eb092fa2ebe3ba23223df813ce2729d5a6bc40fe936c1ab5cf035427a731b3cd","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/luo_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["Kum ni jo-Israel"]},{"type":"verse","number":1,"content":[{"text":"“Winjuru ma, un jodolo!","poem":1},{"text":"Chikuru itu, un jo-Israel!","poem":2},{"text":"Winjuru, yaye jood ruoth!","poem":1},{"text":"Kumni obironu:","poem":2},{"text":"Usebedo obadho e Mizpa,","poem":1},{"text":"gogo mopedhi ewi Tabor.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Joma ongʼanyo ni e tho malich.","poem":1},{"text":"Abiro kumogi giduto.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Angʼeyo gik moko duto kuom Efraim;","poem":1},{"text":"onge gima opondona kuom jo-Israel.","poem":2},{"text":"Efraim, un to usedoko kaka ochot;","poem":1},{"text":"to jo-Israel timo timbe modwanyore.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Timbegi omonogi","poem":1},{"text":"duogo ir Nyasachgi.","poem":2},{"text":"Tim marach mar chode ni e chunygi;","poem":1},{"text":"ok giyie kuom Jehova Nyasaye.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sungruok mar jo-Israel nyiso rachgi;","poem":1},{"text":"jo-Israel kaachiel gi Efraim podho e richogi;","poem":2},{"lineBreak":true},{"text":"kendo jo-Juda bende podho kodgi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ka gidhi gi kweth dhogi kaachiel gi chiachgi","poem":1},{"text":"mondo gitim misengni ni Jehova Nyasaye,","poem":2},{"text":"to ok giniyude","poem":1},{"text":"nikech osewuok moa kuomgi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gisebedo joma ok jo-adiera ni Jehova Nyasaye;","poem":1},{"text":"ginywolo nyithindo ma kimirwa.","poem":2},{"text":"Sewni ma gitimo ka dwe owuok","poem":1},{"text":"biro tiekogi kaachiel gi puothegi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Gouru turumbete e dala mar Gibea,","poem":1},{"text":"gouru abu e dala mar Rama.","poem":2},{"text":"Gouru nduru mar lweny e dala mar Beth Aven;","poem":1},{"text":"yaye, jo-Benjamin teluru.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Efraim biro bet gunda","poem":1},{"text":"ka chiengʼ makumogie ochopo.","poem":2},{"text":"Alando gima nyaka timre","poem":1},{"text":"e kind dhout Israel.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jotend Juda chalo gi joma","poem":1},{"text":"ochoro kite man e kiewo.","poem":2},{"text":"Abiro olo mirimba kuomgi","poem":1},{"text":"mana ka pi oula.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jo-Efraim ibiro toyo","poem":1},{"text":"ka bura oloyogi,","poem":2},{"text":"nikech giketo chunygi mar luwo nyiseche manono.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Achalo gi oguyo ne jo-Efraim,","poem":1},{"text":"achalo gima otop ne jo-Juda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Ka Efraim noneno tuone,","poem":1},{"text":"kendo Juda oneno adhondene,","poem":2},{"text":"eka Efraim nodwaro kony kuom Asuria,","poem":1},{"text":"kendo gikwayo kony ir ruoth maduongʼ.","poem":2},{"text":"To ok onyal thiedhou,","poem":1},{"text":"ok onyal thiedho adhondeu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abiro bedo ka sibuor ni Efraim,","poem":1},{"text":"kaka sibuor malich ni Juda.","poem":2},{"text":"Abiro kidhogi matindo tindo bangʼe to abiro weyogi.","poem":1},{"text":"Anatingʼ-gi matergi mabor,","poem":2},{"lineBreak":true},{"text":"maonge ngʼama nyalo resogi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bangʼe to anadog kar dakna,","poem":1},{"text":"nyaka chop kinde maginiyie ni giseketho.","poem":2},{"text":"Giniduog ira ka gidwara gi chunygi duto","poem":1},{"text":"nikech thagruok malit magiseyudo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}