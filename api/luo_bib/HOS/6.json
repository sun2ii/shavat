{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"HOS","translationId":"luo_bib","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"eb092fa2ebe3ba23223df813ce2729d5a6bc40fe936c1ab5cf035427a731b3cd","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/luo_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["Jo-Israel odagi lokore"]},{"type":"verse","number":1,"content":[{"text":"“Biuru mondo wadog ir Jehova Nyasaye.","poem":1},{"lineBreak":true},{"text":"Osekidhowa matindo tindo","poem":1},{"text":"to obiro changowa;","poem":2},{"text":"osehinyowa","poem":1},{"text":"to obiro tweyo adhondewa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bangʼ ndalo ariyo obiro duogo chunywa","poem":1},{"text":"to e odiechiengʼ mar adek obiro resowa,","poem":2},{"lineBreak":true},{"text":"mondo omi wadag kode.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Waluonguru Jehova Nyasaye;","poem":1},{"text":"wadhiuru nyime gi luongo nyinge.","poem":2},{"text":"Mana kaka chiengʼ wuok,","poem":1},{"text":"e kaka obiro wuok;","poem":2},{"text":"enobi irwa mana ka kodh chwiri,","poem":1},{"text":"mana ka koth mabiro bangʼ chwiri mamiyo lowo bedo mangʼich.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Angʼo madatimni Efraim?","poem":1},{"text":"Angʼo ma datim kodi, in Juda?","poem":2},{"text":"Herani chalo gi ongʼwengʼo mar okinyi,","poem":1},{"text":"kata gi thoo mar okinyi malal nono ka nyango tegno.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Emomiyo an kaachiel gi jonabi maga wangʼadou matindo tindo,","poem":1},{"text":"ne anegou gi weche mawuok e dhoga;","poem":2},{"lineBreak":true},{"text":"buche mane angʼadonu nobiro kuomo mapiyo mana ka mil polo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nimar adwaro ni ukech joweteu, to ok ni uchiwna misango,","poem":1},{"text":"kendo ngʼeyo Nyasaye ber moloyo misengini miwangʼo pep.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mana kaka Adam, giseketho singruok mane atimo kodgi,","poem":1},{"text":"ne ok gibedo jo-adier koda e ndalono.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gilead en dala machwo ma jo-mahundu odakie,","poem":1},{"text":"en dala mosechwerie remb ji.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jodolo chalo mana gi jomecho","poem":1},{"text":"ma pondo ne ji e dir yo,","poem":2},{"text":"ka girito ngʼat makadho","poem":1},{"text":"mondo gima.","poem":2},{"text":"Gineko e yo madhi Shekem,","poem":1},{"text":"gitimo timbe mahundu makwodo wich.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Aseneno gima lich","poem":1},{"text":"e od Israel.","poem":2},{"text":"Kanyo Efraim osechiwore ne chode","poem":1},{"text":"kendo Israel osedwanyore.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“To un bende jo-Juda","poem":1},{"text":"kinde ma ingʼadonue bura osechopo.","poem":2},{"lineBreak":true},{"text":"“Abiro gwedho ogandana e kinde manaduogie ka gia e twech,","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}