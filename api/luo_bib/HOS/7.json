{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"HOS","translationId":"luo_bib","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"eb092fa2ebe3ba23223df813ce2729d5a6bc40fe936c1ab5cf035427a731b3cd","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/luo_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"e kinde ka kinde madwaro changoe Israel,","poem":2},{"text":"to richo mag Efraim elore","poem":1},{"text":"kendo timbe mahundu mag Samaria fwenyore.","poem":2},{"text":"Gihero wacho miriambo,","poem":1},{"text":"jokwoge turo udi,","poem":2},{"lineBreak":true},{"text":"jonjore mayo ji e yore;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"to ok gisefwenyo","poem":1},{"text":"ni aparo timbegi duto maricho.","poem":2},{"text":"Richogi oduodogi,","poem":1},{"text":"kendo ni e wangʼa ndalo duto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Gimoro ruoth gi timbegi marichogo,","poem":1},{"text":"yawuot ruoth bende gimiyo mor gi miriambo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Giduto gin joma terore,","poem":1},{"text":"giore ka kendo,","poem":2},{"text":"ma jated makati oweyo chwaloe mach","poem":1},{"text":"nyaka otiek dwelo mi makati kuodi moromo tedo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"E odiechiengʼ mar nyasi ruodhwa","poem":1},{"text":"yawuot ruoth madho divai mamer,","poem":2},{"lineBreak":true},{"text":"mi riw lwetgi gi jo-ajara.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Chunygi chalo gi kendo,","poem":1},{"text":"gidhi ire ka gisechano timo timbe mochido.","poem":2},{"text":"Gombogi liet ka maa otieno,","poem":1},{"text":"kochopo okinyi to omuoch ka mach maliel.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Giduto giliet ka kendo,","poem":1},{"text":"gikidho jotendgi.","poem":2},{"text":"Ruodhigi bende gitieko,","poem":1},{"text":"to onge ngʼato kuomgi maluonga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Efraim riwore gi ogendini,","poem":1},{"text":"kendo ochalo gi makati ma ok okuot.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ogendini tieko tekone,","poem":1},{"text":"to ok ofweny.","poem":2},{"text":"Lwar okuorore e yie wiye,","poem":1},{"text":"to ok ongʼeyo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tok teko mar jo-Israel bedonegi janeno ka ngʼadonegi bura,","poem":1},{"text":"to kata magi duto timorene,","poem":2},{"text":"to ok oduogi ir Jehova Nyasaye ma Nyasache,","poem":1},{"text":"kata mana manye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Efraim chalo kaka akuch odugla","poem":1},{"text":"mawuondo yot kendo mofuwo,","poem":2},{"text":"giluongo Misri","poem":1},{"text":"to gilokore gidhi Asuria.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ka gidhi, to abiro bolo goka kuomgi;","poem":1},{"text":"analwargi piny ka winy mafuyo malo.","poem":2},{"text":"Ka anenogi ka gichokore kanyakla,","poem":1},{"text":"to anamakgi duto.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Okwongʼ-gi,","poem":1},{"text":"nikech gisebedo mabor koda!","poem":2},{"text":"Kethruok ne gin,","poem":1},{"text":"nikech gisekweda!","poem":2},{"text":"Asedwaro mondo aduog-gi ira","poem":1},{"text":"to giriambo kuoma.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ok giywagna koa e chunygi","poem":1},{"text":"makmana gidengo e kitendinigi.","poem":2},{"text":"Gichokore kanyakla ne cham kod divai manyien","poem":1},{"text":"to giringo gijwangʼa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ne atiegogi ma amiyo gibedo motegno","poem":1},{"text":"to gichano gik maricho kuoma.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Gitamore duogo ir Nyasaye Man Malo Moloyo;","poem":1},{"text":"gichalo atungʼ ma ok nyal tigo.","poem":2},{"text":"Jotendgi noneg gi ligangla","poem":1},{"text":"nikech wechegi mag nyadhi.","poem":2},{"text":"Kuom mano nojargi","poem":1},{"text":"e piny Misri.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}