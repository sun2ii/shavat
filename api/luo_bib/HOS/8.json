{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"HOS","translationId":"luo_bib","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"eb092fa2ebe3ba23223df813ce2729d5a6bc40fe936c1ab5cf035427a731b3cd","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/luo_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["Jo-Israel biro kayo kalausi"]},{"type":"verse","number":1,"content":[{"text":"“Ket turumbete e dhogi mondo igo!","poem":1},{"text":"Ongo ni ewi od Jehova Nyasaye,","poem":2},{"text":"nikech ji oseketho singruokna","poem":1},{"text":"kendo gisekwedo chikna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jo-Israel noywakna niya,","poem":1},{"text":"‘Yaye Nyasachwa, wayangi!’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"To wasigu biro lawo Israel","poem":1},{"text":"nikech gisekwedo gima ber.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Giketo ruodhi e loch ka ok gipenja;","poem":1},{"text":"kendo giyiero jotelo ka ok gingʼeyo parona.","poem":2},{"text":"Giloso nyiseche manono","poem":1},{"text":"kuom fedha gi dhahabu ma gin-go,","poem":2},{"lineBreak":true},{"text":"to magi kelonegi mana kethruok.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yaye Samaria, wit oko nyasachi mar nyaroya!","poem":1},{"text":"Mirimba ger kodgi.","poem":2},{"text":"Nyaka karangʼo ma ok ginyal bedo maler?","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Gin joma oa Israel!","poem":2},{"text":"Nyaroyani oselos mana gi lwet dhano omiyo","poem":1},{"text":"ok en Nyasaye.","poem":2},{"text":"Nyaroya mar Samaria-no","poem":1},{"text":"noto matindo tindo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Gichwoyo yamo","poem":1},{"text":"to gikayo kalausi.","poem":2},{"text":"Gin gi cham ma ok ket wiye;","poem":1},{"text":"kendo ok onyal kelo mogo.","poem":2},{"text":"To kane onyalo nyago cham,","poem":1},{"text":"to jopinje mamoko dochame duto.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Israel osetiek duto;","poem":1},{"text":"kendo sani en e kind ogendini,","poem":2},{"lineBreak":true},{"text":"mana kaka gima nono.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gisedhi nyaka Asuria","poem":1},{"text":"mana kaka kanyna mar bungu mabayo abaya.","poem":2},{"lineBreak":true},{"text":"Efraim oseusore ne joherane.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kata obedo ni giseusore kendgi e kind ogendini,","poem":1},{"text":"abiro chokogi kaachiel.","poem":2},{"text":"Gibiro lal nono","poem":1},{"text":"kendo enosandgi e bwo loch mar ruoth maratego.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Kata ka obedo ni Efraim nogero kende mangʼeny mag misango mar golo richo,","poem":1},{"text":"kendegi osebedo mar timo richo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne andiko negi gik mangʼeny mag chikena,","poem":1},{"text":"to ne gikawogi kaka gigo ma welo kuomgi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Gichiwo misengni mokelna","poem":1},{"text":"kendo gichamo ring misenginigo,","poem":2},{"lineBreak":true},{"text":"to Jehova Nyasaye ok mor kodgi.","poem":2},{"text":"Omiyo sani obiro paro anjawo ma gitimo","poem":1},{"text":"kendo enokumgi kuom richogi.","poem":2},{"lineBreak":true},{"text":"Ginidogi Misri.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jo-Israel wigi osewil gi Jachwechgi,","poem":1},{"text":"mi gigero ute mag ruodhi;","poem":2},{"lineBreak":true},{"text":"Juda osechielo mier madongo mangʼeny.","poem":2},{"text":"To anaor mach e miechgi madongogo","poem":1},{"text":"mitiek kargi mar pondono.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}