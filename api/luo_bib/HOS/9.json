{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"HOS","translationId":"luo_bib","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"eb092fa2ebe3ba23223df813ce2729d5a6bc40fe936c1ab5cf035427a731b3cd","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/luo_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["Kum ne jo-Israel"]},{"type":"verse","number":1,"content":[{"text":"Kik umor, yaye Israel;","poem":1},{"text":"bende kik ubed gi ilo kaka ogendini mamoko.","poem":2},{"text":"Nimar ok usebedo jo-adiera ne Nyasachu;","poem":1},{"text":"usehero chudo mar ochot michulougo,","poem":2},{"lineBreak":true},{"text":"e kuonde dino cham.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kuonde ma idinoe cham kod kuonde mibiyoe divai ok nopidh ji;","poem":1},{"text":"kendo divai manyien ok nokonygi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ok ginidongʼ e piny Jehova Nyasaye;","poem":1},{"text":"Efraim nodog Misri,","poem":2},{"lineBreak":true},{"text":"kendo ginicham chiemo ma ok opwodhi e piny Asuria.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ok gini olne Jehova Nyasaye misango mar divai,","poem":1},{"text":"bende misengini ma gichiwo ok nomor Jehova Nyasaye ngangʼ.","poem":2},{"text":"Misengini machalo kamano nochal negi mana kaka chiemb joma ywak;","poem":1},{"text":"kendo jogo mochamogi nobed mogak.","poem":2},{"text":"Chiemoni nobed margi giwegi;","poem":1},{"text":"omiyo ok nokele e hekalu mar Jehova Nyasaye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Unutim angʼo e odiechiengu mowal mar nyasi,","poem":1},{"text":"kata ka odiechienge nyasi mar Jehova Nyasaye ochopo?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kata ka gitony e kethruok,","poem":1},{"text":"Misri nochokgi,","poem":2},{"lineBreak":true},{"text":"kendo Memfis noikgi.","poem":2},{"text":"Mwandu mag fedha noum gi pedo","poem":1},{"text":"kendo kuthe noum hembegi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kinde mag kum biro","poem":1},{"text":"kendo kinde mag ngʼado bura osechopo.","poem":2},{"lineBreak":true},{"text":"Omiyo jo-Israel nyaka ngʼe wachni.","poem":2},{"text":"Nikech richou ngʼeny","poem":1},{"text":"kendo kinyou lich miwuoro,","poem":2},{"text":"janabi ikwano ka ngʼama ofuwo,","poem":1},{"text":"to ngʼat matiyo gi much Nyasaye ka janeko.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Janabi, kaachiel gi Nyasacha","poem":1},{"text":"e jarit mar Efraim,","poem":2},{"text":"kata kamano obadho rite e yorene duto,","poem":1},{"text":"kendo akweda bende rite e od Nyasache.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gisedonjo matut e timbe mag miganga","poem":1},{"text":"mana ka ndalo mag Gibea.","poem":2},{"text":"Nyasaye nopar timbegi mamono","poem":1},{"text":"kendo enokumgi e richogi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Kane ayudo Israel","poem":1},{"text":"ne ochalo mana kayudo olemb mzabibu e piny motwo,","poem":2},{"text":"kane aneno kwereu,","poem":1},{"text":"ne chalo mana ka gima aneno olemo monyak mokwongo mar ngʼowu.","poem":2},{"text":"To kane gibiro Baal Peor,","poem":1},{"text":"negichiwore lamo nyiseche manono makwodo wich,","poem":2},{"lineBreak":true},{"text":"kendo negibedo modwanyore mana ka gima ne giherono.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Duongʼ mar Efraim noweye mana ka winyo ma huyo mi lal nono,","poem":1},{"text":"omiyo ok ginichak ginywol nyithindo,","poem":2},{"lineBreak":true},{"text":"mondegi ok nobed ma yach kendo onge nyathi manomak ichne.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kata ka gipidho nyithindo,","poem":1},{"text":"to namigi gibed gi kuyo kuom moro ka moro.","poem":2},{"text":"Okwongʼ-gi,","poem":1},{"text":"ka alokora mi ajwangʼogi!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Aseneno Efraim, mana kaka ne aneno Turo,","poem":1},{"text":"ka opidhi kama omiyo,","poem":2},{"text":"to Efraim nokel nyithinde","poem":1},{"text":"ni janek.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Chiwnegi, yaye Jehova Nyasaye,","poem":1},{"text":"en angʼo ma dimigi?","poem":2},{"text":"Migi mana iye magore piny","poem":1},{"text":"kendo thunde motwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Nikech timbegi mag anjawo e Gilgal,","poem":1},{"text":"ne ok aherogi kanyo.","poem":2},{"text":"Nikech timbegi mag richo,","poem":1},{"text":"abiro riembgi oko e oda.","poem":2},{"text":"Ok anachak ahergi;","poem":1},{"text":"jotendgi duto gin joma timbegi richo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Midekre osemako Efraim,","poem":1},{"text":"kendo tiendene ner,","poem":2},{"lineBreak":true},{"text":"ok ginyag olemo.","poem":2},{"text":"Kata ka ginywolo nyithindo,","poem":1},{"text":"to ananeg nyithindgi ma gihero ahinyago.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Nyasacha nokwedgi","poem":1},{"text":"nikech ok gisewinje,","poem":2},{"lineBreak":true},{"text":"ginibedi joma tangni e dier ogendini.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}