{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"ISA","translationId":"luo_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"177512eb4f9e6ea3d7482c7e9c92bfcbf8e1b1aa8229f9944d921173728e87cc","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/luo_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Fweny ma wuoyo ewi Juda kod Jerusalem mane Isaya wuod Amoz oneno e ndalo loch Uzia gi Jotham gi Ahaz kod Hezekia mane gin ruodhi Juda."]},{"type":"line_break"},{"type":"heading","content":["Oganda mongʼanyo"]},{"type":"verse","number":2,"content":[{"text":"Winji yaye polo! Chik iti, yaye piny!","poem":1},{"text":"Nikech Jehova Nyasaye osewuoyo:","poem":2},{"text":"asepidho nyithindo mobedo madongo,","poem":1},{"text":"to gisepiem koda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Rwath ongʼeyo wuon,","poem":1},{"text":"kendo kanyna ongʼeyo kund wuon,","poem":2},{"text":"to jo-Israel ok ongʼeya adier;","poem":1},{"text":"joga awuon onge gi winjo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yaye oganda ma joricho,","poem":1},{"text":"koth ji mogangore gi timbe mamono,","poem":2},{"text":"kanyakla mar joma timbegi richo,","poem":1},{"text":"nyithindo mochiwore ne timbe acheje!","poem":2},{"text":"Giseweyo Jehova Nyasaye;","poem":1},{"lineBreak":true},{"text":"gisejaro Jal Maler mar Israel","poem":1},{"text":"giselokone ngʼegi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Angʼo momiyo pod usiko kudwaro kum?","poem":1},{"text":"Angʼo momiyo usiko kungʼanyo?","poem":2},{"text":"Wiyeu opongʼ gi adhonde","poem":1},{"text":"kendo chunyu opongʼ gi lit.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kochakore e tiendu nyaka ewiu","poem":1},{"text":"onge kama ngima,","poem":2},{"text":"kendo upongʼ gi adhonde,","poem":1},{"text":"kuonde moriemo,","poem":2},{"text":"kod kuonde moridhore mapok oketie yath,","poem":1},{"text":"mapok otwe kata wiroe yath.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Pinyu odongʼ gunda,","poem":1},{"text":"miechu madongo osewangʼ gi mach;","poem":2},{"text":"puotheu jopinje mamoko osemau","poem":1},{"text":"mana kuneno gi wangʼu,","poem":2},{"lineBreak":true},{"text":"ma gidongʼ gundni mana ka joma wasigu oseriembo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nyar Sayun odongʼ","poem":1},{"text":"ka kiru manie e puoth mzabibu,","poem":2},{"text":"kata ka abila e puoth budho","poem":1},{"text":"kendo ka dala maduongʼ ma wasigu omonjo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ka dine Jehova Nyasaye Maratego","poem":1},{"text":"ok oweyo jomoko kuomwa otony,","poem":2},{"text":"to dine wachalo gi jo-Sodom,","poem":1},{"text":"adier dikoro ne wachalo kaka jo-Gomora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Winjuru wach Jehova Nyasaye un jotelo mag Sodom,","poem":1},{"text":"chikuru itu ne chike mag Nyasachwa un oganda man Gomora!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jehova Nyasaye wacho kama:","poem":1},{"text":"“Misengini mangʼeny mutimogi amon-go.”","poem":2},{"text":"Aol gi misengini","poem":1},{"text":"miwangʼo pep mag imbe kaachiel gi boche mag jamni machwe.","poem":2},{"text":"Ok amor","poem":1},{"text":"gi remb rwedhi gi mag imbe kod mag nywogi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ere ngʼama osekwayou gigo ka ubiro e nyima,","poem":1},{"text":"donge mano en dwanyo hekalu mara maler.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kik ukel misengini maonge tich e nyima!","poem":1},{"text":"Tik ubanino dungʼna marach,","poem":2},{"text":"kendo sewni mutimo ka dwe opor,","poem":1},{"text":"gi mag Sabato kata e chokruoge duto ok amorgo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sewni mutimo ka dwe opor kod sewni moyier","poem":1},{"text":"chido chunya,","poem":2},{"text":"giselokore tingʼ mapek matura bende aol gi tingʼogi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ka utingʼo bedeu malo kulemo","poem":1},{"text":"to anapandnu wangʼa,","poem":2},{"text":"kendo kata ulem machal nade","poem":1},{"text":"to ok anadwoku.","poem":2},{"lineBreak":true},{"text":"Lweteu osechwero remo mangʼeny!","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Lwokreuru mondo ubed maler.","poem":1},{"text":"Goluru timbeu mamono","poem":2},{"lineBreak":true},{"text":"e wangʼa!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Weuru timbeu maricho;","poem":1},{"text":"to upuonjru timbe mabeyo!","poem":2},{"text":"Dwaruru tim makare,","poem":1},{"text":"kendo jiwuru joma ithiro.","poem":2},{"text":"Bende nyaka une ni nyithind kiye","poem":1},{"text":"kod mon ma chwogi otho oyal buchegi e yo makare kare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“Biuru machiegni mondo wapor wach,","poem":2},{"text":"kata obedo ni richou kwar manade","poem":1},{"text":"to ibiro luoki magibed matar ka pe,","poem":2},{"text":"bende kata bed ni gikwar malich","poem":1},{"text":"to nobed marachar ka pamba.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ka uyie kuoma muboloru kendo umako chikena duto,","poem":1},{"text":"to unucham gik mabeyo mag piny;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"to ka udagi kendo ungʼanyo","poem":1},{"text":"to ligangla notieku.”","poem":2},{"text":"Nimar an Jehova Nyasaye ema asewacho.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Neye kaka dala maduongʼ ma yande oluoro Nyasaye","poem":1},{"text":"koro oselokore ochot!","poem":2},{"text":"Kinde moko ne en kama adiera odakie,","poem":1},{"text":"tim makare ne yudore,","poem":2},{"lineBreak":true},{"text":"to tinde jonek ema opongʼe.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Fedha magu oselokore chuoth nyinyo","poem":1},{"text":"bende divai magu mogen oseruw gi pi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Jotendu ongʼanyo","poem":1},{"text":"kendo gin e kanyakla mar jokwoge,","poem":2},{"text":"giduto gihero asoya,","poem":1},{"text":"kendo gihero gik makonyogi giwegi.","poem":2},{"text":"Ok giyal buche nyithind kiye kare,","poem":1},{"text":"bende weche mamon ma chwogi otho okelo e nyimgi ok gidew.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kuom mano, Ruoth Nyasaye ma en Jehova Nyasaye Maratego,","poem":1},{"text":"kendo Jehova Nyasaye mar kanyakla mar Israel wacho kama:","poem":2},{"text":"“Anayud kwe kuom jok ma jara","poem":1},{"text":"kendo nachul kuor ne wasika.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Anachwadu gi masiche","poem":1},{"text":"kendo anapwodhu maler,","poem":2},{"lineBreak":true},{"text":"mi agol timbeu mamono duto.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bangʼe anaduognu jongʼad bura makare kaka ne timore e ndalo machon,","poem":1},{"text":"kendo jongʼad rieko mane nitie aa chakruok.","poem":2},{"text":"Eka noluongu ni","poem":1},{"text":"Dala Maduongʼ mar Tim Makare,","poem":2},{"lineBreak":true},{"text":"Dala Maduongʼ Madiera Nitie.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Sayun nopwodh gi bura makare","poem":1},{"text":"bende joma oyie modak e iye norit kod adiera.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"To joma ongʼanyo kod joricho duto","poem":1},{"text":"gi joma oweyo Jehova Nyasaye notiek chuth.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Wiu nokuodi gi tiend yiende mag ober","poem":1},{"text":"ma umorgo kutimoe misengini,","poem":2},{"text":"kendo unubed gi kuyo kuom puothe","poem":1},{"text":"museyiero mondo ulemie.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ubiro chalo kaka yiend ober ma ite ner","poem":1},{"text":"kendo kaka puodho ma ok yud pi.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ngʼat maratego e dieru nodok manyap,","poem":1},{"text":"kendo tekone nowuog mana ka pilni,","poem":2},{"text":"kendo gigo duto nowangʼ pep","poem":1},{"text":"maonge ngʼama nyalo nego majno.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}