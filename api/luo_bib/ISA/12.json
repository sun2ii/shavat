{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"ISA","translationId":"luo_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"177512eb4f9e6ea3d7482c7e9c92bfcbf8e1b1aa8229f9944d921173728e87cc","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/luo_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["Wende mag pak"]},{"type":"verse","number":1,"content":["E kindeno iniwach niya,",{"text":"“Anapaki, yaye Jehova Nyasaye.","poem":1},{"text":"Kata obedo ni mirima nomaki koda to mirimbino,","poem":2},{"lineBreak":true},{"text":"koro oserumo kendo isekweyo chunya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kuom adiera Nyasaye e jaresna;","poem":1},{"text":"anagen kuome kendo ok analuor.","poem":2},{"text":"Jehova Nyasaye, ma en Jehova Nyasaye owuon,","poem":1},{"text":"e tekra kendo wenda;","poem":2},{"lineBreak":true},{"text":"kendo osebedo resruokna.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gi mor malach,","poem":1},{"text":"ibiro tuomo pi koa e sokni mag resruok.","poem":2}]},{"type":"verse","number":4,"content":["E kindeno iniwach niya,",{"text":"“Gone Jehova Nyasaye erokamano,","poem":1},{"text":"luong nyinge kendo landuru ni ji duto gik ma osetimo,","poem":2},{"lineBreak":true},{"text":"ka uhulo ni nyinge nigi duongʼ moloyo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Werne Jehova Nyasaye nikech osetimo gik madongo;","poem":1},{"text":"kendo mano nyaka ngʼere e piny duto.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Koguru matek kuwer gi mor,","poem":1},{"text":"un jo-Sayun nimar Jal Maler mar Israel odak e dieru.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}