{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"ISA","translationId":"luo_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"177512eb4f9e6ea3d7482c7e9c92bfcbf8e1b1aa8229f9944d921173728e87cc","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/luo_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"Kawuru rombe koa Sela","poem":1},{"text":"kungʼadogo thim mondo uterne ruodh piny,","poem":2},{"lineBreak":true},{"text":"modak e got mar Nyar Sayun kaka gir chiwo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mana kaka nyithind winy","poem":1},{"text":"moketh odgi mafuyo koni gi koni,","poem":2},{"text":"e kaka mond jo-Moab nodongʼ","poem":1},{"text":"e kar otuodo manie Aora Arnon.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Ngʼadnwauru rieko,","poem":1},{"text":"nyiswa gima onego watim.","poem":2},{"text":"Pandwauru mondo kik yudwa","poem":1},{"text":"kendo panduru jowa moringo lweny,","poem":2},{"lineBreak":true},{"text":"kendo kik uyie mondo omaki joma oseringo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"We jo-Moab moringo lweny odag kodu","poem":1},{"text":"kendo bednegi ragengʼ kuom jakethgi.”","poem":2},{"lineBreak":true},{"text":"Ngʼatno masandogi tekone norum,","poem":1},{"text":"kendo kethruok notieki;","poem":2},{"lineBreak":true},{"text":"mi jathir ji nolal nono e piny.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kuom hera, loch nogur;","poem":1},{"text":"kuom adiera ngʼato nobedie lojno,","poem":2},{"text":"ngʼatno nowuogi e od Daudi,","poem":1},{"text":"ma en ngʼat mangʼado bura kare,","poem":2},{"lineBreak":true},{"text":"kendo ojiwo timbe mag adieri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wasewinjo sunga mar Moab,","poem":1},{"text":"kaka otingʼore malo gi wuondruok,","poem":2},{"text":"kopongʼ gi sunga kod achaya,","poem":1},{"text":"to dhialruokneno en kayiem nono.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kuom mano jo-Moab dengo,","poem":1},{"text":"gidengo kaachiel nikech Moab.","poem":2},{"lineBreak":true},{"text":"Ywaguru kendo ubed gi lit nikech jo-Kir Hareseth.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Puothe mag Heshbon ner,","poem":1},{"text":"kaachiel gi mzabibu mag Sibma.","poem":2},{"text":"Jotelo mag ogendini oseketho divai mane berie moloyo,","poem":1},{"text":"mane ndalo moro ochopo nyaka Jazer,","poem":2},{"text":"kendo olandore nyaka kar ongoro.","poem":1},{"text":"Bedene nolawore malach mochopo nyaka nam.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Omiyo aywak mana kaka Jazer ywak","poem":1},{"text":"nikech mzabibu mag Sibma.","poem":2},{"text":"Yaye Heshbon, yaye Eleale,","poem":1},{"text":"analuoku gi pi wangʼ.","poem":2},{"text":"Mor ma un-go nikech olembeu mosechiek","poem":1},{"text":"kendo nikech keyo maru osetieki.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mor kod ilo norum chuth e puotheu mag olemo","poem":1},{"text":"kendo onge wer mano wer kata koko manogo e puotheu mag mzabibu;","poem":2},{"text":"bende onge ngʼato angʼata manochak obi mzabibu e kuonde mag bicho,","poem":1},{"text":"nimar asetieko mahu mar mor ma un-go.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Chunya ywago Moab mana kaywak mar nyatiti,","poem":1},{"text":"kendo chunya ma iye ywago Kir Hareseth.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ka Moab ochopo kuonde hembko mag misengini,","poem":1},{"text":"to ochandore achanda nono;","poem":2},{"text":"to kata ka odonjo e kare mar lemo,","poem":1},{"text":"to en mana kayiem nono.","poem":2}]},{"type":"verse","number":13,"content":["Ma e wach ma Jehova Nyasaye nosewacho kuom Moab."]},{"type":"verse","number":14,"content":["To sani Jehova Nyasaye wacho niya: Kapok okadho higni adek, mana kaka ja-otongʼo tiyo kaparo hignige adek ma tije rumogo e kaka duongʼ mar Moab kaachiel gi joge mangʼeny duto none achaya, bende joge ma notony nobed manok kendo mayom yom."]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/ISA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/ISA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/ISA/15.json","previousChapterAudioLinks":{},"numberOfVerses":14}