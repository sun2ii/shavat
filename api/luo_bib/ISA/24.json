{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"ISA","translationId":"luo_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"177512eb4f9e6ea3d7482c7e9c92bfcbf8e1b1aa8229f9944d921173728e87cc","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/luo_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":24,"content":[{"type":"heading","content":["Jehova Nyasaye biro ketho piny"]},{"type":"verse","number":1,"content":[{"text":"Neuru Jehova Nyasaye biro ketho piny,","poem":1},{"text":"mi odongʼ nono,","poem":2},{"text":"obiro loko kit piny","poem":1},{"text":"kendo keyo jogo modakie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Notime machalre ne jodolo kata ne joma moko,","poem":1},{"lineBreak":true},{"text":"misumba kata ne ruodhe,","poem":1},{"text":"ne dhako man-gi jatich kata ne nyako matiyone,","poem":2},{"text":"ne jahono kata ne jangʼiewo, ne ngʼat ma holo ji,","poem":1},{"text":"kata ne ngʼat ma holo,","poem":2},{"lineBreak":true},{"text":"ne ngʼat man-gi gowi kata ngʼat ma holo ji.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Piny nodongʼ gunda","poem":1},{"text":"kendo nokethre chuth.","poem":2},{"text":"Jehova Nyasaye ema osewacho wechegi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Piny notwo kendo noner,","poem":1},{"text":"piny nojwangʼ miner,","poem":2},{"lineBreak":true},{"text":"kendo polo gi piny nojwangʼ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Piny osedwany gi jok modakie,","poem":1},{"text":"giseketho chike, gisetamore rito buchene,","poem":2},{"text":"kendo giseketho winjruok manyaka nene.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kuom mano kwongʼ","poem":1},{"text":"osetieko piny kendo joma odakie nyaka yud kum kuom richogi.","poem":2},{"text":"Omiyo joma odak e piny osewangʼ","poem":1},{"text":"mi manok ema odongʼ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Divai mobi manyien notuwo","poem":1},{"text":"kendo mzabibu biro ner,","poem":2},{"lineBreak":true},{"text":"ji duto mamiyo ji mor nobed gi chuny lit.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mor mar nyiduonge norum,","poem":1},{"text":"koko mar joma nigi mor kod ilo nolal,","poem":2},{"lineBreak":true},{"text":"kendo mor mar thum ok nowinji.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ok ginichak gimadh divai ka giwer,","poem":1},{"text":"nikech kongʼo osebedo marach ne jomath.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dala maduongʼ","poem":1},{"text":"okethore modongʼ gunda,","poem":2},{"text":"kendo dhoudi duto olor.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ji ywagore e wangʼ yore","poem":1},{"text":"nikech divai onge, mor duto olokore kuyo,","poem":2},{"lineBreak":true},{"text":"piny duto odongʼ gi lit.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dala maduongʼ odongʼ ka oruombore piny","poem":1},{"text":"kendo dhorangeye mage otur matindo tindo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ma notimre e piny","poem":1},{"lineBreak":true},{"text":"ngima e kind ogendini mana kaka ipono olemb zeituni","poem":1},{"text":"e yath kata mana kaka olemo manok,","poem":2},{"lineBreak":true},{"text":"mag mzabibu dongʼne johulo e yath kosepon.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Gitingʼo dwondgi malo, ka gigoyo koko gimor","poem":1},{"text":"koa yo podho chiengʼ,","poem":2},{"lineBreak":true},{"text":"kendo ka gihulo teko mar Jehova Nyasaye.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Omiyo miuru Jehova Nyasaye duongʼ","poem":1},{"lineBreak":true},{"text":"un joma odak e chula mag nam man yo wuok chiengʼ;","poem":1},{"text":"tingʼuru nying Jehova Nyasaye malo,","poem":2},{"lineBreak":true},{"text":"ma en Nyasach Israel,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"koa e tungʼ piny duto wawinjo wer mawer niya:","poem":1},{"text":"“Duongʼ odongʼ ne Jal Makare.”","poem":2},{"lineBreak":true},{"text":"To an ne awacho niya, “Aserumo chuth, aserumo chuth!","poem":1},{"text":"Mano kaka aneno malit!","poem":2},{"text":"Jandhoko ndhogo ji!","poem":1},{"text":"Kuom timbe mag andhoga osendhogo ji!”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Masira rita, osekunyna bugo","poem":1},{"text":"kendo obadho osechikna,","poem":2},{"lineBreak":true},{"text":"yaye un oganda modak e piny.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngʼama notem ringo kowinjo mahu mar masira","poem":1},{"text":"nolwar e bur,","poem":2},{"text":"kendo ngʼama notem wuok e burno","poem":1},{"text":"nolwar e obadho.","poem":2},{"lineBreak":true},{"text":"Dhorangeye mag polo noyawre,","poem":1},{"text":"kendo mise mag piny noyiengni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Piny osebarore,","poem":1},{"text":"piny oselal nono,","poem":2},{"lineBreak":true},{"text":"kendo piny yiengni malich.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Piny thembo ka jakongʼo,","poem":1},{"text":"kendo ohukni ka kiru ma yamo yiengo,","poem":2},{"text":"kethruok kod timbene mamono","poem":1},{"text":"omiyo opodho ma ok nochak oa malo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"E kindeno Jehova Nyasaye nokum","poem":1},{"text":"teko duto manie polo malo,","poem":2},{"lineBreak":true},{"text":"kaachiel gi ruodhi duto manie piny.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nochokgi kaachiel kendo nolornegi","poem":1},{"lineBreak":true},{"text":"mana kaka jo-jela molornegi e od twech","poem":1},{"text":"kendo nolornegi e od twech,","poem":2},{"lineBreak":true},{"text":"mi giyud kum kuom kinde mangʼeny.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Dwe norieny matip-tip kendo wangʼ","poem":1},{"text":"chiengʼ noimre nikech Jehova Nyasaye Maratego,","poem":2},{"text":"nogur lochne kod duongʼne e Got Sayun","poem":1},{"text":"kod Jerusalem e nyim jodongo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}