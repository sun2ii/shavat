{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"ISA","translationId":"luo_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"177512eb4f9e6ea3d7482c7e9c92bfcbf8e1b1aa8229f9944d921173728e87cc","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/luo_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":27,"content":[{"type":"heading","content":["Resruok mar Israel"]},{"type":"verse","number":1,"content":["E kindeno,",{"text":"Jehova Nyasaye nokaw liganglane mabith,","poem":1},{"text":"motegno kendo man-gi teko,","poem":2},{"text":"mokumgo Leviathan,","poem":1},{"text":"thuol malich mamol kendo monudore;","poem":2},{"text":"motiek thuol malich mar nam.","poem":1}]},{"type":"verse","number":2,"content":["E kindeno:",{"text":"“Nuwerne puoth mzabibu mamiyo kama:","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"An Jehova Nyasaye, aketo wangʼa kuome;","poem":1},{"text":"kendo amiye pi pile.","poem":2},{"text":"Arite odiechiengʼ gotieno","poem":1},{"text":"mondo kik ngʼato kethe.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aonge gi ich wangʼ.","poem":2},{"text":"Ka dine pedo kod kuthe ok gwara,","poem":1},{"text":"to dine amonjogi;","poem":2},{"lineBreak":true},{"text":"mi awangʼogi duto e mach.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ka ok kamano to wegi gibi ira mondo abed kar pondogi;","poem":1},{"text":"we mondo gilos kwe e kinda kodgi,","poem":2},{"lineBreak":true},{"text":"ee, we gilos winjruok koda.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"E kinde mabirogo Jakobo nogurre motegno,","poem":1},{"lineBreak":true},{"text":"Israel nobed ka bad yath madongo kendo thiewo,","poem":1},{"text":"kendo enonyag olemo mopongʼo piny.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bende Jehova Nyasaye osekumo Israel","poem":1},{"text":"kaka nokumo joma nosandogi?","poem":2},{"lineBreak":true},{"text":"Bende osenego Israel kaka nonego joma ne onegogi?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ei masiche kod twech isebedo machiegni kode,","poem":1},{"text":"iseriembogi mabor,","poem":2},{"lineBreak":true},{"text":"mana ka gima yamo mager moa yo wuok chiengʼ ema terogi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kuom ma, richo mar Jakobo nopwodhi,","poem":1},{"text":"kendo ma ema nobed ranyisi mar golo richone duto:","poem":2},{"text":"Komiyo kite duto milosogo kar","poem":1},{"text":"kendo mar misango chalo mana gi matafare motore matindo tindo,","poem":2},{"text":"bende onge sirni mag Ashera kata","poem":1},{"text":"kendo miwangʼoe ubani mane odongʼ kochungʼ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dala maduongʼ mochiel motegno odongʼ gunda,","poem":1},{"text":"kama yande ji odakie ojwangʼ ka thim;","poem":2},{"text":"nyiroye nokwa kanyo bende kanyo","poem":1},{"text":"ema gini nindie kagiselwero bede yien magitieko.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ka bedegi osetwo to gimukore oko","poem":1},{"text":"kendo mon modogi michwakgi.","poem":2},{"text":"Nimar gin ogendini maonge winjo;","poem":1},{"text":"omiyo Jachwechgi onge gi miwafu kuomgi,","poem":2},{"lineBreak":true},{"text":"kendo Jachwech ok nyisgi ngʼwono moro amora.","poem":2}]},{"type":"verse","number":12,"content":["E kindeno Jehova Nyasaye biro piedho joge kochakore Aora Yufrate nyaka aore mag Wadi mar Misri, to un, yaye jo-Israel nochoku achiel kaachiel."]},{"type":"verse","number":13,"content":["Kendo e kindeno tungʼ maduongʼ noywagi. Jogo mane olal e piny Asuria nobi kendo joma ni e twech e piny Misri nochopi ma lam Jehova Nyasaye e gode maler man Jerusalem."]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}