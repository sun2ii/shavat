{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"ISA","translationId":"luo_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"177512eb4f9e6ea3d7482c7e9c92bfcbf8e1b1aa8229f9944d921173728e87cc","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/luo_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":3,"content":[{"type":"heading","content":["Kum ne Jerusalem kod Juda"]},{"type":"verse","number":1,"content":[{"text":"Neuru koro Ruoth Nyasaye,","poem":1},{"text":"ma en Jehova Nyasaye Maratego,","poem":2},{"text":"biro tieko mich kod kony","poem":1},{"text":"mikelo ne Jerusalem kod Juda.","poem":2},{"text":"Notiek kit chiemo duto kod pi","poem":1}]},{"type":"verse","number":2,"content":[{"text":"thuondi maroteke kod jolweny,","poem":2},{"text":"gi jongʼad bura gi jonabi","poem":1},{"text":"gi jokor wach kod jodongo,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"jatend lweny morito ji piero abich gi joma ogen,","poem":1},{"text":"jongʼad rieko, jopecho molony kod joma olony e wach.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Anaket mana yawuowi obed jotendgi,","poem":1},{"text":"to rawere matindo noritgi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ji nosandre kendgi giwegi,","poem":1},{"text":"ka ngʼato sando mana wadgi owuon","poem":2},{"lineBreak":true},{"text":"bende jogo modak mokiewo nosandre kendgi giwegi.","poem":2},{"text":"Jomatindo notug lweny gi jomadongo,","poem":1},{"text":"kendo ji ajiya nocha joma ogen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ngʼato nochun achiel kuom owetene","poem":1},{"text":"manie dala wuon-gi kowacho niya,","poem":2},{"text":"“In ema in-gi lep loch, koro telnwa;","poem":1},{"text":"kendo ibed gi teko ewi pinywa mokethoreni.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"To e kindeno ngʼatno nodwoki niya,","poem":1},{"text":"“Ooyo ok dabed ruodhu,","poem":2},{"text":"nimar aonge gi chiemo kata lewni e oda","poem":1},{"text":"madimi uketa abed jatend ogandani.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jerusalem yiengni,","poem":1},{"text":"bende Juda mukore;","poem":2},{"text":"wechegi kod timbegi opogore gi dwach Jehova Nyasaye,","poem":1},{"text":"nimar ok omi duongʼne nenre e diergi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wangʼ-gi nyiso ni gin joricho","poem":1},{"text":"kendo richogi oyangore e lela mana ka richo mane ni Sodom,","poem":2},{"lineBreak":true},{"text":"bende gionge gi wichkuot.","poem":2},{"text":"Yaye, mano kaka ginine malit","poem":1},{"text":"nikech gisekelo masira kuomgi giwegi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kone joma kare ni gin johawi,","poem":1},{"text":"nimar giniyud pok kuom tichgi matek.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yaye, mano kaka nobed malit ne joricho nikech masira nobed kuomgi.","poem":1},{"text":"Enokumgi kuom gik maricho ma lwetgi osetimo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Jomatindo ema thiro joga","poem":1},{"text":"kendo mon ema jotendgi.","poem":2},{"text":"Yaye joga, jotendu osewuondou,","poem":1},{"text":"momiyo ubaro uweyo yo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Jehova Nyasaye osebedo e kom bura","poem":1},{"text":"mondo ongʼad bura ne oganda.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sa ngʼado bura mar Jehova Nyasaye","poem":1},{"text":"kuom jodongo kod jotend joge osechopo,","poem":2},{"text":"kowacho niya, “Un ema useketho puotha mar mzabibu","poem":1},{"text":"kendo gik ma uyako kukawo e ut joma odhier opongʼo uteu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"En angʼo momiyo usando","poem":1},{"text":"kendo uthiro joga modhier?”","poem":2},{"lineBreak":true},{"text":"Ruoth Nyasaye, ma en Jehova Nyasaye Maratego ema owacho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“Mond Sayun sungore kendo kawore, gingʼayo ngʼutgi malo,","poem":2},{"text":"kendo giningʼo wengegi.","poem":1},{"text":"Bende giwuotho ka gingʼadore,","poem":2},{"lineBreak":true},{"text":"ka gara manie tiendgi ywak.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kuom mano Ruoth Nyasaye biro kelo adhonde ewi mond Sayun,","poem":1},{"text":"kendo Jehova Nyasaye nomi timbegi mamono nenre ratiro.”","poem":2}]},{"type":"verse","number":18,"content":["Odiechiengʼno Ruoth Nyasaye biro mayogi gik ma gilichorego kaka: bangli gi kitembini mag wich kod tigo mag ngʼut,"]},{"type":"verse","number":19,"content":["gi tigo miliero e it gi bangli mag lwetgi kod kitamba miliero e ngʼut,"]},{"type":"verse","number":20,"content":["gi kitembini mag wich, gi thiwni mag ofunj tielo, gi misip gi chupni motingʼo gik mangʼwe ngʼar kod ris,"]},{"type":"verse","number":21,"content":["gi tere mag lwedo gi mag um,"]},{"type":"verse","number":22,"content":["lewni mayom gi kode gi mifuke mag lwedo,"]},{"type":"verse","number":23,"content":["kod kio, gi lewni mabeyo gi lewni miliero e ngʼut kod mago miumogo wangʼ."]},{"type":"verse","number":24,"content":[{"text":"Kar winjo tik mangʼwe ngʼar to unuwinj mana tik madungʼ marach;","poem":1},{"text":"kar bedo gi okanda to tol ema nutwerugo;","poem":2},{"text":"kar bedo gi yie wich molos maber to bondo ema unudongʼ-go;","poem":1},{"text":"kar bedo gi lewni mabeyo to unurwak mana pien gugru,","poem":2},{"lineBreak":true},{"text":"kar bedo gi wangʼ man-gi chia to adhonde nopongʼ dendu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Chwou notiek gi ligangla","poem":1},{"text":"kendo jolweny magu norum e lweny.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nduru gi ywak mag dengo nopongʼ dhorongeye mag Sayun,","poem":1},{"text":"kendo dalano nodongʼ nono kokethore.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}