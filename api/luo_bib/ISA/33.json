{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"ISA","translationId":"luo_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"177512eb4f9e6ea3d7482c7e9c92bfcbf8e1b1aa8229f9944d921173728e87cc","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/luo_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":33,"content":[{"type":"heading","content":["Achiedh-nade kod resruok"]},{"type":"verse","number":1,"content":[{"text":"Unune malit un joma osetieko ji, to pok otieku!","poem":1},{"text":"Unune malit un joma osendhogo ji, to un pok ondhogu!","poem":2},{"text":"Ka uweyo tieko ji to notieku;","poem":1},{"text":"bende ka uweyo ndhogo ji to nondhogu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yaye Jehova Nyasaye, yie ikechwa;","poem":1},{"text":"nimar chunywa dwari.","poem":2},{"text":"Miwae teko okinyi ka okinyi,","poem":1},{"text":"kendo bednwa kar resruok,","poem":2},{"lineBreak":true},{"text":"e kinde mag chandruok.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ka dwondi omor to ji ringo;","poem":1},{"text":"ka ia malo to ogendini ke.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yaye un ogendini,","poem":1},{"text":"mwandu noyaki mana ka kama nyithi bonyo omonjo;","poem":2},{"text":"kendo ji noyak mwandugi,","poem":1},{"text":"mana kaka bonyo monjo piny.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nying Jehova Nyasaye otingʼ malo, nimar odak e polo;","poem":1},{"text":"obiro pongʼo Sayun gi tim makare kod adiera.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Enobed mise mar adier e ndalou,","poem":1},{"text":"kar mwandu mar resruok gi rieko kod ngʼeyo;","poem":2},{"lineBreak":true},{"text":"luoro Jehova Nyasaye e rayaw mar mwanduni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"To neuru kaka thuondige ywak malit e wangʼ yore;","poem":1},{"text":"joote ma oseor mondo odwar kwe ywak malit.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yore osedongʼ nono,","poem":1},{"text":"kendo onge jowuoth e yo.","poem":2},{"text":"Winjruok osekethi mi joma nobedo joneno ok dew,","poem":1},{"text":"kendo onge ngʼama omi luor.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Piny ywak kendo dok chien,","poem":1},{"text":"Lebanon ni e wichkuot kendo okethore,","poem":2},{"text":"Sharon olokore ongoro ka Araba,","poem":1},{"text":"kendo Bashan gi Karmel oyaki modongʼ nono.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“Koro abiro aa malo,","poem":2},{"lineBreak":true},{"text":"mondo anyisu duongʼna gi tekona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ubiro mako ich to unywolo yamo;","poem":1},{"text":"muya muyweyo en mach ma tiekou.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ogendini nowangʼ,","poem":1},{"text":"mi lokre pidhe mag buru,","poem":2},{"text":"kendo mana kaka kudho mobet e bungu","poem":1},{"text":"enowangʼ gi mach!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Un mudak mabor,","poem":1},{"text":"winjuru gima asetimo,","poem":2},{"lineBreak":true},{"text":"un mudak machiegni ngʼeuru tekona!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Joricho man Sayun,","poem":1},{"text":"kihondko osemako;","poem":2},{"lineBreak":true},{"text":"kibaji ogoyo joma okia nyasaye,","poem":2},{"text":"mi gisepenjore kendgi niya,","poem":1},{"text":"“En ngʼa kuomwa manyalo dak kod mach mawengʼo magerni?","poem":2},{"text":"Koso en ngʼa kuomwa manyalo","poem":1},{"lineBreak":true},{"text":"dak kod mach maliel maonge gikone?”","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ngʼatno mawuotho e ratiro","poem":1},{"text":"kendo wacho gima adiera,","poem":2},{"text":"ma tamore yudo ohala e yor mecho","poem":1},{"text":"kendo ok oyie kawo asoya,","poem":2},{"lineBreak":true},{"text":"ngʼatno ma ok chik ite e chenro mar neko,","poem":2},{"text":"kendo odino wengene e neno timbe mamono,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ma e ngʼama nodagi kuonde motingʼore gi malo,","poem":1},{"text":"ma kare mar pondo nobedi got mochiel gohinga motegno.","poem":2},{"text":"Chiembe ibiro chiw,","poem":1},{"text":"kendo pi ok nodwon-ne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Wengeni biro neno ruoth","poem":1},{"text":"kober kendo iningʼi piny molandore malach.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"E pachi inipar masiche machon:","poem":1},{"text":"“Ere jatelo maduongʼ cha?","poem":2},{"text":"Ere ngʼatno mane okawo osuru?","poem":1},{"text":"Ere jatelo mochungʼne kuonde ngʼicho man malo?”","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ok inichak ine jonjorego kendo,","poem":1},{"text":"jogo ma wechegi oyombore,","poem":2},{"lineBreak":true},{"text":"kendo mawacho dhok matek winjo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ka irango Sayun,","poem":1},{"text":"dala maduongʼ mar sewniwa moyier;","poem":2},{"lineBreak":true},{"text":"ibiro neno Jerusalem kama kwe nitie,","poem":2},{"text":"hema ma ok bi muki;","poem":1},{"text":"loje mage ok nopudhi, kata tondene ok nochodi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kanyo Jehova Nyasaye biro bedonwa Jal Maratego.","poem":1},{"text":"Kanyo nochalnwa ka aore kod mago matindo.","poem":2},{"text":"Yiedhi man-gi tanga ok nokwangʼ kanyo,","poem":1},{"text":"meli maduongʼ ok nokwangʼ e aore.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nimar Jehova Nyasaye e jangʼadnwa bura,","poem":1},{"text":"Jehova Nyasaye e jaketonwa chik,","poem":2},{"text":"kendo Jehova Nyasaye e ruodhwa;","poem":1},{"text":"en ema obiro resowa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Tondegi mag meli obwodhore:","poem":1},{"text":"Tanga ok otwe motegno,","poem":2},{"lineBreak":true},{"text":"ok ginyal kwangʼ maber.","poem":2},{"text":"Eka gik moyaki ibiro pogi","poem":1},{"text":"kendo kata mana joma rongʼonde noyud pok.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Onge ngʼama odak Sayun manowachi niya, “Atuo,”","poem":1},{"text":"kendo richo mag joma odak kanyo nowenegi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}