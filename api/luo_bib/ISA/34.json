{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"ISA","translationId":"luo_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"177512eb4f9e6ea3d7482c7e9c92bfcbf8e1b1aa8229f9944d921173728e87cc","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/luo_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":34,"content":[{"type":"heading","content":["Kum ne ogendini"]},{"type":"verse","number":1,"content":[{"text":"Suduru machiegni,","poem":1},{"text":"un ogendini kendo chikuru itu;","poem":2},{"text":"winjuru, un ogendini!","poem":1},{"text":"Mad piny kod gik moko manie iye winja!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jehova Nyasaye nigi ich wangʼ kod ogendini duto;","poem":1},{"text":"mirimbe ochomo jolweny mag-gi duto.","poem":2},{"text":"Obiro tiekogi duto,","poem":1},{"text":"mi nochiwgi mondo otiekgi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jogi monegi nowit oko,","poem":1},{"text":"mi ringregi nodungʼ kendo rembgi nopongʼ gode.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sulwe duto manie polo noleny nono,","poem":1},{"text":"polo noban mana ka kalatas,","poem":2},{"lineBreak":true},{"text":"gik moko duto manie polo malo nolwar,","poem":2},{"text":"mana ka it mzabibu moner,","poem":1},{"text":"kata ka olemb ngʼowu ma kundi ochwowo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Liganglana osetieko tichne e kor lwasi,","poem":1},{"text":"neuru, olor mondo ongʼad bura ne Edom,","poem":2},{"lineBreak":true},{"text":"oganda ma asetieko chuth.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ligangla mar Jehova Nyasaye opongʼ gi remo,","poem":1},{"text":"kendo boche ogawore kuome ma gin, remb rombe kod diek,","poem":2},{"text":"kaachiel gi boche moa e nyiroke mag imbe.","poem":1},{"text":"Nimar Jehova Nyasaye nigi misango Bozra kod nek ei Edom.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kendo jope, gi nyirwedhi","poem":1},{"text":"kod rwedhi madongo nopodh kodgi.","poem":2},{"text":"Pinygi nopongʼ gi remo,","poem":1},{"text":"kendo boche noum buru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nimar Jehova Nyasaye ni kod odiechienge mar chulo kuor,","poem":1},{"text":"ma en higa mar chiwo kum ne jogo,","poem":2},{"text":"mosetimo marach ne Sayun.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aore mag Edom nobar okak,","poem":1},{"text":"lopene nolokre lot maliet mawengʼo,","poem":2},{"text":"kendo pinye nowangʼ duto!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ok nokwe odiechiengʼ gotieno;","poem":1},{"text":"iro mare nodum kanyo nyaka chiengʼ.","poem":2},{"text":"Koa e tiengʼ moro nyaka machielo nodongʼ gunda;","poem":1},{"text":"onge ngʼat manochak oluwe kendo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nobed kama winj tula rutoe","poem":1},{"text":"kendo agak odakie.","poem":2},{"text":"Nyasaye nopim timbe maricho","poem":1},{"text":"mag Edom kod ketho mage.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Jodonge ok nobed gi gimoro","poem":1},{"text":"miluongo ni pinyruoth,","poem":2},{"lineBreak":true},{"text":"nyithi ruoth nolal nono.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kuthe ema noyugno e utege madongo,","poem":1},{"text":"aila kod pedo nobed ohingane.","poem":2},{"text":"Enobed piny mojwangʼ ma ondiegi","poem":1},{"text":"ema odakie kendo kuonde ma tula odakie.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Gi bungu norom gondiegi kuno,","poem":1},{"text":"kendo diek mag bungu noywagne jowetegi;","poem":2},{"text":"kanyo bende gik malich mag otieno noyud kar yweyo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tula noger ode kanyo monywol tongʼ,","poem":1},{"text":"motogi kendo norit nyithinde,","poem":2},{"lineBreak":true},{"text":"koumo e tipo mar bwombene;","poem":2},{"text":"kanyo bende ema otenga nochokre,","poem":1},{"text":"moro ka moro gi nyawadgi.","poem":2}]},{"type":"verse","number":16,"content":["Ngʼii e kitap Jehova Nyasaye kendo isom:",{"text":"Onge moro kuomgi kata achiel manobed maonge,","poem":2},{"text":"kendo moro ka moro nobed gi nyawadgi.","poem":1},{"text":"Nimar osegolo chik gi dhoge owuon,","poem":2},{"lineBreak":true},{"text":"kendo Roho mare ema nochokgi kanyakla.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Opogogi kuondegi;","poem":1},{"text":"kendo lwetene chiwogi gi rapim.","poem":2},{"text":"Enobed margi nyaka chiengʼ mi","poem":1},{"text":"gidag kanyo ndalo duto mag ngimagi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}