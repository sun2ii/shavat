{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"ISA","translationId":"luo_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"177512eb4f9e6ea3d7482c7e9c92bfcbf8e1b1aa8229f9944d921173728e87cc","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/luo_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":35,"content":[{"type":"heading","content":["Mor mar joma oresi"]},{"type":"verse","number":1,"content":[{"text":"Kuonde motimo ongoro","poem":1},{"text":"kendo mobaro okak nobed mamor;","poem":2},{"text":"kuonde thimbe nobed moil","poem":1},{"text":"kendo momiyo ka maua mathiewo,","poem":2},{"lineBreak":true},{"text":"mana kaka ondanyo,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"enogol maua mabeyo,","poem":1},{"text":"mi nobed gi mor ka ogoyo koko gi ilo.","poem":2},{"lineBreak":true},{"text":"Enobed gi duongʼ mar Lebanon,","poem":2},{"text":"gi mor mar Karmel kod Sharon;","poem":1},{"text":"ginine duongʼ mar Jehova Nyasaye, ma Nyasachwa maber.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Teguru bede mayom yom,","poem":1},{"text":"rieuru chong monyosore;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"koneuru joma nigi chuny mool ni,","poem":1},{"text":"“Beduru motegno kendo kik uluor;","poem":2},{"text":"nimar Nyasachu biro biro,","poem":1},{"text":"mondo ochul kuor ne wasiku,","poem":2},{"lineBreak":true},{"text":"kaka owinjore kendo oresu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Eka joma muofni nonen","poem":1},{"text":"kendo joma itgi odino nowinj wach.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eka rongʼonde nolengʼre ka nyakech","poem":1},{"text":"kendo momni nokog gi mor.","poem":2},{"text":"Pi nobubni kowuok e thim,","poem":1},{"text":"kendo oula nomol kar ongoro.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Piny ma yande otwo nolokre dago,","poem":1},{"text":"kendo achiya nowuog e lowo motwo.","poem":2},{"text":"Lum, odundu kod togo nodongi kama ondiegi yande odakie.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kendo wangʼ yo nobedi kanyo,","poem":1},{"text":"mi noluonge ni Wangʼ Yo Maler.","poem":2},{"text":"Joma ok ler ok nowuothie,","poem":1},{"text":"to nobedi wangʼ yo ma joma kare ema luwo,","poem":2},{"lineBreak":true},{"text":"joma ofuwo ma joricho ok nowuothie.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Onge sibuor manoyud kuno","poem":1},{"text":"kata mana ondieg bungu mager manade,","poem":2},{"text":"ok nosud machiegni kanyo.","poem":1},{"text":"To mana joma Nyasaye osewaro ema nowuothie,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"kendo joma Jehova Nyasaye osereso nodwogi.","poem":1},{"text":"Ginidonji Sayun ka giwer;","poem":2},{"text":"kendo ka ilo mosiko opongʼo chunygi.","poem":1},{"text":"Ginibed gi mor gi ilo mosiko,","poem":2},{"lineBreak":true},{"text":"kendo kuyo kod parruok norum chuth.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}