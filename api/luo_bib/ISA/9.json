{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"ISA","translationId":"luo_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"177512eb4f9e6ea3d7482c7e9c92bfcbf8e1b1aa8229f9944d921173728e87cc","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/luo_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":9,"content":[{"type":"heading","content":["Osenywolnwa nyathi"]},{"type":"verse","number":1,"content":["Kata kamano, joma ne nigi chandruok ok nochak obed gikuyo kendo. E ndalo mosekadho Nyasaye nomiyo piny Zebulun gi piny Naftali odoko pinje michayo, to e ndalo mabiro Jehova Nyasaye notingʼ malo Galili mar ogendini man yo nam modak e tiend aora Jordan:"]},{"type":"verse","number":2,"content":[{"text":"Joma wuotho e mudho","poem":1},{"text":"oseneno ler maduongʼ;","poem":2},{"text":"jogo modak e piny man-gi mudho mandiwa,","poem":1},{"text":"ler oserienynegi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isemiyo piny oyarore","poem":1},{"text":"kendo isemedo morgi,","poem":2},{"text":"mi gibedo gi ilo e nyimi","poem":1},{"text":"mana kaka oganda bedo gi mor e ndalo keyo,","poem":2},{"text":"kendo mana kaka ji bedo gi mor","poem":1},{"text":"ka gipogo gik ma oyaki.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mana kaka e kinde mane olo jo-Midian e lweny,","poem":1},{"text":"iseturo jok mane turogi,","poem":2},{"text":"kaachiel gi lodi mane gitingʼo e gokni,","poem":1},{"text":"ma gin ludh ngʼama sandogi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wuoch duto mag lweny","poem":1},{"text":"kaachiel gi lewni motimo remo mag jolweny,","poem":2},{"text":"ibiro ter e mach,","poem":1},{"text":"ginibedi ramoki mar mach.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nimar osenywolnwa nyathi,","poem":1},{"text":"adier osemiwa wuowi,","poem":2},{"lineBreak":true},{"text":"kendo loch nobedi e lwete.","poem":2},{"text":"Noluong nyinge ni","poem":1},{"text":"Jabura Mahono, Nyasaye Maratego,","poem":2},{"lineBreak":true},{"text":"Wuoro Manyaka Chiengʼ kendo Ruodh Kwe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lochne gi kwe mare nobed","poem":1},{"text":"maonge giko.","poem":2},{"text":"Enobed e kom loch mar Daudi","poem":1},{"text":"kendo e pinyruodhe,","poem":2},{"text":"bende enogure motegno","poem":1},{"text":"ka orite gi adiera kod tim makare,","poem":2},{"lineBreak":true},{"text":"chakre kawuono nyaka chiengʼ.","poem":2},{"text":"Jehova Nyasaye Maratego","poem":1},{"text":"notim ma kuom tekone owuon.","poem":2}]},{"type":"heading","content":["Mirimb Jehova Nyasaye kuom jo-Israel"]},{"type":"verse","number":8,"content":[{"text":"Jehova Nyasaye oseoro wach ni okecho gi joka Jakobo,","poem":1},{"text":"kendo wachno osechopo ne jo-Israel.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ji duto biro winjo wachno","poem":1},{"text":"jo-Efraim kod joma odak Samaria duto,","poem":2},{"text":"ma wuoyo gi sunga","poem":1},{"text":"kod wangʼ teko kawacho niya,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Ute mag matafare osepodho,","poem":1},{"text":"to wabiro gedo kendo kod kite mopa,","poem":2},{"text":"bende kata obedo ni yiend ngʼowu osetongʼ","poem":1},{"text":"to wabiro pidho yiend sida kargi.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"To Jehova Nyasaye biro miyo wasik Rezin teko mondo oked kodgi,","poem":1},{"text":"adier obiro thuwogi kod wasigu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Jo-Aram mane oa yo wuok chiengʼ kod jo-Filistia mane oa yo podho chiengʼ;","poem":1},{"text":"osetieko jo-Israel pep.","poem":2},{"lineBreak":true},{"text":"Kata ka magi duto osetimore,","poem":1},{"text":"to mirimbe pod ok orumo kuomgi","poem":2},{"lineBreak":true},{"text":"kendo pod odhi nyime mana gikumogi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kata obedo ni osekumogi kamano to ji pok odwogo ire","poem":1},{"text":"bende pok gimanyo wangʼ Jehova Nyasaye Maratego.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Omiyo Jehova Nyasaye biro ngʼado joma ogen kod ji ajia mag Israel,","poem":1},{"text":"othith kod odundu e odiechiengʼ achiel;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"jodongo kod joma ogen e wich jo-Israel,","poem":1},{"text":"to jonabi mapuonjo miriambo e iwe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Jotend ogandani osemiyo gilal","poem":1},{"text":"kendo joma otelnegi bende oserwenyo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kuom mano Ruoth Nyasaye ok nobed mamor gi jomatindo","poem":1},{"text":"bende ok nokech nyithi kiye kod mon ma chwogi otho,","poem":2},{"text":"nikech ji duto opongʼ gi richo kendo timo timbe mamono","poem":1},{"text":"bende dhogi opongʼ gi weche mochido.","poem":2},{"lineBreak":true},{"text":"To Kata ka magi duto osetimore to mirimbe ok orumo kuomgi","poem":1},{"text":"kendo pod odhi nyime mana gikumogi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Adier timbe mamono chalo gi mach maliel;","poem":1},{"text":"ma wangʼo pedo kod kuthe,","poem":2},{"text":"kendo omiyo bungu modinore wangʼ","poem":1},{"text":"mi dhuol iro maduongʼ mochomo malo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mirimb Jehova Nyasaye Maratego","poem":1},{"text":"biro wangʼo piny,","poem":2},{"text":"kendo ji ema nobed ramoki mar mach,","poem":1},{"text":"kendo onge ngʼat mano ngʼwon-ne nyawadgi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"E bathe korachwich gibiro mecho","poem":1},{"text":"to pod gidenyo adenya;","poem":2},{"text":"to e bathe koracham gibiro chiemo","poem":1},{"text":"to ok giniyiengʼ.","poem":2},{"text":"Ngʼato ka ngʼato nocham mana ringre nyathine owuon.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Manase biro chamo Efraim kendo Efraim nocham Manase;","poem":2},{"lineBreak":true},{"text":"giduto ginibed wasik Juda.","poem":2},{"lineBreak":true},{"text":"Kata ka magi duto osetimore,","poem":1},{"text":"to mirimbe pod ok orumo kuomgi","poem":2},{"lineBreak":true},{"text":"kendo pod odhi nyime mana gikumogi.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}