{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"JDG","translationId":"luo_bib","name":"Jongʼad Bura","commonName":"Jongʼad Bura","title":"Jongʼad Bura","order":7,"numberOfChapters":21,"sha256":"bf3186bc3acd10c7034f2570a4c8495894e07eca8fb90be86803a56ed727b558","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/luo_bib/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"heading","content":["Wend Debora"]},{"type":"verse","number":1,"content":["Chiengʼno Debora kod Barak wuod Abinoam nowero wendni:"]},{"type":"verse","number":2,"content":[{"text":"“Pakuru Jehova Nyasaye","poem":1},{"text":"nikech jotelo mag Israel okawo loch,","poem":2},{"lineBreak":true},{"text":"kendo ji giwegi ochiwore mar luwogi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Winjuru, un ruodhi! Chikuru itu, un jotelo!","poem":1},{"text":"Abiro pako Jehova Nyasaye ka awerne;","poem":2},{"lineBreak":true},{"text":"anachuog ne Jehova Nyasaye ma Nyasach Israel wer.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Yaye Jehova Nyasaye, piny noyiengni,","poem":1},{"text":"kendo polo nogingore,","poem":2},{"text":"mi koth ochwe kane iwuok Seir e piny Edom.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Got Sinai noyiengni","poem":1},{"text":"e nyim Jehova Nyasaye, ma Nyasach Israel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“E ndalo mag Shamgar wuod Anath,","poem":1},{"text":"kendo e ndalo Jael,","poem":2},{"lineBreak":true},{"text":"yore nojwangʼ, mi jowuoth ne luwo yore matindo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Teko mar jolweny e miech Israel norumo,","poem":1},{"text":"manyaka an Debora nabiro,","poem":2},{"lineBreak":true},{"text":"ma abedo ka min ji e piny Israel.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kane giyiero nyiseche manyien,","poem":1},{"text":"lweny nochakore e dhorangeye mag dala maduongʼ,","poem":2},{"text":"kata mana okumba kod tongʼ ne ok oyudie","poem":1},{"text":"kind jolwenj jo-Israel alufu piero angʼwen.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Opak Jehova Nyasaye","poem":1},{"text":"nikech chunya nigi jotend jo-Israel,","poem":2},{"lineBreak":true},{"text":"kaachiel gi jogo mochiwore!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Un joma oidho punde marochere,","poem":1},{"text":"kobedo e matandiko molos gi ongede,","poem":2},{"lineBreak":true},{"text":"kendo un joma wuotho e wangʼ yo,","poem":2},{"text":"winjuru,","poem":1}]},{"type":"verse","number":11,"content":[{"text":"dwond joma wer koa kuonde mamon umboe pi;","poem":1},{"text":"ka giwero timbe makare mag Jehova Nyasaye,","poem":2},{"lineBreak":true},{"text":"kendo ka gipako timbe makare mag jolweny mage mager man Israel.","poem":2},{"lineBreak":true},{"text":"“Bangʼ mano oganda Jehova Nyasaye","poem":1},{"text":"nodhi e dhorangeye mag dala maduongʼ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Debora, chiew, chiew!","poem":1},{"text":"‘Chungi kendo ia malo mondo ichak wer!","poem":2},{"text":"Aa malo, yaye Barak!","poem":1},{"text":"Ter jogo miseloyo e twech, yaye wuod Abinoam.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Eka jogo mane owe","poem":1},{"text":"nobiro ir ruodhi;","poem":2},{"text":"oganda Jehova Nyasaye","poem":1},{"text":"nobiro ira gi teko duto.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jomoko kuomgi nowuok e gode mag Efraim,","poem":1},{"text":"ogandagi nodak Amalek,","poem":2},{"lineBreak":true},{"text":"kendo joma noa Benjamin noluwo bangʼu.","poem":2},{"text":"Jotend lweny noa Makir nobiro,","poem":1},{"text":"kendo joma noa Zebulun notingʼo ludh jatend lweny.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Jotend Isakar ne nigi Debora;","poem":1},{"text":"adier, Isakar ne nigi Barak,","poem":2},{"lineBreak":true},{"text":"koreto bangʼe ka gichiko holo.","poem":2},{"text":"To e gwenge mag Reuben","poem":1},{"text":"ne nitiere nono chuny matut.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"En angʼo momiyo ne usiko","poem":1},{"text":"ka uoyo maj jokwath mondo omi uwinj ka jokwath liyo ni rombe?","poem":2},{"text":"To e gwenge mag Reuben","poem":1},{"text":"ne nitiere nono chuny matut.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Gilead nodongʼ loka Jordan.","poem":1},{"text":"To angʼo momiyo Dan nogalore but meli?","poem":2},{"text":"Asher to nodongʼ e dho nam","poem":1},{"text":"mi gidak e dho wedhe kuma yiedhi gowe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Jo-Zebulun nochiwo ngimagi ne tho;","poem":1},{"text":"kamano bende Naftali noketo mare e kuonde kedo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Ruodhi mag Kanaan nobiro,","poem":1},{"text":"mokedo;","poem":2},{"text":"Tanak machiegni gi pige mag Megido,","poem":1},{"text":"to ne ok gidhi gi fedha,","poem":2},{"lineBreak":true},{"text":"kata kawo gimoro amora moyako.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Koa e polo, sulwe nokedo,","poem":1},{"text":"koa kama gichakore negikedo gi Sisera.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Aora Kishon noywoyogi,","poem":1},{"text":"aora ma hike ngʼeny, aora Kishon.","poem":2},{"lineBreak":true},{"text":"Dhi nyime, chunya; bed motegno!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bangʼ mano mor mar tiende farese","poem":1},{"text":"nowinji kachikore gi teko mangʼeny.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Malaika mar Jehova Nyasaye nowacho ni,","poem":1},{"text":"‘Okwongʼ Meroz kaachiel gi joge gi kwongʼ malit,","poem":2},{"text":"nikech ne ok gibiro","poem":1},{"text":"mondo gikony Jehova Nyasaye e lwet joma tek.’","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Jael ma chi Heber ja-Keni en dhako","poem":1},{"text":"mogwedhi kuom mon duto,","poem":2},{"lineBreak":true},{"text":"kendo ogwedhe moloyo mon duto modak e hema.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nokwayo pi modho, to nomiye chak;","poem":1},{"text":"nokelone chak mopwo e bakul moromo ruoth chiemoe.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Norieyo lwete mondo okaw sigingi mar hema,","poem":1},{"text":"ka lwete korachwich nokawogo twor.","poem":2},{"text":"Nogoyo Sisera, motoyo wiye,","poem":1},{"text":"kendo nopowo lela wangʼe.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nopodho e tiende,","poem":1},{"text":"mogore piny; kendo kanyo ema nothoe.","poem":2},{"text":"Adier, nopodho e tiende, mogore piny;","poem":1},{"text":"kendo kama nopodhoeno, ema nogore piny motho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Min Sisera ne ngʼicho gie dirisa;","poem":1},{"text":"kaywak kama:","poem":2},{"text":"‘Angʼo momiyo gache odeko kapok obiro?","poem":1},{"text":"Angʼo momiyo mor mar gechene ok winjre?’","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Achiel kuom jotichne ma nyiri mariek nodwoke;","poem":1},{"text":"kawuoyo kende kama:","poem":2}]},{"type":"verse","number":30,"content":[{"text":"‘Donge gipogo gik moyaki ka ngʼato","poem":1},{"text":"ka ngʼato yudo nyako achiel kata ariyo,","poem":2},{"lineBreak":true},{"text":"kendo imiyo Sisera lewni mabeyo kaachiel gi lewni mabeyo motwangʼ mongʼith,","poem":2},{"text":"monego arwaki?’","poem":1}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Omiyo mad wasikgi duto rum, yaye Jehova Nyasaye!","poem":1},{"text":"To mad joma oheri chal gi chiengʼ,","poem":2},{"lineBreak":true},{"text":"mawuok gi teko.”","poem":2},"Bangʼ mano piny Israel nobedo gi kwe kuom higni piero angʼwen."]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}