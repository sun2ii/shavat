{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"JER","translationId":"luo_bib","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"5e628c4a5a87a9982766f9f50fa250729e7095726dc3567fc2089870cfd1e587","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/luo_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":12,"content":[{"type":"heading","content":["Ywagruok Jeremia"]},{"type":"verse","number":1,"content":[{"text":"In kare kinde duto, yaye Jehova Nyasaye,","poem":1},{"text":"sa moro amora makelo bucha e nyimi.","poem":2},{"text":"To kata kamano we mondo awuoye kodi","poem":1},{"text":"kuom ngʼado bura mari makare:","poem":2},{"text":"Ere gima omiyo yore mag joma","poem":1},{"text":"timbegi mono dhi maber?","poem":2},{"lineBreak":true},{"text":"Angʼo momiyo jogo maonge yie odak maber?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isepidhogi, kendo tiendegi osenyaa;","poem":1},{"text":"gidongo kendo ginywolo olemo.","poem":2},{"text":"Wechegi osiko e dhogi kinde","poem":1},{"text":"duto to chunygi bor kodi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kata kamano ingʼeya, yaye Jehova Nyasaye;","poem":1},{"text":"inena kendo ipimo pacha kaka aparo kuomi.","poem":2},{"text":"Ywagi tenge kaka rombo mitero kar yengʼo!","poem":1},{"text":"Ketgi tenge ne odiechieng yengʼo!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nyaka karangʼo ma piny biro","poem":1},{"text":"siko kotwo kendo lum motwi e lege ner?","poem":2},{"text":"Nikech joma odak e iye timbegi mono,","poem":1},{"text":"le kod winy osetho.","poem":2},{"text":"Kata kamano,","poem":1},{"text":"jogo wacho, “Ok none gima timorenwa.”","poem":2}]},{"type":"heading","content":["Dwoko mar Nyasaye"]},{"type":"verse","number":5,"content":[{"text":"Ka isepiem gi jogo","poem":1},{"text":"mawuotho gi tielo ma gioli,","poem":2},{"text":"to ere kaka inyalo piem gi farese?","poem":1},{"text":"Ka ichwanyori e piny man-gi kwe,","poem":2},{"lineBreak":true},{"text":"ere kaka inyalo wuotho e bungu man Jordan?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Oweteni ma jo-dalau bende osendhogi;","poem":1},{"text":"kendo gisegolo ywak maduongʼ ka gikwedi.","poem":2},{"text":"Kik igen kuomgi,","poem":1},{"text":"kata obedo ni giwuoyo maber kuomi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Anajwangʼ oda, anabol girkeni maga;","poem":1},{"text":"anachiw ngʼatno mahero e lwet wasike.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Girkeni osebedona ka sibuor manie bungu.","poem":1},{"text":"Orutona; omiyo amon kode.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Donge girkeni maga osebedona","poem":1},{"text":"ka kweth mag achudhe,","poem":2},{"text":"ma achudhe mamoko lworo mondo okedgo?","poem":1},{"text":"Dhi kendo ichok le mag bungu duto;","poem":2},{"lineBreak":true},{"text":"kelgi mondo gikidh joga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jokwath mangʼeny biro ketho puotha mar mzabibu","poem":1},{"lineBreak":true},{"text":"kendo ginyon puotha;","poem":1},{"lineBreak":true},{"text":"gibiro loko puotha mamiyo","poem":1},{"text":"bedo puodho motwo mojwangʼ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Enobed puodho mojwangʼ,","poem":1},{"text":"motwo, kendo machalo gunda e nyima;","poem":2},{"lineBreak":true},{"text":"pinyno duto noyugno nikech onge ngʼama dewe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kuonde duto mag ongoro","poem":1},{"text":"motingʼore gi malo mantiere kama otwo,","poem":2},{"text":"joketho nopongʼ,","poem":1},{"text":"nimar ligangla Jehova Nyasaye notiekgi,","poem":2},{"text":"koa e tungʼ piny konchiel nyaka komachielo;","poem":1},{"text":"maonge ngʼama notony.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ginipidh ngano makmana ginikaa kuthe;","poem":1},{"text":"gini nyagre gi tich to onge ohala ma giniyudi.","poem":2},{"text":"Omiyo yuduru wichkuot mar","poem":1},{"text":"keyo maru nikech mirimb Jehova Nyasaye mager.”","poem":2}]},{"type":"verse","number":14,"content":["Ma e gima Jehova Nyasaye wacho: “To ne jobatha duto ma timbegi mono mamayo joga Israel girkeni mane amiyogi, anapudhgi e pinjegi kendo anagol od Juda e diergi."]},{"type":"verse","number":15,"content":["To bangʼ ka asegologi, anakechgi kendo, bende anaduog moro ka moro ir girkeni mare owuon kod pinye owuon."]},{"type":"verse","number":16,"content":["Kendo ka gipuonjore maber yore mag joga kendo gikwongʼore gi nyinga, kagiwacho ni, ‘Akwongʼora gi nying Jehova Nyasaye mangima,’ mana kaka negipuonjo joga mondo okwongʼre ne Baal, eka gibiro dak e dier joga."]},{"type":"verse","number":17,"content":["To ka oganda moro amora ok dwar chiko ite, to anapudhe chuth mi atieke,” Jehova Nyasaye ema owacho."]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/JER/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/JER/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/JER/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}