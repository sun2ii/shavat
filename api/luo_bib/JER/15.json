{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"JER","translationId":"luo_bib","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"5e628c4a5a87a9982766f9f50fa250729e7095726dc3567fc2089870cfd1e587","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/luo_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":["Eka Jehova Nyasaye nowachona kama: “Kata dabed ni Musa gi Samuel ema nyalo chungʼ e nyima, to ok anyal weyonegi richogi. Golgi oko e nyima! Wegi gidhi!"]},{"type":"verse","number":2,"content":["To ka gipenji ni, ‘Ere kama wanyalo dhiyoe?’ To nyisgi ni, ‘Ma e gima Jehova Nyasaye wacho:",{"text":"“ ‘Mago matho ochomo, tho nonegi;","poem":1},{"lineBreak":true},{"text":"mago ma ligangla ochomo, noneg gi ligangla;","poem":1},{"lineBreak":true},{"text":"to mago ma kech ochomo, kech nonegi;","poem":1},{"lineBreak":true},{"text":"to mago ma twech ochomo, noter e twech.’ ”","poem":1}]},{"type":"verse","number":3,"content":["Jehova Nyasaye owacho niya, “Abiro oro masiche angʼwen mopogore opogore, ma gin ligangla mar nek kod guogi maywayo gi mabor gi winy mafuyo e kor polo gi ondiegi mag bungu mondo okidhgi kendo tiekogi."]},{"type":"verse","number":4,"content":["Anami pinjeruodhi duto mag piny bed gibuok kuomgi nikech gima Manase wuod Hezekia ruodh Juda notimo e Jerusalem."]},{"type":"verse","number":5,"content":[{"text":"“Ere ngʼama nokechi,","poem":1},{"text":"yaye Jerusalem? Ere ngʼama biro ywagi?","poem":2},{"lineBreak":true},{"text":"Ere ngʼama nochungʼ ma penji kaka idhi?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Jehova Nyasaye owacho niya,","poem":1},{"text":"“Isedaga. Isiko mana kibaro iweyo yo.","poem":2},{"text":"Omiyo anaket lweta kuomi kendo tieki;","poem":1},{"text":"ok anatimni ngʼwono kendo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Anapiedhgi gi odhech pietho e dhorangeye","poem":1},{"text":"mag dala maduongʼ mar piny.","poem":2},{"text":"Anakel lit kod kethruok ne joga,","poem":1},{"text":"nimar gitamore loko yoregi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Anami mon ma chwogi otho mag-gi bedo mathoth","poem":1},{"text":"moloyo kwoyo manie dho nam.","poem":2},{"text":"E odiechiengʼ tir anakel ngʼama nego mana rowere;","poem":1},{"text":"kendo apoya nono anakelnegi lit kod bwok maduongʼ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Miyo man-gi nyithindo abiriyo","poem":1},{"text":"nobed mool matho.","poem":2},{"text":"To chiengʼ marienyne nopodhi kapod en odiechiengʼ;","poem":1},{"text":"wiye nokuodi kendo chunye nochandre.","poem":2},{"text":"Ananeg jogo motony gi ligangla,","poem":1},{"lineBreak":true},{"text":"e nyim wasikgi,”","poem":1},{"text":"Jehova Nyasaye owacho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wuololo, minwa, angʼo momiyo ne inywola,","poem":1},{"text":"an ngʼat ma piny ngima piemgo kendo kedogo!","poem":2},{"text":"Pok aholo ngʼato kata an bende pok ohola,","poem":1},{"text":"to kata kamano ji duto kwongʼa.","poem":2}]},{"type":"verse","number":11,"content":["Jehova Nyasaye nowacho,",{"text":"“Adier anaresi gi gima omiyo maber;","poem":1},{"text":"adier anami wasiki sayi,","poem":2},{"lineBreak":true},{"text":"e kinde mag masira kod kinde mag thagruok.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Bende dhano nyalo turo chuma,","poem":1},{"text":"chuma moa yo nyandwat kata mula?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Mwandu magu kod mago ma","poem":1},{"text":"ukano anachiw mondo yaki, maonge chudo,","poem":2},{"lineBreak":true},{"text":"nikech richo magu duto e pinyu mangima.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Anaketu ubed wasumbini ne wasiku","poem":1},{"text":"e piny ma ok ungʼeyo,","poem":2},{"lineBreak":true},{"text":"nimar mirimba biro moko mach mabiro wangʼou.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"In ingʼeyo, yaye Jehova Nyasaye;","poem":1},{"text":"para kendo konya.","poem":2},{"lineBreak":true},{"text":"Chul kuor ne joma sanda.","poem":2},{"text":"Isenano koda omiyo kik iweya;","poem":1},{"text":"par kaka osesanda kochaya nikech in.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ka wechegi nobiro,","poem":1},{"text":"ne achamogi;","poem":2},{"text":"ne gin morna,","poem":1},{"text":"kendo ilo mar chunya,","poem":2},{"text":"nimar iluonga gi nyingi,","poem":1},{"text":"yaye Jehova Nyasaye Maratego.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ne ok abedo e kanyakla mar jojaro,","poem":1},{"text":"ne ok atimo nyasi kodgi;","poem":2},{"text":"to ne abedo kenda nikech lweti ne ni kuoma","poem":1},{"text":"kendo ne ipongʼa gi mirima.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Angʼo momiyo rem mara ok rum","poem":1},{"text":"kendo adhonda lich ma ok nyal thiedhore?","poem":2},{"text":"Bende inyalo bedona ka aora modwono,","poem":1},{"text":"mana ka soko motwo?","poem":2}]},{"type":"verse","number":19,"content":["Emomiyo ma e gima Jehova Nyasaye wacho:",{"text":"“Ka ilokori iweyo richoni,","poem":1},{"text":"anaduogi mondo itina;","poem":2},{"text":"ka iwacho weche mowinjore, ma ok manono,","poem":1},{"text":"to ni inibed ngʼat ma wuoyo e loya.","poem":2},{"text":"We jogi oduog ira,","poem":1},{"text":"to in kik idog irgi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Anaketi ibed ohinga ne jogi,","poem":1},{"text":"ohinga moger motegno mar mula;","poem":2},{"text":"giniked kodi to ok gini loyi,","poem":1},{"lineBreak":true},{"text":"nimar an kodi mondo akonyi kendo resi,”","poem":1},{"text":"Jehova Nyasaye owacho.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“Anaresi e lwet joma timbegi mono","poem":1},{"text":"kendo akonyi e lwet joma ger.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/JER/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/JER/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/JER/14.json","previousChapterAudioLinks":{},"numberOfVerses":21}