{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"JER","translationId":"luo_bib","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"5e628c4a5a87a9982766f9f50fa250729e7095726dc3567fc2089870cfd1e587","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/luo_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":2,"content":[{"type":"heading","content":["Israel ojwangʼo Nyasaye"]},{"type":"verse","number":1,"content":["Wach Jehova Nyasaye nobirona:"]},{"type":"verse","number":2,"content":["“Dhi kendo igo milome ka Jerusalem winjo ni:",{"lineBreak":true},"“Ma e gima Jehova Nyasaye wacho:",{"text":"“ ‘Aparo kaka ne ichiwori kane in rawera,","poem":1},{"lineBreak":true},{"text":"ne ihera ka nyako moikore ne kend,","poem":1},{"lineBreak":true},{"text":"ne iluwo bangʼa kama","poem":1},{"lineBreak":true},{"text":"otimo ongoro,","poem":1},{"text":"e piny ma ok purie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Israel ne en oganda maler ne Jehova Nyasaye,","poem":1},{"text":"kaka olembege mokwongo chiek;","poem":2},{"text":"jogo duto mane okidhe nomak kaka joketho,","poem":1},{"text":"kendo masira nomakogi,’ ”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye owacho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Winj wach Jehova Nyasaye, yaye od Jakobo,","poem":1},{"text":"un dhoudi duto mag dhood Israel.","poem":2}]},{"type":"verse","number":5,"content":["Ma e gima Jehova Nyasaye wacho:",{"text":"“En ketho mane mane wuoneu oyudo kuoma,","poem":1},{"text":"momiyo ne gibaro mabor koda?","poem":2},{"text":"Negiluwo bangʼ nyiseche manono","poem":1},{"text":"mi gibedo manono gin giwegi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne ok gipenjo ni, ‘Ere Jehova Nyasaye,","poem":1},{"text":"mane ogolowa Misri,","poem":2},{"text":"kendo otelonwa e thim ma ok nyag gimoro,","poem":1},{"text":"ka wakalo piny motwo kod piny motimo bugni,","poem":2},{"text":"piny ongoro kod mudho,","poem":1},{"text":"piny maonge ngʼama wuothoe,","poem":2},{"lineBreak":true},{"text":"kendo onge ngʼama odakie?’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne akelou e piny momewo","poem":1},{"text":"mondo ucham olembege kod nyak mage momewo.","poem":2},{"text":"To ne ubiro mi unjawo pinya","poem":1},{"text":"kendo umiyo girkeni maga obedo gima odwanyore.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Jodolo ne ok openjo,","poem":1},{"text":"‘Ere Jehova Nyasaye?’","poem":2},{"text":"Jogo matiyo gi chik ne ok ongʼeya;","poem":1},{"text":"jotelo nongʼanyona.","poem":2},{"text":"Jonabi nokoro gi Baal,","poem":1},{"text":"ka giluwo nyiseche manono.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"lineBreak":true},{"text":"“Emomiyo abiro kumou kendo.","poem":1},{"text":"Bende abiro kumo nyikwau.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dhiuru loka e dho nembe mag Kitim","poem":1},{"text":"kendo ungʼigi kaka gichalo,","poem":2},{"text":"bende oruru ji Kedar mondo ginon maber;","poem":1},{"text":"mondo gine anena ka gima chal kama nosebetie:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bende ogendini oseloko nyiseche nyaka nene?","poem":1},{"lineBreak":true},{"text":"(Kata kamano bende ok gin nyiseche.)","poem":1},{"text":"To joga osewilo duongʼ mar Nyasachgi,","poem":2},{"lineBreak":true},{"text":"gi nyiseche manono maonge tiendgi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kuom mano, agolonu chik, un polo,","poem":1},{"text":"mondo uyiengni malich, kuwuoro kendo kudhier nono,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye owacho.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Joga osetimo richo ariyo:","poem":1},{"lineBreak":true},{"text":"Gisejwangʼa,","poem":1},{"text":"an thidhna mar pi ngima,","poem":2},{"text":"kendo gisekunyo degnigi giwegi,","poem":1},{"text":"degni mobarore kendo ma ok nyal tingʼo pi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bende Israel en jatich,","poem":1},{"text":"ngʼat monywol ka misumba?","poem":2},{"lineBreak":true},{"text":"Kare en angʼo momiyo iyake?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Sibuoche oseruto;","poem":1},{"text":"kendo gisemorne.","poem":2},{"text":"Giseketho pinye;","poem":1},{"text":"dalane owangʼ kendo odongʼ gunda.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bende, jo-Memfis gi jo-Tapanhes","poem":1},{"text":"oselielo osimbo mar wiyi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Donge usekelo ma kuomu uwegi,","poem":1},{"text":"ka ujwangʼo Jehova Nyasaye ma Nyasachu,","poem":2},{"lineBreak":true},{"text":"kane otelonu e yo?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Koro angʼo momiyo udhi Misri","poem":1},{"text":"mondo umodh pi moa Shihor?","poem":2},{"text":"Kendo angʼo momiyo udhi Asuria","poem":1},{"text":"mondo umodh pi moa e Aora?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Timbeu maricho biro kelonu kum;","poem":1},{"text":"wech mane uweyago ema biro kelonu kum.","poem":2},{"text":"Nonuru kendo ubiro ngʼeyo malongʼo,","poem":1},{"text":"kaka en gima rach kendo lit ne un uwegi,","poem":2},{"text":"ka ujwangʼo Jehova Nyasaye ma Nyasachu,","poem":1},{"text":"kendo ubedo maonge kode gi luor kata matin,”","poem":2},{"lineBreak":true},{"text":"Ruoth Nyasaye ma en Jehova Nyasaye Maratego, owacho kamano.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Chon gi lala ne ituro jok magi","poem":1},{"text":"kendo ichodo rateke motweyigo;","poem":2},{"lineBreak":true},{"text":"kiwacho ni, ‘Ok anatini!’","poem":2},{"text":"Adier, ewi gode matindo duto","poem":1},{"text":"kendo e bwo yiende motimo otiep,","poem":2},{"lineBreak":true},{"text":"ninindo piny ka jachode.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ne apidhoi kaka mzabibu mar kodhi,","poem":1},{"text":"moyier makare kendo manyak.","poem":2},{"text":"Kara ere kaka ne iweya mi idonjo e timbe moduwore,","poem":1},{"text":"kendo ichalo gi mzabibu mar bungu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kata bedni ilwoko lweti gi magadi","poem":1},{"text":"kendo itiyo gi sabun mangʼeny,","poem":2},{"text":"chilo mar ketho mari pod nitiere e nyima,”","poem":1},{"text":"Jehova Nyasaye Manyalo Gik Moko Duto owacho.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“Ere kaka diwachi ni,","poem":1},{"text":"‘Ok adwanyora; pod ok aringo aluwo bangʼ Baal?’","poem":2},{"text":"Par kaka ne itimori e holo; par gima isetimo.","poem":1},{"text":"In ngamia ma nyako ma rikni maringo ka gi kacha,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"punda mar thim mongʼiyo gi kama otwo,","poem":1},{"text":"ma ngʼweyo yamo kodwaro thuondi;","poem":2},{"lineBreak":true},{"text":"en ngʼa madigengʼe?","poem":2},{"text":"Onge thuon manyalo thagore","poem":1},{"text":"ka dware nikech yude yot ka kinde miringo kode ochopo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kik iringi nyaka tiendi dongʼ","poem":1},{"text":"nono kendo dwondi two.","poem":2},{"text":"To ne iwacho, ‘Onge tiende!","poem":1},{"text":"Ahero nyiseche mag pinje mamoko,","poem":2},{"lineBreak":true},{"text":"kendo nyaka aluw bangʼ-gi.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Kaka jakuo wiye kuot ka omake,","poem":1},{"text":"omiyo od Israel wiye okuot,","poem":2},{"text":"gin gi ruodhigi kod jotendgi,","poem":1},{"text":"jodolo mag-gi kod jonabi mag-gi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Giwachone yien ni,","poem":1},{"text":"‘In wuonwa,’ kendo ne kidi ni,","poem":2},{"lineBreak":true},{"text":"‘In ema ne inywola.’","poem":2},{"text":"Giselokona ngʼegi to ok wengegi,","poem":1},{"text":"to sa ma gin e thagruok, giwacho niya,","poem":2},{"lineBreak":true},{"text":"‘Bi kendo ireswa!’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kare ere nyisecheu mane uloso ne un uwegi?","poem":1},{"text":"We mondo gibi ka ginyalo resou ka un e thagruok!","poem":2},{"text":"Nimar un gi nyiseche mangʼeny,","poem":1},{"text":"mana kaka un gi dala mangʼeny, yaye Juda.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Angʼo momiyo ungʼadona bura? To un duto","poem":1},{"text":"usengʼanyona,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye ema owacho.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"“Kum mane akumogo jou nobedo kayiem nono;","poem":1},{"text":"kendo ne ok gilokore.","poem":2},{"text":"Liganglani osekidho jonabi magi mana","poem":1},{"text":"kaka sibuor modenyo.”","poem":2}]},{"type":"verse","number":31,"content":["Un tiengʼ masani,",{"text":"paruru wach mar Jehova Nyasaye mawacho niya:","poem":2},{"text":"“Bende asebedo piny motwo ne Israel kata","poem":1},{"text":"ka piny motimo mudho mandiwa?","poem":2},{"text":"Angʼo momiyo joga wacho kama:","poem":1},{"text":"‘Wan thuolo mondo waba abaya; ok wanabi iri kendo?’","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Bende miaha diwiye wil gi gik molichorego,","poem":1},{"text":"kata nyako midhi kendo gi lepe mag kisera?","poem":2},{"lineBreak":true},{"text":"Joga to wigi osewil koda, odiechienge ma ok kwan.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Mano kaka in gi lony e dwaro hera!","poem":1},{"text":"Kata mana mon ma timbegi richo,","poem":2},{"lineBreak":true},{"text":"nyalo somo timbegi.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Remb joma odhier ma unego","poem":1},{"text":"yudore e lepu,","poem":2},{"lineBreak":true},{"text":"kata obedo nine ok umakogi ka gituro uteu.”","poem":2},{"text":"To kuom magi duto,","poem":1}]},{"type":"verse","number":35,"content":[{"text":"iwacho ni, “ ‘Aonge ketho,","poem":2},{"lineBreak":true},{"text":"kendo iye ok owangʼ koda.’","poem":2},{"text":"To abiro ngʼadoni bura","poem":1},{"text":"nikech iwacho ni, ‘Pod ok atimo richo.’","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Angʼo momiyo ilworori mangʼeny kiloko yoreni?","poem":1},{"text":"Ibiro kuod wiyi gi Misri kaka nokuod wiyi gi Asuria.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Bende ubiro aa kanyo gi lweteu ka uketo ewiu,","poem":1},{"text":"nimar Jehova Nyasaye osedagi joma ugeno kuomgi;","poem":2},{"lineBreak":true},{"text":"ok ginikonyu.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/JER/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}