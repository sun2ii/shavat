{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"JER","translationId":"luo_bib","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"5e628c4a5a87a9982766f9f50fa250729e7095726dc3567fc2089870cfd1e587","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/luo_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":30,"content":[{"type":"heading","content":["Oduog jo-Israel"]},{"type":"verse","number":1,"content":["Ma e wach mane obirone Jeremia koa kuom Jehova Nyasaye:"]},{"type":"verse","number":2,"content":["“Ma e gima Jehova Nyasaye, Nyasach Israel, wacho: ‘Ndik e kitabu weche duto masewachoni.’"]},{"type":"verse","number":3,"content":["Jehova Nyasaye wacho niya, ‘Ndalo biro ma anaduog joga Israel kod Juda koa e twech kendo achokgi e piny mane amiyo kweregi mondo okaw,’ Jehova Nyasaye owacho.”"]},{"type":"verse","number":4,"content":["Magi e weche mane Jehova Nyasaye owacho kuom Israel gi Juda:"]},{"type":"verse","number":5,"content":["“Ma e gima Jehova Nyasaye wacho:",{"text":"“ ‘Ywak mar luoro winjore,","poem":1},{"text":"en bwok malich, to ok kwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Koro lingʼuru mondo uparane:","poem":1},{"text":"Bende dichwo nyalo nywolo nyithindo?","poem":2},{"lineBreak":true},{"text":"To kare angʼo momiyo aneno dichwo ka dichwo maratego,","poem":2},{"text":"komako iye ka dhako mamuoch kayo,","poem":1},{"text":"ka luoro omakogi ka joma chiegni tho?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mano kaka odiechiengʼno nobed malich!","poem":1},{"text":"Onge manochal kode.","poem":2},{"text":"Enobed kinde mag chandruok ne Jakobo,","poem":1},{"text":"to norese.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jehova Nyasaye Maratego wacho niya,","poem":1},{"text":"“ ‘E odiechiengʼno anatur jok manie ngʼutgi,","poem":2},{"text":"kendo anachod nyoroche motwegigo;","poem":1},{"text":"joma welo ok nochak oketgi wasumbini mag-gi kendo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"To kata kamano ginitine Jehova Nyasaye ma Nyasachgi","poem":1},{"text":"kod Daudi ruodhgi,","poem":2},{"lineBreak":true},{"text":"ma anamigi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Omiyo kik iluor, yaye Jakobo jatichna;","poem":1},{"text":"kik ibwogi, yaye Israel,’","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye owacho.","poem":2},{"text":"‘Adier anaresi kia e piny mabor,","poem":1},{"text":"in kaachiel gi nyikwayi koaye piny motwegie.","poem":2},{"text":"Jakobo nobed gi kwe","poem":1},{"text":"kendo norite maonge ngʼama nomiye luoro.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anabed kodi kendo anaresi,’","poem":1},{"text":"Jehova Nyasaye wacho.","poem":2},{"text":"‘Kata obedo ni atieko chuth ogendini","poem":1},{"text":"duto ma akeyou e diergi,","poem":2},{"text":"ok anatieki chuth.","poem":1},{"text":"Anakumu ka angʼadonu bura makare;","poem":2},{"lineBreak":true},{"text":"ok anaweu ma ok akumou.’","poem":2}]},{"type":"verse","number":12,"content":["“Ma e gima Jehova Nyasaye wacho:",{"text":"“ ‘Adhola mari ok nyal thiedhi,","poem":1},{"text":"hinyruok mari okalo chango.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Onge ngʼama nyalo chiwo kwayoni kari,","poem":1},{"text":"kendo onge gima nyalo thiedhoni adhola,","poem":2},{"lineBreak":true},{"text":"kata manyalo changi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Joma ne osiepeni duto wigi osewil kodi;","poem":1},{"text":"kendo ok gidewi.","poem":2},{"text":"Asegoyi mana ka jasigu","poem":1},{"text":"kendo kumi mana ka ngʼama kwiny,","poem":2},{"text":"nikech ketho mari duongʼ","poem":1},{"text":"kendo richoni ngʼeny.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Angʼo momiyo iywak kuom adhondi,","poem":1},{"text":"to in-gi rem ma ok thiedhre?","poem":2},{"text":"Asekumou kamano nikech richou ngʼeny,","poem":1},{"text":"kendo nikech timbeu maricho lich.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“ ‘To jogo duto motiekou notieki;","poem":1},{"text":"wasiku duto noter e twech.","poem":2},{"text":"Jogo momayou nomagi;","poem":1},{"text":"jogo moketonu obadho anaketnegi obadho.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Anamiyi ngima maber","poem":1},{"text":"kendo anathiedh adhondeni,’","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye ema owacho,","poem":2},{"text":"‘nikech iluongi ni ngʼama owit oko,","poem":1},{"text":"Sayun maonge ngʼama dewo.’","poem":2}]},{"type":"verse","number":18,"content":["“Ma e gima Jehova Nyasaye wacho:",{"text":"“ ‘Anaduog mwandu mag hembe Jakobo","poem":1},{"text":"kendo abed gi ngʼwono e kuondege mag dak;","poem":2},{"text":"dala maduongʼ noger kendo e kuondege mano okethe,","poem":1},{"text":"kendo kar dak ruoth noger e kare malongʼo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Jogi nodwok erokamano ka giwer","poem":1},{"text":"kendo ka gikok gi mor.","poem":2},{"text":"Anamed kwan mag-gi,","poem":1},{"text":"kendo ok ginidog chien;","poem":2},{"text":"mi anamigi duongʼ,","poem":1},{"text":"kendo ok nokawgi matin.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nyithindgi nochal kaka e ndalo machon,","poem":1},{"text":"kendo anagur anywolagi motegno,","poem":2},{"lineBreak":true},{"text":"mi anakum jogo duto ma thirogi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Jatendgi nobed achiel kuomgi;","poem":1},{"text":"jatendgi noa e diergi.","poem":2},{"text":"Anakele machiegni kendo enobi machiegni koda,","poem":1},{"text":"nimar en ngʼa manyalo chiwore,","poem":2},{"lineBreak":true},{"text":"mondo obed machiegni koda?’ ”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye ema owacho.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“ ‘Omiyo unubed joga,","poem":1},{"text":"kendo anabed Nyasachu.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Neuru, apaka mar Jehova Nyasaye biro mwomore gi mirimbe,","poem":1},{"text":"yamo mafuto malich ka futo e wiye joma timbegi mono.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mirima mager mar Jehova Nyasaye ok nodog chien","poem":1},{"text":"nyaka one ni ochopo dwaro mar chunye.","poem":2},{"lineBreak":true},{"text":"E ndalo ma biro iniwinj tiend wachni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}