{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"JER","translationId":"luo_bib","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"5e628c4a5a87a9982766f9f50fa250729e7095726dc3567fc2089870cfd1e587","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/luo_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"lineBreak":true},{"text":"“Ka ibiro duogo, yaye Israel,","poem":1},{"text":"to duog ira.","poem":2},{"text":"Ka igolo nyisechegi mopa","poem":1},{"text":"mamonogo e nyima ma ok ubaro,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kendo kikwongʼori gi adiera gi bura makare kendo gi tim malongʼo ni,","poem":1},{"text":"‘Akwongʼora gi nying Jehova Nyasaye mangima,’","poem":2},{"text":"eka abiro gwedho ogendini duto manie piny","poem":1},{"text":"kendo ogendini duto biro miya duongʼ.”","poem":2}]},{"type":"verse","number":3,"content":["Ma e gima Jehova Nyasaye wachone jo-Juda kod Jerusalem:",{"text":"“Pururu puotheu mag mbora","poem":1},{"text":"kendo kik ukom e kind kuthe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Terreuru nyangu uwegi ni Jehova Nyasaye,","poem":1},{"text":"teruru chunjeu nyangu,","poem":2},{"lineBreak":true},{"text":"un jo-Juda kod jo-Jerusalem,","poem":2},{"text":"ka ok kamano to mirimba biro muoch mi liel ka mach,","poem":1},{"text":"nikech tim mamono ma usetimo manowangʼu,","poem":2},{"lineBreak":true},{"text":"maonge ngʼama nyalo kweye.”","poem":2}]},{"type":"heading","content":["Masira moa yo nyandwat"]},{"type":"verse","number":5,"content":[{"text":"“Land e Juda","poem":1},{"lineBreak":true},{"text":"kendo ior wach e Jerusalem kiwacho ni:","poem":1},{"text":"‘Gouru turumbete e piny duto!’","poem":2},{"text":"Ywag matek kendo iwachi:","poem":1},{"text":"‘Chokreuru kaachiel!","poem":2},{"lineBreak":true},{"text":"Waringuru wadhi e mier madongo mochiel motegno!’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Oruru wach odhi Sayun!","poem":1},{"text":"Ringuru udhi kar pondo ma ok odeko!","poem":2},{"text":"Nimar akelo masira koa yo nyandwat,","poem":1},{"text":"kata kethruok malich.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sibuor osewuok e kare mar pondo;","poem":1},{"text":"jatiek ogendini osewuok oko.","poem":2},{"text":"Oseweyo kare mondo otiek pinyu.","poem":1},{"text":"Miechu nomuki madongʼ gunda,","poem":2},{"lineBreak":true},{"text":"maonge ngʼama nodagie.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Omiyo rwakuru lepu mag ywak,","poem":1},{"text":"ywaguru kendo denguru,","poem":2},{"lineBreak":true},{"text":"nimar mirimb Jehova Nyasaye mager pod ok oweyowa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“Chiengʼno ruoth kod jotelo chunygi biro aa,","poem":2},{"text":"jodolo nobed gi luoro maduongʼ,","poem":1},{"text":"kendo jonabi nobed gi bwok maduongʼ.”","poem":2}]},{"type":"verse","number":10,"content":["Eka ne awacho, “Yaye Jehova Nyasaye Manyalo Gik Moko Duto, mano kaka isewuondo jogi kod Jerusalem ka iwacho ni, ‘Unubed gi kwe,’ mana sa ma ligangla ni e dwondwa.”"]},{"type":"verse","number":11,"content":["E kindego jogi kod Jerusalem nonyisi niya, “Yamo maliet moa kama gimoro ok nyagie mana kama otwo futo kadhi ir joga, to ok mondo okwadhgi kata pwodhogi;"]},{"type":"verse","number":12,"content":["to yamo motegno moloyo mano aa kuoma. Koro asengʼadonegi bura.”"]},{"type":"verse","number":13,"content":[{"text":"Ne! Obiro ka boche polo,","poem":1},{"text":"gechene mag lweny biro ka kalausi,","poem":2},{"text":"farese mage ringo matek moloyo ongo.","poem":1},{"text":"Kagiwacho niya, mano kaka wan gi lit!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yaye Jerusalem,","poem":1},{"text":"luok timbe mamono manie chunyu mondo iresri.","poem":2},{"lineBreak":true},{"text":"Nyaka karangʼo mi ibiro kano timbe richo e pachi?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Koko wuok koa Dan,","poem":1},{"text":"ka goyo milome mar masira koa e gode matindo mag Efraim.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Nyis ogendini","poem":1},{"text":"kendo go milome ne Jerusalem niya,","poem":2},{"lineBreak":true},{"text":"‘Jolweny mager biro iru kawuok e piny mabor,","poem":2},{"text":"ka gigoyo koko mar agengʼa","poem":1},{"text":"mar lweny kuom mier madongo mag Juda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Gilwore mana ka joma rito puodho,","poem":1},{"text":"nikech osengʼanyona,’ ”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye ema owacho.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Kiti kod timbegi iwuon","poem":1},{"text":"osemiyo ma obiro kuomi.","poem":2},{"lineBreak":true},{"text":"Ma en kum mari. Mano kaka olit!","poem":2},{"text":"Mano kaka opowo nyaka e chuny!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yaye, iya nyawni,","poem":2},{"lineBreak":true},{"text":"iya nyawni! An gi rem malit.","poem":2},{"text":"Yaye, lit mager mar chunya!","poem":1},{"text":"Chunya ridore, ok nyal lingʼ thi.","poem":2},{"text":"Nimar asewinjo koko mar turumbete;","poem":1},{"text":"asewinjo ywak mar kedo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Masira bangʼ masira;","poem":1},{"text":"piny duto okethi.","poem":2},{"text":"Ka diemo wangʼ nono hembena omuki,","poem":1},{"text":"kara mar dak ka mil polo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nyaka karangʼo mabiro nenoe kedo machalo kama,","poem":1},{"text":"kendo winjo dwond turumbete?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Joga ofuwo; ok gingʼeya.","poem":1},{"text":"Gin nyithindo maonge wigi gionge rieko,","poem":2},{"text":"gilony mana kuom timo timbe maricho;","poem":1},{"text":"kendo ok gingʼeyo; kaka digitim maber.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ne angʼiyo piny,","poem":1},{"text":"ne en nono kendo noonge gi kido;","poem":2},{"text":"kendo bende ne angʼiyo e polo,","poem":1},{"text":"to ler ne onge.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ne angʼiyo gode madongo","poem":1},{"text":"kendo negiyiengni,","poem":2},{"lineBreak":true},{"text":"to gode matindo duto ne rundore koni gi koni.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ne angʼicho to ne onge ji,","poem":1},{"text":"winy duto manie kor polo nosefuyo molal.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ne angʼicho to piny","poem":1},{"text":"mane miyo nolokore kama otwo;","poem":2},{"lineBreak":true},{"text":"dalane duto nokethi e nyim mirimb Jehova Nyasaye mager.","poem":2}]},{"type":"verse","number":27,"content":["Ma e gima Jehova Nyasaye wacho:",{"text":"“Piny mangima ibiro kethi,","poem":2},{"lineBreak":true},{"text":"kata kamano ok nakethe chutho.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Omiyo piny biro dengo","poem":1},{"text":"kendo polo malo notim mudho,","poem":2},{"text":"nikech asewuoyo kendo ok analok pacha,","poem":1},{"text":"asengʼado wach chuth kendo ok anadog chien.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ka dwol mar joidh farese","poem":1},{"text":"kod jo-asere owinji,","poem":2},{"text":"to dala ka dala golo aputh njiri.","poem":1},{"text":"Moko dhi e bunge modinore;","poem":2},{"lineBreak":true},{"text":"moko idho dhi ewi lwendni.","poem":2},{"text":"Mier duto ji odarie;","poem":1},{"text":"onge ngʼama odak eigi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"En angʼo mitimo,","poem":1},{"text":"yaye ngʼama osetiekni?","poem":2},{"text":"Angʼo momiyo irwakori gi law marakwaro","poem":1},{"text":"kendo idusori gi gige dhahabu?","poem":2},{"lineBreak":true},{"text":"Angʼo momiyo ibuko wangʼi gi rangi.","poem":2},{"text":"Idusori kayiem nono.","poem":1},{"text":"Johera magi jari;","poem":2},{"text":"gidwaro mana ngimani.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Awinjo ywak kaka mar dhako mamuoch kayo,","poem":1},{"text":"lit mana ka dhako ma nywolo nyathine makayo,","poem":2},{"text":"ywak mar Nyar Sayun ka gamo yweyo,","poem":1},{"text":"kotengʼo bedene kendo owacho,","poem":2},{"text":"“To mano kaka apodho;","poem":1},{"text":"ngimana omi jonek.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}