{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"JER","translationId":"luo_bib","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"5e628c4a5a87a9982766f9f50fa250729e7095726dc3567fc2089870cfd1e587","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/luo_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":46,"content":[{"type":"heading","content":["Ote kuom Misri"]},{"type":"verse","number":1,"content":["Ma e wach Jehova Nyasaye mane obirone janabi Jeremia kuom ogendini:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["Kuom Misri:",{"lineBreak":true},"Ma e ote ne jolwenj Farao Neko ruodh Misri, mane oloo Karkemish e Aora mar Yufrate gi Nebukadneza ruodh Babulon e higa mar angʼwen mar Jehoyakim wuod Josia ruodh Juda:"]},{"type":"verse","number":3,"content":[{"text":"“Ikuru okumba magu,","poem":1},{"text":"madongo kod matindo,","poem":2},{"lineBreak":true},{"text":"kendo uwuog udhi e kedo!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gauru farese, idhuru farese!","poem":1},{"text":"Kawuru kereu kurwako oguteu mag lweny!","poem":2},{"lineBreak":true},{"text":"Piaguru tongeu, rwakuru okumba mau!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"En angʼo ma aneno?","poem":1},{"text":"Kihondko ogoyogi,","poem":2},{"text":"kendo giringo ka gia kar lweny","poem":1},{"text":"nikech thuondi mag-gi mag lweny oselo.","poem":2},{"text":"Giringo ka luoro omakogi ma ok gingʼi ngʼegi,","poem":1},{"text":"kendo gin-gi luoro malich koni gi koni,”","poem":2},{"text":"Jehova Nyasaye wacho.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"“Joma yot ok nyal ringo","poem":1},{"text":"kata joma otegno ok nyal tony.","poem":2},{"text":"E yo nyandwat but Aora Yufrate","poem":1},{"text":"gichwanyore kendo gipodho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ma en ngʼa magingore ka aora Nael","poem":1},{"text":"kendo mana ka aore ma pigegi bubni?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Misri bubni ka aora Nael","poem":1},{"text":"kendo mana ka aore ma pigegi bubni.","poem":2},{"text":"Owacho ni, ‘Abiro gingora kendo anapongʼ piny;","poem":1},{"text":"anaketh mier madongo kod ji modakie.’","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wuoguru, yaye farese!","poem":1},{"text":"Yaye, un joriemb geche, riembgiuru matek!","poem":2},{"text":"Dhiuru nyime,","poem":1},{"text":"yaye un jolweny machwo moa Kush,","poem":2},{"text":"gi Put motingʼo okumbini,","poem":1},{"text":"kaachiel gi chwo Lidia maywayo atungʼ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"To odiechiengno en mar Ruoth,","poem":1},{"text":"Jehova Nyasaye Maratego ma en odiechiengʼ,","poem":2},{"text":"ma ochuloe kuor ni wasike.","poem":1},{"text":"Ligangla noneki nyaka owinj ni orome,","poem":2},{"text":"kendo nyaka otiek riyo mare gi remo.","poem":1},{"text":"Nimar Ruoth, Jehova Nyasaye Maratego,","poem":2},{"text":"nochiw misango e piny mantie yo","poem":1},{"text":"nyandwat but Aora Yufrate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Dhiyo nyaka Gilead","poem":1},{"text":"kendo imany yath, yaye Nyar Misri Mangili.","poem":2},{"text":"To kata obedo ni imedo manyo yedhe","poem":1},{"text":"to imenyo kayiem kendo ok inichangi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ogendini nowinj wichkuot momaki;","poem":1},{"text":"ywakni nopongʼ piny.","poem":2},{"text":"Jolweny nochwanyre kuom moro ka moro;","poem":1},{"text":"giduto ginipodhi kanyakla.”","poem":2}]},{"type":"verse","number":13,"content":["Ma e ote mane Jehova Nyasaye owachone Jeremia janabi kuom biro Nebukadneza ruodh Babulon mondo omonj Misri:"]},{"type":"verse","number":14,"content":[{"text":"“Land wachni e piny Misri,","poem":1},{"text":"kendo igo milome e Migdol;","poem":2},{"text":"Memfis gi Tapanhes ni:","poem":1},{"text":"‘Kawuru kereu kendo ikreuru,","poem":2},{"lineBreak":true},{"text":"nimar ligangla nego jogo molwori.’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"En angʼo momiyo","poem":1},{"text":"jolweny magu opie piny?","poem":2},{"text":"Ok ginyal chungʼ,","poem":1},{"text":"nimar Jehova Nyasaye nolwargi piny.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ginichwanyre moluwore oluwore;","poem":1},{"text":"giniluowre kuom jowetegi.","poem":2},{"text":"Giniwachi ni, ‘Aa malo,","poem":1},{"text":"wadog ir jowa wawegi;","poem":2},{"text":"kendo e pinywa owuon,","poem":1},{"text":"mabor gi ligangla mar joma thiro ji.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"E kanyono giniwach ni,","poem":1},{"text":"‘Farao ruodh Misri en mana jakoko matek,","poem":2},{"lineBreak":true},{"text":"nikech thuolo mane en-go nobaye.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ruoth wacho niya,","poem":1},{"text":"“Akwongʼora gi nyinga awuon,","poem":2},{"text":"ma en Jehova Nyasaye Maratego,","poem":1},{"text":"ngʼato achiel nobi machalo gi Tabor e dier gode,","poem":2},{"lineBreak":true},{"text":"kata ka Got Karmel mantie but nam.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Pang gigi mar dhiyoe twech,","poem":1},{"text":"un joma odak Misri,","poem":2},{"text":"nimar Memfis nowe gunda,","poem":1},{"text":"kendo tieke chuth maonge ngʼama nodagie.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Misri en nyaroya maber neno,","poem":1},{"text":"to kalabugo birone koa yo nyandwat.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Jolweny mondiki chal gi nyiroye machwe.","poem":1},{"text":"Gin bende ginilokre kendo giring kanyakla,","poem":2},{"lineBreak":true},{"text":"ok giniriti,","poem":2},{"text":"nimar odiechiengʼ mar masira biro kuomgi,","poem":1},{"text":"kinde margi mar kum.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Misri nokudhi ka thuol maringo","poem":1},{"text":"ka jasigu masudo machiegni gi teko;","poem":2},{"text":"giniked kode gi ledhi,","poem":1},{"text":"mana ka chwo matongʼo yiende.”","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“Ginibet bungu mare,","poem":2},{"text":"kata obedo ni oyugno kamano.","poem":1},{"text":"Gingʼeny moloyo dede, ok nyal kwan-gi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nyar Misri nomi wichkuot,","poem":1},{"text":"kendo nochiwe ne jogo moa yo nyandwat.”","poem":2}]},{"type":"verse","number":25,"content":["Jehova Nyasaye Maratego, ma Nyasach Israel, wacho niya, “Achiegni kelo kum kuom Amon ma nyasach Thebes, kuom Farao, kuom Misri gi nyisechene kod ruodhi mage, kod jogo mogeno kuom Farao."]},{"type":"verse","number":26,"content":["Anachiwgi ne jogo madwaro ngimagi, ne Nebukadneza ruodh Babulon gi jotende. To kata kamano ji nodhi nyime dak Misri kaka chon,” Jehova Nyasaye owacho."]},{"type":"verse","number":27,"content":[{"text":"“Kik iluor; yaye jatichna Jakobo;","poem":1},{"lineBreak":true},{"text":"bende kik ibwogi, yaye Israel.","poem":1},{"text":"Adiera abiro resi e piny mabor,","poem":2},{"text":"kaachiel gi nyikwayi","poem":1},{"text":"e piny mane otergie twech.","poem":2},{"text":"Jakobo nodhi nyime ka nigi","poem":1},{"text":"kwe gi dak maonge luoro,","poem":2},{"lineBreak":true},{"text":"kendo onge ngʼama nobwoge.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kik iluor, yaye Jakobo jatichna, nimar an kodi.","poem":1},{"lineBreak":true},{"text":"Kata obedo ni atieko ogendini","poem":1},{"text":"duto ma asekeyou e diergi,","poem":2},{"lineBreak":true},{"text":"ok anatieku chuth.","poem":2},{"text":"Anakumu to mana gi bura makare;","poem":1},{"text":"ok anaweu ngangʼ ma ok akumou,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye owacho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}