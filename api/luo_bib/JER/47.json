{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"JER","translationId":"luo_bib","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"5e628c4a5a87a9982766f9f50fa250729e7095726dc3567fc2089870cfd1e587","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/luo_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["Ote kuom jo-Filistia"]},{"type":"verse","number":1,"content":["Ma e wach mar Jehova Nyasaye mane obirone janabi Jeremia kuom jo-Filistia kapok Farao nomonjo Gaza:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["Ma e gima Jehova Nyasaye wacho:",{"text":"“Neuru kaka pige gingore e yo nyandwat;","poem":1},{"text":"ginibed ataro mopongʼ.","poem":2},{"text":"Giniyieny e piny","poem":1},{"text":"kod gimoro amora manie iye,","poem":2},{"text":"mier gi jok modak eigi.","poem":1},{"text":"Ji noywagi;","poem":2},{"lineBreak":true},{"text":"jogo duto modak e piny nodengi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ka giwinjo","poem":1},{"text":"koko mar tiend farese ma giro,","poem":2},{"text":"kod koko mar geche wasigu","poem":1},{"text":"to gi moor tiend gechegi.","poem":2},{"text":"Wuone ok nokony nyithindgi;","poem":1},{"text":"lwetgi kalandhidhi nomaki.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nimar odiechiengʼ","poem":1},{"text":"osechopo mondo otiek jo-Filistia duto,","poem":2},{"text":"kendo gengʼo joma notony duto","poem":1},{"text":"mane nyalo konyo Turo kod Sidon.","poem":2},{"text":"Jehova Nyasaye ochiegni tieko jo-Filistia,","poem":1},{"text":"jogo mane otony moa e dho nam mar Kaftor.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Jo-Gaza noliel wigi","poem":1},{"text":"manyiso ni gin gi kuyo;","poem":2},{"text":"kendo jo-Ashkelon noket malingʼ thii.","poem":1},{"text":"Yaye un joma otony manie pewe,","poem":2},{"lineBreak":true},{"text":"unungʼadru nyaka kara angʼo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Uywak ni, ‘Yaye ligangla mar Jehova Nyasaye,","poem":1},{"text":"ibiro yweyo nyaka karangʼo?","poem":2},{"text":"Dog ei olaloni;","poem":1},{"text":"chungʼ kendo ilingʼ thi.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"To ere kaka onyalo yweyo","poem":1},{"text":"ka Jehova Nyasaye owuon osechiko,","poem":2},{"text":"ka osechiwo chik","poem":1},{"text":"mondo omonj Ashkelon to gi dho nam?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}