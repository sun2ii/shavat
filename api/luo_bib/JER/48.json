{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"JER","translationId":"luo_bib","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"5e628c4a5a87a9982766f9f50fa250729e7095726dc3567fc2089870cfd1e587","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/luo_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":48,"content":[{"type":"heading","content":["Wach kuom Moab"]},{"type":"verse","number":1,"content":["To kuom Moab:",{"lineBreak":true},"Ma e gima Jehova Nyasaye Maratego, ma Nyasach Israel wacho:",{"text":"“Mano kaka nobed malit ne Nebo,","poem":1},{"text":"nimar enokethe.","poem":2},{"text":"Kiriathaim nokuod wiye","poem":1},{"text":"kendo enomake;","poem":2},{"text":"kar pondogi nobed kama","poem":1},{"text":"inyiero kendo nomuke.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pak mar Moab ok nobedi kendo;","poem":1},{"text":"ji nochan kethruokne ei Heshbon kagiwacho kama:","poem":2},{"lineBreak":true},{"text":"‘Biuru, watiek pinyni.’","poem":2},{"text":"Yaye joma odak Madmen,","poem":1},{"text":"un bende ligangla nolawu mulingʼ thii.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Winj ywak moa Horonaim,","poem":1},{"text":"ywak mar duwruok maduongʼ gi kethruok.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Moab nokethi;","poem":1},{"text":"nyithinde matindo noywagre.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Giidho ka giluwo yo madhi Luhith,","poem":1},{"text":"gi ywak malit ka gidhi;","poem":2},{"text":"e yo maridore kadhi Horonaim","poem":1},{"text":"kendo ywak malit mar kethruok winjore.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ringuru! Ringuru ukony ngimau;","poem":1},{"text":"muchal gi bungu manie thim!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nikech ugeno kuom timbeu kod mwandu mau,","poem":1},{"text":"un bende nomaku,","poem":2},{"text":"kendo Kemosh noter e twech,","poem":1},{"text":"kanyakla gi jodolo mage kod jotelo mage.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Jaketh gik moko nobi e dala","poem":1},{"text":"ka dala kendo onge dala ma notony.","poem":2},{"text":"Holo noum kendo got mar mesa nomuki,","poem":1},{"text":"nikech Jehova Nyasaye osewacho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ket chumbi kuom Moab,","poem":1},{"text":"nimar enotieke;","poem":2},{"text":"miechgi nodongʼ gunda,","poem":1},{"text":"maonge ngʼama nodagi eigi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Okwongʼ ngʼat mayom yom e tich Jehova Nyasaye!","poem":1},{"text":"Okwongʼ ngʼat ma okano liganglane ma ok ochwerogo remo!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Moab oseyweyo chakre tin-ne,","poem":1},{"text":"ka divai mowe mos e aguche,","poem":2},{"text":"ma ok ool koa ei agulu achiel","poem":1},{"text":"kiloko machielo kendo pod ok odhi e twech.","poem":2},{"text":"Omiyo ndhathe pod nikare,","poem":1},{"text":"kendo tik mare ok olokore.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"lineBreak":true},{"text":"“Kinde biro, ma anaor ji manopuke oko,","poem":1},{"text":"kendo gini ole oko;","poem":2},{"lineBreak":true},{"text":"giniwe agulni mage nono kendo toyo agulni mage.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Eka Moab wiye nokuodi gi Kemosh,","poem":1},{"text":"mana kaka od Israel wiye nokuot,","poem":2},{"lineBreak":true},{"text":"kane gin-gi geno kuom Bethel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Ere kaka inyalo wacho ni, ‘Wan jokedo,","poem":1},{"text":"ji mathuondi maroteke e lweny’?”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ruoth, ma nyinge Jehova Nyasaye Maratego wacho niya,","poem":1},{"lineBreak":true},{"text":"“Moab nokethi kendo mier mage nomonji;","poem":1},{"text":"yawuote mabeyo noter e kar nek.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Podho mar Moab osechopone;","poem":1},{"text":"masichene nobi mapiyo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ywageuru, un jogo duto modak machiegni kode,","poem":1},{"text":"un jogo duto mongʼeyo humbe;","poem":2},{"text":"wachuru ni, ‘Mano kaka otur odunga mar loch maratego,","poem":1},{"text":"mano kaka otur ludh duongʼ!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Auru malo e duongʼu ulor piny","poem":1},{"text":"kendo ubedi e lowo motwo,","poem":2},{"lineBreak":true},{"text":"yaye jodak mar Nyar Dibon,","poem":2},{"text":"nimar ngʼama oketho Moab nobi","poem":1},{"text":"mondo oked kodu,","poem":2},{"lineBreak":true},{"text":"kendo otiek miechu madongo mochiel motegno gohinga.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Chunguru e bath yo kendo ungʼi,","poem":1},{"text":"un joma odak Aroer.","poem":2},{"text":"Penj dichwo maringo","poem":1},{"text":"kod dhako maringo, ni,","poem":2},{"lineBreak":true},{"text":"Angʼo mosetimore?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Okuod wi Moab,","poem":1},{"text":"nimar ongʼinje matindo tindo.","poem":2},{"text":"Dengi kendo iywag matek!","poem":1},{"text":"Land e Arnon ni Moab okethi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ngʼado bura osebiro","poem":1},{"text":"e got mar mesa kuom Holon,","poem":2},{"lineBreak":true},{"text":"Jaza kod Mefath,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"kuom Dibon,","poem":1},{"text":"Nebo kod Beth Diblathaim,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"kuom Kiriathaim,","poem":1},{"text":"Beth Gamul kod Beth Mion,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"kuom Kerioth gi","poem":1},{"text":"Bozra, kuom mier duto mag Moab,","poem":2},{"lineBreak":true},{"text":"man mabor kod mago man machiegni.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Tung Moab ongʼad oko;","poem":1},{"text":"bade otur,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye ema owacho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Kete omer,","poem":1},{"text":"nimar osetamore winjo Jehova Nyasaye.","poem":2},{"text":"We Moab odwanyre e ngʼokne;","poem":1},{"text":"we obed gima ijaro.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Donge Israel ema ne ijaro?","poem":1},{"text":"Bende nomake e dier jokwoge,","poem":2},{"text":"ma itengʼone wiyi gi achaya sa moro","poem":1},{"text":"amora miwuoyo kuome?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Jwangʼuru miechu","poem":1},{"text":"kendo udagi e kind lwendni,","poem":2},{"text":"un joma odak Moab.","poem":1},{"text":"Chaluru ka akuch odugla maloso ode e dho rogo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Wasewinjo sunga mar Moab,","poem":1},{"text":"sungane mokadhore gi miriambo,","poem":2},{"text":"sunga mare gi jendeke","poem":1},{"text":"mare kod ngʼayi mar chunye.”","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“Angʼeyo mirimbe to oonge tiende,","poem":2},{"lineBreak":true},{"text":"kendo ngʼayi mage ok nyal gimoro.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Emomiyo aywak kadengo kuom Moab,","poem":1},{"text":"nimar kuom Moab duto aywak,","poem":2},{"lineBreak":true},{"text":"aywago jo-Kir Hareseth.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Aywagou, kaka Jazer ywak,","poem":1},{"text":"yaye mzabibu mag Sibma.","poem":2},{"text":"Bedeni kar machopo e nam;","poem":1},{"text":"negichopo nyaka e nam mar Jazer.","poem":2},{"text":"Jaketh gik moko osepodho e olembegi","poem":1},{"text":"mochiek kod olemo mar mzabibu.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ilo gi mor orumo e puoth olembe","poem":1},{"text":"kod puothe mag Moab.","poem":2},{"text":"Asechungo chwer mar divai koa","poem":1},{"text":"e kuonde mibiyogie;","poem":2},{"text":"onge ngʼama nyonogi gi koko mar ilo.","poem":1},{"text":"Kata obedo ni nitiere koko,","poem":2},{"lineBreak":true},{"text":"ok gin koko mar ilo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Dwond ywak mag-gi winjore","poem":1},{"text":"koa Heshbon nyaka Eleale gi Jahaz,","poem":2},{"text":"koa Zoar nyaka chop Horonaim gi Eglath Shelishiya,","poem":1},{"text":"nimar kata pige mag Nimrim bende osetwo.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"E Moab anatiek jogo matimo misengini","poem":1},{"text":"e kuonde motingʼore gi malo,","poem":2},{"lineBreak":true},{"text":"kendo ma wangʼo ubani ne nyisechegi,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye ema owacho.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"“Omiyo chunya ywagorene Moab ka asili;","poem":1},{"text":"oywagore ka asili ne jo-Kir Hareseth.","poem":2},{"lineBreak":true},{"text":"Mwandu mane giyudo oserumo.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Wich ka wich oliel","poem":1},{"text":"kendo yie tik ka yie tik ongʼad oko;","poem":2},{"text":"lwedo ka lwedo otongʼ","poem":1},{"text":"oko kendo nungo ka nungo oum gi law ywak.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ewi tat udi duto man Moab","poem":1},{"lineBreak":true},{"text":"kendo e laru mar galamoro","poem":1},{"text":"onge gimoro makmana ywak,","poem":2},{"text":"nimar aseketho Moab ka","poem":1},{"text":"agulu motore maonge ngʼama dwaro,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye ema owacho.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"“Mano kaka otieke! Mano kaka gidengo!","poem":1},{"text":"Mano kaka Moab loko ngʼeye kopondo nikech wichkuot!","poem":2},{"text":"Moab osebedo gir ajara,","poem":1},{"text":"gima bwogo ji duto man bute.”","poem":2}]},{"type":"verse","number":40,"content":["Ma e gima Jehova Nyasaye wacho:",{"text":"“Ne! Otenga fuyo kochiko piny,","poem":1},{"text":"oyaro bwombene ewi Moab.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Kerioth nomaki","poem":1},{"text":"kendo kuondegi mag pondo nokaw.","poem":2},{"text":"E odiechiengno chunje mag jolwenj Moab","poem":1},{"text":"nochal gi chuny dhako mamuoch kayo.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Moab notieki kaka oganda","poem":1},{"text":"nikech ne otamore winjo Jehova Nyasaye.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Masira maduongʼ gi bur matut","poem":1},{"text":"kod otegu ritou, yaye jo-Moab,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye ema owacho.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"“Ngʼatno manotem tony","poem":1},{"text":"nikech masira nolwar e bur matut,","poem":2},{"text":"ngʼatno manotem kawuok ei bur matut,","poem":1},{"text":"nomak gi obadho;","poem":2},{"text":"nimar anakel magi","poem":1},{"text":"kuom Moab e higa mar kum,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye ema owacho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“E tipo mar Heshbon","poem":1},{"text":"joma noringo odongʼ ka ok nyal,","poem":2},{"text":"nimar mach osemoko liel Heshbon","poem":1},{"text":"kendo ligek mach osewuok e dier Sihon;","poem":2},{"text":"owangʼo lela wangʼ Moab,","poem":1},{"text":"kod choke wich mag jongʼayigo!","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Mano kaka inine malit, yaye Moab!","poem":1},{"text":"Jo-Kemosh otieki;","poem":2},{"text":"yawuoti oter e twech,","poem":1},{"text":"kendo nyigi oket wasumbini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“Kata kamano anaduog gweth mag Moab","poem":1},{"text":"e ndalo mabiro,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye ema owacho.","poem":2},"Ma e giko mar ngʼadone Moab bura."]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}