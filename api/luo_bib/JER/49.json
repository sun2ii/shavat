{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"JER","translationId":"luo_bib","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"5e628c4a5a87a9982766f9f50fa250729e7095726dc3567fc2089870cfd1e587","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/luo_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":49,"content":[{"type":"heading","content":["Wach kuom Amon"]},{"type":"verse","number":1,"content":["Wach kuom jo-Amon:",{"lineBreak":true},"Ma e gima Jehova Nyasaye wacho:",{"text":"“Onge yawuowi e Israel?","poem":1},{"text":"Oonge gi jarit girkeni mage?","poem":2},{"text":"To kare angʼo momiyo Molek osekawo mwandu Gad?","poem":1},{"text":"Angʼo momiyo joge odak e dalane?”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“To ndalo biro,","poem":2},{"text":"ma anagoye koko mar lweny","poem":1},{"text":"mondo oked gi Raba mar jo-Amon;","poem":2},{"text":"enobed pith mar kethruok,","poem":1},{"text":"kendo gwenge molworogi nowangʼ.","poem":2},{"text":"Eka Israel noriemb","poem":1},{"text":"jogo mane oriembogi,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye ema owacho.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Dengi, yaye Heshbon, nimar Ai okethi!","poem":1},{"text":"Ywaguru, yaye joma odak Raba!","poem":2},{"text":"Rwakuru lepu mag ywak kendo uywagi;","poem":1},{"text":"ringuru koni gi koni,","poem":2},{"lineBreak":true},{"text":"e alwora mar dala,","poem":2},{"text":"nimar Molek noter e twech,","poem":1},{"text":"kaachiel gi jodolo mage kod jotelo mage.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Angʼo momiyo usungoru kuom holo mau,","poem":1},{"text":"sungruok kuom holo mau manyak?","poem":2},{"text":"Yaye nyako ma ok ja-ratiro,","poem":1},{"text":"igeno kuom mwandu magi kendo iwacho niya,","poem":2},{"lineBreak":true},{"text":"Ngʼama biro monja?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Anakel luoro kuomu koa","poem":1},{"lineBreak":true},{"text":"kuom jogo duto man butu,”","poem":1},{"text":"Ruoth, Jehova Nyasaye Maratego ema owacho.","poem":2},{"text":"“Un duto noriembu,","poem":1},{"text":"kendo onge ngʼama nochok joma noringo moke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Kata kamano bangʼe, anaduog mwandu jo-Amon,”","poem":1},{"text":"Jehova Nyasaye ema owacho.","poem":2}]},{"type":"heading","content":["Wach Kuom Edom"]},{"type":"verse","number":7,"content":["Ma e gima Jehova Nyasaye Maratego wacho kuom Edom:",{"lineBreak":true},{"text":"“Bende pod nitie rieko ei Teman?","poem":1},{"text":"To puonj oselalne jorieko?","poem":2},{"lineBreak":true},{"text":"To rieko mag-gi osetop?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lokreuru kendo uringi,","poem":1},{"text":"ponduru e rogo mopandore,","poem":2},{"text":"un joma odak Dedan, nimar anakel masira","poem":1},{"text":"ne Esau e kinde ma anakume.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ka jopon olemb mzabibu obiro iru,","poem":1},{"text":"donge digiwe olemb mzabibu matin?","poem":2},{"text":"Ka jokwoge obiro gotieno,","poem":1},{"text":"donge gibiro kwalo mwandu magu kaka ginyalo?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"To analony Esau duk;","poem":1},{"text":"anael kuondege malingʼ-lingʼ,","poem":2},{"lineBreak":true},{"text":"mondo omi kik opondi.","poem":2},{"text":"Nyithinde, wedene gi jomodak bute nolal nono,","poem":1},{"text":"kendo ok nochak obed chutho.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Weuru kiye mau; anares ngimagi.","poem":1},{"text":"Mondu duto ma chwogi otho,","poem":2},{"lineBreak":true},{"text":"bende nyalo keto geno mag-gi kuoma.”","poem":2}]},{"type":"verse","number":12,"content":["Ma e gima Jehova Nyasaye wacho: “Ka jogo ma ok owinjore omadh kikombe nyaka madhe, to angʼo momiyo ok anyal kumi? Ok initony ma ok okumi, to nyaka imadhe.”"]},{"type":"verse","number":13,"content":["Jehova Nyasaye wacho niya, “Akwongʼora gi nyinga awuon, ni Bozra nokethi kendo nobed gir bwogo ji, gir jaro kendo nobed gir kwongʼ, kendo mieche duto nokethi chuth.”"]},{"type":"verse","number":14,"content":[{"text":"Asewinjo wach koa kuom Jehova Nyasaye kama:","poem":1},{"text":"Jaote oseor mondo owach ne ogendini niya,","poem":2},{"text":"“Chokreuru mondo umonje!","poem":1},{"text":"Chungʼuru malo wadhi e kedo!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Koro abiro miyo udok matin","poem":1},{"text":"e kind ogendini, kendo joma ijaro e dier ji.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Luoro musemiyo ji kod","poem":1},{"text":"sunga manie chunyu osewuondou,","poem":2},{"text":"un jogo modak e kind lwendni,","poem":1},{"text":"modak kuonde motingʼore gi malo mar got.","poem":2},{"text":"Kata obedo ni ugero uteu mabor ka od otenga,","poem":1},{"text":"koa kuno abiro dwokou piny,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye owacho.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Edom nobed gima bwogo ji;","poem":1},{"text":"jogo duto makalo bute nohum nono,","poem":2},{"lineBreak":true},{"text":"kendo gininyiere ka gineno adhondene duto.”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“Mana kaka Sodom gi Gomora nokethi,","poem":2},{"lineBreak":true},{"text":"kaachiel gi mier mokiewo kodgi,","poem":2},{"text":"e kaka en bende nobedi maonge","poem":1},{"text":"ngʼato angʼata modak kanyo kendo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Ka sibuor mabiro koa","poem":1},{"text":"e bungu moyugno mar Jordan nyaka","poem":2},{"lineBreak":true},{"text":"kar kwath man-gi lum,","poem":2},{"text":"anariemb Edom oa e pinye kadiemo wangʼ.","poem":1},{"text":"En ngʼa mowal manyalo yiero ne ma?","poem":2},{"text":"En ngʼa machalo koda kendo manyalo chungʼ koda?","poem":1},{"text":"Koso jakwath mane manyalo chungʼ koda?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Emomiyo, winj gima Jehova Nyasaye","poem":1},{"text":"osechano timo ne Edom,","poem":2},{"text":"gima oseramo ni nyaka otimne joma odak Teman:","poem":1},{"text":"Nyithi rombe bende nokaw;","poem":2},{"lineBreak":true},{"text":"enoketh chuth kuondegi mag kwath nikech gin.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Piny noyiengni kowinjo ni ologi;","poem":1},{"text":"ywakgi nowinjre nyaka e Nam Makwar.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ne! Otenga nofu kochomo malo","poem":1},{"text":"kendo piny koyaro bwombene ewi Bozra.","poem":2},{"text":"E odiechiengno chunje jolweny mag Edom","poem":1},{"text":"nochal gi chuny dhako mamuoch kayo.","poem":2}]},{"type":"heading","content":["Wach kuom Damaski"]},{"type":"verse","number":23,"content":["Kuom Damaski:",{"text":"“Hamath gi Arpad luoro omako,","poem":1},{"text":"nimar giwinjo wach marach,","poem":2},{"text":"chunygi omoko,","poem":1},{"text":"kendo nigi chandruok ka nam mogingore.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Damaski osebedo maonge teko,","poem":1},{"text":"osea gi ngʼwech,","poem":2},{"text":"kendo achiedh-nade osemake;","poem":1},{"text":"lit gi rem osemake,","poem":2},{"lineBreak":true},{"text":"kaka rem mar dhako mamuoch kayo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Angʼo momiyo ok osejwangʼ","poem":1},{"text":"dala maduongʼ mongʼere; dala mamor godo?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Adiera, joge matindo nopodh e yore;","poem":1},{"text":"jolweny mage duto nolingʼ thi odiechiengno,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye Maratego owacho.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"“Anawangʼ ohingini mag Damaski;","poem":1},{"text":"notiek kuonde mochiel motegno mag Ben-Hadad.”","poem":2}]},{"type":"heading","content":["Wach kuom Keda kod Hazo"]},{"type":"verse","number":28,"content":["Kuom Kedar gi pinyruodhi mag Hazor, mane Nebukadneza ruodh Babulon omonjo:",{"lineBreak":true},"Ma e gima Jehova Nyasaye wacho:",{"text":"“Chungʼuru malo,","poem":1},{"text":"kendo umonj Keda,","poem":2},{"lineBreak":true},{"text":"mi utiek joma aa yo wuok chiengʼ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Hembegi gi jambgi nokaw;","poem":1},{"text":"kar dak margi nowal oko,","poem":2},{"lineBreak":true},{"text":"kaachiel gi mwandugi duto kod ngamia.","poem":2},{"text":"Ji nogonegi koko ni,","poem":1},{"text":"‘Masira maduongʼ koni gi koni!’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“Ringuru piyo uayi!","poem":2},{"text":"Daguru e rogo matut,","poem":1},{"text":"un joma odak Hazor.","poem":2},{"text":"Nebukadneza ruodh Babulon nigi paro marach kuomu;","poem":1},{"text":"osechano timonu marach.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Chunguru kendo umonj pinyni momewo,","poem":1},{"text":"modak kodhil,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye owacho,","poem":2},{"text":"“piny maonge dhorangeye kata lodi;","poem":1},{"text":"joge odak kendgi.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ngamia mag-gi noyaki","poem":1},{"text":"kendo kweth mag dhogi nope.","poem":2},{"text":"Anake joge mantie kuma bor e tunge piny","poem":1},{"text":"kendo anakelnegi masira koa koni gi koni,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye owacho.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"“Hazor nobed thim mar ondiegi,","poem":1},{"text":"kama ojwangʼ nyaka chiengʼ.","poem":2},{"text":"Onge ngʼama nodag kanyo;","poem":1},{"text":"onge ngʼama nodag e iye.”","poem":2}]},{"type":"heading","content":["Wach kuom Elam"]},{"type":"verse","number":34,"content":["Ma e wach Jehova Nyasaye mane obirone janabi Jeremia kuom Elam, e ndalo chakruok mar loch Zedekia ruodh Juda:"]},{"type":"line_break"},{"type":"verse","number":35,"content":["Ma e gima Jehova Nyasaye Maratego, wacho:",{"text":"“Ne, anatur atung Elam,","poem":1},{"text":"girgi maduongʼ mar tekogi.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Anamonj Elam gi yembe angʼwen moa","poem":1},{"text":"e tunge angʼwen mar polo;","poem":2},{"text":"anakegi e yembe angʼwen-go kendo onge piny ma","poem":1},{"text":"jo-Elam momaki ok nodhiye.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Anami Elam ongʼengʼ e nyim wasike,","poem":1},{"text":"e nyim jogo madwaro tieko ngimagi;","poem":2},{"text":"anakel masiche kuomgi,","poem":1},{"text":"ma en mirimba mager,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye ema owacho.","poem":2},{"text":"“Analawgi gi ligangla","poem":1},{"text":"manyaka atiekgi.”","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“Anaket koma mar duongʼ ei Elam,","poem":2},{"lineBreak":true},{"text":"kendo atiek ruodhe kod jotende.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“Kata kamano anaduog mwandu Elam","poem":1},{"text":"e ndalo ma biro,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye ema owacho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/JER/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/JER/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/JER/48.json","previousChapterAudioLinks":{},"numberOfVerses":39}