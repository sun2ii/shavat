{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"JER","translationId":"luo_bib","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"5e628c4a5a87a9982766f9f50fa250729e7095726dc3567fc2089870cfd1e587","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/luo_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":5,"content":[{"type":"heading","content":["Onge ngʼama ja-ratiro"]},{"type":"verse","number":1,"content":[{"text":"“Wuothi e yore mag Jerusalem duto,","poem":1},{"text":"rang koni gi koni kiparo,","poem":2},{"text":"kendo kimanyo kuondege duto.","poem":1},{"text":"Kinyalo yudo kata mana ngʼato achiel,","poem":2},{"text":"ma ja-ratiro kendo madwaro adiera,","poem":1},{"text":"to abiro ngʼwonone dala maduongʼni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kata obedo ni gisingore niya,","poem":1},{"text":"‘Akwongʼora gi nying Jehova Nyasaye mangima,’","poem":2},{"lineBreak":true},{"text":"pod gikwongʼore mar miriambo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yaye Jehova Nyasaye, donge wengeni manyo adiera?","poem":1},{"text":"Ne igoyogi, to ne ok giwinjo rem;","poem":2},{"lineBreak":true},{"text":"ne ikidhogi matindo tindo, to ne ok gilokore.","poem":2},{"text":"Negimiyo wengegi obedo matek moloyo","poem":1},{"text":"kidi mi gitamore hulo richogi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"To ne aparo ni, “Magi gin mana joma odhier;","poem":1},{"text":"kendo gifuwo;","poem":2},{"text":"nimar ok gingʼeyo yor Jehova Nyasaye","poem":1},{"text":"kod dwaro mar Nyasachgi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Omiyo anadhi ir jotelo","poem":1},{"text":"kendo awuo kodgi;","poem":2},{"lineBreak":true},{"text":"adiera gingʼeyo yor Jehova Nyasaye,","poem":2},{"text":"kod dwaro mar Nyasachgi.”","poem":1},{"text":"To gi chuny achiel gin bende negituro jok,","poem":2},{"lineBreak":true},{"text":"kendo gichodo rateke.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Emomiyo sibuor moa e bungu nomonjgi,","poem":1},{"text":"ondiek moa e thim nokidhgi,","poem":2},{"text":"kwach noliwgi but miechgi","poem":1},{"text":"mondo okidh matindo tindo,","poem":2},{"lineBreak":true},{"text":"ngʼato angʼata manohedhre wuok oko,","poem":2},{"text":"nimar ngʼanyo margi duongʼ","poem":1},{"text":"kendo gisebaro nyadi mangʼeny.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Angʼo ma dimi awenu richou?","poem":1},{"text":"Nyithindu osejwangʼa,","poem":2},{"text":"kendo osekwongʼore gi nyiseche","poem":1},{"text":"ma ok nyiseche.","poem":2},{"text":"Asemiyogi gigo duto magidwaro,","poem":1},{"text":"kata kamano giterore","poem":2},{"lineBreak":true},{"text":"kendo gipongʼo ute ochode.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Jogo oowre gi gombo,","poem":1},{"text":"gichalo farese moyiengʼ,","poem":2},{"text":"ma gombo ohewo ka moro,","poem":1},{"text":"ka moro kuomgi gombo mana chi ngʼat machielo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"lineBreak":true},{"text":"“Donge dakumgi kuom ma?”","poem":1},{"text":"Donge onego akel kum ne oganda machalo kama?","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dhi e puothege mag mzabibu","poem":1},{"lineBreak":true},{"text":"kendo ichadhgi, to kik ikethgi chuth.","poem":1},{"text":"Lwer bedene, nimar jogi ok gin mek Jehova Nyasaye.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“Od Israel kod od Juda ok osebedona jo-ratiro chutho.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Giseriambo kuom Jehova Nyasaye;","poem":1},{"text":"kagiwacho, “Onge gima obiro timo!","poem":2},{"lineBreak":true},{"text":"Ok wanahinyre; ok wanane ligangla kata kech.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Jonabi chalo mana yamo","poem":1},{"text":"kendo wach onge eigi;","poem":2},{"text":"omiyo we gima giwacho otimre ne gin giwegi.”","poem":1}]},{"type":"verse","number":14,"content":["Emomiyo ma e gima Jehova Nyasaye, Nyasaye Maratego wacho:",{"text":"“Nikech ji osewacho wechegi,","poem":1},{"text":"abiro keto wechega manie dhogi mach,","poem":2},{"lineBreak":true},{"text":"to jogi nobed yien maliel.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“Yaye od Israel, akelo oganda moa mabor mondo oked kodu,","poem":2},{"text":"gin oganda machon kendo man-gi sinani,","poem":1},{"text":"jogo ma ok ungʼe dhogi,","poem":2},{"lineBreak":true},{"text":"bende wechegi ok unyal winjo tiendgi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Gigegi mitingʼoe asere","poem":1},{"text":"chalo gi liel ma dhoge oyawore;","poem":2},{"text":"giduto gin jolweny maroteke.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Giniyak chambu kod chiembu,","poem":1},{"text":"ginitiek yawuotu gi nyiu;","poem":2},{"lineBreak":true},{"text":"kendo ginineg jambu kod dhou,","poem":2},{"text":"bende giniketh yiende mzabibu mau","poem":1},{"text":"kod yiende mag ngʼopeu.","poem":2},{"text":"Miechu madongo mochiel gohinga","poem":1},{"text":"motegno mugeno kuomgi nokethi gi ligangla.”","poem":2}]},{"type":"verse","number":18,"content":["Jehova Nyasaye wacho niya, “To kata bende e ndalogo, ok anatieku chuth."]},{"type":"verse","number":19,"content":["To ka ji openjo ni, ‘Angʼo momiyo Jehova Nyasaye ma Nyasachwa osetimonwa ma?’ Wachnegiuru ni, ‘Kaka usejwangʼa kendo usetiyone nyiseche mag pinje mamoko ei pinyu uwegi, omiyo koro ubiro tiyone ogendini mamoko ei piny ma ok maru.’"]},{"type":"verse","number":20,"content":[{"text":"“Land ma ne od Jakobo","poem":1},{"text":"kendo go milomeno ne Juda:","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Winj ma, un jogo mofuwo kendo onge wigi,","poem":1},{"text":"joma nigi wengegi to ok nen,","poem":2},{"lineBreak":true},{"text":"joma nigi it to ok winj wach:","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Donge onego umiya luor?” Jehova Nyasaye owacho.","poem":1},{"text":"“Donge dutetni e nyim wangʼa?","poem":2},{"text":"Ne aketo kuoyo obedo kiewo mar nam,","poem":1},{"text":"ragengʼ manyaka chiengʼ ma ok onyal kalo.","poem":2},{"text":"Apaka nyalo gingore, to ok ginyal kalo;","poem":1},{"text":"ginyalo ruto, to ok ginyal kalo dhi loka kocha.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"To jogi wigi tek kendo chunygi bor","poem":1},{"text":"koda omiyo gisebaro mi giweya.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ok giwach e kindgi giwegi,","poem":1},{"text":"‘Mad waluor Jehova Nyasaye ma Nyasachwa,","poem":2},{"text":"mamiyowa kodh chwiri kod kodh opon e kinde mowinjore,","poem":1},{"text":"ma singonwa gadiera jumbe mag keyo.’","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Timbeu maricho osetamou nwangʼo gigi;","poem":1},{"text":"richou osetamou neno maber.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“E dier joga nitiere joma timbegi mono","poem":1},{"text":"ma buto ka jogo machiko winy,","poem":2},{"lineBreak":true},{"text":"kendo kaka jogo maketo obadho mar mako ji.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kaka ute mopongʼ gi winy,","poem":1},{"text":"e kaka utegi bende opongʼ gi wuondruok;","poem":2},{"text":"gisebedo jo-mwandu,","poem":1},{"text":"kendo joma nigi teko mangʼeny,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"kendo gisebedo machwe","poem":1},{"text":"kendo dendgi leny.","poem":2},{"text":"Timbegi mamono onge giko;","poem":1},{"lineBreak":true},{"text":"ok gikony nyithi kiye mondo olo bura,","poem":1},{"text":"bende ok gikony joma odhier e ratiro mag-gi,","poem":2}]},{"type":"verse","number":29,"content":[{"text":"donge dakumgi kuom ma?”","poem":1},{"text":"Jehova Nyasaye owacho.","poem":2},{"text":"“Donge dakel kum mara","poem":1},{"text":"kuom oganda machalo kama?","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“Gima lich kendo mabwogo ji osetimore e piny:","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Jonabi koro miriambo,","poem":1},{"text":"jodolo tiyo gi tekogi giwegi,","poem":2},{"text":"kendo joga ohero mana gik ma kamago.","poem":1},{"text":"To en angʼo ma ibiro timo e ndalo mogik?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/JER/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/JER/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/JER/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}