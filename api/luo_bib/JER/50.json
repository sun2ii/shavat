{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"JER","translationId":"luo_bib","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"5e628c4a5a87a9982766f9f50fa250729e7095726dc3567fc2089870cfd1e587","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/luo_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":50,"content":[{"type":"heading","content":["Wach Babulon"]},{"type":"verse","number":1,"content":["Ma e wach mane Jehova Nyasaye owacho kuom Babulon kod piny jo-Babulon kokalo kuom Jeremia janabi:"]},{"type":"verse","number":2,"content":[{"text":"“Nyisuru kendo landuru e dier ogendini,","poem":1},{"text":"tingʼuru bandera kendo landuru;","poem":2},{"lineBreak":true},{"text":"kik upand gimoro, to wachni,","poem":2},{"text":"‘Babulon nomaki;","poem":1},{"text":"Bel wiye nokuodi,","poem":2},{"lineBreak":true},{"text":"Marduk luoro nogo ngoga.","poem":2},{"text":"Gige mopa nokuod wigi","poem":1},{"text":"kendo nyisechegi manono nopongʼ gi luoro.’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Piny moa yo nyandwat nomonje","poem":1},{"text":"kendo pinye nodongʼ gunda.","poem":2},{"text":"Onge ngʼama nodag e iye;","poem":1},{"text":"ji kaachiel gi le noringi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“E ndalogo, sa nogono,","poem":2},{"text":"jo-Israel gi jo-Juda nodhi kaachiel","poem":1},{"text":"ka pi wangʼ-gi chwer,","poem":2},{"lineBreak":true},{"text":"ka gidwaro Jehova Nyasaye ma Nyasachgi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ginipenj yo madhi Sayun","poem":1},{"text":"kendo gilok wengegi kochiko kuno.","poem":2},{"text":"Ginibi kendo ginitwere kuom","poem":1},{"text":"Jehova Nyasaye e singruok mochwere,","poem":2},{"lineBreak":true},{"text":"ma wich ok nowil godo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Joga osebedo rombe molal;","poem":1},{"text":"jokwathgi osewitogi,","poem":2},{"text":"kendo osemiyogi bayo e gode madongo.","poem":1},{"text":"Negibayo e gode madongo gi gode matindo,","poem":2},{"lineBreak":true},{"text":"kendo wigi ne owil gi kargi mar yweyo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngʼato angʼata mane oyudogi nokidhogi;","poem":1},{"text":"wasikgi nowacho niya,","poem":2},{"text":"‘Ok wan joketho,","poem":1},{"text":"nimar negitimo richo ni Jehova Nyasaye,","poem":2},{"text":"kar kwadhgi madiera,","poem":1},{"text":"Jehova Nyasaye, geno mar wuonegi.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ringuru uwuog Babulon;","poem":1},{"text":"ayeuru e piny jo-Babulon,","poem":2},{"lineBreak":true},{"text":"kendo uchal gi diek motelone jamni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anami ogendini maroteke","poem":1},{"text":"moriwore moa yo nyandwat obi omonj Babulon.","poem":2},{"text":"Ginikaw keregi mondo gimonje,","poem":1},{"text":"kendo koa yo nyandwat enomake.","poem":2},{"text":"Aserni mag-gi nochal gi jolweny molony,","poem":1},{"text":"ma ok duogi gi lwetgi nono.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“Omiyo Babulon noyaki;","poem":2},{"lineBreak":true},{"text":"jogo moyake nokaw gik moromogi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Nikech un gi ilo kendo umor,","poem":1},{"text":"un joma ketho girkeni maga,","poem":2},{"text":"nikech uchwe ka nyaroya machamo lum","poem":1},{"text":"kendo ugiro ka farese,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"minu wiye nokuodi malich;","poem":1},{"text":"ngʼatno mane onywolou nobed gi wichkuot maduongʼ.","poem":2},{"text":"En ema nobedie ngʼat matin kuom ogendini,","poem":1},{"text":"nochal thim, piny motimo ongoro, kama otwo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nikech ich wangʼ mar Jehova Nyasaye,","poem":1},{"text":"ok nobed gi joma odak e iye,","poem":2},{"text":"to enobed gunda chuth.","poem":1},{"text":"Jogo duto makalo Babulon,","poem":2},{"text":"nobed gi bwok maduongʼ","poem":1},{"text":"kendo nyiere nikech adhondene duto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Kawuru kereu e alwora mar Babulon,","poem":1},{"text":"un duto maywayo atungʼ.","poem":2},{"text":"Bayeuru gi asere! Kik uwe asere moro amora,","poem":1},{"text":"nimar osetimo richo ne Jehova Nyasaye.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Gone koko kuonde duto!","poem":1},{"text":"Otingʼo bade kanyiso ni oloye,","poem":2},{"text":"kuondene mag ngʼicho motingʼore gi malo podho,","poem":1},{"text":"ohinga mage imuko.","poem":2},{"text":"Nikech ma e chulo kuor mar Jehova Nyasaye,","poem":1},{"text":"chulneuru kuor;","poem":2},{"lineBreak":true},{"text":"timneuru kaka osetimo ni joma moko.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Gol jachwoyo oko e Babulon,","poem":1},{"text":"kod jakeyo gi pande mar keyo.","poem":2},{"text":"Nikech ligangla mar ngʼama thiro ji","poem":1},{"text":"we ngʼato ka ngʼato odog ir joge,","poem":2},{"text":"we ngʼato ka ngʼato","poem":1},{"text":"oringi odhi e pinye owuon.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Israel chalo gi rombe mokee","poem":1},{"text":"ma sibuor oseriembo.","poem":2},{"lineBreak":true},{"text":"Mano mane okwongo kidhe ne en ruodh Asuria;","poem":2},{"text":"mano mogik mane oturo chokege","poem":1},{"text":"ne en Nebukadneza ruodh Babulon.”","poem":2}]},{"type":"verse","number":18,"content":["Emomiyo ma e gima Jehova Nyasaye Maratego, ma Nyasach Israel, wacho:",{"text":"“Anakum ruodh Babulon gi pinye","poem":1},{"text":"kaka ne akumo ruodh Asuria.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"To anaduog Israel e kare","poem":1},{"text":"mar kwath kendo enokwa e Karmel kod Bashan;","poem":2},{"lineBreak":true},{"text":"noyiengʼ e gode matindo mag Efraim gi Gilead.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“E ndalogo, e sechego,","poem":2},{"text":"nomany ketho Israel, to onge manoyudi,","poem":1},{"text":"kendo ne richo Juda, to onge manoyudi,","poem":2},{"lineBreak":true},{"text":"nimar anangʼwon-ne jogo mane odongʼ mane aweyo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“Monj piny Merathaim kod jogo modak Pekod.","poem":2},{"text":"Lawgi, neg-gi kendo utiekgi duto.","poem":1},{"text":"Timuru gimoro amora masechikou.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Koko mar lweny ni e piny,","poem":1},{"text":"koko mar kethruok maduongʼ!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mano kaka nyundo mar piny ngima otur","poem":1},{"text":"kendo obarore!","poem":2},{"lineBreak":true},{"text":"Mano kaka Babulon odongʼ,","poem":2},{"lineBreak":true},{"text":"gunda e dier pinje!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Achikonu obadho,","poem":1},{"text":"yaye Babulon, kendo nomaku kapod ok ungʼeyo;","poem":2},{"lineBreak":true},{"text":"noyudu kendo omaku nikech ne ukwedo Jehova Nyasaye.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Jehova Nyasaye oseyawo kare mar kano gige lweny,","poem":1},{"text":"kendo ogolo gige mag lweny mag mirimbe,","poem":2},{"text":"nimar Jehova Nyasaye Manyalo Gik Moko Duto kendo Maratego nigi tich monego ti","poem":1},{"text":"e piny jo-Babulon.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bi imonje gi kuma bor.","poem":1},{"text":"Yiech deche mage; choke ka pith mar cham.","poem":2},{"text":"Tieke chuth,","poem":1},{"text":"kendo kik obed gi ngʼato moro amora motony.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Neguru nyirwedhi mage duto;","poem":1},{"text":"we gidhi e kar yengʼo!","poem":2},{"text":"Mano kaka gininee malit!","poem":1},{"text":"Nimar odiechiengʼ osechopo,","poem":2},{"lineBreak":true},{"text":"kinde monego kumgi.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Winjuru jo-Israel maringo","poem":1},{"text":"kod matony koa Babulon,","poem":2},{"text":"mawacho e Sayun ni mano kaka","poem":1},{"text":"Jehova Nyasaye ma Nyasachwa osechulo kuor,","poem":2},{"lineBreak":true},{"text":"kuor nikech hekalu mare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Chikuru jo-aserni","poem":1},{"text":"mondo omonj Babulon,","poem":2},{"text":"jogo duto maywayo atungʼ.","poem":1},{"text":"Chokreuru bute; kik uwe ngʼato pondi.","poem":2},{"text":"Chuleuru nikech timbene;","poem":1},{"text":"timneuru kaka osetimo.","poem":2},{"text":"Nimar ok osewinjo Jehova Nyasaye,","poem":1},{"text":"Jal Maler mar Israel.”","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“Emomiyo, joge matindo nogore piny e yore;","poem":2},{"lineBreak":true},{"text":"jolweny mage duto nonegi odiechiengno.”","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ruoth, Jehova Nyasaye Maratego wacho niya,","poem":1},{"lineBreak":true},{"text":"“Ne, ok adwari, yaye janjore,","poem":1},{"text":"nimar odiechiengi osechopo,","poem":2},{"lineBreak":true},{"text":"kinde mari mar kum.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Janjore nochwanyre kendo podhi","poem":1},{"text":"kendo onge ngʼama nochunge malo;","poem":2},{"text":"anamok mach e dalane manowangʼ","poem":1},{"text":"jogo duto man machiegni kode.”","poem":2}]},{"type":"verse","number":33,"content":["Ma e gima Jehova Nyasaye Maratego wacho:",{"text":"“Jo-Israel ithiro,","poem":1},{"text":"kaachiel gi jo-Juda bende kamano.","poem":2},{"text":"Joma ne omakogi nomakogi matek,","poem":1},{"text":"ma ok nyal weyogi gidhi.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Kata kamano Jawar margi en ratego;","poem":1},{"text":"Jehova Nyasaye Maratego e nyinge.","poem":2},{"text":"Enokonygi gi nyalone duto","poem":1},{"text":"mondo omi gibed gi yweyo e pinygi;","poem":2},{"lineBreak":true},{"text":"to jo-Babulon nomi obed gi tungni.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“Ligangla notiek jo-Babulon!","poem":2},{"text":"Notiek jogo modak Babulon","poem":1},{"text":"kendo notiek jotende kod joge mariek!","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ligangla notiek jonabi mage","poem":1},{"text":"mag miriambo! Ginibed joma ofuwo.","poem":2},{"text":"Ligangla notiek jolweny mage!","poem":1},{"text":"Luoro maduongʼ nomakgi.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Ligangla notiek faresege","poem":1},{"text":"gi gechene kod welo duto mane ondiko e lweny!","poem":2},{"text":"Ginibed ka mon.","poem":1},{"lineBreak":true},{"text":"Ligangla notiek kuondegi mag","poem":1},{"text":"kano mwandu kendo nokwalgi!","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Pige mag aoregi nodwon matuo.","poem":1},{"text":"Nimar en piny mopongʼ gi nyiseche manono,","poem":2},{"lineBreak":true},{"text":"ma gin nyiseche mamiyo neko nomaku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“Omiyo gige thim kod ondiegi nodag kanyo,","poem":1},{"text":"kendo kanyo tula nodagie.","poem":2},{"text":"Onge gima nobedie kendo","poem":1},{"text":"onge ngʼama nochak odagie e tienge duto.”","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“Mana kaka Nyasaye noketho Sodom gi Gomora,","poem":2},{"text":"kaachiel gi mier mokiewo kodgi,","poem":1},{"text":"e kaka en bende nobedi maonge ngʼato angʼata,","poem":2},{"lineBreak":true},{"text":"modak kanyo kendo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“Neuru! Jolweny biro koa yo nyandwat;","poem":1},{"text":"oganda maduongʼ kod ruodhi mangʼeny itugo koa e tunge piny.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Gimanore gi atungʼ kod tongʼ;","poem":1},{"text":"giger kendo gionge ngʼwono.","poem":2},{"text":"Gimor ka nam mogingore","poem":1},{"text":"ka giriembo faresegi;","poem":2},{"text":"gibiro ka ji mochanore komanore","poem":1},{"text":"gi gige lweny mondo gimonju, yaye Nyar Babulon.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Ruodh Babulon osewinjo humbgi;","poem":1},{"text":"kendo bedene onge gi teko.","poem":2},{"text":"Rem malich osemake,","poem":1},{"text":"ka rem mar dhako mamuoch kayo.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Mana ka sibuor mabiro koa","poem":1},{"text":"e bungu moyugno mar Jordan,","poem":2},{"text":"nyaka kar kwath man-gi lum,","poem":1},{"text":"e kaka anariemb Babulon oa e pinye kadiemo wangʼ.","poem":2},{"text":"En ngʼa mowal manyalo yiero ne ma?","poem":1},{"text":"En ngʼa machalo koda kendo manyalo chungʼ koda?","poem":2},{"lineBreak":true},{"text":"Koso jakwath mane manyalo chungʼ koda?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"Emomiyo, winj gima Jehova Nyasaye osechano timo ne Babulon,","poem":1},{"text":"gima oseramo ni nyaka otimne piny jo-Babulon:","poem":2},{"text":"Nyithi rombe bende nokaw;","poem":1},{"text":"enoketh chuth kuondegi mag kwath nikech gin.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"E kinde ma Babulon nomaki piny noyiengni;","poem":1},{"text":"ywakne nowinjre e dier pinje.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/JER/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/JER/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/JER/49.json","previousChapterAudioLinks":{},"numberOfVerses":46}