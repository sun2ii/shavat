{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"JER","translationId":"luo_bib","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"5e628c4a5a87a9982766f9f50fa250729e7095726dc3567fc2089870cfd1e587","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/luo_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":["Ma e gima Jehova Nyasaye wacho:",{"text":"“Ne, anakel chunje maketho","poem":1},{"text":"Kuom Babulon gi jo-Leb Kamai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Anaor ji moa e pinje mamoko Babulon","poem":1},{"text":"mondo odhi opiedhe ka miudhwe kendo mondo oketh pinye;","poem":2},{"text":"ginikwede e yo mora amora e odiechienge","poem":1},{"text":"mar masira.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kik jadir asere rid atungʼ mare,","poem":1},{"text":"kata kik orwak okumba mare.","poem":2},{"text":"Kik ingʼwon-ne joge matindo;","poem":1},{"text":"tiek jolweny mage duto.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ginineg-gi Babulon,","poem":1},{"text":"kendo hinye ahinya e yorene.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nimar Israel gi Juda pod","poem":1},{"text":"ok ojwangʼgi Nyasachgi, Jehova Nyasaye Maratego,","poem":2},{"text":"kata obedo ni pinygi opongʼ","poem":1},{"text":"gi ketho e nyim Jalno Maler mar Israel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Ringuru ua Babulon!","poem":1},{"text":"Ringuru ukony ngimau!","poem":2},{"text":"Kik tieku nikech richo mag-gi.","poem":1},{"text":"En kinde ma Jehova Nyasaye chuloe kuor;","poem":2},{"lineBreak":true},{"text":"enochule gima owinjore kode.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Babulon ne en kikombe mar dhahabu","poem":1},{"text":"e lwet Jehova Nyasaye; nomiyo piny duto omer.","poem":2},{"text":"Ogendini nomadho divai mare;","poem":1},{"text":"emomiyo koro neko osemakogi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Babulon nolwar apoya nono","poem":1},{"text":"kendo notieke. Deng nikech en!","poem":2},{"text":"Miye yath ne rem mare;","poem":1},{"text":"sa moro onyalo chango.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ ‘Ne wanyalo thiedho Babulon,","poem":1},{"text":"to ok onyal chango;","poem":2},{"text":"waweyeuru, kendo ngʼato ka ngʼato odhi e pinye owuon,","poem":1},{"text":"nimar osengʼadne bura mochopo e polo,","poem":2},{"lineBreak":true},{"text":"ogingore mochopo e polo.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Jehova Nyasaye oseketowa joma kare;","poem":1},{"text":"biuru, we wawache ei Sayun,","poem":2},{"lineBreak":true},{"text":"gima Jehova Nyasaye, ma Nyasachwa osetimo.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Piaguru aserni, kauru okumbini!","poem":1},{"text":"Jehova Nyasaye osethuwo ruodhi mag Media kodgi,","poem":2},{"text":"nikech chenro mare en ketho Babulon.","poem":1},{"text":"Jehova Nyasaye nochul kuor ni hekalu mare.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tingʼuru banderane e ohinga mag Babulon!","poem":1},{"text":"Med jolweny mamoko kijiwogi,","poem":2},{"text":"ket jorito keregi, ikreuru mar monjogi!","poem":1},{"text":"Jehova Nyasaye nodhi nyime gi chenro mare,","poem":2},{"lineBreak":true},{"text":"buche moketo mondo otimre ni jo-Babulon.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Un joma odak machiegni gi pige mangʼeny","poem":1},{"text":"kendo momewo gi mwandu mangʼeny,","poem":2},{"lineBreak":true},{"text":"gikou osechopo, sa ma itiekoue.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jehova Nyasaye Maratego","poem":1},{"text":"osekwongʼore gi nyinge owuon:","poem":2},{"text":"Adier anakelnu ji mangʼeny, ka bonyo,","poem":1},{"text":"kendo ginikog gi ilo nikech loch molowugo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Nochweyo piny gi tekone;","poem":1},{"text":"ne ochako piny gi riekone,","poem":2},{"lineBreak":true},{"text":"kendo oyaro polo gi ngʼeyo mare.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ka omor ka polo, to pige manie polo wuo;","poem":1},{"text":"omiyo boche polo dhwolore koa e giko piny.","poem":2},{"text":"Ooro mil polo gi koth,","poem":1},{"text":"kendo okelo yamo koa e kuondege mag keno.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Ji duto parogi ok ti kendo gionge ngʼeyo;","poem":1},{"text":"jotheth duto wigi kuot gi nyisechegi manono, ma githedho.","poem":2},{"text":"Kido mage moloso gin gik manono;","poem":1},{"text":"gionge muya eigi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Gionge tich, gin gik minyiero;","poem":1},{"text":"ka ndalogi mar ngʼado bura ochopo, to ginilal nono.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Jalno ma en Pok mar Jakobo","poem":1},{"text":"ok chal kodgi,","poem":2},{"text":"nimar en e Jachwech mar gik moko duto,","poem":1},{"text":"kaachiel gi dhood girkeni mare,","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye Maratego e nyinge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“In e odungana mar lweny,","poem":1},{"text":"gira mar kedo, in ema atiekogo ogendini,","poem":2},{"lineBreak":true},{"text":"in ema akethogo pinjeruodhi,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"akonyora kodi kuom tieko faras gi jaithne,","poem":1},{"text":"in ema atiekogo gach lweny kod jariembe,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"in ema anegogo dichwo gi dhako,","poem":1},{"text":"in ema anegogo jaduongʼ kod rawere,","poem":2},{"lineBreak":true},{"text":"in ema anegogo wuowi kod nyako,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"in ema anegogo jakwath gi rombe,","poem":1},{"text":"in ema anegogo japur gi rwedhi,","poem":2},{"lineBreak":true},{"text":"in ema anegogo ruodhi gi jotelo.”","poem":2}]},{"type":"verse","number":24,"content":["Jehova Nyasaye wacho niya, “E nyim wangʼu anachul Babulon kod jogo duto modak Babulon kuom gigo maricho magisetimo e Sayun.”"]},{"type":"verse","number":25,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“Ok adwari, yaye got maduongʼ maketho,","poem":2},{"lineBreak":true},{"text":"un joma ketho piny ngima.","poem":2},{"text":"Anarie bada kuomu,","poem":1},{"lineBreak":true},{"text":"anadhiru piny kua e geng got,","poem":1},{"text":"kendo ami ubed ka got mowangʼ.”","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“Onge lwanda mane kaw kuomi mar gero kona,","poem":2},{"text":"kata kidi moro amora mar keto mise,","poem":1},{"text":"nimar unudongʼ gunda nyaka chiengʼ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Tingʼuru bandera e piny!","poem":1},{"text":"Gouru turumbete e dier ogendini!","poem":2},{"lineBreak":true},{"text":"Ikuru ogendini mondo oked kode;","poem":2},{"text":"luonguru pinjeruodhigi Ararat,","poem":1},{"text":"Mini kod Ashkenaz mondo oked kode.","poem":2},{"text":"Yieruru jatend lweny mondo oked kode;","poem":1},{"text":"oruru farese mangʼeny ka bonyo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ikuru ogendini","poem":1},{"text":"mondo oked kod ruodhi mag Medes,","poem":2},{"text":"jotendgi kod jodong-gi duto,","poem":1},{"text":"kaachiel gi pinje duto ma gitelonegi.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Piny tetni kendo nigi rem mapek,","poem":1},{"lineBreak":true},{"text":"nimar chenro mar Jehova Nyasaye","poem":1},{"text":"kuom Babulon osiko mondo piny Babulon odongʼ gunda,","poem":2},{"lineBreak":true},{"text":"maonge ngʼama nodag kanyo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Jolwenj Babulon oseweyo kedo;","poem":1},{"text":"gidongʼ e kuondegi mochiel motegno mag lweny.","poem":2},{"text":"Tekogi orumo; gisebedo ka mon.","poem":1},{"text":"Kuondegi mag dak osemoke mach;","poem":2},{"lineBreak":true},{"text":"lodi mage mag rangeye otur.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Jangʼwech achiel luwo bangʼ","poem":1},{"text":"machielo kendo jaote luwo bangʼ jaote machielo,","poem":2},{"text":"mondo olandne ruodh Babulon","poem":1},{"text":"ni dalane maduongʼ mangima osemaki,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"kuonde mikalogo aora osemuki,","poem":1},{"text":"odundu wangʼ,","poem":2},{"lineBreak":true},{"text":"kendo jolweny luoro omako.”","poem":2}]},{"type":"verse","number":33,"content":["Ma e gima Jehova Nyasaye Maratego, ma Nyasach Israel, wacho:",{"text":"“Nyar Babulon chalo gi kar","poem":1},{"text":"dino e seche minyone;","poem":2},{"lineBreak":true},{"text":"kinde ma ikaye chiegni chopo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Nebukadneza ruodh Babulon osetiekowa,","poem":1},{"text":"oserundo pachwa,","poem":2},{"lineBreak":true},{"text":"oselokowa agulu ma iye ninono.","poem":2},{"text":"Ka thuol osemuonyowa","poem":1},{"text":"kendo osepongʼo iye gi chiembwa,","poem":2},{"lineBreak":true},{"text":"mi osengʼudhowa oko.”","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Joma odak Sayun wacho niya,","poem":1},{"text":"“Mad masira ma gisekelonwa bed kuom Babulon.”","poem":2},{"text":"Jerusalem wacho niya,","poem":1},{"text":"“Mad rembwa bed ewi joma odak Babulon.”","poem":2}]},{"type":"verse","number":36,"content":["Emomiyo, ma e gima Jehova Nyasaye wacho:",{"text":"“Ne, anabed jakori kendo anakonyi e bura;","poem":1},{"text":"anami nembe two kendo thidhna mage notwo.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Babulon nobed pith mar kethruok,","poem":1},{"text":"kar dak ondiegi, gima bwogo ji,","poem":2},{"text":"kendo gima inyiero,","poem":1},{"text":"kama onge ngʼama odakie.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Joge duto ruto ka sibuoche matindo,","poem":1},{"text":"gilengʼore ka nyithi sibuor.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"To ka ochiewgi,","poem":1},{"text":"analosnigi nyasi mi gimer,","poem":2},{"text":"mondo gikog gi mor;","poem":1},{"text":"eka ginindi nyaka chiengʼ ma ok ginichiew,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye wacho.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"“Anatiekgi ka rombe mitero kar yengʼo,","poem":1},{"text":"ka imbe kod diek.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“Mano kaka Sheshak nomaki,","poem":1},{"text":"sunga mar piny ngima norum!","poem":2},{"text":"Mano kaka Babulon nobedi","poem":1},{"text":"gima lich makelo bwok e kind ogendini!","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Nam nogingre kuom Babulon;","poem":1},{"text":"apakane mawuo noume.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Miech jo-Babulon nodongʼ gunda,","poem":1},{"text":"kama otwo kendo piny motimo ongoro,","poem":2},{"text":"piny maonge ngʼama odakie,","poem":1},{"text":"kama onge ngʼama kalo e iye.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Anakum Bel e Babulon","poem":1},{"text":"kendo anami ongʼog gima ne osemuonyo.","poem":2},{"text":"Ogendini ok nochak ochokre ire.","poem":1},{"text":"Kendo ohinga mar Babulon nogore piny.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“Wuoguru oko uayi kuome, joga!","poem":1},{"text":"Ringuru ukony ngimau!","poem":2},{"lineBreak":true},{"text":"Ringuru uaye mirima mager mar Jehova Nyasaye.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Kik chunyu jogi kata bedo maluor","poem":1},{"text":"ka wach mofwongʼ owinjore e piny;","poem":2},{"text":"wach mofwongʼ achiel biro higani,","poem":1},{"text":"machielo noluwe,","poem":2},{"text":"wach mofwongʼ mar masira e piny,","poem":1},{"text":"kendo mar jatelo ma ok dwar,","poem":2},{"lineBreak":true},{"text":"jatelo machielo.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Nimar adiera kinde biro ma anakum","poem":1},{"text":"nyiseche manono mag Babulon;","poem":2},{"text":"pinye duto nobed gi wichkuot","poem":1},{"text":"kendo joge duto mosenegi nolware iye.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Eka polo gi piny kod gik moko duto manie igi","poem":1},{"text":"nokog gi ilo nikech Babulon,","poem":2},{"text":"nimar koa nyandwat","poem":1},{"text":"jonek nomonje,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye wacho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"“Babulon nyaka podhi","poem":1},{"text":"nikech jo-Israel mane onegi,","poem":2},{"text":"mana kaka ji duto,","poem":1},{"text":"mosenegi e piny osepodho nikech Babulon.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Un joma osetonyne ligangla,","poem":1},{"text":"auru kendo kik ugalru!","poem":2},{"text":"Paruru Jehova Nyasaye e piny mabor,","poem":1},{"text":"kendo upar Jerusalem.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"“Ochawa, nimar oseyanywa","poem":1},{"text":"kendo wichkuot oumo wengewa,","poem":2},{"text":"nikech joma oa e pinje mamoko","poem":1},{"text":"osedonjo e kuonde maler mar od Jehova Nyasaye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“To kinde biro,","poem":2},{"lineBreak":true},{"text":"ma anakume nyisechege manono,","poem":2},{"text":"kendo e pinye mangima","poem":1},{"text":"joma nigi adhonde nobed gi rem malit.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Kata ka Babulon ochopo e lwasi","poem":1},{"lineBreak":true},{"text":"kendo ger ohingage motegno kuno,","poem":1},{"text":"to anaor ji mondo okethe,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye wacho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"“Ywak winjore koa Babulon,","poem":1},{"text":"koko mar kethruok maduongʼ,","poem":2},{"lineBreak":true},{"text":"koa e piny jo-Babulon.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Jehova Nyasaye noketh Babulon;","poem":1},{"text":"nomi koko olingʼ thi.","poem":2},{"text":"Apaka mag wasigu nowuo ka pige mopongʼ;","poem":1},{"text":"koko mar dwondgi nowinjre kendo.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Jaketh nobi ketho Babulon;","poem":1},{"text":"jolweny mage nomaki,","poem":2},{"lineBreak":true},{"text":"kendo atungʼ mag-gi notur.","poem":2},{"text":"Nimar Jehova Nyasaye en Nyasaye","poem":1},{"text":"machulo kuor ni ji kuom richogi;","poem":2},{"lineBreak":true},{"text":"enochul duto.”","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Ruoth, ma nyinge en Jehova Nyasaye Maratego wacho niya,","poem":1},{"text":"“Anami jodonge kod jogo mariek mer,","poem":2},{"text":"jotendgi, jodong-gi kod jolweny bende;","poem":1},{"text":"gininindi nyaka chiengʼ kendo ok ginichiew.”","poem":2}]},{"type":"verse","number":58,"content":["Ma e gima Jehova Nyasaye Maratego wacho:",{"text":"“Ohinga mar Babulon mangʼongo nolwar piny","poem":1},{"text":"kendo dhorangeye mage maboyo nomoke mach;","poem":2},{"text":"ji chandore kayiem nono,","poem":1},{"text":"tich matek mar jotich en mana ramoki mach.”","poem":2}]},{"type":"verse","number":59,"content":["Ma e ote mane Jeremia janabi omiyo jatend jotije Seraya wuod Neria, ma wuod Maseya, kane odhi Babulon gi Zedekia ruodh Juda e higa mar angʼwen mar lochne."]},{"type":"verse","number":60,"content":["Jeremia nondiko e kitabu kuom masiche duto mano bi kuom Babulon, mago duto mane osendiki kuom Babulon."]},{"type":"verse","number":61,"content":["Nowachone Seraya, “Ka ichopo Babulon, ne ni isomo wechegi mondo owinji."]},{"type":"verse","number":62,"content":["Eka iwachi ni, yaye Jehova Nyasaye, isewacho ni ibiro ketho kae, mondo omi dhano kata le kik dag e iye; enodongʼ gunda nyaka chiengʼ."]},{"type":"verse","number":63,"content":["Ka itieko somo kitabuni, twe kidi kuome kendo idire Yufrate."]},{"type":"verse","number":64,"content":["Eka iwachi ni, ‘E kaka Babulon nonim ma ok nochak ochungʼ kendo nikech masira ma anakel kuome. Kendo joge nopodhi.’ ” Weche Jeremia ogik kae."]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}