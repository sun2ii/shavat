{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"JER","translationId":"luo_bib","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"5e628c4a5a87a9982766f9f50fa250729e7095726dc3567fc2089870cfd1e587","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/luo_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":6,"content":[{"type":"heading","content":["Omonj Jerusalem"]},{"type":"verse","number":1,"content":[{"text":"“Un jo-Benjamin, ringuru utony!","poem":1},{"text":"Ringuru ua Jerusalem!","poem":2},{"text":"Gouru turumbete Tekoa!","poem":1},{"text":"Keturu ranyisi ewi Beth Hakerem!","poem":2},{"text":"Nimar masira aa yo nyandwat,","poem":1},{"text":"kod kethruok malich.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Anatiek nyar Sayun,","poem":1},{"text":"ma ber neno kendo ma dende yom.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jokwath kod jambgi noked kode;","poem":1},{"text":"ginigur hembegi molwore,","poem":2},{"lineBreak":true},{"text":"ka moro ka moro rito kare owuon.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ikri mar kedo kode!","poem":1},{"text":"Wuoguru, wadhi wamonjgi e dier odiechiengʼ!","poem":2},{"text":"To mano kaka ler mar odiechiengʼ bedo ma dimdim,","poem":1},{"text":"kendo tipo mag odhiambo yware.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Omiyo aa malo, wamonjgi gotieno","poem":1},{"text":"kendo waketh ohingane motegno!”","poem":2}]},{"type":"verse","number":6,"content":["Ma e gima Jehova Nyasaye Maratego wacho:",{"text":"“Ngʼad yiende kendo iger pidhe","poem":1},{"text":"mondo wamonj Jerusalem.","poem":2},{"text":"Dala maduongʼni nyaka kum;","poem":1},{"text":"nikech opongʼ gi joma hinyo jowadgi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kaka soko olo pige oko,","poem":1},{"text":"e kaka en bende oolo timbene mamono.","poem":2},{"text":"Lweny kod kethruok mor e iye;","poem":1},{"text":"tuone kod adhondene osiko e nyima.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Winj siem, yaye Jerusalem,","poem":1},{"text":"ka ok kamano to abiro weyi,","poem":2},{"text":"mi awe pinyi nono,","poem":1},{"text":"ma ngʼato angʼata ok nyal dak e iye.”","poem":2}]},{"type":"verse","number":9,"content":["Ma e gima Jehova Nyasaye Maratego wacho:",{"text":"“Mad gidwog jo-Israel modongʼ","poem":1},{"text":"kaka jochok olemb mzabibu;","poem":2},{"text":"ngʼauru bedeu e bede yath,","poem":1},{"text":"mana kaka ngʼama pono olemo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"En ngʼa ma anyalo wuoyogo","poem":1},{"text":"kendo miyo siemni?","poem":2},{"lineBreak":true},{"text":"En ngʼa manyalo winja?","poem":2},{"text":"Itgi odino omiyo ok ginyal winjo wach.","poem":1},{"text":"Wach Jehova Nyasaye chwanyogi;","poem":2},{"lineBreak":true},{"text":"ok gine gima ber kuome.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"To apongʼ gi mirima mar Jehova Nyasaye,","poem":1},{"text":"kendo ok anyal lingʼ kode.","poem":2},{"lineBreak":true},{"text":"“Ole oko kuom nyithindo manie yore,","poem":2},{"text":"kendo kuom yawuowi mochokore kanyakla;","poem":1},{"text":"dichwo kaachiel gi dhako gini nomaki,","poem":2},{"lineBreak":true},{"text":"kod joma oti, jogo mahikgi oniangʼ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Utegi ibiro miyo joma moko,","poem":1},{"lineBreak":true},{"text":"kaachiel gi puothegi kod mondegi,","poem":1},{"text":"ka arieyo lweta kuom jogo modak e piny,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye owacho.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Chakre ngʼama tin nyaka ngʼama duongʼ,","poem":1},{"text":"giduto girikni ka gidwaro mwandu e yor miganga;","poem":2},{"text":"jonabi kod jodolo chalre,","poem":1},{"text":"giduto gin jo-miriambo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Githiedho adhonde mag joga mana","poem":1},{"text":"ka gima ok en gima lich.","poem":2},{"lineBreak":true},{"text":"Giwacho niya, ‘Kwe, kwe,’ kata mana ka kwe onge.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bende gin-gi wichkuot kuom timbegi makwero?","poem":1},{"text":"Ooyo, gionge wichkuot kata mana matin;","poem":2},{"lineBreak":true},{"text":"ok gingʼeyo kata kaka ginyalo wuondore.","poem":2},{"text":"Omiyo gibiro podho mana kaka joma moko mopodho;","poem":1},{"text":"kendo ibiro dwokgi piny kakumogi,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye owacho.","poem":2}]},{"type":"verse","number":16,"content":["Ma e gima Jehova Nyasaye wacho:",{"text":"“Chunguru e akek yore","poem":1},{"text":"kendo urang wangʼ yore machon;","poem":2},{"text":"penjuru kuma yo maber nitie,","poem":1},{"text":"mondo uwuothie, kendo unuyud yweyo e chunyu.","poem":2},{"lineBreak":true},{"text":"To ne uwacho ni, ‘Ok wanaluwe.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ne aketonu jorito kendo awacho,","poem":1},{"text":"‘Chikuru itu ne turumbete!’","poem":2},{"lineBreak":true},{"text":"To ne uwacho, ‘Ok wanachik itwa.’","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Omiyo winjuru, yaye un ogendini;","poem":1},{"text":"ranguru malongʼo, yaye un joneno,","poem":2},{"lineBreak":true},{"text":"gima biro timore negi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Winji, yaye piny:","poem":1},{"text":"Akelo masira ne jogi,","poem":2},{"text":"ma en olemo mar pachgi maricho,","poem":1},{"text":"nikech gitamore winjo wechena,","poem":2},{"lineBreak":true},{"text":"kendo gisedagi chikna.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ere tiend ubani mangʼwe ngʼar moa kuom Sheba","poem":1},{"text":"kata niangʼ ma milimili moa e piny mabor?","poem":2},{"text":"Chiwo magu mag misengini miwangʼo pep ok ayiego;","poem":1},{"text":"misango magu ok mora.”","poem":2}]},{"type":"verse","number":21,"content":["Emomiyo ma e gima Jehova Nyasaye wacho:",{"text":"“Anaket rachwany e nyim jogi.","poem":1},{"text":"Wuone kod yawuowi nochwanyre kuomgi;","poem":2},{"lineBreak":true},{"text":"jogo modak mokiewo kodgi kod osiepe nolal nono.”","poem":2}]},{"type":"verse","number":22,"content":["Ma e gima Jehova Nyasaye wacho:",{"text":"“Neuru, jolweny biro koa","poem":1},{"text":"e piny man yo nyandwat;","poem":2},{"text":"oganda maduongʼ itugo","poem":1},{"text":"koa e tunge piny.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Gimanore gi atungʼ kod tongʼ;","poem":1},{"text":"giger kendo gionge ngʼwono.","poem":2},{"lineBreak":true},{"text":"Gimor ka nam mogingore ka giriembo faresegi;","poem":2},{"text":"gibiro ka ji mochanore komanore gi gige","poem":1},{"text":"lweny mondo gimonju, yaye Nyar Sayun.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Wasewinjo humbgi,","poem":1},{"text":"kendo bedewa onge gi teko.","poem":2},{"text":"Rem malich osemakowa,","poem":1},{"text":"ka rem mar dhako mamuoch kayo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kik udhi e puothe kata uwuothie yore,","poem":1},{"text":"nimar jasigu nigi ligangla,","poem":2},{"text":"kendo nitie luoro kamoro amora.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Yaye joga, rwakuru lepu mag ywak","poem":1},{"text":"kendo ngʼielreuru e buru;","poem":2},{"lineBreak":true},{"text":"gouru nduru ka udengo malit mana ka ngʼama ywago wuode achiel kende,","poem":2},{"text":"nimar apoya nono jaketh gik","poem":1},{"text":"moko biro podho kuomwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Aseketi rapim mipimogo chumbe","poem":1},{"text":"to joga kama ikunye chumbe,","poem":2},{"lineBreak":true},{"text":"mondo mi ingʼi kendo ipim yoregi.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Giduto gin jongʼanyo ma tokgi tek ta,","poem":1},{"text":"ka gidhi ka gi kacha mar kuotho.","poem":2},{"lineBreak":true},{"text":"Gin nyinyo kod chuma; giduto gin jomecho.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kata obedo ni jotheth","poem":1},{"text":"moko mach matek mondo oleny fedha,","poem":2},{"text":"kendo opwodhi, to mano en mana kayiem nono;","poem":1},{"lineBreak":true},{"text":"kamano bende joma","poem":1},{"text":"richo ok nyal pwodhore.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Iluongogi ni fedha mojwangʼ,","poem":1},{"text":"nikech Jehova Nyasaye osejwangʼogi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}