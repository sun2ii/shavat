{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"JER","translationId":"luo_bib","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"5e628c4a5a87a9982766f9f50fa250729e7095726dc3567fc2089870cfd1e587","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/luo_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["“ ‘Jehova Nyasaye wacho ni e kindego, choke mag ruodhi kod jotelo mag Juda, choke mag jodolo kod jonabi, kendo choke mag jo-Jerusalem nogol oko e liete mag-gi."]},{"type":"verse","number":2,"content":["Chokego noyar oko e nyim chiengʼ gi dwe kod sulwe duto manie polo mane gihero kendo tiyonegi ma bende negiluwo bangʼ-gi ka gipenjo rieko kendo lamogi. Ok nochokgi kata ikgi, to ginichal ka owuoyo manie lowo."]},{"type":"verse","number":3,"content":["Kamoro amora ma ariembogi ka aterogie, to jogo duto motony mar oganda marachni noher tho kar ngima, Jehova Nyasaye Maratego owacho kamano.’"]},{"type":"heading","content":["Richo gi kum"]},{"type":"verse","number":4,"content":["“Wachnegi ni, ‘Ma e gima Jehova Nyasaye wacho:",{"text":"“ ‘Ka ji opodho mogore piny donge gia malo?","poem":1},{"text":"Ka ngʼato oa, donge odwogo?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Marangʼo jogi ongʼanyo oa?","poem":1},{"text":"Angʼo momiyo Jerusalem siko ringo?","poem":2},{"lineBreak":true},{"text":"Gimoko kuom miriambo; gitamore duogo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Asechiko ita malongʼo,","poem":1},{"text":"to ok giwach gima adier.","poem":2},{"text":"Onge ngʼama lokore weyo kuom timbegi mamono,","poem":1},{"text":"kopenjo niya, “En angʼo ma asetimo?”","poem":2},{"lineBreak":true},{"text":"Moro ka moro luwo yore owuon ka faras madhi e lweny.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kata mana nyamnaha manie","poem":1},{"text":"kor polo ongʼeyo kindene moketne,","poem":2},{"text":"kendo akuch odugla, opija gi ongo-wangʼ","poem":1},{"text":"bende ongʼeyo ndalo mar dargi.","poem":2},{"lineBreak":true},{"text":"To joga ok ongʼeyo dwach Jehova Nyasaye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ ‘Ere kaka inyalo wacho niya, “Wariek,","poem":1},{"text":"nimar wan gi chik mar Jehova Nyasaye,”","poem":2},{"text":"ka gadiera kalamb miriambo","poem":1},{"text":"mar jondiko osetiyo kode e yor miriambo?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jomariek nokuod wigi;","poem":1},{"text":"ginibed gi luoro mangʼeny kendo enomakgi.","poem":2},{"text":"Nimar gisedagi wach Jehova Nyasaye,","poem":1},{"text":"en rieko manade ma gin godo?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Emomiyo anachiw mondegi","poem":1},{"text":"ne joma moko kendo puothegi ne jomanyien.","poem":2},{"text":"Kochakore kuom ngʼat matin nyaka ngʼat maduongʼ,","poem":1},{"text":"giduto giwuor ne yudo ohala;","poem":2},{"text":"jonabi gi jodolo machalre,","poem":1},{"text":"giduto gitimo timbe wuondruok.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Githiedho adhonde mag","poem":1},{"text":"joga mana ka gima ok en gima lich.","poem":2},{"text":"Giwacho niya, “Kwe, kwe,”","poem":1},{"text":"kata kwe onge.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Donge wigi kuot gi timbegi mamono?","poem":1},{"text":"Ooyo, gionge wichkuot kata matin;","poem":2},{"lineBreak":true},{"text":"bende gionge leny kata wichkuot.","poem":2},{"text":"Omiyo ginipodhi e dier joma opodho;","poem":1},{"text":"enolwargi piny ka ikumogi,","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye owacho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ ‘Anakaw nyak mag-gi.","poem":1},{"text":"Onge olemo manobedi e mzabibu.","poem":2},{"text":"Onge olemb ngʼowu manobedi ewi yath,","poem":1},{"text":"kendo itgi noner.","poem":2},{"text":"Gima asemiyogi nomagi.’ ”","poem":1},{"text":"An Jehova Nyasaye ema asewacho kamano.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Angʼo momiyo wabet ka?","poem":1},{"text":"Chokreuru kaachiel!","poem":2},{"text":"Waringuru wadhi e mier madongo mochiel motegno gohinga","poem":1},{"text":"kendo watho kuno!","poem":2},{"text":"Nimar Jehova Nyasaye,","poem":1},{"text":"ma Nyasachwa osejwangʼowa mondo watho,","poem":2},{"text":"kendo osemiyowa pi moketie sum mondo wamodhi,","poem":1},{"text":"nikech wasetimo richo e nyime.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ne wageno kwe","poem":1},{"text":"to onge ber mosebiro,","poem":2},{"text":"bende ne wageno kinde mag chang,","poem":1},{"text":"to ne nitie mana thagruok.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Giro mar farese mag wasigu","poem":1},{"text":"iwinjo koa Dan;","poem":2},{"lineBreak":true},{"text":"kendo ywak farese mathuondi miyo piny tetni.","poem":2},{"text":"Gibiro tieko piny duto kod gik moko manie iye,","poem":1},{"text":"dala maduongʼ kod ji duto modak kanyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Ne, anaor thuol man-gi kwiri e dieru,","poem":1},{"text":"thuonde mager ma ok bo, kendo gini kau.”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye owacho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yaye Jahochna e lit,","poem":1},{"text":"chunya ool.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Winj ywak joga koa e piny man mabor:","poem":1},{"text":"“Donge Jehova Nyasaye ni Sayun?","poem":2},{"lineBreak":true},{"text":"Ruodhe bende pod ni kuno adier?”","poem":2},{"lineBreak":true},{"text":"“Angʼo momiyo gisemiya ich wangʼ gigigo ma giloso,","poem":1},{"text":"kod nyisechegi mag pinje mamoko?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Ndalo keyo kod ndalo oro osekalo,","poem":1},{"text":"to ok wakonyore.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Nimar joga osehiny, an bende ahinyora;","poem":1},{"text":"aywak kendo luoro omaka.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yath tinde orumo Gilead koso?","poem":1},{"text":"Jathieth tinde onge kanyo koso?","poem":2},{"text":"Kare ere gima omiyo adhond joga ok nyal chango?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}