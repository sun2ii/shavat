{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"JER","translationId":"luo_bib","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"5e628c4a5a87a9982766f9f50fa250729e7095726dc3567fc2089870cfd1e587","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/luo_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"Yaye, mad wiya bed ka soko mar pi","poem":1},{"text":"kendo pi wangʼa mol ka aora!","poem":2},{"text":"Dwaywak odiechiengʼ","poem":1},{"text":"kod otieno nikech nek mar joga.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yaye, mad ne abed gi","poem":1},{"text":"kar nindo michulo ne jowuoth e piny ongoro,","poem":2},{"text":"mondo omi awe joga","poem":1},{"text":"kendo adhi mabor kodgi;","poem":2},{"text":"nimar giduto gin jochode,","poem":1},{"text":"kanyakla mar joma onge adiera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Giketo lewgi moikore ka atungʼ,","poem":1},{"text":"mondo gidirgo miriambo;","poem":2},{"text":"to dhigi maber e piny","poem":1},{"text":"ok nikech giwacho adiera.","poem":2},{"text":"Gitimo richo bangʼ moro ka moro;","poem":1},{"text":"ok gidewa.”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye ema owacho.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Beduru motangʼ gosiepeu;","poem":1},{"text":"kik uket genou kuom oweteu.","poem":2},{"text":"Nimar oweteu duto jo-miriambo,","poem":1},{"text":"kendo osiep moro amora jakwoth.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Osiep wuondo osiep,","poem":1},{"lineBreak":true},{"text":"kendo onge ngʼama wacho adiera.","poem":1},{"text":"Gisepuonjo lewgi wacho miriambo;","poem":2},{"text":"kendo gisedonjo matut e richo","poem":1},{"text":"ma ok ginyal wuokie.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Idak e kind jo-miriambo;","poem":1},{"text":"e wuondruokgino gisedagi yie kuoma.”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye ema owacho.","poem":2}]},{"type":"verse","number":7,"content":["Emomiyo ma e gima Jehova Nyasaye Maratego wacho:",{"text":"“Ne, abiro pwodhogi kendo temogi,","poem":1},{"text":"nimar en angʼo machielo manyalo timo,","poem":2},{"lineBreak":true},{"text":"nikech richo mar joga?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lewgi en asere man-gi kwiri;","poem":1},{"text":"owacho miriambo.","poem":2},{"text":"Gi dhoge owuoyo mamuol ne jabathe,","poem":1},{"text":"to e chunye oketone obadho.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“Donge dakumgi ne ma?","poem":2},{"text":"Donge dachul kuor","poem":1},{"text":"ne oganda ma kama?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Abiro ywak kendo dengo ne gode","poem":1},{"text":"bende anaywag lege motwo, mosedongʼ nono,","poem":2},{"lineBreak":true},{"text":"kendo onge gima wuothoe,","poem":2},{"text":"bende ywak mar jamni ok winjie.","poem":1},{"text":"Winy mafuyo e kor polo oseringo,","poem":2},{"lineBreak":true},{"text":"kendo le osedhi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Anami Jerusalem obed gunda,","poem":1},{"text":"kama ondiegi ema odakie;","poem":2},{"text":"kendo anaketh mier mag Juda","poem":1},{"text":"mondo ngʼato kik dag kanyo.”","poem":2}]},{"type":"verse","number":12,"content":["En ngʼa mariek manyalo winjo tiend ma? En ngʼa mosetiegi gi Jehova Nyasaye kendo nyalo lero tiende? Angʼo momiyo piny osekethi modongʼ nono ka kama otwo maonge ngʼama nyalo luwo?"]},{"type":"verse","number":13,"content":["Jehova Nyasaye nowacho niya, “Nikech gisejwangʼo chikna, mane amiyogi; omiyo ok giseluora kata luwo chikna."]},{"type":"verse","number":14,"content":["To giseluwo mana timbegi mag wich teko; bende giseluwo bangʼ Baal, mana kaka wuonegi nopuonjogi.”"]},{"type":"verse","number":15,"content":["Emomiyo, ma e gima Jehova Nyasaye Maratego ma Nyasach Israel, wacho: “Ne, anami jogi cham chiemo makech kendo modh pi sum."]},{"type":"verse","number":16,"content":["Anakegi e dier ogendini ma gin kata wuonegi ok ongʼeyo, kendo analawgi gi ligangla manyaka atiekgi.”"]},{"type":"verse","number":17,"content":["Ma e gima Jehova Nyasaye Maratego wacho:",{"text":"“Parane! Luonguru mon madengo mondo obi;","poem":1},{"text":"to moloyo mago man-gi lony mamalo e ywak.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Giret piyo","poem":1},{"text":"mondo gidengnwa,","poem":2},{"text":"nyaka wengewa pongʼ gi pi wangʼ","poem":1},{"text":"ma oo kendo pi wangʼwa mol ma luokwa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Koko mar dengo iwinjo koa Sayun:","poem":1},{"text":"‘Mano kaka otiekowa!","poem":2},{"text":"Mano kaka wichkuot marwa duongʼ!","poem":1},{"text":"Nyaka waa e pinywa nikech utewa osemuki.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Koro, yaye mon,","poem":1},{"text":"winjuru wach Jehova Nyasaye;","poem":2},{"text":"yawuru itu ne weche mawuok e dhoge.","poem":1},{"text":"Puonjuru nyiu dengo;","poem":2},{"lineBreak":true},{"text":"puonjreuru ywak uwegi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tho oseidho gie dirisni magwa","poem":1},{"text":"kendo osedonjo kuondewa mochiel motegno gohinga;","poem":2},{"text":"osengʼado nyithindo oko e yore","poem":1},{"text":"kendo rowere e kuonde budho mag galamoro.","poem":2}]},{"type":"verse","number":22,"content":["Wach niya, “Ma e gima Jehova Nyasaye owacho:",{"text":"“ ‘Ringre joma otho nopie ka owuoyo e pap alanga,","poem":1},{"text":"kaka cham mokaa gi jakeyo,","poem":2},{"lineBreak":true},{"text":"maonge ngʼama nyalo chokogi.’ ”","poem":2}]},{"type":"verse","number":23,"content":["Ma e gima Jehova Nyasaye wacho:",{"text":"“Kik ngʼama riek sungre gi riekone","poem":1},{"text":"kata ngʼama tek sungre gi tekone,","poem":2},{"lineBreak":true},{"text":"kata ngʼama omewo sungre gi mwandu mage,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"to ngʼat ma sungore mondo osungre kama:","poem":1},{"text":"ni ongʼeya, kendo owinja,","poem":2},{"text":"ni An e Jehova Nyasaye, matimo ngʼwono,","poem":1},{"text":"kendo mangʼado bura mar adier,","poem":2},{"lineBreak":true},{"text":"kendo matimo gik makare e piny,","poem":2},{"text":"nikech magi ema amorgo,”","poem":1},{"text":"Jehova Nyasaye ema owacho.","poem":2}]},{"type":"verse","number":25,"content":["Jehova Nyasaye wacho niya, “Ndalo biro ma anakumie joma oter nyangu e ringruok kende"]},{"type":"verse","number":26,"content":["kaka Misri, Juda, Edom, Amon, Moab gi jogo duto modak kuonde motimo ongoro man maboyo. Nimar ogendinigi duto ok oter nyangu adier, kendo kata od Israel duto bende ok oter nyangu e chunygi.”"]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/JER/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/JER/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/JER/8.json","previousChapterAudioLinks":{},"numberOfVerses":26}