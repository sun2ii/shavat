{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"JOL","translationId":"luo_bib","name":"Joel","commonName":"Joel","title":"Joel","order":29,"numberOfChapters":3,"sha256":"a7dd660d1a52952369aee819a1ac31eb0d7beef3723cc5d3a66a93934c30d1ab","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/luo_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Wach Jehova Nyasaye mane obiro ne Joel wuod Pethuel."]},{"type":"line_break"},{"type":"heading","content":["Bonyo omonjo piny"]},{"type":"verse","number":2,"content":[{"text":"Winjuru ma, un jodongo;","poem":1},{"text":"chikuru itu, un duto ma udak e piny.","poem":2},{"text":"Bende gima chalo kama osetimore e ndalou,","poem":1},{"text":"kata e ndalo mag kwereu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nyis nyithindu wachni,","poem":1},{"text":"kendo nyithindu onyis nyithindgi,","poem":2},{"lineBreak":true},{"text":"kendo nyithindgi bende onyis tiengʼ maluwogi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gik ma mony mar bonyo oweyo,","poem":1},{"text":"bonyo madongo osechamo;","poem":2},{"text":"gik ma bonyo madongo oweyo","poem":1},{"text":"bonyo matindo osechamo,","poem":2},{"text":"gik ma bonyo matindo oweyo","poem":1},{"text":"bonyo mamoko nochamo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Un jomer, chiewuru kendo ywaguru!","poem":1},{"text":"Gouru nduru, un duto ma jomath mag divai;","poem":2},{"text":"gouru nduru nikech divai manyien,","poem":1},{"text":"nikech oseyudhe ogole e dhou.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Oganda moro osemonjo pinya, en oganda maratego","poem":1},{"text":"kendo gingʼeny mokadho akwana;","poem":2},{"text":"en gi leke mag sibuor madichwo,","poem":1},{"text":"leke mager mag sibuor madhako.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Oselwero it mzabibu maga,","poem":1},{"text":"kendo ketho yiende ngʼopega.","poem":2},{"text":"Osepoko potgi","poem":1},{"text":"mi owitogi kucho,","poem":2},{"lineBreak":true},{"text":"kendo oweyo bedegi kodongʼ rachere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ywaguru ka ukuyo ka dhako ma pod tin ma orwakore gi law kuyo,","poem":1},{"text":"ka oywago chwore mane ohange.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Chiwo mag cham kod misango miolo piny","poem":1},{"text":"orumo e od Jehova Nyasaye.","poem":2},{"text":"Jodolo ywak","poem":1},{"text":"joma tiyo e nyim Jehova Nyasaye ywak.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Puothe okethore,","poem":1},{"text":"lowo otwo;","poem":2},{"text":"cham okethore,","poem":1},{"text":"divai manyien orumo,","poem":2},{"lineBreak":true},{"text":"mo bende onge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kik ugen gimoro un jopur,","poem":1},{"text":"denguru un jopidh mzabibu,","poem":2},{"text":"beduru mokuyo nikech ngano gi shairi,","poem":1},{"text":"nikech cham mochiek manie puothe okethore.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mzabibu osetwo","poem":1},{"text":"kendo ngʼowu osener,","poem":2},{"text":"olemo mongʼinore, gi othidhe kod mapera","poem":1},{"text":"kaachiel gi yiende duto mag puodho osetwo.","poem":2},{"text":"Adier mor mar dhano","poem":1},{"text":"bende oserumo.","poem":2}]},{"type":"heading","content":["Luong mar lokruok"]},{"type":"verse","number":13,"content":[{"text":"Yaye un jodolo, rwakreuru gi pien gugru kuywak;","poem":1},{"text":"denguru kendo gouru nduru,","poem":2},{"lineBreak":true},{"text":"un joma tiyo e nyim kendo mar misango.","poem":2},{"text":"Biuru, mondo uywagru otieno duto,","poem":1},{"text":"un joma tiyo e nyim kendo mar misango,","poem":2},{"text":"nikech cham mag misango kod misengini miolo piny,","poem":1},{"text":"onge e od Nyasachwa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Landuru lemo gi riyo kech maler","poem":1},{"text":"kendo luonguru chokruok maler.","poem":2},{"text":"Chokuru jodongo","poem":1},{"text":"kod ji duto modakie piny,","poem":2},{"text":"mondo gibi e od Jehova Nyasaye ma Nyasachu,","poem":1},{"text":"mondo giywagre ne Jehova Nyasaye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mano kaka odiechiengno lich!","poem":1},{"text":"Nimar odiechieng Jehova Nyasaye chiegni,","poem":2},{"lineBreak":true},{"text":"enobi kaka kethruok moa kuom Nyasaye Maratego.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Donge chiemo osegol oko e nyim wangʼwa;","poem":1},{"text":"donge ilo kod mor onge e od Nyasachwa?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kothe otop","poem":1},{"text":"motwo ei lowo.","poem":2},{"text":"Ute keno okethore,","poem":1},{"text":"dere osego piny,","poem":2},{"lineBreak":true},{"text":"nikech cham onge.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mano kaka dhok chur!","poem":1},{"text":"Kweth mag jamni tangni koni gi koni,","poem":2},{"text":"nikech gionge lek;","poem":1},{"text":"kata mana kweth mag rombe sandore.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"In ema aluongi, yaye Jehova Nyasaye,","poem":1},{"text":"nikech mach osewangʼo pewe mag kwath,","poem":2},{"lineBreak":true},{"text":"kendo ligek mach osewangʼo yiende duto manie pap.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Koda ka le mag thim bende tangni ka dwari nikech","poem":1},{"text":"aore duto oseduono,","poem":2},{"lineBreak":true},{"text":"kendo mach osewangʼo pewe mag kwath.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}