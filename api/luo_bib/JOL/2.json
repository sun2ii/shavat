{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"JOL","translationId":"luo_bib","name":"Joel","commonName":"Joel","title":"Joel","order":29,"numberOfChapters":3,"sha256":"a7dd660d1a52952369aee819a1ac31eb0d7beef3723cc5d3a66a93934c30d1ab","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/luo_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["Mony mar bonyo"]},{"type":"verse","number":1,"content":[{"text":"Gouru tungʼ e Sayun;","poem":1},{"text":"kendo gouru milome e goda maler.","poem":2},{"lineBreak":true},{"text":"Ji duto modak e piny mondo otetni,","poem":1},{"text":"nikech odiechiengʼ mar Jehova Nyasaye biro.","poem":2},{"text":"Osesudo machiegni.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"En odiechiengʼ mar mudho kod kuyo,","poem":2},{"lineBreak":true},{"text":"kendo en odiechieng mar rumbi kod mudho mandiwa.","poem":2},{"text":"Ochalo gi piny moyawore ma lerne rieny e kor gode;","poem":1},{"text":"oganda mangʼongo kendo maratego mar jolweny biro,","poem":2},{"text":"mane pok one nyaka nene,","poem":1},{"text":"kendo ok nochak one ndalo mabiro nyaka chiengʼ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mach wengʼo nyimgi,","poem":1},{"text":"to bangʼ-gi ligek mach bebnie.","poem":2},{"text":"Piny chalo gi puoth Eden yo ka nyimgi","poem":1},{"text":"to ka bangʼ-gi piny otwo modongʼ nono,","poem":2},{"lineBreak":true},{"text":"onge gimoro manyalo pusorenegi matony.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kitgi chalo kaka farese;","poem":1},{"text":"Gilengʼore kaka jolweny moidho farese.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gilengʼore ewi gode gi koko machalo koko mag geche lweny,","poem":1},{"text":"kendo kaka mach makakni kawangʼo yugi,","poem":2},{"text":"kendo mana kaka oganda mar jolweny maroteke machanore ne lweny.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ka ogendini goyo wangʼni kuomgi,","poem":1},{"text":"to gidhier nono kendo wengegi lil.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gibiro ka giger ka jokedo;","poem":1},{"text":"gilwenyo ohinga ka jolweny.","poem":2},{"text":"Gipangore wangʼ achiel ka gichanore,","poem":1},{"text":"ma ok gilok yorgi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ok gituomre, moro ka moro pangore","poem":1},{"text":"kochimo nyime tir.","poem":2},{"text":"Gimuomo gik madigengʼ-gi","poem":1},{"text":"ka ok giketho kaka gichanore.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gichomo dala maduongʼ gireto,","poem":1},{"text":"giringo ka gilwenyo ohinga,","poem":2},{"text":"giidho nyaka ei udi;","poem":1},{"text":"kendo gidonjo gie dirisni mana ka jokwoge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Piny tetni e nyimgi,","poem":1},{"text":"polo bende yiengni,","poem":2},{"text":"chiengʼ gi dwe lokore mudho,","poem":1},{"text":"to sulwe bende ok rieny.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jehova Nyasaye kok matek","poem":1},{"text":"e nyim jolweny mage;","poem":2},{"text":"jolweny mage ok nyal kwan,","poem":1},{"text":"joma winje gin joma roteke.","poem":2},{"text":"Odiechieng Jehova Nyasaye duongʼ;","poem":1},{"text":"kendo olich mokadho.","poem":2},{"lineBreak":true},{"text":"En ngʼa manyalo siro odiechiengno?","poem":2}]},{"type":"heading","content":["Lokuru chunyu"]},{"type":"verse","number":12,"content":[{"text":"Jehova Nyasaye owacho ni,","poem":1},{"text":"“Kata sani, dwoguru ira gi chunyu duto,","poem":2},{"lineBreak":true},{"text":"ka uriyo kech kendo uywak kendo udengo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Lokuru chunyu,","poem":1},{"text":"to ok lepu.","poem":2},{"text":"Dwoguru ir Jehova Nyasaye, ma Nyasachu,","poem":1},{"text":"nikech ongʼwon kendo okecho ji,","poem":2},{"text":"iye ok wangʼ piyo kendo ojahera,","poem":1},{"text":"bende chunye lendo kuom kelo ne ji masira kata chwat.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"En ngʼa mongʼeyo? Onyalo lokore mi okechu","poem":1},{"text":"kendo owenu gweth,","poem":2},{"text":"kendo ubed gi chiwo mag cham kod misengini","poem":1},{"text":"miolo piny muchiwo ni Jehova Nyasaye, Nyasachu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Gouru turumbete e Sayun,","poem":1},{"text":"landuru lemo mar riyo kech maler,","poem":2},{"lineBreak":true},{"text":"luonguru chokruok maler.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Chokuru ji kanyakla,","poem":1},{"text":"pwodhuru chokruok mar oganda,","poem":2},{"text":"chokuru jodongo kaachiel,","poem":1},{"text":"keluru nyithindo kaachiel,","poem":2},{"lineBreak":true},{"text":"koda nyithindo madhodho thuno.","poem":2},{"text":"Wuowi monyombo machiegni mondo owuogi oa e ode,","poem":1},{"text":"kendo miaha mondo owuogi oa kachiena.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Jodolo, matiyo e nyim Jehova Nyasaye,","poem":1},{"text":"mondo oywagi, e kind agola gi","poem":2},{"lineBreak":true},{"text":"kendo mar misango mar hekalu.","poem":2},{"text":"Giywag kagiwacho niya, “Yaye Jehova Nyasaye,","poem":1},{"text":"kik itiek jogi.","poem":2},{"text":"Kik imi girkeni mari obed gima ichayo,","poem":1},{"text":"ma ogendini wuoyo kuome marach.","poem":2},{"text":"Angʼo ma dimi giwachi e dier ogendini niya,","poem":1},{"text":"‘Ere Nyasachgi?’ ”","poem":2}]},{"type":"heading","content":["Dwoko mar Jehova Nyasaye"]},{"type":"verse","number":18,"content":[{"text":"Eka Jehova Nyasaye nyiego nomaki","poem":1},{"text":"nikech pinye kendo nokech joge.","poem":2}]},{"type":"verse","number":19,"content":["Jehova Nyasaye nodwokgi kowacho niya,",{"text":"“Abiro miyou cham gi divai manyien kod mo zeituni,","poem":1},{"text":"moromo yiengʼou chuth;","poem":2},{"text":"ok anachak ami ubed","poem":1},{"text":"jogo michayo e dier ogendini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Anariemb jolweny moa nyandwat madhi mabor kodu,","poem":1},{"text":"anariembu nyaka e thim motwo,","poem":2},{"text":"joge motelo nodhi e nam man yo wuok chiengʼ,","poem":1},{"text":"to modongʼ nodhi e nam man yo podho chiengʼ.","poem":2},{"text":"To jogi motho biro dungʼ,","poem":1},{"text":"mi dungʼne nopongʼ piny.”","poem":2},{"lineBreak":true},{"text":"Adiera osetimo gik madongo.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Yaye piny, weuru luor;","poem":2},{"lineBreak":true},{"text":"bed mamor kendo moil,","poem":2},{"text":"adiera Jehova Nyasaye osetimo gik madongo.","poem":1}]},{"type":"verse","number":22,"content":[{"text":"Yaye le manie thim, weuru luor;","poem":2},{"lineBreak":true},{"text":"nikech pewe kwath koro loth,","poem":2},{"text":"yiende nyago olembegi;","poem":1},{"text":"Ngʼowu gi mzabibu golo mwandugi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yaye jo-Sayun moruru,","poem":1},{"text":"beduru moil kuom Jehova Nyasaye, ma Nyasachu,","poem":2},{"text":"nikech osemiyou","poem":1},{"text":"koth mar chwiri e yo makare,","poem":2},{"text":"asemiyou ngʼidho mogundho,","poem":1},{"text":"moriwo kodh chwiri kod kodh opon, mana kaka chon.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kuonde dino cham nopongʼ gi cham;","poem":1},{"text":"kendo degi nopongʼ mi-oo oko gi divai manyien kod mo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Abiro chulou kuom higni ma bonyo osechamo;","poem":1},{"text":"bonyo madongo gi matindo,","poem":2},{"lineBreak":true},{"text":"gi bonyo mamoko gi mony mar bonyo;","poem":2},{"text":"ma gin oganda maduongʼ mar jolweny mara mane aoro e dieru.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Unubed gi chiemo mathoth, ma uchamo nyaka unuyiengʼ,","poem":1},{"text":"kendo unupak nying Jehova Nyasaye,","poem":2},{"lineBreak":true},{"text":"ma Nyasachu, mosetimonu timbe miwuoro.","poem":2},{"text":"Wi joga ok nochak okuod kendo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Eka unungʼe ni antie ei Israel,","poem":1},{"text":"ni An e Jehova Nyasaye, ma Nyasachu,","poem":2},{"text":"kendo ni onge moro machielo;","poem":1},{"text":"wi joga ok nochak okuod kendo.”","poem":2}]},{"type":"heading","content":["Odiechiengʼ mar Jehova Nyasaye"]},{"type":"verse","number":28,"content":[{"text":"“Bangʼe,","poem":1},{"text":"anaol Roho Maler mara kuom ji duto.","poem":2},{"text":"Yawuotu gi nyiu nokor wach,","poem":1},{"text":"jodongu nolek lek,","poem":2},{"lineBreak":true},{"text":"jou matindo none fweny.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kata mana jotichna machwo gi mamon,","poem":1},{"text":"bende, naol Roho Maler mara kuomgi ndalono.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Anatim honni miwuoro e kor polo","poem":1},{"text":"to e piny,","poem":2},{"lineBreak":true},{"text":"remo gi mach kod iro madhwolore nobedie.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Wangʼ chiengʼ nolokre mudho","poem":1},{"text":"to dwe nolokre remo,","poem":2},{"lineBreak":true},{"text":"kapok odiechiengʼ maduongʼ kendo malich mar Jehova Nyasaye ochopo.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"To ngʼato ka ngʼato maluongo","poem":1},{"text":"nying Jehova Nyasaye noresi;","poem":2},{"text":"nikech ewi got Sayun kendo ei Jerusalem","poem":1},{"text":"resruok nobedie,","poem":2},{"lineBreak":true},{"text":"mana kaka Jehova Nyasaye osewacho,","poem":2},{"text":"e dier joma otony","poem":1},{"text":"ma Jehova Nyasaye oluongo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}