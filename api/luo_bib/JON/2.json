{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"JON","translationId":"luo_bib","name":"Jona","commonName":"Jona","title":"Jona","order":32,"numberOfChapters":4,"sha256":"827104631a9dfbd0b7b1d3f38ec49646f39d71d822558e6f997aa5962920d949","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/luo_bib/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Lemo mar Jona"]},{"type":"verse","number":1,"content":["Kane Jona ne ni ei rech, nolamo Jehova Nyasaye."]},{"type":"verse","number":2,"content":["Nowacho niya,",{"text":"“Ei masichena naluongo Jehova Nyasaye","poem":1},{"text":"kendo nodwoka.","poem":2},{"text":"Ei bur matut ne aywak mondo ikonya","poem":1},{"text":"mane iwinjo ywakna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Niluta kuma tut mar nam,","poem":1},{"text":"nyaka kama tutne ogikie piny,","poem":2},{"text":"mi ataro noketa diere;","poem":1},{"text":"kendo apaka kod ahiti madongo duto nokadho kuoma.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne awacho ni,","poem":1},{"text":"‘Oseriemba e wangʼi;","poem":2},{"text":"to kata kamano,","poem":1},{"text":"pod abiro siko ka angʼiyo hekalu mari maler.’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pi mane olwora nobwoga kendo kude mag nam","poem":1},{"text":"bende noima kendo buya mag nam nogajore e wiya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nalutora nyaka e tiend gode mag nam","poem":1},{"text":"kendo piny nouma chuth nyaka chiengʼ.","poem":2},{"text":"To nigola oko kangima","poem":1},{"text":"e bur matut, yaye Jehova Nyasaye, ma Nyasacha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ka chunya ne dwaro aa ne apari Jehova Nyasaye,","poem":1},{"text":"kendo lemona nochopo nyaka e hekalu mari maler.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Joma otwere kalamo nyiseche manono,","poem":1},{"text":"jwangʼo ngʼwono mado bedo margi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"An to napaki kod wend goyo erokamano","poem":1},{"text":"mi natimni misango.","poem":2},{"text":"Gima asesingora nachop kare","poem":1},{"text":"nikech warruok wuok kuom Jehova Nyasaye.”","poem":2}]},{"type":"verse","number":10,"content":["Kendo Jehova Nyasaye nowuoyo gi rech mi rechno nongʼogo Jona oko e dho wath kama otwo."]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}