{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"LAM","translationId":"luo_bib","name":"Ywagruok","commonName":"Ywagruok","title":"Ywagruok","order":25,"numberOfChapters":5,"sha256":"39d470c53d8f2dae682aa8f065d9eecc0d653dd1bb1fe2fa6292c96b486c3ab9","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/luo_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Mano kaka dala maduongʼ mane ji ngʼenyie","poem":1},{"text":"odongʼ nono!","poem":2},{"text":"Kinde moro ne en dala malich miwuoro","poem":1},{"text":"to koro ochalo gi dhako ma chwore otho!","poem":2},{"text":"Ne en ruoth madhako e kind pinje,","poem":1},{"text":"to tinde osebedo misumba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Oywak malit gotieno,","poem":1},{"text":"pi wangʼe ridore e lembe.","poem":2},{"text":"Kuom joherane duto,","poem":1},{"text":"onge moro manyalo hoye.","poem":2},{"text":"Osiepene duto osendhoge","poem":1},{"text":"kendo gisebedo jowasike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bangʼ sand gi tij achuna,","poem":1},{"text":"Juda oseter e twech.","poem":2},{"text":"Odak e dier ogendini","poem":1},{"text":"kendo oonge kar yweyo.","poem":2},{"text":"Jogo duto malawe osemake kapod en","poem":1},{"text":"e chandruok malich.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yore madhiyo Sayun ywagore,","poem":1},{"text":"nimar onge ngʼato mabiro e nyasi mag sewni moyier.","poem":2},{"text":"Dhorangeye duto odongʼ nono maonge ji,","poem":1},{"text":"jodologe ywak ka chur,","poem":2},{"text":"jotichge ma nyiri okuyo,","poem":1},{"text":"to en owuon en gi lit malich.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wasike ema tinde otelone,","poem":1},{"text":"kendo wasikego dhi maber.","poem":2},{"text":"Jehova Nyasaye osekelone chandruok","poem":1},{"text":"nikech richone mangʼeny.","poem":2},{"text":"Nyithinde oseter e twech, kendo gisebedo kaka joma omaki","poem":1},{"text":"e nyim wasigu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Duongʼ mar loch duto mane nyar Sayun nigo","poem":1},{"text":"oserumo.","poem":2},{"text":"Jodonge chalo gi mwanda modenyo","poem":1},{"text":"ma ok yud lum machamo,","poem":2},{"text":"giringo ka gionge","poem":1},{"text":"gi teko e nyim joma lawogi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"E ndalo mane Jerusalem ni e chandruok kod chuny lit,","poem":1},{"text":"noparo mwandune duto mane en-go e ndalo machon.","poem":2},{"text":"Wasike nojare","poem":1},{"text":"kendo onyiero kuom thagruok mage.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jerusalem osetimo richo madongo","poem":1},{"text":"omiyo koro osebedo mochido.","poem":2},{"text":"Ji duto mane omiye luor koro ochaye,","poem":1},{"text":"nimar giseneno duge;","poem":2},{"text":"kendo koro oywak kochur","poem":1},{"text":"nikech wiye kuot.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Chilo ma en-go omienore e lepe,","poem":1},{"text":"ne ok odewo gima biro timorene bangʼe.","poem":2},{"text":"Nopodho malich miwuoro,","poem":1},{"text":"to onge ngʼama ne nyalo hoye.","poem":2},{"text":"Yaye Jehova Nyasaye, neye chandruok ma an-go,","poem":1},{"text":"nimar wasigu oseloyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wasigu oseyako","poem":1},{"text":"mwandune duto;","poem":2},{"text":"oseneno ogendini ma jopiny","poem":1},{"text":"ka donjoe kare maler mar lemo,","poem":2},{"text":"jogo misekwero ni kik donji","poem":1},{"text":"e kari maler mar lemo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Joge duto chur kaywagore","poem":1},{"text":"ka gimanyo chiemo;","poem":2},{"text":"giloko mwandugi","poem":1},{"text":"mondo giyud chiemo,","poem":2},{"lineBreak":true},{"text":"mondo gibed mangima.","poem":2},{"text":"“Yaye Jehova Nyasaye, neye kendo iparae,","poem":1},{"text":"nimar ji ochaya.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Un ji duto makadho, onge lich muneno kuom gima timorenani?","poem":1},{"text":"Lokreuru anena mondo unee,","poem":2},{"text":"ka bende nitiere masira machielo","poem":1},{"text":"machalo gi masira moyudani,","poem":2},{"text":"ma Jehova Nyasaye oseketo kuoma","poem":1},{"text":"e odiechiengʼ mar mirimbe mager?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ne ooro mach koa e polo,","poem":1},{"text":"modonjo e chokena.","poem":2},{"text":"Nochiko obadho momako tiendena","poem":1},{"text":"kendo nodwoka chien.","poem":2},{"text":"Nomiya abedo modhier kadongʼ kenda","poem":1},{"text":"ka aol maonge teko odiechiengʼ duto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Richona osetwe e ngʼuta ka jok;","poem":1},{"text":"adier osetweyogi gi lwete owuon.","poem":2},{"text":"Oseketgi e ngʼuta","poem":1},{"text":"kendo Ruoth Nyasaye osetieko tekra,","poem":2},{"text":"bende osejwangʼa","poem":1},{"text":"e lwet joma ok anyal loyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Ruoth Nyasaye","poem":1},{"text":"osekwedo jolweny maga duto;","poem":2},{"text":"osechoko jolweny","poem":1},{"text":"mondo omonja,","poem":2},{"text":"kendo otiek yawuota ma jolweny.","poem":1},{"lineBreak":true},{"text":"Ruoth Nyasaye osekumo nyar Juda mapok ongʼeyo chwo","poem":1},{"text":"e kare mar biyo olemb mzabibu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Ma emomiyo aywak","poem":1},{"text":"kendo pi wangʼa mol e lemba.","poem":2},{"text":"Onge ngʼat machiegni koda ma dihoya,","poem":1},{"text":"bende onge ngʼat ma dikwe chunya.","poem":2},{"text":"Nyithinda odongʼ kiye","poem":1},{"text":"nikech wasigu oselocho.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Sayun tingʼo bedene malo kaywak,","poem":1},{"text":"to onge ngʼama nyalo hoye.","poem":2},{"text":"Jehova Nyasaye oseketo chik ni Jakobo,","poem":1},{"text":"ni jogo modak bute,","poem":2},{"lineBreak":true},{"text":"mondo obed wasike;","poem":2},{"text":"Jerusalem osebedo gima ochido","poem":1},{"text":"e diergi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Jehova Nyasaye en Nyasaye makare,","poem":1},{"text":"to kata kamano ne angʼanyo ne chikene.","poem":2},{"text":"Winjuru, un ji duto;","poem":1},{"text":"kendo neeuru kaka achandora.","poem":2},{"text":"Yawuota gi nyiga osemaki","poem":1},{"text":"moter e twech.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ne aluongo osiepena,","poem":1},{"text":"to ne gindhoga.","poem":2},{"text":"Jodolo maga gi jodonga","poem":1},{"text":"notho e dala maduongʼ,","poem":2},{"text":"kane gimanyo chiemo","poem":1},{"text":"mondo gibed mangima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yaye Jehova Nyasaye, nee kaka anie chandruok malich!","poem":1},{"text":"Iya nyawni,","poem":2},{"text":"kendo chunya chandore malich,","poem":1},{"text":"nikech ok aseluoro chikeni.","poem":2},{"text":"Lweny nego ji oko mar dala","poem":1},{"text":"to ei dala bende tho nekoe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ji osewinjo ywakna,","poem":1},{"text":"to onge ngʼama dewa.","poem":2},{"text":"Wasika duto osewinjo chandruokna;","poem":1},{"text":"kendo gimor kuom gik ma isetimona.","poem":2},{"text":"Mad ikel odiechiengʼ mane iselando","poem":1},{"text":"mondo omi gichal koda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"We mondo timbegi mamono ochop e nyimi;","poem":1},{"text":"kendo timnegi,","poem":2},{"text":"mana kaka isetimona","poem":1},{"text":"kuom richona duto.","poem":2},{"text":"An gi pek mangʼeny","poem":1},{"text":"kendo chunya onyosore.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}