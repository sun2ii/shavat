{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"LAM","translationId":"luo_bib","name":"Ywagruok","commonName":"Ywagruok","title":"Ywagruok","order":25,"numberOfChapters":5,"sha256":"39d470c53d8f2dae682aa8f065d9eecc0d653dd1bb1fe2fa6292c96b486c3ab9","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/luo_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Mano kaka Ruoth Nyasaye osekumo Nyar Sayun","poem":1},{"text":"gi mirimbe motwere ka rumbi!","poem":2},{"text":"Duongʼ mar Israel ma yande otundo nyaka e polo,","poem":1},{"text":"osewito piny,","poem":2},{"text":"bende kuom mirimbe","poem":1},{"text":"ok oseparo ni en raten mar tiende.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ruoth Nyasaye oseketho","poem":1},{"text":"mier duto mag Jakobo ka ok odewo;","poem":2},{"text":"nikech mirimbe osemuko","poem":1},{"text":"kuonde mochiel motegno mag Nyar Juda.","poem":2},{"text":"Nokuodo wi jopinyno gi jotende","poem":1},{"text":"mi odwoko lochgi chien.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Osetieko teko mar jo-Israel","poem":1},{"text":"gi mirimbe mager,","poem":2},{"text":"kendo osejwangʼogi","poem":1},{"text":"e lwet wasikgi.","poem":2},{"text":"Osewengʼo ka Jakobo kaka mach mager makakni","poem":1},{"text":"ma wangʼo gik moko duto molwore.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Oseywayo atungʼe mar kedo","poem":1},{"text":"gi joge mana ka gima gin wasike.","poem":2},{"text":"Kaka jasigu neko,","poem":1},{"text":"osenego jogo duto mane nenore mabeyo e wangʼ,","poem":2},{"text":"kendo oseolo mirimbe oko","poem":1},{"text":"ka mach kuom hemb Nyar Sayun.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ruoth Nyasaye chalo gi jasigu;","poem":1},{"text":"kendo osetieko Israel!","poem":2},{"text":"Osemuko ute Israel duto mag ruoth","poem":1},{"text":"kendo oseketho mieche mochiel motegno.","poem":2},{"text":"Osemedo ywagruok","poem":1},{"text":"kod kuyo ne Nyar Juda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Oseketho kare mar dak mana ka puodho moketh chambe modongʼ nono,","poem":1},{"text":"kendo osemuko kare mar romo.","poem":2},{"text":"Jehova Nyasaye osemiyo Sayun wiye owil","poem":1},{"text":"kod sewni moyier gi Sabatoge;","poem":2},{"text":"kendo kuom mirimbe mager,","poem":1},{"text":"osejwangʼo ruoth kaachiel gi jadolo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ruoth Nyasaye osedagi kendone mar misango","poem":1},{"text":"kendo jwangʼo kare maler mar lemo.","poem":2},{"text":"Osechiwo ohinga mag kuonde mag dak","poem":1},{"text":"e lwet wasigu;","poem":2},{"text":"gisegoyo koko e od Jehova Nyasaye","poem":1},{"text":"mana kaka ne itimo e odiechiengʼ mar sawo moyier.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jehova Nyasaye osechano muko ohinga","poem":1},{"text":"molworo Nyar Sayun.","poem":2},{"text":"Oserieyo rapim kendo ne ok ogengʼo lwete","poem":1},{"text":"mondo kik okethe.","poem":2},{"text":"Nomiyo chiel ma oko mar dala kod ohinga oyiengni,","poem":1},{"text":"giduto kaachiel ne gimukore mi gigore piny.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dhorangeyene osegore piny molal ei lowo,","poem":1},{"text":"oseturo lodi mage kendo kethogi.","poem":2},{"text":"Ruodhe gi jodonge oke e kind ogendini,","poem":1},{"text":"chik onge koro,","poem":2},{"text":"to jonabi mage koro ok yud fweny","poem":1},{"text":"moa kuom Jehova Nyasaye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Jodongo mag nyar Sayun,","poem":1},{"text":"obedo piny kolingʼ thi,","poem":2},{"text":"gisebuko wiyegi gi buru","poem":1},{"text":"kendo girwako piende gugru.","poem":2},{"text":"Nyi Jerusalem","poem":1},{"text":"osekulo wiyegi piny.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Wangʼa ojony nikech ywak,","poem":1},{"text":"chunya ool,","poem":2},{"text":"kendo chandore malit","poem":1},{"text":"nikech joga osetieki,","poem":2},{"text":"kendo nyithindo kod nyithindo mayom kech nego","poem":1},{"text":"e yore mag dala maduongʼ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kech negogi","poem":1},{"text":"e kor minegi,","poem":2},{"text":"ka jogo mohiny e lweny","poem":1},{"text":"e yore mag dala maduongʼ,","poem":2},{"text":"mi gipodhi,","poem":1},{"text":"omiyo gipenjo minegi niya, “Ere chiemo kod divai?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yaye Nyar Jerusalem, en angʼo madawach kuomi?","poem":1},{"text":"Koso en angʼo ma dapimigo?","poem":2},{"lineBreak":true},{"text":"Yaye Nyar Sayun mapok ongʼeyo dichwo,","poem":2},{"text":"en angʼo ma dapimigo,","poem":1},{"text":"koso en angʼo ma dahoyigo?","poem":2},{"text":"Adhola ma in-go tut mana ka nam.","poem":1},{"text":"Ere ngʼama dithiedhnigo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Fweny mane jonabi magi oneno","poem":1},{"text":"ne ok adiera, to gin mana miriambo lilo,","poem":2},{"text":"ne ok ginyisi richoni","poem":1},{"text":"mondo omi kik teri e twech.","poem":2},{"text":"To fweny mane ginyisi","poem":1},{"text":"ne gin mana weche mag miriambo kendo ma wito ji.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ji duto makadho buti","poem":1},{"text":"pamo ni lwetegi;","poem":2},{"text":"gijari kendo gikino wigi","poem":1},{"text":"kuom gigo mosetimorene Nyar Jerusalem,","poem":2},{"text":"ka gipenjore niya, “Bende ma e dala maduongʼ","poem":1},{"text":"ma yande ongʼere ni dala maler,","poem":2},{"lineBreak":true},{"text":"kendo mor mar piny mangima?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Wasiki duto","poem":1},{"text":"wuoyo marach kuomi;","poem":2},{"text":"gijari ka gikayo lekegi","poem":1},{"text":"kagiwacho niya, “Wasetieke chuth.","poem":2},{"text":"Ma e ndalo mane wasebedo ka warito;","poem":1},{"text":"adier, osechopo ma wanene.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Jehova Nyasaye osetimo gima ne osechano;","poem":1},{"text":"osechopo mano mane owacho,","poem":2},{"lineBreak":true},{"text":"ma en gima nochiko chon.","poem":2},{"text":"Osetieki ma ok odewo,","poem":1},{"text":"kendo osemiyo wasigu goyoni siboi,","poem":2},{"lineBreak":true},{"text":"komedogi teko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Chunje ji ywak","poem":1},{"text":"ni Ruoth Nyasaye.","poem":2},{"text":"Yaye ohinga mar Nyar Sayun,","poem":1},{"text":"we pi wangʼi omol ka aora,","poem":2},{"lineBreak":true},{"text":"odiechiengʼ gotieno;","poem":2},{"text":"kik iywe kata matin,","poem":1},{"text":"kendo pi wangʼi kik chogi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Aa malo, ywagi otieno duto,","poem":1},{"text":"e kindego mag arita ma otieno chakore,","poem":2},{"text":"kendo weche duto manie chunyi ol oko ka pi","poem":1},{"text":"e nyim Ruoth Nyasaye.","poem":2},{"text":"Tingʼ bedeni malo kilame","poem":1},{"text":"nikech nyithindi,","poem":2},{"text":"ma kech nego","poem":1},{"text":"e wangʼ yore duto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yaye Jehova Nyasaye winjie wachni:","poem":1},{"text":"En ngʼa misetimone gima lit machal kama?","poem":2},{"text":"Bende mon dicham nyithindgi","poem":1},{"text":"ma giserito maber kama?","poem":2},{"text":"Koso jodolo gi jonabi dinegi","poem":1},{"text":"e kama ler mar lemo mar Ruoth Nyasaye adier?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Jomatindo gi jomadongo nindo","poem":1},{"text":"e yore motimo buru;","poem":2},{"text":"yawuota gi nyiga","poem":1},{"text":"oseneg gi ligangla.","poem":2},{"text":"Isenegogi ka in gi mirima","poem":1},{"text":"kendo isetiekogi ka ok idewo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ne iluongo masira koa kuonde duto","poem":1},{"text":"mana ka ji mabiro e nyasi moro maduongʼ.","poem":2},{"text":"E odiechiengʼ mar mirimb Jehova Nyasaye","poem":1},{"text":"onge ngʼato mane otony kata mane odongʼ kangima.","poem":2},{"text":"Kuom joga mane apidho","poem":1},{"text":"kendo arito, wasika osetieko.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}