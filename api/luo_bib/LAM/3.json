{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"LAM","translationId":"luo_bib","name":"Ywagruok","commonName":"Ywagruok","title":"Ywagruok","order":25,"numberOfChapters":5,"sha256":"39d470c53d8f2dae682aa8f065d9eecc0d653dd1bb1fe2fa6292c96b486c3ab9","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/luo_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"An e ngʼat moseneno masira","poem":1},{"text":"mane ayudo koa e lwet Jehova Nyasaye.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Oseriemba mabor kendo miyo awuotho","poem":1},{"text":"e mudho kar wuotho e ler;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"chutho osekuma","poem":1},{"text":"kinde ka kinde ndalo duto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Osemiyo denda odoko mool","poem":1},{"text":"kendo chokena osetur.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Osegoyona agengʼa kendo lwora","poem":1},{"text":"komiya abedo gi chuny malit kod olo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Osemiyo adak ei mudho","poem":1},{"text":"kaka jogo mane osetho chon.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Osechiela gi ohinga ma ok anyal ringo madhi;","poem":1},{"text":"kendo oseketa piny kotweya gi nyororo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kata ka aluongo kata kaywak ka dwaro kony,","poem":1},{"text":"to ogengʼo lamona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Osedino yora gohinga moger gi kidi;","poem":1},{"text":"omiyo awuotho e yore mobam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mana kaka ondieg bungu mobuto karito,","poem":1},{"text":"kata ka sibuor mopondo,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"e kaka noywaya oko e yo mokidha","poem":1},{"text":"kendo oweya maonge kaka dakonyra.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Noywayo atungʼe","poem":1},{"text":"kendo oketa thoro mar aserni mage.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nochwoyo chunya gi aserene","poem":1},{"text":"mowuodho e olalo mare.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nabedo ngʼat ma ji duto nyiero,","poem":1},{"text":"ne gijara gi wer pile ka pile.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Osepongʼo chunya","poem":1},{"text":"gi gik makech kod olo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Oseturo lekena gi kite mimuodo","poem":1},{"text":"kendo osenyona piny e buru.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Osemaya kwe;","poem":1},{"text":"kendo wiya osewil kod mor ma yande an godo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Emomiyo awacho niya, “Chia mara oserumo","poem":1},{"text":"kod gigo mane ageno kuom Jehova Nyasaye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Aparo chandruokna, wuodhena ma ok nikare,","poem":1},{"text":"kaachiel gi lit gi kuyo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Aparogi maber,","poem":1},{"text":"kendo an kod kuyo e chunya.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"To gima bende aparo","poem":1},{"text":"mamiyo abedo gi geno ema:","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Nikech hera maduongʼ mar Jehova Nyasaye osiko mochwere,","poem":1},{"text":"kendo ngʼwonone ok rum omiyo ok otiekwa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Herani gi ngʼwononi nyien okinyi kokinyi,","poem":1},{"text":"kendo adiera mari duongʼ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Abiro wacho kenda niya, “Jehova Nyasaye e pokna,","poem":1},{"text":"omiyo abiro geno kuome.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Jehova Nyasaye ber ne jogo ma genogi ni kuome,","poem":1},{"text":"kendo ne ngʼatno madware,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"en gima ber","poem":1},{"text":"rito warruok mar Jehova Nyasaye.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ber mondo ngʼato otingʼ jok","poem":1},{"text":"kapod en ngʼama tin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"We obed kar kende owuon kolingʼ,","poem":1},{"text":"nimar Jehova Nyasaye osetweyone jokno.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"We oik wiye ei buru,","poem":1},{"text":"dipoka pod en gi geno.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"We ochiw lembe ne ngʼatno ma digoye","poem":1},{"text":"kendo oyie bedo ngʼat ma ji jaro,","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"nikech Ruoth Nyasaye ok nyal jwangʼo ngʼato","poem":1},{"text":"nyaka chiengʼ.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Kata obedo ni okelo kuyo, to obiro nyiso ngʼwono,","poem":1},{"text":"nikech herane ma ok rum duongʼ ahinya,","poem":2}]},{"type":"verse","number":33,"content":[{"text":"nimar Nyasaye ok kel chandruok goyiem,","poem":1},{"text":"kata mana kuyo ni nyithind ji.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Donge Jehova Nyasaye neno kisando ji duto","poem":1},{"text":"manie twech,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"kata kitamo ngʼato e ratiro mare","poem":1},{"text":"e nyim Nyasaye Man Malo Moloyo,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"kata ka iketho buch ngʼato,","poem":1},{"text":"donge Ruoth Nyasaye neno gik ma kamago?","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"En ngʼa manyalo wuoyo kendo miyo gimoro timre","poem":1},{"text":"ka ok en Ruoth Nyasaye ema owacho?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Donge masiche kod ber wuok mana","poem":1},{"text":"koa kuom Nyasaye Man Malo Moloyo?","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Ere gima omiyo ngʼato angʼata mangima ngʼur","poem":1},{"text":"ka okume nikech richoge?","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Weuru wanon timbewa kendo wapar ane kaka gichalo,","poem":1},{"text":"eka wadog ir Jehova Nyasaye.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Wachiwuru chunywa kendo watingʼ bedewa malo","poem":1},{"text":"e nyim Nyasaye manie polo, kawawacho niya,","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Wasetimo richo kendo ngʼanyo,","poem":1},{"text":"to ok iseweyonwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Iselawowa ka in gi mirima;","poem":1},{"text":"mi inegowa ka ok idewo.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Iseumori gi boche polo","poem":1},{"text":"mondo lemo moro amora kik chop iri.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Isemiyo wabedo ka yugi","poem":1},{"text":"kendo ka owuoyo e kind ogendini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"“Wasikwa duto","poem":1},{"text":"wuoyo kuomwa marach gi ajara.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Luoro gi obadho ritowa","poem":1},{"text":"kendo kethruok gi masira ochomowa.”","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Pi wangʼa mol ka aora","poem":1},{"text":"nikech joga osenegi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Pi wangʼa biro chwer ma ok chogi,","poem":1},{"text":"maonge ngʼama konyo,","poem":2}]},{"type":"verse","number":50,"content":[{"text":"nyaka chop Jehova Nyasaye nokul wangʼe piny","poem":1},{"text":"ma onena gie polo.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Gima aneno miyo chunya kuyo","poem":1},{"text":"nikech gik matimore ne mon duto mar dalawa maduongʼ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Jogo mane wasika kayiem nono","poem":1},{"text":"nomanya ka winyo.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Negitemo mondo gitiek ngimana ka giluta ei bur;","poem":1},{"text":"kendo negibaya gi kite;","poem":2}]},{"type":"verse","number":54,"content":[{"text":"pi noima mine aparo","poem":1},{"text":"ni achiegni tho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"Naluongo nyingi, yaye Jehova Nyasaye,","poem":1},{"text":"ka an ei bur matut.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Kane akwayi ni mondo ikonya","poem":1},{"text":"to ne iwinjo ywakna.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Nibiro machiegni kane aluongi","poem":1},{"text":"kendo ne iwachona niya, “Kik iluor ngangʼ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"Yaye Ruoth Nyasaye ne itingʼo tingʼna,","poem":1},{"text":"kendo ne ireso ngimana.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Yaye Jehova Nyasaye, iseneno, rach mosetimna,","poem":1},{"text":"ngʼad bucha kare!","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Iseneno kaka ne gichulona kuor,","poem":1},{"text":"kod timbe mamono mane gichano timona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"Yaye Jehova Nyasaye, isewinjo ayany mag-gi,","poem":1},{"text":"kaachiel gi timbe mamono ma gichano timona,","poem":2}]},{"type":"verse","number":62,"content":[{"text":"ma gin gigo ma joma wasika wacho kuoma","poem":1},{"text":"kendo kuodhago lingʼ-lingʼ odiechiengʼ duto.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Koro negie nikech kata gibedo piny kata chungo to nyinga","poem":1},{"text":"ema giwuoyoe kokalo kuom wendegi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"Yaye Jehova Nyasaye, migi kum moromo gi timbegi kaluwore","poem":1},{"text":"gi gik ma lwetgi osetimo.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Mi gibed gi chuny matek","poem":1},{"text":"kendo mad kwongʼ mari obed kuomgi.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Yaye Jehova Nyasaye, mad ilawgi gi mirima,","poem":1},{"text":"kendo itiekgi gia e piny mane ichweyo.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}