{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"LAM","translationId":"luo_bib","name":"Ywagruok","commonName":"Ywagruok","title":"Ywagruok","order":25,"numberOfChapters":5,"sha256":"39d470c53d8f2dae682aa8f065d9eecc0d653dd1bb1fe2fa6292c96b486c3ab9","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/luo_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Mano kaka dhahabu osewito berne,","poem":1},{"text":"dhahabu maberie moloyo obedo marach!","poem":2},{"text":"Kite maler okere","poem":1},{"text":"e akerkeke mag yore duto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mano kaka yawuot Sayun mabeyo,","poem":1},{"text":"ma yande bergi ne romre gi pek mar dhahabu,","poem":2},{"text":"tinde ipimo mana gi agulni mag lowo,","poem":1},{"text":"ma en tich lwedo mar jachwe aguch lowo!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kata mana ondiegi chiwo thundegi","poem":1},{"text":"mondo nyithindgi odhodhi,","poem":2},{"text":"to joga osebedo jogo maonge chuny,","poem":1},{"text":"gichalo udo manie thim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nikech riyo oloyo nyathi madhoth","poem":1},{"text":"mi koro lewe omoko e dande;","poem":2},{"text":"kendo nyithindo kwayo chiemo,","poem":1},{"text":"to onge ngʼama migi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Joma yande chamo chiemo mamit,","poem":1},{"text":"koro gin jokwecho mojwangʼ e wangʼ yore;","poem":2},{"text":"to jogo ma yande odak e ngima maber","poem":1},{"text":"koro nindo e pidh yugi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kum mar joga","poem":1},{"text":"duongʼ moloyo mano mar Sodom,","poem":2},{"text":"mane lochne okethi mapiyo piyo nono","poem":1},{"text":"maonge ngʼama nobiro mondo okonye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Jotendgi ne ler marieny moloyo pe","poem":1},{"text":"kendo rachar maloyo chak,","poem":2},{"text":"dendgi ne pichni moloyo mo;","poem":1},{"text":"kendo nenruok margi ne chalo gi kidi ma nengone tek.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"To koro gin rotenge moloyo oyare","poem":1},{"text":"ma kata irom kodgi e wangʼ yore to ok nyal ngʼegi,","poem":2},{"text":"nimar pien ringregi osejowore kuom chokegi;","poem":1},{"text":"kendo osebedo motwo ka yien.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Joma notho e lweny ber moloyo","poem":1},{"text":"jogo ma kech onego;","poem":2},{"text":"kech chamogi ma gidhero","poem":1},{"text":"nikech cham onge e puothe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mon madhoth","poem":1},{"text":"notedo nyithindgi giwegi,","poem":2},{"text":"mobedo chiembgi","poem":1},{"text":"ka joga ne inego itieko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Jehova Nyasaye oseolo mirimbe mangʼeny","poem":1},{"text":"ka iye owangʼ.","poem":2},{"text":"Osemoko mach Sayun","poem":1},{"text":"moketho mise mage.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ruodhi mag piny ne ok oyie,","poem":1},{"text":"kata ji mag piny bende ne ok oyie,","poem":2},{"text":"ni wasigu kod jolweny nyalo donjo","poem":1},{"text":"e dhorangeye mag Jerusalem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"To mano notimore","poem":1},{"text":"nikech richo mag jonabi mage,","poem":2},{"text":"kod kethruok mag jodolo mage","poem":1},{"text":"mane ochwero remb joma kare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Koro gidigni e wangʼ yore","poem":1},{"text":"ka joma muofni.","poem":2},{"text":"Gidwanyore gi remo","poem":1},{"text":"maonge ngʼato madihedhre mulo lepgi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ji ywak kagoyonegi koko niya,","poem":1},{"text":"“Dhiuru kucha! Ok uler!”","poem":2},{"text":"Mabor kucha, mabor kucha!","poem":1},{"text":"Kik umulwa!","poem":2},{"text":"Ka giringo giaa kendo gibayo abaya,","poem":1},{"text":"ji mag ogendini wacho ni,","poem":2},{"lineBreak":true},{"text":"“Ok ginyal dak kodwa kendo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Jehova Nyasaye owuon osekeyogi e pinje;","poem":1},{"text":"kendo koro ok odewgi.","poem":2},{"text":"Jodolo ok yud duongʼ,","poem":1},{"text":"kendo jodongo ok mi luor.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kata kamano, wengewa nojony,","poem":1},{"text":"ka warango gima dikonywa;","poem":2},{"text":"to oganda mane wageno kuome ni nyalo konyowa","poem":1},{"text":"ne ok nyal konyowa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ji ne manyowa kamoro amora mawaluwo,","poem":1},{"text":"omiyo ne ok wanyal wuotho e wangʼ yorewa.","poem":2},{"text":"Luoro nomakowa nikech ndalowa nosechopo machiegni","poem":1},{"text":"kendo thowa ne osekayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Jogo mane lawowa ne ringo mapiyo","poem":1},{"text":"maloyo ongo mafuyo e kor polo;","poem":2},{"text":"negilawowa e kor gode madongo","poem":1},{"text":"kendo negibutonwa e thim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ngʼatno mowir mar Jehova Nyasaye,","poem":1},{"text":"mane wakwano kaka ngimawa,","poem":2},{"lineBreak":true},{"text":"nomaki e obadho mane gichiko.","poem":2},{"text":"Ne waparo ni e bwo tipone","poem":1},{"text":"wanyalo bedo mangima e dier ogendini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Moruru kendo beduru moil, yaye Nyar Edom,","poem":1},{"text":"un jogo modak e piny Uz.","poem":2},{"text":"To un bende, kikombeno ibiro miyou;","poem":1},{"text":"kendo ubiro mer mi udongʼ duge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yaye jo-Sayun, kum mane okumugo biro rumo;","poem":1},{"text":"bende ok nochak omed ndalou mar twech.","poem":2},{"text":"To un jo-Edom, obiro kumou nikech richou","poem":1},{"text":"kendo timbeu mamono obiro elo e lela.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}