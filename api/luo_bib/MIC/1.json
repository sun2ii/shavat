{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"MIC","translationId":"luo_bib","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"f02b870e0d78aa8c1d7d6887aaa568aee3923c87df57f23831ab160d81b29188","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/luo_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Wach Jehova Nyasaye mane obiro ne Mika ja-Moresheth e ndalo loch Jotham, Ahaz kod Hezekia Ruodhi mag Juda e fweny mane oneno kuom Samaria kod Jerusalem."]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Winjuru, yaye un ogendini duto.","poem":1},{"text":"Chik iti yaye piny gi ji duto modakie iye,","poem":2},{"text":"mondo Jehova Nyasaye mar oganda lweny obed janeno kuomu,","poem":1},{"text":"mondo Ruoth Nyasaye otim kamano gie hekalu mare maler.","poem":2}]},{"type":"heading","content":["Bura mongʼadne Samaria gi Jerusalem"]},{"type":"verse","number":3,"content":[{"text":"Neuru! Jehova Nyasaye biro kowuok e kar dakne;","poem":1},{"text":"olor piny kendo onyono kuonde ma otingʼore mag piny.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gode noleny e bwoye","poem":1},{"text":"kendo holni nobarore kapogore koni gi koni,","poem":2},{"text":"mana ka odok mobolie mach,","poem":1},{"text":"kendo mana ka pi maburore koa ewi thur.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Magi duto timore nikech bayo yo mar Jakobo,","poem":1},{"text":"nikech richo mar dhood Israel.","poem":2},{"text":"Bayo yo mar Jakobo to en angʼo?","poem":1},{"text":"Donge en Samaria?","poem":2},{"text":"Koso kama otingʼore mar Juda to kanye?","poem":1},{"text":"Donge en Jerusalem?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Kuom mano analok Samaria obed pith mar yugi,","poem":1},{"text":"kama ipidhoe mzabibu.","poem":2},{"text":"Abiro olo kite mag dalano nyaka e holo","poem":1},{"text":"kendo abiro weyo mise mage nono li.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gige mopa molamo ibiro toyo matindo tindo;","poem":1},{"text":"kendo mich mag hekalu mochiwo ibiro wangʼ gi mach;","poem":2},{"lineBreak":true},{"text":"abiro ketho kido mage molos duto.","poem":2},{"text":"Nikech michgo nochoko koa e chudo mar ochot,","poem":1},{"text":"omiyo koro ibiro ti kodgi kaka chudo mar ochot.”","poem":2}]},{"type":"heading","content":["Ywak gi dengo"]},{"type":"verse","number":8,"content":[{"text":"Kuom mano, abiro ywak kendo dengo;","poem":1},{"text":"abiro wuotho duk kod tienda nono.","poem":2},{"text":"Anaywag ka ondiek manie thim","poem":1},{"text":"kendo nadengi ka tula.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nikech adhondene ok thiedhre;","poem":1},{"text":"kata mana Juda adhondenego osemako.","poem":2},{"text":"Masira osechopo nyaka e dhoranga joga,","poem":1},{"text":"nyaka ei Jerusalem.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kik unyis jo-Gath wachni","poem":1},{"text":"bende kik uywagi kata matin.","poem":2},{"text":"E dala Beth Ofra","poem":1},{"text":"ngʼielreuru e buru.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Un joma odak Shafir","poem":1},{"text":"kadhuru ka un duge kod wichkuot.","poem":2},{"text":"Jogo modak Zanaan","poem":1},{"text":"ok nowuog oko.","poem":2},{"text":"Beth Ezel ni e kuyo","poem":1},{"text":"nikech gima orite osemaye.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Joma odak Maroth chunygi chandore ka nigi rem mapek","poem":1},{"text":"ka girito kony,","poem":2},{"text":"nikech masira osebiro koa kuom Jehova Nyasaye mochopo","poem":1},{"text":"nyaka dhoranga Jerusalem.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Un joma odak Lakish","poem":1},{"text":"tweuru fareseu e gecheu mag lweny.","poem":2},{"text":"Un ema ne umiyo nyar Sayun odonjo e richo,","poem":1},{"text":"nikech timbe jo-Israel maricho noa kuomu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Emomiyo gouru oriti","poem":1},{"text":"ne jo-Meresheth Gath, ok nochak ochungʼ kendo.","poem":2},{"text":"Dala maduongʼ mar Akzib","poem":1},{"text":"osewuondo ruodhi mag Israel.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Un joma odak Maresha,","poem":1},{"text":"abiro ketou e lwet wasiku mabiro loyou.","poem":2},{"text":"Ruodh Israel","poem":1},{"text":"biro pondo e rogo man Adulam.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Lieluru wiyeu mapoth ka udengo","poem":1},{"text":"nikech nyithindo muketo e chunyu ibiro mau miter e twech kaka wasumbini;","poem":2},{"text":"keturu bondou mapoth","poem":1},{"text":"mana ka achuth.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}