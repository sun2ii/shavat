{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"MIC","translationId":"luo_bib","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"f02b870e0d78aa8c1d7d6887aaa568aee3923c87df57f23831ab160d81b29188","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/luo_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"heading","content":["Chenro mar dhano gi mar Nyasaye"]},{"type":"verse","number":1,"content":[{"text":"Mano kaka nobed malit ne joma chano timo richo,","poem":1},{"text":"ka giriere e kitendinigi!","poem":2},{"text":"Gokinyi ka chiengʼ wuok to gichopo chenrogi","poem":1},{"text":"nikech gin gi teko mar timo kamano.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gigombo puothe gi udi mag ji","poem":1},{"text":"kendo gikawogi githuon.","poem":2},{"text":"Giwuondo ngʼato ma gimaa dalane","poem":1},{"text":"kendo kata anywolagi bende gimayo girkeni magi.","poem":2}]},{"type":"verse","number":3,"content":["Emomiyo Jehova Nyasaye wacho kama:",{"text":"“Achano kelo chandruok ne jogi","poem":1},{"text":"maonge ngʼama notony.","poem":2},{"text":"Ok unuchak uwuothi gi ngʼayi","poem":1},{"text":"nikech enobed kinde mar masira.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"E ndalono ji nogou ngero;","poem":1},{"text":"kendo ginichuognu wer malit mar kuyo ni:","poem":2},{"text":"‘Osetiekwa chuth,","poem":1},{"text":"mwanduwa osepog jomoko nono.","poem":2},{"text":"Eri omayowagi!","poem":1},{"text":"Opogo puothewa ne joma ndhogowa.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kuom mano ok unubed gi ngʼato kata achiel e chokruok mar Jehova Nyasaye","poem":1},{"text":"ma nogo ombulu kipogo lowo.","poem":2}]},{"type":"heading","content":["Jonabi mag miriambo"]},{"type":"verse","number":6,"content":[{"text":"Jonabi mag-gi wacho niya, “Kik ukor wach.","poem":1},{"text":"Kik ukor wach kuom gigi;","poem":2},{"lineBreak":true},{"text":"wichkuot ok nomakwa.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yaye od Jakobo, inyalo wacho niya:","poem":1},{"text":"“Bende Roho mar Jehova Nyasaye dikechi?","poem":2},{"lineBreak":true},{"text":"Bende dotim gik ma kamago?”","poem":2},{"lineBreak":true},{"text":"“Donge wechena timo maber ne ngʼatno","poem":1},{"text":"ma yorene oriere?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"E ndalogi,","poem":1},{"text":"joga oselokore wasik ji.","poem":2},{"text":"Ulonyo oko lewni ma nengogi tek","poem":1},{"text":"kuom joma kadho ka ok udewo,","poem":2},{"lineBreak":true},{"text":"mana ka joma odwogo oa e lweny.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Umonjo monde joga","poem":1},{"text":"kendo uriembogi e miechgi mabeyo.","poem":2},{"text":"Umayogi chuth gweth","poem":1},{"text":"ma asegwedhogo nyithindgi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Auru malo, dhiuru kucha!","poem":1},{"text":"Nikech kae ok en kar yweyo maru,","poem":2},{"text":"nimar odwanyore,","poem":1},{"text":"kendo okethore ma ok nyal kony.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ka ja-miriambo ma jawuond obiro kawacho niya,","poem":1},{"text":"‘Abiro koronu wach mondo ubed gi divai gi kongʼo mangʼeny,’","poem":2},{"lineBreak":true},{"text":"to ngʼat makamano ema bedo janabi ma jogi ohero!","poem":2}]},{"type":"heading","content":["Osing resruok ne jo-Israel"]},{"type":"verse","number":12,"content":[{"text":"“Abiro chokou un duto ma ok orem, yaye joka Jakobo;","poem":1},{"text":"abiro kelo jo-Israel modongʼ kaachiel ma ok orem.","poem":2},{"text":"Anakelgi kaachiel ka rombe manie abila,","poem":1},{"text":"kendo kaka jamni manie lek.","poem":2},{"lineBreak":true},{"text":"Kanyo nopongʼ gi ji.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Jal mayawo yore modinore nodhi nyimgi kotelonegi.","poem":1},{"text":"Ginimuom rangach mi gitony.","poem":2},{"text":"Ruodhgi nokwong okadh kotelonegi.","poem":1},{"text":"Jehova Nyasaye notelnegi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}