{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"MIC","translationId":"luo_bib","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"f02b870e0d78aa8c1d7d6887aaa568aee3923c87df57f23831ab160d81b29188","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/luo_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["Okwed jotelo kod jonabi mag Israel"]},{"type":"verse","number":1,"content":["Eka ne awacho niya,",{"text":"“Winjuru un jotelo maka Jakobo,","poem":1},{"text":"un jotelo mag dhood Israel.","poem":2},{"text":"Donge onego ungʼe ngʼado bura kare.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Umon gi gik mabeyo to uhero gik maricho;","poem":2},{"text":"ukidho pien joga oko","poem":1},{"text":"ka uyiecho ringʼo oko e chokegi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Uchamo ringre joga,","poem":1},{"text":"uyiecho pien dendgi,","poem":2},{"lineBreak":true},{"text":"kendo utoyo chokegi matindo tindo.","poem":2},{"text":"Ukengogi ka ringʼo midwa chielo,","poem":1},{"text":"ka ringʼo midwa tedo e agulu?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kinde biro ma giniywag ne Jehova Nyasaye","poem":1},{"text":"to ok enodwokgi ngangʼ.","poem":2},{"text":"Kindeno enopandnegi wangʼe","poem":1},{"text":"nikech gik maricho magisetimo.","poem":2}]},{"type":"verse","number":5,"content":["Ma e gima Jehova Nyasaye wacho:",{"text":"“Ne jonabi mane omiyo joga obaro oweyo yo,","poem":1},{"lineBreak":true},{"text":"ka ngʼato omiyogi chiemo","poem":1},{"text":"to giwacho ni, ‘kwe nitie,’","poem":2},{"text":"to ka ok omiyogi chiemo,","poem":1},{"text":"to giikore tugo kode lweny.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kuom mano otieno biro choponu ma ok nune fweny,","poem":1},{"text":"mudho nojuku ma ok nungʼe weche mopondo.","poem":2},{"text":"Chiengʼ biro podho ne jonabi","poem":1},{"text":"kendo odiechiengʼ nolokrenegi mudho.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jokor wach wigi biro kuot","poem":1},{"text":"kendo jo-nyakalondo none wichkuot.","poem":2},{"text":"Dhogi nomoki","poem":1},{"text":"nikech ok giniyud dwoko moa kuom Nyasaye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"An to apongʼ gi teko,","poem":1},{"text":"apongʼ gi Roho mar Jehova Nyasaye,","poem":2},{"lineBreak":true},{"text":"kod adiera kod nyalo mar hulo ne joka Jakobo kethogi,","poem":2},{"text":"mar nyiso jo-Israel richogi","poem":1},{"text":"gi kethogi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Winjuru wachni, un jotelo mag dhood Jakobo,","poem":1},{"text":"un jotelo mag dhood Israel,","poem":2},{"text":"un ma usin gadiera","poem":1},{"text":"kendo uriambo,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"un mugero Sayun gi remo,","poem":1},{"text":"to Jerusalem gi timbe mamono.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jotende ngʼado bura ka omigi asoya.","poem":1},{"text":"Jodolo mag-gi bende puonjo weche mag chik komigi chudo,","poem":2},{"lineBreak":true},{"text":"kendo jonabi mage koro wach mana komigi chudo.","poem":2},{"text":"To pod giyiengore mana kuom Jehova Nyasaye kagiwacho niya,","poem":1},{"text":"“Donge Jehova Nyasaye ni e dierwa,","poem":2},{"lineBreak":true},{"text":"onge masira mabiro makowa.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Emomiyo Sayun","poem":1},{"text":"ibiro pur ka puodho,","poem":2},{"text":"Jerusalem biro dongʼ gunda,","poem":1},{"text":"got matin mogerie hekalu nobed ka bungu motwere moyugno.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}