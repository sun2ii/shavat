{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"MIC","translationId":"luo_bib","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"f02b870e0d78aa8c1d7d6887aaa568aee3923c87df57f23831ab160d81b29188","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/luo_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["Got mar Jehova Nyasaye"]},{"type":"verse","number":1,"content":["E ndalo giko",{"text":"got mogerie hekalu mar Jehova Nyasaye nobed gi teko e kind gode duto molwore,","poem":1},{"lineBreak":true},{"text":"kendo ibiro tingʼe malo moyombo gode duto","poem":1},{"text":"kendo ogendini duto nobi ma pongʼe.","poem":2}]},{"type":"verse","number":2,"content":["Ogendini mangʼeny nobi kawacho niya,",{"text":"“Biuru wadhi e got mar Jehova Nyasaye,","poem":1},{"text":"e od Nyasach Jakobo.","poem":2},{"text":"Enopuonjwa wechene","poem":1},{"text":"mondo wawuothie e yorene.”","poem":2},{"text":"Chik nowuog Sayun,","poem":1},{"text":"kendo wach Jehova Nyasaye nowuog koa Jerusalem.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Obiro ngʼado bura e kind ogendini","poem":1},{"text":"kendo nokel kwe e kind pinje marateke man machiegni kod mago man mabor.","poem":2},{"text":"Ginithedh ligengligi olokre kwe mag pur","poem":1},{"text":"kendo tongegi ginithedhi olokre pende keyo.","poem":2},{"text":"Onge piny mano kedi gi nyawadgi gi ligangla","poem":1},{"text":"bende ok ginichak gipuonjre ne lweny kendo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngʼato ka ngʼato nobed e bwo yiende owuon mar mzabibu","poem":1},{"text":"kendo e bwo yiende owuon mar ngʼowu,","poem":2},{"text":"kendo onge ngʼama nochak omigi luoro","poem":1},{"text":"nikech Jehova Nyasaye Maratego osewacho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kata obedo ni ogendini mamoko duto","poem":1},{"text":"nyalo wuotho e nying nyisechegi,","poem":2},{"text":"wan to wabiro","poem":1},{"text":"wuotho e nying Jehova Nyasaye ma Nyasachwa manyaka chiengʼ.","poem":2}]},{"type":"heading","content":["Chenro mar Jehova Nyasaye"]},{"type":"verse","number":6,"content":[{"text":"Jehova Nyasaye wacho kama,","poem":1},{"text":"“E odiechiengno anachok rongʼonde,","poem":2},{"text":"gi joma oter e twech","poem":1},{"text":"kod joma asekelo negi lit.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abiro miyo rongʼode dongʼ kangima,","poem":1},{"text":"to joma odhi e twech nobed oganda motegno,","poem":2},{"text":"Jehova Nyasaye noritgi e got mar Sayun","poem":1},{"text":"chakre odiechiengno nyaka chiengʼ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yaye, in kama oger motingʼore mar rito rombe,","poem":1},{"text":"in ohinga mar Sayun,","poem":2},{"text":"ibiro duogni duongʼ mari machon;","poem":1},{"text":"nyar Jerusalem nobed jatelo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Angʼo momiyo koro iywak matek kamano,","poem":1},{"text":"ionge gi ruoth koso?","poem":2},{"text":"Dipo ka jangʼadni rieko osetho,","poem":1},{"text":"marem chami mana ka dhako mamuoch kayo?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ywari gi rem, yaye Nyar Sayun,","poem":1},{"text":"mana ka dhako mamuoch kayo,","poem":2},{"text":"nikech koro ochuni ni nyaka iwe dala maduongʼ","poem":1},{"text":"mondo idhi idagie pap nono.","poem":2},{"text":"Ibiro dhi Babulon","poem":1},{"text":"kendo kuno ema nokonyie.","poem":2},{"text":"Jehova Nyasaye noresi kuno","poem":1},{"text":"kogoli e lwet wasiki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"To koro ogendini mangʼeny","poem":1},{"text":"osechokore mondo giked kodi.","poem":2},{"text":"Giwacho niya, “Wamiye obed mogak,","poem":1},{"text":"wagouru siboi ni Sayun.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"To gikia","poem":1},{"text":"pach Jehova Nyasaye.","poem":2},{"text":"Ok giwinj chenrone,","poem":1},{"text":"En ema ochokogi ka cham midino e dier ot.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Chungi idin cham, yaye nyar Sayun,","poem":1},{"text":"nikech abiro sidhoni tunge mag chuma.","poem":2},{"text":"Abiro rwakoni ombongʼ tielo mag nyinyo","poem":1},{"text":"kendo ibiro toyo matindo tindo pinje mangʼeny.”","poem":2},{"text":"Mwandu magiseyudo e yore mobam ubiro walone Jehova Nyasaye,","poem":1},{"text":"mwandugi nochiwne Ruoth Nyasaye mar piny duto.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}