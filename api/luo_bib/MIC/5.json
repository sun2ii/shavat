{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"MIC","translationId":"luo_bib","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"f02b870e0d78aa8c1d7d6887aaa568aee3923c87df57f23831ab160d81b29188","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/luo_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"heading","content":["Ruoth mosingi ni noa Bethlehem"]},{"type":"verse","number":1,"content":[{"text":"Chokuru jokedo mau, yaye dala maduongʼ mar jokedo,","poem":1},{"text":"nikech wasikwa osegonwa agengʼa.","poem":2},{"text":"Gibiro goyo","poem":1},{"text":"lemb ruodh jo-Israel gi luth.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“To in Bethlehem Efratha,","poem":1},{"text":"kata obedo ni itin e dier dhout Juda,","poem":2},{"text":"kuomi ema ngʼat manobedna","poem":1},{"text":"jatend Israel nowuogie,","poem":2},{"text":"ngʼat machakruok mare noa chon,","poem":1},{"text":"kinde machon gi lala.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kuom mano Israel ibiro jwangʼ","poem":1},{"text":"nyaka kinde ma dhako man-gi ich nonywolie nyathi,","poem":2},{"text":"kendo owetene mamoko nodwogi","poem":1},{"text":"mi riwre gi jo-Israel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Enochungʼ mi okwa rombe","poem":1},{"text":"gi teko mar Jehova Nyasaye,","poem":2},{"lineBreak":true},{"text":"ka en gi duongʼ mar Jehova Nyasaye ma Nyasache.","poem":2},{"text":"Joge nodag maonge luoro","poem":1},{"text":"nikech duongʼne nochop e tunge piny,","poem":2}]},{"type":"heading","content":["Resruok kod kethruok"]},{"type":"verse","number":5,"content":[{"text":"kendo en owuon ema nobed kwe margi.","poem":1},{"text":"Ka jo-Asuria omonjo pinywa,","poem":2},{"lineBreak":true},{"text":"kendo ka ginyono kuondewa mochiel motegno,","poem":2},{"text":"to wabiro yiero jokwath abiriyo mondo oked kodgi;","poem":1},{"text":"adier jotendwa aboro norad kodgi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gibiro loyo piny jo-Asuria gi ligangla,","poem":1},{"text":"piny jo-Nimrod ibiro loyo gi ligangla mowuodhi.","poem":2},{"text":"Noresgi e lwet jo-Asuria","poem":1},{"text":"ka nomonj pinywa,","poem":2},{"lineBreak":true},{"text":"kendo ka nochopi e tongʼwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Joka Jakobo modongʼ","poem":1},{"text":"nobed e dier ogendini mangʼeny,","poem":2},{"text":"mana ka thoo moa kuom Jehova Nyasaye","poem":1},{"text":"kata ka ngʼidho ma omoko e lum,","poem":2},{"text":"malal apoya nono ne dhano","poem":1},{"text":"bende ok nyal rito dhano.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Joka Jakobo modongʼ nobed e dier ogendini,","poem":1},{"text":"ginibed e dier ji mayoreyore,","poem":2},{"text":"mana ka sibuor e dier le mag bungu,","poem":1},{"text":"kata ka sibuor matin e dier rombe,","poem":2},{"text":"makidho kendo nyulo kokadho,","poem":1},{"text":"maonge ngʼama nyalo resogi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Notingʼ lweti malo kiseloyo wasiki,","poem":1},{"text":"kendo joma kedo kodi duto notieki.","poem":2}]},{"type":"verse","number":10,"content":["Jehova Nyasaye owacho niya,",{"text":"“E odiechiengno anaketh fareseu","poem":1},{"text":"kendo nabanj gecheu mag lweny.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anaketh mier madongo manie pinyu mochiel motegno","poem":1},{"text":"kendo anamuk ohingau.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abiro tieko timbeu mag jwok","poem":1},{"text":"ma ok unuchak ugo gagi kendo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Abiro ketho kido mopa mau","poem":1},{"text":"kod kite mulamo manie dieru.","poem":2},{"text":"Ok unuchak ukulru piny","poem":1},{"text":"ne gik ma lwetu oloso.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abiro muko sirni mag nyasachu ma Ashera mi agol kuomu","poem":1},{"text":"kendo abiro ketho miechu madongo chuth.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Anachul kuor gi mirima","poem":1},{"text":"kod gero kuom ogendini ma osedagi luora.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}