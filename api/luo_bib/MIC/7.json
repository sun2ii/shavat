{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"MIC","translationId":"luo_bib","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"f02b870e0d78aa8c1d7d6887aaa568aee3923c87df57f23831ab160d81b29188","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/luo_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["Midhiero mar Israel"]},{"type":"verse","number":1,"content":[{"text":"Mano kaka midhiero omaka malit!","poem":1},{"lineBreak":true},{"text":"Chutho achalo ngʼat ma hulo","poem":1},{"text":"e puoth mzabibu e ndalo oro.","poem":2},{"text":"Onge olemb mzabibu mochokore ma dacham,","poem":1},{"text":"ngʼope mokwongo chiek ma agombo bende onge.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Joma oluoro Nyasaye bende osetieki morumo e piny;","poem":1},{"text":"ja-ratiro onge kata mana achiel modongʼ.","poem":2},{"text":"Ji duto pondo karito mondo ochwer remo,","poem":1},{"text":"moro ka moro manyo nyawadgi mondo odwodi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lweteni duto ariyo olony e timo richo.","poem":1},{"text":"Jatelo dwaro mich githuon,","poem":2},{"text":"jangʼad bura kawo asoya,","poem":1},{"text":"jogi maroteke chuno ji gi timo gigegi magidwaro,","poem":2},{"lineBreak":true},{"text":"giduto kaachiel giwinjore e wachni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Joma nenore ni longʼo kuomgi; chalo gi kuth oriangʼ.","poem":1},{"text":"Joma ikwano ni odimbore mogik eigi richo moloyo kuth chiedo.","poem":2},{"text":"Odiechieng jorito mau osechopo,","poem":1},{"text":"odiechiengʼ ma Nyasaye limoue.","poem":2},{"lineBreak":true},{"text":"Ma e kinde ma ikeyoue.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kik igen kuom ngʼama odak e bathi","poem":1},{"text":"kata osiepni kik iyiego.","poem":2},{"text":"Wuo kitangʼ kata gi chiegi","poem":1},{"text":"ma ugenorugo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nikech wuowi koro ochayo wuon mare,","poem":1},{"text":"kendo nyako noked kod min mare;","poem":2},{"text":"chi wuowi bende noked gi damare,","poem":1},{"text":"wasik ngʼato nobed joode owuon.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Anto amanyo Jehova Nyasaye gi wangʼa ka an kod geno,","poem":1},{"text":"arito Nyasaye ma Jawarna;","poem":2},{"lineBreak":true},{"text":"kendo Nyasacha biro winja.","poem":2}]},{"type":"heading","content":["Israel biro chungʼ kendo"]},{"type":"verse","number":8,"content":[{"text":"In jasika kik inyiera","poem":1},{"text":"kata obedoni asepodho to abiro chungʼ kendo!","poem":2},{"text":"Kata obedo ni abet e mudho","poem":1},{"text":"to Jehova Nyasaye biro doko lerna.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nikech aseketho e nyim Jehova Nyasaye","poem":1},{"text":"ayie tingʼo mirimbe,","poem":2},{"text":"nyaka chop oket kwayona kare,","poem":1},{"text":"mi oyud ni aonge ketho.","poem":2},{"text":"Obiro kela e ler","poem":1},{"text":"mi ane adierane.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Eka wasika none gima otimore","poem":1},{"text":"mi ginipongʼ gi wichkuot,","poem":2},{"text":"gin mane giwacho niya,","poem":1},{"text":"“Ere Jehova Nyasaye ma Nyasachino?”","poem":2},{"text":"Wangʼa none koselogi;","poem":1},{"text":"kata mana sani ibiro nyon-gi piny,","poem":2},{"lineBreak":true},{"text":"mana kaka chwodho inyono e yore manie dala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Odiechiengʼ migeroe ohinga mare biro chopo,","poem":1},{"text":"en odiechiengʼ manoyarie tongʼni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"E odiechiengʼno ji nobi iri","poem":1},{"text":"koa Asuria kod mier madongo mag Misri,","poem":2},{"text":"koa chakre Misri nyaka Yufrate","poem":1},{"text":"koa bath nam koni nyaka bath nam komachielo,","poem":2},{"lineBreak":true},{"text":"kendo koa got koni nyaka got komachielo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Piny biro dongʼ nono,","poem":1},{"text":"nikech timbe maricho mag ji modak e iye.","poem":2}]},{"type":"heading","content":["Lamo gi pak"]},{"type":"verse","number":14,"content":[{"text":"Kwa jogi gi ludh odunga mari,","poem":1},{"text":"kweth mag girkeni magi,","poem":2},{"text":"modak kendgi ei bungu,","poem":1},{"text":"e dier puothe momewo.","poem":2},{"text":"Wegi gichiem Bashan gi Gilead","poem":1},{"text":"mana kaka ndalo machon.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Mana kaka ndalo mane ua Misri,","poem":1},{"text":"abiro nyisogi timbena madongo miwuoro.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ogendini biro nenogi mi wigi kuodi","poem":1},{"text":"ka osemagi tekogi duto.","poem":2},{"text":"Giniket lwetgi e dhogi","poem":1},{"text":"kendo itgi biro dino.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Gibiro nangʼo lowo ka thuol,","poem":1},{"text":"ka le malak gi bund-igi e buru.","poem":2},{"text":"Gibiro wuok ka gia e kuondegi mag pondo ka gitetni.","poem":1},{"text":"Gibiro lokore gidok ir Jehova Nyasaye, ma Nyasachwa,","poem":2},{"lineBreak":true},{"text":"ka giluor kendo un bende gibiro luorou.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"En Nyasaye mane machalo kodi","poem":1},{"text":"ma ngʼwono ne joge modongʼ,","poem":2},{"lineBreak":true},{"text":"kendo weyonegi richogi?","poem":2},{"text":"Iyi ok wangʼ nyaka chiengʼ,","poem":1},{"text":"to imor mar kecho jogi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ibiro kechowa kendo,","poem":1},{"text":"ibiro nyono richowa e tiendi,","poem":2},{"lineBreak":true},{"text":"kendo idir kethruokwa duto e bwo nam.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ibiro bedo ja-adiera ne Jakobo","poem":1},{"text":"kendo ibiro kecho Ibrahim,","poem":2},{"text":"kaka ne isingori kikwongʼori ne kwerewa,","poem":1},{"text":"e ndalo machon.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}