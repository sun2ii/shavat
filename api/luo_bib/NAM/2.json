{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"NAM","translationId":"luo_bib","name":"Nahum","commonName":"Nahum","title":"Nahum","order":34,"numberOfChapters":3,"sha256":"5073b4c8b01978c457a1a651cd275b239ef489ad2c89a661b3e2c77b84d9b527","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/luo_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Nineve biro podho"]},{"type":"verse","number":1,"content":[{"text":"Ngʼat mabiro monji ochomi,","poem":1},{"text":"yaye Nineve, omiyo rit dala mochiel motegno,","poem":2},{"lineBreak":true},{"text":"rit yoreni,","poem":2},{"lineBreak":true},{"text":"bed gi ikruok maber,","poem":2},{"lineBreak":true},{"text":"kuom tekoni duto!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Jehova Nyasaye biro dwoko duongʼ mar Jakobo,","poem":1},{"text":"mana ka duongʼ mar Israel,","poem":2},{"text":"kata obedo ni joma omonje osekethe","poem":1},{"text":"kendo oseketho puothegi mag mzabibu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Okumba mag jolweny osebedo makwar ka remo;","poem":1},{"text":"kendo lewni ma girwakorego bende kwar.","poem":2},{"text":"Chuma manie ewi gechegi mil","poem":1},{"text":"ka giikore ne chiengʼ lweny;","poem":2},{"lineBreak":true},{"text":"tongegi opiag mabith kendo milni ka gikedogo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Geche powore e yore mag dala,","poem":1},{"text":"ka giringo koni gi koni e tunge mag dala.","poem":2},{"text":"Gichalo gi rameny maliel mager,","poem":1},{"text":"ka gipiachore ka mil polo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Oluongo jolweny mage moyiero,","poem":1},{"text":"to gichwanyore ka gidhi.","poem":2},{"text":"Giringo ka gidhi e ohinga mar dala;","poem":1},{"text":"ka gigengʼore gi okumba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ohinga mane gigengʼogo pi madonjo e dala ruoth omukore,","poem":1},{"text":"bende od ruoth ogore piny.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Osegol Chik ni dala maduongʼ","poem":1},{"text":"nyaka maki ma ter e piny ma wendo.","poem":2},{"text":"Wasumbinigi ma nyiri ywagore ka akuche","poem":1},{"text":"kendo ka gidwongʼo korgi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nineve chalo dago,","poem":1},{"text":"kendo pige mol kadhi.","poem":2},{"text":"Giywak kagiwacho niya, “Chungʼ! Chungʼ!”","poem":1},{"text":"to onge ngʼama lokore duogo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yakuru fedha!","poem":1},{"text":"Yakuru dhahabu!","poem":2},{"text":"Mwandugi ngʼeny mokadho,","poem":1},{"text":"gin mwandu mogol kuonde kenogi duto.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Odongʼ nono, omaye gik moko duto,","poem":1},{"text":"bende olonye modongʼ duk.","poem":2},{"text":"Kibaji ogoyo chunygi,","poem":1},{"text":"bende chongegi onyosere,","poem":2},{"text":"kendo dendgi tetni","poem":1},{"text":"ka ngʼato ka ngʼato wangʼe ojowore.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Koro to ere bur sibuor","poem":1},{"text":"kama ne gipidhoe nyithindgi,","poem":2},{"text":"kama sibuor madichwo gi sibuor madhako nodhiye,","poem":1},{"text":"ka nyithind sibuochego onge gi gima ginyalo luoro?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sibuor ne yangʼo le moromo nyithinde","poem":1},{"text":"kendo ne gideyo le ma gichamo gi nyawadgi,","poem":2},{"text":"ka opongʼo kar kano chiembe","poem":1},{"text":"kod kuonde dakne gi gik monegi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Jehova Nyasaye Maratego wacho niya,","poem":1},{"text":"“An gi sigu kodu.","poem":2},{"text":"Abiro wangʼo gecheu mag lweny gi mach mawuog iro","poem":1},{"text":"kendo ligangla biro tieko sibuoche matindo maroteke.","poem":2},{"lineBreak":true},{"text":"Kata ringregi motho ok anawenu e piny.","poem":2},{"text":"Dwond jooteu","poem":1},{"text":"ok nowinj kendo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}