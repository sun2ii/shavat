{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"OBA","translationId":"luo_bib","name":"Obadia","commonName":"Obadia","title":"Obadia","order":31,"numberOfChapters":1,"sha256":"010be4fe20a8b45ad4920e0e46b9929534e4c573e717fcedd02b2d9a4d192cbd","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/OBA/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/luo_bib/OBA/1.json","totalNumberOfVerses":21},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Fweny mag Obadia.",{"lineBreak":true},{"lineBreak":true},"Magi e weche ma Jehova Nyasaye Manyalo Gik Moko Duto wacho kuom Edom.",{"text":"Wasewinjo wach; koa kuom Jehova Nyasaye.","poem":1},{"text":"Jaote oseor ir ogendini mondo owach niya,","poem":2},{"text":"“Chunguru, wadhi waked kode.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“To neuru, abiro miyo udok matin e kind ogendini,","poem":1},{"text":"bende ibiro chau ahinya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sunga manie chunyu osewuondou,","poem":1},{"text":"un mudak e kind lwendni,","poem":2},{"lineBreak":true},{"text":"kendo ugero miechu kuonde motingʼore,","poem":2},{"text":"un ma uwacho kendu niya,","poem":1},{"text":"‘En ngʼa manyalo dwokowa piny?’","poem":2}]},{"type":"verse","number":4,"content":[{"text":"To kata obedo ni unyalo fuyo malo mabor ka ongo,","poem":1},{"text":"kendo ugero kar daku maber e kind sulwe malo,","poem":2},{"text":"to koa kuno abiro dwokou piny,”","poem":1},{"text":"Jehova Nyasaye owacho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Ka jokwoge obironu,","poem":1},{"text":"jomecho mag otieno,","poem":2},{"text":"to mano kaka masira malich ritou,","poem":1},{"text":"donge gibiro kwalo mwandu magu kaka ginyalo?","poem":2},{"text":"Ka jopon mzabibu obiro iru","poem":1},{"text":"donge digiwe olemb mzabibu matin?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"To mano kaka Esau ibiro choko gigene","poem":1},{"text":"kendo mwandune mopandi noyaki!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ogendini ma uriworugo biro sembou nyaka giko mar tongʼ;","poem":1},{"text":"osiepeu biro wuondou ma lowu;","poem":2},{"text":"kendo joma chamo chiembu biro ketonu obadho,","poem":1},{"text":"to ok unufweny.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jehova Nyasaye wacho niya,","poem":1},{"text":"“Odiechiengʼno donge abiro tieko jorieko mag Edom,","poem":2},{"lineBreak":true},{"text":"jogo man-gi winjo e gode mag Esau?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jolweny magi, yaye Teman,","poem":1},{"text":"biro bedo kod bwok kendo ji duto modak,","poem":2},{"lineBreak":true},{"text":"e gode mag Esau ibiro negi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nikech lweny mane utimone owadu Jakobo","poem":1},{"text":"unubed gi wichkuot;","poem":2},{"lineBreak":true},{"text":"mi nokethu nyaka chiengʼ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Chiengʼ mane ichungʼ tenge","poem":1},{"text":"ka joma moko donjo e dhorangeyene,","poem":2},{"text":"kendo gigoyo ombulu","poem":1},{"text":"ne Jerusalem,","poem":2},{"lineBreak":true},{"text":"ne ichal mana kodgi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ne ok onego ungʼigi kod achaya","poem":1},{"text":"chiengʼ masichgi,","poem":2},{"text":"bende ne ok onego ubed mamor","poem":1},{"text":"chiengʼ mane ikethoe Juda,","poem":2},{"text":"kata bedo gi ngʼayi","poem":1},{"text":"chiengʼ chandruokgi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ne ok onego udonj e dhorangeye mag joga","poem":1},{"text":"chiengʼ mane masira omakogi,","poem":2},{"text":"kata ngʼiyogi gachaya e thagruokgi,","poem":1},{"text":"kata kawo mwandugi,","poem":2},{"text":"e chiengʼ thagruokgi","poem":1},{"text":"gi chiengʼ masichegi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ne ok onego uchungʼ e akek yore,","poem":1},{"text":"ka ugengʼone jogegi maringo,","poem":2},{"text":"kendo ne ok onego uchiw jogegi motony e lwet wasikgi","poem":1},{"text":"chiengʼ chandruokgi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Chiengʼ Jehova Nyasaye okayo machiegni","poem":1},{"text":"ne ogendini duto,","poem":2},{"text":"bende kaka isetimo e kaka notimni,","poem":1},{"text":"timbeni nodwogi e wiyi iwuon.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mana kaka ne umer ewi goda maler","poem":1},{"text":"e kaka ogendini duto, biro metho ametha,","poem":2},{"text":"ginimeth ametha","poem":1},{"text":"ma ginichal joma onge.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"To ewi got mar Sayun tony nobedie,","poem":1},{"text":"mi enobed kama ler,","poem":2},{"text":"kendo od Jakobo","poem":1},{"text":"nokaw girkeni mage.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Od Jakobo nobed mach","poem":1},{"text":"kendo od Josef mach nokaknie,","poem":2},{"text":"od Esau nobed chuk mach,","poem":1},{"text":"mi ginimoke moliel pep,","poem":2},{"text":"onge ngʼat ma notony","poem":1},{"text":"koa e od Esau.”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye osewacho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Jo-Negev nokaw","poem":1},{"text":"piny gode mag Esau,","poem":2},{"text":"kendo joma odak e tiend gode","poem":1},{"text":"nokaw piny jo-Filistia,","poem":2},{"text":"ginikaw nyaka piny Efraim gi Samaria,","poem":1},{"text":"eka jo-Benjamin nokaw piny Gilead.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"To oganda mar jo-Israel mane oter e twech e piny Kanaan,","poem":1},{"text":"nokaw pinyno nyaka chop Zarefath,","poem":2},{"text":"kendo jo-Jerusalem manie twech,","poem":1},{"text":"e piny Sefarad biro kawo miech Negev.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Jores noidhi ewi got mar Sayun,","poem":1},{"text":"mi ginibed kod loch ewi gode mag Esau,","poem":2},{"lineBreak":true},{"text":"kendo pinyruoth duto nobed e lwet Jehova Nyasaye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/OBA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/AMO/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}