{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PRO","translationId":"luo_bib","name":"Ngeche","commonName":"Ngeche","title":"Ngeche","order":20,"numberOfChapters":31,"sha256":"0236fb14442f33bc6e83624216fca1bfd44ab7de50a3c7dafc7af5794b6fd759","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/luo_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":23,"content":[{"type":"heading","content":["Wach mar abiriyo"]},{"type":"verse","number":1,"content":[{"text":"Ka ibedo mondo ichiem gi ruoth,","poem":1},{"text":"non maber gima ni e nyimi,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ka in jawuoro to dimbri","poem":1},{"text":"nono to onyalo keto pala e dwondi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kik igomb chiembe mamit,","poem":1},{"text":"nimar chiemono en mar wuondruok.","poem":2}]},{"type":"heading","content":["Wach mar aboro"]},{"type":"verse","number":4,"content":[{"text":"Kik iwe tich bari ndasi ni mondo ibed ja-mwandu,","poem":1},{"text":"bed gi rieko mondo iritri.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngʼi mwandu mana matin nono, to bangʼe gidhi,","poem":1},{"text":"nimar adiera gibiro bedo gi bwombe,","poem":2},{"lineBreak":true},{"text":"kendo gifu gidhi e kor polo ka ongo.","poem":2}]},{"type":"heading","content":["Wach mar ochiko"]},{"type":"verse","number":6,"content":[{"text":"Kik icham chiemb jagwondo,","poem":1},{"text":"kik igomb chiembe mamit,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"nimar en ngʼat","poem":1},{"text":"mosiko paro nengo mochul.","poem":2},{"text":"Owachoni niya, “Chiem kendo methi,”","poem":1},{"text":"to chunye ok ni kodi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ibiro ngʼogo mano matin mane ichamo","poem":1},{"text":"kendo ibiro bedo ni iketho kindeni kuom pwoch mipuoyego.","poem":2}]},{"type":"heading","content":["Wach mar apar"]},{"type":"verse","number":9,"content":[{"text":"Kik iwuo ne ngʼat mofuwo,","poem":1},{"text":"nikech obiro chayo rieko mag wechegi.","poem":2}]},{"type":"heading","content":["Wach mar apar gachiel"]},{"type":"verse","number":10,"content":[{"text":"Kik igol kidi mar kiewo machon,","poem":1},{"text":"kata ima nyithindo maonge wuone puothegi;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"nimar Jal moritogi en ratego;","poem":1},{"text":"obiro chwakogi e kindi kodgi.","poem":2}]},{"type":"heading","content":["Wach mar apar gariyo"]},{"type":"verse","number":12,"content":[{"text":"Ket chunyi ne puonj","poem":1},{"text":"to iti ne weche mag ngʼeyo.","poem":2}]},{"type":"heading","content":["Wach mar apar gadek"]},{"type":"verse","number":13,"content":[{"text":"Kik itamri kumo nyathi;","poem":1},{"text":"nimar chwat ok nyal nege.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kikumo nyathi kod kede","poem":1},{"text":"to obiro reso chunye aa e tho.","poem":2}]},{"type":"heading","content":["Wach mar apar gangʼwen"]},{"type":"verse","number":15,"content":[{"text":"Wuoda, ka chunyi riek,","poem":1},{"text":"eka chunya biro bedo mamor,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"chunya ma iye nobed mamor","poem":1},{"text":"ka lewi wacho gima nikare.","poem":2}]},{"type":"heading","content":["Wach mar apar gabich"]},{"type":"verse","number":17,"content":[{"text":"Kik ibed gi nyiego e chunyi nikech joricho;","poem":1},{"text":"to kinde duto bedi gi dwaro mar luoro Jehova Nyasaye moloyo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Adier, ka itimo kamano to inibed gi geno e ndalo mabiro,","poem":1},{"text":"kendo genoni ok nongʼad oko.","poem":2}]},{"type":"heading","content":["Wach mar apar gauchiel"]},{"type":"verse","number":19,"content":[{"text":"Wuoda, winja, eka inibed mariek,","poem":1},{"text":"kendo ket chunyi e yo moriere tir.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kik iriwri gi jogo ma madho kongʼo mangʼeny","poem":1},{"text":"kata jowuoro mohero ringʼo,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"nimar jomer kod jowuoro bedo jochan,","poem":1},{"text":"kendo nongʼno rwakogi gi lewni moti.","poem":2}]},{"type":"heading","content":["Wach mar apar gabiriyo"]},{"type":"verse","number":22,"content":[{"text":"Winj wuonu, nikech en ema nonywoli,","poem":1},{"text":"kendo kik icha minu ka oti.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Adiera gi rieko gi puonjruok kod ngʼeyo tiend wach ema nyaka iyudi,","poem":1},{"text":"kata dabed ni ingʼiewogi gi nengo matek.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Wuon ngʼat makare nigi mor maduongʼ;","poem":1},{"text":"ngʼatno man-gi wuowi mariek obedo mamor kode.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mad wuonu gi minu bed mamor;","poem":1},{"text":"mad minu mane onywoli bed gi ilo.","poem":2}]},{"type":"heading","content":["Wach mar apar gaboro"]},{"type":"verse","number":26,"content":[{"text":"Wuoda, miya chunyi, kendo ket wengegi orit yorena,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"nimar dhako ma jachode en bur matut,","poem":1},{"text":"to dhako mabayo en soko madiny.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ka jamecho obuto korito,","poem":1},{"text":"to omedo keto ji ma ok jo-adiera mangʼeny e kind ji.","poem":2}]},{"type":"heading","content":["Wach mar apar gochiko"]},{"type":"verse","number":29,"content":[{"text":"En ngʼa man-gi masira?","poem":1},{"text":"En ngʼa man-gi lit?","poem":2},{"text":"En ngʼa man-gi lweny?","poem":1},{"text":"En ngʼa man-gi ngʼur?","poem":2},{"text":"En ngʼa man-gi adhonde","poem":1},{"text":"ma ok owinjore?","poem":2},{"text":"En ngʼa man-gi wangʼ makwar","poem":1},{"text":"motimo remo?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Jogo madeko oko ka kongʼo,","poem":1},{"text":"madhi mondo gibil kongʼo mokik mayoreyore.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kik ingʼi kongʼo kochiek mowalo,","poem":1},{"text":"ka obabni e kikombe,","poem":2},{"lineBreak":true},{"text":"ka omadhore mos kolor piny!","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Bangʼe to okecho ka thuol","poem":1},{"text":"kendo oketo kwiri kaka fu.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Wengeni biro neno gik mayoreyore","poem":1},{"text":"to pachi paro gik morundore.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ibiro chalo ngʼat ma nindo e nam mar apaka matek,","poem":1},{"text":"ka inindo ewi apaka.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ibiro wacho niya, “Gigoya, to ok ahinyra!","poem":1},{"text":"Gigoya, to ok awinji!","poem":2},{"text":"Karangʼo ma abiro chiewoe","poem":1},{"text":"mondo adog ameth kendo?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}