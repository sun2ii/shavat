{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["Zaburi mar Daudi."]},{"type":"verse","number":1,"content":[{"text":"Abiro wer nikech herani gi berni;","poem":1},{"text":"in ema abiro weroni wend pak, yaye Jehova Nyasaye.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abiro neno ni aritora mondo ngimana obed malongʼo chuth,","poem":1},{"text":"ibiro biro ira karangʼo?","poem":2},{"lineBreak":true},{"text":"Abiro dak e oda","poem":1},{"text":"gi chuny malongʼo chuth.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ok abi yie neno","poem":1},{"text":"gimoro amora mochido gi wengena.","poem":2},{"lineBreak":true},{"text":"Achayo timbe joma chunygi richo;","poem":1},{"text":"gik maricho ok adwar winjo kata gi ita.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ok anabed gi paro mochido;","poem":1},{"text":"bende kata paro mar timo richo ok anapar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ngʼato angʼata makuodho nyawadgi lingʼ-lingʼ","poem":1},{"text":"abiro kwero mi lingʼ;","poem":2},{"text":"ngʼato angʼata ma wangʼe tek kendo ma sungore gie chunye,","poem":1},{"text":"ok anyal betgo amingʼa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Joma jo-adiera ema abiro keto wengena kuomgi;","poem":1},{"text":"gin ema abiro yie dak kodgi;","poem":2},{"text":"ngʼat ma wuodhe oriere tir","poem":1},{"text":"ema biro tiyona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ok abi yiene ngʼama ohero miriambo","poem":1},{"text":"mondo odag e oda;","poem":2},{"text":"ngʼat moro amora mawacho miriambo","poem":1},{"text":"ok nochungʼ e nyima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Okinyi kokinyi abiro tieko","poem":1},{"text":"joma timbegi richo modak e piny.","poem":2},{"text":"Abiro nego ngʼato angʼata matimo richo","poem":1},{"text":"ka agologi e dala mar Jehova Nyasaye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}