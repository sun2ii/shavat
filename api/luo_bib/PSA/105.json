{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":105,"content":[{"type":"verse","number":1,"content":[{"text":"Pakuru Jehova Nyasaye, luonguru nyinge;","poem":1},{"text":"landuru ne ogendini duto gima osetimo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Werneuru, pakeuru gi wende;","poem":1},{"text":"nyisuru kuom tijene duto miwuoro.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nyinge maler nigi duongʼ;","poem":1},{"text":"chuny joma manyo Jehova Nyasaye mondo obed mamor.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ranguru Jehova Nyasaye gi tekone;","poem":1},{"text":"dwaruru wangʼe kinde duto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Paruru gik miwuoro mosetimo,","poem":1},{"text":"honni mage kod buche mosengʼado,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"yaye un nyikwa Ibrahim jatichne,","poem":1},{"text":"yaye yawuot Jakobo joge moyiero.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"En e Jehova Nyasaye ma Nyasachwa;","poem":1},{"text":"buchene ni e piny duto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Oparo singruokne nyaka chiengʼ,","poem":1},{"text":"weche mane osingo e tienge tara,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"singruok mane otimo gi Ibrahim,","poem":1},{"text":"Muma mane okwongʼorego ni Isaka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne ogure ne Jakobo kaka chik,","poem":1},{"text":"kendo nogure ni Israel kaka singruok mochwere, kowacho ni,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Anamiyi piny Kanaan","poem":1},{"text":"kaka girkeni mari.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kane pod gin ji manok e kar rombgi,","poem":1},{"text":"ne ginok ahinya kendo ne gin welo e pinyno,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ne giwuotho e kind ogendini mopogore,","poem":1},{"text":"ka gidhi e pinyruodhi mopogore opogore.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ne ok oyie mondo ngʼato osandgi;","poem":1},{"text":"nokwero ruodhi kowachonegi niya,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Kik umul joga ma awiro;","poem":1},{"text":"kik uhiny jonabi maga.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ne okelo kech e piny","poem":1},{"text":"kendo noketho yore duto mane giyudogo chiemo;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"kendo nooro ngʼato otelonegi,","poem":1},{"text":"ngʼatno ne en Josef mane oloki kaka misumba.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ne giridho tiendene gi arungu mochuoye chuma,","poem":1},{"text":"kendo ne giridho ngʼute gi chumbe,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"nyaka nochopo kinde ma gik mane okoro notimore,","poem":1},{"text":"nyaka wach Jehova Nyasaye nochopo kare.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ruodh Misri nooro wach mi nogonye","poem":1},{"text":"jatend ji nogonye thuolo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nokete ruodh ode,","poem":1},{"text":"manorito gik moko duto mane en-go,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"mondo en ema ne otieg jotende kaka ohero","poem":1},{"text":"kendo opuonj jodonge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Bangʼe Israel duto nobiro Misri;","poem":1},{"text":"Jakobo nodoko jadak e piny Ham.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Jehova Nyasaye nomiyo joge onya ahinya;","poem":1},{"text":"nomiyo gibedo mathoth ma wasikgi ne ok nyal nyalogi,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"wasikgi ma noloko chunygi mondo ocha joge,","poem":1},{"text":"kendo noketo chunye mar timo ne jotichne marach.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nooro Musa jatichne,","poem":1},{"text":"gi Harun, ngʼat mane oseyiero.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Negitimo ranyisi mag honni e diergi,","poem":1},{"text":"ee, negitimo timbene miwuoro e piny Ham.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Nooro mudho mi nomiyo piny olil","poem":1},{"text":"nimar donge ne gisengʼanyo ne wechene?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Noloko pigegi remo,","poem":1},{"text":"mi nomiyo rechgi otho.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ogwende nosieko mopongʼo pinygi,","poem":1},{"text":"kendo negidonjo nyaka ei ute nindo mag ruodhigi.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Nowuoyo, mi pumbi mag lwangʼni nosieko,","poem":1},{"text":"kendo kikun nopongʼo pinygi.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Nomiyo kodhi olokore pe","poem":1},{"text":"kendo mil polo nokwako pinygi;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"nogoyo yiendegi mag mzabibu gi ngʼowu piny","poem":1},{"text":"kendo nolwero yiende mane ni e pinygi.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Nowuoyo, mi bonyo nosieko,","poem":1},{"text":"ongogo mokalo akwana;","poem":2}]},{"type":"verse","number":35,"content":[{"text":"negichamo gimoro amora mane loth","poem":1},{"text":"e pinygi koda ka chambgi mane gipidho e puothegi.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Bangʼe nonego nyithindo makayo duto mane ni e pinygi,","poem":1},{"text":"kodhi mokwongo duto mane gihango nywolo.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Nogolo Israel, kogangore gi fedha kod dhahabu,","poem":1},{"text":"kendo onge ngʼama nodongʼ chien kuom dhout Israel duto.","poem":2}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Misri ne mor kane giwuok,","poem":2},{"lineBreak":true},{"text":"nikech mbi mar jo-Israel nosegore kuomgi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Noumogi gi boche polo kaka raum,","poem":1},{"text":"kendo mach nochiwonegi ler gotieno.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Kane gikwaye, to nokelonegi aluru","poem":1},{"text":"kendo noyiengʼogi gi makati mar polo.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Noyawo lwanda, mi pi nowuok gi teko;","poem":1},{"text":"kendo pigno nomol ka aora mamol e piny motwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":42,"content":[{"text":"Nimar noparo singruokne maler","poem":1},{"text":"mane omiyo Ibrahim jatichne.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Nogolo joge gi ilo,","poem":1},{"text":"adier, nomiyo joge moyier owuok kakok gi mor;","poem":2}]},{"type":"verse","number":44,"content":[{"text":"nomiyogi pinje mag ogendini,","poem":1},{"text":"kendo gik ma jomoko nono nochandore ka loso nodoko girkeni magi,","poem":2}]},{"type":"verse","number":45,"content":[{"text":"mondo omi gilu yorene","poem":1},{"text":"kendo girit chikene.","poem":2},{"lineBreak":true},{"text":"Pak ne Jehova Nyasaye!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":45}