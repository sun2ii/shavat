{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["Kuom jatend wer. Zaburi mar Daudi."]},{"type":"verse","number":1,"content":[{"text":"Jehova Nyasaye ema ageno kuome.","poem":1},{"text":"Koro ere kaka duwachna ni:","poem":2},{"lineBreak":true},{"text":"“Ringi ka winyo nyaka ewi got mari.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nikech joma timbegi richo osechako ywayo atungegi;","poem":1},{"text":"gisechano asernigi e tonde mag atungʼ,","poem":2},{"text":"mondo gichielgo","poem":1},{"text":"joma jo-adiera e chunygi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ka mise iketho,","poem":1},{"text":"to en angʼo ma joma kare ditim?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Jehova Nyasaye ni e hekalu mare maler;","poem":1},{"text":"Jehova Nyasaye ni e kom duongʼ mare manie polo.","poem":2},{"text":"Orango timbe yawuot ji;","poem":1},{"text":"wengene nonogi matut.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Jehova Nyasaye nono joma kare,","poem":1},{"text":"to joma timbegi richo kod joma ohero mahundu,","poem":2},{"lineBreak":true},{"text":"to chunye ochayo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Obiro chwero","poem":1},{"text":"mach maliel mager kod salfa kuom joma timbegi richo;","poem":2},{"lineBreak":true},{"text":"yamo maliet ha matwoyo gik moko, biro kudhogi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nikech Jehova Nyasaye en Ngʼama Kare,","poem":1},{"text":"kendo ohero adiera;","poem":2},{"lineBreak":true},{"text":"joma timbegi oriere biro neno wangʼe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}