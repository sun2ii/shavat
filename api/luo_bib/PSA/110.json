{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["Zaburi mar Daudi."]},{"type":"verse","number":1,"content":[{"text":"Jehova Nyasaye nowachone Ruodha kama:","poem":1},{"text":"“Bed e bada korachwich,","poem":2},{"text":"nyaka chop aket wasiki","poem":1},{"text":"e bwo tiendi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Jehova Nyasaye biro yaro lochni chakre Sayun;","poem":1},{"text":"ibiro bedo gi loch e dier wasiki.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jokedo magi biro bedo gi chuny moikore;","poem":1},{"text":"gibiro riedo gokinyi kogwen gi duongʼ mamalo,","poem":2},{"text":"kendo tekri nomedre odiechiengʼ kodiechiengʼ","poem":1},{"text":"mana ka tho momoko e lum gokinyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Jehova Nyasaye osekwongʼore","poem":1},{"text":"kendo ok nolok pache,","poem":2},{"text":"osesingore niya, “In jadolo nyaka chiengʼ,","poem":1},{"text":"koluwo kit dolo mar Melkizedek.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Jehova Nyasaye ni e badi ma korachwich","poem":1},{"text":"obiro loyo ruodhi chiengʼ ma mirimbe otuk.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Obiro ngʼado bura ne ogendini,","poem":1},{"text":"mi opiel joma otho achana-achana kotieko jotelo duto mag piny.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Obiro modho e aora matin manie bath yo,","poem":1},{"text":"emomiyo noyud teko mi otingʼ wiye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}