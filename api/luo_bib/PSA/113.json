{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Opak Jehova Nyasaye!","poem":1},{"lineBreak":true},{"text":"Pakuru Jehova Nyasaye, yaye un jotichne,","poem":1},{"text":"pakuru nying Jehova Nyasaye.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nying Jehova Nyasaye mondo opaki,","poem":1},{"text":"sani kendo nyaka chiengʼ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nying Jehova Nyasaye onego opaki,","poem":1},{"text":"chakre kuma chiengʼ wuokie,","poem":2},{"lineBreak":true},{"text":"nyaka kuma opodhoe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Jehova Nyasaye nigi duongʼ moyombo ogendini duto,","poem":1},{"text":"kendo duongʼne maler oyombo polo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"En ngʼa machalo gi Jehova Nyasaye ma Nyasachwa,","poem":1},{"text":"Jal mobet e kom loch kuma bor,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"kendo makulore piny","poem":1},{"text":"mondo ongʼi polo gi piny?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Otingʼo joma odhier malo kogolo piny e lowo;","poem":1},{"text":"adier, ogolo joma ochando e pidh buru,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"kendo oketogi gibet kaachiel gi ruodhi,","poem":1},{"text":"mi kwan-gi kaachiel gi jotend jogi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Omiyo dhako ma migumba bedo gi ode","poem":1},{"text":"mi obed miyo mamor man-gi nyithinde.","poem":2},{"lineBreak":true},{"text":"Opak Jehova Nyasaye!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}