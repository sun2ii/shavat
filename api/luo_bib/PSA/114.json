{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Kane jo-Israel owuok Misri,","poem":1},{"text":"ee, kane joka Jakobo owuok e kind joma wacho dhok mopogore,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Juda nodoko kama ler mar lemo mar Nyasaye,","poem":1},{"text":"kendo Israel nobedo mwandune owuon.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nam nonenogi mi oa gi ngʼwech,","poem":1},{"text":"kendo Jordan ne odar oweyonigi piny,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"gode nolengʼore ka imbe,","poem":1},{"text":"to thuche to nochikore ka nyirombe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Angʼo momiyo ne ia gi ngʼwech, yaye nam?","poem":1},{"text":"Yaye Jordan, ne idar iweyonegi piny nangʼo?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"To un gode to ne ulengʼoru ka imbe nangʼo?","poem":1},{"text":"Koso thuche to nochikore ka nyirombe nikech angʼo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yaye piny, yiengni ka Ruoth Nyasaye ni machiegni kodi,","poem":1},{"text":"yiengni e nyim Nyasach Jakobo,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nyasaye mane omiyo lwanda olokore pi mogudore,","poem":1},{"text":"kendo mane omiyo lwanda matek olokore sokni mag pi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}