{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":119,"content":[{"type":"verse","number":1,"content":[{"text":"Ogwedh joma yoregi ler,","poem":1},{"text":"mawuotho koluwore gi chik Jehova Nyasaye.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ogwedh joma orito chikene","poem":1},{"text":"kendo ma manye gi chunygi duto.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gin joma ok tim gimoro amora marach,","poem":1},{"text":"to gisiko ka giwuotho e yorene.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iseguro chikeni","poem":1},{"text":"ni nyaka lu kaka gin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yaye, mad ne bed ni yorena ogurore","poem":1},{"text":"e luwo chikeni!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dine ok aneno wichkuot","poem":1},{"text":"nikech aketo chunya e chikeni duto.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kaka amedo puonjora chikeni makare","poem":1},{"text":"e kaka abiro dhi nyime gi paki gi chuny moriere tir.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abiro rito chikeni;","poem":1},{"lineBreak":true},{"text":"omiyo kik ijwangʼa chuth.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Ere kaka ngʼama pod tin nyalo rito ngimane mondo osik ka oler?","poem":1},{"text":"Onyalo rito mana ka odak moluwore gi wachni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Amanyi gi chunya duto;","poem":1},{"text":"omiyo kik iwe abar awe chikeni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Asekano wachni ei chunya","poem":1},{"text":"mondo kik akethi e nyimi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yaye Jehova Nyasaye, mad iyud pak;","poem":1},{"text":"yie ipuonja chikeni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Aolo gi dhoga chike duto","poem":1},{"text":"mowuok e dhogi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Luwo chikeni mora","poem":1},{"text":"mana kaka ngʼato bedo mamor kuom mwandu duto.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Abiro paro matut kuom chikeni","poem":1},{"text":"kendo abiro tego wengena e yoreni.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Amor ahinya gi chikeni;","poem":1},{"text":"ok abi jwangʼo wachni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tim maber ne jatichni,","poem":1},{"text":"eka abiro bedo mangima kendo abiro rito chikeni.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yaw wengena mondo eka ane","poem":1},{"text":"gik mabeyo miwuoro manie chikeni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"An mana wendo e piny","poem":1},{"text":"omiyo kik ipandna chikeni.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Chunya opongʼ kod siso","poem":1},{"text":"mar chikeni kinde duto.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ikwero joma ochayo ji, ma gin joma okwongʼ,","poem":1},{"text":"kendo gin joma osebaro oweyo chikeni.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Gol kuoma ajara gi achaya","poem":1},{"text":"nimar arito chikeni.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kata obedo ni jotelo chokorena kendo giyanya,","poem":1},{"text":"to jatichni pod biro mana paro matut kuom chikeni.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Chikeni e morna;","poem":1},{"text":"gin e jongʼad rieko maga.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Osepiela ei lowo piny;","poem":1},{"text":"omiyo rit ngimana kaluwore gi wachni.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kane ahulo yorena to ne idwoka;","poem":1},{"lineBreak":true},{"text":"puonja chikeni.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mi awinj tiend gik ma chikegi puonjo;","poem":1},{"text":"eka abiro paro matut kuom timbegi miwuoro.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kuyo onyoso chunya,","poem":1},{"text":"omiyo meda teko kaluwore gi wachni.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Gengʼa kik adonji e yore mag miriambo,","poem":1},{"lineBreak":true},{"text":"kendo ngʼwon-na ka ipuonja chikni.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Aseyiero yor adiera;","poem":1},{"text":"kendo aseketo chunya e chikeni.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Amako chikeni matek, yaye Jehova Nyasaye,","poem":1},{"text":"omiyo kik iwe ane wichkuot.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Yor chikeni ema aringe,","poem":1},{"text":"nimar isegonyo chunya.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Puonja mondo alu yoreni, yaye Jehova Nyasaye,","poem":1},{"text":"eka abiro ritogi nyaka giko.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Miya rieko mondo eka arit chikeni","poem":1},{"text":"kendo atim kaka owacho gi chunya duto.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Taya e yo mar chikeni,","poem":1},{"text":"nimar kanyo ema ayudoe mor.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ket chunya mondo oher chikeni,","poem":1},{"text":"to ok dwaro maga mag wuoro.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Gol wangʼa oko kuom gik manono;","poem":1},{"text":"rit ngimana kaluwore gi wachni.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Chop singruok mari ne jatichni,","poem":1},{"text":"mondo ji oluori.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Golna achaya ma aluoro,","poem":1},{"text":"nimar chikeni beyo.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Mano kaka ahero yoreni!","poem":1},{"text":"Rit ngimana e timni makare.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Mad herani ma ok rem bina, yaye Jehova Nyasaye,","poem":1},{"text":"mad warruokni bina kaluwore gi singruokni.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Eka abiro dwokora gi ngʼat ma timona anyali,","poem":1},{"text":"nimar ageno kuom wachni.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Kik igol wach mar adiera e dhoga chuth,","poem":1},{"text":"nimar aseketo genona e chikeni.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Abiro rito chikeni ndalo duto,","poem":1},{"text":"manyaka chiengʼ.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Abiro wuotho ka an thuolo,","poem":1},{"text":"nimar chikeni ema asebedo ka amanyo.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Abiro wuoyo kuom chikeni e nyim ruodhi","poem":1},{"text":"kendo wiya ok bi kuot,","poem":2}]},{"type":"verse","number":47,"content":[{"text":"nimar amor gi chikeni","poem":1},{"text":"nikech aherogi.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Atingʼo bedena malo ne chikeni ma ahero","poem":1},{"text":"kendo asiko aparo matut kuom yoreni.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Par wachni mane iwacho ne jatichni,","poem":1},{"text":"nimar isemiya geno.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Gima hoya e chandruokna en ma:","poem":1},{"text":"ni singruokni rito ngimana.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Joma ochayo ji jara ma ok obadhogi","poem":1},{"text":"to kata kamano ok alokra awe chikeni.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Asiko aparo chikeni mosebedo ka nitie nyaka nene, yaye Jehova Nyasaye,","poem":1},{"text":"kendo ayudo hoch kuomgi.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Mirima mager omaka nikech joma timbegi richo,","poem":1},{"text":"mosejwangʼo chikeni.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Chikeni e thoro mar wenda,","poem":1},{"text":"kamoro amora ma abwore.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Aparo nyingi gotieno, yaye Jehova Nyasaye,","poem":1},{"text":"kendo abiro rito chikni.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Ma osebedo timna,","poem":1},{"text":"nimar asebedo ka arito yoreni.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"In e pokna, yaye Jehova Nyasaye;","poem":1},{"text":"asesingora ni abiro rito chikeni.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Asemanyo wangʼi gi chunya duto;","poem":1},{"text":"ngʼwon-na kaluwore gi singruok mari.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Asenono yorena","poem":1},{"text":"kendo asechiko yorena mondo oluw yoreni.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Abiro reto kendo ok abi deko","poem":1},{"text":"mar rito chikeni.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"Kata obedo ni joma timbegi richo orida gi tonde,","poem":1},{"text":"to wiya ok bi wil gi chikeni.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Achiewo dier otieno mondo aduokni erokamano","poem":1},{"text":"kuom chikeni makare.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"An osiep ji duto moluori,","poem":1},{"text":"jogo duto moluwo yoreni.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"Piny opongʼ gi herani, yaye Jehova Nyasaye;","poem":1},{"text":"yie ipuonja chikeni.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Tim maber ne jatichni","poem":1},{"text":"kaluwore gi wachni, yaye Jehova Nyasaye.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Puonja ngʼeyo gi paro maber,","poem":1},{"text":"nimar ayie kuom chikeni.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Kane pok ayudo masira to ne abayo yo,","poem":1},{"text":"to sani koro atimo gima wachni owacho.","poem":2}]},{"type":"verse","number":68,"content":[{"text":"Iber, kendo gima itimo ber;","poem":1},{"text":"omiyo puonja chikeni.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Kata obedo ni joma ochayo ji osemiena gi miriambo,","poem":1},{"text":"to pod arito yoreni gi chunya duto.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"Chunygi tek kendo ok dew gimoro amora;","poem":1},{"text":"to an to chikni miya mor.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"Ne en gima ber mondo ayud chandruok","poem":1},{"text":"mondo eka apuonjra chikeni.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"Chik moa e dhogi berna","poem":1},{"text":"moloyo ngʼinjo gana gi gana mag fedha gi dhahabu.","poem":2}]},{"type":"verse","number":73,"content":[{"text":"Lweti ema nochweya;","poem":1},{"text":"miya ngʼeyo mondo apuonjra chikeni.","poem":2}]},{"type":"verse","number":74,"content":[{"text":"Mad joma oluori bed mamor ka ginena,","poem":1},{"text":"nimar aseketo genona e wachni.","poem":2}]},{"type":"verse","number":75,"content":[{"text":"Angʼeyo, yaye Jehova Nyasaye, ni chikeni nikare,","poem":1},{"text":"kendo angʼeyo ni chwat misechwadago nikare.","poem":2}]},{"type":"verse","number":76,"content":[{"text":"Mad ihoya gi herani ma ok rem,","poem":1},{"text":"kaluwore gi singruok mane imiyo jatichni.","poem":2}]},{"type":"verse","number":77,"content":[{"text":"Orna kechni mondo abed mangima,","poem":1},{"text":"nimar chikni e morna.","poem":2}]},{"type":"verse","number":78,"content":[{"text":"Mad joma ochayo ji ne wichkuot kuom kwinya maonge gima omiyo,","poem":1},{"text":"an to abiro paro matut kuom yoreni.","poem":2}]},{"type":"verse","number":79,"content":[{"text":"Mad joma oluori dog jokora,","poem":1},{"text":"kaachiel gi joma ongʼeyo bucheni.","poem":2}]},{"type":"verse","number":80,"content":[{"text":"Mad chunya bed maonge ketho, kuom rito chikeni,","poem":1},{"text":"mondo kik ane wichkuot.","poem":2}]},{"type":"verse","number":81,"content":[{"text":"Riyo mar dwaro warruokni oloyo chunya,","poem":1},{"text":"kata kamano aseketo genona e wachni.","poem":2}]},{"type":"verse","number":82,"content":[{"text":"Wengena ool kamanyo singruokni;","poem":1},{"text":"apenjora niya, “Ibiro hoya karangʼo?”","poem":2}]},{"type":"verse","number":83,"content":[{"text":"Kata obedo ni achalo pien tingʼo divai molier e iro,","poem":1},{"text":"to wiya pok owil gi chikeni.","poem":2}]},{"type":"verse","number":84,"content":[{"text":"Jatichni biro rito nyaka karangʼo?","poem":1},{"text":"Ibiro kumo joma sanda karangʼo?","poem":2}]},{"type":"verse","number":85,"content":[{"text":"Joma ochayo ji osekunyona buche mondo apodhie,","poem":1},{"text":"gitimo gima chikni okwedo.","poem":2}]},{"type":"verse","number":86,"content":[{"text":"Chikeni duto inyalo geno; omiyo yie ikonya,","poem":1},{"text":"nikech ji sanda maonge gima omiyo.","poem":2}]},{"type":"verse","number":87,"content":[{"text":"Ne gichiegni yweya oko e piny,","poem":1},{"text":"to kata kamano pok aweyo chikeni.","poem":2}]},{"type":"verse","number":88,"content":[{"text":"Rit ngimana kaluwore gi herani,","poem":1},{"text":"mondo alu chike mowuok e dhogi.","poem":2}]},{"type":"verse","number":89,"content":[{"text":"Wachni ochwere, yaye Jehova Nyasaye;","poem":1},{"text":"ochungʼ mogurore e polo.","poem":2}]},{"type":"verse","number":90,"content":[{"text":"Adiera mari ochwere e tienge duto;","poem":1},{"text":"mana kaka ne iguro piny mi piny osiko.","poem":2}]},{"type":"verse","number":91,"content":[{"text":"Chikeni osiko nyaka kawuono,","poem":1},{"text":"nimar gik moko duto tiyoni.","poem":2}]},{"type":"verse","number":92,"content":[{"text":"Ka dine bed ni chikeni ok ema miya mor,","poem":1},{"text":"to dikoro aselal nono nikech masichena.","poem":2}]},{"type":"verse","number":93,"content":[{"text":"Wiya ok bi wil gi bucheni,","poem":1},{"text":"nimar gin ema iseritogo ngimana.","poem":2}]},{"type":"verse","number":94,"content":[{"text":"Resa nimar an mari;","poem":1},{"text":"nikech asiko amanyo chikeni ndalo duto.","poem":2}]},{"type":"verse","number":95,"content":[{"text":"Joma timbegi richo obutona mondo gitieka,","poem":1},{"text":"to abiro bet mos ka aparo kuom chikeni.","poem":2}]},{"type":"verse","number":96,"content":[{"text":"Angʼeyo ni koda ka gik malongʼo chuth nigi gikogi,","poem":1},{"text":"to chikeni onge gikogi.","poem":2}]},{"type":"verse","number":97,"content":[{"text":"Yaye, mano kaka ahero chikni!","poem":1},{"text":"Aparo kuome odiechiengʼ duto.","poem":2}]},{"type":"verse","number":98,"content":[{"text":"Chikeni miyo abedo mariek moloyo wasika,","poem":1},{"text":"nimar gisiko gin koda seche duto.","poem":2}]},{"type":"verse","number":99,"content":[{"text":"An gi winjo moloyo jopuonjna duto,","poem":1},{"text":"nimar arito chikeni.","poem":2}]},{"type":"verse","number":100,"content":[{"text":"Wach donjona moloyo jodongo machon","poem":1},{"text":"nimar arito chikeni.","poem":2}]},{"type":"verse","number":101,"content":[{"text":"Asetamo tiendena ni kik wuothi e yore maricho,","poem":1},{"text":"mondo eka atim gima wachni ochiko.","poem":2}]},{"type":"verse","number":102,"content":[{"text":"Pok abaro aweyo chikeni,","poem":1},{"text":"nimar in iwuon ema isepuonja.","poem":2}]},{"type":"verse","number":103,"content":[{"text":"Mano kaka wechegi mit ka abilogi,","poem":1},{"text":"gimit e dhoga moloyo mor kich!","poem":2}]},{"type":"verse","number":104,"content":[{"text":"Chikeni miyo abedo gi winjo;","poem":1},{"text":"emomiyo achayo yo moro amora marach.","poem":2}]},{"type":"verse","number":105,"content":[{"text":"Wachni e taya mar tienda","poem":1},{"text":"kendo en ler mamenyona yo.","poem":2}]},{"type":"verse","number":106,"content":[{"text":"Asekwongʼora mi aketo sei ni abiro siko","poem":1},{"text":"kaluwo chikeni makare.","poem":2}]},{"type":"verse","number":107,"content":[{"text":"Asechandora moloyo;","poem":1},{"text":"omiyo rit ngimana, yaye Jehova Nyasaye,","poem":2},{"lineBreak":true},{"text":"kaluwore gi wachni.","poem":2}]},{"type":"verse","number":108,"content":[{"text":"Rwak pak ma achiwoni gi dhoga ka ahero, yaye Jehova Nyasaye,","poem":1},{"text":"kendo puonja chikeni.","poem":2}]},{"type":"verse","number":109,"content":[{"text":"Kata obedo ni atingʼo ngimana e lweta kinde duto,","poem":1},{"text":"to wiya ok bi wil gi chikeni.","poem":2}]},{"type":"verse","number":110,"content":[{"text":"Joma timbegi richo osechikona obadho;","poem":1},{"text":"to kata kamano pok abaro aweyo bucheni.","poem":2}]},{"type":"verse","number":111,"content":[{"text":"Chikeni e girkeni mara manyaka chiengʼ;","poem":1},{"text":"gin e mor mar chunya.","poem":2}]},{"type":"verse","number":112,"content":[{"text":"Aketo chunya kuom rito chikeni","poem":1},{"text":"ma ok aweyo nyaka giko.","poem":2}]},{"type":"verse","number":113,"content":[{"text":"Achayo joma pachgi ariyo,","poem":1},{"lineBreak":true},{"text":"to ahero chikni.","poem":1}]},{"type":"verse","number":114,"content":[{"lineBreak":true},{"text":"In e ohingana kendo okumbana;","poem":1},{"text":"omiyo aseketo genona e wachni.","poem":2}]},{"type":"verse","number":115,"content":[{"text":"Ayiuru buta, un jorichogi,","poem":1},{"text":"mondo arit chike mag Nyasacha!","poem":2}]},{"type":"verse","number":116,"content":[{"text":"Maka motegno kaluwore gi singruokni,","poem":1},{"text":"eka anabed mangima; kik iwe geno ma an-go lalna.","poem":2}]},{"type":"verse","number":117,"content":[{"text":"Sira eka ananwangʼ konyruok;","poem":1},{"lineBreak":true},{"text":"abiro siko ka ahero chikeni.","poem":1}]},{"type":"verse","number":118,"content":[{"lineBreak":true},{"text":"Idagi ji duto mabaro weyo chikeni,","poem":1},{"text":"nimar wuondruok ma giwuondorego en kayiem.","poem":2}]},{"type":"verse","number":119,"content":[{"text":"Joma timbegi richo duto modak e piny ipuko oko ka yugi;","poem":1},{"text":"emomiyo ahero chikeni.","poem":2}]},{"type":"verse","number":120,"content":[{"text":"Denda tetni nikech oluori,","poem":1},{"text":"kihondko omaka nikech chikeni.","poem":2}]},{"type":"verse","number":121,"content":[{"text":"asetimo gima kare kendo madier,","poem":1},{"text":"omiyo kik iweya e lwet joma sanda.","poem":2}]},{"type":"verse","number":122,"content":[{"text":"Ne ni jatichni dhi maber,","poem":1},{"text":"kendo kik iyie joma ochayo ji osanda.","poem":2}]},{"type":"verse","number":123,"content":[{"text":"Wengena ool karango resruok mikelo,","poem":1},{"text":"kendo kamanyo gima kare mane isingona.","poem":2}]},{"type":"verse","number":124,"content":[{"text":"Timne jatichni kaluwore gi herani,","poem":1},{"text":"kendo puonja chikeni.","poem":2}]},{"type":"verse","number":125,"content":[{"text":"An jatichni, omiyo yie imiya nyalo mar ngʼeyo gik mopondo","poem":1},{"text":"eka awinj tiend chikeni.","poem":2}]},{"type":"verse","number":126,"content":[{"text":"Sa oromo mondo koro itim gimoro, yaye Jehova Nyasaye,","poem":1},{"text":"nikech iketho chikni.","poem":2}]},{"type":"verse","number":127,"content":[{"text":"Nikech ahero chikeni moloyo dhahabu,","poem":1},{"text":"kendo moloyo dhahabu maler mogik,","poem":2}]},{"type":"verse","number":128,"content":[{"text":"kendo nikech akawo bucheni duto ni nikare,","poem":1},{"text":"omiyo achayo yo moro amora marach.","poem":2}]},{"type":"verse","number":129,"content":[{"text":"Chikeni lich miwuoro;","poem":1},{"text":"emomiyo aritogi.","poem":2}]},{"type":"verse","number":130,"content":[{"text":"Wachni koler tiende to kelo ler,","poem":1},{"text":"omiyo joma riekogi tin bedo gi winjo.","poem":2}]},{"type":"verse","number":131,"content":[{"text":"Ayawo dhoga kendo agamo yweyo,","poem":1},{"text":"ka agombo chikeni.","poem":2}]},{"type":"verse","number":132,"content":[{"text":"Lokri iranga mondo ikecha,","poem":1},{"text":"kaka ijatimo ndalo duto ne joma ohero nyingi.","poem":2}]},{"type":"verse","number":133,"content":[{"text":"Ket okangega mondo gilure gi wachni;","poem":1},{"text":"kik iwe richo moro amora loya.","poem":2}]},{"type":"verse","number":134,"content":[{"text":"Resa e dicho ma ji diyogo jowetegi,","poem":1},{"text":"mondo eka arit bucheni.","poem":2}]},{"type":"verse","number":135,"content":[{"text":"Ngʼi jatichni gi wangʼ maber","poem":1},{"text":"kendo puonja chikeni.","poem":2}]},{"type":"verse","number":136,"content":[{"text":"Pi wangʼ bubni kawuok e wengena,","poem":1},{"text":"nimar chikni ok ji orito.","poem":2}]},{"type":"verse","number":137,"content":[{"text":"In ngʼat makare, yaye Jehova Nyasaye,","poem":1},{"text":"kendo chikeni nikare.","poem":2}]},{"type":"verse","number":138,"content":[{"text":"Chike misendiko nikare,","poem":1},{"text":"inyalo genogi chuth.","poem":2}]},{"type":"verse","number":139,"content":[{"text":"Hera matut ma aherogo wachni tieka,","poem":1},{"text":"nimar wasika ok dew wachni.","poem":2}]},{"type":"verse","number":140,"content":[{"text":"Singruok magi osetem maber chuth,","poem":1},{"text":"omiyo jatichni oherogi.","poem":2}]},{"type":"verse","number":141,"content":[{"text":"Kata obedo ni an chien kendo ji ochaya,","poem":1},{"text":"to wiya ok nyal wil gi bucheni.","poem":2}]},{"type":"verse","number":142,"content":[{"text":"Timni makare osiko","poem":1},{"text":"kendo chikni en adier,","poem":2}]},{"type":"verse","number":143,"content":[{"text":"Chandruok kod malit osebirona,","poem":1},{"text":"kata kamano chikeni e morna.","poem":2}]},{"type":"verse","number":144,"content":[{"text":"Chikeni nikare nyaka chiengʼ,","poem":1},{"text":"omiyo miya ngʼeyo mondo abed mangima.","poem":2}]},{"type":"verse","number":145,"content":[{"text":"Yie idwoka, yaye Jehova Nyasaye, nikech aywakni gi chunya duto","poem":1},{"text":"kendo abiro timo kaka chikni dwaro.","poem":2}]},{"type":"verse","number":146,"content":[{"text":"Aywakni, yie ikonya,","poem":1},{"text":"eka abiro rito chikeni.","poem":2}]},{"type":"verse","number":147,"content":[{"text":"Achiewo kogwen ka piny pok oyawore kendo aywagora mondo ayud kony;","poem":1},{"text":"aseketo genona e wachni.","poem":2}]},{"type":"verse","number":148,"content":[{"text":"Wengena neno otieno duto,","poem":1},{"text":"mondo omi apar matut kuom singruok magi.","poem":2}]},{"type":"verse","number":149,"content":[{"text":"Winj dwonda kaluwore gi herani;","poem":1},{"text":"rit ngimana, yaye Jehova Nyasaye, kaluwore gi chikeni.","poem":2}]},{"type":"verse","number":150,"content":[{"text":"Joma chanona gik maricho ni koda machiegni,","poem":1},{"text":"kata kamano gin mabor gi chikni.","poem":2}]},{"type":"verse","number":151,"content":[{"text":"In to in machiegni, yaye Jehova Nyasaye,","poem":1},{"text":"kendo chikeni duto gin adier.","poem":2}]},{"type":"verse","number":152,"content":[{"text":"Ne apuonjora kuom chikeni chon gi lala,","poem":1},{"text":"ni ne igurogi mondo gisiki nyaka chiengʼ.","poem":2}]},{"type":"verse","number":153,"content":[{"text":"Ne chandruokna mondo ikonya,","poem":1},{"text":"nimar pok wiya owil gi chikni.","poem":2}]},{"type":"verse","number":154,"content":[{"text":"Dog jakora mondo iresa,","poem":1},{"text":"rit ngimana kaluwore gi singruokni.","poem":2}]},{"type":"verse","number":155,"content":[{"text":"Warruok ni mabor gi joma timbegi richo,","poem":1},{"text":"nimar ok giket chunygi kuom dwaro chikeni.","poem":2}]},{"type":"verse","number":156,"content":[{"text":"Ngʼwononi duongʼ, yaye Jehova Nyasaye;","poem":1},{"text":"rit ngimana kaluwore gi chikeni.","poem":2}]},{"type":"verse","number":157,"content":[{"text":"Wasigu masanda thoth adier,","poem":1},{"text":"to kata kamano pok abaro aweyo chikeni.","poem":2}]},{"type":"verse","number":158,"content":[{"text":"Arango joma onge yie ka chunya ochido kodgi,","poem":1},{"text":"nimar ok girit chikni.","poem":2}]},{"type":"verse","number":159,"content":[{"text":"Neye kaka ahero bucheni;","poem":1},{"text":"omiyo rit ngimana, yaye Jehova Nyasaye,","poem":2},{"lineBreak":true},{"text":"kaluwore gi herani.","poem":2}]},{"type":"verse","number":160,"content":[{"text":"Wechegi duto gin adier;","poem":1},{"text":"kendo chikegi makare duto ochwere.","poem":2}]},{"type":"verse","number":161,"content":[{"text":"Jotelo sanda maonge gima omiyo,","poem":1},{"text":"to kata kamano chunya oluoro wachni.","poem":2}]},{"type":"verse","number":162,"content":[{"text":"Singruokni miya mor,","poem":1},{"text":"mana ka ngʼama oyudo mwandu maduongʼ mope wasigu.","poem":2}]},{"type":"verse","number":163,"content":[{"text":"Asin kendo ajok gi miriambo,","poem":1},{"text":"to ahero chikni.","poem":2}]},{"type":"verse","number":164,"content":[{"text":"Apaki ndalo abiriyo e odiechiengʼ achiel","poem":1},{"text":"kuom chikegi makare.","poem":2}]},{"type":"verse","number":165,"content":[{"text":"Joma ohero chikeni nigi kwe maduongʼ","poem":1},{"text":"kendo onge gima nyalo miyo gichwanyre.","poem":2}]},{"type":"verse","number":166,"content":[{"text":"Arito warruokni, yaye Jehova Nyasaye,","poem":1},{"text":"kendo aluwo chikeni.","poem":2}]},{"type":"verse","number":167,"content":[{"text":"Atimo gima chikeni dwaro,","poem":1},{"text":"nimar aherogi gihera maduongʼ.","poem":2}]},{"type":"verse","number":168,"content":[{"text":"Arito bucheni gi chikeni,","poem":1},{"text":"nimar yorega duto ongʼereni maber.","poem":2}]},{"type":"verse","number":169,"content":[{"text":"Mad ywakna chopi e nyimi, yaye Jehova Nyasaye;","poem":1},{"text":"mi abed gi winjo kaluwore gi wachni.","poem":2}]},{"type":"verse","number":170,"content":[{"text":"Mad kwayona chopi e nyimi,","poem":1},{"text":"resa kaluwore gi singruokni.","poem":2}]},{"type":"verse","number":171,"content":[{"text":"Mad dhoga pongʼ gi pak,","poem":1},{"text":"nimar isepuonja chikeni.","poem":2}]},{"type":"verse","number":172,"content":[{"text":"Mad lewa wer kuom wachni,","poem":1},{"text":"nimar chikegi duto nikare.","poem":2}]},{"type":"verse","number":173,"content":[{"text":"Mad lweti ikre mar konya,","poem":1},{"text":"nimar aseyiero bucheni.","poem":2}]},{"type":"verse","number":174,"content":[{"text":"Asedwaro resruok mari matek, yaye Jehova Nyasaye;","poem":1},{"text":"kendo chikni e morna.","poem":2}]},{"type":"verse","number":175,"content":[{"text":"We amed bedo mangima mondo apaki,","poem":1},{"text":"kendo mad chikeni okonya.","poem":2}]},{"type":"verse","number":176,"content":[{"text":"Aserwenyo ka rombo molal,","poem":1},{"text":"omiyo yie imany jatichni, nimar wiya pok owil gi chikeni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":176}