{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["Wer miwero ka ji dhi e hekalu."]},{"type":"verse","number":1,"content":[{"text":"Ka an e chandruok to aluongo Jehova Nyasaye,","poem":1},{"text":"kendo odwoka,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Resa, yaye Jehova Nyasaye, kuom dho joma riambo","poem":1},{"text":"kendo kuom lew joma wuondore.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bende ingʼeyo gima Nyasaye biro timoni,","poem":1},{"text":"bende ingʼeyo gik mochomi adier, yaye lep mawuondore?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Obiro kumi gi aserni mabitho mag jakedo,","poem":1},{"text":"ee, obiro wangʼi gi maka maliel mager,","poem":2},{"lineBreak":true},{"text":"mowangʼ gi yiend adugo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Malit ochoma adier nikech adak Meshek,","poem":1},{"text":"hapa rach nikech adak e dier hembe mag Kedar!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Asedak amingʼa ahinya,","poem":1},{"text":"e dier joma ok dwar kwe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"An ngʼat kwe;","poem":1},{"text":"to ka awuoyo, to giikore ni lweny.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}