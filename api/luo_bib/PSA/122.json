{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["Wer ma ji wero kadhi e hekalu. Mar Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ne amor gi joma nowachona niya,","poem":1},{"text":"“Wadhiuru e od Jehova Nyasaye.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tiendewa ochungʼ","poem":1},{"text":"e dhorangeyeni, yaye Jerusalem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jerusalem oger ka dala","poem":1},{"text":"ma ji odakie machiegni motenore.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kanyo e kama ogendini idho dhiye,","poem":1},{"text":"ogendini mag Jehova Nyasaye dhi kuno,","poem":2},{"text":"mondo opak nying Jehova Nyasaye","poem":1},{"text":"ka giluwo chike mane omi Israel.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kanyo ema kombe loch mag ngʼado bura nitie","poem":1},{"text":"gin kombe loch mag jood Daudi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lamuru mondo Jerusalem obed gi kwe.","poem":1},{"text":"Lamuru niya, “Mad joma oheri bed gi kwe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mad kwe yudre ei alworani,","poem":1},{"text":"adier kwe mondo obedi ei ohinga mochieli.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nikech owetena gi osiepena modak e iyi,","poem":1},{"text":"awacho niya, “Jerusalem mondo obed gi kwe.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nikech wach od Jehova Nyasaye ma Nyasachwa,","poem":1},{"text":"adwaro ni idhi maber.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}