ore luwo yore mobam","poem":1},{"text":"Jehova Nyasaye biro kumo kaachiel gi joma timo timbe maricho.","poem":2},{"lineBreak":true},{"text":"Israel mondo obed gi kwe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}