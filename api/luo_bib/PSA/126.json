 kaywak,","poem":1},{"text":"kotingʼo kodhi mikomo,","poem":2},{"text":"biro duogo ka wero wende mor,","poem":1},{"text":"kotingʼo cham mosechiek.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}