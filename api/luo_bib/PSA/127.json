{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["Wer ma ji wero kadhi e hekalu. Mar Solomon."]},{"type":"verse","number":1,"content":[{"text":"Ka Jehova Nyasaye ok ema ger ot,","poem":1},{"text":"to joma gere nyagore gi tich matek kayiem nono.","poem":2},{"text":"Ka Jehova Nyasaye ok ema orito dala,","poem":1},{"text":"to jorito ochungʼ karito kayiem.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"In bende imondo chiewo chon","poem":1},{"text":"kendo ineno nyaka sa molewo,","poem":2},{"text":"kinyagori gi tich matek mondo iyud chiemo minyalo chamo;","poem":1},{"text":"nimar Nyasaye miyo joge mohero nindo mokwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yawuowi gin gweth moa kuom Jehova Nyasaye,","poem":1},{"text":"adier, nyithindo gin mich moa kuome.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yawuowi ma ngʼato onywolo kapod otin,","poem":1},{"text":"chalo gi asere manie lwet jakedo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngʼat ma ofukune opongʼ kodgi","poem":1},{"text":"en ngʼama ogwedhi.","poem":2},{"text":"Ok ginine wichkuot","poem":1},{"text":"ka gikedo gi wasikgi e dhorangach.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}