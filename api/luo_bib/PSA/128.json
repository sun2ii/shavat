ber":6,"content":[{"text":"kendo mad idag amingʼa nyaka ine nyithind nyithindi,","poem":2},{"lineBreak":true},{"text":"Israel mondo obed gi kwe!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}