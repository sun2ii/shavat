se","number":7,"content":[{"text":"Ok onyal nyago gimoro mapongʼo lwet jakeyo,","poem":1},{"text":"kata ma jachoko nyalo tingʼo e bade.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mad joma kalo bute kik wachnegi niya,","poem":1},{"text":"“Jehova Nyasaye mondo ogwedhi, kata ni,","poem":2},{"lineBreak":true},{"text":"wagwedhi e nying Jehova Nyasaye.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}