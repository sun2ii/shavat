{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["Kuom jatend wer. Zaburi mar Daudi."]},{"type":"verse","number":1,"content":[{"text":"Nyaka karangʼo, yaye Jehova Nyasaye? Wiyi biro wil koda nyaka chiengʼ koso?","poem":1},{"text":"Ibiro pandona wangʼi nyaka karangʼo?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abiro dhi nyime ka an gi pek manie pacha","poem":1},{"text":"kod kuyo manie chunya odiechiengʼ kodiechiengʼ nyaka karangʼo?","poem":2},{"lineBreak":true},{"text":"Wasika biro locho kuoma nyaka karangʼo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Para kendo idwoka, yaye Jehova Nyasaye Nyasacha.","poem":1},{"text":"Chiw ler ne wengena, nono to dipo ka nindo otera mi atho;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"nikech mano nyalo miyo jasika wach niya, “Aseloye,”","poem":1},{"text":"kendo wasika biro bedo mamor ka apodho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Anto ageno kuom herani mosiko;","poem":1},{"text":"chunya oil kuom warruok mari.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abiro wer ne Jehova Nyasaye,","poem":1},{"text":"nikech osebedo ka otimona maber.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}