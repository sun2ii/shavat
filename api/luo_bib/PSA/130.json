{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["Wer ma ji wero kadhi e hekalu."]},{"type":"verse","number":1,"content":[{"text":"Aywakni ka an e chuny bur matut, yaye Jehova Nyasaye,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Yaye Jehova Nyasaye, yie iwinj dwonda.","poem":2},{"text":"Chik iti ne ywakna ma aywaknigo","poem":1},{"text":"mondo ikecha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yaye Jehova Nyasaye, ka dine bed ni isiko iparo richo, ma ji timo,","poem":1},{"text":"yaye Jehova Nyasaye, to en ngʼa ma dichungʼ e nyimi ka ok bura oloyo?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"To kata kamano kuomi nitiere weyo richo;","poem":1},{"text":"kuom mano watiyoni gi luor.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Arito Jehova Nyasaye, chunya rite","poem":1},{"text":"kendo aketo genona kuom wachne.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Chunya rito Ruoth Nyasaye,","poem":1},{"text":"moloyo kaka jorito rito ru piny,","poem":2},{"text":"chunya riti, yaye Nyasaye,","poem":1},{"text":"moloyo kaka jorito rito ru piny.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yaye jo-Israel, keturu genou kuom Jehova Nyasaye, nimar Jehova Nyasaye","poem":1},{"text":"nigi hera ma ok rem,","poem":2},{"lineBreak":true},{"text":"kendo en ema owaro ji chuth.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"En owuon ema obiro waro jo-Israel","poem":1},{"text":"kuom richogi duto.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}