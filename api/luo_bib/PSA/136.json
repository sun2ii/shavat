chiengʼ,","poem":1},"Herane osiko nyaka chiengʼ."]},{"type":"verse","number":9,"content":[{"text":"kod dwe gi sulwe mondo orit otieno;","poem":1},"Herane osiko nyaka chiengʼ."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ne En mane onego nyithindo makayo mag Misri,","poem":1},"Herane osiko nyaka chiengʼ."]},{"type":"verse","number":11,"content":[{"text":"kendo mane ogolo jo-Israel oko kuomgi,","poem":1},"Herane osiko nyaka chiengʼ."]},{"type":"verse","number":12,"content":[{"text":"nogologi gi lwedo motegno kod bat morie;","poem":1},"Herane osiko nyaka chiengʼ."]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ne En mane obaro Nam Makwar diere ariyo;","poem":1},"Herane osiko nyaka chiengʼ."]},{"type":"verse","number":14,"content":[{"text":"mi nogolo jo-Israel koluwo diere tir,","poem":1},"Herane osiko nyaka chiengʼ."]},{"type":"verse","number":15,"content":[{"text":"to Farao gi jolwenje to nomiyo Nam Makwar oywero;","poem":1},"Herane osiko nyaka chiengʼ."]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ne En mane otelo ne joge e thim,","poem":1},"Herane osiko nyaka chiengʼ."]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ne En mane ogoyo ruodhi madongo piny,","poem":1},"Herane osiko nyaka chiengʼ."]},{"type":"verse","number":18,"content":[{"text":"kendo mane onego ruodhi maroteke;","poem":1},"Herane osiko nyaka chiengʼ."]},{"type":"verse","number":19,"content":[{"text":"Kaka Sihon ruodh jo-Amor,","poem":1},"Herane osiko nyaka chiengʼ."]},{"type":"verse","number":20,"content":[{"text":"gi Og ruodh Bashan,","poem":1},"Herane osiko nyaka chiengʼ."]},{"type":"verse","number":21,"content":[{"text":"mi nochiwo pinygi kaka girkeni,","poem":1},"Herane osiko nyaka chiengʼ."]},{"type":"verse","number":22,"content":[{"text":"Kaka girkeni ne Israel jatichne;","poem":1},"Herane osiko nyaka chiengʼ."]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ne En mane oparowa ka piny ochamowa,","poem":1},"Herane osiko nyaka chiengʼ."]},{"type":"verse","number":24,"content":[{"text":"kendo mane ogonyowa e lwet wasikwa,","poem":1},"Herane osiko nyaka chiengʼ."]},{"type":"verse","number":25,"content":[{"text":"machiwo chiemo ne chwech duto,","poem":1},"Herane osiko nyaka chiengʼ."]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Gouru erokamano ne Nyasach polo,","poem":1},"Herane osiko nyaka chiengʼ."]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}