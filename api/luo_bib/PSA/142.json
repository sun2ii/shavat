{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["Maskil",{"noteId":30},"mar Daudi. Kane en ei bur. Lamo."]},{"type":"verse","number":1,"content":[{"text":"Aywak matek ne Jehova Nyasaye;","poem":1},{"text":"atingʼo dwonda ne Jehova Nyasaye mondo okecha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ahulone gik mathaga duto;","poem":1},{"text":"anyise chandruokna duto ka abet e nyime.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"E kinde ma chunya chandore e iya,","poem":1},{"text":"to in ema ingʼeyo yor konyruokna.","poem":2},{"text":"E bugo matut ma awuothoe","poem":1},{"text":"ji osechikonae obadho.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Rang batha korachwich;","poem":1},{"text":"mondo ine kaonge ngʼama dewa.","poem":2},{"text":"Aonge kar pondo;","poem":1},{"text":"bende aonge ngʼama rito ngimana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aywakni, yaye Jehova Nyasaye;","poem":1},{"text":"awachoni niya, “In e kar pondona,","poem":2},{"lineBreak":true},{"text":"kendo in e pokna e piny joma ngima.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yie iwinj ywakna,","poem":1},{"text":"nimar an-gi chandruok maduongʼ;","poem":2},{"text":"resa e lwet joma lawa","poem":1},{"text":"nimar gitek moloya mabor.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gonya e twech ma antie,","poem":1},{"text":"mondo apak nyingi.","poem":2},{"text":"Eka joma kare biro chokore buta","poem":1},{"text":"nikech ber misetimona.","poem":2}]}],"footnotes":[{"noteId":30,"caller":"+","text":"Maskil: en kit wer moro mane Daudi owero","reference":{"chapter":142,"verse":0}}]},"thisChapterLink":"/api/luo_bib/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}