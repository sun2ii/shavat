{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"hebrew_subtitle","content":["Zaburi mar Daudi."]},{"type":"verse","number":1,"content":[{"text":"Winj lamona, yaye Jehova Nyasaye,","poem":1},{"text":"chik iti ne ywakna mar kech;","poem":2},{"text":"bi mondo ikonya","poem":1},{"text":"nikech in ja-adiera kendo itimo maber.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kik imi jatichni yud kum","poem":1},{"text":"nimar onge kata ngʼato achiel matimo maber e nyimi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jasigu lawa matek,","poem":1},{"text":"oserodha piny nyaka e lowo;","poem":2},{"text":"ochuna ni nyaka adag kama otimo mudho","poem":1},{"text":"mana ka joma notho chon gi lala.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Omiyo chunya chandore e iya,","poem":1},{"text":"ee, chunya obwok.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aparo higni machon mosekalo;","poem":1},{"text":"aketo pacha mos kuom tijeni duto,","poem":2},{"lineBreak":true},{"text":"kendo ageno gik ma lweti osetimo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ayaroni lwetena;","poem":1},{"text":"chunya gombi mana kaka lowo motwo gombo koth. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dwoka piyo, yaye Jehova Nyasaye,","poem":1},{"text":"nimar chunya ool.","poem":2},{"text":"Kik ipandna wangʼi","poem":1},{"text":"nono to dipoka achalo gi joma ridore e bur matut.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mi mondo okinyi oromna gi herani ma ok rem,","poem":1},{"text":"nimar aketo genona kuomi.","poem":2},{"text":"Nyisa yo monego alu","poem":1},{"text":"nimar aketo chunya duto kuomi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Resa e lwet wasika, yaye Jehova Nyasaye,","poem":1},{"text":"nimar in e jaritna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Puonja timo dwaroni,","poem":1},{"text":"nimar in e Nyasacha;","poem":2},{"text":"mi mondo Roho mari maber,","poem":1},{"text":"otelna e yo mopie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yaye Jehova Nyasaye, kony ngimana nikech nyingi iwuon;","poem":1},{"text":"gola oko e chandruok nikech timni maber.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mi wasika olingʼ thi,","poem":1},{"text":"nikech herani ma ok rem;","poem":2},{"lineBreak":true},{"text":"tiek joma kedo koda duto nimar an jatichni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}