{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"Pakuru Jehova Nyasaye!","poem":1},{"lineBreak":true},{"text":"Werneuru Jehova Nyasaye wer manyien,","poem":1},{"text":"kendo dendeuru e chokruok mar jomaler.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Jo-Israel mondo obed mamor gi jachwechgi;","poem":1},{"text":"ee, jo-Sayun mondo obed mamor gi Ruodhgi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Onego gi pak nyinge gi miel","poem":1},{"text":"kendo giwerne mamit ka gigoyo oyieke gi nyatiti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nimar chuny Jehova Nyasaye mor gi joge","poem":1},{"text":"kendo osidho joma obolore gi warruok.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Jomaler mondo oil kamiye duongʼ","poem":1},{"text":"kendo giwer gimor ka gibet e kitandagi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Onego pak mar Nyasaye obed e dhogi","poem":1},{"text":"kendo gitingʼ ligangla ma dhoge ariyo e lwetgi,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"mondo gichulgo kuor ni ogendini","poem":1},{"text":"kendo gikum ogendini mamoko,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"kendo gitwe ruodhigi gi nyoroche,","poem":1},{"text":"kod jotendgi gi opingo mag chuma,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ka gichopo kum mane ondik kuomgi chon.","poem":1},{"text":"Ma e duongʼ mar joge maler duto.","poem":2},{"lineBreak":true},{"text":"Pakuru Jehova Nyasaye!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}