olo ji pesane ma ok odwaro ni odwokne gi gimoro e wiye","poem":1},{"text":"kendo ma ok yie kaw asoya kuom joma onge ketho.","poem":2},{"lineBreak":true},{"text":"Ngʼat matimo gik makamagi","poem":1},{"text":"gimoro amora ok nyal yiengo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}