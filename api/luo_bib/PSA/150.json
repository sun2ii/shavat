ye.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}