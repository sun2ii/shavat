{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":19,"content":[{"type":"hebrew_subtitle","content":["Kuom jatend wer. Zaburi mar Daudi."]},{"type":"verse","number":1,"content":[{"text":"Polo hulo duongʼ mar Nyasaye;","poem":1},{"text":"kor polo nyiso tich mar lwete.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Odiechiengʼ kodiechiengʼ gilando wach;","poem":1},{"text":"otieno kotieno ginyiso rieko.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gionge dhok kata weche","poem":1},{"text":"kata dwondgi ok winji.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kata kamano dwondgi chopo kuonde duto e piny,","poem":1},{"text":"wechegi osechopo nyaka e tunge piny.","poem":2},{"text":"Osechungo hema e kor polo ne wangʼ chiengʼ,","poem":1}]},{"type":"verse","number":5,"content":[{"text":"machalo gi wuon kisera mothinyore oko kawuok e ode mar mor,","poem":2},{"lineBreak":true},{"text":"kendo mana ka jangʼwech mongirore moil moikore ni chako ngʼwech.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Owuok gie tungʼ polo konchiel,","poem":1},{"text":"kendo olworore nyaka komachielo;","poem":2},{"lineBreak":true},{"text":"onge gima opondo ne liet mare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Chik Jehova Nyasaye longʼo chuth,","poem":1},{"text":"odwogo chuny.","poem":2},{"text":"Buche mag Jehova Nyasaye gin adiera,","poem":1},{"lineBreak":true},{"text":"gimiyo joma riekogi tin bedo mariek.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chike mag Jehova Nyasaye nikare,","poem":1},{"text":"gichiwo mor ne chuny.","poem":2},{"text":"Chike mag Jehova Nyasaye rieny,","poem":1},{"text":"gichiwo ler ne wangʼ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Luoro Jehova Nyasaye en gima ber,","poem":1},{"text":"mosiko nyaka chiengʼ.","poem":2},{"text":"Buche mag Jehova Nyasaye gin adier","poem":1},{"text":"kendo gin kare kargi giduto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Gibeyo moloyo dhahabu,","poem":1},{"text":"moloyo dhahabu malerie moloyo;","poem":2},{"text":"gimit moloyo mor kich","poem":1},{"text":"moa e pedni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gin ema gimiyo jatichni bedo motangʼ; kendo bedogi kanyo","poem":1},{"text":"kelo pok maduongʼ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"En ngʼa manyalo ngʼeyo kethone mopondo?","poem":1},{"text":"Wena kethoga mopondo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bende gengʼ jatichni kuom richo mag wich teko;","poem":1},{"text":"mad kik gibed gi loch kuoma.","poem":2},{"text":"Eka anabed maonge ketho,","poem":1},{"text":"anabed ka aonge gi ketho chik moro maduongʼ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mad weche mawuok e dhoga, kod paro manie chunya,","poem":1},{"text":"obed malongʼo e nyimi,","poem":2},{"lineBreak":true},{"text":"yaye Jehova Nyasaye, Lwandana kendo Jawarna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}