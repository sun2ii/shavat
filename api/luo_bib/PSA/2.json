{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Angʼo momiyo ogendini chano timo marach","poem":1},{"text":"kendo ji chano jiemo kayiem nono?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ruodhi mag piny osebiro kanyakla","poem":1},{"text":"kendo jotelo pimo wach kaachiel,","poem":2},{"text":"mondo giked gi Jehova Nyasaye","poem":1},{"text":"kendo giked gi ngʼate mowir.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Giwacho ni, wachoduru nyorochegi;","poem":1},{"text":"kendo wawit ratekegi kucha.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"To Jal mobet e kom loch e polo to nyierogi anyiera,","poem":1},{"text":"Ruoth goyonegi siboi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eka okwerogi kokecho","poem":1},{"text":"kendo obwogogi kopongʼ gi mirima mager, kowacho niya,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Aseketo Ruoth ma adwaro","poem":1},{"text":"e Sayun, goda maler.”","poem":2}]},{"type":"verse","number":7,"content":["Abiro hulo chenro mag Jehova Nyasaye ma ok lokre:",{"text":"Nowachona niya, “In wuoda;","poem":1},{"text":"kawuono asedoko wuonu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Omiyo kwaya gima idwaro","poem":1},{"text":"mondo aket ogendini duto obed girkeni mari,","poem":2},{"lineBreak":true},{"text":"mondo piny ngima obed mwanduni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Initelnigi kod ludhi mar nyinyo;","poem":1},{"text":"kendo initogi matindo tindo ka agulu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kuom mano, un ruodhi, beduru mariek;","poem":1},{"text":"tangʼuru un joloch mag piny.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tiuru ne Jehova Nyasaye gi luoro","poem":1},{"text":"kendo moruru e nyime gi luoro.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bolreuru e nyim Wuowi,","poem":1},{"text":"nono to dipo kokecho kodu mi dongʼad ndalou, motieku,","poem":2},{"text":"nimar iye nyalo wangʼ kodu kadiemo wangʼ.","poem":1},{"text":"Ji duto mogeno kuome gin joma ogwedhi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}