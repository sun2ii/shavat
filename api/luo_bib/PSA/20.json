{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["Kuom jatend wer. Zaburi mar Daudi."]},{"type":"verse","number":1,"content":[{"text":"Mad Jehova Nyasaye dwoki ka in e chandruok;","poem":1},{"text":"mad nying Nyasach Jakobo riti.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mad oorni kony moa kare maler mar lemo","poem":1},{"text":"kendo omiyi kony moa Sayun.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mad opar misengni magi duto","poem":1},{"text":"kendo oyie gi misengini miwangʼo pep magi. Sela","poem":2},{"noteId":6}]},{"type":"verse","number":4,"content":[{"text":"Mad omiyi gima chunyi gombo","poem":1},{"text":"kendo omi chenro magi duto odhi maber.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wabiro kok gimor ka ilocho","poem":1},{"text":"kendo wabiro tingʼo bendechwa malo e nying Nyasachwa.","poem":2},{"text":"Mad Jehova Nyasaye chiw","poem":1},{"text":"gik moko duto mikwaye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Koro angʼeyo ni Jehova Nyasaye reso ngʼate mowir;","poem":1},{"text":"odwoke gie kare maler mar lemo manie polo,","poem":2},{"lineBreak":true},{"text":"gi teko ma waro ji mar lwete ma korachwich.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jomoko ogeno kuom gechegi to jomoko kuom faresegi,","poem":1},{"text":"to wan to wageno kuom nying Jehova Nyasaye, ma Nyasachwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gibiro lwar e chonggi mi gipodhi,","poem":1},{"text":"to wan wabiro aa malo mi wachungʼ motegno.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yaye Jehova Nyasaye, reswa ruoth!","poem":1},{"text":"Dwokwa ka waluongi!","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"Sela tiend wachni ok ongʼere.","reference":{"chapter":20,"verse":3}}]},"thisChapterLink":"/api/luo_bib/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}