{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":22,"content":[{"type":"hebrew_subtitle","content":["Kuom jatend wer. E dwol mar “Mwanda mar Okinyi.” Zaburi mar Daudi."]},{"type":"verse","number":1,"content":[{"text":"Nyasacha, Nyasacha, iweya nangʼo?","poem":1},{"text":"Angʼo momiyo in mabor koda ma ok inyal resa?","poem":2},{"lineBreak":true},{"text":"In mabor ma ok inyal winjo weche mag churna mondo iresa?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yaye Nyasacha, aywagora odiechiengʼ duto to ok idwoka,","poem":1},{"text":"aywagora gotieno bende ma ok alingʼ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"To eka ibet e kom duongʼ kaka Ngʼama Ler;","poem":1},{"text":"in e pak mar jo-Israel.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kuomi ema wuonewa noketoe genogi;","poem":1},{"text":"ne gigeni kendo ne iresogi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne giywakni kendo ne iwarogi;","poem":1},{"text":"negigeno kuomi mine ok gineno wichkuot.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"An to an mana kudni ma ok dhano,","poem":1},{"text":"ngʼama ji duto jaro kendo ma ji ochayo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ji duto monena jara;","poem":1},{"text":"gidiro ayany ka gikino wigi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Ogeno kuom Jehova Nyasaye;","poem":1},{"text":"koro mondo Jehova Nyasaye okonye ane.","poem":2},{"text":"Koro mondo orese ane,","poem":1},{"text":"nikech chunye mor kode.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"To in ema ne igola e ich;","poem":1},{"text":"ne ichweya mondo agen kuomi kata kane pod adhodho thund minwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne oriwa kodi chakre chiengʼ mane onywolae;","poem":1},{"text":"isebedo Nyasacha aa kinde mane an ei minwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kik ibed mabor koda,","poem":1},{"text":"nikech chandruok ni koda machiegni,","poem":2},{"lineBreak":true},{"text":"kendo onge ngʼama nyalo konya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Rwedhi mangʼeny olwora;","poem":1},{"text":"rwedhi maroteke moa Bashan olwora koni gi koni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sibuoche maruto makidho le ma gisemako","poem":1},{"text":"ongʼamo dhogi malach ka dwaro kidha.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ipuka oko ka pi,","poem":1},{"text":"kendo chokena duto osewil.","poem":2},{"text":"Chunya olokore odok;","poem":1},{"text":"oseleny morumo e iya.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tekona osetwo ka balatago,","poem":1},{"text":"kendo lewa omoko e danda;","poem":2},{"lineBreak":true},{"text":"isepiela e lop tho.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Guogi oselwora;","poem":1},{"text":"oganda mar joma richo oseketa diere,","poem":2},{"lineBreak":true},{"text":"gisetucho lwetena gi tiendena.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Anyalo kwano chokena duto;","poem":1},{"text":"ji ranga amingʼa kendo jara.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ne gipogore lepa e kindgi giwegi","poem":1},{"text":"kendo gigoyo ombulu ne nangana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"To in, yaye Jehova Nyasaye, kik ibed mabor koda.","poem":1},{"text":"In e tekra, bi piyo mondo ikonya.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Res ngimana kuom ligangla,","poem":1},{"text":"res ngimana e teko guogi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Resa e dho sibuoche;","poem":1},{"text":"resa e tunge jowi mager.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Abiro hulo nyingi ne owetena;","poem":1},{"text":"abiro paki e nyim chokruok.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Un muluoro Jehova Nyasaye, pakeuru!","poem":1},{"text":"Un nyikwa Jakobo duto, miyeuru duongʼ.","poem":2},{"lineBreak":true},{"text":"Luoreuru, un koth jo-Israel duto!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nikech pok ochayo kata ojaro","poem":1},{"text":"sandruok mar joma winjo malit;","poem":2},{"text":"pok opandone wangʼe","poem":1},{"text":"to osewinjo ywakne mar dwaro kony.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Kuomi ema thoro mara mar pak e chokruok maduongʼ aye;","poem":1},{"text":"abiro chopo singruok maga e nyim joma oluori.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Joma odhier biro chiemo mi yiengʼ;","poem":1},{"text":"joma manyo Jehova Nyasaye biro pake,","poem":2},{"lineBreak":true},{"text":"mad chunjeu bed mangima nyaka chiengʼ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Tunge piny duto","poem":1},{"text":"biro paro miduog ir Jehova Nyasaye,","poem":2},{"text":"kendo dhout ogendini duto","poem":1},{"text":"biro kulore e nyime,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Nikech loch en mar Jehova Nyasaye","poem":1},{"text":"kendo en ema olocho ewi ogendini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Jo-mwandu duto manie piny biro chiemo kendo lemo;","poem":1},{"text":"ji duto madhi piny e lowo biro kulore e nyime,","poem":2},{"lineBreak":true},{"text":"jogo ma ok nyal siko kangima.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Tienge mabiro noti ne Jehova Nyasaye,","poem":1},{"text":"kendo nonyis ogendini mabiro wachne.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Gibiro hulo timne makare,","poem":1},{"text":"ne ji mapok onywol niya:","poem":2},{"lineBreak":true},{"text":"“Jehova Nyasaye osewaro joge.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}