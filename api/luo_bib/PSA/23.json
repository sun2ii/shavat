mber":6,"content":[{"text":"Adier, ber gihera biro luwa","poem":1},{"text":"ndalo duto mag ngimana,","poem":2},{"text":"kendo abiro dak e od Jehova Nyasaye","poem":1},{"text":"nyaka chiengʼ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}