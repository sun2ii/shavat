{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":25,"content":[{"type":"hebrew_subtitle","content":["Zaburi mar Daudi."]},{"type":"verse","number":1,"content":[{"text":"Achiwoni chunya, yaye Jehova Nyasaye;","poem":1}]},{"type":"verse","number":2,"content":[{"text":"In ema aketo genona kuomi, yaye Nyasacha.","poem":2},{"text":"Kik iwe ane wichkuot,","poem":1},{"text":"bende kik iwe wasika loya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Onge ngʼama oketo genone kuomi","poem":1},{"text":"manyalo neno wichkuot,","poem":2},{"text":"to joma timo timbe maricho","poem":1},{"text":"ema biro neno wichkuot.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nyisa yoreni, yaye Jehova Nyasaye,","poem":1},{"text":"puonja mondo aluwgi;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"telna gi adierani, kendo puonja,","poem":1},{"text":"nikech in Nyasaye ma Jawarna,","poem":2},{"lineBreak":true},{"text":"kendo genona ni kuomi odiechiengʼ duto.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Par kechni maduongʼ gi herani, yaye Jehova Nyasaye,","poem":1},{"text":"nikech gisebedo ka gintie nyaka aa chon.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kik ipar richo mane atimo kapod an rawere","poem":1},{"text":"kod yorena mobam;","poem":2},{"text":"para kaluwore gi herani,","poem":1},{"text":"nikech iber, yaye Jehova Nyasaye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jehova Nyasaye ber kendo yorene oriere tir;","poem":1},{"text":"mano emomiyo opuonjo joricho yorene.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Otelo ni joma muol kuom gima nikare","poem":1},{"text":"kendo opuonjogi yore.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yore duto mag Jehova Nyasaye opongʼ gihera kod adiera","poem":1},{"text":"ni joma rito gik moko duto ma singruokne dwaro.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wena richona nikech nyingi","poem":1},{"text":"kata obedo ni richona duongʼ ahinya, yaye Jehova Nyasaye,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Koro ere ngʼat ma oluoro Jehova Nyasaye?","poem":1},{"text":"Obiro puonje luwo yo moyierne.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Obiro dak e ngima momew,","poem":1},{"text":"kendo nyikwaye nokaw piny kaka girkeni margi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jehova Nyasaye en osiep joma miye luor;","poem":1},{"text":"omiyo gingʼeyo singruok mage.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Achomo wangʼa kuom Jehova Nyasaye ndalo duto,","poem":1},{"text":"nikech en kende ema obiro golo tiendena mobadho omako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Duog ira kendo bedna mangʼwon,","poem":1},{"text":"nikech adongʼ kenda kendo an gi kuyo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Chandruok manie chunya osemedore;","poem":1},{"text":"resa kuom rem ma an-go.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Neye kuyo manie chunya kod rem ma an-go,","poem":1},{"text":"kendo gol richona duto.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Neye kaka wasika osemedore","poem":1},{"text":"kendo kaka gichaya gi chunygi duto!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Rit ngimana kendo iresa;","poem":1},{"text":"kik iwe ane wichkuot,","poem":2},{"lineBreak":true},{"text":"nikech in ema apondo kuomi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mad bidhruok gi ngima moriere rita","poem":1},{"text":"nikech genona ni kuomi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Res Israel, yaye Nyasaye,","poem":1},{"text":"kuom chandruok mage duto!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}