{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":27,"content":[{"type":"hebrew_subtitle","content":["Zaburi mar Daudi."]},{"type":"verse","number":1,"content":[{"text":"Jehova Nyasaye e lerna kendo e warruokna;","poem":1},{"text":"en ngʼa ma daluor?","poem":2},{"text":"Jehova Nyasaye e kama ngimana opondoe.","poem":1},{"text":"En ngʼa ma dibwoga?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ka joma richo lawa","poem":1},{"text":"mondo oketh ngimana,","poem":2},{"text":"ka wasika kod joma kedo koda monja,","poem":1},{"text":"to gibiro kier mi gipodhi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kata ka jolweny ogoyona agengʼa koni gi koni,","poem":1},{"text":"to chunya ok bi luor;","poem":2},{"text":"kata ka lweny otugorena,","poem":1},{"text":"to pod abiro mana bedo gi chir.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gimoro achiel kende ema akwayo Jehova Nyasaye,","poem":1},{"text":"ma e gima adwaro moloyo;","poem":2},{"text":"ni mondo adag e od Jehova Nyasaye","poem":1},{"text":"ndalo duto mag ngimana,","poem":2},{"text":"mondo achom wangʼa kuom ber mar Jehova Nyasaye","poem":1},{"text":"kendo amanye e hekalu mare.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nikech chiengʼ ma chandruok omaka","poem":1},{"text":"obiro panda maber e kar dakne;","poem":2},{"text":"obiro panda e kar pondo mar hembe maler","poem":1},{"text":"kendo obiro keta malo ewi lwanda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eka abiro bedo jaloch","poem":1},{"text":"ka aloyo wasigu duto molwora;","poem":2},{"text":"abiro timo misango mar pak ka akok gimor e hembe maler.","poem":1},{"text":"Abiro wer kendo abiro loso wende mamit ne Jehova Nyasaye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Winj dwonda ka aluongo, yaye Jehova Nyasaye;","poem":1},{"text":"kecha kendo idwoka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Chunya wuoyo kuomi kawacho niya,","poem":1},{"text":"“Many wangʼ Nyasaye ka ilemo!”","poem":2},{"lineBreak":true},{"text":"Wangʼi, yaye Jehova Nyasaye, ema abiro manyo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kik ipandna wangʼi,","poem":1},{"text":"kik iriemb jatichni ka mirima omaki,","poem":2},{"lineBreak":true},{"text":"in ema isebedo jakonyna.","poem":2},{"text":"Kik ikweda bende kik ijwangʼa,","poem":1},{"text":"yaye Nyasaye Jawarna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kata obedo ni wuonwa gi minwa ojwangʼa","poem":1},{"text":"to Jehova Nyasaye biro rwaka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Puonja yoreni, yaye Jehova Nyasaye;","poem":1},{"text":"telna e yo moriere tir,","poem":2},{"lineBreak":true},{"text":"nikech joma sanda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kik ijwangʼa ne dwach wasika,","poem":1},{"text":"nikech joneno mag miriambo oramona matek,","poem":2},{"lineBreak":true},{"text":"ka gichano mar hinya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"To an gi ratiro kuom wachni:","poem":1},{"text":"ni pod abiro neno ber Jehova Nyasaye,","poem":2},{"lineBreak":true},{"text":"e piny joma ngima.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Gen kuom Jehova Nyasaye;","poem":1},{"text":"bed motegno ka in gi chir,","poem":2},{"lineBreak":true},{"text":"kendo rit kuom Jehova Nyasaye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}