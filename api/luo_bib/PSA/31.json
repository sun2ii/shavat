{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":31,"content":[{"type":"hebrew_subtitle","content":["Kuom jatend wer. Zaburi mar Daudi."]},{"type":"verse","number":1,"content":[{"text":"Kuomi ema aseponde, yaye Jehova Nyasaye,","poem":1},{"text":"kik iwe ayud wichkuot;","poem":2},{"lineBreak":true},{"text":"gola e chandruok nikech timni makare.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Winj ywakna,","poem":1},{"text":"kendo bi piyo mondo iresa;","poem":2},{"text":"bed lwandana mar pondo,","poem":1},{"text":"kendo ohinga motegno manyalo resa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kaka in lwandana kendo ohingana,","poem":1},{"text":"telna kendo itaya nikech nyingi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gola oko e obadho mopondo mochikna","poem":1},{"text":"nikech in e kar pondona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aketo chunya e lweti;","poem":1},{"text":"resa, yaye Jehova Nyasaye, ma Nyasaye mar adiera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Asin gi joma lamo nyiseche manono ma dhano oloso;","poem":1},{"text":"an to aketo genona kuom Jehova Nyasaye.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abiro bedo mamor kendo moil kuom herani,","poem":1},{"text":"nikech ne ineno chandruokna,","poem":2},{"lineBreak":true},{"text":"kendo ne ingʼeyo lit mar chunya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ok iseketa e lwet jawasigu","poem":1},{"text":"to iseguro tiendena kama lach.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kecha, yaye Jehova Nyasaye, nikech an e chandruok;","poem":1},{"text":"wengena ojony nikech ywak,","poem":2},{"lineBreak":true},{"text":"kendo chunya gi ringra bende nigi lit.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngimana rem chamo","poem":1},{"text":"kendo higni maga opongʼ gi chur;","poem":2},{"text":"tekona rumo nikech lit ma an-go","poem":1},{"text":"kendo chokena doko mayom yom.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nikech wasigu olwora mangʼeny,","poem":1},{"text":"joma odak koda koro ochaya gi chunygi;","poem":2},{"text":"alich kata mana ni osiepena","poem":1},{"text":"kendo joma onena e wangʼ yo ringa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wigi owil koda mana ka gima ne asetho chon","poem":1},{"text":"bende koro achalo mana gi agulu motore.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nikech awinjo ayany mangʼeny ma ji yanyago,","poem":1},{"text":"kihondko olwora koni gi koni;","poem":2},{"text":"gikuodho kaka digitimna marach","poem":1},{"text":"kendo gichano mar kawo ngimana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"To an aketo mana genona kuomi, yaye Jehova Nyasaye;","poem":1},{"text":"kendo awacho niya, “In e Nyasacha.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndalona ni e lweti;","poem":1},{"text":"resa e lwet wasika,","poem":2},{"lineBreak":true},{"text":"kendo kuom joma lawa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mad ibed mamor gi jatichni;","poem":1},{"text":"resa gi herani ma ok rum.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kik iwe wiya kuodi, yaye Jehova Nyasaye,","poem":1},{"text":"nikech aseywakni ka alemo;","poem":2},{"text":"to we joma timbegi richo oyud wichkuot","poem":1},{"text":"kendo ginindi ka gilingʼ thi ei liel.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mi dhogi mawacho miriambo mondo olingʼ;","poem":1},{"text":"nikech sungagi kod chuny marach ma gin-go,","poem":2},{"lineBreak":true},{"text":"omiyo giwuoyo gi wich teko kuom joma kare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mano kaka berni duongʼ,","poem":1},{"text":"ber mikano ne joma oluori,","poem":2},{"text":"mimiyo joma opondo kuomi","poem":1},{"text":"ka ji duto neno.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ipandogi e bwombi iwuon","poem":1},{"text":"mondo joma richo kik hinygi;","poem":2},{"text":"iritogi maber e kar dak mari","poem":1},{"text":"kuom lew joma hangonigi wach.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Pak obed ni Jehova Nyasaye,","poem":1},{"text":"nikech ne onyisa herane maduongʼ,","poem":2},{"lineBreak":true},{"text":"kane an e dala ma wasigu ogoyona agengʼa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kane chandruok omaka to ne awacho ni,","poem":1},{"text":"“Opoga kodi!”","poem":2},{"text":"Kata kamano ne iwinja ka aywakni","poem":1},{"text":"mondo ikecha kane aluongi mondo ikonya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Heruru Jehova Nyasaye un joge maler duto!","poem":1},{"text":"Jehova Nyasaye rito ngima joma jo-adiera,","poem":2},{"lineBreak":true},{"text":"to josunga to ochulo moromo chuth.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Beduru motegno kendo jiwuru chunyu,","poem":1},{"text":"un duto mugeno kuom Jehova Nyasaye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}