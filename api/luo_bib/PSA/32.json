{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":32,"content":[{"type":"hebrew_subtitle","content":["Zaburi mar Daudi. Wer mower gi maskil."]},{"type":"verse","number":1,"content":[{"text":"Ogwedh ngʼat","poem":1},{"text":"ma kethone owene,","poem":2},{"lineBreak":true},{"text":"kendo ma richone oseruchi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ogwedh ngʼatno","poem":1},{"text":"ma Jehova Nyasaye ok kwan-ne richone,","poem":2},{"lineBreak":true},{"text":"kendo ma wuondruok onge e chunye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kane alingʼ","poem":1},{"text":"to chokena ne ochiyore,","poem":2},{"lineBreak":true},{"text":"kane achur odiechiengʼ duto ma ok aywe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nikech odiechiengʼ gotieno","poem":1},{"text":"lweti ne pek kuoma;","poem":2},{"text":"tekrena ne oduono","poem":1},{"text":"mana kaka timore e liet mar ndalo oro. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Eka ne ahulo richona","poem":1},{"text":"kendo ne ok apando timbena mag ketho.","poem":2},{"text":"Ne awacho niya,","poem":1},{"text":"“Abiro hulo ketho chik maga ne Jehova Nyasaye.”","poem":2},{"text":"Omiyo ne iweyona ketho mane richona okelo. Sela","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kuom mano, owinjore ji duto moluoro Nyasaye olami","poem":1},{"text":"kapod inyalo yudi;","poem":2},{"text":"adier ka pige madongo otugore,","poem":1},{"text":"to ok gibi chopo ire,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"In e kar pondona;","poem":1},{"text":"ibiro rita e chandruok,","poem":2},{"lineBreak":true},{"text":"kendo ibiro lwora gi wende mag loch. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Abiro chiki kendo abiro puonji e yo monego ilu;","poem":1},{"text":"adier abiro ngʼadoni rieko kendo abiro rangi maber.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kik ichal gi farese kata gi punda,","poem":1},{"text":"maonge gi rieko,","poem":2},{"text":"manyaka chiki mana ka otwe dhoge kendo iywayo gi kamba,","poem":1},{"text":"nono to ok gibi buti.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lit mochomo joma timbegi richo ngʼeny,","poem":1},{"text":"to hera ma ok rum mar Jehova Nyasaye,","poem":2},{"lineBreak":true},{"text":"olworo ngʼat mogeno kuome.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Beduru moil kuom Jehova Nyasaye, kendo beduru mamor, un joma kare;","poem":1},{"text":"weruru, un duto ma urieru tir gie chunyu!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}