{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":42,"content":[{"type":"hebrew_subtitle","content":["Kuom jatend wer. Maskil",{"noteId":7},"mar yawuot Kora."]},{"type":"verse","number":1,"content":[{"text":"Mana kaka mwanda gamo yweyo kamanyo kuonde ma pi nitie,","poem":1},{"text":"e kaka chunya dwari, yaye Nyasaye.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Chunya riyo oloyo mar dwaro Nyasaye.","poem":1},{"text":"En riyo mar dwaro Nyasaye mangima.","poem":2},{"lineBreak":true},{"text":"Abiro dhi romo kod Nyasaye karangʼo?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aseywak mi pi wangʼa osechalo chiemba","poem":1},{"text":"odiechiengʼ gotieno,","poem":2},{"text":"ka ji to wachona odiechiengʼ duto niya,","poem":1},{"text":"“Koro ere Nyasachino?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Aparo gigi duto","poem":1},{"text":"ka chunya opongʼ giywak:","poem":2},{"text":"aparo kaka ne adhi gi oganda maduongʼ","poem":1},{"text":"ka atelo ni ji madhi e od Nyasaye,","poem":2},{"text":"Ka akok gimor kendo agoyo erokamano","poem":1},{"text":"E dier oganda maduongʼ matimo nyasi gi mor.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Angʼo momiyo ikuyo, yaye chunya?","poem":1},{"text":"Angʼo momiyo inyosori yaye chunya?","poem":2},{"text":"Ket genoni kuom Nyasaye,","poem":1},{"text":"nikech pod abiro pake,","poem":2},{"lineBreak":true},{"text":"kaka Jawarna kendo Nyasacha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Chunya lit;","poem":1},{"text":"omiyo abiro pari,","poem":2},{"text":"ka an e piny mar Jordan,","poem":1},{"text":"gi kuonde motingʼore mar Hermon kod e got Mizar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kut luongore gi kut","poem":1},{"text":"ei abururu mar pi;","poem":2},{"text":"apaka magi duto gi ahiti mager","poem":1},{"text":"oseywera motera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jehova Nyasaye chiko herane godiechiengʼ,","poem":1},{"text":"to gotieno to wende ni e chunya;","poem":2},{"text":"ma e lamo ma alamogo Nyasach ngimana.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Awacho ni Nyasaye ma lwandana niya,","poem":1},{"text":"“Angʼo momiyo wiyi osewil koda?","poem":2},{"text":"Angʼo momiyo asiko gi kuyo","poem":1},{"text":"ka jawasigu sanda?”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Chokena tho omako kendo rama malit","poem":1},{"text":"seche ma joma kedo koda yanya kochaya,","poem":2},{"text":"ka giwachona odiechiengʼ duto niya,","poem":1},{"text":"“Koro ere Nyasachino?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Angʼo momiyo ikuyo, yaye chunya?","poem":1},{"text":"Angʼo momiyo inyosori, yaye chunya?","poem":2},{"text":"Ket genoni kuom Nyasaye,","poem":1},{"text":"nikech pod abiro pake,","poem":2},{"lineBreak":true},{"text":"en e Jawarna kendo Nyasacha.","poem":2}]}],"footnotes":[{"noteId":7,"caller":"+","text":"Maskil: en kit wer moro mane Daudi owero.","reference":{"chapter":42,"verse":0}}]},"thisChapterLink":"/api/luo_bib/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}