{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Ngʼadna bura makare, yaye Nyasaye,","poem":1},{"text":"kendo chwaka e kind joma ok ongʼeyo Nyasaye;","poem":2},{"lineBreak":true},{"text":"resa e lwet joma wuondore gi joma timbegi richo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"In Nyasaye ma apondo kuome.","poem":1},{"text":"Koro to ijwangʼa nangʼo?","poem":2},{"text":"Angʼo momiyo nyaka asik ka akuyo,","poem":1},{"text":"ka jawasigu sanda?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Or lerni kod adierani,","poem":1},{"text":"orgi mondo gitelna;","poem":2},{"text":"yie mondo gikela nyaka godi maler,","poem":1},{"text":"nyaka kama idakie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Eka anadhi e kendo mar misango mar Nyasaye,","poem":1},{"text":"nyaka achopi e nyim Nyasaye,","poem":2},{"lineBreak":true},{"text":"Nyasaye ma kelona mor kendo ilo.","poem":2},{"text":"Abiro paki gi nyatiti,","poem":1},{"text":"yaye Nyasaye kendo Nyasacha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Angʼo momiyo ikuyo, yaye chunya?","poem":1},{"text":"Angʼo momiyo inyosori, yaye chunya?","poem":2},{"text":"Ket genoni kuom Nyasaye,","poem":1},{"text":"nikech pod abiro pake,","poem":2},{"lineBreak":true},{"text":"en e Jawarna kendo Nyasacha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}