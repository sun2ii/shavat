{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["Kuom jatend wer. Zaburi mar yawuot Kora."]},{"type":"verse","number":1,"content":[{"text":"Pamuru lweteu, un ogendini duto;","poem":1},{"text":"Pakuru Nyasaye ka ukok matek gi mor.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mano kaka Jehova Nyasaye Man Malo Moloyo lich,","poem":1},{"text":"en Ruoth Maduongʼ man-gi loch e piny duto!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ne oloyonwa ogendini mi gibet e bwowa,","poem":1},{"text":"ji nopodho piny e tiendewa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ne oyieronwa girkeni marwa,","poem":1},{"text":"gik mabeyo mogik ne Jakobo mane ohero. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nyasaye oseidho malo ka ji pake gi mor.","poem":1},{"text":"Jehova Nyasaye osetingʼ malo ka dwond turumbete ywak.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Weruru wende pak ne Nyasaye, weruru wende pak;","poem":1},{"text":"weruru wende pak ne Ruodhwa, weruru wende pak.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nikech Nyasaye en Ruodh piny duto,","poem":1},{"text":"werneuru zaburi mar pak.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nyasaye nigi loch ewi ogendini;","poem":1},{"text":"Nyasaye obet piny e kom lochne maler.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jotend ogendini ochokore kaachiel","poem":1},{"text":"kaka jo-Nyasach Ibrahim,","poem":2},{"text":"nikech ruodhi mag piny gin mag Nyasaye;","poem":1},{"text":"omiyo Nyasaye oyud duongʼ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}