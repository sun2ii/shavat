{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":5,"content":[{"type":"hebrew_subtitle","content":["Kuom jatend wende miwero gi asili. Zaburi Mar Daudi."]},{"type":"verse","number":1,"content":[{"text":"Chik iti mondo iwinj wechena, yaye Jehova Nyasaye,","poem":1},{"text":"para kuom pek manie chunya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Winj ywakna mar dwaro kony,","poem":1},{"text":"Yaye Ruodha kendo Nyasacha,","poem":2},{"lineBreak":true},{"text":"nikech in ema alami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yie iwinj dwonda gokinyi, yaye Jehova Nyasaye;","poem":1},{"text":"aketo kwayona e nyimi gokinyi,","poem":2},{"lineBreak":true},{"text":"kendo arito dwoko ka an gi geno.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ok in Nyasaye mamor gi timbe maricho.","poem":1},{"text":"Joma richo ok nyal dak kodi kanyachiel.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Josunga ok nyal chungʼ e nyimi;","poem":1},{"text":"imon gi ji duto matimo gik maricho.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Itieko joma wacho miriambo;","poem":1},{"text":"Jehova Nyasaye ok mor gi joma dwaro chwero remo,","poem":2},{"lineBreak":true},{"text":"kod jo-miriambo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"An to, nikech kechni maduongʼ,","poem":1},{"text":"abiro donjo e odi;","poem":2},{"text":"abiro kulora gi luor","poem":1},{"text":"ka achomo hekalu mari maler.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Telna, yaye Jehova Nyasaye, kuom adiera mari,","poem":1},{"text":"nikech wasigu molwora,","poem":2},{"lineBreak":true},{"text":"yie iriena yori tir e nyima.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kata wach achiel mowuok e dho jogi ok nyal gen;","poem":1},{"text":"chunygi opongʼ gi kethruok.","poem":2},{"text":"Dwondgi chalo gi liel mapok oum;","poem":1},{"text":"lewgi olony e wacho miriambo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kwan-gi kaka joketho, yaye Nyasaye!","poem":1},{"text":"Ket obadho ma giketo ne ji ogajgi gin giwegi.","poem":2},{"text":"Riembgi nikech richogi mathoth,","poem":1},{"text":"nimar gisengʼanyoni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"We ji duto moketi kar pondo margi obed mamor;","poem":1},{"text":"we gisiki ka giwer gimor.","poem":2},{"text":"Umgi gi rit mari,","poem":1},{"text":"mondo joma ohero nyingi omor kodi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nikech igwedho joma kare adier, yaye Jehova Nyasaye;","poem":1},{"text":"igengʼogi gi hapi mana ka okumba.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}