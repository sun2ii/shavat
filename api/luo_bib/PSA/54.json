{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["Kuom jatend wer. Wer miwero gi thumbe man-gi waya. Maskil",{"noteId":14},"mar Daudi. Kane jo-Zif osedhi ir Saulo kendo onyise niya, “Donge Daudi ma imanyo opondo e gwengʼwa?”"]},{"type":"verse","number":1,"content":[{"text":"Resa gi nyingi, yaye Nyasaye;","poem":1},{"text":"ngʼadna bura kare gi tekoni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Winj lamona, yaye Nyasaye;","poem":1},{"text":"chik iti ne weche mawuok e dhoga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jopinje moko monja;","poem":1},{"text":"acheje kawo ngimana,","poem":2},{"lineBreak":true},{"text":"gin joma ok dew Nyasaye. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Adier, Nyasaye e jakonyna;","poem":1},{"text":"Ruoth owuon ema rita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mad chandruok lwor joma ketho nyinga mi ketgi diere;","poem":1},{"text":"tiekgi, nikech in ja-adiera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Abiro timoni misango gi chiwo mar hera;","poem":1},{"text":"abiro pako nyingi, yaye Jehova Nyasaye, nikech nyingi ber.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nikech oseresa kuom gik mathaga duto,","poem":1},{"text":"mi omiyo wengena ongʼiyo wasika tir bangʼ loyogi.","poem":2}]}],"footnotes":[{"noteId":14,"caller":"+","text":"Maskil: en kit wer moro mane Daudi owero","reference":{"chapter":54,"verse":0}}]},"thisChapterLink":"/api/luo_bib/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}