{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":55,"content":[{"type":"hebrew_subtitle","content":["Kuom jatend wer. Wer gi thumbe man-gi Waya. Maskil",{"noteId":15},"mar Daudi."]},{"type":"verse","number":1,"content":[{"text":"Winj lamona, yaye Nyasaye,","poem":1},{"text":"kik itamri winjo ywakna;","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Winja kendo idwoka.","poem":2},{"text":"Pacha chanda kendo chunya onge gi kwe","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Ka awinjo dwond wasika,","poem":2},{"lineBreak":true},{"text":"kendo ka joma timbegi richo okwarona wengegi,","poem":2},{"text":"nikech gimiyo abedo gi thagruok","poem":1},{"text":"kendo giyanya ka gin gi mirima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Chunya winjo malit e iya","poem":1},{"text":"kendo luoro mar tho osemaka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aluor kendo denda tetni;","poem":1},{"text":"kibaji ogoya matek.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne awacho niya, “Yaye mad ne bed ni an gi bwombe ka akuru!","poem":1},{"text":"Dine afuyo aa ka mi ayudo yweyo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dine aringo adhi mabor","poem":1},{"text":"mi adhi adak e piny ongoro; Sela","poem":2}]},{"type":"verse","number":8,"content":[{"text":"dine areto adhi nyaka kara mar pondo,","poem":1},{"text":"kuma ni mabor gi apaka kod ahiti.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Lal pach joma timbegi richo, yaye Ruoth,","poem":1},{"text":"mi lewgi moki e dandgi,","poem":2},{"lineBreak":true},{"text":"nikech aneno ka mahundu gi dhawo opongʼo dala maduongʼ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Odiechiengʼ gotieno gilwenyo kor ohinga mare;","poem":1},{"text":"himruok gi ayany ni e iye.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Teko mar kethruok chopo tijgi ei dala maduongʼ,","poem":1},{"text":"mecho gi wuond osiko e yorene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ka dine ok obedo malichna ka dine ngʼat ma ok dwara ema ogarna,","poem":1},{"text":"to dine apondone.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"To en mana in, dichwo kaka an in jawuodha","poem":1},{"text":"kendo osiepna,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"mane wan-go gi lalruok matut","poem":1},{"text":"chon kane wawuotho e dier oganda maduongʼ e od Nyasaye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mad tho neg wasika apoya,","poem":1},{"text":"mad liel mwonygi ngili kapod gingima,","poem":2},{"lineBreak":true},{"text":"nikech richo olokogi kar dakne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"An to aluongo Nyasaye,","poem":1},{"text":"kendo Jehova Nyasaye resa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Odhiambo gi okinyi kod odiechiengʼ","poem":1},{"text":"aywagora ka chunya lit,","poem":2},{"lineBreak":true},{"text":"kendo owinjo dwonda.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Owara kapok gimoro ohinya","poem":1},{"text":"kuom lweny ma ji goyago,","poem":2},{"lineBreak":true},{"text":"kata obedo ni ji mangʼeny kweda.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nyasaye mobet e kom loch nyaka chiengʼ,","poem":1},{"text":"biro winjogi kendo biro goyogi: Sela","poem":2},{"text":"jogo motamore loko yoregi","poem":1},{"text":"kendo ma ok mi Nyasaye luor.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Jawuodha monjo osiepene;","poem":1},{"text":"oseketho singruok mane otimo kodgi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Weche mowacho to yom ka mo mabuo,","poem":1},{"text":"to lweny to ni e chunye;","poem":2},{"text":"wechege yomo del moloyo mor wirruok,","poem":1},{"text":"to kara gin mana ligangla mosewuodh oko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ket pek manie chunyi ne Jehova Nyasaye","poem":1},{"text":"to obiro riti;","poem":2},{"lineBreak":true},{"text":"ok obi weyo ngʼat makare podhi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"To in, yaye Nyasaye,","poem":1},{"text":"ibiro dwoko joma timbegi richo piny nyaka","poem":2},{"lineBreak":true},{"text":"ei bur ma gitow;","poem":2},{"text":"joma joricho machwero remo","poem":1},{"text":"ok bi bet mangima kata moromo nus ndalogi.","poem":2},{"lineBreak":true},{"text":"An to ageno kuomi.","poem":1}]}],"footnotes":[{"noteId":15,"caller":"+","text":"Maskil: en kit wer moro mane Daudi owero","reference":{"chapter":55,"verse":0}}]},"thisChapterLink":"/api/luo_bib/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}