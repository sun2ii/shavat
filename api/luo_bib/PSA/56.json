{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":56,"content":[{"type":"hebrew_subtitle","content":["Kuom jatend wer. E dwol mar “Akuru mopiyo e onera man mabor.” Miktam",{"noteId":16},"mar Daudi. Kane jo-Filistia osemake Gath."]},{"type":"verse","number":1,"content":[{"text":"Kecha, yaye Nyasacha,","poem":1},{"text":"nikech wasika dwaro monja;","poem":2},{"lineBreak":true},{"text":"odiechiengʼ duto gidiya ma ok aywe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Joketh nyinga lawa odiechiengʼ duto;","poem":1},{"text":"ji mangʼeny monja ka sunga omakogi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ka luoro omaka","poem":1},{"text":"to abiro geno kuomi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kuom Nyasaye ma apako wachne,","poem":1},{"text":"in Nyasaye ema aketo genona kuomi omiyo ok abi bedo maluor.","poem":2},{"lineBreak":true},{"text":"Dhano adhana to nyalo timona angʼo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Odiechiengʼ duto gimino koda wach;","poem":1},{"text":"kinde duto gichano kaka digihinya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gikuotho kendo gijimbo wach,","poem":1},{"text":"ginono okangʼ ka okangʼ ma agoyo,","poem":2},{"lineBreak":true},{"text":"ka gidwaro kawo ngimana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kik iyie gitony kata matin nikech richo mag-gi,","poem":1},{"text":"dwok ogendini piny, yaye Nyasaye, gi mirimbi;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndik ywak ma aywakgo","poem":1},{"text":"kwan pi wangʼa machwer e kitapi,","poem":2},{"lineBreak":true},{"text":"donge iketogi e kitabu mari?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Eka wasika biro gomo dok","poem":1},{"text":"ka aluongo kony moa kuomi.","poem":2},{"lineBreak":true},{"text":"Mano ema abiro ngʼeyogo ni Nyasaye en jakora.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kuom Nyasaye ma apako wachne,","poem":1},{"text":"in Jehova Nyasaye ema apako wachne,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"kendo Nyasaye ema aketo genona kuome;","poem":1},{"text":"omiyo ok abi bedo maluor.","poem":2},{"lineBreak":true},{"text":"Dhano adhana to nyalo timona angʼo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Asetimo kodi singruok, yaye Nyasaye;","poem":1},{"text":"abiro chiwoni chiwo maga mag erokamano.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nikech iseresa e tho","poem":1},{"text":"kendo isegengʼo tienda mi ok ochwanyore,","poem":2},{"text":"mondo mi awuothi e nyim Nyasaye","poem":1},{"text":"ma en e ler makelo ngima.","poem":2}]}],"footnotes":[{"noteId":16,"caller":"+","text":"Miktam: Ochalo ni en kit wer moro","reference":{"chapter":56,"verse":0}}]},"thisChapterLink":"/api/luo_bib/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}