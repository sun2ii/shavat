{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["Kuom jatend wer. Gi gig wer man-gi tondegi. Mar Daudi."]},{"type":"verse","number":1,"content":[{"text":"Winj ywakna, yaye Nyasaye;","poem":1},{"text":"chik iti ne lamona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Aluongi gie tungʼ piny,","poem":1},{"text":"aluongi ka chunya ool;","poem":2},{"lineBreak":true},{"text":"telna nyaka lwanda mohinga gi bor.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nikech in ema isebedo kar pondona,","poem":1},{"text":"isebedona ohinga motegno maponde ne jasigu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Agombo dak e hembi nyaka chiengʼ","poem":1},{"text":"mondo apondie e raum mar bwombeni. Sela","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nikech isewinjo singruokna kodi, yaye Nyasaye;","poem":1},{"text":"isemiya gweth mikano ne joma oluoro nyingi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Med ndalo mar ngima ruoth,","poem":1},{"text":"mede higni e tienge mangʼeny.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mi obed e kom loch e nyim Nyasaye nyaka chiengʼ;","poem":1},{"text":"ket herani kod adierani mondo orite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Eka anasik ka apako nyingi gi wer","poem":1},{"text":"kendo abiro chopo singruokna kodi odiechiengʼ kodiechiengʼ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}