{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"hebrew_subtitle","content":["Zaburi mar Daudi kane en e thim mar Juda."]},{"type":"verse","number":1,"content":[{"text":"Yaye Nyasaye, in e Nyasacha,","poem":1},{"text":"adwari gi tekra duto;","poem":2},{"text":"chunya riyo oloyo mar neni","poem":1},{"text":"kendo denda duto dwari,","poem":2},{"text":"e piny motwo kendo maliet,","poem":1},{"text":"maonge pi modho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Aseneni ei kari maler","poem":1},{"text":"kendo asengʼeyo tekoni gi duongʼni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nikech herani ber moloyo ngima,","poem":1},{"text":"dhoga biro miyi duongʼ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abiro paki kapod angima,","poem":1},{"text":"kendo abiro tingʼo bedena malo e nyingi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Chunya biro romo mana ka ngʼama oromo gi chiemo mabeyo mogik;","poem":1},{"text":"abiro yawo dwonda ka apaki gi wer.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ka an e kitandana to apari;","poem":1},{"text":"pacha osiko pari seche duto mag otieno.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nikech in e konyruokna,","poem":1},{"text":"awer ka an e bwo tipo mar bwombeni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Chunya omoko kuomi;","poem":1},{"text":"lweti ma korachwich orita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Joma dwaro kawo ngimana ibiro tieki;","poem":1},{"text":"gibiro dhi piny nyaka ei bur kama tut.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ibiro chiwgi ne ligangla","poem":1},{"text":"kendo gibiro doko chiemb ondiegi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"To ruoth to biro bedo moil kuom Nyasaye;","poem":1},{"text":"ji duto masingore e nying Nyasaye biro pake,","poem":2},{"lineBreak":true},{"text":"to dho jo-miriambo ibiro um mi lingʼ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}