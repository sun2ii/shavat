{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":65,"content":[{"type":"hebrew_subtitle","content":["Kuom jatend wer. Zaburi mar Daudi. Wer."]},{"type":"verse","number":1,"content":[{"text":"Pak riti e dala mar Sayun, yaye Nyasaye,","poem":1},{"text":"wabiro rito singruokwa duto.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yaye in miwinjo lamo,","poem":1},{"text":"in ema ji duto biro biro iri.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kane richowa turowa,","poem":1},{"text":"iweyonwa kethowa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Joma iyiero gin joma ogwedhi,","poem":1},{"text":"jogo ma ikelo machiegni mondo odag e hekalu mari!","poem":2},{"text":"Gik mabeyo mowuok e odi oromowa chuth,","poem":1},{"text":"mana gigo moa e hekalu mari maler.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Idwokowa gi timbe madongo makare,","poem":1},{"text":"yaye Nyasaye ma Jawarwa,","poem":2},{"text":"yaye geno mar piny koni gi koni","poem":1},{"text":"kendo mar nembe man maboyo mogik,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"in mane iloso gode gi tekoni iwuon","poem":1},{"text":"kane imanori gi teko,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"in mane imiyo nembe olingʼ,","poem":1},{"text":"wuo mar apaka margi,","poem":2},{"lineBreak":true},{"text":"kod koko mag ogendini.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Joma odak kuonde maboyo oluoro timbeni miwuoro,","poem":1},{"text":"imiyo ji werni gimor,","poem":2},{"lineBreak":true},{"text":"kuma okinyi yaworee kendo odhiambo rumoe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Irito piny kendo iolone pi,","poem":1},{"text":"imiyo obedo momew moromo chuth.","poem":2},{"text":"Aore mag Nyasaye opongʼ gi pi","poem":1},{"text":"mamiyo ji bedo gi cham,","poem":2},{"lineBreak":true},{"text":"nimar kamano e kaka ne ichano chon.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ipuro puothene","poem":1},{"text":"kendo iloso oparane duto.","poem":2},{"text":"Imiyo puothene bedo mangʼich,","poem":1},{"text":"kendo igwedhe gi cham.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Igwedho higa gi cham mogundho,","poem":1},{"text":"kendo gechegi mwandu opongʼo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Pewe motimo lum mag piny ongoro ngʼich oromo;","poem":1},{"text":"kendo gode opongʼ gi mor.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lek duto jamni kwaye ka giwinjo maber","poem":1},{"text":"kendo holni cham mochiek odhure;","poem":2},{"lineBreak":true},{"text":"gikok gimor kendo giwer.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}