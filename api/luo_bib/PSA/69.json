{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":69,"content":[{"type":"hebrew_subtitle","content":["Kuom jatend wer e dwol mar “Ondanyo.” Mar Daudi."]},{"type":"verse","number":1,"content":[{"text":"Resa, yaye Nyasaye,","poem":1},{"text":"nikech pi oseima nyaka e ngʼuta.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Asechako nimo e chwodho matut,","poem":1},{"text":"kama onge lowo motegno ma ngʼato nyalo chungʼie.","poem":2},{"text":"Asechopo e chuny pi kama tut,","poem":1},{"text":"kendo apaka olwora oketa diere.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Koro aseywak mondo okonya mi aol;","poem":1},{"text":"dwonda rewni.","poem":2},{"text":"Wengena pek,","poem":1},{"text":"ka amanyo Nyasacha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Joma ochaya maonge gima omiyo","poem":1},{"text":"ngʼeny moloyo yie wiya;","poem":2},{"text":"joma olokore wasika kayiem thoth adier,","poem":1},{"text":"jogogo madwaro mondo otieka.","poem":2},{"text":"Ichuna mondo adwok","poem":1},{"text":"gima ne ok akwalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ingʼeyo fupa, yaye Nyasaye;","poem":1},{"text":"kethona ok opondoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mad joma ogeno kuomi","poem":1},{"text":"kik ne wichkuot nikech an,","poem":2},{"lineBreak":true},{"text":"yaye Ruoth, Jehova Nyasaye Maratego;","poem":2},{"text":"mad joma manyi","poem":1},{"text":"kik ne wichkuot nikech an,","poem":2},{"lineBreak":true},{"text":"yaye Nyasach Israel.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nimar ji yanya to alingʼ alingʼa nikech in,","poem":1},{"text":"kendo wichkuot obako lela wangʼa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Achalo wendo ne owetena","poem":1},{"text":"an kaka jamwa ne yawuot minwa;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"nikech hera matut ma aherogo odi tieka,","poem":1},{"text":"kendo ayenje mag joma yanyi lwar kuoma.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ka aywak kendo atweyo chiemo","poem":1},{"text":"to pod nyaka ayud ayany;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ka arwako law ywak,","poem":1},{"text":"to ji oloka ngero.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Joma obet e rangach jara,","poem":1},{"text":"kendo alokora wer ma jokongʼo wero.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"To alami, yaye Jehova Nyasaye,","poem":1},{"text":"e kinde ma iikori mar konya;","poem":2},{"text":"kuom herani maduongʼ, yaye Nyasaye,","poem":1},{"text":"dwoka gi resruok mari mar adier.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Gola oko e chwodho,","poem":1},{"text":"kik iyie anim;","poem":2},{"text":"resa e lwet joma ochaya,","poem":1},{"text":"gola e chuny pi kama tut.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kik iwe ohula ywera mi tera","poem":1},{"text":"kata kut mwonya duto,","poem":2},{"lineBreak":true},{"text":"kata bur matut um dhoge ka an e iye.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dwoka, yaye Jehova Nyasaye, dwoka, nikech herani ber;","poem":1},{"text":"lokri ira kuom kechni maduongʼ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kik ipand wangʼi ne jatichni;","poem":1},{"text":"dwoka piyo, nikech anie chandruok.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bi machiegni mondo ikonya,","poem":1},{"text":"resa nikech joma kedo koda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ingʼeyo kaka ijara, kaka ikuodo wiya kendo kaka aneno wichkuot;","poem":1},{"text":"wasika duto ochoma tir.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ajara osechodo chunya","poem":1},{"text":"kendo aonge gi kar kony.","poem":2},{"text":"Ne amanyo joma hoya,","poem":1},{"text":"to ne ok ayudo kata achiel.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Negiketo kedhno e chiemba","poem":1},{"text":"kendo negimiya kong andwayo mondo otiekna riyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Mad mesa mochan e nyimgi lokre obadho;","poem":1},{"text":"kendo mad olokrenegi gir chulo kuor kod otegu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mad wengegi dinre mondo kik ginen","poem":1},{"text":"kendo oguchgi odolre nyaka chiengʼ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ol mirimbi kuomgi;","poem":1},{"text":"we mirimbi mager omakgi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mad miechgi dongʼ gundni;","poem":1},{"text":"kendo kik iyie ne ngʼato angʼata dag e hembgi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nimar gisando joma ihinyo","poem":1},{"text":"kendo giwuoyo kuom lit mag joma ihinyo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ket ketho e wigi kuom ketho ka ketho ma gitimo;","poem":1},{"text":"kendo kik iyie giyud warruok mari.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Mad ruch kargi oko e kitap joma ngima","poem":1},{"text":"kendo kik kwan-gi kaachiel gi joma kare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"An-gi rem kendo awinjo marach e chunya;","poem":1},{"text":"mad warruokni rita, yaye Nyasaye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Abiro pako nying Nyasaye gi wer","poem":1},{"text":"kendo abiro miyo nyinge duongʼ gi erokamano.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Mano biro miyo Jehova Nyasaye mor moloyo rwadh pur,","poem":1},{"text":"moloyo rwath mabwoch man-gi tungene kod ombongʼne.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Joma odhier biro neno mi gibed mamor,","poem":1},{"text":"un ma udwaro Nyasaye mad chunyu bed mangima!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Jehova Nyasaye winjo joma ochando","poem":1},{"text":"kendo ok olok ngʼeye ne joge motwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Piny gi polo mondo opake,","poem":1},{"text":"kaachiel gi nembe kod gik moko duto mawuothoe igi,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"nikech Nyasaye biro reso Sayun","poem":1},{"text":"kendo obiro gero dala mag Juda kendo.","poem":2},{"text":"Eka ji nodag kanyo kendo ginikawe kaka margi;","poem":1}]},{"type":"verse","number":36,"content":[{"text":"enobed girkeni mar koth jotichne,","poem":2},{"lineBreak":true},{"text":"kendo joma ohero nyinge nodag kanyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}