o;","poem":1},{"text":"bi ira piyo, yaye Nyasaye.","poem":2},{"text":"In e konyruokna kendo jaresna;","poem":1},{"text":"kik ideki, yaye Jehova Nyasaye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}