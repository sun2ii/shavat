{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":79,"content":[{"type":"hebrew_subtitle","content":["Zaburi mar Asaf."]},{"type":"verse","number":1,"content":[{"text":"Yaye Nyasaye, ogendini osemonjo girkeni mari;","poem":1},{"text":"gisedwanyo hekalu mari maler,","poem":2},{"lineBreak":true},{"text":"kendo giseketho Jerusalem modongʼ pidhe pidhe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gisechiwo ringre jogi motho","poem":1},{"text":"mondo obed chiemb winy manie kor polo,","poem":2},{"lineBreak":true},{"text":"ring jogi maler gisechiwo ne ondiegi mag piny.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Giseolo remo","poem":1},{"text":"e alwora mar Jerusalem ka pi,","poem":2},{"lineBreak":true},{"text":"kendo koro onge ngʼama nyalo yiko joma otho.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Waselokore gima kuodo wich ne jobutwa,","poem":1},{"text":"joma ijaro kendo inyiero gi joma olworowa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nyaka karangʼo, yaye Jehova Nyasaye? Ibiro kecho nyaka chiengʼ koso?","poem":1},{"text":"Nyaka karangʼo ma nyiego mari biro lielie ka mach?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ol mirimbi kuom pinjeruodhi,","poem":1},{"lineBreak":true},{"text":"adier ol mirimbi kuom ogendini","poem":1},{"text":"ma ok luong nyingi;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"nimar gisengamo Jakobo","poem":1},{"text":"mi giketho gwengʼe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kik ikwanwa kaka joketho,","poem":1},{"text":"nikech richo mag wuonewa;","poem":2},{"text":"mad kechni bi romnwa piyo,","poem":1},{"text":"nimar osedwokwa piny marach.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Konywa, yaye Nyasaye ma Jawarwa,","poem":1},{"text":"nikech duongʼ mar nyingi;","poem":2},{"text":"reswa kendo wenwa richowa,","poem":1},{"text":"mondo nyingi oyud duongʼ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Angʼo momiyo ogendini onego owach ni,","poem":1},{"text":"“Nyasachgino to ni kanye?”","poem":2},{"lineBreak":true},{"text":"Mi ogendini ongʼe, ka waneno gi wangʼwa,","poem":1},{"text":"ni ichulo kuor nikech remb jogi mosechwer.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mad chur ma joma otwe churgo chopi e nyimi;","poem":1},{"text":"rit ngima joma osengʼad nigi buch tho,","poem":2},{"lineBreak":true},{"text":"gi teko mar badi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Chul kuor ne jobutwa nyadibiriyo kigoyo bembegi.","poem":1},{"text":"Kuom ayany ma gisediro kuomi, yaye Jehova Nyasaye.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Eka jogi, ma gin rombegi mikwayo,","poem":1},{"text":"biro paki nyaka chiengʼ,","poem":2},{"text":"kendo wabiro nyiso pakni,","poem":1},{"text":"koa e tiengʼ moro nyaka tiengʼ machielo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}