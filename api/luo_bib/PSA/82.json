{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["Zaburi mar Asaf."]},{"type":"verse","number":1,"content":[{"text":"Nyasaye osekawo kare e dier chokruok maduongʼ,","poem":1},{"text":"ongʼado bura e kind “nyiseche.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nyaka karangʼo ma ubiro dhi nyime ka udewo wangʼ joma ok timbegi nikare","poem":1},{"text":"kendo kudewo wangʼ joma timbegi richo? Sela","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngʼaduru bura makare ne joma ok nyal kod nyithi kiye,","poem":1},{"text":"kendo konyuru joma odhier kod joma ok nyal konyore kendgi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Resuru joma ok nyal kod joma ochando;","poem":1},{"text":"golgiuru e lwet joma timbegi richo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"To gisesiko ka gimemore kendo onge gima gingʼeyo.","poem":1},{"text":"Giwuotho koni gi koni e mudho;","poem":2},{"lineBreak":true},{"text":"kendo gimiyo mise duto mag piny yiengni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Asenyisou ni, ‘Un “nyiseche;”","poem":1},{"text":"kendo ni un duto un yawuot Nyasaye Man Malo Moloyo.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"To ubiro tho ka ji ajia;","poem":1},{"text":"adier ubiro podho mana kaka jatelo moro amora ma ok otangʼ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Aa malo, yaye Nyasaye, ngʼadni piny bura,","poem":1},{"text":"nimar ogendini duto gin girkeni magi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}