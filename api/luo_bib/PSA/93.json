type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bucheni ochungʼ mongirore;","poem":1},{"text":"kendo ler opongʼo odi,","poem":2},{"lineBreak":true},{"text":"nyaka chiengʼ, yaye Jehova Nyasaye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}