{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"PSA","translationId":"luo_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"811b63734666fb97516830f88fbe45c576c4891885c371165842f8b3cdc4ef24","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/luo_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"Jehova Nyasaye e Ruoth,","poem":1},{"text":"ogendini mondo okirni;","poem":2},{"text":"obet e kom lochne e kind kerubi,","poem":1},{"text":"piny mondo oyiengni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jehova Nyasaye duongʼ miwuoro e Sayun;","poem":1},{"text":"otingʼe malo moyombo ogendini duto.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Owinjore gipak nyingi maduongʼ kendo miwuoro,","poem":1},{"text":"nyinge ler.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ruoth nyalo, ohero bura makare,","poem":1},{"text":"isechungo adiera;","poem":2},{"text":"isetimo ne joka Jakobo","poem":1},{"text":"gima adier kendo makare.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dhialuru Jehova Nyasaye ma Nyasachwa","poem":1},{"text":"kendo lameuru,","poem":2},{"lineBreak":true},{"text":"e tiend kome mobetie nikech oler.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Musa gi Harun ne gin jodolo mage e dier jodolo mamoko,","poem":1},{"text":"Samuel ne en achiel kuom joma ne luongo nyinge;","poem":2},{"text":"negiluongo Jehova Nyasaye","poem":1},{"text":"kendo nodwokogi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne owuoyo kodgi e siro mar bor polo;","poem":1},{"text":"negirito chikene gi buche mane omiyogi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yaye Jehova Nyasaye ma Nyasachwa,","poem":1},{"text":"ne idwokogi;","poem":2},{"text":"ne in Nyasaye maweyo richo ne jo-Israel,","poem":1},{"text":"kata obedo ni ne ikumo timbegi mobam.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tingʼuru nying Jehova Nyasaye ma Nyasachwa","poem":1},{"text":"kendo lamuru e gode maler,","poem":2},{"lineBreak":true},{"text":"nimar Jehova Nyasaye ma Nyasachwa ler.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}