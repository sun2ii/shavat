{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"SNG","translationId":"luo_bib","name":"Wer Mamit","commonName":"Wer Mamit","title":"Wer Mamit Moloyo Wende Moko Duto","order":22,"numberOfChapters":8,"sha256":"5650c39550fa2e5192944dd96c727dfa6e3012792d4a9b476ceae46fb526315d","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/luo_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"An maua madungʼ tik mamit mag Sharon,","poem":1},{"text":"bende an ondanyo madongo e holo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mana ka ondanyo motwi e dier kuthe","poem":1},{"text":"e kaka jaherana chalo e dier nyiri.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mana kaka yiend olemo mayom manie dier yiende mamoko mag bungu,","poem":1},{"text":"e kaka jaherana chalo e dier chwo matindo.","poem":2},{"text":"Amor ka abet e tipone,","poem":1},{"text":"kendo olembe milimili e dhoga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Osetera e od budho mare,","poem":1},{"text":"kendo herane oliero e wiya ka bendera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Miya jip gi olemb mzabibu mosemo e chiengʼ,","poem":1},{"text":"duog chunya gi olemo mayom,","poem":2},{"lineBreak":true},{"text":"nikech hera onura.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bade ma koracham oteno wiya","poem":1},{"text":"to bade ma korachwich okwaka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Un nyi Jerusalem, asiemou gi nying nyakech kod mwanda manie e thim,","poem":1},{"text":"ni kik utug hera kata chiewe ka sa ne pok oromo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lingʼane,","poem":1},{"text":"awinjo dwond jaherana kabiro!","poem":2},{"text":"Kochikore ewi gode kobiro,","poem":1},{"text":"kendo obiro kolengʼore ewi gode matindo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jaherana chalo gi mwanda manie thim.","poem":1},{"text":"Nene kaka ochungʼ e tok ohinga,","poem":2},{"text":"kongʼicho gie dirise manie kor ohinga,","poem":1},{"text":"kendo kongʼicho gie bath dirisa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jaherana nowuoyo kendo nowachona niya,","poem":1},{"text":"“Aa malo jaherana, bi wadhiyo,","poem":2},{"lineBreak":true},{"text":"yaye jaber.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ndalo chwiri osekalo;","poem":1},{"text":"koth osechok kendo oserumo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Maua osechako thiewo e puothe;","poem":1},{"text":"kinde mag wer osechopo,","poem":2},{"text":"ndalo ma akuch oduglani werie mamit","poem":1},{"text":"koro winjore e gwengʼwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yiend ngʼowu golo olembene mokwongo;","poem":1},{"text":"thiepe mag mzabibu keyo tikgi mamit.","poem":2},{"text":"Aa malo ibi, jaherana;","poem":1},{"text":"bi mondo wadhiyo, yaye jaber.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yaye akucha manie buche manie kor lwanda;","poem":1},{"text":"kuonde mopondo manie kor gode,","poem":2},{"text":"yie aneye wangʼi,","poem":1},{"text":"kendo yie awinjie dwondi;","poem":2},{"text":"nimar dwondi mit,","poem":1},{"text":"kendo wangʼi ber neno.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Maknwauru nyithind bwe ma pod tindo,","poem":1},{"text":"maketho puothewa mag mzabibu;","poem":2},{"text":"nikech dipo ka giketho mzabibuwa mosechako thiewo.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Jaherana en mara kendo an mare;","poem":1},{"text":"odongo maber e dier ondanyo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nyaka chop piny yawre","poem":1},{"text":"kendo tipo mag gik moko lal,","poem":2},{"text":"duog ira, jaherana,","poem":1},{"text":"mana kaka mwanda gi le mamoko ringo kadok e gode.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}