{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"SNG","translationId":"luo_bib","name":"Wer Mamit","commonName":"Wer Mamit","title":"Wer Mamit Moloyo Wende Moko Duto","order":22,"numberOfChapters":8,"sha256":"5650c39550fa2e5192944dd96c727dfa6e3012792d4a9b476ceae46fb526315d","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/luo_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Asebiro e puotha, yaye jaherana;","poem":1},{"text":"asechoko ubani gi modhi madungʼ tik mangʼwe ngʼar,","poem":2},{"text":"asechamo pednina kaachiel kod mor kich mara;","poem":1},{"text":"kendo asemadho divaina kod chak.","poem":2},"Osiepe",{"text":"Yaye osiepena, chiemuru kendo methuru;","poem":1},{"text":"yaye joherana, methuru ma romu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne anindo, to chunya ne neno.","poem":1},{"text":"Lingʼ uwinji! Jaherana dwongʼo kowacho niya,","poem":2},{"text":"“Yaye jaherana, yawna kendo winja maber,","poem":1},{"text":"yaye jaherana mamuol mana ka akuru.","poem":2},{"text":"Tho opongʼo wiya,","poem":1},{"text":"kendo yie wiya opongʼ gi ngʼich mar otieno.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aselonyo lepa,","poem":1},{"text":"koro idwaro ni achak arwakra kendo?","poem":2},{"text":"Aselwoko tienda,","poem":1},{"text":"koro idwaro ni achak anyon lowo kendo?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Jaherana nosoyo lwete e otuchi mar dhoot;","poem":1},{"text":"chunya nochako gwecho ka dware.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne aa malo mondo ayawne jaherana,","poem":1},{"text":"kendo lwetena ne ton mo mangʼwe ngʼar ma nengone tek.","poem":2},{"text":"Morno ma nengone tek mane ni e lith lweta nomieno","poem":1},{"text":"pata mar dhoot.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne ayawone jaherana,","poem":1},{"text":"mi ayudo ka jaherana osewuok kendo osea!","poem":2},{"lineBreak":true},{"text":"Chunya norumo kane odhi oyomba.","poem":2},{"text":"Ne amanye, to ne ok ayude.","poem":1},{"text":"Ne aluonge, to ne ok odwoka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jorito noromo koda","poem":1},{"text":"kane giwuotho gotieno e alwora mar dala.","poem":2},{"text":"Ne gigoya marach ma gihinya;","poem":1},{"text":"kendo jorito marichogo,","poem":2},{"lineBreak":true},{"text":"ne omaya lawa!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Amiyou chik, un nyi Jerusalem","poem":1},{"text":"ni ka uyudo jaherana,","poem":2},{"text":"to ubiro nyise nangʼo?","poem":1},{"text":"Nyiseuru ni hera ma aherego odwaro nega?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ere kaka jaherani oloyo chwo mamoko,","poem":1},{"text":"yaye jaber mogik e dier nyiri mabeyo duto?","poem":2},{"text":"Ere kaka jaherani oloyo chwo mamoko,","poem":1},{"text":"momiyo imiyowa chik ma kamano?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jaherana rieny kendo rapudo,","poem":1},{"text":"oloyo chwo alufu apar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wiye chalo dhahabu maler,","poem":1},{"text":"yie wiye beyo kendo boyo,","poem":2},{"lineBreak":true},{"text":"bende yie wiyego ratengʼ ka yie agak.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wengene chalo akuru","poem":1},{"text":"mopiyo but aore mamol,","poem":2},{"text":"moluoki gi chak,","poem":1},{"text":"kendo ochan kaka kite ma nengogi tek.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lembe chalo gi apilo mokuogi","poem":1},{"text":"magolo suya mamit.","poem":2},{"text":"Pien dhoge chalo ondanyo,","poem":1},{"text":"ma mo madungʼ tik mangʼwe ngʼar tonie.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bedene chalo gi luth mar dhahabu,","poem":1},{"text":"mokedi gi kite ma nengongi tek.","poem":2},{"text":"Dende chalo gi lak liech moywe maler,","poem":1},{"text":"mokedi gi kit safir.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tiendene chalo gi sirni mag kit ombo","poem":1},{"text":"mochungʼ e mise mag dhahabu maler.","poem":2},{"text":"Onenore ka got mar Lebanon,","poem":1},{"text":"kendo ongʼongʼore ka bepe sida mag Lebanon.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mano kaka dhoge mit nyodho,","poem":1},{"text":"kendo ober moloyo chwo mamoko.","poem":2},{"text":"Mano e jaherana, mano e osiepna,","poem":1},{"text":"yaye nyi Jerusalem.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}