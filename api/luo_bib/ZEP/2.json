{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"ZEP","translationId":"luo_bib","name":"Zefania","commonName":"Zefania","title":"Zefania","order":36,"numberOfChapters":3,"sha256":"5271da979aea35b385316d890f8829ceee79892a776c7be37b3c7eff058d1a52","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/luo_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"heading","content":["Juda kod Jerusalem ongʼadnigi bura machalre gi ogendini mamoko"]},{"type":"heading","content":["Owachne Juda mondo opwodhre kuom richo"]},{"type":"verse","number":1,"content":[{"text":"Yaye un oganda maonge wichkuotni,","poem":1},{"text":"chokreuru kaachiel, chokreuru kaachiel,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ka ndalo moseyier pok ochopo","poem":1},{"text":"en odiechiengʼ ma ibiro teroue kuma bor ka mihudhwe mar cham.","poem":2},{"text":"Adier, chokreuru kapok mirima mager mar Jehova Nyasaye obiro kuomu,","poem":1},{"text":"kata kapok odiechiengʼ mar mirimbe ochopo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dwaruru Jehova Nyasaye, un ji duto mobolore manie piny,","poem":1},{"text":"kendo un ji duto matimo gik ma chik dwaro.","poem":2},{"text":"Dwaruru tim makare, kendo beduru gi chuny mobolore,","poem":1},{"text":"nimar dipo ka uyudo kar konyruok,","poem":2},{"lineBreak":true},{"text":"odiechiengno ma Jehova Nyasaye biro olo mirimbe kuom ji.","poem":2}]},{"type":"heading","content":["Kum mar jo-Filistia"]},{"type":"verse","number":4,"content":[{"text":"Ji biro dar Gaza,","poem":1},{"text":"kendo Ashkelon biro dongʼ gunda.","poem":2},{"text":"Odiechiengʼ tir Ashdod ibiro weyo nono","poem":1},{"text":"kendo Ekron ibiro pudh gi tiende.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yaye jo-Kereth modak e dho nam,","poem":1},{"text":"mano kaka unune malit,","poem":2},{"text":"yaye Kanaan, piny jo-Filistia,","poem":1},{"text":"Jehova Nyasaye nikodu gi wach kama:","poem":2},{"text":"“Abiro tieko chuth","poem":1},{"text":"kendo onge ngʼama nodongʼ.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Piny mantiere e dho nam kama jo-Kereth odakie biro bedo kar jokwath","poem":1},{"text":"kendo kama ogerie abich rombe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nobedi mar joma odongʼ mar dhood Juda;","poem":1},{"text":"kanyo gini yudie lek ma gikwae.","poem":2},{"text":"Godhiambo gibiro nindo","poem":1},{"text":"e ute mag Ashkelon.","poem":2},{"text":"Jehova Nyasaye ma Nyasachgi biro ritogi","poem":1},{"text":"kendo obiro dwokonegi gweth mane ogwedhogigo.","poem":2}]},{"type":"heading","content":["Kum mar jo-Moab kod jo-Amon"]},{"type":"verse","number":8,"content":[{"text":"“Asewinjo ayenje mag jo-Moab","poem":1},{"text":"kod ajara mag jo-Amon,","poem":2},{"text":"moseyanyo joga","poem":1},{"text":"kendo obwogogi e lopgi.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kuom mano,","poem":1},{"text":"Jehova Nyasaye Maratego, ma Nyasach Israel osingore kawacho kama,","poem":2},{"text":"“Adiera, Moab biro chalo gi Sodom,","poem":1},{"text":"to jo-Amon kaka Gomora,","poem":2},{"text":"piny modongʼ gunda","poem":1},{"text":"mojwangʼ motimo bunge.","poem":2},{"text":"Joga modongʼ noyakgi;","poem":1},{"text":"kendo oganda modongʼ nokaw pinygi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ma e kum ma jogi nonwangʼ kuom sunga margi,","poem":1},{"text":"kendo kuom yanyo kendo jaro jo-Jehova Nyasaye Maratego.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jehova Nyasaye biro bedo nigi malich","poem":1},{"text":"ka oketho nyiseche duto e piny.","poem":2},{"text":"Ogendini duto modak e alwora mar dho nembe duto nolame,","poem":1},{"text":"ngʼato ka ngʼato nolame e pinygi owuon.","poem":2}]},{"type":"heading","content":["Kum mar jo-Kush"]},{"type":"verse","number":12,"content":[{"text":"“Yaye jo-Kush,","poem":1},{"text":"un bende liganglana biro negou.”","poem":2}]},{"type":"heading","content":["Kum mar jo-Asuria"]},{"type":"verse","number":13,"content":[{"text":"Enorie bade kuomu un joma odak yo nyandwat,","poem":1},{"text":"kendo notiek Asuria,","poem":2},{"text":"bende dala mar Nineve nodongʼ gunda","poem":1},{"text":"mi nobed motwo ka piny motimo ongoro.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kweth mag jamni biro nindo piny motimo kanyo,","poem":1},{"text":"kod kit chwech mopogore opogore.","poem":2},{"text":"Tula mar thim kod agak","poem":1},{"text":"nobed gi nyasi.","poem":2},{"text":"Ywakgi nowinjre ka wuok gie dirisni,","poem":1},{"text":"kite moger godo udi nomukre mabiwre e dhoudi,","poem":2},{"lineBreak":true},{"text":"kendo sirni nodongʼ kongʼiengore.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ma e dala maduongʼ mane odak gi kwe,","poem":1},{"text":"kendo kogalore.","poem":2},{"text":"Ne owacho e chunye niya,","poem":1},{"text":"“An e kende kendo onge ngʼama ipimo koda.”","poem":2},{"text":"To mano kaka koro odongʼ gunda,","poem":1},{"text":"kama le mag bungu yweyoe.","poem":2},{"text":"Ji duto makadho bute","poem":1},{"text":"wuoro ka tangʼo lwetgi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}