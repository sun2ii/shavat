{"translation":{"id":"luo_bib","name":"Biblica® Ochiw Thuolo Motingʼo Loko Manyien™","website":"https://ebible.org/Scriptures/details.php?id=luo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=luo","licenseNotes":null,"shortName":"BIB","englishName":"Dholuo Bible","language":"luo","textDirection":"ltr","sha256":"958cea11b88b40d9934c0144bda01e784a793e30960f8958c65cba8db846c7eb","availableFormats":["json"],"listOfBooksApiLink":"/api/luo_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Dholuo","languageEnglishName":"Luo"},"book":{"id":"ZEP","translationId":"luo_bib","name":"Zefania","commonName":"Zefania","title":"Zefania","order":36,"numberOfChapters":3,"sha256":"5271da979aea35b385316d890f8829ceee79892a776c7be37b3c7eff058d1a52","firstChapterNumber":1,"firstChapterApiLink":"/api/luo_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/luo_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["Chal mar Jerusalem e ndalo mabiro"]},{"type":"verse","number":1,"content":[{"text":"Mano kaka inine malit in dala maduongʼ ma jasand ji,","poem":1},{"text":"ma toke tek kendo mogak.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dalani ok winj puonj ngʼato angʼata,","poem":1},{"text":"kendo ok owinj kata puonj mora amora.","poem":2},{"text":"Ok ogeno kuom Jehova Nyasaye,","poem":1},{"text":"bende ok osud machiegni gi Nyasache.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jotende gin sibuoche maruto,","poem":1},{"text":"to ruodhige chalo gi ondiegi mawuotho gotieno,","poem":2},{"lineBreak":true},{"text":"ma ok we gimoro amora miyudi gokinyi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Jonabi mage gin josunga,","poem":1},{"text":"kendo gin joma wuondore.","poem":2},{"text":"Jodolo mage njawo kama ler mar lemo,","poem":1},{"text":"kendo giketho chik.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"To Jehova Nyasaye mantie e diergi, to en ngʼat makare,","poem":1},{"text":"ok otim gimoro amora marach.","poem":2},{"text":"Okinyi ka okinyi to ongʼado bura gi adier,","poem":1},{"text":"kendo odiechiengʼ ka odiechiengʼ ok rem,","poem":2},{"lineBreak":true},{"text":"to kata kamano, jaricho to onge wichkuot.","poem":2}]},{"type":"heading","content":["Jerusalem otamore pwodhore kuom richo"]},{"type":"verse","number":6,"content":[{"text":"“Asengʼado ogendini oko,","poem":1},{"text":"kuondegi ma gigengʼorego bende asemuko.","poem":2},{"text":"Yoregi osedongʼ nono,","poem":1},{"text":"maonge ngʼama wuothoe.","poem":2},{"text":"Miechgi madongo osekethi;","poem":1},{"text":"maonge ngʼama nodongʼ kodakie kata achiel.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne awachone dala maduongʼ niya,","poem":1},{"text":"‘Adier ibiro luora,","poem":2},{"lineBreak":true},{"text":"kendo ibiro yie gi puonjna!’","poem":2},{"text":"Ka itimo kamano, to kar dakni ok nongʼad oko,","poem":1},{"text":"kendo ok anakume.","poem":2},{"text":"Kata kamano, ne pod gi timo sinani","poem":1},{"text":"mar timo gik maricho.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kuom mano, Jehova Nyasaye wacho niya, “Emomiyo koro rita,","poem":1},{"text":"nyaka ndalo ma anangʼadnie bura.","poem":2},{"text":"Asechano mondo achok ogendini","poem":1},{"text":"gi pinjeruodhi,","poem":2},{"text":"mondo aol mirimba kuomgi,","poem":1},{"text":"ma en mirimba mager.","poem":2},{"text":"Piny ngima ibiro wangʼo","poem":1},{"text":"gi mach mar mirimba mager.","poem":2}]},{"type":"heading","content":["Israel biro keto genogi kuom Jehova Nyasaye"]},{"type":"verse","number":9,"content":[{"text":"“Bangʼe anapwodh dho oganda","poem":1},{"text":"mondo giduto giluong nying Jehova Nyasaye,","poem":2},{"lineBreak":true},{"text":"kendo gitine gi chuny achiel.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Joga malama","poem":1},{"text":"kendo moke e pinje loka aore mag Kush,","poem":2},{"lineBreak":true},{"text":"nobi kakelona mich.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"E odiechiengʼno ok inichak ine wichkuot","poem":1},{"text":"kaluwore gi timbe maricho mane itimona,","poem":2},{"text":"nikech abiro golo","poem":1},{"text":"josunga mamor gi sungagi e dala maduongʼni.","poem":2},{"text":"Ok inichak isungri kendo,","poem":1},{"text":"e goda maler.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"To anawe joma muol","poem":1},{"text":"e dieru kendo ma obolore,","poem":2},{"lineBreak":true},{"text":"ma gin jogo ma oyie kuom nying Jehova Nyasaye.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Jo-Israel modongʼ ok notim gima rach,","poem":1},{"text":"ok giniriambi,","poem":2},{"lineBreak":true},{"text":"bende miriambo ok nowuog e dhogi.","poem":2},{"text":"Gibiro chiemo kendo nindo","poem":1},{"text":"maonge ngʼama nomi gibed maluor.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Wer, yaye nyar Sayun,","poem":1},{"text":"go koko matek, yaye Israel!","poem":2},{"text":"Bed mamor kendo moil gi chunyi duto,","poem":1},{"text":"yaye nyar Jerusalem!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Jehova Nyasaye osegolo kuomi kum mosekumigo","poem":1},{"text":"bende oseriembo wasika.","poem":2},{"text":"Jehova Nyasaye, ma en Ruodh jo-Israel ni kodi","poem":1},{"text":"ok inichak iluor gimoro amora manyalo hinyi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Odiechiengʼno ji nowach ni Jerusalem niya,","poem":1},{"text":"“Kik iluor, yaye Sayun,","poem":2},{"lineBreak":true},{"text":"kik iwe badi obed mobengni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Jehova Nyasaye ma Nyasachi ni kodi,","poem":1},{"text":"en gi teko mar reso ji.","poem":2},{"text":"Obiro bedo gi mor maduongʼ kuomi,","poem":1},{"text":"kendo obiro kweyo chunyi gi herane,","poem":2},{"lineBreak":true},{"text":"bende obiro wer ka omor gi ilo kuomi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Abiro golo kuomi","poem":1},{"text":"masiche mane ochan ni biro timore kuomi e kinde mag sewni moyier,","poem":2},{"lineBreak":true},{"text":"nikech gisebedo tingʼ mapek kuomi kendo gisemiyi wichkuot.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"E kindeno anakum","poem":1},{"text":"jogo mane osandi,","poem":2},{"text":"anakony rongʼonde","poem":1},{"text":"kendo anachok joga mane oke e pinje.","poem":2},{"text":"Abiro miyogi pak gi huma","poem":1},{"text":"e piny ka piny mane okuodie wigi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"E kindeno abiro choki,","poem":1},{"text":"e ndalono anakeli dala.","poem":2},{"text":"Abiro miyi pak gi huma,","poem":1},{"text":"e kind ogendini manie piny mangima,","poem":2},{"text":"ka adwokoni gweth mane agwedhigo chon","poem":1},{"text":"mana ka ineno,”","poem":2},{"lineBreak":true},{"text":"Jehova Nyasaye owacho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/luo_bib/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/luo_bib/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/luo_bib/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}