{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"1CH","translationId":"mal_bib","name":"1 ദിനവൃത്താന്തം","commonName":"1 ദിനവൃത്താന്തം","title":"ദിനവൃത്താന്തം: ഒന്നാംപുസ്തകം","order":13,"numberOfChapters":29,"sha256":"34e91e21ae0db69c7b2b1e56f0e0eae424f5ff67c369a6a1deb8751d27f16179","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/mal_bib/1CH/29.json","totalNumberOfVerses":940},"chapter":{"number":1,"content":[{"type":"heading","content":["ആദാംമുതൽ അബ്രാഹാംവരെയുള്ള ചരിത്രരേഖകൾ"]},{"type":"heading","content":["നോഹയുടെ പുത്രന്മാർവരെ"]},{"type":"verse","number":1,"content":["ആദാം, ശേത്ത്, ഏനോശ്,"]},{"type":"verse","number":2,"content":["കേനാൻ, മഹലലേൽ, യാരെദ്,"]},{"type":"verse","number":3,"content":["ഹാനോക്ക്, മെഥൂശെലാഹ്, ലാമെക്ക്, നോഹ."]},{"type":"line_break"},{"type":"verse","number":4,"content":["നോഹയുടെ പുത്രന്മാർ:",{"noteId":0},"ശേം, ഹാം, യാഫെത്ത്."]},{"type":"heading","content":["യാഫെത്യർ"]},{"type":"verse","number":5,"content":["യാഫെത്തിന്റെ പുത്രന്മാർ:",{"noteId":1},"ഗോമെർ, മാഗോഗ്, മാദായി, യാവാൻ, തൂബാൽ, മേശെക്ക്, തീരാസ്."]},{"type":"verse","number":6,"content":["ഗോമെരിന്റെ പുത്രന്മാർ: അശ്കേനസ്, ദിഫാത്ത്,",{"noteId":2},"തോഗർമാ."]},{"type":"verse","number":7,"content":["യാവാന്റെ പുത്രന്മാർ: എലീശാ, തർശീശ്, കിത്ത്യർ, റോദാന്യർ."]},{"type":"heading","content":["ഹാമ്യർ"]},{"type":"verse","number":8,"content":["ഹാമിന്റെ പുത്രന്മാർ: കൂശ്, ഈജിപ്റ്റ്, പൂത്ത്, കനാൻ."]},{"type":"verse","number":9,"content":["കൂശിന്റെ പുത്രന്മാർ: സേബ, ഹവീലാ, സബ്താ, രാമാ, സബ്തെക്കാ. രാമായുടെ പുത്രന്മാർ: ശേബാ, ദേദാൻ."]},{"type":"verse","number":10,"content":["കൂശ് നിമ്രോദിന്റെ പിതാവായിരുന്നു.",{"noteId":3},"നിമ്രോദ് ഭൂമിയിൽ ആദ്യത്തെ മല്ലനായ പോരാളിയായിത്തീർന്നു."]},{"type":"verse","number":11,"content":["ലൂദീം, അനാമീം, ലെഹാബീം, നഫ്തൂഹീം,"]},{"type":"verse","number":12,"content":["പത്രൂസീം, കസ്ളൂഹീം, (ഇവരിൽനിന്നാണ് ഫെലിസ്ത്യർ ഉത്ഭവിച്ചത്) കഫ്തോരീം എന്നീ വംശങ്ങളുടെ ഉത്ഭവം ഈജിപ്റ്റിൽനിന്നായിരുന്നു."]},{"type":"verse","number":13,"content":["കനാന്റെ പുത്രന്മാർ: ആദ്യജാതനായ സീദോൻ,",{"noteId":4},"ഹിത്യർ,"]},{"type":"verse","number":14,"content":["യെബൂസ്യർ, അമോര്യർ, ഗിർഗ്ഗശ്യർ,"]},{"type":"verse","number":15,"content":["ഹിവ്യർ, അർഖ്യർ, സീന്യർ,"]},{"type":"verse","number":16,"content":["അർവാദ്യർ, സെമാര്യർ, ഹമാത്യർ."]},{"type":"heading","content":["ശേമ്യർ"]},{"type":"verse","number":17,"content":["ശേമിന്റെ പുത്രന്മാർ: ഏലാം, അശ്ശൂർ, അർപ്പക്ഷാദ്, ലൂദ്, അരാം, അരാമിന്റെ പുത്രന്മാർ:",{"noteId":5},"ഊസ്, ഹൂൾ, ഗേഥെർ, മേശെക്ക്."]},{"type":"verse","number":18,"content":["അർപ്പക്ഷാദ് ശേലഹിന്റെ പിതാവും ശേലഹ് ഏബെരിന്റെ പിതാവുമായിരുന്നു."]},{"type":"verse","number":19,"content":["ഏബെരിനു രണ്ടു പുത്രന്മാർ ജനിച്ചു: ഒരുവന്റെ പേര് പേലെഗ്",{"noteId":6},"എന്നായിരുന്നു; കാരണം, അവന്റെ കാലത്തായിരുന്നു ഭൂവാസികൾ വിഭജിക്കപ്പെട്ടത്. അവന്റെ സഹോദരന്റെ പേര് യോക്താൻ എന്നായിരുന്നു."]},{"type":"verse","number":20,"content":["യോക്താന്റെ പുത്രന്മാർ: അല്മോദാദ്, ശാലെഫ്, ഹസർമാവെത്ത്, യാരഹ്,"]},{"type":"verse","number":21,"content":["ഹദോരാം, ഊസാൽ, ദിക്ലാ,"]},{"type":"verse","number":22,"content":["ഓബാൽ,",{"noteId":7},"അബീമായേൽ, ശേബാ,"]},{"type":"verse","number":23,"content":["ഓഫീർ, ഹവീലാ, യോബാബ് ഇവരെല്ലാവരും യോക്താന്റെ പുത്രന്മാർ ആയിരുന്നു."]},{"type":"line_break"},{"type":"verse","number":24,"content":["ശേം, അർപ്പക്ഷാദ്,",{"noteId":8},"ശേലഹ്"]},{"type":"verse","number":25,"content":["ഏബെർ, പേലെഗ്, രെയൂ"]},{"type":"verse","number":26,"content":["ശെരൂഗ്, നാഹോർ, തേരഹ്"]},{"type":"verse","number":27,"content":["അബ്രാം (അതായത്, അബ്രാഹാം)."]},{"type":"heading","content":["അബ്രാഹാമിന്റെ കുടുംബം"]},{"type":"verse","number":28,"content":["അബ്രാഹാമിന്റെ പുത്രന്മാർ: യിസ്ഹാക്കും യിശ്മായേലും."]},{"type":"heading","content":["ഹാഗാർ വഴിക്കുള്ള പിൻഗാമികൾ"]},{"type":"verse","number":29,"content":["അവരുടെ പിൻഗാമികൾ ഇവരായിരുന്നു: യിശ്മായേലിന്റെ ആദ്യജാതനായ നെബായോത്ത്, കേദാർ, അദ്ബെയേൽ, മിബ്ശാം,"]},{"type":"verse","number":30,"content":["മിശ്മാ, ദൂമാ, മസ്സാ, ഹദദ്, തേമാ,"]},{"type":"verse","number":31,"content":["യെതൂർ, നാഫീശ്, കേദെമാ. ഇവരെല്ലാം യിശ്മായേലിന്റെ പുത്രന്മാരായിരുന്നു."]},{"type":"heading","content":["കെതൂറാവഴിയുള്ള പിൻഗാമികൾ"]},{"type":"verse","number":32,"content":["അബ്രാഹാമിന്റെ വെപ്പാട്ടിയായ കെതൂറായ്ക്കു ജനിച്ച പുത്രന്മാർ ഇവരാണ്: സിമ്രാൻ, യൊക്ശാൻ, മെദാൻ, മിദ്യാൻ, യിശ്ബാക്ക്, ശൂവഹ്. യോക്ശാന്റെ പുത്രന്മാർ: ശേബാ, ദേദാൻ."]},{"type":"verse","number":33,"content":["മിദ്യാന്റെ പുത്രന്മാർ: ഏഫാ, ഏഫെർ, ഹാനോക്ക്, അബീദാ, എൽദായാ. ഇവരെല്ലാം കെതൂറായിലൂടെ ലഭിച്ച പിൻഗാമികളായിരുന്നു."]},{"type":"heading","content":["സാറാവഴിയുള്ള പിൻഗാമികൾ"]},{"type":"verse","number":34,"content":["അബ്രാഹാം യിസ്ഹാക്കിന്റെ പിതാവായിരുന്നു. യിസ്ഹാക്കിന്റെ പുത്രന്മാർ: ഏശാവും ഇസ്രായേലും."]},{"type":"heading","content":["ഏശാവിന്റെ പുത്രന്മാർ"]},{"type":"verse","number":35,"content":["ഏശാവിന്റെ പുത്രന്മാർ: എലീഫാസ്, രെയൂവേൽ, യെയൂശ്, യലാം, കോരഹ്."]},{"type":"verse","number":36,"content":["എലീഫാസിന്റെ പുത്രന്മാർ: തേമാൻ, ഓമാർ, സെഫോ,",{"noteId":9},"ഗഥാം, കെനസ്, തിമ്നയിലൂടെ അമാലേക്ക്.",{"noteId":10}]},{"type":"verse","number":37,"content":["രെയൂവേലിന്റെ പുത്രന്മാർ: നഹത്ത്, സേരഹ്, ശമ്മാ, മിസ്സാ."]},{"type":"heading","content":["ഏദോമ്യനായ സേയീരിന്റെ വംശാവലി"]},{"type":"verse","number":38,"content":["സേയീരിന്റെ പുത്രന്മാർ: ലോതാൻ, ശോബാൽ, സിബെയോൻ, അനാ, ദീശോൻ, ഏസെർ, ദീശാൻ."]},{"type":"verse","number":39,"content":["ലോതാന്റെ പുത്രന്മാർ: ഹോരി, ഹോമാം. തിമ്നാ ലോതാന്റെ സഹോദരി ആയിരുന്നു."]},{"type":"verse","number":40,"content":["ശോബാലിന്റെ പുത്രന്മാർ: അല്വാൻ,",{"noteId":11},"മനഹത്ത്, ഏബാൽ, ശെഫോ, ഓനാം. സിബെയോന്റെ പുത്രന്മാർ: അയ്യാ, അനാ"]},{"type":"verse","number":41,"content":["അനായുടെ പുത്രൻ: ദീശോൻ. ദീശോന്റെ പുത്രന്മാർ: ഹെമ്ദാൻ,",{"noteId":12},"എശ്ബാൻ, യിത്രാൻ, കെരാൻ"]},{"type":"verse","number":42,"content":["ഏസെരിന്റെ പുത്രന്മാർ: ബിൽഹാൻ, സാവാൻ, യാക്കാൻ.",{"noteId":13},"ദീശാന്റെ",{"noteId":14},"പുത്രന്മാർ: ഊസ്, അരാൻ."]},{"type":"heading","content":["ഏദോമ്യരാജാക്കന്മാർ:"]},{"type":"verse","number":43,"content":["ഇസ്രായേലിൽ രാജഭരണം വരുന്നതിനുമുമ്പ് ഏദോമിൽ ഭരണം നടത്തിയിരുന്ന രാജാക്കന്മാർ ഇവരാണ്: ബെയോരിന്റെ മകനായ ബേല; അദ്ദേഹത്തിന്റെ നഗരത്തിനു ദിൻഹാബാഹ് എന്നു പേരായിരുന്നു."]},{"type":"verse","number":44,"content":["ബേലയുടെ മരണശേഷം ബൊസ്രാക്കാരനായ സേരഹിന്റെ മകൻ യോബാബ് രാജാവിന്റെ അനന്തരാവകാശിയായിത്തീർന്നു."]},{"type":"verse","number":45,"content":["യോബാബിന്റെ മരണശേഷം തേമാന്യരുടെ ദേശത്തുനിന്നുള്ള ഹൂശാം രാജാവായി."]},{"type":"verse","number":46,"content":["ഹൂശാമിന്റെ മരണശേഷം ബേദാദിന്റെ മകനും മോവാബുദേശത്തുവെച്ച് മിദ്യാനെ തോൽപ്പിച്ചവനുമായ ഹദദ് രാജാവായി. അദ്ദേഹത്തിന്റെ നഗരത്തിന് അവീത്ത് എന്നായിരുന്നു പേര്."]},{"type":"verse","number":47,"content":["ഹദദിന്റെ മരണശേഷം മസ്രേക്കക്കാരനായ സമ്ളാ അദ്ദേഹത്തിനുപകരം രാജാവായി."]},{"type":"verse","number":48,"content":["സമ്ളാ മരിച്ചപ്പോൾ നദീതീരത്തുള്ള",{"noteId":15},"രെഹോബോത്തിലെ നിവാസിയായ ശാവൂൽ രാജാവായി."]},{"type":"verse","number":49,"content":["ശാവൂലിന്റെ മരണശേഷം അക്ബോരിന്റെ മകനായ ബാൽ-ഹാനാൻ രാജാവായി."]},{"type":"verse","number":50,"content":["ബാൽ-ഹാനാൻ മരിച്ചശേഷം ഹദദ് രാജാവായി. അദ്ദേഹത്തിന്റെ നഗരത്തിനു പാവൂ",{"noteId":16},"എന്നായിരുന്നു പേര്. അദ്ദേഹത്തിന്റെ ഭാര്യയുടെ പേര് മെഹേതബേൽ എന്നായിരുന്നു. അവൾ മേ-സാഹാബിന്റെ മകളായ മത്രേദിന്റെ മകൾ ആയിരുന്നു."]},{"type":"verse","number":51,"content":["ഹദദും മരിച്ചു.",{"lineBreak":true},"ഏദോമ്യപ്രഭുക്കന്മാർ ഇവരായിരുന്നു: തിമ്നാ, അല്വാ, യെഥേത്ത്,"]},{"type":"verse","number":52,"content":["ഒഹൊലീബാമാ, ഏലാ, പീനോൻ,"]},{"type":"verse","number":53,"content":["കെനസ്, തേമാൻ, മിബ്സാർ,"]},{"type":"verse","number":54,"content":["മഗ്ദീയേൽ, ഈരാം. ഇവരായിരുന്നു ഏദോമ്യപ്രഭുക്കന്മാർ."]}],"footnotes":[{"noteId":0,"caller":"+","text":"ചി.കൈ.പ്ര. ഈ വരി കാണുന്നില്ല.","reference":{"chapter":1,"verse":4}},{"noteId":1,"caller":"+","text":"പുത്രന്മാർ എന്ന വാക്കിന് പിൻഗാമികൾ, അനന്തരാവകാശികൾ, രാഷ്ട്രങ്ങൾ എന്നീ അർഥങ്ങളുണ്ട്. വാ. 6–9, 17, 23 കാണുക.","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"ഉൽ. 10:3കാണുക. ചി.കൈ.പ്ര. രീഫത്ത്","reference":{"chapter":1,"verse":6}},{"noteId":3,"caller":"+","text":"പിതാവ് എന്ന വാക്ക്, പൂർവികർ, മുൻഗാമികൾ, സ്ഥാപകർ എന്നീ അർഥങ്ങളിൽ പല പഴയനിയമഭാഗങ്ങളിലും ഉപയോഗിച്ചിരിക്കുന്നു.","reference":{"chapter":1,"verse":10}},{"noteId":4,"caller":"+","text":"അഥവാ, സീദോന്യർ","reference":{"chapter":1,"verse":13}},{"noteId":5,"caller":"+","text":"ചി.കൈ.പ്ര. ഈ വരി കാണുന്നില്ല.","reference":{"chapter":1,"verse":17}},{"noteId":6,"caller":"+","text":"വിഭജിക്കുക എന്നർഥം.","reference":{"chapter":1,"verse":19}},{"noteId":7,"caller":"+","text":"ഉൽ. 10:28കാണുക; ചി.കൈ.പ്ര. ഏബാൽ","reference":{"chapter":1,"verse":22}},{"noteId":8,"caller":"+","text":"ചി.കൈ.പ്ര. അർപ്പക്ഷാദ്, കെനാൻ. ഉൽ. 11:10കാണുക.","reference":{"chapter":1,"verse":24}},{"noteId":9,"caller":"+","text":"ഉൽ. 36:11കാണുക. ചി.കൈ.പ്ര. സെഫി","reference":{"chapter":1,"verse":36}},{"noteId":10,"caller":"+","text":"ഉൽ. 36:12കാണുക. ചി.കൈ.പ്ര. ഗഥാം, കെനസ്, തിമ്ന, അമാലേക്ക്.","reference":{"chapter":1,"verse":36}},{"noteId":11,"caller":"+","text":"ഉൽ. 36:23കാണുക. ചി.കൈ.പ്ര. അലീയാൻ","reference":{"chapter":1,"verse":40}},{"noteId":12,"caller":"+","text":"ഉൽ. 36:26കാണുക. ചി.കൈ.പ്ര. ഹമ്രാൻ","reference":{"chapter":1,"verse":41}},{"noteId":13,"caller":"+","text":"ഉൽ. 36:27കാണുക. ചി.കൈ.പ്ര. അക്കാൻ","reference":{"chapter":1,"verse":42}},{"noteId":14,"caller":"+","text":"ഉൽ. 36:28കാണുക. മൂ.ഭാ. ദീശോൻ, ദീശാൻ എന്നതിന്റെ മറ്റൊരുരൂപം.","reference":{"chapter":1,"verse":42}},{"noteId":15,"caller":"+","text":"ഒരുപക്ഷേ, യൂഫ്രട്ടീസ് നദി","reference":{"chapter":1,"verse":48}},{"noteId":16,"caller":"+","text":"ഉൽ. 36:39കാണുക. ചി.കൈ.പ്ര. പായി","reference":{"chapter":1,"verse":50}}]},"thisChapterLink":"/api/mal_bib/1CH/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/1CH/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/2KI/25.json","previousChapterAudioLinks":{},"numberOfVerses":54}