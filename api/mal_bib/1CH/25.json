{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"1CH","translationId":"mal_bib","name":"1 ദിനവൃത്താന്തം","commonName":"1 ദിനവൃത്താന്തം","title":"ദിനവൃത്താന്തം: ഒന്നാംപുസ്തകം","order":13,"numberOfChapters":29,"sha256":"34e91e21ae0db69c7b2b1e56f0e0eae424f5ff67c369a6a1deb8751d27f16179","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/mal_bib/1CH/29.json","totalNumberOfVerses":940},"chapter":{"number":25,"content":[{"type":"heading","content":["ഗായകഗണങ്ങൾ"]},{"type":"verse","number":1,"content":["ദാവീദ് തന്റെ സൈന്യാധിപന്മാരുമായി കൂടിയാലോചിച്ച് ആസാഫിന്റെയും ഹേമാന്റെയും യെദൂഥൂന്റെയും പുത്രന്മാരിൽ ചിലരെ പ്രവചനശുശ്രൂഷയ്ക്കായി",{"noteId":109},"വേർതിരിച്ചു. വീണ, കിന്നരം, ഇലത്താളം ഇവയുടെ അകമ്പടിയോടുകൂടി അവർ ഈ ശുശ്രൂഷ നിർവഹിക്കണമായിരുന്നു. ഈ ശുശ്രൂഷ നിർവഹിച്ച ആളുകളുടെ പേരുവിവരം ഇപ്രകാരമാണ്:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["ആസാഫിന്റെ പുത്രന്മാരിൽനിന്ന്: സക്കൂർ, യോസേഫ്, നെഥന്യാവ്, അശരേലാ, ഇവർ ആസാഫിന്റെ നിർദേശമനുസരിച്ച് രാജാവിന്റെ മേൽനോട്ടത്തിൽ പ്രവചനശുശ്രൂഷ ചെയ്തിരുന്നു."]},{"type":"verse","number":3,"content":["യെദൂഥൂനുവേണ്ടി അദ്ദേഹത്തിന്റെ പുത്രന്മാരിൽനിന്ന്: ഗെദല്യാവ്, സെരി, യെശയ്യാവ്, ശിമെയി,",{"noteId":110},"ഹശബ്യാവ്, മത്ഥിഥ്യാവ്—ആകെ ആറുപേർ. ഇവർ പ്രവചിച്ചത് തങ്ങളുടെ പിതാവായ യെദൂഥൂന്റെ മേൽനോട്ടത്തിലായിരുന്നു. കിന്നരംമീട്ടി യഹോവയ്ക്കു നന്ദിയും സ്തുതിയും അർപ്പിച്ചുകൊണ്ടായിരുന്നു അവർ ശുശ്രൂഷ നിറവേറ്റിയിരുന്നത്."]},{"type":"verse","number":4,"content":["ഹേമാനുവേണ്ടി, അദ്ദേഹത്തിന്റെ പുത്രന്മാരിൽനിന്ന്: ബുക്കിയാവ്, മത്ഥന്യാവ്, ഉസ്സീയേൽ, ശെബൂവേൽ, യെരീമോത്ത്, ഹനന്യാവ്, ഹനാനി, എലീയാഥാ, ഗിദ്ദൽതി, രോമംതി-ഏസെർ, യോശ്ബെക്കാശാ, മല്ലോഥി, ഹോഥീർ, മഹസീയോത്ത്"]},{"type":"verse","number":5,"content":["ഇവരെല്ലാം രാജാവിന്റെ ദർശകനായ ഹേമാന്റെ പുത്രന്മാരായിരുന്നു. ഹേമാനെ ഉന്നതനാക്കുമെന്ന് ദൈവം നൽകിയ വാഗ്ദാനത്തിന്റെ ഫലമായി അവനു നൽകപ്പെട്ടവരായിരുന്നു ഇവർ. ദൈവം ഹേമാന് പതിന്നാലു പുത്രന്മാരെയും മൂന്നു പുത്രിമാരെയും പ്രദാനംചെയ്തു."]},{"type":"line_break"},{"type":"verse","number":6,"content":["ഈ മൂന്നു ഗണത്തിലുംപെട്ട ഇവരെല്ലാം യഹോവയുടെ ആലയത്തിൽ ഇലത്താളങ്ങളും വീണയും കിന്നരവും ഉപയോഗിച്ച് ദൈവത്തിന്റെ മന്ദിരത്തിൽ നടക്കുന്ന ശുശ്രൂഷയ്ക്കുവേണ്ടതായ സംഗീതം പകർന്നു. ഇവരെല്ലാം താന്താങ്ങളുടെ പിതാക്കന്മാരുടെ മേൽനോട്ടത്തിലായിരുന്നു പ്രവർത്തിച്ചത്. ആസാഫും യെദൂഥൂനും ഹേമാനും രാജാവിന്റെ മേൽനോട്ടത്തിലായിരുന്നു പ്രവർത്തിച്ചിരുന്നത്."]},{"type":"verse","number":7,"content":["അവരെല്ലാവരും തങ്ങളുടെ ബന്ധുജനങ്ങളോടു ചേർന്ന് യഹോവയ്ക്കു സംഗീതം ആലപിക്കുന്നതിൽ തഴക്കംവന്നവരും വിദഗ്ദ്ധരും ആയിരുന്നു. അവരുടെ എണ്ണം ആകെ 288 ആയിരുന്നു."]},{"type":"verse","number":8,"content":["ചെറുപ്പക്കാരും മുതിർന്നവരും അധ്യാപകരും അധ്യേതാക്കളും ഒരുപോലെ നറുക്കിട്ട് താന്താങ്ങളുടെ ശുശ്രൂഷ നിശ്ചയിച്ചു."]},{"type":"line_break"},{"type":"verse","number":9,"content":["ആസാഫിനുവേണ്ടിയുള്ള ആദ്യത്തെ നറുക്ക് യോസേഫിനു വീണു.അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടി",{"noteId":111},"പന്ത്രണ്ടുപേർ",{"noteId":112},"രണ്ടാമത്തേത് ഗെദല്യാവിന് വീണു.അദ്ദേഹവും ബന്ധുക്കളും പുത്രന്മാരുംകൂടിപന്ത്രണ്ടുപേർ"]},{"type":"verse","number":10,"content":["മൂന്നാമത്തേത് സക്കൂറിനു വീണു.അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടിപന്ത്രണ്ടുപേർ"]},{"type":"verse","number":11,"content":["നാലാമത്തേത് യിസ്രിക്ക്,",{"noteId":113},"അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടിപന്ത്രണ്ടുപേർ"]},{"type":"verse","number":12,"content":["അഞ്ചാമത്തേത് നെഥന്യാവിന്,അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടിപന്ത്രണ്ടുപേർ"]},{"type":"verse","number":13,"content":["ആറാമത്തേത് ബുക്കിയാവിന്,അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടിപന്ത്രണ്ടുപേർ"]},{"type":"verse","number":14,"content":["ഏഴാമത്തേത് യെശരേലെക്ക്,",{"noteId":114},"അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടിപന്ത്രണ്ടുപേർ"]},{"type":"verse","number":15,"content":["എട്ടാമത്തേത് യെശയ്യാവിന്,അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടിപന്ത്രണ്ടുപേർ"]},{"type":"verse","number":16,"content":["ഒൻപതാമത്തേത് മത്ഥന്യാവിന്,അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടിപന്ത്രണ്ടുപേർ"]},{"type":"verse","number":17,"content":["പത്താമത്തേത് ശിമെയിക്ക്,അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടിപന്ത്രണ്ടുപേർ"]},{"type":"verse","number":18,"content":["പതിനൊന്നാമത്തേത് അസരെയേലിന്,",{"noteId":115},"അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടിപന്ത്രണ്ടുപേർ"]},{"type":"verse","number":19,"content":["പന്ത്രണ്ടാമത്തേത് ഹശബ്യാവിന്,അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടിപന്ത്രണ്ടുപേർ"]},{"type":"verse","number":20,"content":["പതിമ്മൂന്നാമത്തേത് ശൂബായേലിന്,അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടിപന്ത്രണ്ടുപേർ"]},{"type":"verse","number":21,"content":["പതിന്നാലാമത്തേത് മത്ഥിഥ്യാവിന്,അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടിപന്ത്രണ്ടുപേർ"]},{"type":"verse","number":22,"content":["പതിനഞ്ചാമത്തേത് യെരേമോത്തിന്,അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടിപന്ത്രണ്ടുപേർ"]},{"type":"verse","number":23,"content":["പതിനാറാമത്തേത് ഹനന്യാവിന്,അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടിപന്ത്രണ്ടുപേർ"]},{"type":"verse","number":24,"content":["പതിനേഴാമത്തേത് യോശ്ബെക്കാശയ്ക്ക്,അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടിപന്ത്രണ്ടുപേർ"]},{"type":"verse","number":25,"content":["പതിനെട്ടാമത്തേത് ഹനാനിക്ക്,അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടിപന്ത്രണ്ടുപേർ"]},{"type":"verse","number":26,"content":["പത്തൊൻപതാമത്തേത് മല്ലോഥിക്ക്,അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടിപന്ത്രണ്ടുപേർ"]},{"type":"verse","number":27,"content":["ഇരുപതാമത്തേത് എലീയാഥെക്ക്,അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടിപന്ത്രണ്ടുപേർ"]},{"type":"verse","number":28,"content":["ഇരുപത്തൊന്നാമത്തേത് ഹോഥീരിന്,അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടിപന്ത്രണ്ടുപേർ"]},{"type":"verse","number":29,"content":["ഇരുപത്തിരണ്ടാമത്തേത് ഗിദ്ദൽതിക്ക്,അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടിപന്ത്രണ്ടുപേർ"]},{"type":"verse","number":30,"content":["ഇരുപത്തിമൂന്നാമത്തേത് മഹസീയോത്തിന്,അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടിപന്ത്രണ്ടുപേർ"]},{"type":"verse","number":31,"content":["ഇരുപത്തിനാലാമത്തേത് രോമംതി-ഏസെറിന്,അദ്ദേഹവും പുത്രന്മാരും ബന്ധുക്കളുംകൂടിപന്ത്രണ്ടുപേർ."]}],"footnotes":[{"noteId":109,"caller":"+","text":"അഥവാ, ദൈവവചനപ്രഭാഷണത്തിനായി","reference":{"chapter":25,"verse":1}},{"noteId":110,"caller":"+","text":"ചി.കൈ.പ്ര. ശിമെയി എന്ന വാക്കു കാണുന്നില്ല.","reference":{"chapter":25,"verse":3}},{"noteId":111,"caller":"+","text":"മൂ.ഭാ. ഈ വാക്യഭാഗം കാണുന്നില്ല.","reference":{"chapter":25,"verse":9}},{"noteId":112,"caller":"+","text":"വാ. 7-ലെ ആകെ എണ്ണം കാണുക; മൂ.ഭാ. പന്ത്രണ്ടുപേർ എന്നു കാണുന്നില്ല.","reference":{"chapter":25,"verse":9}},{"noteId":113,"caller":"+","text":"സേരി, യിസ്രി എന്നതിന്റെ മറ്റൊരുരൂപം.","reference":{"chapter":25,"verse":11}},{"noteId":114,"caller":"+","text":"അസാരെലാ, യെശരേൽ എന്നതിന്റെ മറ്റൊരുരൂപം.","reference":{"chapter":25,"verse":14}},{"noteId":115,"caller":"+","text":"ഉസിയേൽ, അസരെയേൽ എന്നതിന്റെ മറ്റൊരുരൂപം.","reference":{"chapter":25,"verse":18}}]},"thisChapterLink":"/api/mal_bib/1CH/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/1CH/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/1CH/24.json","previousChapterAudioLinks":{},"numberOfVerses":31}