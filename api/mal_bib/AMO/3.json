{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"AMO","translationId":"mal_bib","name":"ആമോസ്","commonName":"ആമോസ്","title":"ആമോസിന്റെ പ്രവചനം","order":30,"numberOfChapters":9,"sha256":"ce2d28463116bb92559d16d0cd6590b47accf4f397b8ecc1f0dc65d660f03fae","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/mal_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"heading","content":["ഇസ്രായേലിനെതിരേ സാക്ഷികളെ ക്ഷണിക്കുന്നു"]},{"type":"verse","number":1,"content":["ഇസ്രായേൽജനമേ, നിനക്കെതിരേയും ഞാൻ ഈജിപ്റ്റിൽനിന്ന് പുറപ്പെടുവിച്ചുകൊണ്ടുവന്ന സർവ കുടുംബത്തിനെതിരേയുമുള്ള യഹോവയുടെ അരുളപ്പാടു ശ്രദ്ധിക്കുക:"]},{"type":"verse","number":2,"content":[{"text":"“ഭൂമിയിലെ സകലകുടുംബങ്ങളിലുംവെച്ചു","poem":1},{"text":"ഞാൻ നിന്നെമാത്രമേ തെരഞ്ഞെടുത്തിട്ടുള്ളൂ;","poem":2},{"text":"അതുകൊണ്ടു നിന്റെ സകലപാപങ്ങൾക്കും","poem":1},{"text":"ഞാൻ നിന്നെ ശിക്ഷിക്കും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"തമ്മിൽ യോജിച്ചിട്ടല്ലാതെ,","poem":1},{"text":"രണ്ടുപേർ ഒരുമിച്ചു നടക്കുമോ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ഇരയില്ലാതിരിക്കുമ്പോൾ","poem":1},{"text":"സിംഹം കാട്ടിൽ അലറുമോ?","poem":2},{"text":"ഒന്നും പിടിക്കാതിരിക്കുമ്പോൾ","poem":1},{"text":"അതു ഗുഹയിൽ മുരളുമോ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"കുടുക്കില്ലാതിരുന്നാൽ","poem":1},{"text":"പക്ഷി നിലത്തെ കെണിയിൽ വീഴുമോ?","poem":2},{"text":"എന്തെങ്കിലും അകപ്പെടാതെ","poem":1},{"text":"കെണി നിലത്തുനിന്നു പൊങ്ങുമോ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"പട്ടണത്തിൽ കാഹളം ധ്വനിക്കുമ്പോൾ","poem":1},{"text":"ജനം വിറയ്ക്കുകയില്ലയോ?","poem":2},{"text":"യഹോവ വരുത്തീട്ടല്ലാതെ","poem":1},{"text":"ഒരു പട്ടണത്തിൽ അനർഥം വരുമോ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"തന്റെ ദാസന്മാരായ പ്രവാചകന്മാർക്കു","poem":1},{"text":"താൻ ചെയ്യാനിരിക്കുന്നതു വെളിപ്പെടുത്താതെ","poem":2},{"lineBreak":true},{"text":"കർത്താവായ യഹോവ ഒന്നും ചെയ്യുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"സിംഹം ഗർജിച്ചിരിക്കുന്നു,","poem":1},{"text":"ആരെങ്കിലും ഭയപ്പെടാതിരിക്കുമോ?","poem":2},{"text":"കർത്താവായ യഹോവ അരുളിച്ചെയ്തിരിക്കുന്നു,","poem":1},{"text":"ആര് പ്രവചിക്കാതിരിക്കും?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"അശ്ദോദിലെയും ഈജിപ്റ്റിലെയും","poem":1},{"text":"കോട്ടകളിൽ വിളംബരംചെയ്യുക:","poem":2},{"text":"“ശമര്യാപർവതങ്ങളിൽ കൂടിവരിക;","poem":1},{"text":"അവളുടെ വലിയ അസ്വസ്ഥതയും","poem":2},{"lineBreak":true},{"text":"അവളുടെ ജനത്തിന്റെ പീഡയും നേരിൽ കാണുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“തങ്ങളുടെ കോട്ടകളിൽ കൊള്ളയും അന്യായമുതലും","poem":1},{"text":"ശേഖരിച്ചുവെച്ചിരിക്കുന്ന അവർക്ക്","poem":2},{"lineBreak":true},{"text":"ന്യായം പ്രവർത്തിക്കാൻ അറിഞ്ഞുകൂടാ,” എന്ന് യഹോവ അരുളിച്ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":11,"content":["അതുകൊണ്ടു, കർത്താവായ യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:",{"text":"“ഒരു ശത്രു നിങ്ങളുടെ ദേശം കീഴടക്കും,","poem":1},{"text":"അവൻ നിങ്ങളുടെ സുരക്ഷിതസ്ഥാനങ്ങൾ തകർക്കും","poem":2},{"lineBreak":true},{"text":"നിങ്ങളുടെ കോട്ടകൾ കൊള്ളയടിക്കും.”","poem":2}]},{"type":"verse","number":12,"content":["യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:",{"text":"“ഒരു ഇടയൻ, സിംഹത്തിന്റെ വായിൽനിന്ന്","poem":1},{"text":"രണ്ടു കാലിന്റെ എല്ലുകളോ കാതിന്റെ ഒരു കഷണമോ വലിച്ചെടുക്കുന്നതുപോലെ,","poem":2},{"text":"ശമര്യയിൽ കിടക്കയുടെ അറ്റത്തും","poem":1},{"text":"ദമസ്കോസിൽ കട്ടിലുകളിലും","poem":2},{"lineBreak":true},{"text":"ഇരിക്കുന്ന ഇസ്രായേൽജനം മോചിക്കപ്പെടും.”","poem":2}]},{"type":"verse","number":13,"content":["“നിങ്ങൾ ഇതു കേട്ട് യാക്കോബ് ഗൃഹത്തിനെതിരേ സാക്ഷ്യം പറയുക,” എന്നു സൈന്യങ്ങളുടെ ദൈവം, യഹോവയായ കർത്താവുതന്നെ അരുളിച്ചെയ്യുന്നു."]},{"type":"verse","number":14,"content":[{"text":"“ഞാൻ ഇസ്രായേലിനെ അവളുടെ പാപങ്ങൾനിമിത്തം ശിക്ഷിക്കുമ്പോൾ,","poem":1},{"text":"ഞാൻ ബേഥേലിലെ ബലിപീഠങ്ങളെ നശിപ്പിക്കും;","poem":2},{"text":"ബലിപീഠത്തിന്റെ കൊമ്പുകൾ ഛേദിക്കപ്പെട്ടു","poem":1},{"text":"നിലത്തു വീഴും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഞാൻ വേനൽക്കാല വസതികളെയും","poem":1},{"text":"ശൈത്യകാല വസതികളെയും പൊളിച്ചുകളയും;","poem":2},{"text":"ദന്താലംകൃത മന്ദിരങ്ങളെയും ഞാൻ നശിപ്പിക്കും","poem":1},{"text":"ഞാൻ കൊട്ടാരങ്ങളെയും പൊളിച്ചുകളയും,”","poem":2},{"text":"എന്ന് യഹോവ അരുളിച്ചെയ്യുന്നു.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}