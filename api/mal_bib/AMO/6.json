{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"AMO","translationId":"mal_bib","name":"ആമോസ്","commonName":"ആമോസ്","title":"ആമോസിന്റെ പ്രവചനം","order":30,"numberOfChapters":9,"sha256":"ce2d28463116bb92559d16d0cd6590b47accf4f397b8ecc1f0dc65d660f03fae","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/mal_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":6,"content":[{"type":"heading","content":["നിർവിചാരികൾക്കു ഹാ കഷ്ടം"]},{"type":"verse","number":1,"content":[{"text":"സീയോനിൽ നിർവിചാരികളായിരിക്കുന്നവർക്കും","poem":1},{"text":"ശമര്യാപർവതത്തിൽ നിർഭയരായിരിക്കുന്നവർക്കും","poem":2},{"text":"യെഹൂദേതരരിൽ പ്രധാനികളായി","poem":1},{"text":"ഇസ്രായേൽജനം അന്വേഷിക്കുന്ന ശ്രേഷ്ഠന്മാർക്കും ഹാ കഷ്ടം!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"കൽനെയിൽച്ചെന്ന് അതിനെ നോക്കുക;","poem":1},{"text":"അവിടെനിന്നു മഹാനഗരമായ ഹമാത്തിലേക്കു പോകുക;","poem":2},{"lineBreak":true},{"text":"അവിടെനിന്നു ഫെലിസ്ത്യരുടെ ഗത്തിലേക്കും പോകുക.","poem":2},{"text":"ഇവർ നിങ്ങളുടെ രണ്ടു രാജ്യങ്ങളെക്കാൾ നന്നായിരിക്കുന്നോ?","poem":1},{"text":"അവരുടെ ദേശം നിങ്ങളുടേതിനെക്കാൾ വിശാലമോ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"നിങ്ങൾ ദുർദിനം നീട്ടിവെക്കുന്നു,","poem":1},{"text":"ഭീകരവാഴ്ചയെ സമീപസ്ഥമാക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ദന്താലംകൃതമായ കട്ടിലുകളിൽ നിങ്ങൾ കിടക്കുന്നു","poem":1},{"text":"ചാരുകട്ടിലുകളിൽ ചാരിക്കിടക്കുകയും ചെയ്യുന്നു.","poem":2},{"text":"കുഞ്ഞാടുകളെയും തടിപ്പിച്ച കാളക്കിടാങ്ങളെയും","poem":1},{"text":"നിങ്ങൾ ഭക്ഷിക്കുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"നിങ്ങൾ ദാവീദിനെപ്പോലെ കിന്നരങ്ങൾ ഉപയോഗിക്കുന്നു;","poem":1},{"text":"സംഗീതോപകരണങ്ങൾ യാതൊരു മുന്നൊരുക്കവുമില്ലാതെ മീട്ടുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"നിങ്ങൾ ചഷകങ്ങൾ നിറയെ വീഞ്ഞു കുടിക്കുന്നു","poem":1},{"text":"വിശേഷതൈലങ്ങൾ തേക്കുകയും ചെയ്യുന്നു.","poem":2},{"lineBreak":true},{"text":"എന്നാൽ, യോസേഫിന്റെ നഷ്ടാവശിഷ്ടങ്ങളിൽ നിങ്ങൾ ദുഃഖിക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അതുകൊണ്ടു, നിങ്ങൾ ആദ്യം പ്രവാസത്തിലേക്കു പോകേണ്ടിവരും;","poem":1},{"text":"നിങ്ങളുടെ വിരുന്നും സുഖശയനവും അവസാനിക്കും.","poem":2}]},{"type":"heading","content":["യഹോവ ഇസ്രായേലിന്റെ നിഗളത്തെ വെറുക്കുന്നു"]},{"type":"verse","number":8,"content":["യഹോവയായ കർത്താവു തന്നെക്കൊണ്ടുതന്നെ ശപഥംചെയ്യുന്നു; സൈന്യങ്ങളുടെ ദൈവമായ യഹോവ പ്രഖ്യാപിക്കുന്നു:",{"text":"“ഞാൻ യാക്കോബിന്റെ നിഗളത്തെ വെറുക്കുന്നു;","poem":1},{"text":"അവന്റെ കോട്ടകളിൽ എനിക്കു പ്രിയമില്ല,","poem":2},{"text":"ഞാൻ പട്ടണത്തെയും","poem":1},{"text":"അതിലുള്ള സകലത്തെയും ഏൽപ്പിച്ചുകൊടുക്കും.”","poem":2}]},{"type":"verse","number":9,"content":["ഒരു വീട്ടിൽ പത്തു പുരുഷന്മാർ ശേഷിച്ചിരുന്നാൽ അവരും മരിച്ചുപോകും."]},{"type":"verse","number":10,"content":["മൃതശരീരങ്ങളെ ദഹിപ്പിക്കേണ്ടതിനു വീട്ടിൽനിന്ന് പുറത്തുകൊണ്ടുപോകാൻ അവരുടെ ഒരു ബന്ധു വന്നു, ആ വീട്ടിൽ ഒളിച്ചിരിക്കുന്ന ഒരുവനോടു “നിന്റെ അടുക്കൽ ആരെങ്കിലും ഉണ്ടോ?” എന്നു ചോദിക്കും. അപ്പോൾ: “ഇല്ല, ശബ്ദിക്കരുത്; നാം യഹോവയുടെ നാമം ഉച്ചരിക്കരുത്.” എന്ന് അവൻ പറയും."]},{"type":"verse","number":11,"content":[{"text":"യഹോവ കൽപ്പന അയച്ചുകഴിഞ്ഞു,","poem":1},{"text":"യഹോവ വലിയ വീട് തകർത്തുകളയും","poem":2},{"lineBreak":true},{"text":"ചെറിയ വീട് ഛിന്നഭിന്നമാകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"കുതിര പാറപ്പുറത്ത് ഓടുമോ?","poem":1},{"text":"അവിടെ ആരെങ്കിലും കാളയെ പൂട്ടി ഉഴുമോ?","poem":2},{"text":"എന്നാൽ, നിങ്ങൾ ന്യായത്തെ വിഷമാക്കി;","poem":1},{"text":"നീതിയിൻ ഫലത്തെ കയ്‌പാക്കിയുമിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ലോ-ദേബാരിനെ","poem":1},{"noteId":8},{"text":"കീഴടക്കിയതിൽ ആനന്ദിച്ചുകൊണ്ട്,","poem":1},{"text":"“നമ്മുടെ സ്വന്തശക്തികൊണ്ടു കർണയിമിനെ","poem":2},{"noteId":9},{"text":"നാം പിടിച്ചടക്കിയില്ലയോ” എന്നു പറയുന്നവരേ,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"സൈന്യങ്ങളുടെ ദൈവമായ യഹോവ പ്രഖ്യാപിക്കുന്നു:","poem":1},{"text":"“ഇസ്രായേൽഗൃഹമേ, ഞാൻ നിനക്കെതിരേ ഒരു രാജ്യത്തെ ഉണർത്തും;","poem":2},{"text":"അവർ നിങ്ങളെ ലെബോ-ഹമാത്തുമുതൽ അരാബാ താഴ്വരവരെ","poem":1},{"text":"എല്ലാ നിലകളിലും പീഡിപ്പിക്കും.”","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"ശൂന്യം എന്നർഥം.","reference":{"chapter":6,"verse":13}},{"noteId":9,"caller":"+","text":"കൊമ്പ് എന്നർഥം. കൊമ്പ് ഇവിടെ ശക്തിയുടെ പ്രതീകമാണ്.","reference":{"chapter":6,"verse":13}}]},"thisChapterLink":"/api/mal_bib/AMO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/AMO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/AMO/5.json","previousChapterAudioLinks":{},"numberOfVerses":14}