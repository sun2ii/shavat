{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"AMO","translationId":"mal_bib","name":"ആമോസ്","commonName":"ആമോസ്","title":"ആമോസിന്റെ പ്രവചനം","order":30,"numberOfChapters":9,"sha256":"ce2d28463116bb92559d16d0cd6590b47accf4f397b8ecc1f0dc65d660f03fae","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/mal_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":9,"content":[{"type":"heading","content":["ഇസ്രായേൽ നശിപ്പിക്കപ്പെടും"]},{"type":"verse","number":1,"content":["കർത്താവ് യാഗപീഠത്തിനുസമീപം നിൽക്കുന്നതു ഞാൻ കണ്ടു; അവിടന്ന് ഇപ്രകാരം അരുളിച്ചെയ്തു:",{"text":"“പടിവാതിലുകൾ കുലുങ്ങത്തക്കവണ്ണം","poem":1},{"text":"ഗോപുരങ്ങളുടെ ശിരസ്സിൽ അടിക്കുക.","poem":2},{"text":"സകലജനത്തിന്റെയും ശിരസ്സിൽ അവയെ തള്ളിയിടുക;","poem":1},{"text":"ശേഷിച്ചിരിക്കുന്ന എല്ലാവരെയും ഞാൻ വാൾകൊണ്ടു കൊല്ലും.","poem":2},{"text":"ആരും രക്ഷപ്പെടുകയില്ല,","poem":1},{"text":"ഓടിപ്പോകുകയുമില്ല.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവർ പാതാളത്തിലേക്ക് കുഴിച്ചിറങ്ങിയാലും","poem":1},{"text":"എന്റെ കൈ അവിടെ അവരെ പിടിക്കും.","poem":2},{"text":"അവർ സ്വർഗംവരെ കയറിയാലും","poem":1},{"text":"ഞാൻ അവരെ താഴെയിറക്കും.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവർ കർമേലിന്റെ നെറുകയിൽ ഒളിച്ചാലും","poem":1},{"text":"ഞാൻ അവരെ വേട്ടയാടിപ്പിടിക്കും.","poem":2},{"text":"അവർ എന്നെ വിട്ട് ഓടി സമുദ്രത്തിന്റെ അടിത്തട്ടിൽ ഒളിച്ചാലും,","poem":1},{"text":"അവിടെ, അവരെ കടിക്കാൻ സർപ്പത്തോടു ഞാൻ കൽപ്പിക്കും.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവരുടെ ശത്രുക്കൾനിമിത്തം അവർ പ്രവാസത്തിലേക്കു പോയാലും","poem":1},{"text":"അവിടെ അവരെ കൊല്ലുന്നതിനു ഞാൻ വാളിനോടു കൽപ്പിക്കും.","poem":2},{"lineBreak":true},{"text":"“ഞാൻ അവരുടെമേൽ നന്മയ്ക്കല്ല, തിന്മയ്ക്കുതന്നെ","poem":1},{"text":"എന്റെ ദൃഷ്ടി പതിക്കും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"സൈന്യങ്ങളുടെ യഹോവയായ കർത്താവ്","poem":1},{"lineBreak":true},{"text":"ഭൂമിയെ തൊടുന്നു, അത് ഉരുകിപ്പോകുന്നു;","poem":1},{"text":"ഭൂവാസികളൊക്കെയും വിലപിക്കുന്നു.","poem":2},{"text":"ദേശംമുഴുവനും നൈൽനദിപോലെ ഉയരുന്നു,","poem":1},{"text":"ഈജിപ്റ്റിലെ നദിപോലെ അതു താഴുകയും ചെയ്യുന്നു;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവിടന്നു തന്റെ കൊട്ടാരം സ്വർഗത്തിൽ പണിയുന്നു,","poem":1},{"text":"അതിന്റെ അടിസ്ഥാനം","poem":2},{"noteId":12},{"text":"ഭൂമിയിൽ ഇടുന്നു;","poem":2},{"text":"സമുദ്രത്തിലെ വെള്ളത്തെ അവിടന്നു വിളിക്കുന്നു","poem":1},{"text":"ഭൂമുഖത്തേക്ക് ആ വെള്ളം വർഷിക്കുന്നു—","poem":2},{"lineBreak":true},{"text":"യഹോവ എന്നാകുന്നു അവിടത്തെ നാമം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“നിങ്ങൾ ഇസ്രായേല്യർ","poem":1},{"text":"എനിക്കു കൂശ്യരെപ്പോലെയല്ലേ?”","poem":2},{"text":"യഹോവ ചോദിക്കുന്നു.","poem":4},{"text":"“ഇസ്രായേലിനെ ഈജിപ്റ്റിൽനിന്നും","poem":1},{"text":"ഫെലിസ്ത്യരെ കഫ്തോരിൽനിന്നും","poem":2},{"lineBreak":true},{"text":"അരാമ്യരെ കീറിൽനിന്നും ഞാനല്ലയോ കൊണ്ടുവന്നത്?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“കർത്താവായ യഹോവയുടെ കണ്ണുകൾ","poem":1},{"text":"പാപംനിറഞ്ഞ രാജ്യത്തിന്മേൽ ഉണ്ട്.","poem":2},{"text":"ഞാൻ അതിനെ നശിപ്പിക്കും","poem":1},{"text":"ഭൂമുഖത്തുനിന്നുതന്നെ.","poem":2},{"text":"എങ്കിലും ഞാൻ യാക്കോബുഗൃഹത്തെ","poem":1},{"text":"ഉന്മൂലനാശം ചെയ്യുകയില്ല,”","poem":2},{"text":"എന്ന് യഹോവ അരുളിച്ചെയ്യുന്നു.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"“ഞാൻ കൽപ്പന കൊടുക്കും,","poem":1},{"text":"ധാന്യം മുറത്തിൽ പാറ്റിയെടുക്കുന്നതുപോലെ","poem":2},{"lineBreak":true},{"text":"ഞാൻ സകലരാഷ്ട്രങ്ങളുടെയും മധ്യത്തിൽ","poem":2},{"text":"ഇസ്രായേൽഗൃഹത്തെ പാറ്റും,","poem":1},{"text":"ഒരു ചരൽക്കല്ലുപോലും നഷ്ടപ്പെടുകയില്ല.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"എന്റെ ജനത്തിന്റെ മധ്യത്തിലുള്ള സകലപാപികളും,","poem":1},{"text":"‘നമുക്ക് അത്യാഹിതമൊന്നും വരികയില്ല,","poem":2},{"text":"ഒന്നും സംഭവിക്കുകയുമില്ല,’","poem":1},{"text":"എന്നു പറയുന്നവരും വാളിനാൽ മരിക്കും.","poem":2}]},{"type":"heading","content":["ഇസ്രായേലിന്റെ പുനഃസ്ഥാപനം"]},{"type":"verse","number":11,"content":["“ആ ദിവസത്തിൽ,",{"text":"“ദാവീദിന്റെ വീണുപോയ കൂടാരത്തെ ഞാൻ പുനഃസ്ഥാപിക്കും—","poem":1},{"text":"അതിന്റെ ഇടിഞ്ഞ മതിലുകൾ ഞാൻ ശരിയാക്കും","poem":2},{"lineBreak":true},{"text":"അതിന്റെ നാശങ്ങളെ പരിഹരിച്ച്","poem":2},{"lineBreak":true},{"text":"അതിനെ യഥാസ്ഥാനപ്പെടുത്തും.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അങ്ങനെ അവർ ഏദോമിൽ ശേഷിച്ചവരെയും","poem":1},{"text":"എന്റെ നാമം വഹിക്കുന്ന എല്ലാ രാജ്യങ്ങളെയും കൈവശമാക്കും,”","poem":2},{"text":"എന്ന് ഇതു ചെയ്യുന്ന യഹോവതന്നെ അരുളിച്ചെയ്യുന്നു.","poem":4}]},{"type":"verse","number":13,"content":["യഹോവ അരുളിച്ചെയ്യുന്നു:",{"text":"“ഉഴുന്നവർ കൊയ്ത്തുകാരുടെ മുന്നിലെത്തുകയും","poem":1},{"text":"മുന്തിരിച്ചക്കു ചവിട്ടുന്നവർ മുന്തിരിക്കൃഷി ചെയ്യുന്നവരുടെ മുന്നിലെത്തുകയും ചെയ്യും.","poem":2},{"text":"പർവതങ്ങളിൽനിന്ന് പുതുവീഞ്ഞു വർഷിക്കുകയും","poem":1},{"text":"എല്ലാ കുന്നുകളിൽനിന്നും അതു പ്രവഹിക്കുകയും ചെയ്യുന്ന ദിവസങ്ങൾ വരുന്നു!","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"പ്രവാസത്തിലേക്കുപോയ എന്റെ ജനമായ ഇസ്രായേലിനെ ഞാൻ മടക്കിക്കൊണ്ടുവരും.","poem":2},{"lineBreak":true},{"text":"“നശിപ്പിക്കപ്പെട്ട പട്ടണങ്ങളെ അവർ വീണ്ടും പണിത് അവിടെ പാർക്കും.","poem":1},{"text":"അവർ മുന്തിരിത്തോപ്പുകൾ നട്ടുണ്ടാക്കി, അവയിലെ വീഞ്ഞു കുടിക്കും;","poem":2},{"lineBreak":true},{"text":"അവർ തോട്ടങ്ങൾ നട്ടുണ്ടാക്കുകയും അതിലെ പഴം തിന്നുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഞാൻ ഇസ്രായേലിനെ അവരുടെ സ്വന്തം ദേശത്തു നടും,","poem":1},{"text":"ഞാൻ അവർക്കു കൊടുത്ത ദേശത്തുനിന്ന്","poem":2},{"lineBreak":true},{"text":"ഇനിയൊരിക്കലും അവർ പറിച്ചുകളയപ്പെടുകയില്ല,”","poem":2},{"text":"എന്നു നിങ്ങളുടെ ദൈവമായ യഹോവ അരുളിച്ചെയ്യുന്നു.","poem":4}]}],"footnotes":[{"noteId":12,"caller":"+","text":"ഈ വാക്കിനുള്ള എബ്രായപദത്തിന്റെ അർഥം വ്യക്തമല്ല.","reference":{"chapter":9,"verse":6}}]},"thisChapterLink":"/api/mal_bib/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/OBA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}