{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"EST","translationId":"mal_bib","name":"എസ്ഥേർ","commonName":"എസ്ഥേർ","title":"എസ്ഥേർ","order":17,"numberOfChapters":10,"sha256":"1223d77e9b834a447dc0aa3e80592b00ddef0957cde8cdb2b03388023e2b5a56","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/EST/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/mal_bib/EST/10.json","totalNumberOfVerses":166},"chapter":{"number":10,"content":[{"type":"heading","content":["മൊർദെഖായിയുടെ ബഹുമതി"]},{"type":"verse","number":1,"content":["അഹശ്വേരോശ് രാജാവ് രാജ്യത്തുടനീളം വിദൂരതീരങ്ങൾക്കും കരം ഏർപ്പെടുത്തി."]},{"type":"verse","number":2,"content":["അദ്ദേഹത്തിന്റെ അധികാരത്തിന്റെയും ശക്തിയുടെയും എല്ലാ പ്രവൃത്തികളും മൊർദെഖായിക്കു നൽകിയ ബഹുമതിയുടെ കാര്യങ്ങളും മേദ്യയിലെയും പാർസ്യയിലെയും രാജാക്കന്മാരുടെ ചരിത്രഗ്രന്ഥങ്ങളിൽ രേഖപ്പെടുത്തിയിട്ടില്ലേ?"]},{"type":"verse","number":3,"content":["മൊർദെഖായി എന്ന യെഹൂദൻ അഹശ്വേരോശ് രാജാവിനു രണ്ടാമനും, യെഹൂദന്മാരുടെ ഇടയിൽ ഉന്നതനും തന്റെ വർഗക്കാരുടെ ഇടയിൽ സമ്മതനും ആയിരുന്നു. കാരണം അദ്ദേഹം തന്റെ ജനത്തിന്റെ നന്മയ്ക്കായിട്ടു പ്രവർത്തിക്കയും, അവരുടെ അഭിവൃദ്ധിക്കായി നിലകൊള്ളുകയും ചെയ്തു."]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/EST/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/JOB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/EST/9.json","previousChapterAudioLinks":{},"numberOfVerses":3}