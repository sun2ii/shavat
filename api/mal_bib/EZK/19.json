{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"EZK","translationId":"mal_bib","name":"യെഹെസ്കേൽ","commonName":"യെഹെസ്കേൽ","title":"യെഹെസ്കേലിന്റെ പ്രവചനം","order":26,"numberOfChapters":48,"sha256":"d264f9f836a21eeb699d0598000b67d8f8838ad8644a0f13dd312bd959020417","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/mal_bib/EZK/48.json","totalNumberOfVerses":1267},"chapter":{"number":19,"content":[{"type":"heading","content":["ഇസ്രായേലിലെ പ്രഭുക്കന്മാരെക്കുറിച്ച് ഒരു വിലാപഗാനം"]},{"type":"verse","number":1,"content":["“നീ ഇസ്രായേലിലെ പ്രഭുക്കന്മാരെക്കുറിച്ച് ഇപ്രകാരം ഒരു വിലാപഗാനം ആലപിക്കുക:"]},{"type":"verse","number":2,"content":[{"text":"“ ‘സിംഹങ്ങളുടെ മധ്യത്തിൽ എന്തൊരു സിംഹിയായിരുന്നു","poem":1},{"text":"നിന്റെ മാതാവ് ആരായിരുന്നു!","poem":2},{"text":"അവൾ സിംഹക്കുട്ടികളുടെ ഇടയിൽക്കിടന്ന്,","poem":1},{"text":"അവളുടെ കുട്ടികളെ വളർത്തിക്കൊണ്ടുവന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"തന്റെ കുട്ടികളിൽ ഒന്നിനെ അവൾ വളർത്തിക്കൊണ്ടുവന്നു;","poem":1},{"text":"അവൻ ഒരു ശക്തനായ സിംഹമായിത്തീർന്നു.","poem":2},{"text":"ഇരകളെ കടിച്ചുചീന്തുന്നതിന് അവൻ ശീലിച്ചു.","poem":1},{"text":"മനുഷ്യരെ അവൻ വിഴുങ്ങിക്കളഞ്ഞു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"രാഷ്ട്രങ്ങൾ അവനെപ്പറ്റി കേട്ടു,","poem":1},{"text":"അവർ കുഴിച്ച കുഴിയിൽ അവൻ പിടിക്കപ്പെട്ടു.","poem":2},{"text":"അവർ അവനെ ചങ്ങലയ്ക്കിട്ട്","poem":1},{"text":"ഈജിപ്റ്റുദേശത്തു കൊണ്ടുവന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ ‘അവൾ തന്റെ ആഗ്രഹത്തിനു","poem":1},{"text":"ഭംഗം സംഭവിച്ചതുകണ്ട്","poem":2},{"text":"തന്റെ സിംഹക്കുട്ടികളിൽ മറ്റൊന്നിനെ വളർത്തി","poem":1},{"text":"ശക്തനായ ഒരു സിംഹമാക്കിമാറ്റി.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവൻ സിംഹങ്ങൾക്കിടയിൽ സഞ്ചരിച്ച്,","poem":1},{"text":"ഇപ്പോൾ ശക്തനായ ഒരു സിംഹമായിത്തീർന്നു.","poem":2},{"text":"ഇരയെ കടിച്ചുചീന്തുവാൻ അവൻ ശീലിച്ചു;","poem":1},{"text":"അവനും മനുഷ്യരെ വിഴുങ്ങിക്കളഞ്ഞു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവരുടെ ബലമേറിയ ശക്തികേന്ദ്രങ്ങൾ അവൻ തകർത്തു;","poem":1},{"text":"അവരുടെ നഗരങ്ങളെ അവൻ ശൂന്യമാക്കി.","poem":2},{"text":"അവന്റെ ഗർജനം കേട്ട്","poem":1},{"text":"ദേശവും അതിലെ സകലനിവാസികളും നടുങ്ങി.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"രാഷ്ട്രങ്ങൾ തങ്ങളുടെ പ്രവിശ്യകളിലുള്ള","poem":1},{"text":"എല്ലാ ദിക്കുകളിൽനിന്നും അവന്റെനേരേ ആക്രമിച്ചു.","poem":2},{"text":"അവർ അവനായി വല വിരിച്ചു;","poem":1},{"text":"അവർ കുഴിച്ച കുഴിയിൽ അവൻ പിടിക്കപ്പെട്ടു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവർ അവനെ ചങ്ങലയിട്ട് ഒരു കൂട്ടിലാക്കി;","poem":1},{"text":"അവനെ ബാബേൽരാജാവിന്റെ അടുക്കൽ കൊണ്ടുവന്നു.","poem":2},{"text":"ഇസ്രായേൽ പർവതങ്ങളിൽ","poem":1},{"text":"അവന്റെ ഗർജനം ഇനി കേൾക്കാതിരിക്കേണ്ടതിന്","poem":2},{"lineBreak":true},{"text":"അവർ അവനെ കാരാഗൃഹത്തിൽ അടച്ചു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘നിന്റെ അമ്മ നിന്റെ മുന്തിരിത്തോപ്പിൽ","poem":1},{"text":"വെള്ളങ്ങൾക്കരികെ നട്ട ഒരു മുന്തിരിവള്ളിപോലെ ആയിരുന്നു;","poem":2},{"text":"ജലസമൃദ്ധിനിമിത്തം അത് ഫലഭൂയിഷ്ഠവും","poem":1},{"text":"ശാഖകൾ നിറഞ്ഞതും ആയിരുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"രാജാക്കന്മാർക്കു ചെങ്കോൽ നിർമിക്കാൻ പറ്റിയ","poem":1},{"text":"കടുപ്പമുള്ള ശാഖകൾ അതിന് ഉണ്ടായിരുന്നു.","poem":2},{"text":"തിങ്ങിനിറഞ്ഞ പച്ചിലച്ചാർത്തിനുമീതേ","poem":1},{"text":"അത് ഉയർന്നുനിന്നിരുന്നു.","poem":2},{"text":"അതിന്റെ ഉയരംകൊണ്ടും അനവധി ശാഖകൾകൊണ്ടും","poem":1},{"text":"അതു സുവ്യക്തമായി കാണാമായിരുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"എന്നാൽ കോപത്തോടെ അതിനെ പിഴുതെടുത്തു;","poem":1},{"text":"അതിനെ നിലത്തു തള്ളിയിട്ടു;","poem":2},{"text":"കിഴക്കൻകാറ്റ് അതിനെ ഉണക്കിക്കളഞ്ഞു,","poem":1},{"text":"അതിലെ കായ്കൾ ഉതിർന്നുപോയി.","poem":2},{"text":"അതിന്റെ ബലമേറിയ കൊമ്പുകൾ ഉണങ്ങിപ്പോയി,","poem":1},{"text":"അഗ്നി അതിനെ ദഹിപ്പിച്ചുകളഞ്ഞു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ഇപ്പോൾ അതിനെ മരുഭൂമിയിൽ,","poem":1},{"text":"ഉണങ്ങിവരണ്ട നിലത്തു നട്ടിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"പ്രധാന ശാഖയിൽനിന്ന് അഗ്നി പടർന്ന്","poem":1},{"text":"അതിന്റെ ഫലങ്ങൾ ചുട്ടെരിക്കപ്പെട്ടു.","poem":2},{"text":"അധിപതിയുടെ ഒരു ചെങ്കോലിന് ഉപയുക്തമായ","poem":1},{"text":"ഒരു ശാഖയും അതിൽ അവശേഷിച്ചില്ല.’","poem":2},"ഇത് ഒരു വിലാപം; ഒരു വിലാപഗീതമായി ഉപയോഗിക്കപ്പെടേണ്ടതുമാണ്.”"]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}