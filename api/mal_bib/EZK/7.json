{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"EZK","translationId":"mal_bib","name":"യെഹെസ്കേൽ","commonName":"യെഹെസ്കേൽ","title":"യെഹെസ്കേലിന്റെ പ്രവചനം","order":26,"numberOfChapters":48,"sha256":"d264f9f836a21eeb699d0598000b67d8f8838ad8644a0f13dd312bd959020417","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/mal_bib/EZK/48.json","totalNumberOfVerses":1267},"chapter":{"number":7,"content":[{"type":"heading","content":["അന്ത്യം വന്നെത്തിയിരിക്കുന്നു"]},{"type":"verse","number":1,"content":["യഹോവയുടെ അരുളപ്പാട് ഇപ്രകാരം എനിക്കുണ്ടായി:"]},{"type":"verse","number":2,"content":["“മനുഷ്യപുത്രാ, ഇസ്രായേൽദേശത്തോട് കർത്താവായ യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:",{"text":"“ ‘ഇതാ അവസാനം! ദേശത്തിന്റെ നാലു കോണുകളിലും","poem":1},{"text":"അവസാനം വന്നെത്തിയിരിക്കുന്നു!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ഇപ്പോൾ അവസാനം നിന്റെമേൽ വന്നെത്തിയിരിക്കുന്നു,","poem":1},{"text":"ഞാൻ എന്റെ കോപം നിനക്കെതിരേ അഴിച്ചുവിടും.","poem":2},{"text":"നിന്റെ പെരുമാറ്റത്തിന് അനുസൃതമായി ഞാൻ നിന്നെ ന്യായംവിധിക്കും","poem":1},{"text":"അറപ്പുളവാക്കുന്ന നിന്റെ സകലപ്രവൃത്തികൾക്കും നിന്നോടു പകരംവീട്ടും.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"എന്റെ കണ്ണ് യാതൊരനുകമ്പയും നിന്നോടു കാണിക്കുകയില്ല;","poem":1},{"text":"ഒരു ദാക്ഷിണ്യവും നിനക്കു ലഭിക്കുകയില്ല.","poem":2},{"text":"നിന്റെ പെരുമാറ്റരീതിക്ക് ഒത്തവണ്ണം നിശ്ചയമായും ഞാൻ നിന്നോടു പകരംചെയ്യും,","poem":1},{"text":"നിന്റെ മ്ലേച്ഛമായ പ്രവൃത്തികളാൽത്തന്നെ.","poem":2},"അങ്ങനെ ഞാൻ യഹോവ ആകുന്നു എന്നു നിങ്ങൾ അറിയും.’"]},{"type":"line_break"},{"type":"verse","number":5,"content":["“യഹോവയായ കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:",{"text":"“ ‘അനർഥം! അനർഥത്തിനു പിറകെ അനർഥം!","poem":1},{"text":"ഇതാ അതു വരുന്നു!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവസാനം വന്നെത്തിയിരിക്കുന്നു!","poem":1},{"text":"അവസാനം വന്നെത്തിയിരിക്കുന്നു!","poem":2},{"text":"അതു നിന്റെനേരേ ഉണർന്നുവരുന്നു.","poem":1},{"text":"ഇതാ, അതു വന്നിരിക്കുന്നു!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"വിനാശം നിന്മേൽ വന്നെത്തിയിരിക്കുന്നു,","poem":1},{"text":"ഈ ദേശത്തു വസിക്കുന്ന നിന്മേൽത്തന്നെ.","poem":2},{"text":"സമയം വന്നെത്തിയിരിക്കുന്നു! ആ ദിവസം സമീപമായി!","poem":1},{"text":"പർവതങ്ങളിൽ ആർപ്പുവിളി കേൾക്കുന്നു; ആനന്ദത്തിന്റെ അല്ലതാനും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ഇപ്പോൾത്തന്നെ ഞാൻ എന്റെ ക്രോധം നിന്റെമേൽ ചൊരിയും;","poem":1},{"text":"നിന്നോടുള്ള എന്റെ കോപം ഞാൻ നിറവേറ്റും;","poem":2},{"text":"നിന്റെ പെരുമാറ്റത്തിന് അനുസൃതമായിത്തന്നെ ഞാൻ നിന്നെ ന്യായംവിധിക്കുകയും","poem":1},{"text":"നിന്റെ മ്ലേച്ഛതകൾക്കെല്ലാം നിന്നോടു പകരംവീട്ടുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"എന്റെ കണ്ണ് യാതൊരനുകമ്പയും നിന്നോടു കാണിക്കുകയില്ല;","poem":1},{"text":"യാതൊരു ദാക്ഷിണ്യവും നിനക്കു ലഭിക്കുകയില്ല.","poem":2},{"text":"നിന്റെ പെരുമാറ്റരീതിക്കൊത്തവണ്ണം ഞാൻ നിന്നോടു പകരംചെയ്യും,","poem":1},{"text":"നിന്റെ മ്ലേച്ഛമായ പ്രവൃത്തികളാൽത്തന്നെ.","poem":2},"അപ്പോൾ യഹോവയാണ് നിന്നെ ദണ്ഡിപ്പിക്കുന്നതെന്നു നീ അറിയും."]},{"type":"verse","number":10,"content":[{"text":"“ ‘ഇതാ, ആ ദിവസം!","poem":1},{"text":"ഇതാ, അതു വരുന്നു!","poem":2},{"text":"നിന്റെ നാശം പുറപ്പെട്ടിരിക്കുന്നു;","poem":1},{"text":"വടി പൂത്തിരിക്കുന്നു,","poem":2},{"lineBreak":true},{"text":"അഹങ്കാരം തളിർത്തിരിക്കുന്നു!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അക്രമം എഴുന്നേറ്റിരിക്കുന്നു,","poem":1},{"text":"ദുഷ്ടരെ ശിക്ഷിക്കുന്നതിനുള്ള ഒരു വടിയായിത്തന്നെ.","poem":2},{"text":"ആ ജനത്തിൽ ആരുംതന്നെ,","poem":1},{"text":"ആ ജനസമൂഹത്തിലോ","poem":2},{"text":"അവരുടെ ധനത്തിലോ","poem":1},{"text":"മൂല്യവത്തായ ഒന്നും അവശേഷിക്കുകയില്ല.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"സമയം വന്നെത്തിയിരിക്കുന്നു!","poem":1},{"text":"ആ ദിവസം എത്തിച്ചേർന്നു!","poem":2},{"text":"വാങ്ങുന്നവർ സന്തോഷിക്കുകയോ","poem":1},{"text":"വിൽക്കുന്നവർ വിലപിക്കയോ ചെയ്യാതിരിക്കട്ടെ;","poem":2},{"lineBreak":true},{"text":"കാരണം, എന്റെ ക്രോധം ആ മുഴുവൻ ജനസമൂഹത്തിന്മേലും വന്നിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"വാങ്ങുന്നവരും വിൽക്കുന്നവരും ജീവിച്ചിരിക്കുന്നിടത്തോളം","poem":1},{"text":"വിറ്റവന് താൻ വിറ്റതു","poem":2},{"lineBreak":true},{"text":"തിരിച്ചുകിട്ടുകയില്ല.","poem":2},{"text":"അവരുടെ എല്ലാ പുരുഷാരത്തെപ്പറ്റിയുമുള്ള","poem":1},{"text":"ദർശനം മറിച്ചാകുകയില്ല.","poem":2},{"text":"അവരുടെ പാപംനിമിത്തം","poem":1},{"text":"ഒരാളുടെയും ജീവൻ സംരക്ഷിക്കപ്പെടുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ ‘അവർ കാഹളമൂതി","poem":1},{"text":"സകലതും സജ്ജമാക്കിയിരിക്കുന്നു;","poem":2},{"text":"എന്നാൽ ആരുംതന്നെ യുദ്ധത്തിനു പുറപ്പെടുന്നില്ല,","poem":1},{"text":"കാരണം എന്റെ ക്രോധം ആ സമൂഹം മുഴുവന്റെയുംമേൽ ഇരിക്കുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"പട്ടണത്തിനുപുറത്ത് വാൾ;","poem":1},{"text":"അകത്ത് പകർച്ചവ്യാധിയും ക്ഷാമവും.","poem":2},{"text":"വയലിൽ ഇരിക്കുന്നവർ","poem":1},{"text":"വാളാൽ മരിക്കും.","poem":2},{"text":"ക്ഷാമവും പകർച്ചവ്യാധിയും","poem":1},{"text":"നഗരത്തിലുള്ളവരെ നശിപ്പിച്ചുകളയും.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അവരിൽ പലായിതർ രക്ഷപ്പെട്ടാൽത്തന്നെയും","poem":1},{"text":"പർവതങ്ങളിലേക്ക് ഓടിപ്പോകും.","poem":2},{"text":"താഴ്വരകളിലെ പ്രാവുകളെപ്പോലെ","poem":1},{"text":"അവർ എല്ലാവരും വിലപിക്കും,","poem":2},{"lineBreak":true},{"text":"ഓരോരുത്തരുടെയും പാപങ്ങൾമൂലംതന്നെ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"എല്ലാ കൈകളും തളരും;","poem":1},{"text":"എല്ലാ കാലുകളും മൂത്രത്താൽ നനയും.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അവർ ചാക്കുശീല ധരിക്കും,","poem":1},{"text":"നടുക്കം അവരെ കീഴടക്കും.","poem":2},{"text":"എല്ലാ മുഖങ്ങളിലും ലജ്ജ ഉണ്ടായിരിക്കും,","poem":1},{"text":"എല്ലാ തലയും ക്ഷൗരം ചെയ്യപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“ ‘അവർ തങ്ങളുടെ വെള്ളി തെരുവിൽ എറിഞ്ഞുകളയും,","poem":1},{"text":"അവരുടെ സ്വർണം മലിനമായ വസ്തുപോലെ പരിഗണിക്കപ്പെടും.","poem":2},{"text":"യഹോവയുടെ ക്രോധദിവസത്തിൽ","poem":1},{"text":"അവരുടെ വെള്ളിക്കോ സ്വർണത്തിനോ","poem":2},{"lineBreak":true},{"text":"അവരെ മോചിപ്പിക്കാൻ കഴിയുകയില്ല.","poem":2},{"text":"വിശപ്പടക്കുന്നതിനോ വയറുനിറയ്ക്കുന്നതിനോ","poem":1},{"text":"അവർക്കത് ഉപകരിക്കുകയില്ല.","poem":2},{"lineBreak":true},{"text":"അത് അവരെ പാപത്തിലേക്കു വീഴാൻ കാരണമാക്കിയല്ലോ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"തങ്ങളുടെ മനോഹരങ്ങളായ ആഭരണങ്ങളിൽ അവർ അഹങ്കരിച്ചു.","poem":1},{"text":"മ്ലേച്ഛവും നിന്ദ്യവുമായ വിഗ്രഹങ്ങൾ നിർമിക്കുന്നതിനായി അവർ അത് ഉപയോഗിച്ചു.","poem":2},{"text":"അതിനാൽ അതു ഞാൻ അവർക്ക്","poem":1},{"text":"ഒരു ഹീനവസ്തുവാക്കിത്തീർക്കും.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അതു ഞാൻ വിദേശികളുടെ കൈയിൽ കൊള്ളയായും","poem":1},{"text":"ഭൂമിയിലെ ദുഷ്ടർക്കു കവർച്ചയായും കൊടുക്കും,","poem":2},{"lineBreak":true},{"text":"അവർ അതിനെ അശുദ്ധമാക്കും.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ആ ജനത്തിൽനിന്നു ഞാൻ മുഖം തിരിച്ചുകളയും,","poem":1},{"text":"എനിക്കു വിലപ്പെട്ട സ്ഥലത്തെ കൊള്ളക്കാർ അശുദ്ധമാക്കും.","poem":2},{"text":"അവർ അതിൽ പ്രവേശിക്കുകയും","poem":1},{"text":"അതിനെ മലിനമാക്കുകയും ചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“ ‘ദേശം രക്തപാതകംകൊണ്ടും","poem":1},{"text":"പട്ടണം അക്രമംകൊണ്ടും നിറഞ്ഞിരിക്കുകയാൽ","poem":2},{"lineBreak":true},{"text":"നീ ഒരു ചങ്ങല ഉണ്ടാക്കുക!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അവരുടെ വീടുകൾ കൈവശമാക്കുന്നതിന്","poem":1},{"text":"ഞാൻ ജനതകളിൽ അതിദുഷ്ടന്മാരായവരെ വരുത്തും.","poem":2},{"text":"ബലിഷ്ഠരുടെ അഹങ്കാരം ഞാൻ അവസാനിപ്പിക്കും,","poem":1},{"text":"അവരുടെ വിശുദ്ധസ്ഥലങ്ങൾ മലിനമായിത്തീരും.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ഉൾഭയം വരുമ്പോൾ അവർ സമാധാനം അന്വേഷിക്കും;","poem":1},{"text":"എന്നാൽ അവർ അതു കണ്ടെത്തുകയില്ല.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"നാശത്തിനുമീതേ നാശവും","poem":1},{"text":"കിംവദന്തിക്കുമീതേ കിംവദന്തിയും ഉണ്ടാകും.","poem":2},{"text":"അവർ പ്രവാചകനിൽനിന്ന് ഒരു ദർശനം അന്വേഷിക്കും","poem":1},{"text":"ന്യായപ്രമാണത്തിൽനിന്നും പുരോഹിതൻ നൽകുന്ന ഉപദേശം നിലയ്ക്കും,","poem":2},{"lineBreak":true},{"text":"ഗോത്രത്തലവന്മാരുടെ ആലോചനയും അവസാനിക്കും.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"രാജാവു വിലപിക്കും,","poem":1},{"text":"പ്രഭു നൈരാശ്യത്താൽ മൂടപ്പെടും,","poem":2},{"lineBreak":true},{"text":"ദേശത്തിലെ ജനങ്ങളുടെ കൈകൾ വിറയ്ക്കും.","poem":2},{"text":"അവരുടെ പെരുമാറ്റത്തിന് അനുസൃതമായി ഞാൻ അവരോട് ഇടപെടും,","poem":1},{"text":"അവരുടെ മാനദണ്ഡങ്ങൾക്ക് അനുസൃതമായി ഞാൻ അവരെ ന്യായംവിധിക്കും.","poem":2},"അപ്പോൾ, ഞാൻ യഹോവ ആകുന്നു എന്ന് അവർ അറിയും.’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/EZK/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/EZK/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/EZK/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}