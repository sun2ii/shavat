{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"HAB","translationId":"mal_bib","name":"ഹബക്കൂക്ക്","commonName":"ഹബക്കൂക്ക്","title":"ഹബക്കൂക്കിന്റെ പ്രവചനം","order":35,"numberOfChapters":3,"sha256":"8d0a7b341135de0303ad922403707dbc2410a789555a9b3aea1e68637e5e7112","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mal_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["പ്രവാചകനായ ഹബക്കൂക്കിനു ലഭിച്ച അരുളപ്പാട്."]},{"type":"line_break"},{"type":"heading","content":["ഹബക്കൂക്കിന്റെ പരാതി"]},{"type":"verse","number":2,"content":[{"text":"യഹോവേ, ഞാൻ ഇനി എത്രകാലം സഹായത്തിനുവേണ്ടി നിലവിളിക്കണം,","poem":1},{"text":"അങ്ങു ശ്രദ്ധിക്കാത്തതെന്തേ?","poem":2},{"text":"അക്രമംനിമിത്തം ഞാൻ നിലവിളിക്കുന്നു;","poem":1},{"text":"അവിടന്നു രക്ഷിക്കുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ഞാൻ അനീതി സഹിക്കാൻ അങ്ങ് അനുവദിക്കുന്നതെന്തേ?","poem":1},{"text":"അവിടന്ന് അന്യായത്തെ സഹിക്കുന്നതെന്ത്?","poem":2},{"text":"നാശവും അക്രമവും എന്റെ മുമ്പിലുണ്ട്;","poem":1},{"text":"അവിടെ കലഹമുണ്ട്, ഭിന്നത വർധിക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ന്യായപ്രമാണം നിശ്ചലമായിരിക്കുന്നു,","poem":1},{"text":"നീതി നിർവഹിക്കപ്പെടുന്നതുമില്ല.","poem":2},{"text":"ദുഷ്ടർ നീതിയെ നിയന്ത്രിക്കുന്നു,","poem":1},{"text":"അതിനാൽ നീതി വഴിവിട്ടുപോകുന്നു.","poem":2}]},{"type":"heading","content":["യഹോവയുടെ മറുപടി"]},{"type":"verse","number":5,"content":[{"text":"“രാജ്യങ്ങളെ ശ്രദ്ധിച്ചുനോക്കുക,","poem":1},{"text":"ആശ്ചര്യപ്പെടുവിൻ.","poem":2},{"text":"നിങ്ങളുടെ കാലത്തു ഞാൻ ഒരു കാര്യം ചെയ്യാൻപോകുന്നു,","poem":1},{"text":"നിങ്ങളോടു പറഞ്ഞാൽപോലും","poem":2},{"lineBreak":true},{"text":"നിങ്ങൾ വിശ്വസിക്കാൻ കഴിയാത്ത ഒരു കാര്യംതന്നെ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഉഗ്രന്മാരും സാഹസികരുമായ","poem":1},{"text":"ബാബേൽജനതയെ","poem":2},{"noteId":0},{"text":"ഞാൻ എഴുന്നേൽപ്പിക്കും.","poem":2},{"text":"സ്വന്തമല്ലാത്ത അധിവാസസ്ഥാനങ്ങൾ പിടിച്ചെടുക്കാൻ","poem":1},{"text":"അവർ ഭൂമിയിലെങ്ങും വ്യാപിക്കുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവർ ഭയങ്കരന്മാരും ഉഗ്രന്മാരും ആകുന്നു;","poem":1},{"text":"സ്വന്തം ഇഷ്ടമാണ് അവർക്കു നിയമം","poem":2},{"lineBreak":true},{"text":"അവർ സ്വന്തം മാനംമാത്രം പ്രോത്സാഹിപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവരുടെ കുതിരകൾ പുള്ളിപ്പുലികളെക്കാൾ വേഗമുള്ളവ,","poem":1},{"text":"സന്ധ്യക്കിറങ്ങുന്ന ചെന്നായ്ക്കളെക്കാൾ ക്രൂരതയുള്ളവ.","poem":2},{"text":"അവരുടെ കുതിരപ്പട ഗർവത്തോടെ പോകുന്നു;","poem":1},{"text":"അവരുടെ കുതിരച്ചേവകർ വിദൂരത്തുനിന്നു വരുന്നു.","poem":2},{"text":"ഇരതേടുന്ന കഴുകനെപ്പോലെ അവർ പറക്കുന്നു,","poem":1}]},{"type":"verse","number":9,"content":[{"text":"സംഹരിക്കുന്നതിനായി അവർ കൂടിവരുന്നു.","poem":2},{"text":"അവരുടെ പടയണികൾ മരുഭൂമിയിലെ കാറ്റുപോലെ മുന്നോട്ടുപോകുന്നു,","poem":1},{"text":"മണൽപോലെ ബന്ധിതരെ ശേഖരിക്കുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവർ രാജാക്കന്മാരെ പരിഹസിക്കുന്നു.","poem":1},{"text":"അധികാരികളെ പുച്ഛിക്കുന്നു.","poem":2},{"text":"കോട്ടയുള്ള നഗരങ്ങൾ നോക്കി അവർ ചിരിക്കുന്നു.","poem":1},{"text":"അവർ കോട്ടകളിൽ മൺപടികളുണ്ടാക്കി അവയെ പിടിച്ചടക്കുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അവർ കാറ്റുപോലെ വീശി, കടന്നുപോകുന്നു—","poem":1},{"text":"അവർ കുറ്റക്കാർ, സ്വന്തശക്തിയാണ് അവരുടെ ദൈവം.”","poem":2}]},{"type":"heading","content":["ഹബക്കൂക്കിന്റെ രണ്ടാമത്തെ പരാതി"]},{"type":"verse","number":12,"content":[{"text":"യഹോവേ, അങ്ങ് ആദിമുതലുള്ളവനല്ലയോ?","poem":1},{"text":"എന്റെ ദൈവമേ, എന്റെ പരിശുദ്ധനേ, അങ്ങ് അമർത്യതയുള്ളവനല്ലോ.","poem":2},{"text":"യഹോവേ, വിധി നടപ്പാക്കേണ്ടതിന് അങ്ങ് അവരെ നിയമിച്ചിരിക്കുന്നു;","poem":1},{"text":"എന്റെ പാറയായുള്ളവനേ, ശിക്ഷ നടത്തേണ്ടതിന് അവിടന്ന് അവരെ നിയോഗിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ദോഷം കണ്ടുകൂടാത്തവണ്ണം പരിശുദ്ധമായ കണ്ണുകൾ ഉള്ളവനാണല്ലോ അങ്ങ്;","poem":1},{"text":"തെറ്റിനെ സഹിക്കുന്നവനുമല്ലല്ലോ.","poem":2},{"text":"അങ്ങനെയെങ്കിൽ അങ്ങ് ദ്രോഹികളെ സഹിക്കുന്നതെന്ത്?","poem":1},{"text":"തങ്ങളെക്കാൾ നീതിമാന്മാരെ ദുഷ്ടർ വിഴുങ്ങിക്കളയുമ്പോൾ","poem":2},{"lineBreak":true},{"text":"അവിടന്നു നിശ്ശബ്ദനായിരിക്കുന്നതെന്ത്?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"സമുദ്രത്തിലെ മത്സ്യംപോലെയും","poem":1},{"text":"അധിപതിയില്ലാത്ത കടൽജീവികളെപ്പോലെയും അങ്ങു മനുഷ്യരെ സൃഷ്ടിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ദുഷ്ടശത്രു അവയെല്ലാം ചൂണ്ടലിട്ടു പിടിക്കുന്നു,","poem":1},{"text":"അവൻ തന്റെ വലയിൽ അവയെ പിടിക്കുന്നു;","poem":2},{"text":"തന്റെ കോരുവലയിൽ അവയെ ശേഖരിക്കുന്നു,","poem":1},{"text":"അങ്ങനെ അവൻ അവയിൽ ആഹ്ലാദിച്ച് ആനന്ദിക്കുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അതുകൊണ്ട് അവൻ തന്റെ വലയ്ക്കും ബലിയർപ്പിക്കുന്നു","poem":1},{"text":"കോരുവലയ്ക്കു ധൂപംകാട്ടുന്നു.","poem":2},{"text":"തന്റെ വല മുഖാന്തരം അവൻ ആഡംബരത്തിൽ ജീവിക്കുകയും","poem":1},{"text":"ഏറ്റവും രുചികരമായ ഭക്ഷണം ആസ്വദിക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവൻ എപ്പോഴും തന്റെ വല കുടയുകയും","poem":1},{"text":"കരുണയില്ലാതെ രാജ്യങ്ങളെ നശിപ്പിക്കയും ചെയ്യുമോ?","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":0,"caller":"+","text":"അഥവാ, കൽദയ","reference":{"chapter":1,"verse":6}}]},"thisChapterLink":"/api/mal_bib/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/NAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}