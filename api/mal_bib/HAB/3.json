{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"HAB","translationId":"mal_bib","name":"ഹബക്കൂക്ക്","commonName":"ഹബക്കൂക്ക്","title":"ഹബക്കൂക്കിന്റെ പ്രവചനം","order":35,"numberOfChapters":3,"sha256":"8d0a7b341135de0303ad922403707dbc2410a789555a9b3aea1e68637e5e7112","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mal_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["ഹബക്കൂക്കിന്റെ പ്രാർഥന"]},{"type":"verse","number":1,"content":[{"text":"വിഭ്രമരാഗത്തിൽ, ഹബക്കൂക്ക് പ്രവാചകന്റെ ഒരു പ്രാർഥനാഗീതം.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"യഹോവേ, ഞാൻ അങ്ങയുടെ കീർത്തിയെക്കുറിച്ചു കേട്ടിരിക്കുന്നു;","poem":1},{"text":"അങ്ങയുടെ പ്രവൃത്തികൾ കണ്ടിട്ട് ഞാൻ ആദരപൂർണനായി നിൽക്കുന്നു.","poem":2},{"text":"യഹോവേ, ഞങ്ങളുടെ നാളിൽ അവ ആവർത്തിക്കണമേ,","poem":1},{"text":"ഞങ്ങളുടെകാലത്ത് അവ പ്രസിദ്ധമാക്കണമേ;","poem":2},{"lineBreak":true},{"text":"കോപത്തിലും കരുണ ഓർക്കണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ദൈവം തേമാനിൽനിന്ന് വന്നു,","poem":1},{"text":"പരിശുദ്ധനായവൻ പാരാൻപർവതത്തിൽനിന്ന് വന്നു. സേലാ.","poem":2},{"text":"അവിടത്തെ തേജസ്സ് ആകാശത്തെ മൂടിയിരുന്നു,","poem":1},{"text":"അവിടത്തെ സ്തുതി ഭൂമിയെ നിറച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവിടത്തെ മഹിമ സൂര്യോദയംപോലെ ആയിരുന്നു;","poem":1},{"text":"തന്റെ ശക്തി മറച്ചിരുന്ന","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ കരങ്ങളിൽനിന്ന് പ്രഭാകിരണങ്ങൾ മിന്നി.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"മഹാമാരി അവിടത്തെ മുമ്പിൽ നടക്കുന്നു;","poem":1},{"text":"പകർച്ചവ്യാധി അവിടത്തെ ചവിട്ടടികളെ പിൻതുടരുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"യഹോവ എഴുന്നേറ്റു, ഭൂമിയെ കുലുക്കി.","poem":1},{"text":"അവിടന്നു നോക്കി രാജ്യങ്ങളെ വിറപ്പിച്ചു.","poem":2},{"text":"പുരാതനപർവതങ്ങൾ തകർന്നുവീണു","poem":1},{"text":"പഴയ കുന്നുകൾ നിലംപൊത്തി—","poem":2},{"lineBreak":true},{"text":"എന്നാൽ അവിടത്തെ വഴികൾ ശാശ്വതമായവ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"കൂശാന്റെ കൂടാരങ്ങൾ അസ്വസ്ഥമായിരിക്കുന്നതു ഞാൻ കണ്ടു,","poem":1},{"text":"മിദ്യാന്റെ പാർപ്പിടങ്ങൾ വിഷമിക്കയും ചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"യഹോവേ, അങ്ങു നദികളോടു കോപിച്ചിരിക്കുന്നോ?","poem":1},{"text":"അവിടത്തെ കോപം അരുവികൾക്കുനേരേയോ?","poem":2},{"text":"കുതിരകളെയും രഥങ്ങളെയും","poem":1},{"text":"വിജയത്തിലേക്കു നയിച്ചപ്പോൾ","poem":2},{"lineBreak":true},{"text":"അങ്ങു സമുദ്രത്തോടു കോപിച്ചുവോ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അങ്ങു വില്ല് അനാവരണംചെയ്തു;","poem":1},{"text":"അങ്ങു നിരവധി അമ്പുകൾ ആവശ്യപ്പെടുന്നു.","poem":2},{"text":"അങ്ങ് നദികളാൽ ഭൂമിയെ വിഭജിക്കുന്നു.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"പർവതങ്ങൾ അങ്ങയെക്കണ്ടു വിറകൊള്ളുന്നു.","poem":2},{"text":"ജലപ്രവാഹങ്ങൾ കടന്നുപോയി;","poem":1},{"text":"ആഴി ഗർജിച്ചു","poem":2},{"lineBreak":true},{"text":"അതിന്റെ തിരമാല ഉയർന്നുപൊങ്ങി.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"അങ്ങയുടെ മിന്നിപ്പറക്കുന്ന അസ്ത്രങ്ങളിലും","poem":1},{"text":"തിളങ്ങുന്ന കുന്തത്തിന്റെ മിന്നലിലും","poem":2},{"lineBreak":true},{"text":"സൂര്യനും ചന്ദ്രനും ആകാശത്തിൽ നിശ്ചലമായി നിന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ക്രോധത്തിൽ അങ്ങ് ഭൂമിയിലൂടെ നടന്നു;","poem":1},{"text":"കോപത്തിൽ രാജ്യങ്ങളെ മെതിച്ചുകളഞ്ഞു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"സ്വജനത്തെ വിടുവിക്കാനും","poem":1},{"text":"തന്റെ അഭിഷിക്തനെ രക്ഷിക്കാനും അങ്ങ് ഇറങ്ങിവന്നു.","poem":2},{"text":"ദുഷ്ടദേശത്തിന്റെ നായകനെ അങ്ങു തകർത്തുകളഞ്ഞു,","poem":1},{"text":"നെറുകമുതൽ പാദംവരെ അവനെ വിവസ്ത്രനാക്കി.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ഞങ്ങളെ ചിതറിക്കാൻ അവന്റെ ശൂരന്മാർ പാഞ്ഞടുത്തപ്പോൾ,","poem":1},{"text":"ഒളിച്ചിരിക്കുന്ന അരിഷ്ടന്മാരെ വിഴുങ്ങാൻ ശ്രമിക്കുന്നതുപോലെ","poem":2},{"text":"അവർ ആനന്ദിച്ചപ്പോൾ,","poem":1},{"text":"അവന്റെ കുന്തംകൊണ്ടുതന്നെ അങ്ങ് അവന്റെ തല തുളച്ചു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അങ്ങു കുതിരകളെക്കൊണ്ടു സമുദ്രത്തെ മെതിക്കുകയും","poem":1},{"text":"പെരുവെള്ളത്തെ മഥിക്കുകയും ചെയ്തു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ഞാൻ അതുകേട്ടു, എന്റെ ഹൃദയം ത്രസിച്ചു;","poem":1},{"text":"ആ ശബ്ദത്തിൽ എന്റെ അധരങ്ങൾ വിറച്ചു;","poem":2},{"text":"എന്റെ അസ്ഥികൾ ഉരുകി,","poem":1},{"text":"എന്റെ കാലുകൾ വിറച്ചുപോയി.","poem":2},{"text":"എങ്കിലും ഞങ്ങളെ ആക്രമിക്കുന്ന രാജ്യത്തിന്മേൽ","poem":1},{"text":"അത്യാഹിതം വരുന്ന ദിവസത്തിനായി ഞാൻ കാത്തിരിക്കും.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അത്തിവൃക്ഷം തളിർക്കുകയില്ല,","poem":1},{"text":"മുന്തിരിവള്ളിയിൽ ഫലമുണ്ടാകുകയില്ല,","poem":2},{"text":"ഒലിവുമരം ഫലം കായ്ക്കുകയില്ല,","poem":1},{"text":"നിലങ്ങൾ ധാന്യം നൽകുകയുമില്ല,","poem":2},{"text":"തൊഴുത്തിൽ ആടുകൾ ഉണ്ടാകുകയില്ല,","poem":1},{"text":"ഗോശാലയിൽ കന്നുകാലികൾ ഇല്ലാതിരിക്കും,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ഇങ്ങനെയൊക്കെ ആണെങ്കിലും ഞാൻ യഹോവയിൽ ആനന്ദിക്കും,","poem":1},{"text":"എന്റെ രക്ഷകനായ ദൈവത്തിൽ ഞാൻ ആഹ്ലാദിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"കർത്താവായ യഹോവ എന്റെ ബലമാകുന്നു;","poem":1},{"text":"അവിടന്ന് എന്റെ പാദങ്ങളെ മാനിന്റെ കാലുകളെപ്പോലെയാക്കുന്നു,","poem":2},{"lineBreak":true},{"text":"അവിടന്ന് എന്നെ ഉന്നതികളിൽ നടക്കുമാറാക്കുന്നു.","poem":2},{"text":"സംഗീതസംവിധായകന്. തന്ത്രിനാദത്തോടെ.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}