{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"HOS","translationId":"mal_bib","name":"ഹോശേയ","commonName":"ഹോശേയ","title":"ഹോശേയയുടെ പ്രവചനം","order":28,"numberOfChapters":14,"sha256":"543165cbd05e83f330e0ac96f0ffd55bafa3ff9f1c3bcc2cf5c58822e6844da7","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mal_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["ഇസ്രായേലിനോടുള്ള ദൈവത്തിന്റെ സ്നേഹം"]},{"type":"verse","number":1,"content":[{"text":"“ഇസ്രായേൽ ബാലനായിരുന്നപ്പോൾ ഞാൻ അവനെ സ്നേഹിച്ചു,","poem":1},{"text":"ഈജിപ്റ്റിൽനിന്ന് ഞാൻ എന്റെ പുത്രനെ വിളിച്ചുവരുത്തി.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"എന്നാൽ, ഞാൻ ഇസ്രായേലിനെ വിളിക്കുന്തോറും","poem":1},{"text":"അവർ എന്നെ വിട്ടകന്നുപോയി.","poem":2},{"text":"അവർ ബാലിനു ബലിയർപ്പിച്ചു","poem":1},{"text":"വിഗ്രഹങ്ങൾക്കു ധൂപംകാട്ടി.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"എഫ്രയീമിനെ നടക്കാൻ ശീലിപ്പിച്ചത് ഞാനാണ്,","poem":1},{"text":"ഞാൻ അവരെ ഭുജങ്ങളിൽ എടുത്തു;","poem":2},{"text":"എങ്കിലും, അവരെ സൗഖ്യമാക്കിയത് ഞാൻ ആണെന്ന്","poem":1},{"text":"അവർ മനസ്സിലാക്കിയില്ല.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ഞാൻ മനുഷ്യകരുണയുടെ ചരടുകൾകൊണ്ടും","poem":1},{"text":"സ്നേഹത്തിന്റെ ബന്ധനങ്ങൾകൊണ്ടും അവരെ നടത്തി;","poem":2},{"text":"ഞാൻ അവരുടെ കഴുത്തിൽനിന്ന് നുകം നീക്കി,","poem":1},{"text":"ഒരു ശിശുവിനെ തലോടാനായി ഉയർത്തുന്ന ഒരുവനെപ്പോലെ ആയിരുന്നു ഞാൻ അവർക്ക്,","poem":2},{"lineBreak":true},{"text":"അവരെ തീറ്റുന്നതിനായി ഞാൻ കുനിഞ്ഞു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“അവർ ഈജിപ്റ്റിലേക്കു മടങ്ങുകയില്ലേ","poem":1},{"text":"അവർ എങ്കലേക്കു മടങ്ങിവരാൻ വിസമ്മതിച്ചതിനാൽ","poem":2},{"lineBreak":true},{"text":"അശ്ശൂർ അവരുടെമേൽ ഭരണംനടത്തുകയില്ലേ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവരുടെ പട്ടണങ്ങളിൽ വാൾ മിന്നും;","poem":1},{"text":"അത് അവരുടെ വ്യാജപ്രവാചകരെ വിഴുങ്ങിക്കളയുകയും","poem":2},{"lineBreak":true},{"text":"അവരുടെ പദ്ധതികൾ അവസാനിപ്പിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"എന്റെ ജനം എന്നെ വിട്ടുപോകാൻ ഉറച്ചിരിക്കുന്നു.","poem":1},{"text":"അവർ പരമോന്നതനെ വിളിച്ചപേക്ഷിച്ചാലും","poem":2},{"lineBreak":true},{"text":"അവിടന്ന് അവരെ ഉദ്ധരിക്കുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“എഫ്രയീമേ, നിന്നെ ഉപേക്ഷിക്കാൻ എനിക്കെങ്ങനെ കഴിയും?","poem":1},{"text":"ഇസ്രായേലേ, നിന്നെ ഏൽപ്പിച്ചുകൊടുക്കാൻ എനിക്കെങ്ങനെ കഴിയും?","poem":2},{"text":"ആദ്മയോടു ചെയ്തതുപോലെ നിന്നോടു ചെയ്യാൻ എനിക്കു കഴിയുമോ?","poem":1},{"text":"സെബോയിമിനെപ്പോലെ നിന്നെ ആക്കാൻ എനിക്കു കഴിയുമോ?","poem":2},{"text":"എന്റെ ഹൃദയം എന്റെ ഉള്ളിൽ മറിയുന്നു;","poem":1},{"text":"എന്നിൽ ആർദ്രത കത്തിജ്വലിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഞാൻ എന്റെ ഭയങ്കരകോപം നടപ്പിലാക്കുകയില്ല,","poem":1},{"text":"ഞാൻ എഫ്രയീമിനെ ഒരിക്കൽക്കൂടി പൂർണമായി നശിപ്പിക്കയുമില്ല.","poem":2},{"text":"കാരണം ഞാൻ ദൈവമാണ്, മനുഷ്യനല്ല;","poem":1},{"text":"നിങ്ങളുടെ മധ്യേയുള്ള പരിശുദ്ധൻതന്നെ.","poem":2},{"lineBreak":true},{"text":"ഞാൻ ക്രോധത്തോടെ വരികയുമില്ല.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവർ യഹോവയെ അനുഗമിക്കും.","poem":1},{"text":"അവിടന്ന് സിംഹംപോലെ ഗർജിക്കും;","poem":2},{"text":"അവിടന്ന് ഗർജിക്കുമ്പോൾ","poem":1},{"text":"അവിടത്തെ മക്കൾ പടിഞ്ഞാറുനിന്നു വിറച്ചുകൊണ്ടുവരും.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അവർ പക്ഷികളെപ്പോലെ ഈജിപ്റ്റിൽനിന്നും","poem":1},{"text":"പ്രാവുകളെപ്പോലെ അശ്ശൂരിൽനിന്നും","poem":2},{"lineBreak":true},{"text":"വിറച്ചുകൊണ്ടുവരും.","poem":2},{"text":"ഞാൻ അവരെ തങ്ങളുടെ വീടുകളിൽ പാർപ്പിക്കും,”","poem":1},{"text":"എന്ന് യഹോവ അരുളിച്ചെയ്യുന്നു.","poem":2}]},{"type":"heading","content":["ഇസ്രായേലിന്റെ പാപം"]},{"type":"verse","number":12,"content":[{"text":"എഫ്രയീം വ്യാജങ്ങളാലും","poem":1},{"text":"ഇസ്രായേൽഗൃഹം വഞ്ചനയാലും എന്നെ ചുറ്റിയിരിക്കുന്നു.","poem":2},{"text":"യെഹൂദയും ദൈവത്തോട് അനുസരണ കാണിക്കുന്നില്ല;","poem":1},{"text":"വിശ്വസ്തനും പരിശുദ്ധനുമായവനുനേരേ മത്സരിച്ചിരിക്കുന്നു.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}