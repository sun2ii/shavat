{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"HOS","translationId":"mal_bib","name":"ഹോശേയ","commonName":"ഹോശേയ","title":"ഹോശേയയുടെ പ്രവചനം","order":28,"numberOfChapters":14,"sha256":"543165cbd05e83f330e0ac96f0ffd55bafa3ff9f1c3bcc2cf5c58822e6844da7","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mal_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["ഇസ്രായേലിനെതിരേ കുറ്റാരോപണം"]},{"type":"verse","number":1,"content":[{"text":"ഇസ്രായേൽജനമേ, യഹോവയുടെ വചനം കേൾപ്പിൻ;","poem":1},{"text":"ഈ ദേശത്തു വസിക്കുന്ന നിങ്ങൾക്കുനേരേ","poem":2},{"lineBreak":true},{"text":"യഹോവയ്ക്ക് ഒരു വ്യവഹാരം ഉണ്ട്:","poem":2},{"text":"“ഈ ദേശത്തു വിശ്വസ്തതയോ സ്നേഹമോ","poem":1},{"text":"ദൈവപരിജ്ഞാനമോ ഇല്ല;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ശാപവും വ്യാജവും കൊലപാതകവും","poem":1},{"text":"മോഷണവും വ്യഭിചാരവുംമാത്രമേയുള്ളൂ.","poem":2},{"text":"അവർ സകല അതിർവരമ്പുകളും ലംഘിച്ചിരിക്കുന്നു;","poem":1},{"text":"രക്തച്ചൊരിച്ചിലിനു പിന്നാലെ രക്തച്ചൊരിച്ചിൽതന്നെ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ഇതുനിമിത്തം ദേശം വിലപിക്കുന്നു.","poem":1},{"text":"അതിലെ നിവാസികളെല്ലാവരും","poem":2},{"text":"വയലിലെ മൃഗങ്ങളും ആകാശത്തിലെ പറവകളും മെലിഞ്ഞുണങ്ങിയിരിക്കുന്നു;","poem":1},{"text":"സമുദ്രത്തിലെ മത്സ്യം നശിച്ചുപോകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“എന്നാൽ, ആരും കുറ്റാരോപണം നടത്തുകയോ","poem":1},{"text":"പരസ്പരം പഴിചാരുകയോ അരുത്.","poem":2},{"text":"നിങ്ങൾ പുരോഹിതനുനേരേ ആരോപണം","poem":1},{"text":"ഉന്നയിക്കുന്നവരെപ്പോലെ ആകുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"നിങ്ങൾ പകൽസമയത്ത് ഇടറിവീഴും.","poem":1},{"text":"പ്രവാചകന്മാർ നിങ്ങളോടൊപ്പം രാത്രികാലത്ത് ഇടറിവീഴും.","poem":2},{"text":"അതുകൊണ്ടു ഞാൻ നിങ്ങളുടെ അമ്മയെ നശിപ്പിക്കും—","poem":1}]},{"type":"verse","number":6,"content":[{"text":"പരിജ്ഞാനമില്ലായ്കയാൽ എന്റെ ജനം നശിക്കുന്നു.","poem":2},{"lineBreak":true},{"text":"“നീ പരിജ്ഞാനം ത്യജിച്ചതിനാൽ","poem":1},{"text":"എന്റെ പുരോഹിതസ്ഥാനത്തുനിന്നു ഞാൻ നിന്നെയും ത്യജിച്ചുകളയും;","poem":2},{"text":"നിങ്ങൾ ദൈവത്തിന്റെ ന്യായപ്രമാണം അവഗണിച്ചിരിക്കുകയാൽ,","poem":1},{"text":"ഞാനും നിങ്ങളുടെ മക്കളെ അവഗണിക്കും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"പുരോഹിതന്മാർ വർധിക്കുന്തോറും,","poem":1},{"text":"അവർ എന്നോട് അധികം പാപംചെയ്തു;","poem":2},{"lineBreak":true},{"text":"അതുകൊണ്ട് ഞാൻ അവരുടെ മഹത്ത്വത്തെ ലജ്ജയാക്കിമാറ്റും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവർ എന്റെ ജനത്തിന്റെ പാപംകൊണ്ട് ഉപജീവിക്കുകയും","poem":1},{"text":"അവരുടെ ദുഷ്ടത ആസ്വദിക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ജനം എങ്ങനെയോ, അങ്ങനെതന്നെ പുരോഹിതന്മാരും ആയിരിക്കും.","poem":1},{"text":"ഞാൻ അവരുടെ പാപവഴികൾനിമിത്തം അവരിരുവരെയും ശിക്ഷിക്കും","poem":2},{"lineBreak":true},{"text":"അവരുടെ പ്രവൃത്തികൾക്കു തക്ക പകരംനൽകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“അവർ ഭക്ഷിക്കും, പക്ഷേ, മതിവരികയില്ല;","poem":1},{"text":"അവർ വ്യഭിചരിക്കും, പക്ഷേ, യാതൊന്നും നേടുകയില്ല,","poem":2},{"text":"കാരണം അവർ യഹോവയെ ഉപേക്ഷിച്ചുകളഞ്ഞല്ലോ;","poem":1}]},{"type":"verse","number":11,"content":[{"text":"ബുദ്ധിയെ കെടുത്തുന്ന വ്യഭിചാരത്തിനും","poem":2},{"text":"പഴയ വീഞ്ഞിനും പുതിയ വീഞ്ഞിനും","poem":1},{"text":"അവർ സ്വയം ഏൽപ്പിച്ചുകൊടുത്തു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"എന്റെ ജനം ഒരു മരപ്രതിമയോടു ചോദിക്കുന്നു,","poem":1},{"text":"ദേവപ്രശ്നംവെക്കുന്നവരുടെ ദണ്ഡിൽനിന്ന് അവർക്കു മറുപടി ലഭിക്കുന്നു.","poem":2},{"text":"വ്യഭിചാരത്തിന്റെ ആത്മാവ് അവരെ വഴിതെറ്റിക്കുന്നു;","poem":1},{"text":"അവർ തങ്ങളുടെ ദൈവത്തോട് അവിശ്വസ്തരായിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അവർ പർവതശിഖരങ്ങളിൽ ബലികഴിക്കുന്നു,","poem":1},{"text":"കുന്നുകളിൽ നല്ല തണൽ നൽകുന്ന","poem":2},{"text":"കരുവേലകത്തിന്റെയും പുന്നയുടെയും ആലിന്റെയും കീഴിൽ","poem":1},{"text":"അവർ ധൂപംകാട്ടുന്നു.","poem":2},{"text":"തന്നിമിത്തം നിങ്ങളുടെ പുത്രിമാർ വ്യഭിചാരത്തിലേക്കും","poem":1},{"text":"പുത്രഭാര്യമാർ പരപുരുഷസംഗത്തിലേക്കും തിരിയുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“വ്യഭിചാരത്തിലേക്കു തിരിയുന്ന","poem":1},{"text":"നിങ്ങളുടെ പുത്രിമാരെയും","poem":2},{"text":"പരപുരുഷസംഗത്തിലേക്കു തിരിയുന്ന","poem":1},{"text":"നിങ്ങളുടെ പുത്രഭാര്യമാരെയും ഞാൻ ശിക്ഷിക്കുകയില്ല.","poem":2},{"text":"കാരണം നിങ്ങളുടെ പുരുഷന്മാർതന്നെ വേശ്യാസ്ത്രീകളോടുകൂടെ പാർക്കുകയും","poem":1},{"text":"ക്ഷേത്രവേശ്യകളോടുകൂടെ ബലികഴിക്കുകയുംചെയ്യുന്നു.","poem":2},{"lineBreak":true},{"text":"ഇങ്ങനെ പരിജ്ഞാനമില്ലാത്ത ജനം നശിപ്പിക്കപ്പെടും!","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“ഇസ്രായേൽജനമേ, നിങ്ങൾ വ്യഭിചാരം ചെയ്യുന്നെങ്കിലും","poem":1},{"text":"യെഹൂദ അപ്രകാരമുള്ള കുറ്റം ചെയ്യാതിരിക്കട്ടെ.","poem":2},{"lineBreak":true},{"text":"“നിങ്ങൾ ഗിൽഗാലിലേക്കു പോകരുത്;","poem":1},{"text":"ബേത്-ആവെനിലേക്ക്","poem":2},{"noteId":12},{"text":"പോകരുത്.","poem":2},{"lineBreak":true},{"text":"‘ജീവനുള്ള യഹോവയാണെ,’ എന്ന് ഇനിമേൽ ശപഥംചെയ്യരുത്!”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ദുശ്ശാഠ്യമുള്ള പശുക്കിടാവിനെപ്പോലെ","poem":1},{"text":"ഇസ്രായേൽജനം ശാഠ്യമുള്ളവരാണ്.","poem":2},{"text":"അങ്ങനെയെങ്കിൽ പുൽമേടുകളിലെ കുഞ്ഞാടുകളെപ്പോലെ","poem":1},{"text":"അവരെ മേയിക്കാൻ യഹോവയ്ക്ക് എങ്ങനെ കഴിയും?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"എഫ്രയീം വിഗ്രഹങ്ങളോടു ചേർന്നിരിക്കുന്നു;","poem":1},{"text":"അവനെ വിട്ട് ഒഴിഞ്ഞിരിക്ക.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അവരുടെ മദ്യം തീർന്നാലും","poem":1},{"text":"അവർ തങ്ങളുടെ വ്യഭിചാരം തുടരുന്നു;","poem":2},{"lineBreak":true},{"text":"അവരുടെ ഭരണാധികാരികൾ ലജ്ജാകരമായ വഴികൾ ഇഷ്ടപ്പെടുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ഒരു ചുഴലിക്കാറ്റ് അവരെ പറപ്പിച്ചുകളയും,","poem":1},{"text":"അവരുടെ ബലികൾ അവർക്കുതന്നെ ലജ്ജയായിത്തീരും.","poem":2}]}],"footnotes":[{"noteId":12,"caller":"+","text":"ദുഷ്ടതയുടെ ഭവനം എന്നർഥം.","reference":{"chapter":4,"verse":15}}]},"thisChapterLink":"/api/mal_bib/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}