{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"HOS","translationId":"mal_bib","name":"ഹോശേയ","commonName":"ഹോശേയ","title":"ഹോശേയയുടെ പ്രവചനം","order":28,"numberOfChapters":14,"sha256":"543165cbd05e83f330e0ac96f0ffd55bafa3ff9f1c3bcc2cf5c58822e6844da7","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mal_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["ഇസ്രായേലിനെതിരേ ന്യായവിധി"]},{"type":"verse","number":1,"content":[{"text":"“പുരോഹിതന്മാരേ, ഇതു കേൾപ്പിൻ!","poem":1},{"text":"ഇസ്രായേൽജനമേ, ശ്രദ്ധിക്കുക!","poem":2},{"text":"രാജഗൃഹമേ, ചെവിചായ്‌ക്കുക!","poem":1},{"text":"ഈ ന്യായവിധി നിങ്ങൾക്കെതിരേ വരുന്നു:","poem":2},{"text":"നിങ്ങൾ മിസ്പായിൽ ഒരു കെണിയും","poem":1},{"text":"താബോറിൽ വിരിച്ച ഒരു വലയും ആയിരുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"മത്സരികൾ കൊലപാതകത്തിൽ ആണ്ടുപോയിരിക്കുന്നു.","poem":1},{"text":"ഞാൻ അവരെ എല്ലാവരെയും ശിക്ഷിക്കും.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"എഫ്രയീമിനെക്കുറിച്ചു സകലകാര്യങ്ങളും എനിക്കറിയാം;","poem":1},{"text":"ഇസ്രായേൽ എനിക്കു മറഞ്ഞിരിക്കുന്നതുമില്ല.","poem":2},{"text":"എഫ്രയീമേ, നീ വ്യഭിചാരത്തിലേക്കു തിരിഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"ഇസ്രായേൽ മലിനമായിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“തങ്ങളുടെ ദൈവത്തിലേക്കു മടങ്ങിവരാൻ","poem":1},{"text":"അവരുടെ പ്രവൃത്തികൾ അവരെ അനുവദിക്കുന്നില്ല.","poem":2},{"text":"വ്യഭിചാരത്തിന്റെ ആത്മാവ് അവരുടെ ഹൃദയങ്ങളിലുണ്ട്;","poem":1},{"text":"അവർ യഹോവയെ അംഗീകരിക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ഇസ്രായേലിന്റെ ധാർഷ്ട്യം അവർക്കെതിരേ സാക്ഷ്യം പറയുന്നു;","poem":1},{"text":"ഇസ്രായേലും എഫ്രയീമും അവരുടെ പാപങ്ങളിൽ ഇടറുന്നു;","poem":2},{"lineBreak":true},{"text":"യെഹൂദയും അവരോടുകൂടെ വീഴുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവർ തങ്ങളുടെ ആടുമാടുകളോടുകൂടെ","poem":1},{"text":"യഹോവയെ അന്വേഷിക്കുമ്പോൾ,","poem":2},{"text":"അവിടത്തെ കണ്ടെത്തുകയില്ല,","poem":1},{"text":"കാരണം യഹോവ അവരെ വിട്ടുമാറിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവർ യഹോവയോട് അവിശ്വസ്തരായിരിക്കുന്നു;","poem":1},{"text":"അവർ ജാരസന്തതികളെ പ്രസവിക്കുന്നു.","poem":2},{"text":"അവരുടെ അമാവാസി ഉത്സവങ്ങൾ","poem":1},{"text":"അവരെയും അവരുടെ വയലുകളെയും വിഴുങ്ങിക്കളയും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ഗിബെയയിൽ കാഹളം മുഴക്കുക;","poem":1},{"text":"രാമായിൽ കൊമ്പ് ഊതുക.","poem":2},{"text":"ബേത്-ആവെനിൽ യുദ്ധനാദം മുഴക്കുക;","poem":1},{"text":"ബെന്യാമീനേ, മുന്നോട്ടുപോകുക.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"കണക്കു തീർക്കുന്ന ദിവസം","poem":1},{"text":"എഫ്രയീം ശൂന്യമാകും.","poem":2},{"text":"ഇസ്രായേൽഗോത്രങ്ങൾക്കു നടുവിൽ","poem":1},{"text":"നിശ്ചയമുള്ളതു ഞാൻ പ്രഖ്യാപിക്കുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"യെഹൂദാപ്രഭുക്കന്മാർ","poem":1},{"text":"അതിർത്തിക്കല്ലു മാറ്റുന്നവരെപ്പോലെയാണ്.","poem":2},{"text":"ഞാൻ എന്റെ ക്രോധം","poem":1},{"text":"വെള്ളച്ചാട്ടംപോലെ അവരുടെമേൽ ചൊരിയും.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"എഫ്രയീം വിഗ്രഹത്തെ","poem":1},{"noteId":13},{"text":"ഇഷ്ടപ്പെടുന്നതുകൊണ്ട്","poem":1},{"text":"അവൻ പീഡിതനും","poem":2},{"lineBreak":true},{"text":"വ്യവഹാരത്തിൽ തോറ്റവനും ആയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അതുകൊണ്ടു ഞാൻ എഫ്രയീമിനു പുഴുവും","poem":1},{"text":"യെഹൂദയ്ക്കു പഴുപ്പും ആയിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“എഫ്രയീം തന്റെ രോഗത്തെയും","poem":1},{"text":"യെഹൂദാ തന്റെ വ്രണങ്ങളെയും കണ്ടപ്പോൾ,","poem":2},{"text":"എഫ്രയീം അശ്ശൂരിലേക്കു തിരിഞ്ഞു,","poem":1},{"text":"മഹാരാജാവിനോടു സഹായം അഭ്യർഥിച്ചു.","poem":2},{"text":"എന്നാൽ നിന്നെ സുഖപ്പെടുത്താനും","poem":1},{"text":"നിന്റെ മുറിവുണക്കാനും അദ്ദേഹത്തിനു കഴിഞ്ഞില്ല.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ഞാൻ എഫ്രയീമിന് ഒരു സിംഹംപോലെയും","poem":1},{"text":"യെഹൂദയ്ക്ക് ഒരു സിംഹക്കുട്ടിപോലെയും ആയിരിക്കും.","poem":2},{"text":"ഞാൻ അവരെ കഷണങ്ങളായി കീറിക്കളയും.","poem":1},{"text":"ഞാൻ അവരെ പിടിച്ചുകൊണ്ടുപോകും, അവരെ രക്ഷിക്കുന്നതിനായി ആരും ശേഷിക്കുകയില്ല.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവർ തങ്ങളുടെ കുറ്റം സമ്മതിച്ച്","poem":1},{"text":"എന്റെ മുഖം അന്വേഷിക്കുന്നതുവരെയും","poem":2},{"lineBreak":true},{"text":"ഞാൻ എന്റെ സ്ഥലത്തേക്ക് മടങ്ങിപ്പോകും—","poem":2},{"text":"അവരുടെ ദുരിതത്തിൽ","poem":1},{"text":"അവർ എന്നെ ജാഗ്രതയോടെ അന്വേഷിക്കും.”","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"ഈ വാക്കിനുള്ള എബ്രായപദത്തിന്റെ അർഥം വ്യക്തമല്ല.","reference":{"chapter":5,"verse":11}}]},"thisChapterLink":"/api/mal_bib/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}