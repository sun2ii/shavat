{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"HOS","translationId":"mal_bib","name":"ഹോശേയ","commonName":"ഹോശേയ","title":"ഹോശേയയുടെ പ്രവചനം","order":28,"numberOfChapters":14,"sha256":"543165cbd05e83f330e0ac96f0ffd55bafa3ff9f1c3bcc2cf5c58822e6844da7","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mal_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["ഇസ്രായേൽ ശിക്ഷിക്കപ്പെടും"]},{"type":"verse","number":1,"content":[{"text":"ഇസ്രായേലേ, മറ്റു രാഷ്ട്രങ്ങളെപ്പോലെ","poem":1},{"text":"നീ ആനന്ദിക്കരുത്;","poem":2},{"text":"കാരണം എല്ലാ മെതിക്കളങ്ങളിലും നിങ്ങൾ","poem":1},{"text":"വേശ്യയുടെ കൂലി ആഗ്രഹിച്ചുകൊണ്ട്","poem":2},{"lineBreak":true},{"text":"ദൈവത്തോട് അവിശ്വസ്തരായിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"മെതിക്കളങ്ങളും വീഞ്ഞുചക്കുകളും ജനത്തെ പരിപോഷിപ്പിക്കുകയില്ല;","poem":1},{"text":"പുതുവീഞ്ഞ് അവർക്കു ലഭിക്കുകയുമില്ല.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവർ യഹോവയുടെ ദേശത്തു ശേഷിക്കുകയില്ല;","poem":1},{"text":"എഫ്രയീം ഈജിപ്റ്റിലേക്കു മടങ്ങിപ്പോകുകയും","poem":2},{"lineBreak":true},{"text":"അശ്ശൂരിൽവെച്ച് അശുദ്ധാഹാരം കഴിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവർ യഹോവയ്ക്കു വീഞ്ഞ് അർപ്പിക്കുകയില്ല,","poem":1},{"text":"അവരുടെ ഹനനയാഗങ്ങൾ അവിടത്തേക്കു പ്രസാദമാകുകയുമില്ല.","poem":2},{"text":"ആ അപ്പം അവർക്കു വിലാപക്കാരുടെ അപ്പംപോലെ ആയിരിക്കും;","poem":1},{"text":"അതു തിന്നുന്നവരൊക്കെയും അശുദ്ധരാകും.","poem":2},{"text":"ഈ ഭക്ഷണം അവർക്കു വിശപ്പടക്കാൻമാത്രം കൊള്ളാം;","poem":1},{"text":"അതു യഹോവയുടെ ആലയത്തിൽ വരികയുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"നിങ്ങളുടെ ഉത്സവദിവസങ്ങളിൽ,","poem":1},{"text":"യഹോവയുടെ ഉത്സവദിവസങ്ങളിൽ, നിങ്ങൾ എന്തുചെയ്യും?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവർ നാശത്തിൽനിന്നു രക്ഷപ്പെട്ടാലും,","poem":1},{"text":"ഈജിപ്റ്റ് അവരെ പിടിച്ചടക്കുകയും","poem":2},{"lineBreak":true},{"text":"മോഫ് അവരെ കുഴിച്ചിടുകയും ചെയ്യും.","poem":2},{"text":"അവരുടെ വെള്ളിനിക്ഷേപം മുൾച്ചെടികൾ അപഹരിക്കും.","poem":1},{"text":"മുള്ളുകൾ അവരുടെ കൂടാരങ്ങളെ മൂടും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ശിക്ഷയുടെ ദിവസങ്ങൾ വരുന്നു,","poem":1},{"text":"പ്രതികാരദിവസങ്ങൾ സമീപമായിരിക്കുന്നു.","poem":2},{"lineBreak":true},{"text":"ഇസ്രായേൽ ഇത് അറിഞ്ഞുകൊള്ളട്ടെ.","poem":2},{"text":"നിങ്ങളുടെ പാപങ്ങൾ അത്യധികമായിരിക്കുന്നതുകൊണ്ടും","poem":1},{"text":"നിങ്ങളുടെ ശത്രുത വലുതാകുകയാലും","poem":2},{"text":"പ്രവാചകനെ ഒരു ഭോഷനായും","poem":1},{"text":"ആത്മപ്രേരിതനെ ഒരു ഭ്രാന്തനായും നിങ്ങൾ പരിഗണിക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"യഹോവയുടെ പ്രവാചകൻ എന്റെ ദൈവത്തോടൊപ്പം","poem":1},{"text":"എഫ്രയീമിന്റെമേൽ കാവൽക്കാരനായിരിക്കുന്നു.","poem":2},{"text":"എങ്കിലും അവന്റെ വഴികളിൽ കെണികളും","poem":1},{"text":"അവന്റെ ദൈവത്തിന്റെ ആലയത്തിൽ ശത്രുതയും ഉണ്ട്.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവർ ഗിബെയയുടെ ദിനങ്ങളെപ്പോലെ","poem":1},{"text":"മാലിന്യത്തിൽ ആണ്ടുപോയിരിക്കുന്നു.","poem":2},{"text":"ദൈവം അവരുടെ ദുഷ്ടത ഓർക്കും","poem":1},{"text":"അവരുടെ പാപങ്ങൾനിമിത്തം അവരെ ശിക്ഷിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ഞാൻ ഇസ്രായേലിനെ കണ്ടെത്തിയപ്പോൾ,","poem":1},{"text":"അതു മരുഭൂമിയിൽ മുന്തിരിപ്പഴം കണ്ടെത്തിയതുപോലെ ആയിരുന്നു;","poem":2},{"text":"ഞാൻ നിങ്ങളുടെ പിതാക്കന്മാരെ കണ്ടെത്തിയപ്പോൾ","poem":1},{"text":"അത് അത്തിവൃക്ഷത്തിൽ കന്നിക്കായ്കൾ കാണുന്നതുപോലെയും ആയിരുന്നു.","poem":2},{"text":"എന്നാൽ ബാൽ-പെയോരിൽ എത്തിയപ്പോൾ,","poem":1},{"text":"അവർ തങ്ങളെത്തന്നെ ആ ലജ്ജാവഹമായ വിഗ്രഹത്തിനു സമർപ്പിച്ചു.","poem":2},{"lineBreak":true},{"text":"തങ്ങൾ സ്നേഹിച്ച ആ വിഗ്രഹത്തെപ്പോലെതന്നെ അവർ നികൃഷ്ടരായിത്തീർന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"എഫ്രയീമിന്റെ മഹത്ത്വം ഒരു പക്ഷിയെപ്പോലെ പറന്നുപോകും—","poem":1},{"text":"ജനനമില്ല, ഗർഭമില്ല, ഗർഭധാരണവുമില്ല!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവർ കുഞ്ഞുങ്ങളെ വളർത്തിയാലും","poem":1},{"text":"ഞാൻ അവരെ ഒരാളും ശേഷിക്കാതവണ്ണം മക്കളില്ലാത്തവരാക്കും.","poem":2},{"text":"ഞാൻ അവരെ വിട്ടുമാറുമ്പോൾ","poem":1},{"text":"അവർക്കു ഹാ കഷ്ടം!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"സോരിനെപ്പോലെ മനോഹരസ്ഥലത്തു നട്ടിരിക്കുന്ന","poem":1},{"text":"എഫ്രയീമിനെ ഞാൻ കണ്ടു.","poem":2},{"text":"എന്നാൽ എഫ്രയീം തന്റെ മക്കളെ","poem":1},{"text":"ഘാതകന്റെ അടുക്കൽ കൊണ്ടുചെല്ലേണ്ടിവരും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"അവർക്കു നൽകണമേ യഹോവേ,","poem":1},{"text":"അവർക്ക് അങ്ങ് എന്താണു നൽകുന്നത്?","poem":2},{"text":"അലസിപ്പോകുന്ന ഗർഭവും,","poem":1},{"text":"വരണ്ടുപോകുന്ന മുലകളും അവർക്കു നൽകണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“ഗിൽഗാലിൽ അവരുടെ സകലദുഷ്ടതയുംനിമിത്തം","poem":1},{"text":"ഞാൻ അവിടെ അവരെ വെറുത്തു.","poem":2},{"text":"അവരുടെ പാപപ്രവൃത്തികൾനിമിത്തം","poem":1},{"text":"ഞാൻ അവരെ എന്റെ ഭവനത്തിൽനിന്ന് ഓടിച്ചുകളയും.","poem":2},{"text":"ഞാൻ ഇനി അവരെ സ്നേഹിക്കുകയില്ല;","poem":1},{"text":"അവരുടെ എല്ലാ പ്രഭുക്കന്മാരും മത്സരികൾതന്നെ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"എഫ്രയീം നശിച്ചിരിക്കുന്നു,","poem":1},{"text":"അവരുടെ വേര് ഉണങ്ങിപ്പോയി,","poem":2},{"lineBreak":true},{"text":"അവർ ഫലം പുറപ്പെടുവിക്കുന്നില്ല.","poem":2},{"text":"അവർ കുഞ്ഞുങ്ങളെ ഗർഭംധരിച്ചാലും,","poem":1},{"text":"അവരുടെ പ്രിയ ഗർഭഫലങ്ങളെ ഞാൻ സംഹരിച്ചുകളയും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"അവർ യഹോവയെ അനുസരിക്കായ്കകൊണ്ട്","poem":1},{"text":"എന്റെ ദൈവം അവരെ നിരസിച്ചുകളയും;","poem":2},{"lineBreak":true},{"text":"അവർ രാഷ്ട്രങ്ങൾക്കിടയിൽ അലയുന്നവരാകും.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}