{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":11,"content":[{"type":"heading","content":["യിശ്ശായിയുടെ ശാഖ"]},{"type":"verse","number":1,"content":[{"text":"യിശ്ശായിയുടെ കുറ്റിയിൽനിന്ന് ഒരു മുള ഉയർന്നുവരും;","poem":1},{"text":"അദ്ദേഹത്തിന്റെ വേരുകളിൽനിന്നുള്ള ഒരു ശാഖ ഫലം കായ്ക്കും.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"യഹോവയുടെ ആത്മാവ് അദ്ദേഹത്തിന്റെമേൽ ആവസിക്കും—","poem":1},{"text":"ജ്ഞാനത്തിന്റെയും വിവേകത്തിന്റെയും ആത്മാവ്,","poem":2},{"lineBreak":true},{"text":"ആലോചനയുടെയും ശക്തിയുടെയും ആത്മാവ്,","poem":2},{"lineBreak":true},{"text":"പരിജ്ഞാനത്തിന്റെയും യഹോവാഭക്തിയുടെയും ആത്മാവുതന്നെ—","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അദ്ദേഹം യഹോവാഭക്തിയിൽ ആനന്ദിക്കും.","poem":1},{"lineBreak":true},{"text":"അദ്ദേഹം തന്റെ കണ്ണു കാണുന്നത് ആധാരമാക്കി വിധിക്കുകയോ","poem":1},{"text":"തന്റെ ചെവി കേൾക്കുന്നത് അടിസ്ഥാനമാക്കി ഒരു തീരുമാനമെടുക്കുകയോ ചെയ്യുകയില്ല;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"എന്നാൽ അദ്ദേഹം നീതിയോടെ സഹായാർഥിക്കു ന്യായപാലനംചെയ്യും;","poem":1},{"text":"അദ്ദേഹം ഭൂമിയിലെ ദരിദ്രർക്ക് ന്യായത്തോടെ വിധി കൽപ്പിക്കും.","poem":2},{"text":"തന്റെ വായ് എന്ന വടികൊണ്ട് അവിടന്ന് ഭൂമിയെ അടിക്കും;","poem":1},{"text":"തന്റെ അധരങ്ങളിൽനിന്നുള്ള ശ്വാസത്താൽ അദ്ദേഹം ദുഷ്ടരെ വധിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"നീതി അവിടത്തെ അരപ്പട്ടയും","poem":1},{"text":"വിശ്വസ്തത അവിടത്തെ അരക്കച്ചയുമായിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"അന്നു ചെന്നായ് കുഞ്ഞാടിനോടുകൂടെ പാർക്കും,","poem":1},{"text":"പുള്ളിപ്പുലി കോലാട്ടിൻകുട്ടിയോടുകൂടെ കിടക്കും,","poem":2},{"text":"പശുക്കിടാവും സിംഹക്കുട്ടിയും യാഗമൃഗവും","poem":1},{"noteId":13},{"text":"ഒരുമിച്ചുകഴിയും;","poem":1},{"text":"ഒരു ചെറിയ കുട്ടി അവയെ നയിക്കും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"പശുവും കരടിയും ഒരുമിച്ചു മേയും,","poem":1},{"text":"അവയുടെ കുട്ടികൾ ഒരുമിച്ചു കിടക്കും,","poem":2},{"lineBreak":true},{"text":"സിംഹം കാളയെപ്പോലെ വൈക്കോൽ തിന്നും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"മുലകുടിക്കുന്ന ശിശു സർപ്പത്തിന്റെ മാളത്തിൽ കളിക്കും,","poem":1},{"text":"മുലകുടിമാറിയ പൈതൽ അണലിയുടെ പൊത്തിൽ കൈയിടും.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"എന്റെ വിശുദ്ധപർവതത്തിൽ ഒരിടത്തും","poem":1},{"text":"ഉപദ്രവമോ നാശമോ ആരും ചെയ്യുകയില്ല,","poem":2},{"text":"സമുദ്രം വെള്ളത്താൽ നിറഞ്ഞിരിക്കുന്നതുപോലെ","poem":1},{"text":"ഭൂമി യഹോവയുടെ പരിജ്ഞാനംകൊണ്ടു നിറഞ്ഞിരിക്കും.","poem":2}]},{"type":"verse","number":10,"content":["ആ കാലത്തു യിശ്ശായിയുടെ വേര് ജനതകൾക്ക് ഒരു കൊടിയായി ഉയർന്നുനിൽക്കും; രാഷ്ട്രങ്ങൾ യിശ്ശായിയുടെ വേരായവനെ അന്വേഷിച്ചു വരും, അവിടത്തെ വിശ്രമസങ്കേതം മഹത്ത്വകരമായിരിക്കും."]},{"type":"verse","number":11,"content":["ആ കാലത്ത് കർത്താവ് തന്റെ ജനത്തിൽ ശേഷിച്ചിട്ടുള്ളവരെ അശ്ശൂരിൽനിന്നും ഉത്തര ഈജിപ്റ്റിൽനിന്നും പത്രോസിൽനിന്നും",{"noteId":14},"കൂശിൽനിന്നും",{"noteId":15},"ഏലാമിൽനിന്നും ബാബേലിൽനിന്നും",{"noteId":16},"ഹമാത്തിൽനിന്നും മെഡിറ്ററേനിയൻ സമുദ്രത്തിലെ ദ്വീപുകളിൽനിന്നും രണ്ടാംപ്രാവശ്യവും മടക്കിക്കൊണ്ടുവരുന്നതിനു കൈനീട്ടും."]},{"type":"verse","number":12,"content":[{"text":"അവിടന്ന് രാഷ്ട്രങ്ങൾക്കായി ഒരു കൊടി ഉയർത്തും,","poem":1},{"text":"ഇസ്രായേലിലെ പ്രവാസികളെ ശേഖരിക്കും;","poem":2},{"text":"യെഹൂദയുടെ ചിതറിപ്പോയിട്ടുള്ളവരെ","poem":1},{"text":"ഭൂമിയുടെ നാലുകോണുകളിൽനിന്നും കൂട്ടിച്ചേർക്കും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"എഫ്രയീമിന്റെ അസൂയ നീങ്ങിപ്പോകും,","poem":1},{"text":"യെഹൂദയെ ദ്രോഹിക്കുന്നവർ ഛേദിക്കപ്പെടും;","poem":2},{"text":"എഫ്രയീം യെഹൂദയെപ്പറ്റി അസൂയപ്പെടുകയോ","poem":1},{"text":"യെഹൂദാ എഫ്രയീമിനെ ദ്രോഹിക്കുകയോ ചെയ്യുകയില്ല.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവർ പശ്ചിമഭാഗത്തുള്ള ഫെലിസ്ത്യരുടെ ചരിഞ്ഞപ്രദേശത്ത് ഇരച്ചുകയറും;","poem":1},{"text":"ഒത്തൊരുമിച്ച് അവർ കിഴക്കുള്ളവരെയെല്ലാം കൊള്ളയിടും.","poem":2},{"text":"ഏദോമിനെയും മോവാബിനെയും അവർ കീഴ്പ്പെടുത്തും,","poem":1},{"text":"അമ്മോന്യർ അവർക്കു കീഴ്പ്പെട്ടിരിക്കും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഈജിപ്റ്റുകടലിന്റെ നാവിനെ","poem":1},{"text":"യഹോവ പൂർണമായും നശിപ്പിച്ചുകളയും;","poem":2},{"text":"തന്റെ ഉഷ്ണക്കാറ്റുകൊണ്ട് അവിടന്ന്","poem":1},{"text":"യൂഫ്രട്ടീസ് നദിയുടെ മീതേ കൈയോങ്ങും.","poem":2},{"text":"അവിടന്ന് അതിനെ ഏഴ് അരുവികളാക്കി വിഭജിക്കും","poem":1},{"text":"അങ്ങനെ അവർ ചെരിപ്പിട്ടുകൊണ്ടുതന്നെ മറുകരയിലെത്തും.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ഇസ്രായേൽ ഈജിപ്റ്റിൽനിന്ന് പുറപ്പെട്ട നാളിൽ","poem":1},{"text":"അവർക്ക് ഉണ്ടായിരുന്നതുപോലെ","poem":2},{"text":"അശ്ശൂരിൽ അവിടത്തെ ജനത്തിൽ അവശേഷിക്കുന്നവർക്ക്","poem":1},{"text":"കടന്നുപോകാൻ ഒരു രാജവീഥിയുണ്ടാകും.","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"അഥവാ, കൊഴുത്ത ഊനമില്ലാത്ത ഒരുവയസ്സുള്ള മൃഗവും","reference":{"chapter":11,"verse":6}},{"noteId":14,"caller":"+","text":"അതായത്, തെക്കേ ഈജിപ്റ്റിൽനിന്നും.","reference":{"chapter":11,"verse":11}},{"noteId":15,"caller":"+","text":"ഈ പ്രദേശം, തെക്കുകിഴക്കൻ മെസൊപ്പൊത്താമിയ ആണെന്നു കരുതപ്പെടുന്നു.","reference":{"chapter":11,"verse":11}},{"noteId":16,"caller":"+","text":"മൂ.ഭാ. ശിനാറിൽനിന്നും","reference":{"chapter":11,"verse":11}}]},"thisChapterLink":"/api/mal_bib/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/10.json","previousChapterAudioLinks":{},"numberOfVerses":16}