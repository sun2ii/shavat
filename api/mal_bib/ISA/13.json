{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":13,"content":[{"type":"heading","content":["ബാബേലിനെതിരേയുള്ള പ്രവചനം"]},{"type":"verse","number":1,"content":["ആമോസിന്റെ മകനായ യെശയ്യാവ് ബാബേലിനെതിരേ കണ്ട ദർശനം:"]},{"type":"verse","number":2,"content":[{"text":"മൊട്ടക്കുന്നിന്മേൽ കൊടി ഉയർത്തുക,","poem":1},{"text":"അവർ പ്രഭുക്കന്മാരുടെ കവാടങ്ങളിലേക്കു കടക്കാൻ","poem":2},{"text":"അവരെ ശബ്ദം ഉയർത്തി","poem":1},{"text":"കൈകാട്ടി വിളിക്കുക.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"എന്റെ കോപം നിറവേറ്റാൻ ഞാൻ സജ്ജരാക്കിയ,","poem":1},{"text":"എന്റെ വിജയത്തിൽ ആഹ്ലാദിക്കുന്നവരായ","poem":2},{"lineBreak":true},{"text":"എന്റെ യോദ്ധാക്കളെ ഞാൻ ആഹ്വാനംചെയ്തിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"വലിയൊരു ജനസമൂഹത്തിന്റെ ആരവംപോലെ","poem":1},{"text":"പർവതങ്ങളിലെ ഘോഷം കേൾക്കുക!","poem":2},{"text":"രാജ്യങ്ങളും ജനതകളും ഒത്തൊരുമിച്ചുകൂടിയതുപോലുള്ള","poem":1},{"text":"ഒരു മഹാഘോഷം ശ്രദ്ധിക്കുക!","poem":2},{"text":"സൈന്യങ്ങളുടെ യഹോവ","poem":1},{"text":"യുദ്ധത്തിനായി സൈന്യത്തെ അണിനിരത്തുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവർ ദൂരദേശത്തുനിന്ന്,","poem":1},{"text":"ആകാശത്തിന്റെ അതിരുകളിൽനിന്നുതന്നെ വരുന്നു—","poem":2},{"text":"യഹോവയും അവിടത്തെ ക്രോധംചൊരിയുന്ന ആയുധങ്ങളും","poem":1},{"text":"ദേശത്തെ മുഴുവനും നശിപ്പിക്കുന്നതിനായിത്തന്നെ വരുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"വിലപിക്കുക, യഹോവയുടെ ദിവസം സമീപിച്ചിരിക്കുന്നു;","poem":1},{"text":"സർവശക്തനിൽനിന്നുള്ള സംഹാരംപോലെ അതു വരും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അതിനാൽ എല്ലാ കൈകളും തളരും,","poem":1},{"text":"ഏതു മനുഷ്യന്റെ ഹൃദയവും ഉരുകിപ്പോകും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവർ ഭയവിഹ്വലരാകും,","poem":1},{"text":"സങ്കടവും വേദനയും അവരെ പിടികൂടും;","poem":2},{"lineBreak":true},{"text":"പ്രസവവേദനയിൽ ആയിരിക്കുന്ന സ്ത്രീയെപ്പോലെ അവർ വേദനപ്പെടും.","poem":2},{"text":"ജ്വലിക്കുന്ന മുഖത്തോടെ അവർ","poem":1},{"text":"അന്ധാളിച്ച് പരസ്പരം തുറിച്ചുനോക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ഇതാ, യഹോവയുടെ ദിവസം വരുന്നു—","poem":1},{"text":"ക്രൂരതനിറഞ്ഞ, ക്രോധവും ഭയാനക കോപവും നിറഞ്ഞ ഒരു ദിവസം—","poem":2},{"text":"ദേശത്തെ ശൂന്യമാക്കുന്നതിനും","poem":1},{"text":"അതിലുള്ള പാപികളെ ഉന്മൂലനംചെയ്യുന്നതിനുംതന്നെ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ആകാശത്തിലെ നക്ഷത്രങ്ങളും നക്ഷത്രവ്യൂഹങ്ങളും","poem":1},{"text":"പ്രകാശം കൊടുക്കുകയില്ല.","poem":2},{"text":"സൂര്യൻ ഉദയത്തിൽത്തന്നെ ഇരുണ്ടുപോകും,","poem":1},{"text":"ചന്ദ്രൻ അതിന്റെ പ്രകാശം ചൊരിയുകയുമില്ല.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ഞാൻ ലോകത്തെ അതിന്റെ ദുഷ്ടതനിമിത്തവും","poem":1},{"text":"ദുഷ്ടരെ തങ്ങളുടെ പാപംനിമിത്തവും ശിക്ഷിക്കും.","poem":2},{"text":"നിഗളികളുടെ ഗർവത്തിനു ഞാൻ അറുതിവരുത്തും,","poem":1},{"text":"നിഷ്ഠുരരുടെ അഹങ്കാരത്തെ ഞാൻ താഴ്ത്തിക്കളയും.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ഞാൻ മനുഷ്യരെ തങ്കത്തെക്കാളും","poem":1},{"text":"അവരെ ഓഫീർ തങ്കത്തെക്കാളും ദുർല്ലഭരാക്കും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അങ്ങനെ ഞാൻ ആകാശത്തെ നടുക്കും;","poem":1},{"text":"സൈന്യങ്ങളുടെ യഹോവയുടെ കോപത്താൽ,","poem":2},{"text":"അവിടത്തെ ഉഗ്രകോപത്തിന്റെ നാളിൽ","poem":1},{"text":"ഭൂമി സ്വസ്ഥാനത്തുനിന്ന് ഇളകിപ്പോകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"വേട്ടയാടപ്പെട്ട കലമാൻപോലെയും","poem":1},{"text":"ഇടയനില്ലാത്ത ആട്ടിൻപറ്റംപോലെയും","poem":2},{"text":"അവർ ഓരോരുത്തനും തങ്ങളുടെ ജനത്തിന്റെ അടുക്കലേക്കു മടങ്ങും,","poem":1},{"text":"അവർ സ്വന്തം നാട്ടിലേക്കുതന്നെ ഓടിപ്പോകും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"കണ്ടുകിട്ടുന്നവരെയെല്ലാം കുത്തിക്കൊല്ലും;","poem":1},{"text":"പിടിക്കപ്പെടുന്നവരെല്ലാം വാളിനിരയാകും.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അവരുടെ ശിശുക്കളെപ്പോലും അവരുടെ കൺമുമ്പിൽവെച്ച് അടിച്ചുതകർക്കും;","poem":1},{"text":"അവരുടെ വീടുകൾ കൊള്ളചെയ്യപ്പെടുകയും ഭാര്യമാർ അതിക്രമത്തിന് ഇരയാകുകയും ചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ഇതാ, ഞാൻ മേദ്യരെ അവർക്കെതിരായി ഉണർത്തും,","poem":1},{"text":"അവർ വെള്ളി വിലയുള്ളതായി കരുതുന്നില്ല,","poem":2},{"lineBreak":true},{"text":"സ്വർണത്തിൽ അവർക്കു താത്പര്യവുമില്ല.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അവരുടെ വില്ലുകൾ യുവാക്കന്മാരെ കൊന്നൊടുക്കും;","poem":1},{"text":"ശിശുക്കളോട് അവർ കാരുണ്യം കാണിക്കുകയോ","poem":2},{"lineBreak":true},{"text":"കുട്ടികളോട് അവർക്ക് അനുകമ്പതോന്നുകയോ ഇല്ല.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"രാജ്യങ്ങളുടെ ചൂഡാമണിയും","poem":1},{"text":"ബാബേല്യരുടെ","poem":2},{"noteId":18},{"text":"അഭിമാനവും മഹത്ത്വവുമായ ബാബേൽപട്ടണത്തെ,","poem":2},{"text":"സൊദോമിനെയും ഗൊമോറായെയും തകർത്തതുപോലെ","poem":1},{"text":"ദൈവം തകർത്തെറിയും.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"തലമുറതലമുറയായി അതു നിർജനമായും","poem":1},{"text":"പാർക്കാൻ ആളില്ലാതെയും കിടക്കും;","poem":2},{"text":"ദേശാന്തരികൾ","poem":1},{"noteId":19},{"text":"അവിടെ കൂടാരമടിക്കുകയില്ല,","poem":1},{"text":"ഇടയന്മാർ തങ്ങളുടെ കൂട്ടത്തെ അവിടെ കിടത്തുകയുമില്ല.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"വന്യമൃഗങ്ങൾ അവിടെ വിശ്രമിക്കും,","poem":1},{"text":"അവരുടെ വീടുകളിൽ കുറുനരികൾ നിറയും;","poem":2},{"text":"ഒട്ടകപ്പക്ഷികൾ അവിടെ പാർക്കും,","poem":1},{"text":"കാട്ടാടുകൾ അവിടെ നൃത്തംചെയ്യും.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"അവരുടെ കെട്ടുറപ്പുള്ള കോട്ടകളിൽ കഴുതപ്പുലികളും","poem":1},{"text":"അവരുടെ മണിമേടകളിൽ കുറുനരികളും ഓരിയിടും.","poem":2},{"text":"അവളുടെ സമയം അടുത്തിരിക്കുന്നു,","poem":1},{"text":"അതിനുള്ള നാളുകൾ നീണ്ടുപോകുകയുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":18,"caller":"+","text":"അഥവാ, കൽദയരുടെ","reference":{"chapter":13,"verse":19}},{"noteId":19,"caller":"+","text":"മൂ.ഭാ. അറബികൾ","reference":{"chapter":13,"verse":20}}]},"thisChapterLink":"/api/mal_bib/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}