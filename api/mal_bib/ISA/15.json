{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":15,"content":[{"type":"heading","content":["മോവാബിനെതിരേയുള്ള പ്രവചനം"]},{"type":"verse","number":1,"content":["മോവാബിനെതിരേയുള്ള പ്രവചനം:",{"text":"ഒരു രാത്രികൊണ്ട്,","poem":1},{"text":"മോവാബിലെ ആർ പട്ടണം ശൂന്യമാക്കപ്പെട്ടു!","poem":2},{"text":"ഒറ്റ രാത്രികൊണ്ട്,","poem":1},{"text":"മോവാബിലെ കീർ പട്ടണവും ശൂന്യമാക്കപ്പെട്ടു!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ദീബോൻ അവരുടെ ആലയത്തിലേക്കു കയറിപ്പോകുന്നു,","poem":1},{"text":"വിലപിക്കുന്നതിനായി അവരുടെ ക്ഷേത്രങ്ങളിലേക്കുതന്നെ;","poem":2},{"lineBreak":true},{"text":"മോവാബ് നെബോയെയും മെദേബായെയുംപറ്റി വിലപിക്കുന്നു.","poem":2},{"text":"എല്ലാവരുടെയും തല മൊട്ടയടിച്ചും","poem":1},{"text":"താടി കത്രിച്ചുമിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"തെരുവീഥികളിൽ അവർ ചാക്കുശീലയുടുത്തു നടക്കുന്നു;","poem":1},{"text":"പുരമുകളിലും ചത്വരങ്ങളിലുമുള്ള","poem":2},{"text":"എല്ലാവരും വിലപിക്കുന്നു,","poem":1},{"text":"കരഞ്ഞുകൊണ്ട് അവർ കാൽക്കൽവീഴുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ഹെശ്ബോനും എലെയാലെയും നിലവിളിക്കുന്നു,","poem":1},{"text":"അവരുടെ ശബ്ദം ദൂരത്ത് യാഹാസുവരെയും കേൾക്കുന്നു.","poem":2},{"text":"അതിനാൽ മോവാബിലെ ആയുധപാണികൾ ഉച്ചത്തിൽ വിളിക്കുന്നു,","poem":1},{"text":"അവരുടെ ഹൃദയം ഉള്ളിൽ വിറകൊള്ളുകയുംചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"എന്റെ ഹൃദയം മോവാബിനെക്കുറിച്ചു നിലവിളിക്കുന്നു;","poem":1},{"text":"അവിടത്തെ ജനം സോവാറിലേക്കും","poem":2},{"lineBreak":true},{"text":"എഗ്ലത്ത്-ശെലീശിയായിലേക്കും പലായനംചെയ്യുന്നു.","poem":2},{"text":"അവർ ലൂഹീത്ത് കയറ്റംവരെ കയറിച്ചെല്ലുന്നു,","poem":1},{"text":"കരഞ്ഞുകൊണ്ട് അവരുടെ യാത്ര തുടരുന്നു.","poem":2},{"text":"ഹോരോനയീമിലേക്കുള്ള പാതയിൽ","poem":1},{"text":"അവർ തങ്ങളുടെ നാശത്തെപ്പറ്റി നിലവിളിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"നിമ്രീമിലെ ജലാശയങ്ങൾ വരണ്ടല്ലോ,","poem":1},{"text":"പുല്ലു വാടിയുണങ്ങിയും പോയല്ലോ;","poem":2},{"text":"ഇളംപുല്ലു നശിച്ചുപോയല്ലോ","poem":1},{"text":"പച്ചയായതൊന്നും ശേഷിച്ചിട്ടുമില്ല.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"തന്മൂലം അവർ സമ്പാദിച്ചു കൂട്ടിവെച്ച സ്വത്ത്","poem":1},{"text":"അലരിത്തോട്ടിനക്കരയ്ക്ക് അവർ ചുമന്നുകൊണ്ടുപോകുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ദുരിതത്തിന്റെ നിലവിളി മോവാബിനു ചുറ്റും പ്രതിധ്വനിക്കുന്നു;","poem":1},{"text":"അതിന്റെ അലർച്ച എഗ്ലയീംവരെയും","poem":2},{"lineBreak":true},{"text":"അതിന്റെ വിലാപം ബേർ-ഏലീംവരെയും എത്തിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ദീമോനിലെ ജലാശയങ്ങൾ രക്തംകൊണ്ടു","poem":1},{"noteId":22},{"text":"നിറഞ്ഞിരിക്കുന്നു,","poem":1},{"text":"എന്നാൽ ഞാൻ ദീമോന്റെമേൽ ഇനിയും അധികം ആപത്തുകൾ വരുത്തും—","poem":2},{"text":"മോവാബിലെ പലായിതരുടെമേലും","poem":1},{"text":"ദേശത്തിലെ ശേഷിപ്പിന്മേലും ഞാൻ ഒരു സിംഹത്തെ വരുത്തും.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":22,"caller":"+","text":"ദീമോൻ, രക്തം എന്നിവയ്ക്കുള്ള എബ്രായവാക്കുകളുടെ ഉച്ചാരണങ്ങൾ തമ്മിൽ വളരെ സാമ്യമുണ്ട്.","reference":{"chapter":15,"verse":9}}]},"thisChapterLink":"/api/mal_bib/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}