{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":17,"content":[{"type":"heading","content":["ദമസ്കോസിനെതിരേയുള്ള പ്രവചനം"]},{"type":"verse","number":1,"content":["ദമസ്കോസിനെതിരേയുള്ള പ്രവചനം:",{"text":"“നോക്കൂ, ദമസ്കോസ് ഒരു പട്ടണമല്ലാതായിത്തീരും","poem":1},{"text":"എന്നാൽ അതു നാശനഷ്ടങ്ങളുടെ ഒരു കൂമ്പാരമാകും.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അരോയേർപട്ടണങ്ങൾ ജനവാസമില്ലാത്തതാകും,","poem":1},{"text":"അവ ആട്ടിൻപറ്റങ്ങൾക്കുള്ളത്, അവയവിടെ കിടക്കും,","poem":2},{"lineBreak":true},{"text":"ആരും അവയെ ഭയപ്പെടുത്തുകയില്ല.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"എഫ്രയീമിൽനിന്ന് കോട്ടകെട്ടിയുറപ്പിച്ച പട്ടണം അപ്രത്യക്ഷമാകും,","poem":1},{"text":"ദമസ്കോസിൽനിന്നു രാജത്വവും ഇല്ലാതാകും;","poem":2},{"text":"അരാമിൽ ശേഷിച്ച ജനം","poem":1},{"text":"ഇസ്രായേൽമക്കളുടെ മഹത്ത്വംപോലെയാകും,”","poem":2},{"text":"എന്ന് സൈന്യങ്ങളുടെ യഹോവ അരുളിച്ചെയ്യുന്നു.","poem":4}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“ആ ദിവസത്തിൽ യാക്കോബിന്റെ മഹത്ത്വം മങ്ങിപ്പോകും;","poem":1},{"text":"അവന്റെ കായപുഷ്ടി ക്ഷയിച്ചുപോകും.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അതു കൊയ്ത്തുകാർ കതിരുകൾ ചേർത്തുപിടിച്ച്","poem":1},{"text":"കൈകൊണ്ടു വിളവു കൊയ്തെടുക്കുന്നതുപോലെയാകും—","poem":2},{"text":"രെഫായീം താഴ്വരയിൽ ഒരാൾ","poem":1},{"text":"കാലാപെറുക്കുന്നതുപോലെതന്നെ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഒലിവുമരത്തിൽനിന്ന് കായ്കൾ ശേഖരിക്കുന്നതിനായി തല്ലുമ്പോൾ","poem":1},{"text":"ഏറ്റവും മുകളിലത്തെ ശാഖകളിൽ രണ്ടോ മൂന്നോ കായ്കളും","poem":2},{"text":"ഫലഭൂയിഷ്ഠമായ ശാഖകളിൽ നാലോ അഞ്ചോ കായും ശേഷിക്കുന്നതുപോലെ","poem":1},{"text":"കാലാപെറുക്കാനുള്ള വകമാത്രം ശേഷിച്ചിരിക്കും,”","poem":2},{"text":"എന്ന് ഇസ്രായേലിന്റെ ദൈവമായ യഹോവ അരുളിച്ചെയ്യുന്നു.","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ആ ദിവസത്തിൽ മനുഷ്യർ തങ്ങളുടെ സ്രഷ്ടാവിൽ ആശ്രയിക്കുകയും","poem":1},{"text":"അവരുടെ കണ്ണുകൾ ഇസ്രായേലിന്റെ പരിശുദ്ധനിലേക്കു തിരിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവർ തങ്ങളുടെ കൈകളുടെ നിർമിതിയായ,","poem":1},{"text":"യാഗപീഠങ്ങളിൽ ഇനിയൊരിക്കലും ആശ്രയിക്കുകയില്ല,","poem":2},{"text":"തങ്ങളുടെ വിരലുകൾ നിർമിച്ച അശേരാപ്രതിഷ്ഠകളോടും","poem":1},{"noteId":24},{"text":"ധൂപപീഠങ്ങളോടും അവർക്കു യാതൊരു ആദരവും കാണുകയില്ല.","poem":2}]},{"type":"verse","number":9,"content":["ഇസ്രായേല്യർനിമിത്തം ഉപേക്ഷിക്കപ്പെട്ടുപോയ അവരുടെ ഉറപ്പുള്ള പട്ടണങ്ങൾ കുറ്റിക്കാടും ചോലമേടും ആകാനായി ഉപേക്ഷിച്ചുപോയ സ്ഥലങ്ങൾപോലെയാകും; അവയെല്ലാം ശൂന്യമായിത്തീരും."]},{"type":"verse","number":10,"content":[{"text":"എന്തെന്നാൽ നിങ്ങളുടെ രക്ഷകനായ ദൈവത്തെ നിങ്ങൾ മറന്നു;","poem":1},{"text":"നിങ്ങളുടെ സുരക്ഷിതസ്ഥാനമായ പാറയെ ഓർത്തതുമില്ല.","poem":2},{"text":"അതുകൊണ്ട്, നിങ്ങൾ മനോഹരമായ തോട്ടങ്ങൾ നട്ട്","poem":1},{"text":"അവയിൽ അന്യദേശത്തുനിന്നുമുള്ള വള്ളികൾ നടുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"നടുന്ന ദിവസത്തിൽ നിങ്ങൾ ശ്രദ്ധയോടെ അതിനു വേലികെട്ടുന്നു.","poem":1},{"text":"രാവിലെ നിങ്ങളുടെ നടുതല പൂക്കുമാറാക്കുന്നു.","poem":2},{"text":"എന്നാൽ സങ്കടത്തിന്റെയും തീരാദുഃഖത്തിന്റെയും നാളിൽ","poem":1},{"text":"നിങ്ങളുടെ കൊയ്ത്തു നഷ്ടപ്പെട്ടുപോകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"സമുദ്രത്തിന്റെ ഘോഷംപോലെ","poem":1},{"text":"ആക്രോശിക്കുന്ന നിരവധി രാഷ്ട്രങ്ങൾക്ക് അയ്യോ, കഷ്ടം!","poem":2},{"text":"അലമുറയിടുന്ന ജനതകൾക്കും അയ്യോ, കഷ്ടം—","poem":1},{"text":"അവരുടെ ഇരമ്പൽ പെരുവെള്ളത്തിന്റെ ഇരമ്പൽപോലെ ആകുന്നു!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"പെരുവെള്ളം ഇരമ്പുന്നതുപോലെ ജനാവലി ഇരമ്പുന്നെങ്കിലും,","poem":1},{"text":"അവിടന്ന് അവരെ ശാസിക്കുമ്പോൾ അവർ ദൂരത്തേക്ക് പലായനംചെയ്യും,","poem":2},{"text":"കുന്നുകളിലെ ധൂളി കാറ്റിന്റെമുമ്പിൽ പറക്കുന്നതുപോലെ","poem":1},{"text":"കൊടുങ്കാറ്റിന്റെമുമ്പിൽ ചുഴന്നുപറക്കുന്ന പതിർപോലെയും അവർ പാറിപ്പോകും.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"സന്ധ്യാസമയത്ത് ഇതാ ഭീതി!","poem":1},{"text":"പ്രഭാതത്തിനുമുമ്പ് അവൻ ഇല്ലാതെപോകുന്നു.","poem":2},{"text":"നമ്മെ കൊള്ളയിടുന്നവരുടെ ഓഹരിയും","poem":1},{"text":"നമ്മോടു പിടിച്ചുപറിക്കുന്നവരുടെ അന്ത്യവും ഈ വിധത്തിലായിരിക്കും.","poem":2}]}],"footnotes":[{"noteId":24,"caller":"+","text":"അതായത്, തടിയിൽ പണികഴിപ്പിച്ച അശേരാദേവിയുടെ പ്രതീകങ്ങൾ.","reference":{"chapter":17,"verse":8}}]},"thisChapterLink":"/api/mal_bib/ISA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/16.json","previousChapterAudioLinks":{},"numberOfVerses":14}