{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":2,"content":[{"type":"heading","content":["യഹോവയുടെ പർവതം"]},{"type":"verse","number":1,"content":["ആമോസിന്റെ മകനായ യെശയ്യാവ് യെഹൂദ്യയെയും ജെറുശലേമിനെയുംപറ്റി ദർശിച്ച വചനം ഇതാകുന്നു:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["അന്തിമനാളുകളിൽ,",{"text":"യഹോവയുടെ ആലയമുള്ള പർവതം,","poem":1},{"text":"പർവതങ്ങളിൽവെച്ച് ഏറ്റവും ശ്രേഷ്ഠമായി അംഗീകരിക്കപ്പെടും;","poem":2},{"text":"അതു കുന്നുകൾക്കുമീതേ മഹത്ത്വീകരിക്കപ്പെടും,","poem":1},{"text":"സകലരാഷ്ട്രങ്ങളും അതിലേക്ക് ഒഴുകിയെത്തും.","poem":2}]},{"type":"verse","number":3,"content":["അനേകം ജനതകൾ വന്ന് ഇപ്രകാരം പറയും:",{"text":"“വരൂ, നമുക്ക് യഹോവയുടെ പർവതത്തിലേക്കു കയറിച്ചെല്ലാം,","poem":1},{"text":"യാക്കോബിൻ ദൈവത്തിന്റെ ആലയത്തിലേക്കുതന്നെ.","poem":2},{"text":"അവിടന്ന് തന്റെ വഴികൾ നമ്മെ അഭ്യസിപ്പിക്കും","poem":1},{"text":"അങ്ങനെ നമുക്ക് അവിടത്തെ മാർഗം അവലംബിക്കാം.”","poem":2},{"text":"സീയോനിൽനിന്ന് ഉപദേശവും","poem":1},{"text":"ജെറുശലേമിൽനിന്ന് യഹോവയുടെ വചനവും പുറപ്പെടും.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവിടന്നു രാഷ്ട്രങ്ങൾക്കിടയിൽ ന്യായംവിധിക്കും;","poem":1},{"text":"നിരവധി ജനതകളുടെ തർക്കങ്ങൾക്കു തീർപ്പുകൽപ്പിക്കും.","poem":2},{"text":"അവർ തങ്ങളുടെ വാളുകൾ കലപ്പയ്ക്കു കൊഴുക്കളായും","poem":1},{"text":"കുന്തങ്ങൾ വെട്ടുകത്തികളായും അടിച്ചു രൂപംമാറ്റും.","poem":2},{"text":"രാഷ്ട്രം രാഷ്ട്രത്തിനുനേരേ വാൾ ഉയർത്തുകയില്ല;","poem":1},{"text":"ഇനിയൊരിക്കലും യുദ്ധം അഭ്യസിക്കുകയുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"യാക്കോബിന്റെ പിൻതലമുറകളേ, വരിക;","poem":1},{"text":"നമുക്ക് യഹോവയുടെ വെളിച്ചത്തിൽ നടക്കാം.","poem":2}]},{"type":"heading","content":["യഹോവയുടെ ദിവസം"]},{"type":"verse","number":6,"content":[{"text":"അങ്ങ് അവിടത്തെ ജനമായ","poem":1},{"text":"യാക്കോബിന്റെ പിൻഗാമികളെ ഉപേക്ഷിച്ചു.","poem":2},{"text":"അവരിൽ പൗരസ്ത്യദേശത്തിലെ അന്ധവിശ്വാസങ്ങൾ നിറഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"അവർ ഫെലിസ്ത്യരെപ്പോലെ ദേവപ്രശ്നംവെക്കുകയും","poem":2},{"lineBreak":true},{"text":"യെഹൂദേതരരുടെ ആചാരങ്ങളെ ആലിംഗനംചെയ്യുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവരുടെ ദേശം വെള്ളിയും സ്വർണവുംകൊണ്ടു നിറഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"അവരുടെ നിക്ഷേപങ്ങൾക്ക് ഒരു പരിധിയുമില്ല.","poem":2},{"text":"അവരുടെ നാട് കുതിരകളെക്കൊണ്ടു നിറഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"അവരുടെ രഥങ്ങൾ എണ്ണി തിട്ടപ്പെടുത്താവുന്നതുമല്ല.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവരുടെ ദേശം വിഗ്രഹംകൊണ്ടു നിറഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"അവർ തങ്ങളുടെ കൈകളുടെ പ്രവൃത്തിക്കുമുന്നിൽ വണങ്ങുന്നു,","poem":2},{"lineBreak":true},{"text":"തങ്ങളുടെ വിരലുകൾ നിർമിച്ചതിനെത്തന്നെ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അതുകൊണ്ട് മനുഷ്യർ താഴ്ത്തപ്പെടും;","poem":1},{"text":"എല്ലാവരും കുനിക്കപ്പെടും;","poem":2},{"lineBreak":true},{"text":"അങ്ങ് അവരോടു ക്ഷമിക്കരുതേ.","poem":2},{"noteId":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"യഹോവയുടെ ഭയാനക സാന്നിധ്യത്തിൽനിന്നും","poem":1},{"text":"അവിടത്തെ പ്രഭാമഹത്ത്വത്തിൽനിന്നും","poem":2},{"lineBreak":true},{"text":"പാറയിൽ പ്രവേശിച്ച് തറയിൽ ഒളിച്ചുകൊള്ളുക.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അഹങ്കാരിയുടെ കണ്ണ് താഴ്ത്തപ്പെടും;","poem":1},{"text":"മനുഷ്യന്റെ ഗർവം കുനിയും;","poem":2},{"text":"ആ ദിവസത്തിൽ യഹോവമാത്രം മഹത്ത്വീകരിക്കപ്പെടും.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"സൈന്യങ്ങളുടെ യഹോവ","poem":1},{"text":"ഗർവവും ഉന്നതഭാവവും നിഗളവുമുള്ള","poem":2},{"text":"എല്ലാവർക്കുമായി ഒരു ദിവസം കരുതിവെച്ചിരിക്കുന്നു.","poem":1},{"text":"അവരെല്ലാവരും താഴ്ത്തപ്പെടും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ലെബാനോനിലെ ഉയരവും മഹത്ത്വവുമുള്ള എല്ലാ ദേവദാരുക്കളുടെമേലും","poem":1},{"text":"ബാശാനിലെ എല്ലാ കരുവേലകങ്ങളുടെമേലും","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ഉന്നതമായ എല്ലാ പർവതങ്ങളുടെമേലും","poem":1},{"text":"ഉയരമുള്ള എല്ലാ കുന്നുകളുടെമേലും","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഉന്നതമായ എല്ലാ ഗോപുരത്തിന്റെമേലും","poem":1},{"text":"ഉറപ്പുള്ള എല്ലാ മതിലിന്റെമേലും","poem":2}]},{"type":"verse","number":16,"content":[{"text":"തർശീശിലെ എല്ലാ കപ്പലുകളുടെമേലും","poem":1},{"noteId":2},{"text":"പ്രൗഢിയുള്ള എല്ലാ സമുദ്രയാനങ്ങളുടെമേലും ആ ദിവസം വരും.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"മനുഷ്യന്റെ ഗർവം താഴ്ത്തപ്പെടും;","poem":1},{"text":"അവന്റെ അഹംഭാവമെല്ലാം വിനമ്രമാക്കപ്പെടും;","poem":2},{"text":"ആ ദിവസത്തിൽ യഹോവമാത്രം ഉന്നതനായിരിക്കും,","poem":1}]},{"type":"verse","number":18,"content":[{"text":"വിഗ്രഹങ്ങൾ പൂർണമായും ഒഴിഞ്ഞുപോകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ഭൂമിയെ പ്രകമ്പനംകൊള്ളിക്കാൻ യഹോവ എഴുന്നേൽക്കുമ്പോൾ","poem":1},{"text":"അവിടത്തെ ഭയാനക സാന്നിധ്യത്തിൽനിന്നും,","poem":2},{"text":"അവിടത്തെ പ്രഭാമഹത്ത്വത്തിൽനിന്നും","poem":1},{"text":"മനുഷ്യർ പാറകൾക്കുള്ളിലുള്ള ഗുഹകളിലേക്കും","poem":2},{"lineBreak":true},{"text":"മണ്ണിലെ കുഴികളിലേക്കും കടക്കും.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"തങ്ങൾക്കു നമസ്കരിക്കാൻ ഉണ്ടാക്കിയ","poem":1},{"text":"സ്വർണവും വെള്ളിയുംകൊണ്ടുള്ള ബിംബങ്ങളെ","poem":2},{"text":"മനുഷ്യർ ആ ദിവസത്തിൽ","poem":1},{"text":"തുരപ്പനെലിക്കും നരിച്ചീറിനും എറിഞ്ഞുകളയും.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ഭൂമിയെ വിറകൊള്ളിക്കാൻ യഹോവ എഴുന്നേൽക്കുമ്പോൾ,","poem":1},{"text":"അവിടത്തെ ഭയാനക സാന്നിധ്യത്തിൽനിന്നും,","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ പ്രഭാമഹത്ത്വത്തിൽനിന്നും","poem":2},{"text":"അവർ പാറകളുടെ ഗഹ്വരങ്ങളിലേക്കും","poem":1},{"text":"ഭൂമിയിലെ വിള്ളലുകളിലേക്കും ഓടിപ്പോകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"കേവലം മനുഷ്യനിൽ ആശ്രയിക്കുന്നത് അവസാനിപ്പിക്കുക,","poem":1},{"text":"അവരുടെ ജീവശ്വാസം കേവലം നാസാദ്വാരങ്ങളിലല്ലോ.","poem":2},{"lineBreak":true},{"text":"അവരെ എന്തിനു വിലമതിക്കണം?","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"അഥവാ, അവരെ ഉയർത്തരുതേ","reference":{"chapter":2,"verse":9}},{"noteId":2,"caller":"+","text":"അഥവാ, വാണിജ്യക്കപ്പലുകൾ","reference":{"chapter":2,"verse":16}}]},"thisChapterLink":"/api/mal_bib/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}