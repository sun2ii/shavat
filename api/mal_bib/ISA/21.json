{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":21,"content":[{"type":"heading","content":["ബാബേലിനെതിരേയുള്ള പ്രവചനം"]},{"type":"verse","number":1,"content":["സമുദ്രതീരത്തെ മരുഭൂമിക്കെതിരേയുള്ള പ്രവചനം:",{"text":"ദക്ഷിണദിക്കിൽ ചുഴലിക്കാറ്റ് വീശിയടിക്കുന്നതുപോലെ","poem":1},{"text":"മരുഭൂമിയിൽനിന്ന് അക്രമികൾ വരുന്നു,","poem":2},{"lineBreak":true},{"text":"ഭയാനകമായ പ്രദേശത്തുനിന്നുതന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ഭയാനകമായ ഒരു ദർശനം എനിക്കു വെളിപ്പെട്ടിരിക്കുന്നു:","poem":1},{"text":"വഞ്ചകർ ഒറ്റുകൊടുക്കുന്നു, കൊള്ളക്കാർ കൊള്ളയിടുന്നു.","poem":2},{"text":"ഏലാമ്യരേ, ആക്രമിക്കുക! മേദ്യരേ, ഉപരോധം ഏർപ്പെടുത്തുക!","poem":1},{"text":"ബാബേല്യർ വരുത്തിയ എല്ലാ നെടുവീർപ്പുകൾക്കും ഞാൻ ഒരു അറുതി വരുത്താൻപോകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ഈ കാരണത്താൽ എന്റെ അരക്കെട്ടിൽ വേദന നിറഞ്ഞിരിക്കുന്നു.","poem":1},{"text":"പ്രസവവേദന ബാധിച്ച ഒരു സ്ത്രീയുടേതുപോലെയുള്ള വേദനതന്നെ;","poem":2},{"text":"കേൾക്കുന്ന കാര്യങ്ങളാൽ ഞാൻ പരിഭ്രാന്തനായിരിക്കുന്നു,","poem":1},{"text":"കാണുന്ന കാഴ്ചകളാൽ ഞാൻ ഭയപ്പെടുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"എന്റെ ഹൃദയം പതറുന്നു;","poem":1},{"text":"ഭീതി എന്നെ വലയംചെയ്തിരിക്കുന്നു;","poem":2},{"text":"ഞാൻ കാത്തിരുന്ന സന്ധ്യാസമയം","poem":1},{"text":"എനിക്കൊരു ഘോരത നൽകിയിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"അവർ മേശയൊരുക്കുന്നു","poem":1},{"text":"പരവതാനി വിരിക്കുന്നു","poem":2},{"lineBreak":true},{"text":"ഭക്ഷിച്ചു പാനംചെയ്യുകയും ചെയ്യുന്നു!","poem":2},{"text":"പ്രഭുക്കന്മാരേ, എഴുന്നേൽക്കുക,","poem":1},{"text":"പരിചയ്ക്ക് എണ്ണയിടുക!","poem":2}]},{"type":"verse","number":6,"content":["കർത്താവ് എന്നോട് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:",{"text":"“പോകൂ, ഒരു കാവൽക്കാരനെ നിർത്തൂ,","poem":1},{"text":"അവൻ കാണുന്നതൊക്കെ നിന്നെ അറിയിക്കട്ടെ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ഈരണ്ടു കുതിരകളെ പൂട്ടിയ","poem":1},{"text":"രഥങ്ങൾ വരുന്നതും","poem":2},{"text":"നിരനിരയായി കഴുതകളും ഒട്ടകങ്ങളും","poem":1},{"text":"വരുന്നതു കാണുമ്പോൾ","poem":2},{"text":"അവൻ ജാഗ്രതയുള്ളവനാകട്ടെ,","poem":1},{"text":"പരിപൂർണ ജാഗരൂകൻതന്നെ.”","poem":2}]},{"type":"verse","number":8,"content":["അപ്പോൾ കാവൽക്കാരൻ",{"noteId":29},"ഉച്ചത്തിൽ വിളിച്ചുപറഞ്ഞു:",{"text":"“എന്റെ യജമാനനേ, എല്ലാ പകലുകളിലും ഞാൻ കാവൽഗോപുരത്തിൽ നിൽക്കുന്നു;","poem":1},{"text":"എല്ലാ രാത്രിയിലും ഞാൻ എന്റെ കാവൽസ്ഥാനത്തുതന്നെ ആയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഇതാ, രണ്ടു കുതിരയെപ്പൂട്ടി","poem":1},{"text":"ഒരു പുരുഷൻ രഥമേറി വരുന്നു.","poem":2},{"text":"‘ബാബേൽ വീണുപോയിരിക്കുന്നു, വീണുപോയിരിക്കുന്നു!","poem":1},{"text":"അവളുടെ എല്ലാ ദേവതകളുടെയും വിഗ്രഹങ്ങൾ","poem":2},{"text":"നിലത്തു ചിതറിക്കിടക്കുന്നു,’ ”","poem":1},{"text":"എന്ന് അയാൾ വിളിച്ചുപറയുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"മെതിക്കളത്തിൽവെച്ച് മെതിക്കപ്പെട്ട എന്റെ ജനമേ,","poem":1},{"text":"ഇസ്രായേലിന്റെ ദൈവമായ","poem":2},{"text":"സൈന്യങ്ങളുടെ യഹോവയിൽനിന്ന്","poem":1},{"text":"ഞാൻ കേട്ടതു നിങ്ങളെ അറിയിക്കുന്നു.","poem":2}]},{"type":"heading","content":["ഏദോമിനെതിരേയുള്ള പ്രവചനം"]},{"type":"verse","number":11,"content":["ദൂമായ്ക്കെതിരേയുള്ള",{"noteId":30},"പ്രവചനം:",{"text":"സേയീരിൽനിന്നും ഒരാൾ എന്നോടു വിളിച്ചുപറയുന്നു,","poem":1},{"text":"“കാവൽക്കാരാ, രാത്രി ഇനിയെത്ര ബാക്കി?","poem":2},{"lineBreak":true},{"text":"കാവൽക്കാരാ, രാത്രി ഇനിയെത്ര ബാക്കി?”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"കാവൽക്കാരൻ മറുപടി പറയുന്നു:","poem":1},{"text":"“പ്രഭാതം വരുന്നു, പിന്നെ രാത്രിയും.","poem":2},{"text":"നിങ്ങൾക്കു ചോദിക്കണമെങ്കിൽ ചോദിക്കുക;","poem":1},{"text":"ഇനിയും വീണ്ടും വരിക.”","poem":2}]},{"type":"heading","content":["അറേബ്യക്കെതിരേയുള്ള പ്രവചനം"]},{"type":"verse","number":13,"content":["അറേബ്യക്കെതിരേയുള്ള പ്രവചനം:",{"text":"ദേദാന്യരുടെ വ്യാപാരസംഘങ്ങളേ,","poem":1},{"text":"അറേബ്യയിലെ കാട്ടിൽ കഴിയുന്നവരേ.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"തേമാ നിവാസികളേ,","poem":2},{"text":"ദാഹിച്ചിരിക്കുന്നവർക്കു വെള്ളം കൊണ്ടുവരിക,","poem":1},{"text":"പലായിതർക്ക് അപ്പം കൊണ്ടുവരിക.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവർ വാളിൽനിന്ന്,","poem":1},{"text":"ഊരിയ വാളിൽനിന്നും","poem":2},{"text":"കുലച്ച വില്ലിൽനിന്നും","poem":1},{"text":"യുദ്ധത്തിന്റെ കെടുതിയിൽനിന്നും ഓടിപ്പോകുന്നവരാണ്.","poem":2}]},{"type":"verse","number":16,"content":["കർത്താവ് എന്നോട് ഇപ്രകാരം അരുളിച്ചെയ്തു: “ഒരു വർഷത്തിനകം, ഒരു കരാർ തൊഴിലാളി തന്റെ കാലാവധി കണക്കാക്കുന്നതുപോലെ, കേദാറിന്റെ എല്ലാ മഹത്ത്വവും പൊയ്പ്പോകും."]},{"type":"verse","number":17,"content":["കേദാര്യരിൽ, വില്ലാളിവീരന്മാരായ കേദാർ ജനതയുടെ കൂട്ടത്തിൽത്തന്നെ, അതിജീവിക്കുന്നവർ ചുരുക്കമായിരിക്കും.” ഇസ്രായേലിന്റെ ദൈവമായ യഹോവ അരുളിച്ചെയ്തിരിക്കുന്നു."]}],"footnotes":[{"noteId":29,"caller":"+","text":"ചി.കൈ.പ്ര. ഒരു സിംഹം","reference":{"chapter":21,"verse":8}},{"noteId":30,"caller":"+","text":"ദൂമാ എന്ന വാക്കിന്, നിശ്ശബ്ദത, സ്തബ്ധത എന്നർഥം.","reference":{"chapter":21,"verse":11}}]},"thisChapterLink":"/api/mal_bib/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}