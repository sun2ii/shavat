{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":24,"content":[{"type":"heading","content":["ഭൂമിയുടെ ശിക്ഷാവിധി"]},{"type":"verse","number":1,"content":[{"text":"ഇതാ, യഹോവ ഭൂമിയെ ശൂന്യവും","poem":1},{"text":"ജനവാസമില്ലാത്തതുമാക്കും;","poem":2},{"text":"അതിനെ കീഴ്‌മേൽ മറിക്കുകയും","poem":1},{"text":"അതിലെ നിവാസികളെ ചിതറിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അത് ഒരുപോലെ,","poem":1},{"text":"ജനങ്ങൾക്കെന്നപോലെ പുരോഹിതനും","poem":2},{"lineBreak":true},{"text":"ദാസന്മാർക്കെന്നപോലെ യജമാനനും","poem":2},{"lineBreak":true},{"text":"ദാസിക്കെന്നപോലെ യജമാനത്തിക്കും","poem":2},{"lineBreak":true},{"text":"വാങ്ങുന്നവർക്കെന്നപോലെ കൊടുക്കുന്നവർക്കും","poem":2},{"lineBreak":true},{"text":"കടം കൊടുക്കുന്നവർക്കെന്നപോലെ കടം വാങ്ങുന്നവർക്കും","poem":2},{"lineBreak":true},{"text":"പലിശ വാങ്ങുന്നവർക്കെന്നപോലെ പലിശ കൊടുക്കുന്നവർക്കും സംഭവിക്കും.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ഭൂമി ഒന്നാകെ ശൂന്യമായും","poem":1},{"text":"അതുമുഴുവനും കവർച്ചയായും പോകും.","poem":2},{"text":"യഹോവയാണ് ഈ വചനം അരുളിച്ചെയ്തിരിക്കുന്നത്.","poem":4}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ഭൂമി ഉണങ്ങി വാടിപ്പോകുന്നു,","poem":1},{"text":"ലോകം തളർന്നു വാടിപ്പോകുന്നു,","poem":2},{"lineBreak":true},{"text":"ഭൂമിയിലെ കുലീനരും തളർന്നുപോകുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ഭൂമി അതിലെ നിവാസികൾമൂലം ദുഷിക്കപ്പെട്ടിരിക്കുന്നു;","poem":1},{"text":"അവർ അവിടത്തെ നിയമങ്ങൾ അനുസരിക്കാതിരിക്കുകയും","poem":2},{"text":"നിയമവ്യവസ്ഥകൾ ലംഘിക്കുകയും","poem":1},{"text":"നിത്യ ഉടമ്പടി തകർക്കുകയും ചെയ്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"തന്മൂലം ഭൂമിയെ ശാപം വിഴുങ്ങി;","poem":1},{"text":"അതിലെ ജനം അവരുടെ കുറ്റം വഹിക്കേണ്ടിവരുന്നു.","poem":2},{"text":"അതുനിമിത്തം ഭൂവാസികൾ ദഹിച്ചുപോകുന്നു,","poem":1},{"text":"ചുരുക്കംപേർമാത്രം ശേഷിക്കുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"പുതുവീഞ്ഞ് വറ്റിപ്പോകുകയും മുന്തിരിവള്ളി വാടുകയുംചെയ്യുന്നു;","poem":1},{"text":"സന്തുഷ്ടഹൃദയമുള്ളവർ നെടുവീർപ്പിടുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"തപ്പുകളുടെ ആഹ്ലാദം നിലയ്ക്കുന്നു;","poem":1},{"text":"ഉല്ലസിക്കുന്നവരുടെ ഘോഷം നിന്നുപോകുന്നു,","poem":2},{"lineBreak":true},{"text":"വീണയുടെ ആനന്ദം ഇല്ലാതെയാകുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവർ പാട്ടോടെ വീഞ്ഞു കുടിക്കുന്നില്ല;","poem":1},{"text":"മദ്യം കുടിക്കുന്നവർക്ക് അതു കയ്‌പായിത്തീരുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"നശിപ്പിക്കപ്പെട്ട നഗരം വിജനമായിക്കിടക്കുന്നു;","poem":1},{"text":"ആരും പ്രവേശിക്കാതവണ്ണം എല്ലാ വീടും അടയ്ക്കപ്പെട്ടിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"തെരുവീഥികളിൽ അവർ വീഞ്ഞിനുവേണ്ടി നിലവിളിക്കുന്നു.","poem":1},{"text":"ആഹ്ലാദമെല്ലാം ഇരുണ്ടുപോയിരിക്കുന്നു,","poem":2},{"lineBreak":true},{"text":"ഭൂമിയിൽനിന്ന് ആനന്ദത്തിന്റെ എല്ലാ സ്വരങ്ങളും അപ്രത്യക്ഷമായിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"നഗരത്തിൽ ശൂന്യത അവശേഷിച്ചിരിക്കുന്നു,","poem":1},{"text":"നഗരകവാടം ഇടിച്ചുതകർത്തുകളഞ്ഞു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ഒലിവുമരത്തിൽനിന്നു കായ്കൾ ശേഖരിക്കുന്നതിനായി തല്ലുന്നതുപോലെയോ","poem":1},{"text":"മുന്തിരിപ്പഴം ശേഖരിച്ചശേഷം കാലാപെറുക്കുന്നതുപോലെയോ","poem":2},{"text":"ആയിരിക്കും ഭൂമിയിൽ","poem":1},{"text":"രാഷ്ട്രങ്ങൾക്കിടയിൽ സംഭവിക്കുന്നത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"അവർ ശബ്ദമുയർത്തുന്നു, ആനന്ദത്താൽ ആർപ്പിടുന്നു;","poem":1},{"text":"യഹോവയുടെ മഹത്ത്വത്തെപ്പറ്റി അവർ സമുദ്രത്തിൽനിന്ന്","poem":2},{"noteId":33},{"text":"വിളിച്ചുപറയുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അതിനാൽ കിഴക്കേദേശത്ത് യഹോവയ്ക്കു മഹത്ത്വംകൊടുക്കുക;","poem":1},{"text":"സമുദ്രതീരങ്ങളിൽ ഇസ്രായേലിന്റെ ദൈവമായ","poem":2},{"lineBreak":true},{"text":"യഹോവയുടെ നാമം ഉയർത്തുക.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“നീതിമാനായവനു","poem":1},{"noteId":34},{"text":"മഹത്ത്വം,” എന്ന ഗാനം","poem":1},{"text":"ഭൂമിയുടെ അറുതികളിൽനിന്ന് നാം കേൾക്കുന്നു.","poem":2},{"lineBreak":true},{"text":"എന്നാൽ ഞാൻ പറഞ്ഞു, “ഞാൻ ക്ഷയിച്ചുപോകുന്നു, ഞാൻ ക്ഷയിച്ചുപോകുന്നു!","poem":1},{"text":"എനിക്ക് അയ്യോ കഷ്ടം!","poem":2},{"text":"വഞ്ചകർ ഒറ്റുകൊടുക്കുന്നു.","poem":1},{"text":"അതേ, വഞ്ചകർ വഞ്ചനയോടെ ഒറ്റുകൊടുക്കുന്നു.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അല്ലയോ ഭൂവാസികളേ,","poem":1},{"text":"ഭീതിയും കുഴിയും കെണിയും നിനക്കു നേരിട്ടിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ഭീകരതയുടെ ശബ്ദംകേട്ട് ഓടിപ്പോകുന്നവർ","poem":1},{"text":"കുഴിയിൽ വീഴും;","poem":2},{"text":"കുഴിയിൽനിന്ന് കയറുന്നവർ","poem":1},{"text":"കെണിയിൽ അകപ്പെടും.","poem":2},{"lineBreak":true},{"text":"ആകാശത്തിലെ ജാലകങ്ങൾ","poem":1},{"noteId":35},{"text":"തുറന്നിരിക്കുന്നു,","poem":1},{"text":"ഭൂമിയുടെ അടിസ്ഥാനങ്ങൾ കുലുങ്ങുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ഭൂമി ചെറിയകഷണങ്ങളായി തകരുന്നു,","poem":1},{"text":"ഭൂമി പൊട്ടിപ്പിളരുന്നു,","poem":2},{"lineBreak":true},{"text":"ഭൂമി അതിതീവ്രമായി കുലുങ്ങുന്നു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ഭൂമി മദ്യപനെപ്പോലെ ചാഞ്ചാടുന്നു,","poem":1},{"text":"അത് കാറ്റിൽ ഒരു കുടിൽപോലെ ഇളകിയാടുന്നു;","poem":2},{"text":"അതിന്റെ അതിക്രമം അതിന്മേൽ അതിഭാരമായിരിക്കുന്നു,","poem":1},{"text":"അതു വീണുപോകും—ഇനിയൊരിക്കലും എഴുന്നേൽക്കുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"അന്നാളിൽ യഹോവ","poem":1},{"text":"ഉയരത്തിൽ ആകാശത്തിലെ സൈന്യത്തെയും","poem":2},{"lineBreak":true},{"text":"താഴേ ഭൂമിയിലെ രാജാക്കന്മാരെയും ശിക്ഷിക്കും.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"കാരാഗൃഹത്തിൽ തടവുകാരെയെന്നപോലെ","poem":1},{"text":"അവർ ഒരുമിച്ചുകൂട്ടപ്പെടും;","poem":2},{"text":"അവർ കാരാഗൃഹത്തിൽ അടയ്ക്കപ്പെടുകയും","poem":1},{"text":"അനേകം ദിവസങ്ങൾക്കുശേഷം ശിക്ഷിക്കപ്പെടുകയും ചെയ്യും.","poem":2},{"noteId":36}]},{"type":"verse","number":23,"content":[{"text":"അന്നു ചന്ദ്രൻ വിളറിപ്പോകും;","poem":1},{"text":"സൂര്യൻ ലജ്ജിക്കും;","poem":2},{"text":"സൈന്യങ്ങളുടെ യഹോവ സീയോൻപർവതത്തിലും","poem":1},{"text":"ജെറുശലേമിലും വാഴും.","poem":2},{"lineBreak":true},{"text":"തന്റെ ജനത്തിന്റെ നേതാക്കന്മാരുടെമുമ്പിൽ സകലപ്രതാപത്തോടുംകൂടെത്തന്നെ.","poem":2}]}],"footnotes":[{"noteId":33,"caller":"+","text":"അഥവാ, പശ്ചിമദിക്കിൽനിന്ന്","reference":{"chapter":24,"verse":14}},{"noteId":34,"caller":"+","text":"നീതിമാനായവനു, വിവക്ഷിക്കുന്നത് നീതിനിഷ്ഠൻ അഥവാ, ദൈവം.","reference":{"chapter":24,"verse":16}},{"noteId":35,"caller":"+","text":"അതായത്, പ്രളയംപോലെ വിനാശം വർഷിക്കപ്പെടും.","reference":{"chapter":24,"verse":18}},{"noteId":36,"caller":"+","text":"അഥവാ, മോചിപ്പിക്കപ്പെടുകയും ചെയ്യും","reference":{"chapter":24,"verse":22}}]},"thisChapterLink":"/api/mal_bib/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}