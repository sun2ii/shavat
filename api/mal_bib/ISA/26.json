{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":26,"content":[{"type":"heading","content":["സ്തോത്രഗാനം"]},{"type":"verse","number":1,"content":["ആ കാലത്ത് യെഹൂദ്യയിൽ ഈ ഗാനം ആലപിക്കപ്പെടും:",{"text":"ഞങ്ങൾക്ക് ഉറപ്പുള്ളൊരു നഗരമുണ്ട്;","poem":1},{"text":"ദൈവം രക്ഷ അതിന്റെ","poem":2},{"lineBreak":true},{"text":"കോട്ടകളും പ്രതിരോധസന്നാഹങ്ങളും ആക്കുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"വിശ്വാസം കാക്കുന്ന നീതിനിഷ്ഠരായ ജനത","poem":1},{"text":"പ്രവേശിക്കേണ്ടതിന്","poem":2},{"lineBreak":true},{"text":"അതിന്റെ കവാടങ്ങൾ തുറക്കുക.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"സ്ഥിരമാനസൻ അങ്ങയിൽ","poem":1},{"text":"ആശ്രയിച്ചിരിക്കുകയാൽ","poem":2},{"lineBreak":true},{"text":"അങ്ങ് അവരെ പൂർണസമാധാനത്തിൽ കാക്കും.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"യഹോവയിൽത്തന്നെ എന്നേക്കും ആശ്രയം വെക്കുക","poem":1},{"text":"യഹോവ, യഹോവതന്നെ ശാശ്വതമായൊരു പാറ ആണല്ലോ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"മലകളിൽ പാർക്കുന്നവരെ അവിടന്ന് താഴ്ത്തുന്നു,","poem":1},{"text":"ഉന്നത നഗരങ്ങളെ അവിടന്നു താഴെയിറക്കുന്നു;","poem":2},{"text":"അവിടന്ന് അതിനെ നിലംപരിചാക്കി","poem":1},{"text":"പൊടിയിൽ വീഴ്ത്തിക്കളയുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"കാൽ അതിനെ ചവിട്ടിക്കളയും;","poem":1},{"text":"പീഡിതരുടെ കാലുകൾ,","poem":2},{"lineBreak":true},{"text":"അശരണരുടെയും കാലുകൾതന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"നീതിനിഷ്ഠരുടെ വഴി നിരപ്പായതുതന്നെ;","poem":1},{"text":"നീതിനിഷ്ഠനായ ദൈവമേ, അങ്ങ് നീതിമാന്റെ വഴി നേരേയാക്കും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അതേ, യഹോവേ, അങ്ങയുടെ നിയമങ്ങൾക്കനുസൃതമായി","poem":1},{"noteId":38},{"text":"ജീവിച്ച്,","poem":1},{"text":"ഞങ്ങൾ അങ്ങേക്കായി കാത്തിരുന്നു;","poem":2},{"text":"അങ്ങയുടെ നാമവും സ്മരണയും,","poem":1},{"text":"ഞങ്ങളുടെ ഹൃദയവാഞ്ഛയാകുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"രാത്രിയിൽ ഞാൻ അങ്ങേക്കായി കാത്തിരിക്കുന്നു;","poem":1},{"text":"പ്രഭാതത്തിൽ എന്റെ ആത്മാവ് അങ്ങയെ അന്വേഷിക്കുന്നു.","poem":2},{"text":"അങ്ങയുടെ ന്യായവിധികൾ ഭൂമിയിൽ നടപ്പിലാക്കുമ്പോൾ","poem":1},{"text":"ഭൂവാസികൾ നീതി അഭ്യസിക്കും.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"എന്നാൽ ദുഷ്ടരോടു കരുണ കാണിച്ചാലും,","poem":1},{"text":"അവർ നീതി അഭ്യസിക്കുകയില്ല;","poem":2},{"text":"നീതിനിഷ്ഠരുടെ ദേശത്ത് അവർ ദുഷ്ടത പ്രവർത്തിച്ചുകൊണ്ടിരിക്കുന്നു;","poem":1},{"text":"യഹോവയുടെ മഹത്ത്വം അവർ കാണുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"യഹോവേ, അങ്ങയുടെ കരം ഉയർന്നിരിക്കുന്നു,","poem":1},{"text":"എങ്കിലും അവർ അതു കാണുന്നില്ല.","poem":2},{"text":"അങ്ങയുടെ ജനത്തോടുള്ള അവിടത്തെ തീക്ഷ്ണത അവർ കണ്ടു ലജ്ജിക്കട്ടെ;","poem":1},{"text":"അങ്ങയുടെ ശത്രുക്കൾക്കായുള്ള അഗ്നി അവരെ ദഹിപ്പിച്ചുകളയട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"യഹോവേ, ഞങ്ങളുടെ സകലപ്രവൃത്തികളും അങ്ങ് ഞങ്ങൾക്കുവേണ്ടി ചെയ്തുതന്നിരിക്കുകയാൽ,","poem":1},{"text":"അങ്ങ് ഞങ്ങൾക്കു സമാധാനം സ്ഥാപിക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ഞങ്ങളുടെ ദൈവമായ യഹോവേ, അങ്ങല്ലാതെയുള്ള മറ്റു യജമാനന്മാർ ഞങ്ങളെ ഭരിച്ചിട്ടുണ്ട്,","poem":1},{"text":"എങ്കിലും അങ്ങയെ, അങ്ങയുടെ നാമംമാത്രമാണ് ഞങ്ങൾക്ക് ആരാധ്യമായത്.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവർ ഇപ്പോൾ മരിച്ചവരാണ്, ഇനിയൊരിക്കലും ജീവിക്കുകയില്ല;","poem":1},{"text":"അവർ വെറും നിഴൽ, ഇനി ഉയിർത്തെഴുന്നേൽക്കുകയുമില്ല.","poem":2},{"text":"അങ്ങ് അവരെ ശിക്ഷിക്കുകയും നശിപ്പിക്കുകയും ചെയ്തിരിക്കുന്നു;","poem":1},{"text":"അവരുടെ ഓർമയെ മുഴുവനായും അങ്ങ് തുടച്ചുനീക്കിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"യഹോവേ, അങ്ങ് ജനത്തെ വർധിപ്പിച്ചു;","poem":1},{"text":"അതേ, തന്റെ ജനത്തെ വർധിപ്പിച്ചിരിക്കുന്നു.","poem":2},{"text":"അങ്ങ് അങ്ങേക്കുതന്നെ മഹത്ത്വം നേടിയിരിക്കുന്നു;","poem":1},{"text":"ദേശത്തിന്റെ അതിരുകളെല്ലാം അങ്ങ് വിസ്തൃതമാക്കിയിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"യഹോവേ, അവർ കഷ്ടതയിൽ അങ്ങയെ അന്വേഷിച്ചു;","poem":1},{"text":"അവിടത്തെ ശിക്ഷ അവരുടെമേൽ വീണപ്പോൾ","poem":2},{"lineBreak":true},{"text":"ഒരു യാചന അങ്ങയുടെമുമ്പിൽ പകരുന്നതിനേ അവർക്കു കഴിഞ്ഞുള്ളൂ.","poem":2},{"noteId":39}]},{"type":"verse","number":17,"content":[{"text":"യഹോവേ, ഗർഭിണിക്കു പ്രസവസമയമടുക്കുമ്പോൾ","poem":1},{"text":"അവൾ വേദനകൊണ്ടു പുളയുകയും നിലവിളിക്കുകയുംചെയ്യുന്നു","poem":2},{"lineBreak":true},{"text":"അതുപോലെ ആയിരുന്നു അവിടത്തെ മുമ്പിൽ ഞങ്ങളുടെ അവസ്ഥ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ഞങ്ങൾ ഗർഭംധരിച്ചു, ഞങ്ങൾ പ്രസവവേദനകൊണ്ട് പുളഞ്ഞു,","poem":1},{"text":"എന്നാൽ ഞങ്ങൾ പ്രസവിച്ചത് വെറും കാറ്റ് ആയിരുന്നു.","poem":2},{"text":"ദേശത്തിന് ഒരു രക്ഷയും ഞങ്ങൾ വരുത്തിയില്ല,","poem":1},{"text":"ഭൂവാസികൾ ജീവനിലേക്കു വന്നതുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"അങ്ങയുടെ മൃതന്മാർ ജീവിക്കും;","poem":1},{"text":"അവരുടെ ശവങ്ങൾ എഴുന്നേൽക്കും—","poem":2},{"text":"പൊടിയിൽ അധിവസിക്കുന്നവരേ,","poem":1},{"text":"ഉണർന്ന് ആനന്ദത്താൽ ആർപ്പിടുവിൻ.","poem":2},{"text":"നിങ്ങളുടെ മഞ്ഞ് പ്രഭാതത്തിലെ തുഷാരബിന്ദുക്കൾപോലെയാണ്;","poem":1},{"text":"ഭൂമി അവളുടെ മൃതരുടെ ആത്മാക്കളെ വീണ്ടും ജീവിപ്പിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"എന്റെ ജനമേ, വന്നു നിങ്ങളുടെ അറകളിൽ പ്രവേശിച്ച്","poem":1},{"text":"വാതിലുകൾ അടയ്ക്കുക;","poem":2},{"text":"ക്രോധം നിങ്ങളെ കടന്നുപോകുന്നതുവരെ,","poem":1},{"text":"അൽപ്പനേരത്തേക്ക് ഒളിച്ചുകൊൾക.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ഇതാ, യഹോവ ഭൂവാസികൾക്ക് അവരുടെ പാപങ്ങൾക്കുള്ള ശിക്ഷനൽകാൻ","poem":1},{"text":"തന്റെ നിവാസസ്ഥാനത്തുനിന്നും വരുന്നതിനുള്ള സമയം അടുത്തിരിക്കുന്നു.","poem":2},{"text":"ഭൂമി തന്റെമേൽ ചൊരിയപ്പെട്ട രക്തമൊക്കെയും വെളിപ്പെടുത്തും,","poem":1},{"text":"തന്റെ കൊല്ലപ്പെട്ടവരെ ഇനിമേൽ മറച്ചുവെക്കുകയുമില്ല.","poem":2}]}],"footnotes":[{"noteId":38,"caller":"+","text":"അഥവാ, ന്യായവിധികൾക്കനുസൃതമായി","reference":{"chapter":26,"verse":8}},{"noteId":39,"caller":"+","text":"ഈ വാക്യഭാഗത്തിനുള്ള എബ്രായപദങ്ങളുടെ അർഥം വ്യക്തമല്ല.","reference":{"chapter":26,"verse":16}}]},"thisChapterLink":"/api/mal_bib/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}