{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":31,"content":[{"type":"heading","content":["ഈജിപ്റ്റിനെ ആശ്രയിക്കുന്നവർക്കു ഹാ കഷ്ടം"]},{"type":"verse","number":1,"content":[{"text":"സഹായത്തിനായി ഈജിപ്റ്റിലേക്കു പോകുകയും","poem":1},{"text":"കുതിരകളെ ആശ്രയിക്കുകയും","poem":2},{"text":"അവരുടെ അനവധി രഥങ്ങളിലും","poem":1},{"text":"കുതിരച്ചേവകരുടെ ശക്തിയിലും വിശ്വാസമർപ്പിച്ചിട്ട്","poem":2},{"text":"ഇസ്രായേലിന്റെ പരിശുദ്ധനിലേക്കു നോക്കാതെയും","poem":1},{"text":"യഹോവയുടെ സഹായം അന്വേഷിക്കാതെയുമിരിക്കുന്നവർക്കു ഹാ കഷ്ടം.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"എങ്കിലും അവിടന്ന് ജ്ഞാനിയാണ്, അവിടന്ന് അനർഥംവരുത്തും;","poem":1},{"text":"അവിടന്ന് തന്റെ വാക്കുകൾ പിൻവലിക്കുകയില്ല.","poem":2},{"text":"അവിടന്ന് ആ ദുഷ്ടരാഷ്ട്രത്തിനെതിരേ എഴുന്നേൽക്കും,","poem":1},{"text":"അധർമികളെ സഹായിക്കുന്ന അവർക്കെതിരേതന്നെ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"കാരണം ഈജിപ്റ്റുകാർ ദൈവമല്ല, കേവലം മനുഷ്യരാണ്;","poem":1},{"text":"അവരുടെ കുതിരകൾ ആത്മാവല്ല, മൂപ്പെത്താത്ത മാംസംമാത്രം.","poem":2},{"text":"യഹോവ തന്റെ കരം നീട്ടുമ്പോൾ,","poem":1},{"text":"സഹായകർ ഇടറുകയും","poem":2},{"lineBreak":true},{"text":"സഹായം സ്വീകരിക്കുന്നവർ വീഴുകയും ചെയ്യും;","poem":2},{"lineBreak":true},{"text":"അവരെല്ലാം ഒരുമിച്ചുതന്നെ നശിക്കും.","poem":2}]},{"type":"verse","number":4,"content":["യഹോവ എന്നോട് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:",{"text":"“ഒരു സിംഹം മുരളുമ്പോൾ,","poem":1},{"text":"ഒരു സിംഹക്കുട്ടി അതിന്റെ ഇര കണ്ടു മുരളുമ്പോൾ,","poem":2},{"text":"ഒരു ഇടയക്കൂട്ടത്തെ അതിനുനേരേ","poem":1},{"text":"വിളിച്ചുകൂട്ടിയാൽപോലും,","poem":2},{"text":"അത് അവരുടെ ആർപ്പുവിളി കേട്ടു ഭയപ്പെടുകയോ","poem":1},{"text":"അവരുടെ ആരവത്താൽ പരിഭ്രമിക്കുകയോ ചെയ്യുകയില്ല.","poem":2},{"text":"അതുപോലെ സൈന്യങ്ങളുടെ യഹോവ സീയോൻപർവതത്തിലും","poem":1},{"text":"അതിലെ മലയിലും യുദ്ധംചെയ്യാൻ ഇറങ്ങിവരും.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"വട്ടമിട്ടു പറക്കുന്ന പക്ഷിയെപ്പോലെ","poem":1},{"text":"സൈന്യങ്ങളുടെ യഹോവ ജെറുശലേമിനെ സംരക്ഷിക്കും;","poem":2},{"text":"അവിടന്ന് അതിനെ കാക്കുകയും വിടുവിക്കുകയും ചെയ്യും,","poem":1},{"text":"അവിടന്ന് അതിനെ ‘കടന്നുപോകുകയും’","poem":2},{"noteId":46},{"text":"മോചിപ്പിക്കുകയും ചെയ്യും.”","poem":2}]},{"type":"verse","number":6,"content":["ഇസ്രായേൽജനമേ, മടങ്ങിവരിക, നിങ്ങൾ കഠിനമായി മത്സരിച്ച ദൈവത്തിലേക്കുതന്നെ മടങ്ങിവരിക."]},{"type":"verse","number":7,"content":["കാരണം ആ ദിവസത്തിൽ പാപംനിറഞ്ഞ നിങ്ങളുടെ കൈകൾ നിർമിച്ച വെള്ളിവിഗ്രഹങ്ങളെയും സ്വർണവിഗ്രഹങ്ങളെയും നിങ്ങൾ എല്ലാവരും എറിഞ്ഞുകളയും."]},{"type":"verse","number":8,"content":[{"text":"“അന്ന് അശ്ശൂർ അമാനുഷികമായ വാളിനാൽ വീഴും;","poem":1},{"text":"മർത്യരുടേതല്ലാത്ത ഒരു വാൾ അവരെ വിഴുങ്ങും.","poem":2},{"text":"ഈ വാളിൽനിന്ന് അവൻ രക്ഷപ്പെടുകയില്ല,","poem":1},{"text":"അവരുടെ യുവാക്കൾ അടിമകളായിത്തീരും.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഭീതിനിമിത്തം അവരുടെ കോട്ടകൾ നിലംപൊത്തും;","poem":1},{"text":"യുദ്ധക്കൊടികണ്ട് അവരുടെ സൈന്യാധിപന്മാർ സംഭ്രമിക്കും,”","poem":2},{"text":"എന്ന് സീയോനിൽ തീയും","poem":1},{"text":"ജെറുശലേമിൽ ചൂളയുമുള്ള","poem":2},{"lineBreak":true},{"text":"യഹോവ അരുളിച്ചെയ്യുന്നു.","poem":2}]}],"footnotes":[{"noteId":46,"caller":"+","text":"ഈ വാക്ക് പെസഹായെ അനുസ്മരിപ്പിക്കുന്നു.","reference":{"chapter":31,"verse":5}}]},"thisChapterLink":"/api/mal_bib/ISA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/30.json","previousChapterAudioLinks":{},"numberOfVerses":9}