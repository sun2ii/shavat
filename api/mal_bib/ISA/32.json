{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":32,"content":[{"type":"heading","content":["നീതിയുടെ രാജാവ്"]},{"type":"verse","number":1,"content":[{"text":"ഇതാ, ഒരു രാജാവ് നീതിപൂർവം ഭരിക്കും,","poem":1},{"text":"ഭരണാധിപന്മാർ ന്യായത്തോടെ അധികാരം നടപ്പിലാക്കും.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ഓരോരുത്തനും കാറ്റിൽനിന്നുള്ള ഒരഭയസ്ഥാനവും","poem":1},{"text":"കൊടുങ്കാറ്റിൽനിന്നുള്ള രക്ഷാസങ്കേതവും ആയിത്തീരും,","poem":2},{"text":"അവർ മരുഭൂമിയിൽ നീർത്തോടുകൾപോലെയും","poem":1},{"text":"വരണ്ടുണങ്ങിയ ദേശത്ത് വൻപാറയുടെ നിഴൽപോലെയും ആയിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"കാണുന്നവരുടെ കണ്ണുകൾ അന്ന് അന്ധമാകുകയില്ല;","poem":1},{"text":"ചെവിയുള്ളവർക്കെല്ലാം അതു കേൾക്കാൻ കഴിയും.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"തിടുക്കമുള്ള","poem":1},{"noteId":47},{"text":"ഹൃദയം പരിജ്ഞാനം ഗ്രഹിക്കും;","poem":1},{"text":"വിക്കുള്ള നാവ് തെളിവായി സംസാരിക്കും.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ഭോഷരെ ഇനിയൊരിക്കലും ശ്രേഷ്ഠരെന്നു വിളിക്കുകയോ","poem":1},{"text":"ആഭാസരെ മാന്യരെന്നവണ്ണം ആദരിക്കുകയോ ഇല്ല.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഭോഷർ ഭോഷത്തം സംസാരിക്കും,","poem":1},{"text":"അവരുടെ ഹൃദയം ദുഷ്ടത ആസൂത്രണംചെയ്യുന്നു:","poem":2},{"text":"അവർ ഭക്തർക്കു ചേരാത്ത പ്രവൃത്തികൾചെയ്യുന്നു;","poem":1},{"text":"യഹോവയെ ദുഷിച്ചു സംസാരിക്കുകയും","poem":2},{"text":"വിശപ്പുള്ളവരെ പട്ടിണിയിടുകയും","poem":1},{"text":"ദാഹമുള്ളവർക്കു പാനീയം നിഷേധിക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ആഭാസരുടെ ആയുധങ്ങൾ ദുഷ്ടതനിറഞ്ഞതാണ്;","poem":1},{"text":"ദരിദ്രരുടെ അപേക്ഷ ന്യായമായത് ആണെങ്കിൽത്തന്നെയും","poem":2},{"text":"പീഡിതരെ വഞ്ചനയിലൂടെ നശിപ്പിക്കുന്നതിന്","poem":1},{"text":"അവർ ദുരുപായങ്ങൾ ആലോചിക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"എന്നാൽ കുലീനൻ ഉത്തമകാര്യങ്ങൾ ആസൂത്രണം ചെയ്യുകയും","poem":1},{"text":"വിശിഷ്ടമായ പ്രവൃത്തികളിൽ ഉറച്ചുനിൽക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"heading","content":["ജെറുശലേമിലെ സ്ത്രീകൾ"]},{"type":"verse","number":9,"content":[{"text":"അലംഭാവമുള്ള സ്ത്രീകളേ,","poem":1},{"text":"എഴുന്നേറ്റ് എന്റെ വാക്കു കേൾക്കുക;","poem":2},{"text":"സുരക്ഷിതർ എന്നു കരുതുന്ന പുത്രിമാരേ,","poem":1},{"text":"എന്റെ വചനം ശ്രദ്ധിക്കുക.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ഒരു വർഷവും ഏതാനും ദിവസവും കഴിയുമ്പോഴേക്കും","poem":1},{"text":"സുരക്ഷിതർ എന്നു കരുതുന്ന നിങ്ങൾ ഭയന്നുവിറയ്ക്കും.","poem":2},{"text":"മുന്തിരിയുടെ വിളവു മുടങ്ങും,","poem":1},{"text":"ഫലശേഖരണം ഉണ്ടാകുകയുമില്ല.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അലംഭാവമുള്ള സ്ത്രീകളേ, ഞെട്ടിവിറയ്ക്കുക;","poem":1},{"text":"സുരക്ഷിതരെന്നു കരുതുന്ന പുത്രിമാരേ, നടുങ്ങുക!","poem":2},{"text":"മൃദുലവസ്ത്രങ്ങൾ ഉരിഞ്ഞെറിയുക,","poem":1},{"text":"പരുപരുത്തവസ്ത്രങ്ങൾ ഉടുക്കുക.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"സന്തുഷ്ടമായ വയലുകളും","poem":1},{"text":"ഫലപുഷ്ടിയുള്ള മുന്തിരിവള്ളികളും ഓർത്ത് മാറത്തടിച്ചു വിലപിക്കുക.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"മുള്ളും പറക്കാരയും അമിതമായി വളർന്നുനിൽക്കുന്ന","poem":1},{"text":"എന്റെ ജനത്തിന്റെ വയലിനെച്ചൊല്ലി,","poem":2},{"text":"അതേ, ഉല്ലാസഭവനങ്ങളെ ഓർത്തു വിലപിക്കുക,","poem":1},{"text":"അഴിഞ്ഞാടുന്ന നഗരങ്ങളെച്ചൊല്ലിത്തന്നെ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"കെട്ടിയുറപ്പിക്കപ്പെട്ട കോട്ടകൾ ഉപേക്ഷിക്കപ്പെടും,","poem":1},{"text":"ജനനിബിഡമായ നഗരം വിജനമാക്കപ്പെടും;","poem":2},{"text":"രാജധാനിയും കാവൽഗോപുരവും എന്നേക്കുമായി തരിശുനിലമായി മാറും,","poem":1},{"text":"കാട്ടുകഴുതകളുടെ വിലാസരംഗവും ആടുകളുടെ മേച്ചിൽസ്ഥലവുമായി മാറും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഉയരത്തിൽനിന്ന് നമ്മുടെമേൽ ആത്മാവിനെ പകരുകയും","poem":1},{"text":"മരുഭൂമി ഫലപുഷ്ടിയുള്ള വയലായും","poem":2},{"lineBreak":true},{"text":"വയൽ വനമായും മാറുകയും ചെയ്യുന്നതുവരെത്തന്നെ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അപ്പോൾ മരുഭൂമിയിൽ ദൈവത്തിന്റെ ന്യായം വസിക്കും,","poem":1},{"text":"ഫലപുഷ്ടിയുള്ള ഉദ്യാനത്തിൽ നീതി കുടിപാർക്കും.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"നീതിയുടെ ഫലം സമാധാനവും","poem":1},{"text":"അതിന്റെ പരിണതഫലം ശാശ്വതമായ ശാന്തതയും സുരക്ഷിതത്വവും ആയിരിക്കും.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അന്ന് എന്റെ ജനം സമാധാനഭവനത്തിലും","poem":1},{"text":"സുരക്ഷിതമായ വസതികളിലും","poem":2},{"lineBreak":true},{"text":"പ്രശാന്തമായ വിശ്രമസങ്കേതങ്ങളിലും പാർക്കും.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"കന്മഴ ചൊരിഞ്ഞ് വനം നശിക്കുകയും","poem":1},{"text":"നഗരം നിശ്ശേഷം നിലംപരിചാകുകയും ചെയ്താലും,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"എല്ലാ നീരുറവകൾക്കുമരികെ വിത്തുവിതയ്ക്കാൻ കഴിയുകയും","poem":1},{"text":"കന്നുകാലികളെയും കഴുതകളെയും തൊഴുത്തിൽനിന്ന് അഴിച്ചുവിടാൻ കഴിയുകയുംചെയ്യുന്ന","poem":2},{"lineBreak":true},{"text":"നിങ്ങൾ എത്ര അനുഗൃഹീതർ!","poem":2}]}],"footnotes":[{"noteId":47,"caller":"+","text":"അതായത്, ഭയമുള്ള","reference":{"chapter":32,"verse":4}}]},"thisChapterLink":"/api/mal_bib/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}