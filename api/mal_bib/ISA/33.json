{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":33,"content":[{"type":"heading","content":["വൈഷമ്യവും സഹായവും"]},{"type":"verse","number":1,"content":[{"text":"സ്വയം നശിപ്പിക്കപ്പെടാതെ","poem":1},{"text":"വിനാശം വിതയ്ക്കുന്നവനേ, നിനക്കു ഹാ കഷ്ടം","poem":2},{"text":"സ്വയം വഞ്ചിക്കപ്പെടാതെ","poem":1},{"text":"വിശ്വാസവഞ്ചനചെയ്യുന്നവനേ, നിനക്കു ഹാ കഷ്ടം!","poem":2},{"text":"നീ നശിപ്പിക്കുന്നതു നിർത്തുമ്പോൾ,","poem":1},{"text":"നീയും നശിപ്പിക്കപ്പെടും;","poem":2},{"text":"നീ വഞ്ചിക്കുന്നതു നിർത്തുമ്പോൾ,","poem":1},{"text":"നീയും വഞ്ചിക്കപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"യഹോവേ, ഞങ്ങളോടു കനിവുണ്ടാകണമേ,","poem":1},{"text":"ഞങ്ങൾ അങ്ങേക്കായി കാത്തിരിക്കുന്നു.","poem":2},{"text":"ഓരോ പ്രഭാതത്തിലും അങ്ങ് ഞങ്ങളുടെ ബലവും","poem":1},{"text":"കഷ്ടതയിൽ ഞങ്ങളുടെ രക്ഷയും ആയിരിക്കണമേ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അങ്ങയുടെ സൈന്യത്തിന്റെ ആരവത്താൽ ജനതകൾ പലായനംചെയ്യുന്നു;","poem":1},{"text":"അങ്ങ് എഴുന്നേൽക്കുമ്പോൾ രാഷ്ട്രങ്ങൾ ചിതറിപ്പോകുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"വെട്ടുക്കിളി തിന്നുന്നതുപോലെ നിന്റെ കവർച്ച ശേഖരിക്കപ്പെടുന്നു;","poem":1},{"text":"വെട്ടുക്കിളിക്കൂട്ടം പറന്നിറങ്ങുന്നതുപോലെ മനുഷ്യർ അതിന്മേൽ ചാടിവീഴുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"യഹോവ ഉന്നതൻ, അവിടന്ന് ഉയരത്തിൽ വസിക്കുന്നു;","poem":1},{"text":"അവിടന്ന് സീയോനെ ന്യായത്താലും നീതിയാലും നിറയ്ക്കും.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവിടന്ന് നിന്റെ കാലത്തിന്റെ സുസ്ഥിരമായ അടിസ്ഥാനമായിരിക്കും,","poem":1},{"text":"അന്ന് ജ്ഞാനം, പരിജ്ഞാനം, ബലം, രക്ഷ ഇവയുടെ സമൃദ്ധമായ നിക്ഷേപം ആയിരിക്കും;","poem":2},{"lineBreak":true},{"text":"യഹോവാഭക്തി ഈ നിക്ഷേപത്തിന്റെ താക്കോലായിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ഇതാ, അവരുടെ ധീരന്മാർ വീഥികളിൽ നിലവിളിക്കുന്നു;","poem":1},{"text":"സമാധാനദൂതന്മാർ പൊട്ടിക്കരയുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"രാജവീഥികൾ വിജനമായിത്തീർന്നു,","poem":1},{"text":"യാത്രക്കാർ ആരുംതന്നെ വഴിയിൽ കാണുന്നില്ല.","poem":2},{"text":"ഉടമ്പടി ലംഘിക്കപ്പെട്ടിരിക്കുന്നു,","poem":1},{"text":"അതിന്റെ സാക്ഷികൾ","poem":2},{"noteId":48},{"text":"നിന്ദിക്കപ്പെട്ടിരിക്കുന്നു,","poem":2},{"lineBreak":true},{"text":"ആരുംതന്നെ ആദരിക്കപ്പെടുന്നില്ല.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ദേശം ഉണങ്ങിവരണ്ടിരിക്കുന്നു,","poem":1},{"text":"ലെബാനോൻ ലജ്ജിച്ചു വാടിപ്പോകുന്നു;","poem":2},{"text":"ശാരോൻ മരുഭൂമിപോലെ ആയിരിക്കുന്നു,","poem":1},{"text":"ബാശാനും കർമേലും ഇലപൊഴിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ഇപ്പോൾ ഞാൻ എഴുന്നേൽക്കും,” യഹോവ അരുളിച്ചെയ്യുന്നു.","poem":1},{"text":"“ഇപ്പോൾ ഞാൻ മഹത്ത്വീകരിക്കപ്പെടും;","poem":2},{"lineBreak":true},{"text":"ഇപ്പോൾ ഞാൻ ഉയർത്തപ്പെടും.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"നിങ്ങൾ പതിർ ഗർഭംധരിച്ച്","poem":1},{"text":"വൈക്കോൽ പ്രസവിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"നിങ്ങളുടെ ശ്വാസംതന്നെ നിങ്ങളെ ദഹിപ്പിക്കുന്ന അഗ്നിയായി മാറും.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"കുമ്മായം നീറ്റപ്പെടുന്നതുപോലെ ജനതകൾ നീറി ദഹിക്കും;","poem":1},{"text":"വെട്ടിക്കളഞ്ഞ മുൾപ്പടർപ്പുപോലെ അവർ തീയിടപ്പെടും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ദൂരസ്ഥരേ, ഞാൻ ചെയ്തതു കേൾക്കുക;","poem":1},{"text":"സമീപസ്ഥരേ, എന്റെ ശക്തി അംഗീകരിക്കുക!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"സീയോനിലെ പാപികൾ ഭയപ്പെടുന്നു;","poem":1},{"text":"അഭക്തർക്കു വിറയൽ ബാധിച്ചിരിക്കുന്നു:","poem":2},{"text":"“നമ്മിൽ ആർക്ക്, ദഹിപ്പിക്കുന്ന അഗ്നിയോടൊപ്പം പാർക്കാൻ കഴിയും?","poem":1},{"text":"നമ്മിൽ ആർക്ക് നിത്യജ്വാലയോടൊപ്പം വസിക്കാൻ കഴിയും?”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"നീതിയോടെ ജീവിക്കുകയും","poem":1},{"text":"സത്യം സംസാരിക്കുകയും ചെയ്യുന്നവർ,","poem":2},{"text":"കൊള്ളപ്പണത്തിലുള്ള നേട്ടം വെറുക്കുന്നവർ,","poem":1},{"text":"കോഴവാങ്ങാതെ കൈകൾ സൂക്ഷിക്കുന്നവർ,","poem":2},{"text":"രക്തപാതകത്തെപ്പറ്റി കേൾക്കുകപോലും ചെയ്യാതെ ചെവിപൊത്തുന്നവർ,","poem":1},{"text":"ദോഷത്തെ നോക്കാതെ തന്റെ കണ്ണ് അടച്ചുകളയുന്നവർ—","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അവരാണ് ഉയരങ്ങളിൽ വസിക്കുന്നത്,","poem":1},{"text":"അവരുടെ അഭയസ്ഥാനം പാറയിൽ തീർത്ത കോട്ടകൾ ആയിരിക്കും.","poem":2},{"text":"അവരുടെ അപ്പം അവർക്കു ലഭിക്കും,","poem":1},{"text":"അവരുടെ വെള്ളം മുടങ്ങിപ്പോകുകയുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"നിന്റെ കണ്ണ് രാജാവിനെ തന്റെ സൗന്ദര്യത്തിൽ ദർശിക്കും,","poem":1},{"text":"വിദൂരസ്ഥമായൊരു ദേശം നീ കാണുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“പണം എണ്ണിനോക്കിയവർ എവിടെ?","poem":1},{"text":"കപ്പം","poem":2},{"noteId":49},{"text":"തൂക്കിനോക്കിയവർ എവിടെ?","poem":2},{"text":"ഗോപുരങ്ങൾക്ക് അധികാരി ആയിരുന്നവർ എവിടെ?”","poem":1},{"text":"എന്നിങ്ങനെ നിങ്ങളുടെ ഹൃദയം ഭീതിവിഷയങ്ങളെപ്പറ്റി ചിന്തിക്കും.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ആരും ഗ്രഹിക്കാത്ത സംഭാഷണവും","poem":1},{"text":"അപരിചിതവും മനസ്സിലാക്കാൻ പ്രയാസമുള്ള ഭാഷയുമുള്ള","poem":2},{"lineBreak":true},{"text":"ക്രൂരജനത്തെ നീ ഇനി കാണുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"നമ്മുടെ ഉത്സവനഗരമായ സീയോനെ നോക്കുക;","poem":1},{"text":"നിന്റെ കണ്ണുകൾ ജെറുശലേമിനെ ശാന്തനിവാസസ്ഥാനമായിക്കാണും,","poem":2},{"lineBreak":true},{"text":"അതിലെ കൂടാരങ്ങൾ മാറ്റപ്പെടുകയില്ല;","poem":2},{"text":"അതിന്റെ അതിരിലെ കുറ്റികൾ ഊരിമാറ്റപ്പെടുകയോ","poem":1},{"text":"അതിന്റെ കയറുകൾ പൊട്ടിപ്പോകുകയോ ഇല്ല.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവിടെ യഹോവ നമ്മുടെ ശക്തി ആയിരിക്കും.","poem":1},{"text":"വിശാലമായ നദികളും അരുവികളുമുള്ള ഒരു സ്ഥലമായിരിക്കും അത്.","poem":2},{"text":"തുഴകൾവെച്ച പടക്കപ്പൽ അതിലൂടെ പോകുകയില്ല;","poem":1},{"text":"കൂറ്റൻ കപ്പലുകൾ അതിലൂടെ കടക്കുകയില്ല.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"കാരണം യഹോവ നമ്മുടെ ന്യായാധിപൻ,","poem":1},{"text":"യഹോവ നമ്മുടെ നിയമദാതാവ്,","poem":2},{"text":"യഹോവ നമ്മുടെ രാജാവ്,","poem":1},{"text":"അവിടന്ന് നമ്മെ രക്ഷിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"നിന്റെ കയർ അയഞ്ഞുകിടക്കുന്നു;","poem":1},{"text":"അതിനു പാമരത്തെ അതിന്റെ സ്ഥാനത്ത് ഉറപ്പിച്ചു നിർത്തുന്നതിനോ","poem":2},{"lineBreak":true},{"text":"പായ് നിവർത്തുന്നതിനോ കഴിവില്ല.","poem":2},{"text":"അന്ന് പിടിച്ചെടുത്ത സമൃദ്ധമായ കൊള്ള പങ്കുവെക്കപ്പെടും,","poem":1},{"text":"മുടന്തർപോലും അവരുടെ കൊള്ളമുതൽ കൊണ്ടുപോകും.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അവിടത്തെ നിവാസികളാരും “ഞാൻ രോഗി,” എന്നു പറയുകയില്ല;","poem":1},{"text":"അവിടെ വസിക്കുന്ന ജനത്തിന് തങ്ങളുടെ പാപമെല്ലാം ക്ഷമിക്കപ്പെട്ടിരിക്കും.","poem":2}]}],"footnotes":[{"noteId":48,"caller":"+","text":"ചി.കൈ.പ്ര. നഗരങ്ങൾ","reference":{"chapter":33,"verse":8}},{"noteId":49,"caller":"+","text":"ചക്രവർത്തിയുടെ ഭരണത്തിൻകീഴേയുള്ള രാജ്യങ്ങളിലെ രാജാക്കന്മാർ വർഷംതോറും ചക്രവർത്തിക്ക് കൊടുത്തുവന്നിരുന്ന നികുതി.","reference":{"chapter":33,"verse":18}}]},"thisChapterLink":"/api/mal_bib/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}