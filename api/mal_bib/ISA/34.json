{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":34,"content":[{"type":"heading","content":["രാഷ്ട്രങ്ങൾക്കെതിരേയുള്ള ന്യായവിധി"]},{"type":"verse","number":1,"content":[{"text":"രാഷ്ട്രങ്ങളേ, അടുത്തുവന്നു കേൾക്കുക;","poem":1},{"text":"ജനതകളേ, ശ്രദ്ധിക്കുക!","poem":2},{"text":"ഭൂമിയും അതിലുള്ള സമസ്തവും","poem":1},{"text":"ഭൂതലവും അതിൽ മുളയ്ക്കുന്നതൊക്കെയും കേൾക്കട്ടെ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"യഹോവയുടെ കോപം എല്ലാ രാഷ്ട്രങ്ങളോടും","poem":1},{"text":"അവിടത്തെ ക്രോധം അവരുടെ സകലസൈന്യങ്ങളോടും ആകുന്നു.","poem":2},{"text":"അവിടന്ന് അവരെ സമ്പൂർണമായി നശിപ്പിക്കും,","poem":1},{"text":"അവിടന്ന് അവരെ കൊലയ്ക്കായി വിട്ടുകൊടുത്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവരുടെ ഹതന്മാരെ എറിഞ്ഞുകളയപ്പെടും,","poem":1},{"text":"അവരുടെ ശവങ്ങളിൽനിന്നു ദുർഗന്ധം വമിക്കും;","poem":2},{"lineBreak":true},{"text":"പർവതങ്ങൾ അവരുടെ രക്തംകൊണ്ടു കുതിരും.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ആകാശസൈന്യമെല്ലാം അലിഞ്ഞുപോകും,","poem":1},{"text":"ആകാശം ഒരു തുകൽച്ചുരുൾപോലെ ചുരുണ്ടുപോകും;","poem":2},{"text":"മുന്തിരിവള്ളിയുടെ ഇലകൾ വാടിക്കൊഴിയുന്നതുപോലെയും","poem":1},{"text":"അത്തിമരത്തിൽനിന്ന് കായ്കൾ പൊഴിയുന്നതുപോലെയും","poem":2},{"lineBreak":true},{"text":"അതിലെ സൈന്യമൊക്കെയും കൊഴിഞ്ഞുവീഴും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"എന്റെ വാൾ ആകാശമണ്ഡലങ്ങളിൽ അതിന്റെ ദൗത്യം പൂർത്തീകരിച്ചുകഴിയുമ്പോൾ;","poem":1},{"text":"ഇതാ, അത് ന്യായവിധിക്കായി ഏദോമിന്മേൽ,","poem":2},{"lineBreak":true},{"text":"നാശത്തിനായി ഞാൻ നിയമിച്ചിരിക്കുന്ന ജനതയുടെമേൽത്തന്നെ പതിക്കും.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"യഹോവയുടെ വാൾ രക്തംകൊണ്ടു നിറഞ്ഞിരിക്കുന്നു,","poem":1},{"text":"അതിൽ കൊഴുപ്പു പൊതിഞ്ഞിരിക്കുന്നു—","poem":2},{"text":"ചെമ്മരിയാടുകളുടെയും കോലാടുകളുടെയും രക്തംകൊണ്ടും","poem":1},{"text":"മുട്ടാടുകളുടെ വൃക്കകളിലെ കൊഴുപ്പുകൊണ്ടുംതന്നെ.","poem":2},{"text":"യഹോവയ്ക്ക് ബൊസ്രായിൽ ഒരു യാഗവും","poem":1},{"text":"ഏദോം ദേശത്ത് ഒരു മഹാസംഹാരവുമുണ്ട്.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"കാട്ടുകാളകൾ അവയോടൊപ്പം വീഴും,","poem":1},{"text":"കാളക്കിടാങ്ങളും മൂരികളും വീണുപോകും.","poem":2},{"text":"അങ്ങനെ അവരുടെ ദേശം രക്തം വീണു നനയും,","poem":1},{"text":"അതിലെ പൊടി മൃഗക്കൊഴുപ്പുകൊണ്ട് കുതിരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"കാരണം അത് യഹോവയ്ക്ക് ഒരു പ്രതികാരദിവസവും","poem":1},{"text":"സീയോനുവേണ്ടി പ്രതികാരംചെയ്യുന്ന ഒരു വർഷവും ആകുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഏദോമിന്റെ തോടുകളിൽ കീൽ കുത്തിയൊലിച്ചൊഴുകും,","poem":1},{"text":"അവളുടെ മണ്ണ് കത്തുന്ന ഗന്ധകമായി മാറും","poem":2},{"lineBreak":true},{"text":"നിലം ജ്വലിക്കുന്ന കീലായും തീരും!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"രാത്രിയും പകലും അത് അണയാതിരിക്കും;","poem":1},{"text":"അതിന്റെ പുക നിരന്തരം ഉയർന്നുകൊണ്ടിരിക്കും.","poem":2},{"text":"തലമുറതലമുറയായി അതു ശൂന്യമായിക്കിടക്കും;","poem":1},{"text":"ഒരിക്കലും ആരും അതുവഴി കടന്നുപോകുകയില്ല.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"മൂങ്ങയും നത്തും അതു കൈവശമാക്കും;","poem":1},{"text":"കൂമനും മലങ്കാക്കയും അതിൽ കൂടുകെട്ടും.","poem":2},{"noteId":50},{"text":"ദൈവം ഏദോമിന്റെമേൽ","poem":1},{"text":"സംഭ്രമത്തിന്റെ അളവുനൂലും","poem":2},{"lineBreak":true},{"text":"ശൂന്യതയുടെ തൂക്കുകട്ടയും പിടിക്കും.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവളുടെ പ്രഭുക്കന്മാർക്ക് രാജ്യം എന്നു വിളിക്കാൻ കഴിയുംവിധം ഒന്നും ഉണ്ടാകുകയില്ല,","poem":1},{"text":"അവളുടെ എല്ലാ ഭരണാധിപന്മാരും ഇല്ലാതെയാകും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അവളുടെ അരമനകളിൽ മുള്ളും","poem":1},{"text":"കോട്ടകളിൽ ചൊറിയണവും ഞെരിഞ്ഞിലും വളരും.","poem":2},{"text":"അവൾ കുറുനരികളുടെ സങ്കേതവും","poem":1},{"text":"ഒട്ടകപ്പക്ഷികളുടെ താവളവുമായി മാറും.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവിടെ മരുഭൂമിയിലെ മൃഗങ്ങൾ കഴുതപ്പുലികളോട് ഏറ്റുമുട്ടും,","poem":1},{"text":"കാട്ടാടുകൾതമ്മിൽ പോർവിളി നടത്തും;","poem":2},{"text":"നിശാജന്തുക്കൾ അവിടെ കിടക്കുകയും","poem":1},{"text":"അവയ്ക്കുവേണ്ടി വിശ്രമസ്ഥാനം കണ്ടെത്തുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവിടെ മൂങ്ങ കൂടുകെട്ടി മുട്ടയിടും,","poem":1},{"text":"അവൾ അതു വിരിയിച്ചു കുഞ്ഞുങ്ങളെ","poem":2},{"lineBreak":true},{"text":"തന്റെ ചിറകിൻനിഴലിൽ ചേർക്കും;","poem":2},{"text":"ഇരപിടിയൻപക്ഷികളും അവിടെ ഒരുമിച്ചുകൂടും","poem":1},{"text":"ഓരോന്നും അതിന്റെ ഇണകളോടൊപ്പംതന്നെ.","poem":2}]},{"type":"verse","number":16,"content":["യഹോവയുടെ പുസ്തകത്തിൽ അന്വേഷിച്ചു വായിച്ചുനോക്കുക:",{"text":"ഈ ജീവികളിൽ ഒന്നും നഷ്ടപ്പെട്ടുപോകുകയില്ല,","poem":1},{"text":"ഒന്നിനും ഇണയില്ലാതെ വരികയുമില്ല.","poem":2},{"text":"കാരണം അവിടത്തെ വായാണ് കൽപ്പന നൽകിയിരിക്കുന്നത്,","poem":1},{"text":"അവിടത്തെ ആത്മാവാണ് അവയെ ഒരുമിച്ചു ചേർക്കുന്നത്.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവിടന്ന് അവരുടെ ഭാഗം നറുക്കിടുകയും","poem":1},{"text":"അവിടത്തെ കരം അളവുനൂൽ പിടിച്ച് അവർക്കായി വിഭജിക്കയും ചെയ്തിരിക്കുന്നു.","poem":2},{"text":"അവർ അവയെ എന്നേക്കുമായി കൈവശമാക്കുകയും","poem":1},{"text":"തലമുറതലമുറയായി അതിൽ പാർക്കുകയും ചെയ്യും.","poem":2}]}],"footnotes":[{"noteId":50,"caller":"+","text":"ഈ പക്ഷികൾ ഏതെന്നു കൃത്യമായി പറയുക സാധ്യമല്ല.","reference":{"chapter":34,"verse":11}}]},"thisChapterLink":"/api/mal_bib/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}