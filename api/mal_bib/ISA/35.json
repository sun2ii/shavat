{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":35,"content":[{"type":"heading","content":["വീണ്ടെടുക്കപ്പെട്ടവരുടെ സന്തോഷം"]},{"type":"verse","number":1,"content":[{"text":"മരുഭൂമിയും വരണ്ടുണങ്ങിയ നിലവും ആഹ്ലാദിക്കും;","poem":1},{"text":"മരുഭൂമി ആനന്ദിച്ചു പുഷ്പിണിയാകും.","poem":2},{"text":"കുങ്കുമച്ചെടിപോലെ","poem":1}]},{"type":"verse","number":2,"content":[{"text":"അത് പൊട്ടിവിടരും;","poem":1},{"text":"ആനന്ദത്തോടും പാട്ടോടുംകൂടി അത് ഉല്ലസിക്കും.","poem":2},{"text":"ലെബാനോന്റെ മഹത്ത്വം അതിനു ലഭിക്കും,","poem":1},{"text":"കർമേലിന്റെയും ശാരോന്റെയും ശോഭയുംതന്നെ,","poem":2},{"text":"അവർ യഹോവയുടെ തേജസ്സും","poem":1},{"text":"നമ്മുടെ ദൈവത്തിന്റെ പ്രതാപവും ദർശിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"തളർന്ന കൈകൾ ശക്തിപ്പെടുത്തുക,","poem":1},{"text":"കുഴഞ്ഞ കാൽമുട്ടുകൾ നേരേയാക്കുക;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ഹൃദയത്തിൽ ഭയമുള്ളവരോട്:","poem":1},{"text":"“ധൈര്യപ്പെടുവിൻ, ഭയപ്പെടേണ്ട,","poem":2},{"text":"നിങ്ങളുടെ ദൈവം വരും,","poem":1},{"text":"പ്രതികാരവുമായി അവിടന്ന് വരും;","poem":2},{"text":"പാരിതോഷികം അവിടത്തെ പക്കൽ ഉണ്ട്,","poem":1},{"text":"അവിടന്നു നിങ്ങളെ രക്ഷിക്കുന്നതിനായി വരും” എന്നു പറയുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"അന്ന് അന്ധരുടെ കണ്ണുകൾ തുറക്കും,","poem":1},{"text":"ചെകിടരുടെ കാതുകൾ അടഞ്ഞിരിക്കുകയുമില്ല.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"മുടന്തർ അന്നു മാനിനെപ്പോലെ കുതിച്ചുചാടും,","poem":1},{"text":"ഊമരുടെ നാവ് ആനന്ദത്താൽ ആർപ്പിടും.","poem":2},{"text":"മരുഭൂമിയിൽ വെള്ളവും വരണ്ടുണങ്ങിയ നിലത്ത്","poem":1},{"text":"അരുവികളും പൊട്ടിപ്പുറപ്പെടും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"വരണ്ടപ്രദേശം ജലാശയമായും","poem":1},{"text":"ദാഹാർത്തമായ ഭൂമി നീരുറവകളായും തീരും.","poem":2},{"text":"ഒരിക്കൽ കുറുനരികളുടെ വാസസ്ഥലം ആയിരുന്നിടത്ത്,","poem":1},{"text":"പുല്ലും ഓടപ്പുല്ലും ഞാങ്ങണയും വളരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"അവിടെ ഒരു രാജവീഥി ഉണ്ടാകും;","poem":1},{"text":"അത് പരിശുദ്ധിയുടെ പാത എന്നു വിളിക്കപ്പെടും;","poem":2},{"lineBreak":true},{"text":"തെരഞ്ഞെടുക്കപ്പെട്ടവർക്കുമാത്രമാണ് ആ രാജവീഥി.","poem":2},{"text":"അശുദ്ധർ അതിൽ യാത്രചെയ്യുകയില്ല;","poem":1},{"text":"ദുഷ്ടരായ ഭോഷർ ആ വഴി വരുകയേയില്ല.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവിടെ ഒരു സിംഹവും ഉണ്ടാകുകയില്ല;","poem":1},{"text":"ഒരു ഹിംസ്രമൃഗവും അവിടെ സഞ്ചരിക്കുകയില്ല;","poem":2},{"lineBreak":true},{"text":"ആ വകയൊന്നും അവിടെ കാണുകയില്ല.","poem":2},{"text":"വീണ്ടെടുക്കപ്പെട്ടവർമാത്രം അതിൽ സഞ്ചരിക്കും,","poem":1}]},{"type":"verse","number":10,"content":[{"text":"യഹോവ വിലകൊടുത്തു വാങ്ങിയവർ മടങ്ങിവരും.","poem":2},{"text":"സംഗീതത്തോടെ അവർ സീയോനിലേക്ക് പ്രവേശിക്കും;","poem":1},{"text":"നിത്യാനന്ദം അവരുടെ ശിരസ്സിനു മകുടമായിരിക്കും.","poem":2},{"text":"ആഹ്ലാദത്താലും ആനന്ദത്താലും അവർ ആമഗ്നരാകും,","poem":1},{"text":"ദുഃഖവും നെടുവീർപ്പും അവരിൽനിന്ന് ഓടിയകലും.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}