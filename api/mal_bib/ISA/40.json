{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":40,"content":[{"type":"heading","content":["ദൈവജനത്തിന് ആശ്വാസം"]},{"type":"verse","number":1,"content":[{"text":"“ആശ്വസിപ്പിക്കുക, എന്റെ ജനത്തെ ആശ്വസിപ്പിക്കുക,”","poem":1},{"text":"എന്നു നിങ്ങളുടെ ദൈവം അരുളിച്ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“ജെറുശലേമിനോടു ദയാപൂർവം സംസാരിച്ച്","poem":1},{"text":"അവളുടെ യുദ്ധത്തിന്റെ കാലം കഴിഞ്ഞിരിക്കുന്നു,","poem":2},{"text":"അവളുടെ അകൃത്യം ക്ഷമിക്കപ്പെട്ടിരിക്കുന്നു,","poem":1},{"text":"അവളുടെ എല്ലാ പാപങ്ങൾക്കും യഹോവയുടെ കൈയിൽനിന്ന്","poem":2},{"text":"ഇരട്ടി ശിക്ഷ അനുഭവിച്ചുകഴിഞ്ഞിരിക്കുന്നു,” എന്നും","poem":1},{"text":"അവളോടു വിളിച്ചുപറയുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"മരുഭൂമിയിൽ വിളംബരംചെയ്യുന്ന ശബ്ദം:","poem":1},{"lineBreak":true},{"text":"“മരുഭൂമിയിൽ","poem":1},{"text":"യഹോവയ്ക്കുവേണ്ടി പാത നേരേയാക്കുക;","poem":2},{"text":"നമ്മുടെ ദൈവത്തിന്","poem":1},{"text":"ഒരു രാജവീഥി നിരപ്പാക്കുക.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"എല്ലാ താഴ്വരകളും ഉയർത്തപ്പെടും","poem":1},{"text":"എല്ലാ പർവതങ്ങളും കുന്നുകളും താഴ്ത്തപ്പെടും;","poem":2},{"text":"നിരപ്പില്ലാത്തതു നിരപ്പായിത്തീരട്ടെ,","poem":1},{"text":"കഠിനപ്രതലങ്ങൾ ഒരു സമതലഭൂമിയായും.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"യഹോവയുടെ തേജസ്സ് വെളിപ്പെടും,","poem":1},{"text":"എല്ലാ മനുഷ്യരും അത് ഒരുമിച്ചു കാണും.","poem":2},{"text":"യഹോവയുടെ വായ് അത് അരുളിച്ചെയ്തിരിക്കുന്നു.”","poem":4}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“വിളിച്ചുപറയുക,” എന്നൊരു ശബ്ദമുണ്ടായി.","poem":1},{"text":"അപ്പോൾ, “എന്തു വിളിച്ചുപറയണം?” എന്നു ഞാൻ ചോദിച്ചു.","poem":2},{"lineBreak":true},{"text":"“എല്ലാ മാനവരും തൃണസമാനരും","poem":1},{"text":"അവരുടെ അസ്തിത്വം വയലിലെ പൂപോലെയും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"യഹോവയുടെ ശ്വാസം അവരുടെമേൽ അടിക്കുമ്പോൾ","poem":1},{"text":"പുല്ലു വാടുന്നു, പൂക്കൾ കൊഴിയുന്നു;","poem":2},{"lineBreak":true},{"text":"മനുഷ്യൻ പുല്ലുതന്നെ, നിശ്ചയം.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"പുല്ല് ഉണങ്ങുന്നു, പൂക്കൾ കൊഴിയുന്നു;","poem":1},{"text":"നമ്മുടെ ദൈവത്തിന്റെ വചനമോ ചിരകാലത്തേക്കുമുള്ളത്.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"സീയോനിലേക്കു സദ്വാർത്ത കൊണ്ടുവരുന്നവരേ,","poem":1},{"text":"ഒരു ഉയർന്ന പർവതത്തിലേക്കു കയറിച്ചെല്ലുക.","poem":2},{"text":"ജെറുശലേമിലേക്കു സദ്വാർത്ത കൊണ്ടുവരുന്നവരേ,","poem":1},{"text":"നിങ്ങളുടെ ശബ്ദം ശക്തിയോടെ ഉയർത്തുക.","poem":2},{"text":"ഭയപ്പെടാതെ ശബ്ദമുയർത്തുക;","poem":1},{"text":"“ഇതാ, നിങ്ങളുടെ ദൈവം!”","poem":2},{"lineBreak":true},{"text":"എന്ന് യെഹൂദ്യയിലെ നഗരങ്ങളോടു പറയുക.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ഇതാ, യഹോവയായ കർത്താവ് ശക്തിയോടെ വരുന്നു,","poem":1},{"text":"അവിടന്ന് ശക്തിയുള്ള ഭുജത്താൽ ഭരണം നടത്തുന്നു.","poem":2},{"text":"ഇതാ, പ്രതിഫലം അവിടത്തെ പക്കലും","poem":1},{"text":"പാരിതോഷികം അവിടത്തെ കൈയിലും ഉണ്ട്.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ഒരു ഇടയനെപ്പോലെ അവിടന്നു തന്റെ ആട്ടിൻപറ്റത്തെ മേയിക്കുന്നു:","poem":1},{"text":"അവിടന്നു കുഞ്ഞാടുകളെ തന്റെ കൈകളിലേന്തുകയും","poem":2},{"text":"തന്റെ മാറോടുചേർത്തു വഹിക്കുകയും","poem":1},{"text":"തള്ളകളെ സൗമ്യതയോടെ നടത്തുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"മഹാസാഗരങ്ങളെ തന്റെ ഉള്ളങ്കൈയാൽ അളക്കുകയും","poem":1},{"text":"ആകാശവിശാലത കൈയുടെ വിസ്തൃതികൊണ്ട് അളന്നുതിരിക്കുകയും","poem":2},{"text":"ഭൂമിയിലെ പൊടി അളവുപാത്രംകൊണ്ട് അളന്നു തിട്ടപ്പെടുത്തുകയും","poem":1},{"text":"പർവതങ്ങളെ ത്രാസുകൊണ്ടും","poem":2},{"lineBreak":true},{"text":"മലകളെ തുലാംകൊണ്ടും തൂക്കുകയും ചെയ്യുന്നതാർ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"യഹോവയുടെ ആത്മാവിന്റെ","poem":1},{"noteId":57},{"text":"ആഴമളക്കാനോ","poem":1},{"text":"യഹോവയുടെ ഉപദേഷ്ടാവായിരിക്കാനോ കഴിയുന്നതാർ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അറിവുപകർന്നുകിട്ടാനായി ആരോടാണ് യഹോവ ആലോചന ചോദിച്ചത്?","poem":1},{"text":"നേരായ മാർഗം അവിടത്തെ പഠിപ്പിച്ചത് ആരാണ്?","poem":2},{"text":"ജ്ഞാനം അവിടത്തെ ഉപദേശിച്ചത് ആരാണ്?","poem":1},{"text":"അഥവാ, പരിജ്ഞാനത്തിന്റെ പാത ആരാണ് അവിടത്തേക്കു കാണിച്ചുകൊടുത്തത്?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ഇതാ, രാഷ്ട്രങ്ങൾ തൊട്ടിയിലെ ഒരു തുള്ളി വെള്ളംപോലെയും","poem":1},{"text":"തുലാസിലെ പൊടിപോലെയും അവിടത്തേക്ക് തോന്നുന്നു;","poem":2},{"lineBreak":true},{"text":"ഇതാ, ദ്വീപുകളെ ഒരു മണൽത്തരിപോലെ അവിടന്ന് ഉയർത്തുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ലെബാനോൻപോലും യാഗപീഠത്തിലെ വിറകിനു മതിയാകുകയോ","poem":1},{"text":"അതിലെ മൃഗങ്ങൾ ഹോമയാഗത്തിനു തികയുകയോ ഇല്ല.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"സകലരാഷ്ട്രങ്ങളും അവിടത്തെ മുമ്പിൽ വെറും ശൂന്യത;","poem":1},{"text":"അവ അവിടത്തേക്ക് നിസ്സാരവും","poem":2},{"lineBreak":true},{"text":"നിരർഥകവും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"അപ്പോൾ, ദൈവത്തെ നിങ്ങൾ ആരോടു താരതമ്യംചെയ്യും?","poem":1},{"text":"ഏതു രൂപത്തോടാണ് നിങ്ങൾ ദൈവത്തെ ഉപമിക്കുന്നത്?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"വിഗ്രഹത്തെക്കുറിച്ചോ, ഒരു ശില്പി അതു വാർത്തെടുക്കുന്നു,","poem":1},{"text":"സ്വർണപ്പണിക്കാർ അതിന്മേൽ സ്വർണം പൂശുന്നു,","poem":2},{"lineBreak":true},{"text":"അതിനായി വെള്ളിച്ചങ്ങല ഒരുക്കുന്നു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ഇത്തരമൊരു പ്രതിഷ്ഠയ്ക്കു വകയില്ലാത്തവർ","poem":1},{"text":"ദ്രവിച്ചുപോകാത്ത ഒരു മരം തെരഞ്ഞെടുക്കുന്നു;","poem":2},{"text":"അയാൾ വീണുപോകാത്ത ഒരു വിഗ്രഹം പണിതുണ്ടാക്കുന്നതിനായി","poem":1},{"text":"സമർഥനായ ഒരു ആശാരിയെ അന്വേഷിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"നിങ്ങൾക്കറിഞ്ഞുകൂടേ?","poem":1},{"text":"നിങ്ങൾ കേട്ടിട്ടില്ലേ?","poem":2},{"text":"ആദിമുതൽതന്നെ അതു നിങ്ങളോടറിയിച്ചിട്ടില്ലേ?","poem":1},{"text":"ഭൂമിയുടെ സ്ഥാപനംമുതൽതന്നെ നിങ്ങൾ അതു ഗ്രഹിച്ചിട്ടില്ലേ?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"അവിടന്നാണ് ഭൂമണ്ഡലത്തിനുമീതേ ഇരുന്നരുളുന്നത്,","poem":1},{"text":"അതിലെ നിവാസികൾ അവിടത്തേക്ക് വിട്ടിലിനെപ്പോലെയാണ്.","poem":2},{"text":"അവിടന്ന് ആകാശത്തെ ഒരു തിരശ്ശീലപോലെ നിവർക്കുകയും","poem":1},{"text":"പാർക്കുന്നതിന് ഒരു കൂടാരംപോലെ അതിനെ വിരിക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"അവിടന്ന് ഭരണാധികാരികളെ ശൂന്യരാക്കുകയും","poem":1},{"text":"ഭൂമിയിലെ ന്യായാധിപരെ വിലകെട്ടവരാക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അവരെ നട്ട ഉടൻതന്നെ,","poem":1},{"text":"വിതച്ചമാത്രയിൽത്തന്നെ,","poem":2},{"lineBreak":true},{"text":"അവർ ഭൂമിയിൽ വേരൂന്നിയപ്പോൾത്തന്നെ,","poem":2},{"text":"അവിടന്ന് അവരുടെമേൽ ഊതും, അത് ഉണങ്ങിപ്പോകുന്നു,","poem":1},{"text":"ചുഴലിക്കാറ്റിൽ വൈക്കോൽ എന്നപോലെ അവരെ തൂത്തെറിയുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“അങ്ങനെയെങ്കിൽ നിങ്ങൾ ആരോട് എന്നെ ഉപമിക്കും?","poem":1},{"text":"ആരോടു ഞാൻ തുല്യനാകും?” എന്നു പരിശുദ്ധൻ ചോദിക്കുന്നു.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"നിങ്ങളുടെ കണ്ണുകൾ ഉയർത്തി ആകാശത്തേക്ക് നോക്കുക:","poem":1},{"text":"ഇവയെല്ലാം നിർമിച്ചത് ആരാണ്?","poem":2},{"text":"അവിടന്ന് നക്ഷത്രസമൂഹത്തെ അണിയണിയായി മുന്നോട്ടുകൊണ്ടുവന്ന്","poem":1},{"text":"അവയെ എല്ലാം പേർചൊല്ലി വിളിക്കുന്നു.","poem":2},{"text":"അവിടത്തെ ശക്തിയുടെ മഹത്ത്വത്താലും ബലാധിക്യത്താലും","poem":1},{"text":"അവയിൽ ഒന്നുപോലും കുറഞ്ഞുപോകുന്നില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“എന്റെ വഴി യഹോവയ്ക്കു മറഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"എനിക്കു ലഭിക്കേണ്ട ന്യായം എന്റെ ദൈവം അവഗണിച്ചിരിക്കുന്നു,”","poem":2},{"text":"എന്ന് യാക്കോബേ, നീ പരാതിപ്പെടുന്നതെന്ത്?","poem":1},{"text":"ഇസ്രായേലേ, നീ സംസാരിക്കുന്നതെന്ത്?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"നിനക്ക് അറിഞ്ഞുകൂടേ?","poem":1},{"text":"നീ കേട്ടിട്ടില്ലേ?","poem":2},{"text":"യഹോവ നിത്യനായ ദൈവം ആകുന്നു,","poem":1},{"text":"അവിടന്നാണ് ഭൂമിയുടെ അറുതികളെല്ലാം സൃഷ്ടിച്ചത്.","poem":2},{"text":"അവിടന്നു ക്ഷീണിക്കുന്നില്ല, തളരുന്നതുമില്ല;","poem":1},{"text":"അവിടത്തെ വിവേകം അപ്രമേയംതന്നെ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"അവിടന്നു ക്ഷീണിതർക്കു ശക്തിനൽകുന്നു,","poem":1},{"text":"ബലം കുറഞ്ഞവരുടെ ബലം വർധിപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"യുവാക്കൾപോലും ക്ഷീണിച്ചു തളർന്നുപോകുന്നു,","poem":1},{"text":"ചെറുപ്പക്കാർ കാലിടറി നിലംപൊത്തുന്നു;","poem":2}]},{"type":"verse","number":31,"content":[{"text":"എങ്കിലും യഹോവയ്ക്കായി കാത്തിരിക്കുന്നവർ","poem":1},{"text":"അവരുടെ ശക്തി പുതുക്കും.","poem":2},{"text":"അവർ കഴുകന്മാരെപ്പോലെ ചിറകടിച്ചുയരും;","poem":1},{"text":"അവർ ഓടും, ക്ഷീണിക്കുകയില്ല,","poem":2},{"lineBreak":true},{"text":"അവർ നടക്കും, തളർന്നുപോകുകയുമില്ല.","poem":2}]}],"footnotes":[{"noteId":57,"caller":"+","text":"അഥവാ, മനസ്സ്","reference":{"chapter":40,"verse":13}}]},"thisChapterLink":"/api/mal_bib/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}