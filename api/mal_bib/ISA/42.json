{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":42,"content":[{"type":"heading","content":["യഹോവയുടെ ദാസൻ"]},{"type":"verse","number":1,"content":[{"text":"“ഇതാ, ഞാൻ ശാക്തീകരിക്കുന്ന എന്റെ ദാസൻ!","poem":1},{"text":"ഞാൻ സംപ്രീതനായിരിക്കുന്ന എന്റെ തെരഞ്ഞെടുക്കപ്പെട്ടവൻ;","poem":2},{"text":"ഞാൻ എന്റെ ആത്മാവിനെ അവന്റെമേൽ വെക്കും,","poem":1},{"text":"അവൻ രാഷ്ട്രങ്ങൾക്കു ന്യായം നടത്തിക്കൊടുക്കും.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവൻ നിലവിളിക്കുകയോ ശബ്ദം ഉയർത്തുകയോ ഇല്ല;","poem":1},{"text":"തെരുവീഥികളിൽ അവന്റെ ശബ്ദം കേൾക്കുകയുമില്ല.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ചതഞ്ഞ ഞാങ്ങണ അവൻ ഒടിക്കുകയില്ല,","poem":1},{"text":"പുകയുന്ന തിരി കെടുത്തിക്കളയുകയുമില്ല.","poem":2},{"text":"അവൻ വിശ്വസ്തതയോടെ ന്യായപാലനം നടത്തും.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"ഭൂമിയിൽ ന്യായം സ്ഥാപിക്കുന്നതുവരെ","poem":2},{"text":"അവന്റെ കാലിടറുകയോ നിരാശപ്പെടുകയോ ഇല്ല.","poem":1},{"text":"അവന്റെ നിയമത്തിനായി ദ്വീപുകൾ കാത്തിരിക്കും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"യഹോവയായ ദൈവം ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു—","poem":1},{"lineBreak":true},{"text":"ആകാശത്തെ സൃഷ്ടിച്ച് അതിനെ വിരിക്കയും","poem":1},{"text":"ഭൂമിയെയും അതിലുള്ള ഉല്പന്നങ്ങളെയും വ്യവസ്ഥാപിക്കയും","poem":2},{"lineBreak":true},{"text":"അതിലെ ജനത്തിനു ശ്വാസവും","poem":2},{"lineBreak":true},{"text":"അതിൽ ജീവിക്കുന്നവർക്കു ജീവനും പ്രദാനംചെയ്യുകയും ചെയ്തവൻതന്നെ:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“അന്ധനയനങ്ങൾ തുറക്കുന്നതിനും","poem":1},{"text":"തടവുകാരെ കാരാഗൃഹത്തിൽനിന്നും","poem":2},{"lineBreak":true},{"text":"അന്ധകാരത്തിൽ ഇരിക്കുന്നവരെ ഇരുട്ടറയിൽനിന്നും പുറപ്പെടുവിക്കാനും","poem":2},{"text":"യഹോവയായ ഞാൻ, നീതിയോടെ നിന്നെ വിളിച്ചിരിക്കുന്നു;","poem":1},{"text":"ഞാൻ നിന്നെ കൈപിടിച്ചു നടത്തും.","poem":2},{"text":"ഞാൻ നിന്നെ സൂക്ഷിക്കയും","poem":1},{"text":"ജനത്തിന് ഒരു ഉടമ്പടിയും","poem":2},{"lineBreak":true},{"text":"യെഹൂദേതരർക്കു പ്രകാശവുമായി നിന്നെ നിയമിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ഞാൻ യഹോവ ആകുന്നു; അതാണ് എന്റെ നാമം!","poem":1},{"text":"ഞാൻ എന്റെ മഹത്ത്വം മറ്റൊരുത്തനും","poem":2},{"lineBreak":true},{"text":"എന്റെ സ്തുതി വിഗ്രഹങ്ങൾക്കും നൽകുകയില്ല.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഇതാ, പണ്ടു പ്രസ്താവിച്ച കാര്യങ്ങൾ നിറവേറിയിരിക്കുന്നു,","poem":1},{"text":"ഇപ്പോൾ ഞാൻ പുതിയ കാര്യങ്ങൾ പ്രസ്താവിക്കുന്നു;","poem":2},{"text":"അവ ഉണ്ടാകുന്നതിനുമുമ്പേ","poem":1},{"text":"ഞാൻ അതു നിങ്ങളെ അറിയിക്കുന്നു.”","poem":2}]},{"type":"heading","content":["യഹോവയ്ക്ക് ഒരു സ്തോത്രഗീതം"]},{"type":"verse","number":10,"content":[{"text":"സമുദ്രത്തിൽ സഞ്ചരിക്കുന്നവരും അതിലുള്ള സകലതും","poem":1},{"text":"ദ്വീപുകളും അവയിലെ നിവാസികളുമേ,","poem":2},{"text":"യഹോവയ്ക്ക് ഒരു പുതിയ ഗാനം ആലപിക്കുക,","poem":1},{"text":"അവിടത്തെ സ്തുതി ഭൂമിയുടെ സീമകളിൽനിന്ന് പാടുക.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"മരുഭൂമിയും അതിലെ നഗരങ്ങളും ശബ്ദം ഉയർത്തട്ടെ;","poem":1},{"text":"കേദാറിലെ ഗ്രാമങ്ങളും അതിലെ നിവാസികളും ആനന്ദിക്കട്ടെ.","poem":2},{"text":"സേലാപട്ടണനിവാസികളും ആഹ്ലാദത്താൽ പാടട്ടെ;","poem":1},{"text":"പർവതത്തിന്റെ മുകളിൽനിന്ന് അവർ ആർത്തുവിളിക്കട്ടെ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവർ യഹോവയ്ക്ക് മഹത്ത്വം കൊടുക്കുകയും","poem":1},{"text":"അവിടത്തെ സ്തുതി ദ്വീപുകളിൽ പ്രസ്താവിക്കുകയും ചെയ്യട്ടെ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"യഹോവ ഒരു യോദ്ധാവിനെപ്പോലെ പുറപ്പെടും,","poem":1},{"text":"ഒരു യുദ്ധവീരനെപ്പോലെ തന്റെ തീക്ഷ്ണത പ്രകടമാക്കും;","poem":2},{"text":"അവിടന്ന് ആർത്തുവിളിക്കും, യുദ്ധഘോഷം മുഴക്കും,","poem":1},{"text":"തന്റെ ശത്രുക്കൾക്കെതിരേ അവിടന്ന് വിജയംനേടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ഞാൻ ദീർഘകാലം മൗനമായിരുന്നു,","poem":1},{"text":"ഞാൻ മിണ്ടാതിരുന്ന് എന്നെത്തന്നെ നിയന്ത്രിച്ചുപോന്നു.","poem":2},{"text":"എന്നാൽ ഇപ്പോൾ പ്രസവവേദന ബാധിച്ച സ്ത്രീയെപ്പോലെ","poem":1},{"text":"ഞാൻ ഞരങ്ങുന്നു, കിതയ്ക്കുകയും നെടുവീർപ്പിടുകയുംചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഞാൻ പർവതങ്ങളെയും മലകളെയും ശൂന്യമാക്കും","poem":1},{"text":"അവയിലെ സസ്യങ്ങളെ കരിച്ചുകളയും.","poem":2},{"text":"ഞാൻ നദികളെ ദ്വീപുകളാക്കും,","poem":1},{"text":"ജലാശയങ്ങളെ വറ്റിച്ചുംകളയും.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ഞാൻ അന്ധരെ അവർ അറിയാത്ത വഴിയിലൂടെ നടത്തും,","poem":1},{"text":"അവർ അറിഞ്ഞിട്ടില്ലാത്ത പാതകളിലൂടെ ഞാൻ അവരെ നയിക്കും.","poem":2},{"text":"ഞാൻ അവരുടെമുമ്പിൽ അന്ധകാരത്തെ പ്രകാശമായും","poem":1},{"text":"ദുർഘടസ്ഥലങ്ങളെ സമതലമായും മാറ്റും.","poem":2},{"text":"അവർക്കു ഞാൻ ഇവയെല്ലാം ചെയ്തുകൊടുക്കും;","poem":1},{"text":"ഞാൻ അവരെ ഉപേക്ഷിക്കുകയില്ല.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"എന്നാൽ വിഗ്രഹങ്ങളിൽ ആശ്രയിച്ച്,","poem":1},{"text":"ബിംബങ്ങളോട്, ‘നിങ്ങളാണ് ഞങ്ങളുടെ ദേവതകളെന്നു,’","poem":2},{"lineBreak":true},{"text":"പറയുന്നവർ പിന്തിരിഞ്ഞ് ഏറ്റവും ലജ്ജിതരാകും.","poem":2}]},{"type":"heading","content":["ഇസ്രായേൽജനത്തിന്റെ അന്ധരും ബധിരരും"]},{"type":"verse","number":18,"content":[{"text":"“ചെകിടരേ, കേൾക്കുക;","poem":1},{"text":"അന്ധരേ, നോക്കിക്കാണുക!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"എന്റെ ദാസനല്ലാതെ അന്ധൻ ആർ?","poem":1},{"text":"ഞാൻ അയയ്ക്കുന്ന എന്റെ സന്ദേശവാഹകനെപ്പോലെ ചെകിടൻ ആർ?","poem":2},{"text":"എന്റെ ഉടമ്പടിയിൽ പങ്കാളിയായിരിക്കുന്നവനെപ്പോലെ അന്ധനും","poem":1},{"text":"യഹോവയുടെ ആ ദാസനെപ്പോലെ കുരുടനും ആരുള്ളൂ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"നീ പലതും കണ്ടു; എങ്കിലും നീ അവ ഗ്രഹിക്കുന്നില്ല;","poem":1},{"text":"നിന്റെ ചെവികൾ തുറന്നിരിക്കുന്നു; എങ്കിലും ഒന്നും കേൾക്കുന്നില്ല.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"തന്റെ നീതിക്കായി","poem":1},{"text":"അവിടത്തെ നിയമം ശ്രേഷ്ഠവും മഹത്ത്വകരവുമാക്കാൻ","poem":2},{"lineBreak":true},{"text":"യഹോവയ്ക്കു പ്രസാദമായിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"എങ്കിലും ഇതു കൊള്ളചെയ്യപ്പെട്ടു കവർച്ചയായിത്തീർന്ന ഒരു ജനമാണ്,","poem":1},{"text":"അവരെല്ലാം ഗുഹകളിൽ കുടുങ്ങുകയോ","poem":2},{"lineBreak":true},{"text":"കാരാഗൃഹങ്ങളിൽ അടയ്ക്കപ്പെടുകയോ ചെയ്തിരിക്കുന്നു.","poem":2},{"text":"അവർ കവർച്ചയ്ക്ക് ഇരയായി,","poem":1},{"text":"വിടുവിക്കാൻ ആരും ഇല്ല;","poem":2},{"text":"കൊള്ളചെയ്യപ്പെട്ടു,","poem":1},{"text":"“മടക്കിത്തരിക,” എന്ന് ആരും പറയുന്നതുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"നിങ്ങളിൽ ആര് ഇതു ശ്രദ്ധിക്കും?","poem":1},{"text":"ഭാവിക്കുവേണ്ടി ആര് ചെവികൊടുത്തു കേൾക്കും?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"യാക്കോബിനെ കവർച്ചയ്ക്കും","poem":1},{"text":"ഇസ്രായേലിനെ കൊള്ളക്കാർക്കും വിട്ടുകൊടുത്തതാര്?","poem":2},{"text":"യഹോവ തന്നെയല്ലേ,","poem":1},{"text":"അവിടത്തോടല്ലേ നാം പാപം ചെയ്തത്?","poem":2},{"text":"കാരണം അവർ അവിടത്തെ വഴികൾ അനുസരിച്ചിട്ടില്ല;","poem":1},{"text":"അവിടത്തെ നിയമം അനുസരിച്ചിട്ടുമില്ല.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"അതുകൊണ്ട് തന്റെ തീക്ഷ്ണമായ കോപവും","poem":1},{"text":"യുദ്ധത്തിന്റെ ഭീകരതയും അവിടന്ന് അവരുടെമേൽ ചൊരിഞ്ഞു.","poem":2},{"text":"അത് അവരുടെ ചുറ്റും ജ്വലിച്ചിട്ടും അവർ തിരിച്ചറിഞ്ഞില്ല;","poem":1},{"text":"അത് അവരെ ദഹിപ്പിച്ചിട്ടും അവർ ഗൗനിച്ചതേയില്ല.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":24}