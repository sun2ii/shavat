{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":46,"content":[{"type":"heading","content":["ബാബേല്യ ദേവതകൾ"]},{"type":"verse","number":1,"content":[{"text":"ബേൽ വണങ്ങുന്നു, നെബോ കുനിയുന്നു;","poem":1},{"text":"അവരുടെ വിഗ്രഹങ്ങൾ ഭാരംവഹിക്കുന്ന മൃഗങ്ങൾ ചുമക്കുന്നു.","poem":2},{"text":"അവ ചുമന്നുനടക്കുന്ന ഈ പ്രതിമകൾ അവയ്ക്ക് ഒരു വലിയ ചുമടും","poem":1},{"text":"തളർന്നുപോയ മൃഗങ്ങൾക്കു താങ്ങാനാകാത്ത ഭാരവുമാണ്.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവ കുനിയുന്നു, ഒരുമിച്ചു മുട്ടുമടക്കുന്നു;","poem":1},{"text":"ആ ചുമട് സുരക്ഷിതസ്ഥാനത്ത് എത്തിക്കാൻ കഴിയുന്നില്ല,","poem":2},{"lineBreak":true},{"text":"അവ സ്വയം ബന്ധനത്തിലേക്കു പോകുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“ജനനംമുതൽ ഞാൻ ചുമന്നിട്ടുള്ളവരും","poem":1},{"text":"ഗർഭംമുതൽ ഞാൻ വഹിച്ചിട്ടുള്ളവരുമായ,","poem":2},{"text":"യാക്കോബുഗൃഹമേ, ഇസ്രായേലിൽ ശേഷിച്ചിട്ടുള്ള എല്ലാവരുമേ,","poem":1},{"text":"ഞാൻ പറയുന്നതു കേൾക്കുക.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"നിങ്ങളുടെ വാർധക്യകാലംവരെയും ജരാനരകൾ ബാധിക്കുംവരെയും","poem":1},{"text":"ഞാൻ മാറ്റമില്ലാത്തവൻ,","poem":2},{"noteId":63},{"text":"ഞാനാണ് നിന്നെ സംരക്ഷിക്കുന്നവൻ.","poem":2},{"text":"ഞാൻ നിന്നെ സൃഷ്ടിച്ചു, ഞാൻ നിന്നെ ചുമക്കും;","poem":1},{"text":"ഞാൻ നിന്നെ സംരക്ഷിക്കും, ഞാൻ നിന്നെ മോചിപ്പിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“നിങ്ങൾ എന്നെ ആരോട് ഉപമിക്കും? എന്നെ ആർക്കു തുല്യനാക്കും?","poem":1},{"text":"നിങ്ങൾ എന്നെ ആരോടു താരതമ്യപ്പെടുത്തി എന്നെ ഉപമിക്കും?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ചിലർ സഞ്ചിയിൽനിന്നു സ്വർണം കുടഞ്ഞിടുന്നു,","poem":1},{"text":"തുലാസിൽ വെള്ളി തൂക്കിനോക്കുന്നു;","poem":2},{"text":"അതിനെ ഒരു ദേവതയാക്കുന്നതിന് ഒരു സ്വർണപ്പണിക്കാരനെ അവർ കൂലിക്കു നിർത്തുന്നു,","poem":1},{"text":"അവർ സാഷ്ടാംഗം വീണ് അതു നമസ്കരിക്കുകയുംചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവർ അതിനെ തോളിലെടുത്തുവെച്ച് ചുമന്നുനടക്കുന്നു;","poem":1},{"text":"അവർ അതിനെ അതിന്റെ സ്ഥാനത്തു നിർത്തുന്നു, അത് അവിടെത്തന്നെ നിൽക്കുന്നു.","poem":2},{"lineBreak":true},{"text":"ആ സ്ഥാനത്തുനിന്ന് അതിനു വ്യതിചലിക്കാൻ കഴിയുകയുമില്ല.","poem":2},{"text":"ആരെങ്കിലും അതിനോടു നിലവിളിച്ചാൽപോലും, അത് ഉത്തരം പറയുന്നില്ല.","poem":1},{"text":"അവരുടെ കഷ്ടതയിൽനിന്ന് രക്ഷിക്കാൻ അതിനു കഴിവുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ഇത് ഓർത്തുകൊള്ളുക, ധൈര്യസമേതം നിലകൊള്ളുക,","poem":1},{"text":"നിഷേധികളേ, ഇതു ഹൃദയത്തിൽ സൂക്ഷിക്കുക.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"കഴിഞ്ഞകാലസംഭവങ്ങൾ ഓർക്കുക, പൗരാണിക കാര്യങ്ങൾതന്നെ;","poem":1},{"text":"ഞാൻ ആകുന്നു ദൈവം, വേറൊരു ദൈവവുമില്ല;","poem":2},{"lineBreak":true},{"text":"ഞാൻ ആകുന്നു ദൈവം; എന്നെപ്പോലെ ഒരുവനുമില്ല.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ആരംഭത്തിൽത്തന്നെ ഞാൻ അവസാനം പ്രഖ്യാപിക്കുന്നു,","poem":1},{"text":"പൂർവകാലത്തുതന്നെ ഭാവിയിൽ സംഭവിക്കാനുള്ളതും.","poem":2},{"text":"അവിടന്ന് അരുളുന്നു, ‘എന്റെ ആലോചന നിലനിൽക്കും,","poem":1},{"text":"എനിക്കു ഹിതമായതൊക്കെയും ഞാൻ നിറവേറ്റും.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ഒരു ഇരപിടിയൻപക്ഷിയെ കിഴക്കുനിന്നു ഞാൻ വരുത്തും;","poem":1},{"text":"എന്റെ ആലോചന നിറവേറ്റുന്ന പുരുഷനെ ദൂരദേശത്തുനിന്നും.","poem":2},{"text":"ഞാൻ സംസാരിച്ചിരിക്കുന്നു, ഞാൻ അതു നിറവേറ്റും;","poem":1},{"text":"ഞാൻ ലക്ഷ്യം വെച്ചിരിക്കുന്നു, ഞാൻ അതു നടത്തും.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"എന്റെ നീതിയിൽനിന്ന് അകന്നിരിക്കുന്ന","poem":1},{"text":"കഠിനഹൃദയരേ, എന്നെ ശ്രദ്ധിക്കുക.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"എന്റെ നീതിനിർവഹണം സമീപിച്ചിരിക്കുന്നു,","poem":1},{"text":"അത് അകലെയല്ല,","poem":2},{"lineBreak":true},{"text":"എന്റെ രക്ഷ താമസിക്കയുമില്ല.","poem":2},{"text":"ഞാൻ സീയോന് എന്റെ രക്ഷയും","poem":1},{"text":"ഇസ്രായേലിന് എന്റെ മഹത്ത്വവും നൽകും.","poem":2}]}],"footnotes":[{"noteId":63,"caller":"+","text":"മൂ.ഭാ. ഞാൻ അവൻ ആകുന്നു","reference":{"chapter":46,"verse":4}}]},"thisChapterLink":"/api/mal_bib/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}