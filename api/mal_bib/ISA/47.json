{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":47,"content":[{"type":"heading","content":["ബാബേലിന്റെ പതനം"]},{"type":"verse","number":1,"content":[{"text":"“ബാബേൽപുത്രിയായ കന്യകേ,","poem":1},{"text":"ഇറങ്ങി പൊടിയിൽ ഇരിക്കുക.","poem":2},{"text":"ബാബേല്യരുടെ","poem":1},{"noteId":64},{"text":"നഗരറാണിയായവളേ,","poem":1},{"text":"സിംഹാസനത്തിൽനിന്നും നിഷ്കാസിതയായി തറയിൽ ഇരിക്കുക.","poem":2},{"text":"ഇനിയൊരിക്കലും നീ പേലവഗാത്രിയെന്നോ","poem":1},{"text":"കോമളാംഗിയെന്നോ വിളിക്കപ്പെടുകയില്ല.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"തിരികല്ലെടുത്തു മാവു പൊടിക്കുക;","poem":1},{"text":"നിന്റെ മൂടുപടം നീക്കുക.","poem":2},{"text":"നിന്റെ വസ്ത്രം ഉയർത്തുക,","poem":1},{"text":"തുട മറയ്ക്കാതെ നദി കടക്കുക.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"നിന്റെ നഗ്നത അനാവൃതമാക്കപ്പെടും,","poem":1},{"text":"നിന്റെ ഗുഹ്യഭാഗം വെളിപ്പെടും.","poem":2},{"text":"ഞാൻ ഒരു മനുഷ്യനെയും ആദരിക്കാതെ","poem":1},{"text":"പ്രതികാരം നടത്തും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ഞങ്ങളുടെ വീണ്ടെടുപ്പുകാരൻ ഇസ്രായേലിന്റെ പരിശുദ്ധനാകുന്നു,","poem":1},{"text":"സൈന്യങ്ങളുടെ യഹോവ എന്നാകുന്നു അവിടത്തെ നാമം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ബാബേല്യപുത്രീ,","poem":1},{"text":"നിശ്ശബ്ദയായിരിക്കൂ, അന്ധകാരത്തിലേക്കു കടക്കൂ;","poem":2},{"text":"രാജ്യങ്ങളുടെ തമ്പുരാട്ടി എന്ന്","poem":1},{"text":"ഇനി നീ വിളിക്കപ്പെടുകയില്ല.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഞാൻ എന്റെ ജനത്തോടു കോപിച്ചു,","poem":1},{"text":"എന്റെ അവകാശത്തെ ഞാൻ മലിനമാക്കി;","poem":2},{"text":"നിന്റെ കൈയിൽ ഞാൻ അവരെ ഏൽപ്പിച്ചു,","poem":1},{"text":"നീ അവരോടു കരുണ കാണിച്ചില്ല.","poem":2},{"text":"വൃദ്ധരുടെമേൽപോലും","poem":1},{"text":"നീ നിന്റെ ഭാരമേറിയ നുകം വെച്ചു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"‘ഞാൻ എന്നേക്കും ഒരു തമ്പുരാട്ടിതന്നെ ആയിരിക്കും,’","poem":1},{"text":"എന്നു നീ പറഞ്ഞു.","poem":2},{"text":"ഈ കാര്യങ്ങൾ നീ ഹൃദയത്തിൽ കരുതുകയോ","poem":1},{"text":"അതിന്റെ പരിണതഫലം എന്താകുമെന്ന് ചിന്തിക്കുകയോ ചെയ്തില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“എന്നാൽ ഇപ്പോൾ, സുഖലോലുപയായവളേ, കേൾക്കുക,","poem":1},{"text":"നിങ്ങളുടെ സുരക്ഷയിൽ വിശ്രമിക്കുന്നവളേ,","poem":2},{"text":"‘ഞാൻ ആകുന്നു, എന്നെക്കാൾ മികച്ച ആരുമില്ല,","poem":1},{"text":"ഞാൻ ഒരിക്കലും ഒരു വിധവയാകുകയില്ല,","poem":2},{"text":"പുത്രനഷ്ടം അനുഭവിക്കുകയുമില്ല,’","poem":1},{"text":"എന്ന് സ്വയം പറയുന്നവളേ,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഒരൊറ്റ നിമിഷംകൊണ്ട്, ഒരേദിവസംതന്നെ","poem":1},{"text":"ഇവ രണ്ടും നീ നേരിടും.","poem":2},{"text":"നിനക്ക് അസംഖ്യം ക്ഷുദ്രപ്രയോഗങ്ങളും","poem":1},{"text":"ശക്തിയേറിയ എല്ലാ ആഭിചാരങ്ങളും ഉണ്ടായിരുന്നിട്ടും","poem":2},{"text":"പുത്രനഷ്ടവും വൈധവ്യവും","poem":1},{"text":"അതിന്റെ പൂർണതയിൽ നിനക്കു നേരിടേണ്ടിവരും.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"നീ നിന്റെ ദുഷ്ടതയിൽ ആശ്രയിച്ചു,","poem":1},{"text":"‘ആരും എന്നെ കാണുന്നില്ല,’ എന്നു നീ പറഞ്ഞു.","poem":2},{"text":"നിന്റെ ജ്ഞാനവും നിന്റെ വിദ്യയും നിന്നെ വഴിതെറ്റിച്ചു.","poem":1},{"text":"‘ഞാൻ ആകുന്നു, എന്നെക്കാൾ മികച്ച ആരുമില്ല’","poem":2},{"lineBreak":true},{"text":"എന്നു നീ ഹൃദയത്തിൽ പറഞ്ഞപ്പോൾത്തന്നെ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അതിനാൽ അനർഥം നിന്റെമേൽ പതിക്കും,","poem":1},{"text":"മന്ത്രവാദംകൊണ്ട് അതു നീക്കാൻ നിനക്കു കഴിയുകയില്ല.","poem":2},{"text":"നിനക്കു പരിഹരിക്കാനാകാത്ത","poem":1},{"text":"ആപത്തു നിന്റെമേൽ വരും;","poem":2},{"text":"നിനക്കു ചിന്തിക്കാൻപോലും കഴിയാത്ത വിനാശം","poem":1},{"text":"നിന്റെമേൽ പെട്ടെന്നുതന്നെ വീഴും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ഇപ്പോൾ, നീ ബാല്യംമുതൽ ചെയ്തുവന്ന","poem":1},{"text":"നിന്റെ ആഭിചാരങ്ങളും","poem":2},{"lineBreak":true},{"text":"ക്ഷുദ്രപ്രയോഗങ്ങളുടെ ബാഹുല്യവും തുടരുക.","poem":2},{"text":"ഒരുപക്ഷേ നിനക്കു ഫലം ലഭിച്ചേക്കാം,","poem":1},{"text":"ഒരുപക്ഷേ നീ ഭീതി ജനിപ്പിച്ചേക്കാം.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ആലോചനയുടെ ബാഹുല്യംകൊണ്ടു നീ വലഞ്ഞിരിക്കുന്നു!","poem":1},{"text":"ഇപ്പോൾ ജ്യോതിഷികൾ മുമ്പോട്ടുവരട്ടെ,","poem":2},{"text":"നക്ഷത്രം നോക്കുന്നവരും അമാവാസി കണ്ടു പ്രവചിക്കുന്നവരും,","poem":1},{"text":"നിനക്കു സംഭവിക്കാൻ പോകുന്നവയിൽനിന്ന് നിന്നെ വിടുവിക്കട്ടെ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ഇതാ, അവർ വൈക്കോൽക്കുറ്റിപോലെ ആകും;","poem":1},{"text":"തീ അവരെ ദഹിപ്പിച്ചുകളയും.","poem":2},{"text":"അഗ്നിജ്വാലയുടെ ശക്തിയിൽനിന്നു","poem":1},{"text":"തങ്ങളെത്തന്നെ രക്ഷിക്കാൻ അവർക്കു കഴിവില്ല.","poem":2},{"text":"അതു കുളിർമാറ്റുന്നതിനുള്ള കനലോ","poem":1},{"text":"കായുവാൻ തക്ക തീയോ അല്ല.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ബാല്യംമുതൽ നിന്നോടു ചേർന്ന് അധ്വാനിച്ചിരുന്നവരും","poem":1},{"text":"നിന്നോടു ചേർന്നു കച്ചവടംചെയ്തവരും","poem":2},{"lineBreak":true},{"text":"അതിലപ്പുറമാകുകയില്ല.","poem":2},{"text":"അവർ ഓരോരുത്തരും അവരവരുടെ ദിശയിലേക്കു ചിതറിപ്പോകും;","poem":1},{"text":"നിന്നെ രക്ഷിക്കാൻ ആരും അവശേഷിക്കുകയില്ല.","poem":2}]}],"footnotes":[{"noteId":64,"caller":"+","text":"അഥവാ, കൽദയരായ","reference":{"chapter":47,"verse":1}}]},"thisChapterLink":"/api/mal_bib/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}