{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":51,"content":[{"type":"heading","content":["സീയോനു നിത്യരക്ഷ"]},{"type":"verse","number":1,"content":[{"text":"“നീതിയെ പിൻതുടരുന്നവരും","poem":1},{"text":"യഹോവയെ അന്വേഷിക്കുന്നവരുമേ, എന്റെ വാക്കു ശ്രദ്ധിക്കുക.","poem":2},{"text":"നിങ്ങളെ വെട്ടിയെടുത്ത പാറയിലേക്കും നിങ്ങളെ","poem":1},{"text":"കുഴിച്ചെടുത്ത ഖനിഗർഭത്തിലേക്കും നോക്കുക;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"നിങ്ങളുടെ പിതാവായ അബ്രാഹാമിലേക്കും","poem":1},{"text":"നിങ്ങളെ പ്രസവിച്ച സാറയിലേക്കും നോക്കുക.","poem":2},{"text":"ഏകനായിരുന്ന അവസ്ഥയിൽ ഞാൻ അവനെ വിളിക്കുകയും","poem":1},{"text":"അവനെ അനുഗ്രഹിച്ചു വർധിപ്പിക്കുകയും ചെയ്തു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"യഹോവ സീയോനെ ആശ്വസിപ്പിക്കും,","poem":1},{"text":"അവിടന്ന് അവളുടെ ശൂന്യപ്രദേശങ്ങളെല്ലാം ആശ്വസിപ്പിക്കും;","poem":2},{"text":"അവിടന്ന് അവളുടെ മരുഭൂമിയെ ഏദെൻപോലെയും","poem":1},{"text":"അവളുടെ നിർജനസ്ഥലത്തെ യഹോവയുടെ തോട്ടംപോലെയുമാക്കും.","poem":2},{"text":"ആനന്ദവും ആഹ്ലാദവും","poem":1},{"text":"സ്തോത്രവും സംഗീതധ്വനിയും അവളിലുണ്ടാകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“എന്റെ ജനതയേ, എന്നെ ശ്രദ്ധിക്കുക;","poem":1},{"text":"എന്റെ രാഷ്ട്രമേ, എനിക്കു ചെവിതരിക:","poem":2},{"text":"കാരണം നിയമം എന്നിൽനിന്ന് പുറപ്പെടും;","poem":1},{"text":"എന്റെ നീതി രാഷ്ട്രങ്ങൾക്കു പ്രകാശമാകും.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"എന്റെ നീതി അതിവേഗം അടുത്തുകൊണ്ടിരിക്കുന്നു,","poem":1},{"text":"എന്റെ രക്ഷ സമീപിച്ചുകൊണ്ടിരിക്കുന്നു,","poem":2},{"lineBreak":true},{"text":"എന്റെ ഭുജം രാഷ്ട്രങ്ങളെ ന്യായംവിധിക്കും.","poem":2},{"text":"ദ്വീപുകൾ എനിക്കായി കാത്തിരിക്കുകയും","poem":1},{"text":"എന്റെ ശക്തിയുള്ള ഭുജത്തിൽ ആശ്രയിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"നിങ്ങളുടെ കണ്ണുകൾ ആകാശത്തേക്ക് ഉയർത്തുക,","poem":1},{"text":"താഴേ ഭൂമിയെ നോക്കുക.","poem":2},{"text":"ആകാശം പുകപോലെ അപ്രത്യക്ഷമാകും,","poem":1},{"text":"ഭൂമി വസ്ത്രംപോലെ പഴകിപ്പോകും,","poem":2},{"lineBreak":true},{"text":"അതിൽ വസിക്കുന്നവർ ഈച്ചകൾപോലെ മരണമടയും,","poem":2},{"text":"എന്നാൽ എന്റെ രക്ഷ ശാശ്വതമായി നിലനിൽക്കും,","poem":1},{"text":"എന്റെ നീതി നീങ്ങിപ്പോകുകയുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“നീതിയെ അറിയുന്നവരും ഹൃദയത്തിൽ എന്റെ ന്യായപ്രമാണമുള്ളവരുമേ,","poem":1},{"text":"എന്റെ വാക്കു കേൾക്കുക:","poem":2},{"text":"കേവലം മനുഷ്യരുടെ നിന്ദയെ നിങ്ങൾ ഭയപ്പെടുകയോ","poem":1},{"text":"അവരുടെ ഭർത്സനത്തെ പേടിക്കുകയോ അരുത്.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"പുഴു അവരെ വസ്ത്രംപോലെ അരിച്ചുകളയും;","poem":1},{"text":"കൃമി അവരെ കമ്പിളിയെപ്പോലെ തിന്നുകളയും.","poem":2},{"text":"എന്നാൽ എന്റെ നീതി നിത്യകാലത്തേക്കുള്ളത്","poem":1},{"text":"എന്റെ രക്ഷ തലമുറതലമുറയായും നിലനിൽക്കും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"യഹോവയുടെ ഭുജമേ, ഉണരുക, ഉണരുക,","poem":1},{"text":"ശക്തി ധരിച്ചുകൊൾക!","poem":2},{"text":"പുരാതനകാലത്തെപ്പോലെയും","poem":1},{"text":"പഴയ തലമുറകളിലെന്നപോലെയും ഉണരുക.","poem":2},{"text":"രഹബിനെ വെട്ടിക്കളയുകയും","poem":1},{"text":"ഭീകരസത്വത്തെ കുത്തിക്കീറുകയും ചെയ്തതു നീയല്ലേ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"സമുദ്രത്തെ, അഗാധജലരാശിയിലെ വെള്ളത്തെ,","poem":1},{"text":"വറ്റിച്ചുകളഞ്ഞത് അങ്ങല്ലേ?","poem":2},{"text":"താൻ വീണ്ടെടുത്തവർക്കു കടന്നുപോകാൻ","poem":1},{"text":"സമുദ്രത്തിന്റെ അടിത്തട്ടിനെ വഴിയാക്കിത്തീർത്തതും അങ്ങല്ലേ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"യഹോവ വിലകൊടുത്തു വാങ്ങിയവർ മടങ്ങിവരും.","poem":1},{"text":"സംഗീതത്തോടെ അവർ സീയോനിലേക്ക് പ്രവേശിക്കും;","poem":2},{"lineBreak":true},{"text":"നിത്യാനന്ദം അവരുടെ ശിരസ്സിനു മകുടമായിരിക്കും.","poem":2},{"text":"ആഹ്ലാദത്താലും ആനന്ദത്താലും അവർ ആമഗ്നരാകും,","poem":1},{"text":"ദുഃഖവും നെടുവീർപ്പും അവരിൽനിന്ന് ഓടിയകലും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ഞാൻ, ഞാനാകുന്നു നിങ്ങളെ ആശ്വസിപ്പിക്കുന്നവൻ.","poem":1},{"text":"വെറും മർത്യരെയും വെറും പുല്ലുപോലെയുള്ള","poem":2},{"lineBreak":true},{"text":"മനുഷ്യജീവികളെയും ഭയപ്പെടുന്ന നീ ആര്?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ആകാശത്തെ വിരിക്കുകയും","poem":1},{"text":"ഭൂമിക്ക് അടിസ്ഥാനമിടുകയും ചെയ്ത","poem":2},{"lineBreak":true},{"text":"നിന്റെ സ്രഷ്ടാവായ യഹോവയെ മറന്നുപോയിട്ട്,","poem":2},{"text":"വിനാശത്തിനായി തുനിഞ്ഞിറങ്ങിയിരിക്കുന്ന","poem":1},{"text":"പീഡകന്റെ കോപത്തെ നിരന്തരം ഭയന്ന്","poem":2},{"lineBreak":true},{"text":"നാൾതോറും നീ ജീവിക്കുന്നു.","poem":2},{"text":"പീഡകരുടെ ക്രോധം എവിടെ?","poem":1}]},{"type":"verse","number":14,"content":[{"text":"പേടിച്ചു തടവറയിൽ കഴിയുന്നവർ വേഗത്തിൽ സ്വതന്ത്രരാക്കപ്പെടും;","poem":2},{"text":"അവർ കാരാഗൃഹത്തിൽക്കിടന്നു മരിക്കുകയില്ല,","poem":1},{"text":"അവരുടെ ആഹാരം മുടങ്ങുകയുമില്ല.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"തിരകൾ ഗർജിക്കുമാറ് സമുദ്രത്തെ ക്ഷോഭിപ്പിക്കുന്ന","poem":1},{"text":"നിന്റെ ദൈവമായ യഹോവ ഞാൻ ആകുന്നു—","poem":2},{"lineBreak":true},{"text":"സൈന്യങ്ങളുടെ യഹോവ എന്നാണ് എന്റെ നാമം.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ആകാശത്തെ ഉറപ്പിച്ച്,","poem":1},{"text":"ഭൂമിക്ക് അടിസ്ഥാനമിട്ട്,","poem":2},{"lineBreak":true},{"text":"സീയോനോട്, ‘നീ എന്റെ ജനം’ എന്നു പറയുന്നതിന്,","poem":2},{"text":"ഞാൻ എന്റെ വചനം നിന്റെ വായിൽ തരികയും","poem":1},{"text":"എന്റെ കൈയുടെ നിഴലിൽ നിന്നെ മറയ്ക്കുകയും ചെയ്തിരിക്കുന്നു.”","poem":2}]},{"type":"heading","content":["യഹോവയുടെ ക്രോധപാനപാത്രം"]},{"type":"verse","number":17,"content":[{"text":"യഹോവയുടെ കരത്തിൽനിന്നുള്ള","poem":1},{"text":"ക്രോധത്തിന്റെ പാനപാത്രം കുടിച്ച,","poem":2},{"text":"ജെറുശലേമേ, ഉണരുക, ഉണരുക,","poem":1},{"text":"എഴുന്നേൽക്കുക,","poem":2},{"text":"നീ പരിഭ്രമത്തിന്റെ പാനപാത്രം","poem":1},{"text":"മട്ടുവരെയും കുടിച്ചു വറ്റിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അവൾ പ്രസവിച്ച മക്കളുടെ കൂട്ടത്തിൽ","poem":1},{"text":"അവളെ നയിക്കാൻ ഒരുത്തനുമില്ല;","poem":2},{"text":"അവൾ വളർത്തിയ മക്കളിൽ","poem":1},{"text":"അവളെ കൈപിടിച്ചു നടത്താൻ ആരുമില്ല.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ഈ രണ്ടു കാര്യങ്ങൾ നിനക്കുമേൽ വന്നിരിക്കുന്നു—","poem":1},{"text":"നിന്നോടു സഹതപിക്കാൻ ആരുണ്ട്?","poem":2},{"text":"സംഹാരവും നാശവും ക്ഷാമവും വാളും നിനക്കു നേരിട്ടിരിക്കുന്നു;","poem":1},{"text":"നിന്നെ ആശ്വസിപ്പിക്കാൻ ആർക്കു കഴിയും?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"നിന്റെ മക്കൾ ബോധക്ഷയംവന്നു വീണുപോയി;","poem":1},{"text":"വലയിൽ അകപ്പെട്ട മാനിനെപ്പോലെ","poem":2},{"lineBreak":true},{"text":"അവർ എല്ലാ ചത്വരങ്ങളിലും കിടക്കുന്നു.","poem":2},{"text":"അവർ യഹോവയുടെ ക്രോധംകൊണ്ടും","poem":1},{"text":"നിന്റെ ദൈവത്തിന്റെ ശാസനകൊണ്ടും നിറഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"അതിനാൽ പീഡിതരേ,","poem":1},{"text":"വീഞ്ഞുകൊണ്ടല്ലാതെ ലഹരി പിടിച്ചവളേ, ഇതു കേൾക്കുക.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"നിന്റെ നാഥനായ യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു,","poem":1},{"text":"തന്റെ ജനത്തിനുവേണ്ടി വ്യവഹരിക്കുന്ന, നിന്റെ ദൈവംതന്നെ:","poem":2},{"text":"“ഇതാ, പരിഭ്രമത്തിന്റെ പാനപാത്രം","poem":1},{"text":"ഞാൻ നിന്റെ കൈയിൽനിന്ന് എടുത്തുമാറ്റുന്നു,","poem":2},{"text":"ആ പാത്രത്തിൽനിന്ന്, എന്റെ ക്രോധത്തിന്റെ കോപ്പയിൽനിന്ന്","poem":1},{"text":"ഇനിമേൽ നീ കുടിക്കുകയില്ല;","poem":2}]},{"type":"verse","number":23,"content":[{"text":"അതു ഞാൻ നിന്നെ പീഡിപ്പിക്കുന്നവരുടെ കൈയിൽ ഏൽപ്പിക്കും,","poem":1},{"text":"‘സാഷ്ടാംഗം വീഴുക, ഞങ്ങൾ നിന്നെ ചവിട്ടിമെതിക്കട്ടെ’","poem":2},{"lineBreak":true},{"text":"എന്നു നിന്നോടു പറഞ്ഞവരുടെതന്നെ കൈയിൽ.","poem":2},{"text":"നീ നിന്റെ ശരീരത്തെ നിലംപോലെയും","poem":1},{"text":"മനുഷ്യൻ ചവിട്ടിനടക്കുന്ന തെരുവീഥിപോലെയും ആക്കിയിരുന്നല്ലോ.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}