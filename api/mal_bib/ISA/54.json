{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":54,"content":[{"type":"heading","content":["ജെറുശലേമിന്റെ ഭാവിമഹത്ത്വം"]},{"type":"verse","number":1,"content":[{"text":"“വന്ധ്യയായവളേ, ആർപ്പിടുക;","poem":1},{"text":"ഒരു കുഞ്ഞിനും ജന്മം നൽകിയിട്ടില്ലാത്തവളേ, പൊട്ടിയാർക്കുക,","poem":2},{"text":"പ്രസവവേദന എന്തെന്ന് അറിയാത്തവളേ,","poem":1},{"text":"ആനന്ദത്താൽ ആർത്തുഘോഷിക്കുക;","poem":2},{"text":"കാരണം, പരിത്യക്തയുടെ മക്കൾ","poem":1},{"text":"ഭർത്താവുള്ളവളുടെ മക്കളെക്കാൾ അധികം,”","poem":2},{"text":"എന്ന് യഹോവ അരുളിച്ചെയ്യുന്നു.","poem":4}]},{"type":"verse","number":2,"content":[{"text":"“നിന്റെ കൂടാരത്തിന്റെ സ്ഥലം വിസ്തൃതമാക്കുക,","poem":1},{"text":"നിന്റെ കൂടാരത്തിന്റെ തിരശ്ശീലകൾ വിശാലമായി നിവർക്കുക,","poem":2},{"lineBreak":true},{"text":"അതു ചുരുക്കരുത്;","poem":2},{"text":"നിന്റെ കയറുകൾ നീട്ടുകയും","poem":1},{"text":"കുറ്റികൾ ബലവത്താക്കുകയും ചെയ്യുക.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"നീ വലത്തോട്ടും ഇടത്തോട്ടും വിസ്തൃതമാകും;","poem":1},{"text":"നിന്റെ സന്തതി ഇതരരാഷ്ട്രങ്ങൾ കൈവശമാക്കുകയും","poem":2},{"lineBreak":true},{"text":"അവരുടെ ശൂന്യനഗരങ്ങളിൽ പാർക്കുകയും ചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“ഭയപ്പെടേണ്ട; നീ ലജ്ജിതയാകുകയില്ല;","poem":1},{"text":"പരിഭ്രമിക്കേണ്ട; നീ അപമാനിതയാകുകയില്ല.","poem":2},{"text":"നിന്റെ യൗവനകാലത്തെ ലജ്ജ നീ മറക്കും,","poem":1},{"text":"വൈധവ്യനിന്ദ മേലാൽ ഓർക്കുകയുമില്ല.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"നിന്റെ സ്രഷ്ടാവുതന്നെ നിന്റെ ഭർത്താവ്—","poem":1},{"text":"സൈന്യങ്ങളുടെ യഹോവ എന്നാണ് അവിടത്തെ നാമം—","poem":2},{"text":"ഇസ്രായേലിന്റെ പരിശുദ്ധനാണ് നിന്റെ വീണ്ടെടുപ്പുകാരൻ;","poem":1},{"text":"അവിടന്നു സകലഭൂമിയുടെയും ദൈവം എന്നു വിളിക്കപ്പെടും.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"പരിത്യക്തയായി ആത്മാവിൽ വേദന പൂണ്ടിരിക്കുന്ന സ്ത്രീയെ എന്നപോലെ","poem":1},{"text":"യൗവനത്തിൽ വിവാഹംകഴിഞ്ഞയുടനെ ഉപേക്ഷിക്കപ്പെട്ട ഭാര്യയെപ്പോലെയുള്ള നിന്നെ","poem":2},{"text":"യഹോവ തിരികെ വിളിക്കും,”","poem":1},{"text":"എന്നു നിന്റെ ദൈവം അരുളിച്ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“അൽപ്പനിമിഷത്തേക്കുമാത്രം ഞാൻ നിന്നെ ഉപേക്ഷിച്ചു,","poem":1},{"text":"എങ്കിലും മഹാദയയോടെ ഞാൻ നിന്നെ ചേർത്തുകൊള്ളും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"തിളച്ചുമറിഞ്ഞ കോപംനിമിത്തം","poem":1},{"text":"ഞാൻ നിമിഷനേരത്തേക്ക് എന്റെ മുഖം നിനക്കു മറച്ചുകളഞ്ഞു,","poem":2},{"text":"എങ്കിലും ശാശ്വത കാരുണ്യത്തോടെ","poem":1},{"text":"ഞാൻ നിന്നോടു കരുണകാണിക്കും,”","poem":2},{"lineBreak":true},{"text":"എന്നു നിന്റെ വീണ്ടെടുപ്പുകാരനായ യഹോവ അരുളിച്ചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ഇത് എനിക്കു നോഹയുടെ കാലത്തെ പ്രളയംപോലെയാണ്,","poem":1},{"text":"നോഹയുടെ കാലത്തെപ്പോലെയുള്ള പ്രളയം ഭൂമിയിൽ മേലാൽ സംഭവിക്കുകയില്ലെന്നു ഞാൻ ശപഥംചെയ്തു.","poem":2},{"text":"അതുപോലെ ഇനിയൊരിക്കലും നിന്നോടു കോപിഷ്ഠനാകുകയോ","poem":1},{"text":"നിന്നെ ശകാരിക്കുകയോ ചെയ്യുകയില്ല എന്ന് ഇപ്പോൾ ഞാൻ ശപഥംചെയ്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"പർവതങ്ങൾ ഇളകിപ്പോകും,","poem":1},{"text":"കുന്നുകൾ മാറിപ്പോകും,","poem":2},{"text":"എങ്കിലും എന്റെ അചഞ്ചലസ്നേഹം നിന്നെവിട്ടു നീങ്ങുകയോ","poem":1},{"text":"എന്റെ സമാധാന ഉടമ്പടി ലംഘിക്കപ്പെടുകയോ ഇല്ല,”","poem":2},{"lineBreak":true},{"text":"എന്നു നിന്നോടു കരുണാമയനായ യഹോവ അരുളിച്ചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“പീഡിതയും കൊടുങ്കാറ്റിൽപ്പെട്ട് ഉഴലുന്ന ആശ്വാസരഹിതയുമായ പട്ടണമേ,","poem":1},{"text":"ഞാൻ നിന്നെ പത്മരാഗംകൊണ്ട്","poem":2},{"noteId":73},{"text":"പുനർനിർമിക്കും,","poem":2},{"lineBreak":true},{"text":"ഇന്ദ്രനീലക്കല്ലുകൊണ്ടു നിന്റെ അടിസ്ഥാനമിടുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ഞാൻ നിന്റെ താഴികക്കുടങ്ങൾ മാണിക്യംകൊണ്ടും","poem":1},{"text":"നിന്റെ കവാടങ്ങൾ പുഷ്യരാഗംകൊണ്ടും","poem":2},{"lineBreak":true},{"text":"നിന്റെ മതിലുകൾ മുഴുവനും വിലയേറിയ കല്ലുകൾകൊണ്ടും നിർമിക്കും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"നിന്റെ മക്കൾ എല്ലാവരും യഹോവയാൽ അഭ്യസിപ്പിക്കപ്പെട്ടവരാകും,","poem":1},{"text":"അവർ വളരെ വലിയ സമാധാനം അനുഭവിക്കും.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"നീതിയിൽ നീ സുസ്ഥിരയായിത്തീരും:","poem":1},{"lineBreak":true},{"text":"നിഷ്ഠുരവാഴ്ച നിന്നിൽനിന്ന് അകന്നിരിക്കും;","poem":1},{"text":"നിനക്കു ഭയമുണ്ടാകുകയില്ല.","poem":2},{"text":"ഭീതിയോ, നിന്നിൽനിന്നു വളരെ അകലെ ആയിരിക്കും;","poem":1},{"text":"അതു നിന്റെ അടുത്തു വരികയില്ല.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ആരെങ്കിലും നിനക്കെതിരേ യുദ്ധംചെയ്യുന്നെങ്കിൽ, അത് എന്റെ ഹിതപ്രകാരം ആയിരിക്കുകയില്ല;","poem":1},{"text":"നിന്നെ ആക്രമിക്കുന്നവരെല്ലാം നിനക്കു കീഴടങ്ങുകതന്നെചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“ഇതാ, ഞാനാണ്, കരിക്കട്ടമേൽ കാറ്റടിച്ച് അഗ്നിജ്വാല ഉണ്ടാക്കുകയും","poem":1},{"text":"അതതു പണിക്കുള്ള ആയുധം നിർമിക്കുകയും ചെയ്യുന്ന","poem":2},{"lineBreak":true},{"text":"ഇരുമ്പുപണിക്കാരന്റെയും സ്രഷ്ടാവ്.","poem":2},{"text":"വിനാശം വിതയ്ക്കാനായി സംഹാരകനെയും സൃഷ്ടിച്ചത് ഞാനാണ്.","poem":1}]},{"type":"verse","number":17,"content":[{"text":"നിന്നെ എതിർക്കാനായി നിർമിച്ചിരിക്കുന്ന ഒരു ആയുധവും സഫലമാകുകയില്ല,","poem":2},{"lineBreak":true},{"text":"നിനക്കെതിരേ കുറ്റമാരോപിക്കുന്ന എല്ലാ വാദമുഖങ്ങളെയും നീ ഖണ്ഡിക്കും.","poem":2},{"text":"ഇത് യഹോവയുടെ ദാസന്മാരുടെ അവകാശവും","poem":1},{"text":"എന്റെ പക്കൽനിന്ന് അവർക്കു ലഭിക്കുന്ന കുറ്റവിമുക്തിയുമാണ്,”","poem":2},{"text":"എന്ന് യഹോവ അരുളിച്ചെയ്യുന്നു.","poem":4}]}],"footnotes":[{"noteId":73,"caller":"+","text":"ഈ വാക്കിനുള്ള എബ്രായപദത്തിന്റെ അർഥം വ്യക്തമല്ല.","reference":{"chapter":54,"verse":11}}]},"thisChapterLink":"/api/mal_bib/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}