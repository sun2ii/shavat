{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":57,"content":[{"type":"verse","number":1,"content":[{"text":"നീതിനിഷ്ഠർ നശിക്കുന്നു,","poem":1},{"text":"ആരും അതു ഗൗനിക്കുന്നില്ല;","poem":2},{"text":"വിശ്വസ്തർ മരിച്ചു മാറ്റപ്പെടുന്നു,","poem":1},{"text":"ആരും മനസ്സിലാക്കുന്നില്ല.","poem":2},{"text":"വരാനുള്ള ദോഷത്തിൽനിന്ന്","poem":1},{"text":"നീതിനിഷ്ഠർ എടുത്തുമാറ്റപ്പെടുന്നതിനാൽത്തന്നെ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"പരമാർഥതയോടെ ജീവിക്കുന്നവരെല്ലാം","poem":1},{"text":"സ്വസ്ഥതയിലേക്കു പ്രവേശിക്കും;","poem":2},{"lineBreak":true},{"text":"അവർ തങ്ങളുടെ മരണക്കിടക്കയിൽ വിശ്രമം നേടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“എന്നാൽ മന്ത്രവാദിനിയുടെ മക്കളേ,","poem":1},{"text":"വ്യഭിചാരിയുടെയും വേശ്യയുടെയും സന്തതിയേ, ഇങ്ങോട്ട് അടുത്തുവരിക.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ആരെയാണു നിങ്ങൾ പരിഹസിക്കുന്നത്?","poem":1},{"text":"ആർക്കെതിരേയാണു നിങ്ങൾ അവജ്ഞയോടെ നോക്കുകയും","poem":2},{"lineBreak":true},{"text":"വായ്‌പിളർന്ന് നാക്കുനീട്ടുകയും ചെയ്യുന്നത്?","poem":2},{"text":"നിങ്ങൾ അതിക്രമത്തിന്റെ മക്കളും","poem":1},{"text":"വ്യാജ സന്തതികളുമല്ലേ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"കരുവേലകങ്ങൾക്കരികിലും","poem":1},{"text":"ഓരോ ഇലതൂർന്ന മരത്തിൻകീഴിലും നിങ്ങൾ കാമാതുരരാകുന്നു.","poem":2},{"text":"താഴ്വരകളിൽ പാറപ്പിളർപ്പുകൾക്കുതാഴേ","poem":1},{"text":"നിങ്ങൾ കുഞ്ഞുങ്ങളെ ബലിയർപ്പിക്കുന്നില്ലേ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അരുവികളിലെ മിനുസമുള്ള കല്ലുകളാണ് നിന്റെ വിഗ്രഹങ്ങൾ;","poem":1},{"text":"അതുതന്നെ നിന്റെ ഓഹരി.","poem":2},{"text":"അതേ, അവയ്ക്കാണു നിങ്ങൾ പാനീയബലിയും","poem":1},{"text":"ഭോജനബലിയും അർപ്പിച്ചിരിക്കുന്നത്.","poem":2},{"lineBreak":true},{"text":"ഇതെല്ലാം കണ്ടശേഷവും ഞാൻ ക്ഷമിക്കണമോ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"പൊക്കമുള്ള വൻമലയിൽ നീ നിന്റെ കിടക്കവിരിച്ചു;","poem":1},{"text":"യാഗമർപ്പിക്കാൻ അവിടേക്കാണല്ലോ നീ കയറിപ്പോയത്.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"വാതിലുകൾക്കും കട്ടിളകൾക്കും പിന്നിലായി","poem":1},{"text":"നീ അന്യദേവതകളുടെ ചിഹ്നങ്ങൾ പതിച്ചിരിക്കുന്നു.","poem":2},{"text":"എന്നെ ഉപേക്ഷിച്ച്, നീ നിന്റെ കിടക്ക അനാവരണംചെയ്തു,","poem":1},{"text":"അതിന്മേൽ കയറി അതു വിശാലമായി തുറന്നിട്ടു;","poem":2},{"text":"നീ ആരുടെ കിടക്കയാണോ ഇഷ്ടപ്പെട്ടത് അവരുമായി ഒരു സന്ധിചെയ്ത്,","poem":1},{"text":"അവരുടെ നഗ്നശരീരങ്ങളെ ആസക്തിയോടുകൂടെ നോക്കി.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"നീ ഒലിവെണ്ണയുമായി മോലെക്കിന്റെ","poem":1},{"noteId":74},{"text":"അടുക്കൽച്ചെന്നു,","poem":1},{"text":"നിന്റെ പരിമളവർഗങ്ങൾ വർധിപ്പിച്ചു.","poem":2},{"text":"നിന്റെ പ്രതിനിധികളെ","poem":1},{"noteId":75},{"text":"നീ ദൂരസ്ഥലങ്ങളിലേക്കയച്ചു;","poem":1},{"text":"നീ പാതാളംവരെ ഇറങ്ങിച്ചെല്ലുകയും ചെയ്തു!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"നിന്റെ വഴിയുടെ ദൈർഘ്യത്താൽ നീ തളർന്നു,","poem":1},{"text":"എന്നിട്ടും ‘ആശയറ്റിരിക്കുന്നു,’ എന്നു നീ പറഞ്ഞില്ല.","poem":2},{"text":"നിന്റെ ശക്തിയുടെ നവീകരണം നീ കണ്ടെത്തി","poem":1},{"text":"അതുകൊണ്ടു നീ ക്ഷീണിച്ചില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ആരെ ഭയപ്പെട്ടിട്ടായിരുന്നു","poem":1},{"text":"നീ എന്നോടു വ്യാജം പറയുകയും","poem":2},{"text":"എന്നെ ഓർക്കാതെ","poem":1},{"text":"അവഗണിക്കുകയും ചെയ്തത്?","poem":2},{"text":"ഞാൻ ദീർഘകാലം നിശ്ശബ്ദനായിരിക്കുകയാലല്ലേ","poem":1},{"text":"നീ എന്നെ ഭയപ്പെടാതിരുന്നത്?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"നിന്റെ നീതിയും നിന്റെ പ്രവൃത്തിയും ഞാൻ വെളിച്ചത്താക്കും,","poem":1},{"text":"അവ നിനക്കു പ്രയോജനം ചെയ്യുകയില്ല.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"നീ നിലവിളിക്കുമ്പോൾ","poem":1},{"text":"നിന്റെ വിഗ്രഹങ്ങളുടെ ശേഖരം നിന്നെ രക്ഷിക്കട്ടെ!","poem":2},{"text":"കാറ്റ് അവ എല്ലാറ്റിനെയും തൂത്തെറിയും,","poem":1},{"text":"കേവലം ഒരു ശ്വാസം അവയെ പറപ്പിച്ചുകളയും.","poem":2},{"text":"എന്നാൽ എന്നിൽ ശരണപ്പെടുന്നവൻ","poem":1},{"text":"ദേശം കൈവശമാക്കുകയും","poem":2},{"lineBreak":true},{"text":"എന്റെ വിശുദ്ധപർവതത്തെ അവകാശമാക്കുകയും ചെയ്യും.”","poem":2}]},{"type":"heading","content":["മനം തകർന്നവർക്ക് ആശ്വാസം"]},{"type":"verse","number":14,"content":["അവിടന്ന് അരുളിച്ചെയ്യുന്നു:",{"text":"“പണിയുക, പണിയുക, വഴിയൊരുക്കുക!","poem":1},{"text":"എന്റെ ജനത്തിന്റെ വഴിയിൽനിന്നു പ്രതിബന്ധം നീക്കിക്കളയുക.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഉന്നതനും ശ്രേഷ്ഠനും അനശ്വരനും","poem":1},{"text":"പരിശുദ്ധൻ എന്ന നാമമുള്ളവനുമായ യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:","poem":2},{"text":"“ഉന്നതവും വിശുദ്ധവുമായ സ്ഥാനത്തു ഞാൻ വസിക്കുന്നു,","poem":1},{"text":"എന്നാൽ വിനയമുള്ളവരുടെ ആത്മാവിനു നവചൈതന്യം പകരുന്നതിനും","poem":2},{"text":"ഹൃദയം തകർന്നവരെ ആശ്വസിപ്പിക്കുന്നതിനുമായി","poem":1},{"text":"അനുതാപവും വിനയവുമുള്ളവരോടുംകൂടെ ഞാൻ വസിക്കും.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ഞാൻ എന്നേക്കും അവരോടു കുറ്റമാരോപിച്ചുകൊണ്ടിരിക്കുകയോ","poem":1},{"text":"എപ്പോഴും കോപിക്കുകയോ ചെയ്യുകയില്ല,","poem":2},{"text":"അങ്ങനെയായാൽ എന്റെതന്നെ സൃഷ്ടിയായ ജനം","poem":1},{"text":"ഞാൻനിമിത്തം തളർന്നുപോകുമല്ലോ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"പാപകരമായ അവരുടെ ആർത്തിനിമിത്തം ഞാൻ കോപാകുലനായി;","poem":1},{"text":"ഞാൻ അവരെ ശിക്ഷിച്ചു, കോപത്താൽ ഞാൻ മുഖം മറയ്ക്കുകയും ചെയ്തു,","poem":2},{"lineBreak":true},{"text":"എന്നിട്ടും അവർ തങ്ങൾക്കു ബോധിച്ച വഴിയിൽനടന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ഞാൻ അവരുടെ വഴികൾ മനസ്സിലാക്കി, എന്നാലും ഞാൻ അവരെ സൗഖ്യമാക്കും;","poem":1},{"text":"ഞാൻ അവരെ നയിക്കുകയും വിലപിക്കുന്നവരെ ആശ്വസിപ്പിക്കുകയും","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"അവരുടെ അധരങ്ങളിൽ സ്തോത്രധ്വനികൾ നൽകുകയുംചെയ്യുന്നു.","poem":2},{"text":"ദൂരസ്ഥർക്കും സമീപസ്ഥർക്കും സമാധാനം, അതേ, സമാധാനം!","poem":1},{"text":"ഞാൻ അവർക്കു സൗഖ്യംനൽകും,”","poem":2},{"text":"എന്നു യഹോവ അരുളിച്ചെയ്യുന്നു.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"എന്നാൽ ദുഷ്ടർ കലങ്ങിമറിയുന്ന കടൽപോലെയാണ്,","poem":1},{"text":"അതിനു സ്വസ്ഥമായിരിക്കാൻ കഴിയുകയില്ല,","poem":2},{"lineBreak":true},{"text":"അതിലെ വെള്ളം ചേറും ചെളിയും മേലോട്ടു കൊണ്ടുവരികയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“ദുഷ്ടർക്ക് ഒരു സമാധാനമില്ല എന്ന്,” എന്റെ ദൈവം അരുളിച്ചെയ്യുന്നു.","poem":1}]}],"footnotes":[{"noteId":74,"caller":"+","text":"അഥവാ, രാജാവിനെ","reference":{"chapter":57,"verse":9}},{"noteId":75,"caller":"+","text":"അഥവാ, വിഗ്രഹങ്ങളെ","reference":{"chapter":57,"verse":9}}]},"thisChapterLink":"/api/mal_bib/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}