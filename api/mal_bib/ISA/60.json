{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":60,"content":[{"type":"heading","content":["ജെറുശലേമിന്റെ മഹത്ത്വം"]},{"type":"verse","number":1,"content":[{"text":"“എഴുന്നേറ്റു പ്രകാശിക്കുക, നിന്റെ പ്രകാശം വന്നിരിക്കുന്നു,","poem":1},{"text":"യഹോവയുടെ തേജസ്സും നിന്റെമേൽ ഉദിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ഇതാ, അന്ധകാരം ഭൂമിയെയും","poem":1},{"text":"കൂരിരുട്ട് ജനതകളെയും മൂടുന്നു,","poem":2},{"text":"എന്നാൽ യഹോവ നിന്റെമേൽ ഉദിക്കും,","poem":1},{"text":"അവിടത്തെ തേജസ്സ് നിന്റെമേൽ പ്രത്യക്ഷമാകും.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"രാഷ്ട്രങ്ങൾ നിന്റെ പ്രകാശത്തിലേക്കും","poem":1},{"text":"രാജാക്കന്മാർ നിന്റെ ഉദയപ്രഭയിലേക്കും വരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“കണ്ണുകളുയർത്തി ചുറ്റും നോക്കുക:","poem":1},{"text":"അവരെല്ലാം ഒരുമിച്ചുകൂടി നിന്റെ അടുക്കൽ വരുന്നു;","poem":2},{"text":"നിന്റെ പുത്രന്മാർ ദൂരത്തുനിന്നുവരും","poem":1},{"text":"നിന്റെ പുത്രിമാരെ കൈകളിൽ എടുത്തുകൊണ്ടുവരും.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അപ്പോൾ നീ കണ്ടു ശോഭിക്കും,","poem":1},{"text":"നിന്റെ ഹൃദയം ആനന്ദാതിരേകത്താൽ മിടിക്കും;","poem":2},{"text":"സമുദ്രത്തിന്റെ ധനം നിന്റെ അടുക്കൽ കൊണ്ടുവരപ്പെടും,","poem":1},{"text":"രാഷ്ട്രങ്ങളുടെ സമ്പത്ത് നിന്റെ അടുക്കൽവരും.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഒട്ടകക്കൂട്ടങ്ങളാൽ നിന്റെ ദേശം നിറയും,","poem":1},{"text":"മിദ്യാനിലെയും ഏഫയിലെയും ഒട്ടകക്കുട്ടികളാലുംതന്നെ.","poem":2},{"text":"അവയെല്ലാം ശേബയിൽനിന്ന് വരും,","poem":1},{"text":"അവ സ്വർണവും സുഗന്ധവർഗവും കൊണ്ടുവന്ന്","poem":2},{"lineBreak":true},{"text":"യഹോവയ്ക്കു സ്തുതിഘോഷം മുഴക്കും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"കേദാരിലെ ആട്ടിൻപറ്റം നിന്റെ അടുക്കൽ ഒരുമിച്ചുകൂടും,","poem":1},{"text":"നെബായോത്തിലെ മുട്ടാടുകൾ നിന്നെ ശുശ്രൂഷിക്കും;","poem":2},{"text":"അവ എനിക്കു പ്രസാദമുള്ള യാഗമായി എന്റെ യാഗപീഠത്തിന്മേൽ വരും,","poem":1},{"text":"അങ്ങനെ എന്റെ മഹത്ത്വമുള്ള ആലയത്തെ ഞാൻ അലങ്കരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“മേഘംപോലെയും തങ്ങളുടെ കൂടുകളിലേക്ക് പ്രാവുകൾപോലെയും","poem":1},{"text":"പറന്നുവരുന്ന ഇവർ ആര്?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"നിശ്ചയമായും ദ്വീപുകൾ എങ്കലേക്കു നോക്കുന്നു;","poem":1},{"text":"നിന്റെ മക്കളെ ദൂരത്തുനിന്ന് കൊണ്ടുവരുന്ന","poem":2},{"lineBreak":true},{"text":"തർശീശ് കപ്പലുകളാണ് മുൻനിരയിൽ,","poem":2},{"text":"ഇസ്രായേലിന്റെ പരിശുദ്ധനായ","poem":1},{"text":"നിന്റെ ദൈവമായ യഹോവയെ ആദരിക്കാനായി,","poem":2},{"text":"വെള്ളിയും സ്വർണവുമായാണ് അവരുടെ വരവ്,","poem":1},{"text":"കാരണം അവിടന്ന് നിന്നെ പ്രതാപം അണിയിച്ചല്ലോ.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“വിദേശികൾ നിന്റെ മതിലുകൾ പുനർനിർമിക്കും,","poem":1},{"text":"അവരുടെ രാജാക്കന്മാർ നിന്നെ സേവിക്കും.","poem":2},{"text":"എന്റെ ക്രോധത്തിൽ ഞാൻ നിന്നെ അടിച്ചു,","poem":1},{"text":"എങ്കിലും എന്റെ ദയയാൽ ഞാൻ നിന്നോടു കരുണകാണിക്കും.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"രാഷ്ട്രങ്ങളുടെ സമ്പത്ത് ജനം കൊണ്ടുവരുന്നതിനും—","poem":1},{"text":"ഘോഷയാത്രയിൽ അവരുടെ രാജാക്കന്മാരെ നിന്റെ അടുക്കൽ കൊണ്ടുവരുന്നതിനും;","poem":2},{"text":"നിന്റെ കവാടങ്ങൾ എപ്പോഴും തുറന്നിരിക്കും,","poem":1},{"text":"അവ രാവും പകലും ഒരിക്കലും അടയ്ക്കപ്പെടാതിരിക്കും.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"നിന്നെ സേവിക്കാത്ത ജനതയും രാജ്യവും നാശമടയും;","poem":1},{"text":"അതേ, ആ രാജ്യങ്ങൾ നിശ്ശേഷം ശൂന്യമാകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“എന്റെ വിശുദ്ധമന്ദിരത്തെ അലങ്കരിക്കുന്നതിന്,","poem":1},{"text":"ലെബാനോന്റെ മഹത്ത്വം നിന്റെ അടുക്കൽവരും","poem":2},{"text":"സരളവൃക്ഷവും പൈനും പുന്നയും ഒരുമിച്ചു നിന്റെ അടുക്കൽവരും.","poem":1},{"text":"അങ്ങനെ ഞാൻ എന്റെ പാദങ്ങൾക്കായി ആ സ്ഥലത്തെ മഹത്ത്വപ്പെടുത്തും.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"നിന്നെ പീഡിപ്പിച്ചവരുടെ മക്കളും വണങ്ങിക്കൊണ്ടു നിന്റെ അടുക്കൽവരും;","poem":1},{"text":"നിന്നെ നിന്ദിച്ച എല്ലാവരും നിന്റെ പാദത്തിൽ നമസ്കരിക്കും;","poem":2},{"text":"അവർ നിന്നെ യഹോവയുടെ നഗരമെന്നും","poem":1},{"text":"ഇസ്രായേലിൻ പരിശുദ്ധന്റെ സീയോനെന്നും വിളിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“ഒരു മനുഷ്യനും നിന്നിൽക്കൂടി കടന്നുപോകാത്തവിധം","poem":1},{"text":"നീ ഉപേക്ഷിക്കപ്പെട്ടവളും നിന്ദ്യയും ആയിത്തീർന്നതുപോലെ","poem":2},{"text":"ഞാൻ നിന്നെ നിത്യപ്രതാപമുള്ളവളും","poem":1},{"text":"അനേകം തലമുറകൾക്ക് ആനന്ദവും ആക്കിത്തീർക്കും.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"നീ രാഷ്ട്രങ്ങളുടെ പാൽ കുടിക്കും,","poem":1},{"text":"രാജകീയ സ്തനങ്ങൾ നുകരും;","poem":2},{"noteId":77},{"text":"യഹോവയായ ഞാൻ നിന്റെ രക്ഷകനും","poem":1},{"text":"യാക്കോബിന്റെ ശക്തൻ നിന്റെ വീണ്ടെടുപ്പുകാരനും എന്നു നീ അറിയും.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ഞാൻ വെങ്കലത്തിനു പകരം സ്വർണം വരുത്തും,","poem":1},{"text":"ഇരുമ്പിനു പകരം വെള്ളിയും.","poem":2},{"text":"മരത്തിനു പകരം വെങ്കലവും","poem":1},{"text":"കല്ലിനുപകരം ഇരുമ്പും ഞാൻ വരുത്തും.","poem":2},{"text":"ഞാൻ സമാധാനത്തെ നിന്റെ ദേശാധിപതികളായും","poem":1},{"text":"നീതിയെ നിന്റെ ഭരണകർത്താക്കളായും തീർക്കും.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ഇനിമേൽ അക്രമം നിന്റെ ദേശത്തു കേൾക്കുകയില്ല,","poem":1},{"text":"ശൂന്യതയും നാശവും നിന്റെ അതിരിനുള്ളിൽ ഉണ്ടാകുകയില്ല.","poem":2},{"text":"എന്നാൽ നിന്റെ മതിലുകൾക്കു നീ രക്ഷ എന്നും","poem":1},{"text":"നിന്റെ കവാടങ്ങൾക്ക് സ്തോത്രം എന്നും നീ പേരു വിളിക്കും.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ഇനിമേൽ പകൽസമയത്ത് നിന്റെ പ്രകാശം സൂര്യനല്ല,","poem":1},{"text":"രാത്രി നിനക്കു ചന്ദ്രനിൽനിന്ന് നിലാവെട്ടം ലഭിക്കുകയുമില്ല;","poem":2},{"text":"യഹോവ നിനക്കു നിത്യപ്രകാശവും","poem":1},{"text":"നിന്റെ ദൈവം നിന്റെ മഹത്ത്വവും ആയിരിക്കും.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"നിന്റെ സൂര്യൻ ഇനിയൊരിക്കലും അസ്തമിക്കുകയില്ല,","poem":1},{"text":"നിന്റെ ചന്ദ്രൻ മറഞ്ഞുപോകുകയുമില്ല;","poem":2},{"text":"യഹോവയായിരിക്കും നിന്റെ നിത്യപ്രകാശം,","poem":1},{"text":"നിന്റെ വിലാപകാലം അവസാനിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അപ്പോൾ നിന്റെ ജനമെല്ലാം നീതിനിഷ്ഠരാകുകയും","poem":1},{"text":"അവർ ഭൂപ്രദേശം എന്നേക്കും കൈവശമാക്കുകയും ചെയ്യും.","poem":2},{"text":"എന്റെ മഹത്ത്വം പ്രദർശിപ്പിക്കുന്നതിനായി","poem":1},{"text":"ഞാൻ നട്ട നടുതലയും","poem":2},{"lineBreak":true},{"text":"എന്റെ കൈകളുടെ പ്രവൃത്തിയുമായിരിക്കും അവർ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"കുറഞ്ഞവൻ ആയിരവും","poem":1},{"text":"ചെറിയവൻ ഒരു ശക്തിയേറിയ രാഷ്ട്രവും ആയിത്തീരും.","poem":2},{"text":"ഞാൻ യഹോവ ആകുന്നു;","poem":1},{"text":"അതിന്റെ സമയത്തു ഞാൻ അതു വേഗത്തിൽ നിറവേറ്റും.”","poem":2}]}],"footnotes":[{"noteId":77,"caller":"+","text":"അതായത്, വിദേശരാജ്യങ്ങൾ ഇസ്രായേലിന് സംരക്ഷണം നൽകും.","reference":{"chapter":60,"verse":16}}]},"thisChapterLink":"/api/mal_bib/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/59.json","previousChapterAudioLinks":{},"numberOfVerses":22}