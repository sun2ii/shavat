{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":61,"content":[{"type":"heading","content":["യഹോവയുടെ പ്രസാദവർഷം"]},{"type":"verse","number":1,"content":[{"text":"ദരിദ്രരോടു സുവിശേഷം അറിയിക്കാൻ","poem":1},{"text":"യഹോവയായ കർത്താവ് എന്നെ അഭിഷേകം ചെയ്തിരിക്കുകയാൽ","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ ആത്മാവ് എന്റെമേലുണ്ട്.","poem":2},{"text":"ഹൃദയം തകർന്നവരുടെ മുറിവു കെട്ടുന്നതിനും","poem":1},{"text":"തടവുകാർക്കു സ്വാതന്ത്ര്യം പ്രഖ്യാപിക്കുന്നതിനും","poem":2},{"lineBreak":true},{"text":"ബന്ധിതരെ മോചിപ്പിക്കുന്നതിനും അവിടന്ന് എന്നെ അയച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"യഹോവയുടെ പ്രസാദവർഷവും","poem":1},{"text":"നമ്മുടെ ദൈവത്തിന്റെ പ്രതികാരദിവസവും പ്രസംഗിക്കാനും","poem":2},{"text":"വിലപിക്കുന്നവരെയെല്ലാം ആശ്വസിപ്പിക്കാനും","poem":1}]},{"type":"verse","number":3,"content":[{"text":"സീയോനിലെ ദുഃഖിതർക്കു—","poem":2},{"text":"വെണ്ണീറിനു പകരം","poem":1},{"text":"തലപ്പാവ് അലങ്കാരമായും","poem":2},{"text":"വിലാപത്തിനു പകരം","poem":1},{"text":"ആനന്ദതൈലവും","poem":2},{"text":"വിഷാദഹൃദയത്തിനു പകരം","poem":1},{"text":"സ്തുതിയെന്ന മേലങ്കിയും നൽകുവാനും,","poem":2},"അവിടന്ന് എന്നെ അയച്ചിരിക്കുന്നു.",{"text":"അവിടത്തെ മഹത്ത്വം വെളിപ്പെടുത്തേണ്ടതിന്","poem":1},{"text":"യഹോവ നട്ടുവളർത്തിയ","poem":2},{"lineBreak":true},{"text":"നീതിയുടെ ഓക്കുമരങ്ങളാണ് അവർ എന്നു വിളിക്കപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"അവർ പൗരാണിക ശൂന്യശിഷ്ടങ്ങളെ പുതുക്കിപ്പണിയും,","poem":1},{"text":"പണ്ടു തകർക്കപ്പെട്ടതെല്ലാം കെട്ടിയുയർത്തും;","poem":2},{"text":"ശൂന്യനഗരങ്ങളെ അവർ പുനരുദ്ധരിക്കും,","poem":1},{"text":"തലമുറകളായി ശൂന്യമായിക്കിടക്കുന്നവയെത്തന്നെ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അപരിചിതർ നിങ്ങളുടെ ആട്ടിൻപറ്റങ്ങളെ മേയിക്കും;","poem":1},{"text":"വിദേശികൾ നിങ്ങളുടെ നിലങ്ങളിലും മുന്തിരിത്തോപ്പുകളിലും പണിയെടുക്കും.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"എന്നാൽ നിങ്ങൾ യഹോവയുടെ പുരോഹിതന്മാരെന്നു വിളിക്കപ്പെടും,","poem":1},{"text":"നിങ്ങൾക്കു നമ്മുടെ ദൈവത്തിന്റെ ശുശ്രൂഷകർ എന്ന പേരു നൽകപ്പെടും.","poem":2},{"text":"നിങ്ങൾ ഇതര രാഷ്ട്രങ്ങളുടെ സമ്പത്ത് അനുഭവിക്കും,","poem":1},{"text":"അവരുടെ ധനം നിങ്ങളുടെ പ്രശംസാവിഷയമായിത്തീരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"നിങ്ങളുടെ ലജ്ജയ്ക്കു പകരമായി","poem":1},{"text":"നിങ്ങൾക്ക് ഇരട്ടി പ്രതിഫലം ലഭിക്കും,","poem":2},{"text":"അപമാനത്തിനു പകരം","poem":1},{"text":"നിങ്ങൾ നിങ്ങളുടെ അവകാശത്തെക്കുറിച്ച് ആനന്ദിക്കും.","poem":2},{"text":"അങ്ങനെ നിങ്ങളുടെ ദേശത്ത് ഇരട്ടി ഓഹരി നിങ്ങൾക്കു ലഭിക്കും,","poem":1},{"text":"ശാശ്വതമായ ആനന്ദം നിങ്ങൾക്കുണ്ടാകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“കാരണം യഹോവ ആകുന്ന ഞാൻ, നീതിയെ സ്നേഹിക്കുന്നു;","poem":1},{"text":"കവർച്ചയും അതിക്രമവും ഞാൻ വെറുക്കുന്നു.","poem":2},{"text":"ഞാൻ വിശ്വസ്തതയോടെ എന്റെ ജനത്തിനു പ്രതിഫലംനൽകും,","poem":1},{"text":"അവരുമായി ഒരു നിത്യ ഉടമ്പടിയും ചെയ്യും.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവരുടെ സന്തതി രാഷ്ട്രങ്ങൾക്കിടയിലും","poem":1},{"text":"അവരുടെ പിൻഗാമികൾ ജനതകൾക്കിടയിലും അറിയപ്പെടും.","poem":2},{"text":"അവരെ കാണുന്നവരെല്ലാം അവർ","poem":1},{"text":"യഹോവ അനുഗ്രഹിച്ച ജനം എന്ന് അംഗീകരിക്കും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ഞാൻ യഹോവയിൽ അത്യന്തം ആനന്ദിക്കുന്നു;","poem":1},{"text":"എന്റെ ഹൃദയം എന്റെ ദൈവത്തിൽ സന്തോഷിക്കുന്നു.","poem":2},{"text":"മണവാളൻ തന്റെ ശിരസ്സ് പുരോഹിതനെപ്പോലെ തലപ്പാവുകൊണ്ട് അലങ്കരിക്കുന്നതുപോലെയും","poem":1},{"text":"മണവാട്ടി ആഭരണങ്ങൾ അണിയുന്നതുപോലെയും","poem":2},{"text":"അവിടന്ന് എന്നെ രക്ഷാവസ്ത്രം ധരിപ്പിക്കുകയും","poem":1},{"text":"നീതിയെന്ന പുറങ്കുപ്പായം അണിയിക്കുകയും ചെയ്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ഭൂമി അതിൽ തൈകളെ മുളപ്പിക്കുന്നതുപോലെയും","poem":1},{"text":"തോട്ടം അതിൽ വിതച്ച വിത്തു കിളിർപ്പിക്കുന്നതുപോലെയും","poem":2},{"text":"യഹോവയായ കർത്താവ് സകലജനതകളുടെയും മുമ്പിൽ","poem":1},{"text":"നീതിയും സ്തോത്രവും ഉയർന്നുവരാൻ ഇടയാക്കും.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}