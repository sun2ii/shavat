{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_bib","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവിന്റെ പ്രവചനം","order":23,"numberOfChapters":66,"sha256":"1dea2a29c2ff9fed4e056d7268e6925ff0b9367ac0da2c3fcb081ea4afce3d33","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_bib/ISA/66.json","totalNumberOfVerses":1288},"chapter":{"number":62,"content":[{"type":"heading","content":["സീയോന്റെ പുതിയ നാമം"]},{"type":"verse","number":1,"content":[{"text":"അവളുടെ കുറ്റവിമുക്തി പ്രഭാതകിരണങ്ങളുടെ പ്രസരിപ്പു‍പോലെയും","poem":1},{"text":"അവളുടെ രക്ഷ ജ്വലിക്കുന്ന പന്തംപോലെയും ആകുന്നതുവരെ","poem":2},{"text":"സീയോനുവേണ്ടി ഞാൻ നിശ്ശബ്ദമായിരിക്കുകയില്ല,","poem":1},{"text":"ജെറുശലേമിനുവേണ്ടി മൗനമായിരിക്കുകയുമില്ല.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"രാഷ്ട്രങ്ങൾ നിന്റെ കുറ്റവിമുക്തിയും","poem":1},{"text":"എല്ലാ രാജാക്കന്മാരും നിന്റെ മഹത്ത്വവും ദർശിക്കും;","poem":2},{"text":"യഹോവയുടെ വായ് കൽപ്പിച്ചുതരുന്ന","poem":1},{"text":"ഒരു പുതിയ പേരിനാൽ നീ വിളിക്കപ്പെടും.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"നീ യഹോവയുടെ കൈയിൽ ഒരു മഹത്ത്വകിരീടമായും","poem":1},{"text":"നിന്റെ ദൈവത്തിന്റെ കൈയിൽ രാജകീയ മകുടമായും തീരും.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"നീ ഇനിയൊരിക്കലും ഉപേക്ഷിക്കപ്പെട്ടവൾ","poem":1},{"noteId":78},{"text":"എന്നോ","poem":1},{"text":"നിന്റെ ദേശം വിജനദേശം","poem":2},{"noteId":79},{"text":"എന്നോ വിളിക്കപ്പെടുകയില്ല.","poem":2},{"text":"എന്നാൽ നീ ഹെഫ്സീബാ","poem":1},{"noteId":80},{"text":"എന്നും","poem":1},{"text":"നിന്റെ ദേശം ബെയൂലാ","poem":2},{"noteId":81},{"text":"എന്നും വിളിക്കപ്പെടും;","poem":2},{"text":"കാരണം യഹോവ നിന്നിൽ ആനന്ദിക്കുകയും","poem":1},{"text":"നിന്റെ ദേശം വിവാഹം ചെയ്യപ്പെട്ടതും ആയിത്തീരും.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ഒരു യുവാവു യുവതിയെ വിവാഹംചെയ്യുന്നതുപോലെ","poem":1},{"text":"നിന്റെ പുത്രന്മാർ","poem":2},{"noteId":82},{"text":"നിന്നെ അവകാശമാക്കും.","poem":2},{"text":"മണവാളൻ മണവാട്ടിയിൽ ആനന്ദിക്കുന്നതുപോലെ","poem":1},{"text":"നിന്റെ ദൈവം നിന്നിൽ ആനന്ദിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ജെറുശലേമേ, രാത്രിയും പകലും മൗനമായിരിക്കാത്ത","poem":1},{"text":"കാവൽക്കാരെ ഞാൻ നിന്റെ മതിലുകളിന്മേൽ നിരന്തരം വിന്യസിച്ചിരിക്കുന്നു.","poem":2},{"text":"യഹോവയെ വിളിച്ചപേക്ഷിക്കുന്നവരേ,","poem":1},{"text":"നിങ്ങൾ വിശ്രമിക്കാനേ പാടില്ല.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവിടന്ന് ജെറുശലേമിനെ സ്ഥാപിക്കുകയും അവളെ ഭൂമിയിൽ ഒരു പ്രശംസാവിഷയമാക്കുകയും ചെയ്യുന്നതുവരെ","poem":1},{"text":"അവിടത്തേക്ക് സ്വസ്ഥത നൽകരുത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"യഹോവ തന്റെ വലംകരത്തെയും ബലമുള്ള ഭുജത്തെയും ചൊല്ലി","poem":1},{"text":"ഇപ്രകാരം ശപഥംചെയ്തിരിക്കുന്നു:","poem":2},{"text":"“തീർച്ചയായും ഞാൻ നിന്റെ ധാന്യം","poem":1},{"text":"നിന്റെ ശത്രുവിനു ഭക്ഷണമായി കൊടുക്കുകയില്ല,","poem":2},{"text":"നിന്റെ അധ്വാനഫലമായ പുതുവീഞ്ഞ്","poem":1},{"text":"വിദേശികൾ ഇനിയൊരിക്കലും കുടിക്കുകയില്ല;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"എന്നാൽ അതിന്റെ വിളവെടുക്കുന്നവർ അതു ഭക്ഷിച്ച്","poem":1},{"text":"യഹോവയെ സ്തുതിക്കും,","poem":2},{"text":"അതു ശേഖരിക്കുന്നവർ എന്റെ വിശുദ്ധമന്ദിരത്തിന്റെ","poem":1},{"text":"അങ്കണത്തിൽവെച്ച് അതു പാനംചെയ്യും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"കടന്നുപോകുക, കവാടങ്ങളിലൂടെ കടന്നുപോകുക!","poem":1},{"text":"ഈ ജനത്തിനു വഴിയൊരുക്കുക.","poem":2},{"text":"നിരത്തുക, രാജവീഥി നിരത്തുക!","poem":1},{"text":"കല്ലുകൾ പെറുക്കിക്കളയുക.","poem":2},{"text":"രാഷ്ട്രങ്ങൾക്ക് ഒരു കൊടി ഉയർത്തുക.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ഇതാ, ഭൂമിയുടെ അറുതികളിലെല്ലാം","poem":1},{"text":"യഹോവ വിളംബരംചെയ്തിരിക്കുന്നു:","poem":2},{"text":"“ ‘ഇതാ, നിന്റെ രക്ഷ വരുന്നു!","poem":1},{"text":"ഇതാ, പ്രതിഫലം അവിടത്തെ പക്കലും","poem":2},{"text":"പാരിതോഷികം അവിടത്തോടൊപ്പവുമുണ്ട്,’","poem":1},{"text":"എന്നു സീയോൻപുത്രിയോടു പറയുക.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവർ വിശുദ്ധജനം എന്നു വിളിക്കപ്പെടും,","poem":1},{"text":"യഹോവയാൽ വീണ്ടെടുക്കപ്പെട്ടവർ എന്നുതന്നെ;","poem":2},{"text":"അന്വേഷിച്ചു കണ്ടെത്തപ്പെട്ടവൾ എന്നും","poem":1},{"text":"ഒരിക്കലും ഉപേക്ഷിക്കപ്പെടാത്ത നഗരം എന്നും വിളിക്കപ്പെടും.","poem":2}]}],"footnotes":[{"noteId":78,"caller":"+","text":"മൂ.ഭാ. അസൂബാ","reference":{"chapter":62,"verse":4}},{"noteId":79,"caller":"+","text":"മൂ.ഭാ. ശെമാമാ","reference":{"chapter":62,"verse":4}},{"noteId":80,"caller":"+","text":"എന്റെ ആനന്ദമായവൾ എന്നർഥം.","reference":{"chapter":62,"verse":4}},{"noteId":81,"caller":"+","text":"വിവാഹിത എന്നർഥം.","reference":{"chapter":62,"verse":4}},{"noteId":82,"caller":"+","text":"ചി.കൈ.പ്ര. നിർമാതാക്കൾ","reference":{"chapter":62,"verse":5}}]},"thisChapterLink":"/api/mal_bib/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}