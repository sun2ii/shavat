{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"JDG","translationId":"mal_bib","name":"ന്യായാധിപന്മാർ","commonName":"ന്യായാധിപന്മാർ","title":"ന്യായാധിപന്മാരുടെ പുസ്തകം","order":7,"numberOfChapters":21,"sha256":"68cd974891b0bb002a3ecedafde018e58579c6035ff34ba072ea212d52d90ecb","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/mal_bib/JDG/21.json","totalNumberOfVerses":616},"chapter":{"number":5,"content":[{"type":"heading","content":["ദെബോറായുടെ കീർത്തനം"]},{"type":"verse","number":1,"content":["അന്ന് ദെബോറായും അബീനോവാമിന്റെ മകനായ ബാരാക്കും ഈ ഗാനം ആലപിച്ചു:"]},{"type":"verse","number":2,"content":[{"text":"“പ്രഭുക്കന്മാർ ഇസ്രായേലിനെ നയിച്ചതിനും","poem":1},{"text":"ജനം സ്വയം സമർപ്പിച്ചതിനും","poem":2},{"lineBreak":true},{"text":"യഹോവയെ വാഴ്ത്തുക!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“രാജാക്കന്മാരേ, ഇതു കേൾക്കുക! പ്രഭുക്കന്മാരേ, ശ്രദ്ധിക്കുക!","poem":1},{"text":"ഞാൻ യഹോവയ്ക്കു പാടും; ഞാൻ പാടും;","poem":2},{"lineBreak":true},{"text":"ഇസ്രായേലിൻ ദൈവമായ യഹോവയ്ക്കു കീർത്തനം ചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“യഹോവേ, അങ്ങ് സേയീരിൽനിന്നു പുറപ്പെട്ടപ്പോൾ,","poem":1},{"text":"ഏദോം ദേശത്തുനിന്ന് അങ്ങു മുന്നോട്ട് നീങ്ങിയപ്പോൾ,","poem":2},{"text":"ഭൂമികുലുങ്ങി, ആകാശം പൊഴിഞ്ഞു,","poem":1},{"text":"മേഘങ്ങൾ വെള്ളം ചൊരിഞ്ഞു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"മലകൾ യഹോവയുടെ സന്നിധിയിൽ, സീനായിമലയിൽ പ്രത്യക്ഷനായ അദ്വിതീയന്റെ മുന്നിൽത്തന്നെ പ്രകമ്പനംകൊണ്ടു,","poem":1},{"text":"ഇസ്രായേലിൻ ദൈവമായ യഹോവയുടെ മുന്നിൽത്തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“അനാത്തിൻ പുത്രൻ ശംഗരിൻനാളിലും","poem":1},{"text":"യായേലിൻ കാലത്തും, രാജവീഥികൾ ശൂന്യമായി;","poem":2},{"lineBreak":true},{"text":"യാത്രക്കാർ ഊടുവഴികളിൽ ഉഴറിനടന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ദെബോറായായ ഞാൻ എഴുന്നേൽക്കുന്നതുവരെ,","poem":1},{"text":"ഇസ്രായേലിനൊരു മാതാവായി എഴുന്നേൽക്കുന്നതുവരെ,","poem":2},{"lineBreak":true},{"text":"ഇസ്രായേലിൽ ഗ്രാമ്യജീവിതം സ്തംഭിച്ചുപോയി.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"യുദ്ധം ഗോപുരകവാടത്തിലെത്തിയപ്പോൾ","poem":1},{"text":"ദൈവം പുതിയ നേതൃത്വത്തെ തെരഞ്ഞെടുത്തു,","poem":2},{"text":"ഇസ്രായേലിന്റെ നാൽപ്പതിനായിരത്തിനിടയിൽ","poem":1},{"text":"പരിചയും കുന്തവും കണ്ടതേയില്ല.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"എന്റെ ഹൃദയം ഇസ്രായേൽ പ്രഭുക്കന്മാരോടും","poem":1},{"text":"ജനത്തിലെ സ്വമേധാസേവകരോടും ആകുന്നു.","poem":2},{"lineBreak":true},{"text":"യഹോവയെ വാഴ്ത്തുക!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“പരവതാനികൊണ്ടുള്ള ഇരിപ്പിടങ്ങളിൽ ഇരുന്ന്","poem":1},{"text":"വെള്ളക്കഴുതപ്പുറത്തു യാത്രചെയ്യുന്നവരേ,","poem":2},{"lineBreak":true},{"text":"പാതകളിലൂടെ നടന്നുനീങ്ങുന്നവരേ,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"നീർപ്പാത്തികൾക്കരികെയിരുന്ന് പാടുന്നവരുടെ","poem":1},{"noteId":16},{"text":"ശബ്ദം.","poem":1},{"text":"അവിടെ അവർ യഹോവയുടെ വിജയഗാഥകൾ,","poem":2},{"lineBreak":true},{"text":"ഇസ്രായേലിലെ ഗ്രാമീണരുടെ യുദ്ധവിജയം ആലപിക്കുന്നതു കേട്ടാലും.","poem":2},{"lineBreak":true},{"text":"“അന്ന് യഹോവയുടെ ജനം","poem":1},{"text":"നഗരകവാടത്തിലേക്ക് ഇറങ്ങിച്ചെന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"‘ഉണരൂ, ഉണരൂ, ദെബോറേ!","poem":1},{"text":"ഉണരൂ, ഉണരൂ, ഉണർന്ന് ഗാനം ആലപിക്കൂ!","poem":2},{"text":"ഉണരൂ ബാരാക്കേ!","poem":1},{"text":"അബീനോവാമിന്റെ പുത്രാ, എഴുന്നേറ്റ് താങ്കളുടെ ബന്ധിതരെ പിടിച്ചുകൊണ്ടുപോയ്ക്കൊൾക.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“അന്ന് ശ്രേഷ്ഠരിൽ ശേഷിച്ചവർ ഇറങ്ങിവന്നു;","poem":1},{"text":"യഹോവയുടെ ജനം യോദ്ധാക്കൾക്കെതിരേ എന്റെ അടുക്കൽ ഇറങ്ങിവന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അമാലേക്കിൽ വേരുള്ളവർ എഫ്രയീമിൽനിന്ന് വന്നു;","poem":1},{"text":"നിന്നെ അനുഗമിച്ചവരിൽ ബെന്യാമീൻ ഉണ്ട്.","poem":2},{"text":"മാഖീരിൽനിന്നു സേനാപതികളും","poem":1},{"text":"സെബൂലൂനിൽനിന്നു സൈന്യാധിപന്റെ","poem":2},{"noteId":17},{"text":"ദണ്ഡുവഹിച്ചവരും വന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"യിസ്സാഖാർ പ്രഭുക്കന്മാർ ദെബോറായോടുകൂടെ;","poem":1},{"text":"അതേ, യിസ്സാഖാർ ബാരാക്കിനോടുകൂടെ","poem":2},{"lineBreak":true},{"text":"താഴ്വരയിലേക്കു ചാടിപ്പുറപ്പെട്ടു.","poem":2},{"text":"രൂബേന്യദേശത്തെ ജനം അവരുടെ","poem":1},{"text":"ഹൃദയങ്ങളുടെ ആഴങ്ങളിൽ ആരാഞ്ഞു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ആട്ടിൻകൂട്ടങ്ങൾക്കായുള്ള കുഴലൂത്തുകേട്ടുകൊണ്ട്","poem":1},{"text":"നീ തീക്കുണ്ഡങ്ങൾക്കരികെ ഇരുന്നതെന്തിന്?","poem":2},{"text":"രൂബേന്യദേശത്തെ ജനം അവരുടെ","poem":1},{"text":"ഹൃദയങ്ങളുടെ ആഴങ്ങളിൽ ആരാഞ്ഞു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ഗിലെയാദ് യോർദാനക്കരെ പാർത്തു.","poem":1},{"text":"ദാൻ കപ്പലുകൾക്കരികെ തങ്ങിനിൽക്കുന്നതുമെന്ത്?","poem":2},{"text":"ആശേർ സമുദ്രതീരത്ത് നിശ്ചലനായി ഇരുന്നു;","poem":1},{"text":"തുറമുഖങ്ങളിൽ വാസമുറപ്പിച്ചു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"സെബൂലൂൻ സ്വന്തം ജീവൻ ത്യജിച്ചുപൊരുതിയ ജനം;","poem":1},{"text":"നഫ്താലി പോർക്കളമേടുകളിൽ അങ്ങനെതന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“രാജാക്കന്മാർ വന്നു; അവർ പൊരുതി;","poem":1},{"text":"കനാന്യരാജാക്കന്മാർ പൊരുതി.","poem":2},{"text":"താനാക്കിൽവെച്ച് മെഗിദ്ദോ വെള്ളത്തിനരികെത്തന്നെ.","poem":1},{"text":"വെള്ളി അവർ കൊള്ളയായി കൊണ്ടുപോയതുമില്ല.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ആകാശത്തുനിന്ന് നക്ഷത്രങ്ങൾ പൊരുതി,","poem":1},{"text":"സഞ്ചാരപഥങ്ങളിൽനിന്ന് അവ സീസെരയോടു പൊരുതി.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"കീശോൻതോട്, പുരാതനനദിയായ കീശോൻതോട്,","poem":1},{"text":"അവരെ ഒഴുക്കിക്കളഞ്ഞു,","poem":2},{"lineBreak":true},{"text":"എൻ മനമേ, നീ ബലത്തോടെ മുന്നേറുക.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"അപ്പോൾ കുതിരക്കുളമ്പുകൾ ഇടിനാദംമുഴക്കി;","poem":1},{"text":"ആൺകുതിരകൾ കുതിച്ചു കുതിച്ചു പാഞ്ഞു.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"‘മെരോസിനെ ശപിക്കുക,","poem":1},{"text":"അതിലെ നിവാസികളെ ഉഗ്രമായി ശപിക്കുക,’ യഹോവയുടെ ദൂതൻ അരുളി.","poem":2},{"text":"‘കാരണം അവർ യഹോവയ്ക്കു തുണയായി,","poem":1},{"text":"ശക്തന്മാർക്കെതിരേ യഹോവയ്ക്കു തുണയായി, വന്നില്ല.’","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“കേന്യനായ ഹേബെരിന്റെ ഭാര്യ യായേൽ,","poem":1},{"text":"സ്ത്രീകളിൽ അനുഗ്രഹിക്കപ്പെട്ടവൾ,","poem":2},{"lineBreak":true},{"text":"കൂടാരവാസിനികളാം നാരികളിലേറ്റവും അനുഗ്രഹിക്കപ്പെട്ടവൾ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"അദ്ദേഹം തണ്ണീർ ചോദിച്ചു, അവൾ ക്ഷീരം പകർന്നു;","poem":1},{"text":"രാജകീയ പാത്രത്തിൽ അവൾ അദ്ദേഹത്തിന് തൈരു കൊണ്ടുവന്നു.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"കൂടാരത്തിന്റെ കുറ്റിക്ക് അവൾ കൈനീട്ടി,","poem":1},{"text":"തന്റെ വലങ്കൈനീട്ടിയവൾ വേലക്കാരുടെ ചുറ്റികയെടുത്തു.","poem":2},{"text":"സീസെരയെ അവൾ ആഞ്ഞടിച്ചു,","poem":1},{"text":"അയാളുടെ തലതകർത്തു, ചെന്നി അവൾ കുത്തിത്തുളച്ചു.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"അവളുടെ കാൽക്കൽ അയാൾ കുഴഞ്ഞുവീണു,","poem":1},{"text":"വീണയാൾ അവിടെ വീണുകിടന്നു;","poem":2},{"text":"അവളുടെ കാൽക്കൽത്തന്നെ അയാൾ കുഴഞ്ഞുവീണു.","poem":1},{"text":"വീണിടത്തുതന്നെ അയാൾ മരിച്ചുകിടന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“സീസെരയുടെ മാതാവ് ജനാലയിലൂടെ കുനിഞ്ഞു നോക്കിക്കൊണ്ടിരുന്നു;","poem":1},{"text":"ജാലകത്തിലൂടെ നിലവിളിച്ചുകൊണ്ട്:","poem":2},{"text":"‘അവന്റെ തേർ വരാൻ വൈകുന്നത് എന്ത്?","poem":1},{"text":"രഥചക്രങ്ങളുടെ ഝടഝടാരവം താമസിക്കുന്നതെന്ത്?’","poem":2}]},{"type":"verse","number":29,"content":[{"text":"അവളുടെ ജ്ഞാനവതികളാം സഖികൾ അതിനുത്തരം പറഞ്ഞു;","poem":1},{"text":"അവൾ തന്നോടുതന്നെ ഈ വാക്കുകൾ ആവർത്തിച്ചുകൊണ്ടിരുന്നു:","poem":2}]},{"type":"verse","number":30,"content":[{"text":"‘കിട്ടിയകൊള്ള അവർ പങ്കിടുകയല്ലയോ?","poem":1},{"text":"ഓരോ പുരുഷനും ഒന്നോ രണ്ടോ കന്യകമാർവീതം,","poem":2},{"text":"നിറപ്പകിട്ടാർന്ന വസ്ത്രങ്ങൾ സീസെരയുടെ കൊള്ളമുതൽ;","poem":1},{"text":"നിറപ്പകിട്ടാർന്ന ചിത്രത്തയ്യലുള്ള വസ്ത്രങ്ങൾതന്നെ,","poem":2},{"text":"എനിക്കു തോളിലണിയാൻ വളരെയധികം ചിത്രത്തയ്യലുള്ള വസ്ത്രങ്ങൾ—","poem":1},{"text":"ഇതെല്ലാമല്ലയോ കൊള്ളമുതൽ?’","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“യഹോവേ, അവിടത്തെ ശത്രുക്കൾ ഒക്കെയും ഇതുപോലെ നശിക്കട്ടെ.","poem":1},{"text":"എന്നാൽ അങ്ങയെ സ്നേഹിക്കുന്നവർ","poem":2},{"lineBreak":true},{"text":"സൂര്യൻ പ്രതാപത്തോടെ ഉദിക്കുന്നതുപോലെ ആകട്ടെ!”","poem":2},"ഇതിനുശേഷം ദേശത്തിനു നാൽപ്പതുവർഷം സ്വസ്ഥത ഉണ്ടായി."]}],"footnotes":[{"noteId":16,"caller":"+","text":"ഈ വാക്കിനുള്ള എബ്രായപദത്തിന്റെ അർഥം വ്യക്തമല്ല.","reference":{"chapter":5,"verse":11}},{"noteId":17,"caller":"+","text":"ഈ വാക്കിനുള്ള എബ്രായപദത്തിന്റെ അർഥം വ്യക്തമല്ല.","reference":{"chapter":5,"verse":14}}]},"thisChapterLink":"/api/mal_bib/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}