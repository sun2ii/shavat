{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"JER","translationId":"mal_bib","name":"യിരെമ്യാവ്","commonName":"യിരെമ്യാവ്","title":"യിരെമ്യാവിന്റെ പ്രവചനം","order":24,"numberOfChapters":52,"sha256":"2dbf0b59c0d7609c384e3996dd9e78af48c924fb82932b814ee8a851f0dada36","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/mal_bib/JER/52.json","totalNumberOfVerses":1358},"chapter":{"number":10,"content":[{"type":"heading","content":["യഹോവയും വിഗ്രഹങ്ങളും"]},{"type":"verse","number":1,"content":["ഇസ്രായേൽഗൃഹമേ, യഹോവ നിങ്ങളോടു സംസാരിക്കുന്ന വചനം കേൾക്കുക."]},{"type":"verse","number":2,"content":["യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:",{"text":"“ഇതര ജനതകളുടെ ജീവിതരീതി അഭ്യസിക്കുകയോ","poem":1},{"text":"ആകാശത്തിലെ ചിഹ്നങ്ങൾ കണ്ട് അവർ പരിഭ്രമിക്കുമ്പോലെ","poem":2},{"lineBreak":true},{"text":"നിങ്ങൾ പരിഭ്രാന്തരാകുകയോ അരുത്.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ജനതകളുടെ ആചാരങ്ങൾ അർഥശൂന്യമാണ്;","poem":1},{"text":"അവർ കാട്ടിൽനിന്ന് ഒരു മരം വെട്ടുന്നു,","poem":2},{"lineBreak":true},{"text":"ആശാരി തന്റെ ഉളികൊണ്ട് അതിനു രൂപംവരുത്തുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവർ അതിനെ വെള്ളികൊണ്ടും സ്വർണംകൊണ്ടും അലങ്കരിക്കുന്നു;","poem":1},{"text":"അത് ആടിയുലയാതെ,","poem":2},{"lineBreak":true},{"text":"ആണിയും ചുറ്റികയുംകൊണ്ട് ഉറപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"വെള്ളരിത്തോട്ടത്തിലെ നോക്കുകുത്തിപോലെ അവ നിൽക്കുന്നു,","poem":1},{"text":"അവരുടെ വിഗ്രഹങ്ങൾക്കു സംസാരിക്കാൻ കഴിയുകയില്ല;","poem":2},{"text":"അവയ്ക്കു നടക്കാൻ കഴിവില്ലാത്തതിനാൽ","poem":1},{"text":"ആരെങ്കിലും അവയെ ചുമന്നുകൊണ്ടുപോകണം.","poem":2},{"text":"അവയെ ഭയപ്പെടരുത്;","poem":1},{"text":"അവയ്ക്ക് ഒരു ദോഷവും ചെയ്യാൻ കഴിയുകയില്ല,","poem":2},{"lineBreak":true},{"text":"നന്മ ചെയ്യാനും അവയ്ക്കു ശക്തിയില്ല.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"യഹോവേ, അങ്ങയെപ്പോലെ ആരുമില്ല;","poem":1},{"text":"അവിടന്നു വലിയവൻ,","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ നാമം ശക്തിയിൽ പ്രബലമാണ്.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"രാഷ്ട്രങ്ങളുടെ രാജാവേ,","poem":1},{"text":"അങ്ങയെ ആർ ഭയപ്പെടാതിരിക്കും?","poem":2},{"lineBreak":true},{"text":"അത് അങ്ങയുടെ അവകാശമാണല്ലോ.","poem":2},{"text":"രാഷ്ട്രങ്ങൾക്കിടയിലെ ജ്ഞാനികളായ നേതാക്കന്മാരിലും","poem":1},{"text":"അവരുടെ എല്ലാ രാജ്യങ്ങളിലും,","poem":2},{"lineBreak":true},{"text":"അങ്ങയെപ്പോലെ ആരുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"അവർ എല്ലാവരും ബുദ്ധിഹീനരും ഭോഷരുമത്രേ;","poem":1},{"text":"തടികൊണ്ടുള്ള നിർജീവമായ വിഗ്രഹങ്ങളാണ് അവരെ ഉപദേശിക്കുന്നത്.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"തർശീശിൽനിന്ന് അടിച്ചുപരത്തിയ വെള്ളിയും","poem":1},{"text":"ഊഫാസിൽനിന്നു തങ്കവും കൊണ്ടുവരുന്നു.","poem":2},{"text":"ആശാരിയും സ്വർണപ്പണിക്കാരും നിർമിച്ചതിനെ","poem":1},{"text":"നീലവസ്ത്രവും ഊതവർണവസ്ത്രവും ധരിപ്പിക്കുന്നു—","poem":2},{"lineBreak":true},{"text":"ഇതെല്ലാം വിദഗ്ദ്ധ ശില്പികളുടെ നിർമാണംതന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"എന്നാൽ യഹോവ സത്യദൈവമാകുന്നു;","poem":1},{"text":"അവിടന്ന് ജീവനുള്ള ദൈവവും നിത്യരാജാവുംതന്നെ.","poem":2},{"text":"അവിടത്തെ ക്രോധത്താൽ ഭൂമി വിറകൊള്ളുന്നു;","poem":1},{"text":"ജനതകൾക്ക് അവിടത്തെ ഉഗ്രകോപം സഹിക്കാൻ കഴിയുകയില്ല.","poem":2}]},{"type":"verse","number":11,"content":["“ ‘ആകാശവും ഭൂമിയും നിർമിച്ചിട്ടില്ലാത്ത ഈ ദേവതകൾ, ഈ ഭൂമിയിൽനിന്നും ആകാശത്തിൻകീഴിൽനിന്നും നശിച്ചുപോകുമെന്ന്,’ അവരോടു പറയുക.”",{"noteId":17}]},{"type":"verse","number":12,"content":[{"text":"എന്നാൽ ദൈവം തന്റെ ശക്തിയാൽ ഭൂമിയെ സൃഷ്ടിച്ചു;","poem":1},{"text":"തന്റെ ജ്ഞാനത്താൽ അവിടന്ന് ലോകത്തെ സ്ഥാപിച്ചു","poem":2},{"lineBreak":true},{"text":"തന്റെ വിവേകത്താൽ ആകാശങ്ങളെ വിരിക്കുകയും ചെയ്തു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അവിടന്ന് ഇടിമുഴക്കുമ്പോൾ, ആകാശത്തിലെ ജലശേഖരം ഗർജിക്കുന്നു;","poem":1},{"text":"അവിടന്നു ഭൂമിയുടെ അതിരുകളിൽനിന്ന് മേഘങ്ങൾ ഉയരുമാറാക്കുന്നു.","poem":2},{"text":"അവിടന്ന് മഴയ്ക്കൊപ്പം മിന്നൽ അയയ്ക്കുന്നു,","poem":1},{"text":"തന്റെ ഭണ്ഡാരത്തിൽനിന്ന് കാറ്റ് പുറപ്പെടുവിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"മനുഷ്യവർഗം മുഴുവനും വിവേകശൂന്യർ, അവർ പരിജ്ഞാനം ഇല്ലാത്തവർതന്നെ;","poem":1},{"text":"ഓരോ സ്വർണപ്പണിക്കാരും തങ്ങളുടെ വിഗ്രഹങ്ങൾമൂലം ലജ്ജിച്ചുപോകുന്നു.","poem":2},{"text":"അവർ വാർത്തുണ്ടാക്കിയ ബിംബം വ്യാജമാണ്;","poem":1},{"text":"ആ വിഗ്രഹങ്ങളിലൊന്നും ശ്വാസമില്ല.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവ മിഥ്യയും അപഹാസപാത്രവുമാണ്;","poem":1},{"text":"അവരുടെ ന്യായവിധി വരുമ്പോൾ അവ നശിച്ചുപോകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"യാക്കോബിന്റെ അവകാശമായവൻ അവരെപ്പോലെയല്ല,","poem":1},{"text":"അവിടത്തെ അവകാശജനതയായ ഇസ്രായേലിന്റെയുംമാത്രമല്ല,","poem":2},{"text":"സകലത്തിന്റെയും സ്രഷ്ടാവ് അവിടന്നാണ്—","poem":1},{"text":"സൈന്യങ്ങളുടെ യഹോവ എന്നാകുന്നു അവിടത്തെ നാമം.","poem":2}]},{"type":"heading","content":["നാശം വരുന്നു"]},{"type":"verse","number":17,"content":[{"text":"ഉപരോധത്തിൻകീഴിൽ ജീവിക്കുന്നവരേ,","poem":1},{"text":"നാടുവിടുന്നതിനായി നിന്റെ ഭാണ്ഡം മുറുക്കിക്കൊൾക.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:","poem":1},{"text":"“ഞാൻ ഈ പ്രാവശ്യം ഈ ദേശവാസികളെ","poem":2},{"lineBreak":true},{"text":"കവിണയിൽവെച്ച് എറിഞ്ഞുകളയും;","poem":2},{"text":"ഞാൻ അവർക്കു ദുരിതംവരുത്തും","poem":1},{"text":"അങ്ങനെ അവർ പിടിക്കപ്പെടും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"എന്റെ മുറിവുനിമിത്തം എനിക്ക് അയ്യോ കഷ്ടം!","poem":1},{"text":"എന്റെ മുറിവു സൗഖ്യംവരാത്തതത്രേ!","poem":2},{"text":"എന്നിട്ടും ഞാൻ എന്നോടുതന്നെ പറഞ്ഞു,","poem":1},{"text":"“ഇത് എന്റെ രോഗമാണ്, അതു ഞാൻ സഹിച്ചേ മതിയാകൂ.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"എന്റെ കൂടാരം തകർക്കപ്പെട്ടിരിക്കുന്നു;","poem":1},{"text":"അതിന്റെ കയറുകളെല്ലാം അറ്റുപോയിരിക്കുന്നു.","poem":2},{"text":"എന്റെ മക്കൾ എന്നെ വിട്ടുപോയിരിക്കുന്നു അവരെ ഞാൻ ഇനി കാണുകയുമില്ല;","poem":1},{"text":"എന്റെ കൂടാരമടിക്കുന്നതിനും","poem":2},{"lineBreak":true},{"text":"എന്റെ തിരശ്ശീല നിവർക്കുന്നതിനും ആരുമില്ല.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ഇടയന്മാർ മൃഗത്തിനു തുല്യരാണ്,","poem":1},{"text":"അവർ യഹോവയെ അന്വേഷിക്കുന്നില്ല;","poem":2},{"text":"അതിനാൽ അവർ ഐശ്വര്യം പ്രാപിക്കുന്നില്ല,","poem":1},{"text":"അവരുടെ ആട്ടിൻപറ്റമെല്ലാം ചിതറിപ്പോയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ഇതാ, ഒരു വാർത്ത വരുന്നു—","poem":1},{"text":"വടക്കേദേശത്തുനിന്നുള്ള ഒരു വലിയ കോലാഹലംതന്നെ!","poem":2},{"text":"അത് യെഹൂദാപട്ടണങ്ങളെ ശൂന്യവും","poem":1},{"text":"കുറുനരികൾ വിഹരിക്കുന്ന ഇടവുമാക്കും.","poem":2}]},{"type":"heading","content":["യിരെമ്യാവിന്റെ പ്രാർഥന"]},{"type":"verse","number":23,"content":[{"text":"യഹോവേ, മനുഷ്യരുടെ ജീവൻ അവരുടെ സ്വന്തമല്ല;","poem":1},{"text":"സ്വയം തന്റെ കാലടികളെ നിയന്ത്രിക്കാൻ അവരാൽ അസാധ്യവും എന്നു ഞാൻ അറിയുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"യഹോവേ, അങ്ങയുടെ ക്രോധത്തിലല്ല,","poem":1},{"text":"ന്യായമായ അളവിൽമാത്രം എന്നെ ശിക്ഷിക്കണമേ,","poem":2},{"lineBreak":true},{"text":"അല്ലായെങ്കിൽ ഞാൻ ശൂന്യമായിത്തീരും.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"അങ്ങയുടെ കോപം","poem":1},{"text":"അങ്ങയെ അറിയാത്ത ജനതകളുടെമേലും","poem":2},{"lineBreak":true},{"text":"അങ്ങയുടെ നാമം വിളിച്ചപേക്ഷിക്കാത്ത വംശങ്ങളുടെമേലും ചൊരിയണമേ.","poem":2},{"text":"കാരണം അവർ യാക്കോബിനെ വിഴുങ്ങിക്കളഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"അവർ അവനെ മുഴുവനായും വിഴുങ്ങിയിരിക്കുന്നു,","poem":2},{"lineBreak":true},{"text":"അവന്റെ വാസസ്ഥാനത്തെ നശിപ്പിക്കുകയും ചെയ്തിരിക്കുന്നു.","poem":2}]}],"footnotes":[{"noteId":17,"caller":"+","text":"ഈ വാക്യം അരാമ്യഭാഷയിലാണ്.","reference":{"chapter":10,"verse":11}}]},"thisChapterLink":"/api/mal_bib/JER/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/JER/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/JER/9.json","previousChapterAudioLinks":{},"numberOfVerses":25}