{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"JER","translationId":"mal_bib","name":"യിരെമ്യാവ്","commonName":"യിരെമ്യാവ്","title":"യിരെമ്യാവിന്റെ പ്രവചനം","order":24,"numberOfChapters":52,"sha256":"2dbf0b59c0d7609c384e3996dd9e78af48c924fb82932b814ee8a851f0dada36","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/mal_bib/JER/52.json","totalNumberOfVerses":1358},"chapter":{"number":47,"content":[{"type":"heading","content":["ഫെലിസ്ത്യരെക്കുറിച്ചുള്ള സന്ദേശം"]},{"type":"verse","number":1,"content":["ഫറവോൻ ഗസ്സയെ ആക്രമിച്ചു കീഴ്പ്പെടുത്തുന്നതിനുമുമ്പ് ഫെലിസ്ത്യരെക്കുറിച്ച് യിരെമ്യാപ്രവാചകനുണ്ടായ യഹോവയുടെ അരുളപ്പാട്:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:",{"text":"“ഇതാ, വടക്കുനിന്ന് വെള്ളം പൊങ്ങുന്നു;","poem":1},{"text":"അവർ കവിഞ്ഞൊഴുകുന്ന ഒരു പ്രവാഹമായിത്തീരും.","poem":2},{"text":"അത് ദേശത്തിന്റെയും അതിലുള്ള എല്ലാറ്റിന്റെയും","poem":1},{"text":"നഗരത്തിന്റെയും അതിൽ വസിക്കുന്നവരുടെയുംമീതേ കവിഞ്ഞൊഴുകും.","poem":2},{"text":"മനുഷ്യർ നിലവിളിക്കും,","poem":1},{"text":"ദേശവാസികളൊക്കെയും വിലപിക്കും;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"കുതിച്ചുപായുന്ന ആൺകുതിരകളുടെ കുളമ്പടിനാദവും","poem":1},{"text":"ശത്രുരഥങ്ങളുടെ ഘോഷവും","poem":2},{"lineBreak":true},{"text":"ചക്രങ്ങളുടെ ആരവവും കേൾക്കുമ്പോൾത്തന്നെ.","poem":2},{"text":"മാതാപിതാക്കളുടെ കൈകൾ കുഴഞ്ഞുതൂങ്ങും;","poem":1},{"text":"അവർ തങ്ങളുടെ മക്കളെ തിരിഞ്ഞുനോക്കുകയില്ല.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ഫെലിസ്ത്യരെ മുഴുവനായി നശിപ്പിക്കുന്നതിനും","poem":1},{"text":"സോരിൽനിന്നും സീദോനിൽനിന്നും","poem":2},{"text":"അവരുടെ എല്ലാ സഹായികളെയും","poem":1},{"text":"ഛേദിച്ചുകളയാനുമുള്ള ദിവസം വരുന്നതിനാൽതന്നെ.","poem":2},{"text":"കഫ്തോർ","poem":1},{"noteId":86},{"text":"തീരങ്ങളിൽ ശേഷിച്ചിരിക്കുന്ന","poem":1},{"text":"ഫെലിസ്ത്യരെ യഹോവ നശിപ്പിക്കാൻ പോകുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ഗസ്സാ വിലപിച്ചുകൊണ്ട് അവളുടെ തല ക്ഷൗരംചെയ്യും;","poem":1},{"text":"അസ്കലോൻ നിശ്ശബ്ദരായിത്തീരും.","poem":2},{"text":"താഴ്വരയിലെ ശേഷിപ്പേ,","poem":1},{"text":"എത്രവരെ നീ സ്വയം ക്ഷതമേൽപ്പിക്കും?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ ‘അയ്യോ, യഹോവയുടെ വാളേ,","poem":1},{"text":"നീ എത്രവരെ വിശ്രമമില്ലാതിരിക്കും?","poem":2},{"text":"നിന്റെ ഉറയിലേക്കു പിൻവാങ്ങുക","poem":1},{"text":"വെട്ടുന്നതു നിർത്തി വിശ്രമിക്കുക.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അസ്കലോനെയും സമുദ്രതീരത്തെയും ആക്രമിക്കാൻ","poem":1},{"text":"യഹോവ അതിന് ആജ്ഞ കൊടുത്തിരിക്കെ,","poem":2},{"text":"അതിനായിട്ട് അവിടന്ന് കൽപ്പിച്ചിരിക്കെ,","poem":1},{"text":"അതിന് എങ്ങനെ അടങ്ങിയിരിക്കാൻ കഴിയും?”","poem":2}]}],"footnotes":[{"noteId":86,"caller":"+","text":"അതായത്, ക്രീത്ത്","reference":{"chapter":47,"verse":4}}]},"thisChapterLink":"/api/mal_bib/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}