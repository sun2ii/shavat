{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"JOB","translationId":"mal_bib","name":"ഇയ്യോബ്","commonName":"ഇയ്യോബ്","title":"ഇയ്യോബ്","order":18,"numberOfChapters":42,"sha256":"2cd3e27ae94b270796ebdaf9c397c1ac1e58252e9b8d8d8392d2f03ae9950e4d","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mal_bib/JOB/42.json","totalNumberOfVerses":1060},"chapter":{"number":15,"content":[{"type":"heading","content":["എലീഫസ്"]},{"type":"verse","number":1,"content":["അപ്പോൾ തേമാന്യനായ എലീഫാസ് ഇപ്രകാരം ഉത്തരം പറഞ്ഞു:"]},{"type":"verse","number":2,"content":[{"text":"“ജ്ഞാനിയായ ഒരു മനുഷ്യൻ വ്യർഥജ്ഞാനമുള്ള മറുപടി പറയുമോ?","poem":1},{"text":"കിഴക്കൻ കാറ്റുകൊണ്ട് അവർ വയറുനിറയ്ക്കുമോ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവർ അർഥശൂന്യമായ വാക്കുകൾകൊണ്ടും","poem":1},{"text":"ഉപകാരമില്ലാത്ത സംഭാഷണംകൊണ്ടും തർക്കിക്കുമോ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"എന്നാൽ ദൈവഭക്തിപോലും നീ ഉപേക്ഷിച്ചിരിക്കുന്നു;","poem":1},{"text":"ദൈവസന്നിധിയിലുള്ള ധ്യാനം നീ തുച്ഛീകരിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അകൃത്യം നിന്റെ വാക്കുകളിൽത്തന്നെ വ്യക്തമാകുന്നു;","poem":1},{"text":"കൗശലക്കാരുടെ ഭാഷ നീ തെരഞ്ഞെടുത്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഞാനല്ല, നിന്റെ വായ്‌തന്നെ നിന്നെ കുറ്റം വിധിക്കുന്നു;","poem":1},{"text":"നിന്റെതന്നെ അധരങ്ങൾ നിനക്കെതിരേ സാക്ഷ്യംനൽകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“നീയാണോ ആദ്യം ജനിച്ച മനുഷ്യൻ?","poem":1},{"text":"കുന്നുകൾക്കുംമുമ്പേ പിറന്നവൻ നീയോ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"നീ ദൈവത്തിന്റെ ആലോചന ശ്രദ്ധിച്ചിട്ടുണ്ടോ?","poem":1},{"text":"ജ്ഞാനം കുത്തകയായി ലഭിച്ചിരിക്കുന്നതു നിനക്കുമാത്രമോ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഞങ്ങൾക്ക് അജ്ഞാതമായിരിക്കുന്ന ഏതു കാര്യമാണ് നിനക്ക് അറിയാവുന്നത്?","poem":1},{"text":"ഞങ്ങൾക്കില്ലാത്ത ഏത് ഉൾക്കാഴ്ചയാണ് നീ സമ്പാദിച്ചിട്ടുള്ളത്?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"തല നരച്ചവരും വയോധികരും ഞങ്ങളുടെ കൂട്ടത്തിലുണ്ട്;","poem":1},{"text":"നിന്റെ പിതാവിനെക്കാൾ പ്രായമുള്ളവർതന്നെ","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ദൈവത്തിന്റെ ആശ്വാസവചസ്സുകളും","poem":1},{"text":"നിന്നോടു സൗമ്യമായി പറഞ്ഞ വാക്കുകളും നിനക്കു വളരെ നിസ്സാരമോ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"നിന്റെ ഹൃദയം നിന്നെ വഴിതെറ്റിക്കുന്നതെന്തിന്?","poem":1},{"text":"നിന്റെ കണ്ണുകൾ ജ്വലിക്കുന്നതിനും കാരണമെന്ത്?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"നീ ദൈവത്തിനെതിരേ നിന്റെ ക്രോധം ജ്വലിപ്പിക്കുകയും","poem":1},{"text":"ഇത്തരം വാക്കുകൾ നിന്റെ അധരങ്ങളിൽനിന്നു പുറപ്പെടുവിക്കുകയും ചെയ്യുന്നത് എന്തിന്?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“മനുഷ്യർക്കു നിർമലരായിരിക്കാൻ കഴിയുമോ?","poem":1},{"text":"സ്ത്രീയിൽനിന്ന് ഉത്ഭവിച്ചവർക്ക് നീതിനിഷ്ഠരാകാൻ കഴിയുമോ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ദൈവം തന്റെ വിശുദ്ധരെ വിശ്വാസത്തിൽ എടുക്കുന്നില്ലെങ്കിൽ","poem":1},{"text":"സ്വർഗവും അവിടത്തെ ദൃഷ്ടിയിൽ നിർമലമല്ലെങ്കിൽ,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"നിന്ദ്യനും ദൂഷിതനും","poem":1},{"text":"അനീതിയെ വെള്ളംപോലെ കുടിക്കുന്നവനുമായ മനുഷ്യർ എത്രയധികം!","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“എന്നെ ശ്രദ്ധിക്കുക, ഞാൻ നിനക്കു വിശദീകരിച്ചുതരാം;","poem":1},{"text":"എന്റെ നിരീക്ഷണങ്ങൾ ഞാൻ നിന്നോടു വിവരിക്കട്ടെ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ജ്ഞാനികൾ തങ്ങളുടെ പൂർവികരിൽനിന്ന് കേട്ടതും","poem":1},{"text":"ഒന്നും മറച്ചുവെക്കാതെ വിളിച്ചുപറയുകയും ചെയ്ത വാക്കുകൾതന്നെ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ഒരു വിദേശിയും അവരുടെ കൂട്ടത്തിൽ ഇല്ലാതിരിക്കുമ്പോഴാണ്,","poem":1},{"text":"അവർക്കുമാത്രമായി ഈ ദേശം നൽകപ്പെട്ടത്.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ദുഷ്ടർ തങ്ങളുടെ ആയുഷ്കാലം മുഴുവൻ വേദനയിൽ പുളയുന്നു;","poem":1},{"text":"നിഷ്ഠുരർക്കു നിയമിക്കപ്പെട്ട സംവത്സരങ്ങൾ തികയുന്നതുവരെത്തന്നെ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവരുടെ കാതുകളിൽ ഭീതിയുടെ ശബ്ദം മുഴങ്ങുന്നു;","poem":1},{"text":"എല്ലാം ശുഭമായിരിക്കുമ്പോൾത്തന്നെ സംഹാരകർ അവരെ ആക്രമിക്കുന്നു.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"അന്ധകാരത്തിൽനിന്നു രക്ഷപ്പെടാൻ കഴിയുമെന്ന് അവർക്കു പ്രതീക്ഷയില്ല;","poem":1},{"text":"അവർ വാളിന് നിയമിക്കപ്പെട്ടിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ആഹാരത്തിനായി കഴുകൻ എന്നപോലെ അവർ അലഞ്ഞുതിരിയുന്നു;","poem":1},{"text":"അന്ധകാരദിനം അടുത്തിരിക്കുന്നു എന്ന് അവർ അറിയുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"കഷ്ടപ്പാടും അതിവേദനയും അവരെ ഭയപ്പെടുത്തുന്നു;","poem":1},{"text":"യുദ്ധസന്നദ്ധനായ രാജാവിനെപ്പോലെ അവ അവരെ ആക്രമിക്കുന്നു.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"അവർ ദൈവത്തിനു വിരോധമായി മുഷ്ടിചുരുട്ടുകയാലും","poem":1},{"text":"സർവശക്തന്റെനേരേ ഊറ്റംകൊള്ളുകയാലുംതന്നെ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ഘനമുള്ളതും ശക്തിയേറിയതുമായ പരിചയേന്തിക്കൊണ്ട്","poem":1},{"text":"അവർ ധിക്കാരഭാവത്തോടെ അവിടത്തേക്കെതിരേ പാഞ്ഞുചെല്ലുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“ദുഷ്ടരുടെ മുഖം മേദസ്സുകൊണ്ടു തുടുത്തുകൊഴുക്കുന്നു","poem":1},{"text":"അവരുടെ അരക്കെട്ട് കൊഴുത്തു തടിച്ചവ ആണെങ്കിലും,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"അവർ നശിപ്പിക്കപ്പെട്ട നഗരങ്ങളിൽ താമസമാക്കും.","poem":1},{"text":"ഇടിഞ്ഞുവീഴാറായതും ആരും പാർക്കാത്തതുമായ","poem":2},{"lineBreak":true},{"text":"വീടുകളിൽത്തന്നെ അവർ പാർക്കും.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"അവർ ധനികരാകുകയോ അവരുടെ സമ്പത്തു നിലനിൽക്കുകയോ ഇല്ല;","poem":1},{"text":"അവരുടെ സമ്പാദ്യങ്ങൾ ദേശത്തു വർധിക്കുകയുമില്ല.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ഇരുളിൽനിന്ന് അവർ രക്ഷപ്പെടുകയില്ല;","poem":1},{"text":"അവരുടെ മുളകളെ തീനാളം കരിച്ചുകളയും","poem":2},{"lineBreak":true},{"text":"തിരുവായിലെ നിശ്വാസത്താൽ അവർ നശിച്ചുപോകും.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"അവർ തങ്ങളെത്തന്നെ വഞ്ചിച്ചുകൊണ്ട് ശൂന്യമായവയിൽ ആശ്രയിക്കാതിരിക്കട്ടെ,","poem":1},{"text":"കാരണം അവരുടെ പ്രതിഫലവും ശൂന്യമായിരിക്കും.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"അവരുടെ കാലംതികയുന്നതിനു മുമ്പുതന്നെ അവർ മാഞ്ഞുപോകും","poem":1},{"text":"അവരുടെ ശാഖകൾ തഴച്ചുവളരുകയുമില്ല.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"മുന്തിരിവള്ളിയിലെ പാകമാകാത്ത കായ്കൾ ഉതിർന്നുപോകുന്നതുപോലെയും;","poem":1},{"text":"ഒലിവുമരത്തിലെ പൂക്കൾ കൊഴിഞ്ഞുപോകുന്നതുപോലെയും ആയിരിക്കും അവർ.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"കാരണം, അഭക്തരുടെ സംഘം വന്ധ്യതയുള്ളവരാകും;","poem":1},{"text":"കൈക്കൂലിക്കാരുടെ കൂടാരങ്ങൾ അഗ്നിക്കിരയാകും.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"അവർ ദ്രോഹത്തെ ഗർഭംധരിച്ച് അനീതിയെ പ്രസവിക്കുന്നു;","poem":1},{"text":"അവരുടെ ഉദരം വഞ്ചന രൂപപ്പെടുത്തുന്നു.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}