{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"JOB","translationId":"mal_bib","name":"ഇയ്യോബ്","commonName":"ഇയ്യോബ്","title":"ഇയ്യോബ്","order":18,"numberOfChapters":42,"sha256":"2cd3e27ae94b270796ebdaf9c397c1ac1e58252e9b8d8d8392d2f03ae9950e4d","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mal_bib/JOB/42.json","totalNumberOfVerses":1060},"chapter":{"number":18,"content":[{"type":"heading","content":["ബിൽദാദ്"]},{"type":"verse","number":1,"content":["അപ്പോൾ ശൂഹ്യനായ ബിൽദാദ് ഇങ്ങനെ ഉത്തരം പറഞ്ഞു:"]},{"type":"verse","number":2,"content":[{"text":"“നിങ്ങൾ എപ്പോഴാണ് ഈ പ്രഭാഷണം ഒന്നു നിർത്തുന്നത്?","poem":1},{"text":"വിവേകികളാകുക; പിന്നെ നമുക്കു സംസാരിക്കാം.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ഞങ്ങളെ കന്നുകാലികളായി പരിഗണിക്കുന്നത് എന്തിന്?","poem":1},{"text":"നിന്റെ ദൃഷ്ടിയിൽ ഞങ്ങൾ അത്രയ്ക്കു മഠയന്മാരോ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"കലിതുള്ളി സ്വയം കടിച്ചുകീറുന്നവനേ,","poem":1},{"text":"നിനക്കുവേണ്ടി ഭൂമി നിർജനമായിത്തീരണമോ?","poem":2},{"lineBreak":true},{"text":"അതോ, പാറ അതിന്റെ സ്ഥാനത്തുനിന്നു മാറ്റപ്പെടണമോ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ദുഷ്ടന്റെ വിളക്ക് അണഞ്ഞുപോകും;","poem":1},{"text":"അവരുടെ അഗ്നിജ്വാല പ്രകാശം തരികയില്ല.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവരുടെ കൂടാരത്തിലെ വെളിച്ചം ഇരുണ്ടുപോകും;","poem":1},{"text":"അവരുടെ അരികത്തുള്ള വിളക്ക് കെട്ടുപോകും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവരുടെ കാലടികളുടെ ചുറുചുറുക്കു ക്ഷയിച്ചിരിക്കുന്നു;","poem":1},{"text":"അവരുടെ പദ്ധതികൾതന്നെ അവർക്കു പതനഹേതുവായിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവർ സ്വയം കെണിയിലേക്കു നടക്കുന്നു;","poem":1},{"text":"അവർ ചതിക്കുഴിയിലേക്കുതന്നെ വീഴുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവരുടെ കുതികാലിൽ കുരുക്കുവീഴുന്നു,","poem":1},{"text":"കെണി അവരെ വരിഞ്ഞുമുറുക്കുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവർക്കുവേണ്ടി നിലത്ത് കുടുക്കും","poem":1},{"text":"വഴിയിൽ വലയും ഒളിച്ചുവെച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"എല്ലായിടത്തുനിന്നുമുള്ള ഭീതികൾ അവരെ ഭയവിഹ്വലരാക്കുകയും","poem":1},{"text":"ഓരോ കാൽവെപ്പിലും അവരെ വേട്ടയാടുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ദുരന്തം അവർക്കായി ബുഭുക്ഷയോടെ ഇരിക്കുന്നു;","poem":1},{"text":"വിനാശം അവരുടെ പതനത്തിനു കാത്തുനിൽക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അത് അവരുടെ ത്വക്കിനെ തിന്നുനശിപ്പിക്കുന്നു;","poem":1},{"text":"മരണത്തിന്റെ ആദ്യജാതൻ അവരുടെ അവയവങ്ങൾ വിഴുങ്ങുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവർക്ക് ആശ്രയമായിരുന്ന കൂടാരത്തിൽനിന്ന് അവർ പിഴുതെറിയപ്പെടും;","poem":1},{"text":"ഭീകരതയുടെ രാജാവിൻ സമീപത്തേക്ക് അവർ ആനയിക്കപ്പെടും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവരുടെ കൂടാരത്തിൽ അഗ്നി കുടിപാർക്കുന്നു;","poem":1},{"text":"അവരുടെ വാസസ്ഥലത്തിന്മേൽ ഗന്ധകം വർഷിക്കപ്പെടുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"കീഴേയുള്ള അവരുടെ വേരുകൾ ഉണങ്ങിപ്പോകുന്നു,","poem":1},{"text":"മീതേ അവരുടെ ശാഖകൾ കരിയുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ഭൂമിയിൽനിന്ന് അവരുടെ സ്മരണ തുടച്ചുനീക്കപ്പെടും;","poem":1},{"text":"ദേശത്ത് അവരുടെ പേര് ഉണ്ടായിരിക്കുകയില്ല.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അവരെ വെളിച്ചത്തിൽനിന്ന് ഇരുളിലേക്കു തുരത്തിയോടിക്കും;","poem":1},{"text":"അവരെ ഭൂതലത്തിൽനിന്നുതന്നെ നാടുകടത്തും.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അവരുടെ സമൂഹത്തിൽത്തന്നെ അവർക്കു സന്തതിയോ പിൻഗാമികളോ ഇല്ലാതായിരിക്കുന്നു;","poem":1},{"text":"അവർ മുമ്പു വസിച്ചിരുന്നിടത്ത് ആരും അവശേഷിക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"പശ്ചിമദേശക്കാർ അവരുടെ വിധി കണ്ടു വിസ്മയിക്കും;","poem":1},{"text":"പൂർവദേശക്കാർ നടുങ്ങിപ്പോകും.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"നിശ്ചയമായും അധർമികളുടെ വാസസ്ഥലത്തിന്റെ ഗതി ഈ വിധമാകുന്നു;","poem":1},{"text":"ദൈവത്തെ അറിയാത്തവരുടെ സ്ഥലവും ഇപ്രകാരംതന്നെ.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}