{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"JOB","translationId":"mal_bib","name":"ഇയ്യോബ്","commonName":"ഇയ്യോബ്","title":"ഇയ്യോബ്","order":18,"numberOfChapters":42,"sha256":"2cd3e27ae94b270796ebdaf9c397c1ac1e58252e9b8d8d8392d2f03ae9950e4d","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mal_bib/JOB/42.json","totalNumberOfVerses":1060},"chapter":{"number":20,"content":[{"type":"heading","content":["സോഫർ"]},{"type":"verse","number":1,"content":["അപ്പോൾ നാമാത്യനായ സോഫർ ഇങ്ങനെ പറഞ്ഞു:"]},{"type":"verse","number":2,"content":[{"text":"“എന്റെ അസ്വസ്ഥചിന്തകൾ ഉത്തരം പറയാൻ എന്നെ പ്രേരിപ്പിക്കുന്നു","poem":1},{"text":"കാരണം ഞാൻ അത്രമാത്രം അസ്വസ്ഥനായിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"എന്നെ നിന്ദിക്കുന്ന ശാസനകൾ ഞാൻ കേട്ടു;","poem":1},{"text":"എന്റെ വിവേകപൂർവമായ ആത്മാവ് എന്നെക്കൊണ്ടു മറുപടി പറയിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“പുരാതനകാലംമുതലേ നടപ്പുള്ള കാര്യം നീ അറിയുന്നില്ലേ,","poem":1},{"text":"ഭൂമുഖത്ത് മനുഷ്യജാതിയെ","poem":2},{"noteId":17},{"text":"ആക്കിയ കാലംമുതലുള്ളവതന്നെ,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ദുഷ്ടരുടെ വിജയഭേരി ഹ്രസ്വകാലത്തേക്കേയുള്ളൂ;","poem":1},{"text":"അഭക്തരുടെ സന്തോഷം ക്ഷണികവുമാണ്.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അഭക്തരുടെ അഹന്ത ആകാശംവരെ എത്തിയാലും","poem":1},{"text":"അവരുടെ ശിരസ്സു മേഘങ്ങളെ തൊട്ടുരുമ്മിനിന്നാലും,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"തങ്ങളുടെ വിസർജ്യംപോലെ അവർ എന്നേക്കുമായി നാശമടയും;","poem":1},{"text":"അവരുടെ മുൻപരിചയക്കാർ, ‘അവർ എവിടെ?’ എന്നു ചോദിക്കും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ഒരു സ്വപ്നംപോലെ അവർ പാറിപ്പോകും; പിന്നീടൊരിക്കലും കാണാൻപറ്റാത്ത വിധത്തിൽത്തന്നെ,","poem":1},{"text":"ഒരു നിശാദർശനംപോലെ അവർ തുടച്ചുനീക്കപ്പെടുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവരെ കണ്ടിട്ടുള്ള കണ്ണുകൾ അവരെ പിന്നീടു കാണുകയില്ല;","poem":1},{"text":"അവർ ആയിരുന്ന ഇടം പിന്നെ അവരെ തിരിച്ചറിയുകയുമില്ല.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവരുടെ മക്കൾ ദരിദ്രരോട് സഹായം അഭ്യർഥിക്കും;","poem":1},{"text":"അവരുടെ കൈകൊണ്ടുതന്നെ തങ്ങളുടെ ധനം മടക്കിക്കൊടുക്കേണ്ടിവരും.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അവരുടെ അസ്ഥികളിൽ യൗവനതേജസ്സു നിറഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"എങ്കിലും അത് അവരോടൊപ്പം മണ്ണടിയും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“അധർമം അവരുടെ വായ്ക്കു രുചികരമായിരിക്കുകയും","poem":1},{"text":"തങ്ങളുടെ നാവിൻകീഴേ അവർ അത് ഒളിച്ചുവെക്കുകയും,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അതിനെ ഉപേക്ഷിക്കാൻ മനസ്സുവരാതെ","poem":1},{"text":"വായ്ക്കുള്ളിൽത്തന്നെ സൂക്ഷിച്ചുവെക്കുകയും ചെയ്താലും,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവരുടെ ഉദരത്തിൽ അതു പുളിച്ചുപോകും","poem":1},{"text":"സർപ്പവിഷമായി അതു പരിണമിക്കും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവർ വിഴുങ്ങിയ എല്ലാ സമ്പത്തും അവർക്കു ഛർദിക്കേണ്ടിവരും;","poem":1},{"text":"ദൈവം അവരുടെ കുടലിൽനിന്ന് അതെല്ലാം പുറത്തേക്കു വമിപ്പിക്കും.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അവർ സർപ്പവിഷം നുണയും;","poem":1},{"text":"അണലിയുടെ കടിയേറ്റു മരണമടയും.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"തേനും വെണ്ണയും ഒഴുകുന്ന","poem":1},{"text":"നദികളും അരുവികളും അവർക്ക് ആസ്വാദ്യമാകുകയില്ല.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അവർ സമ്പാദിച്ചത് അനുഭവിക്കാതെ മടക്കിക്കൊടുക്കേണ്ടിവരുന്നു;","poem":1},{"text":"തങ്ങളുടെ വ്യാപാരത്തിൽനിന്നുള്ള സമ്പാദ്യം അവർ ആസ്വദിക്കുകയുമില്ല.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"കാരണം, അവർ ദരിദ്രരെ പീഡിപ്പിക്കുകയും അനാഥരെ ഉപേക്ഷിച്ചുകളയുകയും ചെയ്തു;","poem":1},{"text":"തങ്ങൾ പണിയാത്ത വീട് അവൻ പിടിച്ചെടുത്തു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“അവരുടെ അത്യാഗ്രഹത്തിന് അവസാനം വരികയില്ല;","poem":1},{"text":"തങ്ങളുടെ നിക്ഷേപങ്ങൾക്ക് അവരെ സംരക്ഷിക്കാൻ കഴിയുകയില്ല.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവർക്കു വെട്ടിവിഴുങ്ങുന്നതിനായി ഒന്നുംതന്നെ ശേഷിക്കുകയില്ല;","poem":1},{"text":"അവരുടെ ഐശ്വര്യം നിലനിൽക്കുകയില്ല.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"അവരുടെ സമൃദ്ധിയുടെ നിറവിൽ, ദുരിതം അവരെ കീഴ്പ്പെടുത്തും;","poem":1},{"text":"അതിവ്യഥ പൂർണശക്തിയോടെ അവരുടെമേൽ വീഴും.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"അവർ തങ്ങളുടെ വയറുനിറയ്ക്കുമ്പോൾ,","poem":1},{"text":"ദൈവം തന്റെ ക്രോധാഗ്നി അവരിലേക്കു തുറന്നുവിടും","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ പ്രഹരം ഒരു മഴപോലെ അവരുടെമേൽ വർഷിക്കും.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ഇരുമ്പായുധത്തിൽനിന്ന് അവർ വഴുതി രക്ഷപ്പെട്ടേക്കാം,","poem":1},{"text":"അപ്പോൾ വെള്ളോട്ടിൻ അസ്ത്രം അവരുടെമേൽ തുളച്ചുകയറും.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"അത് അവരുടെ ശരീരത്തിന്റെ പിൻഭാഗത്തുകൂടി വലിച്ചൂരപ്പെടും,","poem":1},{"text":"അതിന്റെ വെട്ടിത്തിളങ്ങുന്ന മുന അവരുടെ കരൾ ഭേദിക്കും.","poem":2},{"text":"മരണഭീതി അവർക്കുമേൽ വന്നുവീഴും;","poem":1}]},{"type":"verse","number":26,"content":[{"text":"അവരുടെ നിക്ഷേപങ്ങൾക്കായി ഘോരാന്ധകാരം പതിയിരിക്കുന്നു.","poem":2},{"text":"വീശിക്കത്തിക്കാത്ത അഗ്നി അവരെ ദഹിപ്പിക്കും,","poem":1},{"text":"അവരുടെ കൂടാരങ്ങളിൽ അവശേഷിച്ചവയെ അതു വിഴുങ്ങിക്കളയും.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ആകാശം അവരുടെ അനീതി വെളിപ്പെടുത്തും;","poem":1},{"text":"ഭൂമി അവർക്കെതിരേ എഴുന്നേൽക്കും.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"പെരുവെള്ളപ്പാച്ചിൽ അവരുടെ ഭവനം ഒഴുക്കിക്കൊണ്ടുപോകും,","poem":1},{"text":"ദൈവക്രോധദിവസത്തിലെ ആ മഹാപ്രവാഹംതന്നെ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ഇതു ദുഷ്ടർക്കു ദൈവം കൊടുക്കുന്ന ഓഹരിയും","poem":1},{"text":"ദൈവം അവർക്കായി നിയമിച്ചിട്ടുള്ള ഭാഗധേയവുമാണ്.”","poem":2}]}],"footnotes":[{"noteId":17,"caller":"+","text":"അഥവാ, ആദാമിനെ","reference":{"chapter":20,"verse":4}}]},"thisChapterLink":"/api/mal_bib/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}