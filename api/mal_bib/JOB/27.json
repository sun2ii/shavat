{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"JOB","translationId":"mal_bib","name":"ഇയ്യോബ്","commonName":"ഇയ്യോബ്","title":"ഇയ്യോബ്","order":18,"numberOfChapters":42,"sha256":"2cd3e27ae94b270796ebdaf9c397c1ac1e58252e9b8d8d8392d2f03ae9950e4d","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mal_bib/JOB/42.json","totalNumberOfVerses":1060},"chapter":{"number":27,"content":[{"type":"heading","content":["ഇയ്യോബിന്റെ അവസാനവാക്കുകൾ"]},{"type":"verse","number":1,"content":["ഇയ്യോബ് തന്റെ പ്രഭാഷണം ഇപ്രകാരം തുടർന്നു:"]},{"type":"verse","number":2,"content":[{"text":"“എനിക്കു നീതി നിഷേധിച്ച്","poem":1},{"text":"എന്റെ ജീവിതം ദുഃഖപൂർണമാക്കിയ സർവശക്തനായ ജീവനുള്ള ദൈവത്താണ,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"എന്നിൽ ജീവനുള്ള കാലത്തോളം,","poem":1},{"text":"എന്റെ നാസികയിൽ ദൈവത്തിന്റെ ശ്വാസം നിലനിൽക്കുന്നതുവരെയും,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"എന്റെ അധരങ്ങൾ നീതികേടു സംസാരിക്കുകയില്ല;","poem":1},{"text":"എന്റെ നാവു വഞ്ചന ഉച്ചരിക്കയുമില്ല.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"നിങ്ങളുടെ ഭാഗം ശരിയെന്നു ഞാൻ ഒരിക്കലും അംഗീകരിക്കുകയില്ല;","poem":1},{"text":"മരിക്കുന്നതുവരെ എന്റെ പരമാർഥത ഞാൻ ത്യജിക്കുകയില്ല.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"എന്റെ നീതിനിഷ്ഠയിൽ ഞാൻ ഉറച്ചുനിൽക്കും, അതു ഞാൻ ഒരിക്കലും ഉപേക്ഷിക്കുകയില്ല;","poem":1},{"text":"എന്റെ ജീവിതകാലത്തൊരിക്കലും എന്റെ മനസ്സാക്ഷി എന്നെ നിന്ദിക്കുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“എന്റെ ശത്രു ദുഷ്ടരെപ്പോലെയും","poem":1},{"text":"എന്റെ എതിരാളി നീതികെട്ടവരെപ്പോലെയുമിരിക്കട്ടെ!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അഭക്തർ ഛേദിക്കപ്പെടുകയും","poem":1},{"text":"ദൈവം അവരുടെ ജീവൻ എടുത്തുകളകയും ചെയ്യുമ്പോൾ അവർക്കുള്ള പ്രത്യാശയെന്ത്?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവർക്കു കഷ്ടത വരുമ്പോൾ","poem":1},{"text":"ദൈവം അവരുടെ നിലവിളി കേൾക്കുമോ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവർ സർവശക്തനിൽ സന്തോഷിക്കുമോ?","poem":1},{"text":"എപ്പോഴും ദൈവത്തെ വിളിച്ചപേക്ഷിക്കുമോ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ദൈവശക്തിയെക്കുറിച്ചു ഞാൻ നിങ്ങളെ പഠിപ്പിക്കാം;","poem":1},{"text":"സർവശക്തന്റെ മാർഗങ്ങളൊന്നും ഞാൻ മറച്ചുവെക്കുകയില്ല.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ഇതാ, നിങ്ങളെല്ലാവരും ഇതു നേരിട്ടു കണ്ടുകഴിഞ്ഞു;","poem":1},{"text":"പിന്നെ എന്തിനാണ് ഈ പാഴ്ച്ചൊല്ലുകൾ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ഇതെല്ലാം ദൈവം ദുഷ്ടമനുഷ്യർക്കു നൽകുന്ന ഭാഗധേയവും","poem":1},{"text":"നിഷ്ഠുരർക്കു സർവശക്തനിൽനിന്നു ലഭിക്കുന്ന പൈതൃകവും ആകുന്നു:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവർക്ക് എത്രയധികം മക്കൾ ഉണ്ടായാലും അവരെല്ലാം വാളിനു വിധിക്കപ്പെട്ടിരിക്കുന്നു;","poem":1},{"text":"അവരുടെ സന്തതിക്കു മതിവരുവോളം ഭക്ഷിക്കാൻ ലഭിക്കുകയില്ല.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവരിൽ ശേഷിക്കുന്നവരെ മഹാമാരി കുഴിമാടത്തിലെത്തിക്കും,","poem":1},{"text":"അവരുടെ വിധവകൾ അവരെയോർത്തു വിലപിക്കുകയുമില്ല.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അവർ മണ്ണുപോലെ വെള്ളി വാരിക്കൂട്ടിയാലും,","poem":1},{"text":"കളിമൺകൂനകൾപോലെ വിശേഷവസ്ത്രങ്ങൾ ഒരുക്കിവെച്ചാലും,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവർ ശേഖരിച്ചുവെക്കുന്നവ നീതിനിഷ്ഠർ ധരിക്കും;","poem":1},{"text":"നിഷ്കളങ്കർ അവരുടെ വെള്ളി പങ്കിടും.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അവർ പണിയുന്ന വീട് പട്ടുനൂൽപ്പുഴുവിന്റെ കൂടുപോലെ;","poem":1},{"text":"അഥവാ, കാവൽക്കാരൻ കെട്ടുന്ന മാടംപോലെയല്ലോ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ധനികരായി അവർ കിടക്കയിലേക്കു പോകുന്നു, എന്നാൽ പിന്നീട് അങ്ങനെ ചെയ്യാൻ കഴിയില്ല;","poem":1},{"text":"കാരണം, കിടക്കവിട്ട് കണ്ണു തുറക്കുമ്പോൾ എല്ലാം പോയ്പ്പോയിരിക്കും.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"പ്രളയംപോലെ ഭയം അവരെ കീഴടക്കുന്നു;","poem":1},{"text":"കൊടുങ്കാറ്റ് രാത്രിയിൽ അവരെ പറപ്പിച്ചുകൊണ്ടുപോകുന്നു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"കിഴക്കൻകാറ്റ് അവരെ എടുത്തുകൊണ്ടുപോകുന്നു;","poem":1},{"text":"തങ്ങളുടെ സ്ഥാനത്തുനിന്നും അത് അവരെ തൂത്തെറിയുന്നു.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"അതിന്റെ ശക്തിയിൽനിന്ന് ഓടിരക്ഷപ്പെടാൻ ശ്രമിക്കുന്നവരെ","poem":1},{"text":"അത് നിർദാക്ഷിണ്യം ചുഴറ്റിയെറിയുന്നു;","poem":2}]},{"type":"verse","number":23,"content":[{"text":"അത് അവരെ നോക്കി കൈകൊട്ടും;","poem":1},{"text":"കാറ്റിന്റെ ഒരു ഊത്തിനാൽ അവരെ സ്വസ്ഥാനത്തുനിന്നു പുറന്തള്ളും.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}