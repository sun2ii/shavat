{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"JOB","translationId":"mal_bib","name":"ഇയ്യോബ്","commonName":"ഇയ്യോബ്","title":"ഇയ്യോബ്","order":18,"numberOfChapters":42,"sha256":"2cd3e27ae94b270796ebdaf9c397c1ac1e58252e9b8d8d8392d2f03ae9950e4d","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mal_bib/JOB/42.json","totalNumberOfVerses":1060},"chapter":{"number":8,"content":[{"type":"heading","content":["ബിൽദാദ്"]},{"type":"verse","number":1,"content":["ഇതിനെത്തുടർന്ന് ശൂഹ്യനായ ബിൽദാദ് ഉത്തരം പറഞ്ഞു:"]},{"type":"verse","number":2,"content":[{"text":"“ഇത്തരം കാര്യങ്ങൾ നീ എത്രകാലം പറഞ്ഞുകൊണ്ടിരിക്കും?","poem":1},{"text":"നിന്റെ വാക്കുകൾ അതിശക്തമായ കാറ്റുപോലെയാണല്ലോ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ദൈവം ന്യായം തകിടംമറിക്കുമോ?","poem":1},{"text":"സർവശക്തൻ നീതിയെ നിഷേധിക്കുമോ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അങ്ങയുടെ മക്കൾ അവിടത്തോട് പാപംചെയ്യുമ്പോൾ,","poem":1},{"text":"അവിടന്ന് അവരുടെ അകൃത്യത്തിന് തക്കതായ ശിക്ഷനൽകുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"എന്നാൽ നീ ദൈവത്തോട് പ്രാർഥിക്കുകയും","poem":1},{"text":"സർവശക്തനോട് കേണപേക്ഷിക്കുകയും ചെയ്താൽ,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"നീ നിർമലനും പരമാർഥിയുമെങ്കിൽ,","poem":1},{"text":"തീർച്ചയായും അവിടന്നു നിനക്കുവേണ്ടി എഴുന്നേൽക്കും;","poem":2},{"lineBreak":true},{"text":"നിന്റെ പഴയ ഐശ്വര്യസമൃദ്ധിയിൽത്തന്നെ നിന്നെ പുനഃസ്ഥാപിക്കും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"നിന്റെ ആരംഭം ലളിതമായി തോന്നാമെങ്കിലും,","poem":1},{"text":"നിന്റെ ഭാവി ഐശ്വര്യസമൃദ്ധം ആയിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“മുൻ തലമുറകളോടു ചോദിക്കുക;","poem":1},{"text":"അവരുടെ പൂർവികരുടെ അനുഭവജ്ഞാനം എന്തെല്ലാമെന്നു കണ്ടെത്തുക.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഇന്നലെ പിറന്നവരാണു നാം, നമുക്കൊന്നും അറിഞ്ഞുകൂടാ.","poem":1},{"text":"ഭൂമിയിൽ നമ്മുടെ ആയുസ്സ് ഒരു നിഴൽപോലെമാത്രമാണ്.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവർ നിന്നെ പഠിപ്പിക്കുകയും ഉപദേശിക്കുകയും ചെയ്യുകയില്ലേ?","poem":1},{"text":"തങ്ങളുടെ അനുഭവജ്ഞാനം അവർ വെളിപ്പെടുത്തുകയില്ലേ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ചതുപ്പുനിലങ്ങളിൽ അല്ലാതെ ഞാങ്ങണ തഴച്ചുവളരുമോ?","poem":1},{"text":"വെള്ളമില്ലാതെ ഓടക്കാട് തഴയ്ക്കുമോ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അരിയാതെ പച്ചയായിരിക്കുമ്പോൾതന്നെ","poem":1},{"text":"പുല്ലു വാടുന്നതിലും വേഗത്തിൽ അവർ വാടിപ്പോകുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ദൈവത്തെ മറക്കുന്നവരുടെ അന്ത്യം അപ്രകാരമാണ്;","poem":1},{"text":"അങ്ങനെ അഭക്തരുടെ പ്രത്യാശ നശിച്ചുപോകും.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവരുടെ ആത്മവിശ്വാസം ക്ഷണഭംഗുരം.","poem":1},{"noteId":8},{"text":"അവരുടെ ആശ്രയം ഒരു ചിലന്തിവലയിലാണ്.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അതിന്റെ വലക്കണ്ണികളിൽ അവർ ചാരുന്നു, എന്നാൽ അതു വഴുതിമാറുന്നു;","poem":1},{"text":"അവർ അതിൽ മുറുകെപ്പിടിക്കുന്നു, എന്നാൽ അത് അവരെ താങ്ങുകയില്ല.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അവർ സൂര്യപ്രകാശത്തിൽ നന്നായി നനച്ചു വളർത്തുന്ന ഒരു ചെടിപോലെയാണ്,","poem":1},{"text":"അതിന്റെ ശാഖകൾ ഉദ്യാനത്തിലാകെ പടർന്നു പന്തലിക്കുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അതിന്റെ വേരുകൾ കൽക്കൂനയിൽ ചുറ്റിപ്പിണഞ്ഞു വളരുന്നു;","poem":1},{"text":"അത് കല്ലുകൾക്കിടയിൽ സ്ഥലം അന്വേഷിക്കുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"എങ്കിലും അതിന്റെ സ്ഥാനത്തുനിന്ന് അതിനെ പിഴുതെടുത്താൽ","poem":1},{"text":"‘ഞാൻ നിന്നെ ഒരിക്കലും കണ്ടിട്ടില്ല,’ എന്നു പറഞ്ഞ് ആ തോട്ടം അതിനെ പുറന്തള്ളും.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ഇതാ, ആ ചെടി കരിഞ്ഞുണങ്ങുന്നു, നിശ്ചയം,","poem":1},{"text":"ആ മണ്ണിൽ മറ്റു ചെടികൾ മുളച്ചുവരികയും ചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“നിഷ്കളങ്കരെ ദൈവം ഒരിക്കലും ഉപേക്ഷിക്കുകയില്ല;","poem":1},{"text":"ദുഷ്കർമികളുടെ കൈകൾ അവിടന്നു ബലപ്പെടുത്തുകയുമില്ല.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവിടന്ന് ഇനിയും നിന്റെ വായിൽ ചിരിയും","poem":1},{"text":"നിന്റെ അധരങ്ങളിൽ ആനന്ദഘോഷവും നിറയ്ക്കും","poem":2}]},{"type":"verse","number":22,"content":[{"text":"നിന്റെ ശത്രുക്കൾ ലജ്ജയാൽ മൂടിപ്പോകും;","poem":1},{"text":"ദുഷ്ടന്മാരുടെ കൂടാരം ഇല്ലാതെയാകും.”","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"ഈ വാക്കിനുള്ള എബ്രായപദത്തിന്റെ അർഥം വ്യക്തമല്ല.","reference":{"chapter":8,"verse":14}}]},"thisChapterLink":"/api/mal_bib/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}