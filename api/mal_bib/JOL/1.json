{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"JOL","translationId":"mal_bib","name":"യോവേൽ","commonName":"യോവേൽ","title":"യോവേലിന്റെ പ്രവചനം","order":29,"numberOfChapters":3,"sha256":"f86e343af32dd7e5b7cf7e04d85154493fe49ae5f205e76799626056f810ced0","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mal_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["പെഥൂവേലിന്റെ മകനായ യോവേലിനുണ്ടായ യഹോവയുടെ അരുളപ്പാട്:"]},{"type":"line_break"},{"type":"heading","content":["വെട്ടുക്കിളിയുടെ ആക്രമണം"]},{"type":"verse","number":2,"content":[{"text":"ഇസ്രായേൽ ഗോത്രത്തലവന്മാരേ, ഇതു കേൾപ്പിൻ;","poem":1},{"text":"സകലദേശവാസികളുമേ, ശ്രദ്ധിക്കുക.","poem":2},{"text":"നിങ്ങളുടെ കാലത്തോ നിങ്ങളുടെ പിതാക്കന്മാരുടെ കാലത്തോ","poem":1},{"text":"ഇതുപോലൊരു കാര്യം എന്നെങ്കിലും സംഭവിച്ചിട്ടുണ്ടോ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ഇതു നിങ്ങളുടെ മക്കളോടു പറയുക,","poem":1},{"text":"നിങ്ങളുടെ മക്കൾ അത് അവരുടെ മക്കളോടും","poem":2},{"lineBreak":true},{"text":"അവരുടെ മക്കൾ അടുത്ത തലമുറയോടും പറയണം.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"തുള്ളൻ തിന്നു ശേഷിപ്പിച്ചതു","poem":1},{"text":"വെട്ടുക്കിളി തിന്നു;","poem":2},{"text":"വെട്ടുക്കിളി ശേഷിപ്പിച്ചതു","poem":1},{"text":"വിട്ടിൽ തിന്നു;","poem":2},{"text":"വിട്ടിൽ ശേഷിപ്പിച്ചതു","poem":1},{"text":"പച്ചപ്പുഴു","poem":2},{"noteId":0},{"text":"തിന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"മദ്യപിക്കുന്നവരേ, ഉണർന്നു കരയുവിൻ!","poem":1},{"text":"വീഞ്ഞു കുടിക്കുന്നവരേ, വിലപിക്കുക;","poem":2},{"text":"പുതുവീഞ്ഞു നിങ്ങളുടെ ചുണ്ടുകളിൽനിന്ന്","poem":1},{"text":"മാറ്റപ്പെട്ടിരിക്കുന്നതിനാൽ വിലപിക്കുക.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ശക്തിയേറിയതും അസംഖ്യവുമായ ഒരു ജനത","poem":1},{"text":"എന്റെ ദേശത്തെ ആക്രമിച്ചിരിക്കുന്നു;","poem":2},{"text":"അതിനു സിംഹത്തിന്റെ പല്ലും","poem":1},{"text":"സിംഹിയുടെ അണപ്പല്ലുകളും ഉണ്ട്.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അത് എന്റെ മുന്തിരിവള്ളിയെ നശിപ്പിച്ചു","poem":1},{"text":"എന്റെ അത്തിവൃക്ഷങ്ങളെ തകർത്തു;","poem":2},{"text":"അതിന്റെ കൊമ്പുകളെ തോലുരിച്ച്","poem":1},{"text":"എറിഞ്ഞുകളഞ്ഞു,","poem":2},{"lineBreak":true},{"text":"ശാഖകളെ വെളുപ്പിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"തന്റെ യൗവനത്തിലെ ഭർത്താവിനെക്കുറിച്ചു വ്യസനിക്കുന്ന","poem":1},{"text":"കന്യകയെപ്പോലെ ചാക്കുശീലയുടുത്തു വിലപിക്കുക.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഭോജനയാഗങ്ങളും പാനീയയാഗങ്ങളും","poem":1},{"text":"യഹോവയുടെ ആലയത്തിൽ തീർന്നുപോയിരിക്കുന്നു.","poem":2},{"text":"യഹോവയുടെമുമ്പിൽ ശുശ്രൂഷിക്കുന്ന","poem":1},{"text":"പുരോഹിതന്മാർ വിലപിക്കുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"വയലുകൾ നശിച്ചിരിക്കുന്നു,","poem":1},{"text":"നിലങ്ങൾ ഉണങ്ങിയിരിക്കുന്നു;","poem":2},{"text":"ധാന്യം നശിച്ചുപോയി,","poem":1},{"text":"പുതുവീഞ്ഞു വറ്റിപ്പോയി,","poem":2},{"lineBreak":true},{"text":"ഒലിവെണ്ണ ഇല്ലാതായി.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"കൃഷിക്കാരേ, ലജ്ജിക്കുക,","poem":1},{"text":"മുന്തിരിക്കർഷകരേ, വിലപിക്കുക;","poem":2},{"text":"ഗോതമ്പിനെയും യവത്തെയും","poem":1},{"noteId":1},{"text":"ഓർത്ത് ദുഃഖിക്കുക,","poem":1},{"text":"നിലത്തിലെ വിളവു നശിച്ചുപോയല്ലോ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"മുന്തിരിവള്ളി വാടി,","poem":1},{"text":"അത്തിവൃക്ഷം ഉണങ്ങിപ്പോയി;","poem":2},{"text":"മാതളവും ഈന്തപ്പനയും ആപ്പിൾമരവും—","poem":1},{"text":"നിലത്തിലെ സകലവൃക്ഷങ്ങളും—ഉണങ്ങിപ്പോയിരിക്കുന്നു.","poem":2},{"text":"മനുഷ്യന്റെ സന്തോഷം","poem":1},{"text":"ഉണങ്ങിപ്പോയിരിക്കുന്നു.","poem":2}]},{"type":"heading","content":["അനുതാപത്തിനുള്ള ആഹ്വാനം"]},{"type":"verse","number":13,"content":[{"text":"പുരോഹിതന്മാരേ, ചാക്കുശീലയുടുത്തു വിലപിക്കുക;","poem":1},{"text":"യാഗപീഠത്തിനുമുമ്പിൽ ശുശ്രൂഷിക്കുന്നവരേ, കരയുവിൻ.","poem":2},{"text":"എന്റെ ദൈവത്തിന്റെ മുമ്പിൽ ശുശ്രൂഷിക്കുന്നവരേ,","poem":1},{"text":"വരിക, ചാക്കുശീലയുടുത്തു രാത്രി കഴിച്ചുകൂട്ടുവിൻ;","poem":2},{"text":"കാരണം നിങ്ങളുടെ ദൈവത്തിന്റെ ആലയത്തിൽ","poem":1},{"text":"ഭോജനയാഗവും പാനീയയാഗവും ഇല്ലാതായിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ഒരു വിശുദ്ധ ഉപവാസം വിളംബരംചെയ്യുക;","poem":1},{"text":"വിശുദ്ധസഭായോഗം വിളിച്ചുകൂട്ടുക.","poem":2},{"text":"ഗോത്രത്തലവന്മാരെയും സകലദേശവാസികളെയും","poem":1},{"text":"നിങ്ങളുടെ ദൈവമായ യഹോവയുടെ ആലയത്തിൽ","poem":2},{"text":"കൂട്ടിവരുത്തുക,","poem":1},{"text":"യഹോവയോടു നിലവിളിക്കുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ആ ദിവസം ഹാ കഷ്ടം!","poem":1},{"text":"യഹോവയുടെ ദിവസം സമീപിച്ചിരിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"സർവശക്തനിൽനിന്ന് നാശംപോലെ ആ ദിവസം വരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"നമ്മുടെ കണ്ണിനുമുന്നിൽ ഭക്ഷണവും","poem":1},{"text":"നമ്മുടെ ദൈവത്തിന്റെ ആലയത്തിൽനിന്ന്","poem":2},{"text":"ആനന്ദവും ആഹ്ലാദവും","poem":1},{"text":"അറ്റുപോയല്ലോ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"വിത്തുകൾ വരണ്ടനിലത്ത്","poem":1},{"noteId":2},{"text":"ഉണങ്ങിച്ചുക്കിച്ചുളിയുന്നു.","poem":2},{"text":"കളപ്പുരകൾ ശൂന്യമായിരിക്കുന്നു.","poem":1},{"text":"ധാന്യം ഉണങ്ങിപ്പോയതുകൊണ്ടു","poem":2},{"lineBreak":true},{"text":"ധാന്യപ്പുരകൾ തകർക്കപ്പെട്ടിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"കന്നുകാലികൾ നിലവിളിക്കുന്നു!","poem":1},{"text":"ആട്ടിൻപറ്റം തളർന്നുപോകുന്നു.","poem":2},{"text":"മേച്ചിൽപ്പുറങ്ങൾ ഇല്ലായ്കയാൽ","poem":1},{"text":"ചെമ്മരിയാട്ടിൻകൂട്ടങ്ങൾ വലയുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"യഹോവേ, ഞാൻ അങ്ങയോടു നിലവിളിക്കുന്നു,","poem":1},{"text":"കാരണം തരിശുനിലത്തെ മേച്ചിൽപ്പുറങ്ങളെ അഗ്നി വിഴുങ്ങിക്കളഞ്ഞു,","poem":2},{"lineBreak":true},{"text":"നിലത്തെ സകലവൃക്ഷങ്ങളെയും ജ്വാലകൾ ദഹിപ്പിച്ചുകളഞ്ഞു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"കാട്ടുമൃഗങ്ങളും അങ്ങേക്കായി കിതയ്ക്കുന്നു;","poem":1},{"text":"നീരരുവികൾ വറ്റിപ്പോയി","poem":2},{"lineBreak":true},{"text":"തരിശുനിലത്തെ മേച്ചിൽപ്പുറങ്ങളെ അഗ്നി വിഴുങ്ങിക്കളഞ്ഞു.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"മൂ.ഭാ. ഈ നാലു വാക്കുകളുടെ കൃത്യമായ അർഥം വ്യക്തമല്ല.","reference":{"chapter":1,"verse":4}},{"noteId":1,"caller":"+","text":"ബാർലി അഥവാ, ബാർലരി","reference":{"chapter":1,"verse":11}},{"noteId":2,"caller":"+","text":"ഈ വാക്കിനുള്ള എബ്രായപദത്തിന്റെ അർഥം വ്യക്തമല്ല.","reference":{"chapter":1,"verse":17}}]},"thisChapterLink":"/api/mal_bib/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}