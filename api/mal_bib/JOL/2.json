{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"JOL","translationId":"mal_bib","name":"യോവേൽ","commonName":"യോവേൽ","title":"യോവേലിന്റെ പ്രവചനം","order":29,"numberOfChapters":3,"sha256":"f86e343af32dd7e5b7cf7e04d85154493fe49ae5f205e76799626056f810ced0","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mal_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["വെട്ടുക്കിളികളുടെ ഒരു സൈന്യം"]},{"type":"verse","number":1,"content":[{"text":"സീയോനിൽ കാഹളം ഊതുക;","poem":1},{"text":"എന്റെ വിശുദ്ധപർവതത്തിൽ യുദ്ധാരവം കേൾപ്പിക്കുക.","poem":2},{"lineBreak":true},{"text":"ദേശത്തിൽ വസിക്കുന്ന സകലരും വിറയ്ക്കട്ടെ,","poem":1},{"text":"കാരണം യഹോവയുടെ ദിവസം വരുന്നു.","poem":2},{"text":"അതു സമീപമായിരിക്കുന്നു—","poem":1}]},{"type":"verse","number":2,"content":[{"text":"അന്ധകാരവും ഇരുട്ടുമുള്ള ഒരു ദിവസം,","poem":2},{"lineBreak":true},{"text":"മേഘങ്ങളും കൂരിരുട്ടുമുള്ള ഒരു ദിവസംതന്നെ.","poem":2},{"text":"പർവതങ്ങളിൽ പ്രഭാതം പടരുന്നതുപോലെ","poem":1},{"text":"വലുപ്പമുള്ളതും ശക്തിയേറിയതുമായ ഒരു സൈന്യം വരുന്നു.","poem":2},{"text":"പണ്ട് അങ്ങനെയൊന്ന് ഉണ്ടായിട്ടില്ല","poem":1},{"text":"വരാനിരിക്കുന്ന കാലങ്ങളിൽ അങ്ങനെയൊന്ന് ഉണ്ടാകുകയുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"അവരുടെമുമ്പിൽ അഗ്നി കത്തുന്നു,","poem":1},{"text":"അവരുടെ പിന്നിൽ ജ്വാല മിന്നുന്നു.","poem":2},{"text":"അവരുടെമുമ്പിൽ ദേശം ഏദെൻതോട്ടംപോലെ,","poem":1},{"text":"അവരുടെ പിന്നിൽ ശൂന്യമരുഭൂമി—","poem":2},{"lineBreak":true},{"text":"അവരിൽനിന്ന് ഒന്നും ഒഴിഞ്ഞുപോകുന്നില്ല.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവർക്കു കുതിരകളോടു സാമ്യമുണ്ട്;","poem":1},{"text":"അവർ കുതിരപ്പടയോടൊപ്പം ചാടുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"രഥങ്ങളുടെ ആരവത്തോടെ","poem":1},{"text":"അവർ പർവതമേടുകളിൽ ചാടുന്നു","poem":2},{"text":"അവർ വൈക്കോൽക്കുറ്റികളെ ദഹിപ്പിക്കുന്ന തീപോലെയും","poem":1},{"text":"യുദ്ധസന്നദ്ധരായ ശക്തരായ ഒരു സൈന്യംപോലെയുമാകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"അവരെ കാണുന്ന ജനങ്ങൾ പരിഭ്രാന്തരാകുന്നു;","poem":1},{"text":"എല്ലാ മുഖങ്ങളും വിളറുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവർ യുദ്ധവീരന്മാരെപ്പോലെ നീങ്ങുന്നു;","poem":1},{"text":"പടയാളികളെപ്പോലെ മതിൽ കയറുന്നു.","poem":2},{"text":"അവർ അണിതെറ്റാതെ","poem":1},{"text":"നിരയായി നീങ്ങുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവർ തിങ്ങിഞെരുങ്ങുന്നില്ല;","poem":1},{"text":"ഓരോരുത്തരായി നേരേ മുമ്പോട്ടു നീങ്ങുന്നു.","poem":2},{"text":"അവർ മുറിവേൽക്കാതെ","poem":1},{"text":"വാളുകൾക്കിടയിലൂടെ ചാടുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവർ പട്ടണങ്ങളിലേക്കു ബദ്ധപ്പെട്ടു ചെല്ലുന്നു;","poem":1},{"text":"അവർ മതിലിന്മീതേ ഓടുന്നു.","poem":2},{"text":"അവർ വീടുകളിൽ കടക്കുന്നു;","poem":1},{"text":"മോഷ്ടാക്കളെപ്പോലെ അവർ ജനാലകളിൽക്കൂടെ പ്രവേശിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"അവരുടെമുമ്പിൽ ഭൂമി കുലുങ്ങുന്നു,","poem":1},{"text":"ആകാശം വിറയ്ക്കുന്നു,","poem":2},{"text":"സൂര്യനും ചന്ദ്രനും ഇരുണ്ടുപോകുന്നു,","poem":1},{"text":"നക്ഷത്രങ്ങൾ പ്രകാശിക്കുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"യഹോവ തന്റെ സൈന്യത്തിന്റെ","poem":1},{"text":"മുൻനിരയിൽ ഇടിമുഴക്കുന്നു;","poem":2},{"text":"അവിടത്തെ സൈന്യം അസംഖ്യമാണ്,","poem":1},{"text":"അവിടത്തെ കൽപ്പന അനുസരിക്കുന്നവർ ശക്തരാണ്.","poem":2},{"text":"യഹോവയുടെ ദിവസം മഹത്തരം;","poem":1},{"text":"അതു ഭയങ്കരം.","poem":2},{"lineBreak":true},{"text":"അത് അതിജീവിക്കാൻ ആർക്കു കഴിയും?","poem":2}]},{"type":"heading","content":["അനുതാപത്തിനായുള്ള ആഹ്വാനം"]},{"type":"verse","number":12,"content":[{"text":"“ഇപ്പോഴെങ്കിലും, പൂർണഹൃദയത്തോടും","poem":1},{"text":"ഉപവാസത്തോടും കണ്ണുനീരോടും കരച്ചിലോടുംകൂടെ","poem":2},{"lineBreak":true},{"text":"എന്റെ അടുക്കലേക്കു മടങ്ങിവരിക,” എന്ന് യഹോവ കൽപ്പിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"നിങ്ങളുടെ വസ്ത്രങ്ങളെയല്ല,","poem":1},{"text":"ഹൃദയത്തെത്തന്നെ കീറുവിൻ;","poem":2},{"text":"നിങ്ങളുടെ ദൈവമായ യഹോവയുടെ അടുക്കലേക്കു മടങ്ങിവരിക,","poem":1},{"text":"അവിടന്ന് കൃപയും മനസ്സലിവും ഉള്ളവൻ;","poem":2},{"text":"എളുപ്പം കോപിക്കാത്തവനും സ്നേഹത്തിൽ സമ്പന്നനും ആകുന്നു,","poem":1},{"text":"അവിടന്ന് അനർഥം അയയ്ക്കുന്നതിൽ അനുതപിക്കുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവിടന്ന് തിരിഞ്ഞു കരുണകാണിക്കും,","poem":1},{"text":"ഒരു അനുഗ്രഹം ശേഷിപ്പിക്കും, ആർക്കറിയാം?","poem":2},{"text":"നിങ്ങളുടെ ദൈവമായ യഹോവയ്ക്ക്","poem":1},{"text":"ഭോജനയാഗങ്ങളും പാനീയയാഗങ്ങളും അർപ്പിക്കാൻ കഴിയുമായിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"സീയോനിൽ കാഹളം ഊതുക,","poem":1},{"text":"വിശുദ്ധ ഉപവാസം വിളംബരംചെയ്യുക,","poem":2},{"lineBreak":true},{"text":"വിശുദ്ധസഭായോഗം വിളിച്ചുകൂട്ടുക.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ജനത്തെ ഒരുമിച്ചുകൂട്ടുവിൻ,","poem":1},{"text":"സഭയെ വിശുദ്ധീകരിക്കുക;","poem":2},{"text":"ഗോത്രത്തലവന്മാരെ കൂട്ടിവരുത്തുവിൻ,","poem":1},{"text":"കുഞ്ഞുങ്ങളെയും മുലകുടിക്കുന്നവരെയും","poem":2},{"lineBreak":true},{"text":"ഒരുമിച്ചുകൂട്ടുവിൻ.","poem":2},{"text":"മണവാളൻ തന്റെ മുറിയിൽനിന്ന്","poem":1},{"text":"അതേ, മണവാട്ടി തന്റെ മണിയറയിൽനിന്ന് പുറത്തുവരട്ടെ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"യഹോവയുടെമുമ്പിൽ ശുശ്രൂഷചെയ്യുന്ന പുരോഹിതന്മാർ","poem":1},{"text":"ആലയത്തിന്റെ പൂമുഖത്തിനും യാഗപീഠത്തിനും മധ്യേ കണ്ണുനീരൊഴുക്കട്ടെ.","poem":2},{"text":"അവർ ഇങ്ങനെ പറയട്ടെ; “യഹോവേ, അങ്ങയുടെ ജനത്തോട് ദയകാണിക്കണമേ.","poem":1},{"text":"അവിടത്തെ അവകാശത്തെ നിന്ദാവിഷയമാക്കരുതേ,","poem":2},{"lineBreak":true},{"text":"ജനതകൾക്കിടയിൽ ഒരു പരിഹാസമാക്കരുതേ.","poem":2},{"text":"‘അവരുടെ ദൈവം എവിടെ?","poem":1},{"text":"എന്ന് അവർ പറയുന്നതെന്തിന്?’ ”","poem":2}]},{"type":"heading","content":["യഹോവയുടെ മറുപടി"]},{"type":"verse","number":18,"content":[{"text":"അപ്പോൾ യഹോവ തന്റെ ദേശത്തെക്കുറിച്ചു തീക്ഷ്ണത കാണിക്കും","poem":1},{"text":"തന്റെ ജനത്തോടു ദയകാണിക്കും.","poem":2}]},{"type":"verse","number":19,"content":["യഹോവ അവരോട് ഇപ്രകാരം മറുപടി പറയും:",{"text":"“ഞാൻ നിങ്ങൾക്കു ധാന്യവും പുതുവീഞ്ഞും എണ്ണയും","poem":1},{"text":"മതിയാവോളം തരും;","poem":2},{"text":"ഇനിയൊരിക്കലും ഞാൻ നിങ്ങളെ","poem":1},{"text":"ജനതകൾക്കിടയിൽ ഒരു പരിഹാസവിഷയമാക്കുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ഞാൻ വടക്കേ സൈന്യത്തെ നിങ്ങളിൽനിന്ന്,","poem":1},{"text":"വരണ്ടതും തരിശുമായ ദേശത്തേക്ക് ഓടിച്ചുകളയും;","poem":2},{"text":"അവരുടെ മുൻനിര കിഴക്ക് ഉപ്പുകടലിൽ","poem":1},{"noteId":3},{"text":"മുങ്ങിത്താഴും","poem":1},{"text":"പിൻനിര പടിഞ്ഞാറ് മെഡിറ്ററേനിയൻ സമുദ്രത്തിലേക്കും പോകും.","poem":2},{"text":"അതിന്റെ നാറ്റം ഉയരും;","poem":1},{"text":"ദുർഗന്ധം വമിച്ചുകൊണ്ടിരിക്കും.”","poem":2},{"lineBreak":true},{"text":"അവൻ വമ്പുകാട്ടിയിരിക്കുന്നു, നിശ്ചയം!","poem":1}]},{"type":"verse","number":21,"content":[{"text":"ദേശമേ, ഭയപ്പെടേണ്ട,","poem":2},{"lineBreak":true},{"text":"സന്തോഷിച്ച് ഉല്ലസിക്കുക.","poem":2},{"text":"നിശ്ചയമായും യഹോവ മഹത്തായ കാര്യങ്ങൾ ചെയ്തിരിക്കുന്നു!","poem":1}]},{"type":"verse","number":22,"content":[{"text":"വയലിലെ മൃഗങ്ങളേ, ഭയപ്പെടേണ്ട,","poem":2},{"lineBreak":true},{"text":"തരിശുനിലത്തെ മേച്ചിൽപ്പുറങ്ങൾ പച്ചയായിത്തീരുന്നു.","poem":2},{"text":"വൃക്ഷങ്ങൾ ഫലം കായ്ക്കുന്നു;","poem":1},{"text":"അത്തിയും മുന്തിരിയും ആദായം തരുന്നു.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"സന്തോഷിക്കുക, സീയോനിലെ ജനമേ,","poem":1},{"text":"നിങ്ങളുടെ ദൈവമായ യഹോവയിൽ സന്തോഷിക്കുക.","poem":2},{"text":"അവിടന്ന് വിശ്വസ്തനാകുകയാൽ","poem":1},{"text":"നിങ്ങൾക്കു മുന്മഴ തരുന്നു;","poem":2},{"text":"അവിടന്ന് ശിശിരത്തിലും വസന്തത്തിലും","poem":1},{"text":"സമൃദ്ധമായ മഴ തരുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"മെതിക്കളങ്ങൾ ധാന്യങ്ങൾകൊണ്ടു നിറയും;","poem":1},{"text":"ചക്കുകളിൽ പുതുവീഞ്ഞും എണ്ണയും കവിഞ്ഞൊഴുകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“വെട്ടുക്കിളികൾ തിന്നുപോയ വർഷങ്ങൾക്കു തക്കവണ്ണം ഞാൻ നിങ്ങൾക്കു പകരംനൽകും—","poem":1},{"text":"ചെറുതും വലുതുമായ വെട്ടുക്കിളികളും","poem":2},{"lineBreak":true},{"text":"തുള്ളനും പച്ചപ്പുഴുവും ഉൾപ്പെടെ","poem":2},{"text":"എന്റെ ഒരു മഹാസൈന്യത്തെ ഞാൻ അയച്ചല്ലോ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"നിങ്ങൾക്കു നിറയുവോളം, സമൃദ്ധമായി ഭക്ഷിക്കാൻ ഉണ്ടാകും,","poem":1},{"text":"അപ്പോൾ നിങ്ങൾക്കുവേണ്ടി അന്നു തങ്ങൾ പ്രവർത്തിച്ച","poem":2},{"lineBreak":true},{"text":"നിങ്ങളുടെ ദൈവമായ യഹോവയുടെ നാമം നിങ്ങൾ സ്തുതിക്കും.","poem":2},{"text":"ഇനിയൊരിക്കലും എന്റെ ജനം ലജ്ജിച്ചുപോകുകയില്ല.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ഞാൻ ഇസ്രായേലിലുണ്ടെന്നും","poem":1},{"text":"ഞാൻ നിന്റെ ദൈവമായ യഹോവയാകുന്നു എന്നും","poem":2},{"lineBreak":true},{"text":"ഞാനല്ലാതെ മറ്റാരും ഇല്ലെന്നും അപ്പോൾ നിങ്ങൾ അറിയും;","poem":2},{"text":"ഇനിയൊരിക്കലും എന്റെ ജനം ലജ്ജിച്ചുപോകുകയില്ല.","poem":1}]},{"type":"heading","content":["യഹോവയുടെ ദിവസം"]},{"type":"verse","number":28,"content":[{"text":"“പിന്നീട്,","poem":1},{"text":"ഞാൻ എന്റെ ആത്മാവിനെ സകലമനുഷ്യരുടെമേലും പകരും.","poem":2},{"text":"നിങ്ങളുടെ പുത്രന്മാരും പുത്രിമാരും പ്രവചിക്കും","poem":1},{"text":"നിങ്ങളുടെ വൃദ്ധന്മാർ സ്വപ്നങ്ങൾ കാണും","poem":2},{"lineBreak":true},{"text":"നിങ്ങളുടെ യുവാക്കൾക്കു ദർശനങ്ങളുണ്ടാകും.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"എന്റെ ദാസന്മാരുടെയും ദാസിമാരുടെയുംമേലും","poem":1},{"text":"ആ നാളുകളിൽ ഞാൻ എന്റെ ആത്മാവിനെ പകരും.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ഞാൻ ആകാശങ്ങളിലും","poem":1},{"text":"ഭൂമിയിലും അത്ഭുതങ്ങൾ കാണിക്കും,","poem":2},{"lineBreak":true},{"text":"രക്തവും തീയും പുകച്ചുരുളുംതന്നെ.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"യഹോവയുടെ ശ്രേഷ്ഠവും ഭയങ്കരവുമായ ദിവസം വരുന്നതിനുമുമ്പേ","poem":1},{"text":"സൂര്യൻ ഇരുളായി മാറുകയും","poem":2},{"lineBreak":true},{"text":"ചന്ദ്രൻ രക്തമായിത്തീരുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"യഹോവയുടെ നാമം വിളിച്ചപേക്ഷിക്കുന്ന","poem":1},{"text":"ഏതൊരുവനും രക്ഷിക്കപ്പെടും;","poem":2},{"text":"യഹോവ അരുളിച്ചെയ്തതുപോലെ","poem":1},{"text":"സീയോൻപർവതത്തിലും ജെറുശലേമിലും","poem":2},{"lineBreak":true},{"text":"രക്ഷപ്പെട്ടവർ ഉണ്ടാകും,","poem":2},{"text":"അവശേഷിക്കുന്നവർക്കിടയിൽപോലും","poem":1},{"text":"യഹോവയാൽ വിളിക്കപ്പെടുന്നവർക്കു വിടുതലുണ്ടാകും.","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"അതായത്, ചാവുകടൽ","reference":{"chapter":2,"verse":20}}]},"thisChapterLink":"/api/mal_bib/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}