{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"JOL","translationId":"mal_bib","name":"യോവേൽ","commonName":"യോവേൽ","title":"യോവേലിന്റെ പ്രവചനം","order":29,"numberOfChapters":3,"sha256":"f86e343af32dd7e5b7cf7e04d85154493fe49ae5f205e76799626056f810ced0","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mal_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["രാഷ്ട്രങ്ങളെ ന്യായംവിധിക്കുന്നു"]},{"type":"verse","number":1,"content":[{"text":"“ആ ദിവസങ്ങളിൽ, ഞാൻ യെഹൂദയുടെയും ജെറുശലേമിന്റെയും","poem":1},{"text":"ഭാവി യഥാസ്ഥാനപ്പെടുത്തുന്ന സമയത്ത്,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ഞാൻ സകലജനതകളെയും ഒരുമിച്ചുകൂട്ടി","poem":1},{"text":"യെഹോശാഫാത്ത്","poem":2},{"noteId":4},{"text":"താഴ്വരയിൽ കൊണ്ടുവരും.","poem":2},{"text":"ഞാൻ എന്റെ അവകാശമായ ഇസ്രായേൽ എന്ന എന്റെ ജനത്തെക്കുറിച്ച്,","poem":1},{"text":"അവർക്കെതിരേ ന്യായംവിധിക്കും.","poem":2},{"text":"അവർ രാഷ്ട്രങ്ങൾക്കിടയിലേക്ക് എന്റെ ജനത്തെ ചിതറിച്ചുകളകയും","poem":1},{"text":"എന്റെ ദേശത്തെ വിഭജിക്കുകയും ചെയ്തല്ലോ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവർ എന്റെ ജനത്തിനു നറുക്കിട്ടു;","poem":1},{"text":"വേശ്യകൾക്കുവേണ്ടി ബാലന്മാരെയും","poem":2},{"lineBreak":true},{"text":"മദ്യം കഴിക്കേണ്ടതിന്, വീഞ്ഞിനുവേണ്ടി അവർ ബാലികമാരെയും വിറ്റു.","poem":2}]},{"type":"verse","number":4,"content":["“സോരും സീദോനും ഉൾപ്പെടെ ഫെലിസ്ത്യദേശത്തിലെ സകലജനങ്ങളുമേ, എനിക്കെതിരേ നിങ്ങൾക്ക് എന്താണുള്ളത്? ഞാൻ ചെയ്ത ഏതെങ്കിലും പ്രവൃത്തിക്കു നിങ്ങൾ പകരംചെയ്യുകയാണോ? നിങ്ങൾ പകരം ചെയ്യുന്നെങ്കിൽ, നിങ്ങളുടെ പ്രവൃത്തിയെ എത്രയുംവേഗം നിങ്ങളുടെ തലമേൽത്തന്നെ ഞാൻ മടക്കിവരുത്തും."]},{"type":"verse","number":5,"content":["നിങ്ങൾ എന്റെ വെള്ളിയും സ്വർണവും എടുത്തു, എന്റെ വിശിഷ്ടനിക്ഷേപങ്ങളെ നിങ്ങളുടെ ക്ഷേത്രങ്ങളിലേക്കുകൊണ്ടുപോയി.",{"noteId":5}]},{"type":"verse","number":6,"content":["യെഹൂദ്യയിലെയും ജെറുശലേമിലെയും ജനങ്ങളെ സ്വന്തം ദേശത്തുനിന്ന് അകലെ അയച്ചുകളയേണ്ടതിനു, നിങ്ങൾ അവരെ ഗ്രീക്കുകാർക്കു വിറ്റു."]},{"type":"verse","number":7,"content":["“നോക്കുക, നിങ്ങൾ അവരെ വിറ്റുകളഞ്ഞ സ്ഥാനങ്ങളിൽ ഞാൻ അവരെ ഉത്തേജിപ്പിക്കും; നിങ്ങൾ ചെയ്തതിനെ നിങ്ങളുടെ തലമേൽ തിരികെവരുത്തും."]},{"type":"verse","number":8,"content":["ഞാൻ നിങ്ങളുടെ പുത്രന്മാരെയും പുത്രിമാരെയും യെഹൂദാജനത്തിനു നൽകും. അവർ അവരെ വിദൂരത്തിലുള്ള ശെബായർക്കു വിറ്റുകളയും,” എന്ന് യഹോവ അരുളിച്ചെയ്തിരിക്കുന്നു."]},{"type":"verse","number":9,"content":[{"text":"ഇതു രാഷ്ട്രങ്ങൾക്കിടയിൽ വിളംബരംചെയ്യുക:","poem":1},{"text":"യുദ്ധത്തിനു സജ്ജമാകുക!","poem":2},{"text":"യുദ്ധവീരന്മാരെ ഉത്തേജിപ്പിക്കുക!","poem":1},{"text":"യുദ്ധവീരന്മാർ അടുത്തുവന്ന് ആക്രമിക്കട്ടെ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"കലപ്പയുടെ കൊഴുക്കളെ വാളുകളായും","poem":1},{"text":"വാക്കത്തികളെ കുന്തങ്ങളായും അടിക്കുക.","poem":2},{"text":"“ഞാൻ ശക്തനാണ്,”","poem":1},{"text":"എന്ന് അശക്തർ പറയട്ടെ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"സകലജനതകളുമേ, എല്ലാ ഭാഗങ്ങളിൽനിന്നും വേഗം വരിക:","poem":1},{"text":"ആ താഴ്വരയിൽ ഒരുമിച്ചുകൂടുവിൻ.","poem":2},{"lineBreak":true},{"text":"യഹോവേ, അങ്ങയുടെ യുദ്ധവീരന്മാരെ കൊണ്ടുവരണമേ!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ജനതകൾ ഉണരട്ടെ;","poem":1},{"text":"അവർ യെഹോശാഫാത്ത് താഴ്വരയിൽ അണിനിരക്കട്ടെ.","poem":2},{"text":"കാരണം അവിടെ എല്ലാ ദിക്കുകളിലുമുള്ള സകലജനതകളെയും ന്യായംവിധിക്കാൻ","poem":1},{"text":"ഞാൻ ഉപവിഷ്ടനാകും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അരിവാൾ വീശുക","poem":1},{"text":"വിളവു പാകമായിരിക്കുന്നു.","poem":2},{"text":"വരിക, മുന്തിരി മെതിക്കുക","poem":1},{"text":"ചക്കു നിറഞ്ഞുകവിഞ്ഞിരിക്കുന്നു,","poem":2},{"lineBreak":true},{"text":"വീഞ്ഞുശേഖരം നിറഞ്ഞുകവിയുന്നു—","poem":2},{"text":"അവരുടെ ദുഷ്ടത അത്ര വലുതായിരിക്കുന്നു.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"വിധിയുടെ താഴ്വരയിൽ","poem":1},{"text":"ജനക്കൂട്ടം, വലിയൊരു ജനക്കൂട്ടംതന്നെ കാത്തുനിൽക്കുന്നു!","poem":2},{"text":"വിധിയുടെ താഴ്വരയിൽ","poem":1},{"text":"യഹോവയുടെ ദിവസം സമീപമായിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"സൂര്യനും ചന്ദ്രനും ഇരുണ്ടുപോകും,","poem":1},{"text":"നക്ഷത്രങ്ങൾ ഇനി പ്രകാശിക്കുകയില്ല.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"യഹോവ സീയോനിൽനിന്ന് ഗർജിക്കും","poem":1},{"text":"ജെറുശലേമിൽനിന്ന് ഇടിമുഴക്കും;","poem":2},{"lineBreak":true},{"text":"ഭൂമിയും ആകാശവും വിറയ്ക്കും.","poem":2},{"text":"എന്നാൽ യഹോവ തന്റെ ജനത്തിന് ഒരു സങ്കേതവും","poem":1},{"text":"ഇസ്രായേലിന് ഒരു കോട്ടയുമായിരിക്കും.","poem":2}]},{"type":"heading","content":["ദൈവജനത്തിനുള്ള അനുഗ്രഹങ്ങൾ"]},{"type":"verse","number":17,"content":[{"text":"“നിങ്ങളുടെ ദൈവമായ യഹോവ എന്ന ഞാൻ,","poem":1},{"text":"എന്റെ വിശുദ്ധപർവതമായ സീയോനിൽ വസിക്കുന്നു എന്നു നിങ്ങൾ അറിയും.","poem":2},{"text":"ജെറുശലേം വിശുദ്ധമായിരിക്കും;","poem":1},{"text":"വിദേശസൈന്യം ഇനിയൊരിക്കലും അവളെ ആക്രമിക്കുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“ആ ദിവസം പർവതങ്ങൾ പുതുവീഞ്ഞു വർഷിക്കും,","poem":1},{"text":"കുന്നുകൾ പാൽ ഒഴുക്കും;","poem":2},{"lineBreak":true},{"text":"യെഹൂദാതാഴ്വരകളിലെ അരുവികളിലെല്ലാം വെള്ളം ഒഴുകും.","poem":2},{"text":"യഹോവയുടെ ആലയത്തിൽനിന്ന് ഒരു ഉറവ പ്രവഹിച്ച്","poem":1},{"text":"ശിത്തീം താഴ്വരകളെ നനയ്ക്കും.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ഈജിപ്റ്റ് ശൂന്യമാകും,","poem":1},{"text":"ഏദോം മരുഭൂമിയാകും,","poem":2},{"text":"അവർ യെഹൂദാജനത്തോടു ചെയ്ത അക്രമം നിമിത്തവും","poem":1},{"text":"ദേശത്തു നിഷ്കളങ്കരക്തം ചിന്തിയതു നിമിത്തവുംതന്നെ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"യെഹൂദ്യയിൽ എന്നേക്കും ആൾപ്പാർപ്പുണ്ടാകും","poem":1},{"text":"എല്ലാ തലമുറകളിലും ജെറുശലേമിൽ ആളുകൾ പാർക്കും.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവരുടെ നിഷ്കളങ്കരക്തത്തിനുള്ള ഞാൻ പ്രതികാരംചെയ്യാതെ വിടുമോ?","poem":1},{"text":"ഇല്ല, ഒരിക്കലുമില്ല.”","poem":2},{"lineBreak":true},"യഹോവ സീയോനിൽ വസിക്കും!"]}],"footnotes":[{"noteId":4,"caller":"+","text":"യഹോവ ന്യായംവിധിക്കുന്നു എന്നർഥം.","reference":{"chapter":3,"verse":2}},{"noteId":5,"caller":"+","text":"അഥവാ, സ്ഥലങ്ങൾ","reference":{"chapter":3,"verse":5}}]},"thisChapterLink":"/api/mal_bib/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}