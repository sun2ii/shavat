{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"LAM","translationId":"mal_bib","name":"വിലാപങ്ങൾ","commonName":"വിലാപങ്ങൾ","title":"വിലാപങ്ങൾ","order":25,"numberOfChapters":5,"sha256":"47d2d902352ffe5acb201e166c8fee8ab59a71ba1d6376ba6db2cceb46b19d64","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/mal_bib/LAM/5.json","totalNumberOfVerses":152},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"യഹോവേ, ഞങ്ങൾക്ക് എന്തു സംഭവിച്ചു എന്നു നോക്കണമേ;","poem":1},{"text":"നോക്കൂ, ഞങ്ങളുടെ നിന്ദ കാണണമേ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ഞങ്ങളുടെ ഓഹരി അപരിചിതർക്കും","poem":1},{"text":"ഞങ്ങളുടെ ഭവനങ്ങൾ വിദേശികൾക്കും ആയിപ്പോയി.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ഞങ്ങൾ അനാഥരും പിതാവില്ലാത്തവരും ആയി,","poem":1},{"text":"ഞങ്ങളുടെ മാതാക്കൾ വിധവമാരെപ്പോലെ ആയി.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ഞങ്ങൾക്കുള്ള വെള്ളം ഞങ്ങൾ വിലകൊടുത്തു വാങ്ങണം;","poem":1},{"text":"വിലകൊടുത്താൽമാത്രമേ ഞങ്ങൾക്കു വിറകു ലഭിക്കുകയുള്ളൂ;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ഞങ്ങളെ പിൻതുടരുന്നവർ ഞങ്ങളുടെ കുതികാലുകളിൽ എത്തി;","poem":1},{"text":"ഞങ്ങൾ ക്ഷീണിച്ചു, വിശ്രമം കണ്ടെത്തുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"മതിയാവോളം അപ്പം കിട്ടേണ്ടതിന്","poem":1},{"text":"ഞങ്ങൾ ഈജിപ്റ്റിനും അശ്ശൂരിനും കീഴടങ്ങി.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ഞങ്ങളുടെ പിതാക്കന്മാർ പാപംചെയ്ത് കടന്നുപോയി","poem":1},{"text":"ഞങ്ങളോ അവർക്കുള്ള ശിക്ഷ അനുഭവിക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അടിമകൾ ഞങ്ങളെ ഭരിക്കുന്നു","poem":1},{"text":"അവരുടെ കൈകളിൽനിന്ന് ഞങ്ങളെ വിടുവിക്കാൻ ആരുമില്ല.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"മരുഭൂമിയിലെ വാൾനിമിത്തം","poem":1},{"text":"ജീവൻ പണയംവെച്ച് ഞങ്ങൾ അപ്പം തേടുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"വിശപ്പിന്റെ താപത്താൽ","poem":1},{"text":"ഞങ്ങളുടെ ത്വക്ക് അടുപ്പുപോലെ നീറുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"സ്ത്രീകൾ സീയോനിലും","poem":1},{"text":"കന്യകമാർ യെഹൂദാപട്ടണങ്ങളിലും ബലാൽക്കാരംചെയ്യപ്പെട്ടു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"പ്രഭുക്കന്മാർ അവരുടെ കരങ്ങളാൽ തൂക്കിലിടപ്പെട്ടു;","poem":1},{"text":"ഗോത്രത്തലവന്മാരോട് യാതൊരു ആദരവും കാട്ടിയതുമില്ല.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"യുവാക്കൾ തിരികല്ലിൽ പണിയുന്നു,","poem":1},{"text":"ബാലന്മാർ വിറകുകെട്ടെടുത്ത് ഇടറുന്നു","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ഗോത്രത്തലവന്മാർ നഗരകവാടത്തിൽനിന്ന് പൊയ്പ്പോയി,","poem":1},{"text":"യുവാക്കൾ അവരുടെ സംഗീതാലാപനം അവസാനിപ്പിച്ചു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഞങ്ങളുടെ ഹൃദയത്തിൽനിന്ന് ആനന്ദം പോയിരിക്കുന്നു;","poem":1},{"text":"ഞങ്ങളുടെ നൃത്തം വിലാപമായി മാറി.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ഞങ്ങളുടെ ശിരസ്സിൽനിന്ന് കിരീടം വീണിരിക്കുന്നു,","poem":1},{"text":"ഞങ്ങൾക്ക് അയ്യോ കഷ്ടം, കാരണം ഞങ്ങൾ പാപംചെയ്തിരിക്കുന്നു!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അതിനാൽ ഞങ്ങളുടെ ഹൃദയം തളർന്നിരിക്കുന്നു","poem":1},{"text":"അതിനാൽ ഞങ്ങളുടെ കണ്ണുകൾ മങ്ങിപ്പോയി.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"പതുങ്ങി നടക്കുന്ന കുറുക്കന്മാരെക്കൊണ്ട്","poem":1},{"text":"സീയോൻപർവതം ശൂന്യമായി കിടക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"യഹോവേ, അവിടന്ന് ശാശ്വതമായി വാഴണമേ;","poem":1},{"text":"അങ്ങയുടെ സിംഹാസനം തലമുറതലമുറയായി നിലനിൽക്കുന്നു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"എന്തുകൊണ്ട് അവിടന്ന് എപ്പോഴും ഞങ്ങളെ മറക്കുന്നു?","poem":1},{"text":"എന്തിന് ഞങ്ങളെ ഇത്രത്തോളം ഉപേക്ഷിക്കുന്നു?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അങ്ങ് ഞങ്ങളെ നിശ്ശേഷം തള്ളിക്കളഞ്ഞിട്ടില്ലായെങ്കിൽ,","poem":1},{"text":"അളവില്ലാത്തവിധം ഞങ്ങളോട് കോപിച്ചിട്ടില്ലായെങ്കിൽ.","poem":2},{"text":"യഹോവേ, ഞങ്ങൾ മടങ്ങിവരേണ്ടതിനു ഞങ്ങളെ അവിടത്തേക്കായി പുനരുദ്ധരിക്കണമേ,","poem":1},{"text":"പണ്ടത്തെപ്പോലെ ഞങ്ങളുടെ നാളുകൾ പുതുക്കണമേ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":21}