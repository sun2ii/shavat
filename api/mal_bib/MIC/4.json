{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"MIC","translationId":"mal_bib","name":"മീഖാ","commonName":"മീഖാ","title":"മീഖായുടെ പ്രവചനം","order":33,"numberOfChapters":7,"sha256":"da714fe4ee54f72cbc01df3a26e50409d0c1d42e9a575122f6fb4cea319d919f","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/mal_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["യഹോവയുടെ പർവതം"]},{"type":"verse","number":1,"content":["അന്തിമനാളുകളിൽ,",{"text":"യഹോവയുടെ ആലയമുള്ള പർവതം,","poem":1},{"text":"പർവതങ്ങളിൽവെച്ച് ഏറ്റവും ശ്രേഷ്ഠമായി അംഗീകരിക്കപ്പെടും;","poem":2},{"text":"അതു കുന്നുകൾക്കുമീതേ മഹത്ത്വീകരിക്കപ്പെടും","poem":1},{"text":"ജനതകൾ അതിലേക്ക് ഒഴുകിയെത്തും.","poem":2}]},{"type":"verse","number":2,"content":["അനേകം ജനതകൾ വന്ന് ഇപ്രകാരം പറയും:",{"text":"“വരൂ, നമുക്ക് യഹോവയുടെ പർവതത്തിലേക്കു കയറിച്ചെല്ലാം,","poem":1},{"text":"യാക്കോബിൻ ദൈവത്തിന്റെ ആലയത്തിലേക്കുതന്നെ.","poem":2},{"text":"അവിടന്ന് തന്റെ വഴികൾ നമ്മെ അഭ്യസിപ്പിക്കും","poem":1},{"text":"അങ്ങനെ നമുക്ക് അവിടത്തെ മാർഗം അവലംബിക്കാം.”","poem":2},{"text":"സീയോനിൽനിന്ന് ഉപദേശവും","poem":1},{"text":"ജെറുശലേമിൽനിന്ന് യഹോവയുടെ വചനവും പുറപ്പെടും.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അനേകം ജനതകളുടെ മധ്യേ അവിടന്ന് ന്യായംവിധിക്കും;","poem":1},{"text":"അടുത്തും അകലെയുമുള്ള ശക്തരായ ജനതകളുടെ തർക്കങ്ങൾക്കു തീർപ്പുകൽപ്പിക്കും.","poem":2},{"text":"അവർ തങ്ങളുടെ വാളുകൾ കലപ്പയ്ക്കു കൊഴുക്കളായും","poem":1},{"text":"കുന്തങ്ങൾ വെട്ടുകത്തികളായും അടിച്ചു രൂപംമാറ്റും.","poem":2},{"text":"രാഷ്ട്രം രാഷ്ട്രത്തിനുനേരേ വാൾ ഉയർത്തുകയില്ല;","poem":1},{"text":"ഇനിയൊരിക്കലും യുദ്ധം അഭ്യസിക്കുകയുമില്ല.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ഓരോരുത്തരും തങ്ങളുടെ മുന്തിരിവള്ളിയുടെ കീഴിലും","poem":1},{"text":"തങ്ങളുടെ അത്തിമരത്തിൻകീഴിലും ഇരിക്കും;","poem":2},{"text":"ആരും അവരെ ഭയപ്പെടുത്തുകയില്ല,","poem":1},{"text":"കാരണം, സൈന്യങ്ങളുടെ യഹോവ ഇത് അരുളിച്ചെയ്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"സകലജനതകളും","poem":1},{"text":"തങ്ങളുടെ ദേവന്മാരുടെ നാമത്തിൽ നടക്കുന്നു;","poem":2},{"text":"എന്നാൽ നാം നമ്മുടെ ദൈവമായ യഹോവയുടെ നാമത്തിൽ","poem":1},{"text":"എന്നുമെന്നേക്കും നടക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ആ ദിവസത്തിൽ, ഞാൻ മുടന്തരെ കൂട്ടിച്ചേർക്കും;","poem":1},{"text":"പ്രവാസികളെയും","poem":2},{"text":"ഞാൻ ദുഃഖിപ്പിച്ചവരെയും കൂട്ടിവരുത്തും,”","poem":1},{"text":"എന്ന് യഹോവ അരുളിച്ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“ഞാൻ മുടന്തരെ എന്റെ ശേഷിപ്പായി നിലനിർത്തും;","poem":1},{"text":"ആട്ടിപ്പായിക്കപ്പെട്ടവരെ ശക്തിയുള്ള ജനമാക്കും.","poem":2},{"text":"യഹോവ അന്നുമുതൽ എന്നേക്കും","poem":1},{"text":"സീയോൻപർവതത്തിൽ അവരെ ഭരിക്കും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ആട്ടിൻകൂട്ടത്തിന്റെ കാവൽഗോപുരമേ,","poem":1},{"text":"സീയോൻപുത്രിയുടെ സുരക്ഷിതസ്ഥാനമേ,","poem":2},{"noteId":7},{"text":"നിന്റെ രാജ്യം പുനഃസ്ഥാപിക്കപ്പെടും;","poem":1},{"text":"രാജത്വം ജെറുശലേം പുത്രിക്കുതന്നെ വന്നുചേരും.”","poem":2}]},{"type":"heading","content":["യഹോവയുടെ പദ്ധതി"]},{"type":"verse","number":9,"content":[{"text":"നിങ്ങൾ ഇപ്പോൾ ഉറക്കെ കരയുന്നതെന്ത്?","poem":1},{"text":"നിങ്ങൾക്കു രാജാവില്ലേ?","poem":2},{"text":"നിങ്ങളുടെ ഭരണാധിപന്മാർ നശിച്ചുപോയോ?","poem":1},{"text":"അതുകൊണ്ടാണോ നോവുകിട്ടിയവളെപ്പോലെ നീ വേദനപ്പെടുന്നത്?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"സീയോൻപുത്രീ, നോവുകിട്ടിയ സ്ത്രീയെപ്പോലെ","poem":1},{"text":"നീ വേദനകൊണ്ട് പുളയുക.","poem":2},{"text":"ഇപ്പോൾത്തന്നെ നീ പട്ടണംവിട്ട്","poem":1},{"text":"തുറസ്സായസ്ഥലത്തു താമസിക്കുന്നതിനു പോകേണ്ടിവരും.","poem":2},{"text":"നീ ബാബേലിലേക്കു പോകും;","poem":1},{"text":"അവിടെവെച്ച് നീ മോചിക്കപ്പെടും.","poem":2},{"text":"അവിടെ നിന്റെ ശത്രുക്കളുടെ കൈയിൽനിന്ന്","poem":1},{"text":"യഹോവ നിന്നെ വീണ്ടെടുക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"എന്നാൽ, ഇപ്പോൾ അനേകം രാഷ്ട്രങ്ങൾ","poem":1},{"text":"നിനക്കെതിരേ കൂട്ടംകൂടിയിരിക്കുന്നു.","poem":2},{"text":"“അവൾ അശുദ്ധയാക്കപ്പെടട്ടെ,","poem":1},{"text":"നമ്മുടെ ദൃഷ്ടികൾ സീയോനെക്കണ്ടു രസിക്കട്ടെ!” എന്ന് അവർ പറയുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"എന്നാൽ, യഹോവയുടെ വിചാരങ്ങൾ","poem":1},{"text":"അവർ അറിയുന്നില്ല;","poem":2},{"text":"മെതിക്കളത്തിലേക്കു കറ്റയെന്നപോലെ അവരെ ശേഖരിക്കുന്ന","poem":1},{"text":"അവിടത്തെ വഴികൾ അവർ ഗ്രഹിക്കുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“സീയോൻപുത്രീ, എഴുന്നേറ്റ് മെതിക്കുക,","poem":1},{"text":"ഞാൻ നിനക്ക് ഇരുമ്പിൻ കൊമ്പുകളും","poem":2},{"text":"വെള്ളോട്ടിൻ കുളമ്പുകളും നൽകും.","poem":1},{"text":"നീ അനേകം രാഷ്ട്രങ്ങളെ തകർത്തുകളയും.”","poem":2},{"text":"അവർ അവിഹിതമായി സമ്പാദിച്ചതു യഹോവയ്ക്കും","poem":1},{"text":"അവരുടെ സമ്പത്തു സകലഭൂമിയുടെയും കർത്താവിനും അർപ്പിക്കും.","poem":2}]}],"footnotes":[{"noteId":7,"caller":"+","text":"അഥവാ, മല","reference":{"chapter":4,"verse":8}}]},"thisChapterLink":"/api/mal_bib/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}