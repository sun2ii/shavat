{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"MIC","translationId":"mal_bib","name":"മീഖാ","commonName":"മീഖാ","title":"മീഖായുടെ പ്രവചനം","order":33,"numberOfChapters":7,"sha256":"da714fe4ee54f72cbc01df3a26e50409d0c1d42e9a575122f6fb4cea319d919f","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/mal_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["ഇസ്രായേലിന്റെ കഷ്ടത"]},{"type":"verse","number":1,"content":[{"text":"എന്റെ ദുരിതം എത്ര ഭയങ്കരം!","poem":1},{"lineBreak":true},{"text":"ഞാൻ വേനൽപ്പഴങ്ങൾ ശേഖരിക്കുന്നവനെപ്പോലെയും","poem":1},{"text":"മുന്തിരിത്തോപ്പിൽ കാലാ പെറുക്കുന്നവനെപ്പോലെയും ആയല്ലോ.","poem":2},{"text":"എനിക്ക് ഭക്ഷിക്കാൻ ഒരു മുന്തിരിക്കുലയും ഇല്ല.","poem":1},{"text":"ഞാൻ കൊതിക്കുന്ന അത്തിയുടെ ആദ്യഫലങ്ങളും ഇല്ല.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"വിശ്വസ്തർ ദേശത്തുനിന്ന് ഇല്ലാതെയായിരിക്കുന്നു;","poem":1},{"text":"നേരുള്ള ആരുംതന്നെ ശേഷിച്ചിട്ടില്ല.","poem":2},{"text":"എല്ലാവരും രക്തം ചിന്തുന്നതിന് പതിയിരിക്കുന്നു;","poem":1},{"text":"അവർ തന്റെ സഹോദരങ്ങളെ വലയുമായി വേട്ടയാടുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ദുഷ്ടത പ്രവർത്തിക്കാൻ ഇരുകൈകൾക്കും സാമർഥ്യമുണ്ട്;","poem":1},{"text":"ഭരണാധികാരി സമ്മാനം ആവശ്യപ്പെടുന്നു,","poem":2},{"text":"ന്യായാധിപൻ കൈക്കൂലി സ്വീകരിക്കുന്നു,","poem":1},{"text":"ശക്തർ തനിക്കിഷ്ടമുള്ളതൊക്കെയും വിളിച്ചുപറയുന്നു.","poem":2},{"lineBreak":true},{"text":"അവർ ഒരുമിച്ച് ഗൂഢാലോചന നടത്തുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവരിൽ ഉത്തമർ മുൾച്ചെടിപോലെ;","poem":1},{"text":"ഏറ്റവും നീതിനിഷ്ഠർ മുൾവേലിയെക്കാൾ ഭയങ്കരർ.","poem":2},{"text":"നിന്റെ കാവൽക്കാർ","poem":1},{"noteId":9},{"text":"മുന്നറിയിപ്പു നൽകിയ ദിവസം,","poem":1},{"text":"ദൈവം നിന്നെ സന്ദർശിക്കുന്ന ദിവസംതന്നെ, വന്നിരിക്കുന്നു.","poem":2},{"lineBreak":true},{"text":"ഇപ്പോൾ അവർക്ക് പരിഭ്രമത്തിന്റെ സമയമാണ്.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അയൽവാസിയെ വിശ്വസിക്കരുത്;","poem":1},{"text":"ആത്മസുഹൃത്തിൽ അമിതവിശ്വാസം അർപ്പിക്കുകയുമരുത്.","poem":2},{"text":"നിന്റെ ആശ്ലേഷത്തിൽ കിടക്കപങ്കിടുന്നവളോടുപോലും","poem":1},{"text":"നിന്റെ വാക്കുകൾ സൂക്ഷിച്ചുകൊള്ളുക.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"മകൻ അപ്പനെ അപമാനിക്കുന്നു,","poem":1},{"text":"മകൾ അമ്മയോട് എതിർത്തുനിൽക്കുന്നു,","poem":2},{"text":"മരുമകൾ അമ്മായിയമ്മയെ എതിർക്കുന്നു—","poem":1},{"text":"ഒരു മനുഷ്യന്റെ ശത്രുക്കൾ അയാളുടെ കുടുംബാംഗങ്ങൾതന്നെ ആയിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"എന്നാൽ, ഞാൻ യഹോവയെ പ്രത്യാശയോടെ നോക്കിക്കൊണ്ടിരിക്കും,","poem":1},{"text":"എന്റെ രക്ഷകനായ ദൈവത്തിനായി ഞാൻ കാത്തിരിക്കും,","poem":2},{"lineBreak":true},{"text":"എന്റെ ദൈവം എന്റെ പ്രാർഥന കേൾക്കും.","poem":2}]},{"type":"heading","content":["ഇസ്രായേലിന്റെ വിജയഗാനം"]},{"type":"verse","number":8,"content":[{"text":"എന്റെ ശത്രുവേ, എന്റെമേൽ സന്തോഷിക്കരുത്!","poem":1},{"text":"വീണുപോയെങ്കിലും ഞാൻ എഴുന്നേൽക്കും.","poem":2},{"text":"ഞാൻ ഇരുട്ടിൽ ഇരുന്നാലും","poem":1},{"text":"യഹോവ എന്റെ വെളിച്ചമായിരിക്കും.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"യഹോവ എന്റെ വ്യവഹാരം നടത്തി","poem":1},{"text":"എന്റെ അവകാശം സ്ഥാപിക്കുന്നതുവരെ","poem":2},{"text":"ഞാൻ അവിടത്തെ കോപം വഹിക്കും.","poem":1},{"text":"കാരണം, ഞാൻ യഹോവയ്ക്കെതിരായി പാപംചെയ്തല്ലോ.","poem":2},{"text":"അവിടന്ന് എന്നെ വെളിച്ചത്തിലേക്കു കൊണ്ടുവരും;","poem":1},{"text":"ഞാൻ അവിടത്തെ നീതിയെ കാണും.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അപ്പോൾ എന്റെ ശത്രു അതു കാണും,","poem":1},{"text":"അവൾ ലജ്ജകൊണ്ടു മൂടപ്പെടും.","poem":2},{"text":"“നിന്റെ ദൈവമായ യഹോവ എവിടെ?”","poem":1},{"text":"എന്ന് എന്നോടു ചോദിച്ചവളുടെ പതനം","poem":2},{"text":"എന്റെ കണ്ണ് കാണും;","poem":1},{"text":"ഇപ്പോൾത്തന്നെ തെരുവീഥിയിലെ ചെളി എന്നപോലെ","poem":2},{"lineBreak":true},{"text":"അവൾ കാൽക്കീഴിൽ ചവിട്ടിമെതിക്കപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"നിന്റെ മതിലുകൾ പണിയുകയും","poem":1},{"text":"നിന്റെ അതിരുകൾ വിശാലമാക്കുകയും ചെയ്യുന്നദിവസം വരും.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ആ ദിവസത്തിൽ അശ്ശൂരിൽനിന്നും","poem":1},{"text":"ഈജിപ്റ്റിലെ നഗരങ്ങളിൽനിന്നും ആളുകൾ നിന്റെ അടുക്കൽവരും,","poem":2},{"text":"ഈജിപ്റ്റുമുതൽ യൂഫ്രട്ടീസ് നദിവരെയും","poem":1},{"text":"സമുദ്രംമുതൽ സമുദ്രംവരെയും","poem":2},{"lineBreak":true},{"text":"പർവതംമുതൽ പർവതംവരെയുമുള്ള ജനവും വരും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ഭൂമി അതിലെ നിവാസികൾ നിമിത്തവും","poem":1},{"text":"അവരുടെ പ്രവൃത്തി നിമിത്തവും ശൂന്യമായിത്തീരും.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അങ്ങയുടെ കോൽകൊണ്ട് സ്വന്തം ജനത്തെ,","poem":1},{"text":"അങ്ങയുടെ അവകാശമായ ആട്ടിൻകൂട്ടത്തെത്തന്നെ മേയിക്കണമേ,","poem":2},{"text":"കാട്ടിലും ഫലപുഷ്ടിയുള്ള മേച്ചിൽപ്പുറങ്ങളിലും","poem":1},{"text":"വസിക്കുന്ന ഈ ആട്ടിൻകൂട്ടം","poem":2},{"text":"പണ്ടത്തെപ്പോലെ","poem":1},{"text":"ബാശാനിലും ഗിലെയാദിലും മേയട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“നിങ്ങൾ ഈജിപ്റ്റിൽനിന്ന് പുറപ്പെട്ടുവന്ന നാളുകളിലെപ്പോലെ","poem":1},{"text":"ഞാൻ അവരെ എന്റെ അത്ഭുതങ്ങൾ കാണിക്കും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"രാഷ്ട്രങ്ങൾ ഇതുകണ്ട് ലജ്ജിക്കും,","poem":1},{"text":"തങ്ങളുടെ സകലശക്തിയും നഷ്ടപ്പെട്ടതുനിമിത്തംതന്നെ.","poem":2},{"text":"അവർ വായ് പൊത്തും","poem":1},{"text":"അവരുടെ ചെവികൾ കേൾക്കാതെയാകും.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവൾ സർപ്പംപോലെ,","poem":1},{"text":"ഭൂമിയിലെ ഇഴജന്തുക്കളെപ്പോലെ പൊടിനക്കും.","poem":2},{"text":"അവർ തങ്ങളുടെ ശക്തികേന്ദ്രങ്ങളിൽനിന്നു വിറച്ചുകൊണ്ടുവരും;","poem":1},{"text":"അവർ നിങ്ങളെ ഭയപ്പെട്ട്","poem":2},{"lineBreak":true},{"text":"നമ്മുടെ ദൈവമായ യഹോവയിലേക്കു തിരിയും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"തന്റെ അവകാശത്തിൽ ശേഷിച്ച ജനത്തിന്റെ","poem":1},{"text":"പാപങ്ങൾ ക്ഷമിക്കുകയും അതിക്രമങ്ങൾ പൊറുക്കുകയും ചെയ്യുന്ന","poem":2},{"lineBreak":true},{"text":"അങ്ങയെപ്പോലെ വേറൊരു ദൈവമുണ്ടോ?","poem":2},{"text":"അങ്ങ് എന്നേക്കും കോപം വെച്ചുകൊണ്ടിരിക്കുന്നില്ല","poem":1},{"text":"എന്നാൽ, കരുണകാണിക്കാൻ അങ്ങ് പ്രസാദിക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അവിടന്ന് വീണ്ടും നമ്മോടുതന്നെ ദയകാണിക്കും;","poem":1},{"text":"അങ്ങ് ഞങ്ങളുടെ പാപങ്ങളെ മെതിച്ചുകളയും","poem":2},{"lineBreak":true},{"text":"ഞങ്ങളുടെ അതിക്രമങ്ങളെല്ലാം സമുദ്രത്തിന്റെ അഗാധങ്ങളിലേക്കു ചുഴറ്റിയെറിയും.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"പൂർവകാലങ്ങളിൽ അങ്ങ് ഞങ്ങളുടെ പിതാക്കന്മാരോട്","poem":1},{"text":"ശപഥം ചെയ്തതുപോലെതന്നെ,","poem":2},{"text":"അങ്ങ് യാക്കോബിനോട് വിശ്വസ്തനായിരിക്കുകയും","poem":1},{"text":"അബ്രാഹാമിനോട് കരുണ കാണിക്കുകയും ചെയ്യും.","poem":2}]}],"footnotes":[{"noteId":9,"caller":"+","text":"കാവൽക്കാർ, വിവക്ഷിക്കുന്നത് പ്രവാചകന്മാർ.","reference":{"chapter":7,"verse":4}}]},"thisChapterLink":"/api/mal_bib/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}