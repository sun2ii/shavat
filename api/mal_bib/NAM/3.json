{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"NAM","translationId":"mal_bib","name":"നഹൂം","commonName":"നഹൂം","title":"നഹൂമിന്റെ പ്രവചനം","order":34,"numberOfChapters":3,"sha256":"0c34152a2e792c6f5aaf69e02b8d5044acca97c045b01dc708773c6450df1ce1","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mal_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["നിനവേയുടെ ദയനീയസ്ഥിതി"]},{"type":"verse","number":1,"content":[{"text":"രക്തച്ചൊരിച്ചിലുകളുടെ പട്ടണത്തിന് അയ്യോ കഷ്ടം!","poem":1},{"text":"കള്ളവും കവർച്ചയും","poem":2},{"text":"അതിൽ നിറഞ്ഞിരിക്കുന്നു,","poem":1},{"text":"പീഡിതർ അവിടെ ഇല്ലാതിരിക്കുകയില്ല!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ചമ്മട്ടിയുടെ പ്രഹരശബ്ദം,","poem":1},{"text":"ചക്രങ്ങൾ ഉരുളുന്ന ശബ്ദം,","poem":2},{"text":"ഓടുന്ന കുതിരകൾ,","poem":1},{"text":"കുതിക്കുന്ന രഥങ്ങൾ!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"മുന്നേറുന്ന കുതിരപ്പട,","poem":1},{"text":"മിന്നുന്ന വാളുകൾ,","poem":2},{"lineBreak":true},{"text":"വെട്ടിത്തിളങ്ങുന്ന കുന്തങ്ങൾ,","poem":2},{"text":"അനേകം അത്യാഹിതങ്ങൾ,","poem":1},{"text":"അനവധി ശവക്കൂമ്പാരങ്ങൾ,","poem":2},{"text":"അസംഖ്യം ശവശരീരങ്ങൾ,","poem":1},{"text":"ജനം ശവങ്ങളിൽ തട്ടിവീഴുന്നു—","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ഇതെല്ലാം സംഭവിച്ചത് ഒരു വേശ്യയുടെ അമിതാവേശംകൊണ്ടുതന്നെ;","poem":1},{"text":"അവൾ വശീകരണവും ക്ഷുദ്രനൈപുണ്യവുമുള്ളവൾ!","poem":2},{"text":"വ്യഭിചാരത്താൽ രാജ്യങ്ങളെയും","poem":1},{"text":"ദുർമന്ത്രവാദത്താൽ ജനതകളെയും കീഴ്പ്പെടുത്തിയവൾതന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ഞാൻ നിനക്ക് എതിരാണ്,” സൈന്യങ്ങളുടെ യഹോവ അരുളിച്ചെയ്യുന്നു.","poem":1},{"text":"“ഞാൻ നിന്റെ വസ്ത്രം മുഖത്തോളം ഉയർത്തും.","poem":2},{"text":"ഞാൻ രാഷ്ട്രങ്ങളെ നിന്റെ നഗ്നതയും","poem":1},{"text":"രാജ്യങ്ങളെ നിന്റെ ഗുഹ്യഭാഗവും കാണിക്കും.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഞാൻ നിന്റെമേൽ അമേധ്യം എറിഞ്ഞ്,","poem":1},{"text":"നിന്ദയോടെ നിന്നോട് ഇടപെട്ട്,","poem":2},{"lineBreak":true},{"text":"നിന്നെ ഒരു കാഴ്ചവസ്തുവാക്കും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"നിന്നെ കാണുന്നവരൊക്കെയും നിന്നിൽനിന്ന് അകന്നുമാറും.","poem":1},{"text":"‘നിനവേ ജീർണിച്ചിരിക്കുന്നു, അവൾക്കുവേണ്ടി ആർ വിലപിക്കും?’ എന്ന് അവർ പറയും.","poem":2},{"lineBreak":true},{"text":"നിന്നെ ആശ്വസിപ്പിക്കാൻ ഞാൻ എവിടെനിന്ന് ആശ്വാസകരെ കണ്ടെത്തും?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"നൈൽനദീതീരത്ത്","poem":1},{"text":"വെള്ളത്താൽ ചുറ്റപ്പെട്ടുകിടക്കുന്ന","poem":2},{"lineBreak":true},{"text":"നോ-അമ്മോനെക്കാൾ","poem":2},{"noteId":0},{"text":"നീ ഉത്തമയോ?","poem":2},{"text":"നദി അവൾക്കു പ്രതിരോധവും","poem":1},{"text":"വെള്ളം മതിലും ആയിരുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"കൂശും ഈജിപ്റ്റും അവളുടെ അന്തമില്ലാത്ത ബലവും","poem":1},{"text":"പൂത്യരും ലൂബ്യരും അവളോടു സഖ്യമുള്ളവരുടെ കൂട്ടത്തിലും ആയിരുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"എങ്കിലും അവൾ തടവിലായി,","poem":1},{"text":"നാടുകടത്തപ്പെടുകയും ചെയ്തു.","poem":2},{"text":"സകലചത്വരങ്ങളിലുംവെച്ച്","poem":1},{"text":"അവളുടെ ശിശുക്കൾ എറിഞ്ഞുകൊല്ലപ്പെട്ടു.","poem":2},{"text":"അവളുടെ പ്രഭുക്കന്മാർക്കുവേണ്ടി നറുക്കിട്ടു","poem":1},{"text":"എല്ലാ മഹാന്മാരും ചങ്ങലയാൽ ബന്ധിക്കപ്പെട്ടു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"നീയും ലഹരിയാൽ മത്തുപിടിക്കും;","poem":1},{"text":"ശത്രുനിമിത്തം നീ ഒളിവിൽപ്പോയി","poem":2},{"lineBreak":true},{"text":"ഒരു സുരക്ഷിതസ്ഥാനം അന്വേഷിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"നിന്റെ കോട്ടകളെല്ലാം","poem":1},{"text":"വിളഞ്ഞ ആദ്യഫലമുള്ള അത്തിവൃക്ഷത്തിനു തുല്യം;","poem":2},{"text":"അവ കുലുക്കിയാൽ","poem":1},{"text":"തിന്നുന്നവരുടെ വായിൽത്തന്നെ അത്തിക്കായ്കൾ വീഴും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"നിന്റെ സൈന്യങ്ങളെ നോക്കൂ","poem":1},{"text":"അവരെല്ലാം അശക്തർതന്നെ!","poem":2},{"noteId":1},{"text":"നിന്റെ ദേശത്തിലെ കവാടങ്ങൾ","poem":1},{"text":"ശത്രുക്കൾക്കായി മലർക്കെ തുറക്കപ്പെട്ടിരിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"അഗ്നി അതിന്റെ ഓടാമ്പലുകളെ ദഹിപ്പിച്ചിരിക്കന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ഉപരോധത്തിനായി വെള്ളം ശേഖരിക്ക","poem":1},{"text":"നിന്റെ പ്രതിരോധം ശക്തിപ്പെടുത്തുക!","poem":2},{"text":"ചെളിയിൽ അധ്വാനിച്ച്","poem":1},{"text":"ചാന്തു കുഴച്ച്","poem":2},{"lineBreak":true},{"text":"ഇഷ്ടികക്കെട്ടിന്റെ കേടുതീർക്കുക!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവിടെ അഗ്നി നിന്നെ വിഴുങ്ങും;","poem":1},{"text":"വാൾ നിന്നെ അരിഞ്ഞുവീഴ്ത്തും","poem":2},{"lineBreak":true},{"text":"വിട്ടിലിനെ എന്നപോലെ നിന്നെ വിഴുങ്ങിക്കളയും.","poem":2},{"text":"നീ വിട്ടിലിനെപ്പോലെ പെരുകി,","poem":1},{"text":"വെട്ടുക്കിളിയെപ്പോലെ വർധിക്കുക.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"നിന്റെ വ്യാപാരികളുടെ എണ്ണം","poem":1},{"text":"നീ ആകാശത്തിലെ നക്ഷത്രങ്ങളെക്കാൾ അധികം വർധിപ്പിച്ചു,","poem":2},{"text":"എന്നാൽ അവർ വെട്ടുക്കിളി എന്നപോലെ","poem":1},{"text":"ദേശത്തെ നശിപ്പിച്ച് പറന്നുപോകുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"നിന്റെ കാവൽക്കാർ വെട്ടുക്കിളികളെപ്പോലെയും","poem":1},{"text":"നിന്റെ ഉദ്യോഗസ്ഥർ ശൈത്യദിനത്തിൽ മതിലുകളിൽ","poem":2},{"lineBreak":true},{"text":"പറ്റിപ്പിടിച്ചിരിക്കുന്ന വെട്ടുക്കിളിക്കൂട്ടം പോലെയുമാകുന്നു.","poem":2},{"text":"എന്നാൽ, സൂര്യൻ ഉദിക്കുമ്പോൾ അവ പറന്നുപോകുന്നു,","poem":1},{"text":"എവിടേക്കെന്ന് ആരും അറിയുന്നതുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"അല്ലയോ അശ്ശൂർരാജാവേ, നിന്റെ ഇടയന്മാർ","poem":1},{"noteId":2},{"text":"മയങ്ങുന്നു;","poem":1},{"text":"നിന്റെ പ്രഭുക്കന്മാർ വിശ്രമത്തിനായി കിടക്കുന്നു.","poem":2},{"text":"ഒരുമിച്ചുകൂട്ടുന്നതിന് ആരുമില്ലാതെ","poem":1},{"text":"നിന്റെ ജനം പർവതങ്ങളിൽ ചിതറിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"നിന്റെ മുറിവ് ഉണക്കാൻ ഒന്നിനാലും സാധ്യമല്ല;","poem":1},{"text":"നിന്റെ മുറിവ് മാരകംതന്നെ.","poem":2},{"text":"നിന്റെ വാർത്ത കേൾക്കുന്നവരെല്ലാം","poem":1},{"text":"നിന്റെ പതനത്തിൽ കൈകൊട്ടുന്നു,","poem":2},{"text":"നിന്റെ അന്തമില്ലാത്ത ദ്രോഹം","poem":1},{"text":"ഏൽക്കാത്തവരായി ആരുണ്ട്?","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"അഥവാ തേബ്സിനെക്കാൾ","reference":{"chapter":3,"verse":8}},{"noteId":1,"caller":"+","text":"മൂ.ഭാ. നാരികൾതന്നെ.","reference":{"chapter":3,"verse":13}},{"noteId":2,"caller":"+","text":"ഇടയന്മാർ, വിവക്ഷിക്കുന്നത് ഭരണാധിപന്മാർ.","reference":{"chapter":3,"verse":18}}]},"thisChapterLink":"/api/mal_bib/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}