{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_bib","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"0779a8d526ec7ab3a8f6f2d92fa1dee6c63a9df2883af973dbb429592e73a01c","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":["ശലോമോന്റെ സുഭാഷിതങ്ങൾ:",{"text":"ജ്ഞാനമുള്ള മക്കൾ","poem":1},{"noteId":27},{"text":"അവരുടെ പിതാവിന് ആനന്ദമേകുന്നു,","poem":1},{"text":"ബുദ്ധിഹീനരായ മക്കൾ അവരുടെ മാതാവിന് വ്യഥയേകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"അന്യായമായി നേടിയ സമ്പത്ത് നിലനിൽക്കുകയില്ല,","poem":1},{"text":"എന്നാൽ ധർമിഷ്ഠമായ ജീവിതം മരണത്തിൽനിന്ന് വിടുവിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"നീതിനിഷ്ഠർ വിശന്നുവലയാൻ യഹോവ അനുവദിക്കുകയില്ല,","poem":1},{"text":"ദുഷ്ടരുടെ അതിമോഹത്തെ അവിടന്ന് നിഷ്ഫലമാക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"അലസകരങ്ങൾ ദാരിദ്ര്യം ക്ഷണിച്ചുവരുത്തും,","poem":1},{"text":"എന്നാൽ ഉത്സാഹികളുടെ കരങ്ങളോ, സമ്പത്തു കൊണ്ടുവരുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"വിവേകികളായ മക്കൾ വേനൽക്കാലത്ത് ധാന്യം ശേഖരിക്കുന്നു,","poem":1},{"text":"എന്നാൽ കൊയ്ത്തുകാലത്ത് ഉറങ്ങുന്നവരോ, അപമാനം വരുത്തുന്ന മക്കളും ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"അനുഗ്രഹങ്ങൾ നീതിനിഷ്ഠരുടെ ശിരസ്സിൽ കിരീടമണിയിക്കുന്നു,","poem":1},{"text":"എന്നാൽ ദുഷ്ടത പ്രവർത്തിക്കുന്നവരുടെ അധരം അതിക്രമം ഒളിപ്പിച്ചുവെച്ചിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"നീതിനിഷ്ഠരുടെ നാമം അനുഗ്രഹാശിസ്സുകൾക്ക്","poem":1},{"noteId":28},{"text":"ഉപയുക്തമാകുന്നു,","poem":1},{"text":"എന്നാൽ ദുഷ്ടത പ്രവർത്തിക്കുന്നവരുടെ നാമം ജീർണിച്ചുപോകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ജ്ഞാനഹൃദയമുള്ളവർ കൽപ്പനകൾ അംഗീകരിക്കുന്നു,","poem":1},{"text":"എന്നാൽ വായാടികളായ ഭോഷർ നശിച്ചുപോകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"സത്യസന്ധതയുള്ള മനുഷ്യർ സുരക്ഷിതരായി ജീവിക്കും,","poem":1},{"text":"കുടിലമാർഗങ്ങളിൽ ജീവിക്കുന്നവർ പിടിക്കപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ദുഷ്ടലാക്കോടെ കണ്ണിറുക്കുന്നവർ ദോഷംവരുത്തുന്നു","poem":1},{"text":"വായാടികളായ ഭോഷർ നാശത്തിലേക്കു പതിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"നീതിനിഷ്ഠരുടെ അധരം ജീവജലധാരയാണ്,","poem":1},{"text":"എന്നാൽ ദുഷ്ടരുടെ അധരം അക്രമത്തെ മറച്ചുവെക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"വിദ്വേഷം ഭിന്നത ഇളക്കിവിടുന്നു,","poem":1},{"text":"എന്നാൽ സ്നേഹം എല്ലാ അകൃത്യവും മറച്ചുവെക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"വിവേകിയുടെ അധരങ്ങളിൽ ജ്ഞാനം കുടികൊള്ളുന്നു,","poem":1},{"text":"എന്നാൽ വിവേകഹീനരുടെ മുതുകിൽ ഒരു പ്രഹരമാണു വീഴുന്നത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ബുദ്ധിയുള്ളവർ പരിജ്ഞാനം സംഭരിച്ചുവെക്കുന്നു,","poem":1},{"text":"എന്നാൽ ഭോഷരുടെ വായ് നാശം ക്ഷണിച്ചുവരുത്തുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ധനമുള്ളവരുടെ സമ്പത്ത് അവർക്കു കോട്ടകെട്ടിയ നഗരമാണ്,","poem":1},{"text":"എന്നാൽ ദാരിദ്ര്യം അഗതികൾക്കു നാശകരവുമാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"നീതിനിഷ്ഠരുടെ സമ്പാദ്യം ജീവദായകം,","poem":1},{"text":"എന്നാൽ നീചരുടെ അധ്വാനഫലം പാപവും മരണവും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ശിക്ഷണം സ്വീകരിക്കുന്നവർ ജീവന്റെ പാതയിലാണ്,","poem":1},{"text":"എന്നാൽ ശാസന നിരസിക്കുന്നവർ വഴിതെറ്റിപ്പോകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"വ്യാജ അധരങ്ങൾകൊണ്ട് വിദ്വേഷം മറച്ചുവെക്കുകയും","poem":1},{"text":"പരദൂഷണം പ്രചരിപ്പിക്കുകയും ചെയ്യുന്നവർ ഭോഷരാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"വാക്കുകളുടെ ബഹുലതകൊണ്ട് പാപം ഇല്ലാതാകുന്നില്ല,","poem":1},{"text":"എന്നാൽ വിവേകി തന്റെ നാവിനെ അടക്കിനിർത്തുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"നീതിനിഷ്ഠരുടെ അധരങ്ങൾ മേൽത്തരമായ വെള്ളി,","poem":1},{"text":"ദുഷ്ടരുടെ ഹൃദയത്തിന് തീരെ മൂല്യമില്ലാതാനും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"നീതിനിഷ്ഠരുടെ അധരങ്ങൾ അനേകരെ പരിപോഷിപ്പിക്കുന്നു,","poem":1},{"text":"എന്നാൽ ബുദ്ധിശൂന്യതകൊണ്ട് ഭോഷർ മരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"യഹോവയുടെ അനുഗ്രഹം സമ്പത്ത് പ്രദാനംചെയ്യുന്നു,","poem":1},{"text":"അവിടന്ന് അതിനോട് കഷ്ടതയൊന്നും കൂട്ടിച്ചേർക്കുന്നില്ല.","poem":2},{"noteId":29}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ദോഷം പ്രവർത്തിക്കുന്നത് ഭോഷർക്ക് ഒരു വിനോദം,","poem":1},{"text":"എന്നാൽ ഒരു വിവേകി ജ്ഞാനത്തിൽ ആഹ്ലാദിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ദുഷ്ടത പ്രവർത്തിക്കുന്നവർ ഭയപ്പെടുന്നതുതന്നെ അവർക്കു ഭവിക്കും;","poem":1},{"text":"നീതിനിഷ്ഠരുടെ അഭിലാഷങ്ങൾ സഫലമാക്കപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"വീശിയടിക്കുന്ന കൊടുങ്കാറ്റ് ദുഷ്ടത പ്രവർത്തിക്കുന്നവരെ ചുഴറ്റിയെറിയും,","poem":1},{"text":"എന്നാൽ നീതിനിഷ്ഠർ എല്ലാ കാലത്തേക്കും ഉറച്ചുനിൽക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"തങ്ങളെ നിയോഗിക്കുന്നവർക്ക് അലസർ","poem":1},{"text":"പല്ലിനു വിന്നാഗിരിയും കണ്ണിനു പുകയും എന്നപോലെയാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"യഹോവാഭക്തി ആയുസ്സിനെ ദീർഘമാക്കുന്നു,","poem":1},{"text":"എന്നാൽ ദുഷ്ടരുടെ സംവത്സരങ്ങൾ ഹ്രസ്വമാക്കപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"നീതിനിഷ്ഠരുടെ പ്രത്യാശ ആനന്ദമേകുന്നു,","poem":1},{"text":"എന്നാൽ ദുഷ്ടത പ്രവർത്തിക്കുന്നവരുടെ പ്രതീക്ഷയോ, നിഷ്ഫലം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"യഹോവയുടെ മാർഗം നീതിനിഷ്ഠർക്കൊരു സങ്കേതം,","poem":1},{"text":"എന്നാൽ ദോഷം പ്രവർത്തിക്കുന്നവർക്ക് അത് നാശകരം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"നീതിനിഷ്ഠർ ഒരിക്കലും ഉന്മൂലമാക്കപ്പെടുകയില്ല,","poem":1},{"text":"എന്നാൽ ദുഷ്ടത പ്രവർത്തിക്കുന്നവർ ദേശത്ത് സുസ്ഥിരമായി ജീവിക്കുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"നീതിനിഷ്ഠരുടെ നാവിൽനിന്നു ജ്ഞാനം പ്രവഹിക്കുന്നു,","poem":1},{"text":"എന്നാൽ വഞ്ചനയുള്ള നാവ് ഛേദിക്കപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"നീതിനിഷ്ഠരുടെ അധരം പ്രസാദകരമായവ തിരിച്ചറിയുന്നു,","poem":1},{"text":"എന്നാൽ ദുഷ്ടരുടെ നാവ് വൈകൃതഭാഷണത്തിന് ഉറവിടം.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":27,"caller":"+","text":"മൂ.ഭാ. മകൻ","reference":{"chapter":10,"verse":1}},{"noteId":28,"caller":"+","text":"ഉൽ. 48:20","reference":{"chapter":10,"verse":7}},{"noteId":29,"caller":"+","text":"അഥവാ, കഠിനാധ്വാനംകൊണ്ട് അതിനോട് ഒന്നും കൂട്ടാൻ കഴിയുന്നില്ല.","reference":{"chapter":10,"verse":22}}]},"thisChapterLink":"/api/mal_bib/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}