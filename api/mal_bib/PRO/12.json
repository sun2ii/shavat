{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_bib","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"0779a8d526ec7ab3a8f6f2d92fa1dee6c63a9df2883af973dbb429592e73a01c","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"ശിക്ഷണം ഇഷ്ടപ്പെടുന്നവർ പരിജ്ഞാനം ഇഷ്ടപ്പെടുന്നു,","poem":1},{"text":"എന്നാൽ ശാസന വെറുക്കുന്നവർ മണ്ടന്മാരാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"നല്ല മനുഷ്യർക്ക് യഹോവയിൽനിന്നു പ്രീതി ലഭിക്കും,","poem":1},{"text":"ദുഷ്ടത മെനയുന്നവരെ അവിടന്ന് ശിക്ഷിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ദുഷ്ടതയിലൂടെ ആരുംതന്നെ സ്ഥിരതനേടുന്നില്ല,","poem":1},{"text":"എന്നാൽ നീതിനിഷ്ഠരെ ഉന്മൂലനംചെയ്യുക സാധ്യമല്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ചാരുശീലയാം പത്നി തന്റെ പതിക്കൊരു മകുടം,","poem":1},{"text":"എന്നാൽ മാനംകെട്ടവൾ പതിയുടെ അസ്ഥികളിൽ ബാധിച്ച അർബുദംപോലെയും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"നീതിനിഷ്ഠരുടെ പദ്ധതികൾ ന്യായയുക്തം,","poem":1},{"text":"എന്നാൽ ദുഷ്ടരുടെ ആലോചന വഞ്ചനാപരം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ദുഷ്ടരുടെ വാക്കുകൾ നിഷ്കളങ്കരക്തത്തിനായി പതിയിരിക്കുന്നു,","poem":1},{"text":"എന്നാൽ നീതിനിഷ്ഠരുടെ വാക്കുകൾ അവരെ സുരക്ഷിതരാക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ദുഷ്ടർ പരാജയപ്പെടുകയും ഇല്ലാതാകുകയും ചെയ്യും,","poem":1},{"text":"എന്നാൽ നീതിനിഷ്ഠരുടെ ഭവനം സുസ്ഥിരമായി നിലനിൽക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ഒരു മനുഷ്യൻ തന്റെ ജ്ഞാനത്തിനനുസരിച്ച് ആദരിക്കപ്പെടും,","poem":1},{"text":"കുടിലബുദ്ധിയുള്ളവർ പുച്ഛിക്കപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"സാധാരണക്കാരനെങ്കിലും ഒരു ദാസനുള്ളയാളാണ്","poem":1},{"text":"അന്നത്തെ അന്നത്തിനു വകയില്ലെങ്കിലും വമ്പുനടിച്ചു നടക്കുന്നവരെക്കാൾ ശ്രേഷ്ഠർ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"നീതിനിഷ്ഠർ തങ്ങളുടെ മൃഗങ്ങളുടെ ആവശ്യങ്ങളിൽപോലും ശ്രദ്ധാലുക്കളാണ്,","poem":1},{"text":"എന്നാൽ ദുഷ്ടരുടെ കരുണാർദ്രമായ പ്രവൃത്തികൾപോലും ക്രൂരതനിറഞ്ഞതാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"സ്വന്തം കൃഷിയിടത്തിൽ അധ്വാനിക്കുന്നവർക്കു ധാരാളം ആഹാരം ലഭിക്കുന്നു,","poem":1},{"text":"എന്നാൽ ദിവാസ്വപ്നങ്ങളുടെ പിന്നാലെ പായുന്നവർ ബുദ്ധിഹീനരാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"നീചർ ദുഷ്ടരുടെ സുരക്ഷിതസ്ഥാനം ആഗ്രഹിക്കുന്നു,","poem":1},{"text":"എന്നാൽ നീതിനിഷ്ഠരുടെ വേര് ഫലംനൽകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ദുഷ്ടർ തങ്ങളുടെ അധരങ്ങളുടെ ലംഘനത്താൽ കുരുക്കിലകപ്പെടുന്നു,","poem":1},{"text":"എന്നാൽ നിരപരാധി അനർഥത്തിൽനിന്നു രക്ഷപ്പെടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"തങ്ങളുടെ അധരഫലത്താൽ മനുഷ്യർ നന്മകൊണ്ടു തൃപ്തരാകും,","poem":1},{"text":"അവരുടെ കൈകളുടെ അധ്വാനഫലം അവർക്കു പ്രതിഫലം നൽകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ഭോഷർ തങ്ങളുടെ വഴികൾ ശരിയെന്നു കരുതുന്നു,","poem":1},{"text":"എന്നാൽ ജ്ഞാനി മറ്റുള്ളവരുടെ ഉപദേശം ശ്രദ്ധിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ഭോഷർ തങ്ങളുടെ നീരസം ഉടൻതന്നെ പ്രകടിപ്പിക്കുന്നു,","poem":1},{"text":"എന്നാൽ വിവേകി അവഹേളനത്തെ അവഗണിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"സത്യസന്ധതയുള്ള സാക്ഷി സത്യം പ്രസ്താവിക്കുന്നു,","poem":1},{"text":"എന്നാൽ കള്ളസാക്ഷി വ്യാജംപറയുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"വീണ്ടുവിചാരമില്ലാത്തവരുടെ വാക്കുകൾ വാളുകൾപോലെ തുളച്ചുകയറുന്നു,","poem":1},{"text":"എന്നാൽ ജ്ഞാനിയുടെ നാവു സൗഖ്യദായകമാകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"സത്യസന്ധമായ നാവു സദാകാലത്തേക്കും നിലനിൽക്കുന്നു,","poem":1},{"text":"എന്നാൽ വ്യാജംപറയുന്ന അധരം നൈമിഷികമാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ദുഷ്ടത നെയ്തുകൂട്ടുന്നവരുടെ ഹൃദയത്തിൽ കുടിലത ആവസിക്കുന്നു,","poem":1},{"text":"എന്നാൽ സമാധാനം പ്രചരിപ്പിക്കുന്നവർക്ക് ആനന്ദമുണ്ട്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"നീതിനിഷ്ഠർക്കു യാതൊരുവിധ അനർഥവും സംഭവിക്കുകയില്ല,","poem":1},{"text":"എന്നാൽ ദുഷ്ടർ അനർഥംകൊണ്ടു നിറയും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"കളവുപറയുന്ന അധരങ്ങൾ യഹോവ വെറുക്കുന്നു,","poem":1},{"text":"എന്നാൽ സത്യസന്ധരിൽ അവിടന്നു സന്തുഷ്ടനാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"വിവേകി പരിജ്ഞാനം തങ്ങളിൽത്തന്നെ അടക്കിവെക്കുന്നു,","poem":1},{"text":"എന്നാൽ ഭോഷരുടെ ഹൃദയം അവിവേകം പുലമ്പുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"സ്ഥിരോത്സാഹിയുടെ കരങ്ങൾ ഭരണം നടത്തുന്നു,","poem":1},{"text":"എന്നാൽ അലസത അടിമത്തത്തിൽ എത്തിച്ചേരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ഉത്കണ്ഠ ഹൃദയഭാരമുണ്ടാക്കുന്നു,","poem":1},{"text":"എന്നാൽ ഒരു നല്ലവാക്ക് ഉത്സാഹം നൽകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"നീതിനിഷ്ഠർ തങ്ങളുടെ സുഹൃത്തുക്കളെ ശ്രദ്ധാപൂർവം തെരഞ്ഞെടുക്കുന്നു,","poem":1},{"text":"എന്നാൽ ദുഷ്കർമികളുടെ മാർഗം അവരെ വഴിതെറ്റിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"അലസരായവർ വേട്ടമൃഗത്തിന്റെ മാംസം പാകംചെയ്യുന്നില്ല,","poem":1},{"noteId":33},{"text":"എന്നാൽ ഉത്സാഹി അവ മതിയാവോളം ആസ്വദിച്ച് ഭക്ഷിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"നീതിയുടെ മാർഗത്തിൽ ജീവനുണ്ട്,","poem":1},{"text":"ആ വഴിയിൽ അമർത്യതയുമുണ്ട്.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":33,"caller":"+","text":"ഈ വാക്കിനുള്ള എബ്രായപദത്തിന്റെ അർഥം വ്യക്തമല്ല.","reference":{"chapter":12,"verse":27}}]},"thisChapterLink":"/api/mal_bib/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}