{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_bib","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"0779a8d526ec7ab3a8f6f2d92fa1dee6c63a9df2883af973dbb429592e73a01c","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"സൗമ്യമായ ഉത്തരം ക്രോധത്തെ ശമിപ്പിക്കുന്നു,","poem":1},{"text":"പരുക്കൻവാക്ക് കോപം ജ്വലിപ്പിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ജ്ഞാനിയുടെ നാവു പരിജ്ഞാനം വിതറുന്നു,","poem":1},{"text":"എന്നാൽ ഭോഷരുടെ നാവു മടയത്തരം വർഷിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"യഹോവയുടെ ദൃഷ്ടി എല്ലായിടത്തുമുണ്ട്,","poem":1},{"text":"ദുഷ്ടരെയും നല്ലവരെയും വീക്ഷിച്ചുകൊണ്ടിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"സാന്ത്വനമരുളുന്ന നാവു ജീവവൃക്ഷം,","poem":1},{"text":"എന്നാൽ വഞ്ചനയുള്ള നാവ് ആത്മചൈതന്യം തകർക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ഭോഷർ പിതാവിന്റെ ശിക്ഷണം നിരാകരിക്കുന്നു,","poem":1},{"text":"എന്നാൽ ശാസന അംഗീകരിക്കുന്നവർ വിവേകശാലികൾ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"നീതിനിഷ്ഠരുടെ ഭവനത്തിൽ വലിയ നിക്ഷേപങ്ങളുണ്ട്,","poem":1},{"text":"എന്നാൽ ദുഷ്ടരുടെ ആദായം ആപത്തു കൊണ്ടുവരുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ജ്ഞാനിയുടെ അധരങ്ങൾ പരിജ്ഞാനം വിതറുന്നു,","poem":1},{"text":"എന്നാൽ ഭോഷരുടെ ഹൃദയത്തിന് നൽകാനൊന്നുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ദുഷ്ടരുടെ യാഗം യഹോവ വെറുക്കുന്നു,","poem":1},{"text":"എന്നാൽ നീതിനിഷ്ഠരുടെ പ്രാർഥന അവിടത്തേക്കു പ്രസാദകരം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ദുഷ്ടരുടെ മാർഗം യഹോവ വെറുക്കുന്നു,","poem":1},{"text":"എന്നാൽ നീതി പിൻതുടരുന്നവരെ അവിടന്ന് സ്നേഹിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"നേർപാത ഉപേക്ഷിക്കുന്നവർക്കു കഠിനശിക്ഷണം ലഭിക്കും;","poem":1},{"text":"ശാസന വെറുക്കുന്നവർ മരണത്തെ പുൽകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"മരണവും പാതാളവും","poem":1},{"noteId":37},{"text":"യഹോവയുടെമുമ്പാകെ തുറന്നുകിടക്കുന്നു;","poem":1},{"text":"മനുഷ്യഹൃദയം എത്രയധികമായി അവിടന്ന് അറിയുന്നു!","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"പരിഹാസി ശാസന വെറുക്കുന്നു,","poem":1},{"text":"അവർ ജ്ഞാനിയിൽനിന്ന് അകലം പാലിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"സന്തുഷ്ടഹൃദയം മുഖത്ത് പ്രസന്നതയുളവാക്കുന്നു,","poem":1},{"text":"ഹൃദയവ്യഥയോ, ആത്മചൈതന്യം ഹനിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"വിവേകമുള്ള ഹൃദയം പരിജ്ഞാനം അന്വേഷിക്കുന്നു,","poem":1},{"text":"എന്നാൽ ഭോഷരുടെ ആഹാരം മടയത്തരംതന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"പീഡിതന്റെ നാളുകളോരോന്നും ക്ലേശഭരിതം,","poem":1},{"text":"എന്നാൽ ഉല്ലാസഹൃദയം നിരന്തരം ഉത്സവം ആഘോഷിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"യഹോവാഭക്തിയോടുകൂടെയുള്ള അൽപ്പധനമാണ്,","poem":1},{"text":"കഷ്ടതയോടുകൂടെയുള്ള ബഹുനിക്ഷേപത്തെക്കാൾ നല്ലത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"സ്നേഹപൂർവം വിളമ്പുന്ന സസ്യാഹാരമാണ്,","poem":1},{"text":"വിദ്വേഷത്തോടെ വിളമ്പുന്ന തടിച്ചുകൊഴുത്ത പശുക്കിടാവിന്റെ മാംസത്തെക്കാൾ ഭേദം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ക്ഷിപ്രകോപിയായ മനുഷ്യൻ കലഹത്തിനു തുടക്കംകുറിക്കുന്നു,","poem":1},{"text":"എന്നാൽ ക്ഷമാശീലൻ കലഹത്തെ ശമിപ്പിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"അലസരുടെ വഴി മുള്ളുകളാൽ തടസ്സപ്പെടുന്നു,","poem":1},{"text":"എന്നാൽ നീതിനിഷ്ഠരുടെ മാർഗം രാജവീഥിയാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ജ്ഞാനിയായ മകൻ തന്റെ പിതാവിന് ആനന്ദം പകരുന്നു,","poem":1},{"text":"എന്നാൽ ഭോഷരായ മനുഷ്യർ തങ്ങളുടെ മാതാവിനെ നിന്ദിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"വിവേകശൂന്യർക്കു മടയത്തരം ആനന്ദംനൽകുന്നു,","poem":1},{"text":"എന്നാൽ വിവേകികൾ നേർവീഥിയിൽത്തന്നെ സഞ്ചരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ബുദ്ധിയുപദേശത്തിന്റെ അഭാവംമൂലം പദ്ധതികൾ പരാജയപ്പെടുന്നു,","poem":1},{"text":"എന്നാൽ നിരവധി വിദഗ്ധോപദേശം ലഭിച്ചാൽ അവ വിജയിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ഉചിതമായ ഉത്തരം ഏവർക്കും ആനന്ദംനൽകുന്നു;","poem":1},{"text":"സന്ദർഭോചിതമായ ഒരു വാക്ക് എത്ര മനോഹരം!","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"വിവേകിയുടെ ജീവിതപാത ഉയരങ്ങളിലേക്കു നയിക്കുന്നു","poem":1},{"text":"അത് അവരെ പാതാളത്തിന്റെ ആഴങ്ങളിലേക്ക് ആണ്ടുപോകുന്നതു തടയും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"അഹങ്കാരിയുടെ ഭവനം യഹോവ നശിപ്പിക്കും,","poem":1},{"text":"എന്നാൽ അവിടന്ന് വിധവയുടെ അതിർത്തി സംരക്ഷിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ദുഷ്ടരുടെ ചിന്തകൾ യഹോവ വെറുക്കുന്നു,","poem":1},{"text":"കനിവോലും വാക്കുകളോ, അവിടത്തേക്കു പ്രസാദം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"അത്യാഗ്രഹം സ്വഭവനത്തെ നശിപ്പിക്കുന്നു,","poem":1},{"text":"എന്നാൽ കൈക്കൂലി വെറുക്കുന്നവർ ഏറെനാൾ ജീവിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ഉത്തരം നൽകേണ്ടതെങ്ങനെയെന്ന് നീതിനിഷ്ഠരുടെ ഹൃദയം ആലോചിക്കുന്നു,","poem":1},{"text":"എന്നാൽ ദുഷ്ടരുടെ വായിൽനിന്ന് തിന്മനിറഞ്ഞ വാക്കുകൾ വമിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"യഹോവ ദുഷ്ടരിൽനിന്ന് അകന്നിരിക്കുന്നു,","poem":1},{"text":"എന്നാൽ നീതിനിഷ്ഠരുടെ പ്രാർഥന അവിടന്നു കേൾക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"പ്രസന്നതയോടെയുള്ള ഒരു നോട്ടം ഹൃദയത്തിന് ആനന്ദം പകരുകയും","poem":1},{"text":"സദ്വാർത്ത അസ്ഥികൾക്ക് ഉന്മേഷം പകരുകയുംചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"ജീവദായകമായ ശാസന കേൾക്കുന്നവർ","poem":1},{"text":"ജ്ഞാനികളുടെ മധ്യത്തിൽ സ്വസ്ഥനായിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"ശിക്ഷണം നിരാകരിക്കുന്നവർ സ്വയനിന്ദയ്ക്ക് ഇരയാകുന്നു,","poem":1},{"text":"എന്നാൽ ശാസന ശ്രദ്ധിക്കുന്നവർ വിവേകപൂർണനാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"യഹോവാഭക്തി ജ്ഞാനം അഭ്യസിപ്പിക്കുന്നു,","poem":1},{"text":"വിനയം ബഹുമതിയുടെ മുന്നോടിയാണ്.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":37,"caller":"+","text":"മൂ.ഭാ. ഷിയോലും അബദ്ദോനും","reference":{"chapter":15,"verse":11}}]},"thisChapterLink":"/api/mal_bib/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}