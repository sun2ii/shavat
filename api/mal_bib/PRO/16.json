{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_bib","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"0779a8d526ec7ab3a8f6f2d92fa1dee6c63a9df2883af973dbb429592e73a01c","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"ഹൃദയത്തിലെ നിരൂപണങ്ങൾ മനുഷ്യനുള്ളവ,","poem":1},{"text":"എന്നാൽ നാവിൽനിന്നുള്ള ശരിയായ ഉത്തരം യഹോവയിൽനിന്നു വരുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"മനുഷ്യനു തന്റെ വഴികളെല്ലാം കുറ്റമറ്റതെന്നു തോന്നുന്നു,","poem":1},{"text":"എന്നാൽ യഹോവ അതിന്റെ ഉദ്ദേശ്യശുദ്ധി തൂക്കിനോക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"നിന്റെ പ്രവൃത്തികളെല്ലാം യഹോവയ്ക്കു സമർപ്പിക്കുക,","poem":1},{"text":"അപ്പോൾ നിന്റെ പദ്ധതികളെല്ലാം അവിടന്നു സ്ഥിരമാക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"യഹോവ സർവവും അതിന്റെ ഉദ്ദിഷ്ടലക്ഷ്യത്തിൽ എത്തിക്കുന്നു—","poem":1},{"text":"ദുരന്തദിനത്തിനായി ദുഷ്ടരെപ്പോലും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"അഹന്തഹൃദയമുള്ള എല്ലാവരെയും യഹോവ വെറുക്കുന്നു.","poem":1},{"text":"അവർ ശിക്ഷിക്കപ്പെടും; ഇതു നിശ്ചയം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"സ്നേഹാർദ്രതയാലും വിശ്വസ്തതയാലും പാപത്തിനു പ്രായശ്ചിത്തം ഉണ്ടാകുന്നു,","poem":1},{"text":"യഹോവാഭക്തിമൂലം ഒരു മനുഷ്യൻ തിന്മ വർജിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ഒരാളുടെ വഴി യഹോവയ്ക്കു പ്രസാദകരമാകുമ്പോൾ,","poem":1},{"text":"അവിടന്ന് അയാളുടെ ശത്രുക്കളെപ്പോലും അയാൾക്ക് അനുകൂലമാക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"നീതിമാർഗത്തിലൂടെ ലഭിക്കുന്ന അൽപ്പം ധനമുള്ളതാണ്","poem":1},{"text":"അനീതിയിലൂടെ നേടുന്ന വൻ സമ്പത്തിനെക്കാൾ നല്ലത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"മനുഷ്യർ തങ്ങളുടെ ഹൃദയത്തിൽ പദ്ധതികൾ ആസൂത്രണംചെയ്യുന്നു,","poem":1},{"text":"എന്നാൽ യഹോവ അവരുടെ കാലടികളുടെ ഗമനം ക്രമീകരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"രാജകൽപ്പന അരുളപ്പാടുകൾപോലെയാണ്,","poem":1},{"text":"തിരുവായ് ഒരിക്കലും അന്യായമായി വിധിക്കാൻ പാടില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"കൃത്യതയാർന്ന അളവുകളും തൂക്കങ്ങളും യഹോവയ്ക്കുള്ളവ;","poem":1},{"text":"സഞ്ചിയിലുള്ള എല്ലാ തൂക്കുകട്ടികളും അവിടത്തെ കൈവേലയാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ദുഷ്‌പ്രവൃത്തികൾ രാജാക്കന്മാർക്ക് നിഷിദ്ധം,","poem":1},{"text":"നീതിയിലൂടെയാണ് രാജസിംഹാസനം ഉറപ്പിക്കപ്പെടുന്നത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"സത്യസന്ധമായ അധരം രാജാക്കന്മാർക്കു പ്രസാദകരം;","poem":1},{"text":"സത്യം പറയുന്നവരെ അവിടന്ന് ആദരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"രാജകോപം മരണദൂതനാണ്,","poem":1},{"text":"എന്നാൽ ജ്ഞാനി അതിനെ ശമിപ്പിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"പ്രശോഭിതമാകുന്ന രാജമുഖത്തു ജീവനുണ്ട്;","poem":1},{"text":"അവിടത്തെ പ്രസാദം വസന്തകാല മഴമേഘത്തിനുതുല്യമാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ജ്ഞാനം നേടുന്നത് കനകത്തെക്കാൾ എത്രയോ അഭികാമ്യം,","poem":1},{"text":"വിവേകം സമ്പാദിക്കുന്നത് വെള്ളിയെക്കാൾ എത്രശ്രേഷ്ഠം!","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"നീതിനിഷ്ഠരുടെ രാജവീഥി തിന്മ ഒഴിവാക്കുന്നു;","poem":1},{"text":"തങ്ങളുടെ മാർഗം സൂക്ഷിക്കുന്നവർ അവരുടെ ജീവൻ സംരക്ഷിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"അഹങ്കാരം നാശത്തിന്റെ മുന്നോടിയാണ്;","poem":1},{"text":"ധിക്കാരമനോഭാവവും നാശത്തിന്റെ മുന്നോടിതന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"പീഡിതരോടൊത്ത് എളിമയോടെ ജീവിക്കുന്നതാണ്,","poem":1},{"text":"അഹങ്കാരികളോടൊത്തു കൊള്ള പങ്കിടുന്നതിലും നല്ലത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ഉപദേശങ്ങൾ ശ്രദ്ധിക്കുന്നവർക്ക് അഭിവൃദ്ധിയുണ്ടാകുന്നു,","poem":1},{"text":"യഹോവയിൽ ആശ്രയമർപ്പിക്കുന്നവർ അനുഗൃഹീതർ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ജ്ഞാനഹൃദയമുള്ളവർ വിവേകി എന്നു വിളിക്കപ്പെടും,","poem":1},{"text":"ഹൃദ്യമായ വാക്ക് സ്വാധീനംചെലുത്തും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"വിവേകം കൈമുതലാക്കിയവർക്ക് അതു ജീവജലധാരയാണ്,","poem":1},{"text":"എന്നാൽ മടയത്തരം ഭോഷർക്കു ശിക്ഷയായി ഭവിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"വിവേകിയുടെ ഹൃദയം അവരുടെ അധരങ്ങൾ ജ്ഞാനമുള്ളവയാക്കുന്നു,","poem":1},{"text":"അവരുടെ അധരങ്ങൾ സ്വാധീനംചെലുത്തും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ഹൃദ്യമായ വാക്ക് തേനടയാണ്,","poem":1},{"text":"അത് ആത്മാവിനു മാധുര്യവും അസ്ഥികൾക്ക് ആരോഗ്യവും നൽകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ഓരോരുത്തർക്കും തങ്ങളുടെമുമ്പിലുള്ള വഴി ശരിയായത് എന്നു തോന്നാം,","poem":1},{"text":"എന്നാൽ അവസാനം അതു മരണത്തിലേക്കു നയിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"തൊഴിലാളിയുടെ വിശപ്പ് അവരെക്കൊണ്ടു വേലചെയ്യിപ്പിക്കുന്നു;","poem":1},{"text":"വിശപ്പുള്ള വയറ് അവരെ ഉത്സാഹിപ്പിച്ചുകൊണ്ടിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"വഞ്ചകർ ദോഷം എന്ന കുഴി കുഴിക്കുന്നു,","poem":1},{"text":"അവരുടെ ഭാഷണം എരിതീപോലെയാകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"വക്രഹൃദയമുള്ളവർ കലഹം ഇളക്കിവിടുന്നു,","poem":1},{"text":"പരദൂഷണം ആത്മസുഹൃത്തുക്കളെത്തമ്മിൽ അകറ്റുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ഒരു അക്രമി അയൽവാസിയെ വശീകരിച്ച്","poem":1},{"text":"അരുതാത്ത വഴികളിലേക്ക് ആനയിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"കണ്ണിറുക്കുന്നവർ വക്രതയ്ക്കു ഗൂഢാലോചന നടത്തുന്നു;","poem":1},{"text":"ചുണ്ട് കടിച്ചമർത്തുന്നവർ ദുഷ്കൃത്യം ആസൂത്രണംചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"നരച്ചതല മഹിമയുടെ മകുടമാണ്;","poem":1},{"text":"നീതിമാർഗത്തിലൂടെ അതു നേടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"പടയാളികളെക്കാൾ ശ്രേഷ്ഠരാണ് ക്ഷമാശീലർ,","poem":1},{"text":"ഒരു നഗരം പിടിച്ചടക്കുന്നവരിലും ശ്രേഷ്ഠരാണ് ആത്മനിയന്ത്രണമുള്ളവർ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"തീരുമാനങ്ങൾക്കായി നറുക്കിടുന്നു,","poem":1},{"text":"എന്നാൽ അതിന്റെ തീർപ്പ് യഹോവയിൽനിന്നു വരുന്നു.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}