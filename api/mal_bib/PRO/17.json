{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_bib","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"0779a8d526ec7ab3a8f6f2d92fa1dee6c63a9df2883af973dbb429592e73a01c","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"സമാധാനത്തോടും ശാന്തതയോടുമുള്ള ഒരു ഉണങ്ങിയ അപ്പക്കഷണം","poem":1},{"text":"കലഹമുള്ള ഭവനത്തിലെ സമൃദ്ധമായ വിരുന്നിനെക്കാൾ നല്ലത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"വിവേകമുള്ള സേവകർ യജമാനന്റെ നാണംകെട്ട മക്കളുടെമേൽ ആധിപത്യംനടത്തുകയും","poem":1},{"text":"കൂടാതെ, മക്കളിൽ ഒരാളെപ്പോലെ പിതൃസ്വത്തിൽ അവകാശിയാകുകയും ചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"തീച്ചൂളയിൽ വെള്ളിയും ഉലയിൽ സ്വർണവും ശുദ്ധിചെയ്യപ്പെടുന്നു,","poem":1},{"text":"എന്നാൽ യഹോവ ഹൃദയം പരിശോധിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ദുഷ്ടർ കുടിലഭാഷണങ്ങൾക്കു ചെവികൊടുക്കുന്നു;","poem":1},{"text":"കള്ളം പറയുന്നവർ നാശഹേതുകമായ അധരങ്ങൾ ശ്രദ്ധിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ദരിദ്രരെ പരിഹസിക്കുന്നവർ അവരുടെ സ്രഷ്ടാവിനോട് അനാദരവുകാട്ടുന്നു;","poem":1},{"text":"അന്യരുടെ ദുരന്തത്തിൽ ആനന്ദിക്കുന്നവർ ശിക്ഷിക്കപ്പെടാതിരിക്കുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"പേരക്കുട്ടികൾ വൃദ്ധർക്കൊരു മകുടവും","poem":1},{"text":"മക്കൾ മാതാപിതാക്കൾക്കൊരു അഭിമാനവുമാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"അതിഭാഷണം ഭോഷർക്കു ഭൂഷണമല്ല—","poem":1},{"text":"വ്യാജഭാഷണം ഭരണകർത്താക്കൾക്ക് എത്രയധികം അനുചിതവും!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"കൈക്കൂലി നൽകുന്നവർക്ക് അതൊരു വശീകരണോപാധിയാണ്;","poem":1},{"text":"എല്ലാറ്റിലും വിജയം കൈവരിക്കാമെന്ന് അവർ കരുതുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"അകൃത്യം ക്ഷമിക്കുന്നവർ സ്നേഹം വർധിപ്പിക്കുന്നു,","poem":1},{"text":"എന്നാൽ അതു നിരന്തരം ഓർമപ്പെടുത്തുന്നവർ സ്നേഹിതരെ അകറ്റുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ഭോഷരുടെ മുതുകത്തു നൽകുന്ന നൂറ് അടിയെക്കാൾ","poem":1},{"text":"വിവേകിക്കു നൽകുന്ന ഒരു ശാസന കൂടുതൽ പ്രയോജനംനൽകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"അധർമികൾ മാത്സര്യത്തിന് ഉത്സാഹിക്കുന്നു;","poem":1},{"text":"അവർക്കെതിരേ മരണത്തിന്റെ ദൂതൻ നിയോഗിക്കപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"കുട്ടികൾ അപഹരിക്കപ്പെട്ട തള്ളക്കരടിയെ നേരിടുന്നതിനെക്കാൾ അപകടകരമാണ്,","poem":1},{"text":"ഭോഷരുടെ മടയത്തരങ്ങൾ നേരിടുന്നത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"നന്മയ്ക്കുപകരം തിന്മചെയ്യുന്നവരുടെ ഭവനത്തിൽനിന്ന്,","poem":1},{"text":"തിന്മ ഒരുനാളും വിട്ടൊഴിയുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"കലഹത്തിന്റെ ആരംഭം ഒരു അണക്കെട്ടു പൊട്ടിപ്പിളരുന്നതുപോലെയാണ്;","poem":1},{"text":"അതുകൊണ്ട് തർക്കം ഉടലെടുക്കുന്നതിനുമുമ്പുതന്നെ അത് ഒഴിവാക്കുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"കുറ്റവാളിയെ മോചിപ്പിക്കുന്നതും നിരപരാധിക്ക് ശിക്ഷവിധിക്കുന്നതും—","poem":1},{"text":"ഇവ രണ്ടും യഹോവയ്ക്ക് അറപ്പാകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ജ്ഞാനം സമ്പാദിക്കാൻ ആഗ്രഹമില്ലാത്ത ഭോഷരുടെ","poem":1},{"text":"വിദ്യാഭ്യാസത്തിനു പണം ചെലവഴിക്കുന്നതു എന്തു ഭോഷത്തം?","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ഒരു സുഹൃത്തിന്റെ സ്നേഹം എല്ലാക്കാലത്തേക്കും ഉള്ളത്,","poem":1},{"text":"ആപത്തുകാലത്തു സഹായിയായി നിൽക്കുന്നതിനുവേണ്ടിയാണ് ഒരു കൂടപ്പിറപ്പ് ജനിക്കുന്നത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ബുദ്ധിഹീനർ ജാമ്യക്കരാറിൽ കൈയൊപ്പുചാർത്തുകയും","poem":1},{"text":"അയൽവാസിയുടെ ബാധ്യത ഏൽക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"കലഹപ്രിയർ പാപത്തെ പ്രണയിക്കുന്നു;","poem":1},{"text":"ഉയർന്ന മതിൽ നിർമിക്കുന്നവർ നാശം ക്ഷണിച്ചുവരുത്തുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"വക്രഹൃദയമുള്ളവർ അഭിവൃദ്ധിപ്രാപിക്കുന്നില്ല,","poem":1},{"text":"വഞ്ചനയോടെ സംസാരിക്കുന്നവർ അനർഥത്തിലേക്കു വഴുതിവീഴും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"മാതാപിതാക്കൾക്ക് ഭോഷരായ മക്കൾ ഉണ്ടായിരിക്കുന്നതു വേദനാജനകം;","poem":1},{"text":"ഭോഷരുടെ മാതാപിതാക്കൾക്ക് ആനന്ദം അന്യമായിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"സന്തുഷ്ടഹൃദയം നല്ലൊരു ഔഷധം,","poem":1},{"text":"എന്നാൽ തകർന്ന മനസ്സ് അസ്ഥികളെ ഉരുക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ദുഷ്ടർ രഹസ്യമായി കൈക്കൂലി വാങ്ങുന്നു","poem":1},{"text":"നീതിയുടെ വഴികൾ അട്ടിമറിക്കാൻ അവർ അപ്രകാരംചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"വിവേകികൾ തങ്ങളുടെ ദൃഷ്ടി ജ്ഞാനത്തിൽ ഉറപ്പിക്കുന്നു,","poem":1},{"text":"എന്നാൽ ഭോഷരുടെ കണ്ണുകൾ ഭൂമിയുടെ അതിർത്തികളിൽ അലയുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ഭോഷരായ മക്കൾ","poem":1},{"noteId":38},{"text":"അവരുടെ പിതാവിനു സങ്കടവും","poem":1},{"text":"തങ്ങളുടെ പെറ്റമ്മയ്ക്കു കയ്‌പും കൊണ്ടുവരുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"നിഷ്കളങ്കർക്കു പിഴ കൽപ്പിക്കുന്നത് ഉചിതമല്ല,","poem":1},{"text":"സത്യസന്ധതയുള്ള ഉദ്യോഗസ്ഥരെ പ്രഹരിക്കുന്നതും യുക്തമല്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"പരിജ്ഞാനമുള്ളവർ തങ്ങളുടെ വാക്കുകൾ നിയന്ത്രിച്ച് ഉപയോഗിക്കുന്നു,","poem":1},{"text":"വിവേകമുള്ള മനുഷ്യർ സമചിത്തത പാലിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"നിശ്ശബ്ദതപാലിക്കുന്ന ഭോഷർപോലും ജ്ഞാനികളായി പരിഗണിക്കപ്പെടും","poem":1},{"text":"നാവടക്കിയിരിക്കുന്നവർ വിവേകികളായും എണ്ണപ്പെടും.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":38,"caller":"+","text":"മൂ.ഭാ. ഭോഷനായ മകൻ","reference":{"chapter":17,"verse":25}}]},"thisChapterLink":"/api/mal_bib/PRO/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PRO/16.json","previousChapterAudioLinks":{},"numberOfVerses":28}