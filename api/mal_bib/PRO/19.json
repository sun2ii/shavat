{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_bib","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"0779a8d526ec7ab3a8f6f2d92fa1dee6c63a9df2883af973dbb429592e73a01c","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"വഞ്ചനാപരമായി സംസാരിക്കുന്ന ഭോഷരെക്കാൾ","poem":1},{"text":"പരമാർഥതയോടെ ജീവിക്കുന്ന ദരിദ്രർ എത്ര നല്ലവർ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"പരിജ്ഞാനമില്ലാതെ ആവേശംകാണിക്കുന്നതു നല്ലതല്ല,","poem":1},{"text":"തിടുക്കത്തോടെ ചുവടുകൾവെക്കുന്നവർക്കു വഴിതെറ്റുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ഒരു മനുഷ്യന്റെ മൗഢ്യം അയാളെ നാശത്തിലേക്കു നയിക്കുന്നു,","poem":1},{"text":"എന്നിട്ടും അയാളുടെ ഹൃദയം യഹോവയ്ക്കെതിരേ രോഷാകുലമാകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"സമ്പത്ത് ധാരാളം സുഹൃത്തുക്കളെ കൊണ്ടുവരുന്നു,","poem":1},{"text":"എന്നാൽ ദാരിദ്ര്യം ഉറ്റസുഹൃത്തുക്കളെപ്പോലും അകറ്റുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"കള്ളസാക്ഷി ശിക്ഷിക്കപ്പെടാതിരിക്കുകയില്ല,","poem":1},{"text":"വ്യാജം പറഞ്ഞുഫലിപ്പിക്കുന്നവർ രക്ഷപ്പെടുകയുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ഭരണകർത്താക്കളുടെ പ്രീതിക്കായി ധാരാളമാളുകൾ ശ്രമിക്കുന്നു,","poem":1},{"text":"എല്ലാവരും ദാനശീലരുടെ സുഹൃത്തുക്കളുമാകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ദരിദ്രരുടെ ബന്ധുക്കളെല്ലാം അവരെ ഒഴിവാക്കുന്നു—","poem":1},{"text":"അവരുടെ സുഹൃത്തുക്കൾ അവരുമായി അകലംപാലിക്കാൻ എത്രയധികം ശ്രമിക്കും!","poem":2},{"text":"ദരിദ്രർ അവരോടു കേണപേക്ഷിക്കും","poem":1},{"text":"എന്നാൽ അവർ പ്രതികരിക്കുകപോലുമില്ല.","poem":2},{"noteId":39}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ജ്ഞാനം ആർജിക്കുന്നവർ തന്റെ ജീവനെ സ്നേഹിക്കുന്നു;","poem":1},{"text":"വിവേകത്തെ പരിപോഷിപ്പിക്കുന്നവർ അഭിവൃദ്ധിനേടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"കള്ളസാക്ഷി ശിക്ഷിക്കപ്പെടാതിരിക്കുകയില്ല,","poem":1},{"text":"വ്യാജം പറഞ്ഞുഫലിപ്പിക്കുന്നവർ നശിച്ചുപോകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ആഡംബരജീവിതം ഭോഷർക്കു യോജിച്ചതല്ല—","poem":1},{"text":"രാജകുമാരന്മാരെ ഒരടിമ ഭരിക്കുന്നത് അതിലെത്രയോ അനഭികാമ്യം!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ഒരാളുടെ ജ്ഞാനം അയാൾക്കു ക്ഷമാശീലം നൽകുന്നു;","poem":1},{"text":"അതിക്രമത്തെ അവഗണിക്കുന്നതിലൂടെ അയാൾ ആദരവുനേടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"രാജക്രോധം സിംഹഗർജനംപോലെയാണ്,","poem":1},{"text":"എന്നാൽ അവിടത്തെ പ്രസാദം പുൽപ്പുറത്തെ തുഷാരബിന്ദുപോലെയും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ഒരു ഭോഷസന്താനം പിതാവിന്റെ നാശം;","poem":1},{"text":"കലഹപ്രിയയായ ഭാര്യയോ,","poem":2},{"lineBreak":true},{"text":"നിലയ്ക്കാത്ത ചോർച്ചപോലെയും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"വീടുകളും ധനവും പൈതൃകസ്വത്തായി ലഭിക്കുന്ന ഓഹരി,","poem":1},{"text":"എന്നാൽ വിവേകമതിയായ ഭാര്യ യഹോവയുടെ ദാനം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"അലസത ഗാഢനിദ്ര വരുത്തുന്നു,","poem":1},{"text":"മടിയൻ വിശന്നുനടക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"കൽപ്പനകൾ പ്രമാണിക്കുന്നവർ തങ്ങളുടെ ജീവൻ സൂക്ഷിക്കുന്നു,","poem":1},{"text":"എന്നാൽ അവയെ അവഗണിക്കുന്നവർ മരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ദരിദ്രരോടു ദയകാണിക്കുന്നവർ യഹോവയ്ക്കു വായ്പകൊടുക്കുന്നു,","poem":1},{"text":"അവരുടെ പ്രവൃത്തികൾക്ക് അവിടന്ന് പ്രതിഫലംനൽകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"പ്രതീക്ഷയുള്ളിടത്തോളം നിന്റെ മക്കളെ ശിക്ഷണത്തിൽ വളർത്തുക;","poem":1},{"text":"അവർ നശിച്ചുപോകട്ടെയെന്ന് ആഗ്രഹിക്കരുത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ക്ഷിപ്രകോപിയായ മനുഷ്യൻ പിഴയൊടുക്കേണ്ടിവരും;","poem":1},{"text":"ഒരിക്കൽ നിങ്ങൾ അയാളെ സഹായിച്ചാൽ, നിങ്ങൾക്കത് ആവർത്തിക്കേണ്ടതായിവരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ഉപദേശം ശ്രദ്ധിക്കുകയും ശിക്ഷണം അംഗീകരിക്കുകയും ചെയ്യുക,","poem":1},{"text":"അങ്ങനെ ശിഷ്ടകാലം നിങ്ങൾക്കു ജ്ഞാനിയായി ജീവിക്കാൻ കഴിയും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"മനുഷ്യന്റെ ഹൃദയത്തിൽ നിരവധി പദ്ധതികളുണ്ട്,","poem":1},{"text":"എന്നാൽ യഹോവയുടെ തീരുമാനങ്ങൾമാത്രം നടപ്പിലാകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ഒരു മനുഷ്യനിൽ അഭികാമ്യമായിട്ടുള്ളത് കരുണയാണ്;","poem":1},{"text":"നുണപറയുന്നവരായിരിക്കുന്നതിലും, ദരിദ്രരായിരിക്കുന്നതാണ് നല്ലത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"യഹോവാഭക്തി ജീവനിലേക്കു നയിക്കുന്നു;","poem":1},{"text":"അപ്പോൾ അവർ വിപത്തൊഴിഞ്ഞ് സംതൃപ്തരായി വിശ്രമിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"അലസർ ഭക്ഷണപാത്രത്തിൽ കൈ പൂഴ്ത്തുന്നു;","poem":1},{"text":"അവർ അതു തിരികെ തന്റെ വായിലേക്ക് അടുപ്പിക്കുകപോലുമില്ല!","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ഒരു പരിഹാസിയെ അടിക്കുക, അങ്ങനെ ലളിതമാനസർ വിവേകം അഭ്യസിക്കും;","poem":1},{"text":"വിവേകിയെ ശാസിക്കുക, അവർ പരിജ്ഞാനം നേടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"സ്വപിതാവിനെ കൊള്ളയടിക്കുകയും മാതാവിനെ അടിച്ചോടിക്കുകയും ചെയ്യുന്നവർ","poem":1},{"text":"മാനഹാനിക്ക് ഇരയാകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"എന്റെ കുഞ്ഞേ, എന്റെ ഉപദേശങ്ങൾ ശ്രദ്ധിക്കാതിരുന്നാൽ,","poem":1},{"text":"പരിജ്ഞാനത്തിന്റെ വാക്കുകളിൽനിന്ന് നീ അലഞ്ഞുതിരിയേണ്ടിവരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"അഴിമതിക്കു കൂട്ടുനിൽക്കുന്ന സാക്ഷി നീതിയെ അവഹേളിക്കുന്നു,","poem":1},{"text":"ദുഷ്ടരുടെ വായ് അന്യായത്തെ വിഴുങ്ങുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"പരിഹാസിക്കു ന്യായവിധിയും","poem":1},{"text":"ഭോഷരുടെ മുതുകിനു പ്രഹരവും ഒരുക്കിയിരിക്കുന്നു.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":39,"caller":"+","text":"ഈ വാക്യഭാഗത്തിനുള്ള എബ്രായപദങ്ങളുടെ അർഥം വ്യക്തമല്ല.","reference":{"chapter":19,"verse":7}}]},"thisChapterLink":"/api/mal_bib/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}