{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_bib","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"0779a8d526ec7ab3a8f6f2d92fa1dee6c63a9df2883af973dbb429592e73a01c","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":2,"content":[{"type":"heading","content":["ജ്ഞാനത്തിന്റെ പ്രതിഫലം"]},{"type":"verse","number":1,"content":[{"text":"എന്റെ കുഞ്ഞേ,","poem":1},{"noteId":4},{"text":"നീ എന്റെ വചനങ്ങൾ സ്വീകരിച്ച്","poem":1},{"text":"എന്റെ കൽപ്പനകൾ നിന്റെയുള്ളിൽ സൂക്ഷിച്ചുവെക്കുകയും","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ജ്ഞാനത്തിനുവേണ്ടി നിന്റെ കാതുകൾ തിരിക്കുകയും","poem":1},{"text":"വിവേകത്തിനായി ഹൃദയം ശ്രദ്ധയോടെ വെക്കുകയുംചെയ്യുക.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ഉൾക്കാഴ്ചയ്ക്കുവേണ്ടി കേണപേക്ഷിക്കുകയും","poem":1},{"text":"വിവേകത്തിനായി നിലവിളിക്കുകയും ചെയ്യുക.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അതിനെ നീ വെള്ളി എന്നതുപോലെ അന്വേഷിക്കുകയും","poem":1},{"text":"നിഗൂഢനിധി എന്നതുപോലെ തേടുകയും ചെയ്യുക.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അപ്പോൾ നീ യഹോവയോടുള്ള ഭക്തി എന്തെന്നു ഗ്രഹിക്കുകയും,","poem":1},{"text":"ദൈവത്തെക്കുറിച്ചുള്ള പരിജ്ഞാനം കണ്ടെത്തുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"കാരണം ജ്ഞാനം പ്രദാനംചെയ്യുന്നത് യഹോവയാണ്;","poem":1},{"text":"പരിജ്ഞാനവും വിവേകവും ഉത്ഭവിക്കുന്നത് തിരുവായിൽനിന്നാണ്.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"പരമാർഥികൾക്ക് അവിടന്ന് വിജയം സംഗ്രഹിച്ചുവെക്കുന്നു,","poem":1},{"text":"നിഷ്കളങ്കരായി ജീവിക്കുന്നവർക്ക് അവിടന്ന് ഒരു സംരക്ഷണവലയമാണ്,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"നീതിനിഷ്ഠരുടെ കാലഗതി അവിടന്നു കാത്തുസൂക്ഷിക്കുകയും","poem":1},{"text":"തന്റെ വിശ്വസ്തരെ സംരക്ഷിക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"അങ്ങനെ നീ, നീതിയുക്തവും ന്യായമായതും","poem":1},{"text":"ഔചിത്യമായതുമായ സകലമാർഗവും ഗ്രഹിക്കും.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"കാരണം നിന്റെ ഹൃദയത്തിൽ ജ്ഞാനം ഉദയംചെയ്യും","poem":1},{"text":"പരിജ്ഞാനം നിന്റെ ആത്മാവിന് ഇമ്പമായിരിക്കും.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"വിവേചനശക്തി നിന്നെ സംരക്ഷിക്കും,","poem":1},{"text":"വിവേകം നിന്നെ കാത്തുപരിപാലിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ജ്ഞാനം നിന്നെ ദുഷ്ടമനുഷ്യരുടെ വഴികളിൽനിന്നും","poem":1},{"text":"വഴിപിഴച്ചവരുടെ ഉപദേശത്തിൽനിന്നും രക്ഷിക്കും,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ഇരുളടഞ്ഞ വഴികളിൽ സഞ്ചരിക്കേണ്ടതിന്","poem":1},{"text":"അവർ സത്യത്തിന്റെ മാർഗം വിട്ടുകളയുന്നു,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവർ തിന്മയുടെ വൈകൃതങ്ങളിൽ ആമോദിക്കുകയും","poem":1},{"text":"ദുഷ്ടതയിൽ ആനന്ദിക്കുകയും ചെയ്യുന്നു,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവരുടെ മാർഗം കുടിലതനിറഞ്ഞതാണ്","poem":1},{"text":"അവരുടെ ആസൂത്രണങ്ങൾ വക്രതനിറഞ്ഞതുമാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ജ്ഞാനം നിന്നെ വ്യഭിചാരിണിയിൽനിന്നും","poem":1},{"text":"ലൈംഗികധാർമികതയില്ലാത്തവളുടെ പ്രലോഭനഭാഷണങ്ങളിൽനിന്നും രക്ഷിക്കും,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവൾ തന്റെ യൗവനകാല ഭർത്താവിനെ ഉപേക്ഷിക്കുകയും","poem":1},{"text":"ദൈവമുമ്പാകെയുള്ള അവളുടെ ഉടമ്പടി അവഗണിക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അവളുടെ ഭവനം മരണത്തിലേക്കും","poem":1},{"text":"അവളുടെ വഴികൾ പരേതാത്മാക്കളുടെ സമീപത്തേക്കും നയിക്കുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അവളുടെ സമീപത്തേക്കു പോകുന്ന പുരുഷൻ മടങ്ങിവരുന്നില്ല,","poem":1},{"text":"ജീവനിലേക്ക് ഒരിക്കലും മടങ്ങിയെത്താൻ അവന് കഴിയുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ആയതിനാൽ, നീ സജ്ജനത്തിന്റെ പാതയിൽ നടക്കുകയും","poem":1},{"text":"ധർമിഷ്ഠരുടെ വഴികൾ പിൻതുടരുകയുംവേണം.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"കാരണം പരമാർഥികൾ ദേശത്ത് വസിക്കും","poem":1},{"text":"നിഷ്കളങ്കർ അവിടെ സുസ്ഥിരരായിരിക്കും;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"എന്നാൽ ദുഷ്ടമനുഷ്യർ ദേശത്തുനിന്ന് വിച്ഛേദിക്കപ്പെടും,","poem":1},{"text":"വഞ്ചകർ അവിടെനിന്ന് ഉന്മൂലനംചെയ്യപ്പെടും.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"മൂ.ഭാ. എന്റെ മകനേ","reference":{"chapter":2,"verse":1}}]},"thisChapterLink":"/api/mal_bib/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}