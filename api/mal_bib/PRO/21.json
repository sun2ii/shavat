{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_bib","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"0779a8d526ec7ab3a8f6f2d92fa1dee6c63a9df2883af973dbb429592e73a01c","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"രാജാവിന്റെ ഹൃദയം യഹോവയുടെ കൈയിലെ നീർച്ചാലാണ്;","poem":1},{"text":"തനിക്കിഷ്ടമുള്ള ദിക്കിലേക്ക് അവിടന്ന് അതിനെ തിരിച്ചുവിടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ഓരോ മനുഷ്യരും തങ്ങളുടെ വഴികൾ ശരിയാണ് എന്നു ചിന്തിക്കുന്നു,","poem":1},{"text":"എന്നാൽ യഹോവ ഹൃദയം തൂക്കിനോക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ന്യായവും നീതിയുക്തവുമായ പ്രവർത്തനങ്ങളാണ്","poem":1},{"text":"യഹോവയ്ക്കു യാഗാർപ്പണത്തെക്കാൾ കൂടുതൽ സ്വീകാര്യം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"അഹന്തനിറഞ്ഞ കണ്ണും നിഗളമുള്ള ഹൃദയവും—","poem":1},{"text":"ദുഷ്ടരുടെ ഉഴുതുമറിക്കാത്ത നിലവും—പാപം ഉൽപ്പാദിപ്പിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ഉത്സാഹിയുടെ പദ്ധതികൾ ലാഭത്തിലേക്കു നയിക്കുന്നു,","poem":1},{"text":"ധൃതികാട്ടുന്നത് ദാരിദ്ര്യത്തിലേക്കു നയിക്കും, നിശ്ചയം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"വ്യാജനാവുകൊണ്ട് കെട്ടിപ്പൊക്കിയ സൗഭാഗ്യങ്ങളെല്ലാം","poem":1},{"text":"ക്ഷണികമായ നീരാവിയും മരണക്കെണിയുമാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ദുഷ്ടരുടെ അതിക്രമം അവരെ ദൂരത്തേക്കു വലിച്ചിഴയ്ക്കും,","poem":1},{"text":"കാരണം നീതിനിഷ്ഠമായവ പ്രവർത്തിക്കാൻ അവർക്കു മനസ്സില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"അധർമം പ്രവർത്തിക്കുന്നവരുടെ മാർഗം വക്രതയുള്ളതാണ്,","poem":1},{"text":"എന്നാൽ നിഷ്കളങ്കരുടെ പ്രവർത്തനമോ, നേരുള്ളത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"കലഹക്കാരിയായ ഭാര്യയോടൊത്ത് വീടിനുള്ളിൽ കഴിയുന്നതിനെക്കാൾ","poem":1},{"text":"മേൽപ്പുരയുടെ ഒരു കോണിൽ താമസിക്കുന്നതു നല്ലത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ദുഷ്ടർ തിന്മ പ്രവർത്തിക്കാൻ ആർത്തികാട്ടുന്നു;","poem":1},{"text":"അവരുടെ അയൽവാസിക്ക് അവരിൽനിന്നു യാതൊരുവിധ കരുണയും ലഭിക്കുന്നില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"പരിഹാസി ശിക്ഷിക്കപ്പെടുമ്പോൾ, ലളിതമാനസർ ജ്ഞാനം നേടുന്നു;","poem":1},{"text":"ജ്ഞാനിയെ ഉപദേശിക്കുക, അവർ പരിജ്ഞാനം ആർജിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"നീതിമാനായവൻ","poem":1},{"noteId":42},{"text":"ദുഷ്ടരുടെ ഭവനത്തെ നിരീക്ഷിക്കുകയും","poem":1},{"text":"ദുഷ്ടരെ ദുരന്തത്തിലേക്കു തള്ളിയിടുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ദരിദ്രരുടെ നിലവിളിക്കുനേരേ ചെവിയടച്ചുകളയുന്നവരുടെ","poem":1},{"text":"രോദനത്തിനും ഉത്തരം ലഭിക്കുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"രഹസ്യത്തിൽ കൈമാറുന്ന ദാനം കോപത്തെ ശാന്തമാക്കുന്നു;","poem":1},{"text":"വസ്ത്രത്തിൽ ഒളിപ്പിച്ചുകൊണ്ടുവരുന്ന കോഴ ഉഗ്രകോപത്തെയും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"നീതി നടപ്പിലാക്കുന്നത് നീതിനിഷ്ഠർക്ക് ആനന്ദംനൽകുന്നു,","poem":1},{"text":"എന്നാൽ നീചർക്ക് അതു നടുക്കവും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"വിവേകപാതയിൽനിന്ന് വ്യതിചലിക്കുന്ന മനുഷ്യർ","poem":1},{"text":"മരിച്ചവരുടെ കൂട്ടത്തിൽ വിശ്രമത്തിനായി വന്നുചേരുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"സുഖലോലുപത ഇഷ്ടപ്പെടുന്നവർ ദരിദ്രരായിത്തീരും;","poem":1},{"text":"വീഞ്ഞും സുഗന്ധതൈലവും ഇഷ്ടപ്പെടുന്നവർ ഒരിക്കലും സമ്പന്നരാകുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ദുഷ്ടർ നീതിനിഷ്ഠർക്കു മോചനദ്രവ്യമായിത്തീരും;","poem":1},{"text":"വഞ്ചകർ പരമാർഥിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"കലഹക്കാരിയും മുൻകോപിയുമായ ഭാര്യയോടൊപ്പം ജീവിക്കുന്നതിനെക്കാൾ,","poem":1},{"text":"മരുഭൂമിയിൽ കഴിയുന്നതാണ് ഉത്തമം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ജ്ഞാനിയുടെ ഭവനത്തിൽ വിലയേറിയ നിക്ഷേപവും തൈലവും ഉണ്ട്,","poem":1},{"text":"എന്നാൽ ഭോഷർ തങ്ങൾക്കുള്ളതെല്ലാം വിഴുങ്ങിക്കളയുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"നീതിയും സ്നേഹവും പിൻതുടരുന്നവർ","poem":1},{"text":"ജീവനും നീതിയും","poem":2},{"noteId":43},{"text":"ബഹുമാനവും കണ്ടെത്തും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ജ്ഞാനിക്ക് ശക്തന്മാരുടെ പട്ടണം ആക്രമിക്കാൻ കഴിയും;","poem":1},{"text":"അവരുടെ ആശ്രയമായിരുന്ന കോട്ട ഇടിച്ചുനിരത്താനും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"സ്വന്തം നാവും സ്വന്തം വായും സൂക്ഷിക്കുന്നവർ","poem":1},{"text":"ദുരന്തങ്ങളിൽനിന്നു തന്നെത്താൻ അകന്നുനിൽക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"അഹങ്കാരിയും ധിക്കാരിയുമായ മനുഷ്യൻ—അയാൾക്കു “പരിഹാസി” എന്നു പേര്—","poem":1},{"text":"മഹാഗർവത്തോടെ പെരുമാറുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"അലസരുടെ അഭിലാഷം അവരെ മരണത്തിന് ഏൽപ്പിക്കുന്നു,","poem":1},{"text":"കാരണം അവരുടെ കൈകൾ അധ്വാനം നിരസിക്കുന്നു.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ദിവസംമുഴുവനും അയാൾ അത്യാർത്തിയോടെ കഴിയുന്നു.","poem":1},{"text":"എന്നാൽ നീതിനിഷ്ഠരോ, ഒന്നും പിടിച്ചുവെക്കാതെ ദാനംചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ദുഷ്ടരുടെ യാഗാർപ്പണം നിന്ദ്യമാണ്—","poem":1},{"text":"ദുഷ്ടലാക്കോടെയാണ് കൊണ്ടുവരുന്നതെങ്കിൽ എത്രയധികം!","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"കള്ളസാക്ഷി നശിച്ചുപോകും,","poem":1},{"text":"എന്നാൽ ശ്രദ്ധയോടെ കേൾക്കുന്നവരുടെ വാക്കുകൾ നിരന്തരം ശ്രദ്ധിക്കപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ദുഷ്ടർ തങ്ങളുടെ മുഖത്ത് ധൈര്യം പ്രകടമാക്കുന്നു,","poem":1},{"text":"എന്നാൽ നീതിനിഷ്ഠർ തങ്ങളുടെ വഴികൾ ആലോചിച്ചുറപ്പിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"യഹോവയ്ക്കെതിരേ നിൽക്കാൻ കഴിയുന്ന","poem":1},{"text":"യാതൊരുവിധ ജ്ഞാനമോ ഉൾക്കാഴ്ചയോ പദ്ധതികളോ ഇല്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"യുദ്ധദിവസത്തിനായി കുതിരയെ സജ്ജമാക്കി നിർത്തുന്നു,","poem":1},{"text":"എന്നാൽ വിജയത്തിന്റെ അടിസ്ഥാനം യഹോവയാകുന്നു.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":42,"caller":"+","text":"നീതിമാനായവൻ, വിവക്ഷിക്കുന്നത് നീതിനിഷ്ഠൻ അഥവാ, ദൈവം.","reference":{"chapter":21,"verse":12}},{"noteId":43,"caller":"+","text":"അഥവാ, അഭിവൃദ്ധിയും","reference":{"chapter":21,"verse":21}}]},"thisChapterLink":"/api/mal_bib/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}