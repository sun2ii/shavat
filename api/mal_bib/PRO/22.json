{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_bib","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"0779a8d526ec7ab3a8f6f2d92fa1dee6c63a9df2883af973dbb429592e73a01c","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"സൽപ്പേര് അനവധി സമ്പത്തിനെക്കാൾ അഭികാമ്യം;","poem":1},{"text":"ആദരണീയരാകുന്നത് വെള്ളിയെക്കാളും സ്വർണത്തെക്കാളും ശ്രേഷ്ഠം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"സമ്പന്നർക്കും ദരിദ്രർക്കും പൊതുവായി ഇതൊന്നുമാത്രം:","poem":1},{"text":"അവർ ഇരുവരെയും യഹോവ സൃഷ്ടിച്ചു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ഒരു വിവേകി ആപത്തിനെ മുൻകണ്ട് അഭയസ്ഥാനം തേടുന്നു;","poem":1},{"text":"എന്നാൽ ലളിതമാനസർ മുമ്പോട്ടുതന്നെപോയി ദുരന്തം വരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"വിനയമാണ് യഹോവാഭക്തി, അതിന്റെ അനന്തരഫലമോ","poem":1},{"text":"ധനം, ബഹുമതി, ദീർഘായുസ്സ് എന്നിവയും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ദുഷ്ടരുടെ പാതയിൽ മുള്ളുകളും കെണിയുമുണ്ട്,","poem":1},{"text":"എന്നാൽ സ്വന്തം ജീവനു വിലകൽപ്പിക്കുന്നവർ അവയിൽനിന്നെല്ലാം അകന്നുനിൽക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"കുട്ടികളെ അവർ നടക്കേണ്ടതായ വഴി പരിശീലിപ്പിക്കുക,","poem":1},{"text":"വൃദ്ധരായാലും അവർ അതിൽനിന്നു വ്യതിചലിക്കുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ധനികർ ദരിദ്രർക്കുമേൽ ആധിപത്യംനടത്തുന്നു,","poem":1},{"text":"വായ്പവാങ്ങുന്നവർ വായ്പകൊടുക്കുന്നവരുടെ ദാസരുമാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ദുഷ്ടത വിതയ്ക്കുന്നവർ നാശം കൊയ്യും,","poem":1},{"text":"അവരുടെ ഭീകരവാഴ്ച","poem":2},{"noteId":44},{"text":"അവസാനിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ഉദാരമനസ്കരായവർ അനുഗൃഹീതർ,","poem":1},{"text":"കാരണം അവർ തങ്ങളുടെ ഭക്ഷണം ദരിദ്രരുമായി പങ്കിടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"പരിഹാസിയെ ആട്ടിയോടിക്കുക, അതോടുകൂടി ശണ്ഠ ഒഴിഞ്ഞുപോകും;","poem":1},{"text":"കലഹവും അധിക്ഷേപവും അവസാനിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ഹൃദയശുദ്ധി ഇഷ്ടപ്പെടുകയും മാന്യമായി സംസാരിക്കുകയും ചെയ്യുന്നവർക്ക്","poem":1},{"text":"രാജാവ് സ്നേഹിതനായിത്തീരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"പരിജ്ഞാനത്തിനുമേൽ യഹോവയുടെ ദൃഷ്ടി കാവലിനുണ്ട്,","poem":1},{"text":"വഞ്ചകരുടെ വാക്കുകൾ അവിടന്നു തകിടംമറിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"അലസർ ഇപ്രകാരം പറയുന്നു, “വെളിയിൽ ഒരു സിംഹമുണ്ട്!","poem":1},{"text":"ചത്വരങ്ങളിൽവെച്ച് ഞാൻ വധിക്കപ്പെടും!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"വ്യഭിചാരിണിയുടെ വായ് അപകടംനിറഞ്ഞ കെണിയാണ്;","poem":1},{"noteId":45},{"text":"യഹോവയുടെ കോപത്തിനിരയായവർ അതിൽ വീഴുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"മടയത്തരം യുവാക്കളുടെ ഹൃദയത്തിൽ കെട്ടുപിണഞ്ഞുകിടക്കുന്നു,","poem":1},{"text":"എന്നാൽ ശിക്ഷണത്തിന്റെ വടി അതിനെ ആട്ടിപ്പായിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"സ്വന്തം സമ്പത്തു വർധിപ്പിക്കുന്നതിന് ദരിദ്രരെ പീഡിപ്പിക്കുന്നവരും","poem":1},{"text":"ധനികർക്കു ദാനംചെയ്യുന്നവരും ഒരുപോലെ ദരിദ്രരായിത്തീരും.","poem":2}]},{"type":"heading","content":["ഒന്നാംസൂക്തം"]},{"type":"verse","number":17,"content":[{"text":"ജ്ഞാനിയുടെ സൂക്തങ്ങൾ സശ്രദ്ധം കേൾക്കുക;","poem":1},{"text":"ഞാൻ ഉപദേശിക്കുന്നതിന് ഹൃദയം നൽകുക,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"കാരണം അവ നിന്റെ ഹൃദയത്തിൽ സൂക്ഷിക്കുന്നതും","poem":1},{"text":"അധരങ്ങളിൽ ഒരുക്കിനിർത്തുന്നതും ആനന്ദകരം.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"നിന്റെ ആശ്രയം യഹോവയിൽ ആയിരിക്കേണ്ടതിന്,","poem":1},{"text":"ഞാൻ ഇന്നു നിന്നോട്, നിന്നോടുതന്നെ ഉപദേശിക്കുന്നു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ഞാൻ നിനക്കായി മുപ്പതു സൂക്തങ്ങൾ എഴുതിയിട്ടുണ്ട്,","poem":1},{"text":"ഉപദേശത്തിന്റെയും പരിജ്ഞാനത്തിന്റെയും സൂക്തങ്ങൾതന്നെ,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"നീ സത്യസന്ധനായി, സത്യംമാത്രം സംസാരിക്കുന്നവൻ ആയിത്തീർന്ന്","poem":1},{"text":"നീ സേവിക്കുന്നവർക്ക് സത്യസന്ധമായ മറുപടിനൽകേണ്ടതിനാണ്","poem":2},{"lineBreak":true},{"text":"ഞാൻ ഈ സൂക്തങ്ങൾ നിനക്ക് എഴുതിയിട്ടുള്ളത്.","poem":2}]},{"type":"heading","content":["രണ്ടാംസൂക്തം"]},{"type":"verse","number":22,"content":[{"text":"ദരിദ്രർ നിസ്സഹായരായതിനാൽ അവരെ ചൂഷണംചെയ്യരുത്","poem":1},{"text":"നിർധനരെ കോടതികയറ്റി തകർത്തുകളയരുത്,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"കാരണം അവരുടെ വ്യവഹാരം യഹോവ ഏറ്റെടുക്കുകയും","poem":1},{"text":"അവരെ നശിപ്പിക്കുന്നവരെ നശിപ്പിക്കുകയുംതന്നെചെയ്യും.","poem":2}]},{"type":"heading","content":["മൂന്നാംസൂക്തം"]},{"type":"verse","number":24,"content":[{"text":"ക്ഷിപ്രകോപിയായ ഒരാളോട് സഖിത്വം അരുത്,","poem":1},{"text":"പെട്ടെന്നു പ്രകോപിതരാകുന്നവരോട് അടുത്ത സൗഹൃദം സ്ഥാപിക്കുകയുമരുത്.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"അല്ലെങ്കിൽ നിങ്ങൾ അവരുടെ രീതികൾ അനുശീലിക്കുകയും","poem":1},{"text":"നിങ്ങളെത്തന്നെ കെണിയിൽ വീഴ്ത്തുകയും ചെയ്യും.","poem":2}]},{"type":"heading","content":["നാലാംസൂക്തം"]},{"type":"verse","number":26,"content":[{"text":"മറ്റൊരാൾക്കുവേണ്ടി ജാമ്യം നിൽക്കുകയോ","poem":1},{"text":"അന്യർക്കുവേണ്ടി കൈയൊപ്പുചാർത്തുകയോ ചെയ്യരുത്;","poem":2}]},{"type":"verse","number":27,"content":[{"text":"അത് അടച്ചുതീർക്കാൻ കഴിയാതെവന്നിട്ട്,","poem":1},{"text":"നിങ്ങളുടെ കിടക്കപോലും നിങ്ങൾക്കടിയിൽനിന്നു വലിച്ചുമാറ്റപ്പെടും.","poem":2}]},{"type":"heading","content":["അഞ്ചാംസൂക്തം"]},{"type":"verse","number":28,"content":[{"text":"നിങ്ങളുടെ പൂർവികർ സ്ഥാപിച്ചിരിക്കുന്ന","poem":1},{"text":"പുരാതനമായ അതിർത്തിക്കല്ലു മാറ്റരുത്.","poem":2}]},{"type":"heading","content":["ആറാംസൂക്തം"]},{"type":"verse","number":29,"content":[{"text":"തന്റെ തൊഴിലിൽ വൈദഗ്ദ്ധ്യമുള്ള ഒരാളിനെ നിങ്ങൾ കാണുന്നില്ലേ?","poem":1},{"text":"അവർ രാജാക്കന്മാരെ സേവിക്കും","poem":2},{"lineBreak":true},{"text":"കീഴുദ്യോഗസ്ഥന്മാർക്കുവേണ്ടി അവർ സേവനം അനുഷ്ഠിക്കുകയില്ലാതാനും.","poem":2}]}],"footnotes":[{"noteId":44,"caller":"+","text":"മൂ.ഭാ. കോപത്തിന്റെ ദണ്ഡ്","reference":{"chapter":22,"verse":8}},{"noteId":45,"caller":"+","text":"മൂ.ഭാ. ആഴമുള്ള കുഴി","reference":{"chapter":22,"verse":14}}]},"thisChapterLink":"/api/mal_bib/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}