{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_bib","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"0779a8d526ec7ab3a8f6f2d92fa1dee6c63a9df2883af973dbb429592e73a01c","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":23,"content":[{"type":"heading","content":["ഏഴാംസൂക്തം"]},{"type":"verse","number":1,"content":[{"text":"ഭരണാധികാരിക്കൊത്ത് ഭക്ഷണം കഴിക്കുമ്പോൾ,","poem":1},{"text":"നിങ്ങളുടെമുമ്പിൽ എന്താണ് ഉള്ളതെന്ന് സസൂക്ഷ്മം നിരീക്ഷിക്കുക,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"നിങ്ങൾ അമിതഭക്ഷണം കഴിക്കുന്നവരാണെങ്കിൽ","poem":1},{"text":"നിങ്ങളുടെ തൊണ്ടയിൽ ഒരു കത്തിവെക്കുക.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവരുടെ ആസ്വാദ്യകരമായ ഭക്ഷണത്തോട് അതിമോഹം അരുത്,","poem":1},{"text":"കാരണം ആ ഭക്ഷണം വഞ്ചനാപരമാണ്.","poem":2}]},{"type":"heading","content":["എട്ടാംസൂക്തം"]},{"type":"verse","number":4,"content":[{"text":"സമ്പന്നരാകുന്നതിനായി അത്യധ്വാനംചെയ്ത് നിങ്ങളെത്തന്നെ തളർത്തരുത്;","poem":1},{"text":"തക്കസമയത്ത് അതിൽനിന്നു പിൻവാങ്ങുന്നതിനുള്ള ബുദ്ധി നിങ്ങൾക്കുണ്ടായിരിക്കണം.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ഒറ്റനോട്ടത്തിനിടയിൽത്തന്നെ, ധനം പൊയ്പ്പോയിരിക്കും,","poem":1},{"text":"അതിനു നിശ്ചയമായും ചിറകു മുളയ്ക്കുകയും","poem":2},{"lineBreak":true},{"text":"ഒരു കഴുകനെപ്പോൽ ആകാശത്തേക്കു പറന്നകലുകയും ചെയ്യും.","poem":2}]},{"type":"heading","content":["ഒൻപതാംസൂക്തം"]},{"type":"verse","number":6,"content":[{"text":"അറുപിശുക്കുള്ള വ്യക്തികളുടെ ആഹാരം ആസ്വദിക്കരുത്,","poem":1},{"text":"അവരുടെ വിശിഷ്ടഭോജ്യം ആഗ്രഹിക്കുരുത്;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"കാരണം അവരെപ്പോഴും","poem":1},{"text":"അതിനെത്ര വിലയാകും എന്നു ചിന്തിക്കുന്നവരാണ്.","poem":2},{"text":"“ഭക്ഷിക്കുക, പാനംചെയ്യുക,” എന്ന് അവർ നിങ്ങളോടു പറയും,","poem":1},{"text":"എന്നാൽ അവരത് മനസ്സോടെ പറയുന്നതല്ല.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ആസ്വദിച്ച അൽപ്പഭക്ഷണം നിങ്ങൾ ഛർദിച്ചുകളയും","poem":1},{"text":"നിങ്ങളുടെ ഉപചാരവാക്കുകൾ പാഴാകുകയും ചെയ്യും.","poem":2}]},{"type":"heading","content":["പത്താംസൂക്തം"]},{"type":"verse","number":9,"content":[{"text":"ഭോഷർ കേൾക്കെ നിങ്ങൾ സംസാരിക്കരുത്,","poem":1},{"text":"കാരണം നിങ്ങളുടെ വിവേകമുള്ള വാക്കുകൾ അവർ നിന്ദിക്കും.","poem":2}]},{"type":"heading","content":["പതിനൊന്നാംസൂക്തം"]},{"type":"verse","number":10,"content":[{"text":"പുരാതനമായ അതിർത്തിക്കല്ലു മാറ്റുകയോ","poem":1},{"text":"അനാഥരുടെ പുരയിടം കൈയ്യേറുകയോ ചെയ്യരുത്,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"കാരണം അവരുടെ സംരക്ഷകൻ ശക്തനാണ്;","poem":1},{"text":"അവിടന്ന് നിനക്കെതിരായി അവരുടെ വ്യവഹാരം നടത്തും.","poem":2}]},{"type":"heading","content":["പന്ത്രണ്ടാംസൂക്തം"]},{"type":"verse","number":12,"content":[{"text":"നിങ്ങളുടെ ഹൃദയം ശിക്ഷണത്തിന് ഏൽപ്പിച്ചുകൊടുക്കുകയും","poem":1},{"text":"കാതുകൾ പരിജ്ഞാനവചസ്സുകൾക്കായി തുറക്കുകയും ചെയ്യുക.","poem":2}]},{"type":"heading","content":["പതിമ്മൂന്നാംസൂക്തം"]},{"type":"verse","number":13,"content":[{"text":"മക്കൾക്കു ശിക്ഷണം നൽകാതിരിക്കരുത്;","poem":1},{"text":"വടികൊണ്ട് നീ അവരെ അടിച്ചാൽ, അവർ മരിച്ചുപോകുകയില്ല.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവരെ വടികൊണ്ട് ശിക്ഷിക്കുക,","poem":1},{"text":"അങ്ങനെ മരണത്തിൽനിന്ന് അവരുടെ ജീവൻ രക്ഷിക്കുക.","poem":2}]},{"type":"heading","content":["പതിനാലാംസൂക്തം"]},{"type":"verse","number":15,"content":[{"text":"എന്റെ കുഞ്ഞേ,","poem":1},{"noteId":46},{"text":"നിന്റെ ഹൃദയം ജ്ഞാനമുള്ളതെങ്കിൽ,","poem":1},{"text":"എന്റെ ഹൃദയം ആനന്ദഭരിതം ആയിരിക്കും;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"നിന്റെ അധരം സത്യം സംസാരിക്കുമ്പോൾ","poem":1},{"text":"എന്റെ അന്തരിന്ദ്രിയം ആനന്ദിക്കും.","poem":2}]},{"type":"heading","content":["പതിനഞ്ചാംസൂക്തം"]},{"type":"verse","number":17,"content":[{"text":"നിന്റെ ഹൃദയം പാപികളെക്കുറിച്ച് അസൂയപ്പെടരുത്,","poem":1},{"text":"എന്നാൽ യഹോവയോടുള്ള ഭക്തിയിൽ അത്യുത്സാഹിയായിരിക്കുക.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"നിനക്ക് ഭാവിയെക്കുറിച്ച് ഒരു പ്രത്യാശയുണ്ട്, നിശ്ചയം,","poem":1},{"text":"നിന്റെ പ്രത്യാശ അറ്റുപോകുകയില്ല.","poem":2}]},{"type":"heading","content":["പതിനാറാംസൂക്തം"]},{"type":"verse","number":19,"content":[{"text":"എന്റെ കുഞ്ഞേ, ശ്രദ്ധിക്കുക, ജ്ഞാനിയായിരിക്കുക,","poem":1},{"text":"നിന്റെ ഹൃദയം നേരായ പാതയിൽ ഉറപ്പിച്ചുനിർത്തുക:","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അമിതമായി മദ്യം കുടിക്കുന്നവരുടെയോ","poem":1},{"text":"മാംസഭക്ഷണത്തിൽ അമിതാസക്തി കാട്ടുന്നവരുടെയോ സംഘത്തിൽ ചേരരുത്,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"കാരണം മദ്യപരും അമിതഭക്ഷണപ്രിയരും ദരിദ്രരായിത്തീരും;","poem":1},{"text":"മദോന്മത്തത അവരെ കീറത്തുണിയുടുപ്പിക്കും.","poem":2}]},{"type":"heading","content":["പതിനേഴാംസൂക്തം"]},{"type":"verse","number":22,"content":[{"text":"നിനക്കു ജന്മംനൽകിയ നിന്റെ പിതാവിന്റെ വാക്കുകൾ ശ്രദ്ധിക്കുക,","poem":1},{"text":"നിന്റെ മാതാവ് വാർധക്യത്തിലെത്തുമ്പോൾ അവരെ നിന്ദിക്കരുത്.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"സത്യം കരസ്ഥമാക്കുക, അതിനെ വിൽക്കരുത്;","poem":1},{"text":"ജ്ഞാനവും ശിക്ഷണവും തിരിച്ചറിവും സ്വായത്തമാക്കുക.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"നീതിനിഷ്ഠരുടെ പിതാവിന് അത്യധികം സന്തോഷമുണ്ട്;","poem":1},{"text":"ജ്ഞാനിയായ ഒരു കുഞ്ഞിനു ജന്മം നൽകുന്ന പിതാവ് ആ കുഞ്ഞിൽ ആനന്ദിക്കും.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"നിന്റെ മാതാപിതാക്കൾ സന്തുഷ്ടരായിരിക്കട്ടെ;","poem":1},{"text":"നിന്നെ പ്രസവിച്ച നിന്റെ മാതാവ് ആനന്ദിക്കട്ടെ.","poem":2}]},{"type":"heading","content":["പതിനെട്ടാംസൂക്തം"]},{"type":"verse","number":26,"content":[{"text":"എന്റെ കുഞ്ഞേ, നിന്റെ ഹൃദയം എനിക്കു തരിക","poem":1},{"text":"നിന്റെ കണ്ണുകൾ എന്റെ വഴികൾ പിൻതുടരുന്നതിൽ ആനന്ദിക്കട്ടെ,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"വ്യഭിചാരിണിയായ സ്ത്രീ അപകടംനിറഞ്ഞ കെണിയാണ്;","poem":1},{"noteId":47},{"text":"ലൈംഗികധാർമികതയില്ലാത്ത ഭാര്യ ഒരു ചതിക്കുഴിയാണ്.","poem":2},{"noteId":48}]},{"type":"verse","number":28,"content":[{"text":"കൊള്ളക്കാരെപ്പോലെ അവൾ പതിയിരിക്കുന്നു","poem":1},{"text":"പുരുഷഗണത്തിലെ അവിശ്വസ്തരുടെ എണ്ണം അവൾ വർധിപ്പിക്കുന്നു.","poem":2}]},{"type":"heading","content":["പത്തൊൻപതാംസൂക്തം"]},{"type":"verse","number":29,"content":[{"text":"ആർക്കാണ് കഷ്ടം? ആർക്കാണ് സങ്കടം?","poem":1},{"text":"ആർക്കാണ് സംഘട്ടനം? ആർക്കാണ് ആവലാതി?","poem":2},{"lineBreak":true},{"text":"ആർക്കാണ് അനാവശ്യ മുറിവുകൾ? ആരുടെ കണ്ണുകളാണ് ചെമന്നുകലങ്ങിയിരിക്കുന്നത്?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"മദ്യലഹരിയിൽ ദീർഘനേരം ആറാടുകയും","poem":1},{"text":"വിവിധതരം മദ്യം രുചിച്ചുനോക്കാൻ ശ്രമിക്കുകയും ചെയ്യുന്നവരുടേതുതന്നെ.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"വീഞ്ഞു ചെമന്നിരിക്കുമ്പോഴും","poem":1},{"text":"ചഷകങ്ങളിൽ നുരഞ്ഞുപൊന്തുമ്പോഴും","poem":2},{"lineBreak":true},{"text":"അത് ഒരാൾ ആസ്വദിച്ചു കുടിക്കുമ്പോഴും നിങ്ങളതിൽ മിഴിയുറപ്പിക്കരുത്.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ഒടുവിൽ അതു സർപ്പത്തെപ്പോലെ കൊത്തും","poem":1},{"text":"അണലിപോലെ വിഷമേൽപ്പിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"നിങ്ങളുടെ കണ്ണുകൾ വിചിത്രകാഴ്ചകൾ കാണും,","poem":1},{"text":"നിങ്ങളുടെ മനസ്സ് മതിമയക്കുന്ന കാര്യങ്ങൾ സങ്കൽപ്പിക്കും.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"നിങ്ങൾ നടുക്കടലിൽ കിടന്നുറങ്ങുന്നവരെപ്പോലെയും","poem":1},{"text":"കപ്പൽപ്പായ്മരത്തിൻമുകളിൽ തൂങ്ങിനിൽക്കുന്നവരെപ്പോലെയും ആകും.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"“അവരെന്നെ ഇടിച്ചു; പക്ഷേ, എനിക്കു വേദനിച്ചില്ല!","poem":1},{"text":"അവരെന്നെ അടിച്ചു; പക്ഷേ, ഞാൻ അറിഞ്ഞതേയില്ല!","poem":2},{"text":"ഇനി ഞാൻ എപ്പോഴാണ് ഉണരുക","poem":1},{"text":"അപ്പോൾ എനിക്ക് ഒരു പ്രാവശ്യംകൂടി കുടിക്കാമല്ലോ,” എന്നിങ്ങനെ നീ പറയും.","poem":2}]}],"footnotes":[{"noteId":46,"caller":"+","text":"മൂ.ഭാ. എന്റെ മകനേ; വാ. 19 കാണുക.","reference":{"chapter":23,"verse":15}},{"noteId":47,"caller":"+","text":"മൂ.ഭാ. ആഴമുള്ള കുഴി","reference":{"chapter":23,"verse":27}},{"noteId":48,"caller":"+","text":"മൂ.ഭാ. ഇടുങ്ങിയ കിണർ","reference":{"chapter":23,"verse":27}}]},"thisChapterLink":"/api/mal_bib/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}