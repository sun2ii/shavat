{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_bib","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"0779a8d526ec7ab3a8f6f2d92fa1dee6c63a9df2883af973dbb429592e73a01c","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":24,"content":[{"type":"heading","content":["ഇരുപതാംസൂക്തം"]},{"type":"verse","number":1,"content":[{"text":"ദുഷ്ടരോടു നീ അസൂയപ്പെടരുത്,","poem":1},{"text":"അവരുമായുള്ള കൂട്ടുകെട്ട് നീ അഭിലഷിക്കുകയുമരുത്;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"കാരണം അവരുടെ ഹൃദയം അതിക്രമത്തിനു കളമൊരുക്കുന്നു,","poem":1},{"text":"അവരുടെ അധരങ്ങൾ സംഘർഷം സൃഷ്ടിക്കുന്നതിനെപ്പറ്റി സംസാരിക്കുന്നു.","poem":2}]},{"type":"heading","content":["ഇരുപത്തിയൊന്നാംസൂക്തം"]},{"type":"verse","number":3,"content":[{"text":"ജ്ഞാനത്താൽ ഒരു ഭവനം നിർമിക്കപ്പെടുന്നു,","poem":1},{"text":"വിവേകത്തിലൂടെ അതു സ്ഥിരപ്പെടുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അതിന്റെ മുറികൾ പരിജ്ഞാനത്താൽ നിറയ്ക്കപ്പെടുന്നു;","poem":1},{"text":"അമൂല്യവും രമണീയവുമായ നിക്ഷേപങ്ങൾകൊണ്ടുതന്നെ.","poem":2}]},{"type":"heading","content":["ഇരുപത്തിരണ്ടാംസൂക്തം"]},{"type":"verse","number":5,"content":[{"text":"ജ്ഞാനിക്ക് ബലമുള്ളവരെക്കാൾ ശക്തിയുണ്ട്,","poem":1},{"text":"പരിജ്ഞാനി ശക്തിക്കുമേൽ ശക്തിനേടുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"യുദ്ധത്തിൽ മുന്നേറാൻ മാർഗനിർദേശങ്ങൾ ആവശ്യമാണ്,","poem":1},{"text":"എന്നാൽ ഉപദേഷ്ടാക്കളുടെ ബാഹുല്യം വിജയം ഉറപ്പിക്കുന്നു.","poem":2}]},{"type":"heading","content":["ഇരുപത്തിമൂന്നാംസൂക്തം"]},{"type":"verse","number":7,"content":[{"text":"ജ്ഞാനം ഭോഷർക്ക് അപ്രാപ്യം;","poem":1},{"text":"പട്ടണകവാടത്തിൽ സമ്മേളിക്കുമ്പോൾ അവർക്ക് പ്രതിവാദം ഇല്ലാതെയാകുന്നു.","poem":2}]},{"type":"heading","content":["ഇരുപത്തിനാലാംസൂക്തം"]},{"type":"verse","number":8,"content":[{"text":"ദുഷ്കൃത്യങ്ങൾ ആസൂത്രണംചെയ്യുന്നവർ","poem":1},{"text":"ഗൂഢാലോചനയിൽ വിദഗ്ദ്ധർ എന്നു വിളിക്കപ്പെടും.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഭോഷത്തം ആസൂത്രണംചെയ്യുന്നത് പാപം,","poem":1},{"text":"പരിഹാസിയെ ജനം വെറുക്കുന്നു.","poem":2}]},{"type":"heading","content":["ഇരുപത്തിയഞ്ചാംസൂക്തം"]},{"type":"verse","number":10,"content":[{"text":"ആപത്ഘട്ടത്തിൽ നിങ്ങൾ ഇടറിപ്പോകുന്നെങ്കിൽ,","poem":1},{"text":"നിങ്ങളുടെ ശക്തി എത്രയോ പരിമിതം!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അന്യായമായി മരണത്തിലേക്കു നയിക്കപ്പെടുന്നവരെ വിടുവിക്കുക;","poem":1},{"text":"കൊലക്കളത്തിലേക്ക് ഇടറിയിടറി നീങ്ങുന്നവരെ രക്ഷിക്കുക.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“ഞങ്ങൾ ഇതേപ്പറ്റി യാതൊന്നും അറിഞ്ഞിരുന്നില്ല,” എന്നു നീ പറഞ്ഞാൽ,","poem":1},{"text":"ഹൃദയത്തെ തൂക്കിനോക്കുന്നവൻ അതു മനസ്സിലാക്കാതിരിക്കുമോ?","poem":2},{"text":"നിന്റെ ജീവൻ സംരക്ഷിക്കുന്ന അവിടത്തേക്ക് ഇത് അറിയാതിരിക്കുമോ?","poem":1},{"text":"അവിടന്ന് ഓരോരുത്തർക്കും അവരുടെ പ്രവൃത്തികൾക്കനുസരിച്ച് പകരം ചെയ്യാതിരിക്കുമോ?","poem":2}]},{"type":"heading","content":["ഇരുപത്തിയാറാംസൂക്തം"]},{"type":"verse","number":13,"content":[{"text":"എന്റെ കുഞ്ഞേ,","poem":1},{"noteId":49},{"text":"തേൻ കഴിക്കുക, അതു നല്ലതാണ്;","poem":1},{"text":"തേനടയിലെ തേൻ നിന്റെ നാവിന് ആസ്വാദ്യമാണ്.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അതുപോലെതന്നെ, ജ്ഞാനം നിനക്ക് തേൻപോലെയെന്ന് അറിയുക:","poem":1},{"text":"അതു നീ കണ്ടെത്തിയാൽ, നിനക്കു ശോഭനമായൊരു ഭാവിയുണ്ട്,","poem":2},{"lineBreak":true},{"text":"നിന്റെ പ്രത്യാശ അറ്റുപോകുകയില്ല.","poem":2}]},{"type":"heading","content":["ഇരുപത്തിയേഴാംസൂക്തം"]},{"type":"verse","number":15,"content":[{"text":"നീതിനിഷ്ഠരുടെ ഭവനത്തിനെതിരേ ദുഷ്ടരെപ്പോലെ പതിയിരിക്കരുത്,","poem":1},{"text":"അവരുടെ പാർപ്പിടം കൊള്ളയിടുകയുമരുത്;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"കാരണം നീതിനിഷ്ഠർ ഏഴുവട്ടം വീണാലും അവർ എഴുന്നേൽക്കുകതന്നെചെയ്യും,","poem":1},{"text":"എന്നാൽ ദുരന്തമുണ്ടാകുമ്പോൾ ദുഷ്ടർ നിലംപരിശാകുന്നു.","poem":2}]},{"type":"heading","content":["ഇരുപത്തിയെട്ടാംസൂക്തം"]},{"type":"verse","number":17,"content":[{"text":"നിങ്ങളുടെ ശത്രുവിന്റെ പതനത്തിൽ ആനന്ദിക്കരുത്;","poem":1},{"text":"അവരുടെ കാലിടറുമ്പോൾ നിന്റെ ഹൃദയം സന്തോഷിക്കുകയുമരുത്,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അങ്ങനെയായാൽ, യഹോവ അതുകണ്ട് അതൃപ്തനാകുകയും","poem":1},{"text":"അവിടത്തെ കോപം ശത്രുവിൽനിന്നു പിൻവലിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"heading","content":["ഇരുപത്തിഒൻപതാംസൂക്തം"]},{"type":"verse","number":19,"content":[{"text":"ദുഷ്ടർനിമിത്തം ക്ഷോഭിക്കുകയോ","poem":1},{"text":"നീചരായവരോട് അസൂയപ്പെടുകയോ അരുത്,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"കാരണം നീചർക്കു ഭാവിപ്രതീക്ഷയില്ല,","poem":1},{"text":"ദുഷ്ടരുടെ വിളക്ക് ഊതിയണയ്ക്കപ്പെടുകയും ചെയ്യും.","poem":2}]},{"type":"heading","content":["മുപ്പതാംസൂക്തം"]},{"type":"verse","number":21,"content":[{"text":"എന്റെ കുഞ്ഞേ, യഹോവയെയും രാജാവിനെയും ഭയപ്പെടുക,","poem":1},{"text":"മത്സരികളുടെ സംഘത്തിൽ ചേരുകയുമരുത്,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"കാരണം അവരിരുവരും മത്സരികൾക്കുനേരേ ശീഘ്രനാശം അയയ്ക്കും,","poem":1},{"text":"അവർ എന്തൊക്കെ ദുരിതങ്ങളാണ് അഴിച്ചുവിടുന്നതെന്ന് ആർക്കറിയാം?","poem":2}]},{"type":"verse","number":23,"content":["ഇവയും ജ്ഞാനിയുടെ സൂക്തങ്ങൾതന്നെയാണ്:",{"text":"വിധിനിർണയത്തിൽ പക്ഷഭേദം ഉചിതമല്ല:","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ഒരു കുറ്റവാളിയോട്, “താങ്കൾ നിരപരാധിയാണ്,” എന്നു പറയുന്നവരെ","poem":1},{"text":"പൊതുജനം ശപിക്കുകയും ജനതകൾ വെറുക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"എന്നാൽ കുറ്റവാളിയെ ശിക്ഷിക്കുന്നവർക്ക് നന്മ കൈവരും,","poem":1},{"text":"അനവധി അനുഗ്രഹങ്ങൾ വന്നുചേരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"സത്യസന്ധമായ ഉത്തരം","poem":1},{"text":"യഥാർഥ സൗഹൃദത്തിന്റെ ചിഹ്നമാണ്.","poem":2},{"noteId":50}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"വെളിയിൽ നിന്റെ വേല ക്രമീകരിക്കുക","poem":1},{"text":"നിന്റെ പുരയിടം ഒരുക്കുക;","poem":2},{"lineBreak":true},{"text":"അതിനുശേഷം നിന്റെ ഗൃഹനിർമിതി തുടങ്ങുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"മതിയായ കാരണമില്ലാതെ നിന്റെ അയൽവാസിക്കെതിരേ മൊഴിനൽകരുത്—","poem":1},{"text":"നിന്റെ അധരങ്ങൾകൊണ്ട് അവരെ വഞ്ചിക്കരുത്.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“അവർ എന്നോടു ചെയ്തതുപോലെതന്നെ ഞാൻ അവരോടുംചെയ്യും;","poem":1},{"text":"അവർ ചെയ്തതിനൊക്കെ ഞാൻ അവരോടു പകരംവീട്ടും,” എന്നു പറയരുത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"ഞാൻ അലസരുടെ കൃഷിയിടത്തിനരികിലൂടെയും","poem":1},{"text":"ബുദ്ധിഹീനരുടെ മുന്തിരിത്തോപ്പിനരികിലൂടെയും നടന്നുപോയി;","poem":2}]},{"type":"verse","number":31,"content":[{"text":"അവിടെയെല്ലാം മുൾച്ചെടികൾ പടർന്നുപിടിച്ചിരിക്കുന്നു,","poem":1},{"text":"നിലമെല്ലാം കളകൾ മൂടിയിരിക്കുന്നു,","poem":2},{"lineBreak":true},{"text":"അതിലെ മതിലുകൾ ഇടിഞ്ഞുപോയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ഞാൻ നിരീക്ഷിച്ചവ വിചിന്തനത്തിനു വിധേയമാക്കി,","poem":1},{"text":"ഞാൻ കണ്ടതിൽനിന്നും ഒരു പാഠം പഠിച്ചു:","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ഒരൽപ്പം ഉറക്കം, ഒരൽപ്പം മയക്കം,","poem":1},{"text":"ഒരൽപ്പനേരംകൂടി കൈകൾ കെട്ടിപ്പിണച്ചുള്ള വിശ്രമം;","poem":2}]},{"type":"verse","number":34,"content":[{"text":"അങ്ങനെ ദാരിദ്ര്യം കൊള്ളക്കാരെപ്പോലെ നിന്റെമേൽ ചാടിവീഴും","poem":1},{"text":"ദുർഭിക്ഷത ഒരു ആയുധപാണിയെപ്പോലെ നിന്നെ ആക്രമിക്കും.","poem":2}]}],"footnotes":[{"noteId":49,"caller":"+","text":"മൂ.ഭാ. എന്റെ മകനേ; വാ. 21 കാണുക.","reference":{"chapter":24,"verse":13}},{"noteId":50,"caller":"+","text":"മൂ.ഭാ. ചുണ്ടിൽ നൽകുന്ന ചുംബനംപോലെ","reference":{"chapter":24,"verse":26}}]},"thisChapterLink":"/api/mal_bib/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}