{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_bib","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"0779a8d526ec7ab3a8f6f2d92fa1dee6c63a9df2883af973dbb429592e73a01c","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":["യെഹൂദാരാജാവായ ഹിസ്കിയാവിന്റെ ആളുകൾ സമാഹരിച്ച ശലോമോന്റെ മറ്റുള്ള സുഭാഷിതങ്ങളാണിവ:"]},{"type":"verse","number":2,"content":[{"text":"വസ്തുതകൾ നിഗൂഢതയിൽ സൂക്ഷിക്കുക എന്നതു ദൈവത്തിന്റെ മഹത്ത്വം;","poem":1},{"text":"വസ്തുതകൾ അന്വേഷിച്ചു കണ്ടെത്തുക എന്നതു രാജാവിന്റെ മഹത്ത്വം.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ആകാശത്തിന്റെ ഉന്നതിയും ഭൂമിയുടെ അഗാധതയും മനസ്സിലാക്കുക സാധ്യമല്ല,","poem":1},{"text":"അതുപോലെ രാജാവിന്റെ മനസ്സ് അന്വേഷണാതീതമാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"വെള്ളിയിൽനിന്ന് കീടം നീക്കംചെയ്യുക,","poem":1},{"text":"അപ്പോൾ വെള്ളിപ്പണിക്കാർക്കു പാത്രം നിർമിക്കാൻ കഴിയുന്നു;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"രാജസദസ്സിൽനിന്ന് നീചരായ ഉദ്യോഗസ്ഥരെ നീക്കുക,","poem":1},{"text":"അപ്പോൾ രാജസിംഹാസനം നീതിയിൽ സ്ഥാപിതമാകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"രാജസന്നിധിയിൽ നിങ്ങളെത്തന്നെ പുകഴ്ത്തരുത്,","poem":1},{"text":"അവിടത്തെ ഉന്നതർക്കിടയിൽ ഒരു സ്ഥാനം അവകാശപ്പെടരുത്;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"പ്രഭുക്കന്മാർക്കിടയിൽ അവഹേളിക്കപ്പെടുന്നതിനെക്കാൾ,","poem":1},{"text":"“ഇവിടെ കയറിവരിക,” എന്നു രാജാവ് നിങ്ങളോടു കൽപ്പിക്കുന്നതാണ് നല്ലത്.","poem":2},{"lineBreak":true},{"text":"നിങ്ങൾ ചില വസ്തുതകൾ കണ്ടു എന്ന കാരണത്താൽ","poem":1}]},{"type":"verse","number":8,"content":[{"text":"തിടുക്കത്തിൽ കോടതിവ്യവഹാരത്തിനു കൊണ്ടുവരരുത്,","poem":2},{"text":"നിങ്ങളുടെ അയൽവാസി നിങ്ങളെ അപമാനപ്പെടുത്തിയാൽ","poem":1},{"text":"അവസാനം നിങ്ങൾ എന്തുചെയ്യും?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"അയൽവാസിയുമായി നിങ്ങൾക്കുള്ള തർക്കം ഉന്നയിക്കുന്നതിനിടയിൽ,","poem":1},{"text":"മറ്റൊരാളുടെ രഹസ്യം ഒറ്റുകൊടുക്കരുത്,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അങ്ങനെയായാൽ അതു കേൾക്കുന്നയാൾ നിങ്ങളെ അപഹസിക്കും;","poem":1},{"text":"അവർക്കു നിങ്ങളിലുണ്ടായ അവമതിപ്പ് അവസാനിക്കുകയുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"തക്കസമയത്തു നൽകുന്ന ഒരു വാക്ക്","poem":1},{"text":"വെള്ളിത്താലത്തിലെ കനകമയമായ ആപ്പിൾപോലെയാണ്.","poem":2},{"noteId":51}]},{"type":"verse","number":12,"content":[{"text":"ശ്രദ്ധിക്കുന്ന കാതിനു ജ്ഞാനിയുടെ ശാസന","poem":1},{"text":"സ്വർണക്കമ്മലുകൾപോലെയും തങ്കത്തിൻ ആഭരണം പോലെയുമാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"വിശ്വസ്ത സന്ദേശവാഹകർ തങ്ങളെ നിയോഗിക്കുന്നവർക്ക്","poem":1},{"text":"കൊയ്ത്തുകാലത്തെ മഞ്ഞിന്റെ കുളിർമപോലെയാണ്;","poem":2},{"lineBreak":true},{"text":"അവർ തങ്ങളുടെ യജമാനന്റെ ഹൃദയം ഉന്മേഷഭരിതമാക്കുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"താൻ നൽകാത്ത ദാനത്തെക്കുറിച്ച് വമ്പുപറയുന്നവർ","poem":1},{"text":"മഴനൽകാത്ത മേഘവും കാറ്റുംപോലെയാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ദീർഘക്ഷമയാൽ ഭരണാധികാരിയെപ്പോലും അനുനയിപ്പിക്കാൻ കഴിയും,","poem":1},{"text":"മൃദുഭാഷണം അസ്ഥിയെപ്പോലും ഭേദിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"നിങ്ങൾക്കു തേൻ ലഭിച്ചാൽ ആവശ്യത്തിനുമാത്രം ഭക്ഷിക്കുക—","poem":1},{"text":"അമിതമായാൽ അത് ഛർദിച്ചുപോകും.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"വല്ലപ്പോഴുംമാത്രം നിങ്ങളുടെ അയൽവീട്ടിൽ പോകുക—","poem":1},{"text":"കൂടെക്കൂടെയുള്ള സന്ദർശനം, അവർക്കു നിങ്ങളോടു വെറുപ്പുതോന്നിപ്പിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"തന്റെ അയൽവാസിക്കെതിരേ കള്ളസാക്ഷി പറയുന്നവർ","poem":1},{"text":"ഗദയോ വാളോ കൂരമ്പോപോലെയാണ്.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ആപത്തുനാളുകളിൽ അവിശ്വസ്തരെ ആശ്രയിക്കരുത്","poem":1},{"text":"പൊട്ടിയ പല്ലോ മുടന്തുള്ള കാലോ പോലെയാണത്.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"വിഷാദിച്ചിരിക്കുന്നവർക്കുവേണ്ടി ആഹ്ലാദഗാനം ആലപിക്കുന്നത്,","poem":1},{"text":"ശൈത്യകാലത്ത് വസ്ത്രം അപഹരിക്കുന്നവരെപ്പോലെയോ","poem":2},{"lineBreak":true},{"text":"മുറിവിൽ വിന്നാഗിരി ഒഴിക്കുന്നതുപോലെയോ ആണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"നിന്റെ ശത്രുവിനു വിശക്കുന്നെങ്കിൽ അയാൾക്കു ഭക്ഷിക്കാൻ കൊടുക്കുക;","poem":1},{"text":"ദാഹിക്കുന്നെങ്കിൽ കുടിക്കുന്നതിനു വെള്ളം നൽകുക.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ഇങ്ങനെ ചെയ്യുന്നതിലൂടെ, നിങ്ങൾ ശത്രുവിന്റെ ശിരസ്സിൽ കൽക്കരിക്കനൽ","poem":1},{"noteId":52},{"text":"കൂട്ടിവെക്കുകയാണ്,","poem":1},{"text":"അങ്ങനെയായാൽ യഹോവ നിങ്ങൾക്കു പ്രതിഫലംനൽകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"വടക്കൻകാറ്റ് അപ്രതീക്ഷിത മഴ കൊണ്ടുവരുന്നതുപോലെ","poem":1},{"text":"കാപട്യമുള്ള നാവ് രോഷാകുലമായ നോട്ടം കൊണ്ടുവരുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"കലഹക്കാരിയായ ഭാര്യയോടൊത്ത് വീടിനുള്ളിൽ കഴിയുന്നതിനെക്കാൾ,","poem":1},{"text":"മേൽപ്പുരയുടെ ഒരു കോണിൽ താമസിക്കുന്നതു നല്ലത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ക്ഷീണിതമനസ്സിന് ശീതജലം ലഭിക്കുന്നതുപോലെയാണ്","poem":1},{"text":"വിദൂരദേശത്തുനിന്നു സദ്വാർത്ത വരുന്നത്.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ദുഷ്ടർക്കു വിധേയപ്പെടുന്ന നീതിനിഷ്ഠർ","poem":1},{"text":"ചെളിനിറഞ്ഞ നീരുറവപോലെയോ മലീമസമായ കിണർപോലെയോ ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"അമിതമായി തേൻ ഭക്ഷിക്കുന്നത് നല്ലതല്ല,","poem":1},{"text":"അതുപോലെ സ്വന്തം ബഹുമാനംമാത്രം അന്വേഷിക്കുന്നതും മാന്യമല്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ആത്മനിയന്ത്രണമില്ലാത്ത മനുഷ്യർ","poem":1},{"text":"മതിലുകൾ തകർന്നുകിടക്കുന്ന പട്ടണംപോലെയാണ്.","poem":2}]}],"footnotes":[{"noteId":51,"caller":"+","text":"അഥവാ, അത്തിപ്പഴംപോലെയാണ്","reference":{"chapter":25,"verse":11}},{"noteId":52,"caller":"+","text":"കൽക്കരിക്കനൽ, വിവക്ഷിക്കുന്നത് അപമാനത്തിന്റെ കനൽ.","reference":{"chapter":25,"verse":22}}]},"thisChapterLink":"/api/mal_bib/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":28}