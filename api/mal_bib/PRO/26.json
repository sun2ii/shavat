{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_bib","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"0779a8d526ec7ab3a8f6f2d92fa1dee6c63a9df2883af973dbb429592e73a01c","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"വേനൽക്കാലത്തു മഞ്ഞും വിളവെടുപ്പിനു മഴയുംപോലെ,","poem":1},{"text":"ഭോഷർക്കു ബഹുമതിയും അനുയോജ്യമല്ല.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"പാറിപ്പറക്കുന്ന കുരികിലും ശരവേഗത്തിൽ പറക്കുന്ന മീവൽപ്പക്ഷിയുംപോലെ,","poem":1},{"text":"കാരണംകൂടാതെയുള്ള ശാപം ലക്ഷ്യസ്ഥാനത്തെത്തുന്നില്ല.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"കുതിരയ്ക്കൊരു ചാട്ടവാർ, കഴുതയ്ക്കൊരു കടിഞ്ഞാൺ,","poem":1},{"text":"ഭോഷർക്കു മുതുകിലൊരു വടി!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ഭോഷരുടെ മടയത്തരത്തിന് അനുസൃതമായി മറുപടിനൽകരുത്,","poem":1},{"text":"അങ്ങനെയായാൽ നീയും അവരെപ്പോലെ ഭോഷരായിത്തീരും.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ഭോഷർക്കു തങ്ങൾ ജ്ഞാനി എന്നു സ്വയം തോന്നാതിരിക്കാൻ,","poem":1},{"text":"അവരുടെ ഭോഷത്തരത്തിന് അനുസൃതമായ മറുപടിനൽകുക.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഒരു ഭോഷന്റെ കൈവശം സന്ദേശം കൊടുത്തയയ്ക്കുന്നത്","poem":1},{"text":"സ്വന്തം പാദങ്ങൾ വെട്ടിക്കളയുകയോ വിഷം കുടിക്കുകയോ ചെയ്യുന്നതുപോലെയാണ്.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"മുടന്തനായ മനുഷ്യന്റെ ഉപയോഗശൂന്യമായ കാൽപോലെയാണ്","poem":1},{"text":"ഭോഷരുടെ വായിൽനിന്നുള്ള സുഭാഷിതങ്ങൾ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"കവിണയിൽ കല്ലു തൊടുക്കുന്നതുപോലെയാണ്","poem":1},{"text":"ഭോഷനു ബഹുമതി നൽകുന്നത്.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"മദ്യപാനിയുടെ കൈയിൽത്തറച്ച മുള്ളുപോലെയാണ്","poem":1},{"text":"ഭോഷരുടെ വായിൽനിന്നുള്ള സുഭാഷിതങ്ങൾ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"കണ്ണിൽക്കാണുന്നവരെയൊക്കെ മുറിവേൽപ്പിക്കുന്ന വില്ലാളിയെപ്പോലെയാണ്","poem":1},{"text":"ഭോഷരെയോ വഴിപോക്കരെയോ കൂലിക്കെടുക്കുന്നയാൾ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"നായ അതിന്റെ ഛർദിയിലേക്കു തിരിയുന്നതുപോലെതന്നെ,","poem":1},{"text":"ഭോഷർ തങ്ങളുടെ മടയത്തരം ആവർത്തിച്ചുകൊണ്ടിരിക്കും.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"സ്വന്തം വീക്ഷണത്തിൽ ജ്ഞാനിയെന്ന് അഭിമാനിക്കുന്ന ഒരാളെ നിങ്ങൾ കാണുന്നോ?","poem":1},{"text":"ഭോഷർക്ക് അയാളെക്കാൾ ആശയ്ക്കുവകയുണ്ട്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"അലസർ ഇപ്രകാരം പറയുന്നു, “വഴിയിൽ ഒരു സിംഹമുണ്ട്!","poem":1},{"text":"ഭീകരനായ ഒരു സിംഹം തെരുവിൽ ചുറ്റിത്തിരിയുന്നുണ്ട്!”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ഒരു കതക് അതിന്റെ വിജാഗിരിയിൽ തിരിയുന്നതുപോലെ,","poem":1},{"text":"അലസർ തങ്ങളുടെ കിടക്കയിൽ തിരിഞ്ഞുമറിയുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അലസർ ഭക്ഷണപാത്രത്തിൽ കൈ പൂഴ്ത്തുന്നു;","poem":1},{"text":"അവർ അതു തിരികെ തന്റെ വായിലേക്ക് അടുപ്പിക്കുന്നതിനുപോലും മടിയാണ്.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"വിവേകപൂർവം ഉത്തരംനൽകുന്ന ഏഴുപേരെക്കാൾ,","poem":1},{"text":"താൻ കേമനാണെന്ന് അലസർ മിഥ്യാഭിമാനംകൊള്ളുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"താനുമായി യാതൊരു ബന്ധവുമില്ലാത്ത കലഹത്തിലേക്കു പാഞ്ഞടുക്കുന്നവർ,","poem":1},{"text":"വഴിയേ പോകുന്ന നായുടെ ചെവിക്കു പിടിക്കുന്നവരെപ്പോലെയാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"അയൽവാസിയെ ദ്രോഹിച്ചിട്ട്,","poem":1},{"text":"“അതു നേരമ്പോക്കിനായിരുന്നു!” എന്നു പറയുന്നവർ;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"മാരകമായ തീജ്വാല","poem":1},{"text":"ചുഴറ്റിയെറിയുന്ന ഭ്രാന്തനുസമം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"വിറകില്ലായെങ്കിൽ തീ കെട്ടുപോകും;","poem":1},{"text":"പരദൂഷണം ഇല്ലാതെയായാൽ കലഹവും കെട്ടടങ്ങും.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"കരി ജ്വലനത്തിനും വിറക് തീക്കും എന്നതുപോലെ,","poem":1},{"text":"കലഹത്തെ പ്രണയിക്കുന്നവർ സംഘട്ടനത്തെ ആളിക്കത്തിക്കുന്നു.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ഏഷണി പറയുന്നവരുടെ വാക്കുകൾ സ്വാദുഭോജനംപോലെയാകുന്നു;","poem":1},{"text":"അതു ശരീരത്തിന്റെ അന്തർഭാഗത്തേക്ക് ഇറങ്ങിച്ചെല്ലുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ദുഷ്ടമനസ്സുകളുടെ തീവ്രവികാരം മന്ത്രിക്കുന്ന ചുണ്ടുകൾ","poem":1},{"text":"മൺപാത്രങ്ങളുടെ പുറത്തു വെള്ളി പൂശിയിരിക്കുന്നതുപോലെയാണ്.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ശത്രുക്കൾ അവരുടെ അധരംകൊണ്ടു കപടവേഷം ധരിക്കുന്നു,","poem":1},{"text":"എന്നാൽ അവരുടെ ഹൃദയത്തിൽ വക്രത നിറച്ചുവെച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"അവരുടെ സംഭാഷണം അതിമനോഹരമായിരുന്നാലും അവരെ വിശ്വസിക്കരുത്,","poem":1},{"text":"ഏഴു ഹീനകൃത്യങ്ങൾകൊണ്ട് അവരുടെ ഹൃദയം നിറഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"അവരുടെ ദുഷ്ടത വഞ്ചനാപരമായി മറച്ചുവെച്ചിരുന്നാലും,","poem":1},{"text":"അവരുടെ നീചകൃത്യങ്ങൾ പൊതുസഭയിൽ വെളിപ്പെട്ടുവരും.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ഒരാൾ കുഴിക്കുന്ന കുഴിയിൽ അയാൾതന്നെ വീഴും;","poem":1},{"text":"താൻ ഉരുട്ടിവിടുന്ന കല്ല് തന്റെ നേർക്കുതന്നെ തിരിഞ്ഞുരുണ്ടുവന്നു പതിക്കും.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"വ്യാജംപറയുന്ന നാവ് അതിനിരയായവരെ വെറുക്കുന്നു,","poem":1},{"text":"മുഖസ്തുതി പറയുന്ന നാവ് നാശം വിതയ്ക്കുന്നു.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PRO/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PRO/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PRO/25.json","previousChapterAudioLinks":{},"numberOfVerses":28}