{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_bib","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"0779a8d526ec7ab3a8f6f2d92fa1dee6c63a9df2883af973dbb429592e73a01c","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"നാളെയെക്കുറിച്ചു വീരവാദം മുഴക്കരുത്,","poem":1},{"text":"കാരണം ഓരോ ദിവസവും എന്തെല്ലാമാണു കൊണ്ടുവരുന്നതെന്നു നിങ്ങൾ അറിയുന്നില്ലല്ലോ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"നിങ്ങളുടെ നാവല്ല, മറ്റുള്ളവർ നിങ്ങളെ പ്രശംസിക്കട്ടെ;","poem":1},{"text":"നിങ്ങളുടെ അധരമല്ല, അന്യർ നിങ്ങളെ പ്രശംസിക്കട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"കല്ല് ഘനമേറിയതും മണൽ ഭാരമുള്ളതുമാണ്,","poem":1},{"text":"എന്നാൽ ഒരു ഭോഷന്റെ പ്രകോപനം ഇവ രണ്ടിലും ഭാരമേറിയതാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"കോപം ക്രൂരവും ക്രോധം പ്രളയംപോലെയുമാണ്,","poem":1},{"text":"എന്നാൽ അസൂയയ്ക്കുമുന്നിൽ ആർക്കു പിടിച്ചുനിൽക്കാൻ കഴിയും?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"മറച്ചുവെക്കുന്ന സ്നേഹത്തെക്കാളും","poem":1},{"text":"തുറന്ന ശാസനയാണ് നല്ലത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"സുഹൃത്തിൽനിന്നുള്ള മുറിവുകൾ വിശ്വസനീയം,","poem":1},{"text":"എന്നാൽ എതിരാളിയോ, ചുംബനം വർഷിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ഭക്ഷിച്ചു തൃപ്തരായിരിക്കുന്നവർക്കു തേനട അരോചകമാണ്,","poem":1},{"text":"എന്നാൽ വിശപ്പുള്ളവർക്ക് കയ്‌പുള്ളതുപോലും മധുരതരമാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"വീടുവിട്ടലയുന്ന മനുഷ്യനും","poem":1},{"text":"കൂടുവിട്ടുഴലുന്ന പക്ഷിയും ഒരുപോലെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"സുഹൃത്തിന്റെ ഹൃദ്യമായ ഉപദേശം","poem":1},{"text":"സുഗന്ധതൈലവും ധൂപവർഗവുംപോലെ","poem":2},{"lineBreak":true},{"text":"ഹൃദയത്തിനു പ്രസാദകരമാകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"നിങ്ങളുടെ സുഹൃത്തിനെയോ കുടുംബസുഹൃത്തിനെയോ ഉപേക്ഷിക്കരുത്,","poem":1},{"text":"ദുരന്തങ്ങൾ നിങ്ങളെ വേട്ടയാടുമ്പോൾ ബന്ധുഭവനങ്ങളിൽ പോകുകയുമരുത്—","poem":2},{"lineBreak":true},{"text":"അകലെയുള്ള ബന്ധുവിനെക്കാൾ ഭേദം സമീപത്തുള്ള അയൽക്കാരാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"എന്റെ കുഞ്ഞേ,","poem":1},{"noteId":53},{"text":"നീ ജ്ഞാനിയായിരിക്കുക, അങ്ങനെ എന്റെ ഹൃദയത്തിന് ആനന്ദംനൽകുക;","poem":1},{"text":"അപ്പോൾ എനിക്ക് എന്നെ നിന്ദിക്കുന്നവരോട് പ്രത്യുത്തരം പറയാൻകഴിയും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ഒരു വിവേകി ആപത്തിനെ മുൻകണ്ട് അഭയസ്ഥാനം തേടുന്നു,","poem":1},{"text":"എന്നാൽ ലളിതമാനസർ മുമ്പോട്ടുതന്നെപോയി ദുരന്തം വരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"അന്യർക്കുവേണ്ടി ജാമ്യം നിൽക്കുന്നവരുടെ വസ്ത്രം കൈവശപ്പെടുത്തുക;","poem":1},{"text":"പ്രവാസിക്കുവേണ്ടിയാണ് കൈയൊപ്പുചാർത്തുന്നതെങ്കിൽ, വസ്ത്രംതന്നെ പണയമായി വാങ്ങുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"അതിരാവിലെ ആരെങ്കിലും നിങ്ങളുടെ അയൽവാസിയെ ഉച്ചത്തിൽ അനുഗ്രഹിക്കുന്നെങ്കിൽ,","poem":1},{"text":"അതൊരു ശാപമായി പരിഗണിക്കപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"കലഹപ്രിയയായ ഭാര്യ പെരുമഴയത്തു","poem":1},{"text":"ചോരുന്ന പുരയിൽനിന്ന് ഇറ്റിറ്റുവീഴുന്ന വെള്ളംപോലെയാണ്;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അവളെ നിയന്ത്രിക്കാൻ ശ്രമിക്കുന്നത് കാറ്റിനെ തടഞ്ഞുനിർത്താൻ ശ്രമിക്കുന്നതുപോലെയോ","poem":1},{"text":"കൈയിൽ എണ്ണ മുറുക്കിപ്പിടിക്കാൻ ശ്രമിക്കുന്നതുപോലെയോ ആണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ഇരുമ്പ് ഇരുമ്പിനു മൂർച്ചകൂട്ടുന്നതുപോലെ","poem":1},{"text":"ഒരു മനുഷ്യൻ മറ്റൊരു മനുഷ്യനു മൂർച്ചകൂട്ടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"അത്തിവൃക്ഷം സംരക്ഷിക്കുന്നവർ അതിലെ ഫലം ഭക്ഷിക്കുന്നു,","poem":1},{"text":"തങ്ങളുടെ യജമാനനെ സംരക്ഷിക്കുന്നവർ ബഹുമാനിക്കപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"വെള്ളം മുഖത്തിന്റെ പ്രതിച്ഛായ പ്രതിഫലിപ്പിക്കുന്നതുപോലെ,","poem":1},{"text":"ഒരാളുടെ ഹൃദയം അയാളുടെ യഥാർഥ വ്യക്തിത്വം പ്രതിഫലിപ്പിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"മരണവും ദുരന്തവും ഒരിക്കലും തൃപ്തിയടയുന്നില്ല,","poem":1},{"text":"അതുപോലെതന്നെയാണ് മനുഷ്യനേത്രങ്ങളും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"തീച്ചൂളയിൽ വെള്ളിയും ഉലയിൽ സ്വർണവും ശുദ്ധിചെയ്യപ്പെടുന്നു,","poem":1},{"text":"എന്നാൽ ആളുകൾ അവർക്കു ലഭിക്കുന്ന പ്രശംസയാൽ പരിശോധിക്കപ്പെടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ധാന്യം ഉരലിലിട്ട് ഉലക്കകൊണ്ട് ഇടിക്കുന്നതുപോലെ,","poem":1},{"text":"ഭോഷരെ ഇടിച്ചാലും","poem":2},{"lineBreak":true},{"text":"അവരുടെ ഭോഷത്തം അവരിൽനിന്നകറ്റുക അസാധ്യം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"നിങ്ങളുടെ ആട്ടിൻപറ്റത്തിന്റെ അവസ്ഥ നന്നായി അറിഞ്ഞിരിക്കുക,","poem":1},{"text":"നിങ്ങളുടെ കന്നുകാലികൾക്കും സൂക്ഷ്മശ്രദ്ധനൽകുക;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"കാരണം സമ്പത്ത് സദാ സുസ്ഥിരമായിരിക്കുകയില്ല,","poem":1},{"text":"കിരീടം തലമുറകളായി സംരക്ഷിക്കപ്പെടുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ഉണങ്ങിയ പുല്ല് ചെത്തിനീക്കുകയും പുതുനാമ്പുകൾ മുളച്ചുവരികയുംചെയ്യുമ്പോൾ","poem":1},{"text":"പർവതങ്ങളിൽനിന്നു സസ്യങ്ങൾ ശേഖരിക്കപ്പെടുന്നു,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ആട്ടിൻപറ്റങ്ങൾ വസ്ത്രത്തിനുള്ള വകയും","poem":1},{"text":"കോലാടുകൾ നിലത്തിനുള്ള വിലയും നേടിത്തരും.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"നിനക്കും കുടുംബത്തിനും കോലാട്ടിൻപാൽ സമൃദ്ധമായി ലഭിക്കും","poem":1},{"text":"അത് നിങ്ങളുടെ ദാസീവൃന്ദത്തിന്റെ ജീവസന്ധാരണത്തിനും വകനൽകും.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":53,"caller":"+","text":"മൂ.ഭാ. എന്റെ മകനേ","reference":{"chapter":27,"verse":11}}]},"thisChapterLink":"/api/mal_bib/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}