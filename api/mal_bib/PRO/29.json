{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_bib","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"0779a8d526ec7ab3a8f6f2d92fa1dee6c63a9df2883af973dbb429592e73a01c","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"ധാരാളം ശാസനകൾ കേട്ടിട്ടും ശാഠ്യം കാണിക്കുന്നവർ","poem":1},{"text":"പരിഹാരമില്ലാതെ പെട്ടെന്നു നാശത്തിലേക്കു കൂപ്പുകുത്തും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"നീതിനിഷ്ഠർക്ക് ഐശ്വര്യമുണ്ടാകുമ്പോൾ ജനം ആനന്ദിക്കുന്നു;","poem":1},{"text":"ദുഷ്ടർ ഭരണംകയ്യാളുമ്പോൾ ജനം ഞരങ്ങുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ജ്ഞാനത്തെ പ്രണയിക്കുന്നവർ തങ്ങളുടെ പിതാവിന് ആനന്ദംനൽകുന്നു,","poem":1},{"text":"എന്നാൽ വേശ്യകളുടെ സഹയാത്രികൻ സമ്പത്തു ധൂർത്തടിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ഒരു രാജാവ് നീതിയാൽ തന്റെ രാജ്യത്തിനു സുസ്ഥിരത കൈവരുത്തുന്നു,","poem":1},{"text":"എന്നാൽ കോഴ കൊതിക്കുന്നവർ അതിനെ ശിഥിലമാക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"തന്റെ അയൽവാസിയോടു മുഖസ്തുതി പറയുന്നവർ","poem":1},{"text":"സ്വന്തം കാലിനൊരു വല വിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ദുഷ്ടരുടെ അതിക്രമം അവർക്കൊരു കെണിയായിത്തീരുന്നു,","poem":1},{"text":"എന്നാൽ നീതിനിഷ്ഠർ പാട്ടുപാടി ആനന്ദിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"നീതിനിഷ്ഠർ ദരിദ്രർക്ക് നീതി ലഭ്യമാക്കുന്നതിൽ ബദ്ധശ്രദ്ധരാണ്,","poem":1},{"text":"എന്നാൽ ദുഷ്ടർക്ക് അത്തരം ചിന്തയൊന്നുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"പരിഹാസികൾ ഒരു നഗരത്തെ ഇളക്കിമറിക്കുന്നു,","poem":1},{"text":"എന്നാൽ ജ്ഞാനികൾ കോപത്തെ ഇല്ലാതാക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ജ്ഞാനി ഭോഷരുമായി കോടതിവ്യവഹാരത്തിൽ ഏർപ്പെട്ടാൽ,","poem":1},{"text":"ഭോഷർ കോപവും അപഹാസവും ചൊരിയുന്നതിനാൽ യാതൊരു സമാധാനവും ലഭിക്കുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"രക്തദാഹികൾ സത്യസന്ധരെ വെറുക്കുകയും","poem":1},{"text":"നീതിനിഷ്ഠരുടെ പ്രാണനെടുക്കാൻ പരതുകയുംചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ഭോഷർ തങ്ങളുടെ കോപംമുഴുവനും പുറത്തേക്കെടുക്കുന്നു,","poem":1},{"text":"എന്നാൽ ജ്ഞാനി അതു ശാന്തതയോടെ നിയന്ത്രിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ഒരു ഭരണാധികാരി വ്യാജംകേൾക്കാൻ തുനിഞ്ഞാൻ","poem":1},{"text":"അദ്ദേഹത്തിന്റെ എല്ലാ ഉദ്യോഗസ്ഥരും നീചവൃത്തിക്കാരാകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ദരിദ്രർക്കും പീഡകർക്കും പൊതുവായി ഇതൊന്നുമാത്രം:","poem":1},{"text":"യഹോവ ഇരുകൂട്ടരുടെയും കണ്ണുകൾക്കു കാഴ്ചനൽകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"രാജാവ് അഗതികൾക്കു നീതിയോടെ ന്യായപാലനംചെയ്താൽ,","poem":1},{"text":"അവിടത്തെ സിംഹാസനം എന്നേക്കും സുസ്ഥിരമായിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"വടിയും കർക്കശമായ താക്കീതും ജ്ഞാനംനൽകുന്നു,","poem":1},{"text":"ശിക്ഷണംലഭിക്കാതെ ജീവിക്കുന്ന സന്തതി തന്റെ മാതാവിന് അപമാനംവരുത്തുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ദുഷ്ടർ വർധിക്കുമ്പോൾ, പാപവും വർധിക്കുന്നു,","poem":1},{"text":"എന്നാൽ നീതിനിഷ്ഠർ അവരുടെ തകർച്ച കാണും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"നിങ്ങളുടെ കുഞ്ഞുങ്ങളെ ശിക്ഷണത്തിൽ വളർത്തുക, അവർ നിങ്ങൾക്കു സ്വസ്ഥതനൽകും;","poem":1},{"text":"നിങ്ങൾ ആഗ്രഹിക്കുന്ന ആനന്ദംനൽകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ദൈവിക നിർദേശങ്ങൾ","poem":1},{"noteId":54},{"text":"ഇല്ലാത്തിടത്ത്, ജനം നിയന്ത്രണരഹിതരായി ജീവിക്കുന്നു;","poem":1},{"text":"എന്നാൽ ന്യായപ്രമാണം പാലിക്കുന്നവർ അനുഗൃഹീതർ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"കേവലം വാക്കുകൾകൊണ്ട് ദാസരെ ഗുണീകരിക്കുക ദുഷ്കരം;","poem":1},{"text":"അവർക്കതു മനസ്സിലായെങ്കിലും, അതനുസരിച്ചു പ്രവർത്തിക്കുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ധൃതിയിൽ സംസാരിക്കുന്നവരെ നിങ്ങൾ കാണുന്നോ?","poem":1},{"text":"ഭോഷർക്ക് അവരെക്കാൾ ആശയുണ്ട്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ബാല്യംമുതൽ അമിതലാളനയിൽ വളർന്നുവന്ന ദാസർ","poem":1},{"text":"അവസാനം ധിക്കാരിയായി മാറും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"കോപിഷ്ഠരായ മനുഷ്യർ കലഹം ഇളക്കിവിടുന്നു,","poem":1},{"text":"ക്ഷിപ്രകോപിയായ മനുഷ്യർ അനവധി പാപങ്ങൾ ചെയ്തുകൂട്ടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"അഹങ്കാരി അപമാനത്തിൽ അവസാനിക്കുന്നു,","poem":1},{"text":"എന്നാൽ നമ്രഹൃദയി ബഹുമതി ആർജിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"മോഷ്ടാക്കളുടെ കൂട്ടാളികളാകുന്നത് സ്വയം മുറിപ്പെടുത്തുന്നതിനു തുല്യമാണ്;","poem":1},{"text":"അവർ സത്യമേ പറയൂ എന്ന് ശപഥംചെയ്തിരിക്കുന്നു; എന്നാൽ ഒന്നും തുറന്നുപറയാൻ തയ്യാറാകുന്നതുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"മനുഷ്യരെ ഭയക്കുന്നത് അപകടകരമായ ഒരു കെണിയാണ്,","poem":1},{"text":"എന്നാൽ യഹോവയെ ഭയപ്പെടുന്നവർ സുരക്ഷിതരായിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ഭരണാധികാരിയുടെ പ്രീതിക്കായി പലരും പരിശ്രമിക്കുന്നു,","poem":1},{"text":"എന്നാൽ യഹോവയിൽനിന്നാണ് ഒരാൾക്കു നീതി ലഭിക്കുന്നത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"നീതിനിഷ്ഠർ അനീതി പ്രവർത്തിക്കുന്നവരെ വെറുക്കുന്നു;","poem":1},{"text":"ദുഷ്ടർ നീതിനിഷ്ഠരെയും വെറുക്കുന്നു.","poem":2}]}],"footnotes":[{"noteId":54,"caller":"+","text":"മൂ.ഭാ. ദർശനം","reference":{"chapter":29,"verse":18}}]},"thisChapterLink":"/api/mal_bib/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":27}