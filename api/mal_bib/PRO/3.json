{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_bib","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"0779a8d526ec7ab3a8f6f2d92fa1dee6c63a9df2883af973dbb429592e73a01c","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":3,"content":[{"type":"heading","content":["ജ്ഞാനത്തിന്റെ അധിക സത്ഫലങ്ങൾ"]},{"type":"verse","number":1,"content":[{"text":"എന്റെ കുഞ്ഞേ,","poem":1},{"noteId":5},{"text":"എന്റെ ഉപദേശം നീ വിസ്മരിക്കരുത്,","poem":1},{"text":"എന്റെ കൽപ്പനകൾ നിന്റെ ഹൃദയത്തിൽ സംഗ്രഹിച്ചുവെക്കുക,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവ നിന്റെ ആയുസ്സ് പല വർഷങ്ങൾ ദീർഘിപ്പിക്കും","poem":1},{"text":"അവ നിനക്കു സമാധാനവും സമൃദ്ധിയും പ്രദാനംചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ആത്മാർഥതയും വിശ്വസ്തതയും നിന്നെ വിട്ടുപിരിയാതിരിക്കട്ടെ;","poem":1},{"text":"അവ നിന്റെ കഴുത്തിൽ അണിയുക,","poem":2},{"lineBreak":true},{"text":"നിന്റെ ഹൃദയഫലകത്തിൽ ആലേഖനംചെയ്യുക.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അപ്പോൾ നീ ദൈവത്തിന്റെയും മനുഷ്യരുടെയും ദൃഷ്ടിയിൽ","poem":1},{"text":"പ്രീതിയും സൽപ്പേരും സമ്പാദിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"പൂർണഹൃദയത്തോടെ നീ യഹോവയിൽ വിശ്വാസമർപ്പിക്കുക","poem":1},{"text":"സ്വന്തവിവേകത്തിൽ ആശ്രയിക്കുകയുമരുത്;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"നിന്റെ ചെയ്തികളെല്ലാം ദൈവികാംഗീകാരമുള്ളതായിരിക്കട്ടെ,","poem":1},{"text":"അവിടന്ന് നിന്റെ സഞ്ചാരപാതകൾ നേരേയാക്കും.","poem":2},{"noteId":6}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"സ്വബുദ്ധിയിൽ, നീ ജ്ഞാനിയെന്നു ഭാവിക്കരുത്;","poem":1},{"text":"യഹോവയെ ഭയപ്പെട്ട് തിന്മയിൽനിന്ന് അകന്നുനിൽക്കുക.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ഇതു നിന്റെ ശരീരത്തിന് ആരോഗ്യവും","poem":1},{"text":"അസ്ഥികൾക്ക് പോഷണവും നൽകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"നിന്റെ സമ്പത്തുകൊണ്ട് യഹോവയെ ബഹുമാനിക്കുക","poem":1},{"text":"നിന്റെ എല്ലാ വിളവുകളുടെയും ആദ്യഫലംകൊണ്ടുംതന്നെ;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അപ്പോൾ നിന്റെ ധാന്യപ്പുരകൾ സമൃദ്ധമായി നിറയും","poem":1},{"text":"നിന്റെ ഭരണികൾ പുതുവീഞ്ഞിനാൽ കവിഞ്ഞൊഴുകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"എന്റെ കുഞ്ഞേ, യഹോവയുടെ ശിക്ഷണം നിരസിക്കരുത്,","poem":1},{"text":"അവിടത്തെ ശാസനയോട് അമർഷം തോന്നുകയുമരുത്,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"കാരണം, ഒരു പിതാവ് തന്റെ പ്രിയപുത്രനോട് എന്നതുപോലെ","poem":1},{"text":"യഹോവ, താൻ സ്നേഹിക്കുന്നവരെ ശിക്ഷിക്കുന്നു.","poem":2},{"noteId":7}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ജ്ഞാനം കണ്ടെത്തുകയും","poem":1},{"text":"വിവേകം നേടുകയും ചെയ്യുന്നവർ അനുഗൃഹീതർ,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"കാരണം അവൾ","poem":1},{"noteId":8},{"text":"വെള്ളിയെക്കാൾ ആദായകരവും","poem":1},{"text":"കനകത്തെക്കാൾ ലാഭകരവുമാണ്.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവൾ മാണിക്യത്തെക്കാൾ അമൂല്യമാണ്;","poem":1},{"text":"നീ അഭിലഷിക്കുന്നതൊന്നും അതിനു തുല്യമാകുകയില്ല.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അവൾ വലതുകരത്തിൽ ദീർഘായുസ്സും;","poem":1},{"text":"ഇടതുകരത്തിൽ ധനസമൃദ്ധിയും ബഹുമതിയും വാഗ്ദാനംചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവളുടെ വഴികൾ ആനന്ദഹേതുവും","poem":1},{"text":"അവളുടെ പാതകളെല്ലാം സമാധാനപൂർണവും ആകുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അവളെ ആലിംഗനംചെയ്യുന്നവർക്ക് അവൾ ഒരു ജീവവൃക്ഷം;","poem":1},{"text":"അവളെ മുറുകെപ്പിടിക്കുന്നവർ അനുഗൃഹീതരാകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ജ്ഞാനത്താൽ യഹോവ ഭൂമിക്ക് അടിസ്ഥാനശില പാകി,","poem":1},{"text":"വിവേകത്താൽ അവിടന്ന് ആകാശത്തെ തൽസ്ഥാനത്ത് ഉറപ്പിച്ചു;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അവിടത്തെ പരിജ്ഞാനത്താൽ ആഴങ്ങൾ പൊട്ടിപ്പിളർന്നു,","poem":1},{"text":"ആകാശം തുഷാരബിന്ദുക്കൾ പൊഴിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"എന്റെ കുഞ്ഞേ, ജ്ഞാനവും വിവേചനശക്തിയും നിലനിർത്തുക,","poem":1},{"text":"അവ നിന്റെ ദൃഷ്ടിപഥത്തിൽനിന്നു മറയാതിരിക്കട്ടെ;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"കാരണം അവ നിനക്കു ജീവനും,","poem":1},{"text":"നിന്റെ കഴുത്തിൽ ഒരു അലങ്കാരമാലയും ആയിരിക്കട്ടെ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"അപ്പോൾ നീ നിന്റെ വഴികളിൽ സുരക്ഷിതനായി മുന്നേറും,","poem":1},{"text":"നിന്റെ കാലടികൾ ഇടറുകയുമില്ല.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"കിടക്കയിലേക്കുപോകുമ്പോൾ നിനക്കു ഭയമുണ്ടാകുകയില്ല;","poem":1},{"text":"നീ കിടക്കുകയും ഉടനെതന്നെ സുഖനിദ്രയിലമരുകയും ചെയ്യും","poem":2}]},{"type":"verse","number":25,"content":[{"text":"പെട്ടെന്നു സംഭവിക്കുന്ന ദുരന്തമോ","poem":1},{"text":"ദുഷ്ടരുടെ നാശമോ കണ്ട് നീ സംഭീതനാകരുത്,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"കാരണം യഹോവയാണ് നിന്റെ സുരക്ഷിതത്വം","poem":1},{"text":"അവിടന്ന് നിന്റെ പാദം കെണിയിലകപ്പെടാതെ കാത്തുകൊള്ളും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"നന്മചെയ്യാൻ നിനക്ക് അധികാരമുള്ളപ്പോൾ,","poem":1},{"text":"അർഹതപ്പെട്ടവർക്ക് അതു ലഭ്യമാക്കാൻ വിമുഖതകാട്ടരുത്.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"നിനക്ക് ഇപ്പോൾ സഹായിക്കാൻ സാധിക്കുമെങ്കിൽ,","poem":1},{"text":"“പിന്നെവരിക, നാളെനോക്കാം,”","poem":2},{"lineBreak":true},{"text":"എന്നു നിന്റെ അയൽവാസിയോട് പറയരുത്.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"നിന്റെ സമീപത്ത് നിന്നെ ആശ്രയിച്ചുകൊണ്ടു വസിക്കുന്ന,","poem":1},{"text":"നിന്റെ അയൽവാസിക്കെതിരേ നീ ദുരാലോചന നടത്തരുത്.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"നിനക്കു നിരുപദ്രവകാരിയായ മനുഷ്യനെതിരേ,","poem":1},{"text":"യാതൊരുകാരണവശാലും കലഹിക്കരുത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"അക്രമിയോട് അസൂയപ്പെടുകയോ","poem":1},{"text":"അയാളുടെ പാത തെരഞ്ഞെടുക്കുകയോ ചെയ്യരുത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"വക്രതയുള്ളവർ യഹോവയ്ക്ക് അറപ്പാകുന്നു","poem":1},{"text":"എന്നാൽ പരമാർഥതയുള്ളവരോട് അവിടന്ന് വിശ്വസ്തതപുലർത്തുന്നു.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ദുഷ്ടരുടെ ഭവനത്തെ യഹോവ ശപിക്കുന്നു,","poem":1},{"text":"നീതിനിഷ്ഠരുടെ ഭവനത്തെയോ, അവിടന്ന് അനുഗ്രഹിക്കുന്നു.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"പരിഹാസികളെ അവിടന്ന് അപഹസിക്കുന്നു,","poem":1},{"text":"എന്നാൽ വിനയാന്വിതർക്ക് അവിടന്ന് കൃപചൊരിയുന്നു.","poem":2},{"noteId":9}]},{"type":"verse","number":35,"content":[{"text":"ജ്ഞാനികൾ ബഹുമാനാർഹരായിത്തീരുന്നു,","poem":1},{"text":"ഭോഷരെ അപമാനത്തിന് ഏൽപ്പിച്ചുകൊടുക്കും.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"മൂ.ഭാ. എന്റെ മകനേ; വാ. 11, 21 കാണുക.","reference":{"chapter":3,"verse":1}},{"noteId":6,"caller":"+","text":"അഥവാ, നിന്നെ വഴിനടത്തും","reference":{"chapter":3,"verse":6}},{"noteId":7,"caller":"+","text":"എബ്രാ. 12:6","reference":{"chapter":3,"verse":12}},{"noteId":8,"caller":"+","text":"അവൾ, വിവക്ഷിക്കുന്നത് ജ്ഞാനം","reference":{"chapter":3,"verse":14}},{"noteId":9,"caller":"+","text":"യാക്കോ. 4:6; 1 പത്രോ. 5:5","reference":{"chapter":3,"verse":34}}]},"thisChapterLink":"/api/mal_bib/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}