{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_bib","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"0779a8d526ec7ab3a8f6f2d92fa1dee6c63a9df2883af973dbb429592e73a01c","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["ലെമുവേൽ രാജാവിന്റെ",{"noteId":59},"സൂക്തങ്ങൾ—അദ്ദേഹത്തിന്റെ മാതാവ് അഭ്യസിപ്പിച്ച പ്രചോദനാത്മക സൂക്തങ്ങൾ."]},{"type":"verse","number":2,"content":[{"text":"എന്റെ മകനേ, ശ്രദ്ധിക്കൂ. എന്റെ ഉദരത്തിൽ ഉരുവായ എൻമകനേ, ശ്രദ്ധിക്കൂ.","poem":1},{"text":"എന്റെ പ്രാർഥനകളുടെ സാഫല്യമായ എൻമകനേ, ശ്രദ്ധിക്കൂ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"നിന്റെ ഊർജം സ്ത്രീകൾക്കുവേണ്ടി ചെലവഴിക്കരുത്,","poem":1},{"text":"നിന്റെ ഓജസ്സ് രാജാക്കന്മാരെ നശിപ്പിക്കുന്നവർക്കു നൽകരുത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ലെമുവേലേ, ഇതു രാജാക്കന്മാർക്കു ചേർന്നതല്ല,","poem":1},{"text":"സുരാപാനം രാജാക്കന്മാർക്കനുചിതം,","poem":2},{"lineBreak":true},{"text":"മദ്യപാനം ഭരണാധിപർക്കു ഭൂഷണമല്ല,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവർ മദ്യപിച്ചിട്ട് നിയമം വിസ്മരിക്കുകയും","poem":1},{"text":"പീഡിതരുടെ അവകാശങ്ങൾ അപഹരിക്കാതിരിക്കുകയുംചെയ്യട്ടെ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"നശിച്ചുകൊണ്ടിരിക്കുന്നവർക്കു മദ്യവും","poem":1},{"text":"തീവ്രയാതന അനുഭവിക്കുന്നവർക്കു വീഞ്ഞും പകരൂ!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവർ പാനംചെയ്യട്ടെ, ദാരിദ്ര്യം മറന്നുപോകട്ടെ;","poem":1},{"text":"തങ്ങളുടെ അരിഷ്ടത ഓർക്കാതെയുമിരിക്കട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"സ്വയം ശബ്ദമുയർത്താൻ കഴിയാത്തവർക്കുവേണ്ടി സംസാരിക്കുക,","poem":1},{"text":"അനാഥരുടെ അവകാശങ്ങൾ സംരക്ഷിക്കുന്നതിനുവേണ്ടിത്തന്നെ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ശബ്ദമുയർത്തുക, നീതിയുക്തമായ തീർപ്പുകൾ പുറപ്പെടുവിക്കുക;","poem":1},{"text":"ദരിദ്രരുടെയും അഗതികളുടെയും അവകാശങ്ങൾക്കായി നിലകൊള്ളുക.","poem":2}]},{"type":"verse","number":10,"content":[{"noteId":60},{"text":"ചാരുശീലയാം പത്നിയെ കണ്ടെത്താൻ ആർക്കു കഴിയും?","poem":1},{"text":"അവളുടെ മൂല്യം മാണിക്യത്തെക്കാൾ എത്രയോ അധികം.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അവളുടെ ഭർത്താവ് അവളിൽ സമ്പൂർണ വിശ്വാസം അർപ്പിച്ചിരിക്കുന്നു","poem":1},{"text":"അവന് മൂല്യവത്തായ ഒന്നിനും കുറവില്ല.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവളുടെ ജീവിതകാലമെല്ലാം","poem":1},{"text":"അവൾ അയാൾക്കു തിന്മയല്ല, നന്മതന്നെ വരുത്തുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അവൾ കമ്പിളി, ചണം എന്നിവ ശേഖരിച്ച്","poem":1},{"text":"ചുറുചുറുക്കോടെ സ്വന്തം കൈകൾകൊണ്ട് അധ്വാനിക്കുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവൾ വ്യാപാരക്കപ്പൽപോലെയാണ്","poem":1},{"text":"വിദൂരതയിൽനിന്ന് അവൾ തന്റെ ഭക്ഷണം കൊണ്ടുവരുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഇരുട്ടൊഴിയുന്നതിനുമുമ്പുതന്നെ അവൾ ഉണരുന്നു","poem":1},{"text":"അവളുടെ കുടുംബത്തിനു ഭക്ഷണവും","poem":2},{"lineBreak":true},{"text":"വേലക്കാരികൾക്ക് അവരുടെ ഓഹരിയും ഒരുക്കുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അവൾ ഒരു വയലിൽ കണ്ണുപതിപ്പിക്കുകയും അതു വാങ്ങുകയുംചെയ്യുന്നു;","poem":1},{"text":"അവളുടെ സമ്പാദ്യംകൊണ്ടൊരു മുന്തിരിത്തോപ്പ് നട്ടുപിടിപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവൾ തന്റെ അര മുറുക്കി കഠിനാധ്വാനം ചെയ്യുന്നു;","poem":1},{"text":"അവളുടെ കരങ്ങൾ അധ്വാനത്തിനു ശക്തം.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"തന്റെ വ്യാപാരം ആദായകരമെന്ന് അവൾ ഉറപ്പുവരുത്തുന്നു,","poem":1},{"text":"അവളുടെ വിളക്ക് രാത്രിയിൽ അണയുന്നില്ല.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"തന്റെ കരത്തിൽ അവൾ നെയ്ത്തുകോൽ പിടിച്ചിരിക്കുന്നു","poem":1},{"text":"അവളുടെ കൈവിരലുകൾ തക്ലിയിൽ പിടിച്ചിട്ടുണ്ട്.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അവൾ തന്റെ കൈകൾ ദരിദ്രർക്കായി തുറക്കുന്നു","poem":1},{"text":"സഹായം അർഹിക്കുന്നവർക്കുവേണ്ടി തന്റെ കൈകൾ നീട്ടുന്നു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ഹിമകാലം വരുമ്പോൾ, തന്റെ കുടുംബാംഗങ്ങളെയോർത്തവൾ ഭയക്കുന്നില്ല;","poem":1},{"text":"കാരണം അവരെല്ലാം രക്താംബരം ധരിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"അവൾ തന്റെ കിടക്കയ്ക്കു പരവതാനി ഉണ്ടാക്കുന്നു;","poem":1},{"text":"മേൽത്തരമായ ചണനൂലും ഊതനൂലും അവൾ അണിഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"നഗരകവാടത്തിൽ അവളുടെ ഭർത്താവ് ബഹുമാനിതനാണ്,","poem":1},{"text":"ദേശത്തിലെ നേതാക്കന്മാരോടൊപ്പം അദ്ദേഹം ഇരിപ്പിടം പങ്കിടുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അവൾ പരുത്തിനൂൽവസ്ത്രങ്ങൾ നിർമിക്കുകയും വിൽക്കുകയും","poem":1},{"text":"അരക്കച്ചയുണ്ടാക്കി വിൽപ്പനയ്ക്കായി വ്യാപാരികളെ ഏൽപ്പിക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"അവൾ ബലവും ബഹുമാനവും അണിഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"അവൾ ഭാവിയെ നോക്കി പുഞ്ചിരിതൂകുന്നു.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"അവൾ ജ്ഞാനത്തോടെ സംസാരിക്കുന്നു,","poem":1},{"text":"അവളുടെ നാവിൽ വിശ്വസനീയമായ ഉപദേശങ്ങളുണ്ട്.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"തന്റെ കുടുംബത്തിലെ സകലകാര്യങ്ങളും അവൾ സസൂക്ഷ്മം നിരീക്ഷിക്കുന്നു.","poem":1},{"text":"അലസതയിൽ നേടിയ ആഹാരം അവൾ ഭക്ഷിക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"അവളുടെ മക്കൾ എഴുന്നേറ്റ് അനുഗ്രഹിക്കപ്പെട്ടവൾ എന്ന് അവളെ പുകഴ്ത്തുന്നു;","poem":1},{"text":"അവളുടെ ഭർത്താവും അവളെ പുകഴ്ത്തുന്നു:","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“സദ്ഗുണങ്ങളുള്ള ധാരാളം വനിതകളുണ്ട്,","poem":1},{"text":"എന്നാൽ അവരെയെല്ലാവരെക്കാളും നീ ശ്രേഷ്ഠയാണ്.”","poem":2}]},{"type":"verse","number":30,"content":[{"text":"വശ്യത വഞ്ചനാപരമാണ്, സൗന്ദര്യം നൈമിഷികവുമാണ്;","poem":1},{"text":"എന്നാൽ യഹോവയെ ഭയപ്പെടുന്ന വനിത പ്രശംസിക്കപ്പെടും.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"അവളുടെ അധ്വാനത്തിന്റെ പ്രതിഫലം അവൾക്കു നൽകുക,","poem":1},{"text":"അവളുടെ പ്രവൃത്തികൾ നഗരകവാടങ്ങളിൽ പ്രകീർത്തിക്കപ്പെടട്ടെ.","poem":2}]}],"footnotes":[{"noteId":59,"caller":"+","text":"അഥവാ, മസ്സായിലെ രാജാവായ ലെമുവേൽ","reference":{"chapter":31,"verse":1}},{"noteId":60,"caller":"+","text":"വാ. 10–31, ഓരോ വാക്യവും എബ്രായ അക്ഷരമാലയിലെ ക്രമമനുസരിച്ചുള്ള ഓരോ അക്ഷരത്തിൽ ആരംഭിക്കുന്നു.","reference":{"chapter":31,"verse":10}}]},"thisChapterLink":"/api/mal_bib/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}