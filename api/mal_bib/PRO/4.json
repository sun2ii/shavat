{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_bib","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"0779a8d526ec7ab3a8f6f2d92fa1dee6c63a9df2883af973dbb429592e73a01c","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":4,"content":[{"type":"heading","content":["ജ്ഞാനം സർവോന്നതം"]},{"type":"verse","number":1,"content":[{"text":"എന്റെ കുഞ്ഞുങ്ങളേ,","poem":1},{"noteId":10},{"text":"പിതാവിന്റെ നിർദേശങ്ങൾ ശ്രവിക്കുക;","poem":1},{"text":"അതിൽ ശ്രദ്ധനൽകി വിവേചനശക്തി കൈവരിക്കുക.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"കാരണം ഞാൻ നിനക്കു സദുപദേശം നൽകുന്നു,","poem":1},{"text":"എന്റെ അഭ്യസനം നിരാകരിക്കരുത്.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ഞാനും എന്റെ പിതാവിനു മകനും","poem":1},{"text":"മാതാവിന്റെ ഏക ഓമനസന്താനവും ആയിരുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"എന്റെ പിതാവ് എന്നെ പഠിപ്പിച്ച് എന്നോട് ഇപ്രകാരം പറഞ്ഞു:","poem":1},{"text":"“എന്റെ വാക്കുകൾ നീ ഹൃദയപൂർവം സ്വീകരിക്കുക;","poem":2},{"lineBreak":true},{"text":"എന്റെ കൽപ്പനകൾ പാലിച്ചാൽ നീ ജീവിക്കും.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ജ്ഞാനം നേടുക, വിവേകം ആർജിക്കുക;","poem":1},{"text":"എന്റെ വാക്കുകൾ വിസ്മരിക്കുകയോ അവയിൽനിന്നു വ്യതിചലിക്കുകയോ അരുത്.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ജ്ഞാനത്തെ ഉപേക്ഷിക്കരുത്, അവൾ നിന്നെ സംരക്ഷിക്കും;","poem":1},{"text":"അവളെ സ്നേഹിക്കുക, അവൾ നിനക്കു കാവൽനിൽക്കും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ജ്ഞാനം പരമപ്രധാനമാണ്; ആകയാൽ നീ ജ്ഞാനം കൈവരിക്കുക.","poem":1},{"text":"നിനക്കുള്ളതെല്ലാം ചെലവഴിച്ചിട്ടായാലും","poem":2},{"noteId":11},{"text":"അറിവ് സമ്പാദിക്കുക.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവളെ","poem":1},{"noteId":12},{"text":"താലോലിക്കുക, അവൾ നിന്നെ ഉയർത്തും;","poem":1},{"text":"അവളെ ആലിംഗനംചെയ്യുക, അവൾ നിന്നെ ആദരിക്കും.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവൾ നിന്റെ ശിരസ്സിന് അഴകേകുന്ന ഒരു ലതാമകുടം അണിയിക്കുകയും","poem":1},{"text":"ശോഭയുള്ള കിരീടം നിനക്ക് ഉപഹാരമായി നൽകുകയും ചെയ്യും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"എന്റെ കുഞ്ഞേ, എന്റെ വാക്കുകൾ ശ്രദ്ധിച്ച് അവ അംഗീകരിക്കുക,","poem":1},{"text":"എന്നാൽ നീ ദീർഘായുസ്സുള്ള വ്യക്തിയായിരിക്കും.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ഞാൻ നിന്നെ ജ്ഞാനമാർഗത്തിലേക്കു നയിക്കുന്നു","poem":1},{"text":"നേരായ പാതകളിൽ നിന്നെ നടത്തുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"നീ നടക്കുമ്പോൾ നിന്റെ കാലടികൾക്കു തടസ്സം നേരിടുകയില്ല;","poem":1},{"text":"ഓടുമ്പോൾ, നീ ഇടറിവീഴുകയുമില്ല.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ശിക്ഷണം മുറുകെപ്പിടിക്കുക, അതിനെ കൈവെടിയരുത്;","poem":1},{"text":"അതിനെ സംരക്ഷിക്കുക, കാരണം അതാകുന്നു നിന്റെ ജീവൻ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ദുഷ്ടരുടെ വഴിയിൽ നീ പ്രവേശിക്കരുത്","poem":1},{"text":"ദുർമാർഗികളുടെ പാതയിൽ നീ സഞ്ചരിക്കുകയുമരുത്.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അത് ഒഴിവാക്കുക, ആ വഴിയിൽക്കൂടി സഞ്ചരിക്കരുത്;","poem":1},{"text":"അത് വിട്ടൊഴിഞ്ഞ് നിന്റെ ലക്ഷ്യത്തിലേക്കു കുതിക്കുക.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"കാരണം അകൃത്യംചെയ്യുന്നതുവരെ അവർക്ക് ഉറക്കംവരികയില്ല;","poem":1},{"text":"ആരെയെങ്കിലും വീഴ്ത്തിയില്ലെങ്കിൽ അവരെ സുഖനിദ്ര കൈവിടുന്നു,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവർ ദുഷ്ടതയുടെ ആഹാരം ഭക്ഷിക്കുന്നു","poem":1},{"text":"അതിക്രമത്തിന്റെ വീഞ്ഞു പാനംചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"നീതിനിഷ്ഠരുടെ പാത അരുണോദയത്തിലെ പ്രഭപോലെയാകുന്നു,","poem":1},{"text":"അതു നട്ടുച്ചവരെ അധികമധികമായി പ്രശോഭിച്ചുകൊണ്ടിരിക്കും.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"എന്നാൽ ദുഷ്ടരുടെ പാതകൾ ഘോരാന്ധകാരംപോലെയാണ്;","poem":1},{"text":"ഏതിൽ തട്ടിവീഴുമെന്ന് അവർ അറിയുന്നില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"എന്റെ കുഞ്ഞേ, എന്റെ വാക്കുകൾ സശ്രദ്ധം ശ്രവിക്കുക;","poem":1},{"text":"എന്റെ മൊഴികൾക്കു ചെവിചായ്‌ക്കുക.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവ നിന്റെ കൺമുമ്പിൽനിന്നും മറയാൻ അനുവദിക്കരുത്,","poem":1},{"text":"അവ നിന്റെ ഹൃദയത്തിൽത്തന്നെ സൂക്ഷിക്കുക;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"കാരണം, കണ്ടെത്തുന്നവർക്ക് അവ ജീവനും","poem":1},{"text":"അവരുടെ ശരീരംമുഴുവൻ ആരോഗ്യവും നൽകുന്നു.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"എല്ലാറ്റിനുമുപരി നിന്റെ ഹൃദയത്തെ സംരക്ഷിക്കുക,","poem":1},{"text":"കാരണം അതിൽനിന്നാണ് ജീവന്റെ ഉറവ ഉത്ഭവിക്കുന്നത്.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"വഞ്ചന നിന്റെ വായിൽനിന്ന് ഒഴിവാക്കുക;","poem":1},{"text":"ദുർഭാഷണത്തിൽനിന്നു നിന്റെ അധരങ്ങളെ അകറ്റിനിർത്തുക.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"നിന്റെ ദൃഷ്ടികൾ ഋജുവായിരിക്കട്ടെ;","poem":1},{"text":"നിന്റെ കണ്ണുകൾ മുൻപോട്ടുതന്നെ പതിപ്പിക്കുക.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"നിന്റെ പാദങ്ങൾക്കു പാത നിരപ്പാക്കുക","poem":1},{"noteId":13},{"text":"അപ്പോൾ നിന്റെ വഴികളെല്ലാം സുസ്ഥിരമായിരിക്കും.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"നീ വലത്തോട്ടോ ഇടത്തോട്ടോ വ്യതിചലിക്കരുത്;","poem":1},{"text":"നിന്റെ കാലുകൾ തിന്മയിൽനിന്ന് ഒഴിഞ്ഞിരിക്കട്ടെ.","poem":2}]}],"footnotes":[{"noteId":10,"caller":"+","text":"മൂ.ഭാ. എന്റെ മകനേ; വാ. 10, 20 കാണുക","reference":{"chapter":4,"verse":1}},{"noteId":11,"caller":"+","text":"അഥവാ, മറ്റുള്ളതെന്തു ചെയ്താലും","reference":{"chapter":4,"verse":7}},{"noteId":12,"caller":"+","text":"അവൾ, വിവക്ഷിക്കുന്നത് ജ്ഞാനം","reference":{"chapter":4,"verse":8}},{"noteId":13,"caller":"+","text":"അഥവാ, ആലോചന നൽകുക","reference":{"chapter":4,"verse":26}}]},"thisChapterLink":"/api/mal_bib/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}