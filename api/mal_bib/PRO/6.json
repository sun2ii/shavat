{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_bib","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"0779a8d526ec7ab3a8f6f2d92fa1dee6c63a9df2883af973dbb429592e73a01c","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":6,"content":[{"type":"heading","content":["മടയരാകാതിരിക്കുക"]},{"type":"verse","number":1,"content":[{"text":"എന്റെ കുഞ്ഞേ,","poem":1},{"noteId":18},{"text":"നീ അയൽവാസിക്കുവേണ്ടി ജാമ്യം നിൽക്കുകയോ","poem":1},{"text":"അന്യരുടെ ബാധ്യതകൾക്കുവേണ്ടി കൈയൊപ്പുചാർത്തുകയോ ചെയ്തിട്ടുണ്ടെങ്കിൽ,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"നിന്റെ സംസാരത്താൽ നീ കെണിയിലകപ്പെട്ടു,","poem":1},{"text":"നിന്റെ അധരങ്ങളിലെ വാക്കുകളാൽ നീ പിടിക്കപ്പെട്ടു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"എന്റെ കുഞ്ഞേ, നിന്നെത്തന്നെ സ്വതന്ത്രനാക്കാൻ നീ ഇപ്രകാരം ചെയ്യുക,","poem":1},{"text":"നീ നിന്റെ അയൽവാസിയുടെ കൈകളിൽ വീണുപോയല്ലോ:","poem":2},{"text":"നീ ക്ഷീണിതനാകുന്നതുവരെ അപേക്ഷിക്കുക,","poem":1},{"noteId":19},{"text":"(ഉത്തരം കിട്ടുംവരെ) നിന്റെ അയൽവാസിക്കു വിശ്രമം നൽകയുമരുത്!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"നിന്റെ കണ്ണുകൾക്ക് ഉറക്കവും","poem":1},{"text":"കൺപോളകൾക്കു മയക്കവും കൊടുക്കരുത്.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"കലമാൻ നായാട്ടുകാരന്റെ കൈയിൽനിന്നും","poem":1},{"text":"പക്ഷികൾ വേട്ടക്കാരന്റെ കുടുക്കിൽനിന്നും രക്ഷപ്പെടുന്നതുപോലെ, നിന്നെത്തന്നെ സ്വതന്ത്രനാക്കുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ഹേ മടിയാ, നീ ഉറുമ്പുകളുടെ അടുത്തു പോകുക;","poem":1},{"text":"അതിന്റെ പ്രവൃത്തികൾ നിരീക്ഷിച്ച് ജ്ഞാനിയാകുക!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവയ്ക്ക് അധിപതികളോ","poem":1},{"text":"മേൽനോട്ടക്കാരോ ഭരണംനടത്തുന്നവരോ ഇല്ല,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"എന്നിട്ടും അവ വേനൽക്കാലത്തു ഭക്ഷ്യവസ്തുക്കൾ സംഭരിക്കുന്നു","poem":1},{"text":"കൊയ്ത്തുകാലത്ത് ഭക്ഷണം സമാഹരിക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"കുഴിമടിയാ, എത്രനാൾ നീ ഇങ്ങനെ മടിപിടിച്ചുകിടക്കും?","poem":1},{"text":"എപ്പോഴാണ് നീ ഉറക്കം വെടിഞ്ഞുണരുന്നത്?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ഒരൽപ്പം ഉറക്കം, ഒരൽപ്പം മയക്കം;","poem":1},{"text":"ഒരൽപ്പനേരംകൂടി കൈകൾ കെട്ടിപ്പിണച്ചുള്ള വിശ്രമം,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അങ്ങനെ ദാരിദ്ര്യം കൊള്ളക്കാരെപ്പോലെ നിന്റെമേൽ ചാടിവീഴും","poem":1},{"text":"ദുർഭിക്ഷത ഒരു ആയുധപാണിയെപ്പോലെ നിന്നെ ആക്രമിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"വഷളത്തവും ദുഷ്ടതയും പ്രവർത്തിക്കുന്നവർ,","poem":1},{"text":"അധരങ്ങളിൽ വക്രതയുമായി ചുറ്റിനടക്കുന്നു,","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"അവർ കണ്ണിറുക്കിക്കാട്ടുന്നു,","poem":2},{"lineBreak":true},{"text":"കാലുകൾകൊണ്ട് ആംഗ്യം കാട്ടുകയും","poem":2},{"lineBreak":true},{"text":"വിരലുകൾ ചലിപ്പിക്കുകയും ചെയ്യുന്നു,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"അവർ വഞ്ചനനിറഞ്ഞ ഹൃദയംകൊണ്ട് കുടിലതന്ത്രങ്ങൾ ആവിഷ്കരിക്കുന്നു—","poem":2},{"lineBreak":true},{"text":"അവർ സദാ കലഹം ഇളക്കിവിടുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അങ്ങനെ ക്ഷണനേരംകൊണ്ട് അവർ ദുരന്തത്തിന് ഇരയാകുന്നു;","poem":1},{"text":"പരിഹാരമില്ലാതെ അവർ ക്ഷണത്തിൽ തകർക്കപ്പെടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":["യഹോവ വെറുക്കുന്ന ആറു വസ്തുതകളുണ്ട്, ഏഴെണ്ണം അവിടത്തേക്ക് അറപ്പാകുന്നു:"]},{"type":"verse","number":17,"content":["അഹന്തനിറഞ്ഞ കണ്ണ്, വ്യാജംപറയുന്ന നാവ്, നിരപരാധിയുടെ രക്തം ചൊരിയുന്ന കൈകൾ,"]},{"type":"verse","number":18,"content":["ദുരുപായം മെനയുന്ന ഹൃദയം, അകൃത്യത്തിലേക്ക് ദ്രുതഗതിയിൽ പായുന്ന കാലുകൾ,"]},{"type":"verse","number":19,"content":["നുണമാത്രം പറഞ്ഞുകൂട്ടുന്ന കള്ളസാക്ഷി, സഹോദരങ്ങൾക്കിടയിൽ ഭിന്നത വളർത്തുന്ന മനുഷ്യനുംതന്നെ."]},{"type":"heading","content":["വ്യഭിചാരത്തെപ്പറ്റിയുള്ള മുന്നറിയിപ്പ്"]},{"type":"verse","number":20,"content":[{"text":"എന്റെ കുഞ്ഞേ, നിന്റെ പിതാവിന്റെ കൽപ്പനകൾ പ്രമാണിക്കുക","poem":1},{"text":"നിന്റെ മാതാവിന്റെ ഉപദേശം ഉപേക്ഷിക്കുകയും ചെയ്യരുത്.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവ എപ്പോഴും നിന്റെ ഹൃദയത്തോടു ചേർത്തുബന്ധിക്കുക;","poem":1},{"text":"അവ നിന്റെ കഴുത്തിനുചുറ്റും ഉറപ്പിക്കുക.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"നീ നടക്കുമ്പോൾ അവ നിനക്കു വഴികാട്ടും;","poem":1},{"text":"നീ ഉറങ്ങുമ്പോൾ അവ നിനക്കു കാവലാളായിരിക്കും;","poem":2},{"lineBreak":true},{"text":"നീ ഉണരുമ്പോൾ അവ നിന്നെ ഉപദേശിക്കും.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"കാരണം ഈ കൽപ്പന ഒരു ദീപവും","poem":1},{"text":"ഈ ഉപദേശം ഒരു പ്രകാശവും ആകുന്നു,","poem":2},{"text":"ശിക്ഷണത്തിനുള്ള ശാസനകൾ","poem":1},{"text":"ജീവന്റെ മാർഗംതന്നെ,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അവ നിന്നെ വ്യഭിചാരിണിയിൽനിന്നും","poem":1},{"text":"ലൈംഗികധാർമികതയില്ലാത്തവളുടെ മധുരഭാഷണത്തിൽനിന്നും സൂക്ഷിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"അവളുടെ മേനിയഴകിനാൽ നിന്റെ ഹൃദയം ആസക്തമാകരുത്","poem":1},{"text":"അവളുടെ മോഹിപ്പിക്കുന്ന കണ്ണുകളിൽ നീ കുരുങ്ങിപ്പോകുകയും അരുത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"എന്തുകൊണ്ടെന്നാൽ, ഒരു വേശ്യനിമിത്തം നീ അപ്പനുറുക്കുകൾ ഇരക്കേണ്ടിവരും,","poem":1},{"text":"എന്നാൽ അന്യപുരുഷന്റെ ഭാര്യ നിന്റെ ജീവനെ മൊത്തമായിത്തന്നെ ഇരയാക്കുന്നു.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ഒരു പുരുഷന് തന്റെ വസ്ത്രം കത്തിയെരിയാത്തവിധം","poem":1},{"text":"തന്റെ മടിത്തട്ടിലേക്ക് തീ കോരിയിടാൻ കഴിയുമോ?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ഒരു മനുഷ്യന് തന്റെ പാദങ്ങൾക്കു പൊള്ളൽ ഏൽപ്പിക്കാതെ","poem":1},{"text":"എരിയുന്ന കനലിന്മേൽ നടക്കാൻ കഴിയുമോ?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"അന്യപുരുഷന്റെ ഭാര്യയുമായി കിടക്ക പങ്കിടുന്നവന്റെ ഗതിയും ഇതുതന്നെയായിരിക്കും;","poem":1},{"text":"അവളെ സ്പർശിക്കുന്ന ഒരുവനും ശിക്ഷിക്കപ്പെടാതെ പോകുന്നില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"പട്ടിണിമൂലം, വിശപ്പടക്കാൻ മോഷ്ടിക്കുന്നവനെ","poem":1},{"text":"ആരുംതന്നെ നിന്ദിക്കുകയില്ല.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"പിടിക്കപ്പെടുകയാണെങ്കിൽ അയാൾ ഏഴിരട്ടി മടക്കിക്കൊടുക്കണം,","poem":1},{"text":"മോഷണമുതലിന്റെ മതിപ്പുമൂല്യം തന്റെ ഭവനത്തിലുള്ളതെല്ലാംകൂടി മതിക്കപ്പെടുകയാണെങ്കിലും, കൊടുത്തേമതിയാകൂ.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"എന്നാൽ വ്യഭിചാരംചെയ്യുന്ന പുരുഷനോ, തന്റെ സ്വബോധം നശിച്ചവൻതന്നെ;","poem":1},{"text":"അതു ചെയ്യുന്നവൻ ആരായാലും സ്വയം നശിപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"മർദനവും മാനഹാനിയുമാണ് അയാളുടെ ഭാഗധേയം,","poem":1},{"text":"അയാളുടെ നിന്ദ ഒരിക്കലും തുടച്ചുമാറ്റപ്പെടുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"അസൂയ ഒരു ഭർത്താവിന്റെ കോപത്തെ ഉദ്ദീപിപ്പിക്കുന്നു,","poem":1},{"text":"പ്രതികാരദിവസത്തിൽ അവൻ യാതൊരുവിധ കനിവും കാണിക്കുകയില്ല.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ഈ കാര്യത്തിൽ അവൻ യാതൊരുവിധ നഷ്ടപരിഹാരവും സ്വീകരിക്കുകയില്ല;","poem":1},{"text":"അത് എത്ര ഭീമമായത് ആയിരുന്നാലും അവൻ ആ കോഴ സ്വീകരിക്കുകയില്ല.","poem":2}]}],"footnotes":[{"noteId":18,"caller":"+","text":"മൂ.ഭാ. എന്റെ മകനേ","reference":{"chapter":6,"verse":1}},{"noteId":19,"caller":"+","text":"അഥവാ, പോയി നിന്നെത്തന്നെ വിനീതമാക്കുക.","reference":{"chapter":6,"verse":3}}]},"thisChapterLink":"/api/mal_bib/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}