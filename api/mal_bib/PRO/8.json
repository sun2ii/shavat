{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_bib","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"0779a8d526ec7ab3a8f6f2d92fa1dee6c63a9df2883af973dbb429592e73a01c","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":8,"content":[{"type":"heading","content":["ജ്ഞാനത്തിന്റെ വിളംബരം"]},{"type":"verse","number":1,"content":[{"text":"ജ്ഞാനമായവൾ വിളംബരം നടത്തുന്നില്ലേ?","poem":1},{"text":"വിവേകമുള്ളവൾ ഉച്ചൈസ്തരം ഘോഷിക്കുന്നില്ലേ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"വീഥികളുടെ സംഗമസ്ഥാനത്ത്,","poem":1},{"text":"പാതയോരത്തെ ഉയർന്നസ്ഥാനത്ത് അവൾ നിലയുറപ്പിക്കുന്നു;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"നഗരകവാടത്തിനരികിൽ,","poem":1},{"text":"അതിന്റെ പ്രവേശനത്തിനരികെ നിന്നുകൊണ്ട്, അവൾ ഉറക്കെ വിളിച്ചുപറയുന്നു:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“അല്ലയോ മനുഷ്യരേ, ഞാൻ നിങ്ങളോട് വിളംബരംചെയ്യുന്നു;","poem":1},{"text":"മനുഷ്യവർഗത്തോടെല്ലാം ഞാൻ എന്റെ സ്വരം ഉയർത്തുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ലളിതമാനസരേ, കാര്യപ്രാപ്തിയുള്ളവരാകുക;","poem":1},{"text":"ബുദ്ധിഹീനരായവരേ, വിവേകമുള്ളവരാകുക.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ശ്രദ്ധിക്കുക, എനിക്കു ശ്രേഷ്ഠകരമായ വസ്തുതകൾ പ്രസ്താവിക്കാനുണ്ട്;","poem":1},{"text":"നീതിയുക്തമായതു സംസാരിക്കാൻ ഞാൻ എന്റെ അധരങ്ങൾ തുറക്കുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"എന്റെ വായ് സത്യം സംസാരിക്കുന്നു,","poem":1},{"text":"തിന്മ എന്റെ അധരങ്ങൾക്ക് അറപ്പാണ്.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"എന്റെ വായിലെ വാക്കുകളെല്ലാം നീതിയുള്ളവയാണ്;","poem":1},{"text":"വക്രതയോ വൈകൃതമോ നിറഞ്ഞ ഒന്നുംതന്നെ അവയിലില്ല.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"വിവേകികൾക്ക് എന്റെ വാക്കുകൾ സുവ്യക്തമാണ്;","poem":1},{"text":"പരിജ്ഞാനമുള്ളവർക്ക് അവയെല്ലാം വക്രതയില്ലാത്തതായിരിക്കും.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"എന്റെ ശിക്ഷണം വെള്ളിക്കുപകരമായും","poem":1},{"text":"പരിജ്ഞാനം മേൽത്തരം തങ്കത്തിലും ശ്രേഷ്ഠമായും സ്വീകരിക്കുക,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ജ്ഞാനം മാണിക്യത്തെക്കാൾ അമൂല്യമാണ്;","poem":1},{"text":"നീ അഭിലഷിക്കുന്നതൊന്നും അതിനു തുല്യമാകുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ജ്ഞാനം എന്ന ഞാൻ വിവേകത്തോടൊപ്പം വസിക്കുന്നു;","poem":1},{"text":"പരിജ്ഞാനവും വിവേചനശക്തിയും എന്റെ അധീനതയിലുണ്ട്.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അധർമത്തെ വെറുക്കുക എന്നതാണ് യഹോവാഭക്തി;","poem":1},{"text":"അഹന്തയും അഹങ്കാരവും","poem":2},{"lineBreak":true},{"text":"ദുഷ്കൃത്യങ്ങളും വൈകൃതഭാഷണവും ഞാൻ വെറുക്കുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ബുദ്ധിയുപദേശവും ഉത്തമ നീതിനിർവഹണവും എന്റേതാണ്;","poem":1},{"text":"എനിക്കു വിവേകമുണ്ട്, എനിക്ക് ശക്തിയുമുണ്ട്.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഞാൻ മുഖാന്തരം രാജാക്കന്മാർ വാഴുന്നു","poem":1},{"text":"അധിപതികൾ നീതിയുക്തമായ ഉത്തരവുകൾ പുറപ്പെടുവിക്കുന്നു;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ഞാൻ മുഖാന്തരമാണ് പ്രഭുക്കന്മാരും","poem":1},{"text":"നാടുവാഴികളും ഭരണം നിർവഹിക്കുന്നത്.","poem":2},{"noteId":23}]},{"type":"verse","number":17,"content":[{"text":"എന്നെ സ്നേഹിക്കുന്നവരെ ഞാനും സ്നേഹിക്കുന്നു,","poem":1},{"text":"എന്നെ അന്വേഷിക്കുന്നവർ എന്നെ കണ്ടെത്തും, നിശ്ചയം.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"എന്റെ അധീനതയിൽ ധനവും ബഹുമാനവും,","poem":1},{"text":"അനശ്വരസമ്പത്തും അഭിവൃദ്ധിയുമുണ്ട്.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"എന്റെ ഫലം തങ്കത്തെക്കാൾ ശ്രേഷ്ഠം;","poem":1},{"text":"എന്റെ വരുമാനം സംശുദ്ധവെള്ളിയെ പിന്നിലാക്കും.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ഞാൻ നീതിമാർഗത്തിൽ സഞ്ചരിക്കുന്നു,","poem":1},{"text":"ന്യായത്തിന്റെ പാതയിൽത്തന്നെ തുടരുന്നു,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അതുകൊണ്ട് എന്നെ സ്നേഹിക്കുന്നവർക്ക് സമ്പത്ത് അവകാശമായിനൽകുകയും","poem":1},{"text":"അവരുടെ ഭണ്ഡാരങ്ങളെ നിറയ്ക്കുകയും ചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“യഹോവ തന്റെ പ്രവൃത്തികളുടെ ആരംഭമായി എന്നെ സൃഷ്ടിച്ചു,","poem":1},{"text":"തന്റെ പുരാതന പ്രവൃത്തികൾക്കും മുമ്പേതന്നെ;","poem":2}]},{"type":"verse","number":23,"content":[{"text":"പണ്ടേക്കുപണ്ടേ ഞാൻ സൃഷ്ടിക്കപ്പെട്ടു,","poem":1},{"text":"ആരംഭത്തിൽ ഭൗമോൽപ്പത്തിക്കും മുൻപുതന്നെ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"സമുദ്രങ്ങൾ ഉളവാകുന്നതിനുമുമ്പുതന്നെ എനിക്കു ജന്മം നൽകപ്പെട്ടു,","poem":1},{"text":"ജലസമൃദ്ധമായ അരുവികൾ ഉണ്ടാകുന്നതിനും മുമ്പേതന്നെ;","poem":2}]},{"type":"verse","number":25,"content":[{"text":"പർവതങ്ങൾ ഉറപ്പിക്കപ്പെടുന്നതിനുമുമ്പ്,","poem":1},{"text":"മലകൾക്കും മുമ്പേതന്നെ എനിക്കു ജന്മം നൽകപ്പെട്ടു,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"അവിടന്ന് ഭൂമണ്ഡലത്തെയോ വയലുകളെയോ","poem":1},{"text":"ഭൂതലത്തിലെ ഏതെങ്കിലും ധൂളിയെയോ സൃഷ്ടിക്കുന്നതിനു മുമ്പേതന്നെ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"അവിടന്ന് ആകാശവിതാനത്തെ അതിന്റെ സ്ഥാനത്ത് ഉറപ്പിച്ചപ്പോൾ ഞാനവിടെ ഉണ്ടായിരുന്നു,","poem":1},{"text":"ആഴിയുടെ പരപ്പിൽ ചക്രവാളം വരച്ചപ്പോഴും,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"അവിടന്ന് മേഘങ്ങളെ ഉയരത്തിൽ സ്ഥാപിച്ചപ്പോഴും","poem":1},{"text":"അഗാധതയുടെ ഉറവുകളെ സുരക്ഷിതമായി ഉറപ്പിച്ചപ്പോഴും,","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ആഴികൾ അവിടത്തെ ആജ്ഞകൾ അതിലംഘിക്കാതിരിക്കാൻ","poem":1},{"text":"അവിടന്ന് ആഴിക്ക് അതിരിട്ടപ്പോഴും","poem":2},{"text":"അവിടന്ന് ഭൂമിയുടെ അസ്തിവാരം ഉറപ്പിച്ചപ്പോഴും,","poem":1}]},{"type":"verse","number":30,"content":[{"text":"ഒരു വിദഗ്ദ്ധശില്പിയായി, അവിടത്തെ സഹചാരിയായി ഞാൻ നിന്നു.","poem":2},{"text":"പ്രതിദിനം ഞാൻ ആനന്ദഭരിതനായിനിന്നു,","poem":1},{"text":"അവിടത്തെ സന്നിധാനത്തിൽ ആഹ്ലാദപൂർണനായി കഴിഞ്ഞു,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"അവിടന്നു സൃഷ്ടിച്ച ലോകത്തിൽ ഞാൻ എത്ര ഉല്ലാസഭരിതനായിരുന്നു","poem":1},{"text":"മനുഷ്യകുലത്തോടൊപ്പം ഞാൻ എത്രമാത്രം ആനന്ദിച്ചു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“അതുകൊണ്ട് ഇപ്പോൾ, എന്റെ കുഞ്ഞുങ്ങളേ,","poem":1},{"noteId":24},{"text":"എന്നെ ശ്രദ്ധിക്കുക;","poem":1},{"text":"എന്റെ വഴികൾ ആചരിക്കുന്നവർ അനുഗൃഹീതർ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"എന്റെ പ്രബോധനം കേട്ട് വിവേകിയാകുക;","poem":1},{"text":"അവ അവഗണിക്കരുത്.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"എന്നെ ശ്രദ്ധിക്കുന്നവർ അനുഗൃഹീതർ,","poem":1},{"text":"അനുദിനം എന്റെ പ്രവേശനകവാടത്തിൽ കാത്തുനിന്നും","poem":2},{"lineBreak":true},{"text":"എന്റെ പടിവാതിലിൽ കാവൽകാത്തുംതന്നെ.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"എന്നെ കണ്ടെത്തുന്നവർ ജീവൻ കണ്ടെത്തുകയും","poem":1},{"text":"യഹോവയിൽനിന്ന് പ്രസാദം നേടുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"എന്നിൽനിന്ന് അകന്നുപോകുന്നവർ അവർക്കുതന്നെ ദോഷംവരുത്തുന്നു;","poem":1},{"text":"എന്നെ വെറുക്കുന്നവരെല്ലാം മരണത്തെ സ്നേഹിക്കുന്നു.”","poem":2}]}],"footnotes":[{"noteId":23,"caller":"+","text":"ചി.കൈ.പ്ര. നീതിനിഷ്ഠരായ ഭരണാധികാരികൾ","reference":{"chapter":8,"verse":16}},{"noteId":24,"caller":"+","text":"മൂ.ഭാ. എന്റെ മകനേ","reference":{"chapter":8,"verse":32}}]},"thisChapterLink":"/api/mal_bib/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}