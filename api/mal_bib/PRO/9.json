{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_bib","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"0779a8d526ec7ab3a8f6f2d92fa1dee6c63a9df2883af973dbb429592e73a01c","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"heading","content":["ജ്ഞാനവും അവിവേകവും"]},{"type":"verse","number":1,"content":[{"text":"ജ്ഞാനം അവൾക്കുവേണ്ടി വീട് പണിതു;","poem":1},{"text":"ചെത്തിമിനുക്കിയ ഏഴു സ്തംഭങ്ങൾ സ്ഥാപിച്ചു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവൾ മാംസഭക്ഷണം പാകംചെയ്തു വീഞ്ഞ് തയ്യാറാക്കി;","poem":1},{"text":"അവളുടെ തീന്മേശയും ഒരുക്കിവെച്ചു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവൾ തന്റെ തോഴിമാരെ നിയോഗിച്ചു,","poem":1},{"text":"നഗരത്തിന്റെ ഉന്നതസ്ഥാനങ്ങളിൽ വിളംബരം ചെയ്യുന്നതിനുവേണ്ടി,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"“ലളിതമാനസരേ, എന്റെ ഭവനത്തിലേക്കു വരിക!”","poem":2},{"text":"ബുദ്ധിഹീനരോട് അവൾ അറിയിക്കുന്നു,","poem":1}]},{"type":"verse","number":5,"content":[{"text":"“വരിക, എന്റെ ഭക്ഷണം ആസ്വദിക്കുക,","poem":2},{"lineBreak":true},{"text":"ഞാൻ കലർത്തിവെച്ചിരിക്കുന്ന വീഞ്ഞ് പാനംചെയ്യുക.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"നിങ്ങളുടെ ഭോഷത്തം ഉപേക്ഷിച്ച് ജീവിക്കുക;","poem":1},{"text":"വിവേകപൂർണമായ മാർഗത്തിൽ സഞ്ചരിക്കുക.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"പരിഹാസിയെ തിരുത്തുന്നവർക്ക് അധിക്ഷേപം പകരമായിലഭിക്കുന്നു;","poem":1},{"text":"ദുഷ്ടരെ ശകാരിക്കുന്നവർ അവഹേളനപാത്രമാകും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"പരിഹാസികളെ ശാസിക്കരുത്, അവർ നിന്നെ വെറുക്കും;","poem":1},{"text":"ജ്ഞാനികളെ ശാസിക്കുക, അവർ നിന്നെ സ്നേഹിക്കും.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ജ്ഞാനികളെ ഉപദേശിക്കുക, അവർ അധികം ജ്ഞാനമുള്ളവരായിത്തീരും;","poem":1},{"text":"നീതിനിഷ്ഠരെ അഭ്യസിപ്പിക്കുക, അവർ വിദ്യാഭിവൃത്തി പ്രാപിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"യഹോവാഭക്തി ജ്ഞാനത്തിന്റെ ഉറവിടമാകുന്നു,","poem":1},{"text":"പരിശുദ്ധനെക്കുറിച്ചുള്ള പരിജ്ഞാനം വിവേകമാകുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ജ്ഞാനംമൂലം","poem":1},{"noteId":25},{"text":"നിന്റെ ദിനങ്ങൾ നിരവധിയായിരിക്കും,","poem":1},{"text":"നിനക്കു ദീർഘായുസ്സുണ്ടാകുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"നീ ജ്ഞാനമുള്ള വ്യക്തിയെങ്കിൽ, നിന്റെ ജ്ഞാനം നിനക്കു പ്രതിഫലംനൽകും;","poem":1},{"text":"നീ പരിഹാസിയാണെങ്കിൽ, അതിന്റെ അനന്തരഫലം നീമാത്രം അനുഭവിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ഭോഷത്തം അടക്കമില്ലാത്ത ഒരു സ്ത്രീയാണ്;","poem":1},{"text":"അവൾ ഭോഷയും വിവരംകെട്ടവളുമാണ്.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവൾ തന്റെ ഗൃഹകവാടത്തിൽ ഇരിക്കുന്നു,","poem":1},{"text":"നഗരത്തിലെ ഉന്നതസ്ഥാനത്തുള്ള ഒരു പീഠത്തിൽത്തന്നെ,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"സ്വന്തംകാര്യം അന്വേഷിച്ചു പോകുന്ന","poem":1},{"noteId":26},{"text":"പുരുഷന്മാരോട്,","poem":1},{"text":"അവൾ വിളിച്ചുപറയുന്നു,","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"“ലളിതമാനസരേ, എന്നോടൊപ്പം വരിക!”","poem":2},{"text":"വിവേകരഹിതരോടവൾ ചൊല്ലുന്നു,","poem":1}]},{"type":"verse","number":17,"content":[{"text":"“അപഹരിക്കപ്പെട്ട ജലം മധുരതരം;","poem":2},{"lineBreak":true},{"text":"ഒളിവിൽ ഭുജിക്കുന്ന ഭക്ഷണം അതിരുചികരം!”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"എന്നാൽ അവിടെ മൃതന്മാർ ഉണ്ടെന്നും","poem":1},{"text":"അവളുടെ അതിഥികൾ പാതാളത്തിന്റെ ആഴങ്ങളിലാണെന്നും അവർ അറിയുന്നില്ല.","poem":2}]}],"footnotes":[{"noteId":25,"caller":"+","text":"മൂ.ഭാ. ഞാൻ","reference":{"chapter":9,"verse":11}},{"noteId":26,"caller":"+","text":"മൂ.ഭാ. തങ്ങളുടെ പാതയിൽ നേരേ പോകുന്നവരോട്","reference":{"chapter":9,"verse":15}}]},"thisChapterLink":"/api/mal_bib/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}