{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"യഹോവേ അങ്ങ് ദൂരത്തു നിൽക്കുന്നത് എന്ത്?","poem":1},{"text":"കഷ്ടതയുടെ നാളുകളിൽ അങ്ങ് മറഞ്ഞുനിൽക്കുന്നതും എന്ത്?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ദുഷ്ടർ തങ്ങളുടെ അഹന്തയിൽ പീഡിതരെ വേട്ടയാടുന്നു,","poem":1},{"text":"അവർ വെച്ച കെണിയിൽ അവർതന്നെ വീണുപോകുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവർ തങ്ങളുടെ ഹൃദയാഭിലാഷങ്ങളിൽ പ്രശംസിക്കുന്നു;","poem":1},{"text":"ആ ദുഷ്ടർ അത്യാഗ്രഹികളെ അനുഗ്രഹിക്കുകയും യഹോവയെ അധിക്ഷേപിക്കുകയുംചെയ്യുന്നു","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവർ തങ്ങളുടെ അഹന്തയിൽ ദൈവത്തെ അന്വേഷിക്കുന്നില്ല;","poem":1},{"text":"അവരുടെ ചിന്തകളിൽ ദൈവത്തിന് ഒരു സ്ഥാനവുമില്ല.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"എന്നിട്ടും അവരുടെ മാർഗങ്ങളിൽ എപ്പോഴും അഭിവൃദ്ധിയുണ്ടാകുന്നു;","poem":1},{"text":"അങ്ങയുടെ ന്യായവിധികൾ അവരുടെ കാഴ്ചയ്ക്ക് എത്താത്തവിധം ഉയർന്നിരിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"അവർ തങ്ങളുടെ ശത്രുക്കളെ അവജ്ഞയോടെ നോക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവർ തങ്ങളോടുതന്നെ പറയുന്നു, “ഒന്നിനുമെന്നെ ഇളക്കിമറിക്കാൻ കഴിയുകയില്ല.”","poem":1},{"text":"അവർ ശപഥംചെയ്യുന്നു, “തലമുറകളോളം എനിക്കൊരനർഥവും വരികയില്ല.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"അവരുടെ വായിൽ ശാപവും വ്യാജവും ഭീഷണിയും നിറഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"അവരുടെ നാവിൻകീഴിൽ ഉപദ്രവവും ദുഷ്ടതയും കുടിപാർക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവർ ഗ്രാമങ്ങൾക്കരികെ പതിയിരിക്കുന്നു;","poem":1},{"text":"ഒളിയിടങ്ങളിലിരുന്ന് അവർ നിരപരാധികളെ വധിക്കുന്നു.","poem":2},{"text":"അവരുടെ കണ്ണ് അഗതികളെ തെരഞ്ഞുകൊണ്ടിരിക്കുന്നു;","poem":1}]},{"type":"verse","number":9,"content":[{"text":"ഒരു സിംഹത്തെപ്പോലെ അവർ പതുങ്ങി കാത്തിരിക്കുന്നു.","poem":2},{"text":"നിസ്സഹായരെ പിടികൂടാൻ അവർ പതുങ്ങിയിരിക്കുന്നു;","poem":1},{"text":"അശരണരെ കടന്നുപിടിക്കുകയും അവരെ തങ്ങളുടെ വലയ്ക്കുള്ളിലാക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവരുടെ ഇരകളെ അവർ തകർക്കുന്നു, അവർ കുഴഞ്ഞുവീഴുന്നു;","poem":1},{"text":"അവരുടെ കരബലത്തിൻകീഴിലവർ നിലംപരിശാകുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“ദൈവം മറന്നുപോയിരിക്കുന്നു,” എന്ന് അവർ ആത്മഗതം ചെയ്യുന്നു;","poem":1},{"text":"“തിരുമുഖം മൂടിയിരിക്കുന്നു, ഒന്നും കാണുന്നില്ല,” എന്നുമവർ പറയുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"യഹോവേ, എഴുന്നേൽക്കണമേ! അല്ലയോ ദൈവമേ, തൃക്കൈ ഉയർത്തണമേ.","poem":1},{"text":"അശരണരെ ഒരിക്കലും വിസ്മരിക്കരുതേ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ദുഷ്ടർ ദൈവത്തോട് എതിർത്തുനിൽക്കുന്നത് എന്തിന്?","poem":1},{"text":"“ദൈവം ഞങ്ങളോട് കണക്കു ചോദിക്കുകയില്ല,”","poem":2},{"lineBreak":true},{"text":"എന്ന് അവർ ആത്മഗതം ചെയ്യുന്നതും എന്തുകൊണ്ട്?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"എന്നാൽ ദൈവമേ, അങ്ങ് പീഡിതരുടെ ആകുലതകൾ കാണുന്നല്ലോ;","poem":1},{"text":"അവരുടെ സങ്കടം അങ്ങ് പരിഗണിക്കുകയും അവ ഏറ്റെടുക്കുകയും ചെയ്യുന്നു.","poem":2},{"text":"അശരണർ തിരുമുമ്പിൽ അഭയംതേടുന്നു;","poem":1},{"text":"അങ്ങ് അനാഥരുടെ സഹായകൻ ആണല്ലോ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ദുഷ്ടരുടെ കൈ തകർക്കണമേ;","poem":1},{"text":"തിന്മപ്രവർത്തിക്കുന്നവരോട് അവരുടെ തിന്മയ്ക്കു കണക്കുചോദിക്കണമേ","poem":2},{"lineBreak":true},{"text":"അവർ ഉന്മൂലനംചെയ്യപ്പെടുംവരെ അവരെ പിൻതുടരണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"യഹോവ എന്നെന്നേക്കും രാജാവാകുന്നു;","poem":1},{"text":"അവിടത്തെ ദേശത്തുനിന്നും ജനതകൾ നശിച്ചുപോകും.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"യഹോവേ, അവിടന്ന് പീഡിതരുടെ അഭിലാഷങ്ങൾ കേട്ടിരിക്കുന്നു;","poem":1},{"text":"അവരുടെ കരച്ചിൽ ശ്രദ്ധിക്കുകയും അവരെ ആശ്വസിപ്പിക്കുകയും ചെയ്യണമേ,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അനാഥർക്കും പീഡിതർക്കും ന്യായം നടപ്പിലാക്കണമേ,","poem":1},{"text":"അങ്ങനെയായാൽ മൃൺമയരായ മനുഷ്യർ ഇനിയൊരിക്കലും","poem":2},{"lineBreak":true},{"text":"ആരുടെയുംമേൽ ഭീതിവരുത്തുകയില്ല.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}