{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":102,"content":[{"type":"hebrew_subtitle","content":["യഹോവയുടെമുമ്പാകെ അവശനായി ആവലാതിപറയുന്ന ഒരു പീഡിതന്റെ പ്രാർഥന, അദ്ദേഹം യഹോവയുടെമുമ്പാകെ തന്റെ സങ്കടങ്ങൾ സമർപ്പിക്കുന്നു."]},{"type":"verse","number":1,"content":[{"text":"യഹോവേ, എന്റെ പ്രാർഥന കേൾക്കണമേ;","poem":1},{"text":"സഹായത്തിനായുള്ള എന്റെ നിലവിളി തിരുമുമ്പാകെ എത്തട്ടെ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"എന്റെ ദുരിതദിനങ്ങളിൽ","poem":1},{"text":"അങ്ങയുടെ മുഖം എന്നിൽനിന്നും മറയ്ക്കരുതേ.","poem":2},{"text":"അങ്ങയുടെ ചെവി എന്നിലേക്കു ചായ്‌ക്കണമേ;","poem":1},{"text":"ഞാൻ വിളിച്ചപേക്ഷിക്കുമ്പോൾ, വേഗത്തിൽ എനിക്ക് ഉത്തരമരുളണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"എന്റെ ദിനങ്ങൾ പുകപടലംപോലെ പാറിപ്പോകുന്നു;","poem":1},{"text":"എന്റെ അസ്ഥികൾ കൽക്കരിക്കനൽപോലെ കത്തിയെരിയുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"എന്റെ ഹൃദയം പുല്ലുപോലെ നശിച്ചുണങ്ങിയിരിക്കുന്നു;","poem":1},{"text":"ഭക്ഷണം കഴിക്കാൻ ഞാൻ മറന്നുപോകുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ഉച്ചത്തിലുള്ള എന്റെ ഞരക്കംമൂലം,","poem":1},{"text":"ഞാൻ എല്ലുംതോലും ആയിത്തീർന്നിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഞാൻ മരുഭൂമിയിലെ മൂങ്ങപോലെ ആയിരിക്കുന്നു;","poem":1},{"text":"അവശിഷ്ടങ്ങൾക്കിടയിലെ മൂങ്ങപോലെതന്നെ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"എനിക്ക് ഉറക്കമില്ലാതായിത്തീർന്നിരിക്കുന്നു;","poem":1},{"text":"പുരമുകളിൽ തനിച്ചിരിക്കുന്ന ഒരു പക്ഷിയെപ്പോലെതന്നെ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ദിവസംമുഴുവനും എന്റെ ശത്രുക്കൾ എന്നെ അധിക്ഷേപിക്കുന്നു;","poem":1},{"text":"എന്നെ പരിഹസിക്കുന്നവർ എന്റെ പേരുതന്നെ ഒരു ശാപവാക്കായി ഉപയോഗിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ആഹാരംപോലെ ഞാൻ ചാരം ഭക്ഷിക്കുന്നു","poem":1},{"text":"എന്റെ പാനീയത്തിൽ ഞാൻ കണ്ണുനീർ കലർത്തുന്നു","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അങ്ങയുടെ ഉഗ്രകോപമാണ് ഇതിനെല്ലാം കാരണം;","poem":1},{"text":"അവിടന്ന് എന്നെ വലിച്ചെടുത്ത് ദൂരേക്ക് എറിഞ്ഞുകളഞ്ഞല്ലോ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"എന്റെ ദിനങ്ങളെല്ലാം സായാഹ്നനിഴൽപോലെ കഴിഞ്ഞുപോകുന്നു;","poem":1},{"text":"പുല്ലുപോലെ ഞാൻ ഉണങ്ങിപ്പോകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"എന്നാൽ യഹോവേ, അവിടന്ന് എന്നേക്കും സിംഹാസനസ്ഥനായിരിക്കുന്നു;","poem":1},{"text":"അങ്ങയുടെ ഔന്നത്യം എല്ലാ തലമുറകളിലും നിലനിൽക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അവിടന്ന് എഴുന്നേൽക്കും, സീയോനോട് കരുണകാണിക്കും;","poem":1},{"text":"അവളോട് കരുണ കാണിക്കുന്നതിനുള്ള സമയമാണിത്;","poem":2},{"lineBreak":true},{"text":"നിശ്ചയിക്കപ്പെട്ട സമയം വന്നുചേർന്നല്ലോ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അങ്ങയുടെ സേവകർക്ക് അവളിലെ കല്ലുകളോടു പ്രിയംതോന്നുന്നു;","poem":1},{"text":"അവളുടെ ധൂളിപോലും അവരിൽ അനുകമ്പ ഉയർത്തുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"രാഷ്ട്രങ്ങൾ യഹോവയുടെ നാമത്തെ ഭയപ്പെടും,","poem":1},{"text":"ഭൂമിയിലെ സകലരാജാക്കന്മാരും അവിടത്തെ മഹത്ത്വത്തെ ആദരിക്കും.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"കാരണം യഹോവ സീയോനെ പുനർനിർമിക്കുകയും","poem":1},{"text":"അവിടന്ന് തന്റെ മഹത്ത്വത്തിൽ പ്രത്യക്ഷനാകുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവിടന്ന് അനാഥരുടെ പ്രാർഥന കേൾക്കും","poem":1},{"text":"അവരുടെ യാചന അവിടന്ന് നിരാകരിക്കുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ഇത് വരുംതലമുറകൾക്കുവേണ്ടി രേഖപ്പെടുത്തട്ടെ,","poem":1},{"text":"അങ്ങനെ നാളിതുവരെ സൃഷ്ടിക്കപ്പെട്ടിട്ടില്ലാത്തവരും യഹോവയെ വാഴ്ത്തട്ടെ:","poem":2}]},{"type":"verse","number":19,"content":[{"text":"“തടവുകാരുടെ ഞരക്കം കേൾക്കുന്നതിനും","poem":1},{"text":"വധശിക്ഷയ്ക്കു വിധിക്കപ്പെട്ടവരെ മോചിപ്പിക്കുന്നതിനുംവേണ്ടി;","poem":2},{"text":"യഹോവ ഉന്നതത്തിലുള്ള തന്റെ വിശുദ്ധമന്ദിരത്തിൽനിന്ന് താഴോട്ടു നോക്കി","poem":1},{"text":"സ്വർഗത്തിൽനിന്ന് അവിടന്ന് ഭൂമിയെ വീക്ഷിച്ചു.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ജനതകളും രാജ്യങ്ങളും","poem":1},{"text":"യഹോവയെ ആരാധിക്കാൻ ഒത്തുചേരുമ്പോൾ,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"യഹോവയുടെ നാമം സീയോനിലും","poem":1},{"text":"അവിടത്തെ സ്തുതി ജെറുശലേമിലും വിളംബരംചെയ്യപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"എന്റെ ജീവിതയാത്ര പൂർത്തിയാകുന്നതിനുമുമ്പേതന്നെ അവിടന്ന് എന്റെ ബലം ക്ഷയിപ്പിച്ചു;","poem":1},{"text":"അവിടന്ന് എന്റെ നാളുകൾ വെട്ടിച്ചുരുക്കിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അതിനാൽ ഞാൻ പറഞ്ഞു:","poem":1},{"lineBreak":true},{"text":"“എന്റെ ദൈവമേ, എന്റെ ആയുസ്സിന്റെ മധ്യത്തിൽവെച്ച് എന്നെ എടുക്കരുതേ;","poem":1},{"text":"അവിടത്തെ സംവത്സരങ്ങൾ തലമുറതലമുറയായി തുടരുന്നുവല്ലോ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ആദിയിൽ അവിടന്ന് ഭൂമിക്ക് അടിസ്ഥാനമിട്ടു,","poem":1},{"text":"ആകാശവും അവിടത്തെ കൈകളുടെ പ്രവൃത്തിതന്നെ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"അവ നശിച്ചുപോകും. എന്നാൽ, അങ്ങ് നിലനിൽക്കും;","poem":1},{"text":"അവയെല്ലാം ഒരു വസ്ത്രംപോലെതന്നെ പിഞ്ചിപ്പോകും.","poem":2},{"text":"വസ്ത്രം മാറുന്നതുപോലെ അങ്ങ് അവയെ മാറ്റിക്കളയും","poem":1},{"text":"അവ പുറന്തള്ളപ്പെടും.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"എന്നാൽ അങ്ങ് സുസ്ഥിരനായി നിലകൊള്ളും;","poem":1},{"text":"അങ്ങയുടെ സംവത്സരങ്ങൾ ഒരിക്കലും അവസാനിക്കുകയുമില്ല.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"അവിടത്തെ സേവകരുടെ മക്കൾ അങ്ങയുടെ സന്നിധിയിൽ സുരക്ഷിതരായി ജീവിക്കും;","poem":1},{"text":"അവരുടെ പിൻതലമുറ തിരുമുമ്പാകെ നിലനിൽക്കും.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":27}