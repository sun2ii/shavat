{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":103,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"എൻ മനമേ, യഹോവയെ വാഴ്ത്തുക;","poem":1},{"text":"എന്റെ സർവാന്തരംഗവുമേ, അവിടത്തെ വിശുദ്ധനാമത്തെ വാഴ്ത്തുക.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"എൻ മനമേ, യഹോവയെ വാഴ്ത്തുക;","poem":1},{"text":"അവിടത്തെ ഉപകാരങ്ങളൊന്നും മറക്കരുത്—","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവിടന്നു നിന്റെ സകലപാപങ്ങളും ക്ഷമിക്കുന്നു","poem":1},{"text":"നിന്റെ സർവരോഗത്തിനും സൗഖ്യമേകുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവിടന്നു നിന്റെ ജീവനെ പാതാളത്തിൽനിന്ന്","poem":1},{"noteId":90},{"text":"വീണ്ടെടുക്കുകയും","poem":1},{"text":"നിന്നെ സ്നേഹവും മനസ്സലിവുംകൊണ്ട് മകുടമണിയിക്കുകയും ചെയ്യുന്നു,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"നിന്റെ യുവത്വം കഴുകനെപ്പോലെ നവീകരിക്കപ്പെടേണ്ടതിന്","poem":1},{"text":"അവിടന്ന് നിന്റെ ജീവിതം നന്മകൊണ്ട് സംതൃപ്തമാക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"പീഡിതരായ എല്ലാവർക്കുംവേണ്ടി","poem":1},{"text":"യഹോവ നീതിയും ന്യായവും ഉറപ്പാക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"അവിടന്നു തന്റെ വഴികളെ മോശയ്ക്കും","poem":1},{"text":"തന്റെ പ്രവൃത്തികളെ ഇസ്രായേൽജനതയ്ക്കും വെളിപ്പെടുത്തി:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"യഹോവ കരുണാമയനും ആർദ്രഹൃദയനും","poem":1},{"text":"ക്ഷമാശീലനും സ്നേഹസമ്പന്നനും ആകുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവിടന്നു സദാ കുറ്റപ്പെടുത്തുന്നില്ല,","poem":1},{"text":"അവിടത്തെ കോപം എന്നേക്കും നിലനിർത്തുകയുമില്ല.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവിടന്നു നമ്മുടെ പാപങ്ങൾക്കൊത്തവണ്ണം നമ്മെ ശിക്ഷിക്കുന്നില്ല;","poem":1},{"text":"നമ്മുടെ അനീതികൾക്കനുസൃതമായി പകരം ചെയ്യുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ആകാശം ഭൂമിക്കുമേൽ ഉയർന്നിരിക്കുന്നതുപോലെ,","poem":1},{"text":"തന്നെ ഭയപ്പെടുന്നവരോടുള്ള അവിടത്തെ സ്നേഹം ഉന്നതമാണ്.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"കിഴക്ക് പടിഞ്ഞാറിൽനിന്നും അകന്നിരിക്കുന്നത്ര അകലത്തിൽ,","poem":1},{"text":"അവിടന്ന് നമ്മുടെ ലംഘനങ്ങളെ നമ്മിൽനിന്നും അകറ്റിയിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ഒരു പിതാവിനു തന്റെ മക്കളോടു മനസ്സലിവു തോന്നുന്നതുപോലെതന്നെ,","poem":1},{"text":"യഹോവയ്ക്ക് തന്നെ ഭയപ്പെടുന്നവരോടു മനസ്സലിവു തോന്നുന്നു;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"കാരണം അവിടന്ന് നമ്മുടെ പ്രകൃതി അറിയുന്നു;","poem":1},{"text":"നാം പൊടിയെന്ന് അവിടന്ന് ഓർക്കുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"മനുഷ്യായുസ്സ് പുല്ലിനു സമമാകുന്നു,","poem":1},{"text":"വയലിലെ പൂപോലെ അതു തഴയ്ക്കുന്നു;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അതിന്മേൽ കാറ്റടിക്കുന്നു, അതു വിസ്മൃതമാകുന്നു,","poem":1},{"text":"അതു നിന്നയിടംപോലും പിന്നെയത് ഓർക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"എന്നാൽ, യഹോവയുടെ സ്നേഹം തന്നെ ഭയപ്പെടുന്നവരുടെമേൽ","poem":1},{"text":"നിതാന്തകാലം നിലനിൽക്കും","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ നീതി അവരുടെ മക്കളുടെ മക്കൾക്കും ഉണ്ടാകും—","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അവിടത്തെ ഉടമ്പടികൾ പാലിക്കുകയും","poem":1},{"text":"അവിടത്തെ പ്രമാണങ്ങൾ ഓർത്ത് അനുസരിക്കുകയും ചെയ്യുന്നവരുടെമേൽതന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"യഹോവ തന്റെ സിംഹാസനം സ്വർഗത്തിൽ സ്ഥാപിച്ചിരിക്കുന്നു,","poem":1},{"text":"സകലതും അവിടത്തെ ആധിപത്യത്തിൻകീഴിലാകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"അവിടത്തെ അരുളപ്പാടുകൾ ശ്രവിച്ച്,","poem":1},{"text":"അവിടത്തെ ആജ്ഞകൾ നിറവേറ്റുന്ന ദൂതന്മാരേ,","poem":2},{"lineBreak":true},{"text":"ശക്തരായ ദൂതന്മാരേ, യഹോവയെ വാഴ്ത്തുക.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവിടത്തെ ഹിതം അനുഷ്ഠിക്കുന്ന","poem":1},{"text":"സകലസേവകവൃന്ദമേ, സൈന്യങ്ങളുടെ യഹോവയെ വാഴ്ത്തുക.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"അവിടത്തെ ആധിപത്യത്തിലെങ്ങുമുള്ള","poem":1},{"text":"സകലസൃഷ്ടികളുമേ, യഹോവയെ വാഴ്ത്തുക.","poem":2},{"lineBreak":true},{"text":"എൻ മനമേ, യഹോവയെ വാഴ്ത്തുക.","poem":1}]}],"footnotes":[{"noteId":90,"caller":"+","text":"മൂ.ഭാ. കുഴിയിൽനിന്ന്","reference":{"chapter":103,"verse":4}}]},"thisChapterLink":"/api/mal_bib/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}