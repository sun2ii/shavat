{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":106,"content":[{"type":"verse","number":1,"content":[{"text":"യഹോവയെ വാഴ്ത്തുക.","poem":1},{"noteId":95},{"lineBreak":true},{"text":"യഹോവയ്ക്കു സ്തോത്രംചെയ്‌വിൻ, അവിടന്ന് നല്ലവനല്ലോ;","poem":1},{"text":"അവിടത്തെ അചഞ്ചലസ്നേഹം ശാശ്വതമായിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"യഹോവയുടെ വീര്യപ്രവൃത്തികൾ പരിപൂർണമായി വർണിക്കുന്നതിനോ","poem":1},{"text":"അവിടത്തെ സ്തുതി ഘോഷിക്കുന്നതിനോ ആർക്കു കഴിയും?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ന്യായം പാലിക്കുന്നവർ അനുഗൃഹീതർ,","poem":1},{"text":"എപ്പോഴും നീതി പ്രവർത്തിക്കുന്നവരും അങ്ങനെതന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"യഹോവേ, അങ്ങു തന്റെ ജനത്തിന് കാരുണ്യംചൊരിയുമ്പോൾ എന്നെ ഓർക്കണമേ,","poem":1},{"text":"അവിടത്തെ രക്ഷകൊണ്ട് എന്നെ സന്ദർശിക്കണമേ,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അങ്ങനെ ഞാൻ അവിടന്ന് തെരഞ്ഞെടുക്കപ്പെട്ടവരുടെ അഭിവൃദ്ധി ആസ്വദിക്കും.","poem":1},{"text":"അവിടത്തെ ജനതയുടെ ആഹ്ലാദത്തിൽ ഞാനും പങ്കുചേരട്ടെ,","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ അവകാശമായവരോടൊപ്പം ഞാനും അങ്ങയിൽ പുകഴട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ഞങ്ങളുടെ പിതാക്കന്മാരെപ്പോലെ ഞങ്ങളും പാപംചെയ്തു;","poem":1},{"text":"ഞങ്ങൾ തെറ്റുചെയ്തിരിക്കുന്നു! ഞങ്ങൾ ദുഷ്ടത പ്രവർത്തിച്ചിരിക്കുന്നു!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ഞങ്ങളുടെ പൂർവികർ ഈജിപ്റ്റിൽ ആയിരുന്നപ്പോൾ,","poem":1},{"text":"അവിടത്തെ അത്ഭുതപ്രവൃത്തികൾ അവർ പരിഗണിച്ചില്ല;","poem":2},{"text":"അവിടത്തെ അളവറ്റ കരുണ അവർ അനുസ്മരിച്ചില്ല,","poem":1},{"text":"ചെങ്കടൽതീരത്തുവെച്ചുതന്നെ അവർ അങ്ങയോട് മത്സരിച്ചു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"എന്നിട്ടും അങ്ങയുടെ നാമത്തെപ്രതി അങ്ങ് അവരെ രക്ഷിച്ചു,","poem":1},{"text":"അവിടത്തെ മഹാശക്തി വെളിപ്പെടുത്തുന്നതിനായിത്തന്നെ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവിടന്ന് ചെങ്കടലിനെ ശാസിച്ചു, അത് ഉണങ്ങിവരണ്ടു;","poem":1},{"text":"അവരെ മരുഭൂമിയിലൂടെ എന്നപോലെ ആഴിയിലൂടെ നടത്തി.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവിടന്നവരെ ശത്രുക്കളുടെ കൈകളിൽനിന്നു രക്ഷിച്ചു;","poem":1},{"text":"തങ്ങളുടെ എതിരാളികളുടെ കൈകളിൽനിന്നും അവിടന്ന് അവരെ മോചിപ്പിച്ചു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ജലപ്രവാഹം അവരുടെ ശത്രുക്കളെ മൂടിക്കളഞ്ഞു;","poem":1},{"text":"അവരിൽ ഒരാൾപോലും അതിനെ അതിജീവിച്ചില്ല.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അപ്പോൾ അവർ അവിടത്തെ വാഗ്ദത്തങ്ങളിൽ വിശ്വസിച്ച്","poem":1},{"text":"സ്തുതിഗീതങ്ങൾ ആലപിച്ചു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"എങ്കിലും അതിവേഗത്തിൽ അവർ അവിടത്തെ പ്രവൃത്തികൾ വിസ്മരിച്ചു","poem":1},{"text":"അവിടത്തെ ആലോചനയ്ക്കായി കാത്തിരുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"മരുഭൂമിയിൽവെച്ച് അവർ അത്യാർത്തിക്ക് അടിമപ്പെട്ടു;","poem":1},{"text":"വിജനദേശത്ത് അവർ ദൈവത്തെ പരീക്ഷിച്ചു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അതിനാൽ അവർ ആശിച്ചതുതന്നെ അവിടന്ന് അവർക്കു നൽകി,","poem":1},{"text":"എന്നാൽ ഒരു മഹാവ്യാധിയും അവർക്കിടയിലേക്ക് അയച്ചു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"പാളയത്തിൽവെച്ച് അവർ മോശയോടും","poem":1},{"text":"യഹോവയ്ക്കായി വിശുദ്ധീകരിക്കപ്പെട്ട അഹരോനോടും അസൂയപ്പെട്ടു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ഭൂമി വായ്‌പിളർന്ന് ദാഥാനെ വിഴുങ്ങി;","poem":1},{"text":"അബീരാമിന്റെ സംഘത്തെ മൂടിക്കളഞ്ഞു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അവരുടെ അനുയായികൾക്കിടയിൽ അഗ്നി ജ്വലിച്ചു;","poem":1},{"text":"ആ ദുഷ്ടരെ അഗ്നിജ്വാല ദഹിപ്പിച്ചുകളഞ്ഞു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ഹോരേബിൽവെച്ച് അവർ ഒരു കാളക്കിടാവിനെ ഉണ്ടാക്കി;","poem":1},{"text":"വാർത്തുണ്ടാക്കിയ വിഗ്രഹത്തിനുമുന്നിൽ അവർ മുട്ടുമടക്കി.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അവർ തങ്ങളുടെ തേജസ്സേറിയ ദൈവത്തിന്റെ സ്ഥാനത്ത്","poem":1},{"text":"പുല്ലുതിന്നുന്ന കാളയുടെ പ്രതിമയെ തെരഞ്ഞെടുത്തു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ഈജിപ്റ്റിൽ മഹത്തരമായ കാര്യങ്ങൾ‍ചെയ്ത","poem":1},{"text":"തങ്ങളുടെ വിമോചകനായ ദൈവത്തെ അവർ മറന്നു,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ഹാമിന്റെ ദേശത്തുചെയ്ത അത്ഭുതങ്ങളും","poem":1},{"text":"ചെങ്കടലിൽ അരങ്ങേറിയ ഭയങ്കരകാര്യങ്ങളുംതന്നെ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"അതിനാൽ അവർക്ക് ഉന്മൂലനാശംവരുത്തുമെന്ന് അങ്ങ് അരുളിച്ചെയ്തു—","poem":1},{"text":"എന്നാൽ അവിടന്ന് തെരഞ്ഞെടുത്ത മോശ","poem":2},{"text":"അങ്ങേക്കും അവിടത്തെ ജനത്തിനും മധ്യേനിന്നു,","poem":1},{"text":"അങ്ങയുടെ ക്രോധത്താൽ ജനത്തെ നശിപ്പിക്കാതിരിക്കുന്നതിനായിത്തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"അവർ മനോഹരദേശത്തെ നിരസിച്ചു;","poem":1},{"text":"അവിടത്തെ വാഗ്ദാനം അവർ വിശ്വസിച്ചതുമില്ല.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"തങ്ങളുടെ കൂടാരങ്ങളിലിരുന്നവർ പിറുപിറുത്തു","poem":1},{"text":"യഹോവയുടെ ശബ്ദം അനുസരിച്ചതുമില്ല.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"അതുകൊണ്ട് അവിടന്ന് അവരെ മരുഭൂമിയിൽ വീഴ്ത്തുമെന്നും","poem":1},{"text":"അവരുടെ സന്തതികളെ രാഷ്ട്രങ്ങൾക്കിടയിൽ ചിതറിച്ച്,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"വിദൂരദേശങ്ങളിലേക്കവരെ നാടുകടത്തുമെന്നും","poem":1},{"text":"അവിടന്ന് കൈ ഉയർത്തി അവരോട് ശപഥംചെയ്തു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"അവർ പെയോരിലെ ബാലിനോട് ചേർന്നു","poem":1},{"text":"ജീവനില്ലാത്ത ദേവന്മാർക്ക് അർപ്പിച്ച ബലിപ്രസാദം അവർ ഭക്ഷിച്ചു;","poem":2}]},{"type":"verse","number":29,"content":[{"text":"തങ്ങളുടെ അധർമപ്രവൃത്തികളാൽ അവർ യഹോവയെ കോപിപ്പിച്ചു,","poem":1},{"text":"ഒരു മഹാമാരി അവർക്കിടയിൽ പൊട്ടിപ്പുറപ്പെട്ടു.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"എന്നാൽ ഫീനെഹാസ് എഴുന്നേറ്റ് അവസരോചിതമായി പ്രവർത്തിച്ചു,","poem":1},{"text":"മഹാമാരി നിലയ്ക്കുകയും ചെയ്തു.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"അത് അദ്ദേഹത്തിന് നീതിയായി കണക്കിടപ്പെട്ടു;","poem":1},{"text":"അനന്തമായി ഇനിയും വരാനിരിക്കുന്ന തലമുറകളിലേക്കും.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"മെരീബാജലാശയത്തിനരികെവെച്ച് അവർ യഹോവയെ കോപിപ്പിച്ചു,","poem":1},{"text":"അത് മോശയ്ക്ക് അനർഥഹേതുവായിത്തീർന്നു.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"അവർ ദൈവത്തിന്റെ ആത്മാവിനെതിരേ മത്സരിച്ചു,","poem":1},{"text":"അധരംകൊണ്ട് അദ്ദേഹം അവിവേകവാക്കുകൾ സംസാരിച്ചു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"യഹോവ അവരോടു കൽപ്പിച്ചതുപോലെ","poem":1},{"text":"അവർ ജനതകളെ നശിപ്പിച്ചില്ല,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"എന്നാൽ അവർ ആ ജനതകളുമായി ഇടകലർന്ന്","poem":1},{"text":"അവരുടെ ആചാരാനുഷ്ഠാനങ്ങൾ അനുശീലിച്ചു.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"അവരുടെ വിഗ്രഹങ്ങളെ അവർ ഭജിച്ചുവന്നു,","poem":1},{"text":"അത് അവർക്കൊരു കെണിയായി ഭവിച്ചു.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"അവർ തങ്ങളുടെ പുത്രീപുത്രന്മാരെ","poem":1},{"text":"ഭൂതങ്ങൾക്ക് ബലിയർപ്പിച്ചു.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"അവർ നിഷ്കളങ്കരക്തം ചൊരിഞ്ഞു,","poem":1},{"text":"കനാന്യരുടെ വിഗ്രഹങ്ങൾക്ക് ബലിദാനംചെയ്ത,","poem":2},{"text":"അവരുടെ പുത്രീപുത്രന്മാരുടെ രക്തംതന്നെ;","poem":1},{"text":"അങ്ങനെ അവരുടെ രക്തംമൂലം ദേശം മലിനമായിത്തീർന്നു.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"തങ്ങളുടെ തിന്മപ്രവൃത്തികളാൽ അവർ തങ്ങളെത്തന്നെ മലിനമാക്കി;","poem":1},{"text":"വിഗ്രഹങ്ങളോടുള്ള അവരുടെ ആസക്തി യഹോവയുടെ ദൃഷ്ടിയിൽ വേശ്യാവൃത്തിയായിരുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"അതുനിമിത്തം യഹോവയുടെ കോപം തന്റെ ജനത്തിനെതിരേ ജ്വലിച്ചു","poem":1},{"text":"തന്റെ അവകാശത്തെ അവിടന്ന് കഠിനമായി വെറുത്തു.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"അവിടന്ന് അവരെ ഇതര രാഷ്ട്രങ്ങൾക്കു കൈമാറി,","poem":1},{"text":"അവരുടെ വൈരികൾ അവർക്കുമീതേ ഭരണം കയ്യാളി.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"അവരുടെ ശത്രുക്കൾ അവരെ അടിച്ചമർത്തി","poem":1},{"text":"അവരെ തങ്ങളുടെ അധികാരത്തിൻകീഴിൽ അമർത്തി.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"പലപ്രാവശ്യം അവിടന്ന് അവരെ വിടുവിച്ചു,","poem":1},{"text":"എന്നിട്ടും അവർ ബോധപൂർവം ദൈവത്തോട് എതിർത്തുനിന്ന്,","poem":2},{"lineBreak":true},{"text":"തങ്ങളുടെ പാപത്തിൽ അധഃപതിക്കുകയും ചെയ്തു.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"എന്നിട്ടും അവിടന്ന് അവരുടെ നിലവിളി കേട്ടപ്പോൾ","poem":1},{"text":"അവരുടെ ദുരിതങ്ങൾ അവിടന്ന് ശ്രദ്ധിച്ചു;","poem":2}]},{"type":"verse","number":45,"content":[{"text":"അവരോടുള്ള അങ്ങയുടെ ഉടമ്പടി ഓർക്കുകയും","poem":1},{"text":"അങ്ങയുടെ അചഞ്ചലസ്നേഹംനിമിത്തം അവരോട് അനുകമ്പകാണിക്കുകയും ചെയ്തു.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"അവരെ ബന്ദികളാക്കിവെച്ചിരുന്ന എല്ലാവർക്കും","poem":1},{"text":"അവരോട് കനിവുതോന്നുമാറാക്കി.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"ഞങ്ങളുടെ ദൈവമായ യഹോവേ, ഞങ്ങളെ രക്ഷിക്കണമേ,","poem":1},{"text":"ഞങ്ങൾ അവിടത്തെ പരിശുദ്ധനാമത്തിന് സ്തോത്രംചെയ്യുകയും","poem":2},{"text":"അവിടത്തെ സ്തുതികളിൽ പുകഴുകയും ചെയ്യേണ്ടതിന്,","poem":1},{"text":"ഇതര രാഷ്ട്രങ്ങളിൽനിന്ന് ഞങ്ങളെ കൂട്ടിച്ചേർക്കണമേ.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"ഇസ്രായേലിന്റെ ദൈവമായ യഹോവ വാഴ്ത്തപ്പെടട്ടെ,","poem":1},{"text":"എന്നും എന്നെന്നേക്കും.","poem":2},{"lineBreak":true},{"text":"“ആമേൻ!” എന്നു ജനമെല്ലാം പറയട്ടെ.","poem":1},{"lineBreak":true},{"text":"യഹോവയെ വാഴ്ത്തുക.","poem":1}]}],"footnotes":[{"noteId":95,"caller":"+","text":"മൂ.ഭാ. ഹാലേലൂ യാഹ്; അതായത്, ഹാലേലൂയാ.","reference":{"chapter":106,"verse":1}}]},"thisChapterLink":"/api/mal_bib/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}