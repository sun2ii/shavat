{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":107,"content":[{"type":"verse","number":1,"content":[{"text":"യഹോവയ്ക്കു സ്തോത്രംചെയ്‌വിൻ, അവിടന്ന് നല്ലവനല്ലോ;","poem":1},{"text":"അവിടത്തെ അചഞ്ചലസ്നേഹം ശാശ്വതമായിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"യഹോവയാൽ വീണ്ടെടുക്കപ്പെട്ടവർ,","poem":1},{"text":"അവിടന്ന് ശത്രുക്കളുടെ കൈയിൽനിന്ന് വീണ്ടെടുത്തവർ,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"കിഴക്കുനിന്നും പടിഞ്ഞാറുനിന്നും വടക്കുനിന്നും തെക്കുനിന്നും","poem":1},{"noteId":96},{"text":"അവിടന്ന് കൂട്ടിച്ചേർത്തവരായ ജനം ഇപ്രകാരം പറയട്ടെ:","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"അവർ മരുഭൂമിയിൽ വിജനപാതയിൽ അലഞ്ഞുനടന്നു,","poem":1},{"text":"വാസയോഗ്യമായ പട്ടണമൊന്നും അവർ കണ്ടെത്തിയില്ല.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവർ വിശന്നും ദാഹിച്ചും അലഞ്ഞു,","poem":1},{"text":"അവരുടെ ജീവൻ ചോർന്നുപോയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അപ്പോൾ തങ്ങളുടെ കഷ്ടതയിൽ അവർ യഹോവയോട് നിലവിളിച്ചു,","poem":1},{"text":"അവരുടെ ദുരിതത്തിൽനിന്ന് അവിടന്ന് അവരെ വിടുവിച്ചു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവർക്കു വാസയോഗ്യമായ ഒരു നഗരത്തിലേക്ക്","poem":1},{"text":"അവിടന്ന് അവരെ നേർപാതയിലൂടെ നയിച്ചു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവിടത്തെ അചഞ്ചലസ്നേഹംനിമിത്തവും","poem":1},{"text":"അവിടന്ന് മനുഷ്യർക്കുവേണ്ടി ചെയ്ത അത്ഭുതപ്രവൃത്തികൾനിമിത്തവും അവർ യഹോവയ്ക്കു സ്തോത്രംചെയ്യട്ടെ,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"കാരണം അവിടന്ന് ദാഹിക്കുന്നവരെ തൃപ്തരാക്കുകയും","poem":1},{"text":"വിശക്കുന്നവരെ വിശിഷ്ടഭോജ്യങ്ങൾകൊണ്ടു നിറയ്ക്കുകയുംചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ചിലർ ഇരുമ്പുചങ്ങലകളാൽ ബന്ധിതരായി കഷ്ടമനുഭവിച്ചു,","poem":1},{"text":"കൂരിരുളിലും അന്ധതമസ്സിലും ജീവിച്ചു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"കാരണം അവർ ദൈവത്തിന്റെ കൽപ്പനകൾ തിരസ്കരിച്ചു","poem":1},{"text":"അത്യുന്നതന്റെ ആലോചനകൾ നിരസിച്ചു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അതിനാൽ അവിടന്ന് അവരെ കഠിനാധ്വാനത്തിന് ഏൽപ്പിച്ചു;","poem":1},{"text":"അവർ തളർന്നുവീണു, സഹായിക്കാൻ ആരും ഉണ്ടായിരുന്നില്ല.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അപ്പോൾ തങ്ങളുടെ കഷ്ടതയിൽ അവർ യഹോവയോട് നിലവിളിച്ചു,","poem":1},{"text":"അവരുടെ ദുരിതത്തിൽനിന്ന് അവിടന്ന് അവരെ രക്ഷിച്ചു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവിടന്ന് അവരെ അന്ധകാരത്തിൽനിന്ന്, അതേ, ഘോരാന്ധകാരത്തിൽനിന്നുതന്നെ വിടുവിച്ചു,","poem":1},{"text":"അവരുടെ ചങ്ങലകളെ അവിടന്നു പൊട്ടിച്ചെറിഞ്ഞു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവിടത്തെ അചഞ്ചലസ്നേഹംനിമിത്തവും","poem":1},{"text":"അവിടന്ന് മനുഷ്യർക്കുവേണ്ടി ചെയ്ത അത്ഭുതപ്രവൃത്തികൾനിമിത്തവും അവർ യഹോവയ്ക്കു സ്തോത്രംചെയ്യട്ടെ,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"കാരണം, അവിടന്ന് വെങ്കലക്കവാടങ്ങളെ തകർക്കുകയും","poem":1},{"text":"ഇരുമ്പോടാമ്പലുകളെ വെട്ടിമുറിക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ചിലർ തങ്ങളുടെ ധിക്കാരംനിമിത്തം ഭോഷരായിത്തീർന്നു","poem":1},{"text":"അവരുടെ അകൃത്യങ്ങളാൽ ദുരിതമനുഭവിച്ചു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"എല്ലാത്തരം ഭക്ഷണത്തോടും അവർക്ക് വിരക്തിതോന്നി,","poem":1},{"text":"മരണകവാടത്തോട് അവർ സമീപിച്ചിരുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അപ്പോൾ തങ്ങളുടെ കഷ്ടതയിൽ അവർ യഹോവയോട് നിലവിളിച്ചു,","poem":1},{"text":"അവരുടെ ദുരിതത്തിൽനിന്ന് അവിടന്ന് അവരെ രക്ഷിച്ചു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അവിടന്ന് തന്റെ വചനം അയച്ച് അവരെ സൗഖ്യമാക്കി;","poem":1},{"text":"ശവക്കുഴികളിൽനിന്ന് അവിടന്ന് അവരെ മോചിപ്പിച്ചു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവിടത്തെ അചഞ്ചലസ്നേഹംനിമിത്തവും","poem":1},{"text":"അവിടന്ന് മനുഷ്യർക്കുവേണ്ടി ചെയ്ത അത്ഭുതപ്രവൃത്തികൾനിമിത്തവും അവർ യഹോവയ്ക്കു സ്തോത്രംചെയ്യട്ടെ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"അവർ അവിടത്തേക്ക് സ്തോത്രയാഗങ്ങൾ അർപ്പിക്കുകയും","poem":1},{"text":"അവിടത്തെ പ്രവൃത്തികൾ ആനന്ദഗീതങ്ങളാൽ വർണിക്കുകയും ചെയ്യട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ചിലർ മഹാസമുദ്രത്തിലെ വ്യാപാരികളായി;","poem":1},{"text":"കടലിലൂടെയവർ കപ്പൽയാത്രചെയ്തു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അവർ യഹോവയുടെ പ്രവൃത്തികളെ നിരീക്ഷിച്ചു,","poem":1},{"text":"ആഴിയിൽ അവിടത്തെ അത്ഭുതങ്ങളെത്തന്നെ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"അവിടന്ന് ആജ്ഞാപിച്ചു; ഒരു കൊടുങ്കാറ്റ് ആഞ്ഞുവീശി,","poem":1},{"text":"തിരമാലകൾ ഉയർന്നുപൊങ്ങി.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"അവ ആകാശത്തോളം ഉയർന്ന് ആഴങ്ങളിലേക്ക് താഴ്ന്നമർന്നു;","poem":1},{"text":"തങ്ങളുടെ ദുരിതങ്ങളിൽ അവരുടെ ധൈര്യം ചോർന്നൊലിച്ചു.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"അവർ മദോന്മത്തരെപ്പോലെ ചാഞ്ചാടി ആടിയുലഞ്ഞു;","poem":1},{"text":"അവർ അവരുടെ അറിവിന്റെ അന്ത്യത്തിലെത്തി.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"അപ്പോൾ തങ്ങളുടെ കഷ്ടതയിൽ അവർ യഹോവയോട് നിലവിളിച്ചു,","poem":1},{"text":"അവരുടെ ദുരിതത്തിൽനിന്ന് അവിടന്ന് അവരെ രക്ഷിച്ചു.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"അവിടന്ന് കൊടുങ്കാറ്റിനെ ശാന്തമാക്കി;","poem":1},{"text":"സമുദ്രത്തിലെ തിരമാലകൾ അമർന്നു.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"അത് ശാന്തമായപ്പോൾ അവർ ആനന്ദിച്ചു,","poem":1},{"text":"അവർ ആഗ്രഹിച്ച തുറമുഖത്തേക്ക് അവിടന്ന് അവരെ നയിച്ചു.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"അവിടത്തെ അചഞ്ചലസ്നേഹംനിമിത്തവും","poem":1},{"text":"അവിടന്ന് മനുഷ്യർക്കുവേണ്ടി ചെയ്ത അത്ഭുതപ്രവൃത്തികൾനിമിത്തവും അവർ യഹോവയ്ക്കു സ്തോത്രംചെയ്യട്ടെ.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ജനങ്ങളുടെ സഭയിൽ അവർ അവിടത്തെ വാഴ്ത്തട്ടെ","poem":1},{"text":"സമുദായനേതാക്കന്മാരുടെ സംഘത്തിൽ അവിടത്തെ സ്തുതിക്കട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"ദേശവാസികളുടെ ദുഷ്‌പ്രവൃത്തികൾനിമിത്തം","poem":1},{"text":"അവിടന്ന് നദികളെ മരുഭൂമിയും","poem":2}]},{"type":"verse","number":34,"content":[{"text":"അരുവികളെ ദാഹാർത്തഭൂമിയും","poem":1},{"text":"ഫലഭൂയിഷ്ഠമായ ഇടത്തെ ഓരുനിലവും ആക്കിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"അവിടന്ന് മരുഭൂമിയെ ജലാശയങ്ങളായും","poem":1},{"text":"വരണ്ടനിലത്തെ നീർച്ചാലുകളായും മാറ്റുന്നു;","poem":2}]},{"type":"verse","number":36,"content":[{"text":"അവിടന്ന് അവിടെ വിശക്കുന്നവരെ കുടിപാർപ്പിക്കുന്നു,","poem":1},{"text":"അവർക്കു വാസയോഗ്യമായ ഒരു പട്ടണം അവർ പണിതുയർത്തുന്നു.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"അവർ നിലങ്ങൾ വിതച്ചു മുന്തിരിത്തോപ്പുകൾ നട്ടുപിടിപ്പിച്ചു","poem":1},{"text":"അതിൽനിന്ന് അവർക്കു വിളസമൃദ്ധിയും ലഭിച്ചു;","poem":2}]},{"type":"verse","number":38,"content":[{"text":"അവിടന്ന് അവരെ അനുഗ്രഹിച്ചു, അവർ എണ്ണത്തിൽ അത്യധികം പെരുകി,","poem":1},{"text":"അവരുടെ കാലിസമ്പത്ത് കുറയുന്നതിന് അവിടന്ന് അനുവദിച്ചതുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"പീഡനം, ആപത്ത്, ദുഃഖം എന്നിവയാൽ അവിടന്ന് അവരെ താഴ്ത്തി,","poem":1},{"text":"അങ്ങനെ അവരുടെ എണ്ണം കുറഞ്ഞു;","poem":2}]},{"type":"verse","number":40,"content":[{"text":"പ്രഭുക്കന്മാരെ നിന്ദാപാത്രങ്ങളാക്കി മാറ്റുന്ന യഹോവ","poem":1},{"text":"ഗതിയില്ലാതെ ശൂന്യപ്രദേശങ്ങളിലൂടെ അലയുന്നതിന് അവരെ ഇടയാക്കി.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"എന്നാൽ അശരണരെ അവിടന്ന് അവരുടെ കഷ്ടതയിൽനിന്ന് ഉദ്ധരിച്ചു","poem":1},{"text":"അവരുടെ കുടുംബങ്ങളെ ആട്ടിൻപറ്റം എന്നതുപോലെ വർധിപ്പിച്ചു.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"ഹൃദയപരമാർഥികൾ അതുകണ്ട് ആനന്ദിക്കുന്നു,","poem":1},{"text":"എന്നാൽ ദുഷ്ടരെല്ലാം മൗനം അവലംബിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"ജ്ഞാനമുള്ളവർ ഈ കാര്യങ്ങൾ സശ്രദ്ധം മനസ്സിലാക്കുകയും","poem":1},{"text":"യഹോവയുടെ അചഞ്ചലസ്നേഹത്തെപ്പറ്റി ചിന്തിക്കുകയും ചെയ്യട്ടെ.","poem":2}]}],"footnotes":[{"noteId":96,"caller":"+","text":"മൂ.ഭാ. വടക്കുനിന്നും സമുദ്രത്തിൽനിന്നും","reference":{"chapter":107,"verse":3}}]},"thisChapterLink":"/api/mal_bib/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":43}