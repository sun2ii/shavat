{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":109,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"ഞാൻ സ്തുതിക്കുന്ന എന്റെ ദൈവമേ,","poem":1},{"text":"മൗനമായിരിക്കരുതേ,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ദുഷ്ടതയും വഞ്ചനയും ഉള്ള മനുഷ്യർ,","poem":1},{"text":"അവരുടെ വായ് എനിക്കെതിരേ തുറന്നിരിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"വ്യാജംപറയുന്ന നാവുകൊണ്ട് അവർ എനിക്കെതിരേ സംസാരിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"വിദ്വേഷത്തിന്റെ വാക്കുകളാൽ അവർ എന്നെ വളഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"അകാരണമായി അവർ എന്നെ ആക്രമിക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"എന്റെ സൗഹൃദത്തിനു പകരം അവർ എന്റെമേൽ ആരോപണം ഉന്നയിക്കുന്നു,","poem":1},{"text":"ഞാനോ പ്രാർഥനാനിരതനായിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവർ എനിക്കു നന്മയ്ക്കുപകരം തിന്മചെയ്യുന്നു,","poem":1},{"text":"എന്റെ സ്നേഹത്തിനു പകരം എന്നെ വെറുക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"എന്റെ ശത്രുവിനോട് പ്രതിരോധിക്കാൻ ഒരു അധർമിയെ നിയോഗിക്കണമേ;","poem":1},{"text":"അയാളുടെ വലതുഭാഗത്ത് വിരോധി നിൽക്കട്ടെ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"വിചാരണയിൽ അയാൾ കുറ്റക്കാരനെന്നു തെളിയട്ടെ,","poem":1},{"text":"അയാളുടെ അഭ്യർഥനകൾ കുറ്റമായി കണക്കിടപ്പെടട്ടെ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അയാളുടെ നാളുകൾ ചുരുക്കമായിപ്പോകട്ടെ;","poem":1},{"text":"അയാളുടെ നേതൃസ്ഥാനം മറ്റൊരാൾ സ്വീകരിക്കട്ടെ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അയാളുടെ മക്കൾ അനാഥരും","poem":1},{"text":"ഭാര്യ വിധവയും ആയിത്തീരട്ടെ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അയാളുടെ മക്കൾ ഭിക്ഷാടകരായി അലയട്ടെ;","poem":1},{"text":"നശിച്ചുപോയ അവരുടെ ഭവനങ്ങളിൽനിന്നും അവർ ആട്ടിയോടിക്കപ്പെടട്ടെ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അയാൾക്കുള്ളതെല്ലാം കടക്കാർ പിടിച്ചെടുക്കട്ടെ;","poem":1},{"text":"അയാളുടെ അധ്വാനഫലം അപരിചിതർ അപഹരിക്കട്ടെ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ആരും അയാളോട് ദയകാണിക്കാതിരിക്കട്ടെ","poem":1},{"text":"അനാഥരായ അയാളുടെ മക്കളോട് ആരും സഹതാപം കാണിക്കാതെയുമിരിക്കട്ടെ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അയാളുടെ പിൻതലമുറകൾ ഛേദിക്കപ്പെടട്ടെ,","poem":1},{"text":"അടുത്ത തലമുറയിൽനിന്ന് അയാളുടെ പേരു മായിക്കപ്പെടട്ടെ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അയാളുടെ പിതാക്കന്മാരുടെ അകൃത്യങ്ങൾ യഹോവയുടെമുമ്പാകെ സ്മരിക്കപ്പെടുമാറാകട്ടെ;","poem":1},{"text":"അയാളുടെ മാതാവിന്റെ പാപം ഒരുനാളും മായിക്കപ്പെടാതിരിക്കട്ടെ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവരുടെ പാപങ്ങൾ എപ്പോഴും യഹോവയുടെമുമ്പാകെ നിലനിൽക്കട്ടെ,","poem":1},{"text":"അങ്ങനെ അയാളുടെ പേരു ഭൂമിയുടെ സ്മരണകളിൽനിന്ന് വിച്ഛേദിക്കപ്പെടട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"കാരണം ഒരുനാളും അയാൾ നന്മ പ്രവർത്തിക്കാൻ ഇച്ഛിച്ചിരുന്നില്ല,","poem":1},{"text":"എന്നാൽ ദരിദ്രരെയും അശരണരെയും ഹൃദയം തകർന്നവരെയും","poem":2},{"lineBreak":true},{"text":"അയാൾ മരണംവരെ വേട്ടയാടിയിരുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ശാപം ചൊരിയുന്നത് അയാൾക്ക് ഹരമായിരുന്നു—","poem":1},{"text":"അത് അയാളുടെമേൽത്തന്നെ വന്നുപതിച്ചു.","poem":2},{"text":"അനുഗ്രഹിക്കുന്നതിൽ അയാൾ തെല്ലും ആഹ്ലാദം കണ്ടെത്തിയില്ല—","poem":1},{"text":"അതുകൊണ്ട് അനുഗ്രഹം അയാൾക്ക് അന്യമായിരുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അയാൾ ഒരു ഉടയാടപോലെ ശാപം ധരിച്ചു","poem":1},{"text":"അത് അയാളുടെ ഉദരത്തിലേക്ക് വെള്ളംപോലെയും","poem":2},{"lineBreak":true},{"text":"അസ്ഥികളിലേക്ക് തൈലംപോലെയും പടർന്നിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അത് അയാൾ ധരിച്ചിരിക്കുന്ന ഒരു മേലങ്കിപോലെയും","poem":1},{"text":"എന്നും അരയ്ക്കു കെട്ടുന്ന കച്ചപോലെയും ആയിരിക്കട്ടെ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"എനിക്കെതിരേ തിന്മ സംസാരിച്ച് എന്റെമേൽ കുറ്റം ആരോപിക്കുന്നവർക്ക്,","poem":1},{"text":"ഇത് യഹോവയിൽനിന്നു ലഭിക്കുന്ന പ്രതിഫലം ആയിരിക്കട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"എന്നാൽ കർത്താവായ യഹോവേ,","poem":1},{"text":"തിരുനാമത്തെപ്രതി എന്നെ സഹായിക്കണമേ;","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ അചഞ്ചലസ്നേഹത്തിന്റെ ശ്രേഷ്ഠതയോർത്ത് എന്നെ മോചിപ്പിക്കണമേ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"കാരണം ഞാൻ ദരിദ്രനും ഞെരുക്കമനുഭവിക്കുന്നവനും ആകുന്നു,","poem":1},{"text":"എന്റെ ഹൃദയത്തിനുള്ളിൽ മുറിവേറ്റിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ഞാൻ വൈകുന്നേരത്തെ നിഴൽപോലെ മാഞ്ഞുപോകുന്നു;","poem":1},{"text":"ഒരു വെട്ടുക്കിളിയെപ്പോലെ ഞാൻ കുടഞ്ഞെറിയപ്പെടുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ഉപവാസത്താൽ എന്റെ കാൽമുട്ടുകൾ ദുർബലമായിരിക്കുന്നു;","poem":1},{"text":"എന്റെ ശരീരം എല്ലുംതോലും ആയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ഞാൻ എന്റെ കുറ്റാരോപിതരുടെ പരിഹാസത്തിന് ഇരയായിരിക്കുന്നു;","poem":1},{"text":"എന്നെ നോക്കി അവർ നിന്ദാപൂർവം തലകുലുക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"എന്റെ ദൈവമായ യഹോവേ, എന്നെ സഹായിക്കണമേ;","poem":1},{"text":"അവിടത്തെ അചഞ്ചലസ്നേഹത്തിന് അനുസൃതമായി എന്നെ രക്ഷിക്കണമേ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"യഹോവേ, ഇത് അവിടത്തെ കരമാണെന്നും","poem":1},{"text":"അങ്ങുതന്നെയാണ് ഇതു ചെയ്തിരിക്കുന്നതെന്നും അവർ അറിയട്ടെ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"അവർ ശപിക്കുമ്പോൾ അങ്ങ് അനുഗ്രഹിക്കണമേ;","poem":1},{"text":"എന്നെ ആക്രമിക്കുമ്പോൾ അവർ ലജ്ജിതരായിത്തീരട്ടെ,","poem":2},{"lineBreak":true},{"text":"എന്നാൽ അങ്ങയുടെ ദാസൻ ആനന്ദിക്കട്ടെ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"എന്നെ കുറ്റപ്പെടുത്തുന്നവർ അപമാനത്താൽ മൂടപ്പെടട്ടെ","poem":1},{"text":"ഒരു പുറങ്കുപ്പായംപോലെ ലജ്ജ അവരെ പൊതിയട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"എന്റെ അധരംകൊണ്ട് ഞാൻ യഹോവയെ അത്യധികം പുകഴ്ത്തും;","poem":1},{"text":"ജനസമൂഹമധ്യേ ഞാൻ അവിടത്തെ വാഴ്ത്തും.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"കാരണം, മരണശിക്ഷയ്ക്കു വിധിക്കുന്നവരുടെ കൈയിൽനിന്നും അശരണരെ രക്ഷിക്കാനായി,","poem":1},{"text":"അവിടന്ന് അവരുടെ വലതുഭാഗത്ത് നിലകൊള്ളുന്നല്ലോ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}