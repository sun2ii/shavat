{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"ഇസ്രായേൽ ഈജിപ്റ്റിൽനിന്നും","poem":1},{"text":"യാക്കോബുഗൃഹം വിദേശഭാഷ സംസാരിക്കുന്ന ജനമധ്യത്തിൽനിന്നും പുറപ്പെട്ടപ്പോൾ,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"യെഹൂദാ ദൈവത്തിന്റെ വിശുദ്ധമന്ദിരവും","poem":1},{"text":"ഇസ്രായേൽ അവിടത്തെ ആധിപത്യവും","poem":2},{"noteId":105},{"text":"ആയിത്തീർന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ചെങ്കടൽ","poem":1},{"noteId":106},{"text":"അവർ വരുന്നതുകണ്ട് ഓടിപ്പോയി,","poem":1},{"text":"യോർദാൻനദി പിൻവാങ്ങി;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"പർവതങ്ങൾ മുട്ടാടുകളെപ്പോലെയും","poem":1},{"text":"മലകൾ കുഞ്ഞാടുകളെപ്പോലെയും തുള്ളിച്ചാടി.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"സമുദ്രമേ, നീ ഓടുന്നതെന്തിന്?","poem":1},{"text":"യോർദാനേ, നീ പിൻവാങ്ങുന്നതെന്തിന്?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"പർവതങ്ങളേ, നിങ്ങൾ മുട്ടാടുകളെപ്പോലെയും","poem":1},{"text":"മലകളേ, നിങ്ങൾ കുഞ്ഞാടുകളെപ്പോലെയും തുള്ളിച്ചാടുന്നതെന്തിന്?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ഭൂമിയേ, കർത്താവിന്റെ സന്നിധിയിൽ,","poem":1},{"text":"യാക്കോബിന്റെ ദൈവത്തിന്റെ സന്നിധിയിൽത്തന്നെ വിറയ്ക്കുക,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവിടന്ന് പാറയെ ജലാശയവും","poem":1},{"text":"തീക്കൽപ്പാറയെ നീരുറവയും ആക്കിത്തീർത്തു.","poem":2}]}],"footnotes":[{"noteId":105,"caller":"+","text":"അഥവാ, രാജ്യം","reference":{"chapter":114,"verse":2}},{"noteId":106,"caller":"+","text":"മൂ.ഭാ. സമുദ്രം","reference":{"chapter":114,"verse":3}}]},"thisChapterLink":"/api/mal_bib/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}