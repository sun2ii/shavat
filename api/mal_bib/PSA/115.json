{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"ഞങ്ങൾക്കല്ല യഹോവേ, ഞങ്ങൾക്കല്ല;","poem":1},{"text":"അവിടത്തെ അചഞ്ചലസ്നേഹവും വിശ്വസ്തതയുംനിമിത്തം","poem":2},{"lineBreak":true},{"text":"തിരുനാമത്തിനുതന്നെ മഹത്ത്വം ഉണ്ടാകട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ജനതകളെക്കൊണ്ട് “അവരുടെ ദൈവം എവിടെ,”","poem":1},{"text":"എന്നു ചോദിപ്പിക്കുന്നതെന്തിന്?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ഞങ്ങളുടെ ദൈവം സ്വർഗത്തിലുണ്ട്;","poem":1},{"text":"അവിടന്ന് തനിക്ക് ഇഷ്ടമുള്ളതൊക്കെയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"എന്നാൽ അവരുടെ വിഗ്രഹങ്ങൾ വെള്ളിയും സ്വർണവുമാണ്;","poem":1},{"text":"മനുഷ്യകരങ്ങളാൽ നിർമിതവുമാണ്.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവയ്ക്കു വായുണ്ട്, എന്നാൽ സംസാരിക്കാൻ കഴിയുന്നില്ല;","poem":1},{"text":"കണ്ണുണ്ട്, എന്നാൽ കാണാൻ കഴിയുന്നില്ല.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവയ്ക്ക് കാതുണ്ട്, എന്നാൽ കേൾക്കാൻ കഴിയുന്നില്ല;","poem":1},{"text":"മൂക്കുണ്ട് എങ്കിലും മണക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവയ്ക്കു കൈയുണ്ട്, എങ്കിലും സ്പർശിക്കുന്നില്ല;","poem":1},{"text":"കാലുണ്ട്, എങ്കിലും നടക്കുന്നില്ല;","poem":2},{"lineBreak":true},{"text":"തൊണ്ടകൊണ്ട് സംസാരിക്കുന്നതിനും അവയ്ക്കു കഴിവില്ല.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവയെ നിർമിക്കുന്നവർ അവയെപ്പോലെയാകുന്നു,","poem":1},{"text":"അവയിൽ ആശ്രയിക്കുന്ന എല്ലാവരും അങ്ങനെതന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ഇസ്രായേലേ, യഹോവയിൽ ആശ്രയിക്കുക—","poem":1},{"text":"അവിടന്ന് അവരുടെ സഹായവും പരിചയും ആകുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അഹരോൻഗൃഹമേ, യഹോവയിൽ ആശ്രയിക്കുക—","poem":1},{"text":"അവിടന്ന് അവരുടെ സഹായവും പരിചയും ആകുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"യഹോവയെ ഭയപ്പെടുന്ന എല്ലാവരുമേ, യഹോവയിൽ ആശ്രയിക്കുക—","poem":1},{"text":"അവിടന്ന് അവരുടെ സഹായവും പരിചയും ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"യഹോവ നമ്മെ ഓർക്കുകയും അനുഗ്രഹിക്കുകയും ചെയ്യും:","poem":1},{"text":"അവിടന്ന് ഇസ്രായേൽഗൃഹത്തെ അനുഗ്രഹിക്കും","poem":2},{"lineBreak":true},{"text":"അവിടന്ന് അഹരോൻഗൃഹത്തെ അനുഗ്രഹിക്കും","poem":2}]},{"type":"verse","number":13,"content":[{"text":"യഹോവയെ ഭയപ്പെടുന്ന എല്ലാവരെയും അവിടന്ന് അനുഗ്രഹിക്കും—","poem":1},{"text":"ചെറിയവരെയും വലിയവരെയും ഒരുപോലെതന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"യഹോവ നിങ്ങളെ വർധിപ്പിക്കട്ടെ;","poem":1},{"text":"നിങ്ങളെയും നിങ്ങളുടെ മക്കളെയുംതന്നെ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ആകാശവും ഭൂമിയും നിർമിച്ച യഹോവയാൽ","poem":1},{"text":"നിങ്ങൾ അനുഗ്രഹിക്കപ്പെടുമാറാകട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"സ്വർഗം യഹോവയുടേതാകുന്നു,","poem":1},{"text":"എന്നാൽ ഭൂമി അവിടന്ന് മനുഷ്യർക്കു നൽകിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"മരിച്ചവരാരും യഹോവയെ വാഴ്ത്തുന്നില്ല,","poem":1},{"text":"നിശ്ശബ്ദതയിൽ ആണ്ടുപോയവരും അങ്ങനെതന്നെ;","poem":2}]},{"type":"verse","number":18,"content":[{"text":"എന്നാൽ നാമാണ് യഹോവയെ പുകഴ്ത്തുന്നത്,","poem":1},{"text":"ഇന്നും എന്നെന്നേക്കും.","poem":2},{"lineBreak":true},{"text":"യഹോവയെ വാഴ്ത്തുക.","poem":1},{"noteId":107}]}],"footnotes":[{"noteId":107,"caller":"+","text":"മൂ.ഭാ. ഹാലേലൂ യാഹ്; അതായത്, ഹാലേലൂയാ.","reference":{"chapter":115,"verse":18}}]},"thisChapterLink":"/api/mal_bib/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}