{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"അവിടന്ന് എന്നെ കേട്ടിരിക്കയാൽ, ഞാൻ യഹോവയെ സ്നേഹിക്കുന്നു;","poem":1},{"text":"കരുണയ്ക്കായുള്ള എന്റെ യാചനയും അവിടന്ന് കേട്ടല്ലോ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവിടത്തെ ചെവി എന്നിലേക്കു ചായ്ച്ചതുകൊണ്ട്,","poem":1},{"text":"എന്റെ ജീവിതകാലമൊക്കെയും ഞാൻ അവിടത്തെ വിളിച്ചപേക്ഷിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"മരണപാശങ്ങൾ എന്നെ ചുറ്റി,","poem":1},{"text":"പാതാളവേദനകൾ എന്നെ പിടികൂടി;","poem":2},{"lineBreak":true},{"text":"കഷ്ടവും സങ്കടവും എനിക്കു നേരിട്ടു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അപ്പോൾ “യഹോവേ, എന്നെ രക്ഷിക്കണമേ!”","poem":1},{"text":"എന്നു ഞാൻ യഹോവയുടെ നാമം വിളിച്ചപേക്ഷിച്ചു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"യഹോവ കൃപയും നീതിയുമുള്ളവൻ ആകുന്നു;","poem":1},{"text":"നമ്മുടെ ദൈവം ദയാപൂർണൻതന്നെ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"യഹോവ ലളിതമാനസരെ സംരക്ഷിക്കുന്നു;","poem":1},{"text":"ഞാൻ ഞെരുക്കത്തിൽ ആയിരുന്നപ്പോൾ അവിടന്ന് എന്നെ രക്ഷിച്ചു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"എൻ മനമേ, നിന്റെ സ്വസ്ഥതയിലേക്കു മടങ്ങിവരിക;","poem":1},{"text":"യഹോവ നിനക്ക് നല്ലവനായിരിക്കുന്നല്ലോ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"യഹോവേ, അവിടന്ന് എന്റെ ജീവനെ മരണത്തിൽനിന്നും","poem":1},{"text":"എന്റെ കണ്ണുകളെ കണ്ണുനീരിൽനിന്നും","poem":2},{"lineBreak":true},{"text":"എന്റെ കാലുകളെ വീഴ്ചയിൽനിന്നും വിടുവിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഞാൻ ജീവനുള്ളവരുടെ ദേശത്ത്","poem":1},{"text":"യഹോവയുടെമുമ്പാകെ നടക്കേണ്ടതിനുതന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ഞാൻ അങ്ങയിൽ വിശ്വസിച്ചു; അതുകൊണ്ട് ഞാൻ പറഞ്ഞു,","poem":1},{"text":"“ഞാൻ ഏറ്റവും പീഡിതൻ ആയിരിക്കുന്നു;”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"എന്റെ പരിഭ്രാന്തിയിൽ ഞാൻ പറഞ്ഞു,","poem":1},{"text":"“എല്ലാ മനുഷ്യരും വ്യാജംപറയുന്നു.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"യഹോവ എനിക്കു ചെയ്ത സകലനന്മകൾക്കും","poem":1},{"text":"ഞാൻ അങ്ങേക്ക് എന്തു പകരംനൽകും?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ഞാൻ രക്ഷയുടെ പാനപാത്രം എടുത്ത്","poem":1},{"text":"യഹോവയുടെ നാമം വിളിച്ചപേക്ഷിക്കും.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവിടത്തെ ജനങ്ങളുടെയെല്ലാം സാന്നിധ്യത്തിൽ","poem":1},{"text":"ഞാൻ എന്റെ നേർച്ചകൾ യഹോവയ്ക്ക് അർപ്പിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"തന്റെ വിശ്വസ്തസേവകരുടെ മരണം","poem":1},{"text":"യഹോവയുടെ ദൃഷ്ടിയിൽ വിലയേറിയതാകുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"യഹോവേ, ഞാൻ അങ്ങയുടെ സേവകൻ ആകുന്നു.","poem":1},{"text":"ഞാൻ അങ്ങയുടെ സേവകൻതന്നെ;","poem":2},{"lineBreak":true},{"text":"അങ്ങയുടെ ദാസിയുടെ പുത്രൻതന്നെ;","poem":2},{"lineBreak":true},{"text":"അങ്ങ് എന്റെ ബന്ധനങ്ങൾ അഴിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ഞാൻ അങ്ങേക്ക് സ്തോത്രയാഗം അർപ്പിച്ച്","poem":1},{"text":"യഹോവയുടെ നാമം വിളിച്ചപേക്ഷിക്കും.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അവിടത്തെ ജനങ്ങളുടെയെല്ലാം സാന്നിധ്യത്തിൽ","poem":1},{"text":"ഞാൻ എന്റെ നേർച്ചകൾ യഹോവയ്ക്ക് അർപ്പിക്കും,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"യഹോവയുടെ ആലയത്തിന്റെ അങ്കണത്തിലും—","poem":1},{"text":"ജെറുശലേമേ, നിന്റെ മധ്യത്തിലുംതന്നെ.","poem":2},{"lineBreak":true},{"text":"യഹോവയെ വാഴ്ത്തുക.","poem":1},{"noteId":108}]}],"footnotes":[{"noteId":108,"caller":"+","text":"മൂ.ഭാ. ഹാലേലൂ യാഹ്; അതായത്, ഹാലേലൂയാ.","reference":{"chapter":116,"verse":19}}]},"thisChapterLink":"/api/mal_bib/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}