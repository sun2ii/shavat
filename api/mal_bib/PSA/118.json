{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":118,"content":[{"type":"verse","number":1,"content":[{"text":"യഹോവയ്ക്കു സ്തോത്രംചെയ്‌വിൻ, അവിടന്ന് നല്ലവനല്ലോ;","poem":1},{"text":"അവിടത്തെ അചഞ്ചലസ്നേഹം ശാശ്വതമായിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ഇസ്രായേല്യർ പറയട്ടെ:","poem":1},{"text":"“അവിടത്തെ അചഞ്ചലസ്നേഹം ശാശ്വതമായിരിക്കുന്നു.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അഹരോൻഗൃഹം പറയട്ടെ:","poem":1},{"text":"“അവിടത്തെ അചഞ്ചലസ്നേഹം ശാശ്വതമായിരിക്കുന്നു.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"യഹോവയെ ഭയപ്പെടുന്നവർ പറയട്ടെ:","poem":1},{"text":"“അവിടത്തെ അചഞ്ചലസ്നേഹം ശാശ്വതമായിരിക്കുന്നു.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"എന്റെ കഷ്ടതയിൽ ഞാൻ യഹോവയോട് നിലവിളിച്ചു;","poem":1},{"text":"അവിടന്ന് എനിക്ക് ഉത്തരമരുളി, എന്നെ വിശാലസ്ഥലത്തേക്ക് കൊണ്ടുവന്നിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"യഹോവ എന്റെ പക്ഷത്തുണ്ട്, ഞാൻ ഭയപ്പെടുകയില്ല.","poem":1},{"text":"വെറും മർത്യന് എന്നോട് എന്തുചെയ്യാൻ കഴിയും?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"യഹോവ എന്റെ പക്ഷത്തുണ്ട്, അവിടന്ന് എന്റെ സഹായകനാണ്.","poem":1},{"text":"ഞാൻ വിജയംനേടി എന്റെ ശത്രുക്കളെ കാണും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"മനുഷ്യരിൽ ആശ്രയിക്കുന്നതിനെക്കാൾ","poem":1},{"text":"യഹോവയിൽ അഭയം തേടുന്നതാണ് നല്ലത്.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"പ്രഭുക്കന്മാരിൽ ആശ്രയിക്കുന്നതിനെക്കാൾ","poem":1},{"text":"യഹോവയിൽ അഭയം തേടുന്നതാണ് നല്ലത്.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"സകലരാഷ്ട്രങ്ങളും എന്നെ വളഞ്ഞു,","poem":1},{"text":"എന്നാൽ യഹോവയുടെ നാമത്തിൽ ഞാൻ അവരെ തകർത്തുകളഞ്ഞു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അവർ എന്നെ വളഞ്ഞു; അതേ അവർ എന്നെ വളഞ്ഞു,","poem":1},{"text":"എന്നാൽ യഹോവയുടെ നാമത്തിൽ ഞാൻ അവരെ തകർത്തുകളഞ്ഞു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"തേനീച്ചപോലെ എനിക്കുചുറ്റുമവർ ഇരച്ചുകയറി,","poem":1},{"text":"എന്നാൽ മുൾത്തീപോലെ വേഗത്തിൽ അവർ എരിഞ്ഞമർന്നു;","poem":2},{"lineBreak":true},{"text":"യഹോവയുടെ നാമത്തിൽ ഞാൻ അവരെ തകർത്തുകളഞ്ഞു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ഞാൻ വീഴാൻ തക്കവണ്ണം എന്റെ ശത്രുക്കൾ എന്നെ തള്ളി,","poem":1},{"text":"എന്നാൽ യഹോവ എന്നെ സഹായിച്ചു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"യഹോവ എന്റെ ബലവും എന്റെ ഗീതവും","poem":1},{"noteId":110},{"text":"ആകുന്നു;","poem":1},{"text":"അവിടന്ന് എന്റെ രക്ഷയായിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"നീതിനിഷ്ഠരുടെ കൂടാരങ്ങളിൽ","poem":1},{"text":"ആനന്ദത്തിന്റെയും വിജയത്തിന്റെയും ഘോഷം ഉയരുന്നു:","poem":2},{"text":"“യഹോവയുടെ വലങ്കൈ വൻകാര്യങ്ങൾ പ്രവർത്തിച്ചിരിക്കുന്നു!","poem":1}]},{"type":"verse","number":16,"content":[{"text":"യഹോവയുടെ വലങ്കൈ ഉയർന്നിരിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"യഹോവയുടെ വലങ്കൈ വൻകാര്യങ്ങൾ പ്രവർത്തിച്ചിരിക്കുന്നു!”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ഞാൻ മരിക്കുകയില്ല, എന്നാൽ ജീവിച്ചിരുന്ന്,","poem":1},{"text":"യഹോവയുടെ പ്രവൃത്തികൾ വർണിക്കും.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"യഹോവ എന്നെ തിരുത്തുന്നതിന് കഠിനമായി ശിക്ഷിക്കുന്നു,","poem":1},{"text":"എങ്കിലും അവിടന്ന് എന്നെ മരണത്തിന് ഏൽപ്പിച്ചുകൊടുത്തില്ല.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"നീതിയുടെ കവാടങ്ങൾ എനിക്കായി തുറന്നു തരിക;","poem":1},{"text":"ഞാൻ അവയിലൂടെ പ്രവേശിച്ച് യഹോവയ്ക്കു സ്തോത്രമർപ്പിക്കും.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"യഹോവയുടെ കവാടം ഇതാകുന്നു","poem":1},{"text":"നീതിനിഷ്ഠർ അതിൽക്കൂടെ പ്രവേശിക്കും.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവിടന്ന് എനിക്ക് ഉത്തരമരുളിയതുകൊണ്ട് ഞാൻ അങ്ങേക്കു സ്തോത്രംചെയ്യും;","poem":1},{"text":"അങ്ങ് എന്റെ രക്ഷയായിത്തീർന്നിരിക്കുന്നുവല്ലോ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ശില്പികൾ ഉപേക്ഷിച്ച ആ കല്ലുതന്നെ","poem":1},{"text":"മൂലക്കല്ലായിത്തീർന്നിരിക്കുന്നു;","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ഇത് യഹോവ ചെയ്തു;","poem":1},{"text":"നമ്മുടെ ദൃഷ്ടിയിൽ ആശ്ചര്യകരവുമായിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ഇന്ന് യഹോവ ഉണ്ടാക്കിയ ദിവസം;","poem":1},{"text":"ഇന്ന് നമുക്ക് ആനന്ദിച്ച് ഉല്ലസിക്കാം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"യഹോവേ, ഞങ്ങളെ രക്ഷിക്കണമേ!","poem":1},{"text":"യഹോവേ, ഞങ്ങൾക്കു വിജയം നൽകണമേ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"യഹോവയുടെ നാമത്തിൽ വരുന്നവൻ വാഴ്ത്തപ്പെട്ടവൻ;","poem":1},{"text":"യഹോവയുടെ മന്ദിരത്തിൽനിന്ന് ഞങ്ങൾ നിങ്ങളെ അനുഗ്രഹിക്കുന്നു.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"യഹോവ ആകുന്നു ദൈവം,","poem":1},{"text":"അവിടന്ന് ഞങ്ങൾക്കു പ്രകാശം നൽകിയിരിക്കുന്നു.","poem":2},{"text":"യാഗപീഠത്തിന്റെ കൊമ്പുകളിൽ","poem":1},{"text":"യാഗമൃഗത്തെ ബന്ധിക്കുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"അവിടന്ന് ആകുന്നു എന്റെ ദൈവം, അങ്ങയെ ഞാൻ സ്തുതിക്കുന്നു;","poem":1},{"text":"അവിടന്ന് ആകുന്നു എന്റെ ദൈവം, അങ്ങയെ ഞാൻ പുകഴ്ത്തുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"യഹോവയ്ക്കു സ്തോത്രംചെയ്‌വിൻ, അവിടന്ന് നല്ലവനല്ലോ;","poem":1},{"text":"അവിടത്തെ അചഞ്ചലസ്നേഹം ശാശ്വതമായിരിക്കുന്നു.","poem":2}]}],"footnotes":[{"noteId":110,"caller":"+","text":"അഥവാ, പരിരക്ഷ","reference":{"chapter":118,"verse":14}}]},"thisChapterLink":"/api/mal_bib/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}