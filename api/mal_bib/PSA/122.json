{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ആരോഹണഗീതം."]},{"type":"verse","number":1,"content":[{"text":"“നമുക്കു യഹോവയുടെ ആലയത്തിലേക്കു പോകാം,”","poem":1},{"text":"എന്ന് അവർ എന്നോടു പറഞ്ഞപ്പോൾ ഞാൻ ആനന്ദിച്ചു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ജെറുശലേമേ, ഞങ്ങളുടെ കാലുകൾ","poem":1},{"text":"നിന്റെ കവാടങ്ങൾക്കുള്ളിൽ നിൽക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ഉറപ്പോടെ നിർമിക്കപ്പെട്ട ഒരു പട്ടണമാണ് ജെറുശലേം;","poem":1},{"text":"അതു നല്ല സാന്ദ്രതയോടെ ചേർത്തിണക്കി പണിതിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവിടെ ഗോത്രങ്ങൾ കയറിച്ചെല്ലുന്നു—","poem":1},{"text":"യഹോവയുടെ ഗോത്രങ്ങൾ—","poem":2},{"text":"ഇസ്രായേലിനു നൽകിയ നിയമത്തിനനുസൃതമായി","poem":1},{"text":"യഹോവയുടെ നാമത്തിനു സ്തോത്രം അർപ്പിക്കാൻതന്നെ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവിടെ ന്യായപാലനത്തിന് സിംഹാസനങ്ങൾ സ്ഥാപിച്ചിരിക്കുന്നു;","poem":1},{"text":"ദാവീദുഗൃഹത്തിന്റെ സിംഹാസനങ്ങൾതന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ജെറുശലേമിന്റെ സമാധാനത്തിനായി പ്രാർഥിക്കുക:","poem":1},{"text":"“ഈ പട്ടണത്തെ","poem":2},{"noteId":112},{"text":"സ്നേഹിക്കുന്നവർ സുരക്ഷിതരായിരിക്കട്ടെ.","poem":2},{"noteId":113}]},{"type":"verse","number":7,"content":[{"text":"നിന്റെ കോട്ടകൾക്കുള്ളിൽ സമാധാനവും","poem":1},{"text":"അരമനകൾക്കുള്ളിൽ ഐശ്വര്യവും കുടികൊള്ളട്ടെ.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"എന്റെ സഹോദരങ്ങൾക്കും സ്നേഹിതർക്കുംവേണ്ടി,","poem":1},{"text":"“നിന്നിൽ സമാധാനം ഉണ്ടാകട്ടെ,” എന്നു ഞാൻ പറയും.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"നമ്മുടെ ദൈവമായ യഹോവയുടെ ആലയത്തിനുവേണ്ടി","poem":1},{"text":"ഞാൻ നിന്റെ അഭിവൃദ്ധി ആഗ്രഹിക്കുന്നു.","poem":2}]}],"footnotes":[{"noteId":112,"caller":"+","text":"മൂ.ഭാ. അവളെ","reference":{"chapter":122,"verse":6}},{"noteId":113,"caller":"+","text":"അഥവാ, അഭിവൃദ്ധിപ്പെടട്ടെ","reference":{"chapter":122,"verse":6}}]},"thisChapterLink":"/api/mal_bib/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}