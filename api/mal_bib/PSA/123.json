{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":123,"content":[{"type":"hebrew_subtitle","content":["ആരോഹണഗീതം."]},{"type":"verse","number":1,"content":[{"text":"സ്വർഗത്തിൽ സിംഹാസനസ്ഥനായിരിക്കുന്ന അങ്ങയിലേക്ക്,","poem":1},{"text":"ഞാൻ എന്റെ കണ്ണുകൾ ഉയർത്തുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അടിമകളുടെ കണ്ണുകൾ തങ്ങളുടെ യജമാനന്റെ കൈയിലേക്കും","poem":1},{"text":"ദാസിയുടെ കണ്ണുകൾ അവരുടെ യജമാനത്തിയുടെ കൈയിലേക്കും എന്നതുപോലെ,","poem":2},{"text":"ഞങ്ങളുടെ കണ്ണുകൾ ഞങ്ങളുടെ ദൈവമായ യഹോവയിലേക്ക്,","poem":1},{"text":"കരുണ കാണിക്കുന്നതുവരെ നോക്കിക്കൊണ്ടിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ഞങ്ങളോടു കരുണതോന്നണമേ, യഹോവേ, ഞങ്ങളോടു കരുണതോന്നണമേ,","poem":1},{"text":"കാരണം ഇപ്പോൾത്തന്നെ ഞങ്ങൾ നിന്ദകളാൽ മടുത്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അഹന്തനിറഞ്ഞവരുടെ പരിഹാസവും","poem":1},{"text":"വിമതരുടെ വെറുപ്പും","poem":2},{"lineBreak":true},{"text":"ഞങ്ങൾ ആവോളം സഹിച്ചിരിക്കുന്നു.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}