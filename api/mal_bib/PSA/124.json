{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":124,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ആരോഹണഗീതം."]},{"type":"verse","number":1,"content":[{"text":"യഹോവ നമ്മുടെ പക്ഷത്ത് ഇല്ലായിരുന്നെങ്കിൽ—","poem":1},{"text":"ഇസ്രായേല്യർ പറയട്ടെ—","poem":2}]},{"type":"verse","number":2,"content":[{"text":"മനുഷ്യർ നമ്മെ ആക്രമിച്ചപ്പോൾ,","poem":1},{"text":"യഹോവ നമ്മുടെ പക്ഷത്ത് ഇല്ലായിരുന്നെങ്കിൽ,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവരുടെ ക്രോധം നമുക്കെതിരേ കത്തിജ്വലിച്ചപ്പോൾ","poem":1},{"text":"അവർ നമ്മെ ജീവനോടെ വിഴുങ്ങിക്കളയുമായിരുന്നു;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"പ്രളയം നമ്മെ ഒഴുക്കിക്കളയുമായിരുന്നു,","poem":1},{"text":"വെള്ളപ്പാച്ചിൽ നമ്മെ തൂത്തെറിയുമായിരുന്നു,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ആർത്തിരമ്പുന്ന ജലപ്രവാഹം","poem":1},{"text":"നമ്മെ തുടച്ചുനീക്കുമായിരുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"അവരുടെ പല്ലിനിരയായി പറിച്ചുകീറപ്പെടാൻ നമ്മെ അനുവദിക്കാതിരുന്ന,","poem":1},{"text":"യഹോവ വാഴ്ത്തപ്പെട്ടവൻ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"വേട്ടക്കാരന്റെ കെണിയിൽനിന്ന്","poem":1},{"text":"ഒരു പക്ഷിപോലെ നാം വഴുതിപ്പോന്നിരിക്കുന്നു;","poem":2},{"text":"ആ കെണി പൊട്ടിപ്പോയി,","poem":1},{"text":"നാം രക്ഷപ്പെടുകയും ചെയ്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ആകാശവും ഭൂമിയും സൃഷ്ടിച്ച","poem":1},{"text":"യഹോവയുടെ നാമത്തിലാണ് നമ്മുടെ സഹായം.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}