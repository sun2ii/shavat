{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":125,"content":[{"type":"hebrew_subtitle","content":["ആരോഹണഗീതം."]},{"type":"verse","number":1,"content":[{"text":"യഹോവയിൽ ആശ്രയിക്കുന്നവർ സീയോൻ പർവതംപോലെയാണ്,","poem":1},{"text":"അത് ഇളകാതെ എന്നേക്കും നിലനിൽക്കുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"പർവതങ്ങൾ ജെറുശലേമിനെ വലയംചെയ്തിരിക്കുന്നതുപോലെ,","poem":1},{"text":"യഹോവ ഇന്നും എന്നെന്നേക്കും","poem":2},{"lineBreak":true},{"text":"തന്റെ ജനത്തെ വലയംചെയ്തിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"നീതിനിഷ്ഠർ അധർമം പ്രവർത്തിക്കാൻ","poem":1},{"text":"അവരുടെ കൈ നീട്ടാതിരിക്കേണ്ടതിന്,","poem":2},{"text":"നീതിനിഷ്ഠരുടെ അവകാശഭൂമിയിൽ,","poem":1},{"text":"ദുഷ്ടരുടെ ചെങ്കോൽ വാഴുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"യഹോവേ, നല്ലയാളുകൾക്കും","poem":1},{"text":"ഹൃദയപരമാർഥികൾക്കും നന്മചെയ്യണമേ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"എന്നാൽ വക്രതയുടെ വഴികളിൽ തിരിയുന്നവരെ","poem":1},{"text":"അധർമം പ്രവർത്തിക്കുന്നവരോടുകൂടെ യഹോവ പുറന്തള്ളും.","poem":2},{"lineBreak":true},{"text":"ഇസ്രായേലിന്മേൽ സമാധാനം ഉണ്ടാകുമാറാകട്ടെ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}