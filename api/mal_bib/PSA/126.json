{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":126,"content":[{"type":"hebrew_subtitle","content":["ആരോഹണഗീതം."]},{"type":"verse","number":1,"content":[{"text":"യഹോവ സീയോന്റെ ബന്ധിതരെ മടക്കിവരുത്തിയപ്പോൾ,","poem":1},{"text":"ഞങ്ങൾ സ്വപ്നം കാണുന്നവരെപ്പോലെ ആയിരുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ഞങ്ങളുടെ വായിൽ ചിരിയും","poem":1},{"text":"ഞങ്ങളുടെ നാവിൽ ആനന്ദഗീതങ്ങളും നിറഞ്ഞു.","poem":2},{"text":"അപ്പോൾ രാഷ്ട്രങ്ങൾക്കിടയിൽ ഇപ്രകാരം പ്രകീർത്തിക്കപ്പെട്ടു:","poem":1},{"text":"“യഹോവ അവർക്കുവേണ്ടി വൻകാര്യങ്ങൾ ചെയ്തിരിക്കുന്നു.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"യഹോവ ഞങ്ങൾക്കുവേണ്ടി വൻകാര്യങ്ങൾ ചെയ്തിരിക്കുന്നു,","poem":1},{"text":"ഞങ്ങൾ ആനന്ദാതിരേകത്താൽ തുള്ളിച്ചാടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"യഹോവേ, തെക്കേദേശത്തിലെ","poem":1},{"noteId":114},{"text":"തോടുകളെ എന്നപോലെ,","poem":1},{"text":"ഞങ്ങളുടെ ബന്ധിതരെ മടക്കിവരുത്തണമേ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"കണ്ണുനീരോടെ വിതയ്ക്കുന്നവർ","poem":1},{"text":"ആനന്ദഘോഷത്തോടെ കൊയ്തെടുക്കും.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"വിതയ്ക്കാനുള്ള വിത്തു ചുമന്നുകൊണ്ട്,","poem":1},{"text":"കണ്ണുനീരോടെ നടക്കുന്നവർ,","poem":2},{"text":"കറ്റകൾ ചുമന്നുകൊണ്ട്","poem":1},{"text":"ആനന്ദഗീതം പാടി മടങ്ങുന്നു.","poem":2}]}],"footnotes":[{"noteId":114,"caller":"+","text":"അതായത്, യെഹൂദയ്ക്കു തെക്കുള്ള","reference":{"chapter":126,"verse":4}}]},"thisChapterLink":"/api/mal_bib/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}