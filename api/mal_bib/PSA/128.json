{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":128,"content":[{"type":"hebrew_subtitle","content":["ആരോഹണഗീതം."]},{"type":"verse","number":1,"content":[{"text":"യഹോവയെ ഭയപ്പെടുകയും","poem":1},{"text":"അവിടത്തോടുള്ള അനുസരണത്തിൽ ജീവിക്കുകയുംചെയ്യുന്നവർ അനുഗൃഹീതർ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"നിങ്ങളുടെ അധ്വാനഫലം നിങ്ങൾ ഭക്ഷിക്കും;","poem":1},{"text":"അനുഗ്രഹവും സമൃദ്ധിയും നിങ്ങൾക്ക് അവകാശമായിരിക്കും.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"നിന്റെ ഭാര്യ നിന്റെ ഭവനത്തിൽ","poem":1},{"text":"ഫലദായകമായ മുന്തിരിവള്ളിപോലെ ആയിരിക്കും;","poem":2},{"text":"നിന്റെ മക്കൾ നിങ്ങളുടെ മേശയ്ക്കുചുറ്റും","poem":1},{"text":"ഒലിവുതൈകൾപോലെയായിരിക്കും.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"യഹോവയെ ഭയപ്പെടുന്ന മനുഷ്യർ","poem":1},{"text":"ഇപ്രകാരം അനുഗൃഹീതരാകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"യഹോവ സീയോനിൽനിന്നു നിന്നെ അനുഗ്രഹിക്കും;","poem":1},{"text":"നിന്റെ ജീവിതകാലത്തുടനീളം","poem":2},{"lineBreak":true},{"text":"നിനക്കു ജെറുശലേമിന്റെ അഭിവൃദ്ധി കാണാനിടവരട്ടെ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"മക്കളുടെ മക്കളെ കാണാനായി നിന്റെ ആയുസ്സ് ദീർഘമായിരിക്കട്ടെ—","poem":1},{"text":"ഇസ്രായേലിന്മേൽ സമാധാനം ഉണ്ടാകുമാറാകട്ടെ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}