{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["ആരോഹണഗീതം."]},{"type":"verse","number":1,"content":[{"text":"യഹോവേ, അഗാധതയിൽനിന്നു ഞാൻ അവിടത്തോടു നിലവിളിക്കുന്നു;","poem":1}]},{"type":"verse","number":2,"content":[{"text":"കർത്താവേ, എന്റെ ശബ്ദം കേൾക്കണമേ.","poem":2},{"text":"കരുണയ്ക്കായുള്ള എന്റെ നിലവിളിക്കായി","poem":1},{"text":"അങ്ങയുടെ കാതുകൾ തുറക്കണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"യഹോവേ, പാപങ്ങളുടെ ഒരു പട്ടിക അങ്ങു സൂക്ഷിക്കുന്നെങ്കിൽ,","poem":1},{"text":"കർത്താവേ, തിരുമുമ്പിൽ ആർക്കാണു നിൽക്കാൻ കഴിയുക?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"എന്നാൽ തിരുസന്നിധിയിൽ പാപവിമോചനമുണ്ട്,","poem":1},{"text":"അതുകൊണ്ട് ഞങ്ങൾ ഭയഭക്തിയോടെ അവിടത്തെ സേവിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ഞാൻ യഹോവയ്ക്കായി കാത്തിരിക്കുന്നു, എന്റെ ആത്മാവ് അങ്ങേക്കായി കാത്തിരിക്കുന്നു,","poem":1},{"text":"അവിടത്തെ വചനത്തിൽ ഞാൻ പ്രത്യാശയർപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"പ്രഭാതത്തിനായി കാത്തിരിക്കുന്ന കാവൽക്കാരനെക്കാൾ,","poem":1},{"text":"അതേ, പ്രഭാതത്തിനായി കാത്തിരിക്കുന്ന കാവൽക്കാരനെക്കാൾ,","poem":2},{"lineBreak":true},{"text":"ഞാൻ കർത്താവിനായി കാത്തിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ഇസ്രായേലേ, നിന്റെ പ്രത്യാശ യഹോവയിൽ അർപ്പിക്കുക,","poem":1},{"text":"കാരണം യഹോവയുടെ അടുക്കൽ അചഞ്ചലസ്നേഹവും","poem":2},{"lineBreak":true},{"text":"സമ്പൂർണ വീണ്ടെടുപ്പും ഉണ്ടല്ലോ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ഇസ്രായേലിനെ അവരുടെ സകലപാപങ്ങളിൽനിന്നും","poem":1},{"text":"അവിടന്നുതന്നെ വീണ്ടെടുക്കും.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}