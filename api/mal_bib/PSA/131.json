{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":131,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ആരോഹണഗീതം."]},{"type":"verse","number":1,"content":[{"text":"യഹോവേ, എന്റെ ഹൃദയം അഹങ്കരിക്കുന്നില്ല,","poem":1},{"text":"എന്റെ കണ്ണ് അഹന്ത പ്രകടിപ്പിക്കുന്നില്ല;","poem":2},{"text":"ഞാൻ മഹത്തായ കാര്യങ്ങളിൽ ഇടപെടുകയോ","poem":1},{"text":"അപ്രാപ്യമായ കാര്യങ്ങളിൽ വ്യാപൃതനാകുകയോ ചെയ്യുന്നില്ല.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"എന്നാൽ ഞാൻ എന്നെത്തന്നെ സ്വസ്ഥവും ശാന്തവുമാക്കിയിരിക്കുന്നു,","poem":1},{"text":"അമ്മയുടെ മടിയിൽ തൃപ്തിയടഞ്ഞ ഒരു ശിശുവിനെപ്പോലെ;","poem":2},{"lineBreak":true},{"text":"അതേ, മുലകുടിച്ചുറങ്ങുന്ന ഒരു ശിശുവിനെപ്പോലെ എന്റെ ആത്മാവ് തൃപ്തിയടഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ഇസ്രായേലേ, നിന്റെ പ്രത്യാശ യഹോവയിൽ അർപ്പിക്കുക—","poem":1},{"text":"ഇന്നും എന്നെന്നേക്കും.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}