{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":133,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ആരോഹണഗീതം."]},{"type":"verse","number":1,"content":[{"text":"കണ്ടാലും, സഹോദരങ്ങൾ ഐക്യത്തോടെ വസിക്കുന്നത്","poem":1},{"text":"എത്ര മനോഹരവും ആനന്ദകരവുമാകുന്നു!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"അതു ശിരസ്സിൽ ഒഴിക്കപ്പെട്ട്,","poem":1},{"text":"താടിയിലേക്ക് ഒഴുകുന്ന,","poem":2},{"text":"അഹരോന്റെ താടിയിലേക്കുതന്നെ ഒഴുകി,","poem":1},{"text":"അദ്ദേഹത്തിന്റെ വസ്ത്രാഞ്ചലത്തിലേക്കു പടരുന്ന അമൂല്യമായ അഭിഷേകതൈലംപോലെയാണ്.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അതു സീയോൻപർവതത്തിൽ പതിക്കുന്ന","poem":1},{"text":"ഹെർമോൻ ഹിമകണംപോലെയാണ്.","poem":2},{"text":"യഹോവ തന്റെ അനുഗ്രഹവും","poem":1},{"text":"ശാശ്വതജീവനും വർഷിക്കുന്നത് അവിടെയാണല്ലോ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/134.json","nextChapterAudioLinks":{},"previousChapter