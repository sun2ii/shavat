{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":134,"content":[{"type":"hebrew_subtitle","content":["ആരോഹണഗീതം."]},{"type":"verse","number":1,"content":[{"text":"രാത്രിയാമങ്ങളിൽ യഹോവയുടെ ആലയത്തിൽ ശുശ്രൂഷചെയ്യുന്ന,","poem":1},{"text":"യഹോവയുടെ സകലശുശ്രൂഷകരുമേ, യഹോവയെ വാഴ്ത്തുക.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"വിശുദ്ധമന്ദിരത്തിലേക്കു നിങ്ങളുടെ കൈകളെ ഉയർത്തി","poem":1},{"text":"യഹോവയെ വാഴ്ത്തുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ആകാശത്തിന്റെയും ഭൂമിയുടെയും സ്രഷ്ടാവായ,","poem":1},{"text":"യഹോവ സീയോനിൽനിന്നു നിങ്ങളെ അനുഗ്രഹിക്കുമാറാകട്ടെ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/134.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/135.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/133.json","previousChapterAudioLinks":{},"numberOfVerses":3}