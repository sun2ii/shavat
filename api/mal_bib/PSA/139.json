{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":139,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"യഹോവേ, അവിടന്നെന്നെ പരിശോധിച്ചു,","poem":1},{"text":"അവിടന്നെന്നെ അറിഞ്ഞുമിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ഞാൻ ഇരിക്കുന്നതും എഴുന്നേൽക്കുന്നതും അവിടന്ന് അറിയുന്നു;","poem":1},{"text":"എന്റെ ചിന്തകളെ വിദൂരതയിൽനിന്നുതന്നെ അവിടന്ന് ഗ്രഹിക്കുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"എന്റെ നടപ്പും എന്റെ കിടപ്പും അങ്ങ് വേർതിരിച്ചറിയുന്നു;","poem":1},{"text":"എന്റെ എല്ലാ മാർഗങ്ങളും അവിടത്തേക്ക് സുപരിചിതമാണ്.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ഞാൻ ഒരു വാക്ക് ഉച്ചരിക്കാൻ ആരംഭിക്കുന്നതിനു മുമ്പുതന്നെ","poem":1},{"text":"യഹോവേ, അങ്ങ് അതു പൂർണമായും ഗ്രഹിക്കുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവിടന്ന് എന്റെ മുന്നിലും പിന്നിലുംനിന്ന് എനിക്കു സംരക്ഷണമേകുന്നു,","poem":1},{"text":"അങ്ങയുടെ കരുതലിൻകരം എന്റെമേൽ വെച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഈ അറിവ് എനിക്ക് അത്യന്തം വിസ്മയാവഹമാണ്,","poem":1},{"text":"അതെനിക്ക് എത്തിച്ചേരാവുന്നതിലും ഉന്നതമാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"അവിടത്തെ ആത്മാവിനെവിട്ട് ഞാൻ എവിടെ പോകും?","poem":1},{"text":"തിരുസന്നിധിയിൽനിന്നും ഞാൻ എവിടേക്കു പലായനംചെയ്യും?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ഞാൻ സ്വർഗോന്നതങ്ങളിൽ കയറിച്ചെന്നാൽ അങ്ങ് അവിടെയുണ്ട്;","poem":1},{"text":"ഞാൻ പാതാളത്തിൽ കിടക്കവിരിച്ചാൽ അങ്ങ് അവിടെയുമുണ്ട്.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഞാൻ ഉഷസ്സിൻ ചിറകിലേറി,","poem":1},{"text":"ആഴിയുടെ അങ്ങേത്തീരത്തിലെത്തി വസിച്ചാൽ,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അങ്ങയുടെ തിരുക്കരം അവിടെയും എനിക്കു വഴികാട്ടും,","poem":1},{"text":"അവിടത്തെ വലതുകരമെന്നെ താങ്ങിനടത്തും.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“അന്ധകാരമെന്നെ ആവരണംചെയ്യട്ടെ എന്നും","poem":1},{"text":"പ്രകാശം എനിക്കുചുറ്റും ഇരുൾപരത്തട്ടെ എന്നും,” ഞാൻ പറഞ്ഞാൽ,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ഇരുട്ടുപോലും അങ്ങേക്ക് ഇരുട്ടായിരിക്കുകയില്ല;","poem":1},{"text":"രാത്രി പകൽപോലെ പ്രകാശിക്കും,","poem":2},{"lineBreak":true},{"text":"കാരണം അന്ധകാരം അവിടത്തേക്ക് പ്രകാശംപോലെതന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"അവിടന്നാണെന്റെ അന്തരിന്ദ്രിയം രൂപകൽപ്പനചെയ്തത്;","poem":1},{"text":"എന്റെ അമ്മയുടെ ഗർഭഗൃഹത്തിൽ എന്നെ കൂട്ടിയിണക്കിയതും അങ്ങുതന്നെയാണ്.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"സങ്കീർണവും വിസ്മയകരവുമായി അങ്ങ് എന്നെ സൃഷ്ടിച്ചിരിക്കുകയാൽ ഞാൻ അങ്ങേക്ക് സ്തോത്രംചെയ്യുന്നു;","poem":1},{"text":"അവിടത്തെ പ്രവൃത്തികൾ ആശ്ചര്യകരമാണ്,","poem":2},{"lineBreak":true},{"text":"അതെനിക്കു നന്നായി അറിയാം.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഞാൻ നിഗൂഢതയിൽ ഉരുവാക്കപ്പെടുകയും","poem":1},{"text":"ഭൂമിയുടെ അഗാധതകളിൽ മെനയപ്പെടുകയും ചെയ്തപ്പോൾ,","poem":2},{"lineBreak":true},{"text":"എന്റെ ആകാരം അങ്ങേക്ക് അജ്ഞാതമായിരുന്നില്ല.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"എന്റെ ശരീരം രൂപപ്പെടുന്നതിനുമുമ്പുതന്നെ അവിടത്തെ കണ്ണ് എന്നെ കണ്ടു;","poem":1},{"text":"എനിക്കു നിർണയിക്കപ്പെട്ടിരുന്ന ദിനങ്ങൾ സാക്ഷാത്കരിക്കപ്പെടുന്നതിനു മുമ്പേതന്നെ,","poem":2},{"lineBreak":true},{"text":"അവയെല്ലാം അങ്ങയുടെ പുസ്തകത്തിൽ രേഖപ്പെടുത്തപ്പെട്ടു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ദൈവമേ, അവിടത്തെ വിചാരങ്ങൾ എനിക്ക് എത്രയോ അമൂല്യം!","poem":1},{"text":"അവയുടെ ആകെത്തുക എത്ര വലുത്!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ഞാൻ അവയെ എണ്ണിനോക്കിയാൽ","poem":1},{"text":"അവ മണൽത്തരികളെക്കാൾ അധികം!","poem":2},{"lineBreak":true},{"text":"ഞാനുണരുമ്പോൾ അങ്ങയോടൊപ്പംതന്നെയായിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ദൈവമേ, അങ്ങ് ദുഷ്ടരെ സംഹരിച്ചിരുന്നെങ്കിൽ നന്നായിരുന്നു!","poem":1},{"text":"രക്തദാഹികളേ, എന്നെ വിട്ടകന്നുപോകൂ!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അവർ അങ്ങയെപ്പറ്റി ദുഷ്ടലാക്കോടുകൂടി സംസാരിക്കുന്നു;","poem":1},{"text":"അങ്ങയുടെ തിരുനാമം ശത്രുക്കൾ ദുർവിനിയോഗംചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"യഹോവേ, അങ്ങയെ വെറുക്കുന്നവരെ ഞാൻ വെറുക്കേണ്ടതല്ലയോ?","poem":1},{"text":"അങ്ങയോട് എതിർത്തുനിൽക്കുന്നവരെ ഞാൻ കഠിനമായി വെറുക്കേണ്ടതല്ലയോ?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"എനിക്കവരോട് പൂർണ വെറുപ്പുമാത്രമേയുള്ളൂ;","poem":1},{"text":"ഞാൻ അവരെ എന്റെ ശത്രുക്കളായി പരിഗണിക്കുന്നു.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ദൈവമേ, എന്നെ പരിശോധിച്ച് എന്റെ ഹൃദയത്തെ അറിയണമേ;","poem":1},{"text":"എന്നെ പരീക്ഷിച്ച് എന്റെ ആകാംക്ഷാഭരിതമായ വിചാരങ്ങൾ മനസ്സിലാക്കണമേ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ദോഷത്തിന്റെ മാർഗം എന്തെങ്കിലും എന്നിലുണ്ടോ എന്നുനോക്കി,","poem":1},{"text":"ശാശ്വതമാർഗത്തിൽ എന്നെ നടത്തണമേ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}