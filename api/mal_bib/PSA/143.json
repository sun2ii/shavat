{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":143,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"യഹോവേ, എന്റെ പ്രാർഥന കേൾക്കണമേ,","poem":1},{"text":"കരുണയ്ക്കായുള്ള എന്റെ നിലവിളി കേൾക്കണമേ;","poem":2},{"text":"അങ്ങയുടെ വിശ്വസ്തതയും നീതിയുംനിമിത്തം","poem":1},{"text":"എന്റെ ആശ്വാസത്തിനായി വരണമേ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"തിരുമുമ്പിൽ നീതിനിഷ്ഠരായി ജീവിക്കുന്ന ആരുമില്ലല്ലോ,","poem":1},{"text":"അതുകൊണ്ട് അങ്ങയുടെ ദാസനെ വിചാരണയ്ക്കായി കൊണ്ടുവരരുതേ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ശത്രു എന്നെ പിൻതുടരുന്നു,","poem":1},{"text":"അയാളെന്നെ നിലത്തിട്ടു മെതിക്കുന്നു;","poem":2},{"text":"പണ്ടേ മരിച്ചവരെപ്പോലെ","poem":1},{"text":"അയാളെന്നെ ഇരുളിൽ പാർപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അതുകൊണ്ട് എന്റെ ആത്മാവ് എന്റെയുള്ളിൽ തളരുന്നു;","poem":1},{"text":"എന്റെ ഹൃദയം എന്റെയുള്ളിൽ സ്തംഭിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"പൂർവകാലങ്ങളെ ഞാൻ ഓർക്കുന്നു;","poem":1},{"text":"അവിടത്തെ സകലവിധ പ്രവൃത്തികളെയും ഞാൻ ധ്യാനിക്കുകയും","poem":2},{"lineBreak":true},{"text":"തൃക്കരങ്ങളുടെ പ്രവൃത്തികളെപ്പറ്റി ചിന്തിക്കുകയുംചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഞാൻ എന്റെ കൈകൾ തിരുമുമ്പിൽ വിരിക്കുന്നു;","poem":1},{"text":"ഉണങ്ങിവരണ്ട നിലംപോലെ ഞാൻ അവിടത്തേക്കായി ദാഹിക്കുന്നു. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"യഹോവേ, വേഗത്തിൽ എനിക്ക് ഉത്തരമരുളണമേ;","poem":1},{"text":"എന്റെ ആത്മാവ് തളർന്നിരിക്കുന്നു.","poem":2},{"text":"അങ്ങയുടെ മുഖം എന്നിൽനിന്നും മറയ്ക്കരുതേ","poem":1},{"text":"അങ്ങനെയായാൽ ഞാൻ ശവക്കുഴിയിലേക്കു നിപതിക്കുന്നവരെപ്പോലെയാകും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"പ്രഭാതം അവിടത്തെ അചഞ്ചലസ്നേഹത്തെപ്പറ്റിയുള്ള കേൾവിനൽകട്ടെ,","poem":1},{"text":"കാരണം എന്റെ ആശ്രയം അങ്ങയിൽ ഞാൻ അർപ്പിക്കുന്നു.","poem":2},{"text":"ഞാൻ പോകേണ്ടുന്ന വഴി എനിക്കു കാണിച്ചുതരണമേ,","poem":1},{"text":"കാരണം എന്റെ ജീവൻ ഞാൻ അങ്ങയെ ഏൽപ്പിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"യഹോവേ, എന്റെ ശത്രുക്കളിൽനിന്ന് എന്നെ മോചിപ്പിക്കണമേ,","poem":1},{"text":"കാരണം എന്റെ സംരക്ഷണത്തിനായി ഞാൻ അങ്ങയുടെ അടുത്തേക്കോടുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"തിരുഹിതംചെയ്യാൻ എന്നെ പഠിപ്പിക്കണമേ,","poem":1},{"text":"കാരണം അവിടന്ന് ആകുന്നു എന്റെ ദൈവം;","poem":2},{"text":"അങ്ങയുടെ നല്ല ആത്മാവ്","poem":1},{"text":"നീതിപഥത്തിൽ","poem":2},{"noteId":119},{"text":"എന്നെ നടത്തട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"യഹോവേ, തിരുനാമത്തെപ്രതി എന്റെ ജീവൻ സംരക്ഷിക്കണമേ;","poem":1},{"text":"അവിടത്തെ നീതിയാൽ കഷ്ടതയിൽനിന്നുമെന്നെ വിടുവിക്കണമേ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവിടത്തെ അചഞ്ചലസ്നേഹത്താൽ എന്റെ ശത്രുക്കളെ നിശ്ശബ്ദരാക്കണമേ;","poem":1},{"text":"എന്റെ എതിരാളികളെയെല്ലാം നശിപ്പിക്കണമേ,","poem":2},{"lineBreak":true},{"text":"ഞാൻ അങ്ങയുടെ സേവകനാണല്ലോ.","poem":2}]}],"footnotes":[{"noteId":119,"caller":"+","text":"മൂ.ഭാ. സമഭൂമിയിൽ","reference":{"chapter":143,"verse":10}}]},"thisChapterLink":"/api/mal_bib/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}