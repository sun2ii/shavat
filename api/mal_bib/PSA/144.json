{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":144,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"എന്റെ പാറയാകുന്ന യഹോവ വാഴ്ത്തപ്പെട്ടവൻ,","poem":1},{"text":"അവിടന്ന് എന്റെ കരങ്ങളെ യുദ്ധത്തിനായും","poem":2},{"lineBreak":true},{"text":"എന്റെ വിരലുകളെ പോരാട്ടത്തിനായും ഒരുക്കുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവിടന്ന് എന്നെ സ്നേഹിക്കുന്ന ദൈവവും എന്റെ കോട്ടയും,","poem":1},{"text":"എന്റെ സുരക്ഷിതസ്ഥാനവും എന്റെ വിമോചകനും,","poem":2},{"text":"ജനതകളെ എന്റെമുമ്പിൽ അടിയറവുപറയിക്കുന്ന","poem":1},{"text":"എന്റെ പരിചയും എന്റെ അഭയസ്ഥാനവും ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"യഹോവേ, അങ്ങയുടെ ശ്രദ്ധയിൽപ്പെടാൻമാത്രം മർത്യൻ എന്തുള്ളൂ?","poem":1},{"text":"അങ്ങയുടെ പരിഗണനയിൽ വരുന്നതിന് കേവലം മാനവർക്ക് എന്താണർഹത?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"മനുഷ്യർ ഒരു ശ്വാസംമാത്രം;","poem":1},{"text":"അവരുടെ ദിനങ്ങൾ ക്ഷണികമായ നിഴൽപോലെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"യഹോവേ, സ്വർഗം തുറന്ന് ഇറങ്ങിവരണമേ;","poem":1},{"text":"പർവതങ്ങൾ സ്പർശിക്കണമേ, അവിടെനിന്നും പുകപടലങ്ങൾ ഉയരട്ടെ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"മിന്നൽ അയച്ച് ശത്രുഗണത്തെ ചിതറിക്കണമേ;","poem":1},{"text":"അങ്ങയുടെ അസ്ത്രങ്ങൾ എയ്ത് അവരെ തുരത്തണമേ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ഉയരത്തിൽനിന്നും തൃക്കരം നീട്ടി;","poem":1},{"text":"പെരുവെള്ളത്തിൽനിന്നും","poem":2},{"text":"വിദേശികളുടെ കൈയിൽനിന്നും","poem":1},{"text":"എന്നെ രക്ഷിക്കണമേ,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവരുടെ വായിൽ വ്യാജം നിറഞ്ഞിരിക്കുന്നു,","poem":1},{"text":"അവരുടെ വലതുകരങ്ങളിൽ വഞ്ചന വാഴുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"എന്റെ ദൈവമേ, അങ്ങേക്കു ഞാൻ ഒരു നവഗാനം ആലപിക്കും;","poem":1},{"text":"പത്തുകമ്പിയുള്ള വീണ മീട്ടി അങ്ങേക്കു ഞാനൊരു സംഗീതമാലപിക്കും,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"രാജാക്കന്മാർക്ക് വിജയം നൽകുകയും","poem":1},{"text":"അവിടത്തെ ദാസനായ ദാവീദിനെ രക്ഷിക്കുകയും ചെയ്യുന്ന അങ്ങേക്കുതന്നെ.","poem":2},{"lineBreak":true},{"text":"നാശകരമായ വാളിൽനിന്നും","poem":1}]},{"type":"verse","number":11,"content":[{"text":"എന്നെ രക്ഷിക്കണമേ;","poem":1},{"text":"വിദേശികളുടെ കൈയിൽനിന്നും എന്നെ മോചിപ്പിക്കണമേ,","poem":2},{"text":"അവരുടെ വായിൽ വ്യാജം നിറഞ്ഞിരിക്കുന്നു,","poem":1},{"text":"അവരുടെ വലതുകരങ്ങളിൽ വഞ്ചന വാഴുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"നമ്മുടെ പുത്രന്മാർ അവരുടെ യൗവനത്തിൽ","poem":1},{"text":"നന്നായി പരിചരിച്ച വൃക്ഷങ്ങൾപോലെയും,","poem":2},{"text":"നമ്മുടെ പുത്രിമാർ രാജകൊട്ടാരങ്ങളിലെ","poem":1},{"text":"കൊത്തിയെടുത്ത അലംകൃത സ്തംഭങ്ങൾപോലെയും ആകും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"നമ്മുടെ കളപ്പുരകൾ സമൃദ്ധമാകും;","poem":1},{"text":"എല്ലാവിധ ധാന്യങ്ങളാലുംതന്നെ.","poem":2},{"text":"ഞങ്ങളുടെ ആടുകൾ പുൽപ്പുറങ്ങളിൽ പെറ്റുപെരുകം,","poem":1},{"text":"ആയിരങ്ങളായും പതിനായിരങ്ങളായും;","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"നമ്മുടെ കാളക്കൂറ്റന്മാർ അധികഭാരം വലിക്കും.","poem":2},{"text":"മതിലുകൾ ഇടിക്കപ്പെടുകയില്ല,","poem":1},{"text":"ആരും ബന്ദികളാക്കപ്പെടുന്നില്ല,","poem":2},{"lineBreak":true},{"text":"ഞങ്ങളുടെ തെരുവുകളിൽ ദീനരോദനവുമില്ല.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഇവയെല്ലാം യാഥാർഥ്യമായിരിക്കുന്ന ജനം അനുഗൃഹീതർ;","poem":1},{"text":"യഹോവ ദൈവമായിരിക്കുന്ന ജനം അനുഗൃഹീതർ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}