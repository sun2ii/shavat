{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":145,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സ്തോത്രസങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"എന്റെ ദൈവമായ രാജാവേ, ഞാൻ അങ്ങയെ പുകഴ്ത്തും;","poem":1},{"text":"അവിടത്തെ നാമം ഞാൻ എന്നുമെന്നും വാഴ്ത്തും.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ദിനംപ്രതി ഞാൻ അങ്ങയെ വാഴ്ത്തും","poem":1},{"text":"തിരുനാമം ഞാൻ എന്നെന്നേക്കും പുകഴ്ത്തും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"യഹോവ ഉന്നതനും സ്തുതിക്ക് അത്യന്തം യോഗ്യനുമാണ്;","poem":1},{"text":"അവിടത്തെ മഹിമയുടെ വ്യാപ്തി ഗ്രഹിക്കുന്നതിന് ആർക്കും കഴിയുകയില്ല.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ഓരോ തലമുറയും അനന്തരതലമുറയോട്","poem":1},{"text":"അവിടത്തെ വീര്യപ്രവൃത്തികളെപ്പറ്റി ഘോഷിക്കട്ടെ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവർ അവിടത്തെ പ്രതാപമുള്ള തേജസ്സിന്റെ മഹത്ത്വത്തെയും","poem":1},{"text":"ഞാൻ അവിടത്തെ അത്ഭുതകരമായ പ്രവൃത്തികളെയും ധ്യാനിക്കും.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവർ അങ്ങയുടെ അത്ഭുതാദരവുകൾനിറഞ്ഞ പ്രവൃത്തികളുടെ ശക്തിയെപ്പറ്റി വിവരിക്കും","poem":1},{"text":"ഞാൻ അങ്ങയുടെ വീര്യപ്രവൃത്തികൾ ഘോഷിക്കും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവർ അങ്ങയുടെ അനന്തമായ നന്മകളെപ്പറ്റി ആഘോഷിക്കും","poem":1},{"text":"അങ്ങയുടെ നീതിയെപ്പറ്റി ആനന്ദഗാനങ്ങൾ ആലപിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"യഹോവ ആർദ്രഹൃദയനും കരുണാമയനും","poem":1},{"text":"ക്ഷമാശീലനും സ്നേഹസമ്പന്നനും ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"യഹോവ എല്ലാവർക്കും നല്ലവൻ;","poem":1},{"text":"തന്റെ സകലപ്രവൃത്തികളോടും അവിടന്ന് കരുണയുള്ളവനാണ്.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"യഹോവേ, അവിടത്തെ സകലസൃഷ്ടികളും അവിടത്തെ വാഴ്ത്തുന്നു,","poem":1},{"text":"അവിടത്തെ വിശ്വസ്തർ അങ്ങയെ പുകഴ്ത്തുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അവർ അവിടത്തെ രാജ്യത്തിന്റെ മഹത്ത്വത്തെപ്പറ്റിയും","poem":1},{"text":"അവിടത്തെ ശക്തിയെപ്പറ്റിയും വിവരിക്കും,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അതുകൊണ്ട് മനുഷ്യരെല്ലാം അങ്ങയുടെ വീര്യപ്രവൃത്തികളെയും","poem":1},{"text":"അവിടത്തെ രാജ്യത്തിന്റെ മഹത്ത്വപ്രതാപത്തെയും അറിയട്ടെ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അവിടത്തെ രാജ്യം നിത്യരാജ്യം ആകുന്നു,","poem":1},{"text":"അവിടത്തെ ആധിപത്യം തലമുറതലമുറയായി നിലനിൽക്കും.","poem":2},{"lineBreak":true},{"text":"യഹോവ തന്റെ സകലവാഗ്ദാനങ്ങളിലും വിശ്വാസയോഗ്യനും","poem":1},{"text":"തന്റെ സകലപ്രവൃത്തികളിലും വിശ്വസ്തനുമാണ്.","poem":2},{"noteId":120}]},{"type":"verse","number":14,"content":[{"text":"യഹോവ വീഴുന്നവരെയൊക്കെയും താങ്ങുന്നു","poem":1},{"text":"പരിക്ഷീണരെയൊക്കെയും ഉയർത്തുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"സകലരുടെയും കണ്ണ് അങ്ങേക്കായി കാത്തിരിക്കുന്നു,","poem":1},{"text":"അവർക്കെല്ലാം അങ്ങ് യഥാസമയം ആഹാരം നൽകുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അവിടന്ന് തൃക്കൈ തുറക്കുന്നു","poem":1},{"text":"ജീവനുള്ള സകലത്തിന്റെയും ആഗ്രഹങ്ങൾക്ക് തൃപ്തിവരുത്തുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"യഹോവ തന്റെ എല്ലാ വഴികളിലും നീതിനിഷ്ഠൻ ആകുന്നു","poem":1},{"text":"തന്റെ സകലപ്രവൃത്തികളിലും വിശ്വസ്തനുമാണ്.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"യഹോവ തന്നെ വിളിച്ചപേക്ഷിക്കുന്ന എല്ലാവർക്കും,","poem":1},{"text":"സത്യസന്ധമായി വിളിച്ചപേക്ഷിക്കുന്ന എല്ലാവർക്കും, സമീപസ്ഥനാകുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"തന്നെ ഭയപ്പെടുന്നവരുടെ ആഗ്രഹങ്ങൾ അവിടന്ന് സഫലമാക്കുന്നു;","poem":1},{"text":"അവരുടെ കരച്ചിൽകേട്ട് അവരെ രക്ഷിക്കുന്നു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"തന്നെ സ്നേഹിക്കുന്ന സകലരെയും യഹോവ സംരക്ഷിക്കുന്നു,","poem":1},{"text":"എന്നാൽ സകലദുഷ്ടരെയും അവിടന്ന് നശിപ്പിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"എന്റെ വായ് യഹോവയുടെ സ്തുതികൾ ഉയർത്തും.","poem":1},{"text":"സർവജീവജാലങ്ങളും അവിടത്തെ വിശുദ്ധനാമത്തെ","poem":2},{"lineBreak":true},{"text":"എന്നെന്നേക്കും വാഴ്ത്തട്ടെ.","poem":2}]}],"footnotes":[{"noteId":120,"caller":"+","text":"വാ. 13-ലെ അവസാനത്തെ രണ്ടുവരികൾ മിക്ക കൈ.പ്ര. കാണുന്നില്ല.","reference":{"chapter":145,"verse":13}}]},"thisChapterLink":"/api/mal_bib/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}