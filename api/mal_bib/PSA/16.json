{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":16,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സ്വർണഗീതം."]},{"type":"verse","number":1,"content":[{"text":"എന്റെ ദൈവമേ, എന്നെ കാത്തുസംരക്ഷിക്കണമേ,","poem":1},{"text":"അങ്ങയിലാണല്ലോ ഞാൻ അഭയം തേടിയിരിക്കുന്നത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ഞാൻ യഹോവയോട്, “അങ്ങാണെന്റെ കർത്താവ്;","poem":1},{"text":"അവിടന്നൊഴികെ എനിക്കൊരു നന്മയുമില്ല” എന്നു പറഞ്ഞു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ഭൂമിയിലുള്ള ദൈവഭക്തരെക്കുറിച്ച്,","poem":1},{"noteId":19},{"text":"“അവർ ആദരണീയരാണ്","poem":1},{"text":"അവരിൽ ഞാൻ ആനന്ദം കണ്ടെത്തുന്നു” എന്നു പറഞ്ഞു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അന്യദേവന്മാരെ പിൻതുടരുന്നവരുടെ ആകുലതകൾ അനവധിയായിരിക്കും.","poem":1},{"text":"ഞാൻ അവർക്കു രക്തബലിതർപ്പണം നടത്തുകയോ","poem":2},{"lineBreak":true},{"text":"അവരുടെ നാമങ്ങൾ എന്റെ അധരങ്ങളിൽ ഉച്ചരിക്കുകയോ ചെയ്യുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"യഹോവേ, അങ്ങുമാത്രമാണ് എന്റെ ഓഹരി, എന്റെ പാനപാത്രം;","poem":1},{"text":"അവിടന്ന് എന്റെ ഭാഗധേയം സുരക്ഷിതമാക്കിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അളവുനൂൽ എനിക്കു മനോഹരദേശത്തു വീണിരിക്കുന്നു;","poem":1},{"text":"അതേ, മനോഹരമായ ഒരു ഓഹരി എനിക്കു ലഭിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"എനിക്കു ബുദ്ധിയുപദേശം നൽകുന്ന യഹോവയെ ഞാൻ വാഴ്ത്തും;","poem":1},{"text":"രാത്രിയിലും എന്റെ ഹൃദയം എന്നെ പ്രബോധിപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ഞാൻ യഹോവയെ എന്റെമുമ്പിൽ എപ്പോഴും പ്രതിഷ്ഠിച്ചിരിക്കുന്നു;","poem":1},{"text":"അവിടന്ന് എന്റെ വലതുഭാഗത്തുള്ളതുകൊണ്ട് ഞാൻ കുലുങ്ങിപ്പോകുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"അതുകൊണ്ട് എന്റെ ഹൃദയം ആനന്ദിക്കുന്നു, എന്റെ നാവ് ആഹ്ലാദിക്കുന്നു;","poem":1},{"text":"എന്റെ ശരീരവും സുരക്ഷിതമായി വിശ്രമിക്കും,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"എന്റെ പ്രാണനെ അവിടന്ന് പാതാളത്തിൽ ഉപേക്ഷിക്കുകയില്ല,","poem":1},{"text":"അവിടത്തെ പരിശുദ്ധനെ","poem":2},{"noteId":20},{"text":"ജീർണത കാണാൻ അനുവദിക്കുകയുമില്ല.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ജീവന്റെ പാത അവിടന്ന് എന്നെ അറിയിക്കുന്നു;","poem":1},{"text":"തിരുസന്നിധിയിൽ അവിടന്ന് എന്നെ ആനന്ദത്താൽ നിറയ്ക്കും,","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ വലതുഭാഗത്ത് എന്നും പ്രമോദങ്ങളുണ്ട്.","poem":2},{"noteId":21}]}],"footnotes":[{"noteId":19,"caller":"+","text":"മൂ.ഭാ. വിശുദ്ധരെക്കുറിച്ച്","reference":{"chapter":16,"verse":3}},{"noteId":20,"caller":"+","text":"അഥവാ, വിശ്വസ്തരെ","reference":{"chapter":16,"verse":10}},{"noteId":21,"caller":"+","text":"അ.പ്ര. 2:28","reference":{"chapter":16,"verse":11}}]},"thisChapterLink":"/api/mal_bib/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}