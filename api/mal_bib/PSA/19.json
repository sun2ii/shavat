{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":19,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"ആകാശം ദൈവത്തിന്റെ മഹത്ത്വം പ്രകീർത്തിക്കുന്നു;","poem":1},{"text":"ആകാശവിതാനം അവിടത്തെ കരവിരുത് വിളംബരംചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"പകൽ പകലിനോട് നിരന്തരം സംസാരിക്കുന്നു;","poem":1},{"text":"രാത്രി രാത്രിക്ക് വിജ്ഞാനം പകരുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവിടെ സംഭാഷണമില്ല, വാക്കുകളില്ല;","poem":1},{"text":"ശബ്ദാരവം കേൾക്കാനുമില്ല.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"എന്നിട്ടും അവയുടെ സ്വരമാധുര്യം","poem":1},{"noteId":29},{"text":"ഭൂതലമെങ്ങും പരക്കുന്നു,","poem":1},{"text":"അവയുടെ വാക്കുകൾ ലോകത്തിന്റെ അതിർത്തിവരെയും ചെന്നെത്തുന്നു.","poem":2},{"text":"ആകാശത്തിൽ ദൈവം സൂര്യനൊരു കൂടാരം അടിച്ചിരിക്കുന്നു.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"അതു മണിയറയിൽനിന്നു പുറത്തേക്കുവരുന്ന മണവാളനെപ്പോലെയും","poem":2},{"lineBreak":true},{"text":"തന്റെ ഓട്ടം ഓടിത്തികയ്ക്കുന്നതിൽ ആനന്ദിക്കുന്ന വീരശൂരനെപ്പോലെയുമാണ്.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ആകാശത്തിന്റെ ഒരു കോണിലത് ഉദയംചെയ്യുന്നു","poem":1},{"text":"മറ്റേക്കോണിലേക്ക് അത് അതിന്റെ പ്രയാണം തുടരുന്നു;","poem":2},{"lineBreak":true},{"text":"അതിന്റെ ഉഷ്ണത്തിൽനിന്നോടിയൊളിക്കാൻ ഒന്നിനും കഴിയുന്നില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"യഹോവയുടെ ന്യായപ്രമാണം സമ്പൂർണമാണ്,","poem":1},{"text":"അതു പ്രാണനു നവജീവൻ നൽകുന്നു.","poem":2},{"text":"യഹോവയുടെ നിയമവ്യവസ്ഥകൾ വിശ്വാസയോഗ്യമാണ്,","poem":1},{"text":"അതു ബുദ്ധിഹീനരെ ജ്ഞാനികളാക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"യഹോവയുടെ പ്രമാണങ്ങൾ കുറ്റമറ്റവയാണ്,","poem":1},{"text":"അതു ഹൃദയത്തിന് ആനന്ദമേകുന്നു.","poem":2},{"text":"യഹോവയുടെ ആജ്ഞകൾ പ്രകാശപൂരിതമാകുന്നു,","poem":1},{"text":"അതു കണ്ണുകൾക്ക് വെളിച്ചമേകുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"യഹോവാഭക്തി നിർമലമായത്,","poem":1},{"text":"അത് എന്നെന്നേക്കും നിലനിൽക്കുന്നു.","poem":2},{"text":"യഹോവയുടെ ഉത്തരവുകൾ സുസ്ഥിരമായവ,","poem":1},{"text":"അവയെല്ലാം നീതിയുക്തമായവ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"അതു സ്വർണത്തെക്കാളും","poem":1},{"text":"തങ്കത്തെക്കാളും അമൂല്യമായവ;","poem":2},{"text":"അതു തേനിനെക്കാളും","poem":1},{"text":"തേനടയിലെ തേനിനെക്കാളും മാധുര്യമേറിയത്.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അവയാൽ അവിടത്തെ ദാസനു ശാസനം ലഭിക്കുന്നു;","poem":1},{"text":"അവയെ പാലിക്കുന്നതിൽ മഹത്തായ പ്രതിഫലമുണ്ട്.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"എന്നാൽ സ്വന്തം തെറ്റുകളെ വിവേചിച്ചറിയാൻ ആർക്കാണു സാധിക്കുന്നത്?","poem":1},{"text":"എന്നിൽ മറഞ്ഞിരിക്കുന്ന പാപങ്ങൾ ക്ഷമിക്കണമേ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"മനഃപൂർവമായി ചെയ്യുന്ന പാപങ്ങളിൽനിന്ന് അവിടത്തെ ദാസനെ കാത്തുപാലിക്കണമേ.","poem":1},{"text":"അവ എന്റെമേൽ ആധിപത്യം ഉറപ്പിക്കാതിരിക്കട്ടെ.","poem":2},{"text":"അപ്പോൾ ഞാൻ നിരപരാധിയും","poem":1},{"text":"മഹാപാതകത്തിൽനിന്ന് വിമോചനം കിട്ടിയയാളും ആയിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"എന്റെ പാറയും എന്റെ വീണ്ടെടുപ്പുകാരനുമായ യഹോവേ,","poem":1},{"text":"എന്റെ അധരങ്ങളിലെ വാക്കുകളും എന്റെ ഹൃദയത്തിലെ ധ്യാനവും","poem":2},{"lineBreak":true},{"text":"തൃക്കണ്ണുകൾക്കു സ്വീകാര്യമായിരിക്കട്ടെ.","poem":2}]}],"footnotes":[{"noteId":29,"caller":"+","text":"മൂ.ഭാ. അളവുനൂൽ","reference":{"chapter":19,"verse":4}}]},"thisChapterLink":"/api/mal_bib/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}