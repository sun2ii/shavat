{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":22,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"എന്റെ ദൈവമേ, എന്റെ ദൈവമേ, അവിടന്ന് എന്നെ ഉപേക്ഷിച്ചുകളഞ്ഞതെന്ത്?","poem":1},{"text":"എന്നെ രക്ഷിക്കുന്നതിൽനിന്നും","poem":2},{"lineBreak":true},{"text":"എന്റെ വിലാപവചസ്സുകളിൽനിന്നും വിദൂരസ്ഥനായിരിക്കുന്നതും എന്ത്?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"എന്റെ ദൈവമേ, പകലിൽ ഞാൻ നിലവിളിക്കുന്നു, എന്നാൽ അവിടന്ന് ഉത്തരമരുളുന്നില്ല,","poem":1},{"text":"രാത്രിയിലും ഞാൻ കേഴുന്നു, എന്നാൽ എനിക്ക് ആശ്വാസം ലഭിക്കുന്നതുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ഇസ്രായേലിന്റെ സ്തുതികളിൽ സിംഹാസനസ്ഥനായിരിക്കുന്ന","poem":1},{"text":"അവിടന്ന് പരിശുദ്ധനാണല്ലോ!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ഞങ്ങളുടെ പൂർവികർ അങ്ങയിൽ വിശ്വാസം അർപ്പിച്ചു;","poem":1},{"text":"അവർ ആശ്രയിക്കുകയും അങ്ങ് അവരെ വിടുവിക്കുകയും ചെയ്തു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവർ അങ്ങയോട് നിലവിളിച്ചു; അങ്ങ് അവരെ രക്ഷിച്ചു;","poem":1},{"text":"അവർ അങ്ങയിൽ ആശ്രയിച്ചു, ലജ്ജിതരായതുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"എന്നാൽ ഞാൻ ഒരു മനുഷ്യനല്ല, ഒരു പുഴുവത്രേ.","poem":1},{"text":"മനുഷ്യരുടെ പരിഹാസവും ജനത്താൽ നിന്ദിതനുംതന്നെ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"എന്നെ കാണുന്നവരെല്ലാം എന്നെ പരിഹസിക്കുന്നു;","poem":1},{"text":"അവരെന്നെ അവജ്ഞയോടെ നോക്കുന്നു, തലകുലുക്കി പരിഹസിക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“ഇദ്ദേഹം യഹോവയിൽ ആശ്രയിക്കുന്നു,” അവർ പറയുന്നു,","poem":1},{"text":"“യഹോവതന്നെ അയാളെ മോചിപ്പിക്കട്ടെ.","poem":2},{"text":"യഹോവ അദ്ദേഹത്തിൽ പ്രസാദിക്കുന്നെങ്കിൽ","poem":1},{"text":"അവിടന്നുതന്നെ അദ്ദേഹത്തെ വിടുവിക്കട്ടെ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"അവിടന്നാണല്ലോ എന്നെ എന്റെ അമ്മയുടെ ഉദരത്തിൽനിന്നു പുറത്തുകൊണ്ടുവന്നത്;","poem":1},{"text":"എന്റെ അമ്മയുടെ മുലകുടിക്കുംകാലംമുതലേ എന്നെ സുരക്ഷിതനായി കാത്തതും അങ്ങാണല്ലോ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"എന്റെ അമ്മയുടെ ഉദരത്തിലായിരുന്നപ്പോൾത്തന്നെ ഞാൻ തിരുക്കരങ്ങളിൽ സമർപ്പിക്കപ്പെട്ടു;","poem":1},{"text":"എന്റെ അമ്മയുടെ ഗർഭപാത്രംമുതൽ അവിടന്നാണ് എന്റെ ദൈവം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"കഷ്ടം അടുത്തിരിക്കുകയാലും","poem":1},{"text":"സഹായിക്കാൻ ആരും ഇല്ലാതിരിക്കയാലും","poem":2},{"lineBreak":true},{"text":"എന്നിൽനിന്ന് അകന്നിരിക്കരുതേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"അനേകം കാളകൾ എന്നെ വളഞ്ഞു;","poem":1},{"text":"ബാശാനിലെ ശക്തിയുള്ള കാളക്കൂറ്റന്മാർ എന്നെ വലയംചെയ്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ഗർജിക്കുന്ന സിംഹം ഇരയെ കടിച്ചുകീറുന്നതുപോലെ","poem":1},{"text":"അവരുടെ വായ് എനിക്കെതിരേ പിളർക്കുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ഞാൻ വെള്ളംപോലെ തൂകിപ്പോകുന്നു,","poem":1},{"text":"എന്റെ അസ്ഥികളെല്ലാം ബന്ധംവിട്ടിരിക്കുന്നു.","poem":2},{"text":"എന്റെ ഹൃദയം മെഴുകുപോലെയായി,","poem":1},{"text":"എന്റെയുള്ളിൽ ഉരുകിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"എന്റെ ശക്തി മൺപാത്രക്കഷണംപോലെ ഉണങ്ങിയിരിക്കുന്നു","poem":1},{"text":"എന്റെ നാവ് അണ്ണാക്കിനോട് ഒട്ടിയിരിക്കുന്നു","poem":2},{"lineBreak":true},{"text":"അവിടന്ന് എന്നെ മരണത്തിന്റെ പൊടിയിൽ ഇട്ടുകളഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"നായ്ക്കൾ എന്നെ വളഞ്ഞിരിക്കുന്നു,","poem":1},{"text":"ഒരുകൂട്ടം ദുഷ്ടജനങ്ങൾ എന്നെ വലയംചെയ്തിരിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"അവർ","poem":2},{"noteId":30},{"text":"എന്റെ കൈകളും പാദങ്ങളും കുത്തിത്തുളച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"എന്റെ അസ്ഥികളെല്ലാം എനിക്ക് എണ്ണാം","poem":1},{"text":"അവർ എന്നെ പരിഹാസപൂർവം തുറിച്ചുനോക്കുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"എന്റെ വസ്ത്രം അവർ പകുത്തെടുക്കുന്നു","poem":1},{"text":"എന്റെ പുറങ്കുപ്പായത്തിനായവർ നറുക്കിടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"എന്നാൽ യഹോവേ, അവിടന്ന് അകന്നിരിക്കരുതേ.","poem":1},{"text":"അവിടന്നാണ് എന്റെ ശക്തി; എന്നെ സഹായിക്കാൻ വേഗം വരണമേ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"വാളിൽനിന്ന് എന്നെ രക്ഷിക്കണമേ;","poem":1},{"text":"ഈ നായ്ക്കളുടെ പിടിയിൽനിന്ന് എന്റെ വിലപ്പെട്ട ജീവനെയും!","poem":2}]},{"type":"verse","number":21,"content":[{"text":"സിംഹങ്ങളുടെ വായിൽനിന്നും എന്നെ മോചിപ്പിക്കണമേ;","poem":1},{"text":"കാട്ടുകാളകളുടെ കൊമ്പുകൾക്കിടയിൽനിന്ന് എന്നെ രക്ഷിക്കണമേ.","poem":2},{"noteId":31}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"അവിടത്തെ നാമം ഞാൻ എന്റെ സഹോദരങ്ങളോടു കീർത്തിക്കും;","poem":1},{"text":"സഭയുടെമുമ്പാകെ ഞാൻ അങ്ങയെ സ്തുതിക്കും.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"യഹോവയെ ഭയപ്പെടുന്നവരേ, യഹോവയെ സ്തുതിക്കുക!","poem":1},{"text":"യാക്കോബിന്റെ പിൻഗാമികളായ സകലരുമേ, അവിടത്തെ ആദരിക്കുക!","poem":2},{"lineBreak":true},{"text":"സകല ഇസ്രായേല്യസന്തതികളുമേ, അവിടത്തെ വണങ്ങുക!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"കാരണം പീഡിതരുടെ കഷ്ടത","poem":1},{"text":"അവിടന്ന് അവഗണിക്കുകയോ വെറുക്കുകയോ ചെയ്തില്ല;","poem":2},{"text":"തിരുമുഖം അവർക്കു മറയ്ക്കുകയോ ചെയ്തില്ല","poem":1},{"text":"എന്നാൽ സഹായത്തിനായുള്ള അവരുടെ നിലവിളി കേൾക്കുകയും ചെയ്തിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"മഹാസഭയിൽ എന്റെ പ്രശംസാവിഷയം അങ്ങല്ലോ;","poem":1},{"text":"അങ്ങയെ ആദരിക്കുന്നവരുടെമുമ്പാകെ ഞാൻ എന്റെ നേർച്ചകൾ കഴിക്കും.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ദരിദ്രർ ഭക്ഷിച്ചു തൃപ്തരാകും","poem":1},{"text":"യഹോവയെ അന്വേഷിക്കുന്നവർ അവിടത്തെ സ്തുതിക്കും.","poem":2},{"lineBreak":true},{"text":"അവരുടെ ഹൃദയം എന്നേക്കും സന്തുഷ്ടമായിരിക്കട്ടെ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ഭൂമിയുടെ അതിരുകളെല്ലാം","poem":1},{"text":"യഹോവയെ ഓർത്ത് തിരുസന്നിധിയിലേക്കു തിരിയും,","poem":2},{"text":"രാഷ്ട്രങ്ങളിലെ കുടുംബങ്ങളെല്ലാം","poem":1},{"text":"തിരുമുമ്പിൽ സാഷ്ടാംഗം പ്രണമിക്കും,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ആധിപത്യം യഹോവയ്ക്കുള്ളത്","poem":1},{"text":"അവിടന്ന് സകലരാഷ്ട്രങ്ങളിലും വാഴുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ഭൂമിയിലെ സകലസമ്പന്നരും ഭക്ഷിച്ച് ആരാധിക്കട്ടെ","poem":1},{"text":"പൊടിയിലേക്കിറങ്ങുന്നവർ അവിടത്തെ മുമ്പിൽ മുട്ടുമടക്കും—","poem":2},{"lineBreak":true},{"text":"സ്വന്തം ജീവൻ നിലനിർത്താൻ കഴിയാത്തവർതന്നെ.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ഒരു സന്തതി അവിടത്തെ സേവിക്കും","poem":1},{"text":"ഭാവിതലമുറകളോട് കർത്താവിനെപ്പറ്റി വർണിക്കും.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"അവിടന്ന് നിവർത്തിച്ചിരിക്കുന്നു!","poem":1},{"text":"എന്ന് ഇനിയും ജനിക്കാനിരിക്കുന്ന തലമുറയോട്,","poem":2},{"lineBreak":true},{"text":"അവർ അവിടത്തെ നീതി വിളംബരംചെയ്യും.","poem":2}]}],"footnotes":[{"noteId":30,"caller":"+","text":"ചി.കൈ.പ്ര. ഒരു സിംഹം ചെയ്യുന്നതുപോലെ അവർ","reference":{"chapter":22,"verse":16}},{"noteId":31,"caller":"+","text":"അഥവാ, എനിക്ക് ഉത്തരമരുളണമേ.","reference":{"chapter":22,"verse":21}}]},"thisChapterLink":"/api/mal_bib/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}