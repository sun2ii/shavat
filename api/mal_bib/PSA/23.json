{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"യഹോവ എന്റെ ഇടയൻ ആകുന്നു, എനിക്ക് ഒന്നിനും കുറവുണ്ടാകുകയില്ല.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"പച്ചപ്പുൽമേടുകളിൽ അവിടന്ന് എന്നെ കിടത്തുന്നു,","poem":2},{"text":"പ്രശാന്തമായ ജലാശയങ്ങളിലേക്ക് അവിടന്ന് എന്നെ നയിക്കുന്നു,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"എന്റെ പ്രാണന് അവിടന്ന് നവജീവൻ പകരുന്നു.","poem":2},{"text":"തിരുനാമംനിമിത്തം","poem":1},{"text":"എന്നെ നീതിപാതകളിൽ നടത്തുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"മരണനിഴലിൻ","poem":1},{"noteId":32},{"text":"താഴ്വരയിൽക്കൂടി","poem":1},{"text":"ഞാൻ സഞ്ചരിച്ചെന്നാലും,","poem":2},{"text":"ഒരു അനർഥവും ഞാൻ ഭയപ്പെടുകയില്ല,","poem":1},{"text":"എന്നോടൊപ്പം അവിടന്നുണ്ടല്ലോ;","poem":2},{"text":"അവിടത്തെ വടിയും കോലും","poem":1},{"text":"എന്നെ ആശ്വസിപ്പിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"എന്റെ ശത്രുക്കളുടെമുമ്പിൽ,","poem":1},{"text":"അങ്ങ് എനിക്കൊരു വിരുന്നൊരുക്കുന്നു.","poem":2},{"text":"എന്റെ ശിരസ്സിൽ അവിടന്ന് തൈലാഭിഷേകം നടത്തുന്നു;","poem":1},{"text":"എന്റെ പാനപാത്രം കവിഞ്ഞൊഴുകുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"എന്റെ ആയുഷ്കാലമെല്ലാം","poem":1},{"text":"നന്മയും കരുണയും എന്നെ പിൻതുടരും, നിശ്ചയം,","poem":2},{"text":"ഞാൻ യഹോവയുടെ ആലയത്തിൽ","poem":1},{"text":"നിത്യം വസിക്കും.","poem":2}]}],"footnotes":[{"noteId":32,"caller":"+","text":"അഥവാ, കൂരിരുട്ടിൻ","reference":{"chapter":23,"verse":4}}]},"thisChapterLink":"/api/mal_bib/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}