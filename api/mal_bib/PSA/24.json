{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":24,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"ഭൂമിയും അതിലുള്ള സകലതും യഹോവയ്ക്കുള്ളത്,","poem":1},{"text":"ഭൂലോകവും അതിൽ അധിവസിക്കുന്ന സകലരും;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"കാരണം, സമുദ്രത്തിന്മേൽ അവിടന്ന് അതിന് അടിസ്ഥാനമിടുകയും","poem":1},{"text":"ജലവിതാനങ്ങൾക്കുമേൽ അത് സ്ഥാപിക്കുകയും ചെയ്തിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"യഹോവയുടെ പർവതത്തിൽ ആരാണ് കയറിച്ചെല്ലുക?","poem":1},{"text":"അവിടത്തെ വിശുദ്ധസ്ഥാനത്ത് ആരാണ് നിൽക്കുക?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"വെടിപ്പുള്ള കൈകളും നിർമലഹൃദയവുമുള്ളവർ,","poem":1},{"text":"വിഗ്രഹത്തിൽ ആശ്രയിക്കാതെയും","poem":2},{"lineBreak":true},{"text":"വ്യാജശപഥം","poem":2},{"noteId":33},{"text":"ചെയ്യാതെയുമിരിക്കുന്നവർതന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"അവർ യഹോവയിൽനിന്നുള്ള അനുഗ്രഹം ആസ്വദിക്കുകയും","poem":1},{"text":"അവരുടെ രക്ഷകനായ ദൈവത്തിൽനിന്നു കുറ്റവിമുക്തി പ്രാപിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഇങ്ങനെയുള്ളവരാകുന്നു അങ്ങയെ അന്വേഷിക്കുന്നവരുടെ തലമുറ,","poem":1},{"text":"യാക്കോബിന്റെ ദൈവമേ, തിരുമുഖം തേടുന്നവർ ഇവർതന്നെ. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"കവാടങ്ങളേ, നിങ്ങളുടെ ശിരസ്സ് ഉയർത്തുക;","poem":1},{"text":"പുരാതന കവാടങ്ങളേ, ഉയരുക,","poem":2},{"lineBreak":true},{"text":"മഹത്ത്വത്തിന്റെ രാജാവ് പ്രവേശിക്കട്ടെ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"മഹത്ത്വത്തിന്റെ രാജാവ് ആരാണ്?","poem":1},{"text":"ശക്തനും വീരനുമായ യഹോവ,","poem":2},{"lineBreak":true},{"text":"യുദ്ധവീരനായ യഹോവതന്നെ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"കവാടങ്ങളേ, നിങ്ങളുടെ ശിരസ്സ് ഉയർത്തുക;","poem":1},{"text":"പുരാതന കവാടങ്ങളേ, ഉയരുക,","poem":2},{"lineBreak":true},{"text":"മഹത്ത്വത്തിന്റെ രാജാവ് പ്രവേശിക്കട്ടെ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"മഹത്ത്വത്തിന്റെ രാജാവ് ആരാണ്?","poem":1},{"text":"സൈന്യങ്ങളുടെ യഹോവ—","poem":2},{"lineBreak":true},{"text":"അവിടന്നാണ് മഹത്ത്വത്തിന്റെ രാജാവ്. സേലാ.","poem":2}]}],"footnotes":[{"noteId":33,"caller":"+","text":"അഥവാ, വ്യാജദേവതകളെക്കൊണ്ട്","reference":{"chapter":24,"verse":4}}]},"thisChapterLink":"/api/mal_bib/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}