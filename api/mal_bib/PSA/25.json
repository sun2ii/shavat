{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":25,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"യഹോവേ, അങ്ങയിലേക്ക്","poem":1},{"text":"ഞാൻ എന്റെ മനസ്സ് ഉയർത്തുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"എന്റെ ദൈവമേ, ഞാൻ അങ്ങയിൽ ആശ്രയിക്കുന്നു;","poem":1},{"text":"എന്നെ ലജ്ജയിലേക്കു തള്ളിയിടരുതേ,","poem":2},{"lineBreak":true},{"text":"എന്റെ ശത്രുക്കൾ എന്റെമേൽ ജയഘോഷം മുഴക്കാൻ അനുവദിക്കരുതേ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അങ്ങയിൽ പ്രത്യാശവെച്ചിരിക്കുന്നവരാരും","poem":1},{"text":"ഒരിക്കലും ലജ്ജിച്ചുപോകുകയില്ല,","poem":2},{"text":"എന്നാൽ അകാരണമായി വഞ്ചിക്കുന്നവർ","poem":1},{"text":"ലജ്ജിതരായിത്തീരട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"യഹോവേ, അങ്ങയുടെ വഴി എന്നെ മനസ്സിലാക്കിത്തരുമാറാകണമേ,","poem":1},{"text":"അവിടത്തെ പാത എന്നെ പഠിപ്പിക്കണമേ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അങ്ങയുടെ സത്യത്തിൽ എന്നെ നയിക്കുകയും പഠിപ്പിക്കുകയും ചെയ്യണമേ,","poem":1},{"text":"കാരണം അവിടന്നാണല്ലോ എന്റെ രക്ഷയുടെ ദൈവം,","poem":2},{"lineBreak":true},{"text":"ദിവസംമുഴുവനും ഞാൻ അങ്ങയിൽ പ്രത്യാശവെക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"യഹോവേ, അവിടത്തെ ആർദ്രകരുണയും അചഞ്ചലസ്നേഹവും ഓർക്കണമേ,","poem":1},{"text":"അത് പുരാതനകാലംമുതലേ ഉള്ളതാണല്ലോ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"എന്റെ യൗവനകാല പാപങ്ങളും","poem":1},{"text":"എന്റെ ലംഘനങ്ങളും ഓർമിക്കരുതേ;","poem":2},{"text":"അവിടത്തെ അചഞ്ചലസ്നേഹത്താൽ എന്നെ ഓർക്കണമേ,","poem":1},{"text":"കാരണം യഹോവേ, അവിടന്ന് നല്ലവനല്ലോ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"യഹോവ നല്ലവനും നീതിനിഷ്ഠനും ആകുന്നു;","poem":1},{"text":"അതുകൊണ്ട് പാപികൾക്ക് അവിടന്ന് തന്റെ വഴി ഉപദേശിച്ചുകൊടുക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"വിനയാന്വിതരെ അവിടന്ന് നീതിമാർഗത്തിൽ നയിക്കുന്നു","poem":1},{"text":"തന്റെ വഴി അവരെ പഠിപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവിടത്തെ ഉടമ്പടിയിലെ വ്യവസ്ഥകൾ പാലിക്കുന്നവരെ","poem":1},{"text":"യഹോവ അചഞ്ചലസ്നേഹത്തോടും വിശ്വസ്തതയോടുംകൂടെ നയിക്കുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"എന്റെ അകൃത്യങ്ങൾ, അതെത്ര വലുതായാലും","poem":1},{"text":"യഹോവേ, തിരുനാമത്തെപ്രതി അവ ക്ഷമിക്കണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"യഹോവയെ ഭയപ്പെടുന്ന മനുഷ്യർ ആരെല്ലാമാണ്?","poem":1},{"text":"അവർ തെരഞ്ഞെടുക്കേണ്ട വഴി അവിടന്ന് അവർക്ക് ഉപദേശിച്ചുകൊടുക്കും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അവർ തങ്ങളുടെ ദിനങ്ങൾ അഭിവൃദ്ധിയിൽ ജീവിക്കും","poem":1},{"text":"അവരുടെ സന്തതികൾ ദേശത്തെ അവകാശമാക്കും.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"യഹോവയെ ഭയപ്പെടുന്നവർക്ക് അവിടന്ന് തന്റെ രഹസ്യം വെളിപ്പെടുത്തുന്നു;","poem":1},{"text":"അവിടന്ന് തന്റെ ഉടമ്പടിയുടെ ജ്ഞാനം അവർക്കു പകരുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"എന്റെ ദൃഷ്ടി എപ്പോഴും യഹോവയുടെമേൽ ആകുന്നു,","poem":1},{"text":"കാരണം അവിടന്ന് എന്നെ എന്റെ ശത്രുവിന്റെ കെണിയിൽനിന്നു മോചിപ്പിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"എന്റെനേർക്കു തിരിഞ്ഞ് എന്നോട് കരുണയുണ്ടാകണമേ,","poem":1},{"text":"കാരണം, ഞാൻ ഏകാകിയും പീഡിതനും ആകുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"എന്റെ ഹൃദയവ്യഥ അത്യന്തം വർധിച്ചിരിക്കുന്നു","poem":1},{"text":"എന്റെ ദുരിതങ്ങളിൽനിന്ന് എന്നെ വിടുവിക്കണമേ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"എന്റെ അരിഷ്ടതയും ദുരിതവും ശ്രദ്ധിക്കണമേ","poem":1},{"text":"എന്റെ പാപങ്ങളെല്ലാം ക്ഷമിക്കണമേ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"എന്റെ ശത്രുക്കൾ എത്ര അസംഖ്യമെന്ന് നോക്കണമേ","poem":1},{"text":"അവരെന്നെ എത്ര കഠിനമായി വെറുക്കുന്നു!","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"എന്റെ ജീവനെ കാത്ത് എന്നെ മോചിപ്പിക്കണമേ;","poem":1},{"text":"എന്നെ ലജ്ജയിലേക്കു തള്ളിയിടരുതേ,","poem":2},{"lineBreak":true},{"text":"കാരണം അങ്ങയിൽ ഞാൻ അഭയംതേടുന്നു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"പരമാർഥതയും നീതിനിഷ്ഠയും എന്നെ കാത്തുസംരക്ഷിക്കട്ടെ,","poem":1},{"text":"കാരണം യഹോവേ, എന്റെ പ്രത്യാശ അങ്ങയിൽ ആകുന്നല്ലോ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ദൈവമേ, ഇസ്രായേലിനെ വീണ്ടെടുക്കണമേ,","poem":1},{"text":"അവരുടെ സകലവിധ ദുരിതങ്ങളിൽനിന്നുംതന്നെ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}