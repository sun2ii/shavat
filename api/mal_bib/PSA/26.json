{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"യഹോവേ, എന്നെ കുറ്റവിമുക്തനാക്കണമേ,","poem":1},{"text":"ഞാൻ നിഷ്കളങ്കജീവിതം നയിക്കുന്നു;","poem":2},{"text":"യഹോവേ, ഞാൻ അങ്ങയിൽ വിശ്വാസം അർപ്പിച്ചിരിക്കുന്നു","poem":1},{"text":"യാതൊരു ചാഞ്ചല്യവുമില്ല.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"യഹോവേ, എന്നെ പരീക്ഷിക്കുകയും പരിശോധിക്കുകയും ചെയ്യണമേ,","poem":1},{"text":"എന്റെ ഹൃദയവും എന്റെ അന്തരംഗവും പരിശോധിക്കണമേ;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവിടത്തെ അചഞ്ചലസ്നേഹം എപ്പോഴും എന്റെ മുമ്പിലുണ്ട്","poem":1},{"text":"അവിടത്തെ സത്യാനുസാരം ഞാൻ ജീവിച്ചുമിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"വഞ്ചകരോടുകൂടെ ഞാൻ ഇരിക്കുകയോ","poem":1},{"text":"കപടഭക്തരോട് ഞാൻ സഹകരിക്കുകയോ ചെയ്യുന്നില്ല.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അധർമം പ്രവർത്തിക്കുന്നവരുടെ സംഘത്തെ ഞാൻ വെറുക്കുന്നു","poem":1},{"text":"ദുഷ്ടരോടൊപ്പം ഞാൻ ഇരിക്കുകയുമില്ല.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"നിഷ്കളങ്കതയിൽ ഞാൻ എന്റെ കൈകൾ കഴുകുന്നു,","poem":1},{"text":"യഹോവേ, അങ്ങയുടെ യാഗപീഠത്തെ ഞാൻ വലയംവെക്കുന്നു,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അങ്ങയുടെ സ്തുതി ഞാൻ ഉച്ചത്തിൽ ഉദ്ഘോഷിക്കുകയും","poem":1},{"text":"അവിടത്തെ അത്ഭുതപ്രവൃത്തികളെല്ലാം വർണിക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"യഹോവേ, അങ്ങ് അധിവസിക്കുന്ന ആലയവും","poem":1},{"text":"അവിടത്തെ മഹത്ത്വത്തിന്റെ നിവാസസ്ഥാനവും ഞാൻ ഇഷ്ടപ്പെടുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"പാപികളോടൊപ്പം എന്റെ പ്രാണനെയും","poem":1},{"text":"രക്തദാഹികളോടൊപ്പം എന്റെ ജീവനെയും എടുത്തുകളയരുതേ,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവരുടെപക്കൽ കുതന്ത്രങ്ങളുണ്ട്,","poem":1},{"text":"അവരുടെ വലതുകരം കോഴകൊണ്ട് നിറഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"എന്നാൽ ഞാൻ സത്യസന്ധമായ ഒരു ജീവിതം പിൻതുടരുന്നു;","poem":1},{"text":"എന്നെ വീണ്ടെടുക്കണമേ, എന്നോട് കരുണയുണ്ടാകണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"എന്റെ പാദങ്ങൾ സമനിലത്ത് ഉറച്ചുനിൽക്കുന്നു;","poem":1},{"text":"മഹാസഭയിൽ ഞാൻ യഹോവയെ വാഴ്ത്തും.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}