{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":27,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"യഹോവ എന്റെ പ്രകാശവും എന്റെ രക്ഷയും ആകുന്നു—","poem":1},{"text":"ഞാൻ ആരെ ഭയപ്പെടും?","poem":2},{"text":"യഹോവ എന്റെ ജീവന്റെ അഭയസ്ഥാനം—","poem":1},{"text":"ഞാൻ ആരെ പേടിക്കും?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"എന്നെ വിഴുങ്ങുന്നതിനായി","poem":1},{"text":"ദുഷ്ടർ എനിക്കെതിരേ പാഞ്ഞടുക്കുമ്പോൾ,","poem":2},{"text":"എന്റെ ശത്രുക്കളും വിരോധികളും എന്നെ ആക്രമിക്കുമ്പോൾ","poem":1},{"text":"അവരാണ് കാലിടറി നിലംപൊത്തുന്നത്!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ഒരു സൈന്യം എനിക്കെതിരേ ഉപരോധം തീർക്കുമ്പോൾ","poem":1},{"text":"എന്റെ ഹൃദയം ഭയരഹിതമായിരിക്കും,","poem":2},{"text":"എനിക്കെതിരേ ഒരു യുദ്ധം പൊട്ടിപ്പുറപ്പെട്ടാലും","poem":1},{"text":"ഞാൻ ചഞ്ചലചിത്തനാകുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"യഹോവയോട് ഞാൻ ഒരു കാര്യം അപേക്ഷിക്കുന്നു;","poem":1},{"text":"ഇതുതന്നെയാണെന്റെ ആഗ്രഹവും:","poem":2},{"text":"യഹോവയുടെ മനോഹാരിത ദർശിക്കുന്നതിനും","poem":1},{"text":"അവിടത്തെ ആലയത്തിൽ ധ്യാനിക്കുന്നതിനുമായി","poem":2},{"text":"എന്റെ ജീവിതകാലംമുഴുവൻ","poem":1},{"text":"യഹോവയുടെ ആലയത്തിൽ അധിവസിക്കുന്നതിനുതന്നെ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അനർഥദിവസത്തിൽ അവിടന്ന്","poem":1},{"text":"തന്റെ തിരുനിവാസത്തിൽ എനിക്കു സംരക്ഷണം നൽകും;","poem":2},{"text":"അവിടന്ന് തന്റെ കൂടാരത്തിൽ എന്നെ ഒളിപ്പിക്കും","poem":1},{"text":"ഒരു പാറമേൽ എന്നെ ഉയർത്തിനിർത്തും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"അപ്പോൾ എന്റെ ശിരസ്സ്","poem":1},{"text":"എന്നെ വലയംചെയ്യുന്ന ശത്രുക്കൾക്കുമീതേ ഉയർന്നുനിൽക്കും;","poem":2},{"text":"ആനന്ദഘോഷത്തോടുകൂടി അവിടത്തെ കൂടാരത്തിൽ ഞാൻ യാഗം അർപ്പിക്കും;","poem":1},{"text":"ഞാൻ വാദ്യഘോഷത്തോടെ യഹോവയ്ക്ക് പാടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"യഹോവേ, ഞാൻ വിളിച്ചപേക്ഷിക്കുമ്പോൾ എന്റെ ശബ്ദം കേൾക്കണമേ;","poem":1},{"text":"എന്നോടു കരുണതോന്നി എനിക്കുത്തരമരുളണമേ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“അങ്ങയുടെ മുഖമന്വേഷിക്കുക!” എന്റെ ഹൃദയം അങ്ങയെപ്പറ്റി എന്നോട് മന്ത്രിക്കുന്നു.","poem":1},{"text":"യഹോവേ, തിരുമുഖം ഞാൻ അന്വേഷിക്കും.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അങ്ങയുടെ മുഖം എന്നിൽനിന്നും മറയ്ക്കരുതേ,","poem":1},{"text":"കോപത്തോടെ അങ്ങയുടെ ദാസനെ തള്ളിക്കളയരുതേ;","poem":2},{"lineBreak":true},{"text":"അവിടന്നാണല്ലോ എന്റെ സഹായകൻ.","poem":2},{"text":"എന്റെ രക്ഷകനായ ദൈവമേ,","poem":1},{"text":"എന്നെ കൈവിടുകയോ ഉപേക്ഷിക്കുകയോ ചെയ്യരുതേ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"എന്റെ മാതാവും പിതാവും എന്നെ ഉപേക്ഷിച്ചാലും","poem":1},{"text":"യഹോവ എന്നെ ചേർത്തണയ്ക്കും.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"യഹോവേ, അവിടത്തെ വഴി എന്നെ പഠിപ്പിക്കണമേ;","poem":1},{"text":"എനിക്കായ് പതിയിരിക്കുന്നവർനിമിത്തം","poem":2},{"lineBreak":true},{"text":"എന്നെ നേർപാതകളിൽ നടത്തണമേ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"എന്റെ ശത്രുക്കളുടെ ആഗ്രഹത്തിന് എന്നെ ഏൽപ്പിച്ചുകൊടുക്കരുതേ,","poem":1},{"text":"കാരണം എനിക്കെതിരേ കള്ളസാക്ഷികൾ എഴുന്നേറ്റിരിക്കുന്നു,","poem":2},{"lineBreak":true},{"text":"അവർ എനിക്കെതിരേ ക്രൂരത നിശ്വസിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ഒരു കാര്യത്തിലെനിക്ക് ഉത്തമ വിശ്വാസമുണ്ട്:","poem":1},{"text":"ജീവനുള്ളവരുടെ ദേശത്ത്","poem":2},{"lineBreak":true},{"text":"യഹോവയുടെ നന്മ ഞാൻ ദർശിക്കും.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"യഹോവയ്ക്കായി കാത്തിരിക്കുക;","poem":1},{"text":"ശക്തരായിരിക്കുക, സുധീരരായിരിക്കുക","poem":2},{"lineBreak":true},{"text":"യഹോവയ്ക്കായി കാത്തിരിക്കുക.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}