{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":29,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"ദൈവപുത്രന്മാരേ, യഹോവയ്ക്കു കൊടുക്കുക,","poem":1},{"text":"യഹോവയ്ക്കു മഹത്ത്വവും ശക്തിയും കൊടുക്കുക.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"യഹോവയ്ക്ക് അവിടത്തെ നാമത്തിനുതക്ക മഹത്ത്വംകൊടുക്കുക;","poem":1},{"text":"യഹോവയുടെ വിശുദ്ധിയുടെ പ്രതാപത്തിന് അനുസൃതമായി അവിടത്തെ ആരാധിക്കുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"യഹോവയുടെ ശബ്ദം ആഴിക്കുമീതേ മുഴങ്ങുന്നു;","poem":1},{"text":"മഹത്ത്വത്തിന്റെ ദൈവം ഇടിമുഴക്കുന്നു,","poem":2},{"lineBreak":true},{"text":"യഹോവയുടെ ശബ്ദം പെരുവെള്ളത്തിനുമീതേ മുഴങ്ങുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"യഹോവയുടെ ശബ്ദം ശക്തിയുള്ളതാണ്;","poem":1},{"text":"യഹോവയുടെ ശബ്ദം പ്രതാപമേറിയതാണ്.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"യഹോവയുടെ ശബ്ദം ദേവദാരുക്കളെ പിളർക്കുന്നു","poem":1},{"text":"യഹോവ ലെബാനോനിലെ ദേവദാരുക്കളെ തകർക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവിടന്ന് ലെബാനോനെ ഒരു കാളക്കിടാവിനെപ്പോലെ തുള്ളിച്ചാടിക്കുന്നു,","poem":1},{"text":"ശിര്യോനെ","poem":2},{"noteId":34},{"text":"ഒരു കാട്ടുകാളക്കിടാവിനെപ്പോലെയും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"യഹോവയുടെ ശബ്ദം","poem":1},{"text":"അഗ്നിജ്വാലകളെ ഉതിർക്കുന്നു","poem":2}]},{"type":"verse","number":8,"content":[{"text":"യഹോവയുടെ ശബ്ദം മരുഭൂമിയെ പ്രകമ്പനംകൊള്ളിക്കുന്നു;","poem":1},{"text":"യഹോവ കാദേശ് മരുഭൂമിയെ നടുക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"യഹോവയുടെ ശബ്ദം വന്മരങ്ങളെ ചുഴറ്റുന്നു","poem":1},{"noteId":35},{"text":"വനത്തെ തോലുരിച്ച് നഗ്നമാക്കുന്നു.","poem":2},{"text":"കർത്താവിന്റെ ആലയത്തിൽ എല്ലാവരും “മഹത്ത്വം!” എന്ന് ആർപ്പിടുന്നു.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"യഹോവ ജലപ്രളയത്തിനുമീതേ സിംഹാസനസ്ഥനായിരിക്കുന്നു","poem":1},{"text":"യഹോവ എന്നേക്കും രാജാവായി വാഴുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"യഹോവ തന്റെ ജനത്തിനു ശക്തിനൽകുന്നു;","poem":1},{"text":"യഹോവ തന്റെ ജനത്തിനു സമാധാനമരുളി അനുഗ്രഹിക്കുന്നു.","poem":2}]}],"footnotes":[{"noteId":34,"caller":"+","text":"അതായത്, ഹെർമോൻ പർവതത്തെ","reference":{"chapter":29,"verse":6}},{"noteId":35,"caller":"+","text":"അഥവാ, ശബ്ദം മാൻപേടകളെ പ്രസവിക്കുമാറാക്കുന്നു","reference":{"chapter":29,"verse":9}}]},"thisChapterLink":"/api/mal_bib/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}