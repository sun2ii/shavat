{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":31,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"യഹോവേ, ഞാൻ അങ്ങയിൽ അഭയംതേടുന്നു;","poem":1},{"text":"ഞാൻ ഒരുനാളും ലജ്ജിച്ചുപോകരുതേ;","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ നീതിയിൽ എന്നെ വിടുവിക്കണമേ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അങ്ങയുടെ ചെവി എന്നിലേക്കു ചായ്ച്ച്,","poem":1},{"text":"എന്നെ മോചിപ്പിക്കാൻ വേഗം വരണമേ;","poem":2},{"text":"അങ്ങ് എനിക്ക് അഭയമാകുന്ന പാറയും","poem":1},{"text":"എന്നെ രക്ഷിക്കുന്ന ഉറപ്പുള്ള കോട്ടയും ആകണമേ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അങ്ങ് എന്റെ പാറയും കോട്ടയും ആകുകയാൽ","poem":1},{"text":"തിരുനാമമഹത്ത്വത്തിനായി എനിക്കു വഴികാട്ടണമേ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"എന്റെ ശത്രുക്കൾ എനിക്കായി ഒരുക്കിയിരിക്കുന്ന കെണിയിൽനിന്നും എന്നെ വിടുവിക്കണമേ,","poem":1},{"text":"കാരണം അവിടന്ന് എന്റെ സങ്കേതം ആകുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ഞാൻ എന്റെ ആത്മാവിനെ തിരുക്കരങ്ങളിൽ ഭരമേൽപ്പിക്കുന്നു;","poem":1},{"text":"വിശ്വസ്തദൈവമായ യഹോവേ, എന്നെ മോചിപ്പിക്കണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"മിഥ്യാമൂർത്തികളെ ഭജിക്കുന്നവരെ ഞാൻ വെറുക്കുന്നു;","poem":1},{"text":"എന്നാൽ ഞാൻ യഹോവയിൽ ആശ്രയിക്കുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അങ്ങയുടെ അചഞ്ചലസ്നേഹത്തിൽ ഞാൻ ആഹ്ലാദിക്കുകയും ആനന്ദിക്കുകയും ചെയ്യും,","poem":1},{"text":"കാരണം അവിടന്ന് എന്റെ ദുരിതം കണ്ടിരിക്കുന്നു","poem":2},{"lineBreak":true},{"text":"എന്റെ ആത്മവ്യഥ അറിഞ്ഞുമിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ശത്രുവിന്റെ കൈയിൽ അവിടന്ന് എന്നെ ഏൽപ്പിച്ചില്ല","poem":1},{"text":"എന്നാൽ എന്റെ പാദങ്ങളെ അങ്ങ് വിശാലസ്ഥലത്ത് ഉറപ്പിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"യഹോവേ, ഞാൻ ദുരിതത്തിലായിരിക്കുകയാൽ എന്നോടു കരുണ കാണിക്കണമേ;","poem":1},{"text":"എന്റെ കണ്ണുകൾ ദുഃഖത്താൽ തളർന്നിരിക്കുന്നു,","poem":2},{"lineBreak":true},{"text":"എന്റെ പ്രാണനും ശരീരവും വ്യസനത്താൽ തകർന്നുമിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"എന്റെ ജീവിതം മനഃപീഡയാൽ പാഴായിപ്പോകുന്നു","poem":1},{"text":"എന്റെ ആയുസ്സ് നെടുവീർപ്പിനാലും;","poem":2},{"text":"എന്റെ അതിക്രമങ്ങൾമൂലം എന്റെ ശക്തി ക്ഷയിക്കുന്നു,","poem":1},{"text":"എന്റെ അസ്ഥികൾ ദ്രവിച്ചുപോകുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"എന്റെ എല്ലാ ശത്രുക്കളുംനിമിത്തം,","poem":1},{"text":"ഞാൻ എന്റെ അയൽവാസികൾക്ക് കടുത്ത അവഹേളനപാത്രമായിരിക്കുന്നു.","poem":2},{"text":"എന്റെ സുഹൃത്തുക്കൾക്കു ഞാനൊരു പേടിസ്വപ്നമായി—","poem":1},{"text":"തെരുവോരങ്ങളിൽ എന്നെ കാണുന്നവർ, എന്നിൽനിന്ന് ഓടിയകലുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"മൃതിയടഞ്ഞവരെന്നപോലെ ഞാൻ അവരുടെ സ്മരണകളിൽ ഇല്ലാതെയായിരിക്കുന്നു;","poem":1},{"text":"തകർന്നുപോയ ഒരു മൺപാത്രംപോലെ ഞാൻ ആയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അനേകംപേർ അടക്കംപറയുന്നതു ഞാൻ കേൾക്കുന്നു,","poem":1},{"text":"“ഭീകരത എല്ലാ ഭാഗത്തുനിന്നും ഉടലെടുക്കുന്നു!”","poem":2},{"text":"അവർ എനിക്കെതിരേ തന്ത്രങ്ങൾ മെനയുന്നു","poem":1},{"text":"എന്റെ ജീവൻ അപഹരിക്കാൻ തന്ത്രങ്ങൾ മെനയുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"എന്നാൽ യഹോവേ, അങ്ങയിൽ ഞാൻ ആശ്രയിക്കുന്നു;","poem":1},{"text":"“അവിടന്ന് ആകുന്നു എന്റെ ദൈവം,” എന്നു ഞാൻ പറയുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"എന്റെ കാലഗതികൾ തിരുക്കരങ്ങളിലാണ്;","poem":1},{"text":"എന്റെ ശത്രുക്കളുടെ കൈയിൽനിന്ന് എന്നെ മോചിപ്പിക്കണമേ,","poem":2},{"lineBreak":true},{"text":"എന്നെ വേട്ടയാടുന്നവരിൽനിന്നുംതന്നെ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അങ്ങയുടെ ദാസന്റെമേൽ തിരുമുഖം പ്രകാശിപ്പിക്കണമേ;","poem":1},{"text":"അചഞ്ചലസ്നേഹത്താൽ എന്നെ രക്ഷിക്കണമേ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"യഹോവേ, ഞാൻ അങ്ങയോട് നിലവിളിക്കുന്നു,","poem":1},{"text":"ലജ്ജിതനാകാൻ എന്നെ അനുവദിക്കരുതേ;","poem":2},{"text":"എന്നാൽ ദുഷ്ടർ അപമാനിതരായിത്തീരട്ടെ","poem":1},{"text":"അവർ മൂകരായി പാതാളത്തിൽ നിപതിക്കട്ടെ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"വ്യാജം പുലമ്പുന്ന അവരുടെ അധരങ്ങൾ മൂകമായിത്തീരട്ടെ,","poem":1},{"text":"കാരണം അവർ അഹങ്കാരത്തോടും അവജ്ഞയോടുംകൂടെ","poem":2},{"lineBreak":true},{"text":"നീതിനിഷ്ഠർക്കെതിരേ ധിക്കാരപൂർവം സംസാരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"അങ്ങയെ ഭയപ്പെടുന്നവർക്കുവേണ്ടി അങ്ങ് സംഭരിച്ചുവെച്ചിരിക്കുന്നതും","poem":1},{"text":"അങ്ങയിൽ ശരണം പ്രാപിക്കുന്നവർക്കായി","poem":2},{"text":"സകലമനുഷ്യരും കാണുംവിധം അവിടന്ന് പ്രദർശിപ്പിച്ചതുമായ","poem":1},{"text":"അവിടത്തെ നന്മ എത്രയോ സമൃദ്ധം.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ആരോപണം നടത്തുന്ന നാവിൽനിന്ന്","poem":1},{"text":"അങ്ങ് അവരെ തിരുസന്നിധിയിൽ സുരക്ഷിതരാക്കിയിരിക്കുന്നു;","poem":2},{"text":"മനുഷ്യരുടെ സകലഗൂഢതന്ത്രങ്ങളിൽനിന്നും വിടുവിച്ച്","poem":1},{"text":"അങ്ങയുടെ കൂടാരത്തിൽ അവരെ ഒളിപ്പിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"യഹോവ വാഴ്ത്തപ്പെടട്ടെ,","poem":1},{"text":"കാരണം ശത്രുവിനാൽ വളയപ്പെട്ട പട്ടണത്തിൽ ഞാൻ ആയിരുന്നപ്പോൾ","poem":2},{"lineBreak":true},{"text":"വിസ്മയകരമാംവിധത്തിൽ അവിടത്തെ അചഞ്ചലസ്നേഹം എന്നോടു കാണിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“അങ്ങയുടെ ദൃഷ്ടിയിൽനിന്ന് ഞാൻ ഛേദിക്കപ്പെട്ടിരിക്കുന്നു!”","poem":1},{"text":"എന്ന് എന്റെ പരിഭ്രമത്തിൽ ഞാൻ നിലവിളിച്ചു.","poem":2},{"text":"എന്നിട്ടും ഞാൻ സഹായത്തിനായി കേണപ്പോൾ,","poem":1},{"text":"കരുണയ്ക്കായുള്ള എന്റെ യാചന അവിടന്ന് കേട്ടിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"യഹോവയുടെ സകലവിശ്വസ്തജനമേ, അവിടത്തെ സ്നേഹിക്കുക!","poem":1},{"text":"യഹോവയോട് വിശ്വസ്തരായിരിക്കുന്നവർക്ക് അവിടന്ന് സംരക്ഷണം നൽകുന്നു,","poem":2},{"lineBreak":true},{"text":"എന്നാൽ നിഗളികൾക്ക് അവർ അർഹിക്കുന്ന ശിക്ഷനൽകുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"യഹോവയിൽ പ്രത്യാശ അർപ്പിക്കുന്ന എല്ലാവരുമേ,","poem":1},{"text":"ശക്തരായിരിക്കുക, സുധീരരായിരിക്കുക.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}