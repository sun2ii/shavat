{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"നീതിനിഷ്ഠരേ, ആനന്ദത്തോടെ യഹോവയ്ക്ക് പാടുക;","poem":1},{"text":"പരമാർഥികളുടെ സ്തുതി ഉചിതംതന്നെ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"കിന്നരംകൊണ്ട് യഹോവയെ ഞാൻ വാഴ്ത്തുക;","poem":1},{"text":"പത്തുകമ്പിയുള്ള വീണകൊണ്ട് അവിടത്തേക്ക് സംഗീതം ആലപിക്കുക.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവിടത്തേക്ക് ഒരു നവഗാനം ആലപിക്കുക;","poem":1},{"text":"വൈദഗ്ദ്ധ്യത്തോടെ വാദ്യങ്ങളിൽ ആനന്ദസ്വരം മുഴക്കുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"കാരണം, യഹോവയുടെ വചനം നീതിയുക്തമാകുന്നു;","poem":1},{"text":"അവിടന്ന് തന്റെ എല്ലാ പ്രവൃത്തികളിലും വിശ്വസ്തൻതന്നെ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"യഹോവ നീതിയും ന്യായവും ഇഷ്ടപ്പെടുന്നു;","poem":1},{"text":"അവിടത്തെ അചഞ്ചലസ്നേഹത്താൽ ഭൂമണ്ഡലം നിറഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"യഹോവയുടെ വചനത്താൽ ആകാശം സൃഷ്ടിക്കപ്പെട്ടു,","poem":1},{"text":"തിരുവായിലെ ശ്വാസത്താൽ താരഗണങ്ങളും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവിടന്ന് സമുദ്രജലരാശിയെ കൂമ്പാരമായി കൂട്ടുന്നു;","poem":1},{"text":"ആഴിയെ കലവറകളിൽ സംഭരിക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"സർവഭൂമിയും യഹോവയെ ഭയപ്പെടട്ടെ;","poem":1},{"text":"ഭൂസീമവാസികളെല്ലാം തിരുമുമ്പിൽ ഭയഭക്തിയോടെ നിലകൊള്ളട്ടെ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"കാരണം, അവിടന്ന് അരുളിച്ചെയ്തു, അവയുണ്ടായി;","poem":1},{"text":"അവിടന്ന് കൽപ്പിച്ചു, അവ സ്ഥാപിതമായി.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"യഹോവ രാഷ്ട്രങ്ങളുടെ പദ്ധതികൾ നിഷ്ഫലമാക്കുന്നു;","poem":1},{"text":"ജനതകളുടെ ആലോചനകൾ വിഫലമാക്കുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"എന്നാൽ യഹോവയുടെ പദ്ധതികൾ എന്നെന്നേക്കും സ്ഥിരമായിരിക്കുന്നു;","poem":1},{"text":"അവിടത്തെ ഹൃദയവിചാരങ്ങൾ തലമുറതലമുറകളോളവും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"യഹോവ ദൈവമായിരിക്കുന്ന രാഷ്ട്രം അനുഗ്രഹിക്കപ്പെട്ടത്,","poem":1},{"text":"അവിടന്ന് തന്റെ അവകാശമായി തെരഞ്ഞെടുക്കപ്പെട്ട ജനതയും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"യഹോവ സ്വർഗത്തിൽനിന്നു താഴേക്കു നോക്കുന്നു;","poem":1},{"text":"സകലമാനവവംശത്തെയും വീക്ഷിക്കുന്നു;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവിടന്നു തന്റെ നിവാസസ്ഥാനത്തുനിന്ന്","poem":1},{"text":"ഭൂമിയിലെ സകലനിവാസികളെയും നിരീക്ഷിക്കുന്നു—","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവിടന്ന് അവരുടെയെല്ലാം ഹൃദയങ്ങളെ രൂപപ്പെടുത്തുന്നു,","poem":1},{"text":"അവരുടെ പ്രവൃത്തികളെല്ലാം അവിടന്ന് ശ്രദ്ധിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"സൈന്യബലത്താൽ ഒരു രാജാവും വിജയശ്രീലാളിതനാകുന്നില്ല;","poem":1},{"text":"തന്റെ കായികബലത്താൽ ഒരു സേനാനിയും രക്ഷപ്പെടുന്നില്ല.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"പടക്കുതിരയെക്കൊണ്ട് വിജയിക്കാമെന്ന ആശ വ്യർഥം;","poem":1},{"text":"അതിന്റെ വൻശക്തിയാൽ, നിന്നെ രക്ഷിക്കാൻ അതിനു കഴിയുകയുമില്ല.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"എന്നാൽ യഹോവയുടെ ദൃഷ്ടി തന്നെ ഭയപ്പെടുന്നവരിലും","poem":1},{"text":"അവിടത്തെ അചഞ്ചലസ്നേഹത്തിൽ പ്രത്യാശ അർപ്പിക്കുന്നവരിലുമുണ്ട്,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അവിടന്നവരെ മരണത്തിൽനിന്ന് മോചിപ്പിക്കുകയും","poem":1},{"text":"ക്ഷാമകാലത്ത് അവരുടെ ജീവൻ രക്ഷിക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"എന്റെയുള്ളം യഹോവയ്ക്കായി കാത്തിരിക്കുന്നു;","poem":1},{"text":"അവിടന്നു നമ്മുടെ സഹായവും പരിചയും ആകുന്നു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"നമ്മുടെ ഹൃദയം യഹോവയിൽ ആനന്ദിക്കുന്നു,","poem":1},{"text":"കാരണം, അവിടത്തെ വിശുദ്ധനാമത്തെ നാം ശരണംപ്രാപിക്കുന്നു.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ഞങ്ങൾ അങ്ങയിൽ പ്രത്യാശ അർപ്പിക്കുന്നതുപോലെ","poem":1},{"text":"യഹോവേ, അവിടത്തെ അചഞ്ചലസ്നേഹം ഞങ്ങളോടൊപ്പം ഉണ്ടാകണമേ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}