{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":34,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം. അബീമെലെക്കിന്റെ മുൻപിൽവെച്ചു ബുദ്ധിഭ്രമം നടിക്കുകയും ആട്ടിയോടിക്കപ്പെടുകയും ചെയ്തപ്പോൾ പാടിയത്."]},{"type":"verse","number":1,"content":[{"text":"ഞാൻ യഹോവയെ എല്ലാക്കാലത്തും പുകഴ്ത്തും;","poem":1},{"text":"അവിടത്തെ സ്തുതി എപ്പോഴും എന്റെ അധരങ്ങളിൽ ഇരിക്കും.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"എന്റെയുള്ളം യഹോവയിൽ അഭിമാനിക്കുന്നു;","poem":1},{"text":"പീഡിതർ കേൾക്കുകയും ആനന്ദിക്കുകയും ചെയ്യട്ടെ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"എന്നോടു ചേർന്നു യഹോവയെ മഹിമപ്പെടുത്തുക;","poem":1},{"text":"നമുക്കൊരുമിച്ച് അവിടത്തെ നാമം വാഴ്ത്താം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ഞാൻ യഹോവയെ അന്വേഷിച്ചു, അവിടന്ന് എനിക്ക് ഉത്തരമരുളി;","poem":1},{"text":"എന്റെ എല്ലാ ഭയങ്ങളിൽനിന്നും അവിടന്ന് എന്നെ വിടുവിച്ചു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അങ്ങയെ നോക്കുന്നവർ പ്രകാശപൂരിതരായിത്തീരുന്നു;","poem":1},{"text":"അവരുടെ മുഖം ഒരിക്കലും ലജ്ജാഭരിതമാകുകയില്ല.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഈ എളിയ മനുഷ്യൻ വിളിച്ചപേക്ഷിച്ചു, യഹോവ കേട്ടു;","poem":1},{"text":"അവിടന്ന് സകലവിധ പ്രയാസങ്ങളിൽനിന്നും അദ്ദേഹത്തെ രക്ഷിച്ചു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"യഹോവയെ ഭയപ്പെടുന്നവരുടെചുറ്റും, അവിടത്തെ ദൂതന്മാർ പാളയമിറങ്ങിയിരിക്കുന്നു,","poem":1},{"text":"അങ്ങനെ അവിടന്ന് അവരെ വിടുവിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"യഹോവ നല്ലവനെന്ന് രുചിച്ചറിയുക;","poem":1},{"text":"അങ്ങയിൽ അഭയംതേടുന്ന മനുഷ്യർ അനുഗൃഹീതർ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"യഹോവയുടെ വിശുദ്ധജനമേ, അവിടത്തെ ഭയപ്പെടുക","poem":1},{"text":"അവിടത്തെ ഭക്തന്മാർക്ക് ഒന്നിനും കുറവുണ്ടാകുന്നില്ല.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"സിംഹക്കുട്ടികൾ ക്ഷീണിതരാകുകയും വിശപ്പനുഭവിക്കുകയും ചെയ്തേക്കാം,","poem":1},{"text":"എന്നാൽ യഹോവയെ അന്വേഷിക്കുന്നവർക്ക് ഒരു നന്മയ്ക്കും കുറവുണ്ടാകുന്നില്ല.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"എന്റെ മക്കളേ, വരിക, ഞാൻ പറയുന്നത് ശ്രദ്ധിക്കുക;","poem":1},{"text":"യഹോവാഭക്തി ഞാൻ നിങ്ങൾക്ക് ഉപദേശിച്ചുതരാം.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ജീവനെ സ്നേഹിക്കുകയും","poem":1},{"text":"സന്തുഷ്ടിനിറഞ്ഞ ദീർഘായുസ്സ് ആഗ്രഹിക്കുകയുംചെയ്യുന്നവർ","poem":2}]},{"type":"verse","number":13,"content":[{"text":"നിങ്ങളുടെ നാവിനെ തിന്മയിൽനിന്നും","poem":1},{"text":"നിങ്ങളുടെ അധരങ്ങളെ വ്യാജഭാഷണത്തിൽനിന്നും സൂക്ഷിക്കുക.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"തിന്മയിൽനിന്ന് പിന്തിരിഞ്ഞ് സൽപ്രവൃത്തികൾ ചെയ്യുക;","poem":1},{"text":"സമാധാനം അന്വേഷിച്ച് അതിനെ പിൻതുടരുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"യഹോവയുടെ ദൃഷ്ടി നീതിനിഷ്ഠരുടെമേൽ ആകുന്നു","poem":1},{"text":"അവിടത്തെ കാതുകൾ അവരുടെ നിലവിളി ശ്രദ്ധിക്കുന്നു;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"എന്നാൽ യഹോവയുടെ മുഖം തിന്മ പ്രവർത്തിക്കുന്നവർക്ക് എതിരാകുന്നു,","poem":1},{"text":"അവരുടെ ഓർമയെ ഭൂമിയിൽനിന്നു മായിച്ചുകളയേണ്ടതിനുതന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"നീതിനിഷ്ഠർ നിലവിളിക്കുന്നു, യഹോവ അതു കേൾക്കുന്നു;","poem":1},{"text":"അവിടന്ന് അവരെ സകലവിധ കഷ്ടതകളിൽനിന്നും വിടുവിക്കുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ഹൃദയവ്യഥയനുഭവിക്കുന്നവർക്ക് യഹോവ സമീപസ്ഥൻ","poem":1},{"text":"മനസ്സു തകർന്നവരെ അവിടന്ന് രക്ഷിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"നീതിനിഷ്ഠരായ മനുഷ്യർക്കു ധാരാളം യാതനകൾ ഉണ്ടാകും","poem":1},{"text":"എങ്കിലും അവ എല്ലാറ്റിൽനിന്നും യഹോവ അവരെ വിടുവിക്കുന്നു;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അവിടന്ന് അവരുടെ അസ്ഥികൾക്കെല്ലാം സംരക്ഷണം നൽകുന്നു,","poem":1},{"text":"അവയിൽ ഒന്നുപോലും ഉടയ്ക്കപ്പെടുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"അധർമം ദുഷ്ടരെ കൊല്ലുന്നു;","poem":1},{"text":"നീതിനിഷ്ഠരുടെ ശത്രുക്കൾ ശിക്ഷിക്കപ്പെടും.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"യഹോവ തന്റെ സേവകരെ മോചിപ്പിക്കുന്നു;","poem":1},{"text":"അങ്ങയിൽ അഭയംതേടുന്ന ആർക്കും ശിക്ഷാവിധി ഉണ്ടാകുകയില്ല.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}