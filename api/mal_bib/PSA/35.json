{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":35,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"യഹോവേ, എന്നോട് മത്സരിക്കുന്നവരോട് അങ്ങ് മത്സരിക്കണമേ;","poem":1},{"text":"എന്നോടു യുദ്ധംചെയ്യുന്നവരോട് അങ്ങ് യുദ്ധംചെയ്യണമേ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"പരിചയും പലകയും എടുക്കണമേ;","poem":1},{"text":"അങ്ങ് എഴുന്നേറ്റ് എന്റെ സഹായത്തിനായി വരണമേ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"എന്നെ പിൻതുടരുന്നവർക്കെതിരേ","poem":1},{"text":"കുന്തവും വേലും","poem":2},{"noteId":37},{"text":"വീശണമേ.","poem":2},{"text":"“അങ്ങാണ് എന്റെ രക്ഷയെന്ന്,”","poem":1},{"text":"എന്നോട് അരുളിച്ചെയ്യണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"എന്റെ ജീവൻ അപായപ്പെടുത്താൻ നോക്കുന്നവർ","poem":1},{"text":"ലജ്ജിച്ച് അപമാനിതരായിത്തീരട്ടെ;","poem":2},{"text":"എന്റെ നാശത്തിനായി പദ്ധതിയാവിഷ്കരിക്കുന്നവർ","poem":1},{"text":"നിരാശരായി പിന്തിരിയട്ടെ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"യഹോവയുടെ ദൂതൻ അവരെ തുരത്തിയോടിക്കുന്നതിനാൽ","poem":1},{"text":"അവർ കാറ്റിൽ പാറിപ്പോകുന്ന പതിരുപോലെയാകട്ടെ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"യഹോവയുടെ ദൂതൻ അവരെ പിൻതുടരുന്നതിനാൽ","poem":1},{"text":"അവരുടെ പാതകൾ അന്ധകാരവും വഴുവഴുപ്പും ഉള്ളതാകട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"അകാരണമായി അവരെനിക്കു വല വിരിക്കുകയും","poem":1},{"text":"ഒരു ചതിക്കുഴി കുഴിക്കുകയും ചെയ്യുകയാണല്ലോ,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവർക്കു ശീഘ്രനാശം വന്നുഭവിക്കട്ടെ—","poem":1},{"text":"അവർ ഒരുക്കിവെച്ച വലയിൽ അവർതന്നെ കുടുങ്ങട്ടെ,","poem":2},{"lineBreak":true},{"text":"അവർ എനിക്കുവേണ്ടി കുഴിച്ച കുഴിയിലേക്ക് അവർതന്നെ നിപതിക്കട്ടെ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അപ്പോൾ എന്റെ പ്രാണൻ യഹോവയിൽ ആനന്ദിക്കട്ടെ","poem":1},{"text":"അവിടത്തെ രക്ഷയിൽ ഘോഷിച്ചുല്ലസിക്കുകയും ചെയ്യട്ടെ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“യഹോവേ, അങ്ങയെപ്പോലെ ആരുള്ളൂ?","poem":1},{"text":"എന്ന് എന്റെ എല്ലാ അസ്ഥികളും പ്രസ്താവിക്കും.","poem":2},{"text":"അവിടന്നു സാധുക്കളെ അവരുടെ ശക്തിക്ക് അതീതരായവരിൽനിന്ന് മോചിപ്പിക്കുന്നു;","poem":1},{"text":"കൊള്ളചെയ്യുന്നവരുടെ കൈയിൽനിന്ന് എളിയവരെയും ദരിദ്രരെയും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"നിഷ്കരുണരായ സാക്ഷികൾ എനിക്കെതിരേ മുന്നോട്ടുവരുന്നു;","poem":1},{"text":"എനിക്കൊരറിവുമില്ലാത്ത വസ്തുതകളെപ്പറ്റി എന്നെ ചോദ്യംചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവർ, ഞാൻ ചെയ്ത നന്മയ്ക്കു പകരമായി തിന്മചെയ്യുന്നു","poem":1},{"text":"എന്റെ പ്രാണനെ ഉറ്റവർ മരിച്ച ഒരുവനെപ്പോലെ ആക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"എന്നിട്ടും അവർ രോഗാതുരരായിരുന്നപ്പോൾ ഞാൻ ചാക്കുശീല ധരിച്ചുകൊണ്ട്","poem":1},{"text":"നമ്രമാനസനായി അവർക്കുവേണ്ടി ഉപവസിച്ചു.","poem":2},{"text":"എന്റെ പ്രാർഥന ഉത്തരംനേടാതെ എന്റെ അടുത്തേക്കുതന്നെ മടങ്ങിവന്നപ്പോൾ,","poem":1}]},{"type":"verse","number":14,"content":[{"text":"എന്റെ സ്നേഹിതനോ സഹോദരനോവേണ്ടി എന്നതുപോലെ","poem":2},{"lineBreak":true},{"text":"ഞാൻ വിലപിച്ചുകൊണ്ടിരുന്നു.","poem":2},{"text":"എന്റെ മാതാവിനുവേണ്ടി വിലപിക്കുന്നതുപോലെ","poem":1},{"text":"ദുഃഖത്താൽ ഞാൻ എന്റെ ശിരസ്സു നമിച്ചു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"എന്നാൽ ഞാൻ ഇടറിവീണപ്പോൾ അവർ ഒത്തുചേർന്ന് ആഹ്ലാദിച്ചു;","poem":1},{"text":"എന്റെ പ്രതിയോഗികൾ ഞാൻ അറിയാതെ എനിക്കെതിരേ സംഘംചേർന്നു.","poem":2},{"lineBreak":true},{"text":"ഇടവേളകളില്ലാതെ അവർ എന്നെ ദുഷിച്ചു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അഭക്തരെപ്പോലെ അവർ എന്നെ ക്രൂരമായി പരിഹസിച്ചു;","poem":1},{"text":"അവർ എനിക്കെതിരേ പല്ലുകടിച്ചു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"കർത്താവേ, എത്രനാൾ അങ്ങ് നോക്കിനിൽക്കും?","poem":1},{"text":"അവരുടെ ഭീകരതയാർന്ന ആക്രമണങ്ങളിൽനിന്ന് എന്നെ മോചിപ്പിക്കണമേ,","poem":2},{"lineBreak":true},{"text":"ഈ സിംഹക്കുട്ടികളിൽനിന്ന് എന്റെ ജീവനെയും.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ഞാൻ മഹാസഭയിൽ അങ്ങേക്ക് നന്ദിയർപ്പിക്കും;","poem":1},{"text":"ജനസാഗരമധ്യേ ഞാൻ അങ്ങയെ വാഴ്ത്തും.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അകാരണമായി എന്നോടു ശത്രുതപുലർത്തുന്നവർ","poem":1},{"text":"എന്റെ പേരിൽ ആനന്ദിക്കാതിരിക്കട്ടെ;","poem":2},{"text":"അകാരണമായി എന്നെ വെറുക്കുന്നവർക്ക്","poem":1},{"text":"എന്നെ ഉപഹസിക്കാൻ ഇടവരാതിരിക്കട്ടെ.","poem":2},{"noteId":38}]},{"type":"verse","number":20,"content":[{"text":"അവർ സമാധാനപരമായി സംസാരിക്കുന്നില്ല,","poem":1},{"text":"ദേശത്തു ശാന്തമായി ജീവിക്കുന്നവർക്കെതിരേ","poem":2},{"lineBreak":true},{"text":"അവർ വ്യാജ ആരോപണങ്ങൾ ഉന്നയിക്കുന്നു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവർ എന്റെനേരേ, “ആഹാ! ആഹാ!” എന്നു പറഞ്ഞ് പരിഹസിക്കുന്നു","poem":1},{"text":"“ഞങ്ങളതു സ്വന്തം കണ്ണാൽ കണ്ടു,” എന്നും പറയുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"യഹോവേ, അങ്ങ് ഇതു കണ്ടല്ലോ; നിശ്ശബ്ദനായിരിക്കരുതേ.","poem":1},{"text":"കർത്താവേ, എന്നിൽനിന്ന് അകന്നിരിക്കുകയുമരുതേ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ഉണരണമേ, എനിക്കു പ്രതിരോധം തീർക്കാൻ എഴുന്നേൽക്കണമേ!","poem":1},{"text":"എന്റെ ദൈവമായ കർത്താവേ, എനിക്കുവേണ്ടി വാദിക്കണമേ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"എന്റെ ദൈവമായ യഹോവേ, അവിടത്തെ നീതിക്കനുസൃതമായി എന്നെ കുറ്റവിമുക്തനാക്കണമേ;","poem":1},{"text":"അവർ എന്റെമേൽ ആനന്ദിക്കാതിരിക്കട്ടെ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"“ആഹാ, ഞങ്ങളുടെ ചിരകാലാഭിലാഷം നിറവേറി!” എന്ന് അവർ ചിന്തിക്കാതിരിക്കട്ടെ,","poem":1},{"text":"“ഞങ്ങൾ അവനെ വിഴുങ്ങിക്കളഞ്ഞു,” എന്നും അവർ വീമ്പിളക്കാതിരിക്കട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"എന്റെ കഷ്ടതയിൽ ആർത്തട്ടഹസിക്കുന്ന എല്ലാവരും","poem":1},{"text":"ലജ്ജിതരും പരിഭ്രാന്തരും ആയിത്തീരട്ടെ;","poem":2},{"text":"എനിക്കെതിരേ തന്നെത്താൻ ഉയർത്തുന്നവർ","poem":1},{"text":"ലജ്ജയിലും അപമാനത്തിലും മുഴുകട്ടെ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"എനിക്കു ലഭ്യമാകുന്ന നീതിയിൽ ആനന്ദിക്കുന്നവർ","poem":1},{"text":"ആനന്ദത്തോടെ ആർത്തുഘോഷിക്കട്ടെ;","poem":2},{"text":"“തന്റെ ദാസന്റെ നന്മയിൽ ആഹ്ലാദിക്കുന്നവർ,","poem":1},{"text":"യഹോവ വാഴ്ത്തപ്പെടുമാറാകട്ടെ,” എന്ന് എപ്പോഴും പറയട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"എന്റെ നാവ് അവിടത്തെ നീതിയെപ്പറ്റി ഘോഷിക്കും,","poem":1},{"text":"ദിവസംമുഴുവനും അവിടത്തെ സ്തുതിയും.","poem":2}]}],"footnotes":[{"noteId":37,"caller":"+","text":"അതായത്, കനംകുറഞ്ഞ നീളമുള്ള കുന്തം.","reference":{"chapter":35,"verse":3}},{"noteId":38,"caller":"+","text":"മൂ.ഭാ. കണ്ണിറുക്കാതിരിക്കട്ടെ","reference":{"chapter":35,"verse":19}}]},"thisChapterLink":"/api/mal_bib/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}