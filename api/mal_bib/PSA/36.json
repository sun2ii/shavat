{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":36,"content":[{"type":"hebrew_subtitle","content":["യഹോവയുടെ ദാസനായ ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"പാപം ദുഷ്ടരുടെ","poem":1},{"text":"ഹൃദയാന്തർഭാഗത്തു മന്ത്രിക്കുന്നു","poem":2},{"noteId":39},{"text":"അവരുടെ ദൃഷ്ടിയിൽ","poem":1},{"text":"ദൈവഭയം ഇല്ലാതായിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"തങ്ങളുടെ അകൃത്യം കണ്ടുപിടിക്കപ്പെടുകയോ പാപം വെറുക്കപ്പെടുകയോ","poem":1},{"text":"ചെയ്യാതവണ്ണം അവർ ആത്മപ്രശംസചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവരുടെ വായിൽനിന്നുള്ള വാക്കുകൾ ദുഷ്ടതയും വഞ്ചനയും ഉള്ളതാകുന്നു;","poem":1},{"text":"വിവേകത്തോടെ നന്മപ്രവർത്തിക്കുന്നതിൽനിന്നും അവർ പിൻവാങ്ങുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവരുടെ കിടക്കയിൽവെച്ചുപോലും അവർ ദുഷ്ടത നെയ്തുകൂട്ടുന്നു;","poem":1},{"text":"പാപവഴികളിലേക്ക് അവർ അവരെത്തന്നെ സമർപ്പിക്കുന്നു","poem":2},{"lineBreak":true},{"text":"തിന്മയിൽനിന്നു പിന്തിരിയാൻ ഒരു പരിശ്രമവും നടത്തുന്നില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"യഹോവേ, അവിടത്തെ അചഞ്ചലസ്നേഹം ആകാശത്തോളം എത്തുന്നു,","poem":1},{"text":"അവിടത്തെ വിശ്വസ്തത മേഘങ്ങളോളം വ്യാപിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവിടത്തെ നീതി അത്യുന്നത പർവതങ്ങൾപോലെയും","poem":1},{"text":"അവിടത്തെ ന്യായം അഗാധസമുദ്രംപോലെയും ആകുന്നു.","poem":2},{"lineBreak":true},{"text":"യഹോവേ, അങ്ങ് മനുഷ്യരെയും മൃഗങ്ങളെയും സംരക്ഷിക്കുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ദൈവമേ, അവിടത്തെ അചഞ്ചലസ്നേഹം എത്ര അമൂല്യമാകുന്നു!","poem":1},{"text":"സകലമനുഷ്യരും അവിടത്തെ ചിറകിൻകീഴിൽ അഭയംതേടുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവിടത്തെ ഭവനത്തിന്റെ സമൃദ്ധിയിൽ അവർ വിരുന്നുണ്ട്, തൃപ്തിയടയുന്നു;","poem":1},{"text":"അവിടത്തെ ആനന്ദപ്രവാഹത്തിൽനിന്ന്, അവർക്കു കുടിക്കാൻനൽകുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"കാരണം അവിടത്തെ സന്നിധാനത്തിൽ ജീവജലധാരയുണ്ട്;","poem":1},{"text":"അവിടത്തെ പ്രഭയിൽ ഞങ്ങൾ പ്രകാശം ദർശിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"അങ്ങയെ അറിയുന്നവർക്ക് അവിടത്തെ സ്നേഹവും","poem":1},{"text":"ഹൃദയപരമാർഥികൾക്ക് അവിടത്തെ നീതിയും തുടർന്നും നൽകണമേ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അഹന്തനിറഞ്ഞവരുടെ പാദം എനിക്കെതിരേ നീങ്ങരുതേ,","poem":1},{"text":"ദുഷ്ടരുടെ കൈ എന്നെ ആട്ടിപ്പായിക്കാതെയും ഇരിക്കട്ടെ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ഇതാ! അധർമം പ്രവർത്തിക്കുന്നവർ എപ്രകാരം വീണടിഞ്ഞിരിക്കുന്നു—","poem":1},{"text":"തള്ളിവീഴ്ത്തപ്പെട്ടിരിക്കുന്നു, എഴുന്നേൽക്കാൻ കഴിയുന്നതുമില്ല!","poem":2}]}],"footnotes":[{"noteId":39,"caller":"+","text":"അഥവാ, എന്റെ ഹൃദയത്തിൽ ദൈവത്തിൽനിന്ന് ഒരു അരുളപ്പാടുണ്ട്, ദുഷ്ടരുടെ പാപത്തെക്കുറിച്ചുതന്നെ.","reference":{"chapter":36,"verse":1}}]},"thisChapterLink":"/api/mal_bib/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}