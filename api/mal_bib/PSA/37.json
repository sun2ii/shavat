{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":37,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"അധർമം പ്രവർത്തിക്കുന്നവർനിമിത്തം അസ്വസ്ഥരാകുകയോ","poem":1},{"text":"ദുഷ്ടരോട് അസൂയാലുക്കളാകുകയോ അരുത്.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"പുല്ലുപോലെ അവർ വേഗത്തിൽ വാടിപ്പോകും","poem":1},{"text":"പച്ചച്ചെടിപോലെ അവർ വേഗത്തിൽ ഇല്ലാതെയാകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"യഹോവയിൽ ആശ്രയിച്ചുകൊണ്ട് നന്മ പ്രവർത്തിക്കുക;","poem":1},{"text":"എന്നാൽ, സുരക്ഷിതമായ മേച്ചിൽപ്പുറം ആസ്വദിച്ചുകൊണ്ട് ദേശത്തു ജീവിക്കാം.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"യഹോവയിൽ ആനന്ദിക്കുക,","poem":1},{"text":"അപ്പോൾ അവിടന്നു നിന്റെ ഹൃദയാഭിലാഷങ്ങൾ നിറവേറ്റും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"നിന്റെ വഴി യഹോവയെ ഭരമേൽപ്പിക്കുക;","poem":1},{"text":"യഹോവയിൽത്തന്നെ ആശ്രയിക്കുക, അവിടന്നു നിന്നെ സഹായിക്കും:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവിടന്ന് നിന്റെ നീതിയെ ഉഷസ്സുപോലെ പ്രകാശപൂർണമാക്കും,","poem":1},{"text":"നിന്റെ കുറ്റവിമുക്തി മധ്യാഹ്നസൂര്യനെപ്പോലെയും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"യഹോവയുടെ സന്നിധിയിൽ മൗനമായിരിക്കുക","poem":1},{"text":"അവിടത്തേക്കായി ക്ഷമാപൂർവം കാത്തിരിക്കുക;","poem":2},{"text":"അധർമം പ്രവർത്തിക്കുന്നവർ തങ്ങളുടെ വഴികളിൽ മുന്നേറുമ്പോൾ അസ്വസ്ഥരാകേണ്ടതില്ല,","poem":1},{"text":"അവർ തങ്ങളുടെ കുതന്ത്രങ്ങൾ പ്രാവർത്തികമാക്കുമ്പോഴും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"കോപത്തിൽനിന്ന് അകന്നിരിക്കുക ക്രോധത്തിൽനിന്ന് പിന്തിരിയുക;","poem":1},{"text":"ഉത്കണ്ഠപ്പെടരുത്—അത് അധർമത്തിലേക്കുമാത്രമേ നയിക്കുകയുള്ളൂ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"കാരണം ദുഷ്ടർ ഉന്മൂലനംചെയ്യപ്പെടും,","poem":1},{"text":"എന്നാൽ യഹോവയിൽ പ്രത്യാശയർപ്പിച്ചിരിക്കുന്നവർ ദേശം അവകാശമാക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ഒരൽപ്പകാലംകൂടി, ദുഷ്ടർ ഇല്ലാതെയാകും;","poem":1},{"text":"നീ അവരെ അന്വേഷിച്ചാലും അവരെ കണ്ടെത്തുകയില്ല.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"എന്നാൽ സൗമ്യതയുള്ളവർ ഭൂമി അവകാശമാക്കുകയും","poem":1},{"text":"സമാധാനം, അഭിവൃദ്ധി എന്നിവ ആസ്വദിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ദുഷ്ടർ നീതിനിഷ്ഠർക്കെതിരേ ഗൂഢാലോചന നടത്തുന്നു","poem":1},{"text":"അവരുടെനേരേ പല്ലുഞെരിക്കുകയുംചെയ്യുന്നു;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"എന്നാൽ കർത്താവ് ദുഷ്ടരെ നോക്കി ചിരിക്കുന്നു,","poem":1},{"text":"അവരുടെ ദിവസം അടുത്തിരിക്കുന്നെന്ന് അവിടത്തേക്കറിയാം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ദുഷ്ടർ വാളെടുക്കുകയും","poem":1},{"text":"വില്ലുകുലയ്ക്കുകയും ചെയ്യുന്നു,","poem":2},{"text":"ദരിദ്രരെയും അശരണരെയും നശിപ്പിക്കുന്നതിനും","poem":1},{"text":"പരമാർഥതയോടെ ജീവിക്കുന്നവരെ വധിക്കുന്നതിനുംതന്നെ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"എന്നാൽ അവരുടെ വാൾ അവരുടെ ഹൃദയത്തെത്തന്നെ കുത്തിത്തുളയ്ക്കും,","poem":1},{"text":"അവരുടെ വില്ലുകൾ തകർന്നുപോകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ഒട്ടനവധി ദുഷ്ടരുടെ സമൃദ്ധിയെക്കാൾ","poem":1},{"text":"നീതിനിഷ്ഠരുടെ പക്കലുള്ള അൽപ്പം ഏറെ നല്ലത്;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"കാരണം ദുഷ്ടരുടെ ശക്തി തകർക്കപ്പെടും,","poem":1},{"text":"എന്നാൽ യഹോവ നീതിനിഷ്ഠരെ ഉദ്ധരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"നിഷ്കളങ്കരുടെ ദിനങ്ങൾ യഹോവ അറിയുന്നു,","poem":1},{"text":"അവരുടെ ഓഹരി ശാശ്വതമായി നിലനിൽക്കും.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"കഷ്ടകാലത്ത് അവർ വാടിപ്പോകുകയില്ല;","poem":1},{"text":"ക്ഷാമകാലത്ത് അവർ സമൃദ്ധി അനുഭവിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"എന്നാൽ ദുഷ്ടർ നശിച്ചുപോകും:","poem":1},{"text":"യഹോവയുടെ ശത്രുക്കൾ വയലിലെ പൂക്കൾപോലെയാകുന്നു,","poem":2},{"lineBreak":true},{"text":"അവർ മാഞ്ഞുപോകും, പുകയായി അവർ ഉയർന്നുപോകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ദുഷ്ടർ വായ്പവാങ്ങുന്നു, ഒരിക്കലും തിരികെ നൽകുന്നില്ല,","poem":1},{"text":"എന്നാൽ നീതിനിഷ്ഠർ ഉദാരപൂർവം ദാനംചെയ്യുന്നു;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"യഹോവയാൽ അനുഗൃഹീതർ ദേശം അവകാശമാക്കും,","poem":1},{"text":"എന്നാൽ അവിടന്ന് ശപിക്കുന്നവർ ഛേദിക്കപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"യഹോവയിൽ ആനന്ദിക്കുന്നവരുടെ","poem":1},{"text":"ചുവടുകൾ അവിടന്ന് സുസ്ഥിരമാക്കുന്നു;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അവരുടെ കാൽ വഴുതിയാലും അവർ വീണുപോകുകയില്ല,","poem":1},{"text":"കാരണം യഹോവ അവരെ തന്റെ കൈകൊണ്ടു താങ്ങിനിർത്തുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ഞാൻ യുവാവായിരുന്നു, ഇപ്പോൾ വൃദ്ധനായിരിക്കുന്നു;","poem":1},{"text":"എന്നിട്ടും നാളിതുവരെ നീതിനിഷ്ഠർ പരിത്യജിക്കപ്പെടുന്നതോ","poem":2},{"lineBreak":true},{"text":"അവരുടെ മക്കൾ ആഹാരം ഇരക്കുന്നതോ ഞാൻ കണ്ടിട്ടില്ല.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"അവർ എപ്പോഴും ഉദാരമനസ്കരും വായ്പനൽകുന്നവരുമാണ്,","poem":1},{"text":"അവരുടെ മക്കൾ അനുഗൃഹീതരായിത്തീരും.","poem":2},{"noteId":40}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"തിന്മയിൽനിന്നു പിന്തിരിഞ്ഞ് സൽപ്രവൃത്തികൾ ചെയ്യുക,","poem":1},{"text":"അപ്പോൾ നീ ദേശത്ത് ചിരകാലം വസിക്കും.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"കാരണം യഹോവ നീതിയെ സ്നേഹിക്കുന്നു","poem":1},{"text":"അവിടന്ന് തന്റെ വിശ്വസ്തരെ ഉപേക്ഷിക്കുകയില്ല.","poem":2},{"lineBreak":true},{"text":"അവർ എന്നെന്നേക്കും സംരക്ഷിക്കപ്പെടും;","poem":1},{"text":"എന്നാൽ ദുഷ്ടരുടെ മക്കൾ നശിച്ചുപോകും.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"നീതിനിഷ്ഠർ ഭൂമി അവകാശമാക്കുകയും","poem":1},{"text":"ചിരകാലം അവിടെ താമസിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"നീതിനിഷ്ഠരുടെ അധരങ്ങളിൽനിന്നു ജ്ഞാനം പൊഴിയുന്നു,","poem":1},{"text":"അവരുടെ നാവിൽനിന്നു നീതി പുറപ്പെടുന്നു.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"അവരുടെ ദൈവത്തിന്റെ ന്യായപ്രമാണം അവരുടെ ഹൃദയങ്ങളിലുണ്ട്;","poem":1},{"text":"അവരുടെ കാലടികൾ വഴുതിപ്പോകുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"നീതിനിഷ്ഠരുടെ ജീവൻ അപഹരിക്കാൻ ആഗ്രഹിച്ചുകൊണ്ട്,","poem":1},{"text":"ദുഷ്ടർ അവർക്കായി പതിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"എന്നാൽ യഹോവ അവരെ അവരുടെ ഇഷ്ടത്തിന് ഏൽപ്പിച്ചുകൊടുക്കുകയോ","poem":1},{"text":"ന്യായവിസ്താരത്തിൽ ശിക്ഷിക്കപ്പെടാൻ അനുവദിക്കുകയോ ചെയ്യുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"യഹോവയിൽ പ്രത്യാശയർപ്പിക്കുക","poem":1},{"text":"അവിടത്തെ മാർഗം പിൻതുടരുക.","poem":2},{"text":"അവിടന്നു നിങ്ങളെ ഭൂമിയുടെ അവകാശിയായി ഉയർത്തും;","poem":1},{"text":"ദുഷ്ടർ ഛേദിക്കപ്പെടുന്നത് നിങ്ങൾ കാണുകയും ചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"സ്വദേശത്തെ വൃക്ഷംപോലെ","poem":1},{"text":"ദുഷ്ടരും അനുകമ്പയില്ലാത്തവരും തഴച്ചുവളരുന്നതു ഞാൻ കണ്ടിട്ടുണ്ട്,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"എന്നാൽ അവർ വളരെപ്പെട്ടെന്ന് മാറ്റപ്പെടുന്നു, അതിന്റെ സ്ഥാനത്ത് ഒന്നും ശേഷിക്കുകയില്ല;","poem":1},{"text":"ഞാൻ അവരെ അന്വേഷിച്ചു, കണ്ടെത്താൻ കഴിഞ്ഞതുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"സത്യസന്ധരെ നിരീക്ഷിക്കുക, പരമാർഥതയുള്ളവരെ ശ്രദ്ധിക്കുക;","poem":1},{"text":"സമാധാനം അന്വേഷിക്കുന്നവർക്ക് സന്തതിപരമ്പരകൾ ഉണ്ടാകും.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"എന്നാൽ പാപികൾ എല്ലാവരും നശിപ്പിക്കപ്പെടും;","poem":1},{"text":"ദുഷ്ടർ സന്തതിയില്ലാതെ സമൂലം ഛേദിക്കപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"നീതിനിഷ്ഠരുടെ രക്ഷ യഹോവയിൽനിന്നു വരുന്നു;","poem":1},{"text":"ദുർഘടസമയത്ത് അവിടന്ന് അവർക്ക് ഉറപ്പുള്ളകോട്ട.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"യഹോവ അവരെ സഹായിക്കുകയും വിടുവിക്കുകയും ചെയ്യുന്നു;","poem":1},{"text":"അവർ യഹോവയിൽ അഭയംതേടുന്നതിനാൽ","poem":2},{"lineBreak":true},{"text":"അവിടന്ന് അവരെ ദുഷ്ടരിൽനിന്നു വിടുവിക്കുകയും രക്ഷിക്കുകയും ചെയ്യുന്നു.","poem":2}]}],"footnotes":[{"noteId":40,"caller":"+","text":"ഉൽ. 48:20കാണുക.","reference":{"chapter":37,"verse":26}}]},"thisChapterLink":"/api/mal_bib/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}