{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":38,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു നിവേദനസങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"യഹോവേ അങ്ങയുടെ കോപത്താൽ എന്നെ ശാസിക്കുകയോ","poem":1},{"text":"അവിടത്തെ ക്രോധത്താൽ എന്നെ ശിക്ഷിക്കുകയോ അരുതേ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവിടത്തെ അസ്ത്രങ്ങളെന്നെ കുത്തിത്തുളച്ചിരിക്കുന്നു,","poem":1},{"text":"തിരുക്കരം എന്റെമേൽ പതിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവിടത്തെ ക്രോധത്താൽ എന്റെ ശരീരത്തിൽ ആരോഗ്യം അവശേഷിച്ചിട്ടില്ല;","poem":1},{"text":"എന്റെ പാപംനിമിത്തം എന്റെ അസ്ഥികളുടെ ബലം നശിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"എന്റെ പാതകം എന്നെ കീഴടക്കിയിരിക്കുന്നു","poem":1},{"text":"ദുസ്സഹമാം ഭാരംപോലെ അതെന്നെ ഞെരുക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"എന്റെ പാപപങ്കിലമാം ഭോഷത്തങ്ങളാൽ","poem":1},{"text":"എന്റെ മുറിവുകൾ അറപ്പുളവാക്കുന്ന വ്രണങ്ങളായി മാറിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഞാൻ കുനിഞ്ഞു നിലംപറ്റിയിരിക്കുന്നു;","poem":1},{"text":"ദിവസംമുഴുവനും വിലാപത്താൽ ഞാനുഴലുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"എന്റെ അരക്കെട്ട് ദുസ്സഹവേദനയാൽ നിറഞ്ഞുകത്തുന്നു;","poem":1},{"text":"എന്റെ ശരീരത്തിനു യാതൊരു സൗഖ്യവുമില്ല.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ഞാൻ ബലം ക്ഷയിച്ചു പൂർണമായും തകർന്നിരിക്കുന്നു;","poem":1},{"text":"ഹൃദയവ്യഥകൊണ്ട് ഞാൻ ഉച്ചത്തിൽ ഞരങ്ങുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"കർത്താവേ, എന്റെ സകല അഭിലാഷങ്ങളും അവിടത്തെ മുമ്പാകെ അനാവരണം ചെയ്യപ്പെട്ടിരിക്കുന്നു;","poem":1},{"text":"എന്റെ നെടുവീർപ്പ് തിരുമുമ്പിൽ മറഞ്ഞിരിക്കുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"എന്റെ ഹൃദയം നിയന്ത്രണമില്ലാതെ തുടിക്കുന്നു, എന്റെ ശക്തി ചോർന്നൊലിക്കുന്നു;","poem":1},{"text":"എന്റെ കണ്ണിന്റെ കാഴ്ചയും നഷ്ടപ്പെട്ടിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"എന്റെ വ്രണംനിമിത്തം എന്റെ സ്നേഹിതരും ചങ്ങാതികളും എന്നെ തിരസ്കരിച്ചിരിക്കുന്നു;","poem":1},{"text":"എന്റെ അയൽവാസികൾ എന്നിൽനിന്ന് അകലം പാലിക്കുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"എനിക്കു ജീവഹാനി വരുത്താൻ ആഗ്രഹിക്കുന്നവർ എനിക്കെതിരേ കെണിവെക്കുന്നു,","poem":1},{"text":"എന്നെ ഉപദ്രവിക്കാൻ ആഗ്രഹിക്കുന്നവർ എന്റെ നാശത്തെപ്പറ്റി ചർച്ചചെയ്യുന്നു;","poem":2},{"lineBreak":true},{"text":"ദിവസംമുഴുവനും അവർ കുതന്ത്രങ്ങൾ മെനയുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ഒന്നും കേൾക്കാൻ കഴിയാത്ത ബധിരനെപ്പോലെ ഞാൻ ആയിരിക്കുന്നു,","poem":1},{"text":"സംസാരിക്കാനാകാത്ത മൂകനെപ്പോലെയും","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അധരങ്ങളിൽ മറുപടിയൊന്നും അവശേഷിച്ചിട്ടില്ലാത്ത ഒരുവനെപ്പോലെയും","poem":1},{"text":"കേൾക്കാൻ കഴിയാത്ത ബധിരനെപ്പോലെയും ഞാൻ ആയിരിക്കുന്നു","poem":2}]},{"type":"verse","number":15,"content":[{"text":"യഹോവേ, ഞാൻ അങ്ങേക്കായി കാത്തിരിക്കുന്നു;","poem":1},{"text":"എന്റെ ദൈവമായ കർത്താവേ, അവിടന്നെനിക്ക് ഉത്തരമരുളണമേ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“എന്റെ കാൽവഴുതുമ്പോൾ അഹങ്കരിക്കുന്നവരോ","poem":1},{"text":"ആഹ്ലാദത്തിൽ തിമിർക്കുന്നവരോ ആയിത്തീരാതിരിക്കട്ടെ,” എന്നു ഞാൻ പറഞ്ഞു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"കാരണം ഞാൻ വീഴാറായിരിക്കുന്നു,","poem":1},{"text":"എന്റെ വേദന എപ്പോഴും എന്റെ കൂടെയുണ്ട്.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"എന്റെ അകൃത്യങ്ങൾ ഞാൻ ഏറ്റുപറയുന്നു;","poem":1},{"text":"എന്റെ പാപത്തെക്കുറിച്ചു ഞാൻ വ്യാകുലപ്പെടുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"എനിക്ക് പ്രബലരായ അനവധി ശത്രുക്കളുണ്ട്;","poem":1},{"text":"അകാരണമായി എന്നെ വെറുക്കുന്നവരും അസംഖ്യം.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ഞാൻ ചെയ്യുന്ന നന്മകൾക്കുപകരം അവരെന്നോട് തിന്മചെയ്യുന്നു","poem":1},{"text":"ഞാൻ നന്മമാത്രം അന്വേഷിക്കുന്നതിനാൽ,","poem":2},{"lineBreak":true},{"text":"അവർ എനിക്കു വിരോധികളായിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"യഹോവേ, എന്നെ ഉപേക്ഷിക്കരുതേ;","poem":1},{"text":"എന്റെ ദൈവമേ, എന്നിൽനിന്ന് അകന്നിരിക്കരുതേ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"എന്റെ രക്ഷകനായ കർത്താവേ,","poem":1},{"text":"എന്റെ സഹായത്തിനായി അതിവേഗം വരണമേ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}