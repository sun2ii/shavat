{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":40,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"ഞാൻ യഹോവയ്ക്കായി ക്ഷമയോടെ കാത്തിരുന്നു;","poem":1},{"text":"അവിടന്ന് എങ്കലേക്കു ചാഞ്ഞ് എന്റെ നിലവിളി കേട്ടു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"വഴുവഴുപ്പുള്ള കുഴിയിൽനിന്നും","poem":1},{"text":"ചേറ്റിൽനിന്നും ചെളിയിൽനിന്നും അവിടന്ന് എന്നെ ഉദ്ധരിച്ചു;","poem":2},{"text":"അവിടന്ന് എന്റെ പാദങ്ങൾ ഒരു പാറമേൽ ഉറപ്പിച്ചു","poem":1},{"text":"എനിക്കു നിൽക്കാൻ ഉറപ്പുള്ള ഒരിടംനൽകി.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"എന്റെ അധരങ്ങൾക്ക് അവിടന്നൊരു പുതുഗീതമേകി,","poem":1},{"text":"നമ്മുടെ ദൈവത്തിന് ഒരു സ്തോത്രഗാനംതന്നെ.","poem":2},{"text":"പലരും അതുകണ്ട് യഹോവയെ ഭയപ്പെടുകയും","poem":1},{"text":"അങ്ങയിൽ ആശ്രയംവെക്കുകയും ചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"അഹന്തനിറഞ്ഞവരിൽ ആശ്രയിക്കാതെയും","poem":1},{"text":"വ്യാജദൈവങ്ങളിലേക്കു തിരിയാതെയും","poem":2},{"text":"യഹോവയിൽ ആശ്രയിക്കുന്ന","poem":1},{"text":"മനുഷ്യർ അനുഗൃഹീതർ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"എന്റെ ദൈവമായ യഹോവേ,","poem":1},{"text":"അവിടന്നു ഞങ്ങൾക്കുവേണ്ടി ചെയ്ത അത്ഭുതങ്ങളും","poem":2},{"lineBreak":true},{"text":"അവിടന്നു ഞങ്ങൾക്കായി ആസൂത്രണംചെയ്ത പദ്ധതികളും അനവധിയാകുന്നു.","poem":2},{"text":"അവിടത്തോട് സദൃശനായി ആരുമില്ല;","poem":1},{"text":"അവിടത്തെ പ്രവൃത്തികളെക്കുറിച്ച് ഉദ്ഘോഷിക്കുന്നതിനും വിവരിക്കുന്നതിനും തുനിഞ്ഞാൽ","poem":2},{"lineBreak":true},{"text":"അവ വർണനാതീതമായിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"യാഗവും തിരുമുൽക്കാഴ്ചയും അങ്ങ് ആഗ്രഹിച്ചില്ല—","poem":1},{"text":"എന്നാൽ എന്റെ കാതുകളെ അങ്ങു തുറന്നിരിക്കുന്നു—","poem":2},{"lineBreak":true},{"text":"സർവാംഗദഹനയാഗങ്ങളും പാപശുദ്ധീകരണയാഗങ്ങളും അവിടന്ന് ആവശ്യപ്പെട്ടതുമില്ല.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അപ്പോൾ ഞാൻ പറഞ്ഞു, “ഇതാ ഞാൻ വന്നിരിക്കുന്നു—","poem":1},{"text":"തിരുവെഴുത്തിൽ എന്നെക്കുറിച്ച് രേഖപ്പെടുത്തിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"എന്റെ ദൈവമേ, അങ്ങയുടെ ഇഷ്ടം ചെയ്യാൻ ഞാൻ ആഗ്രഹിക്കുന്നു;","poem":1},{"text":"അങ്ങയുടെ ന്യായപ്രമാണം എന്റെ ഹൃദയത്തിലുണ്ട്.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"മഹാസഭയിൽ ഞാൻ അവിടത്തെ നീതി ഘോഷിക്കുന്നു;","poem":1},{"text":"യഹോവേ, എന്റെ അധരങ്ങൾ ഞാൻ അടച്ചുവെക്കുകയില്ല,","poem":2},{"lineBreak":true},{"text":"എന്ന് അങ്ങേക്ക് അറിയാമല്ലോ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവിടത്തെ നീതി ഞാൻ എന്റെ ഹൃദയത്തിൽ മറച്ചുവെക്കുന്നില്ല;","poem":1},{"text":"അങ്ങയുടെ വിശ്വസ്തതയും രക്ഷയും ഞാൻ ഘോഷിക്കുന്നു.","poem":2},{"text":"അവിടത്തെ അചഞ്ചലസ്നേഹവും വിശ്വസ്തതയും","poem":1},{"text":"ഞാൻ മഹാസഭയിൽനിന്നു മറച്ചുവെക്കുന്നില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"യഹോവേ, അവിടത്തെ കരുണ എന്നിൽനിന്നു പിൻവലിക്കരുതേ;","poem":1},{"text":"അവിടത്തെ അചഞ്ചലസ്നേഹവും വിശ്വസ്തതയും എപ്പോഴും എനിക്കു സംരക്ഷണം നൽകട്ടെ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അസംഖ്യമായ അനർഥങ്ങൾ എന്നെ വലയംചെയ്തിരിക്കുന്നു;","poem":1},{"text":"പുറത്തേക്കുള്ള വഴി കാണാൻ കഴിയാത്തവിധം എന്റെ പാപങ്ങൾ എന്നെ വലയംചെയ്തു കീഴടക്കിയിരിക്കുന്നു.","poem":2},{"text":"അവ എന്റെ തലയിലെ മുടിയിഴകളെക്കാൾ അധികം,","poem":1},{"text":"എന്റെ മനോവീര്യം ചോർന്നുപോകുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"യഹോവേ, എന്നെ രക്ഷിക്കാൻ പ്രസാദമുണ്ടാകണമേ,","poem":1},{"text":"യഹോവേ, എന്നെ സഹായിക്കാൻ വേഗം വരണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"എന്റെ ജീവൻ അപഹരിക്കാൻ ആഗ്രഹിക്കുന്നവരെല്ലാം","poem":1},{"text":"ലജ്ജിതരും പരിഭ്രാന്തരും ആയിത്തീരട്ടെ;","poem":2},{"text":"എന്റെ നാശം ആഗ്രഹിക്കുന്നവരെല്ലാം","poem":1},{"text":"അപമാനിതരായി പിന്തിരിഞ്ഞുപോകട്ടെ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"എന്നോട്, “ആഹാ! ആഹാ!” എന്നു പറയുന്നവർ","poem":1},{"text":"ലജ്ജകൊണ്ട് പരിഭ്രാന്തരാകട്ടെ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"എന്നാൽ അങ്ങയെ അന്വേഷിക്കുന്ന എല്ലാവരും","poem":1},{"text":"അങ്ങയിൽ ആനന്ദിച്ച് ആഹ്ലാദിക്കട്ടെ;","poem":2},{"text":"അവിടത്തെ രക്ഷ ആഗ്രഹിക്കുന്നവർ,","poem":1},{"text":"“യഹോവ ഉന്നതൻ” എന്ന് എപ്പോഴും പറയട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ഞാൻ ദരിദ്രനും ഞെരുക്കമനുഭവിക്കുന്നവനും എങ്കിലും;","poem":1},{"text":"കർത്താവ് എന്നെ ഓർക്കുന്നു.","poem":2},{"text":"അവിടന്ന് എന്റെ സഹായകനും എന്റെ വിമോചകനും ആകുന്നു;","poem":1},{"text":"അവിടന്ന് ആകുന്നു എന്റെ ദൈവം, താമസിക്കരുതേ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}