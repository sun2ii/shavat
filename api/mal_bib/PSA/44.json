{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":44,"content":[{"type":"hebrew_subtitle","content":["കോരഹ് പുത്രന്മാരുടെ ഒരു ധ്യാനസങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"ദൈവമേ, സ്വന്തം ചെവിയാൽ ഞങ്ങൾ കേട്ടിരിക്കുന്നു;","poem":1},{"text":"പൂർവകാലത്ത് അങ്ങ്","poem":2},{"text":"അവർക്കുവേണ്ടി ചെയ്തവയെല്ലാം","poem":1},{"text":"ഞങ്ങളുടെ പൂർവികർ ഞങ്ങളോടു വിവരിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവിടത്തെ കരംകൊണ്ട് അങ്ങ് രാഷ്ട്രങ്ങളെ തുരത്തിയോടിച്ചു","poem":1},{"text":"ഞങ്ങളുടെ പൂർവികർക്കു ദേശം അവകാശമായി നൽകി;","poem":2},{"text":"അവിടന്ന് ജനതകളെ ഞെരിച്ചമർത്തി","poem":1},{"text":"ഞങ്ങളുടെ പൂർവികരെ തഴച്ചുവളരുമാറാക്കി.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവർ ദേശം കൈവശമാക്കിയത് അവരുടെ വാളിനാലോ","poem":1},{"text":"ജയം നേടിയത് അവരുടെ ഭുജത്താലോ ആയിരുന്നില്ല;","poem":2},{"text":"അവരോടുള്ള സ്നേഹംനിമിത്തം അവിടത്തെ വലതുകരവും ബലമേറിയ ഭുജവും","poem":1},{"text":"തിരുമുഖപ്രകാശവും ആണല്ലോ അവ സാധ്യമാക്കിയത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"അങ്ങ് എന്റെ രാജാവും ദൈവവും ആകുന്നു,","poem":1},{"text":"അവിടന്ന് യാക്കോബിന് വിജയമരുളുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവിടത്തെ ശക്തിയാൽ ഞങ്ങൾ ശത്രുക്കളെ പിന്തിരിഞ്ഞോടുമാറാക്കുന്നു;","poem":1},{"text":"അവിടത്തെ നാമത്താൽ ഞങ്ങളുടെ എതിരാളികളെ ചവിട്ടിമെതിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"എന്റെ വില്ലിൽ ഞാൻ ആശ്രയിക്കുന്നില്ല,","poem":1},{"text":"എന്റെ വാൾ എന്നെ രക്ഷിക്കുകയുമില്ല;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"എന്നാൽ ശത്രുക്കളുടെമേൽ അങ്ങാണ് ഞങ്ങൾക്കു വിജയംനൽകുന്നത്,","poem":1},{"text":"അങ്ങ് ഞങ്ങളുടെ എതിരാളികളെ ലജ്ജിതരാക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ദിവസംമുഴുവനും ഞങ്ങൾ ദൈവത്തിൽ പ്രശംസിക്കുന്നു,","poem":1},{"text":"അവിടത്തെ നാമം ഞങ്ങൾ നിത്യം വാഴ്ത്തുന്നു. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"എന്നാൽ ഇപ്പോൾ അവിടന്ന് ഞങ്ങളെ തിരസ്കരിച്ച് ലജ്ജിതരാക്കിയിരിക്കുന്നു;","poem":1},{"text":"അവിടന്ന് ഞങ്ങളുടെ സൈന്യവ്യൂഹത്തോടൊപ്പം പോർമുഖത്തേക്ക് വരുന്നതുമില്ലല്ലോ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അങ്ങ് ഞങ്ങളെ ശത്രുക്കൾക്കുമുമ്പിൽ പിന്തിരിഞ്ഞോടാനിടയാക്കി,","poem":1},{"text":"ഞങ്ങളുടെ എതിരാളികൾ ഞങ്ങളെ കൊള്ളയടിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ആടുകളെ എന്നപോലെ ഞങ്ങളെ തിന്നൊടുക്കാൻ അവർക്ക് അങ്ങ് അനുമതി നൽകി","poem":1},{"text":"ഞങ്ങളെ രാഷ്ട്രങ്ങൾക്കിടയിൽ ചിതറിച്ചുമിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അങ്ങ് അങ്ങയുടെ ജനത്തെ തുച്ഛവിലയ്ക്കു വിറ്റുകളഞ്ഞു,","poem":1},{"text":"ആ വിനിമയത്തിൽ ഒരു നേട്ടവും കൈവന്നില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"അങ്ങ് ഞങ്ങളെ അയൽവാസികൾക്ക് അപമാനവും","poem":1},{"text":"ചുറ്റുമുള്ളവർക്കിടയിൽ നിന്ദയും അപഹാസവും ആക്കിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അങ്ങ് ഞങ്ങളെ രാഷ്ട്രങ്ങൾക്കിടയിൽ ഒരു പഴമൊഴിയും;","poem":1},{"text":"ജനതകൾക്കിടയിൽ പരിഹാസവിഷയവും","poem":2},{"noteId":43},{"text":"ആക്കിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"എന്നെ നിന്ദിക്കുകയും പരിഹസിക്കുകയും ചെയ്യുന്നവരുടെ കുത്തുവാക്കുകളും","poem":1},{"text":"പ്രതികാരത്തോടെ എന്നെ കീഴടക്കാൻ ശ്രമിക്കുന്ന ശത്രുക്കളിൽനിന്നുമുള്ള","poem":2},{"text":"അപമാനവും ദിവസം മുഴുവൻ എന്റെമുമ്പിൽ ഇരിക്കുന്നു","poem":1},{"text":"എന്റെ മുഖം ലജ്ജയാൽ മൂടിയുമിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ഇതൊക്കെയും ഞങ്ങൾക്കുമേൽ വന്നുഭവിച്ചിട്ടും,","poem":1},{"text":"ഞങ്ങൾ അങ്ങയെ മറന്നിട്ടില്ല;","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ ഉടമ്പടിയോട് അവിശ്വസ്തരായിട്ടുമില്ല.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ഞങ്ങളുടെ ഹൃദയം പിന്തിരിഞ്ഞിട്ടില്ല;","poem":1},{"text":"അവിടത്തെ പാതകളിൽനിന്ന് ഞങ്ങളുടെ കാലടികൾ വ്യതിചലിച്ചിട്ടുമില്ല.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"എന്നാൽ അവിടന്നു ഞങ്ങളെ തകർക്കുകയും കുറുനരികൾക്കൊരു സങ്കേതമായി മാറ്റുകയും ചെയ്തിരിക്കുന്നു;","poem":1},{"text":"അവിടന്ന് ഞങ്ങളെ ഘോരാന്ധകാരത്താൽ മൂടിയിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ഞങ്ങളുടെ ദൈവത്തിന്റെ തിരുനാമം ഞങ്ങൾ മറക്കുകയോ,","poem":1},{"text":"അന്യദേവന്റെ മുമ്പിൽ കൈമലർത്തുകയോ ചെയ്തിട്ടുണ്ടായിരുന്നെങ്കിൽ,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ദൈവം അതു കണ്ടെത്താതിരിക്കുമോ?","poem":1},{"text":"അവിടന്ന് ഹൃദയരഹസ്യങ്ങളെ അറിയുന്നവനാണല്ലോ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"എന്നിട്ടും അങ്ങേക്കുവേണ്ടി ദിവസംമുഴുവനും ഞങ്ങൾ മരണത്തെ മുഖാമുഖം കാണുന്നു;","poem":1},{"text":"അറക്കപ്പെടാനുള്ള ആടുകളായി ഞങ്ങളെ പരിഗണിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"കർത്താവേ, ഉണരണമേ! അങ്ങ് നിദ്രയിലമരുന്നത് എന്തിന്?","poem":1},{"text":"ഉണർന്നെഴുന്നേറ്റാലും! എന്നെന്നേക്കുമായി ഞങ്ങളെ ഉപേക്ഷിക്കരുതേ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അങ്ങെന്തിനാണ് ഞങ്ങൾക്കു മുഖം മറയ്ക്കുന്നത്?","poem":1},{"text":"ഞങ്ങളുടെ കഷ്ടവും പീഡയും മറക്കുന്നതും എന്തിന്?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ഞങ്ങൾ പൂഴിയോളം താഴ്ത്തപ്പെട്ടിരിക്കുന്നു;","poem":1},{"text":"ഞങ്ങളുടെ വയറ് നിലത്തു പറ്റിക്കിടക്കുന്നു.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"കർത്താവേ, എഴുന്നേറ്റാലും, ഞങ്ങളെ സഹായിച്ചാലും;","poem":1},{"text":"അവിടത്തെ അചഞ്ചലസ്നേഹത്താൽ ഞങ്ങളെ മോചിപ്പിച്ചാലും.","poem":2}]}],"footnotes":[{"noteId":43,"caller":"+","text":"മൂ.ഭാ. തലകുലുക്കിക്കാട്ടുക","reference":{"chapter":44,"verse":14}}]},"thisChapterLink":"/api/mal_bib/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":25}