{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":45,"content":[{"type":"hebrew_subtitle","content":["കോരഹ് പുത്രന്മാരുടെ ഒരു ധ്യാനസങ്കീർത്തനം. ഒരു വിവാഹഗീതം."]},{"type":"verse","number":1,"content":[{"text":"എന്റെ ഹൃദയം ശുഭചിന്തയാൽ നിറഞ്ഞുകവിയുന്നു","poem":1},{"text":"രാജാവിനുവേണ്ടി എന്റെ കൃതി ഞാൻ ആലപിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"എന്റെ നാവ് നിപുണനായ എഴുത്തുകാരന്റെ തൂലികയാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"അങ്ങ് മാനവകുലജാതരിൽ അതിസുന്ദരൻ","poem":1},{"text":"ലാവണ്യം അങ്ങയുടെ അധരപുടങ്ങളിൽ പകർന്നിരിക്കുന്നു,","poem":2},{"lineBreak":true},{"text":"കാരണം ദൈവം അങ്ങയെ എന്നെന്നേക്കുമായി അനുഗ്രഹിച്ചല്ലോ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"വീരനായ യോദ്ധാവേ, അങ്ങയുടെ വാൾ അരയ്ക്കുകെട്ടുക;","poem":1},{"text":"പ്രതാപവും മഹത്ത്വവും അങ്ങ് അണിഞ്ഞുകൊള്ളുക.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"സത്യത്തിനും സൗമ്യതയ്ക്കും നീതിക്കുംവേണ്ടി","poem":1},{"text":"അവിടത്തെ പ്രതാപത്തിൽ വിജയത്തോടെ മുന്നേറുക;","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ വലതുകരം വിസ്മയാവഹമായ കാര്യങ്ങൾ ഉപദേശിക്കട്ടെ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവിടത്തെ കൂരമ്പുകൾ രാജവിരോധികളുടെ നെഞ്ചകം തകർക്കട്ടെ;","poem":1},{"text":"രാഷ്ട്രങ്ങൾ അങ്ങയുടെ കാൽപ്പാദങ്ങൾക്കടിയിൽ നിലംപതിക്കട്ടെ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ദൈവമേ, അവിടത്തെ സിംഹാസനം എന്നെന്നേക്കും നിലനിൽക്കും;","poem":1},{"text":"അങ്ങയുടെ രാജ്യത്തിൻ ചെങ്കോൽ നീതിയുള്ള ചെങ്കോൽ ആയിരിക്കും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവിടന്ന് നീതിയെ സ്നേഹിക്കുകയും ദുഷ്ടതയെ വെറുക്കുകയും ചെയ്യുന്നു;","poem":1},{"text":"അതുകൊണ്ട് ദൈവം, ദൈവം ആനന്ദതൈലംകൊണ്ട് അങ്ങയെ അഭിഷേകംചെയ്ത്","poem":2},{"lineBreak":true},{"text":"അങ്ങയുടെ സഹകാരികളെക്കാൾ ഏറ്റവും ഉന്നതമായ സ്ഥാനം അങ്ങേക്കു നൽകിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അങ്ങയുടെ ഉടയാടകൾ മീറയും","poem":1},{"noteId":44},{"text":"ചന്ദനവും ലവംഗവുംകൊണ്ട് പരിമളപൂരിതമായിരിക്കുന്നു;","poem":1},{"text":"ദന്താലംകൃതമായ മണിമന്ദിരത്തിൽനിന്നുള്ള","poem":2},{"lineBreak":true},{"text":"തന്ത്രിനാദസംഗീതം അങ്ങയെ ആനന്ദചിത്തനാക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അന്തഃപുരനാരികളിൽ രാജകുമാരികളുണ്ട്;","poem":1},{"text":"അങ്ങയുടെ വലതുഭാഗത്ത് ഓഫീർതങ്കത്താൽ അലംകൃതയായ രാജകുമാരി നിലകൊള്ളുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"അല്ലയോ കുമാരീ, കേൾക്കൂ, ശ്രദ്ധയോടെ ചെവിചായ്‌ക്കൂ:","poem":1},{"text":"നിന്റെ സ്വജനത്തെയും നിന്റെ പിതൃഭവനത്തെയും മറക്കൂ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അപ്പോൾ രാജാവ് നിന്റെ സൗന്ദര്യത്തിൽ ആകൃഷ്ടനായിത്തീരട്ടെ;","poem":1},{"text":"അദ്ദേഹത്തെ നമസ്കരിച്ചുകൊൾക, അദ്ദേഹം നിന്റെ നാഥനല്ലോ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"സോരിലെ രാജകുമാരി നിനക്കൊരുപഹാരവുമായി കടന്നുവരും,","poem":1},{"text":"ധനികർ നിന്റെ പ്രീതിയാർജിക്കാൻ ആഗ്രഹിക്കും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"രാജകുമാരി അവളുടെ അന്തപുരത്തിൽ ശോഭാപരിപൂർണയായിരിക്കുന്നു;","poem":1},{"text":"അവളുടെ ഉടയാടകൾ തങ്കക്കസവുകളാൽ നെയ്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ചിത്രത്തയ്യലുള്ള നിലയങ്കി ധരിച്ചവളായി അവൾ രാജസന്നിധിയിലേക്ക് ആനയിക്കപ്പെടുന്നു;","poem":1},{"text":"കന്യാമണികളാം തോഴികൾ അവൾക്ക് അകമ്പടിനിൽക്കുന്നു.","poem":2},{"lineBreak":true},{"text":"അവരും അവളോടൊപ്പം വന്നുചേരും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ആനന്ദത്തോടും ആഹ്ലാദത്തോടും അവർ ആനയിക്കപ്പെടുന്നു,","poem":1},{"text":"അവർ രാജകൊട്ടാരത്തിൽ പ്രവേശിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"അവിടത്തെ പുത്രന്മാർ അങ്ങയുടെ അനന്തരാവകാശികളായി അവരോധിക്കപ്പെടും;","poem":1},{"text":"അങ്ങ് അവരെ ഭൂമിയിലെങ്ങും പ്രഭുക്കന്മാരായി വാഴിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ഞാൻ അങ്ങയുടെ സ്മരണ എല്ലാ തലമുറകളിലും നിലനിർത്തും","poem":1},{"text":"തന്മൂലം രാഷ്ട്രങ്ങൾ അങ്ങയെ എന്നെന്നേക്കും വാഴ്ത്തും.","poem":2}]}],"footnotes":[{"noteId":44,"caller":"+","text":"അഥവാ, നറുമ്പശയും","reference":{"chapter":45,"verse":8}}]},"thisChapterLink":"/api/mal_bib/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}