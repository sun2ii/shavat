{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["അലാമോത്ത് രാഗത്തിൽ കോരഹ് പുത്രന്മാരുടെ ഒരു ഗീതം."]},{"type":"verse","number":1,"content":[{"text":"ദൈവം നമ്മുടെ സങ്കേതവും ശക്തിസ്രോതസ്സും ആകുന്നു,","poem":1},{"text":"കഷ്ടങ്ങളിൽ അവിടന്ന് ഏറ്റവും അടുത്ത തുണയായിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അതുകൊണ്ട് ഭൂമി വഴുതിമാറിയാലും","poem":1},{"text":"പർവതങ്ങൾ ആഴിയുടെ ആഴത്തിൽ അമർന്നാലും","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അതിലെ വെള്ളം ആർത്തിരമ്പി നുരച്ചുപൊങ്ങിയാലും","poem":1},{"text":"അതിന്റെ പ്രകമ്പനത്താൽ പർവതങ്ങൾ വിറകൊണ്ടാലും ഞങ്ങൾ ഭയപ്പെടുകയില്ല. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ഒരു നദിയുണ്ട്; അതിന്റെ അരുവികൾ ദൈവനഗരത്തെ ആനന്ദഭരിതമാക്കുന്നു,","poem":1},{"text":"അത്യുന്നതന്റെ നിവാസസ്ഥാനമായ വിശുദ്ധ സ്ഥലത്തെത്തന്നെ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ദൈവം ആ നഗരത്തിലുണ്ട്, അതിന് ഇളക്കംതട്ടുകയില്ല;","poem":1},{"text":"പുലർകാലംമുതൽതന്നെ ദൈവം അതിനെ സംരക്ഷിക്കും.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"രാഷ്ട്രങ്ങൾ ഇളകിമറിയുന്നു, രാജ്യങ്ങൾ നിലംപൊത്തുന്നു;","poem":1},{"text":"അവിടന്നു തന്റെ ശബ്ദമുയർത്തുന്നു, ഭൂമി ഉരുകിയൊലിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"സൈന്യങ്ങളുടെ യഹോവ നമ്മോടൊപ്പമുണ്ട്;","poem":1},{"text":"യാക്കോബിന്റെ ദൈവം നമ്മുടെ കോട്ടയാകുന്നു. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"വരിക, യഹോവയുടെ പ്രവൃത്തികളെ കാണുക,","poem":1},{"text":"അവിടന്ന് ഭൂമിയിൽ എത്ര ശൂന്യത വരുത്തിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവിടന്ന് ഭൂസീമകളിൽ","poem":1},{"text":"യുദ്ധത്തിനു വിരാമംകുറിച്ചിരിക്കുന്നു.","poem":2},{"text":"അവിടന്ന് വില്ല് ഒരുക്കുകയും കുന്തത്തെ ചിതറിക്കുകയും;","poem":1},{"text":"രഥങ്ങൾ","poem":2},{"noteId":45},{"text":"അഗ്നിക്കിരയാക്കുകയും ചെയ്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“ശാന്തരായിരുന്ന് ഞാൻ ആകുന്നു ദൈവം എന്ന് അറിഞ്ഞുകൊൾക;","poem":1},{"text":"ഞാൻ രാഷ്ട്രങ്ങൾക്കിടയിൽ ഉന്നതനാകും","poem":2},{"lineBreak":true},{"text":"ഞാൻ ഭൂമിയിൽ ഉന്നതനാകും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"സൈന്യങ്ങളുടെ യഹോവ നമ്മോടൊപ്പമുണ്ട്;","poem":1},{"text":"യാക്കോബിന്റെ ദൈവം നമ്മുടെ കോട്ടയാകുന്നു. സേലാ.","poem":2}]}],"footnotes":[{"noteId":45,"caller":"+","text":"അഥവാ, പരിചകൾ","reference":{"chapter":46,"verse":9}}]},"thisChapterLink":"/api/mal_bib/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}