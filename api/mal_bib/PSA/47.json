{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["കോരഹ് പുത്രന്മാരുടെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"സകലജനതകളുമേ, കൈകൊട്ടുക;","poem":1},{"text":"ആനന്ദഘോഷത്തോടെ ദൈവത്തിന് ആർപ്പിടുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"കാരണം അത്യുന്നതനായ യഹോവ ഭയങ്കരൻ,","poem":1},{"text":"അവിടന്ന് സർവഭൂമിക്കും മഹാരാജാവുതന്നെ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവിടന്ന് രാഷ്ട്രങ്ങളെ നമ്മുടെ കീഴിലും","poem":1},{"text":"ജനതകളെ നമ്മുടെ കാൽക്കീഴിലുമാക്കി.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവിടന്ന് നമുക്കുവേണ്ടി നമ്മുടെ അവകാശഭൂമിയെ തെരഞ്ഞെടുത്തു,","poem":1},{"text":"അവിടന്ന് സ്നേഹിച്ച യാക്കോബിന്റെ അഭിമാനത്തെത്തന്നെ. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ആനന്ദഘോഷത്തോടെ ദൈവം ആരോഹണം ചെയ്തിരിക്കുന്നു,","poem":1},{"text":"കാഹളനാദത്തോടെ യഹോവയും.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ദൈവത്തിനു സ്തുതിപാടുക, സ്തുതിപാടുക;","poem":1},{"text":"നമ്മുടെ രാജാവിനു സ്തുതിപാടുക, സ്തുതിപാടുക.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"കാരണം ദൈവം സർവഭൂമിക്കും രാജാവാകുന്നു;","poem":1},{"text":"അവിടത്തേക്കൊരു സ്തുതിഗീതം ആലപിക്കുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ദൈവം രാഷ്ട്രങ്ങളുടെമേൽ വാഴുന്നു;","poem":1},{"text":"ദൈവം അവിടത്തെ വിശുദ്ധസിംഹാസനത്തിൽ ഉപവിഷ്ടനാകുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"രാഷ്ട്രങ്ങളുടെ ശ്രേഷ്ഠർ","poem":1},{"text":"അബ്രാഹാമിന്റെ ദൈവത്തിന്റെ ജനമായി ഒത്തുചേരുന്നു,","poem":2},{"text":"കാരണം ഭൂമിയിലെ രാജാക്കന്മാരെല്ലാം","poem":1},{"noteId":46},{"text":"ദൈവത്തിനുള്ളതാണ്;","poem":1},{"text":"അവിടന്ന് ഏറ്റവും ഉന്നതനായിരിക്കുന്നു.","poem":2}]}],"footnotes":[{"noteId":46,"caller":"+","text":"അഥവാ, പരിചകൾ","reference":{"chapter":47,"verse":9}}]},"thisChapterLink":"/api/mal_bib/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}