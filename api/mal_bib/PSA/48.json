{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":48,"content":[{"type":"hebrew_subtitle","content":["ഒരു ഗീതം. കോരഹ് പുത്രന്മാരുടെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"നമ്മുടെ ദൈവത്തിന്റെ പട്ടണത്തിൽ, അവിടത്തെ വിശുദ്ധപർവതത്തിൽ,","poem":1},{"text":"യഹോവ ഉന്നതനും അത്യന്തം സ്തുത്യനും ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"മഹാരാജാവിന്റെ നഗരമായി","poem":1},{"text":"സാഫോൺ","poem":2},{"noteId":47},{"text":"ഗിരിപോലെയുള്ള സീയോൻപർവതം","poem":2},{"text":"ഔന്നത്യംകൊണ്ട് മനോഹരവും","poem":1},{"text":"സർവഭൂമിയുടെ ആനന്ദവും ആകുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവളിലെ","poem":1},{"noteId":48},{"text":"കോട്ടകൾക്കുള്ളിൽ ദൈവമുണ്ട്;","poem":1},{"text":"അവൾക്കൊരു അഭയസ്ഥാനമായി അവിടന്ന് സ്വയം വെളിപ്പെടുത്തിയിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ഇതാ, രാജാക്കന്മാർ സൈന്യസമേതം ഒത്തുചേർന്നു","poem":1},{"text":"അവർ ഒത്തൊരുമിച്ചു മുന്നേറി,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവർ അവളെ നോക്കി അമ്പരപ്പോടെ നിന്നുപോയി","poem":1},{"text":"സംഭീതരായവർ പലായനംചെയ്തു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവർക്കൊരു വിറയൽ ബാധിച്ചു","poem":1},{"text":"പ്രസവവേദന അനുഭവിക്കുന്ന സ്ത്രീയെപ്പോലെ കഠിനവേദന അവർക്കുണ്ടായി.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"കിഴക്കൻകാറ്റിനാൽ തകർക്കപ്പെടുന്ന തർശീശ് കപ്പലുകളെപ്പോലെ","poem":1},{"text":"അവിടന്ന് അവരെ നശിപ്പിച്ചുകളഞ്ഞു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ഞങ്ങൾ കേട്ടതുപോലെതന്നെ","poem":1},{"text":"ഞങ്ങൾ കണ്ടിരിക്കുന്നു,","poem":2},{"text":"സൈന്യങ്ങളുടെ യഹോവയുടെ നഗരത്തിൽ,","poem":1},{"text":"നമ്മുടെ ദൈവത്തിന്റെ നഗരത്തിൽത്തന്നെ:","poem":2},{"text":"ദൈവം എന്നേക്കും","poem":1},{"text":"അവളെ സുരക്ഷിതയാക്കുന്നു. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ദൈവമേ, അവിടത്തെ ആലയത്തിൽ","poem":1},{"text":"ഞങ്ങൾ അങ്ങയുടെ അചഞ്ചലസ്നേഹത്തെപ്പറ്റി ധ്യാനിക്കുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ദൈവമേ, അങ്ങയുടെ നാമംപോലെതന്നെ,","poem":1},{"text":"അവിടത്തെ സ്തുതികൾ ഭൂസീമകളോളം അലയടിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ വലതുകരത്തിൽ നീതി നിറഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അവിടത്തെ ന്യായവിധികൾനിമിത്തം","poem":1},{"text":"സീയോൻപർവതം ആനന്ദിക്കുകയും","poem":2},{"lineBreak":true},{"text":"യെഹൂദാപട്ടണങ്ങൾ","poem":2},{"noteId":49},{"text":"ആഹ്ലാദിക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"സീയോനുചുറ്റും നടക്കുക, അവൾക്കുചുറ്റും പ്രദക്ഷിണംചെയ്യുക,","poem":1},{"text":"അവളുടെ ഗോപുരങ്ങൾ എണ്ണുക,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അവളുടെ പ്രതിരോധസന്നാഹം സസൂക്ഷ്മം നിരീക്ഷിക്കുക","poem":1},{"text":"അവളുടെ കോട്ടമതിലുകൾ സൂക്ഷിച്ചുനോക്കുക,","poem":2},{"text":"വരുംതലമുറയോട്","poem":1},{"text":"അവളെക്കുറിച്ചു പറയേണ്ടതിനുതന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"കാരണം ഈ ദൈവം ഇന്നുമെന്നേക്കും നമ്മുടെ ദൈവം ആകുന്നു;","poem":1},{"text":"അന്ത്യംവരെയും അവിടന്നായിരിക്കും നമ്മുടെ മാർഗദർശി.","poem":2}]}],"footnotes":[{"noteId":47,"caller":"+","text":"സാഫോൺ, കനാന്യരുടെ ഏറ്റവും പവിത്രം എന്നുകരുതപ്പെടുന്ന പർവതം.","reference":{"chapter":48,"verse":2}},{"noteId":48,"caller":"+","text":"അവളിലെ, വിവക്ഷിക്കുന്നത് ജെറുശലേമിലെ","reference":{"chapter":48,"verse":3}},{"noteId":49,"caller":"+","text":"മൂ.ഭാ. യെഹൂദാപുത്രികൾ","reference":{"chapter":48,"verse":11}}]},"thisChapterLink":"/api/mal_bib/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}