{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":49,"content":[{"type":"hebrew_subtitle","content":["കോരഹ് പുത്രന്മാരുടെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"സർവജനതകളുമേ, നിങ്ങൾ ഇതു കേൾക്കുക;","poem":1},{"text":"ഈ ഭൂമിയിൽ അധിവസിക്കുന്ന സകലരുമേ, ഇതു ശ്രദ്ധിക്കുക,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"താഴ്ന്നവരും ഉന്നതരും","poem":1},{"text":"ധനികരും ദരിദ്രരും ഒരുപോലെ കേൾക്കുക:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"എന്റെ വായ് ജ്ഞാനം സംസാരിക്കും;","poem":1},{"text":"എന്റെ ഹൃദയത്തിലെ ധ്യാനം വിവേകം മന്ത്രിക്കും.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"സുഭാഷിതത്തിനു ഞാൻ എന്റെ ചെവിചായ്‌ക്കും;","poem":1},{"text":"കിന്നരവാദ്യത്തോടെ ഞാൻ കടങ്കഥയ്ക്ക് ഉത്തരം പറയും:","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"വഞ്ചകരായ ദുഷ്ടർ എന്നെ വലയംചെയ്യുകയും","poem":1},{"text":"കഷ്ടതയുടെദിനങ്ങൾ വരികയുംചെയ്യുമ്പോൾ ഞാൻ എന്തിനു ഭയപ്പെടണം?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവർ അവരുടെ ധനത്തിൽ ആശ്രയിക്കുകയും","poem":1},{"text":"തങ്ങളുടെ മഹത്തായ സമ്പത്തിൽ ഊറ്റംകൊള്ളുകയും ചെയ്യുന്നവരാണ്.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"മറ്റൊരാളുടെ ജീവൻ വീണ്ടെടുക്കുന്നതിനോ","poem":1},{"text":"അയാളുടെ വീണ്ടെടുപ്പുവില ദൈവത്തിനു നൽകുന്നതിനോ ആരാലും സാധ്യമല്ല—","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ഒരാൾ സദാ ജീവിച്ചിരിക്കുന്നതിനും","poem":1},{"text":"ജീർണത","poem":2},{"noteId":50},{"text":"കാണാതിരിക്കുന്നതിനുമായി","poem":2},{"text":"എന്തു നൽകിയാലും മതിയാകുകയില്ല—","poem":1},{"text":"ജീവന്റെ മോചനദ്രവ്യം വിലയേറിയതല്ലോ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ജ്ഞാനികൾ മരണത്തിനു കീഴടങ്ങുന്നതും","poem":1},{"text":"ഭോഷരും വിവേകമില്ലാത്തവരും നശിക്കുന്നതും","poem":2},{"lineBreak":true},{"text":"അവരുടെ സമ്പാദ്യം മറ്റുള്ളവർക്കായി വിട്ടിട്ടുപോകുന്നതും എല്ലാവരും കാണുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ദേശങ്ങൾക്ക് അവർ സ്വന്തം പേരിട്ടുവിളിച്ചാലും,","poem":1},{"text":"ശവകുടീരങ്ങളായിരിക്കും അവരുടെ ശാശ്വതഭവനം,","poem":2},{"lineBreak":true},{"text":"അനന്തര തലമുറകളിലും അതുതന്നെയാണവരുടെ വിശ്രമസ്ഥാനം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"മനുഷ്യർ എത്ര പ്രതാപശാലികൾ ആയിരുന്നാലും അവർക്ക് അമരത്വം ലഭിക്കുകയില്ല;","poem":1},{"text":"അവർ നശിച്ചുപോകുന്ന മൃഗത്തിനു തുല്യർ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"സ്വയത്തിലാശ്രയിക്കുന്നവരുടെ വിധിനിർണയം ഇതായിരിക്കും,","poem":1},{"text":"അവരുടെ വാക്കുകൾ കേട്ട് അവരെ അനുഗമിക്കുന്നവരുടെയും ഗതി ഇതുതന്നെ. സേലാ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവർ ആടുകളെപ്പോലെ മൃതലോകത്തിനായി വിധിക്കപ്പെട്ടിരിക്കുന്നു;","poem":1},{"text":"മരണം അവരുടെ ഇടയനായിരിക്കും","poem":2},{"lineBreak":true},{"text":"എന്നാൽ പ്രഭാതത്തിൽ പരമാർഥതയുള്ളവർ അവരെ നയിക്കും.","poem":2},{"text":"അവരുടെ രാജകീയ മണിമാളികകളിൽനിന്ന് ദൂരെയുള്ള","poem":1},{"text":"ശ്മശാനത്തിൽ അവരുടെ ശരീരങ്ങൾ അഴുകിച്ചേരും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"എന്നാൽ ദൈവം എന്റെ ജീവനെ പാതാളത്തിന്റെ അധീനതയിൽനിന്നു വീണ്ടെടുക്കും;","poem":1},{"text":"അവിടന്നെന്നെ സ്വീകരിക്കും, നിശ്ചയം. സേലാ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"മറ്റുള്ളവരുടെ ധനം വർധിക്കുകയോ","poem":1},{"text":"അവരുടെ ഭവനത്തിന്റെ മഹത്ത്വം വർധിക്കുകയോ ചെയ്യുമ്പോൾ നീ ഭയപ്പെടേണ്ടതില്ല;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"കാരണം, മരിക്കുമ്പോൾ ഒന്നുംതന്നെ അവർ കൊണ്ടുപോകുകയില്ല,","poem":1},{"text":"അവരുടെ ധനമാഹാത്മ്യം അവരെ പിൻചെല്ലുകയുമില്ല.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ജീവിച്ചിരുന്നപ്പോൾ അവർ സ്വയം അനുഗ്രഹിക്കപ്പെട്ടവർ എന്നു കരുതിവന്നിരുന്നെങ്കിലും—","poem":1},{"text":"അവരുടെ അഭിവൃദ്ധിയിൽ ജനം അവരെ പുകഴ്ത്തിവന്നെങ്കിലും—","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അവർ തങ്ങൾക്കു മുമ്പുണ്ടായിരുന്നവരെപ്പോലെ മരണമടയുന്നു,","poem":1},{"text":"അവർ ഇനിയൊരിക്കലും വെളിച്ചം കാണുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"സമ്പന്നരെങ്കിലും വിവേകമില്ലാത്തവർ","poem":1},{"text":"നശിച്ചുപോകുന്ന മൃഗങ്ങൾക്കു സമരായിരിക്കും.","poem":2}]}],"footnotes":[{"noteId":50,"caller":"+","text":"-9 അഥവാ, ശവക്കുഴി","reference":{"chapter":49,"verse":8}}]},"thisChapterLink":"/api/mal_bib/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":19}