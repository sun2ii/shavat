{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":5,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"യഹോവേ, എന്റെ വാക്കുകൾ കേൾക്കണമേ,","poem":1},{"text":"എന്റെ നെടുവീർപ്പു ശ്രദ്ധിക്കണമേ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"എന്റെ രാജാവും എന്റെ ദൈവവുമേ,","poem":1},{"text":"സഹായത്തിനായുള്ള എന്റെ നിലവിളി കേൾക്കണമേ,","poem":2},{"lineBreak":true},{"text":"അവിടത്തോടല്ലോ ഞാൻ പ്രാർഥിക്കുന്നത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"യഹോവേ, പ്രഭാതത്തിൽ അവിടന്ന് എന്റെ ശബ്ദം കേൾക്കണമേ;","poem":1},{"text":"പുലർകാലത്തിൽ ഞാൻ എന്റെ ആവലാതി തിരുമുമ്പിൽ സമർപ്പിക്കുകയും","poem":2},{"lineBreak":true},{"text":"പ്രതീക്ഷയോടെ കാത്തിരിക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവിടന്ന് അധർമത്തിൽ പ്രസാദിക്കുന്ന ദൈവമല്ലല്ലോ;","poem":1},{"text":"തിന്മ പ്രവർത്തിക്കുന്നവർ അവിടത്തോടൊപ്പം വസിക്കുകയില്ല.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവിടത്തെ സന്നിധിയിൽ","poem":1},{"text":"ധിക്കാരികൾ നിൽക്കുകയില്ല.","poem":2},{"text":"അധർമം പ്രവർത്തിക്കുന്നവരെ അവിടന്നു വെറുക്കുന്നു;","poem":1}]},{"type":"verse","number":6,"content":[{"text":"വ്യാജം പറയുന്നവരെ അവിടന്നു നശിപ്പിക്കുന്നു.","poem":2},{"text":"രക്തദാഹികളെയും വഞ്ചകരെയും","poem":1},{"text":"യഹോവയ്ക്ക് അറപ്പാകുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"എന്നാൽ ഞാൻ, അവിടത്തെ അചഞ്ചലസ്നേഹത്താൽ,","poem":1},{"text":"അങ്ങയുടെ ആലയത്തിലേക്കു വന്നുചേരും;","poem":2},{"text":"അവിടത്തെ വിശുദ്ധമന്ദിരത്തിനുനേരേ","poem":1},{"text":"ഭയഭക്തിയോടെ ഞാൻ സാഷ്ടാംഗംവീഴും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"യഹോവേ, എന്റെ ശത്രുക്കൾനിമിത്തം,","poem":1},{"text":"അവിടത്തെ നീതിയാൽ എന്നെ നയിക്കണമേ;","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ മാർഗം എന്റെമുമ്പിൽ സുഗമമാക്കണമേ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവരുടെ വായിൽനിന്നുള്ള ഒരു വാക്കും വിശ്വാസയോഗ്യമല്ല;","poem":1},{"text":"അവരുടെ ഹൃദയം നാശകൂപംതന്നെ.","poem":2},{"text":"അവരുടെ കണ്ഠം തുറന്ന ശവക്കല്ലറയാണ്;","poem":1},{"text":"നാവിനാലവർ മുഖസ്തുതിയുരുവിടുന്നു.","poem":2},{"noteId":9}]},{"type":"verse","number":10,"content":[{"text":"അല്ലയോ ദൈവമേ! അവരെ കുറ്റക്കാരായി വിധിക്കണമേ,","poem":1},{"text":"അവരുടെതന്നെ ഗൂഢാലോചനയാൽ അവർ നിലംപതിക്കട്ടെ.","poem":2},{"text":"അങ്ങേക്കെതിരേ അവർ കലാപം ഉയർത്തിയിരിക്കുന്നു,","poem":1},{"text":"അവരെ അവരുടെ പാപങ്ങളുടെ ബാഹുല്യംനിമിത്തം പുറന്തള്ളണമേ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"എന്നാൽ തിരുസന്നിധിയിൽ അഭയം തേടുന്നവരെല്ലാം ആനന്ദിക്കട്ടെ;","poem":1},{"text":"അവരെന്നും ആനന്ദഗാനമാലപിക്കട്ടെ.","poem":2},{"text":"തിരുനാമത്തെ സ്നേഹിക്കുന്നവർ അങ്ങയിൽ ആനന്ദിക്കുന്നതിനായി,","poem":1},{"text":"അവിടത്തെ സംരക്ഷണം അവർക്കുമീതേ വിരിക്കട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"യഹോവേ, അവിടന്നു നീതിനിഷ്ഠരെ അനുഗ്രഹിക്കുന്നു;","poem":1},{"text":"പരിചകൊണ്ടെന്നപോലെ അങ്ങ് അവരെ കാരുണ്യത്താൽ മറയ്ക്കുന്നു.","poem":2}]}],"footnotes":[{"noteId":9,"caller":"+","text":"റോമ. 3:13","reference":{"chapter":5,"verse":9}}]},"thisChapterLink":"/api/mal_bib/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}