{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":50,"content":[{"type":"hebrew_subtitle","content":["ആസാഫിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"ശക്തനായ ദൈവം, യഹോവ, അരുളിച്ചെയ്യുന്നു,","poem":1},{"text":"അവിടന്ന് ഭൂമിയെ വിളിക്കുന്നു","poem":2},{"lineBreak":true},{"text":"സൂര്യന്റെ ഉദയംമുതൽ അസ്തമയംവരെയുള്ള സകലരെയും.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ദൈവം പ്രകാശിക്കുന്നു,","poem":1},{"text":"സൗന്ദര്യത്തിന്റെ സമ്പൂർണതയായ സീയോനിൽനിന്നുതന്നെ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"നമ്മുടെ ദൈവം വരുന്നു","poem":1},{"text":"അവിടന്നു മൗനമായിരിക്കുകയില്ല;","poem":2},{"text":"ദഹിപ്പിക്കുന്ന അഗ്നി തിരുമുമ്പിലുണ്ട്","poem":1},{"text":"അവിടത്തെ ചുറ്റും കൊടുങ്കാറ്റ് ആഞ്ഞുവീശുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവിടന്ന് തന്റെ ജനത്തിന്റെ ന്യായവിധിക്കു സാക്ഷികളായി","poem":1},{"text":"മീതേയുള്ള ആകാശത്തെയും താഴെയുള്ള ഭൂമിയെയും വിളിക്കുന്നു:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“ഈ സമർപ്പിക്കപ്പെട്ട ജനത്തെ എന്റെ അടുക്കൽ കൂട്ടിവരുത്തുക,","poem":1},{"text":"യാഗാർപ്പണത്താൽ എന്നോട് ഉടമ്പടിചെയ്തവരെത്തന്നെ.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അപ്പോൾ ആകാശം അവിടത്തെ നീതി പ്രഖ്യാപിക്കട്ടെ,","poem":1},{"text":"കാരണം ദൈവംതന്നെ ന്യായാധിപതി ആയിരിക്കും. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“എന്റെ ജനമേ, കേൾക്കുക. ഇതാ ഞാൻ അരുളിച്ചെയ്യുന്നു;","poem":1},{"text":"ഇസ്രായേലേ, ഞാൻ നിനക്കെതിരായി സാക്ഷ്യംപറയും:","poem":2},{"lineBreak":true},{"text":"ഞാൻ ആകുന്നു ദൈവം, നിങ്ങളുടെ ദൈവംതന്നെ!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"നിങ്ങളുടെ യാഗങ്ങൾനിമിത്തമോ","poem":1},{"text":"നിങ്ങൾ നിരന്തരം അർപ്പിക്കുന്ന ഹോമയാഗങ്ങൾനിമിത്തമോ ഞാൻ നിങ്ങളെ ശാസിക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"നിങ്ങളുടെ തൊഴുത്തിൽനിന്നുള്ള കാളയോ","poem":1},{"text":"ആലയിൽനിന്നുള്ള കോലാടോ എനിക്ക് ആവശ്യമില്ല;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ആയിരം കുന്നുകളിൽ മേഞ്ഞുകൊണ്ടിരിക്കുന്ന കന്നുകാലികളും","poem":1},{"text":"വനത്തിലെ സകലമൃഗങ്ങളും എന്റെ സ്വന്തം.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"പർവതങ്ങളിലെ എല്ലാ പറവയെയും ഞാൻ അറിയുന്നു,","poem":1},{"text":"വയലിലെ സകലജന്തുക്കളും എന്റെ വകയാണ്.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"എനിക്കു വിശക്കുന്നെങ്കിൽ ഞാൻ നിന്നോടു പറയുകയില്ല,","poem":1},{"text":"കാരണം, ലോകവും അതിലുള്ള സമസ്തവും എന്റേതാണ്.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ഞാൻ കാളകളുടെ മാംസം ഭുജിക്കുമോ?","poem":1},{"text":"കോലാടുകളുടെ രക്തം പാനംചെയ്യുമോ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ദൈവത്തിനു സ്തോത്രയാഗങ്ങൾ അർപ്പിക്കുക,","poem":1},{"text":"അത്യുന്നതന് നിന്റെ നേർച്ചകൾ അർപ്പിക്കുക,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അനർഥദിനങ്ങളിൽ എന്നെ വിളിച്ചപേക്ഷിക്കുക;","poem":1},{"text":"അപ്പോൾ ഞാൻ നിന്നെ വിടുവിക്കുകയും നീ എന്നെ മഹത്ത്വപ്പെടുത്തുകയും ചെയ്യും.”","poem":2}]},{"type":"verse","number":16,"content":["എന്നാൽ ദുഷ്ടരോട് ദൈവം ആജ്ഞാപിച്ചു:",{"text":"“എന്റെ നിയമങ്ങൾ ഉരുവിടുന്നതിനോ","poem":1},{"text":"എന്റെ ഉടമ്പടിയെപ്പറ്റി ഉച്ചരിക്കുന്നതിനോ നിനക്കെന്തവകാശം?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"നീ എന്റെ ഉപദേശം വെറുക്കുകയും","poem":1},{"text":"എന്റെ ആജ്ഞകൾ നിന്റെ പിന്നിൽ എറിഞ്ഞുകളയുകയുംചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ഒരു കള്ളനെക്കാണുമ്പോൾ നീ അയാളുമായി ചങ്ങാത്തംകൂടുന്നു;","poem":1},{"text":"വ്യഭിചാരികളുമായി നീ ഭാഗധേയം പങ്കിടുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"നിന്റെ വായ് അധർമത്തിനായി ഉപയോഗിക്കുന്നു","poem":1},{"text":"വഞ്ചനയ്ക്കായി നിന്റെ നാവു നീ ഒരുക്കുന്നു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"നീ നിരന്തരം നിന്റെ സഹോദരനെതിരേ സംസാരിക്കുന്നു","poem":1},{"text":"നിന്റെ അമ്മയുടെ മകനെപ്പറ്റി അപവാദം പരത്തുന്നു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ഈ കാര്യങ്ങളൊക്കെ നീ ചെയ്തിട്ടും ഞാൻ മൗനംപാലിച്ചു,","poem":1},{"text":"ഞാനും നിന്നെപ്പോലെയുള്ള ഒരാളെന്നു നീ നിരൂപിച്ചു.","poem":2},{"text":"എന്നാൽ ഞാൻ ഇപ്പോൾ നിന്നെ ശാസിക്കും","poem":1},{"text":"നിനക്കെതിരേ ഞാൻ അവ നിരത്തിവെക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“ദൈവത്തെ മറക്കുന്നവരേ, ഇത് ഓർത്തുകൊൾക,","poem":1},{"text":"അല്ലെങ്കിൽ ഞാൻ നിങ്ങളെ ഛിന്നഭിന്നമാക്കും, നിങ്ങളുടെ മോചനത്തിന് ആരും ഉണ്ടാകുകയില്ല:","poem":2}]},{"type":"verse","number":23,"content":[{"text":"സ്തോത്രയാഗങ്ങൾ അർപ്പിക്കുന്നവർ എന്നെ ആദരിക്കുന്നു,","poem":1},{"text":"നിഷ്കളങ്കർക്ക്","poem":2},{"noteId":51},{"text":"ഞാൻ എന്റെ ദൈവത്തിന്റെ രക്ഷയെ വെളിപ്പെടുത്തും.”","poem":2}]}],"footnotes":[{"noteId":51,"caller":"+","text":"ഈ വാക്കിനുള്ള എബ്രായപദത്തിന്റെ അർഥം വ്യക്തമല്ല.","reference":{"chapter":50,"verse":23}}]},"thisChapterLink":"/api/mal_bib/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}