{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":52,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു ധ്യാനസങ്കീർത്തനം. ഏദോമ്യനായ ദോയേഗ് ചെന്നു ശൗലിനോട്: “ദാവീദ് അഹീമെലെക്കിന്റെ വീട്ടിൽ വന്നിരുന്നു” എന്നറിയിച്ചപ്പോൾ ചമച്ചതു."]},{"type":"verse","number":1,"content":[{"text":"സമർഥനായ യോദ്ധാവേ, നീ നിന്റെ അധർമത്തിൽ അഹങ്കരിക്കുന്നതെന്തിന്?","poem":1},{"text":"ദൈവദൃഷ്ടിയിൽ നിന്ദിതനായിത്തീർന്ന നീ,","poem":2},{"lineBreak":true},{"text":"ദിവസംമുഴുവനും അഹങ്കരിക്കുന്നതെന്തേ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"വഞ്ചന വിതയ്ക്കുന്നവരേ,","poem":1},{"text":"നിന്റെ നാവ് നാശം ആസൂത്രണംചെയ്യുന്നു;","poem":2},{"lineBreak":true},{"text":"അതു മൂർച്ചയേറിയ ക്ഷൗരക്കത്തിപോലെയാണ്.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"നീ നന്മയെക്കാൾ തിന്മ ഇഷ്ടപ്പെടുന്നു","poem":1},{"text":"സത്യം സംസാരിക്കുന്നതിനെക്കാൾ നിനക്കിഷ്ടം വ്യാജമാണ്. സേലാ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"വഞ്ചനനിറഞ്ഞ നാവേ,","poem":1},{"text":"നാശകരമായ എല്ലാ വാക്കുകളും നിനക്കിഷ്ടമാണ്!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ദൈവം നിന്നെ നിത്യനാശത്തിലേക്കു വലിച്ചിഴയ്ക്കും, നിശ്ചയം:","poem":1},{"text":"അവിടന്ന് നിന്നെ നിന്റെ കൂടാരത്തിൽനിന്നു പറിച്ചെടുത്ത് ചീന്തിക്കളയും;","poem":2},{"lineBreak":true},{"text":"ജീവനുള്ളവരുടെ ദേശത്തുനിന്ന് അവിടന്ന് നിന്നെ വേരോടെ പിഴുതെറിയും. സേലാ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"നീതിനിഷ്ഠർ അതുകണ്ടു ഭയപ്പെടും;","poem":1},{"text":"നിന്നെ പരിഹസിച്ചുകൊണ്ട് അവർ ഇപ്രകാരം പറയും,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“ദൈവത്തെ തന്റെ അഭയസ്ഥാനമായി കാണാതെ","poem":1},{"text":"സ്വന്തം സമ്പൽസമൃദ്ധിയിൽ ആശ്രയിച്ചുകൊണ്ട്","poem":2},{"text":"മറ്റുള്ളവരെ നശിപ്പിച്ച് ശക്തനായിത്തീർന്ന","poem":1},{"text":"ആ മനുഷ്യൻ ഇതാ!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ഞാനോ, ദൈവഭവനത്തിൽ തഴച്ചുവളരുന്ന","poem":1},{"text":"ഒരു ഒലിവുമരംപോലെയല്ലോ;","poem":2},{"text":"ദൈവത്തിന്റെ അചഞ്ചലസ്നേഹത്തിൽ","poem":1},{"text":"ഞാൻ എന്നുമെന്നും ആശ്രയിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവിടത്തെ വിശ്വസ്തരുടെ സാന്നിധ്യത്തിൽ","poem":1},{"text":"അങ്ങ് ചെയ്ത അനുഗ്രഹങ്ങളെയോർത്ത് എന്നെന്നും ഞാൻ അങ്ങേക്ക് സ്തോത്രാർപ്പണംചെയ്യും.","poem":2},{"text":"അവിടത്തെ നാമത്തിൽ ഞാൻ പ്രത്യാശയർപ്പിക്കും","poem":1},{"text":"അവിടത്തെ വിശ്വസ്തർക്കത് അനുയോജ്യമല്ലോ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}