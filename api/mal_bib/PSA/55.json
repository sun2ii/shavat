{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":55,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു ധ്യാനസങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"ദൈവമേ, എന്റെ പ്രാർഥന ശ്രദ്ധിക്കണമേ,","poem":1},{"text":"എന്റെ യാചന അവഗണിക്കരുതേ;","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"എന്നെ ശ്രദ്ധിച്ച് എനിക്കുത്തരമരുളണമേ.","poem":2},{"text":"എന്റെ ശത്രുവിന്റെ അട്ടഹാസം നിമിത്തവും","poem":1},{"text":"ദുഷ്ടരുടെ ഭീഷണിപ്പെടുത്തൽ നിമിത്തവും;","poem":2},{"lineBreak":true},{"text":"എന്റെ വിചാരങ്ങളിൽ ഞാൻ വിഷണ്ണനാകുന്നു","poem":2},{"text":"അവർ എന്റെമേൽ കഷ്ടത വരുത്തിയിരിക്കുന്നു","poem":1},{"text":"അവരുടെ കോപത്താൽ എന്നെ വേട്ടയാടുകയും ചെയ്തിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"എന്റെ ഹൃദയം എന്റെയുള്ളിൽ തീവ്രവേദനയിലായിരിക്കുന്നു;","poem":1},{"text":"മരണഭീതി എന്നെ പിടികൂടിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ഭീതിയും വിറയലും എന്നെ വളഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"ബീഭത്സത എന്നെ മൂടിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഞാൻ പറഞ്ഞു: “ഹാ, പ്രാവിനെപ്പോലെ എനിക്കു ചിറകുകൾ ഉണ്ടായിരുന്നെങ്കിൽ!","poem":1},{"text":"ഞാൻ ദൂരെ പറന്നുപോയി വിശ്രമിക്കുമായിരുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ഞാൻ വിദൂരസ്ഥലത്തേക്ക് ഓടിപ്പോയി","poem":1},{"text":"മരുഭൂമിയിൽ പാർക്കുമായിരുന്നു; സേലാ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"കൊടുങ്കാറ്റിൽനിന്നും ചുഴലിക്കാറ്റിൽനിന്നും അകന്ന്","poem":1},{"text":"ഞാൻ എന്റെ സങ്കേതത്തിലേക്ക് അതിവേഗം പാഞ്ഞടുക്കുമായിരുന്നു.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"കർത്താവേ, ദുഷ്ടരെ സംഭ്രാന്തിയിലാഴ്ത്തണമേ, അവരുടെ വാദഗതിയെ താറുമാറാക്കണമേ,","poem":1},{"text":"കാരണം നഗരത്തിൽ അതിക്രമവും കലഹവും പിടിപെട്ടതായി ഞാൻ കാണുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"രാവും പകലും അക്രമികൾ അതിന്റെ മതിലുകൾക്കുള്ളിൽ ചുറ്റിസഞ്ചരിക്കുന്നു;","poem":1},{"text":"ദുഷ്ടതയും അവഹേളനവും അതിനുള്ളിലുണ്ട്.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"നാശശക്തികൾ നഗരത്തിൽ പ്രവർത്തനനിരതരായിരിക്കുന്നു;","poem":1},{"text":"ഭീഷണിയും വ്യാജവും നഗരവീഥികളിൽ നിരന്തരം അഴിഞ്ഞാടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"എന്നെ അധിക്ഷേപിക്കുന്നത് ഒരു ശത്രുവാണെങ്കിൽ","poem":1},{"text":"അതു ഞാൻ സഹിക്കുമായിരുന്നു;","poem":2},{"text":"ഒരു വൈരി എനിക്കെതിരേ ഉയർന്നുവരുന്നെങ്കിൽ","poem":1},{"text":"എനിക്കോടിമറയാൻ കഴിയുമായിരുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"എന്നാൽ എന്റെ സഹചാരിയും എന്റെ ഉറ്റ സുഹൃത്തും","poem":1},{"text":"എന്നോടു സമനായ മനുഷ്യനുമായ നീയാണല്ലോ അതു ചെയ്തത്,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ഒരിക്കൽ ദൈവാലയത്തിൽവെച്ച്","poem":1},{"text":"നിന്നോടൊപ്പം ഹൃദ്യസമ്പർക്കം ആസ്വദിച്ചിരുന്നു,","poem":2},{"text":"അവിടെ ജനസമൂഹത്തോടൊപ്പം","poem":1},{"text":"നാം ഒരുമിച്ച് നടന്നുപോയപ്പോൾത്തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"എന്റെ ശത്രുക്കളുടെമേൽ മരണം പതുങ്ങിനടക്കട്ടെ;","poem":1},{"text":"അവർ ജീവനോടെതന്നെ പാതാളത്തിലേക്കു നിപതിക്കട്ടെ,","poem":2},{"lineBreak":true},{"text":"കാരണം തിന്മ അവരുടെയിടയിൽ കുടികൊള്ളുന്നുണ്ടല്ലോ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"എന്നാൽ ഞാൻ ദൈവത്തെ വിളിച്ചപേക്ഷിക്കുന്നു,","poem":1},{"text":"യഹോവ എന്നെ രക്ഷിക്കുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"വൈകുന്നേരത്തും രാവിലെയും ഉച്ചയ്ക്കും","poem":1},{"text":"ഞാൻ ആകുലതയാൽ വിലപിക്കുകയും","poem":2},{"lineBreak":true},{"text":"അവിടന്നെന്റെ ശബ്ദം കേൾക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"പലരും എന്നെ എതിർക്കുന്നെങ്കിലും","poem":1},{"text":"എനിക്കെതിരായി വരുന്ന ആക്രമണങ്ങളിൽനിന്ന്","poem":2},{"lineBreak":true},{"text":"അവിടന്ന് എന്നെ അപായപ്പെടുത്താതെ മോചിപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അനാദികാലംമുതലേ സിംഹാസനസ്ഥനായിരിക്കുന്ന","poem":1},{"text":"മാറ്റമില്ലാത്ത ദൈവം,","poem":2},{"text":"എന്റെ ശത്രുക്കളുടെ ആരവാരംകേട്ട് അവരെ ലജ്ജിതരാക്കും","poem":1},{"text":"കാരണം അവർക്കു ദൈവഭയമില്ല. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"എന്റെ സ്നേഹിതർ തങ്ങളുടെ സുഹൃത്തുക്കളെ ആക്രമിക്കുന്നു;","poem":1},{"text":"അവർ തങ്ങളുടെ ഉടമ്പടി ലംഘിക്കുന്നു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവരുടെ ഭാഷണം വെണ്ണപോലെ മാർദവമുള്ളത്,","poem":1},{"text":"എന്നിരുന്നാലും അവരുടെ ഹൃദയത്തിൽ യുദ്ധമാണുള്ളത്;","poem":2},{"text":"അവരുടെ വാക്കുകൾ എണ്ണയെക്കാൾ മയമുള്ളത്,","poem":1},{"text":"എന്നിട്ടും അവർ ഊരിയ വാളുകൾതന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"നിന്റെ ഭാരം യഹോവയുടെമേൽ സമർപ്പിക്കുക","poem":1},{"text":"അവിടന്നു നിന്നെ പുലർത്തും;","poem":2},{"text":"നീതിനിഷ്ഠർ നിപതിക്കാൻ","poem":1},{"text":"അവിടന്ന് ഒരിക്കലും അനുവദിക്കുകയില്ല.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"എന്നാൽ ദൈവമേ, അവിടന്ന് ദുഷ്ടരെ","poem":1},{"text":"നാശത്തിന്റെ കുഴിയിലേക്കു തള്ളിയിടും;","poem":2},{"text":"രക്തദാഹികളും വഞ്ചകരും","poem":1},{"text":"അവരുടെ ആയുസ്സിന്റെ പകുതിപോലും കാണുകയില്ല.","poem":2},{"lineBreak":true},{"text":"എന്നാൽ ഞാൻ അങ്ങയിൽ ആശ്രയിക്കും.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":22}