{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":59,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സ്വർണഗീതം. അദ്ദേഹത്തെ വധിക്കേണ്ടതിന് ശൗൽ അയച്ച ചാരന്മാർ വീട് നിരീക്ഷിച്ചിരുന്നകാലത്തു ചമച്ചത്."]},{"type":"verse","number":1,"content":[{"text":"ദൈവമേ, എന്റെ ശത്രുക്കളിൽനിന്ന് എന്നെ വിടുവിക്കണമേ;","poem":1},{"text":"എന്നെ ആക്രമിക്കുന്നവരിൽനിന്ന് എന്നെ സംരക്ഷിക്കണമേ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അധർമികളിൽനിന്ന് എന്നെ വിടുവിക്കണമേ","poem":1},{"text":"രക്തദാഹികളായ ഈ മനുഷ്യരിൽനിന്ന് എന്നെ രക്ഷിക്കണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ഇതാ, അവർ എപ്രകാരമാണ് എനിക്കായി പതിയിരിക്കുന്നത് എന്നു നോക്കിയാലും!","poem":1},{"text":"നിഷ്ഠുരമനുഷ്യർ എനിക്കെതിരേ തന്ത്രങ്ങൾ മെനയുന്നു","poem":2},{"lineBreak":true},{"text":"യഹോവേ, എന്നിൽ ഒരു കുറ്റവും പാപവും ഇല്ലാതിരിക്കെത്തന്നെ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ഞാൻ ഒരുതെറ്റും ചെയ്തിട്ടില്ല, എന്നിട്ടും എന്നെ ആക്രമിക്കാൻ അവർ തയ്യാറായിരിക്കുന്നു.","poem":1},{"text":"എന്നെ സഹായിക്കാൻ എഴുന്നേൽക്കണമേ; എന്റെ അപകടനില ദർശിക്കണമേ!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"സൈന്യങ്ങളുടെ ദൈവമായ യഹോവേ,","poem":1},{"text":"ഇസ്രായേലിന്റെ ദൈവമേ,","poem":2},{"text":"സകലരാഷ്ട്രങ്ങളെയും ശിക്ഷിക്കേണ്ടതിന് അവിടന്ന് ഉണർന്നെഴുന്നേൽക്കണമേ;","poem":1},{"text":"ദുഷ്ടരായ രാജ്യദ്രോഹികളോട് യാതൊരു കരുണയും കാണിക്കരുതേ. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"സന്ധ്യക്ക് അവർ മടങ്ങിവരുന്നു,","poem":1},{"text":"നായ്ക്കളെപ്പോലെ മുരണ്ടുകൊണ്ടവർ","poem":2},{"lineBreak":true},{"text":"നഗരത്തിനുചുറ്റും ഇരതേടി ചുറ്റിത്തിരിയുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവരുടെ വായിൽനിന്നു പുറന്തള്ളുന്നത് എന്തെന്ന് ശ്രദ്ധിക്കണമേ—","poem":1},{"text":"അവരുടെ അധരങ്ങളിൽനിന്നുള്ള വാക്കുകൾ വാളുകൾപോലെ മൂർച്ചയുള്ളതാണ്,","poem":2},{"lineBreak":true},{"text":"“ആരുണ്ട് കേൾക്കാൻ?” എന്ന് അവർ ചിന്തിക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"എന്നാൽ യഹോവേ, അങ്ങ് അവരെ നോക്കി ചിരിക്കുന്നു;","poem":1},{"text":"ആ രാഷ്ട്രങ്ങളെയെല്ലാം അവിടന്ന് പരിഹസിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"അവിടന്നാണ് എന്റെ ശക്തി, ഞാൻ അങ്ങേക്കായി കാത്തിരിക്കുന്നു;","poem":1},{"text":"ദൈവമേ, അവിടന്നാണെന്റെ അഭയസ്ഥാനം,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"എന്റെ ദൈവം അവിടത്തെ അചഞ്ചലസ്നേഹത്താൽ എനിക്കൊപ്പം നിൽക്കും.","poem":2},{"lineBreak":true},{"text":"എനിക്കെതിരേ അപവാദം പറയുന്നവരുടെമേലുള്ള വിജയംകണ്ടു സന്തോഷിക്കാൻ","poem":1},{"text":"അവിടന്ന് എന്നെ അനുവദിക്കും.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ഞങ്ങളുടെ പരിചയായ","poem":1},{"noteId":54},{"text":"കർത്താവേ, അവരെ കൊന്നുകളയരുതേ,","poem":1},{"text":"അങ്ങനെയായാൽ എന്റെ ജനം അതു വിസ്മരിക്കുമല്ലോ.","poem":2},{"text":"അവിടത്തെ ശക്തിയാൽ അവരെ","poem":1},{"text":"വേരോടെ പിഴുതെടുത്ത് പരാജയപ്പെടുത്തണമേ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവർ അവരുടെ അഹങ്കാരത്തിൽ പിടിക്കപ്പെടട്ടെ;","poem":1},{"text":"അവരുടെ വായിലെ പാപങ്ങളാലും","poem":2},{"lineBreak":true},{"text":"അവരുടെ അധരങ്ങളിലെ വാക്കുകളാലുംതന്നെ.","poem":2},{"text":"അവർ ഉരുവിടുന്ന ശാപവാക്കുകൾനിമിത്തവും കാപട്യംനിറഞ്ഞ വാക്കുകൾനിമിത്തവും,","poem":1}]},{"type":"verse","number":13,"content":[{"text":"അവിടത്തെ ക്രോധാഗ്നിയിൽ അവരെ ഭസ്മീകരിക്കണമേ","poem":2},{"lineBreak":true},{"text":"അവർ നിശ്ശൂന്യമാകുംവരെ അവരെ ദഹിപ്പിക്കണമേ.","poem":2},{"text":"അപ്പോൾ ദൈവമാണ് ഇസ്രായേലിൽ","poem":1},{"noteId":55},{"text":"വാഴുന്നതെന്ന്","poem":1},{"text":"അഖിലാണ്ഡത്തിന്റെ അതിർത്തികളിലെല്ലാം അറിയപ്പെടും. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"സന്ധ്യക്ക് അവർ മടങ്ങിവരുന്നു,","poem":1},{"text":"നായ്ക്കളെപ്പോലെ മുരണ്ടുകൊണ്ടവർ","poem":2},{"lineBreak":true},{"text":"നഗരത്തിനുചുറ്റും ഇരതേടി ചുറ്റിത്തിരിയുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഭക്ഷണത്തിനായവർ അലഞ്ഞുനടക്കുന്നു","poem":1},{"text":"തൃപ്തിയായില്ലെങ്കിൽ ഓരിയിടുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"എന്നാൽ ഞാൻ അവിടത്തെ ബലത്തെപ്പറ്റി ഗാനമാലപിക്കും,","poem":1},{"text":"പ്രഭാതത്തിൽ അവിടത്തെ അചഞ്ചലസ്നേഹത്തെപ്പറ്റി പാടും;","poem":2},{"text":"കാരണം അവിടന്നാണെന്റെ അഭയസ്ഥാനം,","poem":1},{"text":"കഷ്ടകാലത്ത് എന്റെ സങ്കേതവും അവിടന്ന് ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"എനിക്ക് ആശ്രയയോഗ്യനായ എന്റെ ദൈവമേ,","poem":1},{"text":"അവിടന്നാണ് എന്റെ ശക്തി, ഞാൻ അങ്ങയെ വാഴ്ത്തിപ്പാടും;","poem":2},{"lineBreak":true},{"text":"ദൈവമേ, അവിടന്നാണെന്റെ അഭയസ്ഥാനം.","poem":2}]}],"footnotes":[{"noteId":54,"caller":"+","text":"അഥവാ, കർത്താവ്","reference":{"chapter":59,"verse":11}},{"noteId":55,"caller":"+","text":"മൂ.ഭാ. യാക്കോബിൽ","reference":{"chapter":59,"verse":13}}]},"thisChapterLink":"/api/mal_bib/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}