{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":62,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"ഞാൻ ദൈവത്തിൽമാത്രം വിശ്രമം കണ്ടെത്തുന്നു;","poem":1},{"text":"എന്റെ രക്ഷ അങ്ങയിൽനിന്ന് വരുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവിടന്നുമാത്രമാണ് എന്റെ പാറയും രക്ഷയും;","poem":1},{"text":"അവിടന്നാണ് എന്റെ കോട്ട, ഞാൻ ഒരിക്കലും കുലുങ്ങിപ്പോകുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ഒരു മനുഷ്യനെ നിങ്ങൾ എത്രകാലം ആക്രമിക്കും?","poem":1},{"text":"ചാഞ്ഞ മതിലും പൊളിഞ്ഞ വേലിയുംപോലെ","poem":2},{"lineBreak":true},{"text":"നിങ്ങളെല്ലാവരും എന്നെ നിലത്തെറിഞ്ഞുകളയുമോ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ഉന്നതസ്ഥാനത്തുനിന്ന്","poem":1},{"text":"എന്നെ തള്ളിയിടുകയാണ് അവരുടെ ലക്ഷ്യം,","poem":2},{"lineBreak":true},{"text":"അവർ വ്യാജം സംസാരിക്കുന്നതിൽ ആമോദിക്കുന്നു.","poem":2},{"text":"അധരംകൊണ്ട് അവർ അനുഗ്രഹിക്കുന്നു,","poem":1},{"text":"എന്നാൽ അന്തരംഗത്തിൽ അവർ ശാപംചൊരിയുന്നു. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"എന്റെ ആത്മാവേ, ദൈവത്തിൽമാത്രം വിശ്രമം കണ്ടെത്തുക;","poem":1},{"text":"അങ്ങയിലാണ് എന്റെ പ്രത്യാശ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവിടന്നുമാത്രമാണ് എന്റെ പാറയും എന്റെ രക്ഷയും;","poem":1},{"text":"അവിടന്നാണ് എന്റെ കോട്ട, ഞാൻ കുലുങ്ങിപ്പോകുകയില്ല.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"എന്റെ രക്ഷയും എന്റെ മഹത്ത്വവും ദൈവത്തിൽ ആകുന്നു;","poem":1},{"noteId":59},{"text":"അവിടന്ന് എന്റെ ശക്തിയുള്ള പാറയും എന്റെ സങ്കേതവും ആകുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അല്ലയോ ജനമേ, എപ്പോഴും ദൈവത്തിൽ ആശ്രയിക്കുക,","poem":1},{"text":"നിങ്ങളുടെ ഹൃദയം അവിടത്തെ മുമ്പിൽ പകരുക,","poem":2},{"lineBreak":true},{"text":"കാരണം നമ്മുടെ സങ്കേതം ദൈവം ആകുന്നു. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ഹീനകുലജന്മം കേവലമൊരു ശ്വാസവും","poem":1},{"text":"ഉന്നതകുലജന്മം കേവലമൊരു മിഥ്യയും ആകുന്നു.","poem":2},{"text":"ഒരു തുലാസിൽ തൂക്കിയാൽ അവരുടെ തട്ട് പൊന്തിപ്പോകും;","poem":1},{"text":"അവരിരുവരും ഒരു ശ്വാസത്തെക്കാൾ ലഘുവാണ്.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"കൊള്ളപ്പണത്തിൽ ആശ്രയിക്കുകയോ","poem":1},{"text":"മോഷണമുതലിന്മേൽ അഹങ്കരിക്കുകയോ അരുത്;","poem":2},{"text":"നിന്റെ ധനം അധികരിച്ചാലും,","poem":1},{"text":"നിന്റെ ഹൃദയം അതിൽ അർപ്പിക്കരുത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ദൈവം ഒരു കാര്യം അരുളിച്ചെയ്തു,","poem":1},{"text":"രണ്ടുതവണ അടിയനത് ശ്രവിച്ചിരിക്കുന്നു:","poem":2},{"text":"“ദൈവമേ, ശക്തി അങ്ങേക്കുള്ളതാകുന്നു,","poem":1}]},{"type":"verse","number":12,"content":[{"text":"അചഞ്ചലസ്നേഹവും അങ്ങയിലാണല്ലോ കർത്താവേ;","poem":2},{"text":"അങ്ങ് ഓരോരുത്തർക്കും പ്രതിഫലംനൽകും","poem":1},{"text":"അവരവരുടെ പ്രവൃത്തിക്കനുസൃതമായിട്ടുതന്നെ.”","poem":2}]}],"footnotes":[{"noteId":59,"caller":"+","text":"അഥവാ, എന്റെ രക്ഷയും എന്റെ മഹത്ത്വവും അത്യുന്നതനായ ദൈവം ആകുന്നു.","reference":{"chapter":62,"verse":7}}]},"thisChapterLink":"/api/mal_bib/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}