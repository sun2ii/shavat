{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":64,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"എന്റെ ദൈവമേ, എന്റെ ആവലാതി ശ്രദ്ധിക്കണമേ;","poem":1},{"text":"ശത്രുവിന്റെ ഭീഷണിയിൽനിന്നും എന്റെ ജീവനെ കാത്തുകൊള്ളണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ദുഷ്ടരുടെ ഗൂഢതന്ത്രങ്ങളിൽനിന്നും","poem":1},{"text":"അധർമികളുടെ ആരവാരങ്ങളിൽനിന്നും എന്നെ മറച്ചുകൊള്ളണമേ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവർ അവരുടെ നാവ് വാൾപോലെ മൂർച്ചയുള്ളതാക്കുന്നു","poem":1},{"text":"മാരകാസ്ത്രങ്ങൾപോലെ തങ്ങളുടെ വാക്കുകൾ തൊടുക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"നിരപരാധിക്കുനേരേ അവർ ഒളിഞ്ഞുനിന്ന് അസ്ത്രം തൊടുക്കുന്നു;","poem":1},{"text":"ഭയംകൂടാതെ അതിവേഗം അവരെ ആക്രമിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"അധർമം പ്രവർത്തിക്കുന്നതിൽ അവർ പരസ്പരം പ്രോത്സാഹിപ്പിക്കുന്നു,","poem":1},{"text":"അവരുടെ കെണികൾ ഒളിപ്പിക്കുന്നതിനെപ്പറ്റിയവർ സംസാരിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"“ആരതു","poem":2},{"noteId":61},{"text":"കണ്ടുപിടിക്കും?” എന്ന് അവർ വീമ്പിളക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവർ അനീതി ആസൂത്രണംചെയ്തുകൊണ്ട് ഇപ്രകാരം പറയുന്നു:","poem":1},{"text":"“നല്ലൊരുപായം നാം തയ്യാറാക്കിയിരിക്കുന്നു!”","poem":2},{"lineBreak":true},{"text":"മാനവമനസ്സും ഹൃദയവും കുൽസിതംതന്നെ, നിശ്ചയം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"എന്നാൽ ദൈവം തന്റെ അസ്ത്രങ്ങൾകൊണ്ട് അവരെ എയ്തുവീഴ്ത്തും;","poem":1},{"text":"അതിവേഗത്തിലവർ നിലംപൊത്തും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവിടന്ന് അവരുടെ സ്വന്തം നാവുതന്നെ അവർക്കെതിരേ തിരിക്കും,","poem":1},{"text":"അങ്ങനെ അവർ നശിച്ചുപോകും;","poem":2},{"lineBreak":true},{"text":"അവരെ കാണുന്നവരെല്ലാം നിന്ദാസൂചകമായി തലകുലുക്കും.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"സകലമനുഷ്യരും ഭയപ്പെട്ട്;","poem":1},{"text":"ദൈവത്തിന്റെ പ്രവൃത്തികൾ പ്രസ്താവിക്കുകയും","poem":2},{"lineBreak":true},{"text":"അവിടന്നു ചെയ്തതിനെക്കുറിച്ച് ആലോചനാനിമഗ്നരാകുകയും ചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"നീതിനിഷ്ഠർ യഹോവയിൽ ആനന്ദിക്കുകയും","poem":1},{"text":"അവർ അവിടത്തെ അഭയംപ്രാപിക്കുകയും ചെയ്യട്ടെ;","poem":2},{"lineBreak":true},{"text":"ഹൃദയപരമാർഥതയുള്ള എല്ലാവരും അവിടത്തെ പുകഴ്ത്തട്ടെ!","poem":2}]}],"footnotes":[{"noteId":61,"caller":"+","text":"അഥവാ, ഞങ്ങളെ","reference":{"chapter":64,"verse":5}}]},"thisChapterLink":"/api/mal_bib/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}