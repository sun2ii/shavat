{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":65,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം; ഒരു ഗീതം."]},{"type":"verse","number":1,"content":[{"text":"ദൈവമേ, സീയോനിൽ സ്തുതി അങ്ങേക്ക് യോഗ്യം;","poem":1},{"noteId":62},{"text":"അങ്ങേക്കുതന്നെ ഞങ്ങൾ നേർച്ചയർപ്പിക്കും.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"പ്രാർഥനയ്ക്ക് ഉത്തരമരുളുന്ന ദൈവമേ,","poem":1},{"text":"സകലജനവും അങ്ങയുടെ അടുക്കലേക്കു വരും","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ഞങ്ങളുടെ പാപങ്ങൾ ഞങ്ങളെ മൂടിക്കളഞ്ഞെങ്കിലും","poem":1},{"text":"അവിടന്ന് ഞങ്ങളുടെ അതിക്രമങ്ങൾ ക്ഷമിച്ചിരിക്കുന്നു.","poem":2},{"noteId":63}]},{"type":"verse","number":4,"content":[{"text":"അങ്ങയുടെ വിശുദ്ധമന്ദിരാങ്കണത്തിൽ വസിക്കേണ്ടതിന്","poem":1},{"text":"അങ്ങ് തെരഞ്ഞെടുത്ത് അടുപ്പിക്കുന്ന മനുഷ്യർ അനുഗൃഹീതർ.","poem":2},{"text":"അവിടത്തെ നിവാസസ്ഥാനമായ വിശുദ്ധമന്ദിരത്തിലെ","poem":1},{"text":"നന്മകളാൽ ഞങ്ങൾ സംതൃപ്തരാകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ഭൂമിയിലെ സകലസീമകൾക്കും","poem":1},{"text":"വിദൂര സമുദ്രങ്ങൾക്കും","poem":2},{"text":"പ്രത്യാശയായിരിക്കുന്ന ഞങ്ങളുടെ രക്ഷകനായ ദൈവമേ,","poem":1},{"text":"അങ്ങ് അത്ഭുതകരമായ നീതിപ്രവൃത്തികളാൽ ഞങ്ങൾക്ക് ഉത്തരമരുളുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവിടന്ന് ബലം അരയ്ക്കുകെട്ടിക്കൊണ്ട്","poem":1},{"text":"അവിടത്തെ ശക്തിയാൽ പർവതങ്ങളെ ഉറപ്പിച്ചു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവിടന്ന് സമുദ്രങ്ങളുടെ ഗർജനവും","poem":1},{"text":"തിരമാലകളുടെ അലർച്ചയും","poem":2},{"lineBreak":true},{"text":"രാഷ്ട്രങ്ങളുടെ കലഹവും ശമിപ്പിച്ചു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ഭൂമിയിലെല്ലായിടത്തും പാർക്കുന്ന ജനം അവിടത്തെ അത്ഭുതങ്ങൾനിമിത്തം വിസ്മയപ്പെടുന്നു;","poem":1},{"text":"ഉദയത്തിന്റെയും അസ്തമയത്തിന്റെയും ദിക്കുകളിൽനിന്ന്","poem":2},{"lineBreak":true},{"text":"അവിടന്ന് ആനന്ദഗീതം ആലപിക്കുമാറാക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"അവിടന്ന് ഭൂമിയെ സന്ദർശിക്കുകയും അത് നനയ്ക്കുകയും ചെയ്യുന്നു;","poem":1},{"text":"അവിടന്ന് അതിനെ അത്യന്തം ഫലപുഷ്ടമാക്കുന്നു.","poem":2},{"text":"ദൈവത്തിന്റെ നദിയിൽ വെള്ളം നിറഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"ഇങ്ങനെ അങ്ങ് ഭൂമിയെ ഒരുക്കി","poem":2},{"lineBreak":true},{"text":"അവർക്കു ധാന്യംനൽകുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അങ്ങ് അതിന്റെ ഉഴവുചാലുകളെ നനയ്ക്കുന്നു;","poem":1},{"text":"മഴയാൽ അങ്ങ് അതിനെ കുതിർക്കുകയും അതിന്റെ മുളയെ അനുഗ്രഹിക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അങ്ങ് സംവത്സരത്തെ നന്മകൊണ്ട് കിരീടമണിയിക്കുന്നു,","poem":1},{"text":"അവിടത്തെ പാതകൾ പുഷ്ടിപൊഴിക്കുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"മരുഭൂമിയിലെ പുൽമേടുകൾ സമൃദ്ധിപൊഴിക്കുന്നു","poem":1},{"text":"കുന്നുകൾ ആനന്ദം അണിഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"പുൽപ്പുറങ്ങളിൽ ആട്ടിൻപറ്റം നിറഞ്ഞിരിക്കുന്നു","poem":1},{"text":"താഴ്വരകൾ ധാന്യംകൊണ്ട് മൂടിയിരിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"അവർ ആനന്ദത്താൽ ആർക്കുകയും പാടുകയുംചെയ്യുന്നു.","poem":2}]}],"footnotes":[{"noteId":62,"caller":"+","text":"ഈ വാക്കിനുള്ള എബ്രായപദത്തിന്റെ അർഥം വ്യക്തമല്ല.","reference":{"chapter":65,"verse":1}},{"noteId":63,"caller":"+","text":"അഥവാ, പ്രായശ്ചിത്തം കഴിച്ചു","reference":{"chapter":65,"verse":3}}]},"thisChapterLink":"/api/mal_bib/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}