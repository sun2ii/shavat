{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":66,"content":[{"type":"hebrew_subtitle","content":["ഒരു ഗീതം; ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"സർവഭൂമിയുമേ, ദൈവത്തിന് ആനന്ദത്തോടെ ആർപ്പിടുക!","poem":1}]},{"type":"verse","number":2,"content":[{"text":"അവിടത്തെ നാമത്തിന്റെ മഹത്ത്വം ആലപിക്കുക;","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ സ്തുതി തേജസ്സേറിയതാക്കുക.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ദൈവത്തോടു പറയുക: “അവിടത്തെ പ്രവൃത്തികൾ എത്ര ഭീതിജനകം!","poem":1},{"text":"അവിടത്തെ ശക്തി അതിമഹത്തായതാണ്","poem":2},{"lineBreak":true},{"text":"അതുകൊണ്ട് അങ്ങയുടെ ശത്രുക്കൾ അങ്ങയുടെ കാൽക്കൽവീഴുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"സർവഭൂമിയും തിരുമുമ്പിൽ താണുവണങ്ങുന്നു;","poem":1},{"text":"അവർ അവിടത്തേക്ക് സ്തുതിപാടുന്നു,","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ നാമത്തിന് സ്തുതിഗീതം ആലപിക്കുന്നു.” സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ദൈവത്തിന്റെ പ്രവൃത്തികളെ വന്നു കാണുക,","poem":1},{"text":"മനുഷ്യപുത്രന്മാർക്കുവേണ്ടി അവിടന്ന് വിസ്മയാവഹമായ കാര്യങ്ങൾ ചെയ്യുന്നു!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവിടന്ന് സമുദ്രത്തെ ഉണങ്ങിയ നിലമാക്കി,","poem":1},{"text":"അവർ നദിയുടെ അടിത്തട്ടിലൂടെ കാൽനടയായി പോയി—","poem":2},{"lineBreak":true},{"text":"വരിക, നമുക്ക് ദൈവത്തിൽ ആനന്ദിക്കാം.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവിടന്ന് തന്റെ ശക്തിയാൽ എന്നേക്കും വാഴുന്നു,","poem":1},{"text":"അവിടത്തെ കണ്ണുകൾ രാഷ്ട്രങ്ങളെ വീക്ഷിക്കുന്നു—","poem":2},{"lineBreak":true},{"text":"മത്സരിക്കുന്നവർ അവിടത്തേക്കെതിരേ തങ്ങളെത്തന്നെ ഉയർത്താതിരിക്കട്ടെ. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"സകലജനതകളുമേ, നമ്മുടെ ദൈവത്തെ വാഴ്ത്തുക,","poem":1},{"text":"അവിടത്തേക്കുള്ള സ്തുതിനാദമെങ്ങും മുഴങ്ങട്ടെ;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവിടന്ന് നമ്മുടെ ജീവനെ സംരക്ഷിച്ചു","poem":1},{"text":"നമ്മുടെ കാലടികൾ വഴുതാൻ സമ്മതിച്ചതുമില്ല.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ദൈവമേ, അവിടന്ന് ഞങ്ങളെ പരിശോധിച്ചിരിക്കുന്നു;","poem":1},{"text":"വെള്ളി ഊതിക്കഴിക്കുന്നതുപോലെ അങ്ങു ഞങ്ങളെ സ്‌ഫുടംചെയ്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അവിടന്ന് ഞങ്ങളെ തടവിലാക്കുകയും","poem":1},{"text":"ഞങ്ങളുടെ മുതുകിൽ വലിയ ഭാരം ചുമത്തുകയും ചെയ്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവിടന്ന് മനുഷ്യരെ ഞങ്ങളുടെ തലയ്ക്കുമീതേ ഓടുമാറാക്കി;","poem":1},{"text":"ഞങ്ങൾ തീയിലും വെള്ളത്തിലുംകൂടി കടന്നുപോയി,","poem":2},{"lineBreak":true},{"text":"എങ്കിലും അങ്ങ് ഞങ്ങളെ സമൃദ്ധമായ ഒരു സ്ഥലത്തേക്ക് കൊണ്ടുവന്നിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ഹോമയാഗങ്ങളുമായി ഞാൻ അവിടത്തെ മന്ദിരത്തിൽ പ്രവേശിച്ച്,","poem":1},{"text":"അങ്ങയോടുള്ള എന്റെ നേർച്ചകൾ നിറവേറ്റും—","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ഞാൻ ദുരിതത്തിലായിരുന്നപ്പോൾ","poem":1},{"text":"എന്റെ അധരങ്ങൾ ഉച്ചരിച്ചതും എന്റെ വായ് സംസാരിച്ചതുമായ നേർച്ചകൾതന്നെ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഞാൻ അങ്ങേക്ക് തടിച്ചുകൊഴുത്ത മൃഗങ്ങൾ ഹോമയാഗമായി അർപ്പിക്കും","poem":1},{"text":"ഹൃദ്യസുഗന്ധമായി ആട്ടുകൊറ്റനെയും;","poem":2},{"lineBreak":true},{"text":"ഞാൻ കാളകളെയും ആടുകളെയും അർപ്പിക്കും. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ദൈവത്തെ ഭയപ്പെടുന്ന സകലരുമേ, വന്നു കേൾക്കുക;","poem":1},{"text":"അവിടന്ന് എനിക്കുവേണ്ടി ചെയ്തത് ഞാൻ നിങ്ങളെ അറിയിക്കാം.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ഞാൻ എന്റെ വാകൊണ്ട് അവിടത്തോട് നിലവിളിച്ചു;","poem":1},{"text":"അവിടത്തെ സ്തുതി എന്റെ നാവിന്മേൽ ഉണ്ടായിരുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ഞാൻ എന്റെ ഹൃദയത്തിൽ പാപം പരിപോഷിപ്പിച്ചിരുന്നെങ്കിൽ,","poem":1},{"text":"കർത്താവ് ശ്രദ്ധിക്കുകയില്ലായിരുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"എന്നാൽ ദൈവം ശ്രദ്ധിച്ചിരിക്കുന്നു, നിശ്ചയം","poem":1},{"text":"എന്റെ പ്രാർഥന കേട്ടുമിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"എന്റെ പ്രാർഥന നിരസിക്കാതെയും","poem":1},{"text":"അവിടത്തെ സ്നേഹം തടഞ്ഞുവെക്കാതെയുമിരുന്ന","poem":2},{"lineBreak":true},{"text":"ദൈവം വാഴ്ത്തപ്പെടുമാറാകട്ടെ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}