{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":68,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം; ഒരു ഗീതം."]},{"type":"verse","number":1,"content":[{"text":"ദൈവമേ, എഴുന്നേൽക്കണമേ, അങ്ങയുടെ ശത്രുക്കൾ ചിതറിപ്പോകട്ടെ;","poem":1},{"text":"അവിടത്തെ എതിരാളികൾ അങ്ങയുടെമുമ്പിൽനിന്ന് പലായനംചെയ്യട്ടെ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"പുക പാറുംപോലെ അങ്ങ് അവരെ പാറിക്കണമേ—","poem":1},{"text":"അഗ്നിയിൽ മെഴുക് ഉരുകുന്നതുപോലെ","poem":2},{"lineBreak":true},{"text":"ദൈവത്തിന്റെ മുമ്പിൽ ദുഷ്ടർ നശിച്ചുപോകട്ടെ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"എന്നാൽ നീതിനിഷ്ഠർ ആഹ്ലാദിക്കുകയും","poem":1},{"text":"ദൈവമുമ്പാകെ ഉല്ലസിക്കുകയും ചെയ്യട്ടെ;","poem":2},{"lineBreak":true},{"text":"അവർ സന്തുഷ്ടരും ആനന്ദഭരിതരുമാകട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ദൈവത്തിനു പാടുക, തിരുനാമത്തിന് സ്തുതിപാടുക,","poem":1},{"text":"മേഘപാളികളിൽ","poem":2},{"noteId":64},{"text":"യാത്രചെയ്യുന്നവനെ പുകഴ്ത്തുക;","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ സന്നിധിയിൽ ആനന്ദിക്കുക—യഹോവ എന്നാകുന്നു അവിടത്തെ നാമം.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ദൈവം തന്റെ വിശുദ്ധനിവാസത്തിൽ","poem":1},{"text":"അനാഥർക്കു പിതാവും വിധവകൾക്കു പരിപാലകനും ആകുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ദൈവം ആലംബഹീനരെ കുടുംബത്തിൽ","poem":1},{"noteId":65},{"text":"വസിക്കുമാറാക്കുന്നു,","poem":1},{"text":"അവിടന്ന് തടവുകാരെ സമൃദ്ധിയിലേക്ക് ആനയിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"എന്നാൽ മത്സരികൾ വരണ്ടുണങ്ങിയ ദേശത്തു പാർക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ദൈവമേ, അങ്ങയുടെ ജനത്തിന്റെ മുമ്പിൽക്കൂടെ അങ്ങ് കടന്നുപോയപ്പോൾ,","poem":1},{"text":"അവിടന്ന് മരുഭൂമിയിൽക്കൂടി മുന്നേറിയപ്പോൾ, സേലാ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"സീനായിമലയിൽ പ്രത്യക്ഷനായ അദ്വിതീയ ദൈവത്തിന്റെ മുമ്പാകെ","poem":1},{"text":"അതേ, ഇസ്രായേലിന്റെ ദൈവമായ ദൈവത്തിന്റെ മുമ്പാകെ","poem":2},{"lineBreak":true},{"text":"ഭൂമി പ്രകമ്പനംകൊണ്ടു, ആകാശം മഴ ചൊരിഞ്ഞു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ദൈവമേ, അങ്ങ് സമൃദ്ധമായി മഴ പെയ്യിച്ചു;","poem":1},{"text":"വാടിത്തളർന്ന അങ്ങയുടെ അവകാശത്തെ ഉന്മേഷപൂർണമാക്കി.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അതിൽ അങ്ങയുടെ ജനം വാസമുറപ്പിച്ചു,","poem":1},{"text":"ദൈവമേ, അവിടത്തെ സമൃദ്ധിയിൽനിന്ന് അങ്ങ് ദരിദ്രർക്കു വേണ്ടതെല്ലാം നൽകി.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"കർത്താവ് തന്റെ വചനം പ്രഖ്യാപിക്കുന്നു,","poem":1},{"text":"അത് വിളംബരംചെയ്യുന്ന സുവാർത്താദൂതികൾ ഒരു വൻ സമൂഹംതന്നെയുണ്ട്:","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“രാജാക്കന്മാരും സൈനികരും അതിവേഗത്തിൽ പലായനംചെയ്യുന്നു;","poem":1},{"text":"വീട്ടിൽ പാർത്തിരുന്ന സ്ത്രീകൾ കൊള്ള പങ്കിട്ടെടുക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"നിങ്ങൾ ആട്ടിൻതൊഴുത്തുകൾക്കിടയിൽ പാർക്കുമ്പോൾ,","poem":1},{"text":"എന്റെ പ്രാവിന്റെ ചിറകുകൾ വെള്ളികൊണ്ടും","poem":2},{"lineBreak":true},{"text":"തൂവലുകൾ മിന്നുന്ന സ്വർണംകൊണ്ടും പൊതിഞ്ഞിരിക്കുന്നതുപോലെയാകുന്നു.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"സർവശക്തൻ ശത്രുരാജാക്കന്മാരെ ചിതറിച്ചപ്പോൾ","poem":1},{"text":"അതു സൽമോൻ പർവതത്തിൽ മഞ്ഞുപൊഴിയുന്നതുപോലെ ആയിരുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ബാശാൻ പർവതമേ, പ്രൗഢിയുള്ള പർവതമേ,","poem":1},{"text":"ബാശാൻ പർവതമേ, അനേകം കൊടുമുടികളുള്ള പർവതമേ,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ദൈവം വാഴുന്നതിനായി തെരഞ്ഞെടുത്ത പർവതശിഖരത്തെ,","poem":1},{"text":"അതേ, യഹോവ എന്നേക്കും അധിവസിക്കുന്ന","poem":2},{"lineBreak":true},{"text":"പർവതത്തെ, അസൂയാപൂർവം നോക്കുന്നതെന്തേ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ദൈവത്തിന്റെ രഥങ്ങൾ ആയിരമായിരവും","poem":1},{"text":"കോടിക്കോടിയും ആകുന്നു;","poem":2},{"lineBreak":true},{"text":"യഹോവ സീനായിയിൽനിന്ന് അവിടത്തെ വിശുദ്ധമന്ദിരത്തിലേക്ക് എഴുന്നള്ളിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"യഹോവയായ ദൈവമേ, അങ്ങ് എന്നേക്കും വാഴേണ്ടതിനായി","poem":1},{"text":"ആരോഹണംചെയ്തപ്പോൾ,","poem":2},{"text":"അനേകം ബന്ധനസ്ഥരെ ഉയരത്തിലേക്കു കൊണ്ടുപോയി;","poem":1},{"text":"അങ്ങ് മനുഷ്യരിൽനിന്ന്,","poem":2},{"text":"മത്സരികളിൽനിന്നുപോലും","poem":1},{"text":"കാഴ്ചദ്രവ്യങ്ങൾ സ്വീകരിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"അനുദിനം നമ്മുടെ ഭാരങ്ങൾ ചുമക്കുന്ന,","poem":1},{"text":"നമ്മുടെ രക്ഷകനായ ദൈവമായ കർത്താവ് വാഴ്ത്തപ്പെടുമാറാകട്ടെ. സേലാ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"നമ്മുടെ ദൈവം രക്ഷിക്കുന്ന ദൈവം ആകുന്നു;","poem":1},{"text":"മരണത്തിൽനിന്നുള്ള വിടുതൽ കർത്താവായ യഹോവയിൽനിന്നു വരുന്നു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"തന്റെ ശത്രുക്കളുടെ ശിരസ്സ്,","poem":1},{"text":"സ്വന്തം പാപത്തിൽ തുടരുന്നവരുടെ കേശസമൃദ്ധമായ നെറുകതന്നെ, ദൈവം തകർക്കും, നിശ്ചയം.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"കർത്താവ് ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു: “ഞാനവരെ ബാശാനിൽനിന്ന് മടക്കിവരുത്തും;","poem":1},{"text":"ആഴിയുടെ ആഴങ്ങളിൽനിന്നും ഞാനവരെ കൊണ്ടുവരും,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"നിങ്ങൾ നിങ്ങളുടെ എതിരാളികളുടെ രക്തത്തിൽ കാലുകൾ മുക്കിവെക്കേണ്ടതിനും","poem":1},{"text":"നിങ്ങളുടെ നായ്ക്കൾക്ക് അവയുടെ ഓഹരി ലഭിക്കേണ്ടതിനുംതന്നെ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ദൈവമേ, അങ്ങയുടെ എഴുന്നള്ളത്ത് ജനം കണ്ടിരിക്കുന്നു,","poem":1},{"text":"എന്റെ ദൈവവും രാജാവുമായ അങ്ങ് വിശുദ്ധമന്ദിരത്തിലേക്ക് എഴുന്നള്ളുന്നതുതന്നെ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"മുമ്പിൽ ഗായകർ, അവർക്കുപിന്നിൽ വാദ്യക്കാർ;","poem":1},{"text":"അവരോടൊപ്പം തപ്പുകൊട്ടുന്ന കന്യകമാരുമുണ്ട്.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"മഹാസഭയിൽ ദൈവത്തെ സ്തുതിക്കുക;","poem":1},{"text":"ഇസ്രായേലിന്റെ സഭയിൽ യഹോവയെ വാഴ്ത്തുക.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ഇതാ, ചെറിയ ബെന്യാമീൻഗോത്രം അവരെ നയിക്കുന്നു,","poem":1},{"text":"അവിടെ യെഹൂദാപ്രഭുക്കന്മാരുടെ വലിയ കൂട്ടമുണ്ട്,","poem":2},{"lineBreak":true},{"text":"അവരോടൊപ്പം സെബൂലൂന്റെയും നഫ്താലിയുടെയും പ്രഭുക്കന്മാരുമുണ്ട്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ദൈവമേ, അങ്ങയുടെ ശക്തി വിളിച്ചുവരുത്തണമേ;","poem":1},{"text":"ഞങ്ങളുടെ ദൈവമേ, പൂർവകാലങ്ങളിലേതുപോലെ അവിടത്തെ ശക്തി ഞങ്ങൾക്കു വെളിപ്പെടുത്തണമേ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ജെറുശലേമിലെ അങ്ങയുടെ ആലയം നിമിത്തം","poem":1},{"text":"രാജാക്കന്മാർ അങ്ങേക്ക് കാഴ്ചകൾ കൊണ്ടുവരും.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ഞാങ്ങണകൾക്കിടയിലുള്ള മൃഗത്തെ,","poem":1},{"text":"അതേ, രാഷ്ട്രങ്ങളുടെ കാളക്കിടാങ്ങൾക്കൊപ്പമുള്ള കാളക്കൂറ്റന്മാരെ ശാസിക്കണമേ.","poem":2},{"text":"അവർ താഴ്ത്തപ്പെട്ട്, വെള്ളിക്കട്ടികൾ കപ്പമായി കൊണ്ടുവരട്ടെ.","poem":1},{"text":"യുദ്ധത്തിൽ അഭിരമിക്കുന്ന രാഷ്ട്രങ്ങളെ അങ്ങ് ചിതറിക്കണമേ.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ഈജിപ്റ്റിൽനിന്ന് നയതന്ത്രപ്രതിനിധികൾ വന്നുചേരും;","poem":1},{"text":"കൂശ്","poem":2},{"noteId":66},{"text":"ദൈവസന്നിധിയിൽ തന്നെത്താൻ താഴ്ത്തട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"ഭൂമിയിലെ സകലരാജ്യങ്ങളുമേ, ദൈവത്തിനു പാടുക,","poem":1},{"text":"കർത്താവിന് സ്തോത്രഗാനം ആലപിക്കുക, സേലാ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ആകാശോന്നതങ്ങളിൽ, പുരാതനമായ ആകാശങ്ങളിൽ നെടുകെയും കുറുകെയും സഞ്ചരിക്കുന്നവന്,","poem":1},{"text":"തന്റെ അത്യുച്ചനാദത്താൽ മേഘഗർജനം നടത്തുന്നവനുതന്നെ.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ദൈവത്തിന്റെ ശക്തി വിളംബരംചെയ്യുക,","poem":1},{"text":"അവിടത്തെ മഹിമ ഇസ്രായേലിന്മേലും","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ ശക്തി ആകാശങ്ങളിലും വിളങ്ങുന്നു.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ദൈവമേ, അങ്ങയുടെ വിശുദ്ധമന്ദിരത്തിൽ അങ്ങ് വിസ്മയാവഹനാണ്;","poem":1},{"text":"ഇസ്രായേലിന്റെ ദൈവം തന്റെ ജനത്തിന് അധികാരവും ശക്തിയും നൽകുന്നു.","poem":2},{"lineBreak":true},{"text":"ദൈവം വാഴ്ത്തപ്പെടുമാറാകട്ടെ!","poem":1}]}],"footnotes":[{"noteId":64,"caller":"+","text":"അഥവാ, മരുഭൂമിയിൽക്കൂടി","reference":{"chapter":68,"verse":4}},{"noteId":65,"caller":"+","text":"അഥവാ, സ്വദേശത്ത്","reference":{"chapter":68,"verse":6}},{"noteId":66,"caller":"+","text":"ഈ പ്രദേശം, തെക്കുകിഴക്കൻ മെസൊപ്പൊത്താമിയ ആണെന്നു കണക്കാക്കപ്പെടുന്നു.","reference":{"chapter":68,"verse":31}}]},"thisChapterLink":"/api/mal_bib/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":35}