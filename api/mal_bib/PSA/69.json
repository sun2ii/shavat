{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":69,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"ദൈവമേ, എന്നെ രക്ഷിക്കണമേ,","poem":1},{"text":"ജലപ്രവാഹം എന്റെ കഴുത്തോളം എത്തിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"കാലുകൾ ഉറപ്പിക്കാനാകാത്ത","poem":1},{"text":"ആഴമുള്ള ചേറ്റിൽ ഞാൻ മുങ്ങിത്താഴുന്നു.","poem":2},{"text":"ആഴമുള്ള പ്രവാഹത്തിൽ ഞാൻ അകപ്പെട്ടിരിക്കുന്നു;","poem":1},{"text":"ജലപ്രളയം എനിക്കുമീതേ കവിഞ്ഞൊഴുകുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"സഹായത്തിനായി വിളിച്ചപേക്ഷിച്ച് ഞാൻ കുഴഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"എന്റെ തൊണ്ട ഉണങ്ങിവരണ്ടിരിക്കുന്നു.","poem":2},{"text":"എന്റെ ദൈവത്തിനായി കാത്തിരുന്ന്","poem":1},{"text":"എന്റെ കണ്ണുകൾ മങ്ങുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"കാരണംകൂടാതെ എന്നെ വെറുക്കുന്നവർ","poem":1},{"text":"എന്റെ തലമുടിയുടെ എണ്ണത്തെക്കാൾ അധികമാകുന്നു;","poem":2},{"text":"അകാരണമായി എന്നെ നശിപ്പിക്കാൻ ശ്രമിക്കുന്ന","poem":1},{"text":"എന്റെ ശത്രുക്കൾ അനവധിയാകുന്നു.","poem":2},{"text":"ഞാൻ അപഹരിക്കാത്ത വസ്തുവകകൾ","poem":1},{"text":"മടക്കിക്കൊടുക്കാൻ നിർബന്ധിതനായിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ദൈവമേ, എന്റെ ഭോഷത്തം അങ്ങ് അറിയുന്നു;","poem":1},{"text":"എന്റെ പാതകം അങ്ങയുടെമുമ്പാകെ മറവായിരിക്കുന്നതുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"കർത്താവേ, സൈന്യങ്ങളുടെ യഹോവേ,","poem":1},{"text":"അങ്ങയിൽ പ്രതീക്ഷയർപ്പിക്കുന്നവർ","poem":2},{"lineBreak":true},{"text":"ഞാൻമൂലം അപമാനിതരാകരുതേ;","poem":2},{"text":"ഇസ്രായേലിന്റെ ദൈവമേ,","poem":1},{"text":"അങ്ങയെ അന്വേഷിക്കുന്നവർ","poem":2},{"lineBreak":true},{"text":"ഞാൻമൂലം ലജ്ജിതരാകരുതേ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"കാരണം അങ്ങേക്കുവേണ്ടി ഞാൻ നിന്ദ സഹിക്കുന്നു","poem":1},{"text":"എന്റെ മുഖം ലജ്ജകൊണ്ട് മൂടപ്പെടുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"എന്റെ സഹോദരങ്ങൾക്ക് ഞാൻ ഒരു പ്രവാസിയും","poem":1},{"text":"എന്റെ മാതാവിന്റെ മക്കൾക്കൊരു അപരിചിതനും ആകുന്നു;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അങ്ങയുടെ ആലയത്തെപ്പറ്റിയുള്ള തീക്ഷ്ണത എന്നെ ദഹിപ്പിച്ചുകളയുന്നു","poem":1},{"text":"അങ്ങയെ അപമാനിക്കുന്നവരുടെ നിന്ദയും എന്റെമേൽ വീണിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ഞാൻ വിലപിക്കുകയും ഉപവസിക്കുകയും ചെയ്യുമ്പോൾ","poem":1},{"text":"എനിക്ക് നിന്ദ സഹിക്കേണ്ടിവരുന്നു;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ഞാൻ ചാക്കുശീലധരിക്കുമ്പോൾ","poem":1},{"text":"അവർക്കു ഞാനൊരു പഴമൊഴിയായിത്തീരുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"നഗരകവാടത്തിൽ ഇരിക്കുന്നവർ എന്നെ പരിഹസിക്കുന്നു,","poem":1},{"text":"മദ്യപർക്ക് ഞാനൊരു ഗാനമായിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"എന്നാൽ യഹോവേ, അവിടത്തെ പ്രസാദകാലത്ത്,","poem":1},{"text":"ഞാൻ അങ്ങയോട് പ്രാർഥിക്കുന്നു;","poem":2},{"text":"ദൈവമേ, അങ്ങയുടെ മഹാസ്നേഹംനിമിത്തം","poem":1},{"text":"അങ്ങയുടെ രക്ഷാവിശ്വസ്തതയാൽ എനിക്കുത്തരമരുളണമേ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ചേറ്റുകുഴിയിൽനിന്ന് എന്നെ മോചിപ്പിക്കണമേ,","poem":1},{"text":"ഞാനതിൽ ആഴ്ന്നുപോകാൻ അനുവദിക്കരുതേ;","poem":2},{"text":"എന്നെ വെറുക്കുന്നവരിൽനിന്നും","poem":1},{"text":"ആഴമേറിയ ജലാശയത്തിൽനിന്നും എന്നെ വിടുവിക്കണമേ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ജലപ്രവാഹം എന്നെ മുക്കിക്കളയുന്നതിനോ","poem":1},{"text":"ആഴങ്ങൾ എന്നെ വിഴുങ്ങിക്കളയുന്നതിനോ","poem":2},{"lineBreak":true},{"text":"ഗർത്തങ്ങൾ എന്നെ അവയുടെയുള്ളിൽ ബന്ധിച്ചിടുന്നതിനോ അനുവദിക്കരുതേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"യഹോവേ, അവിടത്തെ സ്നേഹമാഹാത്മ്യത്താൽ എനിക്കുത്തരമരുളണമേ;","poem":1},{"text":"അവിടത്തെ കരുണാധിക്യത്താൽ എന്നിലേക്കു തിരിയണമേ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അങ്ങയുടെ ദാസനിൽനിന്നു തിരുമുഖം മറയ്ക്കരുതേ;","poem":1},{"text":"ഞാൻ കഷ്ടതയിൽ ആയിരിക്കുകയാൽ വേഗത്തിൽ എനിക്ക് ഉത്തരമരുളണമേ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"എന്നോട് അടുത്തുവന്ന് എന്നെ മോചിപ്പിക്കണമേ;","poem":1},{"text":"എന്റെ ശത്രുക്കൾനിമിത്തം എന്നെ വീണ്ടുകൊള്ളണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ഞാൻ സഹിക്കുന്ന നിന്ദയും അപമാനവും ലജ്ജയും അങ്ങ് അറിയുന്നു;","poem":1},{"text":"എന്റെ എല്ലാ ശത്രുക്കളും തിരുമുമ്പിലുണ്ടല്ലോ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"നിന്ദ എന്റെ ഹൃദയത്തെ തകർത്തിരിക്കുന്നു","poem":1},{"text":"അത് എന്നെ നിസ്സഹായനാക്കിയിരിക്കുന്നു;","poem":2},{"text":"ഞാൻ മനസ്സലിവിനായി ചുറ്റും പരതി, എന്നാൽ എനിക്കൊരിടത്തുനിന്നും ലഭിച്ചില്ല,","poem":1},{"text":"ആശ്വസിപ്പിക്കുന്നവർക്കായി കാത്തിരുന്നു, എന്നാൽ ആരെയും കണ്ടെത്തിയില്ല.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവർ എന്റെ ഭക്ഷണത്തിൽ കയ്‌പുകലർത്തി","poem":1},{"text":"എന്റെ ദാഹത്തിന് കുടിക്കാൻ അവർ വിന്നാഗിരി തന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"അവരുടെ ഭക്ഷണമേശ അവർക്കൊരു കെണിയായിത്തീരട്ടെ;","poem":1},{"text":"അവരുടെ സമൃദ്ധി അവർക്കൊരു കുരുക്കായിത്തീരട്ടെ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"കാണാൻ കഴിയാതവണ്ണം അവരുടെ കണ്ണുകൾ ഇരുണ്ടുപോകട്ടെ,","poem":1},{"text":"അവരുടെ അരക്കെട്ടുകൾ എന്നേക്കുമായി കുനിഞ്ഞുപോകട്ടെ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അങ്ങയുടെ കോപം അവരുടെമേൽ ചൊരിയണമേ;","poem":1},{"text":"അവിടത്തെ ഭീകരകോപം അവരെ കീഴടക്കട്ടെ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"അവരുടെ വാസസ്ഥലം വിജനമായിത്തീരട്ടെ;","poem":1},{"text":"അവരുടെ കൂടാരങ്ങളിൽ ആരും വസിക്കാതിരിക്കട്ടെ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"കാരണം അങ്ങ് മുറിവേൽപ്പിച്ചവരെ അവർ പീഡിപ്പിക്കുന്നു","poem":1},{"text":"അങ്ങ് മുറിവേൽപ്പിച്ചവരുടെ വേദനയെപ്പറ്റി അവർ ചർച്ചചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"അവരുടെ കുറ്റത്തിനുമേൽ കുറ്റം കൂട്ടണമേ;","poem":1},{"text":"അവർ അങ്ങയുടെ രക്ഷയിൽ പങ്കുകാരാകാൻ അനുവദിക്കരുതേ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ജീവന്റെ പുസ്തകത്തിൽനിന്ന് അവരുടെ പേരുകൾ മായിച്ചുകളയണമേ","poem":1},{"text":"നീതിനിഷ്ഠരോടുകൂടെ അവരെ എണ്ണുകയുമരുതേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ഞാൻ പീഡനത്തിലും വേദനയിലും ആയിരിക്കുന്നു—","poem":1},{"text":"ദൈവമേ, അവിടത്തെ രക്ഷ എന്നെ സംരക്ഷിക്കണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"ഞാൻ പാട്ടോടെ ദൈവത്തിന്റെ നാമം സ്തുതിക്കും","poem":1},{"text":"സ്തോത്രാർപ്പണത്തോടെ അവിടത്തെ മഹത്ത്വപ്പെടുത്തും.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ഇത് യഹോവയ്ക്ക് ഒരു കാളയെ,","poem":1},{"text":"കൊമ്പും കുളമ്പുമുള്ള കാളക്കൂറ്റനെ, യാഗമർപ്പിക്കുന്നതിലും പ്രസാദകരമായിരിക്കും.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"പീഡിതർ അതുകണ്ടു സന്തുഷ്ടരാകും—","poem":1},{"text":"ദൈവത്തെ അന്വേഷിക്കുന്നവരേ, നിങ്ങളുടെ ഹൃദയം സജീവമാകട്ടെ!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"യഹോവ ദരിദ്രരുടെ അപേക്ഷ കേൾക്കും;","poem":1},{"text":"തന്റെ ബന്ധിതരായവരെ നിരാകരിക്കുകയുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"ആകാശവും ഭൂമിയും അവിടത്തെ സ്തുതിക്കട്ടെ,","poem":1},{"text":"സമുദ്രങ്ങളും അതിൽ സഞ്ചരിക്കുന്ന സമസ്തവുംതന്നെ,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"കാരണം ദൈവം സീയോനെ രക്ഷിക്കുകയും","poem":1},{"text":"അവിടന്ന് യെഹൂദാനഗരങ്ങളെ പുനർനിർമിക്കുകയും ചെയ്യും.","poem":2},{"text":"അപ്പോൾ അങ്ങയുടെ ജനം അവിടെ പാർത്ത് അത് കൈവശമാക്കും;","poem":1}]},{"type":"verse","number":36,"content":[{"text":"അവിടത്തെ സേവകരുടെ മക്കൾ അതിനെ അവകാശമാക്കുകയും","poem":2},{"lineBreak":true},{"text":"തിരുനാമത്തെ സ്നേഹിക്കുന്നവർ അവിടെ അധിവസിക്കുകയും ചെയ്യും.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}