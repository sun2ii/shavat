{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":7,"content":[{"type":"hebrew_subtitle","content":["ബെന്യാമീന്യനായ കൂശിന്റെ വാക്കുകൾനിമിത്തം ദാവീദ് യഹോവയ്ക്കു പാടിയ വിഭ്രമഗീതം."]},{"type":"verse","number":1,"content":[{"text":"എന്റെ ദൈവമായ യഹോവേ, അങ്ങയിൽ ഞാൻ അഭയംതേടുന്നു;","poem":1},{"text":"എന്നെ വേട്ടയാടുന്ന എല്ലാവരിൽനിന്നും എന്നെ രക്ഷിച്ച് മോചിപ്പിക്കണമേ,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അല്ലായ്കിൽ ഒരു സിംഹം കടിച്ചുകീറുന്നതുപോലെ അവരെന്നെ കീറിക്കളയുകയും","poem":1},{"text":"ആർക്കും മോചിപ്പിക്കാൻ കഴിയാത്തവിധം എന്നെ കഷണംകഷണമായി ചീന്തിക്കളയുകയും ചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"എന്റെ ദൈവമായ യഹോവേ, ഞാൻ ഇതു ചെയ്തിട്ടുണ്ടെങ്കിൽ","poem":1},{"text":"എന്റെ കൈയിൽ അതിക്രമമുണ്ടെങ്കിൽ—","poem":2}]},{"type":"verse","number":4,"content":[{"text":"എന്നോടു സഖ്യത്തിലിരുന്നവരോടു ഞാൻ തിന്മ പ്രവർത്തിച്ചിട്ടുണ്ടെങ്കിൽ","poem":1},{"text":"അകാരണമായി എന്റെ ശത്രുവിനെ കൊള്ളയിട്ടിട്ടുണ്ടെങ്കിൽ—","poem":2}]},{"type":"verse","number":5,"content":[{"text":"എന്റെ ശത്രു എന്നെ പിൻതുടർന്നു കീഴ്പ്പെടുത്തട്ടെ;","poem":1},{"text":"അവരെന്റെ ജീവൻ നിലത്തിട്ടു ചവിട്ടിമെതിക്കുകയും","poem":2},{"lineBreak":true},{"text":"എന്റെ അഭിമാനത്തെ പൂഴിയിലമർത്തുകയും ചെയ്യട്ടെ. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"യഹോവേ, കോപത്തോടെ എഴുന്നേൽക്കണമേ;","poem":1},{"text":"എന്റെ എതിരാളികളുടെ കോപത്തിനെതിരായി ഉണരണമേ.","poem":2},{"lineBreak":true},{"text":"എന്റെ ദൈവമേ, ഉണർന്നാലും, അവിടത്തെ വിധിനിർണയം നടപ്പാക്കിയാലും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ജനതകൾ അങ്ങേക്കുചുറ്റും വന്നുചേരട്ടെ,","poem":1},{"text":"ഉത്തുംഗസ്ഥാനത്ത് അങ്ങ് അവർക്കുമീതേ സിംഹാസനസ്ഥൻ ആയിരിക്കുമ്പോൾത്തന്നെ.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"യഹോവ ജനതകളെ ന്യായംവിധിക്കട്ടെ.","poem":2},{"text":"അത്യുന്നതനായ യഹോവേ, എന്റെ നീതിനിഷ്ഠയ്ക്കും സത്യസന്ധതയ്ക്കും","poem":1},{"text":"അനുസൃതമായി എന്നെ കുറ്റവിമുക്തനാക്കണമേ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ദുഷ്ടരുടെ അതിക്രമങ്ങൾക്ക് അറുതിവരുത്തുകയും","poem":1},{"text":"നീതിനിഷ്ഠരുടെ സുരക്ഷ ഉറപ്പാക്കുകയും ചെയ്യണമേ—","poem":2},{"text":"നീതിമാനായ ദൈവമേ,","poem":1},{"text":"അങ്ങ് ഹൃദയവും മനസ്സും പരിശോധിക്കുന്നല്ലോ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"അത്യുന്നതനായ ദൈവം എന്റെ പരിച","poem":1},{"noteId":10},{"text":"ആകുന്നു,","poem":1},{"text":"അവിടന്ന് ഹൃദയപരമാർഥികളെ രക്ഷിക്കുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ദൈവം നീതിയുള്ള ന്യായാധിപതി ആകുന്നു,","poem":1},{"text":"അവിടന്ന് ദുഷ്ടരോട് അനുദിനം രോഷംകൊള്ളുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"മനുഷ്യർ പശ്ചാത്തപിക്കുന്നില്ലെങ്കിൽ,","poem":1},{"text":"ദൈവം","poem":2},{"noteId":11},{"text":"തന്റെ വാളിനു മൂർച്ചകൂട്ടും;","poem":2},{"lineBreak":true},{"text":"അവിടന്ന് തന്റെ വില്ലുകുലച്ച് ഒരുക്കിവെക്കും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അവിടന്ന് തന്റെ മാരകായുധങ്ങൾ അവർക്കെതിരേ ഒരുക്കുന്നു;","poem":1},{"text":"അവിടന്ന് തന്റെ തീയമ്പുകൾ സജ്ജമാക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ദുഷ്ടർ തിന്മ ഗർഭംധരിക്കുന്നു;","poem":1},{"text":"അനർഥം ഉദരത്തിൽ വഹിച്ച് വ്യാജം പ്രസവിക്കുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവർ ഒരു കുഴികുഴിച്ചുണ്ടാക്കുന്നു","poem":1},{"text":"അവർ കുഴിച്ച കുഴിയിൽത്തന്നെ അവർ വീഴുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അവരുടെ ദ്രോഹം അവരെത്തന്നെ ചുറ്റിവരിയുന്നു;","poem":1},{"text":"അവരുടെ അതിക്രമം അവരുടെ തലയിൽത്തന്നെ പതിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ഞാൻ യഹോവയ്ക്കു സ്തോത്രംചെയ്യും, കാരണം അവിടന്നു നീതിമാനാണ്;","poem":1},{"text":"അത്യുന്നതനായ യഹോവയുടെ നാമത്തിനു ഞാൻ സ്തുതിപാടും.","poem":2}]}],"footnotes":[{"noteId":10,"caller":"+","text":"അഥവാ, കർത്താവ്","reference":{"chapter":7,"verse":10}},{"noteId":11,"caller":"+","text":"മൂ.ഭാ. അദ്ദേഹം","reference":{"chapter":7,"verse":12}}]},"thisChapterLink":"/api/mal_bib/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}