{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":71,"content":[{"type":"verse","number":1,"content":[{"text":"യഹോവേ, ഞാൻ അങ്ങയിൽ അഭയംതേടുന്നു;","poem":1},{"text":"ഞാൻ ഒരുനാളും ലജ്ജിച്ചുപോകരുതേ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവിടത്തെ നീതിയിൽ എന്നെ മോചിപ്പിക്കുകയും വിടുവിക്കുകയും ചെയ്യണമേ;","poem":1},{"text":"അങ്ങയുടെ ചെവി എന്നിലേക്കു ചായ്ച്ച് എന്നെ രക്ഷിക്കണമേ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"എനിക്ക് എപ്പോഴും ഓടിയെത്താൻ കഴിയുന്ന,","poem":1},{"text":"എന്റെ അഭയമാകുന്ന പാറയാകണമേ.","poem":2},{"text":"അങ്ങ് എന്റെ പാറയും കോട്ടയും ആകുകയാൽ","poem":1},{"text":"എന്നെ രക്ഷിക്കാൻ അവിടന്ന് കൽപ്പന നൽകണമേ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"എന്റെ ദൈവമേ, ദുഷ്ടരുടെ കൈയിൽനിന്നും","poem":1},{"text":"അധർമികളും ക്രൂരരുമായവരുടെ പിടിയിൽനിന്നും എന്നെ മോചിപ്പിക്കണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"കർത്താവായ യഹോവേ, അങ്ങാണ് എന്റെ പ്രത്യാശ,","poem":1},{"text":"എന്റെ യൗവനംമുതൽ അവിടന്നാണെന്റെ ആശ്രയം.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ജനനംമുതൽ ഞാൻ അങ്ങയിൽ ആശ്രയിച്ചു;","poem":1},{"text":"അവിടന്നാണ് എന്നെ എന്റെ മാതാവിന്റെ ഗർഭപാത്രത്തിൽനിന്നും പുറത്തെടുത്തത്.","poem":2},{"lineBreak":true},{"text":"ഞാൻ അങ്ങയെ സദാ സ്തുതിക്കും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ഞാൻ പലർക്കുമൊരു അത്ഭുതവിഷയം ആയിരിക്കുന്നു;","poem":1},{"text":"എന്നാൽ അവിടന്നാണ് എന്റെ ബലമുള്ള സങ്കേതം.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"എന്റെ വായിൽ അങ്ങയുടെ സ്തുതി നിറഞ്ഞിരിക്കുന്നു,","poem":1},{"text":"ദിവസംമുഴുവനും അത് അവിടത്തെ മഹത്ത്വം വർണിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ഞാൻ വൃദ്ധൻ ആകുമ്പോൾ എന്നെ പുറന്തള്ളരുതേ;","poem":1},{"text":"എന്റെ ശക്തി ക്ഷയിക്കുമ്പോൾ എന്നെ ഉപേക്ഷിക്കുകയുമരുതേ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"എന്റെ ശത്രുക്കൾ എനിക്കെതിരേ സംസാരിക്കുന്നു;","poem":1},{"text":"അവർ ഒരുമിച്ച് ഗൂഢാലോചന നടത്തി എന്നെ വധിക്കുന്നതിനായി കാത്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“ദൈവം ആ മനുഷ്യനെ ഉപേക്ഷിച്ചിരിക്കുന്നു;","poem":1},{"text":"അയാളെ പിൻതുടർന്ന് പിടികൂടാം,","poem":2},{"lineBreak":true},{"text":"ആരും അയാളെ മോചിപ്പിക്കുകയില്ല,” എന്നിങ്ങനെ അവർ പറയുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ദൈവമേ, എന്നിൽനിന്ന് അകന്നിരിക്കരുതേ;","poem":1},{"text":"എന്റെ ദൈവമേ, എന്നെ സഹായിക്കാൻ വേഗം വരണമേ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"എന്നിൽ കുറ്റം ആരോപിക്കുന്നവർ അപമാനിതരായി നശിക്കട്ടെ;","poem":1},{"text":"എന്നെ ദ്രോഹിക്കാൻ തുനിയുന്നവർ","poem":2},{"lineBreak":true},{"text":"നിന്ദയാലും ലജ്ജയാലും മൂടപ്പെടട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"എന്നാൽ ഞാൻ എപ്പോഴും അങ്ങയിൽ പ്രതീക്ഷ അർപ്പിക്കും;","poem":1},{"text":"ഞാൻ അങ്ങയെ മേൽക്കുമേൽ സ്തോത്രംചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ദിവസംമുഴുവനും എന്റെ വായ്","poem":1},{"text":"അങ്ങയുടെ നീതിയെക്കുറിച്ചും രക്ഷയെക്കുറിച്ചും വർണിക്കും—","poem":2},{"lineBreak":true},{"text":"അവ എന്റെ അറിവിന് അതീതമാണല്ലോ.","poem":2},{"noteId":67}]},{"type":"verse","number":16,"content":[{"text":"കർത്താവായ യഹോവേ, ഞാൻ വന്ന് അങ്ങയുടെ വീര്യപ്രവൃത്തികൾ ഘോഷിക്കും;","poem":1},{"text":"അങ്ങയുടെ നീതിപ്രവൃത്തികൾ ഞാൻ ഉദ്ഘോഷിക്കും, അങ്ങയുടേതുമാത്രം.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ദൈവമേ, എന്റെ ബാല്യംമുതൽ അങ്ങ് എന്നെ അഭ്യസിപ്പിച്ചിരിക്കുന്നു,","poem":1},{"text":"ഇന്നുവരെ ഞാൻ അവിടത്തെ അത്ഭുതപ്രവൃത്തികളെപ്പറ്റി വർണിക്കുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"എന്റെ ദൈവമേ, എനിക്ക് വാർധക്യവും നരയും വന്നുചേരുമ്പോഴും","poem":1},{"text":"അടുത്ത തലമുറയോട് അവിടത്തെ ശക്തിയെക്കുറിച്ചും","poem":2},{"text":"എനിക്കു ശേഷമുള്ള എല്ലാവരോടും അങ്ങയുടെ വീര്യപ്രവൃത്തികളെ പ്രഖ്യാപിക്കുന്നതുവരെയും.","poem":1},{"text":"എന്നെ ഉപേക്ഷിക്കരുതേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ദൈവമേ, അവിടത്തെ നീതി ആകാശത്തോളം എത്തുന്നു.","poem":1},{"text":"അങ്ങ് മഹത്കാര്യങ്ങൾ ചെയ്തിരിക്കുന്നു.","poem":2},{"lineBreak":true},{"text":"ദൈവമേ, അങ്ങേക്കുതുല്യൻ ആരുള്ളൂ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ഒട്ടനവധി കഠിനയാതനകളിലൂടെ","poem":1},{"text":"അവിടന്ന് എന്നെ നടത്തിയെങ്കിലും","poem":2},{"lineBreak":true},{"text":"അവിടന്ന് എന്റെ ജീവൻ പുനരുദ്ധരിക്കും;","poem":2},{"text":"ഭൂമിയുടെ അഗാധതലങ്ങളിൽനിന്നും","poem":1},{"text":"അവിടന്നെന്നെ ഉയർത്തിക്കൊണ്ടുവരും.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവിടന്ന് എന്റെ ബഹുമതി വർധിപ്പിച്ച്","poem":1},{"text":"ഒരിക്കൽക്കൂടി എന്നെ ആശ്വസിപ്പിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"കിന്നരവാദ്യത്തോടെ ഞാൻ അങ്ങയെ വാഴ്ത്തിപ്പാടും","poem":1},{"text":"എന്റെ ദൈവമേ, അവിടന്ന് വിശ്വസ്തനാണല്ലോ;","poem":2},{"text":"ഇസ്രായേലിന്റെ പരിശുദ്ധനേ,","poem":1},{"text":"വീണ മീട്ടി ഞാൻ അങ്ങേക്ക് സ്തുതിപാടും.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ഞാൻ അങ്ങേക്ക് സ്തുതിപാടുമ്പോൾ","poem":1},{"text":"എന്റെ അധരങ്ങളും","poem":2},{"lineBreak":true},{"text":"അങ്ങ് വിമോചനമേകിയ ഈ ഏഴയും ഘോഷിച്ചാനന്ദിക്കും.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ദിവസംമുഴുവനും","poem":1},{"text":"എന്റെ നാവ് അങ്ങയുടെ നീതിപ്രവൃത്തികളെ വർണിക്കും,","poem":2},{"text":"കാരണം എന്നെ ദ്രോഹിക്കാൻ ആഗ്രഹിച്ചവർ","poem":1},{"text":"ലജ്ജിതരും പരിഭ്രാന്തരും ആയിത്തീർന്നല്ലോ.","poem":2}]}],"footnotes":[{"noteId":67,"caller":"+","text":"മൂ.ഭാ. അവയുടെ എണ്ണം എനിക്കറിഞ്ഞുകൂടാ.","reference":{"chapter":71,"verse":15}}]},"thisChapterLink":"/api/mal_bib/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}