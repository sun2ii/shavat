{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":72,"content":[{"type":"hebrew_subtitle","content":["ശലോമോന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"ദൈവമേ, രാജാവിന് അങ്ങയുടെ ന്യായവും","poem":1},{"text":"രാജകുമാരന് അങ്ങയുടെ നീതിനിഷ്ഠയും കൽപ്പിച്ചുനൽകണമേ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അദ്ദേഹം അവിടത്തെ ജനത്തെ നീതിയോടും","poem":1},{"text":"പീഡിതരെ ന്യായത്തോടുംകൂടെ ന്യായപാലനംചെയ്യട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"പർവതങ്ങൾ ജനത്തിനു സമൃദ്ധിയും","poem":1},{"text":"കുന്നുകൾ നീതിയുടെ ഫലങ്ങളും നൽകട്ടെ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ജനത്തിലെ പീഡിതർക്ക് അദ്ദേഹം പ്രതിരോധം തീർക്കും","poem":1},{"text":"ദരിദ്രരുടെ മക്കളെ മോചിപ്പിക്കും;","poem":2},{"lineBreak":true},{"text":"പീഡകരെ അദ്ദേഹം തകർക്കും","poem":2}]},{"type":"verse","number":5,"content":[{"text":"സൂര്യനും ചന്ദ്രനുമുള്ള കാലത്തോളം","poem":1},{"text":"എല്ലാ തലമുറകളിലുമുള്ള ജനം അദ്ദേഹത്തെ ഭയപ്പെടട്ടെ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അദ്ദേഹം വെട്ടിയൊതുക്കിയ പുൽപ്പുറങ്ങളിൽ പെയ്യുന്ന മഴപോലെയും","poem":1},{"text":"ഭൂമിയെ നനയ്ക്കുന്ന വർഷംപോലെയും ആയിരിക്കട്ടെ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അദ്ദേഹത്തിന്റെ ദിനങ്ങളിൽ നീതിനിഷ്ഠർ അഭിവൃദ്ധിപ്രാപിക്കും","poem":1},{"text":"ചന്ദ്രൻ ഉള്ളകാലത്തോളം ഐശ്വര്യസമൃദ്ധിയുണ്ടാകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"സമുദ്രംമുതൽ സമുദ്രംവരെയും","poem":1},{"text":"യൂഫ്രട്ടീസ് നദിമുതൽ ഭൂമിയുടെ അറ്റത്തോളവും അദ്ദേഹം ഭരണംനടത്തട്ടെ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"മരുഭൂവാസികൾ അദ്ദേഹത്തിന്റെമുമ്പിൽ വണങ്ങുകയും","poem":1},{"text":"അദ്ദേഹത്തിന്റെ ശത്രുക്കൾ പൊടി നക്കുകയുംചെയ്യട്ടെ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"തർശീശിലെയും വിദൂരതീരങ്ങളിലെയും ആളുകൾ","poem":1},{"text":"അദ്ദേഹത്തിന്റെമുമ്പിൽ കപ്പംകൊണ്ടുവരട്ടെ.","poem":2},{"noteId":68},{"text":"ശേബയിലെയും സേബയിലെയും രാജാക്കന്മാർ","poem":1},{"text":"ഉപഹാരങ്ങൾ കൊണ്ടുവരട്ടെ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"എല്ലാ രാജാക്കന്മാരും അദ്ദേഹത്തിന്റെമുമ്പിൽ താണുവണങ്ങുകയും","poem":1},{"text":"സകലരാഷ്ട്രങ്ങളും അദ്ദേഹത്തെ സേവിക്കുകയുംചെയ്യട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"കാരണം തന്നോടു നിലവിളിക്കുന്ന ദരിദ്രരെയും","poem":1},{"text":"ആശ്രയമറ്റ പീഡിതരെയും അദ്ദേഹം മോചിപ്പിക്കും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ബലഹീനരോടും ദരിദ്രരോടും അദ്ദേഹം കരുണകാണിക്കും","poem":1},{"text":"അദ്ദേഹം ദരിദ്രരെ മരണത്തിൽനിന്നു രക്ഷിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"പീഡനത്തിൽനിന്നും അക്രമത്തിൽനിന്നും അദ്ദേഹം അവരെ മോചിപ്പിക്കും,","poem":1},{"text":"അവരുടെ രക്തം അദ്ദേഹത്തിന്റെ ദൃഷ്ടിയിൽ വിലപ്പെട്ടതായിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"രാജാവ് നീണാൾ വാഴട്ടെ!","poem":1},{"text":"ശേബയിലെ സ്വർണം അദ്ദേഹത്തിന് കാഴ്ചയായി അർപ്പിക്കപ്പെടട്ടെ.","poem":2},{"text":"ജനം അദ്ദേഹത്തിനുവേണ്ടി നിരന്തരം പ്രാർഥിക്കുകയും","poem":1},{"text":"ദിവസം മുഴുവൻ അദ്ദേഹത്തെ അനുഗ്രഹിക്കുകയും ചെയ്യട്ടെ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ദേശത്തുടനീളം ധാന്യം സുലഭമായി വിളയട്ടെ;","poem":1},{"text":"കുന്നിൻമുകളിൽ അവ ആലോലമാടട്ടെ.","poem":2},{"text":"ലെബാനോൻപോലെ അതു ഫലസമൃദ്ധമാകട്ടെ","poem":1},{"text":"നഗരവാസികൾ വയലിലെ പുല്ലുപോലെ തഴച്ചുവളരട്ടെ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അദ്ദേഹത്തിന്റെ നാമം എന്നെന്നേക്കും നിലനിൽക്കട്ടെ;","poem":1},{"text":"സൂര്യൻ നിലനിൽക്കുന്നകാലത്തോളം അതു സുദീർഘമായിരിക്കട്ടെ.","poem":2},{"lineBreak":true},{"text":"അങ്ങനെ സകലരാഷ്ട്രങ്ങളും അദ്ദേഹത്തിലൂടെ അനുഗ്രഹിക്കപ്പെടട്ടെ,","poem":1},{"noteId":69},{"text":"അദ്ദേഹത്തെ അനുഗൃഹീതൻ എന്ന് അവർ വാഴ്ത്തിപ്പാടട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ദൈവം, ഇസ്രായേലിന്റെ ദൈവമായ യഹോവ വാഴ്ത്തപ്പെടട്ടെ,","poem":1},{"text":"അവിടന്നുമാത്രം ആണല്ലോ അത്ഭുതങ്ങൾ പ്രവർത്തിക്കുന്നത്.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അവിടത്തെ മഹത്ത്വമാർന്ന നാമം എന്നെന്നേക്കും വാഴ്ത്തപ്പെടട്ടെ;","poem":1},{"text":"സർവഭൂമിയും അവിടത്തെ മഹത്ത്വത്താൽ നിറയട്ടെ.","poem":2},"ആമേൻ, ആമേൻ."]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"യിശ്ശായിയുടെ പുത്രനായ ദാവീദിന്റെ പ്രാർഥനകൾ സമാപ്തം.","poem":1}]}],"footnotes":[{"noteId":68,"caller":"+","text":"ചക്രവർത്തിയുടെ ഭരണത്തിൻകീഴേയുള്ള രാജ്യങ്ങളിലെ രാജാക്കന്മാർ വർഷംതോറും ചക്രവർത്തിക്ക് കൊടുത്തുവന്നിരുന്ന നികുതി.","reference":{"chapter":72,"verse":10}},{"noteId":69,"caller":"+","text":"ഉൽ. 48:20കാണുക.","reference":{"chapter":72,"verse":17}}]},"thisChapterLink":"/api/mal_bib/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}