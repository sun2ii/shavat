{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":73,"content":[{"type":"hebrew_subtitle","content":["ആസാഫിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"ദൈവം ഇസ്രായേലിന് നല്ലവൻ ആകുന്നു,","poem":1},{"text":"ഹൃദയനൈർമല്യമുള്ളവർക്കുതന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"എന്നാൽ എന്റെ പാദങ്ങൾ ഏറെക്കുറെ ഇടറി;","poem":1},{"text":"എന്റെ കാൽച്ചുവടുകൾ ഏതാണ്ട് വഴുതിമാറി.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ദുഷ്ടരുടെ അഭിവൃദ്ധി കണ്ടപ്പോൾ","poem":1},{"text":"അഹങ്കാരികളോട് ഞാൻ അസൂയപ്പെട്ടു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"അവർക്കു യാതൊരുവിധ ബദ്ധപ്പാടുകളുമില്ല;","poem":1},{"text":"അവരുടെ ശരീരം ആരോഗ്യവും ശക്തിയുമുള്ളത്.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവർ സാധാരണ ജനങ്ങളെപ്പോലെ ജീവിതഭാരം അനുഭവിക്കുന്നില്ല;","poem":1},{"text":"ഇതര മനുഷ്യരെപ്പോലെ രോഗാതുരർ ആകുന്നില്ല.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അതുകൊണ്ട് അഹങ്കാരംകൊണ്ടവർ ഹാരമണിയുന്നു;","poem":1},{"text":"അക്രമംകൊണ്ടവർ അങ്കി ധരിക്കുന്നു","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവരുടെ കഠോരഹൃദയങ്ങളിൽനിന്ന് അകൃത്യം കവിഞ്ഞൊഴുകുന്നു;","poem":1},{"text":"അവരുടെ ദുഷ്ടസങ്കൽപ്പങ്ങൾക്ക് അതിരുകളില്ല.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവർ പരിഹസിച്ച് വിദ്വേഷത്തോടെ സംസാരിക്കുന്നു;","poem":1},{"text":"ധിക്കാരപൂർവമവർ പീഡനഭീഷണി മുഴക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവരുടെ വായ് ആകാശത്തിനുമേൽ അധികാരമുറപ്പിക്കുന്നു,","poem":1},{"text":"അവരുടെ നാവ് ഭൂമിയെ അധീനതയിലാക്കുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അതുകൊണ്ട് അവരുടെ ജനം അവരിലേക്കു തിരിയുന്നു","poem":1},{"text":"അവർ ധാരാളം വെള്ളം കുടിച്ചുതീർക്കുന്നു.","poem":2},{"noteId":70}]},{"type":"verse","number":11,"content":[{"text":"“ദൈവം എങ്ങനെ അറിയും?","poem":1},{"text":"അത്യുന്നതന് അറിവുണ്ടോ?” എന്നിങ്ങനെ അവർ ചോദിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ദുഷ്ടർ ഇപ്രകാരമാണ്—","poem":1},{"text":"അവർ എപ്പോഴും സ്വസ്ഥരായിരുന്ന് സമ്പത്തു വർധിപ്പിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ഞാൻ എന്റെ ഹൃദയം സംശുദ്ധമാക്കിയതും","poem":1},{"text":"എന്റെ കൈകളെ നിഷ്കളങ്കതയിൽ കഴുകിയതും വൃഥാവിലായി, നിശ്ചയം.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ഞാൻ ദിവസംമുഴുവനും പീഡിപ്പിക്കപ്പെട്ടുകൊണ്ടിരിക്കുന്നു,","poem":1},{"text":"ഓരോ പ്രഭാതത്തിലും ഞാൻ ശിക്ഷ അനുഭവിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ഞാൻ ഈ വിധം സംസാരിക്കണമെന്ന് നിരൂപിച്ചിരുന്നെങ്കിൽ,","poem":1},{"text":"അങ്ങയുടെ മക്കളുടെ തലമുറയെ ഞാൻ വഞ്ചിക്കുമായിരുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ഇതെല്ലാം മനസ്സിലാക്കാൻ ഞാൻ പരിശ്രമിച്ചു","poem":1},{"text":"എന്നാൽ എനിക്കത് ക്ലേശകരമായിരുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അങ്ങനെ ഞാൻ ദൈവത്തിന്റെ തിരുനിവാസത്തിൽ പ്രവേശിച്ചു;","poem":1},{"text":"അപ്പോൾ അവരുടെ അന്തിമവിധിയെപ്പറ്റിയുള്ള അവബോധം എനിക്കു ലഭിച്ചു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"അങ്ങ് അവരെ വഴുവഴുപ്പുള്ള പ്രതലത്തിൽ നിർത്തിയിരിക്കുന്നു, നിശ്ചയം;","poem":1},{"text":"അവിടന്ന് അവരെ നാശത്തിലേക്കു തള്ളിയിടുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അവർ എത്രയും പെട്ടെന്ന് നശിപ്പിക്കപ്പെടുന്നു,","poem":1},{"text":"കൊടുംഭീകരതകളാൽ അവർ നിശ്ശേഷം തുടച്ചുനീക്കപ്പെടുന്നു!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"കർത്താവേ, അവിടന്ന് എഴുന്നേൽക്കുമ്പോൾ,","poem":1},{"text":"ദുഃസ്വപ്നത്തിൽനിന്ന് ഞെട്ടിയുണർന്ന ഒരാളെപ്പോലെ അവിടന്ന് അവരെ വെറുക്കുമല്ലോ;","poem":2},{"lineBreak":true},{"text":"ഒരു മായക്കാഴ്ചപോലെ അവരെ നിന്ദിച്ചുതള്ളുമല്ലോ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"എന്റെ ഹൃദയത്തിൽ കയ്‌പു നിറയുകയും","poem":1},{"text":"എന്റെ അന്തരംഗം തകർന്നടിയുകയും ചെയ്തപ്പോൾ,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"തിരുമുമ്പിൽ ഞാൻ ഒരു ഭോഷനും അജ്ഞനും","poem":1},{"text":"വിവേകമില്ലാത്ത ഒരു മൃഗത്തെപ്പോലെയുള്ളവനും ആയിരുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"എങ്കിലും ഞാൻ എപ്പോഴും അങ്ങയോടൊപ്പം ആയിരിക്കുന്നു;","poem":1},{"text":"അവിടന്ന് എന്റെ വലങ്കൈയിൽ പിടിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അവിടന്ന് എനിക്ക് ആലോചന നൽകി നടത്തുന്നു,","poem":1},{"text":"അതിനുശേഷം അവിടത്തെ മഹത്ത്വത്തിലേക്ക് എന്നെ ആനയിക്കുന്നു.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"സ്വർഗത്തിൽ അങ്ങല്ലാതെ മറ്റാരാണ് എനിക്കുള്ളത്?","poem":1},{"text":"ഭൂമിയിലും അങ്ങയെ അല്ലാതെ മറ്റൊന്നും ഞാൻ ആഗ്രഹിക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"എന്റെ ശരീരവും ഹൃദയവും ദുർബലമായേക്കാം,","poem":1},{"text":"എന്നാൽ ദൈവം എന്റെ ഹൃദയത്തിന്റെ ശക്തിയും","poem":2},{"lineBreak":true},{"text":"എന്നേക്കുമുള്ള എന്റെ ഓഹരിയും ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"അങ്ങയിൽനിന്ന് അകലം പാലിക്കുന്നവരെല്ലാം നശിച്ചുപോകും;","poem":1},{"text":"അങ്ങയോട് അവിശ്വസ്തത പുലർത്തുന്ന എല്ലാവരെയും അവിടന്ന് നശിപ്പിക്കും.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"എന്നാൽ ദൈവത്തോട് അടുത്തിരിക്കുന്നതാണ് എനിക്ക് ഏറെ നല്ലത്.","poem":1},{"text":"കർത്താവായ യഹോവയെ ഞാൻ എന്റെ സങ്കേതമാക്കിയിരിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ പ്രവൃത്തികളെയെല്ലാം ഞാൻ വർണിക്കും.","poem":2}]}],"footnotes":[{"noteId":70,"caller":"+","text":"ഈ വാക്യത്തിന്റെ അർഥം വ്യക്തമല്ല.","reference":{"chapter":73,"verse":10}}]},"thisChapterLink":"/api/mal_bib/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}