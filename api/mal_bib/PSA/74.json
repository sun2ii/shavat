{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":74,"content":[{"type":"hebrew_subtitle","content":["ആസാഫിന്റെ ഒരു ധ്യാനസങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"ദൈവമേ, അവിടന്ന് ഞങ്ങളെ എന്നേക്കുമായി ഉപേക്ഷിച്ചിരിക്കുന്നതെന്തിന്?","poem":1},{"text":"അങ്ങയുടെ കോപം അങ്ങയുടെ മേച്ചിൽപ്പുറത്തെ ആടുകൾക്കെതിരേ പുകയുന്നതും എന്തിന്?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അങ്ങ് പുരാതനകാലത്ത് സമ്പാദിച്ച രാഷ്ട്രത്തെ,","poem":1},{"text":"അവിടന്ന് വീണ്ടെടുത്ത് അവിടത്തെ അനന്തരാവകാശികളാക്കിത്തീർത്ത ജനത്തെയും","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ നിവാസസ്ഥാനമായ സീയോൻ പർവതത്തെയും ഓർക്കണമേ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അങ്ങയുടെ തൃപ്പാദങ്ങൾ അനന്തമായ ഈ അവശിഷ്ടങ്ങളിലേക്കു തിരിയണമേ,","poem":1},{"text":"ശത്രു നശിപ്പിച്ച തിരുനിവാസത്തിലെ സകലവസ്തുക്കളിലേക്കുംതന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"അവിടന്ന് ഞങ്ങളെ സന്ദർശിച്ച സ്ഥലത്ത് അങ്ങയുടെ ശത്രുക്കൾ അട്ടഹാസം മുഴക്കി;","poem":1},{"text":"അവർ തങ്ങളുടെ കൊടി ഒരു ചിഹ്നമായി ഉയർത്തിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"കുറ്റിക്കാട് വെട്ടിനിരത്തുന്നവരെപ്പോലെ","poem":1},{"text":"അവർ അവരുടെ മഴുവീശി.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവിടെ ഉണ്ടായിരുന്ന കൊത്തുപണികളെല്ലാം","poem":1},{"text":"മഴുകൊണ്ടും കൈക്കോടാലികൊണ്ടും വെട്ടിനശിപ്പിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അങ്ങയുടെ വിശുദ്ധമന്ദിരം അവർ അഗ്നിക്കിരയാക്കി, നിലംപൊത്തിച്ചിരിക്കുന്നു;","poem":1},{"text":"തിരുനാമത്തിന്റെ വാസസ്ഥാനം അവർ അശുദ്ധമാക്കിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“ഞങ്ങൾ അവരെ ഉന്മൂലനംചെയ്യും!” എന്ന് അവർ അവരുടെ ഹൃദയത്തിൽ പറഞ്ഞു.","poem":1},{"text":"ദേശത്ത് ദൈവത്തെ ആരാധിച്ചിരുന്ന സകലസ്ഥലങ്ങളും അവർ അഗ്നിക്കിരയാക്കി.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ഞങ്ങൾക്ക് യാതൊരു അത്ഭുതചിഹ്നവും ലഭിച്ചിരുന്നില്ല;","poem":1},{"text":"ഒരു പ്രവാചകനും ശേഷിക്കുന്നില്ല,","poem":2},{"lineBreak":true},{"text":"ഈ സ്ഥിതി എത്രകാലത്തേക്ക് എന്നറിയാവുന്നവർ ഞങ്ങളിൽ ആരുമില്ല.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ദൈവമേ, ശത്രു എത്രനാൾ അങ്ങയെ പരിഹസിക്കും?","poem":1},{"text":"എതിരാളികൾ അവിടത്തെ നാമത്തെ എന്നേക്കും അധിക്ഷേപിക്കുമോ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അങ്ങയുടെ കരം, അങ്ങയുടെ വലങ്കൈ എന്തിന് പിൻവലിക്കുന്നു?","poem":1},{"text":"തിരുക്കരംനീട്ടി അവരെ നശിപ്പിക്കണമേ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ദൈവമേ, അവിടന്ന് ആകുന്നു പുരാതനകാലംമുതൽ എന്റെ രാജാവ്;","poem":1},{"text":"അവിടന്ന് ഭൂമിയിൽ രക്ഷ കൊണ്ടുവരുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"അവിടത്തെ ശക്തിയാൽ അവിടന്ന് സമുദ്രത്തെ വിഭജിച്ചു;","poem":1},{"text":"സമുദ്രത്തിലെ ഭീകരസത്വങ്ങളുടെ തല അവിടന്ന് തകർത്തു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ലിവ്യാഥാന്റെ തലകൾ അവിടന്ന് തകർക്കുകയും","poem":1},{"text":"അങ്ങ് അതിനെ മരുഭൂമിയിലെ ജന്തുക്കൾക്ക് ആഹാരമായി നൽകുകയും ചെയ്തു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഉറവുകളും നീർച്ചാലുകളും തുറന്നത് അവിടന്ന് ആകുന്നു;","poem":1},{"text":"ഒരിക്കലും വറ്റാത്ത നദികളെ അവിടന്നു വറ്റിച്ചുകളഞ്ഞു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"പകൽ അങ്ങയുടേതാകുന്നു, രാത്രിയും അങ്ങേക്കുള്ളതുതന്നെ;","poem":1},{"text":"അവിടന്ന് സൂര്യചന്ദ്രന്മാരെ സ്ഥാപിച്ചു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ഭൂമിയുടെ എല്ലാ അതിർത്തികളും നിർണയിച്ചത് അവിടന്നാണ്;","poem":1},{"text":"ഉഷ്ണകാലവും ശൈത്യകാലവും അവിടന്ന് ഉണ്ടാക്കി.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"യഹോവേ, ശത്രു അങ്ങയെ പരിഹസിച്ചത് എങ്ങനെയെന്നും","poem":1},{"text":"ഭോഷർ തിരുനാമത്തെ അധിക്ഷേപിക്കുന്നത് എങ്ങനെയെന്നും ഓർക്കണമേ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അങ്ങയുടെ പ്രാവിന്റെ","poem":1},{"noteId":71},{"text":"ജീവൻ, ദുഷ്ടമൃഗങ്ങൾക്ക് ഏൽപ്പിച്ചുകൊടുക്കരുതേ;","poem":1},{"text":"അങ്ങയുടെ അഗതികളുടെ ജീവനെ എന്നേക്കും മറക്കരുതേ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അവിടത്തെ ഉടമ്പടി ഓർക്കണമേ,","poem":1},{"text":"ഭൂമിയുടെ അന്ധകാരസ്ഥലങ്ങളിൽ അതിക്രമങ്ങൾ അധികരിച്ചിരിക്കുന്നല്ലോ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"പീഡിതർ അപമാനിതരായി പിന്തിരിയാൻ അനുവദിക്കരുതേ;","poem":1},{"text":"ദരിദ്രരും അഗതികളും അവിടത്തെ നാമത്തെ വാഴ്ത്തട്ടെ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ദൈവമേ, എഴുന്നേൽക്കണമേ, അങ്ങയുടെ ഭാഗം പ്രതിരോധിക്കണമേ;","poem":1},{"text":"ദിവസംമുഴുവനും ഭോഷർ അങ്ങയെ അപഹസിക്കുന്നത് ഓർക്കണമേ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"അങ്ങയുടെ എതിരാളികളുടെ ആരവം അവഗണിക്കരുതേ,","poem":1},{"text":"അങ്ങയുടെ ശത്രുക്കളുടെ നിരന്തരമായി ഉയരുന്ന അട്ടഹാസങ്ങൾ മറക്കരുതേ.","poem":2}]}],"footnotes":[{"noteId":71,"caller":"+","text":"പ്രാവിനെ ഇസ്രായേലിനോട് തുലനംചെയ്തിരിക്കുന്നു; ഹോശ. 7:11കാണുക.","reference":{"chapter":74,"verse":19}}]},"thisChapterLink":"/api/mal_bib/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}