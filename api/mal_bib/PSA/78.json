{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":78,"content":[{"type":"hebrew_subtitle","content":["ആസാഫിന്റെ ഒരു ധ്യാനസങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"എന്റെ ജനമേ, എന്റെ ഉപദേശം കേൾക്കുക;","poem":1},{"text":"എന്റെ വായിലെ വാക്കുകൾ ശ്രദ്ധിക്കുക.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ഞാൻ സാദൃശ്യകഥ സംസാരിക്കുന്നതിനായി എന്റെ വായ് തുറക്കും;","poem":1},{"text":"പുരാതനകാലംമുതൽ മറഞ്ഞിരിക്കുന്ന കാര്യങ്ങൾ ഞാൻ പ്രഖ്യാപിക്കും—","poem":2}]},{"type":"verse","number":3,"content":[{"text":"നാം കേൾക്കുകയും അറിയുകയും","poem":1},{"text":"നമ്മുടെ പൂർവികർ നമ്മെ അറിയിക്കുകയുംചെയ്ത കാര്യങ്ങൾതന്നെ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"നാം അവ അവരുടെ മക്കളിൽനിന്ന് മറച്ചുവെക്കുകയില്ല;","poem":1},{"text":"യഹോവയുടെ മഹത്തായ പ്രവൃത്തികളെപ്പറ്റി,","poem":2},{"text":"അവിടത്തെ ശക്തിയെയും അവിടന്നു ചെയ്ത അത്ഭുതപ്രവൃത്തികളെയുംപറ്റിയും","poem":1},{"text":"ഞങ്ങൾ അടുത്ത തലമുറയോട് പ്രസ്താവിക്കും.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവിടന്ന് യാക്കോബിന് തന്റെ നിയമവ്യവസ്ഥകൾ ഉത്തരവിടുകയും","poem":1},{"text":"ഇസ്രായേലിൽ ന്യായപ്രമാണം സ്ഥാപിക്കുകയും ചെയ്തു—","poem":2},{"text":"നമ്മുടെ പൂർവികരോട് അവരുടെ മക്കൾക്ക്","poem":1},{"text":"ഉപദേശിച്ചുനൽകണമെന്ന് അവിടന്ന് ആജ്ഞാപിച്ചവതന്നെ—","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അങ്ങനെ അടുത്ത തലമുറ ആ കൽപ്പനകൾ അറിയും","poem":1},{"text":"ഇനി ജനിക്കാനിരിക്കുന്ന മക്കളും!","poem":2},{"lineBreak":true},{"text":"അവർ അവരുടെ മക്കളെ അത് പഠിപ്പിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അപ്പോൾ അവർ ദൈവത്തിൽ തങ്ങളുടെ ആശ്രയംവെക്കുകയും","poem":1},{"text":"അവിടത്തെ പ്രവൃത്തികൾ മറക്കാതെ","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ കൽപ്പനകൾ പ്രമാണിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവർ തങ്ങളുടെ പൂർവികരെപ്പോലെ","poem":1},{"text":"ദുശ്ശാഠ്യമുള്ളവരും മത്സരികളുമായ ഒരു തലമുറയോ","poem":2},{"text":"അവിശ്വസ്തരും ദൈവത്തോട് കൂറുപുലർത്താത്ത","poem":1},{"text":"ഹൃദയവുമുള്ള ഒരു തലമുറയോ ആകുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"എഫ്രയീം വില്ലാളിവീരന്മാർ ആയിരുന്നെങ്കിലും","poem":1},{"text":"യുദ്ധദിവസത്തിൽ അവർ പിന്തിരിഞ്ഞോടി;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവർ ദൈവത്തിന്റെ ഉടമ്പടി പാലിക്കുകയോ","poem":1},{"text":"അവിടത്തെ ന്യായപ്രമാണം അനുസരിച്ച് ജീവിക്കുകയോ ചെയ്തില്ല.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അവിടന്നു ചെയ്ത പ്രവൃത്തികളും","poem":1},{"text":"അവരെ കാണിച്ച അത്ഭുതങ്ങളും അവർ മറന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവിടന്ന് അവരുടെ പിതാക്കന്മാരുടെമുമ്പാകെ","poem":1},{"text":"ഈജിപ്റ്റിലെ സോവാൻ സമഭൂമിയിൽ അത്ഭുതങ്ങൾ പ്രവർത്തിച്ചല്ലോ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അവിടന്ന് കടൽ വിഭജിച്ച് അതിലൂടെ അവരെ കടത്തിക്കൊണ്ടുപോയി;","poem":1},{"text":"അവിടന്ന് ജലപാളികളെ ഒരു മതിൽപോലെ ഉറപ്പിച്ചുനിർത്തി.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"പകൽമുഴുവൻ മേഘംകൊണ്ട് അവർക്ക് തണൽ ഒരുക്കി","poem":1},{"text":"രാത്രിമുഴുവൻ അഗ്നിജ്വാലയിൽനിന്നുള്ള പ്രകാശത്താൽ അവിടന്ന് അവരെ നയിച്ചു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവിടന്ന് മരുഭൂമിയിൽവെച്ച് പാറകളെ പിളർത്തി","poem":1},{"text":"ആഴിയിൽനിന്നെന്നപോലെ അവർക്ക് സമൃദ്ധമായി ജലം നൽകി;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"കടുന്തൂക്കായ പാറകളിൽനിന്ന് അവിടന്ന് അരുവികൾ പുറപ്പെടുവിച്ചു.","poem":1},{"text":"ആ നീർച്ചാലുകളെ, താഴ്വരയിലേക്ക് നദികൾപോലെ ഒഴുക്കി.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"എന്നിട്ടും അവർ അവിടത്തേക്കെതിരേ പാപംചെയ്തുകൊണ്ടിരുന്നു,","poem":1},{"text":"മരുഭൂമിയിൽവെച്ച് അത്യുന്നതനെതിരേ മത്സരിച്ചുകൊണ്ടിരുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"തങ്ങൾ ആഗ്രഹിച്ച ഭക്ഷണത്തിനായി","poem":1},{"text":"അവർ മനഃപൂർവം ദൈവത്തെ പരീക്ഷിച്ചു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അവർ ദൈവത്തിനു വിരോധമായി മുറവിളികൂട്ടിക്കൊണ്ട്","poem":1},{"text":"ഇപ്രകാരം പറഞ്ഞു: “മരുഭൂമിയിൽ നമുക്ക്","poem":2},{"lineBreak":true},{"text":"ഭക്ഷണമേശ ഒരുക്കുന്നതിന് ദൈവത്തിന് കഴിയുമോ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അവിടന്ന് പാറയെ അടിച്ചു,","poem":1},{"text":"വെള്ളം പൊട്ടിപ്പുറപ്പെട്ടു","poem":2},{"lineBreak":true},{"text":"അരുവികൾ കവിഞ്ഞൊഴുകി, സത്യം,","poem":2},{"text":"എന്നാൽ ഞങ്ങൾക്കു ഭക്ഷണംകൂടി നൽകാൻ അവിടത്തേക്കു കഴിയുമോ?","poem":1},{"text":"അവിടത്തെ ജനത്തിനു മാംസം നൽകുമോ?”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"യഹോവ ഇതു കേട്ടപ്പോൾ രോഷാകുലനായി;","poem":1},{"text":"അവിടത്തെ കോപാഗ്നി യാക്കോബിനെതിരേയും","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ ക്രോധം ഇസ്രായേലിന്റെനേരേയും കത്തിജ്വലിച്ചു,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"അവർ ദൈവത്തിൽ വിശ്വസിക്കുകയോ","poem":1},{"text":"അവിടത്തെ കരുതലിൽ ആശ്രയിക്കുകയോ ചെയ്യാതിരുന്നതിനാൽത്തന്നെ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"എന്നിട്ടും അവിടന്ന് മീതേയുള്ള ആകാശത്തിന് ഒരു ആജ്ഞ കൊടുത്തു","poem":1},{"text":"ആകാശത്തിന്റെ കവാടങ്ങൾ തുറന്നു;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അവിടന്ന് ജനത്തിന് ആഹാരമായി മന്ന പൊഴിച്ചു,","poem":1},{"text":"സ്വർഗീയധാന്യം അവിടന്ന് അവർക്കു നൽകി.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"അവിടന്ന് അവർക്ക് സമൃദ്ധിയായി അയച്ചുകൊടുത്ത","poem":1},{"text":"ശക്തരുടെ ആഹാരം മനുഷ്യർ ആസ്വദിച്ചു.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"അവിടന്ന് ആകാശത്തിൽനിന്ന് കിഴക്കൻകാറ്റിനെ അഴിച്ചുവിട്ടു","poem":1},{"text":"അവിടത്തെ ശക്തിയാൽ തെക്കൻകാറ്റ് ആഞ്ഞുവീശുകയും ചെയ്തു.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"അവരുടെമേൽ അവിടന്ന് പൊടിപോലെ മാംസവും","poem":1},{"text":"കടൽത്തീരത്തെ മണൽത്തരിപോലെ പക്ഷികളെയും വർഷിപ്പിച്ചു.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"അവയെ അവരുടെ പാളയത്തിലേക്ക്,","poem":1},{"text":"അവരുടെ കൂടാരത്തിനുചുറ്റം പറന്നിറങ്ങുമാറാക്കി.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"മതിയാകുവോളം അവർ ഭക്ഷിച്ചു;","poem":1},{"text":"അവർ ആഗ്രഹിച്ചതുതന്നെ അവിടന്ന് അവർക്ക് നൽകി.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"എന്നാൽ അവർ ആഗ്രഹിച്ച ഭക്ഷണം ഭക്ഷിച്ചു തൃപ്തരാകുന്നതിനുമുമ്പ്,","poem":1},{"text":"അത് അവരുടെ വായിൽ ഇരിക്കുമ്പോൾത്തന്നെ,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ദൈവകോപം അവർക്കുനേരേ ജ്വലിച്ചു;","poem":1},{"text":"അവരിലെ കായബലമുള്ളവരെ മരണത്തിനേൽപ്പിച്ചു,","poem":2},{"lineBreak":true},{"text":"ഇസ്രായേലിലെ യുവനിരയെത്തന്നെ അവിടന്ന് ഛേദിച്ചുകളഞ്ഞു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"എന്നിട്ടുമവർ പാപത്തിൽത്തന്നെ തുടർന്നു;","poem":1},{"text":"അവിടത്തെ അത്ഭുതങ്ങൾ കണ്ടിട്ടും അവർ വിശ്വസിച്ചില്ല.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"അതിനാൽ അവരുടെ ആയുസ്സ് വ്യർഥമായി അവസാനിക്കുന്നതിനും","poem":1},{"text":"അവരുടെ സംവത്സരങ്ങൾ ഭീതിയിലാണ്ടുപോകുന്നതിനും അവിടന്ന് സംഗതിയാക്കി.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"എപ്പോഴൊക്കെ ദൈവം അവരെ സംഹരിച്ചോ, അപ്പോഴെല്ലാം അവർ അവിടത്തെ അന്വേഷിച്ചു;","poem":1},{"text":"വളരെ ഗൗരവതരമായിത്തന്നെ അവർ ദൈവത്തെ അന്വേഷിച്ചു.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ദൈവമായിരുന്നു തങ്ങളുടെ പാറ എന്നും","poem":1},{"text":"അത്യുന്നതനായ ദൈവമാണ് തങ്ങളുടെ വീണ്ടെടുപ്പുകാരൻ എന്നും അവർ ഓർത്തു.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"എന്നാൽ തങ്ങളുടെ വാകൊണ്ട് അവർ ദൈവത്തോട് മുഖസ്തുതി പറയുകയും","poem":1},{"text":"നാവുകൊണ്ട് അവർ അവിടത്തോടു വ്യാജം പറയുകയും ചെയ്യുന്നു;","poem":2}]},{"type":"verse","number":37,"content":[{"text":"അവരുടെ ഹൃദയം അവിടത്തോട് കൂറുപുലർത്തിയില്ല,","poem":1},{"text":"അവിടത്തെ ഉടമ്പടിയോട് അവർ വിശ്വസ്തരായിരുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"എന്നിട്ടും ദൈവം അവരോട് കരുണയുള്ളവനായിരുന്നു;","poem":1},{"text":"അവരുടെ അകൃത്യങ്ങൾ അവിടന്ന് ക്ഷമിച്ചു","poem":2},{"lineBreak":true},{"text":"അവിടന്ന് അവരെ നശിപ്പിച്ചതുമില്ല.","poem":2},{"text":"തന്റെ ക്രോധം മുഴുവനും ജ്വലിപ്പിക്കാതെ","poem":1},{"text":"പലപ്പോഴും തന്റെ കോപത്തെ അടക്കിക്കളഞ്ഞു.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"അവർ കേവലം മാംസംമാത്രം,","poem":1},{"text":"മടങ്ങിവരാത്തൊരു മന്ദമാരുതൻ എന്ന് അവിടന്ന് ഓർത്തു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"എത്രയോവട്ടം അവർ മരുഭൂമിയിൽവെച്ച് ദൈവത്തിനെതിരേ മത്സരിച്ചു","poem":1},{"text":"വിജനദേശത്തുവെച്ച് എത്രയോതവണ അവിടത്തെ ദുഃഖിപ്പിച്ചു!","poem":2}]},{"type":"verse","number":41,"content":[{"text":"അവർ വീണ്ടും വീണ്ടും ദൈവത്തെ പരീക്ഷിച്ചു;","poem":1},{"text":"ഇസ്രായേലിന്റെ പരിശുദ്ധനെ വിഷമിപ്പിച്ചു.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"അവിടത്തെ ശക്തി അവർ ഓർത്തില്ല—","poem":1},{"text":"പീഡകരിൽനിന്നും തങ്ങളെ വീണ്ടെടുത്ത ദിവസവും","poem":2}]},{"type":"verse","number":43,"content":[{"text":"ഈജിപ്റ്റിൽ അവിടന്നു ചെയ്ത ചിഹ്നങ്ങളും","poem":1},{"text":"സോവാൻ സമഭൂമിയിലെ അത്ഭുതങ്ങളും അവർ ഓർത്തില്ല.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"അവരുടെ നദികളെ അവിടന്ന് രക്തമാക്കി;","poem":1},{"text":"അവരുടെ അരുവികളിൽനിന്ന് അവർക്ക് കുടിക്കാൻ കഴിയാതെയുമായി.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"അവരെ വിഴുങ്ങിക്കളയേണ്ടതിന് അവിടന്ന് ഈച്ചകളുടെ കൂട്ടത്തെ അയച്ചു,","poem":1},{"text":"തവളക്കൂട്ടങ്ങൾ അവർക്കിടയിൽ നാശം വിതച്ചു.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"അവരുടെ കൃഷി അവിടന്ന് വിട്ടിലിന് ആഹാരമായും","poem":1},{"text":"അവരുടെ വിളകൾ വെട്ടുക്കിളികൾക്കും നൽകി.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"അവിടന്ന് അവരുടെ മുന്തിരിത്തലകൾ കന്മഴകൊണ്ടു നശിപ്പിക്കുകയും","poem":1},{"text":"അവരുടെ കാട്ടത്തികളെ ആലിപ്പഴംകൊണ്ടു മൂടുകയും ചെയ്തു.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"കന്മഴകൊണ്ട് അവരുടെ കന്നുകാലിക്കൂട്ടങ്ങളെ തകർത്തു,","poem":1},{"text":"അവരുടെ മൃഗസമ്പത്ത് ഇടിമിന്നലിന് ഇരയായി.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"അങ്ങയുടെ കോപം അവരുടെമേൽ ആളിക്കത്തി,","poem":1},{"text":"കുപിതനായ അങ്ങ് അവർക്കുനേരേ, ക്രോധം, അപമാനം, ശത്രുത,","poem":2},{"lineBreak":true},{"text":"എന്നിവയുടെ സംഹാരദൂതഗണത്തെ അഴിച്ചുവിട്ടു.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"അവിടന്ന് തന്റെ കോപത്തിനൊരു വഴിതുറന്നു;","poem":1},{"text":"അവരുടെ ജീവനെ മരണത്തിൽനിന്നു മാറ്റിനിർത്തിയില്ല,","poem":2},{"lineBreak":true},{"text":"എന്നാൽ അവരെ അവിടന്ന് മഹാമാരിക്ക് ഏൽപ്പിച്ചുകൊടുത്തു.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"ഈജിപ്റ്റിലെ","poem":1},{"noteId":74},{"text":"എല്ലാ ആദ്യജാതന്മാരെയും അവിടന്ന് സംഹരിച്ചു,","poem":1},{"text":"ഹാമിന്റെ കൂടാരങ്ങളിലെ പൗരുഷത്തിന്റെ പ്രഥമസന്തതികളെത്തന്നെ.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"എന്നാൽ അവിടന്ന് തന്റെ ജനത്തെ ആട്ടിൻപറ്റത്തെപ്പോലെ പുറപ്പെടുവിച്ചു;","poem":1},{"text":"മരുഭൂമിയിലൂടെ ആടുകളെയെന്നപോലെ അവിടന്ന് അവരെ നടത്തി.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"അവിടന്ന് അവരെ സുരക്ഷിതരായി നയിച്ചു, അതുകൊണ്ട് അവർക്ക് ഭയം ഉണ്ടായിരുന്നില്ല;","poem":1},{"text":"എന്നാൽ സമുദ്രം അവരുടെ ശത്രുക്കളെ വിഴുങ്ങിക്കളഞ്ഞു.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"അങ്ങനെ അവിടന്ന് അവരെ വിശുദ്ധനാടിന്റെ അതിരിലേക്ക് ആനയിച്ചു,","poem":1},{"text":"അവിടത്തെ വലതുകരം അധീനപ്പെടുത്തിയ മലനിരകളിലേക്കുതന്നെ.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"അവരുടെമുമ്പിലുണ്ടായിരുന്ന ജനതകളെ അവിടന്ന് തുരത്തിയോടിച്ചു","poem":1},{"text":"അവരുടെ ദേശത്തെ ഒരവകാശമായി അവർക്ക് അളന്നുകൊടുത്തു;","poem":2},{"lineBreak":true},{"text":"ഇസ്രായേൽ ഗോത്രങ്ങൾക്ക് അവരുടെ ഭവനങ്ങളിൽ വാസമുറപ്പിച്ചുകൊടുത്തു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":56,"content":[{"text":"എങ്കിലും അവർ ദൈവത്തെ പരീക്ഷിച്ചു","poem":1},{"text":"അത്യുന്നതനെതിരേ മത്സരിച്ചു;","poem":2},{"lineBreak":true},{"text":"അവർ അവിടത്തെ നിയമവ്യവസ്ഥകൾ പിൻതുടർന്നതുമില്ല.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"അവരുടെ പൂർവികരെപ്പോലെ അവർ വിശ്വാസഘാതകരായി പിന്തിരിഞ്ഞു","poem":1},{"text":"കോട്ടമുള്ള വില്ലുപോലെ അവർ വഞ്ചകരായിത്തീർന്നു.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"തങ്ങളുടെ ക്ഷേത്രങ്ങൾകൊണ്ട് അവർ അവിടത്തെ പ്രകോപിപ്പിച്ചു;","poem":1},{"text":"തങ്ങളുടെ വിഗ്രഹങ്ങളാൽ അവർ അവിടത്തെ അസഹിഷ്ണുതയുള്ളവനാക്കി.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"ദൈവം ഇതു കേട്ടു, കോപംകൊണ്ടുനിറഞ്ഞു;","poem":1},{"text":"ഇസ്രായേലിനെ നിശ്ശേഷം തള്ളിക്കളഞ്ഞു.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"അവിടന്ന് ശീലോവിലെ സമാഗമകൂടാരത്തെ ഉപേക്ഷിച്ചു,","poem":1},{"text":"അവിടന്ന് മനുഷ്യരുടെയിടയിൽ സ്ഥാപിച്ച കൂടാരത്തെത്തന്നെ.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"അവിടന്ന് തന്റെ ശക്തിയുടെ പ്രതീകമായ കൂടാരത്തെ പ്രവാസത്തിലേക്കും","poem":1},{"text":"തന്റെ മഹത്ത്വത്തെ ശത്രുവിന്റെ കരങ്ങളിലേക്കും ഏൽപ്പിച്ചുകൊടുത്തു.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"സ്വജനത്തെ അവിടന്ന് വാൾത്തലയ്ക്ക് വിട്ടുകൊടുത്തു;","poem":1},{"text":"അവിടന്ന് തന്റെ അവകാശത്തോട് രോഷാകുലനായി.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"അവരുടെ യുവാക്കന്മാരെ അഗ്നി വിഴുങ്ങിക്കളഞ്ഞു,","poem":1},{"text":"അവരുടെ യുവതികൾക്ക് വിവാഹഗീതങ്ങൾ ഉണ്ടായതുമില്ല;","poem":2}]},{"type":"verse","number":64,"content":[{"text":"അവരുടെ പുരോഹിതന്മാർ വാളിനിരയായി,","poem":1},{"text":"അവരുടെ വിധവമാർക്കു വിലപിക്കാൻ കഴിഞ്ഞതുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":65,"content":[{"text":"അപ്പോൾ കർത്താവ് തന്റെ നിദ്രവിട്ടുണർന്നു,","poem":1},{"text":"മദ്യലഹരിവിട്ട് ഒരു യോദ്ധാവ് ഉണരുന്നതുപോലെതന്നെ.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"അവിടന്ന് തന്റെ ശത്രുക്കൾക്ക് തിരിച്ചടിനൽകി;","poem":1},{"text":"അവരെ എന്നെന്നേക്കുമായി ലജ്ജയിലേക്കു തള്ളിവിട്ടു.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"എന്നാൽ അവിടന്ന് യോസേഫിന്റെ കൂടാരത്തെ ഉപേക്ഷിച്ചു,","poem":1},{"text":"എഫ്രയീംഗോത്രത്തെ തെരഞ്ഞെടുത്തതുമില്ല;","poem":2}]},{"type":"verse","number":68,"content":[{"text":"എന്നാൽ അവിടന്ന് യെഹൂദാഗോത്രത്തെ,","poem":1},{"text":"താൻ സ്നേഹിക്കുന്ന സീയോൻപർവതത്തെ തെരഞ്ഞെടുത്തു.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"അവിടന്ന് തന്റെ തിരുനിവാസം അത്യുന്നതങ്ങളെപ്പോലെ സ്ഥാപിച്ചു,","poem":1},{"text":"താൻ എന്നേക്കുമായി സ്ഥാപിച്ച ഭൂമിയെ എന്നപോലെതന്നെ.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"അവിടന്ന് തന്റെ ദാസനായ ദാവീദിനെ തെരഞ്ഞെടുത്തു,","poem":1},{"text":"ആട്ടിൻതൊഴുത്തിൽനിന്നുതന്നെ അദ്ദേഹത്തെ എടുത്തു;","poem":2}]},{"type":"verse","number":71,"content":[{"text":"ആടുകളെ വളർത്തുന്നതിൽനിന്ന് അദ്ദേഹത്തെ കൂട്ടിക്കൊണ്ടുവന്നു,","poem":1},{"text":"തന്റെ ജനമായ യാക്കോബിന്,","poem":2},{"lineBreak":true},{"text":"തന്റെ അവകാശമായ ഇസ്രായേലിന് ഇടയനായിരിക്കുന്നതിനുവേണ്ടിത്തന്നെ.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"ഹൃദയപരമാർഥതയോടെ അദ്ദേഹം അവരെ മേയിച്ചു;","poem":1},{"text":"കരവിരുതോടെ അദ്ദേഹം അവരെ നയിച്ചു.","poem":2}]}],"footnotes":[{"noteId":74,"caller":"+","text":"മൂ.ഭാ. ഹാമിന്റെ കൂടാരത്തിലുള്ള","reference":{"chapter":78,"verse":51}}]},"thisChapterLink":"/api/mal_bib/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":72}