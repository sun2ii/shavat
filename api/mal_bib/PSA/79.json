{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":79,"content":[{"type":"hebrew_subtitle","content":["ആസാഫിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"ദൈവമേ, ഇതര ജനതകൾ അവിടത്തെ ഓഹരി പിടിച്ചടക്കിയിരിക്കുന്നു;","poem":1},{"text":"അവർ അങ്ങയുടെ വിശുദ്ധമന്ദിരത്തെ അശുദ്ധമാക്കിയിരിക്കുന്നു","poem":2},{"lineBreak":true},{"text":"ജെറുശലേമിനെ അവർ ഒരു കൽക്കൂമ്പാരമായി മാറ്റിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അങ്ങയുടെ സേവകരുടെ ശവശരീരങ്ങൾ","poem":1},{"text":"ആകാശത്തിലെ പക്ഷികൾക്ക് ഇരയായി നൽകിയിരിക്കുന്നു,","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ വിശുദ്ധജനത്തിന്റെ മാംസം ഭൂമിയിലെ വന്യമൃഗങ്ങൾക്കും.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ജെറുശലേമിനുചുറ്റും","poem":1},{"text":"അവർ വെള്ളംപോലെ രക്തപ്പുഴ ഒഴുക്കി,","poem":2},{"lineBreak":true},{"text":"മരിച്ചവരെ സംസ്കരിക്കാൻ ആരും അവശേഷിക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ഞങ്ങളുടെ അയൽവാസികൾക്ക് ഞങ്ങൾ അധിക്ഷേപത്തിന്റെ ഇരയായി,","poem":1},{"text":"ചുറ്റുപാടുമുള്ളവർക്ക് ഞങ്ങൾ അവജ്ഞയും അപഹാസവും ആയിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ഇനിയും എത്രനാൾ, യഹോവേ? അങ്ങ് എന്നേക്കും ക്രോധാകുലനായിരിക്കുമോ?","poem":1},{"text":"അങ്ങയുടെ അസഹിഷ്ണുത അഗ്നിപോലെ ഞങ്ങൾക്കെതിരായി എത്രകാലം ജ്വലിക്കും?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവിടത്തെ അംഗീകരിക്കാത്ത ജനതകളുടെമേലും","poem":1},{"text":"അവിടത്തെ നാമം വിളിച്ചപേക്ഷിക്കാത്ത","poem":2},{"text":"രാജ്യങ്ങളുടെമേലും","poem":1},{"text":"അവിടത്തെ ക്രോധം ചൊരിയണമേ;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"കാരണം അവർ യാക്കോബിനെ വിഴുങ്ങുകയും","poem":1},{"text":"അവന്റെ സ്വദേശത്തെ നശിപ്പിക്കുകയും ചെയ്തിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ഞങ്ങളുടെ പൂർവികരുടെ പാപം ഞങ്ങൾക്കെതിരേ കണക്കാക്കരുതേ;","poem":1},{"text":"അവിടത്തെ കരുണ അതിവേഗം ഞങ്ങളെ സന്ദർശിക്കണമേ,","poem":2},{"lineBreak":true},{"text":"ഞങ്ങൾ അതിതീക്ഷ്ണമായ ആവശ്യത്തിൽ ആയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഞങ്ങളുടെ രക്ഷയായ ദൈവമേ,","poem":1},{"text":"അവിടത്തെ നാമമഹത്ത്വത്തിനായി ഞങ്ങളെ സഹായിക്കണമേ;","poem":2},{"text":"അവിടത്തെ നാമംനിമിത്തം","poem":1},{"text":"ഞങ്ങളെ വിടുവിക്കുകയും ഞങ്ങളുടെ പാപങ്ങൾ ക്ഷമിക്കുകയും ചെയ്യണമേ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"രാഷ്ട്രങ്ങളെക്കൊണ്ട് “അവരുടെ ദൈവം എവിടെ,”","poem":1},{"text":"എന്നു ചോദിപ്പിക്കുന്നതെന്തിന്?","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ സേവകരുടെ രക്തംചൊരിഞ്ഞതിനുള്ള പ്രതികാരം","poem":1},{"text":"ഞങ്ങളുടെ കണ്ണുകൾക്കു മുമ്പിൽവെച്ചുതന്നെ രാഷ്ട്രങ്ങൾക്കിടയിൽ അവിടന്ന് നടപ്പിലാക്കണമേ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ബന്ധിതരുടെ ഞരക്കം തിരുമുമ്പിൽ വരുമാറാകട്ടെ;","poem":1},{"text":"മരണശിക്ഷയ്ക്കു വിധിക്കപ്പെട്ടവരെ അവിടത്തെ കൈകളുടെ ശക്തിയാൽ സ്വതന്ത്രരാക്കണമേ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"കർത്താവേ, ഞങ്ങളുടെ അയൽവാസികൾ അങ്ങേക്കെതിരായി നടത്തിയ അധിക്ഷേപങ്ങൾക്കുള്ള ശിക്ഷ","poem":1},{"text":"ഏഴിരട്ടിയായി അവരുടെ മാർവിടത്തിലേക്കുതന്നെ നൽകണമേ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അപ്പോൾ അവിടത്തെ ജനമായ ഞങ്ങൾ—അങ്ങയുടെ മേച്ചിൽപ്പുറത്തെ ആട്ടിൻപറ്റം—","poem":1},{"text":"അങ്ങയെ നിത്യം സ്തുതിക്കും;","poem":2},{"text":"ഞങ്ങൾ അവിടത്തെ സ്തുതി","poem":1},{"text":"തലമുറതലമുറകളോളം പ്രസ്താവിക്കും.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}