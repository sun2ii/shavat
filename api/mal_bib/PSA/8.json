{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":8,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"ഞങ്ങളുടെ കർത്താവായ യഹോവേ,","poem":1},{"text":"അവിടത്തെ നാമം സർവഭൂമിയിലും എത്രമഹനീയം!","poem":2},{"lineBreak":true},{"text":"അങ്ങയുടെ മഹത്ത്വം അവിടന്ന്","poem":1},{"text":"ആകാശത്തിൽ സ്ഥാപിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ശിശുക്കളുടെയും മുലകുടിക്കുന്നവരുടെയും സ്തുതികളിൽ","poem":1},{"noteId":12},{"text":"അവിടത്തെ ശത്രുക്കൾക്കെതിരേ ഒരു കോട്ട പണിതിരിക്കുന്നു","poem":2},{"lineBreak":true},{"text":"വൈരികളെയും പ്രതികാരദാഹികളെയും നിശ്ശബ്ദരാക്കുന്നതിനുതന്നെ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവിടത്തെ വിരലുകളുടെ പണിയായ","poem":1},{"text":"ആകാശം,","poem":2},{"text":"അങ്ങു സ്ഥാപിച്ച","poem":1},{"text":"ചന്ദ്രൻ, നക്ഷത്രങ്ങൾ എന്നിവയെ നോക്കുമ്പോൾ,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവിടത്തെ പരിഗണനയിൽ വരാൻമാത്രം മാനവവംശം എന്തുള്ളൂ,","poem":1},{"text":"അങ്ങയുടെ കരുതൽ ലഭിക്കാൻ മനുഷ്യപുത്രൻ എന്തുമാത്രം?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"അങ്ങ് അവരെ","poem":1},{"noteId":13},{"text":"ദൂതന്മാരെക്കാൾ","poem":1},{"noteId":14},{"text":"അൽപ്പംമാത്രം താഴ്ത്തി;","poem":1},{"text":"തേജസ്സും ബഹുമാനവും അവരെ","poem":2},{"noteId":15},{"text":"മകുടമായി അണിയിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവിടത്തെ കൈവേലകളുടെമേൽ അങ്ങേക്ക് ആധിപത്യം നൽകി;","poem":1},{"text":"സകലതും അവിടത്തെ കാൽക്കീഴാക്കിയിരിക്കുന്നു—","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ആടുകൾ, കന്നുകാലികൾ,","poem":1},{"text":"കാട്ടിലെ സകലമൃഗങ്ങൾ,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ആകാശത്തിലെ പറവകൾ,","poem":1},{"text":"സമുദ്രത്തിലെ മത്സ്യങ്ങൾ,","poem":2},{"lineBreak":true},{"text":"സമുദ്രമാർഗേ ചരിക്കുന്ന എല്ലാറ്റിനെയുംതന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ഞങ്ങളുടെ കർത്താവായ യഹോവേ,","poem":1},{"text":"അവിടത്തെ നാമം സർവഭൂമിയിലും എത്രമഹനീയം!","poem":2}]}],"footnotes":[{"noteId":12,"caller":"+","text":"ഗ്രീക്കു കൈ.പ്ര. നാവുകൾ വാഴ്ത്തിപ്പാടുന്നു. മത്താ. 21:16കാണുക.","reference":{"chapter":8,"verse":2}},{"noteId":13,"caller":"+","text":"അഥവാ, മനുഷ്യപുത്രനെ","reference":{"chapter":8,"verse":5}},{"noteId":14,"caller":"+","text":"അഥവാ, ദൈവത്തെക്കാൾ","reference":{"chapter":8,"verse":5}},{"noteId":15,"caller":"+","text":"അഥവാ, അവനെ","reference":{"chapter":8,"verse":5}}]},"thisChapterLink":"/api/mal_bib/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}