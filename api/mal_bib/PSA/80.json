{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":80,"content":[{"type":"hebrew_subtitle","content":["ആസാഫിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"യോസേഫിനെ ആട്ടിൻകൂട്ടത്തെപ്പോലെ നയിക്കുന്ന","poem":1},{"text":"ഇസ്രായേലിന്റെ ഇടയനേ, കേൾക്കണമേ.","poem":2},{"text":"കെരൂബുകളിൻമീതേ സിംഹാസനസ്ഥനായവനേ,","poem":1},{"text":"പ്രകാശിക്കണമേ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"എഫ്രയീമിന്റെയും ബെന്യാമീന്റെയും മനശ്ശെയുടെയും മുന്നിൽത്തന്നെ.","poem":2},{"text":"അങ്ങയുടെ ശക്തി ഉണർത്തണമേ;","poem":1},{"text":"ഞങ്ങളുടെ രക്ഷയ്ക്കായി വരണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ദൈവമേ, ഞങ്ങളെ പുനരുദ്ധരിക്കണമേ;","poem":1},{"text":"ഞങ്ങൾ രക്ഷപ്പെടുന്നതിനുവേണ്ടി,","poem":2},{"lineBreak":true},{"text":"തിരുമുഖം ഞങ്ങളുടെമേൽ പ്രകാശിപ്പിക്കണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"സൈന്യങ്ങളുടെ ദൈവമായ യഹോവേ, ഇനിയും എത്രനാൾ,","poem":1},{"text":"അങ്ങയുടെ ജനത്തിന്റെ പ്രാർഥനയ്ക്കെതിരേ","poem":2},{"lineBreak":true},{"text":"അങ്ങയുടെ കോപം പുകഞ്ഞുകൊണ്ടിരിക്കും?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അങ്ങ് കണ്ണീരിന്റെ അപ്പം അവർക്ക് ഭക്ഷിക്കാൻ നൽകി;","poem":1},{"text":"കുടിക്കുന്നതിനായി അവരുടെ പാത്രത്തിൽ നിറച്ചിരിക്കുന്നതും കണ്ണീർതന്നെ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവിടന്ന് ഞങ്ങളെ അയൽവാസികൾക്ക് ഒരു കലഹകാരണമാക്കിയിരിക്കുന്നു,","poem":1},{"text":"ഞങ്ങളുടെ ശത്രുക്കൾ ഞങ്ങളെ പരിഹസിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"സൈന്യങ്ങളുടെ ദൈവമേ, ഞങ്ങളെ പുനരുദ്ധരിക്കണമേ;","poem":1},{"text":"ഞങ്ങൾ രക്ഷപ്പെടുന്നതിനുവേണ്ടി,","poem":2},{"lineBreak":true},{"text":"തിരുമുഖം ഞങ്ങളുടെമേൽ പ്രകാശിപ്പിക്കണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"അങ്ങ് ഈജിപ്റ്റിൽനിന്ന് ഒരു മുന്തിരിവള്ളി പറിച്ചുനട്ടിരിക്കുന്നു;","poem":1},{"text":"അവിടന്ന് രാഷ്ട്രങ്ങളെ തുരത്തിയോടിച്ച് അതിനെ നട്ടിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അതിനായി അങ്ങ് നിലമൊരുക്കി,","poem":1},{"text":"അതു വേരൂന്നി ദേശത്തെല്ലാം പടർന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അതിന്റെ നിഴൽ പർവതങ്ങളെ ആവരണംചെയ്തു,","poem":1},{"text":"അതിന്റെ ശാഖകൾ വൻ ദേവദാരുക്കളെ മൂടുകയും ചെയ്തു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അതിന്റെ ശാഖകൾ മെഡിറ്ററേനിയൻകടലോരംവരെ നീട്ടിയിരിക്കുന്നു,","poem":1},{"text":"അതിന്റെ ചില്ലകൾ യൂഫ്രട്ടീസ് നദിവരെയും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"വഴിപോക്കരെല്ലാം അതിന്റെ കുലകൾ പറിച്ചെടുക്കാൻ പാകത്തിന്","poem":1},{"text":"അങ്ങ് അതിന്റെ മതിലുകൾ തകർത്തത് എന്തിന്?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"കാട്ടുപന്നികൾ വന്ന് അതിനെ നശിപ്പിക്കുകയും","poem":1},{"text":"വയലിലെ മൃഗങ്ങൾ അവ തിന്നുകളയുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"സൈന്യങ്ങളുടെ ദൈവമേ, ഞങ്ങളിലേക്കു മടങ്ങിവരണമേ!","poem":1},{"text":"സ്വർഗത്തിൽനിന്ന് നോക്കി കടാക്ഷിക്കണമേ!","poem":2},{"text":"അവിടത്തെ വലതുകരംതന്നെ നട്ട","poem":1}]},{"type":"verse","number":15,"content":[{"text":"ഈ വേരിനെ, അവിടത്തെ വലങ്കൈതന്നെ വളർത്തിയെടുത്ത","poem":2},{"lineBreak":true},{"text":"ഈ മുന്തിരിവള്ളിയെ","poem":2},{"noteId":75},{"text":"കാത്തുസൂക്ഷിക്കണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"അവിടത്തെ മുന്തിരിവള്ളിയെ വെട്ടിവീഴ്ത്തിയിരിക്കുന്നു, അതിനെ തീവെച്ചു നശിപ്പിച്ചിരിക്കുന്നു;","poem":1},{"text":"അവിടത്തെ ശാസനയാൽ അങ്ങയുടെ ജനം നശിക്കുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അങ്ങയുടെ കരം അവിടത്തെ വലതുഭാഗത്തെ പുരുഷന്റെമേൽ വെക്കണമേ,","poem":1},{"text":"അങ്ങേക്കുവേണ്ടി അങ്ങ് ശക്തിപ്പെടുത്തിയ മനുഷ്യപുത്രന്റെമേൽത്തന്നെ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അപ്പോൾ ഞങ്ങൾ അങ്ങയെവിട്ട് പിന്തിരിയുകയില്ല;","poem":1},{"text":"ഞങ്ങളെ പുനരുജ്ജീവിപ്പിക്കണമേ, അങ്ങനെ ഞങ്ങൾ തിരുനാമം വിളിച്ചപേക്ഷിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"സൈന്യങ്ങളുടെ ദൈവമായ യഹോവേ, ഞങ്ങളെ പുനരുദ്ധരിക്കണമേ;","poem":1},{"text":"ഞങ്ങൾ രക്ഷപ്പെടുന്നതിനുവേണ്ടി,","poem":2},{"lineBreak":true},{"text":"തിരുമുഖം ഞങ്ങളുടെമേൽ പ്രകാശിപ്പിക്കണമേ.","poem":2}]}],"footnotes":[{"noteId":75,"caller":"+","text":"അഥവാ, പുത്രനെ","reference":{"chapter":80,"verse":15}}]},"thisChapterLink":"/api/mal_bib/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}