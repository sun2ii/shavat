{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":81,"content":[{"type":"hebrew_subtitle","content":["ആസാഫിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"നമ്മുടെ ബലമായ ദൈവത്തിന് ആനന്ദഗീതമാലപിക്കുക;","poem":1},{"text":"യാക്കോബിന്റെ ദൈവത്തിന് ആർപ്പിടുക!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"തപ്പുകൊട്ടിയും ഇമ്പസ്വരമുള്ള കിന്നരവും വീണയും വായിച്ചും","poem":1},{"text":"സംഗീതം തുടങ്ങുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"അമാവാസിയിലും പൗർണമിനാളിലുമുള്ള നമ്മുടെ ഉത്സവദിനങ്ങളിലും","poem":1},{"text":"കോലാട്ടിൻകൊമ്പിനാൽ തീർത്ത കാഹളം മുഴക്കുക;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ഇത് അവിടന്ന് ഇസ്രായേലിനു നൽകിയ ഉത്തരവും","poem":1},{"text":"യാക്കോബിൻ ദൈവത്തിനൊരു അനുഷ്ഠാനവും ആകുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ദൈവം ഈജിപ്റ്റിനെതിരേ പുറപ്പെട്ടപ്പോൾ,","poem":1},{"text":"അവിടന്ന് ഇത് ഒരു നിയമമായി യോസേഫിന് സ്ഥാപിച്ചുകൊടുത്തു.","poem":2},{"lineBreak":true},{"text":"അവിടെ ഞാൻ അപരിചിതമായ ഒരു ശബ്ദം കേട്ടു, അത് ഇപ്രകാരമായിരുന്നു:","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“അവരുടെ തോളുകളിൽനിന്ന് ഞാൻ ഭാരമിറക്കിവെച്ചു;","poem":1},{"text":"അവരുടെ കരങ്ങൾ കുട്ടകൾ വിട്ട് സ്വതന്ത്രമായിത്തീർന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"നിങ്ങളുടെ ദുരിതത്തിൽ നിങ്ങൾ നിലവിളിച്ചു, ഞാൻ നിങ്ങളെ മോചിപ്പിച്ചു,","poem":1},{"text":"ഇടിമുഴക്കത്തിൽനിന്ന് ഞാൻ നിങ്ങൾക്ക് ഉത്തരമരുളി;","poem":2},{"lineBreak":true},{"text":"മെരീബയിലെ ജലാശയത്തിനരികെവെച്ച് ഞാൻ നിങ്ങളെ പരീക്ഷിച്ചു. സേലാ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"എന്റെ ജനമേ, ശ്രദ്ധിക്കുക, ഞാൻ നിങ്ങൾക്കു മുന്നറിയിപ്പുനൽകുന്നു—","poem":1},{"text":"ഇസ്രായേലേ, നിങ്ങൾ എന്റെ വാക്ക് കേട്ടെങ്കിൽ കൊള്ളാമായിരുന്നു!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"നിങ്ങളുടെ ഇടയിൽ അന്യദേവൻ ഉണ്ടാകരുത്;","poem":1},{"text":"ഒരു അന്യദേവന്റെയും മുമ്പാകെ നിങ്ങൾ വണങ്ങരുത്.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"നിങ്ങളെ ഈജിപ്റ്റിൽനിന്ന് കൊണ്ടുവന്ന","poem":1},{"text":"നിങ്ങളുടെ ദൈവമായ യഹോവ ഞാൻ ആകുന്നു.","poem":2},{"text":"നിങ്ങളുടെ വായ് വിസ്താരത്തിൽ തുറക്കുക; ഞാൻ അതു നിറയ്ക്കും.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“എന്നാൽ എന്റെ ജനം ഞാൻ പറയുന്നത് ശ്രദ്ധിക്കുന്നില്ല;","poem":1},{"text":"ഇസ്രായേൽ എനിക്കു കീഴടങ്ങിയിരിക്കുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവർ അവരുടേതായ പദ്ധതികൾക്കനുസൃതമായി ജീവിക്കുന്നതിന്","poem":1},{"text":"ഞാൻ അവരെ ഹൃദയകാഠിന്യത്തിന് ഏൽപ്പിച്ചു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“എന്റെ ജനം എന്റെ വാക്ക് കേട്ടിരുന്നെങ്കിൽ,","poem":1},{"text":"ഇസ്രായേൽ എന്റെ വഴികളിൽ നടന്നിരുന്നെങ്കിൽ,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ഞാൻ അവരുടെ ശത്രുക്കളെ അതിവേഗം കീഴടക്കുമായിരുന്നു!","poem":1},{"text":"എന്റെ കൈ അവരുടെ വൈരികൾക്കെതിരേ തിരിക്കുമായിരുന്നു!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"യഹോവയെ വെറുക്കുന്നവർ അവിടത്തെ കാൽക്കൽവീണു കെഞ്ചുമായിരുന്നു,","poem":1},{"text":"അവരുടെ ശിക്ഷ എന്നെന്നേക്കും നിലനിൽക്കുമായിരുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"എന്നാൽ ഏറ്റവും മേൽത്തരമായ ഗോതമ്പുകൊണ്ട് ഞാൻ നിങ്ങളെ പരിപോഷിപ്പിക്കുമായിരുന്നു;","poem":1},{"text":"പാറയിൽനിന്നുള്ള തേൻകൊണ്ട് ഞാൻ നിങ്ങളെ തൃപ്തരാക്കുമായിരുന്നു.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}