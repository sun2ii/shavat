{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":83,"content":[{"type":"hebrew_subtitle","content":["ആസാഫിന്റെ ഒരു സങ്കീർത്തനം; ഒരു ഗീതം."]},{"type":"verse","number":1,"content":[{"text":"ദൈവമേ, മൗനമായിരിക്കരുതേ;","poem":1},{"text":"ദൈവമേ, അവിടന്ന് ചെവി അടച്ചും","poem":2},{"lineBreak":true},{"text":"നിഷ്ക്രിയനായും ഇരിക്കരുതേ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ഇതാ! അങ്ങയുടെ ശത്രുക്കൾ ഗർജിക്കുന്നു,","poem":1},{"text":"അങ്ങയെ വെറുക്കുന്നവർ തല ഉയർത്തുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അങ്ങയുടെ ജനത്തിനെതിരേ അവർ കുടിലതന്ത്രങ്ങൾ മെനയുന്നു;","poem":1},{"text":"അങ്ങയുടെ പരിലാളനയിലിരിക്കുന്നവർക്കെതിരേ ഗൂഢാലോചന നടത്തുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“വരിക,” അവർ പറയുന്നു, “അവർ ഒരു രാഷ്ട്രമായിരിക്കാതവണ്ണം നമുക്കവരെ തുടച്ചുനീക്കാം,","poem":1},{"text":"ഇസ്രായേൽ എന്ന പേര് ഇനി ഒരിക്കലും ഓർക്കാതിരിക്കട്ടെ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"അവർ ഏകമനസ്സോടെ ഗൂഢാലോചന നടത്തുന്നു;","poem":1},{"text":"അവർ അവിടത്തേക്കെതിരായി ഒരു സഖ്യം രൂപപ്പെടുത്തുന്നു—","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഏദോമ്യരുടെയും യിശ്മായേല്യരുടെയും","poem":1},{"text":"മോവാബ്യരുടെയും ഹഗര്യരുടെയും കൂടാരങ്ങളും,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ഗിബാൽ, അമ്മോൻ, അമാലേക്ക്,","poem":1},{"text":"സോർ നിവാസികളോടുകൂടെ ഫെലിസ്ത്യദേശവും","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അശ്ശൂരും അവരോടൊപ്പംചേർന്ന്","poem":1},{"text":"ലോത്തിന്റെ പിൻതലമുറയ്ക്ക് ശക്തിനൽകുന്നു. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"അങ്ങ് മിദ്യാന്യരോട് ചെയ്തതുപോലെ അവരോടും ചെയ്യണമേ,","poem":1},{"text":"കീശോൻ നദിക്കരികെവെച്ച് സീസെരയോടും യാബീനോടും അങ്ങു പ്രവർത്തിച്ചതുപോലെതന്നെ,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവർ എൻ-ദോരിൽവെച്ച് തകർന്നടിഞ്ഞ്","poem":1},{"text":"മണ്ണിനു വളമായിത്തീർന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അവരിൽ ശക്തരായവരെ ഓരേബ്, സേബ് എന്നിവരെപ്പോലെയും","poem":1},{"text":"അവരിലെ പ്രഭുക്കളെ സേബഹ്, സൽമുന്ന എന്നിവരെപ്പോലെയും ആക്കണമേ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“ദൈവത്തിന്റെ മേച്ചിൽപ്പുറങ്ങളെ","poem":1},{"text":"നമുക്കു കൈവശമാക്കാം,” എന്ന് അവർ പറഞ്ഞല്ലോ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"എന്റെ ദൈവമേ, അവരെ ചുഴലിക്കാറ്റിലെ പൊടിപോലെയും","poem":1},{"text":"കാറ്റിൽ പറക്കുന്ന പതിരുപോലെയും ആക്കണമേ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"വനത്തെ ദഹിപ്പിക്കുന്ന അഗ്നിപോലെയോ","poem":1},{"text":"പർവതങ്ങളെ ജ്വലിപ്പിക്കുന്ന ജ്വാലപോലെയോ","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവിടത്തെ കൊടുങ്കാറ്റ് അവരെ പിൻതുടരുകയും","poem":1},{"text":"അവിടത്തെ ചുഴലിക്കാറ്റിനാൽ അവരെ ഭയപ്പെടുത്തുകയും ചെയ്യണമേ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"യഹോവേ, അവിടത്തെ നാമം അന്വേഷിക്കുന്നതിന്","poem":1},{"text":"അവരുടെ മുഖം ലജ്ജയാൽ മൂടണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"അവർ എന്നേക്കും ലജ്ജിതരാകുകയും ഭ്രമിക്കുകയും ചെയ്യട്ടെ.","poem":1},{"text":"അവർ അപമാനഭാരത്താൽ നശിക്കട്ടെ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"സർവഭൂമിക്കും അത്യുന്നതനായവൻ അവിടന്നുമാത്രമാണ് എന്നും","poem":1},{"text":"അവിടത്തെ നാമം യഹോവ എന്ന് ആകുന്നു എന്നും അവർ അറിയട്ടെ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}