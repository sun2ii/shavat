{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":84,"content":[{"type":"hebrew_subtitle","content":["കോരഹ് പുത്രന്മാരുടെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"സൈന്യങ്ങളുടെ യഹോവേ,","poem":1},{"text":"തിരുനിവാസം എത്ര മനോഹരം!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"യഹോവയുടെ ആലയാങ്കണം വാഞ്ഛിച്ച്","poem":1},{"text":"എന്റെ പ്രാണൻ തളരുന്നു;","poem":2},{"text":"എന്റെ ഹൃദയവും എന്റെ ശരീരവും","poem":1},{"text":"ജീവനുള്ള ദൈവത്തിന് ആനന്ദകീർത്തനം ആലപിക്കുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"കുരികിൽ ഒരു വീടും","poem":1},{"text":"മീവൽപ്പക്ഷി കുഞ്ഞുങ്ങൾക്ക്","poem":2},{"lineBreak":true},{"text":"ഒരു കൂടും കണ്ടെത്തിയിരിക്കുന്നു—","poem":2},{"text":"എന്റെ രാജാവും എന്റെ ദൈവവുമായ സൈന്യങ്ങളുടെ യഹോവേ","poem":1},{"text":"അങ്ങയുടെ യാഗപീഠത്തിനരികെതന്നെ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അങ്ങയുടെ ആലയത്തിൽ വസിക്കുന്നവർ അനുഗൃഹീതർ;","poem":1},{"text":"അവർ അങ്ങയെ നിരന്തരം സ്തുതിച്ചുകൊണ്ടിരിക്കും. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ബലം അങ്ങയിലുള്ള മനുഷ്യർ അനുഗൃഹീതർ,","poem":1},{"text":"അവരുടെ ഹൃദയത്തിൽ സീയോനിലേക്കുള്ള രാജവീഥികളുണ്ട്.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"കണ്ണുനീർ","poem":1},{"noteId":76},{"text":"താഴ്വരയിലൂടെ കടന്നുപോകുമ്പോൾ,","poem":1},{"text":"അവിടന്ന് അതിനെ ഒരു നീരുറവയാക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"മുന്മഴയാൽ അതിനെ അനുഗ്രഹപൂർണമാക്കുന്നു.","poem":2},{"noteId":77}]},{"type":"verse","number":7,"content":[{"text":"അവർ ഓരോരുത്തരും സീയോനിൽ ദൈവസന്നിധിയിൽ എത്തുന്നതുവരെ,","poem":1},{"text":"ബലത്തിനുമേൽ ബലം ആർജിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"സൈന്യങ്ങളുടെ ദൈവമായ യഹോവേ, എന്റെ പ്രാർഥന കേൾക്കണമേ;","poem":1},{"text":"യാക്കോബിന്റെ ദൈവമേ, ശ്രദ്ധിക്കണമേ. സേലാ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഞങ്ങളുടെ പരിചയായ","poem":1},{"noteId":78},{"text":"ദൈവമേ, നോക്കണമേ;","poem":1},{"text":"അങ്ങയുടെ അഭിഷിക്തന്റെ മുഖത്തെ കടാക്ഷിക്കണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"അങ്ങയുടെ ആലയാങ്കണത്തിലെ ഒരു ദിവസം","poem":1},{"text":"വേറെ ആയിരം ദിവസങ്ങളെക്കാൾ ശ്രേഷ്ഠമല്ലോ;","poem":2},{"text":"ദുഷ്ടരുടെ കൂടാരങ്ങളിൽ വസിക്കുന്നതിനെക്കാൾ,","poem":1},{"text":"എന്റെ ദൈവത്തിന്റെ ആലയത്തിൽ വാതിൽകാവൽക്കാരൻ ആകുന്നതാണ് എന്റെ അഭിലാഷം.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"കാരണം യഹോവയായ ദൈവം സൂര്യനും പരിചയും ആകുന്നു;","poem":1},{"text":"യഹോവ കൃപയും മഹത്ത്വവും നൽകുന്നു;","poem":2},{"text":"നിഷ്കളങ്കതയോടെ ജീവിക്കുന്നവർക്ക്","poem":1},{"text":"അവിടന്ന് ഒരു നന്മയും മുടക്കുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"സൈന്യങ്ങളുടെ യഹോവേ,","poem":1},{"text":"അങ്ങയിൽ ആശ്രയിക്കുന്നവർ അനുഗൃഹീതർ.","poem":2}]}],"footnotes":[{"noteId":76,"caller":"+","text":"മൂ.ഭാ. ബാഖാ","reference":{"chapter":84,"verse":6}},{"noteId":77,"caller":"+","text":"അഥവാ, ജലാശയമാക്കുന്നു","reference":{"chapter":84,"verse":6}},{"noteId":78,"caller":"+","text":"അഥവാ, ശക്തനായ","reference":{"chapter":84,"verse":9}}]},"thisChapterLink":"/api/mal_bib/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}