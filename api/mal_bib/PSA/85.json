{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":85,"content":[{"type":"hebrew_subtitle","content":["കോരഹ് പുത്രന്മാരുടെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"യഹോവേ, അവിടന്ന് അങ്ങയുടെ ദേശത്തോട് കരുണകാണിച്ചിരിക്കുന്നു;","poem":1},{"text":"യാക്കോബിന്റെ സൗഭാഗ്യങ്ങൾ പുനഃസ്ഥാപിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവിടന്ന് അങ്ങയുടെ ജനത്തിന്റെ അകൃത്യം ക്ഷമിക്കുകയും","poem":1},{"text":"അവരുടെ പാപങ്ങൾ മറയ്ക്കുകയും ചെയ്തിരിക്കുന്നു. സേലാ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അങ്ങയുടെ ക്രോധമെല്ലാം അങ്ങ് പിൻവലിക്കുകയും","poem":1},{"text":"ഉഗ്രകോപത്തിൽനിന്ന് പിന്തിരിയുകയും ചെയ്തുവല്ലോ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ഞങ്ങളുടെ രക്ഷയായ ദൈവമേ, ഞങ്ങളെ പുനരുദ്ധരിക്കണമേ,","poem":1},{"text":"ഞങ്ങളോടുള്ള അങ്ങയുടെ അതൃപ്തി നീക്കിക്കളയണമേ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അങ്ങ് ഞങ്ങളോട് എപ്പോഴും കോപിക്കുമോ?","poem":1},{"text":"അങ്ങയുടെ കോപം തലമുറകളിലേക്ക് നീണ്ടുനിൽക്കുമോ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവിടത്തെ ജനം അങ്ങയിൽ ആനന്ദിക്കേണ്ടതിന്","poem":1},{"text":"അവിടന്ന് ഞങ്ങളെ പുനരുജ്ജീവിപ്പിക്കുകയില്ലേ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"യഹോവേ, അങ്ങയുടെ അചഞ്ചലസ്നേഹം ഞങ്ങളിൽ ചൊരിയണമേ,","poem":1},{"text":"അവിടത്തെ രക്ഷ ഞങ്ങൾക്ക് അനുവദിച്ചുനൽകണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"യഹോവയായ ദൈവം അരുളിച്ചെയ്യുന്നത് ഞാൻ ശ്രദ്ധിക്കും;","poem":1},{"text":"തന്റെ വിശ്വസ്തസേവകരായ തന്റെ ജനത്തിന് അവിടന്ന് സമാധാനം അരുളും—","poem":2},{"lineBreak":true},{"text":"അങ്ങനെ അവർ അവരുടെ ഭോഷത്തത്തിലേക്കു മടങ്ങാതിരിക്കട്ടെ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ദൈവമഹത്ത്വം നമ്മുടെ ദേശത്ത് വസിക്കേണ്ടതിന്,","poem":1},{"text":"അവിടത്തെ രക്ഷ തന്നെ ഭയപ്പെടുന്നവർക്ക് സമീപസ്ഥമായിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"വിശ്വസ്തതയും അചഞ്ചലസ്നേഹവുംതമ്മിൽ എതിരേറ്റിരിക്കുന്നു;","poem":1},{"text":"നീതിയും സമാധാനവുംതമ്മിൽ ചുംബിക്കുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"വിശ്വസ്തത ഭൂമിയിൽനിന്ന് മുളയ്ക്കുന്നു,","poem":1},{"text":"നീതി സ്വർഗത്തിൽനിന്ന് താഴേക്കു നോക്കുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"യഹോവ നമുക്ക് നന്മയായതുമാത്രം നൽകുന്നു","poem":1},{"text":"നമ്മുടെ ദേശം അതിന്റെ വിളവുനൽകുകയുംചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"നീതി അവിടത്തേക്കു മുമ്പായി നടക്കുകയും","poem":1},{"text":"അങ്ങയുടെ കാൽച്ചുവടുകൾക്കു വഴിയൊരുക്കുകയും ചെയ്യുന്നു.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}