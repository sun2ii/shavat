{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":86,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു പ്രാർഥന."]},{"type":"verse","number":1,"content":[{"text":"യഹോവേ, ചെവിചായ്ച്ച് എനിക്ക് ഉത്തരമരുളണമേ,","poem":1},{"text":"കാരണം ഞാൻ ദരിദ്രനും നിസ്സഹായനുമാണ്.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"എന്റെ ജീവനെ സംരക്ഷിക്കണമേ, ഞാൻ അവിടത്തെ ഭക്തനല്ലോ;","poem":1},{"text":"അങ്ങയിൽ ആശ്രയിക്കുന്ന ഈ ദാസനെ രക്ഷിക്കണമേ.","poem":2},{"text":"എന്റെ ദൈവം അവിടന്ന് ആകുന്നു;","poem":1}]},{"type":"verse","number":3,"content":[{"text":"കർത്താവേ, എന്നോട് കരുണയുണ്ടാകണമേ,","poem":1},{"text":"ദിവസംമുഴുവനും ഞാൻ അങ്ങയെ വിളിച്ചപേക്ഷിക്കുന്നല്ലോ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"കർത്താവേ, അങ്ങയുടെ ദാസന് ആനന്ദം പകരണമേ,","poem":1},{"text":"എന്റെ ആശ്രയം ഞാൻ അങ്ങയിൽ അർപ്പിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"കർത്താവേ, അവിടന്ന് നല്ലവനും ക്ഷമാശീലനും ആകുന്നു,","poem":1},{"text":"അങ്ങയെ വിളിച്ചപേക്ഷിക്കുന്നവരെയെല്ലാം അചഞ്ചലമായി സ്നേഹിക്കുന്നവനും ആകുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"യഹോവേ, എന്റെ പ്രാർഥന കേൾക്കണമേ;","poem":1},{"text":"കരുണയ്ക്കായുള്ള എന്റെ നിലവിളി കേൾക്കണമേ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"എന്റെ ദുരിതദിനങ്ങളിൽ ഞാൻ അങ്ങയെ വിളിച്ചപേക്ഷിക്കുന്നു,","poem":1},{"text":"അവിടന്ന് എനിക്ക് ഉത്തരമരുളുമല്ലോ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"കർത്താവേ, ദേവന്മാരിൽ അങ്ങേക്കുതുല്യൻ ആരുമില്ലല്ലോ;","poem":1},{"text":"അങ്ങയുടെ പ്രവൃത്തികളോടു തുലനംചെയ്യാൻ കഴിയുന്ന യാതൊന്നുമില്ല.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"കർത്താവേ, അവിടന്ന് നിർമിച്ച സകലരാഷ്ട്രങ്ങളും","poem":1},{"text":"തിരുമുമ്പിൽവന്ന് അങ്ങയെ നമസ്കരിക്കും;","poem":2},{"lineBreak":true},{"text":"അവർ തിരുനാമത്തെ മഹത്ത്വപ്പെടുത്തും.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"കാരണം അവിടന്ന് വലിയവനും അത്ഭുതങ്ങൾ പ്രവർത്തിക്കുന്നവനുമാണ്;","poem":1},{"text":"അങ്ങുമാത്രമാണ് ദൈവം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"യഹോവേ, അവിടത്തെ വഴി എന്നെ പഠിപ്പിക്കണമേ;","poem":1},{"text":"അപ്പോൾ ഞാൻ അങ്ങയുടെ സത്യത്തിന് അനുസൃതമായി ജീവിക്കും;","poem":2},{"text":"തിരുനാമം ഭയപ്പെടാൻ തക്കവിധം","poem":1},{"text":"ഏകാഗ്രമായ ഒരു ഹൃദയം എനിക്കു നൽകണമേ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"എന്റെ കർത്താവായ ദൈവമേ, ഞാൻ പൂർണഹൃദയത്തോടെ അങ്ങയെ സ്തുതിക്കും;","poem":1},{"text":"തിരുനാമത്തെ ഞാൻ എന്നേക്കും മഹത്ത്വപ്പെടുത്തും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"എന്നോടുള്ള അങ്ങയുടെ അചഞ്ചലസ്നേഹം അതിവിപുലമാണ്;","poem":1},{"text":"ആഴത്തിൽനിന്ന് എന്റെ ജീവനെ അവിടന്ന് വിടുവിച്ചിരിക്കുന്നു,","poem":2},{"lineBreak":true},{"text":"അധമപാതാളത്തിൽനിന്നുതന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ദൈവമേ, അഹങ്കാരികൾ എനിക്കെതിരേ എഴുന്നേറ്റിരിക്കുന്നു;","poem":1},{"text":"അനുകമ്പയില്ലാത്തവർ എന്നെ വധിക്കാൻ ശ്രമിക്കുന്നു—","poem":2},{"lineBreak":true},{"text":"അവർ അങ്ങയെ ഗണ്യമാക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"എന്നാൽ കർത്താവേ, അങ്ങ് കരുണാമയനും ആർദ്രഹൃദയനുമായ ദൈവം ആകുന്നു,","poem":1},{"text":"അവിടന്ന് ക്ഷമാശീലനും സ്നേഹസമ്പന്നനും വിശ്വസ്തതയുള്ളവനും ആകുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"എന്നിലേക്കുതിരിഞ്ഞ് എന്നോടു കരുണ കാണിക്കണമേ;","poem":1},{"text":"അവിടത്തെ ദാസന് അങ്ങയുടെ ശക്തി നൽകണമേ;","poem":2},{"text":"അവിടത്തെ ദാസിയുടെ പുത്രനെ","poem":1},{"text":"രക്ഷിക്കുകയും ചെയ്യണമേ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"എന്റെ ശത്രുക്കൾ കണ്ട് ലജ്ജിക്കേണ്ടതിന്,","poem":1},{"text":"അവിടത്തെ കാരുണ്യത്തിന്റെ തെളിവിനായി ഒരു ചിഹ്നം നൽകണമേ,","poem":2},{"lineBreak":true},{"text":"യഹോവേ, അവിടന്ന് എന്നെ സഹായിച്ച് എന്നെ ആശ്വസിപ്പിച്ചിരിക്കുന്നുവല്ലോ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}