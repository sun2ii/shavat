{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":88,"content":[{"type":"hebrew_subtitle","content":["എസ്രാഹ്യനായ ഹേമാന്റെ ഒരു ധ്യാനം."]},{"type":"verse","number":1,"content":[{"text":"യഹോവേ, എന്റെ രക്ഷയുടെ ദൈവമേ,","poem":1},{"text":"ഞാൻ രാവും പകലും തിരുസന്നിധിയിൽ നിലവിളിക്കുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"എന്റെ പ്രാർഥന തിരുമുമ്പിൽ വരുമാറാകട്ടെ;","poem":1},{"text":"എന്റെ നിലവിളിക്ക് അങ്ങയുടെ ചെവിചായ്‌ക്കണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"എന്റെ പ്രാണൻ കഷ്ടതകളാൽ നിറഞ്ഞിരിക്കുന്നു","poem":1},{"text":"എന്റെ ജീവൻ പാതാളത്തോടടുക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ശവക്കുഴിയിലേക്കു നിപതിക്കുന്നവരുടെ കൂട്ടത്തിൽ ഞാൻ എണ്ണപ്പെട്ടിരിക്കുന്നു;","poem":1},{"text":"ഞാൻ ശക്തിഹീനനായ ഒരു മനുഷ്യനെപ്പോലെ ആയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"മരിച്ചവരുടെ ഇടയിൽ തള്ളപ്പെട്ടവരെപ്പോലെയും","poem":1},{"text":"ശവകുടീരത്തിൽ കിടക്കുന്ന വധിക്കപ്പെട്ടവരെപ്പോലെയുമാണ് ഞാൻ,","poem":2},{"text":"അങ്ങ് അവരെ ഒരിക്കലും ഓർക്കുന്നില്ല,","poem":1},{"text":"അങ്ങയുടെ കരുതലിൽനിന്ന് അവർ വിച്ഛേദിക്കപ്പെട്ടിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"അങ്ങ് എന്നെ ഏറ്റവും താണ കുഴിയിൽ,","poem":1},{"text":"അന്ധകാരംനിറഞ്ഞ അഗാധതയിൽ തള്ളിയിട്ടിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവിടത്തെ ക്രോധം എന്റെമേൽ ഭാരമായിരിക്കുന്നു;","poem":1},{"text":"അങ്ങയുടെ തിരമാലകളെല്ലാം എന്നെ വിഴുങ്ങിയിരിക്കുന്നു. സേലാ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"എന്റെ ഏറ്റവുമടുത്ത സ്നേഹിതരെപ്പോലും അങ്ങ് എന്നിൽനിന്ന് അടർത്തിമാറ്റിയിരിക്കുന്നു","poem":1},{"text":"എന്നെ അവർക്ക് അറപ്പുള്ളവനാക്കിത്തീർത്തിരിക്കുന്നു.","poem":2},{"text":"രക്ഷപ്പെടാൻ കഴിയാത്തവിധം എന്നെ കെണിയിൽ വീഴ്ത്തിയിരിക്കുന്നു;","poem":1}]},{"type":"verse","number":9,"content":[{"text":"ദുഃഖത്താൽ എന്റെ കണ്ണുകൾ മങ്ങിപ്പോയിരിക്കുന്നു.","poem":2},{"lineBreak":true},{"text":"യഹോവേ, എല്ലാ ദിവസവും ഞാൻ അങ്ങയെ വിളിച്ചപേക്ഷിക്കുന്നു;","poem":1},{"text":"ഞാൻ തിരുമുമ്പിൽ എന്റെ കൈകൾ ഉയർത്തുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"മരിച്ചവർക്കുവേണ്ടി അവിടന്ന് അത്ഭുതങ്ങൾ പ്രവർത്തിക്കുമോ?","poem":1},{"text":"മൃതരായവർ ഉയിർത്തെഴുന്നേറ്റ് അവിടത്തെ പുകഴ്ത്തുമോ? സേലാ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അവിടത്തെ അചഞ്ചലസ്നേഹം ശവകുടീരത്തിലും","poem":1},{"text":"അവിടത്തെ വിശ്വസ്തത മറവിയുടെ ദേശത്തിലും","poem":2},{"noteId":81},{"text":"ഘോഷിക്കപ്പെടുമോ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവിടത്തെ അത്ഭുതങ്ങൾ അന്ധകാരത്തിലും","poem":1},{"text":"അവിടത്തെ നീതിപ്രവൃത്തികൾ വിസ്മൃതിയുടെ നാട്ടിലും അറിയപ്പെടുന്നുണ്ടോ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"എങ്കിലും യഹോവേ, ഞാൻ അങ്ങയോട് സഹായത്തിനായി അപേക്ഷിക്കുന്നു;","poem":1},{"text":"പ്രഭാതത്തിൽ എന്റെ പ്രാർഥന തിരുമുമ്പിൽ എത്തുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"യഹോവേ, അവിടന്ന് എന്നെ കൈവിടുകയും","poem":1},{"text":"അങ്ങയുടെ മുഖം എന്നിൽനിന്ന് മറയ്ക്കുകയും ചെയ്യുന്നത് എന്ത്?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ചെറുപ്പകാലംമുതൽതന്നെ ഞാൻ പീഡിതനും മരണാസന്നനും ആയിരിക്കുന്നു;","poem":1},{"text":"അങ്ങയുടെ ഭീകരതകൾ ഞാൻ അനുഭവിച്ചു, ഞാൻ നിസ്സഹായനുമാണ്.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അവിടത്തെ കോപം എന്റെമീതേ കവിഞ്ഞൊഴുകുന്നു;","poem":1},{"text":"അവിടത്തെ ഭീകരതകൾ എന്നെ തകർത്തുകളഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ദിവസംമുഴുവനും അവയെന്നെ ജലപ്രളയംപോലെ വലയംചെയ്തിരിക്കുന്നു;","poem":1},{"text":"അവ എന്നെ പൂർണമായും വിഴുങ്ങിക്കളഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അങ്ങ് എന്റെ സ്നേഹിതരെയും അയൽവാസികളെയും എന്നിൽനിന്ന് അകറ്റിയിരിക്കുന്നു.","poem":1},{"text":"അന്ധകാരമാണ് എനിക്കേറ്റവും അടുത്ത മിത്രം.","poem":2}]}],"footnotes":[{"noteId":81,"caller":"+","text":"അഥവാ, മരിച്ചവരുടെ ദേശം. മൂ.ഭാ. അബ്ബദൊൻ","reference":{"chapter":88,"verse":11}}]},"thisChapterLink":"/api/mal_bib/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}