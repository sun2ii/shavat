{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":89,"content":[{"type":"hebrew_subtitle","content":["എസ്രാഹ്യനായ ഏഥാന്റെ ഒരു ധ്യാനസങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"നിത്യവും ഞാൻ യഹോവയുടെ അചഞ്ചലസ്നേഹത്തെ കീർത്തിക്കും;","poem":1},{"text":"എന്റെ വാകൊണ്ട് അവിടത്തെ വിശ്വസ്തതയെ","poem":2},{"lineBreak":true},{"text":"ഞാൻ തലമുറകൾതോറും അറിയിക്കും.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവിടത്തെ അചഞ്ചലസ്നേഹം എന്നേക്കും നിലനിൽക്കുന്നു എന്നും","poem":1},{"text":"അവിടത്തെ വിശ്വസ്തത സ്വർഗത്തിൽ സ്ഥിരമായിരിക്കുന്നു എന്നും ഞാൻ പ്രഖ്യാപിക്കും.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"യഹോവ അരുളിച്ചെയ്തു: “ഞാൻ എന്റെ തെരഞ്ഞെടുക്കപ്പെട്ടവനുമായി ഒരു ഉടമ്പടിചെയ്തു,","poem":1},{"text":"എന്റെ ദാസനായ ദാവീദിനോട് ഞാൻ ശപഥംചെയ്തു,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"‘ഞാൻ നിന്റെ വംശത്തെ എന്നെന്നേക്കും സ്ഥിരമാക്കും","poem":1},{"text":"നിന്റെ സിംഹാസനം തലമുറതലമുറയോളം നിലനിർത്തും.’ ” സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"യഹോവേ, സ്വർഗം അങ്ങയുടെ അത്ഭുതങ്ങളെയും","poem":1},{"text":"വിശുദ്ധരുടെ സഭയിൽ അങ്ങയുടെ വിശ്വസ്തതയെയും സ്തുതിക്കും.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"യഹോവയോട് തുലനംചെയ്യാൻ പ്രപഞ്ചത്തിൽ ആരുണ്ട്?","poem":1},{"text":"ദൈവപുത്രന്മാരിൽ","poem":2},{"noteId":82},{"text":"യഹോവയ്ക്കു സമനായി ആരാണുള്ളത്?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"വിശുദ്ധരുടെ സംഘത്തിൽ ദൈവം ഏറ്റവും ആദരണീയൻ;","poem":1},{"text":"അങ്ങേക്കുചുറ്റും നിൽക്കുന്ന ഏതൊരാളെക്കാളും അങ്ങ് ഭയപ്പെടാൻ യോഗ്യൻ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"സൈന്യങ്ങളുടെ ദൈവമായ യഹോവേ, അങ്ങയെപ്പോലെ ആരുണ്ട്?","poem":1},{"text":"യഹോവേ, അവിടന്ന് ബലവാൻ ആകുന്നു. അങ്ങയുടെ വിശ്വസ്തത അങ്ങയെ വലയംചെയ്തിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ഇളകിമറിയുന്ന സമുദ്രത്തെ അവിടന്ന് അടക്കിവാഴുന്നു;","poem":1},{"text":"അതിന്റെ തിരമാലകൾ ഉയരുമ്പോൾ അങ്ങ് അവയെ ശമിപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവിടന്ന് രഹബിനെ","poem":1},{"noteId":83},{"text":"വധിക്കപ്പെട്ടവരെപ്പോലെ തകർത്തുകളഞ്ഞു;","poem":1},{"text":"അങ്ങയുടെ ശക്തമായ കരംകൊണ്ട് അങ്ങ് ശത്രുക്കളെ ചിതറിച്ചു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ആകാശം അങ്ങയുടേത്, ഭൂമിയും അവിടത്തേതുതന്നെ;","poem":1},{"text":"ഭൂതലവും അതിലുള്ള സകലതും അങ്ങു സ്ഥാപിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ദക്ഷിണോത്തരദിക്കുകളെ അങ്ങു സൃഷ്ടിച്ചു;","poem":1},{"text":"താബോർമലയും ഹെർമോൻമലയും അവിടത്തെ നാമത്തിൽ ആനന്ദിച്ചാർക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അവിടത്തെ കരം ശക്തിയുള്ളതാകുന്നു;","poem":1},{"text":"അവിടത്തെ ഭുജം ബലമേറിയത്, അവിടത്തെ വലതുകരം ഉന്നതമായിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"നീതിയും ന്യായവും അങ്ങയുടെ സിംഹാസനത്തിന്റെ അടിസ്ഥാനം ആകുന്നു;","poem":1},{"text":"അചഞ്ചലസ്നേഹവും വിശ്വസ്തതയും അങ്ങയുടെമുമ്പാകെ പോകുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"യഹോവേ, അങ്ങയെ ആർപ്പുവിളികളോടെ സ്തുതിക്കാൻ ശീലിച്ച ജനം അനുഗൃഹീതർ,","poem":1},{"text":"കാരണം അവർ തിരുസാന്നിധ്യത്തിന്റെ പ്രഭയിൽ സഞ്ചരിക്കും.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അവർ ദിവസംമുഴുവനും അവിടത്തെ നാമത്തിൽ ആനന്ദിക്കുന്നു;","poem":1},{"text":"അവർ അവിടത്തെ നീതിയിൽ പുകഴുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"കാരണം അവിടന്നാണ് അവരുടെ മഹത്ത്വവും ശക്തിയും,","poem":1},{"text":"അവിടത്തെ പ്രസാദത്തിൽ അങ്ങ് ഞങ്ങളുടെ കൊമ്പ്","poem":2},{"noteId":84},{"text":"ഉയർത്തുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ഞങ്ങളുടെ പരിച യഹോവയ്ക്കുള്ളതാകുന്നു, നിശ്ചയം,","poem":1},{"text":"ഞങ്ങളുടെ രാജാവ് ഇസ്രായേലിന്റെ പരിശുദ്ധനുള്ളതും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ഒരിക്കൽ അവിടന്ന് ഒരു ദർശനത്തിൽ സംസാരിച്ചു,","poem":1},{"text":"അങ്ങയുടെ വിശ്വസ്തരോട് അവിടന്ന് അരുളിച്ചെയ്തു:","poem":2},{"text":"“ഞാൻ ഒരു യോദ്ധാവിന്മേൽ ശക്തിപകർന്നു;","poem":1},{"text":"ജനത്തിൽനിന്നു തെരഞ്ഞെടുത്ത ഒരു യുവാവിനെ ഞാൻ ഉയർത്തി.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"എന്റെ ദാസനായ ദാവീദിനെ ഞാൻ കണ്ടെത്തി;","poem":1},{"text":"എന്റെ വിശുദ്ധതൈലംകൊണ്ട് ഞാൻ അദ്ദേഹത്തെ അഭിഷേകംചെയ്തു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"എന്റെ കൈ അദ്ദേഹത്തെ നിലനിർത്തും;","poem":1},{"text":"എന്റെ ഭുജം അദ്ദേഹത്തെ ശക്തിപ്പെടുത്തും, നിശ്ചയം.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ശത്രു അദ്ദേഹത്തിൽനിന്ന് കപ്പംപിരിക്കുകയില്ല;","poem":1},{"text":"ദുഷ്ടർ അദ്ദേഹത്തെ കീഴ്പ്പെടുത്തുകയുമില്ല.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"അദ്ദേഹത്തിന്റെ എതിരാളികളെ ഞാൻ അദ്ദേഹത്തിന്റെ മുമ്പിൽവെച്ച് തകർക്കുകയും","poem":1},{"text":"അദ്ദേഹത്തെ വെറുക്കുന്നവരെ ഞാൻ നശിപ്പിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"എന്റെ വിശ്വസ്തതയും അചഞ്ചലസ്നേഹവും അദ്ദേഹത്തോടൊപ്പം ഉണ്ടാകും","poem":1},{"text":"എന്റെ നാമംമൂലം അദ്ദേഹത്തിന്റെ കൊമ്പ് ഉയർന്നിരിക്കും.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"അദ്ദേഹത്തിന്റെ കൈ സമുദ്രത്തിന്മേലും","poem":1},{"text":"വലതുകരം നദികളിന്മേലും ഞാൻ സ്ഥാപിക്കും.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"അദ്ദേഹം എന്നോട് ഇപ്രകാരം ഘോഷിക്കും, ‘അവിടന്നാണ് എന്റെ പിതാവ്,","poem":1},{"text":"എന്റെ ദൈവം, എന്റെ രക്ഷയുടെ പാറ.’","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ഞാൻ അദ്ദേഹത്തെ എന്റെ ആദ്യജാതനായി നിയമിക്കും,","poem":1},{"text":"ഭൂമിയിലെ രാജാക്കന്മാരിൽ ഏറ്റവും ഉന്നതനാക്കും.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"അദ്ദേഹത്തോടുള്ള എന്റെ അചഞ്ചലസ്നേഹം ഞാൻ എന്നും നിലനിർത്തും,","poem":1},{"text":"അദ്ദേഹത്തോടുള്ള എന്റെ ഉടമ്പടി ഒരിക്കലും അവസാനിക്കുകയില്ല.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"അദ്ദേഹത്തിന്റെ വംശത്തെ ഞാൻ എന്നെന്നും നിലനിർത്തും,","poem":1},{"text":"അദ്ദേഹത്തിന്റെ സിംഹാസനത്തെ ആകാശമുള്ള കാലത്തോളവും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“അദ്ദേഹത്തിന്റെ പുത്രന്മാർ എന്റെ ന്യായപ്രമാണം ഉപേക്ഷിക്കുകയും","poem":1},{"text":"എന്റെ നിയമവ്യവസ്ഥകൾ പാലിക്കാതിരിക്കുകയും ചെയ്താൽ,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"അതേ, അവർ എന്റെ ഉത്തരവുകൾ ലംഘിക്കുകയും","poem":1},{"text":"എന്റെ കൽപ്പനകൾ ആചരിക്കുന്നതിൽ പരാജയപ്പെടുകയുംചെയ്താൽ,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ഞാൻ അവരുടെ പാപങ്ങൾക്ക് വടികൊണ്ടും","poem":1},{"text":"അവരുടെ അതിക്രമങ്ങൾക്ക് ചാട്ടവാർകൊണ്ടും ശിക്ഷിക്കും;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"എങ്കിലും എനിക്ക് അവനോടുള്ള അചഞ്ചലസ്നേഹത്തിന് ഭംഗംവരികയോ","poem":1},{"text":"എന്റെ വിശ്വസ്തത ഞാൻ ഒരിക്കലും ത്യജിക്കുകയോ ഇല്ല.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ഞാൻ എന്റെ ഉടമ്പടി ലംഘിക്കുകയോ","poem":1},{"text":"എന്റെ അധരങ്ങൾ ഉച്ചരിച്ച വാക്കുകൾക്കു വ്യത്യാസം വരുത്തുകയോ ചെയ്യുകയില്ല.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"എന്റെ വിശുദ്ധിയിൽ ഞാൻ ഒരിക്കലായി ശപഥംചെയ്തിരിക്കുന്നു;","poem":1},{"text":"ദാവീദിനോടു ഞാൻ വ്യാജം സംസാരിക്കുകയില്ല.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"അദ്ദേഹത്തിന്റെ വംശം ശാശ്വതമായിരിക്കും","poem":1},{"text":"അദ്ദേഹത്തിന്റെ സിംഹാസനം എന്റെമുമ്പാകെ സൂര്യനെപ്പോലെ നിലനിൽക്കും;","poem":2}]},{"type":"verse","number":37,"content":[{"text":"അതു ചന്ദ്രനെപ്പോലെ എന്നെന്നേക്കുമായി സ്ഥാപിക്കപ്പെട്ടിരിക്കും,","poem":1},{"text":"ആകാശത്തിലെ വിശ്വസ്തസാക്ഷിയായിത്തന്നെ.” സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"എങ്കിലും അവിടന്ന് ഉപേക്ഷിക്കുകയും തള്ളിക്കളയുകയും ചെയ്തിരിക്കുന്നു,","poem":1},{"text":"അങ്ങയുടെ അഭിഷിക്തനോട് കോപാകുലനായിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"അങ്ങയുടെ ദാസനോടുള്ള അവിടത്തെ ഉടമ്പടി അങ്ങ് നിരാകരിക്കുകയും","poem":1},{"text":"അദ്ദേഹത്തിന്റെ കിരീടത്തെ നിലത്തിട്ട് മലിനമാക്കുകയും ചെയ്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"അവിടന്ന് അദ്ദേഹത്തിന്റെ സുരക്ഷാമതിലുകൾക്കെല്ലാം വിള്ളൽവീഴ്ത്തിയിരിക്കുന്നു","poem":1},{"text":"അദ്ദേഹത്തിന്റെ കോട്ടകൾ ഇടിച്ചുനിരത്തിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"വഴിപോക്കരൊക്കെ അദ്ദേഹത്തെ കൊള്ളയിടുന്നു;","poem":1},{"text":"അയൽവാസികൾക്ക് അദ്ദേഹമൊരു പരിഹാസപാത്രമായിത്തീർന്നിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"അദ്ദേഹത്തിന്റെ വൈരികളുടെ വലതുകരം അങ്ങ് ഉയർത്തിയിരിക്കുന്നു;","poem":1},{"text":"അദ്ദേഹത്തിന്റെ ശത്രുക്കളെയെല്ലാം അങ്ങ് സന്തുഷ്ടരാക്കിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"അങ്ങ് അദ്ദേഹത്തിന്റെ വാളിന്റെ വായ്ത്തല മടക്കിയിരിക്കുന്നു","poem":1},{"text":"യുദ്ധത്തിൽ അദ്ദേഹത്തിനൊരു കൈത്താങ്ങ് നൽകിയതുമില്ല.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"അദ്ദേഹത്തിന്റെ മഹത്ത്വത്തിന് അങ്ങ് അറുതിവരുത്തിയിരിക്കുന്നു","poem":1},{"text":"അദ്ദേഹത്തിന്റെ സിംഹാസനം അവിടന്ന് മറിച്ചുകളഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"അദ്ദേഹത്തിന്റെ യൗവനകാലം അങ്ങ് വെട്ടിച്ചുരുക്കിയിരിക്കുന്നു;","poem":1},{"text":"ലജ്ജയുടെ കുപ്പായംകൊണ്ട് അങ്ങ് അദ്ദേഹത്തെ മൂടിയിരിക്കുന്നു. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"ഇനിയും എത്രനാൾ, യഹോവേ? അവിടന്ന് എന്നേക്കും മറഞ്ഞിരിക്കുമോ?","poem":1},{"text":"അവിടത്തെ ക്രോധം എത്രകാലത്തേക്ക് അഗ്നിപോലെ ജ്വലിക്കും?","poem":2}]},{"type":"verse","number":47,"content":[{"text":"എന്റെ ആയുഷ്കാലം എത്രക്ഷണികമെന്ന് ഓർക്കണമേ","poem":1},{"text":"കാരണം, മനുഷ്യവംശത്തിന്റെ സൃഷ്ടി എത്ര നിരർഥകം!","poem":2}]},{"type":"verse","number":48,"content":[{"text":"മരണം കാണാതെ ജീവിക്കാൻ ആർക്കാണു കഴിയുക?","poem":1},{"text":"പാതാളത്തിന്റെ ശക്തിയിൽനിന്നു രക്ഷപ്പെടാൻ ആർക്കാണു കഴിയുക? സേലാ.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"കർത്താവേ, അവിടത്തെ വിശ്വസ്തതയിൽ ദാവീദിനോട് ശപഥംചെയ്ത,","poem":1},{"text":"അവിടത്തെ അചഞ്ചലമായ മുൻകാലസ്നേഹം എവിടെ?","poem":2}]},{"type":"verse","number":50,"content":[{"text":"കർത്താവേ, അങ്ങയുടെ ദാസൻ","poem":1},{"noteId":85},{"text":"എത്രത്തോളം നിന്ദിക്കപ്പെട്ടിരിക്കുന്നു എന്ന് ഓർക്കണമേ,","poem":1},{"text":"സകലരാഷ്ട്രങ്ങളുടെയും പരിഹാസം ഞാൻ എന്റെ ഹൃദയത്തിൽ വഹിക്കുന്നു,","poem":2}]},{"type":"verse","number":51,"content":[{"text":"യഹോവേ, അങ്ങയുടെ ശത്രുക്കളാണെന്നെ പരിഹസിക്കുന്നത്,","poem":1},{"text":"അവിടത്തെ അഭിഷിക്തന്റെ ഓരോ ചുവടുവെപ്പും അവർ നിന്ദിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"യഹോവ എന്നെന്നേക്കും വാഴ്ത്തപ്പെടുമാറാകട്ടെ!","poem":1},"ആമേൻ, ആമേൻ."]}],"footnotes":[{"noteId":82,"caller":"+","text":"അതായത്, സ്വർഗനിവാസികൾ അഥവാ, ദൈവദൂതഗണം.","reference":{"chapter":89,"verse":6}},{"noteId":83,"caller":"+","text":"സങ്കീ. 74:13കാണുക.","reference":{"chapter":89,"verse":10}},{"noteId":84,"caller":"+","text":"കൊമ്പ് ഇവിടെ ശക്തിയുടെ പ്രതീകമാണ്.","reference":{"chapter":89,"verse":17}},{"noteId":85,"caller":"+","text":"അഥവാ, അങ്ങയുടെ സേവകർ","reference":{"chapter":89,"verse":50}}]},"thisChapterLink":"/api/mal_bib/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}