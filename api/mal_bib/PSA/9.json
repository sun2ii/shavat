{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":9,"content":[{"type":"hebrew_subtitle","content":["ദാവീദിന്റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"യഹോവേ, ഞാൻ പൂർണഹൃദയത്തോടെ, അങ്ങയെ സ്തുതിക്കും;","poem":1},{"text":"അവിടത്തെ അത്ഭുതങ്ങളൊക്കെയും ഞാൻ വർണിക്കും.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ഞാൻ അങ്ങയിൽ ആനന്ദിച്ചുല്ലസിക്കും;","poem":1},{"text":"അത്യുന്നതനേ, തിരുനാമത്തിനു ഞാൻ സ്തുതിപാടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"എന്റെ ശത്രുക്കൾ പിന്തിരിഞ്ഞോടുന്നു;","poem":1},{"text":"അവർ തിരുമുമ്പാകെ കാലിടറിവീണു നശിക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"കാരണം അവിടന്ന് എനിക്കുവേണ്ടി ന്യായവും വ്യവഹാരവും നടത്തിയിരിക്കുന്നു,","poem":1},{"text":"അവിടന്ന് സിംഹാസനസ്ഥനായി നീതിയോടെ ന്യായംവിധിക്കുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവിടന്ന് ജനതകളെ ശകാരിക്കുകയും ദുഷ്ടരെ നശിപ്പിക്കുകയും ചെയ്തിരിക്കുന്നു;","poem":1},{"text":"അവിടന്ന് അവരുടെ നാമം എന്നെന്നേക്കുമായി മായിച്ചുകളഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അന്തമില്ലാത്ത അനർഥങ്ങൾനിമിത്തം ശത്രുക്കൾ തകർക്കപ്പെട്ടിരിക്കുന്നു,","poem":1},{"text":"അവരുടെ നഗരങ്ങളെ അങ്ങ് ഉന്മൂലനംചെയ്തിരിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"അവരുടെ ഓർമകൾപോലും മാഞ്ഞുപോയിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"യഹോവ എന്നേക്കും വാഴുന്നു;","poem":1},{"text":"അവിടന്ന് ന്യായവിധിക്കായി തന്റെ സിംഹാസനം സ്ഥാപിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവിടന്ന് ലോകത്തെ നീതിയോടെ ന്യായംവിധിക്കും;","poem":1},{"text":"ജനതകളെ നേരോടെ ന്യായപാലനംചെയ്യും.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"യഹോവ പീഡിതർക്കൊരു അഭയസ്ഥാനം,","poem":1},{"text":"ദുർഘടസമയങ്ങളിൽ ഉറപ്പുള്ള ഒരു കോട്ട.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവിടത്തെ നാമം അറിയുന്നവർ അങ്ങയിൽ ആശ്രയംവെക്കുന്നു,","poem":1},{"text":"യഹോവേ, അവിടത്തെ അന്വേഷിക്കുന്നവരെ ഒരുനാളും അങ്ങ് ഉപേക്ഷിക്കുകയില്ലല്ലോ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"സീയോനിൽ വാഴുന്ന യഹോവയ്ക്കു സ്തുതിപാടുക;","poem":1},{"text":"അവിടത്തെ പ്രവൃത്തികൾ ജനതകൾക്കിടയിൽ ഘോഷിക്കുക.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"കാരണം, രക്തത്തിനു പ്രതികാരംചെയ്യുന്ന അവിടന്ന് പീഡിതരെ ഓർക്കുന്നു;","poem":1},{"text":"അവരുടെ നിലവിളി അവിടന്ന് അവഗണിക്കുന്നതുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"യഹോവേ, എന്റെ ശത്രുക്കൾ എന്നെ ദ്രോഹിക്കുന്നത് എങ്ങനെയെന്ന് കാണണമേ!","poem":1},{"text":"എന്നോട് കരുണതോന്നി, മരണകവാടത്തിൽനിന്ന് എന്നെ ഉദ്ധരിക്കണമേ,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"സീയോൻപുത്രിയുടെ കവാടത്തിൽ","poem":1},{"text":"ഞാൻ അവിടത്തെ സ്തുതി ഘോഷിക്കും;","poem":2},{"lineBreak":true},{"text":"ഞാൻ അങ്ങയുടെ രക്ഷയിൽ ആനന്ദിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"രാഷ്ട്രങ്ങൾ അവർ കുഴിച്ച കുഴിയിൽത്തന്നെ വീണിരിക്കുന്നു;","poem":1},{"text":"അവരുടെ കാൽപ്പാദങ്ങൾ അവർ വിരിച്ച വലയിൽത്തന്നെ കുടുങ്ങിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"യഹോവ അവിടത്തെ നീതിനിർവഹണത്തിൽ പ്രസിദ്ധനായിരിക്കുന്നു;","poem":1},{"text":"ദുഷ്ടർ അവരുടെ കൈകളുടെ പ്രവൃത്തിയിൽ കുടുങ്ങിപ്പോയിരിക്കുന്നു. തന്ത്രിനാദം.","poem":2},{"noteId":16},{"text":"സേലാ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ദുഷ്ടർ പാതാളത്തിലേക്കു തിരിയുന്നു,","poem":1},{"text":"ദൈവത്തെ മറക്കുന്ന രാഷ്ട്രങ്ങളുടെ അന്ത്യവും അങ്ങനെതന്നെ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"എന്നാൽ ദരിദ്രർ എക്കാലവും വിസ്മരിക്കപ്പെടുകയില്ല;","poem":1},{"text":"പീഡിതരുടെ പ്രത്യാശ എന്നേക്കും നശിച്ചുപോകുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"യഹോവേ, എഴുന്നേൽക്കണമേ, മർത്യർ വിജയഭേരി മുഴക്കാതിരിക്കട്ടെ;","poem":1},{"text":"ജനതകൾ തിരുമുമ്പാകെ ന്യായവിധിക്കു വിധേയരാകട്ടെ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"യഹോവേ, ഭീതിയാൽ അവരെ തകർക്കണമേ,","poem":1},{"text":"തങ്ങൾ വെറും മനുഷ്യരെന്ന് രാഷ്ട്രങ്ങൾ മനസ്സിലാക്കട്ടെ. സേലാ.","poem":2}]}],"footnotes":[{"noteId":16,"caller":"+","text":"ഈ വാക്കിന്റെ അർഥം വ്യക്തമല്ല.","reference":{"chapter":9,"verse":16}}]},"thisChapterLink":"/api/mal_bib/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}