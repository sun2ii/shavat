{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":90,"content":[{"type":"hebrew_subtitle","content":["ദൈവപുരുഷനായ മോശയുടെ ഒരു പ്രാർഥന."]},{"type":"verse","number":1,"content":[{"text":"കർത്താവേ, തലമുറതലമുറയായി","poem":1},{"text":"അവിടന്ന് ഞങ്ങളുടെ നിവാസസ്ഥാനമായിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"പർവതങ്ങൾ ജനിക്കുന്നതിനും","poem":1},{"text":"ഈ ഭൂമിക്കും പ്രപഞ്ചത്തിനും ജന്മംനൽകുന്നതിനും മുമ്പുതന്നെ,","poem":2},{"lineBreak":true},{"text":"അനന്തതമുതൽ അനന്തതവരെ അവിടന്ന് ദൈവം ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“മർത്യരേ, പൊടിയിലേക്ക് മടങ്ങുക,” എന്നു കൽപ്പിച്ചുകൊണ്ട്,","poem":1},{"text":"അങ്ങ് മനുഷ്യരെ പൊടിയിലേക്ക് തിരികെ അയയ്ക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ആയിരം വർഷം അങ്ങയുടെ ദൃഷ്ടിയിൽ","poem":1},{"text":"ഇപ്പോൾ കഴിഞ്ഞുപോയ ഒരു ദിവസംപോലെയോ","poem":2},{"lineBreak":true},{"text":"രാത്രിയിലെ ഒരു യാമംപോലെയോ ആകുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"പ്രഭാതത്തിൽ പൊട്ടിമുളയ്ക്കുന്ന പുല്ലുപോലെ","poem":1},{"text":"അങ്ങ് മനുഷ്യരെ പ്രളയത്തിലെന്നപോലെ മരണനിദ്രയിലേക്ക് ഒഴുക്കിക്കളയുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"രാവിലെ അതു മുളച്ച് വളർന്നുനിൽക്കുന്നു,","poem":1},{"text":"എന്നാൽ വൈകുന്നേരം അതു വാടിക്കരിഞ്ഞുപോകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"അവിടത്തെ കോപത്താൽ ഞങ്ങൾ ദഹിച്ചുപോകുകയും","poem":1},{"text":"അവിടത്തെ ക്രോധത്താൽ ഞങ്ങൾ പരിഭ്രാന്തരായിത്തീരുകയുംചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവിടന്ന് ഞങ്ങളുടെ അകൃത്യങ്ങളെ അങ്ങയുടെമുന്നിലും","poem":1},{"text":"ഞങ്ങളുടെ രഹസ്യപാപങ്ങളെ തിരുമുഖപ്രഭയിലും വെച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഞങ്ങളുടെ ദിവസങ്ങളെല്ലാം അവിടത്തെ ക്രോധത്തിൻകീഴിൽ കഴിഞ്ഞുപോകുന്നു;","poem":1},{"text":"ഞങ്ങളുടെ വർഷങ്ങൾ ഒരു വിലാപത്തോടെ അവസാനിപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ഞങ്ങളുടെ ആയുസ്സിന്റെ ദൈർഘ്യം എഴുപതുവർഷം,","poem":1},{"text":"കരുത്തുള്ളവരാണെങ്കിൽ അത് എൺപതുവരെ;","poem":2},{"text":"എന്നാൽ അതിന്റെ പ്രതാപമേറിയ വർഷങ്ങൾ കഷ്ടതയും സങ്കടവുമത്രേ,","poem":1},{"text":"അതു വേഗം കഴിയുകയും ഞങ്ങൾ പറന്നുപോകുകയുംചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അങ്ങയുടെ കോപത്തിന്റെ ശക്തി മനസ്സിലാക്കാൻ ആർക്കാണു കഴിയുക?","poem":1},{"text":"അങ്ങയുടെ ക്രോധം അവിടത്തോട് ഞങ്ങൾക്കുണ്ടായിരിക്കേണ്ട ഭയത്തിനനുസൃതമാണല്ലോ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ഞങ്ങൾക്കു ജ്ഞാനമുള്ളൊരു ഹൃദയം ലഭിക്കുന്നതിനുവേണ്ടി,","poem":1},{"text":"ഞങ്ങളുടെ ദിനങ്ങൾ എണ്ണുന്നതിന് ഞങ്ങളെ അഭ്യസിപ്പിക്കണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"യഹോവേ, കനിയണമേ! അങ്ങ് എത്രത്തോളം താമസിക്കും?","poem":1},{"text":"അവിടത്തെ സേവകരോട് കനിവു തോന്നണമേ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവിടത്തെ അചഞ്ചലസ്നേഹത്താൽ ഓരോ പ്രഭാതവും ഞങ്ങൾക്കു തൃപ്തികരമാക്കണമേ,","poem":1},{"text":"അപ്പോൾ എല്ലാ ദിവസവും ഞങ്ങൾക്ക് ആനന്ദഗാനങ്ങൾ ആലപിച്ച് ആഹ്ലാദിക്കാൻ കഴിയും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവിടന്ന് ഞങ്ങളെ ദുരിതമനുഭവിക്കാൻ അനുവദിച്ച നാളുകൾക്കും","poem":1},{"text":"ഞങ്ങൾ കഷ്ടമനുഭവിച്ച വർഷങ്ങൾക്കും അനുസൃതമായി ഞങ്ങളെ ആനന്ദിപ്പിക്കണമേ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അങ്ങയുടെ പ്രവൃത്തികൾ അങ്ങയുടെ സേവകർക്കും","poem":1},{"text":"അങ്ങയുടെ മഹത്ത്വം അവരുടെ മക്കൾക്കും വെളിപ്പെടുമാറാകട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ഞങ്ങളുടെ ദൈവമായ കർത്താവിന്റെ കാരുണ്യം","poem":1},{"noteId":86},{"text":"ഞങ്ങളുടെമേൽ ഉണ്ടായിരിക്കുമാറാകട്ടെ;","poem":1},{"text":"ഞങ്ങളുടെ കൈകളുടെ പ്രവൃത്തികൾ സഫലമാക്കണമേ—","poem":2},{"lineBreak":true},{"text":"അതേ, ഞങ്ങളുടെ കൈകളുടെ പ്രവൃത്തികൾ സഫലമാക്കണമേ.","poem":2}]}],"footnotes":[{"noteId":86,"caller":"+","text":"അഥവാ, സൗന്ദര്യം","reference":{"chapter":90,"verse":17}}]},"thisChapterLink":"/api/mal_bib/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}