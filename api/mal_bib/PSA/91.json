{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":91,"content":[{"type":"verse","number":1,"content":[{"text":"അത്യുന്നതനെ ആശ്രയമാക്കി വസിക്കുന്നവർ","poem":1},{"text":"സർവശക്തന്റെ തണലിൽ വിശ്രമിക്കും.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ഞാൻ യഹോവയെക്കുറിച്ച്, “അവിടന്നാണ് എന്റെ സങ്കേതവും കോട്ടയും","poem":1},{"text":"ഞാൻ ആശ്രയിക്കുന്ന എന്റെ ദൈവവും,” എന്നു പറയും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"അവിടന്നു നിശ്ചയമായും നിന്നെ","poem":1},{"text":"വേട്ടക്കാരുടെ കെണിയിൽനിന്നും","poem":2},{"lineBreak":true},{"text":"മാരകമായ പകർച്ചവ്യാധിയിൽനിന്നും രക്ഷിക്കും.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"തന്റെ തൂവലുകൾകൊണ്ട് അവിടന്ന് നിന്നെ മറയ്ക്കും,","poem":1},{"text":"അവിടത്തെ ചിറകിൻകീഴിൽ നീ അഭയംകണ്ടെത്തും;","poem":2},{"lineBreak":true},{"text":"അവിടത്തെ വിശ്വസ്തത നിനക്ക് പരിചയും കോട്ടയും ആയിരിക്കും.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"രാത്രിയുടെ ഭീകരതയോ","poem":1},{"text":"പകലിൽ ചീറിപ്പായുന്ന അസ്ത്രമോ","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഇരുളിന്റെ മറവിൽ വ്യാപിക്കുന്ന പകർച്ചവ്യാധിയോ","poem":1},{"text":"നട്ടുച്ചയ്ക്കു വന്നുചേരുന്ന അത്യാപത്തോ നീ ഭയപ്പെടുകയില്ല.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"നിന്റെ വശത്ത് ആയിരംപേരും","poem":1},{"text":"നിന്റെ വലതുഭാഗത്ത് പതിനായിരംപേരും വീഴും.","poem":2},{"lineBreak":true},{"text":"എങ്കിലും അതു നിന്നോട് അടുക്കുകയില്ല.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"നിന്റെ കണ്ണുകൾകൊണ്ട് നീ നോക്കുകയും","poem":1},{"text":"ദുഷ്ടരുടെ ശിക്ഷ നീ കാണുകയും ചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"യഹോവയെ നിന്റെ സങ്കേതവും","poem":1},{"text":"അത്യുന്നതനെ നിന്റെ നിവാസസ്ഥാനവും ആക്കുമെങ്കിൽ,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ഒരു അത്യാപത്തും നിനക്ക് ഉണ്ടാകുകയില്ല,","poem":1},{"text":"ഒരു ദുരന്തവും നിന്റെ കൂടാരത്തിന് അടുത്തെത്തുകയില്ല.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"കാരണം അവിടന്ന് തന്റെ ദൂതന്മാരോട്","poem":1},{"text":"നിന്റെ എല്ലാ വഴികളിലും നിന്നെ സംരക്ഷിക്കാൻ കൽപ്പിക്കും;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവർ നിന്റെ പാദങ്ങൾ കല്ലിൽ മുട്ടാതെ","poem":1},{"text":"നിന്നെ അവരുടെ കരങ്ങളിലേന്തും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"സിംഹത്തെയും അണലിയെയും നീ ചതയ്ക്കും;","poem":1},{"text":"സിംഹക്കുട്ടികളെയും മഹാസർപ്പത്തെയും നീ മെതിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"അതുകൊണ്ട് യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു, “എന്നെ സ്നേഹിക്കുന്നവരെ ഞാൻ മോചിപ്പിക്കും;","poem":1},{"text":"എന്റെ നാമത്തിൽ ആശ്രയിക്കുന്നവരെ ഞാൻ സംരക്ഷിക്കും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവർ എന്നെ വിളിച്ചപേക്ഷിക്കും, ഞാൻ അവർക്ക് ഉത്തരമരുളും;","poem":1},{"text":"കഷ്ടതയിൽ ഞാൻ അവരോടൊപ്പമുണ്ടാകും,","poem":2},{"lineBreak":true},{"text":"ഞാൻ അവരെ വിടുവിച്ച് ബഹുമാനിക്കും.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ദീർഘായുസ്സ് നൽകി ഞാൻ അവരെ തൃപ്തരാക്കും","poem":1},{"text":"എന്റെ രക്ഷ ഞാൻ അവർക്കു കാണിച്ചുകൊടുക്കും.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}