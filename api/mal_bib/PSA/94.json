{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":94,"content":[{"type":"verse","number":1,"content":[{"text":"യഹോവേ, പ്രതികാരത്തിന്റെ ദൈവമേ,","poem":1},{"text":"പ്രതികാരത്തിന്റെ ദൈവമേ, പ്രകാശം പരത്തണമേ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ഭൂമിയുടെ ന്യായാധിപതിയേ, എഴുന്നേൽക്കണമേ;","poem":1},{"text":"അഹങ്കാരികൾക്ക് അവർ അർഹിക്കുന്ന ശിക്ഷനൽകണമേ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ദുഷ്ടർ ഇനിയും എത്രനാൾ, യഹോവേ,","poem":1},{"text":"ദുഷ്ടർ എത്രനാൾ തിമിർത്താഹ്ലാദിക്കും?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"അഹന്തനിറഞ്ഞ വാക്കുകൾ അവർ ഉരുവിടുന്നു;","poem":1},{"text":"അധർമികൾ എല്ലാവരും വമ്പുപറയുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"യഹോവേ, അവിടത്തെ ജനത്തെ അവർ ഞെരിച്ചമർത്തുന്നു;","poem":1},{"text":"അങ്ങയുടെ അവകാശത്തെ അവർ പീഡിപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"വിധവകളെയും പ്രവാസികളെയും അവർ കൊന്നൊടുക്കുന്നു;","poem":1},{"text":"അനാഥരെ അവർ വധിക്കുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവർ ഇപ്രകാരം പറയുന്നു, “യഹോവ കാണുന്നില്ല;","poem":1},{"text":"യാക്കോബിന്റെ ദൈവം ഗൗനിക്കുന്നില്ല.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ജനങ്ങൾക്കിടയിലെ വിവേകശൂന്യരായ മനുഷ്യാ, കരുതിയിരിക്കുക;","poem":1},{"text":"ഭോഷരേ, നിങ്ങൾക്കിനി എന്നാണ് ജ്ഞാനമുദിക്കുക?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"കാതുകൾ വെച്ചുപിടിപ്പിച്ചവൻ കേൾക്കാതിരിക്കുമോ?","poem":1},{"text":"കണ്ണുകൾ രൂപപ്പെടുത്തിയവൻ കാണാതെവരുമോ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"രാഷ്ട്രങ്ങളെ വരുതിയിൽ നിറുത്തിയവൻ ശിക്ഷിക്കാതിരിക്കുമോ?","poem":1},{"text":"മനുഷ്യവംശത്തെ അഭ്യസിപ്പിക്കുന്നവന് പരിജ്ഞാനം കുറവെന്നുവരുമോ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"മനുഷ്യരുടെ വിചാരങ്ങളെല്ലാം യഹോവ അറിയുന്നു;","poem":1},{"text":"അവ വ്യർഥമെന്ന് അവിടന്ന് അറിയുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"യഹോവേ, അവിടന്ന് ശിക്ഷിക്കുന്നവർ അനുഗൃഹീതർ,","poem":1},{"text":"അങ്ങയുടെ ന്യായപ്രമാണത്തിൽനിന്ന് അവിടന്ന് പഠിപ്പിക്കുന്നവർതന്നെ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അവിടന്ന് അവർക്ക് ദുരിതദിനങ്ങളിൽ സ്വസ്ഥത നൽകുന്നു,","poem":1},{"text":"ദുഷ്ടർക്കുവേണ്ടി ഒരു കുഴി കുഴിക്കപ്പെടുന്നതുവരെ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"കാരണം യഹോവ തന്റെ ജനത്തെ തള്ളിക്കളയുകയില്ല;","poem":1},{"text":"അവിടന്ന് തന്റെ അവകാശത്തെ ഉപേക്ഷിക്കുകയുമില്ല.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ന്യായവിധി വീണ്ടും നീതിയിൽ അധിഷ്ഠിതമായിരിക്കും","poem":1},{"text":"ഹൃദയപരമാർഥികൾ എല്ലാവരും അത് പിൻതുടരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ദുഷ്ടരെ നേരിടുന്നതിനായി ആരാണ് എനിക്കുവേണ്ടി എഴുന്നേൽക്കുന്നത്?","poem":1},{"text":"ആര് എനിക്കുവേണ്ടി അധർമികളോട് എതിർത്തുനിൽക്കും?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"യഹോവ എനിക്ക് സഹായി ആയിരുന്നില്ലെങ്കിൽ,","poem":1},{"text":"ഞാൻ അതിവേഗത്തിൽ മരണത്തിന്റെ നിശ്ശബ്ദതയിൽ പാർക്കുമായിരുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“എന്റെ കാൽ വഴുതുന്നു,” എന്നു ഞാൻ പറഞ്ഞപ്പോൾ,","poem":1},{"text":"യഹോവേ, അവിടത്തെ അചഞ്ചലസ്നേഹം എനിക്ക് തുണയായിരുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"എന്റെയുള്ളിൽ ആകുലതകൾ വർധിച്ചപ്പോൾ,","poem":1},{"text":"അവിടത്തെ സാന്ത്വനം എന്റെ പ്രാണന് ആനന്ദം നൽകി.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"അഴിമതിനിറഞ്ഞ സിംഹാസനവുമായി അങ്ങേക്ക് സഖ്യമുണ്ടാകുമോ—","poem":1},{"text":"ഉത്തരവുകളിലൂടെ ദുരന്തം വരുത്തുന്ന സിംഹാസനത്തോടുതന്നെ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവർ നീതിനിഷ്ഠർക്കെതിരേ ഒത്തുചേർന്ന്","poem":1},{"text":"നിരപരാധികളെ മരണത്തിന് വിധിക്കുന്നു.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"എന്നാൽ യഹോവ എന്റെ ഉറപ്പുള്ള കോട്ടയായിത്തീർന്നിരിക്കുന്നു,","poem":1},{"text":"അവിടന്ന് എന്റെ ദൈവം, ഞാൻ അഭയംതേടുന്ന പാറയും.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"അവിടന്ന് അവരുടെ പാപങ്ങൾക്കു തക്ക പ്രതികാരംചെയ്യും","poem":1},{"text":"അവരുടെ ദുഷ്‌പ്രവൃത്തികൾമൂലം അവരെ നശിപ്പിക്കും;","poem":2},{"lineBreak":true},{"text":"നമ്മുടെ ദൈവമായ യഹോവ അവരെ തകർത്തുകളയും.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}