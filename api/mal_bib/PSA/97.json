{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"യഹോവ വാഴുന്നു, ഭൂമി ഉല്ലസിക്കട്ടെ;","poem":1},{"text":"വിദൂരതീരങ്ങൾ ആഹ്ലാദിക്കട്ടെ;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"മേഘവും അന്ധതമസ്സും അവിടത്തെ വലയംചെയ്തിരിക്കുന്നു;","poem":1},{"text":"നീതിയും ന്യായവും അവിടത്തെ സിംഹാസനത്തിന്റെ അടിസ്ഥാനം ആകുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അഗ്നി അങ്ങേക്കുമുമ്പേ പുറപ്പെടുന്നു","poem":1},{"text":"ചുറ്റുമുള്ള തന്റെ എതിരാളികളെ ദഹിപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവിടത്തെ മിന്നൽപ്പിണരുകൾ പ്രപഞ്ചത്തെ പ്രകാശിപ്പിക്കുന്നു;","poem":1},{"text":"ഭൂമി അതു കാണുകയും പ്രകമ്പനംകൊള്ളുകയുംചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"പർവതങ്ങൾ യഹോവയുടെമുമ്പിൽ മെഴുകുപോലെ ഉരുകുന്നു,","poem":1},{"text":"സർവഭൂമിയുടെയും കർത്താവിന്റെ മുമ്പിൽത്തന്നെ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ആകാശം അവിടത്തെ നീതി പ്രഖ്യാപിക്കുകയും","poem":1},{"text":"ജനതകൾ അവിടത്തെ മഹത്ത്വം ദർശിക്കുകയുംചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"പ്രതിമകളെ ആരാധിക്കുന്ന എല്ലാവരും ലജ്ജിതരായിത്തീരും,","poem":1},{"text":"വിഗ്രഹങ്ങളിൽ പ്രശംസിക്കുന്നവരും അങ്ങനെതന്നെ—","poem":2},{"lineBreak":true},{"text":"സകലദേവതകളുമേ, യഹോവയെ നമസ്കരിക്കുക!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"യഹോവേ, അവിടത്തെ ന്യായവിധികൾനിമിത്തം","poem":1},{"text":"സീയോൻ കേൾക്കുകയും ആനന്ദിക്കുകയും","poem":2},{"lineBreak":true},{"text":"യെഹൂദാപുത്രിമാർ ആഹ്ലാദിക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"കാരണം യഹോവേ, അങ്ങാണല്ലോ സർവഭൂമിക്കുംമീതേ അത്യുന്നതൻ;","poem":1},{"text":"അവിടന്ന് സകലദേവന്മാരെക്കാളും അത്യന്തം ഉന്നതൻതന്നെ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"യഹോവയെ സ്നേഹിക്കുന്നവർ തിന്മ വെറുക്കട്ടെ,","poem":1},{"text":"കാരണം അവിടന്ന് തന്റെ വിശ്വസ്തരുടെ പ്രാണനെ കാക്കുന്നു","poem":2},{"lineBreak":true},{"text":"അവരെ ദുഷ്ടരുടെ കൈകളിൽനിന്നു മോചിപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"നീതിനിഷ്ഠരുടെമേൽ പ്രകാശം ഉദിക്കുന്നു;","poem":1},{"text":"ഹൃദയപരമാർഥികളുടെമേൽ ആനന്ദവും.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"നീതിനിഷ്ഠരേ, യഹോവയിൽ ആനന്ദിക്കുകയും","poem":1},{"text":"അവിടത്തെ വിശുദ്ധനാമത്തെ പുകഴ്ത്തുകയും ചെയ്യുക.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}