{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_bib","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"2d06efe41893f60282616cdb05986806a816f9c89a72228809945cc8b4fbbae5","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_bib/PSA/150.json","totalNumberOfVerses":2455},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"യഹോവയ്ക്ക് ഒരു നവഗാനം ആലപിക്കുക;","poem":1},{"text":"അവിടന്ന് അത്ഭുതകാര്യങ്ങൾ ചെയ്തിരിക്കുന്നു.","poem":2},{"text":"അവിടത്തെ വലതുകരവും വിശുദ്ധഭുജവും","poem":1},{"text":"അവിടത്തേക്ക് ജയം നേടിക്കൊടുത്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"യഹോവ തന്റെ രക്ഷ വിളംബരംചെയ്തിരിക്കുന്നു","poem":1},{"text":"അവിടത്തെ നീതി ജനതകൾക്കു വെളിപ്പെടുത്തിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവിടന്ന് ഇസ്രായേൽഗൃഹത്തോടുള്ള തന്റെ സ്നേഹവും","poem":1},{"text":"വിശ്വസ്തതയും ഓർത്തിരിക്കുന്നു;","poem":2},{"text":"നമ്മുടെ ദൈവത്തിന്റെ രക്ഷയെ","poem":1},{"text":"ഭൂമിയുടെ എല്ലാ അതിർത്തികളും ദർശിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"സർവഭൂമിയുമേ, യഹോവയ്ക്ക് ആനന്ദത്തോടെ ആർപ്പിടുക,","poem":1},{"text":"ആഹ്ലാദാരവത്തോടെ അവിടത്തേയ്ക്ക് സ്തുതിപാടുക;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"കിന്നരത്തോടെ യഹോവയ്ക്ക് സ്തുതിഗീതം ആലപിക്കുക,","poem":1},{"text":"കിന്നരത്തോടും സംഗീതാലാപനത്തോടുംതന്നെ,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"കാഹളംകൊണ്ടും കോലാട്ടിൻകൊമ്പിനാൽ തീർത്ത കാഹളംകൊണ്ടും—","poem":1},{"text":"രാജാവായ യഹോവയുടെമുമ്പിൽ ആനന്ദഘോഷം മുഴക്കുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"സമുദ്രവും അതിലുള്ള സമസ്തവും മാറ്റൊലി മുഴക്കട്ടെ,","poem":1},{"text":"ഭൂമിയും അതിലധിവസിക്കുന്ന സകലതുംതന്നെ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"നദികൾ കരഘോഷം മുഴക്കട്ടെ,","poem":1},{"text":"മാമലകൾ ഒന്നുചേർന്ന് ആനന്ദകീർത്തനം ആലപിക്കട്ടെ;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവ യഹോവയുടെ സന്നിധിയിൽ ഗാനം ആലപിക്കട്ടെ;","poem":1},{"text":"അവിടന്നു ഭൂമിയെ ന്യായംവിധിക്കാൻ വരുന്നല്ലോ.","poem":2},{"text":"അവിടന്ന് ലോകത്തെ നീതിയോടും","poem":1},{"text":"ജനതകളെ ന്യായപൂർവമായും വിധിക്കും.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}