{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"SNG","translationId":"mal_bib","name":"ഉത്തമഗീതം","commonName":"ഉത്തമഗീതം","title":"ശലോമോന്റെ ഉത്തമഗീതം","order":22,"numberOfChapters":8,"sha256":"7817410dbdd1910cc272bee571cbfe93d2fb0e4c5e2e630cef0b6b6f547c0e0a","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/mal_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ശലോമോന്റെ ഉത്തമഗീതം."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"അധരങ്ങളാൽ എന്മേൽ ചുംബനവർഷം ചൊരിഞ്ഞാലും—","poem":1},{"text":"നിന്റെ പ്രേമം വീഞ്ഞിനെക്കാൾ ആനന്ദകരം.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"നിന്റെ സുഗന്ധതൈലങ്ങളുടെ സൗരഭ്യം ഹൃദയഹാരി;","poem":1},{"text":"നിന്റെ നാമം സുഗന്ധതൈലം പകർന്നതുപോലെതന്നെ.","poem":2},{"lineBreak":true},{"text":"അതുകൊണ്ട് യുവതികൾ നിന്നെ പ്രേമിക്കുന്നതിൽ അത്ഭുതം ലവലേശമില്ല!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"എന്നെ നിന്നോടൊപ്പം ദൂരത്തേക്കു കൊണ്ടുപോകുക—വേഗമാകട്ടെ!","poem":1},{"text":"രാജാവ് തന്റെ പള്ളിയറകളിലേക്കെന്നെ ആനയിക്കട്ടെ.","poem":2},"തോഴിമാർ",{"text":"ഞങ്ങൾ അത്യാഹ്ലാദത്തോടെ നിന്നിൽ ആനന്ദിക്കും;","poem":1},{"text":"നിന്റെ പ്രേമത്തെ ഞങ്ങൾ വീഞ്ഞിനെക്കാൾ അധികം പ്രകീർത്തിക്കും.","poem":2},"യുവതി",{"text":"അവർ നിന്നെ പ്രകീർത്തിക്കുന്നത് എത്രയോ ഉചിതം.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ജെറുശലേംപുത്രിമാരേ,","poem":1},{"text":"ഞാൻ കറുത്തിട്ടെങ്കിലും അഴകുള്ളവൾ,","poem":2},{"text":"കേദാർ കൂടാരങ്ങൾപോലെയും","poem":1},{"text":"ശലോമോന്റെ കൂടാരശീലകൾപോലെയുംതന്നെ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഞാൻ ഇരുൾനിറമുള്ളവളാകയാൽ എന്നെ തുറിച്ചുനോക്കരുത്,","poem":1},{"text":"ഞാൻ ഇരുണ്ടുപോയത് സൂര്യതാപമേറ്റതിനാലാണ്.","poem":2},{"text":"എന്റെ അമ്മയുടെ പുത്രന്മാർ എന്നോട് കോപിഷ്ഠരായി","poem":1},{"text":"അവരുടെ മുന്തിരിത്തോപ്പുകൾക്ക് എന്നെ കാവൽനിർത്തി;","poem":2},{"lineBreak":true},{"text":"എന്റെ സ്വന്തം മുന്തിരിത്തോപ്പ് എനിക്ക് അവഗണിക്കേണ്ടിവന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"എന്റെ പ്രേമഭാജനമേ, എന്നോടു പറയൂ,","poem":1},{"text":"നിന്റെ ആട്ടിൻപറ്റങ്ങളുടെ മേച്ചിൽപ്പുറം എവിടെയാണ്?","poem":2},{"lineBreak":true},{"text":"അവയുടെ മധ്യാഹ്ന വിശ്രമസ്ഥാനം എവിടെയാണ്?","poem":2},{"text":"ഞാൻ എന്തിന് മുഖാവരണം അണിഞ്ഞവളെപ്പോലെ","poem":1},{"text":"നിന്റെ ചങ്ങാതിമാരുടെ ആട്ടിൻപറ്റങ്ങൾക്കരികെ അലഞ്ഞുതിരിയണം?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"സ്ത്രീകളിൽ അതിസുന്ദരീ, നിനക്കത് അജ്ഞാതമെങ്കിൽ","poem":1},{"text":"ആട്ടിൻപറ്റങ്ങളുടെ കാലടികൾ പിൻതുടരുകയും","poem":2},{"text":"നിന്റെ കുഞ്ഞാടുകളെ","poem":1},{"text":"ഇടയകൂടാരങ്ങൾക്കരികെ മേയ്ക്കുകയുംചെയ്യുക.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"എന്റെ പ്രിയേ, ഫറവോന്റെ രഥങ്ങളിലെ","poem":1},{"text":"മദിപ്പിക്കുന്ന പെൺകുതിരകളിലൊന്നിനെപ്പോലെയാകുന്നു നീ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"നിന്റെ കവിൾത്തടങ്ങൾ കർണാഭരണങ്ങളാലും","poem":1},{"text":"നിന്റെ കണ്ഠം രത്നാഭരണങ്ങളാലും അലംകൃതമായിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"വെള്ളിമണികൾകൊണ്ട് അലങ്കരിച്ച തങ്കക്കമ്മലുകൾ","poem":1},{"text":"ഞങ്ങൾ നിനക്കായി പണിയും.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"രാജാവ് ഭക്ഷണത്തിനിരുന്നപ്പോൾ,","poem":1},{"text":"എന്റെ സുഗന്ധതൈലം സൗരഭ്യം പരത്തി.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"എന്റെ പ്രിയൻ എനിക്ക്","poem":1},{"text":"എന്റെ സ്തനങ്ങൾക്കിടയിൽ വിശ്രമിക്കുന്ന മീറക്കെട്ടുപോലെ","poem":2},{"noteId":0},{"text":"ആകുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"എന്റെ പ്രിയൻ എനിക്ക് എൻ-ഗെദി മുന്തിരിത്തോപ്പുകളിലെ","poem":1},{"text":"മൈലാഞ്ചിപ്പൂക്കുലപോലെ ആകുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"എന്റെ പ്രിയേ! നീ എത്ര സുന്ദരി!","poem":1},{"text":"നീ സുന്ദരിതന്നെ!","poem":2},{"lineBreak":true},{"text":"നിന്റെ നയനങ്ങൾ പ്രാവുകൾപോലെതന്നെ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"എന്റെ പ്രിയാ, നീ എത്ര സുന്ദരൻ!","poem":1},{"text":"നീ അതിസുന്ദരൻതന്നെ!","poem":2},{"lineBreak":true},{"text":"നമ്മുടെ കിടക്കയും ശ്യാമളംതന്നെ.","poem":2},{"noteId":1}]},{"type":"verse","number":17,"content":[{"text":"നമ്മുടെ ഭവനത്തിന്റെ ഉത്തരങ്ങൾ ദേവദാരുക്കളാകുന്നു;","poem":1},{"text":"അതിന്റെ കഴുക്കോൽ സരളവൃക്ഷവുമാകുന്നു.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"അഥവാ, നറുമ്പശ","reference":{"chapter":1,"verse":13}},{"noteId":1,"caller":"+","text":"അഥവാ, പച്ചപ്പുതന്നെ","reference":{"chapter":1,"verse":16}}]},"thisChapterLink":"/api/mal_bib/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}