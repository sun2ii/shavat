{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"SNG","translationId":"mal_bib","name":"ഉത്തമഗീതം","commonName":"ഉത്തമഗീതം","title":"ശലോമോന്റെ ഉത്തമഗീതം","order":22,"numberOfChapters":8,"sha256":"7817410dbdd1910cc272bee571cbfe93d2fb0e4c5e2e630cef0b6b6f547c0e0a","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/mal_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"ഞാൻ ശാരോനിലെ പനിനീർകുസുമം","poem":1},{"text":"താഴ്വരകളിലെ ശോശന്നപ്പുഷ്പം.","poem":2},{"noteId":2}]},{"type":"verse","number":2,"content":[{"text":"മുള്ളുകൾക്കിടയിലെ ശോശന്നപ്പുഷ്പംപോലെയാണ്","poem":1},{"text":"യുവതികൾക്കിടയിലെ എന്റെ പ്രിയ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"വനവൃക്ഷങ്ങൾക്കിടയിലുള്ള ഒരു ആപ്പിൾമരം","poem":1},{"noteId":3},{"text":"പോലെയാണ്","poem":1},{"text":"യുവാക്കന്മാർക്കിടയിൽ നിൽക്കുന്ന എന്റെ പ്രിയൻ.","poem":2},{"text":"അവന്റെ നിഴലിൽ ഇരിക്കുന്നത് എനിക്ക് ആനന്ദമാകുന്നു","poem":1},{"text":"അവന്റെ ഫലം എന്റെ നാവിനു മധുരമേകുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവൻ എന്നെ വിരുന്നുശാലയിലേക്ക് ആനയിക്കുന്നു,","poem":1},{"text":"എന്റെമീതേ പറക്കുന്ന പതാക അവന്റെ സ്നേഹംതന്നെ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"മുന്തിരിയട തന്ന് എന്നെ ശക്തയാക്കൂ,","poem":1},{"text":"ആപ്പിൾകൊണ്ടെന്നെ ഉന്മേഷഭരിതയാക്കൂ,","poem":2},{"lineBreak":true},{"text":"കാരണം ഞാൻ പ്രേമപരവശയായിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവന്റെ ഇടതുകരത്തിന്മേൽ എന്റെ ശിരസ്സ് വിശ്രമിക്കുന്നു,","poem":1},{"text":"അവന്റെ വലതുകരം എന്നെ പുണരുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ജെറുശലേംപുത്രിമാരേ, വയലേലകളിലെ കലമാനുകളുടെയും","poem":1},{"text":"മാൻപേടകളുടെയുംപേരിൽ എനിക്കുറപ്പുനൽകുക:","poem":2},{"text":"അനുയോജ്യസമയം വരുംവരെ","poem":1},{"text":"പ്രേമം ഉത്തേജിപ്പിക്കുകയോ ഉണർത്തുകയോ അരുത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"കേൾക്കൂ! എന്റെ പ്രിയരേ,","poem":1},{"text":"പർവതങ്ങളിലൂടെ തുള്ളിച്ചാടിയും","poem":2},{"text":"കുന്നുകളിലൂടെ കുതിച്ചുചാടിയും","poem":1},{"text":"എന്റെ പ്രിയൻ ഇതാ വരുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"എന്റെ പ്രിയൻ കലമാനിനെപ്പോലെയോ മാൻകിടാവിനെപ്പോലെയോ ആകുന്നു.","poem":1},{"text":"ജനാലകളിലൂടെ നോക്കിക്കൊണ്ട്,","poem":2},{"text":"അഴികൾക്കിടയിലൂടെ ഒളിഞ്ഞുനോക്കിക്കൊണ്ട്,","poem":1},{"text":"ഇതാ, നമ്മുടെ മതിലിനു പുറത്ത് അവൻ നിൽക്കുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"എന്റെ പ്രിയൻ എന്നോടു മന്ത്രിച്ചു,","poem":1},{"text":"“എന്റെ പ്രിയേ, എഴുന്നേൽക്കൂ,","poem":2},{"lineBreak":true},{"text":"എന്റെ സുന്ദരീ, എന്നോടൊപ്പം വരിക.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"നോക്കൂ, ശീതകാലം കഴിഞ്ഞിരിക്കുന്നു","poem":1},{"text":"മഴക്കാലവും മാറിപ്പോയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"മണ്ണിൽ മലരുകൾ വിരിയുന്നു;","poem":1},{"text":"ഗാനാലാപനകാലവും","poem":2},{"noteId":4},{"text":"വന്നുചേർന്നിരിക്കുന്നു,","poem":2},{"text":"പ്രാവുകളുടെ കുറുകലും","poem":1},{"text":"നമ്മുടെ നാട്ടിൽ കേൾക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അത്തിമരത്തിൽ കന്നിക്കായ്കൾ പഴുക്കുന്നു;","poem":1},{"text":"പൂത്തുലഞ്ഞ മുന്തിരിവള്ളികൾ അതിന്റെ സുഗന്ധം പരത്തുന്നു.","poem":2},{"text":"എന്റെ പ്രിയേ, എഴുന്നേറ്റുവരിക","poem":1},{"text":"എന്റെ സുന്ദരീ, എന്നോടൊപ്പം വരിക.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"പാറപ്പിളർപ്പുകളിൽ,","poem":1},{"text":"അതേ മലയോരത്തെ ഒളിവിടങ്ങളിൽ ഇരിക്കുന്ന എന്റെ പ്രാവേ,","poem":2},{"text":"നിന്റെ മുഖം ഞാനൊന്നു കാണട്ടെ,","poem":1},{"text":"നിൻസ്വരം ഞാനൊന്നു കേൾക്കട്ടെ;","poem":2},{"text":"കാരണം നിന്റെ സ്വരം മധുരതരവും","poem":1},{"text":"നിന്റെ മുഖം രമണീയവും ആകുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"നമ്മുടെ മുന്തിരിത്തോപ്പുകൾ പൂത്തുലഞ്ഞുനിൽക്കുകയാൽ","poem":1},{"text":"കുറുക്കന്മാരെ ഞങ്ങൾക്കുവേണ്ടി പിടിക്കുവിൻ","poem":2},{"text":"മുന്തിരിത്തോപ്പുകൾ നശിപ്പിക്കുന്ന","poem":1},{"text":"ചെറുകുറുനരികളെത്തന്നെ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"എന്റെ പ്രിയൻ എന്റേതും ഞാൻ അവന്റേതുമാകുന്നു;","poem":1},{"text":"അവൻ ശോശന്നച്ചെടികൾക്കിടയിൽ മന്ദംമന്ദം നടക്കുന്നു.","poem":2},{"noteId":5}]},{"type":"verse","number":17,"content":[{"text":"ഉഷസ്സു പൊട്ടിവിടർന്ന്","poem":1},{"text":"ഇരുളിന്റെ നിഴലുകൾ മായുംവരെ,","poem":2},{"text":"എന്റെ പ്രിയനേ, എന്നിലേക്കണയുക;","poem":1},{"text":"ഒരു ചെറു കലമാനിനെപ്പോലെയോ","poem":2},{"text":"പർവതമേടുകളിലെ","poem":1},{"noteId":6},{"text":"മാൻകിടാവിനെപ്പോലെയോതന്നെ.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":2,"caller":"+","text":"അതായത്, ഒരുതരം ലില്ലിപ്പൂവ്","reference":{"chapter":2,"verse":1}},{"noteId":3,"caller":"+","text":"അഥവാ, ശീമബദാംപഴം, ചിലർ നാരകം എന്നും പരിഭാഷപ്പെടുത്തിയിട്ടുണ്ട്.","reference":{"chapter":2,"verse":3}},{"noteId":4,"caller":"+","text":"അഥവാ, മുന്തിരിത്തലകൾ വെട്ടിയൊതുക്കുന്നകാലം","reference":{"chapter":2,"verse":12}},{"noteId":5,"caller":"+","text":"അഥവാ, ആട്ടിൻപറ്റത്തെ മേയിക്കുന്നു","reference":{"chapter":2,"verse":16}},{"noteId":6,"caller":"+","text":"അഥവാ, ബേഥേർക്കുന്നുകൾ","reference":{"chapter":2,"verse":17}}]},"thisChapterLink":"/api/mal_bib/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}