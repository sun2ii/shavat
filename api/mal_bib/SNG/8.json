{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"SNG","translationId":"mal_bib","name":"ഉത്തമഗീതം","commonName":"ഉത്തമഗീതം","title":"ശലോമോന്റെ ഉത്തമഗീതം","order":22,"numberOfChapters":8,"sha256":"7817410dbdd1910cc272bee571cbfe93d2fb0e4c5e2e630cef0b6b6f547c0e0a","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/mal_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"എന്റെ അമ്മ മുലയൂട്ടിവളർത്തിയ","poem":1},{"text":"ഒരു സഹോദരൻ ആയിരുന്നു നീ എങ്കിൽ!","poem":2},{"text":"ഞാൻ നിന്നെ വെളിയിൽ കാണുമ്പോൾ,","poem":1},{"text":"എനിക്കു നിന്നെ ചുംബിക്കാമായിരുന്നു,","poem":2},{"lineBreak":true},{"text":"ആരും എന്നെ നിന്ദിക്കുമായിരുന്നില്ല.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ഞാൻ നിന്നെ എന്റെ മാതൃഗൃഹത്തിലേക്ക്","poem":1},{"text":"കൂട്ടിക്കൊണ്ടുപോകുമായിരുന്നു—","poem":2},{"lineBreak":true},{"text":"എനിക്കു പരിശീലനംതന്നവളുടെ ചാരത്തേക്കുതന്നെ.","poem":2},{"text":"സുഗന്ധരസംചേർത്ത വീഞ്ഞും","poem":1},{"text":"മാതളപ്പഴച്ചാറും ഞാൻ നിനക്ക് പാനംചെയ്യാൻ നൽകുമായിരുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവന്റെ ഇടതുകരത്തിന്മേൽ എന്റെ ശിരസ്സ് വിശ്രമിക്കുന്നു,","poem":1},{"text":"അവന്റെ വലതുകരം എന്നെ പുണരുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ജെറുശലേംപുത്രിമാരേ, എനിക്കുറപ്പുനൽകുക:","poem":1},{"text":"അനുയോജ്യസമയം വരുംവരെ","poem":2},{"lineBreak":true},{"text":"പ്രേമം ഉത്തേജിപ്പിക്കുകയോ ഉണർത്തുകയോ അരുത്.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"തന്റെ പ്രിയന്റെമേൽ ചാരി,","poem":1},{"text":"മരുഭൂമിയിൽനിന്ന് കയറിവരുന്നോരിവളാരാണ്?","poem":2},"യുവതി",{"text":"നിന്റെ അമ്മ നിന്നെ ഗർഭംധരിച്ച,","poem":1},{"text":"അതേ ആപ്പിൾമരച്ചുവട്ടിൽവെച്ചുതന്നെ ഞാൻ നിന്നെ ഉണർത്തി;","poem":2},{"lineBreak":true},{"text":"അവിടെത്തന്നെയാണല്ലോ പ്രസവവേദനയേറ്റ് അവൾ നിനക്കു ജന്മംനൽകിയത്.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"നിന്റെ ഹൃദയത്തിന്മേൽ എന്നെ ഒരു മുദ്രയായണിയൂ,","poem":1},{"text":"നിന്റെ ഭുജത്തിലെ മുദ്രപോലെതന്നെ;","poem":2},{"text":"കാരണം പ്രേമം മരണംപോലെതന്നെ ശക്തവും","poem":1},{"text":"അതിന്റെ തീവ്രത ശവക്കുഴിപോലെതന്നെ","poem":2},{"noteId":15},{"text":"കഠിനവുമാകുന്നു.","poem":2},{"text":"ജ്വലിക്കുന്ന അഗ്നിപോലെ അത് എരിയുന്നു,","poem":1},{"text":"ഉഗ്രമായ അഗ്നിനാളംപോലെതന്നെ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"പ്രേമാഗ്നി അണയ്ക്കാൻ ഒരു പ്രളയത്താലും കഴിയില്ല;","poem":1},{"text":"നദികൾക്കതിനെ ഒഴുക്കിക്കളയുന്നതിനും കഴിയില്ല.","poem":2},{"text":"ഒരാൾ സ്വഭവനത്തിലെ സർവസമ്പത്തും","poem":1},{"text":"പ്രേമസാക്ഷാത്കാരത്തിനായി നൽകിയാലും","poem":2},{"lineBreak":true},{"text":"ആ വാഗ്ദാനവും","poem":2},{"noteId":16},{"text":"അപഹാസ്യമാകുകയേയുള്ളൂ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ഞങ്ങൾക്കൊരു കുഞ്ഞുപെങ്ങളുണ്ട്,","poem":1},{"text":"അവളുടെ സ്തനങ്ങൾ ഇനിയും വളർന്നിട്ടില്ല","poem":2},{"text":"നമ്മുടെ പെങ്ങൾക്കു വിവാഹാലോചനവരുമ്പോൾ","poem":1},{"text":"അവൾക്കുവേണ്ടി നമുക്കെന്തുചെയ്യാൻ കഴിയും?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവൾ ഒരു മതിലാകുന്നെങ്കിൽ,","poem":1},{"text":"നാം അവൾക്കുമേൽ വെള്ളികൊണ്ടൊരു ഗോപുരം പണിതുയർത്തും","poem":2},{"text":"അവൾ ഒരു വാതിലാകുന്നെങ്കിൽ,","poem":1},{"text":"ദേവദാരു പലകകൾകൊണ്ട് അവൾക്കുചുറ്റും സംരക്ഷണംതീർക്കും.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ഞാൻ ഒരു മതിലാകുന്നു,","poem":1},{"text":"എന്റെ സ്തനങ്ങൾ ഗോപുരങ്ങൾപോലെയും.","poem":2},{"text":"അങ്ങനെ ഞാൻ അവന്റെ മിഴികൾക്ക്","poem":1},{"text":"ഒരുത്സവമായി.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ശലോമോന് ബാൽ-ഹാമോനിൽ ഒരു മുന്തിരിത്തോപ്പുണ്ടായിരുന്നു;","poem":1},{"text":"അദ്ദേഹം തന്റെ മുന്തിരിത്തോപ്പ് പാട്ടക്കർഷകരെ ഏൽപ്പിച്ചു.","poem":2},{"text":"അതിന്റെ ആദായവിഹിതമായി ഓരോരുത്തരും","poem":1},{"text":"ആയിരം വെള്ളിനാണയങ്ങൾ","poem":2},{"noteId":17},{"text":"വീതം പാട്ടം കെട്ടേണ്ടതായിട്ടുണ്ട്.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"എന്നാൽ ഇത് എന്റെ സ്വന്തം മുന്തിരിത്തോപ്പ്;","poem":1},{"text":"ശലോമോനേ, ആയിരം നിന്റേത്,","poem":2},{"lineBreak":true},{"text":"തോട്ടം കാക്കുന്നവർക്ക് ഇരുനൂറും.","poem":2},{"noteId":18}]},{"type":"verse","number":13,"content":[{"text":"പരിചാരികമാരായ തോഴിമാരോടൊപ്പം","poem":1},{"text":"ഉദ്യാനങ്ങളിൽ വസിക്കുന്നവളേ,","poem":2},{"lineBreak":true},{"text":"ഞാൻ നിന്റെ സ്വരം കേൾക്കട്ടെ!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"എന്റെ പ്രിയാ, നീ ഓടിപ്പോന്നാലും,","poem":1},{"text":"ഒരു ചെറു കലമാനിനെപ്പോലെ","poem":2},{"text":"പരിമളപർവതമേടുകളിലെ","poem":1},{"text":"മാൻകിടാവിനെപ്പോലെതന്നെ.","poem":2}]}],"footnotes":[{"noteId":15,"caller":"+","text":"അഥവാ, പാതാളം; മൂ.ഭാ. ഷിയോൽ","reference":{"chapter":8,"verse":6}},{"noteId":16,"caller":"+","text":"അഥവാ, അവൻ","reference":{"chapter":8,"verse":7}},{"noteId":17,"caller":"+","text":"ഏക. 12 കി.ഗ്രാം.","reference":{"chapter":8,"verse":11}},{"noteId":18,"caller":"+","text":"ഏക. 2.3 കി.ഗ്രാം.","reference":{"chapter":8,"verse":12}}]},"thisChapterLink":"/api/mal_bib/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}