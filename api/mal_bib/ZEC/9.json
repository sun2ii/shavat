{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ZEC","translationId":"mal_bib","name":"സെഖര്യാവ്","commonName":"സെഖര്യാവ്","title":"സെഖര്യാവിന്റെ പ്രവചനം","order":38,"numberOfChapters":14,"sha256":"11714dcd12260c671d91db1364f3adebe58953410f40f1cfce6561a662afc61a","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mal_bib/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":9,"content":[{"type":"heading","content":["ഇസ്രായേലിന്റെ ശത്രുക്കളുടെമേൽ ന്യായവിധി"]},{"type":"verse","number":1,"content":["ഒരു പ്രവചനം:",{"text":"യഹോവയുടെ വചനം ഹദ്രക്കുദേശത്തിനു വിരോധമായിരിക്കുന്നു,","poem":1},{"text":"അത് ദമസ്കോസിൽനിന്നു വന്നുപതിക്കും—","poem":2},{"text":"സകലമനുഷ്യരുടെയും ഇസ്രായേൽഗോത്രങ്ങളുടെയും ദൃഷ്ടി","poem":1},{"text":"യഹോവയുടെമേൽ ആകുന്നു—","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ദമസ്കോസിന്റെ അതിരിനടുത്തുള്ള ഹമാത്തിന്മേലും അത് ഉണ്ടായിരിക്കും,","poem":1},{"text":"വളരെ സമർഥരെങ്കിലും, സോരിനും സീദോനും അങ്ങനെതന്നെ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"സോർ ഒരു സുരക്ഷിതകേന്ദ്രം പണിതിരിക്കുന്നു;","poem":1},{"text":"അവൾ ചെളിപോലെ വെള്ളിയും","poem":2},{"lineBreak":true},{"text":"തെരുവീഥികളിലെ പൊടിപോലെ സ്വർണവും വാരിക്കൂട്ടിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"എന്നാൽ കർത്താവ് അവളുടെ സമ്പത്ത് എടുത്തുകളയും","poem":1},{"text":"അവളുടെ കെട്ടുറപ്പുള്ള കോട്ടകൾ കടലിലിട്ടു നശിപ്പിക്കും","poem":2},{"lineBreak":true},{"text":"അവൾ അഗ്നിയാൽ ദഹിപ്പിക്കപ്പെടും.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അസ്കലോൻ അതുകണ്ടു ഭയപ്പെടും;","poem":1},{"text":"ഗസ്സാ വേദനകൊണ്ടു പുളയും","poem":2},{"lineBreak":true},{"text":"തന്റെ പ്രത്യാശ നഷ്ടപ്പെടുന്നതുകൊണ്ട് എക്രോനും.","poem":2},{"text":"ഗസ്സായ്ക്കു രാജാവ് നഷ്ടമാകും","poem":1},{"text":"അസ്കലോൻ ജനവാസം ഇല്ലാത്തതായിത്തീരും.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"സമ്മിശ്രജനത അശ്ദോദ് കൈവശമാക്കും","poem":1},{"text":"ഫെലിസ്ത്യരുടെ അഹങ്കാരം ഞാൻ അവസാനിപ്പിക്കും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ഞാൻ, അവരുടെ വായിൽനിന്നു രക്തവും","poem":1},{"text":"അവരുടെ പല്ലുകൾക്കിടയിൽനിന്നു വിലക്കപ്പെട്ട ആഹാരവും എടുത്തുകളയും.","poem":2},{"text":"ഫെലിസ്ത്യരിൽ ശേഷിക്കുന്നവരും നമ്മുടെ ദൈവത്തിന് അവകാശപ്പെട്ടവരാകും.","poem":1},{"text":"അവർ യെഹൂദയിലെ ഒരു കുലംപോലെ ആയിത്തീരും,","poem":2},{"lineBreak":true},{"text":"എക്രോൻ യെബൂസ്യരെപ്പോലെയും ആകും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"എന്നാൽ കൊള്ളക്കാരിൽനിന്ന്","poem":1},{"text":"ഞാൻ എന്റെ ആലയത്തെ കാക്കുന്നതിന് അതിനുചുറ്റും പാളയമിറങ്ങും.","poem":2},{"text":"ഞാൻ ഇപ്പോൾ കാവൽചെയ്യുന്നതുകൊണ്ട്,","poem":1},{"text":"ഒരു പീഡകനും എന്റെ ജനത്തെ കീഴ്‌മേൽ മറിക്കുകയില്ല.","poem":2}]},{"type":"heading","content":["സീയോൻ രാജാവ് വരുന്നു"]},{"type":"verse","number":9,"content":[{"text":"സീയോൻപുത്രീ, ഉച്ചത്തിൽ ഘോഷിച്ചാനന്ദിക്കുക!","poem":1},{"text":"ജെറുശലേംപുത്രീ, ആർപ്പിടുക!","poem":2},{"text":"ഇതാ, നിന്റെ രാജാവ് നിന്റെ അടുത്തേക്കു വരുന്നു—","poem":1},{"text":"നീതിമാനും വിജയശ്രീലാളിതനും","poem":2},{"text":"സൗമ്യതയുള്ളവനുമായി, കഴുതപ്പുറത്തുകയറി,","poem":1},{"text":"പെൺകഴുതയുടെ കുട്ടിയായ ചെറുകഴുതപ്പുറത്തുകയറി വരുന്നു!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ഞാൻ എഫ്രയീമിൽനിന്നു രഥങ്ങളെയും","poem":1},{"text":"ജെറുശലേമിൽനിന്നു യുദ്ധക്കുതിരകളെയും എടുത്തുകളയും,","poem":2},{"lineBreak":true},{"text":"യുദ്ധത്തിനുള്ള വില്ല് ഒടിച്ചുകളയും.","poem":2},{"text":"അവിടന്ന് രാജ്യങ്ങൾക്ക് സമാധാനം പ്രഖ്യാപിക്കും.","poem":1},{"text":"അവിടത്തെ ആധിപത്യം സമുദ്രംമുതൽ സമുദ്രംവരെയും","poem":2},{"lineBreak":true},{"text":"നദിമുതൽ","poem":2},{"noteId":6},{"text":"ഭൂമിയുടെ അറ്റത്തോളവും ആയിരിക്കും.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"നീയോ, നിന്നോടുള്ള എന്റെ ഉടമ്പടിയുടെ രക്തംമൂലം","poem":1},{"text":"ഞാൻ നിന്റെ ബന്ധിതരെ വെള്ളമില്ലാത്ത കുഴികളിൽനിന്നു മോചിപ്പിക്കും.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"പ്രത്യാശയുള്ള ബന്ധിതരേ, നിങ്ങളുടെ കോട്ടയിലേക്കു മടങ്ങിപ്പോകുവിൻ;","poem":1},{"text":"നിങ്ങൾക്ക് ഇരട്ടിയായി മടക്കിത്തരുമെന്ന് ഞാൻ പ്രഖ്യാപിക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ഞാൻ എന്റെ വില്ല് കുലയ്ക്കുന്നതുപോലെ യെഹൂദയെ വളയ്ക്കും,","poem":1},{"text":"എഫ്രയീമിനെ ഞാൻ അസ്ത്രംകൊണ്ടു നിറച്ചുമിരിക്കുന്നു.","poem":2},{"text":"സീയോനേ, ഞാൻ നിന്റെ പുത്രന്മാരെ ഉണർത്തി","poem":1},{"text":"ഒരു യുദ്ധവീരന്റെ വാൾപോലെയാക്കും;","poem":2},{"lineBreak":true},{"text":"ഗ്രീക്കുദേശമേ,","poem":2},{"noteId":7},{"text":"നിന്റെ പുത്രന്മാർക്കെതിരേതന്നെ.","poem":2}]},{"type":"heading","content":["യഹോവ പ്രത്യക്ഷനാകും"]},{"type":"verse","number":14,"content":[{"text":"അപ്പോൾ അവരുടെമേൽ യഹോവ പ്രത്യക്ഷനാകും;","poem":1},{"text":"അവിടത്തെ അമ്പ് മിന്നൽപ്പിണർപോലെ ചീറിപ്പായും.","poem":2},{"text":"യഹോവയായ കർത്താവ് കാഹളംധ്വനിപ്പിക്കും;","poem":1},{"text":"അവിടന്ന് തെക്കൻകാറ്റുകളിൽ മുന്നേറും.","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"സൈന്യങ്ങളുടെ യഹോവ അവരെ സംരക്ഷിക്കും.","poem":2},{"text":"അവർ കവിണക്കല്ലുകളാൽ","poem":1},{"text":"വിനാശംവരുത്തി വിജയംനേടും;","poem":2},{"text":"അവർ കുടിക്കും, മദ്യപരെപ്പോലെ അട്ടഹസിക്കും.","poem":1},{"text":"അവർ യാഗപീഠത്തിന്റെ കോണുകളിൽ തളിക്കാനുള്ള","poem":2},{"lineBreak":true},{"text":"നിറഞ്ഞ പാത്രംപോലെ ആയിരിക്കും.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ഇടയൻ തന്റെ ആട്ടിൻകൂട്ടത്തെ സംരക്ഷിക്കുന്നതുപോലെ","poem":1},{"text":"ആ ദിവസം അവരുടെ ദൈവമായ യഹോവ തന്റെ ജനത്തെ സംരക്ഷിക്കും.","poem":2},{"text":"ഒരു കിരീടത്തിൽ രത്നങ്ങൾപോലെ","poem":1},{"text":"അവർ അവിടത്തെ ദേശത്തു മിന്നിത്തിളങ്ങും.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവർ എത്ര ആകർഷണീയരും സൗന്ദര്യപൂർണരും ആയിരിക്കും!","poem":1},{"text":"ധാന്യം യുവാക്കന്മാരെയും","poem":2},{"lineBreak":true},{"text":"പുതുവീഞ്ഞ് യുവതികളെയും പുഷ്ടിയുള്ളവരാക്കും.","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"അതായത്, യൂഫ്രട്ടീസ് നദി","reference":{"chapter":9,"verse":10}},{"noteId":7,"caller":"+","text":"മൂ.ഭാ. യവനദേശമേ","reference":{"chapter":9,"verse":13}}]},"thisChapterLink":"/api/mal_bib/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ZEC/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ZEC/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}