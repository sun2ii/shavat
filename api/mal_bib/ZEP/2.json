{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ZEP","translationId":"mal_bib","name":"സെഫന്യാവ്","commonName":"സെഫന്യാവ്","title":"സെഫന്യാവിന്റെ പ്രവചനം","order":36,"numberOfChapters":3,"sha256":"030da41f4d05c7c820e266c73f335f196ef8f0cd9dc75c69a60a4f68f28352f3","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mal_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"heading","content":["യെഹൂദയും ജെറുശലേമും ഇതര രാഷ്ട്രങ്ങൾക്കൊപ്പം വിധിക്കപ്പെടുന്നു"]},{"type":"heading","content":["അനുതാപത്തിനായി യെഹൂദയെ ആഹ്വാനംചെയ്യുന്നു"]},{"type":"verse","number":1,"content":[{"text":"നാണംകെട്ട ജനതയേ,","poem":1},{"text":"കൂട്ടിവരുത്തുക, നിങ്ങൾ നിങ്ങളെത്തന്നെ കൂട്ടിവരുത്തുക.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"നിശ്ചയിക്കപ്പെട്ട സമയം വന്നെത്തുന്നതിനും","poem":1},{"text":"ആ ദിവസം പതിരുപോലെ വീശിക്കളയുന്നതിനുംമുമ്പേ,","poem":2},{"text":"യഹോവയുടെ ഭയങ്കരകോപം","poem":1},{"text":"നിന്റെമേൽ വരുന്നതിനുംമുമ്പേ,","poem":2},{"text":"യഹോവയുടെ ക്രോധദിവസം","poem":1},{"text":"നിന്റെമേൽ വരുന്നതിനുംമുമ്പേതന്നെ കൂടിവരിക.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ദേശത്തിലെ എളിയവരേ, അവിടത്തെ കൽപ്പനകൾ അനുസരിക്കുന്നവരേ,","poem":1},{"text":"യഹോവയെ അന്വേഷിക്കുക.","poem":2},{"text":"നീതിയെ അന്വേഷിക്കുക, താഴ്മയെ അന്വേഷിക്കുക;","poem":1},{"text":"പക്ഷേ, യഹോവയുടെ കോപദിവസത്തിൽ","poem":2},{"lineBreak":true},{"text":"നിങ്ങൾക്ക് സംരക്ഷണം ലഭിക്കും.","poem":2}]},{"type":"heading","content":["ഫെലിസ്ത്യദേശത്തിനുനേരേ"]},{"type":"verse","number":4,"content":[{"text":"ഗസ്സാ ഉപേക്ഷിക്കപ്പെടും","poem":1},{"text":"അസ്കലോൻ ഉന്മൂലനംചെയ്യപ്പെടും.","poem":2},{"text":"നട്ടുച്ചയ്ക്ക് അശ്ദോദ് ശൂന്യമാകും","poem":1},{"text":"എക്രോൻ തകർന്നുപോകും.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"സമുദ്രതീരവാസികളേ,","poem":1},{"text":"കെരീത്യരേ, നിങ്ങൾക്കു ഹാ കഷ്ടം!","poem":2},{"text":"ഫെലിസ്ത്യരുടെ ദേശമായ കനാനേ,","poem":1},{"text":"യഹോവയുടെ വചനം നിങ്ങൾക്കു വിരോധമായിരിക്കുന്നു:","poem":2},{"text":"“ഞാൻ നിന്നെ നശിപ്പിക്കും.","poem":1},{"text":"ആരും ശേഷിക്കുകയില്ല.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ക്രേത്യർ വസിക്കുന്ന സമുദ്രതീരം ഇടയന്മാർക്കു കുടിലുകളും","poem":1},{"text":"ആട്ടിൻകൂട്ടത്തിനു തൊഴുത്തുകളുമുള്ള","poem":2},{"lineBreak":true},{"text":"പുൽപ്പുറമായിത്തീരും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ആ ദേശം യെഹൂദാഗൃഹത്തിന്റെ","poem":1},{"text":"ശേഷിപ്പിന് അവകാശമാകും;","poem":2},{"lineBreak":true},{"text":"അവർ അവിടെ മേച്ചിൽപ്പുറം കണ്ടെത്തും.","poem":2},{"text":"സായാഹ്നത്തിൽ അവർ","poem":1},{"text":"അസ്കലോൻവീടുകളിൽ കിടക്കും.","poem":2},{"text":"അവരുടെ ദൈവമായ യഹോവ അവർക്കുവേണ്ടി കരുതും;","poem":1},{"text":"അവിടന്ന് അവരെ സന്ദർശിച്ച് അവരുടെ സൗഭാഗ്യം പുനഃസ്ഥാപിക്കും.","poem":2}]},{"type":"heading","content":["മോവാബിനും അമ്മോനും എതിരേ"]},{"type":"verse","number":8,"content":[{"text":"“എന്റെ ജനതയെ അപമാനിച്ചവരും","poem":1},{"text":"അവരുടെ ദേശത്തെ ഭീഷണിപ്പെടുത്തിയവരുമായ","poem":2},{"text":"മോവാബിന്റെ അപമാനവും","poem":1},{"text":"അമ്മോന്യരുടെ ധിക്കാരവും ഞാൻ കേട്ടിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അതുകൊണ്ട്, മോവാബ് നിശ്ചയമായും സൊദോമിനെപ്പോലെയും","poem":1},{"text":"അമ്മോന്യർ ഗൊമോറായെപ്പോലെയും—","poem":2},{"lineBreak":true},{"text":"പൊന്തക്കാടും ഉപ്പുകുഴികളും നിറഞ്ഞ്","poem":2},{"text":"എന്നേക്കും ശൂന്യമായിത്തീരും,","poem":1},{"text":"എന്ന് ഇസ്രായേലിന്റെ ദൈവമായ","poem":2},{"text":"സൈന്യങ്ങളുടെ യഹോവ,","poem":1},{"text":"ജീവനുള്ള ഞാൻ ശപഥംചെയ്തിരിക്കുന്നു.","poem":2},{"text":"എന്റെ ജനത്തിൽ ശേഷിച്ചിരിക്കുന്നവർ അവരെ കൊള്ളയിടും","poem":1},{"text":"എന്റെ രാജ്യത്തിൽ ജീവനോടിരിക്കുന്നവർ അവരുടെ ദേശം അവകാശമാക്കും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"അവരുടെ നിഗളത്തിന്റെ പ്രതിഫലമായി അവർക്കു ലഭിക്കുന്നത് ഇതുതന്നെ,","poem":1},{"text":"കാരണം, സൈന്യങ്ങളുടെ യഹോവയുടെ ജനത്തെ","poem":2},{"lineBreak":true},{"text":"അവർ അപമാനിക്കുകയും പരിഹസിക്കുകയുംചെയ്തല്ലോ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"യഹോവ ഭൂമിയിലെ സകലദേവതകളെയും നശിപ്പിക്കുമ്പോൾ","poem":1},{"text":"അവിടന്ന് അവർക്കെതിരേ ഭയങ്കരനായിരിക്കും.","poem":2},{"text":"വിദൂരങ്ങളിലുള്ള സകലരാഷ്ട്രങ്ങളും യഹോവയെ നമസ്കരിക്കും,","poem":1},{"text":"അവരെല്ലാവരും അവരവരുടെ ദേശത്തുവെച്ചുതന്നെ.","poem":2}]},{"type":"heading","content":["കൂശിനെതിരേ"]},{"type":"verse","number":12,"content":[{"text":"“കൂശ്യരേ, നിങ്ങളും","poem":1},{"text":"എന്റെ വാളിനാൽ വധിക്കപ്പെടും.”","poem":2}]},{"type":"heading","content":["അശ്ശൂരിനെതിരേ"]},{"type":"verse","number":13,"content":[{"text":"അവിടന്ന് തന്റെ കരം വടക്ക്","poem":1},{"text":"അശ്ശൂരിനെതിരേ നീട്ടി അതിനെ നശിപ്പിക്കും.","poem":2},{"text":"നിനവേ അശേഷം ശൂന്യമാകും;","poem":1},{"text":"മരുഭൂമിപോലെ വരണ്ടുണങ്ങിപ്പോകും.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ആട്ടിൻപറ്റങ്ങളും സകലതരം ജന്തുക്കളും","poem":1},{"text":"അവിടെക്കിടക്കും.","poem":2},{"text":"അതിന്റെ തൂണുകൾക്കു മധ്യത്തിൽ","poem":1},{"text":"മൂങ്ങയും നത്തും രാപാർക്കും.","poem":2},{"text":"അവയുടെ ശബ്ദം ജനാലകളിൽ പ്രതിധ്വനിക്കും","poem":1},{"text":"വാതിലിനുമുമ്പിൽ ചണ്ടിക്കൂമ്പാരങ്ങൾ നിറഞ്ഞുകിടക്കും","poem":2},{"lineBreak":true},{"text":"ദേവദാരുകൊണ്ടുള്ള ഉത്തരങ്ങൾ വെയിലുംമഴയും ഏറ്റുകിടക്കും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഇതാ, ആഹ്ലാദത്തിമിർപ്പിന്റെ പട്ടണം;","poem":1},{"text":"സുരക്ഷിതമായി പാർത്തിരുന്ന ഇടംതന്നെ.","poem":2},{"text":"അവൾ സ്വയം പറഞ്ഞു;","poem":1},{"text":"“ഞാൻ അല്ലാതെ എന്നെപ്പോലെ മറ്റാരുമില്ല.”","poem":2},{"text":"അവൾ എത്ര വലിയ നാശത്തിന് ഇരയായി,","poem":1},{"text":"വന്യമൃഗങ്ങളുടെ ആവാസസ്ഥാനമായി!","poem":2},{"text":"കടന്നുപോകുന്നവർ പരിഹസിക്കുകയും","poem":1},{"text":"മുഷ്ടി കുലുക്കുകയും ചെയ്യുന്നു.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}