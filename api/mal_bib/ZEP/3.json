{"translation":{"id":"mal_bib","name":"Biblica® സ്വതന്ത്രം സമകാലിക മലയാളവിവർത്തനം","website":"https://ebible.org/Scriptures/details.php?id=malc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=malc","licenseNotes":null,"shortName":"BIB","englishName":"Malayalam Contemporary Bible","language":"mal","textDirection":"ltr","sha256":"23f153150f054035cb2aae30e5fa56b00ecf6ba79f9e10d158e67e00e408ac56","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30940,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ZEP","translationId":"mal_bib","name":"സെഫന്യാവ്","commonName":"സെഫന്യാവ്","title":"സെഫന്യാവിന്റെ പ്രവചനം","order":36,"numberOfChapters":3,"sha256":"030da41f4d05c7c820e266c73f335f196ef8f0cd9dc75c69a60a4f68f28352f3","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mal_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["ജെറുശലേമിനെതിരേ"]},{"type":"verse","number":1,"content":[{"text":"പീഡകരുടെയും മത്സരികളുടെയും","poem":1},{"text":"അശുദ്ധരുടെയും പട്ടണത്തിന് ഹാ കഷ്ടം!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവൾ ആരെയും അനുസരിക്കുന്നില്ല,","poem":1},{"text":"അവൾക്കു പ്രബോധനം സ്വീകാര്യമല്ല.","poem":2},{"text":"അവൾ യഹോവയിൽ ആശ്രയിക്കുന്നില്ല,","poem":1},{"text":"അവൾ തന്റെ ദൈവത്തോട് അടുത്തുവരുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവളുടെ ഉദ്യോഗസ്ഥർ","poem":1},{"text":"അലറുന്ന സിംഹങ്ങൾ;","poem":2},{"text":"അവളുടെ അധിപന്മാർ പ്രഭാതത്തിനായി ഒന്നും ശേഷിപ്പിക്കാത്ത","poem":1},{"text":"സന്ധ്യാസമയത്ത് അലയുന്ന ചെന്നായ്ക്കൾ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവളുടെ പ്രവാചകന്മാർ താന്തോന്നികൾ,","poem":1},{"text":"അവർ വഞ്ചകന്മാർതന്നെ.","poem":2},{"text":"അവളുടെ പുരോഹിതന്മാർ മന്ദിരത്തെ അശുദ്ധമാക്കുന്നു,","poem":1},{"text":"അവർ ന്യായപ്രമാണത്തോട് അതിക്രമംചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"നീതിമാനായ യഹോവ അവളിൽ വസിക്കുന്നു;","poem":1},{"text":"അവിടന്ന് അനീതി ചെയ്യുന്നില്ല.","poem":2},{"text":"പ്രഭാതംതോറും അവിടന്ന് നീതി നടപ്പാക്കുന്നു,","poem":1},{"text":"ഓരോ പുതിയ ദിവസവും അവിടന്ന് അതിനു മുടക്കം വരുത്തുന്നില്ല,","poem":2},{"lineBreak":true},{"text":"എങ്കിലും നീതികെട്ടവർക്കു നാണമില്ല.","poem":2}]},{"type":"heading","content":["ജെറുശലേം അനുതപിക്കുന്നില്ല"]},{"type":"verse","number":6,"content":[{"text":"“ഞാൻ രാജ്യങ്ങളെ ഛേദിച്ചുകളഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"അവരുടെ സുരക്ഷിതകേന്ദ്രങ്ങൾ തകർത്തിരിക്കുന്നു.","poem":2},{"text":"ഞാൻ അവരുടെ തെരുവുകൾ ശൂന്യമാക്കി,","poem":1},{"text":"ആരും അവിടെ വഴിനടക്കുന്നില്ല.","poem":2},{"text":"അവരുടെ പട്ടണങ്ങൾ നശിച്ചിരിക്കുന്നു;","poem":1},{"text":"ആരും, ഒരുത്തൻപോലും ശേഷിക്കുകയില്ല.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"‘നിശ്ചയമായും നീ എന്നെ ഭയപ്പെട്ട്","poem":1},{"text":"എന്റെ പ്രബോധനം അംഗീകരിക്കും,’","poem":2},{"lineBreak":true},{"text":"എന്നു ഞാൻ അവരെക്കുറിച്ചു ചിന്തിച്ചു.","poem":2},{"text":"അങ്ങനെ ചെയ്തിരുന്നെങ്കിൽ അവരുടെ വാസസ്ഥലം ശൂന്യമാകുകയില്ലായിരുന്നു,","poem":1},{"text":"എന്റെ യാതൊരു ശിക്ഷയും അവളുടെമേൽ വരികയുമില്ലായിരുന്നു.","poem":2},{"text":"എന്നിട്ടും അവരുടെ സകലദുഷ്‍പ്രവൃത്തിയിലും","poem":1},{"text":"അവർ ജാഗ്രതയുള്ളവരായിരുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അതിനാൽ, എനിക്കായി കാത്തിരിക്കുക,” എന്ന് യഹോവ അരുളിച്ചെയ്യുന്നു.","poem":1},{"text":"“ഞാൻ സാക്ഷ്യത്തിന് എഴുന്നേൽക്കുന്ന ദിവസത്തിനായിത്തന്നെ.","poem":2},{"text":"രാഷ്ട്രങ്ങളെയും രാജ്യങ്ങളെയും കൂട്ടിവരുത്താനും","poem":1},{"text":"എന്റെ ക്രോധത്തെയും","poem":2},{"text":"എന്റെ ഭയങ്കരകോപമെല്ലാം","poem":1},{"text":"അവരുടെമേൽ വർഷിക്കാനും ഞാൻ തീരുമാനിച്ചിരിക്കുന്നു.","poem":2},{"text":"എന്റെ തീക്ഷ്ണകോപത്തിന്റെ അഗ്നിയിൽ","poem":1},{"text":"സർവലോകവും ദഹിച്ചുപോകും.","poem":2}]},{"type":"heading","content":["ഇസ്രായേലിന്റെ ശേഷിപ്പിന്റെ പുനഃസ്ഥാപനം"]},{"type":"verse","number":9,"content":[{"text":"“അപ്പോൾ യഹോവയുടെ നാമം വിളിച്ചപേക്ഷിക്കുന്നതിനും","poem":1},{"text":"ഏകമനസ്സോടെ യഹോവയെ സേവിക്കുന്നതിനും","poem":2},{"lineBreak":true},{"text":"ഞാൻ ജനതകളുടെ അധരങ്ങൾ ശുദ്ധീകരിക്കും.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"എന്റെ ആരാധകരും ചിതറിപ്പോയ എന്റെ ജനവും","poem":1},{"text":"കൂശിലെ നദിക്കപ്പുറത്തുനിന്ന്","poem":2},{"lineBreak":true},{"text":"എനിക്കു നേർച്ചകൾ കൊണ്ടുവരും.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"നിങ്ങൾ എന്നോടു ചെയ്തിട്ടുള്ള സകല അതിക്രമങ്ങളും നിമിത്തം","poem":1},{"text":"ആ ദിവസത്തിൽ നിങ്ങൾ ലജ്ജിക്കേണ്ടിവരികയില്ല.","poem":2},{"text":"തങ്ങളുടെ അഹങ്കാരത്തിൽ സന്തോഷിക്കുന്നവരെ","poem":1},{"text":"ഞാൻ നിങ്ങളിൽനിന്നു നീക്കിക്കളയും.","poem":2},{"text":"എന്റെ വിശുദ്ധപർവതത്തിൽ","poem":1},{"text":"നിങ്ങൾ ഇനിയൊരിക്കലും ധാർഷ്ട്യക്കാരായിരിക്കുകയില്ല.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"താഴ്മയും സൗമ്യതയും ഉള്ളവരായി,","poem":1},{"text":"യഹോവയുടെ നാമത്തിൽ ആശ്രയിക്കുന്ന","poem":2},{"text":"ഇസ്രായേലിന്റെ ഒരു ശേഷിപ്പിനെ","poem":1},{"text":"ഞാൻ നിന്റെ നടുവിൽ ശേഷിപ്പിക്കും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അവർ അതിക്രമം ചെയ്യുകയില്ല;","poem":1},{"text":"അവർ വ്യാജം പറയുകയുമില്ല.","poem":2},{"text":"അവരുടെ നാവുകളിൽ","poem":1},{"text":"വഞ്ചനയും ഉണ്ടായിരിക്കുകയില്ല.","poem":2},{"text":"അവർ ഭക്ഷിച്ചു കിടന്നുറങ്ങും","poem":1},{"text":"ആരും അവരെ ഭയപ്പെടുത്തുകയില്ല.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"സീയോൻപുത്രീ, പാടുക,","poem":1},{"text":"ഇസ്രായേലേ, ഉച്ചത്തിൽ ആർത്തുവിളിക്കുക!","poem":2},{"text":"ജെറുശലേംപുത്രീ,","poem":1},{"text":"പൂർണഹൃദയത്തോടെ സന്തോഷിച്ച് ആനന്ദിക്കുക!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"യഹോവ നിന്റെ ശിക്ഷ നീക്കിക്കളഞ്ഞിരിക്കുന്നു,","poem":1},{"text":"അവിടന്ന് നിന്റെ ശത്രുവിനെ പിന്തിരിപ്പിച്ചിരിക്കുന്നു.","poem":2},{"text":"ഇസ്രായേലിന്റെ രാജാവായ യഹോവ നിന്നോടുകൂടെയുണ്ട്;","poem":1},{"text":"നീ ഇനി ഒരാപത്തും ഭയപ്പെടേണ്ടതില്ല.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ആ ദിവസത്തിൽ","poem":1},{"text":"അവർ ജെറുശലേമിനോടു പറയും:","poem":2},{"text":"“സീയോനേ, ഭയപ്പെടേണ്ട,","poem":1},{"text":"നിന്റെ കരങ്ങൾ നിശ്ചലമാകേണ്ടതില്ല.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"നിന്റെ ദൈവമായ യഹോവ നിന്നോടുകൂടെയുണ്ട്,","poem":1},{"text":"അവിടന്ന് രക്ഷിക്കാൻ ശക്തൻ.","poem":2},{"text":"അവിടന്ന് നിന്നിൽ അധികം സന്തോഷിക്കും;","poem":1},{"text":"യഹോവ തന്റെ സ്നേഹത്തിൽ ഇനിയൊരിക്കലും നിന്നെ ശാസിക്കുകയില്ല,","poem":2},{"lineBreak":true},{"text":"എന്നാൽ സംഗീതത്തോടെ അവിടന്ന് നിന്നിൽ ആനന്ദിക്കും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“നിർദിഷ്ട പെരുന്നാളുകൾ നഷ്ടമായത്","poem":1},{"text":"നിങ്ങൾക്കൊരു ഭാരവും ലജ്ജയും ആണല്ലോ","poem":2},{"lineBreak":true},{"text":"അതേക്കുറിച്ച് വിലപിക്കുന്നവർ ഇനി നിങ്ങളിൽ ഉണ്ടായിരിക്കുകയില്ല.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"നിന്നെ പീഡിപ്പിച്ച സകലരോടും","poem":1},{"text":"ആ കാലത്ത് ഞാൻ ഇടപെടും.","poem":2},{"text":"ഞാൻ മുടന്തനെ വിടുവിക്കും;","poem":1},{"text":"ചിതറിപ്പോയവരെ കൂട്ടിച്ചേർക്കും.","poem":2},{"text":"അവരെ ലജ്ജിതരാക്കിയ എല്ലാ ദേശങ്ങളിലും","poem":1},{"text":"ഞാൻ അവർക്കു മഹത്ത്വവും പുകഴ്ചയും നൽകും.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ആ കാലത്ത് ഞാൻ നിങ്ങളെ ശേഖരിക്കും;","poem":1},{"text":"ആ കാലത്ത് ഞാൻ നിങ്ങളെ ഭവനങ്ങളിൽ കൂട്ടിച്ചേർക്കും.","poem":2},{"text":"നിങ്ങളുടെ സ്വന്തം ദൃഷ്ടികൾക്കുമുമ്പിൽ","poem":1},{"text":"ഞാൻ നിങ്ങളുടെ പ്രവാസികളെ മടക്കിവരുത്തുമ്പോൾ,","poem":2},{"text":"ഭൂമിയിലെ സകലജനങ്ങളുടെയും മധ്യത്തിൽ","poem":1},{"text":"ഞാൻ നിങ്ങൾക്കു മഹത്ത്വവും പുകഴ്ചയും നൽകും,”","poem":2},{"text":"ഇത് യഹോവയുടെ അരുളപ്പാട്.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/mal_bib/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_bib/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_bib/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}