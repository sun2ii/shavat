{"translation":{"id":"mal_fbf","name":"മലയാളം സത്യവേദപുസ്തകം 1910 - പരിഷ്കരിച്ച പതിപ്പ്, സമകാലിക ലിപിയിൽ","website":"https://ebible.org/Scriptures/details.php?id=mal2015","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal2015","licenseNotes":null,"shortName":"FBF","englishName":"Malayalam 1910  Contemporary Orthography","language":"mal","textDirection":"ltr","sha256":"a0a76289883f7cdd3bbbf3947f9880dcd26dd2da7190aa996bdbd83636782aa9","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_fbf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"JOB","translationId":"mal_fbf","name":"ഇയ്യോബ്","commonName":"ഇയ്യോബ്","title":"ഇയ്യോബ്","order":18,"numberOfChapters":42,"sha256":"31da34a3aa29f172680edea871cafc3292b256abad3b99d37e75029e3c2bf04d","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_fbf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mal_fbf/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":["വിളിച്ചുനോക്കുക; ഉത്തരം പറയുന്നവനുണ്ടോ?",{"text":"നീ വിശുദ്ധന്മാരിൽ ആരെ ശരണം പ്രാപിക്കും?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"നീരസം ഭോഷനെ കൊല്ലുന്നു;","poem":1},{"lineBreak":true},{"text":"ഈർഷ്യ മൂഢനെ ഹിംസിക്കുന്നു.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"മൂഢൻ വേരൂന്നുന്നതു ഞാൻ കണ്ടു","poem":1},{"lineBreak":true},{"text":"ക്ഷണത്തിൽ അവന്റെ പാർപ്പിടത്തെ ശപിച്ചു.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"അവന്റെ മക്കൾ രക്ഷയോടകന്നിരിക്കുന്നു;","poem":1},{"lineBreak":true},{"text":"അവർ രക്ഷകനില്ലാതെ വാതില്ക്കൽവെച്ചു തകർന്നുപോകുന്നു.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"അവന്റെ വിളവു വിശപ്പുള്ളവൻ തിന്നുകളയും;","poem":1},{"lineBreak":true},{"text":"മുള്ളുകളിൽനിന്നും അതിനെ പറിച്ചെടുക്കും;","poem":1},{"lineBreak":true},{"text":"അവരുടെ സമ്പത്തു ദാഹമുള്ളവർ കപ്പിക്കളയും.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"അനർത്ഥം ഉത്ഭവിക്കുന്നതു പൂഴിയിൽനിന്നല്ല;","poem":1},{"lineBreak":true},{"text":"കഷ്ടത മുളെക്കുന്നതു നിലത്തുനിന്നുമല്ല;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"തീപ്പൊരി ഉയരെ പറക്കുംപോലെ","poem":1},{"lineBreak":true},{"text":"മനുഷ്യൻ കഷ്ടതെക്കായി ജനിച്ചിരിക്കുന്നു.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ഞാനോ ദൈവത്തിങ്കലേക്കു നോക്കുമായിരുന്നു;","poem":1},{"lineBreak":true},{"text":"എന്റെ കാര്യം ദൈവത്തിങ്കൽ ഏല്പിക്കുമായിരുന്നു;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"അവൻ, ആരാഞ്ഞുകൂടാത്ത വങ്കാര്യങ്ങളും","poem":1},{"lineBreak":true},{"text":"അസംഖ്യമായ അത്ഭുതങ്ങളും ചെയ്യുന്നു.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"അവൻ ഭൂതലത്തിൽ മഴപെയ്യിക്കുന്നു;","poem":1},{"lineBreak":true},{"text":"വയലുകളിലേക്കു വെള്ളം വിടുന്നു.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"അവൻ താണവരെ ഉയർത്തുന്നു;","poem":1},{"lineBreak":true},{"text":"ദുഃഖിക്കുന്നവരെ രക്ഷയിലേക്കു കയറ്റുന്നു.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"അവൻ ഉപായികളുടെ സൂത്രങ്ങളെ അബദ്ധമാക്കുന്നു;","poem":1},{"lineBreak":true},{"text":"അവരുടെ കൈകൾ കാര്യം സാധിപ്പിക്കയുമില്ല.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"അവൻ ജ്ഞാനികളെ അവരുടെ കൗശലത്തിൽ പിടിക്കുന്നു;","poem":1},{"lineBreak":true},{"text":"വക്രബുദ്ധികളുടെ ആലോചന മറിഞ്ഞുപോകുന്നു.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"പകൽസമയത്തു അവർക്കു ഇരുൾ നേരിടുന്നു;","poem":1},{"lineBreak":true},{"text":"ഉച്ചസമയത്തു അവർ രാത്രിയിലെന്നപോലെ തപ്പിനടക്കുന്നു.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"അവൻ ദരിദ്രനെ അവരുടെ വായെന്ന വാളിങ്കൽനിന്നും","poem":1},{"lineBreak":true},{"text":"ബലവാന്റെ കയ്യിൽനിന്നും രക്ഷിക്കുന്നു.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"അങ്ങനെ എളിയവന്നു പ്രത്യാശയുണ്ടു;","poem":1},{"lineBreak":true},{"text":"നീതികെട്ടവനോ വായ്പൊത്തുന്നു.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ദൈവം ശാസിക്കുന്ന മനുഷ്യൻ ഭാഗ്യവാൻ;","poem":1},{"lineBreak":true},{"text":"സർവ്വശക്തന്റെ ശിക്ഷ നീ നിരസിക്കരുതു.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"അവൻ മുറിവേല്പിക്കയും മുറി കെട്ടുകയും ചെയ്യുന്നു;","poem":1},{"lineBreak":true},{"text":"അവൻ ചതെക്കയും തൃക്കൈ പൊറുപ്പിക്കയും ചെയ്യുന്നു.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ആറു കഷ്ടത്തിൽനിന്നു അവൻ നിന്നെ വിടുവിക്കും;","poem":1},{"lineBreak":true},{"text":"ഏഴാമത്തേതിലും തിന്മ നിന്നെ തൊടുകയില്ല.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ക്ഷാമകാലത്തു അവൻ നിന്നെ മരണത്തിൽനിന്നും","poem":1},{"lineBreak":true},{"text":"യുദ്ധത്തിൽ വാളിന്റെ വെട്ടിൽനിന്നും വിടുവിക്കും.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"നാവെന്ന ചമ്മട്ടിക്കു നീ ഗുപ്തനാകും;","poem":1},{"lineBreak":true},{"text":"നാശം വരുമ്പോൾ നീ ഭയപ്പെടുകയില്ല.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"നാശവും ക്ഷാമവും കണ്ടു നീ ചിരിക്കും;","poem":1},{"lineBreak":true},{"text":"കാട്ടുമൃഗങ്ങളെ നീ പേടിക്കയില്ല.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"വയലിലെ കല്ലുകളോടു നിനക്കു സഖ്യതയുണ്ടാകും;","poem":1},{"lineBreak":true},{"text":"കാട്ടിലെ മൃഗങ്ങൾ നിന്നോടു ഇണങ്ങിയിരിക്കും.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"നിന്റെ കൂടാരം നിർഭയം എന്നു നീ അറിയും;","poem":1},{"lineBreak":true},{"text":"നിന്റെ പാർപ്പിടം നീ പരിശോധിക്കും, ഒന്നും കാണാതെയിരിക്കയില്ല.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"നിന്റെ സന്താനം അസംഖ്യമെന്നും","poem":1},{"lineBreak":true},{"text":"നിന്റെ പ്രജ നിലത്തെ പുല്ലുപോലെയെന്നും നീ അറിയും.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"തക്ക സമയത്തു കറ്റക്കൂമ്പാരം അടുക്കിവെക്കുന്നതുപോലെ","poem":1},{"lineBreak":true},{"text":"നീ പൂർണ്ണവാർദ്ധക്യത്തിൽ കല്ലറയിൽ കടക്കും.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ഞങ്ങൾ അതു ആരാഞ്ഞുനോക്കി,","poem":1},{"lineBreak":true},{"text":"അതു അങ്ങനെതന്നേ ആകുന്നു; നീ അതു കേട്ടു ഗ്രഹിച്ചുകൊൾക.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mal_fbf/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_fbf/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_fbf/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}