{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"DEU","translationId":"mal_irv","name":"ആവർത്തനപുസ്തകം","commonName":"ആവർത്തനപുസ്തകം","title":"ആവർത്തനപുസ്തകം","order":5,"numberOfChapters":34,"sha256":"360e8c06c1d08ae4b5d987d60e917ddc18ab1f8a01ab50830b432ec4993bc85e","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/mal_irv/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":32,"content":[{"type":"heading","content":["മോശെയുടെ ഗീതം"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"ആകാശമേ, ചെവിതരുക; ഞാൻ സംസാരിക്കും;","poem":1},{"text":"ഭൂമി എന്‍റെ വായിൻ വാക്കുകളെ കേൾക്കട്ടെ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"മഴപോലെ എന്‍റെ ഉപദേശം പൊഴിയും;","poem":1},{"text":"എന്‍റെ വചനം മഞ്ഞുപോലെയും","poem":2},{"text":"ഇളമ്പുല്ലിന്മേൽ പൊടിമഴപോലെയും","poem":1},{"text":"സസ്യത്തിന്മേൽ മാരിപോലെയും ചൊരിയും.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ഞാൻ യഹോവയുടെ നാമം ഘോഷിക്കും;","poem":1},{"text":"നമ്മുടെ ദൈവത്തിന് മഹത്വം കൊടുക്കുവിൻ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"യഹോവയാകുന്നു പാറ; അവിടുത്തെ പ്രവൃത്തി അത്യുത്തമം.","poem":1},{"text":"അവിടുത്തെ വഴികൾ ഒക്കെയും ന്യായം;","poem":2},{"text":"അവിടുന്ന് വിശ്വസ്തതയുള്ള ദൈവം, വ്യാജമില്ലാത്തവൻ;","poem":1},{"text":"നീതിയും നേരുമുള്ളവൻ തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"അവർ അവിടുത്തോട് വഷളത്തം കാണിച്ചു:","poem":1},{"text":"അവർ സ്വയം കളങ്കപ്പെടുത്തിയതിനാൽ അവിടുത്തെ മക്കളല്ല;","poem":2},{"lineBreak":true},{"text":"വക്രതയും കോട്ടവുമുള്ള തലമുറ തന്നെ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഭോഷത്തവും അജ്ഞതയുമുള്ള ജനമേ,","poem":1},{"text":"ഇങ്ങനെയോ നിങ്ങൾ യഹോവയ്ക്കു പകരം കൊടുക്കുന്നത്?","poem":2},{"text":"അവിടുന്നല്ലയോ നിന്‍റെ പിതാവ്, നിന്‍റെ ഉടയവൻ.","poem":1},{"text":"അവിടുന്നല്ലയോ നിന്നെ സൃഷ്ടിക്കുകയും രക്ഷിക്കുകയും ചെയ്തവൻ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"പൂർവ്വദിവസങ്ങളെ ഓർക്കുക:","poem":1},{"text":"മുൻ തലമുറകളുടെ സംവത്സരങ്ങളെ ചിന്തിക്കുക;","poem":2},{"text":"നിന്‍റെ പിതാവിനോട് ചോദിക്കുക, അവൻ അറിയിച്ചുതരും;","poem":1},{"text":"നിന്‍റെ വൃദ്ധന്മാരോട് ചോദിക്കുക, അവർ പറഞ്ഞുതരും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"മഹോന്നതൻ ജനതകൾക്ക് അവകാശം വിഭാഗിക്കുകയും","poem":1},{"text":"മനുഷ്യപുത്രന്മാരെ വേർപിരിക്കുകയും ചെയ്തപ്പോൾ","poem":2},{"text":"അവിടുന്ന് യിസ്രായേൽ മക്കളുടെ എണ്ണത്തിനു തക്കവണ്ണം","poem":1},{"text":"ജനതകളുടെ അതിർത്തികൾ നിശ്ചയിച്ചു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"യഹോവയുടെ ഓഹരി അവിടുത്തെ ജനവും,","poem":1},{"text":"യാക്കോബ് അവിടുത്തെ അവകാശവും ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"അവിടുന്ന് മരുഭൂമിയിൽ അവനെ കണ്ടെത്തി,","poem":1},{"text":"വന്ധ്യമായതും ഓരികേൾക്കുന്നതുമായ ശൂന്യസ്ഥലങ്ങളിൽത്തന്നെ.","poem":2},{"text":"അവിടുന്ന് അവനെ രക്ഷിക്കുകയും പരിപാലിക്കുകയും ചെയ്തു,","poem":1},{"text":"അവിടുന്ന് അവനെ കൺമണിപോലെ കാത്തുസൂക്ഷിച്ചു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"കഴുകൻ തന്‍റെ കൂടനക്കി","poem":1},{"text":"കുഞ്ഞുങ്ങൾക്കു മീതെ പറക്കും പോലെ","poem":2},{"text":"തൻ ചിറകു വിരിച്ച് അവനെ എടുത്ത്","poem":1},{"text":"തന്‍റെ ചിറകിന്മേൽ അവനെ വഹിച്ചു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"യഹോവ തനിയെ അവനെ നടത്തി;","poem":1},{"text":"അവനോടുകൂടെ അന്യദൈവം ഉണ്ടായിരുന്നില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"അവിടുന്ന് ഭൂമിയുടെ ഉന്നതങ്ങളിൽ അവനെ വാഹനമേറ്റി;","poem":1},{"text":"നിലത്തെ അനുഭവംകൊണ്ട് അവൻ ഉപജീവിച്ചു.","poem":2},{"text":"അവനെ പാറയിൽനിന്നുള്ള തേനും","poem":1},{"text":"തീക്കല്ലിൽനിന്നുള്ള എണ്ണയും കുടിപ്പിച്ചു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"കന്നുകാലികളുടെ വെണ്ണയും ആടുകളുടെ പാലും","poem":1},{"text":"ആട്ടിൻകുട്ടികളുടെ മേദസ്സും","poem":2},{"text":"ബാശാനിലെ ആട്ടുകൊറ്റന്മാരെയും കോലാടുകളെയും","poem":1},{"text":"ഗോതമ്പിൻ കാമ്പും അവനു കൊടുത്തു;","poem":2},{"lineBreak":true},{"text":"നീ മുന്തിരിയുടെ രക്തമായ വീഞ്ഞു കുടിച്ചു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"യെശുരൂനോ","poem":1},{"noteId":26},{"text":"പുഷ്ടിവച്ചപ്പോൾ മത്സരിച്ചു;","poem":1},{"text":"നീ പുഷ്ടിവച്ച്, കനത്തു തടിച്ചിരിക്കുന്നു.","poem":2},{"text":"തന്നെ ഉണ്ടാക്കിയ ദൈവത്തെ അവൻ ത്യജിച്ച്;","poem":1},{"text":"തന്‍റെ രക്ഷയുടെ പാറയെ നിരസിച്ചു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അവർ അന്യദൈവങ്ങളാൽ അവിടുത്തെ കോപിപ്പിച്ചു,","poem":1},{"text":"മ്ലേച്ഛതകളാൽ അവിടുത്തെ പ്രകോപിപ്പിച്ചു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവർ ദുർഭൂതങ്ങൾക്ക്, ദൈവമല്ലാത്തവയ്ക്ക്,","poem":1},{"text":"തങ്ങൾ അറിയാത്ത ദേവന്മാർക്കു തന്നെ ബലികഴിച്ചു;","poem":2},{"text":"അവരുടെ പിതാക്കന്മാർ അവയെ ഭജിച്ചിട്ടില്ല,","poem":1},{"text":"അവ നൂതനമായി ഉത്ഭവിച്ച മൂർത്തികൾ അത്രേ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"നിന്നെ ജനിപ്പിച്ച പാറയെ നീ വിസ്മരിച്ചു;","poem":1},{"text":"നിന്നെ ഉല്പാദിപ്പിച്ച ദൈവത്തെ മറന്നുകളഞ്ഞു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"യഹോവ അത് കണ്ടു അവരെ തള്ളിക്കളഞ്ഞു;","poem":1},{"text":"തന്‍റെ പുത്രീപുത്രന്മാരോടുള്ള നീരസത്താൽ തന്നെ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അവിടുന്ന് അരുളിച്ചെയ്തത്: “ഞാൻ എന്‍റെ മുഖം അവർക്ക് മറയ്ക്കും;","poem":1},{"text":"അവരുടെ അന്തം എന്തെന്ന് ഞാൻ നോക്കും.","poem":2},{"lineBreak":true},{"text":"അവർ വക്രതയുള്ള തലമുറ, നേരില്ലാത്ത മക്കൾ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ദൈവമല്ലാത്തതിനെക്കൊണ്ട് എനിക്ക് എരിവുവരുത്തി,","poem":1},{"text":"മിത്ഥ്യാമൂർത്തികളാൽ എന്നെ മുഷിപ്പിച്ചു.","poem":2},{"text":"ഞാനും ജനമല്ലാത്തവരെക്കൊണ്ട് അവർക്ക് എരിവുവരുത്തും;","poem":1},{"text":"മൂഢജനതയെക്കൊണ്ട് അവരെ മുഷിപ്പിക്കും","poem":2}]},{"type":"verse","number":22,"content":[{"text":"എന്‍റെ കോപത്താൽ തീ ജ്വലിച്ച്","poem":1},{"text":"പാതാളത്തിന്‍റെ ആഴത്തോളം കത്തും;","poem":2},{"text":"ഭൂമിയെയും അതിന്‍റെ അനുഭവത്തെയും ദഹിപ്പിച്ചു","poem":1},{"text":"പർവ്വതങ്ങളുടെ അടിസ്ഥാനങ്ങളെ കത്തിച്ചുകളയും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ഞാൻ അനർത്ഥങ്ങൾ അവരുടെ മേൽ കൂമ്പാരമായി കൂട്ടും.","poem":1},{"text":"എന്‍റെ അസ്ത്രങ്ങൾ അവരുടെ നേരെ തൊടുക്കും.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അവർ വിശപ്പുകൊണ്ട് ക്ഷയിക്കും;","poem":1},{"text":"ഉഷ്ണരോഗത്തിനും വിഷവ്യാധിക്കും ഇരയാകും.","poem":2},{"text":"മൃഗങ്ങളുടെ പല്ലും സർപ്പങ്ങളുടെ വിഷവും","poem":1},{"text":"ഞാൻ അവരുടെ ഇടയിൽ അയക്കും.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"വീഥികളിൽ വാളും അറകളിൽ ഭീതിയും,","poem":1},{"text":"യുവാവിനെയും യുവതിയെയും സംഹരിക്കും","poem":2},{"lineBreak":true},{"text":"ശിശുവിനെയും നരച്ചവനെയും സംഹരിക്കും.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ഞാൻ അവരെ തകർത്തുകളഞ്ഞ്,","poem":1},{"text":"മനുഷ്യരുടെ ഇടയിൽനിന്ന് അവരുടെ ഓർമ്മ ഇല്ലാതാക്കുമായിരുന്നു.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"എന്നാൽ ശത്രുക്കളുടെ ക്രോധം ഞാൻ ഭയന്നു","poem":1},{"text":"അവരുടെ വൈരികൾ തെറ്റായി വിചാരിക്കയും","poem":2},{"text":"“ഞങ്ങളുടെ കൈകൊണ്ട് ഞങ്ങൾ ജയിച്ചു;","poem":1},{"text":"യഹോവയല്ല ഇതൊക്കെയും ചെയ്തത്” എന്നു പറയുമായിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"അവർ ആലോചനയില്ലാത്ത ജനം;","poem":1},{"text":"അവർക്ക് വിവേകബുദ്ധിയില്ല.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ഹാ, അവർ ജ്ഞാനികളായി ഇതു ഗ്രഹിച്ച്","poem":1},{"text":"തങ്ങളുടെ ഭാവിയെപ്പറ്റി ചിന്തിച്ചെങ്കിൽ കൊള്ളാമായിരുന്നു.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"അവരുടെ പാറ അവരെ വിറ്റുകളയുകയും","poem":1},{"text":"യഹോവ അവരെ ഏല്പിച്ചുകൊടുക്കുകയും ചെയ്തിട്ടല്ലാതെ","poem":2},{"text":"ഒരുവൻ ആയിരംപേരെ പിന്തുടരുന്നതും","poem":1},{"text":"ഇരുവർ പതിനായിരംപേരെ ഓടിക്കുന്നതുമെങ്ങനെ?","poem":2}]},{"type":"verse","number":31,"content":[{"text":"അവരുടെ പാറ നമ്മുടെ പാറപോലെയല്ല,","poem":1},{"text":"അതിന് നമ്മുടെ ശത്രുക്കൾ തന്നെ സാക്ഷികൾ.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"അവരുടെ മുന്തിരിവള്ളി സൊദോംവള്ളിയിൽനിന്നും","poem":1},{"text":"ഗൊമോരനിലങ്ങളിൽനിന്നും ഉള്ളത്;","poem":2},{"text":"അവരുടെ മുന്തിരിപ്പഴം നഞ്ചും","poem":1},{"text":"മുന്തിരിക്കുല കയ്പുമാകുന്നു;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"അവരുടെ വീഞ്ഞ് മഹാസർപ്പത്തിൻ വിഷവും","poem":1},{"text":"മൂർഖൻ്റെ കാളകൂടവും ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“ഇതു എന്‍റെ അടുക്കൽ സംഗ്രഹിച്ചും","poem":1},{"text":"എന്‍റെ ഭണ്ഡാരത്തിൽ മുദ്രയിട്ടും ഇരിക്കുന്നില്ലയോ?","poem":2},{"lineBreak":true},{"text":"എന്ന് യഹോവ അരുളിച്ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"അവരുടെ കാൽ വഴുതുന്ന കാലത്തേക്കുള്ള പ്രതികാരവും പ്രതിഫലവും എന്‍റെ പക്കൽ ഉണ്ട്;","poem":1},{"text":"അവരുടെ അനർത്ഥദിവസം അടുത്തിരിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"അവർക്ക് ഭവിപ്പാക്കുവാനുള്ളത് ബദ്ധപ്പെടുന്നു.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"യഹോവ തന്‍റെ ജനത്തെ ന്യായംവിധിക്കും;","poem":1},{"text":"അവരുടെ ബലം ക്ഷയിച്ചുപോയി;","poem":2},{"text":"അടിമയോ സ്വതന്ത്രനോ ഇല്ലാതെയായി എന്നു കണ്ടിട്ട്","poem":1},{"text":"അവിടുത്തേക്ക് തന്‍റെ ദാസന്മാരോട് സഹതാപം തോന്നും.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"അവരുടെ ബലികളുടെ മേദസ്സ് തിന്നുകയും","poem":1},{"text":"പാനീയബലിയുടെ വീഞ്ഞു കുടിക്കുകയും ചെയ്ത ദേവന്മാരും","poem":2},{"lineBreak":true},{"text":"അവർ ആശ്രയിച്ച പാറയും എവിടെ?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"‘അവർ എഴുന്നേറ്റ്, നിങ്ങളെ സഹായിച്ച്,","poem":1},{"text":"നിങ്ങൾക്ക് ശരണമായിരിക്കട്ടെ’ എന്നു അവിടുന്ന് അരുളിച്ചെയ്യും.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"ഞാൻ, ഞാൻ മാത്രമേയുള്ളു; ഞാനല്ലാതെ ദൈവമില്ല","poem":1},{"text":"എന്നു ഇപ്പോൾ കണ്ടുകൊള്ളുവിൻ.","poem":2},{"text":"ഞാൻ കൊല്ലുന്നു; ഞാൻ ജീവിപ്പിക്കുന്നു;","poem":1},{"text":"ഞാൻ തകർക്കുന്നു; ഞാൻ സൗഖ്യമാക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"എന്‍റെ കയ്യിൽനിന്ന് വിടുവിക്കുന്നവൻ ഇല്ല.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"ഞാൻ ആകാശത്തേക്കു കൈ ഉയർത്തി സത്യം ചെയ്യുന്നത്:","poem":1},{"text":"“നിത്യനായിരിക്കുന്ന എന്നാണ,","poem":2}]},{"type":"verse","number":41,"content":[{"text":"എന്‍റെ മിന്നലാകുന്ന വാൾ ഞാൻ മൂർച്ചയാക്കി","poem":1},{"text":"എൻ കൈ ന്യായവിധി തുടങ്ങുമ്പോൾ,","poem":2},{"text":"ഞാൻ ശത്രുക്കളിൽ പ്രതികാരം നടത്തും;","poem":1},{"text":"എന്നെ ദ്വേഷിക്കുന്നവരോട് പകരംവീട്ടും.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"ഹതന്മാരുടെയും ബദ്ധന്മാരുടെയും രക്തത്താലും","poem":1},{"text":"ശത്രുനായകന്മാരുടെ ശിരസ്സിൽനിന്ന് ഒലിക്കുന്ന രക്തത്താലും","poem":2},{"text":"ഞാൻ എന്‍റെ അസ്ത്രങ്ങളെ ലഹരി പിടിപ്പിക്കും;","poem":1},{"text":"എന്‍റെ വാൾ മാംസം തിന്നുകയും ചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"ജനതകളേ, അവിടുത്തെ ജനത്തോടുകൂടി ഉല്ലസിക്കുവിൻ;","poem":1},{"text":"അവിടുന്ന് സ്വദാസന്മാരുടെ രക്തത്തിന് പ്രതികാരംചെയ്യും;","poem":2},{"text":"തന്‍റെ ശത്രുക്കളോട് അവിടുന്ന് പകരംവീട്ടും;","poem":1},{"text":"തന്‍റെ ദേശത്തിനും ജനത്തിനും പാപപരിഹാരം വരുത്തും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":["അനന്തരം മോശെയും നൂന്‍റെ മകനായ യോശുവയും ഈ പാട്ടിൻ്റെ വചനങ്ങൾ ഒക്കെയും ജനത്തെ ചൊല്ലിക്കേൾപ്പിച്ചു."]},{"type":"verse","number":45,"content":["മോശെ വചനങ്ങളെല്ലാം യിസ്രായേൽ ജനത്തോട് സംസാരിച്ചു തീർന്നപ്പോൾ അവൻ അവരോട് പറഞ്ഞത്:"]},{"type":"verse","number":46,"content":["”ഈ ന്യായപ്രമാണത്തിലെ വചനങ്ങൾ സകലവും പ്രമാണിച്ചു നടക്കേണം എന്നു നിങ്ങൾ നിങ്ങളുടെ മക്കളോടു കല്പിക്കുവാൻ, ഞാൻ ഇന്ന് നിങ്ങളോട് സാക്ഷീകരിക്കുന്ന സകലവചനങ്ങളും മനസ്സിൽ സൂക്ഷിച്ചുകൊള്ളുവിൻ."]},{"type":"verse","number":47,"content":["ഇതു നിങ്ങൾക്ക് വ്യർത്ഥകാര്യമല്ല, നിങ്ങളുടെ ജീവൻതന്നെ ആകുന്നു; നിങ്ങൾ കൈവശമാക്കുവാൻ യോർദ്ദാൻ കടന്നുചെല്ലുന്ന ദേശത്ത് നിങ്ങൾക്ക് ഇതിനാൽ ദീർഘായുസ്സുണ്ടാകും.”"]},{"type":"heading","content":["മോശെ നെബോ മലമുകളിലേക്ക്"]},{"type":"verse","number":48,"content":["അന്നു തന്നെ യഹോവ മോശെയോട് അരുളിച്ചെയ്തത്:"]},{"type":"verse","number":49,"content":["”നീ യെരിഹോവിനെതിരെ മോവാബ് ദേശത്തുള്ള ഈ അബാരീംപർവ്വതത്തിൽ, നെബോമലമുകളിൽ കയറി, ഞാൻ യിസ്രായേൽ മക്കൾക്ക് അവകാശമായി കൊടുക്കുന്ന കനാൻദേശം നോക്കി കാണുക."]},{"type":"verse","number":50,"content":["നിന്‍റെ സഹോദരനായ അഹരോൻ ഹോർ പർവ്വതത്തിൽവച്ച് മരിച്ച് തന്‍റെ ജനത്തോട് ചേർന്നതുപോലെ നീ കയറുന്ന പർവ്വതത്തിൽവച്ച് നീയും മരിച്ച് നിന്‍റെ ജനത്തോടു ചേരും."]},{"type":"verse","number":51,"content":["നിങ്ങൾ സീൻ മരുഭൂമിയിൽ കാദേശിലെ കലഹജലത്തിങ്കൽ യിസ്രായേൽ മക്കളുടെ മദ്ധ്യത്തിൽവച്ച് എന്നോട് അകൃത്യം ചെയ്കകൊണ്ടും യിസ്രായേൽ മക്കളുടെ മദ്ധ്യത്തിൽവച്ച് എന്നെ മഹത്വീകരിക്കാതിരുന്നതിനാലും തന്നെ."]},{"type":"verse","number":52,"content":["ഞാൻ യിസ്രായേൽമക്കൾക്കു കൊടുക്കുന്ന ദേശം നീ കാണും. എങ്കിലും നീ അവിടെ കടക്കുകയില്ല.”"]}],"footnotes":[{"noteId":26,"caller":"+","text":"യെശുരൂനോ നേര്‍ ഹൃദയമുള്ള യിസ്രായേലോ","reference":{"chapter":32,"verse":15}}]},"thisChapterLink":"/api/mal_irv/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":52}