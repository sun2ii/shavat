{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"GEN","translationId":"mal_irv","name":"ഉല്‍പത്തി","commonName":"ഉല്‍പത്തി","title":"ഉല്‍പത്തി","order":1,"numberOfChapters":50,"sha256":"758982a3d5dda29498935d2c88f68c0225bcb32f4eb5c53f42d62dc6911379e2","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/mal_irv/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":49,"content":[{"type":"heading","content":["യാക്കോബ് പുത്രന്മാരെ അനുഗ്രഹിക്കുന്നു"]},{"type":"verse","number":1,"content":["അനന്തരം യാക്കോബ് തന്‍റെ പുത്രന്മാരെ വിളിച്ച് അവരോടു പറഞ്ഞത്: “കൂടിവരുവിൻ, ഭാവികാലത്തു നിങ്ങൾക്ക് സംഭവിക്കാനുള്ളത് ഞാൻ നിങ്ങളെ അറിയിക്കും."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"യാക്കോബിന്‍റെ പുത്രന്മാരേ: കൂടിവന്നു കേൾക്കുവിൻ;","poem":1},{"text":"നിങ്ങളുടെ അപ്പനായ യിസ്രായേലിന്‍റെ മൊഴിക്കു ചെവിതരുവിൻ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"രൂബേനേ, നീ എന്‍റെ ആദ്യജാതൻ, എന്‍റെ വീര്യവും എന്‍റെ ശക്തിയുടെ ആദ്യഫലവും","poem":1},{"text":"ശ്രേഷ്ഠതയുടെ വൈശിഷ്ട്യവും","poem":2},{"lineBreak":true},{"text":"ബലത്തിന്‍റെ വൈശിഷ്ട്യവും തന്നെ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"വെള്ളംപോലെ തുളുമ്പുന്നവനേ, നീ ശ്രേഷ്ഠനാകുകയില്ല;","poem":1},{"text":"നീ അപ്പന്‍റെ കിടക്കമേൽ കയറി അതിനെ അശുദ്ധമാക്കി;","poem":2},{"lineBreak":true},{"text":"എന്‍റെ ശയ്യമേൽ അവൻ കയറിയല്ലോ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ശിമെയോനും ലേവിയും സഹോദരന്മാർ;","poem":1},{"text":"അവരുടെ വാളുകൾ സാഹസത്തിൻ്റെ ആയുധങ്ങൾ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"എൻ ഉള്ളമേ, അവരുടെ ഗൂഢാലോചനകളിൽ കൂടരുതേ;","poem":1},{"text":"എൻ മനമേ, അവരുടെ യോഗത്തിൽ ചേരരുതേ;","poem":2},{"text":"അവരുടെ കോപത്തിൽ അവർ പുരുഷന്മാരെ കൊന്നു;","poem":1},{"text":"അവരുടെ ശാഠ്യത്തിൽ അവർ കാളകളുടെ വരിയുടച്ചു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവരുടെ ഉഗ്രകോപവും കഠിനക്രോധവും ശപിക്കപ്പെട്ടത്;","poem":1},{"text":"ഞാൻ അവരെ യാക്കോബിൽ വിഭജിക്കുകയും","poem":2},{"lineBreak":true},{"text":"യിസ്രായേലിൽ ചിതറിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"യെഹൂദയേ, സഹോദരന്മാർ നിന്നെ പുകഴ്ത്തും;","poem":1},{"text":"നിന്‍റെ കൈ ശത്രുക്കളുടെ കഴുത്തിൽ ഇരിക്കും;","poem":2},{"lineBreak":true},{"text":"അപ്പന്‍റെ മക്കൾ നിന്‍റെ മുമ്പിൽ നമസ്കരിക്കും.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"യെഹൂദാ ഒരു വലിയസിംഹം","poem":1},{"noteId":87},{"text":";","poem":1},{"text":"മകനേ, നീ ഇരപിടിച്ചു കയറിയിരിക്കുന്നു;","poem":2},{"text":"അവൻ കുനിഞ്ഞു, സിംഹംപോലെയും","poem":1},{"text":"സിംഹിപോലെയും പതുങ്ങിക്കിടക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"ആർ അവനെ എഴുന്നേല്പിക്കും?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ശീലോഹ്","poem":1},{"noteId":88},{"text":"വരുവോളം ചെങ്കോൽ യെഹൂദയിൽനിന്നും","poem":1},{"text":"രാജദണ്ഡ് അവന്‍റെ കാലുകളുടെ ഇടയിൽനിന്നും നീങ്ങിപ്പോകയില്ല;","poem":2},{"lineBreak":true},{"text":"ജനതകളുടെ അനുസരണം അവനോട് ആകും.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അവൻ മുന്തിരിവള്ളിയോടു ചെറുകഴുതയെയും","poem":1},{"text":"വിശിഷ്ടമുന്തിരിവള്ളിയോടു കഴുതക്കുട്ടിയെയും കെട്ടുന്നു;","poem":2},{"text":"അവൻ വീഞ്ഞിൽ തന്‍റെ ഉടുപ്പും","poem":1},{"text":"മുന്തിരിച്ചാറിൽ തന്‍റെ വസ്ത്രവും അലക്കുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവന്‍റെ കണ്ണ് വീഞ്ഞുകൊണ്ടു ചുവന്നും","poem":1},{"text":"അവന്‍റെ പല്ല് പാലുകൊണ്ടു വെളുത്തും ഇരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"സെബൂലൂൻ സമുദ്രതീരത്തു വസിക്കും;","poem":1},{"text":"അവൻ കപ്പലുകൾക്ക് ഒരു അഭയകേന്ദ്രമായിത്തീരും;","poem":2},{"lineBreak":true},{"text":"അവന്‍റെ അതിർത്തി സീദോൻ വരെ ആകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"യിസ്സാഖാർ","poem":1},{"noteId":89},{"text":"കരുത്തുള്ള കഴുത; അവൻ","poem":1},{"text":"തൊഴുത്തുകളുടെ മദ്ധ്യേ കിടക്കുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"വിശ്രമസ്ഥലം നല്ലതെന്നും","poem":1},{"text":"ദേശം ആനന്ദപ്രദമെന്നും കണ്ടു,","poem":2},{"text":"അവൻ ഭാരം കയറ്റാൻ തോൾ കുനിച്ചുകൊടുത്തു","poem":1},{"text":"നിർബന്ധവേലയ്ക്ക് അടിമയായിത്തീർന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ദാൻ ഏതൊരു യിസ്രായേല്യഗോത്രവുംപോലെ","poem":1},{"text":"സ്വജനത്തിനു ന്യായപാലനം ചെയ്യും.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ദാൻ വഴിയിൽ ഒരു പാമ്പും","poem":1},{"text":"പാതയിൽ ഒരു സർപ്പവും ആകുന്നു;","poem":2},{"text":"അവൻ കുതിരയുടെ കുതികാൽ കടിക്കും;","poem":1},{"text":"പുറത്തു കയറിയവൻ മലർന്നു വീഴും.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"യഹോവേ, ഞാൻ നിന്‍റെ രക്ഷക്കായി കാത്തിരിക്കുന്നു.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ഗാദോ, കവർച്ചപ്പട അവനെ ഞെരുക്കും;","poem":1},{"text":"എന്നാൽ അവൻ അവസാനം ജയംപ്രാപിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ആശേരോ, അവന്‍റെ ആഹാരം പുഷ്ടിയുള്ളത്;","poem":1},{"text":"അവൻ രാജകീയസ്വാദുഭോജനം നല്കും.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"നഫ്താലി സ്വതന്ത്രയായി നടക്കുന്ന പേടമാൻ;","poem":1},{"text":"അവൻ ലാവണ്യ വാക്കുകൾ സംസാരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"യോസേഫ് ഫലപ്രദമായോരു വൃക്ഷം,","poem":1},{"text":"നീരുറവിനരികെ ഫലപ്രദമായോരു വൃക്ഷം തന്നെ;","poem":2},{"lineBreak":true},{"text":"അതിന്‍റെ ശാഖകൾ മതിലിന്മേൽ പടരുന്നു.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"വില്ലാളികൾ അവനെ വിഷമിപ്പിച്ചു;","poem":1},{"text":"അവർ എയ്തു, അവനോട് പൊരുതി.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അവന്‍റെ വില്ല് ഉറപ്പോടെ നിന്നു;","poem":1},{"text":"അവന്‍റെ ഭുജം യാക്കോബിൻ വല്ലഭൻ്റെ കയ്യാൽ ബലപ്പെട്ടു;","poem":2},{"text":"യിസ്രായേലിന്‍റെ പാറയായ ഇടയന്‍റെ നാമത്താൽ തന്നെ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"നിന്‍റെ പിതാവിന്‍റെ ദൈവത്താൽ അവൻ നിന്നെ സഹായിക്കും","poem":1},{"text":"സർവ്വശക്തനാൽ തന്നെ അവൻ മീതെ ആകാശത്തിന്‍റെ അനുഗ്രഹങ്ങളാലും","poem":2},{"text":"താഴെ കിടക്കുന്ന ആഴത്തിന്‍റെ അനുഗ്രഹങ്ങളാലും","poem":1},{"text":"മുലയുടെയും ഗർഭത്തിൻ്റെയും അനുഗ്രഹങ്ങളാലും","poem":2},{"lineBreak":true},{"text":"നിന്നെ അനുഗ്രഹിക്കും.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"എൻ പിതാവിന്‍റെ അനുഗ്രഹങ്ങൾ","poem":1},{"text":"എൻ പൂര്‍വ്വ പിതാക്കന്മാരുടെ അനുഗ്രഹങ്ങൾക്കു മീതെ","poem":2},{"noteId":90},{"text":"ശാശ്വതഗിരികളുടെ അറ്റത്തോളം പ്രബലപ്പെട്ടു.","poem":1},{"text":"അവ യോസേഫിന്‍റെ തലയിലും","poem":2},{"lineBreak":true},{"text":"തന്‍റെ സഹോദരന്മാരിൽ പ്രഭുവായവൻ്റെ നെറുകയിലും വരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ബെന്യാമീൻ കടിച്ചുകീറുന്ന ചെന്നായ്;","poem":1},{"text":"രാവിലെ അവൻ ഇരപിടിച്ചു വിഴുങ്ങും;","poem":2},{"lineBreak":true},{"text":"വൈകുന്നേരത്ത് അവൻ കവർച്ച പങ്കിടും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":["യിസ്രായേൽ ഗോത്രം പന്ത്രണ്ടും ഇവ ആകുന്നു; അവരുടെ പിതാവ് അവരോടു പറഞ്ഞത് ഇതുതന്നെ; അവൻ അവരിൽ ഓരോ മകനും അവനവന് ഉചിതമായ അനുഗ്രഹം കൊടുത്ത് അവരെ അനുഗ്രഹിച്ചു."]},{"type":"heading","content":["യാക്കോബിന്‍റെ മരണം"]},{"type":"verse","number":29,"content":["അവൻ അവരോട് ആജ്ഞാപിച്ചു പറഞ്ഞത്: “ഞാൻ എന്‍റെ ജനത്തോടു ചേരുമ്പോൾ ഹിത്യനായ എഫ്രോൻ്റെ നിലത്തിലെ ഗുഹയിൽ എന്‍റെ പിതാക്കന്മാരുടെ അടുക്കൽ എന്നെ സംസ്കരിക്കേണം."]},{"type":"verse","number":30,"content":["കനാൻദേശത്തു മമ്രേക്കു സമീപം, അബ്രാഹാം ഹിത്യനായ എഫ്രോനോടു നിലത്തോടുകൂടി ശ്മശാനഭൂമിയായി അവകാശം വാങ്ങിയ മക്പേലാ എന്ന നിലത്തിലെ ഗുഹയിൽ തന്നെ."]},{"type":"verse","number":31,"content":["അവിടെ അവർ അബ്രാഹാമിനെയും അവന്‍റെ ഭാര്യയായ സാറായെയും യിസ്ഹാക്കിനെയും അവന്‍റെ ഭാര്യയായ റിബെക്കായെയും സംസ്കരിച്ചു; അവിടെ ഞാൻ ലേയായെയും സംസ്കരിച്ചു."]},{"type":"verse","number":32,"content":["ആ നിലവും അതിലെ ഗുഹയും ഹിത്യരോടു വിലയ്ക്കു വാങ്ങിയതാകുന്നു.”"]},{"type":"verse","number":33,"content":["യാക്കോബ് തന്‍റെ പുത്രന്മാരോട് ആജ്ഞാപിച്ചു തീർന്നശേഷം അവൻ കാൽ കട്ടിലിന്മേൽ എടുത്തു വച്ചിട്ടു പ്രാണനെ വിട്ടു തന്‍റെ ജനത്തോടു ചേർന്നു."]}],"footnotes":[{"noteId":87,"caller":"+","text":"വലിയസിംഹം ബാലസിംഹം","reference":{"chapter":49,"verse":9}},{"noteId":88,"caller":"+","text":"ശീലോഹ് അവകാശമുള്ളവൻ വരുവോളം","reference":{"chapter":49,"verse":10}},{"noteId":89,"caller":"+","text":"യിസ്സാഖാർ ആട്ടിന്‍ കൂട്ടത്തിന്‍റെ ഇടയില്‍","reference":{"chapter":49,"verse":14}},{"noteId":90,"caller":"+","text":"എൻ പിതാവിന്‍റെ അനുഗ്രഹങ്ങൾ എൻ പൂര്‍വ്വ പിതാക്കന്മാരുടെ അനുഗ്രഹങ്ങൾക്കു മീതെ നിന്‍റെ പിതാവിന്‍റെ അനുഗ്രഹം ശാശ്വതമായ പര്‍വ്വതത്തിനുമീതെ","reference":{"chapter":49,"verse":26}}]},"thisChapterLink":"/api/mal_irv/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}