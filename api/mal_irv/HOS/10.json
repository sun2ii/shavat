{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"HOS","translationId":"mal_irv","name":"ഹോശേയ","commonName":"ഹോശേയ","title":"ഹോശേയ","order":28,"numberOfChapters":14,"sha256":"0775a9de6c128b99a8470ea2603858973695d72247e54e2adc8849219b99aedb","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mal_irv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"heading","content":["യിസ്രായേലിനെതിരായ യഹോവയുടെ ന്യായവിധി"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"യിസ്രായേൽ പടർന്നിരിക്കുന്ന ഒരു മുന്തിരിവള്ളി ആകുന്നു;","poem":1},{"text":"അവൻ ഫലം കായിക്കുന്നു;","poem":2},{"text":"തന്‍റെ ഫലം വർദ്ധിച്ചപ്പോൾ","poem":1},{"text":"അവൻ ബലിപീഠങ്ങളും വർദ്ധിപ്പിച്ചു;","poem":2},{"text":"തന്‍റെ ദേശത്തിന് സമൃദ്ധി ഉണ്ടായപ്പോൾ","poem":1},{"text":"അവൻ ഭംഗിയുള്ള വിഗ്രഹസ്തംഭങ്ങളും ഉണ്ടാക്കി.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവരുടെ ഹൃദയം ഭിന്നിച്ചിരിക്കുന്നു;","poem":1},{"text":"ഇപ്പോൾ അവർ കുറ്റക്കാരായിത്തീരും;","poem":2},{"text":"അവൻ അവരുടെ ബലിപീഠങ്ങൾ ഇടിച്ചുകളയുകയും","poem":1},{"text":"അവരുടെ വിഗ്രഹസ്തംഭങ്ങൾ നശിപ്പിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ഇപ്പോൾ അവർ: “നമുക്ക് രാജാവില്ല; നാം യഹോവയെ ഭയപ്പെടുന്നില്ലല്ലോ;","poem":1},{"text":"രാജാവ് നമുക്കുവേണ്ടി എന്ത് ചെയ്യും?” എന്ന് പറയും.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവർ വ്യർത്ഥവാക്കുകൾ സംസാരിച്ച്,","poem":1},{"text":"ഉടമ്പടി ചെയ്യുമ്പോൾ കള്ളസ്സത്യം ചെയ്യുന്നു;","poem":2},{"text":"അതുകൊണ്ട് ദൈവത്തിന്‍റെ ന്യായവിധി","poem":1},{"text":"വയലിലെ ഉഴവുചാലുകളിൽ നഞ്ചുചെടിപോലെ മുളച്ചുവരുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ശമര്യാ നിവാസികൾ ബേത്ത്-ആവെനിലെ കാളക്കുട്ടി നിമിത്തം ഭയപ്പെടുന്നു;","poem":1},{"text":"അവിടുത്തെ ജനം അതിനെക്കുറിച്ച് ദുഃഖിക്കുന്നു;","poem":2},{"text":"അവരുടെ പൂജാരികൾ മഹത്വം അതിനെ വിട്ടുപോയതുകൊണ്ട്","poem":1},{"text":"അതിനെക്കുറിച്ച് ഭയപ്പെട്ട് വിറയ്ക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ആ വിഗ്രഹത്തെയും യുദ്ധതല്പരനായ രാജാവിന് സമ്മാനമായി അശ്ശൂരിലേക്ക് കൊണ്ടുപോകും;","poem":1},{"text":"എഫ്രയീം ലജ്ജിക്കും;","poem":2},{"lineBreak":true},{"text":"യിസ്രായേൽ സ്വന്തം തടി വിഗ്രഹങ്ങളെ കുറിച്ച്","poem":2},{"noteId":14},{"text":"ലജ്ജിക്കും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ശമര്യയുടെ കാര്യമോ, അതിന്‍റെ രാജാവ്","poem":1},{"text":"വെള്ളത്തിലെ ചുള്ളിക്കമ്പ് പോലെ നശിച്ചുപോകും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"യിസ്രായേലിന്‍റെ പാപമായിരിക്കുന്ന ആവെനിലെ പൂജാഗിരികൾ നശിച്ചുപോകും;","poem":1},{"text":"മുള്ളും പറക്കാരയും അവരുടെ ബലിപീഠങ്ങളിന്മേൽ മുളയ്ക്കും;","poem":2},{"lineBreak":true},{"text":"അവർ മലകളോട്: “ഞങ്ങളുടെമേൽ വീഴുവിൻ” എന്ന് പറയും.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"യിസ്രായേലേ, ഗിബെയയുടെ കാലം മുതൽ നീ പാപം ചെയ്തിരിക്കുന്നു;","poem":1},{"text":"അവർ ഇന്നും അതേ അവസ്ഥയിൽ തുടരുന്നു;","poem":2},{"lineBreak":true},{"text":"ഗിബെയയിൽ നീതികെട്ടവരോടുള്ള പോരാട്ടം അവരെ കീഴടക്കിയില്ല;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ഞാൻ ഇച്ഛിക്കുമ്പോൾ അവരെ ശിക്ഷിക്കും;","poem":1},{"text":"അവരുടെ രണ്ടു അകൃത്യങ്ങൾ നിമിത്തം","poem":2},{"text":"ഞാൻ അവരെ ശിക്ഷിക്കുമ്പോൾ","poem":1},{"text":"ജനതകള്‍ അവർക്കെതിരെ കൂടിവരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"എഫ്രയീം മെരുക്കമുള്ളതും ധാന്യം മെതിക്കുവാൻ ഇഷ്ടപ്പെടുന്നതുമായ പശുക്കിടാവ് ആകുന്നു;","poem":1},{"text":"ഞാൻ അതിന്‍റെ ഭംഗിയുള്ള കഴുത്തിൽ നുകം വയ്ക്കും;","poem":2},{"text":"ഞാൻ എഫ്രയീമിനെ നുകത്തിൽ കെട്ടും;","poem":1},{"text":"യെഹൂദാ ഉഴുകയും യാക്കോബ് കട്ട ഉടയ്ക്കുകയും ചെയ്യേണ്ടിവരും.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"നീതിയിൽ വിതയ്ക്കുവിൻ;","poem":1},{"text":"ദയക്കൊത്തവണ്ണം കൊയ്യുവിൻ;","poem":2},{"text":"നിങ്ങളുടെ തരിശുനിലം ഉഴുവിൻ;","poem":1},{"text":"യഹോവ വന്ന് നിങ്ങളുടെമേൽ","poem":2},{"text":"നീതി വർഷിപ്പിക്കേണ്ടതിന്","poem":1},{"text":"അവനെ അന്വേഷിക്കുവാനുള്ള കാലം ഇതാകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"നിങ്ങൾ ദുഷ്ടത ഉഴുത്,","poem":1},{"text":"നീതികേട് കൊയ്ത്,","poem":2},{"lineBreak":true},{"text":"ഭോഷ്കിന്‍റെ ഫലം തിന്നിരിക്കുന്നു;","poem":2},{"text":"നിങ്ങൾ സ്വന്ത വഴിയിലും","poem":1},{"text":"നിങ്ങളുടെ വീരന്മാരുടെ സംഖ്യാബലത്തിലും ആശ്രയിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അതുകൊണ്ട് നിന്‍റെ ജനത്തിന്‍റെ ഇടയിൽ ഒരു കലഹം ഉണ്ടാകും;","poem":1},{"text":"യുദ്ധദിവസത്തിൽ ശൽമാൻ ബേത്ത്-അർബ്ബേലിനെ നശിപ്പിച്ചതുപോലെ","poem":2},{"text":"നിങ്ങളുടെ എല്ലാ കോട്ടകൾക്കും നാശം വരും;","poem":1},{"text":"അവർ അമ്മയെ മക്കളോടുകൂടി തകർത്തുകളഞ്ഞുവല്ലോ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അങ്ങനെ തന്നെ ബേഥേലേ!","poem":1},{"text":"നിങ്ങളുടെ മഹാദുഷ്ടതനിമിത്തം നിങ്ങൾക്ക് ഇത് സംഭവിക്കും;","poem":2},{"lineBreak":true},{"text":"പുലർച്ചയ്ക്ക് യിസ്രായേൽ രാജാവ് അശേഷം നശിച്ചുപോകും.","poem":2}]}],"footnotes":[{"noteId":14,"caller":"+","text":"സ്വന്തം തടി വിഗ്രഹങ്ങളെ കുറിച്ച് ആലോചനയെക്കുറിച്ച്","reference":{"chapter":10,"verse":6}}]},"thisChapterLink":"/api/mal_irv/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}