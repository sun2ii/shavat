{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"HOS","translationId":"mal_irv","name":"ഹോശേയ","commonName":"ഹോശേയ","title":"ഹോശേയ","order":28,"numberOfChapters":14,"sha256":"0775a9de6c128b99a8470ea2603858973695d72247e54e2adc8849219b99aedb","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mal_irv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"heading","content":["യിസ്രായേലിനെതിരെ യഹോവയുടെ കോപം"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"എഫ്രയീം സംസാരിച്ചപ്പോൾ വിറയൽ ഉണ്ടായി;","poem":1},{"text":"അവൻ യിസ്രായേലിൽ ഉന്നതനായിരുന്നു;","poem":2},{"lineBreak":true},{"text":"എന്നാൽ ബാല്‍ മുഖാന്തരം കുറ്റം ചെയ്തപ്പോൾ അവൻ മരിച്ചുപോയി.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ഇപ്പോഴോ, അവർ അധികമധികം പാപം ചെയ്യുന്നു;","poem":1},{"text":"അവർ വെള്ളികൊണ്ട് ബിംബങ്ങളും ബോധിച്ചതുപോലെ വിഗ്രഹങ്ങളും ഉണ്ടാക്കി;","poem":2},{"text":"ഇവയെല്ലാം കൗശലപ്പണിക്കാരുടെ പണിയാകുന്നു;","poem":1},{"text":"അവയോട് അവർ സംസാരിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"ബലികഴിക്കുന്ന മനുഷ്യർ കാളക്കിടാക്കളെ ചുംബിക്കുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അതുകൊണ്ട് അവർ പ്രഭാതമേഘംപോലെയും","poem":1},{"text":"പുലർച്ചയിൽ നീങ്ങിപ്പോകുന്ന മഞ്ഞുപോലെയും","poem":2},{"text":"ധാന്യക്കളത്തിൽ നിന്ന് കാറ്റ് പറപ്പിക്കുന്ന പതിർപോലെയും","poem":1},{"text":"പുകക്കുഴലിൽനിന്നു പൊങ്ങുന്ന പുകപോലെയും ആയിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“എന്നാൽ മിസ്രയീം ദേശം മുതൽ","poem":1},{"text":"നിന്‍റെ ദൈവമായ യഹോവ ഞാൻ ആകുന്നു;","poem":2},{"text":"എന്നെയല്ലാതെ വേറൊരു ദൈവത്തെ നീ അറിയുന്നില്ല;","poem":1},{"text":"ഞാനല്ലാതെ ഒരു രക്ഷിതാവ് ഇല്ലല്ലോ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ഞാൻ മരുഭൂമിയിൽ","poem":1},{"text":"ഏറ്റവും വരണ്ട ദേശത്ത് നിന്നെ മേയിച്ചു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവർക്ക് സമൃദ്ധിയായി മേച്ചൽ ലഭിച്ചു","poem":1},{"noteId":18},{"text":".","poem":1},{"text":"അവർ തൃപ്തരായപ്പോൾ അവരുടെ ഹൃദയം നിഗളിച്ചു;","poem":2},{"lineBreak":true},{"text":"അതുകൊണ്ട് അവർ എന്നെ മറന്നുകളഞ്ഞു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ആകയാൽ ഞാൻ അവർക്ക് ഒരു സിംഹത്തെപ്പോലെ ഇരിക്കും;","poem":1},{"text":"വഴിയരികെ ഒരു പുള്ളിപ്പുലിയെപ്പോലെ ഞാൻ അവർക്കായി പതിയിരിക്കും;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"കുട്ടികൾ നഷ്ടപ്പെട്ട കരടിയെപ്പോലെ","poem":1},{"text":"ഞാൻ അവരെ എതിരിട്ട് അവരുടെ മാറിടം കീറിക്കളയും;","poem":2},{"text":"അവിടെവച്ച് ഞാൻ അവരെ ഒരു സിംഹത്തെപ്പോലെ തിന്നുകളയും;","poem":1},{"text":"കാട്ടുമൃഗം അവരെ കടിച്ചുകീറും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“യിസ്രായേലേ, ഞാൻ നിന്നെ നശിപ്പിക്കും;","poem":1},{"text":"ആർക്കു നിന്നെ സഹായിക്കാൻ കഴിയും?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"നിന്‍റെ എല്ലാ പട്ടണങ്ങളിലും നിന്നെ രക്ഷിക്കുവാൻ നിന്‍റെ രാജാവ് ഇപ്പോൾ എവിടെ?","poem":1},{"text":"‘ഞങ്ങൾക്ക് ഒരു രാജാവിനെയും പ്രഭുക്കന്മാരെയും തരേണം’ എന്ന് അപേക്ഷിച്ച നിന്‍റെ ന്യായാധിപന്മാർ എവിടെ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"എന്‍റെ കോപത്തിൽ ഞാൻ നിനക്ക് ഒരു രാജാവിനെ തന്നു,","poem":1},{"text":"എന്‍റെ ക്രോധത്തിൽ ഞാൻ അവനെ നീക്കിക്കളഞ്ഞു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“എഫ്രയീമിന്‍റെ അകൃത്യം സംഗ്രഹിച്ചും","poem":1},{"text":"അവന്‍റെ പാപം സൂക്ഷിച്ചും വച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"നോവുകിട്ടിയ സ്ത്രീയുടെ വേദന അവന് ഉണ്ടാകും;","poem":1},{"text":"എന്നാൽ അവൻ ബുദ്ധിയില്ലാത്ത മകൻ;","poem":2},{"text":"സമയമാകുമ്പോൾ","poem":1},{"text":"അവൻ ഗർഭദ്വാരത്തിൽ എത്തുന്നില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ഞാൻ അവരെ പാതാളത്തിന്‍റെ അധികാരത്തിൽനിന്ന് വീണ്ടെടുക്കും;","poem":1},{"text":"മരണത്തിൽനിന്നു ഞാൻ അവരെ വിടുവിക്കും;","poem":2},{"text":"മരണമേ, നിന്‍റെ വിഷമുള്ള് എവിടെ?","poem":1},{"text":"പാതാളമേ, നിന്‍റെ സംഹാരം എവിടെ?","poem":2},{"lineBreak":true},{"text":"“എനിക്ക് സഹതാപം തോന്നുകയില്ല.","poem":1}]},{"type":"verse","number":15,"content":[{"text":"അവൻ തന്‍റെ സഹോദരന്മാരുടെ ഇടയിൽ ഫലപുഷ്ടിയുള്ളവനായിരുന്നാലും","poem":2},{"lineBreak":true},{"text":"യഹോവയുടെ അടുക്കൽനിന്ന് ഒരു കിഴക്കൻകാറ്റു വരും;","poem":2},{"text":"മരുഭൂമിയിൽനിന്നു അതു വരും;","poem":1},{"text":"അവന്‍റെ നീരുറവ വറ്റിപ്പോകും;","poem":2},{"text":"അവന്‍റെ കിണർ വരണ്ടുപോകും.","poem":1},{"lineBreak":true},{"text":"അവൻ സകലമനോഹരവസ്തുക്കളുടെയും നിക്ഷേപം","poem":1},{"text":"കവർന്നുകൊണ്ടുപോകും.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ശമര്യ തന്‍റെ ദൈവത്തോട് മത്സരിച്ചതുകൊണ്ട്","poem":1},{"text":"അവൾ തന്‍റെ അകൃത്യം വഹിക്കേണ്ടിവരും;","poem":2},{"text":"അവർ വാൾകൊണ്ടു വീഴും;","poem":1},{"lineBreak":true},{"text":"അവരുടെ ശിശുക്കളെ അവർ തകർത്തുകളയും;","poem":1},{"text":"അവരുടെ ഗർഭിണികളുടെ ഉദരം പിളർന്നുകളയും.”","poem":2}]}],"footnotes":[{"noteId":18,"caller":"+","text":"അവർക്ക് സമൃദ്ധിയായി മേച്ചൽ ലഭിച്ചു അളവിന് അനുസരിച്ച് ഞാന്‍ അവരെ പോഷിപ്പിച്ചു","reference":{"chapter":13,"verse":6}}]},"thisChapterLink":"/api/mal_irv/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":16}