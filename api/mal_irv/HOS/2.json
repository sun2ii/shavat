{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"HOS","translationId":"mal_irv","name":"ഹോശേയ","commonName":"ഹോശേയ","title":"ഹോശേയ","order":28,"numberOfChapters":14,"sha256":"0775a9de6c128b99a8470ea2603858973695d72247e54e2adc8849219b99aedb","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mal_irv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["നിങ്ങളുടെ സഹോദരന്മാർക്ക് ‘അമ്മീ’",{"noteId":4},"എന്നും നിങ്ങളുടെ സഹോദരിമാർക്ക് ‘രൂഹമാ’",{"noteId":5},"എന്നും പേര് വിളിക്കുവിൻ."]},{"type":"heading","content":["യിസ്രായേലിന്‍റെ ശിക്ഷയും വീണ്ടെടുപ്പും"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"വ്യവഹരിക്കുവിൻ;","poem":1},{"text":"നിങ്ങളുടെ അമ്മയോട് വ്യവഹരിക്കുവിൻ;","poem":2},{"text":"അവൾ എന്‍റെ ഭാര്യയല്ല,","poem":1},{"text":"ഞാൻ അവളുടെ ഭർത്താവുമല്ല;","poem":2},{"text":"അവൾ പരസംഗം മുഖത്തുനിന്നും","poem":1},{"text":"വ്യഭിചാരം മാറിടത്തിൽ നിന്നും നീക്കിക്കളയട്ടെ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അല്ലെങ്കിൽ ഞാൻ അവളെ വസ്ത്രം അഴിച്ച് നഗ്നയാക്കി,","poem":1},{"text":"ജനിച്ച ദിവസത്തിലെന്നപോലെ നിർത്തുകയും","poem":2},{"text":"അവളെ മരുഭൂമിയും വരണ്ടനിലവും പോലെ ആക്കി,","poem":1},{"text":"ദാഹംകൊണ്ട് മരിപ്പിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ഞാൻ അവളുടെ മക്കളോട് കരുണ കാണിക്കുകയില്ല;","poem":1},{"text":"അവർ പരസംഗത്തിൽ ജനിച്ച മക്കളല്ലോ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവരുടെ അമ്മ പരസംഗം ചെയ്തു;","poem":1},{"text":"അവരെ പ്രസവിച്ചവൾ ലജ്ജാകരമായി പ്രവർത്തിച്ചു;","poem":2},{"text":"“എനിക്ക് അപ്പവും വെള്ളവും","poem":1},{"text":"ആട്ടുരോമവും ശണവും","poem":2},{"text":"എണ്ണയും പാനീയവും തരുന്ന","poem":1},{"text":"എന്‍റെ ജാരന്മാരുടെ പിന്നാലെ ഞാൻ പോകും” എന്നു പറഞ്ഞുവല്ലോ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അതുകൊണ്ട് ഞാൻ അവളുടെ വഴി","poem":1},{"text":"മുള്ളുകൊണ്ട് വേലികെട്ടി അടയ്ക്കും;","poem":2},{"text":"അവൾ തന്‍റെ പാതകൾ കണ്ടെത്താത്ത വിധം","poem":1},{"text":"ഞാൻ ഒരു മതിൽ ഉണ്ടാക്കും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവൾ ജാരന്മാരെ പിന്തുടരും;","poem":1},{"text":"എങ്കിലും അവരോട് ഒപ്പം എത്തുകയില്ല;","poem":2},{"text":"അവൾ അവരെ അന്വേഷിക്കും,","poem":1},{"text":"കണ്ടെത്തുകയില്ലതാനും;","poem":2},{"text":"അപ്പോൾ അവൾ: “ഞാൻ എന്‍റെ ആദ്യത്തെ ഭർത്താവിന്‍റെ അടുക്കൽ മടങ്ങിപ്പോകും;","poem":1},{"text":"ഇന്നത്തേക്കാൾ അന്ന് എനിക്ക് ഏറെ നന്നായിരുന്നുവല്ലോ” എന്നു പറയും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവൾക്ക് ധാന്യവും വീഞ്ഞും എണ്ണയും നല്കിയതും","poem":1},{"text":"ബാലിനു വേണ്ടി ഉപയോഗിച്ച","poem":2},{"text":"അവളുടെ വെള്ളിയും പൊന്നും വർദ്ധിപ്പിച്ചതും","poem":1},{"text":"ഞാനായിരുന്നു എന്ന് അവൾ അറിഞ്ഞില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"അതുകൊണ്ട് തക്കകാലത്ത് എന്‍റെ ധാന്യവും","poem":1},{"text":"തക്കസമയത്ത് എന്‍റെ വീഞ്ഞും ഞാൻ തിരികെ എടുക്കുകയും","poem":2},{"text":"അവളുടെ നഗ്നത മറയ്ക്കുവാൻ കൊടുത്തിരുന്ന","poem":1},{"text":"എന്‍റെ ആട്ടിൻ രോമവും ശണവും എടുത്തുകളയുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ഇപ്പോൾ ഞാൻ അവളുടെ ജാരന്മാർ കാൺകെ","poem":1},{"text":"അവളുടെ നഗ്നത അനാവൃതമാക്കും;","poem":2},{"text":"ആരും അവളെ എന്‍റെ കൈയിൽനിന്ന്","poem":1},{"text":"വിടുവിക്കുകയില്ല.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ഞാൻ അവളുടെ സകലവിധ സന്തോഷവും ഉത്സവങ്ങളും","poem":1},{"text":"അമാവാസികളും ശബ്ബത്തുകളും","poem":2},{"lineBreak":true},{"text":"അവളുടെ വിശേഷദിവസങ്ങളും ഇല്ലാതെയാക്കും.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“ഇത് എന്‍റെ ജാരന്മാർ എനിക്ക് തന്ന സമ്മാനങ്ങൾ” എന്ന് അവൾ പറഞ്ഞ","poem":1},{"text":"മുന്തിരിവള്ളികളും അത്തിവൃക്ഷങ്ങളും ഞാൻ നശിപ്പിക്കും;","poem":2},{"text":"അവയെ ഞാന്‍ വനമാക്കിത്തീര്‍ക്കും;","poem":1},{"text":"വന്യമൃഗങ്ങൾ അവയെ തിന്നുകളയും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അവൾ ബാല്‍ വിഗ്രഹങ്ങൾക്ക് ധൂപം കാണിച്ച്","poem":1},{"text":"കുണുക്കും ആഭരണങ്ങളുംകൊണ്ട് സ്വയം അലങ്കരിച്ച്","poem":2},{"text":"തന്‍റെ ജാരന്മാരെ പിന്തുടർന്ന്","poem":1},{"text":"എന്നെ മറന്നുകളഞ്ഞ നാളുകൾ ഞാൻ അവളോട് സന്ദർശിക്കും” എന്നു യഹോവയുടെ അരുളപ്പാട്.","poem":2}]},{"type":"heading","content":["യഹോവയുടെ സ്നേഹം"]},{"type":"verse","number":14,"content":[{"text":"“അതുകൊണ്ട് ഞാൻ അവളെ വശീകരിച്ച്","poem":1},{"text":"മരുഭൂമിയിൽ കൊണ്ടുചെന്ന്","poem":2},{"lineBreak":true},{"text":"അവളോട് ഹൃദ്യമായി സംസാരിക്കും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവിടെ ഞാൻ അവൾക്ക് മുന്തിരിത്തോട്ടങ്ങളും","poem":1},{"text":"പ്രത്യാശയുടെ വാതിലായി ആഖോർ താഴ്‌വരയും കൊടുക്കും;","poem":2},{"text":"അവൾ അവിടെ യൗവന കാലത്തെന്നപോലെയും","poem":1},{"text":"മിസ്രയീം ദേശത്തുനിന്ന് പുറപ്പെട്ടുവന്ന നാളിലെപ്പോലെയും പാട്ട് പാടും","poem":2},{"noteId":6},{"text":".","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അന്നാളിൽ നീ എന്നെ ‘ബാലീ’","poem":1},{"noteId":7},{"text":"എന്നല്ല","poem":1},{"text":"‘ഈശീ’","poem":2},{"noteId":8},{"text":"എന്ന് വിളിക്കും” എന്നു യഹോവയുടെ അരുളപ്പാട്.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“ഞാൻ ബാല്‍ വിഗ്രഹങ്ങളുടെ പേരുകൾ അവളുടെ വായിൽനിന്ന് നീക്കിക്കളയും;","poem":1},{"text":"ഇനി ആരും അവയെ പേര് ചൊല്ലി സ്മരിക്കുകയുമില്ല.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അന്നാളിൽ ഞാൻ അവർക്ക് വേണ്ടി കാട്ടിലെ മൃഗങ്ങളോടും","poem":1},{"text":"ആകാശത്തിലെ പക്ഷികളോടും","poem":2},{"text":"ഭൂമിയിലെ ഇഴജാതികളോടും","poem":1},{"text":"ഒരു നിയമം ചെയ്യും;","poem":2},{"text":"ഞാൻ വില്ലും വാളും യുദ്ധവും","poem":1},{"text":"ഭൂമിയിൽനിന്ന് നീക്കി,","poem":2},{"lineBreak":true},{"text":"അവരെ നിർഭയം വസിക്കുമാറാക്കും.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ഞാൻ നിന്നെ സദാകാലത്തേക്കും","poem":1},{"text":"എനിക്ക് വിവാഹത്തിന് നിശ്ചയിക്കും;","poem":2},{"text":"അതെ, നീതിയോടും ന്യായത്തോടും ദയയോടും കരുണയോടുംകൂടി","poem":1},{"text":"നിന്നെ എനിക്ക് വിവാഹത്തിന് നിശ്ചയിക്കും.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ഞാൻ വിശ്വസ്തതയോടെ നിന്നെ എനിക്ക് വിവാഹത്തിന് നിശ്ചയിക്കും;","poem":1},{"text":"നീ യഹോവയെ അറിയുകയും ചെയ്യും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“ആ കാലത്ത് ഞാൻ ഉത്തരം നല്കും”","poem":1},{"text":"എന്നു യഹോവ അരുളിച്ചെയ്യുന്നു:","poem":2},{"text":"“ഞാൻ ആകാശത്തിന് ഉത്തരം നല്കും;","poem":1},{"text":"ആകാശം ഭൂമിക്ക് ഉത്തരം നല്കും;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ഭൂമി ധാന്യത്തിനും വീഞ്ഞിനും എണ്ണയ്ക്കും ഉത്തരം നല്കും;","poem":1},{"text":"അവ യിസ്രയേലിനും ഉത്തരം നല്കും.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ഞാൻ അതിനെ എനിക്കായി ദേശത്ത് വിതയ്ക്കും;","poem":1},{"text":"കരുണ ലഭിക്കാത്തവളോട് ഞാൻ കരുണ കാണിക്കും.","poem":2},{"text":"എന്‍റെ ജനമല്ലാത്തവരോട്: ‘നീ എന്‍റെ ജനം’ എന്നു ഞാൻ പറയും;","poem":1},{"text":"‘അങ്ങ് എന്‍റെ ദൈവം’ എന്നു അവരും പറയും.”","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"അമ്മീ എന്‍റെ ജനം","reference":{"chapter":2,"verse":1}},{"noteId":5,"caller":"+","text":"രൂഹമാ കരുണ ലഭിച്ചവൾ","reference":{"chapter":2,"verse":1}},{"noteId":6,"caller":"+","text":"പാട്ട് പാടും ഉത്തരം പറയും","reference":{"chapter":2,"verse":15}},{"noteId":7,"caller":"+","text":"ബാലീ ഉടയവനേ","reference":{"chapter":2,"verse":16}},{"noteId":8,"caller":"+","text":"ഈശീ ഭർത്താവേ","reference":{"chapter":2,"verse":16}}]},"thisChapterLink":"/api/mal_irv/HOS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/HOS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/HOS/1.json","previousChapterAudioLinks":{},"numberOfVerses":23}