{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"HOS","translationId":"mal_irv","name":"ഹോശേയ","commonName":"ഹോശേയ","title":"ഹോശേയ","order":28,"numberOfChapters":14,"sha256":"0775a9de6c128b99a8470ea2603858973695d72247e54e2adc8849219b99aedb","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mal_irv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"heading","content":["ദുഷ്ടതയോടുള്ള യിസ്രായേലിന്‍റെ സ്നേഹം"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"ഞാൻ യിസ്രായേലിനെ സൗഖ്യമാക്കുമ്പോൾ,","poem":1},{"text":"എഫ്രയീമിന്‍റെ അകൃത്യങ്ങൾ വെളിച്ചത്തുവരുകയും","poem":2},{"text":"ശമര്യയുടെ ദുഷ്ടത വെളിപ്പെട്ടുവരുകയും ചെയ്യുന്നു;","poem":1},{"text":"അവർ വ്യാജം പ്രവർത്തിക്കുന്നു;","poem":2},{"text":"അകത്ത് കള്ളൻ കടക്കുന്നു;","poem":1},{"text":"പുറത്ത് കവർച്ചക്കാരുടെ കൂട്ടം കൊള്ളയിടുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"എന്നാൽ, അവരുടെ സകല ദുഷ്ടതയും ഞാൻ ഓർക്കുന്നു എന്ന്","poem":1},{"text":"അവർ മനസ്സിൽ ചിന്തിക്കുന്നില്ല;","poem":2},{"text":"ഇപ്പോൾ അവരുടെ സ്വന്തപ്രവൃത്തികൾ അവരെ ചുറ്റിയിരിക്കുന്നു;","poem":1},{"text":"അവ എന്‍റെ മുമ്പാകെ ഇരിക്കുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവർ ദുഷ്ടതകൊണ്ട് രാജാവിനെയും","poem":1},{"text":"ഭോഷ്കുകൊണ്ട് പ്രഭുക്കന്മാരെയും സന്തോഷിപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവർ എല്ലാവരും വ്യഭിചാരികൾ ആകുന്നു;","poem":1},{"text":"അവർ നീറിക്കത്തുന്ന അടുപ്പുപോലെ ആകുന്നു.","poem":2},{"text":"മാവു കുഴച്ചതുമുതൽ അത് പുളിക്കുവോളം","poem":1},{"text":"അപ്പക്കാരൻ തീ ആളികത്തിക്കാതിരിക്കുന്നതുപോലെ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"നമ്മുടെ രാജാവിന്‍റെ ഉത്സവദിവസത്തിൽ","poem":1},{"text":"പ്രഭുക്കന്മാർ വീഞ്ഞു കുടിച്ച് ഉന്മത്തരാകുന്നു;","poem":2},{"lineBreak":true},{"text":"അവൻ പരിഹാസികളുമായി കൂട്ടുചേരുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവർ പതിയിരിക്കുന്ന സമയത്ത്","poem":1},{"text":"അവരുടെ ഹൃദയം അടുപ്പുപോലെ നീറിക്കത്തുന്നു;","poem":2},{"text":"അവരുടെ വികാരം രാത്രിമുഴുവൻ പുകയുന്നു;","poem":1},{"text":"രാവിലെ അത് ജ്വലിക്കുന്ന തീപോലെ കത്തുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവരെല്ലാം അടുപ്പുപോലെ ചൂടുപിടിച്ച്,","poem":1},{"text":"തങ്ങളുടെ ന്യായാധിപതിമാരെ തിന്നുകളയുന്നു;","poem":2},{"text":"അവരുടെ രാജാക്കന്മാർ എല്ലാം വീണുപോയിരിക്കുന്നു;","poem":1},{"text":"അവരുടെ ഇടയിൽ എന്നോട് അപേക്ഷിക്കുന്നവൻ ആരുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"എഫ്രയീം ജനതയോട് ഇടകലർന്നിരിക്കുന്നു;","poem":1},{"text":"എഫ്രയീം മറിച്ചിടാത്ത ദോശ ആകുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അന്യജനത അവന്‍റെ ബലം തിന്നുകളഞ്ഞെങ്കിലും","poem":1},{"text":"അവൻ അത് അറിയുന്നില്ല;","poem":2},{"text":"അവന്‍റെ തല അവിടവിടെ നരച്ചിരിക്കുന്നു","poem":1},{"text":"എങ്കിലും അവൻ അത് അറിയുന്നില്ല.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"യിസ്രായേലിന്‍റെ അഹംഭാവം അവന്‍റെ മുഖത്ത് പ്രകടമായിരിക്കുന്നു;","poem":1},{"text":"എന്നാൽ അവർ തങ്ങളുടെ ദൈവമായ യഹോവയുടെ അടുക്കൽ മടങ്ങിവന്നിട്ടില്ല;","poem":2},{"lineBreak":true},{"text":"ഈ കാര്യങ്ങളിൽ അവനെ അന്വേഷിച്ചിട്ടും ഇല്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"എഫ്രയീം ബുദ്ധികെട്ട പൊട്ടപ്രാവുപോലെ ആകുന്നു;","poem":1},{"text":"അവർ മിസ്രയീമിനെ വിളിക്കുകയും അശ്ശൂരിലേക്ക് പോകുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവർ പോകുമ്പോൾ ഞാൻ എന്‍റെ വല അവരുടെ മേൽ വീശും;","poem":1},{"text":"ഞാൻ അവരെ ആകാശത്തിലെ പറവകളെപ്പോലെ താഴെ വരുത്തും;","poem":2},{"text":"അവരുടെ സഭയിൽ കേൾപ്പിച്ചതുപോലെ","poem":1},{"text":"ഞാൻ അവരെ ശിക്ഷിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"അവർ എന്നെ വിട്ട് ഓടിപ്പോയതുകൊണ്ട് അവർക്ക് അയ്യോ കഷ്ടം;","poem":1},{"text":"അവർ എന്നോട് അതിക്രമം ചെയ്തതുകൊണ്ട് അവർക്ക് നാശം;","poem":2},{"text":"ഞാൻ അവരെ വീണ്ടെടുക്കുവാൻ വിചാരിച്ചിട്ടും","poem":1},{"text":"അവർ എന്നോട് ഭോഷ്ക് സംസാരിക്കുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവർ ഹൃദയപൂർവ്വം എന്നോട് നിലവിളിക്കാതെ","poem":1},{"text":"കിടക്കയിൽവച്ച് അലമുറയിടുന്നു;","poem":2},{"text":"അവർ ധാന്യവും വീഞ്ഞും നിമിത്തം ഒന്നിച്ചുകൂടുന്നു;","poem":1},{"text":"അവർ എന്നോട് മത്സരിക്കുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഞാൻ അവരെ അഭ്യസിപ്പിച്ച് അവരുടെ ഭുജങ്ങളെ ബലപ്പെടുത്തിയിട്ടും,","poem":1},{"text":"അവർ എന്‍റെ നേരെ ദോഷം നിരൂപിക്കുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അവർ മടങ്ങിവരുന്നു, അത്യുന്നതനായ ദൈവത്തിന്‍റെ അടുക്കലേക്ക് അല്ലതാനും;","poem":1},{"text":"അവർ വഞ്ചനയുള്ള വില്ലുപോലെ ആകുന്നു;","poem":2},{"text":"അവരുടെ പ്രഭുക്കന്മാർ നാവിന്‍റെ ക്രോധം നിമിത്തം വാളുകൊണ്ട് വീഴും;","poem":1},{"text":"അത് മിസ്രയീം ദേശത്ത്","poem":2},{"lineBreak":true},{"text":"അവർക്ക് പരിഹാസഹേതുവായിത്തീരും.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}