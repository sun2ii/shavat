{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"HOS","translationId":"mal_irv","name":"ഹോശേയ","commonName":"ഹോശേയ","title":"ഹോശേയ","order":28,"numberOfChapters":14,"sha256":"0775a9de6c128b99a8470ea2603858973695d72247e54e2adc8849219b99aedb","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mal_irv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["യിസ്രായേൽ ശിക്ഷിക്കപ്പെടും"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"യിസ്രായേലേ, നീ ആനന്ദിക്കരുത്;","poem":1},{"text":"മറ്റു ജനതകളെപ്പോലെ സന്തോഷംകൊണ്ടു തുള്ളിച്ചാടുകയും വേണ്ട;","poem":2},{"text":"നിന്‍റെ ദൈവത്തെ ഉപേക്ഷിച്ചു നീ പരസംഗം ചെയ്തിരിക്കുന്നുവല്ലോ.","poem":1},{"text":"ധാന്യക്കളങ്ങളിൽ എല്ലാം നിങ്ങൾ വേശ്യയുടെ കൂലിയാണല്ലോ ആഗ്രഹിച്ചത്.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ധാന്യക്കളവും ചക്കും അവരെ പോഷിപ്പിക്കുകയില്ല,","poem":1},{"text":"പുതുവീഞ്ഞ് അതിൽ ഇല്ലാതെയാകും.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവർ യഹോവയുടെ ദേശത്ത് വസിക്കുകയില്ല;","poem":1},{"text":"എഫ്രയീം മിസ്രയീമിലേക്ക് മടങ്ങിപ്പോകുകയും","poem":2},{"lineBreak":true},{"text":"അശ്ശൂരിൽവച്ച് മലിനമായത്","poem":2},{"noteId":13},{"text":"തിന്നുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവർ യഹോവയ്ക്ക് വീഞ്ഞ് അർപ്പിക്കുകയില്ല;","poem":1},{"text":"അവരുടെ ഹനനയാഗങ്ങൾ അവന് പ്രസാദമായിരിക്കുകയുമില്ല;","poem":2},{"text":"അവർ അർപ്പിക്കുന്ന അപ്പം","poem":1},{"text":"അവർക്ക് വിലാപത്തിന്‍റെ അപ്പം പോലെ ആയിരിക്കും;","poem":2},{"text":"അത് തിന്നുന്നവനെല്ലാം അശുദ്ധനായിത്തീരും;","poem":1},{"lineBreak":true},{"text":"അവരുടെ അപ്പം വിശപ്പടക്കുവാൻ മാത്രം അവർക്ക് ഉതകും;","poem":1},{"text":"അത് യഹോവയുടെ ആലയത്തിലേക്ക് കൊണ്ടുവരുകയില്ല.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"സഭായോഗ ദിവസത്തിലും","poem":1},{"text":"യഹോവയുടെ ഉത്സവദിവസത്തിലും നിങ്ങൾ എന്ത് ചെയ്യും?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവർ നാശത്തിൽനിന്ന് ഓടിപ്പോയാലും മിസ്രയീം അവരെ ഒരുമിച്ച് കൂട്ടും;","poem":1},{"text":"മോഫ് അവരെ അടക്കം ചെയ്യും;","poem":2},{"text":"വെള്ളികൊണ്ടുള്ള അവരുടെ മനോഹരവസ്തുക്കൾ മുൾച്ചെടികൾ കൈവശമാക്കും;","poem":1},{"text":"മുള്ളുകൾ അവരുടെ കൂടാരങ്ങളിൽ ഉണ്ടാകും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ശിക്ഷയുടെ ദിനങ്ങൾ വന്നിരിക്കുന്നു;","poem":1},{"text":"പ്രതികാരദിവസം അടുത്തിരിക്കുന്നു;","poem":2},{"text":"നിന്‍റെ അകൃത്യബാഹുല്യവും വിദ്വേഷവും നിമിത്തം","poem":1},{"text":"പ്രവാചകൻ ഭോഷനും","poem":2},{"text":"ആത്മപൂർണ്ണൻ ഭ്രാന്തനും","poem":1},{"text":"എന്ന് യിസ്രായേൽ അറിയും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"എഫ്രയീം എന്‍റെ ദൈവത്തിന്‍റെ നേരെ പതിയിരിക്കുന്നു;","poem":1},{"text":"പ്രവാചകൻ തന്‍റെ എല്ലാ വഴികളിലും വേട്ടക്കാരന്‍റെ കെണിയും","poem":2},{"lineBreak":true},{"text":"ദൈവത്തിന്‍റെ ആലയത്തിൽ പകയും നേരിടും.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഗിബെയയുടെ കാലത്ത് എന്നപോലെ അവർ വഷളത്വത്തിൽ മുഴുകിയിരിക്കുന്നു;","poem":1},{"text":"അവൻ അവരുടെ അകൃത്യം ഓർത്തു","poem":2},{"lineBreak":true},{"text":"അവരുടെ പാപത്തിന് ശിക്ഷ നൽകും.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"മരുഭൂമിയിൽ മുന്തിരിപ്പഴംപോലെ","poem":1},{"text":"ഞാൻ യിസ്രായേലിനെ കണ്ടിരുന്നു;","poem":2},{"text":"അത്തിവൃക്ഷത്തിൽ ആദ്യം ഉണ്ടായ തലക്കനിപോലെ","poem":1},{"text":"ഞാൻ നിങ്ങളുടെ പിതാക്കന്മാരെ കണ്ടിരുന്നു;","poem":2},{"text":"ബാൽ-പെയോരിൽ എത്തിയപ്പോൾ","poem":1},{"text":"അവർ തങ്ങളെത്തന്നെ ലജ്ജയായതിന് ഏല്പിച്ചു;","poem":2},{"lineBreak":true},{"text":"അവരുടെ ഇഷ്ടദേവനെപ്പോലെ അവരും മ്ലേച്ഛതയുള്ളവരായി.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"പ്രസവമോ ഗർഭമോ ഗർഭധാരണമോ ഒന്നും ഇല്ലാതെ","poem":1},{"text":"എഫ്രയീമിന്‍റെ മഹത്വം ഒരു പക്ഷിയെപ്പോലെ പറന്നുപോകും.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവർ മക്കളെ വളർത്തിയാലും","poem":1},{"text":"ഞാൻ അവരെ ഒരുത്തനും ശേഷിക്കാതെ മക്കളില്ലാത്തവരാക്കും;","poem":2},{"text":"ഞാൻ അവരെ വിട്ടു മാറിപ്പോകുമ്പോൾ","poem":1},{"text":"അവർക്ക് അയ്യോ കഷ്ടം!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ഞാൻ എഫ്രയീമിനെ നോക്കുമ്പോൾ സോർവരെ അത് മനോഹരസ്ഥലത്തെ നടുതല പോലെ ഇരിക്കുന്നു;","poem":1},{"text":"എങ്കിലും എഫ്രയീം തന്‍റെ മക്കളെ ഘാതകന്‍റെ അടുക്കൽ പുറത്ത് കൊണ്ടുചെല്ലേണ്ടിവരും.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"യഹോവേ, അവർക്ക് കൊടുക്കേണമേ;","poem":1},{"text":"നീ അവർക്ക് എന്തുകൊടുക്കും?","poem":2},{"text":"അലസിപ്പോകുന്ന ഗർഭവും","poem":1},{"text":"വരണ്ട സ്തനങ്ങളും അവർക്ക് കൊടുക്കേണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"അവരുടെ ദുഷ്ടതയെല്ലാം ഗില്ഗാലിൽവച്ച് സംഭവിച്ചു;","poem":1},{"text":"അവിടെവച്ച് ഞാൻ അവരെ വെറുത്തു;","poem":2},{"text":"അവരുടെ പ്രവൃത്തികളുടെ ദുഷ്ടതനിമിത്തം","poem":1},{"text":"ഞാൻ ഇനി അവരെ സ്നേഹിക്കാതെ","poem":2},{"text":"എന്‍റെ ആലയത്തിൽനിന്ന് നീക്കിക്കളയും;","poem":1},{"text":"അവരുടെ സകലപ്രഭുക്കന്മാരും മത്സരികൾ ആകുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"എഫ്രയീമിന് പുഴുക്കുത്തു പിടിച്ചു;","poem":1},{"text":"അവരുടെ വേര് ഉണങ്ങിപ്പോയി;","poem":2},{"text":"അവർ ഫലം കായിക്കുകയില്ല;","poem":1},{"text":"അവർ പ്രസവിച്ചാലും ഞാൻ അവരുടെ ഇഷ്ടസന്തതികളെ കൊന്നുകളയും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"അവർ എന്‍റെ ദൈവത്തെ അനുസരിക്കായ്കകൊണ്ട്","poem":1},{"text":"യഹോവ അവരെ തള്ളിക്കളയും;","poem":2},{"lineBreak":true},{"text":"അവർ ജനതയുടെ ഇടയിൽ ഉഴന്നു നടക്കേണ്ടിവരും.","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"മലിനമായത് മോശെയുടെ ന്യായപ്രമാണപ്രകാരം ചില ഭക്ഷണവസ്തുക്കള്‍ അശുദ്ധമായതിനാല്‍ ഭക്ഷിക്കുവാന്‍ പാടുള്ളതല്ല.","reference":{"chapter":9,"verse":3}}]},"thisChapterLink":"/api/mal_irv/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}