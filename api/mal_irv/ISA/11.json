{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_irv","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവ്","order":23,"numberOfChapters":66,"sha256":"45eb2dbc632d76759f55420c9d5113aa31e38d8ae6f344595050753381ccd595","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_irv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":11,"content":[{"type":"heading","content":["സമാധാനപരമായ രാജ്യം"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"എന്നാൽ യിശ്ശായിയുടെ കുറ്റിയിൽനിന്ന് ഒരു മുള പൊട്ടി പുറപ്പെടും;","poem":1},{"text":"അവന്‍റെ വേരുകളിൽനിന്നുള്ള ഒരു ശിഖരം ഫലം കായിക്കും.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവന്‍റെമേൽ യഹോവയുടെ ആത്മാവ് ആവസിക്കും;","poem":1},{"text":"ജ്ഞാനത്തിന്‍റെയും വിവേകത്തിന്‍റെയും ആത്മാവ്,","poem":2},{"text":"ആലോചനയുടെയും ബലത്തിന്‍റെയും ആത്മാവ്,","poem":1},{"text":"പരിജ്ഞാനത്തിന്‍റെയും യഹോവാഭക്തിയുടെയും ആത്മാവുതന്നെ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവന്‍റെ ആനന്ദം യഹോവാഭക്തിയിൽ ആയിരിക്കും;","poem":1},{"text":"അവൻ കണ്ണുകൊണ്ട് കാണുന്നതുപോലെ ന്യായപാലനം ചെയ്യുകയില്ല;","poem":2},{"lineBreak":true},{"text":"ചെവികൊണ്ട് കേൾക്കുന്നതുപോലെ വിധിക്കുകയുമില്ല.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവൻ ദരിദ്രന്മാർക്ക് നീതിയോടെ ന്യായം പാലിച്ചുകൊടുക്കുകയും","poem":1},{"text":"ദേശത്തിലെ സാധുക്കൾക്കു നേരോടെ വിധി കല്പിക്കുകയും ചെയ്യും;","poem":2},{"text":"തന്‍റെ വായ് എന്ന വടികൊണ്ട് അവൻ ഭൂമിയെ അടിക്കും;","poem":1},{"text":"തന്‍റെ അധരങ്ങളുടെ ശ്വാസംകൊണ്ടു ദുഷ്ടനെ കൊല്ലും.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"നീതി അവന്‍റെ നടുക്കെട്ടും","poem":1},{"text":"വിശ്വസ്തത അവന്‍റെ അരക്കച്ചയും ആയിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ചെന്നായ് കുഞ്ഞാടിനോടുകൂടെ പാർക്കും;","poem":1},{"text":"പുള്ളിപ്പുലി കോലാട്ടുകുട്ടിയോടുകൂടെ കിടക്കും;","poem":2},{"text":"പശുക്കിടാവും ബാലസിംഹവും തടിപ്പിച്ച മൃഗവും ഒരുമിച്ചു വസിക്കും;","poem":1},{"text":"ഒരു ചെറിയ കുട്ടി അവയെ നടത്തും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"പശു കരടിയോടുകൂടെ മേയും;","poem":1},{"text":"അവയുടെ കുട്ടികൾ ഒരുമിച്ചുകിടക്കും;","poem":2},{"lineBreak":true},{"text":"സിംഹം കാള എന്നപോലെ വൈക്കോൽ തിന്നും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"മുലകുടിക്കുന്ന ശിശു സർപ്പത്തിന്‍റെ മാളത്തിനു മുകളിൽ കളിക്കും;","poem":1},{"text":"മുലകുടി മാറിയ പൈതൽ അണലിയുടെ പൊത്തിൽ കൈ ഇടും.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"സമുദ്രം വെള്ളംകൊണ്ട് നിറഞ്ഞിരിക്കുന്നതുപോലെ","poem":1},{"text":"ഭൂമി യഹോവയുടെ പരിജ്ഞാനംകൊണ്ടു പൂർണ്ണമായിരിക്കുകയാൽ","poem":2},{"text":"എന്‍റെ വിശുദ്ധപർവ്വതത്തിൽ എങ്ങും","poem":1},{"text":"ഒരു ദോഷമോ നാശമോ ആരും ചെയ്യുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["പ്രവാസികളുടെ തിരിച്ചുവരവ്"]},{"type":"verse","number":10,"content":["ആ നാളിൽ വംശങ്ങൾക്കു കൊടിയായി നില്ക്കുന്ന യിശ്ശായിവേരായവനെ ജനതകൾ അന്വേഷിച്ചുവരും; അവന്‍റെ വിശ്രാമസ്ഥലം മഹത്ത്വമുള്ളതായിരിക്കും."]},{"type":"verse","number":11,"content":["ആ നാളിൽ കർത്താവ് തന്‍റെ ജനത്തിൽ ശേഷിച്ചിരിക്കുന്ന ശേഷിപ്പിനെ അശ്ശൂരിൽനിന്നും മിസ്രയീമിൽനിന്നും പത്രോസിൽനിന്നും കൂശിൽനിന്നും ഏലാമിൽനിന്നും ശിനാരിൽനിന്നും ഹമാത്തിൽനിന്നും സമുദ്രത്തിലെ ദ്വീപുകളിൽനിന്നും",{"noteId":28},"വീണ്ടുകൊള്ളുവാൻ രണ്ടാം പ്രാവശ്യം കൈ നീട്ടും."]},{"type":"verse","number":12,"content":[{"text":"അവൻ ജനതകൾക്ക് ഒരു കൊടി ഉയർത്തി,","poem":1},{"text":"യിസ്രായേലിന്‍റെ പുറത്താക്കപ്പെട്ടവരെ ചേർക്കുകയും","poem":2},{"text":"യെഹൂദായുടെ ചിതറിപ്പോയവരെ","poem":1},{"text":"ഭൂമിയുടെ നാലു ദിക്കുകളിൽനിന്നും ഒന്നിച്ചുകൂട്ടുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"എഫ്രയീമിന്‍റെ അസൂയ നീങ്ങിപ്പോകും;","poem":1},{"text":"യെഹൂദായെ എതിരിടുന്നവർ ഛേദിക്കപ്പെടും;","poem":2},{"text":"എഫ്രയീം യെഹൂദായോട് അസൂയപ്പെടുകയില്ല;","poem":1},{"text":"യെഹൂദാ എഫ്രയീമിനെ അസഹ്യപ്പെടുത്തുകയുമില്ല.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവർ പടിഞ്ഞാറു ഫെലിസ്ത്യരുടെ മലഞ്ചരിവിന്മേൽ ചാടും;","poem":1},{"text":"കിഴക്കുള്ളവരെ ഒക്കെയും കൊള്ളയിടും;","poem":2},{"text":"ഏദോമിന്മേലും മോവാബിന്മേലും കൈവയ്ക്കും;","poem":1},{"text":"അമ്മോന്യർ അവരെ അനുസരിക്കും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"യഹോവ മിസ്രയീം കടലിന്‍റെ നാവിനു","poem":1},{"noteId":29},{"text":"ഉന്മൂലനാശം വരുത്തും;","poem":1},{"text":"അവിടുന്ന് ഉഷ്ണക്കാറ്റോടുകൂടി നദിയുടെ മീതെ കൈ ഓങ്ങി","poem":2},{"text":"അതിനെ അടിച്ച് ഏഴു കൈവഴികളാക്കി","poem":1},{"text":"മനുഷ്യരെ ചെരിപ്പു നനയാതെ കടക്കുമാറാക്കും.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"മിസ്രയീം നിന്നു പുറപ്പെട്ട നാളിൽ","poem":1},{"text":"യിസ്രായേലിനു ഉണ്ടായിരുന്നതുപോലെ,","poem":2},{"text":"അശ്ശൂരിൽനിന്ന് അവിടുത്തെ ജനത്തിൽ","poem":1},{"text":"ശേഷിക്കുന്ന ശേഷിപ്പിന് ഒരു പ്രധാനപാത","poem":2},{"noteId":30},{"text":"ഉണ്ടാകും.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":28,"caller":"+","text":"സമുദ്രത്തിലെ ദ്വീപുകളിൽനിന്നും പുരാതന ചരിത്രത്തില്‍ സമുദ്രത്തിലെ ദ്വീപുകള്‍ എന്നത് കൊണ്ടു അര്‍ത്ഥമാക്കുന്നത് ദൂരെയുള്ള രാജ്യങ്ങളെയാണ്","reference":{"chapter":11,"verse":11}},{"noteId":29,"caller":"+","text":"മിസ്രയീം കടലിന്‍റെ നാവിനു മിസ്രയീമിലെ കടലിടുക്ക് (ന്യൂ കിംഗ് ജെയിംസ് വേർഷൻ).","reference":{"chapter":11,"verse":15}},{"noteId":30,"caller":"+","text":"പ്രധാനപാതരാജപാത, പ്രധാനപാത, പെരുവഴി, പ്രധാനവഴി.","reference":{"chapter":11,"verse":16}}]},"thisChapterLink":"/api/mal_irv/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/ISA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/ISA/10.json","previousChapterAudioLinks":{},"numberOfVerses":16}