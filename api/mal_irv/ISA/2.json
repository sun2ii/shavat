{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_irv","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവ്","order":23,"numberOfChapters":66,"sha256":"45eb2dbc632d76759f55420c9d5113aa31e38d8ae6f344595050753381ccd595","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_irv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":2,"content":[{"type":"heading","content":["യഹോവയുടെ പർവ്വതം"]},{"type":"verse","number":1,"content":["ആമോസിന്‍റെ മകനായ യെശയ്യാവ് യെഹൂദായെയും യെരൂശലേമിനെയും പറ്റി ദർശിച്ച വചനം."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"വരും കാലങ്ങളില്‍","poem":1},{"text":"യഹോവയുടെ ആലയമുള്ള പർവ്വതം","poem":2},{"text":"പർവ്വതങ്ങളുടെ ശിഖരത്തിൽ സ്ഥാപിതവും","poem":1},{"text":"കുന്നുകൾക്കുമീതെ ഉന്നതവുമായിരിക്കും;","poem":2},{"text":"സകലജനതകളും അതിലേക്ക് ഒഴുകിച്ചെല്ലും.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"അനേകവംശങ്ങളും ചെന്നു:","poem":2},{"text":"“വരുവിൻ, നമുക്ക് യഹോവയുടെ പർവ്വതത്തിലേക്ക്,","poem":1},{"text":"യാക്കോബിൻ ദൈവത്തിന്‍റെ ആലയത്തിലേക്ക് കയറിച്ചെല്ലാം;","poem":2},{"text":"അവൻ നമുക്കു തന്‍റെ വഴികളെ ഉപദേശിച്ചുതരുകയും","poem":1},{"text":"നാം അവന്‍റെ പാതകളിൽ നടക്കുകയും ചെയ്യും” എന്നു പറയും.","poem":2},{"text":"സീയോനിൽനിന്ന് ഉപദേശവും","poem":1},{"text":"യെരൂശലേമിൽ നിന്നു യഹോവയുടെ വചനവും പുറപ്പെടും.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവൻ ജനതകളുടെ ഇടയിൽ ന്യായം വിധിക്കുകയും","poem":1},{"text":"ബഹുവംശങ്ങൾക്കു വിധി കല്പിക്കുകയും ചെയ്യും;","poem":2},{"text":"അവർ അവരുടെ വാളുകളെ കലപ്പകളായും","poem":1},{"text":"കുന്തങ്ങളെ വാക്കത്തികളായും അടിച്ചുതീർക്കും;","poem":2},{"text":"ജനത ജനതക്കു നേരെ വാളോങ്ങുകയില്ല;","poem":1},{"text":"അവർ ഇനി യുദ്ധം അഭ്യസിക്കുകയും ഇല്ല.","poem":2}]},{"type":"heading","content":["യഹോവയുടെ ദിവസം"]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"യാക്കോബ് ഗൃഹമേ, വരുവിൻ;","poem":1},{"text":"നമുക്കു യഹോവയുടെ വെളിച്ചത്തിൽ നടക്കാം.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"എന്നാൽ നീ യാക്കോബ് ഗൃഹമായ നിന്‍റെ ജനത്തെ തള്ളിക്കളഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"അവർ പൂർവ്വരാജ്യക്കാരുടെ മര്യാദകളാൽ നിറഞ്ഞും","poem":2},{"text":"ഫെലിസ്ത്യരെപ്പോലെ പ്രശ്നക്കാരായും","poem":1},{"text":"അന്യജാതിക്കാരോടു സഖ്യതയുള്ളവരായും ഇരിക്കുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവരുടെ ദേശത്തു വെള്ളിയും പൊന്നും നിറഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"അവരുടെ നിക്ഷേപങ്ങൾക്കു കണക്കില്ല;","poem":2},{"text":"അവരുടെ ദേശത്തു കുതിരകൾ നിറഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"അവരുടെ രഥങ്ങൾക്കും എണ്ണമില്ല.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവരുടെ ദേശത്തു വിഗ്രഹങ്ങൾ നിറഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"സ്വന്തംവിരൽകൊണ്ടുണ്ടാക്കിയ കൈപ്പണിയെ","poem":2},{"lineBreak":true},{"text":"അവർ നമസ്കരിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"മനുഷ്യൻ വണങ്ങുന്നു,","poem":1},{"text":"പുരുഷൻ ലജ്ജിക്കപ്പെടുന്നു","poem":2},{"text":"ജനങ്ങള്‍ മാനഹീനരാകുന്നു;","poem":1},{"text":"അതിനാൽ നീ അവരോടു ക്ഷമിക്കരുതേ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"യഹോവയുടെ ഭയങ്കരത്വം നിമിത്തവും","poem":1},{"text":"അവന്‍റെ മഹിമയുടെ പ്രഭനിമിത്തവും","poem":2},{"text":"നീ പാറയിൽ കടന്നു","poem":1},{"text":"മണ്ണിൽ ഒളിച്ചുകൊള്ളുക.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"മനുഷ്യരുടെ നിഗളിച്ച കണ്ണ് താഴും;","poem":1},{"text":"പുരുഷന്മാരുടെ ഉന്നതഭാവം കുനിയും;","poem":2},{"text":"യഹോവ മാത്രം ആ ന്യായവിധി നാളിൽ","poem":1},{"text":"ഉന്നതനായിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"സൈന്യങ്ങളുടെ യഹോവയുടെ നാൾ","poem":1},{"text":"അഹങ്കാരവും ഉന്നതഭാവവും ഉള്ള എല്ലാറ്റിന്മേലും","poem":2},{"text":"നിഗളമുള്ള എല്ലാറ്റിന്മേലും വരും;","poem":1},{"text":"അവ താണുപോകും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ലെബാനോനിലെ പൊക്കവും","poem":1},{"text":"ഉയരവും ഉള്ള സകല ദേവദാരുക്കളിന്മേലും","poem":2},{"text":"ബാശാനിലെ എല്ലാ കരുവേലകങ്ങളിന്മേലും","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ഉയർന്നിരിക്കുന്ന സകലപർവ്വതങ്ങളിന്മേലും","poem":1},{"text":"ഉയരമുള്ള എല്ലാ കുന്നുകളിന്മേലും","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഉന്നതമായ സകലഗോപുരത്തിന്മേലും","poem":1},{"text":"ഉറപ്പുള്ള എല്ലാ മതിലിന്മേലും","poem":2}]},{"type":"verse","number":16,"content":[{"text":"എല്ലാ തർശ്ശീശ് കപ്പലിന്മേലും","poem":1},{"text":"മനോഹരമായ സകല ശൃംഗാരഗോപുരത്തിന്മേലും","poem":2},{"noteId":4},{"text":"വരും.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അപ്പോൾ മനുഷ്യന്‍റെ ഗർവ്വം","poem":1},{"noteId":5},{"text":"കുനിയും;","poem":1},{"text":"പുരുഷന്മാരുടെ ഉന്നതഭാവം താഴും; യഹോവ മാത്രം ആ നാളിൽ ഉന്നതനായിരിക്കും.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"വിഗ്രഹങ്ങളോ പൂർണ്ണമായി ഇല്ലാതെയാകും.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"യഹോവ ഭൂമിയെ നടുക്കുവാൻ എഴുന്നേല്ക്കുമ്പോൾ","poem":1},{"text":"അവർ അവന്‍റെ ഭയങ്കരത്വം നിമിത്തവും","poem":2},{"text":"അവന്‍റെ മഹിമയുടെ പ്രഭനിമിത്തവും","poem":1},{"text":"പാറകളുടെ ഇടുക്കുകളിലും മണ്ണിലെ ഗുഹകളിലും കടക്കും.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അവർ നമസ്കരിക്കുവാൻ","poem":1},{"text":"വെള്ളികൊണ്ടും പൊന്നുകൊണ്ടും ഉണ്ടാക്കിയ","poem":2},{"text":"മിഥ്യാമൂർത്തികളെ മനുഷ്യർ ആ നാളിൽ","poem":1},{"text":"തുരപ്പനെലിക്കും നരിച്ചീറിനും എറിഞ്ഞുകളയും.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"യഹോവ ഭൂമിയെ നടുക്കുവാൻ എഴുന്നേല്ക്കുമ്പോൾ","poem":1},{"text":"അവന്‍റെ ഭയങ്കരത്വം നിമിത്തവും","poem":2},{"text":"അവന്‍റെ മഹിമയുടെ പ്രഭനിമിത്തവും","poem":1},{"text":"അവർ പാറകളുടെ പിളർപ്പുകളിലും","poem":2},{"lineBreak":true},{"text":"ഭൂമിയിലെ വിള്ളലുകളിലേക്കും ഓടിപ്പോകും","poem":2}]},{"type":"verse","number":22,"content":[{"text":"മൂക്കിൽ ശ്വാസമുള്ള മനുഷ്യനെ വിട്ടൊഴിയുവിൻ;","poem":1},{"text":"അവനെ എന്ത് വിലമതിക്കുവാനുള്ളു?","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"സകല ശൃംഗാരഗോപുരത്തിന്മേലും മനോഹരമായ സകല കപ്പലിന്മേലും.","reference":{"chapter":2,"verse":16}},{"noteId":5,"caller":"+","text":"ഗർവ്വം അഹങ്കാരം.","reference":{"chapter":2,"verse":17}}]},"thisChapterLink":"/api/mal_irv/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}