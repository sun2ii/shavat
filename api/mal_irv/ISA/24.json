{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_irv","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവ്","order":23,"numberOfChapters":66,"sha256":"45eb2dbc632d76759f55420c9d5113aa31e38d8ae6f344595050753381ccd595","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_irv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":24,"content":[{"type":"heading","content":["ഭൂമിയുടെ ശിക്ഷാവിധി"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"യഹോവ ഭൂമിയെ നിർജ്ജനവും ശൂന്യവും ആക്കി കീഴ്മേൽ മറിക്കുകയും","poem":1},{"text":"അതിലെ നിവാസികളെ ചിതറിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ജനത്തിനും പുരോഹിതനും,","poem":1},{"text":"ദാസനും യജമാനനും,","poem":2},{"lineBreak":true},{"text":"ദാസിക്കും യജമാനത്തിക്കും,","poem":2},{"text":"വാങ്ങുന്നവനും വില്‍ക്കുന്നവനും,","poem":1},{"text":"കടം കൊടുക്കുന്നവനും കടം വാങ്ങുന്നവനും,","poem":2},{"text":"പലിശ വാങ്ങുന്നവനും പലിശ കൊടുക്കുന്നവനും","poem":1},{"text":"ഒരുപോലെ സംഭവിക്കും.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ഭൂമി അശേഷം നിർജ്ജനമായും കവർച്ചയായും പോകും;","poem":1},{"text":"യഹോവയല്ലയോ ഈ വചനം അരുളിച്ചെയ്തിരിക്കുന്നത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ഭൂമി ദുഃഖിച്ചു വാടിപ്പോകുന്നു;","poem":1},{"text":"ഭൂതലം ക്ഷയിച്ചു വാടിപ്പോകുന്നു;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ഭൂമിയിലെ ഉന്നതന്മാർ ക്ഷീണിച്ചുപോകുന്നു.","poem":1},{"text":"ഭൂമി അതിലെ നിവാസികളാൽ മലിനമായിരിക്കുന്നു;","poem":2},{"text":"അവർ പ്രമാണങ്ങളെ ലംഘിച്ചു","poem":1},{"text":"ചട്ടത്തെ മറിച്ചു","poem":2},{"lineBreak":true},{"text":"നിത്യനിയമത്തിനു ഭംഗം വരുത്തിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അതുകൊണ്ട് ഭൂമി ശാപഗ്രസ്തമായി","poem":1},{"text":"അതിൽ വസിക്കുന്നവർ ശിക്ഷ അനുഭവിക്കുന്നു;","poem":2},{"text":"അതുകൊണ്ട് ഭൂവാസികൾ ദഹിച്ചുപോയി,","poem":1},{"text":"ചുരുക്കം പേർ മാത്രം ശേഷിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"പുതുവീഞ്ഞ് ദുഃഖിക്കുന്നു;","poem":1},{"text":"മുന്തിരിവള്ളി വാടുന്നു;","poem":2},{"lineBreak":true},{"text":"സന്തുഷ്ടമാനസന്മാരെല്ലാം നെടുവീർപ്പിടുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"തപ്പുകളുടെ ആനന്ദം നിന്നുപോകുന്നു;","poem":1},{"text":"ഉല്ലസിക്കുന്നവരുടെ ഘോഷം തീർന്നുപോകുന്നു;","poem":2},{"lineBreak":true},{"text":"കിന്നരത്തിന്‍റെ ആനന്ദം ഇല്ലാതെയാകുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവർ പാട്ടു പാടിക്കൊണ്ടു വീഞ്ഞു കുടിക്കുകയില്ല;","poem":1},{"text":"മദ്യം കുടിക്കുന്നവർക്ക് അത് കയ്പായിരിക്കും.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ശൂന്യപട്ടണം ഇടിഞ്ഞുകിടക്കുന്നു;","poem":1},{"text":"ആർക്കും കടന്നു കൂടാത്തവിധം എല്ലാ വീടും അടഞ്ഞുപോയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"വീഞ്ഞില്ലായ്കയാൽ വീഥികളിൽ നിലവിളികേൾക്കുന്നു;","poem":1},{"text":"സന്തോഷം ഒക്കെ ഇരുണ്ടിരിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"ദേശത്തിലെ ആനന്ദം പൊയ്പോയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"പട്ടണത്തിൽ ശൂന്യത മാത്രം ശേഷിച്ചിരിക്കുന്നു;","poem":1},{"text":"വാതിൽതകർന്നു നാശമായി കിടക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ഒലിവു തല്ലുംപോലെയും","poem":1},{"text":"മുന്തിരിപ്പഴം പറിച്ചു തീർന്നിട്ട് കാലാ പെറുക്കുംപോലെയും","poem":2},{"text":"ഭൂമിയുടെ മദ്ധ്യത്തിൽ","poem":1},{"text":"ജനതകളുടെ ഇടയിൽ സംഭവിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"അവർ ഉച്ചത്തിൽ ആർക്കും;","poem":1},{"text":"യഹോവയുടെ മഹിമനിമിത്തം","poem":2},{"lineBreak":true},{"text":"അവർ സമുദ്രത്തിൽനിന്ന് ഉറക്കെ ആർക്കും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അതുകൊണ്ട് നിങ്ങൾ കിഴക്ക് യഹോവയെയും","poem":1},{"text":"സമുദ്രദ്വീപികളില്‍ യിസ്രായേലിന്‍റെ ദൈവമായ യഹോവയുടെ നാമത്തെയും മഹത്ത്വപ്പെടുത്തുവിൻ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“നീതിമാന് മഹത്ത്വം” എന്നിങ്ങനെ ഭൂമിയുടെ അറ്റത്തുനിന്നു","poem":1},{"text":"കീർത്തനം പാടുന്നതു ഞങ്ങൾ കേട്ടു;","poem":2},{"text":"ഞാനോ: “എനിക്ക് ക്ഷയം, എനിക്ക് ക്ഷയം, എനിക്ക് അയ്യോ കഷ്ടം!” എന്നു പറഞ്ഞു.","poem":1},{"text":"“ദ്രോഹികൾ ദ്രോഹം ചെയ്തിരിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"ദ്രോഹികൾ മഹാദ്രോഹം ചെയ്തിരിക്കുന്നു.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ഭൂവാസിയേ, പേടിയും കുഴിയും കെണിയും","poem":1},{"text":"നിനക്കു നേരിട്ടിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"പേടി കേട്ട് ഓടിപ്പോകുന്നവൻ കുഴിയിൽ വീഴും;","poem":2},{"lineBreak":true},{"text":"കുഴിയിൽനിന്നു കയറുന്നവൻ കെണിയിൽ അകപ്പെടും;","poem":2},{"text":"ഉയരത്തിലെ കിളിവാതിലുകൾ തുറന്നിരിക്കുന്നു;","poem":1},{"text":"ഭൂമിയുടെ അടിസ്ഥാനങ്ങൾ കുലുങ്ങുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ഭൂമി പൊടുപൊടെ പൊട്ടുന്നു;","poem":1},{"text":"ഭൂമി കിറുകിറെ കീറുന്നു;","poem":2},{"lineBreak":true},{"text":"ഭൂമി കിടുകിട കിടുങ്ങുന്നു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ഭൂമി മദ്യപനെപ്പോലെ ചാഞ്ചാടുന്നു;","poem":1},{"text":"കാവൽമാടംപോലെ ആടുന്നു;","poem":2},{"text":"അതിന്‍റെ അകൃത്യം അതിന്മേൽ ഭാരമായിരിക്കുന്നു;","poem":1},{"text":"അത് വീഴും, എഴുന്നേല്ക്കുകയുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ആ നാളിൽ യഹോവ ഉയരത്തിൽ ഉന്നതന്മാരുടെ സൈന്യത്തെയും","poem":1},{"text":"ഭൂമിയിൽ ഭൂരാജാക്കന്മാരെയും ശിക്ഷിക്കും.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"കുണ്ടറയിൽ തടവുകാരെപ്പോലെ അവരെ ഒന്നിച്ച് കൂട്ടി","poem":1},{"text":"കാരാഗൃഹത്തിൽ അടയ്ക്കുകയും","poem":2},{"lineBreak":true},{"text":"ഏറിയനാൾ കഴിഞ്ഞിട്ട് അവരെ സന്ദർശിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"സൈന്യങ്ങളുടെ യഹോവ സീയോൻ പർവ്വതത്തിലും യെരൂശലേമിലും വാഴുകയാലും","poem":1},{"text":"അവന്‍ തന്‍റെ തേജസ്സ് മൂപ്പന്മാരുടെ മുമ്പിൽ വെളിപ്പെടുത്തുകയാലും","poem":2},{"text":"ചന്ദ്രൻ നാണിക്കുകയും","poem":1},{"text":"സൂര്യൻ ലജ്ജിക്കുകയും ചെയ്യും.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}