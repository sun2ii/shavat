{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_irv","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവ്","order":23,"numberOfChapters":66,"sha256":"45eb2dbc632d76759f55420c9d5113aa31e38d8ae6f344595050753381ccd595","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_irv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":32,"content":[{"type":"heading","content":["നീതിയുടെ രാജാവ്"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"ഇതാ, ഒരു രാജാവ് നീതിയോടെ വാഴും;","poem":1},{"text":"പ്രഭുക്കന്മാർ ന്യായത്തോടെ അധികാരം നടത്തും.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ഓരോരുത്തൻ കാറ്റിന് ഒരു മറവും","poem":1},{"text":"കൊടുങ്കാറ്റിന് ഒരു സങ്കേതവും ആയിരിക്കും.","poem":2},{"text":"അവർ വരണ്ട നിലത്തു നീർത്തോടുകൾപോലെയും","poem":1},{"text":"ക്ഷീണമുള്ള ദേശത്ത് വൻപാറയുടെ തണൽപോലെയും ഇരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"കാണുന്നവരുടെ കണ്ണ് ഇനി മങ്ങുകയില്ല;","poem":1},{"text":"കേൾക്കുന്നവരുടെ ചെവി ശ്രദ്ധിക്കും.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവിവേകികളുടെ ഹൃദയം പരിജ്ഞാനം ഗ്രഹിക്കും;","poem":1},{"text":"വിക്കന്മാരുടെ നാവ് തടസ്സമില്ലാതെ വ്യക്തമായി സംസാരിക്കും.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ഭോഷനെ ഇനി ഉത്തമൻ എന്നു വിളിക്കുകയില്ല;","poem":1},{"text":"ആഭാസനെ മഹാത്മാവെന്നു പറയുകയുമില്ല.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഭോഷൻ ഭോഷത്തം സംസാരിക്കും;","poem":1},{"text":"വഷളത്തം ചെയ്തും യഹോവയ്ക്കു വിരോധമായി അബദ്ധം സംസാരിച്ചും","poem":2},{"text":"വിശപ്പുള്ളവരെ പട്ടിണിയിട്ടും","poem":1},{"text":"ദാഹമുള്ളവർക്കു പാനം മുടക്കിയുംകൊണ്ട്","poem":2},{"lineBreak":true},{"text":"അവന്‍റെ ഹൃദയം നീതികേടും പ്രവർത്തിക്കും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ആഭാസന്‍റെ ആയുധങ്ങളും ദോഷമുള്ളവ;","poem":1},{"text":"ദരിദ്രൻ ന്യായമായി സംസാരിച്ചാലും","poem":2},{"text":"എളിയവരെ വ്യാജവാക്കുകൊണ്ടു നശിപ്പിക്കുവാൻ","poem":1},{"text":"അവൻ ദുരുപായങ്ങൾ നിരൂപിക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ഉത്തമനോ ഉത്തമകാര്യങ്ങളെ ചിന്തിക്കുന്നു;","poem":1},{"text":"ഉത്തമകാര്യങ്ങളിൽ അവൻ ഉറ്റുനില്ക്കുന്നു.","poem":2}]},{"type":"heading","content":["യെരൂശലേമിലെ സ്ത്രീകൾ"]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"സ്വൈരമായിരിക്കുന്ന സ്ത്രീകളേ, എഴുന്നേറ്റ് എന്‍റെ വാക്കു കേൾക്കുവിൻ;","poem":1},{"text":"ചിന്തയില്ലാത്ത പുത്രിമാരെ, എന്‍റെ വചനം ശ്രദ്ധിക്കുവിൻ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ചിന്തയില്ലാത്ത പെണ്ണുങ്ങളേ, ഒരു വർഷവും കുറെ ദിവസവും കഴിയുമ്പോൾ നിങ്ങൾ നടുങ്ങിപ്പോകും;","poem":1},{"text":"മുന്തിരിക്കൊയ്ത്തു നഷ്ടമാകും; ഫലശേഖരം ഉണ്ടാവുകയുമില്ല.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"സ്വൈരമായിരിക്കുന്ന സ്ത്രീകളേ, വിറയ്ക്കുവിൻ;","poem":1},{"text":"ചിന്തയില്ലാത്ത പെണ്ണുങ്ങളേ, നടുങ്ങുവിൻ;","poem":2},{"text":"വസ്ത്രം ഉരിഞ്ഞു നഗ്നരാകുവിൻ;","poem":1},{"text":"അരയിൽ ചാക്ക് കെട്ടുവിൻ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"മനോഹരമായ വയലുകളെയും","poem":1},{"text":"ഫലപുഷ്ടിയുള്ള മുന്തിരിവള്ളിയെയും ഓർത്തു","poem":2},{"lineBreak":true},{"text":"അവർ മാറത്ത് അടിക്കും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"എന്‍റെ ജനത്തിന്‍റെ ദേശത്ത്","poem":1},{"text":"ഉല്ലസിതനഗരത്തിലെ സകലസന്തോഷഭവനങ്ങളിലും തന്നെ","poem":2},{"lineBreak":true},{"text":"മുള്ളും മുൾച്ചെടിയും മുളയ്ക്കും.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"കൊട്ടാരം ഉപേക്ഷിക്കപ്പെടും;","poem":1},{"text":"ജനപുഷ്ടിയുള്ള നഗരം നിർജ്ജനമായിത്തീരും;","poem":2},{"text":"കുന്നും കാവല്‍ഗോപുരവും സദാകാലത്തേക്കും ഗുഹകളായി ഭവിക്കും;","poem":1},{"text":"അവ കാട്ടുകഴുതകളുടെ സന്തോഷസ്ഥാനവും","poem":2},{"lineBreak":true},{"text":"ആട്ടിൻ കൂട്ടങ്ങളുടെ മേച്ചിൽപുറവും ആയിരിക്കും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഉയരത്തിൽനിന്ന് ദൈവത്തിന്‍റെ ആത്മാവിനെ നമ്മുടെമേൽ പകരുവോളം തന്നെ;","poem":1},{"text":"അപ്പോൾ മരുഭൂമി ഉദ്യാനമായിത്തീരും","poem":2},{"noteId":65},{"text":";","poem":2},{"lineBreak":true},{"text":"ഉദ്യാനം വനമായി എണ്ണപ്പെടും.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അന്നു മരുഭൂമിയിൽ ന്യായം വസിക്കും;","poem":1},{"text":"ഉദ്യാനത്തിൽ നീതി പാർക്കും.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"നീതിയുടെ പ്രവൃത്തി സമാധാനവും","poem":1},{"text":"നീതിയുടെ ഫലം ശാശ്വതവിശ്രമവും നിർഭയത്വവും ആയിരിക്കും.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"എന്‍റെ ജനം സമാധാനനിവാസത്തിലും നിർഭയവസതികളിലും","poem":1},{"text":"സ്വൈരമുള്ള വിശ്രമസ്ഥലങ്ങളിലും വസിക്കും.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"എന്നാൽ വനത്തിന്‍റെ വീഴ്ചയ്ക്കു കന്മഴ പെയ്യുകയും","poem":1},{"text":"നഗരം അശേഷം നിലംപരിചാകുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"വെള്ളത്തിനരികത്തെല്ലാം വിതയ്ക്കുകയും","poem":1},{"text":"കാളയെയും കഴുതയെയും അഴിച്ചുവിടുകയും ചെയ്യുന്നവരേ, നിങ്ങൾക്ക് ഭാഗ്യം!","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":65,"caller":"+","text":"ഉദ്യാനം ഫലപുഷ്ടിയുള്ള വയൽ എന്നുമാകാം.","reference":{"chapter":32,"verse":15}}]},"thisChapterLink":"/api/mal_irv/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}