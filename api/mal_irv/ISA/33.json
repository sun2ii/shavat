{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_irv","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവ്","order":23,"numberOfChapters":66,"sha256":"45eb2dbc632d76759f55420c9d5113aa31e38d8ae6f344595050753381ccd595","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_irv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":33,"content":[{"type":"heading","content":["വൈഷമ്യവും സഹായവും"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"സാഹസം അനുഭവിക്കാതെ സാഹസം ചെയ്യുകയും","poem":1},{"text":"നിന്നോട് ആരും ദ്രോഹം പ്രവർത്തിക്കാതെ","poem":2},{"text":"ദ്രോഹം പ്രവർത്തിക്കുകയും ചെയ്യുന്നവനേ,","poem":1},{"text":"നിനക്കു അയ്യോ കഷ്ടം!","poem":2},{"text":"നീ സാഹസം ചെയ്യുന്നതു നിർത്തുമ്പോൾ","poem":1},{"text":"നിന്നെയും സാഹസം ചെയ്യും;","poem":2},{"text":"നീ ദ്രോഹം പ്രവർത്തിക്കുന്നതു മതിയാക്കുമ്പോൾ","poem":1},{"text":"നിന്നോടും ദ്രോഹം പ്രവർത്തിക്കും.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"യഹോവേ, ഞങ്ങളോടു കൃപയുണ്ടാകേണമേ;","poem":1},{"text":"ഞങ്ങൾ അങ്ങയെ കാത്തിരിക്കുന്നു;","poem":2},{"text":"രാവിലെതോറും അങ്ങ് അവർക്ക് ഭുജവും","poem":1},{"text":"കഷ്ടകാലത്തു ഞങ്ങൾക്കു രക്ഷയും ആയിരിക്കേണമേ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"കോലാഹലം ഹേതുവായി വംശങ്ങൾ ഓടിപ്പോയി;","poem":1},{"text":"അങ്ങ് എഴുന്നേറ്റപ്പോൾ ജനതകൾ ചിതറിപ്പോയി.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"തുള്ളനെ ശേഖരിക്കുന്നതുപോലെ നിങ്ങളുടെ കവർച്ച ശേഖരിക്കപ്പെടും;","poem":1},{"text":"വെട്ടുക്കിളി ചാടി വീഴുന്നതുപോലെ അവർ അതിന്മേൽ ചാടിവീഴും.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"യഹോവ ഉന്നതനായിരിക്കുന്നു;","poem":1},{"text":"ഉയരത്തിലല്ലയോ അവിടുന്ന് വസിക്കുന്നത്;","poem":2},{"lineBreak":true},{"text":"അവിടുന്ന് സീയോനെ ന്യായവും നീതിയുംകൊണ്ടു നിറച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"നിന്‍റെ കാലത്ത് സ്ഥിരതയും രക്ഷാസമൃദ്ധിയും","poem":1},{"text":"ജ്ഞാനവും പരിജ്ഞാനവും ഉണ്ടാകും;","poem":2},{"lineBreak":true},{"text":"യഹോവാഭക്തി നിങ്ങളുടെ","poem":2},{"noteId":66},{"text":"നിക്ഷേപം ആയിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ഇതാ അവരുടെ ശൗര്യവാന്മാർ","poem":1},{"noteId":67},{"text":"പുറത്തു നിലവിളിക്കുന്നു;","poem":1},{"text":"സമാധാനത്തിന്‍റെ ദൂതന്മാർ അതിദുഃഖത്തോടെ കരയുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"പ്രധാനപാതകൾ ശൂന്യമായിക്കിടക്കുന്നു;","poem":1},{"text":"വഴിപോക്കർ ഇല്ലാതെയായിരിക്കുന്നു;","poem":2},{"text":"അവൻ ഉടമ്പടി ലംഘിച്ചു, പട്ടണങ്ങളെ","poem":1},{"noteId":68},{"text":"നിന്ദിച്ചു:","poem":1},{"text":"ഒരു മനുഷ്യനെയും അവിടുന്ന് ആദരിക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ദേശം ദുഃഖിച്ചു ക്ഷയിക്കുന്നു;","poem":1},{"text":"ലെബാനോൻ ലജ്ജിച്ചു വാടിപ്പോകുന്നു;","poem":2},{"text":"ശാരോൻ മരുഭൂമിപോലെ ആയിരിക്കുന്നു;","poem":1},{"text":"ബാശാനും കർമ്മേലും ഇലപൊഴിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ഇപ്പോൾ ഞാൻ എഴുന്നേല്‍ക്കും;","poem":1},{"text":"ഇപ്പോൾ ഞാൻ എന്നെത്തന്നെ ഉയർത്തും;","poem":2},{"lineBreak":true},{"text":"ഇപ്പോൾ ഞാൻ ഉന്നതനായിരിക്കും” എന്നു യഹോവ അരുളിച്ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“നിങ്ങൾ കച്ചിയെ ഗർഭംധരിച്ചു കച്ചികുറ്റിയെ പ്രസവിക്കും;","poem":1},{"text":"നിങ്ങളുടെ ശ്വാസം തീയായി നിങ്ങളെ ദഹിപ്പിച്ചുകളയും.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"വംശങ്ങൾ കുമ്മായം ചുടുന്നതുപോലെ ആകും;","poem":1},{"text":"വെട്ടിക്കളഞ്ഞ മുള്ളുപോലെ അവരെ തീയിൽ ഇട്ടു ചുട്ടുകളയും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ദൂരസ്ഥന്മാരേ, ഞാൻ ചെയ്തതു കേൾക്കുവിൻ;","poem":1},{"text":"സമീപസ്ഥന്മാരേ, എന്‍റെ വീര്യപ്രവൃത്തികൾ ഗ്രഹിക്കുവിൻ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"സീയോനിലെ പാപികൾ പേടിക്കുന്നു;","poem":1},{"text":"വഷളന്മാരായവർക്കു നടുക്കം പിടിച്ചിരിക്കുന്നു;","poem":2},{"text":"“നമ്മിൽ ആര്‍ ദഹിപ്പിക്കുന്ന തീയുടെ അടുക്കൽ വസിക്കും?","poem":1},{"text":"നമ്മിൽ ആര്‍ നിത്യദഹനങ്ങളുടെ അടുക്കൽ വസിക്കും?”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"നീതിയായി നടന്നു നേര് പറയുകയും","poem":1},{"text":"പീഡനത്താൽ ഉള്ള ആദായം വെറുക്കുകയും","poem":2},{"text":"കൈക്കൂലിവാങ്ങാതെ കൈ കുടഞ്ഞുകളയുകയും","poem":1},{"text":"രക്തപാതകത്തെക്കുറിച്ചു കേൾക്കാത്തവിധം ചെവി പൊത്തുകയും","poem":2},{"text":"ദോഷത്തെ കണ്ടു രസിക്കാത്തവിധം കണ്ണ് അടച്ചുകളയുകയും ചെയ്യുന്നവൻ;","poem":1}]},{"type":"verse","number":16,"content":[{"text":"ഇങ്ങനെയുള്ളവൻ ഉയരത്തിൽ വസിക്കും;","poem":2},{"text":"പാറക്കോട്ടകൾ അവന്‍റെ അഭയസ്ഥാനമായിരിക്കും;","poem":1},{"text":"അവന്‍റെ അപ്പം അവനു കിട്ടും; അവനു വെള്ളം മുട്ടിപ്പോകുകയുമില്ല.","poem":2}]},{"type":"heading","content":["മഹത്ത്വമേറിയ ഭാവി"]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"നിന്‍റെ കണ്ണ് രാജാവിനെ അവന്‍റെ സൗന്ദര്യത്തോടെ ദർശിക്കും;","poem":1},{"text":"വിശാലമായ ഒരു ദേശം കാണും.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“പണം എണ്ണുന്നവൻ എവിടെ?","poem":1},{"text":"തൂക്കിനോക്കുന്നവൻ എവിടെ?","poem":2},{"text":"ഗോപുരങ്ങളെ എണ്ണുന്നവൻ എവിടെ?”","poem":1},{"text":"എന്നിങ്ങനെ നിന്‍റെ ഹൃദയം ഭീതിയെക്കുറിച്ചു ധ്യാനിക്കും.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"നീ തിരിച്ചറിയാത്ത പ്രയാസമുള്ള വാക്കും","poem":1},{"text":"നിനക്കു ഗ്രഹിച്ചുകൂടാത്ത അന്യഭാഷയും","poem":2},{"lineBreak":true},{"text":"ഉള്ള ഉഗ്രജനതയെ നീ കാണുകയില്ല.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"നമ്മുടെ ഉത്സവങ്ങളുടെ നഗരമായ സീയോനെ നോക്കുക;","poem":1},{"text":"നിന്‍റെ കണ്ണ് യെരൂശലേമിനെ സ്വൈരനിവാസമായും","poem":2},{"text":"ഒരിക്കലും നീങ്ങിപ്പോകാത്തതും കുറ്റി","poem":1},{"text":"ഒരുനാളും ഇളകിപ്പോകാത്തതും കയറ്","poem":2},{"lineBreak":true},{"text":"ഒന്നും പൊട്ടിപ്പോകാത്തതുമായ കൂടാരമായും കാണും.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവിടെ മഹിമയുള്ളവനായ യഹോവ നമുക്കു","poem":1},{"text":"വീതിയുള്ള നദികൾക്കും തോടുകൾക്കും പകരമായിരിക്കും;","poem":2},{"text":"തുഴവച്ച പടക് അതിൽ പോവുകയില്ല;","poem":1},{"lineBreak":true},{"text":"പ്രതാപമുള്ള കപ്പൽ അതിൽകൂടി കടന്നുപോവുകയുമില്ല.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"യഹോവ നമ്മുടെ ന്യായാധിപൻ;","poem":1},{"text":"യഹോവ നമ്മുടെ ന്യായദാതാവ്;","poem":2},{"text":"യഹോവ നമ്മുടെ രാജാവ്;","poem":1},{"text":"അവിടുന്ന് നമ്മെ രക്ഷിക്കും.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"നിന്‍റെ കയറ് അഴിഞ്ഞുകിടക്കുന്നു;","poem":1},{"text":"അതിനാൽ പാമരത്തെ ചുവട്ടിൽ ഉറപ്പിച്ചുകൂടാ;","poem":2},{"text":"പായ് നിവിർത്തുകൂടാ. പിടിച്ചുപറിച്ച വലിയ കൊള്ള അന്നു വിഭാഗിക്കപ്പെടും;","poem":1},{"text":"മുടന്തരും കൊള്ളയിടും.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"“ഞാൻ രോഗിയാണ്” എന്നു യാതൊരു നിവാസിയും പറയുകയില്ല;","poem":1},{"text":"അതിൽ വസിക്കുന്ന ജനത്തിന്‍റെ അകൃത്യം മോചിക്കപ്പെട്ടിരിക്കും.","poem":2}]}],"footnotes":[{"noteId":66,"caller":"+","text":"നിങ്ങളുടെ സീയോൻ്റെ","reference":{"chapter":33,"verse":6}},{"noteId":67,"caller":"+","text":"ശൗര്യവാന്മാർ വീരൻമാർ.","reference":{"chapter":33,"verse":7}},{"noteId":68,"caller":"+","text":"പട്ടണങ്ങളെ സാക്ഷികളെ","reference":{"chapter":33,"verse":8}}]},"thisChapterLink":"/api/mal_irv/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}