{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ISA","translationId":"mal_irv","name":"യെശയ്യാവ്","commonName":"യെശയ്യാവ്","title":"യെശയ്യാവ്","order":23,"numberOfChapters":66,"sha256":"45eb2dbc632d76759f55420c9d5113aa31e38d8ae6f344595050753381ccd595","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mal_irv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":34,"content":[{"type":"heading","content":["രാഷ്ട്രങ്ങൾക്കെതിരേയുള്ള ന്യായവിധി"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"ജനതകളേ, അടുത്തുവന്നു കേൾക്കുവിൻ;","poem":1},{"text":"വംശങ്ങളേ, ശ്രദ്ധതരുവിൻ;","poem":2},{"text":"ഭൂമിയും അതിന്‍റെ നിറവും","poem":1},{"text":"ഭൂതലവും അതിൽ മുളയ്ക്കുന്ന സകലവും കേൾക്കട്ടെ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"യഹോവയ്ക്കു സകലജനതകളോടും കോപവും","poem":1},{"text":"അവരുടെ സർവ്വസൈന്യത്തോടും ക്രോധവും ഉണ്ട്;","poem":2},{"lineBreak":true},{"text":"അവൻ അവരെ ശപഥാർപ്പിതമായി കൊലയ്ക്ക് ഏല്പിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവരുടെ കൊല്ലപ്പെട്ടവരെ എറിഞ്ഞുകളയും;","poem":1},{"text":"അവരുടെ ശവങ്ങളിൽനിന്നു നാറ്റം പുറപ്പെടും;","poem":2},{"lineBreak":true},{"text":"അവരുടെ രക്തംകൊണ്ടു മലകൾ ഉരുകിപ്പോകും.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ആകാശത്തിലെ സൈന്യമെല്ലാം അലിഞ്ഞുപോകും;","poem":1},{"text":"ആകാശവും ഒരു ചുരുൾപോലെ ചുരുണ്ടുപോകും;","poem":2},{"text":"അതിലെ സൈന്യമെല്ലാം മുന്തിരിവള്ളിയുടെ ഇല വാടി പൊഴിയുന്നതുപോലെയും","poem":1},{"text":"അത്തിവൃക്ഷത്തിന്‍റെ കായ് വാടി പൊഴിയുന്നതുപോലെയും പൊഴിഞ്ഞുപോകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"എന്‍റെ വാൾ ആകാശത്തിൽ ലഹരിപിടിച്ചിരിക്കുന്നു;","poem":1},{"text":"അത് ഏദോമിന്മേലും എന്‍റെ ശപഥാർപ്പിതജനത്തിന്മേലും","poem":2},{"lineBreak":true},{"text":"ന്യായവിധിക്കായി ഇറങ്ങിവരും.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"യഹോവയുടെ വാൾ രക്തം പുരണ്ടും കൊഴുപ്പു പൊതിഞ്ഞും ഇരിക്കുന്നു;","poem":1},{"text":"കുഞ്ഞാടുകളുടെയും കോലാടുകളുടെയും രക്തംകൊണ്ടും","poem":2},{"text":"ആട്ടുകൊറ്റന്മാരുടെ വൃക്കകളുടെ കൊഴുപ്പുംകൊണ്ടും തന്നെ;","poem":1},{"text":"യഹോവയ്ക്കു ബൊസ്ര പട്ടണത്തില്‍ ഒരു യാഗവും","poem":2},{"lineBreak":true},{"text":"ഏദോംദേശത്ത് ഒരു മഹാസംഹാരവും ഉണ്ട്.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവയോടുകൂടി കാട്ടുപോത്തുകളും","poem":1},{"text":"കാളകളോടുകൂടി മൂരികളും വീഴും;","poem":2},{"text":"അവരുടെ ദേശം രക്തം കുടിച്ചു ലഹരിപിടിക്കും;","poem":1},{"text":"അവരുടെ നിലം കൊഴുപ്പുകൊണ്ടു നിറഞ്ഞിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"അത് യഹോവ പ്രതികാരം നടത്തുന്ന ദിവസവും","poem":1},{"text":"സീയോൻ്റെ വ്യവഹാരത്തിൽ പകരംവീട്ടുന്ന","poem":2},{"noteId":69},{"text":"വർഷവും ആകുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഏദോമിന്‍റെ തോടുകൾ കീലായും മണ്ണ് ഗന്ധകമായും","poem":1},{"text":"നിലം കത്തുന്ന കീലായും ഭവിക്കും.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"രാവും പകലും അത് കെടുകയില്ല;","poem":1},{"text":"അതിന്‍റെ പുക സദാകാലം പൊങ്ങിക്കൊണ്ടിരിക്കും;","poem":2},{"text":"തലമുറതലമുറയായി അത് ശൂന്യമായി കിടക്കും;","poem":1},{"text":"ഒരുത്തനും ഒരുനാളും അതിൽകൂടി കടന്നുപോവുകയുമില്ല.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"വേഴാമ്പലും മുള്ളൻപന്നിയും അതിനെ കൈവശമാക്കും;","poem":1},{"text":"മൂങ്ങയും മലങ്കാക്കയും അതിൽ പാർക്കും;","poem":2},{"text":"അവൻ അതിന്മേൽ പാഴിന്‍റെ നൂലും","poem":1},{"text":"ശൂന്യത്തിന്‍റെ തൂക്കുകട്ടിയും പിടിക്കും.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അതിലെ കുലീനന്മാർ","poem":1},{"noteId":70},{"text":"ആരും രാജത്വം ഘോഷിക്കുകയില്ല;","poem":1},{"text":"അതിലെ പ്രഭുക്കന്മാർ എല്ലാവരും ഒന്നുമില്ലാതെയായിപ്പോകും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അതിന്‍റെ അരമനകളിൽ മുള്ളും","poem":1},{"text":"അതിന്‍റെ കോട്ടകളിൽ തൂവയും ഞെരിഞ്ഞിലും മുളയ്ക്കും;","poem":2},{"text":"അത് കുറുക്കന്മാർക്കു പാർപ്പിടവും","poem":1},{"text":"ഒട്ടകപ്പക്ഷികൾക്കു താവളവും ആകും.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"മരുഭൂമിയിലെ വന്യമൃഗങ്ങളും ചെന്നായ്ക്കളും തമ്മിൽ എതിർപ്പെടും;","poem":1},{"text":"വനഭൂതം വനഭൂതത്തെ വിളിക്കും;","poem":2},{"text":"അവിടെ വേതാളം","poem":1},{"noteId":71},{"text":"കിടക്കുകയും","poem":1},{"text":"വിശ്രമം പ്രാപിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവിടെ മൂങ്ങ കൂടുണ്ടാക്കി മുട്ടയിട്ടു വിരിയിച്ചു","poem":1},{"text":"കുഞ്ഞുങ്ങളെ തന്‍റെ നിഴലിൻ കീഴിൽ ചേർത്തുകൊള്ളും;","poem":2},{"lineBreak":true},{"text":"അവിടെ പരുന്തുകൾ അതതിന്‍റെ ഇണയോടു കൂടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"യഹോവയുടെ പുസ്തകത്തിൽ അന്വേഷിച്ചു വായിച്ചു നോക്കുവിൻ;","poem":1},{"text":"അവയിൽ ഒന്നും കാണാതിരിക്കുകയില്ല;","poem":2},{"text":"ഒന്നിനും ഇണ ഇല്ലാതിരിക്കുകയുമില്ല;","poem":1},{"text":"അവിടുത്തെ വായല്ലയോ കല്പിച്ചത്;","poem":2},{"lineBreak":true},{"text":"അവിടുത്തെ ആത്മാവത്രേ അവയെ കൂട്ടിവരുത്തിയത്.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവിടുന്ന് അവക്കായി ചീട്ടിട്ടു,","poem":1},{"text":"അവിടുത്തെ കൈ അതിനെ അവയ്ക്കു ചരടുകൊണ്ടു വിഭാഗിച്ചു കൊടുത്തു;","poem":2},{"text":"അവ സദാകാലത്തേക്കും അതിനെ കൈവശമാക്കി","poem":1},{"text":"തലമുറതലമുറയായി അതിൽ വസിക്കും.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":69,"caller":"+","text":"സീയോൻ്റെ വ്യവഹാരത്തിൽ പകരംവീട്ടുന്ന സീയോനുവേണ്ടി പകരംവീട്ടുന്ന എന്നുമാകാം.","reference":{"chapter":34,"verse":8}},{"noteId":70,"caller":"+","text":"കുലീനന്മാർ ഉന്നതകുലജാതന്മാർ.","reference":{"chapter":34,"verse":12}},{"noteId":71,"caller":"+","text":"വേതാളം നത്ത് എന്നു എബ്രായ ബൈബിളിൽ.","reference":{"chapter":34,"verse":14}}]},"thisChapterLink":"/api/mal_irv/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}