{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"JER","translationId":"mal_irv","name":"യിരെമ്യാവ്","commonName":"യിരെമ്യാവ്","title":"യിരെമ്യാവ്","order":24,"numberOfChapters":52,"sha256":"29cffc66b01f24d773fad7ed8c7329d0ebb0ee558b2f09803c2c269a4b6d80c1","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/mal_irv/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":5,"content":[{"type":"heading","content":["യെരൂശലേമിന്‍റെ പാപം"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"“ന്യായം പ്രവർത്തിക്കുകയും വിശ്വസ്തത കാണിക്കുകയും ചെയ്യുന്നവൻ ഉണ്ടോ?","poem":1},{"text":"അങ്ങനെ ഒരു മനുഷ്യനെ കാണുമോ എന്നു","poem":2},{"text":"യെരൂശലേമിന്‍റെ വീഥികളിൽ ചുറ്റിനടന്ന് അന്വേഷിക്കുകയും","poem":1},{"text":"അതിന്‍റെ വിശാലസ്ഥലങ്ങളിൽ തിരഞ്ഞു അറിയുകയും ചെയ്യുവിൻ;","poem":2},{"lineBreak":true},{"text":"കണ്ടു എങ്കിൽ ഞാൻ അതിനോട് ക്ഷമിക്കും.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"‘യഹോവയാണ’ എന്നു പറഞ്ഞാലും","poem":1},{"text":"അവർ കപടമായിട്ടാണ് സത്യം ചെയ്യുന്നത്.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"യഹോവേ, അങ്ങേയുടെ കണ്ണുകൾ വിശ്വസ്തതയല്ലയോ നോക്കുന്നത്?","poem":1},{"text":"അവിടുന്ന് അവരെ അടിച്ചു എങ്കിലും അവർക്ക് വേദനിച്ചില്ല;","poem":2},{"lineBreak":true},{"text":"അവിടുന്ന് അവരെ ക്ഷയിപ്പിച്ചു എങ്കിലും","poem":2},{"lineBreak":true},{"text":"അവർക്ക് ബോധം കൈക്കൊള്ളുവാൻ മനസ്സില്ലായിരുന്നു;","poem":2},{"text":"അവർ അവരുടെ മുഖം പാറയെക്കാൾ കടുപ്പമാക്കി;","poem":1},{"text":"മടങ്ങിവരുവാൻ അവർക്ക് മനസ്സില്ലായിരുന്നു.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"അതുകൊണ്ട് ഞാൻ: “ഇവർ അല്പന്മാർ,","poem":1},{"text":"ബുദ്ധിഹീനർ തന്നെ;","poem":2},{"text":"അവർ യഹോവയുടെ വഴിയും","poem":1},{"text":"തങ്ങളുടെ ദൈവത്തിന്‍റെ ന്യായവും അറിയുന്നില്ല.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ഞാൻ മഹാന്മാരുടെ അടുക്കൽ ചെന്നു","poem":1},{"text":"അവരോടു സംസാരിക്കും;","poem":2},{"text":"അവർ യഹോവയുടെ വഴിയും","poem":1},{"text":"തങ്ങളുടെ ദൈവത്തിന്‍റെ ന്യായവും അറിയും” എന്നു പറഞ്ഞു;","poem":2},{"text":"എന്നാൽ അവരും ഒന്നുപോലെ നുകം തകർത്ത്","poem":1},{"text":"കയറു പൊട്ടിച്ചുകളഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"അതുകൊണ്ട് കാട്ടിൽനിന്ന് ഒരു സിംഹം വന്ന് അവരെ കൊല്ലും;","poem":1},{"text":"മരുപ്രദേശത്തിലെ ചെന്നായ് അവരെ പിടിച്ചു കൊണ്ടുപോകും;","poem":2},{"lineBreak":true},{"text":"പുള്ളിപ്പുലി അവരുടെ പട്ടണങ്ങൾക്കെതിരെ പതിയിരിക്കും;","poem":2},{"lineBreak":true},{"text":"അവയിൽ നിന്ന് പുറപ്പെട്ടുവരുന്ന എല്ലാവരെയും പറിച്ചു കീറിക്കളയും; അവരുടെ അതിക്രമങ്ങൾ വളരെയല്ലയോ?","poem":2},{"lineBreak":true},{"text":"അവരുടെ പിൻമാറ്റങ്ങളും പെരുകിയിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ഞാൻ നിന്നോട് ക്ഷമിക്കുന്നത് എങ്ങനെ?","poem":1},{"text":"നിന്‍റെ മക്കൾ എന്നെ ഉപേക്ഷിച്ച്, ദൈവമല്ലാത്തവയെ ചൊല്ലി സത്യം ചെയ്തുവരുന്നു;","poem":2},{"text":"ഞാൻ അവരെ പോഷിപ്പിച്ച സമയത്തുതന്നെ","poem":1},{"text":"അവർ വ്യഭിചാരം ചെയ്യുകയും വേശ്യാഗൃഹങ്ങളിൽ കൂട്ടമായി ചെല്ലുകയും ചെയ്തു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"തിന്നുകൊഴുത്ത കുതിരകളെപ്പോലെ അവർ മദിച്ചുനടന്ന്,","poem":1},{"text":"ഓരോരുത്തൻ തന്‍റെ കൂട്ടുകാരന്‍റെ ഭാര്യയെ നോക്കി ചിനയ്ക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഇവ നിമിത്തം ഞാൻ സന്ദർശിക്കാതെ ഇരിക്കുമോ?","poem":1},{"text":"ഇങ്ങനെയുള്ള ജനങ്ങളോട് ഞാൻ പകരം ചെയ്യാതിരിക്കുമോ”","poem":2},{"lineBreak":true},{"text":"എന്നു യഹോവയുടെ അരുളപ്പാടു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“അതിന്‍റെ മുന്തിരി തോട്ടങ്ങളിന്മേല്‍","poem":1},{"noteId":4},{"text":"കയറി നശിപ്പിക്കുവിൻ;","poem":1},{"text":"എങ്കിലും മുടിച്ചുകളയരുത്;","poem":2},"അതിന്‍റെ കൊമ്പുകളെ നീക്കിക്കളയുവിൻ;",{"text":"അവ യഹോവയ്ക്കുള്ളവയല്ലല്ലോ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"യിസ്രായേൽ ഗൃഹവും യെഹൂദാഗൃഹവും","poem":1},{"text":"എന്നോട് മഹാദ്രോഹം ചെയ്തിരിക്കുന്നു”","poem":2},{"lineBreak":true},{"text":"എന്നു യഹോവയുടെ അരുളപ്പാടു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവർ യഹോവയെ നിഷേധിച്ചു പറഞ്ഞത്:","poem":1},{"lineBreak":true},{"text":"“അത് അവനല്ല; നമുക്കു ദോഷം വരുകയില്ല;","poem":1},{"text":"നാം വാളോ ക്ഷാമമോ കാണുകയുമില്ല.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"പ്രവാചകന്മാർ കാറ്റായിത്തീരും; അവർക്ക് അരുളപ്പാടില്ല;","poem":1},{"text":"അവർക്ക് അങ്ങനെ തന്നെ സംഭവിക്കട്ടെ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"അതുകൊണ്ട് സൈന്യങ്ങളുടെ ദൈവമായ യഹോവ ഇപ്രകാരം അരുളിച്ചെയ്യുന്നു:","poem":1},{"text":"“നിങ്ങൾ ഈ വാക്കു പറഞ്ഞതുകൊണ്ട്,","poem":2},{"text":"ഇതാ, ഞാൻ നിന്‍റെ വായിൽ എന്‍റെ വചനങ്ങളെ തീയും,","poem":1},{"text":"ഈ ജനത്തെ വിറകും ആക്കും; അവർ അതിന് ഇരയായിത്തീരും.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“യിസ്രായേൽ ഗൃഹമേ, ഞാൻ ദൂരത്തുനിന്ന് ഒരു ജനതയെ നിങ്ങളുടെനേരെ വരുത്തും”","poem":1},{"text":"എന്നു യഹോവയുടെ അരുളപ്പാടു:","poem":2},{"text":"അത് സ്ഥിരതയുള്ള ജനത; പുരാതനമായ ജനത;","poem":1},{"text":"അവരുടെ ഭാഷ നിനക്കു അറിഞ്ഞുകൂടാ; വാക്കു നീ ഗ്രഹിക്കുകയുമില്ല","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അവരുടെ ആവനാഴി തുറന്ന ശവക്കുഴി;","poem":1},{"text":"അവർ എല്ലാവരും വീരന്മാരത്രേ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"നിന്‍റെ പുത്രന്മാരും പുത്രിമാരും ഭക്ഷിക്കേണ്ട നിന്‍റെ വിളവും ആഹാരവും അവർ ഭക്ഷിച്ചുതീർക്കും;","poem":1},{"text":"അവർ നിന്‍റെ ആടുകളെയും കന്നുകാലികളെയും തിന്നുകളയും;","poem":2},{"text":"അവർ നിന്‍റെ മുന്തിരിവള്ളികളും അത്തിവൃക്ഷങ്ങളും തിന്നും;","poem":1},{"text":"നീ ആശ്രയിക്കുന്ന നിന്‍റെ ഉറപ്പുള്ള പട്ടണങ്ങളെ","poem":2},{"lineBreak":true},{"text":"അവർ വാൾകൊണ്ടു ശൂന്യമാക്കിക്കളയും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":["എന്നാൽ ആ നാളിലും ഞാൻ നിങ്ങളെ മുടിച്ചുകളയുകയില്ല” എന്നു യഹോവയുടെ അരുളപ്പാടു."]},{"type":"verse","number":19,"content":["“നമ്മുടെ ദൈവമായ യഹോവ ഇപ്രകാരമെല്ലാം നമ്മളോടു ചെയ്യുവാൻ സംഗതി എന്ത്” എന്നു ചോദിക്കുമ്പോൾ നീ അവരോട്: “നിങ്ങളുടെ ജനങ്ങള്‍",{"noteId":5},"എന്നെ ഉപേക്ഷിച്ച് നിങ്ങളുടെ ദേശത്ത് അന്യദേവന്മാരെ സേവിച്ചതുപോലെ നിങ്ങൾക്ക് സ്വന്തമല്ലാത്ത ദേശത്ത് നിങ്ങൾ അന്യജാതിക്കാരെ സേവിക്കേണ്ടിവരും” എന്നു ഉത്തരം പറയേണം."]},{"type":"heading","content":["മുന്നറിയിപ്പ്"]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"നിങ്ങൾ യാക്കോബ് ഗൃഹത്തിൽ പ്രസ്താവിച്ച്","poem":1},{"text":"യെഹൂദായിൽ പ്രസിദ്ധമാക്കേണ്ടത്:","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“കണ്ണുണ്ടായിട്ടും കാണാതെയും","poem":1},{"text":"ചെവി ഉണ്ടായിട്ടും കേൾക്കാതെയും ഇരിക്കുന്ന","poem":2},{"lineBreak":true},{"text":"മൂഢന്മാരും ബുദ്ധിഹീനന്മാരുമായ ജനമേ, ഇതുകേൾക്കുവിൻ!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"നിങ്ങൾ എന്നെ ഭയപ്പെടുകയില്ലയോ?","poem":1},{"text":"എന്‍റെ സന്നിധിയിൽ വിറയ്ക്കുകയില്ലയോ”","poem":2},{"text":"എന്നു യഹോവയുടെ അരുളപ്പാടു;","poem":1},{"text":"ഞാൻ കടലിന് കവിഞ്ഞുകൂടാത്തവണ്ണം നിത്യപ്രമാണമായി","poem":2},{"lineBreak":true},{"text":"മണൽ അതിരാക്കി വച്ചിരിക്കുന്നു;","poem":2},{"text":"തിരകൾ അലച്ചാലും ഒന്നും സംഭവിക്കുകയില്ല;","poem":1},{"text":"എത്രതന്നെ ഇരച്ചാലും അതിനെ മറികടക്കുകയില്ല.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ഈ ജനത്തിന് ശാഠ്യവും മത്സരവും ഉള്ള ഒരു ഹൃദയം ഉണ്ട്;","poem":1},{"text":"അവർ ശാഠ്യത്തോടെ പോയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"“മുന്മഴയും പിന്മഴയും നമുക്ക് അതത് സമയത്തു തരുകയും","poem":1},{"text":"കൊയ്ത്തിനുള്ള കാലം നിയമിച്ചുതരുകയും ചെയ്യുന്ന","poem":2},{"text":"നമ്മുടെ ദൈവമായ യഹോവയെ നാം ഭയപ്പെടുക”","poem":1},{"text":"എന്നു അവർ ഹൃദയത്തിൽ പറയുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"“ഇവ മാറിപ്പോകുവാൻ നിങ്ങളുടെ അകൃത്യങ്ങൾ തന്നെ ആകുന്നു കാരണം;","poem":1},{"text":"നിങ്ങളുടെ പാപങ്ങളാൽ ഈ നന്മയ്ക്കു മുടക്കം വന്നിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"എന്‍റെ ജനത്തിന്‍റെ ഇടയിൽ ദുഷ്ടന്മാരെ കാണുന്നു;","poem":1},{"text":"അവർ വേടന്മാരെപ്പോലെ പതിയിരിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"അവർ കുടുക്കുവച്ച് മനുഷ്യരെ പിടിക്കുന്നു.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"കൂട്ടിൽ പക്ഷികൾ നിറഞ്ഞിരിക്കുന്നതുപോലെ","poem":1},{"text":"അവരുടെ വീട്ടിൽ വഞ്ചന നിറഞ്ഞിരിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"അങ്ങനെ അവർ മഹാന്മാരും ധനവാന്മാരും ആയിത്തീർന്നിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"അവർ പുഷ്ടിവച്ചു മിനുത്തിരിക്കുന്നു;","poem":1},{"text":"ദുഷ്കാര്യങ്ങളിൽ അവർ കവിഞ്ഞിരിക്കുന്നു;","poem":2},{"text":"അവർ അനാഥന്മാർക്കു ഗുണം വരത്തക്കവണ്ണം അവരുടെ വ്യവഹാരം നടത്തുന്നില്ല;","poem":1},{"text":"ദരിദ്രന്മാർക്ക് ന്യായപാലനം ചെയ്യുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ഇവ നിമിത്തം ഞാൻ സന്ദർശിക്കാതെ ഇരിക്കുമോ?","poem":1},{"text":"ഇങ്ങനെയുള്ള ജനതയോടു ഞാൻ പകരം ചെയ്യാതെ ഇരിക്കുമോ”","poem":2},{"lineBreak":true},{"text":"എന്നു യഹോവയുടെ അരുളപ്പാടു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“വിസ്മയകരവും ഭയങ്കരവുമായുള്ളത്","poem":1},{"text":"ദേശത്തു സംഭവിക്കുന്നു.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"പ്രവാചകന്മാർ വ്യാജമായി പ്രവചിക്കുന്നു","poem":1},{"text":"പുരോഹിതന്മാർ സ്വേച്ഛാധികാരം നടത്തുന്നു;","poem":2},{"text":"എന്‍റെ ജനത്തിനോ അത് ഇഷ്ടം ആകുന്നു;","poem":1},{"text":"എന്നാൽ അവസാനം നിങ്ങൾ എന്ത് ചെയ്യും?”","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"തോട്ടങ്ങളിന്മേല്‍മതിലുകളിന്മേൽ","reference":{"chapter":5,"verse":10}},{"noteId":5,"caller":"+","text":"നിങ്ങളുടെ ജനങ്ങള്‍ നിങ്ങള്‍","reference":{"chapter":5,"verse":19}}]},"thisChapterLink":"/api/mal_irv/JER/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/JER/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/JER/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}