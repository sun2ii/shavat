{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"JOB","translationId":"mal_irv","name":"ഇയ്യോബ്","commonName":"ഇയ്യോബ്","title":"ഇയ്യോബ്","order":18,"numberOfChapters":42,"sha256":"15b53f0ce1c67772670fbd69c62d6e18ff954ef5b89e49c08441b93404aafd5b","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mal_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":12,"content":[{"type":"heading","content":["ഇയ്യോബ് ഉത്തരം പറയുന്നു"]},{"type":"verse","number":1,"content":["അതിന് ഇയ്യോബ് ഉത്തരം പറഞ്ഞത്:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“ഓഹോ, നിങ്ങൾ ആകുന്നു ജ്ഞാനികൾ!","poem":1},{"text":"നിങ്ങൾ മരിച്ചാൽ ജ്ഞാനം മരിക്കും.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"നിങ്ങളെപ്പോലെ എനിക്കും ബുദ്ധി ഉണ്ട്;","poem":1},{"text":"നിങ്ങളേക്കാൾ ഞാൻ ഒട്ടും കുറഞ്ഞവനല്ല;","poem":2},{"lineBreak":true},{"text":"ആർക്കാകുന്നു ഇതൊക്കെ അറിഞ്ഞുകൂടാത്തത്?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ദൈവത്തെ വിളിച്ച് ഉത്തരം ലഭിച്ച ഞാൻ","poem":1},{"text":"എന്‍റെ സഖിക്കു പരിഹാസവിഷയമായിത്തീർന്നു;","poem":2},{"text":"നീതിമാനും നിഷ്കളങ്കനുമായവൻ തന്നെ പരിഹാസവിഷയമായിത്തീർന്നു.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"വിപത്ത് നിന്ദ്യം എന്നു സുഖിമാന്‍റെ വിചാരം;","poem":1},{"text":"കാൽ ഇടറുന്നവർക്കായി അത് ഒരുങ്ങിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"പിടിച്ചുപറിക്കാരുടെ കൂടാരങ്ങൾ സമാധാനമായിരിക്കുന്നു;","poem":1},{"text":"ദൈവത്തെ കോപിപ്പിക്കുന്നവർ നിർഭയമായ്‌ വസിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"അവരുടെ കയ്യിൽ ദൈവം എത്തിച്ചുകൊടുക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“മൃഗങ്ങളോട് ചോദിക്കുക; അവ നിന്നെ ഉപദേശിക്കും;","poem":1},{"text":"ആകാശത്തിലെ പക്ഷികളോട് ചോദിക്കുക; അവ പറഞ്ഞുതരും;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അല്ല, ഭൂമിയോട് സംഭാഷിക്കുക; അത് നിന്നെ ഉപദേശിക്കും;","poem":1},{"text":"സമുദ്രത്തിലെ മത്സ്യം നിന്നോട് വിവരിക്കും.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"യഹോവയുടെ കൈ ഇത് പ്രർത്തിച്ചിരിക്കുന്നു","poem":1},{"text":"എന്നു ഇവയെല്ലാംകൊണ്ടും ഗ്രഹിക്കാത്തവനാര്?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"സകലജീവജന്തുക്കളുടെയും പ്രാണനും","poem":1},{"text":"സകലമനുഷ്യവർഗ്ഗത്തിന്‍റെയും ശ്വാസവും ദൈവത്തിന്‍റെ കയ്യിൽ ഇരിക്കുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ചെവി വാക്കുകളെ പരിശോധിക്കുന്നില്ലയോ?","poem":1},{"text":"അണ്ണാക്കു ഭക്ഷണം രുചിനോക്കുന്നില്ലയോ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"വൃദ്ധന്മാരുടെ പക്കൽ ജ്ഞാനവും","poem":1},{"text":"വയോധികന്മാരിൽ വിവേകവും ഉണ്ട്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ജ്ഞാനവും ശക്തിയും യഹോവയുടെ പക്കൽ,","poem":1},{"text":"ആലോചനയും വിവേകവും അവിടുത്തേക്കുള്ളത്.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"യഹോവ ഇടിച്ചുകളഞ്ഞാൽ ആർക്കും പണിതുകൂടാ;","poem":1},{"text":"അവിടുന്ന് മനുഷ്യനെ ബന്ധിച്ചാൽ ആരും അഴിച്ചുവിടുകയില്ല.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവിടുന്ന് വെള്ളം തടഞ്ഞുവച്ചാൽ അത് വറ്റിപ്പോകുന്നു;","poem":1},{"text":"അവിടുന്ന് വിട്ടയച്ചാൽ അത് ഭൂമിയെ മറിച്ചുകളയുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ദൈവത്തിന്‍റെ പക്കൽ ശക്തിയും മഹാജ്ഞാനവും ഉണ്ട്;","poem":1},{"text":"വഞ്ചിതനും വഞ്ചകനും അവിടുത്തേക്കുള്ളവർ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"യഹോവ മന്ത്രിമാരെ കവർച്ചയായി കൊണ്ടു പോകുന്നു;","poem":1},{"text":"ന്യായാധിപന്മാരെ ഭോഷന്മാരാക്കുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"രാജാക്കന്മാരുടെ അധികാരത്തെ അഴിക്കുന്നു;","poem":1},{"text":"അവരുടെ അരയ്ക്ക് ബന്ധനം മുറുക്കുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"യഹോവ പുരോഹിതന്മാരെ കവർച്ചയായി കൊണ്ടുപോകുന്നു;","poem":1},{"text":"ബലശാലികളെ തള്ളിയിട്ടുകളയുന്നു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"യഹോവ വിശ്വസ്തന്മാർക്ക് വാക്ക് മുട്ടിക്കുന്നു.","poem":1},{"text":"വൃദ്ധന്മാരുടെ ബുദ്ധി എടുത്തുകളയുന്നു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"യഹോവ പ്രഭുക്കന്മാരുടെമേൽ നിന്ദ പകരുന്നു;","poem":1},{"text":"ബലവാന്മാരുടെ അരക്കച്ച അഴിച്ചുകളയുന്നു.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"യഹോവ അഗാധകാര്യങ്ങൾ അന്ധകാരത്തിൽ നിന്ന് വെളിച്ചത്ത് കൊണ്ടുവരുന്നു;","poem":1},{"text":"അന്ധതമസ്സിനെ പ്രകാശത്തിൽ വരുത്തുന്നു.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"യഹോവ ജനതകളെ വർദ്ധിപ്പിക്കുകയും നശിപ്പിക്കുകയും ചെയ്യുന്നു;","poem":1},{"text":"അവിടുന്ന് ജനതകളെ ചിതറിക്കുകയും കൂട്ടുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"യഹോവ ഭൂവാസികളിലെ തലവന്മാരിൽ നിന്ന് ധൈര്യം എടുത്തുകളയുന്നു;","poem":1},{"text":"വഴിയില്ലാത്ത ശൂന്യപ്രദേശത്ത് അവരെ ഉഴന്നു നടക്കുമാറാക്കുന്നു;","poem":2}]},{"type":"verse","number":25,"content":[{"text":"അവർ വെളിച്ചമില്ലാതെ ഇരുട്ടിൽ തപ്പിനടക്കുന്നു;","poem":1},{"text":"യഹോവ മദ്യപന്മാരെപ്പോലെ അവരെ ചാഞ്ചാടുമാറാക്കുന്നു.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}