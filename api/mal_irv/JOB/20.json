{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"JOB","translationId":"mal_irv","name":"ഇയ്യോബ്","commonName":"ഇയ്യോബ്","title":"ഇയ്യോബ്","order":18,"numberOfChapters":42,"sha256":"15b53f0ce1c67772670fbd69c62d6e18ff954ef5b89e49c08441b93404aafd5b","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mal_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":20,"content":[{"type":"heading","content":["നയമാത്യനായ സോഫർ"]},{"type":"verse","number":1,"content":["അതിന് നയമാത്യനായ സോഫർ ഉത്തരം പറഞ്ഞത്:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“ഉത്തരം പറയുവാൻ എന്‍റെ നിരൂപണങ്ങൾ പൊങ്ങിവരുന്നു.","poem":1},{"text":"എന്‍റെ ഉള്ളിലെ അക്ഷമ കാരണം തന്നെ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"എനിക്കു ലജ്ജാകരമായ ശാസന ഞാൻ കേട്ടു;","poem":1},{"text":"എന്നാൽ ആത്മാവ് എന്‍റെ വിവേകത്തിൽ നിന്ന് ഉത്തരം പറയുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"മനുഷ്യൻ ഭൂമിയിൽ ഉണ്ടായതുമുതൽ","poem":1},{"text":"പുരാതനമായ ഈ വസ്തുത നീ അറിയുന്നില്ലയോ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ദുഷ്ടന്മാരുടെ ജയഘോഷം താല്ക്കാലികമത്രെ;","poem":1},{"text":"അഭക്തന്‍റെ സന്തോഷം അല്പനേരത്തേക്കേയുള്ളു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവന്‍റെ ഉയർച്ച ആകാശത്തോളം എത്തിയാലും","poem":1},{"text":"അവന്‍റെ ശിരസ്സ് മേഘങ്ങളോളം ഉയർന്നാലും","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവൻ സ്വന്തവിസർജ്ജ്യംപോലെ എന്നേക്കും നശിക്കും;","poem":1},{"text":"അവനെ കണ്ടിട്ടുള്ളവർ അവൻ എവിടെ എന്നു ചോദിക്കും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവൻ സ്വപ്നംപോലെ പറന്നുപോകും.","poem":1},{"text":"അവനെ പിന്നെ കാണുകയില്ല;","poem":2},{"lineBreak":true},{"text":"അവൻ രാത്രിദർശനംപോലെ മറഞ്ഞുപോകും.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവനെ കണ്ടിട്ടുള്ള കണ്ണ് ഇനി അവനെ കാണുകയില്ല;","poem":1},{"text":"അവന്‍റെ സ്ഥലം ഇനി അവനെ ദർശിക്കുകയുമില്ല.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവന്‍റെ മക്കൾ ദരിദ്രന്മാരോട് കൃപ യാചിക്കും;","poem":1},{"text":"അവന്‍റെ കൈ","poem":2},{"noteId":13},{"text":"അവന്‍റെ സമ്പത്ത് മടക്കിക്കൊടുക്കും.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അവന്‍റെ അസ്ഥികളിൽ യൗവ്വനം നിറഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"അത് അവനോടുകൂടെ പൊടിയിൽ കിടക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"”ദുഷ്ടത അവന്‍റെ വായിൽ മധുരിച്ചാലും","poem":1},{"text":"അവൻ അത് നാവിനടിയിൽ മറച്ചുവച്ചാലും","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അതിനെ വിടാതെ പിടിച്ച്","poem":1},{"text":"വായ്ക്കകത്ത് സൂക്ഷിച്ചുവച്ചാലും","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവന്‍റെ ആഹാരം അവന്‍റെ കുടലിൽ മാറ്റപ്പെട്ട്","poem":1},{"text":"അവന്‍റെ ഉള്ളിൽ സർപ്പവിഷമായിത്തീരും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവൻ സമ്പത്ത് വിഴുങ്ങിയാലും അത് വീണ്ടും ഛർദ്ദിക്കേണ്ടിവരും;","poem":1},{"text":"ദൈവം അത് അവന്‍റെ വയറ്റിൽനിന്ന് പുറത്താക്കിക്കളയും.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അവൻ സർപ്പവിഷം നുകരും","poem":1},{"text":"അണലിയുടെ നാവ് അവനെ കൊല്ലും.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"തേനും പാൽപാടയും ഒഴുകുന്ന തോടുകളെയും","poem":1},{"text":"നദികളെയും അവൻ കണ്ടു രസിക്കുകയില്ല.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"തന്‍റെ സമ്പാദ്യം അവൻ അനുഭവിക്കാതെ മടക്കിക്കൊടുക്കും;","poem":1},{"text":"താൻ നേടിയ വസ്തുവകയ്ക്ക് ഒത്തവണ്ണം സന്തോഷിക്കുകയുമില്ല.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അവൻ ദരിദ്രന്മാരെ പീഡിപ്പിച്ചു ഉപേക്ഷിച്ചു;","poem":1},{"text":"താൻ പണിയാത്ത വീട് അപഹരിച്ചു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"”അവന്‍റെ കൊതിക്കു മതിവരാത്തതുകൊണ്ട്","poem":1},{"text":"അവൻ തന്‍റെ മനോഹരധനത്തോടുകൂടി രക്ഷപെടുകയില്ല.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവൻ ഭക്ഷിക്കാനുള്ളതല്ലാതെ ഒന്നും ശേഷിപ്പിക്കുകയില്ല;","poem":1},{"text":"അതുകൊണ്ട് അവന്‍റെ അഭിവൃദ്ധി നിലനില്‍ക്കുകയില്ല.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"അവന്‍റെ സമൃദ്ധിയുടെ പൂർണ്ണതയിൽ അവനു ഞെരുക്കം ഉണ്ടാകും;","poem":1},{"text":"ദരിദ്രന്മാരുടെ കൈ ഒക്കെയും അവന്‍റെമേൽ വരും.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"അവൻ വയറ് നിറയ്ക്കുമ്പോൾത്തന്നെ","poem":1},{"text":"ദൈവം തന്‍റെ ഉഗ്രകോപം അവന്‍റെമേൽ അയയ്ക്കും;","poem":2},{"lineBreak":true},{"text":"അവൻ ഭക്ഷിക്കുമ്പോൾ അത് അവന്‍റെമേൽ വർഷിപ്പിക്കും.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അവൻ ഇരുമ്പായുധം ഒഴിഞ്ഞോടും;","poem":1},{"text":"താമ്ര വില്ല് അവനിൽ തറഞ്ഞുകയറും.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"അവൻ അത് അവന്‍റെ ദേഹത്തിൽനിന്ന് പുറത്തേക്ക് വലിച്ചൂരുന്നു;","poem":1},{"text":"മിന്നുന്ന മുന അവന്‍റെ പിത്തഗ്രന്ഥിയിൽനിന്നു പുറപ്പെടുന്നു;","poem":2},{"lineBreak":true},{"text":"കൊടും ഭീതി അവന്‍റെമേൽ ഇരിക്കുന്നു.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"അന്ധകാരമെല്ലാം അവന്‍റെ നിക്ഷേപമായി സംഗ്രഹിച്ചിരിക്കുന്നു;","poem":1},{"text":"ആരും ഊതിക്കത്തിക്കാത്ത തീക്ക് അവൻ ഇരയാകും;","poem":2},{"lineBreak":true},{"text":"അവന്‍റെ കൂടാരത്തിൽ ശേഷിച്ചിരിക്കുന്നതിനെ അതു ദഹിപ്പിക്കും;","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ആകാശം അവന്‍റെ അകൃത്യത്തെ വെളിപ്പെടുത്തും","poem":1},{"text":"ഭൂമി അവന് എതിരായി സാക്ഷ്യം പറയും.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"അവന്‍റെ വീട്ടിലെ ധനം ഇല്ലാതെയാകും;","poem":1},{"text":"ദൈവത്തിന്‍റെ കോപദിവസത്തിൽ അവ ഒഴുകിപ്പോകും","poem":2},{"noteId":14},{"text":".","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ഇത് ദുഷ്ടന് ദൈവം കൊടുക്കുന്ന ഓഹരിയും","poem":1},{"text":"ദൈവം അവനു നിയമിച്ച അവകാശവും ആകുന്നു.”","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"അവന്‍റെ കൈ അവന്‍റെ മക്കളുടെ കൈ","reference":{"chapter":20,"verse":10}},{"noteId":14,"caller":"+","text":"ദൈവത്തിന്‍റെ കോപദിവസത്തിൽ അവ ഒഴുകിപ്പോകും ദൈവത്തിന്‍റെ കോപദിവസത്തിൽ വീട് ഒഴുകിപ്പോകും","reference":{"chapter":20,"verse":28}}]},"thisChapterLink":"/api/mal_irv/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}