{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"JOB","translationId":"mal_irv","name":"ഇയ്യോബ്","commonName":"ഇയ്യോബ്","title":"ഇയ്യോബ്","order":18,"numberOfChapters":42,"sha256":"15b53f0ce1c67772670fbd69c62d6e18ff954ef5b89e49c08441b93404aafd5b","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mal_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":21,"content":[{"type":"heading","content":["ഇയ്യോബ് ഉത്തരം പറയുന്നു"]},{"type":"verse","number":1,"content":["അതിന് ഇയ്യോബ് ഉത്തരം പറഞ്ഞത്:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“എന്‍റെ വാക്ക് ശ്രദ്ധയോടെ കേൾക്കുവിൻ;","poem":1},{"text":"അത് നിങ്ങൾക്ക് ആശ്വാസമായിരിക്കട്ടെ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"നില്ക്കുവിന്‍, ഞാനും സംസാരിക്കട്ടെ;","poem":1},{"text":"ഞാൻ സംസാരിച്ചു കഴിഞ്ഞ് നിനക്കു പരിഹസിക്കാം.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ഞാൻ സങ്കടം പറയുന്നത് മനുഷ്യനോടോ?","poem":1},{"text":"ഞാൻ അക്ഷമനാകാതിരിക്കുന്നതെങ്ങനെ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"എന്നെ നോക്കി ഭയപ്പെടുവിൻ;","poem":1},{"text":"കൈകൊണ്ട് വായ് പൊത്തിക്കൊള്ളുവിൻ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഓർക്കുമ്പോൾ ഞാൻ ഞെട്ടിപ്പോകുന്നു;","poem":1},{"text":"എന്‍റെ ദേഹത്തിന് വിറയൽ പിടിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ദുഷ്ടന്മാർ ജീവിച്ചിരുന്ന് വാർദ്ധക്യം പ്രാപിക്കുകയും","poem":1},{"text":"അവർക്ക് ബലം വർദ്ധിക്കുകയും ചെയ്യുന്നത് എന്ത്?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവരുടെ സന്താനം അവരോടുകൂടി അവരുടെ മുമ്പിലും","poem":1},{"text":"അവരുടെ വംശം അവർ കാൺകെയും ഉറച്ച് നില്ക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവരുടെ വീടുകൾ ഭയംകൂടാതെ സുഖമായിരിക്കുന്നു;","poem":1},{"text":"ദൈവത്തിന്‍റെ വടി അവരുടെ മേൽ വരുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവരുടെ കാള ഇണചേരുന്നു, നിഷ്ഫലമാകുന്നില്ല;","poem":1},{"text":"അവരുടെ പശു പ്രസവിക്കുന്നു, കിടാവ് വളർച്ചയെത്താതെ നഷ്ടമാകുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അവർ കുഞ്ഞുങ്ങളെ ആട്ടിൻകൂട്ടത്തെപ്പോലെ പുറത്തയയ്ക്കുന്നു;","poem":1},{"text":"അവരുടെ കുഞ്ഞുങ്ങൾ നൃത്തം ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവർ തപ്പോടും കിന്നരത്തോടുംകൂടി പാടുന്നു;","poem":1},{"text":"കുഴലിന്‍റെ നാദത്തിൽ സന്തോഷിക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അവർ സുഖമായി ദിവസങ്ങൾ ചിലവഴിക്കുന്നു;","poem":1},{"text":"ശാന്തമായി","poem":2},{"noteId":15},{"text":"പാതാളത്തിലേക്ക് ഇറങ്ങുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവർ ദൈവത്തോട്: ‘ഞങ്ങളെ വിട്ടുപോകുക;","poem":1},{"text":"അവിടുത്തെ വഴികളെ അറിയുവാൻ ഞങ്ങൾ ആഗ്രഹിക്കുന്നില്ല;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഞങ്ങൾ സർവ്വശക്തനെ സേവിക്കുവാൻ അവിടുന്ന് ആര്‍?","poem":1},{"text":"ദൈവത്തോട് പ്രാർത്ഥിച്ചാൽ എന്ത് പ്രയോജനം?’ എന്നു പറയുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"എന്നാൽ അവരുടെ ഭാഗ്യം അവർക്ക് കൈവശമല്ലേ?","poem":1},{"text":"ദുഷ്ടന്മാരുടെ ആലോചന എന്നോട് അകന്നിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“ദുഷ്ടന്മാരുടെ വിളക്ക് കെട്ടുപോകുന്നതും","poem":1},{"text":"അവർക്ക് ആപത്ത് വരുന്നതും","poem":2},{"lineBreak":true},{"text":"ദൈവം കോപത്തിൽ കഷ്ടങ്ങൾ വിഭാഗിച്ച് കൊടുക്കുന്നതും എത്ര പ്രാവശ്യം!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അവർ കാറ്റിന് മുമ്പിൽ വൈക്കോൽപോലെയും","poem":1},{"text":"കൊടുങ്കാറ്റ് പറപ്പിക്കുന്ന പതിർപോലെയും ആകുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ദൈവം അവന്‍റെ അകൃത്യം അവന്‍റെ മക്കൾക്കായി സംഗ്രഹിച്ചു വയ്ക്കുന്നു;","poem":1},{"text":"അവൻ അത് അനുഭവിക്കേണ്ടതിന് അവന് തന്നെ പകരം കൊടുക്കട്ടെ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അവന്‍റെ കണ്ണ് സ്വന്ത നാശം കാണട്ടെ;","poem":1},{"text":"അവൻ തന്നെ സർവ്വശക്തന്‍റെ ക്രോധം കുടിക്കട്ടെ;","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവന്‍റെ മാസങ്ങളുടെ എണ്ണം ഇല്ലാതെ ആയാൽ","poem":1},{"text":"തന്‍റെശേഷം തന്‍റെ ഭവനത്തോട് അവനെന്ത് താത്പര്യം?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ആരെങ്കിലും ദൈവത്തിന് ബുദ്ധി ഉപദേശിക്കുമോ?","poem":1},{"text":"അവൻ ഉന്നതന്മാരെ ന്യായം വിധിക്കുന്നുവല്ലോ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ഒരുവൻ കേവലം സ്വൈരവും സ്വസ്ഥതയുമുള്ളവനായി","poem":1},{"text":"തന്‍റെ പൂർണ്ണക്ഷേമത്തിൽ മരിക്കുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അവന്‍റെ തൊട്ടികൾ പാലുകൊണ്ട് നിറഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"അവന്‍റെ അസ്ഥികളിലെ മജ്ജ അയഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"മറ്റൊരാൾ മനോവേദനയോടെ മരിക്കുന്നു;","poem":1},{"text":"നന്മയൊന്നും അനുഭവിക്കുവാൻ ഇടവരുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"അവർ ഒരുപോലെ പൊടിയിൽ കിടക്കുന്നു;","poem":1},{"text":"കൃമി അവരെ മൂടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“ഞാൻ നിങ്ങളുടെ വിചാരങ്ങളെയും","poem":1},{"text":"നിങ്ങൾ എന്‍റെ നേരെ നിരൂപിക്കുന്ന ഉപായങ്ങളെയും അറിയുന്നു.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"“രാജകുമാരന്‍റെ ഭവനം എവിടെ?","poem":1},{"text":"ദുഷ്ടന്മാർ വസിച്ചിരുന്ന കൂടാരം എവിടെ” എന്നല്ലയോ നിങ്ങൾ പറയുന്നത്?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"വഴിപോക്കരോട് നിങ്ങൾ ചോദിച്ചിട്ടില്ലയോ?","poem":1},{"text":"അവരുടെ അടയാളങ്ങളെ അറിയുന്നില്ലയോ?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"അനർത്ഥദിവസത്തിൽ ദുഷ്ടൻ ഒഴിഞ്ഞുപോകുന്നു;","poem":1},{"text":"ക്രോധദിവസത്തിൽ അവർക്ക് വിടുതൽ കിട്ടുന്നു.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"അവന്‍റെ നടപ്പിനെക്കുറിച്ച് ആര്‍ അവന്‍റെ മുഖത്തു നോക്കി പറയും?","poem":1},{"text":"അവൻ ചെയ്തതിന് തക്കവണ്ണം ആര്‍ അവനു പകരംവീട്ടും?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"എന്നാലും അവനെ ശ്മശാനത്തിലേക്ക് കൊണ്ടുപോകുന്നു;","poem":1},{"text":"അവന്‍റെ കല്ലറയ്ക്കൽ കാവൽനില്ക്കുന്നു.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"താഴ്വരയിലെ മണ്‍കട്ട അവനു മധുരമായിരിക്കും;","poem":1},{"text":"അവന്‍റെ പിന്നാലെ സകലമനുഷ്യരും ചെല്ലും;","poem":2},{"lineBreak":true},{"text":"അവനു മുമ്പ് പോയവർ അനേകം പേരാണ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“നിങ്ങൾ വൃഥാ എന്നെ ആശ്വസിപ്പിക്കുന്നത് എങ്ങനെ?","poem":1},{"text":"നിങ്ങളുടെ ഉത്തരങ്ങളിൽ കപടമല്ലാതെ ഒന്നുമില്ല.”","poem":2}]}],"footnotes":[{"noteId":15,"caller":"+","text":"ശാന്തമായി ക്ഷണനേരത്തില്‍","reference":{"chapter":21,"verse":13}}]},"thisChapterLink":"/api/mal_irv/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}