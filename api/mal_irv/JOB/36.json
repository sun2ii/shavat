{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"JOB","translationId":"mal_irv","name":"ഇയ്യോബ്","commonName":"ഇയ്യോബ്","title":"ഇയ്യോബ്","order":18,"numberOfChapters":42,"sha256":"15b53f0ce1c67772670fbd69c62d6e18ff954ef5b89e49c08441b93404aafd5b","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mal_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":36,"content":[{"type":"verse","number":1,"content":["എലീഹൂ പിന്നെയും പറഞ്ഞത്:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“അല്പം ക്ഷമിക്കുക, ഞാൻ അറിയിച്ചുതരാം;","poem":1},{"text":"ദൈവത്തിന് വേണ്ടി ഇനിയും ചില വാക്കുകൾ പറയുവാനുണ്ട്.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ഞാൻ ദൂരത്തുനിന്ന് അറിവ് കൊണ്ടുവരും;","poem":1},{"text":"എന്‍റെ സ്രഷ്ടാവിന്‍റെ നീതിയെ അറിയിക്കും.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"എന്‍റെ വാക്ക് കള്ളമല്ല നിശ്ചയം;","poem":1},{"text":"അറിവ് തികഞ്ഞവൻ നിന്‍റെ അടുക്കൽ നില്ക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ദൈവം ബലവാനാണെങ്കിലും ആരെയും നിരസിക്കുന്നില്ല;","poem":1},{"text":"അവിടുന്ന് വിവേകശക്തിയിലും ബലവാൻ തന്നെ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവിടുന്ന് ദുഷ്ടന്‍റെ ജീവനെ രക്ഷിക്കുന്നില്ല;","poem":1},{"text":"ദുഃഖിതന്മാർക്ക് അവിടുന്ന് ന്യായം നടത്തിക്കൊടുക്കുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവിടുന്ന് നീതിമാന്മാരിൽനിന്ന് തന്‍റെ നോട്ടം മാറ്റുന്നില്ല;","poem":1},{"text":"രാജാക്കന്മാരോടുകൂടി അവരെ സിംഹാസനത്തിൽ ഇരുത്തുന്നു;","poem":2},{"lineBreak":true},{"text":"അവർ എന്നേക്കും ഉയർന്നിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവർ ചങ്ങലകളാൽ ബന്ധിക്കപ്പെട്ട്","poem":1},{"text":"കഷ്ടതയുടെ ചരടിൽ കുടുങ്ങുകയും ചെയ്താൽ","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവിടുന്ന് അവർക്ക് അവരുടെ പ്രവൃത്തിയും","poem":1},{"text":"അഹങ്കാരത്താൽ പ്രവർത്തിച്ച ലംഘനങ്ങളും കാണിച്ചുകൊടുക്കും.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവിടുന്ന് അവരുടെ ചെവി പ്രബോധനത്തിന് തുറക്കുന്നു;","poem":1},{"text":"അവർ നീതികേട് വിട്ടുതിരിയുവാൻ കല്പിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“അവർ കേട്ടനുസരിച്ച് അവിടുത്തെ സേവിച്ചാൽ","poem":1},{"text":"അവരുടെ നാളുകളെ ഭാഗ്യത്തിലും","poem":2},{"lineBreak":true},{"text":"ആണ്ടുകളെ ആനന്ദത്തിലും കഴിച്ചുകൂട്ടും.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"കേൾക്കുന്നില്ലെങ്കിലോ അവർ വാളാൽ നശിക്കും;","poem":1},{"text":"ബുദ്ധിമോശത്താൽ മരിച്ചുപോകും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ദൈവത്തെ ഹൃദയംകൊണ്ട് വിശ്വസിക്കാത്തവര്‍","poem":1},{"noteId":24},{"text":"കോപം സംഗ്രഹിച്ചു വയ്ക്കുന്നു;","poem":1},{"text":"അവിടുന്ന് അവരെ ബന്ധിക്കുമ്പോൾ അവർ രക്ഷക്കായി നിലവിളിക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവർ യൗവനത്തിൽ തന്നെ മരിച്ചു പോകുന്നു;","poem":1},{"text":"അവരുടെ ജീവൻ അപമാനത്താൽ നശിക്കുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവിടുന്ന് പീഡിതനെ അവന്‍റെ പീഡയാൽ വിടുവിക്കുന്നു;","poem":1},{"text":"അനർഥങ്ങൾകൊണ്ടുതന്നെ അവരുടെ ചെവി തുറക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“നിന്നെയും അവിടുന്ന് കഷ്ടതയുടെ വാളിൽനിന്ന്","poem":1},{"text":"ഞെരുക്കമില്ലാത്ത വിശാലതയിലേക്ക് നടത്തുമായിരുന്നു.","poem":2},{"lineBreak":true},{"text":"നിന്‍റെ മേശമേൽ സ്വാദുഭോജനം വയ്ക്കുമായിരുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"നീയോ ദുഷ്ടവിധികൊണ്ട് നിറഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"വിധിയും നീതിയും നിന്നെ പിടിക്കും.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"കോപം നിന്നെ പരിഹാസത്തിനായി വശീകരിക്കരുത്;","poem":1},{"text":"മോചനദ്രവ്യത്തിന്‍റെ വലിപ്പം ഓർത്തു നീ തെറ്റിപ്പോകുകയുമരുത്.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"കഷ്ടത്തിൽ അകപ്പെടാതിരിക്കുവാൻ നിന്‍റെ നിലവിളിയും","poem":1},{"text":"ശക്തിയേറിയ പരിശ്രമങ്ങളും മതിയാകുമോ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ജനതകൾ തങ്ങളുടെ സ്ഥലത്തുവച്ച്","poem":1},{"text":"മുടിഞ്ഞുപോകുന്ന രാത്രിയെ നീ ആഗ്രഹിക്കരുത്.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"സൂക്ഷിച്ചുകൊള്ളുക; നീതികേടിലേക്ക് തിരിയരുത്;","poem":1},{"text":"കഷ്ടതയാൽ പരീക്ഷിക്കപ്പെടുന്നതുകൊണ്ട് നീ പാപത്തിൽനിന്ന് ഒഴിഞ്ഞിരിക്കുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“ദൈവം തന്‍റെ ശക്തിയാൽ ഉന്നതമായി പ്രവർത്തിക്കുന്നു;","poem":1},{"text":"അവിടുത്തോട് തുല്യനായ ഉപദേശകൻ ആരുള്ളു?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ദൈവത്തോട് അവിടുത്തെ വഴിയെ കല്പിച്ചതാര്?","poem":1},{"text":"അവിടുന്ന് നീതികേട് ചെയ്തു എന്നു അവിടുത്തോട് ആർക്ക് പറയാം?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അവിടുത്തെ പ്രവൃത്തിയെ മഹിമപ്പെടുത്തുവാൻ നീ ഓർത്തുകൊള്ളുക;","poem":1},{"text":"അതിനെക്കുറിച്ചല്ലയോ മനുഷ്യർ പാടിയിരിക്കുന്നത്.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"മനുഷ്യരെല്ലാം അതുകണ്ട് രസിക്കുന്നു;","poem":1},{"text":"ദൂരത്തുനിന്ന് മർത്യൻ അതിനെ സൂക്ഷിച്ചുനോക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“നമുക്ക് അറിഞ്ഞുകൂടാത്തവിധം ദൈവം അത്യുന്നതൻ;","poem":1},{"text":"അവിടുത്തെ ആണ്ടുകളുടെ സംഖ്യ എണ്ണമറ്റത്.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"അവിടുന്ന് നീർത്തുള്ളികളെ ആകർഷിക്കുന്നു;","poem":1},{"text":"അവിടുത്തെ ആവിയാൽ അവ മഴയായി പെയ്യുന്നു.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"മേഘങ്ങൾ അവയെ ചൊരിയുന്നു;","poem":1},{"text":"മനുഷ്യരുടെമേൽ ധാരാളമായി പൊഴിക്കുന്നു.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ആർക്കെങ്കിലും മേഘങ്ങളുടെ വിരിവുകളെയും","poem":1},{"text":"അവിടുത്തെ കൂടാരത്തിന്‍റെ മുഴക്കത്തെയും ഗ്രഹിക്കാമോ?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ദൈവം തന്‍റെ ചുറ്റും പ്രകാശം വിതറുന്നു;","poem":1},{"text":"സമുദ്രത്തെ ഇരുട്ടുകൊണ്ട് മൂടുന്നു.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ഇങ്ങനെ അവിടുന്ന് ജനതകളെ പോറ്റുന്നു;","poem":1},{"text":"ആഹാരവും ധാരാളമായി കൊടുക്കുന്നു.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"അവിടുന്ന് മിന്നൽകൊണ്ട് തൃക്കൈ നിറയ്ക്കുന്നു;","poem":1},{"text":"പ്രതിയോഗിയുടെ നേരെ അതിനെ നിയോഗിക്കുന്നു.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"അതിന്‍റെ മുഴക്കം അവിടുത്തെയും","poem":1},{"text":"കന്നുകാലികൾ എഴുന്നെള്ളുന്നവനെക്കുറിച്ച് അറിവു തരുന്നു.","poem":2}]}],"footnotes":[{"noteId":24,"caller":"+","text":"ദൈവത്തെ ഹൃദയംകൊണ്ട് വിശ്വസിക്കാത്തവര്‍ ഹൃദയത്തില്‍ കപടഭക്തി ഉള്ളവര്‍","reference":{"chapter":36,"verse":13}}]},"thisChapterLink":"/api/mal_irv/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}