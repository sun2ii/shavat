{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"LAM","translationId":"mal_irv","name":"വിലാപങ്ങൾ","commonName":"വിലാപങ്ങൾ","title":"വിലാപങ്ങൾ","order":25,"numberOfChapters":5,"sha256":"2333dc084ec0642308f9233e662f94531f2c5d3dc059e1d81f437b6cde07e3b7","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/mal_irv/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"heading","content":["കരുണയ്ക്കുവേണ്ടിയുള്ള പ്രാർത്ഥന"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"യഹോവേ, ഞങ്ങൾക്ക് എന്ത് ഭവിക്കുന്നു എന്നു ഓർക്കേണമേ;","poem":1},{"text":"ഞങ്ങൾക്ക് നേരിട്ടിരിക്കുന്ന നിന്ദ നോക്കേണമേ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ഞങ്ങളുടെ സ്വത്ത് അന്യന്മാർക്കും","poem":1},{"text":"ഞങ്ങളുടെ വീടുകൾ അന്യജാതിക്കാർക്കും ആയിപ്പോയി.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ഞങ്ങൾ അനാഥന്മാരും അപ്പനില്ലാത്തവരും ആയിരിക്കുന്നു;","poem":1},{"text":"ഞങ്ങളുടെ അമ്മമാർ വിധവമാരായിത്തീർന്നിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ഞങ്ങളുടെ വെള്ളം ഞങ്ങൾ വിലകൊടുത്ത് വാങ്ങി കുടിക്കുന്നു;","poem":1},{"text":"ഞങ്ങളുടെ വിറക് ഞങ്ങൾ വിലകൊടുത്ത് വാങ്ങുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ഞങ്ങളെ പിന്തുടരുന്നവരുടെ കാലുകൾ ഞങ്ങളുടെ കഴുത്തിൽ എത്തിയിരിക്കുന്നു;","poem":1},{"text":"ഞങ്ങൾ തളർന്നിരിക്കുന്നു; ഞങ്ങൾക്ക് വിശ്രാമവുമില്ല.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അപ്പം തിന്ന് തൃപ്തരാകേണ്ടതിന്","poem":1},{"text":"ഞങ്ങൾ മിസ്രയീമ്യർക്കും അശ്ശൂര്യർക്കും കീഴടങ്ങിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ഞങ്ങളുടെ പൂര്‍വ്വ പിതാക്കന്മാർ പാപംചെയ്ത് ഇല്ലാതെയായിരിക്കുന്നു;","poem":1},{"text":"അവരുടെ അകൃത്യങ്ങൾ ഞങ്ങൾ ചുമക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ദാസന്മാർ ഞങ്ങളെ ഭരിക്കുന്നു;","poem":1},{"text":"അവരുടെ കയ്യിൽനിന്ന് ഞങ്ങളെ വിടുവിപ്പാൻ ആരുമില്ല.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"മരുഭൂമിയിലെ വാൾ നിമിത്തം പ്രാണഭയത്തോടെ","poem":1},{"text":"ഞങ്ങൾ ആഹാരം ചെന്നു കൊണ്ടുവരുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ക്ഷാമത്തിന്‍റെ കാഠിന്യം നിമിത്തം","poem":1},{"text":"ഞങ്ങളുടെ ത്വക്ക് അടുപ്പുപോലെ കറുത്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അവർ സീയോനിൽ സ്ത്രീകളെയും","poem":1},{"text":"യെഹൂദാപട്ടണങ്ങളിൽ കന്യകമാരെയും ബലാൽക്കാരം ചെയ്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവർ സ്വന്ത കൈകൊണ്ട് പ്രഭുക്കന്മാരെ തൂക്കിക്കളഞ്ഞു;","poem":1},{"text":"വൃദ്ധന്മാരുടെ മുഖം ആദരിച്ചതുമില്ല.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"യൗവനക്കാർ തിരികല്ല് ചുമക്കുന്നു;","poem":1},{"text":"ബാലന്മാർ വിറകുചുമന്ന് ഇടറി വീഴുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"വൃദ്ധന്മാരെ പട്ടണവാതില്‍ക്കലും","poem":1},{"text":"യൗവനക്കാരെ സംഗീതത്തിനും കാണുന്നില്ല.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഞങ്ങളുടെ ഹൃദയസന്തോഷം ഇല്ലാതെയായി;","poem":1},{"text":"ഞങ്ങളുടെ നൃത്തം വിലാപമായ്തീർന്നിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ഞങ്ങളുടെ തലയിലെ കിരീടം വീണുപോയി;","poem":1},{"text":"ഞങ്ങൾ പാപം ചെയ്കകൊണ്ട് ഞങ്ങൾക്ക് അയ്യോ കഷ്ടം!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ഇതുകൊണ്ട് ഞങ്ങളുടെ ഹൃദയത്തിന് രോഗം പിടിച്ചിരിക്കുന്നു;","poem":1},{"text":"ഇതു നിമിത്തം ഞങ്ങളുടെ കണ്ണ് മങ്ങിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"സീയോൻപർവ്വതം ശൂന്യമായി;","poem":1},{"text":"കുറുക്കന്മാർ അവിടെ സഞ്ചരിക്കുന്നതുകൊണ്ട് തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"യഹോവേ, അങ്ങ് ശാശ്വതനായും","poem":1},{"text":"അങ്ങേയുടെ സിംഹാസനം തലമുറതലമുറയായും ഇരിക്കുന്നു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അങ്ങ് സദാകാലം ഞങ്ങളെ മറക്കുന്നതും","poem":1},{"text":"ദീർഘകാലം ഞങ്ങളെ ഉപേക്ഷിക്കുന്നതും എന്ത്?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"യഹോവേ, ഞങ്ങൾ മടങ്ങി വരേണ്ടതിന്","poem":1},{"text":"ഞങ്ങളെ അങ്ങയിലേക്ക് മടക്കിവരുത്തേണമേ;","poem":2},{"text":"ഞങ്ങൾക്ക് പണ്ടത്തെപ്പോലെ","poem":1},{"text":"ഒരു നല്ലകാലം വരുത്തേണമേ;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"അല്ല, അങ്ങ് ഞങ്ങളെ അശേഷം ത്യജിച്ചുകളഞ്ഞിരിക്കുന്നുവോ?","poem":1},{"text":"ഞങ്ങളോട് അങ്ങ് അതികഠിനമായി കോപിച്ചിരിക്കുന്നുവോ?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}