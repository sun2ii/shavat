{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"MIC","translationId":"mal_irv","name":"മീഖാ","commonName":"മീഖാ","title":"മീഖാ","order":33,"numberOfChapters":7,"sha256":"0308aa4475ced80925d0fcafcb5be4b842f0d4a7193221e8001c3c1d1e9f71c0","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/mal_irv/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["യിസ്രായേലിന്‍റെ കഷ്ടത"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"എനിക്ക് അയ്യോ കഷ്ടം;","poem":1},{"text":"വേനൽപ്പഴം പറിച്ച ശേഷമെന്നപോലെയും","poem":2},{"text":"മുന്തിരിപ്പഴം പറിച്ചശേഷം കാലാ പെറുക്കുന്നതുപോലെയും ഞാൻ ആയല്ലോ!","poem":1},{"lineBreak":true},{"text":"തിന്നുവാൻ ഒരു മുന്തിരിക്കുലയും ഇല്ല;","poem":1},{"text":"ഞാൻ കൊതിക്കുന്ന അത്തിയുടെ ആദ്യഫലവുമില്ല.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ഭക്തിമാൻ ഭൂമിയിൽനിന്ന് നശിച്ചുപോയി,","poem":1},{"text":"മനുഷ്യരുടെ ഇടയിൽ നേരുള്ളവൻ ആരുമില്ല;","poem":2},{"text":"അവരെല്ലാം രക്തത്തിനായി പതിയിരിക്കുന്നു;","poem":1},{"text":"ഓരോരുത്തൻ അവനവന്‍റെ സഹോദരനെ വലവച്ചു പിടിക്കുവാൻ നോക്കുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ജാഗ്രതയോടെ ദോഷം പ്രവർത്തിക്കേണ്ടതിന്","poem":1},{"text":"അവരുടെ കൈ അതിലേക്ക് നീണ്ടിരിക്കുന്നു;","poem":2},{"text":"പ്രഭു പ്രതിഫലം ചോദിക്കുന്നു;","poem":1},{"text":"ന്യായാധിപതി കോഴ വാങ്ങി ന്യായം വിധിക്കുന്നു;","poem":2},{"text":"മഹാൻ തന്‍റെ മനസ്സിലെ ദുരാഗ്രഹം പ്രസ്താവിക്കുന്നു;","poem":1},{"text":"ഇങ്ങനെ അവർ ആലോചന കഴിക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവരിൽ ഉത്തമൻ മുൾപടർപ്പുപോലെ;","poem":1},{"text":"നേരുള്ളവൻ മുള്ളുവേലിയെക്കാൾ ഭയങ്കരൻ;","poem":2},{"text":"നിന്‍റെ ദർശകന്മാർ പറഞ്ഞ ദിവസം,","poem":1},{"text":"നിന്‍റെ സന്ദർശനദിവസം തന്നെ, വരുന്നു;","poem":2},{"lineBreak":true},{"text":"ഇപ്പോൾ അവരുടെ പരിഭ്രമം വന്നുഭവിക്കും.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"കൂട്ടുകാരനെ വിശ്വസിക്കരുത്;","poem":1},{"text":"സ്നേഹിതനിൽ ആശ്രയിക്കരുത്;","poem":2},{"text":"നിന്‍റെ മാർവ്വിടത്ത് ശയിക്കുന്നവളോട് പറയാത്തവിധം","poem":1},{"text":"നിന്‍റെ വായുടെ കതക് കാത്തുകൊള്ളുക.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"മകൻ അപ്പനെ നിന്ദിക്കുന്നു;","poem":1},{"text":"മകൾ അമ്മയോടും","poem":2},{"text":"മരുമകൾ അമ്മാവിയമ്മയോടും","poem":1},{"text":"എതിർത്തുനില്ക്കുന്നു;","poem":2},{"text":"മനുഷ്യന്‍റെ ശത്രുക്കൾ","poem":1},{"text":"അവന്‍റെ വീട്ടുകാർ തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ഞാനോ യഹോവയിങ്കലേക്കു നോക്കും;","poem":1},{"text":"എന്‍റെ രക്ഷയുടെ ദൈവത്തിനായി കാത്തിരിക്കും;","poem":2},{"lineBreak":true},{"text":"എന്‍റെ ദൈവം എന്‍റെ പ്രാർത്ഥന കേൾക്കും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"എന്‍റെ ശത്രുവായവളേ, എന്നെച്ചൊല്ലി സന്തോഷിക്കരുത്;","poem":1},{"text":"വീണു എങ്കിലും ഞാൻ വീണ്ടും എഴുന്നേല്‍ക്കും;","poem":2},{"text":"ഞാൻ ഇരുട്ടിൽ ഇരുന്നാലും","poem":1},{"text":"യഹോവ എനിക്ക് വെളിച്ചമായിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"യഹോവ എന്‍റെ വ്യവഹാരം നടത്തി","poem":1},{"text":"എനിക്ക് ന്യായം പാലിച്ചുതരുവോളം","poem":2},{"text":"ഞാൻ അവിടുത്തെ ക്രോധം വഹിക്കും","poem":1},{"noteId":4},{"text":";","poem":1},{"text":"ഞാൻ അവിടുത്തോട് പാപം ചെയ്തുവല്ലോ;","poem":2},{"text":"അവിടുന്ന് എന്നെ വെളിച്ചത്തിലേക്ക് പുറപ്പെടുവിക്കുകയും","poem":1},{"text":"ഞാൻ അവിടുത്തെ നീതി കണ്ടു സന്തോഷിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"എന്‍റെ ശത്രു അത് കാണും;","poem":1},{"text":"“നിന്‍റെ ദൈവമായ യഹോവ എവിടെ” എന്ന്","poem":2},{"text":"എന്നോട് പറഞ്ഞവളെ ലജ്ജകൊണ്ടു മൂടും;","poem":1},{"text":"എന്‍റെ കണ്ണ് അവളെ കണ്ടു രസിക്കും;","poem":2},{"lineBreak":true},{"text":"അന്ന് അവളെ വീഥികളിലെ ചെളിപോലെ ചവിട്ടിക്കളയും.","poem":2}]},{"type":"heading","content":["പുനഃസ്ഥാപനത്തിന്‍റെ ഒരു പ്രവചനം"]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"നിന്‍റെ മതിലുകൾ പണിയുവാനുള്ള നാൾ വരുന്നു:","poem":1},{"text":"ആ നാളിൽ നിന്‍റെ അതിരുകൾ വിശാലമാകും.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ആ നാളിൽ അശ്ശൂരിൽനിന്നും","poem":1},{"text":"മിസ്രയീമിൻ്റെ പട്ടണങ്ങളിൽനിന്നും","poem":2},{"lineBreak":true},{"text":"മിസ്രയീം മുതൽ നദിവരെയും","poem":2},{"text":"സമുദ്രംമുതൽ സമുദ്രംവരെയും","poem":1},{"text":"പർവ്വതംമുതൽ പർവ്വതംവരെയും","poem":2},{"lineBreak":true},{"text":"അവർ നിന്‍റെ അടുക്കൽ വരും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"എന്നാൽ ഭൂമി നിവാസികൾനിമിത്തവും","poem":1},{"text":"അവരുടെ പ്രവൃത്തികളുടെ ഫലം ഹേതുവായും ശൂന്യമായ്തീരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"കർമ്മേലിന്‍റെ മദ്ധ്യത്തിൽ കാട്ടിൽ തനിച്ചിരിക്കുന്നതും","poem":1},{"text":"അങ്ങേയുടെ അവകാശവുമായി,","poem":2},{"text":"അങ്ങേയുടെ ജനമായ ആട്ടിൻകൂട്ടത്തെ","poem":1},{"text":"അങ്ങേയുടെ കോൽകൊണ്ട് മേയിക്കണമേ;","poem":2},{"text":"പുരാതനകാലത്ത് എന്നപോലെ അവർ","poem":1},{"text":"ബാശാനിലും ഗിലെയാദിലും മേഞ്ഞുകൊണ്ടിരിക്കട്ടെ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“നീ മിസ്രയീമിൽ നിന്ന് പുറപ്പെട്ട കാലത്തെന്നപോലെ","poem":1},{"text":"ഞാൻ അവരെ അത്ഭുതങ്ങൾ കാണിക്കും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"രാജ്യങ്ങൾ കണ്ടിട്ട് തങ്ങളുടെ സകലവീര്യത്തിലും ലജ്ജിക്കും;","poem":1},{"text":"അവർ വായ്മേൽ കൈ വയ്ക്കുകയും","poem":2},{"lineBreak":true},{"text":"ചെകിടരായിത്തീരുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവർ പാമ്പിനെപ്പോലെ പൊടിനക്കും;","poem":1},{"text":"നിലത്തെ ഇഴജാതിപോലെ തങ്ങളുടെ ഗുഹകളിൽനിന്ന് വിറച്ചുകൊണ്ടു വരും;","poem":2},{"text":"അവർ പേടിച്ചുംകൊണ്ട് നമ്മുടെ ദൈവമായ യഹോവയുടെ അടുക്കൽ വരികയും,","poem":1},{"text":"നിങ്ങൾ നിമിത്തം ഭയപ്പെടുകയും ചെയ്യും.","poem":2}]},{"type":"heading","content":["യഹോവയുടെ കരുണയും അചഞ്ചലമായ സ്നേഹവും"]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"അകൃത്യം ക്ഷമിക്കുകയും","poem":1},{"text":"തന്‍റെ അവകാശത്തിൽ ശേഷിപ്പുള്ളവരോട്","poem":2},{"text":"അതിക്രമം മോചിക്കുകയും ചെയ്യുന്ന","poem":1},{"text":"അങ്ങേയോട് സമനായ ദൈവം ആരുള്ളു?","poem":2},{"text":"അവിടുന്ന് എന്നേക്കും കോപം വച്ചുകൊള്ളുന്നില്ല;","poem":1},{"text":"ദയയിൽ അല്ലയോ അവിടുത്തേക്ക് പ്രസാദമുള്ളത്.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അവിടുന്ന് നമ്മോട് വീണ്ടും കരുണ കാണിക്കും;","poem":1},{"text":"നമ്മുടെ അകൃത്യങ്ങളെ ചവിട്ടിക്കളയും;","poem":2},{"text":"അവരുടെ പാപങ്ങൾ എല്ലാം അവിടുന്ന്","poem":1},{"text":"സമുദ്രത്തിന്‍റെ ആഴത്തിൽ ഇട്ടുകളയും.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"പുരാതനകാലംമുതൽ അവിടുന്ന് ഞങ്ങളുടെ പൂര്‍വ്വ പിതാക്കന്മാരോട്","poem":1},{"text":"സത്യം ചെയ്തിരിക്കുന്ന അവിടുത്തെ വിശ്വസ്തത","poem":2},{"text":"അവിടുന്ന് യാക്കോബിനോടും","poem":1},{"text":"അവിടുത്തെ ദയ അബ്രാഹാമിനോടും കാണിക്കും.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"ക്രോധം വഹിക്കും ക്രോധം ചുമക്കും","reference":{"chapter":7,"verse":9}}]},"thisChapterLink":"/api/mal_irv/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}