{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_irv","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"c9c58506fd1164d7ae2ea4bf69a81027e9aa684781325d6e9d0270e1119f1917","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["യിസ്രായേൽ രാജാവായിരുന്ന ദാവീദിന്‍റെ മകനായ ശലോമോന്‍റെ സദൃശവാക്യങ്ങൾ."]},{"type":"heading","content":["ആമുഖം"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ജ്ഞാനവും പ്രബോധനവും പ്രാപിക്കുവാനും","poem":1},{"text":"വിവേകവചനങ്ങളെ ഗ്രഹിക്കുവാനും","poem":2}]},{"type":"verse","number":3,"content":[{"text":"പരിജ്ഞാനം, നീതി, ന്യായം, സത്യം","poem":1},{"text":"എന്നിവയ്ക്കായി പ്രബോധനം ലഭിക്കുവാനും","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അല്പബുദ്ധികൾക്ക് സൂക്ഷ്മബുദ്ധിയും","poem":1},{"text":"ബാലന് പരിജ്ഞാനവും വകതിരിവും നല്കുവാനും","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ജ്ഞാനി കേട്ടിട്ടു വിദ്യാഭിവൃദ്ധി പ്രാപിക്കുവാനും,","poem":1},{"text":"ബുദ്ധിമാൻ സദുപദേശം സമ്പാദിക്കുവാനും","poem":2}]},{"type":"verse","number":6,"content":[{"text":"സദൃശവാക്യങ്ങളും അലങ്കാരവചനങ്ങളും","poem":1},{"text":"ജ്ഞാനികളുടെ മൊഴികളും കടങ്കഥകളും ഗ്രഹിക്കുവാനും അവ ഉപകരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"യഹോവാഭക്തി ജ്ഞാനത്തിന്‍റെ ആരംഭമാകുന്നു;","poem":1},{"text":"ഭോഷന്മാർ ജ്ഞാനവും പ്രബോധനവും നിരസിക്കുന്നു.","poem":2}]},{"type":"heading","content":["ജ്ഞാനം സമ്പാദിക്കുന്നതിനുള്ള ആഹ്വാനം"]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"മകനേ, അപ്പന്‍റെ പ്രബോധനം കേൾക്കുക;","poem":1},{"text":"അമ്മയുടെ ഉപദേശം ഉപേക്ഷിക്കുകയും അരുത്;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവ നിന്‍റെ ശിരസ്സിന് അലങ്കാരമാലയും","poem":1},{"text":"നിന്‍റെ കഴുത്തിന് ആഭരണവും ആയിരിക്കും.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"മകനേ, പാപികൾ നിന്നെ വശീകരിച്ചാൽ","poem":1},{"text":"അവർക്ക് വഴങ്ങരുത്.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“ഞങ്ങളോടുകൂടി വരിക; നാം രക്തത്തിനായി പതിയിരിക്കുക;","poem":1},{"text":"നിർദ്ദോഷിയെ കാരണംകൂടാതെ പിടിക്കുവാൻ ഒളിച്ചിരിക്കുക.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"പാതാളംപോലെ അവരെ ജീവനോടെയും","poem":1},{"text":"കുഴിയിൽ ഇറങ്ങുന്നവരെപ്പോലെ അവരെ സർവ്വാംഗമായും വിഴുങ്ങിക്കളയുക.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"നമുക്ക് വിലയേറിയ സമ്പത്തൊക്കെയും കിട്ടും;","poem":1},{"text":"നമ്മുടെ വീടുകളെ കൊള്ളകൊണ്ട് നിറയ്ക്കാം.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"നിനക്കു ഞങ്ങളോടൊപ്പം തുല്യഓഹരി കിട്ടും;","poem":1},{"text":"നമുക്ക് എല്ലാവർക്കും സഞ്ചി ഒന്നായിരിക്കും” എന്നിങ്ങനെ അവർ പറഞ്ഞാൽ,","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"മകനേ, നീ അവരുടെ വഴിക്ക് പോകരുത്;","poem":1},{"text":"നിന്‍റെ കാൽ അവരുടെ പാതയിൽ വയ്ക്കുകയും അരുത്.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അവരുടെ കാൽ ദോഷം ചെയ്യുവാൻ ഓടുന്നു;","poem":1},{"text":"രക്തം ചൊരിയിക്കുവാൻ അവർ ബദ്ധപ്പെടുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"പക്ഷി കാൺകെ വലവിരിക്കുന്നത് വ്യർത്ഥമല്ലയോ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"അവർ സ്വന്ത രക്തത്തിനായി പതിയിരിക്കുന്നു;","poem":1},{"text":"സ്വന്തപ്രാണഹാനിക്കായി ഒളിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ദുരാഗ്രഹികളായ എല്ലാരുടെയും വഴികൾ അങ്ങനെ തന്നെ;","poem":1},{"text":"അത് അവരുടെ ജീവനെ എടുത്തുകളയുന്നു.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["ജ്ഞാനത്തിന്‍റെ ആഹ്വാനം"]},{"type":"verse","number":20,"content":[{"text":"ജ്ഞാനം വീഥിയിൽ ഘോഷിക്കുന്നു;","poem":1},{"text":"അവൾ വിശാലസ്ഥലത്ത് സ്വരം കേൾപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവൾ ആരവമുള്ള തെരുക്കളുടെ തലയ്ക്കൽനിന്ന് വിളിക്കുന്നു;","poem":1},{"text":"നഗരകവാടങ്ങളിലും നഗരത്തിനകത്തും പ്രസ്താവിക്കുന്നത്:","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“ബുദ്ധിഹീനരേ, നിങ്ങൾ ബുദ്ധീഹിനതയിൽ രസിക്കുകയും","poem":1},{"text":"പരിഹാസികളേ, നിങ്ങൾ പരിഹാസത്തിൽ സന്തോഷിക്കുകയും","poem":2},{"lineBreak":true},{"text":"ഭോഷന്മാരേ, നിങ്ങൾ പരിജ്ഞാനത്തെ വെറുക്കുകയും ചെയ്യുന്നത് എത്രത്തോളം?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"എന്‍റെ ശാസനയ്ക്ക് തിരിഞ്ഞുകൊള്ളുവിൻ;","poem":1},{"text":"ഞാൻ എന്‍റെ മനസ്സ് നിങ്ങൾക്ക് പകർന്നുതരും;","poem":2},{"lineBreak":true},{"text":"എന്‍റെ വചനങ്ങൾ നിങ്ങളെ അറിയിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"”ഞാൻ വിളിച്ചിട്ട് നിങ്ങൾ ശ്രദ്ധിക്കാതെയും","poem":1},{"text":"ഞാൻ കൈ നീട്ടിയിട്ട് ആരും കൂട്ടാക്കാതെയും","poem":2}]},{"type":"verse","number":25,"content":[{"text":"നിങ്ങൾ എന്‍റെ ആലോചന എല്ലാം ത്യജിച്ചുകളയുകയും","poem":1},{"text":"എന്‍റെ ശാസനയെ ഒട്ടും അനുസരിക്കാതിരിക്കുകയും ചെയ്തതുകൊണ്ട്","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ഞാനും നിങ്ങളുടെ അനർത്ഥദിവസത്തിൽ ചിരിക്കും;","poem":1},{"text":"നിങ്ങൾ ഭയപ്പെടുന്നത് നിങ്ങൾക്ക് ഭവിക്കുമ്പോൾ പരിഹസിക്കും.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"നിങ്ങൾ ഭയപ്പെടുന്നത് നിങ്ങൾക്ക് കൊടുങ്കാറ്റുപോലെയും","poem":1},{"text":"നിങ്ങളുടെ ആപത്ത് ചുഴലിക്കാറ്റുപോലെയും വരുമ്പോൾ,","poem":2},{"lineBreak":true},{"text":"കഷ്ടവും സങ്കടവും നിങ്ങൾക്ക് വരുമ്പോൾ തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"”അപ്പോൾ അവർ എന്നെ വിളിക്കും;","poem":1},{"text":"ഞാൻ ഉത്തരം പറയുകയില്ല.","poem":2},{"text":"എന്നെ ജാഗ്രതയോടെ അന്വേഷിക്കും;","poem":1},{"text":"കണ്ടെത്തുകയുമില്ല.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"അവർ പരിജ്ഞാനത്തെ വെറുത്തുവല്ലോ;","poem":1},{"text":"യഹോവാഭക്തിയെ തിരഞ്ഞെടുത്തതുമില്ല.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"അവർ എന്‍റെ ആലോചന അനുസരിക്കാതെ","poem":1},{"text":"എന്‍റെ ശാസന എല്ലാം നിരസിച്ച് കളഞ്ഞതുകൊണ്ട്","poem":2}]},{"type":"verse","number":31,"content":[{"text":"അവർ സ്വന്തവഴിയുടെ ഫലം അനുഭവിക്കുകയും","poem":1},{"text":"അവരുടെ ആലോചനകളാൽ തൃപ്തി പ്രാപിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ബുദ്ധിഹീനരുടെ പിന്മാറ്റം അവരെ കൊല്ലും;","poem":1},{"text":"ഭോഷന്മാരുടെ അലസത അവരെ നശിപ്പിക്കും.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"എന്‍റെ വാക്ക് കേൾക്കുന്നവനോ നിർഭയം വസിക്കുകയും","poem":1},{"text":"ദോഷഭയം കൂടാതെ സ്വൈരമായിരിക്കുകയും ചെയ്യും.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}