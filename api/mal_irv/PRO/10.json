{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_irv","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"c9c58506fd1164d7ae2ea4bf69a81027e9aa684781325d6e9d0270e1119f1917","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":10,"content":[{"type":"heading","content":["ശലോമോന്‍റെ സദൃശവാക്യങ്ങൾ"]},{"type":"verse","number":1,"content":["ശലോമോന്‍റെ സദൃശവാക്യങ്ങൾ:",{"lineBreak":true},{"text":"ജ്ഞാനമുള്ള മകൻ അപ്പനെ സന്തോഷിപ്പിക്കുന്നു;","poem":1},{"text":"ഭോഷനായ മകൻ അമ്മയ്ക്ക് വ്യസനം ഉളവാക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ദുഷ്ടതയാൽ സമ്പാദിച്ച നിക്ഷേപങ്ങൾ പ്രയോജനപ്പെടുന്നില്ല;","poem":1},{"text":"നീതിയോ മരണത്തിൽനിന്ന് വിടുവിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"യഹോവ നീതിമാനെ പട്ടിണി കിടത്തുകയില്ല;","poem":1},{"text":"ദുഷ്ടന്മാരുടെ മോഹത്തെയോ അവിടുന്ന് തള്ളിക്കളയുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"മടിയുള്ള കൈകൊണ്ട് പ്രവർത്തിക്കുന്നവൻ ദരിദ്രനായിത്തീരുന്നു;","poem":1},{"text":"ഉത്സാഹിയുടെ കൈയോ സമ്പത്തുണ്ടാക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"വേനല്‍ക്കാലത്ത് ശേഖരിച്ചുവയ്ക്കുന്നവൻ ബുദ്ധിയുള്ള മകൻ;","poem":1},{"text":"കൊയ്ത്തുകാലത്ത് ഉറങ്ങുന്നവനോ നാണംകെട്ട മകൻ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"നീതിമാന്‍റെ ശിരസ്സിന്മേൽ അനുഗ്രഹങ്ങൾ വരുന്നു;","poem":1},{"text":"എന്നാൽ ദുഷ്ടന്മാരുടെ വായെ സാഹസം മൂടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"നീതിമാന്‍റെ ഓർമ്മ അനുഗ്രഹിക്കപ്പെട്ടത്;","poem":1},{"text":"ദുഷ്ടന്മാരുടെ പേരോ ദുഷിച്ചുപോകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ജ്ഞാനഹൃദയൻ കല്പനകൾ കൈക്കൊള്ളുന്നു;","poem":1},{"text":"വിവേകശൂന്യനായ ഭോഷനോ വീണുപോകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"നേരായി നടക്കുന്നവൻ നിർഭയമായി നടക്കുന്നു;","poem":1},{"text":"നടപ്പിൽ വക്രതയുള്ളവന്‍റെ വഴികൾ വെളിപ്പെട്ടുവരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"കണ്ണുകൊണ്ട് ആംഗ്യം കാട്ടുന്നവൻ അശാന്തി വരുത്തുന്നു;","poem":1},{"text":"തുറന്നു ശാസിക്കുന്നവനോ സമാധാനം ഉണ്ടാക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"നീതിമാന്‍റെ വായ് ജീവന്‍റെ ഉറവാകുന്നു.","poem":1},{"text":"എന്നാൽ ദുഷ്ടന്മാരുടെ അധരത്തെ സാഹസം മൂടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"പക വഴക്കുകൾക്ക് കാരണം ആകുന്നു;","poem":1},{"text":"സ്നേഹമോ, സകല ലംഘനങ്ങളെയും മൂടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"വിവേകിയുടെ അധരങ്ങളിൽ ജ്ഞാനം ഉണ്ട്;","poem":1},{"text":"ബുദ്ധിഹീനന്‍റെ മുതുകിലോ വടി വീഴും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ജ്ഞാനികൾ പരിജ്ഞാനം അടക്കിവെക്കുന്നു;","poem":1},{"text":"ഭോഷന്‍റെ വായ്ക്കോ നാശം അടുത്തിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ധനവാന് തന്‍റെ സമ്പത്ത് അവന് ഉറപ്പുള്ള ഒരു പട്ടണം;","poem":1},{"text":"എളിയവരുടെ നാശമോ അവരുടെ ദാരിദ്ര്യം തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"നീതിമാന്‍റെ സമ്പാദ്യം ജീവഹേതുവും","poem":1},{"text":"ദുഷ്ടന്‍റെ ആദായം പാപകാരണവും ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"പ്രബോധനം പ്രമാണിക്കുന്നവൻ ജീവമാർഗ്ഗത്തിൽ ഇരിക്കുന്നു;","poem":1},{"text":"ശാസന ത്യജിക്കുന്നവനോ വഴി തെറ്റിപ്പോകുന്നു;","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"പക മറച്ചുവയ്ക്കുന്നവൻ വ്യാജമുള്ളവൻ;","poem":1},{"text":"ഏഷണി പറയുന്നവൻ ഭോഷൻ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"വാക്ക് പെരുകിയാൽ ലംഘനം ഇല്ലാതിരിക്കുകയില്ല;","poem":1},{"text":"അധരങ്ങളെ അടക്കുന്നവനോ ബുദ്ധിമാൻ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"നീതിമാന്‍റെ നാവ് മേല്ത്തരമായ വെള്ളി;","poem":1},{"text":"ദുഷ്ടന്മാരുടെ ഹൃദയമോ നിസ്സാരം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"നീതിമാന്‍റെ അധരങ്ങൾ അനേകം പേരെ പോഷിപ്പിക്കും;","poem":1},{"text":"ഭോഷന്മാരോ ബുദ്ധിഹീനതയാൽ മരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"യഹോവയുടെ അനുഗ്രഹത്താൽ സമ്പത്തുണ്ടാകുന്നു;","poem":1},{"text":"അദ്ധ്വാനത്താൽ അതിനോട് ഒന്നും കൂടുന്നില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ദോഷം ചെയ്യുന്നത് ഭോഷന് കളിയാകുന്നു;","poem":1},{"text":"വിവേകി ജ്ഞാനത്തിൽ സന്തോഷിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ദുഷ്ടൻ പേടിക്കുന്നത് അവന് ഭവിക്കും;","poem":1},{"text":"നീതിമാന്മാരുടെ ആഗ്രഹമോ സാധിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ചുഴലിക്കാറ്റ് കടന്നുപോകുമ്പോൾ ദുഷ്ടൻ ഇല്ലാതെയായി;","poem":1},{"text":"നീതിമാനോ ശാശ്വതമായ അടിസ്ഥാനം ഉള്ളവൻ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ചൊറുക്ക പല്ലിനും പുക കണ്ണിനും എങ്ങനെയോ,","poem":1},{"text":"അങ്ങനെയാകുന്നു മടിയൻ തന്നെ അയയ്ക്കുന്നവർക്ക്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"യഹോവാഭക്തി ആയുസ്സ് ദീർഘമാക്കുന്നു;","poem":1},{"text":"ദുഷ്ടന്മാരുടെ സംവത്സരങ്ങൾ കുറഞ്ഞുപോകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"നീതിമാന്മാരുടെ പ്രത്യാശ സന്തോഷമാകുന്നു;","poem":1},{"text":"ദുഷ്ടന്മാരുടെ പ്രതീക്ഷയ്ക്ക് ഭംഗം വരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"യഹോവയുടെ വഴി നേരുള്ളവന് ഒരു ദുർഗ്ഗം;","poem":1},{"text":"ദുഷ്പ്രവൃത്തിക്കാർക്ക് അത് നാശകരം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"നീതിമാൻ ഒരുനാളും കുലുങ്ങിപ്പോകുകയില്ല;","poem":1},{"text":"ദുഷ്ടന്മാർ ദേശത്ത് വസിക്കുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"നീതിമാന്‍റെ വായ് ജ്ഞാനം പുറപ്പെടുവിക്കുന്നു;","poem":1},{"text":"വക്രതയുള്ള നാവ് ഛേദിക്കപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"നീതിമാന്‍റെ അധരങ്ങൾ പ്രസാദകരമായത് അറിയുന്നു;","poem":1},{"text":"ദുഷ്ടന്മാരുടെ വായ് വക്രതയുള്ളതാകുന്നു.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}