{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_irv","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"c9c58506fd1164d7ae2ea4bf69a81027e9aa684781325d6e9d0270e1119f1917","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":11,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"കള്ളത്തുലാസ്സ് യഹോവയ്ക്ക് വെറുപ്പ്;","poem":1},{"text":"ശരിയായ തൂക്കം അവിടുത്തേക്ക് പ്രസാദകരം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"അഹങ്കാരം വരുമ്പോൾ ലജ്ജയും വരുന്നു;","poem":1},{"text":"താഴ്മയുള്ളവരുടെ പക്കൽ ജ്ഞാനമുണ്ട്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"നേരുള്ളവരുടെ സത്യസന്ധത അവരെ വഴിനടത്തും;","poem":1},{"text":"ദ്രോഹികളുടെ വക്രത അവരെ നശിപ്പിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ക്രോധദിവസത്തിൽ സമ്പത്ത് ഉപകരിക്കുന്നില്ല;","poem":1},{"text":"നീതിയോ മരണത്തിൽനിന്ന് വിടുവിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"നിഷ്കളങ്കന്‍റെ നീതി അവന് നേർവഴി ഒരുക്കും;","poem":1},{"lineBreak":true},{"text":"ദുഷ്ടൻ തന്‍റെ ദുഷ്ടതകൊണ്ട് വീണുപോകും.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"നേരുള്ളവരുടെ നീതി അവരെ വിടുവിക്കും;","poem":1},{"text":"ദ്രോഹികൾ അവരുടെ ദുർമ്മോഹത്താൽ പിടിക്കപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ദുഷ്ടൻ മരിക്കുമ്പോൾ അവന്‍റെ പ്രതീക്ഷ നശിക്കുന്നു;","poem":1},{"text":"നീതികെട്ടവരുടെ ആശയ്ക്ക് ഭംഗംവരുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"നീതിമാൻ കഷ്ടത്തിൽനിന്ന് രക്ഷപെടുന്നു;","poem":1},{"text":"ദുഷ്ടൻ അവന് പകരം അകപ്പെടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"വഷളൻ വായ്കൊണ്ട് കൂട്ടുകാരനെ നശിപ്പിക്കുന്നു;","poem":1},{"text":"നീതിമാന്മാർ പരിജ്ഞാനത്താൽ വിടുവിക്കപ്പെടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"നീതിമാന്മാർ ശുഭമായിരിക്കുമ്പോൾ പട്ടണം സന്തോഷിക്കുന്നു;","poem":1},{"text":"ദുഷ്ടന്മാർ നശിക്കുമ്പോൾ ആർപ്പുവിളി ഉണ്ടാകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"നേരുള്ളവരുടെ അനുഗ്രഹംകൊണ്ട് പട്ടണം ഉയർച്ച പ്രാപിക്കുന്നു;","poem":1},{"text":"ദുഷ്ടന്മാരുടെ വായ്കൊണ്ടോ അത് ഇടിഞ്ഞുപോകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"കൂട്ടുകാരനെ നിന്ദിക്കുന്നവൻ ബുദ്ധിഹീനൻ;","poem":1},{"text":"വിവേകമുള്ളവൻ മിണ്ടാതിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ഏഷണിക്കാരനായി നടക്കുന്നവൻ രഹസ്യം വെളിപ്പെടുത്തുന്നു;","poem":1},{"text":"വിശ്വസ്തമാനസൻ കാര്യം മറച്ചുവയ്ക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"മാർഗ്ഗനിർദ്ദേശം ഇല്ലാത്തയിടത്ത് ജനം അധോഗതി പ്രാപിക്കുന്നു;","poem":1},{"text":"മന്ത്രിമാരുടെ ബഹുത്വത്തിലോ രക്ഷയുണ്ട്","poem":2},{"noteId":3},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"അന്യനുവേണ്ടി ജാമ്യം നില്ക്കുന്നവൻ അത്യന്തം വ്യസനിക്കും!","poem":1},{"text":"ജാമ്യം നിൽക്കാത്തവൻ നിർഭയനായിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"കൃപാലുവായ സ്ത്രീ മാനം സംരക്ഷിക്കുന്നു;","poem":1},{"text":"കരുണയില്ലാത്തവർ സമ്പത്ത് സൂക്ഷിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ദയാലുവായവൻ സ്വന്തപ്രാണന് നന്മ ചെയ്യുന്നു;","poem":1},{"text":"ക്രൂരനോ സ്വന്തജഡത്തെ ഉപദ്രവിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ദുഷ്ടൻ വൃഥാലാഭം ഉണ്ടാക്കുന്നു;","poem":1},{"text":"നീതി വിതയ്ക്കുന്നവന് വാസ്തവമായ പ്രതിഫലം കിട്ടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"നീതിയിൽ സ്ഥിരപ്പെട്ടിരിക്കുന്നവൻ ജീവനെ പ്രാപിക്കുന്നു;","poem":1},{"text":"ദോഷത്തെ പിന്തുടരുന്നവൻ തന്‍റെ മരണത്തിനായി പ്രവർത്തിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"വക്രബുദ്ധികൾ യഹോവയ്ക്ക് വെറുപ്പ്;","poem":1},{"text":"നിഷ്കളങ്കമാർഗ്ഗികൾ അവിടുത്തേക്ക് പ്രസാദമുള്ളവർ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"നിശ്ചയമായും ദുഷ്ടനു ശിക്ഷ വരാതിരിക്കുകയില്ല;","poem":1},{"text":"നീതിമാന്മാരുടെ സന്തതിയോ രക്ഷിക്കപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"വിവേകമില്ലാത്ത ഒരു സുന്ദരി","poem":1},{"text":"പന്നിയുടെ മൂക്കിലെ പൊൻമൂക്കുത്തിപോലെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"നീതിമാന്മാരുടെ ആഗ്രഹം നന്മ തന്നെ;","poem":1},{"text":"ദുഷ്ടന്മാരുടെ പ്രതീക്ഷയോ ക്രോധമത്രേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ഒരുവൻ വാരിവിതറിയിട്ടും വർദ്ധിച്ചുവരുന്നു;","poem":1},{"text":"മറ്റൊരുവൻ അന്യായമായി സമ്പാദിച്ചിട്ടും ദാരിദ്ര്യത്തിൽ എത്തുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ഔദാര്യമാനസൻ പുഷ്ടി പ്രാപിക്കും;","poem":1},{"text":"തണുപ്പിക്കുന്നവന് തണുപ്പ് കിട്ടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ധാന്യം പൂട്ടിയിട്ടുകൊണ്ടിരിക്കുന്നവനെ ജനങ്ങൾ ശപിക്കും;","poem":1},{"text":"അത് വില്‍ക്കുന്നവന്‍റെ തലമേൽ അനുഗ്രഹം വരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"നന്മയ്ക്കായി ഉത്സാഹിക്കുന്നവൻ പ്രീതി സമ്പാദിക്കുന്നു;","poem":1},{"text":"തിന്മ തേടുന്നവന് അത് തന്നെ ലഭിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"തന്‍റെ സമ്പത്തിൽ ആശ്രയിക്കുന്നവൻ വീഴും;","poem":1},{"text":"നീതിമാന്മാർ പച്ചയിലപോലെ തഴയ്ക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"സ്വഭവനത്തെ വലയ്ക്കുന്നവന്‍റെ അവകാശം വായുവത്രെ;","poem":1},{"text":"ഭോഷൻ ജ്ഞാനഹൃദയന് ദാസനായിത്തീരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"നീതിമാന് ജീവവൃക്ഷം പ്രതിഫലം;","poem":1},{"text":"ജ്ഞാനിയായവൻ ആത്മാക്കളെ നേടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"നീതിമാന് ഭൂമിയിൽ പ്രതിഫലം കിട്ടുന്നു എങ്കിൽ","poem":1},{"text":"ദുഷ്ടനും പാപിക്കും എത്ര അധികം?","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"രക്ഷയുണ്ട് ജയമുണ്ട്","reference":{"chapter":11,"verse":14}}]},"thisChapterLink":"/api/mal_irv/PRO/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PRO/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PRO/10.json","previousChapterAudioLinks":{},"numberOfVerses":31}