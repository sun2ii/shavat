{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_irv","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"c9c58506fd1164d7ae2ea4bf69a81027e9aa684781325d6e9d0270e1119f1917","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":["സ്ത്രീകളിൽ ജ്ഞാനമുള്ളവൾ തന്‍റെ വീട് പണിയുന്നു;",{"text":"ഭോഷത്തമുള്ളവളോ അത് സ്വന്തകൈകളാൽ പൊളിച്ചുകളയുന്നു.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"നേരായി നടക്കുന്നവൻ യഹോവയെ ഭയപ്പെടുന്നു;","poem":1},{"lineBreak":true},{"text":"നടപ്പിൽ വക്രതയുള്ളവൻ അവിടുത്തെ നിന്ദിക്കുന്നു.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ഭോഷന്‍റെ സംസാരം തനിക്കുതന്നെ ശിക്ഷ വിളിച്ചുവരുത്തുന്നു","poem":1},{"noteId":4},{"text":";","poem":1},{"lineBreak":true},{"text":"ജ്ഞാനികളുടെ അധരങ്ങൾ അവരെ കാത്തുകൊള്ളുന്നു.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"കാളകൾ ഇല്ലാത്തിടത്ത് തൊഴുത്ത് വെടിപ്പുള്ളത്;","poem":1},{"lineBreak":true},{"text":"കാളയുടെ ശക്തികൊണ്ട് വളരെ ആദായം ഉണ്ട്.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"വിശ്വസ്തസാക്ഷി ഭോഷ്ക് പറയുകയില്ല;","poem":1},{"lineBreak":true},{"text":"കള്ളസ്സാക്ഷി ഭോഷ്ക് പറയുന്നു.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"പരിഹാസി ജ്ഞാനം അന്വേഷിച്ചിട്ടും കണ്ടെത്തുന്നില്ല;","poem":1},{"lineBreak":true},{"text":"വിവേകമുള്ളവന് പരിജ്ഞാനം എളുപ്പം.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"മൂഢന്‍റെ മുമ്പിൽനിന്ന് മാറിപ്പോകുക;","poem":1},{"lineBreak":true},{"text":"പരിജ്ഞാനമുള്ള അധരങ്ങൾ നീ അവനിൽ കാണുകയില്ല.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"വഴി തിരിച്ചറിയുന്നത് വിവേകിയുടെ ജ്ഞാനം;","poem":1},{"lineBreak":true},{"text":"ചതിക്കുന്നതോ ഭോഷന്മാരുടെ ഭോഷത്തം.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ഭോഷന്മാർ അകൃത്യയാഗത്തെ പരിഹസിക്കുന്നു;","poem":1},{"lineBreak":true},{"text":"നേരുള്ളവർക്ക് തമ്മിൽ പ്രീതി ഉണ്ട്.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ഹൃദയം സ്വന്തദുഃഖത്തെ അറിയുന്നു;","poem":1},{"lineBreak":true},{"text":"അതിന്‍റെ സന്തോഷവും അന്യൻ പങ്കിടുന്നില്ല.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ദുഷ്ടന്മാരുടെ വീട് നശിച്ചുപോകും;","poem":1},{"lineBreak":true},{"text":"നീതിമാന്‍റെ കൂടാരമോ തഴയ്ക്കും.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ചിലപ്പോൾ ഒരു വഴി മനുഷ്യന് ചൊവ്വായി തോന്നും;","poem":1},{"lineBreak":true},{"text":"അതിന്‍റെ അവസാനം മരണവഴികൾ അത്രേ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ചിരിക്കുമ്പോഴും ഹൃദയം ദുഃഖിച്ചിരിക്കാം;","poem":1},{"lineBreak":true},{"text":"സന്തോഷത്തിന്‍റെ അവസാനം ദുഃഖമായിരിക്കാം.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ഹൃദയത്തിൽ പിന്മാറ്റമുള്ളവന് തന്‍റെ നടപ്പിൽ മടുപ്പുവരും;","poem":1},{"lineBreak":true},{"text":"നല്ല മനുഷ്യന് തന്‍റെ പ്രവൃത്തിയാൽ സംതൃപ്തി വരും.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"അല്പബുദ്ധി ഏത് വാക്കും വിശ്വസിക്കുന്നു;","poem":1},{"lineBreak":true},{"text":"സൂക്ഷ്മബുദ്ധിയോ തന്‍റെ നടപ്പ് സൂക്ഷിച്ചുകൊള്ളുന്നു.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ജ്ഞാനി സൂക്ഷ്മത്തോടെ നടക്കുന്നു","poem":1},{"noteId":5},{"text":";","poem":1},{"lineBreak":true},{"text":"ഭോഷൻ ധിക്കാരംപൂണ്ട് നിർഭയനായി നടക്കുന്നു.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"മുൻകോപി ഭോഷത്തം പ്രവർത്തിക്കുന്നു;","poem":1},{"lineBreak":true},{"text":"വക്രബുദ്ധിയുള്ളവന്‍ വെറുക്കപ്പെടും","poem":1},{"noteId":6},{"text":".","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"അല്പബുദ്ധികൾ ഭോഷത്തം അവകാശമാക്കുന്നു;","poem":1},{"lineBreak":true},{"text":"സൂക്ഷ്മബുദ്ധികളോ പരിജ്ഞാനം അണിയുന്നു.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ദുർജ്ജനം സജ്ജനത്തിന്‍റെ മുമ്പിലും","poem":1},{"lineBreak":true},{"text":"ദുഷ്ടന്മാർ നീതിമാന്മാരുടെ വാതില്‍ക്കലും വണങ്ങി നില്‍ക്കുന്നു.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ദരിദ്രനെ കൂട്ടുകാരൻ പോലും പകക്കുന്നു;","poem":1},{"lineBreak":true},{"text":"ധനവാനോ വളരെ സ്നേഹിതന്മാർ ഉണ്ട്.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"കൂട്ടുകാരനെ നിന്ദിക്കുന്നവൻ പാപം ചെയ്യുന്നു;","poem":1},{"lineBreak":true},{"text":"എളിയവരോട് കൃപ കാണിക്കുന്നവൻ ഭാഗ്യവാൻ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ദോഷം നിരൂപിക്കുന്നവർ വഴിവിട്ട് പോകുന്നില്ലയോ?","poem":1},{"lineBreak":true},{"text":"നന്മ നിരൂപിക്കുന്നവർക്ക് ദയയും വിശ്വസ്തതയും ലഭിക്കുന്നു.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"എല്ലാ തൊഴിലുംകൊണ്ട് ലാഭം വരും;","poem":1},{"lineBreak":true},{"text":"വ്യർത്ഥഭാഷണംകൊണ്ട് ദാരിദ്ര്യമേ വരുകയുള്ളു.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ജ്ഞാനികളുടെ ധനം അവർക്ക് കിരീടം;","poem":1},{"lineBreak":true},{"text":"മൂഢന്മാരുടെ ഭോഷത്വമോ ഭോഷത്തം തന്നെ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"സത്യസാക്ഷി പ്രാണരക്ഷ ചെയ്യുന്നു;","poem":1},{"lineBreak":true},{"text":"ഭോഷ്ക് പറയുന്നവനോ വഞ്ചന ചെയ്യുന്നു.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"യഹോവാഭക്തന് ഉറച്ചധൈര്യം ഉണ്ട്;","poem":1},{"lineBreak":true},{"text":"അവന്‍റെ മക്കൾക്കും അഭയം ഉണ്ടാകും.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"യഹോവാഭക്തി ജീവന്‍റെ ഉറവാകുന്നു;","poem":1},{"lineBreak":true},{"text":"അതിനാൽ മരണത്തിന്‍റെ കെണികൾ ഒഴിഞ്ഞുപോകും.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"പ്രജാബാഹുല്യം രാജാവിന് ബഹുമാനം;","poem":1},{"lineBreak":true},{"text":"പ്രജാന്യൂനത പ്രഭുവിന് നാശം.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"ദീർഘക്ഷമയുള്ളവൻ മഹാബുദ്ധിമാൻ;","poem":1},{"lineBreak":true},{"text":"മുൻകോപിയോ ഭോഷത്തം ഉയർത്തുന്നു.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"ശാന്തമനസ്സ് ദേഹത്തിന് ജീവൻ;","poem":1},{"lineBreak":true},{"text":"അസൂയയോ അസ്ഥികൾക്ക് ദ്രവത്വം.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"എളിയവനെ പീഡിപ്പിക്കുന്നവൻ അവന്‍റെ സ്രഷ്ടാവിനെ നിന്ദിക്കുന്നു;","poem":1},{"lineBreak":true},{"text":"ദരിദ്രനോട് കൃപ കാണിക്കുന്നവൻ അവിടുത്തെ ബഹുമാനിക്കുന്നു.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"ദുഷ്ടന് തന്‍റെ ദുഷ്ടതയാൽ വീഴ്ച വരുന്നു;","poem":1},{"lineBreak":true},{"text":"നീതിമാന്‍ സത്യത്തില്‍ അഭയം കണ്ടെത്തുന്നു","poem":1},{"noteId":7},{"text":".","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"വിവേകമുള്ളവന്‍റെ ഹൃദയത്തിൽ ജ്ഞാനം അടങ്ങിപ്പാർക്കുന്നു;","poem":1},{"lineBreak":true},{"text":"മൂഢന്മാരുടെ അന്തരംഗത്തിൽ ഉള്ളത് വെളിപ്പെട്ടുവരുന്നു.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"നീതി രാജ്യത്തെ ഉയർത്തുന്നു;","poem":1},{"lineBreak":true},{"text":"പാപം ജനതക്ക് അപമാനം.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"ബുദ്ധിമാനായ ദാസന് രാജാവിന്‍റെ പ്രീതി ലഭിക്കുന്നു;","poem":1},{"lineBreak":true},{"text":"നാണംകെട്ടവൻ അവന്‍റെ കോപത്തെ നേരിടും.","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"ഭോഷന്‍റെ സംസാരം തനിക്കുതന്നെ ശിക്ഷ വിളിച്ചുവരുത്തുന്നു ഭോഷന്‍റെ അഹങ്കാരം അവനെക്കൊണ്ട് അധികം സംസാരിപ്പിക്കുന്നു","reference":{"chapter":14,"verse":3}},{"noteId":5,"caller":"+","text":"ജ്ഞാനി സൂക്ഷ്മത്തോടെ നടക്കുന്നു ജ്ഞാനി യഹോവയെ ഭയപ്പെടുന്നു","reference":{"chapter":14,"verse":16}},{"noteId":6,"caller":"+","text":"വക്രബുദ്ധിയുള്ളവന്‍ വെറുക്കപ്പെടും വിവേകമുള്ളവന്‍ ശാന്തനായിരിക്കും","reference":{"chapter":14,"verse":17}},{"noteId":7,"caller":"+","text":"നീതിമാന്‍ സത്യത്തില്‍ അഭയം കണ്ടെത്തുന്നു നീതിമാന്‍ മരണത്തിലും പ്രത്യാശ കണ്ടെത്തുന്നു","reference":{"chapter":14,"verse":32}}]},"thisChapterLink":"/api/mal_irv/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}