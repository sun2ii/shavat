{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_irv","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"c9c58506fd1164d7ae2ea4bf69a81027e9aa684781325d6e9d0270e1119f1917","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":15,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"മൃദുവായ ഉത്തരം ക്രോധത്തെ ശമിപ്പിക്കുന്നു;","poem":1},{"text":"കഠിനവാക്കോ കോപത്തെ ജ്വലിപ്പിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ജ്ഞാനിയുടെ നാവ് നല്ല പരിജ്ഞാനം പ്രസ്താവിക്കുന്നു;","poem":1},{"text":"മൂഢന്മാരുടെ വായ് ഭോഷത്തം വർഷിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"യഹോവയുടെ കണ്ണ് എല്ലായിടവും ഉണ്ട്;","poem":1},{"text":"ദുഷ്ടന്മാരെയും നല്ലവരെയും നോക്കിക്കൊണ്ടിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"നാവിന്‍റെ ശാന്തത ജീവവൃക്ഷം;","poem":1},{"text":"അതിന്‍റെ വക്രതയോ മനോവ്യസനം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ഭോഷൻ അപ്പന്‍റെ പ്രബോധനം നിരസിക്കുന്നു;","poem":1},{"text":"ശാസനയെ സ്വീകരിക്കുന്നവൻ വിവേകിയായിത്തീരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"നീതിമാന്‍റെ വീട്ടിൽ വളരെ നിക്ഷേപം ഉണ്ട്;","poem":1},{"text":"ദുഷ്ടന്‍റെ ആദായത്തിലോ അനർത്ഥം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ജ്ഞാനികളുടെ അധരങ്ങൾ പരിജ്ഞാനം വിതറുന്നു;","poem":1},{"text":"മൂഢന്മാരുടെ ഹൃദയം നേരുള്ളതല്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ദുഷ്ടന്മാരുടെ യാഗം യഹോവയ്ക്ക് വെറുപ്പ്;","poem":1},{"text":"നേരുള്ളവരുടെ പ്രാർത്ഥനയോ അവന് പ്രസാദം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ദുഷ്ടന്മാരുടെ വഴി യഹോവയ്ക്ക് വെറുപ്പ്;","poem":1},{"text":"എന്നാൽ നീതിയെ പിന്തുടരുന്നവനെ അവിടുന്ന് സ്നേഹിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"സന്മാർഗ്ഗം ത്യജിക്കുന്നവന് കഠിനശിക്ഷ വരും;","poem":1},{"text":"ശാസന വെറുക്കുന്നവൻ മരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"പാതാളവും നരകവും യഹോവയുടെ ദൃഷ്ടിയിൽ തുറന്നിരിക്കുന്നുവെങ്കിൽ","poem":1},{"text":"മനുഷ്യപുത്രന്മാരുടെ ഹൃദയങ്ങൾ എത്ര അധികം!","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"പരിഹാസി ശാസന ഇഷ്ടപ്പെടുന്നില്ല;","poem":1},{"text":"ജ്ഞാനികളുടെ അടുക്കൽ ചെല്ലുന്നതുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"സന്തോഷമുള്ള ഹൃദയം മുഖപ്രസാദമുണ്ടാക്കുന്നു;","poem":1},{"text":"ഹൃദയത്തിലെ വ്യസനംകൊണ്ടോ ധൈര്യം നഷ്ടപ്പെടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"വിവേകമുള്ളവന്‍റെ ഹൃദയം പരിജ്ഞാനം അന്വേഷിക്കുന്നു;","poem":1},{"text":"മൂഢന്മാരുടെ വായ് ഭോഷത്തം ആചരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"പീഡിതന്‍റെ ജീവനാൾ എല്ലാം കഷ്ടകാലം;","poem":1},{"text":"സന്തുഷ്ടഹൃദയനോ നിത്യം ഉത്സവം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ബഹു നിക്ഷേപവും അതിനോടുകൂടി കഷ്ടതയും ഉള്ളതിനെക്കാൾ","poem":1},{"text":"യഹോവാഭക്തിയോടുകൂടി അല്പധനം ഉള്ളത് നന്ന്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"വിദ്വേഷമുള്ളേടത്തെ തടിപ്പിച്ച കാളയെക്കാൾ","poem":1},{"text":"സ്നേഹമുള്ളേടത്തെ സസ്യഭോജനം നല്ലത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ക്രോധമുള്ളവൻ കലഹം ഉണ്ടാക്കുന്നു;","poem":1},{"text":"ദീർഘക്ഷമയുള്ളവൻ കലഹം ശമിപ്പിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"മടിയന്‍റെ വഴി മുള്ളുവേലിപോലെയാകുന്നു;","poem":1},{"text":"നീതിമാന്മാരുടെ പാതയോ പെരുവഴി തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ജ്ഞാനമുള്ള മകൻ അപ്പനെ സന്തോഷിപ്പിക്കുന്നു;","poem":1},{"text":"മൂഢനോ അമ്മയെ നിന്ദിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ഭോഷത്തം ബുദ്ധിഹീനന് സന്തോഷം;","poem":1},{"text":"വിവേകിയോ ചൊവ്വായി നടക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ആലോചന ഇല്ലാതിരുന്നാൽ ഉദ്ദേശ്യങ്ങൾ സാധിക്കാതെ പോകുന്നു;","poem":1},{"text":"ആലോചനക്കാരുടെ ബഹുത്വത്താൽ അവ സാധിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"താൻ പറയുന്ന ഉത്തരം ഹേതുവായി മനുഷ്യന് സന്തോഷം വരും;","poem":1},{"text":"തക്കസമയത്ത് പറയുന്ന വാക്ക് എത്ര മനോഹരം!","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ബുദ്ധിമാന്‍റെ ജീവയാത്ര ഉയരത്തിലേക്കാകുന്നു;","poem":1},{"text":"കീഴെയുള്ള പാതാളത്തെ അവൻ ഒഴിഞ്ഞുപോകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"അഹങ്കാരിയുടെ വീട് യഹോവ പൊളിച്ചുകളയും;","poem":1},{"text":"വിധവയുടെ അതിര്‍ അവിടുന്ന് ഉറപ്പിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ദുരുപായങ്ങൾ യഹോവയ്ക്ക് വെറുപ്പ്;","poem":1},{"text":"ദയാവാക്കോ നിർമ്മലം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ദുരാഗ്രഹി തന്‍റെ ഭവനത്തെ വലയ്ക്കുന്നു;","poem":1},{"text":"കോഴ വെറുക്കുന്നവൻ ജീവിച്ചിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"നീതിമാൻ മനസ്സിൽ ആലോചിച്ച് ഉത്തരം പറയുന്നു;","poem":1},{"text":"ദുഷ്ടന്മാരുടെ വായ് ദോഷങ്ങൾ വർഷിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"യഹോവ ദുഷ്ടന്മാരോട് അകന്നിരിക്കുന്നു;","poem":1},{"text":"നീതിമാന്മാരുടെ പ്രാർത്ഥനയോ അവൻ കേൾക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"പുഞ്ചിരിക്കുന്ന മുഖം ഹൃദയത്തെ സന്തോഷിപ്പിക്കുന്നു","poem":1},{"noteId":8},{"text":";","poem":1},{"text":"നല്ല വർത്തമാനം ശരീരത്തെ തണുപ്പിക്കുന്നു","poem":2},{"noteId":9},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"ജീവദായകമായ ശാസന കേൾക്കുന്ന ചെവിയുള്ളവൻ","poem":1},{"text":"ജ്ഞാനികളുടെ മദ്ധ്യേ വസിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"പ്രബോധനം ത്യജിക്കുന്നവൻ തന്‍റെ പ്രാണനെ നിരസിക്കുന്നു;","poem":1},{"text":"ശാസന കേട്ടു അനുസരിക്കുന്നവൻ വിവേകം സമ്പാദിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"യഹോവാഭക്തി ജ്ഞാനോപദേശമാകുന്നു;","poem":1},{"text":"മാനത്തിന് വിനയം മുന്നോടിയാകുന്നു.","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"പുഞ്ചിരിക്കുന്ന മുഖം ഹൃദയത്തെ സന്തോഷിപ്പിക്കുന്നു കണ്ണിന്‍റെ ശോഭ ഹൃദയത്തെ സന്തോഷിപ്പിക്കുന്നു","reference":{"chapter":15,"verse":30}},{"noteId":9,"caller":"+","text":"നല്ല വർത്തമാനം ശരീരത്തെ തണുപ്പിക്കുന്നു നല്ല വർത്തമാനം അസ്ഥികളെ തണുപ്പിക്കുന്നു","reference":{"chapter":15,"verse":30}}]},"thisChapterLink":"/api/mal_irv/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}