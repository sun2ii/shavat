{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_irv","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"c9c58506fd1164d7ae2ea4bf69a81027e9aa684781325d6e9d0270e1119f1917","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":16,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"ഹൃദയത്തിലെ നിരൂപണങ്ങൾ മനുഷ്യനുള്ളവ;","poem":1},{"text":"നാവിന്‍റെ ഉത്തരം യഹോവയിൽനിന്ന് വരുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"മനുഷ്യന് തന്‍റെ വഴികളൊക്കെയും നിർമ്മലമായി തോന്നുന്നു;","poem":1},{"text":"യഹോവയോ ആത്മാക്കളെ തൂക്കിനോക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"നിന്‍റെ പ്രവൃത്തികളെ യഹോവയ്ക്കു സമർപ്പിക്കുക;","poem":1},{"text":"എന്നാൽ നിന്‍റെ ഉദ്ദേശ്യങ്ങൾ സാധിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"യഹോവ സകലത്തെയും തന്‍റെ ഉദ്ദേശ്യത്തിനായി ഉണ്ടാക്കിയിരിക്കുന്നു;","poem":1},{"text":"അനർത്ഥദിവസത്തിനായി ദുഷ്ടനെയും സൃഷ്ടിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"നിഗളഹൃദയമുള്ള ഏവനും യഹോവയ്ക്കു വെറുപ്പ്;","poem":1},{"text":"അവന് നിശ്ചയമായും ശിക്ഷ വരാതിരിക്കുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ദയയും വിശ്വസ്തതയുംകൊണ്ട് അകൃത്യം പരിഹരിക്കപ്പെടുന്നു;","poem":1},{"text":"യഹോവാഭക്തികൊണ്ട് മനുഷ്യർ ദോഷം വിട്ടകലുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ഒരുവന്‍റെ വഴികൾ യഹോവയ്ക്കു പ്രസാദകരമായിരിക്കുമ്പോൾ","poem":1},{"text":"അവിടുന്ന് അവന്‍റെ ശത്രുക്കളെപ്പോലും അവനുമായി സമാധാനത്തിലാക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ന്യായരഹിതമായ വലിയ വരവിനെക്കാൾ","poem":1},{"text":"നീതിയോടെയുള്ള അല്പം നല്ലത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"മനുഷ്യന്‍റെ ഹൃദയം തന്‍റെ വഴിയെക്കുറിച്ച് ആലോചിച്ചുറയ്ക്കുന്നു;","poem":1},{"text":"അവന്‍റെ കാലടികളെയോ യഹോവ ക്രമപ്പെടുത്തുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"രാജാവിന്‍റെ അധരങ്ങളിൽ അരുളപ്പാടുണ്ട്;","poem":1},{"text":"ന്യായവിധിയിൽ അവന്‍റെ വായ് തെറ്റിപ്പോകുന്നതുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ശരിയായ അളവുകോലും ത്രാസും യഹോവയ്ക്കുള്ളവ;","poem":1},{"text":"സഞ്ചിയിലെ പടി ഒക്കെയും അവിടുത്തെ പ്രവൃത്തിയാകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ദുഷ്ടത പ്രവർത്തിക്കുന്നത് രാജാക്കന്മാർക്ക് വെറുപ്പ്;","poem":1},{"text":"നീതികൊണ്ടല്ലയോ സിംഹാസനം സ്ഥിരപ്പെടുന്നത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"നീതിയുള്ള അധരങ്ങൾ രാജാക്കന്മാർക്ക് പ്രസാദം;","poem":1},{"text":"സത്യം പറയുന്നവനെ അവർ സ്നേഹിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"രാജാവിന്‍റെ ക്രോധം മരണദൂതന് തുല്യം;","poem":1},{"text":"ജ്ഞാനമുള്ള മനുഷ്യനോ അതിനെ ശമിപ്പിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"രാജാവിന്‍റെ മുഖപ്രകാശത്തിൽ ജീവൻ ഉണ്ട്;","poem":1},{"text":"അവന്‍റെ പ്രസാദം പിന്മഴയ്ക്കുള്ള മേഘംപോലെയാകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"തങ്കത്തെക്കാൾ ജ്ഞാനം സമ്പാദിക്കുന്നത് എത്ര നല്ലത്!","poem":1},{"text":"വെള്ളിയെക്കാൾ വിവേകം സമ്പാദിക്കുന്നത് എത്ര ഉത്തമം!","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ദോഷം വിട്ടുനടക്കുന്നത് നേരുള്ളവരുടെ പെരുവഴി;","poem":1},{"text":"തന്‍റെ വഴി സൂക്ഷിക്കുന്നവൻ തന്‍റെ പ്രാണനെ കാത്തുകൊള്ളുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"നാശത്തിന് മുമ്പ് ഗർവ്വം;","poem":1},{"text":"വീഴ്ചയ്ക്ക് മുമ്പ് ഉന്നതഭാവം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ഗർവ്വികളോടുകൂടെ കവർച്ച പങ്കിടുന്നതിനെക്കാൾ","poem":1},{"text":"താഴ്മയുള്ളവരോടുകൂടി താഴ്മയുള്ളവനായിരിക്കുന്നത് നല്ലത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"തിരുവചനം പ്രമാണിക്കുന്നവൻ നന്മ കണ്ടെത്തും;","poem":1},{"text":"യഹോവയിൽ ആശ്രയിക്കുന്നവൻ ഭാഗ്യവാൻ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ജ്ഞാനഹൃദയൻ വിവേകി എന്നു വിളിക്കപ്പെടും;","poem":1},{"text":"അധരമാധുര്യം വിദ്യയെ വർദ്ധിപ്പിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"വിവേകം വിവേകിക്ക് ജീവന്‍റെ ഉറവാകുന്നു;","poem":1},{"text":"ഭോഷന്മാരുടെ പ്രബോധനമോ ഭോഷത്തം തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ജ്ഞാനിയുടെ ഹൃദയം അവന്‍റെ വായെ പഠിപ്പിക്കുന്നു;","poem":1},{"text":"അവന്‍റെ അധരങ്ങൾക്ക് വിദ്യ വർദ്ധിപ്പിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ഇമ്പമുള്ള വാക്ക് തേൻകട്ടയാകുന്നു;","poem":1},{"text":"മനസ്സിന് മധുരവും അസ്ഥികൾക്ക് ഔഷധവും തന്നെ;","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ചിലപ്പോൾ ഒരു വഴി മനുഷ്യന് ചൊവ്വായി തോന്നുന്നു;","poem":1},{"text":"അതിന്‍റെ അവസാനമോ മരണവഴികൾ അത്രേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"പണിക്കാരന്‍റെ വിശപ്പ് അവനെക്കൊണ്ടു പണി ചെയ്യിക്കുന്നു;","poem":1},{"text":"അവന്‍റെ വായ് അവനെ അതിനായി നിർബ്ബന്ധിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"നിസ്സാരമനുഷ്യൻ ദോഷം എന്ന കുഴികുഴിയ്ക്കുന്നു;","poem":1},{"text":"അവന്‍റെ അധരങ്ങളിൽ കത്തുന്ന തീ ഉണ്ട്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"വക്രതയുള്ള മനുഷ്യൻ വഴക്ക് ഉണ്ടാക്കുന്നു;","poem":1},{"text":"ഏഷണിക്കാരൻ മിത്രങ്ങളെ ഭേദിപ്പിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"സാഹസക്കാരൻ കൂട്ടുകാരനെ വശീകരിക്കുകയും","poem":1},{"text":"കൊള്ളരുതാത്ത വഴിയിൽ നടത്തുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"കണ്ണിറുക്കുന്നവൻ വക്രത നിരൂപിക്കുന്നു;","poem":1},{"text":"വപ്പ് കടിക്കുന്നവൻ ദോഷം ചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"നരച്ച തല ശോഭയുള്ള കിരീടമാകുന്നു;","poem":1},{"text":"നീതിയുടെ മാർഗ്ഗത്തിൽ അതിനെ പ്രാപിക്കാം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"ദീർഘക്ഷമയുള്ളവൻ യുദ്ധവീരനിലും","poem":1},{"text":"മനോനിയന്ത്രണമുള്ളവൻ പട്ടണം പിടിക്കുന്നവനിലും ശ്രേഷ്ഠൻ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"ചീട്ട് മടിയിൽ ഇടുന്നു;","poem":1},{"text":"അതിന്‍റെ തീരുമാനമോ യഹോവയിൽനിന്ന് വരുന്നു.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}