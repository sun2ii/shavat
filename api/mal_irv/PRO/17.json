{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_irv","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"c9c58506fd1164d7ae2ea4bf69a81027e9aa684781325d6e9d0270e1119f1917","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":17,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"കലഹത്തോടുകൂടി ഒരു വീടു നിറയെ യാഗഭോജനത്തിലും","poem":1},{"text":"സ്വസ്ഥതയോടുകൂടി ഒരു കഷണം ഉണങ്ങിയ അപ്പം ഏറ്റവും നല്ലത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"നാണംകെട്ട മകന്‍റെമേൽ ബുദ്ധിമാനായ ദാസൻ ഭരണം നടത്തും;","poem":1},{"text":"സഹോദരന്മാരുടെ ഇടയിൽ അവകാശം പ്രാപിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"വെള്ളിക്ക് പുടവും, പൊന്നിന് മൂശയും;","poem":1},{"text":"ഹൃദയങ്ങളെ ശോധന ചെയ്യുന്നതോ യഹോവ തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ദുഷ്ക്ർമ്മി നീതികെട്ട അധരങ്ങൾക്ക് ശ്രദ്ധകൊടുക്കുന്നു;","poem":1},{"text":"വ്യാജം പറയുന്നവൻ വഷളത്തമുള്ള നാവിന് ചെവികൊടുക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ദരിദ്രനെ പരിഹസിക്കുന്നവൻ അവന്‍റെ സ്രഷ്ടാവിനെ നിന്ദിക്കുന്നു;","poem":1},{"text":"ആപത്തിൽ സന്തോഷിക്കുന്നവന് ശിക്ഷ വരാതിരിക്കുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"മക്കളുടെ മക്കൾ വൃദ്ധന്മാർക്ക് കിരീടമാകുന്നു;","poem":1},{"text":"മക്കളുടെ മഹത്വം അവരുടെ അപ്പന്മാർ തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"സുഭാഷിതം പറയുന്ന അധരം ഭോഷന് യോഗ്യമല്ല;","poem":1},{"text":"വ്യാജമുള്ള അധരം ഒരു പ്രഭുവിന് ഒട്ടും ഉചിതമല്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"സമ്മാനം വാങ്ങുന്നവന് അത് രത്നമായി തോന്നും;","poem":1},{"text":"അവൻ ചെല്ലുന്നേടത്തെല്ലാം കാര്യം സാധിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"സ്നേഹം തേടുന്നവൻ ലംഘനം മറച്ചുവയ്ക്കുന്നു;","poem":1},{"text":"കാര്യം പാട്ടാക്കുന്നവനോ മിത്രങ്ങളെ ഭേദിപ്പിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ഭോഷനെ നൂറ് അടിക്കുന്നതിനെക്കാൾ","poem":1},{"text":"ബുദ്ധിമാനെ ഒന്ന് ശാസിക്കുന്നത് അധികം ഫലിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"മത്സരക്കാരൻ ദോഷം മാത്രം അന്വേഷിക്കുന്നു;","poem":1},{"text":"ക്രൂരനായ ഒരു ദൂതനെ അവന്‍റെനേരെ അയയ്ക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"മൂഢനെ അവന്‍റെ ഭോഷത്തത്തിൽ എതിരിടുന്നതിനെക്കാൾ","poem":1},{"text":"കുട്ടികൾ കാണാതെപോയ കരടിയെ എതിരിടുന്നത് ഭേദം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ഒരുത്തൻ നന്മയ്ക്കു പകരം തിന്മ ചെയ്യുന്നു എങ്കിൽ","poem":1},{"text":"അവന്‍റെ ഭവനത്തെ തിന്മ വിട്ടുമാറുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"കലഹത്തിന്‍റെ ആരംഭം മടവെട്ടി വെള്ളം വിടുന്നതുപോലെ;","poem":1},{"text":"ആകയാൽ കലഹമാകുംമുമ്പ് തർക്കം നിർത്തിക്കളയുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ദുഷ്ടനെ നീതീകരിക്കുന്നവനും നീതിമാനെ കുറ്റം വിധിക്കുന്നവനും","poem":1},{"text":"രണ്ടുപേരും യഹോവയ്ക്ക് വെറുപ്പ്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"മൂഢന് ജ്ഞാനം സമ്പാദിക്കുവാൻ ബുദ്ധിയില്ലാതിരിക്കുമ്പോൾ","poem":1},{"text":"അത് വാങ്ങുവാൻ അവന്‍റെ കയ്യിൽ പണം എന്തിന്?","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"സ്നേഹിതൻ എല്ലാകാലത്തും സ്നേഹിക്കുന്നു;","poem":1},{"text":"അനർത്ഥകാലത്ത് അവൻ സഹോദരനായിത്തീരുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ബുദ്ധിഹീനനായ മനുഷ്യൻ കയ്യടിച്ച്","poem":1},{"text":"കൂട്ടുകാരനു വേണ്ടി ജാമ്യം നില്ക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"കലഹപ്രിയൻ ലംഘനപ്രിയൻ ആകുന്നു;","poem":1},{"text":"അഹങ്കരാത്തോടെ സംസാരിക്കുന്നവന്‍ നാശം ഇച്ഛിക്കുന്നു","poem":2},{"noteId":10},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"വക്രഹൃദയമുള്ളവൻ നന്മ കാണുകയില്ല;","poem":1},{"text":"വികടനാവുള്ളവൻ ആപത്തിൽ അകപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ഭോഷനെ ജനിപ്പിച്ചവന് അത് ഖേദകാരണമാകും;","poem":1},{"text":"മൂഢന്‍റെ അപ്പന് സന്തോഷം ഉണ്ടാകുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"സന്തുഷ്ടഹൃദയം നല്ലൊരു ഔഷധമാകുന്നു;","poem":1},{"text":"തകർന്ന മനസ്സോ അസ്ഥികളെ ഉണക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ദുഷ്ടൻ ന്യായത്തിന്‍റെ വഴികളെ മറിക്കേണ്ടതിന്","poem":1},{"text":"ഒളിച്ചുകൊണ്ടുവരുന്ന സമ്മാനം വാങ്ങുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ജ്ഞാനം ബുദ്ധിമാന്‍റെ മുമ്പിൽ ഇരിക്കുന്നു;","poem":1},{"text":"മൂഢന്‍റെ കണ്ണോ ഭൂമിയുടെ അറുതികളിലേക്ക് നോക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"മൂഢനായ മകൻ അപ്പന് വ്യസനവും, തന്നെ","poem":1},{"text":"പ്രസവിച്ചവൾക്ക് കയ്പും ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"നീതിമാന് പിഴ കല്പിക്കുന്നതും","poem":1},{"text":"ശ്രേഷ്ഠന്മാരെ സത്യസന്ധത നിമിത്തം അടിക്കുന്നതും നല്ലതല്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"വാക്ക് അടക്കിവക്കുന്നവൻ പരിജ്ഞാനമുള്ളവൻ;","poem":1},{"text":"ശാന്തമാനസൻ ബുദ്ധിമാൻ തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"മിണ്ടാതിരുന്നാൽ ഭോഷനെപ്പോലും ജ്ഞാനിയായും","poem":1},{"text":"നാവടക്കിയാൽ വിവേകിയായും എണ്ണും.","poem":2}]}],"footnotes":[{"noteId":10,"caller":"+","text":"അഹങ്കരാത്തോടെ സംസാരിക്കുന്നവന്‍ നാശം ഇച്ഛിക്കുന്നു പടിവാതിൽ ഉയർത്തിപ്പണിയുന്നവൻ നാശം ഇച്ഛിക്കുന്നു","reference":{"chapter":17,"verse":19}}]},"thisChapterLink":"/api/mal_irv/PRO/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PRO/16.json","previousChapterAudioLinks":{},"numberOfVerses":28}