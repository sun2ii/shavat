{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_irv","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"c9c58506fd1164d7ae2ea4bf69a81027e9aa684781325d6e9d0270e1119f1917","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":2,"content":[{"type":"heading","content":["ജ്ഞാനത്തിന്‍റെ പ്രതിഫലം"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"മകനേ, ജ്ഞാനത്തിന് ചെവികൊടുക്കുകയും","poem":1},{"text":"ബോധത്തിന് നിന്‍റെ ഹൃദയം ചായിക്കുകയും ചെയ്യേണ്ടതിന്","poem":2}]},{"type":"verse","number":2,"content":[{"text":"എന്‍റെ വചനങ്ങളെ കൈക്കൊണ്ട്","poem":1},{"text":"എന്‍റെ കല്പനകളെ നിന്‍റെ ഉള്ളിൽ സംഗ്രഹിച്ചാൽ,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"നീ ബോധത്തിനായി വിളിച്ച്","poem":1},{"text":"വിവേകത്തിനായി ശബ്ദം ഉയർത്തുന്നു എങ്കിൽ,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അതിനെ വെള്ളിയെപ്പോലെ അന്വേഷിച്ച്","poem":1},{"text":"നിക്ഷേപങ്ങളെപ്പോലെ തിരയുന്നു എങ്കിൽ,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"നീ യഹോവാഭക്തി ഗ്രഹിക്കുകയും","poem":1},{"text":"ദൈവപരിജ്ഞാനം കണ്ടെത്തുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"യഹോവയല്ലയോ ജ്ഞാനം നല്കുന്നത്;","poem":1},{"text":"അവന്‍റെ വായിൽനിന്ന് പരിജ്ഞാനവും വിവേകവും വരുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവൻ നേരുള്ളവർക്ക് രക്ഷ സംഗ്രഹിച്ചു വയ്ക്കുന്നു:","poem":1},{"text":"നിഷ്കളങ്കമായി നടക്കുന്നവർക്ക് അവൻ ഒരു പരിച തന്നെ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവൻ ന്യായത്തിന്‍റെ പാതകളെ കാക്കുന്നു;","poem":1},{"text":"തന്‍റെ വിശുദ്ധന്മാരുടെ വഴിയെ സൂക്ഷിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"അങ്ങനെ നീ നീതിയും ന്യായവും സത്യവും","poem":1},{"text":"സകലസന്മാർഗ്ഗവും ഗ്രഹിക്കും.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ജ്ഞാനം നിന്‍റെ ഹൃദയത്തിൽ പ്രവേശിക്കും;","poem":1},{"text":"പരിജ്ഞാനം നിന്‍റെ മനസ്സിന് ഇമ്പമായിരിക്കും.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"വകതിരിവ് നിന്നെ കാക്കും;","poem":1},{"text":"വിവേകം നിന്നെ സൂക്ഷിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"അത് നിന്നെ ദുഷ്ടന്‍റെ വഴിയിൽനിന്നും","poem":1},{"text":"വക്രത പറയുന്നവരുടെ കൂട്ടത്തിൽനിന്നും വിടുവിക്കും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അവർ ഇരുട്ടുള്ള വഴികളിൽ നടക്കേണ്ടതിന്","poem":1},{"text":"നേരെയുള്ള പാത വിട്ടുകളയുകയും","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ദോഷപ്രവൃത്തിയിൽ സന്തോഷിക്കുകയും","poem":1},{"text":"ദുഷ്ടന്‍റെ വക്രതയിൽ ആനന്ദിക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവർ വളഞ്ഞവഴിക്ക് പോകുന്നവരും","poem":1},{"text":"നേരെയല്ലാത്ത പാതയിൽ നടക്കുന്നവരും ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"അത് നിന്നെ പരസ്ത്രീയുടെ കയ്യിൽനിന്നും","poem":1},{"text":"ചക്കരവാക്ക് പറയുന്ന അന്യസ്ത്രീയുടെ വശത്തുനിന്നും വിടുവിക്കും.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവൾ തന്‍റെ യൗവനകാന്തനെ ഉപേക്ഷിച്ച്","poem":1},{"text":"തന്‍റെ ദൈവത്തിന്‍റെ നിയമം മറന്നുകളഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അവളുടെ വീട് മരണത്തിലേക്കും","poem":1},{"text":"അവളുടെ പാതകൾ മരിച്ചവരുടെ അടുക്കലേക്കും ചാഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അവളുടെ അടുക്കൽ ചെല്ലുന്ന ഒരുത്തനും മടങ്ങിവരുന്നില്ല;","poem":1},{"text":"ജീവന്‍റെ പാതകളെ പ്രാപിക്കുന്നതുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"അതുകൊണ്ട് നീ സജ്ജനത്തിന്‍റെ വഴിയിൽ നടന്ന്","poem":1},{"text":"നീതിമാന്മാരുടെ പാതകളെ പ്രമാണിച്ചുകൊള്ളുക.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"നേരുള്ളവർ ദേശത്ത് വസിക്കും;","poem":1},{"text":"നിഷ്കളങ്കന്മാർ അതിൽ ശേഷിച്ചിരിക്കും.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"എന്നാൽ ദുഷ്ടന്മാർ ദേശത്തുനിന്ന് ഛേദിക്കപ്പെടും;","poem":1},{"text":"ദ്രോഹികൾ അതിൽനിന്ന് നിർമ്മൂലമാകും.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}