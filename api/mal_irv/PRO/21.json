{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_irv","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"c9c58506fd1164d7ae2ea4bf69a81027e9aa684781325d6e9d0270e1119f1917","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":21,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"രാജാവിന്‍റെ ഹൃദയം യഹോവയുടെ കയ്യിൽ നീർത്തോട് പോലെ ഇരിക്കുന്നു;","poem":1},{"text":"തനിക്കു ഇഷ്ടമുള്ളേടത്തേക്കൊക്കെയും അവിടുന്ന് അതിനെ തിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"മനുഷ്യന്‍റെ വഴി ഒക്കെയും അവന് ചൊവ്വായിത്തോന്നുന്നു;","poem":1},{"text":"യഹോവയോ ഹൃദയങ്ങളെ തൂക്കിനോക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"നീതിയും ന്യായവും പ്രവർത്തിക്കുന്നത്","poem":1},{"text":"യഹോവയ്ക്ക് ഹനനയാഗത്തെക്കാൾ സ്വീകാര്യം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ഗർവ്വമുള്ള കണ്ണും അഹങ്കാരഹൃദയവും","poem":1},{"text":"ദുഷ്ടന്മാരുടെ ദീപവും പാപം തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ഉത്സാഹിയുടെ വിചാരങ്ങൾ സമൃദ്ധിയിലേക്കു നയിക്കുന്നു;","poem":1},{"text":"തിടുക്കം കൂട്ടുന്നവരൊക്കെയും ദാരിദ്ര്യത്തിലേക്കു പോകുവാൻ ബദ്ധപ്പെടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"കള്ളനാവുകൊണ്ട് ധനം സമ്പാദിക്കുന്നത് പാറിപ്പോകുന്ന ആവിയാകുന്നു;","poem":1},{"text":"അതിനെ അന്വേഷിക്കുന്നവർ മരണത്തെ അന്വേഷിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ദുഷ്ടന്മാരുടെ അതിക്രമം അവർക്ക് നാശകാരണമാകുന്നു;","poem":1},{"text":"ന്യായം ചെയ്യുവാൻ അവർക്ക് മനസ്സില്ലല്ലോ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"അകൃത്യഭാരം ചുമക്കുന്നവന്‍റെ വഴി വളഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"നിർമ്മലന്‍റെ പ്രവൃത്തിയോ ചൊവ്വുള്ളത് തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ശണ്ഠകൂടുന്ന സ്ത്രീയോടുകൂടി വീടിനുള്ളിൽ പാർക്കുന്നതിനെക്കാൾ","poem":1},{"text":"മേൽപുരയുടെ ഒരു കോണിൽ പാർക്കുന്നത് നല്ലത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ദുഷ്ടന്‍റെ മനസ്സ് ദോഷത്തെ ആഗ്രഹിക്കുന്നു;","poem":1},{"text":"അവന് കൂട്ടുകാരനോട് ദയ തോന്നുന്നതുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"പരിഹാസിയെ ശിക്ഷിച്ചാൽ അല്പബുദ്ധി ജ്ഞാനിയായിത്തീരും;","poem":1},{"text":"ജ്ഞാനിയെ ഉപദേശിച്ചാൽ അവൻ പരിജ്ഞാനം പ്രാപിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"നീതിമാനായ ദൈവം ദുഷ്ടന്‍റെ ഭവനത്തിന്മേൽ ദൃഷ്ടിവക്കുന്നു;","poem":1},{"text":"ദുഷ്ടന്മാരെ നാശത്തിലേക്ക് മറിച്ചുകളയുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"എളിയവന്‍റെ നിലവിളിക്ക് ചെവി പൊത്തിക്കളയുന്നവൻ","poem":1},{"text":"വിളിച്ചപേക്ഷിക്കുമ്പോൾ തനിക്കും ഉത്തരം ലഭിക്കുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"രഹസ്യത്തിൽ കൊടുക്കുന്ന സമ്മാനം കോപത്തെയും","poem":1},{"text":"മടിയിൽ കൊണ്ടുവരുന്ന കോഴ ഉഗ്രകോപത്തെയും ശമിപ്പിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ന്യായം പ്രവർത്തിക്കുന്നത് നീതിമാന് സന്തോഷവും","poem":1},{"text":"ദുഷ്പ്രവൃത്തിക്കാർക്ക് ഭയങ്കരവും ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"വിവേകമാർഗ്ഗം വിട്ടുനടക്കുന്നവൻ","poem":1},{"text":"മൃതന്മാരുടെ കൂട്ടത്തിൽ വിശ്രമിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ഉല്ലാസപ്രിയൻ ദരിദ്രനായിത്തീരും;","poem":1},{"text":"വീഞ്ഞും തൈലവും പ്രിയപ്പെടുന്നവൻ ധനവാനാകുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ദുഷ്ടൻ നീതിമാന് മറുവിലയാകും;","poem":1},{"text":"അവിശ്വസ്തൻ നേരുള്ളവർക്ക് പകരമായിത്തീരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ശണ്ഠയും ദുശ്ശീലവുമുള്ള സ്ത്രീയോടുകൂടി പാർക്കുന്നതിലും","poem":1},{"text":"നിർജ്ജനപ്രദേശത്ത് പോയി പാർക്കുന്നത് നല്ലത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ജ്ഞാനിയുടെ പാർപ്പിടത്തിൽ വിലയേറിയ നിക്ഷേപവും തൈലവും ഉണ്ട്;","poem":1},{"text":"മൂഢൻ അവയെ ദുരുപയോഗം ചെയ്തുകളയുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"നീതിയും ദയയും പിന്തുടരുന്നവൻ","poem":1},{"text":"ജീവനും നീതിയും മാനവും കണ്ടെത്തും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ജ്ഞാനി വീരന്മാരുടെ പട്ടണത്തിൽ കയറുകയും","poem":1},{"text":"അതിന്‍റെ ആശ്രയമായ കോട്ട ഇടിച്ചുകളയുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"വായും നാവും സൂക്ഷിക്കുന്നവൻ","poem":1},{"text":"തന്‍റെ പ്രാണനെ കഷ്ടങ്ങളിൽനിന്ന് സൂക്ഷിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"നിഗളവും ഗർവ്വവും ഉള്ളവന് പരിഹാസി എന്നു പേരാകുന്നു;","poem":1},{"text":"അവൻ ഗർവ്വത്തിന്‍റെ അഹങ്കാരത്തോടെ പ്രവർത്തിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"മടിയന്‍റെ കൊതി അവന് മരണകാരണം;","poem":1},{"text":"വേലചെയ്യുവാൻ അവന്‍റെ കൈകൾ മടിക്കുന്നുവല്ലോ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ചിലർ നിത്യവും അത്യാഗ്രഹത്തോടെ ഇരിക്കുന്നു;","poem":1},{"text":"എന്നാൽ നീതിമാൻ ലോഭിക്കാതെ കൊടുത്തുകൊണ്ടിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ദുഷ്ടന്മാരുടെ യാഗം വെറുപ്പാകുന്നു;","poem":1},{"text":"അവൻ ദുഷ്ടതാത്പര്യത്തോടെ അത് അർപ്പിച്ചാൽ എത്ര അധികം!","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"കള്ളസ്സാക്ഷി നശിച്ചുപോകും;","poem":1},{"text":"ശ്രദ്ധിച്ചുകേൾക്കുന്നവന് എപ്പോഴും സംസാരിക്കാം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ദുഷ്ടൻ മുഖധാർഷ്ട്യം കാണിക്കുന്നു;","poem":1},{"text":"നേരുള്ളവൻ തന്‍റെ വഴി നന്നാക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"യഹോവയ്ക്കെതിരെ ജ്ഞാനവുമില്ല,","poem":1},{"text":"ബുദ്ധിയുമില്ല, ആലോചനയുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"കുതിരയെ യുദ്ധദിവസത്തേക്ക് ചമയിക്കുന്നു;","poem":1},{"text":"ജയം യഹോവയിൽനിന്ന് വരുന്നു.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}