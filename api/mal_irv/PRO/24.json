{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_irv","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"c9c58506fd1164d7ae2ea4bf69a81027e9aa684781325d6e9d0270e1119f1917","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":24,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"ദുഷ്ടന്മാരോട് അസൂയപ്പെടരുത്;","poem":1},{"text":"അവരോടുകൂടി ഇരിക്കുവാൻ ആഗ്രഹിക്കുകയുമരുത്.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവരുടെ ഹൃദയം അക്രമം മെനയുന്നു;","poem":1},{"text":"കലഹം ഉണ്ടാക്കുവാൻ അവരുടെ അധരങ്ങൾ ഉപയോഗിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ജ്ഞാനംകൊണ്ട് ഭവനം പണിയുന്നു;","poem":1},{"text":"വിവേകംകൊണ്ട് അത് സ്ഥിരമായിവരുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"പരിജ്ഞാനംകൊണ്ട് അതിന്‍റെ മുറികളിൽ","poem":1},{"text":"വിലയേറിയതും മനോഹരവുമായ സകലസമ്പത്തും നിറഞ്ഞുവരുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ജ്ഞാനിയായ പുരുഷൻ ബലവാനാകുന്നു;","poem":1},{"text":"പരിജ്ഞാനമുള്ളവൻ ബലം വർദ്ധിപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ബുദ്ധിയുള്ള ആലോചനയാൽ നീ യുദ്ധം നടത്തി ജയിക്കും;","poem":1},{"text":"മന്ത്രിമാരുടെ ബഹുത്വത്തിൽ രക്ഷയുണ്ട്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ജ്ഞാനം ഭോഷന് അപ്രാപ്യമായിരിക്കുന്നു;","poem":1},{"text":"അവൻ പട്ടണവാതില്‍ക്കൽ വായ് തുറക്കുന്നില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ദോഷം ചെയ്യുവാൻ നിരൂപിക്കുന്നവനെ","poem":1},{"text":"ദുഷ്ക്കർമ്മി എന്നു പറഞ്ഞുവരുന്നു;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഭോഷന്‍റെ നിരൂപണം പാപം തന്നെ;","poem":1},{"text":"പരിഹാസി മനുഷ്യർക്ക് വെറുപ്പാകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"കഷ്ടകാലത്ത് നീ പതറിപ്പോയാൽ","poem":1},{"text":"നിന്‍റെ ബലം കുറഞ്ഞുപോകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"മരണത്തിന് കൊണ്ടുപോകുന്നവരെ വിടുവിക്കുക;","poem":1},{"text":"കൊലക്കളത്തിലേക്ക് വിറച്ച് ചെല്ലുന്നവരെ രക്ഷിക്കുവാൻ ശ്രമിക്കുക.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“ഞങ്ങൾ അറിഞ്ഞില്ലല്ലോ” എന്നു നീ പറഞ്ഞാൽ","poem":1},{"text":"ഹൃദയങ്ങളെ തൂക്കിനോക്കുന്നവൻ ഗ്രഹിക്കുകയില്ലയോ?","poem":2},{"text":"നിന്‍റെ പ്രാണനെ കാക്കുന്നവൻ അറിയുകയില്ലയോ?","poem":1},{"text":"അവിടുന്ന് മനുഷ്യന് പ്രവൃത്തിക്ക് തക്കവണ്ണം പകരം കൊടുക്കുകയില്ലയോ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"മകനേ, തേൻ തിന്നുക; അത് നല്ലതല്ലോ;","poem":1},{"text":"തേങ്കട്ട നിന്‍റെ അണ്ണാക്കിന് മധുരമത്രേ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ജ്ഞാനവും നിന്‍റെ ഹൃദയത്തിന് അങ്ങനെ തന്നെ എന്നറിയുക;","poem":1},{"text":"നീ അത് പ്രാപിച്ചാൽ പ്രതിഫലം ഉണ്ടാകും;","poem":2},{"lineBreak":true},{"text":"നിന്‍റെ പ്രത്യാശക്ക് ഭംഗം വരികയുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ദുഷ്ടാ, നീ നീതിമാന്‍റെ പാർപ്പിടത്തിന് പതിയിരിക്കരുത്;","poem":1},{"text":"അവന്‍റെ വിശ്രാമസ്ഥലത്തെ നശിപ്പിക്കുകയുമരുത്.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"നീതിമാൻ ഏഴു പ്രാവശ്യം വീണാലും എഴുന്നേല്‍ക്കും;","poem":1},{"text":"ദുഷ്ടന്മാരോ അനർത്ഥത്തിൽ നശിച്ചുപോകും.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"നിന്‍റെ ശത്രു വീഴുമ്പോൾ സന്തോഷിക്കരുത്;","poem":1},{"text":"അവൻ ഇടറുമ്പോൾ നിന്‍റെ ഹൃദയം ആനന്ദിക്കരുത്.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"യഹോവ കണ്ടിട്ട് അവിടുത്തേയ്ക്ക് ഇഷ്ടക്കേടാകുവാനും","poem":1},{"text":"തന്‍റെ കോപം അവങ്കൽനിന്ന് മാറ്റിക്കളയുവാനും മതി.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ദുഷ്പ്രവൃത്തിക്കാർനിമിത്തം മുഷിയരുത്;","poem":1},{"text":"ദുഷ്ടന്മാരോട് അസൂയപ്പെടുകയും അരുത്.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ദോഷിക്ക് പ്രതിഫലമുണ്ടാകുകയില്ല;","poem":1},{"text":"ദുഷ്ടന്‍റെ വിളക്ക് കെട്ടുപോകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"മകനേ, യഹോവയെയും രാജാവിനെയും ഭയപ്പെടുക;","poem":1},{"text":"മത്സരികളോട് ഇടപെടരുത്.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"അവരിൽനിന്ന് ആപത്ത് പെട്ടെന്ന് വരും;","poem":1},{"text":"രണ്ടു കൂട്ടരും വരുന്ന നാശം ആരറിയുന്നു?","poem":2},{"noteId":12}]},{"type":"heading","content":["ജ്ഞാനിയുടെ വാക്യങ്ങൾ തുടരുന്നു"]},{"type":"verse","number":23,"content":["ഇവയും ജ്ഞാനികളുടെ വാക്യങ്ങൾ.",{"lineBreak":true},{"text":"ന്യായവിസ്താരത്തിൽ മുഖപക്ഷം നന്നല്ല.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ദുഷ്ടനോട് “നീ നീതിമാൻ” എന്നു പറയുന്നവനെ","poem":1},{"text":"ജനതകൾ ശപിക്കുകയും വംശങ്ങൾ വെറുക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"അവനെ ശാസിക്കുന്നവർക്ക് നന്മ ഉണ്ടാകും;","poem":1},{"text":"വലിയ അനുഗ്രഹം അവരുടെ മേൽ വരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"നേരുള്ള ഉത്തരം പറയുന്നവൻ","poem":1},{"text":"അധരങ്ങളെ ചുംബനം ചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"വെളിയിൽ നിന്‍റെ വേല ചെയ്യുക; വയലിൽ എല്ലാം തീർക്കുക;","poem":1},{"text":"പിന്നീട് നിന്‍റെ വീട് പണിയുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"കാരണംകൂടാതെ കൂട്ടുകാരന് വിരോധമായി സാക്ഷിനില്‍ക്കരുത്;","poem":1},{"text":"നിന്‍റെ അധരം കൊണ്ടു ചതിക്കുകയും അരുത്.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“അവൻ എന്നോട് ചെയ്തതുപോലെ ഞാൻ അവനോട് ചെയ്യുമെന്നും","poem":1},{"text":"ഞാൻ അവന് അവന്‍റെ പ്രവൃത്തിക്ക് പകരം കൊടുക്കും” എന്നും നീ പറയരുത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"ഞാൻ മടിയന്‍റെ നിലത്തിനരികിലും","poem":1},{"text":"ബുദ്ധിഹീനന്‍റെ മുന്തിരിത്തോട്ടത്തിന് സമീപത്തും കൂടി പോയി","poem":2}]},{"type":"verse","number":31,"content":[{"text":"അവിടെ മുള്ള് പടർന്നുപിടിച്ചിരിക്കുന്നതും","poem":1},{"text":"കള നിറഞ്ഞ് നിലം മൂടിയിരിക്കുന്നതും","poem":2},{"lineBreak":true},{"text":"അതിന്‍റെ കന്മതിൽ ഇടിഞ്ഞുകിടക്കുന്നതും കണ്ടു.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ഞാൻ അത് നോക്കി വിചാരിക്കുകയും","poem":1},{"text":"അത് കണ്ടു ഉപദേശം പ്രാപിക്കുകയും ചെയ്തു.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"കുറെക്കൂടെ ഉറക്കം, കുറെക്കൂടെ നിദ്ര,","poem":1},{"text":"കുറെക്കൂടെ കൈകെട്ടി കിടപ്പ്.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"അങ്ങനെ നിന്‍റെ ദാരിദ്ര്യം വഴിപോക്കനെപ്പോലെയും","poem":1},{"text":"നിന്‍റെ ബുദ്ധിമുട്ട് ആയുധപാണിയെപ്പോലെയും വരും.","poem":2}]}],"footnotes":[{"noteId":12,"caller":"+","text":"രണ്ടു കൂട്ടരും എന്നത് യഹോവയും രാജാവും","reference":{"chapter":24,"verse":22}}]},"thisChapterLink":"/api/mal_irv/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}