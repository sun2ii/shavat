{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_irv","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"c9c58506fd1164d7ae2ea4bf69a81027e9aa684781325d6e9d0270e1119f1917","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":25,"content":[{"type":"heading","content":["ശലോമോന്‍റെ സദൃശവാക്യങ്ങൾ"]},{"type":"verse","number":1,"content":["യെഹൂദാ രാജാവായ ഹിസ്ക്കീയാവിന്‍റെ ആളുകൾ ശേഖരിച്ച ശലോമോന്‍റെ മറ്റുള്ള സദൃശവാക്യങ്ങൾ:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"കാര്യം മറച്ചുവയ്ക്കുന്നത് ദൈവത്തിന്‍റെ മഹത്വം;","poem":1},{"text":"കാര്യം ആരായുന്നതോ രാജാക്കന്മാരുടെ മഹത്വം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ആകാശത്തിന്‍റെ ഉയരവും ഭൂമിയുടെ ആഴവും","poem":1},{"text":"രാജാക്കന്മാരുടെ ഹൃദയവും അജ്ഞാതം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"വെള്ളിയിൽനിന്ന് മാലിന്യം നീക്കിക്കളഞ്ഞാൽ","poem":1},{"text":"തട്ടാന് പണിത്തരം കിട്ടും.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"രാജസന്നിധിയിൽനിന്ന് ദുഷ്ടനെ നീക്കിക്കളഞ്ഞാൽ","poem":1},{"text":"അവന്‍റെ സിംഹാസനം നീതിയാൽ സ്ഥിരപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"രാജസന്നിധിയിൽ നിന്നെത്തന്നെ പുകഴ്ത്തരുത്;","poem":1},{"text":"മഹാന്മാരുടെ സ്ഥാനത്ത് നില്‍ക്കുകയും അരുത്.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"പ്രഭുവിന്‍റെ സന്നിധിയിൽ നീ താഴ്ത്തപ്പെടുന്നതിനെക്കാൾ","poem":1},{"text":"“ഇവിടെ കയറിവരുക” എന്നു അവൻ നിന്നോട് പറയുന്നത് നല്ലത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ബദ്ധപ്പെട്ട് വ്യവഹാരത്തിന് പുറപ്പെടരുത്;","poem":1},{"text":"അല്ലെങ്കിൽ ഒടുവിൽ കൂട്ടുകാരൻ നിന്നെ ലജ്ജിപ്പിച്ചാൽ നീ എന്ത് ചെയ്യും?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"നിന്‍റെ വഴക്ക് കൂട്ടുകാരനുമായി പറഞ്ഞു തീർക്കുക;","poem":1},{"text":"എന്നാൽ മറ്റൊരുത്തന്‍റെ രഹസ്യം വെളിപ്പെടുത്തരുത്.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"കേൾക്കുന്നവൻ നിന്നെ നിന്ദിക്കുവാനും","poem":1},{"text":"നിനക്കു തീരാത്ത അപമാനം വരുവാനും ഇടവരരുത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"തക്കസമയത്ത് പറയുന്ന വാക്ക്","poem":1},{"text":"വെള്ളിത്താലത്തിൽ പൊൻനാരങ്ങാ പോലെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"കേട്ടനുസരിക്കുന്ന കാതിന് ജ്ഞാനിയുടെ ശാസന","poem":1},{"text":"പൊൻകടുക്കനും തങ്കംകൊണ്ടുള്ള ആഭരണവും ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"വിശ്വസ്തനായ ദൂതൻ തന്നെ അയക്കുന്നവർക്ക്","poem":1},{"text":"കൊയ്ത്തുകാലത്ത്","poem":2},{"noteId":13},{"text":"ഹിമത്തിന്‍റെ തണുപ്പുപോലെ;","poem":2},{"lineBreak":true},{"text":"അവൻ യജമാനന്മാരുടെ ഉള്ളം തണുപ്പിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ദാനങ്ങളെച്ചൊല്ലി വെറുതെ പ്രശംസിക്കുന്നവൻ","poem":1},{"text":"മഴയില്ലാത്ത മേഘവും കാറ്റുംപോലെയാകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ദീർഘക്ഷമകൊണ്ട് ന്യായാധിപനെ സമ്മതിപ്പിക്കാം;","poem":1},{"text":"മൃദുവായുള്ള നാവ് അസ്ഥിയെ നുറുക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"നിനക്കു തേൻ കിട്ടിയാൽ വേണ്ടുന്നതേ ഭക്ഷിക്കാവൂ;","poem":1},{"text":"അധികം ഭക്ഷിച്ചിട്ട് ഛർദ്ദിക്കുവാൻ ഇടവരരുത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"കൂട്ടുകാരൻ നിന്നെക്കൊണ്ട് മടുത്ത് നിന്നെ വെറുക്കാതെയിരിക്കേണ്ടതിന്","poem":1},{"text":"അവന്‍റെ വീട്ടിൽ കൂടെക്കൂടെ ചെല്ലരുത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"കൂട്ടുകാരന് വിരോധമായി കള്ളസ്സാക്ഷ്യം പറയുന്ന മനുഷ്യൻ","poem":1},{"text":"ഗദയും വാളും കൂർത്ത അമ്പും ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"കഷ്ടകാലത്ത് അവിശ്വസ്തനെ ആശ്രയിക്കുന്നത്","poem":1},{"text":"കേടുള്ള പല്ലും ഉളുക്കിയ കാലുംപോലെ ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"വിഷാദമുള്ള ഹൃദയത്തിനായി പാട്ടു പാടുന്നവൻ","poem":1},{"text":"ശീതകാലത്ത് വസ്ത്രം കളയുന്നതുപോലെയും","poem":2},{"lineBreak":true},{"text":"മുറിവിന്മേല്‍ ചൊറുക്ക പകരുന്നതുപോലെയും ആകുന്നു","poem":2},{"noteId":14},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ശത്രുവിന് വിശക്കുന്നു എങ്കിൽ അവന് ഭക്ഷിക്കുവാൻ കൊടുക്കുക;","poem":1},{"text":"ദാഹിക്കുന്നു എങ്കിൽ കുടിക്കുവാൻ കൊടുക്കുക.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"അങ്ങനെ ചെയ്യുന്നതുകൊണ്ടു നീ അവനെ നാണം കെടുത്തും","poem":1},{"noteId":15},{"text":";","poem":1},{"text":"യഹോവ നിനക്കു പ്രതിഫലം നല്കുകയും ചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"വടക്കൻ കാറ്റ് മഴ കൊണ്ടുവരുന്നു;","poem":1},{"text":"ഏഷണിവാക്ക് കോപഭാവം ജനിപ്പിക്കുന്നു;","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ശണ്ഠകൂടുന്ന സ്ത്രീയോടുകൂടി വീടിനുള്ളിൽ പാർക്കുന്നതിനെക്കാൾ","poem":1},{"text":"മേൽപുരയുടെ ഒരു കോണിൽ പാർക്കുന്നത് നല്ലത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ദാഹമുള്ളവന് തണ്ണീർ കിട്ടുന്നതും","poem":1},{"text":"ദൂരദേശത്തുനിന്ന് നല്ല വർത്തമാനം വരുന്നതും ഒരുപോലെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ദുഷ്ടന്‍റെ മുമ്പിൽ കുലുങ്ങിപ്പോയ നീതിമാൻ","poem":1},{"text":"കലങ്ങിയ കിണറിനും മലിനമായ നീരുറവിനും സമം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"തേൻ ഏറെ കുടിക്കുന്നത് നല്ലതല്ല;","poem":1},{"text":"സ്വന്തം മഹത്വം ആരായുന്നത് അതുപോലെ തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ആത്മസംയമനം ഇല്ലാത്ത പുരുഷൻ","poem":1},{"text":"മതിൽ ഇല്ലാതെ ഇടിഞ്ഞുകിടക്കുന്ന പട്ടണംപോലെയാകുന്നു.","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"കൊയ്ത്തുകാലത്ത് വേനല്ക്കാലത്ത്","reference":{"chapter":25,"verse":13}},{"noteId":14,"caller":"+","text":"മുറിവിന്മേല്‍ ചൊറുക്ക പകരുന്നതുപോലെയും ആകുന്നു മുറിവിന്മേല്‍ യവക്ഷാരം പകരുന്നതുപോലെയും ആകുന്നു","reference":{"chapter":25,"verse":20}},{"noteId":15,"caller":"+","text":"അങ്ങനെ ചെയ്യുന്നതുകൊണ്ടു നീ അവനെ നാണം കെടുത്തും അങ്ങനെ നീ അവന്‍റെ തലമേൽ തീക്കനൽ കൂട്ടും","reference":{"chapter":25,"verse":22}}]},"thisChapterLink":"/api/mal_irv/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":28}