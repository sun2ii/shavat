{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_irv","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"c9c58506fd1164d7ae2ea4bf69a81027e9aa684781325d6e9d0270e1119f1917","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":27,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"നാളെയെച്ചൊല്ലി പ്രശംസിക്കരുത്;","poem":1},{"text":"ഒരു ദിവസത്തിൽ എന്തെല്ലാം സംഭവിക്കും എന്നു അറിയുന്നില്ലല്ലോ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"നിന്‍റെ വായല്ല മറ്റൊരുത്തൻ,","poem":1},{"text":"നിന്‍റെ അധരമല്ല വേറൊരുത്തൻ നിന്നെ സ്തുതിക്കട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"കല്ല് ഘനമുള്ളതും മണൽ ഭാരമുള്ളതും ആകുന്നു;","poem":1},{"text":"ഒരു ഭോഷന്‍റെ നീരസം ഇവ രണ്ടിലും ഘനമേറിയത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ക്രോധം ക്രൂരവും കോപം പ്രളയവും ആകുന്നു;","poem":1},{"text":"ജാരശങ്കയുടെ മുമ്പിൽ ആർക്ക് നില്ക്കാം?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"മറഞ്ഞിരിക്കുന്ന സ്നേഹത്തിലും","poem":1},{"text":"തുറന്ന ശാസനയാണ് നല്ലത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"സ്നേഹിതൻ വരുത്തുന്ന മുറിവുകൾ വിശ്വസ്തതയുടെ ഫലം;","poem":1},{"text":"ശത്രുവിന്‍റെ ചുംബനങ്ങൾ കണക്കിലധികം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"തിന്ന് തൃപ്തനായവൻ തേൻകട്ടയും ചവിട്ടിക്കളയുന്നു;","poem":1},{"text":"വിശപ്പുള്ളവന് കൈപ്പുള്ളതൊക്കെയും മധുരം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"കൂടുവിട്ടലയുന്ന പക്ഷിയും","poem":1},{"text":"നാടു വിട്ടുഴലുന്ന മനുഷ്യനും ഒരുപോലെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"തൈലവും ധൂപവും ഹൃദയത്തെ സന്തോഷിപ്പിക്കുന്നു;","poem":1},{"text":"സ്നേഹിതന്‍റെ ഹൃദയപൂർവ്വമായ ഉപദേശവും അങ്ങനെ തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"നിന്‍റെ സ്നേഹിതനെയും","poem":1},{"text":"അപ്പന്‍റെ സ്നേഹിതനെയും ഉപേക്ഷിക്കരുത്;","poem":2},{"text":"നിന്‍റെ കഷ്ടകാലത്ത് സഹോദരന്‍റെ വീട്ടിൽ പോകുകയും അരുത്;","poem":1},{"text":"ദൂരത്തെ സഹോദരനിലും സമീപത്തെ അയല്ക്കാരൻ നല്ലത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"മകനേ, എന്നെ നിന്ദിക്കുന്നവനോട് ഞാൻ ഉത്തരം പറയേണ്ടതിന്","poem":1},{"text":"നീ ജ്ഞാനിയായി എന്‍റെ ഹൃദയത്തെ സന്തോഷിപ്പിക്കുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"വിവേകമുള്ളവൻ അനർത്ഥം കണ്ടു ഒളിച്ചുകൊള്ളുന്നു;","poem":1},{"text":"അല്പബുദ്ധികളോ നേരെ ചെന്നു അനർത്ഥത്തിൽ അകപ്പെടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"അന്യനുവേണ്ടി ജാമ്യം നില്‍ക്കുന്നവന്‍റെ വസ്ത്രം എടുത്തുകൊള്ളുക;","poem":1},{"text":"പരസ്ത്രീക്കു വേണ്ടി ഉത്തരവാദിയാകുന്നവനോട് പണയം വാങ്ങുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"അതികാലത്ത് എഴുന്നേറ്റ് സ്നേഹിതനെ","poem":1},{"text":"ഉച്ചത്തിൽ അനുഗ്രഹിക്കുന്നവന് അത് ശാപമായി എണ്ണപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"പെരുമഴയുള്ള ദിവസത്തിൽ ഇടവിടാത്ത ചോർച്ചയും","poem":1},{"text":"കലഹക്കാരത്തിയായ സ്ത്രീയും ഒരുപോലെ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അവളെ നിയന്ത്രിക്കുവാൻ നോക്കുന്നവൻ കാറ്റിനെ നിയന്ത്രിക്കുവാൻ നോക്കുന്നു;","poem":1},{"text":"തന്‍റെ വലങ്കൈകൊണ്ട് എണ്ണ പിടിക്കുവാൻ പോകുന്നതുപോലെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ഇരിമ്പ് ഇരിമ്പിന് മൂർച്ചകൂട്ടുന്നു;","poem":1},{"text":"മനുഷ്യൻ മനുഷ്യന് മൂർച്ചകൂട്ടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"അത്തികാക്കുന്നവൻ അതിന്‍റെ പഴം തിന്നും;","poem":1},{"text":"യജമാനനെ സൂക്ഷിക്കുന്നവൻ ബഹുമാനിക്കപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"വെള്ളത്തിൽ മുഖത്തിന്‍റെ രൂപം പ്രതിഫലിച്ചുകാണുന്നതുപോലെ;","poem":1},{"text":"മനുഷ്യൻ തന്‍റെ ഹൃദയത്തിനൊത്തവണ്ണം മറ്റൊരുവനെ കാണുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"പാതാളത്തിനും നരകത്തിനും ഒരിക്കലും തൃപ്തി വരുന്നില്ല;","poem":1},{"text":"മനുഷ്യന്‍റെ ആഗ്രഹങ്ങള്‍ക്ക് ഒരിക്കലും തൃപ്തി വരുന്നില്ല","poem":2},{"noteId":16},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"വെള്ളിക്ക് പുടവും പൊന്നിന് മൂശയും ശോധന;","poem":1},{"text":"മനുഷ്യനോ അവന്‍റെ പ്രശംസ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ഭോഷനെ ഉരലിൽ ഇട്ടു ഉലക്കകൊണ്ട് അവൽപോലെ ഇടിച്ചാലും","poem":1},{"text":"അവന്‍റെ ഭോഷത്തം വിട്ടുമാറുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"നിന്‍റെ ആടുകളുടെ അവസ്ഥ അറിയുവാൻ ജാഗ്രതയായിരിക്കുക;","poem":1},{"text":"നിന്‍റെ കന്നുകാലികളിൽ നന്നായി ദൃഷ്ടിവക്കുക.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"സമ്പത്ത് എന്നേക്കും ഇരിക്കുന്നതല്ലല്ലോ;","poem":1},{"text":"കിരീടം തലമുറതലമുറയോളം ഇരിക്കുമോ?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"പുല്ല് ചെത്തി കൊണ്ടുപോകുന്നു; ഇളമ്പുല്ല് മുളച്ചുവരുന്നു;","poem":1},{"text":"പർവ്വതങ്ങളിലെ സസ്യങ്ങളെ ശേഖരിക്കുന്നു.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"കുഞ്ഞാടുകൾ നിനക്കു ഉടുപ്പിനും","poem":1},{"text":"കോലാടുകൾ നിലത്തിന്‍റെ വിലയ്ക്കും പ്രയോജനപ്പെടും.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"കോലാടുകളുടെ പാല് നിന്‍റെ ആഹാരത്തിനും","poem":1},{"text":"നിന്‍റെ ഭവനക്കാരുടെ അഹോവൃത്തിക്കും","poem":2},{"lineBreak":true},{"text":"നിന്‍റെ ദാസിമാരുടെ ഉപജീവനത്തിനും മതിയാകും.","poem":2}]}],"footnotes":[{"noteId":16,"caller":"+","text":"മനുഷ്യന്‍റെ ആഗ്രഹങ്ങള്‍ക്ക് ഒരിക്കലും തൃപ്തി വരുന്നില്ല മനുഷ്യന്‍റെ കണ്ണിനും ഒരിക്കലും തൃപ്തി വരുന്നില്ല","reference":{"chapter":27,"verse":20}}]},"thisChapterLink":"/api/mal_irv/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}