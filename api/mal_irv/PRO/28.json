{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_irv","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"c9c58506fd1164d7ae2ea4bf69a81027e9aa684781325d6e9d0270e1119f1917","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":28,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"ആരും ഓടിക്കാതെ ദുഷ്ടന്മാർ ഓടിപ്പോകുന്നു;","poem":1},{"text":"നീതിമാന്മാർ ബാലസിംഹംപോലെ നിർഭയമായിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ദേശത്തിലെ അതിക്രമംനിമിത്തം അതിലെ പ്രഭുക്കന്മാർ അനേകം പേരായിരിക്കുന്നു;","poem":1},{"text":"ബുദ്ധിയും പരിജ്ഞാനവും ഉള്ളവർ മുഖാന്തരം അതിന്‍റെ വ്യവസ്ഥ ദീർഘമായി നില്ക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"അഗതികളെ പീഡിപ്പിക്കുന്ന ദരിദ്രൻ","poem":1},{"noteId":17},{"text":"വിളവ് ശേഷിപ്പിക്കാതെ ഒഴുക്കിക്കളയുന്ന മഴപോലെയാകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ന്യായപ്രമാണം ഉപേക്ഷിക്കുന്നവർ ദുഷ്ടനെ പ്രശംസിക്കുന്നു;","poem":1},{"text":"ന്യായപ്രമാണം പാലിക്കുന്നവർ അവരോട് എതിർത്തുനില്ക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ദുഷ്ടന്മാർ ന്യായം തിരിച്ചറിയുന്നില്ല;","poem":1},{"text":"യഹോവയെ അന്വേഷിക്കുന്നവരോ സകലവും തിരിച്ചറിയുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"തന്‍റെ വഴികളിൽ വക്രനായി നടക്കുന്ന ധനവാനെക്കാൾ","poem":1},{"text":"പരമാർത്ഥതയിൽ നടക്കുന്ന ദരിദ്രൻ ഉത്തമൻ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ന്യായപ്രമാണം പ്രമാണിക്കുന്നവൻ ബുദ്ധിയുള്ള മകൻ;","poem":1},{"text":"ഭോജനപ്രിയന്മാർക്കു സഖിയായവൻ പിതാവിനെ അപമാനിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"പലിശയും ലാഭവും വാങ്ങി സമ്പത്ത് വർദ്ധിപ്പിക്കുന്നവൻ","poem":1},{"text":"അഗതികളോട് കൃപാലുവായവനു വേണ്ടി അത് ശേഖരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ന്യായപ്രമാണം കേൾക്കാതെ ചെവി തിരിച്ചുകളയുന്നവന്‍റെ","poem":1},{"text":"പ്രാർത്ഥന പോലും വെറുപ്പാകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"നേരുള്ളവരെ ദുർമ്മാർഗ്ഗത്തിലേക്ക് തെറ്റിക്കുന്നവൻ","poem":1},{"text":"താൻ കുഴിച്ച കുഴിയിൽതന്നെ വീഴും;","poem":2},{"lineBreak":true},{"text":"നിഷ്കളങ്കരായവർ നന്മ അവകാശമാക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ധനവാന് സ്വയം ജ്ഞാനിയായി തോന്നുന്നു;","poem":1},{"text":"ബുദ്ധിയുള്ള അഗതി അവനെ ശോധനചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"നീതിമാന്മാർ ജയഘോഷം കഴിക്കുമ്പോൾ മഹോത്സവം;","poem":1},{"text":"ദുഷ്ടന്മാരുടെ ഉയർച്ചയിൽ ആളുകൾ സ്വയം ഒളിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"തന്‍റെ ലംഘനങ്ങളെ മറയ്ക്കുന്നവന് ശുഭം വരുകയില്ല;","poem":1},{"text":"അവയെ ഏറ്റുപറഞ്ഞു ഉപേക്ഷിക്കുന്നവന് കരുണ ലഭിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"എപ്പോഴും ദോഷം ചെയ്യുവാന്‍ ഭയപ്പെടുന്ന മനുഷ്യൻ ഭാഗ്യവാൻ","poem":1},{"noteId":18},{"text":";","poem":1},{"text":"ഹൃദയത്തെ കഠിനമാക്കുന്നവൻ അനർത്ഥത്തിൽ അകപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"അഗതികളുടെമേൽ അധികാരം നടത്തുന്ന ദുഷ്ടൻ","poem":1},{"text":"ഗർജ്ജിക്കുന്ന സിംഹത്തിനും ഇരതേടി നടക്കുന്ന കരടിക്കും തുല്യൻ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ബുദ്ധിഹീനനായ പ്രഭു മഹാപീഡകൻ ആകുന്നു;","poem":1},{"text":"ദ്രവ്യാഗ്രഹം വെറുക്കുന്നവൻ ദീർഘായുസ്സോടെ ഇരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"രക്തച്ചൊരിച്ചിലിന്‍റെ കുറ്റം ചുമക്കുന്നവൻ കുഴിയിലേക്ക് ബദ്ധപ്പെടും;","poem":1},{"text":"അവനെ ആരും തുണയ്ക്കരുത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"നിഷ്കളങ്കനായി നടക്കുന്നവൻ സുരക്ഷിതനായിരിക്കും;","poem":1},{"text":"നടപ്പിൽ വക്രതയുള്ളവൻ പെട്ടെന്ന് വീഴും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"നിലം കൃഷിചെയ്യുന്നവന് ആഹാരം സമൃദ്ധിയായി കിട്ടും;","poem":1},{"text":"നിസ്സാരന്മാരെ പിൻചെല്ലുന്നവനോ വേണ്ടുവോളം ദാരിദ്ര്യം അനുഭവിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"വിശ്വസ്തപുരുഷൻ അനുഗ്രഹസമ്പൂർണ്ണൻ;","poem":1},{"text":"ധനവാനാകേണ്ടതിനു ബദ്ധപ്പെടുന്നവന് ശിക്ഷ വരാതിരിക്കുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"പക്ഷപാതം കാണിക്കുന്നത് നല്ലതല്ല;","poem":1},{"text":"ഒരു കഷണം അപ്പത്തിനായും മനുഷ്യൻ അന്യായം ചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ദുഷ്ടകണ്ണുള്ളവൻ ധനവാനാകുവാൻ ബദ്ധപ്പെടുന്നു;","poem":1},{"text":"ബുദ്ധിമുട്ടു വരുമെന്ന് അവൻ അറിയുന്നതുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ചക്കരവാക്ക് പറയുന്നവനെക്കാൾ","poem":1},{"text":"ശാസിക്കുന്നവനു പിന്നീട് പ്രീതി ലഭിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"അപ്പനോടോ അമ്മയോടോ പിടിച്ചുപറിച്ചിട്ട്","poem":1},{"text":"‘അത് അക്രമമല്ല’ എന്നു പറയുന്നവൻ നാശകന്‍റെ സഖി.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"അത്യാഗ്രഹമുള്ളവൻ വഴക്കുണ്ടാക്കുന്നു;","poem":1},{"text":"യഹോവയിൽ ആശ്രയിക്കുന്നവൻ പുഷ്ടി പ്രാപിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"സ്വന്തഹൃദയത്തിൽ ആശ്രയിക്കുന്നവൻ മൂഢൻ;","poem":1},{"text":"ജ്ഞാനത്തോടെ നടക്കുന്നവൻ സുരക്ഷിതനായിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ദരിദ്രനു കൊടുക്കുന്നവന് കുറവ് ഉണ്ടാകുകയില്ല;","poem":1},{"text":"ദരിദ്രനു നേരെ കണ്ണ് അടച്ചുകളയുന്നവന് ഏറിയ ശാപം ഉണ്ടാകും","poem":2},{"noteId":19},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ദുഷ്ടന്മാരുടെ ഉയർച്ചയിൽ ആളുകൾ സ്വയം ഒളിക്കുന്നു;","poem":1},{"text":"അവർ നശിക്കുമ്പോൾ നീതിമാന്മാർ വർദ്ധിക്കുന്നു.","poem":2}]}],"footnotes":[{"noteId":17,"caller":"+","text":"ദരിദ്രൻ അധികാരി","reference":{"chapter":28,"verse":3}},{"noteId":18,"caller":"+","text":"എപ്പോഴും ദോഷം ചെയ്യുവാന്‍ ഭയപ്പെടുന്ന മനുഷ്യൻ ഭാഗ്യവാൻ യഹോവയെ എപ്പോഴും ഭയപ്പെടുന്ന മനുഷ്യൻ ഭാഗ്യവാൻ","reference":{"chapter":28,"verse":14}},{"noteId":19,"caller":"+","text":"ദരിദ്രനു നേരെ കണ്ണ് അടച്ചുകളയുന്നവന് ഏറിയ ശാപം ഉണ്ടാകും ദരിദ്രനെ സഹായിക്കാത്തവന് ഏറിയ ശാപം ഉണ്ടാകും","reference":{"chapter":28,"verse":27}}]},"thisChapterLink":"/api/mal_irv/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PRO/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}