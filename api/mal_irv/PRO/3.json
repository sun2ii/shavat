{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_irv","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"c9c58506fd1164d7ae2ea4bf69a81027e9aa684781325d6e9d0270e1119f1917","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":3,"content":[{"type":"heading","content":["യുവജനങ്ങൾക്കുള്ള ഉപദേശം"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"മകനേ, എന്‍റെ ഉപദേശം മറക്കരുത്;","poem":1},{"text":"നിന്‍റെ ഹൃദയം എന്‍റെ കല്പനകൾ കാത്തുകൊള്ളട്ടെ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവ ദീർഘായുസ്സും ജീവകാലവും","poem":1},{"text":"സമാധാനവും നിനക്കു വർദ്ധിപ്പിച്ചുതരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ദയയും വിശ്വസ്തതയും നിന്നെ വിട്ടുപോകരുത്;","poem":1},{"text":"അവയെ നിന്‍റെ കഴുത്തിൽ കെട്ടിക്കൊള്ളുക;","poem":2},{"lineBreak":true},{"text":"നിന്‍റെ ഹൃദയത്തിന്‍റെ പലകയിൽ എഴുതിക്കൊള്ളുക.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അങ്ങനെ നീ ദൈവത്തിന്‍റെയും മനുഷ്യരുടെയും ദൃഷ്ടിയിൽ","poem":1},{"text":"ലാവണ്യവും സൽബുദ്ധിയും പ്രാപിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"പൂർണ്ണഹൃദയത്തോടെ യഹോവയിൽ ആശ്രയിക്കുക;","poem":1},{"text":"സ്വന്ത വിവേകത്തിൽ ആശ്രയിക്കരുത്.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"നിന്‍റെ എല്ലാ വഴികളിലും അവിടുത്തെ അംഗീകരിച്ചുകൊള്ളുക;","poem":1},{"text":"അവിടുന്ന് നിന്‍റെ പാതകളെ നേരെയാക്കും;","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"നിനക്കു തന്നെ നീ ജ്ഞാനിയായി തോന്നരുത്;","poem":1},{"text":"യഹോവയെ ഭയപ്പെട്ട് ദോഷം വിട്ടകലുക.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അത് നിന്‍റെ നാഭിക്ക് ആരോഗ്യവും","poem":1},{"text":"അസ്ഥികൾക്ക് തണുപ്പും ആയിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"യഹോവയെ നിന്‍റെ ധനംകൊണ്ടും","poem":1},{"text":"എല്ലാ വിളവിന്‍റെയും ആദ്യഫലംകൊണ്ടും ബഹുമാനിക്കുക.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അങ്ങനെ നിന്‍റെ കളപ്പുരകൾ സമൃദ്ധിയായി നിറയും;","poem":1},{"text":"നിന്‍റെ ചക്കുകളിൽ വീഞ്ഞ് കവിഞ്ഞൊഴുകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"മകനേ, യഹോവയുടെ ശിക്ഷ നിരസിക്കരുത്;","poem":1},{"text":"അവിടുത്തെ ശാസനയിൽ മുഷിയുകയും അരുത്.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അപ്പൻ ഇഷ്ടപുത്രനോട് ചെയ്യുന്നതുപോലെ","poem":1},{"text":"യഹോവ താൻ സ്നേഹിക്കുന്നവനെ ശിക്ഷിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ജ്ഞാനം പ്രാപിക്കുന്ന മനുഷ്യനും","poem":1},{"text":"വിവേകം ലഭിക്കുന്ന മനുഷ്യനും ഭാഗ്യവാൻ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അതിന്‍റെ ആദായം വെള്ളിയെക്കാളും","poem":1},{"text":"അതിന്‍റെ ലാഭം തങ്കത്തെക്കാളും നല്ലത്.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അത് മുത്തുകളിലും വിലയേറിയത്;","poem":1},{"text":"നിന്‍റെ മനോഹരവസ്തുക്കൾ ഒന്നും അതിന് തുല്യമാകുകയില്ല.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അതിന്‍റെ വലങ്കയ്യിൽ ദീർഘായുസ്സും","poem":1},{"text":"ഇടങ്കയ്യിൽ ധനവും മാനവും ഇരിക്കുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അതിന്‍റെ വഴികൾ സന്തുഷ്ടവും","poem":1},{"text":"അതിന്‍റെ പാതകളെല്ലാം സമാധാനവും ആകുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അതിനെ പിടിച്ചുകൊള്ളുന്നവർക്ക് അത് ജീവവൃക്ഷം;","poem":1},{"text":"അതിനെ കരസ്ഥമാക്കുന്നവർ ഭാഗ്യവാന്മാർ.","poem":2}]},{"type":"heading","content":["സൃഷ്ടിയിൽ ദൈവത്തിന്‍റെ ജ്ഞാനം"]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ജ്ഞാനത്താൽ യഹോവ ഭൂമിയെ സ്ഥാപിച്ചു;","poem":1},{"text":"വിവേകത്താൽ അവിടുന്ന് ആകാശത്തെ ഉറപ്പിച്ചു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അവിടുത്തെ പരിജ്ഞാനത്താൽ ആഴങ്ങൾ പിളർന്നു;","poem":1},{"text":"മേഘങ്ങൾ മഞ്ഞ് പൊഴിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"മകനേ, ജ്ഞാനവും വകതിരിവും കാത്തുകൊള്ളുക;","poem":1},{"text":"അവ നിന്‍റെ ദൃഷ്ടിയിൽനിന്ന് മാറിപ്പോകരുത്.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"അവ നിനക്കു ജീവനും","poem":1},{"text":"നിന്‍റെ കഴുത്തിന് അലങ്കാരവും ആയിരിക്കും.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"അങ്ങനെ നീ നിർഭയമായി വഴിയിൽ നടക്കും;","poem":1},{"text":"നിന്‍റെ കാൽ ഇടറുകയുമില്ല.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"നീ കിടക്കുവാൻ പോകുമ്പോൾ നിനക്കു പേടി ഉണ്ടാകുകയില്ല;","poem":1},{"text":"കിടക്കുമ്പോൾ നിന്‍റെ ഉറക്കം സുഖകരമായിരിക്കും.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"പെട്ടെന്നുള്ള വിപത്ത് ഹേതുവായും","poem":1},{"text":"ദുഷ്ടന്മാർക്ക് വരുന്ന നാശംനിമിത്തവും നീ ഭയപ്പെടുകയില്ല.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"യഹോവ നിന്‍റെ ആശ്രയമായിരിക്കും;","poem":1},{"text":"അവിടുന്ന് നിന്‍റെ കാൽ കെണിയിൽപ്പെടാതെ കാക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"നന്മ ചെയ്യുവാൻ നിനക്കു പ്രാപ്തിയുള്ളപ്പോൾ","poem":1},{"text":"അതിന് യോഗ്യന്മാരായിരിക്കുന്നവർക്ക് ചെയ്യാതിരിക്കരുത്.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"നിന്‍റെ കയ്യിൽ ഉള്ളപ്പോൾ കൂട്ടുകാരനോട്:","poem":1},{"text":"“പോയിവരുക, നാളെത്തരാം” എന്നു പറയരുത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"കൂട്ടുകാരൻ സമീപത്ത് നിർഭയം വസിക്കുമ്പോൾ,","poem":1},{"text":"അവന്‍റെനേരെ ദോഷം നിരൂപിക്കരുത്.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"നിനക്കു ഒരു ദോഷവും ചെയ്യാത്ത മനുഷ്യനോട്","poem":1},{"text":"നീ വെറുതെ കലഹിക്കരുത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"സാഹസക്കാരനോട് നീ അസൂയപ്പെടരുത്;","poem":1},{"text":"അവന്‍റെ വഴികൾ ഒന്നും തിരഞ്ഞെടുക്കുകയുമരുത്.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"വക്രതയുള്ളവൻ യഹോവയ്ക്ക് വെറുപ്പാകുന്നു;","poem":1},{"text":"നീതിമാന്മാരോട് അവിടുത്തേയ്ക്ക് സഖ്യത ഉണ്ട്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"യഹോവയുടെ ശാപം ദുഷ്ടന്‍റെ വീട്ടിൽ ഉണ്ട്;","poem":1},{"text":"നീതിമാന്മാരുടെ വാസസ്ഥലത്തെയോ അവിടുന്ന് അനുഗ്രഹിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"പരിഹാസികളെ അവിടുന്ന് പരിഹസിക്കുന്നു;","poem":1},{"text":"എളിയവർക്കോ അവിടുന്ന് കൃപ നല്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"ജ്ഞാനികൾ ബഹുമാനത്തെ അവകാശമാക്കും;","poem":1},{"text":"ഭോഷന്മാരുടെ ഉയർച്ചയോ അപമാനം തന്നെ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}