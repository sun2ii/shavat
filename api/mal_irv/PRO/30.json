{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_irv","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"c9c58506fd1164d7ae2ea4bf69a81027e9aa684781325d6e9d0270e1119f1917","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":30,"content":[{"type":"heading","content":["ആഗൂരിന്‍റെ വചനങ്ങൾ"]},{"type":"verse","number":1,"content":["യാക്കേയുടെ മകനായ ആഗൂരിന്‍റെ വചനങ്ങൾ;",{"lineBreak":true},{"text":"ഒരു അരുളപ്പാടു; ആ പുരുഷൻ പ്രസ്താവിച്ചത്:","poem":1},{"text":"“ദൈവമേ, ഞാൻ അദ്ധ്വാനിച്ചു,","poem":2},{"lineBreak":true},{"text":"ദൈവമേ, ഞാൻ അദ്ധ്വാനിച്ചു ക്ഷയിച്ചിരിക്കുന്നു","poem":2},{"noteId":20},{"text":".","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ഞാൻ സകലമനുഷ്യരിലും ബുദ്ധിഹീനനാകുന്നു;","poem":1},{"text":"മാനുഷീകബുദ്ധി എനിക്കില്ല;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ഞാൻ ജ്ഞാനം അഭ്യസിച്ചിട്ടില്ല;","poem":1},{"text":"പരിശുദ്ധനായവന്‍റെ പരിജ്ഞാനം എനിക്കില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"സ്വർഗ്ഗത്തിൽ കയറുകയും ഇറങ്ങിവരുകയും ചെയ്തവൻ ആര്‍?","poem":1},{"text":"കാറ്റിനെ തന്‍റെ മുഷ്ടിയിൽ പിടിച്ചടക്കിയവൻ ആര്‍?","poem":2},{"text":"വെള്ളത്തെ വസ്ത്രത്തിൽ കെട്ടിയവൻ ആര്‍?","poem":1},{"text":"ഭൂമിയുടെ അറുതികളെയൊക്കെയും നിയമിച്ചവൻ ആര്‍?","poem":2},{"text":"അവന്‍റെ പേരെന്ത്?","poem":1},{"text":"അവന്‍റെ മകന്‍റെ പേരെന്ത്?","poem":2},{"lineBreak":true},{"text":"നിനക്കറിയാമോ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ദൈവത്തിന്‍റെ സകലവചനവും ശുദ്ധിചെയ്തതാകുന്നു;","poem":1},{"text":"തന്നിൽ ആശ്രയിക്കുന്നവർക്ക് അവിടുന്ന് പരിച തന്നെ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവിടുത്തെ വചനങ്ങളോട് നീ ഒന്നും കൂട്ടരുത്;","poem":1},{"text":"അവിടുന്ന് നിന്നെ വിസ്തരിച്ചിട്ട് നീ കള്ളനാകുവാൻ ഇടവരരുത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"രണ്ടു കാര്യം ഞാൻ അങ്ങേയോട് അപേക്ഷിക്കുന്നു;","poem":1},{"text":"ജീവപര്യന്തം അവ എനിക്ക് നിഷേധിക്കരുതേ;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"വ്യാജവും ഭോഷ്ക്കും എന്നോട് അകറ്റേണമേ;","poem":1},{"text":"ദാരിദ്ര്യവും സമ്പത്തും എനിക്ക് തരാതെ","poem":2},{"lineBreak":true},{"text":"നിത്യവൃത്തി തന്ന് എന്നെ പോഷിപ്പിക്കേണമേ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഞാൻ തൃപ്തനായിത്തീർന്നിട്ട്: യഹോവ ആര്‍? എന്നു അങ്ങയെ നിഷേധിക്കുവാനും","poem":1},{"text":"ദരിദ്രനായിത്തീർന്നിട്ട് മോഷ്ടിച്ച് എന്‍റെ ദൈവത്തിന്‍റെ നാമത്തെ ദുഷിക്കുവാനും സംഗതി വരരുതേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ദാസനെക്കുറിച്ച് യജമാനനോട് ഏഷണി പറയരുത്;","poem":1},{"text":"അവൻ നിന്നെ ശപിക്കുവാനും നീ കുറ്റക്കാരനായിത്തീരുവാനും ഇടവരരുത്.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അപ്പനെ ശപിക്കുകയും","poem":1},{"text":"അമ്മയെ അനുഗ്രഹിക്കാതിരിക്കുകയും ചെയ്യുന്നോരു തലമുറ!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"തങ്ങൾക്ക് തന്നെ നിർമ്മലരായിത്തോന്നുന്നവരും","poem":1},{"text":"അശുദ്ധി കഴുകിക്കളയാത്തവരുമായോരു തലമുറ!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അയ്യോ ഈ തലമുറയുടെ കണ്ണുകൾ എത്ര ഉയർന്നിരിക്കുന്നു -","poem":1},{"text":"അവരുടെ കൺപോളകൾ എത്ര പൊങ്ങിയിരിക്കുന്നു -","poem":2}]},{"type":"verse","number":14,"content":[{"text":"എളിയവരെ ഭൂമിയിൽനിന്നും","poem":1},{"text":"ദരിദ്രരെ മനുഷ്യരുടെ ഇടയിൽനിന്നും തിന്നുകളയുവാൻ തക്കവണ്ണം","poem":2},{"lineBreak":true},{"text":"മുമ്പല്ലുകൾ വാളായും അണപ്പല്ലുകൾ കത്തിയായും ഇരിക്കുന്ന ഒരു തലമുറ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"കന്നട്ടയ്ക്കു: ‘തരിക, തരിക’ എന്ന രണ്ടു പുത്രിമാർ ഉണ്ട്;","poem":1},{"lineBreak":true},{"text":"ഒരിക്കലും തൃപ്തിവരാത്തത് മൂന്നുണ്ട്;","poem":2},{"lineBreak":true},{"text":"‘മതി’ എന്നു പറയാത്തത് നാലുണ്ട്:","poem":2}]},{"type":"verse","number":16,"content":[{"text":"പാതാളവും വന്ധ്യയുടെ ഗർഭപാത്രവും","poem":1},{"text":"വെള്ളം കുടിച്ചു തൃപ്തിവരാത്ത ഭൂമിയും","poem":2},{"lineBreak":true},{"text":"‘മതി’ എന്നു പറയാത്ത തീയും തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"അപ്പനെ പരിഹസിക്കുകയും","poem":1},{"text":"അമ്മയെ അനുസരിക്കാതിരിക്കുകയും ചെയ്യുന്ന കണ്ണിനെ","poem":2},{"text":"തോട്ടരികത്തെ കാക്ക കൊത്തിപ്പറിക്കുകയും","poem":1},{"text":"കഴുകന്‍ കുഞ്ഞുങ്ങൾ തിന്നുകയും ചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"എനിക്ക് അതിവിസ്മയമായി തോന്നുന്നത് മൂന്നുണ്ട്;","poem":1},{"text":"എനിക്ക് അറിഞ്ഞുകൂടാത്തത് നാലുണ്ട്:","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ആകാശത്ത് കഴുകന്‍റെ വഴിയും","poem":1},{"text":"പാറമേൽ സർപ്പത്തിന്‍റെ വഴിയും","poem":2},{"text":"സമുദ്രമദ്ധ്യത്തിൽ കപ്പലിന്‍റെ വഴിയും","poem":1},{"text":"കന്യകയോടുകൂടി പുരുഷന്‍റെ വഴിയും തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"വ്യഭിചാരിണിയുടെ വഴിയും അങ്ങനെ തന്നെ:","poem":1},{"text":"അവൾ തിന്നു വായ് തുടച്ചിട്ട്,","poem":2},{"lineBreak":true},{"text":"‘ഞാൻ ഒരു ദോഷവും ചെയ്തിട്ടില്ല’ എന്നു പറയുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"മൂന്നിന്‍റെ നിമിത്തം ഭൂമി വിറയ്ക്കുന്നു;","poem":1},{"text":"നാലിന്‍റെ നിമിത്തം അതിന് സഹിച്ചുകൂടാ:","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ദാസൻ രാജാവായാൽ അവന്‍റെ നിമിത്തവും","poem":1},{"text":"ഭോഷൻ തിന്ന് തൃപ്തനായാൽ അവന്‍റെ നിമിത്തവും","poem":2}]},{"type":"verse","number":23,"content":[{"text":"വെറുക്കപ്പെട്ട സ്ത്രീയ്ക്കു വിവാഹം കഴിഞ്ഞാൽ അവളുടെ നിമിത്തവും","poem":1},{"text":"ദാസി യജമാനത്തിയുടെ സ്ഥാനം പ്രാപിച്ചാൽ അവളുടെ നിമിത്തവും തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ഭൂമിയിൽ എത്രയും ചെറിയവയെങ്കിലും","poem":1},{"text":"അത്യന്തം ജ്ഞാനമുള്ളതു നാലുണ്ട്:","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ഉറുമ്പ് ബലഹീനജാതി എങ്കിലും","poem":1},{"text":"അത് വേനല്ക്കാലത്ത് ആഹാരം സമ്പാദിച്ചു വയ്ക്കുന്നു.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"കുഴിമുയൽ ശക്തിയില്ലാത്ത ജാതി എങ്കിലും","poem":1},{"text":"അത് പാറയിൽ പാർപ്പിടം ഉണ്ടാക്കുന്നു.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"വെട്ടുക്കിളിക്ക് രാജാവില്ല എങ്കിലും","poem":1},{"text":"അതൊക്കെയും അണിയണിയായി പുറപ്പെടുന്നു.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"പല്ലിയെ കൈകൊണ്ട് പിടിക്കാം എങ്കിലും","poem":1},{"noteId":21},{"text":"അവ രാജാക്കന്മാരുടെ അരമനകളിൽ പാർക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ചന്തമായി നടകൊള്ളുന്നത് മൂന്നുണ്ട്;","poem":1},{"text":"ചന്തമായി നടക്കുന്നത് നാലുണ്ട്:","poem":2}]},{"type":"verse","number":30,"content":[{"text":"മൃഗങ്ങളിൽ ശക്തിയേറിയതും","poem":1},{"text":"ഒന്നിനും വഴിമാറാത്തതുമായ സിംഹവും","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ഗര്‍വ്വോട് നടക്കുന്ന പൂവന്‍കോഴിയും","poem":1},{"noteId":22},{"text":"കോലാട്ടുകൊറ്റനും","poem":1},{"text":"സൈന്യസമേതനായ രാജാവും തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"നീ നിഗളിച്ച് ഭോഷത്തം പ്രവർത്തിക്കുകയോ","poem":1},{"text":"ദോഷം നിരൂപിക്കുകയോ ചെയ്തുപോയെങ്കിൽ","poem":2},{"lineBreak":true},{"text":"കൈകൊണ്ട് വായ് പൊത്തിക്കൊള്ളുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"പാല് കടഞ്ഞാൽ വെണ്ണയുണ്ടാകും;","poem":1},{"text":"മൂക്കു ഞെക്കിയാൽ ചോര വരും;","poem":2},{"lineBreak":true},{"text":"കോപം ഇളക്കിയാൽ വഴക്കുണ്ടാകും.","poem":2}]}],"footnotes":[{"noteId":20,"caller":"+","text":"ദൈവമേ, ഞാൻ അദ്ധ്വാനിച്ചു ക്ഷയിച്ചിരിക്കുന്നു ഇതിന്‍റെ എബ്രായ പദം “ഊക്കാല്‍” എന്നാണ്","reference":{"chapter":30,"verse":1}},{"noteId":21,"caller":"+","text":"പല്ലിയെ കൈകൊണ്ട് പിടിക്കാം എങ്കിലും തന്‍റെ സ്വന്തം കൈകൊണ്ട് വല നെയ്യുന്ന ചിലന്തിയെ കൈകൊണ്ട് പിടിക്കാം എങ്കിലും","reference":{"chapter":30,"verse":28}},{"noteId":22,"caller":"+","text":"പൂവന്‍കോഴിയും യുദ്ധകുതിരയും","reference":{"chapter":30,"verse":31}}]},"thisChapterLink":"/api/mal_irv/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}