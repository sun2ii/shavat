{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_irv","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"c9c58506fd1164d7ae2ea4bf69a81027e9aa684781325d6e9d0270e1119f1917","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":31,"content":[{"type":"heading","content":["ലെമൂവേൽ രാജാവിന്‍റെ വചനങ്ങൾ"]},{"type":"verse","number":1,"content":["ലെമൂവേൽ രാജാവിന്‍റെ വചനങ്ങൾ; അവന്‍റെ അമ്മ അവന് ഉപദേശിച്ചുകൊടുത്ത അരുളപ്പാടു."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"മകനേ, എന്ത്? ഞാൻ പ്രസവിച്ച മകനേ എന്ത്?","poem":1},{"text":"എന്‍റെ നേർച്ചകളുടെ മകനേ, എന്ത്?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"സ്ത്രീകൾക്ക് നിന്‍റെ ബലത്തെയും","poem":1},{"text":"രാജാക്കന്മാരെ നശിപ്പിക്കുന്നവർക്ക് നിന്‍റെ വഴികളെയും ഏല്പിച്ചു കൊടുക്കരുത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"വീഞ്ഞ് കുടിക്കുന്നത് രാജാക്കന്മാർക്ക് ചേർന്നതല്ല;","poem":1},{"text":"ലെമൂവേലേ, രാജാക്കന്മാർക്ക് അത് ചേർന്നതല്ല;","poem":2},{"lineBreak":true},{"text":"മദ്യാസക്തി പ്രഭുക്കന്മാർക്ക് ഉചിതവുമല്ല.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവർ മദ്യപിച്ചിട്ട്, നിയമം മറന്നുപോകുവാനും","poem":1},{"text":"പീഡിതരുടെ ന്യായം മറിച്ചുകളയുവാനും ഇടവരരുത്.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"നശിച്ചുകൊണ്ടിരിക്കുന്നവന് മദ്യവും","poem":1},{"text":"മനോവ്യസനമുള്ളവന് വീഞ്ഞും കൊടുക്കുക.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവൻ മദ്യപിച്ചിട്ട്, തന്‍റെ ദാരിദ്ര്യം മറക്കുകയും","poem":1},{"text":"തന്‍റെ അരിഷ്ടത ഓർക്കാതിരിക്കുകയും ചെയ്യട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ഊമനു വേണ്ടി നിന്‍റെ വായ് തുറക്കുക;","poem":1},{"text":"ക്ഷയിച്ചുപോകുന്ന എല്ലാവരുടെയും കാര്യത്തിൽ തന്നെ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"നിന്‍റെ വായ് തുറന്ന് നീതിയോടെ ന്യായം വിധിക്കുക;","poem":1},{"text":"എളിയവനും ദരിദ്രനും ന്യായപാലനം ചെയ്തുകൊടുക്കുക.","poem":2}]},{"type":"heading","content":["സാമർത്ഥ്യമുള്ള ഭാര്യ"]},{"type":"verse","number":10,"content":[{"text":"സാമർത്ഥ്യമുള്ള ഭാര്യയെ ആർക്ക് കിട്ടും?","poem":1},{"text":"അവളുടെ വില മുത്തുകളിലും ഏറിയത്.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ഭർത്താവിന്‍റെ ഹൃദയം അവളെ വിശ്വസിക്കുന്നു;","poem":1},{"text":"അവന്‍റെ ലാഭത്തിന് ഒരു കുറവുമില്ല.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവൾ തന്‍റെ ആയുഷ്ക്കാലമൊക്കെയും","poem":1},{"text":"അവന് തിന്മയല്ല നന്മ തന്നെ ചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"അവൾ ആട്ടുരോമവും ചണവും സമ്പാദിച്ച്","poem":1},{"text":"താത്പര്യത്തോടെ സ്വന്തം കൈകൊണ്ട് വേലചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവൾ കച്ചവടക്കപ്പൽപോലെയാകുന്നു;","poem":1},{"text":"ദൂരത്തുനിന്ന് ആഹാരം കൊണ്ടുവരുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവൾ അതിരാവിലെ എഴുന്നേറ്റ്, വീട്ടിലുള്ളവർക്ക് ആഹാരവും","poem":1},{"text":"വേലക്കാരികൾക്ക് ഓഹരിയും കൊടുക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"അവൾ ഒരു നിലത്തിന്മേൽ ദൃഷ്ടിവച്ച് അത് വാങ്ങുന്നു;","poem":1},{"text":"സമ്പാദ്യം കൊണ്ടു അവൾ ഒരു മുന്തിരിത്തോട്ടം നട്ടുണ്ടാക്കുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവൾ ബലംകൊണ്ട് അരമുറുക്കുകയും","poem":1},{"text":"ഭുജങ്ങളെ ശക്തീകരിക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"തന്‍റെ വ്യാപാരം ആദായമുള്ളതെന്ന് അവൾ അറിയുന്നു;","poem":1},{"text":"അവളുടെ വിളക്ക് രാത്രിയിൽ കെട്ടുപോകുന്നതുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"അവൾ നെയ്ത്തുദണ്ഡിന് കൈ നീട്ടുന്നു;","poem":1},{"text":"അവളുടെ വിരൽ തക്ലിയും ചർക്കയും ഉപയോഗിച്ചു നൂൽ നൂല്‌ക്കുന്നു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അവൾ തന്‍റെ കൈ എളിയവർക്കുവേണ്ടി തുറക്കുന്നു;","poem":1},{"text":"ദരിദ്രന്മാരുടെ അടുക്കലേക്ക് കൈ നീട്ടുന്നു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"തന്‍റെ വീട്ടുകാരെക്കുറിച്ച് അവൾ ഹിമകാലത്ത് ഭയപ്പെടുന്നില്ല;","poem":1},{"text":"അവളുടെ വീട്ടിലുള്ള എല്ലാവർക്കും ചുവപ്പു കമ്പിളി ഉണ്ടല്ലോ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"അവൾ തനിക്കു പരവതാനി ഉണ്ടാക്കുന്നു;","poem":1},{"text":"ചണപട്ടും ധൂമ്രവസ്ത്രവും അവളുടെ ഉടുപ്പ്.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ദേശത്തിലെ മൂപ്പന്മാരോടുകൂടി ഇരിക്കുമ്പോൾ","poem":1},{"text":"അവളുടെ ഭർത്താവ് പട്ടണവാതില്‍ക്കൽ പ്രസിദ്ധനാകുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അവൾ ചണവസ്ത്രം ഉണ്ടാക്കി വില്ക്കുന്നു;","poem":1},{"text":"അരക്കച്ച ഉണ്ടാക്കി കച്ചവടക്കാരനെ ഏല്പിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ബലവും മഹിമയും അവളുടെ ഉടുപ്പ്;","poem":1},{"text":"ഭാവികാലം ഓർത്തു അവൾ പുഞ്ചിരി തൂകുന്നു.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"അവൾ ജ്ഞാനത്തോടെ വായ് തുറക്കുന്നു;","poem":1},{"text":"ദയയുള്ള ഉപദേശം അവളുടെ നാവിന്മേൽ ഉണ്ട്.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"വീട്ടുകാരുടെ പെരുമാറ്റം അവൾ ശ്രദ്ധിച്ചുനോക്കുന്നു;","poem":1},{"text":"വെറുതെ ഇരുന്നു അഹോവൃത്തി കഴിക്കുന്നില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"അവളുടെ മക്കൾ എഴുന്നേറ്റ് അവളെ ‘ഭാഗ്യവതി’ എന്നു പുകഴ്ത്തുന്നു;","poem":1},{"text":"അവളുടെ ഭർത്താവും അവളെ പ്രശംസിക്കുന്നത്:","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“അനേകം തരുണികൾ സാമർത്ഥ്യം കാണിച്ചിട്ടുണ്ട്;","poem":1},{"text":"നീയോ അവരെല്ലാവരിലും ശ്രേഷ്ഠയായിരിക്കുന്നു.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"ലാവണ്യം വ്യാജവും സൗന്ദര്യം വ്യർത്ഥവും ആകുന്നു;","poem":1},{"text":"യഹോവാഭക്തിയുള്ള സ്ത്രീയോ പ്രശംസിക്കപ്പെടും.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"അവളുടെ കൈകളുടെ ഫലം അവൾക്ക് കൊടുക്കുവിൻ;","poem":1},{"text":"അവളുടെ സ്വന്തപ്രവൃത്തികൾ പട്ടണവാതില്‍ക്കൽ അവളെ പ്രശംസിക്കട്ടെ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}