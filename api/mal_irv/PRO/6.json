{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_irv","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"c9c58506fd1164d7ae2ea4bf69a81027e9aa684781325d6e9d0270e1119f1917","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":6,"content":[{"type":"heading","content":["മുന്നറിയിപ്പുകൾ"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"മകനേ, കൂട്ടുകാരനു വേണ്ടി നീ ജാമ്യം നില്ക്കുകയോ","poem":1},{"text":"അന്യനുവേണ്ടി കൈയടിച്ച് ഉറപ്പ് നൽകുകയോ ചെയ്തിട്ടുണ്ടെങ്കിൽ,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"നിന്‍റെ വായിലെ വാക്കുകളാൽ നീ ചതിക്കപ്പെട്ടു;","poem":1},{"text":"നിന്‍റെ വായിലെ മൊഴികളാൽ നീ കെണിയിലായി.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ആകയാൽ മകനേ, ഇത് ചെയ്യുക; നിന്നെത്തന്നെ വിടുവിക്കുക;","poem":1},{"text":"കൂട്ടുകാരന്‍റെ കൈകളിൽ നീ അകപ്പെട്ടുപോയല്ലോ;","poem":2},{"lineBreak":true},{"text":"നീ ചെന്നു, താണുവീണ് കൂട്ടുകാരനോട് മുട്ടിപ്പായി അപേക്ഷിക്കുക.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"നിന്‍റെ കണ്ണിന് ഉറക്കവും","poem":1},{"text":"നിന്‍റെ കൺപോളകൾക്ക് നിദ്രയും കൊടുക്കരുത്.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"മാൻ നായാട്ടുകാരന്‍റെ കൈയിൽനിന്നും","poem":1},{"text":"പക്ഷി വേട്ടക്കാരന്‍റെ കൈയിൽനിന്നും","poem":2},{"lineBreak":true},{"text":"എന്നപോലെ നീ നിന്നെത്തന്നെ വിടുവിക്കുക,","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"മടിയാ, ഉറുമ്പിന്‍റെ അടുക്കൽ ചെല്ലുക;","poem":1},{"text":"അതിന്‍റെ വഴികൾ നോക്കി ബുദ്ധിപഠിക്കുക.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അതിന് നായകനും മേൽവിചാരകനും","poem":1},{"text":"അധിപതിയും ഇല്ലാതിരുന്നിട്ടും","poem":2}]},{"type":"verse","number":8,"content":[{"text":"വേനല്ക്കാലത്ത് തന്‍റെ ആഹാരം ഒരുക്കുന്നു;","poem":1},{"text":"കൊയ്ത്തുകാലത്ത് തന്‍റെ ഭക്ഷണം ശേഖരിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"മടിയാ, നീ എത്രനേരം കിടന്നുറങ്ങും?","poem":1},{"text":"എപ്പോൾ ഉറക്കത്തിൽ നിന്നെഴുന്നേല്ക്കും?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"കുറേക്കൂടെ ഉറക്കം; കുറേക്കൂടെ നിദ്ര;","poem":1},{"text":"കുറേക്കൂടെ കൈകെട്ടിക്കിടപ്പ്.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അങ്ങനെ നിന്‍റെ ദാരിദ്ര്യം വഴിപോക്കനെപ്പോലെയും","poem":1},{"text":"നിന്‍റെ ബുദ്ധിമുട്ട് ആയുധധാരിയെപ്പോലെയും വരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"നിസ്സാരനും ദുഷ്കർമ്മിയുമായവൻ","poem":1},{"text":"വായുടെ വക്രതയോടെ നടക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അവൻ കണ്ണിമയ്ക്കുന്നു; കാൽ കൊണ്ടു തോണ്ടുന്നു;","poem":1},{"text":"വിരൽകൊണ്ട് ആംഗ്യം കാണിക്കുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവന്‍റെ ഹൃദയത്തിൽ വക്രതയുണ്ട്;","poem":1},{"text":"അവൻ എല്ലായ്‌പ്പോഴും ദോഷം നിരൂപിച്ച് വഴക്കുണ്ടാക്കുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അതുകൊണ്ട് അവന്‍റെ ആപത്ത് പെട്ടെന്ന് വരും;","poem":1},{"text":"ക്ഷണത്തിൽ അവൻ തകർന്നുപോകും; പരിഹാരമുണ്ടാകുകയുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ആറു കാര്യം യഹോവ വെറുക്കുന്നു;","poem":1},{"text":"ഏഴു കാര്യം അവന് അറപ്പാകുന്നു:","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ഗർവ്വമുള്ള കണ്ണും വ്യാജമുള്ള നാവും","poem":1},{"text":"കുറ്റമില്ലാത്ത രക്തം ചൊരിയുന്ന കയ്യും","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ദുരുപായം നിരൂപിക്കുന്ന ഹൃദയവും","poem":1},{"text":"ദോഷത്തിനു ബദ്ധപ്പെട്ട് ഓടുന്ന കാലും","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ഭോഷ്ക് പറയുന്ന കള്ളസാക്ഷിയും","poem":1},{"text":"സഹോദരന്മാരുടെ ഇടയിൽ വഴക്കുണ്ടാക്കുന്നവനും തന്നെ.","poem":2}]},{"type":"heading","content":["വ്യഭിചാരത്തെപ്പറ്റിയുള്ള മുന്നറിയിപ്പ്"]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"മകനേ, നിന്‍റെ അപ്പന്‍റെ കല്പന പ്രമാണിക്കുക;","poem":1},{"text":"അമ്മയുടെ ഉപദേശം ഉപേക്ഷിക്കുകയുമരുത്.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അത് എല്ലായ്‌പ്പോഴും നിന്‍റെ ഹൃദയത്തോട് ബന്ധിച്ചുകൊള്ളുക;","poem":1},{"text":"നിന്‍റെ കഴുത്തിൽ അത് കെട്ടിക്കൊള്ളുക.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"നീ നടക്കുമ്പോൾ അത് നിനക്കു വഴികാണിക്കും.","poem":1},{"text":"നീ ഉറങ്ങുമ്പോൾ അത് നിന്നെ കാക്കും;","poem":2},{"lineBreak":true},{"text":"നീ ഉണരുമ്പോൾ അത് നിന്നോട് സംസാരിക്കും.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"കല്പന ഒരു ദീപവും ഉപദേശം ഒരു വെളിച്ചവും","poem":1},{"text":"പ്രബോധനത്തിന്‍റെ ശാസനകൾ ജീവന്‍റെ മാർഗ്ഗവും ആകുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അവ ദുഷ്ടസ്ത്രീയുടെ വശീകരണത്തിൽ നിന്നും","poem":1},{"text":"പരസ്ത്രീയുടെ ചക്കരവാക്കുകളിൽനിന്നും നിന്നെ രക്ഷിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"അവളുടെ സൗന്ദര്യത്തെ നിന്‍റെ ഹൃദയത്തിൽ മോഹിക്കരുത്;","poem":1},{"text":"അവൾ കണ്ണിമകൊണ്ട് നിന്നെ വശീകരിക്കുകയുമരുത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"വേശ്യാസ്ത്രീനിമിത്തം പുരുഷൻ പെറുക്കിത്തിന്നേണ്ടിവരും;","poem":1},{"text":"വ്യഭിചാരിണി വിലയേറിയ ജീവനെ വേട്ടയാടുന്നു.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ഒരു മനുഷ്യന് തന്‍റെ വസ്ത്രം വെന്തുപോകാതെ","poem":1},{"text":"മടിയിൽ തീ കൊണ്ടുവരാമോ?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ഒരുത്തനു കാൽ പൊള്ളാതെ","poem":1},{"text":"തീക്കനലിന്മേൽ നടക്കാമോ?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"കൂട്ടുകാരന്‍റെ ഭാര്യയുടെ അടുക്കൽ ചെല്ലുന്നവൻ ഇങ്ങനെതന്നെ;","poem":1},{"text":"അവളെ തൊടുന്ന ഒരുത്തനും ശിക്ഷ വരാതെയിരിക്കുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"കള്ളൻ വിശന്നിട്ട് വിശപ്പടക്കുവാൻ മാത്രം മോഷ്ടിച്ചാൽ","poem":1},{"text":"ആരും അവനെ നിന്ദിക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"അവൻ പിടിക്കപ്പെട്ടാൽ അവൻ ഏഴിരട്ടി മടക്കിക്കൊടുക്കണം;","poem":1},{"text":"തന്‍റെ വീട്ടിലെ വസ്തുവക ഒക്കെയും കൊടുക്കേണ്ടിവരാം;","poem":2}]},{"type":"verse","number":32,"content":[{"text":"സ്ത്രീയോട് വ്യഭിചാരം ചെയ്യുന്നവനോ, ബുദ്ധിഹീനൻ;","poem":1},{"text":"അങ്ങനെ ചെയ്യുന്നവൻ സ്വന്തപ്രാണനെ നശിപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"പ്രഹരവും അപമാനവും അവനു ലഭിക്കും;","poem":1},{"text":"അവന്‍റെ നിന്ദ മാഞ്ഞുപോകുകയുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"ജാരശങ്ക പുരുഷന് ക്രോധഹേതുവാകുന്നു;","poem":1},{"text":"പ്രതികാരദിവസത്തിൽ അവൻ ഇളവ് നൽകുകയില്ല.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"അവൻ യാതൊരു നഷ്ടപരിഹാരവും സ്വീകരിക്കുകയില്ല;","poem":1},{"text":"എത്ര സമ്മാനം കൊടുത്താലും അവൻ തൃപ്തിപ്പെടുകയുമില്ല.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}