{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PRO","translationId":"mal_irv","name":"സദൃശവാക്യങ്ങൾ","commonName":"സദൃശവാക്യങ്ങൾ","title":"സദൃശവാക്യങ്ങൾ","order":20,"numberOfChapters":31,"sha256":"c9c58506fd1164d7ae2ea4bf69a81027e9aa684781325d6e9d0270e1119f1917","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mal_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":8,"content":[{"type":"heading","content":["ജ്ഞാനത്തെ പ്രകീർത്തിക്കുന്നു"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"ജ്ഞാനമായവൾ വിളിച്ചുപറയുന്നില്ലയോ?","poem":1},{"text":"ബുദ്ധിയായവൾ തന്‍റെ സ്വരം ഉയർത്തുന്നില്ലയോ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവൾ വഴിയരികിൽ കുന്നുകളുടെ മുകളിൽ,","poem":1},{"text":"പാതകൾ കൂടുന്നേടത്ത് നില്ക്കുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവൾ പടിവാതിലുകളുടെ അരികത്തും പട്ടണവാതില്‍ക്കലും","poem":1},{"text":"ഗോപുരദ്വാരത്തിങ്കലും ഘോഷിക്കുന്നത്:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“പുരുഷന്മാരേ, ഞാൻ നിങ്ങളോട് വിളിച്ചു പറയുന്നു;","poem":1},{"text":"എന്‍റെ സ്വരം മനുഷ്യപുത്രന്മാരുടെ അടുക്കലേക്ക് വരുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അല്പബുദ്ധികളേ, സൂക്ഷ്മബുദ്ധി ഗ്രഹിച്ചുകൊള്ളുവിൻ;","poem":1},{"text":"മൂഢന്മാരേ, വിവേകഹൃദയന്മാരാകുവിൻ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"കേൾക്കുവിൻ, ഞാൻ ഉൽകൃഷ്ടമായത് സംസാരിക്കും;","poem":1},{"text":"എന്‍റെ അധരങ്ങൾ തുറക്കുന്നത് നേരിന് ആയിരിക്കും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"എന്‍റെ വായ് സത്യം സംസാരിക്കും;","poem":1},{"text":"ദുഷ്ടത എന്‍റെ അധരങ്ങൾക്ക് അറപ്പാകുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"എന്‍റെ വായിലെ മൊഴി സകലവും നീതിയാകുന്നു;","poem":1},{"text":"അവയിൽ വക്രവും വികടവുമായത് ഒന്നുമില്ല.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവയെല്ലാം ബുദ്ധിമാന് തെളിവും","poem":1},{"text":"പരിജ്ഞാനം ലഭിച്ചവർക്ക് നേരും ആകുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"വെള്ളിയെക്കാൾ എന്‍റെ പ്രബോധനവും","poem":1},{"text":"മേൽത്തരമായ പൊന്നിനെക്കാൾ പരിജ്ഞാനവും കൈക്കൊള്ളുവിൻ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ജ്ഞാനം മുത്തുകളെക്കാൾ നല്ലതാകുന്നു;","poem":1},{"text":"മനോഹരമായതൊന്നും അതിന്നു തുല്യമാകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ജ്ഞാനം എന്ന ഞാൻ സൂക്ഷ്മബുദ്ധിയോടൊപ്പം വസിക്കുന്നു;","poem":1},{"text":"പരിജ്ഞാനവും വകതിരിവും ഞാൻ കണ്ടെത്തുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"യഹോവാഭക്തി ദോഷത്തെ വെറുക്കുന്നതാകുന്നു;","poem":1},{"text":"ഡംഭം, അഹങ്കാരം, ദുർമാർഗ്ഗം, വക്രതയുള്ള വായ് എന്നിവ ഞാൻ പകക്കുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ആലോചനയും പരിജ്ഞാനവും എനിക്കുള്ളത്;","poem":1},{"text":"ഞാൻ തന്നെ വിവേകം; എനിക്ക് വീര്യബലം ഉണ്ട്.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഞാൻ മുഖാന്തരം രാജാക്കന്മാർ വാഴുന്നു;","poem":1},{"text":"പ്രഭുക്കന്മാർ നീതി നടത്തുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ഞാൻ മുഖാന്തരം അധിപതിമാരും പ്രധാനികളും","poem":1},{"text":"ഭൂമിയിലെ ന്യായാധിപന്മാരൊക്കെയും ആധിപത്യം നടത്തുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"എന്നെ സ്നേഹിക്കുന്നവരെ ഞാൻ സ്നേഹിക്കുന്നു;","poem":1},{"text":"എന്നെ ജാഗ്രതയോടെ അന്വേഷിക്കുന്നവർ എന്നെ കണ്ടെത്തും.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"എന്‍റെ പക്കൽ ധനവും മാനവും","poem":1},{"text":"പുരാതനസമ്പത്തും നീതിയും ഉണ്ട്.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"എന്‍റെ ഫലം പൊന്നിലും തങ്കത്തിലും","poem":1},{"text":"എന്‍റെ ആദായം മേല്ത്തരമായ വെള്ളിയിലും നല്ലത്.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"എന്നെ സ്നേഹിക്കുന്നവർക്ക് വസ്തുവക അവകാശമാക്കിക്കൊടുക്കുകയും","poem":1},{"text":"അവരുടെ ഭണ്ഡാരങ്ങളെ നിറയ്ക്കുകയും ചെയ്യേണ്ടതിന്","poem":2},{"noteId":1}]},{"type":"verse","number":21,"content":[{"text":"ഞാൻ നീതിയുടെ മാർഗ്ഗത്തിലും","poem":1},{"text":"ന്യായത്തിന്‍റെ പാതകളിലും നടക്കുന്നു.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"യഹോവ പണ്ടുപണ്ടേ തന്‍റെ വഴിയുടെ ആരംഭമായി,","poem":1},{"text":"തന്‍റെ പ്രവൃത്തികളുടെ ആദ്യമായി എന്നെ ഉളവാക്കി.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ഞാൻ പുരാതനമേ, ആദിയിൽ തന്നെ,","poem":1},{"text":"ഭൂമിയുടെ ഉല്പത്തിക്ക് മുമ്പ് നിയമിക്കപ്പെട്ടിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ആഴങ്ങൾ ഇല്ലാതിരുന്നപ്പോൾ ഞാൻ ജനിച്ചിരിക്കുന്നു;","poem":1},{"text":"വെള്ളം നിറഞ്ഞ ഉറവുകൾ ഇല്ലാതിരുന്നപ്പോൾ തന്നെ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"പർവ്വതങ്ങൾ സ്ഥാപിച്ചതിനു മുമ്പെയും","poem":1},{"text":"കുന്നുകൾക്കു മുമ്പെയും ഞാൻ ജനിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"അവിടുന്ന് ഭൂമിയെയും വയലുകളെയും","poem":1},{"text":"ഭൂതലത്തിന്‍റെ പൊടിയുടെ തുകയെയും","poem":2},{"lineBreak":true},{"text":"ഉണ്ടാക്കിയിട്ടില്ലാത്ത സമയത്ത് തന്നെ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"അവിടുന്ന് ആകാശത്തെ ഉറപ്പിച്ചപ്പോൾ ഞാൻ അവിടെ ഉണ്ടായിരുന്നു;","poem":1},{"text":"അവിടുന്ന് ആഴത്തിന്‍റെ ഉപരിഭാഗത്ത് വൃത്തം വരച്ചപ്പോഴും","poem":2}]},{"type":"verse","number":28,"content":[{"text":"അവിടുന്ന് മീതെ മേഘങ്ങളെ ഉറപ്പിച്ചപ്പോഴും","poem":1},{"text":"ആഴത്തിന്‍റെ ഉറവുകളെ ബലപ്പെടുത്തിയപ്പോഴും","poem":2}]},{"type":"verse","number":29,"content":[{"text":"വെള്ളം അവിടുത്തെ കല്പനയെ അതിക്രമിക്കാത്തവണ്ണം","poem":1},{"text":"അവിടുന്ന് സമുദ്രത്തിന് അതിരിട്ടപ്പോഴും","poem":2},{"lineBreak":true},{"text":"ഭൂമിയുടെ അടിസ്ഥാനം ഇട്ടപ്പോഴും","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ഞാൻ അവിടുത്തെ അടുക്കൽ ശില്പി","poem":1},{"noteId":2},{"text":"ആയിരുന്നു;","poem":1},{"text":"ഇടവിടാതെ അവിടുത്തെ മുമ്പിൽ വിനോദിച്ചുകൊണ്ട്","poem":2},{"lineBreak":true},{"text":"ദിനംപ്രതി അവിടുത്തെ പ്രമോദമായിരുന്നു.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"അവിടുത്തെ ഭൂതലത്തിൽ ഞാൻ വിനോദിച്ചുകൊണ്ടിരുന്നു;","poem":1},{"text":"എന്‍റെ പ്രമോദം മനുഷ്യപുത്രന്മാരോടുകൂടി ആയിരുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"ആകയാൽ മക്കളേ, എന്‍റെ വാക്ക് കേട്ടുകൊള്ളുവിൻ;","poem":1},{"text":"എന്‍റെ വഴികളെ പ്രമാണിക്കുന്നവർ ഭാഗ്യവാന്മാർ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"പ്രബോധനം കേട്ടു ബുദ്ധിമാന്മാരായിരിക്കുവിൻ;","poem":1},{"text":"അതിനെ ത്യജിച്ചുകളയരുത്.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ദിവസംപ്രതി എന്‍റെ പടിവാതില്ക്കൽ ജാഗരിച്ചും","poem":1},{"text":"എന്‍റെ വാതില്ക്കൽ കാത്തുകൊണ്ടും","poem":2},{"lineBreak":true},{"text":"എന്‍റെ വാക്ക് കേട്ടനുസരിക്കുന്ന മനുഷ്യൻ ഭാഗ്യവാൻ.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"എന്നെ കണ്ടെത്തുന്നവൻ ജീവനെ കണ്ടെത്തുന്നു;","poem":1},{"text":"അവൻ യഹോവയുടെ കടാക്ഷം പ്രാപിക്കുന്നു.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"എന്നോട് പാപം ചെയ്യുന്നവനോ തനിക്കു പ്രാണഹാനി വരുത്തുന്നു;","poem":1},{"text":"എന്നെ ദ്വേഷിക്കുന്നവരൊക്കെയും മരണത്തെ ഇച്ഛിക്കുന്നു.”","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"അവരുടെ ഭണ്ഡാരങ്ങളെ നിറയ്ക്കുകയും ചെയ്യേണ്ടതിന് ഞാന്‍ സത്യത്തിലും നീതിയുടെ മാർഗ്ഗത്തിലും അവരെ നടക്കുമാറാക്കി","reference":{"chapter":8,"verse":20}},{"noteId":2,"caller":"+","text":"ശില്പി പ്രിയ പുത്രന്‍","reference":{"chapter":8,"verse":30}}]},"thisChapterLink":"/api/mal_irv/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}