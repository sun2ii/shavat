{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":102,"content":[{"type":"heading","content":["അരിഷ്ടന്‍റെ പ്രാർത്ഥന"]},{"type":"hebrew_subtitle","content":["അരിഷ്ടന്‍റെ പ്രാർത്ഥന; അവൻ ക്ഷീണിച്ച് യഹോവയുടെ മുൻപാകെ തന്‍റെ സങ്കടം പകരുമ്പോൾ സമർപ്പിച്ചത്."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"യഹോവേ, എന്‍റെ പ്രാർത്ഥന കേൾക്കേണമേ;","poem":1},{"text":"എന്‍റെ നിലവിളി തിരുസന്നിധിയിൽ വരുമാറാകട്ടെ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"കഷ്ടദിവസത്തിൽ തിരുമുഖം എനിക്ക് മറയ്ക്കരുതേ;","poem":1},{"text":"അങ്ങേയുടെ ചെവി എങ്കലേക്ക് ചായിക്കേണമേ;","poem":2},{"text":"ഞാൻ വിളിക്കുന്ന നാളിൽ വേഗത്തിൽ എനിക്ക് ഉത്തരമരുളേണമേ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"എന്‍റെ നാളുകൾ പുകപോലെ കഴിഞ്ഞുപോകുന്നു;","poem":1},{"text":"എന്‍റെ അസ്ഥികൾ തീക്കൊള്ളിപോലെ വെന്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"എന്‍റെ ഹൃദയം അരിഞ്ഞ പുല്ലുപോലെ ഉണങ്ങിയിരിക്കുന്നു;","poem":1},{"text":"ഞാൻ ഭക്ഷണം കഴിക്കുവാൻ മറന്നുപോകുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"എന്‍റെ ഞരക്കത്തിന്‍റെ ഒച്ചനിമിത്തം","poem":1},{"text":"എന്‍റെ അസ്ഥികൾ മാംസത്തോടു പറ്റുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഞാൻ മരുഭൂമിയിലെ വേഴാമ്പൽ","poem":1},{"noteId":101},{"text":"പോലെ ആകുന്നു;","poem":1},{"text":"ശൂന്യസ്ഥലത്തെ മൂങ്ങാപോലെ തന്നെ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ഞാൻ ഉറക്കം ഇളച്ചിരിക്കുന്നു;","poem":1},{"text":"വീട്ടിന്മുകളിൽ തനിച്ചിരിക്കുന്ന കുരികിൽ പോലെ ആകുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"എന്‍റെ ശത്രുക്കൾ ഇടവിടാതെ എന്നെ നിന്ദിക്കുന്നു;","poem":1},{"text":"എന്നോട് ചീറുന്നവർ എന്‍റെ പേര് ചൊല്ലി ശപിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഞാൻ അപ്പം പോലെ ചാരം തിന്നുന്നു;","poem":1},{"text":"എന്‍റെ പാനീയത്തിൽ കണ്ണുനീർ കലക്കുന്നു;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അങ്ങേയുടെ കോപവും ക്രോധവും ഹേതുവായി തന്നെ;","poem":1},{"text":"അങ്ങ് എന്നെ എടുത്ത് എറിഞ്ഞുകളഞ്ഞുവല്ലോ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"എന്‍റെ ആയുസ്സിന്‍റെ ദിനങ്ങള്‍ ചാഞ്ഞുപോകുന്ന നിഴൽപോലെയാകുന്നു;","poem":1},{"text":"ഞാൻ പുല്ലുപോലെ ഉണങ്ങിപ്പോകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"യഹോവേ, അങ്ങ് എന്നേക്കുമുള്ളവൻ;","poem":1},{"text":"അങ്ങേയുടെ നാമം തലമുറതലമുറയായി നിലനില്ക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അങ്ങ് എഴുന്നേറ്റ് സീയോനോട് കരുണ കാണിക്കും;","poem":1},{"text":"അവളോടു കൃപ കാണിക്കുവാനുള്ള കാലം,","poem":2},{"lineBreak":true},{"text":"അതേ, അതിനുള്ള സമയം വന്നിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അങ്ങേയുടെ ദാസന്മാർക്ക് അവളുടെ കല്ലുകളോടു താത്പര്യവും","poem":1},{"text":"അവളുടെ പൂഴിയോട് അലിവും തോന്നുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"യഹോവ സീയോനെ പണിയുകയും","poem":1},{"text":"തന്‍റെ മഹത്വത്തിൽ പ്രത്യക്ഷനാകുകയും ചെയ്യും","poem":2}]},{"type":"verse","number":16,"content":[{"text":"കർത്താവ് അഗതികളുടെ പ്രാർത്ഥന കടാക്ഷിക്കുകയും","poem":1},{"text":"അവരുടെ പ്രാർത്ഥന നിരസിക്കാതെയിരിക്കുകയും ചെയ്തതുകൊണ്ട്","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ജനതകൾ യഹോവയുടെ നാമത്തെയും","poem":1},{"text":"ഭൂമിയിലെ സകലരാജാക്കന്മാരും അങ്ങേയുടെ മഹത്വത്തെയും ഭയപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"വരുവാനിരിക്കുന്ന തലമുറക്കു വേണ്ടി ഇത് എഴുതിവയ്ക്കും;","poem":1},{"text":"സൃഷ്ടിക്കപ്പെടുവാനുള്ള ജനം യഹോവയെ സ്തുതിക്കും.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"യഹോവ ഉയരത്തിൽ, വിശുദ്ധമന്ദിരത്തിൽനിന്നു താഴേയ്ക്കു നോക്കി;","poem":1},{"text":"സ്വർഗ്ഗത്തിൽനിന്ന് അവിടുന്ന് ഭൂമിയെ വീക്ഷിച്ചു,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ബദ്ധന്മാരുടെ ഞരക്കം കേൾക്കുവാനും","poem":1},{"text":"മരണത്തിന് നിയമിക്കപ്പെട്ടവരെ വിടുവിക്കുവാനും","poem":2}]},{"type":"verse","number":21,"content":[{"text":"സീയോനിൽ യഹോവയുടെ നാമത്തെയും","poem":1},{"text":"യെരൂശലേമിൽ അവിടുത്തെ സ്തുതിയെയും പ്രസ്താവിക്കേണ്ടതിനും","poem":2}]},{"type":"verse","number":22,"content":[{"text":"യഹോവയെ സേവിക്കുവാൻ","poem":1},{"text":"ജനതകളും രാജ്യങ്ങളും കൂടിവന്നപ്പോൾ,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ദൈവം ആയുസ്സിന്‍റെ മധ്യത്തില്‍ വച്ചു","poem":1},{"noteId":102},{"text":"എന്‍റെ ബലം ക്ഷയിപ്പിച്ചു;","poem":1},{"text":"അവിടുന്ന് എന്‍റെ നാളുകൾ ചുരുക്കിയിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“എന്‍റെ ദൈവമേ, ആയുസ്സിന്‍റെ മദ്ധ്യത്തിൽ എന്നെ എടുത്തുകളയരുതേ” എന്നു ഞാൻ പറഞ്ഞു;","poem":1},{"text":"അങ്ങേയുടെ സംവത്സരങ്ങൾ തലമുറതലമുറയായി ഇരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"പൂർവ്വകാലത്ത് അങ്ങ് ഭൂമിക്ക് അടിസ്ഥാനമിട്ടു;","poem":1},{"text":"ആകാശം അങ്ങേയുടെ കൈകളുടെ പ്രവൃത്തി ആകുന്നു.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"അവ നശിക്കും അവിടുന്ന് നിലനില്ക്കും;","poem":1},{"text":"അവയെല്ലാം വസ്ത്രംപോലെ പഴകിപ്പോകും;","poem":2},{"text":"ഉടുപ്പുപോലെ അങ്ങ് അവയെ മാറ്റും;","poem":1},{"text":"അവ മാറിപ്പോകുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"അവിടുന്ന് അനന്യനാകുന്നു;","poem":1},{"text":"അങ്ങേയുടെ സംവത്സരങ്ങൾ അവസാനിക്കുകയുമില്ല.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"അങ്ങേയുടെ ദാസന്മാരുടെ മക്കൾ നിർഭയം വസിക്കും;","poem":1},{"text":"അവരുടെ സന്തതി അങ്ങേയുടെ സന്നിധിയിൽ നിലനില്ക്കും.","poem":2}]}],"footnotes":[{"noteId":101,"caller":"+","text":"വേഴാമ്പൽ കഴുകന്‍ അല്ലെങ്കില്‍ മൂങ്ങ","reference":{"chapter":102,"verse":6}},{"noteId":102,"caller":"+","text":"ദൈവം ആയുസ്സിന്‍റെ മധ്യത്തില്‍ വച്ചു ദൈവം വഴിയിൽവച്ച്","reference":{"chapter":102,"verse":23}}]},"thisChapterLink":"/api/mal_irv/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}