{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":103,"content":[{"type":"heading","content":["യഹോവയെ വാഴ്ത്തുക"]},{"type":"hebrew_subtitle","content":["ദാവീദിന്‍റെ ഒരു സങ്കീർത്തനം."]},{"type":"verse","number":1,"content":[{"text":"എൻ മനമേ, യഹോവയെ വാഴ്ത്തുക;","poem":1},{"text":"എന്‍റെ സർവ്വാന്തരംഗവുമേ, അവിടുത്തെ വിശുദ്ധനാമത്തെ വാഴ്ത്തുക.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"എൻ മനമേ, യഹോവയെ വാഴ്ത്തുക;","poem":1},{"text":"അവിടുന്ന് നൽകിയ ഉപകാരങ്ങൾ ഒന്നും മറക്കരുത്.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ദൈവം നിന്‍റെ എല്ലാ അകൃത്യങ്ങളും മോചിക്കുന്നു;","poem":1},{"text":"നിന്‍റെ സകലരോഗങ്ങളും സൗഖ്യമാക്കുന്നു;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"കർത്താവ് നിന്‍റെ ജീവനെ നാശത്തിൽനിന്ന് വീണ്ടെടുക്കുന്നു;","poem":1},{"text":"അവിടുന്ന് സ്നേഹത്താലും കരുണയാലും എന്നെ അനുഗ്രഹിക്കുന്നു","poem":2},{"noteId":103},{"text":".","poem":2}]},{"type":"verse","number":5,"content":[{"text":"നിന്‍റെ യൗവനം കഴുകനെപ്പോലെ പുതുക്കപ്പെടുവാനായി","poem":1},{"text":"അവിടുന്ന് നിന്‍റെ വായെ നന്മകൊണ്ടു തൃപ്തിപ്പെടുത്തുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"യഹോവ സകല പീഡിതന്മാർക്കും വേണ്ടി","poem":1},{"text":"നീതിയും ന്യായവും നടത്തുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ദൈവം തന്‍റെ വഴികൾ മോശെയെയും","poem":1},{"text":"തന്‍റെ പ്രവൃത്തികൾ യിസ്രായേൽമക്കളെയും അറിയിച്ചു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"യഹോവ കരുണയും കൃപയും നിറഞ്ഞവൻ ആകുന്നു;","poem":1},{"text":"ദീർഘക്ഷമയും മഹാദയയും ഉള്ളവൻ തന്നെ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ദൈവം എല്ലായ്‌പ്പോഴും ഭർത്സിക്കുകയില്ല;","poem":1},{"text":"എന്നേക്കും കോപം സൂക്ഷിക്കുകയുമില്ല.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ദൈവം നമ്മുടെ പാപങ്ങൾക്ക് തക്കവണ്ണം നമ്മളോടു ചെയ്യുന്നില്ല;","poem":1},{"text":"നമ്മുടെ അകൃത്യങ്ങൾക്കു തക്കവണ്ണം നമ്മളെ ശിക്ഷിക്കുന്നുമില്ല.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ആകാശം ഭൂമിക്കുമീതെ ഉയർന്നിരിക്കുന്നതുപോലെ","poem":1},{"text":"അവിടുത്തെ ദയ അവിടുത്തെ ഭക്തന്മാരോട് വലുതായിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ഉദയം അസ്തമയത്തോട് അകന്നിരിക്കുന്നതുപോലെ","poem":1},{"text":"ദൈവം നമ്മുടെ ലംഘനങ്ങളെ നമ്മോട് അകറ്റിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അപ്പന് മക്കളോട് കരുണ തോന്നുന്നതുപോലെ","poem":1},{"text":"യഹോവയ്ക്ക് തന്‍റെ ഭക്തന്മാരോട് കരുണ തോന്നുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"കർത്താവ് നമ്മുടെ പ്രകൃതം അറിയുന്നുവല്ലോ;","poem":1},{"text":"നാം കേവലം പൊടി മാത്രം എന്നു അവിടുന്ന് ഓർക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"മനുഷ്യന്‍റെ ആയുസ്സ് പുല്ലുപോലെയാകുന്നു;","poem":1},{"text":"വയലിലെ പൂപോലെ അവൻ പൂക്കുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"കാറ്റ് അതിന്മേൽ അടിക്കുമ്പോൾ അത് ഇല്ലാതെ പോകുന്നു;","poem":1},{"text":"അത് നിന്ന സ്ഥലം പിന്നീട് അതിനെ അറിയുകയുമില്ല.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"യഹോവയുടെ ദയ എന്നും എന്നേക്കും അവിടുത്തെ ഭക്തന്മാർക്കും","poem":1},{"text":"തന്‍റെ നീതി മക്കളുടെ മക്കൾക്കും ഉണ്ടാകും.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"കർത്താവിന്‍റെ നിയമം പ്രമാണിക്കുന്നവർക്കും","poem":1},{"text":"അവിടുത്തെ കല്പനകൾ ഓർത്തു ആചരിക്കുന്നവർക്കും തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"യഹോവ തന്‍റെ സിംഹാസനം സ്വർഗ്ഗത്തിൽ സ്ഥാപിച്ചിരിക്കുന്നു;","poem":1},{"text":"അവിടുത്തെ രാജത്വം സകലത്തെയും അടക്കി ഭരിക്കുന്നു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ദൈവത്തിന്‍റെ വാക്കുകളുടെ ശബ്ദം കേട്ടു അവിടുത്തെ ആജ്ഞ അനുസരിക്കുന്ന ശക്തന്മാരായ","poem":1},{"text":"അവിടുത്തെ ദൂതന്മാരേ, യഹോവയെ വാഴ്ത്തുവിൻ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ദൈവത്തിന്‍റെ ഇഷ്ടം ചെയ്യുന്ന ശുശ്രൂഷക്കാരായി","poem":1},{"text":"അവിടുത്തെ സകലസൈന്യങ്ങളുമേ, യഹോവയെ വാഴ്ത്തുവിൻ;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ദൈവത്തിന്‍റെ അധികാരത്തിന്‍റെ കീഴിലുള്ള","poem":1},{"text":"കർത്താവിന്‍റെ കൈവേലയായ ഏവരുമേ, യഹോവയെ വാഴ്ത്തുവിൻ;","poem":2},{"lineBreak":true},{"text":"എൻ മനമേ, യഹോവയെ വാഴ്ത്തുക.","poem":1}]}],"footnotes":[{"noteId":103,"caller":"+","text":"അവിടുന്ന് സ്നേഹത്താലും കരുണയാലും എന്നെ അനുഗ്രഹിക്കുന്നു അവിടുന്ന് ദയയും കരുണയും നിന്നെ അണിയിക്കുന്നു","reference":{"chapter":103,"verse":4}}]},"thisChapterLink":"/api/mal_irv/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}