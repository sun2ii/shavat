{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":104,"content":[{"type":"heading","content":["സ്രഷ്ടാവിനെ സ്തുതിപ്പിന്‍"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"എൻ മനമേ, യഹോവയെ വാഴ്ത്തുക;","poem":1},{"text":"എന്‍റെ ദൈവമായ യഹോവേ, അങ്ങ് ഏറ്റവും വലിയവൻ;","poem":2},{"lineBreak":true},{"text":"മഹത്വവും തേജസ്സും അങ്ങ് ധരിച്ചിരിക്കുന്നു;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"വസ്ത്രം ധരിക്കുന്നതുപോലെ അങ്ങ് പ്രകാശം ധരിക്കുന്നു;","poem":1},{"text":"തിരശ്ശീലപോലെ അവിടുന്ന് ആകാശത്തെ വിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ദൈവം തന്‍റെ മാളികകളുടെ തുലാങ്ങൾ വെള്ളത്തിന്മേൽ നിരത്തുന്നു;","poem":1},{"text":"മേഘങ്ങളെ തന്‍റെ തേരാക്കി, കാറ്റിൻ ചിറകിന്മേൽ സഞ്ചരിക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"യഹോവ കാറ്റുകളെ തന്‍റെ ദൂതന്മാരും","poem":1},{"text":"അഗ്നിജ്വാലയെ തന്‍റെ ശുശ്രൂഷകന്മാരും ആക്കുന്നു","poem":2},{"noteId":104},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"അവിടുന്ന് ഭൂമി ഒരിക്കലും ഇളകിപ്പോകാതെ","poem":1},{"text":"അതിന്‍റെ അടിസ്ഥാനത്തിന്മേൽ സ്ഥാപിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അങ്ങ് ഭൂമിയെ വസ്ത്രംകൊണ്ടെന്നപോലെ ആഴികൊണ്ടു മൂടി;","poem":1},{"text":"വെള്ളം പർവ്വതങ്ങൾക്കു മീതെ നിന്നിരുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവ അങ്ങേയുടെ ശാസനയാൽ ഓടിപ്പോയി;","poem":1},{"text":"അങ്ങേയുടെ ഇടിമുഴക്കത്താൽ അവ തിടുക്കത്തിൽ നീങ്ങിപ്പോയി","poem":2}]},{"type":"verse","number":8,"content":[{"text":"മലകൾ പൊങ്ങി, താഴ്വരകൾ താണു","poem":1},{"text":"അവിടുന്ന് അവയ്ക്കു നിശ്ചയിച്ച സ്ഥലത്തേക്ക് നീങ്ങിപ്പോയി;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഭൂമിയെ മൂടിക്കളയുവാൻ മടങ്ങിവരാതിരിക്കേണ്ടതിന്","poem":1},{"text":"അങ്ങ് അവയ്ക്ക് ലംഘിക്കാൻ കഴിയാത്ത ഒരു അതിര്‍ ഇട്ടു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ദൈവം ഉറവുകളെ താഴ്വരകളിലേക്ക് അയയ്ക്കുന്നു;","poem":1},{"text":"അവ മലകളുടെ ഇടയിൽകൂടി ഒഴുകുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അവയിൽ നിന്ന് വയലിലെ സകലമൃഗങ്ങളും കുടിക്കുന്നു;","poem":1},{"text":"കാട്ടുകഴുതകൾ അവയുടെ ദാഹം തീർക്കുന്നു;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവയുടെ തീരങ്ങളിൽ ആകാശത്തിലെ പറവകൾ വസിക്കുകയും","poem":1},{"text":"കൊമ്പുകളുടെ ഇടയിൽ പാടുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ദൈവം ആകാശത്തില്‍ നിന്ന്","poem":1},{"noteId":105},{"text":"മലകളെ നനയ്ക്കുന്നു;","poem":1},{"text":"ഭൂമിക്ക് അങ്ങേയുടെ പ്രവൃത്തികളുടെ ഫലത്താൽ തൃപ്തിവരുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവിടുന്ന് മൃഗങ്ങൾക്ക് പുല്ലും","poem":1},{"text":"മനുഷ്യന്‍റെ ഉപയോഗത്തിനായി സസ്യവും മുളപ്പിക്കുന്നു;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ദൈവം ഭൂമിയിൽനിന്ന് ആഹാരവും","poem":1},{"text":"മനുഷ്യന്‍റെ ഹൃദയത്തെ സന്തോഷിപ്പിക്കുന്ന വീഞ്ഞും","poem":2},{"lineBreak":true},{"text":"അവന്‍റെ മുഖം മിനുക്കുവാൻ എണ്ണയും","poem":2},{"lineBreak":true},{"text":"മനുഷ്യന്‍റെ ഹൃദയത്തെ ബലപ്പെടുത്തുന്ന അപ്പവും ഉത്ഭവിപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"യഹോവയുടെ വൃക്ഷങ്ങൾക്ക് തൃപ്തിവരുന്നു;","poem":1},{"text":"കർത്താവ് നട്ടിട്ടുള്ള ലെബാനോനിലെ ദേവദാരുക്കൾക്കു തന്നെ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവിടെ പക്ഷികൾ കൂടുണ്ടാക്കുന്നു;","poem":1},{"text":"പെരുഞാറയ്ക്ക് സരളവൃക്ഷങ്ങൾ പാർപ്പിടമാകുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ഉയർന്നമലകൾ കാട്ടാടുകൾക്കും","poem":1},{"text":"പാറകൾ കുഴിമുയലുകൾക്കും സങ്കേതമാകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"കർത്താവ് കാലനിർണ്ണയത്തിനായി ചന്ദ്രനെ നിയമിച്ചു;","poem":1},{"text":"സൂര്യൻ തന്‍റെ അസ്തമയം അറിയുന്നു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അങ്ങ് ഇരുട്ട് വരുത്തുന്നു; രാത്രി ഉണ്ടാകുന്നു;","poem":1},{"text":"അപ്പോൾ കാട്ടുമൃഗങ്ങൾ എല്ലാം സഞ്ചാരം തുടങ്ങുന്നു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ബാലസിംഹങ്ങൾ ഇരയ്ക്കായി അലറുന്നു;","poem":1},{"text":"അവ ദൈവത്തോട് അവയുടെ ആഹാരം ചോദിക്കുന്നു.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"സൂര്യൻ ഉദിക്കുമ്പോൾ അവ മടങ്ങുന്നു;","poem":1},{"text":"അവയുടെ ഗുഹകളിൽ ചെന്നു കിടക്കുന്നു.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"മനുഷ്യൻ തന്‍റെ പണിക്കായി പുറപ്പെടുന്നു;","poem":1},{"text":"സന്ധ്യവരെയുള്ള തന്‍റെ വേലയ്ക്കായി തന്നെ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"യഹോവേ, അങ്ങേയുടെ പ്രവൃത്തികൾ എത്ര പെരുകിയിരിക്കുന്നു!","poem":1},{"text":"ജ്ഞാനത്തോടെ അങ്ങ് അവയെല്ലാം ഉണ്ടാക്കിയിരിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"ഭൂമി അങ്ങേയുടെ സൃഷ്ടികളാൽ നിറഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"വലിപ്പവും വിസ്താരവും ഉള്ള സമുദ്രം അതാ കിടക്കുന്നു!","poem":1},{"text":"അതിൽ സഞ്ചരിക്കുന്ന ചെറിയതും വലിയതുമായ അസംഖ്യജന്തുക്കൾ ഉണ്ട്.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"അതിൽ കപ്പലുകൾ ഓടുന്നു;","poem":1},{"text":"അതിൽ കളിക്കുവാൻ അങ്ങ് ഉണ്ടാക്കിയ ലിവ്യാഥാൻ","poem":2},{"noteId":106},{"text":"ഉണ്ട്.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"തക്കസമയത്ത് ഭക്ഷണം കിട്ടേണ്ടതിന്","poem":1},{"text":"ഇവ എല്ലാം അങ്ങയെ കാത്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"അങ്ങ് കൊടുക്കുന്നത് അവ പെറുക്കുന്നു","poem":1},{"text":"തൃക്കൈ തുറക്കുമ്പോൾ","poem":2},{"lineBreak":true},{"text":"അവയ്ക്ക് നന്മകൊണ്ട് തൃപ്തിവരുന്നു.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"തിരുമുഖം മറയ്ക്കുമ്പോൾ അവ ഭ്രമിച്ചുപോകുന്നു;","poem":1},{"text":"അങ്ങ് അവയുടെ ശ്വാസം എടുക്കുമ്പോൾ","poem":2},{"lineBreak":true},{"text":"അവ ചത്ത് പൊടിയിലേക്ക് തിരികെ ചേരുന്നു;","poem":2}]},{"type":"verse","number":30,"content":[{"text":"അങ്ങ് അങ്ങേയുടെ ശ്വാസം അയയ്ക്കുമ്പോൾ അവ സൃഷ്ടിക്കപ്പെടുന്നു;","poem":1},{"text":"അങ്ങ് ഭൂമിയുടെ മുഖം പുതുക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"യഹോവയുടെ മഹത്വം എന്നേക്കും നിലനില്‍ക്കട്ടെ;","poem":1},{"text":"യഹോവ തന്‍റെ പ്രവൃത്തികളിൽ സന്തോഷിക്കട്ടെ.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"കർത്താവ് ഭൂമിയെ നോക്കുന്നു, അത് വിറയ്ക്കുന്നു;","poem":1},{"text":"അവിടുന്ന് മലകളെ തൊടുന്നു, അവ പുകയുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"എന്‍റെ ആയുഷ്ക്കാലമൊക്കെയും ഞാൻ യഹോവയ്ക്കു പാടും;","poem":1},{"text":"ഞാൻ ഉള്ള കാലത്തോളം എന്‍റെ ദൈവത്തിന് കീർത്തനം പാടും.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"എന്‍റെ ധ്യാനം അവിടുത്തേയ്ക്ക് പ്രസാദകരമായിരിക്കട്ടെ;","poem":1},{"text":"ഞാൻ യഹോവയിൽ സന്തോഷിക്കും.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"പാപികൾ ഭൂമിയിൽനിന്ന് നശിച്ചുപോകട്ടെ;","poem":1},{"text":"ദുഷ്ടന്മാർ ഇല്ലാതെയാകട്ടെ;","poem":2},{"lineBreak":true},{"text":"എൻ മനമേ, യഹോവയെ വാഴ്ത്തുക;","poem":1},{"lineBreak":true},{"text":"യഹോവയെ സ്തുതിക്കുവിൻ.","poem":1}]}],"footnotes":[{"noteId":104,"caller":"+","text":"യഹോവ കാറ്റുകളെ തന്‍റെ ദൂതന്മാരും അഗ്നിജ്വാലയെ തന്‍റെ ശുശ്രൂഷകന്മാരും ആക്കുന്നു യഹോവ കാറ്റുകളെ തന്‍റെ ശുശ്രൂഷകന്മാരും അഗ്നിജ്വാലയെ തന്‍റെ ദൂതന്മാരും ആക്കുന്നു","reference":{"chapter":104,"verse":4}},{"noteId":105,"caller":"+","text":"ദൈവം ആകാശത്തില്‍ നിന്ന് ദൈവം തന്‍റെ മാളികകളിൽ","reference":{"chapter":104,"verse":13}},{"noteId":106,"caller":"+","text":"ലിവ്യാഥാൻ സങ്കീ: 74:14 നോക്കുക","reference":{"chapter":104,"verse":26}}]},"thisChapterLink":"/api/mal_irv/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}