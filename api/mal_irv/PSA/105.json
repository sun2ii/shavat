{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":105,"content":[{"type":"heading","content":["യിസ്രായേല്‍ ജനത്തോടുള്ള ദൈവത്തിന്‍റെ വിശ്വസ്തത"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"യഹോവയ്ക്കു സ്തോത്രം ചെയ്യുവിൻ; കർത്താവിന്‍റെ നാമം വിളിച്ചപേക്ഷിക്കുവിൻ;","poem":1},{"text":"അവിടുത്തെ പ്രവൃത്തികൾ ജനതകളുടെ ഇടയിൽ അറിയിക്കുവിൻ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"കർത്താവിന് പാടുവിൻ; ദൈവത്തിന് കീർത്തനം പാടുവിൻ;","poem":1},{"text":"അവിടുത്തെ സകല അത്ഭുതങ്ങളെയും കുറിച്ച് സംസാരിക്കുവിൻ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ദൈവത്തിന്‍റെ വിശുദ്ധനാമത്തിൽ പ്രശംസിക്കുവിൻ;","poem":1},{"text":"യഹോവയെ അന്വേഷിക്കുന്നവരുടെ ഹൃദയം സന്തോഷിക്കട്ടെ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"യഹോവയെയും അവിടുത്തെ ബലത്തെയും തിരയുവിൻ;","poem":1},{"text":"ദൈവമുഖം ഇടവിടാതെ അന്വേഷിക്കുവിൻ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ദൈവത്തിന്‍റെ ദാസനായ അബ്രാഹാമിന്‍റെ സന്തതിയും","poem":1},{"text":"അവിടുന്ന് തിരഞ്ഞെടുത്ത യാക്കോബിന്‍റെ മക്കളുമേ,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവിടുന്ന് ചെയ്ത അത്ഭുതങ്ങളും അവിടുത്തെ അടയാളങ്ങളും","poem":1},{"text":"അവിടുത്തെ വായിൽനിന്നുള്ള ന്യായവിധികളും ഓർത്തുകൊള്ളുവിൻ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"കർത്താവ് നമ്മുടെ ദൈവമായ യഹോവയാകുന്നു;","poem":1},{"text":"അവിടുത്തെ ന്യായവിധികൾ സർവ്വഭൂമിയിലും ഉണ്ട്.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"കർത്താവ് തന്‍റെ നിയമം ശാശ്വതമായും","poem":1},{"text":"താൻ കല്പിച്ച വചനം ആയിരം തലമുറവരെയും ഓർമ്മിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ദൈവം അബ്രാഹാമിനോട് ചെയ്ത നിയമവും","poem":1},{"text":"യിസ്ഹാക്കിനോടു ചെയ്ത സത്യവും തന്നെ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ദൈവം അതിനെ യാക്കോബിന് ഒരു ചട്ടമായും","poem":1},{"text":"യിസ്രായേലിനു ഒരു നിത്യനിയമമായും നിയമിച്ചു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“നിന്‍റെ അവകാശത്തിന്‍റെ ഓഹരിയായി","poem":1},{"text":"ഞാൻ നിനക്കു കനാൻദേശം തരും” എന്നരുളിച്ചെയ്തു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"അവർ അന്നു എണ്ണത്തിൽ കുറഞ്ഞവരും ആൾബലത്തിൽ ചുരുങ്ങിയവരും","poem":1},{"text":"പരദേശികളും ആയിരുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അവർ ഒരു ജനതയെ വിട്ട് മറ്റൊരു ജനതയുടെ അടുക്കലേക്കും","poem":1},{"text":"ഒരു രാജ്യം വിട്ട് മറ്റൊരു ജനത്തിന്‍റെ അടുക്കലേക്കും പോയിരുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവരെ പീഡിപ്പിക്കുവാൻ കർത്താവ് ആരെയും സമ്മതിച്ചില്ല;","poem":1},{"text":"അവരുടെ നിമിത്തം ദൈവം രാജാക്കന്മാരെ ശാസിച്ചു:","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“എന്‍റെ അഭിഷിക്തന്മാരെ തൊടരുത്,","poem":1},{"text":"എന്‍റെ പ്രവാചകന്മാർക്കു ഒരു ദോഷവും ചെയ്യരുത്” എന്നു പറഞ്ഞു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ദൈവം മിസ്രയീമില്‍ ഒരു ക്ഷാമം വരുത്തി;","poem":1},{"text":"അവന്‍ അവരുടെ ഭക്ഷണമെല്ലാം നശിപ്പിച്ചു","poem":2},{"noteId":107},{"text":".","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവർക്ക് മുമ്പായി അവിടുന്ന് ഒരുവനെ അയച്ചു;","poem":1},{"text":"യോസേഫിനെ അവർ ദാസനായി വിറ്റുവല്ലോ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"യഹോവയുടെ വചനം നിവൃത്തിയാകുകയും","poem":1},{"text":"അവിടുത്തെ വചനത്താൽ അവന് ശോധന വരുകയും ചെയ്യുവോളം","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അവർ അവന്‍റെ കാലുകൾ വിലങ്ങുകൊണ്ട് ബന്ധിക്കുകയും","poem":1},{"text":"അവൻ ഇരിമ്പു ചങ്ങലയിൽ കുടുങ്ങുകയും ചെയ്തു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"രാജാവ് ആളയച്ച് അവനെ സ്വതന്ത്രനാക്കി;","poem":1},{"text":"ജനത്തിന്‍റെ അധിപതി അവനെ വിട്ടയച്ചു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവന്‍റെ പ്രഭുക്കന്മാരെ ഏതുസമയത്തും ബന്ധനസ്ഥരാക്കുവാനും","poem":1},{"text":"അവന്‍റെ മന്ത്രിമാർക്ക് ജ്ഞാനം ഉപദേശിച്ചുകൊടുക്കുവാനും","poem":2}]},{"type":"verse","number":22,"content":[{"text":"തന്‍റെ ഭവനത്തിന് അവനെ കർത്താവായും","poem":1},{"text":"തന്‍റെ സർവ്വസമ്പത്തിനും അധിപതിയായും നിയമിച്ചു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"അപ്പോൾ യിസ്രായേൽ മിസ്രയീമിലേക്കു ചെന്നു;","poem":1},{"text":"യാക്കോബ് ഹാമിന്‍റെ ദേശത്ത് വന്നു പാർത്തു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ദൈവം തന്‍റെ ജനത്തെ ഏറ്റവും വർദ്ധിപ്പിക്കുകയും","poem":1},{"text":"അവരുടെ വൈരികളെക്കാൾ അവരെ ബലവാന്മാരാക്കുകയും ചെയ്തു.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"തന്‍റെ ജനത്തെ പകക്കുവാനും തന്‍റെ ദാസന്മാരോട് ഉപായം പ്രയോഗിക്കുവാനും","poem":1},{"text":"കർത്താവ് അവരുടെ ഹൃദയത്തെ മറിച്ചുകളഞ്ഞു.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ദൈവം തന്‍റെ ദാസനായ മോശെയെയും","poem":1},{"text":"താൻ തിരഞ്ഞെടുത്ത അഹരോനെയും അയച്ചു.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ഇവർ അവരുടെ ഇടയിൽ കർത്താവിന്‍റെ അടയാളങ്ങളും","poem":1},{"text":"ഹാമിന്‍റെ ദേശത്ത് അത്ഭുതങ്ങളും പ്രവർത്തിച്ചു.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ദൈവം ഇരുൾ അയച്ച് ദേശത്തെ അന്ധകാരത്തിലാക്കി;","poem":1},{"text":"മിസ്രയീമ്യര്‍ ദൈവവചനം അനുസരിച്ചില്ല;","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ദൈവം അവരുടെ വെള്ളം രക്തമാക്കി,","poem":1},{"text":"അവരുടെ മത്സ്യങ്ങളെ കൊന്നുകളഞ്ഞു.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"അവരുടെ ദേശത്ത് തവള വ്യാപിച്ച്,","poem":1},{"text":"രാജാക്കന്മാരുടെ പള്ളിയറകളിൽപോലും നിറഞ്ഞു.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ദൈവം കല്പിച്ചപ്പോൾ നായീച്ചയും","poem":1},{"text":"അവരുടെ ദേശം മുഴുവനും നിറഞ്ഞു;","poem":2}]},{"type":"verse","number":32,"content":[{"text":"കർത്താവ് അവർക്ക് മഴയ്ക്കു പകരം കൽമഴയും","poem":1},{"text":"അവരുടെ ദേശത്ത് അഗ്നിജ്വാലയും അയച്ചു.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ദൈവം അവരുടെ മുന്തിരിവള്ളികളും അത്തിവൃക്ഷങ്ങളും തകർത്തു;","poem":1},{"text":"അവരുടെ ദേശത്തെ സകലവൃക്ഷങ്ങളും നശിപ്പിച്ചു.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ദൈവം കല്പിച്ചപ്പോൾ വെട്ടുക്കിളിയും","poem":1},{"text":"തുള്ളനും അനവധിയായി വന്നു,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"അവരുടെ ദേശത്തെ സകലസസ്യങ്ങളും","poem":1},{"text":"അവരുടെ വയലിലെ വിളയും തിന്നുകളഞ്ഞു.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ദൈവം അവരുടെ ദേശത്തെ എല്ലാ കടിഞ്ഞൂലിനെയും","poem":1},{"text":"അവരുടെ സർവ്വവീര്യത്തിന്‍റെ ആദ്യഫലത്തെയും സംഹരിച്ചു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"ദൈവം അവരെ വെള്ളിയോടും പൊന്നിനോടുംകൂടി പുറപ്പെടുവിച്ചു;","poem":1},{"text":"അവരുടെ ഗോത്രങ്ങളിൽ ഒരു ബലഹീനനും ഉണ്ടായിരുന്നില്ല.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"അവർ പുറപ്പെട്ടപ്പോൾ മിസ്രയീം സന്തോഷിച്ചു;","poem":1},{"text":"അവരെക്കുറിച്ചുള്ള ഭയം അവരുടെ മേൽ വീണിരുന്നു.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"കർത്താവ് അവർക്ക് തണലിനായി ഒരു മേഘം വിരിച്ചു;","poem":1},{"text":"രാത്രിയിൽ വെളിച്ചത്തിനായി തീ നിർത്തി.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"അവർ ചോദിച്ചപ്പോൾ ദൈവം അവർക്ക് കാടകളെ കൊടുത്തു;","poem":1},{"text":"സ്വർഗ്ഗീയഭോജനംകൊണ്ട് അവർക്ക് തൃപ്തിവരുത്തി.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"ദൈവം പാറ പിളർന്നു, വെള്ളം ചാടി പുറപ്പെട്ടു;","poem":1},{"text":"അത് ഉണങ്ങിയ നിലത്തുകൂടി നദിയായി ഒഴുകി.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"കർത്താവ് തന്‍റെ വിശുദ്ധവാഗ്ദത്തത്തെയും","poem":1},{"text":"തന്‍റെ ദാസനായ അബ്രാഹാമിനെയും ഓർത്തു.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"ദൈവം തന്‍റെ ജനത്തെ സന്തോഷത്തോടും","poem":1},{"lineBreak":true},{"text":"താൻ തിരഞ്ഞെടുത്തവരെ ഘോഷത്തോടും കൂടി പുറപ്പെടുവിച്ചു.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"അവർ തന്‍റെ ചട്ടങ്ങൾ പ്രമാണിക്കുകയും","poem":1},{"text":"തന്‍റെ ന്യായപ്രമാണങ്ങൾ ആചരിക്കുകയും ചെയ്യേണ്ടതിന്","poem":2}]},{"type":"verse","number":45,"content":[{"text":"ദൈവം ജനതകളുടെ ദേശങ്ങൾ അവർക്ക് കൊടുത്തു;","poem":1},{"text":"അവർ വംശങ്ങളുടെ അദ്ധ്വാനഫലം കൈവശമാക്കുകയും ചെയ്തു.","poem":2},{"lineBreak":true},{"text":"യഹോവയെ സ്തുതിക്കുവിൻ.","poem":1}]}],"footnotes":[{"noteId":107,"caller":"+","text":"അവന്‍ അവരുടെ ഭക്ഷണമെല്ലാം നശിപ്പിച്ചു അവന്‍ എല്ലാ ധാന്യവും നശിപ്പിച്ചു","reference":{"chapter":105,"verse":16}}]},"thisChapterLink":"/api/mal_irv/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":45}