{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":106,"content":[{"type":"heading","content":["ദൈവത്തിന്‍റെ കാരുണ്യം"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"യഹോവയെ സ്തുതിക്കുവിൻ;","poem":1},{"lineBreak":true},{"text":"യഹോവയ്ക്കു സ്തോത്രം ചെയ്യുവീൻ; ദൈവം നല്ലവനല്ലയോ;","poem":1},{"text":"അവിടുത്തെ ദയ എന്നേക്കും ഉള്ളത്.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"യഹോവയുടെ വീര്യപ്രവൃത്തികളെ ആര്‍ വർണ്ണിക്കും?","poem":1},{"text":"അവിടുത്തെ സ്തുതിയെപ്പറ്റി എല്ലാം ആര്‍ വിവരിക്കും?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ന്യായം പ്രമാണിക്കുന്നവരും","poem":1},{"text":"എല്ലായ്‌പ്പോഴും നീതി പ്രവർത്തിക്കുന്നവരും ഭാഗ്യവാന്മാർ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"യഹോവേ, അങ്ങേയുടെ ജനത്തോടുള്ള കടാക്ഷപ്രകാരം എന്നെ ഓർക്കേണമേ;","poem":1},{"lineBreak":true},{"text":"അങ്ങേയുടെ രക്ഷകൊണ്ട് എന്നെ സന്ദർശിക്കേണമേ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"അങ്ങനെ ഞാൻ അവിടുന്ന് തിരഞ്ഞെടുത്തവരുടെ നന്മ കാണട്ടെ","poem":1},{"text":"അങ്ങേയുടെ ജനത്തിന്‍റെ സന്തോഷത്തിൽ സന്തോഷിക്കട്ടെ","poem":2},{"lineBreak":true},{"text":"അങ്ങേയുടെ അവകാശമായവരോടൊപ്പം ഞാനും അങ്ങയിൽ പുകഴട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ഞങ്ങൾ ഞങ്ങളുടെ പൂര്‍വ്വ പിതാക്കന്മാരെപ്പോലെ പാപംചെയ്തു;","poem":1},{"text":"ഞങ്ങൾ അകൃത്യവും ദുഷ്ടതയും പ്രവർത്തിച്ചു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ഞങ്ങളുടെ പൂര്‍വ്വ പിതാക്കന്മാർ മിസ്രയീമിൽവച്ച്","poem":1},{"text":"അങ്ങേയുടെ അത്ഭുതങ്ങളെ ഗ്രഹിക്കാതെയും","poem":2},{"text":"അങ്ങേയുടെ മഹാദയയെ ഓർമ്മിക്കാതെയും","poem":1},{"text":"കടല്ക്കരയിൽ, ചെങ്കടല്ക്കരയിൽവച്ചു തന്നെ, മത്സരിച്ചു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"എന്നിട്ടും ദൈവം തന്‍റെ മഹാശക്തി വെളിപ്പെടുത്തേണ്ടതിന്","poem":1},{"text":"തന്‍റെ നാമംനിമിത്തം അവരെ രക്ഷിച്ചു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ദൈവം ചെങ്കടലിനെ ശാസിച്ചു, അത് ഉണങ്ങിപ്പോയി;","poem":1},{"text":"കർത്താവ് അവരെ മരുഭൂമിയിൽക്കൂടി എന്നപോലെ ആഴിയിൽക്കൂടി നടത്തി.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"പകയ്ക്കുന്നവരുടെ കൈയിൽനിന്ന് അവിടുന്ന് അവരെ രക്ഷിച്ചു;","poem":1},{"text":"ശത്രുവിന്‍റെ കൈയിൽനിന്ന് അവരെ വീണ്ടെടുത്തു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"വെള്ളം അവരുടെ വൈരികളെ മൂടിക്കളഞ്ഞു;","poem":1},{"text":"അവരിൽ ഒരുത്തനും ശേഷിച്ചില്ല.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അപ്പോൾ അവർ അവിടുത്തെ വചനങ്ങൾ വിശ്വസിച്ചു;","poem":1},{"text":"ദൈവത്തിന് സ്തുതിപാടുകയും ചെയ്തു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"എങ്കിലും അവർ വേഗത്തിൽ കർത്താവിന്‍റെ പ്രവൃത്തികളെ മറന്നു;","poem":1},{"text":"ദൈവത്തിന്‍റെ ആലോചനയ്ക്കായി കാത്തിരുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"മരുഭൂമിയിൽവച്ച് അവർ ഏറ്റവും മോഹിച്ചു;","poem":1},{"text":"നിർജ്ജനപ്രദേശത്ത് അവർ ദൈവത്തെ പരീക്ഷിച്ചു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവർ അപേക്ഷിച്ചത് ദൈവം അവർക്ക് കൊടുത്തു;","poem":1},{"text":"എങ്കിലും അവരുടെ പ്രാണന് ക്ഷയം അയച്ചു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"പാളയത്തിൽവച്ച് അവർ മോശെയോടും","poem":1},{"text":"യഹോവയുടെ വിശുദ്ധനായ അഹരോനോടും അസൂയപ്പെട്ടു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ഭൂമി പിളർന്ന് ദാഥാനെ വിഴുങ്ങി;","poem":1},{"text":"അബീരാമിന്‍റെ കൂട്ടത്തെയും മൂടിക്കളഞ്ഞു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അവരുടെ കൂട്ടത്തിൽ തീ കത്തി;","poem":1},{"text":"അഗ്നിജ്വാല ദുഷ്ടന്മാരെ ദഹിപ്പിച്ചുകളഞ്ഞു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"അവർ ഹോരേബിൽവച്ച് ഒരു കാളക്കുട്ടിയെ ഉണ്ടാക്കി;","poem":1},{"text":"വാർത്തുണ്ടാക്കിയ വിഗ്രഹത്തെ നമസ്കരിച്ചു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ഇങ്ങനെ അവർ അവരുടെ മഹത്വമായവനെ","poem":1},{"text":"പുല്ല് തിന്നുന്ന കാളയോട് സദൃശനാക്കി മാറ്റി.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"മിസ്രയീമിൽ വലിയ കാര്യങ്ങളും","poem":1},{"text":"ഹാമിന്‍റെ ദേശത്ത് അത്ഭുതപ്രവൃത്തികളും","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ചെങ്കടലിൽ ഭയങ്കരകാര്യങ്ങളും ചെയ്തവനായ","poem":1},{"text":"അവരുടെ രക്ഷിതാവായ ദൈവത്തെ അവർ മറന്നു.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ആകയാൽ അവരെ നശിപ്പിക്കുമെന്ന് ദൈവം അരുളിച്ചെയ്തു;","poem":1},{"text":"അവിടുത്തെ വൃതനായ മോശെ കോപത്തെ ശമിപ്പിക്കുവാൻ","poem":2},{"text":"അവിടുത്തെ സന്നിധിയിൽ പിളർപ്പിൽ നിന്നില്ലായിരുന്നെങ്കിൽ","poem":1},{"text":"ദൈവം അവരെ നശിപ്പിച്ചുകളയുമായിരുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അവർ മനോഹരദേശത്തെ നിരസിച്ചു;","poem":1},{"text":"അവിടുത്തെ വചനം വിശ്വസിച്ചതുമില്ല.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"അവർ അവരുടെ കൂടാരങ്ങളിൽവച്ച് പിറുപിറുത്തു;","poem":1},{"text":"യഹോവയുടെ വചനം കേൾക്കാതെയിരുന്നു.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"അതുകൊണ്ട് ദൈവം അവരെ മരുഭൂമിയിൽ വീഴിക്കുമെന്നും","poem":1},{"text":"അവരുടെ സന്തതിയെ ജനതകളുടെ ഇടയിൽ നശിപ്പിക്കുമെന്നും","poem":2}]},{"type":"verse","number":27,"content":[{"text":"അവരെ ദേശങ്ങളിൽ ചിതറിച്ചുകളയുമെന്നും","poem":1},{"text":"അവർക്ക് വിരോധമായി തന്‍റെ കൈ ഉയർത്തി സത്യംചെയ്തു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"അനന്തരം അവർ ബാൽ-പെയോരിനോട് ചേർന്നു;","poem":1},{"text":"മരിച്ചവർക്കുള്ള ബലികൾ തിന്നു.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ഇങ്ങനെ അവർ അവരുടെ ക്രിയകളാൽ കർത്താവിനെ കോപിപ്പിച്ചു;","poem":1},{"text":"പെട്ടെന്ന് അവർക്ക് ഒരു ബാധ തട്ടി.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"അപ്പോൾ ഫീനെഹാസ് എഴുന്നേറ്റ് ശിക്ഷ നടത്തി;","poem":1},{"text":"ബാധ നിന്നുപോകുകയും ചെയ്തു.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"അത് തലമുറതലമുറയായി എന്നേക്കും","poem":1},{"text":"അവന് നീതിയായി എണ്ണിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"മെരീബാവെള്ളത്തിങ്കലും അവർ ദൈവത്തെ കോപിപ്പിച്ചു;","poem":1},{"text":"അവരുടെ നിമിത്തം മോശെക്കും ദോഷം ഭവിച്ചു.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"അവർ അവനെ കോപിപ്പിച്ചതുകൊണ്ട്","poem":1},{"text":"അവൻ അധരങ്ങളാൽ അവിവേകം സംസാരിച്ചുപോയി.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"യഹോവ അവരോടു കല്പിച്ചതുപോലെ","poem":1},{"text":"അവർ ജനതകളെ നശിപ്പിച്ചില്ല.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"അവർ ദൈവമില്ലാത്തവരോട് ഇടകലർന്ന്","poem":1},{"text":"അവരുടെ പ്രവൃത്തികൾ പഠിച്ചു.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"അവരുടെ വിഗ്രഹങ്ങളെ സേവിച്ചു;","poem":1},{"text":"അവ അവർക്കൊരു കെണിയായിത്തീർന്നു.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"തങ്ങളുടെ പുത്രന്മാരെയും പുത്രിമാരെയും","poem":1},{"text":"അവർ ഭൂതങ്ങൾക്ക് ബലികഴിച്ചു.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"അവർ കുറ്റമില്ലാത്ത രക്തം,","poem":1},{"text":"പുത്രീപുത്രന്മാരുടെ രക്തം തന്നെ, ചൊരിഞ്ഞു;","poem":2},{"text":"അവരെ അവർ കനാന്യവിഗ്രഹങ്ങൾക്ക് ബലികഴിച്ചു,","poem":1},{"text":"ദേശം രക്തപാതകംകൊണ്ട് അശുദ്ധമായിത്തീർന്നു.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"ഇങ്ങനെ അവർ അവരുടെ ക്രിയകളാൽ മലിനപ്പെട്ടു,","poem":1},{"text":"അവരുടെ കർമ്മങ്ങളാൽ പരസംഗം ചെയ്തു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"അതുകൊണ്ട് യഹോവയുടെ കോപം തന്‍റെ ജനത്തിന്‍റെ നേരെ ജ്വലിച്ചു;","poem":1},{"text":"ദൈവം തന്‍റെ അവകാശത്തെ വെറുത്തു.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"കർത്താവ് അവരെ ജനതകളുടെ കയ്യിൽ ഏല്പിച്ചു;","poem":1},{"text":"അവരെ വെറുത്തവർ അവരെ ഭരിച്ചു.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"അവരുടെ ശത്രുക്കൾ അവരെ ഞെരുക്കി;","poem":1},{"text":"അവർ അവർക്ക് കീഴടങ്ങേണ്ടിവന്നു.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"പലപ്പോഴും കർത്താവ് അവരെ വിടുവിച്ചു;","poem":1},{"text":"എങ്കിലും അവർ അവരുടെ ആലോചനയാൽ കർത്താവിനെ പ്രകോപിപ്പിച്ചു;","poem":2},{"lineBreak":true},{"text":"അവരുടെ അകൃത്യം നിമിത്തം അധോഗതി പ്രാപിച്ചു.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"എന്നാൽ അവരുടെ നിലവിളികേട്ടപ്പോൾ","poem":1},{"text":"കർത്താവ് അവരുടെ കഷ്ടത കടാക്ഷിച്ചു.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"ദൈവം അവർക്കുവേണ്ടി തന്‍റെ നിയമം ഓർത്തു;","poem":1},{"text":"തന്‍റെ മഹാദയയാൽ മനസ്സുമാറ്റി.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"അവരെ ബദ്ധരാക്കി കൊണ്ടുപോയവർക്കെല്ലാം","poem":1},{"text":"അവരോട് കനിവ് തോന്നുമാറാക്കി.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"ഞങ്ങളുടെ ദൈവമായ യഹോവേ, ഞങ്ങളെ രക്ഷിക്കേണമേ;","poem":1},{"text":"അവിടുത്തെ വിശുദ്ധനാമത്തിന് സ്തോത്രം ചെയ്യുവാനും","poem":2},{"text":"അവിടുത്തെ സ്തുതിയിൽ പ്രശംസിക്കുവാനും","poem":1},{"text":"ജനതകളുടെ ഇടയിൽനിന്ന് ഞങ്ങളെ ശേഖരിക്കേണമേ.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"യിസ്രായേലിന്‍റെ ദൈവമായ യഹോവ എന്നും എന്നേക്കും വാഴ്ത്തപ്പെടുമാറാകട്ടെ;","poem":1},{"lineBreak":true},{"text":"ജനമെല്ലാം ആമേൻ എന്നു പറയട്ടെ.","poem":1},{"lineBreak":true},{"text":"യഹോവയെ സ്തുതിക്കുവിൻ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}