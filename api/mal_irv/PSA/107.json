{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":107,"content":[{"type":"heading","content":["ദൈവത്തിന്‍റെ പരിപാലനം"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"യഹോവയ്ക്കു സ്തോത്രം ചെയ്യുവിൻ;","poem":1},{"text":"ദൈവം നല്ലവനല്ലോ അവിടുത്തെ ദയ എന്നേക്കുമുള്ളത്!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"യഹോവ വൈരിയുടെ കയ്യിൽനിന്ന് വീണ്ടെടുക്കുകയും","poem":1},{"text":"കിഴക്കും പടിഞ്ഞാറും വടക്കും കടലിലും ഉള്ള","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ദേശങ്ങളിൽനിന്ന് കൂട്ടിച്ചേർക്കുകയും ചെയ്തവരായ","poem":1},{"text":"കർത്താവിന്‍റെ വിമുക്തന്മാർ അങ്ങനെ പറയട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"അവർ മരുഭൂമിയിൽ ജനസഞ്ചാരമില്ലാത്ത വഴിയിൽ അലഞ്ഞുനടന്നു;","poem":1},{"text":"പാർക്കുവാൻ ഒരു പട്ടണവും അവർ കണ്ടെത്തിയില്ല.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവർ വിശന്നും ദാഹിച്ചും ഇരുന്നു;","poem":1},{"text":"അവരുടെ പ്രാണൻ അവരുടെ ഉള്ളിൽ തളർന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവർ അവരുടെ കഷ്ടതയിൽ യഹോവയോട് നിലവിളിച്ചു;","poem":1},{"text":"കർത്താവ് അവരെ അവരുടെ ഞെരുക്കങ്ങളിൽനിന്നു വിടുവിച്ചു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവർ പാർക്കുവാൻ തക്ക പട്ടണത്തിൽ ചെല്ലേണ്ടതിന്","poem":1},{"text":"ദൈവം അവരെ ശരിയായ വഴിയിൽ നടത്തി.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവർ യഹോവയെ അവിടുത്തെ നന്മയെചൊല്ലിയും","poem":1},{"text":"മനുഷ്യപുത്രന്മാരിൽ ചെയ്ത അത്ഭുതങ്ങളെ ചൊല്ലിയും സ്തുതിക്കട്ടെ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"കർത്താവ് ആർത്തിയുള്ളവന് തൃപ്തി വരുത്തുകയും","poem":1},{"text":"വിശപ്പുള്ളവനെ നന്മകൊണ്ടു നിറയ്ക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"അരിഷ്ടതയാലും ഇരുമ്പുചങ്ങലയാലും ബന്ധിക്കപ്പെട്ടവർ","poem":1},{"text":"ഇരുളിലും അന്ധതമസ്സിലും ഇരുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അവർ ദൈവത്തിന്‍റെ വചനങ്ങളോട് മത്സരിക്കുകയും","poem":1},{"text":"അത്യുന്നതനായ ദൈവത്തിന്‍റെ ആലോചന നിരസിക്കുകയും ചെയ്തു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവരുടെ ഹൃദയത്തെ ദൈവം കഷ്ടതകൊണ്ട് താഴ്ത്തി;","poem":1},{"text":"അവർ ഇടറിവീണു; സഹായിക്കുവാൻ ആരും ഉണ്ടായിരുന്നില്ല.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അവർ അവരുടെ കഷ്ടതയിൽ യഹോവയോട് നിലവിളിച്ചു;","poem":1},{"text":"ദൈവം അവരുടെ ഞെരുക്കങ്ങളിൽനിന്ന് അവരെ രക്ഷിച്ചു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ദൈവം അവരെ ഇരുട്ടിൽനിന്നും മരണനിഴലിൽനിന്നും പുറപ്പെടുവിച്ചു;","poem":1},{"text":"അവരുടെ ബന്ധനങ്ങൾ അറുത്തുകളഞ്ഞു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവർ യഹോവയെ, അവിടുത്തെ നന്മയെചൊല്ലിയും","poem":1},{"text":"മനുഷ്യപുത്രന്മാരിൽ ചെയ്ത അത്ഭുതങ്ങളെ ചൊല്ലിയും സ്തുതിക്കട്ടെ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ദൈവം താമ്രകതകുകൾ തകർത്തു,","poem":1},{"text":"ഇരിമ്പോടാമ്പലുകൾ മുറിച്ചുകളഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ഭോഷന്മാർ അവരുടെ ലംഘനങ്ങൾ ഹേതുവായും","poem":1},{"text":"തങ്ങളുടെ അകൃത്യങ്ങൾനിമിത്തവും കഷ്ടപ്പെട്ടു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അവർക്ക് സകലവിധ ഭക്ഷണത്തോടും വെറുപ്പുതോന്നി;","poem":1},{"text":"അവർ മരണവാതിലുകളോട് സമീപിച്ചിരുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അവർ അവരുടെ കഷ്ടതയിൽ യഹോവയോട് നിലവിളിച്ചു;","poem":1},{"text":"കർത്താവ് അവരെ അവരുടെ ഞെരുക്കങ്ങളിൽനിന്നു രക്ഷിച്ചു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ദൈവം തന്‍റെ വചനം അയച്ച് അവരെ സൗഖ്യമാക്കി;","poem":1},{"text":"അവരുടെ കുഴികളിൽനിന്ന് അവരെ വിടുവിച്ചു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവർ യഹോവയെ അവിടുത്തെ നന്മയെചൊല്ലിയും","poem":1},{"text":"മനുഷ്യപുത്രന്മാരിൽ ചെയ്ത അത്ഭുതങ്ങളെ ചൊല്ലിയും സ്തുതിക്കട്ടെ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"അവർ സ്തോത്രയാഗങ്ങൾ കഴിക്കുകയും","poem":1},{"text":"സംഗീതത്തോടുകൂടി ദൈവത്തിന്‍റെ പ്രവൃത്തികളെ വർണ്ണിക്കുകയും ചെയ്യട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"കപ്പൽ കയറി സമുദ്രത്തിൽ ഓടിയവർ,","poem":1},{"text":"പെരുവെള്ളങ്ങളിൽ വ്യാപാരം ചെയ്തവർ,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അവർ യഹോവയുടെ പ്രവൃത്തികളും","poem":1},{"text":"ആഴിയിൽ കർത്താവിന്‍റെ അത്ഭുതങ്ങളും കണ്ടു.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"അവിടുന്ന് കല്പിച്ച് കൊടുങ്കാറ്റടിപ്പിച്ചു,","poem":1},{"text":"സമുദ്രം അതിലെ തിരകളെ പൊങ്ങുമാറാക്കി.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"അവർ ആകാശത്തിലേക്ക് ഉയർന്നു,","poem":1},{"text":"വീണ്ടും ആഴത്തിലേക്ക് താണു,","poem":2},{"lineBreak":true},{"text":"അവരുടെ ധൈര്യം കഷ്ടത്താൽ ഉരുകിപ്പോയി.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"അവർ ലഹരിപിടിച്ചവനെപ്പോലെ തുള്ളി ചാഞ്ചാടി നടന്നു;","poem":1},{"text":"അവരുടെ ബുദ്ധി കെട്ടുപോയിരുന്നു.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"അവർ അവരുടെ കഷ്ടതയിൽ യഹോവയോട് നിലവിളിച്ചു;","poem":1},{"text":"കർത്താവ് അവരെ അവരുടെ ഞെരുക്കങ്ങളിൽനിന്ന് വിടുവിച്ചു.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ദൈവം കൊടുങ്കാറ്റിനെ ശാന്തമാക്കി;","poem":1},{"text":"സമുദ്രത്തിലെ തിരമാലകൾ അടങ്ങി.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ശാന്തത വന്നതുകൊണ്ട് അവർ സന്തോഷിച്ചു;","poem":1},{"text":"അവർ ആഗ്രഹിച്ച തുറമുഖത്ത് കർത്താവ് അവരെ എത്തിച്ചു.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"അവർ യഹോവയെ അവിടുത്തെ നന്മയെചൊല്ലിയും","poem":1},{"text":"മനുഷ്യപുത്രന്മാരിൽ ചെയ്ത അത്ഭുതങ്ങളെ ചൊല്ലിയും സ്തുതിക്കട്ടെ.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"അവർ ജനത്തിന്‍റെ സഭയിൽ അവിടുത്തെ പുകഴ്ത്തുകയും","poem":1},{"text":"മൂപ്പന്മാരുടെ സംഘത്തിൽ അവിടുത്തെ സ്തുതിക്കുകയും ചെയ്യട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"നിവാസികളുടെ ദുഷ്ടതനിമിത്തം","poem":1},{"text":"ദൈവം നദികളെ മരുഭൂമിയും","poem":2}]},{"type":"verse","number":34,"content":[{"text":"നീരുറവുകളെ വരണ്ടനിലവും","poem":1},{"text":"ഫലപ്രദമായ ഭൂമിയെ ഊഷരനിലവും ആക്കി.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ദൈവം മരുഭൂമിയെ ജലതടാകവും","poem":1},{"text":"വരണ്ട നിലത്തെ നീരുറവുകളും ആക്കി.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"വിശന്നവരെ അവിടുന്ന് അവിടെ താമസിപ്പിച്ചു;","poem":1},{"text":"അവർ വസിക്കുവാൻ പട്ടണം ഉണ്ടാക്കുകയും","poem":2}]},{"type":"verse","number":37,"content":[{"text":"നിലം വിതയ്ക്കുകയും മുന്തിരിത്തോട്ടം നട്ടുണ്ടാക്കുകയും","poem":1},{"text":"സമൃദ്ധിയായി ഫലങ്ങൾ അനുഭവിക്കുകയും ചെയ്തു.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"ദൈവം അനുഗ്രഹിച്ചിട്ട് അവർ അത്യന്തം പെരുകി;","poem":1},{"text":"അവരുടെ കന്നുകാലികൾ കുറഞ്ഞുപോകുവാൻ അവിടുന്ന് ഇട വരുത്തിയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"പീഡനവും കഷ്ടതയും സങ്കടവും ഹേതുവായി","poem":1},{"text":"അവർ പിന്നെയും കുറഞ്ഞു താണുപോയി.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"ദൈവം ശത്രുക്കളെ ഭരിക്കുന്നവരുടെ മേൽ നിന്ദ പകരുകയും","poem":1},{"text":"വഴിയില്ലാത്ത ശൂന്യപ്രദേശത്ത് അവരെ അലയുന്നവരാക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"കർത്താവ് ദരിദ്രനെ പീഡയിൽനിന്നുയർത്തി","poem":1},{"text":"അവന്‍റെ കുലങ്ങളെ ആട്ടിൻകൂട്ടംപോലെ ആക്കി.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"നേരുള്ളവർ ഇതു കണ്ടു സന്തോഷിക്കും;","poem":1},{"text":"നീതികെട്ടവർ എല്ലാവരും വായ് പൊത്തും.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"ജ്ഞാനമുള്ളവർ ഇവ ശ്രദ്ധിക്കും;","poem":1},{"text":"അവർ യഹോവയുടെ കൃപകളെക്കുറിച്ച് ചിന്തിക്കും.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":43}