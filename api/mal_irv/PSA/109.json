{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":109,"content":[{"type":"heading","content":["പീഡിതന്‍റെ പരാതി"]},{"type":"hebrew_subtitle","content":["സംഗീതപ്രമാണിക്ക്; ദാവീദിന്‍റെ ഒരു സങ്കീർത്തനം."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"എന്‍റെ പുകഴ്ചയായ ദൈവമേ, മൗനമായിരിക്കരുതേ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ദുഷ്ടന്‍റെ വായും വഞ്ചകന്‍റെ വായും എന്‍റെ നേരെ തുറന്നിരിക്കുന്നു;","poem":1},{"text":"ഭോഷ്കുള്ള നാവുകൊണ്ട് അവർ എന്നോട് സംസാരിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവർ വിദ്വേഷവാക്കുകൾകൊണ്ട് എന്നെ വളഞ്ഞ്","poem":1},{"text":"കാരണംകൂടാതെ എന്നോട് പോരാടിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"എന്‍റെ സ്നേഹത്തിന് പകരം അവർ എന്നെ കുറ്റം ചുമത്തുന്നു;","poem":1},{"text":"എന്നാൽ ഞാൻ പ്രാർത്ഥിച്ചുകൊണ്ടിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"നന്മയ്ക്കു പകരം തിന്മയും സ്നേഹത്തിന് പകരം ദ്വേഷവും","poem":1},{"text":"അവർ എന്നോട് കാണിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"അവര്‍ പറയുന്നു: ”അങ്ങ് അവന്‍റെമേൽ ഒരു ദുഷ്ടനെ നിയമിക്കേണമേ;","poem":1},{"text":"സാത്താൻ അവന്‍റെ വലത്തുഭാഗത്തു നില്‍ക്കട്ടെ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവനെ വിസ്തരിക്കുമ്പോൾ അവൻ കുറ്റക്കാരനെന്നു തെളിയട്ടെ;","poem":1},{"text":"അവന്‍റെ പ്രാർത്ഥന പാപമായിത്തീരട്ടെ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവന്‍റെ നാളുകൾ ചുരുങ്ങിപ്പോകട്ടെ;","poem":1},{"text":"അവന്‍റെ സ്ഥാനം മറ്റൊരുത്തൻ ഏല്ക്കട്ടെ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവന്‍റെ മക്കൾ അനാഥരും","poem":1},{"text":"അവന്‍റെ ഭാര്യ വിധവയും ആയിത്തീരട്ടെ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവന്‍റെ മക്കൾ അലഞ്ഞ് തെണ്ടിനടക്കട്ടെ;","poem":1},{"text":"അവരുടെ ശൂന്യഭവനങ്ങൾ വിട്ട് ഇരന്നു നടക്കട്ടെ;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"കടക്കാരൻ അവനുള്ളതൊക്കെയും കൊണ്ടുപോകട്ടെ;","poem":1},{"text":"അപരിചിതർ അവന്‍റെ പ്രയത്നഫലം കൊള്ളയിടട്ടെ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവനോട് ദയ കാണിക്കുവാൻ ആരും ഉണ്ടാകരുതേ;","poem":1},{"text":"അനാഥരായ അവന്‍റെ മക്കളോട് ആർക്കും കരുണ തോന്നരുതേ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അവന്‍റെ സന്തതി മുടിഞ്ഞുപോകട്ടെ;","poem":1},{"text":"അടുത്ത തലമുറയിൽ തന്നെ അവരുടെ പേര് മാഞ്ഞു പോകട്ടെ;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവന്‍റെ പൂര്‍വ്വ പിതാക്കന്മാരുടെ അകൃത്യം യഹോവ ഓർക്കുമാറാകട്ടെ;","poem":1},{"text":"അവന്‍റെ അമ്മയുടെ പാപം മാഞ്ഞുപോകയുമരുതേ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവ എല്ലായ്‌പ്പോഴും യഹോവയുടെ മുമ്പാകെ ഇരിക്കട്ടെ;","poem":1},{"text":"അവരുടെ ഓർമ്മ ഭൂമിയിൽനിന്നു ഛേദിച്ചുകളയേണ്ടതിനു തന്നെ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അവൻ ദയ കാണിക്കുവാൻ മറന്നുകളഞ്ഞുവല്ലോ;","poem":1},{"text":"എളിയവനെയും ദരിദ്രനെയും മനംതകർന്നവനെയും മരണപര്യന്തം ഉപദ്രവിച്ചു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ശാപം അവന് പ്രിയമായിരുന്നു; അത് അവന് ഭവിക്കട്ടെ;","poem":1},{"text":"അനുഗ്രഹം അവന് അപ്രിയമായിരുന്നു; അത് അവനെ വിട്ടകന്നുപോകട്ടെ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അവൻ വസ്ത്രംപോലെ ശാപം ധരിച്ചു;","poem":1},{"text":"അവ വെള്ളംപോലെ അവന്‍റെ ഉള്ളിലും എണ്ണപോലെ അവന്‍റെ അസ്ഥികളിലും പ്രവേശിക്കട്ടെ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ശാപം അവന് പുതയ്ക്കുന്ന വസ്ത്രംപോലെയും","poem":1},{"text":"നിത്യം അരയ്ക്ക് കെട്ടുന്ന കച്ചപോലെയും ആയിരിക്കട്ടെ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ഇത് എന്നെ കുറ്റം ചുമത്തുന്നവർക്കും എനിക്ക് വിരോധമായി ദോഷം പറയുന്നവർക്കും","poem":1},{"text":"യഹോവ കൊടുക്കുന്ന പ്രതിഫലം ആകട്ടെ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"കർത്താവായ യഹോവേ, അങ്ങേയുടെ നാമംനിമിത്തം എന്നോട് ചെയ്യേണമേ;","poem":1},{"text":"അങ്ങേയുടെ ദയ നല്ലതാകയാൽ എന്നെ വിടുവിക്കേണമേ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ഞാൻ അരിഷ്ടനും ദരിദ്രനും ആകുന്നു;","poem":1},{"text":"എന്‍റെ ഹൃദയത്തിന് മുറിവേറ്റിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ചാഞ്ഞുപോകുന്ന നിഴൽപോലെ ഞാൻ കടന്നുപോകുന്നു;","poem":1},{"text":"വെട്ടുക്കിളിയെപ്പോലെ എന്നെ കുടഞ്ഞുകളയുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"എന്‍റെ മുഴങ്കാലുകൾ ഉപവാസംകൊണ്ടു വിറയ്ക്കുന്നു.","poem":1},{"text":"എന്‍റെ ദേഹം പുഷ്ടിയില്ലാതെ ക്ഷയിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ഞാൻ അവർക്ക് പരിഹാസപാത്രമായിത്തീർന്നിരിക്കുന്നു;","poem":1},{"text":"എന്നെ കാണുമ്പോൾ അവർ തല കുലുക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"എന്‍റെ ദൈവമായ യഹോവേ, എന്നെ സഹായിക്കേണമേ;","poem":1},{"text":"അങ്ങേയുടെ ദയയ്ക്കു തക്കവണ്ണം എന്നെ രക്ഷിക്കേണമേ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"യഹോവേ, ഇതു അങ്ങേയുടെ കൈ എന്നും","poem":1},{"text":"അങ്ങ് ഇതു ചെയ്തു എന്നും അവർ അറിയേണ്ടതിന് തന്നെ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"അവർ ശപിക്കട്ടെ; അവിടുന്ന് അനുഗ്രഹിക്കേണമേ;","poem":1},{"text":"അവർ എതിർക്കുമ്പോൾ ലജ്ജിച്ചുപോകട്ടെ; അങ്ങേയുടെ ദാസനായ","poem":2},{"lineBreak":true},{"text":"അടിയനോ സന്തോഷിക്കും;","poem":2}]},{"type":"verse","number":29,"content":[{"text":"എന്‍റെ എതിരാളികൾ നിന്ദ ധരിക്കട്ടെ;","poem":1},{"text":"പുതപ്പ് പുതയ്ക്കുന്നതു പോലെ അവർ ലജ്ജ പുതയ്ക്കും.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ഞാൻ എന്‍റെ വായ്കൊണ്ട് യഹോവയെ അത്യന്തം സ്തുതിക്കും;","poem":1},{"text":"അതെ, ഞാൻ പുരുഷാരത്തിന്‍റെ നടുവിൽ ദൈവത്തെ പുകഴ്ത്തും.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ശിക്ഷയ്ക്കു വിധിക്കുന്നവരുടെ കൈയിൽനിന്ന് എളിയവരെ രക്ഷിക്കുവാൻ","poem":1},{"text":"ദൈവം ബലഹീനന്‍റെ വലത്തുഭാഗത്തു നില്ക്കുന്നു.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}