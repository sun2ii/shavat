{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"heading","content":["ദൈവഭക്തന്‍റെ സന്തോഷം"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"യഹോവയെ സ്തുതിക്കുവിൻ;","poem":1},{"lineBreak":true},{"text":"യഹോവയെ ഭയപ്പെട്ട്, അവിടുത്തെ കല്പനകൾ","poem":1},{"text":"ഏറ്റവും ഇഷ്ടപ്പെടുന്ന മനുഷ്യൻ ഭാഗ്യവാൻ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവന്‍റെ സന്തതി ഭൂമിയിൽ ബലപ്പെട്ടിരിക്കും;","poem":1},{"text":"നേരുള്ളവരുടെ തലമുറ അനുഗ്രഹിക്കപ്പെടും.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ഐശ്വര്യവും സമ്പത്തും അവന്‍റെ വീട്ടിൽ ഉണ്ടാകും;","poem":1},{"text":"അവന്‍റെ നീതി എന്നേക്കും നിലനില്ക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"നേരുള്ളവർക്ക് ഇരുട്ടിൽ വെളിച്ചം ഉദിക്കുന്നു;","poem":1},{"text":"അവൻ","poem":2},{"noteId":109},{"text":"കൃപയും കരുണയും നീതിയും ഉള്ളവനാകുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"കൃപ തോന്നി വായ്പകൊടുക്കുന്നവൻ ശുഭമായിരിക്കും;","poem":1},{"text":"വിവേകത്തോടെ അവൻ തന്‍റെ കാര്യം നടത്തും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"അവൻ ഒരുനാളും കുലുങ്ങിപ്പോകുകയില്ല;","poem":1},{"text":"നീതിമാൻ എന്നേക്കും സ്മരിക്കപ്പെടും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ദുർവ്വർത്തമാനംനിമിത്തം അവൻ ഭയപ്പെടുകയില്ല;","poem":1},{"text":"അവന്‍റെ ഹൃദയം യഹോവയിൽ ആശ്രയിച്ച് ഉറച്ചിരിക്കും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവന്‍റെ ഹൃദയം ഭയപ്പെടാതെ സ്ഥിരമായിരിക്കുന്നു;","poem":1},{"text":"അവൻ ശത്രുക്കളിൽ തന്‍റെ ആഗ്രഹം നിവർത്തിച്ചുകാണും.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവൻ വാരിവിതറി ദരിദ്രന്മാർക്ക് കൊടുക്കുന്നു;","poem":1},{"text":"അവന്‍റെ നീതി എന്നേക്കും നിലനില്ക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"അവന്‍റെ ശക്തി","poem":2},{"noteId":110},{"text":"ബഹുമാനത്തോടെ ഉയർന്നിരിക്കും.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ദുഷ്ടൻ അത് കണ്ടു വ്യസനിക്കും;","poem":1},{"text":"അവൻ പല്ലുകടിച്ച് ഉരുകിപ്പോകും;","poem":2},{"lineBreak":true},{"text":"ദുഷ്ടന്‍റെ ആശ നശിച്ചുപോകും.","poem":2}]}],"footnotes":[{"noteId":109,"caller":"+","text":"അവൻ ദൈവം","reference":{"chapter":112,"verse":4}},{"noteId":110,"caller":"+","text":"ശക്തി കൊമ്പ്","reference":{"chapter":112,"verse":9}}]},"thisChapterLink":"/api/mal_irv/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}