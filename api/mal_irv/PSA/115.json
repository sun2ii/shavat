{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"heading","content":["യഹോവ സ്തുതി അർഹിക്കുന്നു"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"ഞങ്ങൾക്കല്ല, യഹോവേ, ഞങ്ങൾക്കല്ല,","poem":1},{"text":"അങ്ങേയുടെ ദയയും വിശ്വസ്തതയും നിമിത്തം","poem":2},{"lineBreak":true},{"text":"അങ്ങേയുടെ നാമത്തിന് തന്നെ മഹത്വം വരുത്തേണമേ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“അവരുടെ ദൈവം എവിടെ?”","poem":1},{"text":"എന്നു ജനതകൾ പറയുന്നതെന്തിന്?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"നമ്മുടെ ദൈവം സ്വർഗ്ഗത്തിൽ ഉണ്ട്;","poem":1},{"text":"തനിക്കു ഇഷ്ടമുള്ളതെല്ലാം അവിടുന്ന് ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവരുടെ വിഗ്രഹങ്ങൾ പൊന്നും വെള്ളിയും ആകുന്നു;","poem":1},{"text":"മനുഷ്യരുടെ കൈവേല തന്നെ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവയ്ക്കു വായുണ്ടെങ്കിലും സംസാരിക്കുന്നില്ല;","poem":1},{"text":"കണ്ണുണ്ടെങ്കിലും കാണുന്നില്ല.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവയ്ക്കു ചെവിയുണ്ടെങ്കിലും കേൾക്കുന്നില്ല;","poem":1},{"text":"മൂക്കുണ്ടെങ്കിലും മണക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവയ്ക്കു കൈയുണ്ടെങ്കിലും സ്പർശിക്കുന്നില്ല;","poem":1},{"text":"കാലുണ്ടെങ്കിലും നടക്കുന്നില്ല;","poem":2},{"lineBreak":true},{"text":"തൊണ്ട കൊണ്ടു സംസാരിക്കുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവയെ ഉണ്ടാക്കുന്നവർ അവയെപ്പോലെ ആകുന്നു;","poem":1},{"text":"അവയിൽ ആശ്രയിക്കുന്ന ഏവനും അങ്ങനെ തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"യിസ്രായേലേ, യഹോവയിൽ ആശ്രയിക്കുക;","poem":1},{"text":"കർത്താവ് അവരുടെ സഹായവും പരിചയും ആകുന്നു;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അഹരോൻഗൃഹമേ, യഹോവയിൽ ആശ്രയിക്കുക;","poem":1},{"text":"ദൈവം അവരുടെ സഹായവും പരിചയും ആകുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"യഹോവാഭക്തന്മാരേ, യഹോവയിൽ ആശ്രയിക്കുക;","poem":1},{"text":"ദൈവം അവരുടെ സഹായവും പരിചയും ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"യഹോവ നമ്മെ ഓർത്തിരിക്കുന്നു; അവിടുന്ന് അനുഗ്രഹിക്കും;","poem":1},{"text":"ദൈവം യിസ്രായേൽഗൃഹത്തെ അനുഗ്രഹിക്കും;","poem":2},{"lineBreak":true},{"text":"ദൈവം അഹരോൻഗൃഹത്തെ അനുഗ്രഹിക്കും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ദൈവം യഹോവാഭക്തന്മാരായ","poem":1},{"text":"ചെറിയവരെയും വലിയവരെയും അനുഗ്രഹിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"യഹോവ നിങ്ങളെ മേല്ക്കുമേൽ വർദ്ധിപ്പിക്കട്ടെ;","poem":1},{"text":"നിങ്ങളെയും നിങ്ങളുടെ മക്കളെയും തന്നെ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ആകാശത്തെയും ഭൂമിയെയും ഉണ്ടാക്കിയ യഹോവയാൽ","poem":1},{"text":"നിങ്ങൾ അനുഗ്രഹിക്കപ്പെട്ടവർ ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"സ്വർഗ്ഗം യഹോവയുടെ സ്വർഗ്ഗമാകുന്നു;","poem":1},{"text":"ഭൂമിയെ അവിടുന്ന് മനുഷ്യർക്ക് കൊടുത്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"മരിച്ചവരും മൗനതയിൽ ഇറങ്ങിയവരും","poem":1},{"text":"യഹോവയെ സ്തുതിക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"നാമോ, ഇന്നുമുതൽ എന്നേക്കും","poem":1},{"text":"യഹോവയെ വാഴ്ത്തും.","poem":2},{"lineBreak":true},{"text":"യഹോവയെ സ്തുതിക്കുവിൻ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}