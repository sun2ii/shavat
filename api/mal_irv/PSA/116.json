{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"heading","content":["മരണത്തിൽ നിന്ന് വിടുവിച്ച ദൈവത്തിനു നന്ദി"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"യഹോവ എന്‍റെ പ്രാർത്ഥനയും യാചനകളും കേട്ടതുകൊണ്ട്","poem":1},{"text":"ഞാൻ അവിടുത്തെ സ്നേഹിക്കുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"കർത്താവ് തന്‍റെ ചെവി എങ്കലേക്ക് ചായിച്ചതുകൊണ്ട്","poem":1},{"text":"ഞാൻ ജീവിതകാലമെല്ലാം ദൈവത്തെ വിളിച്ചപേക്ഷിക്കും","poem":2}]},{"type":"verse","number":3,"content":[{"text":"മരണപാശങ്ങൾ എന്നെ ചുറ്റി, പാതാള വേദനകൾ എന്നെ പിടിച്ചു;","poem":1},{"text":"ഞാൻ കഷ്ടവും സങ്കടവും അനുഭവിച്ചു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“അയ്യോ, യഹോവേ, എന്‍റെ പ്രാണനെ രക്ഷിക്കേണമേ”","poem":1},{"text":"എന്നു ഞാൻ യഹോവയുടെ നാമം വിളിച്ചപേക്ഷിച്ചു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"യഹോവ കൃപയും നീതിയും ഉള്ളവൻ;","poem":1},{"text":"നമ്മുടെ ദൈവം കരുണയുള്ളവൻ തന്നെ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"യഹോവ അല്പബുദ്ധികളെ സംരക്ഷിക്കുന്നു;","poem":1},{"text":"കർത്താവ് എന്നെ എളിയവനാക്കി, എന്നെ രക്ഷിക്കുകയും ചെയ്തു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"എൻ മനമേ, നീ വീണ്ടും സ്വസ്ഥമായിരിക്കുക;","poem":1},{"text":"എന്തെന്നാൽ യഹോവ എനിക്ക് നന്മ ചെയ്തിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"അങ്ങ് എന്‍റെ പ്രാണനെ മരണത്തിൽനിന്നും","poem":1},{"text":"എന്‍റെ കണ്ണിനെ കണ്ണുനീരിൽനിന്നും","poem":2},{"lineBreak":true},{"text":"എന്‍റെ കാലിനെ വീഴ്ചയിൽനിന്നും രക്ഷിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഞാൻ ജീവനുള്ളവരുടെ ദേശത്ത്","poem":1},{"text":"യഹോവയുടെ മുമ്പാകെ നടക്കും.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“ഞാൻ വലിയ കഷ്ടതയിൽ ആയി”","poem":1},{"text":"എന്നു പറഞ്ഞപ്പോഴും ഞാൻ എന്‍റെ വിശ്വാസം കാത്തു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“സകലമനുഷ്യരും ഭോഷ്ക്കു പറയുന്നു”","poem":1},{"text":"എന്നു ഞാൻ എന്‍റെ പരിഭ്രമത്തിൽ പറഞ്ഞു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"യഹോവ എനിക്ക് ചെയ്ത സകല ഉപകാരങ്ങൾക്കും","poem":1},{"text":"ഞാൻ കർത്താവിന് എന്ത് പകരം കൊടുക്കും?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ഞാൻ രക്ഷയുടെ പാനപാത്രം എടുത്ത്","poem":1},{"text":"യഹോവയുടെ നാമം വിളിച്ചപേക്ഷിക്കും.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"യഹോവയ്ക്ക് ഞാൻ എന്‍റെ നേർച്ചകൾ","poem":1},{"text":"കർത്താവിന്‍റെ സകലജനവും കാൺകെ കഴിക്കും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"തന്‍റെ ഭക്തന്മാരുടെ മരണം","poem":1},{"text":"യഹോവയ്ക്കു വിലയേറിയതാകുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"യഹോവേ, ഞാൻ അങ്ങേയുടെ ദാസൻ ആകുന്നു;","poem":1},{"text":"അങ്ങേയുടെ ദാസനും അങ്ങേയുടെ ദാസിയുടെ മകനും തന്നെ;","poem":2},{"lineBreak":true},{"text":"അങ്ങ് എന്‍റെ ബന്ധനങ്ങൾ അഴിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ഞാൻ അങ്ങേക്ക് സ്തോത്രയാഗം അർപ്പിച്ച്","poem":1},{"text":"യഹോവയുടെ നാമം വിളിച്ചപേക്ഷിക്കും.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ഞാൻ യഹോവയ്ക്ക് എന്‍റെ നേർച്ചകൾ","poem":1},{"text":"ദൈവത്തിന്‍റെ സകലജനവും കാൺകെ കഴിക്കും","poem":2}]},{"type":"verse","number":19,"content":[{"text":"യഹോവയുടെ ആലയത്തിന്‍റെ പ്രാകാരങ്ങളിലും","poem":1},{"text":"യെരൂശലേമേ, നിന്‍റെ നടുവിലും തന്നെ.","poem":2},{"lineBreak":true},{"text":"യഹോവയെ സ്തുതിക്കുവിൻ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}