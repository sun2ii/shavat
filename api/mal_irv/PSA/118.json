{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":118,"content":[{"type":"heading","content":["വിജയഗീതം"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"യഹോവയ്ക്കു സ്തോത്രം ചെയ്യുവീൻ; ദൈവം നല്ലവനല്ലയോ;","poem":1},{"text":"ദൈവത്തിന്‍റെ ദയ എന്നേക്കുമുള്ളത്.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ദൈവത്തിന്‍റെ ദയ എന്നേക്കുമുള്ളത്","poem":1},{"text":"എന്നു യിസ്രായേൽ പറയട്ടെ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ദൈവത്തിന്‍റെ ദയ എന്നേക്കുമുള്ളത്","poem":1},{"text":"എന്നു അഹരോൻഗൃഹം പറയട്ടെ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ദൈവത്തിന്‍റെ ദയ എന്നേക്കുമുള്ളത്","poem":1},{"text":"എന്നു യഹോവാഭക്തർ പറയട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ഞെരുക്കത്തിൽ ഞാൻ യഹോവയെ വിളിച്ചപേക്ഷിച്ചു,","poem":1},{"text":"യഹോവ ഉത്തരമരുളി എന്നെ വിശാലസ്ഥലത്താക്കി.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"യഹോവ എന്‍റെ പക്ഷത്തുണ്ട്; ഞാൻ ഭയപ്പെടുകയില്ല;","poem":1},{"text":"മനുഷ്യൻ എന്നോട് എന്ത് ചെയ്യും?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"എന്നെ സഹായിക്കുവാനായി യഹോവ എന്‍റെ പക്ഷത്തുണ്ട്;","poem":1},{"text":"എന്‍റെ ശത്രുക്കൾ പരാജയപ്പെടുന്നതു ഞാൻ കാണും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"മനുഷ്യനിൽ ആശ്രയിക്കുന്നതിനേക്കാൾ","poem":1},{"text":"യഹോവയിൽ ആശ്രയിക്കുന്നത് നല്ലത്.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"പ്രഭുക്കന്മാരിൽ ആശ്രയിക്കുന്നതിനേക്കാൾ","poem":1},{"lineBreak":true},{"text":"യഹോവയിൽ ആശ്രയിക്കുന്നത് നല്ലത്.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"സകലജനതകളും എന്നെ ചുറ്റിവളഞ്ഞു;","poem":1},{"text":"യഹോവയുടെ നാമത്തിൽ ഞാൻ അവരെ നശിപ്പിച്ചുകളയും","poem":2},{"noteId":111},{"text":".","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അവർ എന്നെ വളഞ്ഞു; അതേ, അവർ എന്നെ വളഞ്ഞു;","poem":1},{"text":"യഹോവയുടെ നാമത്തിൽ ഞാൻ അവരെ ഛേദിച്ചുകളയും.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവർ തേനീച്ചപോലെ എന്നെ പൊതിഞ്ഞു;","poem":1},{"text":"മുൾതീപോലെ അവർ കെട്ടുപോയി;","poem":2},{"lineBreak":true},{"text":"യഹോവയുടെ നാമത്തിൽ ഞാൻ അവരെ ഛേദിച്ചുകളയും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ഞാൻ വീഴുവാൻ തക്കവണ്ണം നീ എന്നെ തള്ളി;","poem":1},{"text":"എങ്കിലും യഹോവ എന്നെ സഹായിച്ചു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"യഹോവ എന്‍റെ ബലവും എന്‍റെ കീർത്തനവും ആകുന്നു;","poem":1},{"text":"അവിടുന്ന് എനിക്ക് രക്ഷയായും തീർന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ഉല്ലാസത്തിന്‍റെയും ജയത്തിന്‍റെയും ഘോഷം നീതിമാന്മാരുടെ കൂടാരങ്ങളിൽ ഉണ്ട്;","poem":1},{"text":"യഹോവയുടെ വലങ്കൈ വീര്യം പ്രവർത്തിക്കുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"യഹോവയുടെ വലങ്കൈ ഉയർന്നിരിക്കുന്നു;","poem":1},{"text":"യഹോവയുടെ വലങ്കൈ വീര്യം പ്രവർത്തിക്കുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ഞാൻ മരിക്കുകയില്ല; ഞാൻ ജീവനോടെയിരുന്ന്","poem":1},{"text":"യഹോവയുടെ പ്രവൃത്തികൾ വർണ്ണിക്കും.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"യഹോവ എന്നെ കഠിനമായി ശിക്ഷിച്ചു;","poem":1},{"text":"എങ്കിലും കർത്താവ് എന്നെ മരണത്തിന് ഏല്പിച്ചിട്ടില്ല.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"നീതിയുടെ വാതിലുകൾ എനിക്ക് തുറന്നു തരുവിൻ;","poem":1},{"text":"ഞാൻ അവയിൽകൂടി കടന്ന് യഹോവയ്ക്കു സ്തോത്രം ചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"യഹോവയുടെ വാതിൽ ഇതുതന്നെ;","poem":1},{"text":"നീതിമാന്മാർ അതിൽകൂടി കടക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"അങ്ങ് എനിക്ക് ഉത്തരമരുളി എന്‍റെ രക്ഷയായി തീർന്നിരിക്കുകയാൽ","poem":1},{"text":"ഞാൻ അങ്ങേക്കു സ്തോത്രം ചെയ്യും.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"വീടുപണിയുന്നവർ തള്ളിക്കളഞ്ഞ കല്ല്","poem":1},{"text":"മൂലക്കല്ലായി തീർന്നിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ഇത് യഹോവയാൽ സംഭവിച്ചു","poem":1},{"text":"നമ്മുടെ ദൃഷ്ടിയിൽ ആശ്ചര്യം ആയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ഇത് യഹോവ ഉണ്ടാക്കിയ ദിവസം;","poem":1},{"text":"ഇന്ന് നാം സന്തോഷിച്ച് ആനന്ദിക്കുക.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"യഹോവേ, ഞങ്ങളെ രക്ഷിക്കേണമേ;","poem":1},{"text":"യഹോവേ, ഞങ്ങൾക്ക് ജയം നല്കേണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"യഹോവയുടെ നാമത്തിൽ വരുന്നവൻ വാഴ്ത്തപ്പെട്ടവൻ;","poem":1},{"text":"ഞങ്ങൾ യഹോവയുടെ ആലയത്തിൽനിന്ന് നിങ്ങളെ അനുഗ്രഹിക്കുന്നു.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"യഹോവ തന്നെ ദൈവം; അവിടുന്ന് നമുക്ക് പ്രകാശം തന്നിരിക്കുന്നു;","poem":1},{"text":"യാഗപീഠത്തിന്‍റെ കൊമ്പുകളിൽ","poem":2},{"lineBreak":true},{"text":"യാഗമൃഗത്തെ കയറുകൊണ്ട് കെട്ടുവിൻ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"അങ്ങ് എന്‍റെ ദൈവമാകുന്നു; ഞാൻ അങ്ങേക്കു സ്തോത്രം ചെയ്യും;","poem":1},{"text":"അങ്ങ് എന്‍റെ ദൈവമാകുന്നു; ഞാൻ അങ്ങയെ പുകഴ്ത്തും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"യഹോവയ്ക്കു സ്തോത്രം ചെയ്യുവീൻ;","poem":1},{"text":"ദൈവം നല്ലവനല്ലയോ; അവിടുത്തെ ദയ എന്നേക്കും ഉള്ളതാകുന്നു.","poem":2}]}],"footnotes":[{"noteId":111,"caller":"+","text":"നശിപ്പിച്ചുകളയും ഛേദിച്ചുകളയും","reference":{"chapter":118,"verse":10}}]},"thisChapterLink":"/api/mal_irv/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}