{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":119,"content":[{"type":"heading","content":["യഹോവയുടെ ന്യായപ്രമാണത്തിന്‍റെ മഹത്വങ്ങൾ"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"യഹോവയുടെ ന്യായപ്രമാണം അനുസരിച്ച്","poem":1},{"text":"നടപ്പിൽ നിഷ്കളങ്കരായവർ ഭാഗ്യവാന്മാർ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവിടുത്തെ സാക്ഷ്യങ്ങൾ പ്രമാണിച്ച്","poem":1},{"text":"പൂർണ്ണഹൃദയത്തോടെ അവിടുത്തെ അന്വേഷിക്കുന്നവർ ഭാഗ്യവാന്മാർ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവർ നീതികേട് പ്രവർത്തിക്കാതെ","poem":1},{"text":"കർത്താവിന്‍റെ വഴികളിൽ തന്നെ നടക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അങ്ങേയുടെ പ്രമാണങ്ങൾ കൃത്യമായി ആചരിക്കേണ്ടതിന്","poem":1},{"text":"അങ്ങ് അവ കല്പിച്ചുതന്നിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അങ്ങേയുടെ ചട്ടങ്ങൾ ആചരിക്കേണ്ടതിന്","poem":1},{"text":"എന്‍റെ നടപ്പ് സ്ഥിരതയുള്ളതായെങ്കിൽ കൊള്ളാമായിരുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അങ്ങേയുടെ സകല കല്പനകളും ശ്രദ്ധിക്കുന്ന കാലത്തോളം","poem":1},{"text":"ഞാൻ ലജ്ജിച്ചു പോകുകയില്ല.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അങ്ങേയുടെ നീതിയുള്ള വിധികൾ പഠിച്ചിട്ട്","poem":1},{"text":"ഞാൻ പരമാർത്ഥ ഹൃദയത്തോടെ അങ്ങേക്കു സ്തോത്രം ചെയ്യും.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ഞാൻ അങ്ങേയുടെ ചട്ടങ്ങൾ ആചരിക്കും;","poem":1},{"text":"എന്നെ അശേഷം ഉപേക്ഷിക്കരുതേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ഒരു ബാലൻ തന്‍റെ നടപ്പ് നിർമ്മലമായി സൂക്ഷിക്കുന്നത് എങ്ങനെ?","poem":1},{"text":"അങ്ങേയുടെ വചനപ്രകാരം തന്‍റെ നടപ്പ് ശ്രദ്ധിക്കുന്നതിനാൽ തന്നെ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ഞാൻ പൂർണ്ണഹൃദയത്തോടെ അങ്ങയെ അന്വേഷിക്കുന്നു;","poem":1},{"text":"അങ്ങേയുടെ കല്പനകൾ വിട്ടുനടക്കുവാൻ എനിക്ക് ഇടവരരുതേ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ഞാൻ അങ്ങേയോട് പാപം ചെയ്യാതിരിക്കേണ്ടതിന്","poem":1},{"text":"അങ്ങേയുടെ വചനം എന്‍റെ ഹൃദയത്തിൽ സംഗ്രഹിക്കുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"യഹോവേ, അവിടുന്ന് വാഴ്ത്തപ്പെട്ടവൻ;","poem":1},{"text":"അങ്ങേയുടെ ചട്ടങ്ങൾ എനിക്ക് ഉപദേശിച്ചു തരേണമേ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ഞാൻ എന്‍റെ അധരങ്ങൾ കൊണ്ടു","poem":1},{"text":"അങ്ങേയുടെ വായിൽനിന്നുള്ള വിധികളെ ഒക്കെയും വർണ്ണിക്കുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ഞാൻ സർവ്വസമ്പത്തിലും എന്നപോലെ","poem":1},{"text":"അങ്ങേയുടെ സാക്ഷ്യങ്ങളുടെ വഴിയിൽ ആനന്ദിക്കുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഞാൻ അങ്ങേയുടെ പ്രമാണങ്ങൾ ധ്യാനിക്കുകയും","poem":1},{"text":"അങ്ങേയുടെ വഴികളെ ശ്രദ്ധിച്ചുനോക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ഞാൻ അങ്ങേയുടെ ചട്ടങ്ങളിൽ പ്രമോദിക്കും;","poem":1},{"text":"അങ്ങേയുടെ വചനം മറക്കുകയുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ജീവിച്ചിരുന്ന് അങ്ങേയുടെ വചനം പ്രമാണിക്കേണ്ടതിന്","poem":1},{"text":"അടിയന് നന്മ ചെയ്യേണമേ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അങ്ങേയുടെ ന്യായപ്രമാണത്തിലെ അത്ഭുതകാര്യങ്ങൾ കാണേണ്ടതിന്","poem":1},{"text":"എന്‍റെ കണ്ണുകളെ തുറക്കേണമേ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ഞാൻ ഭൂമിയിൽ പരദേശിയാകുന്നു;","poem":1},{"text":"അങ്ങേയുടെ കല്പനകൾ എനിക്ക് മറച്ചുവയ്ക്കരുതേ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അങ്ങേയുടെ വിധികൾക്കുവേണ്ടിയുള്ള നിരന്തരവാഞ്ഛകൊണ്ട്","poem":1},{"text":"എന്‍റെ മനസ്സു തകർന്നിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അങ്ങേയുടെ കല്പനകൾ വിട്ട് തെറ്റി നടക്കുന്നവരായ","poem":1},{"text":"ശപിക്കപ്പെട്ട അഹങ്കാരികളെ നീ ഭത്സിക്കുന്നു.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"നിന്ദയും അപമാനവും എന്നോട് അകറ്റേണമേ;","poem":1},{"text":"ഞാൻ അങ്ങേയുടെ സാക്ഷ്യങ്ങൾ പ്രമാണിക്കുന്നു.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"അധികാരികളും കൂടിയിരുന്ന് എനിക്ക് വിരോധമായി സംസാരിക്കുന്നു;","poem":1},{"text":"എങ്കിലും അടിയൻ അങ്ങേയുടെ ചട്ടങ്ങളെ ധ്യാനിക്കുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അങ്ങേയുടെ സാക്ഷ്യങ്ങൾ എന്‍റെ പ്രമോദവും","poem":1},{"text":"എന്‍റെ ആലോചനക്കാരും ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"എന്‍റെ പ്രാണൻ പൊടിയോടു പറ്റിയിരിക്കുന്നു;","poem":1},{"text":"തിരുവചനപ്രകാരം എന്നെ ജീവിപ്പിക്കേണമേ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"എന്‍റെ വഴികളെ ഞാൻ വിവരിച്ചപ്പോൾ അങ്ങ് എനിക്ക് ഉത്തരമരുളി;","poem":1},{"text":"അങ്ങേയുടെ ചട്ടങ്ങൾ എനിക്ക് ഉപദേശിച്ചു തരേണമേ.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"അങ്ങേയുടെ പ്രമാണങ്ങളുടെ വഴി എന്നെ ഗ്രഹിപ്പിക്കേണമേ;","poem":1},{"text":"എന്നാൽ ഞാൻ അങ്ങേയുടെ അത്ഭുത ഉപദേശങ്ങളെ ധ്യാനിക്കും","poem":2},{"noteId":112},{"text":".","poem":2}]},{"type":"verse","number":28,"content":[{"text":"എന്‍റെ പ്രാണൻ വിഷാദംകൊണ്ട് ഉരുകുന്നു;","poem":1},{"text":"അങ്ങേയുടെ വചനപ്രകാരം എന്നെ ശക്തീകരിക്കേണമേ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ഭോഷ്കിന്‍റെ വഴി എന്നോട് അകറ്റേണമേ;","poem":1},{"text":"അങ്ങേയുടെ ന്യായപ്രമാണം എനിക്ക് കൃപയോടെ നല്കേണമേ.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"വിശ്വസ്തതയുടെ മാർഗ്ഗം ഞാൻ തിരഞ്ഞെടുത്തിരിക്കുന്നു;","poem":1},{"text":"അങ്ങേയുടെ വിധികൾ എന്‍റെ മുമ്പിൽ വച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ഞാൻ അങ്ങേയുടെ സാക്ഷ്യങ്ങളോടു പറ്റിയിരിക്കുന്നു;","poem":1},{"text":"യഹോവേ, എന്നെ ലജ്ജിപ്പിക്കരുതേ.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"അങ്ങ് എന്‍റെ ഹൃദയത്തെ വിശാലമാക്കുമ്പോൾ","poem":1},{"text":"ഞാൻ അങ്ങേയുടെ കല്പനകളുടെ വഴിയിൽ ഓടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"യഹോവേ, അങ്ങേയുടെ ചട്ടങ്ങളുടെ വഴി എന്നെ ഉപദേശിക്കേണമേ;","poem":1},{"text":"ഞാൻ അത് അവസാനത്തോളം പ്രമാണിക്കും.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ഞാൻ അങ്ങേയുടെ ന്യായപ്രമാണം കാക്കേണ്ടതിനും","poem":1},{"text":"അത് പൂർണ്ണഹൃദയത്തോടെ പ്രമാണിക്കേണ്ടതിനും എനിക്ക് ബുദ്ധി നല്കേണമേ.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"അങ്ങേയുടെ കല്പനകളുടെ പാതയിൽ എന്നെ നടത്തേണമേ;","poem":1},{"text":"ഞാൻ അത് ഇഷ്ടപ്പെടുന്നുവല്ലോ.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ദുരാദായത്തിലേക്കല്ല, അങ്ങേയുടെ സാക്ഷ്യങ്ങളിലേക്കു തന്നെ","poem":1},{"text":"എന്‍റെ ഹൃദയം ചായുമാറാക്കേണമേ.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"വ്യാജത്തിലേക്കു നോക്കാതെ എന്‍റെ കണ്ണുകൾ തിരിച്ച്","poem":1},{"text":"അങ്ങേയുടെ വഴികളിൽ എന്നെ ജീവിപ്പിക്കേണമേ.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"അങ്ങയോടുള്ള ഭക്തി വർദ്ധിപ്പിക്കുന്ന","poem":1},{"text":"അങ്ങേയുടെ വചനം അടിയന് ഉറപ്പിച്ചുതരേണമേ.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"ഞാൻ പേടിക്കുന്ന നിന്ദ എന്നോട് അകറ്റിക്കളേയണമേ;","poem":1},{"text":"അങ്ങേയുടെ വിധികൾ നല്ലവയല്ലയോ?","poem":2}]},{"type":"verse","number":40,"content":[{"text":"ഇതാ, ഞാൻ അങ്ങേയുടെ പ്രമാണങ്ങളെ വാഞ്ഛിക്കുന്നു;","poem":1},{"text":"അങ്ങേയുടെ നീതിയാൽ എന്നെ ജീവിപ്പിക്കേണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"യഹോവേ, അങ്ങേയുടെ വചനപ്രകാരം അങ്ങേയുടെ ദയയും","poem":1},{"text":"അങ്ങേയുടെ രക്ഷയും എന്നിലേക്ക് വരുമാറാകട്ടെ.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"ഞാൻ അങ്ങേയുടെ വചനത്തിൽ ആശ്രയിക്കുന്നതുകൊണ്ട്","poem":1},{"text":"എന്നെ നിന്ദിക്കുന്നവനോട് ഉത്തരം പറയുവാൻ ഞാൻ പ്രാപ്തനാകും.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"ഞാൻ അങ്ങേയുടെ വിധികൾക്കായി കാത്തിരിക്കുകയാൽ","poem":1},{"text":"സത്യത്തിന്‍റെ വചനം എന്‍റെ വായിൽനിന്ന് നീക്കിക്കളയരുതേ.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"അങ്ങനെ ഞാൻ അങ്ങേയുടെ ന്യായപ്രമാണം","poem":1},{"text":"ഇടവിടാതെ എന്നേക്കും പ്രമാണിക്കും.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"അങ്ങേയുടെ പ്രമാണങ്ങൾ ആരായുന്നതുകൊണ്ട്","poem":1},{"text":"ഞാൻ വിശാലതയിൽ നടക്കും.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"ഞാൻ ലജ്ജിക്കാതെ രാജാക്കന്മാരുടെ മുമ്പിലും","poem":1},{"text":"അങ്ങേയുടെ സാക്ഷ്യങ്ങളെക്കുറിച്ചു സംസാരിക്കും.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"ഞാൻ അങ്ങേയുടെ കല്പനകളിൽ പ്രമോദിക്കുന്നു;","poem":1},{"text":"അവ എനിക്ക് പ്രിയമായിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"എനിക്ക് പ്രിയമായിരിക്കുന്ന അങ്ങേയുടെ കല്പനകളിലേക്ക് ഞാൻ കൈകൾ ഉയർത്തുന്നു;","poem":1},{"text":"അങ്ങേയുടെ ചട്ടങ്ങൾ ഞാൻ ധ്യാനിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"എനിക്ക് പ്രത്യാശ നൽകുവാൻ കാരണമായ","poem":1},{"text":"അടിയനോടുള്ള അങ്ങേയുടെ വചനത്തെ ഓർക്കേണമേ.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"അങ്ങേയുടെ വചനം എന്നെ ജീവിപ്പിച്ചിരിക്കുന്നത്","poem":1},{"text":"എന്‍റെ കഷ്ടതയിൽ എനിക്ക് ആശ്വാസമാകുന്നു.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"അഹങ്കാരികൾ എന്നെ അത്യന്തം പരിഹസിച്ചു;","poem":1},{"text":"എന്നാൽ ഞാൻ അങ്ങേയുടെ ന്യായപ്രമാണം വിട്ടുമാറിയിട്ടില്ല.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"യഹോവേ, പുരാതനമായ അങ്ങേയുടെ വിധികൾ ഓർത്തു","poem":1},{"text":"ഞാൻ എന്നെത്തന്നെ ആശ്വസിപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"അങ്ങേയുടെ ന്യായപ്രമാണം ഉപേക്ഷിക്കുന്ന ദുഷ്ടന്മാർനിമിത്തം","poem":1},{"text":"എനിക്ക് ഉഗ്രകോപം പിടിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"ഞാൻ പരദേശിയായി പാർക്കുന്ന വീട്ടിൽ","poem":1},{"text":"അങ്ങേയുടെ ചട്ടങ്ങൾ എന്‍റെ കീർത്തനം ആകുന്നു.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"യഹോവേ, രാത്രിയിൽ ഞാൻ തിരുനാമം ഓർക്കുന്നു;","poem":1},{"text":"അങ്ങേയുടെ ന്യായപ്രമാണം ഞാൻ ആചരിക്കുന്നു.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"അങ്ങേയുടെ പ്രമാണങ്ങൾ അനുസരിക്കുന്നത്","poem":1},{"text":"എനിക്ക് അനുഗ്രഹമായിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":57,"content":[{"text":"യഹോവേ, അങ്ങ് എന്‍റെ ഓഹരിയാകുന്നു;","poem":1},{"text":"ഞാൻ അങ്ങേയുടെ വചനങ്ങൾ പ്രമാണിക്കും എന്നു ഞാൻ പറഞ്ഞു.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"പൂർണ്ണഹൃദയത്തോടെ ഞാൻ അങ്ങേയുടെ കൃപയ്ക്കായി അപേക്ഷിക്കുന്നു;","poem":1},{"text":"അങ്ങേയുടെ വാഗ്ദാനപ്രകാരം എന്നോട് കൃപയുണ്ടാകേണമേ.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"ഞാൻ എന്‍റെ വഴികളെക്കുറിച്ച് ചിന്തിച്ച്,","poem":1},{"text":"എന്‍റെ കാലുകൾ അങ്ങേയുടെ സാക്ഷ്യങ്ങളിലേക്കു തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"അങ്ങേയുടെ കല്പനകൾ പ്രമാണിക്കുവാൻ","poem":1},{"text":"ഞാൻ ഒട്ടും വൈകാതെ ബദ്ധപ്പെടുന്നു;","poem":2}]},{"type":"verse","number":61,"content":[{"text":"ദുഷ്ടന്മാരുടെ കയറുകൾ എന്നെ ചുറ്റിയിരിക്കുന്നു;","poem":1},{"text":"എങ്കിലും ഞാൻ അങ്ങേയുടെ ന്യായപ്രമാണം മറക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"അങ്ങേയുടെ നീതിയുള്ള ന്യായവിധികൾനിമിത്തം","poem":1},{"text":"അങ്ങേക്കു സ്തോത്രം ചെയ്യുവാൻ ഞാൻ അർദ്ധരാത്രിയിൽ എഴുന്നേല്‍ക്കും.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"അങ്ങയെ ഭയപ്പെടുകയും അങ്ങേയുടെ പ്രമാണങ്ങൾ അനുസരിക്കുകയും","poem":1},{"text":"ചെയ്യുന്ന എല്ലാവർക്കും ഞാൻ സ്നേഹിതനാകുന്നു.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"യഹോവേ, ഭൂമി അങ്ങേയുടെ ദയകൊണ്ടു നിറഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"അങ്ങേയുടെ ചട്ടങ്ങൾ എനിക്ക് ഉപദേശിച്ചു തരേണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":65,"content":[{"text":"യഹോവേ, തിരുവചനപ്രകാരം","poem":1},{"text":"അങ്ങ് അടിയന് നന്മ ചെയ്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"അങ്ങേയുടെ കല്പനകൾ ഞാൻ വിശ്വസിച്ചിരിക്കുകയാൽ","poem":1},{"text":"എനിക്ക് നല്ലബുദ്ധിയും പരിജ്ഞാനവും ഉപദേശിച്ചു തരേണമേ.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"കഷ്ടതയിൽ ആകുന്നതിനു മുമ്പ് ഞാൻ തെറ്റിപ്പോയി;","poem":1},{"text":"ഇപ്പോൾ ഞാൻ അങ്ങേയുടെ വചനം പ്രമാണിക്കുന്നു.","poem":2}]},{"type":"verse","number":68,"content":[{"text":"അങ്ങ് നല്ലവനും നന്മ ചെയ്യുന്നവനും ആകുന്നു;","poem":1},{"text":"അങ്ങേയുടെ ചട്ടങ്ങൾ എനിക്ക് ഉപദേശിച്ചു തരേണമേ.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"അഹങ്കാരികൾ എന്നെക്കുറിച്ച് നുണ പറഞ്ഞുണ്ടാക്കി;","poem":1},{"text":"ഞാൻ പൂർണ്ണഹൃദയത്തോടെ അങ്ങേയുടെ പ്രമാണങ്ങൾ അനുസരിക്കും.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"അവരുടെ ഹൃദയത്തില്‍ സത്യം ഇല്ല","poem":1},{"noteId":113},{"text":";","poem":1},{"text":"ഞാൻ അങ്ങേയുടെ ന്യായപ്രമാണത്തിൽ രസിക്കുന്നു.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"അങ്ങേയുടെ ചട്ടങ്ങൾ പഠിക്കുവാൻ തക്കവണ്ണം","poem":1},{"text":"ഞാൻ കഷ്ടതയിൽ ആയിരുന്നത് എനിക്ക് ഗുണമായി.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"ആയിരം ആയിരം പൊൻവെള്ളി നാണ്യങ്ങളെക്കാൾ","poem":1},{"text":"അങ്ങേയുടെ വായിൽനിന്നുള്ള ന്യായപ്രമാണം എനിക്കുത്തമം.","poem":2}]},{"type":"line_break"},{"type":"verse","number":73,"content":[{"text":"തൃക്കൈകൾ എന്നെ സൃഷ്ടിക്കുകയും രൂപപ്പെടുത്തുകയും ചെയ്തിരിക്കുന്നു;","poem":1},{"text":"അങ്ങേയുടെ കല്പനകൾ പഠിക്കുവാൻ എനിക്ക് ബുദ്ധി നല്കേണമേ.","poem":2}]},{"type":"verse","number":74,"content":[{"text":"തിരുവചനത്തിൽ ഞാൻ പ്രത്യാശ വച്ചിരിക്കുകയാൽ","poem":1},{"text":"അങ്ങേയുടെ ഭക്തന്മാർ എന്നെ കണ്ടു സന്തോഷിക്കുന്നു.","poem":2}]},{"type":"verse","number":75,"content":[{"text":"യഹോവേ, അങ്ങേയുടെ വിധികൾ നീതിയുള്ളവയെന്നും","poem":1},{"text":"വിശ്വസ്തതയോടെ അങ്ങ് എന്നെ താഴ്ത്തിയിരിക്കുന്നു എന്നും ഞാൻ അറിയുന്നു.","poem":2}]},{"type":"verse","number":76,"content":[{"text":"അടിയനോടുള്ള അങ്ങേയുടെ വാഗ്ദാനപ്രകാരം","poem":1},{"text":"അങ്ങേയുടെ ദയ എന്നെ ആശ്വസിപ്പിക്കട്ടെ.","poem":2}]},{"type":"verse","number":77,"content":[{"text":"ഞാൻ ജീവിച്ചിരിക്കേണ്ടതിന് എന്നോട് കരുണ തോന്നേണമേ;","poem":1},{"text":"അങ്ങേയുടെ ന്യായപ്രമാണത്തിൽ ഞാൻ പ്രമോദിക്കുന്നു.","poem":2}]},{"type":"verse","number":78,"content":[{"text":"കാരണംകൂടാതെ എന്നെ വെറുതെ ഉപദ്രവിക്കുന്ന അഹങ്കാരികൾ ലജ്ജിച്ചുപോകട്ടെ;","poem":1},{"text":"ഞാൻ അങ്ങേയുടെ കല്പനകൾ ധ്യാനിക്കുന്നു.","poem":2}]},{"type":"verse","number":79,"content":[{"text":"അങ്ങേയുടെ ഭക്തന്മാരും അങ്ങേയുടെ സാക്ഷ്യങ്ങൾ അറിയുന്നവരും","poem":1},{"text":"എന്‍റെ അടുക്കൽ വരട്ടെ.","poem":2}]},{"type":"verse","number":80,"content":[{"text":"ഞാൻ ലജ്ജിച്ചു പോകാതിരിക്കേണ്ടതിന്","poem":1},{"text":"എന്‍റെ ഹൃദയം അങ്ങേയുടെ ചട്ടങ്ങളിൽ നിഷ്കളങ്കമായിരിക്കട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":81,"content":[{"text":"ഞാൻ അങ്ങേയുടെ രക്ഷക്കായി കാത്തിരുന്ന് തളർന്നുപോകുന്നു;","poem":1},{"text":"അങ്ങേയുടെ വാഗ്ദാനം ഞാൻ പ്രതീക്ഷിച്ചുകൊണ്ടിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":82,"content":[{"text":"എപ്പോൾ അങ്ങ് എന്നെ ആശ്വസിപ്പിക്കും എന്നു ചിന്തിച്ച്","poem":1},{"text":"എന്‍റെ കണ്ണ് അങ്ങേയുടെ വാഗ്ദാനം കാത്തിരുന്ന് ക്ഷീണിക്കുന്നു.","poem":2}]},{"type":"verse","number":83,"content":[{"text":"ഞാൻ പുകയത്തു വച്ച തോൽതുരുത്തിപോലെ ആകുന്നു.","poem":1},{"text":"എങ്കിലും അങ്ങേയുടെ ചട്ടങ്ങൾ മറക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":84,"content":[{"text":"അടിയന്‍റെ ജീവകാലം എത്ര നാൾ?","poem":1},{"text":"എന്നെ ഉപദ്രവിക്കുന്നവരുടെമേൽ അങ്ങ് എപ്പോൾ ന്യായവിധി നടത്തും?","poem":2}]},{"type":"verse","number":85,"content":[{"text":"അങ്ങേയുടെ ന്യായപ്രമാണം അനുസരിക്കാത്ത","poem":1},{"text":"അഹങ്കാരികൾ എനിക്കായി കുഴി കുഴിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":86,"content":[{"text":"അങ്ങേയുടെ കല്പനകളെല്ലം വിശ്വാസ്യമാകുന്നു;","poem":1},{"text":"അവർ എന്നെ വെറുതെ ഉപദ്രവിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"എന്നെ സഹായിക്കേണമേ.","poem":2}]},{"type":"verse","number":87,"content":[{"text":"അവർ ഭൂമിയിൽ എന്നെ മിക്കവാറും ഇല്ലാതെയാക്കിയിരിക്കുന്നു;","poem":1},{"text":"അങ്ങേയുടെ പ്രമാണങ്ങൾ ഞാൻ ഉപേക്ഷിച്ചില്ലതാനും.","poem":2}]},{"type":"verse","number":88,"content":[{"text":"അങ്ങേയുടെ ദയയ്ക്കു തക്കവണ്ണം എന്നെ സംരക്ഷിക്കേണമേ","poem":1},{"noteId":114},{"text":";","poem":1},{"text":"ഞാൻ അങ്ങേയുടെ വായിൽനിന്നുള്ള സാക്ഷ്യങ്ങൾ പ്രമാണിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":89,"content":[{"text":"യഹോവേ, അങ്ങേയുടെ വചനം","poem":1},{"text":"സ്വർഗ്ഗത്തിൽ എന്നേക്കും സ്ഥിരമായിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":90,"content":[{"text":"അങ്ങേയുടെ വിശ്വസ്തത തലമുറതലമുറയോളം ഇരിക്കുന്നു;","poem":1},{"text":"അങ്ങ് ഭൂമിയെ സ്ഥാപിച്ചു, അത് നിലനില്ക്കുന്നു.","poem":2}]},{"type":"verse","number":91,"content":[{"text":"അവ ഇന്നുവരെ അങ്ങേയുടെ നിയമപ്രകാരം നിലനില്ക്കുന്നു;","poem":1},{"text":"സർവ്വസൃഷ്ടികളും അങ്ങേയുടെ ദാസന്മാരല്ലോ.","poem":2}]},{"type":"verse","number":92,"content":[{"text":"അങ്ങേയുടെ ന്യായപ്രമാണം എന്‍റെ പ്രമോദം ആയിരുന്നില്ലെങ്കിൽ","poem":1},{"text":"ഞാൻ എന്‍റെ കഷ്ടതയിൽ നശിച്ചുപോകുമായിരുന്നു.","poem":2}]},{"type":"verse","number":93,"content":[{"text":"ഞാൻ ഒരുനാളും അങ്ങേയുടെ പ്രമാണങ്ങൾ മറക്കുകയില്ല;","poem":1},{"text":"അവയാൽ അങ്ങ് എന്നെ ജീവിപ്പിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":94,"content":[{"text":"ഞാൻ അങ്ങേക്കുള്ളവനത്രെ; എന്നെ രക്ഷിക്കേണമേ;","poem":1},{"text":"ഞാൻ അങ്ങേയുടെ പ്രമാണങ്ങൾ അന്വേഷിക്കുന്നു.","poem":2}]},{"type":"verse","number":95,"content":[{"text":"ദുഷ്ടന്മാർ എന്നെ നശിപ്പിക്കുവാൻ കാത്തിരുന്നു;","poem":1},{"text":"എന്നാൽ ഞാൻ നിന്‍റെ സാക്ഷ്യങ്ങൾ ചിന്തിച്ചുകൊള്ളും.","poem":2}]},{"type":"verse","number":96,"content":[{"text":"സകല പൂർണ്ണതയ്ക്കും ഞാൻ ഒരു പര്യവസാനം കണ്ടിരിക്കുന്നു;","poem":1},{"text":"അങ്ങേയുടെ കല്പനയോ അതിരുകള്‍ ഇല്ലാത്തതായിരിക്കുന്നു","poem":2},{"noteId":115},{"text":".","poem":2}]},{"type":"verse","number":97,"content":[{"text":"അങ്ങേയുടെ ന്യായപ്രമാണം എനിക്ക് എത്രയോ പ്രിയം;","poem":1},{"text":"ദിവസം മുഴുവനും അത് എന്‍റെ ധ്യാനമാകുന്നു.","poem":2}]},{"type":"verse","number":98,"content":[{"text":"അങ്ങേയുടെ കല്പനകൾ എന്നെ എന്‍റെ ശത്രുക്കളെക്കാൾ ബുദ്ധിമാനാക്കുന്നു;","poem":1},{"text":"അവ എപ്പോഴും എന്‍റെ പക്കൽ ഉണ്ട്.","poem":2}]},{"type":"verse","number":99,"content":[{"text":"അങ്ങേയുടെ സാക്ഷ്യങ്ങൾ എന്‍റെ ധ്യാനമായിരിക്കുകകൊണ്ട്","poem":1},{"text":"എന്‍റെ സകല ഗുരുക്കന്മാരെക്കാളും ഞാൻ വിവേകമുള്ളവനാകുന്നു.","poem":2}]},{"type":"verse","number":100,"content":[{"text":"അങ്ങേയുടെ പ്രമാണങ്ങൾ അനുസരിക്കുകയാൽ","poem":1},{"text":"ഞാൻ വൃദ്ധന്മാരിലും വിവേകമുള്ളവനാകുന്നു.","poem":2}]},{"type":"verse","number":101,"content":[{"text":"അങ്ങേയുടെ വചനം പ്രമാണിക്കേണ്ടതിന്","poem":1},{"text":"ഞാൻ സകല ദുർമാർഗ്ഗത്തിൽനിന്നും കാലുകളെ വിലക്കുന്നു.","poem":2}]},{"type":"verse","number":102,"content":[{"text":"അങ്ങ് എന്നെ ഉപദേശിച്ചിരിക്കുകയാൽ","poem":1},{"text":"ഞാൻ അങ്ങേയുടെ വിധികൾ വിട്ടുമാറിയിട്ടില്ല.","poem":2}]},{"type":"verse","number":103,"content":[{"text":"തിരുവചനം എന്‍റെ നാവിന് എത്ര മധുരം!","poem":1},{"text":"അവ എന്‍റെ വായ്ക്ക് തേനിലും നല്ലത്.","poem":2}]},{"type":"verse","number":104,"content":[{"text":"അങ്ങേയുടെ പ്രമാണങ്ങളാൽ ഞാൻ വിവേകമുള്ളവനാകുന്നു.","poem":1},{"text":"അതുകൊണ്ട് ഞാൻ സകലവ്യാജമാർഗ്ഗവും വെറുക്കുന്നു.","poem":2}]},{"type":"verse","number":105,"content":[{"text":"അങ്ങേയുടെ വചനം എന്‍റെ കാലിന് ദീപവും","poem":1},{"text":"എന്‍റെ പാതയ്ക്കു പ്രകാശവും ആകുന്നു.","poem":2}]},{"type":"verse","number":106,"content":[{"text":"അങ്ങേയുടെ നീതിയുള്ള വിധികൾ പ്രമാണിക്കുമെന്ന്","poem":1},{"text":"ഞാൻ സത്യംചെയ്തു; അത് ഞാൻ നിവർത്തിക്കും.","poem":2}]},{"type":"verse","number":107,"content":[{"text":"ഞാൻ മഹാകഷ്ടത്തിലായിരിക്കുന്നു;","poem":1},{"text":"യഹോവേ, അങ്ങേയുടെ വാഗ്ദാനപ്രകാരം എന്നെ ജീവിപ്പിക്കേണമേ.","poem":2}]},{"type":"verse","number":108,"content":[{"text":"യഹോവേ, എന്‍റെ വായുടെ സ്വമേധാദാനങ്ങളിൽ പ്രസാദിക്കേണമേ;","poem":1},{"text":"അങ്ങേയുടെ വിധികൾ എനിക്ക് ഉപദേശിച്ചു തരേണമേ.","poem":2}]},{"type":"verse","number":109,"content":[{"text":"എന്‍റെ ജീവന്‍ എപ്പോഴും അപകടത്തില്‍ ആയിരിക്കുന്നു","poem":1},{"noteId":116},{"text":";","poem":1},{"text":"എങ്കിലും അങ്ങേയുടെ ന്യായപ്രമാണം ഞാൻ മറക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":110,"content":[{"text":"ദുഷ്ടന്മാർ എനിക്ക് കെണി വച്ചിരിക്കുന്നു;","poem":1},{"text":"എങ്കിലും ഞാൻ അങ്ങേയുടെ പ്രമാണങ്ങൾ ഉപേക്ഷിക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":111,"content":[{"text":"ഞാൻ അങ്ങേയുടെ സാക്ഷ്യങ്ങളെ എന്‍റെ ശാശ്വതാവകാശമാക്കിയിരിക്കുന്നു;","poem":1},{"text":"അവ എന്‍റെ ഹൃദയത്തിന്‍റെ ആനന്ദമാകുന്നു.","poem":2}]},{"type":"verse","number":112,"content":[{"text":"അങ്ങേയുടെ ചട്ടങ്ങളെ ഇടവിടാതെ എന്നേക്കും ആചരിക്കുവാൻ","poem":1},{"text":"ഞാൻ എന്‍റെ ഹൃദയം ചായിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":113,"content":[{"text":"ഇരുമനസ്സുള്ളവരെ ഞാൻ വെറുക്കുന്നു;","poem":1},{"text":"എന്നാൽ അങ്ങേയുടെ ന്യായപ്രമാണം എനിക്ക് പ്രിയമാകുന്നു.","poem":2}]},{"type":"verse","number":114,"content":[{"text":"അങ്ങ് എന്‍റെ മറവിടവും എന്‍റെ പരിചയും ആകുന്നു;","poem":1},{"text":"ഞാൻ തിരുവചനത്തിൽ പ്രത്യാശ വച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":115,"content":[{"text":"എന്‍റെ ദൈവത്തിന്‍റെ കല്പനകൾ ഞാൻ പ്രമാണിക്കേണ്ടതിന്","poem":1},{"text":"ദുഷ്കർമ്മികളേ, എന്നെവിട്ടു പോകുവിൻ.","poem":2}]},{"type":"verse","number":116,"content":[{"text":"ഞാൻ ജീവിച്ചിരിക്കേണ്ടതിന് അങ്ങേയുടെ വചനപ്രകാരം എന്നെ താങ്ങേണമേ;","poem":1},{"text":"എന്‍റെ പ്രത്യാശയിൽ ഞാൻ ലജ്ജിച്ചുപോകരുതേ.","poem":2}]},{"type":"verse","number":117,"content":[{"text":"ഞാൻ രക്ഷപെടേണ്ടതിന് എന്നെ താങ്ങേണമേ;","poem":1},{"text":"അങ്ങേയുടെ ചട്ടങ്ങൾ ഞാൻ നിരന്തരം അനുസരിക്കും.","poem":2}]},{"type":"verse","number":118,"content":[{"text":"അങ്ങേയുടെ ചട്ടങ്ങൾ ഉപേക്ഷിക്കുന്ന സകലരേയും അങ്ങ് നിരസിക്കുന്നു;","poem":1},{"text":"അവരുടെ വഞ്ചന വ്യർത്ഥമാകുന്നു.","poem":2}]},{"type":"verse","number":119,"content":[{"text":"ഭൂമിയിലെ സകലദുഷ്ടന്മാരെയും അങ്ങ് മാലിന്യംപോലെ നീക്കിക്കളയുന്നു;","poem":1},{"text":"അതുകൊണ്ട് അങ്ങേയുടെ സാക്ഷ്യങ്ങൾ എനിക്ക് പ്രിയമാകുന്നു.","poem":2}]},{"type":"verse","number":120,"content":[{"text":"അങ്ങയെക്കുറിച്ചുള്ള ഭയം നിമിത്തം എന്‍റെ ദേഹം വിറയ്ക്കുന്നു;","poem":1},{"text":"അങ്ങേയുടെ വിധികൾനിമിത്തം ഞാൻ ഭയപ്പെടുന്നു.","poem":2}]},{"type":"verse","number":121,"content":[{"text":"ഞാൻ നീതിയും ന്യായവും പ്രവർത്തിക്കുന്നു;","poem":1},{"text":"എന്‍റെ പീഡകന്മാർക്ക് എന്നെ ഏല്പിച്ചുകൊടുക്കരുതേ.","poem":2}]},{"type":"verse","number":122,"content":[{"text":"അടിയന്‍റെ നന്മയ്ക്കുവേണ്ടി ഉത്തരവാദി ആയിരിക്കേണമേ;","poem":1},{"text":"അഹങ്കാരികൾ എന്നെ പീഡിപ്പിക്കരുതേ.","poem":2}]},{"type":"verse","number":123,"content":[{"text":"എന്‍റെ കണ്ണ് അങ്ങേയുടെ രക്ഷയെയും","poem":1},{"text":"അങ്ങേയുടെ നീതിയുടെ വചനത്തെയും കാത്തിരുന്ന് ക്ഷീണിക്കുന്നു.","poem":2}]},{"type":"verse","number":124,"content":[{"text":"അങ്ങേയുടെ ദയക്കു തക്കവണ്ണം അടിയനോടു പ്രവർത്തിച്ച്,","poem":1},{"text":"അങ്ങേയുടെ ചട്ടങ്ങൾ എനിക്ക് ഉപദേശിച്ചു തരേണമേ.","poem":2}]},{"type":"verse","number":125,"content":[{"text":"ഞാൻ അങ്ങേയുടെ ദാസൻ ആകുന്നു;","poem":1},{"text":"അങ്ങേയുടെ സാക്ഷ്യങ്ങൾ ഗ്രഹിക്കുവാൻ എനിക്ക് ബുദ്ധി നല്കേണമേ.","poem":2}]},{"type":"verse","number":126,"content":[{"text":"യഹോവേ, ഇത് അങ്ങേക്കു പ്രവർത്തിക്കുവാനുള്ള സമയമാകുന്നു;","poem":1},{"text":"അവർ അങ്ങേയുടെ ന്യായപ്രമാണം ദുർബ്ബലമാക്കിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":127,"content":[{"text":"അതുകൊണ്ട് അങ്ങേയുടെ കല്പനകൾ","poem":1},{"text":"എനിക്ക് പൊന്നിലും തങ്കത്തിലും അധികം പ്രിയമാകുന്നു.","poem":2}]},{"type":"verse","number":128,"content":[{"text":"അതുകൊണ്ട് അങ്ങേയുടെ സകലപ്രമാണങ്ങളും സത്യമെന്ന് കരുതി,","poem":1},{"text":"ഞാൻ സകലവ്യാജമാർഗ്ഗങ്ങളും വെറുക്കുന്നു.","poem":2}]},{"type":"verse","number":129,"content":[{"text":"അങ്ങേയുടെ സാക്ഷ്യങ്ങൾ അതിശയകരമാകയാൽ","poem":1},{"text":"എന്‍റെ മനസ്സ് അവ പ്രമാണിക്കുന്നു.","poem":2}]},{"type":"verse","number":130,"content":[{"text":"അങ്ങേയുടെ വചനങ്ങളുടെ വികാശനം പ്രകാശം പ്രദാനം ചെയ്യുന്നു;","poem":1},{"text":"അത് അല്പബുദ്ധികളെ ബുദ്ധിമാന്മാരാക്കുന്നു.","poem":2}]},{"type":"verse","number":131,"content":[{"text":"അങ്ങേയുടെ കല്പനകൾക്കായി വാഞ്ഛിക്കുകയാൽ","poem":1},{"text":"ഞാൻ വായ് തുറന്ന് കിതയ്ക്കുന്നു.","poem":2}]},{"type":"verse","number":132,"content":[{"text":"തിരുനാമത്തെ സ്നേഹിക്കുന്നവർക്ക് അങ്ങ് ചെയ്യുന്നതുപോലെ","poem":1},{"text":"എങ്കലേക്ക് തിരിഞ്ഞ് എന്നോട് കൃപ ചെയ്യേണമേ.","poem":2}]},{"type":"verse","number":133,"content":[{"text":"എന്‍റെ കാലടികൾ അങ്ങേയുടെ വചനത്തിൽ സ്ഥിരമാക്കേണമേ;","poem":1},{"text":"യാതൊരു നീതികേടും എന്നെ ഭരിക്കരുതേ.","poem":2}]},{"type":"verse","number":134,"content":[{"text":"മനുഷ്യന്‍റെ പീഡനത്തിൽനിന്ന് എന്നെ വിടുവിക്കേണമേ;","poem":1},{"text":"എന്നാൽ ഞാൻ അങ്ങേയുടെ പ്രമാണങ്ങൾ അനുസരിക്കും.","poem":2}]},{"type":"verse","number":135,"content":[{"text":"അടിയന്‍റെമേൽ തിരുമുഖം പ്രകാശിപ്പിച്ച്","poem":1},{"text":"അങ്ങേയുടെ ചട്ടങ്ങൾ എനിക്ക് ഉപദേശിച്ചു തരേണമേ.","poem":2}]},{"type":"verse","number":136,"content":[{"text":"അവർ അങ്ങേയുടെ ന്യായപ്രമാണം അനുസരിക്കാത്തതിനാൽ","poem":1},{"text":"എന്‍റെ കണ്ണിൽ നിന്ന് ജലനദികൾ ഒഴുകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":137,"content":[{"text":"യഹോവേ, അങ്ങ് നീതിമാനാകുന്നു;","poem":1},{"text":"അങ്ങേയുടെ വിധികൾ നേരുള്ളവ തന്നെ.","poem":2}]},{"type":"verse","number":138,"content":[{"text":"അങ്ങ് നീതിയോടും അത്യന്തം വിശ്വസ്തതയോടും കൂടി","poem":1},{"text":"അങ്ങേയുടെ സാക്ഷ്യങ്ങളെ കല്പിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":139,"content":[{"text":"എന്‍റെ വൈരികൾ തിരുവചനങ്ങൾ മറക്കുന്നതുകൊണ്ട്","poem":1},{"text":"എന്‍റെ എരിവ് എന്നെ സംഹരിക്കുന്നു.","poem":2}]},{"type":"verse","number":140,"content":[{"text":"അങ്ങേയുടെ വചനം അത്യന്തം വിശുദ്ധമാകുന്നു;","poem":1},{"text":"അതുകൊണ്ട് അടിയന് അത് പ്രിയമാകുന്നു.","poem":2}]},{"type":"verse","number":141,"content":[{"text":"ഞാൻ എളിയവനും നിന്ദിതനും ആകുന്നു;","poem":1},{"text":"എങ്കിലും ഞാൻ അങ്ങേയുടെ പ്രമാണങ്ങൾ മറക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":142,"content":[{"text":"അങ്ങേയുടെ നീതി ശാശ്വതനീതിയും","poem":1},{"text":"അങ്ങേയുടെ ന്യായപ്രമാണം സത്യവുമാകുന്നു.","poem":2}]},{"type":"verse","number":143,"content":[{"text":"കഷ്ടവും സങ്കടവും എന്നെ പിടിച്ചിരിക്കുന്നു;","poem":1},{"text":"എങ്കിലും അങ്ങേയുടെ കല്പനകൾ എന്‍റെ പ്രമോദമാകുന്നു.","poem":2}]},{"type":"verse","number":144,"content":[{"text":"അങ്ങേയുടെ സാക്ഷ്യങ്ങൾ എന്നേക്കും നീതിയുള്ളവ;","poem":1},{"text":"ഞാൻ ജീവിച്ചിരിക്കേണ്ടതിന് എനിക്ക് ബുദ്ധി നല്കേണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":145,"content":[{"text":"ഞാൻ പൂർണ്ണഹൃദയത്തോടെ വിളിച്ചപേക്ഷിക്കുന്നു; എനിക്ക് ഉത്തരം അരുളേണമേ;","poem":1},{"text":"യഹോവേ, ഞാൻ അങ്ങേയുടെ ചട്ടങ്ങൾ പ്രമാണിക്കും.","poem":2}]},{"type":"verse","number":146,"content":[{"text":"ഞാൻ അങ്ങയെ വിളിച്ചപേക്ഷിക്കുന്നു; എന്നെ രക്ഷിക്കേണമേ;","poem":1},{"text":"ഞാൻ അങ്ങേയുടെ സാക്ഷ്യങ്ങളെ പ്രമാണിക്കും.","poem":2}]},{"type":"verse","number":147,"content":[{"text":"ഞാൻ ഉദയത്തിനു മുമ്പ് എഴുന്നേറ്റ് പ്രാർത്ഥിക്കുന്നു;","poem":1},{"text":"അങ്ങേയുടെ വചനത്തിൽ ഞാൻ പ്രത്യാശവക്കുന്നു.","poem":2}]},{"type":"verse","number":148,"content":[{"text":"തിരുവചനം ധ്യാനിക്കേണ്ടതിന്","poem":1},{"text":"എന്‍റെ കണ്ണ് യാമങ്ങളെ നോക്കിക്കൊണ്ടിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":149,"content":[{"text":"അങ്ങേയുടെ ദയയ്ക്കു തക്കവണ്ണം എന്‍റെ അപേക്ഷ കേൾക്കേണമേ;","poem":1},{"text":"യഹോവേ, അങ്ങേയുടെ ന്യായപ്രകാരം എന്നെ ജീവിപ്പിക്കേണമേ.","poem":2}]},{"type":"verse","number":150,"content":[{"text":"ദുഷ്ടതയെ പിന്തുടരുന്നവർ സമീപിച്ചിരിക്കുന്നു;","poem":1},{"text":"അങ്ങേയുടെ ന്യായപ്രമാണത്തോട് അവർ അകന്നിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":151,"content":[{"text":"യഹോവേ, അങ്ങ് സമീപസ്ഥനാകുന്നു;","poem":1},{"text":"അങ്ങേയുടെ കല്പനകൾ സകലവും സത്യം തന്നെ.","poem":2}]},{"type":"verse","number":152,"content":[{"text":"അങ്ങേയുടെ സാക്ഷ്യങ്ങൾ അങ്ങ് എന്നേക്കും സ്ഥാപിച്ചിരിക്കുന്നു","poem":1},{"text":"എന്നു ഞാൻ പണ്ടുതന്നെ അറിഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":153,"content":[{"text":"എന്‍റെ അരിഷ്ടത കടാക്ഷിച്ച് എന്നെ വിടുവിക്കേണമേ;","poem":1},{"text":"ഞാൻ അങ്ങേയുടെ ന്യായപ്രമാണം മറക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":154,"content":[{"text":"എന്‍റെ വ്യവഹാരം നടത്തി എന്നെ വീണ്ടെടുക്കേണമേ;","poem":1},{"text":"അങ്ങേയുടെ വാഗ്ദാനപ്രകാരം എന്നെ ജീവിപ്പിക്കേണമേ.","poem":2}]},{"type":"verse","number":155,"content":[{"text":"രക്ഷ ദുഷ്ടന്മാരോട് അകന്നിരിക്കുന്നു;","poem":1},{"text":"അവർ അങ്ങേയുടെ ചട്ടങ്ങളെ അന്വേഷിക്കുന്നില്ലല്ലോ.","poem":2}]},{"type":"verse","number":156,"content":[{"text":"യഹോവേ, അങ്ങേയുടെ കരുണ വലിയതാകുന്നു;","poem":1},{"text":"അങ്ങേയുടെ ന്യായപ്രകാരം എന്നെ ജീവിപ്പിക്കേണമേ.","poem":2}]},{"type":"verse","number":157,"content":[{"text":"എന്നെ ഉപദ്രവിക്കുന്നവരും എന്‍റെ വൈരികളും വളരെയാകുന്നു;","poem":1},{"text":"എങ്കിലും ഞാൻ അങ്ങേയുടെ സാക്ഷ്യങ്ങളെ വിട്ടുമാറുന്നില്ല.","poem":2}]},{"type":"verse","number":158,"content":[{"text":"ഞാൻ ദ്രോഹികളെ കണ്ടു വ്യസനിച്ചു;","poem":1},{"text":"അവർ അങ്ങേയുടെ വചനം പ്രമാണിക്കുന്നില്ലല്ലോ.","poem":2}]},{"type":"verse","number":159,"content":[{"text":"അങ്ങേയുടെ പ്രമാണങ്ങൾ എനിക്ക് എത്ര പ്രിയം എന്നു കണ്ടു,","poem":1},{"text":"യഹോവേ, അങ്ങേയുടെ ദയയ്ക്കു തക്കവണ്ണം എന്നെ ജീവിപ്പിക്കേണമേ.","poem":2}]},{"type":"verse","number":160,"content":[{"text":"അങ്ങേയുടെ വചനത്തിന്‍റെ സാരം സത്യം തന്നെ;","poem":1},{"text":"അങ്ങേയുടെ നീതിയുള്ള വിധികൾ എല്ലാം എന്നേക്കുമുള്ളവ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":161,"content":[{"text":"അധികാരികള്‍ വെറുതെ എന്നെ ഉപദ്രവിക്കുന്നു;","poem":1},{"text":"എങ്കിലും അങ്ങേയുടെ വചനത്തെ എന്‍റെ ഹൃദയം ഭയപ്പെടുന്നു.","poem":2}]},{"type":"verse","number":162,"content":[{"text":"വലിയ കൊള്ള കണ്ടെത്തിയവനെപ്പോലെ","poem":1},{"text":"ഞാൻ അങ്ങേയുടെ വചനത്തിൽ ആനന്ദിക്കുന്നു.","poem":2}]},{"type":"verse","number":163,"content":[{"text":"ഞാൻ ഭോഷ്ക് വെറുത്ത് അറയ്ക്കുന്നു;","poem":1},{"text":"എന്നാൽ അങ്ങേയുടെ ന്യായപ്രമാണം എനിക്ക് പ്രിയമാകുന്നു.","poem":2}]},{"type":"verse","number":164,"content":[{"text":"അങ്ങേയുടെ നീതിയുള്ള വിധികൾനിമിത്തം","poem":1},{"text":"ഞാൻ ദിവസം ഏഴു പ്രാവശ്യം അങ്ങയെ സ്തുതിക്കുന്നു.","poem":2}]},{"type":"verse","number":165,"content":[{"text":"അങ്ങേയുടെ ന്യായപ്രമാണത്തോട് പ്രിയം ഉള്ളവർക്ക് മഹാസമാധാനം ഉണ്ട്;","poem":1},{"text":"അവർ ഒന്നിനാലും ഇടറിപ്പോകുകയില്ല.","poem":2}]},{"type":"verse","number":166,"content":[{"text":"യഹോവേ, ഞാൻ അങ്ങേയുടെ രക്ഷയിൽ പ്രത്യാശ വയ്ക്കുന്നു;","poem":1},{"text":"അങ്ങേയുടെ കല്പനകൾ ഞാൻ ആചരിക്കുന്നു.","poem":2}]},{"type":"verse","number":167,"content":[{"text":"എന്‍റെ മനസ്സ് അങ്ങേയുടെ സാക്ഷ്യങ്ങൾ പ്രമാണിക്കുന്നു;","poem":1},{"text":"അവ എനിക്ക് അത്യന്തം പ്രിയമാകുന്നു.","poem":2}]},{"type":"verse","number":168,"content":[{"text":"ഞാൻ അങ്ങേയുടെ പ്രമാണങ്ങളും സാക്ഷ്യങ്ങളും പ്രമാണിക്കുന്നു;","poem":1},{"text":"എന്‍റെ വഴികളെല്ലാം അങ്ങേയുടെ മുമ്പാകെ ഇരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":169,"content":[{"text":"യഹോവേ, എന്‍റെ നിലവിളി തിരുസന്നിധിയിൽ വരുമാറാകട്ടെ;","poem":1},{"text":"അങ്ങേയുടെ വചനപ്രകാരം എനിക്ക് ബുദ്ധി നല്കേണമേ.","poem":2}]},{"type":"verse","number":170,"content":[{"text":"എന്‍റെ യാചന തിരുസന്നിധിയിൽ വരുമാറാകട്ടെ;","poem":1},{"text":"അങ്ങേയുടെ വാഗ്ദാനപ്രകാരം എന്നെ വിടുവിക്കേണമേ.","poem":2}]},{"type":"verse","number":171,"content":[{"text":"അങ്ങേയുടെ ചട്ടങ്ങൾ എനിക്ക് ഉപദേശിച്ചുതരുന്നതുകൊണ്ട്","poem":1},{"text":"എന്‍റെ അധരങ്ങൾ സ്തുതി പൊഴിക്കട്ടെ.","poem":2}]},{"type":"verse","number":172,"content":[{"text":"അങ്ങേയുടെ കല്പനകൾ എല്ലാം നീതിയായിരിക്കുകയാൽ","poem":1},{"text":"എന്‍റെ നാവ് അങ്ങേയുടെ വാഗ്ദാനത്തെക്കുറിച്ച് പാടട്ടെ.","poem":2}]},{"type":"verse","number":173,"content":[{"text":"അങ്ങേയുടെ കല്പനകളെ ഞാൻ തിരഞ്ഞെടുത്തിരിക്കുകയാൽ","poem":1},{"text":"അങ്ങേയുടെ കൈ എനിക്ക് തുണയായിരിക്കട്ടെ.","poem":2}]},{"type":"verse","number":174,"content":[{"text":"യഹോവേ, ഞാൻ അങ്ങേയുടെ രക്ഷക്കായി വാഞ്ഛിക്കുന്നു;","poem":1},{"text":"അങ്ങേയുടെ ന്യായപ്രമാണം എന്‍റെ പ്രമോദം ആകുന്നു.","poem":2}]},{"type":"verse","number":175,"content":[{"text":"അങ്ങയെ സ്തുതിക്കേണ്ടതിന് എന്‍റെ പ്രാണൻ ജീവിച്ചിരിക്കട്ടെ;","poem":1},{"text":"അങ്ങേയുടെ വിധികൾ എനിക്ക് തുണയായിരിക്കട്ടെ.","poem":2}]},{"type":"verse","number":176,"content":[{"text":"കാണാതെപോയ ആടുപോലെ ഞാൻ തെറ്റിപ്പോയിരിക്കുന്നു;","poem":1},{"text":"അടിയനെ അന്വേഷിക്കേണമേ; അങ്ങേയുടെ കല്പനകൾ ഞാൻ മറക്കുന്നില്ല.","poem":2}]}],"footnotes":[{"noteId":112,"caller":"+","text":"അത്ഭുത ഉപദേശങ്ങളെ ധ്യാനിക്കും അത്ഭുത കാര്യങ്ങളെ ധ്യാനിക്കും","reference":{"chapter":119,"verse":27}},{"noteId":113,"caller":"+","text":"അവരുടെ ഹൃദയത്തില്‍ സത്യം ഇല്ല അവരുടെ ഹൃദയം കൊഴുപ്പുപോലെ തടിച്ചിരിക്കുന്നു","reference":{"chapter":119,"verse":70}},{"noteId":114,"caller":"+","text":"സംരക്ഷിക്കേണമേ ജീവിപ്പിക്കേണമേ","reference":{"chapter":119,"verse":88}},{"noteId":115,"caller":"+","text":"അതിരുകള്‍ ഇല്ലാത്തതായിരിക്കുന്നു അത്യന്തം വിശാലമായിരിക്കുന്നു","reference":{"chapter":119,"verse":96}},{"noteId":116,"caller":"+","text":"എന്‍റെ ജീവന്‍ എപ്പോഴും അപകടത്തില്‍ ആയിരിക്കുന്നു എന്‍റെ ജീവന്‍ എന്‍റെ കയ്യില്‍ ആയിരിക്കുന്നു","reference":{"chapter":119,"verse":109}}]},"thisChapterLink":"/api/mal_irv/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":176}