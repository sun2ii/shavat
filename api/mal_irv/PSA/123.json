{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":123,"content":[{"type":"heading","content":["കരുണയ്ക്കായുള്ള പ്രാർത്ഥന"]},{"type":"hebrew_subtitle","content":["ആരോഹണഗീതം."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"സ്വർഗ്ഗത്തിൽ വസിക്കുന്നവനായ യഹോവേ,","poem":1},{"text":"അങ്ങയിലേക്ക് ഞാൻ എന്‍റെ കണ്ണുകൾ ഉയർത്തുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ദാസന്മാരുടെ കണ്ണുകൾ യജമാനന്‍റെ കൈയിലേക്കും","poem":1},{"text":"ദാസിയുടെ കണ്ണുകൾ യജമാനത്തിയുടെ കൈയിലേക്കും എന്നപോലെ","poem":2},{"text":"ഞങ്ങളുടെ കണ്ണുകൾ ഞങ്ങളുടെ ദൈവമായ യഹോവയിങ്കലേക്ക്,","poem":1},{"text":"അവിടുന്ന് ഞങ്ങളോട് കൃപചെയ്യുവോളം നോക്കിക്കൊണ്ടിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"യഹോവേ, ഞങ്ങളോടു കൃപ ചെയ്യേണമേ, ഞങ്ങളോടു കൃപ ചെയ്യേണമേ;","poem":1},{"text":"ഞങ്ങൾ നിന്ദ സഹിച്ചു മടുത്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"സുഖിമാൻന്മാരുടെ പരിഹാസവും","poem":1},{"text":"അഹങ്കാരികളുടെ നിന്ദയും സഹിച്ച്","poem":2},{"lineBreak":true},{"text":"ഞങ്ങളുടെ മനസ് ഏറ്റവും മടുത്തിരിക്കുന്നു.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}