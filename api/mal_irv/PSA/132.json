{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"heading","content":["ദൈവത്തിന്‍റെ നിത്യ വാസസ്ഥലം"]},{"type":"hebrew_subtitle","content":["ആരോഹണഗീതം."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"യഹോവേ, ദാവീദിനെയും","poem":1},{"text":"അവന്‍റെ സകലകഷ്ടതയെയും ഓർക്കേണമേ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവൻ യഹോവയോടു സത്യംചെയ്ത്","poem":1},{"text":"യാക്കോബിന്‍റെ വല്ലഭന് നേർന്നത് എന്തെന്നാൽ:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“യഹോവയ്ക്ക് ഒരു സ്ഥലം,","poem":1},{"text":"യാക്കോബിന്‍റെ സര്‍വ്വശക്തനായ ദൈവത്തിനു ഒരു നിവാസം കണ്ടെത്തുംവരെ","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ഞാൻ എന്‍റെ കൂടാര വീട്ടിൽ കടക്കുകയില്ല;","poem":1},{"text":"എന്‍റെ ശയ്യമേൽ കയറി കിടക്കുകയുമില്ല.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ഞാൻ എന്‍റെ കണ്ണിന് ഉറക്കവും","poem":1},{"text":"എന്‍റെ കൺപോളയ്ക്ക് മയക്കവും കൊടുക്കുകയില്ല.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"നാം എഫ്രാത്തയിൽ അതിനെക്കുറിച്ച് കേട്ടു","poem":1},{"text":"വനപ്രദേശത്ത് അത് കണ്ടെത്തിയല്ലോ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"നാം ദൈവത്തിന്‍റെ തിരുനിവാസത്തിലേക്കു ചെന്നു","poem":1},{"text":"അവിടുത്തെ പാദപീഠത്തിൽ നമസ്കരിക്കുക.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"യഹോവേ, അങ്ങേയുടെ ബലത്തിന്‍റെ പെട്ടകവുമായി","poem":1},{"text":"അങ്ങേയുടെ വിശ്രാമത്തിലേക്ക് എഴുന്നള്ളേണമേ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അങ്ങേയുടെ പുരോഹിതന്മാർ നീതി ധരിക്കുകയും","poem":1},{"text":"അങ്ങേയുടെ ഭക്തന്മാർ ഘോഷിച്ചുല്ലസിക്കുകയും ചെയ്യട്ടെ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അങ്ങേയുടെ ദാസനായ ദാവീദിനെ ഓർത്തു","poem":1},{"text":"അങ്ങേയുടെ അഭിഷിക്തന്‍റെ മുഖത്തെ തിരസ്ക്കരിക്കരുതേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ഞാൻ നിന്‍റെ ഉദരഫലത്തെ","poem":1},{"text":"നിന്‍റെ സിംഹാസനത്തിൽ ഇരുത്തും;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"നിന്‍റെ മക്കൾ എന്‍റെ നിയമവും","poem":1},{"text":"ഞാൻ അവർക്ക് ഉപദേശിച്ച സാക്ഷ്യവും പ്രമാണിക്കുമെങ്കിൽ","poem":2},{"text":"അവരുടെ മക്കളും എന്നേക്കും നിന്‍റെ സിംഹാസനത്തിൽ ഇരിക്കും” എന്നു","poem":1},{"text":"യഹോവ ദാവീദിനോട് ആണയിട്ട് സത്യം; കർത്താവ് അതിൽനിന്ന് മാറുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"യഹോവ സീയോനെ തിരഞ്ഞെടുക്കുകയും","poem":1},{"text":"അതിനെ തന്‍റെ വാസസ്ഥലമായി ഇച്ഛിക്കുകയും ചെയ്തു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“അത് എന്നേക്കും എന്‍റെ വിശ്രാമം ആകുന്നു;","poem":1},{"text":"ഞാൻ അതിനെ ഇച്ഛിച്ചിരിക്കുകയാൽ ഞാൻ അവിടെ വസിക്കും;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അതിലെ ആഹാരം ഞാൻ സമൃദ്ധിയായി അനുഗ്രഹിക്കും;","poem":1},{"text":"അതിലെ ദരിദ്രന്മാർക്ക് അപ്പംകൊണ്ട് തൃപ്തി വരുത്തും.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അതിലെ പുരോഹിതന്മാരെ രക്ഷ ധരിപ്പിക്കും;","poem":1},{"text":"അതിലെ ഭക്തന്മാർ ഘോഷിച്ചുല്ലസിക്കും.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവിടെ ഞാൻ ദാവീദിന് ഒരു കൊമ്പ് മുളപ്പിക്കും;","poem":1},{"text":"എന്‍റെ അഭിഷിക്തന് ഒരു ദീപം ഒരുക്കിയിട്ടുമുണ്ട്.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ഞാൻ അവന്‍റെ ശത്രുക്കളെ ലജ്ജ ധരിപ്പിക്കും;","poem":1},{"text":"അവന്‍റെ തലയിലോ കിരീടം ശോഭിക്കും.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}