{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":139,"content":[{"type":"heading","content":["എല്ലാം അറിയുന്ന ദൈവം"]},{"type":"hebrew_subtitle","content":["സംഗീതപ്രമാണിക്ക്; ദാവീദിന്‍റെ ഒരു സങ്കീർത്തനം."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"യഹോവേ, അങ്ങ് എന്നെ പരിശോധന ചെയ്തു അറിഞ്ഞിരിക്കുന്നു;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ഞാൻ ഇരിക്കുന്നതും എഴുന്നേല്ക്കുന്നതും അവിടുന്ന് അറിയുന്നു.","poem":1},{"text":"എന്‍റെ ചിന്തകൾ അങ്ങ് ദൂരത്തുനിന്ന് ഗ്രഹിക്കുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"എന്‍റെ നടപ്പും കിടപ്പും അങ്ങ് പരിശോധിക്കുന്നു;","poem":1},{"text":"എന്‍റെ വഴികളെല്ലാം അങ്ങേക്കു മനസ്സിലായിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"യഹോവേ, അങ്ങ് മുഴുവനും അറിയാതെ","poem":1},{"text":"ഒരു വാക്കും എന്‍റെ നാവിൽ ഇല്ല.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അങ്ങ് എന്‍റെ മുമ്പും പിമ്പും അടച്ച്","poem":1},{"text":"അങ്ങേയുടെ കൈ എന്‍റെ മേൽ വച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഈ പരിജ്ഞാനം എനിക്ക് അത്യത്ഭുതമാകുന്നു;","poem":1},{"text":"അത് എനിക്ക് ഗ്രഹിച്ചുകൂടാത്തവിധം ഉന്നതമായിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"അങ്ങേയുടെ ആത്മാവിനെ ഒളിച്ച് ഞാൻ എവിടെ പോകും?","poem":1},{"text":"തിരുസന്നിധിവിട്ട് ഞാൻ എവിടേക്ക് ഓടും?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ഞാൻ സ്വർഗ്ഗത്തിൽ കയറിയാൽ അങ്ങ് അവിടെ ഉണ്ട്;","poem":1},{"text":"പാതാളത്തിൽ എന്‍റെ കിടക്ക വിരിച്ചാൽ അങ്ങ് അവിടെ ഉണ്ട്.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഞാൻ ഉഷസ്സിന്‍റെ ചിറകു ധരിച്ച്,","poem":1},{"text":"സമുദ്രത്തിന്‍റെ അറ്റത്തു ചെന്നു വസിച്ചാൽ","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവിടെയും അങ്ങേയുടെ കൈ എന്നെ നടത്തും;","poem":1},{"text":"അങ്ങേയുടെ വലങ്കൈ എന്നെ പിടിക്കും.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“ഇരുട്ട് എന്നെ മൂടിക്കളയട്ടെ;","poem":1},{"text":"വെളിച്ചം എന്‍റെ ചുറ്റും രാത്രിയായിത്തീരട്ടെ” എന്നു ഞാൻ പറഞ്ഞാൽ","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ഇരുട്ടിൽപോലും അങ്ങേക്ക് ഒന്നും മറഞ്ഞിരിക്കുകയില്ല;","poem":1},{"text":"രാത്രി പകൽപോലെ പ്രകാശിക്കും;","poem":2},{"lineBreak":true},{"text":"ഇരുട്ടും വെളിച്ചവും നിനക്കു തുല്യം തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"അങ്ങല്ലയോ എന്‍റെ ആന്തരിക അവയവങ്ങൾ നിർമ്മിച്ചത്;","poem":1},{"text":"എന്‍റെ അമ്മയുടെ ഉദരത്തിൽ അങ്ങ് എന്നെ മെനഞ്ഞു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ഭയങ്കരവും അത്ഭുതകരവുമായി എന്നെ സൃഷ്ടിച്ചിരിക്കുകയാൽ","poem":1},{"text":"ഞാൻ അങ്ങേക്കു സ്തോത്രം ചെയ്യുന്നു;","poem":2},{"text":"അങ്ങേയുടെ പ്രവൃത്തികൾ അത്ഭുതകരമാകുന്നു;","poem":1},{"text":"അത് എന്‍റെ ഉള്ളം നല്ലവണ്ണം അറിയുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ഞാൻ രഹസ്യത്തിൽ നിർമ്മിക്കപ്പെടുകയും","poem":1},{"text":"ഭൂമിയുടെ അധോഭാഗങ്ങളിൽ സൃഷ്ടിക്കപ്പെടുകയും ചെയ്തപ്പോൾ","poem":2},{"lineBreak":true},{"text":"എന്‍റെ അസ്ഥികൂടം അങ്ങേക്ക് മറഞ്ഞിരുന്നില്ല.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ഞാൻ പിണ്ഡാകാരമായിരുന്നപ്പോൾ അങ്ങേയുടെ കണ്ണ് എന്നെ കണ്ടു;","poem":1},{"text":"എനിക്കുവേണ്ടി നിയമിക്കപ്പെട്ട നാളുകൾ ഒന്നും ഇല്ലാതിരുന്നപ്പോൾ","poem":2},{"lineBreak":true},{"text":"അവയെല്ലാം അങ്ങേയുടെ പുസ്തകത്തിൽ എഴുതിയിരുന്നു;","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ദൈവമേ, എന്നെക്കുറിച്ചുള്ള അങ്ങേയുടെ വിചാരങ്ങൾ എത്ര ഘനമായവ!","poem":1},{"text":"അവയുടെ ആകെത്തുകയും എത്ര വലിയത്!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അവ എണ്ണിയാൽ മണലിനെക്കാൾ അധികം;","poem":1},{"text":"ഞാൻ ഉണരുമ്പോൾ ഇനിയും ഞാൻ അങ്ങേയുടെ അടുക്കൽ ഇരിക്കുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ദൈവമേ, അങ്ങ് ദുഷ്ടനെ നിഗ്രഹിച്ചെങ്കിൽ കൊള്ളാമായിരുന്നു;","poem":1},{"text":"ക്രൂരജനമേ","poem":2},{"noteId":130},{"text":", എന്നെവിട്ടു പോകുവിൻ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അവർ ദ്രോഹമായി അങ്ങയെക്കുറിച്ചു സംസാരിക്കുന്നു;","poem":1},{"lineBreak":true},{"text":"അങ്ങേയുടെ ശത്രുക്കൾ അങ്ങേയുടെ നാമം വൃഥാ എടുക്കുന്നു.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"യഹോവേ, അങ്ങയെ വെറുക്കുന്നവരെ ഞാൻ വെറുക്കേണ്ടതല്ലയോ?","poem":1},{"text":"അങ്ങേയോട് എതിർത്തുനില്ക്കുന്നവരെ ഞാൻ എതിർക്കേണ്ടതല്ലയോ?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ഞാൻ പൂർണ്ണദ്വേഷത്തോടെ അവരെ ദ്വേഷിക്കുന്നു;","poem":1},{"text":"അവരെ എന്‍റെ ശത്രുക്കളായി എണ്ണുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ദൈവമേ, എന്നെ പരിശോധന ചെയ്തു എന്‍റെ ഹൃദയത്തെ അറിയേണമേ;","poem":1},{"lineBreak":true},{"text":"എന്നെ പരീക്ഷിച്ച് എന്‍റെ വിചാരങ്ങൾ അറിയേണമേ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"വ്യസനത്തിനുള്ള വഴികൾ എന്നിൽ ഉണ്ടോ എന്നു നോക്കി,","poem":1},{"text":"ശാശ്വതമാർഗ്ഗത്തിൽ എന്നെ നടത്തേണമേ.","poem":2}]}],"footnotes":[{"noteId":130,"caller":"+","text":"ക്രൂരജനമേ രക്തപാതകന്മാരേ","reference":{"chapter":139,"verse":19}}]},"thisChapterLink":"/api/mal_irv/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}