{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":145,"content":[{"type":"heading","content":["ഒരു സ്തോത്രഗാനം"]},{"type":"hebrew_subtitle","content":["ദാവീദിന്‍റെ ഒരു സങ്കീർത്തനം."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"എന്‍റെ ദൈവമായ രാജാവേ, ഞാൻ അങ്ങയെ പുകഴ്ത്തും;","poem":1},{"text":"ഞാൻ അങ്ങേയുടെ നാമത്തെ എന്നെന്നേക്കും വാഴ്ത്തും.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ദിനംതോറും ഞാൻ അങ്ങയെ വാഴ്ത്തും;","poem":1},{"text":"ഞാൻ അങ്ങേയുടെ നാമത്തെ എന്നെന്നേക്കും സ്തുതിക്കും.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"യഹോവ വലിയവനും അത്യന്തം സ്തുത്യനും ആകുന്നു;","poem":1},{"text":"അവിടുത്തെ മഹിമ അഗോചരമത്രേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ഒരു തലമുറ മറ്റൊരു തലമുറയോട് അങ്ങേയുടെ ക്രിയകളെ പുകഴ്ത്തി","poem":1},{"text":"അങ്ങേയുടെ വീര്യപ്രവൃത്തികളെ പ്രസ്താവിക്കും.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അങ്ങേയുടെ പ്രതാപത്തിന്‍റെ തേജസ്സുള്ള മഹത്വത്തെയും","poem":1},{"text":"അങ്ങേയുടെ അത്ഭുതകാര്യങ്ങളെയും പറ്റി അവര്‍ പറയും","poem":2},{"noteId":135},{"text":".","poem":2}]},{"type":"verse","number":6,"content":[{"text":"മനുഷ്യർ അങ്ങേയുടെ മഹാപ്രവൃത്തികളുടെ ശക്തിയെപ്പറ്റി പ്രസ്താവിക്കും;","poem":1},{"text":"ഞാൻ അങ്ങേയുടെ മഹിമയെ കുറിച്ച് ധ്യാനിക്കും","poem":2},{"noteId":136},{"text":".","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവർ അങ്ങേയുടെ വലിയ നന്മയുടെ ഓർമ്മ പ്രസിദ്ധമാക്കും;","poem":1},{"text":"അങ്ങേയുടെ നീതിയെക്കുറിച്ച് ഘോഷിച്ചുല്ലസിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"യഹോവ കൃപയും കരുണയും","poem":1},{"text":"ദീർഘക്ഷമയും മഹാദയയും ഉള്ളവൻ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"യഹോവ എല്ലാവർക്കും നല്ലവൻ;","poem":1},{"text":"തന്‍റെ സകലപ്രവൃത്തികളോടും കർത്താവിന് കരുണ തോന്നുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"യഹോവേ, അങ്ങേയുടെ സകലപ്രവൃത്തികളും അങ്ങേക്കു സ്തോത്രം ചെയ്യും;","poem":1},{"text":"അങ്ങേയുടെ ഭക്തന്മാർ അങ്ങയെ വാഴ്ത്തും.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"മനുഷ്യപുത്രന്മാരോട് അവിടുത്തെ വീര്യപ്രവൃത്തികളും","poem":1},{"text":"അങ്ങേയുടെ രാജത്വത്തിന്‍റെ തേജസ്സുള്ള പ്രതാപവും പ്രസ്താവിക്കേണ്ടതിന്","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവർ അങ്ങേയുടെ രാജ്യത്തിന്‍റെ മഹത്വം പ്രസിദ്ധമാക്കി","poem":1},{"text":"അങ്ങേയുടെ ശക്തിയെക്കുറിച്ച് സംസാരിക്കും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അങ്ങേയുടെ രാജത്വം നിത്യരാജത്വം ആകുന്നു;","poem":1},{"text":"അങ്ങേയുടെ ആധിപത്യം തലമുറതലമുറയായി ഇരിക്കുന്നു","poem":2},{"noteId":137},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"വീഴുന്നവരെ എല്ലാം യഹോവ താങ്ങുന്നു;","poem":1},{"text":"കുനിഞ്ഞിരിക്കുന്നവരെ എന്‍റെ അടുക്കൽ അവിടുന്ന് നിവിർത്തുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"എല്ലാവരുടെയും കണ്ണുകൾ അങ്ങയെ നോക്കി കാത്തിരിക്കുന്നു;","poem":1},{"text":"അങ്ങ് തത്സമയത്ത് അവർക്ക് ഭക്ഷണം കൊടുക്കുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അങ്ങ് തൃക്കൈ തുറന്ന്","poem":1},{"text":"ജീവനുള്ളതിനെല്ലാം അങ്ങേയുടെ പ്രസാദം കൊണ്ടു തൃപ്തിവരുത്തുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"യഹോവ തന്‍റെ സകല വഴികളിലും നീതിമാനും","poem":1},{"text":"തന്‍റെ സകലപ്രവൃത്തികളിലും ദയാലുവും ആകുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"യഹോവ, തന്നെ വിളിച്ചപേക്ഷിക്കുന്ന ഏവർക്കും,","poem":1},{"text":"സത്യമായി തന്നെ വിളിച്ചപേക്ഷിക്കുന്ന ഏവർക്കും, സമീപസ്ഥനാകുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"തന്‍റെ ഭക്തന്മാരുടെ ആഗ്രഹം അവിടുന്ന് സാധിപ്പിക്കും;","poem":1},{"text":"അവരുടെ നിലവിളികേട്ട് അവരെ രക്ഷിക്കും.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"യഹോവ തന്നെ സ്നേഹിക്കുന്ന ഏവരെയും പരിപാലിക്കുന്നു;","poem":1},{"text":"എന്നാൽ സകലദുഷ്ടന്മാരെയും അവിടുന്ന് നശിപ്പിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"എന്‍റെ വായ് യഹോവയുടെ സ്തുതി പ്രസ്താവിക്കും;","poem":1},{"text":"സകലജഡവും കർത്താവിന്‍റെ വിശുദ്ധനാമത്തെ എന്നെന്നേക്കും വാഴ്ത്തട്ടെ.","poem":2}]}],"footnotes":[{"noteId":135,"caller":"+","text":"അവര്‍ പറയും ഞാന്‍ പറയും","reference":{"chapter":145,"verse":5}},{"noteId":136,"caller":"+","text":"ഞാൻ അങ്ങേയുടെ മഹിമയെ കുറിച്ച് ധ്യാനിക്കും ഞാൻ അങ്ങേയുടെ മഹിമ വർണ്ണിക്കും","reference":{"chapter":145,"verse":6}},{"noteId":137,"caller":"+","text":"അങ്ങേയുടെ രാജത്വം നിത്യരാജത്വം ആകുന്നു; അങ്ങേയുടെ ആധിപത്യം തലമുറതലമുറയായി ഇരിക്കുന്നു യഹോവ തന്‍റെ എല്ലാ വാഗ്ദത്തങ്ങളോടും പ്രവര്‍ത്തികളോടും വിശ്വസ്തനാകുന്നു","reference":{"chapter":145,"verse":13}}]},"thisChapterLink":"/api/mal_irv/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}