{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":147,"content":[{"type":"heading","content":["സർവ്വശക്തനായ ദൈവം"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"യഹോവയെ സ്തുതിക്കുവിൻ;","poem":1},{"lineBreak":true},{"text":"നമ്മുടെ ദൈവത്തിന് കീർത്തനം പാടുന്നത് നല്ലത്;","poem":1},{"text":"അത് മനോഹരവും സ്തുതി ഉചിതവും തന്നെ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"യഹോവ യെരൂശലേമിനെ പണിയുന്നു;","poem":1},{"text":"കർത്താവ് യിസ്രായേലിന്‍റെ ഭ്രഷ്ടന്മാരെ കൂട്ടിച്ചേർക്കുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"മനം തകർന്നവരെ കർത്താവ് സൗഖ്യമാക്കുകയും","poem":1},{"text":"അവരുടെ മുറിവുകൾ കെട്ടുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ദൈവം നക്ഷത്രങ്ങളുടെ എണ്ണം നോക്കുന്നു;","poem":1},{"text":"അവയ്ക്ക് എല്ലാം പേര്‍ വിളിക്കുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"നമ്മുടെ കർത്താവ് വലിയവനും ശക്തിയേറിയവനും ആകുന്നു;","poem":1},{"text":"അവിടുത്തെ വിവേകത്തിന് അന്തമില്ല.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"യഹോവ താഴ്മയുള്ളവനെ ഉയർത്തുന്നു;","poem":1},{"text":"അവിടുന്ന് ദുഷ്ടന്മാരെ നിലത്ത് തള്ളിയിടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"സ്തോത്രത്തോടെ യഹോവയ്ക്കു പാടുവിൻ;","poem":1},{"text":"കിന്നരത്തോടെ നമ്മുടെ ദൈവത്തിന് കീർത്തനം ചെയ്യുവിൻ;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"കർത്താവ് ആകാശത്തെ മേഘംകൊണ്ടു മൂടുന്നു;","poem":1},{"text":"ഭൂമിക്കായി മഴ ഒരുക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"ദൈവം പർവ്വതങ്ങളിൽ പുല്ല് മുളപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ദൈവം മൃഗങ്ങൾക്കും കരയുന്ന കാക്കക്കുഞ്ഞുങ്ങൾക്കും","poem":1},{"text":"അതതിന്‍റെ ആഹാരം കൊടുക്കുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അശ്വബലത്തിൽ കർത്താവിന് സന്തോഷമില്ല;","poem":1},{"text":"പുരുഷന്‍റെ ശക്തിയിൽ പ്രസാദിക്കുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"തന്നെ ഭയപ്പെടുകയും തന്‍റെ ദയയിൽ പ്രത്യാശ വയ്ക്കുകയും","poem":1},{"text":"ചെയ്യുന്നവരിൽ യഹോവ പ്രസാദിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"യെരൂശലേമേ, യഹോവയെ പുകഴ്ത്തുക;","poem":1},{"text":"സീയോനേ, നിന്‍റെ ദൈവത്തെ വാഴ്ത്തുക;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ദൈവം നിന്‍റെ വാതിലുകളുടെ ഓടാമ്പലുകൾ ഉറപ്പിച്ച്","poem":1},{"text":"നിന്‍റെ അകത്ത് നിന്‍റെ മക്കളെ അനുഗ്രഹിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"കർത്താവ് നിന്‍റെ ദേശത്ത് സമാധാനം വരുത്തുന്നു;","poem":1},{"text":"വിശേഷമായ ഗോതമ്പുകൊണ്ട് നിനക്കു തൃപ്തിവരുത്തുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ദൈവം തന്‍റെ ആജ്ഞ ഭൂമിയിലേക്ക് അയയ്ക്കുന്നു;","poem":1},{"text":"അവിടുത്തെ വചനം അതിവേഗം ഓടുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ദൈവം പഞ്ഞിപോലെ മഞ്ഞു പെയ്യിക്കുന്നു;","poem":1},{"text":"ചാരംപോലെ ഹിമകണങ്ങൾ വിതറുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവിടുന്ന് മഞ്ഞുകട്ടകൾ ചരൽ പോലെ എറിയുന്നു;","poem":1},{"text":"അതിന്‍റെ കുളിര് സഹിച്ചു നില്‍ക്കുന്നവനാര്?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ദൈവം തന്‍റെ വാക്കിനാൽ അവ ഉരുക്കുന്നു;","poem":1},{"text":"കാറ്റ് അടിപ്പിച്ച് അതിൽനിന്ന് വെള്ളം ഒഴുക്കുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ദൈവം യാക്കോബിന് തന്‍റെ വചനവും","poem":1},{"text":"യിസ്രായേലിനു തന്‍റെ ചട്ടങ്ങളും വിധികളും വെളിപ്പെടുത്തുന്നു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അങ്ങനെ യാതൊരു ജനതക്കും അവിടുന്ന് ചെയ്തിട്ടില്ല;","poem":1},{"text":"കർത്താവിന്‍റെ വിധികൾ അവർ അറിഞ്ഞിട്ടുമില്ല.","poem":2},{"lineBreak":true},{"text":"യഹോവയെ സ്തുതിക്കുവിൻ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}