{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"heading","content":["യഹോവയ്ക്ക് ഒരു പുതിയ പാട്ട് പാടുവിൻ"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"യഹോവയെ സ്തുതിക്കുവിൻ;","poem":1},{"lineBreak":true},{"text":"യഹോവയ്ക്ക് ഒരു പുതിയ പാട്ടും","poem":1},{"text":"ഭക്തന്മാരുടെ സഭയിൽ കർത്താവിന്‍റെ സ്തുതിയും പാടുവിൻ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"യിസ്രായേൽ അവരെ ഉണ്ടാക്കിയ ദൈവത്തിൽ സന്തോഷിക്കട്ടെ;","poem":1},{"text":"സീയോൻ്റെ മക്കൾ അവരുടെ രാജാവിൽ ആനന്ദിക്കട്ടെ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവർ നൃത്തം ചെയ്തുകൊണ്ട് കർത്താവിന്‍റെ നാമത്തെ സ്തുതിക്കട്ടെ;","poem":1},{"text":"തപ്പിനോടും കിന്നരത്തോടുംകൂടി അവിടുത്തേക്ക് കീർത്തനം ചെയ്യട്ടെ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"യഹോവ തന്‍റെ ജനത്തിൽ പ്രസാദിക്കുന്നു;","poem":1},{"text":"താഴ്മയുള്ളവരെ ദൈവം രക്ഷകൊണ്ട് അലങ്കരിക്കും.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ഭക്തന്മാർ ജയത്തിൽ","poem":1},{"noteId":139},{"text":"ആനന്ദിക്കട്ടെ;","poem":1},{"text":"അവർ അവരുടെ ശയ്യകളിൽ ഘോഷിച്ചുല്ലസിക്കട്ടെ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവരുടെ വായിൽ ദൈവത്തിന്‍റെ പുകഴ്ചകളും","poem":1},{"text":"അവരുടെ കയ്യിൽ ഇരുവായ്ത്തലയുള്ള വാളും ഉണ്ടായിരിക്കട്ടെ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ജനതകൾക്കു പ്രതികാരവും","poem":1},{"text":"വംശങ്ങൾക്കു ശിക്ഷയും നടത്തേണ്ടതിനും","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവരുടെ രാജാക്കന്മാരെ ചങ്ങലകളാലും","poem":1},{"text":"അവരുടെ പ്രഭുക്കന്മാരെ ഇരിമ്പുവിലങ്ങുകളാലും ബന്ധിക്കേണ്ടതിനും","poem":2}]},{"type":"verse","number":9,"content":[{"text":"എഴുതിയിരിക്കുന്ന വിധി അവരുടെ മേൽ നടത്തേണ്ടതിനും തന്നെ.","poem":1},{"text":"അത് കർത്താവിന്‍റെ സർവ്വഭക്തന്മാർക്കും ബഹുമാനം ആകുന്നു.","poem":2},{"lineBreak":true},{"text":"യഹോവയെ സ്തുതിക്കുവിൻ.","poem":1}]}],"footnotes":[{"noteId":139,"caller":"+","text":"ജയത്തിൽ മഹത്വത്തിൽ","reference":{"chapter":149,"verse":5}}]},"thisChapterLink":"/api/mal_irv/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}