{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":18,"content":[{"type":"heading","content":["യഹോവ എന്‍റെ പാറയും എന്‍റെ കോട്ടയും ആകുന്നു"]},{"type":"hebrew_subtitle","content":["യഹോവ ദാവീദിനെ സകലശത്രുക്കളുടെ കയ്യിൽനിന്നും ശൗലിന്‍റെ കൈയിൽനിന്നും വിടുവിച്ച കാലത്ത് ദാവീദ് ഈ സംഗീതവാക്യങ്ങൾ യഹോവയ്ക്കു പാടി."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"എന്‍റെ ബലമായ യഹോവേ, ഞാൻ അങ്ങയെ സ്നേഹിക്കുന്നു.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"യഹോവ എന്‍റെ ശൈലവും കോട്ടയും എന്‍റെ രക്ഷകനും","poem":1},{"text":"ദൈവവും ഞാൻ ശരണമാക്കുന്ന പാറയും","poem":2},{"lineBreak":true},{"text":"എന്‍റെ പരിചയും എന്‍റെ രക്ഷയുടെ കൊമ്പും ഗോപുരവും ആകുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"സ്തുത്യനായ യഹോവയെ ഞാൻ വിളിച്ചപേക്ഷിക്കുകയും","poem":1},{"text":"എന്‍റെ ശത്രുക്കളുടെ കയ്യിൽനിന്ന് രക്ഷപ്രാപിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"മരണപാശങ്ങൾ എന്നെ ചുറ്റി;","poem":1},{"text":"അഗാധപ്രവാഹങ്ങൾ എന്നെ ഭ്രമിപ്പിച്ചു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"പാതാളപാശങ്ങൾ","poem":1},{"noteId":9},{"text":"എന്നെ വളഞ്ഞു;","poem":1},{"text":"മരണത്തിന്‍റെ കെണികളും എന്നെ പിൻതുടർന്നു പിടിച്ചു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"എന്‍റെ കഷ്ടതയിൽ ഞാൻ യഹോവയെ വിളിച്ചപേക്ഷിച്ചു,","poem":1},{"text":"എന്‍റെ ദൈവത്തോട് നിലവിളിച്ചു;","poem":2},{"text":"അവിടുന്ന് തന്‍റെ മന്ദിരത്തിൽ ഇരുന്ന് എന്‍റെ അപേക്ഷ കേട്ടു;","poem":1},{"text":"എന്‍റെ നിലവിളിയും തിരുമുമ്പിൽ ഞാൻ കഴിച്ച പ്രാർത്ഥനയും അവിടുത്തെ ചെവിയിൽ എത്തി.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ഭൂമി ഞെട്ടിവിറച്ചു; മലകളുടെ അടിസ്ഥാനങ്ങൾ ഇളകി;","poem":1},{"text":"ദൈവം കോപിക്കുകയാൽ അവ കുലുങ്ങിപ്പോയി.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവിടുത്തെ മൂക്കിൽനിന്ന് പുകപൊങ്ങി;","poem":1},{"text":"അവിടുത്തെ വായിൽനിന്ന് തീ പുറപ്പെട്ടു ദഹിപ്പിച്ചു;","poem":2},{"lineBreak":true},{"text":"തീക്കനൽ ദൈവത്തിൽനിന്ന് ജ്വലിച്ചു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവിടുന്ന് ആകാശം ചായിച്ചിറങ്ങി;","poem":1},{"text":"കൂരിരുൾ അവിടുത്തെ കാല്ക്കീഴിലുണ്ടായിരുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ദൈവം കെരൂബിനെ","poem":1},{"noteId":10},{"text":"വാഹനമാക്കി പറന്നു;","poem":1},{"text":"കർത്താവ് കാറ്റിന്‍റെ ചിറകിന്മേൽ ഇരുന്നു സഞ്ചരിച്ചു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ദൈവം അന്ധകാരത്തെ തന്‍റെ മറവും","poem":1},{"text":"ജലതമസ്സിനെയും മഴമേഘങ്ങളെയും തനിക്കു ചുറ്റും കൂടാരവുമാക്കി.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ദൈവം തന്‍റെ മുമ്പിലുള്ള പ്രകാശത്താൽ","poem":1},{"text":"ആലിപ്പഴവും തീക്കനലും മേഘങ്ങളിൽനിന്ന് പൊഴിയിച്ചു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"യഹോവ ആകാശത്തിൽ ഇടി മുഴക്കി,","poem":1},{"text":"അത്യുന്നതനായ ദൈവം തന്‍റെ നാദം കേൾപ്പിച്ചു,","poem":2},{"lineBreak":true},{"text":"ആലിപ്പഴവും തീക്കനലും","poem":2},{"noteId":11},{"text":"പൊഴിഞ്ഞു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ദൈവം അസ്ത്രം എയ്ത് ശത്രുവിനെ ചിതറിച്ചു;","poem":1},{"text":"മിന്നൽ അയച്ച് അവരെ തോല്പിച്ചു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"യഹോവേ, അവിടുത്തെ ശാസനയാലും","poem":1},{"text":"അങ്ങേയുടെ മൂക്കിലെ ശ്വാസത്തിന്‍റെ പ്രവാഹത്തിന്‍റെ ശക്തിയാലും","poem":2},{"text":"സമുദ്രപാതകൾ തെളിഞ്ഞുവന്നു;","poem":1},{"text":"ഭൂമിയുടെ അടിസ്ഥാനങ്ങൾ വെളിപ്പെട്ടു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"കർത്താവ് ഉയരത്തിൽനിന്ന് കൈ നീട്ടി എന്നെ പിടിച്ചു,","poem":1},{"text":"പെരുവെള്ളത്തിൽ നിന്ന് എന്നെ വലിച്ചെടുത്തു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"എന്‍റെ ബലമുള്ള ശത്രുവിന്‍റെ കൈയിൽനിന്നും","poem":1},{"text":"എന്നെ വെറുത്തവരുടെ പക്കൽനിന്നും കർത്താവ് എന്നെ വിടുവിച്ചു;","poem":2},{"lineBreak":true},{"text":"അവർ എന്നിലും ബലവാന്മാരായിരുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"എന്‍റെ അനർത്ഥദിവസത്തിൽ അവർ എന്നെ ആക്രമിച്ചു;","poem":1},{"text":"എന്നാൽ യഹോവ എനിക്ക് തുണയായിരുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"കർത്താവ് എന്നെ ഒരു വിശാലസ്ഥലത്തേക്ക് കൊണ്ടുവന്നു;","poem":1},{"text":"എന്നിൽ പ്രമോദിച്ചിരുന്നതുകൊണ്ട് എന്നെ വിടുവിച്ചു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"യഹോവ എന്‍റെ നീതിക്കു തക്കവിധം എനിക്ക് പ്രതിഫലം നല്കി;","poem":1},{"text":"എന്‍റെ കൈകളുടെ വെടിപ്പിനൊത്തവിധം എനിക്ക് പകരം തന്നു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ഞാൻ യഹോവയുടെ വഴികളിൽ നടന്നു;","poem":1},{"text":"എന്‍റെ ദൈവത്തോട് ദ്രോഹം ചെയ്തതുമില്ല.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ദൈവത്തിന്‍റെ വിധികൾ ഒക്കെയും എന്‍റെ മുമ്പിൽ ഉണ്ട്;","poem":1},{"text":"ദൈവത്തിന്‍റെ ചട്ടങ്ങൾ വിട്ട് ഞാൻ നടന്നിട്ടുമില്ല.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ഞാൻ ദൈവത്തിന്‍റെ മുമ്പാകെ നിഷ്കളങ്കനായിരുന്നു;","poem":1},{"text":"അകൃത്യം ചെയ്യാതെ എന്നെത്തന്നെ കാത്തു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"യഹോവ എന്‍റെ നീതിക്കു തക്കവണ്ണവും","poem":1},{"text":"ദൈവത്തിന്‍റെ ദൃഷ്ടിയിൽ എന്‍റെ കൈകളുടെ","poem":2},{"lineBreak":true},{"text":"വെടിപ്പിൻപ്രകാരവും എനിക്ക് പകരം നല്കി.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ദയാലുവോടു അവിടുന്ന് ദയാലു ആകുന്നു;","poem":1},{"text":"നിഷ്കളങ്കനോടു അവിടുന്ന് നിഷ്കളങ്കൻ;","poem":2}]},{"type":"verse","number":26,"content":[{"text":"നിർമ്മലനോടു അവിടുന്ന് നിർമ്മലനാകുന്നു;","poem":1},{"text":"വക്രനോടു അവിടുന്ന് വക്രത കാണിക്കുന്നു.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"എളിയജനത്തെ അവിടുന്ന് രക്ഷിക്കും;","poem":1},{"text":"നിഗളിച്ചു നടക്കുന്നവരെ അവിടുന്ന് താഴ്ത്തും.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"അവിടുന്ന് എന്‍റെ ദീപം കത്തിക്കും;","poem":1},{"text":"എന്‍റെ ദൈവമായ യഹോവ എന്‍റെ അന്ധകാരത്തെ പ്രകാശമാക്കും.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"അവിടുത്തെ സഹായത്താൽ ഞാൻ പടക്കൂട്ടത്തിന്‍റെ നേരെ പാഞ്ഞുചെല്ലും;","poem":1},{"text":"എന്‍റെ ദൈവത്താൽ ഞാൻ മതിൽ ചാടിക്കടക്കും","poem":2},{"noteId":12},{"text":".","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ദൈവത്തിന്‍റെ വഴി തികവുള്ളത്;","poem":1},{"text":"യഹോവയുടെ വചനം നിർമ്മലമായത്;","poem":2},{"lineBreak":true},{"text":"തന്നെ ശരണമാക്കുന്ന ഏവർക്കും അവൻ പരിചയാകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"യഹോവയല്ലാതെ ദൈവം ആരുണ്ട്?","poem":1},{"text":"നമ്മുടെ ദൈവം ഒഴികെ പാറ ആരുണ്ട്?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"എന്നെ ശക്തികൊണ്ട് അരമുറുക്കുകയും","poem":1},{"text":"എന്‍റെ വഴി സുരക്ഷിതമാക്കുകയും ചെയ്യുന്ന ദൈവം തന്നെ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"കർത്താവ് എന്‍റെ കാലുകളെ പേടമാന്‍റെ കാലുകൾക്ക് തുല്യമാക്കി,","poem":1},{"text":"ഉന്നതങ്ങളിൽ എന്നെ നിർത്തുന്നു.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"എന്‍റെ കൈകളെ അവിടുന്ന് യുദ്ധം അഭ്യസിപ്പിക്കുന്നു;","poem":1},{"text":"എന്‍റെ ഭുജങ്ങൾ താമ്രചാപം കുലക്കുന്നു.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"അവിടുത്തെ രക്ഷ എന്ന പരിച അവിടുന്ന് എനിക്ക് തന്നിരിക്കുന്നു;","poem":1},{"text":"അങ്ങേയുടെ വലങ്കൈ എന്നെ താങ്ങി","poem":2},{"lineBreak":true},{"text":"അങ്ങേയുടെ സൗമ്യത എന്നെ വലിയവനാക്കിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ഞാൻ കാലടി വെക്കേണ്ടതിന് ദൈവം എന്‍റെ വഴികൾക്ക് വിശാലത വരുത്തി;","poem":1},{"text":"എന്‍റെ നരിയാണികൾ വഴുതിപ്പോയതുമില്ല.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"ഞാൻ എന്‍റെ ശത്രുക്കളെ പിന്തുടർന്ന് പിടിച്ചു;","poem":1},{"text":"അവരെ നശിപ്പിക്കുവോളം ഞാൻ പിന്തിരിഞ്ഞില്ല.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"അവർ എഴുന്നേല്ക്കാത്തവണ്ണം ഞാൻ അവരെ തകർത്തു;","poem":1},{"text":"അവർ എന്‍റെ കാല്ക്കീഴിൽ വീണിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"യുദ്ധത്തിനായി അവിടുന്ന് എന്‍റെ അരയ്ക്ക് ശക്തി കെട്ടിയിരിക്കുന്നു;","poem":1},{"text":"എന്നോട് എതിർത്തവരെ എനിക്ക് കീഴടക്കിത്തന്നിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"എന്നെ വെറുക്കുന്നവരെ ഞാൻ സംഹരിക്കേണ്ടതിന്","poem":1},{"text":"അവിടുന്ന് എന്‍റെ ശത്രുക്കളെ പിന്തിരിഞ്ഞ് ഓടുമാറാക്കി.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"അവർ നിലവിളിച്ചു; രക്ഷിക്കുവാൻ ആരും ഉണ്ടായിരുന്നില്ല;","poem":1},{"text":"യഹോവയോട് നിലവിളിച്ചു; അവിടുന്ന് ഉത്തരം അരുളിയതുമില്ല.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"ഞാൻ അവരെ കാറ്റിൽ പറക്കുന്ന പൊടിപോലെ പൊടിച്ചു;","poem":1},{"text":"വീഥികളിലെ ചെളിപോലെ ഞാൻ അവരെ എറിഞ്ഞുകളഞ്ഞു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"ജനത്തിന്‍റെ കലഹങ്ങളിൽനിന്ന് അവിടുന്ന് എന്നെ വിടുവിച്ചു;","poem":1},{"text":"ജനതതികൾക്ക് എന്നെ തലവനാക്കിയിരിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"ഞാൻ അറിയാത്ത ജനം എന്നെ സേവിക്കുന്നു.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"അവർ എന്നെക്കുറിച്ച് കേൾക്കുമ്പോൾ തന്നെ അനുസരിക്കും;","poem":1},{"text":"അന്യജനതകൾ എന്നോട് വിധേയത്വം കാണിക്കും.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"അന്യജനതകൾ ക്ഷയിച്ചുപോകുന്നു;","poem":1},{"text":"അവരുടെ ഒളിയിടങ്ങളിൽനിന്ന് അവർ വിറച്ചുകൊണ്ട് വരുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"യഹോവ ജീവിക്കുന്നു; എന്‍റെ പാറ വാഴ്ത്തപ്പെട്ടവൻ;","poem":1},{"text":"എന്‍റെ രക്ഷയുടെ ദൈവം ഉന്നതൻ തന്നെ.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"ദൈവം എനിക്ക് വേണ്ടി പ്രതികാരം ചെയ്യുകയും","poem":1},{"text":"ജനതകളെ എനിക്ക് കീഴടക്കിത്തരുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"എന്‍റെ കർത്താവ് ശത്രുവിന്‍റെ കയ്യിൽനിന്ന് എന്നെ വിടുവിക്കുന്നു;","poem":1},{"text":"എന്നോട് എതിർക്കുന്നവർക്കുമേൽ എന്നെ ഉയർത്തുന്നു;","poem":2},{"lineBreak":true},{"text":"സാഹസക്കാരന്‍റെ കയ്യിൽനിന്ന് എന്നെ വിടുവിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"അതുകൊണ്ട് യഹോവേ, ഞാൻ ജനതകളുടെ മദ്ധ്യത്തിൽ അങ്ങേക്കു സ്തോത്രം ചെയ്യും;","poem":1},{"text":"അവിടുത്തെ നാമത്തെ ഞാൻ കീർത്തിക്കും.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"ദൈവം തന്‍റെ രാജാവിന് മഹാരക്ഷ നല്കുന്നു;","poem":1},{"text":"തന്‍റെ അഭിഷിക്തനോട് ദയ കാണിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"ദാവീദിനും അവന്‍റെ സന്തതിക്കും എന്നെന്നേക്കും തന്നെ.","poem":2}]}],"footnotes":[{"noteId":9,"caller":"+","text":"പാതാളപാശങ്ങൾ മരിച്ചവരുടെ ലോകം","reference":{"chapter":18,"verse":5}},{"noteId":10,"caller":"+","text":"കെരൂബിനെ പഴയ നിയമത്തില്‍ കെരൂബ് എന്നാല്‍ ചിറകുകളുള്ളതും യഹോവയുടെ സ്വര്‍ഗീയ സിംഹാസനം കാക്കുന്ന ജീവിയാണ്.","reference":{"chapter":18,"verse":10}},{"noteId":11,"caller":"+","text":"ആലിപ്പഴവും തീക്കനലും ചില കൈയ്യെഴുത്തുപ്രതികളില്‍ ഈ ഭാഗം കാണുന്നില്ല","reference":{"chapter":18,"verse":13}},{"noteId":12,"caller":"+","text":"മതിൽ ചാടിക്കടക്കും ചവിട്ടി മെതിക്കും","reference":{"chapter":18,"verse":29}}]},"thisChapterLink":"/api/mal_irv/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":50}