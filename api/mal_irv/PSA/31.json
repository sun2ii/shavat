{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":31,"content":[{"type":"heading","content":["ശത്രുക്കളിൽ നിന്നുള്ള വിടുതലിനായുള്ള പ്രാർത്ഥനയും സ്തുതിയും"]},{"type":"hebrew_subtitle","content":["സംഗീതപ്രമാണിക്ക്; ദാവീദിന്‍റെ ഒരു സങ്കീർത്തനം."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"യഹോവേ, ഞാൻ അങ്ങയെ ശരണം പ്രാപിക്കുന്നു;","poem":1},{"text":"ഞാൻ ഒരുനാളും ലജ്ജിച്ചുപോകരുതേ;","poem":2},{"lineBreak":true},{"text":"അങ്ങേയുടെ നീതിനിമിത്തം എന്നെ വിടുവിക്കേണമേ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവിടുത്തെ ചെവി എന്നിലേക്ക് ചായിച്ച് എന്നെ വേഗം വിടുവിക്കേണമേ.","poem":1},{"text":"അവിടുന്ന്എനിക്കു ഉറപ്പുള്ള പാറയായും എന്നെ രക്ഷിക്കുന്ന കോട്ടയായും ഇരിക്കേണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"അവിടുന്ന് എന്‍റെ പാറയും എന്‍റെ കോട്ടയുമല്ലോ;","poem":1},{"text":"അങ്ങേയുടെ നാമംനിമിത്തം എന്നെ നടത്തി പരിപാലിക്കേണമേ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അവർ എനിക്കായി ഒളിച്ചുവച്ചിരിക്കുന്ന വലയിൽനിന്ന് എന്നെ വിടുവിക്കേണമേ;","poem":1},{"text":"അവിടുന്ന് എന്‍റെ അഭയസ്ഥാനമാകുന്നുവല്ലോ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"അങ്ങേയുടെ കയ്യിൽ ഞാൻ എന്‍റെ ആത്മാവിനെ ഭരമേല്പിക്കുന്നു;","poem":1},{"text":"വിശ്വസ്തദൈവമായ യഹോവേ, അവിടുന്ന് എന്നെ വീണ്ടെടുത്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"മിഥ്യാമൂർത്തികളെ സേവിക്കുന്നവരെ ഞാൻ പകക്കുന്നു;","poem":1},{"text":"ഞാനോ യഹോവയിൽ ആശ്രയിക്കുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ഞാൻ അങ്ങേയുടെ ദയയിൽ ആനന്ദിച്ച് സന്തോഷിക്കുന്നു;","poem":1},{"text":"അവിടുന്ന് എന്‍റെ അരിഷ്ടത കണ്ടു എന്‍റെ പ്രാണസങ്കടങ്ങൾ അറിഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ശത്രുവിന്‍റെ കയ്യിൽ അവിടുന്ന് എന്നെ ഏല്പിച്ചിട്ടില്ല;","poem":1},{"text":"എന്‍റെ കാലുകൾ അങ്ങ് വിശാലസ്ഥലത്ത് നിർത്തിയിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"യഹോവേ, എന്നോട് കൃപയുണ്ടാകേണമേ; ഞാൻ കഷ്ടത്തിലായിരിക്കുന്നു;","poem":1},{"text":"വ്യസനംകൊണ്ട് എന്‍റെ കണ്ണും പ്രാണനും ശരീരവും ക്ഷയിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"എന്‍റെ ആയുസ്സ് ദുഃഖത്തിലും എന്‍റെ സംവത്സരങ്ങൾ നെടുവീർപ്പിലും കഴിഞ്ഞുപോയിരിക്കുന്നു;","poem":1},{"text":"എന്‍റെ ക്ലേശം","poem":2},{"noteId":22},{"text":"നിമിത്തം എന്‍റെ ബലം നഷ്ടപ്പെട്ടും എന്‍റെ അസ്ഥികൾ ക്ഷയിച്ചും ഇരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"എന്‍റെ സകലവൈരികളാലും ഞാൻ നിന്ദിതനായിത്തീർന്നു;","poem":1},{"text":"എന്‍റെ അയല്‍ക്കാർക്ക് അതിനിന്ദിതൻ തന്നെ;","poem":2},{"text":"എന്‍റെ മുഖപരിചയക്കാർക്ക് ഞാൻ ഭയഹേതുവാകുന്നു.","poem":1},{"text":"എന്നെ വെളിയിൽ കാണുന്നവർ എന്നെ വിട്ട് ഓടിപ്പോകുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"മരിച്ചുപോയവനെപ്പോലെ എന്നെ മറന്നുകളഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"ഞാൻ ഒരു ഉടഞ്ഞ പാത്രംപോലെ ആയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“ചുറ്റും ഭീതി” എന്ന അപശ്രുതി ഞാൻ പലരുടെയും വായിൽനിന്ന് കേട്ടിരിക്കുന്നു;","poem":1},{"text":"അവർ എനിക്ക് വിരോധമായി കൂടി ആലോചന കഴിക്കുന്നു,","poem":2},{"lineBreak":true},{"text":"എന്‍റെ ജീവൻ എടുത്തുകളയുവാൻ നിരൂപിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"എങ്കിലും യഹോവേ, ഞാൻ അങ്ങയിൽ ആശ്രയിച്ചു;","poem":1},{"text":"“അവിടുന്ന് എന്‍റെ ദൈവം” എന്നു ഞാൻ പറഞ്ഞു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"എന്‍റെ ജീവകാലം അങ്ങേയുടെ കയ്യിൽ ഇരിക്കുന്നു;","poem":1},{"text":"എന്‍റെ ശത്രുക്കളുടെയും എന്നെ പീഡിപ്പിക്കുന്നവരുടെയും കൈയിൽനിന്ന് എന്നെ വിടുവിക്കേണമേ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അടിയന്‍റെമേൽ തിരുമുഖം പ്രകാശിപ്പിക്കേണമേ;","poem":1},{"text":"അങ്ങേയുടെ ദയയാൽ എന്നെ രക്ഷിക്കേണമേ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"യഹോവേ, അങ്ങയെ വിളിച്ചപേക്ഷിച്ചിരിക്കുകയാൽ ഞാൻ ലജ്ജിച്ചുപോകരുതേ;","poem":1},{"text":"ദുഷ്ടന്മാർ ലജ്ജിച്ച് പാതാളത്തിൽ മൗനമായിരിക്കട്ടെ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"നീതിമാന് വിരോധമായി ഡംഭത്തോടും നിന്ദയോടും കൂടി","poem":1},{"text":"ധാർഷ്ട്യം സംസാരിക്കുന്ന വ്യാജമുള്ള അധരങ്ങൾ നിശ്ശബ്ദമായി പോകട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"അങ്ങേയുടെ ഭക്തന്മാർക്കു വേണ്ടി അവിടുന്ന് സംഗ്രഹിച്ചതും","poem":1},{"text":"അവിടുത്തെ ആശ്രയിക്കുന്നവർക്കു വേണ്ടി മനുഷ്യപുത്രന്മാർ കാൺകെ","poem":2},{"lineBreak":true},{"text":"അവിടുന്ന് പ്രവർത്തിച്ചതുമായ അങ്ങേയുടെ നന്മ എത്ര വലിയതാകുന്നു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അവിടുന്ന് അവരെ മനുഷ്യരുടെ ഗൂഢാലോചനയിൽ നിന്ന് വിടുവിച്ച്","poem":1},{"text":"അങ്ങേയുടെ സാന്നിദ്ധ്യത്തിന്‍റെ സുരക്ഷിതത്വത്തിൽ മറയ്ക്കും.","poem":2},{"text":"അവിടുന്ന് അവരെ നാവുകളുടെ വക്കാണത്തിൽ നിന്നു രക്ഷിച്ച്","poem":1},{"text":"ഒരു കൂടാരത്തിനകത്ത് ഒളിപ്പിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"യഹോവ വാഴ്ത്തപ്പെട്ടവൻ; അവൻ ഉറപ്പുള്ള പട്ടണത്തിൽ","poem":1},{"text":"തന്‍റെ ദയ എനിക്ക് അത്ഭുതകരമായി കാണിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“ഞാൻ അങ്ങേയുടെ ദൃഷ്ടിയിൽനിന്ന് ഛേദിക്കപ്പെട്ടുപോയി” എന്നു ഞാൻ എന്‍റെ പരിഭ്രമത്തിൽ പറഞ്ഞു;","poem":1},{"text":"എങ്കിലും ഞാൻ അങ്ങയെ വിളിച്ചപേക്ഷിച്ചപ്പോൾ എന്‍റെ യാചനയുടെ ശബ്ദം അവിടുന്ന് കേട്ടു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"യഹോവയുടെ സകലവിശുദ്ധന്മാരുമായുള്ളോരേ, കർത്താവിനെ സ്നേഹിക്കുവിൻ;","poem":1},{"text":"യഹോവ വിശ്വസ്തന്മാരെ കാക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"അഹങ്കാരം പ്രവർത്തിക്കുന്നവന് ധാരാളം പകരം കൊടുക്കുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"യഹോവയിൽ പ്രത്യാശയുള്ള ഏവരുമേ, ധൈര്യപ്പെട്ടിരിക്കുവിൻ;","poem":1},{"text":"നിങ്ങളുടെ ഹൃദയം ഉറച്ചിരിക്കട്ടെ.","poem":2}]}],"footnotes":[{"noteId":22,"caller":"+","text":"എന്‍റെ ക്ലേശം എന്‍റെ അകൃത്യം","reference":{"chapter":31,"verse":10}}]},"thisChapterLink":"/api/mal_irv/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}