{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":33,"content":[{"type":"heading","content":["ദൈവത്തിന്‍റെ മഹത്വവും നന്മയും"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"നീതിമാന്മാരേ, യഹോവയിൽ ഘോഷിച്ചുല്ലസിക്കുവിൻ;","poem":1},{"text":"സ്തുതിക്കുന്നത് നേരുള്ളവർക്ക് ഉചിതമല്ലയോ?.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"കിന്നരം കൊണ്ടു യഹോവയ്ക്ക് സ്തോത്രം ചെയ്യുവിൻ;","poem":1},{"text":"പത്തു കമ്പിയുള്ള വീണകൊണ്ട് കർത്താവിന് സ്തുതിപാടുവിൻ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"കർത്താവിന് പുതിയ പാട്ടുപാടുവിൻ;","poem":1},{"text":"ഘോഷസ്വരത്തോടെ നന്നായി വാദ്യം വായിക്കുവിൻ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"യഹോവയുടെ വചനം നേരുള്ളത്;","poem":1},{"text":"കർത്താവിന്‍റെ സകലപ്രവൃത്തികളും വിശ്വസ്തതയുള്ളത്.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"കർത്താവ് നീതിയും ന്യായവും ഇഷ്ടപ്പെടുന്നു;","poem":1},{"text":"യഹോവയുടെ ദയകൊണ്ട് ഭൂമി നിറഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"യഹോവയുടെ വചനത്താൽ ആകാശവും","poem":1},{"text":"അവിടുത്തെ വായിലെ ശ്വാസത്താൽ അതിലെ സകലസൈന്യവും ഉളവായി;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"കർത്താവ് സമുദ്രത്തിലെ വെള്ളം കൂമ്പാരമായി കൂട്ടുന്നു;","poem":1},{"text":"അവിടുന്ന് ആഴികളെ ഭണ്ഡാരഗൃഹങ്ങളിൽ സംഗ്രഹിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"സകലഭൂവാസികളും യഹോവയെ ഭയപ്പെടട്ടെ;","poem":1},{"text":"ഭൂതലത്തിൽ വസിക്കുന്നവരെല്ലാം അവിടുത്തെ ശങ്കിക്കട്ടെ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"കർത്താവ് അരുളിച്ചെയ്തു; ലോകം സൃഷ്ടിക്കപ്പെട്ടു;","poem":1},{"text":"അവിടുന്ന് കല്പിച്ചു; എല്ലാം പ്രത്യക്ഷമായി.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"യഹോവ ജനതകളുടെ ആലോചന വ്യർത്ഥമാക്കുന്നു;","poem":1},{"text":"വംശങ്ങളുടെ പദ്ധതികൾ നിഷ്ഫലമാക്കുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"യഹോവയുടെ ആലോചന ശാശ്വതമായും","poem":1},{"text":"അവിടുത്തെ ഹൃദയവിചാരങ്ങൾ തലമുറതലമുറയായും നിലകൊള്ളുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"യഹോവ ദൈവമായിരിക്കുന്ന ജനങ്ങളും","poem":1},{"text":"അവിടുന്ന് തനിക്കു അവകാശമായി തിരഞ്ഞെടുത്ത സമൂഹവും ഭാഗ്യമുള്ളത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"യഹോവ സ്വർഗ്ഗത്തിൽനിന്ന് നോക്കുന്നു;","poem":1},{"text":"മനുഷ്യപുത്രന്മാരെ എല്ലാം കാണുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവൻ സിംഹാസനസ്ഥനായിരിക്കുന്ന സ്ഥലത്തുനിന്ന്","poem":1},{"text":"സർവ്വഭൂവാസികളെയും നോക്കുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"കർത്താവ് അവരുടെ ഹൃദയങ്ങളെ ഒരുപോലെ മനഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"അവരുടെ പ്രവൃത്തികൾ സകലവും അവിടുന്ന് ഗ്രഹിക്കുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"സൈന്യബഹുത്വത്താൽ രാജാവ് ജയം പ്രാപിക്കുന്നില്ല;","poem":1},{"text":"ബലാധിക്യം കൊണ്ടു വീരൻ രക്ഷപെടുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ജയത്തിന് കുതിര വ്യർത്ഥമാകുന്നു;","poem":1},{"text":"തന്‍റെ ബലാധിക്യം കൊണ്ടു അത് വിടുവിക്കുന്നതുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"യഹോവയുടെ ദൃഷ്ടി തന്‍റെ ഭക്തന്മാരുടെമേലും","poem":1},{"text":"തന്‍റെ ദയയ്ക്കായി പ്രത്യാശിക്കുന്നവരുടെമേലും ഇരിക്കുന്നു;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അവരുടെ പ്രാണനെ മരണത്തിൽനിന്ന് വിടുവിക്കുവാനും","poem":1},{"text":"ക്ഷാമത്തിൽ അവരെ ജീവനോടെ രക്ഷിക്കുവാനും തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"നമ്മുടെ ഉള്ളം യഹോവയ്ക്കായി കാത്തിരിക്കുന്നു;","poem":1},{"text":"അവിടുന്ന് നമ്മുടെ സഹായവും പരിചയും ആകുന്നു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"കർത്താവിന്‍റെ വിശുദ്ധനാമത്തിൽ നാം ആശ്രയിക്കുകയാൽ","poem":1},{"text":"നമ്മുടെ ഹൃദയം അങ്ങയിൽ സന്തോഷിക്കും.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"യഹോവേ, ഞങ്ങൾ അങ്ങയിൽ പ്രത്യാശവക്കുന്നതുപോലെ","poem":1},{"text":"അങ്ങേയുടെ ദയ ഞങ്ങളുടെമേൽ ഉണ്ടാകുമാറാകട്ടെ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}