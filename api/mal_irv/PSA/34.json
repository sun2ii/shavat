{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":34,"content":[{"type":"heading","content":["നീതിമാന്മാരുടെ രക്ഷകനായ ദൈവം"]},{"type":"hebrew_subtitle","content":["ദാവീദ് അബീമേലെക്കിന്‍റെ മുൻപിൽ വച്ചു ബുദ്ധിഭ്രമം നടിക്കുകയും അവിടെനിന്ന് അവനെ പുറത്താക്കുകയും ചെയ്തപ്പോൾ പാടിയ ഒരു സങ്കീർത്തനം."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"ഞാൻ യഹോവയെ എല്ലാകാലത്തും വാഴ്ത്തും;","poem":1},{"text":"അവിടുത്തെ സ്തുതി എപ്പോഴും എന്‍റെ അധരങ്ങളിൽ ഉണ്ടായിരിക്കും.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"എന്‍റെ ഹൃദയം യഹോവയിൽ പ്രശംസിക്കുന്നു;","poem":1},{"text":"താഴ്മയുള്ളവർ അത് കേട്ടു സന്തോഷിക്കും.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"എന്നോടൊപ്പം യഹോവയുടെ മഹത്വത്തെ ഘോഷിക്കുവിൻ;","poem":1},{"text":"നാം ഒന്നിച്ച് അവിടുത്തെ നാമത്തെ സ്തുതിക്കുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ഞാൻ യഹോവയോട് അപേക്ഷിച്ചു; അവിടുന്ന് എനിക്ക് ഉത്തരമരുളി;","poem":1},{"text":"എന്‍റെ സകല ഭയങ്ങളിൽനിന്നും എന്നെ വിടുവിച്ചു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവങ്കലേക്കു നോക്കിയവർ പ്രകാശിതരായി;","poem":1},{"text":"അവരുടെ മുഖം ലജ്ജിച്ചുപോയതുമില്ല.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഈ എളിയവൻ നിലവിളിച്ചു; യഹോവ കേട്ടു;","poem":1},{"text":"അവന്‍റെ സകലകഷ്ടങ്ങളിൽനിന്നും അവനെ രക്ഷിച്ചു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"യഹോവയുടെ ദൂതൻ അവിടുത്തെ ഭക്തന്മാരുടെ ചുറ്റും","poem":1},{"text":"പാളയമിറങ്ങി അവരെ വിടുവിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"യഹോവ നല്ലവൻ എന്നു രുചിച്ചറിയുവിൻ;","poem":1},{"text":"അവിടുത്തെ ശരണം പ്രാപിക്കുന്ന പുരുഷൻ ഭാഗ്യവാൻ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"യഹോവയുടെ വിശുദ്ധന്മാരേ, അവിടുത്തെ ഭയപ്പെടുവിൻ;","poem":1},{"text":"ദൈവഭക്തന്മാർക്ക് ഒരു കുറവും ഇല്ലല്ലോ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ബാലസിംഹങ്ങൾ പോലും ഇരകിട്ടാതെ വിശന്നിരിക്കാം;","poem":1},{"text":"യഹോവയെ അന്വേഷിക്കുന്നവർക്കോ ഒരു നന്മയ്ക്കും കുറവുണ്ടാകുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"മക്കളേ, വന്ന് എനിക്ക് ചെവിതരുവിൻ;","poem":1},{"text":"യഹോവാഭക്തി ഞാൻ നിങ്ങൾക്ക് ഉപദേശിച്ചുതരാം.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ജീവനെ ആഗ്രഹിക്കുകയും","poem":1},{"text":"ദീർഘായുസ്സോടെയിരുന്ന് നന്മ കാണുവാൻ ഇച്ഛിക്കുകയും ചെയ്യുന്നവൻ ആര്‍?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ദോഷം ചെയ്യാതെ നിന്‍റെ നാവിനെയും","poem":1},{"text":"വ്യാജം പറയാതെ നിന്‍റെ അധരത്തെയും കാത്തുകൊള്ളുക;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ദോഷം വിട്ടകന്ന് നന്മചെയ്യുക;","poem":1},{"text":"സമാധാനം അന്വേഷിച്ച് അതിനെ പിന്തുടരുക.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"യഹോവയുടെ കണ്ണ് നീതിമാന്മാരുടെമേലും","poem":1},{"text":"അവിടുത്തെ ചെവി അവരുടെ നിലവിളിക്കും തുറന്നിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ദുഷ്പ്രവൃത്തിക്കാരുടെ ഓർമ്മയെ ഭൂമിയിൽനിന്ന് മായിച്ചു കളയേണ്ടതിന്","poem":1},{"text":"യഹോവയുടെ മുഖം അവർക്ക് പ്രതികൂലമായിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"നീതിമാന്മാർ നിലവിളിച്ചു; യഹോവ കേട്ടു,","poem":1},{"text":"സകലകഷ്ടങ്ങളിൽനിന്നും അവരെ വിടുവിച്ചു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ഹൃദയം നുറുങ്ങിയവർക്ക് യഹോവ സമീപസ്ഥൻ;","poem":1},{"text":"മനസ്സു തകർന്നവരെ അവിടുന്ന് രക്ഷിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"നീതിമാന്‍റെ അനർത്ഥങ്ങൾ അസംഖ്യമാകുന്നു;","poem":1},{"text":"അവയിൽ നിന്നെല്ലാം യഹോവ അവനെ വിടുവിക്കുന്നു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അവന്‍റെ അസ്ഥികൾ എല്ലാം അവിടുന്ന് സൂക്ഷിക്കുന്നു;","poem":1},{"text":"അവയിൽ ഒന്നും ഒടിഞ്ഞുപോകുകയില്ല.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"തിന്മ ദുഷ്ടനെ കൊല്ലുന്നു;","poem":1},{"text":"നീതിമാനെ വെറുക്കുന്നവർ ശിക്ഷ അനുഭവിക്കും.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"യഹോവ തന്‍റെ ദാസന്മാരുടെ പ്രാണനെ രക്ഷിക്കുന്നു;","poem":1},{"text":"ദൈവത്തെ ശരണമാക്കുന്നവർ ആരും ശിക്ഷ അനുഭവിക്കുകയില്ല.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}