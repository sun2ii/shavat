{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":35,"content":[{"type":"heading","content":["ശത്രുക്കളിൽ നിന്നുള്ള വിടുതലിനായുള്ള പ്രാർത്ഥന"]},{"type":"hebrew_subtitle","content":["ദാവീദിന്‍റെ ഒരു സങ്കീർത്തനം."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"യഹോവേ, എന്നോട് മത്സരിക്കുന്നവരോട് വാദിക്കേണമേ;","poem":1},{"text":"എന്നോട് പൊരുതുന്നവരോട് പൊരുതേണമേ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"കവചവും പരിചയും ധരിച്ച്","poem":1},{"text":"എന്‍റെ സഹായത്തിനായി എഴുന്നേല്‍ക്കേണമേ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"കുന്തം ഊരി എന്നെ പിന്തുടരുന്നവരുടെ വഴി അടച്ചുകളയേണമേ;","poem":1},{"text":"“ഞാൻ നിന്‍റെ രക്ഷയാകുന്നു” എന്നു എന്‍റെ പ്രാണനോടു പറയേണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"എനിക്ക് ജീവഹാനി വരുത്തുവാൻ നോക്കുന്നവർക്കു ലജ്ജയും അപമാനവും വരട്ടെ;","poem":1},{"text":"എനിക്ക് അനർത്ഥം ചിന്തിക്കുന്നവർ പിന്തിരിഞ്ഞ് ലജ്ജിച്ചുപോകട്ടെ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവർ കാറ്റത്തെ പതിരുപോലെ ആകട്ടെ;","poem":1},{"text":"യഹോവയുടെ ദൂതൻ അവരെ ഓടിക്കട്ടെ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവരുടെ വഴി ഇരുട്ടും വഴുവഴുപ്പും ഉള്ളതാകട്ടെ;","poem":1},{"text":"യഹോവയുടെ ദൂതൻ അവരെ പിന്തുടരട്ടെ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"കാരണംകൂടാതെ അവർ എനിക്കായി വല ഒളിച്ചുവച്ചു;","poem":1},{"text":"കാരണംകൂടാതെ അവർ എന്‍റെ പ്രാണനായി കുഴി കുഴിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവൻ വിചാരിക്കാത്ത സമയത്ത് അവന് അപായം ഭവിക്കട്ടെ;","poem":1},{"text":"അവൻ ഒളിച്ചുവച്ച വലയിൽ അവൻ തന്നെ കുടുങ്ങട്ടെ;","poem":2},{"lineBreak":true},{"text":"അവൻ അപായത്തിൽ അകപ്പെട്ടുപോകട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"എന്‍റെ ഉള്ളം യഹോവയിൽ ആനന്ദിച്ച്,","poem":1},{"text":"അവിടുത്തെ രക്ഷയിൽ സന്തോഷിക്കും;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“യഹോവേ, അങ്ങേക്കു തുല്യൻ ആര്‍?","poem":1},{"text":"എളിയവനെ തന്നിലും ബലമേറിയവന്‍റെ കൈയിൽനിന്നും","poem":2},{"text":"എളിയവനും ദരിദ്രനുമായവനെ കവർച്ചക്കാരന്‍റെ കൈയിൽനിന്നും","poem":1},{"text":"അവിടുന്ന് രക്ഷിക്കുന്നു” എന്നു എന്‍റെ അസ്ഥികൾ എല്ലാം പറയും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"കള്ളസാക്ഷികൾ എഴുന്നേറ്റ്","poem":1},{"text":"ഞാൻ അറിയാത്ത കാര്യം എന്നോട് ചോദിക്കുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അവർ എനിക്ക് നന്മയ്ക്കു പകരം തിന്മചെയ്ത്,","poem":1},{"text":"എന്‍റെ പ്രാണന് അനാഥത്വം വരുത്തുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ഞാനോ, അവർ ദീനമായി കിടന്നപ്പോൾ ചണവസ്ത്രം ധരിച്ചു;","poem":1},{"text":"ഉപവാസം കൊണ്ടു ഞാൻ എളിമപ്പെട്ടു.","poem":2},{"lineBreak":true},{"text":"എന്‍റെ പ്രാർത്ഥന കേട്ടില്ല.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ഒരു സ്നേഹിതനോ സഹോദരനോ എന്നപോലെ ഞാൻ അവനോട് പെരുമാറി;","poem":1},{"text":"അമ്മയെക്കുറിച്ച് വിലപിക്കുന്നവനെപ്പോലെ ഞാൻ ദുഃഖിച്ച് കുനിഞ്ഞുനടന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"അവരോ എന്‍റെ കഷ്ടതയിൽ സന്തോഷിച്ച് കൂട്ടംകൂടി;","poem":1},{"text":"ഞാൻ അറിയാത്ത അക്രമികൾ എനിക്ക് വിരോധമായി കൂടിവന്നു,","poem":2},{"lineBreak":true},{"text":"അവർ ഇടവിടാതെ എന്നെ പഴിച്ചുപറഞ്ഞു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"വിരുന്നു വീട്ടിലെ പരിഹാസികളായ വഷളന്മാരെപ്പോലെ","poem":1},{"text":"അവർ എന്‍റെ നേരെ പല്ലു കടിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"കർത്താവേ, അവിടുന്ന് എത്രത്തോളം നോക്കിക്കൊണ്ടിരിക്കും?","poem":1},{"text":"അവരുടെ നാശകരമായ പ്രവൃത്തിയിൽനിന്ന് എന്‍റെ പ്രാണനെയും","poem":2},{"lineBreak":true},{"text":"ബാലസിംഹങ്ങളിൽ നിന്ന് എന്‍റെ ജീവനെയും വിടുവിക്കേണമേ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ഞാൻ മഹാസഭയിൽ അങ്ങേക്ക് സ്തോത്രം ചെയ്യും;","poem":1},{"text":"ബഹുജനത്തിന്‍റെ നടുവിൽ അങ്ങയെ സ്തുതിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"വെറുതെ എനിക്ക് ശത്രുക്കളായവർ എന്നെക്കുറിച്ച് സന്തോഷിക്കരുതേ;","poem":1},{"text":"കാരണംകൂടാതെ എന്നെ പകക്കുന്നവർ പരിഹാസത്തോടെ കണ്ണിമയ്ക്കുകയും അരുതേ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അവർ സമാധാനവാക്കുകൾ സംസാരിക്കാതെ","poem":1},{"text":"ദേശത്തിലെ സാധുക്കളുടെ നേരെ വ്യാജകാര്യങ്ങളെ നിരൂപിക്കുന്നു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവർ എന്‍റെ നേരെ വായ് പിളർന്നു:","poem":1},{"text":"“നന്നായി, ഞങ്ങൾ സ്വന്തകണ്ണാൽ കണ്ടു” എന്നു പറഞ്ഞു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"യഹോവേ, അവിടുന്ന് കണ്ടുവല്ലോ; മൗനമായിരിക്കരുതേ;","poem":1},{"text":"കർത്താവേ, എന്നോട് അകന്നിരിക്കരുതേ,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"എന്‍റെ ദൈവവും എന്‍റെ കർത്താവുമായുള്ള യഹോവേ,","poem":1},{"text":"ഉണർന്ന് എന്‍റെ ന്യായത്തിനും വ്യവഹാരത്തിനും വേണ്ടി ജാഗരിക്കേണമേ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"എന്‍റെ ദൈവമായ യഹോവേ, അവിടുത്തെ നീതിനിമിത്തം എനിക്ക് ന്യായം പാലിച്ചുതരേണമേ;","poem":1},{"text":"അവർ എന്നെക്കുറിച്ച് സന്തോഷിക്കരുതേ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"അവർ അവരുടെ ഹൃദയത്തിൽ: “നന്നായി, ഞങ്ങളുടെ ആഗ്രഹം സാധിച്ചു” എന്നു പറയരുതേ;","poem":1},{"text":"“ഞങ്ങൾ അവനെ തകര്‍ത്തുകളഞ്ഞു","poem":2},{"noteId":24},{"text":"” എന്നും പറയരുതേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"എന്‍റെ അനർത്ഥത്തിൽ സന്തോഷിക്കുന്നവർ എല്ലാം ലജ്ജിച്ചു ഭ്രമിച്ചുപോകട്ടെ;","poem":1},{"text":"എന്‍റെ നേരെ വമ്പുപറയുന്നവർ ലജ്ജയും അപമാനവും ധരിക്കട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"എന്‍റെ നീതിയിൽ പ്രസാദിക്കുന്നവർ ഘോഷിച്ചാനന്ദിക്കട്ടെ;","poem":1},{"text":"“തന്‍റെ ദാസന്‍റെ ശ്രേയസ്സിൽ പ്രസാദിക്കുന്ന യഹോവ മഹത്വമുള്ളവൻ”","poem":2},{"lineBreak":true},{"text":"എന്നിങ്ങനെ അവർ എപ്പോഴും പറയട്ടെ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"എന്‍റെ നാവ് അവിടുത്തെ നീതിയെയും ദിവസം മുഴുവൻ","poem":1},{"text":"അങ്ങേയുടെ സ്തുതിയെയും വർണ്ണിക്കും.","poem":2}]}],"footnotes":[{"noteId":24,"caller":"+","text":"ഞങ്ങൾ അവനെ തകര്‍ത്തുകളഞ്ഞു ഞങ്ങൾ അവനെ വിഴുങ്ങിക്കളഞ്ഞു","reference":{"chapter":35,"verse":25}}]},"thisChapterLink":"/api/mal_irv/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}