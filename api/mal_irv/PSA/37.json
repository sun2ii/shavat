{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":37,"content":[{"type":"heading","content":["ക്ഷമയ്ക്കും വിശ്വാസത്തിനുമുള്ള പ്രബോധനം"]},{"type":"hebrew_subtitle","content":["ദാവീദിന്‍റെ ഒരു സങ്കീർത്തനം."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"ദുഷ്പ്രവൃത്തിക്കാർനിമിത്തം നീ ദുഃഖിക്കരുത്;","poem":1},{"text":"നീതികേട് പ്രവർത്തിക്കുന്നവരോട് അസൂയപ്പെടുകയുമരുത്.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവർ പുല്ല് പോലെ വേഗത്തിൽ ഉണങ്ങി","poem":1},{"text":"പച്ചച്ചെടിപോലെ വാടിപ്പോകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"യഹോവയിൽ ആശ്രയിച്ച് നന്മചെയ്യുക;","poem":1},{"text":"ദേശത്ത് വസിച്ച് ദൈവത്തോട് വിശ്വസ്തത പാലിക്കുക.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"യഹോവയിൽ തന്നെ രസിച്ചുകൊള്ളുക;","poem":1},{"text":"കർത്താവ് നിന്‍റെ ഹൃദയത്തിലെ ആഗ്രഹങ്ങൾ നിനക്കു തരും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"നിന്‍റെ വഴി യഹോവയെ ഭരമേല്പിക്കുക;","poem":1},{"text":"കർത്താവിൽ തന്നെ ആശ്രയിക്കുക; അവിടുന്ന് അത് നിവർത്തിക്കും.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"കർത്താവ് നിന്‍റെ നീതിയെ പ്രഭാതം പോലെയും","poem":1},{"text":"നിന്‍റെ ന്യായത്തെ മദ്ധ്യാഹ്നംപോലെയും പ്രകാശിപ്പിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"യഹോവയുടെ മുമ്പാകെ ക്ഷമയോടെയിരുന്ന് കർത്താവിനായി പ്രത്യാശിക്കുക;","poem":1},{"text":"സ്വന്ത വഴിയിൽ അഭിവൃദ്ധിപ്പെടുന്നവനെക്കുറിച്ചും","poem":2},{"lineBreak":true},{"text":"ദുരുപായം പ്രയോഗിക്കുന്നവനെക്കുറിച്ചും നീ മുഷിയരുത്.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"കോപം കളഞ്ഞ് ക്രോധം ഉപേക്ഷിക്കുക;","poem":1},{"text":"മുഷിഞ്ഞുപോകരുത്; അത് ദോഷത്തിന് കാരണമായിത്തീരും.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ദുഷ്പ്രവൃത്തിക്കാർ ഛേദിക്കപ്പെടും;","poem":1},{"text":"യഹോവയിൽ പ്രത്യാശിക്കുന്നവരോ ഭൂമിയെ കൈവശമാക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"അല്പം കഴിഞ്ഞാൽ ദുഷ്ടൻ ഉണ്ടാകുകയില്ല;","poem":1},{"text":"നീ അവന്‍റെ ഇടം സൂക്ഷിച്ചുനോക്കും; അവനെ കാണുകയില്ല.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"എന്നാൽ സൗമ്യതയുള്ളവർ ഭൂമിയെ അവകാശമാക്കും;","poem":1},{"text":"സമാധാനസമൃദ്ധിയിൽ അവർ ആനന്ദിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ദുഷ്ടൻ നീതിമാന് ദോഷം നിരൂപിക്കുന്നു;","poem":1},{"text":"അവന്‍റെനേരെ അവൻ പല്ല് കടിക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"കർത്താവ് അവനെ നോക്കി ചിരിക്കും;","poem":1},{"text":"അവന്‍റെ ദിവസം വരുന്നു എന്നു അവൻ കാണുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"എളിയവനെയും ദരിദ്രനെയും വീഴിക്കുവാനും സന്മാർഗ്ഗികളെ കൊല്ലുവാനും","poem":1},{"text":"ദുഷ്ടന്മാർ വാളൂരി, വില്ല് കുലച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവരുടെ വാൾ അവരുടെ ഹൃദയത്തിൽ തന്നെ കടക്കും;","poem":1},{"text":"അവരുടെ വില്ലുകൾ ഒടിഞ്ഞുപോകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"അനേകം ദുഷ്ടന്മാർക്കുള്ള സമൃദ്ധിയെക്കാൾ","poem":1},{"text":"നീതിമാനുള്ള അല്പം ഏറ്റവും നല്ലത്.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ദുഷ്ടന്മാരുടെ ഭുജങ്ങൾ ഒടിഞ്ഞുപോകും;","poem":1},{"text":"എന്നാൽ നീതിമാന്മാരെ യഹോവ താങ്ങും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"യഹോവ നിഷ്കളങ്കരായവരുടെ നാളുകൾ അറിയുന്നു;","poem":1},{"text":"അവരുടെ അവകാശം ശാശ്വതമായിരിക്കും.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ദുഷ്ക്കാലത്ത് അവർ ലജ്ജിച്ചു പോകുകയില്ല;","poem":1},{"text":"ക്ഷാമകാലത്ത് അവർ തൃപ്തരായിരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"എന്നാൽ ദുഷ്ടന്മാർ നശിച്ചുപോകും;","poem":1},{"text":"യഹോവയുടെ ശത്രുക്കൾ പുല്പുറത്തിന്‍റെ ഭംഗിപോലെയത്രെ;","poem":2},{"lineBreak":true},{"text":"അവർ ക്ഷയിച്ചുപോകും; പുകപോലെ ക്ഷയിച്ചുപോകും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ദുഷ്ടൻ വായ്പ വാങ്ങിയിട്ട്, തിരികെ കൊടുക്കുന്നില്ല;","poem":1},{"text":"നീതിമാനോ ദയതോന്നി ദാനം ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"യഹോവയാൽ അനുഗ്രഹിക്കപ്പെട്ടവർ ഭൂമിയെ കൈവശമാക്കും.","poem":1},{"text":"ദൈവത്താൽ ശപിക്കപ്പെട്ടവരോ ഛേദിക്കപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ഒരു മനുഷ്യന്‍റെ വഴിയിൽ പ്രസാദം തോന്നിയാൽ","poem":1},{"text":"യഹോവ അവന്‍റെ ഗമനം സ്ഥിരമാക്കുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അവൻ വീണാലും നിലംപരിചാകുകയില്ല;","poem":1},{"text":"യഹോവ അവനെ കൈ പിടിച്ച് താങ്ങുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ഞാൻ ബാലനായിരുന്നു, ഇപ്പോൾ വൃദ്ധനായിരിക്കുന്നു;","poem":1},{"text":"നീതിമാൻ തുണയില്ലാതിരിക്കുന്നതും","poem":2},{"lineBreak":true},{"text":"അവന്‍റെ സന്തതി ആഹാരം ഇരക്കുന്നതും ഞാൻ കണ്ടിട്ടില്ല.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"അവൻ നിത്യവും ദയതോന്നി വായ്പ കൊടുക്കുന്നു;","poem":1},{"text":"അവന്‍റെ സന്തതി അനുഗ്രഹിക്കപ്പെടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ദോഷം വിട്ടൊഴിഞ്ഞ് ഗുണം ചെയ്യുക;","poem":1},{"text":"എന്നാൽ നീ സദാകാലം സുഖമായി ജീവിച്ചിരിക്കും.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"യഹോവ ന്യായപ്രിയനാകുന്നു; അവിടുത്തെ വിശുദ്ധന്മാരെ ഉപേക്ഷിക്കുന്നതുമില്ല;","poem":1},{"text":"അവർ എന്നേക്കും പരിപാലിക്കപ്പെടുന്നു;","poem":2},{"lineBreak":true},{"text":"ദുഷ്ടന്മാരുടെ സന്തതിയോ ഛേദിക്കപ്പെടും.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"നീതിമാന്മാർ ഭൂമിയെ അവകാശമാക്കി എന്നേക്കും അതിൽ വസിക്കും;","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"നീതിമാന്‍റെ വായ് ജ്ഞാനം പ്രസ്താവിക്കുന്നു;","poem":1},{"text":"അവന്‍റെ നാവ് ന്യായം സംസാരിക്കുന്നു.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"തന്‍റെ ദൈവത്തിന്‍റെ ന്യായപ്രമാണം അവന്‍റെ ഹൃദയത്തിൽ ഉണ്ട്;","poem":1},{"text":"അവന്‍റെ കാലടികൾ വഴുതുകയില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"ദുഷ്ടൻ നീതിമാനെ കൊല്ലുവാനായി പതിയിരിക്കുന്നു,","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"യഹോവ അവനെ അവന്‍റെ കയ്യിൽ വിട്ടുകൊടുക്കുകയില്ല;","poem":1},{"text":"ന്യായവിസ്താരത്തിൽ അവനെ കുറ്റം വിധിക്കുകയുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"യഹോവയ്ക്കായി പ്രത്യാശിച്ച് അവിടുത്തെ വഴി പ്രമാണിച്ച് നടക്കുക;","poem":1},{"text":"എന്നാൽ ഭൂമിയെ അവകാശമാക്കുവാൻ കർത്താവ് നിന്നെ ഉയർത്തും;","poem":2},{"lineBreak":true},{"text":"ദുഷ്ടന്മാർ ഛേദിക്കപ്പെടുന്നത് നീ കാണും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"ദുഷ്ടൻ പ്രബലനായിരിക്കുന്നതും;","poem":1},{"text":"സ്വദേശത്തുള്ള പച്ചവൃക്ഷം പോലെ","poem":2},{"noteId":25},{"text":"തഴച്ചുവളരുന്നതും ഞാൻ കണ്ടിട്ടുണ്ട്.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ഞാൻ പിന്നെ അതിലെ പോയപ്പോൾ","poem":1},{"noteId":26},{"text":"അവൻ ഇല്ല;","poem":1},{"text":"ഞാൻ അന്വേഷിച്ചു, അവനെ കണ്ടതുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"നിഷ്കളങ്കനെ ശ്രദ്ധിക്കുക; നേരുള്ളവനെ നോക്കിക്കൊള്ളുക;","poem":1},{"text":"സമാധാനപുരുഷന് സന്തതി ഉണ്ടാകും.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"എന്നാൽ അതിക്രമക്കാർ പൂർണ്ണമായി മുടിഞ്ഞുപോകും;","poem":1},{"text":"അവരുടെ പിൻഗാമികൾ നശിപ്പിക്കപ്പെടും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"നീതിമാന്മാരുടെ രക്ഷ യഹോവയിൽനിന്ന് വരുന്നു;","poem":1},{"text":"കഷ്ടകാലത്ത് കർത്താവ് അവരുടെ ദുർഗ്ഗം ആകുന്നു.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"യഹോവ അവരെ സഹായിച്ച് വിടുവിക്കുന്നു;","poem":1},{"text":"അവർ കർത്താവിൽ ആശ്രയിക്കയാൽ","poem":2},{"lineBreak":true},{"text":"അവിടുന്ന് അവരെ ദുഷ്ടന്മാരുടെ കയ്യിൽനിന്ന് വിടുവിച്ച് രക്ഷിക്കുന്നു.","poem":2}]}],"footnotes":[{"noteId":25,"caller":"+","text":"പച്ചവൃക്ഷം പോലെ ലെബാനോന്‍ രാജ്യത്തെ ദേവദാരുപോലെ","reference":{"chapter":37,"verse":35}},{"noteId":26,"caller":"+","text":"ഞാൻ പിന്നെ അതിലെ പോയപ്പോൾ അവന്‍ പിന്നെ അതിലെ പോയപ്പോൾ","reference":{"chapter":37,"verse":36}}]},"thisChapterLink":"/api/mal_irv/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}