{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":40,"content":[{"type":"heading","content":["സ്തോത്രവും പ്രാർത്ഥനയും"]},{"type":"hebrew_subtitle","content":["സംഗീതപ്രമാണിക്ക്; ദാവീദിന്‍റെ ഒരു സങ്കീർത്തനം."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"ഞാൻ യഹോവയ്ക്കായി ക്ഷമയോടെ കാത്തിരുന്നു;","poem":1},{"text":"കർത്താവ് എന്നിലേക്ക് ചാഞ്ഞ് എന്‍റെ നിലവിളി കേട്ടു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"നാശകരമായ കുഴിയിൽ നിന്നും","poem":1},{"text":"കുഴഞ്ഞ ചേറ്റിൽനിന്നും കർത്താവ് എന്നെ കയറ്റി;","poem":2},{"text":"എന്‍റെ കാലുകളെ ഒരു പാറമേൽ നിർത്തി,","poem":1},{"text":"എന്‍റെ ചുവടുകളെ സ്ഥിരമാക്കി.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവിടുന്ന് എന്‍റെ വായിൽ ഒരു പുതിയ പാട്ട് തന്നു,","poem":1},{"text":"നമ്മുടെ ദൈവത്തിന് സ്തുതി തന്നെ;","poem":2},{"text":"പലരും അത് കണ്ടു ഭയപ്പെട്ട്","poem":1},{"text":"യഹോവയിൽ ആശ്രയിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"യഹോവയെ തന്‍റെ ആശ്രയമാക്കുകയും","poem":1},{"text":"നിഗളികളെയും","poem":2},{"noteId":27},{"text":"വ്യാജദൈവങ്ങളിലേക്ക് തിരിയുന്നവരെയും","poem":2},{"lineBreak":true},{"text":"ആദരിക്കാതിരിക്കുകയും ചെയ്യുന്ന മനുഷ്യൻ ഭാഗ്യവാൻ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"എന്‍റെ ദൈവമായ യഹോവേ, അവിടുന്ന് ചെയ്ത അത്ഭുതപ്രവൃത്തികളും","poem":1},{"text":"ഞങ്ങൾക്കുവേണ്ടിയുള്ള അങ്ങേയുടെ വിചാരങ്ങളും അനവധി ആകുന്നു;","poem":2},{"text":"അങ്ങേക്ക് തുല്യൻ ആരുമില്ല;","poem":1},{"text":"ഞാൻ അവയെപ്പറ്റി വിവരിച്ച് പ്രസ്താവിക്കുമായിരുന്നു;","poem":2},{"lineBreak":true},{"text":"എന്നാൽ അവ എണ്ണിക്കൂടാത്തവിധം അധികമാകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ഹനനയാഗവും ഭോജനയാഗവും അവിടുന്ന് ഇച്ഛിച്ചില്ല;","poem":1},{"text":"അങ്ങ് എന്‍റെ ചെവികൾ തുറന്നിരിക്കുന്നു.","poem":2},{"lineBreak":true},{"text":"ഹോമയാഗവും പാപയാഗവും അവിടുന്ന് ചോദിച്ചില്ല.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അപ്പോൾ ഞാൻ പറഞ്ഞു: “ഇതാ, ഞാൻ വരുന്നു;","poem":1},{"text":"പുസ്തകച്ചുരുളിൽ എന്നെക്കുറിച്ച് എഴുതിയിരിക്കുന്നു;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"എന്‍റെ ദൈവമേ, അങ്ങേയുടെ ഇഷ്ടം ചെയ്യുവാൻ ഞാൻ പ്രിയപ്പെടുന്നു;","poem":1},{"text":"അവിടുത്തെ ന്യായപ്രമാണം എന്‍റെ ഉള്ളിൽ ഇരിക്കുന്നു.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ഞാൻ മഹാസഭയിൽ നീതിയുടെ സുവാർത്ത പ്രസംഗിച്ചു;","poem":1},{"text":"അധരങ്ങൾ ഞാൻ അടക്കിവച്ചില്ല;","poem":2},{"lineBreak":true},{"text":"യഹോവേ, അവിടുന്ന് അറിയുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ഞാൻ അങ്ങേയുടെ നീതി എന്‍റെ ഹൃദയത്തിൽ മറച്ചു വച്ചില്ല;","poem":1},{"text":"അവിടുത്തെ വിശ്വസ്തതയും രക്ഷയും ഞാൻ പ്രസ്താവിച്ചു;","poem":2},{"lineBreak":true},{"text":"അവിടുത്തെ ദയയും സത്യവും ഞാൻ മഹാസഭയിൽ മറച്ചുവച്ചതുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"യഹോവേ, അങ്ങേയുടെ കരുണ അവിടുന്ന് എനിക്ക് അടച്ചുകളയുകയില്ല;","poem":1},{"text":"അങ്ങേയുടെ ദയയും സത്യവും എന്നെ നിത്യം പരിപാലിക്കും.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അസംഖ്യം അനർത്ഥങ്ങൾ എന്നെ ചുറ്റിയിരിക്കുന്നു; മേല്പോട്ടു","poem":1},{"text":"നോക്കുവാൻ കഴിയാത്തവിധം എന്‍റെ അകൃത്യങ്ങൾ എന്നെ എത്തിപ്പിടിച്ചിരിക്കുന്നു;","poem":2},{"text":"അവ എന്‍റെ തലയിലെ രോമങ്ങളിലും അധികം;","poem":1},{"text":"ഞാൻ ധൈര്യഹീനനായിത്തീർന്നിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"യഹോവേ, എന്നെ വിടുവിക്കുവാൻ ഇഷ്ടം തോന്നേണമേ;","poem":1},{"text":"യഹോവേ, എന്നെ സഹായിക്കുവാൻ വേഗം വരേണമേ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"എനിക്ക് ജീവഹാനി വരുത്തുവാൻ നോക്കുന്നവർ ലജ്ജിച്ച് ഭ്രമിച്ചുപോകട്ടെ;","poem":1},{"text":"എന്‍റെ അനർത്ഥത്തിൽ സന്തോഷിക്കുന്നവർ പിന്തിരിഞ്ഞ് അപമാനം ഏല്ക്കട്ടെ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“നന്നായി, നന്നായി” എന്നു എന്നോട് പറയുന്നവർ","poem":1},{"text":"അവരുടെ ലജ്ജ നിമിത്തം സ്തംഭിച്ചുപോകട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"അങ്ങയെ അന്വേഷിക്കുന്ന എല്ലാവരും അവിടുത്തെ സന്നിധിയിൽ ആനന്ദിച്ച് സന്തോഷിക്കട്ടെ;","poem":1},{"text":"അങ്ങേയുടെ രക്ഷയിൽ പ്രിയപ്പെടുന്നവർ “യഹോവ എത്ര മഹത്വമുള്ളവൻ” എന്നു എപ്പോഴും പറയട്ടെ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ഞാൻ എളിയവനും ദരിദ്രനും ആകുന്നു;","poem":1},{"text":"എങ്കിലും കർത്താവ് എന്നെക്കുറിച്ച് വിചാരിക്കുന്നു;","poem":2},{"text":"അവിടുന്ന് തന്നെ എന്‍റെ സഹായവും എന്നെ വിടുവിക്കുന്നവനും ആകുന്നു;","poem":1},{"text":"എന്‍റെ ദൈവമേ, താമസിക്കരുതേ.","poem":2}]}],"footnotes":[{"noteId":27,"caller":"+","text":"നിഗളികളെയും വിഗ്രഹങ്ങളെയും","reference":{"chapter":40,"verse":4}}]},"thisChapterLink":"/api/mal_irv/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}