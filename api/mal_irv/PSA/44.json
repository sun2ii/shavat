{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":44,"content":[{"type":"heading","content":["ജനതയുടെ വിലാപം"]},{"type":"hebrew_subtitle","content":["സംഗീതപ്രമാണിക്ക്; കോരഹ് പുത്രന്മാരുടെ ഒരു ധ്യാനം."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"ദൈവമേ, പൂർവ്വകാലത്ത് ഞങ്ങളുടെ പൂര്‍വ്വ പിതാക്കന്മാരുടെ നാളുകളിൽ","poem":1},{"text":"അവിടുന്ന് ചെയ്ത പ്രവൃത്തികൾ അവർ ഞങ്ങളോട് വിവരിച്ചിരിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"ഞങ്ങളുടെ ചെവികൊണ്ട് ഞങ്ങൾ കേട്ടുമിരിക്കുന്നു;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അങ്ങേയുടെ കൈകൊണ്ട് അവിടുന്ന് ജനതകളെ പുറത്താക്കി അവരെ നട്ടു;","poem":1},{"text":"വംശങ്ങളെ നശിപ്പിച്ച്, അവരെ ദേശത്ത് സ്വതന്ത്രരായി വിട്ടു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവരുടെ വാളുകൾ കൊണ്ടല്ല അവർ ദേശം കൈവശമാക്കിയത്;","poem":1},{"text":"സ്വന്ത ഭുജബലം കൊണ്ടല്ല അവർ ജയം നേടിയത്;","poem":2},{"text":"അങ്ങേയുടെ വലങ്കൈയ്യും അവിടുത്തെ ഭുജവും അവിടുത്തെ മുഖപ്രകാശവും കൊണ്ടാകുന്നു;","poem":1},{"text":"അങ്ങേക്ക് അവരോട് പ്രിയമുണ്ടായിരുന്നുവല്ലോ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ദൈവമേ, അവിടുന്ന് എന്‍റെ ദൈവവും രാജാവുമാകുന്നു;","poem":1},{"text":"യാക്കോബിന് രക്ഷ ഉറപ്പാക്കേണമേ","poem":2},{"noteId":29},{"text":".","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അങ്ങയാൽ ഞങ്ങൾ ശത്രുക്കളെ തള്ളിയിടും;","poem":1},{"text":"ഞങ്ങളോട് എതിർക്കുന്നവരെ അവിടുത്തെ നാമത്തിൽ ചവിട്ടിക്കളയും.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഞാൻ എന്‍റെ വില്ലിൽ ആശ്രയിക്കുകയില്ല;","poem":1},{"text":"എന്‍റെ വാൾ എന്നെ രക്ഷിക്കുകയുമില്ല.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അങ്ങാകുന്നു ഞങ്ങളെ വൈരികളുടെ കയ്യിൽനിന്ന് രക്ഷിച്ചത്;","poem":1},{"text":"ഞങ്ങളെ വെറുത്തവരെ അങ്ങ് ലജ്ജിപ്പിച്ചുമിരിക്കുന്നു;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ദൈവത്തിൽ ഞങ്ങൾ നിത്യം പ്രശംസിക്കുന്നു;","poem":1},{"text":"അവിടുത്തെ നാമത്തിന് എന്നും സ്തോത്രം ചെയ്യുന്നു. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"എന്നാൽ, അവിടുന്ന് ഞങ്ങളെ തള്ളിക്കളഞ്ഞ് ലജ്ജിപ്പിച്ചിരിക്കുന്നു;","poem":1},{"text":"ഞങ്ങളുടെ സൈന്യങ്ങളോടുകൂടി പുറപ്പെടുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"വൈരിയുടെ മുമ്പിൽ അവിടുന്ന് ഞങ്ങളെ പുറംതിരിഞ്ഞ് ഓടുമാറാക്കുന്നു;","poem":1},{"text":"ഞങ്ങളെ പകക്കുന്നവർ ഞങ്ങളെ കൊള്ളയിടുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ഭക്ഷണത്തിനുവേണ്ടി കൊല്ലുവാനുള്ള ആടുകളെപ്പോലെ നീ ഞങ്ങളെ ഏല്പിച്ചുകൊടുത്തു;","poem":1},{"text":"ജനതകളുടെ ഇടയിൽ ഞങ്ങളെ ചിതറിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അങ്ങ് അവിടുത്തെ ജനത്തെ തുച്ഛമായ വിലയ്ക്ക് വില്ക്കുന്നു.","poem":1},{"text":"അവരുടെ വിലകൊണ്ട് സമ്പത്ത് വർദ്ധിക്കുന്നതുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"അങ്ങ് ഞങ്ങളെ അയല്ക്കാർക്ക് അപമാനവിഷയവും","poem":1},{"text":"ചുറ്റുമുള്ളവർക്ക് നിന്ദയും പരിഹാസവും ആക്കുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അങ്ങ് ജനതകളുടെ ഇടയിൽ ഞങ്ങളെ പഴഞ്ചൊല്ലിനും","poem":1},{"text":"വംശങ്ങളുടെ നടുവിൽ പരിഹാസത്തിനും വിഷയം ആക്കുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"നിന്ദിക്കുകയും ദുഷിക്കുകയും ചെയ്യുന്നവന്‍റെ വാക്കുകൾ ഹേതുവായും","poem":1},{"text":"ശത്രുവിന്‍റെയും പ്രതികാരകൻ്റെയും നിമിത്തവും","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ഞാൻ ഇടവിടാതെ അപമാനം അനുഭവിക്കുന്നു;","poem":1},{"text":"ലജ്ജ എന്‍റെ മുഖത്തെ മൂടിയിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ഇവയെല്ലാം ഞങ്ങൾക്ക് സംഭവിച്ചു എങ്കിലും ഞങ്ങൾ അങ്ങയെ മറന്നിട്ടില്ല;","poem":1},{"text":"അവിടുത്തെ നിയമത്തോട് അവിശ്വസ്തത കാണിച്ചിട്ടുമില്ല.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അവിടുന്ന് ഞങ്ങളെ കുറുക്കന്മാരുടെ സ്ഥലത്തുവച്ച് തകർത്തുകളയുവാനും","poem":1},{"text":"മരണത്തിന്‍റെ നിഴൽകൊണ്ട് ഞങ്ങളെ മൂടുവാനും തക്കവണ്ണം","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ഞങ്ങളുടെ ഹൃദയം പിന്തിരിയുകയോ","poem":1},{"text":"ഞങ്ങളുടെ കാലടികൾ അവിടുത്തെ വഴി വിട്ടുമാറുകയോ ചെയ്തിട്ടില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ദൈവത്തിന്‍റെ നാമം ഞങ്ങൾ മറക്കുകയോ","poem":1},{"text":"ഞങ്ങളുടെ കൈകൾ അന്യദൈവങ്ങളിലേക്ക് സഹായത്തിനായി നീട്ടുകയോ ചെയ്തിട്ടുണ്ടെങ്കിൽ","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ദൈവം അത് ശോധന ചെയ്യാതിരിക്കുമോ?","poem":1},{"text":"കർത്താവ് ഹൃദയ രഹസ്യങ്ങൾ അറിയുന്നുവല്ലോ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"അങ്ങേയുടെ നിമിത്തം ഞങ്ങളെ ദിവസംപ്രതി കൊല്ലുന്നു;","poem":1},{"text":"അറുക്കുവാനുള്ള ആടുകളെപ്പോലെ ഞങ്ങളെ എണ്ണുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"കർത്താവേ, ഉണരേണമേ; അങ്ങ് ഉറങ്ങുന്നത് എന്ത്?","poem":1},{"text":"എഴുന്നേല്ക്കേണമേ; ഞങ്ങളെ എന്നേക്കും തള്ളിക്കളയരുതേ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അങ്ങേയുടെ മുഖം മറയ്ക്കുന്നതും","poem":1},{"text":"ഞങ്ങളുടെ കഷ്ടതയും പീഡയും മറന്നുകളയുന്നതും എന്ത്?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ഞങ്ങൾ നിലത്തോളം കുനിഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"ഞങ്ങളുടെ ശരീരം നിലം പറ്റിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ഞങ്ങളുടെ സഹായത്തിനായി എഴുന്നേല്ക്കേണമേ;","poem":1},{"text":"അങ്ങേയുടെ ദയനിമിത്തം ഞങ്ങളെ വീണ്ടെടുക്കേണമേ.","poem":2}]}],"footnotes":[{"noteId":29,"caller":"+","text":"യാക്കോബിന് രക്ഷ ഉറപ്പാക്കേണമേ അവിടുന്ന് യാക്കോബിന് ജയം ഉറപ്പാക്കേണമേ","reference":{"chapter":44,"verse":4}}]},"thisChapterLink":"/api/mal_irv/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}