{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":49,"content":[{"type":"heading","content":["സമ്പത്തിലുള്ള ആശ്രയം വിവേകശൂന്യമാണ്"]},{"type":"hebrew_subtitle","content":["സംഗീതപ്രമാണിക്ക്; കോരഹ് പുത്രന്മാരുടെ ഒരു സങ്കീർത്തനം."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"സകലജനതകളുമേ, ഇത് കേൾക്കുവിൻ;","poem":1},{"text":"സകലഭൂവാസികളുമേ, ശ്രദ്ധിക്കുവിൻ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"സാമാന്യജനവും ശ്രേഷ്ഠജനവും","poem":1},{"text":"ധനവാന്മാരും ദരിദ്രന്മാരും തന്നെ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"എന്‍റെ അധരം ജ്ഞാനം പ്രസ്താവിക്കും;","poem":1},{"text":"എന്‍റെ ഹൃദയത്തിലെ ധ്യാനം വിവേകം തന്നെ ആയിരിക്കും.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ഞാൻ സദൃശവാക്യത്തിന് എന്‍റെ ചെവിചായിക്കും;","poem":1},{"text":"കിന്നരനാദത്തോടെ എന്‍റെ കടങ്കഥ കേൾപ്പിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ആപത്തുകാലത്ത്, ശത്രുക്കൾ","poem":1},{"text":"എന്‍റെ ചുറ്റും കൂടുമ്പോൾ ഞാൻ ഭയപ്പെടുകയില്ല.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"തന്‍റെ സമ്പത്തിൽ ആശ്രയിക്കുകയും","poem":1},{"text":"ധനസമൃദ്ധിയിൽ പ്രശംസിക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"സത്യമായി, സ്വയം വീണ്ടെടുക്കുവാനോ","poem":1},{"noteId":34},{"text":"ദൈവത്തിന് വീണ്ടെടുപ്പുവില കൊടുക്കുവാനോ കഴിയുകയില്ല.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവരുടെ പ്രാണന്‍റെ വീണ്ടെടുപ്പ് വിലയേറിയത്;","poem":1},{"text":"അത് ഒരുനാളും സാധിക്കുകയില്ല.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"സഹോദരൻ ശവക്കുഴി കാണാതെ","poem":1},{"text":"എന്നേക്കും ജീവിച്ചിരിക്കേണ്ടതിന് തന്നെ","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ജ്ഞാനികൾ മരിക്കുകയും മൂഢനും മൃഗപ്രായനും ഒരുപോലെ നശിക്കുകയും","poem":1},{"text":"അവരുടെ സമ്പാദ്യം മറ്റുള്ളവർക്ക് വിട്ടിട്ട് പോകുകയും ചെയ്യുന്നത് കാണുന്നുവല്ലോ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"തങ്ങളുടെ ശവക്കുഴികള്‍","poem":1},{"noteId":35},{"text":"ശാശ്വതമായും","poem":1},{"text":"അവരുടെ വാസസ്ഥലങ്ങൾ തലമുറതലമുറയായും നില്ക്കും","poem":2},{"text":"എന്നാകുന്നു അവരുടെ വിചാരം;","poem":1},{"text":"അവരുടെ നിലങ്ങൾക്ക് അവർ അവരുടെ പേരിടുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"എന്നാൽ മനുഷ്യൻ ബഹുമാനത്തിൽ നിലനില്‍ക്കുകയില്ല.","poem":1},{"text":"അവൻ നശിച്ചുപോകുന്ന മൃഗങ്ങൾക്ക് തുല്യൻ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ഇത് സ്വാശ്രയക്കാരുടെ ഭവിഷ്യത്താകുന്നു;","poem":1},{"text":"അവരുടെ വാക്കുകൾ അനുസരിക്കുന്ന അവരുടെ പിൻതലമുറക്കാരുടെയും ഗതി ഇതുതന്നെ. സേലാ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവരെ ആടുകളെപ്പോലെ പാതാളത്തിന് ഏല്പിച്ചിരിക്കുന്നു;","poem":1},{"text":"മൃത്യു അവരെ മേയിക്കുന്നു;","poem":2},{"text":"നേരുള്ളവർ പ്രഭാതത്തിൽ അവരുടെ മേൽ വാഴും;","poem":1},{"text":"അവരുടെ സൗന്ദര്യം ഇല്ലാതെയാകും;","poem":2},{"lineBreak":true},{"text":"അവര്‍ നേരെ പാതാളത്തിലേക്ക്‌ ഇറങ്ങുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"എങ്കിലും എന്‍റെ പ്രാണനെ ദൈവം പാതാളത്തിന്‍റെ അധികാരത്തിൽനിന്ന് വീണ്ടെടുക്കും;","poem":1},{"text":"അവിടുന്ന് എന്നെ കൈക്കൊള്ളും. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ഒരുവൻ ധനവാനായി ഭവിച്ചാലും","poem":1},{"text":"അവന്‍റെ ഭവനത്തിന്‍റെ മഹത്വം","poem":2},{"noteId":36},{"text":"വർദ്ധിച്ചാലും നീ ഭയപ്പെടരുത്.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവൻ മരിക്കുമ്പോൾ യാതൊന്നും കൊണ്ടുപോകുകയില്ല;","poem":1},{"text":"അവന്‍റെ മഹത്വം അവനെ അനുഗമിക്കുകയുമില്ല.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അവൻ ജീവനോടിരുന്നപ്പോൾ താൻ ഭാഗ്യവാൻ എന്നു സ്വയം പറഞ്ഞു;","poem":1},{"text":"നീ നിനക്കു തന്നെ നന്മ ചെയ്യുമ്പോൾ മനുഷ്യർ നിന്നെ പുകഴ്ത്തും.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അവൻ തന്‍റെ പിതാക്കന്മാരുടെ തലമുറയോട് ചേരും;","poem":1},{"text":"അവർ ഒരുനാളും വെളിച്ചം കാണുകയില്ല.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ആദരവ് നേടിയ മനുഷ്യൻ വിവേക ശൂന്യനായാൽ","poem":1},{"text":"നശിച്ചുപോകുന്ന മൃഗങ്ങൾക്ക് തുല്യനാകുന്നു.","poem":2}]}],"footnotes":[{"noteId":34,"caller":"+","text":"സ്വയം വീണ്ടെടുക്കുവാനോ മറ്റൊരുത്തനും അവന്‍റെ സഹോദരനെ വീണ്ടെടുക്കുവാന്‍","reference":{"chapter":49,"verse":7}},{"noteId":35,"caller":"+","text":"ശവക്കുഴികള്‍ അവരുടെ അകത്തെ വിചാരങ്ങള്‍","reference":{"chapter":49,"verse":11}},{"noteId":36,"caller":"+","text":"മഹത്വം സമ്പത്ത്","reference":{"chapter":49,"verse":16}}]},"thisChapterLink":"/api/mal_irv/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}