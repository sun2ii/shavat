{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":50,"content":[{"type":"heading","content":["യഥാര്‍ത്ഥമായ ആരാധന"]},{"type":"hebrew_subtitle","content":["ആസാഫിന്‍റെ ഒരു സങ്കീർത്തനം."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"സർവ്വശക്തനായ ദൈവം, യഹോവയായ ദൈവം തന്നെ, തന്‍റെ വാക്കിനാൽ,","poem":1},{"text":"സൂര്യന്‍റെ ഉദയംമുതൽ അസ്തമയംവരെ ഭൂമിയെ വിളിക്കുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"സൗന്ദര്യത്തിന്‍റെ പൂർണ്ണതയായ","poem":1},{"text":"സീയോനിൽനിന്നു ദൈവം പ്രകാശിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"നമ്മുടെ ദൈവം വരുന്നു; നിശ്ശബ്ദനായിരിക്കുകയില്ല;","poem":1},{"text":"ദൈവത്തിന്‍റെ മുമ്പിൽ തീ ദഹിപ്പിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"അവിടുത്തെ ചുറ്റും വലിയ കൊടുങ്കാറ്റടിക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"തന്‍റെ ജനത്തെ ന്യായം വിധിക്കേണ്ടതിന്","poem":1},{"text":"കർത്താവ് ഉയരത്തിൽനിന്ന് ആകാശത്തെയും ഭൂമിയെയും വിളിക്കുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"യാഗം കഴിച്ച് എന്നോട് ഉടമ്പടി ചെയ്തവരായ","poem":1},{"text":"എന്‍റെ വിശുദ്ധന്മാരെ എന്‍റെ അടുക്കൽ കൂട്ടുവിൻ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ദൈവം തന്നെ ന്യായാധിപതി ആയിരിക്കുകയാൽ","poem":1},{"text":"ആകാശം അവിടുത്തെ നീതിയെ ഘോഷിക്കും. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"എന്‍റെ ജനമേ, കേൾക്കുക; ഞാൻ സംസാരിക്കും.","poem":1},{"text":"യിസ്രായേലേ, ഞാൻ നിങ്ങൾക്കെതിരെ സാക്ഷ്യം പറയും:","poem":2},{"lineBreak":true},{"text":"ദൈവമായ ഞാൻ നിന്‍റെ ദൈവമാകുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"നിന്‍റെ ഹനനയാഗങ്ങളെക്കുറിച്ച് ഞാൻ നിന്നെ ശാസിക്കുന്നില്ല;","poem":1},{"text":"നിന്‍റെ ഹോമയാഗങ്ങൾ എപ്പോഴും എന്‍റെ മുമ്പാകെ ഉണ്ടല്ലോ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"നിന്‍റെ വീട്ടിൽനിന്ന് ഒരു കാളയെയോ","poem":1},{"text":"നിന്‍റെ തൊഴുത്തുകളിൽനിന്ന് ഒരു കോലാട്ടുകൊറ്റനെയോ ഞാൻ എടുക്കുകയില്ല.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"കാട്ടിലെ സകലമൃഗങ്ങളും","poem":1},{"text":"ആയിരം കുന്നുകളിലെ കന്നുകാലികളും എനിക്കുള്ളവയാകുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"മലകളിലെ","poem":1},{"noteId":37},{"text":"പക്ഷികളെ എല്ലാം ഞാൻ അറിയുന്നു;","poem":1},{"text":"വയലിലെ വന്യമൃഗങ്ങളും എനിക്കുള്ളവ തന്നെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“എനിക്ക് വിശക്കുമ്പോൾ ഞാൻ നിന്നോട് പറയുകയില്ല;","poem":1},{"text":"ലോകവും അതിലുള്ള സകലവും എന്‍റെതാകുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ഞാൻ കാളകളുടെ മാംസം തിന്നുമോ?","poem":1},{"text":"കോലാട്ടുകൊറ്റന്മാരുടെ രക്തം കുടിക്കുമോ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ദൈവത്തിന് സ്തോത്രയാഗം അർപ്പിക്കുക;","poem":1},{"text":"അത്യുന്നതനായ ദൈവത്തിന് നിന്‍റെ നേർച്ചകൾ കഴിക്കുക.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"കഷ്ടകാലത്ത് എന്നെ വിളിച്ചപേക്ഷിക്കുക;","poem":1},{"text":"ഞാൻ നിന്നെ വിടുവിക്കുകയും നീ എന്നെ മഹത്വപ്പെടുത്തുകയും ചെയ്യും.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"എന്നാൽ ദുഷ്ടനോട് ദൈവം അരുളിച്ചെയ്യുന്നത്:","poem":1},{"text":"“എന്‍റെ ചട്ടങ്ങൾ അറിയിക്കുവാനും എന്‍റെ നിയമം നിന്‍റെ വായിൽ എടുക്കുവാനും നിനക്കു എന്ത് കാര്യം?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"നീ ശാസന വെറുത്ത്","poem":1},{"text":"എന്‍റെ വചനങ്ങൾ നിന്‍റെ പിറകിൽ എറിഞ്ഞുകളയുന്നുവല്ലോ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"കള്ളനെ കണ്ടാൽ നീ അവന്‍റെ പക്ഷം ചേരുന്നു;","poem":1},{"text":"വ്യഭിചാരികളോട് നീ കൂട്ട് കൂടുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“നിന്‍റെ വായ് നീ ദോഷത്തിന് വിട്ടുകൊടുക്കുന്നു;","poem":1},{"text":"നിന്‍റെ നാവ് വഞ്ചനയ്ക്ക് രൂപം നൽകുന്നു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"നീ ഇരുന്ന് നിന്‍റെ സഹോദരന് വിരോധമായി സംസാരിക്കുന്നു;","poem":1},{"text":"നിന്‍റെ അമ്മയുടെ മകനെക്കുറിച്ച് അപവാദം പറയുന്നു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ഇപ്രകാരം നീ ചെയ്യുകയും ഞാൻ മിണ്ടാതിരിക്കുകയും ചെയ്തപ്പോൾ","poem":1},{"text":"ഞാനും നിന്നെപ്പോലെയുള്ളവനെന്ന് നീ വിചാരിച്ചു;","poem":2},{"lineBreak":true},{"text":"എന്നാൽ ഞാൻ നിന്നെ ശാസിച്ച് നിന്‍റെ കണ്ണിന്‍റെ മുമ്പിൽ അവയെല്ലാം നിരത്തിവക്കും.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“ദൈവത്തെ മറക്കുന്നവരേ, ഇത് ഓർത്തുകൊള്ളുവീൻ;","poem":1},{"text":"അല്ലെങ്കിൽ ഞാൻ നിങ്ങളെ കീറിക്കളയും;","poem":2},{"lineBreak":true},{"text":"വിടുവിക്കുവാൻ ആരും ഉണ്ടാകുകയുമില്ല.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"സ്തോത്രമെന്ന യാഗം അർപ്പിക്കുന്നവൻ എന്നെ മഹത്വപ്പെടുത്തുന്നു;","poem":1},{"text":"തന്‍റെ നടപ്പ് ക്രമപ്പെടുത്തുന്നവന് ഞാൻ ദൈവത്തിന്‍റെ രക്ഷയെ കാണിച്ചുകൊടുക്കും.“","poem":2}]}],"footnotes":[{"noteId":37,"caller":"+","text":"മലകളിലെ ആകാശത്തിലെ","reference":{"chapter":50,"verse":11}}]},"thisChapterLink":"/api/mal_irv/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}