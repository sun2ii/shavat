{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":69,"content":[{"type":"heading","content":["സഹായത്തിനുവേണ്ടിയുള്ള പ്രാർത്ഥന"]},{"type":"hebrew_subtitle","content":["സംഗീതപ്രമാണിക്ക്; സാരസരാഗത്തിൽ; ദാവീദിന്‍റെ ഒരു സങ്കീർത്തനം."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"ദൈവമേ, എന്നെ രക്ഷിക്കേണമേ;","poem":1},{"text":"വെള്ളം എന്‍റെ കഴുത്തോളം","poem":2},{"noteId":60},{"text":"എത്തിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ഞാൻ നിലയില്ലാത്ത ആഴമുള്ള ചേറ്റിൽ താഴുന്നു;","poem":1},{"text":"ആഴമുള്ള വെള്ളത്തിൽ ഞാൻ മുങ്ങിപ്പോകുന്നു;","poem":2},{"lineBreak":true},{"text":"പ്രവാഹങ്ങൾ എന്‍റെ മീതെ കവിഞ്ഞൊഴുകുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"എന്‍റെ നിലവിളികൊണ്ട് ഞാൻ തളർന്നിരിക്കുന്നു;","poem":1},{"text":"എന്‍റെ തൊണ്ട വരണ്ടിരിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"ദൈവത്തെ കാത്തിരുന്ന് എന്‍റെ കണ്ണ് മങ്ങിപ്പോകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"കാരണംകൂടാതെ എന്നെ വെറുക്കുന്നവർ","poem":1},{"text":"എന്‍റെ തലയിലെ രോമങ്ങളേക്കാളും അധികമാകുന്നു;","poem":2},{"text":"വൃഥാ എന്‍റെ ശത്രുക്കളായി എന്നെ സംഹരിക്കുവാൻ ഭാവിക്കുന്നവർ പെരുകിയിരിക്കുന്നു;","poem":1},{"text":"ഞാൻ മോഷ്ടിക്കാത്തത് തിരികെ കൊടുക്കേണ്ടിവരുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ദൈവമേ, അവിടുന്ന് എന്‍റെ ഭോഷത്തം അറിയുന്നു;","poem":1},{"text":"എന്‍റെ അകൃത്യങ്ങൾ അങ്ങേക്ക് മറഞ്ഞിരിക്കുന്നില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"സൈന്യങ്ങളുടെ യഹോവയായ കർത്താവേ,","poem":1},{"text":"അങ്ങയിൽ പ്രത്യാശ വയ്ക്കുന്നവർ എന്‍റെ നിമിത്തം ലജ്ജിച്ചുപോകരുതേ;","poem":2},{"text":"യിസ്രായേലിന്‍റെ ദൈവമേ, അവിടുത്തെ അന്വേഷിക്കുന്നവർ","poem":1},{"text":"എന്‍റെ നിമിത്തം നാണിച്ചുപോകരുതേ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവിടുത്തെ നാമംനിമിത്തം ഞാൻ നിന്ദ സഹിച്ചു;","poem":1},{"text":"ലജ്ജ എന്‍റെ മുഖത്തെ മൂടിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"എന്‍റെ സഹോദരന്മാർക്ക് ഞാൻ പരദേശിയും","poem":1},{"text":"എന്‍റെ അമ്മയുടെ മക്കൾക്ക് അന്യനും ആയി തീർന്നിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"അങ്ങേയുടെ ആലയത്തെക്കുറിച്ചുള്ള എരിവ് എന്നെ തിന്നുകളഞ്ഞു;","poem":1},{"text":"അങ്ങയെ നിന്ദിക്കുന്നവരുടെ നിന്ദ എന്‍റെ മേൽ വീണിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ഞാൻ എന്‍റെ പ്രാണനെ കരച്ചിലാലും ഉപവാസത്താലും താഴ്മയുള്ളവനാക്കി","poem":1},{"noteId":61},{"text":".","poem":1},{"text":"അതും എനിക്ക് നിന്ദയായി തീർന്നു;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ഞാൻ ചണവസ്ത്രം എന്‍റെ ഉടുപ്പാക്കി;","poem":1},{"text":"ഞാൻ അവർക്ക് പഴഞ്ചൊല്ലായിതീർന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"പട്ടണവാതില്‍ക്കൽ ഇരിക്കുന്നവർ എന്നെക്കുറിച്ച് സംസാരിക്കുന്നു;","poem":1},{"text":"ഞാൻ മദ്യപന്മാരുടെ പാട്ടായിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ഞാനോ യഹോവേ, പ്രസാദകാലത്ത് അങ്ങേയോട് പ്രാർത്ഥിക്കുന്നു;","poem":1},{"text":"ദൈവമേ, അങ്ങേയുടെ ദയയുടെ ബഹുത്വത്താൽ,","poem":2},{"lineBreak":true},{"text":"അങ്ങേയുടെ വിശ്വസ്തതയാൽ തന്നെ, എന്നെ രക്ഷിച്ച് ഉത്തരമരുളേണമേ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ചേറ്റിൽനിന്ന് എന്നെ കയറ്റേണമേ;","poem":1},{"text":"ഞാൻ താണുപോകരുതേ;","poem":2},{"text":"എന്നെ വെറുക്കുന്നവരുടെ കയ്യിൽനിന്നും","poem":1},{"text":"ആഴമുള്ള വെള്ളത്തിൽനിന്നും എന്നെ രക്ഷിക്കേണമേ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ജലപ്രവാഹം എന്‍റെ മീതെ കവിയരുതേ;","poem":1},{"text":"ആഴം എന്നെ വിഴുങ്ങരുതേ;","poem":2},{"lineBreak":true},{"text":"കുഴിയിൽ ഞാൻ അടയ്ക്കപ്പെട്ടുപോകരുതെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"യഹോവേ, എനിക്കുത്തരമരുളേണമേ;","poem":1},{"text":"അങ്ങേയുടെ ദയ നല്ലതല്ലോ;","poem":2},{"text":"അങ്ങേയുടെ കരുണയുടെ ബഹുത്വപ്രകാരം","poem":1},{"text":"എന്നിലേക്ക് തിരിയേണമേ;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അടിയന് തിരുമുഖം മറയ്ക്കരുതേ;","poem":1},{"text":"ഞാൻ കഷ്ടത്തിൽ ഇരിക്കുകയാൽ വേഗത്തിൽ എനിക്ക് ഉത്തരമരുളേണമേ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"എന്‍റെ പ്രാണനോട് അടുത്തുവന്ന് അതിനെ വീണ്ടുകൊള്ളേണമേ;","poem":1},{"text":"എന്‍റെ ശത്രുക്കൾ നിമിത്തം എന്നെ വീണ്ടെടുക്കേണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"എന്‍റെ നിന്ദയും ലജ്ജയും അപമാനവും അവിടുന്ന് അറിയുന്നു;","poem":1},{"text":"എന്‍റെ വൈരികൾ എല്ലാവരും അവിടുത്തെ ദൃഷ്ടിയിൽ ഇരിക്കുന്നു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"നിന്ദ എന്‍റെ ഹൃദയത്തെ തകർത്തു,","poem":1},{"text":"ഞാൻ ഏറ്റവും വിഷാദിച്ചിരിക്കുന്നു;","poem":2},{"text":"ആർക്കെങ്കിലും സഹതാപം തോന്നുമോ എന്നു ഞാൻ നോക്കിക്കൊണ്ടിരുന്നു; ആർക്കും തോന്നിയില്ല;","poem":1},{"text":"ആശ്വസിപ്പിക്കുന്നവരുണ്ടോ എന്നും നോക്കിക്കൊണ്ടിരുന്നു; ആരെയും കണ്ടില്ലതാനും.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അവർ എനിക്ക് തിന്നുവാൻ കൈപ്പ് തന്നു;","poem":1},{"text":"എന്‍റെ ദാഹത്തിന് അവർ എനിക്ക് ചൊറുക്ക കുടിക്കുവാൻ തന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"അവരുടെ സമ്പത്ത് അവരുടെ മുമ്പിൽ കെണിയായും","poem":1},{"noteId":62},{"text":"അവർ സമാധാനത്തോടിരിക്കുമ്പോൾ കുടുക്കായും തീരട്ടെ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"അവരുടെ കണ്ണ് കാണാതവണ്ണം ഇരുണ്ടുപോകട്ടെ;","poem":1},{"text":"അവരുടെ അര എപ്പോഴും വിറയ്ക്കുമാറാകട്ടെ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അവിടുത്തെ ക്രോധം അവരുടെ മേൽ പകരേണമേ;","poem":1},{"text":"അവിടുത്തെ ഉഗ്രകോപം അവരെ പിടിക്കുമാറാകട്ടെ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"അവരുടെ വാസസ്ഥലം ശൂന്യമായിപ്പോകട്ടെ;","poem":1},{"text":"അവരുടെ കൂടാരങ്ങളിൽ ആരും പാർക്കാതിരിക്കട്ടെ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"അങ്ങ് ദണ്ഡിപ്പിച്ചവനെ അവർ വീണ്ടും ഉപദ്രവിക്കുന്നു;","poem":1},{"text":"അവിടുന്ന് മുറിവേല്പിച്ചവരുടെ വേദന അവർ വിവരിക്കുന്നു.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"അവരുടെ അകൃത്യത്തോട് അകൃത്യം കൂട്ടേണമേ;","poem":1},{"text":"അങ്ങേയുടെ നീതി അവർ പ്രാപിക്കരുതേ.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ജീവന്‍റെ പുസ്തകത്തിൽനിന്ന് അവരെ മായിച്ചുകളയേണമേ;","poem":1},{"text":"നീതിമാന്മാരോടുകൂടി അവരെ എഴുതരുതേ.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ഞാനോ എളിയവനും ദുഃഖിതനും ആകുന്നു;","poem":1},{"text":"ദൈവമേ, അങ്ങേയുടെ രക്ഷ എന്നെ ഉയർത്തുമാറാകട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"ഞാൻ പാട്ടോടെ ദൈവത്തിന്‍റെ നാമത്തെ സ്തുതിക്കും;","poem":1},{"text":"സ്തോത്രത്തോടെ അവിടുത്തെ മഹത്വപ്പെടുത്തും.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"അത് യഹോവയ്ക്ക് കാളയെക്കാളും","poem":1},{"text":"കൊമ്പും കുളമ്പും ഉള്ള മൂരിയെക്കാളും പ്രസാദകരമാകും.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"സൗമ്യതയുള്ളവർ അത് കണ്ടു സന്തോഷിക്കും;","poem":1},{"text":"ദൈവത്തെ അന്വേഷിക്കുന്നവരേ, നിങ്ങളുടെ ഹൃദയം ജീവിക്കട്ടെ.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"യഹോവ ദരിദ്രന്മാരുടെ പ്രാർത്ഥന കേൾക്കുന്നു;","poem":1},{"text":"തന്‍റെ ബദ്ധന്മാരെ നിന്ദിക്കുന്നതുമില്ല;","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"ആകാശവും ഭൂമിയും സമുദ്രങ്ങളും","poem":1},{"text":"അവയിൽ ചരിക്കുന്ന സകലവും അവിടുത്തെ സ്തുതിക്കട്ടെ.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ദൈവം സീയോനെ രക്ഷിക്കും; കർത്താവ് യെഹൂദാനഗരങ്ങളെ പണിയും;","poem":1},{"text":"അവർ അവിടെ പാർത്ത് അതിനെ കൈവശമാക്കും.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"അവിടുത്തെ ദാസന്മാരുടെ സന്തതി അതിനെ അവകാശമാക്കും;","poem":1},{"text":"അവിടുത്തെ നാമത്തെ സ്നേഹിക്കുന്നവർ അതിൽ വസിക്കും.","poem":2}]}],"footnotes":[{"noteId":60,"caller":"+","text":"കഴുത്തോളം പ്രാണനോളം","reference":{"chapter":69,"verse":1}},{"noteId":61,"caller":"+","text":"ഞാൻ എന്‍റെ പ്രാണനെ കരച്ചിലാലും ഉപവാസത്താലും താഴ്മയുള്ളവനാക്കി ഞാൻ ഉപവാസത്താല്‍ എന്നേത്തന്നെ താഴ്ത്തി","reference":{"chapter":69,"verse":10}},{"noteId":62,"caller":"+","text":"അവരുടെ സമ്പത്ത് അവരുടെ മുമ്പിൽ കെണിയായും അവര്‍ യാഗത്തിന് ശേഷം ഭക്ഷിച്ച വസ്തുക്കള്‍ അവരുടെ സുഹൃത്തുക്കള്‍ക്ക് കെണിയായും","reference":{"chapter":69,"verse":22}}]},"thisChapterLink":"/api/mal_irv/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}