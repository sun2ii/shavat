{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":71,"content":[{"type":"heading","content":["ഒരു വൃദ്ധന്‍റെ പ്രാർത്ഥന"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"യഹോവേ, ഞാൻ അങ്ങയിൽ ആശ്രയിക്കുന്നു;","poem":1},{"text":"ഞാൻ ഒരുനാളും ലജ്ജിച്ചുപോകരുതേ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അങ്ങേയുടെ നീതിനിമിത്തം എന്നെ ഉദ്ധരിച്ച് വിടുവിക്കേണമേ;","poem":1},{"text":"അങ്ങേയുടെ ചെവി എന്നിലേക്ക് ചായിച്ച് എന്നെ രക്ഷിക്കേണമേ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ഞാൻ എപ്പോഴും വന്ന് പാർക്കേണ്ടതിന്","poem":1},{"text":"അവിടുന്ന് എനിക്ക് ഉറപ്പുള്ള പാറയായിരിക്കേണമേ;","poem":2},{"text":"എന്നെ രക്ഷിക്കുവാൻ അവിടുന്ന് കല്പിച്ചിരിക്കുന്നു;","poem":1},{"text":"അങ്ങ് എന്‍റെ പാറയും എന്‍റെ കോട്ടയും ആകുന്നുവല്ലോ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"എന്‍റെ ദൈവമേ, ദുഷ്ടന്‍റെ കയ്യിൽനിന്നും","poem":1},{"text":"നീതികേടും ക്രൂരതയും ഉള്ളവന്‍റെ കയ്യിൽനിന്നും എന്നെ വിടുവിക്കേണമേ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"യഹോവയായ കർത്താവേ, അവിടുന്ന് എന്‍റെ പ്രത്യാശയാകുന്നു;","poem":1},{"text":"ബാല്യംമുതൽ അവിടുന്ന് എന്‍റെ ആശ്രയം തന്നെ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഗർഭംമുതൽ അവിടുന്ന് എന്നെ താങ്ങിയിരിക്കുന്നു;","poem":1},{"text":"എന്‍റെ അമ്മയുടെ ഉദരത്തിൽനിന്ന് എന്നെ എടുത്തവൻ അങ്ങ് തന്നെ;","poem":2},{"lineBreak":true},{"text":"എന്‍റെ സ്തുതി എപ്പോഴും അങ്ങയെക്കുറിച്ചാകുന്നു;","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ഞാൻ പലർക്കും ഒരത്ഭുതം ആയിരിക്കുന്നു;","poem":1},{"text":"അങ്ങ് എന്‍റെ ബലമുള്ള സങ്കേതമാകുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"എന്‍റെ വായ് അങ്ങേയുടെ സ്തുതികൊണ്ടും","poem":1},{"text":"ഇടവിടാതെ അങ്ങേയുടെ പ്രശംസകൊണ്ടും നിറഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"വാർദ്ധക്യകാലത്ത് അവിടുന്ന് എന്നെ തള്ളിക്കളയരുതേ;","poem":1},{"text":"ബലം ക്ഷയിക്കുമ്പോൾ എന്നെ ഉപേക്ഷിക്കുകയുമരുതേ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"എന്‍റെ ശത്രുക്കൾ എന്നെക്കുറിച്ച് സംസാരിക്കുന്നു;","poem":1},{"text":"എന്‍റെ പ്രാണഹാനിക്കായി കാത്തിരിക്കുന്നവർ ഗൂഢാലോചന നടത്തുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“ദൈവം അവനെ ഉപേക്ഷിച്ചിരിക്കുന്നു; പിന്തുടർന്ന് പിടിക്കുവിൻ;","poem":1},{"text":"വിടുവിക്കുവാൻ ആരുമില്ല” എന്നു അവർ പറയുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ദൈവമേ, എന്നോട് അകന്നിരിക്കരുതേ;","poem":1},{"text":"എന്‍റെ ദൈവമേ, എന്നെ സഹായിക്കുവാൻ വേഗം വരേണമേ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"എന്‍റെ പ്രാണന് വിരോധികളായവർ ലജ്ജിച്ച് നശിച്ചുപോകട്ടെ;","poem":1},{"text":"എനിക്ക് അനർത്ഥം അന്വേഷിക്കുന്നവർ നിന്ദകൊണ്ടും ലജ്ജകൊണ്ടും മൂടിപ്പോകട്ടെ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ഞാൻ എപ്പോഴും പ്രത്യാശിക്കും;","poem":1},{"text":"ഞാൻ മേല്ക്കുമേൽ അങ്ങയെ സ്തുതിക്കും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"എന്‍റെ വായ് ഇടവിടാതെ അവിടുത്തെ നീതിയെയും രക്ഷയെയും വർണ്ണിക്കും;","poem":1},{"text":"അവയുടെ സംഖ്യ എനിക്ക് അറിഞ്ഞുകൂടാ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ഞാൻ യഹോവയായ കർത്താവിന്‍റെ വീര്യപ്രവൃത്തികളോടുകൂടി വരും;","poem":1},{"text":"അങ്ങേയുടെ നീതിയെ മാത്രം ഞാൻ കീർത്തിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ദൈവമേ, എന്‍റെ ബാല്യംമുതൽ അങ്ങ് എന്നെ ഉപദേശിച്ചിരിക്കുന്നു;","poem":1},{"text":"ഇന്നുവരെ ഞാൻ അങ്ങേയുടെ അത്ഭുതപ്രവൃത്തികളെ അറിയിച്ചുമിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ദൈവമേ, അടുത്ത തലമുറയോട് ഞാൻ അങ്ങേയുടെ ഭുജബലത്തെയും","poem":1},{"text":"വരുവാനുള്ള എല്ലാവരോടും അങ്ങേയുടെ വീര്യപ്രവൃത്തിയെയും അറിയിക്കുവോളം","poem":2},{"lineBreak":true},{"text":"വാർദ്ധക്യവും നരയും ഉള്ള കാലത്തും എന്നെ ഉപേക്ഷിക്കരുതേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ദൈവമേ, അവിടുത്തെ നീതിയും അത്യുന്നതമായിരിക്കുന്നു;","poem":1},{"text":"മഹാകാര്യങ്ങൾ പ്രവർത്തിച്ചിട്ടുള്ള ദൈവമേ,","poem":2},{"lineBreak":true},{"text":"അങ്ങേയോട് തുല്യൻ ആരാണുള്ളത്?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"അനവധി കഷ്ടങ്ങളും അനർത്ഥങ്ങളും ഞങ്ങളെ കാണുമാറാക്കിയവനേ,","poem":1},{"text":"അവിടുന്ന് ഞങ്ങളെ വീണ്ടും ജീവിപ്പിക്കും;","poem":2},{"lineBreak":true},{"text":"ഭൂമിയുടെ ആഴങ്ങളിൽനിന്ന് ഞങ്ങളെ തിരികെ കയറ്റും.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"അങ്ങ് എന്‍റെ മഹത്വം വർദ്ധിപ്പിച്ച്","poem":1},{"text":"എന്നെ വീണ്ടും ആശ്വസിപ്പിക്കേണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"എന്‍റെ ദൈവമേ, ഞാൻ വീണകൊണ്ട് അങ്ങയെയും അവിടുത്തെ വിശ്വസ്തതയെയും സ്തുതിക്കും;","poem":1},{"text":"യിസ്രായേലിന്‍റെ പരിശുദ്ധനേ, ഞാൻ കിന്നരം കൊണ്ടു അങ്ങേക്ക് സ്തുതിപാടും.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ഞാൻ അങ്ങേക്ക് സ്തുതി പാടുമ്പോൾ എന്‍റെ അധരങ്ങളും","poem":1},{"text":"അങ്ങ് വീണ്ടെടുത്ത എന്‍റെ പ്രാണനും ഘോഷിച്ചാനന്ദിക്കും.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"എന്‍റെ നാവും ഇടവിടാതെ അങ്ങേയുടെ നീതിയെക്കുറിച്ച് സംസാരിക്കും;","poem":1},{"text":"എനിക്ക് ആപത്ത് അന്വേഷിക്കുന്നവർ ലജ്ജിച്ച് ഭ്രമിച്ചുപോയിരിക്കുന്നു.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}