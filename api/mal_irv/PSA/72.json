{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":72,"content":[{"type":"heading","content":["രാജാവിനുവേണ്ടിയുള്ള പ്രാർത്ഥന"]},{"type":"hebrew_subtitle","content":["ശലമോന്‍റെ ഒരു സങ്കീർത്തനം."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"ദൈവമേ, രാജാവിന് അവിടുത്തെ ന്യായവും","poem":1},{"text":"രാജകുമാരന് അവിടുത്തെ നീതിയും നല്കേണമേ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവൻ അങ്ങേയുടെ ജനത്തെ നീതിയോടും","poem":1},{"text":"അങ്ങേയുടെ എളിയജനത്തെ ന്യായത്തോടും കൂടി പരിപാലിക്കട്ടെ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"നീതിയാൽ പർവ്വതങ്ങളിലും കുന്നുകളിലും","poem":1},{"text":"ജനത്തിന് സമാധാനം വിളയട്ടെ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ജനത്തിലെ എളിയവർക്ക് അവൻ ന്യായം പാലിച്ചുകൊടുക്കട്ടെ;","poem":1},{"text":"ദരിദ്രജനത്തെ അവൻ രക്ഷിക്കുകയും പീഡിപ്പിക്കുന്നവനെ തകർത്തുകളയുകയും ചെയ്യട്ടെ;","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"സൂര്യചന്ദ്രന്മാരുള്ള കാലത്തോളം","poem":1},{"text":"അവന്‍ തലമുറതലമുറയായി ജീവിക്കും","poem":2},{"noteId":63},{"text":".","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അരിഞ്ഞ പുല്പുറത്ത് പെയ്യുന്ന മഴപോലെയും","poem":1},{"text":"ഭൂമിയെ നനയ്ക്കുന്ന വന്മഴപോലെയും അവൻ ഇറങ്ങിവരട്ടെ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവന്‍റെ കാലത്ത് നീതി തഴയ്ക്കട്ടെ","poem":1},{"noteId":64},{"text":";","poem":1},{"text":"ചന്ദ്രനുള്ളേടത്തോളം സമാധാനസമൃദ്ധി ഉണ്ടാകട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"അവൻ സമുദ്രംമുതൽ സമുദ്രംവരെയും","poem":1},{"text":"നദിമുതൽ ഭൂമിയുടെ അറ്റങ്ങൾവരെയും ഭരിക്കട്ടെ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"മരുഭൂമിയിൽ","poem":1},{"noteId":65},{"text":"വസിക്കുന്നവർ അവന്‍റെ മുമ്പിൽ വണങ്ങട്ടെ;","poem":1},{"text":"അവന്‍റെ ശത്രുക്കൾ നിലത്തെ പൊടിമണ്ണ് നക്കട്ടെ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"തർശ്ശീശിലെയും ദ്വീപുകളിലെയും രാജാക്കന്മാർ കാഴ്ച കൊണ്ടുവരട്ടെ;","poem":1},{"text":"ശെബയിലെയും സെബയിലെയും രാജാക്കന്മാർ കപ്പം കൊടുക്കട്ടെ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"സകലരാജാക്കന്മാരും അവനെ നമസ്കരിക്കട്ടെ;","poem":1},{"text":"സകലജനതകളും അവനെ സേവിക്കട്ടെ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"അവൻ നിലവിളിക്കുന്ന ദരിദ്രനെയും","poem":1},{"text":"സഹായമില്ലാത്ത എളിയവനെയും രക്ഷിക്കുമല്ലോ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"എളിയവനെയും ദരിദ്രനെയും അവൻ ആദരിക്കും;","poem":1},{"text":"ദരിദ്രന്മാരുടെ ജീവനെ അവൻ രക്ഷിക്കും.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"അവരുടെ പ്രാണനെ അവൻ പീഡയിൽ നിന്നും സാഹസത്തിൽനിന്നും വീണ്ടെടുക്കും;","poem":1},{"text":"അവരുടെ പ്രാണന്‍","poem":2},{"noteId":66},{"text":"അവന് വിലയേറിയതായിരിക്കും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവൻ ജീവിച്ചിരിക്കും; ശെബയിൽ നിന്നുള്ള പൊന്ന് അവന് കാഴ്ചയായി കൊണ്ടു വരും;","poem":1},{"text":"അവനുവേണ്ടി എപ്പോഴും പ്രാർത്ഥന കഴിക്കും;","poem":2},{"lineBreak":true},{"text":"ഇടവിടാതെ അവനെ അനുഗ്രഹിക്കും.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ദേശത്ത് പർവ്വതങ്ങളുടെ മുകളിൽ ധാന്യസമൃദ്ധിയുണ്ടാകും;","poem":1},{"text":"അതിന്‍റെ വിളവ് ലെബാനോനെപ്പോലെ ഉലയും;","poem":2},{"lineBreak":true},{"text":"നഗരവാസികൾ ഭൂമിയിലെ സസ്യംപോലെ തഴയ്ക്കും.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവന്‍റെ നാമം എന്നേക്കും നിലനില്ക്കും;","poem":1},{"text":"അവന്‍റെ നാമം സൂര്യൻ ഉള്ളിടത്തോളം നിലനില്ക്കും;","poem":2},{"text":"മനുഷ്യർ അവന്‍റെ പേര് ചൊല്ലി അന്യോന്യം അനുഗ്രഹിക്കും;","poem":1},{"text":"സകലജാതികളും അവനെ ‘ഭാഗ്യവാൻ’ എന്നു പറയും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"താൻ മാത്രം അത്ഭുതങ്ങൾ ചെയ്യുന്നവനായി","poem":1},{"text":"യിസ്രായേലിന്‍റെ ദൈവമായി യഹോവയായ ദൈവം വാഴ്ത്തപ്പെടുമാറാകട്ടെ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അവിടുത്തെ മഹത്വമുള്ള നാമം എന്നേക്കും വാഴ്ത്തപ്പെടുമാറാകട്ടെ;","poem":1},{"text":"ഭൂമി മുഴുവനും അവിടുത്തെ മഹത്വംകൊണ്ട് നിറയുമാറാകട്ടെ. ആമേൻ, ആമേൻ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"യിശ്ശായിയുടെ പുത്രനായ ദാവീദിന്‍റെ പ്രാർത്ഥനകൾ അവസാനിച്ചിരിക്കുന്നു.","poem":1}]}],"footnotes":[{"noteId":63,"caller":"+","text":"സൂര്യചന്ദ്രന്മാരുള്ള കാലത്തോളം അവന്‍ തലമുറതലമുറയായി ജീവിക്കും സൂര്യചന്ദ്രന്മാരുള്ള കാലത്തോളം അവർ തലമുറതലമുറയായി നിന്നെ ഭയപ്പെടട്ടെ","reference":{"chapter":72,"verse":5}},{"noteId":64,"caller":"+","text":"നീതി തഴയ്ക്കട്ടെ നീതിമാന്മാർ തഴയ്ക്കട്ടെ","reference":{"chapter":72,"verse":7}},{"noteId":65,"caller":"+","text":"മരുഭൂമിയിൽ അവന്‍റെ ശത്രുക്കള്‍","reference":{"chapter":72,"verse":9}},{"noteId":66,"caller":"+","text":"അവരുടെ പ്രാണന്‍ അവരുടെ രക്തം","reference":{"chapter":72,"verse":14}}]},"thisChapterLink":"/api/mal_irv/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}