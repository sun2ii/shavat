{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":73,"content":[{"type":"heading","content":["ദൈവത്തിന്‍റെ നീതി"]},{"type":"hebrew_subtitle","content":["ആസാഫിന്‍റെ ഒരു സങ്കീർത്തനം."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"ദൈവം യിസ്രായേലിനു, നിർമ്മലഹൃദയം ഉള്ളവർക്ക് തന്നെ,","poem":1},{"text":"നിശ്ചയമായും നല്ലവൻ ആകുന്നു.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"എന്നാൽ എന്‍റെ കാലുകൾ ഏകദേശം ഇടറി;","poem":1},{"text":"എന്‍റെ കാലടികൾ ഏറെക്കുറെ വഴുതിപ്പോയി.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ദുഷ്ടന്മാരുടെ സമൃദ്ധി കണ്ടിട്ട്","poem":1},{"text":"എനിക്ക് അഹങ്കാരികളോട് അസൂയ തോന്നി.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"അവർക്ക് ജീവപര്യന്തം വേദന ഒട്ടുമില്ല;","poem":1},{"text":"അവരുടെ ദേഹം തടിച്ചുകൊഴുത്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവർ മർത്യരെപ്പോലെ കഷ്ടത്തിൽ ആകുന്നില്ല;","poem":1},{"text":"മറ്റു മനുഷ്യരെപ്പോലെ രോഗത്താൽ ബാധിക്കപ്പെടുന്നതുമില്ല.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അതിനാൽ ഡംഭം അവർക്ക് മാലയായിരിക്കുന്നു;","poem":1},{"text":"ബലാല്ക്കാരം വസ്ത്രംപോലെ അവരെ ചുറ്റിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവരുടെ കണ്ണുകൾ പുഷ്ടികൊണ്ട് ഉന്തിനില്ക്കുന്നു;","poem":1},{"text":"അവരുടെ ഹൃദയത്തിലെ ഭോഷത്തമായ നിരൂപണങ്ങൾ കവിഞ്ഞൊഴുകുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവർ പരിഹസിച്ച് ദുഷ്ടതയോടെ ഭീഷണി പറയുന്നു;","poem":1},{"text":"ഉന്നതഭാവത്തോടെ സംസാരിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"അവർ വായ് ആകാശത്തോളം ഉയർത്തുന്നു;","poem":1},{"text":"അവരുടെ നാവ് ഭൂമിയിൽ സഞ്ചരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"അതുകൊണ്ട് അവൻ തന്‍റെ ജനത്തെ ഇവിടേക്ക് കൊണ്ടുവരുന്നു.","poem":1},{"text":"അവർ അവരില്‍ ഒരു കുറ്റവും കാണുന്നില്ല","poem":2},{"noteId":67},{"text":".","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“ദൈവം എങ്ങനെ അറിയുന്നു?","poem":1},{"text":"അത്യുന്നതന് അറിവുണ്ടോ?” എന്നു അവർ പറയുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ഇങ്ങനെ ആകുന്നു ദുഷ്ടന്മാർ;","poem":1},{"text":"അവർ നിരന്തരം സ്വസ്ഥത അനുഭവിച്ച് സമ്പത്ത് വർദ്ധിപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ആകയാൽ ഞാൻ എന്‍റെ ഹൃദയത്തെ ശുദ്ധീകരിച്ചതും","poem":1},{"text":"എന്‍റെ കൈകൾ നിഷ്ക്കളങ്കതയിൽ കഴുകിയതും വ്യർത്ഥമത്രേ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ഞാൻ ദിവസം മുഴുവൻ ബാധിതനായിരുന്നു;","poem":1},{"text":"ഉഷസ്സുതോറും ദണ്ഡിക്കപ്പെട്ടും ഇരുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ഞാൻ ഇപ്രകാരം സംസാരിക്കുവാൻ വിചാരിച്ചെങ്കിൽ,","poem":1},{"text":"നിന്‍റെ മക്കളുടെ തലമുറയോട് ദ്രോഹം ചെയ്യുമായിരുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ഞാൻ ഇത് സ്വയം ഗ്രഹിക്കുവാൻ നിരൂപിച്ചപ്പോൾ","poem":1},{"text":"എനിക്ക് പ്രയാസമായി തോന്നി;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ഒടുവിൽ ഞാൻ ദൈവത്തിന്‍റെ വിശുദ്ധമന്ദിരത്തിൽ ചെന്നു","poem":1},{"text":"അവരുടെ അന്ത്യം എന്താകും എന്നു ചിന്തിച്ചു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"നിശ്ചയമായും അവിടുന്ന് അവരെ വഴുവഴുപ്പിൽ നിർത്തുന്നു;","poem":1},{"text":"അവിടുന്ന് അവരെ നാശത്തിൽ തള്ളിയിടുന്നു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"എത്ര ക്ഷണത്തിൽ അവർ ശൂന്യമായിപ്പോയി!","poem":1},{"text":"അവർ ഭയാനകമായ കാര്യങ്ങളാൽ അശേഷം മുടിഞ്ഞുപോയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ഉണരുമ്പോൾ ഒരു സ്വപ്നംപോലെ, കർത്താവേ,","poem":1},{"text":"അവർ ഉണരുമ്പോൾ അവിടുന്ന് അവരുടെ രൂപത്തെ തുച്ഛീകരിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ഇങ്ങനെ എന്‍റെ ഹൃദയം വ്യസനിക്കുകയും","poem":1},{"text":"എന്‍റെ അന്തരംഗത്തിൽ കുത്തുകൊള്ളുകയും ചെയ്തപ്പോൾ","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ഞാൻ ഭോഷനും ഒന്നും അറിയാത്തവനും ആയിരുന്നു;","poem":1},{"text":"അങ്ങേയുടെ മുമ്പിൽ മൃഗംപോലെ ആയിരുന്നു.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"എങ്കിലും ഞാൻ ഇപ്പോഴും അങ്ങേയുടെ അടുക്കൽ ഇരിക്കുന്നു;","poem":1},{"text":"അവിടുന്ന് എന്നെ വലങ്കൈയ്ക്ക് പിടിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അങ്ങേയുടെ ആലോചനയാൽ അങ്ങ് എന്നെ നടത്തും;","poem":1},{"text":"പിന്നത്തേതിൽ മഹത്വത്തിലേക്ക് എന്നെ കൈക്കൊള്ളും.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"സ്വർഗ്ഗത്തിൽ അങ്ങ് ഒഴികെ എനിക്ക് ആരാണുള്ളത്?","poem":1},{"text":"ഭൂമിയിലും അങ്ങയെയല്ലാതെ ഞാൻ ഒന്നും ആഗ്രഹിക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"എന്‍റെ മാംസവും ഹൃദയവും ക്ഷയിച്ചുപോകുന്നു;","poem":1},{"text":"ദൈവം എന്നേക്കും എന്‍റെ ഹൃദയത്തിന്‍റെ ശക്തിയും എന്‍റെ ഓഹരിയും ആകുന്നു","poem":2},{"noteId":68},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ഇതാ, അങ്ങേയോട് അകന്നിരിക്കുന്നവർ നശിച്ചുപോകും;","poem":1},{"text":"അങ്ങയെ വിട്ട് പരസംഗം ചെയ്യുന്ന എല്ലാവരെയും അവിടുന്ന് സംഹരിക്കും.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"എന്നാൽ ദൈവത്തോട് അടുത്തിരിക്കുന്നത് എനിക്ക് നല്ലത്;","poem":1},{"text":"അവിടുത്തെ സകലപ്രവൃത്തികളെയും വർണ്ണിക്കേണ്ടതിന്","poem":2},{"lineBreak":true},{"text":"ഞാൻ യഹോവയായ കർത്താവിനെ എന്‍റെ സങ്കേതമാക്കിയിരിക്കുന്നു.","poem":2}]}],"footnotes":[{"noteId":67,"caller":"+","text":"അവർ അവരില്‍ ഒരു കുറ്റവും കാണുന്നില്ല അവർ ധാരാളം വെള്ളം വലിച്ചുകുടിക്കുന്നു","reference":{"chapter":73,"verse":10}},{"noteId":68,"caller":"+","text":"ദൈവം എന്നേക്കും എന്‍റെ ഹൃദയത്തിന്‍റെ ശക്തിയും എന്‍റെ ഓഹരിയും ആകുന്നു ദൈവം എന്നേക്കും എന്‍റെ ഹൃദയത്തിന്‍റെ പാറയും എന്‍റെ ഓഹരിയും ആകുന്നു","reference":{"chapter":73,"verse":26}}]},"thisChapterLink":"/api/mal_irv/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}