{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":74,"content":[{"type":"heading","content":["ദൈവാലയനാശത്തെക്കുറിച്ചുള്ള വിലാപം"]},{"type":"hebrew_subtitle","content":["ആസാഫിന്‍റെ ഒരു ധ്യാനം."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"ദൈവമേ, അങ്ങ് ഞങ്ങളെ സദാകാലത്തേക്കും തള്ളിക്കളഞ്ഞത് എന്ത്?","poem":1},{"text":"അങ്ങേയുടെ മേച്ചില്പുറത്തെ ആടുകളുടെ നേരെ അവിടുത്തെ കോപം പുകയുന്നത് എന്ത്?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അങ്ങ് പണ്ടുപണ്ടേ സമ്പാദിച്ച അവിടുത്തെ സഭയെയും","poem":1},{"text":"അങ്ങ് വീണ്ടെടുത്ത അവിടുത്തെ അവകാശഗോത്രത്തെയും","poem":2},{"lineBreak":true},{"text":"അങ്ങ് വസിച്ചിരുന്ന സീയോൻ പർവ്വതത്തെയും ഓർക്കേണമേ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"നിത്യശൂന്യങ്ങളിലേക്ക് അങ്ങേയുടെ കാലടി വെക്കേണമേ;","poem":1},{"text":"ശത്രു വിശുദ്ധമന്ദിരത്തിൽ സകലവും നശിപ്പിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"അങ്ങേയുടെ വൈരികൾ അങ്ങേയുടെ സമാഗമന സ്ഥലത്തിന്‍റെ നടുവിൽ അലറുന്നു;","poem":1},{"text":"അവരുടെ കൊടികൾ അവർ അടയാളങ്ങളായി നാട്ടിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവർ മരക്കൂട്ടത്തിന്മേൽ","poem":1},{"text":"കോടാലി ഓങ്ങുന്നതുപോലെ തോന്നി.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഇതാ, അവർ മഴുകൊണ്ടും ചുറ്റിക കൊണ്ടും","poem":1},{"text":"അതിന്‍റെ ചിത്രപ്പണികൾ മുഴുവനും തകർത്തുകളയുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവർ അങ്ങേയുടെ വിശുദ്ധമന്ദിരം തീവച്ചു;","poem":1},{"text":"തിരുനാമത്തിന്‍റെ നിവാസത്തെ അവർ ഇടിച്ചുനിരത്തി അശുദ്ധമാക്കി.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“നാം അവരെ നശിപ്പിച്ചുകളയുക” എന്നു അവരുടെ ഹൃദയത്തിൽ പറഞ്ഞു,","poem":1},{"text":"ദേശത്തിൽ ദൈവത്തിന്‍റെ ആലയങ്ങളെല്ലാം ചുട്ടുകളഞ്ഞു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ഞങ്ങൾ ഒരു അടയാളവും കാണുന്നില്ല;","poem":1},{"text":"യാതൊരു പ്രവാചകനും ശേഷിച്ചിട്ടില്ല;","poem":2},{"lineBreak":true},{"text":"ഇത് എത്രത്തോളം എന്നറിയുന്നവൻ ആരും ഞങ്ങളുടെ ഇടയിൽ ഇല്ല.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ദൈവമേ, വൈരി എത്രത്തോളം നിന്ദിക്കും?","poem":1},{"text":"ശത്രു അവിടുത്തെ നാമത്തെ എന്നേക്കും ദുഷിക്കുമോ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അവിടുത്തെ കൈ, അങ്ങേയുടെ വലങ്കൈ അവിടുന്ന് പിൻവലിച്ചുകളയുന്നത് എന്ത്?","poem":1},{"text":"അങ്ങേയുടെ മാറിൽ നിന്ന് അത് എടുത്ത് അവരെ നശിപ്പിക്കേണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ദൈവം പുരാതനമേ എന്‍റെ രാജാവാകുന്നു;","poem":1},{"text":"ഭൂമിയുടെ മദ്ധ്യത്തിൽ അവിടുന്ന് രക്ഷ പ്രവർത്തിക്കുന്നു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അങ്ങേയുടെ ശക്തികൊണ്ട് അവിടുന്ന് സമുദ്രത്തെ വിഭാഗിച്ചു;","poem":1},{"text":"വെള്ളത്തിലുള്ള തിമിംഗലങ്ങളുടെ തല ഉടച്ചുകളഞ്ഞു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ലിവ്യാഥാന്‍റെ","poem":1},{"noteId":69},{"text":"തലകളെ അവിടുന്ന് തകർത്തു;","poem":1},{"text":"മരുഭൂവാസികളായ ജീവികൾക്ക്","poem":2},{"noteId":70},{"text":"അതിനെ ആഹാരമായി കൊടുത്തു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അങ്ങ് ഉറവും ഒഴുക്കും തുറന്നുവിട്ടു,","poem":1},{"text":"മഹാനദികളെ അങ്ങ് വറ്റിച്ചുകളഞ്ഞു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"പകൽ നിനക്കുള്ളത്; രാവും അങ്ങേക്കുള്ളത്;","poem":1},{"text":"വെളിച്ചത്തെയും സൂര്യനെയും അവിടുന്ന് ഉണ്ടാക്കിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ഭൂസീമകൾ എല്ലാം അവിടുന്ന് സ്ഥാപിച്ചു;","poem":1},{"text":"അങ്ങ് ഉഷ്ണകാലവും ശീതകാലവും നിയമിച്ചു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"യഹോവേ, ശത്രു നിന്ദിച്ചതും","poem":1},{"text":"മൂഢജനത തിരുനാമത്തെ ദുഷിച്ചതും ഓർക്കേണമേ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അങ്ങേയുടെ കുറുപ്രാവിനെ ദുഷ്ടമൃഗത്തിന് ഏല്പിക്കരുതേ;","poem":1},{"text":"അങ്ങേയുടെ എളിയവരുടെ ജീവനെ എന്നേക്കും മറക്കരുതേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"അങ്ങേയുടെ നിയമത്തെ മാനിക്കേണമേ;","poem":1},{"text":"ഭൂമിയിലെ അന്ധകാരസ്ഥലങ്ങൾ സാഹസനിവാസങ്ങൾകൊണ്ട് നിറഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"പീഡിതൻ ലജ്ജിച്ച് പിന്തിരിയരുതേ;","poem":1},{"text":"എളിയവനും ദരിദ്രനും തിരുനാമത്തെ സ്തുതിക്കട്ടെ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ദൈവമേ, എഴുന്നേറ്റ് അങ്ങേയുടെ വ്യവഹാരം നടത്തേണമേ;","poem":1},{"text":"മൂഢൻ ഇടവിടാതെ അങ്ങയെ നിന്ദിക്കുന്നത് ഓർക്കേണമേ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"അങ്ങേയുടെ വൈരികളുടെ ആരവം മറക്കരുതേ;","poem":1},{"text":"അങ്ങേയുടെ എതിരാളികളുടെ കലഹം എപ്പോഴും വർദ്ധിച്ചുകൊണ്ടിരിക്കുന്നു.","poem":2}]}],"footnotes":[{"noteId":69,"caller":"+","text":"ലിവ്യാഥാന്‍റെ ലിവ്യാഥാന്‍-പുരാണത്തിലെ വ്യാളി. വിവിധ തലകളുള്ളതായി കരുതുന്നു. ഉഗ്ര കടല്‍പ്പാമ്പുകള്‍ അല്ലെങ്കില്‍ കടലിലെ വലിയ ജീവികള്‍. സങ്കീ 104:26, യെശ 27:1 നോക്കുക.","reference":{"chapter":74,"verse":14}},{"noteId":70,"caller":"+","text":"മരുഭൂവാസികളായ ജീവികൾക്ക് മരുഭൂവാസികളായ ജനങ്ങള്‍ക്ക്","reference":{"chapter":74,"verse":14}}]},"thisChapterLink":"/api/mal_irv/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}