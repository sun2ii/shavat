{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":78,"content":[{"type":"heading","content":["ദൈവവും അങ്ങേയുടെ ജനവും"]},{"type":"hebrew_subtitle","content":["ആസാഫിന്‍റെ ഒരു ധ്യാനം."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"എന്‍റെ ജനമേ, എന്‍റെ ഉപദേശം ശ്രദ്ധിക്കുവിൻ;","poem":1},{"text":"എന്‍റെ വായിലെ മൊഴികൾക്ക് നിങ്ങളുടെ ചെവി ചായിക്കുവിൻ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ഞാൻ ഉപമ പ്രസ്താവിക്കുവാൻ വായ് തുറക്കും;","poem":1},{"text":"പുരാതനകടങ്കഥകളെ ഞാൻ പറയും.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"നാം അവയെ കേട്ടറിഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"നമ്മുടെ പിതാക്കന്മാർ നമ്മളോട് പറഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"നാം നമ്മുടെ മക്കളോട് അവയെ മറച്ചുവയ്ക്കാതെ","poem":1},{"text":"വരുവാനുള്ള തലമുറയോട് യഹോവയുടെ സ്തുതിയും ബലവും","poem":2},{"lineBreak":true},{"text":"കർത്താവ് ചെയ്ത അത്ഭുതപ്രവൃത്തികളും വിവരിച്ചുപറയും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ദൈവം യാക്കോബിൽ ഒരു സാക്ഷ്യം സ്ഥാപിച്ചു;","poem":1},{"text":"യിസ്രായേലിൽ ഒരു ന്യായപ്രമാണം നിയമിച്ചു;","poem":2},{"text":"അവയെ അവരുടെ മക്കളെ അറിയിക്കുവാൻ","poem":1},{"text":"നമ്മുടെ പിതാക്കന്മാരോട് കല്പിച്ചു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"വരുവാനുള്ള തലമുറ, ജനിക്കുവാനിരിക്കുന്ന മക്കൾതന്നെ,","poem":1},{"text":"അവയെ ഗ്രഹിക്കുകയും എഴുന്നേറ്റ് തങ്ങളുടെ മക്കളോട് അറിയിക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അവർ അവരുടെ ആശ്രയം ദൈവത്തിൽ വയ്ക്കുകയും","poem":1},{"text":"അവിടുത്തെ പ്രവൃത്തികളെ മറന്നുകളയാതെ","poem":2},{"lineBreak":true},{"text":"അവിടുത്തെ കല്പനകൾ പ്രമാണിച്ചു നടക്കുകയും","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അവരുടെ പിതാക്കന്മാരെപോലെ","poem":1},{"text":"ശാഠ്യവും മത്സരവും ഉള്ള തലമുറയായി","poem":2},{"text":"ഹൃദയത്തെ സ്ഥിരമാക്കാതെ,","poem":1},{"text":"ദൈവത്തോട് അവിശ്വസ്തമനസ്സുള്ള ഒരു തലമുറയായി തീരാതിരിക്കുകയും ചെയ്യേണ്ടതിന് തന്നെ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ആയുധം ധരിച്ച വില്ലാളികളായ എഫ്രയീമ്യർ","poem":1},{"text":"യുദ്ധദിവസത്തിൽ പിന്തിരിഞ്ഞുപോയി.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവർ ദൈവത്തിന്‍റെ നിയമം പ്രമാണിച്ചില്ല;","poem":1},{"text":"കർത്താവിന്‍റെ ന്യായപ്രമാണം ഉപേക്ഷിച്ചു നടന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അവർ ദൈവത്തിന്‍റെ പ്രവൃത്തികളും","poem":1},{"text":"അവരെ കാണിച്ച അത്ഭുതങ്ങളും മറന്നുകളഞ്ഞു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"കർത്താവ് മിസ്രയീം ദേശത്ത്, സോവാൻ വയലിൽവച്ച്","poem":1},{"text":"അവരുടെ പൂര്‍വ്വ പിതാക്കന്മാരുടെ കൺമുമ്പിൽ, അത്ഭുതം പ്രവർത്തിച്ചു.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ദൈവം സമുദ്രത്തെ വിഭാഗിച്ച്, അതിൽകൂടി അവരെ കടത്തി;","poem":1},{"text":"കർത്താവ് വെള്ളത്തെ ചിറപോലെ നില്‍ക്കുമാറാക്കി.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"പകൽ സമയത്ത് അവിടുന്ന് മേഘംകൊണ്ടും","poem":1},{"text":"രാത്രിമുഴുവനും അഗ്നിപ്രകാശംകൊണ്ടും അവരെ നടത്തി.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ദൈവം മരുഭൂമിയിൽ പാറകളെ പിളർന്നു","poem":1},{"text":"ആഴികളാൽ എന്നപോലെ അവർക്ക് ധാരാളം കുടിക്കുവാൻ കൊടുത്തു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"പാറയിൽനിന്ന് അവിടുന്ന് അരുവികളെ പുറപ്പെടുവിച്ചു;","poem":1},{"text":"വെള്ളം നദികളെപ്പോലെ ഒഴുകുമാറാക്കി.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"എങ്കിലും അവർ കർത്താവിനോട് പാപംചെയ്തു;","poem":1},{"text":"അത്യുന്നതനോട് മരുഭൂമിയിൽവച്ച് മത്സരിച്ചുകൊണ്ടിരുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അവർ കൊതിക്കുന്ന ഭക്ഷണം ചോദിച്ചു കൊണ്ടു","poem":1},{"text":"അവർ ഹൃദയത്തിൽ ദൈവത്തെ പരീക്ഷിച്ചു.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"അവർ ദൈവത്തിനു വിരോധമായി സംസാരിച്ചു:","poem":1},{"text":"“മരുഭൂമിയിൽ മേശ ഒരുക്കുവാൻ ദൈവത്തിനു കഴിയുമോ?”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ദൈവം പാറയെ അടിച്ചു, വെള്ളം പുറപ്പെട്ടു,","poem":1},{"text":"തോടുകളും കവിഞ്ഞൊഴുകി, സത്യം;","poem":2},{"text":"“എന്നാൽ അപ്പംകൂടി തരുവാൻ ദൈവത്തിന് കഴിയുമോ?","poem":1},{"text":"തന്‍റെ ജനത്തിന് ദൈവം മാംസം വരുത്തി കൊടുക്കുമോ?” എന്നു പറഞ്ഞു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ആകയാൽ യഹോവ അത് കേട്ടു കോപിച്ചു;","poem":1},{"text":"യാക്കോബിന്‍റെ നേരെ തീ ജ്വലിച്ചു;","poem":2},{"lineBreak":true},{"text":"യിസ്രായേലിന്‍റെ നേരെ കോപവും പൊങ്ങി.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"അവർ ദൈവത്തിൽ വിശ്വസിക്കുകയും","poem":1},{"text":"കർത്താവിന്‍റെ രക്ഷയിൽ ആശ്രയിക്കുകയും ചെയ്യായ്കയാൽ തന്നെ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"അവിടുന്ന് മീതെ മേഘങ്ങളോടു കല്പിച്ചു;","poem":1},{"text":"ആകാശത്തിന്‍റെ വാതിലുകളെ തുറന്നു.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"അവർക്ക് തിന്നുവാൻ മന്ന വർഷിപ്പിച്ചു;","poem":1},{"text":"സ്വർഗ്ഗീയധാന്യം അവർക്ക് കൊടുത്തു.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"മനുഷ്യർ ദൂതന്മാരുടെ അപ്പം തിന്നു;","poem":1},{"text":"കർത്താവ് അവർക്ക് തൃപ്തിയാകുംവണ്ണം ആഹാരം അയച്ചു.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ദൈവം ആകാശത്തിൽ കിഴക്കൻകാറ്റ് അടിപ്പിച്ചു;","poem":1},{"text":"തന്‍റെ ശക്തിയാൽ കിഴക്കൻ കാറ്റുവരുത്തി.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ദൈവം അവർക്ക് പൊടിപോലെ മാംസത്തെയും","poem":1},{"text":"കടൽപുറത്തെ മണൽപോലെ പക്ഷികളെയും വർഷിപ്പിച്ചു;","poem":2}]},{"type":"verse","number":28,"content":[{"text":"അവരുടെ പാളയത്തിന്‍റെ നടുവിലും","poem":1},{"text":"പാർപ്പിടങ്ങളുടെ ചുറ്റിലും അവയെ പൊഴിച്ചു.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"അങ്ങനെ അവർ തിന്ന് തൃപ്തരായി.","poem":1},{"text":"അവർ ആഗ്രഹിച്ചത് അവിടുന്ന് അവർക്ക് കൊടുത്തു.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"അവരുടെ കൊതിക്കു മതിവന്നില്ല;","poem":1},{"text":"ഭക്ഷണം അവരുടെ വായിൽ ഇരിക്കുമ്പോൾ തന്നെ,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ദൈവത്തിന്‍റെ കോപം അവരുടെ മേൽ വന്നു;","poem":1},{"text":"അവരുടെ അതിശക്തന്മാരിൽ ചിലരെ കൊന്നു","poem":2},{"lineBreak":true},{"text":"യിസ്രായേലിലെ യൗവനക്കാരെ സംഹരിച്ചു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"ഇതെല്ലാമായിട്ടും അവർ പിന്നെയും പാപംചെയ്തു;","poem":1},{"text":"ദൈവത്തിന്‍റെ അത്ഭുതപ്രവൃത്തികളെ വിശ്വസിച്ചതുമില്ല.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"അതുകൊണ്ട് ദൈവം അവരുടെ നാളുകളെ ശ്വാസം പോലെയും","poem":1},{"text":"അവരുടെ സംവത്സരങ്ങളെ അതിവേഗത്തിലും കഴിയുമാറാക്കി.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ദൈവം അവരെ കൊല്ലുമ്പോൾ അവർ ദൈവത്തെ അന്വേഷിക്കും;","poem":1},{"text":"അവർ തിരിഞ്ഞ് ജാഗ്രതയോടെ ദൈവത്തെ തിരയും.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ദൈവം അവരുടെ പാറ എന്നും","poem":1},{"text":"അത്യുന്നതനായ ദൈവം അവരുടെ വീണ്ടെടുപ്പുകാരൻ എന്നും അവർ ഓർക്കും.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"എങ്കിലും അവർ വായ്കൊണ്ട് ദൈവത്തോട് കപടം സംസാരിക്കും","poem":1},{"text":"നാവുകൊണ്ട് ദൈവത്തോട് ഭോഷ്ക് പറയും.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"അവരുടെ ഹൃദയം ദൈവത്തിൽ സ്ഥിരമായിരുന്നില്ല;","poem":1},{"text":"കർത്താവിന്‍റെ നിയമത്തോട് അവർ വിശ്വസ്തത കാണിച്ചതുമില്ല.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"എങ്കിലും ദൈവം കരുണയുള്ളവനാകുകകൊണ്ട്","poem":1},{"text":"അവരെ നശിപ്പിക്കാതെ അവരുടെ അകൃത്യം ക്ഷമിച്ചു;","poem":2},{"text":"തന്‍റെ ക്രോധം മുഴുവനും ജ്വലിപ്പിക്കാതെ","poem":1},{"text":"തന്‍റെ കോപം പലപ്പോഴും അടക്കിക്കളഞ്ഞു.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"അവർ കേവലം ജഡം അത്രേ എന്നും","poem":1},{"text":"മടങ്ങിവരാതെ കടന്നുപോകുന്ന കാറ്റുപോലെ എന്നും കർത്താവ് ഓർത്തു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"മരുഭൂമിയിൽ അവർ എത്ര തവണ ദൈവത്തോട് മത്സരിച്ചു!","poem":1},{"text":"ശൂന്യദേശത്ത് എത്ര പ്രാവശ്യം ദൈവത്തെ ദുഃഖിപ്പിച്ചു!","poem":2}]},{"type":"verse","number":41,"content":[{"text":"അവർ വീണ്ടുംവീണ്ടും ദൈവത്തെ പരീക്ഷിച്ചു;","poem":1},{"text":"യിസ്രായേലിന്‍റെ പരിശുദ്ധനെ ദൈവത്തെ മുഷിപ്പിച്ചു.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"മിസ്രയീമിൽ അടയാളങ്ങളും","poem":1},{"text":"സോവാൻവയലിൽ അത്ഭുതങ്ങളും ചെയ്ത അവിടുത്തെ കയ്യും","poem":2}]},{"type":"verse","number":43,"content":[{"text":"കർത്താവ് ശത്രുവിന്‍റെ കയ്യിൽനിന്ന്","poem":1},{"text":"അവരെ വിടുവിച്ച ദിവസവും അവർ ഓർമ്മിച്ചില്ല.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"ദൈവം അവരുടെ നദികളെയും തോടുകളെയും","poem":1},{"text":"അവർക്ക് കുടിക്കുവാൻ കഴിയാത്തവിധം രക്തമാക്കിത്തീർത്തു.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"ദൈവം അവരുടെ ഇടയിൽ ഈച്ചയെ അയച്ചു;","poem":1},{"text":"അവ അവരെ അരിച്ചുകളഞ്ഞു: തവളയെയും അയച്ചു അവ അവർക്ക് നാശം ചെയ്തു.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"അവരുടെ വിള അവിടുന്ന് തുള്ളനും","poem":1},{"text":"അവരുടെ പ്രയത്നം വെട്ടുക്കിളിക്കും കൊടുത്തു.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"ദൈവം അവരുടെ മുന്തിരിവള്ളികളെ കന്മഴകൊണ്ടും","poem":1},{"text":"അവരുടെ കാട്ടത്തിവൃക്ഷങ്ങളെ ആലിപ്പഴം കൊണ്ടും നശിപ്പിച്ചു.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"ദൈവം അവരുടെ കന്നുകാലികളെ കന്മഴക്കും","poem":1},{"text":"അവരുടെ ആട്ടിൻകൂട്ടങ്ങളെ ഇടിത്തീയ്ക്കും ഏല്പിച്ചു.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"ദൈവം അവരുടെ ഇടയിൽ തന്‍റെ കോപാഗ്നിയും","poem":1},{"text":"ക്രോധവും രോഷവും കഷ്ടവും അയച്ചു;","poem":2},{"text":"അനർത്ഥദൂതന്മാരുടെ ഒരു ഗണത്തെ തന്നെ.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"ദൈവം തന്‍റെ കോപത്തിന് ഒരു പാത ഒരുക്കി,","poem":1},{"text":"അവരുടെ പ്രാണനെ മരണത്തിൽനിന്നു വിടുവിക്കാതെ","poem":2},{"lineBreak":true},{"text":"അവരുടെ ജീവനെ മഹാവ്യാധിക്ക് ഏല്പിച്ചുകളഞ്ഞു.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"ദൈവം മിസ്രയീമിലെ എല്ലാ കടിഞ്ഞൂലിനെയും","poem":1},{"text":"ഹാമിന്‍റെ","poem":2},{"noteId":77},{"text":"കൂടാരങ്ങളിലുള്ളവരുടെ വീര്യത്തിന്‍റെ ആദ്യഫലത്തെയും സംഹരിച്ചു.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"എന്നാൽ തന്‍റെ ജനത്തെ ദൈവം ആടുകളെപ്പോലെ പുറപ്പെടുവിച്ചു;","poem":1},{"text":"മരുഭൂമിയിൽ ആട്ടിൻകൂട്ടത്തെപ്പോലെ അവരെ നടത്തി.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"ദൈവം അവരെ നിർഭയമായി നടത്തുകയാൽ അവർക്ക് ഭയമുണ്ടായില്ല;","poem":1},{"text":"അവരുടെ ശത്രുക്കളെ സമുദ്രം മൂടിക്കളഞ്ഞു.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"ദൈവം അവരെ തന്‍റെ വിശുദ്ധദേശത്തിലേക്കും","poem":1},{"text":"തന്‍റെ വലങ്കൈ സമ്പാദിച്ച ഈ പർവ്വതത്തിലേക്കും കൊണ്ടുവന്നു.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"അവരുടെ മുമ്പിൽനിന്നു ദൈവം ജനതകളെ നീക്കിക്കളഞ്ഞു;","poem":1},{"text":"ചരടുകൊണ്ട് അളന്ന് അവർക്ക് അവകാശം പകുത്തുകൊടുത്തു;","poem":2},{"lineBreak":true},{"text":"യിസ്രായേലിന്‍റെ ഗോത്രങ്ങളെ അവരവരുടെ കൂടാരങ്ങളിൽ താമസിപ്പിച്ചു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":56,"content":[{"text":"എങ്കിലും അവർ അത്യുന്നതനായ ദൈവത്തെ പരീക്ഷിച്ച് മത്സരിച്ചു;","poem":1},{"text":"അവിടുത്തെ സാക്ഷ്യങ്ങൾ പ്രമാണിച്ചതുമില്ല.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"അവർ അവരുടെ പൂര്‍വ്വ പിതാക്കന്മാരെപ്പോലെ പിന്തിരിഞ്ഞ് ദ്രോഹം ചെയ്തു;","poem":1},{"text":"വഞ്ചനയുള്ള വില്ലുപോലെ അവർ മാറിക്കളഞ്ഞു.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"അവർ അവരുടെ പൂജാഗിരികളെക്കൊണ്ട് ദൈവത്തെ കോപിപ്പിച്ചു;","poem":1},{"text":"വിഗ്രഹങ്ങളെക്കൊണ്ട് കർത്താവിന് തീക്ഷ്ണത ജനിപ്പിച്ചു.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"ദൈവം അത് കേട്ടു ക്രുദ്ധിച്ചു;","poem":1},{"text":"യിസ്രായേലിനെ ഏറ്റവും വെറുത്തു.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"അതുകൊണ്ട് ദൈവം ശീലോവിലെ","poem":1},{"noteId":78},{"text":"തിരുനിവാസവും","poem":1},{"text":"താൻ മനുഷ്യരുടെ ഇടയിൽ അടിച്ചിരുന്ന നിവാസവും","poem":2},{"noteId":79},{"text":"ഉപേക്ഷിച്ചു.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"തന്‍റെ ബലത്തെ പ്രവാസത്തിലും","poem":1},{"text":"തന്‍റെ നിയമ പെട്ടകത്തെ ശത്രുവിന്‍റെ കയ്യിലും ഏല്പിച്ചുകൊടുക്കുകയും മാനഹീനനാക്കുകയും ചെയ്തു.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"ദൈവം തന്‍റെ അവകാശത്തോട് കോപിച്ചു;","poem":1},{"text":"തന്‍റെ ജനത്തെ വാളിന് വിട്ടുകൊടുത്തു.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"അവരുടെ യൗവനക്കാർ തീയ്ക്ക് ഇരയായിത്തീർന്നു;","poem":1},{"text":"അവരുടെ കന്യകമാർക്ക് വിവാഹഗീതം ഉണ്ടായതുമില്ല.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"അവരുടെ പുരോഹിതന്മാർ വാൾകൊണ്ടു വീണു;","poem":1},{"text":"അവരുടെ വിധവമാർ വിലാപം കഴിച്ചതുമില്ല.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"അപ്പോൾ കർത്താവ് ഉറക്കത്തിൽനിന്ന് ഉണർന്നുവരുന്നവനെപ്പോലെയും","poem":1},{"text":"വീഞ്ഞു കുടിച്ച് അട്ടഹസിക്കുന്ന വീരനെപ്പോലെയും ഉണർന്നു.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"ദൈവം തന്‍റെ ശത്രുക്കളെ പിന്നിലേക്ക് ഓടിച്ചുകളഞ്ഞു;","poem":1},{"text":"അവർക്ക് നിത്യനിന്ദ വരുത്തുകയും ചെയ്തു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":67,"content":[{"text":"എന്നാൽ കർത്താവ് യോസേഫിന്‍റെ കൂടാരത്തെ ത്യജിച്ച്;","poem":1},{"text":"എഫ്രയീംഗോത്രത്തെ തിരഞ്ഞെടുത്തതുമില്ല.","poem":2}]},{"type":"verse","number":68,"content":[{"text":"ദൈവം യെഹൂദാഗോത്രത്തെയും","poem":1},{"text":"താൻ പ്രിയപ്പെട്ട സീയോൻ പർവ്വതത്തെയും തിരഞ്ഞെടുത്തു.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"താൻ സദാകാലത്തേക്കും സ്ഥാപിച്ചിരിക്കുന്ന ഭൂമിയെപ്പോലെയും","poem":1},{"text":"സ്വർഗ്ഗോന്നതികളെപ്പോലെയും ദൈവം തന്‍റെ വിശുദ്ധമന്ദിരത്തെ പണിതു.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"കർത്താവ് തന്‍റെ ദാസനായ ദാവീദിനെ തെരഞ്ഞെടുത്തു;","poem":1},{"text":"ആട്ടിൻതൊഴുത്തുകളുടെ ഇടയിൽനിന്ന് അവനെ വരുത്തി.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"തന്‍റെ ജനമായ യാക്കോബിനെയും തന്‍റെ അവകാശമായ യിസ്രായേലിനെയും","poem":1},{"text":"മേയിക്കേണ്ടതിന് യഹോവ അവനെ തള്ളയാടുകളെ നോക്കുന്ന വേലയിൽനിന്നു കൊണ്ടുവന്നു.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"അങ്ങനെ അവൻ പരമാർത്ഥ ഹൃദയത്തോടെ അവരെ മേയിച്ചു;","poem":1},{"text":"കൈകളുടെ സാമർത്ഥ്യത്തോടെ അവരെ നടത്തി.","poem":2}]}],"footnotes":[{"noteId":77,"caller":"+","text":"ഹാമിന്‍റെ ഹാം-ഈജിപ്തിനെ പൊതുവേ വിളിക്കുന്ന പേരാണ് ഹാം. സങ്കീ 105:23, 27; 106:22 നോക്കുക. നോഹയുടെ പുത്രന്മാരിലൊരുവനായ ഹാമിനെ ഈജിപ്ത്കാരുടെ പൂര്‍വ്വപിതാവായി വിളിക്കപ്പെടുന്നു. ഉല്‍പ്പത്തി 10:6 നോക്കുക","reference":{"chapter":78,"verse":51}},{"noteId":78,"caller":"+","text":"ശീലോവിലെ എഫ്രയീം ഗോത്രത്തിന്‍റെ അധീനതയിലുള്ള പ്രദേശത്തെ ഒരു പട്ടണമായിരുന്നു ശീലോവ്. യെരൂശലേമിന് 32 കിലോമീറ്റര്‍ വടക്കായി ഇത് സ്ഥിതിചെയ്യുന്നു. ഇവിടെയാണ്‌ യിസ്രായേലിന്‍റെ പുരാതന ചരിത്രത്തിലെ നിയമപെട്ടകം സൂക്ഷിച്ചിരുന്നത്. യോശുവ 18:1, 1ശമുവേല്‍ 1:3 നോക്കുക.","reference":{"chapter":78,"verse":60}},{"noteId":79,"caller":"+","text":"നിവാസവും കൂടാരവും","reference":{"chapter":78,"verse":60}}]},"thisChapterLink":"/api/mal_irv/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":72}