{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":83,"content":[{"type":"heading","content":["ശത്രുക്കളുടെ പതനത്തിന് വേണ്ടിയുള്ള പ്രാര്‍ത്ഥന"]},{"type":"hebrew_subtitle","content":["ആസാഫിന്‍റെ ഒരു സങ്കീർത്തനം; ഒരു ഗീതം."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"ദൈവമേ, നിശ്ശബ്ദമായിരിക്കരുതേ;","poem":1},{"text":"ദൈവമേ, മൗനമായും സ്വസ്ഥമായും ഇരിക്കരുതേ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ഇതാ, അങ്ങേയുടെ ശത്രുക്കൾ കലഹിക്കുന്നു;","poem":1},{"text":"അങ്ങയെ വെറുക്കുന്നവർ തല ഉയർത്തുന്നു.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അവർ അങ്ങേയുടെ ജനത്തിന്‍റെ നേരെ ഉപായം വിചാരിക്കുകയും","poem":1},{"text":"അങ്ങേക്ക് വിലയേറിയവരുടെ നേരെ ദുരാലോചന കഴിക്കുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“വരുവിൻ, യിസ്രായേൽ ഒരു ജനതയായിരിക്കാത്തവിധം നാം അവരെ മുടിച്ചുകളയുക.","poem":1},{"text":"അവരുടെ പേര് ഇനി ആരും ഓർക്കരുത്” എന്നു അവർ പറഞ്ഞു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവർ ഇങ്ങനെ ഏകമനസ്സോടെ ആലോചിച്ചു,","poem":1},{"text":"അങ്ങേക്കു വിരോധമായി സഖ്യം ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ഏദോമ്യരുടെയും യിശ്മായേല്യരുടെയും കൂടാരങ്ങളും","poem":1},{"text":"മോവാബ്യരും ഹഗര്യരും,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ഗെബാലും അമ്മോനും അമാലേക്കും,","poem":1},{"text":"ഫെലിസ്ത്യദേശവും സോർനിവാസികളും;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അശ്ശൂരും അവരോട് യോജിച്ചു;","poem":1},{"text":"അവർ ലോത്തിന്‍റെ മക്കൾക്ക് സഹായമായിരുന്നു. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"മിദ്യാന്യരോട് ചെയ്തതുപോലെ അവരോടു ചെയ്യേണമേ;","poem":1},{"text":"കീശോൻതോട്ടിനരികിൽ വച്ചു സീസെരയോടും യാബീനോടും ചെയ്തതുപോലെ തന്നെ.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവർ ഏൻ-ദോരിൽവച്ച് നശിച്ചുപോയി;","poem":1},{"text":"അവർ നിലത്തിന് വളമായിത്തീർന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അവരുടെ കുലീനന്മാരെ ഓരേബ്, സേബ് എന്നിവരെപ്പോലെയും","poem":1},{"text":"അവരുടെ സകലപ്രഭുക്കന്മാരെയും സേബഹ്, സൽമുന്ന എന്നിവരെപ്പോലെയും ആക്കേണമേ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“നാം ദൈവത്തിന്‍റെ നിവാസങ്ങളെ","poem":1},{"text":"നമുക്ക് അവകാശമാക്കിക്കൊള്ളുക” എന്നു അവർ പറഞ്ഞുവല്ലോ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"എന്‍റെ ദൈവമേ, അവരെ ചുഴലിക്കാറ്റിൽ പൊടിപോലെയും","poem":1},{"text":"കാറ്റത്തു പാറുന്ന പതിർപോലെയും ആക്കേണമേ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"വനത്തെ ദഹിപ്പിക്കുന്ന തീപോലെയും","poem":1},{"text":"പർവ്വതങ്ങളെ ചുട്ടുകളയുന്ന അഗ്നിജ്വാലപോലെയും","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അങ്ങേയുടെ കൊടുങ്കാറ്റുകൊണ്ട് അവരെ പിന്തുടരേണമേ;","poem":1},{"text":"അങ്ങേയുടെ ചുഴലിക്കാറ്റുകൊണ്ട് അവരെ ഭ്രമിപ്പിക്കേണമേ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"യഹോവേ, അവർ തിരുനാമത്തെ അന്വേഷിക്കേണ്ടതിന്","poem":1},{"text":"അങ്ങ് അവരുടെ മുഖത്തെ ലജ്ജാപൂർണ്ണമാക്കേണമേ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവർ എന്നേക്കും ലജ്ജിച്ച് ഭ്രമിക്കുകയും","poem":1},{"text":"നാണിച്ച് നശിച്ചുപോകുകയും ചെയ്യട്ടെ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"അങ്ങനെ അവർ യഹോവ എന്നു നാമമുള്ള അങ്ങ് മാത്രം","poem":1},{"text":"സർവ്വഭൂമിക്കും മീതെ അത്യുന്നതൻ എന്നു അറിയും.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}