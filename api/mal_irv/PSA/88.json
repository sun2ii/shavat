{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":88,"content":[{"type":"heading","content":["സഹായത്തിനുവേണ്ടിയുള്ള യാചന"]},{"type":"hebrew_subtitle","content":["ഒരു ഗീതം; കോരഹ് പുത്രന്മാരുടെ ഒരു സങ്കീർത്തനം; സംഗീതപ്രമാണിക്ക്; മഹലത്ത് രാഗത്തിൽ പ്രതിഗാനത്തിനായി; എസ്രാഹ്യനായ ഹേമാന്‍റെ ഒരു ധ്യാനം."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"എന്‍റെ രക്ഷയുടെ ദൈവമായ യഹോവേ,","poem":1},{"text":"ഞാൻ രാവും പകലും തിരുസന്നിധിയിൽ നിലവിളിക്കുന്നു;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"എന്‍റെ പ്രാർത്ഥന തിരുമുൻപിൽ വരുമാറാകട്ടെ;","poem":1},{"text":"എന്‍റെ നിലവിളിക്കു ചെവി ചായിക്കേണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"എന്‍റെ പ്രാണൻ കഷ്ടതകൊണ്ട് നിറഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"എന്‍റെ ജീവൻ പാതാളത്തോട് സമീപിക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"കുഴിയിൽ ഇറങ്ങുന്നവരുടെ കൂട്ടത്തിൽ എന്നെ എണ്ണിയിരിക്കുന്നു;","poem":1},{"text":"ഞാൻ ബലഹീനനായ മനുഷ്യനെപ്പോലെയാകുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ശവക്കുഴിയിൽ കിടക്കുന്ന ഹതന്മാരെപ്പോലെ","poem":1},{"text":"എന്നെ മരിച്ചവരുടെ കൂട്ടത്തിൽ ഉപേക്ഷിച്ചിരിക്കുന്നു;","poem":2},{"text":"അവരെ അങ്ങ് പിന്നെ ഓർക്കുന്നില്ല;","poem":1},{"text":"അവർ അങ്ങേയുടെ കൈയിൽനിന്ന് ഛേദിക്കപ്പെട്ടുപോയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അങ്ങ് എന്നെ ഏറ്റവും താണകുഴിയിലും","poem":1},{"text":"ഇരുട്ടിലും ആഴങ്ങളിലും ഇട്ടിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"അങ്ങേയുടെ ക്രോധം എനിക്ക് ഭാരമായിരിക്കുന്നു;","poem":1},{"text":"അങ്ങേയുടെ എല്ലാ തിരകളുംകൊണ്ട് അവിടുന്ന് എന്നെ വലച്ചിരിക്കുന്നു. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"എന്‍റെ പരിചയക്കാരെ അവിടുന്ന് എന്നോട് അകറ്റി,","poem":1},{"text":"അവർക്ക് എന്നോട് വെറുപ്പായിരിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"പുറത്തിറങ്ങുവാൻ കഴിയാത്തവിധം എന്നെ അടച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"എന്‍റെ കണ്ണ് കഷ്ടതഹേതുവായി ക്ഷയിച്ചുപോകുന്നു;","poem":1},{"text":"യഹോവേ, ഞാൻ ദിവസംപ്രതി അങ്ങയെ വിളിച്ചപേക്ഷിക്കുകയും","poem":2},{"lineBreak":true},{"text":"എന്‍റെ കൈകളെ അങ്ങയിലേക്ക് മലർത്തുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അവിടുന്ന് മരിച്ചവർക്ക് വേണ്ടി അത്ഭുതങ്ങൾ ചെയ്യുമോ?","poem":1},{"text":"മൃതന്മാർ എഴുന്നേറ്റ് അങ്ങയെ സ്തുതിക്കുമോ? സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ശവക്കുഴിയിൽ അങ്ങേയുടെ ദയയെയും","poem":1},{"text":"വിനാശത്തിൽ അങ്ങേയുടെ വിശ്വസ്തതയെയും വർണ്ണിക്കുമോ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"അന്ധകാരത്തിൽ അങ്ങേയുടെ അത്ഭുതങ്ങളും","poem":1},{"text":"വിസ്മൃതിയുടെ ദേശത്ത് അങ്ങേയുടെ നീതിയും വെളിപ്പെടുമോ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"എന്നാൽ യഹോവേ, ഞാൻ അങ്ങേയോട് നിലവിളിക്കുന്നു;","poem":1},{"text":"രാവിലെ എന്‍റെ പ്രാർത്ഥന തിരുസന്നിധിയിൽ വരുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"യഹോവേ, അവിടുന്ന് എന്‍റെ പ്രാണനെ തള്ളിക്കളയുന്നതെന്തിന്?","poem":1},{"text":"അങ്ങേയുടെ മുഖത്തെ എനിക്ക് മറയ്ക്കുന്നതും എന്തിന്?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ബാല്യംമുതൽ ഞാൻ അരിഷ്ടനും മൃതപ്രായനും ആകുന്നു;","poem":1},{"text":"ഞാൻ അങ്ങേയുടെ ഭീകരതകൾ സഹിച്ച് വലഞ്ഞിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അങ്ങേയുടെ ഉഗ്രകോപം എന്‍റെ മീതെ കവിഞ്ഞിരിക്കുന്നു;","poem":1},{"text":"അങ്ങേയുടെ ഭീകരത എന്നെ സംഹരിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അവ ഇടവിടാതെ വെള്ളംപോലെ എന്നെ ചുറ്റുന്നു;","poem":1},{"text":"അവ ഒരുപോലെ എന്നെ വളയുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"സ്നേഹിതനെയും കൂട്ടാളിയെയും അവിടുന്ന് എന്നോട് അകറ്റിയിരിക്കുന്നു;","poem":1},{"text":"എന്‍റെ സ്നേഹിതന്മാർ അന്ധകാരമത്രേ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mal_irv/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}