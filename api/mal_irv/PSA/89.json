{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":89,"content":[{"type":"heading","content":["ദാവീദുമായുള്ള ദൈവത്തിന്‍റെ ഉടമ്പടി"]},{"type":"hebrew_subtitle","content":["എസ്രാഹ്യനായ ഏഥാന്‍റെ ഒരു ധ്യാനം."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"യഹോവയുടെ കൃപകളെക്കുറിച്ച് ഞാൻ എന്നേക്കും പാടും;","poem":1},{"text":"തലമുറതലമുറയോളം എന്‍റെ വായ്കൊണ്ട് അങ്ങേയുടെ വിശ്വസ്തതയെ അറിയിക്കും.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“ദയ എന്നേക്കും ഉറച്ചുനില്ക്കും” എന്നു ഞാൻ പറയുന്നു;","poem":1},{"text":"അങ്ങേയുടെ വിശ്വസ്തതയെ അങ്ങ് സ്വർഗ്ഗത്തിൽ സ്ഥിരമാക്കിയിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"എന്‍റെ വൃതനോട് ഞാൻ ഒരു നിയമവും","poem":1},{"text":"എന്‍റെ ദാസനായ ദാവീദിനോട് സത്യവും ചെയ്തിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“നിന്‍റെ സന്തതിയെ ഞാൻ എന്നേക്കും സ്ഥിരപ്പെടുത്തും;","poem":1},{"text":"നിന്‍റെ സിംഹാസനത്തെ തലമുറതലമുറയോളം ഉറപ്പിക്കും.” സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"യഹോവേ, സ്വർഗ്ഗം അങ്ങേയുടെ അത്ഭുതങ്ങളെയും","poem":1},{"text":"വിശുദ്ധന്മാരുടെ സഭയിൽ അങ്ങേയുടെ വിശ്വസ്തതയെയും വർണ്ണിക്കും.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"സ്വർഗ്ഗത്തിൽ യഹോവയോട് സദൃശനായവൻ ആര്‍?","poem":1},{"text":"ദേവപുത്രന്മാരിൽ യഹോവയ്ക്ക് തുല്യനായവൻ ആർ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ദൈവം വിശുദ്ധന്മാരുടെ സംഘത്തിൽ ഏറ്റവും ഭയപ്പെടേണ്ടവനും","poem":1},{"text":"അവിടുത്തെ ചുറ്റുമുള്ള എല്ലാവരും ഭയപ്പെടുവാൻ യോഗ്യനും ആകുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"സൈന്യങ്ങളുടെ ദൈവമായ യഹോവേ, അങ്ങയെപ്പോലെ ബലവാൻ ആരാണുള്ളത്?","poem":1},{"text":"യഹോവേ, അങ്ങേയുടെ വിശ്വസ്തത അങ്ങയെ ചുറ്റിയിരിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"അങ്ങ് സമുദ്രത്തിന്‍റെ ഗർവ്വത്തെ അടക്കിവാഴുന്നു;","poem":1},{"text":"അതിലെ തിരകൾ പൊങ്ങുമ്പോൾ അങ്ങ് അവയെ അമർത്തുന്നു.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"അങ്ങ് രഹബിനെ","poem":1},{"noteId":81},{"text":"ഒരു ഹതനെപ്പോലെ തകർത്തു;","poem":1},{"text":"അങ്ങേയുടെ ബലമുള്ള ഭുജംകൊണ്ട് അങ്ങേയുടെ ശത്രുക്കളെ ചിതറിച്ചുകളഞ്ഞു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ആകാശം നിനക്കുള്ളത്, ഭൂമിയും അങ്ങേക്കുള്ളത്;","poem":1},{"text":"ഭൂതലവും അതിന്‍റെ പൂർണ്ണതയും അങ്ങ് സ്ഥാപിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ദക്ഷിണോത്തരദിക്കുകളെ അങ്ങ് സൃഷ്ടിച്ചിരിക്കുന്നു;","poem":1},{"text":"താബോരും","poem":2},{"noteId":82},{"text":"ഹെർമ്മോനും","poem":2},{"noteId":83},{"text":"അങ്ങേയുടെ നാമത്തിൽ ആനന്ദിക്കുന്നു;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അങ്ങേയുടെ ഭുജം വീര്യമുള്ളത്;","poem":1},{"text":"അങ്ങേയുടെ കൈ ബലമുള്ളതും അങ്ങേയുടെ വലങ്കൈ ഉന്നതവും ആകുന്നു.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"നീതിയും ന്യായവും അങ്ങേയുടെ സിംഹാസനത്തിന്‍റെ അടിസ്ഥാനമാകുന്നു;","poem":1},{"text":"ദയയും വിശ്വസ്തതയും അങ്ങേക്കു മുമ്പായി നടക്കുന്നു.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ജയഘോഷം","poem":1},{"noteId":84},{"text":"അറിയുന്ന ജനം ഭാഗ്യമുള്ളത്;","poem":1},{"text":"യഹോവേ, അവർ അങ്ങേയുടെ മുഖപ്രകാശത്തിൽ നടക്കും.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അവർ ഇടവിടാതെ അങ്ങേയുടെ നാമത്തിൽ ഘോഷിച്ചുല്ലസിക്കുന്നു;","poem":1},{"text":"അങ്ങേയുടെ നീതിയിൽ അവർ ഉയർന്നിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"അങ്ങ് അവരുടെ ബലത്തിന്‍റെ മഹത്ത്വമാകുന്നു;","poem":1},{"text":"അങ്ങേയുടെ പ്രസാദത്താൽ ഞങ്ങളുടെ ശക്തി","poem":2},{"noteId":85},{"text":"ഉയർന്നിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"നമ്മുടെ പരിച യഹോവയ്ക്കുള്ളതും","poem":1},{"text":"നമ്മുടെ രാജാവ് യിസ്രായേലിന്‍റെ പരിശുദ്ധനുള്ളവനും ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"അന്നു അങ്ങ് ദർശനത്തിൽ അങ്ങേയുടെ ഭക്തന്മാരോട് അരുളിച്ചെയ്തത്;","poem":1},{"text":"“ഞാൻ വീരനായ ഒരുവന് സഹായം നല്കുകയും","poem":2},{"lineBreak":true},{"text":"ജനത്തിൽനിന്ന് ഒരു വൃതനെ ഉയർത്തുകയും ചെയ്തു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ഞാൻ എന്‍റെ ദാസനായ ദാവീദിനെ കണ്ടെത്തി;","poem":1},{"text":"എന്‍റെ വിശുദ്ധതൈലംകൊണ്ട് അവനെ അഭിഷേകം ചെയ്തു.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"എന്‍റെ കൈ അവനോടുകൂടെ സ്ഥിരമായിരിക്കും;","poem":1},{"text":"എന്‍റെ ഭുജം അവനെ ബലപ്പെടുത്തും.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ശത്രു അവനെ തോല്പിക്കുകയില്ല;","poem":1},{"text":"വഷളൻ അവനെ പീഡിപ്പിക്കുകയും ഇല്ല.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ഞാൻ അവന്‍റെ വൈരികളെ അവന്‍റെ മുമ്പിൽ തകർക്കും;","poem":1},{"text":"അവനെ വെറുക്കുന്നവരെ സംഹരിക്കും,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"എന്നാൽ എന്‍റെ വിശ്വസ്തതയും ദയയും അവനോടുകൂടെ ഇരിക്കും;","poem":1},{"text":"എന്‍റെ നാമത്തിൽ അവന്‍റെ കൊമ്പ് ഉയർന്നിരിക്കും.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"അവന്‍റെ കൈ ഞാൻ സമുദ്രത്തിന്മേലും","poem":1},{"text":"അവന്‍റെ വലങ്കൈ നദികളുടെമേലും നീട്ടുമാറാക്കും.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"അവൻ എന്നോട്: ‘അങ്ങ് എന്‍റെ പിതാവ്, എന്‍റെ ദൈവം,","poem":1},{"text":"എന്‍റെ രക്ഷയുടെ പാറ’ എന്നിങ്ങനെ വിളിച്ചുപറയും.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ഞാൻ അവനെ ആദ്യജാതനും","poem":1},{"text":"ഭൂരാജാക്കന്മാരിൽ ശ്രേഷ്ഠനുമാക്കും.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ഞാൻ അവന് എന്‍റെ ദയ എന്നേക്കും കാണിക്കും;","poem":1},{"text":"എന്‍റെ നിയമം അവനുവേണ്ടി സ്ഥിരമായി നില്ക്കും.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ഞാൻ അവന്‍റെ സന്തതിയെ ശാശ്വതമായും","poem":1},{"text":"അവന്‍റെ സിംഹാസനത്തെ ആകാശമുള്ള കാലത്തോളവും നിലനിർത്തും.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"അവന്‍റെ പുത്രന്മാർ എന്‍റെ ന്യായപ്രമാണം ഉപേക്ഷിക്കുകയും","poem":1},{"text":"എന്‍റെ വിധികൾ അനുസരിച്ചുനടക്കാതിരിക്കുകയും","poem":2}]},{"type":"verse","number":31,"content":[{"text":"എന്‍റെ ചട്ടങ്ങൾ ലംഘിക്കുകയും","poem":1},{"text":"എന്‍റെ കല്പനകൾ പ്രമാണിക്കാതിരിക്കുകയും ചെയ്താൽ","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ഞാൻ അവരുടെ ലംഘനത്തെ വടികൊണ്ടും","poem":1},{"text":"അവരുടെ അകൃത്യത്തെ ദണ്ഡനംകൊണ്ടും സന്ദർശിക്കും.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"എങ്കിലും എന്‍റെ ദയ ഞാൻ അവനിൽ നിന്നു നീക്കിക്കളയുകയില്ല;","poem":1},{"text":"എന്‍റെ വിശ്വസ്തതയ്ക്ക് ഭംഗം വരുത്തുകയുമില്ല.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ഞാൻ എന്‍റെ നിയമം ലംഘിക്കുകയോ","poem":1},{"text":"എന്‍റെ അധരങ്ങളിൽനിന്നു പുറപ്പെട്ടതിന് മാറ്റം വരുത്തുകയോ ചെയ്യുകയില്ല.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ഞാൻ ഒരിക്കൽ എന്‍റെ വിശുദ്ധിയിൽ സത്യം ചെയ്തിരിക്കുന്നു;","poem":1},{"text":"ദാവീദിനോട് ഞാൻ ഭോഷ്കുപറയുകയില്ല.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"അവന്‍റെ സന്തതി ശാശ്വതമായും","poem":1},{"text":"അവന്‍റെ സിംഹാസനം എന്‍റെ മുമ്പിൽ സൂര്യനെപ്പോലെയും ഇരിക്കും.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"അത് ചന്ദ്രനെപ്പോലെയും","poem":1},{"text":"ആകാശത്തിലെ വിശ്വസ്തസാക്ഷിയെപ്പോലെയും","poem":2},{"lineBreak":true},{"text":"എന്നേക്കും സ്ഥിരമായിരിക്കും.” സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"എങ്കിലും അങ്ങ് ഉപേക്ഷിച്ച് തള്ളിക്കളയുകയും","poem":1},{"text":"അങ്ങേയുടെ അഭിഷിക്തനോട് കോപിക്കുകയും ചെയ്തു.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"അങ്ങേയുടെ ദാസനോടുള്ള നിയമത്തെ അങ്ങ് തള്ളിക്കളഞ്ഞു;","poem":1},{"text":"അവന്‍റെ കിരീടത്തെ അങ്ങ് നിലത്തിട്ട് അശുദ്ധമാക്കിയിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"അങ്ങ് അവന്‍റെ വേലി എല്ലാം പൊളിച്ചു;","poem":1},{"text":"അവന്‍റെ കോട്ടകളെയും ഇടിച്ചുകളഞ്ഞു.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"വഴിപോകുന്ന എല്ലാവരും അവനെ കൊള്ളയിടുന്നു;","poem":1},{"text":"തന്‍റെ അയല്ക്കാർക്ക് അവൻ നിന്ദ ആയിത്തീർന്നിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"അങ്ങ് അവന്‍റെ വൈരികളുടെ വലംകൈ ഉയർത്തി;","poem":1},{"text":"അവന്‍റെ സകലശത്രുക്കളെയും സന്തോഷിപ്പിച്ചു.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"അവന്‍റെ വാളിന്‍റെ വായ്ത്തല അങ്ങ് മടക്കി;","poem":1},{"text":"യുദ്ധത്തിൽ അവനെ നില്‍ക്കുമാറാക്കിയതുമില്ല.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"അവന്‍റെ തേജസ്സ്","poem":1},{"noteId":86},{"text":"അങ്ങ് ഇല്ലാതെയാക്കി;","poem":1},{"text":"അവന്‍റെ സിംഹാസനം നിലത്ത് തള്ളിയിട്ടു.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"അവന്‍റെ യൗവനത്തെ അങ്ങ് ചുരുക്കി;","poem":1},{"text":"അങ്ങ് അവനെ ലജ്ജകൊണ്ട് മൂടിയിരിക്കുന്നു. സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"യഹോവേ, അങ്ങ് നിത്യം മറഞ്ഞുകളയുന്നതും","poem":1},{"text":"അങ്ങേയുടെ ക്രോധം തീപോലെ ജ്വലിക്കുന്നതും എത്രത്തോളം?","poem":2}]},{"type":"verse","number":47,"content":[{"text":"എന്‍റെ ആയുസ്സ് എത്രചുരുക്കം എന്നു ഓർക്കേണമേ;","poem":1},{"text":"എന്ത് വ്യർത്ഥതയ്ക്കായി അങ്ങ് മനുഷ്യപുത്രന്മാരെ ഒക്കെയും സൃഷ്ടിച്ചു?","poem":2}]},{"type":"verse","number":48,"content":[{"text":"ജീവിച്ചിരുന്ന് മരണം കാണാതെയിരിക്കുന്ന മനുഷ്യൻ ആര്‍?","poem":1},{"text":"തന്‍റെ പ്രാണനെ പാതാളത്തിന്‍റെ കയ്യിൽനിന്ന് വിടുവിക്കുന്നവനും ആരാണ്? സേലാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"കർത്താവേ, അങ്ങേയുടെ വിശ്വസ്തതയിൽ അവിടുന്ന് ദാവീദിനോട്","poem":1},{"text":"സത്യംചെയ്ത അങ്ങേയുടെ പുരാതനകൃപകൾ എവിടെ?","poem":2}]},{"type":"verse","number":50,"content":[{"text":"കർത്താവേ, അടിയങ്ങളുടെ നിന്ദ ഓർക്കേണമേ;","poem":1},{"text":"എന്‍റെ മാർവ്വിടത്തിൽ ഞാൻ സകല ജനതയുടെയും നിന്ദ വഹിക്കുന്നതു തന്നെ.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"യഹോവേ, അങ്ങേയുടെ ശത്രുക്കൾ നിന്ദിക്കുന്നുവല്ലോ;","poem":1},{"text":"അവർ അങ്ങേയുടെ അഭിഷിക്തന്‍റെ കാലടികളെ നിന്ദിക്കുന്നു.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"യഹോവ എന്നുമെന്നേക്കും വാഴ്ത്തപ്പെടുമാറാകട്ടെ.","poem":1},{"text":"ആമേൻ, ആമേൻ.","poem":2}]}],"footnotes":[{"noteId":81,"caller":"+","text":"രഹബിനെ രഹബ് എന്നത് കൊണ്ടു ഇവിടെ അര്‍ത്ഥമാക്കുന്നത് പുരാണ കടല്‍ പാമ്പിനെയാണ്.","reference":{"chapter":89,"verse":10}},{"noteId":82,"caller":"+","text":"താബോരും താബോര്‍, ഗലീല തടാകത്തിന്‍റെ തെക്കേ അറ്റത്തിനു പടിഞ്ഞാറായി സ്ഥിതി ചെയ്യുന്ന 555 മീറ്റര്‍ ഉയരമുള്ള ഒരു പര്‍വ്വതമാണ്.","reference":{"chapter":89,"verse":12}},{"noteId":83,"caller":"+","text":"ഹെർമ്മോനും ഹെര്‍മ്മോന്‍ പര്‍വതം ഗലീല തടാകത്തിനു വടക്കു കിഴക്ക് 75 കിലോമീറ്റര്‍ ദൂരത്തിലായി സ്ഥിതിചെയ്യുന്നു. അതിന്‍റെ ഉയരം ഏകദേശം 8940 അടിയാണ്","reference":{"chapter":89,"verse":12}},{"noteId":84,"caller":"+","text":"ജയഘോഷം ദൈവത്തെ ആരാധിക്കുമ്പോള്‍ ഉണ്ടാക്കപ്പെടുന്ന സ്തുതിയുടെ ശബ്ദം","reference":{"chapter":89,"verse":15}},{"noteId":85,"caller":"+","text":"ശക്തി-കൊമ്പ്","reference":{"chapter":89,"verse":17}},{"noteId":86,"caller":"+","text":"തേജസ്സ്-രാജദണ്ഡ്","reference":{"chapter":89,"verse":44}}]},"thisChapterLink":"/api/mal_irv/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}