{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":90,"content":[{"type":"heading","content":["നിത്യനായ ദൈവം"]},{"type":"hebrew_subtitle","content":["ദൈവപുരുഷനായ മോശെയുടെ ഒരു പ്രാർത്ഥന."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"കർത്താവേ, അവിടുന്ന് തലമുറതലമുറയായി","poem":1},{"text":"ഞങ്ങളുടെ സങ്കേതമായിരിക്കുന്നു;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"പർവ്വതങ്ങൾ ഉണ്ടായതിനും","poem":1},{"text":"അങ്ങ് ഭൂമിയെയും ഭൂമണ്ഡലത്തെയും നിർമ്മിച്ചതിനും മുൻപ്","poem":2},{"lineBreak":true},{"text":"അങ്ങ് അനാദിയായും ശാശ്വതമായും ദൈവം ആകുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"അങ്ങ് മർത്യനെ പൊടിയിലേക്ക് മടങ്ങിച്ചേരുമാറാക്കുന്നു;","poem":1},{"text":"“മനുഷ്യപുത്രന്മാരേ, തിരികെ വരുവിൻ” എന്നും അരുളിച്ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ആയിരം വര്‍ഷം അവിടുത്തെ ദൃഷ്ടിയിൽ","poem":1},{"text":"ഇന്നലെ കഴിഞ്ഞുപോയ ദിവസംപോലെയും","poem":2},{"lineBreak":true},{"text":"രാത്രിയിലെ ഒരു യാമംപോലെയും മാത്രം ആകുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"അവിടുന്ന് മനുഷ്യരെ ഒഴുക്കിക്കളയുന്നു; അവർ ഉറക്കംപോലെ അത്രേ;","poem":1},{"text":"അവർ രാവിലെ മുളച്ചുവരുന്ന പുല്ലുപോലെ ആകുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അത് രാവിലെ തഴച്ചുവളരുന്നു;","poem":1},{"text":"വൈകുന്നേരം അത് വാടി കരിഞ്ഞുപോകുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ഞങ്ങൾ അങ്ങേയുടെ കോപത്താൽ ക്ഷയിച്ചും","poem":1},{"text":"അങ്ങേയുടെ ക്രോധത്താൽ ഭ്രമിച്ചുംപോകുന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അങ്ങ് ഞങ്ങളുടെ അകൃത്യങ്ങൾ അങ്ങേയുടെ മുമ്പിലും","poem":1},{"text":"ഞങ്ങളുടെ രഹസ്യപാപങ്ങൾ അങ്ങേയുടെ മുഖപ്രകാശത്തിലും വച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ഞങ്ങളുടെ നാളുകൾ എല്ലാം അങ്ങേയുടെ ക്രോധത്തിൽ കഴിഞ്ഞുപോയി;","poem":1},{"text":"ഞങ്ങളുടെ സംവത്സരങ്ങൾ ഞങ്ങൾ ഒരു നെടുവീർപ്പുപോലെ കഴിക്കുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ഞങ്ങളുടെ ആയുഷ്കാലം","poem":1},{"noteId":87},{"text":"എഴുപത് വര്‍ഷം;","poem":1},{"text":"ഏറെ ആയാൽ എൺപത്;","poem":2},{"text":"അതിന്‍റെ പ്രതാപം പ്രയാസവും ദുഃഖവുമത്രേ;","poem":1},{"text":"അത് വേഗം തീരുകയും ഞങ്ങൾ പറന്നു പോകുകയും ചെയ്യുന്നു.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അങ്ങയെ ഭയപ്പെടുവാൻ തക്കവണ്ണം അങ്ങേയുടെ കോപത്തിന്‍റെ ശക്തിയെയും","poem":1},{"text":"അങ്ങേയുടെ ക്രോധത്തെയും ഗ്രഹിക്കുന്നവൻ ആര്‍?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ഞങ്ങൾ ജ്ഞാനമുള്ള ഒരു ഹൃദയം പ്രാപിക്കത്തക്കവണ്ണം","poem":1},{"text":"ഞങ്ങളുടെ നാളുകളെ എണ്ണുവാൻ ഞങ്ങളെ ഉപദേശിക്കേണമേ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"യഹോവേ, മടങ്ങിവരേണമേ; എത്രത്തോളം താമസം?","poem":1},{"text":"അടിയങ്ങളോട് സഹതാപം തോന്നേണമേ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"കാലത്ത് തന്നെ ഞങ്ങളെ അവിടുത്തെ ദയകൊണ്ട് തൃപ്തരാക്കേണമേ;","poem":1},{"text":"എന്നാൽ ഞങ്ങളുടെ ആയുഷ്കാലമെല്ലാം ഞങ്ങൾ ഘോഷിച്ചാനന്ദിക്കും.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"അവിടുന്ന് ഞങ്ങളെ ക്ലേശിപ്പിച്ച ദിവസങ്ങൾക്കും ഞങ്ങൾ അനർത്ഥം അനുഭവിച്ച സംവത്സരങ്ങൾക്കും","poem":1},{"text":"തക്കവണ്ണം ഞങ്ങളെ സന്തോഷിപ്പിക്കേണമേ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അങ്ങേയുടെ ദാസന്മാർക്ക് അങ്ങേയുടെ പ്രവൃത്തിയും","poem":1},{"text":"അവരുടെ മക്കൾക്ക് അങ്ങേയുടെ മഹത്വവും വെളിപ്പെടുമാറാകട്ടെ.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ഞങ്ങളുടെ ദൈവമായ യഹോവയുടെ പ്രസാദം ഞങ്ങളുടെമേൽ ഇരിക്കുമാറാകട്ടെ;","poem":1},{"text":"ഞങ്ങളുടെ കൈകളുടെ പ്രവൃത്തികൾ സാദ്ധ്യമാക്കി തരേണമേ;","poem":2},{"lineBreak":true},{"text":"അതേ, ഞങ്ങളുടെ കൈകളുടെ പ്രവൃത്തികൾ സാദ്ധ്യമാക്കി തരേണമേ.","poem":2}]}],"footnotes":[{"noteId":87,"caller":"+","text":"ആയുഷ്കാലം-അഭിമാനം","reference":{"chapter":90,"verse":10}}]},"thisChapterLink":"/api/mal_irv/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}