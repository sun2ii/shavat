{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"PSA","translationId":"mal_irv","name":"സങ്കീർത്തനങ്ങൾ","commonName":"സങ്കീർത്തനങ്ങൾ","title":"സങ്കീർത്തനങ്ങൾ","order":19,"numberOfChapters":150,"sha256":"cde189253b5f715def313824622876901f113205c38e476b341dea2914222072","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mal_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":94,"content":[{"type":"heading","content":["ദൈവം നീതിമാന്‍റെ സങ്കേതം"]},{"type":"verse","number":1,"content":[{"text":"പ്രതികാരത്തിന്‍റെ ദൈവമായ യഹോവേ,","poem":1},{"text":"പ്രതികാരം ചെയ്യുവാൻ അധികാരമുള്ള ദൈവമേ, അങ്ങയുടെ ക്രോധം പ്രദര്‍ശിപ്പിക്കേണമേ","poem":2},{"noteId":91},{"text":".","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ഭൂമിയുടെ ന്യായാധിപതിയേ എഴുന്നേല്ക്കേണമേ;","poem":1},{"text":"ഡംഭികൾക്ക് അങ്ങ് പ്രതികാരം ചെയ്യേണമേ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"യഹോവേ, ദുഷ്ടന്മാർ എത്രത്തോളം,","poem":1},{"text":"ദുഷ്ടന്മാർ എത്രത്തോളം ഘോഷിച്ചുല്ലസിക്കും?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"അവർ ധാർഷ്ട്യത്തോടെ ശകാരിച്ച് സംസാരിക്കുന്നു;","poem":1},{"text":"നീതികേട് പ്രവർത്തിക്കുന്ന ഏവരും വമ്പ് പറയുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"യഹോവേ, അവർ അങ്ങേയുടെ ജനത്തെ തകർത്തുകളയുന്നു;","poem":1},{"text":"അങ്ങേയുടെ അവകാശത്തെ പീഡിപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"അവർ വിധവയെയും പരദേശിയെയും കൊല്ലുന്നു;","poem":1},{"text":"അനാഥരെ അവർ ഹിംസിക്കുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“യഹോവ കാണുകയില്ല;","poem":1},{"text":"യാക്കോബിന്‍റെ ദൈവം ഗ്രഹിക്കുകയില്ല” എന്നു അവർ പറയുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ജനത്തിൽ ബുദ്ധിഹീനരേ, ചിന്തിച്ചുകൊൾവിൻ;","poem":1},{"text":"ഭോഷന്മാരേ, നിങ്ങൾക്ക് എപ്പോൾ ബുദ്ധി ഉദിക്കും?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ചെവിയെ നട്ടവൻ കേൾക്കുകയില്ലയോ?","poem":1},{"text":"കണ്ണ് നിർമ്മിച്ചവൻ കാണുകയില്ലയോ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ജനതകളുടെ മേൽ ശിക്ഷണം നടത്തുന്നവൻ ശാസിക്കുകയില്ലയോ?","poem":1},{"text":"അവൻ മനുഷ്യർക്ക് ജ്ഞാനം ഉപദേശിച്ചുകൊടുക്കുന്നില്ലയോ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"മനുഷ്യരുടെ വിചാരങ്ങൾ യഹോവ അറിയുന്നു","poem":1},{"text":"അവ മായയെന്ന് അവിടുന്ന് അറിയുന്നു.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"യഹോവേ, ദുഷ്ടനെ മറവു ചെയ്യുവാൻ കുഴി കുഴിക്കുവോളം","poem":1},{"text":"അനർത്ഥദിവസത്തിൽ വിശ്രമം നൽകേണ്ടതിനു","poem":2}]},{"type":"verse","number":13,"content":[{"text":"അങ്ങ് ശിക്ഷിക്കുകയും അങ്ങേയുടെ ന്യായപ്രമാണം","poem":1},{"text":"ഉപദേശിക്കുകയും ചെയ്യുന്ന മനുഷ്യൻ ഭാഗ്യവാൻ.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"യഹോവ തന്‍റെ ജനത്തെ തള്ളിക്കളയുകയില്ല;","poem":1},{"text":"തന്‍റെ അവകാശത്തെ കൈവിടുകയുമില്ല.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"നീതിപൂർവമായ ന്യായവിധികൾ മടങ്ങിവരും;","poem":1},{"text":"പരമാർത്ഥഹൃദയമുള്ളവരെല്ലാം അതിനോട് യോജിക്കും.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ദുഷ്കർമ്മികൾക്കെതിരെ ആര്‍ എനിക്ക് വേണ്ടി എഴുന്നേല്‍ക്കും?","poem":1},{"text":"നീതികേട് പ്രവർത്തിക്കുന്നവരോട് ആര്‍ എനിക്ക് വേണ്ടി എതിർത്തുനില്ക്കും?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"യഹോവ എനിക്ക് സഹായമായിരുന്നില്ലെങ്കിൽ","poem":1},{"text":"എന്‍റെ പ്രാണൻ വേഗം മൗനവാസം ചെയ്യുമായിരുന്നു.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“എന്‍റെ കാൽ വഴുതുന്നു” എന്നു ഞാൻ പറഞ്ഞപ്പോൾ","poem":1},{"text":"യഹോവേ, അങ്ങേയുടെ ദയ എന്നെ താങ്ങി.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"എന്‍റെ ഉള്ളിൽ ആകുലചിന്തകൾ പെരുകുമ്പോൾ","poem":1},{"text":"അങ്ങയിൽ നിന്നുള്ള ആശ്വാസം എന്‍റെ പ്രാണനെ തണുപ്പിക്കുന്നു.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"നിയമം മൂലം തിന്മയ്ക്ക് വഴിയൊരുക്കുന്ന","poem":1},{"text":"ദുഷ്ടസിംഹാസനത്തിന് അങ്ങേയോട് സഖ്യം ഉണ്ടാകുമോ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"നീതിമാന്‍റെ പ്രാണന് വിരോധമായി അവർ കൂട്ടം കൂടുന്നു;","poem":1},{"text":"നിരപരാധിയെ അവർ ശിക്ഷയ്ക്ക് വിധിക്കുന്നു.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"എങ്കിലും യഹോവ എനിക്ക് രക്ഷാഗോപുരവും","poem":1},{"text":"എന്‍റെ ശരണശൈലവും എന്‍റെ ദൈവവും ആകുന്നു.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ദൈവം അവരുടെ നീതികേട് കൊണ്ടു തന്നെ അവരുടെ മേൽ ശിക്ഷ വരുത്തും;","poem":1},{"text":"അവരുടെ ദുഷ്ടതയിൽ തന്നെ അവരെ സംഹരിക്കും;","poem":2},{"lineBreak":true},{"text":"നമ്മുടെ ദൈവമായ യഹോവ അവരെ ഛേദിച്ചുകളയും.","poem":2}]}],"footnotes":[{"noteId":91,"caller":"+","text":"ദൈവമേ, അങ്ങയുടെ ക്രോധം പ്രദര്‍ശിപ്പിക്കേണമേ ദൈവമേ, പ്രകാശിക്കേണമേ","reference":{"chapter":94,"verse":1}}]},"thisChapterLink":"/api/mal_irv/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}