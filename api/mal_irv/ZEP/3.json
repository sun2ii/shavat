{"translation":{"id":"mal_irv","name":"ഇന്ത്യൻ റിവൈസ്ഡ് വേർഷൻ (IRV) - മലയാളം","website":"https://ebible.org/Scriptures/details.php?id=mal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mal","licenseNotes":null,"shortName":"IRV","englishName":"Malayalam Indian Revised Version Bible","language":"mal","textDirection":"ltr","sha256":"2a18480f9bb22501bba07a35f78304672fe2e05c5685ebbe2bdddcd38001b3cd","availableFormats":["json"],"listOfBooksApiLink":"/api/mal_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"മലയാളം","languageEnglishName":"Malayalam"},"book":{"id":"ZEP","translationId":"mal_irv","name":"സെഫന്യാവ്","commonName":"സെഫന്യാവ്","title":"സെഫന്യാവ്","order":36,"numberOfChapters":3,"sha256":"6521c93c0d68ed4e82af4d3194c83d779e8662102630b6301a505f4983eb49d6","firstChapterNumber":1,"firstChapterApiLink":"/api/mal_irv/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mal_irv/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["ശിക്ഷയും വീണ്ടെടുപ്പും"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"മത്സരവും മലിനതയും നിറഞ്ഞതും പീഡിപ്പിക്കുന്നതുമായ","poem":1},{"text":"നഗരത്തിന്","poem":2},{"noteId":3},{"text":"അയ്യോ കഷ്ടം!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"അവൾ യഹോവയുടെ വാക്ക് കേട്ടനുസരിച്ചിട്ടില്ല;","poem":1},{"text":"പ്രബോധനം കൈക്കൊണ്ടിട്ടില്ല;","poem":2},{"text":"യഹോവയിൽ ആശ്രയിച്ചിട്ടില്ല;","poem":1},{"text":"തന്‍റെ ദൈവത്തോട് അടുത്തുവന്നിട്ടുമില്ല.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"അതിനകത്ത് അതിന്‍റെ പ്രഭുക്കന്മാർ","poem":1},{"text":"ഗർജ്ജിക്കുന്ന സിംഹങ്ങൾ;","poem":2},{"text":"അതിന്‍റെ ന്യായാധിപതിമാർ","poem":1},{"text":"വൈകുന്നേരത്തെ ചെന്നായ്ക്കൾ;","poem":2},{"text":"അവർ പ്രഭാതകാലത്തേക്ക്","poem":1},{"text":"ഒന്നും ശേഷിപ്പിക്കുന്നില്ല.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"അതിന്‍റെ പ്രവാചകന്മാർ അല്പബുദ്ധികളും","poem":1},{"text":"വിശ്വാസപാതകന്മാരും ആകുന്നു;","poem":2},{"text":"അതിന്‍റെ പുരോഹിതന്മാർ","poem":1},{"text":"വിശുദ്ധമന്ദിരത്തെ അശുദ്ധമാക്കി,","poem":2},{"lineBreak":true},{"text":"ന്യായപ്രമാണം ലംഘിക്കുന്നു.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"യഹോവ അതിന്‍റെ മദ്ധ്യത്തിൽ നീതിമാനാകുന്നു;","poem":1},{"text":"അവൻ നീതികേട് ചെയ്യുന്നില്ല;","poem":2},{"text":"രാവിലേതോറും അവൻ തന്‍റെ ന്യായത്തെ","poem":1},{"text":"തെറ്റാതെ വെളിപ്പെടുത്തുന്നു;","poem":2},{"lineBreak":true},{"text":"നീതികെട്ടവനോ നാണം എന്തെന്നറിഞ്ഞുകൂടാ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ഞാൻ ജനതകളെ ഛേദിച്ചുകളഞ്ഞു;","poem":1},{"text":"അവരുടെ കോട്ടകൾ ശൂന്യമാക്കിയിരിക്കുന്നു;","poem":2},{"text":"ഞാൻ അവരുടെ വീഥികളെ","poem":1},{"text":"ആരും കടന്നുപോകാത്തവിധം ശൂന്യമാക്കി,","poem":2},{"text":"അവരുടെ പട്ടണങ്ങൾ","poem":1},{"text":"ഒരു മനുഷ്യനും നിവാസിയും ഇല്ലാതെ നശിച്ചിരിക്കുന്നു.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“നീ എന്നെ ഭയപ്പെട്ട് പ്രബോധനം സ്വീകരിക്കുക” എന്ന് ഞാൻ കല്പിച്ചു;","poem":1},{"text":"എന്നാൽ ഞാൻ തീരുമാനിച്ചതുപോലെ അവളുടെ ഭവനത്തിൽ നിന്ന്","poem":2},{"lineBreak":true},{"text":"ഛേദിക്കപ്പെടുകയില്ലായിരുന്നു;","poem":2},{"text":"പക്ഷേ അവർ ജാഗ്രതയോടെ","poem":1},{"text":"തങ്ങളുടെ ദുഷ്പ്രവൃത്തികൾ ചെയ്തുപോന്നു.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"അതുകൊണ്ട് “ഞാൻ സാക്ഷിയായി എഴുന്നേല്ക്കുന്ന ദിവസംവരെ","poem":1},{"text":"എനിക്കായി കാത്തിരിക്കുക”","poem":2},{"lineBreak":true},{"text":"എന്ന് യഹോവയുടെ അരുളപ്പാട്.","poem":2},{"text":"എന്‍റെ ക്രോധവും എന്‍റെ ഉഗ്രകോപവും","poem":1},{"text":"പകരേണ്ടതിന് ജനതകളെ ചേർക്കുവാനും","poem":2},{"text":"രാജ്യങ്ങളെ കൂട്ടുവാനും","poem":1},{"text":"ഞാൻ തീരുമാനിച്ചിരിക്കുന്നു;","poem":2},{"text":"സർവ്വഭൂമിയും എന്‍റെ തീക്ഷ്ണതാഗ്നിക്ക്","poem":1},{"text":"ഇരയായിത്തീരും.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"അപ്പോൾ സകലജാതികളും","poem":2},{"lineBreak":true},{"text":"യഹോവയുടെ നാമത്തെ വിളിച്ചപേക്ഷിച്ച്","poem":2},{"text":"ഏകമനസ്സോടെ അവനെ സേവിക്കേണ്ടതിന്","poem":1},{"text":"ഞാൻ അവർക്ക് നിർമ്മലമായുള്ള അധരങ്ങൾ നൽകും.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"കൂശ് നദികളുടെ അക്കരെനിന്ന്","poem":1},{"text":"എന്‍റെ നമസ്കാരികൾ,","poem":2},{"text":"എന്‍റെ ചിതറിപ്പോയവരുടെ സഭ തന്നെ,","poem":1},{"text":"എനിക്ക് വഴിപാട് കൊണ്ടുവരും.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"അന്ന് ഞാൻ അവരുടെ മദ്ധ്യത്തില്‍","poem":1},{"noteId":4},{"text":"നിന്ന്","poem":1},{"text":"അഹങ്കരിച്ച് ഉല്ലസിക്കുന്നവരെ നീക്കിക്കളയും.","poem":2},{"text":"നീ എന്‍റെ വിശുദ്ധപർവ്വതത്തിൽ","poem":1},{"text":"ഇനി അഹങ്കരിക്കാതിരിക്കുന്നതുകൊണ്ട്","poem":2},{"text":"നീ എന്നോട് അതിക്രമമായി ചെയ്തിരിക്കുന്ന","poem":1},{"text":"സകലപ്രവൃത്തികളുംനിമിത്തം","poem":2},{"lineBreak":true},{"text":"അന്ന് ലജ്ജിക്കേണ്ടിവരുകയില്ല.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ഞാൻ നിന്‍റെ നടുവിൽ താഴ്മയും","poem":1},{"text":"ദാരിദ്ര്യവും ഉള്ള ജനത്തെ ശേഷിപ്പിക്കും;","poem":2},{"text":"അവർ യഹോവയുടെ നാമത്തിൽ","poem":1},{"text":"ശരണം പ്രാപിക്കും.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"യിസ്രായേലിൽ അവശേഷിച്ചവർ","poem":1},{"text":"നീതികേട് പ്രവർത്തിക്കുകയില്ല;","poem":2},{"text":"ഭോഷ്കുപറയുകയുമില്ല;","poem":1},{"text":"ചതിവുള്ള നാവ് അവരുടെ വായിൽ ഉണ്ടാകുകയില്ല;","poem":2},{"text":"അവർ ആടുമാടുകളെ മേയുകയും","poem":1},{"text":"സുഖമായി വിശ്രമിക്കുകയും ചെയ്യും;","poem":2},{"lineBreak":true},{"text":"ആരും അവരെ ഭയപ്പെടുത്തുകയുമില്ല.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"സീയോൻപുത്രിയേ","poem":1},{"noteId":5},{"text":", ഘോഷിച്ചാനന്ദിക്കുക;","poem":1},{"text":"യിസ്രായേലേ, ആർപ്പിടുക;","poem":2},{"text":"യെരൂശലേം പുത്രിയേ","poem":1},{"noteId":6},{"text":",","poem":1},{"text":"പൂർണ്ണഹൃദയത്തോടെ സന്തോഷിച്ചുല്ലസിക്ക.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"യഹോവ നിന്‍റെ ന്യായവിധികളെ മാറ്റി,","poem":1},{"text":"നിന്‍റെ ശത്രുവിനെ നീക്കിക്കളഞ്ഞിരിക്കുന്നു;","poem":2},{"text":"യിസ്രായേലിന്‍റെ രാജാവായ യഹോവ","poem":1},{"text":"നിന്‍റെ മദ്ധ്യത്തിൽ ഇരിക്കുന്നു;","poem":2},{"lineBreak":true},{"text":"ഇനി നീ അനർത്ഥം കാണുകയില്ല.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"അന്ന് അവർ യെരൂശലേമിനോട്: “ഭയപ്പെടരുത്” എന്നും","poem":1},{"text":"സീയോനോട്: “അധൈര്യപ്പെടരുത്” എന്നും പറയും.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"നിന്‍റെ ദൈവമായ യഹോവ രക്ഷിക്കുന്ന വീരനായി","poem":1},{"text":"നിന്‍റെ മദ്ധ്യേ ഇരിക്കുന്നു;","poem":2},{"text":"അവൻ നിന്നിൽ അത്യന്തം സന്തോഷിക്കും;","poem":1},{"text":"തന്‍റെ സ്നേഹത്താൽ അവൻ പുതുതാക്കുന്നു","poem":2},{"noteId":7},{"text":";","poem":2},{"text":"ഉത്സവദിനത്തിലെപ്പോലെ","poem":1},{"text":"അവൻ നിന്നിൽ ആനന്ദിക്കും.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ലജ്ജാഭാരം വഹിച്ചവളായ നിനക്കുള്ളവരായി","poem":1},{"text":"സംഘത്തെ വിട്ടു ദുഃഖിക്കുന്നവരെ","poem":2},{"lineBreak":true},{"text":"ഞാൻ ചേർത്തുകൊള്ളും.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"നിന്നെ ക്ലേശിപ്പിക്കുന്നവരോട് ഞാൻ ആ കാലത്ത് ഇടപെടും;","poem":1},{"text":"ഞാൻ മുടന്തരെ രക്ഷിക്കുകയും ചിതറിപ്പോയതിനെ ശേഖരിക്കുകയും","poem":2},{"text":"സർവ്വഭൂമിയിലും ലജ്ജ നേരിട്ടവരെ","poem":1},{"text":"പ്രശംസയും കീർത്തിയുമാക്കി തീർക്കുകയും ചെയ്യും.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ആ കാലത്ത് ഞാൻ നിങ്ങളെ വരുത്തുകയും,","poem":1},{"text":"ഞാൻ നിങ്ങളെ ശേഖരിക്കുകയും ചെയ്യും;","poem":2},{"text":"നിങ്ങളുടെ കൺമുൻപിൽ ഞാൻ","poem":1},{"text":"നിങ്ങളുടെ പ്രവാസികളെ മടക്കിവരുത്തുമ്പോൾ","poem":2},{"text":"ഞാൻ നിങ്ങളെ ഭൂമിയിലെ സകലജനതകളുടെയും ഇടയിൽ","poem":1},{"text":"കീർത്തിയും പ്രശംസയും ആക്കിത്തീർക്കുമെന്ന്","poem":2},{"lineBreak":true},{"text":"യഹോവ അരുളിച്ചെയ്യുന്നു.","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"നഗരത്തിന് യെരൂശലേം നഗരത്തിനു","reference":{"chapter":3,"verse":1}},{"noteId":4,"caller":"+","text":"അവരുടെ മദ്ധ്യത്തില്‍ നിന്‍റെ മദ്ധ്യത്തില്‍","reference":{"chapter":3,"verse":11}},{"noteId":5,"caller":"+","text":"സീയോൻപുത്രിയേ യിസ്രായേല്‍ മക്കളേ","reference":{"chapter":3,"verse":14}},{"noteId":6,"caller":"+","text":"യെരൂശലേം പുത്രിയേ യെരൂശലേം ജനങ്ങളേ","reference":{"chapter":3,"verse":14}},{"noteId":7,"caller":"+","text":"പുതുതാക്കുന്നു മിണ്ടാതിരിക്കുന്നു","reference":{"chapter":3,"verse":17}}]},"thisChapterLink":"/api/mal_irv/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mal_irv/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mal_irv/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}