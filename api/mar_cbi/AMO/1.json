{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"AMO","translationId":"mar_cbi","name":"आमोस","commonName":"आमोस","title":"आमोसाची भविष्यवाणी","order":30,"numberOfChapters":9,"sha256":"d3a39caa40a74928329a3018bdbbeda5c16e65505a9f1962f65988816e699ee4","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/mar_cbi/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["तकोवा येथील एक मेंढपाळ आमोसाची वचने—त्याने उज्जीयाह यहूदाहचा आणि योआश",{"noteId":0},"चा पुत्र यरोबोअम इस्राएलचा राजा असता, भूकंपाच्या दोन वर्षे आधी इस्राएलाबद्दल जे दृष्टान्तामध्ये पाहिले ते हे."]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":["त्याने म्हटले:",{"text":"“याहवेह सीयोनातून गर्जना करतात","poem":1},{"text":"आणि यरुशलेमातून गडगडाट करतात;","poem":2},{"text":"मेंढपाळांची कुरणे सुकून जातात,","poem":1},{"text":"आणि कर्मेलचा माथा कोमेजून जाईल.”","poem":2}]},{"type":"heading","content":["इस्राएलच्या शेजाऱ्यांचा न्याय"]},{"type":"verse","number":3,"content":["याहवेह असे म्हणतात:",{"text":"“दिमिष्कच्या तीन नव्हे","poem":1},{"text":"तर चार अपराधांसाठी शासन करण्यापासून मी अनुताप करणार नाही.","poem":2},{"text":"कारण तिने गिलआदला","poem":1},{"text":"मळणी करण्याच्या लोखंडी काट्यांनी मळले आहे,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"म्हणून मी हजाएलच्या घरावर अग्नी पाठवेन","poem":1},{"text":"व बेन-हदादच्या किल्ल्याला भस्म करेन.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"दिमिष्कचे प्रवेशद्वार तोडून टाकेन;","poem":1},{"text":"आणि आवेन","poem":2},{"noteId":1},{"text":"खोर्‍यातील राजा","poem":2},{"noteId":2},{"text":"आणि बेथ-एदेनचा राजदंड धरणाऱ्यांना मी नष्ट करेन.","poem":1},{"text":"अरामाचे लोक कीर येथे गुलाम म्हणून जातील.”","poem":2},{"lineBreak":true},{"text":"याहवेह असे म्हणतात.","poem":2}]},{"type":"verse","number":6,"content":["याहवेह असे म्हणतात:",{"text":"“गाझाच्या तीन नव्हे","poem":1},{"text":"तर चार अपराधांसाठी शासन करण्यापासून मी अनुताप करणार नाही.","poem":2},{"text":"कारण तिने सर्व लोकांना बंदिवासात घेतले","poem":1},{"text":"आणि त्यांना एदोमला विकले,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"म्हणून मी गाझाच्या तटांवर अग्नी पाठवेन","poem":1},{"text":"आणि तिच्या किल्ल्याला भस्म करेन.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"मी अश्दोदच्या राजाचा","poem":1},{"text":"आणि अष्कलोनचा राजदंड धरणार्‍याचा नाश करेन.","poem":2},{"text":"शेवटच्या पलिष्टीचा नाश होत नाही","poem":1},{"text":"तोपर्यंत मी आपला हात एक्रोनावर चालवेन,”","poem":2},{"lineBreak":true},{"text":"असे सार्वभौम याहवेह म्हणतात.","poem":2}]},{"type":"verse","number":9,"content":["याहवेह असे म्हणतात:",{"text":"“सोरच्या तीन नव्हे","poem":1},{"text":"तर चार अपराधांसाठी शासन करण्यापासून मी अनुताप करणार नाही.","poem":2},{"text":"कारण बंदिवासातील सर्वांना एदोमास विकले","poem":1},{"text":"आणि बंधुत्वाच्या कराराची अवहेलना केली आहे.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"म्हणून मी सोरच्या तटांवर अग्नी पाठवेन","poem":1},{"text":"आणि तिच्या किल्ल्यांना भस्म करेन.”","poem":2}]},{"type":"verse","number":11,"content":["याहवेह असे म्हणतात:",{"text":"“एदोमच्या तीन नव्हे","poem":1},{"text":"तर चार अपराधांसाठी शासन करण्यापासून अनुताप करणार नाही.","poem":2},{"text":"कारण त्याने तलवार घेऊन आपल्या भावाचा पाठलाग केला","poem":1},{"text":"आणि देशातील स्त्रियांचा वध केला,","poem":2},{"text":"कारण त्याचा क्रोध निरंतर वाढत होता,","poem":1},{"text":"आणि त्याच्या क्रोध अनियंत्रित वाढत गेला,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"म्हणून मी तेमानवर अग्नी पाठवेन","poem":1},{"text":"आणि ती आग बस्राचे किल्ले भस्म करून टाकील.”","poem":2}]},{"type":"verse","number":13,"content":["याहवेह असे म्हणतात,",{"text":"“अम्मोनच्या तीन नाही","poem":1},{"text":"तर चार अपराधांसाठी शासन करण्यापासून मी अनुताप करणार नाही.","poem":2},{"text":"कारण आपल्या सीमा वाढविण्यासाठी","poem":1},{"text":"गिलआदाच्या गरोदर स्त्रियांना चिरले,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"म्हणून मी राब्बाहच्या तटांवर अग्नी पाठवेन","poem":1},{"text":"आणि त्यामुळे त्यांचे किल्ले व राजमहाल भस्म होतील.","poem":2},{"text":"महान वादळामध्ये वावटळीचा आवाज व्हावा","poem":1},{"text":"तसा भयानक रणगर्जना होतील;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"आणि तिचा राजा","poem":1},{"noteId":3},{"text":"आणि राजाचे अधिपती बरोबरच बंदिवासात जातील.”","poem":2},{"lineBreak":true},{"text":"याहवेहने म्हटले.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"योआश किंवा येहोआश","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"अर्थात् क्रूर","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"किंवा खोर्‍यातील रहिवासी","reference":{"chapter":1,"verse":5}},{"noteId":3,"caller":"+","text":"किंवा मोलेख राजा","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/mar_cbi/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}