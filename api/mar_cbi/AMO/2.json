{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"AMO","translationId":"mar_cbi","name":"आमोस","commonName":"आमोस","title":"आमोसाची भविष्यवाणी","order":30,"numberOfChapters":9,"sha256":"d3a39caa40a74928329a3018bdbbeda5c16e65505a9f1962f65988816e699ee4","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/mar_cbi/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["याहवेह असे म्हणतात,",{"text":"“मोआबच्या तीन नव्हे","poem":1},{"text":"तर चार अपराधांसाठी शासन करण्यापासून मी अनुताप करणार नाही.","poem":2},{"text":"कारण त्याने एदोम राजाची हाडे जाळून","poem":1},{"text":"त्याची राख केली आहे.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मी मोआबावर अग्नी पाठवेन","poem":1},{"text":"तो करीयोथच्या किल्ल्याला","poem":2},{"noteId":4},{"text":"भस्म करेन.","poem":2},{"text":"युद्धाच्या आक्रोशात आणि रणशिंगाच्या आवाजात मोआब","poem":1},{"text":"प्रचंड नाशाने खाली जाईल.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"मी तिच्या शासकाचा नाश करेन","poem":1},{"text":"आणि त्याच्यासोबत तिच्या सर्व अधिकार्‍यांना मारून टाकेन.”","poem":2},{"lineBreak":true},{"text":"असे याहवेह म्हणतात.","poem":2}]},{"type":"verse","number":4,"content":["याहवेह असे म्हणतात:",{"text":"“यहूदीयाच्या तीन नव्हे","poem":1},{"text":"तर चार अपराधांसाठी शासन करण्यापासून मागे फिरणार नाही.","poem":2},{"text":"कारण त्यांनी याहवेहचे नियमशास्त्र धिक्कारले आहे","poem":1},{"text":"व त्यांचे विधी पाळले नाही.","poem":2},{"text":"ज्या दैवतांचे अनुसरण त्यांच्या पूर्वजांनी केले होते","poem":1},{"text":"त्या त्यांच्या खोट्या दैवतांनी","poem":2},{"noteId":5},{"text":"त्यांची दिशाभूल केली होती,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"म्हणून मी यहूदीयावर अग्नी पाठवेन","poem":1},{"text":"आणि यरुशलेमचे किल्ले भस्म करेन.”","poem":2}]},{"type":"heading","content":["इस्राएलचा न्याय"]},{"type":"verse","number":6,"content":["याहवेह असे म्हणतात,",{"text":"“इस्राएलला तीन नव्हे","poem":1},{"text":"तर चार अपराधांसाठी शासन करण्यापासून मी अनुताप करणार नाही.","poem":2},{"text":"चांदीसाठी ते एका न्यायी व्यक्तीला,","poem":1},{"text":"आणि पायातील एका जोड्यासाठी गरजवंत व्यक्तीला विकतात.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ते गरिबांच्या डोक्याला","poem":1},{"text":"भूमिवरील धुळीत पायदळी तुडवितात","poem":2},{"lineBreak":true},{"text":"आणि दीनदुबळ्यांचा न्याय करीत नाही.","poem":2},{"text":"मुलगा व पिता एकाच तरुणीकडे जाऊन","poem":1},{"text":"माझ्या पवित्र नामाला काळिमा लावतात.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"प्रत्येक वेदीजवळ","poem":1},{"text":"गहाण ठेवलेल्या वस्त्रांवर पडून राहतात","poem":2},{"text":"आणि आपल्या दैवतांच्या घरात","poem":1},{"text":"दंड म्हणून घेतलेला द्राक्षारस पितात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“जरी ते गंधसरूंसारखे उंच","poem":1},{"text":"व एलावृक्षांसारखे मजबूत होते,","poem":2},{"lineBreak":true},{"text":"तरी मी त्यांच्यासमोर अमोरी लोकांचा संहार केला.","poem":2},{"text":"मी वरून त्यांचे फळ","poem":1},{"text":"व खालून त्यांचे मूळ नासविले.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"अमोर्‍यांचा देश तुम्हाला द्यावा म्हणून","poem":1},{"text":"मी तुम्हाला इजिप्त देशातून बाहेर आणले","poem":2},{"lineBreak":true},{"text":"व चाळीस वर्षे तुम्हाला रानात चालविले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“तुमच्या मुलांपैकी काहींना संदेष्टे म्हणून","poem":1},{"text":"आणि तरुणांतील काहींना नाजीर होण्याकरिता वाढवले आहे.","poem":2},{"text":"अहो इस्राएलच्या लोकांनो, हे खरे नाही काय?”","poem":1},{"text":"असे याहवेह जाहीर करतात.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“पण तुम्ही नाजीरांना द्राक्षारस पिण्यास","poem":1},{"text":"आणि संदेष्ट्यांना भविष्य न सांगण्याची आज्ञा दिली.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“म्हणून धान्याच्या पेंढ्यांखाली गच्च भरलेली गाडी जशी दबते,","poem":1},{"text":"तसे मी तुम्हाला दाबेन आणि तुम्ही कण्हाल.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"चपळ निसटून जाणार नाहीत,","poem":1},{"text":"शक्तिमानाला आपले सामर्थ्य लावता येणार नाही,","poem":2},{"lineBreak":true},{"text":"आणि वीराला आपला जीव वाचविता येणार नाही.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"धनुर्धार्‍याला आपल्या भूमीवर उभे राहता येणार नाही,","poem":1},{"text":"अत्यंत वेगाने धावणारा सैनिक सुटणार नाही,","poem":2},{"lineBreak":true},{"text":"आणि घोडेस्वाराला आपला जीव वाचवता येणार नाही.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"वीरांपैकी महाधैर्यवानही","poem":1},{"text":"त्या दिवशी वस्त्रे टाकून पळतील.”","poem":2},{"lineBreak":true},{"text":"याहवेह असे जाहीर करतात.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"किंवा तिच्या शहरांना","reference":{"chapter":2,"verse":2}},{"noteId":5,"caller":"+","text":"किंवा खोटेपणाने","reference":{"chapter":2,"verse":4}}]},"thisChapterLink":"/api/mar_cbi/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}