{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"AMO","translationId":"mar_cbi","name":"आमोस","commonName":"आमोस","title":"आमोसाची भविष्यवाणी","order":30,"numberOfChapters":9,"sha256":"d3a39caa40a74928329a3018bdbbeda5c16e65505a9f1962f65988816e699ee4","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/mar_cbi/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"heading","content":["इस्राएलविरुद्ध साक्षीदार बोलाविण्यात येतात"]},{"type":"verse","number":1,"content":["इस्राएलच्या लोकांनो, हे वचन ऐका, जे याहवेह तुमच्याविरुद्ध बोलले आहेत—त्या संपूर्ण घराण्याविरुद्ध आहे ज्यांना मी इजिप्तमधून बाहेर आणले आहे:"]},{"type":"verse","number":2,"content":[{"text":"“पृथ्वीवरील सर्व राष्ट्रातील लोकांमधून","poem":1},{"text":"मी फक्त तुझीच निवड केली आहे;","poem":2},{"text":"म्हणून तुझ्या सर्व पापांबद्दल","poem":1},{"text":"मी तुला शिक्षा करेन.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"दोन व्यक्ती एकमताचे झाल्यावाचून","poem":1},{"text":"ते सोबत चालू शकतील काय?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"शिकार नसली तर","poem":1},{"text":"सिंह गर्जना करेन काय?","poem":2},{"text":"काही धरल्याशिवाय","poem":1},{"text":"तो त्याच्या गुहेत गुरगुरणार काय?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"अमिष नसताना पक्षी","poem":1},{"text":"भूमीवरील सापळ्यात अडकतो काय?","poem":2},{"text":"जर सापळ्यात काही अडकले नसेल","poem":1},{"text":"तर ते भूमीवरून उडेल काय?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"नगरात जेव्हा रणशिंगाचा आवाज येतो,","poem":1},{"text":"तेव्हा लोक घाबरत नाही काय?","poem":2},{"text":"शहरात विपत्ती आली तर,","poem":1},{"text":"ती याहवेहने घडवून आणली नाही काय?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"सार्वभौम याहवेह","poem":1},{"text":"आपल्या सेवक संदेष्ट्यांना त्याच्या योजना प्रकट केल्याशिवाय","poem":2},{"lineBreak":true},{"text":"निश्चितच काहीही करणार नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"सिंहाने गर्जना केली आहे—","poem":1},{"text":"कोण भिणार नाही?","poem":2},{"text":"सार्वभौम याहवेहने बोलले आहेत;","poem":1},{"text":"तर मग संदेश दिल्यावाचून कोणी राहील काय?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"अश्दोदच्या गडांना","poem":1},{"text":"आणि इजिप्तच्या गडांना ही घोषणा करा:","poem":2},{"text":"“शोमरोनच्या पर्वतावर एकत्र व्हा;","poem":1},{"text":"तिच्यामधील गोंधळ","poem":2},{"lineBreak":true},{"text":"आणि तिच्या लोकांवरील अत्याचाराकडे पाहा.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“जे योग्य ते कसे करावे हे त्यांना माहीत नाही,” याहवेह जाहीर करतात,","poem":1},{"text":"“त्यांनी लुटलेला व चोरी केलेला माल","poem":2},{"lineBreak":true},{"text":"त्यांच्या महालात कोणी साठवून ठेवला आहे.”","poem":2}]},{"type":"verse","number":11,"content":["यास्तव सार्वभौम याहवेह असे म्हणतात,",{"text":"“एक शत्रू जो तुमचा देश व्यापून टाकेल,","poem":1},{"text":"तो तुमचे किल्ले कोसळून टाकेल","poem":2},{"lineBreak":true},{"text":"आणि तुमचे गड लुटेल.”","poem":2}]},{"type":"verse","number":12,"content":["याहवेह असे म्हणतात:",{"text":"“जसा मेंढपाळ सिंहाच्या तोंडातून","poem":1},{"text":"केवळ दोन तंगड्या आणि कानाचा एक तुकडा सोडवितो,","poem":2},{"text":"तसे शोमरोनातील इस्राएल लोक","poem":1},{"text":"जे पलंगाच्या शीरपट्टीने","poem":2},{"lineBreak":true},{"text":"आणि बिछान्यावरील","poem":2},{"noteId":6},{"text":"रेशमी कापडाच्या तुकड्याने सोडविले जातील.”","poem":2}]},{"type":"verse","number":13,"content":["“हे ऐका आणि याकोबाच्या घराण्याविरुद्ध साक्ष द्या,” असे याहवेह सर्वसमर्थ परमेश्वर म्हणतात:"]},{"type":"verse","number":14,"content":[{"text":"“ज्या दिवशी मी इस्राएलला तिच्या पातकाबद्दल शिक्षा करेन,","poem":1},{"text":"त्याच दिवशी मी बेथेलमधल्या वेद्यांचा नाश करेन;","poem":2},{"text":"वेद्यांची शिंगे कापून टाकण्यात येतील","poem":1},{"text":"आणि ती जमिनीवर पडतील.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"मी ग्रीष्मकालीनघर","poem":1},{"text":"आणि उष्मकालीनघर पाडून टाकेन;","poem":2},{"text":"हस्तिदंताने सजविलेल्या घरांचा विध्वंस होईल","poem":1},{"text":"भवने जमीनदोस्त होतील,”","poem":2},{"lineBreak":true},{"text":"असे याहवेह जाहीर करतात.","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"किंवा जे इस्राएली लोक शमरोनात बसून आहेत","reference":{"chapter":3,"verse":12}}]},"thisChapterLink":"/api/mar_cbi/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}