{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"AMO","translationId":"mar_cbi","name":"आमोस","commonName":"आमोस","title":"आमोसाची भविष्यवाणी","order":30,"numberOfChapters":9,"sha256":"d3a39caa40a74928329a3018bdbbeda5c16e65505a9f1962f65988816e699ee4","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/mar_cbi/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":4,"content":[{"type":"heading","content":["इस्राएल परमेश्वराकडे परतले नाही"]},{"type":"verse","number":1,"content":[{"text":"शोमरोनच्या डोंगरावर राहणार्‍या बाशानच्या गाईंनो हे वचन ऐका,","poem":1},{"text":"तुम्ही स्त्रिया, ज्या तुम्ही गरिबांवर अत्याचार करता आणि गरजवंतांना चिरडता","poem":2},{"lineBreak":true},{"text":"आणि आपल्या नवर्‍यांना म्हणता, “आम्हाला काही पेय आणा!”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"सार्वभौम याहवेहने आपल्या पवित्रतेची शपथ घेऊन म्हटले आहे:","poem":1},{"text":"“खचितच अशी वेळ येईल","poem":2},{"text":"जेव्हा तुम्हाला आकड्यांनी आणि तुमच्यातील शिल्लक राहिलेल्यांना","poem":1},{"text":"मासे धरण्याच्या गळांनी","poem":2},{"noteId":7},{"text":"ओढून नेतील.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तुमच्यातील प्रत्येक","poem":1},{"text":"भिंतीच्या भगदाडातून सरळ निघून जाल.","poem":2},{"text":"तुम्ही हर्मोनात","poem":1},{"noteId":8},{"text":"आपणाला टाकाल.”","poem":1},{"text":"असे याहवेह म्हणतात.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“बेथेलास जा आणि पाप करा;","poem":1},{"text":"गिलगालास जाऊन आणि अधिक पाप करा.","poem":2},{"text":"रोज सकाळी आपली अर्पणे,","poem":1},{"text":"दर तीन वर्षांनी","poem":2},{"noteId":9},{"text":"आपला दशांश आणा.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"उपकारस्तुती म्हणून खमिराची भाकरी जाळून टाका","poem":1},{"text":"आणि तुमच्या स्वैच्छिक अर्पणांची फुशारकी मारा;","poem":2},{"text":"इस्राएली लोकहो तुम्ही याविषयी बढाई मिरवा,","poem":1},{"text":"कारण असेच करणे तुम्हाला आवडते.”","poem":2},{"lineBreak":true},{"text":"असे सार्वभौम याहवेह जाहीर करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“मी तुम्हाला प्रत्येक शहरात उपाशी पोटी ठेवले","poem":1},{"text":"आणि प्रत्येक नगरात भाकरीची कमतरता केली,","poem":2},{"text":"तरीही तुम्ही मजकडे वळला नाही.”","poem":1},{"text":"असे याहवेह जाहीर करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“हंगामाच्या आधी तीन महिने","poem":1},{"text":"मी पाऊस रोखून धरला.","poem":2},{"text":"मी एका नगरावर पाऊस पाडला,","poem":1},{"text":"पण दुसर्‍यावर पाडला नाही.","poem":2},{"text":"एका शेतावर पाऊस पडला;","poem":1},{"text":"दुसर्‍या शेतावर पाऊस नव्हता आणि ते सुकून गेले.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"पाण्यासाठी लोक नगरोनगरी भटकले","poem":1},{"text":"परंतु त्यांना पिण्यास पुरेसे मिळाले नाही,","poem":2},{"text":"तरीही तुम्ही मजकडे वळला नाही.”","poem":1},{"text":"असे याहवेह जाहीर करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“मी तुमच्या शेतांवर व द्राक्षमळ्यांवर तांबेरा","poem":1},{"text":"आणि भेरड हे रोग पाठविले;","poem":2},{"text":"टोळांनी तुमची अंजिराची व जैतुनाची झाडे खाऊन टाकली,","poem":1},{"text":"आणि तरीही तुम्ही माझ्याकडे वळला नाही,”","poem":2},{"lineBreak":true},{"text":"असे याहवेह जाहीर करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“इजिप्तमध्ये पाठविल्या","poem":1},{"text":"तशा पीडा मी तुमच्यामध्ये पाठविल्या.","poem":2},{"text":"मी तुमच्या तरुणांना","poem":1},{"text":"तुमच्या लुटलेल्या घोड्यांसहित तलवारीने मारून टाकले.","poem":2},{"text":"तुमच्या छावणीतील दुर्गंध तुमच्या नाकात भरला,","poem":1},{"text":"तरीही तुम्ही माझ्याकडे वळला नाही,”","poem":2},{"lineBreak":true},{"text":"असे याहवेह जाहीर करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“तुमच्यातील काहींचा नाश असा केला","poem":1},{"text":"जसा मी, परमेश्वराने, सदोम आणि गमोराचा केला.","poem":2},{"text":"तुम्ही अग्नीच्या भट्टीतून ओढून काढलेल्या जळत्या काठीप्रमाणे होता,","poem":1},{"text":"तरीही तुम्ही माझ्याकडे वळला नाही,”","poem":2},{"lineBreak":true},{"text":"असे याहवेह जाहीर करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“म्हणून हे इस्राएला, मी तझ्यासोबत असेच करणार आहे,","poem":1},{"text":"कारण मी तुझ्याशी असे करणार आहे,","poem":2},{"lineBreak":true},{"text":"म्हणून तुझ्या परमेश्वराला भेटण्यास तयार हो.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ज्यांनी पर्वतांची रचना केली,","poem":1},{"text":"ज्यांनी वारे निर्माण केले,","poem":2},{"lineBreak":true},{"text":"आणि जे आपले विचार मानवजातीला प्रकट करतात,","poem":2},{"text":"जे प्रभात समयाला अंधकारात बदलतात","poem":1},{"text":"आणि पर्वताला आपल्या पायाखाली तुडवितात;","poem":2},{"lineBreak":true},{"text":"याहवेह सर्वसमर्थ परमेश्वर, हे त्यांचे नाव आहे.","poem":2}]}],"footnotes":[{"noteId":7,"caller":"+","text":"किंवा माशांच्या टोपलीत","reference":{"chapter":4,"verse":2}},{"noteId":8,"caller":"+","text":"काही मूळ प्रतींमध्ये तू अत्याचार करणार्‍या पर्वता","reference":{"chapter":4,"verse":3}},{"noteId":9,"caller":"+","text":"किंवा दिवसांनी","reference":{"chapter":4,"verse":4}}]},"thisChapterLink":"/api/mar_cbi/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}