{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"AMO","translationId":"mar_cbi","name":"आमोस","commonName":"आमोस","title":"आमोसाची भविष्यवाणी","order":30,"numberOfChapters":9,"sha256":"d3a39caa40a74928329a3018bdbbeda5c16e65505a9f1962f65988816e699ee4","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/mar_cbi/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["विलापगीत आणि पश्चात्तापासाठी आव्हान"]},{"type":"verse","number":1,"content":["हे इस्राएला, या वचनास ऐक, मी तुझ्याबद्दल विलाप करतो:"]},{"type":"verse","number":2,"content":[{"text":"“इस्राएलची कुमारी पडली आहे,","poem":1},{"text":"ती पुन्हा कधीही उठणार नाही,","poem":2},{"text":"तिच्या स्वतःच्या भूमीत उजाड आहे,","poem":1},{"text":"तिला उठविणारा कोणीही नाही.”","poem":2}]},{"type":"verse","number":3,"content":["कारण सार्वभौम याहवेह इस्राएलास असे म्हणतात:",{"text":"“तुमच्या शहरातून एक हजार शूर निघतात,","poem":1},{"text":"त्यातील शंभरच उरतील;","poem":2},{"text":"तुमच्या शहरातून शंभर निघतात,","poem":1},{"text":"त्यातील दहाच उरतील.”","poem":2}]},{"type":"verse","number":4,"content":["याहवेह इस्राएलाच्या लोकांना असे म्हणतात,",{"text":"“मला शोधा म्हणजे तुम्ही जिवंत राहाल.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"बेथेलचा","poem":2},{"noteId":10},{"text":"शोध करू नका,","poem":2},{"text":"गिलगाल येथे जाऊ नका,","poem":1},{"text":"किंवा बेअर-शेबा येथे प्रवास करू नका.","poem":2},{"text":"कारण गिलगाल खचितच बंदिवासात जाईल,","poem":1},{"text":"आणि बेथेलचा पूर्ण नाश होईल”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"याहवेहचा शोध करा म्हणजे तुम्ही वाचाल,","poem":1},{"text":"नाहीतर याहवेह योसेफाच्या गोत्रावर अग्नीसारखे भडकतील;","poem":2},{"text":"आणि त्याला भस्म करून टाकील,","poem":1},{"text":"आणि बेथेलमध्ये त्याला विझवणारा कोणीही नसेल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"असे लोक आहेत जे न्यायाला कडूपणात बदलतात","poem":1},{"text":"आणि नीतिमत्ता धुळीस मिळवितात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ज्यांनी कृत्तिका नक्षत्रे व मृगशीर्ष नक्षत्रे निर्माण केले,","poem":1},{"text":"जे मध्यरात्रीचे रूपांतर पहाटेत करतात,","poem":2},{"lineBreak":true},{"text":"आणि जे दिवसाचे रूपांतर रात्रीत करतात,","poem":2},{"text":"जे समुद्राच्या पाण्यास बोलवितात","poem":1},{"text":"आणि ते जमिनीच्या पृष्ठभागावर ओततात—","poem":2},{"lineBreak":true},{"text":"याहवेह, हे त्यांचे नाव आहे.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"अंधारी आणणाऱ्या क्षणिक प्रकाशाने ते किल्ला उद्ध्वस्त करतात","poem":1},{"text":"आणि तटबंदी असलेल्या शहराचा नाश करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"असे लोक आहे जे न्यायालयात न्यायाची बाजू घेणार्‍यांचा द्वेष","poem":1},{"text":"आणि सत्य बोलणार्‍यांचा तिरस्कार करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"तुम्ही गरिबांच्या पेंढ्यावरही कर लावता आणि त्यांच्या धान्यावरही कर लावता.","poem":1},{"text":"म्हणून जरी स्वतःसाठी चिरेबंदी भवन बांधले असतील","poem":2},{"text":"तरी त्यामध्ये कधीही राहणार नाही,","poem":1},{"text":"किंवा तुम्ही लावत असलेल्या भरघोस पीक देणार्‍या रमणीय","poem":2},{"text":"जरी तुम्ही कसदार द्राक्षमळा लावला","poem":1},{"text":"तरी त्यातील द्राक्षारस कधीच पिऊ शकणार नाही.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"कारण तुमचे अपराध किती अधिक","poem":1},{"text":"आणि तुमची पातके किती घोर आहेत हे मला माहीत आहे.","poem":2},{"lineBreak":true},{"text":"निरपराधांवर अत्याचार करून लाच घेतात","poem":1},{"text":"व गरिबांना न्यायालयात न्याय मिळण्यापासून वंचित करतात असेही लोक आहेत.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"अशा वेळी जे शहाणे आहेत ते मौन धरतात,","poem":1},{"text":"कारण वेळ वाईट आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"वाईट नको, तर चांगले ते शोधा,","poem":1},{"text":"म्हणजे तुम्ही जगाल.","poem":2},{"text":"तुम्ही जसे ते म्हणतात त्याचप्रमाणे","poem":1},{"text":"याहवेह सर्वसमर्थ परमेश्वर तुमच्यासोबत असतील.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"दुष्टाईचा द्वेष करा, चांगल्यावर प्रीती करा;","poem":1},{"text":"न्यायालयात न्याय स्थापित करा.","poem":2},{"text":"मग कदाचित याहवेह सर्वसमर्थ परमेश्वर","poem":1},{"text":"योसेफाच्या उरलेल्या लोकांवर दया करतील.","poem":2}]},{"type":"verse","number":16,"content":["यास्तव प्रभू, याहवेह सर्वसमर्थ परमेश्वर असे म्हणतात:",{"text":"“सर्व रस्त्यांवर विलाप होईल","poem":1},{"text":"आणि प्रत्येक चौकात आक्रंदन होईल.","poem":2},{"text":"तुमच्याबरोबर शोक करण्यासाठी शेतकर्‍यांनाही बोलाविले जाईल;","poem":1},{"text":"रडण्यासाठी शोक करणार्‍यांना बोलाविले जाईल.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"प्रत्येक द्राक्षमळ्यामध्ये आक्रंदन होईल,","poem":1},{"text":"कारण मी तुमच्यामधून जाईन,”","poem":2},{"lineBreak":true},{"text":"असे याहवेह म्हणतात.","poem":2}]},{"type":"heading","content":["याहवेहचा दिवस"]},{"type":"verse","number":18,"content":[{"text":"जे याहवेहच्या दिवसाची इच्छा बाळगतात","poem":1},{"text":"त्यांच्या धिक्कार असो!","poem":2},{"text":"तुम्ही याहवेहच्या दिवसाची इच्छा का बाळगता?","poem":1},{"text":"कारण तो दिवस प्रकाशाचा नाही तर अंधाराचा असेल.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"जसे काय एखादा मनुष्य सिंहापासून पळाला","poem":1},{"text":"आणि त्याला अस्वलाने गाठले,","poem":2},{"text":"किंवा जसे काय आपल्या घरात येऊन त्याने","poem":1},{"text":"हात भिंतीला टेकविला","poem":2},{"lineBreak":true},{"text":"आणि त्याला साप चावला.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"याहवेहचा दिवस हा प्रकाशाचा नसून अंधकाराचा दिवस असेल;","poem":1},{"text":"गडद अंधकार, प्रकाशाचा एकही किरण नसेल?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“मला तुमच्या धार्मिक उत्सवांचा तिरस्कार वाटतो;","poem":1},{"text":"तुमच्या सभा माझ्यासाठी दुर्गंधीप्रमाणे आहेत.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"तुमची गोऱ्ह्यांची होमार्पणे व उपकारस्तुतीची अर्पणे आणली तरीही","poem":1},{"text":"मी स्वीकारणार नाही.","poem":2},{"text":"तुमच्या उत्तम शांत्यर्पणामुळे","poem":1},{"text":"मी संतुष्ट होणार नाही.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"तुमच्या गीतांचा गोंगाट माझ्यापासून दूर ठेवा!","poem":1},{"text":"मी तुमच्या वीणांचे संगीत ऐकणार नाही.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"परंतु न्याय नदीप्रमाणे","poem":1},{"text":"व नीतिमत्ता प्रचंड लोंढ्याप्रमाणे वाहू द्या!","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“अहो इस्राएल लोकहो, रानात असताना","poem":1},{"text":"चाळीस वर्षे तुम्ही मला अर्पणे आणली व होम केले काय?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"तुम्ही तुमच्या राजाचा देव्हारा,","poem":1},{"text":"तुमच्या काइवान","poem":2},{"noteId":11},{"text":"मूर्तीची बैठक,","poem":2},{"lineBreak":true},{"text":"तुमच्या दैवताचा तारा","poem":2},{"noteId":12},{"text":"उंचाविला;","poem":2},{"lineBreak":true},{"text":"जो तुम्ही तुमच्यासाठी बनविला.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"म्हणून मी तुम्हाला, दिमिष्कच्या पलीकडे बंदिवासात पाठवेन,”","poem":1},{"text":"असे याहवेह म्हणतात, ज्यांचे नाव सर्वसमर्थ परमेश्वर आहे.","poem":2}]}],"footnotes":[{"noteId":10,"caller":"+","text":"बेथेल बेथ-आवेनचा संकेत","reference":{"chapter":5,"verse":5}},{"noteId":11,"caller":"+","text":"काइवान किंवा किय्यून","reference":{"chapter":5,"verse":26}},{"noteId":12,"caller":"+","text":"दैवताचा तारा किंवा तुमचा राजा साक्कुथ आणि तुमचे दैवत रेफानचा तारा","reference":{"chapter":5,"verse":26}}]},"thisChapterLink":"/api/mar_cbi/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}