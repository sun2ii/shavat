{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"AMO","translationId":"mar_cbi","name":"आमोस","commonName":"आमोस","title":"आमोसाची भविष्यवाणी","order":30,"numberOfChapters":9,"sha256":"d3a39caa40a74928329a3018bdbbeda5c16e65505a9f1962f65988816e699ee4","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/mar_cbi/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":6,"content":[{"type":"heading","content":["ऐषोरामी इस्राएलचा धिक्कार"]},{"type":"verse","number":1,"content":[{"text":"तुम्ही जे सीयोनेत आरामात राहता,","poem":1},{"text":"आणि शोमरोनच्या पर्वतावर निश्चिंत असण्याचा विचार करता की","poem":2},{"text":"तुम्ही जे राष्ट्रातील मुख्य लोक आहात,","poem":1},{"text":"ज्यांच्याजवळ इस्राएलचे लोक येतात, त्या तुमचा धिक्कार असो!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"कालनेह येथे जा आणि तिला पाहा;","poem":1},{"text":"तिथून महान हमाथास जा,","poem":2},{"lineBreak":true},{"text":"आणि तिथून खाली पलिष्ट्यांच्या गथ येथे जा.","poem":2},{"text":"हे तुमच्या दोन राज्याहून अधिक उत्तम आहेत काय?","poem":1},{"text":"त्यांचा देश तुमच्या देशाहून मोठा आहे काय?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तुम्ही विपत्तीचे दिवस बाजूला सारता,","poem":1},{"text":"आणि दहशतीचे राज्य जवळ आणता.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तुम्ही हस्तिदंतांनी सजविलेल्या पलंगावर लोळता;","poem":1},{"text":"आणि तुम्ही अंथरुणावर पडून राहतात.","poem":2},{"text":"उत्तम कोकरे","poem":1},{"text":"आणि चरबीयुक्त वासरे खाता.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तुम्ही वीणेच्या सुरावर निरर्थक गाणी गाता,","poem":1},{"text":"आणि दावीदासारखे आहोत याची भ्रामक कल्पना करता.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तुम्ही वाट्या भरून द्राक्षारस पिता.","poem":1},{"text":"उत्तम तेलांनी स्वतःला माखता,","poem":2},{"lineBreak":true},{"text":"परंतु तुम्ही योसेफाच्या नाशाबद्दल दुःख करत नाही.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"म्हणून तुम्ही प्रथम बंदिवासात जाल;","poem":1},{"text":"आणि तुमची चैनबाजी आणि मौज मस्ती नाहीशी होईल.","poem":2}]},{"type":"heading","content":["याहवेह इस्राएलाच्या गर्विष्ठपणाचा तिरस्कार करतात"]},{"type":"verse","number":8,"content":["सार्वभौम याहवेहनी स्वतः शपथ घेतली आहे—याहवेह सर्वसमर्थ परमेश्वर घोषणा करतात:",{"text":"“याकोबाच्या गर्वाचा मी तिरस्कार करतो","poem":1},{"text":"आणि त्यांचे किल्ले मी घृणास्पद मानतो;","poem":2},{"text":"मी या शहराला आणि तिच्यातील सर्वकाही","poem":1},{"text":"शत्रूंच्या हाती देईन.”","poem":2}]},{"type":"verse","number":9,"content":["जर एका घरात फक्त दहाच लोक उरले असले तरीही ते सर्व मरतील."]},{"type":"verse","number":10,"content":["आणि मृतदेह जाळण्यासाठी",{"noteId":13},"घरातून बाहेर काढायला आलेल्या त्याच्या नातेवाईकांनी तिथे लपून बसलेल्या कोणाला विचारले तर तुझ्यासोबत आणखी कोणी आहे काय? आणि तो म्हणेल, “नाही,” तो त्याला पुढे म्हणेल, “गप्प राहा, याहवेहचे नाव घेऊ नको.”"]},{"type":"verse","number":11,"content":[{"text":"कारण याहवेहने अशी आज्ञा दिली आहे,","poem":1},{"text":"आणि ते मोठ्या घरांचे तुकडे तुकडे","poem":2},{"lineBreak":true},{"text":"आणि लहान घरांना चक्काचूर करतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"घोडे खडकाळ कडांवर पळतात काय?","poem":1},{"text":"बैल घेऊन कोणी समुद्र नांगरतो काय?","poem":2},{"text":"पण तुम्ही न्यायाला विषामध्ये","poem":1},{"text":"आणि नीतिमत्तेच्या फळाला कडवटपणामध्ये बदलले आहे;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"लो-देबारला","poem":1},{"noteId":14},{"text":"आपल्या ताब्यात घेण्यात तुम्ही आनंद मानता","poem":1},{"text":"आणि म्हणता, “आम्ही स्वतःच्या बळाने करनाईम","poem":2},{"noteId":15},{"text":"घेतला नाही काय?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"याहवेह, सर्वसमर्थ परमेश्वर जाहीर करतात,","poem":1},{"text":"“हे इस्राएला, मी तुझ्याविरुद्ध एक राष्ट्र उठवेन,","poem":2},{"text":"लेबो हमाथपासून अराबाच्या ओहोळापर्यंत","poem":1},{"text":"ते तुझ्यावर जुलूम करेल.”","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"किंवा मृत व्यक्तीच्या सन्मानार्थ","reference":{"chapter":6,"verse":10}},{"noteId":14,"caller":"+","text":"लो-देबार म्हणजे क्षुल्लक","reference":{"chapter":6,"verse":13}},{"noteId":15,"caller":"+","text":"करनाईम म्हणजे शिंग","reference":{"chapter":6,"verse":13}}]},"thisChapterLink":"/api/mar_cbi/AMO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/AMO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/AMO/5.json","previousChapterAudioLinks":{},"numberOfVerses":14}