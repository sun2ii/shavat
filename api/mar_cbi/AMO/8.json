{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"AMO","translationId":"mar_cbi","name":"आमोस","commonName":"आमोस","title":"आमोसाची भविष्यवाणी","order":30,"numberOfChapters":9,"sha256":"d3a39caa40a74928329a3018bdbbeda5c16e65505a9f1962f65988816e699ee4","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/mar_cbi/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":8,"content":[{"type":"heading","content":["पिकलेल्या फळांची टोपली"]},{"type":"verse","number":1,"content":["सार्वभौम याहवेहने मला हे दाखविले: पिकलेल्या फळांनी भरलेली एक टोपली दाखविली."]},{"type":"verse","number":2,"content":["“आमोसा, तुला काय दिसते?” त्यांनी विचारले. मी उत्तर दिले, “मला पिकलेल्या फळांची एक टोपली दिसते.” मग याहवेह मला म्हणाले, “माझ्या इस्राएली लोकांचा समय परिपक्व झाला आहे; मी त्यांची गय करणार नाही.”"]},{"type":"verse","number":3,"content":["सार्वभौम याहवेह घोषित करतात, “त्या दिवशी, मंदिरातील त्यांचे गीत मी आकांतात बदलेन.",{"noteId":16},"सर्वत्र अनेक मृतदेह मौन धरून पडलेली असतील!”"]},{"type":"verse","number":4,"content":[{"text":"जे तुम्ही गरजवंतांना तुडवितात","poem":1},{"text":"आणि देशाच्या गरिबांना दूर लोटता,","poem":2}]},{"type":"verse","number":5,"content":["असे म्हणता,",{"text":"“अमावस्या केव्हा निघून जाईल","poem":1},{"text":"म्हणजे आम्ही धान्य विकू शकू?","poem":2},{"text":"आणि शब्बाथ केव्हा निघून जाईल,","poem":1},{"text":"म्हणजे आम्ही धान्याचे कोठार उघडू?”","poem":2},{"text":"तराजूत लबाडी करून,","poem":1},{"text":"लबाडीच्या मापाने,","poem":2},{"lineBreak":true},{"text":"किंमत वाढवू.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"म्हणजे चांदीच्या मापात गरिबांना","poem":1},{"text":"आणि पायतणाच्या एका जोडीसाठी गरजूंना विकत घेऊ,","poem":2},{"lineBreak":true},{"text":"आणि गव्हाचा भुसाही विकायचा.","poem":2}]},{"type":"verse","number":7,"content":["याकोबाचे वैभव असलेले याहवेह यांनी स्वतःची शपथ घेऊन सांगितले आहेः “मी त्यांनी जे केले ते कधीही विसरणार नाही!"]},{"type":"verse","number":8,"content":[{"text":"“यामुळे पृथ्वी थरथर कापणार नाही काय,","poem":1},{"text":"आणि तिच्यात राहणारे सर्व शोक करणार नाहीत काय?","poem":2},{"text":"संपूर्ण पृथ्वी नाईल नदीसारखी उठेल;","poem":1},{"text":"ती नील नदीप्रमाणे खवळेल","poem":2},{"lineBreak":true},{"text":"आणि मग इजिप्तच्या नदीप्रमाणे बुडून जाईल.","poem":2}]},{"type":"verse","number":9,"content":["“त्या दिवशी,” सार्वभौम याहवेह घोषणा करतात,",{"text":"“दुपारच्या वेळी मी सूर्यास्त करेन","poem":1},{"text":"आणि भरदिवसा पृथ्वीला अंधकारमय करेन.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"मी तुमचे धार्मिक उत्सव शोकामध्ये उलटवेन","poem":1},{"text":"आणि तुमची सर्व गीते विलापात बदलून टाकीन.","poem":2},{"text":"मी तुम्हा सर्वांना गोणपाट घालेन","poem":1},{"text":"आणि तुमचे मुंडण करेन.","poem":2},{"text":"मी तो काळ एकुलत्या एक मुलासाठी विलाप करण्यासारखा","poem":1},{"text":"आणि त्याचा शेवट कडू दिवसासारखा करेन.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“असे दिवस येत आहेत,” सार्वभौम याहवेह घोषित करतात,","poem":1},{"text":"“मी देशावर दुष्काळ आणेन—","poem":2},{"text":"तो अन्नाचा दुष्काळ किंवा पाण्याची तहान नव्हे,","poem":1},{"text":"तर याहवेहचे वचन ऐकण्याचा दुष्काळ पाडेन—","poem":2}]},{"type":"verse","number":12,"content":[{"text":"आणि लोक याहवेहच्या वचनाच्या शोधात","poem":1},{"text":"समुद्रापासून समुद्रापर्यंत","poem":2},{"text":"आणि उत्तरेपासून पूर्वेकडे भटकतील,","poem":1},{"text":"पण त्यांना ते सापडणार नाही.","poem":2}]},{"type":"verse","number":13,"content":["“त्या दिवसात",{"text":"“तहानेने व्याकूळ होऊन सुंदर कुमारी","poem":1},{"text":"आणि उमदे तरुण निस्तेज होऊन जातील.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"जे शोमरोनच्या पापाची शपथ घेतात;","poem":1},{"text":"जे म्हणतात, ‘हे दान, तुझ्या दैवतेची शपथ’","poem":2},{"lineBreak":true},{"text":"किंवा ‘बेअर-शेबाच्या दैवतेची","poem":2},{"noteId":17},{"text":"शपथ,’—","poem":2},{"lineBreak":true},{"text":"ते असे पडतील की पुन्हा कधीही उठणार नाहीत.”","poem":2}]}],"footnotes":[{"noteId":16,"caller":"+","text":"किंवा मंदिरात गीत गाणारे आकांत करतील","reference":{"chapter":8,"verse":3}},{"noteId":17,"caller":"+","text":"किंवा मार्गाची","reference":{"chapter":8,"verse":14}}]},"thisChapterLink":"/api/mar_cbi/AMO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/AMO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/AMO/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}