{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"AMO","translationId":"mar_cbi","name":"आमोस","commonName":"आमोस","title":"आमोसाची भविष्यवाणी","order":30,"numberOfChapters":9,"sha256":"d3a39caa40a74928329a3018bdbbeda5c16e65505a9f1962f65988816e699ee4","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/mar_cbi/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":9,"content":[{"type":"heading","content":["इस्राएलचा नाश करण्यात येईल"]},{"type":"verse","number":1,"content":["मी प्रभूला वेदीजवळ उभे असलेले पाहिले आणि ते म्हणाले:",{"text":"“खांबांच्या वरच्या भागावर प्रहार करा","poem":1},{"text":"म्हणजे उंबरठे हलतील.","poem":2},{"text":"आणि ते सर्व लोकांच्या डोक्यावर खाली पाड;","poem":1},{"text":"जे त्यातून वाचतील त्यांना मी तलवारीने मारून टाकीन.","poem":2},{"text":"एक सुद्धा वाचणार नाही,","poem":1},{"text":"कोणीही निसटणार नाही.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"खोल खणीत ते अधोलोकापर्यंत जाऊन पोहोचले,","poem":1},{"text":"तरी तिथे जाऊन माझ्या हात त्यांना वर ओढून आणेन;","poem":2},{"text":"वर चढत ते आकाशापर्यंत आले,","poem":1},{"text":"तरी तिथूनही मी त्यांना खाली आणेन.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"कर्मेल पर्वताच्या शिखरावर ते लपून राहिले,","poem":1},{"text":"तरी मी त्यांची शिकार करून त्यांना पकडेन.","poem":2},{"text":"ते महासागराच्या तळाशी माझ्या दृष्टिआड लपून बसले तरी,","poem":1},{"text":"मी सर्पाला त्यांना चावा घेण्याची आज्ञा देईन.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"जरी शत्रूंनी त्यांना कैद करून बंदिवासात नेले,","poem":1},{"text":"तरी मी तलवारीला त्यांना ठार मारण्याची आज्ञा देईन.","poem":2},{"lineBreak":true},{"text":"“मी त्यांच्यावर माझी नजर ठेवेन","poem":1},{"text":"ती तर हानीसाठी असणार भल्यासाठी नाही.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"प्रभू, सेनाधीश याहवेह—","poem":1},{"lineBreak":true},{"text":"भूमीला स्पर्श करतात आणि ती विरघळून जाते,","poem":1},{"text":"आणि त्यामध्ये राहणारे सर्व लोक शोक करतात.","poem":2},{"text":"संपूर्ण देश नाईल नदीसारखा वर येतो","poem":1},{"text":"आणि इजिप्तच्या नदीप्रमाणे खाली बुडतो;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ते आकाशात आपले भव्य राजवाडे बांधतात","poem":1},{"text":"आणि त्याचा पाया पृथ्वीवर ठेवतात;","poem":2},{"text":"ते समुद्राच्या पाण्याला बोलवितात","poem":1},{"text":"आणि ते पृथ्वीच्या पृष्ठभागावर ओततात;","poem":2},{"lineBreak":true},{"text":"याहवेह हे त्यांचे नाव आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“तुम्ही इस्राएली लोक","poem":1},{"text":"माझ्यासाठी कूशी लोकांसारखेच नाहीत काय?”","poem":2},{"lineBreak":true},{"text":"असे याहवेह घोषित करतात.","poem":2},{"text":"“मी इस्राएल लोकांना इजिप्त देशातून,","poem":1},{"text":"पलिष्ट्यांना कफतोरातून","poem":2},{"lineBreak":true},{"text":"आणि अरामी लोकांना कीर देशातून बाहेर काढले नाही काय?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“खचितच, सार्वभौम याहवेहची दृष्टी","poem":1},{"text":"या पापी राज्यावर आहे.","poem":2},{"text":"आणि मी त्यांचा","poem":1},{"text":"पृथ्वीच्या पृष्ठभागावरून नाश करेन;","poem":2},{"text":"तरीसुद्धा मी याकोबाच्या संतानांचा","poem":1},{"text":"कायमचा नाश करणार नाही,”","poem":2},{"lineBreak":true},{"text":"असे याहवेह घोषित करतात.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“तर पाहा, मी आज्ञा करेन","poem":1},{"text":"आणि जसे चाळणीने धान्य चाळावे","poem":2},{"lineBreak":true},{"text":"त्याप्रमाणे इस्राएलला","poem":2},{"text":"इतर राष्ट्रांनी चाळावे,","poem":1},{"text":"पण त्याचा एक खडाही भूमीवर पडणार नाही.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"माझ्या लोकांतील","poem":1},{"text":"जे सर्व पापी म्हणतात,","poem":2},{"text":"‘संकटे आमच्यावर येणार नाही वा आम्हाला गाठणार नाहीत,","poem":1},{"text":"ते तलवारीने मरतील.’","poem":2}]},{"type":"heading","content":["इस्राएलचे पुनर्वसन"]},{"type":"verse","number":11,"content":["“त्या दिवशी",{"text":"“दावीदाचा पतन झालेला आश्रय मी पुनर्स्थापित करेन;","poem":1},{"text":"मी तिची तुटलेली तटबंदी दुरुस्त करेन,","poem":2},{"lineBreak":true},{"text":"आणि तिचे अवशेष दुरुस्त करेन—","poem":2},{"lineBreak":true},{"text":"आणि पूर्वीसारखीच तिची पुनर्बांधणी करेन,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"यासाठी की त्यांनी एदोमच्या अवशेषांवर","poem":1},{"text":"व माझे नाव धारण करणार्‍या सर्व राष्ट्रांचा ताबा घ्यावा,","poem":2},{"noteId":18},{"text":"”","poem":2},{"lineBreak":true},{"text":"ही कार्ये करणारे याहवेह ही घोषणा करतात.","poem":2}]},{"type":"verse","number":13,"content":["“ते दिवस येत आहेत,” याहवेह जाहीर करतात,",{"text":"“जेव्हा नांगरणारा कापणी करणार्‍याला","poem":1},{"text":"आणि द्राक्षे तुडविणारा बी पेरणार्‍याला मागे टाकेल.","poem":2},{"text":"नवीन द्राक्षारस पर्वतांवरून गळू लागेल","poem":1},{"text":"आणि ते सर्व टेकड्यांवरून वाहू लागेल,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"मी माझ्या इस्राएली लोकांना बंदिवासातून परत आणेन.","poem":2},{"noteId":19},{"lineBreak":true},{"text":"“ते त्यांच्या उद्ध्वस्त झालेल्या नगरांची पुनर्बांधणी करून त्यात राहतील.","poem":1},{"text":"ते द्राक्षमळे लावतील आणि त्याचा द्राक्षारस पितील;","poem":2},{"lineBreak":true},{"text":"ते बागा लावतील आणि त्याची फळे खातील.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"मी इस्राएलला त्यांच्या स्वतःच्या भूमीमध्ये पेरीन,","poem":1},{"text":"मी त्यांना दिलेल्या भूमीतून त्यांना पुन्हा उपटून","poem":2},{"lineBreak":true},{"text":"टाकण्यात येणार नाही.”","poem":2},"असे याहवेह तुमचे परमेश्वर म्हणतात."]}],"footnotes":[{"noteId":18,"caller":"+","text":"मुळात जी राष्ट्रे माझे नाव धारण करतात ते माझा शोध करो","reference":{"chapter":9,"verse":12}},{"noteId":19,"caller":"+","text":"किंवा माझ्या इस्राएल लोकांची समृद्धी मी परत आणेन","reference":{"chapter":9,"verse":14}}]},"thisChapterLink":"/api/mar_cbi/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/OBA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}