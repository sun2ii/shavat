{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"DEU","translationId":"mar_cbi","name":"अनुवाद","commonName":"अनुवाद","title":"अनुवादाचे पुस्तक","order":5,"numberOfChapters":34,"sha256":"77b84ee826bafeeaa06bf214f29b32d43f6e881940fa214f3a2e715724649e7e","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/mar_cbi/DEU/34.json","totalNumberOfVerses":958},"chapter":{"number":33,"content":[{"type":"heading","content":["मोशे इस्राएली गोत्रांना आशीर्वाद देतो"]},{"type":"verse","number":1,"content":["परमेश्वराचा मनुष्य मोशेने आपल्या मरणापूर्वी इस्राएली लोकांना आशीर्वाद जाहीर केले."]},{"type":"verse","number":2,"content":["तो म्हणाला:",{"text":"“याहवेह सीनाय पर्वतावरून आले","poem":1},{"text":"आणि सेईरावर ते सूर्याप्रमाणे उदय पावले;","poem":2},{"lineBreak":true},{"text":"पारान पर्वतावरून ते प्रकाशले.","poem":2},{"text":"असंख्य पवित्र जनांचा समुदाय त्यांच्याबरोबर होता.","poem":1},{"text":"दक्षिण दिशेने, त्यांच्या पर्वत उतरणीवरून ते खाली आले.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"निश्चित तुम्हीच आपल्या लोकांवर प्रीती करता;","poem":1},{"text":"सर्व पवित्रजन तुमच्या अधीन आहेत.","poem":2},{"text":"ते तुमच्या चरणाशी नमन करतात,","poem":1},{"text":"आणि तुमच्याकडून ते आज्ञा स्वीकारतात,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मोशेने आम्हाला जे नियम दिले,","poem":1},{"text":"ते नियम याकोबाच्या सभेचे अमोल वतन आहे.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"इस्राएलच्या गोत्रांबरोबर","poem":1},{"text":"जेव्हा इस्राएलच्या लोकांचे पुढारी एकत्र जमले,","poem":2},{"lineBreak":true},{"text":"तेव्हा याहवेह यशुरून","poem":2},{"noteId":11},{"text":"लोकांचे राज्यकर्ता झाले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“रऊबेन जिवंत राहो व त्यास मृत्यू न येवो,","poem":1},{"text":"त्याची माणसे कमी न होवोत.”","poem":2}]},{"type":"verse","number":7,"content":["आणि तो यहूदाहबद्दल असे म्हणाला:",{"text":"“हे याहवेह, यहूदाहचा धावा ऐका;","poem":1},{"text":"आणि त्याला आपल्या लोकांजवळ आणा.","poem":2},{"text":"स्वतःच्या हाताने ते त्याचे संरक्षण करतात,","poem":1},{"text":"तुम्हीच त्याच्यासाठी त्याच्या शत्रूविरुद्ध साहाय्य व्हा!”","poem":2}]},{"type":"verse","number":8,"content":["मग तो लेवी विषयी म्हणाला:",{"text":"“तुमचे उरीम व थुम्मीम,","poem":1},{"text":"तुमच्या विश्वसनीय लोकांच्या अधिकारात कायम राहोत.","poem":2},{"text":"ज्यांची तुम्ही मस्सा येथे परीक्षा घेतली; आणि मरीबाहच्या झर्‍याजवळ","poem":1},{"text":"तुम्ही त्यांच्याशी झुंज दिली.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"आपले आई आणि वडील यांच्याबद्दल त्याने म्हटले,","poem":1},{"text":"‘ते माझे कोणीही नाहीत.’","poem":2},{"text":"त्याने आपल्या बांधवांना ओळखले नाही,","poem":1},{"text":"किंवा आपल्या संततीस ओळखले नाही,","poem":2},{"text":"परंतु त्याने तुमच्या आज्ञांचे पालन केले,","poem":1},{"text":"आणि तुमच्या कराराशी ते प्रामाणिक राहिले.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ते तुमचे विधी याकोबाला,","poem":1},{"text":"आणि तुमचे नियमशास्त्र इस्राएली लोकांना शिकवतील.","poem":2},{"text":"धूपाच्या वेदीवर ते धूप जाळतील,","poem":1},{"text":"व तुमच्या वेदीवर संपूर्ण होमबली अर्पितील.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"हे याहवेह, त्यांचे सर्व कौशल्य आशीर्वादित करा,","poem":1},{"text":"आणि त्यांची हस्तकृती तुम्हाला प्रसन्न करो.","poem":2},{"text":"त्यांच्याविरुद्ध जे उठतात त्यांना चिरडून टाका,","poem":1},{"text":"आणि ते पुन्हा उठणार नाहीत, असे करा.”","poem":2}]},{"type":"verse","number":12,"content":["मोशे बिन्यामीनाबद्दल म्हणाला:",{"text":"“याहवेहचा लाडका त्यांच्याजवळ सुरक्षित राहो,","poem":1},{"text":"कारण दिवसभर याहवेह त्याची ढाल होऊन त्याला आपली सुरक्षा प्रदान करतात,","poem":2},{"lineBreak":true},{"text":"आणि जो याहवेहला प्रिय आहे तो त्यांच्या दोन्ही खांद्यामध्ये सुरक्षित आहे.”","poem":2}]},{"type":"verse","number":13,"content":["तो योसेफाबद्दल म्हणाला:",{"text":"“याहवेह स्वर्गातील मौल्यवान दवाने,","poem":1},{"text":"आणि पृथ्वीच्या खोलात असलेल्या जलाने","poem":2},{"lineBreak":true},{"text":"त्याच्या भूमीला आशीर्वादित करोत;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"सूर्यप्रकाशाने मिळणारे उत्तम उत्पादन,","poem":1},{"text":"आणि चंद्राच्या प्रभावाने मिळणाऱ्या उत्तम गोष्टी त्याला प्राप्त होवो;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"प्राचीन पर्वतामधून प्राप्त होणार्‍या सर्वोत्तम वस्तूंनी","poem":1},{"text":"आणि सनातन डोंगरातून मिळणार्‍या निवडक फळांनी भरून जावो;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"जी पृथ्वीच्या विपुलतेची सर्वोत्तम भेट,","poem":1},{"text":"आणि जळत्या झुडूपातून बोलणार्‍या त्या प्रभूच्या कृपादृष्टीने तो समृद्ध होवो.","poem":2},{"text":"योसेफाच्या व त्याच्या वंशजाच्या","poem":1},{"noteId":12},{"text":"मस्तकावर हे सर्व आशीर्वाद येवोत,","poem":1},{"text":"जो आपल्या भाऊबंदांत प्रमुख होता.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"प्रथम जन्मलेल्या बैलासारखे त्याचे वैभव आहे;","poem":1},{"text":"त्याची शिंगे रानबैलाची शिंगे आहेत,","poem":2},{"text":"त्या शिंगानी तो राष्ट्रांना,","poem":1},{"text":"पृथ्वीच्या दिगंती असलेल्यांना देखील भोसकतो.","poem":2},{"text":"एफ्राईमाचे लाखो वंशज","poem":1},{"text":"आणि मनश्शेहचे हजारो वंशज असे आहेत.”","poem":2}]},{"type":"verse","number":18,"content":["जबुलूनाविषयी तो म्हणाला:",{"text":"“जबुलूना, तुझा प्रवास तुझ्यासाठी आनंदाचा होवो","poem":1},{"text":"आणि तू इस्साखारा, आपल्या डेऱ्यात उल्हास करो.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ते लोकांना डोंगरावर बोलवतील","poem":1},{"text":"व तिथे न्याययुक्त अशी यज्ञार्पणे वाहतील;","poem":2},{"text":"समुद्रातून मिळविलेल्या उत्पन्नाचे ते स्वामी होतील,","poem":1},{"text":"वाळूतून आपले गुप्तधन काढतील.”","poem":2}]},{"type":"verse","number":20,"content":["गादाविषयी तो म्हणाला:",{"text":"“धन्य आहे गादाचा विस्तार!","poem":1},{"text":"गाद सिंहासारखा जीवन जगतो,","poem":2},{"lineBreak":true},{"text":"झडप घालून तो भुजा आणि डोके फोडतो.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"त्याने स्वतःसाठी सर्वाेत्तम अशी भूमी निवडली आहे;","poem":1},{"text":"पुढार्‍यासाठी राखून ठेवलेली जमीन त्याला मिळाली आहे.","poem":2},{"text":"वंशपित्यांच्या सभेत त्याने","poem":1},{"text":"इस्राएलाकरिता याहवेहच्या नीतिपर इच्छेचे","poem":2},{"lineBreak":true},{"text":"आणि याहवेहच्या न्यायाचे पालन केले.”","poem":2}]},{"type":"verse","number":22,"content":["दानाविषयी तो म्हणाला:",{"text":"“दान हा सिंहाच्या छाव्यासारखा आहे,","poem":1},{"text":"बाशानातून तो सिंहासारखी झेप घेतो.”","poem":2}]},{"type":"verse","number":23,"content":["नफताली विषयी तो म्हणाला:",{"text":"“नफताली याहवेहच्या सर्व आशीर्वादांनी तृप्त आहे","poem":1},{"text":"आणि त्यांच्या कृपेत परिपूर्ण आहे;","poem":2},{"lineBreak":true},{"text":"तो सागरापर्यंतचा दक्षिण भाग वतन करून घेईल.”","poem":2}]},{"type":"verse","number":24,"content":["आशेराविषयी तो म्हणाला:",{"text":"“आशेर हा पुत्रांपैकी सर्वात धन्य आहे;","poem":1},{"text":"त्याला सर्व भावांची कृपादृष्टी प्राप्त होवो","poem":2},{"lineBreak":true},{"text":"आणि त्याचे पाय तेलाने धुतले जावोत.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"लोखंड आणि काशांच्या अडसरांनी त्याच्या शहराचे रक्षण होवो,","poem":1},{"text":"आणि तुझे सामर्थ्य तुझ्या जीवनमानाइतके असो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“यशुरूनच्या परमेश्वरासमान कोणी नाही,","poem":1},{"text":"ते आपल्या वैभवाच्या मेघावर आरूढ होऊन,","poem":2},{"lineBreak":true},{"text":"आकाशमंडळातून तुझ्या साहाय्यार्थ धावून येतात.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"सनातन परमेश्वर तुमचा आश्रय आहे,","poem":1},{"text":"आणि सनातन बाहू तुझ्याखाली आहेत.","poem":2},{"text":"तुझ्या शत्रूंना ते तुझ्यापुढून घालवून देतात,","poem":1},{"text":"‘त्यांचा नाश करा!’ असा ते आदेश देतात.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"म्हणून इस्राएल सुरक्षितेत जगेल;","poem":1},{"text":"याकोबास संरक्षण","poem":2},{"noteId":13},{"text":"प्राप्त होईल,","poem":2},{"text":"धान्य आणि नव्या द्राक्षारसाने समृद्ध असलेल्या","poem":1},{"text":"आणि आकाशातील जलांच्या दवबिंदूंनी सिंचित होणार्‍या भूमीत तो सुरक्षित राहील.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"इस्राएला, तू आशीर्वादित आहेस!","poem":1},{"text":"इतर कोणत्या लोकांना","poem":2},{"lineBreak":true},{"text":"याहवेहने वाचविले आहे काय?","poem":2},{"text":"तेच तुझी ढाल व तुझे साहाय्य आहेत","poem":1},{"text":"आणि तुझ्या वैभवाची तलवार आहेत.","poem":2},{"text":"तुझे शत्रू तुझ्यापुढे थरथर कापतील,","poem":1},{"text":"आणि तू त्यांची उच्च स्थाने पायाखाली तुडवशील!”","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"म्हणजे नीतिमान इस्राएलसाठी हा शब्द वापरला आहे","reference":{"chapter":33,"verse":5}},{"noteId":12,"caller":"+","text":"किंवा च्या पासून वेगळे केलेले","reference":{"chapter":33,"verse":16}},{"noteId":13,"caller":"+","text":"काही मूळ प्रतींमध्ये याकोबाचा झरा सुरक्षित आहे","reference":{"chapter":33,"verse":28}}]},"thisChapterLink":"/api/mar_cbi/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}