{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ECC","translationId":"mar_cbi","name":"उपदेशक","commonName":"उपदेशक","title":"उपदेशक","order":21,"numberOfChapters":12,"sha256":"160f5aa695c14a447b7d64468ba8fa9a7f15a80d5f872decfcf98c466959f8a4","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/mar_cbi/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":1,"content":[{"type":"heading","content":["सर्वकाही व्यर्थ"]},{"type":"verse","number":1,"content":["यरुशलेम येथील दावीद राजाचा पुत्र, उपदेशकाची",{"noteId":0},"वचने:"]},{"type":"verse","number":2,"content":[{"text":"“व्यर्थ आहे! व्यर्थ आहे!”","poem":1},{"text":"उपदेशक म्हणतो.","poem":2},{"text":"“निव्वळ व्यर्थ!","poem":1},{"text":"सर्वकाही व्यर्थ आहे.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"या सूर्याखाली लोक जे कष्ट करतात,","poem":1},{"text":"त्याचा त्यांना काय लाभ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"पिढ्या येतात आणि पिढ्या जातात,","poem":1},{"text":"परंतु पृथ्वी सर्वकाळ अस्तित्वात राहते.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"सूर्य उगवतो आणि अस्त पावतो,","poem":1},{"text":"आणि आपल्या उगवतीच्या स्थानाकडे घाईने परत जातो.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"वारा दक्षिणेकडे वाहतो","poem":1},{"text":"आणि उत्तरेकडे वळतो;","poem":2},{"text":"तो गोल गोल भ्रमण करीत","poem":1},{"text":"आपल्या ठिकाणी परत जातो.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"सर्व प्रवाह समुद्रास मिळतात,","poem":1},{"text":"तरीही समुद्र कधी भरलेला नाही.","poem":2},{"text":"नद्या पुन्हा त्या स्थानाकडून वाहू लागतात,","poem":1},{"text":"जिथून त्यांचा उगम होतो,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"सर्वकाही त्रासाने भरलेले आहे,","poem":1},{"text":"जे कोणाला शब्दात सांगता येत नाही.","poem":2},{"text":"नेत्र बघून कधी समाधानी होत नाहीत.","poem":1},{"text":"कान सुद्धा ऐकून भरत नाहीत.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"जे घडले ते पुन्हा एकदा होणार,","poem":1},{"text":"जे केले गेले आहे, ते पुन्हा केले जाईल;","poem":2},{"lineBreak":true},{"text":"सूर्याखाली नवे असे काही नाही.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“पाहा! हे काहीतरी नवे आहे,","poem":1},{"text":"असे कोणी म्हणू शकेल काय?”","poem":2},{"text":"हे तर पूर्वकाळापासूनच होते;","poem":1},{"text":"आमच्या काळापूर्वीच ते होते.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"पुढे येणार्‍या पिढीला,","poem":1},{"text":"पूर्वीच्या पिढ्यांची आठवण नाही","poem":2},{"text":"आणि पुढे येणार्‍या पिढीला सुद्धा","poem":1},{"text":"त्याचे स्मरण नसेल.","poem":2}]},{"type":"heading","content":["सुज्ञानाची व्यर्थता"]},{"type":"verse","number":12,"content":["मी, उपदेशक, यरुशलेममध्ये इस्राएलचा राजा होतो."]},{"type":"verse","number":13,"content":["आकाशाखाली घडत असलेल्या प्रत्येक गोष्टींचा अभ्यास आणि शोध सुज्ञानाने करण्यासाठी मी माझ्या बुद्धीचा उपयोग केला. परमेश्वराने मनुष्यावर किती जड ओझे लादले आहे!"]},{"type":"verse","number":14,"content":["सूर्याखाली होत असलेली प्रत्येक गोष्टी मी पाहिली आहे; त्या सर्व, वार्‍यामागे धावण्यासारखे व्यर्थ आहेत."]},{"type":"verse","number":15,"content":[{"text":"जे वाकडे आहे, ते सरळ करता येत नाही;","poem":1},{"text":"जी उणीव आहे, ती मोजता येत नाही.","poem":2}]},{"type":"verse","number":16,"content":["मी स्वतःला म्हटले, “पाहा, यरुशलेममध्ये माझ्या आधी राज्य करून गेलेल्या राजांपेक्षा, मी अधिक सुज्ञान प्राप्त केले आहे; सुज्ञान आणि विद्या यांचा मला सर्वात अधिक अनुभव घडला आहे.”"]},{"type":"verse","number":17,"content":["मग मी सुज्ञता तसेच वेडेपणा व मूर्खपणा जाणून घेण्याचा प्रयास केला, परंतु मला समजले की, हे देखील वार्‍याचा पाठलाग केल्यासारखे आहे."]},{"type":"verse","number":18,"content":[{"text":"कारण अधिक सुज्ञतेबरोबर अधिक दुःख येते;","poem":1},{"text":"जेवढी अधिक विद्या तेवढे अधिक दुःख.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"किंवा सभेचा नायक","reference":{"chapter":1,"verse":1}}]},"thisChapterLink":"/api/mar_cbi/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}