{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ECC","translationId":"mar_cbi","name":"उपदेशक","commonName":"उपदेशक","title":"उपदेशक","order":21,"numberOfChapters":12,"sha256":"160f5aa695c14a447b7d64468ba8fa9a7f15a80d5f872decfcf98c466959f8a4","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/mar_cbi/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"तुझ्या तारुण्याच्या दिवसात","poem":1},{"text":"तुझ्या निर्माणकर्त्याचे स्मरण कर,","poem":2},{"text":"आणि जोपर्यंत कष्टाचे दिवस येत नाहीत","poem":1},{"text":"आणि अशी वर्षे येत नाहीत जेव्हा तुम्ही म्हणाल,","poem":2},{"lineBreak":true},{"text":"“मला त्यांच्यामध्ये काही संतोष नाही”—","poem":2}]},{"type":"verse","number":2,"content":[{"text":"जोपर्यंत सूर्य आणि प्रकाश,","poem":1},{"text":"आणि चंद्र आणि तारे अंधकारमय होत नाहीत,","poem":2},{"lineBreak":true},{"text":"पावसानंतर ढग परत जात नाहीत;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जेव्हा घराचे पहारेकरी थरथर कापतील,","poem":1},{"text":"आणि बलवान पुरुष वाकून जातील,","poem":2},{"text":"दळण करणार्‍या थोडक्या आहेत म्हणून काम थांबवतील,","poem":1},{"text":"आणि खिडक्यांमधून पाहणार्‍यांची नजर अंधुक होईल;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"जेव्हा रस्त्याच्या वेशी बंद असतील","poem":1},{"text":"आणि जात्याचा आवाज मंद होईल;","poem":2},{"text":"जेव्हा लोक पक्ष्यांच्या आवाजाने उठतील,","poem":1},{"text":"परंतु त्यांची सर्व गीते शांत होतील;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"जेव्हा लोकांना उंच ठिकाणांची","poem":1},{"text":"आणि वाटेतील धोक्याची भीती वाटते;","poem":2},{"text":"जेव्हा बदामाची झाडे फुलतात","poem":1},{"text":"आणि नाकतोडा त्याबरोबर फरफटत जातो","poem":2},{"lineBreak":true},{"text":"आणि कोणतीही अभिलाषा जागृत होत नाही.","poem":2},{"text":"तेव्हा लोक आपल्या सनातन घराकडे जातात","poem":1},{"text":"आणि शोक करणारे रस्त्यावर येतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"आयुष्याचा चांदीचा दोर तुटण्याआधी,","poem":1},{"text":"आणि सोन्याचे भांडे फुटण्याआधी;","poem":2},{"text":"झर्‍यावरील घागर फुटण्याआधी,","poem":1},{"text":"आणि विहिरीवरील रहाट मोडण्याआधी,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"आणि माती जिथून आली तिथे जाण्याआधी,","poem":1},{"text":"आणि परमेश्वराने दिलेला आत्मा त्याकडे","poem":2},{"lineBreak":true},{"text":"परतण्याआधी आपल्या निर्माणकर्त्याचे स्मरण कर.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"उपदेशक","poem":1},{"noteId":12},{"text":"म्हणतो, निरर्थक! निरर्थक!","poem":1},{"text":"सर्वकाही निरर्थक!","poem":2}]},{"type":"heading","content":["विषयाचे प्रतिपादन"]},{"type":"verse","number":9,"content":["उपदेशक केवळ सुज्ञच नाही, तर त्याने लोकांनाही विद्या शिकवली. त्याने विचार करून शोध केला आणि अनेक म्हणी रचल्या."]},{"type":"verse","number":10,"content":["उपदेशकाने योग्य शब्दांचा शोध केला आणि त्याने जे काही लिहिले ते यथार्थ व सत्य होते."]},{"type":"verse","number":11,"content":["सुज्ञानाची वचने पराणीप्रमाणे आहेत, त्यांच्या शब्दांचा संग्रह एका मेंढपाळाने दिलेल्या घट्ट रोवलेल्या खिळ्यांप्रमाणे आहेत."]},{"type":"verse","number":12,"content":["याव्यतिरिक्त असलेल्या शिक्षणापासून माझ्या मुला सावध राहा. अधिक पुस्तके लिहून ठेवायला अंत नाही आणि पुष्कळ अभ्यास केल्याने शरीर थकते."]},{"type":"verse","number":13,"content":[{"text":"आता सर्व ऐकून झाले;","poem":1},{"text":"सर्व गोष्टींचा निष्कर्ष हाच की:","poem":2},{"text":"परमेश्वराचे भय बाळग आणि त्यांच्या आज्ञा पाळ,","poem":1},{"text":"कारण सर्व मानवजातीचे हेच कर्तव्य आहे.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"कारण प्रत्येक गुप्त गोष्टीबद्दल,","poem":1},{"text":"ती चांगली असो किंवा वाईट,","poem":2},{"lineBreak":true},{"text":"त्याचा परमेश्वर न्याय करतील.","poem":2}]}],"footnotes":[{"noteId":12,"caller":"+","text":"किंवा उपदेशक हे वचन 9 आणि 10 मध्ये आहे","reference":{"chapter":12,"verse":8}}]},"thisChapterLink":"/api/mar_cbi/ECC/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/SNG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ECC/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}