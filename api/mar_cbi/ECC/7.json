{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ECC","translationId":"mar_cbi","name":"उपदेशक","commonName":"उपदेशक","title":"उपदेशक","order":21,"numberOfChapters":12,"sha256":"160f5aa695c14a447b7d64468ba8fa9a7f15a80d5f872decfcf98c466959f8a4","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/mar_cbi/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":7,"content":[{"type":"heading","content":["सुज्ञान"]},{"type":"verse","number":1,"content":[{"text":"सन्माननीय नाव हे सुवासिक अत्तरापेक्षा उत्तम आहे,","poem":1},{"text":"आणि मृत्युदिन जन्म दिवसापेक्षा उत्तम आहे.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मेजवानीच्या घरी जाण्यापेक्षा","poem":1},{"text":"शोकाकुल घरात जाणे हे अधिक उत्तम आहे,","poem":2},{"text":"प्रत्येक मनुष्याने","poem":1},{"noteId":6},{"text":"ही गोष्ट लक्षात ठेवावी;","poem":1},{"text":"मृत्यू हे सर्वांचे विधिलिखित आहे.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"विलाप करणे हे हसण्यापेक्षा बरे,","poem":1},{"text":"कारण दुःखी चेहरा हृदयासाठी बरा आहे.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"सुज्ञानी मनुष्याचे हृदय शोकाकुल घरात असते,","poem":1},{"text":"परंतु मूर्खांचे हृदय सुखाच्या घरात असते.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"सुज्ञानी व्यक्तीच्या निषेधाकडे लक्ष देणे","poem":1},{"text":"मूर्खाचे गीत ऐकण्यापेक्षा उत्तम आहे.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मूर्खाचे हसणे हे","poem":1},{"text":"पात्राखालील अग्नीतील तडतडणाऱ्या काट्यांप्रमाणे आहे,","poem":2},{"lineBreak":true},{"text":"हे सुद्धा व्यर्थ आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"पिळवणूक सुज्ञानी मनुष्याला मूर्ख बनविते,","poem":1},{"text":"आणि लाच हृदयाला भ्रष्ट करते.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"एखाद्या कामाचा शेवट त्याच्या आरंभापेक्षा बरा,","poem":1},{"text":"आणि गर्वापेक्षा सहनशीलता बरी.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"क्रोधित होण्यास तुझ्या अंतःकरणात घाई करू नकोस,","poem":1},{"text":"क्रोध तर मूर्खाच्या मांडीवर वास करतो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"असे म्हणू नको, “जुने दिवस सध्याच्या दिवसांपेक्षा अधिक चांगले का होते?”","poem":1},{"text":"कारण असे प्रश्न विचारणे हे सुज्ञान नव्हे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"सुज्ञान, हे वतन प्राप्तीप्रमाणे चांगले आहे,","poem":1},{"text":"आणि ज्यांना सूर्य दिसतो","poem":2},{"noteId":7},{"text":"त्यांच्यासाठी ते लाभदायक आहे.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"जसे धन तसेच","poem":1},{"text":"सुज्ञान हे एक आश्रयस्थान आहे,","poem":2},{"text":"परंतु सुज्ञानाचा फायदा हा आहे:","poem":1},{"text":"ज्ञान ज्यांच्या मालकीचे आहे, त्यांचे रक्षण करते.","poem":2}]},{"type":"verse","number":13,"content":["परमेश्वराच्या कामावर मनन करा:",{"text":"त्यांनी जे वाकडे केले आहे","poem":1},{"text":"ते कोण सरळ करू शकतो?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"जेव्हा वेळ अनुकूल असते तेव्हा आनंद करा;","poem":1},{"text":"परंतु जेव्हा वेळ प्रतिकूल असते, तेव्हा हे लक्षात घ्या:","poem":2},{"text":"परमेश्वराने जशी अनुकूल वेळ निर्माण केली","poem":1},{"text":"तशी प्रतिकूल वेळही त्यांनीच निर्माण केली,","poem":2},{"text":"म्हणून कोणा व्यक्तीला आपल्या भविष्याबद्दल","poem":1},{"text":"जाणून घेता येत नाही.","poem":2}]},{"type":"verse","number":15,"content":["या व्यर्थ जीवनामध्ये मी दोन्ही गोष्टी पाहिल्या आहेत:",{"text":"नीतिमान व्यक्ती त्यांच्या नीतिमत्वात नाहीसे होतात,","poem":1},{"text":"आणि दुष्ट त्यांच्या दुष्टपणात दीर्घायुष्य जगतात.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"अति नीतिमान होऊ नका,","poem":1},{"text":"किंवा अति सुज्ञानीही असू नका—","poem":2},{"lineBreak":true},{"text":"तुम्ही स्वतःचा नाश का करून घ्यावा?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"अति दुष्ट होऊ नका,","poem":1},{"text":"आणि मूर्खही असू नका—","poem":2},{"lineBreak":true},{"text":"तुमची वेळ येण्यापूर्वी का मरावे?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"पहिल्याला घट्ट धरून ठेवणे,","poem":1},{"text":"आणि दुसर्‍यालाही सोडून न देणे हे बरे.","poem":2},{"lineBreak":true},{"text":"जे परमेश्वराचे भय धरतात ते अतिरेक टाळतील.","poem":2},{"noteId":8}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"सुज्ञान एखाद्या बुद्धिमान व्यक्तीला","poem":1},{"text":"एका शहराच्या दहा शासकांपेक्षा अधिक शक्तिशाली बनवते.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"खरोखर, या पृथ्वीवर नीतिमान असा कोणीही नाही,","poem":1},{"text":"असा एकही व्यक्ती नाही जो चांगलेच करतो आणि कधीच पाप करीत नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"लोकांच्या प्रत्येक शब्दांकडे लक्ष देऊ नका,","poem":1},{"text":"नाहीतर तुमचा चाकरसुद्धा तुम्हाला शाप देताना तुम्ही ऐकाल—","poem":2}]},{"type":"verse","number":22,"content":[{"text":"कारण तुम्ही इतरांना कितीदा शाप दिला","poem":1},{"text":"हे तुम्हाला तुमच्या मनातच ठाऊक आहे.","poem":2}]},{"type":"verse","number":23,"content":["सुज्ञानाने मी या सर्व गोष्टी तपासून पाहिल्या आणि म्हटले,",{"text":"“मी सुज्ञानी होण्याचे ठरविले आहे”—","poem":1},{"text":"परंतु हे माझ्या शक्तीच्या पलीकडे होते.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"जे काही अस्तित्वात आहे ते खूपच दूर आणि सखोल आहे,","poem":1},{"text":"त्याचा शोध कोणाला घेता येईल?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ज्ञान व रचनेच्या पध्दती जाणून व त्याच शोध घेण्यासाठी","poem":1},{"text":"आणि दुष्टतेची मूर्खता","poem":2},{"text":"व मूर्खतेचा वेडेपणा समजण्यासाठी","poem":1},{"text":"मी माझे मन वळविले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"मरणापेक्षाही अति कटू गोष्ट मला दिसून आली की,","poem":1},{"text":"एक स्त्री जी एक पाश आहे,","poem":2},{"text":"जिचे हृदय एक सापळा आहे","poem":1},{"text":"जिचे हात साखळीप्रमाणे आहेत.","poem":2},{"text":"जे परमेश्वराला प्रसन्न करतात ते तिच्यापासून निसटतील,","poem":1},{"text":"परंतु पापींना ती पाशात अडकवेल.","poem":2}]},{"type":"verse","number":27,"content":["“पाहा,” शिक्षक",{"noteId":9},"असे म्हणतो, “या गोष्टींचा मी शोध लावला आहे:",{"text":"“रचनेच्या पध्दती समजण्यासाठी मी एक गोष्ट दुसरीत मिळविली—","poem":1}]},{"type":"verse","number":28,"content":[{"text":"जेव्हा मी शोध घेत होतो","poem":2},{"lineBreak":true},{"text":"मला काही निष्पन्न झाले नाही—","poem":2},{"text":"हजारांमध्ये एक नीतिमान मनुष्य होता.","poem":1},{"text":"परंतु त्या सर्वांमध्ये एकही स्त्री नीतिमान नव्हती.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"एकच गोष्ट माझ्या लक्षात आली:","poem":1},{"text":"परमेश्वराने मानवजात नीतिमान अशी निर्माण केली,","poem":2},{"lineBreak":true},{"text":"परंतु ते अनेक योजनांचा शोधच करीत राहिले.”","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":6,"caller":"+","text":"प्रत्येक मनुष्याने अर्थात् जीवितांनी","reference":{"chapter":7,"verse":2}},{"noteId":7,"caller":"+","text":"अर्थात् जे जिवंत आहेत","reference":{"chapter":7,"verse":11}},{"noteId":8,"caller":"+","text":"किंवा त्या दोन्हीना अनुसरतील","reference":{"chapter":7,"verse":18}},{"noteId":9,"caller":"+","text":"किंवा मंडळीचा उपदेशक","reference":{"chapter":7,"verse":27}}]},"thisChapterLink":"/api/mar_cbi/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ECC/6.json","previousChapterAudioLinks":{},"numberOfVerses":29}