{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"EST","translationId":"mar_cbi","name":"एस्तेर","commonName":"एस्तेर","title":"एस्तेर","order":17,"numberOfChapters":10,"sha256":"db7ffdd4fdf95380d8798658559192a102a1decfcbc242591f1572511bcd35c6","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/EST/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/mar_cbi/EST/10.json","totalNumberOfVerses":163},"chapter":{"number":10,"content":[{"type":"heading","content":["मर्दखयाची थोरवी"]},{"type":"verse","number":1,"content":["अहश्वेरोश राजाने आपल्या संपूर्ण साम्राज्याच्या मुख्य भूमीवर व समुद्रकिनाऱ्यावरील बेटांवर कर लावला."]},{"type":"verse","number":2,"content":["मर्दखय यहूदीस उच्चपद प्रदान केले, मर्दखयाची थोरवी, त्याची महान कृत्ये आणि त्याचप्रमाणे त्याला राजाकडून प्राप्त झालेले सन्मान यांची साद्यंत हकिकत मेदिया व पर्शियाच्या राजाच्या इतिहासग्रंथात लिहिलेली नाही काय?"]},{"type":"verse","number":3,"content":["खुद्द अहश्वेरोश राजाच्या खालोखाल मर्दखयचे पद होते. अर्थात्, तो यहूदी लोकांमध्ये अतिशय थोर होता आणि त्याचे सर्व देशबांधव त्याचा फार आदर करीत, कारण तो आपल्या लोकांचे कल्याण व्हावे म्हणून खूप झटत असे व त्यांच्या हितासाठी रदबदली करीत असे."]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/EST/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/JOB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/EST/9.json","previousChapterAudioLinks":{},"numberOfVerses":3}