{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"EXO","translationId":"mar_cbi","name":"निर्गम","commonName":"निर्गम","title":"निर्गमाचे पुस्तक","order":2,"numberOfChapters":40,"sha256":"8c4fe3accbdd83b5137b7e26acb4df47c8024b09e2aba1ee9525e93f6bc6551f","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/mar_cbi/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":15,"content":[{"type":"heading","content":["मोशे व मिर्यामचे गीत"]},{"type":"verse","number":1,"content":["नंतर मोशे व इस्राएली लोकांनी याहवेहप्रीत्यर्थ हे गीत गाईले:",{"text":"“मी याहवेहला गीत गाईन,","poem":1},{"text":"कारण ते अत्युच्च आहेत.","poem":2},{"text":"घोडे व त्यांचे स्वार","poem":1},{"text":"त्यांनी समुद्रात फेकले आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“याहवेह माझे सामर्थ्य व माझे संरक्षण","poem":1},{"noteId":10},{"text":"आहेत;","poem":1},{"text":"याहवेह माझे तारण झाले आहेत.","poem":2},{"text":"तेच माझा परमेश्वर आहेत आणि मी त्यांची स्तुती करेन,","poem":1},{"text":"माझ्या पूर्वजांचे परमेश्वर, मी त्यांचा महिमा वर्णीन.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"याहवेह योद्धा आहेत;","poem":1},{"text":"याहवेह त्यांचे नाव आहे.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"फारोहचे रथ व सैन्य","poem":1},{"text":"त्यांनी समुद्रात उलथून टाकले.","poem":2},{"text":"फारोहचे सर्वोत्तम अधिकारी","poem":1},{"text":"तांबड्या समुद्रात बुडून गेले.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"खोल पाण्याने त्यांना झाकून टाकले;","poem":1},{"text":"दगडाप्रमाणे ते खोल तळाशी बुडून गेले.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"हे याहवेह, तुमचा उजवा हात,","poem":1},{"text":"सामर्थ्याने ऐश्वर्यमान आहे.","poem":2},{"text":"हे याहवेह तुमच्या उजव्या हाताने,","poem":1},{"text":"शत्रूला हादरून टाकले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“तुमच्या ऐश्वर्याच्या महानतेने","poem":1},{"text":"तुमच्या विरोधकांना तुम्ही खाली पाडले.","poem":2},{"text":"स्वैर सोडलेल्या तुमच्या क्रोधाने;","poem":1},{"text":"भुशाप्रमाणे त्यांना भस्म केले.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तुमच्या नाकपुड्यांच्या श्वासाने","poem":1},{"text":"जले एकत्र आली.","poem":2},{"text":"पाण्याचे प्रवाह भिंतीप्रमाणे उभे राहिले;","poem":1},{"text":"डोहातील पाणी समुद्राच्या मध्यभागी गोळा झाले.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"शत्रूने फुशारकी मारीत म्हटले,","poem":1},{"text":"‘मी पाठलाग करून त्यांच्यावर मात करेन.","poem":2},{"text":"मी लूट वाटून घेईन;","poem":1},{"text":"त्यांच्या जिवावर मी तृप्त होईन.","poem":2},{"text":"मी माझी तलवार उपसेन","poem":1},{"text":"आणि माझ्या हाताने त्यांचा नाश होईल.’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"पण तुम्ही आपला श्वास फुंकला,","poem":1},{"text":"आणि समुद्राने त्यांना झाकून टाकले.","poem":2},{"text":"ते शीसाप्रमाणे","poem":1},{"text":"महाजलात बुडून गेले.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"सर्व दैवतांमध्ये","poem":1},{"text":"हे याहवेह तुमच्यासारखे कोण आहे?","poem":2},{"text":"पवित्रतेत ऐश्वर्यमान;","poem":1},{"text":"वैभवात अद्वितीय,","poem":2},{"text":"आश्चर्यकर्मे करणारे,","poem":1},{"text":"असे तुमच्यासारखे कोण आहे?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"तुम्ही आपला उजवा हात उगारला,","poem":1},{"text":"आणि पृथ्वीने तुमच्या शत्रूंना गिळून टाकले.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तुम्ही उद्धारलेल्या लोकांना","poem":1},{"text":"आपल्या प्रेमदयेने चालविणार.","poem":2},{"text":"आपल्या सामर्थ्याने तुम्ही त्यांना","poem":1},{"text":"तुमच्या पवित्र निवासस्थानाकडे घेऊन जाणार.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"राष्ट्रे हे ऐकून थरथर कापतील;","poem":1},{"text":"पलिष्टी भीतीने ग्रासून जातील.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"एदोमाचे अधिकारी घाबरून जातील,","poem":1},{"text":"मोआबाचे पुढारी थरथर कापू लागतील,","poem":2},{"text":"कनानातील लोक वितळून जातील;","poem":1}]},{"type":"verse","number":16,"content":[{"text":"तुमच्या बाहूच्या पराक्रमामुळे","poem":2},{"text":"भीती व दहशत त्यांच्यावर येऊन पडेल.","poem":1},{"text":"तुमचे लोक पार करेपर्यंत, हे याहवेह,","poem":2},{"text":"जे लोक तुम्ही खंडून","poem":1},{"noteId":11},{"text":"घेतले आहेत, ते पार होईपर्यंत","poem":1},{"text":"ते दगडाप्रमाणे स्तब्ध राहतील.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"तुम्ही त्यांना आत,","poem":1},{"text":"तुमच्या वतनाच्या पर्वतावर आणून रोपणार;","poem":2},{"text":"तेच ठिकाण याहवेह, जे तुम्ही आपल्या निवासासाठी तयार केले,","poem":1},{"text":"ते पवित्रस्थान जे, हे प्रभू, तुमच्या हातांनी प्रस्थापित केले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"याहवेह सदासर्वकाळ","poem":1},{"text":"राज्य करतील.","poem":2}]},{"type":"verse","number":19,"content":["जेव्हा फारोहचे घोडे, रथ आणि घोडेस्वार समुद्रामध्ये गेले, तेव्हा याहवेहने समुद्राचे पाणी परत त्यांच्यावर आणले; परंतु इस्राएली लोक समुद्रामधून कोरड्या वाटेवरून चालले."]},{"type":"verse","number":20,"content":["तेव्हा अहरोनाची बहीण, मिर्याम संदेष्टी, हिने हातात डफ घेतला आणि सर्व स्त्रिया तिच्यामागे हातात डफ घेऊन नाचू लागल्या."]},{"type":"verse","number":21,"content":["मिर्यामने त्यांच्यासाठी गाईले:",{"text":"“याहवेहप्रीत्यर्थ गीत गा,","poem":1},{"text":"कारण ते अत्युच्च आहेत.","poem":2},{"text":"घोडे व त्यांचे स्वार","poem":1},{"text":"त्यांनी समुद्रात बुडवून टाकले आहेत.”","poem":2}]},{"type":"heading","content":["मारा व एलीम येथील पाणी"]},{"type":"verse","number":22,"content":["मग मोशेने इस्राएली लोकांस तांबड्या समुद्रापासून पुढे शूर नावाच्या रानात आणले. तीन दिवसांच्या रानातील त्यांच्या प्रवासात त्यांना पाणी मिळाले नाही."]},{"type":"verse","number":23,"content":["मग ते माराह येथे आले, त्याचे पाणी ते पिऊ शकले नाहीत, कारण ते कडू होते. (म्हणूनच त्या ठिकाणाला मारा, म्हणजे कडू असे म्हणतात.)"]},{"type":"verse","number":24,"content":["“आम्ही काय प्यावे?” असे म्हणत लोकांनी मोशेविरुद्ध कुरकुर केली."]},{"type":"verse","number":25,"content":["तेव्हा मोशेने याहवेहचा धावा केला आणि याहवेहने त्याला लाकडाचा एक तुकडा दाखविला. त्याने तो पाण्यात टाकला आणि पाणी पिण्यास योग्य झाले. त्या ठिकाणी याहवेहने त्यांना पारखण्यासाठी नियम व सूचना दिल्या."]},{"type":"verse","number":26,"content":["ते म्हणाले, “जर तुम्ही याहवेह, तुमच्या परमेश्वराचा शब्द काळजीपूर्वक ऐकाल व त्यांच्या नजरेत जे योग्य ते कराल, जर त्यांच्या आज्ञांकडे लक्ष देऊन त्यांचे सर्व नियम पाळाल, तर मी इजिप्तवर ज्या पीडा आणल्या होत्या, त्या तुमच्यावर आणणार नाही, कारण मी याहवेह, तुम्हाला आरोग्य देणारा",{"noteId":12},"आहे.”"]},{"type":"verse","number":27,"content":["मग ते एलीम येथे आले. जिथे बारा झरे व सत्तर खजुरीची झाडे होती. त्या पाण्याजवळ त्यांनी तळ दिला."]}],"footnotes":[{"noteId":10,"caller":"+","text":"किंवा गीत","reference":{"chapter":15,"verse":2}},{"noteId":11,"caller":"+","text":"निर्माण केलेले","reference":{"chapter":15,"verse":16}},{"noteId":12,"caller":"+","text":"मूळ भाषेत याहवेह रोफेखा","reference":{"chapter":15,"verse":26}}]},"thisChapterLink":"/api/mar_cbi/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}