{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"EZK","translationId":"mar_cbi","name":"यहेज्केल","commonName":"यहेज्केल","title":"यहेज्केलाची भविष्यवाणी","order":26,"numberOfChapters":48,"sha256":"a43dad6396faa8d40b7c48e8092f735f0290982451c5dde185c094f79cd3576a","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/mar_cbi/EZK/48.json","totalNumberOfVerses":1272},"chapter":{"number":19,"content":[{"type":"heading","content":["इस्राएलच्या राजपुत्रांसाठी विलाप"]},{"type":"verse","number":1,"content":["“इस्राएलच्या राजपुत्रांसाठी विलाप कर"]},{"type":"verse","number":2,"content":["आणि म्हण:",{"text":"“ ‘तुझी आई सिंहांमध्ये","poem":1},{"text":"सिंहीण होती!","poem":2},{"text":"ती त्यांच्यामध्ये वसत होती","poem":1},{"text":"आणि तिने तिच्या पिल्लांचे संगोपन केले.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिच्या पिल्लांपैकी एकाला तिने वाढवले,","poem":1},{"text":"आणि तो एक बलवान सिंह झाला.","poem":2},{"text":"तो शिकार फाडण्यास शिकला","poem":1},{"text":"आणि तो नर-भक्षक झाला.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तेव्हा राष्ट्रांनी त्याच्याविषयी ऐकले,","poem":1},{"text":"आणि तो त्यांच्या खड्ड्यात अडकला गेला.","poem":2},{"text":"त्यांनी त्याला फासात अडकवून","poem":1},{"text":"इजिप्त देशात नेले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ ‘जेव्हा त्या सिंहिणीने आपल्या भग्न होत असलेल्या आशा पहिल्या,","poem":1},{"text":"तिच्या अपेक्षा गेल्या,","poem":2},{"text":"तिने तिच्या पिल्लांमधून अजून एक पिल्लू घेतले","poem":1},{"text":"आणि त्याला बलवान सिंह बनविले.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तो इतर सिंहांमध्ये फिरू लागला,","poem":1},{"text":"कारण तो आता बलवान सिंह होता.","poem":2},{"text":"तो शिकार फाडण्यास शिकला","poem":1},{"text":"आणि तो नर-भक्षक झाला.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"त्याने त्यांचे किल्ले मोडले","poem":1},{"noteId":18},{"text":"आणि त्यांची नगरे उद्ध्वस्त केली.","poem":2},{"text":"तो देश व त्यातील राहणारे सर्वजण","poem":1},{"text":"त्याच्या गर्जनेने भयभीत झाले.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तेव्हा इतर राष्ट्र","poem":1},{"text":"व सभोवतालचे प्रांत त्याच्याविरुद्ध आले,","poem":2},{"text":"त्यांनी त्याच्यासाठी जाळे पसरले,","poem":1},{"text":"आणि तो त्यांच्या खड्ड्यात अडकला.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"त्यांनी त्याला आकड्याने ओढून पिंजर्‍यात टाकले","poem":1},{"text":"आणि त्याला बाबेलच्या राजाकडे आणले.","poem":2},{"text":"त्याने त्याला तुरुंगात ठेवले,","poem":1},{"text":"म्हणून इस्राएलच्या पर्वतांवर","poem":2},{"lineBreak":true},{"text":"त्याची गर्जना पुन्हा ऐकू आली नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘तुमची आई तुमच्या द्राक्षमळ्यात","poem":1},{"noteId":19},{"text":"पाण्याजवळ लावलेल्या द्राक्षवेलीप्रमाणे होती;","poem":2},{"text":"विपुल पाण्यामुळे","poem":1},{"text":"ती फलदायी व फांद्यांनी भरलेली होती.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तिच्या फांद्या मजबूत असून,","poem":1},{"text":"अधिकार्‍याच्या राजदंडासाठी योग्य होत्या.","poem":2},{"text":"झाडाच्या दाट पानांच्या वर","poem":1},{"text":"त्या उंच वाढल्या,","poem":2},{"text":"तिची उंची व तिच्या पुष्कळ फांद्यांमुळे","poem":1},{"text":"ती उल्लेखनीय दिसत होती.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"परंतु क्रोधामुळे ती समूळ उपटली जाऊन","poem":1},{"text":"जमिनीवर फेकण्यात आली.","poem":2},{"text":"पूर्वेकडील वार्‍याने ती वाळून गेली,","poem":1},{"text":"तिची फळे गळून पडली;","poem":2},{"text":"तिच्या मजबूत फांद्या वाळून गेल्या","poem":1},{"text":"आणि अग्नीने त्या भस्म केल्या.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"आता ती वेल वाळवंटात,","poem":1},{"text":"कोरड्या व तहानेल्या भूमीवर लावली आहे.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"तिच्या एका मुख्य फांदीमधून","poem":1},{"noteId":20},{"text":"अग्नी पसरला","poem":1},{"text":"आणि तिचे फळ भस्म केले.","poem":2},{"text":"अधिकार्‍याच्या राजदंडासाठी योग्य अशी","poem":1},{"text":"एकही मजबूत फांदी तिच्यावर राहिली नाही.’","poem":2},"हे विलापगीत आहे आणि विलापगीत म्हणूनच त्याचा उपयोग व्हावा.”"]}],"footnotes":[{"noteId":18,"caller":"+","text":"काही मूळ प्रतींनुसार त्याने पाहिले","reference":{"chapter":19,"verse":7}},{"noteId":19,"caller":"+","text":"किंवा तुमच्या रक्तात","reference":{"chapter":19,"verse":10}},{"noteId":20,"caller":"+","text":"किंवा च्या खालून","reference":{"chapter":19,"verse":14}}]},"thisChapterLink":"/api/mar_cbi/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}