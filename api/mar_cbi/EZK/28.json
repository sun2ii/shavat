{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"EZK","translationId":"mar_cbi","name":"यहेज्केल","commonName":"यहेज्केल","title":"यहेज्केलाची भविष्यवाणी","order":26,"numberOfChapters":48,"sha256":"a43dad6396faa8d40b7c48e8092f735f0290982451c5dde185c094f79cd3576a","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/mar_cbi/EZK/48.json","totalNumberOfVerses":1272},"chapter":{"number":28,"content":[{"type":"heading","content":["सोरच्या राजाविरुद्ध भविष्यवाणी"]},{"type":"verse","number":1,"content":["याहवेहचे वचन माझ्याकडे आले:"]},{"type":"verse","number":2,"content":["“मानवपुत्रा, सोरच्या अधिपतीला सांग: सार्वभौम याहवेह असे म्हणतात:",{"text":"“ ‘आपल्या अंतःकरणातील गर्वाने","poem":1},{"text":"तू म्हणालास, “मी देव आहे;","poem":2},{"text":"देवाच्या आसनावर","poem":1},{"text":"समुद्राच्या हृदयात मी बसतो.”","poem":2},{"text":"तुला वाटते की तू देवासारखा सुज्ञ आहे,","poem":1},{"text":"परंतु तू मानव आहेस आणि देव नाही.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तू दानीएलापेक्षा","poem":1},{"noteId":33},{"text":"सुज्ञ आहेस काय?","poem":1},{"text":"तुझ्यापासून काही गुपित नाही काय?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तुझी सुज्ञता व समज","poem":1},{"text":"याद्वारे तू आपल्यासाठी संपत्ती मिळविली","poem":2},{"text":"आणि आपल्या खजिन्यात","poem":1},{"text":"सोने आणि चांदीचा साठा केलास.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"व्यापारातील तुझ्या महान कुशलतेने","poem":1},{"text":"तू आपले धन वाढविलेस,","poem":2},{"text":"आणि तुझ्या संपत्तीमुळे","poem":1},{"text":"तुझे हृदय गर्विष्ठ झाले आहे.","poem":2}]},{"type":"verse","number":6,"content":["“ ‘यास्तव सार्वभौम याहवेह असे म्हणतात:",{"text":"“ ‘कारण तू स्वतःला ज्ञानी,","poem":1},{"text":"अगदी देवासारखे ज्ञानी समजतोस,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"म्हणून मी परकीय लोकांना तुझ्याविरुद्ध आणेन,","poem":1},{"text":"जे राष्ट्रांमध्ये सर्वात क्रूर आहेत;","poem":2},{"text":"तुझे सौंदर्य व ज्ञान याविरुद्ध ते त्यांची तलवार उपसतील","poem":1},{"text":"आणि ती तुझ्या चमकत्या वैभवाला भेदून जाईल.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ते तुला खाली गर्तेत आणतील,","poem":1},{"text":"आणि तिथे समुद्राच्या मधोमध","poem":2},{"lineBreak":true},{"text":"तुझा भयानक मृत्यू होईल.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तेव्हा जे लोक तुला मारतात","poem":1},{"text":"त्यांच्यादेखत तू म्हणशील काय, “मी देव आहे?”","poem":2},{"text":"जे तुझा वध करतात त्यांच्या हातात,","poem":1},{"text":"तू केवळ मानव असशील, देव नाही.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"परकीय लोकांच्या हातून","poem":1},{"text":"तू बेसुंती लोकांसारखा मृत्यू पावशील.","poem":2},"हे मी बोललो आहे, असे सार्वभौम याहवेह म्हणतात.’ ”"]},{"type":"line_break"},{"type":"verse","number":11,"content":["याहवेहचे वचन माझ्याकडे आले:"]},{"type":"verse","number":12,"content":["“मानवपुत्रा, सोरच्या राजासाठी विलाप कर आणि त्याला सांग: ‘सार्वभौम याहवेह असे म्हणतात:",{"text":"“ ‘तू पूर्णतेची मुद्रा होता,","poem":1},{"text":"जो ज्ञानाने भरलेला व सौंदर्याने परिपूर्ण होता.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तू एदेन बागेत,","poem":1},{"text":"परमेश्वराच्या बागेत होतास;","poem":2},{"text":"प्रत्येक मौल्यवान पाषाण म्हणजेच","poem":1},{"text":"अलाक, पुष्कराज आणि हिरा, लसणा,","poem":2},{"lineBreak":true},{"text":"गोमेद, यास्फे आणि नीलमणी,","poem":2},{"lineBreak":true},{"text":"पाचू, माणिक व रत्ने अशांनी तू सजला होता.","poem":2},{"text":"तुझ्या बैठकी व पाटे सोन्याच्या घडल्या होत्या;","poem":1},{"text":"तू जन्मला त्याच दिवशी ते तयार केले होते.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"संरक्षक करूब म्हणून तुला अभिषिक्त केले,","poem":1},{"text":"म्हणून मी तुझी नेमणूक केली.","poem":2},{"text":"परमेश्वराच्या पवित्र डोंगरावर होता;","poem":1},{"text":"आणि तू अग्निपाषाणात फिरत असे.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"तुझी निर्मिती झाली तेव्हापासून","poem":1},{"text":"तुझ्यात दुष्टता आढळली तोपर्यंत","poem":2},{"lineBreak":true},{"text":"तू तुझ्या मार्गात सरळ होता.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"तुझ्या विस्तारित व्यापारामुळे","poem":1},{"text":"तू आतंकाने भरला","poem":2},{"lineBreak":true},{"text":"आणि तू पाप केले.","poem":2},{"text":"म्हणून लज्जेने मी तुला परमेश्वराच्या डोंगरावरून लोटून दिले,","poem":1},{"text":"आणि हे संरक्षक करुबा,","poem":2},{"lineBreak":true},{"text":"मी तुला अग्निपाषाणातून काढून टाकले.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"तुझे हृदय तुझ्या सौंदर्यामुळे","poem":1},{"text":"अहंकारी झाले,","poem":2},{"text":"आणि तुझ्या वैभवामुळे","poem":1},{"text":"तू तुझ्या ज्ञानाला भ्रष्ट केले.","poem":2},{"text":"म्हणून मी तुला भूमीवर टाकून दिले;","poem":1},{"text":"आणि राजांसमोर मी तुला तमाशा असे केले.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"तुझ्या पुष्कळ पापाने व खोट्या व्यापारामुळे","poem":1},{"text":"तू तुझी पवित्रस्थाने विटाळलीस.","poem":2},{"text":"म्हणून तुझ्यातून अग्नी येईल","poem":1},{"text":"आणि तुला भस्म करेल असे मी केले,","poem":2},{"text":"आणि सर्व बघणार्‍यांच्या देखत","poem":1},{"text":"मी तुला राखेत मिळविले.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ज्या सर्व राष्ट्रांना तुझी ओळख होती","poem":1},{"text":"ते तुला पाहून भयभीत झाले आहेत;","poem":2},{"text":"तुझा भयंकर अंत झाला आहे","poem":1},{"text":"आणि तुझे अस्तित्व नाहीसे झाले आहे.’ ”","poem":2}]},{"type":"heading","content":["सीदोनविरुद्ध भविष्यवाणी"]},{"type":"verse","number":20,"content":["याहवेहचे वचन माझ्याकडे आले:"]},{"type":"verse","number":21,"content":["“मानवपुत्रा, सीदोनेकडे आपले मुख कर; आणि तिच्याविषयी भविष्यवाणी कर"]},{"type":"verse","number":22,"content":["आणि म्हण: ‘सार्वभौम याहवेह असे म्हणतात:",{"text":"“ ‘हे सीदोन नगरी, मी तुझ्याविरुद्ध आहे,","poem":1},{"text":"आणि तुझ्यामध्ये मी माझे गौरव प्रकट करेन.","poem":2},{"text":"जेव्हा मी तुला शिक्षेने पिडेन,","poem":1},{"text":"आणि तुझ्यात मी पवित्र मानला जाईन","poem":2},{"lineBreak":true},{"text":"तेव्हा तू जाणशील की मीच याहवेह आहे.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"मी तुझ्यावर मरी पाठवेन","poem":1},{"text":"आणि तुझ्या रस्त्यांवर रक्त वाहवीन.","poem":2},{"text":"चहूकडून तुझ्याविरुद्ध चालविलेल्या तलवारीने वधलेले","poem":1},{"text":"तुझ्यातच पडतील.","poem":2},{"text":"तेव्हा तुम्ही जाणाल की मीच याहवेह आहे.","poem":1}]},{"type":"verse","number":24,"content":["“ ‘इस्राएली लोकांना काटेरी झुडूपांसारखे आणि धारदार काट्यांप्रमाणे द्वेष्ट वृत्ती असलेले शेजारी आणखी नसतील. तेव्हा ते जाणतील की मीच सार्वभौम याहवेह आहे."]},{"type":"verse","number":25,"content":["“ ‘सार्वभौम याहवेह असे म्हणतात: ज्या राष्ट्रांमध्ये इस्राएली लोक पांगले आहेत तिथून मी त्यांना जेव्हा एकवट करेन, तेव्हा त्यांच्याद्वारे राष्ट्रांच्या देखत मी पवित्र मानला जाईन. तेव्हा जो देश मी माझा सेवक याकोबाला देऊ केला होता, ते त्यांच्या त्या स्वदेशात राहतील."]},{"type":"verse","number":26,"content":["ते तिथे सुरक्षित राहतील आणि घरे बांधतील व द्राक्षमळे लावतील. ते सुरक्षित असतील जेव्हा मी त्यांचे शेजारी ज्यांनी माझ्या लोकांची चहाडी केली त्यांना मी दंडाने पिडेन. तेव्हा ते जाणतील की मीच याहवेह त्यांचा परमेश्वर आहे.’ ”"]}],"footnotes":[{"noteId":33,"caller":"+","text":"पुरातन लेखनातील प्रख्यात मनुष्य","reference":{"chapter":28,"verse":3}}]},"thisChapterLink":"/api/mar_cbi/EZK/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/EZK/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/EZK/27.json","previousChapterAudioLinks":{},"numberOfVerses":26}