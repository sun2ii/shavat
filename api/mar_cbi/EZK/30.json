{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"EZK","translationId":"mar_cbi","name":"यहेज्केल","commonName":"यहेज्केल","title":"यहेज्केलाची भविष्यवाणी","order":26,"numberOfChapters":48,"sha256":"a43dad6396faa8d40b7c48e8092f735f0290982451c5dde185c094f79cd3576a","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/mar_cbi/EZK/48.json","totalNumberOfVerses":1272},"chapter":{"number":30,"content":[{"type":"heading","content":["इजिप्तसाठी विलाप"]},{"type":"verse","number":1,"content":["याहवेहचे वचन माझ्याकडे आले:"]},{"type":"verse","number":2,"content":["“मानवपुत्रा, भविष्यवाणी कर आणि सांग: ‘सार्वभौम याहवेह असे म्हणतात:",{"text":"“ ‘आक्रोश करून सांग,","poem":1},{"text":"“त्या दिवसाला हाय हाय!”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"कारण दिवस जवळ आहे,","poem":1},{"text":"याहवेहचा दिवस जवळ आहे;","poem":2},{"text":"तो आभाळाचा दिवस,","poem":1},{"text":"राष्ट्रांच्या नाशाचा दिवस असेल.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"इजिप्तविरुद्ध एक तलवार येईल","poem":1},{"text":"आणि कूशवर वेदना येतील.","poem":2},{"text":"जेव्हा वधलेले इजिप्तमध्ये पडतील,","poem":1},{"text":"तिची संपत्ती काढून घेतली जाईल","poem":2},{"lineBreak":true},{"text":"आणि तिचे पाये मोडून टाकले जातील.","poem":2}]},{"type":"verse","number":5,"content":["कूश आणि लिबिया, लूद व संपूर्ण अरब, कूब आणि कराराच्या देशाचे लोक इजिप्तबरोबर तलवारीने पडतील."]},{"type":"verse","number":6,"content":["“ ‘सार्वभौम याहवेह असे म्हणतात:",{"text":"“ ‘इजिप्तचे मित्रगण पडतील","poem":1},{"text":"तिचे अहंकारी बळ सुद्धा पडेल.","poem":2},{"text":"मिग्दोलपासून असवानपर्यंत","poem":1},{"text":"सर्व तिच्यामध्ये तलवारीने पडतील,","poem":2},{"lineBreak":true},{"text":"असे सार्वभौम याहवेह जाहीर करतात.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"सर्व ओसाड पडलेल्या देशांमध्ये,","poem":1},{"text":"ते ओसाड पडतील,","poem":2},{"text":"आणि त्यांची शहरे","poem":1},{"text":"उद्ध्वस्त झालेल्या शहरांमध्ये पडतील.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तेव्हा ते जाणतील की मीच याहवेह आहे,","poem":1},{"text":"मी जेव्हा इजिप्तला आग लावेन,","poem":2},{"lineBreak":true},{"text":"तेव्हा तिला मदत करणार्‍यांचाही चुरा होईल.","poem":2}]},{"type":"verse","number":9,"content":["“ ‘त्या दिवशी त्या कूशी लोकांना घाबरवून त्यांच्या निश्चिंतेतून बाहेर काढावे म्हणून माझ्याकडून जहाजामध्ये संदेष्टे जातील. इजिप्तच्या नाशाच्या दिवशी वेदना त्यांचा ताबा घेईल, कारण तो दिवस खचितच येत आहे."]},{"type":"line_break"},{"type":"verse","number":10,"content":["“ ‘सार्वभौम याहवेह असे म्हणतात:",{"text":"“ ‘बाबेलचा राजा नबुखद्नेस्सरच्या हातून","poem":1},{"text":"मी इजिप्तच्या टोळीचा अंत करेन.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तो व त्याचे सैन्य; जे राष्ट्रांमध्ये सर्वाधिक क्रूर आहेत;","poem":1},{"text":"त्यांना इजिप्तचा नाश करण्यास आणले जाईल.","poem":2},{"text":"ते इजिप्तविरुद्ध त्यांची तलवार उपसतील","poem":1},{"text":"आणि वधलेल्यांनी देश भरून टाकतील.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"नाईल नदीचे पाणी मी आटवून टाकेन","poem":1},{"text":"आणि तो देश दुष्ट राष्ट्रांना विकून टाकेन;","poem":2},{"text":"विदेशी लोकांच्या हातून","poem":1},{"text":"मी तो देश व त्यातील सर्वकाही ओसाड करेन.","poem":2},"मी याहवेह हे बोललो आहे."]},{"type":"line_break"},{"type":"verse","number":13,"content":["“ ‘सार्वभौम याहवेह म्हणतात:",{"text":"“ ‘मी मूर्तींचा नाश करेन","poem":1},{"text":"आणि मेम्फीस","poem":2},{"noteId":37},{"text":"येथील प्रतिमांचा मी शेवट करेन.","poem":2},{"text":"इजिप्तमध्ये यापुढे राजकुमार नसतील,","poem":1},{"text":"आणि संपूर्ण देशभर मी भय पसरवेन.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"इजिप्तचा पथरोस मी उजाड करेन,","poem":1},{"text":"सोअन नगराला आग लावेन","poem":2},{"lineBreak":true},{"text":"आणि नओ","poem":2},{"noteId":38},{"text":"नगराला दंड देईन.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"सीन","poem":1},{"noteId":39},{"text":"जो इजिप्तचा बळकट दुर्ग,","poem":1},{"text":"यावर मी माझा कोप ओतेन,","poem":2},{"lineBreak":true},{"text":"आणि नओचे सैन्य नष्ट करेन.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"मी इजिप्तला आग लावेन;","poem":1},{"text":"सीन वेदनांनी तळमळेल.","poem":2},{"text":"नओ वादळात उडून जाईल;","poem":1},{"text":"मेम्फीस","poem":2},{"noteId":40},{"text":"सातत्याने कष्टात राहील.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ओन","poem":1},{"noteId":41},{"text":"व पी-बेसेथचे","poem":1},{"noteId":42},{"text":"तरुण पुरुष","poem":1},{"text":"तलवारीने पडतील,","poem":2},{"lineBreak":true},{"text":"आणि शहरे बंदिवासात जातील.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"तहपनहेसमध्ये दिवसा काळोख होईल","poem":1},{"text":"जेव्हा मी इजिप्तचे जू मोडून टाकीन;","poem":2},{"lineBreak":true},{"text":"तेव्हा तिच्या अहंकाराच्या सामर्थ्याचा शेवट करेन.","poem":2},{"text":"ती ढगांनी झाकली जाईल,","poem":1},{"text":"आणि तिची गावे बंदिवासात जातील.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"याप्रकारे मी इजिप्तवर दंड आणेन","poem":1},{"text":"आणि ते जाणतील की मीच याहवेह आहे.’ ”","poem":2}]},{"type":"heading","content":["फारोहचे हात मोडले जातात"]},{"type":"verse","number":20,"content":["अकराव्या वर्षी, पहिल्या महिन्याच्या सातव्या दिवशी, याहवेहचे वचन माझ्याकडे आले:"]},{"type":"verse","number":21,"content":["“मानवपुत्रा, इजिप्तचा राजा फारोह याचा हात मी मोडला आहे. तो बरा व्हावा म्हणून त्याला पट्टी बांधली नाही किंवा तलवार धरता येईल इतकी शक्ती मिळावी म्हणून दोरीतही ठेवला नाही."]},{"type":"verse","number":22,"content":["म्हणून सार्वभौम याहवेह असे म्हणतात, मी इजिप्तचा राजा फारोह याच्याविरुद्ध आहे. मी त्याचे हात म्हणजे जो अभंग आहे व जो मोडलेला आहे असे दोन्ही हात मोडेन, म्हणजे त्याच्या हातून तलवार गळून पडेल."]},{"type":"verse","number":23,"content":["मी इजिप्तच्या लोकांची राष्ट्रांमध्ये पांगापांग करेन आणि इतर देशांमध्ये त्यांना विखरून टाकेन."]},{"type":"verse","number":24,"content":["मी बाबेलच्या राजाचे हात बळकट करेन आणि माझी तलवार त्याच्या हाती देईन पण फारोहचे हात मोडेन आणि तो बाबेलच्या राजासमोर मरणपंथास टेकलेल्या घायाळ मनुष्याप्रमाणे कण्हेल."]},{"type":"verse","number":25,"content":["मी बाबेलच्या राजाचे हात बळकट करेन, परंतु फारोहचे हात लुळे पडतील. जेव्हा मी बाबेलच्या राजाच्या हाती माझी तलवार देईन आणि जेव्हा तो ती इजिप्तविरुद्ध चालवील, तेव्हा ते जाणतील की मीच याहवेह आहे."]},{"type":"verse","number":26,"content":["इजिप्तच्या लोकांना मी राष्ट्रांमध्ये पांगवेन आणि इतर देशांमध्ये त्यांना विखरेन. तेव्हा ते जाणतील की मीच याहवेह आहे.”"]}],"footnotes":[{"noteId":37,"caller":"+","text":"किंवा नोफ","reference":{"chapter":30,"verse":13}},{"noteId":38,"caller":"+","text":"किंवा थेबेस","reference":{"chapter":30,"verse":14}},{"noteId":39,"caller":"+","text":"किंवा पेलुसीअम","reference":{"chapter":30,"verse":15}},{"noteId":40,"caller":"+","text":"किंवा नोफ","reference":{"chapter":30,"verse":16}},{"noteId":41,"caller":"+","text":"किंवा हेलिओपोलिस","reference":{"chapter":30,"verse":17}},{"noteId":42,"caller":"+","text":"किंवा बुबास्तिस","reference":{"chapter":30,"verse":17}}]},"thisChapterLink":"/api/mar_cbi/EZK/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/EZK/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/EZK/29.json","previousChapterAudioLinks":{},"numberOfVerses":26}