{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"EZK","translationId":"mar_cbi","name":"यहेज्केल","commonName":"यहेज्केल","title":"यहेज्केलाची भविष्यवाणी","order":26,"numberOfChapters":48,"sha256":"a43dad6396faa8d40b7c48e8092f735f0290982451c5dde185c094f79cd3576a","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/mar_cbi/EZK/48.json","totalNumberOfVerses":1272},"chapter":{"number":7,"content":[{"type":"heading","content":["अंत आला आहे"]},{"type":"verse","number":1,"content":["याहवेहचे वचन माझ्याकडे आले:"]},{"type":"verse","number":2,"content":["“मानवपुत्रा, इस्राएल देशाला सार्वभौम याहवेह असे म्हणतात:",{"text":"“ ‘अंत! देशाच्या चारही कोपर्‍यांवर","poem":1},{"text":"शेवट आला आहे!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"आता तुमचा शेवट आला आहे,","poem":1},{"text":"आणि तुमच्याविरुद्ध मी माझा राग मोकळा सोडेन.","poem":2},{"text":"तुमच्या कृत्यांनुसार मी तुमचा न्याय करेन","poem":1},{"text":"आणि तुमच्या सर्व अमंगळ कृत्यांचे प्रतिफळ तुम्हाला देईन.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मी तुमच्याकडे दयेने पाहणार नाही;","poem":1},{"text":"मी तुमची गय करणार नाही.","poem":2},{"text":"मी खचितच तुमच्या कृत्यांचे","poem":1},{"text":"आणि तुमच्यातील अमंगळ कृत्यांचे प्रतिफळ तुम्हाला देईन.","poem":2},"तेव्हा तुम्ही जाणाल की मीच याहवेह आहे.’"]},{"type":"line_break"},{"type":"verse","number":5,"content":["“सार्वभौम याहवेह असे म्हणतात:",{"text":"“ ‘विपत्ती! कधी ऐकली नाही","poem":1},{"noteId":6},{"text":"अशी विपत्ती","poem":1},{"text":"पाहा, ती येत आहे!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"अंत आला आहे!","poem":1},{"text":"अंत आला आहे!","poem":2},{"text":"तो स्वतः तुझ्याविरुद्ध उठला आहे.","poem":1},{"text":"पाहा, तो येत आहे!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तुम्ही जे देशात राहतात,","poem":1},{"text":"त्या तुमच्यावर विनाश आला आहे.","poem":2},{"text":"समय आला आहे! दिवस जवळ आहे!","poem":1},{"text":"डोंगरावर आनंद नाही, तर गोंधळ आहे.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"मी आपला क्रोध तुमच्यावर लवकरच ओतीत आहे","poem":1},{"text":"आणि माझा राग तुमच्याविरुद्ध भडकणार आहे.","poem":2},{"text":"तुमच्या कृत्यांनुसार मी तुमचा न्याय करेन","poem":1},{"text":"आणि तुमच्या सर्व अमंगळ कृत्यांचे प्रतिफळ तुम्हाला देईन.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"मी तुमच्याकडे दयेने पाहणार नाही;","poem":1},{"text":"मी तुमची गय करणार नाही.","poem":2},{"text":"मी तुम्हाला तुमच्या कृत्यांचे","poem":1},{"text":"आणि तुमच्यातील अमंगळ कार्याचे प्रतिफळ देईन.","poem":2},{"lineBreak":true},"“ ‘तेव्हा तुम्ही जाणाल की मी याहवेहने तुमच्यावर वार केला आहे."]},{"type":"verse","number":10,"content":[{"text":"“ ‘पाहा, तो दिवस!","poem":1},{"text":"पाहा, तो येत आहे!","poem":2},{"text":"विनाशाचा भडका उठला आहे,","poem":1},{"text":"काठीला अंकुर फुटला आहे,","poem":2},{"lineBreak":true},{"text":"अहंकार फुलला आहे!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"हिंसा उदय पावली आहे,","poem":1},{"text":"दुष्टाला शिक्षा करण्यास काठी उठली आहे.","poem":2},{"text":"त्या लोकांतून कोणीही,","poem":1},{"text":"त्या समुहातील कोणीही सुटणार नाही;","poem":2},{"text":"त्यांच्या संपत्तीतील,","poem":1},{"text":"कशाचे काहीही मोल राहणार नाही.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"समय आला आहे!","poem":1},{"text":"दिवस येऊन ठेपला आहे!","poem":2},{"text":"विकत घेणार्‍याने आनंद करू नये","poem":1},{"text":"किंवा विकत देणार्‍याने दुःखी होऊ नये,","poem":2},{"lineBreak":true},{"text":"कारण माझा क्रोध संपूर्ण समुहावर आहे.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"जोपर्यंत विकत घेणारा व देणारा जिवंत आहे","poem":1},{"text":"तोपर्यंत जी संपत्ती विकण्यात आली होती;","poem":2},{"lineBreak":true},{"text":"त्याची फेड होणार नाही.","poem":2},{"text":"कारण संपूर्ण समुहाविषयी असलेला दृष्टान्त","poem":1},{"text":"पलटणार नाही.","poem":2},{"text":"त्यांच्या पापामुळे त्यांच्यातील एकही व्यक्ती","poem":1},{"text":"आपला जीव वाचविणार नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ ‘त्यांनी कर्णे वाजविली आहे,","poem":1},{"text":"त्यांनी सर्वकाही सज्ज केले आहे,","poem":2},{"text":"परंतु कोणी युद्धात जाणार नाही,","poem":1},{"text":"कारण संपूर्ण समुहावर माझा क्रोध आहे.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"बाहेर तलवार आहे;","poem":1},{"text":"व आत पीडा व दुष्काळ आहे.","poem":2},{"text":"जे देशात राहतात","poem":1},{"text":"ते तलवारीने मरतील;","poem":2},{"text":"जे शहरात आहेत","poem":1},{"text":"ते दुष्काळ व पीडांनी नाश पावतील.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"आश्रयासाठी पळ काढणारे","poem":1},{"text":"डोंगराकडे पळतील.","poem":2},{"text":"खोर्‍यातील पारव्यांप्रमाणे,","poem":1},{"text":"आपल्या स्वतःच्या पापाकरिता,","poem":2},{"lineBreak":true},{"text":"ते सर्व शोक करतील.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"प्रत्येक हात ढिले पडतील;","poem":1},{"text":"प्रत्येक पाय लघवीने भिजेल.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ते गोणपाट नेसतील","poem":1},{"text":"आणि भयाचे वस्त्र घालतील.","poem":2},{"text":"प्रत्येक चेहरा लज्जेने झाकला जाईल,","poem":1},{"text":"आणि प्रत्येक डोक्याचे मुंडण केले जाईल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“ ‘ते आपली चांदी रस्त्यावर फेकतील,","poem":1},{"text":"आणि त्यांचे सोने अशुद्ध मानले जाईल.","poem":2},{"text":"याहवेहच्या क्रोधाच्या दिवशी","poem":1},{"text":"त्यांचे चांदी व सोने","poem":2},{"lineBreak":true},{"text":"त्यांची सुटका करू शकणार नाही.","poem":2},{"text":"ते त्यांची भूक मिटवणार नाही","poem":1},{"text":"किंवा त्यांचे पोट भरणार नाही,","poem":2},{"lineBreak":true},{"text":"कारण त्यांच्या संपत्तीनेच त्यांना पापात पडण्यास भाग पाडले आहे.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"त्यांनी त्यांच्या सुंदर दागिन्यांविषयी गर्व केला","poem":1},{"text":"आणि त्यांच्या अमंगळ मूर्ती बनवण्यास त्यांचा उपयोग केला.","poem":2},{"text":"त्यांनी त्यांच्या व्यर्थ प्रतिमा बनविल्या;","poem":1},{"text":"म्हणून ते दागिने मी त्यांच्यासाठी अशुद्ध करेन.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"मी त्यांची संपत्ती परदेशीयांना लूट अशी देईन","poem":1},{"text":"आणि पृथ्वीतील दुष्ट ते लुबाडून घेतील,","poem":2},{"lineBreak":true},{"text":"व ते भ्रष्ट करतील.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"लोकांपासून मी आपले मुख वळवेन,","poem":1},{"text":"आणि मी जतन केलेले माझे मौल्यवान स्थळ लुटारू अपवित्र करतील.","poem":2},{"text":"ते त्यात शिरतील","poem":1},{"text":"आणि त्यास भ्रष्ट करतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“ ‘साखळ्या तयार करा!","poem":1},{"text":"कारण देश रक्तपाताने,","poem":2},{"lineBreak":true},{"text":"आणि शहर हिंसेने भरले आहे.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"सर्वात दुष्ट राष्ट्रांना मी आणेन","poem":1},{"text":"जे त्यांच्या घरांचा ताबा घेतील.","poem":2},{"text":"बलवानाच्या गर्वाचा मी शेवट करेन,","poem":1},{"text":"आणि त्यांची पवित्रस्थाने भ्रष्ट होतील.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"जेव्हा आतंक येतो,","poem":1},{"text":"ते व्यर्थच शांतीचा शोध करतील.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"विपत्तीनंतर विपत्ती,","poem":1},{"text":"आणि अफवांवर अफवा येतील.","poem":2},{"text":"संदेष्ट्याकडून दृष्टान्ताचा शोध करतील,","poem":1},{"text":"नियमशास्त्रातील याजकीय सूचना थांबतील,","poem":2},{"lineBreak":true},{"text":"वडील लोकांच्या बोधप्रद मसलतीचा शेवट होईल.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"राजा शोक करेल,","poem":1},{"text":"राजकुमार निराशेची वस्त्रे पांघरेल,","poem":2},{"lineBreak":true},{"text":"आणि देशातील लोकांचे हात थरथर कापतील.","poem":2},{"text":"त्यांच्या कृत्यांनुसार मी त्यांच्याशी वागेन,","poem":1},{"text":"आणि त्यांच्या स्वतःच्या मापानुसार मी त्यांचा न्याय करेन.","poem":2},{"lineBreak":true},"“ ‘तेव्हा ते जाणतील की मीच याहवेह आहे.’ ”"]}],"footnotes":[{"noteId":6,"caller":"+","text":"काही मूळ प्रतींनुसार विपत्तीवर विपत्ती","reference":{"chapter":7,"verse":5}}]},"thisChapterLink":"/api/mar_cbi/EZK/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/EZK/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/EZK/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}