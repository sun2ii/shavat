{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"GEN","translationId":"mar_cbi","name":"उत्पत्ती","commonName":"उत्पत्ती","title":"उत्पत्तीचे पुस्तक","order":1,"numberOfChapters":50,"sha256":"52e3078e102716db4527d6f7f8e52fb04f1b8b3e6f83a25af01cfc2cfe2efbed","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/mar_cbi/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":49,"content":[{"type":"heading","content":["याकोब आपल्या मुलांना आशीर्वाद देतो"]},{"type":"verse","number":1,"content":["नंतर याकोबाने आपल्या सर्व मुलांना बोलावून म्हटले: “असे माझ्याभोवती गोळा व्हा, म्हणजे पुढे भविष्यकाळात तुमचे काय होणार आहे ते मी तुम्हाला सांगेन."]},{"type":"verse","number":2,"content":[{"text":"“एकत्र व्हा आणि माझे ऐका, अहो याकोबाच्या पुत्रांनो;","poem":1},{"text":"तुमचा पिता इस्राएल याचे ऐका.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“रऊबेना, तू माझा प्रथमपुत्र आहेस, माझे बळ,","poem":1},{"text":"पौरुषाचे प्रथमफळ असा आहेस.","poem":2},{"lineBreak":true},{"text":"प्रतिष्ठा आणि शक्तीत उत्कृष्ट असा तू आहेस.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तू अशांत पाण्यासारखा उग्र आहे,","poem":1},{"text":"तू अजून उत्कृष्ट होणार नाही, कारण तू तुझ्या वडिलांच्या खाटेवर,","poem":2},{"lineBreak":true},{"text":"माझ्या खाटेवर चढला आणि ते अशुद्ध केले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“शिमओन व लेवी हे दोघे भाऊ आहेत,","poem":1},{"text":"त्यांची तलवार ही अत्याचाराचे साधन आहे.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मी त्यांच्या सभेमध्ये जाऊ नये,","poem":1},{"text":"त्यांच्या मंडळीमध्ये मी सामील होऊ नये,","poem":2},{"text":"कारण रागाच्या भरात त्यांनी माणसांचा वध केला,","poem":1},{"text":"आणि वाटेल तसे बैलांची धोंडशीर तोडली.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"त्यांचा क्रोध शापित असो,","poem":1},{"text":"आणि त्यांचा संताप, किती क्रूर आहे!","poem":2},{"text":"मी त्यांची याकोबामध्ये पांगापांग करेन,","poem":1},{"text":"आणि त्यांना इस्राएलभर पांगवून टाकेन.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“हे यहूदाह,","poem":1},{"noteId":113},{"text":"तुझे भाऊ तुझी प्रशंसा करतील;","poem":1},{"text":"तुझा हात तुझ्या शत्रूंच्या मानेवर राहील;","poem":2},{"lineBreak":true},{"text":"तुझ्या पित्याचे पुत्र तुला नमन करतील.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"यहूदाह, तू सिंहाचा छावा आहेस.","poem":1},{"text":"माझ्या मुला, तू तुझ्या शिकारीहून परत येतो.","poem":2},{"text":"सिंहासारखा दबा धरून बसतो व विसावा घेतो,","poem":1},{"text":"सिंहिणीप्रमाणे आहेस—त्याला कोण छेडणार?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"यहूदाहपासून राजदंड कधीही वेगळा होणार नाही,","poem":1},{"text":"किंवा अधिकाराची काठी त्याच्या पायामधून निघून जाणार नाही,","poem":2},{"text":"ज्याचे जे आहे","poem":1},{"noteId":114},{"text":"तो येईपर्यंत,","poem":1},{"text":"राष्ट्रे त्याची आज्ञा पाळतील.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तो आपले गाढव द्राक्षवेलीला,","poem":1},{"text":"गाढवीचे शिंगरू उत्कृष्ट द्राक्षवेलीला बांधून ठेवणार आहे;","poem":2},{"text":"आपला झगा द्राक्षारसात,","poem":1},{"text":"आपली वस्त्रे द्राक्षाच्या रक्तात धुणार आहे.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"त्याचे नेत्र द्राक्षारसापेक्षा गर्द होतील,","poem":1},{"text":"त्याचे दात दुधापेक्षाही पांढरे होतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“जबुलून समुद्रकिनारी राहील","poem":1},{"text":"आणि तो जहाजांचे बंदर होईल.","poem":2},{"lineBreak":true},{"text":"त्याची सीमा सीदोनपर्यंत पसरेल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“इस्साखार बळकट गाढव आहे.","poem":1},{"text":"तो मेंढवाड्यांमध्ये दबून बसला आहे.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"त्याची विश्रांतीची जागा किती रम्य आहे","poem":1},{"text":"आणि तिकडचा प्रदेश किती आल्हाददायक आहे,","poem":2},{"text":"हे पाहून तो आपल्या खांद्याला भार वाहण्यासाठी वाकवेल","poem":1},{"text":"आणि मजुरीचा दास होऊन जाईल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“दान आपल्या लोकांना न्यायदान करेल,","poem":1},{"text":"इस्राएलाच्या एका गोत्राप्रमाणे तो हे करेल.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"दान हा रस्त्याच्या कडावरील सर्प बनेल,","poem":1},{"text":"तो वाटेवरील विषारी सर्प बनेल,","poem":2},{"text":"जो घोड्याच्या टापांचा चावा घेईल","poem":1},{"text":"व घोडेस्वार खाली कोसळेल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“हे याहवेह, मी तुमच्या तारणाची वाट पाहत आहे.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“एक लुटारूची टोळी गादवर हल्ला करेल,","poem":1},{"text":"पण गाद त्यांच्या टाचेवर तडाखा देईल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“आशेरला पौष्टिक अन्न मिळेल;","poem":1},{"text":"आणि तो राजास योग्य अशी मिष्टान्ने पुरवेल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“नफताली स्वैर हरिणीप्रमाणे आहे,","poem":1},{"text":"त्याला सुंदर पाडसे होतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“योसेफ हा फलवंत वेल आहे,","poem":1},{"text":"पाण्याच्या झर्‍याजवळ लावलेली फलवंत वेल आहे,","poem":2},{"lineBreak":true},{"text":"तिच्या फांद्या भिंतीवर पसरल्या आहेत.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"कटुतेने तिरंदाजांनी त्याच्यावर हल्ला केला;","poem":1},{"text":"त्यांनी त्याच्यावर वैराने बाण सोडले.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"परंतु त्याचे धनुष्य स्थिर राहिले,","poem":1},{"text":"त्याचे बाहू मजबूत राहिले,","poem":2},{"text":"याचे कारण याकोबाचे सर्वसमर्थ परमेश्वर,","poem":1},{"text":"ते मेंढपाळ आणि इस्राएलचे खडक आहेत.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"कारण तुझ्या पित्याचे परमेश्वर, तुझे सहायक आहेत,","poem":1},{"text":"कारण सर्वसमर्थ, जे तुला आशीर्वादित करतात,","poem":2},{"text":"वरून स्वर्गातील आशीर्वाद,","poem":1},{"text":"खोलातील डोहातून निघणार्‍या झर्‍यातील आशीर्वाद,","poem":2},{"lineBreak":true},{"text":"स्तने आणि गर्भांच्या आशीर्वादांचा वर्षाव करो.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"तुझ्या पित्याचे आशीर्वाद","poem":1},{"text":"पूर्वजांच्या पर्वतापेक्षा श्रेष्ठ आशीर्वाद आहेत,","poem":2},{"lineBreak":true},{"text":"ते सर्वकालीन पर्वतांच्या संपन्नतेपेक्षा श्रेष्ठ आहेत.","poem":2},{"text":"हे आशीर्वाद योसेफाच्या मस्तकी,","poem":1},{"text":"जो आपल्या भावामधील राजपुत्र आहे, त्याच्या मस्तकी येवोत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“बिन्यामीन, हा भुकेला लांडगा आहे;","poem":1},{"text":"तो सकाळच्या प्रहरी शिकार करतो,","poem":2},{"lineBreak":true},{"text":"आणि संध्याकाळी लूट वाटतो.”","poem":2}]},{"type":"verse","number":28,"content":["हे सर्व इस्राएलचे बारा गोत्र आहेत आणि मुलांना आशीर्वाद देण्याकरिता त्यांचा पिता असा बोलला, प्रत्येकाला त्याने यथायोग्य आशीर्वाद दिला."]},{"type":"heading","content":["याकोबाचा मृत्यू"]},{"type":"verse","number":29,"content":["नंतर त्याने आपल्या पुत्रांस या सूचना दिल्या: “आता लवकरच माझा अंत होईल, तेव्हा एफ्रोन हेथीपासून विकत घेतलेल्या गुहेमध्ये माझ्या वाडवडिलांच्या सोबत मला मूठमाती द्या."]},{"type":"verse","number":30,"content":["कनान देशात अब्राहामाने एफ्रोन हेथीपासून विकत घेतलेली स्मशानभूमी मम्रेसमोरील मकपेला नावाच्या शेतातील गुहेमध्ये आहे."]},{"type":"verse","number":31,"content":["तिथेच त्यांनी अब्राहाम आणि त्याची पत्नी साराहला मूठमाती दिली; तिथेच त्यांनी इसहाक आणि त्याची पत्नी रिबेकाहला मूठमाती दिली आणि तिथेच मी लेआला मूठमाती दिली."]},{"type":"verse","number":32,"content":["ते शेत आणि ती गुहा हेथीच्या लोकांपासून विकत घेतली होती.”"]},{"type":"verse","number":33,"content":["आपल्या पुत्रांसंबंधीची भविष्यवाणी संपविल्यावर याकोबाने आपले पाय बिछान्यावर उचलून घेतले व त्याने अखेरचा श्वास घेऊन प्राण सोडला आणि तो त्याच्या पूर्वजास जाऊन मिळाला."]}],"footnotes":[{"noteId":113,"caller":"+","text":"अर्थात् स्तुती","reference":{"chapter":49,"verse":8}},{"noteId":114,"caller":"+","text":"किंवा त्याच्यापासून त्याचे संतान","reference":{"chapter":49,"verse":10}}]},"thisChapterLink":"/api/mar_cbi/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}