{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"HAB","translationId":"mar_cbi","name":"हबक्कूक","commonName":"हबक्कूक","title":"हबक्कूकची भविष्यवाणी","order":35,"numberOfChapters":3,"sha256":"56055e4ea449b104c4ab0a012b84dc64471b04d5e7569dc8593587f255e91b2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mar_cbi/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["हबक्कूकची प्रार्थना"]},{"type":"verse","number":1,"content":[{"text":"ही हबक्कूक संदेष्ट्याची प्रार्थना. शिगयोनोथच्या शैलीत.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"हे याहवेह, मी तुमची किर्ती ऐकली आहे;","poem":1},{"text":"मी तुमच्या कृत्यामुळे भयप्रद झालो आहे.","poem":2},{"text":"आमच्या दिवसातही त्या कार्याची पुनरावृत्ती करा,","poem":1},{"text":"आमच्या काळात त्या प्रसिद्ध होऊ द्या;","poem":2},{"lineBreak":true},{"text":"क्रोधित असतानाही कृपेची आठवण असू द्या.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"परमेश्वर तेमान वरून आले,","poem":1},{"text":"परमपवित्र पारान पर्वतावरून आले. सेला","poem":2},{"noteId":5},{"text":"त्याच्या गौरवाने आकाश व्यापून गेले आहे","poem":1},{"text":"व पृथ्वी त्याच्या स्तुतीने भरून गेली आहे.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"त्यांचे तेज सूर्योदयेसारखे होते;","poem":1},{"text":"किरणे त्यांच्या हातांतून चकाकत बाहेर निघत होती,","poem":2},{"lineBreak":true},{"text":"जिथे त्यांचे सामर्थ्य लपलेले होते.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"महामारी त्यांच्या पुढे चालते;","poem":1},{"text":"घातकी रोग त्यांच्यामागे चालतात.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ते थांबले व त्यांनी पृथ्वीस हालवून टाकले;","poem":1},{"text":"त्यांनी बघितले व देशास थरकाप आणला.","poem":2},{"text":"पुरातन पर्वतांचा चुराडा झाला","poem":1},{"text":"प्राचीन डोंगर ढासळले—","poem":2},{"lineBreak":true},{"text":"परंतु ते सर्वकाळ मार्गस्थ आहेत.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"कूशानाचे तंबू पीडित झालेले मी बघितले,","poem":1},{"text":"व मिद्यानाचे रहिवासी भयग्रस्त झालेले मी पाहिले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"हे याहवेह, तुम्ही नद्यांवर संतापला होता काय?","poem":1},{"text":"झऱ्यांविरुद्ध तुमचा कोप होता काय?","poem":2},{"text":"जेव्हा जय मिळविण्यासाठी तुम्ही अश्वारूढ झालात","poem":1},{"text":"व तुमच्या रथात स्वार झालात,","poem":2},{"lineBreak":true},{"text":"तेव्हा तुम्ही समुद्राविरुद्ध क्रोधित झाला होता काय?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तुम्ही तुमचे धनुष्य बाहेर काढले,","poem":1},{"text":"व अनेक बाण मागविले. सेला","poem":2},{"text":"नद्यांनी भूमी विभागली;","poem":1}]},{"type":"verse","number":10,"content":[{"text":"पर्वतांनी हे पाहिले आणि ते कंपित झाले.","poem":2},{"text":"पाण्याचा प्रखर प्रवाह झपाट्याने आला;","poem":1},{"text":"खोल समुद्र गरजला","poem":2},{"lineBreak":true},{"text":"आणि त्याने आपल्या लाटा उंच उफाळल्या.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"तुमच्या झेप घेणाऱ्या बाणांच्या तेजाने","poem":1},{"text":"विजेप्रमाणे चकाकणार्‍या तुमच्या भाल्याच्या प्रकाशाने","poem":2},{"lineBreak":true},{"text":"सूर्य व चंद्र आकाशात स्तब्ध उभे राहिले.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"क्रोधित होऊन तुम्ही पृथ्वीवर चालत गेला","poem":1},{"text":"आणि संतापाने तुम्ही राष्ट्रांना पायदळी तुडविले.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तुम्ही आपल्या लोकांना तारण्यास व","poem":1},{"text":"अभिषिक्तांना वाचविण्यासाठी बाहेर पडलात.","poem":2},{"text":"तुम्ही दुष्ट भूमीच्या पुढाऱ्यांचा चुराडा केला","poem":1},{"text":"आणि त्यांना डोक्यापासून पायांपर्यंत विवस्त्र केले. सेला","poem":2}]},{"type":"verse","number":14,"content":[{"text":"आमची दाणादाण करण्यासाठी त्यांचे योद्धे धावून आले,","poem":1},{"text":"तेव्हा त्याने स्वतःच्याच भाल्याने आपले मस्तक छेदून घेतले,","poem":2},{"text":"लपलेल्या दुष्टास जणू तो गिळंकृत करेल","poem":1},{"text":"अशा हावरटपणाने तो आला.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"तुमच्या घोड्यांनी समुद्रास असे तुडविले,","poem":1},{"text":"की महाजलाशय घुसळले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"मी हे ऐकले आणि माझ्या हृदयात धडकी भरली,","poem":1},{"text":"भीतीने माझे ओठ कापू लागले;","poem":2},{"text":"माझ्या हाडात नाशाने प्रवेश केला,","poem":1},{"text":"आणि माझे पाय थरथरू लागले.","poem":2},{"text":"तरी देखील मी आमच्यावर आक्रमण करणाऱ्या देशावर","poem":1},{"text":"येणाऱ्या संकटाच्या दिवसाची शांतपणे वाट पाहत राहीन.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"अंजिरांची झाडे ना बहरली","poem":1},{"text":"आणि द्राक्षलतांवर फळे राहिली नाहीत,","poem":2},{"text":"जैतुनाचे सर्व पीक बुडाले","poem":1},{"text":"आणि शेते नापीक झाली,","poem":2},{"text":"जरी मेंढवाड्यात मेंढरे राहिली नाहीत,","poem":1},{"text":"गोठ्यात गुरे नाहीत,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"तरी मी याहवेहच्या ठायी आनंद करेन;","poem":1},{"text":"मला तारण देणार्‍या परमेश्वराच्या ठायी मी हर्ष करेन.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"सार्वभौम याहवेह माझे सामर्थ्य आहेत;","poem":1},{"text":"मला उंची गाठण्यास समर्थ करण्यास","poem":2},{"lineBreak":true},{"text":"ते माझी पावले हरणाच्या पावलांसारखी करतील.","poem":2},{"text":"गायकवर्गाच्या संचालकास सूचना: हे कवन गाताना तंतुवाद्यांची साथ असावी.","descriptive":true}]}],"footnotes":[{"noteId":5,"caller":"+","text":"सेला या इब्री शब्दाचा अर्थ कदाचित गीत गाताना मध्ये थोडे थांबणे असा आहे","reference":{"chapter":3,"verse":3}}]},"thisChapterLink":"/api/mar_cbi/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}