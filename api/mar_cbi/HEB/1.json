{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"HEB","translationId":"mar_cbi","name":"इब्री","commonName":"इब्री","title":"इब्री लोकांस पत्र","order":58,"numberOfChapters":13,"sha256":"04efe10096a25c86a7945ba824cb320c52ea9eaf221d6ea804e4bd6e03a79414","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/mar_cbi/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["परमेश्वराचे अंतिम शब्द: त्यांचा पुत्र"]},{"type":"verse","number":1,"content":["भूतकाळात परमेश्वर वेळोवेळी आणि निरनिराळ्या प्रकारे संदेष्ट्यांद्वारे आपल्या पूर्वजांशी बोलले."]},{"type":"verse","number":2,"content":["पण आता या शेवटच्या दिवसांमध्ये, ते त्यांच्या पुत्राद्वारे आपल्याशी बोलले आहेत व त्यांना सर्व गोष्टींचे वारस केले आहे आणि त्यांच्या द्वारेच जग निर्माण केले आहे."]},{"type":"verse","number":3,"content":["पुत्र परमेश्वराच्या गौरवाचे प्रतिबिंब आणि त्याच्या व्यक्तिमत्वाचे हुबेहूब प्रतिरूप आहेत. ते आपल्या वचनाच्या महान शक्तीने सर्व गोष्टींना सुस्थिर ठेवतात. पापांची शुद्धी केल्यानंतर, ते स्वर्गामध्ये वैभवाच्या उजवीकडे बसले आहेत."]},{"type":"verse","number":4,"content":["अशा रीतीने ते देवदूतांपेक्षा अतिश्रेष्ठ झाले आणि जे नाव त्यांना बहाल केले ते देवदूतांच्या नावांहून अतिश्रेष्ठ आहे."]},{"type":"heading","content":["पुत्र दूतांपेक्षा सर्वश्रेष्ठ"]},{"type":"verse","number":5,"content":["कारण परमेश्वराने असे कोणत्या देवदूताला कधी म्हटले,",{"text":"“तू माझा पुत्र आहेस;","poem":1},{"text":"आज मी तुझा पिता झालो आहे”","poem":2},{"noteId":0},{"text":"?","poem":2},"आणि पुन्हा एकदा,",{"text":"“मी त्याचा पिता होईन,","poem":1},{"text":"आणि तो माझा पुत्र होणार”","poem":2},{"noteId":1},{"text":"?","poem":2}]},{"type":"verse","number":6,"content":["आणि त्याच्या ज्येष्ठ पुत्राला पृथ्वीवर आणतो आणि म्हणतो,",{"text":"“परमेश्वराचे सर्व दूत त्याची उपासना करोत.”","poem":1},{"noteId":2}]},{"type":"verse","number":7,"content":["परमेश्वर ते आपल्या दूतांविषयी बोलताना म्हणतात,",{"text":"“तो वायूला आपले दूत,","poem":1},{"text":"व अग्निज्वालांना आपले सेवक करतात.”","poem":2},{"noteId":3}]},{"type":"verse","number":8,"content":["पण आपल्या पुत्राविषयी ते म्हणतात,",{"text":"“हे परमेश्वरा, तुमचे सिंहासन सदासर्वकाळ टिकेल;","poem":1},{"text":"न्याय्यतेचा राजदंड त्यांच्या राज्याचे राजदंड राहील.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"नीतिमत्व तुम्हाला प्रिय असून दुष्टाईचा तुम्ही द्वेष केला आहे.","poem":1},{"text":"म्हणूनच परमेश्वराने, तुझ्या परमेश्वराने, हर्षाच्या तेलाने तुझा अभिषेक करून","poem":2},{"lineBreak":true},{"text":"तुझ्या सोबत्यांपेक्षा तुला अधिक उंच ठिकाणी स्थिर केले आहे.”","poem":2},{"noteId":4}]},{"type":"verse","number":10,"content":["ते असेही म्हणाले,",{"text":"“हे प्रभू, प्रारंभी पृथ्वीचा पाया तुम्हीच घातला,","poem":1},{"text":"आणि आपल्या हातांनी तुम्ही गगनमंडळे निर्माण केलीत.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ती नष्ट होतील, परंतु तुम्ही निरंतर राहाल;","poem":1},{"text":"ती सर्व जुन्या वस्त्राप्रमाणे जीर्ण होतील.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"तुम्ही ती वस्त्राप्रमाणे गुंडाळणार;","poem":1},{"text":"आणि वस्त्राप्रमाणे ते बदलतील.","poem":2},{"text":"परंतु तुम्ही निरंतर समान राहणार,","poem":1},{"text":"आणि तुमची वर्षे कधीही संपुष्टात येणार नाहीत.”","poem":2},{"noteId":5}]},{"type":"verse","number":13,"content":["आणि परमेश्वराने आपल्या कोणत्या दूतांविषयी असे म्हटले,",{"text":"“मी तुझ्या शत्रूंना","poem":1},{"text":"तुझ्या पायाखाली ठेवीपर्यंत","poem":2},{"lineBreak":true},{"text":"तू माझ्या उजव्या हाताला बसून राहा”","poem":2},{"noteId":6},{"text":"?","poem":2}]},{"type":"verse","number":14,"content":["कारण ज्यांना तारण मिळणार आहे, त्यांची सेवा करण्यासाठी सर्व देवदूत म्हणजे सेवा करणारे म्हणून पाठविलेले आत्मे नाहीत काय?"]}],"footnotes":[{"noteId":0,"caller":"+","text":"स्तोत्र 2:7","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"+","text":"2 शमु 7:14; 1 इति 17:13","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"अनु 32:43","reference":{"chapter":1,"verse":6}},{"noteId":3,"caller":"+","text":"स्तोत्र 104:4","reference":{"chapter":1,"verse":7}},{"noteId":4,"caller":"+","text":"स्तोत्र 45:6,7","reference":{"chapter":1,"verse":9}},{"noteId":5,"caller":"+","text":"स्तोत्र 102:25‑27","reference":{"chapter":1,"verse":12}},{"noteId":6,"caller":"+","text":"स्तोत्र 110:1","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/mar_cbi/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}