{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"HOS","translationId":"mar_cbi","name":"होशेय","commonName":"होशेय","title":"होशेयाची भविष्यवाणी","order":28,"numberOfChapters":14,"sha256":"746ffbeaa198ce15cae693bd6ca2d014de2a50be9dfb69bfd09681e9a1dc7654","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mar_cbi/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"एफ्राईम वाऱ्यावर चरतो;","poem":1},{"text":"तो दिवसभर पूर्वेकडील वाऱ्याचा पाठलाग करतो","poem":2},{"lineBreak":true},{"text":"आणि खोटेपणा व हिंसाचार वाढवितो.","poem":2},{"text":"तो अश्शूरसोबत करार करतो","poem":1},{"text":"आणि इजिप्तला जैतून तेल पाठवितो.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"याहवेह यहूदीयाच्या विरुद्ध वाद आणत आहेत;","poem":1},{"text":"याकोबाला","poem":2},{"noteId":18},{"text":"त्याच्या मार्गाप्रमाणे ते शासन करतील","poem":2},{"lineBreak":true},{"text":"आणि त्याच्या कार्यानुसार त्याला प्रतिफळ देतील.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"त्याने गर्भात असता आपल्या भावाची टाच धरली;","poem":1},{"text":"एका मनुष्य असून त्याने परमेश्वराशी झुंज केली.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तो स्वर्गदूताशी झगडला आणि त्याच्यावर विजयी झाला;","poem":1},{"text":"तो रडला आणि त्याची मेहेरबानी व्हावी म्हणून त्याने भीक मागितली.","poem":2},{"text":"बेथेलला ते त्याला भेटले","poem":1},{"text":"आणि तिथे तो त्यांच्याशी बोलला—","poem":2}]},{"type":"verse","number":5,"content":[{"text":"याहवेह सर्वसमर्थ परमेश्वर,","poem":1},{"text":"याहवेह हे त्यांचे नाव!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"पण तू आपल्या परमेश्वराकडे परत आलेच पाहिजे;","poem":1},{"text":"प्रीती आणि न्यायाचे पालन कर","poem":2},{"lineBreak":true},{"text":"आणि सतत आपल्या परमेश्वराची प्रतीक्षा कर.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"व्यापारी चुकीचे माप वापरतो","poem":1},{"text":"आणि त्याला लबाडी करणे आवडते.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"एफ्राईम बढाई मारतो,","poem":1},{"text":"“मी फार धनवान आहे; मी श्रीमंत झालो आहे.","poem":2},{"text":"माझ्या सर्व संपत्तीसह त्यांना माझ्यामध्ये कोणताही","poem":1},{"text":"अपराध किंवा पाप आढळणार नाही.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“तू इजिप्तमधून बाहेर आल्यापासून","poem":1},{"text":"मी याहवेह तुमचा परमेश्वर आहे;","poem":2},{"text":"तुझ्या नेमलेल्या उत्सवाच्या दिवसात","poem":1},{"text":"मी तुला पुन्हा तंबूंमध्ये राहवयास लावेन.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"मी संदेष्ट्यांबरोबर बोललो,","poem":1},{"text":"त्यांना अनेक दृष्टान्त दिले","poem":2},{"lineBreak":true},{"text":"आणि त्यांच्याद्वारे दाखले सांगितले.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"गिलआद दुष्ट आहे काय?","poem":1},{"text":"त्याचे लोक निरुपयोगी आहेत!","poem":2},{"text":"ते गिलगालात बैलांचे अर्पण करतात का?","poem":1},{"text":"त्यांच्या वेद्या नांगरलेल्या शेतातील दगडांच्या","poem":2},{"lineBreak":true},{"text":"ढिगार्‍यासारख्या असतील.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"याकोब अराम देशात पळून गेला;","poem":1},{"text":"इस्राएलने पत्नी मिळविण्यासाठी चाकरी केली","poem":2},{"lineBreak":true},{"text":"आणि तिची किंमत चुकविण्यासाठी त्याने मेंढरे राखली.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"याहवेहने इजिप्तमधून इस्राएलला बाहेर काढण्यासाठी संदेष्ट्याच्या उपयोग केला,","poem":1},{"text":"एका संदेष्ट्याच्या मार्फत त्याची काळजी घेतली.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"पण एफ्राईमने त्यांचा कोप भयंकर चेतविला आहे;","poem":1},{"text":"त्याचे प्रभू त्याच्या रक्ताचा दोष त्याच्यावरच राहू देतील","poem":2},{"lineBreak":true},{"text":"आणि त्याला त्याच्या अपमानाची भरपाई देतील.","poem":2}]}],"footnotes":[{"noteId":18,"caller":"+","text":"याकोब म्हणजे टाच धरणारा किंवा फसविणारा","reference":{"chapter":12,"verse":2}}]},"thisChapterLink":"/api/mar_cbi/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}