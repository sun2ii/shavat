{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"HOS","translationId":"mar_cbi","name":"होशेय","commonName":"होशेय","title":"होशेयाची भविष्यवाणी","order":28,"numberOfChapters":14,"sha256":"746ffbeaa198ce15cae693bd6ca2d014de2a50be9dfb69bfd09681e9a1dc7654","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mar_cbi/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"heading","content":["इस्राएलविरुद्ध याहवेहचा संताप"]},{"type":"verse","number":1,"content":[{"text":"जेव्हा एफ्राईम बोलत असे, तेव्हा लोक थरथर कापत असत;","poem":1},{"text":"कारण तो इस्राएलाचा अधिपती होता.","poem":2},{"lineBreak":true},{"text":"पण तो बआल मूर्तीच्या उपासनेचा दोषी झाला आणि मरण पावला.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"आता ते अधिकाधिक पाप करीत आहेत;","poem":1},{"text":"ते आपल्या चांदीपासून स्वतःसाठी मूर्ती बनवतात,","poem":2},{"text":"हुशारीने तयार केलेल्या प्रतिमा,","poem":1},{"text":"त्या सर्व कारागिरांची हस्तकृती आहेत.","poem":2},{"text":"या लोकांबद्दल असे म्हटले जाते,","poem":1},{"text":"“हे नरबली देतात!","poem":2},{"lineBreak":true},{"text":"ते वासराच्या मूर्तीचे चुंबन","poem":2},{"noteId":19},{"text":"घेतात!”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"म्हणून ते सकाळच्या धुक्यासारखे,","poem":1},{"text":"पहाटेच्या लवकर उडून जाणार्‍या दहिवरासारखे,","poem":2},{"lineBreak":true},{"text":"खळ्यातून उडून जाणार्‍या भुशासारखे,","poem":2},{"lineBreak":true},{"text":"धुराड्यातून निघणार्‍या धुराप्रमाणे होतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“तू इजिप्तमधून बाहेर आल्यापासून","poem":1},{"text":"मी याहवेह तुमचा परमेश्वर आहे;","poem":2},{"text":"माझ्याशिवाय इतर कोणत्याही परमेश्वराला तू स्वीकारणार नाहीस,","poem":1},{"text":"माझ्याशिवाय इतर कोणीही तारणारा नाही.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"मी रानात, त्या तप्त उष्णतेच्या प्रदेशात,","poem":1},{"text":"तुझी काळजी वाहिली.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"जेव्हा मी त्यांना भोजन दिले ते तृप्त झाले;","poem":1},{"text":"जेव्हा ते तृप्त झाले तेव्हा ते गर्विष्ठ झाले;","poem":2},{"lineBreak":true},{"text":"नंतर ते मला विसरले.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"म्हणून मी त्यांच्यासाठी सिंहासारखा होईन,","poem":1},{"text":"चित्त्यासारखा त्यांच्या वाटेवर दबा धरून बसेन.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"जिची पिल्ले हरण केली आहेत, अशा अस्वलीप्रमाणे","poem":1},{"text":"मी त्यांच्यावर हल्ला करेन आणि त्यांचे तुकडे तुकडे करेन;","poem":2},{"text":"मी त्यांना सिंहाप्रमाणे फाडून टाकेन—","poem":1},{"text":"वनपशू त्यांना फाडून टाकतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“हे इस्राएला, तुझा नाश झाला आहे,","poem":1},{"text":"कारण तू माझ्याविरुद्ध, तुझ्या साहाय्यकर्त्यांच्या विरुद्ध आहेस.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तुला वाचविणारा तुझा राजा कुठे आहे?","poem":1},{"text":"‘मला राजा व राजपुत्र द्या’","poem":2},{"text":"ज्यांच्याबद्दल तू असे म्हटले होते,","poem":1},{"text":"ते तुझे सर्व नगरांचे अधिकारी कुठे आहेत?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"म्हणून माझ्या रागात मी तुला राजा दिला","poem":1},{"text":"आणि माझ्या क्रोधात त्याला मी काढून टाकले आहे.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"एफ्राईमची पातके जमा केली आहेत,","poem":1},{"text":"त्याची पापे साठवून ठेवली आहेत.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"बाळंतपणात स्त्रीला होणारा त्रास त्याला होईल,","poem":1},{"text":"पण तो बुद्धी नसलेला एक बालक आहे;","poem":2},{"text":"जेव्हा प्रसूतीची वेळ येते तेव्हा","poem":1},{"text":"त्याला गर्भातून बाहेर येण्याचे ज्ञान नसते.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“मी या लोकांना कबरेच्या सामर्थ्यापासून सुटका देईन;","poem":1},{"text":"मी त्यांना मृत्यूपासून वाचवेन.","poem":2},{"text":"अरे मरणा, तुझ्या पीडा कुठे आहे?","poem":1},{"text":"हे कबरे, तुझा नाश कुठे आहे?","poem":2},{"lineBreak":true},{"text":"“मला काहीही कळवळा येणार नाही,","poem":1}]},{"type":"verse","number":15,"content":[{"text":"जरी तो त्याच्या भावांमध्ये अत्यंत फलद्रूप होता,","poem":2},{"text":"परंतु याहवेहकडून पूर्वेकडील वारा येईल,","poem":1},{"text":"तो वाळवंटातून येईल;","poem":2},{"text":"त्याचे झरे सुकून जातील","poem":1},{"text":"आणि त्याची विहीर कोरडी पडेल.","poem":2},{"text":"त्याच्या भांडारातील","poem":1},{"text":"सर्व खजिना लुटला जाईल.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"शोमरोनच्या लोकांनी त्यांचा दोष वाहिलाच पाहिजे,","poem":1},{"text":"कारण त्यांनी त्यांच्या परमेश्वराविरुद्ध बंड केले.","poem":2},{"text":"ते तलवारीने पडतील;","poem":1},{"text":"त्यांची बालके जमिनीवर आपटली जातील,","poem":2},{"lineBreak":true},{"text":"आणि त्यांच्या गर्भवती स्त्रियांना चिरून टाकण्यात येईल.”","poem":2}]}],"footnotes":[{"noteId":19,"caller":"+","text":"किंवा यज्ञ करणारे पुरुष","reference":{"chapter":13,"verse":2}}]},"thisChapterLink":"/api/mar_cbi/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":16}