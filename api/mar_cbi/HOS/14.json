{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"HOS","translationId":"mar_cbi","name":"होशेय","commonName":"होशेय","title":"होशेयाची भविष्यवाणी","order":28,"numberOfChapters":14,"sha256":"746ffbeaa198ce15cae693bd6ca2d014de2a50be9dfb69bfd09681e9a1dc7654","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mar_cbi/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"heading","content":["आशीर्वाद प्राप्तीसाठी पश्चात्ताप"]},{"type":"verse","number":1,"content":[{"text":"हे इस्राएला, याहवेह तुमच्या परमेश्वराकडे परत ये.","poem":1},{"text":"कारण तुझे पापच तुझ्या पतनाचे कारण झाले आहे!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"परमेश्वराच्या वचनांचे पालन कर","poem":1},{"text":"आणि याहवेहकडे परत ये.","poem":2},{"text":"त्यांना सांगा:","poem":1},{"text":"“आमच्या सर्व पापांची क्षमा करा,","poem":2},{"text":"आणि कृपापूर्वक आमचा स्वीकार करा,","poem":1},{"text":"म्हणजे आम्ही आमच्या ओठांची फळे वासराच्या अर्पणाप्रमाणे अर्पण करू.","poem":2},{"noteId":20}]},{"type":"verse","number":3,"content":[{"text":"अश्शूर आमचे तारण करू शकणार नाही;","poem":1},{"text":"आम्ही युद्धाच्या घोड्यावर स्वार होणार नाही.","poem":2},{"text":"हातांनी बनविलेल्या मूर्तीना आम्ही","poem":1},{"text":"‘आमची दैवते’ असे इतःपर म्हणणार नाही.","poem":2},{"lineBreak":true},{"text":"कारण अनाथांना तुमच्याठायीच दया मिळते.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“मी त्यांचा स्वच्छंदीपणा दूर करेन","poem":1},{"text":"आणि त्यांच्यावर मुक्तपणे प्रीती करेन,","poem":2},{"lineBreak":true},{"text":"कारण माझा राग त्यांच्यापासून दूर झाला आहे.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"मी इस्राएलला दहिवराप्रमाणे होईन.","poem":1},{"text":"तो कुमुदिनीप्रमाणे फुलेल","poem":2},{"text":"आणि त्याची मुळे लबानोनातील","poem":1},{"text":"गंधसरूंच्या मुळांप्रमाणे जातील;","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"त्याच्या फांद्या पसरतील.","poem":2},{"text":"त्याचे वैभव एका जैतून वृक्षासारखे होईल.","poem":1},{"text":"त्याचा सुगंध लबानोनातील गंधसरू सारखा होईल.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"लोक परत त्यांच्या छायेत विश्रांती घेतील;","poem":1},{"text":"ते धान्यासारखे पुनरुज्जीवित होतील,","poem":2},{"text":"द्राक्षवेलीप्रमाणे ते फळे देतील—","poem":1},{"text":"इस्राएलची प्रसिद्धी लबानोनच्या द्राक्षारसाप्रमाणे होईल.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"हे एफ्राईमा, आता माझा या मूर्तीशी काय संबंध आहे?","poem":1},{"text":"मी त्याला उत्तर देईन आणि त्याची काळजी घेईन.","poem":2},{"text":"मी सदाहरित गंधसरू वृक्षासारखा आहे;","poem":1},{"text":"तुमचे फलवंत होणे माझ्यामुळे येते.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"कोण शहाणा आहे? त्यांना या गोष्टींची जाणीव होऊ द्या.","poem":1},{"text":"कोण समंजस आहे? त्यांना समजू द्या.","poem":2},{"text":"कारण याहवेहचे मार्ग योग्य आहेत;","poem":1},{"text":"नीतिमान त्यावरून चालतील,","poem":2},{"lineBreak":true},{"text":"पण पातकी त्यावर अडखळून पडतील.","poem":2}]}],"footnotes":[{"noteId":20,"caller":"+","text":"किंवा आमचे ओठ अर्पण करू","reference":{"chapter":14,"verse":2}}]},"thisChapterLink":"/api/mar_cbi/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}