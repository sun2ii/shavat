{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"HOS","translationId":"mar_cbi","name":"होशेय","commonName":"होशेय","title":"होशेयाची भविष्यवाणी","order":28,"numberOfChapters":14,"sha256":"746ffbeaa198ce15cae693bd6ca2d014de2a50be9dfb69bfd09681e9a1dc7654","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mar_cbi/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":3,"content":[{"type":"heading","content":["होशेयचा आपल्या पत्नीशी समेट"]},{"type":"verse","number":1,"content":["मग याहवेह मला म्हणाले, “जा आणि आपल्या पत्नीस आपली प्रीती पुनः प्रकट कर, जरी तिला दुसरा कोणता पुरुष प्रीती करतो आणि ती एक व्यभिचारिणी आहे. जरी ते इतर दैवतांकडे वळले असून पवित्र मनुकांच्या ढेपांची आवड धरतात, तरी याहवेह इस्राएली लोकांवर प्रीती करतात.”"]},{"type":"verse","number":2,"content":["तेव्हा मी तिच्या सुटकेसाठी चांदीची पंधरा शेकेल",{"noteId":11},"व एक होमेर व एक लेथेक",{"noteId":12},"जव देऊन तिला विकत घेतले."]},{"type":"verse","number":3,"content":["मग मी तिला म्हणालो, “तुला अनेक दिवस माझ्याबरोबर राहवयाचे आहे; जारकर्म करू नकोस अथवा इतर पुरुषांकडे जाऊ नकोस, आणि मीही तुझ्यासोबत तसाच वागेन.”"]},{"type":"verse","number":4,"content":["कारण दीर्घकाळापर्यंत इस्राएली लोक राजा अथवा राजपुत्र, यज्ञ अथवा पवित्र दगड, एफोद अथवा कुलदैवतांशिवाय राहतील."]},{"type":"verse","number":5,"content":["त्यानंतर इस्राएली लोक परत येतील आणि याहवेह त्यांच्या परमेश्वराला आणि त्यांचा राजा दावीदाचा शोध घेतील. अखेरच्या काळात याहवेहकडे ते थरथर कापत आणि त्यांच्या आशीर्वादासाठी येतील."]}],"footnotes":[{"noteId":11,"caller":"+","text":"अंदाजे 170 ग्रॅ.","reference":{"chapter":3,"verse":2}},{"noteId":12,"caller":"+","text":"अंदाजे 195 कि.ग्रॅ.","reference":{"chapter":3,"verse":2}}]},"thisChapterLink":"/api/mar_cbi/HOS/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/HOS/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/HOS/2.json","previousChapterAudioLinks":{},"numberOfVerses":5}