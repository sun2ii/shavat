{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"HOS","translationId":"mar_cbi","name":"होशेय","commonName":"होशेय","title":"होशेयाची भविष्यवाणी","order":28,"numberOfChapters":14,"sha256":"746ffbeaa198ce15cae693bd6ca2d014de2a50be9dfb69bfd09681e9a1dc7654","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mar_cbi/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["इस्राएलविरुद्ध केलेले आरोप"]},{"type":"verse","number":1,"content":[{"text":"इस्राएली लोकहो, याहवेहचे वचन ऐका.","poem":1},{"text":"या देशात राहणार्‍यांवर","poem":2},{"lineBreak":true},{"text":"याहवेहचा आरोप आहे:","poem":2},{"text":"या देशात विश्वासूपणा नाही,","poem":1},{"text":"प्रीती नाही, परमेश्वराप्रती ज्ञान नाही.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"या ठिकाणी फक्त शाप, खोटे बोलणे आणि खून,","poem":1},{"text":"चोरी आणि व्यभिचार आहे;","poem":2},{"text":"सर्व सीमाबंदी ते मोडून टाकतात,","poem":1},{"text":"आणि रक्तपातानंतर रक्तपात होतो.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"म्हणूनच तुमची भूमी कोरडी पडत आहे,","poem":1},{"text":"येथे राहणारे सर्व नाश पावत आहे;","poem":2},{"text":"रान पशू, आकाशातील पक्षी","poem":1},{"text":"आणि समुद्रातील मासे नाहीसे होत आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"परंतु कोणीही आरोप करू नका,","poem":1},{"text":"तुम्ही इतरांवर आळ घेऊ नका,","poem":2},{"text":"कारण तुमचे लोक असे आहेत","poem":1},{"text":"जे याजकांवर दोष लावतात.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तुम्ही दिवस व रात्र अडखळता,","poem":1},{"text":"आणि संदेष्टेही तुमच्याबरोबर अडखळतात.","poem":2},{"text":"म्हणून मी तुमच्या आईचा नाश करेन—","poem":1}]},{"type":"verse","number":6,"content":[{"text":"ज्ञान नसल्यामुळे माझ्या लोकांचा नाश होत आहे,","poem":2},{"lineBreak":true},{"text":"“कारण, तुम्ही ज्ञानाला नाकारले आहे,","poem":1},{"text":"म्हणून मी तुम्हाला माझे याजक म्हणून नाकारत आहे;","poem":2},{"text":"कारण तुम्ही तुमच्या परमेश्वराच्या नियमांकडे दुर्लक्ष केले आहे,","poem":1},{"text":"म्हणून मी सुद्धा तुमच्या मुलांकडे दुर्लक्ष करेन.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"जितकी याजकांची संख्या वाढत गेली,","poem":1},{"text":"तितकी अधिक पापे त्यांनी माझ्याविरुद्ध केली;","poem":2},{"lineBreak":true},{"text":"त्यांच्या वैभवशाली परमेश्वराच्या बदल्यात","poem":2},{"noteId":13},{"text":"त्यांनी लाजिरवाणी गोष्ट स्वीकारली.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"माझ्या लोकांच्या पापांवर ते पोषण करतात","poem":1},{"text":"आणि त्यांच्या दुष्टतेचा आनंद घेतात.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"आणि असे होईल की: जसे लोक तसे याजक होतील.","poem":1},{"text":"मी दोघांनाही त्यांच्या आचरणामुळे शासन करेन","poem":2},{"lineBreak":true},{"text":"आणि त्यांच्या कृत्यांसाठी त्यांना परतफेड करेन.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ते खातील परंतु ते तृप्त होणार नाहीत;","poem":1},{"text":"ते व्यभिचार करतील परंतु त्यांची भरभराट होणार नाही,","poem":2},{"text":"कारण त्यांनी याहवेहचा त्याग केला आहे","poem":1},{"text":"आणि स्वतःस वेश्या व्यवसायास सोपविले आहे.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"जुना द्राक्षारस","poem":2},{"text":"आणि नवीन द्राक्षारस","poem":1},{"text":"त्यांचा समंजसपणा दूर करतात.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"माझे लोक लाकडी मूर्तींचा सल्ला घेतात","poem":1},{"text":"आणि दैवप्रश्न करणाऱ्यांची काठी त्यांचे भविष्य सांगते.","poem":2},{"text":"व्यभिचाराचा आत्मा त्यांना भरकटवितो;","poem":1},{"text":"ते त्यांच्या परमेश्वराला विश्वासू राहिले नाहीत.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"एला वृक्ष, हिवर आणि एला या झाडांखाली,","poem":1},{"text":"जिथे सुखदायक सावली असते","poem":2},{"text":"तिथे पर्वतांच्या शिखरांवर यज्ञ करतात","poem":1},{"text":"आणि टेकड्यांवर ते होमार्पण करतात.","poem":2},{"text":"म्हणून तुमच्या कन्या वेश्याव्यवसायाकडे वळतात","poem":1},{"text":"आणि तुमच्या सुना व्यभिचार करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“जेव्हा त्या वेश्याव्यवसायाकडे वळतात,","poem":1},{"text":"अथवा तुमच्या सुना","poem":2},{"text":"त्या व्यभिचार करतात,","poem":1},{"text":"मी तुमच्या कन्यांना शासन करणार नाही,","poem":2},{"text":"कारण पुरुष स्वतः वेश्यांबरोबर सहवास करतात","poem":1},{"text":"आणि पवित्र स्थळी असलेल्या देवदासींबरोबर बलिदान करतात—","poem":2},{"lineBreak":true},{"text":"समंजसपणा नसलेल्या लोकांचा नाश होईल!","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“हे इस्राएला, जरी तू व्यभिचार केला आहेस,","poem":1},{"text":"तरी यहूदाहला दोषी होऊ देऊ नकोस.","poem":2},{"lineBreak":true},{"text":"“गिलगालकडे जाऊ नका;","poem":1},{"text":"वर बेथ-आवेन","poem":2},{"noteId":14},{"text":"येथे जाऊ नका.","poem":2},{"lineBreak":true},{"text":"आणि ‘याहवेहच्या जीविताची शपथ!’ अशी शपथ घेऊ नका.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"जशी कालवड हट्टी असते,","poem":1},{"text":"तसे इस्राएली लोक हट्टी आहेत.","poem":2},{"text":"मग जशी कोकरे कुरणात चरतात,","poem":1},{"text":"त्याप्रमाणे याहवेह त्यांना कुरणात कसे नेतील?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"एफ्राईम मूर्तीबरोबर जोडले गेले आहे,","poem":1},{"text":"त्याला एकटे सोडून द्या!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"जेव्हा त्यांचे मद्य संपते तेव्हा सुद्धा,","poem":1},{"text":"ते त्यांचा वेश्याव्यवसाय चालू ठेवतात;","poem":2},{"lineBreak":true},{"text":"त्यांचे शासक लज्जास्पद कृतिंवर अधिक प्रीती करतात.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"एक वावटळ त्यांना वाहून नेईल,","poem":1},{"text":"आणि त्यांच्या अर्पणांमुळे त्यांना लाज वाटेल.","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"किंवा मी त्यांचे वैभव बदलेन","reference":{"chapter":4,"verse":7}},{"noteId":14,"caller":"+","text":"बेथ-अव्हेन दुष्टतेचे घर बेथेल परमेश्वराचे घर याचे अपमानास्पद नाव","reference":{"chapter":4,"verse":15}}]},"thisChapterLink":"/api/mar_cbi/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}