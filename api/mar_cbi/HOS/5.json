{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"HOS","translationId":"mar_cbi","name":"होशेय","commonName":"होशेय","title":"होशेयाची भविष्यवाणी","order":28,"numberOfChapters":14,"sha256":"746ffbeaa198ce15cae693bd6ca2d014de2a50be9dfb69bfd09681e9a1dc7654","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mar_cbi/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["इस्राएलविरुद्ध न्याय"]},{"type":"verse","number":1,"content":[{"text":"“तुम्ही याजकांनो, हे ऐका!","poem":1},{"text":"अहो इस्राएलाच्या घराण्यांनो, लक्ष द्या!","poem":2},{"text":"राजघराणे, ऐका!","poem":1},{"text":"हा न्याय तुमच्याविरुद्ध आहे:","poem":2},{"text":"मिस्पाह येथे तुम्ही पाश झाला आहात,","poem":1},{"text":"ताबोरावर पसरलेले जाळे झाले आहात.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"बंडखोरांनी भयंकर कत्तल केली आहे,","poem":1},{"text":"मी त्या सर्वांना शिस्त लावेन.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"एफ्राईमाबद्दल मला सर्वकाही माहीत आहे;","poem":1},{"text":"इस्राएल माझ्यापासून लपलेले नाही.","poem":2},{"text":"हे एफ्राईमा, तू आता वेश्याव्यवसायाकडे वळला आहेस;","poem":1},{"text":"इस्राएल भ्रष्ट झालेला आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“त्यांची कर्मे त्यांना पुन्हा","poem":1},{"text":"त्यांच्या परमेश्वराकडे येऊ देत नाहीत.","poem":2},{"text":"वेश्यावृत्तीचा आत्मा त्यांच्या अंतःकरणात आहे;","poem":1},{"text":"ते याहवेहला ओळखत नाहीत.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"इस्राएलचा उन्मत्तपणाच त्यांच्याविरुद्ध साक्ष देतो;","poem":1},{"text":"इस्राएल आणि एफ्राईम सुद्धा आपल्या पापात अडखळतात;","poem":2},{"lineBreak":true},{"text":"यहूदीया देखील त्यांच्यासोबत अडखळतो.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"जेव्हा ते आपले मेंढरांचे व गुरांचे कळप घेऊन","poem":1},{"text":"याहवेहच्या शोधात फिरतील,","poem":2},{"text":"ते त्यांना सापडणार नाही;","poem":1},{"text":"कारण त्यांनी स्वतःला त्यांच्यापासून दूर केले आहेत.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ते याहवेहशी अविश्वासू राहिले;","poem":1},{"text":"ते अनौरस लेकरांना जन्म देतात.","poem":2},{"text":"जेव्हा ते अमावस्येचा उत्सव साजरा करतील,","poem":1},{"text":"तेव्हा ते त्यांच्या शेताला गिळून","poem":2},{"noteId":15},{"text":"टाकतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“तुम्ही गिबियाहात शिंग फुंका,","poem":1},{"text":"रामाह येथे कर्णा वाजवा.","poem":2},{"text":"बेथ-आवेन येथे उंच आवाजात युद्धाची घोषणा करा;","poem":1},{"text":"बिन्यामीन आमचे नेतृत्व करा.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"एफ्राईम शासनाच्या","poem":1},{"text":"दिवशी ओसाड पडेल.","poem":2},{"text":"इस्राएली गोत्रात जे निश्चितच होणार","poem":1},{"text":"त्याची घोषणा करणार.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"यहूदाहचे पुढारी","poem":1},{"text":"सीमारेषांचे दगड हालविणारे झाले आहेत.","poem":2},{"text":"एखाद्या जलप्रलयाप्रमाणे","poem":1},{"text":"मी माझा संताप त्यांच्यावर ओतेन.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"एफ्राईम चिरडला गेला आहे,","poem":1},{"text":"न्यायात चेंगरलेला आहे.","poem":2},{"lineBreak":true},{"text":"कारण मूर्तीच्या मागे जाण्याचा त्याचा निश्चय आहे.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"एफ्राईमाला मी कसर,","poem":1},{"text":"आणि यहूदाहसाठी सडीचा रोग आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ज्यावेळी एफ्राईमने त्याचा आजार पाहिला,","poem":1},{"text":"आणि यहूदाहने त्याची जखम पाहिली,","poem":2},{"text":"तेव्हा एफ्राईम अश्शूराकडे वळला,","poem":1},{"text":"आणि महान राजाकडे मदतीसाठी विनंती केली.","poem":2},{"text":"परंतु तो तुला बरे करू शकत नाही,","poem":1},{"text":"तुझ्या जखमाही बर्‍या करू शकत नाही.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"कारण मी एफ्राईमला एखाद्या सिंहासारखा,","poem":1},{"text":"व यहूदाहला मोठ्या सिंहासारखा होईन.","poem":2},{"text":"मी त्यांना फाडून टाकीन आणि दूर निघून जाईन;","poem":1},{"text":"मी त्यांना घेऊन जाईन आणि त्यांना सोडविणारा कोणीही नसेल.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ते आपला अपराध कबूल करेपर्यंत","poem":1},{"text":"व साहाय्यासाठी माझे मुख पुन्हा शोधेपर्यंत","poem":2},{"lineBreak":true},{"text":"मी आपल्या गुहेत परत जाईन—","poem":2},{"text":"कारण संकट आल्याबरोबर,","poem":1},{"text":"ते माझा शोध कळकळीने करतील.”","poem":2}]}],"footnotes":[{"noteId":15,"caller":"+","text":"किंवा नाश करतील","reference":{"chapter":5,"verse":7}}]},"thisChapterLink":"/api/mar_cbi/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}