{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"HOS","translationId":"mar_cbi","name":"होशेय","commonName":"होशेय","title":"होशेयाची भविष्यवाणी","order":28,"numberOfChapters":14,"sha256":"746ffbeaa198ce15cae693bd6ca2d014de2a50be9dfb69bfd09681e9a1dc7654","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mar_cbi/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"जेव्हा मी इस्राएलला आरोग्य देतो,","poem":2},{"text":"तेव्हा एफ्राईमचे पाप","poem":1},{"text":"आणि शोमरोनचे अपराध प्रकट होतात.","poem":2},{"text":"ते लबाडी करतात,","poem":1},{"text":"चोर घरात चोरी करतात,","poem":2},{"lineBreak":true},{"text":"लुटारू रस्त्यावर लूटमार करतात;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"परंतु त्यांना हे कळत नाही","poem":1},{"text":"की त्यांची सर्व वाईट कृत्ये मला स्मरण आहेत.","poem":2},{"text":"त्यांच्या पापकर्मांनी त्यांना घेरले आहे;","poem":1},{"text":"ते नेहमी माझ्यासमोर असतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“ते राजाला आपल्या दुष्टाईने,","poem":1},{"text":"अधिपतीला आपल्या लबाड्यांनी हर्षित करतात.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ते सर्वच व्यभिचारी आहेत;","poem":1},{"text":"रोटी भाजणार्‍याच्या सतत","poem":2},{"text":"पेटलेल्या भट्टीप्रमाणे ते आहेत.","poem":1},{"text":"पीठ मळून ते फुगेपर्यंत तो विस्तव चाळविण्याचे थांबवितो.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"आमच्या राजाच्या उत्सवाच्या दिवशी","poem":1},{"text":"अधिपती द्राक्षारसाने धुंद होतात,","poem":2},{"lineBreak":true},{"text":"आणि त्याने आपला हात कुचेष्टा करणार्‍यांबरोबर मिळविला आहे.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"कारस्थाने करताना त्यांची हृदये","poem":1},{"text":"तापलेल्या भट्टीसारखी होतात.","poem":2},{"text":"त्यांची उत्कटता रात्रभर धुमसत असते;","poem":1},{"text":"सकाळी तो प्रज्वलित अग्नीसारखा पेट घेतो.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ते सर्व भट्टीसारखे तप्त आहेत;","poem":1},{"text":"ते त्यांच्या अधिपतींना गिळून टाकतात.","poem":2},{"text":"त्यांचे सर्व राजे पतन पावले आहेत,","poem":1},{"text":"त्यातील कोणी मला हाक मारीत नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“एफ्राईम गैर यहूदीयांसोबत मिसळतो;","poem":1},{"text":"एफ्राईम न पलटलेल्या भाकरीसारखा झाला आहे.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"परकीय लोक त्याच्या शक्तीचे शोषण करतात,","poem":1},{"text":"पण त्याला हे कळत नाही","poem":2},{"text":"त्याचे केस पांढरे होत चालले आहेत,","poem":1},{"text":"पण तो त्याची नोंद घेत नाही.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"इस्राएलचा उन्मत्तपणाच त्याच्याविरुद्ध साक्ष देतात,","poem":1},{"text":"हे सर्व असूनही","poem":2},{"text":"तो याहवेह त्याच्या परमेश्वराकडे वळत नाही,","poem":1},{"text":"किंवा त्यांचा शोध घेत नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“एफ्राईम एखाद्या खुळ्या पारव्यासारखा","poem":1},{"text":"बुद्धिहीन आणि सहज फसणारा आहे—","poem":2},{"text":"तो आता इजिप्तला हाक मारतो;","poem":1},{"text":"आता तो अश्शूराकडे धाव घेतो.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"जेव्हा ते जातील तेव्हा मी माझे जाळे त्याच्यावर फेकेन;","poem":1},{"text":"मी त्यांना आकाशातील पक्ष्याप्रमाणे खाली आणेन.","poem":2},{"text":"जेव्हा मी ऐकेन की ते एकत्र होत आहेत,","poem":1},{"text":"तेव्हा मी त्यांना पकडेन.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ते माझ्यापासून बहकले आहेत","poem":1},{"text":"म्हणून त्यांचा धिक्कार असो!","poem":2},{"text":"त्यांचा नाश होवो,","poem":1},{"text":"कारण त्यांनी माझ्याविरुद्ध विद्रोह केला आहे.","poem":2},{"text":"मला त्यांचा उद्धार करावयाची इच्छा होती,","poem":1},{"text":"पण ते माझ्याबद्दल खोटे बोलतात.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ते मला त्यांच्या हृदयापासून हाक मारत नाहीत,","poem":1},{"text":"परंतु त्यांच्या बिछान्यांवर विलाप करतात.","poem":2},{"text":"ते धान्य आणि नवीन द्राक्षारसासाठी","poem":1},{"text":"त्यांच्या दैवतांकडे भीक मागून स्वतःला जखमा करतात,","poem":2},{"noteId":16},{"lineBreak":true},{"text":"पण ते माझ्यापासून दूर राहतात.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"मी त्यांना शिक्षण दिले आहे आणि त्यांचे बाहू बळकट केले आहे,","poem":1},{"text":"परंतु ते माझ्याविरुद्ध वाईट कल्पना मनात आणतात.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ते परमोच्च परमेश्वराकडे फिरत नाहीत;","poem":1},{"text":"तर ते सदोष धनुष्यांसारखे आहेत.","poem":2},{"text":"उर्मट शब्दांमुळे त्यांचे पुढारी","poem":1},{"text":"तलवारीला बळी पडतील.","poem":2},{"text":"यामुळे इजिप्त देशात","poem":1},{"text":"त्यांची थट्टा करण्यात येईल.","poem":2}]}],"footnotes":[{"noteId":16,"caller":"+","text":"काही मूळ प्रतींनुसार भीक मागत एकत्र येतात","reference":{"chapter":7,"verse":14}}]},"thisChapterLink":"/api/mar_cbi/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}