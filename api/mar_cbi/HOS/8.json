{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"HOS","translationId":"mar_cbi","name":"होशेय","commonName":"होशेय","title":"होशेयाची भविष्यवाणी","order":28,"numberOfChapters":14,"sha256":"746ffbeaa198ce15cae693bd6ca2d014de2a50be9dfb69bfd09681e9a1dc7654","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mar_cbi/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["इस्राएल वावटळीची कापणी करतात"]},{"type":"verse","number":1,"content":[{"text":"“तू कर्णे आपल्या मुखाला लाव!","poem":1},{"text":"याहवेहच्या भवनावर एक गरुड आहे,","poem":2},{"text":"कारण लोकांनी माझा करार मोडला आहे","poem":1},{"text":"आणि माझ्या नियमशास्त्राविरुद्ध बंड केले आहे.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"इस्राएल माझा धावा करून आता म्हणतो,","poem":1},{"text":"‘आमच्या परमेश्वरा, आम्ही तुमचा स्वीकार करतो!’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"इस्राएलने जे उत्तम ते नाकारले आहे;","poem":1},{"text":"शत्रू त्याचा पाठलाग करतील.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"त्यांनी माझ्या संमतीशिवाय राजे नेमले आहेत;","poem":1},{"text":"ते माझ्या मान्येतेशिवाय अधिपतींना निवडतात.","poem":2},{"text":"त्यांनी आपले चांदी आणि सोने घेऊन","poem":1},{"text":"स्वतःच्या नाशाकरिता","poem":2},{"lineBreak":true},{"text":"मूर्ती बनविल्या आहेत.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"हे शोमरोना, तुझी वासराची मूर्ती फेकून दे!","poem":1},{"text":"त्यांच्याविरुद्ध माझा राग पेटला आहे.","poem":2},{"text":"ते अजून किती काळ शुद्ध होण्यास असमर्थ राहतील?","poem":1}]},{"type":"verse","number":6,"content":[{"text":"ते इस्राएलाकडून आहे!","poem":2},{"text":"हे वासरू—एका कारागिराने बनविले आहे;","poem":1},{"text":"तो परमेश्वर नाही.","poem":2},{"text":"शोमरोनाच्या या वासराचे","poem":1},{"text":"तुकडे तुकडे करण्यात येतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ते वारा पेरतात","poem":1},{"text":"आणि ते वावटळीची कापणी करतात.","poem":2},{"text":"त्यांच्या पिकांना कणसे येत नाहीत;","poem":1},{"text":"त्यातून पीठ तयार होत नाही.","poem":2},{"text":"जर त्यातून अन्न तयार झाले","poem":1},{"text":"तर परकीय ते गिळून टाकतील.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"इस्राएलास गिळून टाकण्यात आले आहे;","poem":1},{"text":"राष्ट्रांमध्ये ती कोणासही","poem":2},{"lineBreak":true},{"text":"आवडत नाही.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"एकाकी भटकणार्‍या रानगाढवासारखे ते वर","poem":1},{"text":"अश्शूराकडे गेले आहे.","poem":2},{"lineBreak":true},{"text":"एफ्राईमने स्वतःस तिच्या प्रियकरांना विकले आहे.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"जरी त्यांना स्वतःला राष्ट्रांमध्ये विकले असेल,","poem":1},{"text":"तरीही आता मी त्यांना एकत्र करेन.","poem":2},{"text":"बलाढ्य राजाच्या अत्याचाराने","poem":1},{"text":"ते नष्ट होऊ लागतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“एफ्राईमने पापार्पण करण्यास पुष्कळ वेद्या बांधल्या आहेत,","poem":1},{"text":"पण ते पाप करण्याच्या वेद्या झाल्या आहेत.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"मी त्यांच्यासाठी माझ्या नियमशास्त्राच्या पुष्कळ गोष्टी लिहिल्या,","poem":1},{"text":"पण त्यांनी ते परकीय मानले.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"जरी ते त्यांचे यज्ञार्पण मला भेटस्वरूप अर्पितात,","poem":1},{"text":"आणि तरीही ते मांस खातात,","poem":2},{"lineBreak":true},{"text":"याहवेह त्यांच्याशी प्रसन्न नाही.","poem":2},{"text":"आता ते त्यांचा दुष्टपणा स्मरणार","poem":1},{"text":"आणि त्यांच्या पापांची शिक्षा देणार:","poem":2},{"lineBreak":true},{"text":"ते इजिप्तला परततील.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"कारण इस्राएल आपल्या निर्माणकर्त्याला विसरला आहे","poem":1},{"text":"आणि राजवाडे बांधले;","poem":2},{"lineBreak":true},{"text":"यहूदाहने अनेक तटबंदीची नगरे बांधली आहेत.","poem":2},{"text":"पण मी त्यांच्या नगरांवर अग्नी पाठवून","poem":1},{"text":"त्यांचे किल्ले भस्म करेन.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}