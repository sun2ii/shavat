{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"HOS","translationId":"mar_cbi","name":"होशेय","commonName":"होशेय","title":"होशेयाची भविष्यवाणी","order":28,"numberOfChapters":14,"sha256":"746ffbeaa198ce15cae693bd6ca2d014de2a50be9dfb69bfd09681e9a1dc7654","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mar_cbi/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["इस्राएलास शासन"]},{"type":"verse","number":1,"content":[{"text":"हे इस्राएला, आनंद करू नकोस;","poem":1},{"text":"इतर राष्ट्रांसारखे उल्लासू नकोस,","poem":2},{"text":"कारण तू तुझ्या परमेश्वराशी अविश्वासू झाला आहेस;","poem":1},{"text":"धान्याच्या प्रत्येक खळ्यावर","poem":2},{"lineBreak":true},{"text":"वेश्याव्यवसाय करून मिळणारी कमाई तुला आवडते.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"खळे आणि द्राक्षकुंड लोकांना खाऊ घालणार नाही;","poem":1},{"text":"नवा द्राक्षारस त्यांना दगा देईल.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"याहवेहच्या देशात ते राहणार नाहीत;","poem":1},{"text":"एफ्राईम इजिप्त देशात परत जाईल","poem":2},{"lineBreak":true},{"text":"आणि अश्शूर येथे अशुद्ध भोजन खाईल.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ते याहवेहला द्राक्षारसाची पेयार्पणे करू शकणार नाही,","poem":1},{"text":"किंवा त्यांच्या यज्ञार्पणाने याहवेहला संतोष होणार नाही.","poem":2},{"text":"कारण असे यज्ञ त्यांच्यासाठी शोक करणाऱ्यांच्या अन्नासारखे होईल;","poem":1},{"text":"त्यास खाणारे सर्वजण अमंगळ होतील.","poem":2},{"text":"ते भोजन त्यांच्यासाठीच असेल;","poem":1},{"text":"ते याहवेहच्या मंदिरात आणता येणार नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"मग तू ठरविलेल्या उत्सवाच्या दिवशी,","poem":1},{"text":"याहवेहच्या सणाच्या दिवशी काय करशील?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"जरी ते नाशापासून सुटले तरी","poem":1},{"text":"इजिप्त त्यांना गोळा करेल,","poem":2},{"lineBreak":true},{"text":"आणि मेम्फीस त्यांना मूठमाती देतील.","poem":2},{"text":"काटेकुसळे त्यांच्या चांदीच्या वस्तू नेतील,","poem":1},{"text":"आणि त्यांच्या तंबूत काटेरी झाडे उगवतील.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"शासन करण्याची वेळ जवळ आली आहे;","poem":1},{"text":"प्रतिफळ घेण्याचे दिवस जवळ आले आहेत.","poem":2},{"lineBreak":true},{"text":"इस्राएलला हे समजून यावे.","poem":2},{"text":"कारण तुमची पापे अधिक आहेत","poem":1},{"text":"आणि तुमचे शत्रुत्व जास्त आहे,","poem":2},{"text":"संदेष्टा मूर्ख ठरत आहे,","poem":1},{"text":"प्रेरित वेडा समजला जातो.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"संदेष्टा माझ्या परमेश्वरासोबत,","poem":1},{"text":"एफ्राईमचा पहारेकरी आहे,","poem":2},{"text":"तरीही त्याच्या सर्व मार्गात सापळा त्याची वाट पाहत आहे,","poem":1},{"text":"आणि परमेश्वराच्या भवनात शत्रुत्व आहे.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"जसे गिबियाहमधील दिवसात केले","poem":1},{"text":"तसे त्यांनी स्वतःला अधिक भ्रष्ट केले आहे.","poem":2},{"text":"परमेश्वर त्यांचे दुष्कर्म स्मरणात ठेवतील","poem":1},{"text":"आणि त्यांना त्यांच्या पापांबद्दल शिक्षा करतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“जेव्हा मला इस्राएल आढळला,","poem":1},{"text":"तेव्हा ते रानात द्राक्षे आढळल्यासारखे होते;","poem":2},{"text":"जेव्हा मी तुमच्या पूर्वजांना पाहिले,","poem":1},{"text":"ते अंजिराच्या झाडावर प्रथमफळ पाहण्यासारखे होते.","poem":2},{"text":"पण जेव्हा ते बआल-पौराला आले","poem":1},{"text":"तेव्हा त्यांनी त्या घृणास्पद मूर्तींपुढे स्वतःला समर्पित केले","poem":2},{"lineBreak":true},{"text":"आणि त्यांच्या आवडत्या वस्तूप्रमाणे अमंगळ झाले.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"एफ्राईमचे वैभव पक्ष्याप्रमाणे उडून जाईल—","poem":1},{"text":"जन्म नाही, गर्भधारणा नाही, गर्भसंभव नाही.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"जरी त्यांनी मुलांचे संगोपन केले,","poem":1},{"text":"तरी मी त्यांना सर्वांपासून दूर करेन.","poem":2},{"text":"मी त्या लोकांपासून निघून जाईन,","poem":1},{"text":"तेव्हा त्यांचा धिक्कार असो.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"सोर जसा सुखदायी ठिकाणी लावलेला मी पाहिला,","poem":1},{"text":"तसाच एफ्राईम आहे,","poem":2},{"text":"परंतु एफ्राईम आपल्या मुलांना","poem":1},{"text":"वध करणार्‍याकडे घेऊन येईल.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"हे याहवेह, त्यांना द्या—","poem":1},{"text":"तुम्ही त्यांना काय द्याल?","poem":2},{"text":"त्यांना वांझ गर्भाशये","poem":1},{"text":"आणि शुष्क स्तने द्या.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“गिलगालात त्यांची सर्व दुष्कृत्ये आहेत,","poem":1},{"text":"मी त्यांचा तिथेच द्वेष केला.","poem":2},{"text":"त्यांच्या पापी कृत्यांमुळे,","poem":1},{"text":"मी त्यांना माझ्या घरातून हाकलून देईन.","poem":2},{"text":"मी यापुढे त्यांच्यावर प्रीती करणार नाही;","poem":1},{"text":"त्यांचे सर्व पुढारी बंडखोर आहेत.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"एफ्राईम नाश पावला आहे.","poem":1},{"text":"त्यांची मुळे सुकून गेली आहेत.","poem":2},{"lineBreak":true},{"text":"ते फळ देत नाही.","poem":2},{"text":"जरी ते मुलांना जन्म देतील,","poem":1},{"text":"तर मी त्यांचे प्रिय मूल मारून टाकेन.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"माझा परमेश्वर त्यांना नाकारील","poem":1},{"text":"कारण त्यांनी त्यांची आज्ञा पाळली नाही;","poem":2},{"lineBreak":true},{"text":"ते देशादेशातून भटकत राहतील.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}