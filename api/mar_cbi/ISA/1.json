{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["यहूदीयाचे राजे उज्जीयाह, योथाम, आहाज आणि हिज्कीयाहच्या शासनकाळात आमोजाचा पुत्र यशायाहने यहूदीया आणि यरुशलेम संबंधी दृष्टान्त पाहिला."]},{"type":"line_break"},{"type":"heading","content":["बंडखोर राष्ट्र"]},{"type":"verse","number":2,"content":[{"text":"हे आकाशा, माझे ऐक! हे पृथ्वी ऐक!","poem":1},{"text":"कारण याहवेह असे म्हणाले:","poem":2},{"text":"“मी मुलांचे संगोपन केले आणि त्यांना वाढविले,","poem":1},{"text":"परंतु त्यांनी माझ्याविरुद्ध बंड केले आहे.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"बैल त्याच्या मालकाला ओळखतो,","poem":1},{"text":"गाढव त्याच्या मालकाचा गोठा ओळखतो,","poem":2},{"text":"परंतु इस्राएल ओळखत नाही,","poem":1},{"text":"माझ्या लोकांना समजत नाही.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"हे पापी राष्ट्रा, तुझा धिक्कार असो,","poem":1},{"text":"तुम्ही लोक, ज्यांचा अपराध फार मोठा आहे,","poem":2},{"text":"वाईट कृत्ये करणाऱ्यांची पिल्ले,","poem":1},{"text":"भ्रष्टाचारासाठी देऊन टाकलेली मुले!","poem":2},{"text":"त्यांनी याहवेहना सोडून दिले आहे;","poem":1},{"text":"इस्राएलच्या पवित्राला तिरस्काराने झिडकारले आहे,","poem":2},{"lineBreak":true},{"text":"आणि त्यांच्याकडे पाठ फिरविली आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"तुम्हाला आणखी मार का दिला जावा?","poem":1},{"text":"तुम्ही विद्रोह का करीत राहावे?","poem":2},{"text":"तुमच्या संपूर्ण डोक्याला दुखापत झाली आहे,","poem":1},{"text":"तुमचे संपूर्ण अंतःकरण ग्रस्त झाले आहे.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"पायाच्या तळव्यापासून ते डोक्याच्या टाळूपर्यंत","poem":1},{"text":"काहीही चांगले तिथे राहिले नाही—","poem":2},{"text":"फक्त जखमा आणि खरचटलेले,","poem":1},{"text":"आणि उघडे व्रण आहेत,","poem":2},{"text":"त्या स्वच्छ केलेल्या किंवा पट्ट्यांनी बांधलेल्या नाहीत","poem":1},{"text":"किंवा जैतुनाच्या तेलाने त्या पुसलेल्या नाहीत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"तुमचा देश उद्ध्वस्त झाला आहे,","poem":1},{"text":"तुमची शहरे अग्नीमध्ये जळाली आहेत;","poem":2},{"text":"पाडाव केल्यानंतर करावे तसे,","poem":1},{"text":"तुमच्यादेखत तुमची शेते","poem":2},{"lineBreak":true},{"text":"परदेशीयांनी ओरबाडून घेतली आहेत.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"सीयोनकन्येला","poem":1},{"text":"द्राक्षमळ्यात असलेल्या आश्रयस्थानासारखे,","poem":2},{"text":"काकडीच्या शेतातील झोपडीसारखे,","poem":1},{"text":"वेढा दिलेल्या शहराप्रमाणे आहे.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"सर्वसमर्थ","poem":1},{"noteId":0},{"text":"याहवेह यांनी जर","poem":1},{"text":"आमच्यातील काहींना वाचविले नसते तर,","poem":2},{"text":"आम्ही सदोमासारखे झालो असतो,","poem":1},{"text":"गमोरासारखी आमची गत झाली असती.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"अहो, सदोमाचे राज्यकर्ते,","poem":1},{"text":"याहवेहचे शब्द ऐका;","poem":2},{"text":"तुम्ही गमोराचे लोकहो,","poem":1},{"text":"आमच्या परमेश्वराची सूचना ऐका!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“तुमची असंख्य होमर्पणे—","poem":1},{"text":"ती माझ्यासाठी काय आहेत?”","poem":2},{"lineBreak":true},{"text":"असे याहवेह म्हणतात.","poem":2},{"text":"“होमार्पणासाठी माझ्याकडे गरजेपेक्षा जास्त","poem":1},{"text":"मेंढे आणि पुष्ट वासरे यांची चरबी आहे;","poem":2},{"text":"बैलांच्या, मेंढरांच्या किंवा शेळ्यांच्या रक्तामध्ये","poem":1},{"text":"मला काही आनंद नाही.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"जेव्हा तुम्ही माझ्यासमोर येता,","poem":1},{"text":"तुम्हाला कोणी सांगितले,","poem":2},{"lineBreak":true},{"text":"की माझ्या मंदिरांचे अंगण तुडवा?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"अर्थशून्य अर्पणे आणणे बंद करा!","poem":1},{"text":"तुमच्या सुगंधी धूपाचा मला तिटकारा वाटतो.","poem":2},{"text":"नवचंद्र उत्सव, शब्बाथ आणि समारंभ—","poem":1},{"text":"अशा तुमच्या निरर्थक सभा मी सहन करू शकत नाही.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"तुमचे अमावस्याचे उत्सव आणि तुमचे नेमलेले सण","poem":1},{"text":"यांचा मी माझ्या संपूर्णतेने तिरस्कार करतो.","poem":2},{"text":"ते मला भार असे झाले आहेत;","poem":1},{"text":"त्यांना सहन करता मी थकून गेलो आहे.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"प्रार्थनेमध्ये जेव्हा तुम्ही तुमचे हात पसरता,","poem":1},{"text":"तेव्हा मी तुमच्यापासून माझे डोळे लपवितो;","poem":2},{"text":"जेव्हा तुम्ही पुष्कळ विनवण्या करता,","poem":1},{"text":"मी त्या ऐकत नाही.","poem":2},{"lineBreak":true},{"text":"तुमचे हात रक्ताने माखलेले आहेत!","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“धुऊन तुम्ही स्वतःला स्वच्छ करा.","poem":1},{"text":"तुमची दुष्कृत्ये माझ्या दृष्टीबाहेर करा;","poem":2},{"lineBreak":true},{"text":"वाईट कृत्ये करणे थांबवा.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"योग्य तेच करण्यास शिका; न्यायीपणाचा शोध घ्या.","poem":1},{"text":"पीडितांचे संरक्षण करा.","poem":2},{"text":"पितृहीनांच्या बाजूचे समर्थन करा;","poem":1},{"text":"विधवांची बाजू मांडा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“या आता, आपण वाद मिटवू या,”","poem":1},{"text":"असे याहवेह म्हणतात.","poem":2},{"text":"“जरी तुमची पापे लाखेसारखी असली,","poem":1},{"text":"तरी ती बर्फासारखी पांढरी होतील;","poem":2},{"text":"जरी ती किरमिजाप्रमाणे लाल असली,","poem":1},{"text":"तरी ती लोकरीसारखी होतील.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"जर तुमची तयारी असेल आणि तुम्ही आज्ञाकारक असाल,","poem":1},{"text":"तर तुम्ही भूमीच्या चांगल्या वस्तू खाल;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"परंतु जर तुम्ही विरोध कराल आणि विद्रोह कराल,","poem":1},{"text":"तर तुमचा तलवारीने नाश केला जाईल.”","poem":2},{"text":"कारण हे शब्द याहवेहच्या मुखातील आहेत.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"पाहा, ही विश्वासू नगरी","poem":1},{"text":"आता कशी वेश्या झाली आहे!","poem":2},{"text":"ती न्यायाने भरलेली होती;","poem":1},{"text":"नीतिमत्व तिच्यामध्ये वास करीत होते—","poem":2},{"lineBreak":true},{"text":"परंतु आता वध करणारे राहतात!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"तुमची चांदी क्षुद्र झाली आहे,","poem":1},{"text":"तुमचा उत्तम द्राक्षारस पाणी मिसळून पांचट झाला आहे.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"तुमचे राज्यकर्ते बंडखोर आहेत,","poem":1},{"text":"चोरांचे भागीदार आहेत;","poem":2},{"text":"त्या सर्वांना लाच घ्यायला आवडते,","poem":1},{"text":"आणि ते बक्षिसांच्या मागे पळतात.","poem":2},{"text":"ते अनाथांच्या बाजूचे रक्षण करीत नाहीत;","poem":1},{"text":"विधवांचा खटल्याचे समर्थन करीत नाहीत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"म्हणून प्रभू, सर्वसमर्थ याहवेह,","poem":1},{"text":"इस्राएलचे महाशक्तिमान असे जाहीर करतात:","poem":2},{"text":"“अहा! मी माझ्या शत्रूंवर माझा क्रोध मोकळा करेन","poem":1},{"text":"आणि माझ्या शत्रूंचा मी स्वतः सूड घेईन.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"मी माझा हात तुमच्याविरुद्ध","poem":1},{"noteId":1},{"text":"उचलेन;","poem":1},{"text":"मी तुमची सर्व मलिनता पूर्णपणे काढून टाकेन","poem":2},{"lineBreak":true},{"text":"आणि तुमची सर्व अशुद्धता काढून दोषरहित करेन.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"मी तुमच्या पुढाऱ्यांना परत पूर्वस्थितीत आणेन,","poem":1},{"text":"तुमचे राज्यकर्त्ये सुरुवातीला होते तसेच त्यांना परत करेन.","poem":2},{"text":"त्यानंतर तुम्हाला,","poem":1},{"text":"धार्मिकतेचे शहर,","poem":2},{"lineBreak":true},{"text":"विश्वासू शहर असे म्हटले जाईल.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"सीयोन न्यायाने,","poem":1},{"text":"आणि तिचे पश्चात्तापकर्त्ये नीतिमत्त्वाने सोडविले जातील.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"परंतु बंडखोर आणि पापी या दोघांना मोडण्यात येईल,","poem":1},{"text":"आणि ज्यांनी याहवेहचा त्याग केला, त्यांचा नाश होईल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“ज्यांच्यामध्ये तुम्ही हर्षोत्सव केले,","poem":1},{"text":"त्या एलाच्या पवित्र वृक्षाबद्दल तुम्ही लज्जित व्हाल;","poem":2},{"text":"ज्यांची तुम्ही निवड केली आहे","poem":1},{"text":"त्या बागांमुळे तुमचा अपमान केला जाईल.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"तुम्ही पाने कोमेजून गेलेल्या एलावृक्षासारखी,","poem":1},{"text":"पाणी नसलेल्या बागेसारखे व्हाल.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"पराक्रमी मनुष्य चकमकीसारखा होईल,","poem":1},{"text":"आणि त्याचे काम ठिणगी असे होईल;","poem":2},{"text":"दोघेही एकत्र जळतील,","poem":1},{"text":"ती आग विझविणारे कोणीही नसेल.”","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"किंवा सेनाधीश","reference":{"chapter":1,"verse":9}},{"noteId":1,"caller":"+","text":"किंवा यरुशलेमविरुद्ध","reference":{"chapter":1,"verse":25}}]},"thisChapterLink":"/api/mar_cbi/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}