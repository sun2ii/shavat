{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"त्यांचा धिक्कार असो, जे अन्यायी कायदे बनवितात—","poem":1},{"text":"जुलूम करणारा हुकूमनामा जे काढतात,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"गरिबांचे हक्क हिरावून घेण्यासाठी","poem":1},{"text":"आणि माझ्या लोकांपैकी पीडितांना न्यायापासून वंचित करण्यासाठी,","poem":2},{"text":"विधवांना त्यांचे सावज बनविण्यासाठी","poem":1},{"text":"आणि अनाथांना लुटण्यासाठी.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"दंड मिळण्याच्या दिवशी तुम्ही काय कराल,","poem":1},{"text":"जेव्हा फार दुरून संकट येईल?","poem":2},{"text":"तुम्ही कोणाकडे मदतीसाठी धावणार आहात?","poem":1},{"text":"तुम्ही तुमची संपत्ती कुठे सोडून देणार?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"बंदिवानांमध्‍ये लपून बसणे,","poem":1},{"text":"किंवा मेलेल्यांमध्ये पडून राहाणे या वाचून काहीही उरणार नाही.","poem":2},{"lineBreak":true},{"text":"हे सर्व करूनही त्यांचा संताप अजून शमला नाही,","poem":1},{"text":"त्यांचा हात अजूनही उगारलेलाच आहे.","poem":2}]},{"type":"heading","content":["परमेश्वर अश्शूरचा न्यायनिवाडा करतात"]},{"type":"verse","number":5,"content":[{"text":"“अश्शूरचा धिक्कार असो, जो माझ्या क्रोधाची काठी आहे,","poem":1},{"text":"ज्याच्या हातामध्ये माझ्या क्रोधाचा सोटा आहे!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मी त्याला अधार्मिक राष्ट्राविरुद्ध पाठवितो,","poem":1},{"text":"मला जे संताप आणतात, अशा लोकांविरुद्ध पाठवितो,","poem":2},{"text":"त्यांची लूटमार करण्यासाठी आणि लूट हिसकावून घेण्यासाठी,","poem":1},{"text":"आणि त्यांना रस्त्यांवरील चिखलाप्रमाणे तुडविण्यासाठी.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"परंतु हा त्याचा उद्देश नाही,","poem":1},{"text":"त्याच्या मनात हे नाही;","poem":2},{"text":"त्याचा उद्देश आहे की नाश करावा,","poem":1},{"text":"अनेक राष्ट्रांचा नाश करून त्यांचा अंत करावा.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"‘माझे सेनापती सर्व राजे नाहीत काय?’ असे ते म्हणतात.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"‘कालनो कर्कमीश सारखे नाही काय?","poem":2},{"text":"हमाथ अर्पादसारखा","poem":1},{"text":"आणि शोमरोन दिमिष्कसारखा नाही काय?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"जशी माझ्या हाताने मूर्तींपूजक राज्ये ताब्यात घेतली,","poem":1},{"text":"अशी राज्ये ज्यांच्या प्रतिमा यरुशलेम आणि शोमरोनपेक्षा श्रेष्ठ होत्या—","poem":2}]},{"type":"verse","number":11,"content":[{"text":"शोमरोन आणि तिच्या मूर्तींबरोबर मी जसा व्यवहार केला","poem":1},{"text":"तसा व्यवहार मी यरुशलेम आणि तिच्या मूर्तींबरोबर करू नये काय?’ ”","poem":2}]},{"type":"verse","number":12,"content":["जेव्हा प्रभूने सीयोन पर्वत आणि यरुशलेमविरुद्ध त्यांचे सर्व कार्य पूर्ण केले, तेव्हा ते म्हणतील, “मी अश्शूरच्या राजाला त्याच्या अंतःकरणाच्या हेतुपुरस्सर अभिमानाबद्दल आणि त्याच्या नजरेतील गर्विष्ठपणाबद्दल शिक्षा करेन."]},{"type":"verse","number":13,"content":["कारण ते म्हणतात:",{"text":"“ ‘माझ्या हाताच्या शक्तीने मी हे केले आहे,","poem":1},{"text":"आणि माझ्या शहाणपणाने हे केले आहे, कारण माझ्याकडे समंजसपणा आहे.","poem":2},{"text":"मी राष्ट्रांच्या सीमा काढून टाकल्या,","poem":1},{"text":"मी त्यांचे खजिने लुटले;","poem":2},{"lineBreak":true},{"text":"एका बलवानाप्रमाणे मी त्यांच्या राजांना वश केले.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"जसा कोणी घरट्यात पोहोचतो,","poem":1},{"text":"तसेच राष्ट्रांच्या संपत्तीसाठी माझा हात पोहोचला.","poem":2},{"text":"जसे लोक सोडून दिलेली अंडी गोळा करतात,","poem":1},{"text":"तसे मी सर्व देशांना एकत्र केले;","poem":2},{"text":"कोणीही पंख फडफडविला नाही,","poem":1},{"text":"किंवा किलबिल करण्यासाठी तोंड उघडले नाही.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"जो कुर्‍हाड फिरवितो त्याच्यावरच कुऱ्हाड उठते काय,","poem":1},{"text":"किंवा करवतीचा जो वापर करतो त्याच्याचविरुद्ध ती बढाई मारते काय?","poem":2},{"text":"जसे एखादा व्यक्ती जी काठी उचलतो तीच त्याच्यावर उगारते काय,","poem":1},{"text":"किंवा जे लाकूड नाही, त्याला धमकावण्यासाठी जड काठी हवेत फिरते काय!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"म्हणून, प्रभू, सर्वसमर्थ याहवेह,","poem":1},{"text":"त्याच्या दणकट योद्ध्यांवर विनाशकारी रोग पाठवतील;","poem":2},{"text":"त्यांच्या ऐश्वर्यात धगधगत्या ज्योतीसारखा अग्नी प्रज्वलित केला जाईल","poem":1},{"text":"अग्नी प्रज्वलित केला जाईल.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"इस्राएलचा प्रकाश अग्नी होईल,","poem":1},{"text":"त्यांचे पवित्र परमेश्वर एक ज्वाला होतील;","poem":2},{"text":"त्याचे काटे आणि काटेरी झुडपे","poem":1},{"text":"ते एकाच दिवसात जळतील व भस्म करतील.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ज्याप्रकारे एखादा रोगी क्षय पावतो","poem":1},{"text":"त्याप्रकारे त्याच्या जंगलांचे आणि सुपीक शेत जमिनींचे वैभव,","poem":2},{"lineBreak":true},{"text":"ते पूर्णपणे नष्ट करतील.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"आणि त्याच्या जंगलातील राहिलेली झाडे इतकी कमी असतील की,","poem":1},{"text":"एखादे लहान बालकही त्याची नोंद करेल.","poem":2}]},{"type":"heading","content":["इस्राएलचे अवशिष्ट लोक"]},{"type":"verse","number":20,"content":[{"text":"त्या दिवशी इस्राएलचे अवशिष्ट,","poem":1},{"text":"जिवंत राहिलेले याकोबाचे लोक,","poem":2},{"text":"ज्याने त्यांना मारून टाकले","poem":1},{"text":"त्याच्यावर यापुढे अवलंबून राहणार नाहीत,","poem":2},{"text":"परंतु याहवेह, इस्राएलच्या पवित्र परमेश्वरावर","poem":1},{"text":"ते खरोखरच भरवसा ठेवतील.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"याकोबाचा राहिलेला प्रत्येकजणही परत येईल,","poem":1},{"text":"सर्वसमर्थ परमेश्वराकडे परत येईल.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"हे, इस्राएला, तुझे लोक समुद्राच्या वाळूच्या कणासारखे असली तरी,","poem":1},{"text":"उरलेलेच मात्र परत येतील.","poem":2},{"text":"नाश करण्याचा निर्णय घेण्यात आला आहे,","poem":1},{"text":"परिपूर्ण आणि न्याययुक्त.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"प्रभू, सर्वसमर्थ याहवेह,","poem":1},{"text":"नाश करण्याचा हुकूमनामा संपूर्ण देशामध्ये अंमलात आणतील.","poem":2}]},{"type":"verse","number":24,"content":["म्हणून प्रभू, सर्वसमर्थ याहवेह असे म्हणतात:",{"text":"“माझे लोकहो, जे तुम्ही सीयोनमध्ये राहता,","poem":1},{"text":"अश्शूरी लोकांना घाबरू नका,","poem":2},{"text":"जे तुम्हाला दांडक्याने मारतात.","poem":1},{"text":"आणि इजिप्तने केले त्याप्रमाणे तुमच्याविरुद्ध सोटा उगारतात.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"तुमच्याविरुद्ध असलेला माझा राग लवकरच संपेल","poem":1},{"text":"आणि माझा क्रोध त्यांच्या नाशाच्या मार्गाकडे वळेल.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"सर्वसमर्थ याहवेह त्यांना चाबकाने फोडून काढतील,","poem":1},{"text":"जसे त्यांनी मिद्यानाला ओरेबच्या खडकावर मारले होते;","poem":2},{"text":"आणि ते त्यांची काठी पाण्यावर उंच करतील,","poem":1},{"text":"जसे त्यांनी इजिप्तमध्ये केले होते.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"त्या दिवशी त्यांचे ओझे तुमच्या खांद्यावरून,","poem":1},{"text":"त्यांचे जू तुमच्या मानेवरून काढून घेतले जाईल.","poem":2},{"text":"तुमच्या खांद्यावरून","poem":1},{"text":"जू तुटले जाईल.","poem":2},{"noteId":13}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ते अयाथमध्ये प्रवेश करतात;","poem":1},{"text":"ते मिग्रोनमधून पुढे जातात;","poem":2},{"lineBreak":true},{"text":"ते मिकमाश येथे पुरवठा साठवितात.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ते पुढे पलीकडे जातात आणि म्हणतात,","poem":1},{"text":"“आम्ही गेबा येथे रात्रभर छावणी टाकू.”","poem":2},{"text":"रामाह थरथर कापतो;","poem":1},{"text":"शौलाचा गिबियाह पळून जातो.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"गल्लीमच्या मुली, आरडाओरडा करा!","poem":1},{"text":"ऐक, लईशाह!","poem":2},{"lineBreak":true},{"text":"गरीब बिचारा अनाथोथ!","poem":2}]},{"type":"verse","number":31,"content":[{"text":"मदमेनाह पळून गेला आहे;","poem":1},{"text":"गेबीमचे लोक आश्रय घेत आहेत.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"आज ते नोब येथे थांबतील;","poem":1},{"text":"सीयोन कन्येच्या डोंगराकडे,","poem":2},{"text":"यरुशलेमच्या टेकडीकडे","poem":1},{"text":"ते त्यांच्या मुठी वळवतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"हे पाहा, प्रभू, सर्वसमर्थ याहवेह,","poem":1},{"text":"मोठ्या सामर्थ्याने झाडांच्या मोठ्या फांद्या छाटून टाकतील.","poem":2},{"text":"भव्य झाडे पाडली जातील,","poem":1},{"text":"उंच झाडे खाली आणली जातील.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ते कुऱ्हाडीने जंगलातील झाडेझुडपांचे रान कापून टाकतील;","poem":1},{"text":"लबानोन प्रतापी परमेश्वरासमोर पडेल.","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"किंवा कारण तुमची चरबी वाढली आहे","reference":{"chapter":10,"verse":27}}]},"thisChapterLink":"/api/mar_cbi/ISA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/9.json","previousChapterAudioLinks":{},"numberOfVerses":34}