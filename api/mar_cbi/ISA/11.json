{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":11,"content":[{"type":"heading","content":["इशायापासून फांदी"]},{"type":"verse","number":1,"content":[{"text":"इशायाच्या बुंध्यापासून एक अंकुर निघून वर येईल;","poem":1},{"text":"त्याच्या मुळांपासून एक फांदी येऊन ती फळ देईल.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"याहवेहचा आत्मा त्यांच्यावर विसावेल—","poem":1},{"text":"शहाणपणाचा आणि समंजसपणाचा आत्मा,","poem":2},{"lineBreak":true},{"text":"सल्ला आणि पराक्रमाचा आत्मा,","poem":2},{"lineBreak":true},{"text":"ज्ञानाचा आत्मा आणि याहवेहच्या भयाचा आत्मा—","poem":2}]},{"type":"verse","number":3,"content":[{"text":"आणि ते याहवेहचे भय बाळगण्यात आनंद मानतील.","poem":1},{"lineBreak":true},{"text":"ते तोंडदेखला न्याय करणार नाहीत,","poem":1},{"text":"किंवा कानाने ऐकलेल्या गोष्टीवरून ते निर्णय घेणार नाहीत.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"परंतु ते नीतिमत्त्वाने गरजवंत लोकांचा न्याय करतील,","poem":1},{"text":"न्यायाने ते पृथ्वीवरील गरिबांसाठी निर्णय देतील.","poem":2},{"text":"ते त्यांच्या मुखाच्या काठीने पृथ्वीवर हल्ला करतील;","poem":1},{"text":"ते त्यांच्या ओठांच्या श्वासाने दुष्टांचा वध करतील.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"धार्मिकता त्यांचा कटिबंध असेल","poem":1},{"text":"आणि विश्वासूपणा त्यांचा कंबरपट्टा असेल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"लांडगा कोकऱ्याबरोबर राहील,","poem":1},{"text":"चित्ता बकरीबरोबर झोपेल,","poem":2},{"text":"वासरे आणि सिंह एकत्र राहतील;","poem":1},{"noteId":14},{"text":"आणि एक लहान बालक त्यांचे मार्गदर्शन करेल.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"गाई अस्वलाबरोबर चरतील,","poem":1},{"text":"त्यांची पिल्ले एकत्र झोपतील,","poem":2},{"lineBreak":true},{"text":"आणि सिंह बैलाप्रमाणे कडबा खाईल.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"लहान बाळ नागाच्या गुहेजवळ खेळेल,","poem":1},{"text":"आणि बालक विषारी फुरसे सर्पाच्या बिळात हात घालेल.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"माझ्या पवित्र पर्वतावर सर्वठिकाणी","poem":1},{"text":"ते कोणाचेही नुकसान किंवा नाश करणार नाहीत,","poem":2},{"text":"कारण समुद्र जसा पाण्याने व्यापलेला आहे","poem":1},{"text":"तशीच पृथ्वी याहवेहच्या ज्ञानाने भरून जाईल.","poem":2}]},{"type":"verse","number":10,"content":["त्या दिवशी इशायाचे मूळ लोकांसाठी ध्वज म्हणून उभे राहील; राष्ट्रे त्यांच्याकडे एकत्र येतील आणि त्यांचे विश्रामस्थान गौरवशाली असेल."]},{"type":"verse","number":11,"content":["त्या दिवशी प्रभू अश्शूरमधून, इजिप्तच्या खालील भागामधून, इजिप्तच्या वरील भागामधून, कूशमधून, पथरोसमधून, एलाममधून, शिनारमधून",{"noteId":15},", हमाथमधून आणि भूमध्यसागराच्या बेटांमधून त्यांच्या अवशिष्ट लोकांवर पुन्हा हक्क सांगण्यासाठी दुसऱ्या वेळेस त्यांचा हात पुढे करतील."]},{"type":"verse","number":12,"content":[{"text":"राष्ट्रांसाठी ते एक ध्वज उभा करतील","poem":1},{"text":"आणि इस्राएलच्या बंदिवासात गेलेल्यांना एकत्र करतील;","poem":2},{"text":"पृथ्वीच्या चारही कोपऱ्यातून","poem":1},{"text":"यहूदीयाच्या विखुरलेल्या लोकांना ते एकत्र जमवतील.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"एफ्राईमचा मत्सर नाहीसा होईल,","poem":1},{"text":"आणि यहूदीयाच्या शत्रूंचा नाश होईल;","poem":2},{"text":"एफ्राईमला यहूदाहचा मत्सर वाटणार नाही,","poem":1},{"text":"किंवा यहूदाह एफ्राईमबरोबर शतृत्व करणार नाही.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ते पश्चिमेला पलिष्ट्यांच्या उतारावर झेपावतील;","poem":1},{"text":"एकत्र मिळून ते पूर्व दिशेकडील लोकांना लुटतील.","poem":2},{"text":"एदोम आणि मोआब या देशांना ते जिंकून घेतील,","poem":1},{"text":"आणि अम्मोनी लोक त्यांच्या अधीन होतील.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"याहवेह, इजिप्तच्या समुद्राचे","poem":1},{"text":"आखात कोरडे करतील;","poem":2},{"text":"होरपळणाऱ्या वाऱ्याने","poem":1},{"text":"ते फरात नदीवर हात झटकून टाकतील.","poem":2},{"text":"ते त्याचे सात ओढे पाडतील","poem":1},{"text":"जेणेकरून पायतणे घालूनही ती ओलांडता येईल.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"अश्शूरपासून त्यांच्या अवशिष्ट लोकांसाठी","poem":1},{"text":"जेव्हा ते इजिप्तमधून आले","poem":2},{"text":"तेव्हा जसा इस्राएलसाठी केला होता,","poem":1},{"text":"तसा एक राजमार्ग असेल.","poem":2}]}],"footnotes":[{"noteId":14,"caller":"+","text":"किंवा सिंह वासराला चारेल","reference":{"chapter":11,"verse":6}},{"noteId":15,"caller":"+","text":"बाबिलोन","reference":{"chapter":11,"verse":11}}]},"thisChapterLink":"/api/mar_cbi/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/10.json","previousChapterAudioLinks":{},"numberOfVerses":16}