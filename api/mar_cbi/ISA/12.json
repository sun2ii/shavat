{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":12,"content":[{"type":"heading","content":["स्तुतिगीत"]},{"type":"verse","number":1,"content":["त्या दिवशी तुम्ही म्हणाल:",{"text":"“याहवेह, मी तुमची स्तुती करेन,","poem":1},{"text":"जरी तुम्ही माझ्यावर रागावला होता,","poem":2},{"text":"तरी तुमचा राग दूर झाला आहे","poem":1},{"text":"आणि तुम्ही माझे सांत्वन केले आहे.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"निश्चितच परमेश्वर माझे तारण आहेत;","poem":1},{"text":"मी भरवसा ठेवेन आणि घाबरणार नाही.","poem":2},{"text":"याहवेह, याहवेह स्वतः माझे सामर्थ्य आणि माझे संरक्षण","poem":1},{"noteId":16},{"text":"आहेत;","poem":1},{"text":"ते माझे तारण झाले आहेत.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तारणाच्या विहिरींतून","poem":1},{"text":"तुम्ही आनंदाने पाणी काढाल.","poem":2}]},{"type":"verse","number":4,"content":["त्या दिवशी तुम्ही म्हणाल:",{"text":"“याहवेहची स्तुती करा, त्यांच्या नावाची घोषणा करा;","poem":1},{"text":"त्यांनी जे काही केले आहे ते राष्ट्रांमध्ये माहीत होऊ द्या,","poem":2},{"lineBreak":true},{"text":"आणि असे घोषित करा की, त्यांचे नाव गौरवान्वित आहे.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"याहवेहसाठी गीत गा, कारण त्यांनी गौरवशाली कार्ये केली आहेत;","poem":1},{"text":"हे सर्व जगाला माहीत करून द्या.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"सीयोनच्या लोकांनो, मोठ्याने गर्जना करा आणि आनंद गीते गा,","poem":1},{"text":"कारण इस्राएलचे महान पवित्र परमेश्वर तुमच्यामध्ये आहेत.”","poem":2}]}],"footnotes":[{"noteId":16,"caller":"+","text":"किंवा गीत","reference":{"chapter":12,"verse":2}}]},"thisChapterLink":"/api/mar_cbi/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}