{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":13,"content":[{"type":"heading","content":["बाबेलविरुद्ध केलेली भविष्यवाणी"]},{"type":"verse","number":1,"content":["आमोजाचा पुत्र यशायाहने बाबेलच्या विरोधात पाहिलेला दृष्टान्त:"]},{"type":"verse","number":2,"content":[{"text":"उघड्या टेकडीच्या शिखरावर ध्वज उंच करा,","poem":1},{"text":"मान्यवर लोकांच्या फाटकांमधून प्रवेश करण्यासाठी","poem":2},{"text":"त्यांना ओरडून सांगा;","poem":1},{"text":"खुणा करून त्यांना बोलवा.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ज्यांना मी युद्धासाठी सुसज्ज केले आहे, त्यांना मी आज्ञा दिली आहे.","poem":1},{"text":"जे माझ्या विजयाचा आनंद करीत आहेत—","poem":2},{"lineBreak":true},{"text":"मी माझा क्रोध अंमलात आणण्यासाठी त्या माझ्या योद्ध्यांना पाचारण केले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ऐका, डोंगरावरील एक आवाज,","poem":1},{"text":"मोठ्या लोकसमुदायासारखा आवाज!","poem":2},{"text":"ऐका, राज्यांमध्ये चालू असलेला गोंधळ,","poem":1},{"text":"राष्ट्रे एकत्र जमत असल्यासारखा आवाज!","poem":2},{"text":"सर्वसमर्थ याहवेह,","poem":1},{"text":"युद्धासाठी सैन्य जमा करीत आहेत.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ते फार दूर देशातून येतात,","poem":1},{"text":"आकाशाच्या शेवटच्या टोकापासून—","poem":2},{"text":"याहवेह आणि त्यांच्या क्रोधाची शस्त्रे","poem":1},{"text":"संपूर्ण देशाचा नाश करण्यासाठी येतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"आक्रोश करा, कारण याहवेहचा दिवस जवळ आला आहे;","poem":1},{"text":"तो दिवस सर्वसमर्थ यांच्याकडून नाशाप्रमाणे येईल.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"या कारणामुळे सर्वांचे हात शक्तिहीन होतील,","poem":1},{"text":"प्रत्येकाचे हृदय भीतीने वितळून जाईल.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"दहशत त्यांच्यावर झडप घालेल,","poem":1},{"text":"वेदना आणि मनस्ताप त्यांना घट्ट पकडतील;","poem":2},{"lineBreak":true},{"text":"प्रसूती होणाऱ्या स्त्रीप्रमाणे ते वेदनेने गडाबडा लोळतील.","poem":2},{"text":"भयग्रस्त होऊन ते एकमेकांकडे पाहतील,","poem":1},{"text":"त्यांचे चेहरे होरपळतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"पाहा, याहवेहचा दिवस येत आहे","poem":1},{"text":"—एक कठोर दिवस, क्रोधाचा आणि घोर संतापाचा—","poem":2},{"text":"भूमी उजाड करण्यासाठी","poem":1},{"text":"आणि तेथील पापी लोकांचा नाश करण्यासाठी.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"आकाशातील तारे आणि त्यांची नक्षत्रे","poem":1},{"text":"त्यांचा प्रकाश देणार नाहीत.","poem":2},{"text":"उगवता सूर्य अंधकारमय होईल","poem":1},{"text":"आणि चंद्र त्याचा प्रकाश देणार नाही.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"मी जगाला त्याच्या दुष्टाईबद्दल","poem":1},{"text":"दुष्टांना त्यांच्या पापांबद्दल शिक्षा करेन.","poem":2},{"text":"मी गर्विष्ठांचा अहंकार नाहीसा करेन","poem":1},{"text":"आणि निर्दयी अभिमानींना मी लीन करेन.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"मी लोकांना शुद्ध सोन्यापेक्षा दुर्मिळ करेन,","poem":1},{"text":"ओफीरच्या सोन्यापेक्षाही अप्राप्य करेन.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"म्हणून सर्वसमर्थ याहवेह यांच्या क्रोधाने","poem":1},{"text":"आणि त्यांच्या क्रोधाग्नीच्या दिवशी","poem":2},{"text":"मी आकाशे थरथर कापतील असे करेन;","poem":1},{"text":"पृथ्वी तिच्या जागेवर हादरेल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"शिकार केलेल्या छोट्या हरिणीप्रमाणे,","poem":1},{"text":"जसे मेंढपाळ नसलेले मेंढरू,","poem":2},{"text":"सर्व त्यांच्या त्यांच्या लोकांकडे परत जातील,","poem":1},{"text":"ते त्यांच्या मातृभूमीत पळून जातील.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"जो कोणी पकडला जाईल, त्याला आरपार खुपसले जाईल.","poem":1},{"text":"जे सर्व पकडले गेले, ते तलवारीने मारले जातील.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"त्यांची बालके त्यांच्या डोळ्यासमोर आपटून, त्यांचे तुकडे केले जातील;","poem":1},{"text":"त्यांची घरे लुटली जातील आणि त्यांच्या स्त्रियांचा विनयभंग केला जाईल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"पाहा, ज्यांना चांदीची पर्वा नाही,","poem":1},{"text":"आणि जे सोन्यामध्ये आनंद मानत नाहीत","poem":2},{"lineBreak":true},{"text":"त्या मेदिया लोकांना मी त्यांच्याविरुद्ध चिथावणी देईन.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"त्यांची धनुष्ये तरुणांना मारून टाकतील;","poem":1},{"text":"ते तान्ह्या बालकांवर दया करणार नाहीत,","poem":2},{"lineBreak":true},{"text":"किंवा ते लहान मुलांकडे दयेने पाहणार नाहीत.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"खास्द्यांच्या राज्यांचे बहुमूल्य रत्न,","poem":1},{"text":"बाबेलच्या लोकांचा अभिमान आणि गौरव,","poem":2},{"text":"सदोम आणि गमोराप्रमाणे","poem":1},{"text":"परमेश्वराकडून उद्ध्वस्त केल्या जाईल.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"तिच्यात कोणी कधीही वसती करणार नाही","poem":1},{"text":"किंवा पिढ्यान् पिढ्या रहिवास करणार नाही;","poem":2},{"text":"कोणीही अरब","poem":1},{"noteId":17},{"text":"त्यांचे तंबू तिथे ठोकणार नाहीत,","poem":1},{"text":"तिथे कोणीही मेंढपाळ त्यांच्या कळपांना विश्रांती देणार नाहीत.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"परंतु अरण्यातील प्राणी तिथे राहतील,","poem":1},{"text":"तरसानी तिची घरे भरून जातील;","poem":2},{"text":"तिथे घुबडे राहतील,","poem":1},{"text":"आणि तिथे बोकडे उड्या मारतील.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"तरस प्राणी तिच्या गडांवर वस्ती करतील,","poem":1},{"text":"कोल्हे तिच्या आलिशान राजवाड्यांमध्ये वस्ती करतील.","poem":2},{"text":"तिची वेळ फार जवळ आली आहे,","poem":1},{"text":"आणि तिचे दिवस लांबणार नाहीत.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":17,"caller":"+","text":"भटके","reference":{"chapter":13,"verse":20}}]},"thisChapterLink":"/api/mar_cbi/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}