{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेह याकोबवर दया करतील;","poem":1},{"text":"पुन्हा एकदा ते इस्राएलची निवड करतील","poem":2},{"lineBreak":true},{"text":"आणि त्यांना त्यांच्या मातृभूमीत स्थायी करतील.","poem":2},{"text":"परदेशी लोक त्यांच्यात सामील होतील","poem":1},{"text":"आणि याकोबाच्या वंशजांसोबत एकत्र येतील.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"अनेक राष्ट्रे त्यांना सहकार्य करतील","poem":1},{"text":"व त्यांना त्यांच्या जागी आणतील.","poem":2},{"text":"आणि इस्राएल राष्ट्रांवर ताबा मिळवतील,","poem":1},{"text":"व याहवेहच्या भूमीत त्यांच्या स्त्रिया व पुरुषांना आपले सेवक बनवतील,","poem":2},{"text":"त्यांना बंदिवासात नेलेल्यांना ते बंदी करतील","poem":1},{"text":"त्यांना पीडलेल्यांवर ते राज्य करतील.","poem":2}]},{"type":"verse","number":3,"content":["त्या दिवशी याहवेह तुम्हाला तुमच्या सर्व पीडा व अस्वस्थता व कठोर परिश्रमातून मुक्तता देतील."]},{"type":"verse","number":4,"content":["तेव्हा बाबेलच्या राजाला तुच्छतेने तुम्ही म्हणाल:",{"text":"पाहा, तो जुलूमशहा कसा नाश पावला आहे!","poem":1},{"text":"त्यांचा उन्मत्तपणा कसा नष्ट झाला आहे!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"कारण याहवेहने दुष्टांची काठी,","poem":1},{"text":"व तुझा दुष्टाईचा राजदंड मोडला आहे,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ज्या लोकांना तू क्रोधाने मारले,","poem":1},{"text":"सतत ठोसा मारत राहिलास,","poem":2},{"text":"बेफाम त्वेषाने व","poem":1},{"text":"पाषाणहृदयी आवेशाने देशांना अधीन केले.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"सर्व देश आता समाधानी आणि शांत आहेत;","poem":1},{"text":"ते गाणी गात आहेत.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"लबानोनची सनोवरची झाडे आणि गंधसरूसुद्धा","poem":1},{"text":"आनंद व्यक्त करतात आणि म्हणतात,","poem":2},{"text":"“आता तुम्हाला खाली पाडले आहे,","poem":1},{"text":"तेव्हापासून आम्हाला तोडण्यासाठी कोणी आलेले नाही.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"अधोलोक तुम्हाला भेटण्यासाठी","poem":1},{"text":"मृतांच्या रसातळात हालचाल होत आहे;","poem":2},{"text":"मेलेल्यांचे आत्मे जागृत होऊन तुम्हाला अभिवादन करण्यासाठी—","poem":1},{"text":"जगामध्ये जे सर्व पुढारी होते;","poem":2},{"text":"जे सर्व राष्ट्रांवरील राजे होते,","poem":1},{"text":"ते त्यांच्या सिंहासनावरून उठत आहेत.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ते सर्व प्रतिसाद देतील,","poem":1},{"text":"ते तुम्हाला असे म्हणतील,","poem":2},{"text":"“जसे आम्ही आहोत, तसे तुम्ही सुद्धा दुर्बल झाला आहात;","poem":1},{"text":"तुम्ही आमच्यासारखे झाला आहात.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तुमच्या वीणांच्या आवाजासहीत,","poem":1},{"text":"तुमचा सर्व डामडौल खाली थडग्यात आणण्यात आला आहे,","poem":2},{"text":"कृमी तुमच्या खाली पसरलेल्या आहेत","poem":1},{"text":"आणि कीटक तुम्हाला झाकून टाकत आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"पहाटेच्या ताऱ्या, सूर्योदयाच्या पुत्रा!","poem":1},{"text":"तू स्वर्गातून कसा पडला आहेस,","poem":2},{"text":"तू, ज्याने एकेकाळी राष्ट्रांना खाली पाडले,","poem":1},{"text":"तू पृथ्वीवर फेकला गेला आहेस!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तू तुझ्या अंतःकरणात म्हणाला,","poem":1},{"text":"“मी स्वर्गात चढून जाईन;","poem":2},{"text":"मी माझे सिंहासन","poem":1},{"text":"परमेश्वराच्या ताऱ्यांपेक्षा उंच करेन;","poem":2},{"text":"मी लोकसभेच्या पर्वतावरील सिंहासनावर बसेन,","poem":1},{"text":"झाफोनच्या","poem":2},{"noteId":18},{"text":"सर्वात उंच पर्वतावर मी स्थानापन्न होईन.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"मी ढगांच्या शिखरांवर जाईन;","poem":1},{"text":"मी स्वतःला सर्वोच्च परमेश्वरासारखे करेन.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"परंतु आता तू मृतांच्या अधोलोकात,","poem":1},{"text":"खोल खाईत लोटला गेला आहेस.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"जे तुझ्याकडे पाहतात ते टक लावून बघत आहेत,","poem":1},{"text":"ते तुझ्या नशिबाविषयी विचार करतात:","poem":2},{"text":"“हा तोच मनुष्य आहे काय, ज्याने पृथ्वीला हादरविले होते","poem":1},{"text":"आणि राज्यांना कंप सुटेल असे केले होते.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ज्या मनुष्याने जगाला अरण्य केले","poem":1},{"text":"ज्याने शहरे उद्ध्वस्त केली","poem":2},{"lineBreak":true},{"text":"आणि तो त्याच्या बंदिवानांना घरी जाऊ देत नसे?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"राष्ट्रांचे सर्व राजे चिरनिद्रीत अवस्थेत आहेत,","poem":1},{"text":"प्रत्येकजण स्वतःच्या कबरेत आहे.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"परंतु तुला तुझ्या कबरेतून","poem":1},{"text":"नको असलेल्या फांदीसारखे बाहेर टाकले आहे;","poem":2},{"text":"ज्यांना तलवारीने भोसकून टाकले,","poem":1},{"text":"जे दगडांच्या खड्ड्यात टाकण्यात येतात,","poem":2},{"lineBreak":true},{"text":"ज्याप्रकारे माणसांची प्रेते पायाखाली तुडविली जातात","poem":2},{"text":"तसे त्यांना तुमच्यावर झाकून टाकले आहे.","poem":1}]},{"type":"verse","number":20,"content":[{"text":"तुम्ही त्यांच्या दफनविधीमध्ये सामील होणार नाही,","poem":2},{"text":"कारण तुम्ही तुमच्या देशाचा नाश केला आहे","poem":1},{"text":"आणि तुमच्या लोकांना ठार मारले आहे.","poem":2},{"lineBreak":true},{"lineBreak":true},{"text":"दुष्ट लोकांच्या संततीचा","poem":1},{"text":"पुन्हा कधीही उल्लेख केला जाऊ नये.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"भूमीचे वतन मिळविण्यासाठी ते उठू नये","poem":1},{"text":"आणि त्यांच्या शहरांनी पृथ्वी व्यापली जाऊ नये,","poem":2},{"text":"म्हणून त्याच्या पूर्वजांनी केलेल्या पापांसाठी","poem":1},{"text":"त्याच्या मुलांना मारून टाकण्यासाठी जागा तयार करा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"सर्वसमर्थ याहवेह घोषित करतात,","poem":1},{"text":"“मी त्यांच्याविरुद्ध उठेन,","poem":2},{"text":"बाबेलचे नाव आणि तेथील जिवंत राहिलेले,","poem":1},{"text":"तिची संतती आणि तिच्या वंशजांना मी नामशेष करून टाकेन,”","poem":2},{"lineBreak":true},{"text":"असे याहवेह घोषित करतात.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“मी तिला घुबडांचे निवासस्थान","poem":1},{"text":"आणि दलदलीचा प्रदेश करेन;","poem":2},{"text":"मी तिला नाशाच्या झाडूने झाडून टाकेन,”","poem":1},{"text":"असे सर्वसमर्थ याहवेह घोषित करतात.","poem":2}]},{"type":"verse","number":24,"content":["सर्वसमर्थ याहवेहनी शपथ घेतली आहे,",{"text":"“निश्चितच, मी जी योजना केली आहे, तसेच होईल,","poem":1},{"text":"आणि जो माझा संकल्प आहे, त्याप्रमाणे हे घडून येईल.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"माझ्या भूमीवर मी अश्शूरांना चिरडून टाकेन;","poem":1},{"text":"त्यांना माझ्या डोंगरावर तुडवेन.","poem":2},{"text":"त्याचे जू माझ्या लोकांवरून काढून टाकेन,","poem":1},{"text":"आणि त्याचे ओझे त्यांच्या खांद्यावरून उतरवेन.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"अखिल पृथ्वीसाठी ही योजना केली आहे;","poem":1},{"text":"सर्व देशांवर हा हात फिरविला जाईल.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"सर्वसमर्थ याहवेहचा हा संकल्प आहे, तो कोण निष्फळ करू शकतो?","poem":1},{"text":"त्यांचा हात उठला आहे, त्याला कोण आवर घालू शकतो?","poem":2}]},{"type":"heading","content":["पलिष्टी लोकांविरुद्ध भविष्यवाणी"]},{"type":"verse","number":28,"content":["आहाज राजा मरण पावला त्या वर्षी हा संदेश मला प्राप्त झाला:"]},{"type":"verse","number":29,"content":[{"text":"अहो पलिष्टी लोकांनो, ज्या दांडक्याने तुम्हाला मारले","poem":1},{"text":"तो मोडला आहे म्हणून आनंद करू नका.","poem":2},{"text":"तरी त्या सापापासून फुरसे निपजेल","poem":1},{"text":"त्याचे फळ तुमचा वेध घेणारे विषारी नाग असतील.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"गरिबांतील गरिबांना कुरण सापडेल,","poem":1},{"text":"आणि गरजवंत सुरक्षितेत झोप घेतील.","poem":2},{"text":"पण तुझे मूळ दुष्काळाने नष्ट होईल;","poem":1},{"text":"ते तुझ्या अवशिष्टांचा तलवारीने नाश करतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"वेशींनो, आक्रोश करा! नगरांनो विलाप करा!","poem":1},{"text":"पलिष्टी लोकांनो, भयाने वितळून जा!","poem":2},{"text":"कारण उत्तरेकडून धुराचा लोट येत आहे,","poem":1},{"text":"त्यांच्या पलटणींत कोणीही रेंगाळणारे नाहीत.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"आता राष्ट्रांच्या राजदूतांना","poem":1},{"text":"काय उत्तर देण्यात यावे?","poem":2},{"text":"“याहवेहने सीयोन स्थापिले आहे,","poem":1},{"text":"आणि त्यांच्या पीडितांना तिच्यात आश्रय मिळेल.”","poem":2}]}],"footnotes":[{"noteId":18,"caller":"+","text":"किंवा कनानी लोकांचा पवित्र पर्वत","reference":{"chapter":14,"verse":13}}]},"thisChapterLink":"/api/mar_cbi/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/13.json","previousChapterAudioLinks":{},"numberOfVerses":32}