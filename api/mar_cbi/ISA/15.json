{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":15,"content":[{"type":"heading","content":["मोआबा विरुद्ध भविष्यवाणी"]},{"type":"verse","number":1,"content":["मोआब देशाविरुद्ध भविष्यवाणी:",{"text":"मोआब येथील आर शहर उद्ध्वस्त झाले आहे,","poem":1},{"text":"एका रात्रीत ते नष्ट झाले आहे!","poem":2},{"text":"मोआबातील कीर शहर उद्ध्वस्त झाले आहे,","poem":1},{"text":"एका रात्रीत ते नष्ट झाले आहे!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"दिबोन येथील लोक त्यांच्या उच्च स्थानावरील,","poem":1},{"text":"मंदिरात विलाप करण्यासाठी जात आहेत;","poem":2},{"lineBreak":true},{"text":"नबो आणि मेदबासाठी मोआब आक्रोश करीत आहे.","poem":2},{"text":"प्रत्येकाच्या डोक्यावरील केस","poem":1},{"text":"आणि दाढी काढलेली आहे.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"रस्त्यांवर ते गोणपाट घालतात;","poem":1},{"text":"छतावर आणि सार्वजनिक चौकांमध्ये","poem":2},{"text":"ते सर्व आक्रोश करतात,","poem":1},{"text":"विलाप करीत पालथे पडतात.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"हेशबोन आणि एलिआलेह रडतात,","poem":1},{"text":"त्यांचा आक्रोश दूरवर याहसपर्यंत ऐकू येतो.","poem":2},{"text":"म्हणून मोआबचे सशस्त्र लोक आक्रोश करतात,","poem":1},{"text":"आणि त्यांची अंतःकरणे दुर्बल झाली आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"माझे मन मोआबसाठी रडते;","poem":1},{"text":"तिचे पलायन केलेले लोक सोअरपर्यंत,","poem":2},{"lineBreak":true},{"text":"एग्लाथ-शलीशियापर्यंत पळतात.","poem":2},{"text":"ते लुहिथकडे टेकडीवर जातात,","poem":1},{"text":"जाताना ते विलाप करतात;","poem":2},{"text":"होरोनाईमच्या वाटेवर","poem":1},{"text":"ते त्यांच्या नाशासाठी विलाप करतात.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"निम्रीमचे सर्व पाणी आटून गेले आहे","poem":1},{"text":"आणि गवत करपून गेले आहे;","poem":2},{"text":"वनस्पती सुकून गेली आहे;","poem":1},{"text":"आणि हिरवळीसारखे काहीही उरले नाही.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"म्हणून त्यांनी मिळवलेली आणि साठविलेली संपत्ती","poem":1},{"text":"ते वाळुंजाच्या खोऱ्यापलीकडे घेऊन जातात.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"त्यांच्या आक्रोशाचे प्रतिध्वनी मोआबच्या सीमेपर्यंत येतात.","poem":1},{"text":"त्यांचे आक्रंदन एग्लाइमपर्यंत पोहोचते,","poem":2},{"lineBreak":true},{"text":"त्यांचा विलाप बीर एलिमपर्यंत पोहोचतो.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"दिमोनाचे पाणी रक्ताने भरलेले आहे,","poem":1},{"text":"परंतु मी दिमोनवर आणखी विपत्ती आणेन—","poem":2},{"text":"मोआबच्या पलायन केलेल्या लोकांवर","poem":1},{"text":"आणि देशातील अवशिष्ट लोकांवर मी सिंह पाठवेन.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}