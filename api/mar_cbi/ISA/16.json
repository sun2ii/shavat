{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"देशाच्या अधिपतीकडे","poem":1},{"text":"सेलापासून वाळवंटाच्या पलीकडे","poem":2},{"text":"सीयोन कन्येच्या पर्वतापर्यंत","poem":1},{"text":"खंडणी म्हणून कोकरे पाठवा.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"घरट्यातून ढकलून दिलेल्या","poem":1},{"text":"फडफडणाऱ्या पक्ष्यांप्रमाणे,","poem":2},{"text":"मोआबच्या स्त्रिया","poem":1},{"text":"आर्णोनच्या घाटावर आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"मोआब म्हणतो, “तुमच्या मनाची तयारी करा,","poem":1},{"text":"निर्णय द्या.","poem":2},{"text":"तुमची सावली रात्रीसारखी करा—","poem":1},{"text":"भर दुपारच्या वेळेसारखी.","poem":2},{"text":"पलायन केलेल्यांना लपवा,","poem":1},{"text":"शरणार्थी लोकांचा विश्वासघात करू नका.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"पलायन केलेल्या मोआबी लोकांना तुमच्याबरोबर राहू द्या;","poem":1},{"text":"संहारकापासून त्यांचा आश्रय व्हा.”","poem":2},{"lineBreak":true},{"text":"जुलूम करणाऱ्याचा शेवट होईल,","poem":1},{"text":"आणि नाश थांबेल;","poem":2},{"lineBreak":true},{"text":"आक्रमण करणारे नाहीसे होतील.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"प्रीतीने सिंहासन स्थापित केले जाईल;","poem":1},{"text":"दावीदाच्या घराण्यातील","poem":2},{"noteId":19},{"text":"एकजण,","poem":2},{"lineBreak":true},{"text":"विश्वासूपणाने त्यावर बसेल—","poem":2},{"text":"जो न्यायनिवाडा करताना न्यायाची बाजू घेतो","poem":1},{"text":"आणि धार्मिकतेची कामे जलदगतीने करतो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"मोआबाच्या अभिमानाबद्दल आम्ही ऐकले आहे—","poem":1},{"text":"तिचा अहंकार किती मोठा आहे!","poem":2},{"text":"तिची घमेंड, तिचा अभिमान आणि तिचा उर्मटपणा;","poem":1},{"text":"परंतु तिच्या सर्व फुशारक्या पोकळ आहेत.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"म्हणून मोआबी मोठ्याने रडतात,","poem":1},{"text":"मोआबसाठी ते एकत्र मोठ्याने रडतात.","poem":2},{"text":"कीर-हरेसेथचा बेदाणा किंवा मनुका मिश्रित पिठाच्या गोड ढेपांसाठी","poem":1},{"text":"विलाप आणि शोक करतात.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"हेशबोनची शेते सुकून गेली आहेत,","poem":1},{"text":"सिबमाहच्या द्राक्षवेलीसुद्धा.","poem":2},{"text":"ज्या एकवेळी याजेरपर्यंत पोहोचल्या होत्या","poem":1},{"text":"आणि वाळवंटाकडे पसरत गेल्या होत्या,","poem":2},{"text":"त्या खास निवडलेल्या द्राक्षवेली","poem":1},{"text":"इतर देशांच्या राज्यकर्त्यांनी तुडवून टाकल्या आहेत.","poem":2},{"text":"त्यांची कोंबे बाहेर पसरली","poem":1},{"text":"आणि ती समुद्रापर्यंत गेली आहेत.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"म्हणून सिबमाहच्या द्राक्षवेलींसाठी","poem":1},{"text":"याजेरसह मीही रडतो.","poem":2},{"text":"हेशबोन आणि एलिआलेह,","poem":1},{"text":"मी तुम्हाला अश्रूंनी भिजवितो!","poem":2},{"text":"तुमच्या पिकलेल्या फळांसाठी","poem":1},{"text":"आणि तुमच्या कापणीच्या आनंदाचा जयघोष शांत झाला आहे.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"फळबागेतून आनंद आणि हर्ष काढून घेतला आहे;","poem":1},{"text":"द्राक्षमळ्यात कोणीही गाणे गात नाही किंवा हर्षनाद करत नाही;","poem":2},{"text":"कोणीही द्राक्षकुंडातून द्राक्षारस काढीत नाही,","poem":1},{"text":"कारण मी हर्षनाद करणे संपवून टाकले आहे.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"माझे हृदय वीणेप्रमाणे मोआबसाठी विलाप करीत आहे,","poem":1},{"text":"कीर-हरेसेथसाठी माझे अंतःकरण विलाप करीत आहे.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"जेव्हा मोआब तिच्या उच्चस्थानी दर्शनास जाते,","poem":1},{"text":"तेव्हा ती फक्त स्वतःला थकविते;","poem":2},{"text":"जेव्हा ती तिच्या दैवतांची प्रार्थना करावयाला जाते,","poem":1},{"text":"तेव्हा त्याचा काही उपयोग होत नाही.","poem":2}]},{"type":"verse","number":13,"content":["याहवेह यांनी मोआबविरुद्ध आधीच हे वचन सांगितले आहे."]},{"type":"verse","number":14,"content":["परंतु आता याहवेह असे म्हणतात: “तीन वर्षात, कराराने बांधलेला सेवक त्यांची मोजणी करेल, मोआबचे वैभव आणि तिच्या सर्व लोकांचा तिरस्कार केला जाईल आणि तिचे अवशिष्ट लोक फारच कमी आणि दुर्बल असतील.”"]}],"footnotes":[{"noteId":19,"caller":"+","text":"किंवा डेर्‍यातून","reference":{"chapter":16,"verse":5}}]},"thisChapterLink":"/api/mar_cbi/ISA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/15.json","previousChapterAudioLinks":{},"numberOfVerses":14}