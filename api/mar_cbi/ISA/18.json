{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":18,"content":[{"type":"heading","content":["कूश18:1 किंवा इथिओपिया विरुद्ध भविष्यवाणी"]},{"type":"verse","number":1,"content":[{"text":"कूशच्या नद्यांच्या काठावर असलेल्या देशांचा,","poem":1},{"text":"जिथून पंखांचा फडफड","poem":2},{"noteId":21},{"text":"आवाज येतो त्यास धिक्कार असो.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"जो समुद्रमार्गाने पाण्यावरून","poem":1},{"text":"पापिरस नौकांमधून दूतांना पाठवितो.","poem":2},{"lineBreak":true},{"text":"जा, जलदगतीने जाणाऱ्या दूतांनो,","poem":1},{"lineBreak":true},{"text":"धिप्पाड आणि तुळतुळीत त्वचेच्या लोकांकडे जा,","poem":1},{"text":"त्यांची जबर असलेल्या दूरवरच्या लोकांकडे,","poem":2},{"text":"विक्षिप्त भाषण करणारे आक्रमक राष्ट्र,","poem":1},{"text":"ज्यांची भूमी नद्यांमुळे विभागली गेली आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"अहो तुम्ही जगातील सर्व लोकहो,","poem":1},{"text":"तुम्ही जे पृथ्वीवर राहता,","poem":2},{"text":"जेव्हा पर्वतांवर झेंडा उभारला जाईल,","poem":1},{"text":"तेव्हा तुम्हाला तो दिसेल,","poem":2},{"text":"आणि जेव्हा तुतारी वाजेल","poem":1},{"text":"तेव्हा तुम्ही ती ऐकाल.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"याहवेह मला असे म्हणतात:","poem":1},{"text":"“मी शांत राहीन आणि माझ्या निवासस्थानातून पाहीन,","poem":2},{"text":"सूर्यप्रकाशामध्ये चमकणाऱ्या उष्णतेसारखे,","poem":1},{"text":"दव असलेले ढग कापणीच्या उन्हात असल्यासारखे.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"कारण, कापणीच्या आधी, जेव्हा फुलोरा संपेल","poem":1},{"text":"आणि फुले पिकलेले द्राक्ष होतात,","poem":2},{"text":"ते छाटणीच्या सुऱ्यांनी फुटलेले कोंब कापून टाकतील,","poem":1},{"text":"आणि पसरत असलेल्या फांद्या कापून टाकतील आणि काढून टाकतील.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"डोंगरावरील हिंस्र पक्ष्यांसाठी आणि वन्यप्राण्यांसाठी,","poem":1},{"text":"भक्ष्य म्हणून त्या सर्वांना तिथेच सोडले जाईल;","poem":2},{"text":"संपूर्ण उन्हाळ्यात पक्षी त्यांचे भक्षण करतील,","poem":1},{"text":"आणि संपूर्ण हिवाळ्यात वन्यप्राणी त्यांचे भक्षण करतील.","poem":2}]},{"type":"verse","number":7,"content":["त्याकाळी सर्वसमर्थ याहवेहसाठी सीयोनातून भेटी आणल्या जातील",{"text":"धिप्पाड आणि तुळतुळीत त्वचेच्या लोकांकडून,","poem":1},{"text":"ज्यांचे भय आहे अशा दूरवरच्या लोकांकडून,","poem":2},{"text":"विक्षिप्त भाषण करणाऱ्या आक्रमक राष्ट्राकडून,","poem":1},{"text":"ज्यांची भूमी नद्यांमुळे विभागली गेली आहे.","poem":2},"अशा लोकांकडून सर्वसमर्थ याहवेह यांच्यासाठी भेटी आणल्या जातील."]}],"footnotes":[{"noteId":21,"caller":"+","text":"किंवा टोळ","reference":{"chapter":18,"verse":1}}]},"thisChapterLink":"/api/mar_cbi/ISA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/17.json","previousChapterAudioLinks":{},"numberOfVerses":7}