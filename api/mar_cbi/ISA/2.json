{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":2,"content":[{"type":"heading","content":["याहवेहचा पर्वत"]},{"type":"verse","number":1,"content":["यहूदीया व यरुशलेमविषयी आमोजाचा पुत्र यशायाहने पाहिलेला दृष्टान्त:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["पण शेवटच्या दिवसात",{"text":"याहवेहच्या मंदिराचे पर्वत बळकट व उंच","poem":1},{"text":"असे स्थापित केले जाईल;","poem":2},{"text":"सर्व पर्वतांपेक्षा ते उंचावले जाईल,","poem":1},{"text":"आणि सर्व राष्ट्रे त्याकडे एकत्र येतील.","poem":2}]},{"type":"verse","number":3,"content":["अनेक लोक येतील आणि म्हणतील,",{"text":"“चला, आपण याहवेहच्या पर्वताकडे,","poem":1},{"text":"याकोबाच्या परमेश्वराच्या मंदिराला जाऊ.","poem":2},{"text":"ते आपले मार्ग आम्हाला शिकवतील,","poem":1},{"text":"म्हणजे आम्ही त्या मार्गावर चालू.”","poem":2},{"text":"कारण सीयोनमधून नियमशास्त्र,","poem":1},{"text":"यरुशलेमातून याहवेहचे वचन बाहेर जाईल.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ते राष्ट्रांमध्ये न्याय करतील,","poem":1},{"text":"आणि अनेक लोकांमधील वाद मिटवतील.","poem":2},{"text":"ते आपल्या तलवारी ठोकून त्यांचे नांगराचे फाळ करतील,","poem":1},{"text":"व भाल्यांचे आकडे बनवतील.","poem":2},{"text":"एक देश दुसऱ्या देशाविरुद्ध तलवार उगारणार नाही,","poem":1},{"text":"तसेच ते यापुढे लष्करी प्रशिक्षण देणार नाहीत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"याकोबाच्या वंशजा ये,","poem":1},{"text":"आपण याहवेहच्या प्रकाशात चालू.","poem":2}]},{"type":"heading","content":["याहवेहचा दिवस"]},{"type":"verse","number":6,"content":[{"text":"याहवेह, तुम्ही याकोबाच्या वंशजाचा","poem":1},{"text":"तुमच्या लोकांचा त्याग केला आहे,","poem":2},{"text":"ते पूर्वेकडील अंधश्रद्धेने भरून गेलेले आहेत;","poem":1},{"text":"पलिष्टी लोकांप्रमाणे ते दुरात्म्यांशी संपर्क साधतात","poem":2},{"lineBreak":true},{"text":"आणि मूर्तिपूजकांच्या रूढी त्यांनी स्वीकारल्या आहेत.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"त्यांची भूमी चांदी आणि सोन्याने भरून गेली आहे;","poem":1},{"text":"त्यांची संपत्ती अमाप आहे. चांदी व सोने यांचे अमाप खजिने आहेत.","poem":2},{"text":"त्यांच्या भूमीत असंख्य घोडे आहेत;","poem":1},{"text":"त्यांच्याकडे असंख्य रथही आहेत.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"सर्व भूमी मूर्तीनी भरली आहे;","poem":1},{"text":"त्यांच्याच हस्तकृतींनी,","poem":2},{"lineBreak":true},{"text":"जे त्यांच्या बोटांनी बनविले आहे, त्याला ते नमन करतात.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"म्हणून या लोकांचे पतन केले जाईल","poem":1},{"text":"आणि सर्वजण नमविले जातील—","poem":2},{"lineBreak":true},{"text":"त्यांना क्षमा करू नका.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"याहवेहच्या भयावह सान्निध्यापासून","poem":1},{"text":"आणि गौरवी प्रतापापासून वाचण्यास","poem":2},{"lineBreak":true},{"text":"कड्याकपारीत जा, जमिनीत लपून बसा!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"उन्मताची नजर नमविली जाईल,","poem":1},{"text":"आणि मनुष्याचा गर्व उतरविला जाईल;","poem":2},{"text":"त्या दिवशी याहवेह एकटेच गौरविले जातील.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"गर्विष्ठ आणि उद्धट लोकांना,","poem":1},{"text":"जे सर्वकाही उच्च करण्यात आले आहे","poem":2},{"text":"त्यांना नम्र करण्यासाठी,","poem":1},{"text":"सर्वसमर्थ याहवेहने एक दिवस निर्धारित केला आहे—","poem":2}]},{"type":"verse","number":13,"content":[{"text":"लबानोनाचे सर्व उंच व भव्य गंधसरू","poem":1},{"text":"आणि बाशान येथील एलावृक्ष,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"उंच उंच पर्वत","poem":1},{"text":"आणि सर्व उंच डोंगर,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"प्रत्येक भव्य बुरूज,","poem":1},{"text":"प्रत्येक तटबंदीची भिंत,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"तार्शीशमधील प्रत्येक व्यापारी गलबत","poem":1},{"noteId":2},{"text":"आणि बंदरातील डौलदार जहाजे, त्या दिवशी सर्व नष्ट होतील.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"मनुष्याचा सर्व अहंकार नमविला जाईल","poem":1},{"text":"आणि मनुष्याचा गर्व खाली करण्यात येईल;","poem":2},{"text":"त्या दिवशी याहवेह एकटेच गौरविले जातील.","poem":1}]},{"type":"verse","number":18,"content":[{"text":"सर्व मूर्तीचा समूळ उच्छेद होईल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"जेव्हा याहवेह पृथ्वीला हलविण्यासाठी उभे राहतील","poem":1},{"text":"तेव्हा त्यांच्या भयावह सान्निध्यापासून","poem":2},{"text":"आणि गौरवी प्रतापापासून वाचण्यास","poem":1},{"text":"लोक खडकांच्या गुहांकडे धाव घेतील","poem":2},{"lineBreak":true},{"text":"आणि जमिनीतील खाचात लपतील.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"त्या दिवशी लोक","poem":1},{"text":"उपासना करण्यासाठी त्यांनी घडविलेल्या","poem":2},{"text":"त्यांच्या चांदी व सोन्याच्या मूर्ती","poem":1},{"text":"चिचुंद्र्या आणि वटवाघळे यांच्यापुढे फेकून देतील.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"जेव्हा याहवेह पृथ्वीला हलविण्यासाठी उभे राहतील","poem":1},{"text":"तेव्हा त्यांच्या भयावह सान्निध्यापासून","poem":2},{"text":"आणि गौरवी प्रतापापासून वाचण्यास","poem":1},{"text":"लोक खडकांच्या गुहांकडे धाव घेतील","poem":2},{"lineBreak":true},{"text":"डोंगराच्या लटकत्या कडांमध्ये लपतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"मर्त्य मनुष्यांवर भरवसा करणे बंद कर","poem":1},{"text":"ज्यांच्या नाकामध्ये केवळ एक श्वासच आहे.","poem":2},{"lineBreak":true},{"text":"त्यांना इतका बहुमान का द्यावा?","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"किंवा तार्शीशचे गलबत","reference":{"chapter":2,"verse":16}}]},"thisChapterLink":"/api/mar_cbi/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}