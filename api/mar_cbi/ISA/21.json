{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":21,"content":[{"type":"heading","content":["बाबेलविरुद्ध भविष्यवाणी"]},{"type":"verse","number":1,"content":["समुद्राकाठी असलेल्या वाळवंटी प्रदेशाविरुद्ध भविष्यवाणी:",{"text":"ज्याप्रकारे वावटळ दक्षिणेकडील प्रदेशांना झाडून जाते,","poem":1},{"text":"त्याच प्रकारे हल्ला करणारा वाळवंटी प्रदेशातून,","poem":2},{"lineBreak":true},{"text":"दहशती भूमीमधून येतो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"एक भयानक दृष्टान्त मला दाखविण्यात आला आहे:","poem":1},{"text":"देशद्रोही विश्वासघात करतो, लूट करणारा लूट घेतो.","poem":2},{"text":"हे एलाम, आक्रमण करा! मेदिया, वेढा घाला!","poem":1},{"text":"तिने दिलेले दुःखाचे सर्व विव्हळणे मी संपवून टाकेन.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"यामुळे माझ्या शरीराला यातनेने दुखविले आहे,","poem":1},{"text":"प्रसूत स्त्रीच्या वेदनांप्रमाणे मला वेदनांनी घेरले आहे.","poem":2},{"text":"जे काही मी ऐकतो, त्यामुळे मी लटपटून जातो,","poem":1},{"text":"मी जे काही पाहतो, त्यामुळे मी भांबावून जातो.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"माझे अंतःकरण अडखळते,","poem":1},{"text":"भीती मला थरथर कापविते;","poem":2},{"text":"ज्या संध्याकाळची मी आतुरतेने वाट पाहत असे","poem":1},{"text":"ती माझ्यासाठी भयप्रद अशी झाली आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ते मेजावर भोजनाची तयारी करतात,","poem":1},{"text":"ते गालिचे पसरवितात,","poem":2},{"lineBreak":true},{"text":"ते खातात, ते पितात!","poem":2},{"text":"अहो, अधिकारी, तुम्ही आता उठा,","poem":1},{"text":"ढालींना तेल लावा!","poem":2}]},{"type":"verse","number":6,"content":["प्रभू मला असे म्हणत आहेत:",{"text":"“जा, टेहळणी करणारा उभा कर,","poem":1},{"text":"आणि त्याला जे काही दिसते ते त्याने कळवावे.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"जेव्हा तो रथांना","poem":1},{"text":"घोड्यांच्या ताफ्यासहीत,","poem":2},{"text":"आणि गाढवावर स्वार असलेले","poem":1},{"text":"किंवा उंटावर स्वार असलेले पाहतो,","poem":2},{"text":"तेव्हा त्याने सावध राहावे,","poem":1},{"text":"पूर्णपणे सावध राहावे.”","poem":2}]},{"type":"verse","number":8,"content":["त्याप्रमाणे तटावर ठेवलेला पहारेकरी सिंहगर्जना करीत ओरडला,",{"text":"“महाराज, मी दिवसेंदिवस,","poem":1},{"text":"रात्रीच्या रात्री येथे पहारा करीत राहिलो.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"पाहा, एक मनुष्य रथात स्वार होऊन","poem":1},{"text":"घोड्याच्या ताफ्याबरोबर इकडे येत आहे.","poem":2},{"text":"आणि तो प्रत्युत्तर देत आहे:","poem":1},{"text":"‘बाबेल पडले आहे, ते पडले आहे!","poem":2},{"text":"तिथे असलेल्या तिच्या दैवतांच्या","poem":1},{"text":"सर्व मूर्तींचे तुकडे होऊन जमिनीवर पडले आहेत!’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"माझे लोक जे खळ्यावर चिरडले गेले आहेत,","poem":1},{"text":"इस्राएलचे परमेश्वर,","poem":2},{"text":"सर्वसमर्थ याहवेह यांच्याकडून,","poem":1},{"text":"मी जे ऐकले आहे ते मी तुम्हाला सांगतो.","poem":2}]},{"type":"heading","content":["एदोमविरुद्ध भविष्यवाणी"]},{"type":"verse","number":11,"content":["दूमाह",{"noteId":24},"विरुद्ध एक भविष्यवाणी:",{"text":"सेईरमधून कोणीतरी मला हाक मारत आहे,","poem":1},{"text":"“रखवालदार, रात्र संपण्यास किती वेळ उरला आहे?","poem":2},{"lineBreak":true},{"text":"रखवालदार, रात्र संपण्यास किती वेळ उरला आहे?”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"पहारेकरी उत्तर देतो,","poem":1},{"text":"“सकाळ होत आहे, पण रात्रही आली आहे.","poem":2},{"text":"जर तुम्हाला विचारणा करावयाची आहे, तर मला विचारा;","poem":1},{"text":"आणि मग पुन्हा या.”","poem":2}]},{"type":"heading","content":["अरेबियाविरुद्ध भविष्यवाणी"]},{"type":"verse","number":13,"content":["अरेबियाविरुद्ध भविष्यवाणी:",{"text":"ददानी काफिल्यांनो,","poem":1},{"text":"तुम्ही जे अरेबियाच्या अरण्यात वसती करता,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"तुम्ही, तेमा येथे राहणाऱ्यांनो,","poem":2},{"text":"तहानलेल्यांसाठी पाणी घेऊन या;","poem":1},{"text":"पलायन केलेल्यांसाठी अन्न घेऊन या.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ते तलवारीपासून पळतात","poem":1},{"text":"म्यानातून उपसलेल्या तलवारीपासून ते पळतात,","poem":2},{"text":"वाकवून नेम धरलेल्या धनुष्यापासून","poem":1},{"text":"आणि युद्धाच्या कठोरतेपासून पळतात.","poem":2}]},{"type":"verse","number":16,"content":["प्रभू मला असे म्हणतात: “एका वर्षाच्या आत, कराराने बांधलेला सेवक जसे एकएक दिवस मोजत असतो, तसे केदारचे सर्व वैभव नाहीसे होईल."]},{"type":"verse","number":17,"content":["केदारचे वाचलेले धनुर्धारी, योद्धे थोडेच असतील.” इस्राएलचे परमेश्वर, याहवेह असे बोलले आहेत."]}],"footnotes":[{"noteId":24,"caller":"+","text":"किंवा एदोम म्हणजे शांतता किंवा स्तब्धता","reference":{"chapter":21,"verse":11}}]},"thisChapterLink":"/api/mar_cbi/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}