{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":23,"content":[{"type":"heading","content":["सोरविरुद्ध भविष्यवाणी"]},{"type":"verse","number":1,"content":["सोरविरुद्ध भविष्यवाणी:",{"text":"तार्शीशच्या जहाजांनो, विलाप करा!","poem":1},{"text":"कारण सोरचा नाश झाला आहे","poem":2},{"lineBreak":true},{"text":"आणि तिथे घर किंवा बंदर असे काहीच राहिले नाही.","poem":2},{"text":"कित्तीम","poem":1},{"noteId":26},{"text":"देशाकडून","poem":1},{"text":"हे वचन त्यांच्याकडे आले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"तुम्ही बेटावरील रहिवाशांनो,","poem":1},{"text":"आणि तुम्ही सीदोनचे व्यापारी,","poem":2},{"lineBreak":true},{"text":"ज्यांना खलाश्यांनी श्रीमंत केले आहे, शांत राहा.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"प्रचंड जलाशयावरून","poem":1},{"text":"शिहोरचे धान्य आले;","poem":2},{"text":"नाईल नदीकाठापासून कापणी केलेले पीक हे सोरचे उत्पन्न होते,","poem":1},{"text":"आणि ती राष्ट्रांची बाजारपेठ झाली.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"सीदोन आणि समुद्रातील किल्ल्यांनो, लज्जित व्हा,","poem":1},{"text":"कारण समुद्र म्हणाला:","poem":2},{"text":"“मला कधीही बाळंतपणाच्या वेदना झाल्या नाहीत आणि मी कधीही प्रसवलो नाही;","poem":1},{"text":"मी कधीही मुलांचे संगोपन केले नाही किंवा मुलींचा सांभाळ केला नाही.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"जेव्हा इजिप्तकडे निरोप येतो,","poem":1},{"text":"तेव्हा सोरकडून आलेल्या वृत्ताने ते कासावीस होतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"तार्शीश ओलांडून पलीकडे जा;","poem":1},{"text":"बेटावरील लोकहो, आक्रोश करा.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ही तुमची रंगेलपणाची नगरी आहे काय,","poem":1},{"text":"फार जुने, पुरातन नगर,","poem":2},{"text":"जिच्या पायांनी तिला फार दूर असलेल्या प्रदेशात","poem":1},{"text":"स्थायिक होण्यासाठी नेले आहे?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"सोरच्या विरोधात अशी योजना कोणी केली आहे,","poem":1},{"text":"मुकुटाचा बहुमान प्रदान करणारे,","poem":2},{"text":"ज्यांचे व्यापारी राजकुमार आहेत,","poem":1},{"text":"ज्यांचे व्यापारी पृथ्वीवरील प्रसिद्ध लोक आहेत?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"सर्वसमर्थ याहवेहनी ती योजना केली आहे,","poem":1},{"text":"तिच्या सर्व वैभवाचा गर्व कमी करण्यासाठी","poem":2},{"lineBreak":true},{"text":"आणि पृथ्वीवर नामांकित असलेल्या सर्वांना नम्र करण्यासाठी.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"तार्शीश मुली,","poem":1},{"text":"नाईल नदीच्या काठाने तुमच्या जमिनीची मशागत करा,","poem":2},{"lineBreak":true},{"text":"कारण आता तुमच्याकडे बंदर राहणार नाही.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"याहवेहनी त्यांचा हात समुद्रापलीकडे लांबविला आहे,","poem":1},{"text":"आणि तिच्या राज्यांना थरकाप आणला आहे.","poem":2},{"text":"त्यांनी कनानच्या","poem":1},{"noteId":27},{"text":"संदर्भात आदेश दिले आहेत की,","poem":1},{"text":"तिचे किल्ले नष्ट केले जावे.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ते म्हणाले, “कुमारिके सीदोन,","poem":1},{"text":"यापुढे तुझी चैनबाजी चालणार नाही. आता तू चिरडली जावी!","poem":2},{"lineBreak":true},{"text":"“वर कित्तीम पलीकडे गेलात;","poem":1},{"text":"तर तिथेही तुम्हाला विश्रांती मिळणार नाही.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"खास्द्यांच्या भूमीकडे बघा","poem":1},{"text":"या लोकांचे आता काहीही महत्त्व राहिले नाही!","poem":2},{"text":"अश्शूर लोकांनी","poem":1},{"text":"ते वाळवंटातील श्वापदांसाठी एक ठिकाण केले आहे;","poem":2},{"text":"त्यांनी त्यांचे वेढा बुरूज उभारले,","poem":1},{"text":"त्यांनी त्याचे मोठे किल्ले पाडले","poem":2},{"lineBreak":true},{"text":"आणि त्याचे भग्नावशेष केले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"तार्शीशच्या जहाजांनो, विलाप करा;","poem":1},{"text":"तुमचा किल्ला नष्ट झाला आहे!","poem":2}]},{"type":"verse","number":15,"content":["त्यावेळी एका राजाच्या आयुष्याचा कालावधी, म्हणजे सत्तर वर्षे, सोर विसरला जाईल. परंतु या सत्तर वर्षांच्या शेवटी, वेश्येच्या गाण्याप्रमाणे सोरचे होईल:"]},{"type":"verse","number":16,"content":[{"text":"“वीणा हाती घे, शहरामधून फीर,","poem":1},{"text":"तू विसरून गेलेली वेश्या;","poem":2},{"text":"वीणा चांगली वाजव, पुष्कळ गाणी गा,","poem":1},{"text":"म्हणजे तुझी आठवण होत राहील.”","poem":2}]},{"type":"verse","number":17,"content":["सत्तर वर्षांच्या शेवटी, याहवेह सोरबरोबर व्यवहार करतील. ती तिच्या फायदेशीर वेश्याव्यवसायाकडे परत येईल आणि पृथ्वीतलावरील सर्व राज्यांबरोबर तिचा व्यापार करेल."]},{"type":"verse","number":18,"content":["तरीसुद्धा तिचा नफा आणि तिचे उत्पन्न याहवेहसाठी वेगळे ठेवले जाईल; ते साठविले जाणार नाही किंवा त्याचा गुप्तसंचय केला जाणार नाही. तिचा फायदा याहवेहसमोर जे राहतात त्यांना भरपूर अन्न आणि उत्तम कपडे मिळावे यासाठी त्यांच्याकडे जाईल."]}],"footnotes":[{"noteId":26,"caller":"+","text":"किंवा सध्याच्या काळात ज्याला सायप्रस म्हणून ओळखले जाते","reference":{"chapter":23,"verse":1}},{"noteId":27,"caller":"+","text":"फोनेशीया","reference":{"chapter":23,"verse":11}}]},"thisChapterLink":"/api/mar_cbi/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}