{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":24,"content":[{"type":"heading","content":["याहवेहकडून केला जाणारा पृथ्वीचा विध्वंस"]},{"type":"verse","number":1,"content":[{"text":"पाहा, याहवेह पृथ्वीचा नाश करणार आहेत","poem":1},{"text":"आणि ती उद्ध्वस्त करणार आहेत;","poem":2},{"text":"ते तिचा चेहरा बिघडवून टाकतील","poem":1},{"text":"आणि तेथील रहिवाशांची पांगापांग करतील—","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ते प्रत्येकासाठी समान असेल,","poem":1},{"text":"जसे लोकांसाठी तसेच याजकासाठी","poem":2},{"lineBreak":true},{"text":"जसे सेवकासाठी तसेच त्याच्या मालकासाठी","poem":2},{"lineBreak":true},{"text":"जसे सेविकेसाठी तसेच तिच्या मालकिणीसाठी,","poem":2},{"lineBreak":true},{"text":"जसे खरेदी करणाऱ्यांसाठी तसेच विकत घेणाऱ्यांसाठी,","poem":2},{"lineBreak":true},{"text":"जसे उसने देणाऱ्यासाठी तसेच उसने घेणाऱ्यासाठी,","poem":2},{"lineBreak":true},{"text":"जसे कर्जदारांसाठी तसेच कर्जदात्यांसाठी.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"पृथ्वी पूर्णपणे पडीक जमीन होईल","poem":1},{"text":"आणि संपूर्णपणे लुटली जाईल.","poem":2},{"text":"हे शब्द याहवेह बोलले आहेत.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"पृथ्वी सुकते आणि कोमेजून जाते,","poem":1},{"text":"जग खंगून जाते आणि सुकून जाते,","poem":2},{"lineBreak":true},{"text":"आकाश पृथ्वीबरोबर झुरत राहते.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"पृथ्वीला तिच्या लोकांनी भ्रष्ट केले आहे.","poem":1},{"text":"त्यांनी नियमांचे उल्लंघन केले आहे,","poem":2},{"text":"कायदे भंग केले आहेत","poem":1},{"text":"आणि अनंतकाळाचा करार मोडला आहे!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"म्हणून शाप पृथ्वीला भस्मसात करतो.","poem":1},{"text":"तिच्या लोकांना त्यांच्या दोषाचे परिणाम भोगावे लागतील.","poem":2},{"text":"त्यामुळे पृथ्वीचे रहिवासी जळून गेले आहेत,","poem":1},{"text":"आणि फारच थोडे उरले आहेत.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"नवा द्राक्षारस सुकतो आणि द्राक्षवेल कोमेजून जाते.","poem":1},{"text":"आनंद करणारे सर्वजण विव्हळतात.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"आनंददायक ढोलकी शांत झाली आहे,","poem":1},{"text":"हर्षोल्हास करणार्‍यांचा आवाज थांबला आहे,","poem":2},{"lineBreak":true},{"text":"आनंद करणारी वीणा शांत आहे.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"गाणी म्हणत मद्यपान करणे बंद पडले आहे!","poem":1},{"text":"मद्याचा घोट मद्यपीला कडू लागतो!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"उद्ध्वस्त नगरी निर्जन झाली आहे;","poem":1},{"text":"प्रत्येक घराचे प्रवेशद्वार बंद करण्यात आले आहे.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"रस्त्यावर ते मद्यासाठी आरडाओरडा करीत आहेत;","poem":1},{"text":"सगळा आनंद दुःखात बदलला आहे,","poem":2},{"lineBreak":true},{"text":"हर्षोल्हासाचे स्वर पृथ्वीवरून नाहीसे झाले आहेत!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"नगर उद्ध्वस्त झाले आहे,","poem":1},{"text":"त्याच्या वेशी तोडून त्यांचे तुकडे करण्यात आले आहेत.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"जसे जैतून वृक्ष झाडल्यानंतर","poem":1},{"text":"किंवा द्राक्ष गोळा करून द्राक्षाचा हंगाम संपल्यानंतर उरलले राहतात,","poem":2},{"text":"तशी देशांची अवस्था होईल,","poem":1},{"text":"तशी या पृथ्वीची अवस्था होईल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ते हर्षाने आरोळ्या मारतील; आनंदाने गजर करतील,","poem":1},{"text":"पश्चिमेकडून ते याहवेहच्या ऐश्वर्याची स्तुती करतील.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"म्हणून पूर्वेकडे याहवेहचा गौरव करा;","poem":1},{"text":"समुद्राच्या बेटांवर,","poem":2},{"lineBreak":true},{"text":"इस्राएलचे परमेश्वर याहवेहच्या नावाचा गौरव करा.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"पृथ्वीच्या दिगंतापासून आपण हे गाणे ऐकतो:","poem":1},{"text":"“नीतिमान परमेश्वराचा गौरव असो.”","poem":2},{"lineBreak":true},{"text":"पण मी म्हणालो, “माझा नाश होत आहे, माझा नाश होत आहे!","poem":1},{"text":"माझा धिक्कार असो!","poem":2},{"text":"फसवणूक करणारा विश्वासघात करतो!","poem":1},{"text":"फसवणूक करून तो विश्वासघात करतो!”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"पृथ्वीवरील सर्व लोकांनो,","poem":1},{"text":"तुमच्या वाट्याला दहशत, खड्डा व सापळा येणार आहे!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"भीतीने तुम्ही पळ काढण्याचा प्रयत्न कराल,","poem":1},{"text":"तर खड्ड्यात पडाल;","poem":2},{"text":"खड्ड्यातून कसेबसे बाहेर पडाल,","poem":1},{"text":"तर तुम्ही सापळ्यात अडकाल,","poem":2},{"lineBreak":true},{"text":"कारण आकाशाचे धरणद्वार उघडण्यात आले आहे,","poem":1},{"text":"पृथ्वीचा पाया हादरला आहे.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"पृथ्वीचे तुकडे झाले आहेत,","poem":1},{"text":"पृथ्वी पूर्ण फाटून गेली आहे,","poem":2},{"lineBreak":true},{"text":"पृथ्वीला जबरदस्त हादरा मिळाला आहे.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"पृथ्वी मद्यपीसारखी झोकांड्या खात आहे.","poem":1},{"text":"वादळात झोपडी हेलकावे खाते, तशी ती हेलकावे खात आहे;","poem":2},{"text":"कारण तिच्या बंडखोरपणाचे ओझे अत्यंत जड झाले आहे,","poem":1},{"text":"ती अशी कोसळेल—कि पुन्हा उठणार नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"त्या दिवशी याहवेह,","poem":1},{"text":"वर आकाशातील अधिपतींना","poem":2},{"lineBreak":true},{"text":"आणि खाली पृथ्वीवरील राजांना शिक्षा करतील.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"त्यांना एकत्र गोळा करण्यात येईल","poem":1},{"text":"आणि कैद्यांसारखे त्यांना अंधारकोठडीत टाकण्यात येईल;","poem":2},{"text":"त्यांना कारागृहात कोंडून ठेवण्यात येईल.","poem":1},{"text":"आणि त्यांना अनेक दिवसांकरिता शिक्षा देण्यात येईल.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"चंद्राची त्रेधा उडेल,","poem":1},{"text":"सूर्य लज्जित होईल;","poem":2},{"text":"कारण सर्वसमर्थ याहवेह वैभवाने","poem":1},{"text":"सीयोन पर्वतावर आणि यरुशलेममध्ये,","poem":2},{"lineBreak":true},{"text":"आणि आपल्या वडीलजनांसमोर—गौरवाने राज्य करतील.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}