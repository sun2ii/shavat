{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":25,"content":[{"type":"heading","content":["याहवेहचे स्तवनगीत"]},{"type":"verse","number":1,"content":[{"text":"याहवेह तुम्ही माझे परमेश्वर आहात;","poem":1},{"text":"मी तुम्हाला उंचावेन आणि तुमच्या नावाची स्तुती करेन,","poem":2},{"text":"कारण परिपूर्ण विश्वासूपणाने","poem":1},{"text":"तुम्ही अद्भुत गोष्टी केल्या आहेत,","poem":2},{"lineBreak":true},{"text":"ज्या फार पूर्वीपासून योजलेल्या होत्या.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तुम्ही शहराला दगडविटांच्या तुकड्यांचा ढीग बनविले,","poem":1},{"text":"तटबंदी असलेले नगर उद्ध्वस्त केले,","poem":2},{"text":"परकियांचे किल्ले आता नगर म्हणून अस्तित्वात नाहीत.","poem":1},{"text":"ते परत कधीही बांधले जाणार नाही.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"म्हणून बलवान लोक तुमचा सन्मान करतील;","poem":1},{"text":"निर्दयी राष्ट्रांची नगरे तुमचा आदर करतील.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तुम्ही गरिबांसाठी आश्रयस्थान असे आहात,","poem":1},{"text":"गरजवंतासाठी त्यांच्या संकटातील आश्रयस्थान आहात,","poem":2},{"text":"वादळामध्ये निवारा आहात","poem":1},{"text":"आणि उष्णतेमध्ये सावली आहात.","poem":2},{"text":"कारण निर्दयी लोकांचा श्वास","poem":1},{"text":"हा भिंतीवर चालून येणाऱ्या वादळासारखा आहे,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"आणि वाळवंटातील उष्णतेसारखा.","poem":2},{"text":"परदेश्यांची गर्जना तुम्ही शांत करता;","poem":1},{"text":"जशी ढगाच्या सावलीने उष्णता कमी होते,","poem":2},{"lineBreak":true},{"text":"तसे निर्दयी लोकांचे हर्षगीत शांत होते.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"या डोंगरावर सर्वशक्तिमान याहवेह","poem":1},{"text":"सर्व लोकांसाठी उत्तम अन्नाच्या मेजवानीची तयारी करतील,","poem":2},{"text":"जुन्या द्राक्षारसाची मेजवानी—","poem":1},{"text":"सर्वोत्तम मांस आणि सर्वोत्कृष्ट द्राक्षारस.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"जे आच्छादन सर्व लोकांना आच्छादून टाकते,","poem":1},{"text":"चादर जी सर्व राष्ट्रांना झाकते,","poem":2},{"text":"या पर्वतावर याहवेह तिचा नाश करतील;","poem":1}]},{"type":"verse","number":8,"content":[{"text":"सर्वकाळासाठी ते मृत्यूला गिळून टाकतील.","poem":2},{"text":"सार्वभौम याहवेह सर्वांच्या चेहऱ्यावरील","poem":1},{"text":"अश्रू पुसून टाकतील;","poem":2},{"text":"ते त्यांच्या लोकांची अप्रतिष्ठा","poem":1},{"text":"सर्व पृथ्वीवरून काढून टाकतील.","poem":2},{"text":"याहवेह असे बोलले आहेत.","poem":1}]},{"type":"verse","number":9,"content":["त्या दिवशी लोक असे म्हणतील,",{"text":"“निश्चितच, हे आमचे परमेश्वर आहेत;","poem":1},{"text":"आम्ही त्यांच्यावर विश्वास ठेवला आणि त्यांनी आम्हाला वाचविले.","poem":2},{"text":"हे याहवेह आहेत, आम्ही ज्यांच्यावर विश्वास ठेवला;","poem":1},{"text":"चला आपण त्यांच्या तारणात आनंद आणि हर्षोल्हास करू या.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"याहवेहचा हात या पर्वतावर राहील;","poem":1},{"text":"परंतु जसे कडबा खतामध्ये तुडविला जातो,","poem":2},{"lineBreak":true},{"text":"तसे मोआबी त्यांच्या भूमीत तुडविले जातील.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"जसे पोहणारे पोहण्यासाठी त्यांचे हात लांब करतात","poem":1},{"text":"तसे ते त्यांचे हात त्यांच्यावर लांब करतील.","poem":2},{"text":"त्यांच्या हातात चतुराई असतानाही","poem":1},{"text":"परमेश्वर त्यांचा अभिमान उतरवून टाकतील.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ते तुमच्या तटबंदीच्या उंच भिंती खाली पाडतील","poem":1},{"text":"आणि त्या खाली येतील;","poem":2},{"text":"ते त्यांना खाली जमिनीवर आणून,","poem":1},{"text":"पूर्ण धुळीत मिळवतील.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/ISA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}