{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":27,"content":[{"type":"heading","content":["इस्राएलची मुक्तता"]},{"type":"verse","number":1,"content":["त्या दिवशी,",{"text":"याहवेह त्यांच्या तलवारीने शिक्षा करतील—","poem":1},{"text":"त्यांची हिंसक, मोठी आणि शक्तिशाली तलवार—","poem":2},{"text":"लिव्याथान सरपटणारा सर्प,","poem":1},{"text":"गुंडाळून घेणारा सर्प लिव्हियाथान;","poem":2},{"text":"ते समुद्रातील या राक्षसाचा वध करतील.","poem":1}]},{"type":"verse","number":2,"content":["त्या दिवशी—",{"text":"“फलवंत द्राक्षमळ्याबद्दल गीत गा:","poem":1}]},{"type":"verse","number":3,"content":[{"text":"मी, याहवेह, त्यावर लक्ष ठेवतो;","poem":2},{"lineBreak":true},{"text":"मी त्याला सतत पाणी देतो.","poem":2},{"text":"मी रात्रंदिवस त्याचे रक्षण करतो","poem":1},{"text":"जेणेकरून कोणीही त्याला इजा करणार नाही.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"मी रागावलेलो नाही.","poem":2},{"text":"परंतु जर माझ्यासमोर काटेरी झुडपे आणि काटे आले तर!","poem":1},{"text":"मी त्यांच्यावर हल्ला करून युद्ध केले असते;","poem":2},{"lineBreak":true},{"text":"मी त्या सर्वांना आग लावली असती.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"नाहीतर त्यांना माझ्याकडे आश्रय घेण्यासाठी येऊ द्या;","poem":1},{"text":"त्यांनी माझ्याबरोबर सलोखा करावा,","poem":2},{"lineBreak":true},{"text":"होय, त्यांनी माझ्याबरोबर सलोखा करावा.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"येणाऱ्या दिवसात याकोब मूळ धरेल,","poem":1},{"text":"इस्राएलला अंकुर फुटेल आणि ती बहरेल","poem":2},{"lineBreak":true},{"text":"आणि सर्व जगास फळांनी भरेल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"याहवेहनी तिच्यावर","poem":1},{"noteId":29},{"text":"हल्ला केला आहे का,","poem":1},{"text":"ज्यांनी तिच्यावर हल्ला केला, तिच्यावर याहवेहने हल्ला केला होता का?","poem":2},{"text":"तिला मारण्यात आले आहे का,","poem":1},{"text":"ज्यांनी तिला मारले, त्यांना मारण्यात आले आहे का?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"रणनीती आणि बंदिवास करून तुम्ही तिच्याबरोबर वाद घालता—","poem":1},{"text":"जसे एखाद्या दिवशी पूर्वेचा वारा वाहतो,","poem":2},{"lineBreak":true},{"text":"तसे त्यांच्या हिंसक स्फोटाने ते तिला घालवून देतात.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तेव्हा याप्रकारे याकोबाच्या अपराधाचे प्रायश्चित्त होईल,","poem":1},{"text":"आणि त्याचे पाप काढून टाकल्याचे हे पूर्ण फळ असेल:","poem":2},{"text":"जेव्हा ते वेदीच्या सर्व दगडाचे","poem":1},{"text":"चुनखडीसारखे चूर्ण करतील.","poem":2},{"text":"अशेरा दैवतेचे स्तंभ किंवा धूपवेद्या","poem":1},{"text":"तशाच उभ्या सोडतील.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तटबंदीचे शहर उजाड झाले आहे,","poem":1},{"text":"टाकून दिलेले आवास, टाकून दिलेल्या अरण्यासारखी आहे;","poem":2},{"text":"तिथे वासरे चरतात,","poem":1},{"text":"तिथे ती झोपतात,","poem":2},{"lineBreak":true},{"text":"ते त्याच्या फांद्या खाऊन निष्पर्ण करतात.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"जेव्हा झाडाच्या फांद्या वाळून शुष्क होतात व मोडतात","poem":1},{"text":"आणि स्त्रिया येतात व ते सरपण म्हणून जाळतात.","poem":2},{"text":"तसे हे लोक असमंजस आहेत;","poem":1},{"text":"म्हणून त्यांना घडविणाऱ्याला त्यांची दया येत नाही","poem":2},{"lineBreak":true},{"text":"आणि त्यांचा निर्माणकर्ता त्यांच्यावर कृपा करीत नाही.","poem":2}]},{"type":"verse","number":12,"content":["त्या दिवशी याहवेह वाहत्या फरात नदीपासून इजिप्तच्या खोऱ्यापर्यंत मळणी करतील आणि तुम्ही, इस्राएल एकएक करून गोळा केले जाल."]},{"type":"verse","number":13,"content":["आणि त्या दिवशी मोठा कर्णा वाजू लागेल. ज्यांचा अश्शूरमध्ये नाश होत होता आणि जे इजिप्तमध्ये बंदिवासात गेले होते, ते येतील आणि यरुशलेममधील पवित्र पर्वतावर याहवेहची उपासना करतील."]}],"footnotes":[{"noteId":29,"caller":"+","text":"इस्राएलवर","reference":{"chapter":27,"verse":7}}]},"thisChapterLink":"/api/mar_cbi/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}