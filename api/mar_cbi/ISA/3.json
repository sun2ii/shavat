{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":3,"content":[{"type":"heading","content":["यहूदीया व यरुशलेम यांचा न्याय"]},{"type":"verse","number":1,"content":[{"text":"आता बघा, प्रभू","poem":1},{"text":"सर्वसमर्थ याहवेह","poem":2},{"text":"यरुशलेम व यहूदीयाचा","poem":1},{"text":"अन्नपुरवठा आणि पाठिंबा दोन्हीही बंद करणार आहेत—","poem":2},{"text":"सर्व अन्नाचा पुरवठा आणि पाण्याचा पुरवठा,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"वीर योद्धे तथा सैनिक,","poem":2},{"text":"न्यायाधीश आणि संदेष्टे,","poem":1},{"text":"दैवप्रश्न करणारे आणि वडीलजन,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"पन्नास लोकांवर असलेला सेनाधिकारी आणि उच्च पदाधिकारी,","poem":1},{"text":"सल्लागार, कुशल कारागीर आणि धूर्त मांत्रिक","poem":2},{"lineBreak":true},{"text":"या सर्वांसहित अन्नाचा आणि पाण्याचा पुरवठा ते काढून घेणार आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“मी किशोर मुलांना त्यांचा अधिकारी बनवेन;","poem":1},{"text":"बालके त्यांच्यावर राज्य करतील.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"लोक एकमेकांवर अत्याचार करतील—","poem":1},{"text":"पुरुषा विरुद्ध पुरुष, शेजाऱ्याविरुद्ध शेजारी.","poem":2},{"text":"तरुण वृद्ध लोकांच्या विरोधात उठतील,","poem":1},{"text":"मान्यवरांच्या विरोधात तुच्छ लोक उठतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"एखादा मनुष्य, आपल्या पित्याच्या घरात,","poem":1},{"text":"आपल्या भावास धरून म्हणेल,","poem":2},{"text":"“भाऊ, तुझ्याकडे अंगरखा आहे, तर तू आमचा पुढारी हो;","poem":1},{"text":"या नासाडीच्या ढिगाऱ्याचा ताबा घे!”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"पण त्या दिवशी तो ओरडेल,","poem":1},{"text":"“माझ्याकडे त्याचा इलाज नाही.","poem":2},{"text":"माझ्या घरी अन्न किंवा वस्त्रे नाहीत;","poem":1},{"text":"मला लोकांचा पुढारी बनवू नका.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"यरुशलेम डगमगत आहे,","poem":1},{"text":"यहूदीया कोसळत आहे;","poem":2},{"text":"त्यांचे बोलणे आणि कृत्ये याहवेहच्या विरोधात आहेत,","poem":1},{"text":"त्यांच्या गौरवशाली उपस्थितीला त्यांनी विरोध केला.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"त्यांच्या चेहऱ्यावरील भाव त्यांच्याच विरोधात साक्ष देतात;","poem":1},{"text":"त्यांच्या पापांचे ते सदोम नगरीप्रमाणे प्रदर्शन करतात;","poem":2},{"lineBreak":true},{"text":"ते लपवित नाहीत.","poem":2},{"text":"त्यांचा धिक्कार असो!","poem":1},{"text":"त्यांनीच स्वतःवर आपत्ती ओढवून घेतली आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"परंतु नीतिमानास सांगा त्यांना सुस्थिती येईल.","poem":1},{"text":"त्यांच्या सत्कृत्यांचे त्यांना प्रतिफळ मिळेल.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"दुष्टांचा धिक्कार असो!","poem":1},{"text":"अरिष्ट त्यांच्यावर येत आहे!","poem":2},{"text":"त्यांनी केलेल्या कृत्याचा,","poem":1},{"text":"त्यांना मोबदला मिळणार.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"तरुण माझ्या लोकांवर अत्याचार करतात,","poem":1},{"text":"स्त्रिया त्यांच्यावर राज्य करतात.","poem":2},{"text":"माझ्या लोकांनो, तुमचे मार्गदर्शक तुमची दिशाभूल करतात;","poem":1},{"text":"ते तुम्हाला पथभ्रष्ट करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"याहवेह त्यांच्या न्यायसभेत स्थानापन्न होतात;","poem":1},{"text":"ते लोकांचा न्याय करण्यासाठी उभे राहतात.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"त्यांच्या लोकांच्या वडिलजनांच्या व पुढाऱ्यांच्या विरोधात न्याय करण्यासाठी","poem":1},{"text":"याहवेह त्यांच्या न्यायसभेत प्रवेश करतात:","poem":2},{"text":"“तुम्हीच माझ्या द्राक्षमळ्याला उद्ध्वस्त केले आहे;","poem":1},{"text":"गरिबांपासून लुबाडलेली लूट तुमच्या घरांमध्ये आहे.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"माझ्या लोकांना चिरडण्याचे","poem":1},{"text":"व गरिबांचे चेहरे ठेचण्याचे काय कारण होते?”","poem":2},{"lineBreak":true},{"text":"प्रभू सर्वसमर्थ याहवेह असे म्हणतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"याहवेह म्हणतात,","poem":1},{"text":"“सीयोनातील स्त्रिया गर्विष्ठ आहेत,","poem":2},{"text":"त्या मान उडवीत चालतात,","poem":1},{"text":"चंचल नेत्रकटाक्षांनी मन वेधतात,","poem":2},{"text":"पायातल्या पैजणांचा छुमछुम आवाज करीत,","poem":1},{"text":"कंबर मटकत छोटी छोटी पावले टाकून चालतात.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"म्हणून प्रभू सीयोनी स्त्रियांच्या डोक्यांना खवडे आणणार;","poem":1},{"text":"याहवेह त्यांचे टाळू टकले करणार.”","poem":2}]},{"type":"verse","number":18,"content":["त्या दिवशी त्यांची सर्व आभूषणे प्रभू ओरबाडून काढतील: त्यांच्या बांगड्या, ललाटपट्टी, व चंद्रकोर हार,"]},{"type":"verse","number":19,"content":["त्यांचे कानातील झुमके, कांकण आणि मुखावरण,"]},{"type":"verse","number":20,"content":["त्यांची शिरोवेष्टणे, त्यांचे पैंजण आणि कमरपट्टे, अत्तरदाण्या आणि ताईत,"]},{"type":"verse","number":21,"content":["अंगठ्या आणि नथण्या,"]},{"type":"verse","number":22,"content":["उत्तम पोशाख, अधोवस्त्रे, अंगरखे, आणि बटवे,"]},{"type":"verse","number":23,"content":["त्यांचे आरसे, त्यांची मलमलची वस्त्रे, मुकुट व शाली."]},{"type":"verse","number":24,"content":[{"text":"सुगंधाऐवजी त्यांच्याकडे दुर्गंध येईल;","poem":1},{"text":"कमरपट्ट्याऐवजी एक दोरी असेल;","poem":2},{"text":"नीट केशरचनेऐवजी टक्कल;","poem":1},{"text":"उत्तम पोशाखाऐवजी गोणपाट;","poem":2},{"lineBreak":true},{"text":"आणि सौंदर्याऐवजी व्रण त्यांच्या वाट्याला येतील.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"तुमचे पुरुष तलवारीने पडतील,","poem":1},{"text":"तुमचे योद्धे युद्धभूमीवर ढासाळतील,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"सीयोनच्या वेशी आक्रोश करतील आणि विलाप करतील;","poem":1},{"text":"ती निराधार होऊन जमिनीवर बसलेली असेल.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}