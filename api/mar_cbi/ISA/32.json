{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":32,"content":[{"type":"heading","content":["नीतिमत्वाचे राज्य"]},{"type":"verse","number":1,"content":[{"text":"पाहा, एक राजा धार्मिकतेने राज्य करेल","poem":1},{"text":"आणि राज्यकर्ते न्यायाने सत्ता चालवितील.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"प्रत्येकजण वाऱ्यापासून आश्रयस्थान","poem":1},{"text":"आणि वादळापासून आश्रयस्थान,","poem":2},{"text":"वाळवंटामध्ये असलेल्या पाण्याच्या प्रवाहासारखा","poem":1},{"text":"आणि तहानलेल्या भूमीमध्ये मोठ्या खडकाच्या सावलीसारखा असेल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"तेव्हा पाहणाऱ्यांचे डोळे बंद राहणार नाहीत,","poem":1},{"text":"आणि ज्यांच्या कानांना ऐकू येते ते ऐकतील.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"भीती बाळगणाऱ्या अंतःकरणाला माहीत होईल आणि ते समजून घेतील","poem":1},{"text":"आणि अडखळणारी जीभ अस्खलित आणि स्पष्ट अशी होईल.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"यापुढे मूर्खांना चांगले","poem":1},{"text":"व बदमाशांना थोर म्हटले जाणार नाही.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मूर्ख लोक मूर्खपणाच्या गोष्टी करतात,","poem":1},{"text":"त्यांचे अंतःकरण वाईट कृत्य करण्यावरच केंद्रित असते:","poem":2},{"text":"ते देवहीनतेची कृत्ये करतात","poem":1},{"text":"आणि याहवेहविरुद्ध चुकीच्या गोष्टी पसरवितात;","poem":2},{"text":"भुकेल्यांना ते उपाशी सोडतात","poem":1},{"text":"आणि व तान्हेल्या जिवांना पाण्यापासून वंचित ठेवतात.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"बदमाश माणसे दुष्ट पद्धतीचा वापर करतात,","poem":1},{"text":"गरजवंताची याचना वाजवी असली तरी,","poem":2},{"text":"ते दुष्टाईच्या योजना बनवितात,","poem":1},{"text":"ते लबाडीने गरिबांचा नाश करतात.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"परंतु कुलीन मनुष्य कुलीनतेच्या योजना बनवितो","poem":1},{"text":"आणि कुलीनतेच्या कार्यावर स्थिर राहतो.","poem":2}]},{"type":"heading","content":["यरुशलेमच्या स्त्रिया"]},{"type":"verse","number":9,"content":[{"text":"आळसात लोळत पडणार्‍या स्त्रियांनो,","poem":1},{"text":"उठा व माझे ऐका;","poem":2},{"text":"हे निश्चिंत असणाऱ्या कन्यांनो,","poem":1},{"text":"मी काय सांगतो याकडे लक्ष द्या!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"एका वर्षाहून अधिक कालावधीत","poem":1},{"text":"तुम्हाला जे सुरक्षित वाटते ते थरथर कापतील;","poem":2},{"text":"कारण द्राक्षाचा उपज बुडेल,","poem":1},{"text":"आणि फळांचा हंगाम येणार नाही.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"आत्मसंतुष्ट स्त्रियांनो, थरथर कापा;","poem":1},{"text":"निश्चिंत असलेल्या कन्यांनो, तुमचा थरकाप होऊ द्या!","poem":2},{"text":"आपली सुंदर वस्त्रे काढून","poem":1},{"text":"शोक करण्यासाठी गोणपाट गुंडाळा.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"तुमचे ऊर बडवा, प्रसन्न करणार्‍या तुमच्या शेतांसाठी,","poem":1},{"text":"फलवंत द्राक्षवेलीसाठी","poem":2}]},{"type":"verse","number":13,"content":[{"text":"आणि माझ्या लोकांच्या भूमीसाठीही","poem":1},{"text":"कारण शेतात सर्वत्र काटेकुसळे व झुडपे वाढतील—","poem":2},{"text":"होय, आनंदोत्सव करणाऱ्या तुमच्या घरांसाठी,","poem":1},{"text":"व चैनबाजी करणार्‍या या शहरांसाठी विलाप करा.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"गडाचा त्याग करण्यात येईल,","poem":1},{"text":"गजबजलेली शहरे रिकामी होतील;","poem":2},{"text":"किल्ले व टेहळणी बुरूज कायमची पडीक स्थाने होतील,","poem":1},{"text":"जिथे रानगाढवांचे व शेरडेमेंढरांचे कळप आनंदात चरतील,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"परंतु जेव्हा उच्च स्थानावरून परमेश्वराचा आत्मा आपल्यावर ओतल्या जाईल,","poem":1},{"text":"ओसाड भूमी सुपीक होईल,","poem":2},{"lineBreak":true},{"text":"आणि सुपीक भूमी अरण्यासारखी वाटू लागेल.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"याहवेहचा न्याय वाळवंटातही वास्तव्य करेल,","poem":1},{"text":"व त्यांची नीतिमत्ता सुपीक भूमीत नांदेल.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"शांती नीतिमत्तेचे फळ असेल;","poem":1},{"text":"नीतिमत्तेचे कार्य तर सार्वकालिक शांतता आणि धैर्य आहे.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"माझ्या लोकांची घरे शांतीने भरलेली","poem":1},{"text":"आणि सुरक्षित असतील,","poem":2},{"lineBreak":true},{"text":"त्यांची शांतिभंग न होता ते विश्रांती घेतील.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"जरी गारांनी अरण्याचा नाश होईल","poem":1},{"text":"आणि सर्व शहरे जमीनदोस्त होतील.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"तरी तुम्ही किती आशीर्वादित व्हाल,","poem":1},{"text":"प्रत्येक झऱ्याजवळ तुमचे बीज पेराल,","poem":2},{"lineBreak":true},{"text":"आणि तुमची गुरे आणि गाढवे मुक्तपणे चरतील.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}