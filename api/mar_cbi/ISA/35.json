{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":35,"content":[{"type":"heading","content":["तारण पावलेल्यांचा आनंद"]},{"type":"verse","number":1,"content":[{"text":"वाळवंट आणि शुष्क भूमी आनंदित होईल;","poem":1},{"text":"अरण्य हर्षोल्हास करेल आणि बहरून येईल.","poem":2},{"text":"केशराच्या फुलाप्रमाणे,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"त्याच्या फुलोऱ्याचा स्फोट होईल;","poem":1},{"text":"तो मोठा आनंद करेल आणि उल्हासाने ओरडेल.","poem":2},{"text":"लबानोनचे गौरव,","poem":1},{"text":"कर्मेल आणि शारोन यांचे वैभव त्याला दिले जाईल;","poem":2},{"text":"ते याहवेहचे गौरव,","poem":1},{"text":"आमच्या परमेश्वराची भव्यता पाहतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"अशक्त हात बळकट करा,","poem":1},{"text":"निर्बल झालेले गुडघे स्थिर करा;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"भयभीत अंतःकरणाच्या लोकांना सांगा,","poem":1},{"text":"“बलवान व्हा, घाबरू नका;","poem":2},{"text":"तुमचे परमेश्वर येतील,","poem":1},{"text":"ते सूड घेण्यास येतील.","poem":2},{"text":"दैवी प्रतिफळ देऊन","poem":1},{"text":"तुम्हाला वाचवण्यासाठी येतील.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"तेव्हा आंधळ्यांचे डोळे उघडतील","poem":1},{"text":"आणि बहिऱ्यांचे कान उघडले जातील.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तेव्हा पांगळे हरिणाप्रमाणे उड्या मारतील,","poem":1},{"text":"आणि मुकी जीभ आनंदाने ओरडेल.","poem":2},{"text":"अरण्यामध्ये पाणी","poem":1},{"text":"आणि वाळवंटात झरे उफाळून वर येतील.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तप्त झालेली वाळू एक जलाशय होईल,","poem":1},{"text":"आणि तहानलेल्या जमिनीवर उफाळणारे झरे येतील.","poem":2},{"text":"जिथे कधी कोल्हे निजले,","poem":1},{"text":"त्या जागी बोरू व लव्हाळे यासहित गवत उगवेल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"आणि तिथे एक महामार्ग असेल;","poem":1},{"text":"त्याला पवित्रतेचा मार्ग म्हटले जाईल;","poem":2},{"lineBreak":true},{"text":"तो त्यांच्यासाठी असेल जे त्या पवित्र मार्गावरून चालतात.","poem":2},{"text":"अशुद्ध असलेले त्यावरून प्रवास करणार नाहीत.","poem":1},{"text":"दुष्ट मूर्ख लोक त्यावरून चालणार नाहीत.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तिथे कोणताही सिंह नसेल,","poem":1},{"text":"किंवा कोणताही वखवखलेला हिंस्र पशू नसेल.","poem":2},{"lineBreak":true},{"text":"ते तिथे सापडणार नाहीत.","poem":2},{"text":"फक्त तारण झालेलेच तिथे चालतील,","poem":1}]},{"type":"verse","number":10,"content":[{"text":"आणि ज्यांना याहवेहने सोडविले, ते लोक परत येतील.","poem":2},{"lineBreak":true},{"text":"ते हर्षगीते गात सीयोनात प्रवेश करतील;","poem":2},{"lineBreak":true},{"text":"अनंतकाळचा उल्हास त्यांच्या मस्तकावर असेल.","poem":2},{"text":"हर्ष व उल्हासाने ते भरून जातील,","poem":1},{"text":"दुःख व शोक दूर पळून जातील.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}