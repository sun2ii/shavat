{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"त्या दिवसात सात स्त्रिया","poem":1},{"text":"एका पुरुषास धरून असे म्हणतील","poem":2},{"text":"“आम्ही स्वतःचे अन्न मिळवू","poem":1},{"text":"आणि स्वतःचे वस्त्र मिळवू;","poem":2},{"text":"आम्हाला केवळ तुझे नाव चालवू दे,","poem":1},{"text":"आणि आमची अप्रतिष्ठा घालवून दे!”","poem":2}]},{"type":"heading","content":["याहवेहची शाखा"]},{"type":"verse","number":2,"content":["त्या दिवसात, याहवेहची शाखा सुंदर आणि गौरवशाली असेल, त्या भूमीतील पिकांचा इस्राएलातील अवशिष्टांना अभिमान व गौरव वाटेल."]},{"type":"verse","number":3,"content":["सीयोनात उरलेले लोक जे यरुशलेममध्येच राहिले, त्यांची नावे नोंदवली गेली आहेत, ते पवित्र म्हणविले जातील."]},{"type":"verse","number":4,"content":["प्रभू परमेश्वर सीयोनच्या स्त्रियांची घाण धुवून टाकतील; ते न्यायाच्या आत्म्याने आणि अग्नीच्या आत्म्याने यरुशलेममधील रक्ताचे डाग स्वच्छ करतील."]},{"type":"verse","number":5,"content":["त्यानंतर याहवेह संपूर्ण सीयोन पर्वतावर आणि तिथे जमलेल्या सर्वांवर दिवसा धुराचा ढग आणि रात्रीच्या वेळेस प्रखर अग्नी प्रज्वलित करतील; या सर्व गोष्टींवर गौरवाचे एक छत असेल."]},{"type":"verse","number":6,"content":["दिवसाच्या उष्णतेपासून ते एक आश्रय व सावली आणि वादळ व पावसापासून ते एक आश्रयस्थान आणि लपण्याचे ठिकाण असेल."]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/ISA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/3.json","previousChapterAudioLinks":{},"numberOfVerses":6}