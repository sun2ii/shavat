{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":47,"content":[{"type":"heading","content":["बाबेलचा पाडाव"]},{"type":"verse","number":1,"content":[{"text":"“हे कुमारी खाल्डियन कन्ये,","poem":1},{"text":"सिंहासनावरून खाली उतर व धुळीत बस;","poem":2},{"text":"हे बाबेल्यांच्या नगराची महाराणी,","poem":1},{"text":"सिंहासन सोडून जमिनीवर बस.","poem":2},{"text":"तू यापुढे कोमल व नाजूक","poem":1},{"text":"म्हणविली जाणार नाहीस.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"जाते घेऊन धान्य दळीत बस;","poem":1},{"text":"तुझा बुरखा काढून टाक.","poem":2},{"text":"तुझ्या घागर्‍याचा घोळ उचल आणि पाय उघडे करून","poem":1},{"text":"ओढ्यातून पायपीट करत जा.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तुझ्या नग्नतेचे प्रदर्शन होईल,","poem":1},{"text":"आणि तुझी लज्जा अनावृत होईल.","poem":2},{"text":"मी सूड उगवेन;","poem":1},{"text":"मी कोणा मनुष्याला सोडणार नाही.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"आमचे उद्धारकर्ता—सर्वसमर्थ याहवेह हे ज्यांचे नाव आहे—","poem":1},{"text":"तेच इस्राएलचे पवित्र परमेश्वर आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“स्तब्ध बस, अंधारात जा,","poem":1},{"text":"खास्द्यांच्या नगराची राणी.","poem":2},{"text":"तू यापुढे राज्याची महाराणी","poem":1},{"text":"म्हणविली जाणार नाहीस.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मी माझ्या लोकांवर संतापलो होतो","poem":1},{"text":"आणि माझ्या वारसांना भ्रष्ट केले;","poem":2},{"text":"त्यांना तुझ्या हाती दिले,","poem":1},{"text":"पण तू त्यांना थोडीसुध्दा दया दाखविली नाहीस.","poem":2},{"text":"वयस्कर लोकांवरही","poem":1},{"text":"तू अवघड ओझे लादलेस.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तू म्हटले, ‘मी सदैव अस्तित्वात आहे—","poem":1},{"text":"सर्वकाळाची राणी आहे!’","poem":2},{"text":"परंतु तू या गोष्टींचा विचार केला नाहीस","poem":1},{"text":"किंवा परिणामी काय होऊ शकेल याकडे लक्ष दिले नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“अगे चैनबाजीचे वेड असणारी,","poem":1},{"text":"सुरक्षितपणे विलासणारी,","poem":2},{"text":"आणि स्वतःला म्हणणारी,","poem":1},{"text":"‘मीच आहे, माझ्यासारखे कोणीही नाही.","poem":2},{"text":"मी कधीही विधवा होणार नाही","poem":1},{"text":"माझी लेकरे मी कधी गमावणार नाही.’","poem":2}]},{"type":"verse","number":9,"content":[{"text":"पण आता या दोन्ही आपत्ती तुझ्यावर त्याच क्षणी,","poem":1},{"text":"एकाच दिवशी, पूर्णपणे गुदरतील:","poem":2},{"lineBreak":true},{"text":"तू विधवा होशील आणि तुझी मुलेही गमावशील.","poem":2},{"text":"येथे तुझे अनेक चेटके","poem":1},{"text":"आणि तुझा सर्व जादूटोणा असूनही","poem":2},{"lineBreak":true},{"text":"हे सर्व पूर्ण मापाने भरून तुझ्यावर पडेल.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तू तुझ्या दुष्टाईवर भरवसा ठेवला","poem":1},{"text":"‘मला कोणी पाहत नाही,’ असे तू म्हणालीस.","poem":2},{"text":"तुझ्या ज्ञानाने व शहाणपणाने तुला पथभ्रष्ट केले","poem":1},{"text":"जेव्हा तू स्वतःला म्हणालीस,","poem":2},{"lineBreak":true},{"text":"‘मीच आहे आणि माझ्यासारखी दुसरी कोणी नाही.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तुझ्यावर आपत्ती कोसळेल","poem":1},{"text":"आणि ती हातचलाखी करून कशी उलटावी हे तुला कळणार नाही.","poem":2},{"text":"तुझ्यावर संकट कोसळेल","poem":1},{"text":"खंडणी भरूनही त्याचे निवारण करता येणार नाही;","poem":2},{"text":"जी येईल असे वाटले नाही अशी एक घोर विपत्ती","poem":1},{"text":"अकस्मात तुझ्यावर येईल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“मग तुझा जादूटोणा व मंत्रतंत्र,","poem":1},{"text":"ज्याचा अनेक वर्षापासून परिश्रम करून तू अभ्यास केला, ते चालू दे.","poem":2},{"text":"कदाचित तुला यश मिळेल,","poem":1},{"text":"कदाचित दहशत निर्माण करशील.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तुला मिळालेल्या सर्व सल्ल्यांनी तू थकली आहेस!","poem":1},{"text":"तुझे ज्योतिषी पुढे येवोत,","poem":2},{"text":"नक्षत्र पाहून महिन्याच्या महिने भविष्यकथन करणारे,","poem":1},{"text":"तुझ्यावर पुढे येणाऱ्या संकटापासून तुझे रक्षण करो.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ते निश्चितच भुसकटासारखे आहेत;","poem":1},{"text":"अग्नी त्यांना भस्म करेल.","poem":2},{"text":"ते अग्नीच्या सामर्थ्यापासून","poem":1},{"text":"स्वतःचेही संरक्षण करू शकत नाहीत.","poem":2},{"text":"हे ऊब देणारे निखारे नाहीत;","poem":1},{"text":"ही जवळ बसविणारी शेकोटी नव्हे.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ते तुझ्यासाठी एवढेच करतील की—","poem":1},{"text":"ज्यांच्याशी तू आयुष्यभर व्यवहार केलास,","poem":2},{"lineBreak":true},{"text":"आणि बालपणापासून ज्यांच्यासह कष्ट केलेस,","poem":2},{"text":"ते सर्व त्यांच्या चुका कायम करीतच राहतील;","poem":1},{"text":"आणि तुझा बचाव करण्यासाठी कोणीही राहणार नाही.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}