{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"ऊठ, ऊठ, हे सीयोना,","poem":1},{"text":"सामर्थ्याचे वस्त्र परिधान कर!","poem":2},{"text":"यरुशलेम, हे पवित्र नगरी,","poem":1},{"text":"आपली वैभवशाली वस्त्रे परिधान कर.","poem":2},{"text":"बेसुंती आणि भ्रष्ट","poem":1},{"text":"यापुढे तुझ्या वेशीतून प्रवेश करणार नाहीत.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हे यरुशलेमे, तुझ्यावरील धूळ झटकून टाक,","poem":1},{"text":"ऊठ व सिंहासनारुढ हो.","poem":2},{"text":"बंदिवान सीयोनकन्ये,","poem":1},{"text":"दास्यतेची बंधने आपल्या गळ्यांतून काढून मुक्त हो.","poem":2}]},{"type":"verse","number":3,"content":["कारण याहवेह म्हणतात:",{"text":"“तुम्हाला विनामूल्य बंदिवासात विकले,","poem":1},{"text":"आणि आता पैशावाचून तुम्हाला सोडविण्यात येईल.”","poem":2}]},{"type":"verse","number":4,"content":["कारण सार्वभौम याहवेह असे म्हणतात:",{"text":"“प्रथम माझे लोक इजिप्त देशात राहवयास गेले;","poem":1},{"text":"नंतर अश्शूरच्या लोकांनी त्यांचा छळ केला.”","poem":2}]},{"type":"verse","number":5,"content":["याहवेह घोषणा करतात, “आणि आता माझ्याकडे काय राहिले आहे?",{"text":"माझ्या लोकांना विनामूल्य नेण्यात आले आहे,","poem":1},{"text":"आणि जे त्यांच्यावर सत्ता गाजवितात ते त्यांचा उपहास","poem":2},{"noteId":40},{"text":"करतात,”","poem":2},{"lineBreak":true},{"text":"याहवेह घोषणा करतात,","poem":2},{"text":"“संपूर्ण दिवसभर","poem":1},{"text":"माझ्या नावाची सतत निंदा करण्यात येते.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"माझे लोक माझे नाव जाणतील;","poem":1},{"text":"म्हणून त्या दिवशी त्यांना समजेल","poem":2},{"text":"कि ते भविष्यकथन करणारा तो मीच आहे.","poem":1},{"text":"होय, तो मीच आहे.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"पर्वतावरून शुभवार्ता आणणार्‍याचे पाय किती मनोरम आहेत,","poem":1},{"text":"जे आनंददायी वार्ता आणतात,","poem":2},{"text":"जे शांतीची घोषणा करतात,","poem":1},{"text":"जे शुभ संदेश आणतात,","poem":2},{"lineBreak":true},{"text":"जे तारणाची घोषणा करतात,","poem":2},{"text":"जे सीयोनास म्हणतात,","poem":1},{"text":"“तुमचे परमेश्वर राज्य करतात!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ऐका! तुमचे पहारेकरी त्यांचा आवाज उंचावतात;","poem":1},{"text":"एकत्र मिळून ते आनंदाचा जयघोष करतात.","poem":2},{"text":"जेव्हा याहवेह सीयोनास परत येतील,","poem":1},{"text":"ते प्रत्यक्ष त्यांच्या डोळ्याने पाहतील.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"यरुशलेमच्या उद्ध्वस्त स्थळांनो,","poem":1},{"text":"सर्वांनी एकत्र उसळून हर्षगीतांनी जयघोष करा,","poem":2},{"text":"कारण याहवेहने आपल्या लोकांचे सांत्वन केले आहे,","poem":1},{"text":"त्यांनी यरुशलेमास सोडविले आहे.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"याहवेह आपली पवित्र भुजा","poem":1},{"text":"सर्व राष्ट्रांसमक्ष उघडणार आहेत,","poem":2},{"text":"आणि पृथ्वीच्या सर्व दिगंतापर्यंत","poem":1},{"text":"आमच्या परमेश्वराचे तारण दिसेल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"निघा, निघा, इथून बाहेर पडा!","poem":1},{"text":"अपवित्र वस्तूला स्पर्श करू नका!","poem":2},{"text":"तुम्ही जे याहवेहच्या मंदिरातील पात्रांची नेआण करता,","poem":1},{"text":"इथून बाहेर पडा व स्वतःला शुद्ध करा.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"परंतु तुम्हाला इथून पलायन करावे लागणार नाही","poem":1},{"text":"वा घाईने निघावे लागणार नाही;","poem":2},{"text":"कारण याहवेह तुमच्यापुढे जातील,","poem":1},{"text":"आणि इस्राएलचे परमेश्वर तुमचे पाठीराखे असतील.","poem":2}]},{"type":"heading","content":["सेवकाची पीडा व गौरव"]},{"type":"verse","number":13,"content":[{"text":"पाहा, माझा सेवक सुज्ञतेने वागेल","poem":1},{"noteId":41},{"text":";","poem":1},{"text":"तो उच्च केला जाईल व उत्कर्ष पावेल आणि त्याचे मोठे गौरव होईल.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"जसे त्याला पाहताच अनेकजण विस्मित झाले होते—","poem":1},{"text":"त्याचे स्वरूप मनुष्यप्राण्याच्या पलीकडे विद्रुप करण्यात आले होते","poem":2},{"lineBreak":true},{"text":"आणि त्याचा आकार मानवसदृश्य राहिला नव्हता—","poem":2}]},{"type":"verse","number":15,"content":[{"text":"यास्तव तो अनेक राष्ट्रांवर शिंपडेल,","poem":1},{"noteId":42},{"text":"आणि त्याच्यामुळे राजे आपले मुख बंद करतील.","poem":2},{"text":"कारण त्यांना पूर्वी कधी कोणी जे सांगितले नव्हते, ते आता बघतील,","poem":1},{"text":"आणि ज्यांनी ऐकले नाही, त्यांना समजेल.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":40,"caller":"+","text":"किंवा आतंक","reference":{"chapter":52,"verse":5}},{"noteId":41,"caller":"+","text":"किंवा समृद्धी पावेल","reference":{"chapter":52,"verse":13}},{"noteId":42,"caller":"+","text":"किंवा अनेक राष्ट्रांना आश्चर्य वाटेल","reference":{"chapter":52,"verse":15}}]},"thisChapterLink":"/api/mar_cbi/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}