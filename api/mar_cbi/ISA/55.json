{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":55,"content":[{"type":"heading","content":["तहानलेल्यांना आमंत्रण"]},{"type":"verse","number":1,"content":[{"text":"“तुमच्यातील सर्व तान्हेल्यांनो,","poem":1},{"text":"पाण्याजवळ या;","poem":2},{"text":"आणि तुम्ही, ज्यांच्याकडे पैसे नाहीत,","poem":1},{"text":"या, घ्या व खा!","poem":2},{"text":"या, द्राक्षारस अथवा दूध घ्या","poem":1},{"text":"पैसे न देता, विनामूल्य घ्या.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"जी भाकर नाही त्या अन्नपदार्थांवर व्यर्थ पैसे का खर्च करावे,","poem":1},{"text":"आणि ज्याने समाधान होत नाही त्यासाठी कष्ट का करावे?","poem":2},{"text":"ऐका, माझे ऐकून घ्या आणि जे चांगले आहे ते खा,","poem":1},{"text":"आणि हे उत्तम अन्नपदार्थ खाऊन तुम्ही अत्यंत आनंदित व्हाल.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"माझे ऐका आणि मजकडे या;","poem":1},{"text":"लक्ष द्या, म्हणजे तुम्ही जिवंत राहाल.","poem":2},{"text":"मी तुमच्याबरोबर सर्वकाळचा करार करेन,","poem":1},{"text":"माझ्या विश्वासू प्रीतीचे वचन मी दावीदाला दिलेले आहे.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"पाहा, मी त्याला लोकांसमोर साक्षीदार,","poem":1},{"text":"एक शासनकर्ता व लोकांचा अधिकारी बनविले.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"निश्चितच ज्यांना तुम्ही ओळखत नाही अशा राष्ट्रांना बोलवाल,","poem":1},{"text":"आणि ज्यांना तुम्ही ओळखत नाही अशी राष्ट्रे तुमच्याकडे पळत येतील,","poem":2},{"text":"कारण याहवेह, तुमचे परमेश्वर,","poem":1},{"text":"इस्राएलचे पवित्र परमेश्वर आहेत,","poem":2},{"lineBreak":true},{"text":"त्यांनी तुम्हाला गौरवाने संपन्न केले आहे.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"याहवेहच्या प्राप्तीचा काळ आहे, तेव्हा पर्यंतच त्यांचा शोध घ्या.","poem":1},{"text":"ते समीप आहेत, तेव्हा पर्यंतच त्यांचा धावा करा.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"दुष्टांनी आपले दुष्टमार्ग सोडून द्यावे","poem":1},{"text":"अनीतिमानांनी त्यांचे विचार मनातून काढावे.","poem":2},{"text":"त्यांनी याहवेहकडे वळावे, म्हणजे ते त्यांच्यावर दया करतील,","poem":1},{"text":"आपल्या परमेश्वराकडे धाव घ्यावी, म्हणजे ते त्यांना मुक्तपणे क्षमा करतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“जे माझे विचार आहेत, ते तुमचे विचार नाहीत,","poem":1},{"text":"माझे मार्ग, ते तुमचे मार्ग नाहीत.”","poem":2},{"lineBreak":true},{"text":"असे याहवेह म्हणतात.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“कारण आकाश पृथ्वीहून जसे उंच आहे,","poem":1},{"text":"तसे माझे मार्ग तुमच्या मार्गांहून उच्च आहेत","poem":2},{"lineBreak":true},{"text":"आणि माझे विचार तुमच्या विचाराहून उच्च आहेत.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"आकाशातून पाऊस व हिम","poem":1},{"text":"ज्याप्रमाणे खाली पडतात","poem":2},{"text":"आणि पृथ्वीला भिजवून टाकल्याशिवाय","poem":1},{"text":"परत जात नाहीत","poem":2},{"text":"आणि तिला अंकुरतात व बहरतात,","poem":1},{"text":"जेणेकरून पेरणार्‍यासाठी बीज निपजते व खाणार्‍याला भाकर मिळते,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"त्याप्रमाणे माझे वचन, जे माझ्या मुखातून बाहेर पडते:","poem":1},{"text":"ते कार्य केल्याशिवाय माझ्याकडे परत येत नाही,","poem":2},{"text":"पण ते माझ्या इच्छेप्रमाणे सर्व परिपूर्ण करते","poem":1},{"text":"व ज्या कार्यासाठी पाठविण्यात आले, तो माझा हेतू साध्य करते.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"तुम्ही आनंदाने प्रस्थान कराल","poem":1},{"text":"व शांतीने मार्गदर्शित व्हाल;","poem":2},{"text":"पर्वते आणि टेकड्या,","poem":1},{"text":"तुमच्यापुढे उचंबळून गीते गातील,","poem":2},{"text":"आणि रानातील सर्व वृक्ष","poem":1},{"text":"टाळ्या वाजवतील.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"काटेरी झुडपांच्या ऐवजी तिथे, सुरूचे वृक्ष वाढतील,","poem":1},{"text":"आणि तिथे रिंगणीच्या जागी मेंदीची झाडे वाढतील.","poem":2},{"text":"हे याहवेहच्या नामाच्या थोरवीकरिता असेल","poem":1},{"text":"जे अनंतकाळपर्यंत टिकेल,","poem":2},{"lineBreak":true},{"text":"असे ते सर्वकाळचे चिन्ह होईल.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}