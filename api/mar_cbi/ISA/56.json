{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":56,"content":[{"type":"heading","content":["यहूदीतर लोकांसाठी तारण"]},{"type":"verse","number":1,"content":["याहवेह असे म्हणतात:",{"text":"“न्यायीपणाने वागा,","poem":1},{"text":"जे योग्य तेच करा,","poem":2},{"text":"कारण माझे तारण अगदी हाताशी आलेले आहे","poem":1},{"text":"आणि माझे नीतिमत्व लवकरच प्रगट होणार आहे.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"जो शब्बाथाच्या दिवसास अपवित्र न करता त्याचे पालन करतो,","poem":1},{"text":"अयोग्य गोष्ट करण्यापासून स्वतःला आवरतो,","poem":2},{"text":"या सर्व गोष्टींवर अढळ राहतो,","poem":1},{"text":"जो असे वागतो, तो मनुष्य धन्य होय.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"जो विदेशी मनुष्य याहवेहशी एकनिष्ठ राहतो, त्याने असे म्हणू नये,","poem":1},{"text":"“याहवेह निश्चितच मला त्यांच्या लोकांमघून वगळतील.”","poem":2},{"text":"आणि कोणत्याही षंढाने अशी तक्रार करू नये,","poem":1},{"text":"“मी तर केवळ एक शुष्क वृक्ष आहे.”","poem":2}]},{"type":"verse","number":4,"content":["तर याहवेह असे म्हणतात:",{"text":"“जे षंढ माझे शब्बाथ पवित्रपणे पाळतात,","poem":1},{"text":"जे मला आवडणार्‍या गोष्टीच निवडतात,","poem":2},{"lineBreak":true},{"text":"आणि माझा करार दृढ धरून राहतात—","poem":2}]},{"type":"verse","number":5,"content":[{"text":"त्यांना मी माझ्या मंदिरामध्ये व त्याच्या भिंतीच्या आत","poem":1},{"text":"पुत्र व कन्यापेक्षाही चांगले असे","poem":2},{"lineBreak":true},{"text":"संस्मरणीय बनवेन व एक नाव देईन.","poem":2},{"text":"त्यांना मी सर्वकाळ टिकणारे नाव देईन,","poem":1},{"text":"जे नाव कधीही नाहीसे होणार नाही.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"आणि जे विदेशी याहवेहशी एकनिष्ठ राहतात,","poem":1},{"text":"जे त्यांची सेवा करतात,","poem":2},{"text":"त्यांच्या नावावर प्रीती करतात,","poem":1},{"text":"आणि त्यांचे सेवक झाले आहेत,","poem":2},{"text":"जे सर्व त्यांच्या शब्बाथास अपवित्र न करता त्याचे पालन करतात,","poem":1},{"text":"आणि माझा करार दृढ धरून राहतात—","poem":2}]},{"type":"verse","number":7,"content":[{"text":"अशांना मी माझ्या पवित्र पर्वतावर आणेन","poem":1},{"text":"आणि माझ्या प्रार्थना मंदिरामध्ये त्यांना आनंदित करेन.","poem":2},{"text":"त्यांच्या होमार्पणे व अर्पणांचा","poem":1},{"text":"माझ्या वेदीवर स्वीकार केला जाईल;","poem":2},{"text":"कारण माझ्या घराला","poem":1},{"text":"सर्व राष्ट्रांसाठी प्रार्थनेचे घर असे म्हणतील.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"जे इस्राएलच्या निर्वासित झालेल्यांना एकत्र करतात,","poem":1},{"text":"ते सार्वभौम याहवेह अशी घोषणा करतात—","poem":2},{"text":"“ज्यांना पूर्वी एकत्र करण्यात आले आहे, त्या लोकांशिवाय","poem":1},{"text":"इतर लोकांनाही मी त्यांच्यात गोळा करेन.”","poem":2}]},{"type":"heading","content":["दुर्जनांविरुद्ध परमेश्वराचे आरोप"]},{"type":"verse","number":9,"content":[{"text":"या, कुरणातील सर्व पशूंनो,","poem":1},{"text":"या, रानातील सर्व हिंस्र श्वापदांनो, येऊन आधाशीपणे खा!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"इस्राएलचे पहारेकरी आंधळे आहेत,","poem":1},{"text":"ते सर्व ज्ञानशून्य आहेत;","poem":2},{"text":"ते सर्व मुके कुत्रे आहेत,","poem":1},{"text":"त्यांना भुंकता येत नाही;","poem":2},{"text":"ते पडून राहतात व स्वप्ने पाहतत,","poem":1},{"text":"त्यांना झोपायला फार आवडते.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ते कुत्र्याप्रमाणे खूप खादाड आहेत;","poem":1},{"text":"त्यांची तृप्ती कधीही होत नाही.","poem":2},{"text":"ते असमंजस मेंढपाळ आहेत;","poem":1},{"text":"ते सर्व आपल्याच मर्जीने चालतात,","poem":2},{"lineBreak":true},{"text":"केवळ स्वतःच्या स्वार्थाची काळजी घेतात.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"प्रत्येकजण म्हणतो, “या, मला मद्य आणू द्या!","poem":1},{"text":"चला, मद्य पिऊन आपण धुंद होऊ या!","poem":2},{"text":"आणि उद्याचा दिवसही आजसारखाच असेल,","poem":1},{"text":"किंबहुना याहून जास्त चैनीचा असेल.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}