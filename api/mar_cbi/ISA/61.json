{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":61,"content":[{"type":"heading","content":["याहवेहच्या कृपेचे वर्ष"]},{"type":"verse","number":1,"content":[{"text":"सार्वभौम याहवेहचा आत्मा मजवर आहे,","poem":1},{"text":"कारण गरिबांना शुभवार्ता सांगण्यासाठी","poem":2},{"lineBreak":true},{"text":"याहवेहने माझा अभिषेक केला आहे.","poem":2},{"text":"भग्नहृदयी लोकांचे सांत्वन करण्यासाठी,","poem":1},{"text":"कैद्यांना सुटका जाहीर करण्यासाठी","poem":2},{"lineBreak":true},{"text":"व अंधकारातून बंदिवानांना मुक्त करण्यासाठी त्यांनी मला पाठविले आहे.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"याहवेहच्या कृपेचे वर्ष","poem":1},{"text":"आणि परमेश्वराचा सूड घेण्याचा दिवस आला आहे, हे जाहीर करण्यास,","poem":2},{"text":"आणि जे सर्व विलाप करतात त्यांचे सांत्वन करण्यासाठी त्यांनी मला पाठविले आहे.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"सीयोनातील जे सर्व शोक करतात त्यांना—","poem":2},{"text":"राखेऐवजी सौंदर्याचा मुकुट,","poem":1},{"text":"विलापाऐवजी","poem":2},{"text":"आनंदाचे तेल,","poem":1},{"text":"निराशेच्या आत्म्याऐवजी","poem":2},{"text":"स्तुतीचे वस्त्र","poem":1},{"text":"बहाल करण्यासाठी.","poem":2},{"text":"कारण त्यांचे गौरव प्रकट करण्यासाठी","poem":1},{"text":"ते नीतिमत्तेचे एला वृक्ष","poem":2},{"lineBreak":true},{"text":"याहवेहने स्वतः रोपलेले असे संबोधले जातील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ते प्राचीन भग्नावशेषाची पुनर्बांधणी करतील","poem":1},{"text":"फार पूर्वी उद्ध्वस्त झालेल्या शहरांची डागडुजी करतील;","poem":2},{"text":"ते पुरातन पडीक नगरांचा,","poem":1},{"text":"जी पिढ्यान् पिढ्या उद्ध्वस्त झाली होती, त्यांचा जीर्णोद्धार करतील.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"अपरिचित लोक तुमचे कळप राखतील;","poem":1},{"text":"विदेशी तुमची शेते व द्राक्षमळ्यांची निगा राखतील.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तुम्हाला याहवेहचे याजक म्हणतील","poem":1},{"text":"तुम्ही आमच्या परमेश्वराचे सेवक म्हणून संबोधले जाल.","poem":2},{"text":"राष्ट्रांच्या संपत्तीतून तुमचे पोषण होईल,","poem":1},{"text":"व तुम्ही त्यांच्या समृद्धीचा अभिमान बाळगाल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"लज्जेच्या ऐवजी","poem":1},{"text":"तुम्ही दुपटीने सन्मान मिळवाल,","poem":2},{"text":"आणि अप्रतिष्ठे ऐवजी","poem":1},{"text":"तुम्हाला तुमच्या वतनात आनंद प्राप्त होईल.","poem":2},{"text":"आणि तुम्ही दुपटीने तुमच्या वतनभूमीचे वारसदार व्हाल,","poem":1},{"text":"आणि तुम्ही अनंतकाळचा आनंद प्राप्त कराल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“कारण मी याहवेह, मी न्याय प्रिय आहे;","poem":1},{"text":"चोरी आणि अन्यायाचा मला तिटकारा आहे.","poem":2},{"text":"माझ्या विश्वासूपणाने मी माझ्या लोकांना मोबदला देईन","poem":1},{"text":"आणि त्यांच्याबरोबर सर्वकाळचा करार करेन.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"राष्ट्रांमध्ये त्यांच्या वंशजांचा लौकिक होईल,","poem":1},{"text":"आणि त्यांची संतती लोकांमध्ये बहुमानीत होतील.","poem":2},{"text":"जे सर्व त्यांना बघून हे कबूल करतील की","poem":1},{"text":"ते याहवेहचे आशीर्वादित लोक आहेत.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"मी याहवेहमध्ये अत्यानंदित होतो;","poem":1},{"text":"माझा आत्मा माझ्या परमेश्वरात हर्षोल्हासित होतो.","poem":2},{"text":"जसे वराचे मस्तक याजकाप्रमाणे विभूषित केले जाते,","poem":1},{"text":"किंवा वधू दागिन्यांनी स्वतःला अलंकृत करते,","poem":2},{"text":"तशी त्यांनी मला तारणाची वस्त्रे नेसविली आहेत","poem":1},{"text":"आणि नीतिमत्वाच्या अंगरख्याने मला आच्छादले आहे.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"जशी माती अंकुराला उगविते","poem":1},{"text":"आणि बाग बीज वाढविते","poem":2},{"text":"तसे सार्वभौम याहवेह नीतिमत्व","poem":1},{"text":"आणि प्रशंसा सर्व राष्ट्रासमोर अंकुरित करतील.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}