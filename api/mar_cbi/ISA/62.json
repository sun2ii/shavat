{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":62,"content":[{"type":"heading","content":["सीयोनचे नवे नाव"]},{"type":"verse","number":1,"content":[{"text":"सीयोनचा निर्दोषपणा सूर्योदयासारखा उजळून,","poem":1},{"text":"मी निःशब्द राहणार नाही,","poem":2},{"text":"व यरुशलेमचे तारण जळत्या मशालीसारखे सिद्ध होईपर्यंत,","poem":1},{"text":"मी शांत राहणार नाही.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"राष्ट्रे तुझा निर्दोषपणा,","poem":1},{"text":"आणि सर्व राजे तुझे वैभव बघतील;","poem":2},{"text":"याहवेहच्या मुखाने बहाल केलेल्या","poem":1},{"text":"नवीन नावाने तुला संबोधण्यात येईल.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तू याहवेहच्या हातातील गौरवशाली मुकुट,","poem":1},{"text":"आणि तुझ्या परमेश्वराच्या हातातील राजेशाही किरीट होशील.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"यापुढे तुला ते त्याग केलेली असे म्हणणार नाहीत,","poem":1},{"text":"अथवा तुझ्या भूमीला ओसाड असे म्हणणार नाही.","poem":2},{"text":"पण हेफसीबा","poem":1},{"noteId":48},{"text":"हे तुझे नवे नाव असेल","poem":1},{"text":"आणि तुझ्या भूमीला बिऊला","poem":2},{"noteId":49},{"text":"म्हणतील;","poem":2},{"text":"कारण याहवेहला तुझ्यामुळे आनंद होईल,","poem":1},{"text":"आणि तुझी भूमी विवाहित होईल.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"जसा एक तरुण एका तरुणीशी विवाह करतो,","poem":1},{"text":"तसाच तुझा निर्माणकर्ता तुझ्याशी विवाह करेल;","poem":2},{"text":"जसा एखाद्या वराला आपल्या वधूविषयी आनंद होतो,","poem":1},{"text":"तसाच तुझ्या परमेश्वराला तुझ्यामुळे आनंद होईल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"अगे यरुशलेमे, तुझ्या कोटांवर मी पहारेकरी नेमले आहेत;","poem":1},{"text":"ते रात्री किंवा दिवसा, असे कधीही स्तब्ध राहणार नाहीत.","poem":2},{"text":"तू जी याहवेहचा धावा करते,","poem":1},{"text":"स्वतःला विसावा देऊ नको,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"आणि ते यरुशलेमची पुन्हा स्थापना करेपर्यंत","poem":1},{"text":"व सर्व पृथ्वीवर तिला स्तुतीस योग्य करेपर्यंत,","poem":2},{"lineBreak":true},{"text":"परमेश्वरालाही विसावा घेऊ देऊ नको.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"आपल्या उजव्या हाताने","poem":1},{"text":"आणि त्यांच्या सामर्थ्यशाली भुजेने याहवेहने शपथ वाहिली आहे:","poem":2},{"text":"“यापुढे मी कधीही तुझे धान्य, त्यांचे अन्न म्हणून","poem":1},{"text":"तुझ्या शत्रूंच्या स्वाधीन करणार नाही,","poem":2},{"text":"आणि तू परिश्रम करून काढलेला नवा द्राक्षारस,","poem":1},{"text":"परकीय येऊन कधीही पिणार नाहीत.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"परंतु जे पीक काढतील, तेच ते खाईल","poem":1},{"text":"आणि याहवेहची स्तुती करतील,","poem":2},{"text":"आणि जे द्राक्ष गोळा करतील,","poem":1},{"text":"तेच पवित्रस्थानाच्या आवारात द्राक्षारस पितील.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"बाहेर पडा! वेशींच्या बाहेर पडा!","poem":1},{"text":"माझ्या लोकांसाठी मार्ग तयार करा.","poem":2},{"text":"बांधा, महामार्ग बांधा!","poem":1},{"text":"दगडधोंडे काढून टाका.","poem":2},{"text":"राष्ट्रांकरिता ध्वज उंच फडकवा.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"याहवेहनी पृथ्वीच्या","poem":1},{"text":"दिगंतापर्यंत घोषणा केली आहे:","poem":2},{"text":"“सीयोनकन्येला सांगा,","poem":1},{"text":"‘पाहा, तुझे उद्धारकर्ता येत आहेत!","poem":2},{"text":"पाहा, त्यांचे बक्षीस त्यांच्याकडे आहे,","poem":1},{"text":"आणि त्यांची भरपाई त्यांच्यासोबत आहे.’ ”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"त्यांना पवित्र लोक,","poem":1},{"text":"याहवेहने खंडणी भरून सोडविलेले, असे म्हणण्यात येईल,","poem":2},{"text":"आणि तुला खूप मागणी असलेला देश,","poem":1},{"text":"कधीही न टाकलेले नगर असे म्हणतील.","poem":2}]}],"footnotes":[{"noteId":48,"caller":"+","text":"हेफसीबा म्हणजे तिच्यामध्ये मला आनंद आहे","reference":{"chapter":62,"verse":4}},{"noteId":49,"caller":"+","text":"बिऊला म्हणजे विवाहित","reference":{"chapter":62,"verse":4}}]},"thisChapterLink":"/api/mar_cbi/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}