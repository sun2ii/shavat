{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":63,"content":[{"type":"heading","content":["परमेश्वराच्या सुडाचा आणि उद्धाराचा दिवस"]},{"type":"verse","number":1,"content":[{"text":"एदोमाहून व बस्रा शहराहून,","poem":1},{"text":"किरमिजी रंगाने रंगविलेली वस्त्रे घालून,","poem":2},{"text":"वैभवी वस्त्रे परिधान करून त्यांच्या महान सामर्थ्याने वेगाने पावले पुढे टाकत","poem":1},{"text":"येणारे हे कोण आहेत?","poem":2},{"lineBreak":true},{"text":"“विजयाची घोषणा करीत,","poem":1},{"text":"तारण करण्यास समर्थ असलेला, हा मी आहे.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"तुमची वस्त्रे द्राक्षकुंडात तुडविणार्‍यांसारखी","poem":1},{"text":"लाल रंगाची का आहेत?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“द्राक्षकुंड मी एकट्यानेच तुडविले;","poem":1},{"text":"राष्ट्रातून माझ्यासोबत कोणी नव्हते.","poem":2},{"text":"माझ्या क्रोधाने मी ती तुडविली","poem":1},{"text":"आणि त्यांना आपल्या संतापाने चिरडले;","poem":2},{"text":"त्यांचेच रक्त माझ्या वस्त्रांवर उडाले,","poem":1},{"text":"म्हणून माझी सर्व वस्त्रे माखली.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"माझ्याकरिता तो सूड घेण्याचा दिवस होता;","poem":1},{"text":"आणि ते उद्धार करण्याचे वर्ष आले होते.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"मी शोधले, परंतु तिथे साहाय्याला कोणीही नव्हते,","poem":1},{"text":"कोणी मदतीला नसल्यामुळे मला धक्का बसला;","poem":2},{"text":"तेव्हा माझ्या स्वतःच्या बाहूने माझ्याकरिता मी उद्धार मिळविला,","poem":1},{"text":"आणि माझ्या स्वतःच्या क्रोधाने मला राखले.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"क्रोधाच्या भरात मी राष्ट्रांना तुडविले;","poem":1},{"text":"माझ्या संतापाच्या भरात मी त्यांना मद्यधुंद केले","poem":2},{"lineBreak":true},{"text":"आणि त्यांचे रक्त जमिनीवर ओतले.”","poem":2}]},{"type":"heading","content":["स्तुती आणि प्रार्थना"]},{"type":"verse","number":7,"content":[{"text":"मी याहवेहच्या दयाळूपणाबद्दल","poem":1},{"text":"त्यांनी केलेल्या सर्व स्तुतिपात्र कृत्यांबद्दल सांगेन,","poem":2},{"lineBreak":true},{"text":"जे सर्व याहवेहनी आमच्यासाठी केले—","poem":2},{"text":"होय, ज्या अनेक गोष्टी","poem":1},{"text":"त्यांच्या करुणेने व विपुल दयेने,","poem":2},{"lineBreak":true},{"text":"त्यांनी इस्राएलसाठी केल्या.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ते म्हणाले, “ते निश्चितच माझे लोक आहेत,","poem":1},{"text":"जी लेकरे माझ्याशी एकनिष्ठ राहतील;”","poem":2},{"lineBreak":true},{"text":"म्हणून ते त्यांचे तारणकर्ता झाले.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"त्यांना होणार्‍या सर्व क्लेशांनी तेही व्यथित झाले,","poem":1},{"text":"आणि त्यांच्या समक्षतेच्या स्वर्गदूताने","poem":2},{"noteId":50},{"text":"इस्राएलचा उद्धार केला.","poem":2},{"text":"याहवेहच्या प्रीती व करुणेमुळेच त्यांनी त्यांचा उद्धार केला;","poem":1},{"text":"व त्यांना उचलून","poem":2},{"lineBreak":true},{"text":"प्राचीन कालापासून त्यांचा भार वाहिला.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तरीही त्यांनी बंड केले","poem":1},{"text":"व याहवेहच्या पवित्र आत्म्याला खिन्न केले.","poem":2},{"text":"म्हणून याहवेह मागे वळले व त्यांचे शत्रू झाले","poem":1},{"text":"आणि याहवेहने स्वतः त्यांच्याविरुद्ध लढा दिला.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"मग त्यांच्या लोकांना पूर्वीचे दिवस आठवले,","poem":1},{"text":"मोशे आणि त्यांच्या लोकांचे दिवस—","poem":2},{"text":"ज्यांनी त्यांच्या मेंढपाळासह पूर्ण कळपाला","poem":1},{"text":"समुद्रमार्गी बाहेर काढले, ते कुठे आहेत?","poem":2},{"text":"त्यांच्यामध्ये आपला पवित्र आत्मा पाठविणारे","poem":1},{"text":"ते कुठे आहेत?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"मोशेच्या उजव्या हाताजवळ राहण्यासाठी","poem":1},{"text":"आपल्या प्रतापी सामर्थ्याची भुजा पाठविणारे,","poem":2},{"text":"त्यांच्यासमोर समुद्राच्या जलास दुभागून","poem":1},{"text":"अजरामर किर्ती मिळविली,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"समुद्राच्या तळातून त्यांना कोणी पार नेले?","poem":1},{"lineBreak":true},{"text":"उघड्या रानात असणार्‍या घोड्यांप्रमाणे,","poem":1},{"text":"ते कधी अडखळले नाहीत;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"जशी गुरे सपाटीवर जातात,","poem":1},{"text":"तसे याहवेहच्या आत्म्याने त्यांना विसावा दिला.","poem":2},{"text":"आपले नाव प्रतापी व्हावे म्हणून","poem":1},{"text":"तुम्ही तुमच्या लोकांचे मार्गदर्शन केले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"हे याहवेह, स्वर्गातून अवलोकन करा व पाहा,","poem":1},{"text":"तुमच्या भव्य, पवित्र, गौरवी सिंहासनावरून खाली पाहा.","poem":2},{"text":"तुमचा तो आवेश व तुमचे सामर्थ्य कुठे आहेत?","poem":1},{"text":"तुमची आमच्यावरील कोमलता व करुणा आम्हाला देण्याचे तुम्ही आवरून धरले आहे.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"परंतु तुम्हीच आमचे पिता आहात,","poem":1},{"text":"जरी अब्राहाम आम्हाला ओळखत नाही","poem":2},{"lineBreak":true},{"text":"इस्राएलने आम्हाला नाकारले आहे;","poem":2},{"text":"तरी तुम्ही, हे याहवेह, आमचे पिता आहात,","poem":1},{"text":"आमचे युगायुगांचे उद्धारकर्ता, हेच तुमचे नाव आहे.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"हे याहवेह, तुम्ही आम्हाला तुमच्या मार्गावरून भटकून का जाऊ दिले?","poem":1},{"text":"आणि आम्ही तुमचा सन्मान करणार नाही, अशी आमची अंतःकरणे कठीण का केली?","poem":2},{"text":"जे वंशज तुमचे वारस आहेत,","poem":1},{"text":"त्या तुमच्या सेवकांप्रीत्यर्थ परत या.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"थोड्या काळाकरिता तुमच्या लोकांनी तुमच्या पवित्र भूमीचा ताबा घेतला,","poem":1},{"text":"परंतु आता आमच्या शत्रूंनी तुमच्या पवित्रस्थानास तुडविले आहे.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"तुम्ही प्राचीन काळापासून अस्तित्वात आहात;","poem":1},{"text":"पण तुम्ही त्यांच्यावर राज्य केले नाही,","poem":2},{"lineBreak":true},{"text":"ते तुमच्या नावाने संबोधले जात नाहीत","poem":2},{"noteId":51},{"text":".","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":50,"caller":"+","text":"किंवा याहवेहच्या स्वतःच्या समक्षतेने त्यांना वाचविले","reference":{"chapter":63,"verse":9}},{"noteId":51,"caller":"+","text":"किंवा असे लोक ज्यांच्यावर तुम्ही कधीही राज्य केले नाही","reference":{"chapter":63,"verse":19}}]},"thisChapterLink":"/api/mar_cbi/ISA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/62.json","previousChapterAudioLinks":{},"numberOfVerses":19}