{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ISA","translationId":"mar_cbi","name":"यशायाह","commonName":"यशायाह","title":"यशायाहची भविष्यवाणी","order":23,"numberOfChapters":66,"sha256":"716a21f0580760cfae66702316116c82c711ecaa6af3fde6fd0f0c97f59d4af8","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mar_cbi/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":["तरीसुद्धा, जे संकटात होते त्यांच्यासाठी यापुढे निस्तेज काळोखी नसेल. भूतकाळात त्यांनी जबुलून प्रांत आणि नफताली प्रांतांना नमविले होते, परंतु भविष्यामध्ये ते समुद्राच्या मार्गाकडून जाणाऱ्या यार्देनेच्या पलीकडील गालील राष्ट्रांचा सन्मान करतील—"]},{"type":"verse","number":2,"content":[{"text":"अंधारात चालणाऱ्या लोकांनी","poem":1},{"text":"मोठा प्रकाश पाहिला आहे;","poem":2},{"text":"गडद अंधकार असलेल्या देशात राहणाऱ्यांवर","poem":1},{"text":"प्रकाश उदय पावला आहे.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तुम्ही राष्ट्राचा विस्तार केला आहे","poem":1},{"text":"आणि त्यांचा आनंद वाढविला आहे.","poem":2},{"text":"जसे लोक कापणीच्या वेळेस आनंद करतात,","poem":1},{"text":"तसे ते तुमच्यासमोर आनंद करतात,","poem":2},{"text":"लुटलेला माल वाटून घेतांना","poem":1},{"text":"युद्ध करणारे आनंद करतात तसे.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"कारण जसे मिद्यानाच्या पराभवाच्या दिवसामध्ये,","poem":1},{"text":"तुम्ही त्यांच्यावर ओझे असलेले जोखड,","poem":2},{"text":"त्यांच्या खांद्यांवरील लोखंडाची सळई,","poem":1},{"text":"त्यांच्यावर जुलूम करणाऱ्याची काठी","poem":2},{"lineBreak":true},{"text":"मोडून टाकली आहे.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"लढाईत वापरलेले प्रत्येक योद्ध्याची पायतणे","poem":1},{"text":"आणि रक्ताने माखलेले प्रत्येक वस्त्र","poem":2},{"text":"जळण्यासाठी पूर्वनियोजित केले जाईल,","poem":1},{"text":"जाळण्यासाठी इंधन असे होईल.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"कारण आम्हासाठी एक बाळ जन्मले आहे,","poem":1},{"text":"आमच्यासाठी एक पुत्र दिला आहे,","poem":2},{"lineBreak":true},{"text":"आणि सत्ता त्यांच्या खांद्यावर असेल.","poem":2},{"text":"आणि त्यांना","poem":1},{"text":"अद्भुत सल्लागार, पराक्रमी परमेश्वर,","poem":2},{"lineBreak":true},{"text":"सार्वकालिक पिता, शांतीचा राजकुमार असे म्हणतील.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"त्यांच्या सत्तेच्या महानतेचा आणि शांतीचा","poem":1},{"text":"अंत होणार नाही.","poem":2},{"text":"ते दावीदाच्या सिंहासनावरून राज्य करतील","poem":1},{"text":"आणि त्याच्या राज्यावर राज्य करतील,","poem":2},{"text":"ते त्या काळापासून आणि सर्वकाळपर्यंत","poem":1},{"text":"न्याय आणि धार्मिकता","poem":2},{"lineBreak":true},{"text":"स्थापन करतील आणि टिकवतील.","poem":2},{"text":"सर्वसमर्थ याहवेहचा आवेश","poem":1},{"text":"हे पूर्ण करेल.","poem":2}]},{"type":"heading","content":["इस्राएलविरुद्ध याहवेहचा क्रोध"]},{"type":"verse","number":8,"content":[{"text":"प्रभूंनी याकोबाविरुद्ध संदेश पाठवला आहे;","poem":1},{"text":"तो इस्राएलवर पडेल.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"सर्व लोकांना ते माहीत होईल—","poem":1},{"text":"एफ्राईम आणि शोमरोन येथील नागरिक—","poem":2},{"text":"जे अभिमानाने","poem":1},{"text":"आणि अंतःकरणाच्या उद्धटपणाने असे म्हणतात,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“विटा खाली पडल्या आहेत,","poem":1},{"text":"परंतु आम्ही ते घडविलेल्या दगडाने पुन्हा बांधू;","poem":2},{"text":"उंबराची झाडे कापली गेली आहेत,","poem":1},{"text":"परंतु आम्ही त्यांच्या जागी देवदारू लावू.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"परंतु याहवेहनी रसीनच्या शत्रूंना त्यांच्याविरुद्ध बळकट केले आहे","poem":1},{"text":"आणि त्यांच्या शत्रूंना प्रेरित केले आहे.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"पूर्वेकडून अरामी आणि पश्चिमेकडील पलिष्टींनी","poem":1},{"text":"इस्राएलला मोठा आ वासून गिळंकृत केले आहे.","poem":2},{"lineBreak":true},{"text":"हे सर्व करूनही त्यांचा संताप अजून शमला नाही,","poem":1},{"text":"त्यांचा हात अजूनही उगारलेलाच आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"परंतु ज्या लोकांनी त्यांना वधले, त्यांच्याकडे ते परत आले नाहीत,","poem":1},{"text":"आणि त्यांनी सर्वसमर्थ याहवेहचा शोधही घेतला नाही.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"म्हणून याहवेह एकाच दिवसात इस्राएलचे मस्तक आणि शेपूट,","poem":1},{"text":"खजूराच्या फांद्या आणि लव्हाळा हे दोन्ही कापून टाकतील;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"वडीलजन आणि मान्यवर लोक हे मस्तक आहेत,","poem":1},{"text":"खोटे शिक्षण देणारे संदेष्टे हे शेपूट आहेत.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"या लोकांना मार्गदर्शन करणारे त्यांची दिशाभूल करतात,","poem":1},{"text":"आणि ज्यांना मार्गदर्शन मिळाले, ते पथभ्रष्ट झाले आहेत.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"म्हणूनच प्रभू त्यांच्या तरुण पुरुषांना पाहून प्रसन्न होणार नाहीत;","poem":1},{"text":"त्यांना विधवांचा आणि अनाथांचा कळवळा येणार नाही;","poem":2},{"text":"कारण हे सर्वच अधर्मी व दुष्ट असून,","poem":1},{"text":"प्रत्येक मुख असत्य बोलणारे आहे.","poem":2},{"lineBreak":true},{"text":"हे सर्व करूनही त्यांचा संताप अजून शमला नाही,","poem":1},{"text":"त्यांचा हात अजूनही उगारलेलाच आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"दुष्टता निश्चितच अग्नीप्रमाणे जळते.","poem":1},{"text":"ती काटेरी झुडपे आणि काटेरी झाडे यांना भस्म करते,","poem":2},{"text":"ती झाडेझुडपांचे रान पेटवून टाकते,","poem":1},{"text":"त्यामुळे तो धुराचा एक स्तंभ होऊन गरगर फिरत वर जातो.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"सर्वसमर्थ याहवेहच्या क्रोधाने","poem":1},{"text":"भूमी होरपळून जाईल","poem":2},{"text":"आणि लोक त्या आगीचे इंधन होतील;","poem":1},{"text":"ते एकमेकांना वाचविणार नाहीत.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"उजव्या बाजूला असलेले ते फस्त करतील","poem":1},{"text":"परंतु ते भुकेले राहतील;","poem":2},{"text":"डाव्या बाजूला असलेलेही खातील","poem":1},{"text":"परंतु समाधानी होणार नाहीत.","poem":2},{"text":"प्रत्येकजण स्वतःच्याच संततीचे मांस","poem":1},{"noteId":12},{"text":"खातील:","poem":1}]},{"type":"verse","number":21,"content":[{"text":"मनश्शेह एफ्राईमला आणि एफ्राईम मनश्शेहला खाऊन टाकेल;","poem":2},{"lineBreak":true},{"text":"ते एकत्र मिळून यहूदीयाच्या विरोधात जातील.","poem":2},{"lineBreak":true},{"text":"हे सर्व करूनही त्यांचा संताप अजून शमला नाही,","poem":1},{"text":"त्यांचा हात अजूनही उगारलेलाच आहे.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":12,"caller":"+","text":"किंवा बाहू","reference":{"chapter":9,"verse":20}}]},"thisChapterLink":"/api/mar_cbi/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}