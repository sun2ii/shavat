{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"JDG","translationId":"mar_cbi","name":"शास्ते","commonName":"शास्ते","title":"शास्ते","order":7,"numberOfChapters":21,"sha256":"a747c6ea09ff66e0dd962cc56e6f75063012af3713d4add71846b6eaf4f75b77","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/mar_cbi/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"heading","content":["दबोराचे गीत"]},{"type":"verse","number":1,"content":["त्या दिवशी दबोरा आणि अबीनोअमाचा पुत्र बाराकाने हे गीत गाईले:"]},{"type":"verse","number":2,"content":[{"text":"“जेव्हा इस्राएलचे राजकुमार पुढे चालतात,","poem":1},{"text":"जेव्हा लोक स्वेच्छेने स्वतःला सादर करतात—","poem":2},{"lineBreak":true},{"text":"याहवेहची स्तुती करा!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“अहो राजांनो हे ऐका! अधिपतींनो कान द्या!","poem":1},{"text":"मी स्वतः याहवेहची","poem":2},{"noteId":10},{"text":"स्तुती करेन;","poem":2},{"lineBreak":true},{"text":"मी याहवेह इस्राएलच्या परमेश्वराची स्तुती गाईन.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“जेव्हा याहवेह तुम्ही सेईरातून बाहेर निघाले,","poem":1},{"text":"जेव्हा तुम्ही एदोमाच्या भूमीतून चालत गेले,","poem":2},{"text":"पृथ्वी थरारली, आकाशाने जल ओतले,","poem":1},{"text":"ढगांनी जलबिंदू खाली ओतले.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"याहवेहसमोर पर्वत थरथरला,","poem":1},{"text":"याहवेह इस्राएलच्या परमेश्वरासमोर सीनाय थरकापला.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“अनथाचा पुत्र शमगारच्या दिवसामध्ये,","poem":1},{"text":"याएलच्या काळी राजमार्ग सुने पडले;","poem":2},{"lineBreak":true},{"text":"प्रवाशांनी वळणाचा मार्ग वापरला.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"इस्राएलमधील ग्रामीण लढणार नाहीत;","poem":1},{"text":"मी, दबोरा उठेपर्यंत ते थांबले,","poem":2},{"lineBreak":true},{"text":"मी, इस्राएलमधील एक माता उठेपर्यंत ते थांबले.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"परमेश्वराने नवीन पुढारी निवडले","poem":1},{"text":"जेव्हा युद्ध शहराच्या वेशीजवळ आले होते,","poem":2},{"text":"परंतु इस्राएलाच्या चाळीस हजारांमध्ये","poem":1},{"text":"एकही ढाल किंवा भाला दिसला नाही.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"माझे हृदय इस्राएलच्या राजपुत्रांसह आहे,","poem":1},{"text":"लोकांमध्ये स्वेच्छेने काम करणाऱ्यांबरोबर आहे.","poem":2},{"lineBreak":true},{"text":"याहवेहची स्तुती हो!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“तुम्ही जे शुभ्र गाढवांवर स्वार होता,","poem":1},{"text":"गालिचांच्या खोगिरावर बसता,","poem":2},{"lineBreak":true},{"text":"आणि तुम्ही त्या मार्गाने पायी चालणारे,","poem":2},{"text":"विचार करा,","poem":1}]},{"type":"verse","number":11,"content":[{"text":"गायकांचा आवाज पाणवठ्याच्या ठिकाणी.","poem":1},{"text":"ते याहवेहचे विजयगीत गातात,","poem":2},{"lineBreak":true},{"text":"इस्राएलच्या गावकर्‍यांच्या विजयाचे स्मरण करतात.","poem":2},{"lineBreak":true},{"text":"“नंतर याहवेहचे लोक","poem":1},{"text":"शहराच्या द्वाराजवळ गेले.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"‘दबोरा जागी हो, जागी हो!","poem":1},{"text":"जागी हो, जागी हो, तुझ्या मुखातून गीत भरभरून वाहो!","poem":2},{"text":"ऊठ, हे बाराका!","poem":1},{"text":"हे अबीनोअमाच्या पुत्रा, तू बंधनात टाकलेल्या बंदिवानांना घेऊन जा.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“राहिलेले सरदार खाली आले;","poem":1},{"text":"याहवेहचे लोक बलवान लोकांविरुद्ध माझ्याकडे आले.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ज्यांचे मूळ अमालेकामध्ये होते, ते काही लोक एफ्राईमामधून आले;","poem":1},{"text":"बिन्यामीन तुम्हाला अनुसरण करणार्‍या लोकांसह होते.","poem":2},{"text":"माखीराचे सरदारही आले,","poem":1},{"text":"जबुलूनाचे दंडधारी","poem":2},{"noteId":11},{"text":"सेनापतिसुद्धा आले.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"इस्साखारचे राजपुत्र दबोरा सोबत होते;","poem":1},{"text":"होय, इस्साखार बाराक सोबत,","poem":2},{"lineBreak":true},{"text":"रऊबेनच्या जिल्ह्यांमध्ये","poem":2},{"text":"त्याच्या नेतृत्वाखाली खोर्‍यामध्ये पाठविले","poem":1},{"text":"अंतःकरणाचा बारकाईने शोध घेतला गेला.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"मेंढ्यांच्या कळपांची शिट्टी","poem":1},{"text":"ऐकण्यासाठी तू मेंढवाड्यात","poem":2},{"noteId":12},{"text":"का राहिलास?","poem":2},{"text":"रऊबेनच्या जिल्ह्यांमध्ये","poem":1},{"text":"अंतःकरणाचा बारकाईने शोध घेतला गेला.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"गिलआद यार्देनेपलीकडे राहिला,","poem":1},{"text":"पण दान आपल्या जहाजांपाशीच का राहिला?","poem":2},{"text":"आशेर सागरकिनारीच राहिला","poem":1},{"text":"आणि खाडीतील त्याच्या सुरक्षित स्थळी राहिला.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"जबुलूनच्या लोकांनी आपल्या जीव धोक्यात घातला;","poem":1},{"text":"तसेच नफतालीच्या लोकांनी रणभूमीवर मरणाचा धोका पत्करला.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“राजे आले, ते लढले,","poem":1},{"text":"कनानाचे राजे लढले,","poem":2},{"text":"मगिद्दोच्या झर्‍याजवळ तानख येथे लढले,","poem":1},{"text":"त्यांनी चांदीची लूट घेतली नाही.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"आकाशातून तारे लढले,","poem":1},{"text":"त्यांच्या मार्गावरून ते सिसेराशी लढले.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"किशोन नदीने त्यांना वाहून नेले,","poem":1},{"text":"पुरातन नदी, किशोन नदी.","poem":2},{"lineBreak":true},{"text":"कूच कर, माझ्या आत्म्या; समर्थ होऊन पुढे जा!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"घोड्यांच्या टापांचा गडगडाट झाला—","poem":1},{"text":"घोडे चौखूर उधळले, त्याचे सशक्त घोडे चौखूर उधळले!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"याहवेहच्या दूताने आदेश दिला, ‘मेरोजला शाप द्या.","poem":1},{"text":"त्याच्या लोकांना कडवटपणे शाप द्या,","poem":2},{"text":"कारण ते याहवेहला मदत करावयाला आले नाहीत,","poem":1},{"text":"पराक्रमी लोकांविरुद्ध याहवेहला मदत करावयाला आले नाहीत.’","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“स्त्रियांमध्ये सर्वाधिक आशीर्वादित याएल,","poem":1},{"text":"केनी हेबेरची पत्नी,","poem":2},{"lineBreak":true},{"text":"तंबूत राहणार्‍या स्त्रियांमध्ये सर्वात धन्य.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"त्याने पाणी मागितले आणि तिने त्याला दूध दिले;","poem":1},{"text":"आणि सरदाराला साजेल अशा वाटीत त्याला दही दिले.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"तिचा हात तंबूच्या खुंटीकडे गेला,","poem":1},{"text":"उजवा हात कामगाराच्या हातोडीसाठी.","poem":2},{"text":"तिने सिसेराला मारले, तिने त्याचे डोके चिरडले.","poem":1},{"text":"तिने त्याच्या कपाळाचे भोसकून तुकडे केले.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"तिच्या पायाशी तो खचला, तो पडला,","poem":1},{"text":"जिथे तो पडला; तिथेच तो पडून राहिला.","poem":2},{"text":"तिच्या पायाशी तो खचला, तो पडला;","poem":1},{"text":"जिथे तो खचला, तिथे तो पडला व मेला.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“खिडकीतून सिसेराच्या आईने डोकावले;","poem":1},{"text":"जाळीच्या मागे ती ओरडली,","poem":2},{"text":"‘त्याचा रथ येण्यास इतका वेळ का लागला आहे?","poem":1},{"text":"त्याच्या रथांचा कल्लोळ ऐकू येण्यास का उशीर होत आहे?’","poem":2}]},{"type":"verse","number":29,"content":[{"text":"तिच्यातील हुशार स्त्रिया तिला उत्तर देतात;","poem":1},{"text":"खरंच, ती स्वतःशीच म्हणते,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"‘ते लूट शोधून वाटून तर घेत नाहीत ना:","poem":1},{"text":"प्रत्येक पुरुषासाठी एक किंवा दोन स्त्रिया,","poem":2},{"text":"सिसेरासाठी लूट म्हणून रंगीबेरंगी वस्त्रे,","poem":1},{"text":"रंगीबेरंगी नक्षीदार वस्त्रे,","poem":2},{"text":"माझ्या गळ्यात भरतकाम केलेली वस्त्रे—","poem":1},{"text":"ही सर्व लूट म्हणून आहेत काय?’","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“याहवेह याप्रकारे तुमच्या सर्व शत्रूंचा नाश होवो!","poem":1},{"text":"जसा सूर्य आपल्या सामर्थ्याने उगवतो तसे,","poem":2},{"lineBreak":true},{"text":"जे लोक तुमच्यावर प्रीती करतात ते सर्व त्या सूर्याप्रमाणे होवोत.”","poem":2},"त्यानंतर देशात चाळीस वर्षे देशात शांतता होती."]}],"footnotes":[{"noteId":10,"caller":"+","text":"किंवा याहवेहला","reference":{"chapter":5,"verse":3}},{"noteId":11,"caller":"+","text":"या शब्दाचा अर्थ निश्चित नाही","reference":{"chapter":5,"verse":14}},{"noteId":12,"caller":"+","text":"किंवा शेकोटी","reference":{"chapter":5,"verse":16}}]},"thisChapterLink":"/api/mar_cbi/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}