{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"JER","translationId":"mar_cbi","name":"यिर्मयाह","commonName":"यिर्मयाह","title":"यिर्मयाहची भविष्यवाणी","order":24,"numberOfChapters":52,"sha256":"6e2548f8969bad42c196f15503e8abcfae98acb5f8c49f884a4549b0646916c9","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/mar_cbi/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":2,"content":[{"type":"heading","content":["इस्राएल परमेश्वराचा त्याग करतात"]},{"type":"verse","number":1,"content":["तेव्हा याहवेहचे वचन मला प्राप्त झाले:"]},{"type":"verse","number":2,"content":["“जा आणि यरुशलेमच्या लोकांस याची घोषणा कर:",{"lineBreak":true},"“याहवेह असे म्हणतात:",{"text":"“ ‘मला आठवण आहे, मला प्रसन्न करण्यासाठी","poem":1},{"text":"तुम्ही एखाद्या नववधूप्रमाणे मजवर कशी प्रीती केली.","poem":2},{"text":"आणि रानात","poem":1},{"text":"व पेरणीरहित भूमीत देखील मला अनुसरला.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"इस्राएल हे याहवेहकरिता पवित्र होते;","poem":1},{"text":"त्यांच्या हंगामाचे प्रथमफळ होते.","poem":2},{"text":"ज्यांनी त्यांचा नाश केला,","poem":1},{"text":"त्यांच्यावर दोष लावण्यात आला आणि घोर आपत्तीने त्यांना गाठले,’ ”","poem":2},{"lineBreak":true},{"text":"असे याहवेह जाहीर करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"याकोबाचे वंशजा, याहवेहचे वचन ऐका,","poem":1},{"text":"सर्व इस्राएली कुळांनो तुम्ही सुद्धा.","poem":2}]},{"type":"verse","number":5,"content":["याहवेह असे म्हणतात:",{"text":"“तुमच्या पूर्वजांना माझ्याठायी असा कोणता अन्याय दिसला की","poem":1},{"text":"ते माझ्यापासून इतके दूर गेले?","poem":2},{"text":"आणि ते व्यर्थ मूर्तींना अनुसरू लागले,","poem":1},{"text":"आणि स्वतःही तसेच निरुपयोगी बनले?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"त्यांनी असे विचारले नाही,","poem":1},{"text":"‘ज्यांनी आम्हाला इजिप्तमधून बाहेर आणले","poem":2},{"text":"आणि वैराण प्रदेशातून मार्गस्थ केले,","poem":1},{"text":"वाळवंटातून व दऱ्याखोऱ्यातून नेले,","poem":2},{"text":"निर्जल आणि गडद अंधकाराच्या भूमीतून नेले,","poem":1},{"text":"ज्या प्रदेशातून कोणीही प्रवास करीत नाही","poem":2},{"text":"व जिथे मनुष्यवस्ती नाही त्यातून आम्हाला नेले,","poem":1},{"text":"ते याहवेह कुठे आहेत?’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"मी तुम्हाला एका सुपीक भूमीवर घेऊन आलो,","poem":1},{"text":"तिची उपज आणि तिचे उत्तमोत्तम पदार्थ खाण्यासाठी आणले.","poem":2},{"text":"परंतु तुम्ही ती भूमी अशुद्ध केली","poem":1},{"text":"आणि माझे वतन अमंगळ केले.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"याजकांनी विचारले नाही,","poem":1},{"text":"‘याहवेह कुठे आहेत?’","poem":2},{"text":"नियमांचा अभ्यास करणाऱ्यांना माझी ओळख नव्हती;","poem":1},{"text":"त्यांचे अधिपती तर माझ्याविरुद्ध बंड केले आहे.","poem":2},{"text":"संदेष्टे बआल दैवताद्वारे संदेश देऊ लागले,","poem":1},{"text":"आणि व्यर्थ मूर्तीचे अनुसरण करू लागले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“यास्तव मी तुमच्याविरुद्ध आरोप करणार आहे,”","poem":1},{"text":"असे याहवेह जाहीर करतात.","poem":2},{"lineBreak":true},{"text":"“आणि मी तुमच्या मुलांच्या मुलांवरही आरोप लावणार.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"समुद्राचा किनारा ओलांडून कित्तीम","poem":1},{"noteId":1},{"text":"बेटाच्या तटावर जा आणि पाहा,","poem":1},{"text":"केदारच्या वाळवंटात पाठवा व जवळून चौकशी करा;","poem":2},{"lineBreak":true},{"text":"अशा प्रकारे कधी काही घडले का ते पहा:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"कोणत्याही राष्ट्रांनी आपले दैवत बदलले आहे काय?","poem":1},{"text":"(जरी ते सर्व देव नाहीतच.)","poem":2},{"text":"परंतु माझ्या लोकांनी आपल्या गौरवी परमेश्वराची","poem":1},{"text":"व्यर्थ मूर्तींशी अदलाबदल केली.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"हे पाहून आकाश, विस्मयाने हादरून जा","poem":1},{"text":"आणि भीतीने गर्भगळीत व्हा,”","poem":2},{"lineBreak":true},{"text":"अशी याहवेह घोषणा करतात.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“माझ्या लोकांनी दोन दुष्कर्मे केली आहेत:","poem":1},{"lineBreak":true},{"text":"त्यांनी जीवनदायी पाण्याच्या झर्‍याला,","poem":1},{"text":"म्हणजे मला, सोडले आहे,","poem":2},{"text":"आणि ज्यात पाणी राहत नाही असे फुटके,","poem":1},{"text":"गळके हौद स्वतःसाठी बांधले आहेत.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"जन्मापासूनच इस्राएल एक दास, गुलाम आहेत का?","poem":1},{"text":"मग ते सगळ्यांची लूट का झाले आहेत?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"सिंहगर्जना करतात;","poem":1},{"text":"त्यांनी त्यांच्यावर मोठ्याने गर्जना केली.","poem":2},{"text":"त्यांनी त्यांची भूमी उद्ध्वस्त केली;","poem":1},{"text":"त्यांची गावे जाळली व वैराण केली आहेत.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"मेम्फीस आणि तहपनहेसच्या सर्व लोकांनी","poem":1},{"text":"तुमच्या कवट्यांना भेग पाडली आहे.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ज्या याहवेहनी तुम्हाला योग्य मार्गाने चालविले","poem":1},{"text":"त्या तुमच्या परमेश्वराचा त्याग करून,","poem":2},{"lineBreak":true},{"text":"ही परिस्थिती तुम्ही स्वतःवर ओढवून घेतली नाही का?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"आता इजिप्तकडे कशाला जाता","poem":1},{"text":"नील नदीचे पाणी पिण्यासाठी काय?","poem":2},{"text":"आणि अश्शूराकडे का जावे","poem":1},{"text":"फरात नदीचे पाणी पिण्यासाठी काय?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"तुमचा दुष्टपणाच तुम्हाला शिक्षा देईल;","poem":1},{"text":"तुमचे माघार घेणे तुम्हाला दोषी ठरवेल.","poem":2},{"text":"म्हणून विचार करा आणि तुमच्या लक्षात येईल","poem":1},{"text":"याहवेह तुमच्या परमेश्वराचा त्याग करून दूर जाणे","poem":2},{"text":"तुमच्यासाठी किती वाईट आणि कटू आहे,","poem":1},{"text":"आणि माझे भय तुमच्यामध्ये नाही,”","poem":2},{"lineBreak":true},{"text":"सर्वशक्तिमान याहवेह असे म्हणतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“फार फार पूर्वी तुम्ही माझे जू झुगारून दिले","poem":1},{"text":"व मी बांधलेले दावे तोडून टाकले;","poem":2},{"lineBreak":true},{"text":"तुम्ही म्हटले, ‘आम्ही तुमची सेवा करणार नाही!’","poem":2},{"text":"अर्थात्, प्रत्येक उंच टेकडीवर,","poem":1},{"text":"आणि प्रत्येक विस्तृत वृक्षाखाली","poem":2},{"lineBreak":true},{"text":"तुम्ही वेश्येप्रमाणे निजलात.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"मी तुम्हाला एका उत्तम द्राक्षवेलीप्रमाणे लावले होते","poem":1},{"text":"उत्कृष्ट व विश्वसनीय असे खोड दिले होते.","poem":2},{"text":"मग तुम्ही माझ्याविरुद्ध का झालात","poem":1},{"text":"भ्रष्ट व रानटी लता का झालात?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"तुम्ही स्वतःला साबणाने धुतले","poem":1},{"text":"आणि विपुल प्रमाणात धुण्याची पावडर वापरली,","poem":2},{"lineBreak":true},{"text":"तरी तुमचे कलंक माझ्यापुढे तसेच आहेत,”","poem":2},{"lineBreak":true},{"text":"असे सार्वभौम याहवेह म्हणतात.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“तुम्हाला कसे म्हणता येईल ‘मी अशुद्ध नाही;","poem":1},{"text":"मी बआल दैवताच्या मागे गेलो नाही’?","poem":2},{"text":"दरीत जाऊन तुम्ही कसे वागले ते पाहा,","poem":1},{"text":"तुमच्या आचरणाबद्धल विचार करा.","poem":2},{"text":"इकडे तिकडे पळणार्‍या","poem":1},{"text":"चपळ उंटिणीसारखे तुम्ही आहात.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"वाळवंटात भटकण्याची सवय असलेल्या रानगाढवी प्रमाणे आहात,","poem":1},{"text":"तुमच्या अनावर वासनांमुळे प्रत्येक वाऱ्याचा शोध घेणारे आहात;","poem":2},{"lineBreak":true},{"text":"तुमच्या वासनांना कोणी आवर घालावा?","poem":2},{"text":"कोणत्याही नराने तुमचा माग घेत असता स्वतःस थकवा आणू नये;","poem":1},{"text":"संभोगासमयी त्यांना ती सापडेल.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"तुझे पाय पूर्णपणे खळ्यात उघडे पडेपर्यंत पळू नको,","poem":1},{"text":"आणि तुझ्या घशाला कोरड पडली आहे.","poem":2},{"text":"परंतु तू म्हटले, ‘याचा काही उपयोग नाही!","poem":1},{"text":"मी परकीय दैवतावर प्रेम करतो,","poem":2},{"lineBreak":true},{"text":"आणि मी त्यांचेच अनुसरण करणार.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“चोराला पकडल्यावर जशी त्याला लाज वाटते,","poem":1},{"text":"तसे इस्राएल शरमिंदा झाला आहे—","poem":2},{"text":"ते, त्यांचे राजे व त्यांचे सरदार,","poem":1},{"text":"त्यांचे याजक व त्यांचे संदेष्टे हे सर्वजण.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"लाकडाच्या खांबाला ते म्हणतात, ‘तू आमचा पिता आहेस,’","poem":1},{"text":"आणि पाषाणाला म्हणतात, ‘तू मला जन्म दिलास.’","poem":2},{"text":"त्यांनी माझ्याकडे पाठ फिरविली आहे,","poem":1},{"text":"पण त्यांचे मुख नव्हे;","poem":2},{"text":"परंतु संकट समय येताच ते माझा धावा करून म्हणतात,","poem":1},{"text":"‘या आणि आमचे रक्षण करा!’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"तुम्ही स्वतःसाठी निर्माण केलेली दैवते कुठे आहेत?","poem":1},{"text":"जर ते तुमचे रक्षण करू शकतील, तर त्यांनी यावे","poem":2},{"lineBreak":true},{"text":"तुमच्या संकटसमयी यावे!","poem":2},{"text":"तुम्ही यहूदीया, तुमच्या दैवतांची संख्या इतकी आहे","poem":1},{"text":"जेवढी नगरे तुमच्या प्रांतात आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“तुम्ही माझ्याविरुद्ध आरोप का करता?","poem":1},{"text":"तुम्हा सर्वांनी माझ्याविरुद्ध बंड केले आहे,”","poem":2},{"lineBreak":true},{"text":"असे याहवेह म्हणतात.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"“मी तुमच्या लोकांना उगाच शिक्षा केली;","poem":1},{"text":"त्यांनी सुधारणेचा स्वीकार केला नाही.","poem":2},{"text":"तुमच्याच तलवारीने तुमच्या संदेष्ट्यांचा नाश केला","poem":1},{"text":"जणू एखादा खवखवलेला सिंहच.","poem":2}]},{"type":"verse","number":31,"content":["“या पिढीच्या लोकांनो, याहवेहच्या वचनावर विचार करा:",{"text":"“मी इस्राएलशी एखाद्यावर निर्जन प्रदेशाप्रमाणे","poem":1},{"text":"किंवा अंधाऱ्याप्रदेशाप्रमाणे वागलो काय?","poem":2},{"text":"माझे लोक असे का म्हणतात, ‘आम्ही मन मानेल तसे भटकण्यास मोकळे आहोत;","poem":1},{"text":"आता पुन्हा आम्ही तुमच्याशी संबंध ठेवणार नाही’?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"एखादी कुमारी आपले दागदागिने किंवा","poem":1},{"text":"एखादी वधू आपली विवाहाभूषणे विसरेल का?","poem":2},{"text":"तरी माझे लोक मला,","poem":1},{"text":"असंख्य दिवसापासून विसरले आहेत.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"तुमच्या प्रियकराचे मन वळविण्यात तुम्ही किती तरबेज आहात!","poem":1},{"text":"अत्यंत चरित्रहीन स्त्रियांनाही तुमच्यापासून धडे शिकता येतील.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"निष्पाप लोकांच्या रक्ताने","poem":1},{"text":"तुमची वस्त्रे माखली आहेत,","poem":2},{"lineBreak":true},{"text":"तुमच्या घरात चोरी करण्यासाठी शिरतांना त्यांना तुम्ही बघितले नाही.","poem":2},{"text":"असे सर्व असूनही","poem":1}]},{"type":"verse","number":35,"content":[{"text":"तुम्ही म्हणता, ‘मी निर्दोष आहे;","poem":2},{"lineBreak":true},{"text":"परमेश्वर माझ्यावर रागावले नाहीत.’","poem":2},{"text":"परंतु मी तुमचा न्याय करेन","poem":1},{"text":"कारण तुम्ही म्हटले, ‘मी पाप केलेले नाही.’","poem":2}]},{"type":"verse","number":36,"content":[{"text":"तुम्ही आपले मार्ग सोडून","poem":1},{"text":"पथभ्रष्ट का होता?","poem":2},{"text":"अश्शूरने तुमचा आशाभंग केला","poem":1},{"text":"तसाच इजिप्तही करेल.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"तुम्हीही आपले स्थान सोडणार","poem":1},{"text":"आपले हात डोक्यावर ठेऊन जाल,","poem":2},{"text":"कारण ज्यांच्यावर तुमचा भरवसा आहे, त्यांनाच याहवेहने नाकारले आहे.","poem":1},{"text":"ते तुम्हाला मदत करणारच नाहीत.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":1,"caller":"+","text":"किंवा जे सध्याच्या काळात सायप्रस म्हणून ओळखले जाते","reference":{"chapter":2,"verse":10}}]},"thisChapterLink":"/api/mar_cbi/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/JER/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}