{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"JER","translationId":"mar_cbi","name":"यिर्मयाह","commonName":"यिर्मयाह","title":"यिर्मयाहची भविष्यवाणी","order":24,"numberOfChapters":52,"sha256":"6e2548f8969bad42c196f15503e8abcfae98acb5f8c49f884a4549b0646916c9","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/mar_cbi/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":30,"content":[{"type":"heading","content":["इस्राएलचे पुनर्वसन"]},{"type":"verse","number":1,"content":["याहवेहकडून यिर्मयाहला हे वचन प्राप्त झाले:"]},{"type":"verse","number":2,"content":["“इस्राएलचे परमेश्वर याहवेह असे म्हणतात: ‘मी तुला सांगितलेली सर्व वचने एका नोंदवहीत लिहून ठेव."]},{"type":"verse","number":3,"content":["याहवेह जाहीर करतात, असे दिवस येत आहेत की जेव्हा मी इस्राएल आणि यहूदीयातील माझ्या लोकांना बंदिवासातून परत आणेन",{"noteId":24},"व त्यांच्या पूर्वजांना मी वतन म्हणून दिलेल्या भूमीवर पुनर्स्थापित करेन,’ असे याहवेह म्हणतात.”"]},{"type":"verse","number":4,"content":["इस्राएल व यहूदीया यांच्यासंबंधी याहवेह असे म्हणतात:"]},{"type":"verse","number":5,"content":["“याहवेह म्हणतात:",{"text":"“ ‘त्यांचा भयभीत आक्रोश ऐकू येत आहे—","poem":1},{"text":"शांती नव्हे, तर दहशत.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"विचारून पाहा:","poem":1},{"text":"पुरुष मुले प्रसवू शकतात काय?","poem":2},{"text":"मग प्रसूती वेदनांनी व्याकूळ झालेल्या स्त्रियांप्रमाणे","poem":1},{"text":"आपल्या पोटावर हात ठेऊन","poem":2},{"lineBreak":true},{"text":"मेल्यागत फिक्के पडलेल्या चेहऱ्याचे बलवान पुरुष मला का दिसत आहेत?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"हाय हाय! तो दिवस किती भयंकर असेल!","poem":1},{"text":"इतर कोणताही दिवस असा नसेल.","poem":2},{"text":"याकोबासाठी तो संकटकाळ असेल.","poem":1},{"text":"पण तो यातून वाचून बाहेर पडेल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“कारण सर्वसमर्थ याहवेह जाहीर करतात,","poem":1},{"text":"‘त्या दिवशी,’ मी त्यांच्या मानेवरचे जू मोडून टाकेन,","poem":2},{"text":"त्यांच्या बेड्या तोडेन,","poem":1},{"text":"आणि यापुढे परकीय लोक त्यांना गुलाम करणार नाहीत;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"याउलट, ते व दावीद, त्यांचा राजा,","poem":1},{"text":"ज्याला मी त्यांच्यातून उभारेन,","poem":2},{"lineBreak":true},{"text":"ते त्यांचे परमेश्वर याहवेहची सेवा करतील!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘म्हणून भिऊ नको! याकोबा, माझ्या सेवका;","poem":1},{"text":"हे इस्राएला, निराश होऊ नको,’","poem":2},{"lineBreak":true},{"text":"याहवेह असे जाहीर करतात.","poem":2},{"text":"‘मी तुला निश्चितच दूरच्या देशातून,","poem":1},{"text":"व तुझ्या वंशजांना त्यांच्या बंदिवासातून वाचवेन.","poem":2},{"text":"याकोबाला परत शांती व संरक्षण लाभेल","poem":1},{"text":"आणि त्यांना कोणीही भयभीत करणार नाही.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"कारण याहवेह जाहीर करतात,","poem":1},{"text":"‘मी तुझ्याबरोबर आहे आणि तुझी मुक्तता करेन.","poem":2},{"text":"जरी ज्या राष्ट्रात मी तुझी पांगापांग केली,","poem":1},{"text":"त्या राष्ट्रांचा मी समूळ नायनाट केला,","poem":2},{"lineBreak":true},{"text":"तरी मी तुझा पूर्णपणे नायनाट करणार नाही.","poem":2},{"text":"मी तुला योग्य शासन करेन, पण ते मर्यादित;","poem":1},{"text":"तुला शिक्षा केल्यावाचून सोडणार नाही.’","poem":2}]},{"type":"verse","number":12,"content":["“याहवेह असे म्हणतात:",{"text":"“ ‘तुझी जखम असाध्य आहे,","poem":1},{"text":"तुझा घाव बरा होण्यापलिकडे आहे.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तुझे समर्थन करण्यासाठी कोणीही नाही,","poem":1},{"text":"तुझ्या दुखापतीवर काहीही इलाज नाही,","poem":2},{"lineBreak":true},{"text":"तुला आरोग्य प्राप्त होणार नाही.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"तुझे सर्व मित्रगण तुला विसरले आहेत;","poem":1},{"text":"त्यांना तुझी चिंता नाही;","poem":2},{"text":"एखाद्या शत्रुगत मी तुला जखमी केले आहे","poem":1},{"text":"निर्दयागत मी तुला शासन केले,","poem":2},{"text":"कारण तुझा अपराध फार मोठा आहे","poem":1},{"text":"तुझी पातके पुष्कळ झाली आहेत.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"तुझ्या जखमेबद्दल तू विलाप का करतोस,","poem":1},{"text":"तुझ्या दुखण्यावर काहीही इलाज नाही का?","poem":2},{"text":"कारण तुझा अपराध खूप मोठा व तुझी पातके अनेक आहेत","poem":1},{"text":"म्हणून मी तुझ्याशी असा व्यवहार केला.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“ ‘परंतु ज्यांनी तुला गिळंकृत केले, ते गिळंकृत केले जातील;","poem":1},{"text":"तुझे सर्व शत्रू बंदिवासात जातील.","poem":2},{"text":"ज्यांनी तुला लुटले, तेच लुटले जातील;","poem":1},{"text":"ज्यांनी तुला लुबाडले, तेच लुबाडल्या जातील.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"मी तुझे आरोग्य पुनर्स्थापित करेन","poem":1},{"text":"आणि तुझ्या जखमा बर्‍या करेन,’ याहवेह जाहीर करतात,","poem":2},{"text":"‘कारण तू बहिष्कृत म्हणविली जात होती,","poem":1},{"text":"सीयोन नगरी, जिची कोणासही चिंता नाही.’","poem":2}]},{"type":"verse","number":18,"content":["“परंतु याहवेह असे म्हणतात:",{"text":"“ ‘मी तुझी धनसंपत्ती तुला परत देईन,","poem":1},{"text":"आणि याकोबाच्या निवासावर करुणा करेन;","poem":2},{"text":"त्याच्या भग्नावशेषांवरही नगरी पुन्हा बांधली जाईल","poem":1},{"text":"आणि राजवाडा पुन्हा त्याच्या ठराविक जागी उभारला जाईल.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"तिथून उपकारस्तुतिगान गाईले जातील","poem":1},{"text":"आणि आनंदगीतांचे ध्वनी येतील.","poem":2},{"text":"मी त्यांची लोकसंख्या वाढवेन,","poem":1},{"text":"पण त्यात घट होऊ देणार नाही;","poem":2},{"text":"मी त्यांना प्रतिष्ठित करेन,","poem":1},{"text":"पण ते तुच्छ मानले जाणार नाहीत.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"त्यांची मुलेबाळे पूर्ववत होतील,","poem":1},{"text":"त्यांचे समाज माझ्यासमोर स्थापित होतील;","poem":2},{"lineBreak":true},{"text":"त्यांचा छळ करणार्‍या सर्वांना मी शिक्षा करेन.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"त्यांना त्यांच्या स्वजनापैकीच राजा पुन्हा लाभेल;","poem":1},{"text":"त्यांचा शासनकर्ता त्यांच्यामधून उभारल्या जाईल.","poem":2},{"text":"मी त्याला माझ्या निकट आणेन आणि तो माझ्या निकट येईल,","poem":1},{"text":"कारण माझ्या निकट येण्यासाठी","poem":2},{"lineBreak":true},{"text":"त्याने स्वतःस मला समर्पित केले पाहिजे ना?’","poem":2},{"lineBreak":true},{"text":"असे याहवेह जाहीर करतात.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"‘तुम्ही माझे लोक व्हाल","poem":1},{"text":"व मी तुमचा परमेश्वर होईन.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"पाहा, याहवेहचे भयावह वादळ पाहा.","poem":1},{"text":"त्याचा प्रकोपात स्फोट होईल,","poem":2},{"text":"दुष्टांच्या मस्तकावर","poem":1},{"text":"ते एका वावटळीप्रमाणे येईल.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"याहवेहच्या अंतःकरणाचा उद्देश","poem":1},{"text":"पूर्ण झाल्याशिवाय","poem":2},{"lineBreak":true},{"text":"त्यांचा महाभयंकर क्रोध शांत होणार नाही.","poem":2},{"text":"पुढे येणाऱ्या दिवसात","poem":1},{"text":"तुला हे कळेल.","poem":2}]}],"footnotes":[{"noteId":24,"caller":"+","text":"किंवा माझ्या इस्राएल आणि यहूदीयाच्या लोकांची समृद्धी मी परत आणेन","reference":{"chapter":30,"verse":3}}]},"thisChapterLink":"/api/mar_cbi/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}