{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"JER","translationId":"mar_cbi","name":"यिर्मयाह","commonName":"यिर्मयाह","title":"यिर्मयाहची भविष्यवाणी","order":24,"numberOfChapters":52,"sha256":"6e2548f8969bad42c196f15503e8abcfae98acb5f8c49f884a4549b0646916c9","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/mar_cbi/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["याहवेह जाहीर करतात, “त्याकाळी मी इस्राएलमधील सर्व कुळांचा परमेश्वर असेन व ते माझे लोक असतील.”"]},{"type":"verse","number":2,"content":["याहवेह जे म्हणतात ते असे:",{"text":"“जे तलवारीच्या प्रहारातून वाचले","poem":1},{"text":"त्यांना रानात अनुकूलता सापडेल","poem":2},{"lineBreak":true},{"text":"इस्राएलला विश्रांती देण्यासाठी मी स्वतः येईन.”","poem":2}]},{"type":"verse","number":3,"content":["कारण पूर्वी याहवेहने आम्हाला दर्शन दिले व म्हटले:",{"text":"“मी सार्वकालिक प्रीतीने तुमच्यावर प्रीती केली आहे;","poem":1},{"text":"मी अविनाशी प्रेमदयेने तुम्हाला माझ्याकडे ओढून घेतले आहे.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मी तुला पुन्हा उभारेन,","poem":1},{"text":"आणि तू, इस्राएली कुमारिके, पुनर्वसित होशील.","poem":2},{"text":"तू पुन्हा तुझे खंजीर घेशील","poem":1},{"text":"आणि बाहेर जाऊन आनंदाने नृत्य करशील.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"शोमरोनच्या डोंगरावर","poem":1},{"text":"तू पुन्हा आपले द्राक्षमळे लावशील;","poem":2},{"text":"शेतकरी ते मळे लावतील","poem":1},{"text":"व स्वतःची फळे खाण्याचा आनंद उपभोगतील.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"‘चला, उठा, आपण सीयोनकडे जाऊ,","poem":1},{"text":"आपले परमेश्वर याहवेहकडे, जाऊ या.’ ”","poem":2},{"text":"पहारेकरी एफ्राईमच्या टेकड्यांवरून","poem":1},{"text":"अशी आरोळी मारण्याचा दिवस येत आहे,","poem":2}]},{"type":"verse","number":7,"content":["याहवेह असे म्हणतात:",{"text":"“याकोबासाठी हर्षाने गाणी गा;","poem":1},{"text":"सर्वश्रेष्ठ इस्राएली राष्ट्रासाठी गर्जना करा.","poem":2},{"text":"तुमचे स्तुतिगान जाहीरपणे ऐकू यावे आणि म्हणा,","poem":1},{"text":"‘याहवेह, आपल्या लोकांचे,","poem":2},{"lineBreak":true},{"text":"इस्राएलाच्या अवशेषाचे तारण करा’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"पाहा, मी त्यांना उत्तरेकडील देशातून आणेन","poem":1},{"text":"आणि पृथ्वीच्या दिगंतापासून गोळा करेन.","poem":2},{"text":"त्यांच्यात आंधळे व पांगळे,","poem":1},{"text":"गर्भवती स्त्रिया, प्रसूती वेदना लागलेल्या माता असतील;","poem":2},{"lineBreak":true},{"text":"फार मोठा समुदाय परत येईल.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ते आनंदाश्रू ढाळतील.","poem":1},{"text":"मी त्यांना परत आणतांना ते प्रार्थना करतील.","poem":2},{"text":"मी त्यांना जलप्रवाहाच्या बाजूने चालवेन","poem":1},{"text":"समतल भूमीवरून ते न अडखळता चालतील,","poem":2},{"text":"कारण मी इस्राएलचा पिता आहे,","poem":1},{"text":"आणि एफ्राईम माझा ज्येष्ठपुत्र आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“अहो राष्ट्रांनो, याहवेहचे वचन ऐका,","poem":1},{"text":"आणि दूरवरील सर्व सागरतीरांवर ते जाहीर करा:","poem":2},{"text":"‘ज्यांनी इस्राएली लोकांना विखरले, तेच त्यांना एकत्र करतील.","poem":1},{"text":"मेंढपाळाप्रमाणे आपल्या कळपांची निगा राखतील.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"याहवेह याकोबाची सुटका करतील","poem":1},{"text":"आणि त्यांच्यापेक्षा बलाढ्य राष्ट्रांपासून त्यांना सोडवितील.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ते येतील आणि सीयोनाच्या टेकड्यांवर हर्षगीते गातील;","poem":1},{"text":"याहवेहच्या विपुल पुरवठ्यासाठी—","poem":2},{"text":"धान्य, नवा द्राक्षारस, आणि जैतुनाचे तेल,","poem":1},{"text":"गुरातील व कळपातील पिल्लांसाठी आनंद करतील.","poem":2},{"text":"भरपूर पाणी दिलेल्या बागेप्रमाणे ते होतील","poem":1},{"text":"आणि त्यांची सर्व दुःखे नाहीशी होतील.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"त्या समयी तरुण कुमारिका नृत्य करून हर्षावतील,","poem":1},{"text":"तरुण व ज्येष्ठ लोकही त्यात सहभागी होतील.","poem":2},{"text":"कारण मी त्यांच्या विलापाचे आनंदात रूपांतर करेन;","poem":1},{"text":"मी त्यांचे सांत्वन करेन आणि दुःखाऐवजी त्यांना हर्ष प्रदान करेन.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"मी मंदिरातील याजकांना विपुल पुरवठ्याने समाधानी करेन,","poem":1},{"text":"आणि माझे लोक भरघोस साठ्याने तृप्त होतील.”","poem":2},{"lineBreak":true},{"text":"असे याहवेह जाहीर करतात.","poem":2}]},{"type":"verse","number":15,"content":["याहवेह असे म्हणतात:",{"text":"“रामाह मधून आवाज ऐकू येत आहे,","poem":1},{"text":"शोक आणि घोर आकांत,","poem":2},{"text":"राहेल आपल्या लेकरांसाठी रडत आहे.","poem":1},{"text":"ती सांत्वन पावण्यास नकार देते,","poem":2},{"lineBreak":true},{"text":"कारण ते आता राहिले नाहीत.”","poem":2}]},{"type":"verse","number":16,"content":["परंतु याहवेह असे म्हणतात:",{"text":"“तुझा रुदनस्वर आणि","poem":1},{"text":"तुझ्या डोळ्यातील अश्रू आता आवर,","poem":2},{"text":"कारण तुझ्या कार्यास फलप्राप्ती होणार आहे,”","poem":1},{"text":"याहवेह असे जाहीर करतात","poem":2},{"lineBreak":true},{"text":"“ते शत्रूच्या देशातून परत येतील.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"तुझ्या वंशजासाठी आशा आहे,”","poem":1},{"text":"याहवेह असे जाहीर करतात.","poem":2},{"lineBreak":true},{"text":"तुझी मुले आपल्या देशात परत येतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“मी एफ्राईमचे आक्रंदन निश्चितच ऐकले:","poem":1},{"text":"‘तुम्ही मला अनावर वासराला लावावी तशी शिस्त लावली आहे,","poem":2},{"lineBreak":true},{"text":"आणि मी ही शिस्त ग्रहण केली आहे.","poem":2},{"text":"मला पुन्हा माझ्या पूर्वस्थितीत आणा, म्हणजे मी पूर्ववत होईन,","poem":1},{"text":"कारण तुम्ही याहवेह, माझे परमेश्वर आहात.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"मी भरकटल्यानंतर,","poem":1},{"text":"मला पश्चात्ताप झाला;","poem":2},{"text":"मला समज आल्यानंतर,","poem":1},{"text":"मी दुःखातिशयाने ऊर बडवून घेतला.","poem":2},{"text":"माझ्या तरुणपणाच्या दिवसात मी जे आचरण केले,","poem":1},{"text":"त्यामुळे मी लज्जित व अपमानित झालो आहे.’","poem":2}]},{"type":"verse","number":20,"content":[{"text":"हा एफ्राईम माझा लाडका पुत्र नाही का,","poem":1},{"text":"जे माझे लेकरू, मला अत्यंत सुखदायक?","poem":2},{"text":"जरी मी बरेचदा त्याच्याविरुद्ध बोललो,","poem":1},{"text":"तरी मला आताही त्याची आठवण येते.","poem":2},{"text":"म्हणून माझ्या मनाला त्याची ओढ लागली आहे;","poem":1},{"text":"मला त्याची अत्यंत दया येते.”","poem":2},{"lineBreak":true},{"text":"असे याहवेह जाहीर करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“जाताना वाटेवर खुणा कर;","poem":1},{"text":"दिशादर्शक लाव.","poem":2},{"text":"तू गेलीस तो महामार्ग ध्यानात ठेव,","poem":1},{"text":"त्या मार्गावर लक्ष ठेव.","poem":2},{"text":"हे इस्राएली कुमारी, परत ये,","poem":1},{"text":"तू आपल्या नगरांमध्ये परत ये.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"अगे विश्वासघातकी कन्ये,","poem":1},{"text":"तू कुठवर भटकत राहणार?","poem":2},{"text":"याहवेह पृथ्वीवर नवीन गोष्ट घडविणार आहेत—","poem":1},{"text":"स्त्री पुरुषाकडे परत","poem":2},{"noteId":25},{"text":"येईल.”","poem":2}]},{"type":"verse","number":23,"content":["सर्वसमर्थ याहवेह, इस्राएलचे परमेश्वर असे म्हणतात: “मी जेव्हा बंदिवासातून त्यांना परत आणेन, तेव्हा यहूदीयामधील व त्यांच्या नगरांमधील लोक असे म्हणतील: हे समृद्ध नगरी, ‘हे पवित्र डोंगरा, याहवेह तुला आशीर्वादित करो’"]},{"type":"verse","number":24,"content":["मग यहूदीया नगरवासी—शेतकरी व कळप घेऊन फिरणारे मेंढपाळ सर्वच एकत्र नांदतील."]},{"type":"verse","number":25,"content":["मी थकलेल्यांना व मूर्छित झालेल्यांना ताजेतवाने व संतुष्ट करेन.”"]},{"type":"verse","number":26,"content":["एवढ्यात मी जागा झालो व सभोवती पाहिले. माझी झोप अत्यंत सुखद होती."]},{"type":"verse","number":27,"content":["याहवेह जाहीर करतात, “असे दिवस येत आहेत जेव्हा लोकांच्या व गुरांच्या वंशजाचे मी इस्राएल व यहूदीयामध्ये रोपण करेन."]},{"type":"verse","number":28,"content":["जसे त्यांना उपटून टाकताना व विदीर्ण होतांना, जमीनदोस्त होतांना, नष्ट होतांना व विपत्ती येत असताना लक्षपूर्वक नजर ठेवून होतो, तर पुन्हा त्यांचे रोपण व उभारणेही लक्ष लावून बघेन,” असे याहवेह जाहीर करतात."]},{"type":"verse","number":29,"content":["“लोक त्या दिवसात पुन्हा म्हणणार नाहीत,",{"text":"‘पालकांनी आंबट द्राक्षे खाल्ली,","poem":1},{"text":"आणि मुलांचे दात आंबले.’","poem":2}]},{"type":"verse","number":30,"content":["कारण प्रत्येकजण स्वतःच्या पापांमुळे मरेल; जो कोणी आंबट द्राक्षे खाईल—त्याचेच दात आंबतील."]},{"type":"verse","number":31,"content":[{"text":"“असे दिवस येतील जेव्हा,","poem":1},{"text":"इस्राएलच्या लोकांशी व यहूदीयाच्या लोकांशी","poem":2},{"text":"मी एक नवीन करार करेन,”","poem":1},{"text":"याहवेह म्हणतात.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"“मी त्यांच्या पूर्वजांचा हात धरून","poem":1},{"text":"त्यांना इजिप्त देशातून बाहेर आणले,","poem":2},{"text":"तेव्हा मी त्यांच्याशी केलेल्या","poem":1},{"text":"कराराप्रमाणे हा करार नसेल.","poem":2},{"text":"मी जरी त्यांचा पती होतो","poem":1},{"noteId":26},{"text":",","poem":1},{"text":"तरी त्यांनी माझा करार मोडला.”","poem":2},{"lineBreak":true},{"text":"असे याहवेह जाहीर करतात.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"“परंतु मी इस्राएलाच्या लोकांबरोबर करार करेन तो असा”","poem":1},{"text":"याहवेह जाहीर करतात, “त्या वेळेनंतर","poem":2},{"text":"मी माझा नियम त्यांच्या मनात ठेवेन,","poem":1},{"text":"आणि ते त्यांच्या हृदयावर लिहेन,","poem":2},{"text":"मी त्यांचा परमेश्वर होईन,","poem":1},{"text":"आणि ते माझे लोक होतील.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"कोणीही आपल्या शेजाऱ्याला बोध करणार नाही,","poem":1},{"text":"किंवा ‘याहवेहला ओळखा’ असे कोणी कोणाला बोलणार नाही,","poem":2},{"text":"कारण लहानापासून ते थोरापर्यंत सर्वजण","poem":1},{"text":"मला ओळखतील,”","poem":2},{"lineBreak":true},{"text":"असे याहवेह जाहीर करतात.","poem":2},{"text":"“मी त्यांच्या दुष्कृत्यांची क्षमा करेन","poem":1},{"text":"व यापुढे त्यांची पापे स्मरणार नाही.”","poem":2}]},{"type":"verse","number":35,"content":["याहवेह असे म्हणतात,",{"text":"दिवसा सूर्यप्रकाश द्यावा म्हणून","poem":1},{"text":"ज्यांनी सूर्याला नियुक्त केले,","poem":2},{"text":"व रात्री प्रकाश देण्यासाठी","poem":1},{"text":"चंद्र व ताऱ्यांना आज्ञा दिली,","poem":2},{"text":"गर्जना करणार्‍या लाटा उसळाव्यात म्हणून","poem":1},{"text":"जे समुद्र ढवळतात;","poem":2},{"lineBreak":true},{"text":"त्यांचे नाव सर्वसमर्थ याहवेह असे आहे:","poem":2}]},{"type":"verse","number":36,"content":[{"text":"“जर हे नियम माझ्या नजरेपुढून नाहीसे झाले तरच","poem":1},{"text":"माझ्यापुढे एक राष्ट्र म्हणून","poem":2},{"text":"इस्राएलचे अस्तित्व समाप्त होईल.”","poem":1},{"text":"याहवेह असे जाहीर करतात.","poem":2}]},{"type":"verse","number":37,"content":["याहवेह असे म्हणतात:",{"text":"“जर आकाशाचे मोजमाप करता आले असते","poem":1},{"text":"व पृथ्वीच्या पायांचा थांग लावता आला असता,","poem":2},{"text":"तर मी माझ्या इस्राएली लोकांच्या सर्व वंशजांना","poem":1},{"text":"त्यांनी जे सर्व केले त्याबद्दल त्यांना नाकारले असते,”","poem":2},{"lineBreak":true},{"text":"याहवेह जाहीर करतात.","poem":2}]},{"type":"verse","number":38,"content":["याहवेह जाहीर करतात, “असे दिवस येत आहेत, कोपर्‍यातील हनानेलच्या बुरुजापासून कोपर्‍याच्या वेशीपर्यंत या नगरीची पुनर्बांधणी होईल."]},{"type":"verse","number":39,"content":["आणि गारेबच्या टेकडीपासून गोआहपर्यंत मापनसूत्र विस्तारित केले जाईल."]},{"type":"verse","number":40,"content":["संपूर्ण खोरे जिथे प्रेते व राख फेकण्यात येत असे, व त्याचप्रमाणे किद्रोनच्या खोऱ्यापर्यंतची आणि तिथून पूर्वेकडील घोडवेशी पर्यंतची सर्व शेते याहवेहला पवित्र अशी होतील. या नगराचा पुन्हा कधीही पाडाव किंवा विध्वंस होणार नाही.”"]}],"footnotes":[{"noteId":25,"caller":"+","text":"किंवा सुरक्षा देईल","reference":{"chapter":31,"verse":22}},{"noteId":26,"caller":"+","text":"किंवा मी त्यांच्यापासून दूर गेलो","reference":{"chapter":31,"verse":32}}]},"thisChapterLink":"/api/mar_cbi/JER/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/JER/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/JER/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}