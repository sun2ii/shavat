{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"JER","translationId":"mar_cbi","name":"यिर्मयाह","commonName":"यिर्मयाह","title":"यिर्मयाहची भविष्यवाणी","order":24,"numberOfChapters":52,"sha256":"6e2548f8969bad42c196f15503e8abcfae98acb5f8c49f884a4549b0646916c9","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/mar_cbi/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":46,"content":[{"type":"heading","content":["इजिप्तविषयी भविष्य"]},{"type":"verse","number":1,"content":["राष्ट्रांसंबंधी यिर्मयाह संदेष्ट्याला याहवेहचे हे वचन आले:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["इजिप्तसंबंधी:",{"lineBreak":true},"योशीयाहचा पुत्र, यहूदीयाचा राजा यहोयाकीम, याच्या कारकिर्दीच्या चौथ्या वर्षी, बाबेलचा राजा नबुखद्नेस्सर याने फरात नदीजवळ कर्कमीशच्या लढाईत इजिप्तचा राजा फारोह नखो व त्याचे सैन्य यांचा पराभव केला. त्या प्रसंगी इजिप्तच्या सेनेविरुद्ध हा संदेश देण्यात आला."]},{"type":"verse","number":3,"content":[{"text":"“तुमच्या ढाली सिद्ध करा, लहान व मोठ्या अशा दोन्ही,","poem":1},{"text":"आणि लढाईसाठी कूच करा!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"घोड्यांवर खोगीर चढवा,","poem":1},{"text":"आणि अश्वारूढ व्हा!","poem":2},{"text":"शिरस्त्राण घालून","poem":1},{"text":"मोर्चा बांधा!","poem":2},{"text":"भाल्यांना धार लावा,","poem":1},{"text":"व चिलखते चढवा!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"मी हे काय पाहात आहे?","poem":1},{"text":"ते भयभीत झालेले आहेत,","poem":2},{"text":"ते माघार घेत आहेत,","poem":1},{"text":"त्यांचे योद्धे पराजित झाले आहेत.","poem":2},{"text":"मागे वळूनदेखील न पाहता","poem":1},{"text":"ते घाईघाईत पळत आहेत,","poem":2},{"lineBreak":true},{"text":"आणि सर्वत्र आतंक पसरला आहे,” याहवेह जाहीर करतात.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“चपळ सैनिक पळू शकत नाहीत.","poem":1},{"text":"वा बलाढ्य निसटून शकत नाहीत.","poem":2},{"text":"उत्तरेकडे फरात नदीकाठी","poem":1},{"text":"ते अडखळून पडत आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“नाईल नदीसारखा हा कोण उभारून येत आहे,","poem":1},{"text":"पाण्याने उफाळणार्‍या नदीसारखा हा कोण आहे?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"इजिप्त नाईल नदीसारखी उभारून येत आहे,","poem":1},{"text":"पाण्याने उफाळणार्‍या नदीसारखी.","poem":2},{"text":"ती म्हणते, ‘मी उभारेन व पृथ्वी व्यापून टाकेन;","poem":1},{"text":"मी नगरांना व त्यांच्या लोकांना नष्ट करेन.’","poem":2}]},{"type":"verse","number":9,"content":[{"text":"अश्वांनो, तुम्ही हल्ला करा!","poem":1},{"text":"सारथ्यांनो, तुम्ही आवेशाने धाव घ्या!","poem":2},{"text":"योद्ध्यांनो—पूट व कूश या प्रांतातील ढालधारक,","poem":1},{"text":"लूदीमवासी बाण जे सोडतात, ते तुम्ही सर्वजण पुढे कूच करा!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"कारण हा दिवस प्रभू, सर्वसमर्थ याहवेहचा आहे—","poem":1},{"text":"हा सूड उगविण्याचा, त्यांच्या शत्रूंवर सूड उगविण्याचा दिवस आहे.","poem":2},{"text":"रक्त पिऊन तिची तृप्ती होईपर्यंत","poem":1},{"text":"तलवार तृप्त होईपर्यंत गिळंकृत करीत राहील.","poem":2},{"text":"कारण प्रभू, सर्वसमर्थ याहवेह,","poem":1},{"text":"उत्तरेकडील फरात नदीकाठील प्रदेशात यज्ञार्पण करणार.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“हे इजिप्तच्या कुमारिके,","poem":1},{"text":"वर गिलआदामध्ये जाऊन औषध आण.","poem":2},{"text":"तुझे घाव बरे व्हावे म्हणून तू अनेक औषधे वापरलीस,","poem":1},{"text":"पण तुझे घाव बरे करेल असे औषधच नाही.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"राष्ट्रे तुझ्या लज्जेची वार्ता ऐकतील;","poem":1},{"text":"तुझ्या आक्रोशाने संपूर्ण पृथ्वी भरेल.","poem":2},{"text":"तुझे योद्धे परस्परांवर अडखळून पडतील;","poem":1},{"text":"दोघेही एकमेकांसोबत एकत्र पडतील.”","poem":2}]},{"type":"verse","number":13,"content":["यानंतर याहवेहने संदेष्टा यिर्मयाहला जो संदेश दिला तो इजिप्तवर हल्ला करावयास येणाऱ्या बाबेलचा राजा नबुखद्नेस्सर, याच्याविषयी होता:"]},{"type":"verse","number":14,"content":[{"text":"“इजिप्तमध्ये घोषणा करा, मिग्दोलमध्ये जाहीर करा;","poem":1},{"text":"मेम्फीस व तहपनहेस या शहरांमध्येही जाहीर करा!","poem":2},{"text":"‘चला, सिद्ध व्हा, व मोर्चा बांधा,","poem":1},{"text":"कारण तुमच्या सभोवतालच्यांना तलवार गिळंकृत करीत आहे.’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"तुमचे योद्धे कोलमडून का पडले?","poem":1},{"text":"ते उभे राहू शकत नाहीत, कारण याहवेहने त्यांना खाली ढकलले आहे.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ते पुन्हापुन्हा अडखळतील;","poem":1},{"text":"ते एकमेकांवर कोसळून पडतील.","poem":2},{"text":"ते म्हणतील, ‘चला, उठा, आपल्या लोकांकडे व आपल्या जन्मभूमीत","poem":1},{"text":"आपण परत जाऊ,","poem":2},{"lineBreak":true},{"text":"या छळवाद्यांच्या तलवारीपासून दूर जाऊ.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"तिथे ते उद्गारतील,","poem":1},{"text":"‘इजिप्तचा राजा फारोह होफ्रा व्यर्थ गोंगाट करणारा मनुष्य आहे;","poem":2},{"lineBreak":true},{"text":"त्याने त्याला मिळालेली सुसंधी घालविली.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“ज्याचे नाव सर्वसमर्थ याहवेह आहे,","poem":1},{"text":"ते महाराज म्हणतात, ‘माझ्या जीविताची शपथ,’","poem":2},{"text":"जो येणार आहे, तो पर्वतांमधील ताबोर पर्वतासारखा,","poem":1},{"text":"समुद्राजवळील कर्मेलासारखा आहे.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"इजिप्तमधील रहिवाशांनो,","poem":1},{"text":"सामानाची बांधाबांध करा,","poem":2},{"text":"कारण मेम्फीस शहराचा नाश होणार आहे","poem":1},{"text":"व ते ओसाड होऊन एक निर्जन स्थान होईल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“इजिप्त ही सुंदर कालवड आहे;","poem":1},{"text":"परंतु उत्तरेकडून तिच्याविरुद्ध","poem":2},{"lineBreak":true},{"text":"गांधीलमाशी येत आहे.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"तिच्या सैन्यातील भाडोत्री सैनिक","poem":1},{"text":"एखाद्या धष्टपुष्ट वासरांसारखे झाले आहेत.","poem":2},{"text":"तेही वळून एकत्र पलायन करतील,","poem":1},{"text":"ते भूमीवर टिकाव धरू शकणार नाही,","poem":2},{"text":"कारण त्यांच्यावरील संकटाचा दिवस जवळ येत आहे,","poem":1},{"text":"त्यांना शिक्षा मिळण्याचा हा समय आहे.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"जसे त्यांचे बलाढ्य शत्रूपुढे चाल करतील,","poem":1},{"text":"जंगलतोड्यांगत येऊन त्यांच्यावर","poem":2},{"text":"ते कुऱ्हाड घेऊन आक्रमण करतील.","poem":1},{"text":"तेव्हा इजिप्त फुत्कारणाऱ्या सर्पाप्रमाणे पळ काढेल;","poem":2}]},{"type":"verse","number":23,"content":[{"text":"याहवेह जाहीर करतात, कितीही घनदाट असलेले जंगल","poem":1},{"text":"ते कापून नष्ट करतील.","poem":2},{"text":"ते टोळांपेक्षाही असंख्य असे असतील,","poem":1},{"text":"ज्यांची संख्या मोजता येणार नाही.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"उत्तरेकडील लोकांच्या तावडीत सापडलेल्या","poem":1},{"text":"इजिप्तच्या कुमारिकेची लज्जा घालविण्यात येईल.”","poem":2}]},{"type":"verse","number":25,"content":["सर्वसमर्थ याहवेह, इस्राएलचे परमेश्वर म्हणतात: मी थेबेस येथील दैवत आमोनला, फारोहला, इजिप्तला व तिच्या दैवतांना, तिच्या राजाला आणि तिची सर्व दैवते व तिच्यावर भरवसा ठेवणार्‍यांनाही शिक्षा करणार आहे."]},{"type":"verse","number":26,"content":["त्यांना ठार मारावे अशी इच्छा धरणारे—बाबेलचा राजा नबुखद्नेस्सर व त्याचे सैन्य यांच्या तावडीत मी त्यांना देईन. परंतु नंतर मात्र हा इजिप्त लढाईच्या उत्पातातून सावरेल आणि तिथे पूर्ववत वस्ती होईल, असे याहवेह जाहीर करतात."]},{"type":"verse","number":27,"content":[{"text":"“याकोबा, माझ्या सेवका, घाबरू नको;","poem":1},{"text":"इस्राएला, निराश होऊ नका.","poem":2},{"text":"मी बंदिवासाच्या देशातून तुमच्या वंशजांचा","poem":1},{"text":"दूर देशातून तुमचा बचाव करेन,","poem":2},{"text":"याकोबाला पुन्हा शांती व संरक्षण मिळेल,","poem":1},{"text":"त्याला कोणीही भयभीत करणार नाही.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"याकोबा, माझ्या सेवका, भिऊ नको,","poem":1},{"text":"कारण मी तुझ्याबरोबर आहे.”","poem":2},{"lineBreak":true},{"text":"असे याहवेह जाहीर करतात.","poem":2},{"text":"“मी तुला ज्या राष्ट्रांमध्ये विखरून दिले होते,","poem":1},{"text":"त्या राष्ट्रांचा जरी नाश केला,","poem":2},{"lineBreak":true},{"text":"परंतु तुझा संपूर्ण नाश करणार नाही.","poem":2},{"text":"मी तुला शिस्त लावण्यासाठी एका मर्यादेत शिक्षा करेन.","poem":1},{"text":"तुला पूर्णपणे विना शिक्षेचे मी सोडणार नाही.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}