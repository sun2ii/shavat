{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"JER","translationId":"mar_cbi","name":"यिर्मयाह","commonName":"यिर्मयाह","title":"यिर्मयाहची भविष्यवाणी","order":24,"numberOfChapters":52,"sha256":"6e2548f8969bad42c196f15503e8abcfae98acb5f8c49f884a4549b0646916c9","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/mar_cbi/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":48,"content":[{"type":"heading","content":["मोआबी लोकांविषयी संदेश"]},{"type":"verse","number":1,"content":["मोआबी लोकांविषयी:",{"lineBreak":true},"इस्राएलचे परमेश्वर, सर्वसमर्थ याहवेह, यांनी दिलेला संदेश हा आहे:",{"text":"“नबो शहराचा धिक्कार असो, कारण त्याचा विध्वंस होईल.","poem":1},{"text":"किर्याथाईम लज्जित होईल व हस्तगत करण्यात येईल;","poem":2},{"lineBreak":true},{"text":"तेथील किल्ले लज्जित होतील व चक्काचूर करण्यात येतील.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"आता यापुढे मोआबाची कोणीही प्रंशसा करणार नाही;","poem":1},{"text":"हेशबोनमधील लोक तिच्या अधःपतनाचा कट रचतील:","poem":2},{"lineBreak":true},{"text":"ते म्हणतील, ‘चला, आपण त्या राष्ट्राचा अंत करू.’","poem":2},{"text":"तुम्ही मदमेनमधील लोकही निःशब्द केले जातील;","poem":1},{"text":"तलवार तुमचा पाठलाग करेल.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"नंतर होरोनाईममधून विलापध्वनी ऐकू येत आहे,","poem":1},{"text":"प्रचंड संहाराचा व विध्वंसाचा आक्रांत ऐकू येत आहे.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"कारण मोआब भूमीचा भंग केला जाणार आहे,","poem":1},{"text":"तिचे बालक विलाप करतील.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ते लुहिथच्या डोंगरावर चढतील","poem":1},{"text":"व चढताना आक्रोश करीत जातील;","poem":2},{"text":"व होरोनाईम नगराच्या उतरणीवरून","poem":1},{"text":"विनाश बघतांनाच्या किंकाळ्या ऐकू येतील.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"पळा, जीव घेऊन पळा!","poem":1},{"text":"रानावनात झुडूपागत व्हा.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"कारण तुम्ही आपल्या कार्यावर व धनसंपत्तीवर भरवसा ठेवला होता,","poem":1},{"text":"तुम्हालादेखील बंदिवान म्हणून नेण्यात येईल.","poem":2},{"text":"तुमचे दैवत कमोश बंदिवासात जाईल,","poem":1},{"text":"त्याचे याजक आणि सरदार हे सर्वजण नेले जातील.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"विनाशक प्रत्येक नगराविरुद्ध येईल,","poem":1},{"text":"एकाही नगराची त्याच्या हातून सुटका होणार नाही.","poem":2},{"text":"दर्‍याखोर्‍यांचा नाश होईल,","poem":1},{"text":"आणि पठारे उद्ध्वस्त होतील,","poem":2},{"lineBreak":true},{"text":"कारण याहवेहने तसे म्हटले आहे.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"मोआबावर मीठ टाका","poem":1},{"text":"कारण तिचा उकिरडा बनेल","poem":2},{"noteId":39},{"text":";","poem":2},{"text":"तिची नगरे उजाड़ होतील,","poem":1},{"text":"तिथे कोणीही वसती करणार नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“याहवेहने सोपविलेले कार्य आळशीपणाने करणारा शापित असो!","poem":1},{"text":"रक्तपात न करता तलवार म्यानात ठेवणारे शापित असो!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“अगदी बालपणापासून मोआब सुखात राहिली.","poem":1},{"text":"गाळावर स्थिर वसलेल्या द्राक्षारसाप्रमाणे,","poem":2},{"text":"तरी तिला या पात्रातून त्या पात्रात ओतले गेले नाही—","poem":1},{"text":"ती बंदिवासात गेलेली नाही.","poem":2},{"text":"म्हणून ती पूर्ववत चवदारच आहे,","poem":1},{"text":"आणि तिचा सुवासही बदललेला नाही.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"परंतु याहवेह म्हणतात, लवकरच असे दिवस येत आहेत,","poem":1},{"lineBreak":true},{"text":"मी तिला बुधल्यातून ओतणारी माणसे पाठवेन,","poem":1},{"text":"ते तिला या पात्रातून ओतून बाहेर टाकतील;","poem":2},{"text":"ते तिचे बुधले रिकामी करतील","poem":1},{"text":"व नंतर तिची पात्रे फोडून टाकतील.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"इस्राएलने बेथेल येथे भरवसा ठेवला,","poem":1},{"text":"व मग त्यांना जशी आपल्या वासराच्या मूर्तीची लाज वाटली.","poem":2},{"lineBreak":true},{"text":"तशीच मोआबाला आपल्या कमोशाची लाज वाटेल,","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ ‘आम्ही वीरपुरुष, पराक्रमी योद्धे आहोत!’","poem":1},{"text":"असे तुम्ही कसे बोलू शकता?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"परंतु आता मोआबचा सर्वनाश होणार आहे, तिची नगरे हस्तगत केली जाणार आहेत;","poem":1},{"text":"तिच्या अत्यंत उमद्या तरुणांची कत्तल होईल,”","poem":2},{"lineBreak":true},{"text":"असे राजाधिराज, ज्यांचे नाव सर्वसमर्थ याहवेह आहे ते म्हणतात.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“मोआबचा पाडाव अगदी जवळ आलेला आहे;","poem":1},{"text":"तिच्यावरील अरिष्ट वेगाने येणार आहे.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"तिच्याभोवती असणाऱ्या सर्व लोकांनो, तिच्यासाठी विलाप करा,","poem":1},{"text":"तिची किर्ती माहीत असणारे सर्व सामील व्हा;","poem":2},{"text":"म्हणा, ‘तिचा बलशाली राजदंड कसा मोडला,","poem":1},{"text":"इतकी वैभवशाली काठी कशी मोडली!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“अहो दिबोन कन्येचे निवासी,","poem":1},{"text":"आपल्या वैभवावरून खाली उतरा","poem":2},{"lineBreak":true},{"text":"आणि शुष्क भूमीवर येऊन बसा,","poem":2},{"text":"कारण जे मोआब भूमीचा विनाशक","poem":1},{"text":"तुमच्याविरुद्ध येत आहेत","poem":2},{"lineBreak":true},{"text":"आणि ते तिच्या सर्व तटबंदीची नगरे नष्ट करतील.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"अरोएरवासी जनहो,","poem":1},{"text":"तटस्थ होऊन रस्त्याच्या कडेला उभे राहून पाहा,","poem":2},{"text":"आणि पळ काढणार्‍या पुरुषांना व बचाव करून निघणाऱ्या स्त्रियांना विचारा,","poem":1},{"text":"‘तिथे काय घडले?’","poem":2}]},{"type":"verse","number":20,"content":[{"text":"मोआब लज्जित झाली आहे, ती भंग पावली आहे.","poem":1},{"text":"रडा व आकांत करा!","poem":2},{"text":"आर्णोनच्या काठी घोषणा करा","poem":1},{"text":"मोआब नष्ट झाले आहे.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"पठारे—होलोन, याहसाह, मेफाथ","poem":1},{"text":"यांनाही शिक्षा मिळाली आहे.","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"दिबोन, नबो, बेथ‑दिबलाथाईम,","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"किर्याथाईम, बेथ‑गामूल, बेथ‑मौन","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"करीयोथ, बस्रा—","poem":2},{"lineBreak":true},{"text":"मोआबभूमीच्या जवळच्या व दूरच्या सर्वच नगरांना शिक्षा झाली आहे.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"मोआबभूमीचे शिंग","poem":1},{"noteId":40},{"text":"तोडून टाकण्यात आले आहे.","poem":1},{"text":"तिचे बाहू मोडले आहेत.”","poem":2},{"lineBreak":true},{"text":"असे याहवेह जाहीर करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“तिला एखाद्या दारुड्यागत होऊ दे,","poem":1},{"text":"कारण तिने याहवेहविरुद्ध बंड केले आहे.","poem":2},{"text":"मोआबभूमी आपल्याच वांतीत लोळू दे;","poem":1},{"text":"तिला उपहासाचा विषय होऊ दे.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"इस्राएलही तुमच्या उपहासाचा विषय नव्हता का?","poem":1},{"text":"ती चोरांच्यामध्ये पकडली गेली का,","poem":2},{"text":"कारण जेव्हाही तिचा उल्लेख होतो,","poem":1},{"text":"घृणाभावनेने तुम्ही आपली मान हालविता नाही का?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"मोआबभूमीच्या रहिवाशांनो","poem":1},{"text":"आपली नगरे सोडा आणि खडकांच्या कपारीत जाऊन राहा.","poem":2},{"text":"गुहेच्या तोंडाशी घरी बांधणाऱ्या","poem":1},{"text":"पारव्याप्रमाणे व्हा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“आम्ही मोआबच्या गर्वाविषयी ऐकले आहे—","poem":1},{"text":"तिचा गर्व किती मोठा आहे—","poem":2},{"text":"तिचा उर्मटपणा, तिचा उन्मत्तपणा, तिचा अहंभाव","poem":1},{"text":"आणि तिच्या अंतःकरणाची मग्रुरीही सर्व आम्हाला माहीत आहे.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"याहवेहने जाहीर केले, मला मोआब भूमीचा उद्धटपणा माहीत आहे, परंतु तो व्यर्थ आहे,","poem":1},{"text":"तिच्या फुशारक्यांनी काहीही प्राप्त होत नाही.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"म्हणून मी मोआबभूमीसाठी विलाप करतो,","poem":1},{"text":"मी मोआबसाठी अश्रू गाळतो,","poem":2},{"lineBreak":true},{"text":"कीर-हरेसेथच्या लोकांसाठी मी शोक करतो.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"जसे याजेर शोक करतो,","poem":1},{"text":"तसे मी सिबमाहच्या द्राक्षलतांसाठी शोक करतो.","poem":2},{"text":"तुमच्या फांद्या समुद्रापर्यंत","poem":1},{"noteId":41},{"text":"पसरलेल्या आहेत,","poem":1},{"text":"त्या याजेरपर्यंत","poem":2},{"noteId":42},{"text":"पोहोचतात;","poem":2},{"text":"संहार करणाऱ्याने","poem":1},{"text":"तुमच्या पिकलेल्या फळांवर व द्राक्षांवर हल्ला केला आहे.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"मोआबभूमीच्या मळ्यामधून व शेतातून","poem":1},{"text":"आनंद व हर्ष लयास गेले आहेत.","poem":2},{"text":"द्राक्षकुंडातून द्राक्षारसाचा प्रवाह मी बंद केला आहे;","poem":1},{"text":"हर्षनाद करून द्राक्षे तुडविणारा कोणी नाही.","poem":2},{"text":"ओरडणे आहे,","poem":1},{"text":"होय पण ते आनंदाचे नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“त्यांच्या आक्रोशाचा ध्वनी उंचाविला जात आहे","poem":1},{"text":"हेशबोनपासून एलिआलेह आणि याहसापर्यंत,","poem":2},{"text":"सोअरापासून होरोनाईम आणि एग्लाथ-शलीशियापर्यंत तो ऐकू येत आहे,","poem":1},{"text":"निम्रीमाची कुरणेही आता शुष्क झाली आहेत.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"जे उच्चस्थळी जाऊन अर्पणे वाहतात,","poem":1},{"text":"आणि त्यांच्या खोट्या दैवतांना धूप जाळतात","poem":2},{"lineBreak":true},{"text":"त्या मोआबभूमीत या गोष्टी मी आता बंद पाडेन,” याहवेह असे जाहीर करतात.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"“माझे अंतःकरण मोआबसाठी जणू बासरीवर शोकगीत गात आहे;","poem":1},{"text":"कीर-हरेसेथसाठी विलापाने बासरीगत गीत गात आहे.","poem":2},{"lineBreak":true},{"text":"त्यांनी साठविलेली विपुल संपत्ती नाहीशी झाली आहे.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"तेथील प्रत्येक डोक्याचे मुंडण झाले आहे","poem":1},{"text":"व प्रत्येक दाढीचे बोडण झाले आहे;","poem":2},{"text":"प्रत्येक हातावर घाव करण्यात आला आहे","poem":1},{"text":"व प्रत्येक कमरेवर गोणपाट नेसलेला आहे.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"मोआबभूमीतील प्रत्येक घराच्या छतावर","poem":1},{"text":"आणि प्रत्येक चौरस्त्यावर","poem":2},{"text":"केवळ आकांतच आढळत आहे,","poem":1},{"text":"कारण जुन्या निकामी पात्रांचा चक्काचूर करावा त्याप्रमाणे","poem":2},{"lineBreak":true},{"text":"मोआब भूमीचा मी चुराडा केला आहे,” याहवेह असे जाहीर करतात.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"“पाहा, मोआबभूमी कशी मोडकळीस आली आहे! ती कशी विलाप करीत आहे!","poem":1},{"text":"मोआबने लज्जेने कशी पाठ फिरविली आहे ते पाहा!","poem":2},{"text":"मोआब तिच्या सभोवती असलेल्या लोकांच्या उपहासाचा","poem":1},{"text":"व दहशतीचा विषय झाली आहे.”","poem":2}]},{"type":"verse","number":40,"content":["याहवेह असे म्हणतात:",{"text":"पाहा! एक गरुड आकाशातून खाली झेप घेत आहे,","poem":1},{"text":"मोआबभूमीवर आपले पंख पसरवित आहे.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"करीयोथ","poem":1},{"noteId":43},{"text":"पडले आहेत,","poem":1},{"text":"व तेथील दुर्गमस्थाने जिंकून घेतली आहेत.","poem":2},{"text":"प्रसूती वेदनांनी व्याकूळ झालेल्या स्त्रियांच्या हृदयाप्रमाणे","poem":1},{"text":"मोआबच्या योद्ध्यांचे हृदय होईल.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"मोआब एक राष्ट्र म्हणून न राहता तिचा नाश होईल.","poem":1},{"text":"कारण तिने याहवेहविरुद्ध उर्मटपणा केला आहे.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"हे मोआबातील लोकांनो,","poem":1},{"text":"दहशत, खड्डे व पाश तुझ्या वाट्याला येतील,","poem":2},{"lineBreak":true},{"text":"असे याहवेह म्हणतात.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"“जो कोणी दहशतीपासून दूर पळेल","poem":1},{"text":"तो खड्ड्यात पडेल,","poem":2},{"text":"जो कोणी खड्ड्यातून बाहेर पडेल,","poem":1},{"text":"तो पाशात सापडेल.","poem":2},{"text":"कारण मी मोआबावर","poem":1},{"text":"तिच्या शिक्षेचे वर्ष आणणार आहे.","poem":2},{"lineBreak":true},{"text":"याहवेह असे जाहीर करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“हेशबोनच्या सावलीत","poem":1},{"text":"फरारी हतबलपणे उभे आहेत,","poem":2},{"text":"हेशबोनमधून अग्नी येत आहे,","poem":1},{"text":"सीहोनच्या मध्यातून ज्वाला पसरत आहेत;","poem":2},{"text":"त्या मोआबाचे कपाळ जाळून टाकीत आहे,","poem":1},{"text":"त्या कर्कश बढाईखोरांचे मस्तक जाळीत आहे.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"हे मोआबा, तुला धिक्कार असो!","poem":1},{"text":"कमोश दैवताचे उपासक नष्ट झाले आहेत;","poem":2},{"text":"आणि तुझ्या पुत्रांना बंदिवासात नेण्यात येत आहे","poem":1},{"text":"व कन्यांना गुलाम करून नेण्यात येत आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“परंतु मी मोआबच्या समृद्धीची","poem":1},{"text":"येत्या दिवसात पुन्हा भरपाई करेन,”","poem":2},{"lineBreak":true},{"text":"असे याहवेह म्हणतात.","poem":2},"मोआबाच्या न्यायाचे भाकीत येथे संपते."]},{"type":"line_break"}],"footnotes":[{"noteId":39,"caller":"+","text":"किंवा ती उडून जाईल","reference":{"chapter":48,"verse":9}},{"noteId":40,"caller":"+","text":"शक्तीचे प्रतीक","reference":{"chapter":48,"verse":25}},{"noteId":41,"caller":"+","text":"बहुतेक मृत समुद्र","reference":{"chapter":48,"verse":32}},{"noteId":42,"caller":"+","text":"समुद्रापर्यंत","reference":{"chapter":48,"verse":32}},{"noteId":43,"caller":"+","text":"किंवा शहरे","reference":{"chapter":48,"verse":41}}]},"thisChapterLink":"/api/mar_cbi/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}