{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"JER","translationId":"mar_cbi","name":"यिर्मयाह","commonName":"यिर्मयाह","title":"यिर्मयाहची भविष्यवाणी","order":24,"numberOfChapters":52,"sha256":"6e2548f8969bad42c196f15503e8abcfae98acb5f8c49f884a4549b0646916c9","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/mar_cbi/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":50,"content":[{"type":"heading","content":["बाबिलोनसंबंधी संदेश"]},{"type":"verse","number":1,"content":["बाबिलोन",{"noteId":46},"व बाबिलोनच्या लोकांचा देश यांच्याविरुद्ध याहवेहने संदेष्टा यिर्मयाहला सांगितलेले हे वचन आहे:"]},{"type":"verse","number":2,"content":[{"text":"“राष्ट्रांमध्ये जाहीर कर व घोषणा कर,","poem":1},{"text":"ध्वज उंचावून घोषणा कर;","poem":2},{"lineBreak":true},{"text":"काहीही मागे सोडू नको, पण म्हण,","poem":2},{"text":"‘बाबेलचा पाडाव होणार आहे;","poem":1},{"text":"तिचे दैवत बेल लज्जित करण्यात येणार आहे,","poem":2},{"lineBreak":true},{"text":"मरोदख भयाने व्याप्त होणार.","poem":2},{"text":"तिच्या मूर्ती लज्जित करण्यात येणार आहेत","poem":1},{"text":"तिची दैवते भयाने व्याप्त होणार आहेत.’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिच्यावर उत्तरेकडून एक राष्ट्र हल्ला करेल","poem":1},{"text":"आणि तिच्या भूमीचा विध्वंस करेल.","poem":2},{"text":"तिथे पुन्हा कोणीही राहणार नाही;","poem":1},{"text":"लोक आणि पशू पलायन करतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“त्या समयी, त्या दिवसात","poem":1},{"lineBreak":true},{"text":"इस्राएलचे लोक आणि यहूदीयाचे लोक एकत्र येतील,","poem":1},{"text":"आणि अश्रू गाळीत त्यांचे परमेश्वर याहवेहचा शोध घेतील, याहवेह जाहीर करतात.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ते सीयोनकडे जाणार्‍या मार्गाची विचारणा करतील","poem":1},{"text":"आणि त्या दिशेने ते अभिमुख होतील.","poem":2},{"text":"ते येतील व याहवेहशी,","poem":1},{"text":"कधीही विस्मृतित न जाणाऱ्या,","poem":2},{"lineBreak":true},{"text":"एका सार्वकालिक कराराशी जडून जातील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“माझे लोक हरवलेली मेंढरे होती;","poem":1},{"text":"त्यांच्या मेंढपाळांनीच त्यांची वाट चुकविली","poem":2},{"lineBreak":true},{"text":"त्यांना डोंगरांवर भटकण्यासाठी सोडून दिले होते.","poem":2},{"text":"ते डोंगर व पर्वतावर भटकत राहिले","poem":1},{"text":"व त्यांच्या मेंढवाड्यास ते विसरले.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ज्यांना ते सापडले, त्यांनी त्यांना गिळंकृत केले;","poem":1},{"text":"त्यांचे शत्रू म्हणाले, ‘आपण दोषी नाही,","poem":2},{"text":"कारण याहवेह, त्यांचे हिरवेगार कुरण,","poem":1},{"text":"आणि त्यांच्या पूर्वजांचे आशास्थान, यांच्याविरुद्धच ज्यांनी पाप केले आहे.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“बाबेलच्या बाहेर पळा;","poem":1},{"text":"बाबिलोनच्या लोकांच्या भूमीचा त्याग करा,","poem":2},{"lineBreak":true},{"text":"आणि त्या बोकडांसारखे व्हा, जे कळपाचे नेतृत्व करतात.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"कारण मी उत्तरेकडील महान राष्ट्रांना एकवटून","poem":1},{"text":"बाबेलवर हल्ला करण्यास प्रेरित करणार.","poem":2},{"text":"ते बाबेलवर हल्ला करण्यास सज्ज होतील,","poem":1},{"text":"आणि उत्तरेकडून तिचा पाडाव होईल.","poem":2},{"text":"त्यांचे बाण लक्ष्यवेधी योद्ध्यांसारखे असतील","poem":1},{"text":"ते रिकाम्या हाताने परत जात नसतात.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तर मग बाबेलची लूट करण्यात येईल;","poem":1},{"text":"ते सर्व तिची मनसोक्त लूट करतील,”","poem":2},{"lineBreak":true},{"text":"असे याहवेह जाहीर करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“तुम्ही जे माझे वतन लुटता,","poem":1},{"text":"तुम्ही आनंद व उल्हास करतात,","poem":2},{"text":"तुम्ही धान्य मळणार्‍या कालवडीप्रमाणे बागडता","poem":1},{"text":"आणि घोड्यांसारखे खिंकाळत असाल,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"पण तुमची माता अत्यंत लज्जित होईल;","poem":1},{"text":"जिने तुम्हाला जन्म दिला, तिची अप्रतिष्ठा होईल,","poem":2},{"text":"ती सर्व राष्ट्रात सर्वात क्षुद्र होईल—","poem":1},{"text":"मग ती अरण्यात असो, शुष्क भूमीत, वा वाळवंटात असो.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"याहवेहच्या क्रोधामुळे ती आवासित होणार नाही,","poem":1},{"text":"पण पूर्णपणे ओसाड होईल.","poem":2},{"text":"आणि तिची अवस्था पाहून बाबेलातून येजा करणार्‍यांना दहशत वाटेल;","poem":1},{"text":"तिच्या जखमा पाहून ते तिचा उपहास करतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“बाबेलच्या सभोवती तिच्याविरुद्ध मोर्चा बांधा,","poem":1},{"text":"धनुर्धाऱ्यांनो तिच्यावर बाणांचा नेम धरा.","poem":2},{"text":"तिच्यावर बाण मारा, कोणताही बाण राखून ठेवू नका.","poem":1},{"text":"कारण तिने याहवेहविरुद्ध पाप केले आहे.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"तिच्याविरुद्ध चहूबाजूंनी आवाज उठवा!","poem":1},{"text":"ती शरण येत आहे, तिचे बुरूज धराशायी झाले आहेत,","poem":2},{"lineBreak":true},{"text":"तिच्या तटाच्या भिंती कोसळल्या आहेत.","poem":2},{"text":"हा याहवेहने घेतलेला सूड आहे,","poem":1},{"text":"तुम्हीही तिचा सूड घ्या;","poem":2},{"lineBreak":true},{"text":"जसे तिने इतरांचे केले तसेच तिचेही करा.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"बाबेलच्या शेतकऱ्यांना तिथून काढून टाका,","poem":1},{"text":"कापणी करणारे आपले विळे घेऊन निघून जावोत.","poem":2},{"text":"अत्याचाऱ्याच्या तलवारीमुळे","poem":1},{"text":"प्रत्येकाने आपल्या लोकांकडे परत जावे.","poem":2},{"lineBreak":true},{"text":"प्रत्येकाने आपल्या देशाकडे पलायन करावे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“इस्राएली लोकांची मेंढराप्रमाणे पांगापांग झाली आहे,","poem":1},{"text":"सिंहाने पाठलाग करून त्यांना पळविले आहे.","poem":2},{"text":"प्रथम ज्याने त्यांना गिळंकृत केले","poem":1},{"text":"तो अश्शूरचा राजा होता;","poem":2},{"text":"नंतर त्यांच्या हाडांचा चुराडा केला","poem":1},{"text":"तो बाबेलचा राजा नबुखद्नेस्सर होता.”","poem":2}]},{"type":"verse","number":18,"content":["म्हणून सर्वसमर्थ याहवेह, इस्राएलचे परमेश्वर म्हणतात:",{"text":"“मी बाबेलच्या राजाला व त्याच्या भूमीला शिक्षा देईन,","poem":1},{"text":"अश्शूरच्या राजाला व त्याच्या भूमीला शिक्षा देईन.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"पण मी इस्राएलला त्यांच्या स्वतःच्या कुरणात परत आणेन,","poem":1},{"text":"ते कर्मेल व बाशान येथे चरतील;","poem":2},{"text":"एफ्राईम व गिलआदच्या डोंगरावर","poem":1},{"text":"ते खाऊन तृप्त होतील.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"त्या दिवसात, त्या समयी, याहवेह घोषित करतात,","poem":1},{"lineBreak":true},{"text":"इस्राएलमध्ये दोषाचा शोध घेण्याचा प्रयत्न केला","poem":1},{"text":"तरी ते आढळणार नाहीत,","poem":2},{"text":"आणि यहूदीयामध्ये पाप शोध घेण्याचा प्रयत्न केला","poem":1},{"text":"तरी आढळणार नाही, लोकांना मी क्षमा करेन.","poem":2},{"lineBreak":true},{"text":"कारण मी वाचवून ठेवलेल्या अवशेषाला क्षमा करेन.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“मराथाईम प्रदेशावर आक्रमण करा","poem":1},{"text":"आणि पकोड येथील रहिवाशांवर स्वारी करा.","poem":2},{"text":"त्यांचा पाठलाग करा, त्यांचा वध करा व त्यांना समूळ नष्ट करा.”","poem":1},{"text":"असे याहवेह जाहीर करतात.","poem":2},{"lineBreak":true},{"text":"“मी तुम्हाला आज्ञापिलेले सर्वकाही करा.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"देशामध्ये रणगर्जनेचा ध्वनी ऐकू येत आहे.","poem":1},{"text":"प्रचंड विध्वंसतेचा ध्वनी!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"कसा मोडणारा व चुराडा करणारा","poem":1},{"text":"संपूर्ण पृथ्वीतलावरील अत्यंत जबरदस्त असा हा हातोडा!","poem":2},{"text":"सर्व राष्ट्रांमध्ये बाबिलोन","poem":1},{"text":"किती ओसाड बनले आहे!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"अगे बाबिलोन, मी तुझ्यासाठी सापळा लावला","poem":1},{"text":"आणि तुला कळण्या आधीच तू त्यात अडकलीस;","poem":2},{"text":"तू सापडलीस व पकडण्यात आलीस","poem":1},{"text":"कारण तू याहवेहस विरोध केला.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"याहवेहने आपले शस्त्रागार उघडले","poem":1},{"text":"व आपल्या क्रोधाचा स्फोट करण्यासाठी शस्त्रे बाहेर काढली,","poem":2},{"text":"कारण सार्वभौम सर्वसमर्थ याहवेहस","poem":1},{"text":"बाबेलच्या भूमीवर कार्य करावयाचे आहे.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"या! दूरदूरच्या राष्ट्रांमधून बाबेलवर स्वारी करण्यासाठी या!","poem":1},{"text":"तिची धान्यांची कोठारे फोडा; तिच्या भिंती पाडा,","poem":2},{"lineBreak":true},{"text":"धान्याच्या राशी सारखा तिचा ढिगारा करा.","poem":2},{"text":"आणि तिचा समूळ नायनाट करा","poem":1},{"text":"तिच्यातील कोणीही शिल्लक ठेवू नका.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"तिच्या सर्व तरुण बैलांची कत्तल करा;","poem":1},{"text":"त्यांना वध होण्यासाठी जाऊ द्या!","poem":2},{"text":"त्यांचा धिक्कार असो! कारण त्यांचा समय आला आहे,","poem":1},{"text":"त्यांना शिक्षा करण्याची वेळ आली आहे.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"बाबेलमधील फरारी व निर्वासित लोक सीयोनात काय म्हणतात ते ऐका","poem":1},{"text":"याहवेह, आमच्या परमेश्वराने कसा सूड घेतला,","poem":2},{"text":"त्यांच्या मंदिराबद्दल सूड घेतला.","poem":1},{"text":"हे याहवेह जाहीर करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“धनुर्धाऱ्यांना बाबेलविरुद्ध पाचारण करा,","poem":1},{"text":"धनुष्य ताणणाऱ्या सर्वांना बोलवा.","poem":2},{"text":"नगरीला वेढा घाला;","poem":1},{"text":"कोणालाही निसटून जाऊ देऊ नका.","poem":2},{"text":"तिच्या कृत्याची परतफेड करा;","poem":1},{"text":"तिने इतरांचे जसे केले, तसे तिचे करा.","poem":2},{"text":"तिने याहवेहला, इस्राएलाच्या पवित्र परमेश्वराला","poem":1},{"text":"उद्दामपणे तुच्छ लेखले,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"म्हणून, तिचे तरुण रस्तोरस्ती धराशायी होतील;","poem":1},{"text":"त्या दिवशी तिचे सर्व योद्धे निःशब्द होतील,”","poem":2},{"lineBreak":true},{"text":"हे याहवेह जाहीर करतात.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"“पाहा, अहो गर्विष्ठ लोकांनो, मीच तुमच्याविरुद्ध आहे","poem":1},{"text":"आता तुमचा दिवस आला आहे,","poem":2},{"text":"तुम्हाला शिक्षा देण्याचा समय आला आहे!","poem":1},{"text":"प्रभू सर्वसमर्थ याहवेह जाहीर करतात.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"गर्विष्ठ अडखळतील व पडतील,","poem":1},{"text":"तिला मदतीचा हात देऊन कोणीही उठविणार नाही;","poem":2},{"text":"मी तिच्या नगरांमध्ये अग्नी पेटवेन","poem":1},{"text":"तो अग्नी सभोवतालचे सर्वकाही गिळंकृत करेल.”","poem":2}]},{"type":"verse","number":33,"content":["सर्वसमर्थ याहवेह असे म्हणतात:",{"text":"“इस्राएलाच्या लोकांवर जुलूम झाला आहे.","poem":1},{"text":"व यहूदीयाच्या लोकांवरही झाला आहे.","poem":2},{"text":"त्यांना कैद करणार्‍यांनी त्यांना घट्ट पकडून ठेवले आहे","poem":1},{"text":"व त्यांना जाऊ देण्याचे ते नाकारतात.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"परंतु त्यांचे उद्धारकर्ता सामर्थ्यशाली आहेत;","poem":1},{"text":"सर्वसमर्थ याहवेह असे त्यांचे नाव आहे.","poem":2},{"text":"ते जोमाने त्यांचा बचाव करतील आणि इस्राएली देशात त्यांना शांतीने राहता यावे,","poem":1},{"text":"म्हणून ते त्यांच्या भूमीला शांती प्रदान करतील,","poem":2},{"lineBreak":true},{"text":"परंतु, बाबेलच्या लोकांना अशांती मिळेल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"“बाबेलवर तलवारीचा प्रहार होईल!","poem":1},{"text":"ती बाबेलमध्ये राहणाऱ्या लोकांवर","poem":2},{"text":"आणि तिच्या अधिपतींवर, सुज्ञ लोकांवरही प्रहार करेल!","poem":1},{"text":"याहवेह असे जाहीर करतात.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"तिच्या खोट्या संदेष्ट्यांवर तलवारीचा प्रहार होईल","poem":1},{"text":"ते सल्लागार मूर्ख बनतील!","poem":2},{"text":"तिच्या योद्ध्यांवर तलवारीचा प्रहार होईल!","poem":1},{"text":"ते अत्यंत भयभीत होतील.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"तिचे घोडे, रथांवर तलवारीचा प्रहार होईल!","poem":1},{"text":"आणि तिच्यात राहणाऱ्या विदेशीयांवरही होईल!","poem":2},{"lineBreak":true},{"text":"ते दुर्बल होतील.","poem":2},{"text":"तिच्या संपत्तीवर तलवारीचा प्रहार होईल!","poem":1},{"text":"त्यांची लूट केली जाईल.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"तिच्या पाण्यावर तलवारीचा","poem":1},{"noteId":47},{"text":"प्रहार होईल!","poem":1},{"text":"ते शुष्क होतील.","poem":2},{"text":"कारण ही मूर्तींची भूमी आहे,","poem":1},{"text":"आणि या मूर्ती भयाने वेड्या होतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“म्हणून या नगरीत वनपशू व तरस वास करतील,","poem":1},{"text":"व घुबडे येऊन राहतील.","poem":2},{"text":"येथे आता पुन्हा कधी मानवाची वस्ती होणार नाही;","poem":1},{"text":"किंवा ही नगरीत पिढ्यान् पिढ्या ओसाड पडेल.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"याहवेह जाहीर करतात,","poem":1},{"text":"जसा मी परमेश्वराने सदोम व गमोराचा","poem":2},{"lineBreak":true},{"text":"त्यांच्या सभोवतालच्या नगरांसह नाश केला,","poem":2},{"text":"म्हणजे तिथे कोणी राहणार नाही.","poem":1},{"text":"त्यात लोक वस्ती करणार नाहीत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“पाहा, उत्तरेकडील देशातून सैन्य येत आहे;","poem":1},{"text":"पृथ्वीच्या शेवटापासून","poem":2},{"lineBreak":true},{"text":"एक मोठे राष्ट्र व अनेक राजे भडकविले जात आहेत.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"त्यांचे सैनिक धनुष्ये व भाल्यांसहित सज्ज आहेत.","poem":1},{"text":"ते अत्यंत क्रूर व दयाहीन आहेत.","poem":2},{"text":"ते घोड्यांवर स्वार झाले असता","poem":1},{"text":"त्यांचा आवाज गर्जणाऱ्या समुद्राप्रमाणे आहे.","poem":2},{"text":"हे बाबिलोन कन्ये तुझ्यावर हल्ला करण्यासाठी","poem":1},{"text":"युद्धासाठी सुसज्जित असलेल्यांप्रमाणे ते येत आहेत.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"बाबेलच्या राजाने त्यांच्याबद्दल वार्ता ऐकली आहे.","poem":1},{"text":"त्याचे बाहू निखळले आहेत.","poem":2},{"text":"बाळाला जन्म देणाऱ्या स्त्रीच्या क्लेशाप्रमाणे","poem":1},{"text":"वेदनांनी त्याला ग्रासले आहे.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"यार्देन नदीच्या झुडूपातून","poem":1},{"text":"सुपीक कुरणात झेप घेणार्‍या सिंहाप्रमाणे,","poem":2},{"text":"बाबेलच्या लोकांना त्यांच्या भूमीवरून मी एका क्षणात पळवून लावेन.","poem":1},{"text":"मी नियुक्त करावे असा या कार्यासाठी कोण निवडलेला आहे?","poem":2},{"text":"माझ्यासारखा दुसरा कोण आहे? मला चेतावणी करणारा कोण आहे?","poem":1},{"text":"कोणता मेंढपाळ माझ्याविरुद्ध उभा राहील?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"बाबेलविरुद्ध याहवेहचा संकल्प काय आहे ते ऐका.","poem":1},{"text":"बाबेलच्या लोकांच्या भूमीविरुद्ध त्यांची काय योजना आहे, हे ऐकून घ्या.","poem":2},{"text":"त्यांच्या कळपातील तरुणांना फरफटत ओढत नेण्यात येईल.","poem":1},{"text":"त्यांच्या कुरणांना या दुर्दैवाने भयंकर धक्का बसेल.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"बाबेलच्या पतनाच्या आवाजाने पृथ्वी कंपित होईल;","poem":1},{"text":"त्याचा आक्रोश राष्ट्रांत प्रतिध्वनित होईल.","poem":2}]}],"footnotes":[{"noteId":46,"caller":"+","text":"खाल्डियन","reference":{"chapter":50,"verse":1}},{"noteId":47,"caller":"+","text":"किंवा च्या विरुद्ध तलवार","reference":{"chapter":50,"verse":38}}]},"thisChapterLink":"/api/mar_cbi/JER/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/JER/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/JER/49.json","previousChapterAudioLinks":{},"numberOfVerses":46}