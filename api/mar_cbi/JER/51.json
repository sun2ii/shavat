{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"JER","translationId":"mar_cbi","name":"यिर्मयाह","commonName":"यिर्मयाह","title":"यिर्मयाहची भविष्यवाणी","order":24,"numberOfChapters":52,"sha256":"6e2548f8969bad42c196f15503e8abcfae98acb5f8c49f884a4549b0646916c9","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/mar_cbi/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":["याहवेहचे म्हणणे हे असे आहे,",{"text":"“बाबिलोन व बाबिलोनच्या लोकांवर","poem":1},{"noteId":48},{"text":"चाल करून जाण्यास","poem":1},{"text":"मी एका संहारक आत्म्याला प्रेरित करेन.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"त्यांना पाखडण्यात यावे व त्यांच्या भूमीचा विध्वंस व्हावा","poem":1},{"text":"म्हणून मी बाबेलविरुद्ध विदेशी लोकांना पाठवेन;","poem":2},{"text":"तिच्या विनाशाच्या दिवशी","poem":1},{"text":"ते प्रत्येक दिशेने तिच्या विरोधात येतील.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिच्या सैनिकांना त्यांचे धनुष्य ताणू देऊ नका.","poem":1},{"text":"तिच्या योद्ध्यांची चिलखते अंगात घालू देऊ नका.","poem":2},{"text":"त्यांच्या तरुणांनाही सोडू नका;","poem":1},{"text":"त्यांच्या सैन्याचा संपूर्ण नाश करा.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"बाबेलमध्ये ते मरून पडतील.","poem":1},{"text":"तिच्या रस्त्यांवर ते मरणोप्राय जखमी होतील.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"त्यांची भूमी इस्राएलच्या पवित्र परमेश्वरासमोर","poem":1},{"text":"जरी तिच्या अपराधाने भरलेली आहे तरीही","poem":2},{"text":"त्यांचे परमेश्वर सर्वसमर्थ याहवेह यांनी","poem":1},{"text":"इस्राएल व यहूदीयाचा त्याग केला नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“बाबेलमधून पलायन करा!","poem":1},{"text":"आपला जीव वाचविण्यास पळा!","poem":2},{"lineBreak":true},{"text":"तिच्या पापांमुळे तुम्ही तुमचा नाश करून घेऊ नका.","poem":2},{"text":"हा याहवेहचा सूड घेण्याचा समय आहे;","poem":1},{"text":"ज्यास ती पात्र आहे, त्याचा मोबदला ते तिला देतील.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"बाबिलोन याहवेहच्या हातातील सुवर्णपात्र होते;","poem":1},{"text":"तिने संपूर्ण पृथ्वीला ते पाजून मद्यधुंद केले.","poem":2},{"text":"सर्व राष्ट्र तिचे मद्य प्याले;","poem":1},{"text":"म्हणून आता ते वेडे झाले आहेत.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"बाबिलोनचे अचानक पतन होईल व ती मोडली जाईल.","poem":1},{"text":"तिच्यासाठी विलाप करा!","poem":2},{"text":"तिच्या वेदना जाण्यासाठी औषध आणा;","poem":1},{"text":"कदाचित ती बरी होऊ शकेल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ ‘आम्ही बाबेलला बरे केले असते.","poem":1},{"text":"पण ती बरी होऊ शकत नाही.","poem":2},{"text":"आपण तिला सोडून आपल्या देशात परत जाऊ या.","poem":1},{"text":"कारण तिचा न्याय आता आकाशापर्यंत पोचला आहे,","poem":2},{"lineBreak":true},{"text":"तो स्वर्गाच्या उंचीपर्यंत पोहोचला आहे.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘याहवेहने आम्हाला निर्दोष घोषित केले आहे;","poem":1},{"text":"चला, आपण सीयोनात जाऊन सांगू","poem":2},{"lineBreak":true},{"text":"आमचे परमेश्वर याहवेहने काय केले आहे.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“बाणांना धार लावा,","poem":1},{"text":"ढाली उचलून घ्या!","poem":2},{"text":"याहवेहनी मेदियाच्या राजाला प्रेरित केले आहे,","poem":1},{"text":"कारण त्यांचा हेतू बाबेलचा नाश करण्याचा आहे.","poem":2},{"text":"याहवेह बाबेल्यांचा सूड उगवतील,","poem":1},{"text":"हा त्यांच्या मंदिराबद्दलचा सूड आहे.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"बाबेलच्या तटबंदीविरुद्ध तुमचे झेंडे उंच करा!","poem":1},{"text":"पहारेकऱ्यांची कुमक पाठवून मजबूत करा,","poem":2},{"text":"पहारेकऱ्यांना स्थानबद्ध करा,","poem":1},{"text":"दबा धरून बसण्याची तयारी करा!","poem":2},{"text":"याहवेहनी बाबेलच्या लोकांविरुद्ध दिलेल्या","poem":1},{"text":"फर्मानाचा हेतू ते सिद्धीस नेतील.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तुम्ही, जे बऱ्याच जलाशयाकाठी वास करता,","poem":1},{"text":"आणि अतिसंपन्न आहात,","poem":2},{"text":"तुमचा अंत जवळ आला आहे,","poem":1},{"text":"तुमचा नाश होण्याचा समय आला आहे.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"सर्वसमर्थ याहवेह, स्वतःच्याच नावाची शपथ घेतातः","poem":1},{"text":"मी निश्चितच तुम्हाला टोळधाडीसारख्या असंख्य सैनिकांनी भरून टाकेन","poem":2},{"lineBreak":true},{"text":"आणि लोक तुमच्यावरील विजयोन्मादाने गर्जना करतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“त्यांनी त्यांच्या सामर्थ्याने पृथ्वीची निर्मिती केली;","poem":1},{"text":"संपूर्ण विश्वाची प्रस्थापना त्यांच्या सुज्ञतेने केली","poem":2},{"lineBreak":true},{"text":"आणि त्यांच्या बुद्धीने आकाश विस्तीर्ण केले.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"जेव्हा ते गर्जना करतात, तेव्हा आकाशातील मेघ गर्जना करतात;","poem":1},{"text":"ते मेघांना पृथ्वीच्या एका टोकापासून दुसऱ्या टोकापर्यंत उभारतात.","poem":2},{"text":"ते विजा आणि पाऊस पाठवितात","poem":1},{"text":"आणि त्यांच्या भांडारातून वारा बाहेर काढतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“प्रत्येक मनुष्य असमंजस व ज्ञानहीन आहे;","poem":1},{"text":"प्रत्येक सोनार त्याच्या मूर्तींनी लज्जित झाला आहे.","poem":2},{"text":"त्याने घडविलेल्या प्रतिमा खोट्या आहेत.","poem":1},{"text":"त्यांच्यामध्ये श्वास नाही.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"त्या व्यर्थ असून उपहासाचा विषय आहेत;","poem":1},{"text":"जेव्हा त्यांचा न्याय होईल, तेव्हा त्यांचा नाश होईल.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"परंतु जो याकोबाचा वाटा आहे, तो यासारखा नाही.","poem":1},{"text":"कारण तेच सर्वांचे निर्माणकर्ता आहेत,","poem":2},{"text":"ते लोक त्यांचे वारस आहेत;","poem":1},{"text":"सर्वसमर्थ याहवेह हे त्यांचे नाव आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“तू माझ्या युद्धाचा सोटा आहेस.","poem":1},{"text":"माझे युध्दशस्त्र—","poem":2},{"text":"तुझ्याद्वारे मी राष्ट्रांना डळमळीत करेन,","poem":1},{"text":"तुझ्याद्वारे मी राज्ये नष्ट करेन,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"तुझ्याद्वारे मी घोडा आणि घोडेस्वाराचा संपूर्ण नाश करेन,","poem":1},{"text":"तुझ्याद्वारे मी रथ आणि सारथी यांचा संपूर्ण नाश करेन,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"तुझ्याद्वारे मी पुरुष व स्त्रीचा संपूर्ण नाश करेन,","poem":1},{"text":"तुझ्याद्वारे मी वृद्धाचा व तरुणाचा संपूर्ण नाश करेन,","poem":2},{"lineBreak":true},{"text":"तुझ्याद्वारे मी तरुण व तरुणींचा संपूर्ण नाश करेन,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"तुझ्याद्वारे मी मेंढपाळांचा आणि कळपांचा संपूर्ण नाश करेन,","poem":1},{"text":"तुझ्याद्वारे मी शेतकर्‍यांचा आणि बैलांचा संपूर्ण नाश करेन,","poem":2},{"lineBreak":true},{"text":"तुझ्याद्वारे मी राज्यपालांचा आणि अधिपतींचा संपूर्ण नाश करेन.","poem":2}]},{"type":"verse","number":24,"content":["“बाबिलोन व बाबिलोनचे लोक यांनी सीयोनाशी जे दुष्कृत्य केले, त्याबद्दल मी तुझ्या डोळ्यादेखत त्यांची परतफेड करेन.” असे याहवेह जाहीर करतात."]},{"type":"verse","number":25,"content":[{"text":"“हे संहारक पर्वता, तू जो संपूर्ण पृथ्वीचा विध्वंस करतो,","poem":1},{"text":"मी तुझ्याविरुद्ध आहे,”","poem":2},{"lineBreak":true},{"text":"याहवेह जाहीर करतात,","poem":2},{"text":"“मी माझा हात तुझ्याविरुद्ध उगारेन,","poem":1},{"text":"तुला कडेलोट करेन,","poem":2},{"lineBreak":true},{"text":"आणि तुला भस्म झालेला डोंगर करेन.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"तुझ्यातील पाषाण कोनशिलेसाठी वापरण्यात येणार नाहीत.","poem":1},{"text":"पायाभरणीसाठीही तुझे डबर घेणार नाहीत,","poem":2},{"lineBreak":true},{"text":"तू कायमची उजाड होशील,” याहवेह जाहीर करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“या भूमीवर आपले ध्वज फडकवा!","poem":1},{"text":"राष्ट्रांमध्ये रणशिंगे वाजवा!","poem":2},{"text":"तिच्याशी युद्ध करण्यासाठी राष्ट्रांना सुसज्ज करा;","poem":1},{"text":"या राष्ट्रांना तिच्याविरुद्ध पाचारण करा:","poem":2},{"lineBreak":true},{"text":"अरारात, मिन्नी व आष्कनाज.","poem":2},{"text":"तिच्याविरुद्ध सेनापतीची नेमणूक करा;","poem":1},{"text":"टोळधाडी सारखा घोड्यांचा प्रचंड समुदाय पाठवा.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"तिच्याशी युद्ध करण्यासाठी राष्ट्रांना सुसज्ज करा—","poem":1},{"text":"मेदिया राजे,","poem":2},{"text":"त्यांचे राज्यपाल आणि अधिपती,","poem":1},{"text":"आणि ज्यावर ते शासन करतात अशी सर्व राष्ट्रे.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"भूमी थरथरत व वेदनांनी तळमळत आहे,","poem":1},{"text":"कारण याहवेहने बाबेलविरुद्ध केलेला संकल्प कायमचा आहे—","poem":2},{"text":"बाबेलची भूमी ओसाड होईल","poem":1},{"text":"जेणेकरून तिथे कोणीही राहणार नाही.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"बाबिलोनचे योद्धे युद्ध करण्याचे थांबले आहेत;","poem":1},{"text":"ते त्यांच्या गडात बसून आहेत.","poem":2},{"text":"त्यांचे सामर्थ्य संपुष्टात आले आहे;","poem":1},{"text":"ते दुर्बल झाले आहेत.","poem":2},{"text":"तिचे आवास जळत आहेत;","poem":1},{"text":"तिच्या प्रवेशद्वाराच्या सळया मोडल्या आहेत.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"बाबेलच्या राजाला वर्तमान सांगण्यासाठी,","poem":1},{"text":"की त्याचे संपूर्ण नगर हस्तगत करण्यात आले आहे,","poem":2},{"text":"संदेशवाहक एका पाठोपाठ धावत आहेत","poem":1},{"text":"निरोपे एका पाठोपाठ येत आहेत,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"नदीवरील पूल जप्त करण्यात आले आहेत,","poem":1},{"text":"दलदली जळत आहेत,","poem":2},{"lineBreak":true},{"text":"सैन्य भयभीत झाले आहेत.”","poem":2}]},{"type":"verse","number":33,"content":["कारण सर्वसमर्थ याहवेह, इस्राएलचे परमेश्वर असे म्हणतात:",{"text":"“बाबेलची कन्या अशा खळ्याप्रमाणे आहे","poem":1},{"text":"जिची तुडवणी सुरू होण्याची वेळ आली आहे;","poem":2},{"lineBreak":true},{"text":"तिचे पीक घेण्याचा समय लवकरच येणार आहे.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“बाबेलच्या नबुखद्नेस्सर राजाने आम्हाला गिळंकृत केले आहे,","poem":1},{"text":"त्याने आम्हाला निराशेत ढकलले आहे,","poem":2},{"lineBreak":true},{"text":"त्याने आम्हाला रिक्त भांड्यासारखे केले आहे.","poem":2},{"text":"सर्पासारखे त्याने आम्हाला गिळले आहे.","poem":1},{"text":"आणि आमच्या मिष्टान्नाने स्वतःचे पोट भरले आहे,","poem":2},{"lineBreak":true},{"text":"आणि मग आम्हाला बाहेर थुंकून दिले आहे.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"सीयोनचे रहिवासी म्हणतात,","poem":1},{"text":"आमच्या संतानांवर जसा अत्याचार केला, तसा बाबेलवर येवो,”","poem":2},{"text":"यरुशलेम म्हणते,","poem":1},{"text":"“आमचे रक्त सांडल्याचा सर्व दोष बाबेल्यांवर पडो.”","poem":2}]},{"type":"verse","number":36,"content":["म्हणून याहवेह असे म्हणतात:",{"text":"“मी तुमची बाजू मांडेन","poem":1},{"text":"मी तुमचा सूड उगवेन;","poem":2},{"text":"मी तिचे समुद्र आटवून टाकेन","poem":1},{"text":"आणि तिचे झरे शुष्क करेन.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"बाबिलोन भग्नावशेषाचा ढिगारा होईल,","poem":1},{"text":"तिथे कोल्ह्यांचा संचार होईल,","poem":2},{"text":"ते भयानकतेचा व तिरस्काराचा विषय होतील,","poem":1},{"text":"जिथे कोणीही राहत नाही असे ठिकाण.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"तिचे सर्व लोक तरुण सिंहाप्रमाणे गर्जना करतील,","poem":1},{"text":"सिंहाच्या छाव्यासारखे डरकाळ्या मारतील.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"पण ते जेव्हा जागृत होतील,","poem":1},{"text":"मी त्यांच्यासाठी मेजवानी सिद्ध करेन","poem":2},{"lineBreak":true},{"text":"त्यांना मद्यधुंद करेन,","poem":2},{"text":"म्हणजे ते किंकाळ्या मारून हसतील—मग ते कायमचे झोपतील","poem":1},{"text":"मग ते चिरनिद्रा घेतील व उठणार नाहीत.”","poem":2},{"lineBreak":true},{"text":"असे याहवेह जाहीर करतात.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"मी त्यांना कोकरागत,","poem":1},{"text":"मेंढ्या व बोकडागत","poem":2},{"lineBreak":true},{"text":"कत्तल करण्यास खाली आणेन.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“शेशाक","poem":1},{"noteId":49},{"text":"कसे हस्तगत केल्या जाईल,","poem":1},{"text":"संपूर्ण पृथ्वीचे अभिमान पात्र जप्त केल्या जाईल!","poem":2},{"text":"सर्व राष्ट्रांमध्ये बाबिलोन","poem":1},{"text":"किती ओसाड होईल!","poem":2}]},{"type":"verse","number":42,"content":[{"text":"बाबेलवर सागर उसळून येईल;","poem":1},{"text":"सागरलाटांनी ती भूमी झाकून जाईल.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"तिची शहरे ओसाड होतील,","poem":1},{"text":"ती एक शुष्क व निर्जन भूमी होईल,","poem":2},{"text":"एक अशी भूमी जिथे कोणी मनुष्य राहत नाही,","poem":1},{"text":"जिच्यामधून कोणीही प्रवास करीत नाही.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"मी बेलला बाबिलोन मध्येच शिक्षा देईन","poem":1},{"text":"आणि त्याने जे गिळले ते मी त्याला थुंकावयास लावेन.","poem":2},{"text":"यापुढे राष्ट्रे त्याच्याकडे","poem":1},{"noteId":50},{"text":"जमावाने येणार नाहीत.","poem":1},{"text":"बाबेलची तटबंदी कोसळून पडेल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“अहो माझ्या लोकांनो, तिच्यामधून बाहेर पडा!","poem":1},{"text":"पलायन करून आपला जीव वाचवा!","poem":2},{"lineBreak":true},{"text":"याहवेहच्या भयंकर क्रोधापासून दूर पळा.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"जेव्हा तुम्हाला देशात अफवा ऐकिवात येतील","poem":1},{"text":"तेव्हा तुमचे अंतःकरण खचू देऊ नका किंवा भयभीत होऊ नका;","poem":2},{"text":"देशात आणि एका राजाने दुसऱ्या राजाविरुद्ध केलेल्या","poem":1},{"text":"हिंसाचारांच्या अफवा ऐकू येतील,","poem":2},{"lineBreak":true},{"text":"एक अफवा या वर्षी येते तर दुसरी पुढील वर्षी येते.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"असा समय निश्चित येईल","poem":1},{"text":"जेव्हा मी बाबेलच्या मूर्तींना शिक्षा करेन;","poem":2},{"text":"तिच्या संपूर्ण देशाची अप्रतिष्ठा होईल","poem":1},{"text":"वध केलेल्यांचे शव तिच्या भूमीवर पडलेले दिसतील.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"मग स्वर्गात व पृथ्वीवर व त्यामध्ये असलेले सर्व","poem":1},{"text":"बाबेलवरील विजयोत्सवाच्या आनंदाने गर्जना करतील,","poem":2},{"text":"कारण उत्तरेकडून","poem":1},{"text":"विनाशक तिच्यावर हल्ला करतील.”","poem":2},{"lineBreak":true},{"text":"असे याहवेह जाहीर करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"“जसे संपूर्ण पृथ्वीवर वध झालेले मृतदेह पडतात,","poem":1},{"text":"तसेच इस्राएल लोकांच्या केलेल्या हत्येमुळे","poem":2},{"lineBreak":true},{"text":"बाबेलचा पाडाव होईल.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"जे तुम्ही तलवारीपासून वाचला आहात,","poem":1},{"text":"ते तुम्ही निघून जा, उगाच रेंगाळू नका!","poem":2},{"text":"दूरवरील भूमीवर याहवेहचे स्मरण करा,","poem":1},{"text":"आणि यरुशलेम तुमच्या स्मरणात येवो.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"“आमची अप्रतिष्ठा झाली आहे,","poem":1},{"text":"आमचा अपमान झाला आहे","poem":2},{"lineBreak":true},{"text":"लज्जेने आमची मुखमंडले झाकली गेली आहेत,","poem":2},{"text":"कारण परकीय लोकांनी","poem":1},{"text":"याहवेहच्या भवनातील पवित्रस्थानी प्रवेश केला आहे.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"याहवेह जाहीर करतात, “पण असे दिवस येत आहेत,","poem":1},{"text":"जेव्हा मी तिच्या मूर्तींना शिक्षा देईन,","poem":2},{"text":"संपूर्ण देशभरातील","poem":1},{"text":"जखमी लोक कण्हतील.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"बाबिलोन जरी गगनापर्यंत पोचली","poem":1},{"text":"आणि तिने आपल्या गढांची तटबंदी केली,","poem":2},{"lineBreak":true},{"text":"तरी मी तिच्याविरुद्ध विनाशक पाठवेन,”","poem":2},{"lineBreak":true},{"text":"याहवेह जाहीर करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"“बाबेलमधून विलापाचा ध्वनी ऐकू येत आहे,","poem":1},{"text":"तिच्या घोर विनाशाचा ध्वनी","poem":2},{"lineBreak":true},{"text":"बाबेलांच्या प्रदेशातूनच ऐकू येत आहे.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"याहवेह बाबेलचा विनाश करणार आहेत;","poem":1},{"text":"तेच तिच्यामधील कोलाहल शांत करतील.","poem":2},{"text":"शत्रूंच्या लाटा तिच्यावर प्रचंड पाण्यासारख्या कोसळतील;","poem":1},{"text":"त्या आवाजाच्या गर्जनेचा प्रतिध्वनी ऐकू येईल.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"बाबेलांच्या विरुद्ध विनाशक येईल;","poem":1},{"text":"तिचे योद्धे बंदी बनविले जातील,","poem":2},{"lineBreak":true},{"text":"आणि त्यांचे धनुष्य मोडून टाकण्यात येतील.","poem":2},{"text":"कारण याहवेह परतफेड करणारे परमेश्वर आहेत;","poem":1},{"text":"ते पुरेपूर परतफेड करतील.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"मी तिचे राज्यपाल, सुज्ञ लोक, अधिपती, सेनापती","poem":1},{"text":"व योद्धे या सर्वांना मद्यधुंद करेन;","poem":2},{"text":"ते झोपतील आणि पुन्हा कधीच उठणार नाहीत,”","poem":1},{"text":"महाराज, सर्वसमर्थ याहवेह असे जाहीर करतात.","poem":2}]},{"type":"verse","number":58,"content":["सर्वसमर्थ याहवेह असे म्हणतात:",{"text":"“बाबेलची दुर्गम तटबंदी भुईसपाट होईल","poem":1},{"text":"आणि तिच्या उंच वेशी अग्नीने भस्म करण्यात येतील;","poem":2},{"text":"लोकांचे कष्ट व्यर्थ ठरतील,","poem":1},{"text":"देशाने केलेले श्रम अग्नीचे जळण होईल.”","poem":2}]},{"type":"verse","number":59,"content":["सिद्कीयाहच्या कारकिर्दीच्या चौथ्या वर्षी जेव्हा यिर्मयाह संदेष्ट्याने यहूदीयाचा राजा सिद्कीयाहसह बाबेलला गेला, तेव्हा त्याने सेरायाहस, जो नेरीयाहचा पुत्र, जो महसेयाहचा नातू, तो सैन्यात दुय्यम दर्जाचा एक अधिकारी होता त्याला हा संदेश दिला."]},{"type":"verse","number":60,"content":["बाबेलवर जी भयंकर अरिष्टे येणार होती, ती यिर्मयाहने एका गुंडाळीवर लिहिली—बाबेलवर येणाऱ्या सर्व अरिष्टांची नोंद करून ठेवण्यात आली होती."]},{"type":"verse","number":61,"content":["यिर्मयाह सेरायाहाला म्हणाला, “तू बाबिलोन येथे गेल्यावर मी लिहिलेले सर्व मोठ्याने वाच."]},{"type":"verse","number":62,"content":["मग म्हण, ‘हे याहवेह, तुम्ही म्हटले की तुम्ही बाबेलचा नाश कराल व तिथे कोणीही मनुष्य वा पशूप्राणी वसती करणार नाही; ती कायमची ओसाड होईल.’"]},{"type":"verse","number":63,"content":["मग तू ही गुंडाळी वाचून संपवलीस की तिला एक दगड बांधून ती फरात",{"noteId":51},"नदीत फेकून दे."]},{"type":"verse","number":64,"content":["आणि म्हण, ‘बाबेलही अशीच बुडेल व पुन्हा कधीही वर येणार नाही, कारण मी तिच्यावर अरिष्ट आणणार आहे, आणि तिच्यामधील लोक पडतील.’ ”",{"lineBreak":true},{"lineBreak":true},"इथे यिर्मयाहच्या संदेशाचा शेवट होतो."]},{"type":"line_break"}],"footnotes":[{"noteId":48,"caller":"+","text":"मूळ प्रतीत लेव खमायी","reference":{"chapter":51,"verse":1}},{"noteId":49,"caller":"+","text":"बाबिलोन","reference":{"chapter":51,"verse":41}},{"noteId":50,"caller":"+","text":"उपासना करण्यास","reference":{"chapter":51,"verse":44}},{"noteId":51,"caller":"+","text":"फरात किंवा ज्याला आजच्या काळात युफ्रेटिस या नावाने ओळखले जाते","reference":{"chapter":51,"verse":63}}]},"thisChapterLink":"/api/mar_cbi/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}