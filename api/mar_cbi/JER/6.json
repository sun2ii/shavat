{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"JER","translationId":"mar_cbi","name":"यिर्मयाह","commonName":"यिर्मयाह","title":"यिर्मयाहची भविष्यवाणी","order":24,"numberOfChapters":52,"sha256":"6e2548f8969bad42c196f15503e8abcfae98acb5f8c49f884a4549b0646916c9","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/mar_cbi/JER/52.json","totalNumberOfVerses":1363},"chapter":{"number":6,"content":[{"type":"heading","content":["यरुशलेमला वेढा पडतो"]},{"type":"verse","number":1,"content":[{"text":"“बिन्यामीन वंशजानो, आपल्या सुरक्षेसाठी तुम्ही पलायन करा!","poem":1},{"text":"यरुशलेममधून पळून जा!","poem":2},{"text":"तकोवा इथून कर्ण्याचा आवाज येताच","poem":1},{"text":"बेथ-हक्करेम येथे धोक्याची सूचना देणारे संकेत द्या!","poem":2},{"text":"कारण उत्तरेकडून येणारा नाश पुढे दिसत आहे,","poem":1},{"text":"भयंकर विनाश.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"सीयोनाच्या सुंदर आणि सुकुमार कन्येला","poem":1},{"text":"मी उद्ध्वस्त करेन.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"मेंढपाळ त्यांचे कळप सोबत घेऊन तिच्याविरुद्ध येतील;","poem":1},{"text":"ते तिच्या नगराभोवती त्यांचे तंबू ठोकतील,","poem":2},{"lineBreak":true},{"text":"प्रत्येक कळपासाठी कुरणे विभागतील.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“तिच्याविरुद्ध युद्धाची तयारी करा!","poem":1},{"text":"उठा, चला दुपारच्या वेळी हल्ला करू!","poem":2},{"text":"हाय हाय! परंतु आता दिवसाचा प्रकाश मंदावला आहे.","poem":1},{"text":"आणि संध्याकाळची छाया लांब वाढत आहे.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"चला, आता आपण रात्री हल्ला चढवू","poem":1},{"text":"आणि तिच्या गडांचा नाश करू!”","poem":2}]},{"type":"verse","number":6,"content":["कारण सर्वसमर्थ याहवेह परमेश्वर असे म्हणतात:",{"text":"“झाडे तोडून टाका","poem":1},{"text":"आणि यरुशलेममध्ये तटबंदीची बांधणी करा.","poem":2},{"text":"या नगराला शिक्षा झालीच पाहिजे;","poem":1},{"text":"तिच्यात जुलूम भरलेला आहे.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ज्याप्रमाणे विहिरीच्या झऱ्यातून पाणी बाहेर वाहते,","poem":1},{"text":"तशी तिची दुष्टाई झर्‍याप्रमाणे उफाळून येते.","poem":2},{"text":"तिच्या रस्त्यारस्त्यातून हिंसाचार व विनाशाचे आवाज घुमतात;","poem":1},{"text":"तिचे रोग व तिच्या जखमा सदोदित माझ्या नजरेसमोर आहेत.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"हे यरुशलेम, तुला हा इशारा आहे.","poem":1},{"text":"नाही तर मी तुझ्यापासून दूर होईन","poem":2},{"text":"आणि मी तुझ्या देशाला उजाड करेन","poem":1},{"text":"जिथे कोणीही मनुष्य राहणार नाही.”","poem":2}]},{"type":"verse","number":9,"content":["सर्वसमर्थ याहवेह असे म्हणतात:",{"text":"“ज्या प्रकारे उरलेले थोडेथोडे द्राक्ष गोळा करण्यात येतात","poem":1},{"text":"त्याचप्रमाणे इस्राएलमधून थोड्याफार उरलेल्या निवडक लोकांना एकत्र करण्यात येईल;","poem":2},{"text":"ज्या प्रकारे द्राक्ष गोळा करण्यात येतात,","poem":1},{"text":"त्याप्रकारे तुमचे हात पुन्हा फांद्यांवरून फिरवा.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"मी कोणाशी बोलू व सावधगिरीचा इशारा देऊ?","poem":1},{"text":"माझे कोण ऐकेल?","poem":2},{"text":"त्यांचे कान बंद झाले आहेत","poem":1},{"noteId":3},{"text":"त्यांना ऐकूच येत नाही.","poem":2},{"text":"याहवेहचे वचन त्यांना संतप्त करते;","poem":1},{"text":"त्यांना ते सुखद वाटत नाही.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"परंतु मी याहवेहच्या क्रोधाने भडकलो आहे,","poem":1},{"text":"हा क्रोध मला आवरून धरवत नाही.","poem":2},{"lineBreak":true},{"text":"“मी हा क्रोध रस्तोरस्ती असलेल्या मुलांवर","poem":1},{"text":"आणि तरुणांच्या गटांवर ओततो;","poem":2},{"text":"दोघे पतिपत्नी त्यात अडकले जातील,","poem":1},{"text":"आणि वयस्कर, जे वयातीत आहेत ते देखील.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"त्यांची घरे दुसऱ्यांना देण्यात येतील,","poem":1},{"text":"ते त्यांची शेते व त्यांच्या स्त्रियाही इतरांना दिल्या जातील,","poem":2},{"text":"जेव्हा माझा हात मी या देशात राहणाऱ्या","poem":1},{"text":"लोकांविरुद्ध उगारेन, तेव्हा हे घडेल,”","poem":2},{"lineBreak":true},{"text":"असे याहवेह जाहीर करतात.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“त्यांच्यातील लहानापासून ते मोठ्यांपर्यंत","poem":1},{"text":"सर्वजण लोभी आहेत;","poem":2},{"text":"संदेष्टे आणि याजक सर्व एकसारखेच,","poem":1},{"text":"कपटी व्यवहार करतात.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"माझ्या लोकांच्या घावावर ते असा उपचार करतात","poem":1},{"text":"की जणू ते फारसे गंभीर नाही.","poem":2},{"text":"‘शांती, शांती आहे’ असे ते म्हणतात,","poem":1},{"text":"परंतु शांती कुठेही नाही.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"त्यांना त्यांच्या वाईट कृत्याबद्दल लाज वाटते का?","poem":1},{"text":"नाही, त्यांना मुळीच लज्जा वाटत नाही;","poem":2},{"lineBreak":true},{"text":"लाज वाटणे म्हणजे काय असते हे त्यांना माहीतच नाही.","poem":2},{"text":"म्हणून ते पतन पावलेल्या लोकांमध्ये पतन पावतील;","poem":1},{"text":"मी जेव्हा त्यांना शिक्षा देईल तेव्हा त्यांचे पतन होईल,”","poem":2},{"lineBreak":true},{"text":"असे याहवेह म्हणतात.","poem":2}]},{"type":"verse","number":16,"content":["याहवेह असे म्हणतात:",{"text":"“चौरस्त्यावर उभे राहा व पाहा;","poem":1},{"text":"पुरातन मार्गाची विचारणा करा,","poem":2},{"text":"तो चांगला मार्ग कुठे आहे ते विचारा आणि त्या मार्गाने जा,","poem":1},{"text":"तसे केल्यास तुमच्या आत्म्याला शांती लाभेल.","poem":2},{"lineBreak":true},{"text":"परंतु तुम्ही म्हटले, ‘आम्ही त्या मार्गाने चालणार नाही.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"मी तुमच्यावर पहारेकरी नेमले आणि म्हटले,","poem":1},{"text":"‘रणशिंगाच्या आवाजाकडे लक्ष द्या!’","poem":2},{"lineBreak":true},{"text":"परंतु तुम्ही म्हटले, ‘आम्ही ऐकणार नाही.’","poem":2}]},{"type":"verse","number":18,"content":[{"text":"म्हणून माझ्या राष्ट्रांनो माझे ऐका;","poem":1},{"text":"तुम्ही माझे साक्षीदार आहात,","poem":2},{"lineBreak":true},{"text":"त्यांचे काय होईल ते समजून घ्या.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"हे पृथ्वी तू ऐक:","poem":1},{"text":"मी या लोकांवर महासंकट आणत आहे,","poem":2},{"lineBreak":true},{"text":"त्यांच्याच कारस्थानाचे फळ,","poem":2},{"text":"कारण त्यांनी माझी वचने ऐकली नाही","poem":1},{"text":"आणि माझे नियम नाकारले.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"शबाहून आणलेल्या सुगंधी धूपाचा मला काय उपयोग","poem":1},{"text":"किंवा दूरदेशातील मोलाच्या द्रव्याचा काय उपयोग?","poem":2},{"text":"तुमची होमार्पणे मला संतुष्ट करीत नाही;","poem":1},{"text":"तुमचे यज्ञबली मला प्रसन्न करीत नाहीत.”","poem":2}]},{"type":"verse","number":21,"content":["म्हणून याहवेह असे म्हणतात:",{"text":"“मी या लोकांच्या मार्गात अडथळे पाठवेन.","poem":1},{"text":"त्यावर मातापिता आणि लेकरे सारखेच अडखळतील.","poem":2},{"lineBreak":true},{"text":"शेजारी आणि मित्र नाश पावतील.”","poem":2}]},{"type":"verse","number":22,"content":["याहवेह असे म्हणतात:",{"text":"“पाहा, उत्तरेकडील देशातून","poem":1},{"text":"सैन्य येत आहे;","poem":2},{"text":"पृथ्वीच्या शेवटापासून","poem":1},{"text":"एक मोठे राष्ट्र भडकविले जात आहे.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"त्यांचे सैनिक धनुष्य व भाल्यासहित सज्ज आहेत.","poem":1},{"text":"ते अत्यंत क्रूर असून दया दाखवित नाही.","poem":2},{"text":"ते घोड्यांवर स्वार झाले असता","poem":1},{"text":"त्यांचा आवाज गर्जणाऱ्या समुद्राप्रमाणे आहे.","poem":2},{"text":"हे सीयोनकन्ये तुझ्यावर हल्ला करण्यासाठी","poem":1},{"text":"युद्धासाठी सुसज्जित असलेल्यांप्रमाणे ते येत आहेत.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"आम्ही त्यांच्याबद्दल वार्ता ऐकली आहे,","poem":1},{"text":"आणि आमचे बाहू निखळले आहेत.","poem":2},{"text":"बाळाला जन्म देणाऱ्या स्त्रीच्या क्लेशाप्रमाणे","poem":1},{"text":"वेदनांनी आम्हाला ग्रासले आहे.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"शेतातून बाहेर जाऊ नका,","poem":1},{"text":"किंवा रस्त्यांवरून प्रवास करू नका,","poem":2},{"text":"कारण शत्रूकडे तलवार आहे,","poem":1},{"text":"आणि प्रत्येक बाजूला आतंक पसरलेला आहे.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"माझ्या लोकांनो, गोणपाट धारण करा,","poem":1},{"text":"आणि राखेत लोळा;","poem":2},{"text":"एकुलत्या एका पुत्रासाठी आक्रोश करतो","poem":1},{"text":"तसा आक्रोश कर.","poem":2},{"text":"कारण संहारक सेना एकाएकी","poem":1},{"text":"तुझ्यावर हल्ला करेल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“मी तुला धातूंची पारख करणारा केले आहे.","poem":1},{"text":"आणि माझ्या लोकांना अशुद्ध धातू,","poem":2},{"text":"जेणेकरून तू त्यांना पारखावे,","poem":1},{"text":"व त्यांच्या मार्गाची परीक्षा करावी.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ते सर्व कठोर बंडखोर आहेत,","poem":1},{"text":"निंदा करीत फिरत आहेत.","poem":2},{"text":"ते कास्य आणि लोखंडासारखे;","poem":1},{"text":"त्या सर्वांची वर्तणूक दूषित आहे.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"भट्टीचा भाता भयानकपणे वाजत आहे.","poem":1},{"text":"शुद्ध करणारा अग्नी शिसे भस्म करीत आहे,","poem":2},{"text":"परंतु हे शुद्धीकरण व्यर्थ होत आहे,","poem":1},{"text":"दुष्ट मार्गानी चालणारे पूर्णपणे शुद्ध होत नाहीत.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ते अशुद्ध चांदीसारखे नाकारलेले आहेत,","poem":1},{"text":"कारण याहवेहने त्यांचा त्याग केला आहे.”","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"किंवा बेसुंती","reference":{"chapter":6,"verse":10}}]},"thisChapterLink":"/api/mar_cbi/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}