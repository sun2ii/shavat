{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"JOB","translationId":"mar_cbi","name":"इय्योब","commonName":"इय्योब","title":"इय्योब","order":18,"numberOfChapters":42,"sha256":"4336c95e5d445803e0152da6f63f791035dd888d11789a434de8ae667cdbb987","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mar_cbi/JOB/42.json","totalNumberOfVerses":1069},"chapter":{"number":25,"content":[{"type":"heading","content":["बिल्दद"]},{"type":"verse","number":1,"content":["मग बिल्दद शूहीने उत्तर देत म्हटले:"]},{"type":"verse","number":2,"content":[{"text":"“प्रभुत्व आणि भय हे परमेश्वराचे आहे;","poem":1},{"text":"तेच परमोच्च स्वर्गामध्ये शांती स्थापित करतात.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"त्यांच्या सैन्याची गणती करता येईल काय?","poem":1},{"text":"आणि त्यांचा प्रकाश कोणावर पडत नाही?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मग मर्त्य परमेश्वरासमोर कसा नीतिमान ठरेल?","poem":1},{"text":"स्त्रीपासून जन्मलेला व्यक्ती पवित्र असू शकतो काय?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"जर चंद्र सुद्धा परमेश्वरासमोर प्रकाशमान नाही","poem":1},{"text":"आणि तारेही त्यांच्या नजरेत शुद्ध नाहीत,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मग मानव तो काय, जो केवळ एक कीटक आहे—","poem":1},{"text":"मानवप्राणी, तो तर केवळ अळीप्रमाणे आहे!”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}