{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"JOL","translationId":"mar_cbi","name":"योएल","commonName":"योएल","title":"योएलाची भविष्यवाणी","order":29,"numberOfChapters":3,"sha256":"0e04c0a6397e700857e558b2bd167bc6f87c37b25fed4479318a6f38622e5c03","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mar_cbi/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["पेथूएलचा पुत्र योएलकडे याहवेहचे वचन आले."]},{"type":"line_break"},{"type":"heading","content":["टोळांचे आक्रमण"]},{"type":"verse","number":2,"content":[{"text":"वडिलजनहो, हे ऐका;","poem":1},{"text":"या देशात राहणारे प्रत्येकजण हे ऐको.","poem":2},{"text":"तुमच्या दिवसात किंवा","poem":1},{"text":"तुमच्या पूर्वजांच्या दिवसात असे कधी घडले होते काय?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तुम्ही ते आपल्या लेकरांना सांगा,","poem":1},{"text":"आणि तुमच्या लेकरांनी ते त्यांच्या लेकरांना सांगावे,","poem":2},{"lineBreak":true},{"text":"आणि त्यांच्या लेकरांनी पुढील पिढीला सांगावे.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"कुरतडणार्‍या टोळांनी जे सोडले होते,","poem":1},{"text":"ते झुंडींनी येणार्‍या टोळांनी खाल्ले;","poem":2},{"text":"जे झुंडींनी येणार्‍या टोळांनी सोडले","poem":1},{"text":"ते खुरडत चालणार्‍या टोळांनी खाल्ले;","poem":2},{"text":"जे खुरडत चालणार्‍या टोळांनी सोडले","poem":1},{"text":"ते इतर टोळांनी खाल्ले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"अहो मद्यप्यांनो, जागे व्हा आणि रडा!","poem":1},{"text":"हे सर्व द्राक्षारस पिणार्‍यांनो विलाप करा;","poem":2},{"text":"नवीन द्राक्षारसाकरिता विलाप करा","poem":1},{"text":"कारण तो तुमच्या ओठातून काढून घेतला आहे.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"एक राष्ट्र माझ्या देशावर चालून आले आहे,","poem":1},{"text":"ते सैन्य बलाढ्य आणि असंख्य आहे;","poem":2},{"text":"त्यांचे दात हे सिंहाचे दात आहे,","poem":1},{"text":"त्यांचे सुळे हे सिंहिणीचे सुळे आहेत.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"त्या राष्ट्रांनी माझ्या द्राक्षवेलींची नासधूस केली आहेत","poem":1},{"text":"आणि अंजिराच्या झाडांचा नाश केला आहे.","poem":2},{"text":"त्यांनी त्याचे खोड सोलून","poem":1},{"text":"साल दूर फेकली आहे,","poem":2},{"lineBreak":true},{"text":"त्यांच्या फांद्या पांढर्‍या केल्या आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"जशी एक कुमारी गोणपाट नेसून","poem":1},{"text":"आपल्या तारुण्यातील प्रियकरासाठी करते, तसा तुम्हीही शोक करा.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"याहवेहच्या मंदिरात वाहण्याची","poem":1},{"text":"अन्नार्पणे व पेयार्पणे बंद झाली आहेत;","poem":2},{"text":"याहवेहसमोर सेवा करणारे याजक","poem":1},{"text":"विलाप करीत आहे.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"शेतांची धूळधाण झाली आहेत,","poem":1},{"text":"भूमी कोरडी पडली आहे;","poem":2},{"text":"धान्याचा नाश झाला आहे,","poem":1},{"text":"नवीन द्राक्षारस सुकला आहे,","poem":2},{"lineBreak":true},{"text":"जैतून तेल समाप्त झाले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"अहो, शेतकर्‍यांनो, लज्जित व्हा,","poem":1},{"text":"द्राक्षमळ्यांची मशागत करणार्‍यांनो,","poem":2},{"text":"आकांत करा; गहू व जव याकरिता विलाप करा,","poem":1},{"text":"कारण शेतातील पिके नष्ट झाली आहेत.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"द्राक्षवेल वाळून गेली आहे","poem":1},{"text":"अंजिराचे झाड कोमेजले आहे;","poem":2},{"text":"डाळिंब, खजुराचे आणि सफरचंदाचे झाड;","poem":1},{"text":"शेतातील सर्व झाडे सुकून गेली आहेत.","poem":2},{"text":"खचितच लोकांचा आनंद","poem":1},{"text":"विरून गेला आहे.","poem":2}]},{"type":"heading","content":["विलापासाठी आव्हान"]},{"type":"verse","number":13,"content":[{"text":"अहो याजकांनो, गोणपाट परिधान करा आणि शोक करा;","poem":1},{"text":"वेदीची सेवा करणार्‍यांनो, विलाप करा.","poem":2},{"text":"तुम्ही जी परमेश्वराची सेवा करता,","poem":1},{"text":"या, गोणपाट परिधान करीत रात्र घालावा;","poem":2},{"text":"कारण अन्नार्पणे व पेयार्पणे","poem":1},{"text":"तुमच्या परमेश्वराच्या भवनात येणे बंद झाले आहेत.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"एक पवित्र उपास जाहीर करा;","poem":1},{"text":"लोकांची एक धार्मिक सभा बोलवा.","poem":2},{"text":"वडीलजनास","poem":1},{"text":"व देशात राहणार्‍यांना","poem":2},{"text":"याहवेह तुमच्या परमेश्वराच्या भवनात बोलवा,","poem":1},{"text":"आणि याहवेहपुढे शोक करा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"त्या दिवसाबद्दल हाय!","poem":1},{"text":"याहवेहचा दिवस जवळ आहे;","poem":2},{"lineBreak":true},{"text":"सर्वसमर्थापासून","poem":2},{"noteId":0},{"text":"जसा नाश तसे ते येतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"आपल्या डोळ्यादेखत","poem":1},{"text":"अन्न नाहीसे झाले नाही काय—","poem":2},{"text":"आमच्या परमेश्वराच्या भवनातील","poem":1},{"text":"सर्व आनंद व उल्हास गेले नाही काय?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"जमिनीच्या ढेकळांखाली","poem":1},{"text":"बीज कुजून जात आहे.","poem":2},{"text":"कोठारे उद्ध्वस्त झाली आहेत","poem":1},{"text":"आणि गोदामे मोडली आहेत,","poem":2},{"lineBreak":true},{"text":"कारण धान्य करपून गेले आहे.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"गुरे कशी कण्हत आहेत!","poem":1},{"text":"शेरडामेंढरांचे कळप व्याकूळ झाले आहेत,","poem":2},{"text":"कारण त्यांना चरण्यासाठी कुरणेच नाहीत;","poem":1},{"text":"मेंढ्यांचे कळप विव्हळत आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"हे याहवेह, मी तुम्हाला हाक मारीत आहेत,","poem":1},{"text":"कारण अग्नीच्या उष्णतेने कुरणे जाळून फस्त केली आहेत,","poem":2},{"lineBreak":true},{"text":"आणि अग्नीने मैदानातील सर्व झाडे भस्मसात झाली आहेत.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"आणि वनपशूदेखील तुमच्याकडे आक्रोश करीत आहेत,","poem":1},{"text":"पाण्याचे झरे कोरडे पडले आहेत.","poem":2},{"lineBreak":true},{"text":"आणि आणि अग्नीने रानातील कुरणे होरपळून निघाली आहे.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"किंवा शद्दाय","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/mar_cbi/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}