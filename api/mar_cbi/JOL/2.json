{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"JOL","translationId":"mar_cbi","name":"योएल","commonName":"योएल","title":"योएलाची भविष्यवाणी","order":29,"numberOfChapters":3,"sha256":"0e04c0a6397e700857e558b2bd167bc6f87c37b25fed4479318a6f38622e5c03","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mar_cbi/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["टोळांचे सैन्य"]},{"type":"verse","number":1,"content":[{"text":"सीयोनात कर्णा वाजवा;","poem":1},{"text":"माझ्या पवित्र पर्वतावर धोक्याची घंटा वाजवा.","poem":2},{"lineBreak":true},{"text":"देशात राहणार्‍या प्रत्येकाचा भीतीने थरकाप होवो,","poem":1},{"text":"कारण याहवेहचा दिवस येत आहे.","poem":2},{"text":"तो अगदी हाताशी आहे—","poem":1}]},{"type":"verse","number":2,"content":[{"text":"तो दिवस अंधाराचा व औदासिन्याचा,","poem":2},{"lineBreak":true},{"text":"मेघांचा व दाट काळोखाचा दिवस.","poem":2},{"text":"जसे डोंगरावर विस्तारलेल्या पहाटेसारखा आहे","poem":1},{"text":"तसे विशाल व बलवान सैन्य चालून येत आहे,","poem":2},{"text":"यापूर्वी असे कधी झाले नव्हते,","poem":1},{"text":"नंतरही अनेक पिढ्या पुन्हा कधीच होणार नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"त्यांच्यापुढे अग्नी विनाश करीत आहे,","poem":1},{"text":"त्यांच्यामागे ज्वाला पेटली आहे.","poem":2},{"text":"त्यांच्यापुढील प्रदेश एदेन बागेसारखा आहे,","poem":1},{"text":"त्यांच्यामागील प्रदेश ओसाड वाळवंट आहे—","poem":2},{"lineBreak":true},{"text":"त्यांच्या तावडीतून काहीच वाचू शकत नाही.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"त्यांचे स्वरूप घोड्यांप्रमाणेच आहेत;","poem":1},{"text":"आणि घोडेस्वारा प्रमाणे ते जोरात धावतात.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"रथांच्या आवाजाप्रमाणे,","poem":1},{"text":"पर्वताच्या माथ्यांवर ते उड्या मारतात,","poem":2},{"text":"भुसा भस्म करणार्‍या अग्नीप्रमाणे,","poem":1},{"text":"युद्धासाठी सज्ज झालेल्या पराक्रमी सैन्याप्रमाणे आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"त्यांच्यासमोर राष्ट्रे भयभीत होतात;","poem":1},{"text":"हे प्रत्येक चेहरा फिका पडतो.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"वीरांप्रमाणे ते हल्ला करतात;","poem":1},{"text":"सैनिकांप्रमाणे ते तटाच्या भिंती चढतात.","poem":2},{"text":"आपल्या रांगा न मोडता","poem":1},{"text":"ते सरळ आगेकूच करतात.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ते एकमेकांना धक्काबुक्की करीत नाहीत;","poem":1},{"text":"प्रत्येकजण सरळ पुढे जातो.","poem":2},{"text":"समोर शस्त्रे असताना ते जखमी न होता","poem":1},{"text":"रांग न मोडता त्यातून पार जातात.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"शहराकडे ते धाव घेतात;","poem":1},{"text":"ते तटाच्या भिंतीवर धावतात;","poem":2},{"text":"ते चढून घरात शिरतात,","poem":1},{"text":"जणू काही खिडक्यांतून प्रवेश करणारे चोरच!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"पृथ्वी त्यांच्यापुढे कापते","poem":1},{"text":"आणि आकाशे थरथरतात,","poem":2},{"text":"सूर्य आणि चंद्र काळवंडतात,","poem":1},{"text":"आणि तारे चमकणे सोडून देतात.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"याहवेह आपल्या सैन्यापुढे","poem":1},{"text":"गर्जना करीत चालतात;","poem":2},{"text":"त्यांचे सैन्य असंख्य आहेत,","poem":1},{"text":"आणि त्यांची आज्ञा मानणारे बलवान सैन्य आहे.","poem":2},{"text":"याहवेहचा दिवस महान आहे;","poem":1},{"text":"अति भयंकर दिवस आहे.","poem":2},{"lineBreak":true},{"text":"त्यास कोण सहन करू शकेल?","poem":2}]},{"type":"heading","content":["अंतःकरणे भग्न करण्यासाठी आव्हान"]},{"type":"verse","number":12,"content":[{"text":"तरी आताही याहवेह म्हणतात,","poem":1},{"text":"तुम्ही आपल्या संपूर्ण अंतःकरणाने,","poem":2},{"lineBreak":true},{"text":"उपास, आक्रंदन व शोक करीत मजकडे परत या.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"तुमची वस्त्रे फाडून नव्हे,","poem":1},{"text":"तर तुमचे अंतःकरण फाडा.","poem":2},{"text":"याहवेह तुमच्या परमेश्वराकडे परत या,","poem":1},{"text":"कारण ते कृपाळू व दयाळू आहेत.","poem":2},{"text":"ते मंदक्रोध आणि अधिक प्रीती करणारे आहेत,","poem":1},{"text":"आणि ते विपत्तीविषयी अनुताप करतात.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"कोण जाणो? याहवेह तुमचे परमेश्वर वळतील व अनुताप करतील","poem":1},{"text":"आणि तुमच्यासाठी एक आशीर्वाद सोडतील—","poem":2},{"text":"मग याहवेह तुमच्या परमेश्वराला","poem":1},{"text":"तुम्ही धान्यार्पण व पेयार्पण करू शकाल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"सीयोनात कर्णा वाजवा!","poem":1},{"text":"पवित्र उपास घोषित करा","poem":2},{"lineBreak":true},{"text":"पवित्र सभा बोलवा.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"लोकांना एकत्र करा,","poem":1},{"text":"सभेला पवित्र करा;","poem":2},{"text":"वडिलजनांना एकत्र आणा,","poem":1},{"text":"बालकांना आणि स्तनपान करणार्‍या अर्भकांना","poem":2},{"lineBreak":true},{"text":"देखील एकत्र आणा.","poem":2},{"text":"वराला त्याच्या निवासस्थानातून","poem":1},{"text":"आणि वधूला तिच्या खोलीतून बोलवा.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"याहवेहसमोर सेवा करणार्‍या याजकांनी,","poem":1},{"text":"द्वारमंडप आणि वेदी यांच्यामध्ये रडत उभे राहावे.","poem":2},{"text":"आणि त्यांनी असे म्हणावे, “हे याहवेह, तुमच्या लोकांना वाचवा,","poem":1},{"text":"आपल्या वतनाला राष्ट्रांमध्ये अप्रतिष्ठा","poem":2},{"lineBreak":true},{"text":"किंवा चेष्टेचे कारण होऊ देऊ नका.","poem":2},{"text":"‘त्यांचा परमेश्वर कुठे आहे?’","poem":1},{"text":"असे त्यांनी लोकांमध्ये का म्हणावे.”","poem":2}]},{"type":"heading","content":["याहवेहचे उत्तर"]},{"type":"verse","number":18,"content":[{"text":"मग याहवेहने आपल्या देशासाठी ईर्ष्या","poem":1},{"noteId":1},{"text":"धरली,","poem":1},{"text":"आणि ते आपल्या लोकांवर दया करतील.","poem":2}]},{"type":"verse","number":19,"content":["याहवेहने त्यांना उत्तर दिले:",{"text":"“मी तुम्हाला धान्य, नवा द्राक्षारस व जैतून तेल पाठवित आहे,","poem":1},{"text":"जे तुम्हाला तृप्त करण्यास भरपूर आहे;","poem":2},{"text":"पुन्हा कधीही मी तुम्हाला राष्ट्रांमध्ये","poem":1},{"text":"उपहासाचा विषय होऊ देणार नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“मी उत्तरेकडील उपद्रवी टोळीस काढून त्यांना तुझ्यापासून दूर नेईन;","poem":1},{"text":"मी त्यांना होरपळून निघालेला ओसाड प्रदेशात ढकलून देईन;","poem":2},{"text":"त्याची पूर्वेचा रांग मृत समुद्रात बुडवेन","poem":1},{"text":"व पश्चिमी रांग भूमध्य समुद्रात बुडवेन.","poem":2},{"text":"आणि मग त्यांचा दुर्गंध वर जाईल;","poem":1},{"text":"त्यांचा दर्प वाढत जाईल.”","poem":2},{"lineBreak":true},{"text":"निश्चितच याहवेहने महान कार्य केले आहे!","poem":1}]},{"type":"verse","number":21,"content":[{"text":"हे यहूदीय देशा, भिऊ नको;","poem":2},{"lineBreak":true},{"text":"आनंद व उल्हास करा, निश्चितच याहवेहने महान","poem":2},{"text":"कार्य केले आहेत!","poem":1}]},{"type":"verse","number":22,"content":[{"text":"वन्य पशूंनो तुम्ही घाबरू नका,","poem":2},{"lineBreak":true},{"text":"कारण रानातील कुरणे हिरवीगार होत आहेत.","poem":2},{"text":"झाडे आपली फळे देत आहेत;","poem":1},{"text":"अंजिराची झाडे आणि द्राक्षवेली पुन्हा आपले सत्व देत आहेत.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"सीयोनच्या लोकांनो, आनंद करा;","poem":1},{"text":"तुमच्या याहवेहच्या ठायी आनंद करा,","poem":2},{"text":"कारण त्यांनी शरदॠतूतील पाऊस दिला आहे","poem":1},{"text":"कारण ते विश्वासयोग्य आहेत.","poem":2},{"text":"परमेश्वर तुमच्यासाठी विपुल वृष्टी करतात,","poem":1},{"text":"शरदॠतूतील आणि वसंतॠतूतील भरपूर पाऊस पाहिल्याप्रमाणे दिला आहे.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"खळी पुन्हा गव्हाच्या उंच राशींनी भरून जातील;","poem":1},{"text":"आणि कुंडे तेलाने आणि द्राक्षारसाने ओसंडून वाहू लागतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“मोठे टोळ व तरुण टोळ","poem":1},{"text":"इतर टोळ व टोळांचे थवे,","poem":2},{"lineBreak":true},{"text":"म्हणजेच माझे मोठे सैन्य जे मी तुमच्यामध्ये पाठवले होते;","poem":2},{"text":"त्यांनी खाल्लेल्या तुमच्या वर्षांची मी भरपाई करेन.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"जोपर्यंत तुम्ही तृप्त होत नाही तोपर्यंत तुम्ही खाल,","poem":1},{"text":"ज्यांनी तुमच्यासाठी अद्भुत कार्य केले आहेत","poem":2},{"lineBreak":true},{"text":"त्या याहवेह तुमच्या परमेश्वराच्या नावाची तुम्ही स्तुती कराल,","poem":2},{"text":"माझे लोक पुन्हा कधीही लज्जित होणार नाहीत.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"तुम्हाला कळून येईल की मी इस्राएलमध्ये आहे,","poem":1},{"text":"आणि मीच याहवेह तुमचा परमेश्वर आहे,","poem":2},{"lineBreak":true},{"text":"आणि दुसरा कोणीही नाही;","poem":2},{"text":"माझे लोक पुन्हा कधीही लज्जित होणार नाहीत.","poem":1}]},{"type":"heading","content":["याहवेहचा दिवस"]},{"type":"verse","number":28,"content":[{"text":"“आणि त्यानंतर,","poem":1},{"text":"मी माझा आत्मा सर्व लोकांवर ओतेन.","poem":2},{"text":"तुमचे पुत्र व तुमच्या कन्या भविष्यवाणी सांगतील,","poem":1},{"text":"व तुमचे वृद्ध स्वप्ने पाहतील,","poem":2},{"lineBreak":true},{"text":"तुमचे तरुण दृष्टान्त पाहतील.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"माझ्या दासांवर म्हणजेच, स्त्री आणि पुरुष दोघांवरही,","poem":1},{"text":"त्या दिवसांत मी माझा आत्मा ओतेन.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"आकाशात व पृथ्वीवर,","poem":1},{"text":"रक्त व अग्नी व धुरांचे स्तंभ अशी","poem":2},{"lineBreak":true},{"text":"विलक्षण चिन्हे मी दाखवेन.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"याहवेहचा महान व भयंकर दिवस","poem":1},{"text":"येण्यापूर्वी सूर्य अंधकारमय व","poem":2},{"lineBreak":true},{"text":"चंद्र रक्तमय होईल.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"आणि प्रत्येकजण जो प्रभूच्या नावाने","poem":1},{"text":"त्यांचा धावा करेल तोच वाचेल;","poem":2},{"text":"कारण याहवेहने म्हटले आहे","poem":1},{"text":"सीयोन डोंगरावर आणि यरुशलेममध्ये","poem":2},{"lineBreak":true},{"text":"व जे उरलेले असतील ते वाचतील","poem":2},{"text":"आणि ज्यांना याहवेहने बोलाविले","poem":1},{"text":"ते सुद्धा तारण पावतील.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"किंवा आवेश","reference":{"chapter":2,"verse":18}}]},"thisChapterLink":"/api/mar_cbi/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}