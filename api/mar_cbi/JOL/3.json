{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"JOL","translationId":"mar_cbi","name":"योएल","commonName":"योएल","title":"योएलाची भविष्यवाणी","order":29,"numberOfChapters":3,"sha256":"0e04c0a6397e700857e558b2bd167bc6f87c37b25fed4479318a6f38622e5c03","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mar_cbi/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["राष्ट्रांचा न्याय"]},{"type":"verse","number":1,"content":[{"text":"“त्या दिवसात आणि त्या समयी जेव्हा मी यहूदाह व","poem":1},{"text":"यरुशलेम भविष्य पुनर्संचयित करेन,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मी सर्व राष्ट्रांना एकत्र करेन","poem":1},{"text":"आणि त्यांना खाली यहोशाफाट","poem":2},{"noteId":2},{"text":"च्या खोऱ्यात आणेन.","poem":2},{"text":"त्यांनी माझ्या वतनास, माझ्या इस्राएली लोकांशी जे केले","poem":1},{"text":"त्याबद्दल मी त्यांची परीक्षा घेईन.","poem":2},{"text":"कारण त्यांनी माझ्या लोकांना राष्ट्रांमध्ये विखुरले आहे","poem":1},{"text":"आणि माझ्या देशाचे विभाजन केले आहे.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"त्यांनी माझ्या लोकांकरिता चिठ्ठ्या टाकल्या","poem":1},{"text":"आणि वेश्यांसाठी मुलांचा व्यापार केला;","poem":2},{"lineBreak":true},{"text":"मद्द्याकरिता आपल्या मुलींना विकले.","poem":2}]},{"type":"verse","number":4,"content":["“अहो सोर आणि सीदोन, पलेशेथच्या शहरांनो, आता तुमच्याजवळ माझ्याविरुद्ध काय आहे? मी जे काही केले आहे त्याची परतफेड मला करीत आहात काय? तुम्ही मजवर सूड उगविण्याचा प्रयत्न करीत आहात काय? कारण मी त्वरेने उलट प्रहार करेन आणि तुमचेच कृत्य तुमच्या माथ्यावर उलटवेन."]},{"type":"verse","number":5,"content":["तुम्ही माझे रूप आणि सोने हरण केले आहे आणि माझी सर्व मोलवान भांडारे घेऊन ती तुमच्या मंदिरात",{"noteId":3},"ठेवली आहेत."]},{"type":"verse","number":6,"content":["तुम्ही यहूदीयाच्या आणि यरुशलेमच्या लोकांना त्यांच्या देशापासून दूर नेण्यासाठी यावानी लोकांना विकले."]},{"type":"verse","number":7,"content":["“परंतु जिथे तुम्ही त्यास विकून पाठविले, त्या सर्व ठिकाणांहून मी त्यांना परत आणेन आणि तुम्ही जे हे सर्व केले त्याची परतफेड तुमच्या माथ्यावर फेडीन."]},{"type":"verse","number":8,"content":["मी तुमचे पुत्र व तुमच्या कन्या यहूदीयातील लोकांना विकून टाकेन आणि ते त्यांना दूरच्या शबाई लोकांस विकतील.” याहवेहने हे म्हटले आहे."]},{"type":"verse","number":9,"content":[{"text":"राष्ट्रांमध्ये ही घोषणा करा:","poem":1},{"text":"युद्धासाठी सुसज्ज व्हा!","poem":2},{"text":"योद्ध्यांना आव्हान करा!","poem":1},{"text":"तुमचे सर्व लढवय्ये जवळ या आणि हल्ला करा.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तुमचा फाळ वितळवून त्यांच्या तलवारी तयार करा","poem":1},{"text":"आणि तुमच्या कोयत्यांचे भाले बनवा.","poem":2},{"text":"दुर्बल असे म्हणो,","poem":1},{"text":"“मी सबल आहे!”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"सभोवतालच्या राष्ट्रांनो, तुम्ही लवकर या,","poem":1},{"text":"आणि तिथे एकत्र व्हा.","poem":2},{"lineBreak":true},{"text":"हे याहवेह, तुमचे योद्धे खाली आणा!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“राष्ट्रे जागृत व्हावी;","poem":1},{"text":"त्यांनी यहोशाफाटाच्या खोर्‍यात यावे,","poem":2},{"text":"कारण तिथे मी न्यायासनावर बसून","poem":1},{"text":"चारही बाजूंच्या सर्व राष्ट्रांचा न्याय करणार आहे.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"आता विळा चालवा,","poem":1},{"text":"कारण पीक तयार झाले आहे.","poem":2},{"text":"या, द्राक्षांचा घाणा तुडवा,","poem":1},{"text":"कारण द्राक्षकुंडे भरली आहेत","poem":2},{"lineBreak":true},{"text":"आणि कुंडे ओसंडून वाहत आहेत—","poem":2},{"lineBreak":true},{"text":"कारण त्यांची दुष्टाई फार मोठी आहे!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"निर्णयाच्या खोर्‍यात","poem":1},{"text":"लोकांची गर्दीच गर्दी आहे!","poem":2},{"text":"कारण निर्णयाच्या खोऱ्यात","poem":1},{"text":"याहवेहचा दिवस येऊन ठेपला आहे.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"सूर्य व चंद्र काळे पडतील","poem":1},{"text":"आणि तारे यापुढे प्रकाशणार नाही.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"याहवेह सीयोनातून गर्जना करतील","poem":1},{"text":"आणि यरुशलेमातून गडगडाट होईल;","poem":2},{"lineBreak":true},{"text":"पृथ्वी व आकाश थरथर कापतील.","poem":2},{"text":"परंतु याहवेह त्याच्या लोकांसाठी आश्रयस्थान","poem":1},{"text":"आणि इस्राएल लोकांसाठी दुर्ग असतील.","poem":2}]},{"type":"heading","content":["परमेश्वराच्या लोकांसाठी आशीर्वाद"]},{"type":"verse","number":17,"content":[{"text":"“तेव्हा तुम्हाला कळून येईल की","poem":1},{"text":"सीयोनात, माझ्या पवित्र पर्वतावर, राहणारा मी याहवेह तुमचा परमेश्वर आहे.","poem":2},{"text":"यरुशलेम पवित्र होईल;","poem":1},{"text":"परकीय लोक तिच्यावर पुन्हा कधीही आक्रमण करणार नाहीत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“त्या दिवशी नवीन द्राक्षारस पर्वतांवरून पाझरेल,","poem":1},{"text":"आणि टेकड्यांवरून दूध वाहील;","poem":2},{"lineBreak":true},{"text":"यहूदीयातील ओहोळांची कोरडी पात्रे पाण्याने भरून वाहतील","poem":2},{"text":"आणि याहवेहच्या मंदिरातून एक झरा निघेल व तो","poem":1},{"text":"शिट्टीमच्या खोर्‍यात पाणी पुरवेल.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"इजिप्त देश उजाड होईल","poem":1},{"text":"आणि एदोम देश ओसाड होईल,","poem":2},{"text":"कारण त्यांनी यहूदीयाच्या लोकांवर अत्याचार केला","poem":1},{"text":"त्यांच्या देशात त्यांनी निर्दोष रक्त पाडले आहे.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"परंतु यहूदाह सदासर्वकाळ","poem":1},{"text":"आणि यरुशलेम पिढ्यान् पिढ्या वसलेले राहील.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"त्यांच्या निर्दोष रक्ताचा सूड न घेता मी जाईन काय?","poem":1},{"text":"नाही, मुळीच नाही.”","poem":2},{"lineBreak":true},"याहवेह सीयोनमध्ये निवास करतात!"]}],"footnotes":[{"noteId":2,"caller":"+","text":"यहोशाफाट अर्थात् याहवेह न्याय करतात","reference":{"chapter":3,"verse":2}},{"noteId":3,"caller":"+","text":"किंवा राजवाडे","reference":{"chapter":3,"verse":5}}]},"thisChapterLink":"/api/mar_cbi/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}