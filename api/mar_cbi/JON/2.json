{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"JON","translationId":"mar_cbi","name":"योनाह","commonName":"योनाह","title":"योनाहाची भविष्यवाणी","order":32,"numberOfChapters":4,"sha256":"306c8b5f40287a88baae97a2aa143282b47a658cada7f055df7bd36f2534cc1b","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/mar_cbi/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["मग माशाच्या पोटातून योनाहने याहवेह त्याच्या परमेश्वराची प्रार्थना केली."]},{"type":"verse","number":2,"content":["तो म्हणाला:",{"text":"“माझ्या संकटात मी याहवेहचा धावा केला","poem":1},{"text":"आणि त्यांनी मला उत्तर दिले.","poem":2},{"text":"मृत्यूच्या खोल अधोलोकातून मी मदतीसाठी हाक मारली","poem":1},{"text":"आणि तुम्ही माझी हाक ऐकली.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तुम्ही मला खोलवर,","poem":1},{"text":"समुद्राच्या अगदी हृदयात फेकून दिले","poem":2},{"lineBreak":true},{"text":"आणि प्रवाहाने मला घेरले;","poem":2},{"text":"आणि तुमच्या बेफाम लाटा आणि कल्लोळ","poem":1},{"text":"यांनी मला झाकून टाकले.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मी म्हणालो, ‘मला तुमच्या नजरेसमोरून","poem":1},{"text":"दूर करण्यात आले आहे;","poem":2},{"text":"तरीही मी तुमच्या पवित्र मंदिराकडे","poem":1},{"text":"दृष्टी लावेन.’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"बुडविणार्‍या पाण्याने मला घाबरविले,","poem":1},{"noteId":0},{"text":"माझ्या सभोवताली खोल डोह होता;","poem":2},{"lineBreak":true},{"text":"माझे डोके समुद्राच्या शेवाळाने गुंडाळले होते.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मी पर्वतांच्या मुळाशी पोहोचलो होतो;","poem":1},{"text":"मी कायमचा जमिनीत बंदिस्त झालो होतो.","poem":2},{"text":"तरीसुद्धा, हे याहवेह माझ्या परमेश्वरा,","poem":1},{"text":"तुम्ही माझा जीव खड्ड्यातून वर आणला.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“जेव्हा माझे जीवन क्षीण होत होते,","poem":1},{"text":"तेव्हा मी याहवेहचे स्मरण केले,","poem":2},{"text":"आणि माझी प्रार्थना वर तुमच्याकडे,","poem":1},{"text":"तुमच्या पवित्र मंदिराकडे पोहोचली.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“जे निरुपयोगी मूर्तींना कवटाळून राहतात","poem":1},{"text":"ते स्वतःला परमेश्वराच्या प्रीतीपासून दूर ठेवतात.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"परंतु मी, उपकारस्तुतीच्या जयघोषाने,","poem":1},{"text":"तुमच्यासाठी यज्ञ अर्पण करेन.","poem":2},{"text":"मी जो नवस केला होता, तो मी पूर्ण करेन.","poem":1},{"text":"मी म्हणेन, ‘तारण याहवेहकडून येते.’ ”","poem":2}]},{"type":"verse","number":10,"content":["मग याहवेहने माशाला आज्ञा केली आणि त्याने योनाहला कोरड्या भूमीवर ओकून टाकले."]}],"footnotes":[{"noteId":0,"caller":"+","text":"किंवा माझ्या गळ्यापर्यंत होते","reference":{"chapter":2,"verse":5}}]},"thisChapterLink":"/api/mar_cbi/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}