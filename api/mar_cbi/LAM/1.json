{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"LAM","translationId":"mar_cbi","name":"विलापगीत","commonName":"विलापगीत","title":"विलापगीत","order":25,"numberOfChapters":5,"sha256":"d1d83778dc5408396c75bfa3ae57bce1ad1a41466dd22dae42a682cb5d472651","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/mar_cbi/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"एकेकाळी माणसांनी गजबजलेली ही नगरी,","poem":1},{"text":"आता कशी निर्जन झाली आहे!","poem":2},{"text":"एकेकाळी राष्ट्रांमध्ये जी सर्वोत्कृष्ट नगरी होती,","poem":1},{"text":"तिला आता कसे वैधव्यच प्राप्त झाले आहे!","poem":2},{"text":"एकेकाळची ही सर्व प्रांताची राणी","poem":1},{"text":"आता कशी दासी झाली आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"रात्रभर ती अत्यंत रडत असते;","poem":1},{"text":"तिच्या गालांवरून अश्रू ओघळत आहेत.","poem":2},{"text":"तिच्या सर्व प्रियकरात तिचे","poem":1},{"text":"सांत्वन करणारा कोणी नाही;","poem":2},{"text":"तिच्या सर्व मित्रांनी तिचा विश्वासघात केला आहे;","poem":1},{"text":"ते तिचे शत्रू बनले आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"पीडा व कठोर परिश्रम केल्यानंतर","poem":1},{"text":"यहूदाह बंदिवासात गेली आहे.","poem":2},{"text":"ती अन्य राष्ट्रांमध्ये राहते;","poem":1},{"text":"आता तिला कुठेही आराम मिळत नाही.","poem":2},{"text":"जे तिचा पाठलाग करीत असत, त्यांनी","poem":1},{"text":"तिच्या पीडित परिस्थितीत तिला मागे टाकून दिले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"सीयोनकडे जाणारे रस्ते विलाप करीत आहेत,","poem":1},{"text":"निर्धारित सणाला तिच्याकडे कोणीही येत नाही.","poem":2},{"text":"तिच्या सर्व वेशी उजाड झाल्या आहेत,","poem":1},{"text":"तिचे याजक कण्हत आहेत,","poem":2},{"text":"तिच्या तरुणी शोकग्रस्त आहेत,","poem":1},{"text":"आणि तिला अत्यंत पीडा होत आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"तिचे प्रतिपक्षी तिचे मालक बनले आहेत;","poem":1},{"text":"तिचे शत्रू सुखात आहेत.","poem":2},{"text":"याहवेहने तिला दुःख दिले आहे,","poem":1},{"text":"कारण तिने अनेक पापे केली आहेत.","poem":2},{"text":"तिचे बालक बंदिवासात गेले आहेत.","poem":1},{"text":"ते तिच्या शत्रूचे गुलाम झाले आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"सीयोनकन्येचे","poem":1},{"text":"सर्व वैभव लुप्त झाले आहे.","poem":2},{"text":"तिचे राजपुत्र ज्यांना चरण्याकरिता","poem":1},{"text":"कुरण उपलब्ध नाही अशा हरिणासारखे झाले आहेत;","poem":2},{"text":"सामर्थ्यहीन होऊन ते","poem":1},{"text":"त्यांच्या पाठलाग करणाऱ्यांपासून त्यांनी पलायन केले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"यरुशलेमच्या या पीडित व भटकंतीमध्ये","poem":1},{"text":"ती तिच्या समृद्धीचे स्मरण करते","poem":2},{"lineBreak":true},{"text":"जे तिचे गतवैभवाचे दिवस होते.","poem":2},{"text":"जेव्हा तिचे लोक शत्रूच्या हातात पडले,","poem":1},{"text":"तिला साहाय्य करणारे कोणीही नव्हते.","poem":2},{"text":"तिचे शत्रू तिच्याकडे बघतात,","poem":1},{"text":"आणि तिच्या विध्वंसामुळे तिचा उपहास करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"कारण यरुशलेमेने भयंकर पापे केली","poem":1},{"text":"म्हणूनच ती किळसवाणी झाली आहे.","poem":2},{"text":"तिचा मान सन्मान करणारे आता तिला तुच्छ मानतात,","poem":1},{"text":"कारण तिला विवस्त्र असे त्यांनी पाहिले आहे;","poem":2},{"text":"ती कण्हते","poem":1},{"text":"व वळून निघून जाते.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"तिची अशुद्धता तिच्या वस्त्राला चिकटली आहे;","poem":1},{"text":"तिने तिच्या भविष्याचा विचार केला नाही.","poem":2},{"text":"तिचे पतन अचंबित करून सोडणारे होते;","poem":1},{"text":"तिचे सांत्वन करणारा कोणी नाही.","poem":2},{"text":"“हे याहवेह, माझी दुर्दशा पाहा,","poem":1},{"text":"शत्रू विजयी झाला आहे.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"तिच्या सर्व संपत्तीवर","poem":1},{"text":"तिच्या शत्रूंनी हात टाकला आहे.","poem":2},{"text":"परकीय राष्ट्रांनी तिच्या पवित्र मंदिरात प्रवेश","poem":1},{"text":"करताना तिने बघितले होते—","poem":2},{"text":"तुम्ही निषिद्ध केलेल्यांनी","poem":1},{"text":"तुमच्या सभास्थानात प्रवेश केला.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"अन्नाचा शोध घेत असताना","poem":1},{"text":"तिचे लोक कण्हत आहेत;","poem":2},{"text":"मौल्यवान वस्तूच्या मोबदल्यात ते अन्न विकत घेत आहेत","poem":1},{"text":"जेणेकरून ते जिवंत राहतील.","poem":2},{"text":"“हे याहवेह, पाहा आणि याकडे लक्ष द्या,","poem":1},{"text":"मी कशी घृणास्पद झाले आहे.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"या वाटेच्या वाटसरूंनो माझी","poem":1},{"text":"दुर्दशा पाहून तुम्हाला काहीच वाटत नाही काय?","poem":2},{"text":"मला जे दुःख देण्यात आले आहे,","poem":1},{"text":"त्या माझ्या दुःखासारखे दुसरे दुःख आहे काय?","poem":2},{"text":"याहवेहने आपल्या संतप्त क्रोधाच्या दिवशी","poem":1},{"text":"ही वेदना माझ्यावर लादली आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"त्यांनी उच्च स्थानातून अग्नी पाठविला आहे","poem":1},{"text":"व तो माझ्या हाडांमध्ये जळत आहे.","poem":2},{"text":"त्यांनी माझ्या पावलात सापळा पसरविला आहे","poem":1},{"text":"व मला मागे वळविले आहे.","poem":2},{"text":"त्यांनी मला उद्ध्वस्त केले आहे,","poem":1},{"text":"मी दिवसभर मूर्छित होत आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"माझी पापे गुलामगिरीचे जोखड बनली आहेत","poem":1},{"noteId":0},{"text":";","poem":1},{"text":"त्यांच्या हातांनी ती एकत्र विणली गेली आहेत.","poem":2},{"text":"ती माझ्या गळ्यात अडकविण्यात आली आहेत,","poem":1},{"text":"आणि प्रभूने माझी शक्ती खचविली आहे.","poem":2},{"text":"मी ज्यांचा सामना करू शकत नाही,","poem":1},{"text":"त्यांच्या हाती मला दिले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“माझ्यामध्ये असलेल्या सर्व योद्ध्यांना","poem":1},{"text":"प्रभूने नाकारले आहे;","poem":2},{"text":"माझ्या तरुणांना चिरडून टाकण्यासाठी","poem":1},{"text":"प्रभूंनी एका मोठ्या सैन्यास हजर राहण्यास","poem":2},{"noteId":1},{"text":"फर्माविले आहे.","poem":2},{"text":"त्यांच्या द्राक्षकुंडात प्रभूंनी","poem":1},{"text":"कुमारी कन्या यहूदीयास तुडविले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“याकारणास्तव मी रडत आहे","poem":1},{"text":"आणि माझ्या डोळ्यातून अश्रुपात होत आहे.","poem":2},{"text":"माझे सांत्वन करण्यास माझ्याजवळ कोणीही नाही,","poem":1},{"text":"माझा आत्मा पुनरुज्जीवित करण्यासाठी कोणीही नाही.","poem":2},{"text":"माझी मुलेबाळे निराश्रित झाली आहेत.","poem":1},{"text":"कारण शत्रूचे वर्चस्व झाले आहे.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"सीयोन हात पसरीत आहे,","poem":1},{"text":"पण तिचे सांत्वन करण्यास कोणीही नाही.","poem":2},{"text":"कारण याहवेहने याकोबाविषयी फर्मान काढले आहे","poem":1},{"text":"तिचे शेजारीच तिचे शत्रू होवोत;","poem":2},{"text":"तिच्या शेजाऱ्यामध्ये यरुशलेम","poem":1},{"text":"अमंगळ वस्तूसारखी झाली आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“याहवेह नीतिमान आहेत,","poem":1},{"text":"तरीसुद्धा मी त्यांच्या आज्ञेविरुद्ध बंड केले.","poem":2},{"text":"सर्व लोकांनो, इकडे लक्ष द्या;","poem":1},{"text":"माझ्या वेदना पाहा.","poem":2},{"text":"कारण माझे तरुण व तरुणी","poem":1},{"text":"बंदिवासात गेले आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“मी माझ्या मित्रगणांना बोलाविले","poem":1},{"text":"पण त्यांनी माझा विश्वासघात केला.","poem":2},{"text":"माझे याजक आणि वडीलजन","poem":1},{"text":"स्वतःस जिवंत ठेवण्यासाठी","poem":2},{"text":"जेव्हा ते अन्नाचा शोध घेत होते","poem":1},{"text":"तेव्हा ते नगरात नष्ट झाले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“हे याहवेह, माझ्या वेदना पाहा!","poem":1},{"text":"माझे अंतःकरण यातनाग्रस्त झाले आहे,","poem":2},{"text":"आणि माझे हृदय अस्वस्थ झाले आहे.","poem":1},{"text":"कारण मी अत्यंत बंडखोर झाले होते.","poem":2},{"text":"बाहेर तलवार मला मृत्यू आणते;","poem":1},{"text":"आत तर केवळ मरणच आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“लोकांनी माझे कण्हणे ऐकले आहे,","poem":1},{"text":"पण माझे सांत्वन करण्यास कोणीही नाही.","poem":2},{"text":"माझ्या सर्व शत्रूंनी माझ्या संकटांबद्दल ऐकले आहे","poem":1},{"text":"तुम्ही जे केले ते पाहून त्यांना आनंद झाला आहे;","poem":2},{"text":"तुम्ही घोषणा केलेला दिवस येवो","poem":1},{"text":"म्हणजे ते देखील माझ्यासारखेच होतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“त्यांची सर्व दुष्कृत्ये तुमच्यापुढे येवोत;","poem":1},{"text":"माझ्या सर्व पापांमुळे","poem":2},{"text":"तुम्ही माझ्याशी जसा व्यवहार केला","poem":1},{"text":"तसाच त्यांच्याशीही करा.","poem":2},{"text":"माझे उसासे खूप आहेत","poem":1},{"text":"व माझे हृदय मूर्छित झाले आहे.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":0,"caller":"+","text":"किंवा त्याने माझ्या पापावर नजर ठेवली","reference":{"chapter":1,"verse":14}},{"noteId":1,"caller":"+","text":"किंवा समय ठरवून ठेवला आहे","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/mar_cbi/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}