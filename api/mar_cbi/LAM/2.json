{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"LAM","translationId":"mar_cbi","name":"विलापगीत","commonName":"विलापगीत","title":"विलापगीत","order":25,"numberOfChapters":5,"sha256":"d1d83778dc5408396c75bfa3ae57bce1ad1a41466dd22dae42a682cb5d472651","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/mar_cbi/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"प्रभूने सीयोनकन्येला आपल्या क्रोधरूपी","poem":1},{"text":"मेघाने कसे आच्छादून टाकले आहे!","poem":2},{"text":"त्यांनी इस्राएलचे वैभव स्वर्गातून पृथ्वीवर","poem":1},{"text":"खाली धुळीत फेकले आहे;","poem":2},{"text":"क्रोधाच्या दिवशी त्यांनी","poem":1},{"text":"आपल्या पादासनाचेही स्मरण केले नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"प्रभूने कसलीच दयामाया न दाखविता","poem":1},{"text":"याकोबाच्या सर्व आवासांना गिळंकृत केले आहे;","poem":2},{"text":"त्यांच्या क्रोधाग्नीने यहूदाह कन्येच्या","poem":1},{"text":"तटबंदीची प्रत्येक भिंत पाडून टाकली आहे.","poem":2},{"text":"तिचे राज्य व तिचे अधिपती या सर्वांना अपमानित करून","poem":1},{"text":"त्यांनी जमीनदोस्त केले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"त्यांच्या क्रोधात त्यांनी इस्राएलचे","poem":1},{"text":"प्रत्येक शिंग","poem":2},{"noteId":2},{"text":"नष्ट केले आहे.","poem":2},{"text":"शत्रूने हल्ला केला तेव्हा त्यांनी","poem":1},{"text":"त्यांचा संरक्षण करणारा उजवा हात काढून घेतला आहे.","poem":2},{"text":"पेटलेल्या अग्नीप्रमाणे त्यांनी याकोबाभोवती","poem":1},{"text":"असलेले सर्वकाही भस्म करून टाकले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"शत्रूसारखे त्यांनी धनुष्य वाकविले आहे;","poem":1},{"text":"त्यांचा उजवा हात सज्ज झाला आहे.","poem":2},{"text":"शत्रूसारखे त्यांनी नयनरम्य तरुणांचा","poem":1},{"text":"संहार केला आहे.","poem":2},{"text":"त्यांनी त्यांच्या क्रोधाग्नीचा","poem":1},{"text":"सीयोन कन्येच्या तंबूवर वर्षाव केला आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"प्रभू शत्रूसारखे झाले आहेत;","poem":1},{"text":"त्यांनी इस्राएलला गिळंकृत केले आहे.","poem":2},{"text":"त्यांनी तिचे सर्व राजवाडे गिळंकृत केले आहेत","poem":1},{"text":"आणि दुर्ग उद्ध्वस्त केले आहेत.","poem":2},{"text":"यहूदीया कन्येचा शोक व विलाप","poem":1},{"text":"त्यांनी बहुगुणित केला आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"बागेसारख्या आवासांना त्यांनी उकिरड्यागत केले आहे;","poem":1},{"text":"त्यांच्या भेटण्याचे स्थान नष्ट केले आहे.","poem":2},{"text":"याहवेहने सीयोनला तिच्या सर्व","poem":1},{"text":"निर्धारित उत्सव व शब्बाथाचे विस्मरण केले आहे;","poem":2},{"text":"राजे व याजक या दोघांना","poem":1},{"text":"त्यांनी क्रोधित तिरस्काराने नाकारले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"प्रभूने आपल्या वेदीस नाकारले आहे","poem":1},{"text":"आणि त्यांच्या पवित्रस्थानाचा त्याग केला आहे.","poem":2},{"text":"त्यांनी तिच्या राजवाड्यांच्या भिंती","poem":1},{"text":"तिच्या शत्रूंच्या हातात दिल्या आहेत;","poem":2},{"text":"एका निर्धारित उत्सवाच्या दिवसात करण्याचा जयघोष","poem":1},{"text":"याहवेहच्या भवनात त्यांच्या शत्रूंनी केला आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"सीयोन कन्येच्या भिंतींना धराशायी करण्याचा","poem":1},{"text":"याहवेहने निर्धार केला आहे.","poem":2},{"text":"त्यांनी मापक दोरी ताणली आहे","poem":1},{"text":"विनाश करण्यास आपला हात रोखला नाही.","poem":2},{"text":"त्यांनी संरक्षक भिंत व तटबंदीस विलाप करण्यास लावले","poem":1},{"text":"ते एकत्रच ढासळून पडले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"तिच्या वेशी जमिनीत धसल्या आहेत;","poem":1},{"text":"त्यांच्या सळया मोडून नष्ट झाल्या आहेत.","poem":2},{"text":"तिचे राजे आणि अधिपती इतर देशात बंदिवासात गेले आहेत,","poem":1},{"text":"तिथे नियमशास्त्र राहिले नाही,","poem":2},{"text":"आणि तेथील संदेष्ट्यांना आता याहवेहकडून","poem":1},{"text":"दृष्टान्तही मिळत नाहीत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"सीयोनकन्येचे वडीलजन","poem":1},{"text":"मूकपणे जमिनीवर बसले आहेत;","poem":2},{"text":"त्यांनी मस्तकांवर धूळ शिंपडून घेतली आहे","poem":1},{"text":"आणि त्यांनी गोणपाट नेसले आहे.","poem":2},{"text":"यरुशलेमच्या तरुणींनी","poem":1},{"text":"माना खाली घातल्या आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"माझे डोळे आता रडून थकले आहेत,","poem":1},{"text":"मला आतून उत्कट यातना होत आहेत;","poem":2},{"text":"माझे अंतःकरण जणू भूमीवर ओतले जात आहे","poem":1},{"text":"कारण माझ्या लोकांचा सर्वनाश झाला आहे,","poem":2},{"text":"कारण लहान मुले व तान्ही बाळे","poem":1},{"text":"नगराच्या रस्त्यांवर मूर्छित होऊन पडत आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ते त्यांच्या मातांना विचारत आहेत,","poem":1},{"text":"“द्राक्षारस व धान्य कुठे आहे?”","poem":2},{"text":"ते नगराच्या रस्त्यांवर घायाळ झालेल्याप्रमाणे","poem":1},{"text":"बेशुद्ध होऊन पडत आहेत,","poem":2},{"text":"त्यांच्या मातांच्या बाहूत","poem":1},{"text":"या मुलांचे प्राण हळूहळू निघून जात आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"हे यरुशलेमकन्ये, सर्व जगात असले दुःख","poem":1},{"text":"मी तुला काय म्हणू?","poem":2},{"lineBreak":true},{"text":"मी तुझी तुलना कशाशी करू?","poem":2},{"text":"मी तुला कोणा समान लेखू?","poem":1},{"text":"जेणेकरून मी तुझे सांत्वन करू शकेन?","poem":2},{"lineBreak":true},{"text":"हे सीयोनच्या कुमारी कन्ये?","poem":2},{"text":"तुझा घाव सागराएवढा खोल आहे.","poem":1},{"text":"तुला कोण बरे करू शकेल?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"तुझ्या संदेष्ट्यांनी सांगितलेले दृष्टान्त","poem":1},{"text":"खोटे व व्यर्थ होते;","poem":2},{"text":"तुला बंदिवासात पडण्यापासून वाचविण्याकरिता","poem":1},{"text":"तुझी पापे उघडकीस आणली नाहीत.","poem":2},{"text":"त्यांनी तुला दिलेले संदेश","poem":1},{"text":"खोटे व दिशाभूल करणारे होते.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"वाटेने जाणारे सर्व वाटसरू","poem":1},{"text":"तुझी स्थिती बघून टाळ्या वाजवित होते;","poem":2},{"text":"यरुशलेमकन्ये.","poem":1},{"text":"तुझा उपहास करून डोकी हालवून ते म्हणतात,","poem":2},{"text":"“सौंदर्याची परिपूर्णता,","poem":1},{"text":"संपूर्ण पृथ्वीचा आनंद","poem":2},{"lineBreak":true},{"text":"असे संबोधली जाणारी नगरी ती हीच आहे का?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"तुझ्या सर्व शत्रूंनी तुझ्याविरुद्ध","poem":1},{"text":"त्यांचे मुख मोठे रुंद उघडले आहे;","poem":2},{"text":"दात खाऊन रागाने फुत्कार टाकीत ते म्हणतात,","poem":1},{"text":"“आपण अखेरीस तिला गिळंकृत केले.","poem":2},{"text":"या दिवसाची आम्ही किती वाट पाहत होतो;","poem":1},{"text":"ते बघण्यास आपण जिवंत आहोत.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"याहवेहने योजल्यानुसार केले आहे;","poem":1},{"text":"त्यांनी त्यांचे वचन पूर्ण केले,","poem":2},{"lineBreak":true},{"text":"जे संकल्प त्यांनी फार पूर्वी जाहीर केले होते.","poem":2},{"text":"त्यांनी दयामाया न दाखविता तुम्हाला जमीनदोस्त केले आहे,","poem":1},{"text":"तुमची स्थिती बघून तुमच्या शत्रूचे समाधान केले आहे,","poem":2},{"lineBreak":true},{"text":"त्यांनी तुमच्या शत्रूंचे शिंग उंचावले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"लोकांची अंतःकरणे.","poem":1},{"text":"प्रभूकडे विलाप करतात.","poem":2},{"text":"सीयोन कन्येच्या तटांनो,","poem":1},{"text":"स्वतःला विसावा न देता,","poem":2},{"lineBreak":true},{"text":"तुमचे डोळे आराम न करता","poem":2},{"text":"एखाद्या नदीप्रमाणे तुमचे अश्रू","poem":1},{"text":"रात्रंदिवस वाहोत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"उठा, रात्री धावा करा,","poem":1},{"text":"जसा रात्रीचा प्रहर सुरू होतो;","poem":2},{"text":"त्यांच्यापुढे आपले हात उंचावून,","poem":1},{"text":"प्रत्येक रस्त्याच्या कोपऱ्यावर","poem":2},{"text":"भुकेने व्याकूळ होऊन बेशुद्ध पडणार्‍या","poem":1},{"text":"तुमच्या मुलांच्या जीवनासाठी विनवण्या करा.","poem":2},{"text":"प्रभूच्या समक्षतेत आपली अंतःकरणे","poem":1},{"text":"पाण्यासारखी ओता.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"याहवेह, बघा व विचार करा:","poem":1},{"text":"तुम्ही कधी तरी कोणालाही असे वागविले आहे का?","poem":2},{"text":"ज्या मातांनी आपल्या मुलांचे संगोपन केले,","poem":1},{"text":"त्या मातांनी ही आपली पोटची फळे खावीत काय?","poem":2},{"text":"प्रभूच्या मंदिरातच त्यांचे याजक आणि","poem":1},{"text":"संदेष्ट्यांचा संहार व्हावा काय?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"पाहा वृद्ध व तरुण एकत्र","poem":1},{"text":"रस्त्यांवरील धुळीत पडली आहेत;","poem":2},{"text":"माझे तरुण व तरुणी","poem":1},{"text":"शत्रूंच्या तलवारींनी ठार होऊन मरून पडली आहेत.","poem":2},{"text":"तुमच्या क्रोधाच्या दिवशी तुम्ही त्यांचा संहार केला;","poem":1},{"text":"कसलीच दयामाया न दाखविता तुम्ही त्यांचा वध केला.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“सणासाठी आमंत्रित केल्याप्रमाणे,","poem":1},{"text":"तुम्ही माझ्याविरुद्ध संकटांना सर्व बाजूंनी बोलाविले.","poem":2},{"text":"याहवेहच्या क्रोधाच्या दिवशी एकही","poem":1},{"text":"मनुष्य निसटला नाही किंवा जिवंत राहिला नाही.","poem":2},{"text":"ज्यांचे मी संगोपन केले आणि वाढविले,","poem":1},{"text":"त्या सर्वांचा माझ्या शत्रूकडून नाश झाला आहे.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":2,"caller":"+","text":"किंवा सामर्थ्य","reference":{"chapter":2,"verse":3}}]},"thisChapterLink":"/api/mar_cbi/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}