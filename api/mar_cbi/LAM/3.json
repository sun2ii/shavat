{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"LAM","translationId":"mar_cbi","name":"विलापगीत","commonName":"विलापगीत","title":"विलापगीत","order":25,"numberOfChapters":5,"sha256":"d1d83778dc5408396c75bfa3ae57bce1ad1a41466dd22dae42a682cb5d472651","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/mar_cbi/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेहच्या क्रोध-दंडाने कशा वेदना होतात,","poem":1},{"text":"याचा प्रत्यक्ष अनुभव घेतलेला मी मनुष्य आहे.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"त्यांनी मला हाकलून लावले व","poem":1},{"text":"प्रकाशात नव्हे तर निबिड अंधारात मला चालविले आहे;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"निश्चितच त्यांनी परत परत, दिवसभर","poem":1},{"text":"माझ्याविरुद्ध त्यांचा हात उगारला आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"त्यांनी माझे मांस व माझी त्वचा जीर्ण केली आहेत","poem":1},{"text":"आणि त्यांनी माझी हाडे मोडली आहेत.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"विषारी","poem":1},{"noteId":3},{"text":"व कठीण परिश्रमाने हाल आणि यातना यांच्या","poem":1},{"text":"कोंडीत पकडून माझ्याभोवती वेढा दिला आहे.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"जसे दीर्घकालापूर्वीच मृत झाल्यागत","poem":1},{"text":"त्यांनी मला अंधकारात राहण्यास सोडले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"त्यांनी माझ्याभोवती भिंत बांधली, म्हणजे मी सुटून जाऊ शकणार नाही;","poem":1},{"text":"त्यांनी मला अवजड साखळदंडानी जखडले आहे.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"जरी मी एवढा धावा करतो व मदतीसाठी ओरडतो,","poem":1},{"text":"तरी ते माझ्या प्रार्थना ऐकत नाहीत.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"मोठमोठे दगड ठेऊन माझ्या मार्गात बाधा घातली आहे.","poem":1},{"text":"त्यांनी माझी वाट आडवळणांची केली आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"दबा धरून बसलेल्या अस्वलाप्रमाणे,","poem":1},{"text":"लपून बसलेल्या सिंहाप्रमाणे","poem":2}]},{"type":"verse","number":11,"content":[{"text":"त्यांनी मला माझ्या वाटेवरून ओढून नेले आणि छिन्नविछिन्न केले","poem":1},{"text":"आणि मला तसेच असहाय्य टाकून दिले.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"त्यांनी आपले धनुष्य ताणून","poem":1},{"text":"मला आपल्या बाणाचे लक्ष्य बनविले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"आणि त्यांच्या भात्यातील बाणांनी","poem":1},{"text":"माझे अंतर्याम छेदले आहे.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"मी माझ्या लोकांच्या उपहासाचा विषय झालो आहे;","poem":1},{"text":"ते दिवसभर माझ्या चेष्टेची गीते गातात.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"प्रभूने मला कडू दवण्याने भरून टाकले आहे,","poem":1},{"text":"आणि मला आंब प्यावयास दिली आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"त्यांनी माझे दात खड्यांनी पाडले आहेत.","poem":1},{"text":"त्यांनी मला धुळीत तुडविले आहे.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"माझी शांती हिरावून गेली आहे;","poem":1},{"text":"समृद्धी म्हणजे काय असते हे मी विसरलो आहे.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"म्हणून मी म्हणतो, “माझे वैभव निघून गेले आहे","poem":1},{"text":"व याहवेहकडून काहीही मिळण्याची आशा नष्ट झाली आहे.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"माझी पीडा व भटकंतीची,","poem":1},{"text":"विषारी वनस्पती व कडू दवणा यांची मला आठवण येते.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ते माझ्या चांगलेच स्मरणात आहे,","poem":1},{"text":"आणि त्याने माझा आत्मा अत्यंत खिन्न होतो.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"तरीपण आशेचा हा एक","poem":1},{"text":"किरण उरला आहे:","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"याहवेहच्या महान प्रीतीमुळे आम्ही पूर्णपणे भस्म झालेलो नाही","poem":1},{"text":"कारण त्यांच्या कृपेचा कधीही ऱ्हास होत नाही.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"त्यांची प्रेमदया प्रतिदिवशी नवी होते;","poem":1},{"text":"तुमची विश्वसनीयता महान आहे.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"मी स्वतःस म्हणतो, “याहवेह माझा वाटा आहेत;","poem":1},{"text":"म्हणूनच मी त्यांची प्रतीक्षा करेन.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"जे याहवेहवर त्यांची आशा ठेवतात,","poem":1},{"text":"आणि जे त्यांचा शोध घेतात, त्या सर्वांसाठी ते भले आहेत.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"याहवेहच्या तारणाची शांतपणे वाट पाहणे","poem":1},{"text":"हितकारक आहे.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"मनुष्याने त्याच्या तारुण्यात जू वाहणे","poem":1},{"text":"त्याच्या हितासाठी आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"कारण ते याहवेहनेच त्याच्यावर लादले आहे","poem":1},{"text":"म्हणून त्याने एकांतात शांत बसावे.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"त्याला त्याचे मुख धुळीत पुरू दे—","poem":1},{"text":"तरी आशा कायम असेल.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"जे त्याला चपराक मारतात, त्यांच्यापुढे त्याने दुसरा गालही करावा,","poem":1},{"text":"आणि तो सर्व अपमानाने भरून जाऊ दे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"कारण प्रभू कोणाचाही","poem":1},{"text":"कायमचा त्याग करत नाहीत.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"जरी त्यांनी त्याला दुःख दिले, तरी ते करुणा करतात,","poem":1},{"text":"त्यांची महान प्रेमदया अथांग आहे.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ते स्वखुशीने माणसांना पीडा देत नाहीत","poem":1},{"text":"व त्यांना दुखवित नाहीत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"जगातील सर्व बंदिवानांना","poem":1},{"text":"पायाखाली तुडवून चिरडणे,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"परमोच्चांनी दिलेले हक्क","poem":1},{"text":"त्यांच्यापासून हिरावून घेणे,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"कोणा मनुष्याची न्याय-वंचना करणे—","poem":1},{"text":"या गोष्टी प्रभू बघणार नाहीत काय?","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"प्रभूने परवानगी दिल्याशिवाय","poem":1},{"text":"बोलून तसे घडविण्याचे सामर्थ्य कोणामध्ये आहे?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"अनिष्ट व इष्ट ही दोन्हीही","poem":1},{"text":"परमोच्चाच्या मुखातून येत नाहीत काय?","poem":2}]},{"type":"verse","number":39,"content":[{"text":"आमच्या पापांबद्दल आम्हाला शिक्षा होते,","poem":1},{"text":"तेव्हा आम्ही जिवंत मानवांनी तक्रार का करावी?","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"आपण स्वतःच्या आचरणांचे निरीक्षण करू व त्यांची परीक्षा घेऊ,","poem":1},{"text":"आणि परत याहवेहकडे वळू.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"आपण स्वर्गातील परमेश्वराकडे","poem":1},{"text":"आपले अंतःकरण आणि आपले हात उंच करू व म्हणू:","poem":2}]},{"type":"verse","number":42,"content":[{"text":"आम्ही पाप केले आणि बंड केले","poem":1},{"text":"आणि तुम्ही त्याची क्षमा केली नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"“तुम्ही आपल्या संतापाने स्वतःला वेष्टिले आणि आमचा पाठलाग केला;","poem":1},{"text":"तुम्ही निर्दयपणे संहार केला.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"तुम्ही स्वतःस मेघाने आच्छादून घेतले आहे","poem":1},{"text":"जेणेकरून कोणतीही प्रार्थना तुमच्यापर्यंत पोचू नये.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"तुम्ही आम्हाला राष्ट्रांमध्ये केरकचरा","poem":1},{"text":"गाळ व उकिरडा केले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"“सर्व शत्रूंनी आपले मुख","poem":1},{"text":"आमच्याविरुद्ध खूप रुंद उघडले आहे.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"आम्ही दहशत व जोखिम,","poem":1},{"text":"विनाश आणि विध्वंस यातून गेलो आहोत.”","poem":2}]},{"type":"verse","number":48,"content":[{"text":"माझ्या लोकांच्या विनाशामुळे","poem":1},{"text":"माझ्या डोळ्यांतून अश्रूंचे प्रवाह निघत आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"माझे डोळे अखंडपणे,","poem":1},{"text":"न थांबता, अश्रुपात करीत राहतील,","poem":2}]},{"type":"verse","number":50,"content":[{"text":"याहवेह स्वर्गातून खाली दृष्टी करून","poem":1},{"text":"पाहीपर्यंत ते वाहत राहतील.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"माझ्या नगरातील स्त्रियांना बघून","poem":1},{"text":"माझे अंतःकरण पीडित होत आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"जे विनाकारण माझे शत्रू बनले होते,","poem":1},{"text":"त्यांनी एखाद्या पक्ष्याप्रमाणे माझी शिकार केली आहे.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"त्यांनी एका खड्ड्यात माझा जीव घेण्याचा प्रयत्न केला","poem":1},{"text":"आणि माझ्यावर दगडमार केला;","poem":2}]},{"type":"verse","number":54,"content":[{"text":"पाणी माझ्या डोक्याच्या वरपर्यंत आले,","poem":1},{"text":"आणि मला वाटले की आता माझा नाश होणार.","poem":2}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"याहवेह, त्या खोल डोहातून","poem":1},{"text":"मी तुमच्या नावाचा धावा केला,","poem":2}]},{"type":"verse","number":56,"content":[{"text":"तुम्ही माझी विनंती ऐकली: “माझ्या विनवणीकडे","poem":1},{"text":"तुम्ही दुर्लक्ष करू नका.”","poem":2}]},{"type":"verse","number":57,"content":[{"text":"मी धावा करताच तुम्ही मजजवळ आले","poem":1},{"text":"आणि म्हणाले, “भिऊ नकोस.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"हे प्रभू, तुम्हीच माझा वाद चालविला;","poem":1},{"text":"तुम्ही माझ्या जीवनाची खंडणी दिली.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"याहवेह, माझ्यावर झालेला अन्याय तुम्ही पाहिला आहे.","poem":1},{"text":"तुम्हीच माझी बाजू उचलून धरा!","poem":2}]},{"type":"verse","number":60,"content":[{"text":"तुम्ही माझ्याविरुद्ध असलेली सुडाची गहनता,","poem":1},{"text":"त्यांनी रचलेले सर्व कारस्थान तुम्ही पाहिले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"याहवेह, त्यांनी केलेले अपमान तुम्ही ऐकले आहेत,","poem":1},{"text":"त्यांनी रचलेले सर्व कारस्थान—","poem":2}]},{"type":"verse","number":62,"content":[{"text":"माझे शत्रू माझ्याविरुद्ध दिवसभर","poem":1},{"text":"काय बोलतात व काय कुजबुजतात, हे सर्व तुम्ही ऐकले आहे.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"त्यांच्याकडे बघा! उभे राहून वा बसून,","poem":1},{"text":"ते माझ्या उपहासाची गाणी गातात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"हे याहवेह, त्यांच्या दुष्कृत्यांबद्दल","poem":1},{"text":"ते ज्यास पात्र आहेत, असे प्रतिफळ त्यांना द्या.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"त्यांच्या हृदयावर आवरण टाका,","poem":1},{"text":"तुमचा शाप त्यांच्यावर पडो!","poem":2}]},{"type":"verse","number":66,"content":[{"text":"क्रोधाने त्यांचा पाठलाग करा आणि","poem":1},{"text":"याहवेहच्या आकाशाखालून त्यांना पूर्णपणे नाहीसे करा.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":3,"caller":"+","text":"कटुता","reference":{"chapter":3,"verse":5}}]},"thisChapterLink":"/api/mar_cbi/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}