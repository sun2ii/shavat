{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"LAM","translationId":"mar_cbi","name":"विलापगीत","commonName":"विलापगीत","title":"विलापगीत","order":25,"numberOfChapters":5,"sha256":"d1d83778dc5408396c75bfa3ae57bce1ad1a41466dd22dae42a682cb5d472651","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/mar_cbi/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"सोन्याची चमक कशी नाहीशी झाली आहे,","poem":1},{"text":"उत्तम सोने निस्तेज झाले आहे!","poem":2},{"text":"पवित्र रत्ने प्रत्येक रस्त्याच्या","poem":1},{"text":"कोपऱ्यात विखुरली आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"सुवर्णतुल्य असलेल्या,","poem":1},{"text":"सीयोनाच्या लेकरांना,","poem":2},{"text":"आता कुंभाराच्या हातांनी","poem":1},{"text":"घडविलेल्या मातीच्या पात्रांप्रमाणे लेखले जात आहे!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"कोल्हीदेखील आपल्या पिलांना","poem":1},{"text":"स्तनपान करते,","poem":2},{"text":"पण माझे लोक वाळवंटातील शहामृगांसारखे","poem":1},{"text":"निर्दयी झाले आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"तहानेमुळे शिशूंच्या जिभा","poem":1},{"text":"टाळूला चिकटल्या आहेत;","poem":2},{"text":"भाकरीसाठी लेकरे याचना करीत आहेत,","poem":1},{"text":"पण त्यांना कोणीही देत नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"उत्तम पक्वान्ने खाणारे","poem":1},{"text":"आता रस्तोरस्ती निराधार असे फिरत आहेत.","poem":2},{"text":"जांभळी शाही वस्त्रे परिधान केलेले","poem":1},{"text":"आता राखेत लोळत आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"माझ्या लोकांची शिक्षा","poem":1},{"text":"सदोमापेक्षाही घोर झाली आहे,","poem":2},{"text":"ज्यांना इतर कोणी मदत करण्याआधी","poem":1},{"text":"त्यांचा एका क्षणात नायनाट झाला.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"त्यांचे अधिपती हिमापेक्षा अधिक तेजस्वी","poem":1},{"text":"आणि दूधापेक्षा अधिक धवल होते,","poem":2},{"text":"त्यांचे देह माणकांपेक्षा अधिक तुकतुकीत,","poem":1},{"text":"सशक्त व निरोगी त्यांची देहरचना नीलरत्नापेक्षा अधिक तेजस्वी होती.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"पण आता ते चेहरे काजळीपेक्षा काळेकुट्ट झाले आहेत;","poem":1},{"text":"त्यांना वाटेत कोणी ओळखू शकत नाही.","poem":2},{"text":"त्यांची कातडी हाडांना चिकटली आहे;","poem":1},{"text":"ती काठीसारखी शुष्क झाली आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"उपासमारीने हळूहळू मरण्यापेक्षा","poem":1},{"text":"तलवारीने मरणारे फार बरे;","poem":2},{"text":"कारण शेतातील उपज नसल्यामुळे","poem":1},{"text":"भुकेपायी व्याकूळ होऊन ते क्षय पावतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"करुणामयी स्त्रियांनी स्वतःच्या हाताने","poem":1},{"text":"आपलीच मुले-बाळे शिजविली,","poem":2},{"text":"जेव्हा माझ्या लोकांचा नायनाट झाला,","poem":1},{"text":"ती त्यांचे अन्न बनली.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"याहवेहने त्यांच्या क्रोधास निर्बंध सोडले आहे;","poem":1},{"text":"त्यांचा अत्यंत भयानक क्रोध ओतला गेला आहे.","poem":2},{"text":"त्यांनी सीयोनमध्ये अग्नी पेटविला","poem":1},{"text":"त्या अग्नीने तिच्या पायांना भस्म करून टाकले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"यरुशलेमच्या वेशीतून आत","poem":1},{"text":"एखादा शत्रू वा विरोधी शिरू शकेल,","poem":2},{"text":"यावर संपूर्ण पृथ्वीवरील राजांनी","poem":1},{"text":"तसेच जगातील कोणत्याही लोकांनी विश्वास ठेवला नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"तेथील संदेष्ट्यांनी केलेली पापे","poem":1},{"text":"आणि निर्दोष व्यक्तींचे रक्त","poem":2},{"text":"या नगरीत सांडून","poem":1},{"text":"याजकांनी केलेला अधर्मामुळे तसे घडले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"आता तेच लोक आंधळ्यासारखे झोकांड्या","poem":1},{"text":"खात चालले आहेत.","poem":2},{"text":"ते रक्ताने माखून असे भ्रष्ट झाले आहेत","poem":1},{"text":"की त्यांच्या वस्त्रांना स्पर्श करण्याचे कोणीही धाडस करीत नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"लोक त्यांच्यावर खेकसतात: “चालते व्हा! तुम्ही अशुद्ध आहात!","poem":1},{"text":"दूर! दूर! आम्हाला स्पर्श करू नका!”","poem":2},{"text":"जेव्हा ते पलायन करतात आणि तिथे भटकतात,","poem":1},{"text":"त्या देशातील लोक म्हणतात,","poem":2},{"lineBreak":true},{"text":"“ते आता इथे राहू शकत नाहीत.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"स्वतः याहवेहने त्यांची पांगापांग केली आहे;","poem":1},{"text":"ते आता त्यांचा सांभाळ करणार नाहीत.","poem":2},{"text":"याजक सन्मानयोग्य राहिले नाहीत,","poem":1},{"text":"वडीलजन कृपेयोग्य राहिले नाहीत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"शिवाय, मदतगार शोधून","poem":1},{"text":"आमची दृष्टी मंद झाली आहे;","poem":2},{"text":"जे आमच्या मदतीसाठी येणार नाहीत","poem":1},{"text":"अशा राष्ट्रांवर आमच्या बुरुजांवरून आम्ही लक्ष ठेवले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"आम्हाला बाहेर रस्त्यांवर चालता येत नाही,","poem":1},{"text":"कारण लोक प्रत्येक पावलावर आमचा पाठलाग करतात.","poem":2},{"text":"आमचा अंत जवळ आला आहे, आणि आमचे मोजकेच दिवस राहिले आहेत.","poem":1},{"text":"आमचा अंत आलेलाच आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"आमचा पाठलाग करणारे","poem":1},{"text":"आकाशातील गरुडांपेक्षा वेगवान आहेत;","poem":2},{"text":"ते पर्वतांवरही आम्हाला शोधून काढतात","poem":1},{"text":"आणि वाळवंटात आमची वाट पाहत दबा धरून बसलेले असतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"याहवेह द्वारा अभिषिक्त, आमच्या जीवनाचा श्वास,","poem":1},{"text":"त्यांच्या जाळ्यात अडकला.","poem":2},{"text":"आम्ही विचार केला होता की त्यांच्या छत्राखाली","poem":1},{"text":"कोणत्याही परकीय राष्ट्रात आम्ही रहिवास करू.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ऊस प्रांतात राहणार्‍या एदोम कन्ये,","poem":1},{"text":"हर्ष कर व उल्हासित हो.","poem":2},{"text":"परंतु तुझ्याकडे देखील तो प्याला आणल्या जाईल;","poem":1},{"text":"तू तो पिऊन मदोन्मत्त होऊन पूर्णतः निर्वस्त्र होशील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"सीयोनकन्ये, तुझी शिक्षा संपेल,","poem":1},{"text":"ते तुझा बंदिवास वाढविणार नाहीत.","poem":2},{"text":"पण एदोम कन्ये, तुझ्या पापांची ते तुला शिक्षा देतील,","poem":1},{"text":"आणि तुझी दुष्टता उघडकीस आणतील.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}