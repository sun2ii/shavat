{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"MIC","translationId":"mar_cbi","name":"मीखाह","commonName":"मीखाह","title":"मीखाहाची भविष्यवाणी","order":33,"numberOfChapters":7,"sha256":"b0bb318127623af9434f0e3f44d42d57b682c4321572daefe0cd491cd3e69770","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/mar_cbi/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["यहूदीयाचे राजे योथाम, आहाज आणि हिज्कीयाहच्या कारकिर्दीत, मोरेशेथचा रहिवासी मीखाहला याहवेहचा संदेश आला—त्याने शोमरोन आणि यरुशलेमबद्दल दृष्टान्तात पाहिला."]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"सर्व लोकहो, तुम्ही सर्वजण, ऐका,","poem":1},{"text":"पृथ्वी आणि जे सर्व त्यामध्ये राहतात, लक्ष द्या,","poem":2},{"text":"सार्वभौम याहवेह परमेश्वर, त्यांच्या पवित्र मंदिरातून,","poem":1},{"text":"तुमच्याविरुद्ध साक्ष देतील.","poem":2}]},{"type":"heading","content":["शोमरोन आणि यरुशलेमविरुद्ध न्याय"]},{"type":"verse","number":3,"content":[{"text":"पाहा! याहवेह त्यांच्या निवासस्थानातून बाहेर पडत आहेत.","poem":1},{"text":"ते खाली उतरतात आणि पृथ्वीच्या उंच जागा तुडवितात.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"त्यांच्या पायाखाली पर्वत वितळतात","poem":1},{"text":"जसे अग्नीपुढे मेण,","poem":2},{"text":"जसे पाणी उतारावरून खाली येते,","poem":1},{"text":"तशा दऱ्या दुभंगतात.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"हे सर्व याकोबाच्या अपराधामुळे","poem":1},{"text":"आणि इस्राएली लोकांच्या पापाचे परिणाम आहे.","poem":2},{"text":"याकोबाचा अपराध काय आहे?","poem":1},{"text":"ते शोमरोन आहे की नाही?","poem":2},{"text":"यहूदीयाचे उच्च स्थान कोणते आहे?","poem":1},{"text":"ते यरुशलेम नाही की नाही?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“म्हणून मी शोमरोनला मातीचा ढिगारा,","poem":1},{"text":"द्राक्षमळे लावण्याची जागा करेन.","poem":2},{"text":"मी तिचे दगड खोऱ्यात टाकेन","poem":1},{"text":"आणि तिचा पाया उघडा करेन.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तिच्या सर्व मूर्ती फोडून तुकडे करण्यात येतील;","poem":1},{"text":"तिच्या मंदिरातील सर्व भेटवस्तू अग्नीत भस्म होतील;","poem":2},{"lineBreak":true},{"text":"मी तिच्या सर्व प्रतिमा नष्ट करेन.","poem":2},{"text":"कारण तिने आपल्या भेटवस्तू वेश्याव्यवसाय करून मिळवल्या आहेत,","poem":1},{"text":"आणि त्या पुन्हा वेश्यावृत्तीची मजुरी म्हणून वापरली जाईल.”","poem":2}]},{"type":"heading","content":["शोक व आक्रंदन"]},{"type":"verse","number":8,"content":[{"text":"म्हणून मी शोक व आक्रंदन करेन;","poem":1},{"text":"मी अनवाणी व वस्त्रहीन फिरेन.","poem":2},{"text":"कोल्ह्यासारखा मी आक्रोश करेन;","poem":1},{"text":"आणि घुबडाप्रमाणे विव्हळेन.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"कारण शोमरोनची पीडा असाध्य आहे;","poem":1},{"text":"ती यहूदीयामध्ये पसरली आहे.","poem":2},{"text":"ती माझ्या लोकांच्या वेशीपर्यंत पोहोचली आहे,","poem":1},{"text":"ती यरुशलेमपर्यंतही पोहोचली आहे.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"गथ","poem":1},{"noteId":0},{"text":"मध्ये ही बातमी देऊ नका;","poem":1},{"text":"अजिबात रडू नका.","poem":2},{"text":"बेथ‑ले‑अफ्राह","poem":1},{"noteId":1},{"text":"मध्ये जाऊन","poem":1},{"text":"धुळीत लोळ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"शाफीर","poem":1},{"noteId":2},{"text":"मध्ये राहणारे तुम्ही","poem":1},{"text":"वस्त्रहीन आणि निर्लज्जपणे निघून जा.","poem":2},{"text":"जे झानन","poem":1},{"noteId":3},{"text":"मध्ये राहतात","poem":1},{"text":"ते बाहेर जाणार नाहीत.","poem":2},{"text":"बेथ‑एसल विलाप करीत आहे;","poem":1},{"text":"ते तुम्हाला यापुढे संरक्षण देऊ शकत नाही.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"मारोथ","poem":1},{"noteId":4},{"text":"मध्ये राहणारे लोक वेदनांनी रडत आहेत,","poem":1},{"text":"आणि मदतीची वाट पाहत आहेत,","poem":2},{"text":"कारण यरुशलेमच्या प्रवेशद्वारापर्यंत पीडा","poem":1},{"text":"याहवेहने पाठविलेली आहे.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"लाखीशमध्ये राहणार्‍यांनो,","poem":1},{"text":"वेगवान घोडे रथाला जुंपा.","poem":2},{"text":"तुझ्यापासून सीयोनच्या कन्येचे पाप सुरू झाले,","poem":1},{"text":"कारण तुझ्यामध्ये इस्राएलचे अपराध आढळून आले.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"त्यामुळे तू मोरेशेथ-गथला","poem":1},{"text":"निरोपाची भेट देशील.","poem":2},{"text":"अकजीब","poem":1},{"noteId":5},{"text":"चे रहिवासी","poem":1},{"text":"इस्राएलच्या राजांना फसविणारी ठरतील.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"मारेशाहच्या रहिवाशांनो,","poem":1},{"text":"मी तुमच्यावर विजय मिळविणारा पाठवेन.","poem":2},{"text":"इस्राएलचे प्रतिष्ठित लोक","poem":1},{"text":"अदुल्लामला पळून जातील.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ज्या मुलांमध्ये तुम्ही आनंदी आहात","poem":1},{"text":"त्यांच्यासाठी शोक करताना आपले डोके मुंडण करा;","poem":2},{"text":"गिधाडासारखे तुमच्या डोक्याचे मुंडण करा,","poem":1},{"text":"कारण ते तुमच्यापासून गुलाम म्हणून जातील.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"गथ म्हणजे सांगणे","reference":{"chapter":1,"verse":10}},{"noteId":1,"caller":"+","text":"म्हणजे धुळीचे घर","reference":{"chapter":1,"verse":10}},{"noteId":2,"caller":"+","text":"शाफीर अर्थात् आनंददायी","reference":{"chapter":1,"verse":11}},{"noteId":3,"caller":"+","text":"झानन अर्थात् बाहेर या","reference":{"chapter":1,"verse":11}},{"noteId":4,"caller":"+","text":"मारोथ अर्थात् कडू","reference":{"chapter":1,"verse":12}},{"noteId":5,"caller":"+","text":"अकजीब म्हणजे फसवणूक","reference":{"chapter":1,"verse":14}}]},"thisChapterLink":"/api/mar_cbi/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}