{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"MIC","translationId":"mar_cbi","name":"मीखाह","commonName":"मीखाह","title":"मीखाहाची भविष्यवाणी","order":33,"numberOfChapters":7,"sha256":"b0bb318127623af9434f0e3f44d42d57b682c4321572daefe0cd491cd3e69770","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/mar_cbi/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"heading","content":["मानवी योजना आणि परमेश्वराच्या योजना"]},{"type":"verse","number":1,"content":[{"text":"जे वाईट कृत्याची योजना करतात,","poem":1},{"text":"जे आपल्या अंथरुणावर कट रचतात, त्यांचा धिक्कार असो!","poem":2},{"text":"पहाट होताच ते त्यांचा कट पूर्ण करतात","poem":1},{"text":"कारण हे सामर्थ्य त्यांच्या हातात असते.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ते लोभीपणाने इतरांची शेते बळकावतात,","poem":1},{"text":"दुसऱ्यांची घरेही हिसकावून घेतात.","poem":2},{"text":"ते कपटाने लोकांची घरे बळकावतात","poem":1},{"text":"आणि त्यांच्या पूर्वजांची संपत्ती लुटतात.","poem":2}]},{"type":"verse","number":3,"content":["म्हणून याहवेह म्हणतात:",{"text":"“मी या लोकांविरुद्ध विपत्ती योजत आहे,","poem":1},{"text":"ज्यापासून तुम्ही स्वतःला वाचवू शकत नाही.","poem":2},{"text":"तुम्ही पुन्हा कधीही गर्वाने चालणार नाही,","poem":1},{"text":"कारण तो आपत्तीचा काळ असेल.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"त्या दिवशी लोकांकरिता तुम्ही चेष्टेचा विषय व्हाल;","poem":1},{"text":"ते तुम्हाला या विलाप गीताने टोमणे मारतील:","poem":2},{"text":"‘आमचा संपूर्ण नाश झाला आहे;","poem":1},{"text":"माझ्या लोकांच्या मालमत्तेची विभागणी झाली आहे.","poem":2},{"text":"ते ती माझ्यापासून काढून घेतात!","poem":1},{"text":"ते आमची शेते बंडखोरांना देतात.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"म्हणून याहवेहच्या सभेत चिठ्ठ्या टाकून","poem":1},{"text":"सूत्राने जमिनीची वाटणी करण्यास तुमच्याकडे कोणी राहणार नाही.","poem":2}]},{"type":"heading","content":["खोटे संदेष्टे"]},{"type":"verse","number":6,"content":[{"text":"त्यांचे संदेष्टे म्हणतात, “संदेश देऊ नका,","poem":1},{"text":"या गोष्टींबद्दल संदेश देऊ नका;","poem":2},{"lineBreak":true},{"text":"आमच्यावर अप्रतिष्ठा येणार नाही.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"हे याकोबाच्या घराण्या, “असे म्हटले जावे काय,","poem":1},{"text":"याहवेह","poem":2},{"noteId":6},{"text":"अधीर होतात काय?","poem":2},{"lineBreak":true},{"text":"ते अशी कामे करतात काय?","poem":2},{"lineBreak":true},{"text":"“ज्याचे मार्ग सरळ आहेत त्याचे","poem":1},{"text":"माझे शब्द भले करत नाहीत काय?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"अलीकडे माझे लोक","poem":1},{"text":"शत्रूसारखे उठले आहेत.","poem":2},{"text":"जे लोक निष्काळजीपणे जवळून जातात","poem":1},{"text":"त्यांचे किमती कपडे तुम्ही काढून घेता,","poem":2},{"lineBreak":true},{"text":"जसे युद्धातून परत येणारे पुरुष करतात.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तुम्ही माझ्या लोकांच्या स्त्रियांना","poem":1},{"text":"त्यांच्या सुखी घरातून हाकलून देतात.","poem":2},{"text":"तुम्ही त्यांच्या मुलांकडून","poem":1},{"text":"माझे आशीर्वाद कायमचे हिरावून घेता.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"उठा, चालते व्हा!","poem":1},{"text":"कारण हे तुमचे विश्रांतिस्थान नाही,","poem":2},{"text":"कारण हे अशुद्ध झाले आहे,","poem":1},{"text":"सर्व उपायांच्या पलीकडे, ते उद्ध्वस्त झाले आहे.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"जर एखादा लबाड आणि फसवणूक करणारा येऊन म्हणाला,","poem":1},{"text":"‘मी तुम्हाला भरपूर द्राक्षारस व मद्याची भविष्यवाणी करेन,’","poem":2},{"lineBreak":true},{"text":"तर अशीच व्यक्ती या लोकांसाठी योग्य संदेष्टा होईल!","poem":2}]},{"type":"heading","content":["सुटकेचे अभिवचन"]},{"type":"verse","number":12,"content":[{"text":"“हे याकोबा, मी तुम्हा सर्वांना निश्चित गोळा करेन;","poem":1},{"text":"इस्राएलच्या उरलेल्यांना मी खचित गोळा करेन.","poem":2},{"text":"जसे मेंढवाड्यात मेंढरे,","poem":1},{"text":"जसे कुरणात कळप, तसे मी त्यांना एकत्र गोळा करेन;","poem":2},{"lineBreak":true},{"text":"आणि ती जागा लोकांनी फुलून जाईल.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"जे कुंपण तोडून मार्ग उघडणारे त्यांच्या पुढे जातील;","poem":1},{"text":"ते द्वार तोडून त्यातून बाहेर जातील.","poem":2},{"text":"त्यांचा राजा त्यांच्या पुढे जाईल,","poem":1},{"text":"याहवेह त्यांचे पुढारी असतील.”","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"याहवेह किंवा याहवेहचा आत्मा","reference":{"chapter":2,"verse":7}}]},"thisChapterLink":"/api/mar_cbi/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}