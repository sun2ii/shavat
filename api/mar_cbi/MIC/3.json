{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"MIC","translationId":"mar_cbi","name":"मीखाह","commonName":"मीखाह","title":"मीखाहाची भविष्यवाणी","order":33,"numberOfChapters":7,"sha256":"b0bb318127623af9434f0e3f44d42d57b682c4321572daefe0cd491cd3e69770","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/mar_cbi/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["पुढारी आणि संदेष्टे यांना फटकारणे"]},{"type":"verse","number":1,"content":["तेव्हा मी म्हणालो,",{"text":"याकोबाच्या पुढार्‍यांनो,","poem":1},{"text":"इस्राएलाच्या अधिकाऱ्यांनो, ऐका.","poem":2},{"text":"तुम्ही न्यायाला स्वीकारू नये काय,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"तुम्ही जो चांगल्याचा द्वेष करता व वाईटावर प्रीती करता;","poem":2},{"text":"तुम्ही माझ्या लोकांची कातडी सोलता,","poem":1},{"text":"आणि त्यांच्या हाडापर्यंतच्या मांसाचे लचके तोडता;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तुम्ही जे माझ्या लोकांचे मांस खाता,","poem":1},{"text":"त्यांची कातडी सोलता","poem":2},{"lineBreak":true},{"text":"आणि त्यांची हाडे मोडता,","poem":2},{"text":"आणि पातेल्यात शिजविण्यासाठी","poem":1},{"text":"मांसाचे तुकडे करावेत तसे त्यांचे तुकडे करता.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"मग ते याहवेहचा धावा करतील,","poem":1},{"text":"पण याहवेह त्यांचे ऐकणार नाही.","poem":2},{"text":"त्यावेळी त्यांच्या वाईट कृत्यांमुळे","poem":1},{"text":"याहवेह त्यांच्यापासून आपला चेहरा लपवतील.","poem":2}]},{"type":"verse","number":5,"content":["याहवेह असे म्हणतात:",{"text":"“माझ्या लोकांना","poem":1},{"text":"चुकीच्या मार्गाने नेणारे संदेष्टे,","poem":2},{"text":"त्यांना काही खायला मिळाल्यास","poem":1},{"text":"ते ‘शांती’ ची घोषणा करतात.","poem":2},{"text":"परंतु जो त्यांना खाण्याचे देण्यास नकार देतो","poem":1},{"text":"त्याच्याशी युद्ध करण्यास सुसज्ज राहतात.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"म्हणूनच तुझ्यावर रात्र येईल, दृष्टान्त दिसणार नाही,","poem":1},{"text":"आणि अंधार येईल, तुम्ही दैवप्रश्न पाहिल्याशिवाय!","poem":2},{"text":"या संदेष्ट्यांसाठी सूर्यास्त होईल","poem":1},{"text":"आणि दिवस असता त्यांच्यावर अंधार पडेल.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"द्रष्ट्यांना लाज वाटेल","poem":1},{"text":"आणि दैवप्रश्न करणारे फजीत होतील.","poem":2},{"text":"ते सर्व आपली मुखे झाकतील","poem":1},{"text":"कारण त्यांना परमेश्वराकडून उत्तर आलेले नाही.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"परंतु माझ्याबाबतीत म्हणाल,","poem":1},{"text":"तर याकोबाला त्याचे अपराध","poem":2},{"lineBreak":true},{"text":"आणि इस्राएलला त्याचे पाप सांगण्यासाठी","poem":2},{"text":"मी याहवेहच्या आत्म्याने, न्यायाने आणि सामर्थ्याने","poem":1},{"text":"परिपूर्ण आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"अहो याकोबाच्या पुढार्‍यांनो,","poem":1},{"text":"इस्राएलाच्या अधिकाऱ्यांनो, माझे ऐका,","poem":2},{"text":"तुम्ही न्यायाला तुच्छ लेखता","poem":1},{"text":"आणि चांगल्या गोष्टी विकृत करता;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"सीयोनला रक्तपाताने","poem":1},{"text":"आणि यरुशलेमला दुष्टपणाने बांधले आहे.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तिचे पुढारी लाच घेऊन न्याय करतात,","poem":1},{"text":"तिचे याजक किंमत घेऊन शिकवितात,","poem":2},{"lineBreak":true},{"text":"व तिचे संदेष्टे पैशासाठी भविष्य सांगतात.","poem":2},{"text":"तरीही ते याहवेहच्या मदतीसाठी आसुसलेले असतात आणि म्हणतात,","poem":1},{"text":"“याहवेह आपल्यामध्ये नाहीत काय?","poem":2},{"lineBreak":true},{"text":"आमच्यावर कोणतेही संकट येणार नाही.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"म्हणून तुमच्यामुळे,","poem":1},{"text":"सीयोन शेताप्रमाणे नांगरला जाईल,","poem":2},{"text":"यरुशलेम दगडांचा ढिगारा होईल,","poem":1},{"text":"मंदिराच्या टेकडीवर दाटीने झाडेझुडपे वाढतील.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}