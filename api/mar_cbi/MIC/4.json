{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"MIC","translationId":"mar_cbi","name":"मीखाह","commonName":"मीखाह","title":"मीखाहाची भविष्यवाणी","order":33,"numberOfChapters":7,"sha256":"b0bb318127623af9434f0e3f44d42d57b682c4321572daefe0cd491cd3e69770","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/mar_cbi/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["याहवेहचे पर्वत"]},{"type":"verse","number":1,"content":["पण शेवटच्या दिवसात",{"text":"याहवेहच्या मंदिराचे पर्वत बळकट व उंच","poem":1},{"text":"असे स्थापित केले जातील;","poem":2},{"text":"सर्व पर्वतांपेक्षा ते उंचावले जातील,","poem":1},{"text":"आणि लोकांचा लोंढा त्याकडे एकत्र येईल.","poem":2}]},{"type":"verse","number":2,"content":["अनेक राष्ट्रे येतील आणि म्हणतील,",{"text":"“चला, आपण याहवेहच्या पर्वताकडे,","poem":1},{"text":"याकोबाच्या परमेश्वराच्या मंदिराला जाऊ.","poem":2},{"text":"ते आपले मार्ग आम्हाला शिकवतील,","poem":1},{"text":"म्हणजे आम्ही त्या मार्गावर चालू.”","poem":2},{"text":"कारण सीयोनमधून नियमशास्त्र,","poem":1},{"text":"यरुशलेमातून याहवेहचे वचन बाहेर जाईल.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ते देशांमधील अनेक लोकांचा न्याय करतील,","poem":1},{"text":"दूरदूरच्या बलाढ्य राष्ट्रांमधील वाद मिटवतील.","poem":2},{"text":"ते आपल्या तलवारी ठोकून त्यांचे नांगराचे फाळ करतील,","poem":1},{"text":"व भाल्यांचे आकडे बनवतील.","poem":2},{"text":"एक देश दुसऱ्या देशाविरुद्ध तलवार उगारणार नाही,","poem":1},{"text":"तसेच ते यापुढे लष्करी प्रशिक्षण देणार नाहीत.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"प्रत्येकजण आपआपल्या द्राक्षवेलीखाली","poem":1},{"text":"आणि आपआपल्या अंजिराच्या झाडाखाली बसेल,","poem":2},{"text":"आणि कोणीही त्यांना घाबरविणार नाही,","poem":1},{"text":"कारण सर्वसमर्थ याहवेहने म्हटले आहे.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"सर्व राष्ट्रे","poem":1},{"text":"आपआपल्या दैवतांच्या नावाने चालतील,","poem":2},{"text":"पण आम्ही नेहमी","poem":1},{"text":"याहवेह आमच्या परमेश्वराच्या नावाने चालत राहू.","poem":2}]},{"type":"heading","content":["याहवेहची योजना"]},{"type":"verse","number":6,"content":[{"text":"याहवेह घोषित करतात, “त्या दिवशी,","poem":1},{"text":"मी लंगड्यांना एकत्र करेन;","poem":2},{"text":"बहिष्कृत लोकांना","poem":1},{"text":"आणि ज्यांना मी दुखविले आहे त्यांनाही एकत्र करेन.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"मी लंगड्यांना माझे अवशेष करेन,","poem":1},{"text":"आणि बहिष्कृत लोकांना एक बलाढ्य राष्ट्र करेन.","poem":2},{"text":"त्या दिवसापासून याहवेह सीयोन पर्वतावरून","poem":1},{"text":"सदासर्वदा राज्य करतील.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"आणि तू, कळपाच्या टेहळणीच्या बुरुजा,","poem":1},{"text":"सीयोन कन्येच्या मजबूत किल्ल्या,","poem":2},{"noteId":7},{"text":"तुझे पूर्वीचे राज्य तुला परत देण्यात येईल;","poem":1},{"text":"यरुशलेमच्या कन्येला सिंहासन दिले जाईल.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"तू आता मोठ्याने का रडत आहेस—","poem":1},{"text":"तुला राजा नाही काय?","poem":2},{"text":"तुमचा अधिकारी नष्ट झाला आहे काय,","poem":1},{"text":"म्हणून तुम्ही स्त्रीच्या प्रसूती वेदनांप्रमाणे व्याकूळ झाला आहात काय?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"हे सीयोनच्या कन्ये,","poem":1},{"text":"बाळंतपणाच्या प्रसूती वेदनांनी कण्हत राहा,","poem":2},{"text":"कारण तू आता शहर सोडून","poem":1},{"text":"मोकळ्या मैदानात तळ ठोकला पाहिजे.","poem":2},{"text":"तू बाबेलला जाशील;","poem":1},{"text":"आणि तिथे तुझी सुटका होईल","poem":2},{"text":"आणि याहवेह तिथून तुम्हाला","poem":1},{"text":"तुमच्या शत्रूंच्या हातातून मुक्त करतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"पण आता पुष्कळ राष्ट्रे","poem":1},{"text":"तुमच्याविरुद्ध एकत्र झाली आहेत.","poem":2},{"text":"ते म्हणतात, “तिला अशुद्ध होऊ द्या,","poem":1},{"text":"आपण सीयोनेवर दुष्ट नजर टाकून आनंद करू!”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"पण त्यांना","poem":1},{"text":"याहवेहचे विचार माहीत नाहीत;","poem":2},{"text":"त्यांना याहवेहच्या योजना समजत नाही,","poem":1},{"text":"खळ्यातील पेंढ्यांप्रमाणे याहवेहने त्यांना गोळा केले आहे.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“अगे सीयोनकन्ये, ऊठ, मळणी कर;","poem":1},{"text":"कारण मी तुला लोखंडाची शिंगे","poem":2},{"text":"व कास्याचे खूर देईन,","poem":1},{"text":"आणि तू अनेक राष्ट्रांचे तुकडे करशील.”","poem":2},{"text":"त्यांची लूट तू याहवेहला,","poem":1},{"text":"त्यांची संपत्ती सर्व पृथ्वीच्या प्रभूला अर्पण करशील.","poem":2}]}],"footnotes":[{"noteId":7,"caller":"+","text":"किंवा पर्वत","reference":{"chapter":4,"verse":8}}]},"thisChapterLink":"/api/mar_cbi/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}