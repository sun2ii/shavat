{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"MIC","translationId":"mar_cbi","name":"मीखाह","commonName":"मीखाह","title":"मीखाहाची भविष्यवाणी","order":33,"numberOfChapters":7,"sha256":"b0bb318127623af9434f0e3f44d42d57b682c4321572daefe0cd491cd3e69770","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/mar_cbi/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"heading","content":["बेथलेहेमातून अधिपती देण्याचे अभिवचन"]},{"type":"verse","number":1,"content":[{"text":"हे सैन्याच्या नगरी, आता आपल्या सैन्याला एकत्र करा,","poem":1},{"text":"कारण आमच्याविरुद्ध वेढा पडला आहे.","poem":2},{"text":"ते काठीने इस्राएलाच्या","poem":1},{"text":"शासकाच्या गालावर मारतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“परंतु, तू हे बेथलेहेम एफ्राथा,","poem":1},{"text":"तू जरी यहूदीयाच्या वंशजांपैकी सर्वात लहान आहेस,","poem":2},{"text":"तरी तुझ्यातून माझ्यासाठी","poem":1},{"text":"इस्राएलचा शासक उदय पावेल,","poem":2},{"noteId":8},{"text":"ज्याची उत्पत्ती","poem":1},{"text":"प्राचीन काळातील आहे.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"म्हणून प्रसूती वेदनेत असलेली","poem":1},{"text":"एका मुलाला जन्म देईपर्यंत","poem":2},{"text":"आणि तिचे बाकीचे भाऊ परत इस्राएल लोकांमध्ये येईपर्यंत","poem":1},{"text":"इस्राएलचा त्याग केला जाईल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"तो याहवेहच्या सामर्थ्याने,","poem":1},{"text":"याहवेह त्याच्या परमेश्वराच्या नावाच्या वैभवात उठेल","poem":2},{"lineBreak":true},{"text":"आणि आपल्या कळपाचा मेंढपाळ होईल आणि ते सुरक्षित राहतील,","poem":2},{"text":"कारण तेव्हा पृथ्वीच्या टोकापर्यंतच्या लोकांना","poem":1},{"text":"याहवेहची महानता कळेल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ते पुरुष","poem":1},{"noteId":9},{"text":"आपली शांती असतील","poem":1},{"text":"जेव्हा अश्शूरी आपल्या देशावर हल्ला करतील","poem":2},{"lineBreak":true},{"text":"आणि आपल्या किल्ल्यांमध्ये प्रवेश करतील,","poem":2},{"text":"तेव्हा आम्ही त्यांच्याविरुद्ध सात मेंढपाळ,","poem":1},{"text":"आठ देखील सेनापती उभे करू,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"अश्शूर देशावर तलवारीने,","poem":1},{"text":"निम्रोदाच्या देशावर उपसलेल्या तलवारीने कोण शासन","poem":2},{"noteId":10},{"text":"करेल.","poem":2},{"text":"अश्शूरचे लोक जेव्हा आपल्या देशावर आक्रमण करतील","poem":1},{"text":"आणि आपली सीमा ओलांडतील","poem":2},{"lineBreak":true},{"text":"तेव्हा याहवेह आपल्याला त्यांच्यापासून सोडवतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"याकोबाचे उरलेले लोक","poem":1},{"text":"अनेक लोकांमध्ये असतील,","poem":2},{"text":"ते याहवेहने पाठविलेल्या दहिवराप्रमाणे,","poem":1},{"text":"गवतावर पडणाऱ्या पावसाप्रमाणे असतील,","poem":2},{"text":"जे कोणाचीही वाट पाहत नाही","poem":1},{"text":"आणि कोणा मनष्यावर अवलंबून राहत नाही.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"याकोबाचे अवशेष राष्ट्रांमध्ये","poem":1},{"text":"आणि अनेक लोकांमध्ये असणार,","poem":2},{"text":"जंगली श्वापदांमध्ये सिंहासारखे","poem":1},{"text":"आणि मेंढरांच्या कळपामध्ये तरुण सिंहासारखे असतील,","poem":2},{"text":"ते त्यांच्यावर झेप घेतील आणि त्यांना ठार करीत पुढे जातील","poem":1},{"text":"आणि कोणीही त्यांना वाचवू शकत नाही.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तुझ्या शत्रूंवर विजय मिळवून तुझा हात उंच होईल","poem":1},{"text":"आणि तुझ्या सर्व शत्रूंचा नाश होईल.","poem":2}]},{"type":"verse","number":10,"content":["“त्या दिवशी,” याहवेह ही घोषणा करतात,",{"text":"“मी तुमच्या घोड्यांचा तुमच्यामध्ये नाश करेन","poem":1},{"text":"आणि तुमच्या रथांनाही नष्ट करेन.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"मी तुझ्या देशातील शहरांचा नाश करेन","poem":1},{"text":"आणि तुझे किल्ले उद्ध्वस्त करेन.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"मी तुमच्यातील चेटके नष्ट करेन","poem":1},{"text":"आणि यापुढे तुझ्यामध्ये कोणीही शकुन पाहणार नाही.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"मी तुमच्या मूर्ती","poem":1},{"text":"आणि तुमच्यातील पवित्र दगडांचा नाश करेन;","poem":2},{"text":"तुमच्या हस्तकृतींना","poem":1},{"text":"तुम्ही पुन्हा दंडवत करणार नाही.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"जेव्हा मी तुझी नगरे उद्ध्वस्त करेन,","poem":1},{"text":"तेव्हा तुझे अशेरा स्तंभ","poem":2},{"noteId":11},{"text":"उपटून टाकीन.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ज्या राष्ट्रांनी माझी आज्ञा पाळली नाही,","poem":1},{"text":"त्यांचा मी रागाने आणि क्रोधाने सूड उगवेन.”","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"किंवा अधिपती","reference":{"chapter":5,"verse":2}},{"noteId":9,"caller":"+","text":"ते पुरुष अर्थात् याहवेह","reference":{"chapter":5,"verse":5}},{"noteId":10,"caller":"+","text":"किंवा चुराडा","reference":{"chapter":5,"verse":6}},{"noteId":11,"caller":"+","text":"किंवा अश्शेरा देवीचे लाकडी चिन्ह","reference":{"chapter":5,"verse":14}}]},"thisChapterLink":"/api/mar_cbi/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}