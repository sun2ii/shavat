{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"MIC","translationId":"mar_cbi","name":"मीखाह","commonName":"मीखाह","title":"मीखाहाची भविष्यवाणी","order":33,"numberOfChapters":7,"sha256":"b0bb318127623af9434f0e3f44d42d57b682c4321572daefe0cd491cd3e69770","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/mar_cbi/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["इस्राएलची दुर्दशा"]},{"type":"verse","number":1,"content":[{"text":"काय ही माझी दुःखद स्थिती!","poem":1},{"lineBreak":true},{"text":"मी द्राक्षमळ्यातील","poem":1},{"text":"उन्हाळी फळे गोळा करणार्‍यासारखा आहे;","poem":2},{"text":"खाण्यास द्राक्षांचा घडही उरला नाही,","poem":1},{"text":"अंजिराच्या ज्या पहिल्या फळाची मला इच्छा होती ती सुद्धा नाही.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"पृथ्वीवरून विश्वासू लोकांचा नाश झाला आहे;","poem":1},{"text":"एकही प्रामाणिक मनुष्य उरला नाही.","poem":2},{"text":"प्रत्येकजण रक्तपात करण्यात गुंतला आहे;","poem":1},{"text":"ते सापळा रचून एकमेकांची शिकार करतात.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"वाईट करण्यात दोन्ही हात निपुण आहेत;","poem":1},{"text":"शासक भेटवस्तूंची मागणी करतो,","poem":2},{"text":"न्यायाधीश लाच घेतात,","poem":1},{"text":"सामर्थ्यवान लोक बळजबरीने त्यांच्या इच्छा पूर्ण करतात;","poem":2},{"lineBreak":true},{"text":"ते सर्व मिळून कट रचतात.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"त्यांच्यामध्ये जो सर्वोत्कृष्ट मानला जातो तो काटेरी झुडूप","poem":1},{"text":"आणि जो नीतिमान तो काट्याच्या कुंपणापेक्षाही वाईट आहे.","poem":2},{"text":"परमेश्वराने तुमच्याकडे येण्याचा दिवस आला आहे,","poem":1},{"text":"म्हणजेच तुमच्या पहारेकऱ्याने आवाज देण्याची वेळ आली आहे.","poem":2},{"lineBreak":true},{"text":"आता तुमच्या गोंधळाची वेळ आली आहे.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"शेजाऱ्यावर भरवसा ठेवू नका;","poem":1},{"text":"आणि मित्रांवर विश्वास ठेवू नका.","poem":2},{"text":"तुझ्या मिठीत असलेली स्त्रीबरोबर असतानाही,","poem":1},{"text":"तुझ्या ओठांच्या शब्दांचे रक्षण कर.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"कारण पुत्र आपल्या पित्याचा अनादर करतो,","poem":1},{"text":"मुलगी तिच्या आईविरुद्ध,","poem":2},{"text":"आणि सून तिच्या सासूविरुद्ध उठते—","poem":1},{"text":"मनुष्याचे शत्रू त्याच्या आपल्याच कुटुंबातील सदस्य असतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"मी तर, याहवेहची आशेने वाट पाहतो,","poem":1},{"text":"मी माझ्या तारणाऱ्या परमेश्वराची प्रतीक्षा करतो;","poem":2},{"lineBreak":true},{"text":"माझे परमेश्वर माझे ऐकतील.","poem":2}]},{"type":"heading","content":["इस्राएल उठेल"]},{"type":"verse","number":8,"content":[{"text":"अरे माझ्या वैर्‍या, माझी परिस्थिती बघून आनंद करू नकोस!","poem":1},{"text":"कारण मी पडलो, तरी पुन्हा उठेन.","poem":2},{"text":"जरी मी अंधारात बसलो,","poem":1},{"text":"तरी याहवेह माझा प्रकाश होतील.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"मी याहवेहविरुद्ध पाप केल्यामुळे,","poem":1},{"text":"ते माझी बाजू ऐकून","poem":2},{"text":"मला न्याय देईपर्यंत","poem":1},{"text":"मी याहवेहचा कोप सहन करेन.","poem":2},{"text":"ते मला प्रकाशात आणतील;","poem":1},{"text":"आणि मी त्यांचे न्यायीपण पाहीन.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"मग माझे शत्रू हे पाहून","poem":1},{"text":"ते लज्जेने झाकले जातील,","poem":2},{"text":"ती जी मला म्हणत होती,","poem":1},{"text":"“याहवेह तुझा परमेश्वर कुठे आहे?”","poem":2},{"text":"माझे डोळे तिचे पतन पाहतील;","poem":1},{"text":"रस्त्याच्या चिखलाप्रमाणे","poem":2},{"lineBreak":true},{"text":"तीही पायाखाली तुडविली जाईल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"तुमचे तट बांधण्याचा दिवस येईल,","poem":1},{"text":"आणि तुमच्या सीमा विस्तारित करण्याचा दिवस येईल.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"अश्शूरपासून इजिप्तच्या नगरांपर्यंत","poem":1},{"text":"आणि मिसरपासून फरात","poem":2},{"noteId":15},{"text":"नदीपर्यंत,","poem":2},{"text":"समुद्रापासून समुद्रापर्यंत","poem":1},{"text":"आणि डोंगरांपासून डोंगरांपर्यंत,","poem":2},{"lineBreak":true},{"text":"त्या दिवशी लोक तुझ्याकडे येतील.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"पृथ्वीवरील रहिवाशांमुळे,","poem":1},{"text":"त्यांच्या कृतींचा परिणाम म्हणून, पृथ्वी उजाड होईल.","poem":2}]},{"type":"heading","content":["प्रार्थना आणि स्तुती"]},{"type":"verse","number":14,"content":[{"text":"आपल्या लोकांचा काठीसह मेंढपाळ हो,","poem":1},{"text":"जो तुझ्या वतनाचा कळप आहे,","poem":2},{"text":"जो एकटाच जंगलात,","poem":1},{"text":"सुपीक कुरणात राहतो.","poem":2},{"noteId":16},{"text":"त्यांना पूर्वीप्रमाणे बाशानात व गिलआदात","poem":1},{"text":"यथेच्छ चरू द्या.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“तुम्ही इजिप्तमधून बाहेर आलात त्या दिवसांप्रमाणे,","poem":1},{"text":"मी त्यांना माझे चमत्कार दाखवेन.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"राष्ट्रे हे पाहतील आणि लज्जित होतील,","poem":1},{"text":"त्यांच्या सत्तेपासून वंचित राहतील.","poem":2},{"text":"ते आपली मुखे हाताने झाकतील","poem":1},{"text":"आणि त्यांचे कान बहिरे होतील.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ते सर्पाप्रमाणे,","poem":1},{"text":"भूमीवर सरपटणार्‍या प्राण्यांप्रमाणे धूळ चाटतील.","poem":2},{"text":"ते आपल्या बिळातून थरथर कापत बाहेर पडतील;","poem":1},{"text":"भयभीत होऊन ते याहवेह आमच्या परमेश्वराकडे वळतील","poem":2},{"lineBreak":true},{"text":"आणि तुमचे भय बाळगतील.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"तुम्ही जे अन्यायाची क्षमा करतात,","poem":1},{"text":"आपल्या वतनातील उरलेल्यांची पापे मागे टाकतात","poem":2},{"lineBreak":true},{"text":"त्या तुमच्यासारखा कोण परमेश्वर आहे?","poem":2},{"text":"तुम्ही सर्वकाळ क्रोध धरीत नाहीत,","poem":1},{"text":"परंतु दया दाखविण्यात आनंद मानता.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"पुन्हा एकदा तुम्ही आम्हावर दया कराल;","poem":1},{"text":"तुम्ही आमची पापे आपल्या पायाखाली तुडविणार;","poem":2},{"lineBreak":true},{"text":"आणि आमची दुष्कृत्ये समुद्राच्या खोलीत फेकून द्याल.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"फार पूर्वी,","poem":1},{"text":"आमच्या पूर्वजांना वचन दिल्याप्रमाणे,","poem":2},{"text":"तुम्ही याकोबाशी विश्वासू असाल,","poem":1},{"text":"आणि अब्राहामवर प्रीती दाखवाल.","poem":2}]}],"footnotes":[{"noteId":15,"caller":"+","text":"फरात किंवा ज्याला आजच्या काळात युफ्रेटिस या नावाने ओळखले जाते","reference":{"chapter":7,"verse":12}},{"noteId":16,"caller":"+","text":"किंवा कर्मेलच्या मधोमध","reference":{"chapter":7,"verse":14}}]},"thisChapterLink":"/api/mar_cbi/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}