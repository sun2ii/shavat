{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"NAM","translationId":"mar_cbi","name":"नहूम","commonName":"नहूम","title":"नहूमाची भविष्यवाणी","order":34,"numberOfChapters":3,"sha256":"b8b583478c2353be808372e824a85bead08e5dfe3def0894ef4b433d95a8fa34","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mar_cbi/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["निनवेहला धिक्कार असो"]},{"type":"verse","number":1,"content":[{"text":"हे रक्तपात करणाऱ्या नगरी, तुला धिक्कार असो,","poem":1},{"text":"लबाड्यांनी गच्च भरलेली,","poem":2},{"text":"लूटमाऱ्यांनी भरलेली,","poem":1},{"text":"कधीही पीडितांशिवाय नसणारी!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"चाबकांच्या फटकार्‍यांचा आवाज,","poem":1},{"text":"चाकांचा खडखडाट,","poem":2},{"text":"चौखूर धावणारे घोडे","poem":1},{"text":"आणि हिसके देणारे रथ!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"आक्रमक घोडेस्वारांची पलटण","poem":1},{"text":"लखलखणार्‍या तलवारी","poem":2},{"lineBreak":true},{"text":"चमचमणारे भाले!","poem":2},{"text":"पडलेली अनेक प्रेते,","poem":1},{"text":"सर्वत्र मृतांचे ढीग,","poem":2},{"text":"अगणित मृत शरीरे,","poem":1},{"text":"प्रेतांना अडखळून पडणारे लोक—","poem":2}]},{"type":"verse","number":4,"content":[{"text":"या सर्वांचे कारण, एका वेश्येच्या रंगेलपणाची वासना,","poem":1},{"text":"ती भुलविणारी, जादूटोण्याची स्वामिनी आहे,","poem":2},{"text":"तिने आपल्या वेश्यागिरीने राष्ट्रांना","poem":1},{"text":"आणि जादूटोण्याने लोकांना गुलाम बनविले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"सर्वसमर्थ याहवेह जाहीर करतात, “मी तुझ्याविरुद्ध आहे,","poem":1},{"text":"मी तुझे वस्त्र तुझ्या चेहऱ्यावर उचलेन.","poem":2},{"text":"तुझी नग्नता सर्व राष्ट्रांना","poem":1},{"text":"आणि तुझी लज्जा सर्व देशांना दाखवेन.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मी तुझ्यावर घृणास्पद गोष्टी फेकेन,","poem":1},{"text":"मी तुला अपमानित करेन","poem":2},{"lineBreak":true},{"text":"आणि तुला तमाशा बनवेन.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तुला पाहणारे सर्व भयभीत होऊन तुझ्यापासून दूर पळतील व म्हणतील,","poem":1},{"text":"‘निनवेह उद्ध्वस्त झाली आहे—तिच्यासाठी कोण शोक करेल?’","poem":2},{"lineBreak":true},{"text":"तुझे सांत्वन करणारा मला कुठे मिळेल?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"नाईल नदीकाठी वसलेल्या,","poem":1},{"text":"सर्व बाजूंनी पाण्याने घेरलेल्या","poem":2},{"lineBreak":true},{"text":"थेबेस नगरीपेक्षा तू अधिक चांगली आहेस काय?","poem":2},{"text":"नदीच तिला संरक्षण देते,","poem":1},{"text":"नदीच तिची तटबंदी आहे.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"कूश","poem":1},{"noteId":1},{"text":"आणि इजिप्त तिचे अपरिमित सामर्थ्य होते;","poem":1},{"text":"पूट व लिबिया तिच्या मित्रराष्ट्रांपैकी होते.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"असे असूनही थीब्जचा पाडाव झाला","poem":1},{"text":"आणि तिला बंदिवासात नेण्यात आले.","poem":2},{"text":"तिची बालके रस्त्यांच्या प्रत्येक कोपऱ्यावर","poem":1},{"text":"दगडांवर आपटून ठार मारण्यात आली.","poem":2},{"text":"तिच्या अधिकार्‍यांसाठी चिठ्ठ्या टाकण्यात आल्या,","poem":1},{"text":"तिच्या सर्व प्रतिष्ठित व्यक्तींना साखळदंडानी बांधण्यात आले.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तू देखील मद्यपीप्रमाणे धुंद होशील;","poem":1},{"text":"तू लपून बसशील","poem":2},{"lineBreak":true},{"text":"आणि सुरक्षिततेसाठी तुझ्या शत्रूपासून आश्रय शोधशील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"तुझे सर्व गड अंजिरांच्या झाडासारखे होतील","poem":1},{"text":"त्यांच्या प्रथम पिकलेल्या फळांगत;","poem":2},{"text":"जेव्हा ते हलविले जातात,","poem":1},{"text":"तेव्हा ते नेमके खाणाऱ्याच्या तोंडात पडतात.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तुझ्या सैन्य-दलांकडे पाहा—","poem":1},{"text":"ते सर्व दुर्बल आहेत.","poem":2},{"text":"तुझ्या देशाच्या वेशी","poem":1},{"text":"तुझ्या शत्रूंसाठी सताड उघडलेल्या आहेत;","poem":2},{"lineBreak":true},{"text":"तुझ्या वेशीच्या सळया अग्नीने भस्म केल्या आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"तुला पडणार्‍या वेढ्यासाठी पाण्याचा साठा करून ठेव,","poem":1},{"text":"तुझे किल्ले मजबूत कर!","poem":2},{"text":"चिखल तुडवून ठेव,","poem":1},{"text":"चिखलाचा गारा साच्यांत भर,","poem":2},{"lineBreak":true},{"text":"वीटकाम दुरुस्त कर!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"तिथे तुला अग्नी भस्म करेल;","poem":1},{"text":"तलवार तुला कापून टाकेल—","poem":2},{"lineBreak":true},{"text":"एखाद्या टोळधाडीप्रमाणे ते तुला गिळंकृत करतील.","poem":2},{"text":"नाकतोड्यासारखे बहुगुणित व्हा,","poem":1},{"text":"टोळांसारखे बहुगुणित व्हा!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"तू तुझ्या व्यापार्‍यांची संख्या वाढविली आहे","poem":1},{"text":"त्यांची संख्या आकाशातील तार्‍यांपेक्षाही जास्त वाढली आहे,","poem":2},{"text":"परंतु ते एखाद्या टोळधाडीप्रमाणे संपूर्ण भूमी ओरबाडून टाकतात","poem":1},{"text":"व मग ते उडून जातात.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"तुझे रक्षक टोळांसारखे आहेत,","poem":1},{"text":"तुझे अधिकारी टोळांच्या झुंडीप्रमाणे आहेत","poem":2},{"lineBreak":true},{"text":"थंडीच्या दिवसात ते भिंतीमध्ये वसतात—","poem":2},{"text":"पण सूर्योदय होताच उडून जातात,","poem":1},{"text":"आणि कुठे जातात ते कोणालाच कळत नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"हे अश्शूरच्या राजा, तुझे मेंढपाळ","poem":1},{"noteId":2},{"text":"डुलकी घेतात;","poem":1},{"text":"तुझे प्रतिष्ठित लोक विश्रांती घेण्यासाठी पहुडले आहेत.","poem":2},{"text":"तुझे लोक डोंगरांवर विखुरले आहेत","poem":1},{"text":"त्यांना एकत्र करण्यास कोणीही नाही.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"तुला कशानेही आरोग्य मिळणार नाही;","poem":1},{"text":"तुझी जखम घातक आहे.","poem":2},{"text":"तुझ्या दुर्दशेची बातमी जे कोणी ऐकतील","poem":1},{"text":"ते सर्वजण आनंदाने टाळ्या वाजवितील,","poem":2},{"text":"तुझ्या क्रूरतेचा उपद्रव ज्याला झाला नाही,","poem":1},{"text":"असा कोण आहे?","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"नाईल नदीचा वरचा भाग","reference":{"chapter":3,"verse":9}},{"noteId":2,"caller":"+","text":"अधिपती","reference":{"chapter":3,"verse":18}}]},"thisChapterLink":"/api/mar_cbi/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}