{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"OBA","translationId":"mar_cbi","name":"ओबद्याह","commonName":"ओबद्याह","title":"ओबद्याहाची भविष्यवाणी","order":31,"numberOfChapters":1,"sha256":"7b7125e9a6f4cdd2f1588191fdf5f069521f5b245b7881350563c12a08f9c10d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/OBA/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/mar_cbi/OBA/1.json","totalNumberOfVerses":21},"chapter":{"number":1,"content":[{"type":"heading","content":["ओबद्याहचा दृष्टान्त"]},{"type":"verse","number":1,"content":["ओबद्याहचा दृष्टान्त हा.",{"lineBreak":true},{"lineBreak":true},"एदोमाबद्दल सार्वभौम याहवेह असे म्हणतात;",{"text":"आम्ही याहवेहकडून हा संदेश ऐकला:","poem":1},{"text":"राष्ट्रांना सांगण्यासाठी एक दूत पाठविण्यात आला होता,","poem":2},{"text":"“उठा, आपण तिच्याविरुद्ध युद्ध करण्यास जाऊ.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“पाहा, राष्ट्रांमध्ये मी तुला लहान करेन;","poem":1},{"text":"तुझा पूर्णपणे तिरस्कार करण्यात येईल.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तुमच्या अंतःकरणाच्या गर्विष्ठपणाने तुमची फसवणूक केली आहे,","poem":1},{"text":"तुम्ही जे खडकांच्या","poem":2},{"noteId":0},{"text":"कपारीत राहता","poem":2},{"lineBreak":true},{"text":"आणि तुमचे घर उंचावर बांधता,","poem":2},{"text":"तुम्ही जे स्वतःला म्हणता,","poem":1},{"text":"‘मला खाली जमिनीवर कोण आणू शकेल?’","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तू गरुडांप्रमाणे उंच भरार्‍या मारीत असलास","poem":1},{"text":"किंवा आपले घरटे तार्‍यांमध्ये बांधत असलास,","poem":2},{"lineBreak":true},{"text":"तरी तिथून मी तुला खाली आणेन,”","poem":2},{"lineBreak":true},{"text":"असे याहवेह जाहीर करतात.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“जरी तुमच्याकडे चोर आले,","poem":1},{"text":"जरी रात्री लुटारू आले तर","poem":2},{"text":"पाहा, संकट कसे तुमची वाट पाहत आहे!","poem":1},{"text":"त्यांना हवे तेवढेच चोरत नाहीत काय?","poem":2},{"text":"जर द्राक्ष वेचणारे तुमच्याकडे आले,","poem":1},{"text":"तर ते थोडी द्राक्षे सोडणार नाहीत काय?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"परंतु एसावला लुटण्यात येईल,","poem":1},{"text":"आणि त्याचा गुप्त खजिना हस्तगत केला जाईल!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तुझ्यासोबत करार केलेले सर्व मित्र राष्ट्रे तुला तुझ्या सीमेपर्यंत ढकलतील;","poem":1},{"text":"तुझे मित्र तुला फसवतील आणि तुझा ताबा घेतील;","poem":2},{"text":"जे तुझी भाकरी खातात, तेच तुझ्यासाठी सापळा रचतील,","poem":1},{"text":"परंतु तुला ते कळणारही नाही.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"याहवेह असे जाहीर करतात,","poem":1},{"text":"“त्या दिवशी, मी एदोमच्या ज्ञानी पुरुषांचा,","poem":2},{"lineBreak":true},{"text":"एसावच्या डोंगरावर जे समजूतदार आहेत, त्यांचा नाश करणार नाही काय?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तेमान, तुझे योद्धे घाबरून जातील,","poem":1},{"text":"आणि एसावाच्या डोंगरांमध्ये असलेला प्रत्येकजण","poem":2},{"lineBreak":true},{"text":"कापला जाईल.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तुझा भाऊ याकोब याच्यावर केलेल्या अत्याचारामुळे,","poem":1},{"text":"तू लाजेने झाकून जाशील;","poem":2},{"lineBreak":true},{"text":"आणि तुझा कायमचा नाश करण्यात येईल.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"अनोळखी लोकांनी जेव्हा त्याची संपत्ती पळवून नेली","poem":1},{"text":"त्या दिवशी तू अलिप्त राहिला","poem":2},{"text":"आणि परदेशी लोक त्याच्या वेशीत शिरले","poem":1},{"text":"आणि यरुशलेमसाठी चिठ्ठ्या टाकल्या,","poem":2},{"lineBreak":true},{"text":"तेव्हा तू त्यांच्यापैकी एक होतास.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"आपल्या भावाच्या दुःखाच्या दिवशी","poem":1},{"text":"त्याच्याबद्दल आनंद करू नकोस,","poem":2},{"text":"किंवा यहूदीयाच्या रहिवाशांवर","poem":1},{"text":"आनंद मानू नकोस,","poem":2},{"text":"त्यांच्या संकटाच्या दिवशी","poem":1},{"text":"अधिक गर्व करू नकोस.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तुम्ही माझ्या लोकांच्या संकटाच्या दिवशी","poem":1},{"text":"माझ्या लोकांच्या नगरात प्रवेश करू नका,","poem":2},{"text":"किंवा त्यांच्या आपत्तीच्या दिवशी","poem":1},{"text":"त्यावर आनंद करू नका,","poem":2},{"text":"किंवा त्यांच्या विपत्तीच्या दिवशी.","poem":1},{"text":"त्यांच्या संपत्तीवर ताबा मिळवू नका.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"त्यांच्या फरार झालेल्यांना मारण्यासाठी","poem":1},{"text":"चौकात उभा राहू नको","poem":2},{"text":"किंवा त्यांच्या संकटाच्या वेळी","poem":1},{"text":"त्यांच्या शत्रूच्या स्वाधीन करू नको.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“सर्व राष्ट्रांसाठी","poem":1},{"text":"नेमलेला याहवेहचा दिवस जवळ आला आहे.","poem":2},{"text":"जसे तू केलेस, तसे तुझ्यासोबतही केले जाईल होईल;","poem":1},{"text":"तुझ्याद्वारे करण्यात आलेली दुष्कर्मे तुझ्याच माथ्यावर उलटतील.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"जसा तू माझ्या पवित्र पर्वतावर प्याला,","poem":1},{"text":"तसेच सर्व राष्ट्रे सतत पीत राहतील;","poem":2},{"text":"ते पितील आणि पीत राहतील","poem":1},{"text":"आणि जसे ते कधीच नव्हते तसे बनतील.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"पण सीयोन पर्वतावर तारण होईल;","poem":1},{"text":"ते पवित्र होईल,","poem":2},{"lineBreak":true},{"text":"आणि याकोबास त्याचे वतन मिळेल.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"याकोब अग्नीसारखा","poem":1},{"text":"आणि योसेफ ज्वालासारखे असतील;","poem":2},{"text":"एसाव उरलेल्या भुशासारखे होतील,","poem":1},{"text":"आणि ते त्यांना जाळून नष्ट करतील.","poem":2},{"text":"एसावच्या वंशजांपैकी","poem":1},{"text":"कोणीही जिवंत राहणार नाही.”","poem":2},{"text":"याहवेहने हे म्हटले आहे.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"एसावाचा पर्वत","poem":1},{"text":"दक्षिणेतील लोक ताब्यात घेतील,","poem":2},{"text":"आणि पलिष्टी लोकांच्या देशाला","poem":1},{"text":"डोंगराच्या पायथ्याशी राहणारे आपल्या ताब्यात घेतील.","poem":2},{"text":"ते एफ्राईम आणि शोमरोनच्या भूमीचा ताबा घेतील","poem":1},{"text":"आणि बिन्यामीन गिलआद प्रांत व्यापून घेतील.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"बंदिवान इस्राएल लोकांचा हा गट, जो कनानमध्ये आहे,","poem":1},{"text":"तो कनानी लोकांचा सारेफथपर्यंतचा प्रदेश ताब्यात घेतील;","poem":2},{"text":"यरुशलेमेचे बंदिवान, जे सफारदात शहरात आहेत,","poem":1},{"text":"ते नेगेवची शहरे ताब्यात घेतील.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"सुटका करणारे एसाव पर्वतावर","poem":1},{"text":"राज्य करण्यासाठी सीयोन पर्वतावर चढतील.","poem":2},{"lineBreak":true},{"text":"आणि ते याहवेहचे राज्य असेल.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"किंवा सेलाच्या कपारींमध्ये","reference":{"chapter":1,"verse":3}}]},"thisChapterLink":"/api/mar_cbi/OBA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/AMO/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}