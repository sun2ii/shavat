{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"धन्य ते लोक,","poem":1},{"text":"जे दुष्टांच्या मसलतीने चालत नाहीत,","poem":2},{"text":"किंवा पापी लोकांच्या मार्गात उभे राहत नाहीत,","poem":1},{"text":"आणि थट्टा करणार्‍यांच्या संगतीमध्ये बसत नाहीत.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"पण ज्यांचा आनंद याहवेहच्या नियमांचे पालन करणे,","poem":1},{"text":"आणि त्यांच्या नियमावर रात्रंदिवस ध्यान करणे असतो.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ते अशा वृक्षासारखे आहेत जे सतत वाहणार्‍या जलप्रवाहाजवळ लावलेले असते,","poem":1},{"text":"जे आपल्या ऋतूमध्ये फळ देते","poem":2},{"text":"आणि ज्यांची पाने कोमेजत नाहीत.","poem":1},{"text":"त्यांनी हाती घेतलेले प्रत्येक काम सिद्धीस जाते.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"परंतु दुष्ट तसे नाहीत.","poem":1},{"text":"ते वार्‍याने उडून जाणार्‍या","poem":2},{"lineBreak":true},{"text":"भुश्यासारखे आहेत.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"म्हणून दुष्ट न्यायसभेत,","poem":1},{"text":"किंवा पापी लोक नीतिमानांच्या सभेमध्ये उभे राहणार नाहीत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"कारण नीतिमानांच्या मार्गावर याहवेह दृष्टी ठेवतात,","poem":1},{"text":"परंतु दुष्टांचा मार्ग सर्वनाशाकडेच ओढून नेतो.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}