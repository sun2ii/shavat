{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":100,"content":[{"type":"hebrew_subtitle","content":["एक स्तोत्र. उपकारस्तुतीचे गीत"]},{"type":"verse","number":1,"content":[{"text":"हे समस्त पृथ्वी, याहवेहसाठी जयघोष कर.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"आनंदाने याहवेहची आराधना करा;","poem":2},{"lineBreak":true},{"text":"हर्षगीतांसह त्यांच्या उपस्थितीत प्रवेश करा.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"याहवेह हेच परमेश्वर आहेत, हे जाणून घ्या.","poem":1},{"text":"ते आपले निर्माणकर्ते आहेत व तेच आपले स्वामी आहेत;","poem":2},{"noteId":54},{"lineBreak":true},{"text":"आपण त्यांचे लोक, त्यांच्या कुरणातील मेंढराप्रमाणे आहोत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"उपकारस्तुती करीत त्यांच्या द्वारातून आत जा;","poem":1},{"text":"स्तुती करीत त्यांच्या अंगणात प्रवेश करा;","poem":2},{"lineBreak":true},{"text":"त्यांचे उपकार माना, त्यांच्या नावाला महिमा द्या.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"कारण याहवेह चांगले आहेत आणि त्यांची प्रीती सनातन आहे;","poem":1},{"text":"त्यांचा विश्वासूपणा पिढ्यान् पिढ्या टिकून राहतो.","poem":2}]}],"footnotes":[{"noteId":54,"caller":"+","text":"किंवा आम्ही त्यांच्या मालकीचे आहोत","reference":{"chapter":100,"verse":3}}]},"thisChapterLink":"/api/mar_cbi/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}