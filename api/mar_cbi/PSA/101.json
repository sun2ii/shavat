{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["दावीदाची रचना. एक स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"हे याहवेह, तुमची प्रीती आणि न्याय याविषयी मी गीत गाईन;","poem":1},{"text":"मी तुमची स्तुतिस्तोत्रे गाईन.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"सुज्ञपणाने जीवन जगणे हे माझे लक्ष्य आहे—","poem":1},{"text":"तुम्ही माझ्याकडे कधी येणार?","poem":2},{"lineBreak":true},{"text":"माझ्या घरातील माझा व्यवहार","poem":1},{"text":"मी निष्कलंक तर्‍हेने करेन.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"मी कुठल्याच अनुचित वस्तूकडे","poem":1},{"text":"नजर टाकणार नाही.","poem":2},{"lineBreak":true},{"text":"मला विश्वासहीन लोकांच्या व्यवहारांचा तिरस्कार आहे.","poem":1},{"text":"त्यांच्यापासून मी अलिप्त राहीन.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"कुटिल हृदय माझ्यापासून दूर राहील;","poem":1},{"text":"अनीतीच्या कुठल्याच गोष्टीशी मी संबंध ठेवणार नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"आपल्या शेजार्‍यांची गुप्तपणे निंदानालस्ती करणार्‍यास,","poem":1},{"text":"मी नष्ट करेन;","poem":2},{"text":"दुसर्‍यांकडे तुच्छतेने पाहणार्‍याचा व अहंकारी हृदयाच्या मनुष्याचा","poem":1},{"text":"सहवास मला असह्य वाटेल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"देशातील निष्ठावान लोकांवर मी माझी दृष्टी लावेन,","poem":1},{"text":"जेणेकरून ते माझ्या सहवासात राहतील;","poem":2},{"text":"ज्यांचे आचरण दोषरहित असेल,","poem":1},{"text":"असेच लोक माझी सेवा करतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"परंतु जे इतरांची फसवणूक करतात,","poem":1},{"text":"अशांना मी माझ्या घरात राहू देणार नाही,","poem":2},{"text":"आणि जे असत्य बोलतात,","poem":1},{"text":"ते माझ्यापुढे उपस्थित राहणार नाहीत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"दररोज सकाळी","poem":1},{"text":"मी आपल्या राज्यातील दुर्जनांना नष्ट करेन;","poem":2},{"text":"याहवेह देवाच्या या नगरीतील","poem":1},{"text":"प्रत्येक दुष्टाचा मी नायनाट करेन.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}