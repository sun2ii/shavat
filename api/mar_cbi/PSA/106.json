{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":106,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेहची स्तुती असो!","poem":1},{"lineBreak":true},{"text":"याहवेहचे उपकारस्मरण करा, कारण ते चांगले आहेत;","poem":1},{"text":"त्यांची प्रीती अनंतकाळची आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"याहवेहची सर्व गौरवशाली कृत्ये,","poem":1},{"text":"किंवा त्यांची स्तुती पूर्णपणे कोण जाहीर करेल?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जे इतरांशी न्यायाने वागतात,","poem":1},{"text":"आणि नेहमीच नीतीने आचरण करतात, ते आशीर्वादित असतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"हे याहवेह, जेव्हा तुमच्या प्रजेवर कृपादृष्टी कराल, तेव्हा माझेही स्मरण करा,","poem":1},{"text":"त्यांचे तारण कराल, तेव्हा मलाही मदत करा.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"म्हणजे तुम्ही निवडलेल्यांच्या समृद्धीत मलाही वाटा मिळेल,","poem":1},{"text":"आणि तुमच्या राष्ट्रांच्या सर्व आनंदामध्ये मीही सहभागी होईन,","poem":2},{"lineBreak":true},{"text":"आणि तुमच्या वारसांसह मी देखील तुमचे स्तुतिगान करेन.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"आम्ही आमच्या पूर्वजांप्रमाणे पाप केले;","poem":1},{"text":"आम्ही अपराध केला आणि दुष्टतेने वागलो.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"जेव्हा ते इजिप्तमध्ये होते,","poem":1},{"text":"तेव्हा तुम्ही केलेल्या अद्भुत चमत्कारांकडे त्यांनी लक्ष दिले नाही;","poem":2},{"text":"तुम्ही केलेली अनेक दयाळूपणाची कृत्ये ते विसरले;","poem":1},{"text":"उलट, तांबड्या समुद्राकाठी त्यांनी तुमच्याविरुद्ध बंड केले.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तरीसुद्धा आपल्या नामासाठी,","poem":1},{"text":"आपले सामर्थ्य प्रगट करण्यासाठी परमेश्वराने त्यांचे तारण केले.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तांबड्या समुद्राला दरडावताच तो कोरडा झाला;","poem":1},{"text":"वाळवंटातून चालत असल्यासारखे त्यांना खोल समुद्रातून चालविले.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"त्यांना त्यांच्या शत्रूपासून सोडविले;","poem":1},{"text":"शत्रूंच्या अधिकारातून त्यांची सुटका केली.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"त्यांच्या शत्रूंना जलसमाधी मिळाली;","poem":1},{"text":"त्यापैकी एकजणही वाचला नाही.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"तेव्हा लोकांनी त्यांच्या वचनांवर विश्वास ठेवला,","poem":1},{"text":"व त्यांचे स्तुतिगान केले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"परंतु त्यांनी केलेले कार्य ते लवकर विसरले,","poem":1},{"text":"त्यांनी केलेली योजना पूर्ण होण्याची त्यांनी वाट पाहिली नाही.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ओसाड भूमीत त्यांनी आपल्या उत्कट इच्छांना मोकळी वाट करून दिली;","poem":1},{"text":"वाळवंटात परमेश्वराची परीक्षा पाहिली.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"परमेश्वराने त्यांच्या मागण्या पुरविल्या,","poem":1},{"text":"परंतु जीव झुरणीस लावणारा रोगही त्यांच्याकडे पाठविला.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"तंबूत असताना मोशे आणि याहवेहचा अभिषिक्त अहरोन","poem":1},{"text":"यांच्या विरुद्धही त्यांचा हेवा वाढला.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"मग पृथ्वी उघडली आणि तिने दाथानाला गिळून टाकले;","poem":1},{"text":"अबीराम व त्याच्या समुहाला दफन केले.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"आणि त्यांच्या अनुयायांवर अग्निपात झाला;","poem":1},{"text":"दुष्ट माणसांना भस्म करण्यात आले.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"होरेब येथे त्यांनी एका वासराची मूर्ती घडविली,","poem":1},{"text":"आणि त्या धातूच्या मूर्तीची आराधना केली.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"परमेश्वराच्या गौरवाची अदलाबदल","poem":1},{"text":"गवत खाणार्‍या बैलाच्या प्रतिमेशी केली.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"त्या परमेश्वराला ते विसरले, ज्यांनी त्यांना सोडविले,","poem":1},{"text":"इजिप्त देशात महान चमत्कार केले,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"हामच्या भूमीत आश्चर्यकर्म केले,","poem":1},{"text":"आणि तांबड्या समुद्राकाठी चमत्कार केले.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"मग ते म्हणाले की ते त्यांचा नाश करतील—","poem":1},{"text":"जर खुद्द त्यांनी निवडलेला पुरुष मोशे, मध्ये उभा राहिला नसता तर,","poem":2},{"text":"त्यांनी आपला क्रोध न आवरता","poem":1},{"text":"त्या लोकांचा नाश केला असता.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"वचनदत्त देशास त्या लोकांनी तुच्छ लेखले;","poem":1},{"text":"त्यांनी दिलेल्या अभिवचनांवर त्यांचा विश्वास नव्हता.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"त्यांनी आपल्या तंबूत कुरकुर केली,","poem":1},{"text":"आणि याहवेहची आज्ञा झिडकारली.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"तेव्हा परमेश्वराने आपले हात उंचावून शपथ घेतली,","poem":1},{"text":"की या रानात ते त्यांना नष्ट करतील.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"त्यांच्या वंशजांना दूरदूरच्या राष्ट्रात पाठवतील,","poem":1},{"text":"आणि समस्त पृथ्वीवर त्यांना विखरून टाकतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"त्यांनी बआल-पौराची पूजा-अर्चना केली","poem":1},{"text":"आणि निर्जीव दैवताला यज्ञ अर्पिले.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"या सर्व दुष्टकर्मांनी त्यांनी याहवेहला क्रुद्ध केले,","poem":1},{"text":"म्हणून त्यांच्यामध्ये मरी पसरली.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"तेव्हा फिनहास मध्यस्थ म्हणून उभा राहिला,","poem":1},{"text":"आणि मग मरी थांबली.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"फिनहासाच्या या चांगल्या कृत्यामुळे","poem":1},{"text":"त्याची पिढ्यान् पिढ्या सर्वकाळ नीतिमानात गणना होईल.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"मरीबाह जलाशयाजवळ देखील त्यांनी याहवेहला राग आणला,","poem":1},{"text":"आणि त्यांच्यामुळेच मोशेवर संकट आले;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"परमेश्वराच्या आत्म्याविरुद्ध त्यांनी बंडखोरी केली,","poem":1},{"text":"आणि मोशे संतापला व अविचारीपणाने बोलला.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"याहवेहनी तशी आज्ञा केली असूनही,","poem":1},{"text":"त्यांनी इतर राष्ट्रातील लोकांचा नाश केला नाही.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"उलट ते अन्य राष्ट्रात मिसळले,","poem":1},{"text":"आणि त्यांच्या प्रथा आत्मसात केल्या.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"त्यांनी त्यांच्या मूर्तींची आराधना केली,","poem":1},{"text":"त्यामुळे ते पाशात अडकले.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"त्यांनी आपल्या लहान मुलामुलींनाही त्या","poem":1},{"text":"खोट्या दैवतांना अर्पण केले.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"निष्पाप मुलामुलींचे नरबळी दिले,","poem":1},{"text":"कनानाच्या मूर्तींना अर्पणे वाहिली,","poem":2},{"text":"आणि त्यांचे रक्त सांडून","poem":1},{"text":"त्यांनी ती भूमी अपवित्र केली.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"आपल्याच कर्मानी ते भ्रष्ट झाले;","poem":1},{"text":"आणि त्यांचे कृत्य व्यभिचारी ठरले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"आणि म्हणून याहवेहचा क्रोध आपल्या लोकांविरुद्ध भडकला","poem":1},{"text":"आणि त्यांना त्यांच्या वारसांची घृणा आली.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"त्यांनी त्यांना परराष्ट्रांच्या अधीन केले,","poem":1},{"text":"त्यांचे शत्रू त्यांच्यावर राज्य करू लागले.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"त्यांच्या शत्रूंनी त्यांना चिरडले","poem":1},{"text":"आणि त्यांच्या शक्ती समोर त्यांना समर्पण करावे लागले.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"बरेचदा परमेश्वराने त्यांना सोडविले,","poem":1},{"text":"तरी त्यांच्याविरुद्ध ते बंडखोरी करीत राहिले","poem":2},{"lineBreak":true},{"text":"आणि शेवटी त्यांच्याच पापामुळे ते नाश पावले.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"असे असतानाही परमेश्वराने त्यांच्या यातनांची दखल घेतली","poem":1},{"text":"आणि त्यांचा आक्रोश ऐकला;","poem":2}]},{"type":"verse","number":45,"content":[{"text":"त्यांच्याकरिता त्यांनी आपल्या कराराचे स्मरण केले,","poem":1},{"text":"आणि त्यांच्या महान प्रीतीमुळे त्यांचे अंतःकरण द्रवले.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"त्यांना बंदिवासात नेलेल्या शत्रूंच्या मनात","poem":1},{"text":"त्यांच्याकरिता कृपा उत्पन्न केली.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"हे याहवेह, आमच्या परमेश्वरा, आम्हाला मुक्त करा;","poem":1},{"text":"आम्हाला राष्ट्रांतून एकवटून घ्या,","poem":2},{"text":"जेणेकरून आम्ही तुमचे पवित्र नाव धन्यवादित करून,","poem":1},{"text":"तुमच्या स्तवनात गौरव मानावे.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"इस्राएलचे परमेश्वर याहवेहची,","poem":1},{"text":"अनादिकालापासून अनंतकालापर्यंत स्तुती होवो.","poem":2},{"lineBreak":true},{"text":"सर्व लोकांनी म्हणावे “आमेन!”","poem":1},{"lineBreak":true},{"text":"याहवेहची स्तुती होवो.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}