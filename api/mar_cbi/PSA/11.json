{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी; दावीदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"मी याहवेहचा आश्रय घेतला आहे.","poem":1},{"text":"तर मग तुम्ही मला असे का म्हणत आहात:","poem":2},{"lineBreak":true},{"text":"“पक्ष्याप्रमाणे तू आपल्या डोंगराकडे उडून जा,”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"कारण पाहा, दुष्टांनी आपली धनुष्ये वाकविली आहेत,","poem":1},{"text":"त्यावर आपले बाण चढविले आहेत","poem":2},{"text":"की अंधारातून बाण मारून","poem":1},{"text":"सरळ मनाच्या लोकांची हत्या करावी.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जर पायाच नष्ट झाला,","poem":1},{"text":"तर नीतिमान काय करणार?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"परंतु याहवेह आपल्या पवित्र मंदिरात आहेत;","poem":1},{"text":"याहवेह आपल्या स्वर्गीय सिंहासनावर विराजमान आहेत.","poem":2},{"text":"त्यांची दृष्टी सर्व मनुष्यास पाहते;","poem":1},{"text":"पृथ्वीवर प्रत्येकास ते पारखतात.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"याहवेह नीतिमानाला पारखतात;","poem":1},{"text":"परंतु दुष्ट, ज्यांना हिंसा प्रिय आहे,","poem":2},{"lineBreak":true},{"text":"अशांचा याहवेह आवेशाने द्वेष करतात.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"जळते निखारे आणि तप्त गंधकाचा पाऊस ते दुष्टांवर पाडतील;","poem":1},{"text":"आपल्या दाहक वार्‍याने","poem":2},{"lineBreak":true},{"text":"त्यांना होरपळून टाकतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"कारण याहवेह नीतिमान आहेत,","poem":1},{"text":"न्यायीपण त्यांना प्रिय आहे;","poem":2},{"lineBreak":true},{"text":"जे नीतिमान आहेत, त्यांना त्यांचे दर्शन होईल.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}