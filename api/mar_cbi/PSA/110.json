{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["दावीदाची रचना. एक स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"याहवेह माझ्या प्रभूला म्हणाले:","poem":1},{"lineBreak":true},{"text":"“मी तुझ्या शत्रूंना","poem":1},{"text":"तुझ्या पायाखाली ठेवीपर्यंत,","poem":2},{"lineBreak":true},{"text":"तू माझ्या उजव्या हाताला बसून राहा.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"याहवेहच सीयोनातून तुझ्या सामर्थ्यवान राजदंडाचा विस्तार करतील व म्हणतील,","poem":1},{"text":"“तू तुझ्या शत्रूंवर सत्ता गाजव!”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तुझी सेना युद्ध समयी","poem":1},{"text":"स्वेच्छेने तुला साथ देईल.","poem":2},{"text":"प्रातःकाळाच्या गर्भातून जन्मलेल्या दवाप्रमाणे","poem":1},{"text":"पवित्रतेने सुशोभित होऊन","poem":2},{"lineBreak":true},{"text":"तुझे तरुण तुझ्याकडे येतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"याहवेहने जी शपथ घेतली आहे","poem":1},{"text":"आणि ते त्यांचे मन कदापि बदलणार नाहीत:","poem":2},{"text":"“मलकीसदेकाच्या संप्रदायाप्रमाणे","poem":1},{"text":"तू सदासर्वकाळचा याजक आहेस.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"तुझ्या उजव्या हाताशी प्रभूचे सानिध्य आहे;","poem":1},{"text":"आपल्या क्रोधाच्या दिवशी ते अनेक राजांना तुडवतील.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ते राष्ट्रांवर आपला यथार्थ निकाल घोषित करतील,","poem":1},{"text":"मृतदेहांचा ढीग लागेल आणि ते संपूर्ण पृथ्वीच्या शासकांना चिरडून टाकतील.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तेव्हा प्रभू वाटेवरील ओहोळातील पाणी पितील,","poem":1},{"text":"आणि आपले मस्तक उंचावतील.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}