{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेहचे स्तवन करा.","poem":1},{"lineBreak":true},{"text":"याहवेहचे भय बाळगणारे,","poem":1},{"text":"आणि त्यांच्या आज्ञापालनामध्ये आनंद मानणारे आशीर्वादित आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"त्यांची संतती पृथ्वीवर अतिथोर होईल;","poem":1},{"text":"नीतिमानाची पिढी आशीर्वादित होईल.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"संपत्ती व समृद्धी त्यांच्या घरात वास करतील,","poem":1},{"text":"आणि त्यांची धार्मिकता चिरकाल टिकून राहील.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"सात्विकासाठी अंधकारातही प्रकाश उदय पावतो;","poem":1},{"text":"ते कृपावान, दयाळू व नीतिमान असतात.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ज्यांचे अंतःकरण उदार असून ते मुक्तपणे उसने देतात त्यांचे भले होते,","poem":1},{"text":"जे आपला व्यवहार न्यायाने करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"निश्चितच, नीतिमान कधीही पथभ्रष्ट होणार नाही;","poem":1},{"text":"त्यांना सर्वकाळ स्मरणात ठेवले जाईल.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"वाईट बातमी त्यांना भयभीत करणार नाही;","poem":1},{"text":"याहवेहवर पूर्ण भरवसा असल्याने त्यांचे मन स्थिर असते.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"यामुळेच त्यांचे अंतःकरण सुरक्षित असते, ते भयग्रस्त होत नाहीत;","poem":1},{"text":"शेवटी तेच आपल्या शत्रूंवर विजयान्वित दृष्टी टाकतील.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"गरजवंतांना ते उदारहस्ते दानधर्म करतात,","poem":1},{"text":"त्यांची नीतिमत्ता चिरकाळ टिकते;","poem":2},{"lineBreak":true},{"text":"गौरवाने त्यांचे शिंग","poem":2},{"noteId":56},{"text":"उंचावले जाईल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"दुष्ट मनाची माणसे हे सर्व पाहून क्रुद्ध होतील;","poem":1},{"text":"ती संतापाने दातओठ खातील व दुर्बल होतील,","poem":2},{"lineBreak":true},{"text":"आणि त्यांच्या सर्व अभिलाषा नष्ट होतील.","poem":2}]}],"footnotes":[{"noteId":56,"caller":"+","text":"शिंग या ठिकाणी मान","reference":{"chapter":112,"verse":9}}]},"thisChapterLink":"/api/mar_cbi/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}