{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेहचे स्तवन करा.","poem":1},{"lineBreak":true},{"text":"हे याहवेहच्या सेवकांनो, याहवेहचे स्तवन करा;","poem":1},{"text":"याहवेहच्या नावाची स्तुती करा.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"याहवेहच्या नामाचे स्तवन होत राहो,","poem":1},{"text":"आता आणि सदासर्वकाळ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"सूर्योदयापासून सूर्यास्तापर्यंत,","poem":1},{"text":"याहवेहच्या नामाचे स्तवन होवो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"याहवेह सर्व राष्ट्रांहून उच्च आहेत;","poem":1},{"text":"त्यांचे गौरव गगनमंडळाहून उंच आहे.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"आमचे परमेश्वर याहवेह, यांच्या समान कोण आहे,","poem":1},{"text":"जे सर्वोच्च स्थानी सिंहासनावर विराजमान असतात,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"जे वरून ओणवून,","poem":1},{"text":"गगनमंडळ आणि पृथ्वीचे अवलोकन करतात?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ते दीनांस धुळीतून वर काढतात,","poem":1},{"text":"आणि गरजवंतास राखेच्या ढिगार्‍यातून वर उचलून घेतात;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ते त्यांना राजपुत्रांबरोबर,","poem":1},{"text":"आपल्या प्रजेच्या प्रधानांसह बसवितात.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ते निपुत्रिक गृहिणीला तिच्या घरात स्थिरावतात,","poem":1},{"text":"आणि तिला मुले देऊन आनंदी माता बनवितात.","poem":2},{"lineBreak":true},{"text":"याहवेहचे स्तवन करा.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}