{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"जेव्हा इस्राएल इजिप्तमधून,","poem":1},{"text":"परकीय भाषेच्या लोकातून याकोब बाहेर पडला,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"यहूदाह परमेश्वराचे पवित्रस्थान,","poem":1},{"text":"आणि इस्राएल त्यांचे सार्वभौमत्व झाले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"तांबड्या समुद्राने हे पाहून पळ काढला,","poem":1},{"text":"आणि यार्देन नदी माघारी गेली;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"पर्वतांनी मेंढ्यांप्रमाणे आणि टेकड्यांनी कोकरांसारख्या","poem":1},{"text":"उड्या मारल्या.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"हे समुद्रा, तू पलायन का केले?","poem":1},{"text":"अगे यार्देने, तू मागे का फिरलीस?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"पर्वतांनो, तुम्ही मेंढ्यांप्रमाणे,","poem":1},{"text":"टेकड्यांनो, तुम्ही कोकरांसारखे का बागडलात?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"अगे पृथ्वी, तू परमेश्वराच्या समक्षतेत,","poem":1},{"text":"याकोबाच्या देवासमोर, थरथर काप.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"कारण त्यांनीच खडकाचे झर्‍यात रूपांतर केले,","poem":1},{"text":"अत्यंत कणखर खडकास जलाचे स्त्रोत बनविले.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}