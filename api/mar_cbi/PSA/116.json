{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"मी याहवेहवर प्रीती करतो, कारण त्यांनी माझी वाणी ऐकली;","poem":1},{"text":"माझी दयेची विनवणी ऐकली.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"कारण त्यांनी आपला कान माझ्या हाकेकडे लावला,","poem":1},{"text":"म्हणून आजीवन मी त्यांचा धावा करीत राहीन.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"मृत्यूच्या बंधनांनी मला वेष्टिले होते;","poem":1},{"text":"कबरेच्या भयाने मला ग्रासले,","poem":2},{"lineBreak":true},{"text":"दुःख व क्लेशांनी माझ्यावर मात केली होती.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तेव्हा मी याहवेहचा धावा करून म्हणालो:","poem":1},{"text":"“हे याहवेह, मला वाचवा!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"याहवेह कृपाळू आणि नीतिमान आहेत;","poem":1},{"text":"आपले परमेश्वर करुणामय आहेत.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"याहवेह साध्याभोळ्या लोकांचे रक्षण करतात;","poem":1},{"text":"मी गर्तेत ओढला गेलो असताना, त्यांनी मला वाचविले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"हे माझ्या जिवा, पुन्हा एकदा शांतचित्त हो,","poem":1},{"text":"कारण याहवेहने तुझे भले केले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"कारण हे याहवेह, तुम्ही मला मृत्यूपासून सोडविले,","poem":1},{"text":"माझे डोळे अश्रूंपासून","poem":2},{"lineBreak":true},{"text":"आणि माझे पाय अडखळण्यापासून रक्षिले आहेत.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"जेणेकरून मी जिवंत लोकांमध्ये राहून,","poem":1},{"text":"याहवेहच्या समक्षतेत चालू शकेन.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"जेव्हा मी याहवेहवर विश्वास ठेवला तेव्हा मी बोललो,","poem":1},{"text":"“मी फार पीडित आहे;”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"घोर निराशेच्या भरात मी म्हणालो,","poem":1},{"text":"“प्रत्येक मनुष्य लबाड आहे.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"परंतु याहवेहचे माझ्यावरील सर्व उपकार,","poem":1},{"text":"मी कसे फेडणार?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"मी तारणाचा प्याला उंच करून,","poem":1},{"text":"याहवेहच्या नावाचा धावा करेन.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"मी याहवेहस केलेले नवस","poem":1},{"text":"त्यांच्या सर्व लोकांसमक्ष जाहीर रीतीने फेडीन.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"याहवेहच्या दृष्टीने,","poem":1},{"text":"त्यांच्या निष्ठावानांचा मृत्यू अतिशय मोलवान आहे.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"हे याहवेह, मी निश्चितच तुमचा सेवक आहे;","poem":1},{"text":"माझ्या मातेसमान मी देखील तुमची सेवा करेन;","poem":2},{"lineBreak":true},{"text":"मला तुम्ही बंधन मुक्त केले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"मी तुम्हाला उपकारस्तुतीचे अर्पण करेन,","poem":1},{"text":"आणि याहवेहच्या नामाचा धावा करेन.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"मी याहवेहस केलेले नवस","poem":1},{"text":"त्यांच्या सर्व लोकांसमक्ष जाहीर रीतीने फेडीन.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"यरुशलेमात, तुमच्यासमक्ष","poem":1},{"text":"याहवेहच्या या मंदिराच्या अंगणात ते पूर्ण करेन.","poem":2},{"lineBreak":true},{"text":"याहवेहचे स्तवन करा.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}