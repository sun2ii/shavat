{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":118,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेहचे उपकारस्मरण करा,","poem":1},{"text":"कारण ते फार चांगले आहेत; त्यांची प्रीती अनंतकाळची आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"इस्राएलने म्हणावे:","poem":1},{"text":"“त्यांची प्रीती अनंतकाळची आहे.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"अहरोनाच्या वंशजांनी म्हणावे:","poem":1},{"text":"“त्यांची प्रीती अनंतकाळची आहे.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"याहवेहचे भय धरणारे म्हणोत,","poem":1},{"text":"“त्यांची प्रीती अनंतकाळची आहे.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"संकटात असताना मी याहवेहचा धावा केला;","poem":1},{"text":"ते मला एका विशाल स्थळी घेऊन आले.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"याहवेह माझ्यासोबत आहेत, मला कशाचेही भय वाटणार नाही;","poem":1},{"text":"नश्वर मानव मला काय करणार?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"याहवेह माझ्यासोबत आहेत; ते माझे सहायक आहेत.","poem":1},{"text":"मी माझ्या शत्रूकडे विजयान्वित दृष्टीने बघेन.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"नश्वर मानवावर भरवसा ठेवण्यापेक्षा,","poem":1},{"text":"याहवेहचा आश्रय घेणे उत्तम आहे.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"अधिपतींवर भरवसा ठेवण्यापेक्षा,","poem":1},{"text":"याहवेहचा आश्रय घेणे उत्तम आहे.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"सर्व राष्ट्रांनी मला वेढा घातला,","poem":1},{"text":"परंतु याहवेहच्या नावाने मी त्यांचा नाश केला.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"त्यांनी सर्व बाजूने मला वेढा घातला,","poem":1},{"text":"परंतु याहवेहच्या नावाने मी त्यांचा नायनाट केला.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"मधमाश्यांप्रमाणे ते माझ्याभोवती घोंगावत होते,","poem":1},{"text":"पण जळत्या काटेरी झुडूपांसारखे ते लगेच जळून खाक झाले;","poem":2},{"lineBreak":true},{"text":"याहवेहच्या नावाने मी त्यांचा नाश केला.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"त्यांनी मला असे ढकलले की मी मागे पडलो असतो,","poem":1},{"text":"परंतु याहवेहने मला साहाय्य केले.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"याहवेह माझे सामर्थ्य आणि माझे संरक्षण","poem":1},{"noteId":57},{"text":"आहेत;","poem":1},{"text":"तेच माझे तारण झाले आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"नीतिमान लोकांच्या घरातून","poem":1},{"text":"आनंदाच्या व विजयाच्या गीतांचे प्रतिध्वनी ऐकू येत आहेत:","poem":2},{"text":"“याहवेहच्या उजव्या भुजाने सामर्थ्यवान कृत्ये केली आहेत!","poem":1}]},{"type":"verse","number":16,"content":[{"text":"याहवेहचा उजवा हात उंचावलेला आहे;","poem":2},{"lineBreak":true},{"text":"याहवेहच्या उजव्या भुजेने सामर्थ्यवान कृत्ये केली आहेत!”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"मी मरणार नाही तर जगेन,","poem":1},{"text":"आणि याहवेहची कृत्ये विदित करेन.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"याहवेहने मला कठोर शिक्षा केली,","poem":1},{"text":"परंतु त्यांनी मला मृत्यूच्या हवाली केले नाही.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"माझ्यासाठी नीतिमत्वाची दारे उघडू द्या;","poem":1},{"text":"मी आत प्रवेश करून याहवेहचे उपकारस्मरण करेन.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"याहवेहची दारे हीच आहेत;","poem":1},{"text":"याच दारातून नीतिमान प्रवेश करतात.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"मी तुम्हाला धन्यवाद देईन, कारण तुम्ही माझ्या प्रार्थनेचे उत्तर दिले;","poem":1},{"text":"तुम्ही माझे तारण झाला आहात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"जो दगड बांधणार्‍यांनी नापसंत केला,","poem":1},{"text":"तोच आता कोनशिला झाला आहे;","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ही याहवेहची करणी आहे,","poem":1},{"text":"आणि आमच्या दृष्टीने ती अद्भुत आहे.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"याहवेहने आज हे केले आहे;","poem":1},{"text":"आजच आपण आनंद व उल्लास करू.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"याहवेह, आमचे तारण करा!","poem":1},{"text":"याहवेह, आम्हाला यशस्वी करा!","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"याहवेहच्या नावाने येणारे धन्यवादित असो.","poem":1},{"text":"आम्ही याहवेहच्या मंदिरातून तुम्हाला आशीर्वाद देतो.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"याहवेहच परमेश्वर आहेत;","poem":1},{"text":"त्यांनी त्यांचा प्रकाश आमच्यावर टाकला आहे.","poem":2},{"text":"डहाळ्या हातात घेऊन वेदीच्या शिंगापर्यंत जाण्यासाठी","poem":1},{"noteId":58},{"text":"मिरवणुकीत सामील व्हा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"तुम्हीच माझे परमेश्वर आहात आणि मी तुमचे स्तवन करेन;","poem":1},{"text":"तुम्हीच माझे परमेश्वर आहात, मी तुमचे स्तुतिगान करेन.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"याहवेहचे उपकारस्मरण करा,","poem":1},{"text":"कारण ते फार चांगले आहेत; त्यांची प्रीती अनंतकाळची आहे.","poem":2}]}],"footnotes":[{"noteId":57,"caller":"+","text":"किंवा गीत","reference":{"chapter":118,"verse":14}},{"noteId":58,"caller":"+","text":"किंवा यज्ञ दोरीने बांधून घेऊन जा","reference":{"chapter":118,"verse":27}}]},"thisChapterLink":"/api/mar_cbi/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}