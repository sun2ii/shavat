{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी; शमीनीथ वर आधारित दावीदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"याहवेह, साहाय्य करा, भक्तिमान नाहीसे होत आहेत;","poem":1},{"text":"विश्वासयोग्य लोक आता मनुष्यांमध्ये राहिलेले नाहीत.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"प्रत्येकजण त्यांच्या शेजार्‍यांशी लबाड बोलतो,","poem":1},{"text":"ते त्यांच्या ओठांनी खुशामत करतात","poem":2},{"lineBreak":true},{"text":"परंतु त्यांच्या हृदयात कपट असते.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"खुशामत करणारे सर्व ओठ,","poem":1},{"text":"आणि प्रत्येक गर्विष्ठ जीभ याहवेह कापून टाको.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ते बढाई मारतात आणि म्हणतात,","poem":1},{"text":"“आम्ही आमच्या जिभेने प्रबल होऊ; आमचे ओठ आमचे संरक्षण करतील,","poem":2},{"lineBreak":true},{"text":"आम्हावर धनी कोण?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"याहवेह म्हणतात, “कारण गरिबांना लुटले आहे व गरजवंत कण्हत आहेत.","poem":1},{"text":"म्हणून मी आता उठेन आणि","poem":2},{"lineBreak":true},{"text":"त्यांची निंदा करणाऱ्यापासून त्यांना संरक्षण देईन.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"शुद्ध केलेल्या चांदीप्रमाणे,","poem":1},{"text":"सात वेळेस शुद्ध केलेल्या सोन्याप्रमाणे,","poem":2},{"lineBreak":true},{"text":"याहवेहची वचने शुद्ध आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"जेव्हा मनुष्याच्या दुष्टपणाचा आदर केला जातो,","poem":1},{"text":"आणि दुष्ट सर्वत्र अहंकाराने फिरत असतात.","poem":2},{"text":"याहवेह, तेव्हा तुम्हीच गरजवंताचे रक्षण करणार","poem":1},{"text":"आणि तुम्हीच त्यांना या दुष्टापासून सुरक्षित ठेवाल.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":7}