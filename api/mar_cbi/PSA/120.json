e","number":6,"content":[{"text":"जे शांतिप्रिय नाहीत अशा लोकांसह राहण्यात","poem":1},{"text":"मी बराच काळ घालविला आहे.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"मी तर शांतताप्रिय आहे;","poem":1},{"text":"पण मी काही बोलताच ते युद्धास तयार होतात.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}