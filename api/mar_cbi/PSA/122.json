{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["प्रवाशांचे आराधना गीत. दावीदाची रचना."]},{"type":"verse","number":1,"content":[{"text":"मी हर्षित झालो, जेव्हा ते मला म्हणाले,","poem":1},{"text":"“चला आपण याहवेहच्या मंदिरात जाऊ.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"अगे यरुशलेमे, आम्ही आता आपले पाऊल","poem":1},{"text":"तुझ्या वेशीच्या आत ठेवले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"यरुशलेम नगरी अशी बांधलेली आहे,","poem":1},{"text":"जशी एखादी सुसंबद्धपणे रचलेली नगरी.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"हेच ते स्थान आहे जिथे इस्राएलास दिलेल्या नियमाप्रमाणे सर्व कुळे—","poem":1},{"text":"याहवेहची कुळे—","poem":2},{"text":"याहवेहची उपकारस्तुती करण्यास","poem":1},{"text":"येथे जमत आहेत.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"इथेच न्याय-सिंहासन, दावीदाच्या वंशाचे","poem":1},{"text":"सिंहासन स्थापित केले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"यरुशलेमवरील शांतीसाठी प्रार्थना करा की","poem":1},{"text":"या नगरीवर प्रीती करणार्‍या सर्वांची सुरक्षा होवो.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तुझ्या तटांच्या आत शांती नांदो;","poem":1},{"text":"तुझ्या राजवाड्यामध्ये सुरक्षितता राहो.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"जे माझे कुटुंब व माझे स्नेही येथे राहतात, त्यांच्यासाठी मी मागतो,","poem":1},{"text":"“तुझ्यामध्ये शांती नांदो.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"आपले परमेश्वर याहवेह, यांच्या मंदिराप्रीत्यर्थ,","poem":1},{"text":"तुझा उत्कर्ष व्हावा, अशी अभिलाषा करेन.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}