{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":123,"content":[{"type":"hebrew_subtitle","content":["प्रवाशांचे आराधना गीत."]},{"type":"verse","number":1,"content":[{"text":"मी माझी दृष्टी वर, तुमच्याकडे लावतो,","poem":1},{"text":"तुम्ही जे स्वर्गात राजासनारूढ आहात.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"जसा एखादा दास आपली दृष्टी आपल्या धन्याच्या हाताकडे लावतो,","poem":1},{"text":"किंवा एखादी दासी आपल्या धनिणीच्या हाताकडे नजर लावते,","poem":2},{"text":"तसेच दया आणि कृपा प्राप्त व्हावी म्हणून,","poem":1},{"text":"आमची दृष्टी आमचे परमेश्वर याहवेहकडे लागलेली असते.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"आम्हावर दया करा, हे याहवेह, आम्हावर दया करा,","poem":1},{"text":"कारण आम्ही पुष्कळ तिरस्कार सहन केला आहे.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"उन्मत्त लोकांचा घोर उपहास आम्ही सहन केला","poem":1},{"text":"आणि गर्विष्ठांच्या घोर घृणेचे","poem":2},{"lineBreak":true},{"text":"पात्र ठरलो आहे.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}