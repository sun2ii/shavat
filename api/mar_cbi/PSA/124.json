{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":124,"content":[{"type":"hebrew_subtitle","content":["प्रवाशांचे आराधना गीत. दावीदाची रचना."]},{"type":"verse","number":1,"content":[{"text":"सर्व इस्राएलने हे कबूल करावे की—","poem":1},{"text":"जर याहवेह आमच्या बाजूने नसते,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"जेव्हा मनुष्यांनी आमच्यावर आक्रमण केले होते,","poem":1},{"text":"जर याहवेह आमच्या बाजूने नसते,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तर त्यांचा संताप आमच्यावर भडकला असता.","poem":1},{"text":"तेव्हा त्या शत्रूंनी आम्हाला जिवंत गिळून टाकले असते;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"जलप्रलयात आम्ही बुडून गेलो असतो","poem":1},{"text":"व जलप्रवाहात आम्ही पार वाहून गेलो असतो,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"उचंबळलेल्या लाटांनी आम्हाला","poem":1},{"text":"गिळंकृत केले असते.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"याहवेह धन्यवादित असोत;","poem":1},{"text":"त्यांनी आम्हाला शत्रूंचे भक्ष्य होऊ दिले नाही.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"पारध्याच्या पाशातून पक्षी निसटावा,","poem":1},{"text":"त्याप्रमाणे आम्ही जिवानिशी निसटलो;","poem":2},{"text":"पाश तुटलेला आहे","poem":1},{"text":"आणि आम्ही मुक्त झालो आहोत.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"आमच्या साहाय्याचा उगम,","poem":1},{"text":"स्वर्ग व पृथ्वीचे निर्माणकर्ते परमेश्वर, याहवेह यांचे नाव आहे.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}