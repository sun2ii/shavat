{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":125,"content":[{"type":"hebrew_subtitle","content":["प्रवाशांचे आराधना गीत."]},{"type":"verse","number":1,"content":[{"text":"ज्यांचा याहवेहवर विश्वास आहे, ते सीयोन पर्वतासारखे स्थिर आहेत,","poem":1},{"text":"कारण ते कधीही ढळत नाहीत, तर सर्वकाळ टिकतात.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"यरुशलेमला वेष्टण करणारे पर्वत जसे तिचे रक्षण करतात,","poem":1},{"text":"तसेच आता आणि सदासर्वकाळ,","poem":2},{"lineBreak":true},{"text":"याहवेह आपल्या लोकांना वेष्टून त्यांचे रक्षण करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"नीतिमान लोकांना दिलेल्या वतनावर","poem":1},{"text":"दुष्टांचा राजदंड टिकून राहणार नाही,","poem":2},{"text":"नाहीतर नीतिमान लोकही","poem":1},{"text":"त्यांच्या हाताने दुष्टता करतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"हे याहवेह, जे नीतिमान आहेत,","poem":1},{"text":"ज्यांचे हृदय निष्ठावंत आहे, त्यांचे तुम्ही कल्याण करा.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"परंतु जे आपल्या कुटिल मार्गांकडे वळतात,","poem":1},{"text":"त्यास याहवेह दुष्कर्म्यांबरोबर घालवून देतील.","poem":2},{"lineBreak":true},{"text":"इस्राएलावर शांती असो.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}