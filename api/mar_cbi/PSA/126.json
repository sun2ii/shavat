 पेरणी करतात,","poem":1},{"text":"ते आनंदाने कापणी करतील.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"जे रडत पेरणीसाठी","poem":1},{"text":"बी घेऊन जातात,","poem":2},{"text":"ते आपल्या पेंढ्या घेऊन,","poem":1},{"text":"आनंदाने हर्षगीते गात परत येतील.","poem":2}]}],"footnotes":[{"noteId":60,"caller":"+","text":"किंवा जेव्हा इस्राएलला बंदिवासातून परत आणले","reference":{"chapter":126,"verse":1}},{"noteId":61,"caller":"+","text":"म्हणजे आमच्या बंदिवासांना परत आणा.","reference":{"chapter":126,"verse":4}}]},"thisChapterLink":"/api/mar_cbi/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}