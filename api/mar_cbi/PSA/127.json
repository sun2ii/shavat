{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["प्रवाशांचे एक आराधना गीत. शलोमोनाची रचना."]},{"type":"verse","number":1,"content":[{"text":"याहवेहने घर बांधले नाही,","poem":1},{"text":"तर बांधकाम करणार्‍यांचे श्रम व्यर्थ आहेत;","poem":2},{"text":"याहवेहने शहराचे रक्षण केले नाही,","poem":1},{"text":"तर पहारेकर्‍यांचे जागणे व्यर्थ आहे.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तुमचे पहाटे उठणे","poem":1},{"text":"आणि रात्री उशीरापर्यंत","poem":2},{"text":"अन्नप्राप्तीसाठी कष्ट करणे व्यर्थ आहे—","poem":1},{"text":"कारण आपल्या प्रियजनांस याहवेहच शांत झोप देतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"मुले, ही याहवेहकडून मिळालेला वारसा आहे,","poem":1},{"text":"प्रसवशील कूस, हे याहवेहकडून लाभणारे प्रतिफळ आहे.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तरुणपणी झालेली मुले,","poem":1},{"text":"शूरवीराच्या हातातील बाणांप्रमाणे आहेत.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ज्या पुरुषाचा भाता","poem":1},{"text":"अशा बाणांनी भरलेला आहे, तो धन्य!","poem":2},{"text":"असे पुरुष वेशीत आपल्या शत्रूशी न्यायालयात वाटाघाटी करतील,","poem":1},{"text":"तेव्हा ते लज्जित होणार नाहीत.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}