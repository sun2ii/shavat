{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":128,"content":[{"type":"hebrew_subtitle","content":["प्रवाशांचे आराधना गीत."]},{"type":"verse","number":1,"content":[{"text":"जे याहवेहचे भय बाळगतात,","poem":1},{"text":"आणि त्यांच्या आज्ञा पाळतात, ते धन्य!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तू आपल्या हातांनी केलेल्या श्रमाचे फळ खाशील;","poem":1},{"text":"तू सुखी होशील व तुझे कल्याण होईल.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तुझी पत्नी तुझ्या घरात","poem":1},{"text":"सफल द्राक्षवेलीसारखी होईल;","poem":2},{"text":"तुझी मुले तुझ्या मेजाभोवती","poem":1},{"text":"जैतुनाच्या रोपांसारखी होतील.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"होय, याहवेहचे भय बाळगून त्यांच्यावर विश्वास ठेवणार्‍यांना","poem":1},{"text":"हाच आशीर्वाद असणार.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"याहवेह सीयोनातून तुला आशीर्वादित करो;","poem":1},{"text":"तुझे आयुष्यभर","poem":2},{"lineBreak":true},{"text":"तू यरुशलेमची समृद्धी बघशील.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"नातवंडाचे सुख लाभेल इतके दीर्घ आयुष्य तुला मिळो—","poem":1},{"text":"इस्राएलास शांती लाभो.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}