{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":129,"content":[{"type":"hebrew_subtitle","content":["प्रवाशांचे आराधना गीत."]},{"type":"verse","number":1,"content":[{"text":"“माझ्या किशोरावस्थेपासून त्यांनी माझ्यावर घोर अत्याचार केला आहे,”","poem":1},{"text":"इस्राएल म्हणो;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“माझ्या किशोरावस्थेपासून माझ्यावर घोर अत्याचार करण्यात आला आहे,","poem":1},{"text":"तरीही त्यांना माझ्यावर विजय मिळविता आला नाही.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"शेतकर्‍याने नांगरल्याप्रमाणे","poem":1},{"text":"त्यांनी माझ्या पाठीवर लांब लांब तासे काढली.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"परंतु याहवेह न्यायी आहेत;","poem":1},{"text":"त्यांनी मला त्या दुष्टांच्या बंधनातून मुक्त केले.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"सीयोनाचा द्वेष करणारे सर्व","poem":1},{"text":"लाजिरवाणा पराजय होऊन परत जावोत.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"घरांच्या छपरावर उगविलेल्या गवतासारखे ते होवोत,","poem":1},{"text":"जे अर्धवट वाढल्याबरोबर सुकून पिवळे पडते;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"कापणार्‍यांच्या हातात काहीही पडत नाही,","poem":1},{"text":"की बांधणार्‍यांनाही पेंढ्या मिळत नाहीत.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"येणारे जाणारे लोक त्यांना असे न म्हणोत,","poem":1},{"text":"“याहवेहचे आशीर्वाद तुम्हावर येवोत;","poem":2},{"lineBreak":true},{"text":"आम्ही तुम्हाला याहवेहच्या नावाने आशीर्वाद देतो.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}