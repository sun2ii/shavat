{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी; दावीदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"याहवेह, आणखी किती काळ? सर्वकाळ तुम्ही मला विसरणार का?","poem":1},{"text":"किती काळ तुम्ही मजपासून तुमचे मुख लपविणार?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मी किती काळ माझ्या विचारांशी द्वंद करावे?","poem":1},{"text":"कुठवर दुःखाने रात्रंदिवस माझे हृदय व्यापून टाकावे?","poem":2},{"lineBreak":true},{"text":"कुठवर माझ्या शत्रूंनी मजवर वरचढ व्हावे?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"याहवेह, माझ्या परमेश्वरा, मजकडे पाहा आणि मला उत्तर द्या.","poem":1},{"text":"या अंधारात माझ्या डोळ्यांना प्रकाश द्या, नाहीतर मजवर चिरनिद्रा ओढवेल.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"माझे शत्रू म्हणतील “मी त्याला पराभूत केले आहे,”","poem":1},{"text":"आणि माझ्या पतनाबद्दल ते आनंदित होतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"कारण तुमच्या निरंतर प्रीतीवर मी भरवसा ठेवला आहे;","poem":1},{"text":"माझे हृदय तुमच्या तारणात हर्ष करीत आहे.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मी याहवेहची स्तुती गाईन,","poem":1},{"text":"कारण त्यांनी माझ्यावर उपकार केले आहेत.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}