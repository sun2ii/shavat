{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["प्रवाशांचे आराधना गीत."]},{"type":"verse","number":1,"content":[{"text":"याहवेह, खोल ठिकाणातून मी तुमचा धावा करीत आहे;","poem":1}]},{"type":"verse","number":2,"content":[{"text":"माझा धावा ऐका;","poem":2},{"text":"प्रभू, माझ्या कृपेच्या विनंतीकडे","poem":1},{"text":"तुमचे कान लागोत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"याहवेह, तुम्ही आमच्या पापांचा हिशोब ठेवला,","poem":1},{"text":"तर प्रभू आमच्यापैकी कोण उभा राहील?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"पण तुम्ही क्षमाशील आहात;","poem":1},{"text":"म्हणूनच आम्ही अत्यंत आदराने तुमची सेवा करू शकतो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"मोठ्या अपेक्षेने माझा जीव याहवेहची वाट पाहतो,","poem":1},{"text":"आणि मी माझी आशा त्यांच्या वचनावर टाकली आहे.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"पहारेकरी ज्या उत्कंठेने अरुणोदयाची वाट पाहतो,","poem":1},{"text":"त्याहीपेक्षा अधिक उत्कंठेने","poem":2},{"lineBreak":true},{"text":"मी माझ्या परमेश्वराची वाट पाहतो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"हे इस्राएला, याहवेहची आशा धर,","poem":1},{"text":"वात्सल्य याहवेहजवळच आहे;","poem":2},{"lineBreak":true},{"text":"मनुष्यांचे संपूर्ण तारण त्यांच्याचकडेच आहे.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ते स्वतः खंडणी भरून","poem":1},{"text":"इस्राएलला सर्व पापांपासून मुक्त करतील.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}