{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":132,"content":[{"type":"hebrew_subtitle","content":["प्रवाशांचे आराधना गीत."]},{"type":"verse","number":1,"content":[{"text":"हे याहवेह, दावीदाचे","poem":1},{"text":"व त्याच्या स्वसुखत्यागाचे स्मरण करा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"त्याने याहवेहची शपथ घेतली,","poem":1},{"text":"याकोबाच्या सर्वसमर्थास असा नवस केला:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“मी ना माझ्या घरात प्रवेश करेन","poem":1},{"text":"अथवा ना अंथरुणात पडेन,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"माझ्या डोळ्यास झोप लागू देणार नाही,","poem":1},{"text":"वा डुलकीही घेणार नाही,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"जेव्हापर्यंत याहवेहसाठी मी एक जागा उपलब्ध करीत नाही,","poem":1},{"text":"याकोबाच्या सर्वसमर्थासाठी एक निवासस्थान बांधत नाही.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"याबद्दल आम्ही एफ्राथाहमध्ये ऐकले,","poem":1},{"text":"नंतर तो याआर प्रदेशात सापडला:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“चला आपण त्यांच्या निवासस्थानी जाऊ,","poem":1},{"text":"तिथे त्यांच्या चरणी त्यांची उपासना करू.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"‘हे याहवेह, उठा आणि तुम्ही तुमच्या सामर्थ्याच्या कोशासह,","poem":1},{"text":"तुमच्या विश्रामस्थानी या.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तुमचे याजक धार्मिकतेची वस्त्रे परिधान करोत;","poem":1},{"text":"तुमचे भक्त आनंदघोष करोत.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"तुमचा सेवक दावीदाकरिता","poem":1},{"text":"तुमच्या अभिषिक्ताचा अव्हेर करू नका.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"याहवेहनी दावीदाला शपथ घेऊन म्हटले की,","poem":1},{"text":"एक अशी शपथ जी ते कधीही मोडणार नाहीत:","poem":2},{"text":"“तुझ्या वंशजांपैकी एकाला","poem":1},{"text":"मी तुझ्या राजासनावर विराजमान करेन.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"जर तुझे वंशज मी केलेल्या करारातील अटींचे","poem":1},{"text":"व मी शिकविलेल्या आज्ञांचे पालन करतील,","poem":2},{"text":"तर त्यांचे वंशजही सदासर्वकाळ","poem":1},{"text":"तुझ्या राजासनावर विराजमान होतील.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"कारण याहवेहनी सीयोनाची निवड केलेली आहे,","poem":1},{"text":"आपल्या निवासस्थानासाठी त्यांची ही अभिलाषा आहे, ते म्हणतात,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“हे माझे कायमचे विश्रांतीचे स्थान आहे;","poem":1},{"text":"मी येथे विराजमान होईन, कारण येथेच राहण्याची माझी इच्छा आहे.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"मी या नगरीची भरभराट करेन;","poem":1},{"text":"तिच्यातील गरिबांना अन्न देऊन तृप्त करेन.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"तेथील याजकांना तारणाची वस्त्रे नेसवेन,","poem":1},{"text":"तेथील भक्त आनंदाने सदैव जयजयकार करतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“येथे दावीदाच्या शिंगाला अंकुर फुटेल","poem":1},{"text":"आणि आपल्या अभिषिक्तासाठी मी एक दीप स्थापित करेन.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"मी त्याच्या शत्रूंना लज्जारूपी पांघरूण घालेन,","poem":1},{"text":"परंतु त्याचे मस्तक राजमुकुटाने गौरवमंडित होईल.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}