{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"आम्ही बाबेलच्या नदीकाठावर बसलो आणि","poem":1},{"text":"सीयोनाची आठवण करीत रडलो.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"आम्ही आमच्या वीणा","poem":1},{"text":"वाळुंजाच्या फांद्यावर टांगल्या,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"कारण आम्हाला कैद करणाऱ्यांनी आम्हाला गात गाण्यास सांगितले,","poem":1},{"text":"आमचा छळ करणार्‍यांनी आनंद गीते गाण्याची मागणी केली,","poem":2},{"lineBreak":true},{"text":"ते म्हणाले, “आमच्या करमणुकी करिता सीयोनाचे एखादे गीत गाऊन दाखवा!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"या परदेशात आमच्या याहवेहचे","poem":1},{"text":"स्तवनगीत गाणे आम्हाला कसे शक्य आहे?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"हे यरुशलेम, मी तुला विसरलो,","poem":1},{"text":"तर माझा उजवा हात त्याचे कौशल्य विसरो;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"जर मी यरुशलेमला माझा","poem":1},{"text":"सर्वोच्च आनंद मानत नसेन,","poem":2},{"text":"तर माझी जीभ","poem":1},{"text":"माझ्या टाळूला चिकटो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"हे याहवेह, माझ्या देवा, यरुशलेमचा पाडाव झाला","poem":1},{"text":"त्या दिवशी एदोमाच्या वंशजांनी काय केले याचे स्मरण करा.","poem":2},{"text":"ते आरोळ्या मारत होते, “तिला जमीनदोस्त करा,","poem":1},{"text":"तिचा पाया देखील ढासळून टाका.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"अगे बाबेलच्या कन्ये, तुझा नाश निश्चित आहे;","poem":1},{"text":"तू जसा आमचा नाश केलास,","poem":2},{"lineBreak":true},{"text":"तसा तुझी परतफेड करणारा धन्य होईल.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"जो तुझी तान्ही बालके घेऊन,","poem":1},{"text":"त्यांना खडकावर आपटेल, तो धन्य!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}