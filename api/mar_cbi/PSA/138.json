{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":138,"content":[{"type":"hebrew_subtitle","content":["दावीदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"हे याहवेह, मी माझ्या अंतःकरणापासून तुमचे उपकारस्मरण करेन;","poem":1},{"text":"मी तुमची स्तुतिस्तोत्रे “दैवतांच्या” पुढे गाईन.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"उपासना करीत असताना, तुमच्या मंदिराकडे मी नतमस्तक होईन,","poem":1},{"text":"आणि तुमच्या सर्व दयामय प्रीतीबद्दल आणि विश्वासूपणाबद्दल,","poem":2},{"lineBreak":true},{"text":"तुमची उपकारस्तुती करेन,","poem":2},{"text":"कारण तुम्ही तुमच्या वचनाला","poem":1},{"text":"तुमच्या किर्तीपेक्षा उंच केले आहे.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जेव्हा मी हाक मारली, तुम्ही प्रत्युत्तर दिले;","poem":1},{"text":"मला शक्ती देऊन खूप धैर्य दिले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"हे याहवेह, पृथ्वीवरील सर्व राजे तुमचे उपकारस्मरण करतील,","poem":1},{"text":"कारण यातील प्रत्येकजण तुमच्या मुखाचे निर्णय ऐकतील.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ते याहवेहच्या गौरवशाली मार्गाचे गुणगान करतील,","poem":1},{"text":"कारण याहवेहचे गौरव अतिथोर आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"याहवेह महान असले तरी ते दीनांची दयेने काळजी घेतात;","poem":1},{"text":"गर्विष्ठ लोकांना मात्र ते दुरूनच ओळखतात.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"मी संकटांनी वेढलेला असलो,","poem":1},{"text":"तरी तुम्ही मला त्यातून सुखरुपपणे सोडविता;","poem":2},{"text":"माझ्या संतापलेल्या शत्रूंवर तुम्ही आपला हात उगारता;","poem":1},{"text":"तुमचा उजवा हात माझा बचाव करतो.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"याहवेह माझे निर्दोषत्व सिद्ध करतील;","poem":1},{"text":"परमेश्वरा, तुमची करुणा सनातन आहे—","poem":2},{"lineBreak":true},{"text":"आपल्या हस्तकृतीचा त्याग करू नका.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}