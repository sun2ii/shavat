{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":14,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी. दावीदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"मूर्ख","poem":1},{"noteId":7},{"text":"आपल्या मनात म्हणतो,","poem":1},{"text":"“परमेश्वर नाही.”","poem":2},{"text":"ते बहकलेले असून त्यांची कृत्ये दुष्ट आहेत,","poem":1},{"text":"सत्कर्म करणारा कोणी नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"मानवांमध्ये कोणी समंजस आहे का?","poem":1},{"text":"परमेश्वराचा शोध करणारे कोणी आहे का?","poem":2},{"text":"हे पाहण्यासाठी याहवेह स्वर्गातून","poem":1},{"text":"खाली पाहतात.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"प्रत्येकजण भटकून गेले आहेत; प्रत्येकजण भ्रष्ट झाला आहे;","poem":1},{"text":"सत्कर्म करणारा कोणीच नाही,","poem":2},{"lineBreak":true},{"text":"एकही नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"दुष्कृत्य करणार्‍यांना हे ठाऊक नाही काय?","poem":1},{"lineBreak":true},{"text":"भाकरी खाण्यासारखे ते माझ्या लोकांना गिळून फस्त करतील.","poem":1},{"text":"ते कधीही याहवेहला हाक मारत नाहीत.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"पण पाहा, ते तिथे भयाने भरले आहेत,","poem":1},{"text":"कारण परमेश्वर नीतिमानांच्या पक्षाचे आहेत.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"दुष्कर्मे करणारे, तुम्ही गरिबांच्या योजना उधळून लावता,","poem":1},{"text":"परंतु याहवेह त्यांचा आश्रय असतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"अहाहा! सीयोनातून इस्राएलची सुटका होईल!","poem":1},{"text":"जेव्हा याहवेह त्यांच्या प्रजेची पुनर्स्थापना करतील,","poem":2},{"lineBreak":true},{"text":"तेव्हा याकोब हर्ष करो आणि इस्राएल आनंद करो!","poem":2}]}],"footnotes":[{"noteId":7,"caller":"+","text":"किंवा अनैतिक","reference":{"chapter":14,"verse":1}}]},"thisChapterLink":"/api/mar_cbi/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}