{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेहचे स्तवन करा.","poem":1},{"lineBreak":true},{"text":"हे माझ्या जिवा, याहवेहचे स्तवन कर.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"आजीवन मी याहवेहचे स्तवन करेन;","poem":1},{"text":"माझ्या जिवात जीव असेपर्यंत मी माझ्या परमेश्वराची स्तुती करेन.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तुम्ही अधिपतींवर भरवसा ठेवू नका; ते केवळ मानव आहेत;","poem":1},{"text":"तारण करण्याचे सामर्थ्य त्यांच्याजवळ नाही.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"कारण जेव्हा त्यांचे प्राण जातात, त्यांचे शरीर भूमीत परत जाऊन मिळते;","poem":1},{"text":"त्या दिवशी त्यांनी केलेल्या सर्व योजना नष्ट होतात.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तो मनुष्य धन्य होय, ज्याचा साहाय्यकर्ता याकोबाचा परमेश्वर आहे,","poem":1},{"text":"आणि ज्याची आशा याहवेह त्याच्या परमेश्वराच्या ठायी आहे,","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"कारण त्यांनीच आकाश, पृथ्वी, सागर,","poem":1},{"text":"आणि त्यातील सर्वकाही निर्माण केले;","poem":2},{"lineBreak":true},{"text":"ते सदासर्वदा विश्वासयोग्य आहेत.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"गरीब व गांजलेले यांना तेच योग्य न्याय देतात;","poem":1},{"text":"तसेच भुकेल्यांस ते अन्न देतात;","poem":2},{"text":"याहवेहच बंदिवानांना मुक्त करतात,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"ते आंधळ्यास दृष्टी प्रदान करतात,","poem":2},{"text":"याहवेह ओझ्याखाली वाकलेल्यास उचलून उभे करतात,","poem":1},{"text":"परमेश्वराला नीतिमान प्रिय आहेत.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"याहवेह निर्वासितांचे रक्षण करतात,","poem":1},{"text":"आणि अनाथ व विधवा यांची काळजी घेतात,","poem":2},{"lineBreak":true},{"text":"परंतु दुष्टांच्या योजना ते नष्ट करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"याहवेह सर्वकाळ राज्य करतील,","poem":1},{"text":"हे सीयोना, तुझे परमेश्वर पिढ्यान् पिढ्या राज्य करतील.","poem":2},{"lineBreak":true},{"text":"याहवेहचे स्तवन करा.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}