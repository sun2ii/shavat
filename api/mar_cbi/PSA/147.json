{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":147,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेहचे स्तवन करा.","poem":1},{"lineBreak":true},{"text":"परमेश्वराची स्तुतिस्तोत्रे गाणे किती मनोरम,","poem":1},{"text":"किती यथार्थ आहे!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"यरुशलेम याहवेहची निर्मिती आहे;","poem":1},{"text":"इस्राएलाच्या निर्वासितांचे तिथे पुनर्वसन करत आहेत.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"भग्नहृदयी लोकांना ते बरे करतात,","poem":1},{"text":"आणि त्यांच्या जखमांवर पट्टी बांधतात.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ते तार्‍यांची गणती करतात","poem":1},{"text":"आणि त्यांनी प्रत्येकास नाव दिलेले आहे.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ते अत्यंत महान आहेत आणि त्यांचे सामर्थ्य अमर्याद आहे;","poem":1},{"text":"त्यांची बुद्धी अपरिमित आहे.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"याहवेह नम्रजनांस आधार देतात,","poem":1},{"text":"परंतु दुर्जनास बहिष्कृत करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"याहवेहच्या उपकारस्तुतीची गीते गा;","poem":1},{"text":"वीणेच्या साथीवर आमच्या परमेश्वराची स्तुतिस्तोत्रे गा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ते मेघांनी आकाश व्यापून टाकतात;","poem":1},{"text":"पावसाच्या सरी भूमीवर पाठवितात","poem":2},{"lineBreak":true},{"text":"आणि डोंगरावर हिरवे गवत रुजवितात.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ते पशूंना त्यांचा आहार पुरवितात","poem":1},{"text":"व हाक मारणार्‍या कावळ्यांच्या पिलांना अन्न देतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"घोड्यांचे बल त्यांना प्रसन्न करीत नाही,","poem":1},{"text":"मानवाचे सामर्थ्यवान पायही त्यांना संतुष्ट करीत नाही.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"याहवेह त्यांचे भय बाळगणार्‍यांवर संतुष्ट असतात,","poem":1},{"text":"तसेच जे त्यांच्या प्रेमदयेची आशा धरतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"यरुशलेम, याहवेहचा महिमा कर;","poem":1},{"text":"सीयोने, आपल्या परमेश्वराची स्तुती कर.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"कारण त्यांनी तुझ्या वेशींचे स्तंभ बळकट केले आहेत","poem":1},{"text":"आणि त्या नगरातील तुझ्या लोकांस आशीर्वाद दिला आहे.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ते तुझ्या सर्व सीमांत शांतता प्रस्थापित करतात;","poem":1},{"text":"ते उत्कृष्ट गव्हाने तुला तृप्त करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ते आपल्या आज्ञा पृथ्वीवर पाठवितात;","poem":1},{"text":"त्यांचा शब्द वायुवेगाने पसरतो.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"शुभ्र लोकरीसारख्या हिमाचा ते वर्षाव करतात","poem":1},{"text":"आणि हिमकण जमिनीवर राखेसारखे विखुरतात.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ते पृथ्वीवर गारांच्या खड्यांप्रमाणे वर्षाव करतात.","poem":1},{"text":"त्यांच्या गोठविणार्‍या थंडीपुढे कोण टिकेल?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"परंतु नंतर ते उष्ण हवेला आज्ञा करतात,","poem":1},{"text":"तेव्हा हिम वितळते आणि जलप्रवाह वाहू लागतो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"त्यांनी आपले वचन याकोबाला विदित केलेले आहेत","poem":1},{"text":"आणि विधी व नियम इस्राएलला स्पष्ट केले आहेत.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"इतर कोणत्याही राष्ट्राकरिता त्यांनी असे केले नाही;","poem":1},{"text":"ते त्यांच्या आज्ञांबाबत अज्ञानी आहेत.","poem":2},{"lineBreak":true},{"text":"याहवेहचे स्तवन करा.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}