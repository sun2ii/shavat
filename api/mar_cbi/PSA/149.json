{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेहचे स्तवन करा.","poem":1},{"lineBreak":true},{"text":"याहवेहसाठी एक नवे गीत गा,","poem":1},{"text":"त्यांच्या भक्तांच्या सभेत त्यांची स्तुतिस्तोत्रे गायली जावोत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"हे इस्राएला, आपल्या निर्माणकर्त्याच्या ठायी आनंदोत्सव कर;","poem":1},{"text":"अहो सीयोनकरांनो, आपल्या राजाच्या ठायी उल्लास पावा.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"त्यांच्या गौरवार्थ नृत्य करीत,","poem":1},{"text":"डफ आणि वीणा यांच्या संगीताच्या साथीवर स्तुती गा.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"कारण याहवेहला आपल्या लोकांमुळे संतोष होतो;","poem":1},{"text":"ते नम्रजनांस विजयी करतात.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"या सन्मानामुळे त्यांचे सात्विक उल्लास करोत","poem":1},{"text":"आणि आपल्या अंथरुणावर हर्षगीते गावोत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"त्यांच्या मुखात परमेश्वराची आराधना असो","poem":1},{"text":"आणि दुधारी तलवार त्यांच्या हातात धारण करून,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"राष्ट्रांसाठी त्यांनी नेमलेल्या शिक्षा अंमलात आणण्यास","poem":1},{"text":"सिद्ध व्हावे;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"त्या राष्ट्रांच्या राजांना बेड्या घाला","poem":1},{"text":"आणि त्यांच्या पुढार्‍यांना लोखंडी साखळदंडानी बांधा.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"त्यांना दिलेल्या शिक्षांची अंमलबजावणी करा.","poem":1},{"text":"हाच याहवेहच्या विश्वासू लोकांचा गौरव आहे.","poem":2},{"lineBreak":true},{"text":"याहवेहचे स्तवन करा.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}