{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":15,"content":[{"type":"hebrew_subtitle","content":["दावीदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"याहवेह, तुमच्या पवित्र मंडपात कोण राहू शकेल?","poem":1},{"text":"तुमच्या पवित्र डोंगरावर कोण राहू शकेल?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ज्याचे चालणे निर्दोष आहे,","poem":1},{"text":"जो धार्मिकतेचे आचरण करतो,","poem":2},{"lineBreak":true},{"text":"जो आपल्या हृदयातून सत्य बोलतो;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जो आपल्या जिभेने निंदा करीत नाही,","poem":1},{"text":"जो आपल्या शेजार्‍यांचे वाईट करीत नाही,","poem":2},{"lineBreak":true},{"text":"आणि इतरांना काळिमा लावत नाही;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"जो कुटिल मनुष्याचा तिरस्कार करतो,","poem":1},{"text":"याहवेहचे भय धरणार्‍यांचा सन्मान करतो,","poem":2},{"text":"आणि जो स्वतःचे नुकसान होत असले","poem":1},{"text":"तरी दिलेले वचन पाळतो;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"जो व्याज न आकारता पैसे उसने देतो;","poem":1},{"text":"जो निष्पाप लोकांविरुद्ध साक्ष देण्यासाठी लाच घेत नाही,","poem":2},{"lineBreak":true},{"text":"जो कोणी या गोष्टी करतो","poem":1},{"text":"तो कधीही ढळणार नाही.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}