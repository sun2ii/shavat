{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":19,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी. दावीदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"आकाश परमेश्वराची महिमा वर्णिते;","poem":1},{"text":"अंतराळ त्यांच्या अद्भुत हस्तकृतीची घोषणा करते.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"दिवसेंदिवस ते वार्तालाप करतात;","poem":1},{"text":"प्रत्येक रात्री ते ज्ञान प्रगट करते.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"या प्रकियेत बोलणे नाही, शब्दही नाही,","poem":1},{"text":"त्यात आवाजही नाही;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तरीही पृथ्वीच्या दिगंतापर्यंत त्यांची वाणी जाते,","poem":1},{"text":"कारण जगाच्या शेवटपर्यंत त्यांचा शब्द गेला आहे.","poem":2},{"text":"परमेश्वराने सूर्यासाठी स्वर्गात मंडप तयार केला आहे.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"आपल्या मंडपातून निघालेल्या तेजस्वी वराप्रमाणे,","poem":2},{"lineBreak":true},{"text":"जसा एखादा विजेता आपली धाव पूर्ण करण्यास उल्लासतो.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तो आकाशाच्या एका टोकास उगवतो","poem":1},{"text":"दुसर्‍या टोकापर्यंत परिक्रमा पूर्ण करतो;","poem":2},{"lineBreak":true},{"text":"त्याच्या उष्णतेपासून काहीही लपून राहू शकत नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"याहवेहचे नियम उत्कृष्ट आहेत;","poem":1},{"text":"ते आत्म्याला ताजेतवाने करतात.","poem":2},{"text":"याहवेहचे नियम विश्वसनीय आहेत,","poem":1},{"text":"ते भोळ्यांना सुज्ञ करतात.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"याहवेहचे नियम योग्य आहेत,","poem":1},{"text":"ते हृदयास आनंद देतात,","poem":2},{"text":"याहवेहच्या आज्ञा तेजस्वी आहेत,","poem":1},{"text":"त्या नेत्रांना प्रकाश देतात.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"याहवेहचे भय निर्मळ आहे,","poem":1},{"text":"ते सर्वकाळ टिकणारे आहेत.","poem":2},{"text":"याहवेहचे निर्णय स्थिर आहेत,","poem":1},{"text":"आणि ते सर्व पूर्णतः नीतिमान आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"सोन्यापेक्षा ते अधिक मौल्यवान आहेत,","poem":1},{"text":"अतिशुद्ध सोन्यापेक्षाही;","poem":2},{"text":"ते मधापेक्षा मधुर आहेत,","poem":1},{"text":"पोळ्यातील मधाहूनही ते अधिक गोड आहेत.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"कारण ते तुमच्या सेवकांस सावध करतात;","poem":1},{"text":"त्याचे पालन करणार्‍यास मोठे प्रतिफळ मिळते.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"स्वतःच्या चुका कोणाला समजणार?","poem":1},{"text":"माझ्या गुप्त दोषांबद्धल मला क्षमा करून निर्दोष ठरवा.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तसेच जाणूनबुजून पाप करण्यापासून आपल्या सेवकास थांबवा;","poem":1},{"text":"ते मला त्याच्या अधीन करू नये.","poem":2},{"text":"तेव्हाच मी दोषमुक्त होईन,","poem":1},{"text":"एखाद्या मोठ्या गुन्ह्याबाबत निर्दोष ठरेन.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"याहवेह, माझे खडक आणि माझे तारणहार,","poem":1},{"text":"माझ्या मुखातून निघालेले शब्द","poem":2},{"lineBreak":true},{"text":"आणि माझ्या अंतःकरणातील मनन तुमच्या नजरेत संतोष देणारे होवोत.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}