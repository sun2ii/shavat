{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"राष्ट्रे कट","poem":1},{"noteId":0},{"text":"का रचत आहेत,","poem":1},{"text":"आणि लोक व्यर्थच कुटिल योजना का करीत आहेत?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"याहवेह आणि त्यांच्या अभिषिक्ताविरुद्ध","poem":1},{"text":"पृथ्वीवरील राजे एकत्र येऊन उठाव करीत,","poem":2},{"lineBreak":true},{"text":"असे म्हणत आहेत,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“चला, आपण त्यांची बंधने तोडून टाकू,","poem":1},{"text":"आणि त्यांच्या बेड्या काढून फेकून देऊ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"स्वर्गातील सिंहासनावर जे विराजमान आहेत ते हसतात;","poem":1},{"text":"प्रभू त्यांचा उपहास करतात.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ते त्यांना क्रोधाने दटावतात","poem":1},{"text":"आणि याहवेहच्या संतापाने त्यांचा थरकाप होतो, ते असे म्हणतात,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“सीयोन माझा पवित्र पर्वत,","poem":1},{"text":"यावर मी माझ्या राजाला नियुक्त केले आहे.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":["मी याहवेहच्या नियमांची घोषणा करेन:",{"lineBreak":true},{"text":"ते मला असे म्हणतात, “तू माझा पुत्र आहेस;","poem":1},{"text":"आज मी तुझा पिता झालो आहे.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"माझ्याकडे माग,","poem":1},{"text":"म्हणजे मी तुला राष्ट्रांचे वतन देईन,","poem":2},{"lineBreak":true},{"text":"पृथ्वीच्या सीमा तुझे धन असेल.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तुम्ही त्यांना लोखंडी राजदंडाने मोडून टाकणार,","poem":1},{"text":"तुम्ही मातीच्या पात्रांप्रमाणे त्यांचा चुराडा कराल.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"म्हणून अहो राजांनो, शहाणे व्हा;","poem":1},{"text":"पृथ्वीवरील शासक सावध व्हा.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"भय धरून याहवेहची सेवा करा!","poem":1},{"text":"थरथर कापत त्यांच्या शासनाचा सन्मान करा.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"त्यांच्या पुत्राचे चुंबन घ्या, नाहीतर ते रागावतील,","poem":1},{"text":"आणि तुमचे मार्ग तुम्हाला नाशाकडे घेऊन जातील,","poem":2},{"text":"कारण एका क्षणात त्यांचा क्रोधाग्नी पेटेल.","poem":1},{"text":"धन्य आहेत ते सर्वजण जे त्यांना शरण जातात.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"किंवा संतापली आहेत","reference":{"chapter":2,"verse":1}}]},"thisChapterLink":"/api/mar_cbi/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}