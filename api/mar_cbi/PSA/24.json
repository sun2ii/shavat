{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":24,"content":[{"type":"hebrew_subtitle","content":["दावीदाचे एक स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"पृथ्वी व तिच्यातील सर्वकाही याहवेहचे आहे.","poem":1},{"text":"जग आणि त्यात राहणारे सारे त्यांचेच आहेत.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"कारण त्यांनीच तिचा पाया महासागरांवर घातला,","poem":1},{"text":"आणि त्यांनीच तिला जलप्रवाहांवर स्थिर केले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"याहवेहचा डोंगर कोण चढून जाईल?","poem":1},{"text":"त्यांच्या पवित्रस्थानी कोण उभा राहील?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ज्याचे हात निर्मळ आणि ज्याचे हृदय शुद्ध आहे,","poem":1},{"text":"जो मूर्तींवर भरवसा ठेवत नाही,","poem":2},{"lineBreak":true},{"text":"जो खोटी शपथ वाहत नाही.","poem":2},{"noteId":14}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"त्यांना याहवेहपासून आशीर्वाद लाभेल.","poem":1},{"text":"त्यांचा तारणकर्ता परमेश्वर त्यांना नीतिमान ठरवेल.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"हीच अशी पिढी आहे जी याहवेहचा शोध घेत आहे,","poem":1},{"text":"याकोबाच्या परमेश्वरा, जे तुमच्या दर्शनासाठी आतुर आहेत. सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"अहो वेशींनो, आपले मस्तक उंच करा;","poem":1},{"text":"प्राचीन द्वारांनो, उच्च व्हा;","poem":2},{"lineBreak":true},{"text":"गौरवाच्या राजाला आत प्रवेश करू द्या.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"असा गौरवशाली राजा कोण आहेत?","poem":1},{"text":"याहवेह जे समर्थ व प्रबळ आहेत,","poem":2},{"lineBreak":true},{"text":"जे युद्धात पराक्रमी आहेत.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"अहो वेशींनो, आपले मस्तक उंच करा;","poem":1},{"text":"प्राचीन द्वारांनो, सताड उघडा;","poem":2},{"lineBreak":true},{"text":"महातेजस्वी महाराज आत येतील.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"हा गौरवशाली राजा कोण आहेत?","poem":1},{"text":"सर्वशक्तिमान याहवेह—","poem":2},{"lineBreak":true},{"text":"तेच आहेत गौरवशाली राजा. सेला","poem":2}]}],"footnotes":[{"noteId":14,"caller":"+","text":"किंवा खोट्या दैवतांची","reference":{"chapter":24,"verse":4}}]},"thisChapterLink":"/api/mar_cbi/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}