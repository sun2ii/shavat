{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["दावीदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"याहवेह, माझा न्याय करून मला निर्दोष जाहीर करा,","poem":1},{"text":"मी दोषरहित जीवन जगलो;","poem":2},{"text":"याहवेह, मी न डगमगता","poem":1},{"text":"तुमच्यावर विश्वास ठेवला आहे.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"याहवेह, माझी परीक्षा घ्या, माझे परीक्षण करा,","poem":1},{"text":"माझे मन आणि हृदयाची पारख करा.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"कारण मी नेहमीच तुमच्या अतुलनीय करुणेची आठवण ठेवतो","poem":1},{"text":"आणि तुमच्या विश्वासूपणावर अवलंबून राहिलो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"कपटी लोकांसोबत मी बसत नाही","poem":1},{"text":"किंवा ढोंगी लोकांची संगत मी धरत नाही.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"दुष्कर्म करणार्‍यांच्या सर्व सभा मला घृणास्पद वाटतात","poem":1},{"text":"आणि मी त्या दुष्टांच्या संगतीत बसत नाही.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मी माझे हात धुऊन निर्दोषत्व सिद्ध करेन","poem":1},{"text":"आणि याहवेह, मी तुमच्या वेदीला परिक्रमा घालेन,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"म्हणजे उंच आवाजाने तुमची उपकारस्तुती करेन","poem":1},{"text":"आणि तुमच्या अद्भुत कृत्यांचे वर्णन करेन.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"याहवेह, मला तुमचे निवासस्थान आवडते,","poem":1},{"text":"इथेच तुमचे वैभव वसती करते.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"पातकी लोकांसोबत माझ्या जीवाला,","poem":1},{"text":"आणि रक्तपिपासू लोकांसोबत माझे प्राण घेऊ नका.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"त्यांच्या हातात दुष्ट योजना आहेत,","poem":1},{"text":"त्यांचा उजवा हात लाचेने भरलेला आहे.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"मी तर माझे जीवन निर्दोषतेने जगेन;","poem":1},{"text":"मला मुक्त करा आणि माझ्यावर कृपा करा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"माझे पाय सपाट जमिनीवर स्थिर आहेत;","poem":1},{"text":"महासभेत मी याहवेहची जाहीरपणे स्तुती करेन.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}