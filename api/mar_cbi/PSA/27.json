{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":27,"content":[{"type":"hebrew_subtitle","content":["दावीदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"याहवेह माझे प्रकाश व माझे तारण आहेत—","poem":1},{"text":"मी कोणाचे भय बाळगू?","poem":2},{"text":"याहवेह माझ्या जीवनाचे दुर्ग आहेत—","poem":1},{"text":"मला कोणाचे भय आहे?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"जेव्हा वाईट लोक मला गिळण्यास","poem":1},{"text":"माझ्यावर हल्ला करतील,","poem":2},{"text":"तेव्हा माझे शत्रू व माझे विरोधकच","poem":1},{"text":"अडखळतील आणि पडतील.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जरी सैन्याने मजभोवती वेढा घातला,","poem":1},{"text":"तरी माझे अंतःकरण भयभीत होणार नाही;","poem":2},{"text":"माझ्याविरुद्ध युद्ध जरी पेटले,","poem":1},{"text":"तरी मी निश्चिंत राहीन.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"मी याहवेहला एक याचना केली,","poem":1},{"text":"हीच माझी आकांक्षा आहे:","poem":2},{"text":"मी आयुष्यभर याहवेहच्या","poem":1},{"text":"भवनात वस्ती करावी जेणेकरून","poem":2},{"text":"मी याहवेहचे सौंदर्य बघून त्यांच्या","poem":1},{"text":"मंदिरात ध्यान करावे.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"कारण संकटाच्या दिवसात","poem":1},{"text":"ते मला त्यांच्या वसतिस्थानात सुरक्षित ठेवतील;","poem":2},{"text":"तेच मला आपल्या निवासमंडपात लपवून ठेवतील;","poem":1},{"text":"उंच खडकावर मला सुरक्षा देतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"माझ्या सभोवती असणार्‍या","poem":1},{"text":"शत्रूंसमोर माझे मस्तक उंच करतील.","poem":2},{"text":"मी त्यांच्या पवित्र मंडपात हर्षगर्जना करून यज्ञ अर्पण करेन;","poem":1},{"text":"मी गायन व संगीताने माझ्या याहवेहची स्तुती करेन.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"याहवेह, माझी याचना ऐका;","poem":1},{"text":"माझ्यावर दया करा आणि मला उत्तर द्या.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तुमच्याविषयी माझे अंतःकरण म्हणाले, “त्यांचे मुख शोध!”","poem":1},{"text":"हे याहवेह, मी तुमचे मुख शोधेन.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तुम्ही आपले मुख माझ्यापासून लपवू नका,","poem":1},{"text":"तुमच्या दासाला रागाने दूर लोटू नका;","poem":2},{"lineBreak":true},{"text":"तुम्हीच माझे सहायक राहिले आहात;","poem":2},{"text":"हे माझ्या तारणकर्त्या परमेश्वरा,","poem":1},{"text":"मला नाकारू नका वा माझा त्याग करू नका.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"माझ्या आईवडिलांनी माझा त्याग केला.","poem":1},{"text":"तरी याहवेह, माझा स्वीकार कराल.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"याहवेह, मला तुमचे मार्ग शिकवा;","poem":1},{"text":"माझी छळणूक करणाऱ्यांमुळे","poem":2},{"lineBreak":true},{"text":"मला सरळ मार्गावर घेऊन चला.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"मला माझ्या शत्रूंच्या तावडीत सापडू देऊ नका,","poem":1},{"text":"कारण खोटी साक्ष देणारे आणि क्रूरपणाने फुत्कारणारे","poem":2},{"lineBreak":true},{"text":"माझ्याविरुद्ध उठले आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"मला हा पूर्णपणे विश्वास आहे:","poem":1},{"text":"की मी या जीवनातच याहवेहच्या","poem":2},{"lineBreak":true},{"text":"चांगुलपणाचा अनुभव घेणार.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"याहवेहची प्रतीक्षा कर;","poem":1},{"text":"हिंमत बांध, धैर्य धर;","poem":2},{"lineBreak":true},{"text":"आणि याहवेहचीच प्रतीक्षा कर.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}