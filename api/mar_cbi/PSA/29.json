{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":29,"content":[{"type":"hebrew_subtitle","content":["दावीदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"अहो दिव्यदूतांनो,","poem":1},{"text":"याहवेहला गौरव आणि सामर्थ्य द्या.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"याहवेहच्या नावाला योग्य ते गौरव द्या;","poem":1},{"text":"पवित्रतेच्या वैभवाने याहवेहची उपासना करा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"याहवेहची वाणी जलांवर आहे;","poem":1},{"text":"गौरवशाली याहवेहची वाणी","poem":2},{"lineBreak":true},{"text":"महा जलाशयांवर गर्जत आहे.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"याहवेहची वाणी प्रतापशाली आहे;","poem":1},{"text":"प्रभावी आहे याहवेहचा स्वर.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"याहवेहच्या गर्जनेने देवदारू वृक्ष मोडून पडतात;","poem":1},{"text":"लबानोनमधील देवदारू वृक्ष दुभंगतात.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"लबानोनचा डोंगर वासराप्रमाणे","poem":1},{"text":"आणि सिर्योन","poem":2},{"noteId":15},{"text":"तरुण रानबैलाप्रमाणे बागडतो;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"याहवेहचा आवाज कडाडतो,","poem":1},{"text":"विजा चमकल्यासारखा.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"याहवेहच्या आवाजाचा गडगडाट वाळवंटे ढवळून काढतात;","poem":1},{"text":"कादेशचे अरण्य याहवेह कंपित करतात.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"याहवेहच्या आवाजाने हरिणी प्रसवतात","poem":1},{"noteId":16},{"text":"आणि वने पर्णहीन होतात.","poem":2},{"text":"आणि त्यांच्या मंदिरात सर्वजण म्हणतात: “याहवेहचा, महिमा असो.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"याहवेह जलप्रलयावर सिंहासनावर आरूढ झालेले आहेत;","poem":1},{"text":"याहवेहच महाराज बनून सिंहासनावर सर्वकाळ स्थानबद्ध झालेले आहेत.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"याहवेह आपल्या लोकांना सामर्थ्य देतात;","poem":1},{"text":"याहवेह आपल्या लोकांना शांती देऊन आशीर्वादित करतात.","poem":2}]}],"footnotes":[{"noteId":15,"caller":"+","text":"अर्थात् हर्मोन पर्वत","reference":{"chapter":29,"verse":6}},{"noteId":16,"caller":"+","text":"किंवा एला वृक्ष वाकवितात","reference":{"chapter":29,"verse":9}}]},"thisChapterLink":"/api/mar_cbi/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}