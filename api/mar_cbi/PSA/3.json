{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["दावीदाचे स्तोत्र. जेव्हा तो त्याचा पुत्र अबशालोम याच्यापासून पळाला."]},{"type":"verse","number":1,"content":[{"text":"याहवेह, माझ्या शत्रूंची संख्या किती अधिक आहे!","poem":1},{"text":"कितीतरी लोक माझ्याविरुद्ध उठले आहेत!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"पुष्कळजण माझ्याबद्दल म्हणतात,","poem":1},{"text":"“परमेश्वर त्याची सुटका करणार नाही.” सेला","poem":2},{"noteId":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"परंतु याहवेह, तुम्ही माझ्या सभोवती ढाल आहात.","poem":1},{"text":"माझे गौरव आणि माझी मान उंचाविणारे तुम्हीच आहात.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मी याहवेहचा धावा करतो,","poem":1},{"text":"आणि ते त्यांच्या पवित्र पर्वतांवरून मला उत्तर देतात. सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"मी पहुडतो आणि झोप घेतो;","poem":1},{"text":"मी पुन्हा उठतो, कारण याहवेह माझे रक्षण करतात.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"असंख्य मला चहूबाजूंनी वेढतील,","poem":1},{"text":"तरी मला मुळीच भीती वाटणार नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"याहवेह, उठा!","poem":1},{"text":"हे माझ्या परमेश्वरा, मला वाचवा!","poem":2},{"text":"माझ्या सर्व शत्रूंच्या जबड्यांवर प्रहार करा;","poem":1},{"text":"त्या दुष्टांचे दात पाडून टाका.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"कारण सुटका याहवेहपासूनच आहे.","poem":1},{"text":"तुमच्या लोकांवर तुमचा आशीर्वाद असो. सेला","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"सेला या इब्री शब्दाचा अर्थ कदाचित गीत गाताना मध्ये थोडे थांबणे असा आहे.","reference":{"chapter":3,"verse":2}}]},"thisChapterLink":"/api/mar_cbi/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}