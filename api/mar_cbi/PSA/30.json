{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":30,"content":[{"type":"hebrew_subtitle","content":["एक स्तोत्र. मंदिराच्या समर्पण सोहळ्यासाठी एक गाणे, दावीदाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"याहवेह मी तुमची प्रशंसा करेन,","poem":1},{"text":"कारण तुम्ही मला खोल दरीतून बाहेर काढले आहे","poem":2},{"lineBreak":true},{"text":"आणि माझ्या शत्रूंना माझा उपहास करू दिला नाही.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हे याहवेह, माझ्या परमेश्वरा, मी तुम्हाला साहाय्यासाठी विनवणी केली","poem":1},{"text":"आणि तुम्ही मला रोगमुक्त केले.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"याहवेह तुम्ही मला अधोलोकातून बाहेर काढले;","poem":1},{"text":"तुम्ही मला गर्तेत जाण्यापासून वाचविले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"अहो याहवेहच्या भक्तांनो, त्यांची स्तुतिस्तोत्रे गा,","poem":1},{"text":"त्यांच्या पवित्र नावाला धन्यवाद द्या.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"त्यांचा क्रोध क्षणभर टिकतो,","poem":1},{"text":"पण त्यांची कृपा जन्मभर राहते.","poem":2},{"text":"विलाप करणे केवळ रात्रभर राहील,","poem":1},{"text":"परंतु प्रातःकाल उगवताच आनंद होईल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"माझ्या भरभराटीच्या वेळी मी म्हणालो,","poem":1},{"text":"“मी कधीही डगमगणार नाही.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"याहवेह, तुमच्या कृपेने","poem":1},{"text":"मला बळकट पर्वताप्रमाणे","poem":2},{"noteId":17},{"text":"स्थिर केले होते,","poem":2},{"text":"परंतु तुम्ही आपले मुख लपविले,","poem":1},{"text":"तेव्हा मी भयभीत झालो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"याहवेह मी तुमचा धावा केला,","poem":1},{"text":"मी प्रभूला कृपेची विनवणी केली.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"मी चिरनिद्रीत होण्यापासून","poem":1},{"text":"मी अधोलोकात जाण्यापासून काय लाभ?","poem":2},{"text":"माती तुमची स्तुती करेल काय?","poem":1},{"text":"ती तुमच्या विश्वासूपणाची साक्ष देईल काय?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"याहवेह, माझे ऐका, मजवर दया करा;","poem":1},{"text":"याहवेह मला साहाय्य करा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"तुम्ही माझ्या शोकाचे रूपांतर हर्षनृत्यात केले.","poem":1},{"text":"तुम्ही माझे शोकाचे गोणपाट काढून मला उल्हासाची वस्त्रे घातली,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"जेणेकरून मी शांत न राहता, माझ्या हृदयाने सदैव तुमची स्तुतिस्तोत्रे गात राहावे.","poem":1},{"text":"याहवेह, माझ्या परमेश्वरा, मी सदासर्वकाळ तुमची प्रशंसा करीतच राहीन.","poem":2}]}],"footnotes":[{"noteId":17,"caller":"+","text":"म्हणजेच सीयोन पर्वत","reference":{"chapter":30,"verse":7}}]},"thisChapterLink":"/api/mar_cbi/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}