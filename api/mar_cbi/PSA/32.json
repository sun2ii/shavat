{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":32,"content":[{"type":"hebrew_subtitle","content":["दावीदाचे स्तोत्र; मासकील"]},{"type":"verse","number":1,"content":[{"text":"धन्य तो मनुष्य,","poem":1},{"text":"ज्याच्या अपराधांची क्षमा झालेली आहे,","poem":2},{"lineBreak":true},{"text":"ज्याच्या पापांवर पांघरूण घातले आहे.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"धन्य ती व्यक्ती,","poem":1},{"text":"ज्याच्या हिशेबी याहवेह पापाचा दोष लावत नाही,","poem":2},{"lineBreak":true},{"text":"आणि ज्याच्या आत्म्यात कपट नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"मी गप्प राहिलो,","poem":1},{"text":"तेव्हा संपूर्ण दिवस माझी हाडे","poem":2},{"lineBreak":true},{"text":"माझ्या कण्हण्यामुळे जर्जर झाली.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"रात्रंदिवस तुमचा हात","poem":1},{"text":"माझ्यावर भारी होता;","poem":2},{"text":"उष्मकालच्या उष्णतेप्रमाणे","poem":1},{"text":"माझी शक्ती सुकून गेली होती. सेला","poem":2},{"noteId":18}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"नंतर मी माझी सर्व पातके तुमच्याजवळ कबूल केली","poem":1},{"text":"आणि माझे अपराध लपविले नाही.","poem":2},{"text":"मी स्वतःशी म्हणालो, “मी याहवेहजवळ","poem":1},{"text":"माझी पातके कबूल करेन.”","poem":2},{"text":"तेव्हा तुम्ही माझ्या पातकांच्या","poem":1},{"text":"दोषाची क्षमा केली. सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"यासाठी प्रत्येक विश्वासणाऱ्याने तुम्हाला पावण्याची संधी आहे","poem":1},{"text":"तोपर्यंत तुमची प्रार्थना करावी;","poem":2},{"text":"संकटे जलाच्या महापूरासारखी आली","poem":1},{"text":"तरी त्यांना त्याचा स्पर्श होणार नाही.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"माझे आश्रयस्थान तुम्ही आहात;","poem":1},{"text":"संकटात तुम्हीच माझे रक्षण करणार","poem":2},{"lineBreak":true},{"text":"आणि मुक्ततेच्या गीतांनी तुम्ही मला वेढणार. सेलाह","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"याहवेह म्हणतात, जो मार्ग तू अनुसरावा त्याचे मी तुला मार्गदर्शन व शिक्षण देईन;","poem":1},{"text":"माझी प्रेमळ नजर तुजवर ठेऊन मी तुला बोध करेन.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"तुमची मनोवृत्ती घोड्यासारखी किंवा खेचरासारखी नसावी,","poem":1},{"text":"ज्यांना काही समज नसते.","poem":2},{"text":"त्यांना नियंत्रित करण्यासाठी अंकुश आणि लगाम लागतो,","poem":1},{"text":"अन्यथा ते आपल्याजवळ येणार नाहीत.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"दुर्जनांवर अनेक दुःखे येतात.","poem":1},{"text":"परंतु जे याहवेहवर विश्वास ठेवतात,","poem":2},{"lineBreak":true},{"text":"त्यांच्याभोवती त्यांच्या अक्षयप्रीतीचे वेष्टण असते.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"नीतिमान लोकांनो, याहवेहमध्ये आनंद आणि हर्ष करा;","poem":1},{"text":"तुम्ही जे सरळ मनाचे आहात, ते आनंदाने आरोळ्या मारा.","poem":2}]}],"footnotes":[{"noteId":18,"caller":"+","text":"सेला या इब्री शब्दाचा अर्थ कदाचित गीत गाताना मध्ये थोडे थांबणे असा आहे","reference":{"chapter":32,"verse":4}}]},"thisChapterLink":"/api/mar_cbi/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}