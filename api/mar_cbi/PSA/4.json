{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":4,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी; तंतुवाद्यावरील दावीदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"हे माझ्या नीतिमान परमेश्वरा, मी तुम्हाला हाक मारेन,","poem":1},{"text":"तेव्हा मला उत्तर द्या.","poem":2},{"text":"माझ्या संकटात तुम्हीच मला साहाय्य करा.","poem":1},{"text":"माझ्यावर दया करा, माझी प्रार्थना ऐका.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"अहो मनुष्यांनो, किती वेळा तुम्ही माझ्या गौरवाला काळिमा लावणार?","poem":1},{"text":"किती काळ तुम्ही फसवणुकीवर प्रीती कराल आणि खोट्या दैवतांचा शोध कराल","poem":2},{"noteId":2},{"text":"? सेलाह","poem":2}]},{"type":"verse","number":3,"content":[{"text":"हे लक्षात ठेवा, विश्वासू सेवकांस याहवेहने स्वतःसाठी निवडून बाजूला ठेवले आहे;","poem":1},{"text":"मी जेव्हा त्यांचा धावा करेन, तेव्हा ते माझे ऐकतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"भीती बाळगा","poem":1},{"noteId":3},{"text":"आणि पाप करू नका.","poem":1},{"text":"बिछान्यावर असता शांत अंतःकरणाने","poem":2},{"lineBreak":true},{"text":"त्यांचे चिंतन करा. सेलाह","poem":2}]},{"type":"verse","number":5,"content":[{"text":"त्यांना नीतियुक्त यज्ञार्पणे करा.","poem":1},{"text":"आणि याहवेहवर विश्वास ठेवा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“आमचे कल्याण कोण करणार,” असे अनेकजण म्हणतात,","poem":1},{"text":"हे याहवेह, तुमच्या चेहर्‍याचा प्रकाश आम्हावर पाडा.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"विपुल धान्य व द्राक्षारस देतो त्या आनंदापेक्षाही","poem":1},{"text":"कितीतरी अधिक आनंद तुम्ही माझ्या हृदयात दिला आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"मी शांतचित्ताने झोपी जाईन,","poem":1},{"text":"कारण हे याहवेह तुम्हीच","poem":2},{"lineBreak":true},{"text":"मला सुरक्षित ठेवता.","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"किंवा लबाडी शोधाल","reference":{"chapter":4,"verse":2}},{"noteId":3,"caller":"+","text":"किंवा तुम्ही रागात असता","reference":{"chapter":4,"verse":4}}]},"thisChapterLink":"/api/mar_cbi/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}