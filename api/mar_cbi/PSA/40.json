{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":40,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी. दावीदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"मी धीराने याहवेहची वाट पाहिली;","poem":1},{"text":"तेव्हा त्यांनी माझ्याकडे लक्ष दिले आणि माझी आरोळी ऐकली.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"निसरड्या खाचेतून, दलदलीच्या चिखलातून","poem":1},{"text":"त्यांनी मला बाहेर काढले;","poem":2},{"text":"त्यांनी माझी पावले खडकावर ठेवली,","poem":1},{"text":"आणि त्यांनी मला उभे राहण्यास भक्कम ठिकाण दिले.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"त्यांनी आपल्या परमेश्वराचे स्तवन करण्यास","poem":1},{"text":"माझ्या मुखात नवीन गीत दिले.","poem":2},{"text":"हे अनेकजण पाहतील व याहवेहचे भय धरतील","poem":1},{"text":"आणि त्यांच्यावर विश्वास ठेवतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"जे लोक याहवेहवर भरवसा ठेवतात,","poem":1},{"text":"जे गर्विष्ठांच्या व असत्याकडे","poem":2},{"noteId":21},{"text":"वळणार्‍यांच्या","poem":2},{"text":"वार्‍यासही उभे राहत नाही,","poem":1},{"text":"ते धन्य होत.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"याहवेह, माझ्या परमेश्वरा,","poem":1},{"text":"तुम्ही अनेक चमत्कार केलेले आहेत;","poem":2},{"lineBreak":true},{"text":"आमच्यासाठी तुम्ही केलेल्या","poem":2},{"text":"योजनेची तुलना करता येत नाही;","poem":1},{"text":"त्याबद्दल बोलावयाचे झाले","poem":2},{"lineBreak":true},{"text":"तर त्यांची मोजदाद करता येणार नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"यज्ञ किंवा अन्नार्पणे यांची इच्छा तुम्हाला नाही—","poem":1},{"text":"परंतु तुम्ही माझे कान उघडले आहेत;","poem":2},{"lineBreak":true},{"text":"होमार्पण आणि पापार्पण यांनी तुम्हाला संतोष होत नाही.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तेव्हा मी म्हणालो, “पाहा मी येथे आहे, आलो आहे—","poem":1},{"text":"शास्त्रलेखात माझ्याविषयी लिहिले आहे.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"हे माझ्या परमेश्वरा, तुमची इच्छा पूर्ण करावी असे मला वाटते;","poem":1},{"text":"तुमचे नियम माझ्या अंतःकरणात आहेत.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"विशाल सभेत तुमच्या तारणाच्या कृत्यांची घोषणा करतो;","poem":1},{"text":"त्याबाबतीत मी माझे ओठ मुळीच आवरून धरीत नाही,","poem":2},{"lineBreak":true},{"text":"याहवेह हे तुम्हाला माहीत आहे.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"हे नीतिमत्व मी माझ्या हृदयात दडवून ठेवले नाही,","poem":1},{"text":"मी तुमचा विश्वासूपणा आणि तुमच्या तारणाच्या मदतीची चर्चा करतो.","poem":2},{"text":"सर्व मंडळीपासून तुमची प्रीतिपूर्ण","poem":1},{"text":"दया आणि सत्य ही लपवित नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"याहवेह, तुमची कृपा माझ्यापासून राखून धरू नका;","poem":1},{"text":"तुमची प्रीती आणि विश्वासूपणा मला नेहमी सुरक्षित ठेवील.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"असंख्य समस्यांनी माझ्यावर मात केली आहे;","poem":1},{"text":"माझ्या अपराधांनी माझा पिच्छा पुरविला आहे आणि ते मी पाहू शकत नाही.","poem":2},{"text":"ते माझ्या डोक्यावरील केसांपेक्षा जास्त आहेत,","poem":1},{"text":"आणि माझे हृदय विव्हळत आहे.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"याहवेह, प्रसन्न होऊन मला वाचवा;","poem":1},{"text":"त्वरेने या, याहवेह मला साहाय्य करा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"माझ्या जीव घेऊ पाहणार्‍यांना","poem":1},{"text":"लज्जित करा व गोंधळात पाडा;","poem":2},{"text":"त्यांना मागे हटवून त्यांची","poem":1},{"text":"दाणादाण करून त्यांना घालवून द्या;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"जे लोक मला, “अहा! अहा!” म्हणतात,","poem":1},{"text":"ते स्वतःच्या लज्जेमुळे चकित होवोत.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"परंतु जे तुम्हाला शोधतात ते","poem":1},{"text":"तुमच्यामध्ये आनंद आणि हर्ष करोत;","poem":2},{"text":"जे तुमच्या तारणाच्या साहाय्याची अपेक्षा बाळगतात","poem":1},{"text":"ते सर्व हेच म्हणोत, “याहवेह किती थोर आहेत!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"मी गरीब आणि गरजवंत आहे,","poem":1},{"text":"याहवेहला माझी आठवण असो;","poem":2},{"text":"तुम्ही माझे साहाय्यकर्ता आणि मला सोडविणारे आहात;","poem":1},{"text":"माझ्या परमेश्वरा, विलंब लावू नका.","poem":2}]}],"footnotes":[{"noteId":21,"caller":"+","text":"किंवा असत्य दैवतांकडे","reference":{"chapter":40,"verse":4}}]},"thisChapterLink":"/api/mar_cbi/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}