{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":42,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी. कोरहाच्या मुलांचे मासकील."]},{"type":"verse","number":1,"content":[{"text":"हरणी जशी पाण्यासाठी उत्कट लालसा करते,","poem":1},{"text":"तसा हे परमेश्वरा, माझा जीव तुमच्यासाठी उत्कट लालसा करीत आहे.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"माझा जीव परमेश्वराकरिता, जिवंत परमेश्वराकरिता तहानलेला आहे.","poem":1},{"text":"मी केव्हा परमेश्वरासमोर येऊन त्यांचे दर्शन करणार?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"रात्र आणि दिवस,","poem":1},{"text":"माझे अश्रू माझा आहार झाले आहेत.","poem":2},{"text":"मला लोक सतत असे विचारीत आहेत.","poem":1},{"text":"“कुठे आहे तुझा परमेश्वर?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"या गोष्टींची आठवण करून","poem":1},{"text":"माझा आत्मा तुटत आहे:","poem":2},{"text":"कसे मी परमेश्वराच्या भवनाकडे जाणार्‍या","poem":1},{"text":"विशाल गर्दीचे नेतृत्व करीत होतो.","poem":2},{"text":"त्यावेळी उत्सवाच्या वातावरणात आनंद, जयघोष","poem":1},{"text":"आणि आभार यांचा आवाज प्रतिध्वनित होत होता.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"हे माझ्या जिवा, तू का खिन्न झालास?","poem":1},{"text":"आतल्याआत का तू तळमळत आहेस?","poem":2},{"text":"परमेश्वराची आशा धर.","poem":1},{"text":"मी अजूनही माझा तारणारा","poem":2},{"lineBreak":true},{"text":"आणि माझ्या परमेश्वराची स्तुती पुनः करेन.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"माझ्या परमेश्वरा, माझा जीव माझ्याठायी उदास झाला आहे;","poem":1},{"text":"तेव्हा मी यार्देन प्रदेशातून","poem":2},{"text":"आणि हर्मोनाच्या शिखरावरून, मिसहार पर्वतावरून","poem":1},{"text":"तुमचे स्मरण करणार.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तुमच्या गर्जणार्‍या धबधब्याप्रमाणे,","poem":1},{"text":"सागर सागराला आव्हान करतो;","poem":2},{"text":"तुमच्या सर्व लाटा व त्यांचा कल्लोळ","poem":1},{"text":"माझ्यावर झपाटून आदळत आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"तरी देखील याहवेह आपल्या अढळ प्रीतीचा वर्षाव","poem":1},{"text":"दिवसा माझ्यावर करतात, मला जीवन देणार्‍या परमेश्वराची","poem":2},{"lineBreak":true},{"text":"मी रात्रभर गीते गातो, प्रार्थना करतो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"मी आरोळी मारून म्हणतो,","poem":1},{"text":"“हे परमेश्वरा, माझ्या आश्रयाचे खडक,","poem":2},{"text":"तुम्ही मला का विसरलात?","poem":1},{"text":"शत्रूंच्या हल्ल्यामुळे शोकाकुल होऊन मी का फिरावे?”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"माझे शत्रू दिवसभर","poem":1},{"text":"थट्टेने मला विचारतात,","poem":2},{"text":"“तुझा परमेश्वर कुठे आहे?”","poem":1},{"text":"यामुळे माझ्या हाडांना नश्वर वेदना होत आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"हे माझ्या जिवा, तू खिन्न का झालास?","poem":1},{"text":"आतल्याआत का तळमळत आहेस?","poem":2},{"text":"परमेश्वरावर आपली आशा ठेव,","poem":1},{"text":"मी पुनः माझा तारणारा आणि","poem":2},{"lineBreak":true},{"text":"माझ्या परमेश्वराची स्तुती करेन.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}