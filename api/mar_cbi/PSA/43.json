{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"परमेश्वर, मला निर्दोष ठरवा","poem":1},{"text":"आणि भक्तिहीन पिढीविरुद्ध","poem":2},{"lineBreak":true},{"text":"माझ्या बाजूने निकाल द्या.","poem":2},{"text":"या दुष्ट आणि कपटी लोकांपासून","poem":1},{"text":"माझा बचाव करा.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"कारण परमेश्वर तुम्हीच माझे बळकट दुर्ग आहात;","poem":1},{"text":"तुम्ही माझा त्याग का केला?","poem":2},{"text":"शत्रूंद्वारे होणार्‍या छळामुळे","poem":1},{"text":"मी का दुःखी व्हावे?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तुमचा प्रकाश आणि तुमचे सत्य मला लाभोत;","poem":1},{"text":"तीच मला मार्ग दाखवोत;","poem":2},{"text":"तुमच्या पवित्र पर्वतावरील, तुमच्या निवासमंडपात,","poem":1},{"text":"तीच मला घेऊन जावोत.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तेव्हा मी परमेश्वराच्या वेदीजवळ जाईन,","poem":1},{"text":"तेच परमेश्वर जे माझे परमानंद आहेत;","poem":2},{"text":"आणि तिथे हे परमेश्वरा, माझ्या परमेश्वरा,","poem":1},{"text":"वीणेवर मी तुमची स्तुतिस्तोत्रे गाईन.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"हे माझ्या जिवा, तू खिन्न का झालास?","poem":1},{"text":"आतल्याआत का तळमळत आहेस?","poem":2},{"text":"परमेश्वरावर आपली आशा ठेव,","poem":1},{"text":"मी पुनः माझा तारणारा आणि","poem":2},{"lineBreak":true},{"text":"माझ्या परमेश्वराची स्तुती करेन.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}