{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी. कोरहाच्या पुत्रांची रचना. एक स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"अहो सर्व लोकांनो, टाळ्या वाजवा;","poem":1},{"text":"उत्साहपूर्ण शब्दांनी परमेश्वराचा जयजयकार करा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"कारण सर्वोच्च याहवेह भयप्रद आहेत;","poem":1},{"text":"ते अखिल पृथ्वीचे सार्वभौम राजा आहेत.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"त्यांनीच लोकांना आमच्या सत्तेखाली","poem":1},{"text":"आणि राष्ट्रांना आमच्या पायाखाली आणले.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ते आमच्यासाठी आमचे वतन निवडतात,","poem":1},{"text":"हेच याकोबाचे वैभव आहे, ज्यांच्यावर त्यांनी प्रीती केली. सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"प्रचंड जयघोष होत असताना, परमेश्वर वर गेले आहेत,","poem":1},{"text":"तुतार्‍यांचे मोठे निनाद होत असताना, याहवेह वर गेले आहेत.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"परमेश्वराची स्तुती गा, स्तुती गा;","poem":1},{"text":"आमच्या राजाची स्तुती गा, स्तुती गा.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"कारण परमेश्वर अखिल पृथ्वीचे राजाधिराज आहेत;","poem":1},{"text":"त्यांच्याप्रीत्यर्थ स्तुतिस्तोत्रे गा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"परमेश्वर सर्व राष्ट्रांवर सत्ता गाजवितात;","poem":1},{"text":"परमेश्वर आपल्या पवित्र सिंहासनावर विराजमान आहेत.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"जगातील लोकांचे अधिपती,","poem":1},{"text":"अब्राहामाच्या परमेश्वराचे लोक म्हणून एकत्र जमले आहेत;","poem":2},{"text":"पृथ्वीवरील राजे","poem":1},{"noteId":26},{"text":"वास्तविक परमेश्वराचेच आहेत,","poem":1},{"text":"ते अत्यंत थोर आहेत.","poem":2}]}],"footnotes":[{"noteId":26,"caller":"+","text":"किंवा ढाली","reference":{"chapter":47,"verse":9}}]},"thisChapterLink":"/api/mar_cbi/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}