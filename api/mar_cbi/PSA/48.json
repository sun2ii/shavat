{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":48,"content":[{"type":"hebrew_subtitle","content":["एक गीत. कोरहाच्या पुत्रांची एक स्तोत्र रचना."]},{"type":"verse","number":1,"content":[{"text":"याहवेह महान आहेत, आमच्या परमेश्वराच्या नगरामध्ये,","poem":1},{"text":"त्यांच्या पवित्र पर्वतावर ते सर्वोच्च स्तुतीस पात्र आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"त्यांचे शिखर मनोहर आहेत,","poem":1},{"text":"ज्यात संपूर्ण पृथ्वी आनंदित आहे,","poem":2},{"text":"सीयोन पर्वत उत्तरेकडील झाफोन","poem":1},{"noteId":27},{"text":"पर्वतासारखेच उंच आहे,","poem":1},{"text":"जे राजाधिराजाची नगरी आहे.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"परमेश्वराने स्वतःला तिच्या राजमहालांमध्ये","poem":1},{"text":"उंच आश्रयदुर्ग असे तिला प्रकट केले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ज्यावेळी राजांनी आपली सैन्ये एकवटली,","poem":1},{"text":"ज्यावेळी ते एकत्र होऊन आगेकूच करीत आले.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"त्यांनी हिला पाहिले आणि ते आश्चर्यचकित झाले;","poem":1},{"text":"भयभीत होऊन त्यांनी पळ काढला.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"त्या ठिकाणी त्यांना कापरे भरले;","poem":1},{"text":"स्त्रीला होणार्‍या प्रसूतीच्या वेदनांसारख्या वेदना त्यांना होऊ लागल्या.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"पूर्वेकडील वार्‍याने तार्शीशच्या गलबतांच्या नष्ट व्हाव्यात,","poem":1},{"text":"त्याप्रमाणे तुम्ही त्यांचा नाश केला.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"आम्ही जे ऐकले होते,","poem":1},{"text":"आणि आम्ही जे प्रत्यक्ष पहिले आहे","poem":2},{"text":"सर्वशक्तिमान याहवेहच्या नगरात,","poem":1},{"text":"आमच्या परमेश्वराच्या नगरात:","poem":2},{"text":"परमेश्वर सर्वकाळासाठी","poem":1},{"text":"तिला स्थिर करतील. सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"परमेश्वरा, तुमच्या मंदिरात,","poem":1},{"text":"आम्ही तुमच्या प्रेमदयेचे चिंतन करतो.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"हे परमेश्वरा, तुमच्या नावाप्रमाणे,","poem":1},{"text":"तुमची स्तुती देखील पृथ्वीवर सर्वत्र पसरली आहे.","poem":2},{"lineBreak":true},{"text":"तुमचा उजवा हात नीतिमत्तेने परिपूर्ण आहे.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तुमच्या न्यायकृत्यांमुळे","poem":1},{"text":"सीयोन पर्वत आनंद करो;","poem":2},{"lineBreak":true},{"text":"यहूदाहची नगरे हर्ष करोत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"सीयोनेभोवती फिरा, तिची फेरी मारा,","poem":1},{"text":"तिचे बुरूज मोजा.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तिची तटबंदी पाहा","poem":1},{"text":"आणि तिच्यातील राजवाडे न्याहाळून पाहा,","poem":2},{"text":"म्हणजे तुम्हाला तिचे वर्णन करून","poem":1},{"text":"तुमच्या पुढील पिढीला सांगता येईल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"कारण हेच आमचे सनातन परमेश्वर आहेत;","poem":1},{"text":"ते अखेरपर्यंत आमचे मार्गदर्शक राहतील.","poem":2}]}],"footnotes":[{"noteId":27,"caller":"+","text":"झाफोन कनानी लोकांचे अतिपवित्र डोंगर","reference":{"chapter":48,"verse":2}}]},"thisChapterLink":"/api/mar_cbi/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}