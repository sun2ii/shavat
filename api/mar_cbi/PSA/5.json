{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":5,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी; वाजंत्र्याच्या साथीने गावयाचे दावीदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"याहवेह, माझ्या शब्दांकडे कान द्या,","poem":1},{"text":"माझ्या विलापाकडे लक्ष द्या.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"हे माझ्या राजा, माझ्या परमेश्वरा,","poem":1},{"text":"माझ्या रडण्याकडे कान द्या,","poem":2},{"lineBreak":true},{"text":"कारण मी तुमच्याकडे प्रार्थना करतो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"याहवेह, दररोज सकाळी तुम्ही माझी वाणी ऐकता;","poem":1},{"text":"सकाळी मी माझ्या प्रार्थना तुम्हाला सादर करतो","poem":2},{"lineBreak":true},{"text":"व अपेक्षेने तुमची वाट पाहतो.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तुम्ही असे परमेश्वर नाहीत, ज्यांना दुष्टाईत आनंद होतो;","poem":1},{"text":"दुष्टांचे तुम्ही स्वागत करीत नाही.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तुमच्या उपस्थितीत","poem":1},{"text":"गर्विष्ठ उभे राहू शकत नाही.","poem":2},{"text":"अनीतीने वागणार्‍या सर्वांचा तुम्हाला वीट आहे.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"खोटे बोलणाऱ्यांचा तुम्ही त्यांना नाश करता.","poem":2},{"text":"खुनी आणि कपटींचा","poem":1},{"text":"याहवेहला तिरस्कार आहे.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"परंतु तुमच्या महान प्रीतीद्वारे,","poem":1},{"text":"मी तुमच्या भवनात येईन;","poem":2},{"text":"अत्यंत आदराने तुमच्या","poem":1},{"text":"पवित्र मंदिरात तुम्हाला नमन करतो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"याहवेह, मला तुमच्या नीतिमार्गाने चालवा,","poem":1},{"text":"माझ्या शत्रूंमुळे—","poem":2},{"lineBreak":true},{"text":"माझ्यासमोर तुमचा सरळ मार्ग मला दाखवा.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"त्यांच्या मुखातून निघालेल्या एकाही शब्दावर विश्वास ठेऊ शकत नाही;","poem":1},{"text":"त्यांचे हृदय द्वेषाने भरलेले आहे.","poem":2},{"text":"त्यांचे कंठ उघड्या कबरेप्रमाणे आहे;","poem":1},{"text":"त्यांच्या जिभेने ते खोटे बोलतात.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"परमेश्वर, त्यांना दोषी घोषित करा!","poem":1},{"text":"त्यांच्या कारस्थानामुळेच त्यांचे पतन होवो.","poem":2},{"text":"त्यांच्या अनेक अपराधांमुळे त्यांना तुमच्यापासून दूर घालवून द्या,","poem":1},{"text":"कारण त्यांनी तुमच्याविरुद्ध बंड केले आहे.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"परंतु जे सर्व तुमच्याठायी आश्रय घेतात ते आनंदित होवोत;","poem":1},{"text":"त्यांना सदैव हर्षगीते गाऊ द्या.","poem":2},{"text":"तुम्ही त्यांचे रक्षण करता,","poem":1},{"text":"ज्यांना तुमचे नाव प्रिय आहे, त्यांनी तुमच्यामध्ये आनंद करावा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"याहवेह, नीतिमानांना तुम्ही निश्चितच आशीर्वादित करता;","poem":1},{"text":"तुमची कृपा एखाद्या ढालीप्रमाणे त्यांना वेढलेली असते.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}