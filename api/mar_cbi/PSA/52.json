{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":52,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी. दावीदाचे मासकील. हा त्यावेळचा संदर्भ आहे, ज्यावेळी एदोमी दवेगने शौलाला कळविले की दावीद अहीमेलेखच्या घरी आहे."]},{"type":"verse","number":1,"content":[{"text":"हे बलवान पुरुषा, दुष्ट कृत्यांची बढाई का मारतोस,","poem":1},{"text":"तू दिवसभर कशाचा अभिमान बाळगतोस,","poem":2},{"lineBreak":true},{"text":"तू जो परमेश्वराच्या दृष्टीने निंदनीय आहेस?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तू जो फसव्या कृतीत गुंतलेला आहे,","poem":1},{"text":"दिवसभर तुझी जीभ तीक्ष्ण वस्तर्‍यासारखी","poem":2},{"lineBreak":true},{"text":"विनाशाची योजना करीत असते.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तुला चांगल्यापेक्षा दुष्टपणा,","poem":1},{"text":"सत्य बोलण्यापेक्षा असत्य अधिक प्रिय आहे. सेला","poem":2}]},{"type":"verse","number":4,"content":[{"text":"अगे कपटी जिभे,","poem":1},{"text":"अपायकारक बोलणे तुला प्रिय आहे!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"परंतु परमेश्वर तुला शाश्वत विनाशाकडे आणतील;","poem":1},{"text":"तुझ्या डेर्‍यातून तुला ओढून बाहेर काढतील","poem":2},{"lineBreak":true},{"text":"आणि जिवंतांच्या भूमीतून समूळ नष्ट करून तुला दूर नेतील. सेला","poem":2}]},{"type":"verse","number":6,"content":[{"text":"नीतिमान लोक भयचकित होऊन पाहतील;","poem":1},{"text":"ते त्याला हसतील व म्हणतील:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“पाहा, हा असा मनुष्य आहे","poem":1},{"text":"ज्याने परमेश्वराला आपले आश्रयस्थान बनविले नाही","poem":2},{"text":"तर आपल्या विपुल संपत्तीवर विश्वास ठेवला","poem":1},{"text":"आणि दुसर्‍यांचा नाश करून तो बलवान झाला!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"परंतु मी तर परमेश्वराच्या आश्रयाखालील","poem":1},{"text":"जैतून वृक्षाप्रमाणे सुरक्षित आहे;","poem":2},{"text":"परमेश्वराच्या अक्षय प्रीतिवर मी","poem":1},{"text":"सदासर्वकाळ विसंबून आहे.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"कारण तुम्ही जे काही केले","poem":1},{"text":"त्याबद्दल तुमच्या विश्वासू लोकांसमक्ष मी सदासर्वकाळ तुमची स्तुती करेन.","poem":2},{"text":"आणि मी तुमच्या नावाची आशा करेन,","poem":1},{"text":"कारण तुमचे नाव चांगले आहे.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}