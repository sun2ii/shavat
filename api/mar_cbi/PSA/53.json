{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":53,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी. माहलथवर आधारित, दावीदाचे मासकील."]},{"type":"verse","number":1,"content":[{"text":"मूर्ख आपल्या मनात म्हणतो,","poem":1},{"text":"“परमेश्वर अस्तित्वात नाही.”","poem":2},{"text":"ते बहकलेले आहेत आणि त्यांची कृत्ये दुष्टच समजावी,","poem":1},{"text":"कारण सत्कर्म करणारा कोणी नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"मानवांमध्ये कोणी समंजस आहे का","poem":1},{"text":"परमेश्वराचा शोध करणारे कोणी आहे का","poem":2},{"text":"हे पाहण्यासाठी परमेश्वर स्वर्गातून","poem":1},{"text":"खाली पाहतात.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"प्रत्येकजण भटकून गेलेला आहेत;","poem":1},{"text":"प्रत्येकजण भ्रष्ट झाला आहे;","poem":2},{"lineBreak":true},{"text":"सत्कर्म करणारा कोणीच नाही, एकही नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"दुष्कृत्य करणार्‍यांना हे ठाऊक नाही काय?","poem":1},{"lineBreak":true},{"text":"भाकरी खाण्यासारखे ते माझ्या लोकांना गिळून टाकतील.","poem":1},{"text":"ते कधीही परमेश्वराला हाक मारत नाहीत.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"पण पाहा, जिथे भिण्याचे कारण नव्हते, तिथे ते भयाने भरले.","poem":1},{"text":"परमेश्वराने त्यांची हाडे विखरून टाकली,","poem":2},{"text":"ज्यांनी तुमच्याविरुद्ध तळ दिला होता;","poem":1},{"text":"तुम्ही त्यांची फजिती केली, कारण ते परमेश्वराद्वारे लज्जित झाले आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"अहाहा! सीयोनातून इस्राएलची सुटका होईल!","poem":1},{"text":"जेव्हा परमेश्वर त्यांच्या प्रजेची पुनर्स्थापना करतील,","poem":2},{"lineBreak":true},{"text":"तेव्हा याकोब हर्ष करो आणि इस्राएल आनंद करो!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}