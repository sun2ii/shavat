{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी. तंतुवाद्यांच्या साथीने गायचे दावीदाचे मासकील. जेव्हा जिफी लोकांनी जाऊन शौलाला कळविले: “दावीद आमच्याजवळ लपला आहे.”"]},{"type":"verse","number":1,"content":[{"text":"परमेश्वरा, तुम्ही आपल्या नावाने माझे तारण करा;","poem":1},{"text":"आपल्या सामर्थ्याने मला निर्दोष जाहीर करा.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"परमेश्वरा, माझी प्रार्थना ऐका.","poem":1},{"text":"माझ्या मुखातील शब्दांकडे कान द्या.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"कारण परकी माणसे माझ्याविरुद्ध उठली आहेत;","poem":1},{"text":"परमेश्वराचा आदर न करणारे निर्दयी लोक—","poem":2},{"lineBreak":true},{"text":"माझा जीव घेण्याचा प्रयत्न करीत आहेत. सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"परंतु परमेश्वर निश्चितच माझे साहाय्यकर्ता आहेत;","poem":1},{"text":"परमेश्वरच आहेत, जे मला मदत करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"माझ्या शत्रूंच्या दुष्ट कृत्त्यांचा मोबदला त्यांना मिळो;","poem":1},{"text":"परमेश्वरा, तुम्ही आपल्या विश्वासूपणाने त्यांचा नाश करा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"मी स्वेच्छेने माझे यज्ञ तुम्हाला अर्पण करणार;","poem":1},{"text":"याहवेह, तुमच्या नावाची महिमा मी गाईन, कारण तुमचे नाव उत्तम आहे.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तुम्ही मला माझ्या सर्व संकटातून सोडविले आहे,","poem":1},{"text":"आणि माझ्या डोळ्यांनी माझ्या शत्रूंचा पराजय पहिला आहे.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}