{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":55,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी. तंतुवाद्यांच्या साथीने गायचे दावीदाचे मासकील."]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वरा, माझी प्रार्थना ऐका;","poem":1},{"text":"माझ्या विनवणीकडे दुर्लक्ष करू नका.","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"माझे ऐका आणि मला उत्तर द्या;","poem":2},{"text":"माझ्या विचारांनी मी त्रस्त आणि व्याकूळ झालो आहे.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"माझ्या शत्रूंच्या आवाजाने","poem":2},{"lineBreak":true},{"text":"आणि दुष्टांच्या धमक्यांमुळे मी कण्हत आहे,","poem":2},{"text":"कारण ते माझ्यावर अनर्थ आणतात","poem":1},{"text":"आणि रागाने माझी निर्भत्सना करतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"माझ्या हृदयात अत्यंत मनोवेदना होत आहेत;","poem":1},{"text":"मरणाची भीती मला दडपून टाकीत आहे.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"भीती आणि कंप यांनी मला ग्रस्त केले आहे.","poem":1},{"text":"अतिभयाने मला ग्रासले आहे.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"अहाहा, मला कबुतराचे पंख असते तर किती उत्तम झाले असते!","poem":1},{"text":"दूर उडत जाऊन मी विश्रांती घेतली असती.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"अतिदूरच्या रानात मी उडून गेलो असतो","poem":1},{"text":"आणि तिथेच वस्ती केली असती. सेला","poem":2}]},{"type":"verse","number":8,"content":[{"text":"या तुफानी वारा आणि वादळापासून","poem":1},{"text":"मी माझ्या आश्रयस्थानी उडून गेलो असतो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"प्रभू, दुष्टांमध्ये फूट पाडा, त्यांच्या शब्दांना गोंधळात टाका,","poem":1},{"text":"कारण शहरात मला हिंसा आणि कलह दिसतात.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"रात्रंदिवस ते तटाभोवती फिरत असतात;","poem":1},{"text":"दुष्टपणा व अनीतिमानपणा नगरात आहे.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"नगरात विध्वंसक शक्ती कार्यरत आहेत;","poem":1},{"text":"धमक्या आणि खोट्या गोष्टी कधीही त्यांचा मार्ग सोडत नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ज्याने माझी निंदा केली,","poem":1},{"text":"तो काही माझा शत्रू नव्हता;","poem":2},{"text":"असता तर मी ते सहन केले असते;","poem":1},{"text":"मी लपून बसलो असतो आणि निसटून गेलो असतो.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"परंतु माझी निंदा करणारा तूच होतास, माझ्यासारखाच मनुष्य,","poem":1},{"text":"माझा सोबती आणि माझा जिवलग मित्र,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"जेव्हा आम्ही आराधकांसह चालत होतो,","poem":1},{"text":"तेव्हा त्याच्यासोबत परमेश्वराच्या भवनातील","poem":2},{"text":"मधुर सहभागितेचा","poem":1},{"text":"मी आनंद घेतला होता.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"मृत्यू माझ्या शत्रूंना अकस्मात गाठो;","poem":1},{"text":"ते जिवंतच अधोलोकात उतरले जावोत,","poem":2},{"lineBreak":true},{"text":"कारण त्यांच्या घरात, त्यांच्या आत्म्यात दुष्टपणा आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"मी तर परमेश्वराचा","poem":1},{"text":"धावा करेन आणि याहवेह माझे तारण करतील.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"संध्याकाळी, सकाळी आणि दुपारी","poem":1},{"text":"मी वेदनांनी आरोळी देईन","poem":2},{"lineBreak":true},{"text":"आणि ते माझी वाणी ऐकतील.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"जरी माझे बरेच विरोधक तिथे होते,","poem":1},{"text":"जे युद्ध माझ्याविरुद्ध सुरू होते,","poem":2},{"lineBreak":true},{"text":"तरी ते मला कोणतीही इजा होऊ न देता सोडवितात.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"परमेश्वर प्राचीन काळापासून","poem":1},{"text":"राजासनारूढ आहेत, जे बदलत नाहीत—","poem":2},{"text":"ते त्यांचे ऐकतील व त्यांना नम्र करतील,","poem":1},{"text":"कारण त्यांना परमेश्वराचे भय नाही. सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"माझा जोडीदार आपल्याच मित्रांवर प्रहार करीत आहे;","poem":1},{"text":"त्याने केलेला करार तोच मोडत आहे.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"त्याचे शब्द लोण्याप्रमाणे मृदू वाटतात,","poem":1},{"text":"पण त्याच्या अंतःकरणात युद्ध सुरू आहे;","poem":2},{"text":"त्याचे शब्द तेलापेक्षाही मऊ होते,","poem":1},{"text":"पण उगारलेल्या तलवारींसारखे होते.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"तू आपला भार याहवेहवर टाक","poem":1},{"text":"आणि ते तुला आधार देतील;","poem":2},{"text":"नीतिमानाला ते कधीही","poem":1},{"text":"विचलित होऊ देणार नाही.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"परंतु, हे परमेश्वरा, तुम्ही शत्रूंना","poem":1},{"text":"नाशाच्या गर्तेत लोटून द्याल;","poem":2},{"text":"खुनी आणि लबाड लोक","poem":1},{"text":"त्यांचे अर्धे आयुष्यही जगणार नाहीत.","poem":2},{"lineBreak":true},{"text":"परंतु मी तर तुमच्यावरच भरवसा ठेवतो.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}