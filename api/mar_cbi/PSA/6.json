{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":6,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी; तंतुवाद्यावरचे शेमीनीथ",{"noteId":4},"वर आधारित दावीदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"याहवेह, रागाने माझा निषेध करू नका,","poem":1},{"text":"तीव्र क्रोधाने मला शासन करू नका.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मजवर दया करा, कारण हे याहवेह, मी दुर्बल आहे;","poem":1},{"text":"मला रोगमुक्त करा, कारण माझ्या हाडात तीव्र वेदना होत आहेत.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"माझा आत्मा अत्यंत यातनेत आहे.","poem":1},{"text":"याहवेह, तुम्ही किती विलंब लावणार?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"याहवेह, परत येऊन मला सोडवा;","poem":1},{"text":"तुमच्या दयेनुसार मला वाचवा.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"मृतलोकात तुमचे स्मरण नाही;","poem":1},{"text":"गर्तेमध्ये तुमचे उपकारस्मरण कोण करणार?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"माझ्या कण्हण्याने मी खंगून गेलो आहे.","poem":1},{"lineBreak":true},{"text":"रात्रभर रडण्याने मी माझे अंथरूण भिजून ओलेचिंब करतो.","poem":1},{"text":"माझ्या अश्रूंनी माझा बिछाना भिजून जातो.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"दुःखाने माझे डोळे निस्तेज झाले आहेत;","poem":1},{"text":"माझ्या शत्रूंमुळे माझी दृष्टी क्षीण झाली आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"दुष्टाई करणार्‍यांनो, येथून चालते व्हा,","poem":1},{"text":"कारण याहवेहनी माझे रडणे ऐकले आहे.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"याहवेहनी माझ्या दयेची याचना ऐकली आहे;","poem":1},{"text":"याहवेह माझ्या प्रार्थना स्वीकार करतील.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"माझे सर्व शत्रू भय आणि लज्जा पावतील;","poem":1},{"text":"ते मागे फिरतील आणि तत्काळ लज्जित होतील.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"शीर्षक: संगीतातील एक शब्द","reference":{"chapter":6,"verse":0}}]},"thisChapterLink":"/api/mar_cbi/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}