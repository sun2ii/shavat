{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी. तंतुवाद्याच्या साथीने गायचे दावीदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वरा, माझा धावा ऐका,","poem":1},{"text":"माझ्या प्रार्थनेकडे लक्ष द्या.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"दिगंतापासून मी तुमचा धावा करतो","poem":1},{"text":"माझे हृदय व्याकूळ झाले असताना;","poem":2},{"lineBreak":true},{"text":"तुम्हीच मला उंच खडकावर न्या.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"कारण तुम्हीच माझे आश्रयस्थान,","poem":1},{"text":"शत्रूविरुद्ध उंच बुरूज आहात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"तुमच्या मंडपात सदासर्वकाळ राहण्यास","poem":1},{"text":"आणि तुमच्या पंखांच्या सावलीखाली आश्रय घेण्यास मी उत्कंठित आहे. सेला","poem":2}]},{"type":"verse","number":5,"content":[{"text":"कारण परमेश्वरा, मी तुम्हाला केलेला नवस तुम्ही ऐकला आहे","poem":1},{"text":"आणि तुमच्या नावाचे भय धरणार्‍यांचे वतन तुम्ही मला दिले आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"तुम्ही राजाचे आयुष्य वाढवा;","poem":1},{"text":"ते अनेक पिढ्यांमधील पूर्ण भरलेल्या वर्षाप्रमाणे होवो.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तो परमेश्वराच्या समोर सदासर्वकाळ राहो.","poem":1},{"text":"तुमची प्रीती आणि सत्य त्याच्या रक्षणाकरिता प्रकट करा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"म्हणजे मी तुमच्या नावाला सतत धन्यवाद देईन","poem":1},{"text":"आणि दररोज माझी शपथ पूर्ण करेन.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}