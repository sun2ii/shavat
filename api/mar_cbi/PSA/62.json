{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":62,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी. यदूथूनाच्या चालीवर आधारित. दावीदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"परमेश्वरामध्ये निश्चितच माझ्या जिवास विश्रांती आहे;","poem":1},{"text":"माझे तारण त्यांच्याकडून येते.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"फक्त तेच माझे खडक आणि माझे तारण;","poem":1},{"text":"तेच माझा दुर्ग आहेत, माझे ढळणे अशक्य आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"तुम्ही सर्वजण या एका मनुष्याला खाली पाडावयास,","poem":1},{"text":"कुठपर्यंत माझ्यावर प्रहार करीत राहणार?","poem":2},{"lineBreak":true},{"text":"मी तर एका वाकलेल्या भिंतीसारखा, कोसळलेल्या कुंपणासारखा आहे.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मला उच्च स्थानावरून खाली","poem":1},{"text":"पाडण्याचा त्यांचा बेत आहे;","poem":2},{"lineBreak":true},{"text":"त्यांना खोटे बोलणे आवडते;","poem":2},{"text":"ते आपल्या तोंडाने आशीर्वाद देतात,","poem":1},{"text":"परंतु मनातून शाप देतात. सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"तरीही माझा आत्मा परमेश्वरामध्ये शांती पावेल;","poem":1},{"text":"माझी आशा त्यांच्यापासून आहे.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"खरोखर तेच माझे खडक, तेच माझे तारण,","poem":1},{"text":"तेच माझे दुर्ग आहेत; मी ढळणार नाही.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"माझे तारण आणि माझा सन्मान परमेश्वरावर अवलंबून","poem":1},{"noteId":31},{"text":"आहे;","poem":1},{"text":"तेच माझे भक्कम खडक, माझे आश्रय आहेत.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"माझ्या लोकांनो, तुम्ही सर्वकाळ त्यांच्यावर भरवसा ठेवा;","poem":1},{"text":"आपले हृदय त्यांच्यापुढेच मोकळे करा,","poem":2},{"lineBreak":true},{"text":"कारण परमेश्वरच आमचे आश्रयस्थान आहेत. सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"साधारण मानव श्वासमात्र आहेत;","poem":1},{"text":"विशिष्ट मानव फक्त मिथ्या आहेत;","poem":2},{"text":"तराजूत वजन केले की ते हलकेच भरतील;","poem":1},{"text":"ते सर्व श्वासमात्र आहेत.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"पिळवणूकीच्या धनावर विश्वास ठेवू नका","poem":1},{"text":"किंवा चोरी केलेल्या वस्तूंवर व्यर्थ आशा ठेवू नका;","poem":2},{"text":"जरी तुमची संपत्ती वाढत असेल,","poem":1},{"text":"तरी तिच्यावर मन लावू नका.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"परमेश्वर एकदा बोलले आहेत,","poem":1},{"text":"मी दोनदा हे ऐकले आहे:","poem":2},{"text":"“सामर्थ्य याहवेहचेच आहे,","poem":1}]},{"type":"verse","number":12,"content":[{"text":"आणि प्रभू, तुमच्यामध्ये प्रेमदया सदैव असते;”","poem":2},{"text":"आणि, “तुम्ही प्रत्येकाला त्याच्या","poem":1},{"text":"कृत्यानुसार प्रतिफळ देता.”","poem":2}]}],"footnotes":[{"noteId":31,"caller":"+","text":"किंवा परमेश्वरच आहे","reference":{"chapter":62,"verse":7}}]},"thisChapterLink":"/api/mar_cbi/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}