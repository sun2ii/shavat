{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":63,"content":[{"type":"hebrew_subtitle","content":["यहूदीयाच्या रानात असताना रचलेले दावीदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वरा, तुम्ही माझे परमेश्वर आहात,","poem":1},{"text":"मी तुमचा कळकळीने शोध करतो;","poem":2},{"text":"या कोरड्या आणि वैराण भूमीत","poem":1},{"text":"माझा जीव तुमच्यासाठी तहानलेला झाला आहे;","poem":2},{"text":"माझे सर्वस्व तुमच्यासाठी किती","poem":1},{"text":"उत्कंठित झाले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"तुमचे सामर्थ्य आणि गौरव","poem":1},{"text":"मी तुमच्या पवित्रस्थानी पाहिले आहे.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"कारण तुमची प्रीती जीवनाहून उत्तम आहे,","poem":1},{"text":"माझे ओठ तुमचे गौरव करतील.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"माझ्या जिवात जीव आहे तोपर्यंत मी तुम्हाला धन्यवाद देईन","poem":1},{"text":"आणि माझे हात तुमच्या नावाने उंच करेन.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"उत्कृष्ट भोजनाने व्हावे तसा मी तृप्त होईल;","poem":1},{"text":"गीत गाणार्‍या ओठांनी मी तुमची स्तुती करेन.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"माझ्या बिछान्यावर मी तुमचे स्मरण करतो;","poem":1},{"text":"रात्रीच्या प्रत्येक प्रहरी मी तुमचे मनन करतो.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"कारण तुम्ही माझे साहाय्य आहात,","poem":1},{"text":"तुमच्या पंखांच्या सावलीत मी गीत गातो.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"मी तुम्हाला बिलगून राहतो;","poem":1},{"text":"तुमचा उजवा हात मला सावरून धरतो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"जे मला मारू इच्छितात त्यांचा नाश होईल;","poem":1},{"text":"ते पृथ्वीच्या खोल रसातळी जातील.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तलवारीच्या धारेने ते पडतील;","poem":1},{"text":"कोल्ह्यांचे ते भक्ष्य होतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"परंतु राजा परमेश्वरामध्ये उल्हास करेल;","poem":1},{"text":"जे लोक परमेश्वराची शपथ घेतात, ते सर्व त्याचे गौरव होईल;","poem":2},{"lineBreak":true},{"text":"परंतु लबाडांची तोंडे बंद होतील.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}