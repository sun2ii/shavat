{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":64,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी. दावीदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वरा, माझे गार्‍हाणे ऐका;","poem":1},{"text":"शत्रूंच्या भयापासून माझ्या जिवास सुरक्षित ठेवा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"दुष्टांच्या षडयंत्रापासून आणि गुन्हेगार टोळक्यांच्या","poem":1},{"text":"कारस्थानापासून मला लपवा.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तलवारीप्रमाणे ते आपल्या जिभांना धारदार करतात","poem":1},{"text":"आणि बाणांप्रमाणे तीक्ष्ण असलेल्या कटुशब्दांनी लक्ष्य करतात.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"दबा धरून ते निरपराध्यांवर बाण सोडतात;","poem":1},{"text":"ते निर्भयपणे अकस्मात त्यांच्यावर मारा करतात;","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"दुष्कृत्य करण्यास ते एकमेकांना प्रोत्साहन देतात;","poem":1},{"text":"सापळे आखण्यासाठी ते गुप्तपणे एकत्र जमतात;","poem":2},{"lineBreak":true},{"text":"ते म्हणतात, “ते","poem":2},{"noteId":32},{"text":"कोण पाहणार?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ते कुटिल योजना बनवून म्हणतात,","poem":1},{"text":"“आता आम्ही उत्तम योजना तयार केली आहे!”","poem":2},{"lineBreak":true},{"text":"मानवी अंतःकरण आणि हृदय समजणे कठीण आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"परंतु स्वतः परमेश्वरच त्यांचा बाण मारतील;","poem":1},{"text":"अचानक ते घायाळ होतील.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"परमेश्वर त्यांची जीभ त्यांच्याच विरुद्ध करतील","poem":1},{"text":"आणि त्यांचा नाश करतील.","poem":2},{"lineBreak":true},{"text":"जे सर्व त्यांना पाहतील, ते उपहासाने आपले डोके हालवतील.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"मग सर्व मानव घाबरतील;","poem":1},{"text":"ते परमेश्वराच्या कृत्यांची थोरवी गातील;","poem":2},{"lineBreak":true},{"text":"आणि त्यांनी केलेल्या चमत्काराविषयी मनन करतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"पण नीतिमान लोक याहवेहमध्ये आनंद करतील","poem":1},{"text":"व त्यांचा आश्रय घेतील,","poem":2},{"lineBreak":true},{"text":"सरळ हृदयाचे त्यांचे स्तवन करतील!","poem":2}]}],"footnotes":[{"noteId":32,"caller":"+","text":"ते किंवा आम्हाला","reference":{"chapter":64,"verse":5}}]},"thisChapterLink":"/api/mar_cbi/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}