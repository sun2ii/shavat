{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":65,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी. दावीदाचे एक स्तोत्र. एक गीत."]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वरा, तुमची स्तुती सीयोनेत अपेक्षित","poem":1},{"noteId":33},{"text":"आहे;","poem":1},{"text":"तुम्हाला केलेला नवस तिथे पूर्ण करण्यात येईल.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तुम्हीच प्रार्थनेचे उत्तर देता,","poem":1},{"text":"म्हणून तुमच्याकडे सर्व लोक येतील.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"आमची अंतःकरणे पापांनी भरलेली असली,","poem":1},{"text":"तरी तुम्ही आमच्या अपराधांची क्षमा","poem":2},{"noteId":34},{"text":"केली.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तुमच्या अंगणात येऊन राहण्यासाठी","poem":1},{"text":"तुम्ही ज्यांची निवड केली, ते धन्य!","poem":2},{"text":"आम्ही तुमच्या मंदिरातील पवित्रस्थानाच्या","poem":1},{"text":"उत्कृष्ट पदार्थांनी संतुष्ट होऊ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"तुमच्या अद्भुत आणि नीतिकार्याद्वारे तुम्ही आम्हाला प्रत्युत्तर देता,","poem":1},{"text":"परमेश्वर, आमचे तारणकर्ता,","poem":2},{"text":"पृथ्वीच्या टोकापर्यंत आणि दुर्गम समुद्रापर्यंत,","poem":1},{"text":"तुम्ही सर्व भक्तांची आशा आहात.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"आपल्या महान शक्तीने त्यांनी पर्वतांना","poem":1},{"text":"त्यांच्या ठिकाणी स्थिर ठेवले आहे.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तुम्ही महासागराच्या खवळलेल्या","poem":1},{"text":"लाटांना शांत करता","poem":2},{"lineBreak":true},{"text":"आणि सर्व राष्ट्रांचे कोलाहल शांत करता.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"संपूर्ण पृथ्वी तुमच्या महाकृत्याने विस्मित होते;","poem":1},{"text":"सूर्योदय आणि सूर्यास्त ही","poem":2},{"lineBreak":true},{"text":"आनंदाने जयघोष करीत आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"तुम्ही या भूमीची काळजी घेता","poem":1},{"text":"व ती सिंचनासाठी देता.","poem":2},{"text":"आपण ते विपुल व समृद्ध करता. लोकांना धान्य मिळावे","poem":1},{"text":"म्हणून परमेश्वराच्या नद्या पाण्याने भरल्या आहेत,","poem":2},{"lineBreak":true},{"text":"कारण तुम्ही ते निर्धारित केले आहे.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तुम्ही नांगरलेल्या सऱ्यांना पाणी देता आणि तुम्ही तिचे उंचवटे सपाट करता;","poem":1},{"text":"पावसाच्या सरींनी तिला मऊ करता; तिच्या अंकुरांना आशीर्वाद देता.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तुम्ही तुमच्या औदार्यासह वर्षास शिरोभूषण चढविता","poem":1},{"text":"आणि तुमच्या गाड्या समृद्धीने ओसांडत आहेत.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"राने हिरव्यागार लुसलुशीत गवताने आच्छादून टाकता;","poem":1},{"text":"टेकड्या आनंदाची वस्त्र परिधान करतात.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"हिरवीगार कुरणे कळपांनी भरून जातात","poem":1},{"text":"आणि दर्‍यांची भूमी धान्यांनी आच्छादली जाते;","poem":2},{"lineBreak":true},{"text":"ती आनंदाने गजर करीत गाऊ लागते.","poem":2}]}],"footnotes":[{"noteId":33,"caller":"+","text":"अपेक्षित किंवा योग्य आहे","reference":{"chapter":65,"verse":1}},{"noteId":34,"caller":"+","text":"किंवा प्रायश्चित केले","reference":{"chapter":65,"verse":3}}]},"thisChapterLink":"/api/mar_cbi/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}