{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":67,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी. तंतुवाद्यांच्या साथीने. एक स्तोत्र. एक गीत."]},{"type":"verse","number":1,"content":[{"text":"परमेश्वर आमच्यावर कृपा करो आणि आम्हाला आशीर्वाद देवो","poem":1},{"text":"आणि त्यांचा मुखप्रकाश आम्हावर पडो; सेला","poem":2}]},{"type":"verse","number":2,"content":[{"text":"यासाठी की पृथ्वीवर तुमचे मार्ग प्रकट व्हावे,","poem":1},{"text":"तुम्ही सिद्ध केलेले तारण सर्व राष्ट्रांना कळावे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"हे परमेश्वरा, राष्ट्रे तुमचे स्तवन करोत,","poem":1},{"text":"सर्व राष्ट्रे तुमचे स्तवन करोत.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"राष्ट्रे हर्ष करोत आणि आनंदाने जयघोष करोत,","poem":1},{"text":"कारण तुम्ही न्यायाने लोकांचा न्यायनिवाडा कराल","poem":2},{"lineBreak":true},{"text":"आणि पृथ्वीवरील राष्ट्रांना मार्ग दाखवाल. सेला","poem":2}]},{"type":"verse","number":5,"content":[{"text":"हे परमेश्वरा, राष्ट्रे तुमचे स्तवन करोत;","poem":1},{"text":"सर्व राष्ट्रे तुमचे स्तवन करोत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"कारण पृथ्वीने विपुल उपज दिला आहे;","poem":1},{"text":"परमेश्वर, आमचे परमेश्वर, आम्हाला आशीर्वाद देतात.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"परमेश्वर आम्हाला अजूनही आशीर्वाद देवोत,","poem":1},{"text":"जेणेकरून पृथ्वीवरील सर्व सीमा त्यांचे भय धरतील.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}