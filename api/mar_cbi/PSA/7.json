{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":7,"content":[{"type":"hebrew_subtitle","content":["बिन्यामीनी कूशच्या बोलण्यावरून याहवेहस गायलेले दावीदाचे शिग्गायोन."]},{"type":"verse","number":1,"content":[{"text":"याहवेह, माझ्या परमेश्वरा, मी तुमचा आश्रय घेतो;","poem":1},{"text":"जे माझ्या पाठीस लागले आहेत, त्या सर्वांपासून माझे रक्षण करा आणि मला सोडवा.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"नाहीतर, सिंहाप्रमाणे ते मला फाडून टाकतील;","poem":1},{"text":"मला सोडविण्यास कोणीही नाही म्हणून ते माझे तुकडे तुकडे करतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"याहवेह, माझ्या परमेश्वरा, मी जर असे केले असेल,","poem":1},{"text":"माझे हात सदोष असतील,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"जर मी माझ्या मित्राच्या चांगुलपणाचा मोबदला दुष्टपणाने दिला असेल,","poem":1},{"text":"माझ्या शत्रूला विनाकारण लुबाडले असेल—","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तर माझे शत्रू माझा पाठलाग करोत व मला पकडोत;","poem":1},{"text":"माझा जीव मातीत तुडवो","poem":2},{"lineBreak":true},{"text":"आणि माझे गौरव धुळीस मिळवो. सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"हे याहवेह, आपल्या रागाने उठा;","poem":1},{"text":"माझ्या शत्रूंच्या क्रोधाविरुद्ध उभे राहा;","poem":2},{"lineBreak":true},{"text":"जागे व्हा आणि न्याय्य निर्णय द्या.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"उच्चस्थानी सिंहासनावर आरूढ असता,","poem":1},{"text":"सर्व राष्ट्रांनी तुमच्याभोवती एकत्र जमावे.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"याहवेहच, सर्व मानवजातीचा न्याय करोत.","poem":2},{"text":"माझ्या प्रामाणिकपणानुसार तुम्ही माझे समर्थन करा.","poem":1},{"text":"हे सर्वोच्च परमेश्वरा! माझ्या धार्मिकतेनुसार माझा न्याय करा.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"दुष्टांच्या दुष्टाईचा अंत करा","poem":1},{"text":"नीतिमानाला स्थिर करा—","poem":2},{"text":"तुम्ही, हे नीतिमान परमेश्वरा,","poem":1},{"text":"मने व अंतःकरणे पारखणारे परमेश्वर आहात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"सर्वोच्च परमेश्वर माझ्या रक्षणाची ढाल","poem":1},{"noteId":5},{"text":"आहेत,","poem":1},{"text":"जे सरळ मनाचे आहेत, त्यांना ते वाचवितात.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"परमेश्वर नीतिमान न्यायाधीश आहेत,","poem":1},{"text":"जे दुष्टाईचा सदैव तिरस्कार करतात.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"दुष्टांनी आपले मार्ग बदलले","poem":1},{"noteId":6},{"text":"नाहीत,","poem":1},{"text":"तर परमेश्वर आपली तलवार पाजळतील;","poem":2},{"lineBreak":true},{"text":"आपले धनुष्य वाकवून त्याची दोरी ताणली आहे. मन","poem":2}]},{"type":"verse","number":13,"content":[{"text":"त्यांनी आपली घातक शस्त्रे सज्ज केली आहेत;","poem":1},{"text":"आपले अग्निबाण तयार ठेवले आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"जे दुष्टपणाचा वेणा देतात,","poem":1},{"text":"ते उपद्रवाचे गर्भधारण करतात आणि फसवणुकीला जन्म देतात.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"जे खड्डा खणतात आणि माती काढून खोल करतात","poem":1},{"text":"ते स्वतःच त्यांनी खणलेल्या खड्ड्यात पडतात.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"त्यांच्या दुष्टाईने त्यांनाच शासन होते;","poem":1},{"text":"त्यांची हिंसा त्यांच्याच डोक्यावर येऊन बसते.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"याहवेहच्या न्यायीपणाबद्दल मी ॠणी राहीन.","poem":1},{"text":"परमोच्च याहवेहच्या नावाची मी स्तुतिस्तोत्रे गाईन.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"किंवा सार्वभौम","reference":{"chapter":7,"verse":10}},{"noteId":6,"caller":"+","text":"किंवा पश्चात्ताप केला नाही","reference":{"chapter":7,"verse":12}}]},"thisChapterLink":"/api/mar_cbi/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}