{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी. दावीदाची रचना. एक याचिका."]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वरा, त्वरा करून मला वाचवा;","poem":1},{"text":"याहवेह, मला साहाय्य करण्यासाठी त्वरेने या.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"माझा जीव घेऊ पाहणार्‍यांना","poem":1},{"text":"लज्जित करा व गोंधळात पाडा;","poem":2},{"text":"जे सर्वजण माझे विघ्नसंतोषी आहेत","poem":1},{"text":"ते अप्रतिष्ठित होऊन माघारी फिरोत.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जे लोक मला, “अहाहा! अहाहा!” म्हणतात,","poem":1},{"text":"ते लज्जित होऊन माघारी फिरोत.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"परंतु जे सर्व तुमचा शोध घेतात","poem":1},{"text":"ते तुमच्यामध्ये आनंद आणि हर्ष करोत;","poem":2},{"text":"जे तुमच्या तारणाच्या साहाय्याची अपेक्षा बाळगतात","poem":1},{"text":"ते सर्व नेहमी हेच म्हणोत, “परमेश्वर किती महान आहेत!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"परंतु मी तर गरीब आणि गरजवंत आहे;","poem":1},{"text":"हे परमेश्वरा, माझ्याकडे त्वरेने या.","poem":2},{"text":"तुम्ही माझे साहाय्यकर्ता आणि मला सोडविणारे आहात;","poem":1},{"text":"याहवेह, विलंब करू नका.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}