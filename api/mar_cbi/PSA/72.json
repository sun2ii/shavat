{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":72,"content":[{"type":"hebrew_subtitle","content":["शलोमोनाची गीत रचना"]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वरा, राजाला न्यायदातृत्व","poem":1},{"text":"आणि राजपुत्रास नीतिमत्व प्रदान करा.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तो तुमच्या लोकांचा नीतीने न्याय करो,","poem":1},{"text":"तुमच्या पीडितांचा न्यायनिवाडा न्यायीपणाने करो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"मग पर्वत लोकांना समृद्धी प्रदान करो,","poem":1},{"text":"आणि डोंगर नीतिमत्वाची फळे उत्पादित करो.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तो लोकांमधील पीडितांचा बचाव करो","poem":1},{"text":"आणि गरजूंच्या मुलांना वाचवो;","poem":2},{"lineBreak":true},{"text":"तो जुलमीला चिरडून टाको.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"जोपर्यंत सूर्य आणि चंद्र आकाशात राहतील,","poem":1},{"text":"तोपर्यंत पिढ्यान् पिढ्या तुमचे भय बाळगून तुमचा आदर करोत.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"कापलेल्या गवतावर पडणार्‍या पावसाप्रमाणे,","poem":1},{"text":"पृथ्वीला पाणी देणार्‍या सरीप्रमाणे तो होवो.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"त्याच्या कारकिर्दीत सर्व नीतिमानांची भरभराट होवो","poem":1},{"text":"आणि चंद्र नाहीसा होईपर्यंत समृद्धी वाढो.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"त्याची सत्ता एका समुद्रापासून दुसऱ्या समुद्रापर्यंत","poem":1},{"text":"आणि नदीपासून","poem":2},{"noteId":36},{"text":"पृथ्वीच्या दिगंतापर्यंत राहो.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"अरण्यातील लोक त्याच्यासमोर नतमस्तक होवोत","poem":1},{"text":"आणि त्याचे शत्रू धूळ चाटोत.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तार्शीश आणि तटवर्तीय राजे","poem":1},{"text":"आपआपले नजराणे आणोत,","poem":2},{"text":"शबा व सबा यांचे सर्व राजे","poem":1},{"text":"आपले उपहार आणोत.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"होय, सर्व ठिकाणचे राजे त्याला नमन करोत;","poem":1},{"text":"सर्व राष्ट्रे त्याची सेवा करोत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ज्यांचा कोणी सहायक नाही अशा","poem":1},{"text":"धावा करणार्‍या दुःखितांना तो मुक्त करेल.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"दुर्बल आणि दरिद्री यांची त्याला दया येवो;","poem":1},{"text":"तो गरजवंताला मृत्यूपासून वाचवेल.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"तो त्यांना छळ आणि हिंसा यांच्यापासून वाचवेल,","poem":1},{"text":"कारण त्यांचे जीवित रक्त मोलाचे आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"तो चिरायू होवो!","poem":1},{"text":"त्याला शबाचे सोने मिळो;","poem":2},{"text":"त्याचे लोक सतत त्याच्यासाठी प्रार्थना करोत","poem":1},{"text":"आणि दिवसभर त्याला आशीर्वाद देवोत.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"देशभर विपुल धान्य उगवो;","poem":1},{"text":"लबानोनच्या","poem":2},{"noteId":37},{"text":"शिखरावर ते डोलू द्या,","poem":2},{"text":"देशातील डोंगरही धान्याने आच्छादून जावोत;","poem":1},{"text":"शेतातील भरगच्च गवताप्रमाणे शहरे लोकांनी भरून गजबजून जावोत.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"त्याचे नाव सर्वकाळ राहो,","poem":1},{"text":"जोपर्यंत सूर्य आहे, त्याचे नाव वाढत जावो.","poem":2},{"lineBreak":true},{"text":"सर्व राष्ट्रे त्याच्याद्वारे आशीर्वादित होवोत,","poem":1},{"text":"आणि ते त्याला धन्य म्हणोत.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"इस्राएलाचे परमेश्वर, याहवेह धन्यवादित असोत,","poem":1},{"text":"केवळ तेच महान कार्य करतात.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"त्यांच्या गौरवशाली नावाचे सदासर्वकाळ स्तवन होवो;","poem":1},{"text":"सर्व पृथ्वी त्यांच्या गौरवाने भरो.","poem":2},"आमेन आणि आमेन."]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"इशायाचा पुत्र दावीदच्या प्रार्थना समाप्त झाल्या.","poem":1}]}],"footnotes":[{"noteId":36,"caller":"+","text":"अर्थात् फरात नदी किंवा ज्याला आजच्या काळात युफ्रेटिस या नावाने ओळखले जाते","reference":{"chapter":72,"verse":8}},{"noteId":37,"caller":"+","text":"किंवा डोंगराच्या","reference":{"chapter":72,"verse":16}}]},"thisChapterLink":"/api/mar_cbi/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}