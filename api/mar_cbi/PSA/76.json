{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":76,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी. तंतुवाद्यांच्या साथीने. आसाफाचे एक स्तोत्र. एक गीत."]},{"type":"verse","number":1,"content":[{"text":"परमेश्वर यहूदीयात प्रसिद्ध आहेत;","poem":1},{"text":"इस्राएलमध्ये त्यांचे नाव थोर आहे.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"त्यांचा मंडप शालेम येथे आहे,","poem":1},{"text":"त्यांचे निवासस्थान सीयोन येथे आहे.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिथे त्यांनी चमकणारे बाण,","poem":1},{"text":"ढाली आणि तलवारी, युद्धाची शस्त्रे मोडली. सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"तुम्ही प्रकाशाने तेजस्वी आहात,","poem":1},{"text":"प्राण्यांनी समृद्ध असलेल्या पर्वतांपेक्षा अधिक वैभवी.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"प्रबळांची लूटमार झाली आहे,","poem":1},{"text":"ते मृत्यूची निद्रा घेत आहेत;","poem":2},{"text":"त्यांच्यातील एकाही योद्ध्याला","poem":1},{"text":"हात उचलता येत नाही.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"हे याकोबाच्या परमेश्वरा, तुम्ही फटकारल्यावर","poem":1},{"text":"घोडे आणि स्वार गाढ झोपेत गेले आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"तुम्हीच एकटेच भयास योग्य आहात.","poem":1},{"text":"जेव्हा आपण रागावता, तेव्हा आपल्यासमोर कोण उभा राहू शकतो?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"स्वर्गातून तुम्ही आपला निर्णय जाहीर केला,","poem":1},{"text":"तेव्हा पृथ्वीचा थरकाप उडाला आणि ती स्तब्ध झाली—","poem":2}]},{"type":"verse","number":9,"content":[{"text":"पृथ्वीवरील पीडितांचे रक्षण करण्यासाठी,","poem":1},{"text":"परमेश्वर उठून उभे राहिले तेव्हा असे झाले. सेला","poem":2}]},{"type":"verse","number":10,"content":[{"text":"खचित तुमचा मनुष्यावरचा क्रोध तुमच्या स्तुतीस कारणीभूत होईल,","poem":1},{"text":"आणि तुमच्या रोषाने उर्वरितांना रोखण्यात आले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"तुमचे परमेश्वर याहवेह यांना केलेले सर्व नवस तुम्ही फेडा;","poem":1},{"text":"शेजारच्या प्रत्येक राष्ट्राने त्यांच्यासाठी भेटी आणाव्यात;","poem":2},{"lineBreak":true},{"text":"त्यांच्याबद्दल आदर आणि भीती बाळगावी.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"कारण ते अधिपतींचा अभिमान नष्ट करतील;","poem":1},{"text":"पृथ्वीवरील राजांकरिता ते भयावह आहेत.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}