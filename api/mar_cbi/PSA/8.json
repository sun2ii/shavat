{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":8,"content":[{"type":"hebrew_subtitle","content":["संगीत दिग्दर्शकासाठी. गित्तीथ वर आधारित दावीदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"याहवेह, आमच्या प्रभो,","poem":1},{"text":"संपूर्ण पृथ्वीवर तुमचे नाव किती वैभवी आहे!","poem":2},{"lineBreak":true},{"text":"स्वर्गदेखील तुमचे","poem":1},{"text":"गौरव प्रकट करते.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"लेकरे आणि तान्ह्या बालकांच्या स्तुतीद्वारे","poem":1},{"text":"तुमचे शत्रू व विरोध्यांना शांत करण्यासाठी","poem":2},{"lineBreak":true},{"text":"शत्रूविरुद्ध बळ स्थापित केले आहे.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जेव्हा तुमच्या बोटांची रचना असलेल्या","poem":1},{"text":"आकाशाकडे बघून मी विचार करतो,","poem":2},{"text":"चंद्र आणि तारे यथास्थानी","poem":1},{"text":"स्थापित केलेले पाहतो,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"मनुष्य तो काय की तुम्ही त्याची आठवण ठेवावी?","poem":1},{"text":"मानवप्राणी तो काय की तुम्ही त्याची काळजी करावी?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"तुम्ही त्यांना देवदूतांपेक्षा किंचित कमी असे घडविले आहे.","poem":1},{"text":"गौरव आणि सन्मान यांचा मुकुट तुम्ही त्यांच्या डोक्यावर ठेवला आहे.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तुमच्या प्रत्येक हस्तकृतीवर तुम्ही त्यांना सत्ता दिली आहे;","poem":1},{"text":"सर्वगोष्टी त्यांच्या पायाखाली ठेवल्या.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"सर्व कळप व गुरे,","poem":1},{"text":"आणि वनपशू.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"आकाशातील पक्षी,","poem":1},{"text":"आणि समुद्रातील मासे,","poem":2},{"lineBreak":true},{"text":"सागरात संचार करणारे सर्व प्राणी.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"याहवेह, आमच्या प्रभो,","poem":1},{"text":"संपूर्ण पृथ्वीवर तुमचे नाव किती वैभवी आहे!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}