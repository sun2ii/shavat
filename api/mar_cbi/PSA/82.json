{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["आसाफाचे एक स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"परमेश्वराने महासभेत आपले स्थान ग्रहण केले आहे;","poem":1},{"text":"त्यांनी “दैवतांसमोर” आपला न्याय जाहीर केला आहे:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"तुम्ही कुठवर दुष्टांचे समर्थन करणार,","poem":1},{"text":"अन्यायी लोकांसाठी पक्षपात करत राहणार? सेला","poem":2}]},{"type":"verse","number":3,"content":[{"text":"दुबळे आणि पितृहीनांचे समर्थन करा,","poem":1},{"text":"गरीब आणि पीडलेल्यांना यथायोग्य न्याय द्या.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"दुर्बल आणि गरजवंत लोकांना वाचवा;","poem":1},{"text":"दुष्टांच्या तावडीतून त्यांना सोडवा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"इतर “दैवतां” ना काहीही कळत नाही, काहीही समजत नाही.","poem":1},{"text":"ते अंधकारात चालतात;","poem":2},{"lineBreak":true},{"text":"पृथ्वीचे सर्व पाये डळमळीत झाले आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“मी म्हटले, ‘तुम्ही “दैवते” आहात;","poem":1},{"text":"तुम्ही सर्वोच्च परमेश्वराचे पुत्र आहात.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"परंतु तुम्ही मर्त्य मानवांप्रमाणेच मराल;","poem":1},{"text":"आणि इतर शासकाप्रमाणे तुमचे पतन होईल.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"हे परमेश्वरा, उठा आणि जगाचा न्याय करा,","poem":1},{"text":"कारण समस्त राष्ट्र तुमचे वतन आहे.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}