{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":84,"content":[{"type":"hebrew_subtitle","content":["संगीत निर्देशकाकरिता. गित्तीथ",{"noteId":46},"वर आधारित. कोरहाच्या पुत्रांची रचना. एक स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"हे सर्वशक्तिमान याहवेह,","poem":1},{"text":"तुमचे निवासस्थान किती रम्य आहे!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"याहवेह तुमच्या अंगणाच्या उत्कंठेने मी,","poem":1},{"text":"मूर्छित होईपर्यंत आतुर झालो आहे;","poem":2},{"text":"माझा जीव व माझा देह","poem":1},{"text":"जिवंत परमेश्वराला आरोळी मारीत आहे.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"हे सर्वशक्तिमान याहवेह, माझ्या राजा आणि माझ्या देवा,","poem":1},{"text":"तुमच्या वेद्यांजवळ","poem":2},{"lineBreak":true},{"text":"चिमणीला घरटी बांधण्याचे,","poem":2},{"text":"व निळवीला देखील आपली पिल्ले ठेवण्याचे","poem":1},{"text":"ठिकाण सापडले आहे.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"जे तुमच्या मंदिरात राहू शकतात, ते किती धन्य आहेत;","poem":1},{"text":"ते निरंतर तुमचे स्तवन करतात. सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ज्या मनुष्याच्या सामर्थ्याचा उगम तुम्हीच आहात, ते किती धन्य आहेत,","poem":1},{"text":"ज्यांचे अंतःकरण तुमच्या मार्गाचे यात्रेकरू आहेत.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ते बाका दरीतून","poem":1},{"noteId":47},{"text":"जात असताना,","poem":1},{"text":"ती त्यांना झर्‍यांचे स्थान होईल;","poem":2},{"lineBreak":true},{"text":"शरदॠतूतील पाऊसही तिला आशीर्वादाने झाकून टाकील.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"सीयोनात परमेश्वराच्या समोर प्रत्येकजण उपस्थित होईपर्यंत,","poem":1},{"text":"त्यांचे सामर्थ्य दिवसेंदिवस वाढेल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"याहवेह, सर्वशक्तिमान परमेश्वरा, माझी प्रार्थना ऐका;","poem":1},{"text":"याकोबाच्या परमेश्वरा, माझे ऐका. सेला","poem":2}]},{"type":"verse","number":9,"content":[{"text":"हे परमेश्वरा, तुम्ही आमच्या ढालीवर दृष्टी टाका;","poem":1},{"text":"आपल्या अभिषिक्तावर कृपादृष्टी करा.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"तुमच्या अंगणात घालविलेला एक दिवस,","poem":1},{"text":"इतर कुठेही घालविलेल्या सहस्र दिवसांपेक्षा उत्तम आहे;","poem":2},{"text":"दुष्टाईच्या मंडपात राहण्यापेक्षा,","poem":1},{"text":"माझ्या परमेश्वराच्या भवनाचा द्वारपाल होऊन राहण्यात मला अधिक आनंद आहे.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"कारण याहवेह परमेश्वर आमचा सूर्य आणि आमची ढाल आहेत;","poem":1},{"text":"ते आम्हाला कृपा व गौरव देतात;","poem":2},{"text":"जे निष्कलंक असतात,","poem":1},{"text":"त्यांच्यापासून ते कोणतीही उत्तम गोष्ट रोखून धरणार नाहीत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"सर्वशक्तिमान याहवेह, जे लोक तुमच्यावर भाव ठेवतात,","poem":1},{"text":"ते कितीतरी धन्य होत.","poem":2}]}],"footnotes":[{"noteId":46,"caller":"+","text":"शीर्षक: बहुतेक संगीत संबंधित एक शब्द","reference":{"chapter":84,"verse":0}},{"noteId":47,"caller":"+","text":"बाका दरी अर्थात् रडण्याची दरी","reference":{"chapter":84,"verse":6}}]},"thisChapterLink":"/api/mar_cbi/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}