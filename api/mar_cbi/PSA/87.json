{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["कोरहाच्या पुत्रांची रचना. एक स्तोत्र. एक गीत."]},{"type":"verse","number":1,"content":[{"text":"त्यांनी पवित्र पर्वतावर त्यांच्या नगरीचा पाया घातला.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"याकोबाच्या सर्व नगरांपेक्षा,","poem":1},{"text":"सीयोनाचे व्दार याहवेहला अधिक प्रिय आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"परमेश्वराच्या नगरी,","poem":1},{"text":"तुझ्याबद्दल या उत्कृष्ट गोष्टी कथन होतात: सेला","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“मी नोंद करेन की, राहाब","poem":1},{"noteId":48},{"text":"आणि बाबिलोन","poem":1},{"text":"हे देश माझे अस्तित्व मान्य करतात—","poem":2},{"text":"पलेशेथ, सोर आणि कूश देखील असेच करतात—","poem":1},{"text":"ते म्हणतील की, ‘हा सीयोनात जन्मलेला आहे.’ ”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"खरोखर, त्या दिवसात सीयोनाबाबत म्हटले जाईल,","poem":1},{"text":"“हा आणि तो सीयोनात जन्मलेला आहे,","poem":2},{"lineBreak":true},{"text":"आणि प्रत्यक्ष देवाधिदेव या शहराला प्रस्थापित करतील.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"नागरिकांच्या नोंदवहीत याहवेह लिहितील:","poem":1},{"text":"“याचा जन्म सीयोनात झाला आहे.” सेला","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"संगीत समारंभात ते गातील,","poem":1},{"text":"“माझे सर्व झरे तुमच्यामध्येच आहेत.”","poem":2}]}],"footnotes":[{"noteId":48,"caller":"+","text":"इजिप्तसाठी काव्यातील नाव","reference":{"chapter":87,"verse":4}}]},"thisChapterLink":"/api/mar_cbi/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}