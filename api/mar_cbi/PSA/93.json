{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेह राज्य करतात; ऐश्वर्याची वस्त्रे त्यांनी परिधान केली आहेत;","poem":1},{"text":"याहवेहनी राजेशाही वस्त्रे परिधान केली आहेत आणि ते शक्तीने सुसज्जित आहेत;","poem":2},{"lineBreak":true},{"text":"निश्चितच, त्यांनी पृथ्वी अत्यंत स्थिर व अढळ केलेली आहे.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तुमचे सिंहासन अनादिकालापासून स्थापलेले आहे;","poem":1},{"text":"तुम्ही अनंतकाळापासून आहात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"याहवेह, महासागर उसळत आहेत;","poem":1},{"text":"महासागरांनी त्यांचा स्वर उंच केलेला आहे;","poem":2},{"lineBreak":true},{"text":"समुद्राच्या प्रचंड लाटांचा प्रहार उग्र होत आहे.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"सर्व बलाढ्य लाटांहून कितीतरी अधिक शक्तिशाली,","poem":1},{"text":"तुम्ही महासागरापेक्षाही अधिक बलशाली आहात—","poem":2},{"lineBreak":true},{"text":"सर्वोच्च स्थानातील याहवेह सर्वशक्तिमान आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"हे याहवेह, तुमच्या आज्ञा अटळ आहेत;","poem":1},{"text":"पवित्रता हे तुमच्या भवनाचे","poem":2},{"lineBreak":true},{"text":"अनंतकाळचे आभूषण आहे.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}