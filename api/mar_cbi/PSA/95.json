{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"या हो या, आपण याहवेहचा जयजयकार करू या;","poem":1},{"text":"आपल्या तारणाच्या खडकासाठी आनंदाने जयघोष करू या.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"कृतज्ञ अंतःकरणांनी त्यांच्यापुढे येऊ;","poem":1},{"text":"आणि वाद्यसंगीतासह स्तुतिस्तोत्रे गाऊन स्तवन करू.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"कारण याहवेह हे महान परमेश्वर आहेत;","poem":1},{"text":"समस्त दैवतांवर ते सर्वोच्च राजा आहेत.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"पृथ्वीची खोल स्थळे त्यांच्या नियंत्रणात आहेत,","poem":1},{"text":"आणि पर्वताची शिखरेही त्यांचीच आहेत.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"समुद्र त्यांचेच आहेत, कारण ते त्यांनी उत्पन्न केले,","poem":1},{"text":"आणि कोरडी भूमीही त्यांचीच हस्तरचना आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"या हो या, आपण नतमस्तक होऊन आराधना करू या,","poem":1},{"text":"आपले उत्पन्नकर्ता याहवेह, यांच्यापुढे गुडघे टेकू;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"कारण ते आपले परमेश्वर आहेत.","poem":1},{"text":"आपण त्यांच्या कुरणातील प्रजा","poem":2},{"lineBreak":true},{"text":"आणि त्यांचा संरक्षित मेंढरांचा कळप आहोत.","poem":2},{"lineBreak":true},{"text":"आज जर तुम्ही त्यांची वाणी ऐकली, तर किती बरे!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"“मरीबाह","poem":1},{"noteId":52},{"text":"येथे असताना केली तशी,","poem":1},{"text":"जसे मस्सा","poem":2},{"noteId":53},{"text":"च्या दिवशी तुम्ही रानामध्ये केले तसे, तुमची अंतःकरणे कठीण करू नका.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"माझे अनेक चमत्कार पाहिलेले असतानाही,","poem":1},{"text":"तुमच्या पूर्वजांनी माझी परीक्षा घेऊन मला कसोटीस लावले.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"चाळीस वर्षे त्या पिढीवर मी फार संतापलो;","poem":1},{"text":"मी म्हणालो, ‘या लोकांची हृदये भटकलेली आहेत","poem":2},{"lineBreak":true},{"text":"आणि त्यांना माझे मार्ग कळलेच नाही.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"मग मी रागाने शपथ घेतली की,","poem":1},{"text":"‘ते माझ्या विसाव्यात कधीही प्रवेश करणार नाहीत.’ ”","poem":2}]}],"footnotes":[{"noteId":52,"caller":"+","text":"मरीबाह अर्थात् भांडण","reference":{"chapter":95,"verse":8}},{"noteId":53,"caller":"+","text":"मस्सा परीक्षा","reference":{"chapter":95,"verse":8}}]},"thisChapterLink":"/api/mar_cbi/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}