{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेह राज्य करतात, सर्व पृथ्वी उल्हासित होवो;","poem":1},{"text":"दूर असलेले तटवर्ती क्षेत्रही हर्ष करोत.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मेघ व गडद अंधकार यांनी ते वेढलेले आहेत;","poem":1},{"text":"धार्मिकता आणि न्याय त्यांच्या राजासनाचा पाया आहे.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"अग्नी त्यांच्यापुढे चालतो,","poem":1},{"text":"आणि त्यांच्या शत्रूंना तो सर्व बाजूने भस्म करतो.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"त्यांच्या विजा जगाला प्रकाश देतात;","poem":1},{"text":"हे पाहून पृथ्वी कंपित होते.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"याहवेहच्या उपस्थितीत, समस्त पृथ्वीचे सत्ताधीश","poem":1},{"text":"व सगळे पर्वत मेणाप्रमाणे वितळतात.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"आकाश मंडल त्यांची नीतिमत्ता जाहीर करते;","poem":1},{"text":"संपूर्ण मानवजात त्यांचे गौरव पाहते.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"जे प्रतिमांची प्रौढी मिरवित होते,","poem":1},{"text":"ते मूर्तींचे सर्व उपासक फजीत झाले.","poem":2},{"lineBreak":true},{"text":"सर्व दैवतांनो, त्यांची आराधना करा!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"सीयोन ऐकते व उल्हासित होते,","poem":1},{"text":"याहवेह, तुमच्या निर्णयामुळे,","poem":2},{"lineBreak":true},{"text":"यहूदीयातील गावे हर्षभरित होतात.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"कारण याहवेह तुम्हीच पृथ्वीवर परमश्रेष्ठ आहात;","poem":1},{"text":"सर्व दैवतांहून तुम्ही अत्यंत थोर आहात.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"याहवेहवर प्रीती करणारे वाईटाचा द्वेष करोत,","poem":1},{"text":"कारण ते त्यांच्या भक्तांच्या जिवाचे रक्षण करतात","poem":2},{"lineBreak":true},{"text":"आणि दुष्टांच्या हातातून त्यांना सोडवितात.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"नीतिमानांवर प्रकाश उजळतो","poem":1},{"text":"आणि निष्ठावंताची हृदये हर्ष पावतात.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"सर्व नीतिमान, याहवेहच्या ठायी आनंद करा,","poem":1},{"text":"आणि त्यांच्या पवित्र नावाला गौरव द्या.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}