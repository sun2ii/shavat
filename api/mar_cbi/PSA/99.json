{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_cbi","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"fb6bf337f078840aa079b13f695d7a2be6aabdca1b56d1f3c38998457d64297d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_cbi/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"याहवेह राज्य करतात,","poem":1},{"text":"राष्ट्रे थरथर कापोत;","poem":2},{"text":"ते करुबांमध्ये सिंहासनावर आरूढ झाले आहेत;","poem":1},{"text":"सर्व पृथ्वी कंपित होवो.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"अतिमहान होत सीयोनातील याहवेह;","poem":1},{"text":"ते सर्व राष्ट्रात परमोच्च असे आहेत.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"राष्ट्रे तुमच्या थोर व भयावह नामाची स्तुती करोत—","poem":1},{"text":"याहवेह पवित्र आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"राजा सामर्थ्यशाली आहेत, त्यांना न्याय प्रिय आहे—","poem":1},{"text":"तुम्ही याकोबात","poem":2},{"text":"निष्पक्षपात प्रस्थापित केला;","poem":1},{"text":"जो न्यायसंगत व रास्त आहे.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"आपले परमेश्वर याहवेहची थोरवी गा,","poem":1},{"text":"व त्यांच्या चरणी आराधना करा;","poem":2},{"lineBreak":true},{"text":"याहवेह पवित्र आहेत.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"मोशे आणि अहरोन त्यांचे याजक होते,","poem":1},{"text":"व शमुवेल त्यांचा उपासक, त्यांचा धावा करणार्‍यांपैकी होते;","poem":2},{"text":"यांनी याहवेहचा धावा केला,","poem":1},{"text":"आणि त्यांनी त्यांना उत्तर दिले.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ते त्यांच्याशी मेघस्तंभातून बोलले;","poem":1},{"text":"त्यांच्याकडे सोपविलेल्या अधिनियमांचे व आदेशांचे त्या लोकांनी पालन केले.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"याहवेह, आमच्या परमेश्वरा,","poem":1},{"text":"तुम्ही त्यांना उत्तर दिले;","poem":2},{"text":"त्यांच्या दुष्कृत्यांची त्यांना शिक्षा केली,","poem":1},{"text":"तरी इस्राएलसाठी तुम्ही क्षमाशील परमेश्वर होता.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"आपल्या परमेश्वराची थोरवी गा,","poem":1},{"text":"आणि त्यांच्या पवित्र पर्वतावर उपासना करा,","poem":2},{"lineBreak":true},{"text":"कारण आपले परमेश्वर याहवेह पवित्र आहेत.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}