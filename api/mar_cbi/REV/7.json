{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"REV","translationId":"mar_cbi","name":"प्रकटीकरण","commonName":"प्रकटीकरण","title":"योहानाला झालेले प्रकटीकरण","order":66,"numberOfChapters":22,"sha256":"37ba333c9b2793ff6f04b13d8ad55f3db2d17108a38025eb86d028c3b7518412","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/mar_cbi/REV/22.json","totalNumberOfVerses":401},"chapter":{"number":7,"content":[{"type":"heading","content":["एक लाख चव्वेचाळीस हजारांवर शिक्कामोर्तब"]},{"type":"verse","number":1,"content":["त्यानंतर पृथ्वीच्या चारही कोपर्‍यांवर चार देवदूत उभे राहिलेले मी पाहिले. पृथ्वीवरील भूमी, समुद्र किंवा कोणताही वृक्ष, यावर वाहू नये म्हणून ते त्या चारही वार्‍यांना थोपवून धरीत होते."]},{"type":"verse","number":2,"content":["मग दुसरा देवदूत पूर्वेच्या दिशेने हातात जिवंत परमेश्वराचा शिक्का घेऊन येताना मी पाहिला. पृथ्वीला व समुद्राला इजा करण्याचे काम ज्या चार देवदूतांवर सोपविले होते, त्या चार देवदूतांना तो ओरडून म्हणाला,"]},{"type":"verse","number":3,"content":["“आम्ही परमेश्वराच्या सेवकांच्या कपाळावर परमेश्वराचा शिक्का मारीपर्यंत पृथ्वी, समुद्र किंवा वृक्ष यांना काहीही इजा करू नका.”"]},{"type":"verse","number":4,"content":["ज्या लोकांवर हा शिक्का मारण्यात आला त्यांची संख्या मी ऐकली: ते इस्राएलच्या सर्व बारा वंशांमधून 1,44,000 लोक होते."]},{"type":"line_break"},{"type":"verse","number":5,"content":["यहूदाह वंशातून 12,000; रऊबेन वंशातून 12,000; गाद वंशातून 12,000;"]},{"type":"verse","number":6,"content":["आशेर वंशातून 12,000; नफताली वंशातून 12,000; मनश्शेह वंशातून 12,000;"]},{"type":"verse","number":7,"content":["शिमोन वंशातून 12,000; लेवी वंशातून 12,000; इस्साखार वंशातून 12,000;"]},{"type":"verse","number":8,"content":["जबुलून वंशातून 12,000; योसेफ वंशातून 12,000; बन्यामीन वंशातून 12,000."]},{"type":"heading","content":["शुभ्र वस्त्र परिधान केलेला प्रचंड समुदाय"]},{"type":"verse","number":9,"content":["यानंतर मी पाहिले आणि सर्व राष्ट्रे, वंश, लोक व भाषा यातील इतके लोक होते की त्यांचे मोजमाप करणे अशक्य होते. ते सर्व शुभ्र वस्त्रे घालून, हातात खजुरीच्या झावळ्या घेऊन, राजासनासमोर आणि कोकरासमोर उभे होते."]},{"type":"verse","number":10,"content":["ते प्रचंड आवाजात घोषणा करीत होते:",{"text":"“राजासनावर बसलेल्या","poem":1},{"lineBreak":true},{"text":"आमच्या परमेश्वरापासून आणि","poem":1},{"lineBreak":true},{"text":"कोकर्‍यापासून तारणप्राप्ती होत आहे.”","poem":1}]},{"type":"verse","number":11,"content":["तेव्हा सर्व देवदूत राजासन व वडीलजन आणि चार सजीव प्राणी यांच्याभोवती उभे होते आणि राजासनासमोर दंडवत घालून उपासना करीत असताना"]},{"type":"verse","number":12,"content":["ते म्हणाले:",{"text":"“आमेन!","poem":1},{"lineBreak":true},{"text":"आमच्या परमेश्वराला","poem":1},{"lineBreak":true},{"text":"धन्यवाद, गौरव, सुज्ञता,","poem":1},{"lineBreak":true},{"text":"उपकारस्तुती, मान, सामर्थ्य","poem":1},{"lineBreak":true},{"text":"आणि पराक्रम सदासर्वकाळ असो.","poem":1},{"lineBreak":true},{"text":"आमेन!”","poem":1}]},{"type":"verse","number":13,"content":["मग या चोवीस वडीलजनांपैकी एकाने मला विचारले, “हे शुभ्र पोशाख घातलेले कोण आहेत व ते कुठून आले आहेत?”"]},{"type":"verse","number":14,"content":["मी म्हटले, “महाराज, ते तुम्हाला माहीत आहे.” तेव्हा ते म्हणाले, “जे महान संकटातून निभावून येतात, ते हे आहेत. त्यांनी आपले झगे कोकर्‍याच्या रक्ताने धुऊन शुभ्र केले आहेत."]},{"type":"verse","number":15,"content":["म्हणूनच,",{"text":"“आज ते येथे परमेश्वराच्या राजासनासमोर,","poem":1},{"text":"त्यांच्या मंदिरात, त्यांची अहोरात्र सेवा करीत आहेत. जे राजासनावर बसलेले आहेत,","poem":2},{"text":"ते त्यांच्या सानिध्यात","poem":1},{"text":"त्यांना आश्रय देतील.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"त्यांना पुन्हा कधी भूक,","poem":1},{"text":"किंवा तहान लागणार नाही;","poem":2},{"text":"त्यांना सूर्याचा ताप,","poem":1},{"noteId":6},{"text":"किंवा दाहक उष्णता बाधणार नाही.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"कारण राजासनापुढे मध्यभागी असलेला कोकरा","poem":1},{"text":"त्यांचा मेंढपाळ होईल,","poem":2},{"text":"‘ते त्यांना जीवनाच्या पाण्याच्या झर्‍याजवळ नेईल,’","poem":1},{"text":"‘आणि परमेश्वर त्यांच्या डोळ्यांतील सर्व अश्रू पुसून टाकतील.’","poem":2},{"noteId":7},{"text":"”","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"यश 49:10","reference":{"chapter":7,"verse":16}},{"noteId":7,"caller":"+","text":"यश 25:8","reference":{"chapter":7,"verse":17}}]},"thisChapterLink":"/api/mar_cbi/REV/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/REV/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/REV/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}