{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"SNG","translationId":"mar_cbi","name":"गीतरत्न","commonName":"गीतरत्न","title":"गीतरत्न","order":22,"numberOfChapters":8,"sha256":"bc0fbea9e9742ebbad28a4562e1e4d8d9f3e381318564333d1ca335ac0fd925f","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/mar_cbi/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["हे गीतरत्न, शलोमोनाची रचना."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"तो आपल्या मुखाच्या चुंबनांनी माझे चुंबन घेवो—","poem":1},{"text":"कारण तुझे प्रेम हे द्राक्षारसापेक्षा आनंददायक आहे.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तुझ्या अत्तरांचा सुगंध सुखदायक आहे;","poem":1},{"text":"तुझे नाव ओतलेल्या अत्तरासारखे आहे.","poem":2},{"lineBreak":true},{"text":"तरुण कुमारी तुझ्यावर प्रेम करतात यात आश्चर्य नाही!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"चल घाई करू या! मला तुझ्याबरोबर दूर घेऊन जा!","poem":1},{"text":"राजाने मला आपल्या अंतःपुरात न्यावे.","poem":2},"मैत्रिणी",{"text":"आम्ही तुझ्यामध्ये उल्हास आणि हर्षित होऊ","poem":1},{"noteId":0},{"text":";","poem":1},{"text":"आम्ही द्राक्षारसापेक्षा तुझी अधिक प्रशंसा करू.","poem":2},"नायिका",{"text":"त्यांनी तुझ्यावर प्रीती करणे किती यथार्थ आहे!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"अहो यरुशलेमच्या कन्यांनो,","poem":1},{"text":"मी सावळी असूनही सुंदर आहे,","poem":2},{"text":"केदारच्या काळ्या तंबूसारखी,","poem":1},{"text":"शलोमोनच्या डेर्‍याच्या पडद्यासारखी.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मी सावळी आहे म्हणून माझ्याकडे टक लावून पाहू नका,","poem":1},{"text":"कारण मी सूर्यामुळे काळवंडले आहे.","poem":2},{"text":"माझ्या आईची मुले माझ्यावर रागावली","poem":1},{"text":"आणि त्यांनी मला द्राक्षमळ्याची राखण करावयास लावले;","poem":2},{"lineBreak":true},{"text":"पण मी स्वतःच्या द्राक्षमळ्याकडे दुर्लक्षित केले.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"मी तुझ्यावर प्रेम करते, तर तूच मला सांग,","poem":1},{"text":"तुझा कळप तू कुठे चरावयास नेतो","poem":2},{"lineBreak":true},{"text":"आणि मध्यानाच्या वेळी तू तुझ्या मेंढ्यांना कुठे विसाव्याला लावतोस.","poem":2},{"text":"पडद्यात असलेल्या स्त्रीप्रमाणे","poem":1},{"text":"तुझ्या सोबत्यांच्या कळपाच्या बाजूला मी का असावे?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"अगे स्त्रियांमधील परमसुंदरी, जर तुला ठाऊक नाही,","poem":1},{"text":"तर कळपांच्या ठशांचे अनुसरण करत ये","poem":2},{"text":"आणि मेंढपाळाच्या तंबूशेजारी","poem":1},{"text":"तू आपली करडे चार.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"माझ्या प्रिये, फारोहच्या रथामधील घोडीशी,","poem":1},{"text":"मी तुझी तुलना करतो.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"तुझे गाल कर्णभूषणासह,","poem":1},{"text":"तुझा गळा दागिन्यांच्या साखळीसह किती सुंदर आहे.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"आपण तुझ्यासाठी सोन्याचे,","poem":1},{"text":"रुपेजडित असे कर्णभूषण घडवून घेऊ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"राजा त्याच्या मेजाजवळ असता,","poem":1},{"text":"माझ्या अत्तराचा सुगंध दरवळत होता.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"माझा प्रियकर माझ्यासाठी माझ्या स्तनांमध्ये ठेवलेल्या","poem":1},{"text":"गंधरसाच्या पुडीप्रमाणे आहे.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"माझा प्रिय माझ्यासाठी जणू","poem":1},{"text":"एन-गेदीच्या द्राक्षमळ्यात असलेल्या मेंदीच्या फुलांचा गुच्छच आहे.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"माझ्या प्रिये, तू किती सुंदर आहेस!","poem":1},{"text":"अहा, किती सुंदर!","poem":2},{"lineBreak":true},{"text":"तुझे नयन कबुतरे आहेत.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"माझ्या वल्लभा, तू किती सुंदर दिसतोस!","poem":1},{"text":"अहा, किती मोहक!","poem":2},{"lineBreak":true},{"text":"आणि आपले अंथरूण ताजेतवाने आहे.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"आमच्या घराच्या तुळया केदारच्या;","poem":1},{"text":"व छपर देवदारूच्या लाकडाचे आहे.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"हिब्रू भाषेमध्ये एकवचनी आहे.","reference":{"chapter":1,"verse":4}}]},"thisChapterLink":"/api/mar_cbi/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}