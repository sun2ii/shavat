{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"SNG","translationId":"mar_cbi","name":"गीतरत्न","commonName":"गीतरत्न","title":"गीतरत्न","order":22,"numberOfChapters":8,"sha256":"bc0fbea9e9742ebbad28a4562e1e4d8d9f3e381318564333d1ca335ac0fd925f","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/mar_cbi/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"मी शारोनाचा गुलाब आहे,","poem":1},{"text":"खोर्‍यातील कमळ आहे.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"खरेच, काट्यांमध्ये कमळ तशी","poem":1},{"text":"इतर तरुणींमध्ये माझी प्रिया आहे.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जसे जंगलातील इतर झाडांमध्ये सफरचंदाचे झाड,","poem":1},{"text":"तसा इतर तरुणांमध्ये माझा प्रियकर आहे.","poem":2},{"text":"त्याच्या छायेत बसणे मला आनंददायी आहे,","poem":1},{"text":"आणि त्याचे फळ मला चवीला गोड लागते.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"त्याने मला आपल्या मेजवानगृहात आणावे,","poem":1},{"text":"त्याच्या प्रेमाचा ध्वज माझ्यावर असावा.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"मनुक्यांनी मला बळ द्या,","poem":1},{"text":"सफरचंदांनी मला ताजेतवाने करा,","poem":2},{"lineBreak":true},{"text":"कारण प्रेमात मी दुर्बल झाले आहे.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"त्याचा डावा हात माझ्या डोक्याखाली आहे,","poem":1},{"text":"आणि त्याच्या उजव्या हाताने तो मला आलिंगन देतो.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"यरुशलेमच्या कन्यांनो,","poem":1},{"text":"तुम्हाला रानातील मृगांची आणि हरिणीची शपथ,","poem":2},{"text":"त्याची इच्छा आहे तोपर्यंत","poem":1},{"text":"माझ्या प्रेमाला जागे करू नका.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ऐका! माझ्या प्रियांनो!","poem":1},{"text":"पाहा! तो येत आहे,","poem":2},{"text":"डोंगरामधून उड्या मारत,","poem":1},{"text":"टेकड्यांवरून बागडत येत आहे.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"माझा प्रियकर हरिणीसारखा किंवा तिच्या वत्सासारखा आहे.","poem":1},{"text":"पाहा, तो तिथे आमच्या भिंतीआड उभा राहून,","poem":2},{"text":"खिडक्यांतून न्याहळत आहे,","poem":1},{"text":"जाळीतून डोकावीत आहे.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"माझा प्रियतम मला म्हणाला,","poem":1},{"text":"“माझ्या प्रिये, ऊठ,","poem":2},{"lineBreak":true},{"text":"माझ्या सुंदरी, माझ्याबरोबर ये.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"पाहा! हिवाळा संपला आहे;","poem":1},{"text":"आता पाऊससुद्धा होऊन गेला.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"पृथ्वीवर फुले उमलली आहेत;","poem":1},{"text":"गाण्याचा ऋतू आला आहे,","poem":2},{"text":"कबुतरांचे गीत","poem":1},{"text":"आमच्या देशात ऐकू येत आहे.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"अंजिराच्या झाडाची फळे लागली आहेत;","poem":1},{"text":"आणि द्राक्षवेलींच्या फुलांचा सुगंध दरवळत आहे.","poem":2},{"text":"ऊठ, ये, माझ्या प्रिये;","poem":1},{"text":"माझ्या सुंदरी, माझ्याबरोबर ये.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"डोंगराच्या कपारीत,","poem":1},{"text":"कड्यांच्या गुप्त जागी राहणारी माझी कबुतरीण,","poem":2},{"text":"मला तुझे मुख पाहू दे,","poem":1},{"text":"मला तुझा स्वर ऐकू दे;","poem":2},{"text":"कारण तुझा स्वर गोड","poem":1},{"text":"आणि तुझा चेहरा मनोहर आहे.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"कोल्हे व लहान खोकडे,","poem":1},{"text":"जे द्राक्षमळ्यांची नासधूस करतात","poem":2},{"text":"त्यांना आमच्यासाठी पकडा,","poem":1},{"text":"कारण आमच्या द्राक्षमळ्यात आता बहर आला आहे.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"माझा प्रियतम माझा, आणि मी त्याची आहे;","poem":1},{"text":"कमळांमध्ये तो आपला कळप चारीत आहे.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"दिवस संपेपर्यंत","poem":1},{"text":"आणि सावली जाईपर्यंत,","poem":2},{"text":"खडतर पर्वतावरच्या","poem":1},{"noteId":1},{"text":"हरिणांसारखा किंवा","poem":2},{"text":"लहान वत्सासारखा","poem":1},{"text":"हे प्रियतमा, माझ्याकडे परत ये.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":1,"caller":"+","text":"किंवा बेथेरचे पर्वत","reference":{"chapter":2,"verse":17}}]},"thisChapterLink":"/api/mar_cbi/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}