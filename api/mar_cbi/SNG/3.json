{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"SNG","translationId":"mar_cbi","name":"गीतरत्न","commonName":"गीतरत्न","title":"गीतरत्न","order":22,"numberOfChapters":8,"sha256":"bc0fbea9e9742ebbad28a4562e1e4d8d9f3e381318564333d1ca335ac0fd925f","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/mar_cbi/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"रात्रभर माझ्या अंथरुणावर मी त्याला शोधत होते","poem":1},{"text":"ज्याच्यावर माझे हृदय प्रेम करते;","poem":2},{"lineBreak":true},{"text":"मी त्याला शोधले परंतु तो सापडला नाही.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मी आता उठेन आणि शहरभर फिरेन,","poem":1},{"text":"त्याच्या रस्त्यावर आणि चौकात जाऊन;","poem":2},{"text":"माझे हृदय ज्याच्यावर प्रेम करते त्याचा मी शोध करेन.","poem":1},{"text":"मग मी त्याला शोधले परंतु तो सापडला नाही.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"जे पहारेकरी नगरात गस्त घालतात","poem":1},{"text":"त्यांना मी आढळले तेव्हा मी त्यांनाच विचारले,","poem":2},{"lineBreak":true},{"text":"मी त्यांना विचारले, “माझे हृदय ज्याच्यावर प्रेम करते, तो तुम्हाला दिसला काय?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"पहारेकर्‍यांपासून जराशी दूर गेले","poem":1},{"text":"आणि ज्यावर माझे हृदय प्रीती करते तो मला सापडला","poem":2},{"text":"मी त्याला बिलगले आणि माझ्या आईच्या घरी,","poem":1},{"text":"जिने माझे गर्भधारण केले","poem":2},{"lineBreak":true},{"text":"तिच्या खोलीत आणेपर्यंत त्याला जाऊ दिले नाही.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"यरुशलेमच्या कन्यांनो,","poem":1},{"text":"तुम्हाला रानातील मृगांची आणि हरिणीची शपथ,","poem":2},{"text":"त्याची इच्छा आहे तोपर्यंत","poem":1},{"text":"माझ्या प्रेमाला जागे करू नका.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"हा धुराच्या स्तंभासारखे","poem":1},{"text":"व्यापाऱ्यांच्या सर्व सुगंधित पदार्थांनी,","poem":2},{"text":"ऊद आणि गंधरस यांनी सुगंधित,","poem":1},{"text":"असा रानातून हा कोण येत आहे?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"पाहा! ही तर शलोमोनाची पालखी आहे!","poem":1},{"text":"इस्राएलातील निवडलेल्या","poem":2},{"lineBreak":true},{"text":"साठ योद्ध्याच्या दलाच्या पहाऱ्यात आलेली आहे.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ते सर्व धनुर्धारी,","poem":1},{"text":"आणि युद्धात अनुभवी आहेत.","poem":2},{"text":"रात्री होणार्‍या आतंकासाठी सज्ज असलेले,","poem":1},{"text":"प्रत्येकाने आपली तलवार सोबत घेतली आहे.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"शलोमोन राजाने लबानोनाच्या लाकडाची ही पालखी;","poem":1},{"text":"स्वतःसाठी बनविली आहे.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"त्याचे खांब चांदीचे आहेत,","poem":1},{"text":"त्याचे तळ सोन्याचे आहे.","poem":2},{"text":"त्यातील बैठक जांभळ्या वस्त्रांची आहे,","poem":1},{"text":"तिच्या आतील भागाला यरुशलेमच्या कन्यांनी प्रेमाने वेलबुट्टीने मढविले आहे.","poem":2},{"text":"यरुशलेमच्या तरुणीकडून प्रेमपूर्वक भेट.","poem":1}]},{"type":"verse","number":11,"content":[{"text":"अहो सीयोनच्या कन्यांनो,","poem":1},{"text":"बाहेर या आणि पाहा,","poem":2},{"text":"शलोमोन राजा कसा मुकुटमंडित आहे ते पाहा,","poem":1},{"text":"त्याच्या विवाहाच्या दिवशी","poem":2},{"text":"त्याच्या आईने त्याला तो घातला आहे,","poem":1},{"text":"त्याचे हृदय आनंदित झाले तो हा दिवस.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}