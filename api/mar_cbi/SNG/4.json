{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"SNG","translationId":"mar_cbi","name":"गीतरत्न","commonName":"गीतरत्न","title":"गीतरत्न","order":22,"numberOfChapters":8,"sha256":"bc0fbea9e9742ebbad28a4562e1e4d8d9f3e381318564333d1ca335ac0fd925f","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/mar_cbi/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"किती सुंदर आहेस तू, माझ्या प्रिये!","poem":1},{"text":"आहा, किती सुंदर आहेस!","poem":2},{"lineBreak":true},{"text":"तुझ्या पडद्याआड तुझे नयन कबुतरे आहेत.","poem":2},{"text":"तुझे केस त्या शेरडांच्या कळपाप्रमाणे आहेत","poem":1},{"text":"ज्या गिलआदाच्या टेकड्यांवरून झळकतात.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तुझे दात नुकत्याच","poem":1},{"text":"धुतलेल्या मेंढरांच्या कळपाप्रमाणे आहेत,","poem":2},{"text":"प्रत्येकाला आपले जुळे आहेत;","poem":1},{"text":"त्यापैकी कोणीही एकटे नाहीत.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"किरमिजी सुताप्रमाणे तुझे ओठ आहेत;","poem":1},{"text":"तुझे ओठ मनमोहक आहेत.","poem":2},{"text":"ओढणीआड असलेले तुझे गाल","poem":1},{"text":"डाळिंबाच्या दोन फोडींप्रमाणे आहेत.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तुझी मान दावीदाने बांधलेल्या बुरुजाप्रमाणे आहे,","poem":1},{"text":"जो शिलाकृतीने बांधला आहे;","poem":2},{"text":"ज्यावर योद्धांच्या एक हजार ढाली","poem":1},{"text":"लटकलेल्या आहेत.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तुझे स्तन दोन हरिणींसारखे आहेत,","poem":1},{"text":"जुळ्या मृगांसारखे","poem":2},{"lineBreak":true},{"text":"ते मनोरम आहेत, कमळपुष्पांमध्ये चरतात","poem":2}]},{"type":"verse","number":6,"content":[{"text":"दिवस उजाडेपर्यंत,","poem":1},{"text":"आणि छाया नाहीशी होईपर्यंत,","poem":2},{"text":"मी गंधरसाच्या पर्वतावर","poem":1},{"text":"व बोळाच्या टेकडीवर जाईन.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"माझ्या प्रिये, तू सर्वांगी सुंदर आहेस;","poem":1},{"text":"तुझ्यात काहीही उणीव नाही.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"माझ्या वधू, लबानोनाहून तू माझ्यासोबत ये,","poem":1},{"text":"लबानोनाहून माझ्यासोबत ये,","poem":2},{"text":"अमानाह डोंगराच्या माथ्यावरून,","poem":1},{"text":"सनीर व हर्मोनच्या शिखरावरून,","poem":2},{"text":"सिंहाच्या गुहांपासून","poem":1},{"text":"आणि चित्ते वावरतात त्या डोंगरावरून खाली उतरून ये.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"अगे माझ्या भगिनी, माझी वधू;","poem":1},{"text":"तुझ्या एकाच नजरेने","poem":2},{"text":"तुझ्या माळेच्या एकाच मणीने","poem":1},{"text":"तू माझे हृदय चोरून घेतले आहेस.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"माझ्या भगिनी, माझ्या वधू, तुझे प्रेम किती हर्षित करणारे आहे!","poem":1},{"text":"तुझे प्रेम द्राक्षारसापेक्षा कितीतरी उत्तम आहे,","poem":2},{"text":"इतर सुगंधी द्रव्यांपेक्षा","poem":1},{"text":"तुझ्या अत्तराचा सुगंध अधिक मनमोहक आहे.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"माझ्या वधू, तुझे ओठ मधाच्या पोळ्याप्रमाणे मध गाळतात;","poem":1},{"text":"दूध आणि मध तुझ्या जिभेखाली आहेत.","poem":2},{"text":"तुझ्या वस्त्रांचा सुगंध","poem":1},{"text":"लबानोनाच्या सुगंधासारखा आहे.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"माझ्या भगिनी, माझ्या वधू तू एका बंद केलेली बाग आहेस;","poem":1},{"text":"तू एक कुंपणाने घेरलेल्या झर्‍यासारखी, शिक्कामोर्तब कारंज्याप्रमाणे आहेस.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"तुझी रोपे तर डाळिंबाचा मळा आहे,","poem":1},{"text":"ज्यात सर्वोत्कृष्ट फळे,","poem":2},{"lineBreak":true},{"text":"मेंदी आणि सुगंधी अगरू आहेत,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"अगरू आणि केशर,","poem":2},{"lineBreak":true},{"text":"वेखंड आणि दालचिनी,","poem":2},{"lineBreak":true},{"text":"सर्व प्रकारची सुगंधी झाडे,","poem":2},{"lineBreak":true},{"text":"तसेच गंधरस आणि जटामांसी","poem":2},{"lineBreak":true},{"text":"आणि सर्व उत्तम मसाले आहेत.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"या बागेतील पाण्याचा झरा,","poem":1},{"text":"लबानोन पर्वतावरून खाली वाहणार्‍या","poem":2},{"lineBreak":true},{"text":"वाहत्या पाण्याची विहीर अशी तू आहेस.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"उत्तरेच्या वार्‍या, जागा हो,","poem":1},{"text":"आणि दक्षिणेच्या वार्‍या, ये;","poem":2},{"text":"माझ्या बागेतील सुगंध चोहीकडे पसरावा,","poem":1},{"text":"म्हणून माझ्या बागेवरून वाहत जा.","poem":2},{"text":"माझ्या प्रियकराला त्याच्या बागेत येऊ द्या,","poem":1},{"text":"आणि बागेतील सर्वोत्कृष्ट फळे खाऊ द्या.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}