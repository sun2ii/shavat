{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"SNG","translationId":"mar_cbi","name":"गीतरत्न","commonName":"गीतरत्न","title":"गीतरत्न","order":22,"numberOfChapters":8,"sha256":"bc0fbea9e9742ebbad28a4562e1e4d8d9f3e381318564333d1ca335ac0fd925f","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/mar_cbi/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"हे सर्व स्त्रियांमधील परमसुंदरी,","poem":1},{"text":"तुझा प्रियकर कुठे गेला?","poem":2},{"text":"कोणत्या मार्गाने वळला आहे,","poem":1},{"text":"की तुझ्याबरोबर आम्हीही त्याला शोधू?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"माझा प्रियकर त्याच्या बागेत,","poem":1},{"text":"आपल्या सुगंधी झाडांच्या वाफ्यात,","poem":2},{"text":"तो कमळिनी शोधून","poem":1},{"text":"गोळा करण्यास तो गेला आहे.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"मी माझ्या प्रियकराची आहे, आणि माझा प्रियकर माझाच आहे;","poem":1},{"text":"कमळिनीमध्ये तो फुले शोधित आहे.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"माझ्या प्रिये, तू तिरजाह नगरीसारखी सुंदर आहेस,","poem":1},{"text":"जसे यरुशलेम मनोहर आहे,","poem":2},{"lineBreak":true},{"text":"जसे ध्वज फडकविणारे विजयी सैन्य तशी तू ऐश्वर्यशाली आहे.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"माझ्यावरून तू आपली दृष्टी काढ;","poem":1},{"text":"कारण तुझे नयन मला भारावून सोडतात.","poem":2},{"text":"तुझे केस गिलआद डोंगरावर चकाकणार्‍या","poem":1},{"text":"शेळ्यांच्या कळपाप्रमाणे आहेत.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तुझे दात नुकत्याच धुतलेल्या","poem":1},{"text":"मेंढरांच्या कळपाप्रमाणे आहेत.","poem":2},{"text":"प्रत्येकाला आपले जुळे आहेत,","poem":1},{"text":"त्यात एकही उणा नाही.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ओढणीआड असलेले तुझे गाल","poem":1},{"text":"डाळिंबाच्या दोन फोडींप्रमाणे आहेत.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"तिथे साठ राण्या,","poem":1},{"text":"आणि ऐंशी उपपत्नी,","poem":2},{"lineBreak":true},{"text":"आणि कुमारिका तर असंख्य असतील;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"पण हे माझ्या कबुतरे, तू परिपूर्ण, व निराळी आहेस,","poem":1},{"text":"तिच्या आईची एकुलती एक कन्या असून,","poem":2},{"lineBreak":true},{"text":"जिने तिला जन्म दिला तिची लाडकी आहे.","poem":2},{"text":"तरुण स्त्रियांनी तिला पाहून, धन्य म्हटले;","poem":1},{"text":"राण्या व उपपत्नी यांनी देखील तिची प्रशंसा केली.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"जो पहाटेसारखा प्रसन्न,","poem":1},{"text":"चंद्रासारखा मनोरम, सूर्यासारखा प्रकाशमान,","poem":2},{"lineBreak":true},{"text":"मिरवणुकीतील तार्‍यासारखे गौरवी दिसणारे असे हे कोण आहे?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"दर्‍याखोर्‍यात वाढत असलेली नवी झाडे,","poem":1},{"text":"द्राक्षवेलींना आलेले अंकुर,","poem":2},{"text":"आणि डाळिंबाला आलेली फुले","poem":1},{"text":"पाहण्यासाठी मी खाली अक्रोडाच्या झाडांच्या मळ्यात गेलो.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"मला समजण्यापूर्वी,","poem":1},{"text":"माझ्या इच्छेने मला माझ्या लोकांच्या शाही रथामध्ये स्थान दिले.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"परत ये, शुलेमकन्ये परत ये;","poem":1},{"text":"आम्ही तुला न्याहाळावे म्हणून परत ये, परत ये!","poem":2},"मित्र",{"text":"महनाईमचे नृत्य पाहण्यासारखे","poem":1},{"text":"तुम्ही शुलेमकन्येला का न्याहाळता?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}