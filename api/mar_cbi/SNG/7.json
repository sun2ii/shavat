{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"SNG","translationId":"mar_cbi","name":"गीतरत्न","commonName":"गीतरत्न","title":"गीतरत्न","order":22,"numberOfChapters":8,"sha256":"bc0fbea9e9742ebbad28a4562e1e4d8d9f3e381318564333d1ca335ac0fd925f","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/mar_cbi/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"हे राजकन्ये,","poem":1},{"text":"पायतणे घातलेले तुझे पाय किती सुंदर दिसतात!","poem":2},{"text":"कुशल कारागिराने घडविलेल्या रत्नाप्रमाणे","poem":1},{"text":"तुझ्या मांड्या वळणदार आहेत.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"तुझी नाभी गोलाकार पेल्यासारखी असून,","poem":1},{"text":"त्यात मसालेदार मद्याची कधीच वाण पडत नाही,","poem":2},{"text":"तुझी कंबर कमळिनीपुष्पांनी वेढलेल्या","poem":1},{"text":"गव्हाच्या राशीसारखे आहे.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तुझे स्तन दोन हरिणींसारखे आहेत,","poem":1},{"text":"जुळ्या मृगांसारखे ते मनोरम आहेत.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"हस्तिदंती मनोर्‍यासारखी तुझी मान आहे.","poem":1},{"lineBreak":true},{"text":"तुझे नयन बाथ-रब्बीमच्या वेशीकडे असलेल्या","poem":1},{"text":"हेशबोनाच्या तळ्यासारखे आहे.","poem":2},{"text":"तुझे नाक जणू काही लबानोन येथील,","poem":1},{"text":"जे दिमिष्कच्या दिशेला असलेल्या बुरुजासारखे रेखीव आहे.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"तुझ्या मस्तकाने कर्मेल डोंगरासारखे तुला मुकुटमंडित केले आहे.","poem":1},{"text":"तुझे केस जांभळ्या रंगाच्या शाही पडद्यासारखे आहे;","poem":2},{"lineBreak":true},{"text":"या केशसंभारात राजा बंदिस्त झाला आहे.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"माझ्या प्रिये, तू किती सुंदर आणि प्रसन्न करणारी आहेस,","poem":1},{"text":"तू अत्यंत मनमोहक आहेस!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"तू खजुरीच्या झाडासारखी सडपातळ आहेस.","poem":1},{"text":"खजुरीच्या घोसासारखे तुझे स्तन आहेत.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"मी म्हटले, मी खजुरीच्या झाडावर आरोहण करेन","poem":1},{"text":"आणि त्याच्या घोसांना धरीन;","poem":2},{"text":"तुझे स्तन द्राक्षवेलीमध्ये द्राक्षांच्या गुच्छासारखे होवोत,","poem":1},{"text":"आणि तुझा श्वास सफरचंदासारखा सुवासिक होवो,","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"तुझे मुख उत्तम द्राक्षारसासारखे होवो.","poem":2},"नायिका",{"text":"द्राक्षारस ओठांवरून दातांना स्पर्श करून,","poem":1},{"text":"थेट माझ्या प्रिये कडे जावो,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"मी माझ्या प्रियकराची आहे,","poem":1},{"text":"आणि तो माझीच कामना करतो.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"माझ्या प्रिया, ये, चल, आपण रानावनात जाऊ,","poem":1},{"text":"गावामध्ये","poem":2},{"noteId":2},{"text":"रात्र घालवू.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"सकाळीच उठून आपण द्राक्षमळ्यात जाऊ;","poem":1},{"text":"द्राक्षवेली मोहरल्या आहेत की काय,","poem":2},{"text":"त्यांना कळ्या आल्यात की काय ते पाहू.","poem":1},{"text":"डाळिंबाच्या झाडांना फुले आलीत काय ते पाहू.","poem":2},{"lineBreak":true},{"text":"आणि तिथे मी माझ्या प्रीतीचा वर्षाव करेन.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"त्या ठिकाणी दुदाफळाचे सुगंध दरवळत असतात,","poem":1},{"text":"आणि दुर्मिळ फळे आमच्या दाराशीच उपलब्ध होतात","poem":2},{"text":"नवीन आणि जुनीही फळे,","poem":1},{"text":"ही सर्व माझ्या प्रियकरासाठी राखून ठेवली आहेत.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":2,"caller":"+","text":"किंवा मेहेंदीच्या झुडपांमध्ये","reference":{"chapter":7,"verse":11}}]},"thisChapterLink":"/api/mar_cbi/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}