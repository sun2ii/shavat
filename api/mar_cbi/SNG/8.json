{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"SNG","translationId":"mar_cbi","name":"गीतरत्न","commonName":"गीतरत्न","title":"गीतरत्न","order":22,"numberOfChapters":8,"sha256":"bc0fbea9e9742ebbad28a4562e1e4d8d9f3e381318564333d1ca335ac0fd925f","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/mar_cbi/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"किती बरे झाले असते जर तू माझ्या भावासारखा असतास,","poem":1},{"text":"माझ्या आईच्या दुधाने त्याचे पोषण झाले!","poem":2},{"text":"जर मी तुला बाहेर भेटले तर,","poem":1},{"text":"मी तुझे चुंबन घेतले असते,","poem":2},{"lineBreak":true},{"text":"आणि कोणीही माझा तिरस्कार केला नसता.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मी तुझे मार्गदर्शन केले असते","poem":1},{"text":"आणि तुला माझ्या आईच्या घरी घेऊन गेले असते—","poem":2},{"lineBreak":true},{"text":"तिने मला शिकविलेला","poem":2},{"text":"मसालेदार द्राक्षारस मी तुला,","poem":1},{"text":"माझ्या डाळिंबाचा रस पिण्यास दिला असता.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"त्याचा डावा हात माझ्या डोक्याखाली आहे,","poem":1},{"text":"आणि त्याच्या उजव्या हाताने तो मला आलिंगन देतो.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"यरुशलेमच्या कन्यांनो, मी तुम्हाला शपथ घालते:","poem":1},{"text":"इच्छा आहे तोपर्यंत","poem":2},{"lineBreak":true},{"text":"माझ्या प्रेमाला जागे करू नका.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ही कोण आहे जी वाळवंटातून","poem":1},{"text":"आपल्या प्रियकरावर टेकून येत आहे?","poem":2},"नायिका",{"text":"जिथे तुझ्या आईने गर्भधारण केले ज्या सफरचंदाच्या झाडाखाली;","poem":1},{"text":"तिथे तुझ्या मातेला प्रसूती वेदना होऊन तिने तुला जन्म दिला,","poem":2},{"lineBreak":true},{"text":"त्या ठिकाणी मी तुला उत्तेजित केले.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"तू मला आपल्या हृदयावर मोहर लावल्याप्रमाणे ठेव,","poem":1},{"text":"मुद्रेप्रमाणे आपल्या भुजांवर मला ठेव;","poem":2},{"text":"कारण मृत्यूप्रमाणेच प्रीती प्रबळ आहे,","poem":1},{"text":"तिचा हेवा","poem":2},{"noteId":3},{"text":"कबरेप्रमाणे आहे.","poem":2},{"text":"तिचे उद्रेक अग्निज्वालेप्रमाणे उसळतात,","poem":1},{"text":"ते खरोखर आगीचे लोळच","poem":2},{"noteId":4},{"text":"असतात.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"प्रेमाचा अग्नी विपुल जलाशयांनी विझत नाही;","poem":1},{"text":"नद्यांमध्ये महापूर आला तरी ती बुडत नाही.","poem":2},{"text":"एखाद्याने आपल्या घरातील","poem":1},{"text":"संपूर्ण संपत्ती देऊ केली तरी","poem":2},{"lineBreak":true},{"text":"प्रेमापुढे ती अगदी तुच्छ होय.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"आमची एक लहान बहीण आहे,","poem":1},{"text":"तिला अजून ऊरही फुटले नाहीत,","poem":2},{"text":"तिच्या मागणीच्या दिवशी आम्ही","poem":1},{"text":"आमच्या बहिणीसाठी काय करावे?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ती जर भिंत असती तर,","poem":1},{"text":"आम्ही तिच्यावर चांदीचे बुरूज बांधू.","poem":2},{"text":"ती जर दार असती तर आम्ही तिला,","poem":1},{"text":"गंधसरूच्या फळ्यांनी झाकून टाकले असते.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"मी एक भिंत आहे,","poem":1},{"text":"आणि माझे स्तन बुरुजासारखे आहेत.","poem":2},{"text":"अशाप्रकारे मी माझ्या प्रियकराच्या नजरेत","poem":1},{"text":"त्याला समाधान आणणारी झाले आहे.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"बआल-हामोन येथे शलोमोनचा एक द्राक्षमळा होता;","poem":1},{"text":"तो त्याने तेथील कुळांना खंडाने दिला.","poem":2},{"text":"त्याचे फळ म्हणून प्रत्येकाने","poem":1},{"text":"हजार चांदीची शेकेल","poem":2},{"noteId":5},{"text":"द्यायची होती.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"परंतु माझ्याकडे स्वतःचा द्राक्षमळा आहे;","poem":1},{"text":"शलोमोन, हजार शेकेल तुझीच आहेत,","poem":2},{"lineBreak":true},{"text":"आणि मळ्याची देखरेख करणार्‍यांना मी दोनशे नाणी देईन.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"बागेत राहणार्‍या माझ्या प्रिये,","poem":1},{"text":"तुझ्या सख्या तुझ्या सेवेत हजर असतात,","poem":2},{"lineBreak":true},{"text":"मला तुझा स्वर ऐकू दे!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"माझ्या प्रियसख्या, लवकर ये,","poem":1},{"text":"आणि हरिणीसारखा हो,","poem":2},{"text":"किंवा सुगंधाने भरलेल्या","poem":1},{"text":"डोंगरावरील तरुण काळवीटा प्रमाणे हो.","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"किंवा उत्साह","reference":{"chapter":8,"verse":6}},{"noteId":4,"caller":"+","text":"किंवा याहवेहच्या अग्नीसारखा","reference":{"chapter":8,"verse":6}},{"noteId":5,"caller":"+","text":"अंदाजे 12 कि.ग्रॅ.","reference":{"chapter":8,"verse":11}}]},"thisChapterLink":"/api/mar_cbi/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}