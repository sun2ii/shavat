{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ZEC","translationId":"mar_cbi","name":"जखर्‍याह","commonName":"जखर्‍याह","title":"जखर्‍याहाची भविष्यवाणी","order":38,"numberOfChapters":14,"sha256":"5456698ce72ae330b2b007ad222048a2ff9facc3ed5a2cf7efb038871c03a061","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mar_cbi/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":10,"content":[{"type":"heading","content":["याहवेह यहूदीयाचे संगोपन करतील"]},{"type":"verse","number":1,"content":[{"text":"“वसंतॠतूमध्ये पाऊस पडावा म्हणून याहवेहस विनंती करा;","poem":1},{"text":"याहवेहच कडाडणाऱ्या मेघगर्जना पाठवितात.","poem":2},{"text":"तेच सर्व लोकांवर पावसाचा वर्षाव करतात","poem":1},{"text":"आणि प्रत्येकाला शेतातील पीक देतात.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"मूर्ती लबाड बोलतात,","poem":1},{"text":"दैवप्रश्न करणारे खोटे दृष्टान्त बघतात;","poem":2},{"text":"ते जी स्वप्ने सांगतात ती खरी नसतात,","poem":1},{"text":"त्यांनी केलेले सांत्वन व्यर्थ असते.","poem":2},{"text":"म्हणून लोक मेंढपाळ नसल्यामुळे","poem":1},{"text":"जुलमाच्या दबावाखाली मेंढराप्रमाणे भटकतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“माझा संताप मेंढपाळांविरुद्ध भडकतो,","poem":1},{"text":"आणि मी पुढार्‍यांना शिक्षा करेन;","poem":2},{"text":"कारण आपल्या कळपाची, यहूदीयाच्या लोकांची","poem":1},{"text":"काळजी सर्वसमर्थ याहवेह करतील,","poem":2},{"lineBreak":true},{"text":"आणि त्यांना युद्धातील कुशल घोड्यांप्रमाणे करतील.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"यहूदातून कोनशिला येईल,","poem":1},{"text":"त्याच्यातूनच तंबूचा खिळा,","poem":2},{"text":"त्याच्यातूनच युद्धाचे धनुष्य,","poem":1},{"text":"त्याच्यातूनच प्रत्येक अधिकारी येईल.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"एकत्र ते योद्ध्यांसारखे होतील","poem":1},{"text":"ते आपले शत्रू रस्त्यातील चिखलात तुडवतील.","poem":2},{"text":"ते लढतील कारण याहवेह त्यांच्याबरोबर आहेत,","poem":1},{"text":"आणि ते त्यांच्या शत्रूंच्या घोडेस्वारांना लज्जित करतील.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“मी यहूदाहला बलवान करेन","poem":1},{"text":"आणि योसेफाच्या वंशास वाचवेन.","poem":2},{"text":"मी त्यांची पुनर्स्थापना करेन","poem":1},{"text":"कारण मी त्यांच्यावर करुणा करतो.","poem":2},{"text":"ते असे होतील, जणू काही","poem":1},{"text":"मी त्यांचा त्याग कधी केलाच नव्हता,","poem":2},{"text":"कारण मी त्यांचा याहवेह परमेश्वर आहे","poem":1},{"text":"आणि मी त्यांचा धावा ऐकेन.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"एफ्राईमी योद्ध्यांसारखे होतील,","poem":1},{"text":"द्राक्षारसाने व्हावे तसे त्यांचे हृदय आनंदित होईल.","poem":2},{"text":"त्यांची मुलेसुद्धा हे पाहतील आणि उल्लास पावतील;","poem":1},{"text":"त्यांची हृदये याहवेहच्या ठायी आनंदित होतील.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"मी त्यांना संकेत देईन,","poem":1},{"text":"आणि त्यांना एकत्र करेन.","poem":2},{"text":"मी निश्चितच त्यांना सोडवेन;","poem":1},{"text":"ते पुन्हा पूर्वीसारखेच असंख्य होतील.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"जरी मी त्यांना लोकांमध्ये विखुरले आहे,","poem":1},{"text":"तरी देखील त्या दूर देशी ते माझी आठवण करतील.","poem":2},{"text":"ते व त्यांची सर्व मुलेबाळे जगतील,","poem":1},{"text":"आणि ते परत येतील.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"मी त्यांना इजिप्तमधून परत आणेन,","poem":1},{"text":"आणि अश्शूरातून एकत्र गोळा करेन.","poem":2},{"text":"गिलआद व लबानोनमध्ये त्यांचे पुनर्वसन करेन,","poem":1},{"text":"आणि तिथे त्यांना जागा पुरेशी होणार नाही.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ते संकटांच्या समुद्रातून प्रवास करतील;","poem":1},{"text":"उफाळणाऱ्या लाटा शांत केल्या जातील","poem":2},{"lineBreak":true},{"text":"आणि नाईल नदीचे खोल पाणी शुष्क होईल.","poem":2},{"text":"अश्शूरचा गर्व खाली करण्यात येईल","poem":1},{"text":"व इजिप्तचा राजदंड निघून जाईल.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"मी याहवेहमध्ये त्यांना सामर्थ्यवान करेन","poem":1},{"text":"आणि त्यांच्या नामामध्ये ते सुरक्षितपणे जगतील,”","poem":2},{"lineBreak":true},{"text":"असे याहवेह जाहीर करतात.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/mar_cbi/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}