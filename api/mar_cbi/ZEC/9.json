{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ZEC","translationId":"mar_cbi","name":"जखर्‍याह","commonName":"जखर्‍याह","title":"जखर्‍याहाची भविष्यवाणी","order":38,"numberOfChapters":14,"sha256":"5456698ce72ae330b2b007ad222048a2ff9facc3ed5a2cf7efb038871c03a061","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mar_cbi/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":9,"content":[{"type":"heading","content":["इस्राएलच्या शत्रूवर दंडाज्ञा"]},{"type":"verse","number":1,"content":["ही एक भविष्यवाणी आहे:",{"text":"हद्राख देशाविरुद्ध याहवेहचे वचन आले,","poem":1},{"text":"आणि याचा प्रभाव दिमिष्कवरही पडेल;","poem":2},{"text":"कारण सर्व लोकांची व इस्राएलच्या सर्व कुळांची दृष्टी","poem":1},{"text":"याहवेहवर लागलेली आहे;","poem":2},{"noteId":12}]},{"type":"verse","number":2,"content":[{"text":"सोर व सीदोनवर,","poem":1},{"text":"आणि त्याच्या सीमेलगत असलेल्या हमाथवरही लागलेली आहे, जरी ते अत्यंत कुशल आहेत.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"सोर नगरीने स्वतःसाठी भक्कम गड बांधले आहेत;","poem":1},{"text":"तिने रुपे धुळीच्या","poem":2},{"lineBreak":true},{"text":"व सोने रस्त्यावरील कचऱ्याच्या राशीप्रमाणे साठवून ठेवले आहे.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"परंतु प्रभू तिची सर्व संपत्ती हिरावून घेतील","poem":1},{"text":"आणि तिची समुद्रावरील शक्ती नष्ट करतील,","poem":2},{"lineBreak":true},{"text":"आणि ती अग्नीत भस्म होईल.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"अष्कलोन हे पाहून भयभीत होईल;","poem":1},{"text":"गाझा वेदनेने कळवळेल,","poem":2},{"lineBreak":true},{"text":"व एक्रोन देखील निराशेने कोमेजून जाईल.","poem":2},{"text":"गाझा नगरीच्या राजाला ठार करण्यात येईल","poem":1},{"text":"आणि अष्कलोन नगरी ओसाड होईल.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"मिश्रजातीचे लोक अश्दोदास व्यापून टाकतील,","poem":1},{"text":"आणि मी पलिष्ट्यांच्या गर्वाचा अंत करेन.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"मी त्यांच्या मुखातून रक्त व","poem":1},{"text":"त्यांच्या दातांमधून अमंगळ अन्न बाहेर काढेन.","poem":2},{"text":"जे अवशिष्ट लोक राहतील ते आपल्या परमेश्वराचे होतील","poem":1},{"text":"आणि यहूदीयाच्या कुळात समाविष्ट करण्यात येतील","poem":2},{"lineBreak":true},{"text":"पलिष्टी आणि एक्रोनचे पूर्वी जसे होते तसे हे लोक यबूसी लोकांप्रमाणे होतील.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"परंतु लुटारूंच्या आक्रमणापासून रक्षण करण्यासाठी","poem":1},{"text":"मी माझ्या मंदिराभोवती ठाण मांडेन.","poem":2},{"text":"यापुढे माझ्या लोकांवर कोणीही जुलूम करणारे अधिकार गाजविणार नाहीत,","poem":1},{"text":"आता मी त्यांच्यावर लक्ष ठेवेन.","poem":2}]},{"type":"heading","content":["सीयोनच्या राजाचे आगमन"]},{"type":"verse","number":9,"content":[{"text":"सीयोनकन्ये, फार आनंद कर!","poem":1},{"text":"यरुशलेमकन्ये, गर्जना कर!","poem":2},{"text":"पाहा, तुझा राजा तुझ्याकडे येत आहे,","poem":1},{"text":"तो नीतिमान व विजयी आहे,","poem":2},{"text":"तरी तो लीन आहे व गाढवीवर बसून तो येत आहे","poem":1},{"text":"होय, एका गाढवीच्या शिंगरावर बसून तो येत आहे!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"मी एफ्राईमचे रथ","poem":1},{"text":"आणि यरुशलेमचे युद्धाचे अश्व काढून घेईन,","poem":2},{"lineBreak":true},{"text":"आणि युद्धाचे धनुष्य मोडून टाकले जातील.","poem":2},{"text":"आणि तो राष्ट्रांमध्ये शांतीची घोषणा करेल.","poem":1},{"text":"त्याच्या राज्याचा विस्तार एका समुद्रापासून दुसर्‍या समुद्रापर्यंत","poem":2},{"lineBreak":true},{"text":"आणि फरात","poem":2},{"noteId":13},{"text":"नदीपासून पृथ्वीच्या दिगंतापर्यंत असेल.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"तुमच्या बाबत बोलायचे तर,","poem":1},{"text":"रक्ताने शिक्कामोर्तब करून तुमच्याशी केलेल्या करारामुळे,","poem":2},{"lineBreak":true},{"text":"मी तुमच्या बंदिवानांना निर्जल गर्तेतील मृत्यूपासून सोडविणार आहे.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"अहो सर्व सुटकेची आशा करणाऱ्या बंदिवानांनो, तुमच्या गडात परत या;","poem":1},{"text":"आता मी ही घोषणा करतो की, तुमची दुप्पटीने परतफेड करेन.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"यहूदाहास मी असे वाकवेन, जसे माझे धनुष्य वाकवितो","poem":1},{"text":"आणि एफ्राईमने ते बाणासारखे भरेन.","poem":2},{"text":"अगे, सीयोना, मी तुझ्या पुत्रांना","poem":1},{"text":"हे ग्रीस देशा, तुझ्या पुत्रां विरुद्ध प्रोत्साहित करेन,","poem":2},{"lineBreak":true},{"text":"आणि तुला योद्ध्याच्या तलवारीसारखे करेन.","poem":2}]},{"type":"heading","content":["याहवेहचे दर्शन होईल"]},{"type":"verse","number":14,"content":[{"text":"मग याहवेह त्यांच्यावर प्रगट होतील;","poem":1},{"text":"त्यांचे बाण विजेसारखे चमकतील.","poem":2},{"text":"सार्वभौम याहवेह रणशिंग फुंकतील;","poem":1},{"text":"ते दक्षिणेतील वादळातून चालतील,","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"आणि सर्वसमर्थ याहवेह त्यांचे रक्षण करतील.","poem":2},{"text":"ते नष्ट करतील,","poem":1},{"text":"आणि गोफणीच्या दगडांनी विजयी होतील.","poem":2},{"text":"ते प्राशन करतील व मद्यपीसारखे गर्जना करतील;","poem":1},{"text":"ते वाटीसारखे ओतप्रोत भरतील आणि","poem":2},{"lineBreak":true},{"text":"वेदीच्या कोपऱ्यांवर शिंपडण्यासाठी उपयोगात येतील.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"त्या दिवशी मेंढपाळ जसा आपल्या मेंढरांना वाचवितो,","poem":1},{"text":"त्याप्रमाणे याहवेह त्यांचे परमेश्वर त्यांच्या लोकांना वाचवतील.","poem":2},{"text":"मुकुटामध्ये बसविलेल्या रत्नांप्रमाणे","poem":1},{"text":"ते त्यांच्या देशात चमकतील.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ते सर्व किती अद्भुत व सुंदर असतील!","poem":1},{"text":"धान्य तरुणांची","poem":2},{"lineBreak":true},{"text":"आणि नवा द्राक्षारस तरुणींची भरभराट करेल.","poem":2}]}],"footnotes":[{"noteId":12,"caller":"+","text":"किंवा याहवेहची नजर इस्राएलच्या सर्व कुळांवर आहे","reference":{"chapter":9,"verse":1}},{"noteId":13,"caller":"+","text":"फरात किंवा ज्याला आजच्या काळात युफ्रेटिस या नावाने ओळखले जाते","reference":{"chapter":9,"verse":10}}]},"thisChapterLink":"/api/mar_cbi/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ZEC/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ZEC/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}