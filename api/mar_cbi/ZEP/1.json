{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ZEP","translationId":"mar_cbi","name":"सफन्याह","commonName":"सफन्याह","title":"सफन्याहची भविष्यवाणी","order":36,"numberOfChapters":3,"sha256":"eac374c22827eca1b679b489469d73d7ab56988c280532266f06219af1dae24f","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mar_cbi/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["सफन्याहला, जो कूशीचा पुत्र, जो गदल्याहचा पुत्र, जो अमर्‍याहचा पुत्र, जो हिज्कीयाहचा पुत्र, यहूदीयाचा राजा योशीयाह, जो आमोनचा पुत्र होता, याच्या कारकिर्दीत याहवेहकडून आलेले वचन ते असे:"]},{"type":"line_break"},{"type":"heading","content":["याहवेहचा संपूर्ण पृथ्वीसाठी न्यायाचा दिवस"]},{"type":"verse","number":2,"content":[{"text":"“मी पृथ्वीतलावरून सर्वकाही","poem":1},{"text":"झटकून नाहीसे करेन.”","poem":2},{"lineBreak":true},{"text":"असे याहवेह जाहीर करतात.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“मी माणसे आणि जनावरे दोन्हीही नष्ट करेन;","poem":1},{"text":"मी आकाशातील पक्षी नष्ट करेन","poem":2},{"lineBreak":true},{"text":"आणि समुद्रातील मासेही—","poem":2},{"lineBreak":true},{"text":"त्या मूर्ती ज्या दुष्टाच्या अडखळण्याचे कारण बनते.”","poem":2},{"lineBreak":true},{"text":"याहवेह जाहीर करतात,","poem":1},{"text":"“जेव्हा मी पृथ्वीवरून","poem":2},{"lineBreak":true},{"text":"सर्व मानवजातीला नष्ट करेन,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तेव्हा मी यहूदीयातील","poem":1},{"text":"आणि यरुशलेम येथील सर्व रहिवाशांच्या विरुद्ध माझा हात उगारेन.","poem":2},{"text":"या ठिकाणावरील बआलच्या सर्व शेष उपासकांचा मी नाश करेन","poem":1},{"text":"प्रत्येक मूर्तिपूजक पुजार्‍यांच्या नावाचा—","poem":2}]},{"type":"verse","number":5,"content":[{"text":"जे त्यांच्या घरांच्या धाब्यांवर जातात","poem":1},{"text":"आणि आकाशातील नक्षत्रांना नमन करतात.","poem":2},{"text":"जे याहवेहला नमन करून त्यांची शपथ घेतात,","poem":1},{"text":"आणि मोलेख","poem":2},{"noteId":0},{"text":"दैवताचीही शपथ घेतात,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"जे याहवेहचे अनुसरण करण्यापासून मागे फिरले आहेत","poem":1},{"text":"आणि जे याहवेहचा शोध घेत नाहीत वा त्यांची इच्छा जाणून घेत नाहीत.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"सार्वभौम याहवेहपुढे स्तब्ध राहा.","poem":1},{"text":"कारण त्यांच्या न्यायाचा दिवस जवळ आला आहे;","poem":2},{"text":"याहवेहने अर्पण सिद्ध केले आहे;","poem":1},{"text":"ज्यांना त्यांनी आमंत्रित केले, त्यांचे पवित्रीकरण केले आहे.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"याहवेहच्या अर्पणाच्या दिवशी","poem":1},{"text":"मी अधिपतींना आणि राजपुत्रांना","poem":2},{"text":"आणि परकीय वस्त्रे परिधान करणार्‍या","poem":1},{"text":"सर्वांना शिक्षा करेन.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"त्या दिवशी या सर्वांना शिक्षा करेन","poem":1},{"text":"जे उंबरठ्यावर पाऊल ठेवण्याचे टाळतात","poem":2},{"noteId":1},{"text":"जे त्यांच्या दैवतांची मंदिरे","poem":1},{"text":"हिंसाचार व लबाडीने भरतात.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"याहवेह जाहीर करतात,","poem":1},{"text":"“त्या दिवशी मत्स्य वेशीपासून","poem":2},{"text":"एक मोठी आरोळी ऐकू जाईल,","poem":1},{"text":"नगरातील नव्या विभागातून विलापाचा ध्वनी,","poem":2},{"lineBreak":true},{"text":"आणि डोंगरातून मोठ्या स्फोटाचा आवाज ऐकू येईल;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"विलाप करा, तुम्ही जे मक्तेशातील व्यापारी भागात राहता,","poem":1},{"text":"तुमचे सर्व व्यापारी,","poem":2},{"lineBreak":true},{"text":"सोन्याचांदीचा व्यवहार करणारे सर्वजण नष्ट होतील.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"त्या समयी मी दिवा घेऊन यरुशलेममध्ये शोधेन","poem":1},{"text":"आणि जे बेफिकीर असतात,","poem":2},{"lineBreak":true},{"text":"जे पखालीत सोडलेल्या द्राक्षारसाच्या गाळासारखे आहेत,","poem":2},{"text":"जे विचार करतात की याहवेह आपले बरे किंवा वाईट","poem":1},{"text":"असे काहीही करणार नाहीत, अशांना शिक्षा करेन.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"या लोकांची मालमत्ता लुटली जाईल,","poem":1},{"text":"यांचीच घरे ढासाळून टाकली जातील,","poem":2},{"text":"जरी त्यांनी घरे बांधली असतील,","poem":1},{"text":"त्या घरात ते राहू शकणार नाहीत;","poem":2},{"text":"जरी त्यांनी द्राक्षमळा लावला असेल,","poem":1},{"text":"द्राक्षांचा रस ते पिणार नाहीत.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"याहवेहचा तो भयावह दिवस जवळ—","poem":1},{"text":"तो वेगाने अगदी जवळ येत आहे.","poem":2},{"text":"याहवेहच्या दिवसाची गर्जना मर्मभेदक आहे;","poem":1},{"text":"सामर्थ्यशाली योद्धे त्याची रणगर्जना करतील.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"तो दिवस क्रोधाग्नीचा दिवस असेल—","poem":1},{"text":"तो दिवस दुःखाचा व क्लेशाचा,","poem":2},{"text":"तो दिवस अरिष्ट व उजाडतेचा,","poem":3},{"text":"तो दिवस अंधकाराचा व उदासीनतेचा,","poem":2},{"text":"तो दिवस अभ्रांचा व निबिड काळोखाचा—","poem":3}]},{"type":"verse","number":16,"content":[{"text":"तो दिवस तटबंदीच्या नगरांविरुद्ध","poem":2},{"text":"आणि कोपऱ्यातील बुरुजा विरुद्ध","poem":1},{"text":"रणशिंगाचा व रणगर्जनांच्या निनादांचा असेल.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“मी सर्व लोकांवर अशा विपत्ती आणेन, ते मार्ग शोधणार्‍या","poem":1},{"text":"एखाद्या आंधळ्या माणसाप्रमाणे चाचपडतील,","poem":2},{"lineBreak":true},{"text":"कारण त्यांनी याहवेहविरुद्ध पाप केले आहे.","poem":2},{"text":"त्यांचे रक्त धुळीसारखे ओतले जाईल","poem":1},{"text":"व त्यांच्या आतड्या शेणासारख्या विखुरतील.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"त्यांचे सोने किंवा त्यांची चांदी","poem":1},{"text":"त्यांना याहवेहच्या क्रोधापासून","poem":2},{"lineBreak":true},{"text":"वाचवू शकणार नाही.”","poem":2},{"lineBreak":true},{"text":"त्यांच्या ईर्षेच्या अग्नीने","poem":1},{"text":"संपूर्ण पृथ्वी भस्म होईल,","poem":2},{"text":"कारण जे सर्व पृथ्वीवर रहिवास करतात","poem":1},{"text":"त्यांचा ते अकस्मातपणे अंत करतील.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"किंवा मालकम","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"+","text":"1 शमु 5:5पाहावे","reference":{"chapter":1,"verse":9}}]},"thisChapterLink":"/api/mar_cbi/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}