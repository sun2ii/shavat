{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ZEP","translationId":"mar_cbi","name":"सफन्याह","commonName":"सफन्याह","title":"सफन्याहची भविष्यवाणी","order":36,"numberOfChapters":3,"sha256":"eac374c22827eca1b679b489469d73d7ab56988c280532266f06219af1dae24f","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mar_cbi/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"heading","content":["राष्ट्रांबरोबर यहूदीया आणि यरुशलेमचा न्याय"]},{"type":"heading","content":["यहूदीयास पश्चात्तापासाठी आव्हान"]},{"type":"verse","number":1,"content":[{"text":"हे निर्लज्ज राष्ट्रा एकत्र ये,","poem":1},{"text":"स्वतःला एकवटून घे,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"फर्मानाचा प्रभाव सुरू होण्याआधी","poem":1},{"text":"आणि तो दिवस वाऱ्याने उडालेल्या भुशासारखा उडून जाण्यापूर्वी,","poem":2},{"text":"याहवेहचा भयंकर संताप","poem":1},{"text":"तुझ्यावर कोसळण्यापूर्वी,","poem":2},{"text":"याहवेहच्या भयानक क्रोधाचा दिवस,","poem":1},{"text":"तुझ्यावर कोसळण्यापूर्वी एकत्र ये.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"या देशातील नम्रजन हो, याहवेहचा ध्यास करा,","poem":1},{"text":"तुम्ही जे त्यांच्या आज्ञा पाळता.","poem":2},{"text":"धार्मिकतेचा ध्यास करा, नम्रतेचा ध्यास करा;","poem":1},{"text":"याहवेहच्या क्रोधाच्या दिवशी","poem":2},{"lineBreak":true},{"text":"कदाचित तुम्हाला आश्रयस्थान मिळेल.","poem":2}]},{"type":"heading","content":["फिलिस्तिया"]},{"type":"verse","number":4,"content":[{"text":"गाझाचा त्याग करण्यात येईल","poem":1},{"text":"आणि अष्कलोन ओसाड पडेल.","poem":2},{"text":"भर दुपारी अश्दोद नगर रिकामे होईल","poem":1},{"text":"आणि एक्रोन समूळ उपटले जाईल.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"हे करेथीयाच्या लोकांनो,","poem":1},{"text":"समुद्र किनार्‍यावरील रहिवाशांनो तुम्हाला धिक्कार असो;","poem":2},{"text":"कनान देशात राहणार्‍या पलिष्टी लोकांनो,","poem":1},{"text":"याहवेहचे वचन तुमच्याविरुद्ध आहे.","poem":2},{"text":"ते म्हणतात, “मी तुमचा असा नाश करेन,","poem":1},{"text":"की तुमच्यातील कोणीही वाचणार नाही.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"समुद्रकिनाऱ्याची भूमी एक कुरण बनेल","poem":1},{"text":"मेंढपाळांसाठी विहिरी असलेले स्थान","poem":2},{"lineBreak":true},{"text":"व मेंढरांसाठी मेंढवाड्याचे ठिकाण होईल.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ती भूमी यहूदीयाच्या वंशातील","poem":1},{"text":"अवशेषाचे वतन होईल;","poem":2},{"lineBreak":true},{"text":"तिथे त्यांची कुरणे असतील.","poem":2},{"text":"संध्याकाळी ते अष्कलोन येथील घरात","poem":1},{"text":"विश्रांती घेतील.","poem":2},{"text":"याहवेह, त्यांचे परमेश्वर आपल्या लोकांची काळजी घेतील;","poem":1},{"text":"त्यांचे पूर्वीचे वैभव त्यांना परत प्राप्त करून देतील.","poem":2},{"noteId":2}]},{"type":"heading","content":["मोआबी आणि अम्मोनी"]},{"type":"verse","number":8,"content":[{"text":"“मोआबी लोकांच्या अपमानास्पद गोष्टी","poem":1},{"text":"आणि अम्मोनी लोकांचे टोमणे मी ऐकले आहेत,","poem":2},{"text":"जे माझ्या लोकांचा उपहास करतात","poem":1},{"text":"आणि त्यांच्या प्रदेशाविरुद्ध धमक्याही मी ऐकल्या आहेत.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"म्हणून माझ्या जिवाची शपथ,”","poem":1},{"text":"इस्राएलचे परमेश्वर,","poem":2},{"lineBreak":true},{"text":"सर्वसमर्थ याहवेह जाहीर करतात.","poem":2},{"text":"“निश्चितच मोआब हा सदोमासारखा,","poem":1},{"text":"अम्मोनी गमोरासारखा होईल","poem":2},{"text":"तण वाढलेले ठिकाण व मिठाची आगरे","poem":1},{"text":"कायमची ओसाड ठिकाणे होतील.","poem":2},{"text":"माझे अवशिष्ट लोक त्यांची लूट करतील;","poem":1},{"text":"माझे अवशिष्ट राष्ट्र त्यांच्या भूमीचे वारस बनतील.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"त्यांना त्यांच्या गर्विष्ठपणाचे","poem":1},{"text":"हे प्रतिफळ मिळेल.","poem":2},{"lineBreak":true},{"text":"कारण त्यांनी सर्वसमर्थ याहवेहच्या लोकांचा अपमान व उपहास केला.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"जेव्हा याहवेह पृथ्वीवरील सर्व दैवतांचा नाश करतील,","poem":1},{"text":"तेव्हा याहवेह त्यांना भयावह वाटतील.","poem":2},{"text":"दूरदेशातील सर्व राष्ट्रे आपआपल्या भूमीवर","poem":1},{"text":"त्यांच्यापुढे नतमस्तक होतील.","poem":2}]},{"type":"heading","content":["कूश2:12 कूश अर्थात् इथिओपिया"]},{"type":"verse","number":12,"content":[{"text":"“अहो कूशी","poem":1},{"noteId":3},{"text":"लोकांनो,","poem":1},{"text":"तुमचाही माझ्या तलवारीने वध होईल.”","poem":2}]},{"type":"heading","content":["अश्शूर"]},{"type":"verse","number":13,"content":[{"text":"ते उत्तरेविरुद्ध आपला हात उगारतील","poem":1},{"text":"आणि अश्शूरचा नाश करतील,","poem":2},{"text":"निनवेह नगरीस ते पूर्णपणे ओसाड","poem":1},{"text":"आणि वाळवंटाप्रमाणे शुष्क ठिकाण करतील.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"कळप व मेंढरे","poem":1},{"text":"सर्व राष्ट्रांचे प्राणी तिथे विश्रांती घेतील.","poem":2},{"text":"तिथे वाळवंटातील घुबडे व कर्कश किंचाळणारी घुबडे","poem":1},{"text":"तिच्या स्तंभावर निवारा घेतील.","poem":2},{"text":"घुबडांची घूं घूं खिडक्यांमधून प्रतिध्वनित होईल,","poem":1},{"text":"तिची प्रवेशद्वारे दगडविटांच्या तुकड्यांनी भरलेली असतील,","poem":2},{"lineBreak":true},{"text":"देवदारूचे स्तंभ उघडे बोडके होतील.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ही नगरी चैनबाजी करणारी,","poem":1},{"text":"सुरक्षितेत वसणारी होती.","poem":2},{"text":"ती स्वतःशी म्हणत असे,","poem":1},{"text":"“मी एकटीच आहे, माझ्यासारखी नगरी जगात दुसरी नाही.”","poem":2},{"text":"पण आता तिची कशी भग्नावस्था झाली आहे,","poem":1},{"text":"जंगली श्वापदे राहण्याचे ठिकाण!","poem":2},{"text":"तिच्याजवळून जाणारे सर्वजण तिचा उपहास करून","poem":1},{"text":"त्यांचे डोके हलवितात.","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"किंवा त्यांचे बंदिवान मी परत आणेन","reference":{"chapter":2,"verse":7}},{"noteId":3,"caller":"+","text":"नाईल नदीच्या वरच्या भागातील भूमी","reference":{"chapter":2,"verse":12}}]},"thisChapterLink":"/api/mar_cbi/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}