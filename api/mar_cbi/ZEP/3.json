{"translation":{"id":"mar_cbi","name":"Biblica® मराठी समकालीन स्वतंत्र संस्करण","website":"https://ebible.org/Scriptures/details.php?id=marc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=marc","licenseNotes":null,"shortName":"CBI","englishName":"Marathi: Biblica®","language":"mar","textDirection":"ltr","sha256":"4df0ef58e3f53f98e92f9a5935615c3505f5f44c7a045dd8a86798147f52f156","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_cbi/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31077,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ZEP","translationId":"mar_cbi","name":"सफन्याह","commonName":"सफन्याह","title":"सफन्याहची भविष्यवाणी","order":36,"numberOfChapters":3,"sha256":"eac374c22827eca1b679b489469d73d7ab56988c280532266f06219af1dae24f","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_cbi/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mar_cbi/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["यरुशलेम"]},{"type":"verse","number":1,"content":[{"text":"हे जुलमी लोकांच्या नगरी,","poem":1},{"text":"विद्रोही व भ्रष्ट नगरी, तुला धिक्कार असो!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ती कोणाचीही आज्ञा पाळत नाही,","poem":1},{"text":"ती कोणतीही सुधारणा स्वीकारत नाही.","poem":2},{"text":"ती याहवेहवर विश्वास ठेवीत नाही,","poem":1},{"text":"ती तिच्या परमेश्वराच्या समीप जात नाही.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"तिच्यामध्ये असलेले तिचे अधिकारी","poem":1},{"text":"गर्जना करणार्‍या सिंहासारखे आहेत;","poem":2},{"text":"तिचे शासनकर्ते निशाचर लांडगे आहेत","poem":1},{"text":"ते सकाळपर्यंत काहीही शिल्लक राहू देत नाहीत.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"तिचे संदेष्टे अधर्म करणारे आहेत;","poem":1},{"text":"ते विश्वासघातकी लोक आहेत.","poem":2},{"text":"तिचे याजक मंदिर अपवित्र करतात","poem":1},{"text":"ते आज्ञेचे उल्लंघन करतात.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"परंतु तिच्यात असणारे याहवेह नीतिमान आहेत;","poem":1},{"text":"ते काहीही अयोग्य करीत नाहीत.","poem":2},{"text":"प्रतिदिन सकाळी ते त्यांचे न्यायदान करतात,","poem":1},{"text":"आणि कोणत्याही नवदिनी ते असफल होत नाहीत,","poem":2},{"lineBreak":true},{"text":"तरी अधर्म्यांना लाज काय ते ठाऊकच नाही.","poem":2}]},{"type":"heading","content":["यरुशलेम पश्चात्ताप करणे नाकारते"]},{"type":"verse","number":6,"content":[{"text":"“मी अनेक राष्ट्रांचा नाश केला;","poem":1},{"text":"त्यांच्या गडांना उद्ध्वस्त केले आहे.","poem":2},{"text":"मी त्यांचे रस्ते ओसाड केले आहेत","poem":1},{"text":"तिथून कोणीही प्रवास करीत नाही.","poem":2},{"text":"आणि त्यांची शहरे निर्जन केली आहेत;","poem":1},{"text":"ते त्यागलेले व रिकामे झाले आहेत.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"यरुशलेमबद्दल मी विचार केला,","poem":1},{"text":"‘निश्चितच तू माझे भय धरशील;","poem":2},{"lineBreak":true},{"text":"आणि माझ्या सुधारणांचा स्वीकार करशील!’","poem":2},{"text":"तेव्हा तिचे आश्रयस्थान","poem":1},{"noteId":4},{"text":"उद्ध्वस्त होणार नाही.","poem":1},{"text":"माझ्या सर्व शिक्षा तिच्यावर येणार नाहीत,","poem":2},{"text":"पण तरीही पूर्वीसारखीच","poem":1},{"text":"भ्रष्टाचारी दुष्कर्मे करण्यास ती उत्सुक आहे.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"याहवेह जाहीर करतात, “म्हणून माझी वाट पाहा,","poem":1},{"text":"त्या दिवशी मी दोषारोप करण्यास","poem":2},{"noteId":5},{"text":"उभा राहीन.","poem":2},{"text":"पृथ्वीवरील सर्व राज्ये व राष्ट्रे","poem":1},{"text":"एकत्र करण्याचा मी निर्धार केला आहे","poem":2},{"text":"आणि त्यांच्यावर माझ्या कोपाचा वर्षाव करेन;","poem":1},{"text":"माझ्या अत्यंत तीव्र क्रोधाग्नीने","poem":2},{"text":"आणि माझ्या ईर्षेच्या अग्नीने","poem":1},{"text":"संपूर्ण विश्व जळून भस्म होईल.","poem":2}]},{"type":"heading","content":["इस्राएलच्या अवशेषाचे पुनर्स्थापन"]},{"type":"verse","number":9,"content":[{"text":"“मग मी त्यांच्या ओठांचे शुद्धीकरण करेन,","poem":1},{"text":"असे की ते सर्व याहवेहच्या नामाचा धावा करतील","poem":2},{"lineBreak":true},{"text":"आणि खांद्याला खांदा लावून त्यांची सेवा करतील.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"कूश देशाच्या नद्यांपलीकडून","poem":1},{"text":"माझे उपासक, माझे विखुरलेले लोक","poem":2},{"lineBreak":true},{"text":"माझ्यासाठी अर्पणे आणतील.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"त्या दिवशी तू यरुशलेमा, माझ्याविरुद्ध जे काही दुष्कृत्य केलेस,","poem":1},{"text":"त्याबद्दल तू लज्जित केली जाणार नाही,","poem":2},{"text":"तेव्हा तू माझ्याविरुद्ध बंड करणारी अशी राहणारच नाहीस.","poem":1},{"text":"कारण मी तुझ्यातील सर्व गर्वाने उन्मत्त झालेली माणसे काढून टाकेन.","poem":2},{"text":"माझ्या पवित्र पर्वतावर पुन्हा कधीही","poem":1},{"text":"गर्विष्ठपणा केला जाणार नाही.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"मी तुझ्यामध्ये जे गरीब व दीन,","poem":1},{"text":"असेच अवशिष्ट लोक ठेवेन.","poem":2},{"text":"इस्राएलचे अवशिष्ट लोक असतील आणि ते","poem":1},{"text":"याहवेहच्या नामात आश्रय घेतील.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"इस्राएलमधील उरलेले कोणतेही दुष्कृत्य करणार नाहीत;","poem":1},{"text":"ते असत्य बोलणार नाहीत.","poem":2},{"text":"लबाडी करणारी जीभ","poem":1},{"text":"त्यांच्या मुखात असणार नाही.","poem":2},{"text":"ते अन्न सेवन करून विसावा घेतील","poem":1},{"text":"आणि त्यांना कोणीही भीती दाखविणार नाही.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"हे सीयोनकन्ये, तू गीत गा;","poem":1},{"text":"हे इस्राएला, तू मोठ्याने गजर कर!","poem":2},{"text":"अगे यरुशलेमकन्ये,","poem":1},{"text":"अगदी मनापासून आनंद कर, उल्लास कर.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"कारण याहवेहने तुझी शिक्षा काढून घेतली आहे,","poem":1},{"text":"तुझ्या शत्रूचे सैन्य परत गेले आहे.","poem":2},{"text":"याहवेह, इस्राएलचे राजा तुझ्यासह आहेत;","poem":1},{"text":"यापुढे हानीचे भय तू बाळगणार नाही.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"त्या दिवशी","poem":1},{"text":"ते यरुशलेमला असे म्हणतील,","poem":2},{"text":"“हे सीयोना, भिऊ नकोस,","poem":1},{"text":"तुझे बाहू दुर्बल होऊ देऊ नकोस.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"महाप्रतापी योद्धा जे रक्षणकर्ता आहेत,","poem":1},{"text":"ते याहवेह तुझे परमेश्वर तुझ्यासह आहेत.","poem":2},{"text":"त्यांना तुझ्यामुळे अत्यंत आनंद होतो;","poem":1},{"text":"तुझ्यावरील प्रीतीमुळे ते तुजवर दोषारोपण करणार नाहीत.","poem":2},{"lineBreak":true},{"text":"त्याऐवजी तुझ्याबद्दल ते गीत गाऊन उल्हास व्यक्त करतील.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“जे निर्धारित सण तुझ्याकरिता ओझे व कलंक आहेत,","poem":1},{"text":"ते सण साजरे करता आले नाही म्हणून जे लोक शोक करतात,","poem":2},{"lineBreak":true},{"text":"त्या सर्वांना मी तुझ्यामधून काढून टाकेन.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"त्या समयी ज्यांनी तुझ्यावर जुलूम केला त्यांना मी अतिशय कडक शिक्षा करेन.","poem":1},{"text":"त्या सर्वांचा मी जाब घेईन.","poem":2},{"text":"जे लंगडे आहेत त्यांची मी सोडवणूक करेन;","poem":1},{"text":"बंदिवासात गेलेल्यांना मी एकत्र करेन.","poem":2},{"text":"जिथे ते लज्जित झाले त्या प्रत्येक भूमीवर","poem":1},{"text":"त्यांना मी प्रशंसा व गौरव बहाल करेन.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"त्यावेळी मी तुम्हा सर्वांना एकत्र गोळा करेन;","poem":1},{"text":"त्यावेळी मी तुम्हाला घरी परत आणेन.","poem":2},{"text":"जेव्हा मी तुमची संपन्नता तुम्हाला परत देईन","poem":1},{"text":"तेव्हा पृथ्वीवरील सर्व लोकांमध्ये,","poem":2},{"text":"स्वतःच्या दृष्टीसमोर","poem":1},{"text":"मी तुम्हाला गौरव व प्रशंसा बहाल करेन,”","poem":2},{"lineBreak":true},{"text":"असे याहवेह म्हणतात.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"किंवा तिचे पवित्रस्थान","reference":{"chapter":3,"verse":7}},{"noteId":5,"caller":"+","text":"किंवा लूट घेण्यास","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/mar_cbi/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_cbi/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_cbi/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}