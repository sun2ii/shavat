{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"1CH","translationId":"mar_irv","name":"1 इतिहास","commonName":"1 इतिहास","title":"1 इतिहास","order":13,"numberOfChapters":29,"sha256":"6c5bd9665aa448443a6a66ef8a591cf54d49101a974ab0bb61536b969e3970b7","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/mar_irv/1CH/29.json","totalNumberOfVerses":942},"chapter":{"number":3,"content":[{"type":"heading","content":["दाविदाचे पुत्र"]},{"type":"verse","number":1,"content":["आणि हेब्रोनात दावीदाच्या पुत्रांचा जन्म ते हे होते.",{"text":"अहीनवाम इज्रेलकरीण हिजपासून अम्नोन हा जेष्ठ;","poem":1},{"lineBreak":true},{"text":"अबीगईल कर्मेलकरीण हिचा पुत्र दानीएल हा दुसरा,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"गश्शूरचा राजा तलमय याची मुलगी माका हिचा पुत्र अबशालोम हा तिसरा पुत्र,","poem":1},{"lineBreak":true},{"text":"हग्गीथचा पुत्र अदोनीया हा चौथा.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"अबीटलचा पुत्र शफाट्या हा पाचवा.","poem":1},{"lineBreak":true},{"text":"दावीदाची पत्नी एग्ला हिचा इथ्रम हा सहावा.","poem":1}]},{"type":"verse","number":4,"content":["दावीदाच्या या सहा पुत्रांचा जन्म हेब्रोन येथे झाला. दावीदाने तेथे साडेसात वर्षे राज्य केले. यरूशलेम येथे त्याने तेहतीस वर्षे राज्य केले."]},{"type":"verse","number":5,"content":["अम्मीएलची कन्या बथशूवा हिच्यापासून दाविदाला यरूशलेम शहरात चार पुत्र झाले. शिमा, शोबाब, नाथान आणि शलमोन हे तिचे पुत्र."]},{"type":"verse","number":6,"content":["इतर नऊ पुत्र;",{"text":"इभार, अलीशामा, एलीफलेट,","poem":1}]},{"type":"verse","number":7,"content":[{"text":"नोगा, नेफेग, याफीय,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"अलीशामा, एल्यादा, एलीफलेट.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"ही दावीदाची मुले होती, त्यामध्ये त्याच्या उपपत्नीपासून झालेल्या पुत्रांचा नावाचा उल्लेख केलेला नाही. तामार ही त्यांची बहिण होती.","poem":1}]},{"type":"heading","content":["दाविदाचे पुत्र"]},{"type":"verse","number":10,"content":["शलमोनाचा पुत्र रहाबाम होता.",{"text":"रहबामाचा पुत्र अबीया होता.","poem":1},{"lineBreak":true},{"text":"अबीयाचा पुत्र आसा.","poem":1},{"lineBreak":true},{"text":"आसाचा पुत्र यहोशाफाट.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"यहोशाफाटाचा पुत्र योराम.","poem":1},{"lineBreak":true},{"text":"योरामाचा पुत्र अहज्या होता.","poem":1},{"lineBreak":true},{"text":"अहज्याचा पुत्र योवाश होता.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"योवाशाचा पुत्र अमस्या होता.","poem":1},{"lineBreak":true},{"text":"अमस्याचा पुत्र अजऱ्या होता.","poem":1},{"lineBreak":true},{"text":"अजऱ्याचा पुत्र योथाम होता.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"योथामाचा पुत्र आहाज होता.","poem":1},{"lineBreak":true},{"text":"आहाजाचा पुत्र हिज्कीया,","poem":1},{"lineBreak":true},{"text":"हिज्कीयाचा पुत्र मनश्शे.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"मनश्शेचा पुत्र आमोन होता,","poem":1},{"lineBreak":true},{"text":"आमोनचा पुत्र योशीया होता.","poem":1}]},{"type":"verse","number":15,"content":["योशीयाचे पुत्र थोरला योहानान, दुसरा यहोयाकीम. तिसरा सिद्कीया, चौथा शल्लूम."]},{"type":"verse","number":16,"content":["यहोयाकीमचे पुत्र यखन्या आणि त्याचा पुत्र सिद्कीया होता."]},{"type":"verse","number":17,"content":["यखन्याला बाबिलोनमध्ये कैद केल्यानंतर त्यास झालेल्या मुलांची नावे शल्तीएल,"]},{"type":"verse","number":18,"content":["मल्कीराम, पदाया, शेनस्सर, यकम्या, होशामा व नदब्या."]},{"type":"verse","number":19,"content":["पदायाचे पुत्र जरुब्बाबेल, शिमी. जरुब्बाबेलचे पुत्र मशुल्लाम आणि हनन्या. शलोमीथ ही त्यांची बहिण होती."]},{"type":"verse","number":20,"content":["जरुब्बाबेलाला आणखीही पाच पुत्र होती. हशूबा, ओहेल, बरेख्या, हसद्या, यूशब-हेसेद ही ती होत."]},{"type":"verse","number":21,"content":["पलट्या हा हनन्याचा पुत्र आणि पलट्याचा पुत्र यशया, यशयाचा रफाया, रफायाचा अर्णान. अर्णानचा पुत्र ओबद्या. ओबद्याचा पुत्र शखन्या."]},{"type":"verse","number":22,"content":["शखन्याचे वंशज शमाया, शमायाचे सहा पुत्र शमाया, हट्टूश, इगाल, बारीहा, निरह्या आणि शाफाट."]},{"type":"verse","number":23,"content":["निरह्या याला तीन पुत्र एल्योवेनय, हिज्कीया आणि अज्रिकाम."]},{"type":"verse","number":24,"content":["एल्योवेनयला सात पुत्र होते. त्यांची नावे होदव्या, एल्याशीब, पलाया, अक्कूब, योहानान, दलाया, अनानी."]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/1CH/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/1CH/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/1CH/2.json","previousChapterAudioLinks":{},"numberOfVerses":24}