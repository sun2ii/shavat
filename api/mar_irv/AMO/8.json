{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"AMO","translationId":"mar_irv","name":"आमोस","commonName":"आमोस","title":"आमोस","order":30,"numberOfChapters":9,"sha256":"48043bcd158c3cf45573cebd5028a47440a1aaf27d2514c5acfdef36084a9811","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/mar_irv/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":8,"content":[{"type":"heading","content":["चौथा दृष्टांत: पक्व फळांची पाटी"]},{"type":"verse","number":1,"content":["परमेश्वराने मला हे दाखवले, पाहा, उन्हाळ्यातल्या फळांची",{"noteId":5},"टोपली दिसली."]},{"type":"verse","number":2,"content":["तो म्हणाला, “आमोस, तुला काय दिसते?” मी म्हणालो, “उन्हाळी फळांची टोपली.” मग परमेश्वर मला म्हणाला,",{"text":"“माझ्या लोकांचा, इस्राएलचा, शेवट आला आहे;","poem":1},{"lineBreak":true},{"text":"मी त्यांच्याकडे पुन्हा दुर्लक्ष करणार नाही.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"परमेश्वर, असे म्हणातो,","poem":1},{"lineBreak":true},{"text":"त्या दिवसात मंदिरातील गाणे विलाप होतील.","poem":1},{"lineBreak":true},{"text":"सगळीकडे प्रेतेच प्रेते असतील, प्रत्येक स्थानांत लोक गुपचूप ती बाहेर टाकून देतील.”","poem":1}]},{"type":"heading","content":["दाराशी आलेला इस्त्राएलाचा ऱ्हास"]},{"type":"verse","number":4,"content":[{"text":"जे तुम्ही गरिबांना तुडविता, आणि देशातील गरीबांना काढता. ते तुम्ही हे ऐका.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"तुम्ही म्हणता “चंद्रदर्शन केव्हा संपेल? म्हणजे मग आम्ही आमचे धान्य विकू. शब्बाथ, केव्हा संपेल? म्हणजे मग आम्हास गहू विकता येईल? मग आपण एफा लहान करू, व शेकेल नाणे मोठे करू व कपटाचे तराजू घेऊन फसवू.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"आपण चांदी देऊन गरीबांना","poem":1},{"lineBreak":true},{"text":"आणि एका जोड्याच्या किंमतीत गरजूंना विकत घेऊ","poem":1},{"lineBreak":true},{"text":"आणि गव्हाचे भूसही विकून टाकू.”","poem":1}]},{"type":"verse","number":7,"content":["परमेश्वराने याकोबाच्या वैभवाची शपथ वाहीली आहे की, “खचित त्यांच्या कर्मातले कोणतेही मी विसरणार नाही."]},{"type":"verse","number":8,"content":[{"text":"त्यांमुळे भूमी हादरणार नाही काय?","poem":1},{"lineBreak":true},{"text":"आणि या देशात राहणारा प्रत्येकजण शोक करणार नाही काय?","poem":1},{"lineBreak":true},{"text":"त्यातील सर्व नील नदीप्रमाणे चढेल,","poem":1},{"lineBreak":true},{"text":"आणि मिसरातल्या नदी सारखी खवळेल व पुन्हा खाली ओसरेल.”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"परमेश्वर असे म्हणतो,","poem":1},{"lineBreak":true},{"text":"“त्या दिवसात,” “मी सूर्याला दुपारीच मावळवीन","poem":1},{"lineBreak":true},{"text":"आणि पृथ्वीला निरभ्र दिवशी अंधकारमय करीन.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"मी तुमचे उत्सव पालटून शोक असे करीन,","poem":1},{"lineBreak":true},{"text":"आणि तुमची सर्व गाणी पालटून विलाप अशी करीन.","poem":1},{"lineBreak":true},{"text":"मी प्रत्येकाला गोणताटाचे कपडे घालीन.","poem":1},{"lineBreak":true},{"text":"मी प्रत्येक डोक्याचे मुंडन करीन. ए","poem":1},{"lineBreak":true},{"text":"कुलता एक मुलगा गेल्यावर जसा आकांत होतो,","poem":1},{"lineBreak":true},{"text":"तसा मी करीन.","poem":1},{"lineBreak":true},{"text":"तो फारच कडू शेवट असेल.”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"परमेश्वर म्हणतो,","poem":1},{"lineBreak":true},{"text":"“पाहा! मी देशात दुष्काळ पाठवीन,","poem":1},{"lineBreak":true},{"text":"ते दिवस येतच आहेत,","poem":1},{"lineBreak":true},{"text":"तेव्हा भाकरीचा दुष्काळ नसेल,","poem":1},{"lineBreak":true},{"text":"पाण्याचा दुष्काळ नसेल,","poem":1},{"lineBreak":true},{"text":"परंतू परमेश्वराची वचने ऐकण्याचा दुष्काळ असेल.”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"“लोक समुद्रापासून समुद्रापर्यंत","poem":1},{"lineBreak":true},{"text":"आणि उत्तरेपासून पूर्वेपर्यंत भटकतील.","poem":1},{"lineBreak":true},{"text":"परमेश्वराचे वचन शोधत लोक इकडे तिकडे भटकतील.","poem":1},{"lineBreak":true},{"text":"पण त्यांना ते सापडणार नाहीत.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"त्यावेळी, सुंदर तरुण-तरुणी तहानेने दुर्बल होतील.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"जे शोमरोनाच्या पापाची शपथ वाहतात,","poem":1},{"lineBreak":true},{"text":"आणि ‘हे दाना’, तुझा परमेश्वर जिवंत आहे,","poem":1},{"lineBreak":true},{"text":"असे म्हणतात,","poem":1},{"lineBreak":true},{"text":"आणि बैर-शेब्याचा","poem":1},{"noteId":6},{"text":"देव जिवंत आहे,","poem":1},{"lineBreak":true},{"text":"असे म्हणतात, ते पडतील,","poem":1},{"lineBreak":true},{"text":"आणि ते परत कधीही उठणार नाहीत.”","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"परिपक्व फळांची","reference":{"chapter":8,"verse":1}},{"noteId":6,"caller":"+","text":"मूर्तींची पूजा","reference":{"chapter":8,"verse":14}}]},"thisChapterLink":"/api/mar_irv/AMO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/AMO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/AMO/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}