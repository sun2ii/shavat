{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ECC","translationId":"mar_irv","name":"उपदेशक","commonName":"उपदेशक","title":"उपदेशक","order":21,"numberOfChapters":12,"sha256":"2e4eb5dfedf8c42a3e0aed7fe6413f5a368d9d97ab815946cb8d174fbb6d617b","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/mar_irv/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":1,"content":[{"type":"heading","content":["सर्वकाही व्यर्थ"]},{"type":"verse","number":1,"content":["ही शिक्षकाकडून आलेली वचने आहेत, जो यरूशलेमेतील राजा आणि दावीदाचा वंशज होता."]},{"type":"verse","number":2,"content":["शिक्षक हे म्हणतो,",{"text":"धुक्याच्या वाफेसारखी,","poem":1},{"lineBreak":true},{"text":"वाऱ्यातील झुळूकेसारखी","poem":1},{"lineBreak":true},{"text":"प्रत्येक गोष्ट नाहीशी होईल, पुष्कळ प्रश्न मागे ठेवून जातील.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"भूतलावर मानवजात जे सर्व कष्ट करते त्यापासून त्यास काय लाभ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"एक पिढी जाते,","poem":1},{"lineBreak":true},{"text":"आणि दुसरी पिढी येते,","poem":1},{"lineBreak":true},{"text":"परंतु पृथ्वीच काय ती सर्वकाळ राहते.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"सूर्य उगवतो","poem":1},{"lineBreak":true},{"text":"आणि तो मावळतो.","poem":1},{"lineBreak":true},{"text":"आणि जेथे तो उगवतो तेथे आपल्या स्थानाकडे पुन्हा त्वरेने मागे जातो.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"वारा दक्षिणेकडे वाहतो","poem":1},{"lineBreak":true},{"text":"आणि उत्तरेकडे वळतो,","poem":1},{"lineBreak":true},{"text":"नेहमी त्याच्यामार्गाने सभोवती जाऊन फिरून","poem":1},{"lineBreak":true},{"text":"आणि पुन्हा माघारी येतो.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"सर्व नद्या सागरात जाऊन मिळतात","poem":1},{"lineBreak":true},{"text":"पण सागर कधीही भरून जात नाही.","poem":1},{"lineBreak":true},{"text":"ज्या स्थानाकडून नद्या वाहत येतात,","poem":1},{"lineBreak":true},{"text":"तेथेच त्या पुन्हा जातात.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"सर्व गोष्टी कष्टमय आहेत.","poem":1},{"lineBreak":true},{"text":"आणि कोणीही त्याचे स्पष्टीकरण करू शकत नाही.","poem":1},{"lineBreak":true},{"text":"डोळे जे काय पाहतात त्याने त्यांचे समाधान होत नाही,","poem":1},{"lineBreak":true},{"text":"किंवा जे काय कानाने ऐकतो त्यानेही त्यांची पूर्तता होत नाही.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"जे काही आहे तेच होणार,","poem":1},{"lineBreak":true},{"text":"आणि जे केले आहे तेच केले जाईल.","poem":1},{"lineBreak":true},{"text":"भूतलावर काहीच नवे नाही.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"कोणतीही अशी गोष्ट आहे का ज्याविषयी असे म्हणता येईल,","poem":1},{"lineBreak":true},{"text":"पाहा, हे नवीन आहे?","poem":1},{"lineBreak":true},{"text":"जे काही अस्तित्वात आहे ते फार काळापूर्वी अस्तित्वात होते,","poem":1},{"lineBreak":true},{"text":"आम्हांपूर्वीच्या युगामध्ये आधीच ते आले आहे.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"प्राचीन काळी घडलेल्या गोष्टी कोणाच्या लक्षात राहत नाहीत.","poem":1},{"lineBreak":true},{"text":"आणि त्यानंतर ज्या गोष्टी घडणार","poem":1},{"lineBreak":true},{"text":"आणि भविष्यात ज्या गोष्टी घडतील","poem":1},{"lineBreak":true},{"text":"त्यादेखील आठवणीत राहणार नाही.","poem":1}]},{"type":"heading","content":["उपदेशकाचा अनुभव"]},{"type":"verse","number":12,"content":["मी शिक्षक आहे, आणि यरूशलेमेमध्ये इस्राएलावर राजा होतो."]},{"type":"verse","number":13,"content":["आकाशाखाली जे सर्वकाही करतात त्याचा मी ज्ञानाने अभ्यास केला आणि त्यांचा शोध घेण्याकडे मी आपले चित्त लावले. देवाने मनुष्यांच्या पुत्रामागे त्याचा शोध घेण्याचे बिकट कष्ट लावून दिले आहेत."]},{"type":"verse","number":14,"content":["भूतलावर जी काही कामे चालतात ती मी पाहिली आणि पाहा, ते सर्व वायफळ आहेत आणि वाऱ्याचा पाठलाग करण्यासारखे ते आहे."]},{"type":"verse","number":15,"content":[{"text":"जे वाकडे आहे ते सरळ करू शकत नाही!","poem":1},{"lineBreak":true},{"text":"जे गमावले आहे ते जमेस धरू शकत नाही!","poem":1}]},{"type":"verse","number":16,"content":["मी आपल्या मनाशीच बोलून म्हणालो, “पाहा, माझ्या आधी ज्या राजांनी यरूशलेमेवर राज्य केले त्या सर्वांपेक्षा मी अधिक ज्ञान प्राप्त करून घेतले आहे. माझ्या मनाने महान ज्ञान व विद्या यांचा अनुभव घेतला आहे.”"]},{"type":"verse","number":17,"content":["याकरिता ज्ञान समजायला आणि वेडेपण व मूर्खपण जाणायला मी आपले मन लावले, मग हेही वाऱ्याचा पाठलाग करण्यासारखे आहे असे मी समजलो."]},{"type":"verse","number":18,"content":["कारण विपुल ज्ञानात अधिक खेद आहे आणि जो कोणी ज्ञानात वाढतो तो दुःख वाढवतो."]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}