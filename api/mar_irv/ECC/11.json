{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"ECC","translationId":"mar_irv","name":"उपदेशक","commonName":"उपदेशक","title":"उपदेशक","order":21,"numberOfChapters":12,"sha256":"2e4eb5dfedf8c42a3e0aed7fe6413f5a368d9d97ab815946cb8d174fbb6d617b","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/mar_irv/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":11,"content":[{"type":"heading","content":["शहाण्याचे आचरण"]},{"type":"verse","number":1,"content":[{"text":"आपली भाकर जलावर सोड","poem":1},{"noteId":4},{"text":".","poem":1},{"lineBreak":true},{"text":"कारण पुष्कळ दिवसानी तुला ते पुन्हा मिळेल.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तू सात आठ लोकांस वाटा दे.","poem":1},{"lineBreak":true},{"text":"कारण पृथ्वीवर कोणत्या वाईट गोष्टी घडतील त्याची तुम्हास कल्पना नाही.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"जर ढग पावसाने पूर्ण भरलेले असतील;","poem":1},{"lineBreak":true},{"text":"तर ते पृथ्वीवर स्वतःला रिक्त करतात,","poem":1},{"lineBreak":true},{"text":"आणि जर झाड उत्तरेकडे वा दक्षिणेकडे पडले तर ते जेथे पडले तेथेच राहील.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"जो वारा पाहत राहतो तो पेरणार नाही.","poem":1},{"lineBreak":true},{"text":"जो ढगांचा रंग पाहत राहतो तो पेरणी करणार नाही.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"जसा वारा कोठून येतो हे तुला माहित नाही,","poem":1},{"lineBreak":true},{"text":"आईच्या गर्भात बाळाची हाडे कशी वाढतात हेही जसे तुला कळत नाही","poem":1},{"lineBreak":true},{"text":"तसेच सर्व काही निर्माण करणाऱ्या देवाच्या कार्याचे आकलन तुला करता येणार नाही.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"सकाळीच आपले बी पेर, संध्याकाळीही हात आवरू नकोस.","poem":1},{"lineBreak":true},{"text":"कारण त्यातून कोणते फळास येईल हे किंवा ते","poem":1},{"lineBreak":true},{"text":"अथवा दोन्ही मिळून चांगले होतील हे तुला माहीत नसते.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"प्रकाश खरोखर गोड आहे,","poem":1},{"lineBreak":true},{"text":"आणि सूर्य पाहणे डोळ्यांस आनंददायक गोष्ट आहे.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"जर मनुष्य कितीही वर्षे जगला तरी तो त्या सर्वात आनंद करो,","poem":1},{"lineBreak":true},{"text":"पण तो येण्याऱ्या अंधकाराच्या दिवसाचा विचार करो,","poem":1},{"lineBreak":true},{"text":"कारण ते पुष्कळ होतील.","poem":1},{"lineBreak":true},{"text":"जे सर्व येते ते व्यर्थच आहे.","poem":1}]},{"type":"heading","content":["तरुण पिढीस बोध"]},{"type":"verse","number":9,"content":[{"text":"हे तरुणा, तू आपल्या तारुण्यात आनंद कर.","poem":1},{"lineBreak":true},{"text":"तुझ्या तारुण्याच्या दिवसात तुझे हृदय तुला आनंदीत करो,","poem":1},{"lineBreak":true},{"text":"आणि तू मनास वाटेल त्या मार्गाने व नजरेस येईल तसा चाल.","poem":1},{"lineBreak":true},{"text":"पण या सर्वाबद्दल देव तुझा न्याय करील. हे तुझ्या लक्षात असू दे.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"यास्तव आपल्या मनातून राग दूर कर,","poem":1},{"lineBreak":true},{"text":"आणि आपल्या शरीरातील वेदनेकडे लक्ष देऊ नको.","poem":1},{"lineBreak":true},{"text":"कारण तारुण्य व सामर्थ्य ही व्यर्थ आहेत.","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"उदारतेने इतरांस दे","reference":{"chapter":11,"verse":1}}]},"thisChapterLink":"/api/mar_irv/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}