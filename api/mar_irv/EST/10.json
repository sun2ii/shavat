{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"EST","translationId":"mar_irv","name":"एस्तेर","commonName":"एस्तेर","title":"एस्तेर","order":17,"numberOfChapters":10,"sha256":"b47de61c49e833aa70a85c793e4a86ebb4b3cd1ebeb8f7fbf2c979658b3b8cb4","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/EST/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/mar_irv/EST/10.json","totalNumberOfVerses":167},"chapter":{"number":10,"content":[{"type":"heading","content":["मर्दखयाची महती"]},{"type":"verse","number":1,"content":["मग अहश्वेरोश राजाने देशावर व समुद्रालगतच्या लोकांवर कर बसवला."]},{"type":"verse","number":2,"content":["त्याची सामर्थ्याची व पराक्रमाची जी कृत्ये, त्यांची आणि मर्दखयाचे महत्व, राजाने ज्यांना थोर केले ते पारस आणि माद्य राजांच्या इतिहासाच्या ग्रंथात लिहिले आहेत."]},{"type":"verse","number":3,"content":["राजा अहश्वेरोशाच्या खालोखाल यहूदी मर्दखयाचे स्थान होते. त्याचे यहूदी बांधव त्यास फार मान देत. कारण लोकांच्या भल्यासाठी तो खूप मेहनत घेई. त्याच्या सर्व लोकांशी शांततेने बोलत असे."]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/EST/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/JOB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/EST/9.json","previousChapterAudioLinks":{},"numberOfVerses":3}