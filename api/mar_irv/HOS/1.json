{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"HOS","translationId":"mar_irv","name":"होशेय","commonName":"होशेय","title":"होशेय","order":28,"numberOfChapters":14,"sha256":"c9a4a200f951f6b0cf36ef1602f7fa24e39d641cc1b5a67c0d66b52f15f70c3a","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mar_irv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":1,"content":[{"type":"heading","content":["होशेयची जारिणी पत्नी व तिची मुले"]},{"type":"verse","number":1,"content":["होशेय, जो बैरीचा मुलगा यास परमेश्वराचा संदेश मिळाला. त्यावेळी उज्जीया, योथाम, आहाज आणि हिज्कीया हे यहूदाचे राजे होते आणि इस्राएलमध्ये योवाशाचा मुलगा यराबाम राज्य करीत होता."]},{"type":"verse","number":2,"content":["हा परमेश्वराचा होशेयला आलेला पहिलाच संदेश होता, तो होशेयला म्हणाला,",{"text":"“जा एका वेश्येसोबत लग्न कर व जी मुले होतील","poem":1},{"lineBreak":true},{"text":"ती तिच्या जारकर्माचे परिणाम असतील","poem":1},{"lineBreak":true},{"text":"कारण परमेश्वराचा त्याग करणे","poem":1},{"lineBreak":true},{"text":"हे जारकर्म हा देश करीत आहे.”","poem":1}]},{"type":"verse","number":3,"content":["म्हणून होशेयने ने दिब्लाइमाची मुलगी गोमर हिच्याशी लग्न केले. ती गरोदर राहिली व तिला मुलगा झाला."]},{"type":"verse","number":4,"content":["परमेश्वर होशेयला म्हणाला,",{"text":"त्याचे नाव इज्रेल","poem":1},{"noteId":0},{"text":"ठेव,","poem":1},{"lineBreak":true},{"text":"कारण काही वेळानंतर","poem":1},{"lineBreak":true},{"text":"मी येहूच्या घराण्याला","poem":1},{"lineBreak":true},{"text":"त्यांनी इज्रेल येथे केलेल्या रक्तपातामुळे","poem":1},{"noteId":1},{"text":"शिक्षा करणार आहे","poem":1},{"lineBreak":true},{"text":"व इस्राएल घराण्याच्या राज्याचा शेवट करणार आहे.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"त्या दिवशी","poem":1},{"lineBreak":true},{"text":"मी इज्रेलच्या दरीत इस्राएलचे धनुष्य मोडेन.","poem":1}]},{"type":"verse","number":6,"content":["गोमर पुन्हा गरोदर झाली आणि तिला मुलगी झाली",{"text":"तेव्हा परमेश्वर होशेय ला म्हणाला","poem":1},{"lineBreak":true},{"text":"हिचे नांव लो-रुहामा","poem":1},{"noteId":2},{"text":"ठेव","poem":1},{"lineBreak":true},{"text":"कारण यापुढे मी इस्राएल राष्ट्रावर दया","poem":1},{"lineBreak":true},{"text":"करणार नाही व त्यास क्षमा करणार नाही.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तरीही मी यहूदाच्या घराण्यावर दया करीन","poem":1},{"lineBreak":true},{"text":"मी परमेश्वर त्यांना धनुष्य, तलवार, लढाई,","poem":1},{"lineBreak":true},{"text":"घोडे किंवा घोडेस्वार यांच्या बळाने नाही","poem":1},{"lineBreak":true},{"text":"तर त्यांना स्वबळाने सोडवेन.","poem":1}]},{"type":"verse","number":8,"content":["मग लो-रुहामाचे दुध तुटल्यावर गोमर गर्भवती होऊन तिला मुलगा झाला."]},{"type":"verse","number":9,"content":["मग परमेश्वर म्हणाला,",{"text":"त्याचे नांव लो-अम्मी ठेव,","poem":1},{"lineBreak":true},{"text":"कारण तुम्ही माझे लोक नाही","poem":1},{"lineBreak":true},{"text":"आणि मी तुमचा देव नाही.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"जरी इस्राएलच्या लोकांची संख्या","poem":1},{"lineBreak":true},{"text":"समुद्राच्या वाळूकणांसारखी असेल","poem":1},{"lineBreak":true},{"text":"जी मोजता येत नाही","poem":1},{"lineBreak":true},{"text":"हे असे घडेल की,","poem":1},{"lineBreak":true},{"text":"जिथे तुम्ही माझे लोक नव्हते","poem":1},{"lineBreak":true},{"text":"तेथे त्यांना जिवंत देवाचे पुत्र असे म्हणतील.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"यहूदाचे लोक व इस्राएलचे","poem":1},{"text":"लोक एकत्र येऊन आपणावर","poem":2},{"text":"एक पुढारी नेमतील","poem":1},{"lineBreak":true},{"text":"व त्या देशातून निघून येतील","poem":1},{"lineBreak":true},{"text":"तेव्हा इज्रेलाचा दिवस महान होईल.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"अर्थ-परमेश्वर विखरतो","reference":{"chapter":1,"verse":4}},{"noteId":1,"caller":"+","text":"इज्रेल शहरामध्ये येहुने इस्राएलचा राजा आणि राजघराण्यातील त्याच्या सर्व लोकांचा खून केला, आणि नवीन राज्याचा पहिला राजा बनला - 2 राजे 9-10 पहा.","reference":{"chapter":1,"verse":4}},{"noteId":2,"caller":"+","text":"अर्थ-दया नसणारा","reference":{"chapter":1,"verse":6}}]},"thisChapterLink":"/api/mar_irv/HOS/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/HOS/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/DAN/12.json","previousChapterAudioLinks":{},"numberOfVerses":11}