{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"HOS","translationId":"mar_irv","name":"होशेय","commonName":"होशेय","title":"होशेय","order":28,"numberOfChapters":14,"sha256":"c9a4a200f951f6b0cf36ef1602f7fa24e39d641cc1b5a67c0d66b52f15f70c3a","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mar_irv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"इस्राएल एक जोमाने वाढणारा द्राक्षीचा वेल आहे.","poem":1},{"lineBreak":true},{"text":"त्यास विपुल फळे येतात.","poem":1},{"lineBreak":true},{"text":"जसजसे त्याची फळे वाढली तसतशी त्याने वेद्या बांधल्या.","poem":1},{"lineBreak":true},{"text":"त्याची भूमी सुपीक झाली,","poem":1},{"lineBreak":true},{"text":"तो त्याने सुंदर स्तंभ उभारले.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"त्यांचे हृदय कपटी आहे,","poem":1},{"lineBreak":true},{"text":"त्यांना त्यांची शिक्षा होईल","poem":1},{"lineBreak":true},{"text":"परमेश्वर त्यांच्या वेद्या मोडून टाकेल","poem":1},{"lineBreak":true},{"text":"त्याच्या पवित्र स्तंभाचा नाश करेल.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"आता ते म्हणतील,","poem":1},{"lineBreak":true},{"text":"“आम्हास राजा नाही,","poem":1},{"lineBreak":true},{"text":"कारण आम्ही परमेश्वराचे भय मानले नाही","poem":1},{"lineBreak":true},{"text":"आणि राजा आमच्यासाठी काय करणार?”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ते पोकळ शब्द बोलतात","poem":1},{"lineBreak":true},{"text":"खोट्या शपथा वाहून करार करतात,","poem":1},{"lineBreak":true},{"text":"म्हणून जसे शेताच्या तासात विषारी रानटी झुडूप उगवतात","poem":1},{"lineBreak":true},{"text":"तसा त्यांच्यावर न्याय येईल.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"शोमरोनाचे रहिवासी","poem":1},{"lineBreak":true},{"text":"बेथआवेनच्या वासरांसाठी घाबरे होतील","poem":1},{"lineBreak":true},{"text":"त्यांचे लोक त्यांच्यासाठी विलाप करतील,","poem":1},{"lineBreak":true},{"text":"सोबतच त्यांचे मुर्तीपुजक पुजारी","poem":1},{"lineBreak":true},{"text":"जे त्याच्या वैभवावर आनंद करत होते","poem":1},{"lineBreak":true},{"text":"आता ते त्यांच्याबरोबर नाहीत.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ते अश्शूरास त्यांच्या महान राजासाठी भेट म्हणून नेण्यात येतील.","poem":1},{"lineBreak":true},{"text":"एफ्राईम लज्जीत होईल,","poem":1},{"lineBreak":true},{"text":"आणि मुर्तीच्या सल्ल्याने वागल्यामुळे","poem":1},{"lineBreak":true},{"text":"इस्राएल लज्जीत होईल.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"शोमरोनाचा राजा पाण्यावर","poem":1},{"lineBreak":true},{"text":"तरंगणाऱ्या ढलण्यासारखा नाश पावेल.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"दुष्टतेची श्रध्दास्थानाने","poem":1},{"lineBreak":true},{"text":"आणि इस्राएलाची पापे नाश पावतील","poem":1},{"lineBreak":true},{"text":"त्यांच्या वेदींवर काटे व काटेरी झुडपे उगवतील.","poem":1},{"lineBreak":true},{"text":"लोक पर्वतास म्हणतील, “आम्हास झाका”","poem":1},{"lineBreak":true},{"text":"आणि टेकडयास म्हणतील, “आमच्यावर पडा”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"इस्राएला,","poem":1},{"lineBreak":true},{"text":"गिबाच्या दिवसापासून तू पाप करत आहेस;","poem":1},{"lineBreak":true},{"text":"तू तिथेच राहिला आहेस","poem":1},{"lineBreak":true},{"text":"गिबाच्या दुष्टांसोबत झालेल्या लढाईत ते सापडले नाहीत?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"मला वाटेल तेव्हा मी त्यास शिस्त लावीन,","poem":1},{"lineBreak":true},{"text":"त्यांच्या विरोधात राष्ट्रे एकत्र येतील","poem":1},{"lineBreak":true},{"text":"व त्यांच्या दोन्ही पापांसाठी त्यांना बेड्या टाकतील.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"एफ्राईम ही प्रशिक्षित कालवड आहे","poem":1},{"lineBreak":true},{"text":"तिला मळणी करायला आवडते म्हणून","poem":1},{"lineBreak":true},{"text":"मी तिच्या गोऱ्या मानेवर जू ठेवीन.","poem":1},{"lineBreak":true},{"text":"मी एफ्राईमावर जू ठेवीन,","poem":1},{"lineBreak":true},{"text":"यहूदा नांगरील, याकोब ढेकळे फोडील.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"तुम्ही आपणासाठी धार्मिकतेची पेरणी करा","poem":1},{"lineBreak":true},{"text":"आणि कराराच्या विश्वासूपणाची","poem":1},{"lineBreak":true},{"text":"फळे तोडा, तुमची पडीत भूमी नांगरुन काढा,","poem":1},{"lineBreak":true},{"text":"कारण जोपर्यंत तो येऊन धार्मिकतेचा पाऊस पाडत नाही,","poem":1},{"lineBreak":true},{"text":"तोपर्यंत परमेश्वरास शोधण्याचीच ही वेळ आहे.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"तुम्ही दुष्टतेची नांगरणी केली,","poem":1},{"lineBreak":true},{"text":"तुम्ही अन्यायाची कापणी केली,","poem":1},{"lineBreak":true},{"text":"तुम्ही फसवणूकीचे फळ खाल्ले","poem":1},{"lineBreak":true},{"text":"कारण तू तुझ्या योजनांवर","poem":1},{"lineBreak":true},{"text":"आणि तुझ्या पुष्कळ सैनिकांवर विश्वास ठेवला.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"म्हणून तुझ्या लोकांमध्ये युध्दाचा गलबला होईल","poem":1},{"lineBreak":true},{"text":"आणि तुझी सर्व तटबंदीची शहरे नष्ट होतील.","poem":1},{"lineBreak":true},{"text":"हे असे घडेल जसे शल्मनाने बेथ-आर्बिलाच्या युध्दात नाश केला","poem":1},{"lineBreak":true},{"text":"तेव्हा आईला मुलांसह आपटून मारले गेले.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"तुझ्या अती","poem":1},{"lineBreak":true},{"text":"दुष्टपणामुळे बेथेल तुझ्यासोबत असेच करील.","poem":1},{"lineBreak":true},{"text":"प्रभातसमयी इस्राएलाचा राजा पूर्णपणे नाश पावील.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}