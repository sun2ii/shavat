{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"HOS","translationId":"mar_irv","name":"होशेय","commonName":"होशेय","title":"होशेय","order":28,"numberOfChapters":14,"sha256":"c9a4a200f951f6b0cf36ef1602f7fa24e39d641cc1b5a67c0d66b52f15f70c3a","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mar_irv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["आपल्या स्वच्छंदी लोकांबद्दल देवाचा कळवळा"]},{"type":"verse","number":1,"content":[{"text":"जेव्हा इस्राएल बालक होता तेव्हा त्यावर प्रेम केले,","poem":1},{"lineBreak":true},{"text":"आणि माझ्या पुत्राला मिसरातून बोलावले.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"त्यांना जेवढे बोलविले तेवढे","poem":1},{"lineBreak":true},{"text":"ते माझ्यापासून दूर जात","poem":1},{"lineBreak":true},{"text":"ते बआलास बली","poem":1},{"lineBreak":true},{"text":"आणि मुर्तीस धूप जाळत.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तरी तो मीच ज्याने एफ्राईमास चालणे शिकविले","poem":1},{"lineBreak":true},{"text":"तो मीच ज्याने त्यास हात धरुन उभे केले","poem":1},{"lineBreak":true},{"text":"पण त्यांना माहीत नव्हते की मी त्यांची काळजी घेत होतो.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"मी त्यांना मानवता","poem":1},{"lineBreak":true},{"text":"आणि प्रेमाच्या दोरीने चालवत होतो","poem":1},{"lineBreak":true},{"text":"मी त्यांना त्यासारखा होतो जो तोंडावरचे जू काढतो","poem":1},{"lineBreak":true},{"text":"आणि मी खाली वाकून त्यांना खाऊ घातले.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ते मिसरात परत येणार काय?","poem":1},{"lineBreak":true},{"text":"अश्शूर त्यावर राज्य करणार काय?","poem":1},{"lineBreak":true},{"text":"कारण ते मजकडे परत येण्याचे नाकारतात?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"त्यांच्या नगरावर तलवार चालेल","poem":1},{"lineBreak":true},{"text":"आणि ती त्याच्या दाराचे अडसर नष्ट करील,","poem":1},{"lineBreak":true},{"text":"त्यांचा नाश त्यांच्या स्वत:च्या योजनांमुळे होईल.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"माझ्या लोकांस मजपासून वळवण्याचा निश्चय केला आहे","poem":1},{"lineBreak":true},{"text":"तरी ते त्यांना जो मी परमप्रधान आहे","poem":1},{"lineBreak":true},{"text":"त्याकडे बोलवितात तरी त्यापैकी कोणीही मला गौरव देत नाही.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"हे एफ्राईमे,","poem":1},{"lineBreak":true},{"text":"मी तुझा त्याग कसा करु? हे इस्राएला,","poem":1},{"lineBreak":true},{"text":"मी तुला शत्रुच्या हाती कसा देऊ?","poem":1},{"lineBreak":true},{"text":"मी तुला अदमासारखे कसे करु?","poem":1},{"lineBreak":true},{"text":"मी तुला सबोयिमासारखे कसे करु?","poem":1},{"lineBreak":true},{"text":"माझे हृदय खळबळले आहे, माझी करुणा ढवळली गेली आहे.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"मी माझा भयानक राग अमलात","poem":1},{"lineBreak":true},{"text":"आणणार नाही मी एफ्राईमाचा पुन्हा नाश करणार","poem":1},{"lineBreak":true},{"text":"नाही कारण मी देव आहे","poem":1},{"lineBreak":true},{"text":"आणि मनुष्य नाही","poem":1},{"lineBreak":true},{"text":"तुमच्यामध्ये असणारा","poem":1},{"lineBreak":true},{"text":"मी पवित्र आहे मी क्रोधाने येणार नाही.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ते माझ्यामागे चालतील मी परमेश्वर","poem":1},{"lineBreak":true},{"text":"सिंहासारखी गर्जना करेन","poem":1},{"lineBreak":true},{"text":"मी खरोखर गर्जेन","poem":1},{"lineBreak":true},{"text":"आणि लोक पश्चिमेकडून थरथरत येतील.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ते मिसरातून पक्षासारखे","poem":1},{"lineBreak":true},{"text":"आणि अश्शूरातून कबुतरा प्रमाणे थरथरत येतील","poem":1},{"lineBreak":true},{"text":"मी त्यांना त्यांच्या घरात बसवीन असे परमेश्वर म्हणतो.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"एफ्राईम मला लबाडीने","poem":1},{"lineBreak":true},{"text":"आणि इस्राएलचे घराणे कपटाने वेढले,","poem":1},{"lineBreak":true},{"text":"पण यहूदा आतापर्यंत देवाबरोबर,","poem":1},{"lineBreak":true},{"text":"जो पवित्र आहे, त्याबरोबर विश्वासू बनून आहे.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}