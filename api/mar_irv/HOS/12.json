{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"HOS","translationId":"mar_irv","name":"होशेय","commonName":"होशेय","title":"होशेय","order":28,"numberOfChapters":14,"sha256":"c9a4a200f951f6b0cf36ef1602f7fa24e39d641cc1b5a67c0d66b52f15f70c3a","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mar_irv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"heading","content":["लबाडी व छळ ह्यांबद्दल एफ्राइमाचा निषेध"]},{"type":"verse","number":1,"content":[{"text":"एफ्राईम वारा जोपासतो,","poem":1},{"lineBreak":true},{"text":"आणि पूर्वेच्या वाऱ्याचा पाठलाग करतो,","poem":1},{"lineBreak":true},{"text":"तो सतत लबाडी आणि हिंसा वाढवतो,","poem":1},{"lineBreak":true},{"text":"तो अश्शूरांशी करार करतो,","poem":1},{"lineBreak":true},{"text":"आणि मिसरात जैतूनाचे तोल घेऊन जातो.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"परमेश्वराचा वाद यहूदाशी आहे.","poem":1},{"lineBreak":true},{"text":"आणि तो याकोबास त्याच्या कृत्याचे शासन करील.","poem":1},{"lineBreak":true},{"text":"त्यांचे प्रतिफळ त्यास मिळेल.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"गर्भात असता याकोबाने आपल्या भावाची टाच घट्ट धरली,","poem":1},{"lineBreak":true},{"text":"आणि तरुणपणी देवासोबत झोंबी केली.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"त्या स्वर्गदूताशी झोंबी केली, आणि जिंकला,","poem":1},{"lineBreak":true},{"text":"त्याने रडून देवाची करुणा भाकली,","poem":1},{"lineBreak":true},{"text":"तो बेथेलास देवाला भेटला,","poem":1},{"lineBreak":true},{"text":"देव तेथे त्याच्याबरोबर बोलला.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"हा परमेश्वर, सेनेचा देव","poem":1},{"lineBreak":true},{"text":"ज्यांचे स्मरण ‘परमेश्वर’ नावाने होते.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"म्हणून तू आपल्या देवाकडे वळ,","poem":1},{"lineBreak":true},{"text":"विश्वासू आणि न्यायी राहून त्याचा करार पाळ,","poem":1},{"lineBreak":true},{"text":"आणि तुझ्या देवाची निरंतर वाट पहा.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"व्यापाऱ्याच्या हातात खोटे तराजू आहेत,","poem":1},{"lineBreak":true},{"text":"फसवेगिरी करण्याची त्यांना आवड आहे.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"एफ्राईम म्हणाला, “मी खरोखर धनवान झालो आहे,","poem":1},{"lineBreak":true},{"text":"माझ्यासाठी संपत्ती मिळवली आहे.","poem":1},{"lineBreak":true},{"text":"माझ्या सर्व कामात त्यांना अन्याय दिसला नाही,","poem":1},{"lineBreak":true},{"text":"ज्यामध्ये माझ्यात पाप आढळते.”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"मी परमेश्वर तुझा देव, जो मिसर देशापासून तुझ्याबरोबर आहे,","poem":1},{"lineBreak":true},{"text":"नेमलेल्या सणाच्या दिवसाप्रमाणे","poem":1},{"lineBreak":true},{"text":"मी तुला पुन्हा तंबूत वसविणार.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"मी संदेष्टयांशी देखील बोललो आहे.","poem":1},{"lineBreak":true},{"text":"आणि त्यांना मी पुष्कळ दृष्टांत दिले आहेत,","poem":1},{"lineBreak":true},{"text":"मी त्यांना संदेष्ट्यांद्वारे दाखले दिले आहे.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"जर गिलादामध्ये दुष्टता असली","poem":1},{"lineBreak":true},{"text":"तर निश्चितच लोक नालायक आहेत.","poem":1},{"lineBreak":true},{"text":"गिलादात ते बैल अर्पण करतात,","poem":1},{"lineBreak":true},{"text":"त्यांच्या वेद्यांची संख्या शेतातील तासामध्ये असलेल्या दगडाएवढी आहे.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"याकोब अरामाच्या मैदानात पळून गेला.","poem":1},{"lineBreak":true},{"text":"इस्राएलाने पत्नीसाठी चाकरी केली","poem":1},{"lineBreak":true},{"text":"आपल्या पत्नीसाठी मेंढरे राखली.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"परमेश्वराने एका संदेष्ट्याद्वारे मिसरातून इस्राएलास बाहेर काढले,","poem":1},{"lineBreak":true},{"text":"आणि संदेष्ट्याद्वारेच त्यांची काळजी घेतली.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"एफ्राईमाने परमेश्वराचा क्रोध अत्यंत चेतवला आहे.","poem":1},{"lineBreak":true},{"text":"म्हणून त्याचा धनी त्याच्या रक्तपाताचा दोष त्याच्यावर आणिल","poem":1},{"lineBreak":true},{"text":"आणि त्याच्या लज्जास्पद कामाची त्यास परतफेड करील.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}