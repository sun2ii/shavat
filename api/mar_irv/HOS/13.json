{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"HOS","translationId":"mar_irv","name":"होशेय","commonName":"होशेय","title":"होशेय","order":28,"numberOfChapters":14,"sha256":"c9a4a200f951f6b0cf36ef1602f7fa24e39d641cc1b5a67c0d66b52f15f70c3a","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mar_irv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"heading","content":["एफ्राइमाच्या समूळ नाशाबद्दलचे भाकीत"]},{"type":"verse","number":1,"content":[{"text":"एफ्राईम बोलत असे तेव्हा लोकांचा थरकाप होई;","poem":1},{"lineBreak":true},{"text":"तो इस्राएलाचा सरदार झाला;","poem":1},{"lineBreak":true},{"text":"पण पुढे बआलमूर्तीमुळे दोषी होऊन तो लोपला.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"आता ते अधिकाधिक पाप करु लागले","poem":1},{"lineBreak":true},{"text":"ते चांदीच्या ओतीव मूर्ती आपल्या कुशलतेने कारागीर बनवतो","poem":1},{"lineBreak":true},{"text":"तसे बनवू लागले.","poem":1},{"lineBreak":true},{"text":"लोक म्हणू लागले,","poem":1},{"lineBreak":true},{"text":"“जे बलिदान करतात त्यांनी वासरांचे चुंबन घ्या”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"म्हणून पहाटेच्या ढगासारखे","poem":1},{"lineBreak":true},{"text":"लवकर उडून जाणाऱ्या दवासारखे खळ्यातून","poem":1},{"lineBreak":true},{"text":"वाऱ्याने उडणाऱ्या भुसासारखे","poem":1},{"lineBreak":true},{"text":"आणि धुराडयातून उडणाऱ्या धुरासारखे ते होतील.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"पण मी तुमचा देव परमेश्वर आहे,","poem":1},{"lineBreak":true},{"text":"ज्याने तुम्हास मिसरातून बाहेर काढले, माझ्याशिवाय तुम्हास अन्य देव नाही,","poem":1},{"lineBreak":true},{"text":"माझ्याशिवाय कोणी तारक नाही.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"मी तुम्हास रानात,","poem":1},{"lineBreak":true},{"text":"रुक्ष प्रदेशात जाणून होतो.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"जेव्हा तुम्हास चारा मिळाला तेव्हा तुम्ही तृप्त झालात,","poem":1},{"lineBreak":true},{"text":"आणि जेव्हा तुमचे पोट भरले तेव्हा तुमचे हृदय उन्मत्त झाले;","poem":1},{"lineBreak":true},{"text":"त्या कारणास्तव तुम्ही मला विसरला.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"म्हणून मी सिंहासारखा तुमच्याशी वागेन,","poem":1},{"lineBreak":true},{"text":"चित्याप्रमाणे तुमच्या वाटेवर दबा धरुन बसेन.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"जिची पिल्ले चोरी झाली,","poem":1},{"lineBreak":true},{"text":"अशा अस्वली सारखा मी तुमच्यावर हल्ला करीन, मी तुमचे उर फाडीन,","poem":1},{"lineBreak":true},{"text":"आणि सिंहिनीप्रमाणे तुम्हास खाऊन टाकेन,","poem":1},{"lineBreak":true},{"text":"जसा वनपशू तुम्हास फाडून टाकतो.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"इस्राएला हा तुझा नाश आहे जो येत आहे,","poem":1},{"lineBreak":true},{"text":"कारण तू माझ्या म्हणजे तुझ्या सहाय्यकर्त्यांच्या विरोधात गेला आहेस.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"तुझा राजा कोठे आहे?","poem":1},{"lineBreak":true},{"text":"जो तुझ्या सर्व नगरांचे रक्षण करतो","poem":1},{"lineBreak":true},{"text":"तुझे अधीपती कोठे आहेत? ज्याविषयी तू मला म्हटले,","poem":1},{"lineBreak":true},{"text":"“मला राजा आणि अधिपती दे?”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"मी क्रोधाने तुला राजा दिला","poem":1},{"lineBreak":true},{"text":"आणि रागाने त्यास काढूनही घेतले.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"एफ्राईमाचा अन्याय गोळा केला आहे,","poem":1},{"lineBreak":true},{"text":"त्याच्या अपराधाची रास करण्यात आली आहे.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"प्रसूतिवेदना त्याच्यावर येतील,","poem":1},{"lineBreak":true},{"text":"पण तो अक्कलशून्य मुलगा आहे,","poem":1},{"lineBreak":true},{"text":"कारण जन्म घेण्याच्या वेळी तो गर्भातून बाहेर येत नाही.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"मी त्यांना खरोखर अधोलोकाच्या बळापासून सोडवीन काय?","poem":1},{"lineBreak":true},{"text":"मी त्यांना खरोखर मरणातून सोडवणार काय?","poem":1},{"lineBreak":true},{"text":"मरणा, तुझ्या महामाऱ्या कोठे आहेत?","poem":1},{"lineBreak":true},{"text":"आणि इथे कळवळा माझ्या समोरुन लपलेला आहे.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"एफ्राईम आपल्या भावांमध्ये जरी प्रगत झाला,","poem":1},{"lineBreak":true},{"text":"तरी पूर्वेचा वारा येईल,","poem":1},{"lineBreak":true},{"text":"परमेश्वराचा वारा रानातून येईल","poem":1},{"lineBreak":true},{"text":"एफ्राईमाचा झरा सुकून जाईल,","poem":1},{"lineBreak":true},{"text":"त्याच्या विहिरीत पाणी राहणार नाही.","poem":1},{"lineBreak":true},{"text":"त्यांचा शत्रू त्याच्या सर्व मौल्यवान वस्तू लुटून नेईल.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"शोमरोनात दोष येईल,","poem":1},{"lineBreak":true},{"text":"कारण त्याने देवाविरुध्द बंड केले आहे","poem":1},{"lineBreak":true},{"text":"ते तलवारीने पडतील.","poem":1},{"lineBreak":true},{"text":"त्यांची लहान मुले आपटली जातील","poem":1},{"lineBreak":true},{"text":"आणि त्यांच्या गर्भवती स्त्रिया चिरुन टाकण्यात येतील.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":16}