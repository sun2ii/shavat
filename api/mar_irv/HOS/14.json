{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"HOS","translationId":"mar_irv","name":"होशेय","commonName":"होशेय","title":"होशेय","order":28,"numberOfChapters":14,"sha256":"c9a4a200f951f6b0cf36ef1602f7fa24e39d641cc1b5a67c0d66b52f15f70c3a","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mar_irv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"heading","content":["परमेश्वराकडे वळण्यासाठी इस्त्राएलाला विनवणी"]},{"type":"verse","number":1,"content":[{"text":"हे इस्राएला, आपला देवा परमेश्वर याकडे परत ये,","poem":1},{"lineBreak":true},{"text":"तुझ्या दुष्टपणामुळे तुझे पतन झाले आहे.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"कबुलीच्या शब्दासोबत परमेश्वराकडे वळा, त्यास म्हणा,","poem":1},{"lineBreak":true},{"text":"आमचे अधर्म दूर कर आणि दयेने आमचा स्वीकार कर","poem":1},{"lineBreak":true},{"text":"म्हणजे आम्ही तुझी स्तुती करु,","poem":1},{"lineBreak":true},{"text":"आपल्या ओठांचे फळ तुला अर्पू.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"अश्शूर आम्हास तारणार नाही,","poem":1},{"lineBreak":true},{"text":"आम्ही युध्दासाठी घोड्यावर स्वार होणार नाही,","poem":1},{"lineBreak":true},{"text":"यापुढे आमच्या हाताच्या मूर्तीस आमचा देव म्हणणार नाही,","poem":1},{"lineBreak":true},{"text":"कारण तुझ्यामध्ये अनाथांना दया प्राप्त होते.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ज्यांनी मला सोडले ते जर परत मजकडे आले तर मी त्यांना आरोग्य देईन,","poem":1},{"lineBreak":true},{"text":"त्यांच्यावर मोकळ्या मनाने प्रीती करीन,","poem":1},{"lineBreak":true},{"text":"कारण माझा त्यांच्यावरचा राग गेला आहे.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"मी इस्राएलास दहीवरासारखा होईल,","poem":1},{"lineBreak":true},{"text":"तो भुकमळासारखा फुलेल","poem":1},{"lineBreak":true},{"text":"आणि लबानोनात देवदारूप्रमाणे मुळ धरील.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"त्याच्या फांद्या पसरतील,","poem":1},{"lineBreak":true},{"text":"त्याची सुंदरता जैतून वृक्षासारखी होईल,","poem":1},{"lineBreak":true},{"text":"आणि त्याचा सुगंध लबानोनातील देवदार वृक्षासारखा होईल.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"त्याच्या सावलीत राहणारे लोक परत येतील,","poem":1},{"lineBreak":true},{"text":"ते धान्यासारखे पुनर्जिवित होतील;","poem":1},{"lineBreak":true},{"text":"आणि द्राक्षाप्रमाणे फळ देतील,","poem":1},{"lineBreak":true},{"text":"त्याची प्रतिष्ठा लबानोनाच्या द्राक्षरसासारखी होईल.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"एफ्राईम म्हणेल, या मूर्त्यांचे मी काय करु?","poem":1},{"lineBreak":true},{"text":"मी त्यास उत्तर देईन त्याची काळजी घेईन","poem":1},{"lineBreak":true},{"text":"मी सारखा सदाहरित आहे,","poem":1},{"lineBreak":true},{"text":"माझ्यातून तुला फळ मिळते.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"कोण चतुर आहे ज्याला या गोष्टी समजतील?","poem":1},{"lineBreak":true},{"text":"कोण समंजस आहे ज्याला ते समजेल?","poem":1},{"lineBreak":true},{"text":"परमेश्वराचे मार्ग सरळ आहेत,","poem":1},{"lineBreak":true},{"text":"आणि धार्मिक त्यामध्ये चालतील पण बंडखोर त्यामध्ये अडखळून पडतील.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}