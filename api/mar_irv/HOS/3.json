{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"HOS","translationId":"mar_irv","name":"होशेय","commonName":"होशेय","title":"होशेय","order":28,"numberOfChapters":14,"sha256":"c9a4a200f951f6b0cf36ef1602f7fa24e39d641cc1b5a67c0d66b52f15f70c3a","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mar_irv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":3,"content":[{"type":"heading","content":["होशेय व जारिणी"]},{"type":"verse","number":1,"content":["परमेश्वर मला म्हणाला, परत जा, आणि अशा स्त्रीवर प्रेम कर जी दुराचारी असूनही आपल्या पतीस प्रिय आहे. तिच्यावर प्रेम कर जसे मी इस्राएल लोकांवर करतो जरी ते इतर देवतांकडे वळले आणि त्यांना मनुक्याची ढेप प्रिय वाटली."]},{"type":"verse","number":2,"content":["म्हणून मी पंधरा चांदीचे",{"noteId":6},"तुकडे व दिड मण जव देऊन तिला माझ्यासाठी विकत घेतले."]},{"type":"verse","number":3,"content":["मी तिला म्हणालो, पुष्कळ दिवस तू माझ्यासोबत राहा; यापुढे तू वेश्या नाहीस किंवा परपुरुषाची नाहीस, त्याचप्रकारे मी पण तुझ्याशी वागेन."]},{"type":"verse","number":4,"content":["कारण इस्राएलचे लोक बरेच दिवस राजा, सरदार, बलीदान, दगडी खांब, एफोद आणि गृहदेवता ह्यांवाचून राहतील."]},{"type":"verse","number":5,"content":["नंतर इस्राएलाचे लोक परत येतील व आपल्या देव परमेश्वर आणि राजा दावीद यांना शोधतील आणि शेवटच्या दिवसात, ते परमेश्वराच्या समोर त्याच्या चांगुलपणात भितीने कापत येतील."]}],"footnotes":[{"noteId":6,"caller":"+","text":"साधारण 170 ग्राम","reference":{"chapter":3,"verse":2}}]},"thisChapterLink":"/api/mar_irv/HOS/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/HOS/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/HOS/2.json","previousChapterAudioLinks":{},"numberOfVerses":5}