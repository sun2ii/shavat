{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"HOS","translationId":"mar_irv","name":"होशेय","commonName":"होशेय","title":"होशेय","order":28,"numberOfChapters":14,"sha256":"c9a4a200f951f6b0cf36ef1602f7fa24e39d641cc1b5a67c0d66b52f15f70c3a","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mar_irv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["इस्त्राएलाच्या पश्चात्तापाचा खोटेपणा"]},{"type":"verse","number":1,"content":[{"text":"“चला, आपण परमेश्वराकडे परत जाऊ,","poem":1},{"lineBreak":true},{"text":"कारण त्याने आमचे तुकडे केले आहे, आता तोच आम्हास बरे करील,","poem":1},{"lineBreak":true},{"text":"त्याने जखम केली, तोच आम्हास पट्टी बांधेल.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"दोन दिवसानंतर तो आम्हास पुन्हा जिवंत करेल,","poem":1},{"lineBreak":true},{"text":"तिसऱ्या दिवशी उचलून उभे करेल,","poem":1},{"lineBreak":true},{"text":"आणि आम्ही त्याच्या समोर जिवंत राहू.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"चला आपण परमेश्वरास ओळखू या,","poem":1},{"lineBreak":true},{"text":"प्रयत्नाने त्याचे ज्ञान मिळवूया,","poem":1},{"lineBreak":true},{"text":"तो खचित पहाटे सारखा उदय पावणार आहे,","poem":1},{"lineBreak":true},{"text":"भूमीवर पाऊस पडतो,","poem":1},{"lineBreak":true},{"text":"त्याप्रमाणे तो आमच्याकडे येणार आहे.”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"एफ्राईमा मी तुला काय करु?","poem":1},{"lineBreak":true},{"text":"यहूदा मी तुला काय करु?","poem":1},{"lineBreak":true},{"text":"तुमचा विश्वासू पहाटेच्या ढगाप्रमाणे,","poem":1},{"lineBreak":true},{"text":"आणि उडून जाणाऱ्या दवाप्रमाणे आहे.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"म्हणून मी माझ्या संदेष्ट्याद्वारे त्यांचे तुकडे केले आहे,","poem":1},{"lineBreak":true},{"text":"माझ्या तोंडाच्या शब्दाने त्यांना ठार केले आहे.","poem":1},{"lineBreak":true},{"text":"तुझा न्याय हा प्रकाशाप्रमाणे चमकत आहे.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"कारण मी बलिदान नाही तर विश्वासूपण इच्छितो,","poem":1},{"lineBreak":true},{"text":"मला होमबली पेक्षा देवाचे ज्ञान प्रिय आहे.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"आदामाप्रमाणे त्यांनी करार मोडला,","poem":1},{"lineBreak":true},{"text":"ते माझ्याशी अविश्वासूपणे वागले.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"गिलाद हे दुष्टांचे शहर आहे,","poem":1},{"lineBreak":true},{"text":"त्यावर रक्ताची पाऊले उमटली आहे.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"जशी लुटारुंची टोळी टपून बसते,","poem":1},{"lineBreak":true},{"text":"तसा याजकांचा समूह आहे, ते शखेमाच्या वाटेवर खून करतात,","poem":1},{"lineBreak":true},{"text":"त्यांनी महापातके केली आहेत.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"इस्राएलाच्या घराण्यात मी भयावह प्रकार पाहिला आहे,","poem":1},{"lineBreak":true},{"text":"एफ्राईमाचा व्यभिचार तेथे आहे, आणि इस्राएल प्रदुषित झाला आहे.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"तुझ्यासाठी यहूदा, हंगामाची वेळ येईल,","poem":1},{"lineBreak":true},{"text":"तेव्हा मी माझ्या लोकांस बंदिवासापासून मुक्त करीन.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}