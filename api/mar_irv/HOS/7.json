{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"HOS","translationId":"mar_irv","name":"होशेय","commonName":"होशेय","title":"होशेय","order":28,"numberOfChapters":14,"sha256":"c9a4a200f951f6b0cf36ef1602f7fa24e39d641cc1b5a67c0d66b52f15f70c3a","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mar_irv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"heading","content":["इस्त्राएलाचा अधर्म व बंड"]},{"type":"verse","number":1,"content":[{"text":"जेव्हा मी इस्राएलास आरोग्य देऊ पाहतो,","poem":1},{"lineBreak":true},{"text":"तेव्हा एफ्राईमाचे पाप","poem":1},{"lineBreak":true},{"text":"आणि शोमरोनाची अधमता उघड होते.","poem":1},{"lineBreak":true},{"text":"ते कट रचतात,","poem":1},{"lineBreak":true},{"text":"चोर आत शिरतो,","poem":1},{"lineBreak":true},{"text":"आणि रस्त्यावर लुटारुंची टोळी हल्ला करते.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मी त्यांचे दुराचार आठवतो;","poem":1},{"lineBreak":true},{"text":"याची त्यांना त्यांच्या हृदयात जाणीवही नाही,","poem":1},{"lineBreak":true},{"text":"त्यांच्या कृत्यांनी त्यांना घेरले आहे,","poem":1},{"lineBreak":true},{"text":"ते माझ्या मुखासमोर आहे.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ते आपल्या वाईटाने राजाला,","poem":1},{"lineBreak":true},{"text":"आणि लबाडीने अधिकाऱ्याला खूश करतात.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ते सर्व व्यभिचारी आहेत.","poem":1},{"lineBreak":true},{"text":"जसा भटारी भट्टी पेटवून","poem":1},{"lineBreak":true},{"text":"कनिक भिजवतो;","poem":1},{"lineBreak":true},{"text":"व ते खमिराने फुगत नाही तसे ते आहेत.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"राजाच्या शुभ दिवशी अधिकारी मद्य पिऊन मस्त झाले;","poem":1},{"lineBreak":true},{"text":"मग त्याने आपला हात थट्टा करणाऱ्यांच्या हाती दिला.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"भट्टीसारख्या हृदयाने ते कपटी","poem":1},{"lineBreak":true},{"text":"आणि फसव्या योजना करतात.","poem":1},{"lineBreak":true},{"text":"त्यांचा राग रात्रभर अग्नीसारखा धुमसतो,","poem":1},{"lineBreak":true},{"text":"आणि सकाळी धगधगणाऱ्या आग्नीसारखा जळतो.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ते सर्व भट्टी सारखे गरम आहेत,","poem":1},{"lineBreak":true},{"text":"ते आपल्या राज्यकर्त्यांस गिळून टाकतात,","poem":1},{"lineBreak":true},{"text":"त्यांचे सर्व राजे पतन पावले आहे,","poem":1},{"lineBreak":true},{"text":"त्यांच्यातील कोणीही माझा धावा करीत नाही.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"एफ्राईम त्या लोकांसोबत मिसळतो,","poem":1},{"lineBreak":true},{"text":"एफ्राईम न पलटलेल्या भाकरीसारखा झाला आहे.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"परक्यांनी त्याची ताकद गिळली आहे;","poem":1},{"lineBreak":true},{"text":"पण त्यास हे ठाऊक नाही.","poem":1},{"lineBreak":true},{"text":"त्याचे काही केस पांढरे झाले आहेत,","poem":1},{"lineBreak":true},{"text":"पण ते त्यास माहित नाही.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"इस्राएलाचा गर्व त्यांच्या विरोधात साक्ष देतो,","poem":1},{"lineBreak":true},{"text":"इतके असूनही ते आपला देव परमेश्वराकडे वळत नाहीत,","poem":1},{"lineBreak":true},{"text":"हे करण्यापेक्षा ते त्यास शोधत नाही.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"एफ्राईम कबुतरा सारखा भोळा व भावनाहीन आहे,","poem":1},{"lineBreak":true},{"text":"तो मिसराला हाक मारतो,","poem":1},{"lineBreak":true},{"text":"नंतर अश्शूरास उडून जातो.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"जेव्हा ते जातील, मी आपले जाळे त्यांच्यावर टाकेन,","poem":1},{"lineBreak":true},{"text":"आकाशतल्या पक्षांप्रमाणे","poem":1},{"lineBreak":true},{"text":"मी त्यांना खाली आणिन,","poem":1},{"lineBreak":true},{"text":"लोकांच्या समुदायामध्ये मी त्यांना शिक्षा करीन.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"हायहाय, त्यांना!","poem":1},{"lineBreak":true},{"text":"कारण ते मजपासून बहकले आहेत.","poem":1},{"lineBreak":true},{"text":"त्यांच्यावर नाश येत आहे!","poem":1},{"lineBreak":true},{"text":"त्यांनी माझ्याविरुध्द फितुरी केली आहे.","poem":1},{"lineBreak":true},{"text":"मी त्यांची सुटका केली असती;","poem":1},{"lineBreak":true},{"text":"पण त्यांनी माझ्या विरोधात लबाडी केली आहे.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"त्यांनी त्यांच्या हृदयापासून माझा धावा केला नाही,","poem":1},{"lineBreak":true},{"text":"परंतू ते पलंगावर पडून धान्य व नव्या द्राक्षरसासाठी विलाप करतात,","poem":1},{"lineBreak":true},{"text":"ते माझ्यापासून बहकले आहेत.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"जरी मी त्यास शिक्षण दिले आणि त्यांना बाहूबल दिले,","poem":1},{"lineBreak":true},{"text":"आता ते माझ्या विरोधात कट रचतात.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ते परत फिरतात,","poem":1},{"lineBreak":true},{"text":"पण ते मी जो सर्वोच्च देव आहे,","poem":1},{"lineBreak":true},{"text":"त्याकडे फिरत नाही,","poem":1},{"lineBreak":true},{"text":"ते फसव्या धनुष्यासारखे झाले आहेत,","poem":1},{"lineBreak":true},{"text":"त्यांचे अधिकारी आपल्या जिभेच्या उन्मतपणामुळे तलवारीने पाडले जातील,","poem":1},{"lineBreak":true},{"text":"मिसरात त्यांची थट्टा करण्यात येईल.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}