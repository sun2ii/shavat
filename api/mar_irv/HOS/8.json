{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"HOS","translationId":"mar_irv","name":"होशेय","commonName":"होशेय","title":"होशेय","order":28,"numberOfChapters":14,"sha256":"c9a4a200f951f6b0cf36ef1602f7fa24e39d641cc1b5a67c0d66b52f15f70c3a","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mar_irv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["मूर्तीपूजेबद्दल इस्त्राएलाचा निषेध"]},{"type":"verse","number":1,"content":[{"text":"“मुखाला तुतारी लाव,","poem":1},{"lineBreak":true},{"text":"परमेश्वराच्या, घरावर गरुड येत आहे,","poem":1},{"lineBreak":true},{"text":"हे यासाठी घडत आहे कारण लोकांनी माझा करार मोडून","poem":1},{"lineBreak":true},{"text":"माझ्या नियम शास्त्राच्या विरोधात बंड केले आहे.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ते माझा धावा करतात,","poem":1},{"lineBreak":true},{"text":"माझ्या देवा, आम्ही इस्राएली तुला जाणतो”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"पण इस्राएलाने जे चांगले ते नाकारले आहे,","poem":1},{"lineBreak":true},{"text":"आणि शत्रू त्याचा पाठलाग करेल.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"त्यांनी राजे नेमले,","poem":1},{"lineBreak":true},{"text":"पण माझ्या द्वारे नाही;","poem":1},{"lineBreak":true},{"text":"त्यांनी राजपुत्र स्थापले आहे,","poem":1},{"lineBreak":true},{"text":"पण माझे ज्ञान न घेता त्यांनी,","poem":1},{"lineBreak":true},{"text":"आपले सोने व चांदी घेऊन,","poem":1},{"lineBreak":true},{"text":"स्वत:साठी मूर्ती बनविल्या आहेत.","poem":1},{"lineBreak":true},{"text":"त्यानेच ते नाश पावतील.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"संदेष्टा म्हणतो, हे शोमरोना तुझे वासरू त्याने नाकारले आहे,","poem":1},{"lineBreak":true},{"text":"परमेश्वर म्हणतो, या लोकांविरुध्द माझा राग पेटेल,","poem":1},{"lineBreak":true},{"text":"किती वेळ ते अशुद्ध राहणार?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"कारण ही मूर्ती इस्राएलातून आली,","poem":1},{"lineBreak":true},{"text":"कारागिराने बनवली,","poem":1},{"lineBreak":true},{"text":"ती देव नाही शोमरोनाच्या","poem":1},{"lineBreak":true},{"text":"वासराचे तुकडे होतील.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"कारण लोक वारा पेरतात","poem":1},{"lineBreak":true},{"text":"आणि वावटळीची कापणी करतात,","poem":1},{"lineBreak":true},{"text":"उभ्या पिकाला कणीस नाही,","poem":1},{"lineBreak":true},{"text":"ते धान्याचे पिठ उत्पन्न करणार नाही,","poem":1},{"lineBreak":true},{"text":"आणि जर त्याची पूर्ण वाढ झाली","poem":1},{"lineBreak":true},{"text":"तरी परके त्यास गिळून टाकतील.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"इस्राएलास गिळले आहे,","poem":1},{"lineBreak":true},{"text":"आता ते देशामध्ये बिन कामाची लबाडी करतात.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"कारण ते अश्शूरास रानगाढवासारखे गेले,","poem":1},{"lineBreak":true},{"text":"एफ्राईमाने आपल्यासाठी प्रियकर नेमले आहेत.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"जरी त्यांनी देशात प्रियकर नेमले,","poem":1},{"lineBreak":true},{"text":"तरी मी त्यांना आता एकत्र करीन.","poem":1},{"lineBreak":true},{"text":"राजे आणि पुढारी यांच्या दबावामुळे ते कमी होतील.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"कारण एफ्राईमाने पापबलींसाठी आपल्या वेद्या वाढवल्या आहेत,","poem":1},{"lineBreak":true},{"text":"पण त्या वेद्या पाप करण्याचे कारण ठरल्या आहेत.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"मी असंख्य वेळा माझे नियमशास्त्र त्यांच्यासाठी लिहीले,","poem":1},{"lineBreak":true},{"text":"पण ते त्याकडे अनोळख्या सारखे पाहतात.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"मला अर्पणे करावी म्हणून","poem":1},{"lineBreak":true},{"text":"ते मांस देतात व खातात,","poem":1},{"lineBreak":true},{"text":"पण मी परमेश्वर,","poem":1},{"lineBreak":true},{"text":"ते स्वीकारत नाही.","poem":1},{"lineBreak":true},{"text":"आता मी त्यांचे पाप स्मरण करून","poem":1},{"lineBreak":true},{"text":"त्यांना शासन करणार, ते मिसर देशात परत जातील.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"इस्राएलाला आपल्या निर्माणकर्त्या परमेश्वराचा विसर पडला आहे","poem":1},{"lineBreak":true},{"text":"आणि त्याने महाल बांधले आहेत,","poem":1},{"lineBreak":true},{"text":"यहूदाने तटबंदीची नगरे वसवली आहेत,","poem":1},{"lineBreak":true},{"text":"पण मी त्याच्या शहरावर अग्नी पाठवीन,","poem":1},{"lineBreak":true},{"text":"तो त्याची तटबंदी नष्ट करून टाकेल.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}