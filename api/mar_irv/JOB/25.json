{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"JOB","translationId":"mar_irv","name":"ईयोब","commonName":"ईयोब","title":"ईयोब","order":18,"numberOfChapters":42,"sha256":"6db158ca35ee4b5a5284d7f22c1e4166cacf3fa04991d2765090bfbc62b50082","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mar_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["देवापुढे मानव न्यायी ठरत नाही असे बिल्ददचे म्हणणे"]},{"type":"verse","number":1,"content":["नंतर बिल्दद शूहीने उत्तर दिले व तो म्हणाला,"]},{"type":"verse","number":2,"content":[{"text":"“अधीकार चालवणे व भीती दाखवणे हे देवाकडेच आहे,","poem":1},{"lineBreak":true},{"text":"तो स्वर्गाच्या उच्च स्थानामध्ये शांती राखतो.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"त्याच्या सैन्याची मोजणी करीता येईल काय?","poem":1},{"lineBreak":true},{"text":"कोणावर त्याचा प्रकाश पडत नाही?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"मनुष्य देवापुढे नितीमान कसा ठरेल?","poem":1},{"lineBreak":true},{"text":"स्त्रीपासुन जन्मलेला निर्मळ कसा ठरेल, व त्यास स्विकारले जाईल.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"पाहा, त्याच्या दृष्टीने चंद्र सुध्दा तेजोमय नाही.","poem":1},{"lineBreak":true},{"text":"त्याच्या दृष्टीला तारे देखील पवित्र वाटत नाहीत.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मग मनुष्य किती कमी आहे, एखाद्या अळीप्रमाणे आहे. तो जंतूप्रमाणे आहे.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}