{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"JOB","translationId":"mar_irv","name":"ईयोब","commonName":"ईयोब","title":"ईयोब","order":18,"numberOfChapters":42,"sha256":"6db158ca35ee4b5a5284d7f22c1e4166cacf3fa04991d2765090bfbc62b50082","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mar_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"heading","content":["ईयोब देवाच्या सार्वभौमत्वाचे प्रतिपादन करतो"]},{"type":"verse","number":1,"content":["नंतर ईयोबाने उत्तर दिले आणि म्हणाला,"]},{"type":"verse","number":2,"content":[{"text":"“बलहिन असलेल्यास तू कसे साहाय्य केले,","poem":1},{"lineBreak":true},{"text":"शक्ती नसलेल्या बाहूंना तू कसे सोडविले.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"बुध्दीनसलेल्यास तू कसा सल्ला दिलास,","poem":1},{"lineBreak":true},{"text":"आणि तू त्यास केवढे ज्ञान कळविले.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तू कोणाच्या साह्यायाने हे शब्द बोललास?","poem":1},{"lineBreak":true},{"text":"तुझ्यातुन कोणाचे मन प्रगट झाले.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"बिल्ददने उत्तर दिले, मृत झालेल्याची प्रेते जलनिधीच्या खाली निर्जनस्थळी थरथरा कापत आहेत.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"देवापुढे अधोलोक नग्न आहे,","poem":1},{"lineBreak":true},{"text":"त्याच्यापुढे विनाशस्थान स्वत:ला झाकून घेवू शकत नाही.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"त्याने उत्तरेकडील नभोमंडळ शुन्य आकाशावर पसरवले आहे,","poem":1},{"lineBreak":true},{"text":"आणि त्याने पृथ्वी निराधार टांगली आहे.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"तिच्या गडद मेघात तो पाणी बांधून ठेवतो,","poem":1},{"lineBreak":true},{"text":"तरी त्याच्या ओझ्याने मेघ फाटत नाही.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"तो चंद्राचा चेहरा झाकतो","poem":1},{"lineBreak":true},{"text":"आणि त्यावर आपले मेघ पसरवितो.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"त्याने पाण्याच्या पृष्ठभागावर एक वर्तुळाकार सीमा कोरली","poem":1},{"lineBreak":true},{"text":"आणि प्रकाश व अंधकार यांच्यामध्ये क्षितीजरेखा आखली.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"त्याच्या धमकीने आकाशस्तंभ थरथरतात","poem":1},{"lineBreak":true},{"text":"आणि भयचकीत होतात.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"तो आपल्या सामर्थ्याने समुद्र स्थिर करतो,","poem":1},{"lineBreak":true},{"text":"तो आपल्या ज्ञानबलाने राहाबाला छिन्नभिन्न करतो.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"त्याचा नि:श्वास आकाशातील वादळ स्वच्छ करतो","poem":1},{"lineBreak":true},{"text":"त्याच्या हातांनी पळून जाणाऱ्या सापाला नष्ट केले.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"पाहा, या त्याच्या मार्गाचा केवळ कडा आहे,","poem":1},{"lineBreak":true},{"text":"किती हळूवार आम्ही त्याचे ऐकतो!","poem":1},{"lineBreak":true},{"text":"परंतू त्याच्या बलाची गर्जना कोण समजू शकेल?”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}