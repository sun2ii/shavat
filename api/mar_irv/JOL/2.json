{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"JOL","translationId":"mar_irv","name":"योएल","commonName":"योएल","title":"योएल","order":29,"numberOfChapters":3,"sha256":"f493bd54ad4c64b8b87e740f4d22c92669ea26e81596e9ad43e36412266d1368","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mar_irv/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"सियोनात कर्णा फुंका,","poem":1},{"lineBreak":true},{"text":"आणि माझ्या पवित्र पर्वतावरून मोठ्याने गजर करा!","poem":1},{"lineBreak":true},{"text":"या देशात राहणाऱ्यांचा भीतीने थरकाप उडू द्या,","poem":1},{"lineBreak":true},{"text":"कारण परमेश्वराचा दिवस येत आहे;","poem":1},{"lineBreak":true},{"text":"खरोखर, तो जवळ आहे.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तो काळोखाचा आणि अंधाराचा प्रकाशाचा,","poem":1},{"lineBreak":true},{"text":"तो ढगाळ व दाट अंधकाराचा दिवस आहे.","poem":1},{"lineBreak":true},{"text":"तो पर्वतावर पसरलेल्या पहाटेसारखा,","poem":1},{"lineBreak":true},{"text":"त्याचे प्रचंड व शक्तीशाली सैन्य जवळ येत आहे.","poem":1},{"lineBreak":true},{"text":"त्यांच्यासारखे सैन्य कधी झाले नाही,","poem":1},{"lineBreak":true},{"text":"आणि त्यानंतरही अनेक पिढ्या,","poem":1},{"lineBreak":true},{"text":"पुन्हा कधीच होणार नाही.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"त्यांच्यासमोर अग्नी प्रत्येक वस्तू नाश करत आहे,","poem":1},{"lineBreak":true},{"text":"आणि त्याच्यामागे ज्वाला जाळीत चालली आहे,","poem":1},{"lineBreak":true},{"text":"त्यांच्यासमोरची भूमी एदेनाच्या बागेसारखी आहे,","poem":1},{"lineBreak":true},{"text":"पण त्यांच्यामागे निर्जन वाळवंट आहे.","poem":1},{"lineBreak":true},{"text":"खरोखर, त्यांच्या तावडीतून काहीही सुटणार नाही.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"सैन्याचे स्वरूप घोड्यांप्रमाणे आहे","poem":1},{"lineBreak":true},{"text":"आणि घोडस्वाराप्रमाणे ते धावतात.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"त्यांच्या उड्या मारण्याचा आवाज, पर्वतावरून जाणाऱ्या रथांसारखा,","poem":1},{"lineBreak":true},{"text":"धसकट जाळणाऱ्या आग्नीसारखा,","poem":1},{"lineBreak":true},{"text":"युध्दासाठी सज्ज झालेल्या बलवानासारखा आहे.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"त्यांच्यापुढे लोक व्यथित होतात","poem":1},{"lineBreak":true},{"text":"आणि त्यांचे चेहेरे पांढरेफटक पडतात.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ते वीरासारखे धावतात,","poem":1},{"lineBreak":true},{"text":"ते सैनिकासारखे तटांवर चढतात,","poem":1},{"lineBreak":true},{"text":"ते प्रत्येक आपल्या मार्गात चालत जातात,","poem":1},{"lineBreak":true},{"text":"आणि आपली रांग तोडीत नाहीत.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ते एकमेकांना रेटीत नाहीत.","poem":1},{"lineBreak":true},{"text":"प्रत्येकजण आपल्या वाटेने जातात.","poem":1},{"lineBreak":true},{"text":"ते संरक्षणातून जातात","poem":1},{"lineBreak":true},{"text":"आणि ते रेषेबाहेर जात नाहीत.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ते नगरातून धावत फिरतात.","poem":1},{"lineBreak":true},{"text":"ते तटावर धावतात.","poem":1},{"lineBreak":true},{"text":"ते चढून घरात शिरतात.","poem":1},{"lineBreak":true},{"text":"चोराप्रमाणे ते खिडक्यांतून आत जातात.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"त्यांच्यापुढे पृथ्वी कापते,","poem":1},{"lineBreak":true},{"text":"आकाश थरथरते,","poem":1},{"lineBreak":true},{"text":"सूर्य आणि चंद्र काळे पडतात","poem":1},{"lineBreak":true},{"text":"आणि तारे तळपण्याचे थांबतात.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"परमेश्वर आपल्या सैन्यापुढे आपला आवाज उंचावतो,","poem":1},{"lineBreak":true},{"text":"त्याचे योद्धे खूप असंख्य आहेत,","poem":1},{"lineBreak":true},{"text":"कारण जो कोणी त्याची आज्ञा आमलात आणतो तो बलशाली आहे.","poem":1},{"lineBreak":true},{"text":"कारण परमेश्वराचा दिवस हा मोठा आणि फार भयंकर आहे.","poem":1},{"lineBreak":true},{"text":"त्यामध्ये कोण टिकू शकेल?","poem":1}]},{"type":"heading","content":["परमेश्वराची दया"]},{"type":"verse","number":12,"content":[{"text":"“तरी आताही” परमेश्वर म्हणतो,","poem":1},{"lineBreak":true},{"text":"“तुम्ही आपल्या सर्व मनापासून माझ्याकडे परत या.","poem":1},{"lineBreak":true},{"text":"रडा, शोक करा आणि उपवास करा.”","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"आणि तुम्ही आपले कपडेच फाडू नका, तर आपले हृदय फाडा","poem":1},{"lineBreak":true},{"text":"आणि परमेश्वर तुमचा देव याकडे वळा,","poem":1},{"lineBreak":true},{"text":"कारण तो कृपाळू व दयाळू आहे,","poem":1},{"lineBreak":true},{"text":"तो रागावण्यास मंद आणि विपुल प्रेम करणारा आहे,","poem":1},{"lineBreak":true},{"text":"आणि त्याने लादलेल्या शिक्षेपासून तो मागे फिरेल.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"परमेश्वर तुमचा देव याला कळवळा येऊन आणि कदाचित तो मागे वळेल,","poem":1},{"lineBreak":true},{"text":"आणि त्याच्यामागे आपल्यासाठी आशीर्वादही ठेवून जाईल की, काय कोण जाणे?","poem":1},{"lineBreak":true},{"text":"त्यास अन्नार्पण व पेयार्पण ही देता येतील?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"सियोनात कर्णा फुंका.","poem":1},{"lineBreak":true},{"text":"एक पवित्र उपास नेमा,","poem":1},{"lineBreak":true},{"text":"आणि पवित्र मंडळीला बोलवा.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"लोकांस एकत्र जमवा,","poem":1},{"lineBreak":true},{"text":"मंडळीला पवित्र करा.","poem":1},{"lineBreak":true},{"text":"वडिलांना एकत्र करा,","poem":1},{"lineBreak":true},{"text":"मुलांना आणि अंगावर दूध पिणाऱ्या अर्भकाना एकत्र जमवा.","poem":1},{"lineBreak":true},{"text":"वर आपल्या खोलीतून","poem":1},{"lineBreak":true},{"text":"आणि वधूही आपल्या मंडपातून बाहेर येवो.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"याजकांना, परमेश्वराच्या सेवकांना,","poem":1},{"lineBreak":true},{"text":"द्वारमंडप व वेदी यांच्यामध्ये रडू द्या.","poem":1},{"lineBreak":true},{"text":"त्यांनी म्हणावे, परमेश्वरा, आपल्या लोकांवर दया कर.","poem":1},{"lineBreak":true},{"text":"आणि आपल्या वतनाची अप्रतिष्ठा होऊ देऊ नकोस.","poem":1},{"lineBreak":true},{"text":"म्हणून राष्ट्रांनी त्यांच्यावर अधिकार करावा.","poem":1},{"lineBreak":true},{"text":"राष्ट्रांनी आपसात असे कां म्हणावे त्यांचा देव कोठे आहे?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"मग, तेव्हा परमेश्वराने देशासाठी, ईर्ष्या धरली,","poem":1},{"lineBreak":true},{"text":"आणि त्याने आपल्या लोकांवर दया केली.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"परमेश्वराने आपल्या लोकांस उत्तर देऊन म्हटले,","poem":1},{"lineBreak":true},{"text":"“पाहा, मी तुमच्याकडे धान्य, नवा द्राक्षरस आणि तेल पाठवीन.","poem":1},{"lineBreak":true},{"text":"तुम्ही त्यांनी तृप्त व्हाल,","poem":1},{"lineBreak":true},{"text":"आणि ह्यापुढे, राष्ट्रात तुमची निंदा मी होऊ देणार नाही.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"मी उत्तरेकडून हल्ला करणाऱ्यांना तुम्हापासून दूर करीन,","poem":1},{"lineBreak":true},{"text":"आणि मी त्यांना रूक्ष आणि ओसाड देशात घालवून देईन.","poem":1},{"lineBreak":true},{"text":"त्यांची आघाडी पूर्व समुद्रात","poem":1},{"lineBreak":true},{"text":"आणि त्यांची पिछाडी पश्चिम समुद्रात जाईल.","poem":1},{"lineBreak":true},{"text":"त्यांचा दुर्गध चढेल.","poem":1},{"lineBreak":true},{"text":"आणि तेथे वाईट दुर्गंधी पसरेल.","poem":1},{"lineBreak":true},{"text":"मी महान गोष्टी करीन.”","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"हे भूमी, घाबरू नकोस. आनंद कर आणि उल्हसित हो,","poem":1},{"lineBreak":true},{"text":"कारण परमेश्वराने महान गोष्टी केल्या आहेत.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"रानातल्या प्राण्यांनो, घाबरू नका.","poem":1},{"lineBreak":true},{"text":"कारण रानातील कुरणांत हिरवळ उगवेल,","poem":1},{"lineBreak":true},{"text":"झाडे त्यांचे फळे देतील,","poem":1},{"lineBreak":true},{"text":"आणि अंजिराची झाडे व द्राक्षवेली आपले पूर्ण पीक देतील.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"म्हणून सियोनवासीयांनो, आनंदीत व्हा.","poem":1},{"lineBreak":true},{"text":"आणि परमेश्वर तुमच्या देवामध्ये उल्हासित व्हा.","poem":1},{"lineBreak":true},{"text":"कारण तुम्हास हितकर होईल इतका आगोटीचा पाऊस तो देतो,","poem":1},{"lineBreak":true},{"text":"तो पहिली पर्जन्यवृष्टी योग्य प्रमाणाने देतो,","poem":1},{"lineBreak":true},{"text":"आगोटीचा व वळवाचा पाऊस पाडतो.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"खळी गव्हाने भरून जातील,","poem":1},{"lineBreak":true},{"text":"आणि पिंपे द्राक्षरसाने व जैतूनाच्या तेलाने भरून वाहतील.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"मी, माझे सैन्य तुमच्याविरुध्द पाठवले.","poem":1},{"lineBreak":true},{"text":"तुमचे जे काही होते ते, नाकतोडे, टोळ, कुसरूड व घुले यांनी खाल्ले.","poem":1},{"lineBreak":true},{"text":"मी, तुमच्या संकटाच्या वर्षाची भरपाई करीन.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"मग तुम्हास भरपूर खायला मिळेल. तुम्ही तृप्त व्हाल.","poem":1},{"lineBreak":true},{"text":"आणि तुम्ही, तुमच्या परमेश्वर देवाची, स्तुती कराल.","poem":1},{"lineBreak":true},{"text":"त्याने तुमच्यासाठी आश्चर्यकारक गोष्टी केल्या आहेत.","poem":1},{"lineBreak":true},{"text":"माझ्या लोकांस पुन्हा कधीही लज्जित व्हावे लागणार नाही.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"मी इस्राएलाच्या बाजूने आहे हे तुम्हास समजेल.","poem":1},{"lineBreak":true},{"text":"आणि मी परमेश्वर म्हणजे तुमचा देव आहे,","poem":1},{"lineBreak":true},{"text":"आणि दुसरा कोणीच नाही.","poem":1},{"lineBreak":true},{"text":"माझ्या लोकांस पुन्हा कधीही लज्जित व्हावे लागणार नाही.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"ह्यानंतर मी माझा आत्मा सर्व देहावर ओतीन,","poem":1},{"lineBreak":true},{"text":"आणि तुमची मुले आणि तुमच्या मुली भविष्य सांगतील.","poem":1},{"lineBreak":true},{"text":"तुमच्यातील वृद्धांना स्वप्न पडतील.","poem":1},{"lineBreak":true},{"text":"तुमच्यातील तरूणांना दृष्टांत होतील.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"आणि त्या दिवसात मी माझा आत्मा","poem":1},{"lineBreak":true},{"text":"दासांवर व स्त्री दासीवरसुद्धा ओतीन.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"मी आकाशात आणि पृथ्वीवर आश्चर्यकारक चिन्हे","poem":1},{"lineBreak":true},{"text":"आणि तेथे रक्त, अग्नी व दाट धुराचे खांब दाखवीन.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"परमेश्वराचा महान आणि भयंकर दिवस उगवण्यापूर्वी","poem":1},{"lineBreak":true},{"text":"सूर्य बदलून अंधकारमय","poem":1},{"lineBreak":true},{"text":"आणि चंद्र रक्तमय असा होईल.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"जसे परमेश्वराने म्हटले,","poem":1},{"lineBreak":true},{"text":"जो कोणी परमेश्वराच्या नावाने हाक मारील तो प्रत्येकजण वाचेल.","poem":1},{"lineBreak":true},{"text":"जे कोणी बचावतील ते सियोन पर्वतावर व यरूशलेमेत राहतील,","poem":1},{"lineBreak":true},{"text":"आणि ज्यांना परमेश्वर बोलावतो,","poem":1},{"lineBreak":true},{"text":"ते बाकी वाचलेल्यात राहतील.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}