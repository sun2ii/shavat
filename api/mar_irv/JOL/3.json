{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"JOL","translationId":"mar_irv","name":"योएल","commonName":"योएल","title":"योएल","order":29,"numberOfChapters":3,"sha256":"f493bd54ad4c64b8b87e740f4d22c92669ea26e81596e9ad43e36412266d1368","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mar_irv/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["परमेश्वराने केलेला राष्ट्रांचा न्याय"]},{"type":"verse","number":1,"content":[{"text":"पाहा, त्यादिवसामध्ये आणि त्यावेळी,","poem":1},{"lineBreak":true},{"text":"जेव्हा मी यहूदाचे व यरूशलेमेचे बंदीवान परत आणीन,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मी, सर्व राष्ट्रांना गोळा करून,","poem":1},{"lineBreak":true},{"text":"खाली यहोशाफाटाच्या दरीत आणीन.","poem":1},{"lineBreak":true},{"text":"कारण माझ्या लोकांकरता आणि माझे वतन इस्राएल","poem":1},{"lineBreak":true},{"text":"ज्यांना त्यांनी इतर राष्ट्रात पांगविले.","poem":1},{"lineBreak":true},{"text":"आणि त्या राष्ट्रांनी माझा देश वाटून घेतला.","poem":1},{"lineBreak":true},{"text":"तेथे मी त्यांचा न्यायनिवाडा करीन.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"त्यांनी माझ्या लोकांकरता चिठ्ठ्या टाकल्या.","poem":1},{"lineBreak":true},{"text":"त्यांनी मुलगा देऊन वेश्या घेतली","poem":1},{"lineBreak":true},{"text":"आणि मद्यासाठी म्हणून मुलगी विकली.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"सोर, सीदोन व पलिष्टीच्या सर्व प्रांतानो, आता तुम्ही माझ्यावर का रागावता?","poem":1},{"lineBreak":true},{"text":"तुम्ही माझी परत फेड कराल का?","poem":1},{"lineBreak":true},{"text":"जरी तुम्ही माझी परत फेड केली तरी,","poem":1},{"lineBreak":true},{"text":"मी त्वरेने तुमचा सूड तुमच्याच मस्तकावर फिरवीन.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"तुम्ही माझे चांदी आणि सोने घेतले आहे,","poem":1},{"lineBreak":true},{"text":"आणि तुम्ही माझा अमूल्य खजिना आपल्या मंदिरात नेला आहे.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"तुम्ही यहूदाच्या व यरूशलेमेच्या लोकांस","poem":1},{"lineBreak":true},{"text":"त्यांच्या देशातून सीमेपासून दूर न्यावे म्हणून यावान लोकांस विकले.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"पाहा, तुम्ही त्यांना ज्या जागी विकले त्यातून मी त्यांना सोडून आणीन,","poem":1},{"lineBreak":true},{"text":"आणि तुमच्या मस्तकावर त्याचे प्रतिफळ फिरवीन.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"मी तुमच्या मुलांना आणि मुलींना","poem":1},{"lineBreak":true},{"text":"यहूदी लोकांच्या हाती विकीन.","poem":1},{"lineBreak":true},{"text":"मग ते त्यांना शबाच्या लोकांस","poem":1},{"lineBreak":true},{"text":"दूरच्या राष्ट्रांस विकतील.","poem":1},{"lineBreak":true},{"text":"कारण परमेश्वर हे बोलला आहे.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"राष्ट्रांमध्ये ही घोषणा कराः","poem":1},{"lineBreak":true},{"text":"युध्दाला सज्ज व्हा,","poem":1},{"lineBreak":true},{"text":"बलवान मनुष्यांना उठवा,","poem":1},{"lineBreak":true},{"text":"त्यांना जवळ येऊ द्या,","poem":1},{"lineBreak":true},{"text":"सर्व लढवय्ये मनुष्ये पुढे येवोत.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"तुमचे फाळ मोडून त्यांच्या तलवारी करा.","poem":1},{"lineBreak":true},{"text":"आणि कोयत्यांपासून भाले करा.","poem":1},{"lineBreak":true},{"text":"दुर्बल म्हणो की,","poem":1},{"lineBreak":true},{"text":"मी बलवान आहे.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"तुमच्या जवळच्या सर्व राष्ट्रांनो,","poem":1},{"lineBreak":true},{"text":"त्वरा करा व या! तुम्ही स्वतः एकत्र या.","poem":1},{"lineBreak":true},{"text":"हे परमेश्वरा,","poem":1},{"lineBreak":true},{"text":"तुझे बलवान योध्दे उतरून येतील असे कर.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"राष्ट्रे स्वतःउठून जागी होवोत,","poem":1},{"lineBreak":true},{"text":"आणि यहोशाफाटाच्या दरीत येवोत.","poem":1},{"lineBreak":true},{"text":"तेथे मी सभोवतालच्या","poem":1},{"lineBreak":true},{"text":"सर्व राष्ट्रांचा न्याय करायला बसेन.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"विळा आणा,","poem":1},{"lineBreak":true},{"text":"कारण पीक तयार झाले आहे.","poem":1},{"lineBreak":true},{"text":"म्हणून तुम्ही विळा घाला,","poem":1},{"lineBreak":true},{"text":"या, द्राक्षे तुडवा,","poem":1},{"lineBreak":true},{"text":"कारण त्यांचे द्राक्षकुंड भरून गेले आहे.","poem":1},{"lineBreak":true},{"text":"पिंप भरून वाहत आहेत.","poem":1},{"lineBreak":true},{"text":"कारण त्यांची दुष्टाई मोठी आहे.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"तेथे गलबला आहे, न्यायाच्या दरीत गलबला आहे.","poem":1},{"lineBreak":true},{"text":"कारण न्यायाच्या दरीत परमेश्वराचा दिवस जवळ आला आहे.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"चंद्र आणि सूर्य काळवंडतील,","poem":1},{"lineBreak":true},{"text":"तारे त्यांचा प्रकाश देण्याचे थांबतील.","poem":1}]},{"type":"heading","content":["यहूदाची सुटका"]},{"type":"verse","number":16,"content":[{"text":"परमेश्वर देव सियोनेतून गर्जना करील,","poem":1},{"lineBreak":true},{"text":"आणि आपला आवाज यरूशलेमेतून उंचावील.","poem":1},{"lineBreak":true},{"text":"आकाश व पृथ्वी कापतील","poem":1},{"lineBreak":true},{"text":"पण परमेश्वर आपल्या लोकांस सुरक्षित स्थान,","poem":1},{"lineBreak":true},{"text":"आणि इस्राएलाच्या लोकांस तो दुर्ग होईल.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"मग तुम्हास कळेल की मीच तुमचा देव परमेश्वर आहे.","poem":1},{"lineBreak":true},{"text":"माझ्या पवित्र पर्वतावर, म्हणजे सियोनात मी राहतो.","poem":1},{"lineBreak":true},{"text":"तेव्हा यरूशलेम पवित्र होईल.","poem":1},{"lineBreak":true},{"text":"आणि त्या नगरीतून पुन्हा कधीही परके येणार जाणार नाहीत.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"त्यादिवशी, असे होईल की, पर्वतावरून गोड द्राक्षरस पाझरेल,","poem":1},{"lineBreak":true},{"text":"टेकड्यांवरून दूध वाहील,","poem":1},{"lineBreak":true},{"text":"यहूदाच्या सर्व कोरडे पडलेल्या ओढ्यामधून पाणी वाहील,","poem":1},{"lineBreak":true},{"text":"आणि परमेश्वराच्या मंदिरातून कारंजे उडतील","poem":1},{"lineBreak":true},{"text":"आणि शिट्टीमाच्या दरीला पाणी पुरवतील.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"मिसराची नासाडी होऊन तो उजाड होईल,","poem":1},{"lineBreak":true},{"text":"कारण त्यांनी यहूदी लोकांवर जुलूम केला","poem":1},{"lineBreak":true},{"text":"अदोम ओसाड रान होईल,","poem":1},{"lineBreak":true},{"text":"कारण त्यांनी त्यांच्या देशातील निष्पाप लोकांचे रक्त पाडले.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"परंतु, यहूदा सर्वकाळ वसेल,","poem":1},{"lineBreak":true},{"text":"आणि यरूशलेम पिढ्यानपिढ्या राहील.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"मी त्यांच्या रक्ताचा सूड अजून घेतला नाही तो सूड मी घेईन.","poem":1},{"lineBreak":true},{"text":"कारण परमेश्वर सियोनात वस्ती करतो.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}