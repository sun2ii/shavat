{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"JON","translationId":"mar_irv","name":"योना","commonName":"योना","title":"योना","order":32,"numberOfChapters":4,"sha256":"2dccabc5206d483436d849fb0b2e1f6c54fc5a7336090301b7332ddc1438ce1f","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/mar_irv/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["ययोनाची उपकारस्तुतीची प्रार्थना"]},{"type":"verse","number":1,"content":["नंतर माशाच्या पोटातून योनाने आपला देव परमेश्वर याची प्रार्थना केली"]},{"type":"verse","number":2,"content":["तो म्हणाला,",{"text":"“मी आपल्या आपत्तीमध्ये परमेश्वरास हाक मारली,","poem":1},{"lineBreak":true},{"text":"आणि त्याने मला उत्तर दिले;","poem":1},{"lineBreak":true},{"text":"मी मृत्यूलोकाच्या पोटातून मदतीकरता हाक मारली!","poem":1},{"lineBreak":true},{"text":"तू माझा आवाज ऐकलास.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तू मला समुद्रांच्या मध्यभागी खोल टाकले,","poem":1},{"lineBreak":true},{"text":"आणि प्रवाहाने मला वेढले,","poem":1},{"lineBreak":true},{"text":"तुझ्या सर्व उसळत्या लाटांचा कल्लोळ","poem":1},{"lineBreak":true},{"text":"माझ्यावरून गेला.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"आणि मी म्हणालो, ‘मी तुझ्या दृष्टीसमोरून टाकलेला आहे;","poem":1},{"lineBreak":true},{"text":"तरी तुझ्या पवित्र मंदिराकडे मी पुन्हा डोळे लावीन?’","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"जलांनी प्राण जाईपर्यंत मला झाकले;","poem":1},{"lineBreak":true},{"text":"आणि डोहाने सर्वबाजूनी मला घेरले,","poem":1},{"lineBreak":true},{"text":"समुद्रातील शेवाळाने माझ्या डोक्याला लपेटले.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मी पर्वतांच्या तळापर्यंत गेलो;","poem":1},{"lineBreak":true},{"text":"पृथ्वीच्या अडसरांनी मला कायमचे कोंडून टाकले;","poem":1},{"lineBreak":true},{"text":"तथापि माझ्या देवा परमेश्वरा, तू माझा जीव खड्डयातून वरती काढला आहे.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"जेव्हा माझा जीव माझ्या ठायी व्याकुळ झाला; तेव्हा मी परमेश्वराचे स्मरण केले,","poem":1},{"lineBreak":true},{"text":"आणि माझी प्रार्थना तुझ्या पवित्र मंदिरात पोहंचली.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"जे निरर्थक मूर्तींकडे आपले चित्त लावतात,","poem":1},{"lineBreak":true},{"text":"ते स्वतः आपल्या दयानिधीला नाकारतात.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"परंतु मी आभार मानण्याच्या वाणीने तुझ्याकडे यज्ञ अर्पण करीन;","poem":1},{"lineBreak":true},{"text":"जो नवस मी केला आहे तो मी पूर्ण करीन,","poem":1},{"lineBreak":true},{"text":"तारण परमेश्वराकडूनच आहे.”","poem":1}]},{"type":"verse","number":10,"content":["मग परमेश्वराने त्या मोठ्या माश्याला आज्ञा केली; तेव्हा त्याने योनाला कोरडया भूमीवर ओकून टाकले."]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}