{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"heading","content":["नीतिमान व अनीतिमान"]},{"type":"verse","number":1,"content":["आशीर्वादित आहे तो मनुष्य, जो दुष्टांच्या सल्ल्याने चालत नाही,",{"text":"किंवा पापी जनांच्या मार्गात उभा राहत नाही,","poem":1},{"lineBreak":true},{"text":"आणि थट्टा करणाऱ्यांच्या सभेत बसत नाही.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"परंतु परमेश्वराच्या शास्त्रात तो आनंद मानतो,","poem":1},{"lineBreak":true},{"text":"आणि त्याच्या नियमशास्त्रावर तो रात्र व दिवस ध्यान लावतो.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तो पाण्याच्या प्रवाहाजवळ लावलेल्या,","poem":1},{"lineBreak":true},{"text":"आपल्या ऋतुत फळ देणाऱ्या,","poem":1},{"lineBreak":true},{"text":"ज्याची पाने कधी कोमेजत नाहीत,","poem":1},{"lineBreak":true},{"text":"अशा झाडासारखा होईल व तो जे काही करेल ते साध्य होईल.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"परंतु दुष्ट लोक असे नसतात, ते वाऱ्याने उडून जाणाऱ्या भुशासारखे असतात.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"म्हणून दुष्ट लोक न्यायात व पापी न्यायींच्या सभेत उभे राहावयाचे नाहीत.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"कारण परमेश्वर न्यायींच्या मार्गाला मंजूरी देतो.","poem":1},{"lineBreak":true},{"text":"परंतु दुष्टांचा मार्ग नष्ट होईल.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}