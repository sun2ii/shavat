{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":100,"content":[{"type":"heading","content":["उपकारस्तुती करण्याचा आदेश"]},{"type":"verse","number":1,"content":[{"text":"हे सर्व पृथ्वी, परमेश्वरासाठी हर्षनाद करा.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"परमेश्वराची सेवा आनंदाने करा.","poem":1},{"lineBreak":true},{"text":"त्याच्या सान्निध्यात आनंदाने गाणी गात या.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"परमेश्वर हाच देव आहे हे जाणून घ्या.","poem":1},{"lineBreak":true},{"text":"त्यानेच आम्हास निर्माण केले, आणि आम्ही त्याचे आहोत.","poem":1},{"lineBreak":true},{"text":"आपण त्याचे लोक आणि त्याच्या कुरणातील त्याचे मेंढरे आहोत.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"त्याची उपकारस्तुती करत त्याच्या द्वारात,","poem":1},{"lineBreak":true},{"text":"आणि स्तवन करीत त्याच्या अंगणात प्रवेश करा.","poem":1},{"lineBreak":true},{"text":"त्याचे उपकारस्मरण करा आणि त्याच्या नावाला धन्यवाद द्या.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"कारण परमेश्वर चांगला आहे; त्याची दया सर्वकाळ आहे,","poem":1},{"lineBreak":true},{"text":"आणि त्याची सत्यता पिढ्यानपिढ्या टिकणारी आहे.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}