{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"heading","content":["नीतीने वागण्याची प्रतिज्ञा"]},{"type":"hebrew_subtitle","content":["दाविदाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"मी प्रेम आणि न्यायाचे गीत गाईन;","poem":1},{"lineBreak":true},{"text":"हे परमेश्वरा, मी स्तुती गाईन;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मी सुज्ञतेच्या मार्गाने चालेन.","poem":1},{"lineBreak":true},{"text":"अहा, तू माझ्याकडे कधी येशील?","poem":1},{"lineBreak":true},{"text":"मी माझ्या घरात सचोटीने चालेन.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"मी आपल्या डोळ्यासमोर अनुचित गोष्ट ठेवणार नाही;","poem":1},{"lineBreak":true},{"text":"अनाचाराचा मी द्वेष करतो;","poem":1},{"lineBreak":true},{"text":"तो मला बिलगणार नाही.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"हेकेखोर लोक मला सोडतील;","poem":1},{"lineBreak":true},{"text":"मी वाईटाशी निष्ठावान राहणार नाही.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"आपल्या शेजाऱ्याची गुप्तपणे निंदानालस्ती करणाऱ्याचा मी नाश करीन.","poem":1},{"lineBreak":true},{"text":"जो कोणी गर्विष्ठ चालीरीतीचा आणि उर्मट वागणूकीचा आहे त्याचे मी सहन करणार नाही.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"देशातले विश्वासू यांनी माझ्याजवळ बसावे म्हणून माझी नजर त्यांच्यावर राहील;","poem":1},{"lineBreak":true},{"text":"जो सचोटीच्या मार्गाने चालतो तोच माझा सेवक होईल.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"कपट करणारे लोक माझ्या घरात राहणार नाहीत;","poem":1},{"lineBreak":true},{"text":"लबाडाचे माझ्या डोळ्यापुढे स्वागत होणार नाही.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"देशातल्या सर्व वाईटांचा मी रोज सकाळी नाश करत जाईन;","poem":1},{"lineBreak":true},{"text":"वाईट करणाऱ्या सर्वांना मी परमेश्वराच्या नगरातून काढून टाकेन.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}