{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":105,"content":[{"type":"heading","content":["इस्त्राएलासाठी देवाने केलेला चमत्कार"]},{"type":"verse","number":1,"content":[{"text":"परमेश्वरास धन्यावाद द्या. त्याच्या नावाचा धावा करा.","poem":1},{"lineBreak":true},{"text":"राष्ट्रांमध्ये त्याच्या कृत्यांची माहिती करून द्या.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"त्यास गाणे गा, त्याची स्तुतीगीते गा;","poem":1},{"lineBreak":true},{"text":"त्याच्या सर्व आश्चर्यकारक कृत्यांविषयी बोला;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"त्याच्या पवित्र नावाचा अभिमान बाळगा.","poem":1},{"lineBreak":true},{"text":"जे परमेश्वरास शोधतात त्यांचे हृदय आनंदित होवो.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"परमेश्वर आणि त्याचे सामर्थ्य याचा शोध घ्या.","poem":1},{"lineBreak":true},{"text":"त्याच्या सान्निध्याचा सतत शोध घ्या.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"त्याने केलेल्या आश्चर्यकारक गोष्टी,","poem":1},{"lineBreak":true},{"text":"त्याचे चमत्कार, आणि त्याच्या तोंडचे निर्णय आठवा.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"तुम्ही त्याचा सेवक अब्राहाम याचे वंशजहो,","poem":1},{"lineBreak":true},{"text":"तुम्ही त्याचे निवडलेले याकोबाचे लोकहो,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तो परमेश्वर आपला देव आहे.","poem":1},{"lineBreak":true},{"text":"त्याचे सर्व निर्णय पृथ्वीवर आहेत.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"तो आपला करार म्हणजे","poem":1},{"lineBreak":true},{"text":"हजारो पिढ्यांसाठी आज्ञापिलेले आपले वचन सर्वकाळ आठवतो.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"त्याने हा करार अब्राहामाबरोबर केला.","poem":1},{"lineBreak":true},{"text":"आणि त्याने इसहाकाशी शपथ वाहिली याची आठवण केली.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ही त्याने याकोबासाठी नियम,","poem":1},{"lineBreak":true},{"text":"आणि इस्राएलासाठी सर्वकाळासाठी करार असा कायम केला.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"तो म्हणाला, “मी तुला कनान देश","poem":1},{"lineBreak":true},{"text":"तुझा वतनभाग असा म्हणून देईन.”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"हे तो त्यांना म्हणाला तेव्हा ते संख्येने केवळ थोडके होते,","poem":1},{"lineBreak":true},{"text":"होय फार थोडे, आणि देशात परके होते.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ते एका राष्ट्रातून दुसऱ्या राष्ट्रात,","poem":1},{"lineBreak":true},{"text":"आणि एका राज्यातून दुसऱ्यात गेले.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"त्याने कोणालाही त्यांच्यावर जुलूम करू दिला नाही;","poem":1},{"lineBreak":true},{"text":"त्यांच्यासाठी त्याने राजाला शिक्षा दिली.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"तो म्हणाला, माझ्या अभिषिक्ताला स्पर्श करू नका,","poem":1},{"lineBreak":true},{"text":"आणि माझ्या संदेष्ट्यांची हानी करू नका.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"त्याने त्या देशात दुष्काळ आणला.","poem":1},{"lineBreak":true},{"text":"त्याने त्यांचा भाकरीचा पुरवठा तोडून टाकला.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"त्याने त्यांच्यापुढे एक मनुष्य पाठवला;","poem":1},{"lineBreak":true},{"text":"योसेफ गुलाम म्हणून विकला गेला.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"त्यांचे पाय बेड्यांनी बांधले होते;","poem":1},{"lineBreak":true},{"text":"त्यास लोखंडी साखळ्या घातल्या होत्या.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"त्याचे भाकीत खरे होण्याच्या वेळेपर्यंत,","poem":1},{"lineBreak":true},{"text":"परमेश्वराच्या वचनाने त्यास योग्य असे सिद्ध केले.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"तेव्हा राजाने माणसे पाठविली आणि त्यांना सोडवीले;","poem":1},{"lineBreak":true},{"text":"लोकांच्या अधिपतीने त्यांना सोडून दिले.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"त्याने त्यास आपल्या घराचा मुख्य,","poem":1},{"lineBreak":true},{"text":"आपल्या सर्व मालमत्तेवर अधिकारी नेमले,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"अशासाठी की, त्याने आपल्या अधिपतींना नियंत्रणात ठेवावे,","poem":1},{"lineBreak":true},{"text":"आणि आपल्या वडिलांस ज्ञान शिकवावे.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"नंतर इस्राएल मिसरात आले,","poem":1},{"lineBreak":true},{"text":"आणि याकोब हामाच्या देशात उपरी म्हणून राहिला.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"देवाने आपले लोक फारच वाढवले,","poem":1},{"lineBreak":true},{"text":"आणि त्यांच्या शत्रूंपेक्षा त्यांना अधिक असंख्य केले.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"आपल्या लोकांचा त्यांनी द्वेष करावा,","poem":1},{"lineBreak":true},{"text":"आपल्या सेवकांशी निष्ठूरतेने वागावे म्हणून त्याने शत्रूचे मन वळवले.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"त्याने आपला सेवक मोशे","poem":1},{"lineBreak":true},{"text":"आणि आपण निवडलेला अहरोन यांना पाठविले.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"त्यांनी मिसरच्या देशात त्यांच्यामध्ये अनेक चिन्हे,","poem":1},{"lineBreak":true},{"text":"हामाच्या देशात त्याचे आश्चर्ये करून दाखवली.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"त्याने त्या देशात काळोख केला,","poem":1},{"lineBreak":true},{"text":"पण त्या लोकांनी त्याच्या आदेशाचे उल्लंघन केले नाही.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"त्याने त्यांचे पाणी पालटून रक्त केले","poem":1},{"lineBreak":true},{"text":"आणि त्यांचे मासे मरण पावले.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"त्यांचा देश बेडकांनी भरून गेला,","poem":1},{"lineBreak":true},{"text":"त्यांच्या अधिपतींच्या खोलीत देखील बेडूक होते.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"तो बोलला, आणि गोमाशा व उवा","poem":1},{"lineBreak":true},{"text":"त्यांच्या सर्व प्रदेशात झाल्या.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"त्याने त्यांच्या देशात विजा आणि मेघांचा गडगडाटाने","poem":1},{"lineBreak":true},{"text":"गारांचा वर्षाव व पाऊस पाठवला.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"त्याने त्यांच्या द्राक्षांच्या वेली व अंजीराची झाडे यांचा नाश केला.","poem":1},{"lineBreak":true},{"text":"त्याने त्यांच्या देशातले झाडे मोडून टाकली.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"तो बोलला आणि टोळ आले.","poem":1},{"lineBreak":true},{"text":"असंख्य नाकतोडे आले.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"टोळांनी त्यांच्या देशातली सर्व हिरवळ,","poem":1},{"lineBreak":true},{"text":"त्यांच्या भूमीचे सर्व पिके खाल्ले;","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"त्याने त्यांच्या देशातले प्रत्येक प्रथम जन्मलेले,","poem":1},{"lineBreak":true},{"text":"त्यांच्या सामर्थ्याचे सर्व प्रथमफळ ठार मारले.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"त्याने इस्राएलांना सोने आणि रुपे घेऊन बाहेर आणले;","poem":1},{"lineBreak":true},{"text":"त्यांच्या मार्गात कोणताही वंश अडखळला नाही.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"ते निघून गेल्याने मिसराला आनंद झाला,","poem":1},{"lineBreak":true},{"text":"कारण मिसऱ्यांना त्यांची भिती वाटत होती.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"त्याने आच्छादनासाठी ढग पसरला,","poem":1},{"lineBreak":true},{"text":"आणि रात्री प्रकाश देण्यासाठी अग्नी दिला.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"इस्राएलांनी अन्नाची मागणी केली आणि त्याने लावे पक्षी आणले,","poem":1},{"lineBreak":true},{"text":"आणि त्यांना स्वर्गातून भाकर देऊन तृप्त केले.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"त्याने खडक दुभागला आणि त्यातून पाणी उसळून बाहेर आले;","poem":1},{"lineBreak":true},{"text":"ते नदीप्रमाणे वाळवटांत वाहू लागले.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"कारण त्यास आपल्या पवित्र वचनाची,","poem":1},{"lineBreak":true},{"text":"आपला सेवक अब्राहाम ह्याची आठवण होती.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"त्याने आपल्या लोकांस आनंद करीत,","poem":1},{"lineBreak":true},{"text":"त्याच्या निवडलेल्यांना विजयोत्सव करीत बाहेर आणले.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"त्याने त्यांना राष्ट्रांचे देश दिले;","poem":1},{"lineBreak":true},{"text":"त्यांनी लोकांच्या मालमत्ता ताब्यात घेतल्या.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"ह्यासाठी की, त्यांनी आपले नियम","poem":1},{"lineBreak":true},{"text":"आणि आपले नियमशास्त्र पाळावे.","poem":1},{"lineBreak":true},{"text":"परमेश्वराची स्तुती करा.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":45}