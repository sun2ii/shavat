{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"heading","content":["शत्रूंविरुद्ध साहाय्याची याचना"]},{"type":"hebrew_subtitle","content":["दाविदाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"हे देवा, माझे मन स्थिर आहे;","poem":1},{"lineBreak":true},{"text":"मी आदराने माझ्या मनापासून संगिताने गाणे गाईन.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"हे सतार आणि वीणे, तुम्ही जागृत व्हा.","poem":1},{"lineBreak":true},{"text":"मी पहाटेला जागे करीन.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, मी तुला लोकांमध्ये धन्यवाद देईन;","poem":1},{"lineBreak":true},{"text":"मी राष्ट्रांमध्ये तुझी स्तुतीगान गाईन.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"कारण तुझा महान विश्वासाचा करार आकाशाहून उंच आहे;","poem":1},{"lineBreak":true},{"text":"आणि तुझी सत्यता आकाशाला पोहचली आहे.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"हे देवा, तू आकांशाच्यावर उंचावलेला आहे.","poem":1},{"lineBreak":true},{"text":"आणि तुझी महिमा सर्व पृथ्वीवर होवो.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"म्हणून ज्यांना तू प्रेम करतो त्यांनी वाचावे,","poem":1},{"lineBreak":true},{"text":"तुझ्या उजव्या हाताने आम्हास वाचव आणि मला उत्तर दे.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"देव आपल्या पवित्रतेत म्हणाला, “मी उल्लासेन;","poem":1},{"lineBreak":true},{"text":"मी शखेम विभागीन आणि सुक्कोथाचे खोरे मोजून देईन.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"गिलाद माझा आहे आणि मनश्शे माझा आहे.","poem":1},{"lineBreak":true},{"text":"एफ्राईमही माझे शिरस्त्राण आहे.","poem":1},{"lineBreak":true},{"text":"यहूदा माझा राजदंड आहे.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"मवाब माझे स्नानाचे पात्र आहे. अदोमावर मी आपले पादत्राण फेकीन.","poem":1},{"lineBreak":true},{"text":"मी पलिष्टीया विषयी विजयाने आरोळी करीन.”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"तटबंदीच्या नगरात मला कोण घेऊन जाईल?","poem":1},{"lineBreak":true},{"text":"मला अदोमात कोण नेईल?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"हे देवा, तू आम्हास नाकारले नाही का?","poem":1},{"lineBreak":true},{"text":"तू आमच्या सैन्याबरोबर युद्धास गेला नाहीस.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"आमच्या शत्रूविरूद्ध आम्हास मदत दे,","poem":1},{"lineBreak":true},{"text":"कारण मनुष्याची मदत निष्फळ आहे.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"देवाच्या मदतीने आम्ही विजयी होऊ;","poem":1},{"lineBreak":true},{"text":"तो आपल्या शत्रूला पायाखाली तुडवील.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}