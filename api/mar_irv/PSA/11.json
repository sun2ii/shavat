{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"heading","content":["सरळतेने चालणाऱ्याचा आधार"]},{"type":"hebrew_subtitle","content":["मुख्य गायकासाठी; दाविदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"परमेश्वरामध्ये मी आश्रय घेतो;","poem":1},{"lineBreak":true},{"text":"पक्ष्यासारखे डोंगराकडे उडून जा,","poem":1},{"lineBreak":true},{"text":"असे तुम्ही माझ्या जीवाला कसे म्हणता?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"कारण पाहा! सरळ हृदयाच्यांना अंधारात मारावे म्हणून,","poem":1},{"lineBreak":true},{"text":"दुष्ट आपला धनुष्य वाकवतात आणि आपला तीर दोरीला लावून तयार करतात.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"कारण जर पायेच नष्ट केले,","poem":1},{"lineBreak":true},{"text":"तर न्यायी काय करणार?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"परमेश्वर त्याच्या पवित्र स्वर्गात आहे;","poem":1},{"lineBreak":true},{"text":"त्याचे डोळे पाहतात, त्याचे डोळे मनुष्याच्या संतानास पारखतात.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"परमेश्वर नितीमानाची पारख करतो.","poem":1},{"lineBreak":true},{"text":"परंतू जे दुष्ट व हिंसा करतात त्यांचा तो द्वेष करतो.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"तो दुष्टांवर जळते निखारे आणि गंधकाचा वर्षाव करील,","poem":1},{"lineBreak":true},{"text":"दाहक वारा हाच त्यांचा वाटा असेल.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"कारण परमेश्वर नितीमान आहे आणि त्यास न्यायीपण प्रिय आहे.","poem":1},{"lineBreak":true},{"text":"सरळ असलेले त्याचे मुख पाहतील.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}