{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"heading","content":["परमेश्वर आपल्या लोकांची काळजी घेतो"]},{"type":"verse","number":1,"content":[{"text":"परमेश्वराची स्तुती करा.","poem":1},{"lineBreak":true},{"text":"सरळ जनांच्या सभेत आणि मंडळीत मी परमेश्वरास अगदी मनापासून धन्यवाद देईल.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"परमेश्वराचे कार्य महान आहेत,","poem":1},{"lineBreak":true},{"text":"जे सर्व त्याची आवड धरतात ते उत्सुकतेने त्याची प्रतीक्षा करतात.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"त्याचे कार्य ऐश्वर्यशाली आणि वैभवशाली आहे,","poem":1},{"lineBreak":true},{"text":"आणि त्याचे न्यायीपण सर्वकाळ टिकून राहते.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"त्याच्या आश्चर्यकारक गोष्टी आठवणीत राहतील असे त्याने केले;","poem":1},{"lineBreak":true},{"text":"परमेश्वर कृपाळू आणि दयाळू आहे.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"तो आपल्या विश्वास ठेवणाऱ्यांना अन्न देतो.","poem":1},{"lineBreak":true},{"text":"तो आपला करार नेहमी आठवतो.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"त्याने आपल्या लोकांस राष्ट्रांचे वतन देऊन,","poem":1},{"lineBreak":true},{"text":"आपली सामर्थ्याची कार्ये दाखवली आहेत.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"त्याच्या हातचे कार्य सत्य व न्याय्य आहे;","poem":1},{"lineBreak":true},{"text":"त्याचे सर्व विधी विश्वसनीय आहेत.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ते प्रामाणिकपणाने आणि योग्य रीतीने नेमिलेले आहेत,","poem":1},{"lineBreak":true},{"text":"ते सर्वकाळासाठी स्थापिले आहेत.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"त्याने आपल्या लोकांस विजय दिला आहे;","poem":1},{"lineBreak":true},{"text":"त्याने आपला करार सर्वकाळासाठी ठरवला आहे,","poem":1},{"lineBreak":true},{"text":"देवाचे नाव पवित्र व भितीदायक आहे.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"परमेश्वराचे भय शहाणपणाची सुरुवात आहे;","poem":1},{"lineBreak":true},{"text":"जे त्याप्रमाणे वागतात त्यास सुबुद्धी प्राप्त होते.","poem":1},{"lineBreak":true},{"text":"त्याची स्तुती सर्वकाळ टिकून राहील.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}