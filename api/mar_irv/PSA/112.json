{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"heading","content":["परमेश्वराचे भय धरणाऱ्याची भरभराट"]},{"type":"verse","number":1,"content":[{"text":"परमेश्वराची स्तुती करा.","poem":1},{"lineBreak":true},{"text":"जो मनुष्य परमेश्वराच्या आज्ञा पाळतो,","poem":1},{"lineBreak":true},{"text":"जो त्याच्या आज्ञेत मोठा आनंद करतो, तो आशीर्वादित आहे.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"त्याचे वंशज पृथ्वीवर शक्तीमान होतील;","poem":1},{"lineBreak":true},{"text":"धार्मिक आशीर्वादित होतील.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"धन व श्रीमंती त्यांच्या घरात आहेत;","poem":1},{"lineBreak":true},{"text":"त्यांचे नितीमत्व सर्वकाळ टिकते.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"धार्मिक मनुष्यांसाठी अंधकारात प्रकाश चमकवतो;","poem":1},{"lineBreak":true},{"text":"तो दयाळू, कृपाळू आणि न्यायी आहे.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"जो मनुष्य दया करतो आणि उसने देतो,","poem":1},{"lineBreak":true},{"text":"जो प्रामाणिकपणे वागून आपला व्यापार करतो त्याचे चांगले होते.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"कारण तो मनुष्य कधीही हलणार नाही;","poem":1},{"lineBreak":true},{"text":"नितीमान मनुष्याची आठवण सर्वकाळ राहील.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तो वाईट बातमीला भिणार नाही;","poem":1},{"lineBreak":true},{"text":"त्याचा परमेश्वरावर भरवसा असून त्यास खात्री आहे.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"त्याचे हृदय निश्चल आहे,","poem":1},{"lineBreak":true},{"text":"आपल्या शत्रूवर विजय मिळालेला पाहीपर्यंत तो भिणार नाही.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"तो गरीबांना उदारपणे देतो;","poem":1},{"lineBreak":true},{"text":"त्याचे नितीमत्व सर्वकाळ राहील;","poem":1},{"lineBreak":true},{"text":"तो सन्मानाने उंचविला जाईल.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"दुष्ट माणसे हे पाहतील आणि रागावतील;","poem":1},{"lineBreak":true},{"text":"तो आपले दात खाईल आणि विरघळून जाईल;","poem":1},{"lineBreak":true},{"text":"दुष्टाची इच्छा नाश होईल.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}