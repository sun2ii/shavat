{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"heading","content":["दीनाला उच्च केल्याबद्दल स्तुती"]},{"type":"verse","number":1,"content":[{"text":"परमेश्वराची स्तुती करा. परमेश्वराच्या सेवकांनो तुम्ही त्याची स्तुती करा. परमेश्वराच्या नावाची स्तुती करा.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"आतापासून सदासर्वकाळ परमेश्वरावचे नाव धन्यवादित असो.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"सूर्याच्या उगवतीपासून ते त्याच्या मावळतीपर्यंत, परमेश्वराच्या नावाची स्तुती होवो.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"परमेश्वर सर्व राष्ट्रांच्या वरती उंचावला जावो, आणि त्याचे गौरव आकाशाच्यावरती पोहचो.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"आमचा देव परमेश्वर यासारखे कोण आहे, त्याच्यावर कोणाचे राजासन आहे,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"जो वरून खाली आकाश आणि पृथ्वीकडे पाहतो,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तो गरीबांना धुळीतून वर उचलतो आणि गरजवंताला राखेच्या ढिगाऱ्यातून वर काढतो.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"अशा करता की, ते आपल्या अधिपतीच्या बरोबर, आपल्या अधिपतींच्याबरोबर बसावे.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"अपत्यहीन स्त्रीला घर देऊन, तो मुलांची आनंदी आई करतो. परमेश्वराची स्तुती करा.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}