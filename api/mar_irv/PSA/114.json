{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"heading","content":["आश्चर्यकारक निर्गमन"]},{"type":"verse","number":1,"content":[{"text":"जेव्हा इस्राएल मिसरातून,","poem":1},{"lineBreak":true},{"text":"याकोबाचे घराणे त्या परकी लोकांतून निघाले,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तेव्हा यहूदा त्याचे पवित्रस्थान झाला,","poem":1},{"lineBreak":true},{"text":"इस्राएल त्याचे राज्य झाले.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"समुद्राने पाहिले आणि पळाला;","poem":1},{"lineBreak":true},{"text":"यार्देन मागे हटली.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"पर्वतांनी मेंढ्यांसारख्या,","poem":1},{"lineBreak":true},{"text":"टेकड्यांनी कोकरासारख्या उड्या मारल्या.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"हे समुद्रा, तू का पळून गेलास?","poem":1},{"lineBreak":true},{"text":"यार्देने तू का मागे हटलीस?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"पर्वतांनो, तुम्ही मेंढ्यांसारख्या का उड्या मारता?","poem":1},{"lineBreak":true},{"text":"लहान टेकड्यांनो, तुम्ही कोकरासारख्या का उड्या मारता?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"हे पृथ्वी, तू प्रभूसमोर,","poem":1},{"lineBreak":true},{"text":"याकोबाच्या देवासमोर थरथर काप.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"तो खडक पाण्याच्या तळ्यात,","poem":1},{"lineBreak":true},{"text":"कठीण खडक पाण्याच्या झऱ्यात बदलतो.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}