{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"heading","content":["देव आणि मूर्ती"]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वरा, आमचे नको. आमचे नको,","poem":1},{"lineBreak":true},{"text":"तर आपल्या नावाचा सन्मान कर,","poem":1},{"lineBreak":true},{"text":"कारण तू दयाळू आणि सत्य आहेस.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ह्यांचा देव कोठे आहे,","poem":1},{"lineBreak":true},{"text":"असे राष्ट्रांनी का म्हणावे?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"आमचा देव स्वर्गात आहे;","poem":1},{"lineBreak":true},{"text":"त्यास जे आवडते ते तो करतो.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"राष्ट्रांच्या मूर्ती सोन्याच्या व रुप्याच्या आहेत.","poem":1},{"lineBreak":true},{"text":"त्या मनुष्यांच्या हातचे काम आहेत.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"त्या मूर्त्यांना तोंड आहे, पण बोलता येत नाही;","poem":1},{"lineBreak":true},{"text":"त्यांना डोळे आहेत, पण त्यांना बघता येत नाही.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"त्यांना कान आहेत, पण त्यांना ऐकू येत नाही,","poem":1},{"lineBreak":true},{"text":"त्यांना नाक आहे, पण त्यांना वास घेता येत नाही.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"त्यांना हात आहेत, पण त्यांना स्पर्श करता येत नाही.","poem":1},{"lineBreak":true},{"text":"त्यांना पाय आहेत पण त्या चालू शकत नाही;","poem":1},{"lineBreak":true},{"text":"किंवा त्यांच्या मुखाने त्यांना बोलता येत नाही.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"जे त्यांना बनवितात त्यांच्याप्रमाणेच,","poem":1},{"lineBreak":true},{"text":"त्यांच्यावर भरवसा ठेवणारा प्रत्येकजन आहे.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"हे इस्राएला, परमेश्वरावर विश्वास ठेव.","poem":1},{"lineBreak":true},{"text":"तो त्यांचे सहाय्य आणि ढाल आहे.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"हे अहरोनाच्या घराण्या, परमेश्वरावर विश्वास ठेव;","poem":1},{"lineBreak":true},{"text":"तोच त्याचे सहाय्य आणि ढाल आहे.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"अहो परमेश्वराचा आदर करणाऱ्यांनो, परमेश्वरावर विश्वास ठेवा;","poem":1},{"lineBreak":true},{"text":"तोच त्यांचे सहाय्य आणि ढाल आहे.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"परमेश्वराने आमची दखल घेतली आहे आणि आम्हास आशीर्वाद देईल.","poem":1},{"lineBreak":true},{"text":"तो इस्राएलाच्या कुटुंबाला आशीर्वाद देईल.","poem":1},{"lineBreak":true},{"text":"तो अहरोनाच्या कुटुंबाला आशीर्वाद देईल.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"जे परमेश्वराचा आदर करतात,","poem":1},{"lineBreak":true},{"text":"त्या तरुण आणि वृद्ध या दोघांना तो आशीर्वाद देईल.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"परमेश्वर तुम्हास अधिकाधिक वाढवो,","poem":1},{"lineBreak":true},{"text":"तो तुमची आणि तुमच्या वंशजांची वाढ करो.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"आकाश व पृथ्वी ही निर्माण करणाऱ्या","poem":1},{"lineBreak":true},{"text":"परमेश्वराचा तुम्हास आशीर्वाद असो.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"स्वर्ग तर परमेश्वराचा आहे;","poem":1},{"lineBreak":true},{"text":"पण त्यांने मानवजातीला पृथ्वी दिली आहे.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"मरण पावलेले म्हणजे निवांतस्थानी उतरलेले","poem":1},{"lineBreak":true},{"text":"कोणीहि परमेश्वराची स्तुती करीत नाहीत.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"पण आम्ही आता आणि सदासर्वकाळ","poem":1},{"lineBreak":true},{"text":"परमेश्वरास धन्यवाद देत राहू.","poem":1},{"lineBreak":true},{"text":"परमेश्वराची स्तुती करा.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}