{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"heading","content":["मृत्यूपासून सुटका झाल्याबद्दल उपकारस्तुती"]},{"type":"verse","number":1,"content":[{"text":"मी परमेश्वरावर प्रेम करतो कारण तो","poem":1},{"lineBreak":true},{"text":"माझी वाणी आणि माझ्या विनंत्या दयेसाठी ऐकतो.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"कारण तो माझे ऐकतो,","poem":1},{"lineBreak":true},{"text":"म्हणून मी जिवंत आहे तोपर्यंत मी त्यास हाक मारीन.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"मृत्यूचे दोर माझ्याभोवती आवळले,","poem":1},{"lineBreak":true},{"text":"आणि मला अधोलोकांच्या यातना झाल्या,","poem":1},{"lineBreak":true},{"text":"संकट व क्लेश मला झाले.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"नंतर मी परमेश्वराच्या नावाचा धावा केला,","poem":1},{"lineBreak":true},{"text":"“हे परमेश्वरा, मी तुला विनंती करतो, मला वाचव.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"परमेश्वर कृपाळू आणि न्यायी आहे;","poem":1},{"lineBreak":true},{"text":"आमचा देव कनवाळू आहे.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"परमेश्वर भोळ्यांचे रक्षण करतो;","poem":1},{"lineBreak":true},{"text":"मी दीनावस्थेत होतो तेव्हा त्याने माझे तारण केले.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"हे माझ्या जिवा तू आपल्या विश्रामस्थानी परत ये;","poem":1},{"lineBreak":true},{"text":"कारण परमेश्वराने तुझ्यावर पुष्कळ उपकार केले आहेत.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"तू माझा जीव मृत्यूपासून,","poem":1},{"lineBreak":true},{"text":"माझे डोळे अश्रूपासून,","poem":1},{"lineBreak":true},{"text":"आणि माझे पाय अडखळण्यापासून मुक्त केले आहेत.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"जीवंताच्या भूमित परमेश्वराची","poem":1},{"lineBreak":true},{"text":"सेवा करणे मी चालूच ठेवीन.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"मी फार पीडित आहे","poem":1},{"lineBreak":true},{"text":"असे जेव्हा मी म्हणालो, तरी माझा त्याच्यावर विश्वास आहे.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"मी अविचाराने म्हणालो की,","poem":1},{"lineBreak":true},{"text":"सगळे माणसे खोटारडे आहेत.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"परमेश्वराने माझ्यावर केलेल्या","poem":1},{"lineBreak":true},{"text":"सर्व उपकाराची मी कशी परतफेड करू?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"मी तारणाचा प्याला उंचावून","poem":1},{"lineBreak":true},{"text":"परमेश्वराच्या नावाने हाक मारीन.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"त्याच्या सर्व लोकांसमोर,","poem":1},{"lineBreak":true},{"text":"मी परमेश्वरास केलेले नवस पूर्ण करीन.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"परमेश्वराच्या दृष्टीने","poem":1},{"lineBreak":true},{"text":"त्याच्या भक्तांचा मृत्यू अमोल आहे.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, मी खरोखर तुझा सेवक आहे;","poem":1},{"lineBreak":true},{"text":"मी तुझा सेवक, तुझी दासी असलेल्या स्त्रीचा मुलगा आहे;","poem":1},{"lineBreak":true},{"text":"माझी बंधने तू सोडली आहेस.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"मी तुला उपकाराचा यज्ञ अर्पण करीन","poem":1},{"lineBreak":true},{"text":"आणि मी परमेश्वराचे नामस्मरण करीन.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"मी त्याच्या सर्व लोकांसमोर","poem":1},{"lineBreak":true},{"text":"परमेश्वरास केलेले नवस पूर्ण करीन.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"परमेश्वराच्या घराच्या अंगणात,","poem":1},{"lineBreak":true},{"text":"यरूशलेमा तुझ्यामध्ये ते फेडीन.","poem":1},{"lineBreak":true},{"text":"परमेश्वराची स्तुती करा.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}