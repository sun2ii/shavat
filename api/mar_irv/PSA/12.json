{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"heading","content":["दुष्टाविरुद्ध साहाय्याची याचना"]},{"type":"hebrew_subtitle","content":["मुख्य गायकासाठी; शमीनीथ नावाच्या सुरावर बसवलेले दाविदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वरा, साहाय्य कर! कारण भक्तिमान नाहीसा झाला आहे.","poem":1},{"lineBreak":true},{"text":"विश्वासू गायब झाला आहे.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"प्रत्येक जन आपल्या शेजाऱ्यास पोकळ शब्द बोलतो,","poem":1},{"lineBreak":true},{"text":"प्रत्येक खुशामती करणाऱ्या ओठांनी आणि दुटप्पी हृदयाने बोलतो.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"परमेश्वर सर्व खुशामत करणारे ओठ आणि मोठ्या गोष्टी करणारी जीभ कापून टाको.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"हे ते आहेत जे असे म्हणतात, “आम्ही आपल्या जीभेने विजयी होऊ,","poem":1},{"lineBreak":true},{"text":"जेव्हा आमचे ओठ बोलतील, तेव्हा आमच्यावर धनी कोण होणार?”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"परंतु परमेश्वर म्हणतो, “गरिबांच्या विरोधात हिंसाचार केल्यामुळे, गरजवंतांच्या कण्हण्यामुळे, मी आता उठतो;","poem":1},{"lineBreak":true},{"text":"ज्या सुरक्षीतपणाची तो वाट पाहतो, ते मी त्यास देईन.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"परमेश्वराची वचने शुध्द वचने आहेत,","poem":1},{"lineBreak":true},{"text":"पृथ्वीवर भट्टीत घालून गाळलेल्या, सात वेळा गाळलेल्या चांदी सारखी ती शुद्ध आहेत.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, तुच त्यांना","poem":1},{"noteId":5},{"text":"सांभाळशील,","poem":1},{"lineBreak":true},{"text":"या पिढीपासून तू त्यांना","poem":1},{"noteId":6},{"text":"सर्वकाळ राखशील.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"मनुष्यांच्या संतानांमध्ये निचपणाला थोरवी मिळते तेव्हा दुष्ट चोहोंकडे हिंडत राहतात.","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"आम्हास","reference":{"chapter":12,"verse":7}},{"noteId":6,"caller":"+","text":"आम्हास","reference":{"chapter":12,"verse":7}}]},"thisChapterLink":"/api/mar_irv/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}