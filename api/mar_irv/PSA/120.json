{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"heading","content":["कपटापासून मुक्त होण्यासाठी प्रार्थना"]},{"type":"verse","number":1,"content":[{"text":"माझ्या संकटात मी परमेश्वराकडे मोठ्याने ओरडलो,","poem":1},{"lineBreak":true},{"text":"आणि त्याने मला उत्तर दिले.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, जे कोणी आपल्या ओठाने खोटे बोलतात,","poem":1},{"lineBreak":true},{"text":"आणि आपल्या जिभेने फसवतात त्यापासून माझा जीव सोडीव.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"हे कपटी जिभे, तुला काय दिले जाईल,","poem":1},{"lineBreak":true},{"text":"आणि आणखी तुला काय मिळणार?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तो योद्ध्याच्या धारदार बाणांनी,","poem":1},{"lineBreak":true},{"text":"रतम लाकडाच्या जळत्या निखाऱ्यावर बाणाचे टोक तापवून तुला मारील.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"मला हायहाय! कारण मी तात्पुरता मेशेखात राहतो,","poem":1},{"lineBreak":true},{"text":"मी पूर्वी केदारच्या तंबूमध्ये राहत होतो.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"शांतीचा तिरस्कार करणाऱ्यांबरोबर","poem":1},{"lineBreak":true},{"text":"मी खूप काळ राहिलो आहे.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"मी शांतीप्रिय मनुष्य आहे,","poem":1},{"lineBreak":true},{"text":"पण जेव्हा मी बोलतो, ते युध्दासाठी उठतात.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}