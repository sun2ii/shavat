oem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"कारण तेथे न्यायासने,","poem":1},{"lineBreak":true},{"text":"दावीदाच्या घराण्यासाठी राजासने मांडली आहेत.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"यरूशलेमच्या शांतीसाठी प्रार्थना करा!","poem":1},{"lineBreak":true},{"text":"तुझ्यावर प्रीती करतात त्यांची भरभराट होईल.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तुझ्या कोटात शांती असो,","poem":1},{"lineBreak":true},{"text":"आणि तुझ्या राजवाड्यात उन्नती असो.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"माझे बंधू आणि माझे सहकारी ह्यांच्याकरता,","poem":1},{"lineBreak":true},{"text":"मी आता म्हणेन, तुमच्यामध्ये शांती असो.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"परमेश्वर आमचा देव ह्याच्या घराकरता,","poem":1},{"lineBreak":true},{"text":"मी तुझ्या हितासाठी प्रार्थना करीन.","poem":1}]}],"footnotes":[{"noteId":40,"caller":"+","text":"माझे मित्र","reference":{"chapter":122,"verse":1}}]},"thisChapterLink":"/api/mar_irv/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}