ak":true},{"text":"मग खवळलेल्या जलांनी आम्हास बुडवले असते.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"परमेश्वराचा धन्यवाद होवो,","poem":1},{"lineBreak":true},{"text":"त्याने आम्हास त्याच्या दातांनी फाडू दिले नाही.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"पक्ष्याप्रमाणे पारध्यांच्या पाशातून आमचा जीव मुक्त झाला आहे;","poem":1},{"lineBreak":true},{"text":"पाश तुटून आम्ही मुक्त झालो आहोत.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"पृथ्वी आणि स्वर्ग निर्माण करणारा परमेश्वर","poem":1},{"lineBreak":true},{"text":"त्याच्या नावामुळे आम्हास मदत मिळते.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}