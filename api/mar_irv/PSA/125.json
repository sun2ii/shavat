{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"heading","content":["परमेश्वर आपल्या लोकांसभोवती आहे"]},{"type":"verse","number":1,"content":[{"text":"जे परमेश्वरावर विश्वास ठेवतात;","poem":1},{"lineBreak":true},{"text":"ते सियोन पर्वतासारखे अढळ, सर्वकाळ टिकणारे आहेत.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"यरूशलेमेच्या सभोवती पर्वत आहेत तसा परमेश्वर त्याच्या लोकांसभोवती","poem":1},{"lineBreak":true},{"text":"आता आणि सर्वकाळ आहे.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"नितीमानाचे हात दुष्टांना लागू नयेत म्हणून दुर्जनांचा राजदंड नितीमानांच्या वतनावर चालणार नाही.","poem":1},{"lineBreak":true},{"text":"नाहीतर नितीमान जे काही चुकीचे आहे ते करतील.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, जे चांगले आहेत,","poem":1},{"lineBreak":true},{"text":"आणि जे आपल्या हृदयाने सरळ आहेत त्यांचे तू चांगले कर.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"पण जे आपल्या वाकड्या मार्गाकडे वळतात,","poem":1},{"lineBreak":true},{"text":"परमेश्वर त्यांना वाईट करणाऱ्याबरोबर घालवून देईल.","poem":1},{"lineBreak":true},{"text":"इस्राएलांवर शांती असो.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}