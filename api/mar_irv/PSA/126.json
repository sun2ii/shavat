{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"heading","content":["परत आणल्याबद्दल उपकारस्तुती"]},{"type":"verse","number":1,"content":[{"text":"सीयोनेतून धरून नेलेल्यांना परमेश्वराने माघारी आणले,","poem":1},{"lineBreak":true},{"text":"तेव्हा आम्हास स्वप्नासारखे वाटले.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मग आमचे मुख हास्याने,","poem":1},{"lineBreak":true},{"text":"आणि आमची जीभ गायनाने भरली.","poem":1},{"lineBreak":true},{"text":"नंतर ते राष्ट्रांमध्ये म्हणू लागले;","poem":1},{"lineBreak":true},{"text":"परमेश्वराने ह्यांच्यासाठी महान गोष्टी केल्या आहेत.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"परमेश्वराने आमच्यासाठी महान गोष्टी केल्या आहेत;","poem":1},{"lineBreak":true},{"text":"आम्ही किती हर्षित झालो आहोत!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"परमेश्वरा, नेगेब येथील प्रवाहाप्रमाणे","poem":1},{"lineBreak":true},{"text":"आम्हास बंदिवासातून परत आण.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"जे अश्रूपूर्ण नेत्रांनी पेरणी करतील ते हर्षाने आरोळी मारून कापणी करतील.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"जो पेरणीसाठी बी घेऊन रडत बाहेर पडतो,","poem":1},{"lineBreak":true},{"text":"तो पुन्हा हर्षाने आरोळी मारून आपल्या पेंढ्या आपल्याबरोबर घेऊन येईल.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}