{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"heading","content":["भरभराट परमेश्वराकडूनच प्राप्त होते"]},{"type":"verse","number":1,"content":[{"text":"परमेश्वर जर घर बांधीत नाही,","poem":1},{"lineBreak":true},{"text":"तर तो जे बांधतो ते काम व्यर्थ आहे.","poem":1},{"lineBreak":true},{"text":"जर परमेश्वर नगर रक्षित नाही,","poem":1},{"lineBreak":true},{"text":"तर पहारेकरी उभे राहून रक्षण करतात ते व्यर्थ आहे.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तुम्ही पहाटे लवकर उठता,","poem":1},{"lineBreak":true},{"text":"रात्री उशीराने घरी येता,","poem":1},{"lineBreak":true},{"text":"किंवा कठोर परिश्रम करून भाकर खाता हे सर्व व्यर्थ आहे","poem":1},{"lineBreak":true},{"text":"कारण परमेश्वर आपल्या प्रियजनास लागेल ते झोपेतही देतो.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"पाहा, मुले ही परमेश्वरापासून मिळालेले वतन आहे,","poem":1},{"lineBreak":true},{"text":"आणि पोटचे फळ त्याच्यापासून मिळालेली देणगी आहे.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तरुणपणाची मुले हे वीराच्या","poem":1},{"lineBreak":true},{"text":"हातातील बाणांसारखी आहेत.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ज्या मनुष्याचा भाता अशांनी भरला आहे, तो धन्य!","poem":1},{"lineBreak":true},{"text":"तो वेशीवर शत्रूंशी त्याची बोलाचाली होत असता,","poem":1},{"lineBreak":true},{"text":"ते फजीत होणार नाहीत.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}