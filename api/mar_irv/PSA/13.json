{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"heading","content":["संकटकाळी साहाय्यासाठी प्रार्थना"]},{"type":"hebrew_subtitle","content":["मुख्य गायकासाठी; दाविदाचे स्तोत्र."]},{"type":"verse","number":1,"content":["हे परमेश्वरा, तू मला आणखी किती काळ विसरून जाणार आहेस?",{"text":"किती वेळ तू आपले मुख माझ्यापासून लपवणार आहे?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"पूर्ण दिवस माझ्या हृदयात दु:ख असता,","poem":1},{"lineBreak":true},{"text":"किती काळ मी माझ्या जीवाबद्दल चिंता करू?","poem":1},{"lineBreak":true},{"text":"किती काळ माझे शत्रू माझ्यावर वर्चस्व करणार?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, माझ्या देवा, माझ्याकडे बघ, माझ्या प्रश्नांचे उत्तर दे.","poem":1},{"lineBreak":true},{"text":"मला मृत्यू निद्रा येऊ नये म्हणून, माझे डोळे प्रकाशीत कर.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"मी त्याच्यावर विजय मिळवला असे माझ्या शत्रूला बोलू देऊ नको.","poem":1},{"lineBreak":true},{"text":"म्हणजे माझा शत्रू असे म्हणणार नाही की, मी त्यावर विजय मिळविला आहे. नाहीतर माझे शत्रू मी ढळलो म्हणून उल्लासतील.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"परंतु मी तुझ्या प्रेमदयेवर विश्वास ठेवला आहे.","poem":1},{"lineBreak":true},{"text":"माझे हृदय तुझ्या तारणात हर्ष पावते.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मी परमेश्वरासाठी गाईन,","poem":1},{"lineBreak":true},{"text":"कारण त्याने मला फार उदारपणे वागवले आहे.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}