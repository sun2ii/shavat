{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"heading","content":["परमेश्वराच्या द्वारे मिळणाऱ्या तारणाविषयी आशा"]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वरा, मी तुला शोकसागरातून आरोळी मारीत आहे.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"हे प्रभू, माझी वाणी ऐक;","poem":1},{"lineBreak":true},{"text":"माझ्या विनवणीच्या वाणीकडे तुझे कान","poem":1},{"lineBreak":true},{"text":"लक्षपूर्वक लागलेले असोत.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, तू जर अन्याय लक्षात ठेवशील तर,","poem":1},{"lineBreak":true},{"text":"हे प्रभू, तुझ्यासमोर कोण उभा राहू शकेल?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"पण त्यांनी तुझे भय धरावे,","poem":1},{"lineBreak":true},{"text":"म्हणून तुझ्याजवळ क्षमा आहे.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"मी परमेश्वराची वाट पाहतो, माझा आत्मा वाट पाहतो,","poem":1},{"lineBreak":true},{"text":"आणि त्याच्या वचनावर मी आशा ठेवतो.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"पहाटेची वाट पाहणाऱ्या पहारेकऱ्यापेक्षा","poem":1},{"lineBreak":true},{"text":"माझा जीव प्रभूची अधिक वाट पाहतो.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"हे इस्राएला, परमेश्वरावर आशा ठेव.","poem":1},{"lineBreak":true},{"text":"कारण परमेश्वर दयाळू आहे,","poem":1},{"lineBreak":true},{"text":"आणि त्याच्याजवळ विपुल उद्धार आहे.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"तोच इस्राएलास त्यांच्या","poem":1},{"lineBreak":true},{"text":"सर्व पापांपासून मुक्त करीन.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}