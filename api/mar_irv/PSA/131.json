{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":131,"content":[{"type":"heading","content":["परमेश्वराच्या सन्निध निर्धास्त असणे"]},{"type":"hebrew_subtitle","content":["दाविदाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वरा, माझे हृदय गर्विष्ठ नाही किंवा माझे डोळे उन्मत्त नाही.","poem":1},{"lineBreak":true},{"text":"मी आपल्यासाठी मोठमोठ्या आशा ठेवत नाही,","poem":1},{"lineBreak":true},{"text":"किंवा ज्या माझ्या समजण्या पलीकडे आहेत अशा गोष्टीत मी पडत नाही.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"खरोखर मी आपला जीव निवांत व शांत ठेवला आहे;","poem":1},{"lineBreak":true},{"text":"जसे दूध तुटलेले बालक आपल्या आईबरोबर असते;","poem":1},{"lineBreak":true},{"text":"तसा माझा जीव, दूध तुटलेल्या बालकासारखा माझ्या ठायी आहे.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"हे इस्राएला, आतापासून आणि सर्वकाळ","poem":1},{"lineBreak":true},{"text":"तू परमेश्वरावर आशा ठेव.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}