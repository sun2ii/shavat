{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"heading","content":["पवित्रस्थानाला आशीर्वाद देण्यासाठी प्रार्थना"]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वरा, दावीदाकरता","poem":1},{"lineBreak":true},{"text":"त्याच्या सर्व दुःखांची आठवण कर.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"त्याने परमेश्वराकडे कशी शपथ वाहिली,","poem":1},{"lineBreak":true},{"text":"त्याने याकोबाच्या समर्थ प्रभूला कसा नवस केला, याची आठवण कर.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तो म्हणाला “मी आपल्या घरात","poem":1},{"lineBreak":true},{"text":"किंवा मी आपल्या अंथरुणात जाणार नाही.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"मी आपल्या डोळ्यांवर झोप","poem":1},{"lineBreak":true},{"text":"किंवा आपल्या पापण्यास विसावा देणार नाही.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"परमेश्वरासाठी स्थान,","poem":1},{"lineBreak":true},{"text":"याकोबाच्या सर्वसमर्थ देवासाठी निवासमंडप सापडेपर्यंत मी असेच करीन.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"पाहा, आम्ही याबद्दल एफ्राथात ऐकले;","poem":1},{"lineBreak":true},{"text":"आम्हास तो जारच्या रानात सापडला.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"आम्ही देवाच्या निवासमंडपात जाऊ;","poem":1},{"lineBreak":true},{"text":"आम्ही त्याच्या पदासनापाशी आराधना करू आणि म्हणू.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, ऊठ;","poem":1},{"lineBreak":true},{"text":"तू आपल्या सामर्थ्याच्या कोशासह आपल्या विश्रांतीस्थानी ये,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"तुझे याजक नितीमत्तेचे वस्रे पांघरोत;","poem":1},{"lineBreak":true},{"text":"तुझे विश्वासू आनंदाने जयघोष करोत.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"तुझा सेवक दावीदाकरिता,","poem":1},{"lineBreak":true},{"text":"तू आपल्या अभिषिक्त राजापासून निघून जाऊ नकोस.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"परमेश्वराने विश्वसनीय दावीदाजवळ शपथ वाहिली आहे;","poem":1},{"lineBreak":true},{"text":"तो त्याच्या शपथेपासून माघार घेणार नाही,","poem":1},{"lineBreak":true},{"text":"मी तुझ्या वंशातून तुझ्या राजासनावर एकाला बसवीन.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"जर तुझ्या मुलांनी माझा करार पाळला,","poem":1},{"lineBreak":true},{"text":"आणि मी त्यांना शिकवलेले नियम पाळले,","poem":1},{"lineBreak":true},{"text":"तर त्यांची मुलेसुद्धा तुझ्या राजासनावर सर्वकाळ बसतील.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"खचित परमेश्वराने सियोन निवडून घेतली आहे;","poem":1},{"lineBreak":true},{"text":"त्याच्या वस्तीसाठी त्याने इच्छा धरली आहे.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"“ही जागा सर्वकाळ माझ्या विसाव्याची आहे;","poem":1},{"lineBreak":true},{"text":"मी येथे राहीन, कारण माझी इच्छा आहे.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"मी तिला विपुलतेने अन्नसामग्रीचा आशीर्वाद देईन;","poem":1},{"lineBreak":true},{"text":"मी तिच्या गरीबांना भाकरीने तृप्त करीन.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"मी तिच्या याजकांना तारणाचे वस्त्र नेसवीन;","poem":1},{"lineBreak":true},{"text":"तिचे भक्त आनंदाने मोठ्याने जयघोष करतील.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"तेथे दावीदाच्या शिंगाला अंकुर फुटेल असे मी करीन;","poem":1},{"lineBreak":true},{"text":"तेथे मी आपल्या अभिषिक्तासाठी दिवा ठेविला आहे.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"मी त्याच्या शत्रूंला लाजेचे वस्रे नेसवीन,","poem":1},{"lineBreak":true},{"text":"परंतु त्याचा मुकुट चमकेल.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}