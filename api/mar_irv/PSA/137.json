{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"heading","content":["बाबेलमध्ये पाडावा करून नेलेल्यांचा आकांत"]},{"type":"verse","number":1,"content":[{"text":"आम्ही बाबेलाच्या नद्यांजवळ खाली बसलो;","poem":1},{"lineBreak":true},{"text":"आणि जेव्हा आम्ही सियोनेविषयी विचार केला तेव्हा रडलो.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तेथील वाळुंजावर","poem":1},{"lineBreak":true},{"text":"आम्ही आमच्या वीणा टांगल्या.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तेथे आम्हास पकडणाऱ्यांनी आम्हास गाणी गावयाला सांगितले","poem":1},{"lineBreak":true},{"text":"आणि आमची थट्टा करणाऱ्यांनी आम्ही त्यांच्यासाठी करमणूक करावी म्हणून आम्हांस म्हणाले,","poem":1},{"lineBreak":true},{"text":"सीयोनाच्या गाण्यांतले एखादे गाणे आम्हांला गाऊन दाखवा.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"परक्या देशात","poem":1},{"lineBreak":true},{"text":"आम्ही परमेश्वराचे गाणे कसे गावे?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"हे यरूशलेमे, मी जर तुला विसरलो,","poem":1},{"lineBreak":true},{"text":"तर माझा उजवा हात आपले कौशल्य विसरो.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"जर मी तुला विसरलो,","poem":1},{"lineBreak":true},{"text":"जर मी यरूशलेमेला आपल्या आनंदाच्या मुख्य","poem":1},{"lineBreak":true},{"text":"विषयाहून अधिक मानले नाही","poem":1},{"lineBreak":true},{"text":"तर माझी जीभ माझ्या टाळूला चिकटो.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, अदोमाविरूद्ध यरूशलेमेच्या","poem":1},{"lineBreak":true},{"text":"त्या दिवसाची आठवण कर,","poem":1},{"lineBreak":true},{"text":"ते म्हणाले, ती पाडून टाका,","poem":1},{"lineBreak":true},{"text":"पायापर्यंत पाडून टाका.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"हे बाबेलाच्या कन्ये, तू लवकरच ओसाड पडणार आहेस,","poem":1},{"lineBreak":true},{"text":"कारण जसे तू आम्हास केले तसे,","poem":1},{"lineBreak":true},{"text":"जो तुला परत करील तो आशीर्वादित आहे.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"जो तुझी बालके घेऊन त्यांना खडकावर आपटून ठार मारतो","poem":1},{"lineBreak":true},{"text":"तो आशीर्वादित होईल.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}