{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"heading","content":["परमेश्वराच्या कृपाप्रसादाबद्दल उपकारस्तुती"]},{"type":"hebrew_subtitle","content":["दाविदाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"मी अगदी मनापासून तुझी उपकारस्तुती करीन;","poem":1},{"lineBreak":true},{"text":"मी देवांसमोर तुझी स्तोत्रे गाईन.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मी तुझ्या पवित्र मंदिराकडे नतमस्तक होऊन,","poem":1},{"lineBreak":true},{"text":"तुझ्या कराराची विश्वासयोग्यता आणि तुझ्या सत्याबद्दल तुझ्या नावाची उपकारस्तुती करीन.","poem":1},{"lineBreak":true},{"text":"तू आपल्या संपूर्ण नावापेक्षा आपल्या वचनाची","poem":1},{"noteId":41},{"text":"थोरवी वाढविली आहेस.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"मी तुला हाक मारली त्याच दिवशी तू मला उत्तर दिलेस.","poem":1},{"lineBreak":true},{"text":"तू मला उत्तेजन दिले आणि तेव्हा माझ्या जिवाला सामर्थ्य प्राप्त झाले.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, पृथ्वीवरचे सर्व राजे तुझी उपकारस्तुती करतील,","poem":1},{"lineBreak":true},{"text":"कारण त्यांनी तुझ्या मुखातील शब्द ऐकले आहेत.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"खरोखर, ते परमेश्वराच्या मार्गाविषयी गातील","poem":1},{"lineBreak":true},{"text":"कारण परमेश्वराचा महिमा अगाध आहे.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"कारण परमेश्वर थोर आहे तरी तो दीनांकडे लक्ष देतो,","poem":1},{"lineBreak":true},{"text":"पण गर्विष्ठाला दुरून ओळखतो.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"जरी मी संकटांमध्ये चाललो तरी तू मला सुरक्षित ठेवतोस.","poem":1},{"lineBreak":true},{"text":"माझ्या शत्रूंच्या क्रोधावर तू आपला हात चालवितोस;","poem":1},{"lineBreak":true},{"text":"आणि तुझा उजवा हात माझे तारण करतो.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"परमेश्वर माझ्याबरोबर शेवटपर्यंत आहे;","poem":1},{"lineBreak":true},{"text":"हे परमेश्वरा, तुझी कराराची विश्वासयोग्यता सदासर्वकाळ आहे.","poem":1},{"lineBreak":true},{"text":"तू आपल्या हातची कामे सोडून देऊ नकोस.","poem":1}]}],"footnotes":[{"noteId":41,"caller":"+","text":"कराराची","reference":{"chapter":138,"verse":2}}]},"thisChapterLink":"/api/mar_irv/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}