{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"heading","content":["मानवाचा मूढपणा व त्याची दुष्टाई"]},{"type":"hebrew_subtitle","content":["मुख्य गायकासाठी; दाविदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"मूर्ख आपल्या हृदयात म्हणतो, “देव नाही.”","poem":1},{"lineBreak":true},{"text":"ते भ्रष्ट झाले आहेत आणि त्यांनी घृणास्पद अशी पापे केली आहेत.","poem":1},{"lineBreak":true},{"text":"चांगले करणारा कोणीच नाही.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"परमेश्वर स्वर्गातून खाली मनुष्य संतानास पाहतो की,","poem":1},{"lineBreak":true},{"text":"कोणी एखादा तरी समजणारा आणि त्याच्यामागे चालणारा आहे काय?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"प्रत्येकजण बहकून गेला आहे, ते सर्व गलिच्छ झाले आहेत.","poem":1},{"lineBreak":true},{"text":"सत्कर्म करणारा कोणीही नाही, एकही नाही.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"जे अन्याय करतात त्यांना काहीच ज्ञान नाही काय?","poem":1},{"lineBreak":true},{"text":"ते भाकरी खातात तसे माझ्या लोकांस खातात;","poem":1},{"lineBreak":true},{"text":"ते परमेश्वरास हाक मारत नाहीत?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"परंतु ते भीतीने थरथर कापतील,","poem":1},{"lineBreak":true},{"text":"कारण देव न्यायींच्या सभेत आहे.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"तुम्ही गरीब मनुष्याचा अपमान करू इच्छित आहात, तरी परमेश्वर त्याचा आश्रय आहे.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"अहा! सियोनातून इस्राएलाचे तारण आले तर किती बरे होईल!","poem":1},{"lineBreak":true},{"text":"जेव्हा परमेश्वर त्याच्या लोकांस दास्यातून सोडवेल,","poem":1},{"lineBreak":true},{"text":"तेव्हा याकोब आनंदी होईल आणि इस्राएल हर्ष करेल.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}