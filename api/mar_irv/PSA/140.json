{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":140,"content":[{"type":"heading","content":["छळणाऱ्यांपासून संरक्षण मिळावे म्हणून प्रार्थना"]},{"type":"hebrew_subtitle","content":["दाविदाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वरा, मला दुष्टांपासून सोडव;","poem":1},{"lineBreak":true},{"text":"जुलमी मनुष्यापासून मला सुरक्षित ठेव.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ते आपल्या मनात वाईट योजना करतात;","poem":1},{"lineBreak":true},{"text":"ते प्रत्येक दिवशी भांडणाला सुरुवात करतात.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"त्यांची जीभ सर्पासारखी जखम करते;","poem":1},{"lineBreak":true},{"text":"त्यांच्या ओठाखाली विषारी सर्पाचे विष आहे.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, मला दुष्टांच्या हातातून वाचव;","poem":1},{"lineBreak":true},{"text":"मला जुलमी मनुष्यांपासून सुरक्षित ठेव.","poem":1},{"lineBreak":true},{"text":"त्यांनी मला ढकलण्याची योजना केली आहे.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"गर्विष्ठांनी माझ्यासाठी पाश व दोऱ्या लपवून ठेविल्या आहेत;","poem":1},{"lineBreak":true},{"text":"त्यांनी रस्त्याच्या बाजूला जाळे पसरले आहे;","poem":1},{"lineBreak":true},{"text":"त्यांनी माझ्यासाठी सापळा लावला आहे.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मी परमेश्वरास म्हणतो, तू माझा देव आहेस; हे परमेश्वरा,","poem":1},{"lineBreak":true},{"text":"माझ्या विनवण्यांच्या वाणीकडे कान दे.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, माझ्या प्रभू, माझ्या तारणसामर्थ्या,","poem":1},{"lineBreak":true},{"text":"माझ्या लढाईच्या दिवसात तू माझे शिरस्राण आहेस.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, दुष्टांच्या इच्छा पुरवू नको,","poem":1},{"lineBreak":true},{"text":"त्यांच्या दुष्ट योजना यशस्वी होऊ देऊ नकोस. नाही तर ते उन्मत्त होतील.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ज्यांनी मला घेरले आहे;","poem":1},{"lineBreak":true},{"text":"त्यांच्या ओठापासून होणारा अनर्थ त्यांच्याच शिरी पडो.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"त्यांच्यावर जळते निखारे पडोत;","poem":1},{"lineBreak":true},{"text":"त्यांना अग्नीत टाकले जावो, ज्यातून त्यांना उठून वर","poem":1},{"lineBreak":true},{"text":"कधीही येता येणार नाही अशा खड्‌यात फेकण्यात येवो.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"वाईट बोलणारा पृथ्वीवर सुरक्षित केला जाणार नाही;","poem":1},{"lineBreak":true},{"text":"जुलमी मनुष्याच्या पाठीस अरिष्ट एकसारखे लागेल.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"परमेश्वर गरीबांच्या पक्षाचे,","poem":1},{"lineBreak":true},{"text":"आणि गरजवंताच्या वादाचे समर्थन करील हे मला माहित आहे.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"खचित नितीमान तुझ्या नावाची उपकारस्तुती करतील;","poem":1},{"lineBreak":true},{"text":"सरळ मनाचे तुझ्या समक्षतेत राहतील.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}