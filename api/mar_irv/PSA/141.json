{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":141,"content":[{"type":"heading","content":["वाईटापासून राखण्यासाठी प्रार्थना"]},{"type":"hebrew_subtitle","content":["दाविदाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वरा, मी तुला मोठ्याने ओरडून हाक मारतो; माझ्याकडे त्वरेने ये.","poem":1},{"lineBreak":true},{"text":"जेव्हा मी तुला हाक मारतो तेव्हा माझे ऐक.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"माझी प्रार्थना तुझ्यासमोर धुपाप्रमाणे,","poem":1},{"lineBreak":true},{"text":"ती माझे हात उभारणे संध्याकाळच्या अर्पणाप्रमाणे सादर होवो.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, माझ्या मुखावर पहारा ठेव;","poem":1},{"lineBreak":true},{"text":"माझ्या ओठांचे द्वार सांभाळ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"अन्याय करणाऱ्या मनुष्यांबरोबर मी त्याच्या","poem":1},{"lineBreak":true},{"text":"पापमय कार्यात सहभागी होऊ देऊ नकोस,","poem":1},{"lineBreak":true},{"text":"जे दुष्कर्मे करतात त्यांची मिष्टान्ने मला खाऊ देऊ नकोस.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"नितीमान मनुष्य मला तडाखा मारो; ती मला दयाच होईल.","poem":1},{"lineBreak":true},{"text":"तो मला दुरुस्त करो. ते माझ्या डोक्यावर तेलासारखे होईल.","poem":1},{"lineBreak":true},{"text":"माझे डोके ते स्वीकारण्यास नकार देणार नाही.","poem":1},{"lineBreak":true},{"text":"परंतु माझ्या प्रार्थना नेहमी दुष्ट लोकांच्या कृत्याविरूद्ध आहेत.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"त्यांच्या अधिपतींना कड्यावरून खाली लोटून दिले आहे;","poem":1},{"lineBreak":true},{"text":"ते माझी वचने ऐकतील कारण ती गोड आहेत.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"जमीन नांगरताना आणि ढेकळे फोडताना जशी माती विखरली जाते,","poem":1},{"lineBreak":true},{"text":"तशीच आमची हाडे अधोलोकांच्या तोंडाशी विखरली गेली आहेत.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"तरी हे प्रभू परमेश्वरा, खचित माझे डोळे तुझ्याकडे लागले आहेत;","poem":1},{"lineBreak":true},{"text":"मी तुझ्यात आश्रय घेतला आहे; माझा जीव निराधार सोडू नकोस.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"त्यांनी माझ्यासाठी जो पाश रचला आहे त्यातून व","poem":1},{"lineBreak":true},{"text":"दुष्कर्म करणाऱ्यांच्या सापळ्यातून माझे संरक्षण कर.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"दुष्ट आपल्या स्वतःच्या जाळ्यात पडोत,","poem":1},{"lineBreak":true},{"text":"मी त्यातून निसटून जाईन.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}