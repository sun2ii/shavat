{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":144,"content":[{"type":"heading","content":["सुटका आणि समृद्धीसाठी प्रार्थना"]},{"type":"hebrew_subtitle","content":["दाविदाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"परमेश्वर माझा खडक त्यास धन्यवाद असो,","poem":1},{"lineBreak":true},{"text":"जो माझ्या हाताला युद्ध करण्यास;","poem":1},{"lineBreak":true},{"text":"आणि माझ्या बोटास लढाई करण्यास शिक्षण देतो.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तो माझा दयानिधी व माझा दुर्ग,","poem":1},{"lineBreak":true},{"text":"माझा उंच बुरुज आणि मला सोडवणारा,","poem":1},{"lineBreak":true},{"text":"माझी ढाल आहे आणि मी त्याचा आश्रय घेतो;","poem":1},{"lineBreak":true},{"text":"तो लोकांस माझ्या सत्तेखाली आणतो.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, मानव तो काय की तू त्याची ओळख ठेवावी?","poem":1},{"lineBreak":true},{"text":"किंवा मनुष्य तो काय की तू त्याच्याविषयी विचार करावा?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"मनुष्य एका श्वासासारखा आहे;","poem":1},{"lineBreak":true},{"text":"त्याचे दिवस नाहीशा होणाऱ्या सावलीसारखे आहेत.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, तू आपले आकाश लववून खाली उतर;","poem":1},{"lineBreak":true},{"text":"पर्वतांना स्पर्श कर आणि त्यातून धूर येऊ दे.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"विजांचे लखलखाट पाठवून, माझ्या शत्रूला पांगवून टाक;","poem":1},{"lineBreak":true},{"text":"तुझे बाण मारून, त्यांचा पराभव करून त्यांना माघारी पाठव.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"वरून आपले हात लांब कर;","poem":1},{"lineBreak":true},{"text":"महापुरातून, या परक्यांच्या हातून,","poem":1},{"lineBreak":true},{"text":"मला सोडवून वाचव.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"त्यांचे मुख असत्य बोलते,","poem":1},{"lineBreak":true},{"text":"आणि त्यांचा उजवा हात असत्याचा आहे.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"हे देवा, मी तुला नवे गाणे गाईन.","poem":1},{"lineBreak":true},{"text":"दशतंतु वीणेवर मी तुझी स्तवने गाईन;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"तूच राजांना तारण देणारा आहे;","poem":1},{"lineBreak":true},{"text":"तूच आपला सेवक दावीद याला दुष्टाच्या तलवारीपासून वाचवले.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"मला या परक्यांच्या हातातून मुक्त कर व मला वाचव.","poem":1},{"lineBreak":true},{"text":"त्यांचे मुख असत्य बोलते;","poem":1},{"lineBreak":true},{"text":"आणि त्यांचा उजवा हात असत्याचा आहे.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"आमची मुले आपल्या तारुण्याच्या भरांत उंच वाढलेल्या रोपांसारखी आहेत.","poem":1},{"lineBreak":true},{"text":"आमच्या मुली राजवाड्याच्या कोपऱ्यातील कोरलेल्या खांबाप्रमाणे आहेत.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"आमची कोठारे प्रत्येक प्रकारच्या वस्तुंनी भरलेली असावीत.","poem":1},{"lineBreak":true},{"text":"आणि आमच्या शेतात आमची मेंढरे सहस्रपट, दशसहस्रपट वाढावीत.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"मग आमचे बैल लादलेले असावेत;","poem":1},{"lineBreak":true},{"text":"दरोडे, धरपकड व आकांत","poem":1},{"lineBreak":true},{"text":"हे आमच्या रस्त्यात नसावेत;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ज्यांना असे आशीर्वाद आहेत ते लोक आशीर्वादित आहेत;","poem":1},{"lineBreak":true},{"text":"ज्या लोकांचा देव परमेश्वर आहे ते आनंदी आहेत.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}