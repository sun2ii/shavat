{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"heading","content":["परमेश्वराच्या न्याय्य कृत्यांबद्दल स्तुती"]},{"type":"verse","number":1,"content":[{"text":"परमेश्वराची स्तुती करा.","poem":1},{"lineBreak":true},{"text":"हे माझ्या जिवा, परमेश्वराची स्तुती कर.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मी जोपर्यंत जिवंत आहे तोपर्यंत परमेश्वराची स्तुती करीन.","poem":1},{"lineBreak":true},{"text":"मला अस्तित्व आहे तोपर्यंत मी माझ्या देवाची स्तवने गाईन.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"अधिपतींवर किंवा ज्याच्याठायी तारण नाही,","poem":1},{"lineBreak":true},{"text":"अशा त्या मनुष्यजातीवर भरवसा ठेवू नका.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"जेव्हा त्याचा श्वास थांबतो, तो मातीस परत जातो;","poem":1},{"lineBreak":true},{"text":"त्यादिवशी त्याच्या योजनेचाही शेवट होतो.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ज्याच्या मदतीला याकोबाचा देव आहे,","poem":1},{"lineBreak":true},{"text":"ज्याची आशा आपला देव परमेश्वर यावर आहे, तो आशीर्वादित आहे.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"परमेश्वराने स्वर्ग आणि पृथ्वी,","poem":1},{"lineBreak":true},{"text":"समुद्र आणि त्यातील सर्वकाही निर्माण केले,","poem":1},{"lineBreak":true},{"text":"तो सदासर्वकाळ आपले सत्य पाळतो.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तो जाचलेल्यांचा न्यायनिवाडा करतो,","poem":1},{"lineBreak":true},{"text":"आणि तो भुकेल्यांना अन्न देतो.","poem":1},{"lineBreak":true},{"text":"परमेश्वर बंदिवानास मुक्त करतो.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"परमेश्वर आंधळ्यांचे डोळे उघडतो;","poem":1},{"lineBreak":true},{"text":"परमेश्वर वाकलेल्यांना उभे करतो.","poem":1},{"lineBreak":true},{"text":"परमेश्वर नितीमान लोकांवर प्रेम करतो.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"परमेश्वर आपल्या देशात परक्यांचे रक्षण करतो.","poem":1},{"lineBreak":true},{"text":"तो पितृहीनांना व विधवा यांना आधार देतो.","poem":1},{"lineBreak":true},{"text":"परंतु तो वाईटांचा विरोध करतो.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"परमेश्वर सर्वकाळ राज्य करतो,","poem":1},{"lineBreak":true},{"text":"हे सीयोने, तुझा देव पिढ्यानपिढ्या राज्य करीतो.","poem":1},{"lineBreak":true},{"text":"परमेश्वराची स्तुती करा.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}