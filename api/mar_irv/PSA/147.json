{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":147,"content":[{"type":"heading","content":["यरूशलेमेवर केलेल्या कृपेबद्दल परमेश्वराची स्तुती"]},{"type":"verse","number":1,"content":[{"text":"परमेश्वराची स्तुती करा,","poem":1},{"lineBreak":true},{"text":"कारण आमच्या देवाची स्तुती गाणे चांगले आहे;","poem":1},{"lineBreak":true},{"text":"ते आनंददायक आहे व स्तुती करणे उचित आहे.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"परमेश्वर यरूशलेम पुन्हा बांधतो;","poem":1},{"lineBreak":true},{"text":"तो इस्राएलाच्या विखुरलेल्या लोकांस एकत्र करतो.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तो भग्नहृदयी जनांना बरे करतो,","poem":1},{"lineBreak":true},{"text":"आणि त्यांच्या जखमांस पट्टी बांधतो.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तो ताऱ्यांची मोजणी करतो;","poem":1},{"lineBreak":true},{"text":"तो त्यांच्यातील प्रत्येकाला त्यांच्या नावाने हाक मारतो.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"आमचा प्रभू महान आणि सामर्थ्यात भयचकीत कार्ये करणारा आहे;","poem":1},{"lineBreak":true},{"text":"त्याची बुद्धी मोजू शकत नाही.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"परमेश्वर जाचलेल्यास उंचावतो;","poem":1},{"lineBreak":true},{"text":"तो वाईटांना खाली धुळीस मिळवतो.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"गाणे गाऊन परमेश्वराची उपकारस्तुती करा.","poem":1},{"lineBreak":true},{"text":"वीणेवर आमच्या देवाचे स्तुतीगान करा.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"तो ढगांनी आकाश झाकून टाकतो,","poem":1},{"lineBreak":true},{"text":"आणि पृथ्वीसाठी पाऊस तयार करतो,","poem":1},{"lineBreak":true},{"text":"तो डोंगरावर गवत उगवतो.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"तो प्राण्यांना","poem":1},{"lineBreak":true},{"text":"आणि जेव्हा कावळ्यांची पिल्ले कावकाव करतात त्यांना अन्न देतो.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"घोड्याच्या बलाने त्यास आनंद मिळत नाही;","poem":1},{"lineBreak":true},{"text":"मनुष्याच्या शक्तीमान पायांत तो आनंद मानत नाही.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"जे परमेश्वराचा आदर करतात,","poem":1},{"lineBreak":true},{"text":"जे त्याच्या दयेची आशा धरतात त्यांच्याबरोबर तो आनंदित होतो.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"हे यरूशलेमे, परमेश्वराची स्तुती कर;","poem":1},{"lineBreak":true},{"text":"हे सियोने तू आपल्या देवाची स्तुती कर.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"कारण त्याने तुझ्या वेशींचे अडसर बळकट केले आहेत;","poem":1},{"lineBreak":true},{"text":"त्याने तुझ्यामध्ये तुझी लेकरे आशीर्वादित केली आहेत.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"तो तुझ्या सीमांच्या आत भरभराट आणतो;","poem":1},{"lineBreak":true},{"text":"तो तुला उत्कृष्ट गव्हाने तृप्त करतो.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"तो आपली आज्ञा पृथ्वीवर पाठवतो;","poem":1},{"lineBreak":true},{"text":"त्याचा शब्द फार वेगाने धावतो.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"तो लोकरीसारखे बर्फ पसरतो;","poem":1},{"lineBreak":true},{"text":"तो राखेसारखे दवाचे कण विखरतो.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"तो आपल्या गारांचा बर्फाच्या चुऱ्याप्रमाणे वर्षाव करतो;","poem":1},{"lineBreak":true},{"text":"त्याने पाठवलेल्या गारठ्यापुढे कोण टिकेल?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"तो आपली आज्ञा पाठवून त्यांना वितळवितो;","poem":1},{"lineBreak":true},{"text":"तो आपला वारा वाहवितो व पाणी वाहू लागते.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"त्याने याकोबाला आपले वचन,","poem":1},{"lineBreak":true},{"text":"इस्राएलाला आपले नियम व निर्णय सांगितले.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"त्याने हे दुसऱ्या कोणत्याही राष्ट्रासाठी केले नाही;","poem":1},{"lineBreak":true},{"text":"आणि त्यांनी त्याचे निर्णय जाणले नाहीत.","poem":1},{"lineBreak":true},{"text":"परमेश्वराची स्तुती करा.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}