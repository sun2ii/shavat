{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"heading","content":["अखिल निर्मितीने उपकारस्तुती करण्याचा आदेश"]},{"type":"verse","number":1,"content":[{"text":"परमेश्वराची स्तुती करा.","poem":1},{"lineBreak":true},{"text":"आकाशातून परमेश्वराची स्तुती करा;","poem":1},{"lineBreak":true},{"text":"उंचामध्ये त्याची स्तुती करा.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"त्याच्या सर्व देवदूतांनो त्याची स्तुती करा;","poem":1},{"lineBreak":true},{"text":"त्याच्या सर्व सैनिकांनो, त्याची स्तुती करा.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"सूर्य व चंद्रहो त्याची स्तुती करा;","poem":1},{"lineBreak":true},{"text":"तुम्ही सर्व चमकणाऱ्या ताऱ्यांनो, त्याची स्तुती करा.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"आकाशावरील आकाशांनो","poem":1},{"lineBreak":true},{"text":"आणि आकाशावरील जलांनो त्याची स्तुती करा.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ती परमेश्वराच्या नावाची स्तुती करोत.","poem":1},{"lineBreak":true},{"text":"कारण त्याने आज्ञा केली आणि त्यांची निर्मिती झाली.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"त्याने ती सर्वकाळासाठी व कायम स्थापली;","poem":1},{"lineBreak":true},{"text":"त्याने नियम ठरवून दिला तो कधीही बदलणार नाही.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"पृथ्वीवरून परमेश्वराची स्तुती करा.","poem":1},{"lineBreak":true},{"text":"तुम्ही समुद्रातील प्राण्यांनो आणि सर्व महासागरांनो,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"अग्नी","poem":1},{"noteId":42},{"text":"आणि गारा, बर्फ आणि धुके,","poem":1},{"lineBreak":true},{"text":"त्याचे वचन पूर्ण करणारे सर्व वादळी वारा,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"पर्वत आणि सर्व टेकड्या,","poem":1},{"lineBreak":true},{"text":"फळझाडे व सर्व गंधसरू,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"जंगली आणि पाळीव प्राणी,","poem":1},{"lineBreak":true},{"text":"सरपटणारे प्राणी आणि उडणारे पक्षी,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"पृथ्वीवरचे राजे आणि सर्व राष्ट्रे,","poem":1},{"lineBreak":true},{"text":"अधिपती आणि पृथ्वीतले सर्व न्यायाधीश,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"तरुण पुरुष आणि तरुण स्रिया, वृद्ध आणि मुले दोन्ही,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ही सर्व परमेश्वराच्या नावाची स्तुती करोत,","poem":1},{"lineBreak":true},{"text":"कारण केवळ त्याचेच नाव उंचावलेले आहे;","poem":1},{"lineBreak":true},{"text":"आणि त्याचे ऐश्वर्य पृथ्वीच्या व आकाशाच्या वर पसरविले आहे.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"त्याने आपल्या लोकांचे शिंग उंचाविले आहे;","poem":1},{"lineBreak":true},{"text":"कारण तो आपल्या सर्व विश्वास ठेवणाऱ्यांना,","poem":1},{"lineBreak":true},{"text":"त्याच्याजवळ असलेल्या इस्राएलाच्या लोकांस स्तुतीपात्र आहे.","poem":1},{"lineBreak":true},{"text":"परमेश्वराची स्तुती करा.","poem":1}]}],"footnotes":[{"noteId":42,"caller":"+","text":"विजा","reference":{"chapter":148,"verse":8}}]},"thisChapterLink":"/api/mar_irv/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}