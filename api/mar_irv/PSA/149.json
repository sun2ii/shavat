{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"heading","content":["इस्त्राएलाने परमेश्वराची उपकारस्तुती करावी असा आदेश"]},{"type":"verse","number":1,"content":[{"text":"परमेश्वराची स्तुती करा.","poem":1},{"lineBreak":true},{"text":"परमेश्वरास नवे गीत गा;","poem":1},{"lineBreak":true},{"text":"विश्वासणाऱ्याच्या मंडळीत त्याचे गीत गा.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"इस्राएल आपल्या निर्माणकर्त्याच्या ठायी आनंदोत्सव करो.","poem":1},{"lineBreak":true},{"text":"सियोनेचे लोक आपल्या राजाच्या ठायी आनंद करोत.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ते त्याच्या नावाची स्तुती नाचून करोत;","poem":1},{"lineBreak":true},{"text":"ते त्याच्या स्तुतीचे गीत डफाने आणि वीणेने करो.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"कारण परमेश्वर आपल्या लोकात आनंद घेत आहे;","poem":1},{"lineBreak":true},{"text":"तो दीनांना तारणाने गौरवितो.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"भक्त विजयाने हर्षभरित होवोत;","poem":1},{"lineBreak":true},{"text":"ते आपल्या अंथरुणावरुन विजयासाठी गाणे गावो.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"देवाची स्तुती त्यांच्या मुखात असो,","poem":1},{"lineBreak":true},{"text":"आणि दुधारी तलवार त्यांच्या हातात असो.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"यासाठी की त्यांनी राष्ट्रावर सूड उगवावा","poem":1},{"lineBreak":true},{"text":"आणि लोकांस शिक्षा करावी.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ते त्यांच्या राजांना साखळंदडाने","poem":1},{"lineBreak":true},{"text":"आणि त्यांच्या सरदारांना लोखंडी बेड्यांनी बांधतील.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ते लिहून ठेवलेला जो न्याय आहे तो अंमलात आणतील.","poem":1},{"lineBreak":true},{"text":"हा त्याच्या सर्व विश्वास ठेवणाऱ्यांसाठी आदर आहे.","poem":1},{"lineBreak":true},{"text":"परमेश्वराची स्तुती करा.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}