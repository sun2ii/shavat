{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"heading","content":["परमेश्वराच्या अभिषिक्ताचे राज्य"]},{"type":"verse","number":1,"content":["राष्ट्रे का बंडखोर झाली आहेत,",{"text":"आणि लोक व्यर्थच का कट रचत आहेत?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"पृथ्वीचे राजे परमेश्वराविरूद्ध व त्याच्या अभिषिक्त्याविरूद्ध एकत्र उभे झाले आहेत,","poem":1},{"lineBreak":true},{"text":"आणि राज्यकर्ते एकत्र मिळून कट रचत आहेत, ते म्हणतात.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"चला, आपण त्यांच्या बेड्या तोडून टाकू, जे त्यांनी आपणावर लादल्या होत्या.","poem":1},{"lineBreak":true},{"text":"आणि त्यांचे साखळदंड फेकून देऊ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"परंतु तो जो आकाशांत बसलेला आहे तो हसेल,","poem":1},{"lineBreak":true},{"text":"प्रभू त्यांचा उपहास करेल.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"तेव्हा तो आपल्या रागात त्यांच्याशी बोलेल,","poem":1},{"lineBreak":true},{"text":"आणि आपल्या संतापाने त्यांना घाबरे करील.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मी माझ्या पवित्र डोंगरावर, सीयोनावर","poem":1},{"noteId":0},{"text":",","poem":1},{"lineBreak":true},{"text":"माझ्या राजास अभिषेक केला आहे.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"मी परमेश्वराचा फर्मान घोषीत करीन,","poem":1},{"lineBreak":true},{"text":"तो मला म्हणाला, “तू माझा पुत्र आहेस.”","poem":1},{"lineBreak":true},{"text":"या दिवशी मी तुझा पिता झालो आहे.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"मला माग, आणि मी तुला राष्ट्रे तुझे वतन आणि पृथ्वीच्या सीमा तुझ्या ताब्यात देईल.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"लोखंडी दंडाने तू त्यांना तोडशील,","poem":1},{"lineBreak":true},{"text":"कुंभाराच्या भांड्यासारखा तू त्यांना फोडशील.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"म्हणून आता, अहो राजांनो, सावध व्हा;","poem":1},{"lineBreak":true},{"text":"पृथ्वीच्या राज्यकर्त्यांनो, चूक दुरुस्त करा.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"भय धरून परमेश्वराची स्तुती करा","poem":1},{"lineBreak":true},{"text":"आणि थरथर कापून हर्ष करा.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"आणि तो तुमच्यावर रागावू नये,","poem":1},{"lineBreak":true},{"text":"ह्यासाठी देवाच्या पुत्रास खरी निष्ठा द्या, म्हणजे तुम्ही मरणार नाही.","poem":1},{"lineBreak":true},{"text":"कारण देवाचा क्रोध त्वरीत पेटेल.","poem":1},{"lineBreak":true},{"text":"जे सर्व त्याच्याठायी आश्रय घेतात ते आशीर्वादीत आहेत.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"हे नाव मारिया डोंगरावरील एका टेकडीला देण्यात आले होते ज्यावर शलमोन राजाने मंदिर बांधले","reference":{"chapter":2,"verse":6}}]},"thisChapterLink":"/api/mar_irv/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}