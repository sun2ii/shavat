{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"heading","content":["विजयासाठी प्रार्थना"]},{"type":"hebrew_subtitle","content":["मुख्य गायकासाठी, दाविदाचे स्तोत्र."]},{"type":"verse","number":1,"content":["परमेश्वर तुला संकटात साहाय्य करो,",{"text":"याकोबाच्या देवाचे नाव तुझे संरक्षण करो.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"देव त्याच्या पवित्र स्थानातून तुम्हास मदत पाठवो. तो तुम्हास सियोनातून साहाय्य करो.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तो तुझ्या सर्व अर्पणांची आठवण ठेवो,","poem":1},{"lineBreak":true},{"text":"आणि तुझे होमार्पण यज्ञ मान्य करो.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तो तुझ्या हृदयाच्या इच्छा मान्य करो,","poem":1},{"lineBreak":true},{"text":"आणि तुझ्या सर्व योजना पूर्ण करो.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"तेव्हा आम्ही तुझ्या तारणात हर्ष करू.","poem":1},{"lineBreak":true},{"text":"आणि आमच्या देवाच्या नावात झेंडे उभारू.","poem":1},{"lineBreak":true},{"text":"परमेश्वर तुझ्या सर्व विनंत्या पूर्ण करो.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"परमेश्वर आपल्या अभिषिक्ताला तारतो, हे मी जाणले आहे.","poem":1},{"lineBreak":true},{"text":"त्याच्या तारण करणाऱ्या उजव्या हाताच्या सामर्थ्याने,","poem":1},{"lineBreak":true},{"text":"तो त्याच्या पवित्र स्वर्गातून त्यास उत्तर देईल.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"काही त्यांच्या रथांवर भरंवसा ठेवतात, तर काही घोड्यांवर,","poem":1},{"lineBreak":true},{"text":"परंतु आम्ही आमच्या परमेश्वर देवाला हाक मारू.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ते खाली आणले गेले आणि पडले,","poem":1},{"lineBreak":true},{"text":"परंतु आम्ही उठू आणि ताठ उभे राहू!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा तारण कर, आम्ही आरोळी करू त्या दिवशी राजा आम्हांला उत्तर देवो.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}