{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":21,"content":[{"type":"heading","content":["शत्रूच्या तावडीतून सुटल्याबद्दल उपकारस्तुती"]},{"type":"hebrew_subtitle","content":["मुख्य गायकासाठी, दाविदाचे स्तोत्र."]},{"type":"verse","number":1,"content":["हे परमेश्वरा, तुझ्या सामर्थ्यात राजा हर्ष करतो!",{"text":"तू दिलेल्या तारणात तो किती मोठ्या मानाने आनंद करतो!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"त्याच्या हृदयाची इच्छा तू पूर्ण केली आहेस.","poem":1},{"lineBreak":true},{"text":"आणि त्याच्या ओठांची विनंती तू अमान्य केली नाही.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"कारण तो तुजकडे मोठे आशीर्वाद आणतो.","poem":1},{"lineBreak":true},{"text":"तू त्याच्या डोक्यावर शुद्ध सोन्याचा मुकुट चढवतो.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"त्याने तुझ्याकडे जीवनाची मागणी केली आणि तू त्यास न संपणारे आयुष्य दिलेस.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"तुझ्या विजयामुळे त्याचे गौरव थोर आहे.","poem":1},{"lineBreak":true},{"text":"तू त्यास ऐश्वर्य व वैभव बहाल केलेस.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"कारण तू त्यास सर्वकाळचा आशीर्वाद दिला आहे;","poem":1},{"lineBreak":true},{"text":"तू तुझ्या समक्षतेत त्यास हर्षाने आनंदित करतोस.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"कारण राजाचा परमेश्वरावर विश्वास आहे,","poem":1},{"lineBreak":true},{"text":"परात्पराच्या प्रेमदयेने तो कधीही ढळणार नाही.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"तुझा हात तुझ्या सर्व शत्रूला पकडणार.","poem":1},{"lineBreak":true},{"text":"तुझा उजवा हात जे तुझा हेवा करतात त्यांना पकडेल.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"तुझ्या क्रोधसमयी तू त्यांना जळत्या भट्टीत जाळून टाकशील.","poem":1},{"lineBreak":true},{"text":"परमेश्वर त्याच्या क्रोधसमयी त्यांचा नाश करणार,","poem":1},{"lineBreak":true},{"text":"आणि त्याचा अग्नी त्यांना खाऊन टाकणार.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"तू त्यांच्या संतानांचा या पृथ्वीवरुन नाश करशील.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"कारण, त्या लोकांनी तुझ्याविरूद्ध वाईट योजिले,","poem":1},{"lineBreak":true},{"text":"त्यांनी अशी योजना आखली जी त्यांच्याने यशस्वी झाली नाही.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"कारण तू त्यांना त्यांची पाठ दाखवावयास लावशील.","poem":1},{"lineBreak":true},{"text":"तू आपले धनुष्य त्यांच्यावर चालवण्यास सज्ज करशील.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"परमेश्वरा तू आपल्या नावाने उंचावला जावो,","poem":1},{"lineBreak":true},{"text":"आम्ही गाऊ व तुझ्या सामर्थ्याची स्तुती करू.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}