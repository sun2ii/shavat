{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"heading","content":["परमेश्वर माझा मेंढपाळ"]},{"type":"hebrew_subtitle","content":["दाविदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"परमेश्वर माझा मेंढपाळ आहे","poem":1},{"noteId":9},{"text":", मला कशाचीही उणीव भासणार नाही.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तो मला हिरव्या कुरणात बसवतो, तो मला संथ पाण्याजवळ नेतो.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तो माझा जीव ताजा-तवाना करतो,","poem":1},{"lineBreak":true},{"text":"तो आपल्या नावाकरिता मला योग्य मार्गात चालवतो.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"मी जरी अंधकाराने भरलेल्या दरीत चालत असलो तरी,","poem":1},{"lineBreak":true},{"text":"मला कसल्याही संकटाचे भय वाटणार नाही,","poem":1},{"lineBreak":true},{"text":"कारण तू माझ्याबरोबर आहेस, तुझी आकडी आणि काठी माझे सांत्वन करतात.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"तू माझ्या शत्रूंच्या समक्षतेत मज पुढे मेज तयार करतोस,","poem":1},{"lineBreak":true},{"text":"तू माझ्या डोक्याला तेलाने अभिषिक्त केले आहे.","poem":1},{"lineBreak":true},{"text":"माझा प्याला भरुन वाहत आहे.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"खचित माझ्या आयुष्याचे सर्व दिवस हित आणि प्रेमदया माझ्या मागे चालतील,","poem":1},{"lineBreak":true},{"text":"आणि परमेश्वराच्या घरात मी अनंतकाळ राहीन.","poem":1}]}],"footnotes":[{"noteId":9,"caller":"+","text":"यहोवा-रोही","reference":{"chapter":23,"verse":1}}]},"thisChapterLink":"/api/mar_irv/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}