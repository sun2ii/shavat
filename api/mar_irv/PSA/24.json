{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"heading","content":["गौरवाचा राजा"]},{"type":"hebrew_subtitle","content":["दाविदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"भूमी आणि तिच्यावरील परिपूर्णता परमेश्वराची आहे.","poem":1},{"lineBreak":true},{"text":"जग आणि त्यातील सर्व राहणारे परमेश्वराचे आहेत.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"कारण त्याने समुद्रावर तिचा पाया घातला,","poem":1},{"lineBreak":true},{"text":"आणि जलांवर त्याने ती स्थापली.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"परमेश्वराच्या","poem":1},{"noteId":10},{"text":"डोंगरावर कोण चढेल?","poem":1},{"lineBreak":true},{"text":"परमेश्वराच्या पवित्र मंदिरात कोण उभा राहू","poem":1},{"noteId":11},{"text":"शकतो?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ज्याचे हात निर्मळ आहेत, ज्यांचे हृदय शुद्ध आहे,","poem":1},{"lineBreak":true},{"text":"ज्याने आपला जीव खोटेपणाकडे उंचावला नाही,","poem":1},{"lineBreak":true},{"text":"आणि ज्याने दुष्टपणाने शपथ वाहिली नाही.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"तो परमेश्वराकडून आशीर्वाद प्राप्त करेल,","poem":1},{"lineBreak":true},{"text":"आणि त्यालाच त्याच्या तारणाऱ्या देवापासून न्यायीपण मिळेल.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"हिच पिढी त्यास शोधणारी आहे,","poem":1},{"lineBreak":true},{"text":"जी याकोबाच्या देवाचे मुख शोधते.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"अहो! वेशींनो, आपले मस्तक उंच करा.","poem":1},{"lineBreak":true},{"text":"पुर्वकालीन द्वारांनो, उंच व्हा,","poem":1},{"lineBreak":true},{"text":"म्हणजे गौरवशाली राजा आत येईल.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"गौरवशाली राजा कोण आहे?","poem":1},{"lineBreak":true},{"text":"तोच परमेश्वर, सामर्थ्यशाली आणि थोर आहे.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"वेशींनो, तुमची मस्तके उंच करा.","poem":1},{"lineBreak":true},{"text":"सर्वकाळच्या दरवाजांनो, तुम्ही उंच व्हा,","poem":1},{"lineBreak":true},{"text":"म्हणजे गौरवशाली राजा आत येईल.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"तो गौरवशाली राजा कोण आहे?","poem":1},{"lineBreak":true},{"text":"सेनाधीश परमेश्वरच तो राजा आहे,","poem":1},{"lineBreak":true},{"text":"तोच तो गौरवशाली राजा आहे.","poem":1}]}],"footnotes":[{"noteId":10,"caller":"+","text":"सियोन पर्वत","reference":{"chapter":24,"verse":3}},{"noteId":11,"caller":"+","text":"आराधना करू","reference":{"chapter":24,"verse":3}}]},"thisChapterLink":"/api/mar_irv/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}