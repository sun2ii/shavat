{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"heading","content":["सात्त्विकतेचा दावा"]},{"type":"hebrew_subtitle","content":["दाविदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वरा, माझा न्याय कर. कारण मी प्रामाणिकपणाने चाललो आहे.","poem":1},{"lineBreak":true},{"text":"मी परमेश्वरावर न डगमगता विश्वास ठेवला आहे.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, मला पारख आणि माझे परिक्षण कर.","poem":1},{"lineBreak":true},{"text":"माझ्ये हृदय आणि आतील मन निरखून पाहा.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"कारण तुझी प्रेमदया सदैव माझ्या डोळ्यांपुढे आहे,","poem":1},{"lineBreak":true},{"text":"आणि मी तुझ्या सत्यात चाललो आहे.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"कपटी लोकांबरोबर मी सहयोगी झालो नाही,","poem":1},{"lineBreak":true},{"text":"किंवा मी अप्रामाणिक लोकांत मिसळलो नाही.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"मी त्या दुष्टांच्या सभेचा तिरस्कार करतो.","poem":1},{"lineBreak":true},{"text":"आणि मी दुष्टांसोबत राहत नाही.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मी आपले हात निर्दोषतेने धुईन,","poem":1},{"lineBreak":true},{"text":"आणि परमेश्वरा मी तुझ्या वेदीकडे वळीन.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"अशासाठी की, मी तुझी स्तुती मोठ्याने करावी","poem":1},{"lineBreak":true},{"text":"आणि तू केलेल्या आश्चर्याची कृत्ये सांगावी.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"परमेश्वरा, तुझे राहण्याचे घर आणि","poem":1},{"lineBreak":true},{"text":"तुझे गौरव जिथे असते, ते घर मला आवडते.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"पाप्यांसोबत किंवा रक्तपात करणाऱ्यांसोबत माझा प्राण काढून घेऊ नकोस.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"त्यांच्या हातात कट आहे,","poem":1},{"lineBreak":true},{"text":"आणि त्यांचा उजवा हात लाच घेण्याने भरला आहे.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"पण मी तर प्रामाणिकपणाने वागेन,","poem":1},{"lineBreak":true},{"text":"माझ्यावर दया कर आणि मला तार.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"माझा पाय सपाट ठिकाणी उभा आहे,","poem":1},{"lineBreak":true},{"text":"सभेमध्ये मी परमेश्वराची स्तुती करीन.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}