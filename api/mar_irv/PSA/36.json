{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":36,"content":[{"type":"heading","content":["देवाचे अढळ प्रेम"]},{"type":"hebrew_subtitle","content":["प्रमुख गायकासाठी; परमेश्वराचा सेवक दावीद याचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"दुष्टाचा अपराध त्याच्या हृदयात सांगत असतो की,","poem":1},{"lineBreak":true},{"text":"त्याच्या दृष्टीत देवाचे काही भय नाही.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"त्याचे अपराध उघडकीस येणार नाही आणि त्याचा द्वेष केला जाणार नाही,","poem":1},{"lineBreak":true},{"text":"अशा भ्रमात तो राहत असतो.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"त्याचे शब्द कपटी आणि पापमय असतात.","poem":1},{"lineBreak":true},{"text":"तो शहाणा होण्यास किंवा सत्कृत्ये करण्यास इच्छीत नाही.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तो आपल्या बिछान्यावर पडून असता, तो अपराधाच्या योजना आखतो.","poem":1},{"lineBreak":true},{"text":"तो वाईट मार्गाच्या योजना करतो,","poem":1},{"lineBreak":true},{"text":"तो वाईटाचा धिक्कार करत नाही.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, तुझे खरे प्रेम आकाशापेक्षाही उत्तुंग आहे;","poem":1},{"lineBreak":true},{"text":"तुझी एकनिष्ठता आभाळापर्यंत पोहचली आहे.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"परमेश्वरा तुझे न्यायीपण उंच पर्वतासारखे आहे.","poem":1},{"lineBreak":true},{"text":"तुझा न्याय खोल समुद्रासारखा आहे.","poem":1},{"lineBreak":true},{"text":"परमेश्वरा तू मनुष्यास आणि प्राण्यांस दोघांस राखतो.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"देवा! तुझी प्रेमदया किती मौल्यवान आहे.","poem":1},{"lineBreak":true},{"text":"मानवजात तुझ्या पंखांच्या सावलित आश्रय घेते.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ते तुझ्या घरातल्या समृद्धीमुळे तृप्त होतील.","poem":1},{"lineBreak":true},{"text":"तू आपल्या बहुमोल नदीतून त्यांना मनसोक्त पिण्यास देशील.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"कारण जीवनाचा झरा तुझ्याजवळ आहे.","poem":1},{"lineBreak":true},{"text":"तुझ्या प्रकाशात आम्ही प्रकाश पाहू.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"राजे तुला ओळखतात त्यांच्याकरिता तू आपली प्रेमदया विस्तीर्ण कर,","poem":1},{"lineBreak":true},{"text":"तुझी सुरक्षितता सरळांसोबत असू दे.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"गर्विष्ठांचे पाय माझ्याजवळ येऊ देऊ नकोस.","poem":1},{"lineBreak":true},{"text":"दुष्टाचा हात मला घालवून न देवो.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"तेथे दुष्ट पडले आहेत,","poem":1},{"lineBreak":true},{"text":"ते पाडले गेले आहेत आणि ते कधीही उभे राहू शकणार नाहीत.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}