{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":39,"content":[{"type":"heading","content":["आयुष्याची क्षणभंगुरता"]},{"type":"hebrew_subtitle","content":["मुख्य गायकासाठी; यदूथूनासाठी, दाविदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"मी ठरवले “मी जे बोलेन त्याकडे लक्ष देईन,","poem":1},{"lineBreak":true},{"text":"म्हणजे मी माझ्या जीभेने पाप करणार नाही.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मी स्तब्ध राहिलो, चांगले बोलण्यापासूनही मी आपले शब्द आवरले.","poem":1},{"lineBreak":true},{"text":"आणि माझ्या वेदना आणखी वाईट तऱ्हेने वाढल्या.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"माझे हृदय तापले,","poem":1},{"lineBreak":true},{"text":"जेव्हा मी या गोष्टींविषयी विचार करत होतो, तेव्हा ते अग्नीप्रमाणे पेटले.","poem":1},{"lineBreak":true},{"text":"तेव्हा शेवटी मी बोललो.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, माझ्या जीवनाचा अंत केव्हा आहे,","poem":1},{"lineBreak":true},{"text":"आणि माझ्या आयुष्याचे दिवस किती आहेत हे मला कळू दे,","poem":1},{"lineBreak":true},{"text":"मी किती क्षणभंगुर आहे ते मला दाखव.","poem":1},{"lineBreak":true},{"text":"माझे आयुष्य किती लहान आहे ते मला कळू दे.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"पाहा, तू माझे दिवस हाताच्या रुंदी इतके केले आहेत.","poem":1},{"lineBreak":true},{"text":"आणि माझा जीवनकाल तुझ्यासमोर काहीच नाही.","poem":1},{"lineBreak":true},{"text":"खचित मनुष्य केवळ एक श्वासच आहे.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"खचित प्रत्येक मनुष्य हा सावलीसारखा चालतो,","poem":1},{"lineBreak":true},{"text":"खचित प्रत्येकजण संपत्ती साठवण्यासाठी घाई करतो,","poem":1},{"lineBreak":true},{"text":"पण त्यांना हे कळत नाही कोणास ते प्राप्त होणार.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"हे प्रभू, आता मी कशाची वाट पाहू?","poem":1},{"lineBreak":true},{"text":"तूच माझी एक आशा आहेस!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"माझ्या अपराधांवर मला विजय दे,","poem":1},{"lineBreak":true},{"text":"मला मूर्खांच्या अपमानाची वस्तू होऊ देऊ नको.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"मी मुका राहिलो, मी आपले तोंड उघडले नाही.","poem":1},{"lineBreak":true},{"text":"कारण हे तुच केले आहेस.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"मला जखमा करणे थांबव,","poem":1},{"lineBreak":true},{"text":"तुझ्या हाताच्या माराने मी क्षीण झालो आहे.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"जेव्हा तू लोकांस पापांबद्दल शिकवण करतोस.","poem":1},{"lineBreak":true},{"text":"कसरीप्रमाणे तू त्यांची शक्ती खाऊन टाकतो.","poem":1},{"lineBreak":true},{"text":"खचित सर्व मनुष्य फक्त वाफ आहेत. (सेला)","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"परमेश्वरा माझी प्रार्थना ऐक,","poem":1},{"lineBreak":true},{"text":"माझ्याकडे कान लाव.","poem":1},{"lineBreak":true},{"text":"माझे रडणे ऐक,","poem":1},{"lineBreak":true},{"text":"कारण तुझ्याजवळ परका, माझ्या पूर्वजांसारखा उपरी आहे.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"तुझे माझ्यावरील टक लावून बघने फिरव,","poem":1},{"lineBreak":true},{"text":"म्हणजे मी मरणाच्या आधी पुन्हा हर्षीत होईल.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}