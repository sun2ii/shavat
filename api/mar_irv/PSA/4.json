{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"heading","content":["सायंकाळची देवावरील श्रद्धासूचक प्रार्थना"]},{"type":"hebrew_subtitle","content":["प्रमुख वाजंत्र्यासाठी; तंतुवाद्यावरचे दावीदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"मी तुला हाक मारतो तेव्हा मला उत्तर दे, हे माझ्या न्यायीपणाच्या देवा.","poem":1},{"lineBreak":true},{"text":"संकटात मी असता, तेव्हा तू मला मुक्त केले,","poem":1},{"lineBreak":true},{"text":"माझ्यावर दया कर आणि माझी प्रार्थना ऐक.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"अहो लोकहो, तुम्ही किती काळ माझी कीर्ती अप्रतिष्ठेत पालटत राहणार?","poem":1},{"lineBreak":true},{"text":"किती काळ तुम्ही व्यर्थतेची आवड धरणार, आणि खोट्याचा शोध घेणार? सेला","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"परंतु हे जाणा की परमेश्वराने देवभिरूस आपल्या करीता वेगळे केले आहे.","poem":1},{"lineBreak":true},{"text":"मी जेव्हा परमेश्वरास हाक मारीन तेव्हा तो ऐकेल.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"भीतीने थरथर कापा, परंतु पाप करू नका!","poem":1},{"lineBreak":true},{"text":"तुझ्या पलंगावर तू आपल्या हृदयात चितंन कर आणि शांत राहा.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"न्यायीपणाचे यज्ञ अर्पण करा","poem":1},{"lineBreak":true},{"text":"आणि परमेश्वरावर आपला विश्वास ठेवा.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"बरेच असे म्हणतात, “आम्हांला चांगुलपणा कोण दाखवेल?","poem":1},{"lineBreak":true},{"text":"परमेश्वरा, आम्हांवर तुझा मुखप्रकाश पाड.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"त्यांच्या धनधान्याची आणि द्राक्षरसाची समृध्दी असते,","poem":1},{"lineBreak":true},{"text":"तेव्हा त्यांना जो आनंद होतो त्यापेक्षा अधिक आनंद तू मला दिला आहे.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"मी अंथरूणावर पडतो आणि अगदी समाधानात झोपतो,","poem":1},{"lineBreak":true},{"text":"कारण परमेश्वरा, तुच माझे रक्षण करतोस आणि मला सुरक्षित ठेवतोस.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}