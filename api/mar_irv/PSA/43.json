{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"heading","content":["बचाव आणि मुक्तीसाठी प्रार्थना"]},{"type":"verse","number":1,"content":[{"text":"हे देवा, तू माझा न्याय कर, आणि भक्तिहीन राष्ट्राविरूद्ध तू माझी बाजू मांड,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"कारण तू माझ्या सामर्थ्याचा देव आहेस;","poem":1},{"lineBreak":true},{"text":"तू मला का दूर केले आहे?","poem":1},{"lineBreak":true},{"text":"शत्रूंच्या जुलूमाने मी का शोक करत फिरू?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तू आपला प्रकाश आणि सत्य पाठवून दे, ते मला चालवोत.","poem":1},{"lineBreak":true},{"text":"तुझ्या पवित्र डोंगराकडे आणि मंडपाकडे ते मला मार्गदर्शन करोत.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तेव्हा मी देवाच्या वेदीजवळ,","poem":1},{"lineBreak":true},{"text":"देव जो माझा मोठा आनंद आहे, त्याकडे जाईल,","poem":1},{"lineBreak":true},{"text":"आणि हे देवा, माझ्या देवा, वीणा वाजवून मी तुझी स्तुती करीन.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"हे माझ्या जीवा तू निराश का झाला आहेस?","poem":1},{"lineBreak":true},{"text":"आतल्या आत तू का तळमळत आहेस?","poem":1},{"lineBreak":true},{"text":"देवाची आशा धर, कारण जो माझी मदत आणि माझा देव","poem":1},{"lineBreak":true},{"text":"त्याची मी आणखी स्तुती करेन.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}