{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"heading","content":["देव आमचा आश्रय व आमचे सामर्थ्य"]},{"type":"hebrew_subtitle","content":["मुख्य गायकासाठी; कोरहाच्या मुलांचे आलामोथ सुरावर बसवलेले गाणे."]},{"type":"verse","number":1,"content":[{"text":"देव आमचा आश्रय आणि सामर्थ्य आहे,","poem":1},{"lineBreak":true},{"text":"जो संकटात मदत करण्यास सिध्द असतो.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"म्हणून जरी पृथ्वी बदलली,","poem":1},{"lineBreak":true},{"text":"जरी पर्वत डगमगून समुद्राच्या हृदयात गेले, तरी आम्ही भिणार नाही.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"जरी त्यांच्या लाटा गर्जल्या आणि खळबळल्या,","poem":1},{"lineBreak":true},{"text":"आणि त्यांच्या उचंबळण्याने पर्वत थरथरले तरी आम्ही भिणार नाही.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तेथे एक नदी आहे, तिचे प्रवाह परात्पराच्या","poem":1},{"lineBreak":true},{"text":"पवित्रस्थानाला निवासमंडपाला देवाच्या नगराला आनंदित करतात.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"देव तिच्यामध्ये आहे; ती हलणारच नाही;","poem":1},{"lineBreak":true},{"text":"देव तिला मदत करील आणि तो हे खूप लवकरच करील.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"राष्ट्रे खळबळतील आणि राज्ये डगमगतील;","poem":1},{"lineBreak":true},{"text":"तो आपला आवाज उंच करील आणि पृथ्वी वितळून जाईल.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"सेनाधीश परमेश्वर","poem":1},{"noteId":12},{"text":"आमच्याबरोबर आहे.","poem":1},{"lineBreak":true},{"text":"याकोबाचा देव आमचा आश्रयस्थान आहे.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"या, परमेश्वराची कृत्ये पाहा,","poem":1},{"lineBreak":true},{"text":"त्याने पृथ्वीचा नाश कसा केला आहे.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"तो पृथ्वीच्या सीमेपर्यंत लढाया थांबवतो;","poem":1},{"lineBreak":true},{"text":"तो धनुष्य तोडतो आणि भाल्याचे तुकडे-तुकडे करतो;","poem":1},{"lineBreak":true},{"text":"तो रथ जाळून टाकतो.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"शांत व्हा आणि लक्षात ठेवा मीच देव आहे;","poem":1},{"lineBreak":true},{"text":"राष्ट्रात मी उंचावला जाईन;","poem":1},{"lineBreak":true},{"text":"मी पृथ्वीवर उंचावला जाईन.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"सेनाधीश परमेश्वर आमच्याबरोबर आहे;","poem":1},{"lineBreak":true},{"text":"याकोबाचा देव आमचा आश्रय आहे.","poem":1}]}],"footnotes":[{"noteId":12,"caller":"+","text":"यहोवा-साबओथ","reference":{"chapter":46,"verse":7}}]},"thisChapterLink":"/api/mar_irv/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}