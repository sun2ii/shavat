{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"heading","content":["देव अखिल पृथ्वीचा राजा"]},{"type":"hebrew_subtitle","content":["कोरहाच्या पुत्राचे स्तोत्रगीते"]},{"type":"verse","number":1,"content":[{"text":"अहो सर्व लोकहो! तुम्ही टाळ्या वाजवा.","poem":1},{"lineBreak":true},{"text":"विजयोत्सवाने देवाचा जयजयकार करा.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"कारण परात्पर परमेश्वर भय धरण्यास योग्य आहे;","poem":1},{"lineBreak":true},{"text":"तो सर्व पृथ्वीवर थोर राजा आहे.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तो लोकांस आमच्या ताब्यात देतो,","poem":1},{"lineBreak":true},{"text":"आणि राष्ट्रांना आमच्या पायाखाली आणतो.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"त्याने आमचे वतन आमच्यासाठी निवडले आहे,","poem":1},{"lineBreak":true},{"text":"ज्या याकोबावर त्याने प्रीती केली तो त्याचे वैभव आहे.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"जयघोष होत असता देव वर गेला,","poem":1},{"lineBreak":true},{"text":"परमेश्वर तुतारीच्या आवाजात वर गेला.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"देवाला स्तुतिगान गा, स्तुतिस्तवने गा;","poem":1},{"lineBreak":true},{"text":"आमच्या राजाची स्तुतिगीते गा, स्तुतिगीते गा.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"कारण देव सर्व पृथ्वीचा राजा आहे;","poem":1},{"lineBreak":true},{"text":"त्याची स्तुतीपर गाणे उमजून गा.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"देव राष्ट्रांवर राज्य करतो;","poem":1},{"lineBreak":true},{"text":"देव आपल्या पवित्र सिंहासनावर बसला आहे.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"अब्राहामाच्या देवाच्या लोकांचे अधिपती एकत्र जमले आहेत;","poem":1},{"lineBreak":true},{"text":"कारण पृथ्वीवरील ढाली देवाच्या आहेत.","poem":1},{"lineBreak":true},{"text":"तो अत्यंत उंच आहे.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}