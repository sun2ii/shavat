{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"heading","content":["सीयोनेचे सौंदर्य व वैभव"]},{"type":"hebrew_subtitle","content":["कोरहाच्या पुत्राचे स्तोत्रगीत."]},{"type":"verse","number":1,"content":[{"text":"आमच्या देवाच्या नगरात, त्याच्या पवित्र पर्वतावर,","poem":1},{"lineBreak":true},{"text":"परमेश्वर थोर आणि परमस्तुत्य आहे.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"सियोन डोंगर, जो थोर राजाची नगरी आहे, पृथ्वीच्या बाजूस आहे,","poem":1},{"lineBreak":true},{"text":"त्याचे सौंदर्य उच्चतेवर, सर्व पृथ्वीवर आनंद आणते.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"देवाने तिच्या राजमहालांमध्ये आपणास आश्रयदुर्ग असे प्रगट केले आहे.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"कारण, पाहा, राजे एकत्र येत आहेत,","poem":1},{"lineBreak":true},{"text":"ते एकत्र येऊन चढाई करून आले.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"त्यांनी पाहिले आणि ते विस्मित झाले.","poem":1},{"lineBreak":true},{"text":"ते निराश झाले आणि पळत सुटले.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"भयाने त्यांना गाठले, भीतीने त्यांचा थरकाप झाला.","poem":1},{"lineBreak":true},{"text":"प्रसवणाऱ्या स्रीच्या वेदनांप्रमाणे त्यांना वेदना लागल्या.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"पूर्वेकडच्या वाऱ्याने","poem":1},{"lineBreak":true},{"text":"तू तार्शीशाची जहाजे मोडलीस.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"होय, आम्ही ती गोष्ट ऐकली पण आम्ही ते सर्वशक्तिमान परमेश्वराच्या नगरात,","poem":1},{"lineBreak":true},{"text":"आमच्या देवाच्या नगरात घडत असलेले पाहिले.","poem":1},{"lineBreak":true},{"text":"देव ते शहर सदैव सामर्थ्यवान बनवतो.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"देवा, आम्ही तुझ्या मंदिरात तुझ्या प्रेमदयेचा विचार करतो.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"देवा, जसे तुझे नाव आहे,","poem":1},{"lineBreak":true},{"text":"तशी तुझी किर्ती पृथ्वीच्या शेवटापर्यंत आहे.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"तुझ्या न्याय कृत्यांमुळे, सियोन पर्वत आनंद करो,","poem":1},{"lineBreak":true},{"text":"यहूदाची कन्या हर्ष करोत.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"सियोने भोवती फिरा, शहर बघा, तिचे बुरुज मोजा.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"उंच भिंती बघा, सियोनेच्या राजवाड्याचे वर्णन करा.","poem":1},{"lineBreak":true},{"text":"नंतर तुम्ही पुढच्या पिढीला त्याबद्दल सांगू शकाल.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"कारण हा देव, आमचा देव, सदासर्वकाळ आहे.","poem":1},{"lineBreak":true},{"text":"तो सर्वकाळ आमचा मार्गदर्शक होईल.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}