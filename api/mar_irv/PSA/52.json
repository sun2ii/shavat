{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"heading","content":["ज्ञानशून्य दुष्ट"]},{"type":"hebrew_subtitle","content":["दाविदाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"हे सामर्थ्यवान पुरुषा, तू वाईट गोष्टींचा अभिमान का बाळगतोस?","poem":1},{"lineBreak":true},{"text":"देवाच्या कराराची विश्वसनियता प्रत्येक दिवशी येते.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"अरे कपटाने कार्य करणाऱ्या,","poem":1},{"lineBreak":true},{"text":"तुझी जीभ धारदार वस्तऱ्यासारखी नाशाची योजना करते.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तुला चांगल्यापेक्षा वाईटाची,","poem":1},{"lineBreak":true},{"text":"आणि प्रामाणिकपणे बोलण्यापेक्षा असत्याची अधिक आवड आहे.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तू कपटी जीभे,","poem":1},{"lineBreak":true},{"text":"तुला दुसऱ्यांचा नाश करणारे शब्द आवडतात.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"त्याप्रमाणे देव तुझा सर्वकाळ नाश करील;","poem":1},{"lineBreak":true},{"text":"तो तुला वर घेऊन जाईल आणि आपल्या तंबूतून उपटून बाहेर काढेल","poem":1},{"lineBreak":true},{"text":"आणि तुला जिवंताच्या भूमीतून मुळासकट उपटून टाकील.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"नितीमानसुद्धा ते पाहतील आणि घाबरतील;","poem":1},{"lineBreak":true},{"text":"ते त्याच्याकडे पाहून हसतील आणि म्हणतील,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"पाहा, या मनुष्याने देवाला आपले आश्रयस्थान केले नाही,","poem":1},{"lineBreak":true},{"text":"पण आपल्या विपुल संपत्तीवर भरवसा ठेवला,","poem":1},{"lineBreak":true},{"text":"आणि आपल्या दुष्टपणात स्वतःला पक्के केले.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"पण मी तर देवाच्या घरात हिरव्यागार जैतून झाडासारखा आहे;","poem":1},{"lineBreak":true},{"text":"माझा देवाच्या कराराच्या विश्वसनीयतेवर सदासर्वकाळ आणि कायम भरवसा आहे.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"कारण ज्या गोष्टी तू केल्या आहेत, त्यासाठी मी तुझ्या","poem":1},{"lineBreak":true},{"text":"विश्वासणाऱ्यांच्या समक्षेत सर्वकाळ तुझे उपकार मानीन.","poem":1},{"lineBreak":true},{"text":"आणि तुझ्या नावात आशा ठेवली आहे कारण ते चांगले आहे.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}