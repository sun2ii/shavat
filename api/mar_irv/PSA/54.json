{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"heading","content":["शत्रूंपासून संरक्षण मिळावे म्हणून प्रार्थना"]},{"type":"hebrew_subtitle","content":["दाविदाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"हे देवा, तू आपल्या नावाने मला वाचव,","poem":1},{"lineBreak":true},{"text":"आणि तुझ्या सामर्थ्यात माझा न्याय कर.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"हे देवा, माझी प्रार्थना ऐक;","poem":1},{"lineBreak":true},{"text":"माझ्या शब्दाकडे कान दे.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"कारण माझ्याविरूद्ध परके","poem":1},{"noteId":13},{"text":"उठले आहेत,","poem":1},{"lineBreak":true},{"text":"आणि दयाहीन माणसे माझ्या जीवाच्या मागे लागली आहेत;","poem":1},{"lineBreak":true},{"text":"त्यांनी आपल्यापुढे देवाला ठेवले नाही.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"पाहा, देव माझा मदतनीस आहे;","poem":1},{"lineBreak":true},{"text":"प्रभू माझ्या जिवाला उचलून धरणाऱ्या बरोबर आहे.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"तो माझ्या शत्रूंना वाईटाची परत फेड करील;","poem":1},{"lineBreak":true},{"text":"तू माझ्यासाठी आपल्या विश्वासूपणाने त्यांचा नाश कर.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मी तुला स्वखुशीने अर्पणे अर्पीण;","poem":1},{"lineBreak":true},{"text":"हे परमेश्वरा, मी तुझ्या नावाला धन्यवाद देईन, कारण हे चांगले आहे.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"कारण त्याने मला प्रत्येक संकटातून सोडवले आहे;","poem":1},{"lineBreak":true},{"text":"माझे डोळे माझ्या शत्रूंकडे विजयाने पाहतात.","poem":1}]}],"footnotes":[{"noteId":13,"caller":"+","text":"गर्विष्ठ","reference":{"chapter":54,"verse":3}}]},"thisChapterLink":"/api/mar_irv/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}