{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":55,"content":[{"type":"heading","content":["विश्वासघातक्यांचा नाश व्हावा म्हणून प्रार्थना"]},{"type":"hebrew_subtitle","content":["मुख्य गायकासाठी; तंतूवाद्दावरचे दाविदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"हे देवा, माझ्या प्रार्थनेकडे कान लाव,","poem":1},{"lineBreak":true},{"text":"आणि माझ्या विणवनीपासून लपू नकोस.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"देवा, माझ्याकडे लक्ष लाव आणि मला उत्तर दे","poem":1},{"lineBreak":true},{"text":"माझ्या संकटात मला विसावा नाही.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"माझ्या शत्रूंच्या आवाजामुळे,","poem":1},{"lineBreak":true},{"text":"दुष्टाच्या जुलूमामुळे मी कण्हत आहे,","poem":1},{"lineBreak":true},{"text":"कारण ते माझ्यावर संकट आणतात,","poem":1},{"lineBreak":true},{"text":"आणि द्वेषात माझा पाठलाग करतात.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"माझे हृदय फार दुखणाईत आहे,","poem":1},{"lineBreak":true},{"text":"आणि मृत्यूचे भय माझ्यावर येऊन पडले आहे.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"भय आणि थरथरने माझ्यावर आली आहेत,","poem":1},{"lineBreak":true},{"text":"आणि भयाने मला ग्रासले आहे.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मला कबूतरासारखे पंख असते तर किती बरे झाले असते.","poem":1},{"lineBreak":true},{"text":"मी दूर उडून गेलो असतो आणि स्वस्थ राहिलो असतो.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"मी खूप दूर भटकत गेलो असतो.","poem":1},{"lineBreak":true},{"text":"मी रानात राहिलो असतो.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"वादळी वाऱ्यापासून मला आश्रय मिळावा म्हणून मी लवकर पळालो असतो.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"प्रभू, त्यांना नाश कर, आणि त्यांच्या भाषेत गोंधळ निर्माण कर.","poem":1},{"lineBreak":true},{"text":"कारण मी शहरात हिंसा आणि भांडणे पाहिली आहेत.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"दिवस रात्र ते भींतीवर चढून जातात;","poem":1},{"lineBreak":true},{"text":"अपराध आणि अनर्थ तिच्यामध्ये आहेत.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"दुष्टपणा तिच्यामध्ये कार्य करत आहे,","poem":1},{"lineBreak":true},{"text":"जुलूम आणि कपट कधीही तिच्या रस्त्यांना सोडत नाही.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"कारण जर माझ्या शत्रूंनी मला दोष लावला असता तर","poem":1},{"lineBreak":true},{"text":"तर मला कळून आले असते,","poem":1},{"lineBreak":true},{"text":"किंवा माझा द्वेष करणारा जो माझ्याविरूद्ध उठला असता,","poem":1},{"lineBreak":true},{"text":"तर मी स्वतःला त्याजपासून लपवले असते.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"परंतु मला संकटात टाकणारा तू आहेस,","poem":1},{"lineBreak":true},{"text":"माझा मित्र, माझा साथीदार, माझा दोस्त.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"एकमेकांसोबत आपली गोड सहभागिता होती.","poem":1},{"lineBreak":true},{"text":"आपण समुदायांबरोबर चालत देवाच्या घरात जात होतो.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"मृत्यू त्यांच्यावर अकस्मात येवो.","poem":1},{"lineBreak":true},{"text":"जीवंतपणी ते मृतलोकांत खाली जावोत.","poem":1},{"lineBreak":true},{"text":"कारण त्यांच्या जगण्यात दुष्टपण आहे.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"मी तर देवाला हाक मारीन,","poem":1},{"lineBreak":true},{"text":"आणि परमेश्वर मला तारील.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"मी देवाशी सकाळी, दुपारी आणि संध्याकाळी आपले गाऱ्हाणे करेन आणि कण्हेन.","poem":1},{"lineBreak":true},{"text":"आणि तो माझी वाणी ऐकेल.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"माझ्याविरूद्ध लढाणाऱ्यांपासून त्याने मला खंडूण, माझा जीव शांततेत ठेवला आहे.","poem":1},{"lineBreak":true},{"text":"कारण माझ्याविरूद्ध लढणारे पुष्कळ होते.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"देव, जो पुरातन काळापासून आहे,","poem":1},{"lineBreak":true},{"text":"तो ऐकणार आणि त्यांना प्रतिसाद देणार, (सेला)","poem":1},{"lineBreak":true},{"text":"ते मनुष्ये बदलत नाहीत;","poem":1},{"lineBreak":true},{"text":"ती देवाला भीत नाहीत.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"माझ्या मित्रांनी त्याच्या सोबत शांतीने राहणाऱ्यांवर आपला हात उगारला आहे.","poem":1},{"lineBreak":true},{"text":"त्याने आपला करार मोडला आहे.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"त्यांचे तोंड लोण्यासारखे आहे,","poem":1},{"lineBreak":true},{"text":"परंतू त्याचे हृदय शत्रुत्व करणारेच आहे.","poem":1},{"lineBreak":true},{"text":"त्यांचे शब्द तेलापेक्षा बुळ्बुळीतआहेत,","poem":1},{"lineBreak":true},{"text":"तरी ते बाहेर काढलेल्या तलवारी सारखे आहे.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"तू आपला भार परमेश्वरावर टाक,","poem":1},{"lineBreak":true},{"text":"म्हणजे तो तुला आधार देईल.","poem":1},{"lineBreak":true},{"text":"तो नितीमानाला कधी पडू देणार नाही.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"परंतू हे देवा, तू त्यांना नाशाच्या खांचेत पाडून टाकशील;","poem":1},{"lineBreak":true},{"text":"घातकी आणि कपटी मनुष्ये आपले अर्धे आयुष्यही जगणार नाहीत,","poem":1},{"lineBreak":true},{"text":"परंतू मी तुझ्यावर विश्वास ठेवीन.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}