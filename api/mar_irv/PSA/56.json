{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":56,"content":[{"type":"heading","content":["श्रद्धायुक्त प्रार्थना"]},{"type":"hebrew_subtitle","content":["दाविदाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"हे देवा, माझ्यावर दया कर, कारण कोणीतरी मला गिळून टाकण्याची इच्छा करतो;","poem":1},{"lineBreak":true},{"text":"दिवसभर तो माझ्याशी लढतो आणि अत्याचार करतो.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"माझे शत्रू दिवसभर मला गिळून टाकण्याची इच्छा करतात;","poem":1},{"lineBreak":true},{"text":"कारण उद्धटपणे माझ्याविरूद्ध लढणारे अनेक आहेत.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"मी जेव्हा घाबरतो,","poem":1},{"lineBreak":true},{"text":"तेव्हा मी तुझ्यावर भरंवसा ठेवीन.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"मी देवाच्या मदतीने, त्याच्या वचनाची स्तुती करीन,","poem":1},{"lineBreak":true},{"text":"मी देवावर भरवसा ठेवला आहे; मी भिणार नाही.","poem":1},{"lineBreak":true},{"text":"मनुष्य माझे काय करील?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"दिवसभर ते माझ्या शब्दांचा विपरित अर्थ करतात;","poem":1},{"lineBreak":true},{"text":"त्यांचे सर्व विचार माझ्याविरूद्ध माझ्या वाईटासाठी असतात.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ते एकत्र जमतात, ते लपतात आणि माझ्या पावलावर लक्ष ठेवतात,","poem":1},{"lineBreak":true},{"text":"जसे ते माझा जीव घेण्यासाठी वाट पाहतात.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"त्यांना अन्याय करण्यापासून निसटून जाऊ देऊ नको.","poem":1},{"lineBreak":true},{"text":"हे देवा, तुझ्या क्रोधाने त्यांना खाली आण.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"तू माझ्या भटकण्याची ठिकाणे मोजली आहेत","poem":1},{"lineBreak":true},{"text":"आणि माझे अश्रू आपल्या बाटलित ठेवली आहेत;","poem":1},{"lineBreak":true},{"text":"तुझ्या पुस्तकात त्याची नोंद नाही का?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"मी तुला हाक मारीन त्यादिवशी माझे शत्रू मागे फिरतील;","poem":1},{"lineBreak":true},{"text":"हे मला माहित आहे, देव माझ्या बाजूचा आहे.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"मी देवाच्या साहाय्याने त्याच्या वचनाची स्तुती करीन.","poem":1},{"lineBreak":true},{"text":"मी परमेश्वराच्या साहाय्याने त्याच्या वचनाची स्तुती करीन.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"मी देवावर भरंवसा ठेवीन; मी भिणार नाही; मनुष्य माझे काय करील?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"हे देवा, तुझे नवस पूर्ण करण्याचे कर्तव्य माझ्यावर आहे;","poem":1},{"lineBreak":true},{"text":"मी तुला धन्यवादाची अर्पणे देईन.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"कारण तू माझे जीवन मृत्यूपासून सोडवले आहे;","poem":1},{"lineBreak":true},{"text":"तू माझे पाय पडण्यापासून राखले,","poem":1},{"lineBreak":true},{"text":"यासाठी की, मी जीवनाच्या प्रकाशात","poem":1},{"lineBreak":true},{"text":"देवापुढे चालावे.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}