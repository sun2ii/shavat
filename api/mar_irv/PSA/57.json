{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":57,"content":[{"type":"heading","content":["छळणाऱ्यांच्या हातून सुटका व्हावी म्हणून प्रार्थना"]},{"type":"hebrew_subtitle","content":["दाविदाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"हे देवा, माझ्यावर दया कर, माझ्यावर दया कर,","poem":1},{"lineBreak":true},{"text":"कारण माझा जीव ही संकटे टळून जाईपर्यंत","poem":1},{"lineBreak":true},{"text":"तुझ्यात आश्रय घेतो.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मी परात्पर देवाकडे, जो देव माझ्यासाठी सर्वकाही करतो","poem":1},{"lineBreak":true},{"text":"त्याचा मी धावा करीन.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तो स्वर्गातून मला मदत पाठवतो आणि मला वाचवतो,","poem":1},{"lineBreak":true},{"text":"जेव्हा मनुष्य मला गिळून टाकण्याची इच्छा करतो तेव्हा तो त्यास धमकावतो;","poem":1},{"lineBreak":true},{"text":"देव त्याच्या कराराची विश्वसनीयता आणि त्याचा विश्वासूपणा मला दाखवतो.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"माझा जीव सिंहाच्यामध्ये पडला आहे;","poem":1},{"lineBreak":true},{"text":"ज्यांचे दात भाले आणि बाण आहेत,","poem":1},{"lineBreak":true},{"text":"आणि ज्यांची जीभ तलवारीसारखी धारदार आहे","poem":1},{"lineBreak":true},{"text":"अशा लोकांमध्ये मला जबरदस्तीने रहावे लागत आहे.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"हे देवा, तू आकाशापेक्षाही उंच हो;","poem":1},{"lineBreak":true},{"text":"तुझा माहिमा सर्व पृथ्वीवर होवो.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"त्यांनी माझ्या पावलांसाठी सापळा तयार केला आहे;","poem":1},{"lineBreak":true},{"text":"माझा जीव वाकून गेला आहे;","poem":1},{"lineBreak":true},{"text":"त्यांनी माझ्यासमोर खाच खणली आहे,","poem":1},{"lineBreak":true},{"text":"परंतु ते स्वतःच त्यामध्ये पडले आहेत.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"हे देवा, माझे हृदय स्थिर आहे, माझे हृदय स्थिर आहे;","poem":1},{"lineBreak":true},{"text":"मी गाईन, होय, मी स्तुती गाईन.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"हे माझ्या गौरवी जीवा, जागा हो;","poem":1},{"lineBreak":true},{"text":"हे सतारी आणि वीणे, जागे व्हा;","poem":1},{"lineBreak":true},{"text":"मी पहाटेला जागे करीन.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"हे प्रभू, मी सर्व लोकांमध्ये तुला धन्यवाद देईन;","poem":1},{"lineBreak":true},{"text":"मी सर्व राष्ट्रांमध्ये तुझी स्तवने गाईन.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"कारण तुझ्या कराराची विश्वसनियता आकाशापर्यंत महान आहे","poem":1},{"lineBreak":true},{"text":"आणि तुझा विश्वासूपणा ढगापर्यंत पोहचतो.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"हे देवा, तू आकाशाच्या वर उंचविला जावो;","poem":1},{"lineBreak":true},{"text":"तुझा महिमा सर्व पृथ्वीवर उंच होवो.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}