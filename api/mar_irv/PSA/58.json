{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":58,"content":[{"type":"heading","content":["दुष्टाला शासन व्हावे म्हणून प्रार्थना"]},{"type":"hebrew_subtitle","content":["दाविदाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"अहो अधिकाऱ्यांनो, तुम्ही खरोखर योग्य न्याय करता का?","poem":1},{"lineBreak":true},{"text":"अहो मनुष्याच्या मुलांनो, तुम्ही सरळपणे न्याय करता का?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"नाही, तुम्ही हृदयात दुष्टपणाचे काम करता;","poem":1},{"lineBreak":true},{"text":"तुम्ही पृथ्वीवर आपल्या हाताने हिंसा तोलून देता.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"दुष्ट उदरापासूनच दुरावतात;","poem":1},{"lineBreak":true},{"text":"ते जन्मल्यापासूनच खोटे बोलून बहकून जातात.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"त्यांचे विष सापाच्या विषासारखे आहे,","poem":1},{"lineBreak":true},{"text":"जो बहिरा असल्यासारखा साप आपले कान झाकतो त्याच्यासारखे आहेत;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"गारुडी कितीही कुशलतेने मंत्र घालू लागला तरी","poem":1},{"lineBreak":true},{"text":"त्याच्या वाणीकडे तो लक्ष देत नाही, त्यासारखे ते आहेत.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"हे देवा, त्यांचे दात त्यांच्या मुखात पाड;","poem":1},{"lineBreak":true},{"text":"हे परमेश्वरा तरुण सिंहाच्या दाढा पाडून टाक;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"जसे जोरात वाहणारे पाणी नाहीसे होते तसे ते नाहीसे होवोत;","poem":1},{"lineBreak":true},{"text":"जेव्हा ते आपले तीर मारतील तेव्हा त्यांना टोक नसल्यासारखे ते होवोत.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"गोगलगायीप्रमाणे ते होवोत जशी ती विरघळते आणि नाहीशी होते,","poem":1},{"lineBreak":true},{"text":"जर अवेळी जन्मलेल्या स्रीचा गर्भ त्यास कधी सूर्य प्रकाश दिसत नाही त्याप्रमाणे ते होवोत.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"तुमच्या भांड्यास काटेऱ्या जळणाची आंच लागण्यापूर्वीच,","poem":1},{"lineBreak":true},{"text":"ते हिरवे असो वा सुकलेले, दुष्ट नाहीसे होतील.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"नीतिमान जेव्हा देवाने घेतलेला सूड पाहील तेव्हा तो आनंदित होईल;","poem":1},{"lineBreak":true},{"text":"तो आपले पाय दुष्टांच्या रक्तात धुईल.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"म्हणून मनुष्य म्हणेल, “खरोखर नीतिमान मनुष्यांना त्यांचे प्रतिफळ आहे;","poem":1},{"lineBreak":true},{"text":"खरोखर पृथ्वीवर न्याय करणारा देव आहे. खरोखर आहे.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}