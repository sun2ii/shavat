{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"heading","content":["अडचणीच्या प्रसंगी दयेची याचना"]},{"type":"hebrew_subtitle","content":["मुख्य वाजंत्र्यासाठी; तंतुवाद्यावरचे शेमीनीथ नावाच्या सुरावर बसवलेले दाविदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वरा, रागाच्या भरात मला शासन करू नकोस,","poem":1},{"lineBreak":true},{"text":"किंवा तुझ्या संतापात मला शिक्षा करू नकोस.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा माझ्यावर दया कर, कारण मी अशक्त आहे.","poem":1},{"lineBreak":true},{"text":"हे परमेश्वरा मला निरोगी कर, कारण माझी हाडे ठणकत आहेत.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"माझा जीव फार घाबरला आहे.","poem":1},{"lineBreak":true},{"text":"परंतू हे परमेश्वरा, असे किती काळ चालणार आहे?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, कडक धोरण सोड, माझ्या जीवाला वाचव!","poem":1},{"lineBreak":true},{"text":"तुझ्या प्रेमदयेच्या विपुलतेने मला तार.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"कारण मरणात तुझे कोणीही स्मरण करत नाही.","poem":1},{"lineBreak":true},{"text":"मृतलोकांत तुझी उपकारस्तुती कोण करणार?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मी माझ्या कण्हण्याने दमलो आहे.","poem":1},{"lineBreak":true},{"text":"रात्रभर मी माझे अंथरुण आसवांनी ओले करतो.","poem":1},{"lineBreak":true},{"text":"मी माझे अंथरुण अश्रूंनी धुवून काढतो.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"शोकामुळे माझे डोळे अंधूक झाले आहेत.","poem":1},{"lineBreak":true},{"text":"माझ्या सर्व शत्रूंमुळे ते जीर्ण झाले आहेत.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"अहो लोकांनो, जे तुम्ही अन्यायाचे कृत्य करता, माझ्यापासून निघून जा.","poem":1},{"lineBreak":true},{"text":"कारण परमेश्वराने माझे रडणे ऐकले आहे.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"परमेश्वराने माझ्या दयेची याचना ऐकली आहे;","poem":1},{"lineBreak":true},{"text":"त्याने माझ्या प्रार्थनेचा स्वीकार केला आहे.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"माझे सर्व शत्रू लाजवले जातील आणि फार घाबरतील.","poem":1},{"lineBreak":true},{"text":"ते माघारे फिरतील आणि अकस्मात लज्जित होतील.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}