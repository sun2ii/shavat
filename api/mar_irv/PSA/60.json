{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":60,"content":[{"type":"heading","content":["शत्रूला विरोध करण्यासाठी साहाय्याची याचना"]},{"type":"hebrew_subtitle","content":["दाविदाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"हे देवा, तू आम्हास टाकून दिले आहेस; तू आम्हास फाडून खाली टाकले आहे; आमच्यावर रागावला आहेस;","poem":1},{"lineBreak":true},{"text":"तू आम्हांस पुन्हा पूर्वस्थितीवर आण.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तू भूमी कंपित केली आहेस; तू ती फाडून वेगळी केली; तिचे खिंडार बरे कर,","poem":1},{"lineBreak":true},{"text":"कारण ती हादरत आहे.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तू तुझ्या लोकांस कठीण गोष्टी दाखवल्या आहेत;","poem":1},{"lineBreak":true},{"text":"तू आम्हास झिंगवण्यास लावणारा द्राक्षरस पाजला आहे.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तुझा आदर करणाऱ्यास तू निशाण दिले आहे,","poem":1},{"lineBreak":true},{"text":"यासाठी की, त्यांनी सत्याकरता तो उभारावा.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ज्यांच्यावर तू प्रेम करतो त्यांची सुटका व्हावी,","poem":1},{"lineBreak":true},{"text":"म्हणून तुझ्या उजव्या हाताने आमची सुटका कर आणि आम्हास उत्तर दे.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"देव आपल्या पवित्रतेला अनुसरून म्हणाला, मी जल्लोष करीन;","poem":1},{"lineBreak":true},{"text":"मी शखेमाची वाटणी करीन आणि सुक्कोथाचे खोरे मोजून देईन.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"गिलाद माझा आहे आणि मनश्शे माझा आहे;","poem":1},{"lineBreak":true},{"text":"एफ्राईमही माझे शिरस्त्राण आहे;","poem":1},{"lineBreak":true},{"text":"यहूदा माझा राजदंड आहे.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"मवाब माझे धुण्याचे पात्र आहे;","poem":1},{"lineBreak":true},{"text":"अदोमावर मी माझे पादत्राण फेकीन;","poem":1},{"lineBreak":true},{"text":"मी आनंदाने पलिष्ट्यावर विजयाने आरोळी मारीन.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"मला बळकट नगरात कोण नेईल?","poem":1},{"lineBreak":true},{"text":"मला अदोमात कोण नेईल?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"हे देवा, तू आम्हास नाकारले नाही?","poem":1},{"lineBreak":true},{"text":"परंतु तू आमच्या सैन्याबरोबर लढाईत गेला नाहीस.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"तू आमच्या शत्रूविरूद्ध आम्हास मदत कर,","poem":1},{"lineBreak":true},{"text":"कारण मनुष्याचे सहाय्य निष्फळ आहे.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"आम्ही देवाच्या मदतीने विजयी होऊ;","poem":1},{"lineBreak":true},{"text":"तो आमच्या शत्रूला आपल्या पायाखाली तुडविल.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}