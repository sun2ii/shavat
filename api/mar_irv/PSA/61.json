{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"heading","content":["देवाच्या संरक्षणावर भरवसा"]},{"type":"hebrew_subtitle","content":["दाविदाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"हे देवा, माझी आरोळी ऐक;","poem":1},{"lineBreak":true},{"text":"माझ्या प्रार्थनेकडे लक्ष दे.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"जेव्हा माझे हृदय हतबल होते तेव्हा मी पृथ्वीच्या शेवटापासून तुला हाक मारीन;","poem":1},{"lineBreak":true},{"text":"माझ्यापेक्षा उंच जो खडक त्याकडे मला ने.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"कारण तू माझ्यासाठी आश्रय,","poem":1},{"lineBreak":true},{"text":"माझ्या शत्रूपासून बळकट बुरूज आहेस.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"मी तुझ्या मंडपात सर्वकाळ राहीन;","poem":1},{"lineBreak":true},{"text":"मी तुझ्या पंखाच्या सावलीखाली आश्रय घेईन.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"कारण हे देवा, तू माझी नवसाची प्रार्थना ऐकली आहेस;","poem":1},{"lineBreak":true},{"text":"जे तुझ्या नावाचा सन्मान करतात ते वतन तू मला दिले आहे.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"तू राजाचे आयुष्य वाढव;","poem":1},{"lineBreak":true},{"text":"त्याच्या आयुष्याची वर्षे अनेक पिढ्यांच्या वर्षाइतकी होवोत.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"मी देवासमोर सर्वकाळ राहो;","poem":1},{"lineBreak":true},{"text":"तुझी प्रीती आणि सत्य त्यांचे रक्षण करतील.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"मी तुझ्या नावाची स्तवने सर्वकाळ गाईन,","poem":1},{"lineBreak":true},{"text":"म्हणजे, मी प्रतीदिनी माझे नवस फेडीत राहीन.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}