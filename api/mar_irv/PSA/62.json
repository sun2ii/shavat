{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":62,"content":[{"type":"heading","content":["आपली भिस्त केवळ देवावर"]},{"type":"hebrew_subtitle","content":["दाविदाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"माझा जीव निशब्द होऊन केवळ देवाची प्रतिक्षा करत आहे;","poem":1},{"lineBreak":true},{"text":"त्याच्यापासून माझे तारण येते.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तोच केवळ माझा खडक आणि माझे तारण आहे;","poem":1},{"lineBreak":true},{"text":"तो माझा उंच बुरूज आहे; मी कधीही ढळणार नाही.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"झुकलेल्या भिंतीसारख्या, कोसळलेल्या कुंपणासारखा झालेल्या,","poem":1},{"lineBreak":true},{"text":"एका मनुष्यास मारण्यासाठी तुम्ही सर्वजण","poem":1},{"lineBreak":true},{"text":"किती काळपर्यंत त्याच्यावर हल्ला करून याल?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"त्याच्या उच्च पदापासून त्यास खाली आणण्यासाठी मात्र ते सल्ला घेतात;","poem":1},{"lineBreak":true},{"text":"त्यांना लबाड बोलण्यास आवडते;","poem":1},{"lineBreak":true},{"text":"ते आपल्या मुखाने आशीर्वाद देतात, पण त्यांच्या अंतःकरणातून शाप देतात.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"हे माझ्या जिवा, तू केवळ देवासाठी निशब्द राहून प्रतिक्षा कर;","poem":1},{"lineBreak":true},{"text":"कारण माझी आशा त्याच्यावर लागली आहे.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"तोच केवळ माझा खडक आणि तारण आहे;","poem":1},{"lineBreak":true},{"text":"तो माझा उंच बुरूज आहे; मी ढळणार नाही.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"माझे तारण आणि माझे गौरव देवावर अवलंबून आहे;","poem":1},{"lineBreak":true},{"text":"माझ्या सामर्थ्याचा खडक आणि माझा आश्रय देवच आहे.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"अहो लोकहो, सर्वदा त्याच्यावर भरवसा ठेवा;","poem":1},{"lineBreak":true},{"text":"त्याच्यापुढे आपले अंतःकरण मोकळे करा;","poem":1},{"lineBreak":true},{"text":"देव आमच्यासाठी आश्रय आहे.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"खरोखर नीच माणसे निरर्थक आहेत, आणि उच्च माणसे लबाड आहेत;","poem":1},{"lineBreak":true},{"text":"वजन केले असता हलके भरतील; त्यांना मापले असता ते केवळ मिथ्या आहेत.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"दडपशाहीवर आणि चोरीवर भरवसा ठेवू नका;","poem":1},{"lineBreak":true},{"text":"आणि संपत्तित निरुपयोगी आशा ठेवू नका;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"देव एकदा बोलला आहे,","poem":1},{"lineBreak":true},{"text":"मी दोनदा ऐकले आहे,","poem":1},{"lineBreak":true},{"text":"सामर्थ्य देवाचे आहे.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"हे प्रभू, तुझ्या ठायी प्रेमदया आहे.","poem":1},{"lineBreak":true},{"text":"कारण प्रत्येक मनुष्यास त्याने जसे केले आहे त्याप्रमाणे तू प्रतिफळ देतोस.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}