{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"heading","content":["देव तान्हेल्या जिवांचे समाधान करतो"]},{"type":"hebrew_subtitle","content":["दाविदाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"हे देवा, तू माझा देव आहेस; मी कळकळीने तुझा शोध घेईन;","poem":1},{"lineBreak":true},{"text":"शुष्क आणि रूक्ष आणि निर्जल ठिकाणी माझा जीव तुझ्यासाठी तान्हेला झाला आहे;","poem":1},{"lineBreak":true},{"text":"माझा देहही तुझ्यासाठी आसुसला आहे.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"म्हणून मी तुझे सामर्थ्य आणि गौरव पाहण्यासाठी","poem":1},{"lineBreak":true},{"text":"मी आपली दृष्टी पवित्र मंदिराकडे लावली आहे.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"कारण तुझी कराराची विश्वसनियता ही जीवनापेक्षा उत्तम आहे;","poem":1},{"lineBreak":true},{"text":"माझे ओठ तुझी स्तुती करतील.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"म्हणून मी जिवंत आहे तोपर्यंत मी तुला धन्यवाद देईन;","poem":1},{"lineBreak":true},{"text":"मी आपले हात तुझ्या नावात उंच करीन.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"माझा जीव मज्जेने आणि चरबीने व्हावा तसा तृप्त होईल;","poem":1},{"lineBreak":true},{"text":"माझे तोंड आनंदी ओठाने तुझी स्तुती करतील.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मी आपल्या अंथरुणावर तुझ्याविषयी विचार करतो","poem":1},{"lineBreak":true},{"text":"आणि रात्रीच्या समयी त्यावर मनन करतो.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"कारण तू माझे सहाय्य आहे,","poem":1},{"lineBreak":true},{"text":"आणि मी तुझ्या पंखाच्या सावलीत आनंदी आहे.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"माझा जीव तुला चिकटून राहतो;","poem":1},{"lineBreak":true},{"text":"तुझा उजवा हात मला आधार देतो.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"पण जे माझ्या जिवाचा नाश करण्याचा शोध घेतात","poem":1},{"lineBreak":true},{"text":"ते पृथ्वीच्या खालच्या भागात जातील.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"त्यांना तलवारीच्या अधिकारात दिले जाईल;","poem":1},{"lineBreak":true},{"text":"त्यांना कोल्ह्यांचा वाटा म्हणून देतील.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"परंतु राजा देवाच्या ठायी जल्लोष करेल;","poem":1},{"lineBreak":true},{"text":"जो कोणी त्याची शपथ घेईल तो त्याजवर गर्व करेल,","poem":1},{"lineBreak":true},{"text":"पण जे कोणी खोटे बोलतात त्यांचे तोंड बंद होईल.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}