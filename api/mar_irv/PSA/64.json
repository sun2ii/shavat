{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"heading","content":["गुप्त शत्रूंपासून बचाव व्हावा म्हणून प्रार्थना"]},{"type":"hebrew_subtitle","content":["दाविदाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"हे देवा, माझी वाणी ऐक, माझ्या गाऱ्हाण्याकडे कान दे;","poem":1},{"lineBreak":true},{"text":"माझ्या शत्रूंच्या भीतीपासून माझा जीव सुरक्षित ठेव.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"वाईट करणाऱ्याच्या गुप्त कारस्थानापासून,","poem":1},{"lineBreak":true},{"text":"अन्याय करणाऱ्याच्या गोंधळापासून मला लपव,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"त्यांनी आपली जीभ तलवारीसारखी धारदार केली आहे.","poem":1},{"lineBreak":true},{"text":"त्यांनी आपले बाण म्हणजे कडू शब्द मारण्यास नेम धरला आहे.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"याकरिता ते गुप्त जागेतून जे कोणी निरपराध आहेत त्यांच्यावर मारा करतात;","poem":1},{"lineBreak":true},{"text":"अचानक ते त्यांच्यावर मारा करतात आणि भीत नाहीत;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ते आपणाला वाईट योजनेत उत्त्तेजन देतात; ते खाजगीत एकत्रित येऊन सापळा रचण्याचा सल्लामसलत करतात;","poem":1},{"lineBreak":true},{"text":"ते म्हणतात, आपल्याला कोण पाहील?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ते पापी योजना शोधून काढतात; ते म्हणतात,","poem":1},{"lineBreak":true},{"text":"आम्ही काळजीपूर्वक योजना समाप्त केली आहे.","poem":1},{"lineBreak":true},{"text":"मनुष्याचे अंतःकरण आणि अंतरीक विचार खोल आहेत.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"परंतु देव त्यांच्यावर बाण सोडील;","poem":1},{"lineBreak":true},{"text":"अचानक ते त्याच्या बाणाने जखमी होतील.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"त्यांचीच जीभ त्यांच्याविरुद्ध होऊन ते अडखळविले जातील;","poem":1},{"lineBreak":true},{"text":"जे सर्व त्यांना पाहतील ते आपले डोके डोलवतील.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"सर्व लोक भितील आणि देवाची कृत्ये जाहीर करतील.","poem":1},{"lineBreak":true},{"text":"ते सूज्ञतेने त्याने जे काही केले त्याविषयी विचार करतील.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"परमेश्वराच्या ठायी नीतिमान आनंद करतील आणि त्याच्यात आश्रय घेतील;","poem":1},{"lineBreak":true},{"text":"सर्व सरळमार्गी त्याच्यात अभिमान बाळगतील.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}