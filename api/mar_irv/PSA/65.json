{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":65,"content":[{"type":"heading","content":["निसर्गामधील देवाच्या समृद्धीबद्दल उपकारस्तुती"]},{"type":"hebrew_subtitle","content":["दाविदाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"हे देवा, सीयोनेत तुझी स्तुती होवो;","poem":1},{"lineBreak":true},{"text":"तुला केलेला आमचा नवस तेथे फेडण्यात येईल.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"जो तू प्रार्थना ऐकतोस,","poem":1},{"lineBreak":true},{"text":"त्या तुझ्याकडे सर्व मानवजाती येते.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"दुष्कर्मांनी आम्हांला बेजार केले आहे.","poem":1},{"lineBreak":true},{"text":"आमचे अपराध तर तूच क्षमा करशील.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ज्या मनुष्यास तू निवडून आपल्याजवळ आणतो तो धन्य आहे,","poem":1},{"lineBreak":true},{"text":"याकरिता की; त्याने तुझ्या अंगणात रहावे.","poem":1},{"lineBreak":true},{"text":"तुझ्या घराच्या, तुझ्या मंदिराच्या","poem":1},{"lineBreak":true},{"text":"उत्तम पदार्थांनी आम्ही तृप्त होऊ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"हे आमच्या तारणाऱ्या देवा,","poem":1},{"lineBreak":true},{"text":"जो तू पृथ्वीच्या सर्व सीमांचा","poem":1},{"lineBreak":true},{"text":"आणि दूर समुद्रावर जे आहेत त्यांचा भरवसा आहेस,","poem":1},{"lineBreak":true},{"text":"तो तू न्यायीपणाने अतिआश्चर्यकारक गोष्टींनी आम्हास उत्तरे देतोस.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"कारण तू आपल्या सामर्थ्याने कंबर बांधून,","poem":1},{"lineBreak":true},{"text":"पर्वत दृढ केले आहेत.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तू गर्जणाऱ्या समुद्राला,","poem":1},{"lineBreak":true},{"text":"त्यांच्या लाटांच्या गर्जनेला","poem":1},{"lineBreak":true},{"text":"आणि लोकांचा गलबला शांत करतो.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"जे पृथ्वीच्या अगदी शेवटच्या भागामध्ये राहतात ते तुझ्या कृत्याच्या चिन्हांमुळे भितात;","poem":1},{"lineBreak":true},{"text":"तू पूर्व आणि पश्चिम यांना आनंदित करतोस.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"तू पृथ्वीला मदत करण्यासाठी आला; तू तिला पाणी घालतोस;","poem":1},{"lineBreak":true},{"text":"तू तिला फारच समृद्ध करतोस;","poem":1},{"lineBreak":true},{"text":"देवाची नदी जलपूर्ण आहे;","poem":1},{"lineBreak":true},{"text":"तू भूमी तयार करून मनुष्यजातीला धान्य पुरवतोस.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"तू तिच्या तासांना भरपूर पाणी देतोस;","poem":1},{"lineBreak":true},{"text":"तू तिचे उंचवटे सपाट करतोस;","poem":1},{"lineBreak":true},{"text":"तू तिला पावसाच्या सरींनी मऊ करतोस.","poem":1},{"lineBreak":true},{"text":"तिच्यात अंकुरीत झालेले आशीर्वादित करतोस","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"तू तुझ्या चांगुलपणाने वर्ष मुकुटमंडीत करतोस;","poem":1},{"lineBreak":true},{"text":"तुझ्या रथामागील वाटेतून पृथ्वीवर खाली समृद्धी गाळतो.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"रानातील कुरणावर त्या समृद्धी गाळतात","poem":1},{"lineBreak":true},{"text":"आणि डोंगर उल्लासाने वेढलेले आहेत.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"कुरणांनी कळप पांघरले आहेत;","poem":1},{"lineBreak":true},{"text":"दऱ्यासुद्धा धान्यांनी झाकल्या आहेत.","poem":1},{"lineBreak":true},{"text":"ते आनंदाने आरोळी मारीत आहेत आणि ते गात आहेत.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}