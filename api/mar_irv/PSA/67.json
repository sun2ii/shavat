lineBreak":true},{"text":"हे देवा, लोक तुझी स्तुती करोत;","poem":1},{"lineBreak":true},{"text":"सर्व लोक तुझी स्तुती करोत.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"भूमीने आपला हंगाम दिला आहे","poem":1},{"lineBreak":true},{"text":"आणि देव, आमचा देव, आम्हास आशीर्वाद देवो.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"देव आम्हास आशीर्वाद देवो आणि","poem":1},{"lineBreak":true},{"text":"पृथ्वीवरील सर्व सीमा त्याचा सन्मान करोत.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}