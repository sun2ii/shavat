{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":72,"content":[{"type":"heading","content":["नीतिमान राजाची कारकीर्द"]},{"type":"verse","number":1,"content":[{"text":"हे देवा, तू राजाला आपले न्यायाचे निर्णय,","poem":1},{"lineBreak":true},{"text":"राजाच्या मुलाला आपले न्यायीपण दे.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तुझ्या लोकांचा नीतीने न्याय करो,","poem":1},{"lineBreak":true},{"text":"आणि तुझ्या गरीब लोकांचा न्यायनिवाडा न्यायाने करो.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"पर्वत लोकांसाठी शांती उत्पन्न करतील;","poem":1},{"lineBreak":true},{"text":"टेकड्या न्यायीपणा उत्पन्न करतील.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तो लोकांतील गरीबांचा न्याय करील;","poem":1},{"lineBreak":true},{"text":"गरजवंताच्या मुलांना तारील,","poem":1},{"lineBreak":true},{"text":"आणि जुलूम करणाऱ्यांचे तुकडे करील.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"जोपर्यंत सूर्य आणि चंद्र आहे,","poem":1},{"lineBreak":true},{"text":"तोपर्यंत सर्व पिढ्यानपिढ्या ते तुझा आदर करतील.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"जसा कापलेल्या गवतावर पाऊस पडतो,","poem":1},{"lineBreak":true},{"text":"तशी पृथ्वीला भिजवणारी पावसाची सर उतरून येईल.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"त्याच्या दिवसात नितिमानाची भरभराट होवो,","poem":1},{"lineBreak":true},{"text":"आणि चंद्र नाहीसा होईपर्यंत विपुल शांती होईल.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"समुद्रापासून समुद्रापर्यंत","poem":1},{"lineBreak":true},{"text":"आणि त्या नदीपासून ते पृथ्वीच्या शेवटापर्यंत त्याची सत्ता राहो.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"अरण्यात राहणारे","poem":1},{"noteId":18},{"text":"त्याच्यासमोर नमन करोत;","poem":1},{"lineBreak":true},{"text":"त्याचे शत्रू धूळ चाटोत.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"तार्शीश आणि बेटांचे राजे खंडणी देवोत;","poem":1},{"lineBreak":true},{"text":"शबा आणि सबाच्या राजांना त्याच्यासाठी भेटी आणोत.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"खरोखर, सर्व राजे त्याच्यापुढे नमन करोत;","poem":1},{"lineBreak":true},{"text":"सर्व राष्ट्रे त्याची सेवा करोत;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"कारण त्याने धावा करणाऱ्या गरजवंताला,","poem":1},{"lineBreak":true},{"text":"आणि गरीबाला दुसरा कोणी मदतनीस नाही त्यास मदत केली आहे.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"तो गरीब आणि गरजवंतांवर दया करील,","poem":1},{"lineBreak":true},{"text":"आणि गरजवंताचा जीव तो तारील.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"तो त्यांचा जुलूम आणि हिंसाचारापासून त्यांचा जीव खंडून घेईल,","poem":1},{"lineBreak":true},{"text":"आणि त्यांचे रक्त त्याच्या दृष्टीने मौलवान आहे.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"राजा जगेल, त्यास शबाचे सोने दिले जावो.","poem":1},{"lineBreak":true},{"text":"लोक त्याच्यासाठी नेहमी प्रार्थना करो;","poem":1},{"lineBreak":true},{"text":"देव त्यास दिवसभर आशीर्वाद देवो.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"तेथे पृथ्वीत पर्वत कळसावर विपुल धान्य येवो;","poem":1},{"lineBreak":true},{"text":"तिचे पीक लबानोन झाडासारखे वाऱ्याच्या झुळकेने डुलोत","poem":1},{"lineBreak":true},{"text":"आणि नगरातले लोक पृथ्वीच्या गवतासारखी भरभराटीस येवो.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"राजाचे नाव सर्वकाळ टिकून राहो;","poem":1},{"lineBreak":true},{"text":"सूर्य आहे तोपर्यंत त्याचे नाव पुढे चालू राहो;","poem":1},{"lineBreak":true},{"text":"त्याच्यात लोक आशीर्वादित होतील;","poem":1},{"lineBreak":true},{"text":"सर्व राष्ट्रे त्यास धन्य म्हणतील.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"परमेश्वर देव, इस्राएलाचा देव, धन्यवादित असो,","poem":1},{"lineBreak":true},{"text":"तोच फक्त आश्चर्यकारक गोष्टी करतो.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"त्याचे गौरवशाली नाव सर्वकाळ धन्यवादित असो","poem":1},{"lineBreak":true},{"text":"आणि सर्व पृथ्वी त्याच्या गौरवाने भरली जावो. आमेन आणि आमेन.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"इशायाचा मुलगा दावीद याच्या प्रार्थना इथे संपल्या.","poem":1}]}],"footnotes":[{"noteId":18,"caller":"+","text":"शत्रू","reference":{"chapter":72,"verse":9}}]},"thisChapterLink":"/api/mar_irv/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}