{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"heading","content":["देव दुष्टाला खाली पाडतो व नीतिमानाला वर आणतो"]},{"type":"hebrew_subtitle","content":["आसाफाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"हे देवा, आम्ही तुला धन्यवाद देतो;","poem":1},{"lineBreak":true},{"text":"आम्ही धन्यवाद देतो, कारण तू आपले सान्निध्य प्रगट करतो;","poem":1},{"lineBreak":true},{"text":"लोक तुझी आश्चर्यकारक कृत्ये सांगतात.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"नेमलेल्या समयी मी योग्य न्याय करीन.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"जरी पृथ्वी आणि तिच्यावरील सर्व राहणारे सर्व भितीने कापत आहेत,","poem":1},{"lineBreak":true},{"text":"मी पृथ्वीचे खांब स्थिर करीन.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"मी गर्विष्ठांना म्हणालो, गर्विष्ठ होऊ नका,","poem":1},{"lineBreak":true},{"text":"आणि दुष्टांना म्हणालो, आपल्या विजयाविषयी धिटाई करू नका.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"विजयाविषयी इतकी खात्री बाळगू नका;","poem":1},{"lineBreak":true},{"text":"आपले डोके उंच करून बोलू नका.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"विजय पूर्वेकडून नव्हे, पश्चिमेकडून","poem":1},{"lineBreak":true},{"text":"किंवा रानातूनही येत नाही.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"पण देव न्यायाधीश आहे;","poem":1},{"lineBreak":true},{"text":"तो एकाला खाली करतो आणि दुसऱ्याला उंच करतो.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"कारण परमेश्वराने आपल्या हातात फेसाळलेला पेला धरला आहे,","poem":1},{"lineBreak":true},{"text":"त्यामध्ये मसाला मिसळला आहे आणि तो ओतून देतो.","poem":1},{"lineBreak":true},{"text":"खात्रीने पृथ्वीवरील सर्व दुर्जन शेवटल्या थेंबापर्यंत पितील.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"पण तू काय केले हे मी नेहमी सांगत राहीन;","poem":1},{"lineBreak":true},{"text":"मी याकोबाच्या देवाला स्तुती गाईन.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"तो म्हणतो, मी दुष्टांची सर्व शिंगे","poem":1},{"noteId":21},{"text":"तोडून टाकीन,","poem":1},{"lineBreak":true},{"text":"पण नितीमानाची शिंगे","poem":1},{"noteId":22},{"text":"उंच करीन.","poem":1}]}],"footnotes":[{"noteId":21,"caller":"+","text":"सामर्थ्य","reference":{"chapter":75,"verse":10}},{"noteId":22,"caller":"+","text":"सामर्थ्य","reference":{"chapter":75,"verse":10}}]},"thisChapterLink":"/api/mar_irv/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}