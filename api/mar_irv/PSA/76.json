{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"heading","content":["विजयी व न्यायी देव"]},{"type":"hebrew_subtitle","content":["मुख्य संगीतकारासाठी, तंतुवाद्यावरचे आसाफाचे स्तोत्र गीत."]},{"type":"verse","number":1,"content":[{"text":"यहूदात देव कळाला आहे,","poem":1},{"lineBreak":true},{"text":"इस्राएलामध्ये त्याचे नाव थोर आहे.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"शालेममध्ये","poem":1},{"noteId":23},{"text":"त्याचा मंडप आहे,","poem":1},{"lineBreak":true},{"text":"आणि सियोनेत त्याची गुहा आहे.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तेथे त्याने धनुष्य बाण, ढाली, तलवारी","poem":1},{"lineBreak":true},{"text":"आणि इतर शस्त्रे मोडून टाकली आहेत.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तू जेथे शत्रूंना ठार केलेस,","poem":1},{"lineBreak":true},{"text":"त्या डोंगरावरून उतरताना तू तेजस्वी चमकतोस आणि तुझे वैभव प्रकट करतोस.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"जे हृदयाचे धाडसी ते लुटले गेले आहेत,","poem":1},{"lineBreak":true},{"text":"ते झोपी गेले आहेत,","poem":1},{"lineBreak":true},{"text":"सर्व योद्धे असहाय्य झाले आहेत.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"हे याकोबाच्या देवा, तुझ्या युद्धाच्या आरोळीने,","poem":1},{"lineBreak":true},{"text":"रथ आणि घोडे दोन्हीपण झोपी गेलेत आहेत.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तू, होय तुच, ज्याचे भय धरावे असा आहेस.","poem":1},{"lineBreak":true},{"text":"असा कोण आहे कि तू रागावतोस तेव्हा तुझ्या दृष्टीस उभा राहील?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"तुझा न्याय आकाशातून आला,","poem":1},{"lineBreak":true},{"text":"आणि पृथ्वी भयभित व नि:शब्द झाली.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"देवा, तू, पृथ्वीवरील खिन्न झालेल्यांना तारायला,","poem":1},{"lineBreak":true},{"text":"न्याय अमलांत आणण्यास उठला आहे.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"खचित त्या लोकांविषयी तुझा क्रोधित न्याय, तुला स्तुती मिळवून देईल.","poem":1},{"lineBreak":true},{"text":"तुझा क्रोध तू पूर्णपणे प्रगट केला आहे.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"परमेश्वर तुमच्या देवाला नवस करून फेडा,","poem":1},{"lineBreak":true},{"text":"ज्याचे भय धरणे योग्य आहे, जे तुम्ही त्याच्या सभोवती आहात, त्यास भेटी आणा.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"तो अधिकाऱ्यांच्या आत्म्याला नम्र करतो.","poem":1},{"lineBreak":true},{"text":"पृथ्वीच्या राजांना तो भयावह असा आहे.","poem":1}]}],"footnotes":[{"noteId":23,"caller":"+","text":"यरूशलेम","reference":{"chapter":76,"verse":2}}]},"thisChapterLink":"/api/mar_irv/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}