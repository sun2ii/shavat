{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":77,"content":[{"type":"heading","content":["देवाच्या महत्कृत्यांच्या स्मरणाने समाधान"]},{"type":"hebrew_subtitle","content":["आसाफाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"मी आपल्या वाणीने देवाला हाक मारीन;","poem":1},{"lineBreak":true},{"text":"मी आपल्या वाणीने देवाला हाक मारीन आणि माझा देव माझे ऐकेल.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"माझ्या संकटाच्या दिवसात मी प्रभूला शोधले.","poem":1},{"lineBreak":true},{"text":"मी रात्रभर हात पसरून प्रार्थना केली; तो ढिला पडला नाही.","poem":1},{"lineBreak":true},{"text":"माझ्या जीवाने सांत्वन पावण्याचे नाकारले.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"मी देवाचा विचार करतो तसा मी कण्हतो;","poem":1},{"lineBreak":true},{"text":"मी त्याबद्दल चिंतन करतो तसा मी क्षीण होतो.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तू माझे डोळे उघडे ठेवतोस;","poem":1},{"lineBreak":true},{"text":"मी इतका व्याकुळ झालो की, माझ्याने बोलवत नाही.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"मी पूर्वीचे दिवस व पुरातन काळची वर्षे","poem":1},{"lineBreak":true},{"text":"याबद्दल मी विचार करतो.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"रात्रीत मी एकदा गाईलेल्या गाण्याची मला आठवण येते.","poem":1},{"lineBreak":true},{"text":"मी काळजीपूर्वक विचार करतो","poem":1},{"lineBreak":true},{"text":"आणि काय घडले हे मी समजून घेण्याचा प्रयत्न करतो.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"प्रभू सर्वकाळ आमचा नकार करील काय?","poem":1},{"lineBreak":true},{"text":"तो मला पुन्हा कधीच प्रसन्नता दाखवणार नाही का?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"त्याच्या विश्वासाचा करार कायमचा गेला आहे का?","poem":1},{"lineBreak":true},{"text":"त्याची अभिवचने पिढ्यानपिढ्या अयशस्वी होतील का?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"देव दया करण्याचे विसरला का?","poem":1},{"lineBreak":true},{"text":"त्याच्या रागाने त्याचा कळवळा बंद केला आहे का?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"मी म्हणालो, हे माझे दुःख आहे,","poem":1},{"lineBreak":true},{"text":"आमच्या प्रती परात्पराचा उजवा हात बदलला आहे","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"पण मी परमेश्वराच्या कृत्यांचे वर्णन करीन;","poem":1},{"lineBreak":true},{"text":"मी तुझ्या पुरातन काळच्या आश्चर्यकारक कृत्यांविषयी विचार करीन.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"मी तुझ्या सर्व कृत्यावर चिंतन करीन,","poem":1},{"lineBreak":true},{"text":"आणि मी त्यावर काळजीपूर्वक विचार करीन.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"हे देवा, तुझे मार्ग पवित्र","poem":1},{"noteId":24},{"text":"आहेत,","poem":1},{"lineBreak":true},{"text":"आमच्या महान देवाशी कोणता देव तुलना करेल.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"अद्भुत कृत्ये करणारा देव तूच आहेस.","poem":1},{"lineBreak":true},{"text":"तू लोकांमध्ये आपले सामर्थ्य उघड केले आहे.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"याकोब आणि योसेफ यांच्या वंशजाना,","poem":1},{"lineBreak":true},{"text":"आपल्या लोकांस आपल्या सामर्थ्याने विजय दिला आहेस.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"हे देवा, जलाने तुला पाहिले,","poem":1},{"lineBreak":true},{"text":"जलांनी तुला पाहिले आणि ते घाबरले,","poem":1},{"lineBreak":true},{"text":"खोल जले कंपित झाली.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"मेघांनी पाणी खाली ओतले;","poem":1},{"lineBreak":true},{"text":"आभाळ गडगडाटले;","poem":1},{"lineBreak":true},{"text":"तुझे बाणही चमकू लागले.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"तुझ्या गर्जनेची वाणी वावटळित ऐकण्यात आली;","poem":1},{"lineBreak":true},{"text":"विजांनी जग प्रकाशमय केले;","poem":1},{"lineBreak":true},{"text":"पृथ्वी कंपित झाली आणि थरथरली.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"समुद्रात तुझा मार्ग व महासागरात तुझ्या वाटा होत्या,","poem":1},{"lineBreak":true},{"text":"पण तुझ्या पावलाचे ठसे कोठेही दिसले नाहीत.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"मोशे आणि अहरोन याच्या हाताने","poem":1},{"lineBreak":true},{"text":"तू आपल्या लोकांस कळपाप्रमाणे नेलेस.","poem":1}]}],"footnotes":[{"noteId":24,"caller":"+","text":"चमत्कारीक","reference":{"chapter":77,"verse":13}}]},"thisChapterLink":"/api/mar_irv/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}