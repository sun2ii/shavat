{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"heading","content":["देवाचा गौरव आणि मानवाची थोरवी"]},{"type":"hebrew_subtitle","content":["मुख्य गायकासाठी; गित्तीथ सुरावर बसवलेले दाविदाचे स्तोत्र."]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वर, आमच्या देवा, तू जो आपले वैभव आकाशांवर प्रकट करतोस, ते तुझे नाव सर्व पृथ्वीवर किती उत्कृष्ठ आहे.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तुझ्या शत्रूंमुळे, वैरी व सूड घेणाऱ्यांना तू शांत करावे म्हणून,","poem":1},{"lineBreak":true},{"text":"बाळांच्या आणि तान्ह्या मुलांच्या मुखात तू उपकारस्तुती उत्पन्न केली.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तुझ्या हातांच्या बोटांनी निर्माण केलेल्या","poem":1},{"lineBreak":true},{"text":"आकाशाकडे, चंद्र आणि ताऱ्यांकडे मी जेव्हा बघतो.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तेव्हा मनुष्य काय आहे की तू त्याची आठवण करावी?","poem":1},{"lineBreak":true},{"text":"किंवा मनुष्यसंतान काय आहे की तू त्यांच्याकडे आपले लक्ष लावावे?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"तरी तू त्यांना स्वर्गीय व्यक्तीपेक्षा","poem":1},{"noteId":4},{"text":"थोडेसेच कमी केले आहेस.","poem":1},{"lineBreak":true},{"text":"आणि गौरवाने व आदराने तू त्यास मुकुट घातला आहे.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"तुझ्या हातच्या निर्माण केलेल्या सर्व गोष्टींचे तू त्यांना अधिपत्य दिलेस.","poem":1},{"lineBreak":true},{"text":"तू सर्वकाही त्याच्या पायाखाली ठेवले आहेस.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"सर्व मेंढ्या, गाय, बैल आणि रानातले वन्य पशूसुद्धा.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"आकाशातील पक्षी आणि सागरातील मासे","poem":1},{"lineBreak":true},{"text":"जे काही सागराच्या मार्गातून फिरते ते सर्व.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, आमच्या देवा,","poem":1},{"lineBreak":true},{"text":"सर्व पृथ्वीत तुझे नाव किती उत्कृष्ट आहे!","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"देवदूतांपेक्षा","reference":{"chapter":8,"verse":5}}]},"thisChapterLink":"/api/mar_irv/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}