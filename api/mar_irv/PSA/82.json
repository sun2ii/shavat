{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"heading","content":["विपरीत न्यायाला दूषण देणे"]},{"type":"hebrew_subtitle","content":["आसाफाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"देव दैवी मंडळीत उभा आहे,","poem":1},{"lineBreak":true},{"text":"तो देवांच्यामध्ये","poem":1},{"noteId":27},{"text":"न्याय देतो.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"कोठपर्यंत तुम्ही अन्यायाने न्याय कराल?","poem":1},{"lineBreak":true},{"text":"आणि दुष्टांना पक्षपातीपणा दाखवाल?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"गरीबांना आणि पितृहीनांना संरक्षण दे;","poem":1},{"lineBreak":true},{"text":"त्या पीडित व दरिद्री यांच्या हक्काचे पालन करा.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"त्या गरीब व गरजवंताना बचाव करा. त्यांच्या दुष्टांच्या हातातून त्यांना सोडवा.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"“ते जाणत नाहीत किंवा समजत नाहीत;","poem":1},{"lineBreak":true},{"text":"ते अंधारात इकडेतिकडे भटकत राहतात;","poem":1},{"lineBreak":true},{"text":"पृथ्वीचे सर्व पाये ढासळले आहेत.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"मी म्हणालो, “तुम्ही देव आहात,","poem":1},{"lineBreak":true},{"text":"आणि तुम्ही सर्व परात्पराची मुले आहात.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तरी तुम्ही मनुष्यासारखे मराल,","poem":1},{"lineBreak":true},{"text":"आणि एखाद्या सरदारासारखे तुम्ही पडाल.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"हे देवा, ऊठ! पृथ्वीचा न्याय कर,","poem":1},{"lineBreak":true},{"text":"कारण तू सर्व राष्ट्रे वतन करून घेशील.","poem":1}]}],"footnotes":[{"noteId":27,"caller":"+","text":"स्वर्गीय जनांमध्ये","reference":{"chapter":82,"verse":1}}]},"thisChapterLink":"/api/mar_irv/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}