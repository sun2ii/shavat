{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":83,"content":[{"type":"heading","content":["इस्त्राएलाच्या शत्रूंच्या नाशासाठी प्रार्थना"]},{"type":"hebrew_subtitle","content":["आसाफाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"हे देवा, गप्प राहू नकोस.","poem":1},{"lineBreak":true},{"text":"हे देवा, आमच्याकडे दुर्लक्ष करू नको आणि स्वस्थ राहू नकोस.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"पाहा, तुझे शत्रू गलबला करीत आहेत,","poem":1},{"lineBreak":true},{"text":"आणि जे तुझा द्वेष करतात त्यांनी आपले डोके उंच केले आहे.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ते तुझ्या लोकांविरूद्ध गुप्त योजना आखतात.","poem":1},{"lineBreak":true},{"text":"आणि ते एकत्र मिळून तुझ्या आश्रितांविरूद्ध योजना करतात.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ते म्हणतात, “या आणि आपण त्यांचा एक राष्ट्र म्हणून नाश करू.","poem":1},{"lineBreak":true},{"text":"यानंतर इस्राएलाचे नावही आणखी आठवणित राहणार नाही.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"त्यांनी एकमताने, एकत्र मिळून मसलत केली आहे,","poem":1},{"lineBreak":true},{"text":"ते तुझ्याविरूद्ध करार करतात.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ते तंबूत राहणारे अदोमी आणि इश्माएली, मवाब आणि हगारी,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"गबाल, अम्मोन व अमालेकचे, पलिष्टी आणि सोरकर हे ते आहेत.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"अश्शूरानेही त्यांच्याशी करार केला आहे;","poem":1},{"lineBreak":true},{"text":"ते लोटाच्या वंशजांना मदत करीत आहेत.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"तू जसे मिद्यानाला,","poem":1},{"lineBreak":true},{"text":"सीसरा व याबीन यांना किशोन नदीजवळ केलेस तसेच तू त्यांना कर.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ते एन-दोर येथे नष्ट झाले,","poem":1},{"lineBreak":true},{"text":"आणि ते भूमीला खत झाले.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"तू ओरेब व जेब यांच्यासारखे त्यांच्या उमरावांना कर,","poem":1},{"lineBreak":true},{"text":"जेबह व सलमुन्ना यांच्यासारखे त्यांच्या सर्व सरदारांचे कर.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ते म्हणाले, देवाची निवासस्थाने","poem":1},{"lineBreak":true},{"text":"आपण आपल्या ताब्यात घेऊ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"हे माझ्या देवा, तू त्यांना वावटळीच्या धुरळ्यासारखे,","poem":1},{"lineBreak":true},{"text":"वाऱ्यापुढील भुसासारखे तू त्यांना कर.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"अग्नी जसा वनाला जाळतो,","poem":1},{"lineBreak":true},{"text":"व ज्वाला जशी डोंगराला पेटवते.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"तसा तू आपल्या वादळाने त्यांचा पाठलाग कर,","poem":1},{"lineBreak":true},{"text":"आणि आपल्या तुफानाने त्यांना घाबरून सोड.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, त्यांची चेहरे लज्जेने भर","poem":1},{"lineBreak":true},{"text":"यासाठी की, त्यांनी तुझ्या नावाचा शोध करावा.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ते सदासर्वकाळ लज्जित व घाबरे होवोत;","poem":1},{"lineBreak":true},{"text":"ते लज्जित होऊन नष्ट होवोत.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"नंतर तू, मात्र तूच परमेश्वर,","poem":1},{"lineBreak":true},{"text":"या नावाने सर्व पृथ्वीवर परात्पर आहेस असे त्यांना कळेल.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}