{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":84,"content":[{"type":"heading","content":["देवाच्या निवासस्थानासाठी तळमळ"]},{"type":"hebrew_subtitle","content":["कोरहाच्या मुलांची स्तोत्रे"]},{"type":"verse","number":1,"content":[{"text":"हे सेनाधीश परमेश्वरा,","poem":1},{"lineBreak":true},{"text":"तू जेथे राहतो ती जागा किती लावण्यपूर्ण आहे.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"माझ्या जिवाला परमेश्वराच्या अंगणाची खूप आतुरता लागली, असून तो अतिउत्सुकही झाला आहे;","poem":1},{"lineBreak":true},{"text":"माझा जीव व देह जिवंत देवाला आरोळी मारीत आहे.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"हे सेनाधीश परमेश्वरा,","poem":1},{"lineBreak":true},{"text":"माझ्या राजा, माझ्या देवा,","poem":1},{"lineBreak":true},{"text":"तुझ्या वेद्यांजवळ चिमणीला आपले घर","poem":1},{"lineBreak":true},{"text":"आणि निळवीला आपली पिल्ले ठेवण्यासाठी कोटे सापडले आहे.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"जे तुझ्या घरात राहतात ते आशीर्वादित आहेत;","poem":1},{"lineBreak":true},{"text":"ते निरंतर तुझी स्तुती करीत राहतील.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ज्या मनुष्याचे सामर्थ्य तुझ्यात आहे,","poem":1},{"lineBreak":true},{"text":"ज्याच्या मनात सीयोनेचे राजमार्ग आहेत तो आशीर्वादित आहे.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"शोकाच्या","poem":1},{"noteId":28},{"text":"खोऱ्यातून जाताना, त्यांना पिण्याच्या पाण्याचे झरे सापडतात.","poem":1},{"lineBreak":true},{"text":"आगोटीचा पाऊस त्यांना पाण्याच्या तलावाने झाकतो.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ते सामर्थ्यापासून सामर्थ्यात जातात;","poem":1},{"lineBreak":true},{"text":"त्यातील प्रत्येकजणाला सियोनेत देवाचे दर्शन लाभते.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"हे सेनाधीश परमेश्वरा, माझी प्रार्थना ऐक;","poem":1},{"lineBreak":true},{"text":"याकोबाच्या देवा, मी जे सांगतो ते माझे ऐक.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"हे देवा, तू आमची ढाल आहेस; अवलोकन कर,","poem":1},{"lineBreak":true},{"text":"तू आपल्या अभिषिक्ताच्या मुखाकडे दृष्टी लाव.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"तुझ्या अंगणातला एक दिवस इतर ठिकाणातल्या हजार दिवसांपेक्षा उत्तम आहे;","poem":1},{"lineBreak":true},{"text":"दुष्टाईच्या तंबूत राहण्यापेक्षा माझ्या देवाच्या घराचा द्वारपाळ होणे हे मला चांगले आहे.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"कारण परमेश्वर देव आमचा सूर्य आणि ढाल आहे;","poem":1},{"lineBreak":true},{"text":"परमेश्वर अनुग्रह आणि गौरव देतो;","poem":1},{"lineBreak":true},{"text":"जे प्रामाणिकपणे चालतात त्यांना उत्तम ते दिल्यावाचून तो राहणार नाही.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"हे सेनाधीश परमेश्वरा,","poem":1},{"lineBreak":true},{"text":"जो मनुष्य तुझ्यावर भरवसा ठेवतो तो आशीर्वादित आहे.","poem":1}]}],"footnotes":[{"noteId":28,"caller":"+","text":"बाका","reference":{"chapter":84,"verse":6}}]},"thisChapterLink":"/api/mar_irv/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}