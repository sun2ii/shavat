{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":85,"content":[{"type":"heading","content":["देवाने इस्त्राएलावर दया करावी म्हणून प्रार्थना"]},{"type":"hebrew_subtitle","content":["कोरहाच्या मुलांची स्तोत्रे"]},{"type":"verse","number":1,"content":[{"text":"हे परमेश्वरा, तू आपल्या देशावर अनुग्रह दाखवला आहेस;","poem":1},{"lineBreak":true},{"text":"तू याकोबाला बंदिवासातून परत आणले आहेस.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"तू आपल्या लोकांच्या पापांची क्षमा केली आहेस.","poem":1},{"lineBreak":true},{"text":"तू त्यांची सर्व पापे झाकून टाकली आहेत.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तू आपला सर्व क्रोध काढून घेतला आहे;","poem":1},{"lineBreak":true},{"text":"आणि आमच्यावरील भयंकर क्रोधापासून मागे फिरला आहेस.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"हे आमच्या तारणाऱ्या देवा, आम्हास परत आण,","poem":1},{"lineBreak":true},{"text":"आणि आमच्यावरचा तुझा असंतोष दूर कर.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"सर्वकाळपर्यंत तू आमच्यावर रागावलेला राहशील का?","poem":1},{"lineBreak":true},{"text":"पिढ्यानपिढ्या तू रागावलेला राहशील काय?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"तुझ्या लोकांनी तुझ्याठायी आनंद करावा,","poem":1},{"lineBreak":true},{"text":"म्हणून तू आम्हास परत जिवंत करणार नाहीस का?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, तुझ्या दयेचा अनुभव आम्हास येऊ दे;","poem":1},{"lineBreak":true},{"text":"तू कबूल केलेले तारण आम्हास दे.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"परमेश्वर देव काय म्हणेल ते मी ऐकून घेईन.","poem":1},{"lineBreak":true},{"text":"कारण तो आपल्या लोकांशी व विश्वासू अनुयायींशी शांती करेल,","poem":1},{"lineBreak":true},{"text":"तरी मात्र त्यांनी मूर्खाच्या मार्गाकडे पुन्हा वळू नये.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"खचित जे त्यास भितात त्यांच्याजवळ त्याचे तारण आहे;","poem":1},{"lineBreak":true},{"text":"यासाठी आमच्या देशात वैभव रहावे.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"दया व सत्य एकत्र मिळाली आहेत;","poem":1},{"lineBreak":true},{"text":"निती आणि शांती यांनी एकमेकांचे चुंबन घेतले आहे.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"पृथ्वीतून सत्य बाहेर पडत आहे,","poem":1},{"lineBreak":true},{"text":"आणि स्वर्गातून नितिमत्व खाली पाहत आहे.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"जे उत्तम ते परमेश्वर देईल,","poem":1},{"lineBreak":true},{"text":"आणि आमची भूमी आपले पिक देईल.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"त्याच्यासमोर नितीमत्व चालेल,","poem":1},{"lineBreak":true},{"text":"आणि त्याच्या पावलांसाठी मार्ग तयार करील.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}