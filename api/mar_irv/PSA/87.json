{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"heading","content":["सीयोनेत राहण्याचा मान"]},{"type":"verse","number":1,"content":[{"text":"परमेश्वराचे नगर पवित्र पर्वतावर स्थापले आहे.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"याकोबाच्या सर्व तंबूपेक्षा परमेश्वरास","poem":1},{"lineBreak":true},{"text":"सियोनेचे द्वार अधिक प्रिय आहे.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"हे देवाच्या नगरी, तुझ्याविषयी गौरवाच्या गोष्टी सांगितल्या आहेत.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"राहाब","poem":1},{"noteId":29},{"text":"आणि बाबेल माझे अनुयायी आहेत असे मी सांगेन.","poem":1},{"lineBreak":true},{"text":"पाहा, पलिष्टी, सोर व कूश म्हणतात त्यांचा जन्म तेथलाच.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"सियोनेविषयी असे म्हणतील की, हा प्रत्येक तिच्यात जन्मला होता;","poem":1},{"lineBreak":true},{"text":"आणि परात्पर स्वतः तिला प्रस्थापित करील.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"लोकांची नोंदणी करताना,","poem":1},{"lineBreak":true},{"text":"ह्याचा जन्म तेथलाच होता असे परमेश्वर लिहील.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"गायन करणारे आणि वाद्ये वाजवणारेही म्हणतील की,","poem":1},{"lineBreak":true},{"text":"माझ्या सर्व पाण्याचे झरे तुझ्यात आहेत.”","poem":1}]}],"footnotes":[{"noteId":29,"caller":"+","text":"मिसर देश","reference":{"chapter":87,"verse":4}}]},"thisChapterLink":"/api/mar_irv/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}