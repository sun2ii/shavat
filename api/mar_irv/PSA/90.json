{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":90,"content":[{"type":"heading","content":["देवाची अक्षयता व मानवाची क्षणभंगुरता"]},{"type":"hebrew_subtitle","content":["मोशेचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"हे प्रभू, तू सर्व पिढ्यानपिढ्या","poem":1},{"noteId":33},{"lineBreak":true},{"text":"आमचे निवासस्थान आहेस.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"पर्वत अस्तित्वात येण्यापूर्वी","poem":1},{"lineBreak":true},{"text":"किंवा पृथ्वी व जग निर्माण होण्याआधीच,","poem":1},{"lineBreak":true},{"text":"अनादिकाळापासून ते अनंतकाळापर्यंत तूच देव आहेस.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"तू मनुष्यास पुन्हा मातीस मिळवतोस,","poem":1},{"lineBreak":true},{"text":"आणि तू म्हणतोस, “अहो मनुष्याच्या वंशजांनो परत या.”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"कारण हजारो वर्षे तुझ्या दृष्टीने,","poem":1},{"lineBreak":true},{"text":"कालच्या गेलेल्या दिवसासारखी,","poem":1},{"lineBreak":true},{"text":"रात्रीच्या प्रहरासारखी आहेत.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"पुराप्रमाणे तू त्यांना झाडून दूर नेतोस आणि ते निद्रेप्रमाणे क्षणिक आहेत,","poem":1},{"lineBreak":true},{"text":"सकाळी उगवणाऱ्या गवतासारखे ते आहेत.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"सकाळी ते उगवते आणि वाढते;","poem":1},{"lineBreak":true},{"text":"संध्याकाळी ते निस्तेज होते व वाळून जाते.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"खरोखर, आम्ही तुझ्या रागाने नष्ट होतो,","poem":1},{"lineBreak":true},{"text":"आणि तुझ्या कोपाने आम्ही घाबरून जातो.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"तू आमचे अपराध आपल्यापुढे ठेवले आहेत.","poem":1},{"lineBreak":true},{"text":"आमचे गुप्त पाप तुझ्या प्रकाशाच्या समक्ष ठेवले आहे.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"तुझ्या क्रोधाखालून आमचे आयुष्य निघून जाते;","poem":1},{"lineBreak":true},{"text":"आमची वर्षे उसाशाप्रमाणे त्वरेने संपून जातात.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"आमचे आयुष्य","poem":1},{"noteId":34},{"text":"सत्तर वर्षे आहे;","poem":1},{"lineBreak":true},{"text":"किंवा जर आम्ही निरोगी असलो तर ऐंशी वर्षे आहे;","poem":1},{"lineBreak":true},{"text":"पण तरी आमच्या आयुष्यातील उत्तम वर्षे समस्या आणि दु:ख यांच्या निशाणीने भरलेले आहे.","poem":1},{"lineBreak":true},{"text":"होय, ते लवकर सरते आणि आम्ही दूर उडून जातो.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"तुझ्या क्रोधाची तीव्रता कोणाला माहित आहे;","poem":1},{"lineBreak":true},{"text":"तुझी भिती बाळगण्याइतका तुझा क्रोध कोण जाणतो?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"म्हणून आम्हास आमचे आयुष्य असे","poem":1},{"lineBreak":true},{"text":"मोजण्यास शिकव की आम्ही ज्ञानाने जगण्यास शिकू.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, परत फीर, किती वेळ तू उशीर करशील?","poem":1},{"lineBreak":true},{"text":"तुझ्या सेवकावर दया कर.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"तू आपल्या दयेने आम्हास सकाळी तृप्त कर","poem":1},{"lineBreak":true},{"text":"म्हणजे आम्ही आपले सर्व दिवस हर्षाने आणि आनंदाने घालवू.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"जितके दिवस तू आम्हास पीडले त्या दिवसाच्या मानाने","poem":1},{"lineBreak":true},{"text":"आणि जितकी वर्षे आम्ही समस्येचा अनुभव घेतला त्या वर्षाच्या मानाने आम्हांला आनंदित कर.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"तुझी कृती तुझ्या सेवकांना,","poem":1},{"lineBreak":true},{"text":"तुझे वैभव त्यांच्या मुलांना बघू दे.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"प्रभू, आमचा देव याची कृपा आम्हांवर असो.","poem":1},{"lineBreak":true},{"text":"आमच्या हातच्या कामाला उन्नती दे;","poem":1},{"lineBreak":true},{"text":"खरोखर, आमच्या हातच्या कामाला उन्नती दे.","poem":1}]}],"footnotes":[{"noteId":33,"caller":"+","text":"एल-ओलाम","reference":{"chapter":90,"verse":1}},{"noteId":34,"caller":"+","text":"प्रताप","reference":{"chapter":90,"verse":10}}]},"thisChapterLink":"/api/mar_irv/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}