{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":91,"content":[{"type":"heading","content":["सर्वसामर्थ्याच्या पंखांखाली आश्रय"]},{"type":"verse","number":1,"content":[{"text":"जो परात्पराच्या आश्रयात राहतो,","poem":1},{"lineBreak":true},{"text":"तो सर्वसामर्थ्याच्या सावलीत राहील.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"मी परमेश्वराविषयी म्हणेन की, “तो माझा आश्रय आणि माझा किल्ला आहे,","poem":1},{"lineBreak":true},{"text":"माझा देव, ज्यावर मी विश्वास ठेवतो.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"कारण तो तुला पारध्याच्या पाशातून","poem":1},{"lineBreak":true},{"text":"आणि नाश करणाऱ्या मरीपासून तुला सोडवील.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"तो तुला आपल्या पंखानी झाकील,","poem":1},{"lineBreak":true},{"text":"आणि तुला त्याच्या पंखाखाली आश्रय मिळेल.","poem":1},{"lineBreak":true},{"text":"त्याचे सत्य ढाल व कवच आहे.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"रात्रीच्या दहशतीचे भय,","poem":1},{"lineBreak":true},{"text":"किंवा दिवसा उडणाऱ्या बाणाला,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"किंवा अंधारात फिरणाऱ्या मरीला","poem":1},{"lineBreak":true},{"text":"किंवा भर दुपारी नाश करणाऱ्या पटकीला तू भिणार नाहीस.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तुझ्या एका बाजूला हजार पडले,","poem":1},{"lineBreak":true},{"text":"आणि तुमच्या उजव्या हातास दहा हजार पडले,","poem":1},{"lineBreak":true},{"text":"पण तरी ती तुझ्याजवळ येणार नाही.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"तू मात्र निरीक्षण करशील,","poem":1},{"lineBreak":true},{"text":"आणि दुष्टांना झालेली शिक्षा पाहशील.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"कारण परमेश्वर माझा आश्रय आहे","poem":1},{"lineBreak":true},{"text":"असे म्हणून तू परात्परालासुद्धा आपले आश्रयस्थान केले आहेस.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"तुमच्यावर वाईट मात करणार नाही.","poem":1},{"lineBreak":true},{"text":"तुमच्या घराजवळ कोणतीही पिडा येणार नाही.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"कारण तुझ्या सर्व मार्गात तुझे रक्षण करण्याची,","poem":1},{"lineBreak":true},{"text":"तुझ्याविषयी तो आपल्या दिव्यदूतांना आज्ञा देईल.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ते तुला आपल्या हातांनी उचलून धरतील","poem":1},{"lineBreak":true},{"text":"अशासाठी की, तू घसरून दगडावर पडू नये.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"तू आपल्या पायाखाली सिंह आणि नागाला चिरडून टाकशील;","poem":1},{"lineBreak":true},{"text":"तू सिंह व अजगर ह्याला तुडवीत चालशील.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"तो माझ्याशी निष्ठावान आहे, म्हणून मी त्यास सोडवीन;","poem":1},{"lineBreak":true},{"text":"मी त्यास सुरक्षित ठेवीन कारण तो माझ्याशी प्रामाणिक आहे.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"जेव्हा तो माझा धावा करील तेव्हा मी त्यास उत्तर देईन;","poem":1},{"lineBreak":true},{"text":"संकटसमयी मी त्याच्याबरोबर राहीन;","poem":1},{"lineBreak":true},{"text":"मी त्यास विजय देईन आणि त्याचा सन्मान करीन.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"मी त्यास दीर्घायुष्य देईन,","poem":1},{"lineBreak":true},{"text":"आणि त्यास माझे तारण दाखवीन.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}