{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":92,"content":[{"type":"heading","content":["देवाच्या चांगुलपणाबद्दल उपकारस्तुती"]},{"type":"hebrew_subtitle","content":["शब्बाथ दिवसाचे स्तोत्र"]},{"type":"verse","number":1,"content":[{"text":"परमेश्वराची उपकारस्तुती करणे","poem":1},{"lineBreak":true},{"text":"आणि हे परात्परा, तुझ्या नावाला स्तुती गाणे ही चांगली गोष्ट आहे.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"सकाळी तुझे वात्सल्य,","poem":1},{"lineBreak":true},{"text":"आणि प्रत्येकरात्री तुझ्या सत्यतेबद्दल निवेदन करणे.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"दहा तारांचे वाद्य, वीणेवर","poem":1},{"lineBreak":true},{"text":"आणि सतारीवर संगीत वाजवणे चांगले आहे.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"कारण हे परमेश्वरा, तू आपल्या कृतीने मला हर्षित केले आहे.","poem":1},{"lineBreak":true},{"text":"तुझ्या हातच्या कृत्यांविषयी मी आनंदाने गाईन.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, तुझी कृत्ये किती महान आहेत,","poem":1},{"lineBreak":true},{"text":"तुझे विचार फार गहन आहेत.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"पशुतुल्य मनुष्यास ते कळत नाहीत,","poem":1},{"lineBreak":true},{"text":"किंवा मूर्खाला ती समजत नाहीत,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"दुष्ट गवताप्रमाणे उगवले,","poem":1},{"lineBreak":true},{"text":"आणि सर्व वाईट करणारे भरभराटीस आले;","poem":1},{"lineBreak":true},{"text":"तरीही त्यांचा कायमचा शेवटचा नाश ठरलेला आहे.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"परंतु हे परमेश्वरा, तू तर सदासर्वकाळ राज्य करशील.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, खरोखर, तुझ्या शत्रूंकडे पाहा;","poem":1},{"lineBreak":true},{"text":"सर्व वाईट करणारे विखरले आहेत.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"पण तू माझे शिंग रानबैलाच्या शिंगाप्रमाणे उंच केले आहेस;","poem":1},{"lineBreak":true},{"text":"मला ताज्या तेलाचा अभिषेक झाला आहे.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"माझ्या डोळ्यांनी माझ्या शत्रूंचा नाश पाहिला आहे;","poem":1},{"lineBreak":true},{"text":"जे दुष्कर्मी माझ्यावर उठतात त्यांच्याविषयी माझ्या कानांनी ऐकले आहे.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"नितीमान खजुरीसारखा समृद्ध होईल,","poem":1},{"lineBreak":true},{"text":"तो लबानोनावरील गंधसरूसारखा वाढेल.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"जे परमेश्वराच्या घरात लावलेल्या वृक्षासारखे आहेत;","poem":1},{"lineBreak":true},{"text":"ते आपल्या देवाच्या अंगणात झपाट्याने वाढतील.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"वृद्धपणातही ते फळ देत राहतील;","poem":1},{"lineBreak":true},{"text":"ते टवटवीत आणि हिरवे राहतील.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"हे यासाठी की, परमेश्वर सरळ आहे हे त्यांनी जाहीर करावे;","poem":1},{"lineBreak":true},{"text":"तो माझा खडक आहे, आणि त्याच्याठायी काहीच अन्याय नाही.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}