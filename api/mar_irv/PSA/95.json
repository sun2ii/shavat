{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"heading","content":["उपकारस्मरणाचे गीत"]},{"type":"verse","number":1,"content":[{"text":"याहो या, आपण परमेश्वराचा जयजयकार करू;","poem":1},{"lineBreak":true},{"text":"आपल्या तारणाचा खडक त्याचा हर्षाने जयजयकार करू.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"उपकारस्तुती करीत त्याच्या सान्निध्यात प्रवेश करू;","poem":1},{"lineBreak":true},{"text":"स्तुतीचे स्तोत्रे गात त्याचा जयजयकार करू.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"कराण परमेश्वर महान देव आहे","poem":1},{"lineBreak":true},{"text":"आणि सर्व देवांहून तो श्रेष्ठ महान राजा आहे.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"त्याच्या हाती पृथ्वीची खोल स्थाने आहेत;","poem":1},{"lineBreak":true},{"text":"पर्वताची उंच शिखरेही त्याचीच आहेत.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"समुद्र त्याचाच आहे, कारण त्यानेच तो निर्माण केला,","poem":1},{"lineBreak":true},{"text":"आणि त्याच्या हाताने कोरडी भूमी घडवली गेली.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"याहो या, आपला निर्माणकर्ता परमेश्वर यापुढे गुडघे टेकू,","poem":1},{"lineBreak":true},{"text":"त्याची उपासना करू, त्यास नमन करू;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"कारण तो आपला देव आहे,","poem":1},{"lineBreak":true},{"text":"आणि आपण त्याच्या कुरणातील लोक आणि त्याच्या हातातील मेंढरे आहोत.","poem":1},{"lineBreak":true},{"text":"आज जर तुम्ही त्याची वाणी ऐकाल तर किती बरे होईल.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"मरीबा","poem":1},{"noteId":36},{"text":"येथल्याप्रमाणे किंवा मस्सा","poem":1},{"noteId":37},{"text":"च्या दिवशी रानात केले","poem":1},{"lineBreak":true},{"text":"तसे आपली मने कठीण करू नका,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"तेव्हा तुमच्या वडिलांनी माझ्या अधिकाराला आव्हान दिले,","poem":1},{"lineBreak":true},{"text":"आणि जरी त्यांनी माझी कृती पाहिली होती, तरी माझ्या सहनशीलतेची परीक्षा केली.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"चाळीस वर्षे त्या पिढीवर मी रागावलो,","poem":1},{"lineBreak":true},{"text":"आणि म्हणालो, हे बहकलेल्या मनाचे आहेत;","poem":1},{"lineBreak":true},{"text":"त्यांनी माझे मार्ग जाणले नाहीत","poem":1},{"noteId":38},{"text":".","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"म्हणून मी आपल्या रागात शपथ वाहिली की,","poem":1},{"lineBreak":true},{"text":"हे माझ्या विसाव्यात कधीही प्रवेश करणार नाहीत.","poem":1}]}],"footnotes":[{"noteId":36,"caller":"+","text":"कलह","reference":{"chapter":95,"verse":8}},{"noteId":37,"caller":"+","text":"परीक्षा","reference":{"chapter":95,"verse":8}},{"noteId":38,"caller":"+","text":"त्यांनी माझ्या आज्ञा पाळल्या नाहीत","reference":{"chapter":95,"verse":10}}]},"thisChapterLink":"/api/mar_irv/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}