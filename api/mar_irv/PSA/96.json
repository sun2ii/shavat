{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":96,"content":[{"type":"heading","content":["उपकारस्तुतीचे गीत"]},{"type":"verse","number":1,"content":[{"text":"अहो, परमेश्वरास नवीन गीत गा;","poem":1},{"lineBreak":true},{"text":"हे सर्व पृथ्वी, परमेश्वराचे गुणगान कर.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"परमेश्वरास गाणे गा, त्याच्या नावाला धन्यवाद द्या;","poem":1},{"lineBreak":true},{"text":"दिवसेंदिवस त्याच्या तारणाची घोषणा करा.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"राष्ट्रात त्याचे गौरव,","poem":1},{"lineBreak":true},{"text":"त्याच्या आश्चर्यकारक कृत्यांची सर्व राष्ट्रात जाहीर करा.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"कारण परमेश्वर महान आणि परमस्तुत्य आहे.","poem":1},{"lineBreak":true},{"text":"सर्व दुसऱ्या देवांपेक्षा त्याचे भय धरणे योग्य आहे.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"कारण राष्ट्रांचे सर्व देव केवळ मूर्ती आहेत, पण परमेश्वराने तर स्वर्ग निर्माण केला.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"वैभव व ऐश्वर्य त्याच्या सान्निध्यात आहेत.","poem":1},{"lineBreak":true},{"text":"सामर्थ्य आणि सौंदर्य त्याच्या पवित्रस्थानी आहेत.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"अहो तुम्ही लोकांच्या कुळांनो, परमेश्वराचे गौरव करा;","poem":1},{"lineBreak":true},{"text":"परमेश्वराचे गौरव करा आणि त्याचे सामर्थ्य सांगा.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"परमेश्वराच्या नावामुळे त्याचा गौरव करा.","poem":1},{"lineBreak":true},{"text":"अर्पण घेऊन त्याच्या अंगणात या.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"पवित्रतेने सुशोभित होऊन परमेश्वरास नमन करा.","poem":1},{"lineBreak":true},{"text":"हे सर्व पृथ्वी, त्याच्यापुढे कंपायमान हो.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"राष्ट्रांमधील लोकांस सांगा की, परमेश्वर राज्य करतो.","poem":1},{"lineBreak":true},{"text":"जगसुद्धा स्थिर स्थापिलेले आहे; ते हलविता येणे अशक्य आहे.","poem":1},{"lineBreak":true},{"text":"तो सरळपणे लोकांचा न्याय करील.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"आकाश आनंदित होवो, आणि पृथ्वी आनंदोत्सव करो;","poem":1},{"lineBreak":true},{"text":"समुद्र आणि त्यातील सर्वकाही गर्जना करोत.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"शेत आणि त्यातील सर्वकाही आनंदोत्सव करोत.","poem":1},{"lineBreak":true},{"text":"मग जंगलातील सर्व वृक्ष आनंदाने गजर करतील.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"सगळी निर्मिती परमेश्वरापुढे आनंद करो, कारण तो येत आहे;","poem":1},{"lineBreak":true},{"text":"पृथ्वीचा न्याय करायला तो येत आहे;","poem":1},{"lineBreak":true},{"text":"तो न्यायीपणाने जगाचा","poem":1},{"lineBreak":true},{"text":"व त्याच्या सत्यतेने लोकांचा न्याय करील.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}