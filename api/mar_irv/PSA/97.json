{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"heading","content":["देवाचे राज्य व सामर्थ्य"]},{"type":"verse","number":1,"content":[{"text":"परमेश्वर राज्य करतो; पृथ्वी आनंदित होवो.","poem":1},{"lineBreak":true},{"text":"अनेक द्वीपसमूह आनंदित होवो.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ढग आणि काळोख त्याच्याभोवती आहेत.","poem":1},{"lineBreak":true},{"text":"निती व न्याय त्याच्या सिंहासनाचा पाया आहेत","poem":1},{"noteId":39},{"text":".","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"अग्नी त्याच्यापुढे चालतो,","poem":1},{"lineBreak":true},{"text":"आणि प्रत्येक बाजूने त्याच्या शत्रूंना नष्ट करून टाकतो.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"त्याच्या विजांनी जग प्रकाशित केले;","poem":1},{"lineBreak":true},{"text":"पृथ्वी हे पाहून थरथर कापली.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"परमेश्वरासमोर, सर्व पृथ्वीच्या प्रभूसमोर","poem":1},{"lineBreak":true},{"text":"पर्वत मेणासारखे वितळले.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"आकाशाने, त्याचा न्याय जाहीर केला,","poem":1},{"lineBreak":true},{"text":"आणि सर्व राष्ट्रांनी त्याचे वैभव पाहिले.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"जे कोरीव मूर्तीची पूजा करतात,","poem":1},{"lineBreak":true},{"text":"जे मूर्तीचा अभिमान बाळगतात ते सर्व लज्जित झाले.","poem":1},{"lineBreak":true},{"text":"अहो सर्व देवहो! त्याच्यासमोर नमन करा.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"सियोनेने हे ऐकले आणि आनंदित झाली,","poem":1},{"lineBreak":true},{"text":"कारण हे परमेश्वरा, तुझ्या न्यायामुळे","poem":1},{"lineBreak":true},{"text":"यहूदाच्या नगरांनी आनंद केला.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"कारण हे परमेश्वरा, सर्व पृथ्वीवर तू परात्पर आहेस.","poem":1},{"lineBreak":true},{"text":"तू सर्व देवापेक्षा खूपच उंचावलेला आहेस.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"जे तुम्ही परमेश्वरावर प्रीती करता, ते तुम्ही वाईटाचा द्वेष करा,","poem":1},{"lineBreak":true},{"text":"तो आपल्या भक्तांच्या जीवाचे रक्षण करतो,","poem":1},{"lineBreak":true},{"text":"आणि तो त्यास दुष्टांच्या हातातून सोडवतो.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"नितीमानासाठी प्रकाश","poem":1},{"lineBreak":true},{"text":"आणि जे सरळ अंतःकरणाचे आहेत त्यांच्यासाठी हर्ष पेरला आहे.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"अहो नितीमानांनो, परमेश्वराठायी आनंदी व्हा.","poem":1},{"lineBreak":true},{"text":"त्याच्या पवित्र नावाला धन्यवाद द्या.","poem":1}]}],"footnotes":[{"noteId":39,"caller":"+","text":"परमेश्वर नीतीने आणि न्यायाने राज्य करतो","reference":{"chapter":97,"verse":2}}]},"thisChapterLink":"/api/mar_irv/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}