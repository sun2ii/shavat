{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"heading","content":["देवाच्या नीतिमत्त्वाबद्दल स्तुती"]},{"type":"verse","number":1,"content":[{"text":"परमेश्वरास नवीन गीत गा,","poem":1},{"lineBreak":true},{"text":"कारण त्याने आश्चर्यकारक गोष्टी केल्या आहेत;","poem":1},{"lineBreak":true},{"text":"त्याने आपल्या उजव्या हाताने आणि आपल्या पवित्र बाहूने आम्हास विजय दिला आहे.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"परमेश्वराने आपले तारण कळवले आहे;","poem":1},{"lineBreak":true},{"text":"त्याने सर्व राष्ट्रांच्यासमोर आपले न्यायीपण उघडपणे दाखवले आहे.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"त्याने इस्राएलाच्या घराण्यासाठी आपली निष्ठा आणि विश्वासाचा करार यांची आठवण केली;","poem":1},{"lineBreak":true},{"text":"पृथ्वीच्या सर्व सीमांनी आमच्या देवाचा विजय पाहिला आहे.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"अहो सर्व पृथ्वी, परमेश्वराचा जयजयकार करा;","poem":1},{"lineBreak":true},{"text":"उच्च स्वराने आणि आनंदाने गा, स्तुतिगायन करा.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"परमेश्वराचे स्तुतिगान वीणेवर करा,","poem":1},{"lineBreak":true},{"text":"वीणेवर मधुर स्वराने गायन करा.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"कर्णा आणि शिंगाच्या आवाजाने,","poem":1},{"lineBreak":true},{"text":"परमेश्वर राजासमोर आनंदाने जयघोष करा.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"समुद्र आणि त्यातील प्रत्येकगोष्ट गर्जना करोत,","poem":1},{"lineBreak":true},{"text":"जग व त्यामध्ये राहणारे हर्षनाद करोत.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"नद्या टाळ्या वाजवोत,","poem":1},{"lineBreak":true},{"text":"आणि पर्वत हर्षनाद करोत.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"परमेश्वर पृथ्वीचा न्याय करण्यास येत आहे;","poem":1},{"lineBreak":true},{"text":"तो न्यायीपणाने जगाचा","poem":1},{"lineBreak":true},{"text":"आणि सरळपणाने राष्ट्रांचा न्याय करील.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}