{"translation":{"id":"mar_irv","name":"इंडियन रीवाइज्ड वर्जन (IRV) - मराठी","website":"https://ebible.org/Scriptures/details.php?id=mar","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mar","licenseNotes":null,"shortName":"IRV","englishName":"Marathi Indian Revised Version Bible","language":"mar","textDirection":"ltr","sha256":"a3799382523a07fc3be71e92b17696c7bc0a0c2f13490d22c7cb3a328601b32e","availableFormats":["json"],"listOfBooksApiLink":"/api/mar_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"मराठी","languageEnglishName":"Marathi"},"book":{"id":"PSA","translationId":"mar_irv","name":"स्तोत्रसंहिता","commonName":"स्तोत्रसंहिता","title":"स्तोत्रसंहिता","order":19,"numberOfChapters":150,"sha256":"156ba4220ee76b683d4f1772fa77bab92ac54f1b497b1651383bc4a75c8ca06d","firstChapterNumber":1,"firstChapterApiLink":"/api/mar_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mar_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"heading","content":["परमेश्वर इस्त्राएलाशी विश्वासू आहे"]},{"type":"verse","number":1,"content":[{"text":"परमेश्वर राज्य करतो; राष्ट्रे कंपित होवोत.","poem":1},{"lineBreak":true},{"text":"तो करुबांच्यावर विराजमान आहे; पृथ्वी थरथर कापो.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"सियोनात परमेश्वर महान आहे;","poem":1},{"lineBreak":true},{"text":"तो सर्व राष्ट्रांच्यावर उंच आहे.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ते तुझे महान आणि भयचकीत करणाऱ्या नावाची स्तुती करोत.","poem":1},{"lineBreak":true},{"text":"तो पवित्र आहे.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"राजा बलवान आहे आणि तो न्यायप्रिय आहे.","poem":1},{"lineBreak":true},{"text":"तू सरळपणा स्थापिला आहे;","poem":1},{"lineBreak":true},{"text":"तू याकोबात न्याय व निती अस्तित्वात आणली आहेस.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"परमेश्वर, आपला देव त्याची स्तुती करा","poem":1},{"lineBreak":true},{"text":"आणि त्याच्या पदासनाजवळ त्याची उपासना करा.","poem":1},{"lineBreak":true},{"text":"तो पवित्र आहे.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"त्याच्या याजकामध्ये मोशे आणि अहरोन हे होते,","poem":1},{"lineBreak":true},{"text":"आणि त्यास प्रार्थना करणाऱ्यांपैकी शमुवेल हा होता.","poem":1},{"lineBreak":true},{"text":"त्यांने परमेश्वराची प्रार्थना केली आणि त्याने त्यांना उत्तर दिले.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"तो त्यांच्याशी मेघस्तंभातून बोलला.","poem":1},{"lineBreak":true},{"text":"त्यांनी त्याच्या आज्ञा","poem":1},{"lineBreak":true},{"text":"आणि त्याचे नियम पाळले.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"हे परमेश्वरा, आमच्या देवा, तू त्यांना उत्तर दिलेस.","poem":1},{"lineBreak":true},{"text":"तू त्यांना क्षमा करणारा देव आहेस","poem":1},{"lineBreak":true},{"text":"तरी त्यांच्या पापमय कृत्याबद्दल त्यांना शिक्षा करीत होतास.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"परमेश्वर, आपला देव ह्याची स्तुती करा,","poem":1},{"lineBreak":true},{"text":"आणि त्याच्या पवित्र डोंगरावर उपासना करा,","poem":1},{"lineBreak":true},{"text":"कारण परमेश्वर आमचा देव पवित्र आहे.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mar_irv/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mar_irv/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mar_irv/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}