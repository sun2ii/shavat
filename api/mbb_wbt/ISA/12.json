{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"ISA","translationId":"mbb_wbt","name":"Isaias","commonName":"Isaias","title":"Isaias","order":23,"numberOfChapters":66,"sha256":"d133fd5f2ac6d4a897156898dcb9b1f89b46423f7afca49190b54a967db94732","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mbb_wbt/ISA/66.json","totalNumberOfVerses":1280},"chapter":{"number":12,"content":[{"type":"heading","content":["Kanta te Kebpeselamat"]},{"type":"verse","number":1,"content":["Emun egkeume en haazà he andew megkanta kew te:",{"text":"“Nengazen, edeliǥen ku sikew.","poem":1},{"lineBreak":true},{"text":"Nepeukan a kenikew, piru ǥuntaan naawè en is pauk nu,","poem":1},{"lineBreak":true},{"text":"ne edlipeyen a kenikew.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sikew Megbevayà, iyan ka menluluwas ku.","poem":1},{"lineBreak":true},{"text":"Edsarig a kenikew ne kenà a egkahandek.","poem":1},{"lineBreak":true},{"text":"Iyan ka, Nengazen, mibeǥey kedì te zesen,","poem":1},{"lineBreak":true},{"text":"ne iyan ka egkentahan ku.","poem":1},{"lineBreak":true},{"text":"Iyan ka midlibri kedì.”","poem":1}]},{"type":"verse","number":3,"content":["Iring te ebpekeveǥey te kelipey is wahig he meǥenew te egkemezahan, ne egkelipey kew ke edluwasen kew en te Nengazen."]},{"type":"verse","number":4,"content":["Emun egkeuma en haazà he andew, ne egkanta kew te:",{"text":"“Deliǥa niw is Nengazen!","poem":1},{"lineBreak":true},{"text":"Ezapa niw sikandin!","poem":1},{"lineBreak":true},{"text":"Tudtula niw ziyà te menge etew is menge vaal zin.","poem":1},{"lineBreak":true},{"text":"Penudtul kew he ereg sikandin he edeliǥen.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kentahi niw is Nengazen su ǥeina te egkein-in-inuwan is menge mibeelen din. Ipetueni niw heini ziyà te tivuuk he kelibutan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ugyab kew wey megkanta te kelipey, is menge etew te Jerusalem.","poem":1},{"lineBreak":true},{"text":"Su mekeǥeǥehem is Waǥas he Megbevayà te Israel he iyan duma niw.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}