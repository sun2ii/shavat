{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":1,"content":[{"type":"heading","content":["Is Kegkezeyzey"]},{"type":"verse","number":1,"content":[{"text":"Deyzey is etew he kenà ebpemineg te penurù te menge lalung,","poem":1},{"lineBreak":true},{"text":"wey kenà ed-iring te ebeelan te menge mekesesalà,","poem":1},{"lineBreak":true},{"text":"wey kenà ebpekiduma kandan he ed-undaunda te Megbevayà.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kekenà, iyan mulà kandin he igkelipey is kedtuman te menge penurù te Nengazen,","poem":1},{"lineBreak":true},{"text":"ne iyan heini ebpurungan din egngunngunua te maandew wey te mezukilem.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Iring sikandin te kayu he ziyà ipemula te veyvey te wahig","poem":1},{"lineBreak":true},{"text":"ne ebpemeǥas sikandin dutun te timpu te tipemeǥas,","poem":1},{"lineBreak":true},{"text":"ne kenà egkeǥangu is menge zahun din.","poem":1},{"lineBreak":true},{"text":"Is etew he iring kayi, ed-uswag diyà te menge vaal zin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Piru kenà mulà iring kayi is lalung he menge etew,","poem":1},{"lineBreak":true},{"text":"kekenà, iring sikandan te ukap he idlayap te keramag su wazè dan pulus.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Umbe te andew te kedhukum, edsilutan sikandan te Megbevayà","poem":1},{"lineBreak":true},{"text":"ne kenà sikandan ebpeketampu te menge metazeng.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Su egiyahan te Nengazen is menge metazeng,","poem":1},{"lineBreak":true},{"text":"piru is menge ulaula te menge lalung iyan ed-uwit kandan diyà te kezeetan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}