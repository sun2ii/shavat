{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":100,"content":[{"type":"heading","content":["Kanta te Kedalig te Nengazen"]},{"type":"verse","number":1,"content":[{"text":"Sikiyu is menge etew kayi te tivuuk he kelibutan,","poem":1},{"lineBreak":true},{"text":"ugyab kew te kegkelipey tenged te Nengazen.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Silbiyi niw is Nengazen duma is kelipey.","poem":1},{"lineBreak":true},{"text":"Uvey kew ziyà te kandin he egkanta te kegkelipey.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kilelaa niw he Megbevayà is Nengazen!","poem":1},{"lineBreak":true},{"text":"Iyan sikandin midlimbag kenitew, ne ǥaked kiw zin.","poem":1},{"lineBreak":true},{"text":"Menge etew kiw zin ne iring kiw te menge kerehidu he mid-elimahan din.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Seled kew ziyà te valey zin duma is kedalig wey kebpeselamat.","poem":1},{"lineBreak":true},{"text":"Deliǥa niw wey peselemati niw sikandin.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Su meupiya is Nengazen;","poem":1},{"lineBreak":true},{"text":"wazà pidtemanan te ǥaǥew zin,","poem":1},{"lineBreak":true},{"text":"ne ebpedayun is kebmetinumanen din te taman te taman.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}