{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":11,"content":[{"type":"heading","content":["Kedsarig te Nengazen"]},{"type":"verse","number":1,"content":[{"text":"Diyà a te Nengazen edhangyù he kelesaǥi e zin.","poem":1},{"lineBreak":true},{"text":"Ne maan is egkaǥi kew kayi te kedì te,","poem":1},{"lineBreak":true},{"text":"“Pelaǥuy ka iring te tagbis pehendiyà te menge vuvungan,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"su zutun te merusirem edhingaten en te menge mezaat he etew is menge panè dan,","poem":1},{"lineBreak":true},{"text":"su ebpenaan dan en is menge etew he edtinazeng.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wazè en egkehimu te menge metazeng emun naawè en diyà te inged is metazeng he kukuman.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Diyà is Nengazen ed ubpà te segradu he valey zin;","poem":1},{"lineBreak":true},{"text":"diyà te langit is pinuuwè din te kedhadì.","poem":1},{"lineBreak":true},{"text":"Ed-ahaan din wey edsusiyen din is langun he menge etew.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Edsusiyen din is menge metazeng wey is menge lalung he menge etew.","poem":1},{"lineBreak":true},{"text":"Ne egkeepesan din is menge mesipala.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ebpeuzanan din te egkeregreg he menge vaǥa wey esupri is menge lalung he etew;","poem":1},{"lineBreak":true},{"text":"ne edsilutan din sikandan pinaaǥi te meinit he keramag he ebpekelupa kandan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Su metazeng is Nengazen ne iyan igkelipey zin is metazeng he menge vaal.","poem":1},{"lineBreak":true},{"text":"Umbe, is etew he edtinazeng ebpekeuvey ziyà te etuvangan din.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}