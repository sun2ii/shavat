{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":113,"content":[{"type":"heading","content":["Is Kedeliǥa te Keupiya te Nengazen"]},{"type":"verse","number":1,"content":[{"text":"Deliǥa is Nengazen!","poem":1},{"lineBreak":true},{"text":"Sikiyu is menge etew te Nengazen he menge suluǥuen din, deliǥa niw sikandin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Berakat he zeliǥa sikandin guntaan wey taman te taman.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ebpuun te edsilaan pehendiyà te edsenlepan is langun he menge etew edalig te Nengazen.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Edhedian te Nengazen is langun he menge nasyun,","poem":1},{"lineBreak":true},{"text":"ne kenà egkerepengan is kegkemekeǥeǥehem din.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wazà iring te Nengazen he Megbevayè tew he ebpimpinuu ziyà te pinuuwè din te kedhadì diyà te zivavew he utew metikang.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Edungul sikandin te ked-ahà te langit wey kelibutan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Inggaun din te kelised is menge egkaayuayu wey menge pubri.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ebeǥayan din daan sikandan te zengeg duma te dezekelà is dengeg duen te menge etew zin.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Edlipayen din is bahi he kenà ebpekaanak diyà te ubpeey zin pinaaǥi te kebeǥayi zin kandin te menge anak.","poem":1},{"lineBreak":true},{"text":"Deliǥa is Nengazen!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}