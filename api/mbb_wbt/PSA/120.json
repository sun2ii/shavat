{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":120,"content":[{"type":"heading","content":["Ampù para te Kebuyù te Tavang te Megbevayà"]},{"type":"verse","number":1,"content":[{"text":"Dutun te kedlised ku, mid-umew ku is Nengazen","poem":1},{"lineBreak":true},{"text":"ne midtavak e zin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nengazen, libriya a te kezeetan he edhimuwen te menge teruen wey menge limbungan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Sikiyu is menge limbungan, hengkey vuwa is idsilut te Megbevayà keniyu?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Edsilutan kew zin pinaaǥi te kegkepenaa keniyu te sundaru te midlangga he vesut.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mekehizuhizu a su nekeubpà a zuma keniyu te iring kezaat te menge meǥinged diyà te Meshec wey Kedar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Neuǥet en is ked-ubpè ku zuma keniyu te menge etew he kenà egkesuat te kelinew.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Egkesuat a te kelinew piru emun edhisgut a mehitenged kayi, ne tebek mulà is keniyu he egkesuatan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}