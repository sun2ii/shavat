{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":122,"content":[{"type":"heading","content":["Is Kedeliǥa te Jerusalem"]},{"type":"verse","number":1,"content":[{"text":"Nelipey a hein migkeǥiyan e zan te, “Edhendiyè kiw te valey te Nengazen.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ne ǥuntaan kayi key en mekehitindeg te pultahan te Jerusalem!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Is Jerusalem sevaha he inged he meupiya wey melig-en is kebenguna zuen.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kayi ebpevayà is menge tribu te Israel te kedalig te Nengazen,","poem":1},{"lineBreak":true},{"text":"su iyan heini insuǥù din kandan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kayi te Jerusalem edhimuwa te menge hadì he menge kevuwazan ni David is husayen.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ampù kew para te meupiya he kebpekesavuk te menge etew ziyà te Jerusalem pinaaǥi te kegkaǥi te,","poem":1},{"lineBreak":true},{"text":"“Berakat he mebmeuswaǥen is menge etew he mibmahal zan heini he inged.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Berakat he melinawen wey meupiya is kebpekesavuk diyà te seled te Jerusalem wey te menge melig-en he vahin kayi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Para te keupiyaanan te menge kezuzumahi ku wey menge emiǥu ku, egkaǥi a te,","poem":1},{"lineBreak":true},{"text":"“Berakat he meupiya is kebpekesavuk te Jerusalem.”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Para te keupiyaanan te valey te Nengazen he Megbevayè tew,","poem":1},{"lineBreak":true},{"text":"ed-ampù a he med-uswag is Jerusalem.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}