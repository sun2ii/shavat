on","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}