{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":124,"content":[{"type":"heading","content":["Is Megbevayà Menlelavan te menge Etew Zin"]},{"type":"verse","number":1,"content":[{"text":"Emun wazè kiw levani te Nengazen, hengkey vuwa is egkehitavù kenitew?","poem":1},{"lineBreak":true},{"text":"Tavak kew is menge tig-Israel!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Emun wazè kiw levani te Nengazen hein midsurung kiw te menge kuntada tew,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"mibpenhimetayan kiw zan en geina tenged te utew zan kegkepeuki kenitew.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Neiring kiw en pezem te naanud te zalem etawa nelened te meseleg he wahig.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dait he edeliǥen is Nengazen, su wazè din ituǥut he zèdeeti kiw te menge kuntada tew he henduen be te menge langgam he zumezaas.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nekepelaǥuy kiw iring te tagbis he nelitag he nekaawà su merunut en is tali.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Is tavang kenitew ne ziyà ebpuun te Nengazen he iyan mibaal te langit wey is kelibutan.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":7}