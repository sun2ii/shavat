{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":125,"content":[{"type":"heading","content":["Is Kebpekesiguru te menge Etew te Megbevayà"]},{"type":"verse","number":1,"content":[{"text":"Is menge etew he edsarig te Megbevayà ne iring te Buvungan he Zion he kenà egkehuyung,","poem":1},{"lineBreak":true},{"text":"kekenà, kenà egkaawà te wazà pidtemanan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Iring te nehimu he pengalang te Jerusalem is menge vuntud he nekeliǥuy kayi he inged,","poem":1},{"lineBreak":true},{"text":"is Nengazen iyan pengalang te menge etew zin guntaan wey taman te taman.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kenè din idtugut he ebpedayun is kedumala te menge lalung diyà te tanà te menge metazeng,","poem":1},{"lineBreak":true},{"text":"su kela ke mekevaal zaan te mezaat is menge metazeng.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nengazen, himuwa nu is meupiya ziyà te meupiya he menge etew, he hustu is paaǥi zan te kebpengungubpaan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Piru siluti nu zuma te menge lalung is menge etew nu he edsunud te mezaat he vetasan.","poem":1},{"lineBreak":true},{"text":"Berakat he meupiya is kebpekesavuk te menge etew te Israel!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}