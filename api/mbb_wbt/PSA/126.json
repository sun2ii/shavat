{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":126,"content":[{"type":"heading","content":["Ampù para te Keluwasan"]},{"type":"verse","number":1,"content":[{"text":"Hein impeuman ipeuswag te Nengazen is Zion, henduen be te teǥeinep dà heini.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nemen-engit kiw wey migkanta kiw te kegkelipey.","poem":1},{"lineBreak":true},{"text":"Ne zutun migkaǥi is menge etew ziyà te zuma he menge nasyun te,","poem":1},{"lineBreak":true},{"text":"“Mibaal is Nengazen diyà te kandan te menge vaal he nezumahan te zekelà he ǥehem.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tutuu he mibaal is Nengazen te menge vaal he nezumahan te zekelà he ǥehem kayi te kenitew,","poem":1},{"lineBreak":true},{"text":"ne utew kiw zutun nengelipey.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nengazen, ilikù nu is meupiya he kebpekesavuk dey","poem":1},{"lineBreak":true},{"text":"iring te nemezahan he wahig he newehiǥan en maan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Berakat he sikan is nekesineǥew hein timpu te ked-ezek din, ne mebmelipayen emun edraǥun en.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Is midhipanew he nekesineǥew, he ed-uwit te venì he id-ezek, mekeulì sikandin he egkelipey is ed-uwit te neraǥun din.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}