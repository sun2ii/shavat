{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":127,"content":[{"type":"heading","content":["Kedalig te Keupiya te Megbevayà"]},{"type":"verse","number":1,"content":[{"text":"Emun kenà edtavang is Nengazen te kedtukud te valey,","poem":1},{"lineBreak":true},{"text":"ne kenà ebpulus is kahaǥù te midtukud kayi.","poem":1},{"lineBreak":true},{"text":"Emun kenà ebentayan te Nengazen is inged,","poem":1},{"lineBreak":true},{"text":"ne kenà ebpulus is kebentayi kayi te menge vantey.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Emun kenà edtavang is Nengazen, wazà daan pulus te kedhaǥù te kedsayu ked-enew wey is kedlapus te kedterebahu para zuen egkekaan.","poem":1},{"lineBreak":true},{"text":"Su iyan is Nengazen ebeǥey te menge kinahanglan te menge etew he mibmahal zin, minsan nekelipezeng sikandan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Is menge anak beǥey wey gasa he ebpuun te Nengazen.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Is amey he zuen din menge anak he nengeetew hein betan-en pa sikandin iring te sevaha he sundaru he zuen din menge panà.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Utew zeyzey is etew he zuen din mahabet he menge anak,","poem":1},{"lineBreak":true},{"text":"su zuen ebpeketavang kandin te ked-etuvang te menge kuntada zin diyà te hukmanan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}