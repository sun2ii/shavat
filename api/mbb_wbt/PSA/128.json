{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":128,"content":[{"type":"heading","content":["Is Suhul te Kedtuman te Suat te Nengazen"]},{"type":"verse","number":1,"content":[{"text":"Utew kew zeyzey is menge edtahud te Nengazen, he nengungubpaan he ed-ikul te menge paaǥi zin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Is rimeǥas te menge kedhaǥù niw ne utew ereg te menge kinahanglan niw;","poem":1},{"lineBreak":true},{"text":"ebmelipayen kew wey ebmeuswaǥen.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Is menge esawa niw he ziyà te menge valey niw ne egkeiring te utew meveǥas he paras,","poem":1},{"lineBreak":true},{"text":"ne is menge anak niw edtigum he ebpekeliǥuy ziyà te lemisahan niw he henduen be te menguhed he menge kayu he ulibu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Iyan heini tuvad he egkezawat te menge etew he edtahud te Nengazen.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Berakat he tuvazi kew te Nengazen puun te ed-ezapan he valey zin diyà te Zion.","poem":1},{"lineBreak":true},{"text":"Berakat he meehè niw is ked-uswag te Jerusalem taman te kayi kew pa te kelibutan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wey verakat he meehè niw pa is menge apù niw.","poem":1},{"lineBreak":true},{"text":"Berakat he meupiya is kebpekesavuk te menge etew kayi te Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}