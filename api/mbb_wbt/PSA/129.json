{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":129,"content":[{"type":"heading","content":["Ampù he Igkuntra te menge Kuntada te Israel"]},{"type":"verse","number":1,"content":[{"text":"Menge tig-Israel, keǥiya niw ke mibmenumenu kew te ebpaantus te menge kuntada niw puun pa te aney en he kegketukud te nasyun niw.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“Dekelà is kebpeentusa zan kenami puun pa te kebpuun te nasyun dey.","poem":1},{"lineBreak":true},{"text":"Piru wazè key zan mezèdeeti.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mibpelian dan te mezalem is menge peka zey;","poem":1},{"lineBreak":true},{"text":"henduen be heini te tanà he mid-eradu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Piru metazeng is Nengazen,","poem":1},{"lineBreak":true},{"text":"su impelingkawas key zin te kebpen-uripen te lalung he menge etew.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Berakat he ebpekepekeziyù tenged te kegkeeled is langun he edumut te Zion.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Berakat he meiring sikandan te menge sagbet he nenuvù diyà te atep,","poem":1},{"lineBreak":true},{"text":"he iyan pa kedtuvù dan ne egkeǥangu zan en.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wazà edseǥipà te kedtiǥum kayi he menge sagbet wey wazà ed-uwit kayi he vinagkes.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Berakat he sikan is edsaǥad kenà megkaǥi ziyà te kandan te,","poem":1},{"lineBreak":true},{"text":"“Berakat he tuvazi kew te Nengazen!","poem":1},{"lineBreak":true},{"text":"Ebpenubtuvazan dey sikiyu pinaaǥi te ngazan te Nengazen.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}