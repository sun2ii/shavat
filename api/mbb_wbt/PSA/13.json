{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":13,"content":[{"type":"heading","content":["Kebpenganduy te Tavang te Megbevayà"]},{"type":"verse","number":1,"content":[{"text":"Nengazen, sengemenu keluǥayad is kenè nu kedseǥipaa kediey?","poem":1},{"lineBreak":true},{"text":"Taman en be heini te wazà pidtemanan?","poem":1},{"lineBreak":true},{"text":"Sengemenu keluǥayad is ked-elesi nu kediey?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sengemenu keluǥayad is kebpekaantus ku te kegkeliveg.","poem":1},{"lineBreak":true},{"text":"Sengemenu keluǥayad is kebpekaantus ku te kegketeǥui te seeng te ǥehinawa ku?","poem":1},{"lineBreak":true},{"text":"Sengemenu keluǥayad is kegkezeeǥa kedì te menge kuntada ku?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nengazen he Megbevayè ku kenà a kenikew pesegdana;","poem":1},{"lineBreak":true},{"text":"iveǥey nu en kedì is mibuyù ku pinaaǥi te ked-ampù ku.","poem":1},{"lineBreak":true},{"text":"Ilikù nu kayi te kedì is desen ku su para kenà a mebpatey.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Su utew egkelipey is menge kuntada ku emun egkezaag e zan.","poem":1},{"lineBreak":true},{"text":"Kenè nu ituǥut he mekezayandayan sikandan pinaaǥi te kegkezeeǥa zan kedì.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ebpekesarig a kenikew, Nengazen, su ǥeina te kenà egkaawà is kebmahala nu kediey.","poem":1},{"lineBreak":true},{"text":"Ne utew a egkelipey su edlibriyen e man kenikew.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Egkentahan ku sikew, Nengazen, su puun pa zengan mibpurungan a kenikew.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}