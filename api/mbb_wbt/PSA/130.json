{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":130,"content":[{"type":"heading","content":["Kedsarig te Nengazen te Timpu te Kelised"]},{"type":"verse","number":1,"content":[{"text":"Tenged te subra he kelised nengumew a ziyan te kenikew, Nengazen.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pemineǥa nu is kebpehizuhizu ku kenikew.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nengazen, ke và nu zà inlista is menge salè dey, ne hentei zà buwa is egkesamà diyan te etuvangan nu?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Piru mibpesaylu key kenikew, umbe edtehuzen dey sikew.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Edtaǥad a iyan kenikew, Nengazen,","poem":1},{"lineBreak":true},{"text":"wey edsarig a te lalag nu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Edtaǥad a kenikew, Nengazen,","poem":1},{"lineBreak":true},{"text":"lavew pa te kedtaǥad te perevantey te kebmeselem.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Menge tig-Israel, sarig kew te Nengazen,","poem":1},{"lineBreak":true},{"text":"su veliǥeǥawen sikandin, ne layun sikandin andam te kedluwas.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Iyan sikandin edluwas keniyu te langun he menge salè niw.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}