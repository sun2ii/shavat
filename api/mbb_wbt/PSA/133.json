{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":133,"content":[{"type":"heading","content":["Is Meǥinged he Egkesevaha"]},{"type":"verse","number":1,"content":[{"text":"Utew meupiya he ed-ahaan is menge etew te Megbevayà he ebpengungubpaan he egkesevaha.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Iring heini te utew meupiya he lana he inlana ki Aaron he midtudà diyà te sumpè din ne nekeuma ziyà te kuwilyu te visti zin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Iring heini te zehemug diyà te Buntud he Hermon he nengetaktak diyà te Buvungan he Zion.","poem":1},{"lineBreak":true},{"text":"Ne kayi te Zion medsaad is Nengazen te tuvad,","poem":1},{"lineBreak":true},{"text":"he iyan is untung he wazà pidtemanan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/134.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/132.json","previousChapterAudioLinks":{},"numberOfVerses":3}