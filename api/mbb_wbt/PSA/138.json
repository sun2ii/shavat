{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":138,"content":[{"type":"heading","content":["Kebpeselamat diyà te Megbevayà"]},{"type":"verse","number":1,"content":[{"text":"Ebpeselematan ku sikew, Nengazen, te ebpuun kayi te tivuuk he ǥehinawa ku.","poem":1},{"lineBreak":true},{"text":"Egkanta a te menge idalig kenikew ziyà te etuvangan te zuma he menge ed-ezapen.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Edluhud a he edsinaru ziyà te valey nu he edalig kenikew tenged te ǥaǥew nu wey kebmetinumanen nu.","poem":1},{"lineBreak":true},{"text":"Su impeehè nu he sikew wey is lalag nu lavew te langun he menge vutang.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hein mid-umew ku sikew, ne midtavak a kenikew;","poem":1},{"lineBreak":true},{"text":"midlig-enan a kenikew pinaaǥi te zesen nu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Edalig kenikew, Nengazen, is langun he menge hadì kayi te tivuuk he kelibutan","poem":1},{"lineBreak":true},{"text":"su egkezineg dan is menge lalag nu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Egkanta zan mehitenged te mibeelan nu,","poem":1},{"lineBreak":true},{"text":"su zekelà is gehem nu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Minsan lavew ka te langun, Nengazen, ed-isipen nu is menge egkaayuayu.","poem":1},{"lineBreak":true},{"text":"Ne minsan diyè ka te meziyu su metikang ka, netuenan nu is langun he menge vaal te menge mepelevawen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Minsan utew a edlised, ne wazè nu ituǥut he mebpatey a.","poem":1},{"lineBreak":true},{"text":"Midsilutan nu is utew egkengepauk he menge kuntada ku.","poem":1},{"lineBreak":true},{"text":"Ne midlibri a kenikew pinaaǥi te ǥehem nu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Edtumanen nu, Nengazen, is menge saad nu kayi te kediey.","poem":1},{"lineBreak":true},{"text":"Wazà pidtemanan te ǥaǥew nu.","poem":1},{"lineBreak":true},{"text":"Kenè nu pesegdana heini is menge linimbag nu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}