{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":142,"content":[{"type":"heading","content":["Ampù para te Kebuyù te Tavang te Megbevayà"]},{"type":"verse","number":1,"content":[{"text":"Nengazen, mezesen is ked-umew ku kenikew.","poem":1},{"lineBreak":true},{"text":"Ebpengemuyù a he ikehizu a kenikew.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Idtug-an ku kenikew is menge riklamu ku wey is menge kelised ku.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ne emun neewaan ad te perateng, ne heeyan ke zed is ebpekevantey te menge egkengehitavù kedì.","poem":1},{"lineBreak":true},{"text":"Diyà te ibayè ku zuen idtuǥes kedì te menge kuntada ku.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ahaa nu man is nekelingut kedì, wazà midtavang kedì, wazà nengalang kedì, wey wazà neipeng kedì.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ebpengum-umawen ku sikew, Nengazen;","poem":1},{"lineBreak":true},{"text":"iyan ka ebpengalang kedì.","poem":1},{"lineBreak":true},{"text":"Iyan ke zà utew egkinehenglanen ku kayi te kelibutan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pemineǥa nu is kebuyù ku te tavang diyan te kenikew,","poem":1},{"lineBreak":true},{"text":"su wazè en duma he egkehimu ku.","poem":1},{"lineBreak":true},{"text":"Ilikey a te edtelinguma he edrasey kediey,","poem":1},{"lineBreak":true},{"text":"su memezesen dan kenà siak.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ipeǥawas a kenikew kayi te kegkepirisuwa kedì,","poem":1},{"lineBreak":true},{"text":"wey a mekezalig kenikew.","poem":1},{"lineBreak":true},{"text":"Ne zutun ed-erungut kayi te kediey is menge metazeng","poem":1},{"lineBreak":true},{"text":"tenged te kebpurungi nu kediey.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}