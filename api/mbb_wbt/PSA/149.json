{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":149,"content":[{"type":"heading","content":["Is Kanta te Kedalig"]},{"type":"verse","number":1,"content":[{"text":"Deliǥa is Nengazen!","poem":1},{"lineBreak":true},{"text":"Megkanta kew te veǥu he kentahan para te Nengazen.","poem":1},{"lineBreak":true},{"text":"Deliǥa sikandin diyà te ketiǥuman te menge etew zin he metinumanen.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Medlipey kew is menge tig-Israel; ikelipey niw is midlimbag keniyu.","poem":1},{"lineBreak":true},{"text":"Medlipey kew is menge etew ziyà te Zion tenged te hadì niw.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Deliǥa niw sikandin duma is kedsayew","poem":1},{"lineBreak":true},{"text":"wey kedtukar te tamburin wey menge alpa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Su igkelipey te Nengazen is menge etew zin;","poem":1},{"lineBreak":true},{"text":"mibeǥayan din te zengeg is kenà memepelavawen pinaaǥi te kebpekezaag dan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Medlipey is menge etew he mepezumdumahan te Megbevayà tenged te kebpekezaag dan;","poem":1},{"lineBreak":true},{"text":"megkanta zan te kegkelipey minsan diyà te menge hizeǥaan dan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kinahanglan he igkulahì dan is kedalig dan te Megbevayà dutun te egawed sikandan te meǥarang he menge ispada,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"te kebales wey kedsilut te menge etew ziyà te zuma he menge nasyun,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"te kebekusa te menge hadì wey menge pengulu zan,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"su iyan kedsiluti kandan he insuǥù te Megbevayà.","poem":1},{"lineBreak":true},{"text":"Ne para heini te kegkezeliǥi te langun he menge etew te Megbevayà.","poem":1},{"lineBreak":true},{"text":"Deliǥa is Megbevayà!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}