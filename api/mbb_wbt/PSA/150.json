{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":150,"content":[{"type":"heading","content":["Deliǥa is Nengazen"]},{"type":"verse","number":1,"content":[{"text":"Deliǥa niw is Nengazen!","poem":1},{"lineBreak":true},{"text":"Deliǥa niw is Megbevayà diyà te valey zin.","poem":1},{"lineBreak":true},{"text":"Deliǥa niw sikandin he ziyà te langit, is melig-en he ubpeey zin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Deliǥa niw sikandin tenged te nezumahan te ǥehem he menge vaal zin.","poem":1},{"lineBreak":true},{"text":"Deliǥa niw sikandin tenged te wazà ebpekerepeng te kegkemekeǥeǥehem din.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Deliǥa niw sikandin pinaaǥi te kebpezaǥing te menge vudyung.","poem":1},{"lineBreak":true},{"text":"Deliǥa niw sikandin pinaaǥi te zaǥing te menge alpa wey menge lira.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Deliǥa niw sikandin pinaaǥi te menge tamburin wey kedsayew.","poem":1},{"lineBreak":true},{"text":"Deliǥa niw sikandin pinaaǥi te zuma pa he instrumintu he zuen menge kuwirdas wey menge pulalà.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Deliǥa niw sikandin pinaaǥi te mezaǥing he menge simbal.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Is langun he uuyag medalig te Nengazen.","poem":1},{"lineBreak":true},{"text":"Deliǥa is Nengazen!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}