{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":23,"content":[{"type":"heading","content":["Is Nengazen Iring te Ed-elima te menge Kerehidu"]},{"type":"verse","number":1,"content":[{"text":"Nengazen, iyan ka ed-elima kedì,","poem":1},{"lineBreak":true},{"text":"umbe egkekuwa ku is langun he egkinehenglanen ku.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Iring a te kerehidu he ibpehimeley nu ziyà te penebtavà he zutun is gerabi he memeilem he sagbet.","poem":1},{"lineBreak":true},{"text":"Ne ibpeikul a kenikew ziyà te meleneng he wahig.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Edlig-enan a kenikew.","poem":1},{"lineBreak":true},{"text":"Ibpeikul a kenikew te hustu he zalan te ketazeng su wey ka meveǥayi te zengeg.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Minsan pa ke edhipanew a ziyà te suǥud he zuen duen ebpekepatey,","poem":1},{"lineBreak":true},{"text":"ne kenà a egkahandek su zuma ku man sikew.","poem":1},{"lineBreak":true},{"text":"Ebpekeveǥey kedì te kelig-en wey kelipey is kegiyahi nu wey kebpengelangi nu kedì.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ed-endaman a kenikew te keenen diyà te etuvangan te menge kuntada ku.","poem":1},{"lineBreak":true},{"text":"Impurung a kenikew itetepian su midlenahan nu is ulu ku.","poem":1},{"lineBreak":true},{"text":"Ne ebpepezaharan a kenikew te inumen.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nesiguru ku he ke sengemenu keluǥayad is untung ku","poem":1},{"lineBreak":true},{"text":"ne iyan daan keluǥayad te kebpurungi nu wey kebmahala nu kedì.","poem":1},{"lineBreak":true},{"text":"Ne ziyà a ed-ubpa te valey nu, Nengazen, te wazà pidtemanan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}