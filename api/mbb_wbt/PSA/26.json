{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":26,"content":[{"type":"heading","content":["Is Ked-ampù te Metazeng he Etew"]},{"type":"verse","number":1,"content":[{"text":"Nengazen, ipeehè nu he wazè ku salà,","poem":1},{"lineBreak":true},{"text":"su nengungubpaan a he wazà igkesawey kedì","poem":1},{"lineBreak":true},{"text":"ne mibpurung a medsarig kenikew.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Susiya a, Nengazen;","poem":1},{"lineBreak":true},{"text":"susiya nu is isip ku wey ǥehinawa ku.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Su layun ku edtentenuzi is gaǥew nu,","poem":1},{"lineBreak":true},{"text":"ne layun ku sikew ebpezumdumahi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wazà a mebpekiduma te menge etew he limbungan wey uvag-uvag dà is menge ulaula zan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kenà a uyun te menge kevurunan te mezaat he menge etew.","poem":1},{"lineBreak":true},{"text":"Ne wazà a mulà mebpekiduma kandan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Edlùluan ku is menge velad ku he tuus te wazè ku salà.","poem":1},{"lineBreak":true},{"text":"Ne edhendiyà a te pemuhatà he zutun ka ebpemuhata su ed-azap a kenikew, Nengazen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ne zutun egkanta a te menge kentahan he para te kebpeselamat,","poem":1},{"lineBreak":true},{"text":"wey edseysayen ku is langun he egkein-inuwan he menge vaal nu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nengazen, mahal ku is baley he ubpeey nu,","poem":1},{"lineBreak":true},{"text":"he iyan kes lugar he zutun egkaahà is kegkemekeǥeǥehem nu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kenà a kenikew zèdeeti duma te menge mekesesalà,","poem":1},{"lineBreak":true},{"text":"iring te menge teremunù.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Heini sikandan, layun ebevaal te mezaat","poem":1},{"lineBreak":true},{"text":"ne ebpenepian dan is duma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Iyan, siak mulà, wazà igkesawey kediey,","poem":1},{"lineBreak":true},{"text":"umbe libriya a wey kehizuwi a.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Guntaan netuenan ku he kenè e en egkemenu,","poem":1},{"lineBreak":true},{"text":"umbe, edeliǥen ku sikew Nengazen diyà te ketiǥuman te menge etew nu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}