{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":29,"content":[{"type":"heading","content":["Is Mekeǥeǥehem he Laǥeng te Nengazen"]},{"type":"verse","number":1,"content":[{"text":"Sikiyu is menge linimbag diyà te langit,","poem":1},{"lineBreak":true},{"text":"deliǥa niw is Nengazen.","poem":1},{"lineBreak":true},{"text":"Deliǥa niw is gehem din wey zesen din.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Deliǥa niw is kegkemekeǥeǥehem din.","poem":1},{"lineBreak":true},{"text":"Ezapa niw sikandin diyà te segradu he etuvangan din.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ebpenriǥungriǥung is laǥeng te Nengazen he iyan kes mekeǥeǥehem he Megbevayà,","poem":1},{"lineBreak":true},{"text":"ne egkezineg heini ziyà te menge zaǥat.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Is laǥeng te Nengazen, mekeǥeǥehem wey zekelà is dengeg din","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ne ebpekevadtì te melig-en he kayu ziyà te Lebanon.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Edhuyungen te Nengazen is menge vuntud diyà te Lebanon wey Hermon,","poem":1},{"lineBreak":true},{"text":"ne egkeiring heini te nati he vaka he edlinglingketew.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Is laǥeng te Nengazen, ebpekepekilat","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"wey ebpekehuyung te sibsivayan;","poem":1},{"lineBreak":true},{"text":"egkehuyung din minsan is sibsivayan diyà te Kadesh.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Is laǥeng te Nengazen, ebpekepaanak te selazeng","poem":1},{"lineBreak":true},{"text":"wey ebpekepetaktak te zahun te menge kayu.","poem":1},{"lineBreak":true},{"text":"Ne ziyà te valey zin ibensag te langun is lalag he, “Mekeǥeǥehem is Megbevayà!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Is Nengazen iyan ebmandù te zalem te menge wahig;","poem":1},{"lineBreak":true},{"text":"iyan sikandin kes hadì he ebmandù te wazà pidtemanan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Edlig-enan te Nengazen is menge etew zin,","poem":1},{"lineBreak":true},{"text":"ne ebeǥayan din sikandan te meupiya he kebpekesavuk.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}