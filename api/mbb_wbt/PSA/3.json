{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":3,"content":[{"type":"heading","content":["Ampù te Kebpetavang"]},{"type":"verse","number":1,"content":[{"text":"Nengazen, mahabet is kuntada ku;","poem":1},{"lineBreak":true},{"text":"mahabet is ebpekigkuntada kedì!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kesikandan te kenè ke kun edtavang kedì.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Piru is tutuu, iring ka te kelasag he ebpengalang kedì.","poem":1},{"lineBreak":true},{"text":"Iyan ka ebeǥey kedì te kezeeǥan wey kelig-en.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ed-umawen ku sikew, Nengazen, ne edtevaken a kenikew ziyà te segradu he vuvungan nu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Edhizeǥà a wey edlipezeng ne egkepukew a,","poem":1},{"lineBreak":true},{"text":"ne wazà ebpekekaid kedì su iyan man ed-ipat kedì is Nengazen.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Minsan linibu pa he menge kuntada is edliǥuy kedì, ne kenà a egkahandek.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sigi en, Nengazen he Megbevayè ku, libriya a!","poem":1},{"lineBreak":true},{"text":"Su zengan mibpeel-elezan nu is langun he kuntada ku he menge lalung;","poem":1},{"lineBreak":true},{"text":"ne in-awè nu is gehem dan he iyan pezem kedezaat kedì.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Iyan ka edlibri, Nengazen, wey edtuvad te menge etew nu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}