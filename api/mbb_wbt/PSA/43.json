{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"He Megbevayà, ipeehè nu he wazè ku salà,","poem":1},{"lineBreak":true},{"text":"ne levani a su wey a kenà mezezeeti te menge etew he kenà edtuu te Megbevayà.","poem":1},{"lineBreak":true},{"text":"Libriya a te kedezeeti kedì te limbungan wey lalung he menge etew.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Iyan ka, Megbevayà melig-en he eputè ku.","poem":1},{"lineBreak":true},{"text":"Ne maan is inselikwey a kenikew?","poem":1},{"lineBreak":true},{"text":"Maan is kinahanglan pa he egkeseeng a tenged te kedèdaaǥa kedì te menge kuntada?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Teyawi a ne penurua a te tutuu","poem":1},{"lineBreak":true},{"text":"su para meǥiyahi a te kebpekid-uliey kenikew ziyà te valey nu he ziyà te segradu he vuvungan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ne zutun ed-uvey a ziyà te pemuhatà he zutun ka ebpemuhata, Megbevayè ku,","poem":1},{"lineBreak":true},{"text":"iyan ka ebeǥey kedì te kelipey.","poem":1},{"lineBreak":true},{"text":"Megbevayè ku, edeliǥen ku sikew pinaaǥi te kedtukar te alpa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Maan is egkeseeng a wey egkeǥiyaǥiya?","poem":1},{"lineBreak":true},{"text":"Ereg a he edsarig kenikew. Uya, ed-umanan ku sikew edeliǥa, is menluluwas wey Megbevayè ku.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}