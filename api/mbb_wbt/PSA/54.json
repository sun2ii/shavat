{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":54,"content":[{"type":"heading","content":["Is Megbevayà iyan Edtavang"]},{"type":"verse","number":1,"content":[{"text":"He Megbevayà, libriya a;","poem":1},{"lineBreak":true},{"text":"pinaaǥi te ǥehem nu, petueni nu he wazè ku salà.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pemineǥa nu is menge kebpengemuyù ku","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"su zuen menge lumelengyawà he midsurung kedì su edhimetayan e zan.","poem":1},{"lineBreak":true},{"text":"Menge mesipala sikandan ne wazè dan mekekilala kenikew.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kenà a egkezuwazuwa he sikew is Megbevayè ku, ne iyan ka edtavang kediey.","poem":1},{"lineBreak":true},{"text":"Iyan ka, Nengazen, sendiǥè ku.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Berakat he medlikù diyà te menge kuntada ku is menge pesipala zan.","poem":1},{"lineBreak":true},{"text":"He Megbevayà dèdeeti nu sikandan tenged te kebmetinumanen nu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nengazen, ebpemuhat a ziyà te kenikew te pemuhat he kineugelingen he suat.","poem":1},{"lineBreak":true},{"text":"Edeliǥen ku sikew su iyan haazà meupiya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Su ibpelingkawas a kenikew te langun he kelised ku,","poem":1},{"lineBreak":true},{"text":"ne egkeehè ku is kegkezeeǥa te menge kuntada ku.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}