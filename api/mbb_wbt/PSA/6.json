{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":6,"content":[{"type":"heading","content":["Ampù para te Kebuyù te Tavang te Megbevayà"]},{"type":"verse","number":1,"content":[{"text":"Nengazen, minsan duen nu pauk kedì, ne kenà a kenikew siluti.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kehizuwi a wey vewii a, su utew ad meluya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nesemukan utew is isip ku, Nengazen.","poem":1},{"lineBreak":true},{"text":"Keenu e en be kenikew ebewii?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Etura a kenikew, Nengazen, ne ǥeuza a.","poem":1},{"lineBreak":true},{"text":"Tenged te kebmahala nu kediey, libriya a te kemetayen.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Su emun ebpatey a, ne kenè ku en maan sikew egketenuzan;","poem":1},{"lineBreak":true},{"text":"kenà ad maan ebpekezalig kenikew ziyà te lugar te menge minatey.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mibmeluye e en tenged te utew ku kegkesekiti.","poem":1},{"lineBreak":true},{"text":"Kada mezukilem egkahames is ulunè ku te luhà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nemenlevag en is menge mata ku su ebpeketulung ad ebpekesineǥew","poem":1},{"lineBreak":true},{"text":"tenged te vaal te langun he menge kuntada ku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Sikiyu is memezaat is baal, pekeziyù kew kediey,","poem":1},{"lineBreak":true},{"text":"su nezineg en te Nengazen is sineǥawan ku.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nezineg din en is kebuyù ku te tavang,","poem":1},{"lineBreak":true},{"text":"ne edtevaken din en is ampù ku.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Egkepeel-elezan wey egkengeheratan is langun he menge kuntada ku.","poem":1},{"lineBreak":true},{"text":"Egkengelagewlagew sikandan he ebpekeziyù tenged te kegkeeled dan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}