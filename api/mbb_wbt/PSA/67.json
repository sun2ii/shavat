{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":67,"content":[{"type":"heading","content":["Kanta te Kebpeselamat"]},{"type":"verse","number":1,"content":[{"text":"He Megbevayà, kehizuwi key wey tuvazi key.","poem":1},{"lineBreak":true},{"text":"Ipeehè nu kenami is keupiya nu,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"su para metueni ziyà te langun he menge nasyun te tivuuk he kelibutan is paaǥi nu wey is kedluwas nu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"He Megbevayà, berakat he edeliǥen ka te tivuuk he menusiyà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Berakat he meǥalew he egkanta te kegkelipey is langun he menge etew kayi te tivuuk he kelibutan,","poem":1},{"lineBreak":true},{"text":"tenged te ketazeng te kedhukum nu kandan wey kegiyahi nu kandan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Berakat he edeliǥen ka te langun he menge etew, Megbevayè ku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Berakat he mebeǥey te sebpet is tanà.","poem":1},{"lineBreak":true},{"text":"Berakat he edtuvazan kiw te Megbevayè tew.","poem":1},{"lineBreak":true},{"text":"Berakat he edtahud kandin is langun he menge etew ziyà te minsan hendei kayi te kelibutan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":6}