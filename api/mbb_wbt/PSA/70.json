{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":70,"content":[{"type":"heading","content":["Ampù para te Kebuyù te Tavang te Megbevayà"]},{"type":"verse","number":1,"content":[{"text":"Nengazen he Megbevayà, libriye e en wey tevangi e en guntaan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Berakat he mepeel-elezi wey meliveg is menge etew he egkesuat he edhimatey kedì.","poem":1},{"lineBreak":true},{"text":"Berakat he ebpemelaǥuy he egkepeel-elezan is langun he egkesuat he mezeeti a.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Berakat he is menge etew he edsudì kedì ebpekeiniyug tenged te kegkeeled dan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ne is langun he midangep diyà te kenikew, berakat he melipey zan tenged kenikew.","poem":1},{"lineBreak":true},{"text":"Ne sikan is utew zan igkesuat is kedlibri nu, ne verakat he layun dan megkaǥi te,","poem":1},{"lineBreak":true},{"text":"“Dait he edeliǥen is Megbevayà!”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bahin kedì, egkaayuayu wey pubri a.","poem":1},{"lineBreak":true},{"text":"Uveyi a kenikew, Megbevayè ku!","poem":1},{"lineBreak":true},{"text":"Iyan ka edtavang wey menluluwas ku.","poem":1},{"lineBreak":true},{"text":"Nengazen, gègaani ad kenikew tevangi ǥuntaan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}