{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":82,"content":[{"type":"heading","content":["Kinelevawan he Pengulu is Megbevayà"]},{"type":"verse","number":1,"content":[{"text":"Midumala te Megbevayà is ketiǥuman te menge gemhanan,","poem":1},{"lineBreak":true},{"text":"ne edhukuman din sikandan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ke sikandin te, “Sengemenu keluǥayad is kedtulung niw kedhimu te hukum he kenà metazeng?","poem":1},{"lineBreak":true},{"text":"Sengemenu keluǥayad is kedtulungi niw kedepiǥi te menge lalung?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Iveǥey niw is hustu he kukuman diyà te menge utew egkengeey-eyuwi wey menge ilu.","poem":1},{"lineBreak":true},{"text":"Levani niw is ketenged te menge egkaayuayu he edèdaaǥen.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Luwasa is menge utew egkengeey-eyuwi wey is menge pubri ziyà te ǥehem te menge mezaat he etew!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Utew kew menge paglung!","poem":1},{"lineBreak":true},{"text":"Utew kew menge taleng!","poem":1},{"lineBreak":true},{"text":"Diyè kew te kerusireman, umbe negurigew en heini is kelibutan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Siak, is Utew Lavew he Megbevayà, egkeǥiyan ku sikiyu te menge megbevayè kew, ne pudu ku sikiyu menge anak.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ebpatey kew iring te etew.","poem":1},{"lineBreak":true},{"text":"Egketapus is untung niw iring te minsan hentei he pengulu.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Sigi en, Megbevayà, hukumi nu en is menge etew ziyà te langun he menge nasyun kayi te kelibutan, su ǥaked nu sikandan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}