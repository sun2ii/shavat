{"translation":{"id":"mbb_wbt","name":"Is Lalag te Megbevayà","website":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbbOT","licenseNotes":null,"shortName":"WBT","englishName":"Western Bukidnon Manobo OT","language":"mbb","textDirection":"ltr","sha256":"11cdc78c5dd13aea1a7661b4d1ad8216a2dfa324e7e53c6af87d94f21453b1ce","availableFormats":["json"],"listOfBooksApiLink":"/api/mbb_wbt/books.json","numberOfBooks":39,"totalNumberOfChapters":929,"totalNumberOfVerses":22339,"languageName":"Western Bukidnon Manobo","languageEnglishName":"Western Bukidnon Manobo"},"book":{"id":"PSA","translationId":"mbb_wbt","name":"Menge Salmo","commonName":"Menge Salmo","title":"Menge Salmo","order":19,"numberOfChapters":150,"sha256":"b878635557090c36bac8e2d4e5133af771b794b4e67b7e643df8cd6de49c8c57","firstChapterNumber":1,"firstChapterApiLink":"/api/mbb_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mbb_wbt/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":93,"content":[{"type":"heading","content":["Hadì Tew is Megbevayà"]},{"type":"verse","number":1,"content":[{"text":"Hadì ka, Nengazen;","poem":1},{"lineBreak":true},{"text":"is bisti nu iyan is kegkemekeǥeǥehem nu wey is utew nu kegkelavew.","poem":1},{"lineBreak":true},{"text":"Utew melig-en is kebenguna nu te kelibutan ne kenà heini egkehuyung.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Is kedhadì nu puun pa te puunà,","poem":1},{"lineBreak":true},{"text":"su zaan ke en hein wazè pa is kelibutan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Utew mezaǥing is daǥat, Nengazen,","poem":1},{"lineBreak":true},{"text":"ne edreǥuuk is menge vaǥel.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Piru sikew is Nengazen he ziyà te langit, lavew ke pa he mekeǥeǥehem te kezaǥing te zaǥat;","poem":1},{"lineBreak":true},{"text":"lavew ke pa he mekeǥeǥehem te menge vaǥel kayi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nengazen, egkeseriǥan utew is menge suǥù nu,","poem":1},{"lineBreak":true},{"text":"wey is kegkesegradu te baley nu te wazà pidtemanan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mbb_wbt/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbb_wbt/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbb_wbt/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}