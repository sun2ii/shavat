verse","number":3,"content":[{"text":"Ɓǝ̀ mǝ nǝ pè amǝ'tǝ̀r","poem":1},{"text":"agirkuma mem kat,","poem":2},{"text":"mǝ nǝ pà nggūrǝam","poem":1},{"text":"ɓǝà pisǝì ace nggori,","poem":2},{"text":"sǝ ǝn panǝ earcearǝu raka,","poem":1},{"text":"mani pà nǝ̀ puram kǝgìr ɗàng.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Earcearǝu ka ndanǝ","poem":1},{"lineBreak":true},{"text":"munyi,","poem":1},{"text":"andǝ pe mǝɓoarne.","poem":2},{"text":"Earcearǝu ka kǝ pak","poem":1},{"text":"mɓali ɗang, kǝ nggori,","poem":2},{"lineBreak":true},{"text":"ko gusǝlǝ-múrû ɗang.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Earcearǝu kǝ pa","poem":1},{"text":"arkikun ɗang,","poem":2},{"text":"pànǝ earce-ɓamuru ɗang,","poem":1},{"text":"sǝ kǝ kaurǝa arǝ pak","poem":2},{"lineBreak":true},{"text":"bumlulla ɗang.","poem":2},{"text":"Earcearǝu kǝ bwal ɓwa","poem":1},{"text":"a bum ɗang.","poem":2},{"noteId":143}]},{"type":"verse","number":6,"content":[{"text":"Ban kǝ ɓoari wi arǝ","poem":1},{"text":"ɓealɓikea ɗang,","poem":2},{"text":"ban kǝ ɓoari wi arǝ mǝsǝcau.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Earcearǝu kǝ bwaki buì","poem":1},{"text":"arǝ ɓwa ɗàng.","poem":2},{"text":"Earnǝɓwa male,","poem":1},{"text":"andǝ tsǝkɓalǝu male,","poem":2},{"text":"andǝ gandǝrǝu male","poem":1},{"text":"aɓalǝ agir kat ka","poem":2},{"lineBreak":true},{"text":"kǝ kpa ɗang.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Earcearǝu ka masǝlǝate","poem":1},{"text":"pà kàm ɗàng,","poem":2},{"lineBreak":true},{"text":"kǝ makban ɗang.","poem":2},{"text":"Na ɓabum Ɓakuli ka","poem":1},{"text":"nǝ̀ nggá came.","poem":2},{"text":"Anakiacau nǝ","poem":1},{"text":"akún-takuli ka","poem":2},{"lineBreak":true},{"text":"à nǝ̀ nggá came.","poem":2},{"text":"Ko sǝlǝe ka nǝ̀ nggá kutio.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Surǝe ma'sǝm ngga","poem":1},{"text":"lùmsǝ ɗang,","poem":2},{"text":"sǝ sǝm súrǝ̀ ɓabum","poem":1},{"text":"Ɓakuli kat ɗàng.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sǝa ma ɓǝ̀ gìr","poem":1},{"text":"mǝnana lùmsǝ ka,","poem":2},{"lineBreak":true},{"text":"yina ka,","poem":2},{"text":"amǝnana à lùmsǝ raka,","poem":1},{"text":"à nǝ̀ ndǝrmi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mǝnana mǝ nda muna ka,","poem":1},{"text":"ǝn nggǝ nacau,","poem":2},{"text":"ǝn nggǝ ɗenyicau sǝ","poem":1},{"text":"ǝn nggǝ sǝngìr","poem":2},{"lineBreak":true},{"text":"a sǝne mala amuna.","poem":2},{"text":"Lang adyan ǝn","poem":1},{"text":"karǝna-ɓwa ka,","poem":2},{"text":"ǝn bwaki buam","poem":1},{"text":"arǝ pakkiagir","poem":2},{"lineBreak":true},{"text":"mala amuntulo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Adyan ngga, sǝm nggǝ","poem":1},{"text":"sǝnban mbǝrǝm-mbǝrǝm,","poem":2},{"text":"kǝla yilǝmi gìr aɓa","poem":1},{"text":"tapwari mǝpǝndǝke,","poem":2},{"text":"sǝ a dǝmba ka,","poem":1},{"text":"sǝm nǝ̀ sǝnban","poem":2},{"lineBreak":true},{"text":"ɓamǝsǝu andǝ ɓamǝsǝu.","poem":2},{"text":"Ado ka, súrǝè mem ngga","poem":1},{"text":"lùmsǝ ɗang,","poem":2},{"text":"sǝ a dǝmba ka,","poem":1},{"text":"mǝ nǝ súrǝ̀ koman ngga,","poem":2},{"text":"kǝla mǝnana Ɓakuli","poem":1},{"text":"súrǝàm ɗǝɗak ka.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ado ka, amǝnia yì","poem":1},{"text":"agir tàrú,","poem":2},{"text":"à nda à ue ka:","poem":1},{"text":"paɓamuru, andǝ tsǝkɓalǝu,","poem":2},{"lineBreak":true},{"text":"andǝ earcearǝu;","poem":2},{"text":"sǝ mǝgule malea kat ka,","poem":1},{"text":"nda earcearǝu.","poem":2}]}],"footnotes":[{"noteId":142,"caller":"+","text":"Ɓalli gbal aɓa: Mat 17:20,21; 21:21; Mar 11:23; 1Kor 14:2.","reference":{"chapter":13,"verse":2}},{"noteId":143,"caller":"+","text":"Ɓalli gbal aɓa: 1Kor 10:24.","reference":{"chapter":13,"verse":5}}]},"thisChapterLink":"/api/mbu_tsc/1CO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbu_tsc/1CO/14.json",