{"translation":{"id":"mbu_tsc","name":"Mbula-Bwazza","website":"https://ebible.org/Scriptures/details.php?id=mbu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbu","licenseNotes":null,"shortName":"TSC","englishName":"Mbula-Bwazza NT+","language":"mbu","textDirection":"ltr","sha256":"6deff9bee5c560e4b45d9a4d3fd03726af52baad26c5d2f72b90ada34b850b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/mbu_tsc/books.json","numberOfBooks":36,"totalNumberOfChapters":546,"totalNumberOfVerses":16540,"languageName":"Mbula-Bwazza","languageEnglishName":"Mbula-Bwazza"},"book":{"id":"HEB","translationId":"mbu_tsc","name":"Amǝ Ibǝru","commonName":"Amǝ Ibǝru","title":"Cautera aban ká aban AMƏ IBƏRU","order":58,"numberOfChapters":13,"sha256":"53ce2945f361ea84dfd87ec4a7086843ce758501d067a2dc3dc7f57c9e8279f7","firstChapterNumber":1,"firstChapterApiLink":"/api/mbu_tsc/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/mbu_tsc/HEB/13.json","totalNumberOfVerses":302},"chapter":{"number":1,"content":[{"type":"heading","content":["Ɓakuli nacau nǝ mburkunamǝ'ɓangnǝa male"]},{"type":"verse","number":1,"content":["A pwarian ngga, Ɓakuli nacau nǝ aká sǝm kusǝ pas arǝ anjargula ɗàngɗáng, nǝ mburkun amǝ'ɓangnǝa male."]},{"type":"verse","number":2,"content":["Sǝ a masǝlǝata nza man ngga, yi nacau nǝ sǝm, nǝ mburkun Muni, mǝnana twali ɓǝ̀ yì duk mǝliɓala na amur girbunda kat, sǝ nǝ́ yi sǝ pusǝ kuli andǝ nzali ka."]},{"type":"verse","number":3,"content":["Yì Muna mala Ɓakuli ka, nda tǎlaban mala ɓoarɓwa mala Ɓakuli, andǝ purban male yì Ɓakuli. Nǝ́ cau male mǝ'rǝcandǝe sǝ bwal agirbunda kat a banɓwáná. Anzǝm mana yi langŋǝna acauɓikea ma'sǝm ngga, pǝlǝa do a kùli a bù-mǝlì mala Ɓakuli mǝnana Karban kat ka."]},{"type":"verse","number":4,"content":["Anggo sǝ Muna mala Ɓakuli ka yi kum gulo kútì amǝturonjar, kǝla mǝnana lullǝu mana Tárrí pe wi ka, kútì malea ka."]},{"type":"heading","content":["Gulo mala Yesu amur amǝturonjar"]},{"type":"verse","number":5,"content":["Yana ɗe atà amǝturonjar mala Ɓakuli, mǝnana Ɓakuli ne wi àkǝ̀ pwari ama,",{"text":"<<A nda Munem, yalung ngga,","poem":1},{"lineBreak":true},{"text":"ǝn dumǝna Tárró>> ka?","poem":1},{"noteId":0},"Ko báng gbal amur ɓekǝ mǝturonjar ama,",{"text":"<<Mǝ nǝ duk Tárrí,","poem":1},{"text":"sǝ yì ka, nǝ̀ duk Munem>> ngga","poem":2},{"noteId":1},{"text":"?","poem":2}]},{"type":"verse","number":6,"content":["Ɗǝm ngga, mǝnana Ɓakuli yinǝ Muna-dǝmba male a ɓanza ka, na ama,",{"text":"<<Amǝturonjar mala Ɓakuli kat ka,","poem":1},{"text":"ɓǝà peri a baní.>>","poem":2},{"noteId":2}]},{"type":"verse","number":7,"content":["Aɓa cau male amur amǝturonjar ka, Ɓakuli bang ama,",{"text":"<<Kǝ tsǝk amǝturonjar male ɓǝà pǝlǝ gung,","poem":1},{"text":"sǝ amǝtúró male ka, lasǝ bǝsa.>>","poem":2},{"noteId":3}]},{"type":"verse","number":8,"content":["Sǝama amur Muni ka, bang ama,",{"text":"<<Domurǝm mo, we Ɓakuli ka,","poem":1},{"text":"masǝlǝate pà kàm ɗang,","poem":2},{"text":"sǝ gara-murǝm mala domurǝm mò ka,","poem":1},{"text":"nda do amur mǝsǝcau.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"We ka, a earce ɓealɓoarna,","poem":1},{"text":"sǝ a ɓinǝce ɓealɓikea;","poem":2},{"text":"ace mani ka, Ɓakuli, yì Ɓakuli mo,","poem":1},{"lineBreak":true},{"text":"loasǝo cio amur aɓio","poem":1},{"text":"yì mǝnana yí ɗārǝo nǝ","poem":2},{"lineBreak":true},{"text":"mùrú mala bumpwasǝa ka.>>","poem":2},{"noteId":4}]},{"type":"verse","number":10,"content":["Nyar ɗǝm na ama,",{"text":"<<We Mǝtalabangŋo, a tite ka,","poem":1},{"lineBreak":true},{"text":"a nda a kwakita ɓanza,","poem":1},{"text":"sǝ a pak kùli nǝ abuo ka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yia ka, tea nǝ̀ twalo,","poem":1},{"text":"sǝ We ka, a nda àkǝ̀ banì,","poem":2},{"lineBreak":true},{"text":"a pà nǝ gǝshi ɗang;","poem":2},{"text":"yia ka, à nǝ̀ tsǝuri","poem":1},{"text":"kǝla eakǝna lagir.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"We ka, a nǝ kàrria kǝla kàr lagir;","poem":1},{"text":"à nǝ̀ nggáɗiǎ kǝla nggubyau.","poem":2},{"text":"Sǝ mo ka, a pà nǝ nggaɗi ɗang,","poem":1},{"text":"apǝlǝa mo pà nǝ̀ mal ɗang.>>","poem":2},{"noteId":5}]},{"type":"verse","number":13,"content":["Ata amǝturonjar ka, yana Ɓakuli ne wi àkǝ̀ pwari ama,",{"text":"<<Do a buam-mǝlì, she ɓǝ̀ ǝn nyesǝna","poem":1},{"text":"aɓio amǝbura à pǝlǝna","poem":2},{"lineBreak":true},{"text":"buno-tsǝk kusǝu a ɓakusǝo ka?>>","poem":2},{"noteId":6}]},{"type":"verse","number":14,"content":["Nggearǝ amǝturonjar kat ka, abangŋo na mǝnana à pàkkiyi túró, à kǝ túriá ɓǝà kǝ ɗenyinǝ aɓwana mǝnana à nǝ̀ kum amsǝban ngga re?"]}],"footnotes":[{"noteId":0,"caller":"+","text":"Ɓalli gbal aɓa: Ang 2:7.","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"+","text":"Ɓalli gbal aɓa: 2Sam 7:14; 1.","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"Ɓalli gbal aɓa: Nggur 32:43.","reference":{"chapter":1,"verse":6}},{"noteId":3,"caller":"+","text":"Ɓalli gbal aɓa: Ang 104:4.","reference":{"chapter":1,"verse":7}},{"noteId":4,"caller":"+","text":"Ɓalli gbal aɓa: Ang 45:6-7.","reference":{"chapter":1,"verse":9}},{"noteId":5,"caller":"+","text":"Ɓalli gbal aɓa: Ang 102:25-27.","reference":{"chapter":1,"verse":12}},{"noteId":6,"caller":"+","text":"Ɓalli gbal aɓa: Ang 110:1.","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/mbu_tsc/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbu_tsc/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbu_tsc/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}