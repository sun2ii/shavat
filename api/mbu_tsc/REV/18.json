{"translation":{"id":"mbu_tsc","name":"Mbula-Bwazza","website":"https://ebible.org/Scriptures/details.php?id=mbu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mbu","licenseNotes":null,"shortName":"TSC","englishName":"Mbula-Bwazza NT+","language":"mbu","textDirection":"ltr","sha256":"6deff9bee5c560e4b45d9a4d3fd03726af52baad26c5d2f72b90ada34b850b5c","availableFormats":["json"],"listOfBooksApiLink":"/api/mbu_tsc/books.json","numberOfBooks":36,"totalNumberOfChapters":546,"totalNumberOfVerses":16540,"languageName":"Mbula-Bwazza","languageEnglishName":"Mbula-Bwazza"},"book":{"id":"REV","translationId":"mbu_tsc","name":"Sǝna mala Yohana","commonName":"Sǝna mala Yohana","title":"Sǝna mala Yohana","order":66,"numberOfChapters":22,"sha256":"a8697d0a54711521016791d69662e267c52394a77e438572c0c43dea6e9a99b6","firstChapterNumber":1,"firstChapterApiLink":"/api/mbu_tsc/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/mbu_tsc/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":18,"content":[{"type":"heading","content":["Kpa mala Babila"]},{"type":"verse","number":1,"content":["Anzǝm mǝno ka, ǝn sǝn ɓè mǝturonjar pur a kùli sǝ sulǝo aban yiu a ɓanza. Yì ka, ndanǝ rǝcandǝa kǝ̀rkǝ́r, sǝ tǎ mala ɓoarɓwa male tǎ aki ɓanza."]},{"type":"verse","number":2,"content":["Loasǝ gì bàng-bàng nacau ama:",{"text":"<<Babila kpana!","poem":1},{"lineBreak":true},{"text":"Mǝno yì nggea-là","poem":1},{"text":"mǝgule ka, kpana!","poem":2},{"text":"Pǝlǝna ban-do","poem":1},{"text":"mala akukwar.","poem":2},{"text":"Pǝlǝna mpù mala","poem":1},{"text":"koya bangŋo mǝɓane,","poem":2},{"text":"andǝ ndá mala","poem":1},{"text":"koya nyal mǝɓane,","poem":2},{"text":"andǝ ban sǝmbǝrǝa mala","poem":1},{"text":"koya nyama mǝɓane,","poem":2},{"text":"andǝ mǝnana à ɓinǝce ka.","poem":1},{"noteId":138}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aɓwana arǝ anzali kat,","poem":1},{"text":"à nùnà mùr-anap","poem":2},{"text":"mala nshawari,","poem":1},{"text":"andǝ kìɗìkì mala","poem":2},{"text":"nonggi nǝ rǝarǝu male,","poem":1},{"text":"sǝ walǝnia.","poem":2},{"text":"Amurǝma mala ɓanza","poem":1},{"text":"nonggina nǝi.","poem":2},{"text":"Ace ɓiki earce do male","poem":1},{"text":"aɓa banɓoarnado","poem":2},{"text":"mala kume ka,","poem":1},{"text":"tsǝ̀ngŋǝ̀nà amǝ nggāliki","poem":2},{"text":"mala ɓanza à pǝlǝna","poem":1},{"text":"amǝ gǝna.>>","poem":2},{"noteId":139}]},{"type":"verse","number":4,"content":["Pǝlǝa ǝn ok ɓè giu pur nǝ kuli kǝ na ama:",{"text":"<<Wu purî ɓālǝi,","poem":1},{"text":"wun aɓwana mem.","poem":2},{"text":"Wu kǝa oasǝ bu wun aɓalǝ","poem":1},{"text":"acauɓikea male ɗàng,","poem":2},{"text":"ɓǝ̀ ana raka,","poem":1},{"text":"wun nǝ̀ nutanni atè","poem":2},{"text":"arǝ agirtanni mǝnana","poem":1},{"text":"à nǝ̀ sulǝo amurí ka.","poem":2},{"noteId":140}]},{"type":"verse","number":5,"content":[{"text":"Acauɓikea male ka,","poem":1},{"lineBreak":true},{"text":"à gwalikina amur rǝarǝia,","poem":1},{"text":"à bingŋǝna kùli.","poem":2},{"text":"Ɓakuli ɗenyina nǝ atúró","poem":1},{"text":"ɓealɓikea male","poem":2},{"lineBreak":true},{"text":"mǝnana pakkia ka.","poem":2},{"noteId":141}]},{"type":"verse","number":6,"content":[{"text":"Ɓǝà mbweki wi a kúnì,","poem":1},{"text":"kǝla mǝnana pàkkî","poem":2},{"lineBreak":true},{"text":"aɓea ɓwana ka.","poem":2},{"text":"Ɓǝà tsǝì ɓǝ̀ mbwe kusǝ ɓari","poem":1},{"text":"arǝ agir mǝnana pea ka.","poem":2},{"text":"Ɓǝà mbwe ɓǝ̀ nu","poem":1},{"text":"nggea mǝɓane mana","poem":2},{"text":"lúllô male ka kar mǝnana","poem":1},{"text":"pea aɓea ɓwana sǝ à nu ka,","poem":2},{"lineBreak":true},{"text":"kusǝ ɓari.","poem":2},{"noteId":142}]},{"type":"verse","number":7,"content":[{"text":"Sokkite ɓǝ̀ tāpì aɓa","poem":1},{"text":"tanni andǝ bumkiɗikea","poem":2},{"text":"kǝla mǝnana pè ɓamúrì","poem":1},{"text":"gulo andǝ do mǝɓoarne","poem":2},{"lineBreak":true},{"text":"aɓa rǝpwala ka.","poem":2},{"text":"Kǝ jali a ɓabumi ama,","poem":1},{"text":"<Mǝ nda mā-murǝm;","poem":2},{"lineBreak":true},{"text":"mǝ nda mā-lú ɗàng.","poem":2},{"text":"Kǝ gìr pà kàm","poem":1},{"text":"nǝ̀ ciem mǝ nǝ pak","poem":2},{"lineBreak":true},{"text":"bumkiɗikea ɗang.","poem":2},{"noteId":143},{"text":">","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ace mani ka,","poem":1},{"text":"agirpatanni mǝnana","poem":2},{"text":"à nǝ̀ yinǝi wi nǝ bumkiɗikea,","poem":1},{"text":"andǝ nzala,","poem":2},{"lineBreak":true},{"text":"andǝ lú ka,","poem":2},{"text":"à nǝ̀ yiu amurí","poem":1},{"text":"aɓa pwari mwashat.","poem":2},{"text":"Nǝ̀ yia pi aɓa bǝsa kǝring,","poem":1},{"text":"acemǝnana Mǝtalabangŋo","poem":2},{"text":"Ɓakuli mǝnana pakkiyi wi","poem":1},{"lineBreak":true},{"text":"ɓashi ka,","poem":1},{"text":"mǝ rǝcandǝa na.>>","poem":2}]},{"type":"verse","number":9,"content":["Amurǝma mala ɓanza mǝnana à kutio aɓa kìɗìkì mala nonggi nǝ rǝarǝu andǝ yi, sǝ à do aɓa banɓoarnado andǝ li mǝɓoarne atè ka, à nǝ̀ ɓua, sǝ à nǝ̀ keban amurí, ɓǝà sǝnǝna yele mala bǝsa mǝnana kǝ pisǝì ka.",{"noteId":144}]},{"type":"verse","number":10,"content":["Nggea tanni male mǝgule nǝ̀ pea wia ɓangciu kǝ̀rkǝ́r. À nǝ̀ cam kuko, sǝ à nǝ̀ keban amurí ama:",{"text":"<<Caukwanban!","poem":1},{"lineBreak":true},{"text":"Caukwanban nǝ we Babila,","poem":1},{"text":"nggea-là mǝgule,","poem":2},{"lineBreak":true},{"text":"la murǝm!","poem":2},{"text":"Aɓa bu-pwari mwashat","poem":1},{"text":"ɓashi mala Ɓakuli","poem":2},{"text":"yi sulǝna a muro!>>","poem":1}]},{"type":"verse","number":11,"content":["Amǝ nggāliki aɓa ɓanza nǝ̀ ɓua, sǝ à nǝ̀ pak bumkiɗikea ace, acemǝnana kǝɓwa ueo kam nǝ̀ kúr agirmâ malea ɗǝm ɗàng.",{"noteId":145}]},{"type":"verse","number":12,"content":["Agir-mâ mǝnana kúria nǝ boalo kǝ̀rkǝ́r sǝ à ram ngga, à nda ka zǝnariya andǝ azǝrfa, andǝ atali gǝna, andǝ sala-ɓá-nkombo. Aɓea ka à nda ka nggubyau-linǝn, amǝ rǝɓǝlke, andǝa mǝnana amurǝma makkiyi arǝia ka, andǝa mǝnana kúria pa bǝti raka. Aɓea ɗǝm ngga à nda ka agir mǝnana à shària nǝ nggun mǝɓoarne sǝ à hasǝkia wia amuru-mǝrǝmɓoarne ka, andǝ agir mǝnana à tùllia nǝ bolo-bángŋá, andǝ bolo-candǝa ka, andǝ agir mǝnana à ɓakkia nǝ tali mabǝl ka.",{"noteId":146}]},{"type":"verse","number":13,"content":["Aɓea gir ɗǝm mana kúria ka, à nda ka amuku nggwato-nggun mǝɓoarne mala amǝ Asiya, andǝ amuku agir mǝɓoarne mǝnana à kunǝkiyia amur girlina. Myang-loasǝ-yele mǝ'rǝmɓoarne, andǝ myang pak ɓuri wal rǝkwangya, andǝ myang pak muru-mǝrǝmɓoarne na aɓalǝia. Acilia ka à nda ka mùr-ɓǝlanggun anap, andǝ mùrú nggun-olif, andǝ muku pak bǝredi mǝɓǝlke, andǝ mǝsǝ mǝssa-alkama, andǝ andá, andǝ anzur, andǝ apǝ́r, andǝ awaru-pǝr, andǝ aguro, andǝ ayilǝmi ɓwapǝndǝa."]},{"type":"verse","number":14,"content":["Amǝ nggāliki nǝ̀ bang ama,",{"text":"<<Agir mǝɓoarne mǝnana","poem":1},{"text":"bumo earkiyicea,","poem":2},{"text":"sǝ rǝo kǝ ɓǝla arǝia ka,","poem":1},{"text":"à umna arǝò kat.","poem":2},{"text":"Agirkuma mò kat,","poem":1},{"text":"andǝ agir gilǝki rǝǔ mô ka,","poem":2},{"lineBreak":true},{"text":"à ndǝrmina arǝò kat.","poem":2},{"text":"A pa wu nǝ nyare awu nǝ","poem":1},{"text":"kumia ɗǝm ɗàng.>>","poem":2}]},{"type":"verse","number":15,"content":["Amǝ nggāliki mǝnana à kurkiyi wi kúró nǝ agir mǝnia, sǝ à kum gǝna malea arǝì ka, à nǝ̀ cam kuko, aɓa ɓangciu arǝ tanni mǝgule mǝnana sulǝo amurí ka. À nǝ̀ ɓua sǝ à nǝ̀ nggǝ keban amurí ama,",{"noteId":147}]},{"type":"verse","number":16,"content":[{"text":"<<Cau kwanban,","poem":1},{"text":"cau kwanban nǝ Babila,","poem":2},{"lineBreak":true},{"text":"nggea-là mǝgule!","poem":2},{"text":"Ɗiɗyal ka, kǝ oasǝ","poem":1},{"text":"anggubyau mā-murǝma","poem":2},{"text":"mǝnana à teǎ nǝ","poem":1},{"text":"nggubyau-linǝn mǝɓoarne ka.","poem":2},{"text":"Kǝ oasǝ agir gilǝki rǝǔ","poem":1},{"text":"mǝnana à peǎ nǝ bolo-njengǝlan,","poem":2},{"text":"andǝ atali-gǝna,","poem":1},{"text":"andǝ agir tà'nzama","poem":2},{"lineBreak":true},{"text":"mǝɓoarne ka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ndo ka, aɓa bu-pwari","poem":1},{"lineBreak":true},{"text":"mwashat,","poem":1},{"text":"à kiɗikina nggea kume","poem":2},{"text":"mǝgule male kat.>>","poem":1},"Koya mǝkwak waru-bǝsa andǝ aɓwana mǝnana kat à kǝ twal gya aɓa waru a nggeamùr, andǝ amǝtúró ɓá waru, andǝ aɓwana mǝnana kat túróbù ace kum gìr do la malea ka, nda a nggeamùr ka, à cam kuko.",{"noteId":148}]},{"type":"verse","number":18,"content":["Lang à sǝn yele mala pi mala mǝnia yì nggea-là ka, à loasǝ già à na ama,",{"text":"<<Ɓè kǝ nggea-là kàm","poem":1},{"text":"kǝla mǝnia yì nggea-là","poem":2},{"text":"mǝgule ka le?>>","poem":1}]},{"type":"verse","number":19,"content":["À pwan tú sǝ à soe amúrià, sǝ à mak'zwalo aban ɓua andǝ keban ama:",{"text":"<<Cau kwanban!","poem":1},{"text":"Cau kwanban nǝ","poem":2},{"text":"nggea-là mǝgule,","poem":1},{"text":"ban mǝnana amǝtala","poem":2},{"text":"awaru-bǝsa mǝnana","poem":1},{"text":"à kǝ gya a nggeamùr,","poem":2},{"lineBreak":true},{"text":"pǝlǝ amǝkume kàm ngga.","poem":2},{"text":"Aɓa bu-pwari mwashat,","poem":1},{"text":"kara à kiɗikini.","poem":2},{"noteId":149}]},{"type":"verse","number":20,"content":[{"text":"Wun mǝnana wu","poem":1},{"lineBreak":true},{"text":"do a kùli ka,","poem":1},{"text":"wu pak banɓoarnado amurí!","poem":2},{"text":"Wun aɓwana mala Ɓakuli,","poem":1},{"text":"andǝ amǝ'mishan,","poem":2},{"text":"andǝ amǝ'ɓangnǝa mala Ɓakuli,","poem":1},{"text":"wu pak banɓoarnado.","poem":2},{"text":"Acemǝnana Ɓakuli","poem":1},{"text":"pangŋǝni wi ɓashi","poem":2},{"text":"ace kǝ wun.>>","poem":1},{"noteId":150}]},{"type":"verse","number":21,"content":["Pǝlǝa ɓè mǝturonjar mǝ'rǝcandǝe imsǝ nggea tali mǝnana gulo male nda kǝla nggea taligo mǝgule ka. Yi túrí aɓa nggeamùr sǝ na ama,",{"text":"<<Kǝla mǝno ka,","poem":1},{"text":"sǝ à nǝ̀ túr nggea-là","poem":2},{"text":"Babila aɓa nggeamùr tsulǝm!","poem":1},{"lineBreak":true},{"text":"Sǝ à pà nǝ̀ nyare","poem":1},{"text":"à nǝ̀ sǝni ɗǝm ɗàng.","poem":2},{"noteId":151}]},{"type":"verse","number":22,"content":[{"text":"Agí ka zangŋan","poem":1},{"text":"andǝ amǝ'nggyal,","poem":2},{"text":"andǝ agí ka ntetu,","poem":1},{"text":"andǝ anjawe ka,","poem":2},{"text":"à pà nǝ̀ nyare","poem":1},{"text":"à nǝ̀ oea ɗǝm","poem":2},{"lineBreak":true},{"text":"a ɓālǝo ɗàng.","poem":2},{"text":"À pà nǝ̀ kum amǝ'túróbù","poem":1},{"text":"andǝ koya ulang túróbù","poem":2},{"lineBreak":true},{"text":"a ɓālǝo ɗǝm ɗàng.","poem":2},{"text":"À pà nǝ̀ nyare","poem":1},{"text":"à nǝ̀ ok gi gogô","poem":2},{"text":"nǝ taligo ɗǝm","poem":1},{"text":"a ɓālǝo ɗàng.","poem":2},{"noteId":152}]},{"type":"verse","number":23,"content":[{"text":"Tǎ mala pitǝla pà nǝ̀","poem":1},{"text":"nyare nǝ̀ tà ɗǝm","poem":2},{"lineBreak":true},{"text":"a ɓālǝo ɗàng.","poem":2},{"text":"À pà nǝ̀ nyare à nǝ̀ ok","poem":1},{"text":"giu banɓoarnado mala","poem":2},{"text":"amāfela andǝ abura-māfela","poem":1},{"text":"ɗǝm a ɓālǝo ɗàng.","poem":2},{"text":"Mǝnia ka pàk anggo","poem":1},{"text":"acemana amǝ nggāliki mò,","poem":2},{"text":"mǝnana à nda à kútìban kat","poem":1},{"text":"ɗiɗyal nǝ rǝcandǝa aɓa","poem":2},{"text":"kúrkúró andǝ ram gǝna","poem":1},{"text":"a ɓanza ka,","poem":2},{"text":"a ciá púp, nǝ́ agir","poem":1},{"text":"monzǝo","poem":2},{"noteId":153},{"text":"mô,","poem":2},{"text":"à swarkia aɓwana","poem":1},{"text":"arǝ anzali kat.","poem":2},{"noteId":154}]},{"type":"verse","number":24,"content":[{"text":"Aɓa nggea-là Babila ka,","poem":1},{"text":"à kum nkila mala","poem":2},{"text":"amǝ'ɓangnǝa mala Ɓakuli,","poem":1},{"text":"andǝ mala aɓwana","poem":2},{"text":"mala Ɓakuli,","poem":1},{"text":"andǝ aɓwana mǝnana kat","poem":2},{"text":"à wal-luia a ɓanza ka.>>","poem":1},{"noteId":155}]}],"footnotes":[{"noteId":138,"caller":"+","text":"Ɓalli gbal aɓa: Isha 21:9; Ir 50:39.","reference":{"chapter":18,"verse":2}},{"noteId":139,"caller":"+","text":"Ɓalli gbal aɓa: Ir 25:15,27.","reference":{"chapter":18,"verse":3}},{"noteId":140,"caller":"+","text":"Ɓalli gbal aɓa: Isha 48:20; Ir 50:8.","reference":{"chapter":18,"verse":4}},{"noteId":141,"caller":"+","text":"Ɓalli gbal aɓa: Ir 51:9.","reference":{"chapter":18,"verse":5}},{"noteId":142,"caller":"+","text":"Ɓalli gbal aɓa: Ang 137:8.","reference":{"chapter":18,"verse":6}},{"noteId":143,"caller":"+","text":"Ɓalli gbal aɓa: Isha 47:8-9.","reference":{"chapter":18,"verse":7}},{"noteId":144,"caller":"+","text":"Ɓalli gbal aɓa: Ezǝk 26:16-17.","reference":{"chapter":18,"verse":9}},{"noteId":145,"caller":"+","text":"Ɓalli gbal aɓa: Ezǝk 27:36.","reference":{"chapter":18,"verse":11}},{"noteId":146,"caller":"+","text":"Ɓalli gbal aɓa: Ezǝk 27:12-13,21.","reference":{"chapter":18,"verse":12}},{"noteId":147,"caller":"+","text":"Ɓalli gbal aɓa: Ezǝk 27:31,36.","reference":{"chapter":18,"verse":15}},{"noteId":148,"caller":"+","text":"Ɓalli gbal aɓa: Isha 23:14; Ezǝk 27:26-30.","reference":{"chapter":18,"verse":17}},{"noteId":149,"caller":"+","text":"Ɓalli gbal aɓa: Ezǝk 27:30-34.","reference":{"chapter":18,"verse":19}},{"noteId":150,"caller":"+","text":"Ɓalli gbal aɓa: Isha 44:23; Ir 51:48.","reference":{"chapter":18,"verse":20}},{"noteId":151,"caller":"+","text":"Ɓalli gbal aɓa: Ir 51:63; Ezǝk 26:21.","reference":{"chapter":18,"verse":21}},{"noteId":152,"caller":"+","text":"Ɓalli gbal aɓa: Isha 24:8; Ezǝk 26:13.","reference":{"chapter":18,"verse":22}},{"noteId":153,"caller":"+","text":"Agir monzǝo ka, kpapi pyauta aɓwana andǝ ɗikalú andǝ pakki aɓuri mala kiɗiki ɓwa ko wal-lú.","reference":{"chapter":18,"verse":23}},{"noteId":154,"caller":"+","text":"Ɓalli gbal aɓa: Ir 25:10.","reference":{"chapter":18,"verse":23}},{"noteId":155,"caller":"+","text":"Ɓalli gbal aɓa: Ir 51:49.","reference":{"chapter":18,"verse":24}}]},"thisChapterLink":"/api/mbu_tsc/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mbu_tsc/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mbu_tsc/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}