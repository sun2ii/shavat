{"translation":{"id":"mcb_wbt","name":"Iriniane Tasorintsi","website":"https://ebible.org/Scriptures/details.php?id=mcbNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mcbNT","licenseNotes":null,"shortName":"WBT","englishName":"Machiguenga NT","language":"mcb","textDirection":"ltr","sha256":"d68eea22e8c000ea21ebc492d5bd4c7287801a2a635b73c3af6857fdc8bf28d4","availableFormats":["json"],"listOfBooksApiLink":"/api/mcb_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7858,"languageName":"Machiguenga","languageEnglishName":"Machiguenga"},"book":{"id":"HEB","translationId":"mcb_wbt","name":"EVEREOEGI","commonName":"EVEREOEGI","title":"SANKEVANTI ITSIRINKAIGUNKANIRIRA EVEREOEGI","order":58,"numberOfChapters":13,"sha256":"8713c3bdc19acf9385277cade6635a825881298822cf3da3e266e60ef5fa3ab9","firstChapterNumber":1,"firstChapterApiLink":"/api/mcb_wbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/mcb_wbt/HEB/13.json","totalNumberOfVerses":293},"chapter":{"number":1,"content":[{"type":"heading","content":["Tasorintsi itigankakeri Itomi irogotagaigakaera"]},{"type":"verse","number":1,"content":["Pairani Tasorintsi inti iniaigake kamantantaigatsirira ikamantageigakerira posante, impo irirokya kamantaigavakeri yashikiiganakairira."]},{"type":"verse","number":2,"content":["Kantankicha maika inti itigankake Itomi irogotagaigakaera tyara ikanta, irirotari iniake pairani ikantakerira: “Notomi, viro vetsikagetakerone magatiro pashintagetakemparora.”"]},{"type":"verse","number":3,"content":["Yogari Tasorintsi inti pairorira ikametivageti. Yogari Itomi ikañotasanotakari, irirotari iatakotakera. Iriro shintagitearo magatiro, aikiro tsikyata inegintegetiro, pairotari yagaveavageti. Aroegi antiegi kañovageigacharira, kantankicha irirori yogavisaakoigakai isaankaigakaira akañovageigara. Impogini iatai enoku ipirinitaira inampinaku Tasorintsi irakosanoriraku."]},{"type":"heading","content":["Kirishito pairo yavisaigakeri isaankariite Tasorintsi"]},{"type":"verse","number":4,"content":["Yogari Kirishito pairo yavisaigakeri isaankariite Tasorintsi, intitari Itomi."]},{"type":"verse","number":5,"content":["Yogari Tasorintsi tera inkantumaigerinika isaankariite:",{"text":"“Virori vinti Notomi,","poem":1},{"lineBreak":true},{"text":"vikyaenka notomintaka maika.”","poem":1},"Aikiro tera inkantumate:",{"text":"“Yogari nosaankariite impegakena Iriri,","poem":1},{"lineBreak":true},{"text":"narokya pegakerine Notomi.”","poem":1}]},{"type":"verse","number":6,"content":["Kantankicha antari itigankakerira Itomi aka kipatsiku ikanti:",{"text":"“Maganiro nosaankariite irishineventaigakempari inkantaigakera: ‘Pairo ikametiti.’ ”","poem":1}]},{"type":"verse","number":7,"content":["Kantankicha antari iniakoigakerira isaankariite intagati ikantake:",{"text":"“Yogari nosaankariite onti nonkañotagaigakempari tampia,","poem":1},{"lineBreak":true},{"text":"aikiro onti inkañoigakemparo omorekatsantsaenkatira tsitsi.”","poem":1}]},{"type":"verse","number":8,"content":["Antari iniakerira Itomi ikanti:",{"text":"“Viro Notomi, pinkantakani pimpegakempara Igoveenkariegite maganiro gara pikaragiteakotumati,","poem":1},{"lineBreak":true},{"text":"omirinkatari pinegintetantavageti.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pairotari pishineventavagetaro kametiripage, irorokya pikisashivagetaka terira onkametite.","poem":1},{"lineBreak":true},{"text":"Irorotari nokavintsaantasanovagetakempirira nogishineakempira","poem":1},{"lineBreak":true},{"text":"navisakagaigakempiri maganiro pitentaigakarira,","poem":1},{"lineBreak":true},{"text":"nantitari Piri Tasorintsi.”","poem":1}]},{"type":"verse","number":10,"content":["Aikiro ikanti:",{"text":"“Virori vinti Itinkamiegi maganiro, vinti vetsikakerorira okyasanokyara kipatsi,","poem":1},{"lineBreak":true},{"text":"aikiro vinti vetsikakero inkite.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Impogini ompegagetanaempa magatiro povetsikagetakerira,","poem":1},{"lineBreak":true},{"text":"kantankicha virori pinkantakani pintimake.","poem":1},{"lineBreak":true},{"text":"Magatiro ogantagagetanake onkañogetanakero ogantagagetira manchakintsi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Pampitivigetakero pinkañotagagetakerora apitivigetaganira manchakintsi,","poem":1},{"lineBreak":true},{"text":"aikiro pimpugakagagetaero pashini okyarira pinkañotagakemparo manchakintsi osapokaganira pashinikya ogagutaagani.","poem":1},{"lineBreak":true},{"text":"Kantankicha viro gara pikantatigumata","poem":1},{"lineBreak":true},{"text":"ontiri aikiro gara pikaragiteakotumati.”","poem":1}]},{"type":"verse","number":13,"content":["Tasorintsi tera inkantumateri isaankariite ikantakeririra Itomi:",{"text":"“Pirinite nonampinaku nakosanoriraku","poem":1},{"lineBreak":true},{"text":"kigonkero nagaveaigakerira maganiro kisashiigakempirira.”","poem":1}]},{"type":"verse","number":14,"content":["Maganirotari isaankariite onti itimashiigake iromperaigakemparira. Iriroegi onti isaankaigake mameri ivatsa. Omirinka itigankaigiri irimutakoigakerira maganiro irogavisaakoigakenkanirira."]}],"footnotes":[]},"thisChapterLink":"/api/mcb_wbt/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mcb_wbt/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mcb_wbt/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}