,{"type":"verse","number":7,"content":["ኪኢታንቾ ዛሎ'' ጋዓንቴ፦",{"text":"«ኪኢታንቾ ዢባሬ፥","poem":1},{"text":"ዒዛም ማዻ ዓሶዋ ታሚ ሎስቶ ታ ማሃንዳኔ» ጌዔኔ።","poem":2}]},{"type":"verse","number":8,"content":["ፔ ናዓሢ ዛሎ'' ጋዓንቴ፦",{"text":"«ፆኦሲዮ! ኔኤኮ ካኣቱሞ ዖይታ'' ናንጊና ባይቁዋዖ ናንጋንዳኔ፤","poem":1},{"text":"ኔኤኮ ካኣቱሞ ፂሉ''ሞና ኔ ዔኪ ዓኣዻንዳኔ፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፂሉ''ሞ ኔ ናሽኪ ፑርቱሞ ኔ ዒፄኔ፤","poem":1},{"lineBreak":true},{"text":"ዬያሮ ፆኦሲ፥ ኔ ፆኦዛሢ ኔና ዶኦሬኔ፤","poem":1},{"text":"ኔኤኮ ላጎይዳፓ ባሼ ዎዛ ዺቢሺ ኔኤም ዒዚ ዒንጌኔ» ጌዔኔ።","poem":2}]},{"type":"verse","number":10,"content":["ዬያጉዲ ሃሣ፦",{"text":"«ጎዳሢዮ! ኔኤኒ ቤርታ ሳዖ ማዤኔ፤","poem":1},{"text":"ጫሪንጮዋ ኔ ኩቻ ኔ ማዤያኬ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዬያታ ቢያ ባይቃንዳኔ፤","poem":1},{"lineBreak":true},{"text":"ኔኤኒ ጋዓንቴ ናንጊና ናንጋንዳኔ፤","poem":1},{"text":"ዔያታ ዓፒላጉዲ ጪንቃንዳኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሃሣ ኔ ዔያቶ ዼኤፒ ኮኦቴጉዲ ጳንጫንዳኔ፤","poem":1},{"text":"ዓፒላጉዲ ዔያታ ላኣሚንታንዳኔ፤","poem":2},{"text":"ኔኤኒ ጋዓንቴ ቢያ ዎዴ ኔናኬ፤","poem":1},{"text":"ፔቴ''ታዖ ኔ ጋርቹዋያኬ» ጋዓኔ።","poem":2}]},{"type":"verse","number":13,"content":["ፆኦሲ ፔኤኮ ኪኢታንቾ ባኣካ''ፓ፦",{"text":"«ኔ ሞርኮ ታ ኔና ባሺሳንዳያ ሄላ''ንዳኣና","poem":1},{"text":"ታኣኮ ሚዛቆ ዛላ'' ዴዔ» ጌዔያ ፔቴ''ታዖ ባኣሴ።","poem":2}]},{"type":"verse","number":14,"content":["ዓካሪ ኪኢታንቻ ዻቃዞንሢ ማኣዳ''ኒ ፆኦሲፓ ዳኪንቲ ማዻ፥ ዓያኖቱዋዓዳ?"]}],"footnotes":[]},"thisChapterLink":"/api/mdy_bse/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_bse/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_bse/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}