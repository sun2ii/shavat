{"translation":{"id":"mdy_bse","name":"Maale New Testament","website":"https://ebible.org/Scriptures/details.php?id=mdybse","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdybse","licenseNotes":null,"shortName":"BSE","englishName":"Maale NT","language":"mdy","textDirection":"ltr","sha256":"d68011cd7ed1cf8bfbbb54c98810b4d600332bbfa1c8b8911d414ce99ab32839","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_bse/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7943,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"REV","translationId":"mdy_bse","name":"ዮሓኒሴም ፆኦሲ ፔጋሲ ዻዌ ባኮ","commonName":"ዮሓኒሴም ፆኦሲ ፔጋሲ ዻዌ ባኮ","title":"ዮሓኒሴም ፆኦሲ ፔጋሲ ዻዌ ባኮ","order":66,"numberOfChapters":22,"sha256":"cf1cdd58e8ac8e599aa1e60ec99af348541d8b18f3003b754e04fd7c34545f2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_bse/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/mdy_bse/REV/22.json","totalNumberOfVerses":401},"chapter":{"number":15,"content":[{"type":"heading","content":["ጋፒንፆ ማዔ ባይዛ ባኮ ዔኪ ዓኣ ኪኢታንቾንሢ"]},{"type":"verse","number":1,"content":["ዬካፓ ሜሌ'' ዼኤፒ ሃሣ ዲቃሢ ሄርሺሳ ማላታ ጫሪንጫ ታ ዛጌኔ፤ ዬይያ፦ ፆኦሲ ዻጋ'' ዔያቶና ኩማያ ማዔ፥ ላንካይ ባይዛ ባኣዚ'' ዔኪ ዓኣ፥ ላንካይ ኪኢታንቾ ታ ዛጌኔ።"]},{"type":"verse","number":2,"content":["ዒማ''ና ሃሣ ታሚ ሲኢሪንቴያ ሌማሌኤሼ ባዚ'' ማላያ ታ ዴንቄኔ፤ ዒኢካ ባዞ'' ዓጫ ቦዓሢና ቦዓሢኮ ማላቶና ሃሣ ዒዛ ሱ'ንፆ ፓይዶ'' ዖሊ ባሼ ዓሳ ዔቂ ዓኣንቴ ታ ዴንቄኔ፤ ዔያታ ፆኦሲዳፓ ዒንጊንቴ ጎኦላ'' ዔኪ ዓኣኔ፤"]},{"type":"verse","number":3,"content":["ዔያታ ፆኦሲም ማዻ፥ ሙሴ ዓይኑሞና ማራዓሢናኮ ዓይኑሞ፦",{"text":"«ቢያ ባኣዚ'' ዳንዳዓ ጎዳ ማዔ ፆኦዛሢዮ!","poem":1},{"text":"ማዻ'' ኔኤኮ ዼኤፒ ሃሣ ዲቃሢ ሄርሺሳያኬ፤","poem":2},{"text":"ሚርጌ ዴሮ''ኮ ካኣታ''ሢዮ!","poem":1},{"text":"ኔኤኮ ጎይፃ ፒዜ ሃሣ ጎኔኬ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጎዳሢዮ! ኔና ዒጊጩዋያ","poem":1},{"text":"ሓሣ ሱ'ንፆዋ ኔኤኮ ቦንቹዋይ ዖናዳይ?","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ሌሊ ዱማዼያኬ።","poem":2},{"text":"ኔኤኮ ፒዜ ማዻ'' ፔጋዺ ዔርቴሢሮ","poem":1},{"text":"ዺቦ'' ዴራ'' ቢያ ሙኪ ኔ ቤርታ ኔኤም ዚጋንዳኔ»","poem":2},"ጌዒ ጌዒ ዓይናዻኔ።"]},{"type":"verse","number":5,"content":["ዬካፓ ሃሣ ዓፒላና ማዢንቴ፥ ፆኦሲም ዱማዼ፥ ጌኤሺ ማኣሪ ጫሪንጫ ቡሊ''ንቲ ዓኣንቴ ታ ዛጌኔ፤"]},{"type":"verse","number":6,"content":["ዒማ''ና ላንካዎ ባይዛ ባኮንሢ ዔኪ ዓኣ፥ ላንካይ ኪኢታንቻ ጌኤዦ ማኣራፓ ኬስኬኔ፤ ዬያታ ዓኣፒዳ ዱካ ቦኦሬ ማኣዖ ማይንቲ ዓኣኔ፤ ሃሣ ዳዶ''ይዳኣ ዎርቄና ኮሺ''ንቴ ቃልሾ ቱኡቲ ዓኣኔ።"]},{"type":"verse","number":7,"content":["ዬኖና ዖይዶ ባኮንሢዳፓ ፔቴ''ሢ ናንጊና ናንጋ ፆኦዛሢኮ ዻጋ'' ኩሚ ዓኣ፥ ዎርቆና ኮሺ''ንቴ ላንካይ ዑሺ ዓንጊ ላንካዎ ኪኢታንቾንሢም ዒንጌኔ፤"]},{"type":"verse","number":8,"content":["ሃሣ ጌኤዦ ማኣራ ፆኦሲኮ ቦንቾና ዎልቆናይዳፓ ኬስካ ጩቦ''ና ኩሜኔ፤ ላንካዎ ኪኢታንቾንሢኮ ላንካዎ ባይዛ ባኮንሢ ማዺንቲ ኩማንዳያ ሄላ''ንዳኣና ዖኦኒያ ጌኤዦ ማኣሮ ጌላኒ ዳንዳዒባኣሴ።"]}],"footnotes":[]},"thisChapterLink":"/api/mdy_bse/REV/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_bse/REV/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_bse/REV/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}