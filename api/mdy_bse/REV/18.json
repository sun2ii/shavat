{"translation":{"id":"mdy_bse","name":"Maale New Testament","website":"https://ebible.org/Scriptures/details.php?id=mdybse","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdybse","licenseNotes":null,"shortName":"BSE","englishName":"Maale NT","language":"mdy","textDirection":"ltr","sha256":"d68011cd7ed1cf8bfbbb54c98810b4d600332bbfa1c8b8911d414ce99ab32839","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_bse/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7943,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"REV","translationId":"mdy_bse","name":"ዮሓኒሴም ፆኦሲ ፔጋሲ ዻዌ ባኮ","commonName":"ዮሓኒሴም ፆኦሲ ፔጋሲ ዻዌ ባኮ","title":"ዮሓኒሴም ፆኦሲ ፔጋሲ ዻዌ ባኮ","order":66,"numberOfChapters":22,"sha256":"cf1cdd58e8ac8e599aa1e60ec99af348541d8b18f3003b754e04fd7c34545f2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_bse/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/mdy_bse/REV/22.json","totalNumberOfVerses":401},"chapter":{"number":18,"content":[{"type":"heading","content":["ባብሎኔ ካታሞኮ ሎኦሚፆ"]},{"type":"verse","number":1,"content":["ዬካፓ ሃሣ ዼኤፒ ቢታንቶ ዓኣ፥ ሜሌ'' ኪኢታንቾስኬይ ጫሪንጫፓ ኬዳ''ንዳቴ ታ ዛጌኔ፤ ዒዛኮ ቦንቾ ፖዖ ሼኤሪፃፓ ዔቄያና ሳዓ ፖዔኔ፤"]},{"type":"verse","number":2,"content":["ዒዚ ዼኤፒ ዑኡሲና፦",{"text":"«ዼኤፖ፥ ባብሎኔ ካታሜላ ሎኦሜኔ! ሎኦሜኔ!","poem":1},{"text":"ፃላሄኮዋ ናንጊ ቤሲ ማዔኔ!","poem":2},{"lineBreak":true},{"text":"ሃሣ ፑርቶ ዓያኖኮዋ ዎይሢ ቤሲ ማዔኔ፤","poem":2},{"text":"ፑርታ ሃሣ ሻኣካያ ማዔ፥ ካፖኮ ቢያ","poem":1},{"text":"ዎይሢ ቤሲ ማዔኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዴራ'' ቢያ ዒዞኮ","poem":1},{"text":"ፑርቶ ሱኡኮ ማዾ'' ዑዦ ዑሽኬኔ፤","poem":2},{"lineBreak":true},{"text":"ዓጮ'' ካኣታ'' ዒዞና ዎላ'' ዞኦዛ ኮኦሜኔ፤","poem":2},{"text":"ሃሣ ዓጮ''ይዳ ኮርሞ ኮርማ ዓሳኣ","poem":1},{"text":"ዑሣ ዓኣዼ ዒዛ ሳኣ ናንጊም ጊኢጋያታሢሮ ዖርጎጬኔ»","poem":2},"ጌዒ ዒላቴኔ።"]},{"type":"verse","number":4,"content":[{"text":"ሓሣ ሜሌ'' ዑኡሲ ጫሪንጫፓ፦","poem":1},{"text":"«ታ ዴሬዮቴ! ዒዛ ማዻ ጎሞ ዒንሢ ማዹዋጉዲ","poem":2},{"lineBreak":true},{"text":"ዒዞም ዓጎና ባይሲንቶና ዒንሢያ ባይቁዋጉዲ፤","poem":2},{"text":"ዒዞይዳፓ ኬስኩዋቴ።","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ዓይጎሮ ጌዔቴ ጎማ ዒዞኮ ኩሊንቲ","poem":1},{"text":"ጫሪንጮ ሄሌ''ሢሮ","poem":2},{"text":"ፆኦሲ ዒዞኮ ፑርቱሞ ጶቂሤሢሮኬ።","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ዒዛ ዒንጌማጉዲ ማሂ ዒንጉዋቴ፤","poem":1},{"text":"ዒዛ ማዼ ማዾ''ኮዋ ጳንጬ ዒዞም ማሁዋቴ፤","poem":2},{"text":"ዒዛ ሲኢሪ ዒንጌ ዑዦ፥ ጳንጬ ማሂ","poem":1},{"text":"ሲኢሪ ዒዞም ዒንጉዋቴ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዒዛ ፔና ቦንቺሲ ሳኣ ናንጊም ጊኢጋያ ማሄማጉዲ","poem":1},{"text":"ዒዞ ሜታሲ ዖዪሱዋቴ፤","poem":2},{"text":"ዒዛ ፔኤኮ ዒኖና፦","poem":1},{"lineBreak":true},{"text":"‹ታኣኒ ካኣቲ ማዒ ዴዔኔ፤","poem":1},{"text":"ዓኒ ታኣኮ ሓይቄያቱዋሴ፤","poem":2},{"lineBreak":true},{"text":"ፔቴ''ታዖ ዖዪያ ታ ዖዩዋሴ›","poem":2},"ጌዒ ጌዒ ሄርሺንታኔ።"]},{"type":"verse","number":8,"content":[{"text":"ዬያሮ ዒዞም ዓጎና ባይሲንታ","poem":1},{"text":"ፔቴ'' ኬሊ'' ዒዞ ሄላ''ንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሓይቢና ዖዪሢና ናይዚና ዒዞ ሄላ''ንዳኔ፤","poem":2},{"text":"ዒዞይዳ ዎጋ ጎዳ ማዔ ፆኦዛሢ ዼኤፒ ማዔሢሮ","poem":1},{"text":"ታሚና ዒዛ ሚቺንታንዳኔ»","poem":2},"ጋዓንቴ ታ ዋይዜኔ።"]},{"type":"verse","number":9,"content":["ዒዞና ዎላ'' ዞኦዛ ኮኦሚ፥ ጊኢጋ ናንጊ ናንጌ፥ ሳዖ ካኣታ'' ዒዛ ሚቺንታ ዎዶ''ና ኬስካ ጩቦ'' ዛጊ ዒዞሮ ዒላቲ ዒላቲ ዬኤካንዳኔ።"]},{"type":"verse","number":10,"content":["ዔያታ ዒዞይዳ ሄሌ'' ሜታሢ ዛጎ ዒጊጪ፥ ሃኬ ዔቂ፦",{"text":"«ኔኤኒ ሓና'' ዼኤፖ ካታሜሌ!","poem":1},{"text":"ኔኤኒ ሓና'' ፑኡፒ ማዔ፥ ባብሎኔ!","poem":2},{"text":"ፑርቶ ዎጋ'' ኔ ጊዳ'' ዑኬና ሙኬሢሮ","poem":1},{"text":"ባዴዔ ኔና! ባዴዔ ኔና!»","poem":2},"ጋዓንዳኔ።"]},{"type":"verse","number":11,"content":["ዔያቶኮ ዋኣፆ ካኣሚላ ጫኣኔ ባኮ ሃካፓ ሴካ ሻንቃ ዓሲ ባኣሢሮ፥ ሳዖይዳ ኮርሞ ኮርማ ዓሳ ዒዞ ዛሎ'' ዬኤኪ ዖያንዳኔ፤"]},{"type":"verse","number":12,"content":["ዔያታ ዋኣፆ ካኣሚሎይዳ ጫኣኔ ባካ፦ ዎርቄ፥ ቢራ ዓንጊ፥ ቦንቺንታ ሹቺ፥ ሚዛጲ ሹቺ፥ ቦኦሬ ሻኣዣ ዓፒላ፥ ጮልዔ ዲንኪ ማኣዓ፥ ሱኡፔ ዓፒላ፥ ዞቄ ዓፒላ፥ ቃራ ሳውቃ ዱማ ዱማ ሚሢ፥ ዳርሲ ዓቺንታ ሚርጌ ሚኢሼ ዔካ ሚሢንታ ሞኦና ዓንጊንታ ሜሌ'' ዓንጎንታ ቦኦሬ ሚዛጶ ሹጮንታይዳፓ ኮሺ''ንቴ ባካ ቢያ፥"]},{"type":"verse","number":13,"content":["ሳውቃ ሚሢ ቁኡሪ፥ ዱማ ዱማ ሳውቃ ዼኤሻ፥ ካርቤ፥ ቲሺ፥ ዑንጄ፥ ዎይኖ ዑዣ፥ ሪሚቶ ዛይታ፥ ሺኢቺ ዺኢሊ፥ ዛርጌ፥ ባይ፥ ማራይ፥ ፓራ፥ ሳርጌላ ዖይታ፤ ዬያጉዲ ሃሣ ዓይሎ'' ማዔ ዓሶንታ ዖሎና ዲዒ ዔኮና ዓሶንታኬ።"]},{"type":"verse","number":14,"content":["ዬንሢ ኮርሞ ኮርማዞንሢ፦ «ኔኤኒ ናሽካ ኮዦ ባካ ቢያ ኔ ጊዳ''ፓ ቤቲ፥ ዴንዴኔ፤ ኔኤኮ ዖርጎቹሞና ፓልሞና ቢያ ባይቄኔ፤ ማይ ዬይ ባካ ኔኤም ጊንሣ ጴዻዓኬ» ዒዞም ጋዓኔ።"]},{"type":"verse","number":15,"content":["ዬያ ባኮ ዒዞይዳፓ ሻንቂ ኮርሚ ዖርጎጬ ኮርማ ዓሳ ዒዞይዳ ሄሌ'' ሜቶ'' ዒጊጪሢና ሃኬ ዒዞኮ ዔቃንዳኔ፤ ሃሣ ዔያታ ዒዞ ዛሎ'' ዬኤኪ ዬኤኪ ዖያንዳኔ፤"]},{"type":"verse","number":16,"content":["ዑኡዞዋ ዔያታ ዼ'ጊዲ፦",{"text":"«ሻኣዦ ዓፒሎንታ ዲንኮ ዞቄ ዓፒሎንታ ማይንታዞ","poem":1},{"text":"ዎርቆና ሚዛጶ ሹጮና ፓልሚንቴዞ","poem":2},{"lineBreak":true},{"text":"ዼኤፖ፥ ካታሜሎ ባብሎኔም ባዴዔ! ባዴዔ!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዬይ ቆላ'' ቢያ ኔጉዋዖ ኔኤኮ ባይቂባይ!» ጋዓንዳኔ።","poem":1},"ዋኣፆ ካኣሚሎኮ ሱኡጋ ቢያ፥ ዋኣፆ ካኣሚሎ ቶጊ ዓኣዻ ዓሳ ቢያ፥ ዋኣፆ ካኣሚሎይዳ ማዻ ዓሶንታ ባዞ'' ዑፃ ሃንቲ ሃንቲ ኮርማ ዓሳ ቢያ ዒዞኮ ሃኬ ዔቃንዳኔ፤"]},{"type":"verse","number":18,"content":["ዒዛ ሚቺንታኣና ኬስካ ጩቦ'' ዛጋዖ፦ «ሃኖ' ዼኤፖ ካታሜሎጉዴያ ሜሌ'' ካታማ ዎካዳይ?» ጌይ ጌይ ዔያታ ዒላቴኔ።"]},{"type":"verse","number":19,"content":["ሃሣ ዔያታ ፔኤኮ ቶኦካ'' ሲላሊ ዋሂ፥ ዖዪ ዬኤኪ ዬኤኪ፦",{"text":"«ባዞ''ይዳ ዋኣፆ ካኣሚላ ዓኣ ዓሳ ቢያ","poem":1},{"text":"ዒዞ ቆሎ''ና ዖርጎጬ ዓሳ","poem":2},{"text":"ዼኤፖ ካታሜላ ዑኬና፥ ኔጉዋዖ ባይቄሢሮ","poem":1},{"lineBreak":true},{"text":"ባዴዔ! ባዴዔ!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ጫሪንቺዮ! ዒዛ ባይቄሢሮ ዎዛዼ፤","poem":1},{"text":"ዒንሢ ፆኦሲም ዱማዼዞንሢና ፆኦሲ ማዾ''ም ዳኪንቴዞንሢዮ","poem":2},{"lineBreak":true},{"text":"ሓሣ ፆኦሲ ማሊፆ ኬኤዛዞንሢዮ ዎዛዹዋቴ፤","poem":2},{"text":"ዓይጎሮ ጌዔቴ፦","poem":1},{"text":"ፆኦሲ ዒንሢዳ ዒዛ ሄሊ''ሴ ሜቶ''ሮ ጌዒ","poem":2},{"lineBreak":true},{"text":"ዒዞ ፑርታና ዎጌኔ» ጌይ ጌይ ዒላቴኔ።","poem":2}]},{"type":"verse","number":21,"content":["ዬካፓ ሃሣ ፔቴ'' ዼኤፒ ኪኢታንቻስኬይ ፑኡፒ ዎንሢ ሹቺጉዴ ሹቺ ዔኪ ባዞ''ይዳ ኬኤራዖ፦ «ዼኤፖ ካታሜላ፥ ባብሎኔ ሓኣዺዲ ዎልቄና ኬኤሪንታንዳኔ፤ ሓካፓ ሴካ ዒዛ ጴዻዓኬ፤"]},{"type":"verse","number":22,"content":[{"text":"ጎኦሎ'' ዋርቃ ዓሶንታ ዓይኑሞ ዓይናዻ ዓሶ ዑኡዛ","poem":1},{"text":"ሹሉንጎንታ ዛያሢንታ ዋርቃ ዓሶ ዑኡዛ","poem":2},{"lineBreak":true},{"text":"ላሚ ኔ ጊዳ'' ማይ ዋይዚንታዓኬ፤","poem":2},{"text":"ዱማ ዱማ ባኣዚ'' ሃኣማቶና ማዻ ዓይጎ ዓሲያ","poem":1},{"text":"ሃይፓ ሴካ ኔ ጊዳ'' ጴዻዓኬ፤","poem":2},{"lineBreak":true},{"text":"ዎንሢ ዎዺንታያኣ ማይ ኔ ጊዳ'' ዋይዚንታዓኬ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ፖዓ፥ ፖዒያ ኔ ጊዳ''","poem":1},{"text":"ሓይፓ ሴካ ፖዓዓኬ፤","poem":2},{"lineBreak":true},{"text":"ዔፒ ሃይሴያ ሃይፓ ሴካ ኔ ጊዳ'' ዋይዚንታዓኬ።","poem":2},{"text":"ኔ ዓጮ''ኮ ኮርሞ ኮርማ ዓሳ","poem":1},{"text":"ዓጮ'' ቢያይዳ ዔርቴ ዼኤፖ ዓሶኬ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ማርሾና ዓሶ ቢያ ኔ ዻቢሼኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዒዞይዳ ፆኦሲ ማሊፆ ኬኤዛዞንሢንታ","poem":1},{"text":"ፆኦሲም ዱማዼዞንሢንታ","poem":2},{"lineBreak":true},{"text":"ሳዖይዳ ዎዺንቴ ዓሶኮዋ ቢያ ሱጉፃ ጴዼኔ» ጌዔኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_bse/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_bse/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_bse/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}