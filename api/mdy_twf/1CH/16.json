{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"1CH","translationId":"mdy_twf","name":"1 ፆኦሲ ዓሶ ሃይሶ","commonName":"1 ፆኦሲ ዓሶ ሃይሶ","title":"1 ፆኦሲ ዓሶ ሃይሶ ኬኤዛ ማፃኣፖ","order":13,"numberOfChapters":29,"sha256":"e321ce0af4bdac720495cef1aa04b25870db7bbb39faebd40b2943622ec51860","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/mdy_twf/1CH/29.json","totalNumberOfVerses":830},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":["ዔያታ ዒማና ጫኣቁሞ ሳኣፂኖ ዳውቴ ጊኢጊሼ፥ ዓፒሎና ማዢንቴ ማኣራ ጌሤኔ፤ ዬካፓ ሚቺ ዒንጎ ዒንጊፆንታ ፔቱሞና ዒንጎ ዒንጊፆዋ ዔያታ ፆኦሲም ሺኢሼኔ፤"]},{"type":"verse","number":2,"content":["ዳውቴ ዬያ ባኮ ዒንጌስካፓ ናንጊና ናንጋ ጎዳ ሱንፆና ዴሮ ዓንጄኔ፤"]},{"type":"verse","number":3,"content":["ዬካፓ ዒስራዔኤሌ ዓሶኮ ዓቲንቆንታ ላኣሎንታም፥ ፔቴ ፔቴ ዓሶም ቢያ ፔቴ ፔቴ ሙሊሢ ላኣዳ ቲቂሢ ዓሽኪንታ ዎይኔ ዺንቆናያይዳፓኣ ዻካ ዒንጌኔ።"]},{"type":"verse","number":4,"content":["ፆኦሲኮ ጫኣቁሞ ሳኣፂኖኮ ቤርታ ማዒ ማዻንዳጉዲና ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢም ጋላታንታ ሄርሺሢንታ ቦንቾዋ ዒንጊ ዒንጊ ፆኦዛሢ ካኣሽኮ ካኣዦ ዳምቦ ማዺሻንዳጉዲ ሌዊ ዓሶይዳፓ ዳውቴ ዶኦሬኔ።"]},{"type":"verse","number":5,"content":["ዒማና ዓሳኣፔ ሱኡጋሢኬ፤ ዛካሪያሴ ዒዛኮ ዴማ ማኣዲ ማዻሢ ማዒ ዶኦሪንቴኔ፤ ዬካፓ ዪዒዔኤሌ፥ ሼሚራሞቴ፥ ዪሂዔኤሌ፥ ማቲትያ፥ ዔሊዓቤ፥ ቤናያ፥ ዖቤድዔዶኦሜንታ ዪዒዔኤሌንታ ጎኦሎ ዋርቃንዳጉዲ፤ ዓሳኣፔ ሃሣ ዑኡቱቡላሢ ዎቻንዳጉዲ ጌይንቴኔ፤"]},{"type":"verse","number":6,"content":["ቤናያና ያሃዚዔኤሌና ጌይንታ ላምዖ ቄኤሶንሢ ጫኣቁሞ ሳኣፂኖኮ ቢያ ዎዴ ቤርቶ ዛሎና ዛዬ ዋርቃንዳጉዲ ጌይንቴኔ፤"]},{"type":"verse","number":7,"content":["ዓሳኣፔንታ ሃንጎ ዒዛኮ ዒጊኖ ሌዊ ዓሶንታ ናንጊና ናንጋ ጎዳም ማዓ ጋላታ ዓይኑሞ ሺኢሻንዳጉዲ ዳውቴ ሱኡጌ ማሂ ዔያቶ ዶኦሬሢ ዒማናኬ።"]},{"type":"heading","content":["ዳውቴኮ ፆኦሲ ጋላቶ ዓይኑሞ"]},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳ ጋላቱዋቴ፤","poem":1},{"text":"ዒዛ ሱንፆ ዔኤሊ ሺኢቁዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዒ ማዼ ባኮ ዴሮ ቢያሢም ኬኤዙዋቴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ናንጊና ናንጋ ጎዳም ጋላታ ዓይኑሞ ዓይናዹዋቴ፤","poem":1},{"text":"ዒ ማዼ ዲቃሢ ሄርሺሳ ማዾ ቢያ ኬኤዙዋቴ፤","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዒዛኮ ዱማዼ ሱንፆና ዎዛዹዋቴ!","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ኮዓዞንሢ ቢያ ዎዛዾንጎ!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዒዛኮ ማኣዳሢ ዴንቃኒ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ኮዑዋቴ፤","poem":2},{"lineBreak":true},{"text":"ቢያ ዎዴ ዒዛም ዚጊ ካኣሽኩዋቴ፤","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዒዛም ማዻያ ማዔ፥ ዒስራዔኤሌ ናኣቶንሢዮ!","poem":1},{"text":"ፆኦሲ ዶኦሬያ ማዔ ያይቆኦቤ ናኣቶንሦ!","poem":2},{"lineBreak":true},{"text":"ፆኦሲ ማዼ ዲቃሢ ሄርሺሳ ባኮ","poem":2},{"lineBreak":true},{"text":"ዒዚ ዎጌ ዎጊፆንታ","poem":2},{"lineBreak":true},{"text":"ዒ ፔ ዎልቆና ማዼ ማዾ ጶቂሡዋቴ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ናንጊና ናንጋ ጎዳ ኑኡኮ ፆኦዛሢኬ፤","poem":1},{"text":"ዒዚ ዓጮ ቢያይዳ ፒዜ ዎጌ ዎጋኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዒዛኮ ጫኣቁሞ ዋሊፖቴ፤","poem":1},{"text":"ዒ ዓይሤ ባኮ ዴንዲ ሺያ ሾይንቲ ሄላንዳኣና","poem":2},{"lineBreak":true},{"text":"ፆኦሲ ኬኤዜ ሃጊ ማዓንዳ ዎዞ ቃኣሎ ናንጊና ዶዲሺ ካፓኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዒ ዓብራሃሜና ዎላ ጫኣቄ ጫኣቁሞ ካፓኔ፤","poem":1},{"text":"ዪሳኣቄም ኬኤዜ ሃጊ ማዓንዳ ዎዞ ቃኣሎዋ ዶዲሻኔ፤","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ያይቆኦቤም ዳምቤ ማሂ ዶዲሼኔ፤","poem":1},{"text":"ዒስራዔኤሌማኣ ጋፒንሢባኣ ጫኣቁሞ ጫኣቄኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ዬይ ጫኣቁማ፦","poem":2},{"lineBreak":true},{"text":"«ካኣናኔ ዓጮ ታ ኔኤም ዒንጋንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ኔኤም ዒንጊንቴ ቤሲ ማዓንዳኔ» ጋዓያኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ያዺ ጌይንቴሢ ፆኦሲኮ ዓሳ ፓይዶና ዻካ ዓኣንቴ","poem":1},{"text":"ካኣናኔ ዓጮይዳ ዔያታ ሾኦቺ ማዒ ዓኣንቴኬ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ፔቴ ዴሮ ኮራፓ ሜሌ ዴሮ ባንሢ","poem":1},{"text":"ፔቴ ዓጮይዳፓ ሜሌ ዓጪ ባንሢ","poem":2},{"lineBreak":true},{"text":"ሃንቲ ሃንቲ ዔያታ ሜታዼኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ፆኦሲ ጋዓንቴ ዖኦኒያ ዔያቶ ሄርቂ ዎይሦም ጌይባኣሴ፤","poem":1},{"text":"ዔያቶሮ ጌይ ካኣቶ ጎሬኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"«ታ ዶኦሚ ቲሽኬዞንሢ ካኣሚፖቴ፤","poem":1},{"text":"ታ ማሊፆ ኬኤዛዞንሢዳ ፑርታ ማዺፖቴ» ጌይ ዔያቶም ላቴኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ሳዖይዳ ናንጋ ዴራ ቢያ ናንጊና ናንጋ ጎዳ ጋላቱዋቴ!","poem":1},{"text":"ዓውሲፆ ዒዛኮ ኬላ ኬላ ኬኤዙዋቴ፤","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ካኣቶም ቢያ ዒዛኮ ቦንቾ ዔርዙዋቴ፤","poem":1},{"text":"ሜሌ ዴሮም ቢያ ዒዛኮ ዼኤፖ ማዾ ኬኤዙዋቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዼኤፒኬ፤","poem":1},{"text":"ፑኡፒ ጋላታ ዒዛም ኮይሳኔ፤","poem":2},{"lineBreak":true},{"text":"ሜሌ ካኣሽኮ ፆኦዛፓ ቢያ ባሼ ዒጊጪንታንዳያ ኮይሳኔ፤","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ሃንጎ ዴራ ዚጊ ካኣሽካሢ ሜሌ ፆኦዞኬ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ጋዓንቴ ጫሪንጮ ማዤ ፆኦሲኬ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዒዛኮ ኮይሎይዳ ዓኣ ባካ ቦንቾና ዼኤፑሞናኬ፤","poem":1},{"text":"ዒዛም ዱማዼ ማኣሮዋ ዎልቄና፥ ሃሣ ዎዛና ዒ ኩንሤኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ዒንሢ ሳዖይዳ ናንጋ ዴራ ቢያ!","poem":1},{"text":"ዒዛኮ ቦንቾንታ ዎልቆንታሮ ናንጊና ናንጋ ጎዳ ጋላቱዋቴ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ዒዛ ሱንፆም ኮይሳ ቦንቾ ሺኢሹዋቴ፤","poem":1},{"text":"ዒዛኮ ጌኤዦ ማኣሮ ዒንጎ ባኣዚ ዔኪ ዬዑዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዱማዼያ ማዔ ፆኦዛሢ ፔጋዺ ጴዻኣና ዒዛም ዚጊ ካኣሽኩዋቴ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ሳዖ ዴራ ቢያ ዒዛ ቤርታ ጎጋይቁዋቴ!","poem":1},{"text":"ሳዓ ዶዲሺ ማዢንቴሢሮ ዓጊፂንዱዋሴ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ሳዖንታ ጫሪንጮንታ ዎዛዹዋቴ!","poem":1},{"text":"ሜሌ ዴሮም ቢያ ናንጊና ናንጋ ጎዳ ካኣቲታሢ ዔርዙዋቴ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ባዞንታ ዒኢካ ዓኣ ባካ ቢያ ዒላሹዋቴ!","poem":1},{"text":"ጎዦንታ ዬያይዳ ዓኣ ባካ ቢያ ዎዛዹዋቴ!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሳዖይዳ ዎጋኒ ሙካንዳሢሮ","poem":1},{"text":"ዴኤሎይዳ ዓኣ ሚፃ ዒዛም ዒላሾንጎ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"ዒዚ ኮሺታሢሮ ናሹማ ዒዛኮ ናንጊና ባይቁዋኣሢሮ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ጋላቱዋቴ!","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ናንጊና ናንጋ ጎዳ፦","poem":1},{"text":"«ኑና ዓውሳ ፆኦዛሢዮ!","poem":2},{"lineBreak":true},{"text":"ሜሌ ዴሮ ባኣካፓ ማሂ ዔኪ ኑ ዓጮ ኑና ጌልዜ፤","poem":2},{"text":"ያኣዼ ማዔም ኔና ኑ ጋላታንዳጉዲ፥","poem":1},{"text":"ኔኤኮ ዱማዼ ሱንፆ ኑ ቦንቻንዳጉዲ","poem":2},{"lineBreak":true},{"text":"ሃዳራ ኑና ዓውሴ!» ጎዑዋቴ።","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ","poem":1},{"text":"ናንጊና ጋላቲንቴያ ማዖም!","poem":2},{"text":"ዴራ ዒማና «ዓኣሜን» ጌዔኔ፤ ናንጊና ናንጋ ጎዳኣ ጋላቴኔ።","poem":1}]},{"type":"heading","content":["ዬሩሳላሜና ጌባዖኦኔናይዳ ካኣሽኪንቴ ካኣዦ"]},{"type":"verse","number":37,"content":["ካኣቲ፥ ዳውቴ ዓሳኣፔና ዒዛኮ ዒጊኖ ማዔ ሌዊ ዓሶ ናንጊና ናንጋ ጎዳኮ ጫኣቁሞ ሳኣፂና ዓኣ ቤዛ ካኣሽኪንታ ካኣዦ ዳምቦ ኩንሢሲ ኩንሢሲ ናንጋንዳጉዲ ሱኡጌ ማሂ ጌሤኔ፤ ዬያሮ ዔያታ ዬያ ማዾ ቢያ ኬሊ ማዻኔ፤"]},{"type":"verse","number":38,"content":["ዔያቶ ማኣዳንዳጉዲ ዪዱቱ ናኣዚ ዖቤድዔዶኦሜና ዒዛ ቶኦኪ ማዔያ ሜሌ ላሂታሚ ሳሊ ዓሲያ ዓይሢንቴኔ፤ ዒማና ዪዱቱ ናኣዚ፥ ዖቤድዔዶኦሜና ሆላና ጌሎ ካሮ ካፒሳ ሱኡጎ ማዔኔ።"]},{"type":"verse","number":39,"content":["ቄኤሳሢ፥ ሳዶቄና ዒዛ ዒጊኖ ማዔ ሜሌ ቄኤሳ ጌባዖኦኔይዳ ዓኣ፥ ዓፒሎና ማዢንቴ ፆኦሲ ካኣሽኪንታ ማኣሮይዳ ካኣዦ ካኣሽኪሳ ሱኡጌ ማሂ ዳውቴ ዔያቶ ዶኦሬኔ።"]},{"type":"verse","number":40,"content":["ዬያ ዒ ማዼሢ ናንጊና ናንጋ ጎዳ ዒስራዔኤሌ ዓሶም ዓይሤ ዎጎ ጎይፆና ቢያ ኬሊ ጉቴና ዋንቴና ሚቺ ዒንጎ ዒንጊፆ ሚቺ ፆኦሲም ሺኢሻንዳጉዲኬ።"]},{"type":"verse","number":41,"content":["ዒኢካ ዔያቶና ዎላ ሄማኔንታ ዪዱቱንታ፤ ዬያጉዲ ሃሣ ፆኦሲኮ ናንጊና ናንጋ ናሹሞ ማሊ ማሊ ቢያ ኬሊ ጋላታ ዓይኑሞ ዓይናዻንዳጉዲ ዶኦሪንቴ ሜሌ ዓሲያ ዓኣኔ፤"]},{"type":"verse","number":42,"content":["ሄማኔና ዪዱቱና ሹሉንጋ፥ ዑኡቱቡላሢ፤ ዬያጉዲ ጋላቶ ዓይኑሞ ዓይናዾዋኣና ዋርቆ ዓንጋሞ ሱኡጌ ማዒ ዓርቃያ ማዔኔ፤ ዪዱቱ ቶኦኪ ማዔ ዓሳ ጌሎ ካሮ ካፓ ዓሶኮ ሱኡጌ ማዔኔ።"]},{"type":"verse","number":43,"content":["ዬካፓ ዓሳ ቢያ ፔ ማኣሪ ማኣሪ ዴንዴኔ፤ ዳውቴያ ፔ ማኣሮ ዓሶ ዓንጃኒ ፔ ማኣሪ ዴንዴኔ።"]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/1CH/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/1CH/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/1CH/15.json","previo