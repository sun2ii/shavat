{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"1CH","translationId":"mdy_twf","name":"1 ፆኦሲ ዓሶ ሃይሶ","commonName":"1 ፆኦሲ ዓሶ ሃይሶ","title":"1 ፆኦሲ ዓሶ ሃይሶ ኬኤዛ ማፃኣፖ","order":13,"numberOfChapters":29,"sha256":"e321ce0af4bdac720495cef1aa04b25870db7bbb39faebd40b2943622ec51860","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/mdy_twf/1CH/29.json","totalNumberOfVerses":830},"chapter":{"number":8,"content":[{"type":"heading","content":["ቢኢኒያሜ ዜርፆ"]},{"type":"verse","number":1,"content":["ቢኢኒያሜ ዶንጎ ዓቲንቄ ናይ ሾዔኔ፤ ዬንሢያ ዎሊ ሄሊ ሄሊ ሾይንቴ ጎይፆና፦ ቤላዔ፥ ዓሽቤሌ፥ ዓህራሄ፥"]},{"type":"verse","number":2,"content":["ኖሃና ራፓ ጌይንታያኬ።"]},{"type":"verse","number":3,"content":["ቤላዔ ዜርፃ፦ ዓዳሬ፥ ጌራ፥ ዓቢሁዴ፥"]},{"type":"verse","number":4,"content":["ዓቢሹዓ፥ ናዕማኔ፥ ዓሆሃ፥"]},{"type":"verse","number":5,"content":["ጌራ፥ ሼፑፓኔና ሁራሜ ጌይንታያኬ።"]},{"type":"verse","number":6,"content":["ዔሁዴ ዜርፃ፦ ናዕማኔ፥ ዓሂያና ጌራ ጎዖያኬ፤ ዔያታ ጌባዔይዳ ናንጌዖ ጊንፃፓ ዳውሲንቲ ማናሃቴ ዴንዲ ዒኢካ ናንጌ ማኣሮ ዓሶ ሱኡጎኬ፤ ዬካ ዔያቶ ዔኪ ዴንዴሢ ዑዛና ዓሂሁዴኮ ዓዶ፥ ጌራናኬ።"]},{"type":"verse","number":8,"content":["ሻሃራሜ፦ ሁሺሜና ባዕራ ጌይንታ ላምዖ ላኣሊ ዓኣንቴ ዔያቶ ዓንጄኔ፤ ዬካፓ ሞዓኣቤ ዓጮይዳ ናንጊቤቃ ሆዶሾ ጌይንታ ፔቴ ላኣሊስኬኖ ዔኪ ላንካይ ዓቲንቄ ናይ ሾዔኔ፤ ዬንሢያ፦ ዮባቤ፥ ፂቢያ፥ ሜሻ፥ ማልካኣሜ፥"]},{"type":"verse","number":10,"content":["ዬዑፄ፥ ሳክያና ሚርማ ጌይንታያኬ፤ ዒዛኮ ዓቲንቆ ናኣታ ጉቤ ዒዛ ማኣሮ ዓሶኮ ሱኡጌ ማዔኔ።"]},{"type":"verse","number":11,"content":["ቃሲ ሃሣ ሁሻሜ ጌይንታ ማቾይዳፓ ዓሂቱቤና ዔልፓዓሌ ጌይንታ ላምዖ ዓቲንቄ ናይ ሾዔኔ።"]},{"type":"verse","number":12,"content":["ዔልፓዓሌያኣ፦ ዔቤሬ፥ ሚሼዓሜና ሼሜዴ ጌይንታ ሃይሦ ዓቲንቄ ናይ ሾዔኔ፤ ሼሜዴ ዖኖና ሎዴ ጌይንታ ካታማስኬንሢና ኮይላ ዓኣ ጉርዶዋ ማዤያኬ።"]},{"type":"heading","content":["ጋኣቴንታ ዓያሎኔይዳ ናንጋ ቢኢኒያሜ ዓሶ"]},{"type":"verse","number":13,"content":["ቤሪዓና ሴማዓና ዓያሎኔ ካታሞይዳ ዴዔ ማኣሮ ዓሶኮ ሱኡጎኬ፤ ዔያታ ቤርታ ጋኣቴይዳ ናንጋ ዴሮ ዳውሲ ኬሴኔ፤"]},{"type":"verse","number":14,"content":["ቤሪዓ ዜርፃ፦ ዓሂዮ፥ ሻሻቄ፥ ዪሬሞቴ፥"]},{"type":"verse","number":15,"content":["ዜባድያ፥ ዓራዴ፥ ዔዴሬ፥"]},{"type":"verse","number":16,"content":["ሚካዔኤሌ፥ ዩሽፓና ዮሃ ጌይንታያኬ።"]},{"type":"heading","content":["ዬሩሳላሜይዳ ናንጌ ቢኢኒያሜ ዓሶ"]},{"type":"verse","number":17,"content":["ዔልፓዓሌ ናኣታ፦ ዜባድያ፥ ሜሹላሜ፥ ሂዝቂ፥ ሄቤሬ፥"]},{"type":"verse","number":18,"content":["ዩሽሜራዬ፥ ዩዝሊዓና ዮባቤ ጌይንታያኬ።"]},{"type":"verse","number":19,"content":["ሺምዒ ናኣታ፦ ያቂሜ፥ ዚክሪ፥ ዛብዲ፥"]},{"type":"verse","number":20,"content":["ዔሊዔናዬ፥ ፂልታዬ፥ ዔሊዔኤሌ፥"]},{"type":"verse","number":21,"content":["ዓዳያ፥ ቤራያና ሺምራቴ ጌይንታያኬ።"]},{"type":"verse","number":22,"content":["ሻሻቄ ናኣታ፦ ዒሽጳኔ፥ ዔቤሬ፥ ዔሊዔኤሌ፥"]},{"type":"verse","number":23,"content":["ዓብዶኔ፥ ዚክሪ፥ ሃናኔ፥"]},{"type":"verse","number":24,"content":["ሃናኒያ፥ ዔላኣሜ፥ ዓንቶቲያ፥"]},{"type":"verse","number":25,"content":["ዩፕዴያና ፓኑዔሌ ጌይንታያኬ።"]},{"type":"verse","number":26,"content":["ዪሮሃሜ ናኣታ፦ ሻምሼራዬ፥ ሼሃሪያ፥ ዓታልዓያ፥"]},{"type":"verse","number":27,"content":["ያዕሬሺያ፥ ዔሊያና ዚክሪ ጌይንታያኬ።"]},{"type":"verse","number":28,"content":["ዬያታ ቢያ ዬሩሳላሜይዳ ናንጌ፥ ቤርታሳ ማኣሮ ዓሶኮ ሱኡጎንታ ዔያቶ ማኣሮኮ ቶይዶ ቶይዶኬ።"]},{"type":"heading","content":["ጌባዖኦኔና ዬሩሳላሜናይዳ ናንጌ ቢኢኒያሜ ዓሶ"]},{"type":"verse","number":29,"content":["ዪዒዔኤሌ ጌባዖኦኔ ካታሞ ማዢ ዒኢካ ዴዔኔ፤ ዒዛኮ ማቻ ማዒካ ጌይንታያ ማዓዛ፥"]},{"type":"verse","number":30,"content":["ዒዛኮ ናኣዚ ቶይዲ ዓብዶኔ ጌይንታኔ፤ ሜሌ ዒዛኮ ዓቲንቆ ናኣታ፦ ፁሬ፥ ቂሼ፥ ባዓኣሌ፥ ኔሬ፥ ናኣዳኣቤ፥"]},{"type":"verse","number":31,"content":["ጌዶሬ፥ ዓሂዮ፥ ዜኬሬንታ፥"]},{"type":"verse","number":32,"content":["ሺምዓኮ ዓዶ ሚቅሎቴ ጌይንታሢንታኬ፤ ዔያቶኮ ዜርፃ ዔያቶ ቶኦኮ ማዔ ዒጊኖ ኮይላ ዬሩሳላሜይዳ ናንጋኔ።"]},{"type":"heading","content":["ካኣቲ ሳኣዖኦሌ ማኣሮ ዓሶ"]},{"type":"verse","number":33,"content":["ኔሪ ቂሴ ሾዔኔ፤ ቂሴ ካኣቲ ሳኣዖኦሌ፤ ሳኣዖኦሌ፦ ዮናታኣኔ፥ ማልኪሹዓ፥ ዓቢናዳኣቤና ዔሽባዓኣሌ ጌይንታ ዖይዶ ዓቲንቄ ናይ ሾዔኔ፤"]},{"type":"verse","number":34,"content":["ዮናታኣኔያ ሜሪባዓኣሌ፤ ሜሪባዓኣሌ",{"noteId":1},"ሚካ ሾዔኔ።"]},{"type":"verse","number":35,"content":["ሚካ፦ ፒቶኔ፥ ሜሌኬ፥ ታሬዓና ዓሃዜ ጌይንታ ዖይዶ ዓቲንቄ ናይ ሾዔኔ።"]},{"type":"verse","number":36,"content":["ዓሃዜ፦ ዬሆዓዳ ሾዔኔ፤ ዬሆዓዳ፦ ዓሌሜቴ፥ ዓዝማዌቴንታ ዚምሪ ጌይንታ ሃይሦ ዓቲንቄ ናይ ሾዔኔ፤ ዚምሪ ሞፃ ጎዖሢ ሾዔኔ፤"]},{"type":"verse","number":37,"content":["ሞፃ፦ ቢንዓ፥ ቢንዓ ራፓ፥ ራፓ ዔልዓሳ፥ ዔልዓሳ ዓፄሌ ሾዔኔ።"]},{"type":"verse","number":38,"content":["ዓፄሌ፦ ዓዝሪቃሜ፥ ቦኬሩ፥ ዒስማዔኤሌ፥ ሼዓሪያ፥ ዓብዲዩና ሃናኔ ጌይንታ ላሆ ዓቲንቄ ናይ ሾዔኔ፤"]},{"type":"verse","number":39,"content":["ዓፄሌ ጌርሲ ዔሼቄ ቶይዶ ናዓሢ ዑላሜ፥ ሄሌሢ ያዑሼ፤ ሃይሣሳሢ ዔሊፔሌፄ ጌይንታያ ዓቲንቄ ናይ ሾዔኔ።"]},{"type":"verse","number":40,"content":["ዑላሜኮ ዓቲንቆ ናኣታ ሂኢሺ ዱኪሢና ዔርቴ ዖልዚ ዓሲኬ፤ ዔያቶኮ ዜርፃ ዎሊ ዑፃ ፔቴ ፄኤታና ዶንጊታሚ ናይና ናኣቶኮ ናይና ዓኣያኬ፤ ዓካሪ ሱንፃ ኬዴ ዔኤሊንቴዞንሢ ቢያ ቢኢኒያሜ ፃጶኬ።"]}],"footnotes":[{"noteId":1,"caller":"+","text":"8፡34 ሜሪባዓኣሌ ጌይንቴሢ፦ 2ሳሙ. 4፡4ይዳ «ሜፒቦሼቴ» ጌይንቴኔ።","reference":{"chapter":8,"verse":34}}]},"thisChapterLink":"/api/mdy_twf/1CH/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/1CH/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/1CH/7.json","previousChapterAudioLinks":{},"numberOfVerses":38}