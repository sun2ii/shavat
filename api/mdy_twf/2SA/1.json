{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"2SA","translationId":"mdy_twf","name":"2 ሳሙዔኤሌ ማፃኣፖ","commonName":"2 ሳሙዔኤሌ ማፃኣፖ","title":"2 ሳሙዔኤሌ ማፃኣፖ","order":10,"numberOfChapters":24,"sha256":"eada46aa08fc8f14d05163299c82c99288142f4ef8b49720d626a64da9cbfd97","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/mdy_twf/2SA/24.json","totalNumberOfVerses":674},"chapter":{"number":1,"content":[{"type":"heading","content":["ዳውቴ ሳኣዖኦሌኮ ሃይቦ ዋይዜሢ"]},{"type":"verse","number":1,"content":["ሳኣዖኦሌ ሃይቄስካፓ ዳውቴ ዓማሌቄ ዓሶ ዖሎና ባሺ ማዓዖ ፂቅላጌይዳ ላምዖ ኬሊ ዴዔኔ፤"]},{"type":"verse","number":2,"content":["ሃይሣሳ ኬሎና ፔቴ ዼጌ ሳኣዖኦሌንሢ ዓኣ ቤዛፓ ሙኬኔ፤ ዬይ ናማ ዒማና ፔኤኮ ዓፒሎ ዳርዚ፥ ቶኦኮይዳኣ ሲላሊ ዋሂ፥ ዳውቴ ኮይላ ሙካዖ ሳዓ ላሂ ቦንቾ ዔኤሊሢ ዔኤሌኔ፤"]},{"type":"verse","number":3,"content":["ዳውቴ ዒዛ፦ «ዓንካፓ ኔ ሙኬይ?» ጌይ ዖኦጬኔ። ዒዚ ማሃዖ፦ «ዒስራዔኤሌ ዓሳ ዓኣ ቤዛፓ ቶሊ ታ ሙኬኔ» ጌዔኔ።"]},{"type":"verse","number":4,"content":["ዳውቴ ዒዛ ኮይላ፦ «ሂንዳ ማዺንቴ ባኮ ቢያ ታኣም ኬኤዜ» ጌዔኔ። ናማ፦ «ኑኡኮ ፖኦሊሳ ዖሎና ባሺንቲ ጳሽኬኔ፤ ሚርጌ ዓሲ ኑኡኮ ሃይቄኔ፤ ሃሣ ሳኣዖኦሌንታ ዒዛኮ ናኣዚ ዮናታኣኔያ ዎዾናኔ» ጌዔኔ።"]},{"type":"verse","number":5,"content":["ዳውቴ ዬያ ሃይሶ ዔኪ ሙኬ ዼጌሢ ኮይላ፦ «ሳኣዖኦሌንታ ዒዛኮ ናኣዚ ዮናታኣኔንታ ሃይቄሢ ዎዲ ኔ ዔሬይ?» ጌይ ዖኦጬኔ።"]},{"type":"verse","number":6,"content":["ዼጌሢ ማሃዖ፦ «ታኣኒ ጊልቦዓ ዹካ ዓኣዖ ሳኣዖኦሌ ፔኤኮ ዎርፆ ኮኦላዺ ዓኣንቴ፥ ሃሣ ዒዛ ሞርኮኮ ሳርጌሎ ዖይታ ዴዒ ዖላ ዓሶንታ ፓራሢና ዖላ ዓሶንታ ዒዛ ባንሢ ሙካንቴ ታ ዴንቄኔ፤"]},{"type":"verse","number":7,"content":["ዒዚ ዒማና ጊንሢም ሺሪ ታና ዴንቃዖ ዔኤላዛ፥ ታኣኒ፦ ‹ዮ! ታ ጎዳ› ጌዔኔ፤"]},{"type":"verse","number":8,"content":["ዒዚ ታና፦ ‹ኔ ዓንኮ ዓሲዳይ?› ጌዒ ዖኦጬም፥ ታኣኒ ዓማሌቄ ዓሲታሢ ኬኤዜኔ፤"]},{"type":"verse","number":9,"content":["ዬካፓ ዒዚ፦ ‹ሃኒ ሙኪ ታና ዎዼ፤ ዱኡቲ ታ ማኣሳኒ ዓኣሢሮ ታ ሃይቄያዋይ!› ጌዔኔ፤"]},{"type":"verse","number":10,"content":["ዒዚ ሎሎኦማዖ ሃይቃንዳሢ ታ ዔሬሢሮ ዒዛ ባንሢ ሙኪ ታ ዒዛ ዎዼኔ፤ ዬካፓ ታኣኒ ዒዚ ቶኦካ ዓጋ ቦንቾ ባኮንታ ጋዎንታ ዔኬኔ፤ ታ ጎዳ! ሃይሾ፥ ታ ኔኤም ዔኪ ሙኬኔ» ጌዔኔ።"]},{"type":"verse","number":11,"content":["ዬያሮ ዳውቴ ዖያዖ ፔኤኮ ማኣዓሢ ዳርዜም ዒዛና ዎላ ዓኣ ዓሳኣ ዒማይዴኔ፤"]},{"type":"verse","number":12,"content":["ሳኣዖኦሌንታ ናኣዚ ዮናታኣኔንታ ፆኦሲ ዖሎ ዖላ፥ ዒስራዔኤሌ ዓሳ ሚርጌ ሃይቄሢሮ ዴንዲ ሳዓ ዓማንዳያ ሄላንዳኣና ሙኡዚ ሙዑዋዖ ዖዪ ዬኤኬኔ።"]},{"type":"verse","number":13,"content":["ዳውቴ ዬያ ሃይሶ ዔኪ ሙኬ ዼጌሢ፦ «ኔ ዓንኮ ዓሲዳይ?» ጌይ ዖኦጬኔ። ዒዚ ማሃዖ፦ «ታ ኔ ዓጮይዳ ቤቲ ሙኪ ናንጋ፥ ዓማሌቄ ዓጪ ዓሲ ናይኬ» ጌዔኔ።"]},{"type":"verse","number":14,"content":["ዳውቴ ዒማና፦ «ሂዳዖ ናንጊና ናንጋ ጎዳ ዶኦሚ ካኣታሤ ካኣቲ ዎዲ ኔ ጫርቂ ዎዼይ?» ጌይ ዖኦጬኔ።"]},{"type":"verse","number":15,"content":["ዬካፓ ዳውቴ ዒዛና ዎላ ዓኣ ዓሶይዳፓ ፔቴ ዓሲ ዔኤላዖ፦ «ሃያ ዎዼ!» ጌይ ዓይሣዛ፥ ዬይ ዓሢ ዬያ፥ ዓማሌቄ ዓጮ ናማ ጳርቂ ዎዼኔ፤"]},{"type":"verse","number":16,"content":["ዒማና ዳውቴ ዓማሌቄ ዓሳሢ ኮራ፦ «ሃያ ባኮ ኔ ኔጊዳ ኔኤሮ ኔኤኒ ዔኪ ዬዔኔ፤ ናንጊና ናንጋ ጎዳ ዶኦሜ ካኣቲ ‹ታ ዎዼኔ› ጌይ ኬኤዚፆና ኔጊዳ ኔ ኔኤሮ ዎጌኔ» ጌዔኔ።"]},{"type":"heading","content":["ዳውቴ ሳኣዖኦሌና ዮናታኣኔና ዛሎ ቃዬ ቃዮ"]},{"type":"verse","number":17,"content":["ዳውቴ ሳኣዖኦሌና ዮናታኣኔና ዛሎ ዖዪ ቃዬኔ፤"]},{"type":"verse","number":18,"content":["ዬያጉዲ ሃሣ ሂኢሺ ዛላ ቃዪንቴ ቃዮ ዪሁዳ ዴራ ጌይ ጌይ ዔራንዳጉዲ ዒዚ ዓይሤኔ፤ ዬይ ቃያ ያሻሬ ማፃኣፖይዳ ፃኣፒንቲ ዓኣኔ፤"]},{"type":"verse","number":19,"content":[{"text":"«ኑኡኮ ሱኡጋ ዒስራዔኤሌ ጌሜሮይዳ ሃይቄኔ፤","poem":1},{"text":"ኑኡኮ ፖኦሊሶፓ ዔርቴ ዶዶ ዓሳ ኩዴኔ!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዬያ ሃይሶ ጋኣቴይዳ ኬኤዚፖቴ፤","poem":1},{"text":"ዓስቄሎና ጎይፆይዳኣ ጌስቲፖቴ፤","poem":2},{"lineBreak":true},{"text":"ፒሊስፄኤሜ ላኣላ ዎዛዻንዳጉዲ","poem":2},{"text":"ዓቲንቶ ቤርቶ ቲቂንቲባኣ ዓሶኮ","poem":1},{"text":"ላኣሎ ዒላሺሲፖቴ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«ዔርቴ ዖሎ ዓሶኮ ጊቲማ ዒኢካ ኬኤሪንቲ ዓቴሢሮ","poem":1},{"text":"ሳኣዖኦሌኮ ጊቲማ ዛይቶና ዑጪንቶ ዓቴሢሮ","poem":2},{"lineBreak":true},{"text":"ጊልቦዓ ጌሜሮይዳ ዒርዚ ዋርቆፓ","poem":2},{"text":"ሃሣ ዖልኬያ ዖልካዾፓ!","poem":1},{"text":"ዔያቶኮ ጎዦይዳ ፔቴ ባኣዚታዎ ባቃሎፓ፤","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዮናታኣኔኮ ዓኣዛ ሳኣ ኬዱዋያኬ፤","poem":1},{"text":"ሳኣዖኦሌኮ ጬንቾ ዓፓራ ሞርኮ ቲቂ ኩርሳያኬ፤","poem":2},{"lineBreak":true},{"text":"ዎልቆና ዓኣ ዼኤፖ ቆፂ ሜንሣያኬ፤","poem":2},{"lineBreak":true},{"text":"ሞርኮዋ ዎዻያኬ።»","poem":2}]},{"type":"verse","number":23,"content":[{"text":"«ዒስራዔኤሌ ዴራ ቢያ ሳኣዖኦሌና ዮናታኣኔና ዒናፓ ናሽኪ ዔያቶ ሄርሻኔ፤","poem":1},{"text":"ሳኣዖኦሌና ዮናታኣኔና ዱማዹዋዖ ዎላ ናንጊ፥ ዎላ ሃይቄኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ኮኦኬይዳፓ ባሼ ሩኡራያ፥","poem":2},{"lineBreak":true},{"text":"ዞቢዳፓኣ ባሼ ዎልቄ ዓኣያኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"«ዒስራዔኤሌ ላኣሊዮቴ!","poem":1},{"text":"ሳኣዖኦሌ ዒንሢ ሚዛጶ ሻኣዦ ዓፒሎ ማይሴሢሮ","poem":2},{"lineBreak":true},{"text":"ዎርቆና ሚዛጲሶና ማኣዓሢ ማይሴሢሮ","poem":2},{"lineBreak":true},{"text":"ሳኣዖኦሌ ዬኤኩዋቴ!»","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"«ዔርቴ ፖኦሊሳ ቢያ ኩዴኔ፤","poem":1},{"text":"ቢያሢ ዖሎና ሃይቄኔ፤","poem":2},{"lineBreak":true},{"text":"ዮናታኣኔያ ጌሜሮይዳ ሃይቂ ላሄኔ!»","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"«ታ ዒሻሦ፥ ዮናታኣኔ!","poem":1},{"text":"ታ ኔ ዛሎ ዒናፓ ዖያኔ፤","poem":2},{"text":"ኔኤና ኑ ዎሊ ኮሺ ናሽካያኬ፤","poem":1},{"text":"ኔ ታና ናሽካ ናሹማ ሃይማኬ ጌይንቱዋያኬ፤","poem":2},{"lineBreak":true},{"text":"ዬይ ናሹማ ላኣሊ ናሽኮያይዳፓ ዑሣኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«ዎልቆና ዓኣ ዼኤፖ ዖሎ ዓሳ ሃይቄኔ!","poem":1},{"text":"ዔያቶኮ ዖሎ ዓንጋማኣ ጉሪ ዓቴኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/2SA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/2SA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/1SA/31.json","previousChapterAudioLinks":{},"numberOfVerses":27}