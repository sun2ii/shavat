{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"DEU","translationId":"mdy_twf","name":"ላሚንቴ ዎጎ ማፃኣፖ","commonName":"ላሚንቴ ዎጎ ማፃኣፖ","title":"ላሚንቴ ዎጎ ማፃኣፖ","order":5,"numberOfChapters":34,"sha256":"d4d7bb79abb4c8cf4634eedccf46c323bebeabe014ae6100b3671be638fc4f07","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/mdy_twf/DEU/34.json","totalNumberOfVerses":945},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":[{"text":"«ጫሪንጮንታ ሳዖንታ ታ ጋዓ ባኮ ዋይዙዋቴ፤","poem":1},{"text":"ታ ጋዓ ባኮ ኮሺ ዋይዙዋቴ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታ ዔርዛ ባካ ዒርዚጉዲ ዋርቆንጎ፤","poem":1},{"text":"ሃይሳኣ ታኣኮ ዖልኬጉዲ ፆዾንጎ፤","poem":2},{"lineBreak":true},{"text":"ማኣቲዳ ፁባ ዒርዚጉዲ፥","poem":2},{"lineBreak":true},{"text":"ባቃሊ ዑጋ ባቃሊዳኣ ዋርቃያጉዲ ማዖንጎ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታኣኒ ናንጊና ናንጋ ጎዳኮ ሱንፆ ዼጊዲ ኬኤዛንዳኔ፤","poem":1},{"text":"ኑ ፆኦዛሢኮ ዼኤፑሞ ሄርሹዋቴ!» ጌዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«ዒዚ ኑኡኮ ዋርዲዮ ሹጫሢኬ፤","poem":1},{"text":"ማዻ ዒዛኮ ጌኤሺ ጎይፃኣ ዒዛኮ ፒዜኬ፤","poem":2},{"lineBreak":true},{"text":"ዒዚ ዻቢንቱዋያ ጉሙርቂንታ ፆኦሲ፥","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ፒዜ፤ ሃሣ ኮሺ ማዔ ባኣዚ ማዻያኬ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዒንሢ ጉሙርቂንቱዋያ፥ ማኣዳ ባኣዚያባኣ","poem":1},{"text":"ጎሜ ማዻያና ጌሻ ዓሲና ማዔሢሮ","poem":2},{"lineBreak":true},{"text":"ዒዛ ዓሲ ማዓኒ ዒንሢ ዳንዳዓያቱዋሴ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዒንሢ ሃይ ዔኤያ፥ ሃሣ ማሊ ጶቂሡዋ ዴራ!","poem":1},{"text":"ናንጊና ናንጋ ጎዳም ዒ ማዼ ባኮ ዛሎ ዒንሢ ማሃሢ ዬያዳ?","poem":2},{"lineBreak":true},{"text":"ዒዚ ዒንሢ ማዤያ፥ ዒንሢኮ ዓዳሢቱዋዓዳ?","poem":2},{"lineBreak":true},{"text":"ዒንሢ ዶዲሺ ዺቢ ዴሬ ማሄሢ ዒዛቱዋዓዳ?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«ሚና ሚርጌ ሌዔኮ ቤርታ","poem":1},{"text":"ማዺንቴ ባኮ ማሊ ጶቂሡዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዬያ ዛሎ ዒንሢኮ ዓዶንሢ ዖኦጩዋቴ፥ ዒንሢም ኬኤዛንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ጋርቾ ዓሶዋ ዖኦጩዋቴ ዔያታ ዒንሢም ኬኤዛንዳኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዼኤፖ ፆኦዛሢ ሳዖ ዴሮ ቢያም ዓጮ ጊሽኬ ዎዶና","poem":1},{"text":"ዱማ ዱማ ዜርፃ ናንጋንዳ ቤዞ ዱማሴ ዎዶና","poem":2},{"lineBreak":true},{"text":"ዒስራዔኤሌ ዓሳ ሚርጌ ጎይፆጉዴያ","poem":2},{"lineBreak":true},{"text":"ፔ ዴሮ ዓጮኮ ዛጶ ዱማሲ ቆኦሬኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ያይቆኦቤ ዜርፆ ዒ ፔ ዓሲ ማሂ ዶኦሬያኬ።»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«ዼኤፖ ዢባራ ዢባርሻ ዳውሎ ቦኦሎይዳ","poem":1},{"text":"ዔኤቢያባኣ ጉሮ ቦኦሎይዳ ዓኣንቴ ዒ ዴንቂ","poem":2},{"lineBreak":true},{"text":"ዔያቶኮ ጊቲማ ማዔኔ፤ ፑርታፓኣ ካፔኔ፤","poem":2},{"lineBreak":true},{"text":"ዓኣፖኮ ካርፆማጉዲ ማሂ ዔያቶ ዒ ዛጌኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኮኦኬ ናኣቶ ባራንሢ ዔርዛኒ","poem":1},{"text":"ማኣራፓ ኬሲ ዢባራ ሃሻዖ ዴማ ባራኒ","poem":2},{"lineBreak":true},{"text":"ፔኤኮ ጋኣዞና ዓርቂ ዔካሢጉዲ","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ዒስራዔኤሌ ዬያይዲ ባይሲንታፓ ካፔኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሜሌ ዓይጎ ፆኦሲኮዋ","poem":1},{"text":"ማኣዶ ኮዑዋዖ","poem":2},{"lineBreak":true},{"text":"ዴሮ ፔኤሮ ዔኪ ዴንዴኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«ሳዖኮ ዼጌ ቤዞይዳ ዴዒ ዎይሣንዳጉዲ","poem":1},{"text":"ጎዣ ካፄም ሃኣኮ ዒንሢ ዒ ሙኡዜኔ፤","poem":2},{"lineBreak":true},{"text":"ዼኤፖ ዼኤፖ ሹጮይዳ ዔኤሴ ዑታሢ ዒንሢም ዒንጌኔ፤","poem":2},{"lineBreak":true},{"text":"ቃንፆ ሌሊ ማዔ ሳዖይዳ ባቃሌ ሪሚቶዋ ዒ ዓኣፒሴኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዒንሢኮ ባኣቶንታ ዋኣሮንታ ቢያ","poem":1},{"text":"ሚርጌ ማኣፃያ ዒ ማሄኔ፤","poem":2},{"lineBreak":true},{"text":"ኮሺ ኮሺ ማዔ ባይንታ ማራይንታ","poem":2},{"lineBreak":true},{"text":"ዋኣሪንታ ቆላኒ","poem":2},{"lineBreak":true},{"text":"ዬያጉዲ ሃሣ ቃራ ማዔ ዛርጎና","poem":2},{"text":"ሱጉሢጉዲ ዞቄ ማዔ ቃሮ ዎይኖ ዑዦዋ","poem":1},{"text":"ዒንሢ ዑሽኬኔ» ጌዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«ናንጊና ናንጋ ጎዳኮ ዴራ ሚርጌና ዖርጎጬኔ፤","poem":1},{"text":"ዖርጎጬ ጎይፆጉዴያ ዋይዚ ዒፃያ ማዔኔ፤","poem":2},{"lineBreak":true},{"text":"ዑፃ ዒንሢኮ ማሌኔ፤","poem":2},{"lineBreak":true},{"text":"ሚርጌ ዒንሢ ሙዓሢሮዋ ዲጬኔ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢ ማዤ፥ ናንጊና ናንጋ ጎዳሢያ ዒንሢ ሃሼኔ፤","poem":2},{"lineBreak":true},{"text":"ዋርዲዮ ሹጮ ማዒ ዒንሢ ማኣዳሢያ ዒንሢ ቦሄኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዒንሢ ሜሌ ፆኦዞ ካኣሽኪፆና","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ዻጋሳኒ ጌኤሲ ማዤኔ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢ ማዻ ፑርቶ ማዾና ቢያ ዒዛ ዒንሢ ዻጋሴኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሃያኮ ቤርታ ዒንሢ ዔሩዋያ፥","poem":1},{"text":"ሃሢ ዑኬ ሙኬያ፥ ፆኦሲቱዋያ ማዔ","poem":2},{"lineBreak":true},{"text":"ፑርቶ ዓያኖም","poem":2},{"lineBreak":true},{"text":"ቤርታኣ ዓዶንሢ ዒንሢኮ ካኣሽኪባኣ ፆኦዞም","poem":2},{"lineBreak":true},{"text":"ሚቺ ዒንጎ ዒንጊሢ ዒንሢ ሺኢሼኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዒንሢኮ ዓዶ ማዔ ፆኦዛሢ","poem":1},{"text":"‹ዔሩዋሴ› ዒንሢ ጌዔኔ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢ ማዤ፥ ፆኦዛሢ ዒንሢ ዋሌኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«ናንጊና ናንጋ ጎዳ ዬያ ዛጋዖ ዻጋዼኔ፤","poem":1},{"text":"ዒዛኮ ዓቲንቆና ዉዱሮ ናኣቶ ማዔዞንሢ","poem":2},{"lineBreak":true},{"text":"ዒዚ ዒፂ ሃሼኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ናንጊና ናንጋ ጎዳ፦ ‹ሃካፓ ሴካ ታ ዒንሢ ማኣዳዓኬ፤","poem":1},{"text":"ዒንሢ ጋፒንፆ ሄላንዳኣና ዎዎይታቴያ ታ ዛጋንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢ ዎቦ ሾይንቲኬ፤","poem":2},{"lineBreak":true},{"text":"ጉሙርቂንታ ዓሲያቱዋሴ።›","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሜሌ ፆኦዞ ዒንሢ ካኣሽኪ","poem":1},{"text":"ታና ዻጋሳኒ ጌኤሲ ማዤኔ፤","poem":2},{"lineBreak":true},{"text":"ማኣዱዋ ፆኦዞ ካኣሽኪ ታና ዒንሢ ዻጋሴኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒያ ዒንሢ ቦሂንቴ ዴሬ ዛላና","poem":2},{"lineBreak":true},{"text":"‹ዎይቲ ዔያታ ያኣዼ ማዔይ?› ጌይሲሳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ማሊሢባኣ ዴሬ ዛላና","poem":2},{"lineBreak":true},{"text":"ታ ዒንሢ ዻጋሳንዳኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ታኣኮ ዻጋ ታሚጉዲ ዔኤቲ","poem":1},{"text":"ሳዖንታ ሳዓ ካፂሳ ሃኣኮንታ ቢያ ሚቻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዬይ ሚቺፃ ሳዖኮ ዴሞ ኬዲ ሄላንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዹኮኮዋ ፃጶ ሄላንዳኣና ሚቻንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":["«ዒንሢዳ ዎዻ ዶርዖ ቃሲ ቃሲ ታ ዳካንዳኔ፤",{"text":"ታኣኮ ሂኢዦ ዒንሢ ዱኪ ታ ኩርሳንዳኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዎዺ ኩርሳንዳ ናይዚ ታ ዳካንዳኔ፤","poem":1},{"text":"ዱማ ዱማ ዎዻ ዶርዖና ዒንሢ ኩዳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዱማ ዱማ ዻዓ ቦዖንታ","poem":2},{"lineBreak":true},{"text":"ዻይ ዎዎዻ ሾኦሺያ ታ ዒንሢዳ ዳካንዳኔ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ናኣታ ዒንሢኮ ኬስኬ ቤዞይዳ ቢያ","poem":1},{"text":"ዖልዚ ዔያቶ ኩርሳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ጋሮይዳ ዒንሢ ዓኣቴያ","poem":2},{"lineBreak":true},{"text":"ዒጊቹሞ ዒንሢዳ ጌላንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዼጌ ዓቲንቆንታ ዉዱራሢንታ","poem":2},{"lineBreak":true},{"text":"ዻኮ ናኣቶታቴያ ጋርቻኣ ዓቱዋዖ ኩዳንዳኔ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ታኣኒ ጋፒሲ ዒንሢ ባይዛንዳኔ፤","poem":1},{"text":"ዬካፓ ዒንሢ ጶቂሣንዳ ዓሲያ ባኣሴ፤","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ጋዓንቴ ዒንሢኮ ሞርካ","poem":1},{"text":"‹ኑ ባሼያፓዓቴም ናንጊና ናንጋ ጎዳቱዋሴ ባሼሢ› ጌዒ","poem":2},{"lineBreak":true},{"text":"ዖቶርቂ ጌስታንዳኔ ጌዒ ታ ዓልታኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"«ዒንሢ ዒስራዔኤሌ ዓሳ ዒናባኣ ዓሲኬ፤","poem":1},{"text":"ዒንሢ ማሊ ጶቂሣ ዓሲቱዋሴ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ማሊ ጶቂሣ ዓሲ ዒንሢ ዎንዴ ማዔቴ","poem":1},{"text":"ዬያ ዒንሢ ጶቂሤያ ናንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ጋፒንፃ ዒንሢኮ ዓይጎ ማዓንዳቴያ","poem":2},{"lineBreak":true},{"text":"ዒንሢ ዔራንዳያታንቴኬ፤","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ዒንሢ ማዤሢ ዓኣሢ ዒንጊባኣያታንቴ","poem":1},{"text":"ዒንሢኮ ፆኦሲ ዒንሢ ሃሺባ