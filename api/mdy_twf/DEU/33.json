{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"DEU","translationId":"mdy_twf","name":"ላሚንቴ ዎጎ ማፃኣፖ","commonName":"ላሚንቴ ዎጎ ማፃኣፖ","title":"ላሚንቴ ዎጎ ማፃኣፖ","order":5,"numberOfChapters":34,"sha256":"d4d7bb79abb4c8cf4634eedccf46c323bebeabe014ae6100b3671be638fc4f07","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/mdy_twf/DEU/34.json","totalNumberOfVerses":945},"chapter":{"number":33,"content":[{"type":"heading","content":["ሙሴ ዒስራዔኤሌ ዓሶ ፃጶ ቢያ ዓንጄሢ"]},{"type":"verse","number":1,"content":["ሙሴ ሃይቃንዳሢኮ ቤርታ ዒስራዔኤሌ ዴሮም ሃጊ ማዓንዳ ባኮ ኬኤዚ ሂዚ ጌይ ዓንጄኔ፦"]},{"type":"verse","number":2,"content":[{"text":"«ናንጊና ናንጋ ጎዳ ሲና ዹካፓ ሙኬኔ፤","poem":1},{"text":"ዔዶኦሜይዳፓ ዓቢጉዲ ፆርቄኔ፤","poem":2},{"lineBreak":true},{"text":"ፓኣራኣኔ ዹኮይዳኣ ፖዔኔ፤","poem":2},{"lineBreak":true},{"text":"ሚርጌ ዺቢ ኪኢታንቻ ዒዛና ዎላ ዓኣኔ፤","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ሚዛቆ ዛላ ዔኤታ ታሚ ዓኣኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ናንጊና ናንጋ ጎዳ ፔኤኮ ዴሮ ጎኔ ናሽካኔ፤","poem":1},{"text":"ዒዛም ዱማዼ ዴሮዋ ዒ ካፓኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያሮ ዒዛኮ ቶኮ ዴማ ጉምዓቲ ኑ ዚጋንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዎጎ ዒዛሲ ኑ ካፓንዳኔ፤","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዒስራዔኤሌ ዴሮም ዔያቶሮ ማሂ ዒንጊንቴ","poem":1},{"text":"ሙሴ ኑም ኬኤዜ ቦንቺንቴያ ማዔ ዎጎ ኑ ካፓንዳኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዒስራዔኤሌ ዓሶ ፃጶና","poem":1},{"text":"ዴሮኮ ሱኡጎና ቡኩንቴ ዎዶና","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ዒስራዔኤሌይዳ ካኣታዼኔ።»","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሙሴ ሃሣ ሮኦቤኤሌ ማኣሮ ዓሶ ዛሎ","poem":1},{"text":"«ፓይዳ ዔያቶኮ ዻካ ማዔቴያ","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳሢዮ! ሮኦቤኤሌ ዴራ ናናንጎንጎ፤ ባይቆፓ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ሃሣ ዒዚ ዪሁዳ ማኣሮ ዓሶ ዛሎ","poem":1},{"text":"«ናንጊና ናንጋ ጎዳሢዮ! ኔ ባንሢ ዔያታ ዒላታ ዒላቶ ዋይዜ፤","poem":2},{"lineBreak":true},{"text":"ሃንጎ ፃጶ ዓሶና ዎላ ፔቱሞ ዓኣያ ዔያቶ ማሄ፤","poem":2},{"lineBreak":true},{"text":"ዶዲ ዎልቄ ዔያቶም ዒንጌ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ፔ ሞርኮና ዖልታ ዎዶና ዔያቶ ማኣዴ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ዒዚ ሃሣ ሌዊ ማኣሮ ዓሶ ዛሎ","poem":1},{"text":"«ናንጊና ናንጋ ጎዳሢዮ! ኔ ማሊፆ ዱማሲ ዔርዛ","poem":2},{"noteId":4},{"lineBreak":true},{"text":"ኔኤም ዱማዼ ባኮንሢና","poem":2},{"lineBreak":true},{"text":"ማሳሄና ሜሪባ ዋኣፆ ዓጮናይዳ","poem":2},{"lineBreak":true},{"text":"ዔያቶና ማርሚ ዔያቶኮ ጎኑሞ ኔ ዛጌ","poem":2},{"lineBreak":true},{"text":"ኔኤም ማዻ ሌዊ ዓሶም ማሊፆ ኔኤኮ ፔጋሲ ዻዌ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዔያታ ኔ ጋቴ ጌዒ ሾዔ ዓሶ ዋሌኔ፤","poem":1},{"text":"ፔ ዒጊኖይዳፓኣ ዱማዼኔ፤","poem":2},{"lineBreak":true},{"text":"ናኣቶዋ ፔኤኮ ዔያታ ሃሼኔ፤","poem":2},{"lineBreak":true},{"text":"ኔ ኬኤዛ ባኮዋ ዔያታ ቦንቼኔ፤","poem":2},{"lineBreak":true},{"text":"ኔ ዔያቶና ዎላ ጫኣቄ ጫኣቁሞዋ ዔያታ ካፔኔ፤","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኔኤኮ ዳምቦ ያይቆኦቤም","poem":1},{"text":"ዎጎዋ ኔኤኮ ዒስራዔኤሌ ዓሶ ዔርዛኔ፤","poem":2},{"lineBreak":true},{"text":"ኔ ቤርታ ዔያታ ዑንጆ ጩቢሻኔ፤","poem":2},{"lineBreak":true},{"text":"ኔኤም ሚቺ ዒንጎ ባኮ ዒንጎ ቤዞይዳ","poem":2},{"lineBreak":true},{"text":"ሚቺ ዒንጎ ባኮ ዒንጋኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ዔያቶኮ ዓኣ ባኮ ዓንጄ፤","poem":1},{"text":"ዔያታ ማዻ ማዾዋ ኮሺ ማሂ ዔኬ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶ ሞርኮኮ ዎልቆ ላቢሴ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶ ዒፃ ዓሳ ላሚ ዔቁዋጉዲ ዎልቄ ባይዜ!»","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ሃሣ ሙሴ ቢኢኒያሜ ማኣሮ ዓሶ ዛሎ","poem":1},{"text":"«ናንጊና ናንጋ ጎዳ ዔያቶ ናሽካ ዓሳ ሂርጋ ባኣያ ናንጎንጎ፤","poem":2},{"lineBreak":true},{"text":"ዼኤፖ ፆኦዛሢ ሮኦሮ ቢያ ዔያቶ ካፓኔ።","poem":2},{"lineBreak":true},{"text":"ዒንዳ ፔኤኮ ናዖ ኮንቃሢጉዲ ዒዚ ኮንቄም ዔያታ ናንጋንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ዒዚ ዮሴፔ ማኣሮ ዓሶ ዛሎ፦","poem":1},{"text":"«ናንጊና ናንጋ ጎዳ ሎ ጫሪንጫፓ ዒሮ ዋርቂሲ","poem":2},{"lineBreak":true},{"text":"ሉ ዴማ ዓኣ ዋኣፆዋ ዓልቂሲ","poem":2},{"lineBreak":true},{"text":"ሳዖ ዔያቶኮ ዓንጆንጎ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዬያጉዲ ዓባ ቃራ ዓቤም ካፃ ሃኣኮ","poem":1},{"text":"ሌዖና ሌዖና ሳዓ ዔያቶኮ ሚርጌ ካሣያ ማዖንጎ፤","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዔያቶኮ ሚናፓ ዓኣ ዹኮንታ ጌሜሮንታ","poem":1},{"text":"ሙዎ ባኣዚ ቃራ ቃራ ካፂሳያ ማዖንጎ፤","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዓጫ ዔያቶኮ ኮሺ ማዔ ባኣዚና ቢያ ኩሜያ ማዖንጎ፤","poem":1},{"text":"ካዮ ባኣካ ዔኤታ ታሞና ጴዼ ፆኦዛሢ ዓንጃ ዓንጆና","poem":2},{"lineBreak":true},{"text":"ዒዛ ሳዓ ዓንጂንቴያ ማዖንጎ፤","poem":2},{"lineBreak":true},{"text":"ዒዚ ፔኤኮ ጌርሲንሢ ባኣካ ሱኡጌ ማዖንጎ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዮሴፔ ዚያ ጌማይጉዲ ዶዲኬ፤","poem":1},{"text":"ካኣራ ዒዛኮ ሜኤኒ ካኣሪጉዲ ዶዳያኬ፤","poem":2},{"lineBreak":true},{"text":"ዬያና ዒ ዴሮ ዹዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዓጮኮ ጋፒንፆ ሄላንዳኣና ዒ ዳውሳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔፕሬኤሜኮ ታጶ ላምዖ ሺዮንታ","poem":2},{"lineBreak":true},{"text":"ሚናኣሴኮ ሺዮንታ ያኣዼ ማዓንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ሃሣ ሙሴ ዛብሎኦኔና ዪሳኮኦሬ ማኣሮ ዛሎ፦","poem":1},{"text":"«ዛብሎኦኔ ዜርፃ ባዞይዳ ኮርማ ኮርሞና","poem":2},{"lineBreak":true},{"text":"ዖርጎጪ ዎዛዾንጎ፤","poem":2},{"lineBreak":true},{"text":"ዪሳኮኦሬያ ማኣራ ዓኣዖ ዎዛዻያ ማዖንጎ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዔያታ ሃንጎ ዴሮ ዹኮ ዔኤሊ ኬሲ","poem":1},{"text":"ፒዜ ማዔያ፥ ፆኦሲም ዒንጎ ባኮ ዒኢካ ሺኢሻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶ ዖርጎጪሳንዳ ቆሎ ዔያታ ባዞና","poem":2},{"lineBreak":true},{"text":"ባዞ ዓጫ ዓኣ ማኣሻሎናይዳፓ ዴንቃንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ዒዚ ሃሣ ጋኣዴ ማኣሮ ዓሶ ዛሎ፦","poem":1},{"text":"«ጋኣዴ ዓጮ ዳልጊሼ፥ ናንጊና ናንጋ ጎ