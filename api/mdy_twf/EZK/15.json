{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"EZK","translationId":"mdy_twf","name":"ሂዚቄኤሌ ማፃኣፖ","commonName":"ሂዚቄኤሌ ማፃኣፖ","title":"ሂዚቄኤሌ ማፃኣፖ","order":26,"numberOfChapters":48,"sha256":"fa91f6b35c2eb087e0582cf4284c1b16c970fb2541a348cab7764d265a02e597","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/mdy_twf/EZK/48.json","totalNumberOfVerses":1263},"chapter":{"number":15,"content":[{"type":"heading","content":["ዎይኖ ሚፆ ዛሎ ኬኤዚንቴ ኮኦኪንሢ"]},{"type":"verse","number":1,"content":["ናንጊና ናንጋ ጎዳ ታኣም ሂዚ ጌዔኔ፦"]},{"type":"verse","number":2,"content":["«ዓሲ ናዓሢዮ! ዎይኖ ዞዓ ሜሌ ካዮይዳ ዓኣ ሚፆ ካኣፖፓ ዎይቲ ባሻይ?"]},{"type":"verse","number":3,"content":["ፔቴ ባኣዚ ማዻኒታዖ ማኣዳ ባኣዚ ዓኣያዳ? ሜሄ ሱፆያም ማዓ ሚሢ ዔካኒ ዳንዳዒንታ?"]},{"type":"verse","number":4,"content":["ሃንፂሌ ማዒሢዳፓ ዓታዛ ሜሌ ማኣዳንዳ ባኣዚ ባኣሴ፤ ላምዖ ዛላ ዔኤቲ ጋፔም ዓቴ ዱንጮና ፔቴ ባኣዚታዖ ማዺንታኒ ዳንዳዒንታ?"]},{"type":"verse","number":5,"content":["ዎንዴ ሚጫንዳሢኮ ቤርታታዖ ዔኤቢ ማኣዱዋያኬ፤ ዓካሪ ሃሢ ታማ ሙይ ሃሼስካፓ ዎማጉዲ ማዱዋያ ማዓንዳይ!»"]},{"type":"verse","number":6,"content":["ዼኤፖ ናንጊና ናንጋ ጎዳሢ፦ «ካዮ ሚፆ ባኣካፓ ዎይኖ ዞንዛ ዔውቲ ሃንፂሌ ማዔሢጉዲ ዬሩሳላሜይዳ ናንጋ ዴሮዋ ታኣኒ ዒማይዳንዳኔ።"]},{"type":"verse","number":7,"content":["ታ ዔያቶይዳ ሜቶ ዓጋንዳኔ፤ ዎዚ ዔያታ ታማፓ ዓቴቴያ ታማ ዔያቶ ሙዓንዳኔ፤ ታ ዔያቶይዳ ሜቶ ዓጋ ዎዶና ታኣኒ ናንጊና ናንጋ ጎዳ ማዔሢ ዒንሢ ዔራንዳኔ፤"]},{"type":"verse","number":8,"content":["ዔያታ ታኣም ጉሙርቂንታያ ማዒፆ ሃሼኔ፤ ታኣኒያ ዔያቶኮ ዓጮ ዓሲ ናንጉዋ ዳውሌ ማሃንዳኔ፤ ጋዓኔ፥ ዼኤፖ ናንጊና ናንጋ ጎዳሢ።»"]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/EZK/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/EZK/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/EZK/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}