{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"GEN","translationId":"mdy_twf","name":"ማዢንቲ ማፃኣፔ","commonName":"ማዢንቲ ማፃኣፔ","title":"ማዢንቲ ማፃኣፔ","order":1,"numberOfChapters":50,"sha256":"accd5f6d51295c510facef3a8f49d5c3a9c2a9e871c2d9b21493f498013c969c","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/mdy_twf/GEN/50.json","totalNumberOfVerses":1524},"chapter":{"number":49,"content":[{"type":"heading","content":["ያይቆኦቤ ፔኤኮ ናኣቶ ዓንጃዖ ጌዔ ባኮ"]},{"type":"verse","number":1,"content":["ያይቆኦቤ ፔኤኮ ናኣቶ ዔኤላዖ ሂዚ ጌዔኔ፦ «ቢያሢ ሙኪ ቡኪንቱዋቴ፥ ታ ዒንሢ ሃጊ ሄላንዳ ባኣዚ ኬኤዛንዳኔ፤»"]},{"type":"verse","number":2,"content":[{"text":"«ዒንሢ፥ ያይቆኦቤ ናኣታ","poem":1},{"text":"ፔቱሞና ሃኒ ዋይዙዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዓዳሢ፥ ዒስራዔኤሌ ዒንሢም ኬኤዛ ባኮ ኮሺ ዋይዙዋቴ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«ሮኦቤኤሌ፦ ኔኤኒ ታ ኔና ዼጋቶ ዎልቄና ዓኣዖ","poem":1},{"text":"ሾዔ ታኣኮ ኔ ናኣዚ ቶይዲኬ።","poem":2},{"text":"ታኣኮ ናኣቶይዳፓ ቢያ ቦንቺንታያና ዎልቄና","poem":1},{"text":"ኮሺ ባሼሢ ኔናኬ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ያኣዼ ማዔቶዋ ኔኤኒ ኩሜ ዲጲጉዲታሢሮ","poem":1},{"text":"ቢያሢኮ ዑፃ ማዒ ዎይሣያ ማዒሢ ኔኤም ኮይሱዋሴ፤","poem":2},{"lineBreak":true},{"text":"ዎይቲ ጌዔቴ ታና፥ ዓዶኮ ማዾ ማዻ ላኣሌሎ ኔ ዓርቂ","poem":2},{"lineBreak":true},{"text":"ዓርሶዋ ኔ ታኣኮ ዒኢሴኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«ሲሞኦኔና ሌዊና ዎሊኮ ጌርሲንሢኬ፤","poem":1},{"text":"ፑርታ ማዾ ማዻኒ ዔያታ ዖልዚ ዓንጋሞ ዔካያኬ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዔያታ ፔ ዻጎና ሚርጌ ዓቲንቄ ዎዼኔ፤","poem":1},{"text":"ጌማቶ ዔያታ ሚኢጪ ዓማላኒ ቲቂ ዎቢሴኔ፤","poem":2},{"text":"ዔያቶ ዞሮይዳ ታኣኒ ጌላዓ፤","poem":1},{"text":"ዔያቶኮ ቡኪንቶይዳኣ ታ ጴዻዓ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ዼኤፖ ዔያቶኮ ዒጊቻ ዻጋ","poem":1},{"text":"ዼኤፖ ጎሪንታ ዔያቶኮ","poem":2},{"lineBreak":true},{"text":"ጋዳንቂንቴያ ማዖንጎ።","poem":2},{"text":"ታኣኒያ ዔያቶ ዒስራዔኤሌ ዓጮይዳ ቢያ ዜርቃንዳኔ፤","poem":1},{"lineBreak":true},{"text":"ዴሮ ባኣኮይዳኣ ታ ዔያቶ ላኣላንዳኔ።","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"«ዪሁዳ! ኔና ኔ ጌርሲንሢ ጋላታያ ማዓንዳኔ፤","poem":1},{"text":"ኔ ሞርኮ ኔ ባሻያ ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ጌርሲንሢ ሂርኪ ጌዒ","poem":2},{"lineBreak":true},{"text":"ቦንቾ ዔኤሊሢ ኔና ዔኤላንዳኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዪሁዳ፥ ሃጊ ዲጫ ዓዴ ዞቢኬ፤","poem":1},{"text":"ሙዖንዶ ባኮ ኬሚ","poem":2},{"lineBreak":true},{"text":"ጌሊ ዎርቃ ዔቶ ባንሢ ማዓንዳኔ፤","poem":2},{"text":"ሃሣ ዒጊጩዋዖ ፔና ሃሺ ላሃንዳኔ፤","poem":1},{"text":"ዒዛ ዓጊሢ ጴቻኒ ጫርቃንዳያኣ ጴዻዓኬ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዴራ ቢያ ዒዛም ዓይሢንታያ ማዓንዳኔ፤","poem":1},{"text":"ናንጊና ዔያቶይዳ ካኣታዻንዳሢ ሙካንዳያ ሄላንዳኣና","poem":2},{"lineBreak":true},{"text":"ካኣቱሞ ቢታንቶ ዪሁዳ ማኣራፓ ኬስካዓኬ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሃሮ ፔኤኮ ዒ ዎይኖ ሚፆኮ ፃጶይዳ","poem":1},{"text":"ሃሮ ናዖ ዎይኖኮ ባልጌ ኮዦ ካኣፖይዳ ቱካንዳኔ፤","poem":2},{"text":"ዓፒሎዋ ፔኤኮ ዒ ዎይኖ ዑዦና","poem":1},{"text":"ዒዚ ጊልዲማ ጊልዲሞዋ ሱጉሢጉዲ ዞቃ","poem":2},{"lineBreak":true},{"text":"ዎይኖፓ ጩኡጶና ዑዦና ማስካንዳኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዓኣፓኣ ዒዛኮ ዎይኖ ዑዦይዳፓ ባሼ ዞቃንዳኔ፤","poem":1},{"text":"ዓጫ ዒዛኮ ዲኢቂዳፓ ዑሣ ዓኣዼ ቦኦራንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«ዛብሎኦኔ፥ ባዚ ዓቺዳ ናንጋንዳኔ፤","poem":1},{"text":"ዒዛኮ ባዞ ዓጮይዳ ዓኣ ቤዛ ዋኣሢ ካኣሚሌ ሙኪ ዔቃ ቤሲ ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒዚ ናንጋንዳ ዓጮኮ ዛጳ ዴንዲ ሲዶና ሄላንዳኣናኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«ዪሳኮኦሬ፥ ጫኣኖ ባኣካ","poem":1},{"noteId":74},{"text":"ላሂ ሺራ ዶዲ ሃሬጉዴያኬ።","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ጋዓንቴ ዒዚ ሃውሻንዳ ቤዞና","poem":1},{"text":"ሳዖና ኮሺ ዎዛሳያ ማዔሢ ዴንቃዖ","poem":2},{"lineBreak":true},{"text":"ጫኣኖ ዔካኒ ጌኤቶ ፔኤሲ ሂርኪዳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ካራሚጉዲ ዶዲ፥ ዎልቄ ማዾዋ ማዻንዳኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዳኣኔ፦ ዒስራዔኤሌ ፃጳፓ ፔቴሢ ማዒ ፔ ቶኦኮኮ ጌስቲ ዎጋያ ማዓንዳኔ።","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ዳኣኔ ጎይሢ ዓቺዳ ዓኣ ሾኦሺ ማዓንዳኔ፤","poem":1},{"text":"ባቁሎ ቶጊ ዓኣዻሢ ባቁሎይዳፓ ሎንሣኒ","poem":2},{"lineBreak":true},{"text":"ጎይሢ ፁኡቤ ካራይዳ ካቲ","poem":2},{"text":"ባቁሎኮ ሹቁሎ ዻዓ ዶርባ ሾኦሺ ማዓንዳኔ።»","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ታ ኔኤኮ ዻቂሺፆ ካፓንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«ጋኣዴ፦ ቡራ ዓሲ ኮሺ ሜታሳንዳኔ፤","poem":1},{"text":"ዒዚያ ኮጲሲ ዓኣዺ","poem":2},{"lineBreak":true},{"text":"ዔያቶ ዳውሳንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«ዓሴኤሬ፦ ሳዖይዳፓ ሚርጌ ሃኣኮ ዴንቃንዳኔ፤","poem":1},{"text":"ካኣቶም ዒንጎንዶጉዴ ቃራ ካሣኣ ካሣንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«ኒፕታኣሌኤሜ፦ ሜታባኣያ ሃንቲ ሃንቲ ናንጋ","poem":1},{"text":"ሚርጌ ሚዛጲ ናይ ሾዓ","poem":2},{"lineBreak":true},{"text":"ጌንዖጉዴያ ማዓንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«ዮሴፔ፦ ዓልቃ ዋኣሢ ዓሽካ ቱኮናያ","poem":1},{"text":"ባልጊ ዴንዳ ካኣፓ ኮጬይዳ ባልጊ ዴንዲ ዓኣፓ ሚሢጉዲ ማዓንዳኔ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዒዛኮ ሞርካ ዒዛ ዳውሲ ዳውሲ ሚርጌና ሜታሳንዳኔ፤","poem":1},{"text":"ሂኢሺናኣ ዔያታ ዒዛ ዱካንዳኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ጋዓንቴ ሚርጌ ዶዲ ማዔ ያይቆኦቤ ፆኦዛሢ ዎልቆና","poem":1},{"text":"ዒስራዔኤሌ ሄንቃሢና ካፓሢናኮ ዶዱሞና","poem":2},{"text":"ዒዛኮ ዓኣዛ ባሼ ዶዲ ማዓንዳኔ፤","poem":1},{"text":"ዎልቃኣ ዒዛኮ ዶዳንዳኔ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ኔኤኮ ዓዶ ፆኦዛሢ ኔና ማኣዳንዳኔ፤","poem":1},{"text":"ቢያ ባኮ ዳንዳዓ ፆኦዛሢ ጫሪንጫፓ ዒርዚ","poem":2},{"text":"ሳዖኮ ዴማፓ ዋኣሢ ኔኤም ዒንጊ ኔና ዓንጃንዳኔ፤","poem":1},{"text":"ሃሣ ሚርጌ ቆልሞና ናይና ኔኤም ዒዚ ዒንጋንዳኔ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ሚናፓ ዶዲ ማዒ ናንጋ ዹኮና","poem":1},{"text":"ናንጊና ናንጋያ ማዒ ዓኣ ጌሜሮናይዳፓ","poem":2},{"lineBreak":true},{"text":"ጴዻ ዎዛሳ ዓንጆ ቢያሢዳፓ፥ ኔ ዓንጃ ባሻያኬ።","poem":2},{"lineBreak":true},{"text":"ዓካሪ ሃይ ዓንጃ ቢያ ዮሴፔ ቶኦካ ማዖንጎ፤","poem":2},{"text":"ጌርሲንሢ ባኣካ ሱኡጌ ማዔ፥ ዮሴፔ ቶኦካ ኬዶንጎ።»","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"«ቢኢኒያሜ፦ ቡሪ ዔካ ያኣዮጉዲኬ፤","poem":1},{"text":"ጉቴ ዓሚ ዒ ኬሚ ዴንቄ ባኮ ፔኤሮ ሙዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዋንቴ ኬሚ ዴንቄሢ ጋዓንቴ ዒዚ ጊሽካንዳኔ።»","poem":2}]},{"type":"verse","number":28,"content":["ዓካሪ ሃኣታ ታጶ ላምዓሢ ዒስራዔኤሌ ፃጶኬ፤ ዓዴ ዔያቶ ዓንጃዖ ፔቴ ፔቴሢም ኮይሳሢጉዴ ዓንጆ ዒንጌሢ ዬያይዲኬ።"]},{"type":"heading","content":["ያይቆኦቤኮ ሃይቦና ዱኡቲፆና"]},{"type":"verse","number":29,"content":["ዬካፓ ያይቆኦቤ ፔ ናኣቶ፦ «ታኣኒ ሃይቂ ታ ዒጊኖ ኮራ ዓኣዻንዳ ዎዳ ሄሌኔ፤ ዬያሮ ሄቴ ዓሢ ዔፕሮኦኔ ጎዦ ዓጫ ዔታ ዓኣ ቤዛሢዳ፥ ታ ዓዶንሢ ዱኡቴ ቤዛ ታናኣ ዎላ ዒኢካ ዱኡኩዋቴ፤"]},{"type":"verse","number":30,"content":["ዬይ ዴኖ ዔቶ ቤዛሢ ካኣናኔ ዓጮይዳ ሜሚሬ ጎዖ ቤዞኮ ዓባ ኬስካ ዛሎና ማክጴላይዳ ዓኣሢኬ፤ ዓብራሃሜ ዬያ ዴኖ ዔቶኮ ዓኣ ጎዦ ዱኡፒ ቤሲ ማሂ ሻንቄሢ ሄቴ ዓሢ ዔፕሮኔይዳፓኬ።"]},{"type":"verse","number":31,"content":["ዓብራሃሜንታ ማቾ ሳኣራንታ ዪሳኣቄንታ ማቾ ዒርቢቃንታ ዱኡቴሢ ቢያ ዒኢካኬ፤ ታኣኒያ ታ ማቾ ሊያ ዒኢካ ዱኡኬኔ።"]},{"type":"verse","number":32,"content":["ጎዦንታ ዴኖ ዔቶ ቤዞንታ ሻንቂንቴሢ ሄቴ ዓሶይዳፓኬ፤ ዬያሮ ታና ዒኢካ ዱኡኩዋቴ» ጌዒ ዓይሤኔ።"]},{"type":"verse","number":33,"content":["ያይቆኦቤ ፔኤኮ ናኣቶ ዓይሢ ጋፔስካፓ፥ ጊንሣ ላሃማና ሼምፓሢ ዒዛኮ ዱጴኔ።"]}],"footnotes":[{"noteId":74,"caller":"+","text":"49፡14 ጫኣኖ ባኣካ ጋዓዛ፦ ዪሳኮኦሬኮ ዓጫ ላምዖ ዹካ ባኣካ ዓኣ ዶኦቺ ቤሲ ማዔሢ ዔርዛያኬ።","reference":{"chapter":49,"verse":14}}]},"thisChapterLink":"/api/mdy_twf/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}