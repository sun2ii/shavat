{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"HAB","translationId":"mdy_twf","name":"ዒምባቆሜ ማፃኣፖ","commonName":"ዒምባቆሜ ማፃኣፖ","title":"ዒምባቆሜ","order":35,"numberOfChapters":3,"sha256":"07414492407150a32ae5f6d3f71002391768fa2c123da2b1b0d2f4d5051cc15f","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mdy_twf/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["ዒምባቆሜኮ ሺኢጲፆ"]},{"type":"verse","number":1,"content":["ዒምባቆሜ ዓይኑሞና ፆኦሲ ሺኢቄ ሺኢጲፃ ያዺ ጋዓያኬ፦"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔኤኒ ማዼ ዲቃሢ ሄርሺሳ ባኮ ቢያ ታኣኒ ዋይዚ ሚርጌና ዒጊጬኔ፤","poem":1},{"lineBreak":true},{"text":"ሃሢ ኑ ዎዶና ሚናኣ ማዾ ኔኤኮ ላሚ ማዼ፤","poem":1},{"text":"ቢያ ዎዴና ዔርቲ ናንጋንዳጉዲ ማሄ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ዻጋዻ ዎዶናታዖ ሚጪንቲፆ ኔኤኮ ኑጊዳፓ ሃኪሲፖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ፆኦሲ ፔኤኮ ዱማዺፆና ቴማኔ ዓጮና","poem":1},{"text":"ፓኣራኔ ዹኮናፓ ላሚ ሙካንዳኔ፤","poem":2},{"text":"ዼኤፖ ቦንቻ ዒዛኮ ጫሪንጮ ዓኣቼኔ፤","poem":1},{"text":"ጋላታኣ ዒዛሲ ሳዖ ኩሜኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ፖዓ ዒዛሲ ዓቢጉዴያኬ፤","poem":1},{"text":"ዎልቆ ዒዛኮ ካንቂ ዓኣ ኩጫፓ","poem":2},{"lineBreak":true},{"text":"ሼኤራ ፖዒ ፖዓኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዎዻ ዶርዓሢ ዒዛኮ ቤርታ ቤርታ ዒ ዳካኔ፤","poem":1},{"text":"ሃይቢያ ዒዛም ዓይሢንቲ ዒዛ ጊንፆ ሙካኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዒዚ ዔቃዛ ሳዓ ዓጊፃኔ፤","poem":1},{"text":"ዒዚ ዛጋዛ ሜሌ ዴራ ጎጋይቃኔ፤","poem":2},{"lineBreak":true},{"text":"ሚናኣፓ ዓኣ ዹካ ዲኢማዺ ዶዓኔ፤","poem":2},{"text":"ሚናንካፓ ዓርቃዖ ዒዚ ሃንታ ጌሜራ","poem":1},{"text":"ሊካ ዓርዲ ባይቃኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ዒቶጲያ ዴራ ሜታዻንቴ","poem":1},{"text":"ሚዲያሜ ዓሳ ጎጋይቃንቴ ታ ዛጌኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔኤኮ ፓራሢንታ ሳርጌሎ ዖይቶንታ ባሻንዳጉዲ ኔ ማዼ ዎዶና","poem":1},{"text":"ኔኤኮ ዼኤፖ ዻጋ ዎሮይዳዳ?","poem":2},{"lineBreak":true},{"text":"ጊንሣ ሃሣ ባዞይዳ ኔኤኒ ዻጋዺያ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሂኢዦ ኔኤኮ ኔኤኒ ካቲላፓ ኬሴኔ፤","poem":1},{"text":"ዱካኒያ ኔኤኒ ዓኣሤኔ፤","poem":2},{"lineBreak":true},{"text":"ሳዖ ኔኤኒ ዳርዚ ዎርዚ ማዤኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዹካ ኔና ዛጋዖ ዒጊቹሞና ጎጋይቄኔ፤","poem":1},{"text":"ዒሮ ዲጳኣ ሳዖ ፒፂ ዓኣዼኔ፤","poem":2},{"text":"ዼኤፖ ባዛ ጉኡሚ ዋይዚንቴኔ፤","poem":1},{"text":"ባዞ ጉዳሢያ ሌካ ዼግ ዼግ ጌዔኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኔኤኮ ዱኪንታ ሂኢዦንታ","poem":1},{"text":"ዜኤሊንሢጉዲ ፖዓ ዎርፆ ፖዒፃፓ ዔቄያና","poem":2},{"lineBreak":true},{"text":"ዓቦንታ ዓጊኖንታ ዓኣ ቤዛ ዔቄኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሳዖይዳ ኔኤኒ ባይዛ ባኮና ዔቄኔ፤","poem":1},{"text":"ኔኤኮ ዻጎና ሜሌ ዴሮ ኔኤኒ ሄርቄኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዴሮ ኔኤኮ ዓውሳኒ፥ ኔኤኒ ዶኦሚ ካኣታሤ ካኣቲ ዓውሳኒ ኔኤኒ ኬስኬኔ፤","poem":1},{"text":"ጎሞ ዓሶኮ ሱኡጋሢ ኔኤኒ ሄርቄኔ፤","poem":2},{"lineBreak":true},{"text":"ዒዛና ዎላ ዓኣ ዓሶ ኔኤኒ ባይዚ ካሎ ኔ ዓይሴኔ።","poem":2},{"lineBreak":true},{"text":"ቶካፓ ቶኦኮ ሄላንዳኣና ዒዛ ኔኤኒ ካላሴኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዓልጎ ዢባሬጉዲ ኑና ላኣላኒ ሙኬ","poem":1},{"text":"ዖሎ ዓሶኮ ሱኡጋሢ ዒዛ ሂኢዦና ኔኤኒ ዱኬኔ።","poem":2},{"lineBreak":true},{"text":"ላቤ ቆልሞ ጫሃኒ ዓፃዻ ቦዖጉዲ","poem":2},{"lineBreak":true},{"text":"ዒዚ ዓኣሺንቲ ዓኣ ማንቆንሢ ባይዛኒ ጊኢጌኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኔኤኒ ኔ ፓራሢና ባዞ ሄርቃኣና","poem":1},{"text":"ዬይ ዼኤፖ ባዛ ዓዓጊፃኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዬያ ቢያ ታ ዋይዛኣና ዒና ታኣኮ ዲቃቴኔ፤","poem":1},{"text":"ሙሱራ ታኣኮ ዒዛ ዑኡዞ ዋይዛዖ ጎጋይቃኔ፤","poem":2},{"lineBreak":true},{"text":"ዒጊቹማ ዴንዲ ታኣኮ ሜጌፆ ጋሮ ጌሌኔ፤","poem":2},{"lineBreak":true},{"text":"ቶካኣ ታኣኮ ጎጋይቄኔ፤","poem":1},{"text":"ኑና ሜታሳ ዴሮ ዑፃ ሜታ ሙካንዳያ ሄላንዳኣና","poem":2},{"lineBreak":true},{"text":"ዬኖ ኬሎ ጊቢ ዳንዳዒሢና ታኣኒ ካፓንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ቤሌሶ ሚፃ ዎዚ ቡኒባኣያታቴያ","poem":1},{"text":"ዎይኖ ዑፆይዳ ዓኣፒ ባኣያ ማዔቴያ","poem":2},{"text":"ሃሣ ሪሚቶ ሚፃኣ ዓኣፒ ባኣታቴያ","poem":1},{"text":"ጎዦ ጋራ ካፄ ሃኣኮ ባይቄያታቴያ","poem":2},{"text":"ማራታ ቢያ ሃይቂ ጋፔታቴያ","poem":1},{"text":"ባርቶ ጋራ ባይ ባኣያታቴያ፤","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዬይ ቢያ ማዔቴያ ታኣኮ ናንጊና ናንጋ ጎዳ ዓኣሢሮ ታ ዎዛዻንዳኔ፤","poem":1},{"text":"ታ ፆኦዛሢ፥ ታኣኮ ዼኤሻሢ ዓኣሢሮ ታ ዒላሻንዳኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢ ታኣኮ ዎልቃሢኬ፤","poem":1},{"text":"ዒዚ ቶኮ ታኣኮ ዎሾ ሹቁሊጉዲ ዶዲሻኔ፤","poem":2},{"lineBreak":true},{"text":"ዒዚ ታና ዹኮ ዑፆይዳ ሃንታንዳጉዲ ማኣዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}