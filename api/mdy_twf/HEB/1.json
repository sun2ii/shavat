{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"HEB","translationId":"mdy_twf","name":"ዔብሬ ዓሶም","commonName":"ዔብሬ ዓሶም","title":"ዔብሬ ዓሶም ዳኪንቴ ኪኢቶ","order":58,"numberOfChapters":13,"sha256":"245a27e834d1472ef8ae97bc6857dfe9f6106a6afb16beeca4154183693a8c4e","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/mdy_twf/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["ፆኦሲ ፔ ናዓሢ ዛሎና ኬኤዜሢ"]},{"type":"verse","number":1,"content":["ፆኦሲ ሚና ዱማ ዱማ ጎይሢና፥ ፔ ማሊፆ ኬኤዛ ዓሶ ዛሎና፥ ኑ ዓዶንሢም ሚርጌ ዎዴ ኬኤዜኔ፤"]},{"type":"verse","number":2,"content":["ሃሢ ጋዓንቴ ሃኖ ጋፒንፆ ዎዶና ቢያ ባኮ ዒዛም ዒ ማሄ፥ ፔ ናዓሢ ዛሎና ኑም ኬኤዜኔ፤ ዓጫ ቢያ ማዢንቴሢ ዒዛናኬ።"]},{"type":"verse","number":3,"content":["ዒዚ ፆኦሲ ቦንቾኮ ማላታ ሃሣ ዒዛኮ ዓኣ ዖኑማኣ ፆኦሲና ዎላ ፔቴ ማዓያኬ፤ ጊንሣ ሃሣ ቢታንታ ዓኣ ቃኣሎና ሳዖንታ ዓኣ ባኮ ቢያ ፔቴይዳ ዒ ዓርቄያኬ፤ ዓሶኮዋ ዒ ጎሞ ጌኤሼስካፓ ጫሪንጮይዳ ዼኤፖ ፆኦዛሢኮ ሚዛቆ ዛላ ዴዔኔ።"]},{"type":"heading","content":["ፆኦሲ ናዓሢኮ ኪኢታንቾይዳፓ ባሼ ማዒፆ"]},{"type":"verse","number":4,"content":["ዒዛም ጌሢንቴ ሱንፃ ኪኢታንቾ ሱንፆይዳፓ ባሼ ማዔ ጎይፆና ፆኦሲኮ ናዓሢ ኪኢታንቾይዳፓ ቢያ ባሻያኬ።"]},{"type":"verse","number":5,"content":["ዎይቲ ጌዔቴ ፆኦሲ ኪኢታንቾ ባኣካፓ፦",{"text":"«ኔኤኒ ታኣኮ ናዓሢኬ፤ ታ ኔኤኮ ሃኖ ዓዶ ማዔኔ።»","poem":1},"ሃሣ ጊንሣ፦",{"text":"«ታ ዒዛኮ ዓዶ ማዓንዳኔ፤ ዒ ታኣኮ ናኣዚ ማዓንዳኔ»","poem":1},"ጌዔይ ፔቴታዖ ባኣሴ።"]},{"type":"verse","number":6,"content":["ፆኦሲ ፔኤኮ ቶይዶ ናዓሢ ዓጮ ዳካኣና፦",{"text":"«ፆኦሲ ኪኢታንቻ ቢያ ዒዛም ዚጎንጎ» ጌዔኔ።","poem":1}]},{"type":"verse","number":7,"content":["ኪኢታንቾ ዛሎ ጋዓንቴ፦",{"text":"«ኪኢታንቾ ዢባሬ፥","poem":1},{"text":"ዒዛም ማዻ ዓሶዋ ታሚ ሎስቶ ታ ማሃንዳኔ» ጌዔኔ።","poem":2}]},{"type":"verse","number":8,"content":["ፔ ናዓሢ ዛሎ ጋዓንቴ፦",{"text":"«ፆኦሲዮ! ኔኤኮ ካኣቱሞ ዖይታ ናንጊና ባይቁዋዖ ናንጋንዳኔ፤","poem":1},{"text":"ኔኤኮ ካኣቱሞ ፂሉሞና ኔ ዔኪ ዓኣዻንዳኔ፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፂሉሞ ኔ ናሽኪ ፑርቱሞ ኔ ዒፄኔ፤","poem":1},{"lineBreak":true},{"text":"ዬያሮ ፆኦሲ፥ ኔ ፆኦዛሢ ኔና ዶኦሬኔ፤","poem":1},{"text":"ኔኤኮ ላጎይዳፓ ባሼ ዎዛ ዺቢሺ ኔኤም ዒዚ ዒንጌኔ» ጌዔኔ።","poem":2}]},{"type":"verse","number":10,"content":["ዬያጉዲ ሃሣ፦",{"text":"«ጎዳሢዮ! ኔኤኒ ቤርታ ሳዖ ማዤኔ፤","poem":1},{"text":"ጫሪንጮዋ ኔ ኩቻ ኔ ማዤያኬ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዬያታ ቢያ ባይቃንዳኔ፤","poem":1},{"lineBreak":true},{"text":"ኔኤኒ ጋዓንቴ ናንጊና ናንጋንዳኔ፤","poem":1},{"text":"ዔያታ ዓፒላጉዲ ጪንቃንዳኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሃሣ ኔ ዔያቶ ዼኤፒ ኮኦቴጉዲ ጳንጫንዳኔ፤","poem":1},{"text":"ዓፒላጉዲ ዔያታ ላኣሚንታንዳኔ፤","poem":2},{"text":"ኔኤኒ ጋዓንቴ ቢያ ዎዴ ኔናኬ፤","poem":1},{"text":"ፔቴታዖ ኔ ጋርቹዋያኬ» ጋዓኔ።","poem":2}]},{"type":"verse","number":13,"content":["ፆኦሲ ፔኤኮ ኪኢታንቾ ባኣካፓ፦",{"text":"«ኔ ሞርኮ ታ ኔና ባሺሳንዳያ ሄላንዳኣና","poem":1},{"text":"ታኣኮ ሚዛቆ ዛላ ዴዔ» ጌዔያ ፔቴታዖ ባኣሴ።","poem":2}]},{"type":"verse","number":14,"content":["ዓካሪ ኪኢታንቻ ዻቃዞንሢ ማኣዳኒ ፆኦሲፓ ዳኪንቲ ማዻ፥ ዓያኖቱዋዓዳ?"]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}