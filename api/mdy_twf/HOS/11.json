{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"HOS","translationId":"mdy_twf","name":"ሆሴዔ ማፃኣፖ","commonName":"ሆሴዔ ማፃኣፖ","title":"ሆሴዔ","order":28,"numberOfChapters":14,"sha256":"50eb018d6ab45069503d664462a1da969e2ba6b7bab7896ec382f16672f05b68","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mdy_twf/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["ፆኦሲ ዒዛኮ ዴራ ዋይዞ ዒፄቴያ ናሽኬ ናሹሞ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ዒስራዔኤሌ ሃጊ ናይ ዓኣንቴ ታኣኒ ናሽኬኔ፤","poem":2},{"lineBreak":true},{"text":"ታ ናኣዚ ጊብፄፓ ታኣኒ ዔኤሌኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጋዓንቴ ታ ዴራ፥ ዒስራዔኤሌ","poem":1},{"text":"ባሼ ታ ባንሢ ዑካንዳጉዲ ታኣኒ ዔያቶ ዔኤላዛ","poem":2},{"lineBreak":true},{"text":"ሃቺም ታ ጊዳፓ ሃኪ ሃኪ ዔያታ ዴንዴኔ።","poem":2},{"text":"ባዓኣሌ ጌይንታ ሜሌ ፆኦዞም ዒንጎ ባኮ ዒንጊፆንታ","poem":1},{"text":"ዬያ ፆኦዞ ማሊሲ ኮሾና ባኮም ዑንጆ ጩቢሺፆ ዔያታ ሃሺባኣሴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዔፕሬኤሜኮ ኩጮ ዓርቂ ታኣታሲ","poem":1},{"text":"ሃንቲሢ ዔርዜሢ ታናኬ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ጋዓንቴ ታኣኒ ዔያቶ ፓሤሢ ዔሪባኣሴ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዓሲ ዓሲ ሚጪንታ ሚጪንቲሢና","poem":1},{"text":"ናሹሞ ካኒ ቢራታና","poem":2},{"lineBreak":true},{"text":"ታኣኒ ዔያቶ ጎቺ ዓርቄኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶኮ ባቃና ዓኣ ቃንባሮ ዔኪ ሺኢሺ","poem":2},{"lineBreak":true},{"text":"ታኣኒ ታኣሮ ሂርኪ ጌይ ዔያቶ ሙኡዜኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":["«ዔያታ ጋዓንቴ ታ ባንሢ ማዖ ዒፄሢሮ ጊብፄ ዓጮ ማዒ ዴንዳኔ፤ ዓሶኦሬ ካኣቲያ ዔያቶ ዎይሣያ ማዓንዳኔ።"]},{"type":"verse","number":6,"content":["ሞርኮኮ ዖሎ ዓሳ ካታሞ ዔያቶኮ ዖላንዳኔ፤ ካታሞ ጌሎ ካሮዋ ሜንሣንዳኔ፤ ዔያቶኮ ፑርቶ ዞርቲፃኣ ጉሪ ማዒ ዓታንዳኔ።"]},{"type":"verse","number":7,"content":["ታ ዴራ ታ ባንሢ ማዖ ባሺንቲ ላምዖ ጎይካ ዔቄኔ፤ ያዺ ማዔቴያ ዼኤፒ ማዔሢ ባንሢ ዔያታ ዒላታኔ፤ ጋዓንቴ ማሊፆ ፔቴይዳ ዔቂሴይ ዖኦኒያ ባኣሴ።»"]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«ዔፕሬኤሜ! ታ ኔና ዎዲ ሃሻንዳይ?","poem":1},{"text":"ዎይቲ ታኣኒ ኔና ዓኣሢ ሜሌም ዒንጋንዳይ?","poem":2},{"text":"ዓዳኣማና ፄቦይሜ ካታሞናይዳ ታኣኒ ማዼ ጎይፆ","poem":1},{"text":"ዎይቲ ታኣኒ ኔጊዳ ማዾንዶይ?","poem":2},{"lineBreak":true},{"text":"ታኣኒ ኔና ናሽካ ናሹማ ኮሺ ዼኤፒታሢሮ","poem":2},{"lineBreak":true},{"text":"ዬያ ቢያ ታ ማዻኒ ዳንዳዑዋሴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታኣኒ ዒንሢ ባኣካ ዓኣ","poem":1},{"text":"ዱማዼ ፆኦሲ ማዓንዳኣፓዓቴም ዓሲቱዋሴ።","poem":2},{"lineBreak":true},{"text":"ዬያሮ ታኣኮ ባይዛ ዻጎ ታ ዒንሢዳ ኬይሳዓኬ፤","poem":2},{"lineBreak":true},{"text":"ላሚ ታኣኒ ዔፕሬኤሜ ባይዛዓኬ፤","poem":2},{"lineBreak":true},{"text":"ታ ዻጎና ታኣኒ ዒንሢ ባንሢ ዬዓዓኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":["«ታኣኒ፥ ናንጊና ናንጋ ጎዳ ዔያቶ ዓውሳኒ ጉዻ ዞቢጉዲ ጉዻዛ ዔያታ ታ ጊንፆ ዬዓንዳኔ፤ ታኣኮ ናኣታ ጎጋይቂ ጎጋይቂ ዓባ ጌላ ባንፃፓ ዬዓንዳኔ።"]},{"type":"verse","number":11,"content":["ካፒጉዲ ጊብፄፓ፥ ዶኦሌጉዲ ዓሶኦሬፓ ባራኒ ባራኒ ዔያታ ዬዓንዳኔ፤ ቤርታ ዔያታ ናንጋ ኬኤፆ ማሂ ታኣኒ ዔያቶ ጌልዛንዳኔ፤ ዬያ ጋዓሢ ታና፥ ናንጊና ናንጋ ጎዳኬ።»"]},{"type":"heading","content":["ፆኦሲ ፔ ዴሮይዳ ዓጌ ሜቶ"]},{"type":"verse","number":12,"content":["ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦ «ዔፕሬኤሜ ሉኡዙሞና፥ ዒስራዔኤሌያ ጌሺሢና ታ ኮይሎ ማንጊ ዔቄኔ፤ ዪሁዳኣ ፆኦሲም ዓይሢንቱዋያ ዒዚ ጉሙርቃ፥ ዱማዼሢያ ማኪ ዒፃያ ማዔኔ።»"]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}