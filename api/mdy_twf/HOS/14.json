{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"HOS","translationId":"mdy_twf","name":"ሆሴዔ ማፃኣፖ","commonName":"ሆሴዔ ማፃኣፖ","title":"ሆሴዔ","order":28,"numberOfChapters":14,"sha256":"50eb018d6ab45069503d664462a1da969e2ba6b7bab7896ec382f16672f05b68","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mdy_twf/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"heading","content":["ዒስራዔኤሌ ዴራ ፆኦሲ ባንሢ ማዓንዳጉዲ ሆሴዔ ዖኦጬሢ"]},{"type":"verse","number":1,"content":["ዒስራዔኤሌ ዴሬዮቴ! ዒንሢኮ ጎማ ዒንሢ ዹቂ ዣኣሊሴያታሢሮ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢ ባንሢ ማዑዋቴ።"]},{"type":"verse","number":2,"content":["ዒንሢ ቡኡፃንዳ ባኮ ዔሪ ናንጊና ናንጋ ጎዳ ባንሢ ማዑዋቴ፤ ሂዚ ጎዑዋቴ፦ «ኑኡኮ ጎሞ ቢያ ዓቶም ጌዔ፤ ኑና ማኣሪ ዔኬ፤ ኑኡኒያ ኑ ዻንጎና ኮሺ ዓኣፒ ማዔ ጋላታ ኔኤም ሺኢሻንዳኔ።"]},{"type":"verse","number":3,"content":["ዓሶኦሬ ኑና ዓውሳዓኬ፥ ዖሎ ፓራሢያ ኑኡኒ ጉሙርቁዋሴ፤ ሃይካፓ ሴካ ኑ ኩቻ ኑኡኒ ማዤ ባኮ ‹ፆኦሲ› ጌይ ኑ ዔኤላዓኬ፤ ናንጊና ናንጋ ጎዳሢዮ! ዜኤሮ ናኣቶ ኔኤኒ ሚጪንታያኬ።»"]},{"type":"heading","content":["ፆኦሲ ጎሞ ዓቶም ጋዓንዳያ ማዒፆ ኬኤዜሢ"]},{"type":"verse","number":4,"content":["ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦",{"text":"«ታ ዴሮኮ ጉሙርቂንቱዋያ ማዒፆ ታኣኒ ጊኢጊሺ","poem":1},{"text":"ታ ባንሢ ዔኪ ማሃንዳኔ።","poem":2},{"lineBreak":true},{"text":"ዻጋ ታኣኮ ዔያቶ ባንፃፓ ማዔሢሮ","poem":2},{"lineBreak":true},{"text":"ታኣኒ ታ ሼኔና ጉሪ ዔያቶ ናሽካንዳኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዒስራዔኤሌ ዴሮም ታኣኒ ፆፆዻ ዖልኬ ማዓዛ","poem":1},{"lineBreak":true},{"text":"ዔያታ ቡኒጉዲ ቡናንዳኔ፤","poem":1},{"text":"ሊባኖኦሴ ሚፆጉዲ ፃጲ ዔያታ ዳካንዳኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዓንታ ዔያቶኮ ዋርቃንዳኔ፤","poem":1},{"text":"ዛይቶ ሪሚቶጉዲያኣ ዔያታ ሚዛጲ","poem":2},{"text":"ሃሣ ሊባኖኦሴ ዴኤሎጉዲ ኮሺ ሳውሞ ዓኣያ ማዓንዳኔ።","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ጊንሣ ማዒ ታ ሺቦ ዴሞ ዔያታ ጌላንዳኔ፤","poem":1},{"text":"ሃጊ ባቃላ ሃኣኮጉዲ ዔያታ ዓኣዒ ሚዛጳንዳኔ፤","poem":2},{"text":"ዎይኔጉዲያኣ ዔያታ ቡናንዳኔ፤","poem":1},{"text":"ዔያቶኮ ሳውማ ሊባኖኦሴ ዎይኖ ዑዦሲጉዲ ዔርቴያ ማዓንዳኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዔፕሬኤሜ!","poem":1},{"text":"ሜሌ ፆኦዞና ዎላ ታኣኮ ዓይጎ ካኣሚ ዓኣይ?","poem":2},{"lineBreak":true},{"text":"ዒንሢኮ ሺኢጲፆ ዋይዛሢንታ ቶኦኮ ዒንሢኮ ዛጋሢ ታናኬ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ቢያ ዎዴ ዋርቄ ጎይሣ ዴዓ ዚቢቂጉዲኬ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢ ዓኣፒሳሢያኣ ታናኬ።»","poem":2}]},{"type":"heading","content":["ጋፒንሢ ሃይሴ"]},{"type":"verse","number":9,"content":["ዔራቶ ዓኣ ዓሲ ዬንሢ ባኮ ዒና ዔካንዳኔ፤ ማሊ ጶቂሣ ዓሲያኣ ዔራንዳኔ፤ ናንጊና ናንጋ ጎዳኮ ጎይፃ ፒዜኬ፤ ፂሎ ዓሳ ዒዞና ሃንታኔ፤ ጎሞ ዓሳ ጋዓንቴ ዹቂንቲ ዒኢካ ሎሎኦማኔ።"]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}