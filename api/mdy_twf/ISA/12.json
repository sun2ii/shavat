{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"ISA","translationId":"mdy_twf","name":"ዒሲያሴ ማፃኣፖ","commonName":"ዒሲያሴ ማፃኣፖ","title":"ዒሲያሴ ማፃኣፖ","order":23,"numberOfChapters":66,"sha256":"0585110711ab765bb8ad52ae6d6c3dab40fe368c20e71e6d5dd66f2fb946a5fd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mdy_twf/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":12,"content":[{"type":"heading","content":["ጋላታ ዓይኑሞ"]},{"type":"verse","number":1,"content":[{"text":"ዬኖ ዎዶና ኔ ሂዚ ጌይ ናንጊና ናንጋ ጎዳ ቦንቾም ዓይናዻንዳኔ፦","poem":1},{"text":"«ናንጊና ናንጋ ጎዳሢዮ! ሃያኮ ቤርታ ኔ ታና ጎሬኔ፤","poem":2},{"lineBreak":true},{"text":"ሃሢ ኔ ጋዓንቴ ዻጎ ኔኤኮ ማሂ","poem":2},{"lineBreak":true},{"text":"ታና ዶዲሼሢሮ ታ ኔና ጋላታኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጎኔና ፆኦሲ ታኣኮ ዼኤሻሢኬ፤","poem":1},{"text":"ዒዛ ታ ጉሙርቃሢሮ ታና ዒጊቻያ ባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳሢ ታኣኮ ዎልቃሢና ዶዱማሢናኬ፤","poem":2},{"lineBreak":true},{"text":"ዒዚ ታኣኮ ዼኤሻሢያ ማዔኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዻቂንቶኮ ዓልቃ ዋኣፆ","poem":1},{"text":"ዎዛና ዒንሢ ዱዓንዳኔ።»","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዬኖ ኬሎና ሂዚ ዒንሢ ጋዓንዳኔ፦","poem":1},{"text":"«ናንጊና ናንጋ ጎዳ ጋላቱዋቴ!","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ሱንፆዋ ቦንቹዋቴ!","poem":2},{"lineBreak":true},{"text":"ዴሮ ባኣካ ዒዚ ማዼ ባኮ ኬኤዙዋቴ!","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ዼኤፑሞዋ ማርካዹዋቴ!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዒዛኮ ዼኤፖ ማዾሮ ናንጊና ናንጋ ጎዳ ቦንቾም ዓይናዹዋቴ!","poem":1},{"text":"ዬይ ዒዛኮ ዼኤፖ ማዻ ዓጮ ቢያይዳ ዔርታንዳጉዲ ማሁዋቴ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዒንሢ ባኣካ ዓኣ ዒስራዔኤሌ ዓሶኮ ዱማዼሢ ዼኤፒ ማዔሢሮ","poem":1},{"text":"ፂዮኔይዳ ናንጋ ዓሳ ቢያ ዎዛና ዒላሹዋቴ!»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}