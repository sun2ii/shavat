{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"ISA","translationId":"mdy_twf","name":"ዒሲያሴ ማፃኣፖ","commonName":"ዒሲያሴ ማፃኣፖ","title":"ዒሲያሴ ማፃኣፖ","order":23,"numberOfChapters":66,"sha256":"0585110711ab765bb8ad52ae6d6c3dab40fe368c20e71e6d5dd66f2fb946a5fd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mdy_twf/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":20,"content":[{"type":"heading","content":["ካሎ ሃንቴ ፆኦሲ ማሊፆ ኬኤዛሢኮ ማላቶ ማዒፆ"]},{"type":"verse","number":1,"content":["ዓሶኦሬ ካኣቲ ማዔ ሳርጎኦኔ ዓይሤም ዒዛኮ ዖሎ ዓሶ ዓይሣሢ ፒሊስፄኤሜ ካታሞ ማዔዞ ዓሽዶኦዴ ዖሌኔ፤"]},{"type":"verse","number":2,"content":["ዒማና ናንጊና ናንጋ ጎዳ ዓሞፄ ናኣዚ ዒሲያሴ፦ «ኔኤኮ ዱርዞና ሲዮ ማኣዓሢና ኬሲ ቶኪ ጉሪ ሃንቴ» ጌዒ ዓይሤኔ። ዬያሮ ቃኣሎም ዓይሢንቲሢና ካሎ፥ ጊንሣ ሃሣ ቶኪ ጉሪ ዒ ሃንቴኔ።"]},{"type":"verse","number":3,"content":["ናንጊና ናንጋ ጎዳ፦ «ታኣም ማዻሢ ዒሲያሴ ካሎ፥ ሃሣ ቶኪ ጉሪ ሃይሦ ሌዔ ጉቤ ጊብፄና ዒቶጲያ ዓጮናይዳ ሄላንዳ ባኮኮ ማላታ ማዒ ሃንቴሢጉዲ፥"]},{"type":"verse","number":4,"content":["ዓሶኦሬ ካኣቲ ዬንሢ ላምዖ ዓጮንሢዳፓ ዲዒ ዔኬ ዓሶ፥ ዼጌሢንታ ጋርቾንታ ጊብፄ ዓጮኮ ዻውሲንቲ ማዓንዳጉዲ ዑሢ ካሎ ሃሣ ቶኪ ጉሪያ ሃንቲሲ ዔኪ ዓኣዻንዳኔ።"]},{"type":"verse","number":5,"content":["ጉሙርቂፆ ዒቶጲያይዳ ጌሣዞንሢና ጊብፄይዳ ጌኤቂንቲ ሄርሺንታዞንሢ ቢያ ካራ ዔያቶኮ ባይቄም ዻውሲንታንዳኔ።"]},{"type":"verse","number":6,"content":["ዬኖ ዎዶና ባዞ ዓጫ ናንጋ ዓሳ፦ ‹ኑና ዓሶኦሬ ካኣቲዳፓ ዻቂሻንዳኔ ጌዒ ኑ ጉሙርቂ፥ ዔያቶ ባንሢያ ዶጬ ዓጫ ዎዎይቴቴያ ሂንዳ ዛጉዋቴ! ኑኡኒ ዓካሪ ዎይቲ ቶላንዳይ?› ጋዓንዳኔ» ጌዔኔ።"]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/ISA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/ISA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/ISA/19.json","previousChapterAudioLinks":{},"numberOfVerses":6}