{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"ISA","translationId":"mdy_twf","name":"ዒሲያሴ ማፃኣፖ","commonName":"ዒሲያሴ ማፃኣፖ","title":"ዒሲያሴ ማፃኣፖ","order":23,"numberOfChapters":66,"sha256":"0585110711ab765bb8ad52ae6d6c3dab40fe368c20e71e6d5dd66f2fb946a5fd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mdy_twf/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":35,"content":[{"type":"heading","content":["ማሂ ሻንቂንቲ ዔውቴ ዴሮ ዎዛ"]},{"type":"verse","number":1,"content":[{"text":"ዓሲ ናንጉዋ ዳውሎንታ ሃንጎ ሳዓኣ ዎዛዻንዳኔ፤","poem":1},{"text":"ዬያ ዳውሎይዳ ቡኒ ቡናንዳኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዳውላ ዹኡቄ ቡኖና ኩማንዳኔ፤","poem":1},{"text":"ዎዛ ዓይኑሞ ዔያታ ዓይናዻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዓዳ ሊባኖኦሴ ዹኮጉዲ ዲቃሣያ ዔያታ ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ቄርሜሎሴ ዹኮጉዲ፥ ሃንጎ ሳኣሮኔ ዶኦጮጉዲ ሚዛጳያ ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ቢያሢ ናንጊና ናንጋ ጎዳኮ ቦንቾንታ","poem":2},{"lineBreak":true},{"text":"ኑ ፆኦዛሢኮ ዲቃሣያ ማዒፆዋ ዛጋንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ዒንሢኮ ላቤ ኩጮንታ ኮልኮልቄ ጉኡዦዋ ዶዲሹዋቴ።","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ዒጊጫ ዒና ዓኣዞንሢም፦ «ዓካሪ ዒንሢ ፆኦዛሢ","poem":1},{"text":"ዒንሢ ሞርኮ ኮሜ ዔካኒና ዔያቶ ዻቢንቶኮ ኮይሳሢ ዒንጋኒ","poem":2},{"lineBreak":true},{"text":"ሙኪ ዒንሢ ዒዚ ዻቂሻንዳሢሮ ዶዱዋቴ! ዒጊጪፖቴ!» ጎዑዋቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ዒማና ዓኣፖ ባይቄ ዓሳ ዛጋንዳኔ፤","poem":1},{"text":"ዋዮ ባይቄ ዓሳኣ ዋይዛንዳኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ቶኮ ዎቦ ዓሳ ጌንዖጉዲ ፂካንዳኔ፤","poem":1},{"text":"ዻንጎ ባይቄ ዓሳ ዎዛ ዓይኑሞ ዓይናዻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዓሳ ናንጉዋ ዳውሎይዳ ዋኣሢ ዑርታንዳኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሙርቁንፆጉዴ ማኣሻላ ቦቆሊ ማዓንዳኔ፤","poem":1},{"text":"ሜሎ ሳዓ ዓልቃ ዋኣሢና ሎጫንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዉኡካሢ ፂካ ቤዞይዳ ዓኣዔ ማኣቲና ማጫሬና ኬስካንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ዒኢና ዳልጊ ጎይሢ ኬስካንዳኔ፤","poem":1},{"text":"ዱማዼ ጎይሢያ ጌይንታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዬይ ጎይፃሢ ፆኦሲ ዓሶም ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ጌኤሺ ማዒባኣ ዓሲ ዬኖ ጎይፆና ዓኣዹዋሴ፤","poem":2},{"lineBreak":true},{"text":"ዔኤዮ ዓሳኣ ዒዞና ዓኣዻኒ ዳንዳዑዋሴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዞቢ ማዔታቴያ ሜሌ ፑርታ ቦዖ ዬይና ዓኣዹዋሴ፤","poem":1},{"text":"ዬኖ ጎይፆና ሃንታዞንሢ ፆኦሲ ዓውሴ ፃጶ ሌሊ ማዓንዳኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ፆኦሲ ዓውሴ ዓሳ ማዒ ጊንሣ ሙካንዳኔ፤","poem":1},{"text":"ፆኦሲ ቦንቾም ዓይናዺ ዓይናዺ ፂዮኔ ዔያታ ጌላንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ቢያ ዎዴና ዎዛዼ ጎይሣ ዔያታ ናንጋንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ኮሹሞና ዎዛና ዔያታ ዴንቃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዖዪሢና ሂርጋና ዔያቶፓ ሃካንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}