{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"ISA","translationId":"mdy_twf","name":"ዒሲያሴ ማፃኣፖ","commonName":"ዒሲያሴ ማፃኣፖ","title":"ዒሲያሴ ማፃኣፖ","order":23,"numberOfChapters":66,"sha256":"0585110711ab765bb8ad52ae6d6c3dab40fe368c20e71e6d5dd66f2fb946a5fd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mdy_twf/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":["ዬኖ ዎዶና ላንካይ ላኣሊ ፔቴ ዓቲንቄ ዓርቃዖ፦ «ሙኡዚናታቴያ ማኣዖና ኑ ቶኦኮ ኑ ዳንዳዒ ዎርቃንዳኔ፤ ‹ዓኒ ዔያቶኮ ባኣሴ› ጌይንቲ ጫሽኪንቶፓ ኑ ኔ ማቾንሢ ጌይንቲ ዔኤሊንታንዳጉዲ ሌሊ ኔ ዔኤዔቴራ!» ጌይ ዒዛ ሺኢቃንዳኔ።"]},{"type":"heading","content":["ዬሩሳላሜ ላሚ ዓካሶናሢ"]},{"type":"verse","number":2,"content":["ዬኖ ኬሎና ናንጊና ናንጋ ጎዳ ዓጬሎይዳ ዓኣ ቱኮና ሚፆ ካኣፖኮ ዋዻ ሚዛጴያና ቦንቺንቴያ ማሃንዳኔ፤ ዒስራዔኤሌ ፃጶኮ ባይሲንታፓ ዓቴዞንሢ ቢያ ሳዔላ ካሣ ሃኣኮና ዎዛዺ ዖቶርቃንዳኔ።"]},{"type":"verse","number":3,"content":["ዬሩሳላሜይዳ ፒኢጫዺ ዓቴዞንሢና ዒኢካ ናንጋንዳጉዲ ዓይሦናዞንሢ ዖኦሲም ዱማዼ ዴሬ ጌይንቲ ዔኤሊንታንዳኔ።"]},{"type":"verse","number":4,"content":["ዬሩሳላሜኮ ዒኢቲፆ ሻቲንሣንዳኔ፤ ዒ ዎጋ ዎጎና ታሞጉዲ ሚቻ ፔኤኮ ዓያኖ ዎልቆና ዓሲ ዎዺሢ ዒዞ ባኣካፓ ባይዛንዳኔ።"]},{"type":"verse","number":5,"content":["ዬካፓ ናንጊና ናንጋ ጎዳ ካታሞ ጉቤና፥ ዒኢካ ቡኪንታ ቢያሢዳ ሮኦሮና ዹሜ ሻኣሬ፥ ዋኣንቶና ታሚ ሎስቶ ፖዒ ዳካንዳኔ። ፆኦሲኮ ቦንቻ ካታሜሎ ዼኤፒ ዓፒላፓ ኮሾና ማኣሪጉዲ ካንቂ ካፓንዳኔ።"]},{"type":"verse","number":6,"content":["ዒዛኮ ቦንቻ ካታሜሎ ሮኦሮና ዓባ ሚቻሢዳፓ ሺባንዳኔ፤ ሃሣ ዒርዚና ጉዶ ዢባሬናይዳፓ ቶሊ ዓቶ ቤሲ ማዓንዳኔ።"]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/ISA/4.json","thisChapterAudioLinks":{},"