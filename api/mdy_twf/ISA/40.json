{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"ISA","translationId":"mdy_twf","name":"ዒሲያሴ ማፃኣፖ","commonName":"ዒሲያሴ ማፃኣፖ","title":"ዒሲያሴ ማፃኣፖ","order":23,"numberOfChapters":66,"sha256":"0585110711ab765bb8ad52ae6d6c3dab40fe368c20e71e6d5dd66f2fb946a5fd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mdy_twf/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":40,"content":[{"type":"heading","content":["ፆኦሲኮ ዴሮ ዶዲሻ ቃኣላ"]},{"type":"verse","number":1,"content":[{"text":"ኑ ፆኦዛሢ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ዴሮ ታኣኮ ዶዲሹዋቴ! ዶዲሹዋቴ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዓይሌ ማዒ ዒዞኮ ማዾ ዎዳ ጋፔኔ፤ ዒዞኮ ጎሞ ዛሎሮ ቢያ ፆኦሲዳፓ ጳንጬ ሜቶ ዒዛ ዔኬሢንታ ጎማኣ ዒዞኮ ዓቶም ጌይንቴሢ ዬሩሳላሜም ሌፔ ዑኡሲና ኬኤዙዋቴ።»","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ሂዚ ጋዓ ዑኡሲ ዋይዚንታኔ፦","poem":1},{"text":"«ዓሲ ናንጉዋ ዳውሎይዳ ናንጊና ናንጋ ጎዳኮ ጎይፆ ጊኢጊሹዋቴ!","poem":2},{"lineBreak":true},{"text":"ዳውሎይዳ ኑ ፆኦዛሢም ጎይፆ ጲሺ ኮሹዋቴ!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዔታዻ ቤዞና ዶኦጫዻ ቤዛ ኩሚ ጊኢጎንጎ፤","poem":1},{"text":"ዹኮንታ ጌሜሮንታ ቢያ ሂርኪዲ ባኣሲንቶንጎ፤","poem":2},{"lineBreak":true},{"text":"ጌሜሮንታ ጌሊ ኬስኪ ጌዔ ሳዓኣ ቢያ ጊኢጎንጎ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዬኖ ዎዶና ናንጊና ናንጋ ጎዳኮ ቦንቻ ፔጋዺ ጴዻንዳኔ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ዬያ ኬኤዜያ ማዔሢሮ","poem":2},{"lineBreak":true},{"text":"ዓሳ ቢያ ዬያ ፔቱሞና ዛጋንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ፔቴ ዑኡሲ ታና «ዒላቴ!» ጌዔኔ፤","poem":1},{"text":"ታኣኒያ ማሃዖ፦ «ዎዚ ጌዒ ታ ዒላቶንዶይ!» ጌዒ ዖኦጬኔ፤","poem":2},{"lineBreak":true},{"text":"ዬና ዑኡዜላ «ዓሲ ቢያ ማኣቲጉዲኬ፤","poem":2},{"text":"ቦንቻኣ ቢያ ካይዚ ቡኒጉዲኬ፤","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳኮ ዢባራ ዢባርሻ ዎዶና","poem":1},{"text":"ማኣታ ሜላሢና ቡና ዲኢናሢጉዲ","poem":2},{"lineBreak":true},{"text":"ዓሲያ ዬያጉዴያኬ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጎኔና ማኣታ ሜላኔ፥ ቡናኣ ዲኢናኔ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳሢኮ ቃኣላ ጋዓንቴ ናንጊና ዶዲ ናንጋኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ዒንሢ ፂዮኔም ኮዦ ባኮ ኬኤዛ ዓሳ!","poem":1},{"text":"ሌካ ዼጌ ዹኮ ኬስኩዋቴ!","poem":2},{"lineBreak":true},{"text":"ዒንሢ ዬሩሳላሜም ኮዦ ሃይሶ ኬኤዛ ዓሳ!","poem":2},{"lineBreak":true},{"text":"ዑኡዞ ዒንሢኮ ዼጊዲ ዒላቱዋቴ!","poem":2},{"lineBreak":true},{"text":"ዒላቱዋቴ ዒጊጪፖቴ!","poem":2},{"lineBreak":true},{"text":"ዪሁዳ ካታሞም፦ «ፆኦዛሢ ዒንሢኮ ሃይሾ!» ጎዑዋቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ናንጊና ናንጋ ጎዳ ፔኤኮ ዼኤፖ ዎልቆና ዎይሣኒ ሙካንዳኔ፤","poem":1},{"text":"ዒዚ ሙካሢ ዒንጋኒ ማሌ ባኮንታ ማዼሢ ዛሎ ጪጎንዶሢያ ዔኪኬ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ቆልሞ ሄንቃ ዓሲጉዲ ዒዚ ሄንቃንዳኔ፤","poem":1},{"text":"ላኣቆ ማራናኣቶ ፔቴይዳ ዒ ቡኩሳንዳኔ፤","poem":2},{"text":"ፔኤኮ ቃሶይዳ ኮንቂ ዔያቶ ዔካንዳኔ፤","poem":1},{"text":"ናኣቶ ዻንሢሣዞንሢያ ጉኡዱዋዖ ታሢ ዒሻንዳኔ።","poem":2}]},{"type":"heading","content":["ዒስራዔኤሌ ፆኦሲና ዖ ቤቃይ?"]},{"type":"verse","number":12,"content":[{"text":"ዼኤፖ ባዞ ዋኣፆ ፔኤኮ ቃኣቆ ጋራ","poem":1},{"text":"ጫሪንጮዋ ፔ ኬኤላና","poem":2},{"text":"ሳዖ ዓጮ ማኪ ዔራኒ ዳንዳዓሢ ዖናዳይ?","poem":1},{"text":"ዹኮንታ ጌሜሮንታ ዴኤሡሞ ዔሮ ባኮና ዛጊ ዔራንዳሢ ዖናዳይ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ናንጊና ናንጋ ጎዳ፦ «ሂዲ ማዼ» ጌዒ ዓይሣሢ ዖናዳይ?","poem":1},{"text":"ዒዛ ዔርዛኒና ዞራኒያ ዳንዳዓያ ዖናዳይ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዒዛም ኬኤዛንዳጉዲ ፆኦሲ ዖኦና ዞርቴይ?","poem":1},{"text":"ፒዜ ዎጎ ዔርዜሢ ዒዛ ዖናዳይ?","poem":2},{"lineBreak":true},{"text":"ዔራቶ ዒዛ ዔርዜሢንታ","poem":2},{"lineBreak":true},{"text":"ማሊ ጶቂሦ ጎይፆዋ ዖ ዒዛ ዻዌይ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ናንጊና ናንጋ ጎዳኮ ቤርታ ዴራ ፔቴ ዖቲ ጋርካ ፆዼ ዋኣሢጉዲኬ፤","poem":1},{"text":"ዴኤሡሞ ዔሮ ባኮይዳ ዓኣ ሲላሊጉዲ ፓይዲንታኔ፤","poem":2},{"lineBreak":true},{"text":"ዋኣፆ ሳዛ ዓኣ ሳዓኣ ዒዛ ቤርታ ዓዳ ሲላሊ ሊኢቃጉዲ ሼሌዓያኬ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሊባኖኦሴይዳ ዓኣ ሚፃ ሚቺ ዒንጎ ዒንጊፆ ታሞ ዔኤሣኒ","poem":1},{"text":"ቆልማኣ ዒዞኮ ሚቺ ዒንጎ ዒንጊፆም ጊዳያቱዋሴ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ፆኦሲ ቤርታ ዴሮኮ ፓይዳ ባኣያኬ፤","poem":1},{"text":"ላኣፒፃፓ ዔቄያና ፓይዲዳ ጌሉዋያኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ፆኦሲ ዒንሢ ዖኦና ዎላ ቤኤዛይ?","poem":1},{"text":"ዖኦና ዎላ ዒንሢ ዒዛ ሄካሳይ?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሜሌ ፆኦዞ ሃኣሚ ቆኦቂ ኮሻኔ፤","poem":1},{"text":"ዎርቆ ኮሻሢያ ጳርቂ ጊኢጊሻኔ፤","poem":2},{"lineBreak":true},{"text":"ቢሮ ዓንጎዋ ካኒ ቢራታ ኮሺ ማይሳኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዔኤቢባኣ ማንቃሢ ኮሳዹዋ ሚሢ ዶኦራኔ፤","poem":1},{"text":"ዶዑዋ ማላታ ዒዛም ኮሺንታንዳጉዲ","poem":2},{"lineBreak":true},{"text":"ዔርቴ ሃኣሚ ዓሲ ዒ ኮዓኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ፔቴታዖ ዬያ ዔሩዋዓዳ? ዒንሢ ዋይዚባኣዓዳ?","poem":1},{"text":"ሚናኣፓ ዓርቃዖ ዒንሢም ኬኤዚንቲባኣዳ?","poem":2},{"lineBreak":true},{"text":"ሳዓ ማዢንቴማኣፓ ዓርቃዖ ማሊ ዒንሢ ጶቂሡዋዓዳ?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ሳዓ ማዔ ካሮይዳ ፆኦሲ ፔ ሻኣሎ ጌሢ ዴዔሢ","poem":1},{"text":"ጫሪንጮ ዓዳ ጎኦቦ ዓፒላጉዲ ዳሬሢ","poem":2},{"lineBreak":true},{"text":"ዓፒላፓ ኮሾ ናንጎ ማኣሮጉዲ ዾቄሢ","poem":2},{"lineBreak":true},{"text":"ዓጮ ዴራ ፃቆጉዲ ዻካ ማዔሢያ ዔሩዋዓዳ ዒንሢ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ዒዚ ዼኤፖ ዓሶ ዻውሲሳኔ፤","poem":1},{"text":"ሃያ ዓጮ ሱኡጎ ባኣያ ማሃኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዔያታ ሃጊ ባቃሌያና ፃጲ ዳኪባኣ ባቃሊጉዲኬ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ዢባሮ ፔኤኮ ዳካዛ ቤዞና ዔያታ ሜላኔ፤","poem":2},{"lineBreak":true},{"text":"ዲልባጉዲ ላኣሊንቲያ ዔያታ ባይቃኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"«ሂዳዖ ታና ዒንሢ ዖኦና ዎላ ቤኤዛይ?","poem":1},{"text":"ዖኦና ዎላ ዒንሢ ታና ሄካሳይ?» ጋዓኔ ዱማዼ ፆኦዛሢ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዼጊ ጌዒ ጫሪንጮ ሌካ ዛጉዋቴ፤","poem":1},{"text":"ዒንሢ ዛጋ ዦኦጋሢ ማዤሢ ዖናዳይ?","poem":2},{"lineBreak":true},{"text":"ዒዚ ዖልዚ ዖላ ዓሲጉዲ ዔያቶ ዔኪ ዓኣዻኔ፤","poem":2},{"lineBreak":true},{"text":"ዎማዼታቴያ ፓይዶ ዔያቶኮ ዒዚ ዔራኔ፤","poem":2},{"lineBreak":true},{"text":"ፔቴ ፔቴሢ ፔ ሱንሢና ዔያቶ ዔኤላኔ፤","poem":2},{"text":"ዒዛኮ ቢታንቶንታ ዎልቆንታ ሚርጌና ዼኤፒኬ፤","poem":1},{"text":"ዬያሮ ዔያቶይዳፓ ፔቴታዖ ባይቃዓኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ያይቆኦቤ፥ ዓይጋ ኔ ሃያ ጋዓይ?","poem":1},{"text":"ዒስራዔኤሌ፥ ዓይጋ ኔ ሂዚ ጌዒ ጌስታይ?","poem":2},{"lineBreak":true},{"text":"«ጎይፃ ታኣሲ ፆኦሲ ዓኣፓፓ ዓኣሺንቴኔ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ታኣም ዎጋንዳሢያ ሃሼኔ» ዓይጋ ኔ ጋዓይ?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ፔቴታዖ ኔኤኒ ዔሩዋዓዳ?","poem":1},{"text":"ዋይዚያ ኔኤኒ ዋይዚባኣዓዳ?","poem":2},{"lineBreak":true},{"text":"ፆኦሲ ናንጊና ናንጋ ጎዳኬ፤","poem":2},{"text":"ዓጮ ቢያ ማዤሢ ዒዛኬ፤","poem":1},{"text":"ዒዚ ፔቴታዖ ላቢንቱዋሴ፥ ማሊፆዋ ፔኤኮ ሺርሹዋሴ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ላቤዞንሢም ዒዚ ዶዱሞ ዒንጋኔ፤","poem":1},{"text":"ዎልቃ ኬዴዞንሢማኣ ዎልቄ ቃሳኔ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ጶሾራ ላላባኔ፥ ዎልቄባኣያ ማማዓኔ፤","poem":1},{"text":"ዼጌሢያ ባሺንቲ ሎሎኦማኔ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ናንጊና ናንጋ ጎዳ ጉሙርቂ ናንጋዞንሢኮ ጋዓንቴ","poem":1},{"text":"ዎልቃ ጊንሣ ዶዳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዓዳ ኮኦኬጉዲ ጋኣሲና ባራናንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ጳሽኪያ ጳሽካንዳኔ፥ ላቢንዱዋሴ፤","poem":2},{"lineBreak":true},{"text":"ሃንታንዳኔ፥ ላቢንቲ ዔያታ ሎኦማዓኬ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}