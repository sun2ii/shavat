{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"ISA","translationId":"mdy_twf","name":"ዒሲያሴ ማፃኣፖ","commonName":"ዒሲያሴ ማፃኣፖ","title":"ዒሲያሴ ማፃኣፖ","order":23,"numberOfChapters":66,"sha256":"0585110711ab765bb8ad52ae6d6c3dab40fe368c20e71e6d5dd66f2fb946a5fd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mdy_twf/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":41,"content":[{"type":"heading","content":["ፆኦሲ ዒስራዔኤሌ ዓሶም ዒንጌ ሃጊ ማዓ ዎዛ"]},{"type":"verse","number":1,"content":[{"text":"ፆኦሲ ሂዚ ጋዓኔ፦ «ዒንሢ ዋኣፆ ሳዞ ዓጫ ናንጋ ዴራ!","poem":1},{"text":"ዚቲ ጌዒጋፓ ዋይዙዋቴ!","poem":2},{"lineBreak":true},{"text":"ዴራ ዎልቆ ፔኤሲ ጊንሣ ዶዲሺ፥ ሃኒ ሙኪያ ኬኤዞንጎ፤","poem":2},{"lineBreak":true},{"text":"ዎጎ ቤዛ ዎላ ኑ ካኣሞም።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«ዎልቆሲ ዓባ ኬስካ ባንፃፓ ዔቂሲ ዔኪ ሙኬሢ","poem":1},{"text":"ዒዛም ማዻንዳጉዲ ዔኤሌሢ ዖናዳይ?","poem":2},{"lineBreak":true},{"text":"ዴሮ ዓኣሢ ዒዛም ዒንጌኔ፤","poem":2},{"lineBreak":true},{"text":"ካኣቶዋ ዒዛ ዴማ ዎርቃንዳጉዲ ማሄኔ፤","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ጬንቾ ዓፓሮም ዔያቶ ዒ ሲላሊ ማሂ","poem":2},{"lineBreak":true},{"text":"ሂኢዦማኣ ዲልባ ማሂ ዓኣሢ ዒንጌኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዬያኮ ቤርታ ፔ ቶኦኪና ዔያታ ዓኣዺ ቤቂባኣ ጎይሢና","poem":1},{"text":"ዔያቶ ዒ ዳውሴኔ፥ ፔቴታዖ ዒዛ ቃዜ ባኣዚ ባኣሴ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዬይ ማዓንዳጉዲ ዓይሤሢ ዖናዳይ?","poem":1},{"text":"ዓይፃፓ ዓርቃዖ ዓሲኮ ሾይንቶ ፓይዲ ዔራሢ ዖናዳይ?","poem":2},{"lineBreak":true},{"text":"ታኣኒ ናንጊና ናንጋ ጎዳ ቤርታኣፓ ዓኣኔ፤","poem":2},{"lineBreak":true},{"text":"ጋፖይዳ ጴዻሢያ ታናኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«ዋኣፆ ሳዛ ዓኣ ዓጮይዳ ናንጋ ዴራ","poem":1},{"text":"ታኣኒ ማዼ ባኮ ቢያ ዛጌኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያሮ ሚርጌና ዔያታ ዲቃቲ ጎጋይቄኔ፤","poem":2},{"lineBreak":true},{"text":"ፔቱሞና ቡኪ ታ ባንሢ ዔያታ ሙኬኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ፔቴሢ ባጋሢ ማኣዳኔ፤","poem":1},{"text":"ጌርሲ ፔ ጌርሲ፦ ‹ሃይ ኔ ዎይታይ ዶዴ!› ጋዓኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሃኣማሢ ዎርቆ ሼኤሻሢ ዶዲሻኔ፤","poem":1},{"text":"ሜሌ ፆኦዞ ሞቶሾና ዹይ ጊኢጊሻሢያ","poem":2},{"text":"ሚስማሮና ጳርቃሢም፦","poem":1},{"text":"‹ሃይ ኔ ዎይታይ ዶዴ! ኔ ቃራ ዺሽኪ ዓይሤኔ!› ጋዓኔ፤","poem":2},{"lineBreak":true},{"text":"ሜሌ ፆኦዞ ዓጊፁዋጉዲ ሚስማሮና ዔያታ ጳርቃኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«ጋዓንቴ ኔኤኒ ታ ዓይላሦ ዒስራዔኤሌ!","poem":1},{"text":"ታ ኔና ዶኦሬሦ ያይቆኦቤ!","poem":2},{"lineBreak":true},{"text":"ታ ላጋሢ ዓቢራሃሜ ዜርፃሢዮ!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሳዓ ማዔ ካራፓ ታ ኔና ዔኪ ሙኬኔ፤","poem":1},{"text":"ዓጮኮ ጋፓፓ ታኣኒ ኔና ዔኤሌኔ፤","poem":2},{"lineBreak":true},{"text":"‹ኔ ታ ዓይሌኬ› ጌዒ ታ ኔና ዶዶኦሬኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ኔና ኬኤሪባኣሴ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታኣኒ ኔኤና ዎላታሢሮ ዒጊጪፖ!","poem":1},{"text":"ታ ኔኤኮ ፆኦዛሢኬ፥ ሃጊ ማዓ ዎዛ ቲቂፖ!","poem":2},{"lineBreak":true},{"text":"ታኣኒ ኔና ዶዲሻንዳኔ፥ ማኣዳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኮ ዶዶ ኩጮና ታ ኔና ዓርቃንዳኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኔ ዑፃ ዻጋዻ ዓሳ ቢያ","poem":1},{"text":"ባሺንቲ ቦርሲንታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ኔና ሜታሳኒ ዔቃዞንሢያ ቤሲ ባይቃንዳኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሞርኮ ኔኤኮ ኔ ኮዓንዳኔ፤","poem":1},{"text":"ጋዓንቴ ኔኤኒ ዔያቶ ዴንቃዓኬ፤","poem":2},{"lineBreak":true},{"text":"ኔ ዑፃ ዖሎ ቡሌዞንሢ","poem":2},{"lineBreak":true},{"text":"ጋፒ ባይቃንዳኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"‹ሃይ ኔኤኒ ዎይታይ፥ ዲቃቲፖ፤","poem":1},{"text":"ኔኤኮ ሚዛቆ ኩጮ ዓርቂ ታ ኔና ማኣዳንዳኔ›","poem":2},{"lineBreak":true},{"text":"ጌዒ ኔና ዶዲሻሢ፥ ታና ኔኤኮ ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ናንጊና ናንጋ ጎዳ፦","poem":1},{"text":"«ኔኤኒ ዛኣሌጉዲ ማዔሦ ያይቆኦቤ!","poem":2},{"lineBreak":true},{"text":"ላኣፓ ማዔሦ ዒስራዔኤሌ!","poem":2},{"lineBreak":true},{"text":"ዒጊጪፖ ታ ኔና ማኣዳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ኔና ዓውሳ ዒስራዔኤሌኮ ዱማዼሢ ታናኬ» ጋዓኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዓኪ፥ ዓጬ ማዔ ቶኪ ዓኣ ሃኣኮ ሺርካ ዓንጎጉዲ ታ ኔና ማሃንዳኔ፤","poem":1},{"text":"ዹኮ ቢያ ኔኤኒ ሺርኪ ባይዛንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ጌሜሮዋ ሄርቂ ዳኣፂ ሲላሊ ኔ ማሃንዳኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኔኤኒ ዔያቶ ፒዺሳንዳኔ፤","poem":1},{"text":"ዢባራኣ ፒፂ ዔያቶ ዔኪ ዓኣዻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዓልጋሢ ዢባራ ዔያቶ ላኣላንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ጋዓንቴ ናንጊና ናንጋ ጎዳና ዎዛዻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒስራዔኤሌኮ ዱማዼሢ፥ ታና ጉሙርቂ ኔ ዖቶርቃንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«ማንቆንታ ሜታዼ ዓሶንታ ዋኣሢ ኮዓንዳኔ፥ ጋዓንቴ ዴንቃዓኬ፤","poem":1},{"text":"ቆርጫ ዔያቶኮ ዼኤቦና ፃኣዼኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ናንጊና ናንጋ ጎዳ ሺኢጲፆ ዔያቶሲ ዋይዛንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ዒስራዔኤሌኮ ፆኦዛሢ ፔቴታዖ ዔያቶ ሃሻዓኬ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ቦኦሬ ጌሜሮይዳፓ ዎርዚ ታ ዎይሳንዳኔ፤","poem":1},{"text":"ዶኦጫዻ ጊንፆይዳ ዋኣሢ ታ ዑራንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዳውላዻ ዓጫ ቦቆሊ ታ ዴይሣንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሳዖ ሜላ ዋኣሢ ዓልቃያ ማዓንዳኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሊባኖኦሴ ሚፆንታ ሻሮንታ","poem":1},{"text":"ባርሴኔቴ ጌይንታ ሚፆንታ ዛይቶ ሪሚቶንታ ዳውሎይዳ ታ ባቃልሳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዓሲ ናንጉዋ ዳውላ ዴኤሎ ዚቢቆንታ ዓስታ ጌይንታ ሚፆንታ","poem":2},{"lineBreak":true},{"text":"ሪሚቲንታ ዱማ ዱማ ሚሢ ኩሜ ዴኤሊ ታ ኬሳንዳኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዬያ ታኣኒ ማዻንዳሢ ታና ናንጊና ናንጋ ጎዳኮ ኩጫ ማዼያ ማዒፆ","poem":1},{"text":"ታኣኒ ዒስራዔኤሌኮ ዱማዼሢ ዬያ ማዤያ ማዒፆ","poem":2},{"lineBreak":true},{"text":"ቢያሢ ዛጊ