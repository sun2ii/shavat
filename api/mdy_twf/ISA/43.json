{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"ISA","translationId":"mdy_twf","name":"ዒሲያሴ ማፃኣፖ","commonName":"ዒሲያሴ ማፃኣፖ","title":"ዒሲያሴ ማፃኣፖ","order":23,"numberOfChapters":66,"sha256":"0585110711ab765bb8ad52ae6d6c3dab40fe368c20e71e6d5dd66f2fb946a5fd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mdy_twf/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":43,"content":[{"type":"heading","content":["ፆኦሲ ፔኤኮ ዴሮ ዓውሳኒ ዒንጌ ዎዞ"]},{"type":"verse","number":1,"content":[{"text":"ዒንሢ ያይቆኦቤ ናኣታ ዒስራዔኤሌ ዓሳ!","poem":1},{"text":"ዒንሢ ማዤ ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፤","poem":2},{"lineBreak":true},{"text":"«ታኣኒ ዓውሴያ ማዔሢሮ ዒጊጪፖቴ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢ ታኣሮኬ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢኮ ሱንፆና ታኣኒ ዒንሢ ዔኤሌኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዼኤፖ ዋኣፆና ዒንሢ ፒንቃ ዎዶና","poem":1},{"text":"ታኣኒ ዒንሢና ዎላ ማዓንዳኔ፤","poem":2},{"text":"ዬያ ዎሮና ዒንሢ ፒንቃ ዎዶና","poem":1},{"text":"ዬይ ዋኣፃ ዒንሢ ዔኤዻዓኬ፤","poem":2},{"lineBreak":true},{"text":"ታሞ ጊዴና ዒንሢ ዓኣዻ ዎዶና","poem":2},{"lineBreak":true},{"text":"ዒንሢ ሚቻዓኬ፥ ሌኤባኣ ዒንሢ ሼኤላዓኬ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢኬ፤","poem":1},{"text":"ዒስራዔኤሌኮ ዱማዼያ ማዔ፥ ዒንሢ ዼኤሻሢኬ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢ ዓውሳኒ ጊብፄንታ ዒቶጲያንታ ሳኣባ ዓጮዋ ታ ዒንሢም ዒንጌኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዒንሢ ታኣኮ ቦንቺንታያና ጴዹዋ ማዔ ሜሄኬ፤","poem":1},{"text":"ታኣኒ ዒንሢ ናሽካሢሮ ዒንሢ ሼምፓሢ ዓውሳኒ","poem":2},{"lineBreak":true},{"text":"ሜሌ ዴሮንታ ካኣቶንታ ሼምፓሢ","poem":2},{"lineBreak":true},{"text":"ዖኦካ ማሂ ዒንሢ ቤዛ ታኣኒ ዎዼኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ታኣኒ ዒንሢና ዎላታሢሮ ዒጊጪፖቴ፤","poem":1},{"text":"ዓባ ኬስካ ባንፆና ጌላ ባንፆናፓ ዒንሢንታ ዒንሢኮ ናኣቶንታ","poem":2},{"text":"ቡኩሲ ዔኪ ታ ሙካንዳኔ።»","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«ታኣኮ ዓቲንቆ ናኣታ ሃኬ ዓጪፓ ሙካንዳጉዲ","poem":1},{"lineBreak":true},{"text":"ዉዱሮ ናኣታኣ ዓጮኮ ጋፓፓ ዬዓንዳጉዲ","poem":1},{"text":"ኬዶ ባንፆና ዓኣ ዓጮ፦ ‹ዒንሢ ዔያቶ ሃሹዋቴ›","poem":2},{"lineBreak":true},{"text":"ዾኦሎ ባንፆ ዓጮዋ ‹ዒንሢ ዔያቶ ዓርቂፖቴ› ጌዒ ታ ዓይሣንዳኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዔያታ ታ ሱንፆና ዔኤሊንቴዞንሢና ታ ቦንቾም ታ ዔያቶ ማዤ","poem":1},{"text":"ታ ኩጮና ታኣኒ ኮሼዞንሢና ማዤ ዴሮ ‹ታኣም ሃኒ ባዑዋቴ› » ጋዓንዳኔ።","poem":2}]},{"type":"heading","content":["ዒስራዔኤሌ ዓሳ ፆኦሲኮ ማርካ ማዒፆ"]},{"type":"verse","number":8,"content":[{"text":"ፆኦሲ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ዓኣፒ ዓኣንቴ ዛጉዋ","poem":2},{"lineBreak":true},{"text":"ዋይዚ ዓኣንቴ ዋይዙዋ","poem":2},{"lineBreak":true},{"text":"ታ ዴሮ ዔኪ ኬሱዋቴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዴራ ቢያ ፔቴይዳ ቡኪንቶንጎ፤","poem":1},{"text":"ዔያቶ ባኣካፓ ሃኖ ዎዶንታ ሚና ቤርታኣ ባኮ","poem":2},{"lineBreak":true},{"text":"ቤርታዺ ኬኤዜያና ፔጋሲ ዔርዜያ ዖናዳይ?","poem":2},{"lineBreak":true},{"text":"ፂላኒ ማርካ ዔያታ ዔኪ ሙኮንጎ፤","poem":2},{"lineBreak":true},{"text":"ዓሳኣ ዬያ ዋይዚ ጎኔኬ ጎዖንጎ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«ታኣኒ ፆኦሲ ማዔሢ ዔሪ","poem":1},{"text":"ታና ዒንሢ ጉሙርቃንዳጉዲ","poem":2},{"lineBreak":true},{"text":"ታኣኒ ዶኦሬ፥ ማርኮ ማዔ ዓይላ ዒንሢኬ፤","poem":2},{"lineBreak":true},{"text":"ጎኔና ታ ጊዳፓ ዓታዛ ሜሌ ፆኦሲ ባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ሃያኮ ቤርታኣ ባኣሴ፤ ሴካ ቤርቲማኣ ናንጋዓኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«ታኣኒ ናንጊና ናንጋ ጎዳኬ፤","poem":1},{"text":"ታ ጊዳፓ ሜሌ ዒንሢ ዓውሳንዳይ ባኣሴ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታኣኒ ሴካ ቤርቲም ማዓንዳ ባኮ ቤርታሲ ኬኤዜኔ፤","poem":1},{"text":"ዒንሢ ዓውሴሢ ታናኬ፤","poem":2},{"lineBreak":true},{"text":"ሜሌ ፆኦዛፓ ፔቴይታዖ ዬያ ማዺባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ዬያ ቢያ ዛሎ ዒንሢ ታኣኮ ማርኮኬ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታኣኒ ሚናፓ ዓርቃዖ ታኣኒ ታናኬ፤","poem":1},{"text":"ታ ኩጫፓ ቶላኒ ዳንዳዓይ ዖኦኒያ ባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ማዻ ባኮ ዖኦኒ ታና ላኣጋኒ ዳንዳዓይ።»","poem":2}]},{"type":"heading","content":["ፆኦሲኮ ማኣሪፆንታ ዒስራዔኤሌ ዓሶኮዋ ጉሙርቂንቱዋያ ማዒፆ"]},{"type":"verse","number":14,"content":[{"text":"ዒንሢ ዓውሴ፥ ዒስራዔኤሌኮ ዱማዼ፥ ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ዒንሢሮ ጌዒ ታኣኒ ባብሎኔ ዓሶ ዖላንዳ ዓሲ ዳካንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ሄርሺንታ ዋኣፆ ካኣሚሎ ታ ዔያቶኮ ሜንሣንዳኔ፤","poem":2},{"text":"ሜሌ ዓጪ ዳውሲንቲ ዴንዴ ዓሲጉዲ ዔያታ ዻውሲንታንዳኔ።","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ታኣኒ ናንጊና ናንጋ ጎዳ ዒንሢኮ ዱማዼ ፆኦዛሢኬ፤","poem":1},{"text":"ዒስራዔኤሌ ዓሲዮቴ! ታኣኒ ዒንሢ ማዤኔ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢኮ ካኣታሢያ ታናኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ናንጊና ናንጋ ጎዳ ባዞ ሳዞይዳ ጎይሢ ኬሴኔ፤","poem":1},{"text":"ዋኣፆ ጉዳሢዳ ሃንቶንዶ ጎይሢ ኮሼኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሳርጌሎ ዖይቶንታ ፓራሢንታ","poem":1},{"lineBreak":true},{"text":"ዖሎ ዖላ ዓሶንታ ዖሎና ዔርቴ ዓሶንታ","poem":1},{"text":"ባይሲንታ ባንሢ ዒ ዔኪ ዓኣዼኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ሎኦሜኔ፥ ላሚ ዔቃዓኬ፤","poem":2},{"lineBreak":true},{"text":"ዑኡዞዛ ሃሃይቃ ፆምፔጉዲ ዔያታ ማዔኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ማዺንቲ ዓኣዼ ባኮ ጶቂሢፖቴ፤","poem":2},{"lineBreak":true},{"text":"ሃያኮ ቤርታ ማዔ ባኮዋ ማሊፖቴ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዬያ ሃሺጋፓ ታኣኒ ማዻ ዓኮ ባኮ ዛጉዋቴ፤","poem":1},{"text":"ዬይ ሃሢ ማዺንቲ ኩማንዳያ ማዔሢሮ ዒንሢ ዛጋንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዳውሎይዳ ጎይሢ ታ ኬሳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዓሲ ናንጉዋ ዳውላኣ ዋኣሢ ታ ዑራንዳኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ታኣኮ ዶኦሪንቴ ዴሮም ዋኣሢ ዒንጋኒ","poem":1},{"text":"ዳውሎይዳ ታኣኒ ዎርዚ","poem":2},{"text":"ዓሲ ናንጉዋ ዳውሎይዳ ዋኣሢ ታ ዑራኣና","poem":1},{"text":"ካዮ ቦዓኣ ዓቱዋዖ ታና ቦንቻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዉኡካሢንታ ሙኡታላኣ ታና ጋላታንዳኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዔያቶ ታኣኒ ታኣም ማዤ ታ ዴሬ ማዔሢሮ","poem":1},{"text":"ዔያታ ታና ጋላታንዳኔ።»","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ዒንሢ ያይቆኦቤ ናኣታ ዒስራዔኤሌ ዓሳ!","poem":2},{"lineBreak":true},{"text":"ዒንሢ ታና ካኣሽኪፆ ሃሼኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣም ማዺፆዋ ዒንሢ ላቤኔ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ሚቺ ዒንጎ ዒንጊፆ ማዓ ማራቶ ዒንሢ ታኣም ሺኢሺባኣሴ፤","poem":1},{"text":"ዒንጎ ባኮ ሺኢሺፆና ታና ዒንሢ ቦንቺባኣሴ፤","poem":2},{"text":"ዒንሢ ታኣም ዒንጎ ባኣዚ ሺኢሻንዳጉዲ ታ ዒንሢ ዖኦጪ","poem":1},{"text":"ባሲ ታኣኒ ዒንሢኮ ማዒባኣሴ፤","poem":2},{"lineBreak":true},{"text":"‹ዑንጆ ታኣም ጩቢሹዋቴ› ጌዒ ታ ዒንሢና ሜታሲባኣሴ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዒንሢኮ ሚኢሾና ሳውቃ ዑንጄ ዒንሢ ታኣም ሻንቂባኣሴ፤","poem":1},{"text":"ሃኣቦ ማሎ ሚቺ ዒንጊፆና ዒንሢ ታና ዎዛሲባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ጋዓንቴ ዒንሢኮ ጎሞ ሚርጉሞና ታኣኮ ዒንሢ ባሲ ማዔኔ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢኮ ዻቢንቶ ሚርጉሞና ታና ዒንሢ ሼናሴኔ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዬይ ቢያ ማዔንቴያ","poem":1},{"text":"ጎሞ ዒንሢኮ ዓቶም ጋዓ ፆኦሲ ታናኬ፤","poem":2},{"lineBreak":true},{"text":"ዬያ ታኣኒ ማዻሢ ዒንሢሮቱዋንቴ ታኣኒ ታና ማዔሢሮኬ፤","poem":2},{"lineBreak":true},{"text":"ጎሞ ታ ዒንሢኮ ዓርቃዓኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"«ሂንዳ ቤርታ ማዺንቴ ባኮ ታኣም ጶቂሡዋቴ፤","poem":1},{"text":"ጌኤዞ ዒንሢኮ ታና ዋይዚሲ ዒንሢ ፂሎ ማዒፆ ማርካሡዋቴ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዒንሢኮ ቤርታኣ ዓዳሢ ጎሜ ማዼኔ፤","poem":1},{"text":"ዒንሢኮ ዔርዛዞንሢያ ዻቢንቲ ማዺ ታና ዖዪሴኔ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ዬያሮ ዒንሢኮ ጌኤዦ ማኣሮ ሱኡጎ ታ ዻውሲሳንዳኔ፤","poem":1},{"text":"ያይቆኦቤ ባይቃንዳጉዲ፥ ዒስራዔኤሌያ ጋዳንቂንታንዳጉዲ ታ ማሃንዳኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":28}