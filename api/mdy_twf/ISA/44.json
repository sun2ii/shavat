{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"ISA","translationId":"mdy_twf","name":"ዒሲያሴ ማፃኣፖ","commonName":"ዒሲያሴ ማፃኣፖ","title":"ዒሲያሴ ማፃኣፖ","order":23,"numberOfChapters":66,"sha256":"0585110711ab765bb8ad52ae6d6c3dab40fe368c20e71e6d5dd66f2fb946a5fd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mdy_twf/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":44,"content":[{"type":"heading","content":["ፆኦሲጉዴ ሜሌ ፆኦሲ ባኣያ ማዒፆ"]},{"type":"verse","number":1,"content":[{"text":"ታ ዓይላሦ ያይቆኦቤ! «ታኣኒ ዶኦሬ ዒስራዔኤሌ ዋይዙዋቴ!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ኔና ማዤሢ፥ ዒንዶ ጎጶይዳኣ ኔና ሙሌሢ","poem":1},{"text":"ኔና ማኣዳሢ","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":2},{"lineBreak":true},{"text":"ታ ዓይላሦ ያይቆኦቤ! ታኣኒ ዶኦሬ ዒስራዔኤሌ! ዒጊጪፖ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«ሜሊ ፃኣዼ ዓጮም ዋኣሢ ታኣኒ ዒንጋንዳኔ፤","poem":1},{"text":"ዳውሎ ዓጮይዳ ዎርዚ ታ ጎዒሳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኮ ዓያኖ ኔኤኮ ናኣቶይዳ ታ ላኣላንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዓንጆዋ ኔኤኮ ናኣዚ ናኣቶም ታ ዒንጋንዳኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዔያታ ዋኣሢ ኮሺ ዑሽኬ ማኣቲጉዲ","poem":1},{"text":"ዓልቂ ዎታ ዋኣፆ ዓጫ ዓኣ ዓሃያ ሚፆጉዲ","poem":2},{"lineBreak":true},{"text":"ቢያ ዎዴና ዋርቄያ ማዓንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«ፔቴሢ፥ ‹ታኣኒ ናንጊና ናንጋ ጎዳሮኬ› ጋዓንዳኔ፤","poem":1},{"text":"ባጋሢ ሃሣ ‹ታኣኒ ያይቆኦቤ ሱንፆና ዔኤሊንቴኔ›","poem":2},{"lineBreak":true},{"text":"ዓቴሢ ሃሣ ‹ታኣኒ ናንጊና ናንጋ ጎዳ ዓሲኬ›","poem":2},{"lineBreak":true},{"text":"ጌዒ ፔ ኩጮ ዑፃ ኮንኮ ጫቶ ጎይሢ ጫታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒስራዔኤሌ ጌይንታ ሱንፆናኣ ዔኤሊንታኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ቢያ ባኮ ዎይሣ ጎዳ ማዔ","poem":1},{"text":"ዒስራዔኤሌ ካኣታሢና ዓውሳ ጎዳሢ ሂዚ ጋዓኔ፦","poem":2},{"lineBreak":true},{"text":"«ዓይፆና ጋፒንፃሢና ታናኬ፤","poem":2},{"lineBreak":true},{"text":"ታ ጊዳፓ ዓታዛ ሜሌ ፆኦሲ ባኣሴ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታጉዴያ ዖናዳይ?","poem":1},{"text":"ሂንዳ ዓኣቴ ኬኤዞንጎ፤","poem":2},{"lineBreak":true},{"text":"ሃንጎ ማርኮ ዔኪ ታ ቤርቶ ሺኢሾንጎ፤","poem":2},{"lineBreak":true},{"text":"ሃጊ ማዓንዳ ባኣዚ ቤርታዺ ኬኤዜይ ዖናዳይ?","poem":2},{"lineBreak":true},{"text":"ሂንዳ ሴካ ቤርቲም ማዓንዳ ባኮ ኬኤዞንጎ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዒንሢ ዒጊጪፖቴ፥ ዲቃቲፖቴ፤","poem":1},{"text":"ሚናኣ ዎዳፓ ዓርቃዖ ቤርታዺ ታኣኒ ዒንሢም ኬኤዚባኣዓዳ?","poem":2},{"lineBreak":true},{"text":"ዬያኮ ዒንሢ ታኣኮ ማርካኬ፤","poem":2},{"lineBreak":true},{"text":"ታ ጊዳፓ ሜሌ ፆኦሲ ዓኣ?","poem":2},{"lineBreak":true},{"text":"ታኣፓ ሜሌ ዶዲ ላሌ ባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ዖናኣ ታኣኒ ዔሩዋሴ።»","poem":2}]},{"type":"heading","content":["ሜሌ ፆኦዛ ፓሡዋያ ማዒፆ"]},{"type":"verse","number":9,"content":["ሜሌ ፆኦዞ ካኣሽካ ዓሳ ጉሪኬ፤ ዼኤፒኬ ጌዒ ካኣሽኮ ሜሌ ፆኦዛ ዔኤቢ ፓሡዋያኬ፤ ዬያቶ ዛሎ ኬኤዛ ዓሳ ዓኣፒ ባይቄያኬ፤ ዬያ ማዾና ቦርሲንቲ ዔያቶም ማዓንዳኔ።"]},{"type":"verse","number":10,"content":["ዔኤቢ ፓሡዋ ባኮ ፆኦሲ ጌዒ ቆኦቂ ኮሺ ካኣሽካሢ ዎይቴ ዓሲዳይ?"]},{"type":"verse","number":11,"content":["ዬያቶ ካኣሽካ ዓሳ ቢያ ቦርሲንታንዳኔ፤ ካኣሽኮ ሜሌ ፆኦዞ ኮሻሢ ዓሲዳፓ ዓቴም ሜሌቱዋሴ፤ ቢያሢ ቡኪንቲ ታ ቤርታ ዔቆንጎ፤ ዬያይዴቴ ቢያሢ ዒጊቹሞና ካራ ባይቃንዳኔ፥ ቦርሲንቲያ ቦርሲንታንዳኔ።"]},{"type":"verse","number":12,"content":["ዓንጎ ሼኤሻሢ ሜሌ ካኣሽኮ ፆኦዞ ኮሻኒ ዓንጊ ዔኪ ዹይ ታሚና ሼኤሻኔ። ዬያ ዓንጎ ፔቴ ባኣዚ ማሃኒ ፔኤኮ ዶዶ ዎልቆና ሞቶሾ ዓርቂ ዹዓኔ፤ ዬያ ዒዚ ዹዓ ዎዶና ዒዛ ዼኤባኔ፥ ናይዺያ ናይዻኔ፥ ጊንሣ ላቢሳኔ።"]},{"type":"verse","number":13,"content":["ሚፆ ዓርሳ ሃኣማ ቤርታ ሚፆ ዎዳራና ሚፃኔ፥ ማላታኣ ሃኣዚ ኮሻኔ፥ ዡኡዳ ባኣዚና ዡኡዲ ሃሊፂሳኔ፥ ፒዜ ማዒፆ ዔራኒ ዓንጊና ሚፂ ዛጋኔ፤ ዬካፓ ዓሲ ማላያ ማሂ ሚዛጲሲ ኮሺ፥ ፆኦዞ ካኣዦ ማኣራ ጌሣኔ።"]},{"type":"verse","number":14,"content":["ዬያ ማዻኒ ሊባኖኦሴ ሚፆ ሃንጎ ዴኤሎ ዚቢቆ፥ ዓቴቴ ሻኣቢ ካያፓ ዶኦሪ ዔካኔ፤ ዬይ ማዒባኣቴ ሃኣሚ ጊኢጊሺ ቱኬም ዒርዚ ዋርቃዛ ዑጋ ኮምቤሌ ጌይንታ ሚፆ ካያ ቱካኔ።"]},{"type":"verse","number":15,"content":["ዓሲ ፔቴ ሚሢዳፓ ዛሎ ሃንፂሌ፥ ዛሎ ሜሌ ዖኦሲ ማሂ ኮሻኔ፤ ዛሎ ዔኤሢ ካሽታኒና ዔኤቢ ካሦ ሃንፂሌ ማሃኔ፤ ዓቴ ዱንጮ ፆኦሲ ማሂ ኮሺ ዬያኮ ቤርታ ዚጋኔ።"]},{"type":"verse","number":16,"content":["ዛሎ ዔኤሢ ካሣ ካሣኔ፤ ዓሽኪያ ሚቺ ሚሽካንዳያ ሄላንዳኣና ሙዓኔ፤ ካሽቴሢዳፓ «ታሚቱዋዓ! ዎዚ ዖይዻይ?» ጋዓኔ።"]},{"type":"verse","number":17,"content":["ዓቴ ዱንጮ ሜሌ ፆኦዞ ማሂ ኮሻዖ ዬያኮ ቤርታ ባሊቲና ሎኦሚ ዚጊ ካኣሽካኔ፤ «ኔኤኒ ታኣኮ ፆኦዛሢኬ፤ ታና ዓውሴ!» ጌዒ ጌዒ ዬያ ሺኢቃኔ።"]},{"type":"verse","number":18,"content":["ዬያጉዴ ዓሳ ፔቴታዖ ዔራ ባኣዚ ባኣሴ፤ ዔያታ ዛጉዋጉዲ ዓኣፓ ዔያቶኮ ዱኡሚንቴኔ፤ ማሊ ጶቂሡዋጉዲ ዒና ዔያቶኮ ዹሜኔ።"]},{"type":"verse","number":19,"content":["«ሃያ ሚፆኮ ዛሎ ታኣኒ ዔኤሤኔ፤ ቄንፆና ካሣ ታ ካሤኔ፤ ዓሽኪያ ታ ሚቺ ሙዔኔ፤ ዓካሪ ዓቴ ቲቂንቴ ሚፆ ካኣሽኮ ፆኦሲ ማሆንዶ? ዬያኮ ቤርታ ሎኦሚ ዚጎንዶ?» ጌዒ ማላንዳጉዲ ዔራቶንታ ማሊ ጶቂሥሢንታ ዓኣ ዓሲ ፔቴታዖ ባኣሴ።"]},{"type":"verse","number":20,"content":["ዔኤቲ ዲቢንሢ ማዓ ሚሢ ካኣሽኮንዶያ ሄላንዳኣና ዓሲ ዎይቲ ዔኤያ ማዓይ? ዒዛኮ ዔኤያቶ ማሊፃ ዒዛ ዻቢሼኔ፤ ፔናኣ ዓውሳኒ ዒ ዳንዳዑዋሴ፤ ጊንሣ «ሃይ ታኣኮ ሚዛቆ ኩጫ ዓኣ ባካ ሜሌ ፆኦዞ ማዓንዳኣፓዓቴም ጎኔ ፆኦሲቱዋኣሴ» ጋዓኒ ዳንዳዑዋሴ።"]},{"type":"heading","content":["ናንጊና ናንጋ ጎዳ ቢያ ባኮ ማዤሢና ዓውሳሢያ ማዒፆ"]},{"type":"verse","number":21,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ዒስራዔኤሌ! ኔኤኒ ታ ዓይሌኬ፤","poem":2},{"lineBreak":true},{"text":"ያይቆኦቤ! ዬያ ማሊ ጶቂሤ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ኔና ማዤኔ፥ ኔ ታ ዓይሌኬ፤","poem":2},{"lineBreak":true},{"text":"ዒስራዔኤሌ! ታ ኔና ዋላዓኬ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዻቢንቶ ኔኤኮ ሻኣሬጉዲ፥ ጎሞ ኔኤኮ ጉታኣ ቃኣዮጉዲ ታኣኒ ዔቂሲ ዳኬኔ፤","poem":1},{"text":"ታኣኒ ኔና ዓውሴሢሮ ኔኤኒ ታ ባንሢ ማዔ።»","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ጫሪንቺዮቴ!","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ያይቆኦቤ ዓውሴኔ፤","poem":2},{"lineBreak":true},{"text":"ዒስራዔኤሌይዳ ፔ ቦንቾ ፔጋሲ ዻዌኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያሮ ዎዛና ፆኦሲ ቦንቾም ማዓ ዓይኑሞ ዓይናዹዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዴማ ዓኣ ሳዔሌ ዒላሼ፤","poem":2},{"text":"ዹኮንታ ካዮንታ ዒኢካ ዓኣ ሚፃ ቢያ","poem":1},{"text":"ዎዛ ዑኡሲ ዋይዚሲ ዋይዚሲ ጱሉዋቴ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ኔኤኮ ዒንዶ ጎጳ ኔና ማዤ ዓውሳሢ","poem":1},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ታኣኒ ቢያ ባኮ ማዤ፥ ጫሪንጮዋ ታኣሮ ሌሊ ሚጬሢ","poem":2},{"lineBreak":true},{"text":"ሳዖዋ ታኣሮ ሌሊ ሂኢሤሢ ታኣኒ ናንጊና ናንጋ ጎዳኬ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ሉኡዙሞና ፆኦሲ ማሊፆ ኬኤዛዞንሢኮ ማላቶ","poem":1},{"text":"ማርሾ ማርሻ ዓሶኮዋ ዦዋቶ ጉሪ ታ ማሃንዳኔ።","poem":2},{"lineBreak":true},{"text":"ዔሮ ዓሶኮ ዔራቶ ታኣኒ ሺርሻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶኮ ዔራቶ ታኣኒ ዔኤያቶ ማሃንዳኔ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ታኣኮ ማዻ ዓሶኮ ኪኢቶ ታ ዶዲሻንዳኔ፤","poem":1},{"text":"ታ ማሊፆ ኬኤዛ ዓሶ ሎንሦ ታ ኩንሣንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ፦ ‹ዬሩሳላሜ ሚርጌ ዴሬኮ ናንጊ ቤሲ ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዪሁዳይዳ ዓኣ ካታማ ጊንሣ ማዢንታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዶዔ ካታማኣ ጊንሣ ዓካዻንዳኔ› ጋዓንዳኔ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዼኤፖ ባዞም፦ ‹ታኣኒ ዋኣፆ ኔኤኮ ሚጪሳንዳሢሮ","poem":1},{"text":"ኔኤኒ ሃይቄ› ታ ጋዓንዳኔ፤","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ቂኢሮሴም፦ ‹ኔኤኒ ታኣኮ ቆልሞ ሄንቃሢኬ፤","poem":1},{"text":"ታኣኮ ማሊፆ ቢያ ኔኤኒ ማዺ ኩንሣንዳኔ›","poem":2},{"lineBreak":true},{"text":"ዬሩሳላሜም፦ ‹ኔኤኒ ጊንሣ ኬልቂ ማዢንታንዳኔ›","poem":2},{"lineBreak":true},{"text":"ጌኤዦ ማኣሮኮዋ፦ ‹ዓይፆ ሹጫ ጌሢንቶንጎ› ታ ጋዓንዳኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/ISA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/ISA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/ISA/43.json","previousChapterAudioLinks":{},"numberOfVerses":28}