{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"ISA","translationId":"mdy_twf","name":"ዒሲያሴ ማፃኣፖ","commonName":"ዒሲያሴ ማፃኣፖ","title":"ዒሲያሴ ማፃኣፖ","order":23,"numberOfChapters":66,"sha256":"0585110711ab765bb8ad52ae6d6c3dab40fe368c20e71e6d5dd66f2fb946a5fd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mdy_twf/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":45,"content":[{"type":"heading","content":["ናንጊና ናንጋ ጎዳ ቂኢሮሴ ካኣቱሞም ዶኦሜሢ"]},{"type":"verse","number":1,"content":[{"text":"ዴራ ዒዛ ቢታንቶ ዴማ ማዒ ዎርቃንዳጉዲ","poem":1},{"text":"ካኣቶ ቢታንታፓ ኬይሳንዳጉዲ","poem":2},{"lineBreak":true},{"text":"ካታሞኮዋ ጌሎ ዲሮ ካሮ ዒዛም ቡላኒ","poem":2},{"lineBreak":true},{"text":"ሚዛቆ ኩጮ ዓርቂ ዶኦሚ ዒ ካኣታሤ ካኣቲ ቂኢሮሴም","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":2}]},{"type":"verse","number":2,"content":[{"text":"«ታኣኒ ኔኤኮ ቤርታ ዓኣዻንዳኔ፤","poem":1},{"text":"ዹኮ ታኣኒ ኔኤም ሂርኪዲ ባኣሳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሞኦኖ ዓንጎና ኮሾና ካሮንታ ዓንጎ ጋጋርዞዋ ታኣኒ ሜንሣንዳኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጴዹዋ ዓኣሺንቴ ቤዛ ቡኪንቴ ቆሎ ታ ኔኤም ዒንጋንዳኔ፤","poem":1},{"text":"ዬያሮ ኔኤኮ ሱንፆና ኔና ዔኤላ ዒስራዔኤሌ ፆኦዛሢ","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ታናታሢ ኔኤኒ ዔራንዳኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታ ዓይላሢ ያይቆኦቤሮ ጌዒ","poem":1},{"text":"ታኣኒ ዶኦሬ ዒስራዔኤሌሮ ጌዒ","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ታና ዔሩዋያታቴያ ኔ ሱንፆና ታ ኔና ዔኤሌኔ፤","poem":2},{"lineBreak":true},{"text":"ቦንቺንቲ ሱንሢያ ታ ኔኤም ጌሤኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ታኣኒ ናንጊና ናንጋ ጎዳኬ፤ ታ ጊዳፓ ዓታዛ ሜሌ ፆኦሲ ባኣሴ፤","poem":1},{"text":"ኔኤኒ ታና ዔሩዋያ ማዔያታቴያ ዶዱሞ ታ ኔኤም ዒንጋንዳኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዬያ ታኣኒ ማዻሢ ዓጫ ጉቤ","poem":1},{"text":"ታኣኒ ሌሊ ናንጊና ናንጋ ጎዳ ማዔሢ","poem":2},{"text":"ታ ጊዳፓዓቴም ሜሌ ፆኦሲያ ባኣሢ ዔራንዳጉዲኬ።","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ፖዖ ታኣኒ ማዤኔ፥ ዹሞዋ ታ ማዤኔ፤","poem":1},{"text":"ዓንጆንታ ባይሲንታንታ ታ ዔኪ ሙካኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ናንጊና ናንጋ ጎዳ ዬያ ቢያ ማዻኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዒንሢ ሎ ዓኣ ጫሪንጫ! ፂሉሞ ዒርዚጉዲ ሎኦፓ ዋርቁዋቴ፤","poem":1},{"text":"ዒንሢ ሻኣራ ሊካ ፆዺሡዋቴ፤","poem":2},{"lineBreak":true},{"text":"ሳዔላ ቡሊንቶንጎ፥ ኮሹሞዋ ኬስኮንጎ፤","poem":2},{"text":"ታኣኒ ናንጊና ናንጋ ጎዳ ዬያ ማዤያታሢሮ","poem":1},{"text":"ፂሉሞዋ ዬያና ዎላ ዲጮንጎ።»","poem":2}]},{"type":"heading","content":["ናንጊና ናንጋ ጎዳኮ ዼኤፖ ዎልቆ"]},{"type":"verse","number":9,"content":[{"text":"ማዤሢና ዎላ ማርማሢም ባዴዔ!","poem":1},{"text":"ዒዚ ዓጪና ማዢንቴ ሜሆይዳፓ ፔቴሢኬ፤","poem":2},{"text":"ፔቴ ዓጪና ማዦና ሜሄ ማዤሢ ኮራ፦","poem":1},{"text":"«ሃይ ኔኤኒ ዎዎዳይ?","poem":2},{"lineBreak":true},{"text":"ኩጫ ዓርቃ ኬሌጫ ዎካዳይ?» ጌይ ዖኦጫኒ ዳንዳዓ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ናይ ሾዔ ዓዶ ኮራ፦","poem":1},{"text":"«ኔኤኒ ታና ዓይጋ ሾዔይ?»","poem":2},{"lineBreak":true},{"text":"ፔኤኮ ዒንዶ ኮራኣ «ዓይጋ ኔ ታና ሃያይዲ ሾዔይ?» ጋዓሢም ባዴዔ!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ቢያ ባኮ ማዤ ናንጊና ናንጋ ጎዳሢ","poem":1},{"text":"ዒስራዔኤሌኮ ዱማዼ ፆኦዛሢ","poem":2},{"text":"ሃጊ ማዓንዳ ባኮ ዛሎ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ታኣኮ ናኣቶ ዛሎ ዒንሢ ታና ዖኦጫኒና","poem":2},{"lineBreak":true},{"text":"ታ ኩጫ ማዻሢኮ ታኣኒ ዓይጎ ማዻንዳያ ኮይሳያታቴያ","poem":2},{"lineBreak":true},{"text":"ዒንሢ ታና ዓይሣኒ ኮዓ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሳዖ ማዤሢንታ","poem":1},{"text":"ዓሲያ ማዢ ዒዞይዳ ናንጋንዳጉዲ ማሄሢ ታናኬ፤","poem":2},{"lineBreak":true},{"text":"ጫሪንጮ ታኣኮ ዎልቆና ዳሬሢ","poem":2},{"lineBreak":true},{"text":"ዒኢካ ዓኣ ማዢንቶዋ ዛጊ ዎይሣሢ ታናኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ቢያ ባኮ ዎይሣ ጎዳሢ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ቂኢሮሴ ፂሉሞ ማዾ ማዻንዳጉዲ ታ ዔቂሴኔ፤","poem":2},{"lineBreak":true},{"text":"ጎይፆዋ ታ ዒዛም ጊኢጊሻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ታ ካታሜሎ ዬሩሳላሜ ጊንሣ ዒዚ ኮሻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዳኪንቴ ቤዛ ዓኣ ታኣኮ ዴሮ ዓይላታፓ ዒዚ ኬሳንዳኔ፤","poem":2},{"text":"ዬያ ዒዚ ማዻንዳሢ ዖኦኒያ ሚኢሼ ጪጋንዳጉዲና","poem":1},{"text":"ማዼ ባኮ ዛሎዋ ዔኤቢ ዒዛም ማሃንዳጉዲቱዋሴ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ጊብፄ ዓጮ ቆሎና ዒቶጲያ ዓጮኮ ኮርሞ ባካ","poem":2},{"lineBreak":true},{"text":"ኔኤም ዓኣሢንቲ ዒንጊንታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔጳ ዖዶሲ ማዔ ሳኣባ ዓሳ","poem":2},{"lineBreak":true},{"text":"ካኒ ቢራታና ቱኡቲ ኔ ጊንፆ ሙካንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ሂርኪ ጌዒ ዚጊያ፦ ‹ፆኦሲ ዓኣሢ ኔ ኮራ ሌሊኬ፤","poem":2},{"lineBreak":true},{"text":"ሜሌ ዓንካኣ ባኣሴ፥ ዒዛይዳፓ ዓታዛ ሜሌ ፆኦሲ ባኣሴ› ጋዓንዳኔ።»","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዓውሳ ዒስራዔኤሌ ፆኦዛሢዮ!","poem":1},{"text":"ኔ ማዻ ዓሲም ዔርቱዋያ ዓኣሺንቴያኬ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሜሌ ፆኦዞ ካኣሽካ ዓሳ ቢያ ቦርሲንታንዳኔ፤","poem":1},{"text":"ዻውሲንታንዳኔ፥ ቢያሢ ቶኦኪ ባይቃንዳኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዒንሢ ዒስራዔኤሌ ዴራ ጋዓንቴ","poem":1},{"text":"ናንጊና ናንጋ ጎዳፓ ጴዻ ናኣናና ናንጋ ዻቂንቶና ዻቃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ቦርሲንቲንታ ዻውሲንቲያ ፔቴታዖ ዒንሢ ሄላዓኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ጫሪንጮ ማዤ፥ ናንጊና ናንጋ ጎዳሢ","poem":1},{"text":"ሳዖ ማዤሢንታ ዶዲሼሢ","poem":2},{"text":"ዓሲ ናንጋ ቤሲ ማዓንዳኣፓዓቴም","poem":1},{"text":"ኮሽኩዋያና ጉሪ ማዓንዳጉዲ ማዢባኣሢ","poem":2},{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ታኣኒ ናንጊና ናንጋ ጎዳኬ፤ ታ ጊዳፓ ዓታዛ ሜሌ ባኣሴ።»","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዹሚ ማዔ ዓጪዳ ዓኣቺ ታኣኒ ኬኤዚባኣሴ፤","poem":1},{"text":"ያይቆኦቤ ናኣቶም «ጉሪ ታና ኮዑዋቴ» ታ ጌዒባኣሴ፤","poem":2},{"text":"ታኣኒ ናንጊና ናንጋ ጎዳ ፂሎ ማዔ ባኣዚና","poem":1},{"text":"ፒዜ ማዔ ባኣዚ ኬኤዛኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«ዒንሢ ሜሌ ዓጮ ዳኪንቴ ቤዛፓ ፒኢጫዺ ዓቴ ዓሳ","poem":1},{"text":"ፔቱሞና ቡኪንቲ ሺኢኩዋቴ!","poem":2},{"lineBreak":true},{"text":"ኩቻ ማዢንቴ ሜሌ ፆኦዞ ኬዲ ሃንታዞንሢና","poem":2},{"lineBreak":true},{"text":"ዓውሳኒ ዳንዳዑዋ ፆኦዞ ሺኢቃዞንሢኮ ዔራቶ ባኣያኬ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሂንዳ ሃኒ ሺኢኪ ኬኤዞንጎ፤","poem":1},{"text":"ፔቴይዳ ቡኪ ዞርቶንጎ፤","poem":2},{"text":"ሚርጌ ዎዶኮ ቤርታ ሃያ ፔጋሲ ዻዌያና ኬኤዜይ ዖናዳይ?","poem":1},{"text":"ዬያ ፔጋሲ ዻዌሢንታ ኬኤዜሢ ታናቱዋዓዳ?","poem":2},{"lineBreak":true},{"text":"ታ ጊዳፓ ዓታዛ ሜሌ ዖኦኒያ ባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ታ ጊዳፓ ዓታዛ ሜሌ ፆኦሲ ባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ፂሎ፥ ሃሣ ዓውሳ ፆኦሲኬ። »","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«ታ ጊዳፓ ዓታዛ ሜሌ ፆኦሲ ባኣሢሮ","poem":1},{"text":"ዴንዲ ሳዖኮ ጋፖ ሄላንዳኣና ዓኣ ዓሳ ቢያ","poem":2},{"lineBreak":true},{"text":"ታ ባንሢ ማዒጋፓ ዻቁዋቴ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"‹ጉኡሺ ቢያ ታ ቤርታ ጉምዓታንዳኔ፤","poem":1},{"text":"ዒንዲርሲ ቢያ ታ ሱንፆና ጫኣቃንዳኔ›","poem":2},{"lineBreak":true},{"text":"ጌዒ ታ ሱንፆ ጌፒ ታ ጫኣቄኔ፤","poem":2},{"lineBreak":true},{"text":"ጊንሢም ማዑዋ ቃኣላ ታ ዻንጋፓ ፂሉሞና ኬስኬኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"«ፂሉሞና ዎልቄ ጴዻሢ ፆኦሲዳፓ ሌሊኬ","poem":1},{"lineBreak":true},{"text":"ጌዒ ታ ዛሎ ዔያታ ኬኤዛንዳኔ፤","poem":1},{"text":"ታና ዒፃ ዓሳ ቢያ ቦርሲንታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ታ ባንሢያ ዔያታ ሙካንዳኔ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ጋዓንቴ ዒስራዔኤሌ ናኣታ ቢያ","poem":1},{"text":"ታና ናንጊና ናንጋ ጎዳና ቦንቺንቲንታ ፂሉሞዋ ዴንቃንዳኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}