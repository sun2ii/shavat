{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"ISA","translationId":"mdy_twf","name":"ዒሲያሴ ማፃኣፖ","commonName":"ዒሲያሴ ማፃኣፖ","title":"ዒሲያሴ ማፃኣፖ","order":23,"numberOfChapters":66,"sha256":"0585110711ab765bb8ad52ae6d6c3dab40fe368c20e71e6d5dd66f2fb946a5fd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mdy_twf/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":46,"content":[{"type":"heading","content":["ባብሎኔ ዓጮይዳ ካኣሽኪንታ ሜሌ ፆኦዞ"]},{"type":"verse","number":1,"content":[{"text":"«ቤኤሌና ኔኤቦ ጌይንታ ፆኦዛ ዻውሲንቴኔ፤","poem":1},{"text":"ዬይ ፆኦዛ ቆልሞና ጫኣኒንቴኔ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢ ኬዲ ሃንታ ማላታ ላቤ ቆልሞም ዴኤፃያኬ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጫኣኖ ጫኣና ቆልማ ዴኤሡማፓ ዔቄያና ጉኡሺና ጉምዓቴኔ፤","poem":1},{"lineBreak":true},{"text":"ዬያ ጫኣኒንቴ ባኮ ዓውሳኒ ዳንዳዒባኣሴ፤","poem":1},{"text":"ዬይ ፆኦዛ ጋዓንቴ ፔናታዖ ዓውሳኒ ዳንዳዒባኣሢሮ ዲዒንቲ ዔውቴኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«ዒንዶ ጎጳፓ ዓርቂ ታኣኒ ካፔ፥ ሾይንቶይዳፓ ዓርቃዖ ታ ማኣዴ ያይቆኦቤ ናኣቶ ማዔ ዒስራዔኤሌኮ ፒኢጫዺ ዓቴዞንሦ! ዋይዙዋቴ።","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ዒንሢ ጋርቺ ቡኡቃንዳያ ሄላንዳኣና ካፓሢ ታናኬ፤","poem":1},{"text":"ታኣኒ ዒንሢ ማዤኔ፥ ታ ዒንሢ ኬዳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ታ ማኣዳንዳኔ፥ ፑርታ ባኣዚዳፓኣ ታ ካፓንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«ዒንሢ ታና ዖኦና ዎላ ቤኤዛንዳይ?","poem":1},{"text":"ዖኦና ዎላ ዒንሢ ታና ሄካሳንዳይ?","poem":2},{"lineBreak":true},{"text":"ዖና ማሊሲ ዖኦና ዎላ ታና ዒንሢ ቤኤዛንዳይ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ፔቴ ፔቴ ዓሳ ቡራሾ ፔኤሲ ቡሊ","poem":1},{"text":"ዔያቶኮ ዒና ጌዔሢጉዴያ ዎርቄ ኬሳኔ፤","poem":2},{"lineBreak":true},{"text":"ፔኤኮ ቢሮዋ ዴኤሡሞ ዔሮ ባኮና ዛጋኔ፤","poem":2},{"lineBreak":true},{"text":"ፆኦዞ ማሂ ዔያቶም ኮሻንዳጉዲ ዓንጎ ሼኤሻሢም ጪጋኒ ጌስታኔ፤","poem":2},{"lineBreak":true},{"text":"ዬይ ኮሺንቴሢዳፓ ዚጊ ዚጊ ዔያታ ካኣሽካኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዬያ ዔያታ ዔኪ ፔኤኮ ጌኤታ ኬዳኔ፤","poem":1},{"text":"ፔቴ ቤስካ ጌሦዛ ዒማካ ዔቂ ዓታኔ፤","poem":2},{"lineBreak":true},{"text":"ዬይ ዓኣ ቤዛፓ ዓጊፃኒ ዳንዳዑዋሴ፤","poem":2},{"lineBreak":true},{"text":"ዓይጎ ዓሲ ዬያ ሺኢቄታቴያ ማሂ ኬኤዙዋሴ፤","poem":2},{"lineBreak":true},{"text":"ዓይጎ ዓሲያ ባይሲንታፓ ዓውሳኒ ዬይ ዳንዳዑዋሴ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«ዒንሢ ዻቢንታ ዓሳ! ዬያ ማሊ ዒና ዓርቁዋቴ፤","poem":1},{"text":"ዒንሢኮ ዒናፓ ባይዚፖቴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታኣኒ ሌሊ ፆኦሲ ማዔሢ","poem":1},{"text":"ታጊዳፓ ዓቴም ሜሌ ፆኦሲ ባኣሢ","poem":2},{"text":"ዒንሢ ዔሩዋቴ፤","poem":1},{"text":"ሚናኣ ዎዶና ማዺንቴ ቤርታኣ ባኮ ማሊ ጶቂሡዋቴ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ፆኦሲኬ፤ ታጉዴያ ሜሌ ባኣሴ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጋፒንፃ ማዓንዳ ባኮ ቤርታሲ ታኣኒ ኬኤዜያኬ፤","poem":1},{"text":"ሴካ ቤርቲም ዓይጌ ማዓንዳቴያ ዓይፃ ታኣኒ ዔርዜያኬ፤","poem":2},{"lineBreak":true},{"text":"ማሊፃ ታኣኮ ዶዴያ ማዓንዳኔ፤ ታ ሼኔ ጌዔ ባኣዚያ ማዻንዳኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዓባ ኬስካ ባንፃፓ ኪላንቄጉዲ","poem":1},{"text":"ዓርቂ ዔካያ ማዔ ዓሲ","poem":2},{"text":"ታኣኒ ዔኤላንዳኔ፤","poem":1},{"text":"ዒዚያ ታኣኮ ማሊፆ ኩንሣኒ ሃኬ ዓጪዳፓ ሙካያኬ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ኬኤዜ ባኮ ማዻንዳኔ፤ ማሊ ቱኬ ባኮዋ ማዺ ኩንሣንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«ዒንሢ ፂሉሞፓ ሃኬ","poem":1},{"text":"ባቃኖ ዴይሤ ዓሳ ዋይዙዋቴ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታኣኮ ፂሉሞ ታ ዔኪ ሙኪ ሙኪኬ፤","poem":1},{"text":"ዬይ ሃካያቱዋሴ፤","poem":2},{"lineBreak":true},{"text":"ዓውሲፃ ታኣኮ ኔጋዓኬ፤","poem":2},{"lineBreak":true},{"text":"ፂዮኔም ዻቂንታ፥ ዒስራዔኤሌማኣ ቦንቾ ታ ዒንጋንዳኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/ISA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}