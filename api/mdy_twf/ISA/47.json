{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"ISA","translationId":"mdy_twf","name":"ዒሲያሴ ማፃኣፖ","commonName":"ዒሲያሴ ማፃኣፖ","title":"ዒሲያሴ ማፃኣፖ","order":23,"numberOfChapters":66,"sha256":"0585110711ab765bb8ad52ae6d6c3dab40fe368c20e71e6d5dd66f2fb946a5fd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mdy_twf/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":47,"content":[{"type":"heading","content":["ባብሎኔ ዓጫ ሎኦማንዳያ ማዒፆ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ሃና ኔ ባብሎኔኮ ኩሙፆ ዉዱሮ ናዔሌ!","poem":2},{"lineBreak":true},{"text":"ኬዲ ሲላላ ዴዔ፤","poem":2},{"lineBreak":true},{"text":"ካኣቱሞ ሻኣሎይዳቱዋንቴ ኬዲ ሳዓ ዴዔ፤","poem":2},{"lineBreak":true},{"text":"ሃካፓ ሴካ ሚዛጲ፥ ሃሣ ሃጊ ዔቃዞ ጌይንቲፃ ኔኤኮ ዓታንዳኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዓካሪ ዎንሢ ዔኪጋፓ ሃኣኮ ዎዼ፤","poem":1},{"text":"ኔኤኮ ቶኦኮ ዖሾሢ ቡሌ፥ ዖዶዞ ማኣዓሢያ ኔኤኮ ኬሴ፤","poem":2},{"lineBreak":true},{"text":"ሺንቺኖ ኔኤኮ ቃኣሪጋፓ ሙርታሢ ጴዺሲ ዎሮና ፒንቄ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዴራ ቢያ ኔኤኮ ካሉሞ ዛጋንዳኔ፤","poem":1},{"text":"ፆኦዛ ማዤ ዑፃ ኔኤኮ ጴዻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ዖናኣ ቲኢሩዋዖ ኮሞ ዔካንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ኑና ዓውሳሢ ዒስራዔኤሌኮ ዱማዼሢኬ፤","poem":1},{"text":"ሱንፃ ዒዛኮ ቢያ ባኮ ዎይሣ ጎዳኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«ዔና ባብሎኔኮ ዉዱሮ ናዔሌ! ዹሞ ጌሊጋፓ ዚቲዮ ጌዒ ዴዔ፤","poem":1},{"text":"ሃካፓ ሴካ፦ ‹ካኣቶኮ ጌኤሾ› ጌዒ ኔ ዔኤሊንታዓኬ፤","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታኣኒ ታኣኮ ዴሮ ዑፃ ዻጋዼኔ፤","poem":1},{"text":"ዔያቶዋ ታኣኒ ዓዳ ዒኢቴ ባኣዚጉዲ ፓይዲ","poem":2},{"text":"ኔኤም ዓኣሢ ታ ዒንጌኔ፤","poem":1},{"text":"ኔኤኒ ጋዓንቴ ዔያቶ ሚጪንቲባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ጋርቼ ዓሶ ዑፃታዖ ኔኤኮ ሄርቂ ዎይሢፆ ቃንባሮ ኔ ዴኤፂሴኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"‹ታኣኒ ናንጊና ጌኤሾ ማዒ ናንጋንዳኔ› ኔኤኒ ጌዔኔ፤","poem":1},{"text":"ኔኤኒ ማዼ ማዾሮ ዓይጎዋ ኔ ማሊባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ኔ ማዾኮ ዓኣፓ ዓይጎ ማዓንዳቴያ ማሊ ኔ ጶቂሢባኣሴ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«ኔኤኒ ዔኤቢ ኔኤም ጊኢጌም ሌሊ ናንጋኒ ኮዓዜ፥","poem":1},{"lineBreak":true},{"text":"ኔና ኔ ጉሙርቂ፥ ኔ ዒኖና፦ ‹ታጉዴያ ዖኦኒያ ባኣሴ፤","poem":1},{"text":"ዜኤሪንዶጉዲ ማዒ ታ ናንጋዓኬ፤","poem":2},{"text":"ናይ ታኣኮ ሃይቃዓኬ› ጋዓዜሌ","poem":1},{"text":"ሃያ ዋይዜ!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዎዚ ኔኤኮ ማርሻ ዼኤፒ፥ ዦዋታኣ ሚርጌ ማዔታቴያ","poem":1},{"text":"ዬንሢ ላምዖ ባኮንሢ፥ ናይ ሃይቄያ ማዒሢና","poem":2},{"lineBreak":true},{"text":"ዜኤሪንዶ ማዒሢ ፔቴ ኬሊዳ ዔርቲባኣንቴ ኔና ሄላንዳኔ፤»","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«ኔኤኮ ፑርቱሞና ኔኤኒ ዖቶርቂ","poem":1},{"text":"‹ዖኦኒያ ታና ዴንቁዋሴ› ጌዔኔ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ዔራቶና ጎኦቡሞና ኔና ዻቢሼኔ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ዒኖና ኔ፦ ‹ታናኬ፥ ታ ጊዳፓ ዓቴም ሜሌ ባኣሴ› ጌዔኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኔኤኮ ማርሾና ኔኤኒ ባይዛኒ ዳንዳዑዋ ፑርታ ባኣዚ","poem":1},{"text":"ኔኤኒ ቃዛኒ ዳንዳዑዋ ዴኤሢ ሜታ","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ማሊባኣ ባይሲንታ ዔሪባኣንቴ ኔና ሄላንዳኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ጎኦንቴ ኔኤም ዻካታዎ ጊኢጋንዳያ ማዔቴ","poem":1},{"text":"ኔኤኮ ሞርኮዋ ኔኤኒ ዒጊቻኒ ዳንዳዓንዳያታቴ","poem":2},{"text":"ሂንዳ ዓካሪ ኔኤኮ ናኣቱማፓ ዓርቃዖ","poem":1},{"text":"ማዺ ማዺ ኔ ናንጌ፥ ሚርጌ ማርሾ ማርሼ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኔኤኒ ዔኬ ዞራ ላላቢሴያፓ ዓቴም ዓይጎዋ ኔና ማኣዲባኣሴ፤","poem":1},{"text":"ዓጊኖኮ ፄኤራ ፄኤራ ዦኦጋሢ ዛጊ","poem":2},{"lineBreak":true},{"text":"ፓይዳ ዓሳ ሂንዳ ሃኒ ሙኮንጎ፤","poem":2},{"lineBreak":true},{"text":"ኔና ሄላንዳ ሜታሢዳፓ ዔያታ ኔና ዓውሶንጎ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«ዔያታ ዲኢሪ ዲልባጉዴያኬ፥ ታሚ ዔያቶ ሙዓንዳኔ፤","poem":1},{"text":"ፔ ቶኦኮ ዔያታ ታሞ ሼኤላፓ ዓውሳኒ ዳንዳዑዋሴ፤","poem":2},{"lineBreak":true},{"text":"ዓሲ ዓጫ ዴዒ ካሽታ ታሚ ባኣሴ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ናኣቱማፓ ዓርቃዖ ዔያቶና ዎላ ኔ ላቤዞንሢ","poem":1},{"text":"ዎላ ኔኤኒ ኮርሞ ኮርሜዞንሢ","poem":2},{"text":"ማዻኒ ዳንዳዓማ ዬማ ሌሊኬ፤","poem":1},{"text":"ዔያታ ፔቴ ፔቴሢ ፔ ቤዞ ዓኣዻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ኔና ዓውሳንዳያ ጋዓንቴ ባኣሴ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}