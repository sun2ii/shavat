{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"ISA","translationId":"mdy_twf","name":"ዒሲያሴ ማፃኣፖ","commonName":"ዒሲያሴ ማፃኣፖ","title":"ዒሲያሴ ማፃኣፖ","order":23,"numberOfChapters":66,"sha256":"0585110711ab765bb8ad52ae6d6c3dab40fe368c20e71e6d5dd66f2fb946a5fd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mdy_twf/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":48,"content":[{"type":"heading","content":["ዋይዞ ዒፄ ዒስራዔኤሌ ዓሶ"]},{"type":"verse","number":1,"content":[{"text":"«ዒንሢ ያይቆኦቤ ማኣራ!","poem":1},{"text":"ዒስራዔኤሌ ሱንፆና ዔኤሊንቴ ዓሳ","poem":2},{"lineBreak":true},{"text":"ዪሁዳ ዜርፃፓ ሙኬ ዓሳ","poem":2},{"lineBreak":true},{"text":"ፆኦሲ ሱንፆና ጫኣቃ ዓሳ","poem":2},{"lineBreak":true},{"text":"ጎኑሞና፥ ሃሣ ፂሉሞናቱዋንቴ","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ካኣሽካ ዓሳ","poem":2},{"lineBreak":true},{"text":"ሃያ ዋይዙዋቴ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዱማዼ ካታሜሎ ሱንፆና ዔኤሊንቴ ዓሳ","poem":1},{"text":"ሱንፃ ቢያ ባኮ ዎይሣ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ጉሙርቃ ዓሳ","poem":2},{"lineBreak":true},{"text":"ሃያ ዋይዙዋቴ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«ሴካ ቤርቲም ማዓንዳ ባኮ ዛሎ ሚርጌ ሌዔኮ ቤርታ ታኣኒ ኬኤዜኔ፤","poem":1},{"text":"ታ ዻንጋፓ ኬስኬም ዔርታንዳጉዲ ታ ማሄኔ፤","poem":2},{"lineBreak":true},{"text":"ዔርቲባኣንቴ ዬያ ታ ማዼኔ፥ ዬይያ ማዺንቲ ኩሜኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዎማዒ ኔ ዋይዚ ዒፃያታቴያ ታኣኒ ዔራኔ፤","poem":1},{"text":"ኔኤኮ ባቃኖ ሻዣ ዓንጊጉዲ","poem":2},{"lineBreak":true},{"text":"ባሊታኣ ኔኤኮ ሞኦናጉዲኬ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሃያ ባኮ ቢያ ቤርታሲ ታኣኒ ኔኤም ኬኤዜኔ፤","poem":1},{"text":"ሃይ ማዺንቲ ኩማንዳሢኮ ቤርታ ታኣኒ ዔርዚናኣኮኬ፤","poem":2},{"lineBreak":true},{"text":"ዬያ ታኣኒ ማዼሢ ‹ኑኡኮ ሜሌ ፆኦዛ ሃያ ማዼኔ፤","poem":2},{"lineBreak":true},{"text":"ሚፆና ዓንጎናኮ ማላታ ሃያ ጌስቲ ቱኬኔ› ኔኤኒ ጎዑዋጉዲኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«ታኣኒ ኬኤዜሢ ኔ ዋይዜኔ፤","poem":1},{"text":"ዬይያ ማዺንቲ ኩሜሢ ኔኤኒ ዛጌኔ፤","poem":2},{"lineBreak":true},{"text":"ማሊ ጶቂሢጋፓ ጎኑሞ ዔሬ፤","poem":2},{"lineBreak":true},{"text":"ሃናፓ ዓርቃዖ ቤርታዺ ዓኣሽንቲ ዓኣ","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ዔሪባኣ ዓኪ ባኣዚ ታ ኔና ቤኤዛንዳኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዬያታ ሚርጌ ዎዴኮ ቤርታቱዋንቴ ሃሢ ማዢንቴ ባኣዚኬ፤","poem":1},{"text":"ኔኤኒ፦ ‹ቤርታዺ ታ ዔሬኔ› ጎዑዋጉዲ","poem":2},{"lineBreak":true},{"text":"ሃያ ቤርታ ፔቴታዖ ኔ ዋይዚባኣያኬ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታኣኒ ኬኤዜሢ ኔ ዋይዚባኣሴ፥ ዔሪባኣሴ፤","poem":1},{"text":"ሚናፓ ዓርቃዖ ዋያ ኔኤኮ ባይቄያኬ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ዒንዶ ጎጳፓ ዓርቃዖ ጌሻያ ማዔሢ","poem":2},{"lineBreak":true},{"text":"ናኣቱሞ ዎዳፓ ዓርቃዖ ዋይዙዋ ማዔሢ","poem":2},{"lineBreak":true},{"text":"ታኣኒ ኔና ዔራኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«ታ ሱንፃ ቦንቺንታንዳጉዲ ታኣኮ ዻጎ ታኣኒ ጫኪሳንዳኔ፤","poem":1},{"text":"ዓሳ ታና ጋላታንዳጉዲ ታኣኮ ዻጎና ኔና ባይዚፆ ታ ሃሻንዳኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ቢራ ዓንጊጉዲ ማዒባኣቶዋ ሜቶ ታሚና ታ ኔና ሼኤሼኔ፤","poem":1},{"text":"ባይቁዋ ሜቶ ታሞና ታ ኔኤኮ ዶዱሞ ዛጌኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ጋይቴ ጌዒ ታኣኒ ታኣሮ ዬያ ማዻንዳኔ፤","poem":1},{"text":"ታና ታ ዓይጎሮ ዻውሲንቲም ዓኣሢ ዒንጋንዳይ?","poem":2},{"lineBreak":true},{"text":"ታኣኮ ቦንቾ ዖኦማኣ ታ ዒንጋዓኬ።»","poem":2}]},{"type":"heading","content":["ናንጊና ናንጋ ጎዳ ዶኦሬ ሱኡጌ"]},{"type":"verse","number":12,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ያይቆኦቤ! ታኣኒ ዔኤሌሦ ዒስራዔኤሌ ዋይዜ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ታናኬ፤ ዓይፆይዳ ዓኣሢንታ ጋፒንፃ ዓኣሢያ ታናኬ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሳዖ ታ ኩጫ ማዤኔ፤","poem":1},{"text":"ጫሪንጮዋ ዳሬሢ ታኣኮ ሚዛቆ ኩጮኬ፤","poem":2},{"lineBreak":true},{"text":"ታ ዔኤላ ዎዶና ዑካዺ ታ ቤርቶ ዔያታ ሙካኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«ዒንሢ ቢያሢ ቡኪንቲ ሙኪ ዋይዙዋቴ!","poem":1},{"text":"ሃያ ባኮ ዛሎ ቤርታዺ ኬኤዜይ ሜሌ ፆኦዞ ባኣካፓ ዎያዳይ?","poem":2},{"text":"ፆኦሲ ናሽኪ ዶኦሬሢ","poem":1},{"text":"ፆኦሲ ማሊፆ ባብሎኔይዳ ማዺ ኩንሣንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያኮ ዎልቃኣ ባብሎኔ ዓሶ ባይዛንዳኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታኣኒ ታኣሮ ኬኤዜኔ፥ ታ ዒዛ ዔኤሌኔ፤","poem":1},{"text":"ዔኪ ታ ሙካንዳኔ፥ ዔባ ዒዛም ጊኢጋንዳኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሃንጋ ታ ባንሢ ሙኪጋፓ ሃያ ዋይዙዋቴ፤","poem":1},{"text":"ቤርታፓ ዓርቃዖ ታ ኬኤዜሢ ዓኣቺ ዴሜናቱዋሴ፤","poem":2},{"lineBreak":true},{"text":"ዬይ ማዔ ዎዳፓ ዓርቃዖ ታኣኒ ዒኢካኬ።","poem":2},{"text":"ሃሢያ ታና ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢንታ","poem":1},{"text":"ዒዛኮ ዓያኖንታ ዳኬኔ።»","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኔና ዓውሳ ዒስራዔኤሌኮ ዱማዼሢ","poem":1},{"text":"ቢያ ባኮ ዎይሣ ጎዳሢ ሂዚ ጋዓኔ፦","poem":2},{"text":"«ኔና ፓሣ ባኣዚ ቢያ ዔርዛሢ","poem":1},{"lineBreak":true},{"text":"ኔኤኒ ዓኣዻኒ ኮይሳ ጎይፆ ዔኪ ኔና ዓኣዻሢ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ማዔ ታና ኔ ፆኦዛሢኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«ዎንዴ ታኣኮ ዓይሢፆ ኔ ኮሺ ዋይዜያታቴ","poem":1},{"text":"ኮሹሞ ኔኤም ሚጩዋ ዎርዚ ዋኣሢጉዲ","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ፂሉማኣ ባዞ ዋኣፆጉዲ ማዓንዳንቴኬ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዜርፃ ኔኤኮ ዓዳ ማኣሻላጉዲ ማዓንዳንቴ","poem":1},{"text":"ናኣታ ኔኤኮ ሳዖ ዓጮጉዲ ማዓንዳያታንቴ","poem":2},{"lineBreak":true},{"text":"ሱንፃኣ ዔያቶኮ ታ ኮራፓ ዋሊንቲ ባይቂንዱዋንቴኬ!»","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ዓካሪ ባብሎኔይዳፓ ኬስኩዋቴ፤","poem":1},{"text":"ባብሎኔ ዓሶፓ ቶላኒ ጳሽኩዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዬያ ዒላሺሢና ዴንዲ ዓጮኮ ጋፖ ሄላንዳኣና ኬኤዙዋቴ፤","poem":2},{"lineBreak":true},{"text":"«ፆኦሲ ፔ ዓይላሢ ያይቆኦቤ ዓውሴኔ» ጎዑዋቴ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ፆኦሲ ዔያቶ ዓሳ ናንጉዋ ዳውሎይዴና ዔኪ ዓኣዼያና","poem":1},{"text":"ዋኣሢ ዔያቶ ዼኤቢባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ዋኣፆ ዔያቶም ላላፓ ዒ ዓልቂሴኔ፤","poem":2},{"lineBreak":true},{"text":"ላሎ ጳሊ ዋኣፆ ዔያቶም ዹኡሴኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«ፑርቶ ዓሶም ኮሹሞ ባኣሴ» ጋዓኔ፥ ናንጊና ናንጋ ጎዳሢ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/ISA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/ISA/47.json","previousChapterAudioLinks":{},"numberOfVerses":22}