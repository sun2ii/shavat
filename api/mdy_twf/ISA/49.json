{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"ISA","translationId":"mdy_twf","name":"ዒሲያሴ ማፃኣፖ","commonName":"ዒሲያሴ ማፃኣፖ","title":"ዒሲያሴ ማፃኣፖ","order":23,"numberOfChapters":66,"sha256":"0585110711ab765bb8ad52ae6d6c3dab40fe368c20e71e6d5dd66f2fb946a5fd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mdy_twf/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":49,"content":[{"type":"heading","content":["ፆኦሲ ዓይላሢ"]},{"type":"verse","number":1,"content":[{"text":"ዋኣፆ ሳዛ ዓኣ ሳዖይዳ ናንጋ ዴራ ዋይዙዋቴ!","poem":1},{"text":"ዒንሢ ሃኬ ዓጫ ዓኣ ዓሳ ማሊ ጶቂሡዋቴ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ታኣኒ ሾይንቱዋንቴ ቤርታ ታና ዔኤሌኔ፤","poem":2},{"lineBreak":true},{"text":"ዒንዶ ጎጳ ዓኣንቴ ሱንፆ ታኣኮ ዒ ጌሤኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዒንዲርዞ ታኣኮ ዓዳ ዋርቂንቴ ጬንቾ ዓፓሮጉዲ ማሄኔ፤","poem":1},{"text":"ፔኤኮ ኩጮ ሺቦ ዴማ ታና ዓኣቼኔ፤","poem":2},{"lineBreak":true},{"text":"ዓጬ ሂኢሺ ማሂ ካቲሎይዳ ዒ ታና ዓጌኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዒዚ ታና፦ «ዒስራዔኤሌ! ኔኤኒ ታኣኮ ዓይላሢኬ፤","poem":1},{"text":"ኔ ዛሎሮ ሜሌ ዴራ ታና ቦንቻንዳኔ» ጌዔኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታኣኒ ጋዓንቴ፦ «ጉሪ ላቤኔ፤","poem":1},{"text":"ዔኤቢ ፓሣ ባኣዚ ባኣንቴ ጉሪ ዎልቆ ታ ጋፒሴኔ፤","poem":2},{"lineBreak":true},{"text":"ጋዓንቴ ዬያ ዛሎ ፆኦሲ ታኣም ዎጋንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ታ ላቢፆኮ ዒንጎንዶ ባካ ናንጊና ናንጋ ጎዳ ኮራኬ» ጌዔኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ናንጊና ናንጋ ጎዳ ቤርታ ታኣኒ ቦንቺንቴኔ፤","poem":1},{"text":"ዒዚ ታኣኮ ዎልቃሢ ማዔኔ።","poem":2},{"text":"ዒዛ ዓይሌ ማዓንዳጉዲ ዒንዶ ጎጳ ዓኣንቴ ታና ማዤሢ","poem":1},{"lineBreak":true},{"text":"ያይቆኦቤ ታኣኒ ዒዛ ባንሢ ማሃንዳጉዲ","poem":1},{"lineBreak":true},{"text":"ዒስራዔኤሌያ ዒዛ ባንሢ ቡኩሳንዳጉዲ","poem":1},{"text":"ታና ዶኦሬ ጎዳሢ ሂዚ ጋዓኔ፦","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዒዚ፦","poem":1},{"text":"«ያይቆኦቤ ፃጶኮ ቦንቾ ጊንሣ ማሂፃ","poem":2},{"lineBreak":true},{"text":"ፒኢጫዺ ዓቴ ዒስራዔኤሌ ዓሶ ማሂ ዔኪ ሙኪፃ","poem":2},{"lineBreak":true},{"text":"ታ ዓይሌ ማዒ ኔኤኮ ማዺፃ","poem":2},{"lineBreak":true},{"text":"ኔኤም ኮሺ ሼሌዔ ባኣዚኬ፤","poem":2},{"text":"ዬያፓ ባሼ ጋዓንቴ","poem":1},{"text":"ታኣኮ ዓውሲፃ ዴንዲ ዓጮኮ ጋፖ ሄላንዳጉዲ","poem":2},{"lineBreak":true},{"text":"ሜሌ ዴሮም ቢያ ፖዒ ኔ ማዓንዳጉዲ","poem":2},{"lineBreak":true},{"text":"ታኣኒ ኔና ዬያም ዒንጌኔ» ጌዔኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኔና፥ ዴሮና ቶኦቺንቴሢና ዒፂንቴሢናም","poem":1},{"text":"ዎይሣ ዓሶኮ ዓይሌ ማዒ ማዻሢም","poem":2},{"lineBreak":true},{"text":"ዒስራዔኤሌ ዓውሳ ዱማዼ ፆኦዛሢ ሂዚ ጋዓኔ፦","poem":2},{"lineBreak":true},{"text":"«ካኣታ ኔና ዛጋዖ ኔኤም ዔቃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ካኣቶ ናኣታ ኔኤም ዚጋንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዬይ ያዺ ማዓንዳሢ ኔና ዶኦሬ","poem":2},{"lineBreak":true},{"text":"ዒስራዔኤሌኮ ዱማዼ ጉሙርቂንታ ፆኦዛሢ ዛሎሮኬ።»","poem":2}]},{"type":"line_break"},{"type":"heading","content":["ዒስራዔኤሌ ዓሶኮ ጊንሣ ፔ ቤዞ ማዒፆ"]},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ታኣኒ ኮዓ ዎዶና ኔ ሺኢጲፆ ዋይዛንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ዻቂንቶ ኬሎና ኔና ታ ማኣዳንዳኔ፤","poem":2},{"text":"ዓጬሎ ጊንሣ ማሂ ኔ ዔቂሳንዳጉዲ","poem":1},{"lineBreak":true},{"text":"ቆይዳ ማዔ ሳዖ ኔኤኒ ጊኢጊሻንዳጉዲ","poem":1},{"text":"ታኣኒ ጫኣቂ ዴሮም ኔና ዒንጌኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኔኤኒያ ቱኡዞ ዓሶ፦ ‹ቡሊንቲ ዓኣዹዋቴ›","poem":1},{"text":"ዹሞይዳ ዓኣ ዓሶዋ፦ ‹ሃኒ ፖዖ ኬስኩዋቴ› ጋዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ጎይፆ ዓጫ ዔያታ ሙዖ ባኣዚ ዴንቃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ቦምቦንቄያ ማዒ ናንጌ ጌሜራ ዔያቶም ሄንቆ ቤሲ ማዓንዳኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ናይዚና ዼኤቢና ዔያቶ ሄላዓኬ፤","poem":1},{"lineBreak":true},{"text":"ዳውሎኮ ዖይዾ ዢባራ፥ ጊንሣ ሃሣ ዓባኣ ዔያቶ ዔኤቢ ዎኦታዓኬ፤","poem":1},{"text":"ዬይ ያዺ ማዓንዳሢ ዔያቶ ሚጪንታሢ","poem":2},{"lineBreak":true},{"text":"ዓልቃ ዋኣፃ ዓኣ ቤዞ ዔኪ ዓኣዻንዳሢሮኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«ዹኮ ታኣኮ ታ ባኣሲ ጎይሢ ማሃንዳኔ፤","poem":1},{"text":"ዳልጎ ጎይፃኣ ሌካ ዼጊ ጋዓንዳኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዴራ ሃኬ ዓጪፓ ሙካንዳኔ፤","poem":1},{"text":"ፔቴ ፔቴ ዓሳ ኬዶ ባንፃፓ","poem":2},{"lineBreak":true},{"text":"ዛላ ዓባ ጌላ ባንፃፓ","poem":2},{"lineBreak":true},{"text":"ሃንጎዋታ ሃሣ ሲኒሜይዳፓ","poem":2},{"noteId":3},{"text":"ሙካንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዴሮ ፔኤኮ ዶዲሻሢሮ","poem":1},{"text":"ሜታዺ ዋኣያዞንሢማ ሚጪንታንዳሢሮ","poem":2},{"lineBreak":true},{"text":"ጫሪንቺዮ! ዓይናዹዋቴ፥ ሳዔሌ! ዎዛዼ፥ ዹካኣ ዒላሹዋቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ፂዮኔ ዴራ ጋዓንቴ","poem":1},{"text":"«ናንጊና ናንጋ ጎዳ ኑና ሃሼኔ፤","poem":2},{"lineBreak":true},{"text":"ኑ ፆኦዛሢ ኑና ዋሌኔ» ጌዔኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ዒንዳ ፔኤኮ ዻንሢሣ ናይ ዋላኒ ዳንዳዓ?","poem":2},{"lineBreak":true},{"text":"ዒዛ ፔኤኮ ሾዔ ናዖ ሚጪንቱዋዓዳ?","poem":2},{"lineBreak":true},{"text":"ዒዛ ዋላኒ ዳንዳዓኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ጋዓንቴ ዒንሢ ዋላዓኬ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዬሩሳላሜ! ታ ኩጮኮ ቃኣቆይዳ ታ ኔና ቆኦቄኔ፤","poem":1},{"text":"ኔኤኮ ኬኤሎ ዲሮዋ ቢያ ዎዴ ታ ጶቂሣኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«ኔና ጊንሣ ማዣንዳዞንሢ ዑኬና ሙካንዳኔ፤","poem":1},{"text":"ዶይሲ ኔና ባይዜዞንሢ ጋዓንቴ ዴንዲ ባይቃንዳኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዼጊ ጌዒ ኮሮ ኔኤኮ ዛጌ፤","poem":1},{"text":"ናኣታ ኔኤኮ ቡኪ ሃንጋ ኔ ባንሢ ሙካኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ናንጊና ናንጋ ጎዳ ባይቁዋያ ማዔ ጎይፆና ሂዚ ጋዓኔ፦","poem":2},{"lineBreak":true},{"text":"‹ቢያሢ ማኣዖጉዲ ኔኤኒ ዔያቶ ማይንታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዑኡታ ፓልሞ ፓልማሢጉዲ ኔኤኒያ ዔያቶ ፓልማንዳኔ።›»","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«ሻሂንቲ ኔኤኒ ጉሪ ማዓንዳጉዲ","poem":1},{"text":"ሳዓ ኔኤኮ ካይሲ ማዓንዳጉዲ","poem":2},{"text":"ዔያታ ማዼያታቴያ","poem":1},{"text":"ማዒ ሙካ ኔ ጊዳ ናንጋዞንሢም ኩንዓያ ኔኤኒ ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ኔና ሻሂ ዶይሴ ዓሳ ኔጊዳፓ ሃኪ ዓኣዻንዳኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሾይ ዎዺሼያ ማዒ ኔ ዓኣንቴ ሾይንቴ ናኣታ","poem":1},{"text":"ኔኤኮ ዋያ ዋይዛንቴ፦","poem":2},{"text":"‹ሃይ ቤዛ ኑኡም ሚርጌ ኩንዔያ ማዔሢሮ","poem":1},{"lineBreak":true},{"text":"ኑኡኒ ናንጋንዳ ዳልጊ ቤሲ ኑኡም ዒንጌ› ጋዓንዳኔ።","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ኔኤኒያ ኔ ዒኖና ሂዚ ጋዓንዳኔ፦","poem":1},{"text":"‹ሃያ ናኣቶ ዖ ታኣም ሾዔይ?","poem":2},{"lineBreak":true},{"text":"ሚርጌ ናይ ታ ባይዚ ናይ ባኣያ ማዔንቴ","poem":2},{"lineBreak":true},{"text":"ዳውሲንቲ ዴንዲ፥ ታና ናሽካ ዓሲያ ታ ባይዜንቴ","poem":2},{"lineBreak":true},{"text":"ዓካሪ ሃያ ናኣቶ ዲቼሢ ዖናዳይ?","poem":2},{"lineBreak":true},{"text":"ታኣኒ ታኣሮ ሌሊ ዓኣንቴ","poem":2},{"lineBreak":true},{"text":"ዓካሪ ሃይ ናኣታ ዓንካፓ ሙኬይ?› »","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ኔኤኮ ዓቲንቆ ናኣቶ ዔያታ ፔ ሾኦጳ ቃልሲ","poem":2},{"lineBreak":true},{"text":"ዉዱሮ ናኣቶዋ ፔ ጌኤቶይዳ ኬዲ ሙካንዳጉዲ","poem":2},{"lineBreak":true},{"text":"ካኣቶም ታኣኒ ማላታ ቤኤዛንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዴሮማኣ ታኣኒ ባንዲራ ዻዋንዳኔ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዬይ ካኣታ ኔና ዲቻ ዓዶንሢ ማዓንዳኔ፤","poem":1},{"text":"ዔያቶኮ ጌኤሾንሢያ ዲቻ ዒንዶንሢ ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ፔኤኮ ባሊቶ ሳዖ ባንሢ ሂርኪዲ ኔኤም ዚጋንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ቶኮ ሲላሎ ዔያታ ላኣዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያሮ ታኣኒ ናንጊና ናንጋ ጎዳ ማዔሢ ኔ ዔራንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኮ ማኣዳሢ ጉሙርቂ ካፓዞንሢ ፔቴታዖ ቦርሲንታዓኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ጎኦባ ዓሲ ኩቺዳፓ ዲዒ ዔካኒ ዳንዳዒንታ?","poem":1},{"text":"ሃንጎ ሃሣ ጫርሺ ዓሲ ኩሽካፓ ዲዒንቴሢ ቶሊሳኒ ዳንዳዒንታንዳ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ናንጊና ናንጋ ጎዳ ጋዓንቴ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ዶዲ ማዔ ጎኦቦ ዓሶይ