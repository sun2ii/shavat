{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"ISA","translationId":"mdy_twf","name":"ዒሲያሴ ማፃኣፖ","commonName":"ዒሲያሴ ማፃኣፖ","title":"ዒሲያሴ ማፃኣፖ","order":23,"numberOfChapters":66,"sha256":"0585110711ab765bb8ad52ae6d6c3dab40fe368c20e71e6d5dd66f2fb946a5fd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mdy_twf/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":50,"content":[{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"ዒንሢኮ ዒንዶ ታ ዓንጄያ ማዒፆ ዔርዛ ዋርቃታ ዎካዳይ?","poem":2},{"lineBreak":true},{"text":"ዒንሢ ታኣኒ ዎያ ታኣም ሚኢሾ ታልዔሢም ሻንቼይ?","poem":2},{"text":"ዒንሢ ዒንሢኮ ጎሞሮ ሻንቺንቴኔ፤","poem":1},{"lineBreak":true},{"text":"ዒንሢ ዻቢንቶሮ ዒንሢኮ ዒንዳ ዓንጂንቴኔ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«ታኣኒ ሙኬያና ዓይጎ ዓሲያ ባኣሢ ዓይጎሮዳይ?","poem":1},{"text":"ታኣኒ ዔኤሊንቴያና ዓይጎ ዓሲያ ዬሂባኣሢ ዓይጎሮዳይ?","poem":2},{"lineBreak":true},{"text":"ታኣኒ ዓውሳኒ ዳንዳዑዋዓዳ?","poem":2},{"lineBreak":true},{"text":"ዻቂሻኒ ዎልቄ ታኣኮ ባኣዓዳ?","poem":2},{"lineBreak":true},{"text":"ባዞ ታኣኒ ጎሪ ሚጪሳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዎሮዋ ዓሲ ናንጉዋ ዳውሌ ታ ማሃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዬካ ዓኣ ሞላሢያ ዋኣፃ ባኣሢሮ ሃይቂ ዎዓንዳኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጫሪንጮ ታኣኒ ዹሚሻንዳኔ፤","poem":1},{"text":"ሲዬ ዓፒላና ታ ዒዞ ጎኦቢ ዓኣቻንዳኔ።»","poem":2}]},{"type":"heading","content":["ፆኦሲ ዓይላሢኮ ዓይሢንቲፆ"]},{"type":"verse","number":4,"content":[{"text":"ላቤዞንሢ ቃኣሎና ዶዲሺሢ ታ ዔራንዳጉዲ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ኮይሳ ባኣዚ ታ ጌስታንዳጉዲ","poem":2},{"text":"ዔራቶና ጌስታ ዒንዲርሲ ታኣም ዒንጌኔ፤","poem":1},{"text":"ጉቶ ጉቶ ጊንዓስካፓ ዒዚ ታና ጴቻኔ፤","poem":2},{"lineBreak":true},{"text":"ዔኤቢ ዋይዚ ዔሪሢዳ ዓኣ ዓሲሮጉዲ","poem":2},{"text":"ዋዮ ታኣኮ ዒዚ ቡላኔ።","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ማሊ ጶቂሥሢ ታኣም ዒንጌኔ፤","poem":1},{"text":"ታኣኒያ ዋይዚ ዒፃያ ማዒ ዒዛይዳፓ ሃኪባኣሴ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዢራኣፖና ታና ጳርቃ ዓሶም ዙሎ","poem":1},{"text":"ቡኡጮ ታኣኮ ሜኤዳ ዓሶም ጋንጋሮ","poem":2},{"lineBreak":true},{"text":"ዓኣሢ ታኣኒ ዒንጌኔ፤","poem":2},{"text":"ጫሽኪ ታና ጩታ ዓሶይዳፓ","poem":1},{"text":"ዓኣፖ ካሮ ታኣኮ ታ ሺርሺባኣሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ናንጊና ናንጋ ጎዳሢ ታና ማኣዳሢሮ ታ ዻውሲንቲንዱዋሴ፤","poem":1},{"text":"ታኣኒ ታና ዓዳ ሳቆ ሹቺጉዲ ዶዲሻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ቦርሲንቲንዱዋሢያ ታ ዔራኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታኣም ዎጋንዳ ፆኦዛሢ ዑኬኬ፤","poem":1},{"text":"ዓካሪ ታኣና ሞኦታሢ ዖናዳይ?","poem":2},{"lineBreak":true},{"text":"ኑ ዎላ ሂንዳ ዎጎ ቤዞ ሺኢኮም።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታና ማኣዳሢ ናንጊና ናንጋ ጎዳኬ፤","poem":1},{"text":"ዖ ታና ኔ ዻቤኔ ጋዓንዳይ?","poem":2},{"lineBreak":true},{"text":"ታና ሞኦታ ዓሳ ማኣዖጉዲ ጪንቃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ቢላኣ ዔያቶ ሙዓንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ዒንሢ ባኣካፓ ናንጊና ናንጋ ጎዳ ዒጊጫይ","poem":1},{"text":"ዒዛኮ ዓይላሢ ቃኣሎም ዓይሢንታሢ ዖናዳይ?","poem":2},{"lineBreak":true},{"text":"ፖዒባኣ ዹሚዳ ሃንታሢ","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ጉሙርቆንጎ፤","poem":2},{"lineBreak":true},{"text":"ዒዚ ፔኤኮ ጉሙርቂፆ ፆኦዛሢዳ ማሆንጎ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሃሢ ጋዓንቴ ዒንሢ ታሚ ዔኤሤኔ፤","poem":1},{"text":"ቶኦካ ቶኦካ ዒንሢኮ ዔኤታ ኩሻ ዒንሢ ዓርቄኔ፤","poem":2},{"lineBreak":true},{"text":"ዓካሪ ዬያ ዒንሢኮ ታሞ ፖዖይዳ ዓኣዹዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢ ዓይሤ ኩሾ ፖዓ ሃንቱዋቴ፤","poem":2},{"text":"ዒንሢ ታ ኩጫፓ ዔካንዳ ባካ ዬያኬ፤","poem":1},{"lineBreak":true},{"text":"ዬያ ሜቶና ዒንሢ ካራ ባይቃንዳኔ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}