{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"ISA","translationId":"mdy_twf","name":"ዒሲያሴ ማፃኣፖ","commonName":"ዒሲያሴ ማፃኣፖ","title":"ዒሲያሴ ማፃኣፖ","order":23,"numberOfChapters":66,"sha256":"0585110711ab765bb8ad52ae6d6c3dab40fe368c20e71e6d5dd66f2fb946a5fd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mdy_twf/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":51,"content":[{"type":"heading","content":["ናንጊና ናንጎ ዻቂንታ ፂዮኔም ዬዓንዳሢ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ታናንታ ታኣኮ ፂሉሞዋ ኮዓዞንሢ ዋይዙዋቴ፤","poem":2},{"text":"ዒንሢ ዓርሲንቲ ኬስኬ ሹጫሢ","poem":1},{"lineBreak":true},{"text":"ቦኦኪንቲ ዒንሢ ኬስኬ ዔታሢ ዛጉዋቴ።","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ዒንሢኮ ዓዳሢ ዓብራሃሜንታ","poem":1},{"text":"ዒንሢ ሾዔ ዒንዴሎ ሳኣራኣ ዛጉዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዓብራሃሜ ታኣኒ ዔኤላኣና ናይ ዒዛኮ ባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ጋዓንቴ ታኣኒ ዒዛ ዓንጄኔ፤","poem":2},{"lineBreak":true},{"text":"ዜርፆዋ ታ ዒዛም ሚርጊሼኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«ታኣኒ ናንጊና ናንጋ ጎዳ ፂዮኔንታ","poem":1},{"lineBreak":true},{"text":"ዒዞኮ ጉሪ ሳዓ ማዔ ቤዞዋ ቢያ ዶዲሻንዳኔ፤","poem":1},{"text":"ዒዞኮ ዓሳ ናንጉዋ ዳውሎ ታኣኒ ዔዴኔ","poem":2},{"lineBreak":true},{"text":"ዳውሎ ሳዖዋ ፆኦሲ ዱማ ዱማ ሚፆ ቱኬ ቤዞ ታ ማሃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒኢካ ኮሹሞና ዎዛና ዓኣያ ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ጋላታ ዓይኑሞዋ ዓይናዺንታንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«ታ ዴሬዮቴ! ዋይዙዋቴ!","poem":1},{"text":"ታኣኒ ዒንሢም ጋዓሢ ዒና ዔኩዋቴ፤","poem":2},{"text":"ዎጌ ታ ኮራፓ ጴዻንዳኔ፤","poem":1},{"text":"ታኣኮ ዎጊፃ ታ ዴሮም ቢያ ፖዒ ማዓንዳኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ታኣኒ ሩኡሪና ሙኪ ዒንሢ ዓውሳንዳኔ፤","poem":1},{"text":"ዓኣፒ ጊኢጳማና ታኣኒ ባሻንዳ ዎዴ ሙካንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኮ ዎልቆና ዴሮ ቢያ ታኣኒ ዎይሣንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዋኣፆ ሳዛ ዓኣ ዓጮይዳ ናንጋ ዴራ","poem":2},{"lineBreak":true},{"text":"ታና ሃጋኣ ዎዛ ማሂ ካፓኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ታኣኮ ዎልቆዋ ጉሙርቃኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዼጊ ጌዒ ሌካ ጫሪንጮ፥ ሊካ ሳዖዋ ዛጉዋቴ፤","poem":1},{"text":"ጫሪንጫ ጩቢጉዲ ላኣሊንቲ ባይቃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሳዓ ዓዳ ማኣዖጉዲ ጪንቃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒዞይዳ ናንጋዞንሢያ ቢያ ዉፃሌጉዲ ሃይቃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኮ ዓውሲፃ ጋዓንቴ ናንጊና ናንጋያኬ፤","poem":2},{"lineBreak":true},{"text":"ታ ፂሉሞኮዋ ጋፒንሢ ባኣሴ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«ዒንሢ ፒዜ ማዔ ባኮ ዔራዞንሢና","poem":1},{"text":"ታኣኮ ዎጋ ዒንሢኮ ዒኖይዳ ዓኣ ዓሳኣ ዋይዙዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዓሲኮ ቦሂፆ ዒጊጪፖቴ፤ ዔያቶኮ ጫዦና ዲቃቲፖቴ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዔያታ ቢላ ሙዔ ዓፒላጉዲ","poem":1},{"text":"ዛኣሌ ሙዔ ሱኡፔ ዓፒላጉዲያ ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኮ ዓውሲፃ ጋዓንቴ ናንጊና ናንጋያኬ፤","poem":2},{"lineBreak":true},{"text":"ታ ፂሉማ ሾይንቲፓ ሾይንቲ ሄላያኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ዔቄ! ዔቂ ዎልቆ ኔኤኮ ፔጋሴ!","poem":1},{"text":"ሚና ቤርታኣ ዎዶና ዓኣ ሾይንቶ ባኣካ ዓዳ ኔ ማዼ ጎይፆ ዔቄ፤","poem":2},{"lineBreak":true},{"text":"ሬዓቤ ጌይንታ ባዞ ቦዓሢ ጪርኬሢ","poem":2},{"lineBreak":true},{"text":"ዼኤፖ ቃራሢያ ጫርጌሢ ኔናኬ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኔኤኒ ዓውሴ ዓሳ ባዞና ፒንቃንዳጉዲ","poem":1},{"text":"ዼኤፖ ዋኣፆ ሚጪሲ","poem":2},{"lineBreak":true},{"text":"ዬያይዴና ጎይሢ ኬሴሢ ኔናኬ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኔኤኒ ናንጊና ናንጋ ጎዳሢ ዓውሴ ዓሳ ቢያ","poem":1},{"text":"ዎዛና ዓይናዺ፥ ዒላሺያ ዒላሺ ፂዮኔ ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒኢካ ዔያታ ናንጊና ናንጋ ዎዛ ቶኦካ ዓጊ ቦንቺንታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ኮሹሞንታ ባይቁዋ ዎዛንታ ዔያታ ዴንቃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዖዪሢንታ ዬኤፒንታ ዔያቶፓ ባይቃንዳኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"«ዒንሢ፥ ታ ዴሮ ዶዲሻሢ ታኣኒ ታኣሮኬ፤","poem":1},{"text":"ዓካሪ ማኣቲጉዲ ሹላያና ሃሃይቃ ዓሲ ዒንሢ ዒጊጫሢ ዓይጎሮዳይ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሳዖ ቦኦኮልቄሢና ጫሪንጮ ዳሬ","poem":1},{"text":"ዒንሢ ማዤ ናንጊና ናንጋ ጎዳ ዒንሢ ዋሌኔ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢ ባይዛኒ ጊኢጌ፥ ሄርቂ ዎይሣ ዓሶኮ ጎሪንቶሮ","poem":2},{"lineBreak":true},{"text":"ቢያ ዎዴ ዒንሢ ዒጊቹሞና ናንጋኔ፤","poem":2},{"lineBreak":true},{"text":"ሃሢ ዔያቶኮ ጎሪንታ ዬይ ዓንካዳይ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ቱኪንቲ ዓኣ ዓሳ ሩኡሪና ዓይላታፓ ኬስካንዳኔ፤","poem":1},{"text":"ዔያታ ቱኡቲ ዓኣ ዔቶይዳ ሃይቂንዱዋሴ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ሙዓንዳ ካሣኣ ባይቃዓኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«ዋኣፃ ዓጊፃንዳጉዲ ዼኤፖ ባዞ ዓጊሣሢ","poem":1},{"text":"ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢኬ፤","poem":2},{"lineBreak":true},{"text":"ሱንፃ ታኣኮ ቢያ ባኮ ዎይሣ ጎዳኬ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታኣኒ ታኣኮ ቃኣሎ ዻንጋ ኔኤኮ ጩታንዳኔ፤","poem":1},{"text":"ኔና ታኣኮ ኩጮ ሺቦና ታ ሺባንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ጫሪንጮ ዳሬሢ፥ ሳዖዋ ቦኦኮልቄሢ ታናኬ፤","poem":2},{"lineBreak":true},{"text":"ፂዮኔም፦ ‹ኔኤኒ ታ ዴሬኬ› ታ ጋዓንዳኔ።»","poem":2}]},{"type":"heading","content":["ፆኦሲኮ ጎሪንቶ ዑዦ ዓንጎ"]},{"type":"verse","number":17,"content":[{"text":"ኔኤኒ ናንጊና ናንጋ ጎዳ ኩጫፓ","poem":1},{"text":"ማሢ ጋኣዲሳ ጎሪንቶ ዑዦ ዼኤፖ ዓንጎና","poem":2},{"lineBreak":true},{"text":"ጋፒሲ ዑሽኬ ዬሩሳላሜ!","poem":2},{"lineBreak":true},{"text":"ጴጬ፤ ላዓ ጌዒ ዔቄ!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኔኤኒ ሾዒ ዲቼ ናኣቶይዳፓ ቢያ","poem":1},{"text":"ኩጮ ኔኤኮ ዓርቂ ዔኪ ዓኣዻንዳያ ጴዺባኣሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ጊዳ ጊዳ ቃሲንታ ባይሲንታ ኔና ሄሌኔ፤","poem":1},{"text":"ዓካሪ ዖ ኔና ዶዲሻንዳይ?","poem":2},{"text":"ዬይ ባካ ዶዒ ባይቂሢንታ ናይዚንታ ዖልዚንታኬ፤","poem":1},{"text":"ዬያሮ ታ ኔና ዎዲ ዶዲሻንዳይ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዓቲንቆ ናኣታ ኔኤኮ ዓዳ ፒሮይዳ ዓዺንቴ ጋፒሪጉዲ","poem":1},{"text":"ጎይፆኮ ዓሳ ቡካ ጶኦካ ላቢንቲ ሎኦሜኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶ ዑፃ ናንጊና ናንጋ ጎዳኮ ዻጋ ሾኦቴኔ፤","poem":2},{"lineBreak":true},{"text":"ኔ ፆኦዛሢኮዋ ጎሪንታ ኬዴኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ዎይኖ ዑዦ ዑሽኪቱዋንቴ ጉሪ ማሢንቴ","poem":1},{"text":"ሜታሢና ቡኡዲንቴ ዓሳ ሃያ ዋይዙዋቴ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ናንጊና ናንጋ ጎዳሢ","poem":1},{"text":"ፔ ዴሮ ዛሎ ሞኦታ ዒንሢ ፆኦዛሢ ሂዚ ጋዓኔ፦","poem":2},{"text":"«ዓዳ ማሢንቴ ዓሲጉዲ ጋኣዲሳ","poem":1},{"text":"ሜታሢ ዑዦ ዓንጎ ታ ዒንሢ ኩጫፓ ዔኬኔ፤","poem":2},{"lineBreak":true},{"text":"ሃካፓ ሴካ ዬያ ዑዦ ዓንጋፓ ዒንሢ ዑሽካዓኬ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዬያ ታኣኒ ዔኪ ኔና ሜታሳ ዓሶም ዒንጌኔ፤","poem":1},{"text":"ዔያታ፦ ‹ኑ ኔ ጊዴና ሄርቂ ሃንታንዳጉዲ ላሄ› ጌዔኔ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኒያ ዔያታ ሃንታንዳጉዲ ዙሎ ኔኤኮ ዔያቶም ሃሼኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}