{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"ISA","translationId":"mdy_twf","name":"ዒሲያሴ ማፃኣፖ","commonName":"ዒሲያሴ ማፃኣፖ","title":"ዒሲያሴ ማፃኣፖ","order":23,"numberOfChapters":66,"sha256":"0585110711ab765bb8ad52ae6d6c3dab40fe368c20e71e6d5dd66f2fb946a5fd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mdy_twf/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":52,"content":[{"type":"heading","content":["ፆኦሲ ዬሩሳላሜ ዓውሳንዳያ ማዒፆ"]},{"type":"verse","number":1,"content":[{"text":"ፂዮኔ! ጴጬ! ዔቄ፤","poem":1},{"text":"ዎልቆ ኔኤኮ ዓዳ ማኣዖጉዲ ማይንቴ!","poem":2},{"lineBreak":true},{"text":"ዱማዼ ካታሜሌ ዬሩሳላሜ! ኔኤኮ ሚዛጶ ማኣዓሢ ማይንቴ፤","poem":2},{"lineBreak":true},{"text":"ሃካፓ ሴካ ዓቲንቶ ቤርቶ ቲቂንቲባኣዞንሢና","poem":2},{"lineBreak":true},{"text":"ዳምቦ ጎይፆና ጌኤሽኪባኣ ዓሳ ኔኤኮ ኬኤሎ ዲሮ ጋሮ ጌላዓኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ዲዒንቲ ዔውቲ ዓኣዼ ዬሩሳላሜ!","poem":1},{"text":"ዔቂጋፓ ሲላሎ ኔኤኮ ሃርፔ፤","poem":2},{"lineBreak":true},{"text":"ካኣቱሞ ሻኣሎይዳ ዴዔ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢ ፂዮኔፓ ዲዒንቲ ዔውቴ ዓሳ!","poem":2},{"lineBreak":true},{"text":"ዒንሢ ቱኡቴ ካኖ ቢራቶ ባቃናፓ ቡሉዋቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":["ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦ «ሚኢሼ ዔኩዋዖ ጉሪ ዒንሢ ሻንቺንቴኔ፤ ዒንሢ ማሂ ዔውታንዳሢያ ሚኢሼ ጪጉዎንቴኬ።"]},{"type":"verse","number":4,"content":["ታ ዴራ ሃያኮ ቤርታ ሙኬ ዓሲ ማዒ ናንጋኒ ጊብፄ ዓጮ ኬዴኔ፤ ዬካፓ ዓሶኦሬ ዓሳ ካራባኣ ጎይሢና ሄርቂ ዔያቶ ዎይሤኔ።"]},{"type":"verse","number":5,"content":["ታኣኮ ዴራ ዔኤቢ ጪጉዎዖ ዔውታንቴ ታ ዛጌኔ፤ ሃሢ ታኣኒ ዓይጎ ማዻንዳ ባኣዚ ዓኣይ? ዔያቶ ዎይሣ ዓሳ ቦሂ ዔያቶና ዓማላኔ፥ ሱንፆዋ ታኣኮ ዬና ዓሳ ጫሽኬ ጎይሣ ፔኤቃኔ።"]},{"type":"verse","number":6,"content":[{"text":"ዬያሮ ታ ዴራ ታ ሱንፆ ዔራንዳኔ፤","poem":1},{"text":"ዬኖ ዓቦና ዬያ ቤርታዺ ኬኤዜሢ ታና ማዔሢ ጶቂሣንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሂዮ፤ ታኣኒ ታናኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ዹኮ ዑፆና ጌዒ ኮዦ ሃይሶ ዔኪ ሙካ ቶካ","poem":1},{"text":"ኮሹሞ ዛላኣ ኬኤዛዞንሢ","poem":2},{"lineBreak":true},{"text":"ዻቂንቶ ዛሎ ዒላቲ ኬኤዛዞንሢ","poem":2},{"lineBreak":true},{"text":"ፂዮኔማኣ፦ «ኔ ፆኦዛሢ ካኣታዼኔ!» ጋዓዞንሢ ዎዚ ሚዛጳይ!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ካታሞ ኔኤኮ ካፓ ዓሳ ዑኡዞ ፔኤኮ ዼጊዲ ዒላታሢ ዋይዜ!","poem":1},{"text":"ፔቱሞና ዔያታ ዎዛዺ ዓይናዻኔ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ፂዮኔ ማዒ ሙካኣና ፔ ዓኣፖና ዔያታ ዛጋንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ናንጊና ናንጋ ጎዳ ፔኤኮ ዴሮ ዶዲሼኔ፤","poem":1},{"text":"ዬሩሳላሜያ ዒ ዓውሴኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያሮ ዒንሢ ዬሩሳላሜኮ ዶዔ ቦካ!","poem":2},{"lineBreak":true},{"text":"ቡኪንቲ ፔቱሞና ዎዛዺ ዓይናዹዋቴ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዴሮ ቢያሢኮ ቤርታ","poem":1},{"text":"ዒ ዎልቄናታሢ ፔጋሲ ዔርዛንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዓጫ ጉቤ ዒዛኮ ዓውሲፆ ዛጋንዳኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዒንሢ ጌኤዦ ማኣሮ ሜሆ ኬዳ ዓሳ!","poem":1},{"text":"ባብሎኔይዳፓ ኬስኩዋቴ፥ ዱማዹዋቴ፤","poem":2},{"lineBreak":true},{"text":"ቄፄ ማዔ ባኮ ካኣሚፖቴ፤","poem":2},{"lineBreak":true},{"text":"ዒዞፓ ኬስኪ ጌኤሺ ማዑዋቴ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዒንሢኮ ቤርታ ማዒ ዔኪ ዒንሢ ዓኣዻንዳሢሮ","poem":1},{"text":"ዒስራዔኤሌ ፆኦዛሢ ጊንፆ ዛሎና ማዒ ዒንሢ ካፓሢሮ","poem":2},{"lineBreak":true},{"text":"ጳሺና ዒንሢ ኬስካዓኬ፤ ዓኣሺንቲያ ዒንሢ ዓኣዻዓኬ።","poem":2}]},{"type":"heading","content":["ሜታ ሄላንዳ ፆኦሲ ዓይላሢ"]},{"type":"verse","number":13,"content":[{"text":"ናንጊና ናንጋ ጎዳ፦","poem":1},{"text":"«ዓካሪ ታ ዓይላሢ ማዻ ባኮ ዔሪ ማዻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዼግ ዼጊ ጌዒ ቦንቺንታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሱንሢ ኬስኪ ሚርጌና ዔርቴያ ማዓንዳኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሚርጌ ዓሲ ዒዛ ዛጊ ዲቃታንዳያ ሄላንዳኣና","poem":1},{"text":"ዒዛኮ ዓውካራ ዓሲ ቢያፓ ዱማዼያ ማዒ ዖኦፔኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ቤርታ ዔያቶም ኬኤዚንቲባኣ ባኣዚ ዔያታ ዛጋንዳሢሮ","poem":1},{"text":"ዋይዚባኣ ባኣዚ ማሊ ጶቂሣንዳሢሮ","poem":2},{"lineBreak":true},{"text":"ሚርጌ ዴራ ታ ዓይላሢ ዛሎ ዲቃቲ ሄርሻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ካኣታኣ ጎዖንዶ ባኣዚ ባይዚ ዻንጋ ዓርቃንዳኔ» ጌዔኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}