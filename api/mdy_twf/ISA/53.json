{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"ISA","translationId":"mdy_twf","name":"ዒሲያሴ ማፃኣፖ","commonName":"ዒሲያሴ ማፃኣፖ","title":"ዒሲያሴ ማፃኣፖ","order":23,"numberOfChapters":66,"sha256":"0585110711ab765bb8ad52ae6d6c3dab40fe368c20e71e6d5dd66f2fb946a5fd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mdy_twf/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"ዴራ ሂዚ ጋዓንዳኔ፦","poem":1},{"text":"«ኑኡኒ ኬኤዛ ባኮ ዖኦኒ ጎኔኬ ጌዔይ?","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳኮ ዎልቃ ዖኦም ፔጋዺ ጴዼይ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ፆኦሲ ዓይላሢ ፃኣዺ ሳዓይዳ ባቃሌ","poem":1},{"text":"ባቃሊጉዲ ፃጲ ዳኪ ዑጌኔ፤","poem":2},{"lineBreak":true},{"text":"ኑ ዛጋንዳጉዲ ሚዛጱሞንታ","poem":2},{"lineBreak":true},{"text":"ቦንቾዋ ዒዛኮ ባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ዒዛ ኑ ናሽካንዳጉዲ","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ሱጉሢ ሚዛጱዋሴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዒዚ ዓሲና ቦሂንቴያና ዒፂንቴያኬ፤","poem":1},{"text":"ዒዚ ሜታዻያና ዖዖያ ዓሲኬ፤","poem":2},{"lineBreak":true},{"text":"ዓሳ ዒዛ ዛጋኒ ዓኣፖ ሺርሻንዳያ ሄላንዳኣና","poem":2},{"lineBreak":true},{"text":"ዒዚ ቦሂንቴያኬ፥ ኑኡኒያ ዒዛ ቦንቺባኣሴ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«ጎኔና ዒዚ ኑኡኮ ዶርዓሢ ዔኬኔ፥ ሃርጎዋ ዒዚ ኑኡኮ ኬዴኔ፤","poem":1},{"text":"ኑኡኒ ጋዓንቴ ፆኦሲ ዒዛ ጳርቄም","poem":2},{"lineBreak":true},{"text":"ሎኦሜያና ኪፃዼያ ማሂ ዛጌኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዒዚ ጋዓንቴ ጫርጊንቲ ኪፃዼሢ ኑኡኒ ፑርቴሢሮኬ፤","poem":1},{"text":"ዒዚ ጋኣጪንቴሢያ ኑ ዻቢንቶሮኬ፤","poem":2},{"lineBreak":true},{"text":"ኑኡኒ ዻቄሢ ዒዚ ዔኬ ሜታሢናኬ፤","poem":2},{"lineBreak":true},{"text":"ዒዛ ኪፃዺፆና ኑ ፓፄኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኑ ቢያሢ ማራይጉዲ ዣኣሌኔ፤","poem":1},{"text":"ቢያሢ ኑኡኒ ኑ ማሊፆ ጎይፆ ዓኣዼኔ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ጋዓንቴ ኑና ቢያሢኮ ዻቢንቶ ዒዛ ኬዲሴኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«ዒዛ ጌኔ ማዾና ሜቶና ሄሌኔ፤","poem":1},{"text":"ያዺ ማዔቶዋ ዔኤቢያ ዒ ጌዒባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ሹኪንታኒ ዔኪ ዓኣዺንታ ማራናይና","poem":2},{"lineBreak":true},{"text":"ዑፃፓ ጋፓኖ ታይዛ ዓሶ ቤርታ ዚቲ ጋዓ ማራይጉዲ","poem":2},{"lineBreak":true},{"text":"ዚቲ ጌዔያፓ ዓቴም ዔኤቢ ጌዒባኣሴ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዻቤ ባኣዚ ባኣንቴ ጌኔ ዎጌና ዒ ሃይቄኔ፤","poem":1},{"text":"ዬይ ማዓንዳሢ ቤርታዺ ዔሪ ጶቂሣኒ ዖ ዳንዳዔይ?","poem":2},{"lineBreak":true},{"text":"ጋዓንቴ ታኣኮ ዴሮ ዻቢንቶሮ ዒ ጳርቂንቴኔ፤","poem":2},{"lineBreak":true},{"text":"ዓሳ ናንጋ ዓጫፓ ዒዚ ሺኢኬኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዔኤቢ ፑርታ ባኣዚ ማዹዋዖ","poem":1},{"text":"ዒዛኮ ዻንጋፓኣ ሉኡዙሞ ኬስኩዋንቴ","poem":2},{"lineBreak":true},{"text":"ዒዚ ሃይቦና ፑርቶ ዓሶ ባኣካ ፓይዲንቴኔ፤","poem":2},{"lineBreak":true},{"text":"ዖርጎጮናኣ ዎላ ዒዚ ዱኡቴኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ዬይ ጋኣጪንቲፆና ሜታዺፃ ዒዛ ሄሌሢ","poem":1},{"text":"ናንጊና ናንጋ ጎዳኮ ማሊሢ ማዔምኬ፤","poem":2},{"lineBreak":true},{"text":"ዒዚ ዒዛኮ ሼምፓሢ ጎሜሮ ዒንጎ ዒንጊሢ","poem":2},{"text":"ማሂ ሺኢሼቴያ","poem":1},{"text":"ዒዚ ፔ ዜርፆ ዛጋንዳኔ፥ ናንጎ ሌዓኣ ዒዛኮ ዖዶቃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳኮ ማሊፃ ዒዛና ኩማንዳኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታኣኮ ፂሎ ማዔ ዓይላሢ ዋኣዬስካፓ ናንጎ ፖዖ ዛጊ ዎዛዻንዳኔ፤","poem":1},{"text":"ፔኤኮ ዔራቶና ሚርጌሢ ዒ ፂሊሳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶኮ ዻቢንቶዋ ዒዚ ኬዳንዳኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዒዚ ፔኤኮ ሼምፓሢ ሃይቢም ዓኣሢ ዒንጌኔ፤","poem":1},{"text":"ፑርቶ ማዻ ዓሶና ዎላ ዒ ፓይዲንቴኔ፤","poem":2},{"lineBreak":true},{"text":"ያዼ ማዔያታቴያ ዒዚ ሚርጌ ዓሶኮ ጎሞ ኬዴኔ፤","poem":2},{"lineBreak":true},{"text":"ዻቢንቶ ዓሶ ዛሎዋ ዒ ቃይሼኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያሮ ታኣኒ ዒዛ ዼኤፖ ዓሶ ባኣካ ማሂ ዒዛ ሄላ ዛሎ ዒንጋንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔርቴ ዓሶና ዎላ ዲዒንቴ ባኮ ዒ ጊሽታንዳጉዲ ታ ማሃንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}