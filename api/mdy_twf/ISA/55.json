{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"ISA","translationId":"mdy_twf","name":"ዒሲያሴ ማፃኣፖ","commonName":"ዒሲያሴ ማፃኣፖ","title":"ዒሲያሴ ማፃኣፖ","order":23,"numberOfChapters":66,"sha256":"0585110711ab765bb8ad52ae6d6c3dab40fe368c20e71e6d5dd66f2fb946a5fd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mdy_twf/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":55,"content":[{"type":"heading","content":["ዼኤቢንቴ ዓሶ ዔኤሎና ዔኤሊሢ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ዒንሢ ዼኤቢንቴ ዓሳ ቢያ ሃንጋ ዋኣፆ ባንሢ ሙኩዋቴ!","poem":2},{"lineBreak":true},{"text":"ዒንሢ ሻንቃኒ ሚኢሻ ባኣ ዓሳ!","poem":2},{"lineBreak":true},{"text":"ሃኒ ሙኪ ሻንቂ ሙዑዋቴ! ሃኒ ሙኪጋፓ","poem":2},{"lineBreak":true},{"text":"ሚኢሼ ጪጊባኣያታዖ ዲኢቆና ዎይኖ ዑዦና ዑሽኩዋቴ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ፓሡዋ ሙኡዚም ሚኢሾ ዒንሢኮ ዓይጋ ዒንሢ ኬሳይ?","poem":1},{"text":"ሚሻኑዋ ባኣዚም ዎልቆ ዒንሢሲ ዓይጋ ዒንሢ ጋፒሳይ?","poem":2},{"lineBreak":true},{"text":"ሃሢ ታ ጋዓ ባኮ ኮሺ ዋይዚጋፓ ኮሺ ማዔ ሙዖ ሙዑዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዶኦሪንቴ ኮዦ ሙዖ ሙይ ዎዛዹዋቴ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«ዋዮ ዒንሢሲ ቡሊ ታ ባንሢ ዑኩዋቴ፤","poem":1},{"text":"ሼምፔና ናንጋኒ ቃኣሎ ታኣሲ ዋይዙዋቴ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ዳውቴ ናሽኬሢጉዲ","poem":2},{"lineBreak":true},{"text":"ዒንሢም ጉሙርቂንታያ ማዒ ናሽካኒ","poem":2},{"lineBreak":true},{"text":"ናኣናና ናንጋ ጫኣቁሞ ዒንሢና ታ ጫኣቃንዳኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዓካሪ ታኣኒ ዒዛ ሜሌ ዴሮም ማርካ፥","poem":1},{"text":"ሱኡጌ፥ ቢታንቶና ዎይሣያኣ ማሄኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኔኤኒ ዔሩዋ ካኣቶ ኔ ዔኤላንዳኔ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ማዔ ኔ ፆኦዛሢ","poem":2},{"lineBreak":true},{"text":"ዒስራዔኤሌኮዋ ዱማዼሢ ኔና ዼግ ዼጊዴሢሮ","poem":2},{"lineBreak":true},{"text":"ኔና ዔሩዋ ካኣታ ሩኡሪና ኔ ባንሢ ሙካንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ናንጊና ናንጋ ጎዳ ጴዻ ዎዶማና ዒዛ ኮዑዋቴ፤","poem":1},{"text":"ዒዚ ዑኬ ዓኣማና ዒዛ ዔኤሉዋቴ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ፑርቶ ዓሳ ፔኤኮ ሃንቲፆ","poem":1},{"text":"ጎሞ ዓሳኣ ፔኤኮ ፑርቶ ማሊፆ ሃሾንጎ፤","poem":2},{"lineBreak":true},{"text":"ማኣሪፃ ዒዛኮ ሚርጌታሢሮ ዓቶም ዒ ጋዓንዳጉዲ","poem":2},{"lineBreak":true},{"text":"ሃንጋ ናንጊና ናንጋ ኑ ጎዳ ባንሢ ዔያታ ሙኮንጎ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ታኣኮ ማሊፃ ዒንሢ ማሊፆጉዲ","poem":2},{"lineBreak":true},{"text":"ታ ጎይፃኣ ዒንሢ ጎይፆጉዲቱዋሴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጫሪንጫ ሳዓፓ ዼጋሢጉዲ","poem":1},{"text":"ታኣኮ ጎይፃ ዒንሢ ጎይፃፓ","poem":2},{"lineBreak":true},{"text":"ታ ማሊፃኣ ዒንሢ ማሊፃፓ","poem":2},{"lineBreak":true},{"text":"ሚርጌና ዼግ ጌዔያኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«ዒርዚና ሻቺና ጫሪንጫፓ ኬዲ","poem":1},{"text":"ሳዖ ዎዒሲ ዓኣፒ ዓኣፓንዳጉዲ ማሃሢ","poem":2},{"lineBreak":true},{"text":"ዜርፆ ዜርቃሢም ዜርሢ","poem":2},{"lineBreak":true},{"text":"ሙዓሢም ካሣ ጴዺሹዋዖ ሌካ ማዑዋሢጉዲ፥","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ዻንጋፓ ኬስካ ቃኣላ ዬያጉዴያኬ፤","poem":1},{"text":"ማዻንዳጉዲ ታኣኒ ዳኬ ማዾ ማዹዋዖ","poem":2},{"lineBreak":true},{"text":"ኪኢቲንቴ ኪኢቶዋ ማዺ ኩንሡዋዖ ታ ባንሢ ማዓዓኬ።»","poem":2}]},{"type":"verse","number":12,"content":[{"text":"«ዒንሢ ባብሎኔ ዓጫፓ ዎዛና ኬስኪ","poem":1},{"text":"ኮሺና ዒንሢ ዓጮ ማዓንዳጉዲ ታ ማዻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዹኮና ጌሜሮና ዒንሢኮ ቤርታ ዓይናዺ ኮኦማንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ካዮ ሚፃኣ ቢያ ኩቺ ባዓንዳኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዓንጊፆ ቤዛ ዚቢቂ፥ ጋውዶ ቤዛ","poem":1},{"text":"ቤርሴኔቴ ጌይንታ ሚፃ ባቃላንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዬይ፥ ናንጊና ናንጋ ጎዳ ቤርቶይዳ","poem":2},{"lineBreak":true},{"text":"ዒዛ ማዾ ጶቂሣ ማላታ ማዒ","poem":2},{"lineBreak":true},{"text":"ናንጊና ባይቁዋዖ ዴዓንዳኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}