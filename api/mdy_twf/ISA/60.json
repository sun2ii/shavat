{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"ISA","translationId":"mdy_twf","name":"ዒሲያሴ ማፃኣፖ","commonName":"ዒሲያሴ ማፃኣፖ","title":"ዒሲያሴ ማፃኣፖ","order":23,"numberOfChapters":66,"sha256":"0585110711ab765bb8ad52ae6d6c3dab40fe368c20e71e6d5dd66f2fb946a5fd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mdy_twf/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":60,"content":[{"type":"heading","content":["ዬሩሳላሜ ሃጊ ቦንቺንታንዳ ቦንቾ"]},{"type":"verse","number":1,"content":[{"text":"ዬሩሳላሜ!","poem":1},{"text":"ፖዓ ኔኤኮ ሙኬሢሮ ዔቂጋፓ ፖዒሤ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳኮ ቦንቻ ኔ ጊዳ ፖዓኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሳዖ ቢያ ዹሚ፥ ሻኔ ዹሚያ ሜሌ ዴሮ ካንቃንዳኔ፤","poem":1},{"text":"ጋዓንቴ ናንጊና ናንጋ ጎዳ ኔ ጊዳ ፖዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ቦንቻ ኔኤም ፔጋዺ ጴዻንዳኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሜሌ ዴራ ሃንጋ ኔኤኮ ፖዖ ባንሢ","poem":1},{"text":"ካኣታኣ ኔኤኮ ፆርቂ ኬስኬ ዓቦ ባንሢ ሙካንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ዼጊ ጌዒጋፓ ኔኤኮ ኮይሎይዳ ዓኣ ባኮ ዛጌ!","poem":1},{"text":"ቢያሢ ቡኪንቲ ኔ ባንሢ ሙካንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዓቲንቆ ናኣታ ኔኤኮ ሃኬ ዓጪዳፓ ዬዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዉዱሮ ናኣታኣ ኔኤኮ ሾኦጴይዳ ቃልሲንቲ ሙካንዳኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኔኤኒ ዬያ ዛጊጋፓ ዎዛና ሙስታንዳኔ፤","poem":1},{"text":"ዼኤፖ ባዞይዳፓ ጴዻ ዓንጆና","poem":2},{"lineBreak":true},{"text":"ዴሮይዳፓ ጴዻንዳ ቆላኣ ኔኤሮ ማዓንዳሢሮ","poem":2},{"lineBreak":true},{"text":"ዒናፓ ማዔ ሚርጌ ዎዛ ኔኤኒ ዎዛዻንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ሚኢዲያሜና ዔፖ ዓጮናፓ","poem":1},{"text":"ሙካ ጋኣላሢ ሳዖ ኔኤኮ ኩማንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዎርቄንታ ዑንጆንታ ዔኪ ሳኣባ ዓጮይዳፓ","poem":2},{"text":"ሙኬ ዓሳ ቢያ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ዼጊ ጌዔ ዑኡሲና ጋላታንዳኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ቄዳሬ ጌይንታ ዓጮኮ ማራታ ቢያ ኔ ባንሢ ሙካንዳኔ፤","poem":1},{"text":"ኔባዮቴ ዓጮይዳ ዓኣ ዓዶ ማራታ ሚቺ ዒንጎ ዒንጊፆም ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒንጊፆ ታኣም ሺኢሾ ቤዞይዳ ታና ዎዛሳ ዒንጊሢ ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ቦንቺንቴያ ማዔ ታኣም ዱማዼ ማኣሮ ታኣኒ ሚዛጲሳንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ዶኦላ ፔኤኮ ማኣሮ ባንሢ ባራናሢጉዲ","poem":1},{"text":"ሻኣሬያ ሴካ ሃንጋ ሃንታሢጉዲ","poem":2},{"lineBreak":true},{"text":"ዬንሢ ሃንታዞንሢ ዖናንሢዳይ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዒዚ ኔና ቦንቺሴሢሮ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ማዔ ኔ ፆኦዛሢ ሱንፆና","poem":2},{"lineBreak":true},{"text":"ዒስራዔኤሌኮ ዱማዼሢ ቦንቻኒ","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ናኣቶ ሃኬ ዓጮይዳፓ","poem":2},{"lineBreak":true},{"text":"ዔያቶኮ ቢሮና ዎርቆና ዎላ ዔኪ ሙካኒ","poem":2},{"lineBreak":true},{"text":"ዋኣፆ ሳዞ ዓጮንታ ቴርሴሴኮ ዋኣፆ ካኣሚሎንታ","poem":2},{"lineBreak":true},{"text":"ቤርታዺ ጊኢጊ ካፓኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ታኣኒ ታ ዻጎና ሜቶ ኔና ሄሊሴኔ፤","poem":1},{"text":"ሃሢ ጋዓንቴ ታኣኒ ኔኤም ሚጪንታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሜሌ ዓጮ ዴራ ኬኤሎ ዲፆ ኔኤኮ ጊንሣ ኮሻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶኮ ካኣታኣ ኔኤም ማዻንዳኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኔኤኮ ጌሎ ካራ ቢያ ዎዴ ቡሊንቴያ ማዓንዳኔ፤","poem":1},{"text":"ሮኦሮታቴያ ዋኣንቶ ፔቴታዖ ዎዺንታዓኬ፤","poem":2},{"lineBreak":true},{"text":"ዬይ ያዺ ማዓንዳሢ ዴሮኮ ቆሎንታ","poem":2},{"lineBreak":true},{"text":"ዲዒንቴ ካኣቶንታ ዔኪ ዬዒ ጌልዛኒኬ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኔኤም ዓይሢንቲ ማዹዋ ዴሮና ካኣቶና ጋዓንቴ ጋፒ ባይቃንዳኔ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ታኣኮ ጌኤዦ ማኣራ ዓኣ ቤዞ ሚዛጲሳኒ","poem":1},{"text":"ሊባኖኦሴ ዓጮኮ ቦንቾ ማዔ ዚቢቆንታ","poem":2},{"lineBreak":true},{"text":"ዴኤሎይዳ ዓኣ ዓስታ ጌይንታ ሚፆንታ ዚቢቆንታ","poem":2},{"lineBreak":true},{"text":"ዔያታ ኔኤም ዔኪ ሙካንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒያ ታኣኮ ቶካ ሄርቃ ቤዞ ቦንቻንዳኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኔና ሄርቂ ዎይሣ ዓሶኮ ዜርፃ ኔ ባንሢ ሙካንዳኔ፤","poem":1},{"text":"ቦንቾ ዔኤሊሢያ ኔና ዔኤላንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ኔና ቶኦቼ ዓሳ ቢያ ኔኤኮ ቶኮ ዴማ ጉምዓታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ኔና፦ «ዒስራዔኤሌኮ ዱማዼ፥ ናንጊና ናንጋ ጎዳ ካታሞ ፂዮኔ!» ጋዓንዳኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"«ሃያኮ ቤርታ ሃሺንቴያና ዒፂንቴያ","poem":1},{"text":"ዓይጎ ዓሲያ ኔጊዴና ዓኣዹዋያ ኔ ማዔያታቴያ","poem":2},{"lineBreak":true},{"text":"ናንጊና ሄርሺንቶያና ሙካ ሾይንቶኮ ቢያ","poem":2},{"lineBreak":true},{"text":"ዎዛ ቤሲ ታ ኔና ማሃንዳኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ናይ ፔኤኮ ዒንዶ ዻንፆ ዻንቃሢጉዲ","poem":1},{"text":"ኔ ናኣታ ዴሮንታ ካኣቶንታኮ ቆሎ ዔኪ","poem":2},{"lineBreak":true},{"text":"ዔያቶሮ ማሃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኒያ ታኣኒ ናንጊና ናንጋ ጎዳ፥ ኔና ዓውሳሢታሢ","poem":2},{"lineBreak":true},{"text":"ያይቆኦቤኮዋ ዼኤፖ ፆኦዛሢ ማዔሢ ዔራንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«ታኣኒ ሞኦኖ ዓንጎ ቤዞ ዎርቄ","poem":1},{"text":"ዓንጎ ቤዞ ቢራ ዓንጊ","poem":2},{"lineBreak":true},{"text":"ሚፆ ቤዞ ሞኦና ዓንጊ","poem":2},{"lineBreak":true},{"text":"ሹጮ ቤዞ ዓንጊ ዔኪ ሙካንዳኔ።","poem":2},{"lineBreak":true},{"text":"ኮሹሞ ዓዳ ኔና ዎይሣ ቢቲ ማሂ","poem":2},{"lineBreak":true},{"text":"ፂሉሞ ዓዳ ኔኤኮ ሱኡጌ ማሂ ታ ጌሣንዳኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሃካፓ ሴካ ሳዖይዳ ኔኤኮ ዋይዚ ዒፂሢ ዑኡሲ","poem":1},{"text":"ኔኤኮ ዛጶይዳ ባይሲንታ ሃንጎ ሻሂንቲሢ ዋይዚንታዓኬ፤","poem":2},{"lineBreak":true},{"text":"ጋዓንቴ ኬኤሎ ዲሮ ኔኤኮ ኔ ‹ዻቂንታ›","poem":2},{"lineBreak":true},{"text":"ኬኤሎ ዲሮ ካሮዋ ‹ጋላታ› ጌይ ኔ ሱንሢ ጌሣንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«ሃካፓ ሴካ ሮኦሮና ዓቢ ኔኤም ኮይሱዋሴ፤","poem":1},{"text":"ዋኣንቶ ዓጊኒ ኔኤም ፖዓዓኬ፤","poem":2},{"lineBreak":true},{"text":"ጋዓንቴ ናንጊና ናንጋ ጎዳ ኔኤኮ ፖዓሢ","poem":2},{"lineBreak":true},{"text":"ፆኦዛሢያ ኔኤኮ ቦንቾ ማዓንዳኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ናንጊና ናንጋ ጎዳ ኔኤም ፖዔ ጎይሣ ናንጋንዳሢሮ","poem":1},{"text":"ዓባ ኔኤኮ ፔቴታዖ ጌላዓኬ፥ ዓጊናኣ ፖዒፆ ሃሻዓኬ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ሜታሢ ዎዳ ጋፓንዳኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዴራ ኔኤኮ ፂሎ ማዓንዳኔ፤","poem":1},{"text":"ዓጬሎዋ ናኣናና ዔያቶሮ ማሂ ዻካላንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ታና ዔያታ ጋላታንዳጉዲ ታኣኒ ዔያቶ ማዤኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ዔያቶ ባቃልሲ ቱኬያኬ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ኔኤኮ ዻካ ፃጲ ማዔዞንሢ ሚርጌ ሺያና ፓይዲንታ ዴሬ ማዓንዳኔ፤","poem":1},{"text":"ቢያፓ ጋፒንሢ ላኣፓ ማዔዞንሢ ዎልቄና ዓኣ ካኣቶ ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ናንጊና ናንጋ ጎዳ ዬይ ዎዳ ሄላዛ","poem":2},{"lineBreak":true},{"text":"ዬያ ሩኡሪና ማዺ ኩንሣንዳኔ» ጌዔኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/ISA/59.json","previousChapterAudioLinks":{},"numberOfVerses":22}