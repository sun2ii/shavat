{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"ISA","translationId":"mdy_twf","name":"ዒሲያሴ ማፃኣፖ","commonName":"ዒሲያሴ ማፃኣፖ","title":"ዒሲያሴ ማፃኣፖ","order":23,"numberOfChapters":66,"sha256":"0585110711ab765bb8ad52ae6d6c3dab40fe368c20e71e6d5dd66f2fb946a5fd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mdy_twf/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":61,"content":[{"type":"heading","content":["ዻቂንታ ዛላ ኬኤዛ ኮሺ ሃይሴ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳኮ ዓያና ታኣና ዓኣኔ፤","poem":1},{"text":"ማንቆ ዓሶም ኮዦ ሃይሶ ታ ኬኤዛንዳጉዲ","poem":2},{"lineBreak":true},{"text":"ዒዚ ታና ዶኦሚ ቲሽኬኔ፤","poem":2},{"lineBreak":true},{"text":"ዒና ሜቄዞሢ ታ ኮኦላንዳጉዲ","poem":2},{"lineBreak":true},{"text":"ዲዒንቲ ዔውቴ ዓሶም ዓይላታፓ ኬስኪሢ","poem":2},{"lineBreak":true},{"text":"ቱኡቲ ዓኣ ዓሶም ቡሊንቲሢ","poem":2},{"lineBreak":true},{"text":"ሃይሴ ታ ኬኤዛንዳጉዲ ዒ ታና ዳኬኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ናንጊና ናንጋ ጎዳኮ ማኣሪፆ ሌዖና","poem":1},{"text":"ኑ ፆኦዛሢ ኮሞ ኮፃንዳ ኬሎ ዛሎዋ ታ ኬኤዛንዳጉዲ","poem":2},{"lineBreak":true},{"text":"ዬኤካ ዓሶ ቢያ ታ ዶዲሻንዳጉዲ","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ፂዮኔይዳ ዖያ ዓሶም ኮይሳ ባኮ ዒንጋንዳጉዲ","poem":1},{"text":"ዲቢንፆ ቤዛ ሚዛጶ ቶኦካ ዓጎ ባኮ ታ ዔያቶም ዓጋንዳጉዲ","poem":2},{"lineBreak":true},{"text":"ዬኤፖ ቤዛ ዎዛሳ ዛይቶ ቲዦ ዔያቶ ቶኦካ ታ ዋሃንዳጉዲ","poem":2},{"lineBreak":true},{"text":"ዖያ ዓያኖ ቤዛ ጋላታ ዓይኑሞ ታ ዒንጋንዳጉዲ ዒዚ ታና ዳኬኔ።","poem":2},{"lineBreak":true},{"text":"ዔያታ ዒዛኮ ቦንቾ ፔጋሳያ ማዓንዳጉዲ","poem":2},{"lineBreak":true},{"text":"«ናንጊና ናንጋ ጎዳ ቱኬ ፂሎ ሻኣቢ» ዔያታ ጌይንታንዳኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዔያታ ሚና ዶዒ ሻሂንቴ ካታሞ ማሂ ማዣንዳኔ፤","poem":1},{"text":"ቤርታዺ ጋፒ ባይቄ ባኮ ጊንሣ ዔያታ ኮሻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ኬስኬ ኬስኬ ሾይንቶና ሻሂንቴ ካታሞ ዔያታ ዓካሳንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ሜሌ ዓጫፓ ሙኬ ዴራ ዒንሢኮ ቆልሞ ሄንቃንዳኔ፤","poem":1},{"text":"ጎዦዋ ዒንሢኮ ዔያታ ጎሽካንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዎይኖዋ ዔያታ ኮሺ ኮሺ ካፓንዳኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዒንሢ ጋዓንቴ «ናንጊና ናንጋ ጎዳኮ ቄኤሶ» ጌይንታንዳኔ፤","poem":1},{"text":"ዓሳኣ ዒንሢ «ፆኦሲም ማዻዞንሢ» ጋዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዴሮኮ ቆሎ ዔኪ ዒንሢ ዎዛዻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶ ዖርጎቼ ባኮ ዒንሢሮ ማሂጋፓ ዒንሢ ቦንቺንታንዳኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታ ዴራ ቦርሲንቴ ቤዞ ጳንጬ ቦንቾ ዴንቃንዳኔ፤","poem":1},{"text":"ዻውሲንቴ ቤዞዋ ዔያቶም ዒንጊቴ ባኮና ዎዛዻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶኮ ቤርታኣ ሳዖፓ ጳንጬ ማዔ ሳዓ ዔካንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ዎዛኣ ዔያቶም ማዓንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ታኣኒ ናንጊና ናንጋ ጎዳ ፒዜ ዎጌ ናሽካኔ፤","poem":1},{"text":"ቡሪሢና ፑርታ ማዾ ታ ዒዒፃኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ማዼሢ ዛሎ ዔያቶም ኮይሳሢጉዴያ ዒንጋንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶና ዎላ ናንጊና ናንጋ ጫኣቁሞ ታ ጫኣቃንዳኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዔያቶኮ ዜርፃ ካኣቶና","poem":1},{"text":"ናኣታኣ ዔያቶኮ ዴሮ ባኣካ ዔርቴያ ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዛጋ ዓሳ ቢያ ናንጊና ናንጋ ጎዳ ዔያቶ ዓንጄያታሢ ዔራንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ታኣኒ ናንጊና ናንጋ ጎዳና ኮሺ ዎዛዻኔ፤","poem":1},{"text":"ሼምፓሢ ታኣኮ ፆኦዛሢና ዎዛዻኔ፤","poem":2},{"lineBreak":true},{"text":"ዑኡታሢ ፔና ኮሻኒ ዓፒላ ቶኦካ ማራሢጉዲ","poem":2},{"lineBreak":true},{"text":"ዑኡቴላ ፔኤኮ ሚዛጶ ፓልማሢና ፓልሚንታሢጉዲ","poem":2},{"lineBreak":true},{"text":"ዻቂንታ ዓፒላ ታና ዒ ማይሴኔ፤","poem":2},{"lineBreak":true},{"text":"ፂሉሞ ማኣዖዋ ዒ ታ ዑፃ ቃሲ ቃሲ ኩሌኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሳዓ ዔኤቢ ባቃልሳሢጉዲ","poem":1},{"text":"ቱኮ ባኣዚ ቱኮ ጎዣ ዱማ ዱማ ሚፆ ዑጊሳሢጉዲ","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ፂሉሞንታ ጋላታንታ","poem":2},{"lineBreak":true},{"text":"ዴሮፓ ቢያ ዓልቃንዳጉዲ ማሃንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}