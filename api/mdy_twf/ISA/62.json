{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"ISA","translationId":"mdy_twf","name":"ዒሲያሴ ማፃኣፖ","commonName":"ዒሲያሴ ማፃኣፖ","title":"ዒሲያሴ ማፃኣፖ","order":23,"numberOfChapters":66,"sha256":"0585110711ab765bb8ad52ae6d6c3dab40fe368c20e71e6d5dd66f2fb946a5fd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mdy_twf/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":62,"content":[{"type":"heading","content":["ፂዮኔኮ ዓኮ ሱንፆ"]},{"type":"verse","number":1,"content":[{"text":"ዒዞም ዎጊንታንዳ ዎጋ ሳዓ ካሪሢጉዲ ፖዓንዳኣና","poem":1},{"text":"ዻቂንታ ዔኤታ ኩሻጉዲ ፖዒሳንዳያ ሄላንዳኣና","poem":2},{"lineBreak":true},{"text":"ታኣኒ ፂዮኔ ዛሎ ዚቲ ጋዓዓኬ፤","poem":2},{"lineBreak":true},{"text":"ዬሩሳላሜ ዛሎዋ ማሊፆ ሃሺ ሃውሻዓኬ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዴራ ኔኤም ዎጊንታ ዎጎ፥ ካኣታኣ ቦንቾ ኔኤኮ ዛጋንዳኔ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ኔኤም ጌሣ ዓኮ ሱንፆና ኔኤኒ ዔኤሊንታንዳኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኔኤኒ ናንጊና ናንጋ ጎዳኮ ኩጮይዳ ዓኣ","poem":1},{"text":"ካኣታ ቶኦካ ዓጋ ቦንቾ ባኮጉዲ ማዓንዳኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሃካፓ ሴካ ኔ «ሃሺንቴዞ» ጌይ ዔኤሊንታዓኬ፤","poem":1},{"text":"ሳዓኣ ኔኤኮ «ጉሪ ቤሲ» ጌይንቲንዱዋሴ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ዔኤሊንታንዳ ዓኮ ሱንፃ፦","poem":2},{"lineBreak":true},{"text":"«ናንጊና ናንጋ ጎዳ ኔኤና ዎዛዻኔ» ጌይንታያ ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሳዔላኣ ኔኤኮ «ዓኒ ዓኣያ» ጌይንታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ኔኤና ዎዛዻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሳዔላ ኔኤኮ ዓኒ ዓኣ ላኣሊጉዲ ማዓንዳኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዼጌ ኩሙሢ ዉዱሮ ናይ ዔኪ ዑኡታዻሢጉዲ","poem":1},{"text":"ኔኤኮ ናኣታ ኔና ዔካንዳኔ፤","poem":2},{"text":"ዑኡታሢ ዑኡቴሎ ዔኬሢሮ ዎዛዻሢጉዲ","poem":1},{"lineBreak":true},{"text":"ፆኦሲ ኔኤና ዎዛዻንዳኔ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ዬሩሳላሜ! ኔኤኮ ኬኤሎ ዲፆ ዑፃ ካፓ ዓሶ ታ ዴይሤኔ፤","poem":1},{"text":"ሮኦሮንታ ዋኣንቶንታ ፔቴታዖ ዔያታ ዚቲ ጋዓዓኬ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢ ናንጊና ናንጋ ጎዳ ሺኢቃዞንሢ","poem":2},{"lineBreak":true},{"text":"ሃውሺ ዚቲ ጌይፖቴ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዬሩሳላሜ ዒ ጊንሣ ማዣንዳያ ሄላንዳኣና","poem":1},{"text":"ዓጮ ቢያይዳ ዔርቴ ካታማ ዒዞ ዒ ማሃንዳያ ሄላንዳኣና","poem":2},{"lineBreak":true},{"text":"ሃውሹዋዖ ዒዛም ኬኤዙዋቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳ ፔኤኮ ዎልቄና ቢታንቶና ሂዚ ጌዒ ጫኣቄኔ፦","poem":1},{"text":"«ሃካፓ ሴካ ሃኣኮ ኔኤኮ ሞርካ ሙዓንዳጉዲ ታ ዒንጋዓኬ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ላቤ ዎይኖ ዑዦ ኔኤኮ ሜሌ ዓጫፓ ሙኬ ዓሳ","poem":2},{"lineBreak":true},{"text":"ዑሽካንዳጉዲ ታ ማሃዓኬ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጋዓንቴ ኮና ዔያታ ዋሄ ሃኣኮ ፔኤሮ ሙዒ","poem":1},{"text":"ታና ናንጊና ናንጋ ጎዳ ጋላታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዎይኖ ቲቂ ዔኪ ኮሼ ዎይኖ ዑዦ ዔያታ ፔኤሮ","poem":2},{"lineBreak":true},{"text":"ዓሳ ቡካ፥ ታኣም ዱማዼ ጶኦካ ዑሽካንዳኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጌሎ ዲሮ ካሮ ባንፆና ዓኣዹዋቴ፤","poem":1},{"text":"ዓሶም ጎይፆ ጊኢጊሹዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዳልጎ ጎይፆዋ ኮሹዋቴ፤","poem":2},{"lineBreak":true},{"text":"ሹጮዋ ቡጊ ኬሱዋቴ፤","poem":2},{"lineBreak":true},{"text":"ባንዴሮዋ ዴሮም ዼጊዲ ሱፁዋቴ።»","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዓጮም ቢያ፦","poem":1},{"text":"«ዓውሳሢ ኔኤኮ ሙካኔ፤","poem":2},{"lineBreak":true},{"text":"ማዼሢ ዛሎ ዓሶም ዒዚ ጪጋንዳያና ዒንጋንዳ ባኮ ዔኪ ዬዓኔ","poem":2},{"lineBreak":true},{"text":"ጌዒ ፂዮኔ ዉዱሮ ናዔሎም ኬኤዙዋቴ» ጌዔኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዬኖ ዎዶና ዔያታ፦ «ፆኦሲም ዱማዼ ዴሬ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ዓውሴዞንሢ» ጌይንታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ኮይንታያ፥ ሃካፓ ሴካ ሃሺንቱዋ ካታማ ጌይንታንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}