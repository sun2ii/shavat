{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JDG","translationId":"mdy_twf","name":"ሱኡጎ ማፃኣፖ","commonName":"ሱኡጎ ማፃኣፖ","title":"ሱኡጎ ማፃኣፖ","order":7,"numberOfChapters":21,"sha256":"03974fe3e33bef131ee4aa634fc87c9ed1a14a66a6ee76a228bea51e387818bc","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/mdy_twf/JDG/21.json","totalNumberOfVerses":614},"chapter":{"number":5,"content":[{"type":"heading","content":["ዲቦራንታ ባርቄንታ ዓይናዼ ዓይኑሞ"]},{"type":"verse","number":1,"content":["ዬኖ ኬሎ ዲቦራና ዓቢኢኒያሜ ናኣዚ ባርቄና ሂዚ ጌይ ዓይናዼኔ፦"]},{"type":"verse","number":2,"content":[{"text":"ናንጊና ናንጋ ጎዳም ጋላታ!","poem":1},{"text":"ዒስራዔኤሌ ዓሳ ዖሎ ዖላኒ","poem":2},{"lineBreak":true},{"text":"ጉቤ ዒናፓ ዔቄኔ፤","poem":2},{"lineBreak":true},{"text":"ዴራኣ ዎዛዺ","poem":2},{"lineBreak":true},{"text":"ፔ ማሊሢና ናሽኪ ዔቄኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዒንሢ ካኣታ ዎዛዹዋቴ!","poem":1},{"text":"ዒንሢ ዎይሣ ዓሳኣ ዒና ዔኪ ዋይዙዋቴ!","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢም","poem":2},{"lineBreak":true},{"text":"ታ ዓይናዻንዳኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ሴዒሬ ዹካፓ ኔ ዔቃኣና","poem":2},{"lineBreak":true},{"text":"ዔዶኦሜ ዓጫፓ ኔ ኬስካኣና","poem":2},{"lineBreak":true},{"text":"ሳዓ ዓጊፄኔ፤","poem":2},{"lineBreak":true},{"text":"ጫሪንጫፓ ዒርዚያ ዋርቄኔ።","poem":2},{"lineBreak":true},{"text":"ሂዮ! ዋኣፃ ሻኣሮይዳፓ","poem":2},{"lineBreak":true},{"text":"ሊካ ሾኦቴኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሲና ዹኮ ፆኦዛሢ ቤርቶይዳ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ቤርቶይዳ","poem":2},{"lineBreak":true},{"text":"ዹካ ዓጊፄኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ዓናቴ ናኣዚ ሻምጋኣሬንታ ያዔላንታ ዎዶና","poem":1},{"text":"ሲሳራ ዓጮኮ ኮርሞ ዓሳ","poem":2},{"lineBreak":true},{"text":"ዬኖ ዓጮና ዴንዱዋሴ፤","poem":2},{"lineBreak":true},{"text":"ጎይፆ ዴንዳ ዓሳኣ ዓኣሺንቲ","poem":2},{"lineBreak":true},{"text":"ሺርሻ ጎይሢና ዴንዳኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዔናኣሬ ዲቦራ! ዒስራዔኤሌ ካታማ","poem":1},{"text":"ዓሲባኣያ ማዔኔ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ዒስራዔኤሌኮ ዒንዶ ማዒ","poem":2},{"lineBreak":true},{"text":"ዔቄ ዎዶ ሄላንዳኣና","poem":2},{"lineBreak":true},{"text":"ዒዛ ባዔ ማዒኬ ዴዔሢ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዒስራዔኤሌ ዓሳ ቤርታ ዔያታ ዔሩዋ","poem":1},{"text":"ሜሌ ፆኦሲ ዶኦሬ ዎዶና","poem":2},{"lineBreak":true},{"text":"ዓጬሎይዳ ዖልዚ ኬስኬኔ፤","poem":2},{"lineBreak":true},{"text":"ዖይዲታሞ ሺዮ ዒስራዔኤሌ ዓሶይዳፓ","poem":2},{"lineBreak":true},{"text":"ጊቲማና ዎርሢና ዓርቂ ኬስኬ ዓሲ ፔቴታዖ ባኣሴ!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዒና ታኣኮ ዒስራዔኤሌ ፖኦሊሶ ዓይሣዞንሢናኬ፤","poem":1},{"text":"ዬያጉዲ ዎዛና ናሽኪ ዔቄ ዓሶናኬ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳም ጋላታ!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዒንሢ ኮኦሪንቴ ቦኦሬ ሃሮ ቶጋ","poem":1},{"text":"ኮኦሮ ዑፃ ጌሦና ሚዛጶ ባኮይዳኣ ጊኢጊ ዴዔ ዓሳ፤","poem":2},{"lineBreak":true},{"text":"ሃሣ ጊንሣ ዒንሢ ቶኮና ሃንታ ዓሳ","poem":2},{"lineBreak":true},{"text":"ዬያ ባኮ ኬኤዙዋቴ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሂንዳ ዋይዙዋቴ!","poem":1},{"text":"ዋኣፆ ዱዎ ዔቶ ኮይላ ዋይዚንታ","poem":2},{"lineBreak":true},{"text":"ሚርጌ ዓሶኮ ዑኡዛ","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ዖሎና ባሼሢ ዔርዛያኬ፤","poem":2},{"lineBreak":true},{"text":"ሃሣ ዒስራዔኤሌ ዓሶኮዋ ባሺፆ ኬኤዛያኬ።","poem":2},{"lineBreak":true},"ዬካፓ ናንጊና ናንጋ ጎዳኮ ዴራ ፔኤኮ ካታማፓ ካታማፓ ኬስኪ ካታሞ ጌሎ ካሮ ባንሢ ኬዴኔ።"]},{"type":"verse","number":12,"content":[{"text":"ዲቦራ ዔቄ! ዔቄ!","poem":1},{"text":"ዔቄ! ዓይኑሞዋ ዓይናዼ!","poem":2},{"lineBreak":true},{"text":"ዓቢኒዔሜ ናዓሦ፥ ባርቄ ዔቄ!","poem":2},{"lineBreak":true},{"text":"ሞርኮ ዲዓኒ ዔቂ ቤርታ ዴንዴ!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዬካፓ ጉሙርቂንታያ ማዔ ዓሳ ቢያ","poem":1},{"text":"ፔኤኮ ሱኡጎ ባንሢ ኬዴኔ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳኮ ዴራ ዖሎም ጊኢጊንቲ","poem":2},{"lineBreak":true},{"text":"ዒዛ ባንሢ ሙኬኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ፖኦሊሳ ዔፕሬኤሜፓ፥ ጊንሣ ሃሣ ዓማሌቄፓኣ ሙኬኔ፤","poem":1},{"text":"ሃንጎዋታ ሃሣ ቢኢኒያሜፓ ሙኬኔ።","poem":2},{"lineBreak":true},{"text":"ፖኦሊሶ ዓይሣ ዓሳ","poem":2},{"lineBreak":true},{"text":"ማኪሬፓ ኬዲ ሙኬኔ፤","poem":2},{"lineBreak":true},{"text":"ዖሎኮ ሱኡጋኣ ዛብሎኦኔፓ ኬዴኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዪሳኮኦሬ ዓሶ ሱኡጋ ዲቦራና ዎላ ሙኬኔ፤","poem":1},{"text":"ሂዮ! ዪሳኮኦሬንታ ባርቄንታ ሙኬኔ፤","poem":2},{"lineBreak":true},{"text":"ዶኦጮ ባንሢያ ዔያቶ ጊንፆ ዴንዴኔ።","poem":2},{"lineBreak":true},{"text":"ጋዓንቴ ሮኦቤኤሌ ዓሳ ላምዖ ቤሲ ፓቂንቲ","poem":2},{"lineBreak":true},{"text":"«ዴንዶሞ ሃሾይ?» ጌይ ዔያታ ማሌኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዔያታ ፔ ማራቶና ዎላ ዓይጋ ኔጌይ?","poem":1},{"text":"ማራቶ ጊንቾ ዑኡዞ ዋይዛኒዳ?","poem":2},{"lineBreak":true},{"text":"ሂዮ! ሮኦቤኤሌ ዓሳ ላምዖ ፓቂንቴኔ፤","poem":2},{"lineBreak":true},{"text":"«ዴንዶሞ ሃሾይ?» ጌይ ዔያታ ማሌኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ጋኣዴ ዓሳ ዮርዳኖሴ ሱካ ዓቴኔ፤","poem":1},{"text":"ዳኣኔ ዓሳኣ ዋኣፆ ካኣሚሎ ኮይላ ዓቴኔ፤","poem":2},{"lineBreak":true},{"text":"ዓሴኤሬ ዓሳ ባዞ ዓጫ ዓቴኔ፤","poem":2},{"lineBreak":true},{"text":"ዋኣፆ ካኣሚላ ዔቃ ቤዞይዳ ዴዔኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዛብሎኦኔንታ ኒፕታኣሌኤሜንታ ዴራ ጋዓንቴ","poem":1},{"text":"ፔ ሼምፓሢ ሚጪንቱዋዖ ጌሜሮይዳ ዖልቴኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ዋኣፃ ዓልቃ ቤዞ ሜጌዶይዳ","poem":1},{"text":"ካኣታ ሙኪ ታዕናኬይዳ ዖልቴኔ፤","poem":2},{"lineBreak":true},{"text":"ሃሣ ካኣናኔ ካኣታኣ ዖልቴኔ፤","poem":2},{"lineBreak":true},{"text":"ሹጮ ቢሮ ዔያታ ዲዒ ዔኪባኣሴ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ጫሪንጮይዳ ዓኣ ዦኦጋሢ ሃንታዖ","poem":1},{"text":"ሲሳራና ዎላ ዖልቴኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ቂሶኔ ዎራ ፒፂ ዔያቶ ዴንዴኔ፤","poem":1},{"text":"ዬይ ሚናኣ ቂሶኔ ዎሮ ዲጳ ዔያቶ ሙዔኔ፤","poem":2},{"text":"ታኣኒ ጫርቂ ቤርቲም ዴንዳንዳኔ!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ዖሎ ፓራሢ ቦጎድ ቦጎድ ጌይ ሙኬኔ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ናንጊና ናንጋ ጎዳኮ ኪኢታንቻ ኬኤዛዖ፦","poem":1},{"text":"«ሜሮዜ ጋዳንቁዋቴ!","poem":2},{"lineBreak":true},{"text":"ዒኢካ ናንጋ ዓሶ ቢያ ጋዳንቁዋቴ!","poem":2},{"lineBreak":true},{"text":"ዔያታ ናንጊና ናንጋ ጎዳ ዛላ ዔቂባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ዒዛ ዛሎ ዖልታኒያ ኬስኪባኣሴ» ጌዔኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ቄና ዓሢ ሄቤሬ ማቻ ያዔላ","poem":1},{"text":"ላኣሎ ቢያይዳፓ ባሼ ዓንጂንቴያ ማዖም፤","poem":2},{"lineBreak":true},{"text":"ዓፒሎና ማዦና ማኣሮይዳ ናንጋ ዓሶፓ","poem":2},{"lineBreak":true},{"text":"ቢያ ባሼ ዓንጂንቴያ ማዖም።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ሲሳራ፦ «ዋኣሢ ታና ዑሼቴራ?» ጋዓዛ","poem":1},{"text":"ዒዛ ጋዓንቴ ዲኢቂ ዒዛም ዒንጌኔ፤","poem":2},{"lineBreak":true},{"text":"ሚዛጶ ዓንዶና ሜጲ ዒዛ ዒንጌኔ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዬያጉዲ ጊንሣ ፔቴ ኩጫ ፃውኖ","poem":1},{"text":"ሚዛቆ ኩጮና ጊታሢኮ ሞቶሾ ዔኪ","poem":2},{"lineBreak":true},{"text":"ሲሳራኮ ቶኦኮ ዒዛ ጳርቂ ዳኣፄኔ፤","poem":2},{"lineBreak":true},{"text":"ዋዮ ጩኡሞናኣ ጳርቂ ፃጴኔ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዒዚ ዒዞኮ ቶኮ ዴማ ባሺንቲ ሎኦሜኔ፤","poem":1},{"text":"ዒኢካ ዒዚ ሎኦሚ ላሄኔ፤","poem":2},{"lineBreak":true},{"text":"ሎኦሜ ቤዛ ዒማካ ዒ ሃይቄኔ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ሲሳራኮ ዒንዳ ፔ ማኣሮኮ ፑልቶና ዛጌኔ፤","poem":1},{"text":"ፑልቶ ካሮ ጎኦቦና ባኮኮ ፂኢኖና ሂርጊ ዒዛ ዛጋዖ","poem":2},{"lineBreak":true},{"text":"«ታናዖኮ ሳርጌሎ ዖይታ ዎይቲ ኔጌይ?","poem":2},{"lineBreak":true},{"text":"ፓራሢኮ ሹቁሎ ካኣና ዎይቲ ባይቄይ?» ጌይ ዒዛ ዖኦጬኔ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ዔሮ ላኣላ ዒዞም ማሂ ኬኤዜኔ፤","poem":1},{"text":"ዒዛ ጋዓንቴ ሂዚ ጌይ ማሌኔ፦","poem":2}]},{"type":"verse","number":30,"content":[{"text":"«ዔያታ ሄኤዶ ዲዒ ዔኮና ባኮ ጊሽታኣናንዳኔ፤","poem":1},{"text":"ፖኦሊሶፓ ፔቴ ዓሲም ፔቴ ሃንጎ ላምዖ","poem":2},{"lineBreak":true},{"text":"ዉዱሮ ናይ ዔያታ ዒንጋያ ናንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሲሳራም ዔያታ ሚዛጲ ማኣዖ ዒንጋንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሃሣ ታኣማኣ ዔያታ ባቃና ታ ማይንታንዳ","poem":2},{"lineBreak":true},{"text":"ማይሊ ኮሾና ማኣዖ ዔኪ ሙካንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ኔኤኮ ሞርኮ ቢያ ዬያይዲ ባይዜ፤","poem":2},{"lineBreak":true},{"text":"ኔና ናሽካ ዓሳ ጋዓንቴ","poem":2},{"lineBreak":true},{"text":"ፆፆርቃ ዓቢጉዲ ፖዖንጎ።","poem":2},{"lineBreak":true},"ዬካፓ ዓጬላ ዖይዲታሚ ሌዔ ዖልዚባኣያ ኮሺ ዴዔኔ።"]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}