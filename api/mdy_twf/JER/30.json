{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JER","translationId":"mdy_twf","name":"ዔርሚያሴ ማፃኣፖ","commonName":"ዔርሚያሴ ማፃኣፖ","title":"ዔርሚያሴ","order":24,"numberOfChapters":52,"sha256":"5604058f21af97969cc402711a0db5fd05508098ef46263753fb50976ed4124c","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/mdy_twf/JER/52.json","totalNumberOfVerses":1338},"chapter":{"number":30,"content":[{"type":"heading","content":["ዒስራዔኤሌ ዴራ ማዒ ሙካንዳያ ማዒፃ ኬኤዚንቴሢ"]},{"type":"verse","number":1,"content":["ዒስራዔኤሌኮ ፆኦሲ ማዔ ናንጊና ናንጋ ጎዳ ታኣም ሂዚ ጌይ ኬኤዜኔ፤ ዒስራዔኤሌ ፆኦሲ ማዔ ናንጊና ናንጋ ጎዳሢ ሂዚ ጋዓኔ፦"]},{"type":"verse","number":2,"content":["«ታ ኔኤም ኬኤዜ ባኮ ቢያ ማፃኣፔይዳ ፃኣፔ።"]},{"type":"verse","number":3,"content":["ታኣኮ ዴሮ ዒስራዔኤሌንታ ዪሁዳ ዴሮንታ ጊንሣ ማሂ ታኣኒ ዔኪ ዬዓንዳ ዎዳ ዑኬኔ፤ ዔያቶኮ ቤርታኣ ዓዶንሢም ታኣኒ ዒንጌ ዓጮ ታ ዔያቶ ማሃንዳኔ፤ ዔያታ ጊንሣ ዬያ ዓጮ ፔ ዓጪ ማሃንዳኔ፤ ዬያ ጌዔሢ ታና፥ ናንጊና ናንጋ ጎዳኬ።»"]},{"type":"verse","number":4,"content":["ናንጊና ናንጋ ጎዳ ዒስራዔኤሌና ዪሁዳ ዴሮናም ሂዚ ጋዓኔ፦"]},{"type":"verse","number":5,"content":[{"text":"«ኮሺ ዑኢሲቱዋንቴ ካራ ባይቂ","poem":1},{"text":"ዒጊቹሞና ጎጋይቂሢ ዑኡሲ ታኣኒ ዋይዛኔ፤","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሂንዳ ጫክ ጌይ ማሉዋቴ!","poem":1},{"text":"ዓቲንቄ ባኒ ናይ ሾዓ?","poem":2},{"text":"ሂዳዖ ዓቲንቃ ቢያ ሾሾዓ ላኣሊጉዲ","poem":1},{"text":"ፔኤኮ ኩጮና ጎጶ ዓርቂ ዓኣንቴ ታ ዛጋሢ ዎይቲዳይ?","poem":2},{"lineBreak":true},{"text":"ፔቴ ፔቴ ዓሶኮ ዓኣፖ ካራ ዎይቲ ቦኦሬይ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዬና ኬላ ዎዚ ሜታሳያ ማዓንዳይ!","poem":1},{"text":"ዬኖጉዴ ኬሊ ሜሌ ባኣያ ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ያይቆኦቤም ዬይ ሜቶ ዎዴ ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ያዺ ማዔቴያ ዔያታ ዬያ ዋኣዪፃፓ ቢያ ዻቃንዳኔ።»","poem":2}]},{"type":"verse","number":8,"content":["ቢያ ባኮ ማዤ ጎዳ ሂዚ ጋዓኔ፦ «ዬኖ ኬላ ሄላኣና ታኣኮ ዴሮኮ ባቃና ዓጊ ዎይሦ ቃምባሮ ታኣኒ ሜንሣንዳኔ፤ ዔያታ ቱኪንቴ ካኖ ቢራቶዋ ታኣኒ ዱኡዛንዳኔ፤ ዬካፓ ዔያታ ሜሌ ፃንጎ ማዔ ዴሮም ዓይሌ ማዒ ዎርቃዓኬ፤"]},{"type":"verse","number":9,"content":["ጋዓንቴ ታና፥ ዔያቶኮ ፆኦዛሢም ዔያታ ዚጋንዳኔ፤ ታኣኒ ካኣቱሞ ዖይቶይዳ ጌሣ፥ ዳውቴ ዜርፆ ማዔ ዔያቶኮ ካኣቲም ዔያታ ዎርቃንዳኔ።»"]},{"type":"verse","number":10,"content":[{"text":"«ታኣም ማዻ፥ ያይቆኦቤ ዒጊጪፖ፤","poem":1},{"text":"ዒስራዔኤሌ ዲቃቲፖ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ኔና ሃኬ ማዔ ዓጮይዳፓ","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ዜርፆዋ ዲዒንቲ ዴንዲ ዓኣ ሳዖይዳፓ ዓውሲ ዔኪ ማሃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ያይቆኦቤ ማዒ ሙኪ ሂርጋ ባኣያ ኮሺ ናንጊ ናንጋንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒዛ ዒጊቻንዳ ባኣዚያ ባኣሴ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታኣኒ ታኣሮ ዒንሢና ዎላ ማዒ ዒንሢ ዓውሳንዳኔ፤","poem":1},{"text":"ታኣኒ ዒንሢ ዜርቂ ዔያቶ ባኣኮ ዳኬ ዴሮ ታኣኒ ባይዛንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢ ጋዓንቴ ታኣኒ ባይዛዓኬ፤","poem":2},{"lineBreak":true},{"text":"ያዺ ማዔቴያ ሜቶ ታ ዒንሢዳ ዓጉዋ ሃሻዓኬ፤","poem":2},{"lineBreak":true},{"text":"ታ ዒንሢዳ ሜቶ ዓጋንዳሢ ዒንሢ ዻቤ ጎይፆጉዴያኬ፤","poem":2},{"text":"ዬያ ጌዔሢ ታና፥ ናንጊና ናንጋ ጎዳኬ።»","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ኪፃ ዒንሢኮ ፓፁዋያ","poem":2},{"lineBreak":true},{"text":"ዒንሢ ጋፒ ማኣሳኔኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዒንሢ ዛሎ ሞኦታንዳ ዓሲ ባኣሴ፤","poem":1},{"text":"ዒንሢ ኪፆኮ ዼኤሻኣ ጴዻዓኬ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢ ዻቃዓኬ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዒንሢ ማኣዲ ዖላ ዓሳ ቢያ ዒንሢ ዋሌኔ፤","poem":1},{"text":"ዔያታ ዒንሢ ኮዑዋሴ፤","poem":2},{"lineBreak":true},{"text":"ጎማ ዒንሢኮ ዺቢ፤","poem":2},{"lineBreak":true},{"text":"ፑርቱማኣ ዒንሢኮ ዑሣ ዓኣዼ ሚርጌሢሮ","poem":2},{"lineBreak":true},{"text":"ታ ዒንሢ ታኣኮ ሞርኬጉዲ ጳርቄኔ፤","poem":2},{"lineBreak":true},{"text":"ሚጪንቱዋዖ ታ ዒንሢዳ ሜቶ ዓጌኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ጎማ ዒንሢኮ ዺቢ፤","poem":1},{"text":"ፑርቱማ ዒንሢኮ ዑሣ ዓኣዼ ሚርጌሢሮ","poem":2},{"lineBreak":true},{"text":"ፓፃንዳ ካራ ዒንሢ ባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ዬያሮ ዒንሢኮ ኪፆ ዛሎ ጉንዱሚፖቴ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ዬያይዲ ዒንሢ ሜቶይዳ ዓጋንዳኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጋዓንቴ ጋኣሺ ዒንሢ ሙዔ ዓሳ ቢያ","poem":1},{"text":"ዔያታኣ ፔኤሮ ጋኣሺንቲ ሙይንታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢኮ ሞርካ ቢያ ዲዒንቲ ዔውታንዳኔ፤","poem":2},{"text":"ዒንሢ ቡራ ዓሳ ቢያ ቡሪንታንዳኔ።","poem":1},{"text":"ዒንሢዳፓ ሳሪ ዔቦ ዔኬ ዓሳ ቢያ","poem":2},{"lineBreak":true},{"text":"ዒማይዲ ሳሪንቲ ዔውታያ ማዓንዳኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዒንሢኮ ሞርካ፦ ‹ፂዮኔ ኬኤሪንቲ ዓቴኔ፤","poem":1},{"text":"ዒዞም ኮሺ ባኣዚ ማዻያኣ ባኣሴ› ጌዔቴያ፥","poem":2},{"text":"ታኣኒ ጊንሣ ዒንሢኮ ዒቢሎ ማሃንዳኔ፤","poem":1},{"text":"ኪፆዋ ታ ዒንሢኮ ፓፂሳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያ ጌዔሢ ታና፥ ናንጊና ናንጋ ጎዳኬ።»","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ዒስራዔኤሌ ናኣቶኮ ማኣሮ ጊንሣ ታኣኒ ማዣንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ፔቴ ፔቴ ማኣሮ ታኣኒ ሚጪንቲ ማኣራንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዬሩሳላሜ ካታማ ላሚ ጊንሣ ማዢንታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ካኣቱሞ ማኣራ ጊንሣ ሚናኣ ቤዛ ማዢንታንዳኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዒኢካ ናንጋ ዴራ ቢያ","poem":1},{"text":"ጋላታ ዓይኑሞ ዓይናዻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዎዛናኣ ዒሊሻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ታ ዔያቶ ዺዺቢሻንዳኔ፥ ፓይዳ ዔያቶኮ ዻካዓኬ፤","poem":2},{"lineBreak":true},{"text":"ታ ዔያቶ ቦንቺሳንዳኔ፤ ዬካፓ ዔያታ ቦሂንታዓኬ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዔያቶኮ ናኣታ ቤርታኣ ዓዶንሢጉዲ ዒጊጪንቲ ናንጋንዳኔ፤","poem":1},{"text":"ዔያታ ዎላ ናንጋ ናንጋኣ ታ ቤርታ ዶዲ ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶ ሄርቂ ዎይሣ ዓሶ ቢያ ታኣኒ ሜቶይዳ ዓጋንዳኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዔያቶኮ ዒጊኒ ዔያቶ ባኣካፓ ዔቂ","poem":1},{"text":"ዔያቶኮ ሱኡጌ ማዓንዳኔ፤","poem":2},{"text":"ታኣኒ ታኣሮ ዒዛ ዔኪ ዬዓንዳሢሮ ታ ባንሢ ዒዚ ዑካንዳኔ፤","poem":1},{"text":"ያዺ ማዒባኣቴ ዖኦኒ ጫርቂ ዑካኒ ዳንዳዓይ?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዒንሢ ታ ዴሬ ማዓንዳኔ፤","poem":1},{"text":"ታኣኒያ ዔያቶኮ ፆኦሲ ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያ ጌዔሢ ታና፥ ናንጊና ናንጋ ጎዳኬ።»","poem":2}]},{"type":"verse","number":23,"content":["ዓልጎ ዢባሬጉዲ ማዔ፥ ጎዳኮ ዻጋ ዶዲ ዢባሬጉዲ ዢባርሺ ፑርቶ ዓሶ ዑፃ ዬዓንዳኔ።"]},{"type":"verse","number":24,"content":["ናንጊና ናንጋ ጎዳኮ ዼኤፖ ዻጋ ማዻኒ ማሌ ባኮ ማዺ ኩንሡዋዖ ጊንሣ ማዓዓኬ፤ ዬይ ዎዳ ሄላዛ ዴራ ፔኤሮ ዬያ ቢያ ፔጌና ዔራንዳኔ።"]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}