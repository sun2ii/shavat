{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JER","translationId":"mdy_twf","name":"ዔርሚያሴ ማፃኣፖ","commonName":"ዔርሚያሴ ማፃኣፖ","title":"ዔርሚያሴ","order":24,"numberOfChapters":52,"sha256":"5604058f21af97969cc402711a0db5fd05508098ef46263753fb50976ed4124c","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/mdy_twf/JER/52.json","totalNumberOfVerses":1338},"chapter":{"number":47,"content":[{"type":"heading","content":["ፒሊስፄኤሜ ዛሎ ኬኤዚንቴ ፆኦሲ ማሊሢ"]},{"type":"verse","number":1,"content":["ጊብፄ ካኣቲ ጋኣዛ ዖላንዳሢኮ ቤርታ ናንጊና ናንጋ ጎዳ ፒሊስፄኤሜ ዓጮ ዛሎ ሂዚ ጌይ ታኣም ኬኤዜኔ፤"]},{"type":"verse","number":2,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ሃይሾ፥ ኬዶ ዛላፓ ዺቢ ዋኣሢ","poem":2},{"lineBreak":true},{"text":"ዎርዚ ኩኩሜ ዲጲጉዲ ዎታኔ፤","poem":2},{"lineBreak":true},{"text":"ዬይ ዋኣፃ ሳዖና ሳዖይዳ ዓኣ ባኮ ቢያ","poem":2},{"text":"ካታሞንታ ዒኢካ ናንጋ ዴሮንታ ቢያ ዔኤዻንዳኔ።","poem":1},{"text":"ዒማና ዴራ ቢያ ማኣዶ ዴንቃኒ ዒላታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሳዖይዳ ናንጋ ዓሳኣ ቢያ ዒኔ ሜቂ ዬኤካንዳኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጳሽኪ ሙካ ፓራሢ ቶኮኮ ዑኡዞይዳፓ ዔቄያና፤","poem":1},{"text":"ሞርኮ ሳርጌሎ ዖይቶኮ ሺራሢ ዋይዚሳ ዑኡዞፓ ዔቄያና፤","poem":2},{"lineBreak":true},{"text":"ሃሣ ዬይ ሳርጌሎ ዖይታ ጎዒ ሙካሢ ዔያታ ዛጋዖ","poem":2},{"lineBreak":true},{"text":"ናኣቶኮ ዓዶንሢ ዎልቃ ዔያቶኮ ጌሌም ላባንዳሢሮ","poem":2},{"lineBreak":true},{"text":"ፔኤኮ ናኣቶታዖ ዓውሳኒ ሺሪ ጊንሢም ዛጋዓኬ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ፒሊስፄኤሜ ባይቃንዳ ዎዳ ሄሌኔ፤","poem":1},{"text":"ሃይቁዋዖ ቶሊ ዓቲ ፂሮሴና ሲዶናና ማኣዳንዳ ዓሳ ቢያ","poem":2},{"lineBreak":true},{"text":"ካኣሙዋያ ማዒ ሃኬ ሃኬ ዴዓንዳ ዎዴ ዑኬኔ።","poem":2},{"text":"ታኣኒ፥ ናንጊና ናንጋ ጎዳ ሃይቦፓ ዓቲ ባዞ ዓጫ ዓኣ","poem":1},{"text":"ካፕቶኦሬ ዜርፆ ማዔ ፒሊስፄኤሜ ዓሶ ቢያ ባይዛንዳኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጋኣዛ ዓጮ ዴራ ዖዪ ፔኤኮ ቶኦኮ ሜኤዳንዳኔ፤","poem":1},{"text":"ዓስቄሎና ዓሳ ዚቲ ጋዓንዳጉዲ ማዺንታንዳኔ።","poem":2},{"lineBreak":true},{"text":"ፒሊስፄኤሜ ዶኦጮይዳ ባይሲንቶፓ ቶሊ ዓቲ ዓኣ ዓሳ","poem":2},{"lineBreak":true},{"text":"ዑፆ ፔኤኮ ቲሊንጎና ቲቂ ቲቂ ዖያሢ ዎማ ሄላንዳኣናዳዖ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"‹ናንጊና ናንጋ ጎዳኮ ጬንቾ ዓራፓሦ! ማዾ ሃሺ ኔ ሃውሻንዳ ዎዳ ዓይዲዳይ?","poem":1},{"text":"ሃዳራ ኔኤኮ ጎንጎኖ ጋሮ ጌሊ ሃውሼ› ጌይ ጌይ ዒንሢ ዒላታንዳኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ጋዓንቴ ታኣኒ፥ ናንጊና ናንጋ ጎዳ ዒዛም ዒንጌ ማዾ ኩርሱዋዖ ዎይቲ ዒዚ ሃውሻንዳይ?","poem":1},{"text":"ዓስቄሎናና ባዞ ዓጮናይዳ ናንጋ ዓሶ ኩርሳንዳጉዲ ዒዛ ታኣኒ ዓይሤኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}