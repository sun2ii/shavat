{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"«ናንጊ ታና ዒሤኔ፤","poem":1},{"text":"ታ ሃሢ ናንጋ ጫንጮ ናንጎ","poem":2},{"lineBreak":true},{"text":"ፔጌና ታ ዋይዚሲ ኬኤዛኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ፆኦሲ ታ ሂዚ ጋዓንዳኔ፦","poem":1},{"text":"ኔ ታና ዓርቄ ባካ ዓይጎናታቴያ","poem":2},{"lineBreak":true},{"text":"ፔጋሲ ታኣም ዻዻዋንዳፓዓቴም","poem":2},{"lineBreak":true},{"text":"ዻቢንቴያኬ ጌይ ዎዎጊፖ!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሃያይዲ ኔ ዒዛ ሜታሳሢ ኮይሳያዳ?","poem":1},{"text":"ኔኤኒ ኔ ኩጮና ማዤ ዓሢ ቶኦቻኒ ኔኤም ኮይሳ?","poem":2},{"lineBreak":true},{"text":"ፑርቶ ዓሶኮ ጌኖ ማሊፃ ኔና ዎዛሳ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኔ ዓኣፓ ዓሲ ዓኣፒጉዲዳ?","poem":1},{"text":"ኔ ዛጋሢ ዓሲ ዛጋ ጎይሢዳ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኔ ኬላ ዓሲ ኬሊጉዴያዳ?","poem":1},{"text":"ሃሣ ሌዓ ኔኤኮ ዓሲ ሌዔጉዲ ቃሚሢዳ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታ ዻቢንቶ ኔ ዛጋሢ፥","poem":1},{"text":"ጎሞዋ ኔ ታኣኮ ኮጲሳሢ ዓይጎሮዳይ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታኣኒ ዻቢንቲ ባኣያ ማዔሢና ኔ ኩጫፓኣ ታና","poem":1},{"text":"ዖኦኒያ ዻቂሻኒ ዳንዳዑዋኣሢ ኔ ዔራኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«ጪጊቺንታ ማሎንታ ዒንጊ ታና ኮሼሢ ኔ ኩጮኬ፤","poem":1},{"text":"ዓካሪ ሃሢ ዬንሢ ኔ ኩጮንሢ ጊንሣ ታና ሻሃንዳ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዓጪና ኮሾና ሜሄጉዲ ዓጪፓ ኔ ታና ኮሼሢ ማሌ፤","poem":1},{"text":"ሂዳዖ ሃሢ ጊንሣ ኔ ታና ሲላሊ ማሂ ጋኣጫኒዳ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዓዳ ዲኢቂጉዲ ዋኣፂሲ","poem":1},{"text":"ሜቄ ዲኢቂ ጉዴያኣ ኔ ታና ሜቂሴኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዑፆ ኔ ታኣኮ ዒልዒና ዓሽኪና ማሂ ካንቄኔ፤","poem":1},{"text":"ሜጌሢና ሻሺና ማሂያ ካንሢ ኔ ኮሼኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሼምፔንታ ናንጊና ናንጋ ናሹሞዋ ኔ ታኣም ዒንጌኔ፤","poem":1},{"text":"ኔኤኮ ካፒፃኣ ዓያኖ ታኣኮ ዶዲሼኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሃይሾ ዬያ ባኮ ኔ ዒና ኔ ዓኣቺ ዓርቄኔ፤","poem":1},{"text":"ኔኤኮ ማሊፃ ዬያ ማዔሢ ታ ዔሬኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዻቢንቲ ታ ማዼቴ ኔ ታና ዛዛጋኔ፤","poem":1},{"text":"ታኣኮ ጎሞሮዋ ኔ ፑርታና ዎጉዋዖ ሃሻዓኬ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ጎሜ ታ ማዼቴ ቤዞና ሜቶይዳ ታ ሎኦማኔ፤","poem":1},{"text":"ኮሺ ባኣዚ ታ ማዼቴያ ታ ጋላቲንቱዋሴ፤","poem":2},{"lineBreak":true},{"text":"ኮሺ ታኣኒ ሜታዼም","poem":2},{"lineBreak":true},{"text":"ቦርሲንቲ ታና ሄሌኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዒና ታኣኮ ጊንሣ ዶዴያ ማዔቴ","poem":1},{"text":"ዞቢጉዲ ኔ ታና ኬሚ ዓርቃኔ፤","poem":2},{"lineBreak":true},{"text":"ታና ባይዛኒ ኔ ዎልቆና ማዺንታ ዓኮ ባኮ","poem":2},{"lineBreak":true},{"text":"ላሚ ላሚ ኔ ማዻኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ታ ጊዳ ማርካዻንዳ ዓሲ","poem":1},{"text":"ቢያ ዎዴና ኔ ዴንቃኔ፤","poem":2},{"lineBreak":true},{"text":"ታ ጊዳ ኔ ዻጋዻ ዻጋ","poem":2},{"lineBreak":true},{"text":"ቃሲንቲ ቃሲንቲ ዓኣዻኔ፤","poem":2},{"lineBreak":true},{"text":"ኔ ታና ዖላኒ ቢያ ኬሊ ዓኪ ዓኪ ማሊሢ","poem":2},{"lineBreak":true},{"text":"ዖልዚ ዓሲጉዲ ኔ ዳካኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«ፆኦሲዮ! ዓይጋ ኔ ታኣኒ ሾይንታንዳጉዲ ማሄይ?","poem":1},{"text":"ዖኦኒያ ታና ዛጊባኣንቴ ታ ሃይቄያ ማዔቴ ኮሺታንቴኬ!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ማዢንቲ ባኣዖ ታ ዓታኣባሽ፤","poem":1},{"text":"ዒንዶ ጎጳፓ ኬኬስካዖ ዱኡፒ ባንሢ ታ ዔውቴቴ ቃራታዖኬ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ታ ናንጎ ዎዳ ቃሚሢቱዋዓዳ?","poem":1},{"text":"ዬማ ቃሚፆ ዎዶማካ ዻካታዎ ታ ዎዛዻንዳጉዲ","poem":2},{"text":"ሃዳራ ታና ሃሼቴራ!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ዬያ ኔ ሃሻንዳሢ ላሚ ታ ማዓኑዋ ቤዞ፥ ሃይቢ ሺቢና","poem":1},{"text":"ሻኔያ ማዔ ዓጮ ታ ዴንዳንዳሢኮ ቤርታኬ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ታ ዴንዳ ቤዛ ዹሚኮ ሺቢና ዣሎና ኩሜ ሳዓኬ፤","poem":1},{"text":"ዬካ ዓኣ ፖዓኣ ዹሞጉዴያኬ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}