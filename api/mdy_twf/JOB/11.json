{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":["ናዕማታ ዓጮ ዓሢ ፆፓሬ ሂዚ ጌዔኔ፦"]},{"type":"verse","number":2,"content":[{"text":"«ሃያ ቢያ ጉሪ ጌይንቴ ባኮኮ ማሂ ኬኤዛይ ባኣዓዳ?","poem":1},{"text":"ፔቴ ዓሲ ሃያጉዴ ጋፑዋ ባኣዚ ጌስቲሢና ፒዜ ማዓኒ ዳንዳዓ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዒዮቤ! ጉሪ ኔ ጌስቴ ባኮኮ ማሂ ኔኤም ኬኤዞንዶ ባኣዚ ባኣያ ማላ?","poem":1},{"text":"ሃያይዲ ኔ ቶኦቺ ጌስታዛ ኔና ጎራንዳ ዓሲ ባኣያ ኔኤም ማላ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኔኤኒ ኔ ማሊፆና፦ ‹ታኣኒ ፒዜኬ› ጋዓኔ፤","poem":1},{"text":"ፆኦሲማኣ ኔኤኒ፦ ‹ታ ኔ ቤርታ ጌኤሺኬ› ጋዓኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ፆኦሲ ኔኤም ማሂ","poem":1},{"text":"ፒዜ ማዔ ባኮ ኬኤዛቴ ዓይጎ!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዔራቶኮ ጎይሢ ሚርጌታሢሮ","poem":1},{"text":"ዔራቶኮ ዓኣሺንቴ ባኮ ኔና ፆኦሲ ዔርዜቴ ዓይጎ!","poem":2},{"lineBreak":true},{"text":"ዓካሪ ፆኦሲ ኔና ሜቶይዳ ዓጌሢ","poem":2},{"lineBreak":true},{"text":"ኔኤም ኮይሳሢዳፓ ዻኪሲ ማዔሢ ዔሬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«ፆኦሲ ዓኣቺ ዓርቄ ባኮ ኔ ዔራኒ ዳንዳዓ?","poem":1},{"text":"ቢያ ባኮ ዳንዳዓ ጎዳሢ ዎዚዒታቴያ","poem":2},{"lineBreak":true},{"text":"ማርማሪ ዔራኒ ኔ ዳንዳዓ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዒዛኮ ዼኤፑማ ጫሪንጮኮ ዑሣኬ፤","poem":1},{"text":"ኔ ዒዛ ዎዳኒ ዳንዳዓይ?","poem":2},{"lineBreak":true},{"text":"ሊካ ዔቱማ ዒዛኮ ዱኡፖ ዔታፓ ዴማኬ፤ ኔ ዓይጎ ዔራይ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፆኦሲኮ ዼኤፑማ ሳዖይዳፓ ባሼ ዖዶቃኔ፤","poem":1},{"text":"ዼኤፖ ባዞ ዋኣፃፓ ባሼ ዳልጋኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ፆኦሲ ሙኪ ቱኬቴ","poem":1},{"text":"ዎጎ ዎጋ ዓሶ ቤርቶዋ ሺኢሼቴ","poem":2},{"lineBreak":true},{"text":"ዖ ዒዛ ላኣጋንዳይ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ፆኦሲ ፓሡዋ ዓሶ ዔዔራኔ፤","poem":1},{"text":"ዻቢንቲ ዒ ዴንቄ ዎዶና ዚቲ ጌይ ዛጉዋሴ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዔኤያ ዓሲ ዔራ ማዓያይዳፓ","poem":1},{"text":"ኪርሞሌ ዓሲ ማዒ ሾይንታቴ ሼሌዔኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«ጋዓንቴ፥ ዒኖ ኔኤኮ ኔ ፒዜ ማሄቴ","poem":1},{"text":"ሃሣ ኩጮ ኔኤሲ ኔ ዔቂሲ ፆኦሲ ሺኢቄቴ","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ጎሞ ኔጊዳፓ ኔ ሃኪሴቴ","poem":1},{"text":"ፑርታ ባኣዚያ ኔ ማኣራፓ ኔ ባይዜቴ","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዬማ ዎዶና ኔ ዼግ ጌዒ","poem":1},{"text":"ቦርሲንቲባኣያ ቢያ ባኣዚ ኔ ዛጋንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሃሣ ዒጊቹሞ ባኣያ ዶዲ ኔ ዔቃኒ ዳንዳዓኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሜቶ ኔኤኮ ኔ ቢያ ዋላንዳኔ፤","poem":1},{"text":"ኔ ማሊ ጶቂሣንዳሢ ኩሚ ዓኣዼ","poem":2},{"lineBreak":true},{"text":"ዲጲጉዲ ሌሊኬ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ናንጋ ኔኤኮ ዓቢ ዹኡሲ ፖዒፓ ባሼ ፖዓንዳኔ፤","poem":1},{"text":"ዹማ ጊንሣ ሃሣ ጉታኣ ፖዒጉዲ ማዓንዳኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሃጊ ማዓንዳ ዎዛ ኔኤኮ ዓኣሢሮ ጉሙርቂ ኔ ናንጋንዳኔ፤","poem":1},{"text":"ፆኦሲ ኔና ካፓያታሢሮ ሂርጋባኣያ ሃውሺ ኔ ናንጋንዳኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዖናኣ ዒጊጩዋዖ ኔ ላሃንዳኔ፤","poem":1},{"text":"ሚርጌ ዓሲ ኔ ቤርታ ቦንቺንቲ ዴንቃኒ ኮዓንዳኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ፑርቶ ዓሶኮ ዓኣፓ ባይቃንዳኔ፤","poem":1},{"text":"ዔያታ ቶላንዳ ጎይፃ ዔያቶኮ ቢያ ዲርቂንቴያ ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶኮ ጋፒንፃኣ ሃይቢኬ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}