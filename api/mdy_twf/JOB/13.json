{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"«ሃይሾ፤ ሃያ ቢያ ታኣኮ ዓኣፓ ዛጊናኣኮኬ፤","poem":1},{"text":"ዋያኣ ታኣኮ ዋይዚ ዒና ዔኬኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዒንሢ ዔራሢጉዲ ታኣኒያ ዔዔራኔ፤","poem":1},{"text":"ፔቴታዖ ታ ዒንሢዳፓ ዻካያቱዋሴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጋዓንቴ ታኣኮ ጌኤዛ ዼኤፖ ፆኦዛሢናኬ፤","poem":1},{"text":"ታ ዒዛና ማርማኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዒንሢ ጋዓንቴ ሉኡዙሞና ኩሜያኬ፤","poem":1},{"text":"ዒንሢ ዼኤሻ ዔራያታዖ","poem":2},{"lineBreak":true},{"text":"ዖናኣ ዓውሳኒ ዳንዳዑዋ ዓሲጉዲኬ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሃያይዳፓ ዚቲ ዒንሢ ጌዔያታቴ","poem":1},{"text":"ዒንሢ ዔራ ማዒ ጴዻንዳያታዖኬ!»","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«ታኣኒ ማርማ ማርማሢ ዋይዙዋቴ፤","poem":1},{"text":"ታና ሄሌም ታኣኒ ሞኦታ ሞኦቶ ዚቲ ጌይ ዋይዙዋቴ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዓይጎሮ ዒንሢ ፆኦሲ ሱንፆና ሉኡዙሞ ጌስታይ?","poem":1},{"text":"ፆኦሲ ጌሺሢና ዒንሢ ዒዛ ዎዛሳያ ማላ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሃንጎ ዒዛ ዛላ ዒንሢ ማዓኒ ማላ?","poem":1},{"text":"ዒዛኮ ታርዤ ማዒ ዒንሢ ዔቃ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዒዚ ዒንሢ ባኮ ዛጋያ ማዔቴ","poem":1},{"text":"ዒንሢዳፓ ፔቴ ባኣዚታዎ ኮሺ ዒ ዴንቃንዳኣሲንታኔ?","poem":2},{"text":"ዓሶ ዒንሢ ዔኤያሳሢጉዲ","poem":1},{"text":"ዒዛ ዒንሢ ዔኤያሳንዳያ ዒንሢም ማላ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዴሜና ዓኣሺንቲ ዓሲ ዒንሢ ዱማሳያ ማዔቴ","poem":1},{"text":"ጎኔና ፆኦሲ ዒንሢ ጎራንዳኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዒዛኮ ቦንቻ ዒንሢ ዒጊቹዋዓዳ?","poem":1},{"text":"ዒዛኮ ዼኤፑማ ዒንሢ ዲቃሡዋዓዳ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዒንሢ ኮኦኪንሦና ጌስታ ጌኤዛ ፓሡዋያ ዲቢንሢጉዲኬ፤","poem":1},{"text":"ዒንሢኮ ማርማሢያ ዓጪዳፓ ኮሾና ሜሄጉዲ ሃይቃያኬ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሂንዳ ዚቲ ጎዑዋቴ፤","poem":1},{"text":"ታኣኒያ ጌስቶም ታኣም ቤሲ ጌሡዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዬካፓ ማዓ ባኣዚ ማዖንጎ። »","poem":2}]},{"type":"verse","number":14,"content":[{"text":"«ታኣኒ ዓጮ ዻይ ሜታዺ ናንጋሢ ዓይጎሮዳዖ?","poem":1},{"text":"ታኣኮ ዬያይዲፃ ታሼምፓሢ ባይዚ ማዓኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ፆኦሲ ታና ዎዼያታቴያ","poem":1},{"text":"ዒዛ ጉሙርቂፆ ታ ሃሻዓኬ፤","poem":2},{"lineBreak":true},{"text":"ያዺ ማዔቴያ ታ ዓኣ ጎይፆዋ ዒዛም ኬኤዛንዳኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጎሜና ዓኣ ዓሲ ፆኦሲ ቤርቶ ሺኢካኒ ዳንዳዑዋኣሢሮ","poem":1},{"text":"ጎዖንቴ ሃይ ታኣኮ ጫርሹማ ዻቂንታ ካራ ማዓኒ ዳንዳዓኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሂንዳ ታ ኬኤዛ ባኮ ዒና ዔኩዋቴ፤","poem":1},{"text":"ታ ሺኢሻ ማርካቶዋ ኮሺ ዋይዙዋቴ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ጌኤዞ ታኣኮ ኮይሳ ጎይፆ ዔኪ ታ ሺኢሼኔ፤","poem":1},{"text":"ታኣም ዎጊንታንዳሢያ ታ ጉሙርቃኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ታና ዎጎና ዓይሢሳ ዓሲ ዓኣያ ማዔቴ","poem":1},{"text":"ታ ማርሙዋዖ ዚቲ ጌይ ሃይቃንዳኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ፆኦሲዮ! ኔ ቤርታፓ ታ ዓኣሺንቱዋጉዲ","poem":1},{"text":"ሃንሢ ላምዖ ባኮንሢ ታኣም ማዼ፤","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዬንሢያ፦ ኔኤኮ ሜታሳ ኩጮ ታጊዳፓ ዔቂሴ፤","poem":1},{"text":"ኔኤኮ ዒጊቻያ ማዔ ዼኤፑሞና ታና ዲቃሢፖ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«ፆኦሲዮ! ቤርታዺ ኔ ኬኤዜ፤","poem":1},{"text":"ታ ኔኤኒ ኬኤዜ ባኮኮ ማሂፆ ኬኤዛንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሃንጎ ቤርታዺ ታ ኬኤዜም","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ታ ኬኤዜ ባኮኮ ማሂ ታኣም ኬኤዜ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ታ ማዼ ዻቢንቶና ጎሞና ዎማጉዴያዳይ?","poem":1},{"text":"ሂንዳ ታ ዻቢንቶና ጎሞና ታኣም ኬኤዜ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዓይጎሮ ታጊዳፓ ኔ ሃካይ?","poem":1},{"text":"ሃሣ ዓይጎሮ ታና ኔኤኮ ሞርኬ ማሂ ኔ ዛጋይ?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዢባሬ ዲኢኒሻ ዋላሺና ሜልዚ ጎቦናጉዲ","poem":1},{"text":"ዓይጋ ዒጊቺ ኔ ታና ዳውሳይ?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"«ኔ ታ ዑፃ ዻቢንቲኬ ጌዒ ኮሺ ጫንቺ ባኣዚ ፃኣፔኔ፤","poem":1},{"text":"ናይ ዓኣዖ ታ ዻቢንቴ ዻቢንቶታዖ ኔ ዓይሲባኣሴ፤","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ቶኮ ኔ ታኣኮ ዱፄና ቱኬኔ፤","poem":1},{"text":"ፔቴ ፔቴ ታ ሃንታ ሃንቲፆ ኔ ታኣኮ ፓይዳኔ፤","poem":2},{"lineBreak":true},{"text":"ታ ሄርቄ ኮጲዞዋ ኔ ዛጋኔ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ዬያሮ ታኣኒ ዎዔ ባኣዚ ማዒ ዓታኔ፤","poem":1},{"text":"ቢላ ሙዔ ማኣዖጉዲያኣ ታኣኒ ባይቃኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}