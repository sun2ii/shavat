{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"«ዓሲኮ ናንጎ ሌዖማ ቃሚሢኬ፤","poem":1},{"text":"ያዺታቴያ ሜታ ኩሜያኬ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ቡኒጉዲ ጴዻዖ ቤዞማና ዲኢናኔ፤","poem":1},{"text":"ሺቢጉዲ ሚርጌ ኔጉዋዖ ቤዛፓ ዑኬና ሺራኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዓካሪ ዬያጉዴ ዓሢ ኔ ኮጲሲ ሺራንዳያዳ?","poem":1},{"text":"ኔ ቤርቶ ዎጌም ኔ ሺኢሻንዳያዳ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዒኢቴ ባኣዚፓ ጌኤሺ ባኣዚ ዴንቃኒ ዳንዳዓ","poem":1},{"text":"ዓይጎ ዓሲያኣ ባኣሴ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዓሲኮ ናንጊ ሌዔ ዔርቲ ጌሢንቴያኬ፤","poem":1},{"text":"ናንጋ ዓጊናኣ ኔ ቤርታ ፓይዲንቴያኬ፤","poem":2},{"lineBreak":true},{"text":"ኔ ናንጋንዳጉዲ ጌሤማፓ ዑሣ ዓኣዻይ ባኣሴ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሚኢሾም ጌይ ማዻሢ ማዻ ኬሎ ጋፒሲ ሃውሻሢጉዲ","poem":1},{"text":"ዓሲያ ፔኤኮ ላቢፆ ዎዶይዳ ዎዛዻንዳጉዲ ጊቢ ዳንዳዔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«ቲቂንቴ ሚሢ ዱርሚኮታዖ","poem":1},{"text":"ሃጋ ማዓንዳ ዎዛ ዓኣኔ፤","poem":2},{"lineBreak":true},{"text":"ዎይቲ ጌዔቴ ላሚ ቶሻኒና","poem":2},{"lineBreak":true},{"text":"ካኣፒ ኬሳኒ ዳንዳዓሢሮኬ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዎዚ ፃጳ ሳዖ ዴማ ጋርቼቴያ፤","poem":1},{"text":"ሃሣ ዱርማ ዓጮ ዴማ ዎዔቴያ","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሳዓ ዎዒ ዴንቄቴ ጊንሣ ቶሻኔ፤","poem":1},{"text":"ሃጊ ቱቱኮና ሚሢጉዲ ካኣፒ ኬሳኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዓሲ ጋዓንቴ ሃይቃዖ ባኣያ ማዓኔ፤","poem":1},{"text":"ዒ ሃይቄስካፓ ማይ ዓንካዳይ?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«ዴዔ ዋኣሢ ሱኡሌና ዔቂ ጋፓሢጉዲ","poem":1},{"text":"ዎርዚ ዋኣሢያ ሚጫሢጉዲ","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዬያጉዲ ዓሲያኣ ሃይቄስካፓ ጊንሣ ማዑዋሴ፤","poem":1},{"text":"ጫሪንጫኣ ባይቃንዳያ ሄላንዳኣና ጴጩዋሴ፤","poem":2},{"lineBreak":true},{"text":"ጊንዓስካፓኣ ዔቁዋሴ።»","poem":2}]},{"type":"verse","number":13,"content":[{"text":"«ሄኤዶ ኔ ታና ዱኡፓ ዓኣቼያታቶ!","poem":1},{"text":"ዻጋ ኔኤኮ ጋፓንዳያ ሄላንዳኣና ኔ ታና ዓኣቼያታቶ!","poem":2},{"lineBreak":true},{"text":"ኬሊ ኔ ታኣም ሜንሢ ማሌያታቴ ዓይጎ!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዓሲ ሃይቄስካፓ ጊንሣ","poem":1},{"text":"ሼምፔና ናንጋኒ ዳንዳዓ?","poem":2},{"lineBreak":true},{"text":"ጊንሣ ታና ዓካሲ ኮሾንዶ ዎዳ ሄላንዳኣና","poem":2},{"lineBreak":true},{"text":"ሃያ ታኣኮ ማሹምባሢ ናንጎኮ ጋፒንፆ","poem":2},{"lineBreak":true},{"text":"ጊቢ ታ ካፓንዳኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዬኖ ዎዶና ኔ ታና ዔኤላንዳኔ፤","poem":1},{"text":"ታኣኒያ ኔኤም ዬሃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ማዢንቲ ማዔሢ፥ ታና ኔ ዛጋኒ ጶቂሣንዳኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሃሢ ኔ ታኣኮ ሃንቲፆ ቢያ ዛጋኔ፤","poem":1},{"text":"ጋዓንቴ ጎሞ ኔ ታኣኮ ዓርቁዋሴ።»","poem":2}]},{"type":"verse","number":17,"content":[{"text":"«ዔኤቢ ጋርካ ቱኪንቲ ኬኤሪንታ ቡኡራጉዲ","poem":1},{"text":"ዻቢንቶ ቢያ ታኣኮ ኔ ሺኢሻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ጎሞዋ ታኣኮ ኔ ባይዛንዳኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሃኖ ዓጮይዳ ጋዓንቴ","poem":1},{"text":"ዹኬ ዲኢሞ ዶዓሢጉዲ","poem":2},{"lineBreak":true},{"text":"ዼኤፖ ሹጫ ቤዛፓ ቡምባላሢጉዲ","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዋኣሢ ሹቺ ቦኦኪ ቦኦኪ ኩርሳሢጉዲ፤","poem":1},{"text":"ሃሣ ዼኤፒ ዒርዚያ ሳዖ ዛራሢጉዲ","poem":2},{"lineBreak":true},{"text":"ኔኤኒያ ላቤ ዓሲኮ ዬያጉዲ ሃጊ ማዓንዳ ዎዞ ባይዛኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኔኤኮ ዎልቃ ናንጊና ዒዛይዳ ዶዳኔ፤","poem":1},{"text":"ዒዚያ ባኣያ ማዓኔ፤","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ማላሢ ኔ ላኣሚ ኔ ቤርታፓ ባይዛኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዒዛኮ ናኣታ ቦንቾ ዴንቄቴያ ዒ ዔሩዋሴ፤","poem":1},{"text":"ዔያታ ዻውሲንቴቴያ ዒ ዴንቁዋሴ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዒዛም ዒዛ ዑፆ ሜታሢ ዔርታኔ፤","poem":1},{"text":"ዒዚ ፔ ቶኦኮ ሜታሢሮ ሌሊ ዬኤካኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}