{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":["ቴሜና ዓጮ ዓሢ፥ ዔልፓዜ ሂዚ ጌይ ማሄኔ፦"]},{"type":"verse","number":2,"content":[{"text":"«ሂንዳ ማሌ፤ ዔራ ዓሲ","poem":1},{"text":"ዢባሬጉዲ ዓርቂንቱዋ ባኣዚ ጌስታ?","poem":2},{"lineBreak":true},{"text":"ዓባ ኬስካ ባንፆ ዢባሮጉዲ ጉሪ ማሊሢ ዓኣያ ማዓኒ ኮይሳ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዔራ ዓሲ ዔኤቢ ፓሡዋ ጌኤሲና","poem":1},{"text":"ማኣዳ ባኣዚባኣ ሃይሴና ማርሚ ሺራ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሂዳያ ማዔቴ ፆኦሲ ዒጊቹሞ ኔኤኒ ሃሼኔ ጌይሢኬ፤","poem":1},{"text":"ሃሣ ሜሌ ዓሶዋ ፆኦሲ ካኣሽኩዋጉዲ ኔ ማሃያኬ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኔ ዻቢንቴያ ማዔሢ ኔኤኮ ጌኤዛፓ ዔርታኔ፤","poem":1},{"text":"ጋዓንቴ ጪንጩሞ ሃይሴና ዬያ ዓኣቺ ካንቃኒ ኔ ማላኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኔ ጊዳ ዎጋሢ ኔ ዒንዲርዞ ማዓንዳፓዓቴም ታናቱዋሴ፤","poem":1},{"text":"ኔ ጌኤዛ ኔና ፔጋሲ ዔርዛኔ። »","poem":2}]},{"type":"verse","number":7,"content":[{"text":"«ዓሲኮ ቤርታ ሾይንቴሢ ኔናዳ?","poem":1},{"text":"ዹካ ማዢንታንዳሢኮዋ ቤርታ ኔ ሾይንቲናኣኮዳ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ፆኦሲኮ ዓኣሺንቴ ባኮ ኔ ዋይዚናኣኮዳ?","poem":1},{"text":"ዓሲ ዔራ ባኣዚ ቢያ ዔራሢ","poem":2},{"lineBreak":true},{"text":"ኔና ሌሊ ኔኤም ማላ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኑ ዔራሢዳፓ ዱማ ኔ ዔራ ባካ ዓይጎዳይ?","poem":1},{"text":"ኑጊዳፓ ዓኣሺንቲ ኔኤም ፔጋዼ ዓይጎ ዔራቶ ዓኣይ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሾይንቶና ኔ ዓዶይዳፓ ባሻያ","poem":1},{"text":"ቶኦካ ቡኡቄ ጋርቻ","poem":2},{"lineBreak":true},{"text":"ማሊፆና ኑኡና ዎላኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«ኑ ዛሎና ኔኤም ኬኤዚንታ","poem":1},{"text":"ፆኦሲዳፓ ኔኤም ዒንጊንታ ዶዱማ ኔኤም ጊዳዓዳ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዒና ኔኤኮ ሜሌ ቤሲ ዓይጋ ዓኣዻይ?","poem":1},{"text":"ሃሣ ኔ ጎሪንቲ ዓይጋ ዓኣፖ ኔኤኮ ኬሳይ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ፆኦሲ ዑፃ ኔ ዻጋዻንዳጉዲ","poem":1},{"text":"ሃያጉዴ ባኣዚ ኔ ዻንጋፓ ኬስካንዳጉዲ","poem":2},{"lineBreak":true},{"text":"ኔና ማሄሢ ዓይጌንዴዳይ?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«ዓሲ ጌኤሺ ማዓኒ ዳንዳዓ?","poem":1},{"text":"ዓሲ ሾዔ ዓሲያኣ ፂሎ ማዓኒ ዳንዳዓ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ፆኦሲ ፔኤኮ ኪኢታንቾታዖ ጉሙርቁዋሴ፤","poem":1},{"text":"ጫሪንጫታዖ ዒዛ ቤርታ ጌኤሺቱዋሴ፤","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዓካሪ ፑርቱሞ ዋኣሢጉዲ ዑሽካያ","poem":1},{"text":"ዒሣያና ዒኢቴ ዓሲ","poem":2},{"lineBreak":true},{"text":"ዎዲ ጉሙርቂንታንዳይ?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«ዒዮቤ! ሂንዳ ዋይዜ ታ ኔኤም ኬኤዛንዳኔ፤","poem":1},{"text":"ታኣኒ ዔራ ባኮ ቢያ ኔና ዔርዛንዳኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዔሮ ዓሳ ፔ ዓዶንሢዳፓ ዔኬሢ","poem":1},{"text":"ዓኣቹዋዖ ዔያታ ታኣም ኬኤዜ ባኮ ታ ኔኤም ኬኤዛኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዓጬላ ዔያቶም ሌሊ ዒንጊንቴኔ፤","poem":1},{"text":"ሜሌ ዓጪ ዓሲ ዔያቶ ባኣካ ዔያቶና ዎላ ሲኢሪንቲባኣሴ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«ዓሲ ሄርቂ ዎይሢ ናንጌ ፑርታ ዓሲ","poem":1},{"text":"ዒ ዓኣ ዎዶማና ሜታ ዒዛይዳፓ ሺኢኩዋሴ፤","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዒዛኮ ዋዮይዳ ዲቃሣ ሃይሴ ቢያ ዎዴ ዋይዚንታኔ፤","poem":1},{"text":"‹ታ ኮሺ ናንጋኔ› ጌዒ ማላ ዎዶና ሱላ ዒዛይዳ ሜቶ ዓጋኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ጬንቾ ዓፓሮና ዎዻ ዓሳ ዒዛ ካፓሢሮ","poem":1},{"text":"ዹማፓ ቶላኒ ሃጊ ማዓ ዎዛ ዒዛኮ ባኣሴ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዒዛኮ ዓሽካ ሃምፑራሢኮ ሙኡዚ ማዓኔ፤","poem":1},{"text":"ዬይ ዓሢ ዹማ ዒዛም ዑኬሢ ዔራኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ማሊ ሜታዺሢና ዖዪሢና ዒዛ ዒጊቻኔ፤","poem":1},{"text":"ዖላኒ ጊኢጌ ካኣቶጉዲ ዒዛይዳ ዔያታ ዎልቃዻኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"«ዎይቲ ጌዔቴ ዬይ ዓሢ ፆኦሲዳ ሻሎ ፔኤኮ ዻዌኔ፤","poem":1},{"text":"ቢያ ባኮ ዳንዳዓ ጎዳሢ ዒ ሄርቄኔ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዓንዲሪና ዶዲ ጊቲማ ዓርቂ","poem":1},{"text":"ፆኦሲ ቃዛኒ ዒ ኬስኬኔ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዓኣፖ ካራ ዒዛኮ ሃኣቤና ካንቂንቴኔ፤","poem":1},{"text":"ኬርና ዒዛኮ ዓንዲርሙሞና ሙሊንቴኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"«ዬይ ዓሢ ናንጋ ካታማ","poem":1},{"text":"ዖልዚና ሻሂንታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒ ናንጋ ማኣራኣ ባዓ ማዓኔ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ዖርጎቹሞና ዒ ሚርጌ ዎዴ ናንጋዓኬ፤","poem":1},{"text":"ቆላ ዒዛኮ ዒዛና ዎላ ኔጋዓኬ፤","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ዓኣ ባካ ሳዖይዳ ዳልጋዓኬ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ዹሚዳፓ ዒ ቶላኒ ዳንዳዑዋሴ፤","poem":1},{"text":"ካኣፓ ታሚና ሚጬያ፤","poem":2},{"lineBreak":true},{"text":"ፆኦሲኮ ዑኡዛኣ ዒዛ ጊልፒ ባይዜያ ማዓንዳኔ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ጉሪ ባኣዚ ጉሙርቂ ፔና ጌሾፓ፤","poem":1},{"text":"ዬያይዲፆና ዒ ጉሪ ማዒ ዓታኔ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ዎዴ ሄሊባኣንቴ ሹላያና","poem":1},{"text":"ካኣፓኣ ዋርቁዋ ሚሢ ዒ ማዓኔ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ሃጊ ካፂባኣንቴ ሶያፓ ዓኣፖ ፔኤኮ ዲኢኒሻ ዎይኔ ሚሢጉዲ፤","poem":1},{"text":"ሃሣ ጊንሣ ቡናኣ ዲኢና ዛይቶ ሪሚቶ ዒ ማዓኔ።»","poem":2}]},{"type":"verse","number":34,"content":[{"text":"«ፆኦሲ ዒጊጩዋ ዓሶኮ","poem":1},{"text":"ዜርሢ ኬስካዓኬ፤","poem":2},{"lineBreak":true},{"text":"ዴሚና ዔኮና ባኮና ማዦና ማኣሮዋ ታሚ ሙዓንዳኔ።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ዬያጉዴ ዓሳ ፑርቱሞ ማሊ ቱካኔ፤","poem":1},{"text":"ጌኔ ማዾዋ ማዺ ኩንሣኔ፤","poem":2},{"lineBreak":true},{"text":"ዒና ዔያቶሲ ጌሺሢ ማሊሢና ኩሜያኬ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}