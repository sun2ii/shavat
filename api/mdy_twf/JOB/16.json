{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":["ዬካፓ ዒዮቤ ሂዚ ጌይ ማሄኔ፦"]},{"type":"verse","number":2,"content":[{"text":"«ሃያ ማላ ሃይሴ ሚርጌ ዎዴ ታ ዋይዜኔ፤","poem":1},{"text":"ዒንሢ ታና ዶዲሻያ ማሊ ዖዪሢዳ ዖዪሢ ታኣም ቃሴኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሃያ ዒንሢኮ ፓሡዋ ጌኤዞኮ ጋፒንሢ ባኣያዳ?","poem":1},{"text":"ሃያይዲ ዒንሢ ታኣና ማርማንዳጉዲ","poem":2},{"lineBreak":true},{"text":"ዒንሢ ማሄሢ ዓይጎዳይ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዒንሢ ታ ቤዛ ማዔም","poem":1},{"text":"ታ ዎንዴ ዒንሢ ቤዛ ማዔያታቴ","poem":2},{"text":"ቦሂሢና ቶኦኮ ታኣኮ ታ ዓጊሢ ዓጊሢ፤","poem":1},{"text":"ሃሢ ዒንሢ ጋዓ ባኮ ቢያ","poem":2},{"lineBreak":true},{"text":"ዒንሢዳ ሚዛጲሲ ጌስታኒ ታ ዳንዳዔያ ናንዳንቴኬ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዬያጉዲ ሃሣ ታ ዒንሢ ዞሬያና","poem":1},{"text":"ዒንሢ ዶዲሻኒ ታ ሚርጌ ባኣዚ ጌስታኒ ዳንዳዔያ ናንዳንቴኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«ጋዓንቴ ሚርጌ ታ ጌስቴታቶዋ ሃርጋ ታኣኮ ሼሌዒንዱዋሴ፤","poem":1},{"text":"ዚቲ ጌይ ታ ጊቤቴያ ዋኣዪፃ ታኣኮ ጋፒንዱዋሴ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ፆኦሲዮ! ዓካሪ ኔ ታና ላቢሴኔ፤","poem":1},{"text":"ታኣኮ ማኣሮ ዓሶዋ ቢያ ኔ ባይዜኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዑፆኮ ታኣኮ ጉርሚፃ ማርካ ማዔኔ፤","poem":1},{"text":"ሜጌፆ ጴዺ ዖኦፒፃኣ ‹ኔ ጎሜ ዓሲኬ› ጌይ ታጊዳ ማርካዻኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፆኦሲ ዻጋዺ ዑፆ ታኣኮ ቲቄኔ፤","poem":1},{"text":"ታና ዒፂፆና ዓጮ ፔኤኮ ዒ ዻዔኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኮ ሞርካሢ ፔ ዓኣፖና ታና ጎዜኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዓሳ ታ ኮይላ ቡኪ ታና ሚኢጫኔ፤","poem":1},{"text":"ቦሂ ቦሂ ባዒያ ታና ባዓኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ፆኦሲ ፑርቶ ዓሶም ታና ዓኣሢ ዒንጌኔ፤","poem":1},{"text":"ዋይዞ ዒፃ ዓሶ ኩጫ ታና ኬኤሬኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኮሺ ታ ናንጋንቴ","poem":1},{"text":"ዒዚ ፔ ዻጎና ታና ሜንሤኔ፤","poem":2},{"text":"ባቃኖ ታኣኮ ዺዺ ዓርቂ ታና ጋኣጬኔ፤","poem":1},{"text":"ታና ዒ ባይዛኒ ታጊዳ ዔቄኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዒዛኮ ሂኢዦ ዓሳ ታና ማንጌኔ፤","poem":1},{"text":"ሚጪንቱዋዖ ጳላሢ ታኣኮ ዔያታ ዱኡዜኔ፤","poem":2},{"lineBreak":true},{"text":"ጪሾዋ ታኣኮ ዔያታ ሳዓ ላኣሌኔ፤","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ላሚ ላሚ ዒ ታና ዱኬኔ፤","poem":1},{"text":"ዶዲ ዖልዚ ዓሲ ማዒ ኮኦሚ ታጊዳ ዒ ሙኬኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታኣኮ ዖዪፃ ሚርጌሢሮ ሲዬ ማኣዖ ታ ማይንቴኔ፤","poem":1},{"text":"ባሺንቲ ታኣኒ ሲላሊዳ ሎኦሜኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሚርጌና ታ ዬኤኬሢሮ ዓኣፖ ካራ ታኣኮ ዞቄኔ፤","poem":1},{"text":"ሻኔ ዹሚ ዓኣፖ ዴምዔራሢ ታኣኮ ካንቂ ዓርቄኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዬይ ቢያ ማዔቴያ ታ ማዼ ዻቢንቲ ባኣሴ፤","poem":1},{"text":"ፆኦሲ ታ ሺኢቃሢያ","poem":2},{"lineBreak":true},{"text":"ጌኤሺ ዒናናኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«ሳዔሌ! ታጊዳ ሄሌ ጌኖ ማዾ ካንቂፖ!","poem":1},{"text":"ታኣኮ ሃዳሮ ዒላታ ሹኡሚንቲ ዓታንዳጉዲ ማሂፖ!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዓካሪ ታኣም ማርካዻንዳያና","poem":1},{"text":"ታርዤ ታኣኮ ማዓንዳሢ ጫሪንጮይዳ ዓኣኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ታኣኮ ላጋ ቶኦቺ ታና ዛጋኔ፤","poem":1},{"text":"ታ ጋዓንቴ ሌካ ፆኦሲ ባንሢ ዒላታኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ፔቴ ዓሲና ባጊና ጌስቲ ቡኩሳይ ዓኣሢጉዲ ቢያ","poem":1},{"text":"ፆኦሲና ዓሲና ጌስቲ","poem":2},{"lineBreak":true},{"text":"ቡኩሳይ ዓኣቶ ዓይጎ ጎዖንዶይ!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ታ ናንጎ ሌዖኮ ጋፒንፃ ሄሊ ሄሊኬ፤","poem":1},{"text":"ማዒ ታ ሙኪንዱዋ ቤሲ ዓኣዻኒኬ፤","poem":2},{"lineBreak":true},{"text":"ዻካ ዎዴ ሌሊ ታኣኮ ዓቴኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}