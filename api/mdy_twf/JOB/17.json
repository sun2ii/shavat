{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"«ዑኡዞ ዔካኒ ታኣኒ ባሺንቲ","poem":1},{"text":"ናንጎ ዎዳ ታኣኮ ጋፓኒ ዑኬኔ፤","poem":2},{"lineBreak":true},{"text":"ዓካሪ ዱኡፒ ታና ካፔኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታና ቦሃ ዓሳ ማንጌኔ፤","poem":1},{"text":"ዓኣፓ ታኣኮ ዔያታ ታና ዒፃሢ ዛጋኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ፆኦሲዮ! ኔጊዳፓ ዓታዛ","poem":1},{"text":"ሜሌ ታኣም ዔቄያ ባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ኔኤሮ ታኣም ዋኣሴ ማዔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዔያታ ማሊ ጶቂሡዋጉዲ","poem":1},{"text":"ዒኖ ኔ ዔያቶኮ ዓርቄኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያሮ ዔያታ ባሻንዳጉዲ ማሂፖ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሚኢሼ ዴንቃኒ ጌዒ","poem":1},{"text":"ፔ ላጋሢ ዓኣሢ ዒንጋ ዓሲ","poem":2},{"lineBreak":true},{"text":"ዒ ማዼ ጌና ናኣቶ ሄላኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ፆኦሲ ታና ዓሲ ዓማላንዳጉዲ ማሄኔ፤","poem":1},{"text":"ዓሳ ፔኤኮ ጩጮ ዒዛኮ ቤርታ ጩታ ዓሲጉዲ ታ ማዔኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታኣኮ ዖዪፃፓ ዔቄያና ዓኣፓ ታኣኮ ዴይ ዓቴኔ፤","poem":1},{"text":"ዑፃ ታኣኮ ጉቤ ሺቢጉዲ ማዔኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ፔና ጎኔ ዓሲኬ ጋዓ ዓሳ ሃያ ባኮና ዲቃቴኔ፤","poem":1},{"text":"ጌኤዦ ዓሳኣ ፆኦሲ ጉሙርቁዋ ዓሶይዳ ዻጋዼኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ያዺ ማዔቴያ ፂሎ ዓሳ ጎኑሞ ጎይፃፓ ሺኢኩዋሴ፤","poem":1},{"text":"ጌኤዦንሢያ ዶዱሞይዳ ዶዱሞ ቃሳኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዒንሢ ቢያሢ ላሚ ሙኪ ታ ቤርታ ማርሜቶ","poem":1},{"text":"ዒንሢ ባኣኮይዳፓ ፔቴታዖ ማሊ ጶቂሣ ዓሲ ታ ዴንቃዓኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«ታኣኮ ናንጎ ዎዳ ጋፔኔ፤","poem":1},{"text":"ታ ቱኬ ቱኡዞና ታኣኮ ዒኖ ማሊፆና ጉሪ ማዒ ዓቴኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሃኣታ ዓሳ ዹሞ ‹ሮኦሪኬ› ጋዓኔ፤","poem":1},{"text":"ሮኦሮ ሃሣ ‹ዹማኒ ዑኬኔ› ጋዓኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሃካፓ ሴካ ታኣኮ ዓኣማ","poem":1},{"text":"ሃይቂ ዱኡኪንቲሢ ሌሊኬ፤","poem":2},{"lineBreak":true},{"text":"ዒኢካ ዹሞይዳ ሻኣሎ ታኣኮ ታ ሂኢሣንዳኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዬካፓ ዱኡፖ፦ ‹ዓዴ› ጌይ ታ ዔኤላንዳኔ፤","poem":1},{"text":"ታና ሙዓ ዛኣሎ፦ ‹ታ ዒንዴ፤ ታ ጌሮ› ታ ጋዓንዳኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዓካሪ ዓይጎ ሃጊ ማዓ ዎዛ ታኣኮ ዓኣይ?","poem":1},{"text":"ታኣኮ ሃጊ ማዓ ዎዞ ዖ ታኣም ዴንቃንዳይ?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታኣኒ ሊካ ሃይቄ ዓሳ ዓኣ ቤዞ ኬዳኣና","poem":1},{"text":"ሃጊ ማዓንዳ ዎዛ ታኣና ዎላ ኬዳንዳ?","poem":2},{"lineBreak":true},{"text":"ሃሣ ታኣና ዎላ ዱኡፓ ኑ ጌላንዳ?»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}