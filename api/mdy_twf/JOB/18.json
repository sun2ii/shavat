{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":["ሹሃ ዓጮ ዓሢ፥ ቢልዳዴ ሂዚ ጌይ ማሄኔ፦"]},{"type":"verse","number":2,"content":[{"text":"«ዔዞ ዒዮቤ! ዓይጎሮ ሃያጉዴ ጌኤሲ ኔ ሚርጊሻይ?","poem":1},{"text":"ሂንዳ ኮሺ ዋይዜ፤ ኑዋ ጌስቶም።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዓይጎሮ ኔ ኑና ቆልሞ ማሂ ፓይዳይ?","poem":1},{"text":"ሃሣ ዓይጋ ኔ ኑና ዋይዚ ባይቄያ","poem":2},{"lineBreak":true},{"text":"ማሉዋ ዓሲ ማሂ ዛጋይ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኔኤኒ ዻጋዼቴ ኔና ኔ ባይዛንዳፓዓቴም","poem":1},{"text":"ኔ ዻጎና ሳዓ ዓጊፃዓኬ፤","poem":2},{"lineBreak":true},{"text":"ጊንሣ ሃሣ ላላኣ ዓኣ ቤዛፓ ዶጫዓኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«ጎሞ ዓሶኮ ፖዓ ባይቃንዳኔ፤","poem":1},{"text":"ታማ ዔኤታሢያ ላሚ ጴዻዓኬ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዔያቶኮ ማኣሮይዳ ዓኣ ፖዓ ሃይቃንዳኔ፤","poem":1},{"text":"ዬይ ፖዓ ዹማንዳኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዔያታ ዶዲ ሄርቂ ታኣኪ ሃንታ ሃንቲፃ","poem":1},{"text":"ኬዲ ኬዲ ሙካንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶኮ ጌኖ ቱኡዛኣ ዔያቶ ዔኪ ኬኤራንዳኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ፔ ሃንቲፆና ዔያታ ፒሮይዳ ጌላንዳኔ፤","poem":1},{"text":"ዔያቶኮ ቶካኣ ሱዞና ቡኡዲንታንዳኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ቡኡዶ ፒራሢ ዔያቶኮ ቶኮ ዓርቃንዳኔ፤","poem":1},{"text":"ዶንቂ ዓርቃ ፒራሢያ ካራ ባይዚ ዔያቶ ዓርቃንዳኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሳዖይዳ ዔያቶም ቡኡዶ ፒራ ፒሪንቴኔ፤","poem":1},{"text":"ጎይፆይዳ ዔያቶም ፒራ ጊኢጊንቴኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«ኮይሎ ዔያቶኮ ዒጊቻ ባኣዚ ማንጌኔ፤","poem":1},{"text":"ጊንፆ ዓኣዺ ዓኣዺ ዬይ ዔያቶ ዳውሳኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዎልቃ ዔያቶኮ ናዮና ጋፔኔ፤","poem":1},{"text":"ባይዛ ባካ ዔያቶ ባይዛኒ ጊኢጌኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዶርዓሢ ዑፆ ዔያቶኮ ዖኦፒሴኔ፤","poem":1},{"text":"ሃይቢ ጋፒንሢ ዔያቶ ዔካንዳኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሂርጋባኣያ ጉሙርቂ ናንጋ ማኣራፓ","poem":1},{"text":"ዔያታ ዳውሲንታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዓሲ ቢያ ዎይሣያ ማዔ ሃይቢ ባንሢ ዔያታ ዔውታኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዔያቶኮ ማኣሮይዳ ዓይጎ ባኣዚያ ዔያቶም ዓታዓኬ፤","poem":1},{"text":"ዔያታ ናንጋ ማኣሮይዳ ታሚ ሙርቁንሢ ዋሂንታንዳኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ፃጳ ካራፓ ሜላያ፤","poem":1},{"text":"ካኣፖ ዒላዣኣ ዲኢና ሚሢጉዲ ዔያታ ማዓንዳኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሳዖይዳ ዔያቶ ማሊ ጶቂሣንዳ ዓሲ ጴዺንዱዋሴ።","poem":1},{"text":"ዔያቶኮ ዔርቴ ሱንፃ ዓጫፓ ባይቃንዳኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ፖዓፓ ዹሞ ባንሢ ዔያታ ዳውሲንታንዳኔ፤","poem":1},{"text":"ዓሳ ናንጋ ዓጫፓኣ ዔያታ ባይቃንዳኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዔያቶኮ ዒጊኖ ባኣኮይዳ ዔያቶ ዻካላያ ማዓ","poem":1},{"text":"ሾይንቲ ዔያቶም ጴዻዓኬ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶኮ ማኣሮይዳ ዜርሢ ዓታዓኬ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዓባ ጌላ ዛሎንታ ኬስካ ባንፆንታይዳ ዓኣ ዓሳ","poem":1},{"text":"ዔያቶይዳ ሄሌ ሜታሢና ዒጊጪ ጎጋይቄኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዓይዲ ማዔቴያ ፑርታ ዓሲኮ ጋፒንፃ ያዺኬ፤","poem":1},{"text":"ፆኦሲ ዒጊጩዋ ዓሲያ ሄላማ ዬማኬ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}