{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":["ዬካፓ ዒዮቤ ሂዚ ጌይ ማሄኔ፦"]},{"type":"verse","number":2,"content":[{"text":"«ዒንሢ ዓይዲ ሄላንዳኣና ታና ሜታሳይ?","poem":1},{"text":"ሃሣ ዓይዲ ሄላንዳኣና ጌኤዞና ዒኖ ታኣኮ ዒንሢ ዱኡዛይ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሃይሾ ዒንሢ ታጶ ማይንቲ ታና ጫሽካኔ፤","poem":1},{"text":"ቦርሲንቱዋዖ ታና ዒንሢ ቶኦቻኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጎኔና ታ ዻቢንቴያ ማዔቴ","poem":1},{"text":"ዻቢንታ ሜታሳንዳሢ ታና ሌሊኬ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጎኔና ዒንሢ ዒንሢ ቶኦኮ ዼግ ዼጊዳኔ፤","poem":1},{"text":"ታኣኮ ሜቶይዳ ጌሊፃ፦","poem":2},{"lineBreak":true},{"text":"ታኣኒ ዻቤም ፆኦሲ ታጊዳ ዓጌያኬ ጌይ","poem":2},{"lineBreak":true},{"text":"ዬያ ባኮ ማርካ ማሂ ዔኪ ታና ዒንሢ ሞኦታኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ጋዓንቴ ሃይ ሜታሢ ታና ሄሌሢና","poem":1},{"text":"ቡኡዳሢ ሱዞይዳ ታና ኬኤሬሢ","poem":2},{"lineBreak":true},{"text":"ፆኦሲታሢ ዒንሢ ዔራንዳጉዲ ታ ኮዓኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታ ሜታዼኔ ጌይ ዒላቴያታቶዋ","poem":1},{"text":"ታኣሲ ዋይዛ ዓሲ ታ ዴንቂባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ዑኡዞ ታ ዼጊዲ ዒላቴቶዋ","poem":2},{"lineBreak":true},{"text":"ፒዜ ዎጌ ታ ዴንቂባኣሴ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጎይፆ ታኣኮ ቢያ ፆኦሲ ዲርቄሢሮ","poem":1},{"text":"ታ ኬስካንዳ ጎይሢ ባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ታ ዓኣዻ ጎይፆዋ ዹሚና ዒ ካንቄኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ቦንቾዋ ታኣኮ ቶኦካፓ ጉሲ ታና ቦርሲሴኔ።","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ዑፆ ታኣኮ ቢያ ዛሎና ዹይ ዹይ","poem":1},{"text":"ጋፒሲ ሾኦሌኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኮ ሃጊ ማዓ ዎዞ ፃጳፓ ቱጊንቲ ዶዓ","poem":2},{"lineBreak":true},{"text":"ሚሢጉዲ ዒ ማሄኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ፆኦሲኮ ዻጋ ታጊዳ ታሚጉዲ ዔኤቴኔ፤","poem":1},{"text":"ዓዳ ሞርኬጉዲ ታና ዒ ፓይዴኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታና ባይዛኒ ፔኤኮ ዖላ ዓሶ ዒ ዳኬኔ፤","poem":1},{"text":"ዔያታ ታ ማኣሮኮ ዙሎ","poem":2},{"lineBreak":true},{"text":"ዋርዲ ዴዒ ታና ማንጌኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«ፆኦሲ ታ ጌርሲንሢ ታ ኮራፓ ሃኪሴኔ፤","poem":1},{"text":"ታና ዔራ ዓሳ ቢያ ፃንጎ ማሂ ታና ዛጌኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታኣኮ ዒጊና ታጊዳፓ ዱማዼኔ፤","poem":1},{"text":"ታኣኮ ላጋኣ ታና ዋሌኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታ ማኣራ ሾኦቺንሢ ታ ዔኬ ዓሳ","poem":1},{"text":"ቢያ ታና ዋሌኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኮ ማዾ ማዻ ላኣላ ቢያ ሙፒ ዓሲ ማሂ ታና ፓይዴኔ፤","poem":2},{"lineBreak":true},{"text":"ሜሌ ፃንጎ ዓሲ ማሂ ታና ዛጌኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታኣኮ ዓይላሢ ታ ዔኤላዛ ታኣም ዬሁዋሴ፤","poem":1},{"text":"‹ሃዳራ ታና ማኣዴቴራ› ጌይ ታ ዒዛ ሺኢቃዛታዖ","poem":2},{"lineBreak":true},{"text":"ዒ ታኣም ዔኤዑዋሴ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ታ ማቻ ታኣኮ ካሶ ዒፄኔ፤","poem":1},{"text":"ታኣኮ ጌርሲንሢያ ታና ሻኣኪንቴኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዻኮ ናኣታታዖ ታና ቶቶኦቻኔ፤","poem":1},{"text":"ታና ዔያታ ዛጋ ዎዶናኣ ቦቦሃኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ታኣኮ ዑኬ ላጋ ታና ሻኣኪንቴኔ፤","poem":1},{"text":"ሚርጌና ታ ናሽካ ዓሳኣ","poem":2},{"lineBreak":true},{"text":"ታኣኮ ሞርኬ ማዒ ዔቄኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዓሽካ ታኣኮ ጋፒ ዒልዓ ሜጌፆይዳ ፓፄኔ፤","poem":1},{"text":"ታኣኒ ጉቤና ጋፔዖ ዻካሮ ዓቴኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«ታ ላጎንሢዮቴ! ፆኦሲ ኩጫ ታና ጳርቄሢሮ","poem":1},{"text":"ዒንሢ ታኣም ዖዪ፥ ሚጪንቱዋቴ!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ፆኦሲ ታና ዳውሳሢጉዲ","poem":1},{"text":"ዒንሢያ ሃሣ ታና ዓይጋ ዳውሳይ?","poem":2},{"lineBreak":true},{"text":"ሃያ ሄላንዳኣና ዒንሢ ታና ሜታሴሢ ጊዳኑዋይ?»","poem":2}]},{"type":"verse","number":23,"content":[{"text":"«ሃይማ ሄላንዳኣና ታ ጌስቴ ባኮ ማሊ ጶቂሣያና","poem":1},{"text":"ማፃኣፔይዳኣ ፃኣፓ ዓሲ ጴዼቴ","poem":2},{"lineBreak":true},{"text":"ዎዚ ታና ዎዛሳንዳዖ ዓቴይ!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዓንጊና፤ ሃሣ ዒርሳሴ ጌይንታ ባኮና ፃኣፒንቴቴ","poem":1},{"text":"ዬያጉዲ ሹቺዳ ቆኦቂንቲ","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋንዳጉዲ ጌሦናቴ ዎዚ ታና ዎዛሳንዳይ!","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ጋዓንቴ ታና ዓውሳሢ ባይቁዋያ ማዔሢና","poem":1},{"text":"ጋፒንፆ ዎዶና ታና ዓውሳኒ","poem":2},{"lineBreak":true},{"text":"ሳዖይዳ ዒ ዔቃንዳሢ ታ ዔራኔ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዒልዓ ታኣኮ ሙይንቲ ጋፔቴያ","poem":1},{"text":"ዓሽካፓ ታ ዱማዺ","poem":2},{"lineBreak":true},{"text":"ፆኦሲ ዛጋንዳሢ ታ ዔራኔ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዒዚያ ታኣኒ ታኣሮ ዒዛ ዛጋንዳሢኬ፤","poem":1},{"text":"ታ ዓኣፓ ዒዛ ዛጋንዳኔ፥ ሜሌቱዋሴ፤","poem":2},{"lineBreak":true},{"text":"ታኣኮ ዒና ዬኖ ኬሌሎ ሚርጌና ጶቂሣኔ።»","poem":2}]},{"type":"verse","number":28,"content":[{"text":"«ታ ላጎንሦ! ሜቶ ማዤሢ ዒዛታሢሮ","poem":1},{"text":"‹ኑ ዒዛ ዳውሶም› ዓይጎሮ ዒንሢ ጋዓይ?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ፆኦሲኮ ዻጋ ጬንቻ ዓፓሮና ሜቶና ዔኪ ሙካሢሮ","poem":1},{"text":"ጬንቾ ዓፓራ ዒንሢ ዎዹዋጉዲ ዔሩዋቴ።","poem":2},{"lineBreak":true},{"text":"ፆኦሲ ዎጋ ዎጌ ዓኣሢያ ዔሩዋቴ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/18.json","previousChapte