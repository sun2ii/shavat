{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":["ናዕማታ ዓጮ ዓሢ ፆፓሬ ሂዚ ጌይ ማሄኔ፦"]},{"type":"verse","number":2,"content":[{"text":"«ዒዮቤ! ታ ዒና ታና ዻጋሲ ኔኤም ኬኤዛንዳጉዲ ታና ማሄኔ፤","poem":1},{"text":"ዬያሮኬ ኔጉዋዖ ታ ኔኤም ኬኤዛኒ ሩኡሬሢ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታኣኒ ዋይዛሢ ታና ዻውሲሳ ጎሮኬ፤","poem":1},{"text":"ማሊ ጶቂሢፆ ዔራታ ታኣኮ","poem":2},{"lineBreak":true},{"text":"ማሂ ኔኤም ኬኤዛንዳጉዲ ታና ሂዓኔ።»","poem":2}]},{"type":"verse","number":4,"content":[{"text":"«ዓሲ ሳዖይዳ ጴዼሢዳፓ ዓርቃዖ","poem":1},{"text":"ሚናፓ ሃይማዒታሢ ኔ ዔራኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ፑርታ ዓሲኮ ሄርሺንቲ ዻካ ዎዴምኬ፤","poem":1},{"text":"ፆኦሲ ሃሻ ዓሶኮዋ ዎዛ ባይቃሢ ዓኣፒ ጊኢጳማጉዴያናኬ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ፑርታ ዓሲ ዎዚ ዖቶርሙሞና","poem":1},{"text":"ጫሪንጮ ሄላንዳኣና ዼግ ጌዔቴያ","poem":2},{"lineBreak":true},{"text":"ሃሣ ቶኦካ ዒዛኮ ሻኣሮ ሄሌቴያ","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዒዚ ፔኤኮ ሺዖጉዲ ጋፒ ዑጪንታንዳኔ፤","poem":1},{"text":"ዒዛ ቤርታ ዛጌ ዓሳ ‹ዒ ዎካ ዓኣይ?› ጋዓንዳኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዓውቲጉዲ ፒው ጌይ ባይቃንዳሢሮ ዒ ጴዻዓኬ፤","poem":1},{"text":"ጊንዒ ዓኣንቴ ጴዼ ባኣዚጉዲ ዒ ባይቃንዳኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዒ ናንጋ ቤዛፓ ቤሲ ባይቃንዳሢሮ","poem":1},{"text":"ፔቴና ዒዛ ዛጌ ዓሲ ላሚ ዒዛ ዛጋዓኬ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ናኣታ ዒዛኮ ሺኢቂ ሺኢቂ","poem":1},{"text":"ዓዴ ማንቆ ዓሶይዳፓ ጌኔና ቡሪ ዔኬ ሚኢሾ ጪጋንዳኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዎልቆና ዓኣ ዒዛኮ ዼጋቶ ዑፃ","poem":1},{"text":"ዻካ ዎዴኮ ጊንፃፓ ዓጪ ማዓንዳኔ።»","poem":2}]},{"type":"verse","number":12,"content":[{"text":"«ዎዚ ዒዛኮ ፑርቱማ ዻንጎይዳ ሙኡዚጉዲ","poem":1},{"text":"ዒዛም ዓኣፄቴያ","poem":2},{"lineBreak":true},{"text":"ዒንዲርዞና ዒ ጊኢጊሼቴያ","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ጋፑዋጉዲ ፔ ዻንጋ ዓርቂ","poem":1},{"text":"ጮንቂ ጮንቂ ዒ ኔጌቴያ","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዒዛኮ ጎጶ ጋራ ጋዓንቴ ዬይ ጫንቃንዳኔ፤","poem":1},{"text":"ዓዳ ሾኦሺኮ ዎዻ ዳኣኖጉዲ ማዓንዳኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ፑርታ ዓሲ ዓሲኮ ሙዔ ባኮ ዎልቄና ማሃንዳኔ፤","poem":1},{"text":"ዒዛኮ ጎጶ ጋራ ዓኣ ባኮ ቢያ ፆኦሲ ዒዛ ጮኦሻንዳኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ፑርታ ዓሲ ሙዓ ባካ ቢያ ዒዛ ዎዻ ዳኣኒ ማዓንዳኔ፤","poem":1},{"text":"ያዺ ማዒ ዒዛ ዎዻንዳኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሪሚታፓ ኮሾ ዛይታ ዲጲጉዱ ዎታሢ","poem":1},{"text":"ዔኤዞና ዲኢቆና ዎርዚ ዋኣሢጉዲ ጎዓሢ","poem":2},{"lineBreak":true},{"text":"ዛጉዋዖ ዒ ሃይቃንዳኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዒዛ ላቢፆኮ ዓኣፖ ሜሌም ዒዚ ዒንጋንዳፓዓቴም","poem":1},{"text":"ዒ ሙይንዱዋሴ፤","poem":2},{"lineBreak":true},{"text":"ኮርሚ ዒ ዴንቄ ቆሎና ዎዛዺንዱዋሴ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዬይ ማዓንዳሢ ማንቆ ዓሶ ዒ ሄርቄሢሮና","poem":1},{"text":"ዓሳ ማዤ ማኣሮዋ ጌኖ ማሊፆና ዒ ቡሪ ዔኬሢሮኬ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ጎጋይቂፃ ዒዛ ሃውሾ ባሼኔ፤","poem":1},{"text":"ዒ ቡኩሴ ባካኣ ዒዛ ዓውሳኒ ዳንዳዑዋሴ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዒዛኮ ቡኩሶና ባካ ቢያ","poem":1},{"text":"ዓቱዋዖ ጋፓንዳሢሮ","poem":2},{"lineBreak":true},{"text":"ዒዛ ፔኤሻንዳ ሙኡዚታዖ ዒ ዴንቃዓኬ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዎዚ ዒ ዖርጎጬቴያ ዻጋሳ ባኣዚ ዒዛ ሄላንዳኔ፤","poem":1},{"text":"ሚርጌ ሜታ ዒዛ ሄላንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሜቶና ዋኣዪሢና ዒዛም ሚርጋንዳኔ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"‹ሙይ ታ ሚሽካንዳኔ› ዒ ጋዓኣና","poem":1},{"text":"ፆኦሲ ፔኤኮ ዼኤፖ ዻጎ","poem":2},{"lineBreak":true},{"text":"ዒዛይዳ ኬይሳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ባይዛ ፑርቶ ባኮዋ ዒዛይዳ ዋርቂሳንዳኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዓንጎ ጬንቾ ዓፓሮፓ ዒ ቶሌቴ","poem":1},{"text":"ሞኦኖ ዓንጎ ሂኢዦና ዒ ዱኡታንዳኔ፤","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ሂኢዣ ዒዛኮ ጊዴና ሶፒ ኬስካንዳኔ፤","poem":1},{"text":"ሂኢዦኮ ቤርቶ ፖዓሢ ማዮ ዒዛኮ ዱኡዚ ዓኣዻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዼኤፒ ዒጊቹሞና ዒና ዒዛኮ ዲቃታንዳኔ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዒ ቡኩሴ ቆላ ቢያ ሻኔ ዹሞይዳ ጋፓንዳኔ፤","poem":1},{"text":"ዓሲ ዔኤሢባኣ ታሚ ዒዛ ሙዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ማኣሮይዳ ዓቴ ባኮዋ ቢያ ላይ ባይዛንዳኔ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዒ ማዼ ጎሞ ቢያ ጫሪንጫ ፔጋሲ ዻዋንዳኔ፤","poem":1},{"text":"ሳዓኣ ዒዛኮ ሞርኬ ማዒ ዔቃንዳኔ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ፆኦሲኮ ዻጎ ኬሎና","poem":1},{"text":"ዒዛኮ ማኣራ ዓኣ ባካ ቢያ ዲጲና ዔውታንዳኔ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ዋይዞ ዒፄ ዓሶም ፆኦሲ ማሊ ጌሤ ባካ","poem":1},{"text":"ፑርቶ ዓሶማኣ ዒንጎንዶ ባካ ዬያኬ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}