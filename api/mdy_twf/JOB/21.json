{"type":"verse","number":8,"content":[{"text":"ዔያቶኮ ናኣቶና ናኣቶኮ ናኣቶና","poem":1},{"text":"ዲጪ ኮሺና ናንጋሢ ዓይጋ ዔያታ ዛጋይ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፔቴታዖ ሂርጋባኣያ ኮሺና ዔያታ ናንጋኔ፤","poem":1},{"text":"ፆኦሲኮ ባይዛ ፑርቶ ባካ ዔያቶ ሄሊ ቤቂባኣሴ፤","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ባኣታ ዔያቶኮ ፔቴታዖ ሜታባኣያ ቆሊንታኔ፤","poem":1},{"text":"ዒንዶ ባኣታ ዔያቶኮ ዓጊሱዋዖ ሾዓኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ናኣቶ ዔያታ ፔኤኮ ማራይጉዲ ሄንቃኔ፤","poem":1},{"text":"ዓኣሎ ናኣታኣ ዔያቶኮ ማራናይጉዲ ፂካኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ካራቤ ዔያታ ባዒ ባዒ","poem":1},{"text":"ጎኦላኣ ዋርቂ ዋርቂ","poem":2},{"lineBreak":true},{"text":"ዲንኮዋ ዋርቂ ዎዛና ዔያታ ኮርጋኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዔያታ ፔኤኮ ናንጎ ሌዖ ኮሹሞና ሃሣ ዎዛና ጋፒሳኔ፤","poem":1},{"text":"ዋኣዪሢባኣያ ሃያ ሳዖይዳፓ ሃይቢና ዔያታ ዱማዻኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«ዬይ ያዺታንቴ ፆኦሲ ዔያታ፦","poem":1},{"text":"‹ኑ ኮይላፓ ሃኬ፤ ጎይፆዋ ኔኤኮ ኑ ዔራኒ ኮዑዋሴ› ጋዓኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዬያጉዲ ሃሣ፦ ‹ኑ ዒዛ ካኣሽካንዳጉዲ","poem":1},{"text":"ቢያ ባኮ ዳንዳዓ ጎዳሢ ዒ ዖናዳይ?","poem":2},{"lineBreak":true},{"text":"ዒዛ ሺኢቂፃ ኑና ዓይጎ ማኣዳይ?› ጋዓኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዬያ ዔያታ ጋዓሢ፦ ዔያቶኮ ኩጫ ዓኣ ቆላ ቢያ","poem":1},{"text":"ዔያቶ ላቢሢና ጴዼያ ዔያቶም ማላሢሮኬ፤","poem":2},{"lineBreak":true},{"text":"ታ ጋዓንቴ ፑርቶ ዓሶኮ ማሊፆ ዔካዓኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«ጌኤዞ ጋሳ ፑርቶ ዓሶኮ ፖዒ ባይቂ ቤቂያ?","poem":1},{"text":"ሃሣ ባይዛ ባኣዚ ዔያቶይዳ ኬዲ ዔራ?","poem":2},{"lineBreak":true},{"text":"ፆኦሲ ዔያቶ ፔ ዻጎና ሜታሲ ቤቂያ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዔያታ ጎቦጉዲ ዢባሬና ዔውቴ ዎዴ","poem":1},{"text":"ሲላሊጉዲ ዓልጎና ፒፂንቴ ዎዴ ዓኣ?»","poem":2}]},{"type":"verse","number":19,"content":[{"text":"«ዒንሢ፦ ‹ፆኦሲ ዓዶንሢ ዻቢንቶሮ","poem":1},{"text":"ዔያቶኮ ናኣቶ ሜታሳኔ› ጋዓኔ፤","poem":2},{"lineBreak":true},{"text":"ሂንዳ ፆኦሲ ጎሞ ዓሶ ሆቲና ዔያቶ ሜታሶንጎ፤","poem":2},{"lineBreak":true},{"text":"ያዺ ማዔያታቴ ዻቢንቴያ ማዔሢ ዔያታ ዔራኒ ዳንዳዓኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ጎሞ ዓሳ ዔያታ ፔኤሮ ማዼ ዻቢንቶሮ","poem":1},{"text":"ሜቶ ዔያታ ዔኮንጎ፤","poem":2},{"lineBreak":true},{"text":"ቢያ ባኮ ዳንዳዓ ጎዳሢ ፔ ዻጎ ዔያቶይዳ ኬይሶንጎ፤","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዓሲ ሃይቄስካፓ","poem":1},{"text":"ፔ ናኣቶ ዛሎ ዓይጎ ማላ ባኣዚ ዓኣይ?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ፆኦሲ ዼኤፖ ዼኤፖ ዓሶይዳታዖ ዎዎጋኔ፤","poem":1},{"text":"ዓካሪ ዓሲ ዒዛ ዎጌ ዎጊሢ ዔራቶ ዔርዛኒ ዳንዳዓ?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"«ፔቴ ፔቴ ዓሳ ናንጎ ጋፖ ሄላንዳኣና","poem":1},{"text":"ፔቴታዖ ሜታ ዔያቶ ሄሉዋንቴ ዶዲ፥ ሃሣ ኮሺ ማዒ","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዑፃኣ ዔያቶኮ ዓንዲርቄ ጎይሣ ዓኣንቴ","poem":1},{"text":"ሜጌፃ ዔያቶኮ ሶሬና ኩሙሢ ዓኣ ጎይሣ ዓኣንቴ ሃይቃኔ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዛላ ጋዓንቴ ዶዲ ዖዪሢ ዔያቶፓ ዱማዹዋንቴ","poem":1},{"text":"ሜቶና ቁራይኒንቴ ጎይሣ ኮሺ ባኣዚ ዴንቁዋዖ ሃይቃኔ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ቢያሢ ዱኡኪንታዖ ዓጪ ማዓኔ፤","poem":1},{"text":"ዛኣሌያ ዔያቶኮ ዑፆ ባይዛኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«ሃሢ ታና ሜታሳኒ ማሊሢና","poem":1},{"text":"ዒንሢ ዒኖና ዒንሢ ማሌ ጌኖ ማሊፆ ታ ዔራኔ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ዒንሢ፦ ‹ዬያ ዼኤፖ ዓሢኮ ማኣራ ዎካ ዓኣይ?","poem":1},{"text":"ፑርቶ ዓሢኮ ናንጎ ቤዛ ዓንካዳይ?› ጋዓኔ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ጎይፆ ሃንታ ዓሶ ዒንሢ ዖኦጪባኣዓዳ?","poem":1},{"text":"ዔያታ ኬኤዜ ማርካቶ ዒንሢ ዔኩዋዓዳ?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ዔያታ፦ ‹ባይዛ ባካ ሙካኣና ፑርቶ ዓሶ ሜታ ሄሉዋሴ፤","poem":1},{"text":"ፆኦሲኮ ዻጋ ፔጋዺ ጴዻ ዎዶና ዔያታ ቶቶላኔ› ጌዔኔ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ፑርቶ ዓሢ ፑርቶ ማዼሢ ዛሎ ‹ኔ ፑርታኬ›","poem":1},{"text":"ጋዓንዳሢ ዖናዳይ?","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ፑርቶ ማዾሮ ዒዛይዳ ሜቶ ዖ ዓጋንዳይ?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ዒ ሃይቄስካፓ ሌዛ ዒዛኮ ዱኡፖ ቤዞ ዔውታኔ፤","poem":1},{"text":"ዬካፓ ዱኡፓ ዒዛኮ ካፒንታኔ፤","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ዒዚ ዱኡኪንታኣና ዒዛ ዑፃ ማሆ ዓጫ ዒዛ ዴኤፃዓኬ፤","poem":1},{"text":"ዓሳ ዒዛኮ ጊንፆ ሙካንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሃሣ ኮሺ ሚርጌ ዴሬ ቤርታ ዒዛኮ ዓኣዻንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"«ዓካሪ ዒንሢ ጉሪ ማዔ ሃይሴና","poem":1},{"text":"ዓይጋ ታና ዶዲሻኒ ኮዓይ?","poem":2},{"lineBreak":true},{"text":"ዒንሢ ታኣም ማሂ ኬኤዛ ባካ ቢያ ሉኡዚኬ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}