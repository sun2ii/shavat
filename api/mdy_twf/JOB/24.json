{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["«ፆኦሲ ዎጎ ዎጋ ዎዶ ዓይጎሮ ሜንሡዋይ?",{"text":"ዒዛኮ ማዻዞንሢ ዬያ ዎጎ ቃኣሎ","poem":1},{"text":"ዓይዲ ሄላንዳኣና ካፓይ?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«ፑርቶ ዓሳ ፔ ቤዞ ዳልጊሻኒ ዛጶ ሻሃኔ፤","poem":1},{"text":"ማራቶ ቡሪ ዔኪ ዔኪ ፔ ቆልሞና ዎላ","poem":2},{"lineBreak":true},{"text":"ሲኢሪ ሲኢሪ ሄንቃኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዜኤሮ ናኣቶኮ ሃሮ ዔያታ ቡሪ ዔካኔ፤","poem":1},{"text":"ዜኤሮ ዒንዴሎኮ ቆሎ ማዔ ጌሜ","poem":2},{"lineBreak":true},{"text":"ዔኤቢኮ ዓይሢ ማሂ ዔካኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ማንቆ ዓሶ ሻኣኪንቲሢና ጎይፃፓ ዔያታ ዳውሳኔ፤","poem":1},{"text":"ዔያቶኮ ቤርታፓ ጳሽኪ ዓኣሺንታንዳጉዲ ማሃኔ።»","poem":2}]},{"type":"verse","number":5,"content":[{"text":"«ማንቆ ዓሳ ዓሲ ናንጉዋ ዳውሎይዳ","poem":1},{"text":"ዓኣ ኪርሞሌጉዲ","poem":2},{"lineBreak":true},{"text":"ፔኤኮ ናኣቶም ሙኡዚ ኮዓኒ ኬስኪ ሜታዺ ሃንታኔ፤","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዔያታ ቆልማ ሙዓ ባኮ ፔኤሮ ሙዓኒ ፔኤም ቡኩሳንዳኔ፤","poem":1},{"text":"ፑርቶ ዓሶሮ ማዔ ዎይኖ ጎዣፓ","poem":2},{"text":"ዔያታ ዚንጋንዳኔ።","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ዔያታ ዋንቶ ጉቤ ካሎ ላሂ ዎርቃኔ፤","poem":1},{"text":"ጪኢዦሮ ዔያታ ማይንታ ማኣዓ ዔያቶኮ ባኣሴ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዹኮይዳ ዋርቃ ዒሮና ዑፃ ዔያቶኮ ዎዓኔ፤","poem":1},{"text":"ማኣሪ ዔያታ ባይዚ ዼኤፖ ሹጮ ባንሢ ዶጪ ዎርቃኔ።»","poem":2}]},{"type":"verse","number":9,"content":[{"text":"«ፑርቶ ዓሳ ዓዴባኣ ዜኤሮ ናኣታ ዔያቶም ማዻያ ማዓንዳጉዲ","poem":1},{"text":"ዒንዶንሢኮ ዻንፃፓ ናኣቶ ቡሪ ዔካኔ፤","poem":2},{"lineBreak":true},{"text":"ሜታዼ ዓሲኮዋ ናዖ ጋሌ ጪጎያኮ ዓይሢ ባኣዚ ማሂ ዔካኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ማንቆ ዓሳ ፔቴታዖ ማኣዓ ባኣንቴ","poem":1},{"text":"ማዾይዳ ካሎ ኬስካኔ፤","poem":2},{"lineBreak":true},{"text":"ማኣሎ ቡሮ ዎዶና ናኣሮ ኬዲ ኬዲ፤","poem":2},{"lineBreak":true},{"text":"ሃሣ ባሲ ባሲ ዔያታ ፔኤሮ ናናይዺንታኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ፑርቶ ዓሶኮ ዔቦ ቱኮ ጎዦይዳ","poem":1},{"text":"ሪሚቶ ዓኣፓፓ ኮሾ ዛይቶ ዔያታ ኬሳኔ፤","poem":2},{"lineBreak":true},{"text":"ዎይኖ ካፆ ሶያፓ ዔኪ ዑዦ ዔያታ ኮሻኔ፤","poem":2},{"lineBreak":true},{"text":"ጋዓንቴ ዔያታ ዼኤቢንታኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ካታማ ካታማ ሃይቃኒ","poem":1},{"text":"ሳዞ ጋሽካ ዓሳ ዚኢሊንታኔ፤","poem":2},{"lineBreak":true},{"text":"ሜቄ ዓሳኣ ማኣዶ ዖኦጪሢና ዒላታኔ፤","poem":2},{"lineBreak":true},{"text":"ፆኦሲ ጋዓንቴ ዔያቶይዳ ማዺንቴ ጌኖ ዛጊባኣሴ።»","poem":2}]},{"type":"verse","number":13,"content":[{"text":"«ፖዒ ዒፃ ዓሲ ዓኣኔ፤","poem":1},{"text":"ፖዒ ዓይጎ ማዔቴያ ዔያታ ዔሩዋኣሢሮ","poem":2},{"lineBreak":true},{"text":"ፖዖኮ ጎይፆ ዔያታ ሃንቱዋሴ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዓሲ ዎዻ ዓሲ ሃጊ ዹሚ ዓኣንቴ ሚኢሪ ዔቂ","poem":1},{"text":"ማንቆ ዓሶንታ ሜታዼ ዓሶንታ ዎዻኔ፤","poem":2},{"lineBreak":true},{"text":"ዹሚ ዓኣንቴ ዉሱሞይዳኣ ኬስካኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዞኦስካ ኮኦማ ዓሲ ሳዓ ዓማንዳማ ካፓኔ፤","poem":1},{"text":"ዓይጎ ዓሲያ ዛጉዋጉዲ","poem":2},{"lineBreak":true},{"text":"ዓኣፖ ካሮ ፔኤኮ ካንቃኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዉሲ ዹሚና ማኣሪ ቦኦኪ ዉኡቃኒ ጌላኔ፤","poem":1},{"text":"ሮኦሮ ጋዓንቴ ዓኣሺንቲ ፔኤቃኔ።","poem":2},{"lineBreak":true},{"text":"ፖዒያኣ ዔያታ ዒዒፃኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዹሚና ሜቶ ማዢሢ ዔያቶ ዎዛሳሢሮ","poem":1},{"text":"ቢያሢም ሻኔ ዹማ ካሬያ ማዓኔ» ጌዒ ማሄኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«ፑርቶ ዓሳ ዲጲ ዋኣሢና ፒፂንቲ ዔውታንዳኔ፤","poem":1},{"text":"ዔያቶኮ ዓጫ ጋዳንቂንቴያ ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔቦ ቱኮ ቤዞዋ ዔያቶኮ ካኣማ ዓሲ ባኣሴ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሻቺ ዖይዺና ዓልቄም ዋኣፃኣ ሚጪ ባይቃሢጉዲ","poem":1},{"text":"ጎሞ ዓሳ ሃይቂ፥ ሃይቄ ዓሶ ዓጮ ዴንዲ ባይቃንዳኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዓሲ ቢያ ዔያቶ ዋላንዳኔ፤","poem":1},{"text":"ዔያቶ ዒንዶንሢታዖ ማሊ ጶቂሢንዱዋሴ፤","poem":2},{"lineBreak":true},{"text":"ዓሽኮ ዔያቶኮ ዛኣሌ ሙዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶኮ ፑርቱሞ ማዻ","poem":2},{"lineBreak":true},{"text":"ዶዔ ሚሢጉዲ ሜቂ ዓታንዳኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዬይ ቢያ ዔያቶ ሄሌሢ","poem":1},{"text":"ዔያታ፦ ናኣታባኣ ዞኦካሢ ላኣሎ ቡሪፆና","poem":2},{"lineBreak":true},{"text":"ዜኤሮ ዒንዶንሢ ማዔ ላኣሎም","poem":2},{"lineBreak":true},{"text":"ፔቴታዖ ሚጪንቲባኣሢሮኬ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ፆኦሲ ጋዓንቴ ፔ ዎልቆና","poem":1},{"text":"ቢታንቶይዳ ዓኣ ዓሶ ባይዛንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሃሣ ዒ ዻጋዺ ዔቄ ዎዶና","poem":2},{"lineBreak":true},{"text":"ፑርቶ ዓሳ ሼምፔና ዓታዓኬ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዔያታ ኮሺና ናንጋንዳጉዲ ፆኦሲ ዓይሤቴያ","poem":1},{"text":"ዔያታ ዓኣዻ ጎይፆ ቢያ ኮሺ ዒ ዛጋኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ፑርቶ ዓሳ ዻካ ዎዴም ዖርጎጫኔ፤","poem":1},{"text":"ጋዓንቴ ቤዞማና ሆኦሪጉዲ ሹሊ ባይቃኔ፤","poem":2},{"lineBreak":true},{"text":"ሃኣኮኮዋ ቶኦኪጉዲ ዔያታ ታይዚንታኔ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"‹ዬይ ያዺ ማዓኒ ዳንዳዑዋሴ› ጋዓ ዓሲ ዓኣ?","poem":1},{"text":"ታ ጌዔ ባካ ‹ሉኡዚኬ› ጋዓ ዓሲ ዓኣ?» ጌይ ማሄኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}