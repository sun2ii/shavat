{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":["ዒዮቤ ቃሲ ኬኤዛዖ ሂዚ ጌዔኔ፦"]},{"type":"verse","number":2,"content":[{"text":"«ፒዜ ዎጌ ዎጊሢ ዒፂ","poem":1},{"text":"ናንጎ ታኣኮ ጫንቺ ማሄ","poem":2},{"lineBreak":true},{"text":"ቢያ ባኮ ዳንዳዓ ፆኦሲ ሃይቆ!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሼምፓሢኮ ዑኡሲ ታኣም ፆኦሲ ዒንጌም","poem":1},{"text":"ታ ዓኣ ዎዶማና","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ፔቴታዖ ፑርታ ባኣዚ ታ ዻንጋፓ ኬስካዓ፤","poem":1},{"text":"ታ ዒንዲርዞና ሉኡዙሞ ታ ጌስታዓ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዒንሢ ጌዔ ባኮ ቢያ ፒዜኬ ጌይ","poem":1},{"text":"ፔቴታዖ ታኣኒ ዔካዓ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ሃይቃንዳያ ሄላንዳኣና ጎኑሞና ዶዲፆ ታ ሃሻዓ። »","poem":2}]},{"type":"verse","number":6,"content":[{"text":"« ‹ታ ፒዜኬ› ጌይፆይዳፓ ዎይቴቴያ ጊንሢም ታ ጋዓዓ፤","poem":1},{"text":"ታ ናንጋ ዎዶይዳ ቢያ ታ ዒና ታና","poem":2},{"lineBreak":true},{"text":"‹ዬያ ቢያና ኔ ዻቤኔ› ጎዑዋሴ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«ታና ዒፃ ዓሶና ማካ ዓሳኣ ቢያ","poem":1},{"text":"ጌኔ ዓሲና ዔኤቢ ዋይዚ ዒፃ ዓሲጉዲ","poem":2},{"lineBreak":true},{"text":"ዔያቶም ዓጊንታ ሜቶ ዔኮንጎ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ፆኦሲ ሼምፓሢ ዔያቶኮ ዓሽካፓ ዱማሲ","poem":1},{"text":"ናንጎ ዔያቶኮ ቃሚሤ ዎዶና","poem":2},{"lineBreak":true},{"text":"ፆኦሲ ዋላ ዓሶኮ ዓይጎ ሃጊ ማዓ ዎዛ ዓኣይ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሜታ ዔያቶ ሄሌ ዎዶና","poem":1},{"text":"ፆኦሲ ዔያቶኮ ዒላቶ ዋይዛንዳ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ቢያ ባኮ ዳንዳዓ ጎዳሢና ዔያታ ዎዛዻ?","poem":1},{"text":"ቢያ ዎዴ ፆኦሲኮ ሱንፆ ዔያታ ዔኤላ?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«ፆኦሲ ዎልቃ ዎዚጉዲ ዼኤፒታቴያ","poem":1},{"text":"ታ ዒንሢ ዔርዛንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ቢያ ባኮ ዳንዳዓ ጎዳ ማሌ ባኮ ፔጋሲ ታ ዒንሢም ኬኤዛንዳኔ፤","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዒንሢ ዬያ ቢያ ዔዔራያኬ፤","poem":1},{"text":"ዓካሪ ሃያ ማዑዋ ባኮ ዓይጋ ዒንሢ ጌስታይ?» ጌዔኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"«ቢያ ባኮ ዳንዳዓ ጎዳ","poem":1},{"text":"ፑርቶ ዓሶና ጌኖ ዓሶ ዎጋሢ ዬያ ጎይፆኬ፤","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ናኣታ ዔያቶኮ ሚርጌቴያ ዖልዚና ጋፓንዳኔ፤","poem":1},{"text":"ዜርፃ ዔያቶኮ ሙኡዚ ባይዚ ናይዺንታንዳኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዬያይዳፓ ዓቴዞንሢ ሃርጌና ጋፓንዳኔ፤","poem":1},{"text":"ዜኤሮይንዶ ማዔዞንሢያ ዔያቶ ዬኤካዓኬ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ፑርቶ ዓሶኮ ማኣሻላጉዲ ፓይዲባኣ","poem":1},{"text":"ሚኢሼንታ ማኣዖንታ ዓኣያ ማዓኒ ዳንዳዓኔ፤","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ጋዓንቴ ፑርቶ ዓሳ ቡኩሴ ማኣዓሢ","poem":1},{"text":"ፂሎ ዓሳ ማይንታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ቡኩሴ ቆሎዋ ጌኤዦ ዓሳ ጊሽቲ ዔካንዳኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዔያታ ማዣ ማኣራ ሻንጌ ፓቲሌና ማዦናያ","poem":1},{"text":"ጎሺ ዉዲጉዲያኣ ሻኣሂንታንዳኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ፑርቶ ዓሳ ጋፒንሢ ዖርጎቺ ማዒ ሻኣሎይዳ ላሃንዳኔ፤","poem":1},{"text":"ጊንዓስካፓ ዔያታ ጴጫኣና ጋዓንቴ","poem":2},{"lineBreak":true},{"text":"ቆላ ቢያ ዔያቶኮ ባይቃንዳኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዲቃቲሢ ዲጲጉዲ ዔሩዋንቴ ዔያቶ ሄላንዳኔ፤","poem":1},{"text":"ዋንቶና ዓልጎ ዢባሬ ዔያቶ ዔካንዳኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዓባ ኬስካ ባንፆ ዢባራ","poem":1},{"text":"ዔያታ ናንጋ ቤዛፓ ፒፂ ዔኪ ዓኣዺ ዔያቶ ባይዛንዳኔ፤","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ጳሽኪ ዔያታ ቶላኒ ማላ ዎዶና","poem":1},{"text":"ፔቴታዖ ሚጪንቲሢ ባኣያና ዢባራ ዔያቶይዳ ዶዳንዳኔ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዬይ ዢባራ ቶኦቺሢና ኩጮ ፔኤሲ ባዒ ባዒ","poem":1},{"text":"ሃሣ ሱኡሩንሢናኣ ዔያቶ ዒጊቻንዳኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}