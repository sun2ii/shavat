{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":28,"content":[{"type":"heading","content":["ዔራቶ ጋዳይሲሢና ጌስቶና ካላሊ"]},{"type":"verse","number":1,"content":[{"text":"«ቢሮ ዓንጎ ኬሳኒ ማዒዲኔ ጌይንታ ባካ ቦኦኪንታያንታ","poem":1},{"text":"ዎርቄ ሼኤሾ ቤሲያ ዓኣኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዓንጊ ሳዓይዳፓ ቦኦኪንቲ ጴዻኔ፤","poem":1},{"text":"ማዳኣቤ ጌይንታ ባካኣ ሹቺዳፓ ሼኤሺንታኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዓሳ ዹሞይዳ ዓኣ ባኮ ፔጋሲ ኬሳኔ፤","poem":1},{"text":"ዴንዲ ሳዖኮ ዴሞ ሄሊ ሻኔ ዹሞይዳ ዓኣ","poem":2},{"lineBreak":true},{"text":"ማዒዲኖ ሹጮ ኮዓኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዓሲ ናንጋ ቤዛፓ ሃኪ ዴንዲ","poem":1},{"text":"ዓሲ ሄሊ ቤቂባኣ ቤሲ ሄላኔ።","poem":2},{"lineBreak":true},{"text":"ዒኢካ ኮሺ ዔታዻ ዔቴ ቦኦካኔ፤","poem":2},{"lineBreak":true},{"text":"ሱሲዳኣ ሹላሊ ሹላሊ ዓሲዳፓ ዱማዺ ፔኤኮ ማዻኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሳዓ ሙኡዚም ማዓ ሃኣኮ ባቃልሳኔ፤","poem":1},{"text":"ዒዞኮ ጋራ ጋዓንቴ ታሚና ዓልቂ ባይቃኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሴኔፔሬ ጌይንታ ቦንቺንታ ሹጫ","poem":1},{"text":"ዒዞይዳ ዓኣ ሹጮ ባኣካፓ ጴዻኔ፤","poem":2},{"lineBreak":true},{"text":"ዒኢካ ዓኣ ዓጮይዳፓኣ ዎርቄ ጴዻኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዬያ ማዒዲኖ ባንሢ ዔኪ ዓኣዻ ጎይፆ","poem":1},{"text":"ኪላንቄያ ዔሩዋሴ፤","poem":2},{"lineBreak":true},{"text":"ሃምፑራኣ ዴንቁዋሴ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ፑርቶ ቦዓ ዬኖ ባንሢ ዓኣዺያ ዓኣዹዋሴ፤","poem":1},{"text":"ዞቢያ ዒኢና ሃንቱዋሴ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«ዓሲ ሳዖ ቦኦካኣና ፔ ኩጮና ዓጬ ሹጮ ቡጋኔ፤","poem":1},{"text":"ዹኮዋ ማዢንቶ ፃጳፓ ዶይሳኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ላሎ ቆኦቂ ኬስኮ ጎይሢ ኮሻኔ፤","poem":1},{"text":"ቦንቺንታያ ማዔ ማዒዲና ኬስካ ሹጮዋ ዒኢፓ ዴንቃኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዋኣሢ ዬያ ማዒዲኖ ባንሢ ዎቱዋጉዲ","poem":1},{"text":"ዎራ ዔቃ ካሮ ዲርቂ ቃዛኔ፤","poem":2},{"lineBreak":true},{"text":"ሳዖ ዴማ ዓኣቺንቲ ዓኣ ቆሎዋ ዴንቃኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዓካሪ፦ ዔራቶ ዓንካፓ ጴዻይ?","poem":1},{"text":"ማሊ ጶቂሥሢኮዋ ቤዛ ዓንካዳይ?»","poem":2}]},{"type":"verse","number":13,"content":[{"text":"«ዔራቶ ሼምፓ ዓኣ ማዢንታ ናንጋ ሳዖይዳ ጴዹዋሴ፤","poem":1},{"text":"ዒዛ ዋኣዺም ሻንቺንታቴያ ዔራይ ባኣሴ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዼኤፖ ባዞንታ ዳልጎ ዋኣፆንታ","poem":1},{"text":"‹ዔራቶ ኑ ኮራ ባኣሴ› ጋዓኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዔራቶ ጌኤሺ ዎርቄና ሻንቂንቱዋሴ፤","poem":1},{"text":"ዒዛ፦ ‹ያኣዼ ቢራ ዔካንዳኔ› ጌይንቱዋሴ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዔራቶ፦ ዖፔሬ ጌይንታ ዎርቆንታ ሜሬጊዴንታ","poem":1},{"text":"ሴንፔሬ ጌይንታ ሚዛጶ ሹጮፓኣ ባሼ ቦንቺንታያኬ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዎርቄንታ ጌኤሺ ሌማሌኤሼያ ዒዞና ቤቃያቱዋሴ፤","poem":1},{"text":"ዎርቄፓ ኮሾና ፓልሞናኣ ላኣሚንታያቱዋሴ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዔራቶ ኪቤና ዓልማዞ ጌይንታ ባኮፓ ቢያ ባሼኬ፤","poem":1},{"text":"ዞቄ ሚዛጶ ሹጮፓኣ ዑሣ ባሻያኬ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"‹ቶጳዚዮኔ› ጌይንታ ዒቶጲያኮ ሚዛጶ ሹጫ ዒዞ ሄሉዋሴ፤","poem":1},{"text":"ኮሺ ጌኤሺ ማዔ ዎርቄናኣ ማላቲንቱዋሴ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሂዴቶ፦ ዔራቶ ዓንካፓ ሙካይ?","poem":1},{"text":"ማሊ ጶቂሥሢያ ዎካፓ ጴዻይ?»","poem":2}]},{"type":"verse","number":21,"content":[{"text":"«ሼምፓ ዓኣ ማዢንቲ ቢያፓ ዒዛ ዓኣሺንቴያኬ፤","poem":1},{"text":"ጫሪንጫ ባራና ካፓታዖ ኮይ ዴንቁዋያኬ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ባይሲንታና ሃይቢና፦","poem":1},{"text":"‹ኑ ዒዞ ዛሎ ዔራሢ","poem":2},{"text":"ኬኤዚንታ ሃይሴና ሌሊኬ› ጋዓኔ።»","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"«ዔራቶ ባንሢ ዔኪ ዓኣዻ ጎይፆና","poem":1},{"text":"ዒዛ ናንጋ ቤዞዋ ፆኦሲ ሌሊ ዔራኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዓይጎሮ ጌዔቴ ፆኦሲ ሳዖኮ ጋፖ ሄላንዳኣና ቢያ ዛጋኔ፤","poem":1},{"text":"ጫሪንጮኮዋ ዴማ ዓኣ ባኮ ቢያ ዴንቃኔ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዢባሮኮዋ ዎልቆ ዒ ማዤ ዎዶና","poem":1},{"text":"ዳልጎ ባዞ ዋኣፆዋ ዒ ማኬ ዎዶና","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዒሮና ጉጉንፆናም","poem":1},{"text":"ዳምቦ ዒ ጊኢጊሼ ዎዶና","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ፆኦሲ ዔራቶ ዛጌኔ፤","poem":1},{"text":"ቦንቺሲ ዼጊሴኔ፤","poem":2},{"lineBreak":true},{"text":"ማሂ ማሂያ ዛጊያ ዶዲሼኔ።»","poem":2}]},{"type":"verse","number":28,"content":[{"text":"«ዒማና ፆኦሲ ዓሲም፦","poem":1},{"text":"‹ዓካሪ ዔራቶ ጌይሢ ፆኦሲ ዒጊጪሢኬ፤","poem":2},{"lineBreak":true},{"text":"ማሊ ጶቂሥሢ ጌይሢያ ፑርቱሞፓ ሃኪሢኬ› » ጌዔኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}