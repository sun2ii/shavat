poem":2}]},{"type":"verse","number":7,"content":[{"text":"ካታማ ዓሳ ቡኪንታ ጶኦኮ ታ ዓኣዺ","poem":1},{"text":"ዎጎ ዎጋ ቤዛ ዴዔ ዎዶና","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዼጌሢ ታና ዛጋዖ ቦንቾና ታ ቤርታፓ ሺሺኢካኔ፤","poem":1},{"text":"ጋርቾ ዓሳኣ ታና ቦንቺ ዴዔ ቤዛፓ ዔቃኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዴሮም ጌስቲ ጌስቲ ዓኣ ሱኡጋኣ ታና ዛጋኣና","poem":1},{"text":"ኩጮና ፔኤኮ ዻንጎ ዓርቂ ዚቲዮ ጋዓኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዓጮኮ ቢቶ ማዔ ዓሳ ታ ዓኣ ቤዞይዳ ዚቲ ጋዓኔ፤","poem":1},{"text":"ዒንዲርዛ ዔያቶኮ ቱኡቲ ጌስታኒ ዔያቶ ባሻኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«ዋይዜ ዓሲ ቢያ ታና ሄርሻኔ፤","poem":1},{"text":"ዛጌሢያ ቢያ ታና ጋላታኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዬይ ያዺ ማዔሢ፦","poem":1},{"text":"ማንቆ ዓሶኮ ዒላቶ ታ ዋይዚ ዓውሳያና","poem":2},{"lineBreak":true},{"text":"ዜኤሮ ናኣቶዋ ታ ማኣዳሢሮኬ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሃይቃኒ ዑኪ ዓኣ ዓሶ ታ ማኣዴሢሮ","poem":1},{"text":"ዔያታ ታና ዓንጄኔ፤","poem":2},{"lineBreak":true},{"text":"ዜኤሮ ዒንዶ ማዔ ላኣሎዋ ታ ማኣዳሢሮ","poem":2},{"lineBreak":true},{"text":"ዎዛና ዔያታ ፆኦሲ ቦንቾም ዓይኑሞ ዓይናዻኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ፂሉሞ ዓዳ ማኣዖጉዲ ታ ማይንቴኔ፤","poem":1},{"text":"ፒዜ ዎጌያ ዓዳ ዼኤፒ ኮኦቴጉዲ","poem":2},{"lineBreak":true},{"text":"ቃሲ ታ ማይንቴኔ፤ ቆኦቤጉዲያኣ ቶኦካ ታ ዓጌኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዓኣፓ ባይቄሢም ዓኣፒ","poem":1},{"text":"ዎቦ ዓሶኮዋ ታኣኒ ቶኪኬ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ማንቆ ዓሶኮ ታኣኒ ዓዶ፤","poem":1},{"text":"ታ ዔሩዋ ዓሶማኣ ታኣኒ ታርዤኬ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ጌናሢኮ ባንጋሎ ታ ሜንሤኔ፤","poem":1},{"text":"ሙዓኒ ዒ ዓርቄሢ ዻንጋፓ ታ ኬይሲሴኔ።»","poem":2}]},{"type":"verse","number":18,"content":[{"text":"« ‹ታኣኮ ናንጎ ሌዓ ማኣሻላጉዲ ሚርጌም","poem":1},{"text":"ታ ማኣራ ቦንቾና ዓኣዖ ታ ሃይቃንዳኔ› ታ ጌዔኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ፃጳ ታኣኮ ቢያ ዎዴ ዋኣሢ ዴንቃያና","poem":1},{"text":"ካኣፓኣ ዖልካዻ ሚሢጉዲኬ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ቢያ ዎዴ ቦንቺንቴ ጎይሣ ታ ናንጋኔ፤","poem":1},{"text":"ዎልቃኣ ታኣኮ ቢያ ዎዴ ዓኪ ማዓኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዓሳ ታኣም ዋይዚ ዚቲ ጋዓኔ፤","poem":1},{"text":"ታ ዞሮ ዚቲ ጌይ ዒናፓ ዔያታ ዋይዛኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ጌኤዛ ታኣሲ ዔያቶኮ ዼኤቦ ዛኣራያታሢሮ","poem":1},{"text":"ታ ጌስቴስካፓ ሜሌ ጌስታ ዓሲ ባኣሴ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ጎሽካ ዓሲ ሌዔ ዒርዚ ዴንቃኒ ኮዓሢጉዲ","poem":1},{"text":"ዔያታ ታ ጌኤዞ ዋይዛኒ ዻንጎ ፔኤሲ ሃሺ ካፓኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ታ ዓኣፖ ካሮ ፖዒሲ ታኣኒ ሙስታዛ","poem":1},{"text":"ካርቴ ዓኣፖ ካራ ዔያቶኮ ቡሊንቲ ፖዓኔ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ታኣኒ ታ ኮዔሢ ጎይፆ ዔያቶ ዎይሣኔ፤","poem":1},{"text":"ዖሎ ዓሶ ፔኤኮ ዔኪ ዓኣዻ ካኣቲጉዲ","poem":2},{"lineBreak":true},{"text":"ታ ዔያቶ ዔኪ ዓኣዻኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ዖያ ዎዶናኣ ታ ዔያቶ ዶዲሻኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}