{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":3,"content":[{"type":"heading","content":["ዒዮቤ ፔ ሾይንቴ ኬሎ ጋዳንቄሢ"]},{"type":"verse","number":1,"content":["ዬካፓ ዒዮቤ ጌስቲፆ ዓርቃዖ ፔ ሾይንቴ ኬሎ ሂዚ ጌይ ጋዳንቄኔ፦"]},{"type":"verse","number":2,"content":[{"text":"«ታ ዒንዶኮ ዑፃ ታ ዓቴ ዋንቴላ","poem":1},{"text":"ታ ሾይንቴ ኬሌላኣ ጋዳንቂንቴያ ማዖም!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዬና ኬሌላ ዹሚ ባንሢ ላኣሚንቶም፤","poem":1},{"text":"ጫሪንጮ ፆኦዛሢ ዒዞም ማሎፓ፤","poem":2},{"lineBreak":true},{"text":"ፖዒ ፔቴታዖ ዒዞይዳ ጴዾፓ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ቃኣዮና ሻኔ ዹሚና ዒዛ ካንቂቴያ ማዖም፤","poem":1},{"text":"ዒዞ ኬሌሎኮ ፖዓ ሻኣሬ ዹሚና ካንቂንቴያ ማዖም፤","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዬኖ ኬሌሎ ሻኔ ዹሚ ካንቆንጎ፤","poem":1},{"text":"ሌዖ ጋራ ዓኣ ኬሎና ዎላ ፓይዲንቶፓ፤","poem":2},{"lineBreak":true},{"text":"ዓጊኖ ባኣኮዋ ጌሊ ዒዛ ዓዺንቶፓ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዬኖ ኬላ ዓሲ ሾይንቱዋ ኬሊ ማዖንጎ፤","poem":1},{"text":"ዎዛ ዑኡሲያ ዒዞይዳ ዋይዚንቶፓ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሌዋታኔ","poem":1},{"noteId":0},{"text":"ጌይንታ ቦዖ ጴቻኒ ዳንዳዓዞንሢና","poem":1},{"text":"ኬሎ ጋዳንቃ ማርሾ ዓሳ ዬኖ ኬሎ ጋዳንቆንጎ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዬኖ ዋንቶኮ ካሪፆ ዦኦጋሢ ዹሞንጎ፤","poem":1},{"text":"ፖዒኮ ሃጊ ማዓንዳ ዎዛኣ ዒኢካ ጴዾፓ፤","poem":2},{"lineBreak":true},{"text":"ካሪሢ ዓቢያ ዒዞይዳ ፆርቆፓ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዬና ዋንቴላ ታኣኒ ታ ዒንዶ ጎጳፓ ኬስኩዋጉዲ","poem":1},{"text":"ሃሣ ሜቶዋ ታ ዓኣፓፓ ዓኣቻኒ","poem":2},{"lineBreak":true},{"text":"ሾይፆ ካሮ ታ ጊዳ ዎዺባኣሢሮ ጋዳንቂንቴያ ማዖንጎ።»","poem":2}]},{"type":"verse","number":11,"content":[{"text":"«ዎንዴ ታ ዒንዶ ጎጳ ዓኣዖ","poem":1},{"text":"ሃሣ ዒንዶ ጎጳፓ ታ ኬኬስካዖ ሃይቄቴ ዓይጎ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታ ዒንዳ ፔ ጉባዛ ዓይጋ ታና ጎዴይ?","poem":1},{"text":"ዓይጋ ታና ዒዛ ፔ ዻንፆ ዻንሢሤይ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዒማና ታ ሄኤዶ ሃይቂ ላሄያታቶ","poem":1},{"text":"ሄኤዶ ታ ሃውሼያ ናንዳንቴኬ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሃሢ ሻሂንቲ ዓኣ ቤዞ ፔኤም ጌዒ ኮሼ","poem":1},{"text":"ዓጮ ካኣቶንታ ዔያቶኮ ዞራ ዓሶንታ ዎላ","poem":2},{"lineBreak":true},{"text":"ሄኤዶ ታ ላሂ ሃውሾ ዴንቄያ ናንዳንቴኬ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ፔኤኮ ማኣሮ ዎርቄና ቢራና ኩንሤ ሱኡጎና ዎላ","poem":1},{"lineBreak":true},{"text":"ታ ሄኤዶ ላሄያ ናንዳንቴኬ፤","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ሃጊ ዓጊኒ ሄሊባኣንቴ ሾይንቲ ዱኡቴያ","poem":1},{"text":"ፖዒያ ፔቴታዖ ዛጊባኣ ናይጉዲ ታ ማዔቴ ዓይጎ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ፑርታ ዓሲ ዱኡኪንቲና ፔኤኮ ፑርቶ ማዾ ሃሻኔ፤","poem":1},{"text":"ማዾ ማዺ ላቤ ዓሳኣ ዱኡፖይዳ ሃውሻኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ቱኡዞ ዓሳታዖ ዒኢካ ኮሹሞ ዴንቃኔ፤","poem":1},{"text":"ዔያቶ ማዺሻ ዓሶ ጎሪንታፓ ዔያታ ዻቃኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዻኮንታ ዼኤፖ ዼኤፖ ዓሶንታ ዒኢካ ፔቴይዳ ዓኣኔ፤","poem":1},{"text":"ሃሣ ካራማኣ ዒኢካ ዔያቶ ዎይሣ ዓሶ ዓይላታፓ ኬስካኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«ዋኣዪሢዳ ዓኣዞንሢም ፖዒ","poem":1},{"text":"ናንጋ ጫንቄ ዖዪሢና ኩሜ ዓሶም","poem":2},{"lineBreak":true},{"text":"ሼምፔ ዓይጋ ዒንጊንታይ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዺቢ ቆሎፓ ባሼ","poem":1},{"text":"ሃይቢ ኮዒ ዴንቁዋኣዞንሢም","poem":2},{"lineBreak":true},{"text":"ሼምፔ ዓይጋ ዒንጊንታይ?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዱኡኪንታ ዎዶና ዎዛዻዞንሢም","poem":1},{"text":"ሼምፓ ዓይጋ ዒንጊንታይ?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ጎይፃ ባይቄሢም","poem":1},{"text":"ፆኦሲ ካራ ዎዼ ዓሢም","poem":2},{"lineBreak":true},{"text":"ፖዒ ዓይጋ ዒንጊንታይ?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ሙዖ ሙዖንዶ ቤዞ ታ ዖዪሢና ሜታዻኔ፤","poem":1},{"text":"ዒላታ ታኣኮ ዓልቂ ጋፑዋ ዋኣሢጉዲኬ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ታ ዒጊጬ ባካ ታ ኮይላ ሙኬኔ፤","poem":1},{"text":"ዓልቲ ታ ማሌ ባካ ታና ሄሌኔ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ኮሹሞና ሃውሺሢና ታኣኮ ባኣሴ፤","poem":1},{"text":"ታ ሜቶኮዋ ጋፒንሢ ባኣሴ።»","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"3፡8 ሌዋታኔ ጌይፃ፦ ሚናኣ ዎዴና ዓኣኔ ጌይንታያ ጉርጉሮ ማላ ዼኤፒ ቦዖኬ።","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/mdy_twf/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":25}