ent":[{"text":"ሃሣ ዔያታ ካያ ሃንቲ ሃንቲ ሃሬጉዲ ጫኣጋኔ፤","poem":1},{"text":"ጊንሣ ቶሾ ዴማኣ ዶጪ ዶጪ ዎርቃኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዢራፓና ጳርቂንቲ ጳርቂንቲ ዓጫፓ ዔያታ ዳውሲንቴሢሮ","poem":1},{"text":"ሱንሢ ባይቂ፥ ማሊሢባኣያ ማዒ ዔያታ ናንጌኔ።»","poem":2}]},{"type":"verse","number":9,"content":[{"text":"«ታኣኒ ዔያቶኮ ሚኢጪ ዓማሎ ባኣዚ ማዔኔ።","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ሻኣኪንቲ ታ ኮይላፓ ዔያታ ሺኢካኔ፤","poem":1},{"text":"ፔቴታዖ ቦርሲንቲባኣያ ታ ቤርታ ዔያታ ጩታኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ፆኦሲ ዎልቆ ታኣኮ ላቢሲ ታና ዻውሲሴሢሮ","poem":1},{"text":"ዔያታ ቢፃላ ቶሌ ፓሮጉዲ","poem":2},{"lineBreak":true},{"text":"ታ ዑፃ ፂኪ ሺራኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ጎሪ ዲቺቦኦ ናኣታ ታና ማንጌኔ፤","poem":1},{"text":"ቶኮ ታኣኮ ዔያታ ኮሪ ኬኤሪ","poem":2},{"lineBreak":true},{"text":"ሜቶ ታና ሄሊሳኒ ጊኢጊንቴኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታ ሃንታ ጎይፆ ዲርቂ","poem":1},{"text":"ታና ባይዛኒ ዔያታ ኮዓኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያ ማዺፆ ቃዛ ባኣዚያ ዔያቶ ባኣሴ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዲጲ ዑሪ ጌላሢጉዲ","poem":1},{"text":"ኬኤሎ ዲፆ ታኣኮ ዔያታ ዳርዚ ጌሌኔ፤","poem":2},{"lineBreak":true},{"text":"ቢያ ባኮ ሜንሢ ባይዚ ባይዚ ታጊዳ ዔያታ ሙኬኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሚርጌና ታ ዲቃቴኔ፤","poem":1},{"text":"ቦንቻ ታኣኮ ዢባሬ ዢባርሻያጉዲ ማዒ ዓኣዼኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኮ ዻቂንቶኮዋ ሃጊ ማዓ ዎዛ","poem":2},{"lineBreak":true},{"text":"ሊኢሎጉዲ ላኣሊንቲ ባይቄኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«ሜታሢ ታኣኮ ኮሺ ሚርጌሢሮ","poem":1},{"text":"ሼምፓሢ ታኣኮ ሃይቃኒ ዑኪ ሜታዼኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዋንቶ ዋንቶ ዶዲ ሃርጌ","poem":1},{"text":"ሜጌፆ ታኣኮ ጋኣጫኔ፤","poem":2},{"lineBreak":true},{"text":"ሜታሢያ ታኣኮ ታና ሃውሺሱዋሴ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሃርጋ ታኣኮ ዖይዼሢሮ","poem":1},{"text":"ዓፒላ ታኣኮ ጉርሚ ፑርቴኔ፤","poem":2},{"lineBreak":true},{"text":"ሆሌ ዓርቃ ማኣዖጉዲ ታና ጩኡሊ ዓርቄኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ፆኦሲ ታና ዾቃላ ዢቢ ኬኤሬሢሮ","poem":1},{"text":"ሲላሊና ዲቢንሢና ታ ማላኔ።»","poem":2}]},{"type":"verse","number":20,"content":[{"text":"«ታ ፆኦዛሢዮ! ታ ኔ ባንሢ ዒላቴኔ፤","poem":1},{"text":"ኔ ታኣም ጋዓንቴ ማሂባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ዔቂ ታ ኔና ሺኢቄኔ፤","poem":2},{"lineBreak":true},{"text":"ጋዓንቴ ኔ ታኣም ዋይዚባኣሴ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ኮሺ ኔ ታኣም ዶዴኔ፤","poem":1},{"text":"ኔኤኮ ዼኤፖ ዎልቆና ኔ ታና ዳውሴኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዢባራ ዔቂሲ ዔካንዳጉዲ ኔ ታና ማሄኔ፤","poem":1},{"text":"ዓልጎ ዢባሬናኣ ኔ ታና ቡምባልሴኔ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዓሲ ቢያም ዓቱዋያ ማዔ ሃይቢም","poem":1},{"text":"ኔ ታና ዓኣሢ ዒንጋንዳሢ ታ ኔና ዔሬኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ሎኦሚ ሜቄ ዓሲ ሜታዺ ማኣዶሮ","poem":1},{"text":"ኩጮ ፔኤሲ ዔቂሲ ዒላታዛ","poem":2},{"lineBreak":true},{"text":"ዶዳ ዓሲ ዓኣ?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ታኣኒ ሜታዼ ዓሶ ዬኤኪባኣዓዳ?","poem":1},{"text":"ማንቆ ዓሶዋ ሚጪንቲ ታኣኒ ማኣዲባዓዳ?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ኮሺ ባኣዚ ዴንቃንዳኔ ጌይ ታ ማላዛ","poem":1},{"text":"ፑርታ ባኣዚ ታና ሄሌኔ፤","poem":2},{"lineBreak":true},{"text":"ፖዒ ታኣም ኬስካንዳኔ ጌይ ታ ካፔንቴ","poem":2},{"lineBreak":true},{"text":"ሮኦራ ታኣም ዹሜኔ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ማሊፆና ታ ሜታዼኔ፤","poem":1},{"text":"ኮሹሞ ታ ዴንቃኒ ዳንዳዒባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ኬላ ኬላ ዋኣዪፃ ታኣኮ ሚርጊ ሚርጊ ዓኣዼኔ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ዑፃ ታኣኮ ዓቢ ሚቼምቱዋንቴ","poem":1},{"text":"ዖዪፆና ካርቴኔ፤","poem":2},{"lineBreak":true},{"text":"ዓሳ ቡኪንታ ጶኦኮይዳኣ ዔቂ ማኣዶ ታ ዖኦጫኔ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ዓሲዳፓ ዱማዺ ዉኡኮኮ ታ ጌርሲ ማዔኔ፤","poem":1},{"text":"ቱኡቲኮዋ ታ ላጌ ማዔኔ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ታኣኮ ካርቴ ዑፃ ጎኦጊ ጎኦጊ ኬዳኔ፤","poem":1},{"text":"ዑፃ ታኣኮ ቆሦና ዔኤታኔ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ዎዞ ታኣኮ ታ ፔጋሲ ዔርዛ","poem":1},{"text":"ፔቴ ሻዦና ዋርቆ ጎኦሎና ዲንካሢና","poem":2},{"lineBreak":true},{"text":"ሃሢ ታኣኮ ዖዪፆ ታ ቃዪ ዋይዚሳ ዓንጋሞ ማዔኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}