{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":[{"text":"«ሚዛጲ ዉዱሮ ናይና ላሃኒ ታና ሱኡካሱዋጉዲ","poem":1},{"text":"ታ ዓኣፖና ‹ዛጋዓ› ጌይ ታ ጫኣቄኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ዬያ ዛሎ ፆኦሲ ሎፓ ታኣም ዓይጎ ዒንጌይ?","poem":1},{"text":"ጫሪንጫ ዓኣ ቢያ ባኮ ዳንዳዓ ፆኦዛሢዳፓ","poem":2},{"lineBreak":true},{"text":"ታኣም ጎዖና ባካ ዓይጎዳይ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ፑርቶ ዓሶይዳ ዱማ ዱማ ሜታ","poem":1},{"text":"ዻቢንቴ ዓሶይዳኣ ባይሲንታ","poem":2},{"lineBreak":true},{"text":"ሄላሢ ዔርቴያቱዋዓዳ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ፆኦሲ ታ ማዼ ባኮ ቢያ ዛጉዋዓዳ?","poem":1},{"text":"ሃሣ ታ ሃንቴ ሃንቲፆዋ ዒ ፓይዱዋዓዳ?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«ሉኡዚ ባኣዚ ታኣኒ ጌስቲባኣያታሢ","poem":1},{"text":"ዓሲያ ታኣኒ ጌሺባኣያታሢ ታኣኒ ጫኣቃኔ፤","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዬይ ጎኔ ማዒፆ፦ ፆኦሲ ዴኤሡሞ ዔሮ ባኮ","poem":1},{"text":"ፒዜሢዳ ጌሢ ታና ዛጎንጎ፤","poem":2},{"lineBreak":true},{"text":"ታኣኮ ፂሉሞና ዶዲፆዋ ዔሮንጎ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ፒዜ ጎይፃፓ ታ ኬስኬያ ማዔቴ","poem":1},{"text":"ዓኣፓ ታኣኮ ዛጌሢ ቢያ ዒና ታኣኮ ዓፃዼያ ማዔቴ","poem":2},{"lineBreak":true},{"text":"ሃሣ ኩጫኣ ታኣኮ ጎሜና ኪንቄያ ማዔቴ፥","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታ ጎሽኬ ሃኣኮ ሜሌ ዓሲ ሙዖንጎ፤","poem":1},{"text":"ታ ባቃላ ቢያ ቱጊንቲ ባይቆንጎ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዒና ታኣኮ ሜሌ ላኣሊ ናሹሞና","poem":1},{"text":"ዲዒንቲ ዔውቴያ ማዔቴ","poem":2},{"lineBreak":true},{"text":"ታኣኮ ዓሺናሢ ማቾ ዴንቃኒ","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ካራ ካቲ ታ ዴዔያ ማዔቴ","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ማቻ ሜሌ ዓሲም ዎንሢ ዎዻያ ማዒ ማዾንጎ፤","poem":1},{"text":"ሃሣ ዒዛ ሜሌ ዓቲንቄና ላሆንጎ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዬይ ማዻ ዎጌና ዓይሢሳያታሢሮ","poem":1},{"text":"ዼኤፒ ዻቢንቲኬ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዬይ ጎማ ታሚጉዲ ሚቺ ባይዛያታሢሮ","poem":1},{"text":"ታኣኒ ዬያ ማዼያ ማዔቴ ታኣኮ ቆልሞ ቢያ","poem":2},{"lineBreak":true},{"text":"ዬይ ጋፒሴያ ናንዳኔ።»","poem":2}]},{"type":"verse","number":13,"content":[{"text":"«ታኣኮ ማዾ ማዻ ዓቲንቆና ላኣሎና","poem":1},{"text":"ታ ዔያቶም ጌስታንዳጉዲ ታኣም ዔያታ ኬኤዜንቴ","poem":2},{"lineBreak":true},{"text":"ታ ቶኦቼያ ማዔቴ","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ፆኦሲ ፔኤኮ ዻጎና ታና ዎጋኒ ዔቄ ዎዶና","poem":1},{"text":"ዓይጌ ታኣም ኮሽካንዳይ?","poem":2},{"lineBreak":true},{"text":"ዎጎና ታና ዒ ዖኦጫ ዎዶና","poem":2},{"lineBreak":true},{"text":"ታና ዖኦጮ ዖኦጪፆም ዎዚ ጌይ ታ ማሃንዳይ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዒንዶ ጎጶይዳ ታና ማዤሢ","poem":1},{"text":"ታኣኮ ማዻ ዓሶዋ ማዤሢቱዋዓዳ?","poem":2},{"lineBreak":true},{"text":"ኑና ቢያሢ ኑ ዒንዶንሢ ጎጶይዳ ጎጶይዳ","poem":2},{"lineBreak":true},{"text":"ማዤሢ ዒዛ ቱዋዓዳ?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«ማንቆ ዓሳ ሺኢቃ ባኮ ላኣጊ ታ ዔሩዋሴ፤","poem":1},{"text":"ዜኤሮ ዒንዶንሢያ ዶዲሺሢዳፓ","poem":2},{"lineBreak":true},{"text":"ጊንሢም ጌይ ታ ዔሩዋሴ፤","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዜኤሮ ናኣታ ጉሪ ዎርቃንቴ","poem":1},{"text":"ታ ታኣሮ ሙይ ዎርቄ ዎዴ ባኣሴ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ታኣኮ ዼጋቶ ዎዶይዳፓ ዓርቃዖ","poem":1},{"text":"ታ ዔያቶኮ ዓዶ ማዒ ናንጌኔ፤","poem":2},{"lineBreak":true},{"text":"ታ ናንጎ ዎዶ ቢያይዳ ዜኤሮ ዒንዶንሢ ታ ማኣዴኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሜታዼ ዓሳ ማኣዖ ባኣዚ ባይዚ፥","poem":1},{"text":"ካላዺ፤ ሃሣ ጪኢሺና ዔያታ ሜታዻንቴ ታ ዛጊ","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ታኣኮ ማራቶ ጋፓኖና ኮሺንቴ ማኣዓሢ","poem":1},{"text":"ታ ዔያቶም ዒንጉዋዖ ዓቴ ዎዴ ባኣሴ።","poem":2},{"lineBreak":true},{"text":"ዬያሮ ዔያታ ጉቤ ዒናፓ ታና ጋጋላታኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዓሳ ቡካ ጶኦካ ታኣኒ ዔርቴያኬ ጌዒ","poem":1},{"text":"ዜኤሮ ናኣቶ ታ ኩጮና ታኣኒ ሌኤቂንሤያ ማዔቴ","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ሻላ ታኣኮ ጌኤታፓ ኬስኮንጎ፤","poem":1},{"text":"ካኣላሢዳፓኣ ሾኦሊንቲ ኬዶንጎ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዬያ ታ ማዻሢ ፆኦሲኮ ጎሪንቶ ታ ዒጊጫሢሮና","poem":1},{"text":"ዒዛኮ ዲቃሣ ዼኤፑሞሮ","poem":2},{"lineBreak":true},{"text":"ዒዛ ቤርታ ዔቃኒ ታ ዳንዳዑዋሢሮኬ።»","poem":2}]},{"type":"verse","number":24,"content":[{"text":"«ታኣኒ ታ ቆሎና ጉሙርቂንቲ ቤቂባኣሴ፤","poem":1},{"text":"ጊንሣ ጌኤሺ ዎርቄያ ታኣኮ ጌኤቂንቶያ ታ ማሂባኣሴ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"‹ታኣኮ ቆላ ሚርጌኔ፤","poem":1},{"text":"ዖርጎቹሞንታ ሚርጌ ሚኢሼንታ ታ ዴንቄኔ›","poem":2},{"lineBreak":true},{"text":"ጌይ ታ ዎዛዺ ቤቂባኣሴ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዓቦኮ ፖዒፆ ሚዛጱሞ","poem":1},{"text":"ዓጊኖኮዋ ዖይዺ ፖዒፆ ታኣኒ ዛጊ","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዒና ታኣኮ ጋርሲና ዬያቶና ዲዒንቲባኣሴ፤","poem":1},{"text":"ታ ኩጮዋ ታኣኒ ፒሺ ሄርቂሢና","poem":2},{"lineBreak":true},{"text":"ቦንቾ ታ ዔያቶም ዒንጊባኣሴ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ዬያ ማዺፃ ሎ ዑፃ ዓኣ ጎዳም","poem":1},{"text":"ጉሙርቂንቱዋያ ማዒሢታሢሮ","poem":2},{"lineBreak":true},{"text":"ዬንሢ ማዺፃ ሃይቢ ዔኪ ሙካ ጎሜኬ።»","poem":2}]},{"type":"verse","number":29,"content":[{"text":"«ታና ዒፃ ዓሳ ሎኦሜሢሮ ታ ዎዛዺባኣሴ፤","poem":1},{"text":"ፑርታ ባኣዚያ ዔያቶ ሄላዛ ታ ኮኦሚባኣሴ፤","poem":2}]},{"type":"verse","number":30,"content":[{"text":"‹ታ ሞርካ ባይቆም› ጌይ ጋዳንቂሢና","poem":1},{"text":"ፔቴታዖ ታ ጎሜ ማዺባኣሴ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ቢያ ዎዴ ሾኦቺ ታ ዔካያ ማዔሢ","poem":1},{"text":"ታኣኮ ማዻ ዓሳ ታኣም ማርካዻኔ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ጎይሢ ዴንዳንቴ ሳዓ ዓሜ ዓሲ ዙልካ ዎርቁዋጉዲ","poem":1},{"text":"ታ ማኣሪ ዔኪ ዓኣዺ ታ ዔያቶ ዎይሣኔ። »","poem":2}]},{"type":"verse","number":33,"content":[{"text":"«ዻቢንቲ ታ ጋራ ታኣኒ ዱኡኪባኣሴ፤","poem":1},{"text":"ሜሌ ዓሶጉዲ ታ ጎሜ ታ ዓኣቺባኣሴ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ዴሮኮ ሚርጉማ ታና ዒጊቼም","poem":1},{"text":"ታ ማኣሮ ዓሶኮዋ ቶኦቺፃ ታና ዲቃሤም","poem":2},{"lineBreak":true},{"text":"ታ ማኣሮይዳ ዻንጋ ባይቂ ታ ዓኣሺንቴ ዎዴ ባኣሴ።»","poem":2}]},{"type":"verse","number":35,"content":[{"text":"«ታኣም ዋይዛ ዓሲ ታ ዴንቃቶ ዓይጎ!","poem":1},{"text":"ታኣኒ ጎኔ ጋዓኔ፤","poem":2},{"lineBreak":true},{"text":"ቢያ ባኣዚ ዳንዳዓ ጎዳ ታኣም ማሆንጎ!","poem":2},{"lineBreak":true},{"text":"ታና ዎጎና ዓይሢሳሢ፦ ዒ ዓይሢሳ ባኮ","poem":2},{"lineBreak":true},{"text":"ፓይዲ ፓይዲ ሺኢሼም ታ ዛጋቴ ዓይጎ!","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ታኣም ዒንጎና ባኣዚጉዲ ጌኤታ ታ ጌሣንዳንቴኬ፤","poem":1},{"text":"ቦንቾሮ ቶኦካ ዓጎ ባኮጉዲያኣ ቶኦካ ታ ዓጌያ ናንዳኔ።","poem":2}]},{"type":"verse","number":37,"content":[{"text":"ቢታንቶ ዓኣ ዓሲጉዲ ፆኦሲ ቤርቶይዳ ታ ጫርቂ ዔቂ","poem":1},{"text":"ታ ማዼ ባኮ ቢያ ፓይዲ ፓይዲ ኬኤዛንዳንቴኬ።»","poem":2}]},{"type":"verse","number":38,"content":[{"text":"«ዓሲኮ ጎሺ ታኣኒ ጩቦና","poem":1},{"text":"ቡሪ ዔኪ ጎሽኬያ ማዔቴ፥","poem":2}]},{"type":"verse","number":39,"content":[{"text":"ዬኖ ጎዦይዳ ባቃሌ ሃኣኮ ዔኤቢ ጪጉዋዖ","poem":1},{"text":"ቡኪሲ ዔኪ ታ ሙዒ ዔያቶ ዖዪሴያ ማዔቴ፥","poem":2}]},{"type":"verse","number":40,"content":[{"text":"ዬኖ ጎዤሎይዳ ዛርጋሢ ዛሎ ዓንጊሢ፤","poem":1},{"text":"ዔልዓሢ ቤዞ ሆኦሪ ባቃሎንጎ!» ጌዔኔ።","poem":2},{"lineBreak":true},{"text":"ዬያይዲ ዒዮቤኮ ጌኤዛ ጋፔኔ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}