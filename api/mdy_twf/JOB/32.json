{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":["ዒዮቤ፦ «ታኣኒ ፂሎ ዓሲኬ» ጌዒ ፔ ማሊፆና ዶዴሢሮ ሃይሦ ዓሶንሢ ጌኤዞ ሃሼኔ።"]},{"type":"verse","number":2,"content":["ዒዮቤ ፔና ፂሎ ማሂ፥ ፆኦሲ ዻቢንቴያ ማሂ ፓይዴሢሮ ራሜ ዜርፃፓ ማዔ ቡዛ ዓሲ ማዔ ባርኬሌ ናኣዚ፥ ዔሊሁ ሚርጌና ዻጋዼኔ።"]},{"type":"verse","number":3,"content":["ዒዮቤኮ ላጎንሢ ዒዮቤ ዔያቶ ዖኦጫሢኮ ኮይሳሢጉዲ ማሂ ኬኤዚ ዒዛ ላሣኒ ዳንዳዒባኣዖ ዒዮቤ ዻቢንቴያ ሌሊ ማሂ ፓይዴሢሮ ዔሊሁ ሃሣ ሚርጌና ዻጋዼኔ።"]},{"type":"verse","number":4,"content":["ዔሊሁ ሃንጎዋቶይዳፓ ናኣቶ ማዔሢሮ ቢያሢ ዒዮቤም ኬኤዚ ጋፒሳንዳያ ሄላንዳኣና ዒ ጌስታንዳ ዎዶ ጊቢ ዚቲ ጌይ ካፔኔ።"]},{"type":"verse","number":5,"content":["ሃይሦ ዓሳ ዒዮቤ ዖኦጬሢኮ ኮይሳሢጉዴያ ማሂ ኬኤዛኒ ዳንዳዒባኣሢ ዒ ዛጋዖ ሚርጌና ዻጋዼኔ።"]},{"type":"verse","number":6,"content":["ዬካፓ ዔሊሁ፦",{"text":"«ታኣኒ ዒንሢዳፓ ጌኤዛታያኬ፤","poem":1},{"text":"ዒንሢ ጋዓንቴ ጋርቺኬ፤","poem":2},{"lineBreak":true},{"text":"ዬያሮ ታ ማሊፆ ታ ዒንሢም ኬኤዛኒ ዒጊጬኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"‹ጋርቻ ቤርታዺ ጌስቶንጎ፤","poem":1},{"text":"ዔያታ ናንጌ ዖዶዞ ሌዖይዳ ዴንቄ ዔራቶ","poem":2},{"lineBreak":true},{"text":"ዒዛ ዔርዞንጎ› ታ ጌዔኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጋዓንቴ ዓሲ ጋርካ ማዒ ዔራቶ ዒንጋሢ","poem":1},{"text":"ዼኤፖ ፆኦዛሢኮ ሼምፖ ዒንጋ ዑኡዞኬ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዓሲ ዔራ ማሃሢ ጋርቻቶቱዋሴ፤","poem":1},{"text":"ፒዜ ባኣዚ ማሊ ጶቂሣኒያ ማኣዳሢ","poem":2},{"lineBreak":true},{"text":"ሚርጌ ሌዔ ናንጊሢቱዋሴ።»","poem":2}]},{"type":"verse","number":10,"content":[{"text":"«ዬያሮ ታኣኒያ ታ ማሊፆ ዒንሢም ኬኤዞም፤","poem":1},{"text":"ዒንሢያ ዒናፓ ዋይዙዋቴ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዒንሢ ጌስታ ዎዶና","poem":1},{"text":"ታ ጊቢ ዒንሢሲ ዚቲ ጌይ ዋይዜኔ፤","poem":2},{"lineBreak":true},{"text":"ዔራቲ ጌስቶ ጎይፆ ዒንሢ ኮዓኣናኣ","poem":2},{"lineBreak":true},{"text":"ታ ዒንሢሲ ዋይዜኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዒናፓ ታ ዒንሢሲ ዋይዜኔ፤","poem":1},{"text":"ጋዓንቴ ዖኦኒያ ዒዮቤ ጌስቲ ማሃኒ ዳንዳዔይ ባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢዳፓ ዒ ጌስቴ ጌኤዞም ጊዳያ ማሂ","poem":2},{"lineBreak":true},{"text":"ዒዛም ኬኤዜ ዓሲ ባኣሴ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዒዮቤም ጊዳያ ማሂ ኬኤዛኒ ዳንዳዓይ","poem":1},{"text":"ፆኦሲዳፓዓቴም ዓሲቱዋሢሮ","poem":2},{"lineBreak":true},{"text":"ዒንሢ ‹ዔራቶ ኑ ዴንቄኔ› ጌይ ጉሪ ሄርሺንቲፖቴ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዒዮቤ ማርሜሢ ዒንሢና ማዓንዳፓዓቴም ታኣናቱዋሴ፤","poem":1},{"text":"ታኣኒ ዒንሢ ጌስቴ ጎይፆ ዒዛም ማሂ ኬኤዛዓኬ።»","poem":2}]},{"type":"verse","number":15,"content":[{"text":"«ዬያ ዒ ጌዔሢሮ ዔያታ ዲቃቲ","poem":1},{"text":"ጎዖንዶ ጎይሢ ባይዜሢሮ","poem":2},{"lineBreak":true},{"text":"ፔቴታዖ ዔኤቢ ጋዓኒ ዔያታ ዳንዳዒባኣሴ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ማይ ሃይሾ ዔያታ ጎዖንዶ ባኣዚ ባይዚ ዚቲ ጌይ ዔቄኔ፤","poem":1},{"text":"ዓካሪ ዔያታ ዚቲ ጌዔቴ","poem":2},{"lineBreak":true},{"text":"ታኣኒያ ጊቢ ዚቲ ጌይ ካፓንዳያ ኮይሳ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ያዺቱዋሴ! ታ ዛሎና ማሂ ታ ዒዛም ኬኤዛንዳኔ፤","poem":1},{"text":"ታኣኮ ዓኣ ማሊፆዋ ታ ዒዛም ፔጋሲ ኬኤዛንዳኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሚርጌ ታ ኬኤዛ ባኣዚ ዓኣሢሮ","poem":1},{"text":"ማይ ታኣኒ ዚቲ ጋዓኒ ዳንዳዑዋሴ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ጎጳ ታኣኮ ዹኡቃኒ ዑኬ","poem":1},{"text":"ሺሜ ዎይኖ ዑዦ ዋሆና ሱርባጉዲ ጋኣቤኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ታ ጌስቴም ዬይ ጋፖንጎ፤","poem":1},{"text":"ታ ዻንጎና ማሂ ታ ዒዛም ኬኤዛንዳያ ኮይሳኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሃያ ጌኤዞና ዖ ዛላ ማዒያኣ ታ ጌስታዓ፤","poem":1},{"text":"ሃሣ ዖናኣ ታ ጋዳይሳዓኬ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ታኣም ዓሲ ጋዳይሲሢ ማዑዋሴ፤","poem":1},{"text":"ዬያ ታ ማዻያታቴ","poem":2},{"lineBreak":true},{"text":"ታና ማዤሢ ዑኬና ባባይዛንዳኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}