{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"«ዔኤዞ ዒዮቤ! ታ ኔኤም ኬኤዛሢ ዋይዜ፤","poem":1},{"text":"ታ ኔኤም ጋዓ ባኮዋ ኮሺ ዒና ዔኬ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታ ኔኤም ማሂ ኬኤዛኒ ጊኢጊንቴኔ፤","poem":1},{"text":"ዒንዲርዛኣ ታኣኮ ጌስታኒኬ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታ ጋዓ ባካ ዒኖኮ ታኣኮ ፒዙሞ ዔርዛኔ፤","poem":1},{"text":"ዒንዲርዛኣ ታኣኮ ጎኑሞ ጌስታኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታና ማዤሢ ፆኦሲ ዓያናኬ፤","poem":1},{"text":"ሼምፖ ታኣም ዒንጌሢ ቢያ ባኮ ዳንዳዓ ጎዳኮ ዑኡዞኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«ኔ ዳንዳዓያ ማዔቴ ታ ጋዓ ሃይሶ ማሂ ታኣም ኬኤዜ፤","poem":1},{"text":"ማርማሢ ጊኢጊሺ ዔቂ ታኣና ማርሜ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኔናንታ ታናንታ ፆኦሲ ቤርታ ኑ ሄኮኬ፤","poem":1},{"text":"ላምዓሢ ኑ ማዢንቴሢ ዓጪዳፓኬ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዬያሮ ኔ ታና ዒጊጫንዳያ ኮይሱዋሴ፤","poem":1},{"text":"ታኣኒ ኔኤና ማርሚፆና ኔኤም ጌኤታዻያ ማዓኒ ኮዑዋሴ።»","poem":2}]},{"type":"verse","number":8,"content":[{"text":"«ጎኔኬ፤ ኔ ኬኤዜ ባኮ ቢያ ታ ዋይዜኔ፤","poem":1},{"text":"ኔ ዒንዲርዛፓ ኬስኬ ባኮዋ ታ ዔኬኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኔኤኒ ኬኤዛዖ፦ ‹ዻቢንቲና ዔኤቢያ ታኣኮ ባኣያ፥","poem":1},{"text":"ታ ጌኤሺ ዓሲኬ፤","poem":2},{"lineBreak":true},{"text":"ፔቴታዖ ታ ጎሜ ማዺባኣያ ፂሎ ዓሲኬ፤","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጋዓንቴ ፆኦሲ ታና ሜታሳኒ","poem":1},{"text":"ታ ጋዓ ባኣዚ ዋይዛኒ ኮዓኔ፤","poem":2},{"lineBreak":true},{"text":"ዓዳ ፔኤኮ ሞርኬጉዲ ታና ማሄኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ቶኮ ታኣኮ ዱፄና ዓይሣኔ፤","poem":1},{"text":"ታ ዓኣዻ ጎይፆዳ ቢያ ዒ ታና ዛጋኔ› ኔ ጌዔኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«ዔኤዞ ዒዮቤ! ዬይ ሃይሳ ኔኤኮ ዻቢንቲ ማዔሢ","poem":1},{"text":"ታ ኔና ዔርዛኒ ኮዓኔ፤","poem":2},{"lineBreak":true},{"text":"ፆኦሲ ዓሲዳፓ ቢያ ባሼኬ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዓካሪ፦ ‹ፆኦሲ ዓሲ ሃይሴ ዋይዙዋሴ› ጌይ","poem":1},{"text":"ዓይጋ ኔ ፆኦሲዳ ዻጋዻይ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዓሲ ማሊ ጶቂሡዋፓዓቴም","poem":1},{"text":"ፆኦሲ ዱማ ዱማ ጎይሢና ኬኤዛኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዋንታ ዓሲ ፔኤኮ ሻኣሎይዳ ላሂ","poem":1},{"text":"ዼኤፒ ጊንዖይዳ ዓኣንቴ","poem":2},{"lineBreak":true},{"text":"ፆኦሲ ዓውቲና ፔ ዻዋ ባኣዚና ኬኤዛኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዒማና ዓሳ ዒዛኮ ቃኣሎ ዋይዛንዳጉዲ ዒ ማሃኔ፤","poem":1},{"text":"ዔያቶም ኬኤዛ ላቲፆና ዔያቶ ዲቃሣኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዬያይዲ ዓሳ ጎሜ ማዺሢዳፓ ካፒንታንዳጉዲ ማሃኔ፤","poem":1},{"text":"ዖቶርሙሞዋ ዔያቶይዳፓ ባይዛኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሼምፓሢ ዔያቶኮ ባይሲንታፓ ዒ ካፓኔ፤","poem":1},{"text":"ዱማ ዱማ ዎዻ ዶርዖፓኣ ዓውሳኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ጊንሣ ሃሣ ዓሶኮ ሜጌፆ ጋራ ጋፑዋ ዶርዓ ጌሌም","poem":1},{"text":"ሻኣሎይዳ ላሂ ሜታዻንዳጉዲ ማሃኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዬያይዲ ሃርጊንቴ ዓሲ ሙኡዚ ዻንጋ ጌሡዋጉዲ ዒሣኔ፤","poem":1},{"text":"ዓኣሢ ሙኡዚታዖ ዒዛ ዒዒሣኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዑፃ ዒዛኮ ዖኦፒ ላይታኔ፤","poem":1},{"text":"ዓንዲርሙማ ባይቂ ሜጌፃ ጴዻኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ናንጋ ዒዛኮ ጋፒ","poem":1},{"text":"ሼምፓሢያ ዒዛኮ ሃይቄ ዓሶ ዓጮ ኬዳኒ ዑኬኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"«ዓሲም ፒዜ ጎይሢ ዻዋያ","poem":1},{"text":"ሺያና ፓይዲንታ ፆኦሲ ኪኢታንቾፓ ፔቴይ","poem":2},{"lineBreak":true},{"text":"ዒዛ ባንሢ ሙኪ ዒዛ ማኣዳንዳያ ናንዳኔ፤","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ኪኢታንቻሢ ዒዛ ሚጪንቲ፦","poem":1},{"lineBreak":true},{"text":"‹ታ ዒዛ ዓይሳንዳ ጎይሢ ዴንቄሢሮ","poem":1},{"text":"ዒ ዱኡኪንቱዋጉዲ ዒዛ ሃሼ!› ጌዒ","poem":2},{"lineBreak":true},{"text":"ሃይቢ ዓይሣንዳኔ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዬያሮ ዑፃ ዒዛኮ ጊንሣ ናይ ዑሢ ማዓንዳኔ፤","poem":1},{"text":"ዑፃ ዒዛኮ ቤርታ ዼጌ ዓኣሢጉዲ ማዓንዳኔ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዒማና ዒ ፆኦሲ ሺኢቃንዳኔ፤","poem":1},{"text":"ሺኢጲፆዋ ፆኦሲ ዒዛኮ ዋይዛንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒዚያ ፆኦሲኮ ዓኣፖ ካሮ ዛጊ ዎዛዻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ፆኦሲያ ዒዛኮ ፂሉሞ ዛሎ","poem":2},{"lineBreak":true},{"text":"ዒዛም ማዓ ባኣዚ ጪጋንዳኔ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዬያሮ ዒዚ ዓሶ ቤርታ፦","poem":1},{"text":"‹ታ ጎሜ ማዼኔ፤","poem":2},{"lineBreak":true},{"text":"ፒዜ ባኮዋ ታ ዎቢሤኔ፤","poem":2},{"lineBreak":true},{"text":"ፆኦሲ ጋዓንቴ ታኣም ታኣኮ ዻቢንቶጉዴያ ሜቶ ዒንጊባኣሴ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ሃይቄ ዓሶ ዓጮ ኬዲሢፓ ዒ ታና ዓውሴኔ፤","poem":1},{"text":"ዓካሪ ሃሢ ሼምፔና ዓኣያ ማዒ ፖዒ ታ ዛጋኔ›","poem":2},{"lineBreak":true},{"text":"ጌይ ዓይናዻንዳኔ።»","poem":2}]},{"type":"verse","number":29,"content":[{"text":"«ሃሢ ፆኦሲ ዬያ ባኮ ቢያ","poem":1},{"text":"ዓሲም ማሂ ማሂ ማዻኔ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ናንጊኮ ፖዒ ዛጋንዳጉዲ","poem":1},{"text":"ሼምፓሢ ዱኡፓፓ ዒዛኮ ማሃኔ።»","poem":2}]},{"type":"verse","number":31,"content":[{"text":"«ዔኤዞ ዒዮቤ! ታ ኔኤም ኬኤዛሢ ኮሺ ዋይዜ፤","poem":1},{"text":"ሂንዳ ኔ ዚቲ ጌዔ፥ ታ ኔኤም ኬኤዞም።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ኔ ጋዓ ባኣዚ ዓኣቶ ማሂ ታኣም ኬኤዜ፤","poem":1},{"text":"ታ ኔና ዓይላቶፓ ኬሳኒ ኮዓሢሮ ኔ ጌስቴ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ሃንጎ ዚቲ ጌይ ታ ጋዓሢ ዋይዜ፤","poem":1},{"text":"ታ ኔና ዔራቶ ዔርዛንዳኔ» ጌዔኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}