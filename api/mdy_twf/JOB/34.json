ፑርታ ማዻያኬ፤","poem":1},{"text":"ዒ ፔኤቃሢያ ፑርቶ ማዻዞንሢናኬ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"‹ፆኦሲ ዎዛሲሢ","poem":1},{"text":"ዓሲም ዓይጎዋ ማኣዱዋሴ› ዒ ጋዓኔ።»","poem":2}]},{"type":"verse","number":10,"content":[{"text":"«ሂንዳ ዒንሢ ማሊ ጶቂሣያ ማዔ ዓሳ ዋይዙዋቴ!","poem":1},{"text":"ፆኦሲ ፑርታ ባኣዚ ማዻኒ","poem":2},{"lineBreak":true},{"text":"ዻቢንቲያ ማዻኒ ቢያ ባኮ ዳንዳዓ ጎዳፓ ሃኮም!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ፆኦሲ ዓሲም ዓሢ ማዼማ ጉዴያ ጪጋኔ፤","poem":1},{"text":"ዒ ሃንቴማ ጎይፆዋ ኮይሳሢጉዴያ ማዻኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ቢያ ባኮ ዳንዳዓ ጎዳሢ","poem":1},{"text":"ፔቴታዖ ፑርታ ባኣዚ ማዹዋሴ፤","poem":2},{"lineBreak":true},{"text":"ዖጊዳኣ ዒ ዎጌ ዎቢሱዋሴ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዓጮ ፆኦሲ ዎይሣንዳጉዲ","poem":1},{"text":"ፆኦሲም ሃዳራና ዒንጌ ዓሲ ባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ዓጮ ዑፆይዳ ዒዛ ሱኡጌ ማሂ ዶኦሬ ዓሲያ ባኣሴ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ፆኦሲ ፔኤኮ ዓያኖንታ ዑኡዞዋ","poem":1},{"text":"ፔ ባንሢ ማሃኒ ማሌቴ፥","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዓሲ ዜርሢ ፔቴና ቢያ ባይቄያናንዳኔ፤","poem":1},{"text":"ጊንሣ ዓጮ ባንሢያ ማዔያ ናንዳኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኔ ማሊ ጶቂሣያታቴ ሃያ ዋይዜ፤","poem":1},{"text":"ታ ጌኤዞዋ ዒናፓ ዋይዜ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ፒዜ ዎጌ ዒፃያ ዎይሣኒ ዳንዳዓ?","poem":1},{"text":"ፂላሢና ዼኤፖ ፆኦዛሢና ኔኤኒ ዻቢንቴያኬ ጋዓኒ ዳንዳዓ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ካኣቲ ኮይላ፦ ‹ኔ ፓሡዋያኬ›","poem":1},{"text":"ፖኦሊሶ ዓይሣ ሱኡጎዋ፦","poem":2},{"lineBreak":true},{"text":"‹ዒንሢ ፑርታኬ› ዔያቶ ጋዓይ ዖናዳይ?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ቢያሢ ማዤሢ ፆኦሲታሢሮ","poem":1},{"text":"ዒዚ ፖኦሊሶ ሱኡጎ ዛላ ሌሊ ዔቃዓኬ፤","poem":2},{"lineBreak":true},{"text":"ዖርጎጫሢ ማንቃሢፓ ዱማሳዓኬ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሳዓ ጊዲሚሺ ማዓዛ ዓሲ ቤዛ ሃይቃኒ ዳንዳዓኔ፤","poem":1},{"text":"ዒዚ ጎጋይቃንቴ ሼምፓሢ ዒዛኮ ኬስካኔ፤","poem":2},{"lineBreak":true},{"text":"ዎልቆና ዓኣ ዓሳ","poem":2},{"lineBreak":true},{"text":"ዓሲ ዔያቶ ፔ ኩቻ ካኣሙዋንቴ ባይቃንዳኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ፆኦሲ ዓሲኮ ቢያ ሃንቲፆ ፓይዲ ዛጋኔ።","poem":1},{"text":"ፔቴ ፔቴሢኮ ሃንቲፆዋ ዒ ካፓኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ፑርቶ ማዻ ዓሳ ዓኣሺንታ ቤሲ፥","poem":1},{"text":"ሻኔ ዹሚያኣ ፔቴታዖ ባኣሴ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ፆኦሲ ዓሲ ዎጌም ፔ ቤርቶ ሺኢሻኒ","poem":1},{"text":"ሺኢካንዳ ኬሊ ጌሡዋሴ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዎይሣ ዓሶ ቢታንታፓ ኬይሲ","poem":1},{"text":"ዔያቶ ቤዛ ሜሌ ጌሣኒ","poem":2},{"lineBreak":true},{"text":"ዔሮንዶ ጎይሢያ ዖኦጪ ዛጋኒ ዒዛ ኮይሱዋሴ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዬያሮ ማዾ ዔያቶሲ ዔሪ","poem":1},{"text":"ፔቴ ዋንቴና ቢታንታፓ ዒ ኬይሲ ባይዛኔ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዔያታ ማዼ ዋይዞ ዒፆ ዛሎሮ","poem":1},{"text":"ጎሞ ዓሶ ዓሲ ቤርታ ዒ ሜታሳንዳኔ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዬያ ዔያቶይዳ ዒ ማዻሢ","poem":1},{"text":"ዒዛ ጊንፆ ሃንቲፆ ዔያታ ሃሼሢሮና","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ዓይሢፆዋ ዔያታ ቶኦቼሢሮኬ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ማንቆ ዓሶ ዔያታ ሄርቂሢና","poem":1},{"text":"ፆኦሲ ባንሢ ዒላታንዳጉዲ ማሄኔ፤","poem":2},{"lineBreak":true},{"text":"ፆኦሲያ ማንቆ ዓሶኮ ዒላቶ ዋይዜኔ።»","poem":2}]},{"type":"verse","number":29,"content":[{"text":"«ፆኦሲ ጉሙርቁዋያ","poem":1},{"text":"ፔኤኮ ዴሮም ዔቴ ቦኦካ ካኣታ ካኣታዻዛ","poem":2},{"lineBreak":true},{"text":"ፆኦሲ ዚቲ ጌይ ዛጌቴ","poem":2},{"lineBreak":true},{"text":"ዴራ ዓይጎ ዎኦታኒ ዳንዳዓይ?»","poem":2}]},{"type":"verse","number":31,"content":[{"text":"«ዓሲ ፆኦሲም ሂዚ ጌዔቴ ኮሺኬ፦","poem":1},{"text":"‹ታኣኒ ዻቢንቴያኬ፤ ጋዓንቴ","poem":2},{"lineBreak":true},{"text":"ሃካፓ ሴካ ታኣኒ ዻቢንታዓኬ፤","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ታኣኒ ማዼ ጎማ ዎኖታቴያ ታና ዔርዜ፤","poem":1},{"text":"ታ ዻቤያ ማዔቴ ማይ ላሚ ታኣኒ ማዻዓኬ›","poem":2},{"lineBreak":true},{"text":"ጌዔ ዓሲ ዓኣ?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ዓካሪ ኔኤኒ ፆኦሲ ማኪ ጌስቲፆ ሃሾ ዒፄኔ፤","poem":1},{"text":"ዬያሮ ዒዚ ኔና ሜታሴ ጎይሣ ዴዓንዳጉዲ ኔ ኮዓ?","poem":2},{"lineBreak":true},{"text":"ዬያ ዛሎ ዔራሢ ኔናኬ፥ ታናቱዋሴ፤","poem":2},{"lineBreak":true},{"text":"ሂንዳ ኔ ጋዓ ባኮ ማሂ ታኣም ኬኤዜ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"«ታኣም ዋይዛ ዓሳ ሂዚ ታኣም ጋዓኔ፤","poem":1},{"text":"ጶቂሢ ማላ ዓሳኣ ሂዚ ጋዓኔ፦","poem":2}]},{"type":"verse","number":35,"content":[{"text":"‹ዒዮቤ ኬኤዛሢ ዔሩዋዖኬ፤","poem":1},{"text":"ዒዛኮ ሃይሳኣ ካኣፒኬ›","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ፑርቶ ዓሶጉዲ ዒ ማሂ ኬኤዛሢሮ","poem":1},{"text":"ዒ ጋፒንፆ ሄላንዳኣና ዎይታቴያ ዛጊንታቴ ዓይጎ!","poem":2}]},{"type":"verse","number":37,"content":[{"text":"ዒ ጎሜይዳ ጎሜ ቃሳኔ፤","poem":1},{"text":"ኑ ባኣኮይዳታዖ ቦሂሢና ኩቺ ዒ ባዓኔ፤","poem":2},{"lineBreak":true},{"text":"ፆኦሲ ዑፆይዳ ማኪሢ ጌኤሲ ዒ ጌስታኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":36}