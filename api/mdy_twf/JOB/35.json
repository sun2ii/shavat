{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":["ዔሊሁ ሃሣ ጌስታዖ፦"]},{"type":"verse","number":2,"content":[{"text":"«ዔዞ ዒዮቤ! ኔኤኒ ፆኦሲ ቤርታ ታኣኒ ፂሎኬ ጌይፃ","poem":1},{"text":"ኔኤኮ ፒዜዳ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"‹ጎሜ ታ ማዺባኣቴ ታና ዓይጎ ማኣዳንዳይ?","poem":1},{"text":"ሃሣ ዓይጎ ታ ዴንቃንዳይ?›","poem":2},{"lineBreak":true},{"text":"ጌይ ፆኦሲ ኔ ዖኦጫያ ናንዳኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሃሢ ታኣኒ ኔናንታ ኔኤና ዎላ ዓኣ","poem":1},{"text":"ኔኤኮ ላጎም ማሂ ታ ኬኤዛንዳኔ። »","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«ሌካ ዼግ ጌይ ጫሪንጮ ባንሢ ዛጌ፤","poem":1},{"text":"ሌካ ዑፃ ኔኤኮ ዓኣ ሻኣሮ ኮሺ ማሊ ዛጌ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ጎሜ ኔ ማዼቴ ፆኦሲኮ ኔ ዓይጎ ዎኦታንዳይ?","poem":1},{"text":"ዻቢንቲ ኔ ሚርጊሼቴያ ዒዛ ኔ ዎዳንዳይ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ፂሎ ኔ ማዔቴ ዒዛም ኔ ዓይጎ ዒንጋንዳይ?","poem":1},{"text":"ዒዚ ኔጊዳፓ ዓይጎዋ ኮዑዋሴ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጎሜ ኔ ማዼቴ ኔ ፑርቲሳንዳሢ ኔናጉዴ ዓሲኬ፤","poem":1},{"text":"ኮሺ ማዾ ኔ ማዼቴ ዓሲ ኔ ፓሣንዳኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሄርቂ ዎይሥሢ ሚርጋዛ ዓሲ ዒዒላታኔ፤","poem":1},{"text":"ዔያቶይዳ ዎልቃዻሢ ኩጫፓ ዔያቶ ዓውሳንዳያ ዴንቃኒ","poem":2},{"lineBreak":true},{"text":"ኑና ዓውሴ ጌይ ዒላታኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጋዓንቴ ዔያቶይዳፓ ፔቴ ዓሲታዖ፦","poem":1},{"text":"‹ዎዛ ዓይኑሞ ዹሞና ኑ ዓይናዻንዳጉዲ ማሃ፥","poem":2},{"lineBreak":true},{"text":"ኑናኣ ማዤ ፆኦዛሢ ዓንካ ዓኣይ?› ጌይ ዖኦጫይ ባኣሴ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ቆልሞይዳፓ ባሼ ማሂ ኑና ዔርዛሢ","poem":1},{"text":"ካፖይዳፓኣ ዑሣ ዓኣዼ ዔሮ ኑና ማሃሢ ዒዛኬ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዔያታ ዒላታኔ፤","poem":1},{"text":"ዒዚ ጋዓንቴ፦ ዔያታ ዖቶርቃያና ፑርታ ማዔሢሮ","poem":2},{"lineBreak":true},{"text":"ማሂ ዔያቶም ዒ ኬኤዙዋሴ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ጎኔና ፆኦሲ ዒናፓ ማዒባኣ ዒላቲ ዋይዙዋሴ፤","poem":1},{"text":"ቢያ ባኮ ዳንዳዓ ጎዳሢ ዬያ ዛጋያቱዋሴ።»","poem":2}]},{"type":"verse","number":14,"content":[{"text":"«ዎዚ ‹ታኣኒ ፆኦሲ ዛጋዓ› ኔ ጌዔቴያ","poem":1},{"text":"ኔ ሃይሳ ዒዛ ቤርታታሢሮ","poem":2},{"lineBreak":true},{"text":"ኔ ዒዛ ጊቢ ዳንዳዒ ካፓንዳያ ኮይሳኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ፆኦሲ ዓሲ ዻጋዺ ጎሩዋያ","poem":1},{"text":"ሃሣ ዓሲኮ ጎሜያ ቄል ጌይ ሃሻያ ኔኤም ማላ?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዔዞ ዒዮቤ! ኔ ጉሪ ሃይሴ ሚርጊሻኔ፤","poem":1},{"text":"ዔራቶ ባኣያ ጉሪ ዑኡሲና ኔ ጌስቲ ሺራኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}