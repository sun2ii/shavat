},{"type":"verse","number":8,"content":[{"text":"ጋዓንቴ ዓሲ ካኒ ቢራታና ቱኡቴቴ","poem":1},{"text":"ሃንጎ ሃሣ ሜቶ ፒሮና ዓዺንቴቴ","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዔያታ ፔኤኮ ዖቶርሙሞና ማዼ ጎሞ","poem":1},{"text":"ፔጋሲ ዻዋኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዔያታ ዞሮ ዋይዛንዳጉዲ ዋዮ ዔያቶኮ ዒ ቡላኔ፤","poem":1},{"text":"ዔያታ ፔኤኮ ፑርቶ ማዻፓ ማዒ ጎሞ ቡኡፃንዳጉዲ ዓይሣኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ፆኦሲም ዔያታ ዓይሢንቲ ዒዛም ዔያታ ማዼቴ","poem":1},{"text":"ዔያታ ናንጋኒ ዓኣ ዎዶ ዖርጎቹሞና ዎዛና ናንጊ ዓኣሣንዳኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዒዛም ዔያታ ዋይዚባኣቴ ጬንቻ ዓፓሮና ዔያታ ባይቃንዳኔ፤","poem":1},{"text":"ዔኤቢ ዔሪባኣ ጎይሣ ዓኣዖ ዔያታ ሃይቃንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«ፔኤኮ ዒኖና ‹ፆኦሲ ኑ ዔሩዋሴ› ጋዓ ዓሳ","poem":1},{"text":"ቢያ ዎዴ ዎዛዺሢባኣ ናንጊ ናጋኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ሜቶይዳ ጌሌቴታዖ ማኣሪንቲሢ ዴንቃኒ ዒዛ ሺኢቁዋኣሴ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዞኦስካ ኮኦሚፆና ቦርሲሳ ናንጊ ዔያታ ናንጋሢሮ","poem":1},{"text":"ሃጊ ዼጌ ዓኣዖ ዔያታ ሃይቂ ባይቃንዳኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ፆኦሲ ዋኣዪንቲሢዳ ዓኣ ዓሶ ዋኣዪፆፓ ዓውሳኔ።","poem":1},{"text":"ዔያቶ ሄሌ ሜታሢና ዔያቶ ዒ ጪንጪሳኔ።»","poem":2}]},{"type":"verse","number":16,"content":[{"text":"«ሃሢ ፆኦሲ ማላ ማሊፃ","poem":1},{"text":"ሜቶይዳፓ ኔና ኬሲ","poem":2},{"lineBreak":true},{"text":"ዶኦሪንቴያ ማዔ ሙዖ ባንሢ ኔና ዔኪ ዓኣዻኒኬ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሃሢ ዻቢንቴ ዓሲም ዎጊንታ ዎጌ ኔጊዳ ዎጊንቴሢሮ","poem":1},{"text":"ኔኤም ኮይሳ ሜቶ ኔ ዔኪሢዳኬ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዓይጎ ዓሲያ ቆሎ ሚርጉሞና ኔና ዻቢሱዋጉዲ","poem":1},{"text":"ዴሜና ዒንጎ ሚኢሼና ኔና ጌሹዋጉዲ ኔና ዔሬ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኔኤኮ ቆሎና ቢታንቶና ዎዚዒ ዼጌ ማዔቴያ","poem":1},{"text":"ዋኣዪሢዳፓ ኔና ዬይ ዓውሱዋኣሴ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዴራ ፔኤኮ ዓኣ ቤዛፓ ባይቃንዳ","poem":1},{"text":"ዹሞ ዎዳ ሙካንዳጉዲ ኮዒፖ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ፑርታ ባኣዚ ኔ ማዻሢዳፓ ሜታዺ ኔኤኮ ዋኣዪንቲፃ ኮሺኬ፤","poem":1},{"text":"ላሚ ጊንሣ ፑርታ ባኣዚ ኔ ማዹዋጉዲ ኮሺ ኔና ዔሬ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ፆኦሲኮ ዎልቃ ዎዚጉዲ ዼኤፒታቴ ማሊ ጶቂሤ፤","poem":1},{"text":"ዔርዛያፓ ቢያ ዒዚ ባሼ ዔርዛያኬ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"‹ሃያይዴ› ጌይ ዒዛ ዓይሣይ","poem":1},{"text":"‹ፑርታ ማዾ ኔ ማዼኔ› ጌይያኣ ዒዛ ጎራንዳይ ዖናዳይ?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዓሳ ቢያ ዎዴ ዒ ማዼ ማዾሮ","poem":1},{"text":"ዓይኑሞና ዒዛ ጋላታሢጉዲ","poem":2},{"lineBreak":true},{"text":"ኔኤኒያ ዒዛኮ ማዾ ዓይኑሞና ጋላቴ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ፆኦሲኮ ማዾ ዓሲ ዜርሢ ቢያ ዛጌኔ፤","poem":1},{"text":"ዓሳ ሃኬና ዬያ ዴንቃኔ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዒዛኮ ዼኤፑሞ ዖኦጪ ኑ ዔራኒ ዳንዳዑዋኣሴ፤","poem":1},{"text":"ዒ ናንጋ ዎዳኣ ሃይማዼኬ ጌይ ፓይዲ ዔርታያቱዋኣሴ።»","poem":2}]},{"type":"verse","number":27,"content":[{"text":"«ፆኦሲ ባዞ ዋኣፆ ሱኡሌና ሌካ ዔቂሳኔ፤","poem":1},{"text":"ጫሪንጫፓ ዒርዚ ማሂያ ዋርቂሳኔ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ሻኣሮይዳፓ ዒራ ዲጲጉዲ ዎታኔ፤","poem":1},{"text":"ዓሶ ዑፆይዳኣ ሚርጌና ዋርቃኔ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ያዺ ማዔቴያ ፆኦሲ ሻኣሮ ዎማይዲ ላይሣቴያ","poem":1},{"text":"ሃሣ ጉጉንፆና ማዒ ዎማይዲ ጌስታቴያ","poem":2},{"lineBreak":true},{"text":"ዖኦኒ ዔራኒ ዳንዳዓይ?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ፆኦሲ ዔቶ ባዞ ካንቂ","poem":1},{"text":"ዜኤሊንፆዋ ጫሪንጮ ቢያ ዳካ ጎይፆ ዛጌ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ዬያይዲ ፆኦሲ ዴሮ ዎይሣኔ፤","poem":1},{"text":"ሙኡዚያ ሚርጌና ዔያቶም ዒ ጊኢጊሻኔ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ዜኤሊንፆ ፔ ኩጮና ዒ ዓርቃኔ፤","poem":1},{"text":"ጌይንቴ ጊንፆ ባንሢ ዓኣዻንዳጉዲያኣ ዓይሣኔ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ጉጉንሢ ዼኤፒ ዒርዚ ዬዓሢ ዔርዛኔ፤","poem":1},{"text":"ቆልሞዋ ዢኢፓ ዒርዚ ሙካሢ ዔዔራኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}