{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":[{"text":"«ዢኢፖ ዒሮ ዎልቆና ዒና ታኣኮ ዲቃቴኔ፤","poem":1},{"text":"ዒጊቹሞናኣ ጎጋይቄኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዒዛኮ ዻንጋፓ ኬስካ ዑኡዞ ዋይዙዋቴ፤","poem":1},{"text":"ጉጉንፆጉዲ ጉጉንሣ ቃኣሎ ዒዛሲ ዋይዙዋቴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዜኤሊንፆ ጫሪንጮ ዴሞ ቢያ ዳካኔ፤","poem":1},{"text":"ሳዖኮ ጋፖ ሄላንዳኣና ዳኪ ሄሊሳኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዬካፓ ፔኤኮ ዎልቆ ዑኡዞ ዒ ጉኡሚሳኔ፤","poem":1},{"text":"ዒጊቻ ዑኡዞዋ ጉጉንሢጉዲ ማሂ ዋይዚሳኔ፤","poem":2},{"lineBreak":true},{"text":"ዜኤሊንፃ ዒዛኮ ላሚ ላሚ ዜኤሊንሣኔ።","poem":2},{"lineBreak":true},{"text":"ዲቃሣያ ማዔ ዑኡዞና ዒ ጉጉንሣኔ፤","poem":2},{"lineBreak":true},{"text":"ዑኡዞ ዒ ዋይዚሳ ዎዶና ዜኤሊንፆ ዒዚ ላኣጉዋሴ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ፆኦሲ ዲቃሢ ሄርሺሳያ ማዔ ዑኡዞና ጉጉንሣኔ፤","poem":1},{"text":"ኑ ዔራኒ ዳንዳዑዋ ዼኤፒ ዼኤፒ ባኣዚ ዒ ማዻኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሻቺ ሳዖይዳ ዒ ኬይሳኔ፤","poem":1},{"text":"ዼኤፒ ዒርዚያኣ ዋርቃንዳጉዲ ዓይሣኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዒ ማዤ ዓሳ ዒዛ ማዾ ዔራንዳጉዲ","poem":1},{"text":"ዓሲ ቢያ ፔ ማዾ ሃሻንዳጉዲ ዒ ማሃኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዒማና ካዮ ቦዓ","poem":1},{"text":"ዓኣሺንቲ ፔኤኮ ዓኣሺንቶ ቤዞ ጌላኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ፔኤኮ ዔታኣ ዔታ ዓኣሺንታኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዼኤፒ ዢባሬ ዾኦሎ ዛላፓ ዔቃኔ፤","poem":1},{"text":"ሺሜ ዢባሬያ ኬዶ ዛላፓ ሙካኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ፆኦሲ ዑኡዛ ዋኣፆ ሺሚሻኔ፤","poem":1},{"text":"ሻቺ ማሂያኣ ላኣማኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሻኣራ ዋኣሢ ዓርቃንዳጉዲ ዒ ማሃኔ፤","poem":1},{"text":"ዬያ ባኣካ ዜኤሊንሢያ ዜኤሊንሢሳኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዓይሤም ሻኣራ ዓጮ ቢያ ሺራኔ፤","poem":1},{"text":"ዒ ዓይሣ ባኮዋ ማዺ ኩንሣኒ ዔያታ ሃንታኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ፆኦሲ ዒርዚ ዋርቂሻሢ፦","poem":1},{"text":"ሳዖ ሎጪሳኒ","poem":2},{"text":"ዓሶ ሜታሳኒ","poem":1},{"text":"ሃንጎ ፔ ናሹሞ ቤኤዛኒኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«ዔዞ ዒዮቤ! ሂንዳ ሊኢጊ ዋይዜ፤","poem":1},{"text":"ፆኦሲ ማዻ ዲቃሢ ሄርሺሳ ማዾ","poem":2},{"lineBreak":true},{"text":"ዒና ዔኪ ጶቂሤ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ፆኦሲ ሻኣሮ ዎማይዲ ፓይዲ ዛጋቴያ","poem":1},{"text":"ዜኤሊንፆዋ ዎማይዲ ዜኤሊንሢሳቴያ ኔ ዔራ?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሻኣሮ ሌካ ዢባሮ ዑፃ ዒ ማሃሢና","poem":1},{"text":"ቢያ ባኮ ዔራ ፆኦሲኮ ዲቃሢ ሄርሺሳ ማዾ ኔ ዔራ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ጫሪንጫ ሞኦና ዓንጊጉዲ ዶዴ ዎዶና","poem":1},{"text":"ኔኤኒ ዓሲ ናንጉዋ ዳውሎ ዢባሮ ዖይዾና ዓልቃንዳኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ፆኦሲ ጫሪንጮ ዓልቄ ሌማሌኤሼጉዲ ቡሊ ዼጊዲ ሂኢሤቴ","poem":1},{"text":"ኔ ዒዛኮ ኮራ ማዒ ማኣዳኒ ዳንዳዓ?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኑኡኮ ዒና ዹሚ ማዔም","poem":1},{"text":"ኑኡኮ ሜቶ ኑ ሺኢሻኒ ዳንዳዑዋኣሢሮ","poem":2},{"lineBreak":true},{"text":"ፆኦሲም ዓይጎ ኑ ኬኤዛኒ ኮይሳቴያ ኔ ኑም ኬኤዜ፤","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ፆኦሲም ኬኤዛንዳኔ ጌዒ ዖኦጪሢና","poem":1},{"text":"ዒ ታና ባይዛንዳጉዲ ዓይጋ ታ ዒዛ ዔቂሳይ?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«ዢባራ ሻኣሮ ጫሪንጫፓ ዳኪ ፖዒሴ ዎዶና","poem":1},{"text":"ዖኦኒያ ዓቦ ጊዥ ጌይ ዛጋኒ ዳንዳዑዋኣሴ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ኬዶ ዛላፓ ዎርቄጉዲ ጌኤሺ ፖዔ ሙካንዳኔ፤","poem":1},{"text":"ፆኦሲያ ዲቃሢ ሄርሺሳ ዼኤፑሞና ፔጋዺ ጴዻንዳኔ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ፆኦሲ ዛጊንታኒ ዳንዳዓያቱዋሴ፤","poem":1},{"text":"ቢታንታ ዒዛኮ ዼኤፒኬ፤","poem":2},{"lineBreak":true},{"text":"ዒዚ ፒዜ ዎጋያኬ፥ ዒዚ ዖናኣ ሄርቂ ዎይሡዋኣሴ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ፔ ማሊፆና ‹ኑ ዔራኬ› ጋዓዞንሢ ዒ ቦሃሢሮ","poem":1},{"text":"ዓሲ ቢያ ዒዛ ዒጊጫኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}