{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":38,"content":[{"type":"heading","content":["ናንጊና ናንጋ ጎዳ ዒዮቤም ማሂ ኬኤዜ ባኮ"]},{"type":"verse","number":1,"content":["ናንጊና ናንጋ ጎዳ ዓልጎ ዢባሬና ማዒ ዒዮቤም ሂዚ ጌዔኔ፦"]},{"type":"verse","number":2,"content":[{"text":"«ሃይ ዔራቶባኣያ ጌስቲንታ ጌኤሲና","poem":1},{"text":"ታኣኮ ዞሮ ሼሌዒሲ ዛጋሢ ዒ ዖናዳይ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሂንዳ ታ ቤርታ ዓቲንቄ ማዒ ቱኡቲ ዔቄ፤","poem":1},{"text":"ታ ኔና ዖኦጫንዳኔ፥ ታኣም ማሂ ኬኤዜ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጎዖንቴ ታኣኒ ሳዖ ማዣኣና","poem":1},{"text":"ኔኤኒ ዒኢካ ዓኣ?","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ዔራያ ሃሣ ጶቂሣያ ማዔቴ ሂንዳ ታኣም ኬኤዜ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሳዓ ዬማዺ ማዖንጎ ጌዔሢ ዖናዳይ?","poem":1},{"text":"ዒዞኮ ዳልጉሞና ዖዶሱሞና ዔራኒ","poem":2},{"lineBreak":true},{"text":"ዋርቆ ሱዞ ዓርቄሢ ዖናታቴያ ኔ ዔራ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሳዖኮ ቱርቱሮ ዶዲሺ ዓርቄ ዎልቃ ዓይጌንዴዳይ?","poem":1},{"text":"ሳዖ ማዣኒ ቦኦኮልቄሢያ ዖናዳይ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ካሪፆ ዦኦጋሢ ፔቱሞና ዓይናዻኣና","poem":1},{"text":"ኪኢታንቻ ቢያ ዒላሻኣና ኔኤኒ ዓንካዳይ?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«ባዛ ሳዖ ዴማፓ ዹኡቂ ኬስኬ ዎዶና","poem":1},{"text":"ዑርቴ ካሮ ዎዼሢ ዖናዳይ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ባዞ ሻኣሮና ካንቄሢ","poem":1},{"text":"ሻኔ ዹሞናኣ ካንቂ ባይዜሢ ታናኬ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ባዛ ማዓንዳ ዛጶ ኮሼሢ","poem":1},{"text":"ካራና ቤሲና ዓኣያ ማዓንዳጉዲ ማሄሢ ታናኬ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሃይማ ሄላንዳኣና ሙኬ!","poem":1},{"text":"ሃይማፓ ዑሣ ዓኣዺፖ! ኔኤኮ ዼኤፖ ጉዳሢ ዢባራ","poem":2},{"lineBreak":true},{"text":"ሃይማካ ዔቆም! ጌዔሢ ታናኬ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዔዞ ዒዮቤ!","poem":1},{"text":"ኔ ናንጌ ዎዶይዳ ቢያ ፔቴታዖ ሳዓ ካራንዳጉዲ ዓይሢ ቤቂያ?","poem":2},{"lineBreak":true},{"text":"ሳዖ ካሪፆኮ ጌኤሽካ ቤዞ ኔ ጌሢያ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዬይ ካሪፃ ሳዖም ፖዓንዳጉዲ","poem":1},{"text":"ፑርቶ ዓሶዋ ዓኣሺንቴ ቤዛፓ ፔጋሲ ዻዋንዳጉዲ","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ዓይሢ ቤቂያ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሳዖ ካሪፆ ፖዓ ጌሜሮና ዶኦጮና","poem":1},{"text":"ጳንጪንቴ ዓፒላጉዲ ማዒ ጴዻንዳጉዲ ማሃኔ።","poem":2},{"lineBreak":true},{"text":"ዢኢጬ ዓጪና ቆኦቂ ኮሾና ማላታጉዲ ማሂያኣ ዼኤፒሲ ዻዋኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ፑርቶ ዓሳ ፖዒ ዴንቁዋጉዲ ላኣጊንቴኔ፤","poem":1},{"text":"ዋይዞ ዒፂሲ ጌኤታሳ ቃሳ ዔያቶኮ ሜቄኔ።»","poem":2}]},{"type":"verse","number":16,"content":[{"text":"«ሊካ ባዞ ዋኣፆ ዔቶ ኔኤኒ ኬዲያ?","poem":1},{"text":"ዼኤፖ ዋኣፆኮ ዴማ ዓኣ ሳዓ ኔ ሃንቲ ቤቂያ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሃይቄ ዓሶ ዓጮ ማዔ ዹሞ ዓጮኮ","poem":1},{"text":"ጌሎ ካራ ኔኤም ፔጋዺ ጴዼም ኔ ዛጊያ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሳዓ ዎዚዒ ዼኤፒታቴያ ኔ ዔራኒ ዳንዳዓ?","poem":1},{"text":"ሂንዳ ዬያ ቢያ ዔራያ ማዔቴ ታኣም ኬኤዜ። »","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«ፖዖ ባንሢ ዔኪ ዓኣዻ ጎይፃ","poem":1},{"text":"ሃሣ ዹማኣ ዓንካ ናንጋቴ ኔ ዔራ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ፖዖንታ ዹሞንታ ፔ ቤዞ ቤዞ ዔኪ ኔ ዓኣዻኒ ዳንዳዓ?","poem":1},{"text":"ዔያቶኮ ናንጎ ቤዞ ዔኪ ዓኣዻ ጎይፆ ኔ ዔራ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሳዓ ማዢንቴ ዎዶና ኔኤኒ ሾይንቲ ዓኣሢሮ","poem":1},{"text":"ጎኔኬ ኔኤኒ ዔራኔ!","poem":2},{"lineBreak":true},{"text":"ሚርጌ ሌዔያ ኔኤኒ ናንጌያኬ!»","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«ሻጮ ጌሦ ማኣሮ ኔኤኒ ጌሊያ?","poem":1},{"text":"ጊንሣ ሃሣ ቡኩሲ ጌሦና ሻጮ ኔኤኒ ዛጊያ?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዬያ ሻጮ ዖልዚ ዖልታኒ","poem":1},{"text":"ሜቶ ዎዴም ታኣኒ ጌሤያኬ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ፖዒ ዳኪንታ ቤዛ ዎካፓዳይ?","poem":1},{"text":"ሃሣ ጊንሣ ዖይዺ ዢባሬ ሳዖ ባንሢ ዳኪንታሢ ዓንካፓዳይ?»","poem":2}]},{"type":"verse","number":25,"content":[{"text":"«ዒሮም ኬዶንዶ ጎይፆ ጊኢጊሼሢ","poem":1},{"text":"ጉጉንፆና ዎላ ዓኣ ዢኢፖ ዒሮም","poem":2},{"lineBreak":true},{"text":"ጎይፆ ኮሼሢ ዖናዳይ?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዬያጉዲ ዖኦኒያባኣ ሳዖይዳ","poem":1},{"text":"ዓሲ ናንጉዋ ዳውሎ ቦኦላ","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዒርዚ ዋርቂሻሢ ዖናዳይ?","poem":1},{"text":"ካዮና ጉሮ ሳዖና ሎጪ","poem":2},{"lineBreak":true},{"text":"ሳዓ ማኣቲ ባቃልሳንዳጉዲ ማሃሢ ዖናዳይ?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ዒሮንታ ዖልኮንታ","poem":1},{"text":"ማዤሢ ዖናዳይ?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ዼኤፖ ሻጮንታ ዻኮንታ","poem":1},{"text":"ማዢ ኬሳሢ ዖናዳይ?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ጪኢዣ ዋኣፆ ሹቺጉዲ ዶዲሻኔ፤","poem":1},{"text":"ዼኤፖ ዋኣፆኮ ዴሞ ሻቺጉዲ ዶዲሻኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"«ፑንጫሮ ዦኦጎ ፔቴይዳ ኔ ቱካኒ ዳንዳዓ?","poem":1},{"text":"ዛኣፖ ዦኦጋሢያ ጋሢንቲ ዓኣ ሱዞ ዱኡዛኒ ኔ ዳንዳዓ?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ዦኦጋሢ ቢያ ፔ ዎዶና ዎዶና ኔ ኬሳኒ ዳንዳዓ?","poem":1},{"text":"ዦኦጎኮ ዓኒና ማቾና ዎላ ኔ ዔኪ ዓኣዻኒ ዳንዳዓ?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ጫሪንጫ ዎዚጉዴ ዳምቤና ዎርቃያታቴ ኔ ዔራ?","poem":1},{"text":"ዬይ ዳምባ ሳዖይዳ ማዺንታንዳጉዲ ማሃኒ ኔ ዳንዳዓ?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"«ሚርጌ ዒርዚ ኔኤም ዋርቂሳንዳጉዲ","poem":1},{"text":"ሻኣሮ ኔኤኒ ዓይሣኒ ዳንዳዓ?","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ዜኤሊንፃ ኔ ዓይሥሢና ዜኤሊንሣ?","poem":1},{"text":"ዔያታ፦ ‹ሃይሾ ኑ ሙኬኔ› ኔ ኮይላ ጋዓ?","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ዒሮ ማቻ ዒርዚ ዋርቃኒ ጋዓኣና ዖኦላንዳጉዲና","poem":1},{"text":"ኮይዳኣ ቂኢቃንዳጉዲ ዔያቶም ኬኤዛሢ ዖናዳይ?","poem":2}]},{"type":"verse","number":37,"content":[{"text":"ፔ ዔራቶና ሻኣሬ ፓይዳኒ ዳንዳዓይ ዖናዳይ?","poem":1},{"text":"ኩሊንቴ ዓጫ ዎዒ ቶርጴ ማዓንዳጉዲ","poem":2},{"lineBreak":true},{"text":"ዴዔ ቤዞ ጫሪንጫፓ ዋኣፆ ሊካ ላኣላሢ ዖናዳይ?","poem":2}]},{"type":"verse","number":39,"content":[{"text":"ካዮይዳ ካቲ ላሂ ዓኣንቴ","poem":1},{"text":"ዒንዴ ዞቢም ኬሞ ኔኤኒ ኬማ?","poem":2},{"lineBreak":true},{"text":"ዒዞኮ ናይዼ ናኣቶ ሙኡዛኒ ኔ ዳንዳዓ?","poem":2}]},{"type":"verse","number":40,"content":[{"text":"ዔያታ ዴኖ ቆኦፖይዳ ካፒ ዴዓኔ፤","poem":1},{"text":"ዴኤሎ ካዮ ባኣካኣ ላሃኔ።","poem":2}]},{"type":"verse","number":41,"content":[{"text":"ናኣታ ዒዞኮ ሙኡዚ ባይዚ ሜታዺ","poem":1},{"text":"ታ ባንሢ ዔያታ ዒላታኣና","poem":2},{"lineBreak":true},{"text":"ቁራኬሎም ሙኡዚ ዒንጋሢ ዖናዳይ?»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/37.json","previousChapterAudioLinks":{},"numberOfVerses":40}