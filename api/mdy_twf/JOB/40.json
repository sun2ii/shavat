{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":["ሄሊሳዖ ሃሣ ናንጊና ናንጋ ጎዳ ዒዮቤም፦"]},{"type":"verse","number":2,"content":[{"text":"«ዔዞ ዒዮቤ! ሂንዳ ቢያ ባኮ ዳንዳዓ ፆኦዛሢ፥ ታኣና","poem":1},{"text":"ዓሲ ማርሚ ላሣንዳያ ኔኤም ማላ?","poem":2},{"text":"ታና፥ ፆኦሲና ዎላ ማርማሢ ኔናታሢሮ","poem":1},{"text":"ሂንዳ ማሂ ታኣም ኬኤዜ» ጌዔኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዬካፓ ዒዮቤ፦","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"«ናንጊና ናንጋ ጎዳሢዮ! ታኣኒ ፓሡዋያ ላኣፓ ዓሲኬ፤","poem":1},{"text":"ሃካፓ ሴካ ታ ዻንጎ ታ ኩጮና ታ ዓርቂ","poem":2},{"lineBreak":true},{"text":"ዚቲ ጋዓንዳኣፓዓቴም","poem":2},{"lineBreak":true},{"text":"ማሂ ታ ኔኤም ኬኤዛ ባኣዚ ባኣሴ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ፔቴና ሃሣ ጊንሣ ላሚያኣ ታ ጌስቴኔ፤","poem":1},{"text":"ሃካፓ ሴካ ፔቴታዖ ታ ጌስታዓኬ» ጌዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዓልጎ ዢባሬና ማዒ ዒዮቤም ሂዚ ጌዔኔ፦","poem":1}]},{"type":"verse","number":7,"content":[{"text":"«ዔቂጋፓ ኬርኖ ኔኤኮ ዓቲንቄ ማይ ቱኡቴ፤","poem":1},{"text":"ታ ኔና ዖኦጫንዳኔ፤ ታኣም ማሂ ኬኤዜ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታና ኔኤኒ ዻቢንቲ ዎጋያ ማሂ ጌስቲ ጌስቲ","poem":1},{"text":"ኔና ኔኤኒ ጌኤሺ ማሃኒ ማላ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዓካሪ ዎልቃ ኔኤኮ ታ ዎልቆጉዴያ ዶዲዳ?","poem":1},{"text":"ሃሣ ዑኡዛ ኔኤኮ ታ ዑኡዞጉዴያ ዎልቃዻያዳ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ያዺ ማዔያታቴ ኔ ቶኦኮ ዒጊቻያ ማሂ ቦንቺሴ፤","poem":1},{"text":"ቦንቾና ዼኤፑሞና ኔ ዔኬ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዖቶርቃ ዓሶ ዛጊ ዔያቶ ቦርሲሴ፤","poem":1},{"text":"ኔኤኮ ዻጎዋ ዔያቶ ዑፃ ጮኦሽኬ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ቢያሢ ኮሺ ዛጊ ዔያቶ ቦርሲሴ፤","poem":1},{"text":"ፑርቶ ዓሶ ዔያታ ዓኣ ቤዛ ዓኣንቴ ባይዜ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዓጪ ዔያቶ ዑፃ ማሂ","poem":1},{"text":"ቢያሢ ፔቴይዳ ዱኡኬ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዬካፓ ታኣኒ ታ ዛሎና","poem":1},{"text":"ኔኤኒ ኔ ዎልቄና ዖሊ ባሻያ ማዔሢ ማርካዻንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«ታኣኒ ኔናንታ ሃይላሻሢንታ ማዤኔ፤","poem":1},{"text":"ሃይላሻሢ ጌማይጉዲ ማኣቲ ሄንቃኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዒዛኮ ጊኢሮይዳ ዓኣ ዶዱሞና","poem":1},{"text":"ጎጶ ጋራ ዓኣ ሻዦ ዶዱሞዋ ዛጌ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዑንካ ዒዛኮ ዚቢቂ ሚሢጉዲ ፒዝ ጌዔያኬ፤","poem":1},{"text":"ጉባዞ ሻዣ ዒዛኮ ዓንዲሪ ሃሣ ዶዲኬ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሜጌፃ ዒዛኮ ሞኦና ዓንጊጉዲኬ፤","poem":1},{"text":"ሃሣ ዓንጊ ኮኦሎጉዲያኣ ዶዲኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«ታ ማዤ ማዢንቶይዳፓ ቢያ ዒ ዎልቄና ዓኣያኬ፤","poem":1},{"text":"ታጊዳፓዓቴም ዒዛ ባሻይ ባኣሴ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ካዮ ቦዓ ፂካ ዹካ","poem":1},{"text":"ዒዛም ሄንቆ ማኣቶ ባቃልሳኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሚሢ ሺቢና ማጫሬና ባኣካ","poem":1},{"text":"ሃሣ ጫሮ ባኣካኣ ዒ ላሃኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ሺባ ዓኣ ሚፃ ፔ ሺቦና ዒዛ ዓኣቻኔ፤","poem":1},{"text":"ዎሮ ዓጫ ባቃላ ዓሃያ ጌይንታ ሚፃኣ ዒዛ ዓኣቻኔ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዎሮይዳ ዋኣፆ ኩሙፃ ዒዛ ፔቴታዖ ዲቃሡዋኣሴ፤","poem":1},{"text":"ዮርዳኖሴ ዎራታዖ ዓጮ ኬስኪ ሄላንዳኣና ኩሜቴያ ዒዚ ዒጉጩዋኣሴ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዓኣፖ ዒዛኮ ዎዺ ሲኢዾዋ ዒዛኮ ዑሪ","poem":1},{"text":"ዒዛ ዓርቃኒ ዳንዳዓይ ዖናዳይ?»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}