":"verse","number":22,"content":[{"text":"ዒዛኮ ዴዔ ባቃና ዎልቄና ዓኣያኬ፤","poem":1},{"text":"ዓኣፖ ካራኣ ዒዛኮ ሚርጌና ዒጊቻያኬ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዓሽካ ዒዛኮ ዎሊ ዑፃ ናቲንቴያ ዳዶታሢሮ","poem":1},{"text":"ዑፃ ዒዛኮ ዓንጊጉዲ ዶዳኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዒና ዒዛኮ ሹቺጉዲኬ፤","poem":1},{"text":"ዶዱማኣ ዎንሢ ሹቺጉዲኬ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዬይ ቦዓሢ ዔቃ ዎዶና","poem":1},{"text":"ዎልቆ ዓሳታዖ ዒጊጪ ጎጎጋይቃኔ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዓይጎጉዴ ጬንቻ ዓፓሮንታ ዎርሢንታ","poem":1},{"text":"ሂኢሺንታ ጫርጎ ባኣዚያ ዔኤቢ ዒዛ ዎኦቱዋሴ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዒዚ ዓንጎ ማኣቲጉዲ ሜንሣኔ፤","poem":1},{"text":"ሞኦኖ ዓንጎዋ ሙርዔ ሚሢጉዲ ጋኣጫኔ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ሂኢሺ ዱኮናቴታዖ ዒጊጪ ዒ ጳሽኩዋኣሴ፤","poem":1},{"text":"ዎራ ሹቺ ዒዛ ኮይላ ጎቦጉዲኬ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ኮኦሎ ዒዚ ዓዳ ማኣቲ ማሂ ዛጋኔ፤","poem":1},{"text":"ዓሳ ዒዛ ዎርፆና ዶርባኣና ዒ ቦሂ ሚሚኢጫኔ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ዾቃሎይዳ ዒ ኮላዻኣና ዓጬ ማዔ ዒልዓ ዒዛኮ","poem":1},{"text":"ሳዖ ማራሻጉዲ ጳላኔ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ባዞ ዋኣፆዋ ፔንታ ዋኣሡጉዲ ቡርቂሻኔ፤","poem":1},{"text":"ዖቲ ጋርካ ፔንታ ዛይቴጉዲያኣ ዒ ቡርቂሻኔ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ዒዚ ዓኣዻ ጎይፃ ፖፖዓኔ፤","poem":1},{"text":"ባዞ ዋኣፆዋ ዒ ዱባሳኔ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ዒዚ ዒጊቹሞ ዔሩዋ ማዢንቲታሢሮ","poem":1},{"text":"ዓጪዳ ዒዛ ማላ ማዢንቲ ፔቴታዖ ባኣሴ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ሚርጌና ዼኤፖ ማዔ ማዢንቶታዖ ዒ ቦሃኔ፤","poem":1},{"text":"ዒዚ ካዮ ቦዖ ቢያኮ ዑፃ ካኣቲኬ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":34}