{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"«ሌዋታኔ ጌይንታ ባዞ ቦዓሢ","poem":1},{"text":"ዓንጊ ኪሬና ባዛፓ ኔ ዓርቃኒ ዳንዳዓ?","poem":2},{"lineBreak":true},{"text":"ዒንዲርዞ ሱሲና ኔ ዒዛኮ ቱካንዳ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዒዛኮ ሲኢዾይዳ ዱንዶ ዓኣሢ","poem":1},{"text":"ባንጋሎዋ ዒዛኮ ዓንጊ ኪሬና ጫርጊ ዓርቃኒ ኔ ዳንዳዓ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዒዛ ማኣሪ ሃሻንዳጉዲ ዒ ኔና ሺኢቃንዳ?","poem":1},{"text":"ኮሺ ዑኡሲና ዒ ኔና ሺኢቃዳ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ናንጊና ዓይሌ ማዒ ኔኤም ማዻኒ","poem":1},{"text":"ኔኤና ዎላ ዒ ጌስቲ ጊኢጋንዳ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ካፒጉዲ ዒዛ ኔ ቱጊ ጌሢ","poem":1},{"text":"ዉዱሮ ናኣቶ ኔኤኮ ዓማልሳንዳጉዲ ቃዛኒ ዳንዳዓ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሞላሢ ኮርማ ዓሳ ዒዛ ባሺ ዔካንዳኔ ጌይ","poem":1},{"text":"ዎላ ማንዲንታ?","poem":2},{"lineBreak":true},{"text":"ቲቂያ ዎሊና ዒዛ ዔያታ ጊሽታ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኔ ኮዔ ካራና ዒልዖ ዒዛኮ ጫርጊ ዑራኒና","poem":1},{"text":"ቶኦኮዋ ዒዛኮ ኔ ዓጬ ዓንጊና ጫ