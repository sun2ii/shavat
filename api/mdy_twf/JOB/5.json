rse","number":7,"content":[{"text":"ታሚ ቄንሢዳፓ ፂንቂ ዓኣዻሢጉዲ","poem":1},{"text":"ዓሲያኣ ሜቶም ሾይንታኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«ዎንዴ ታኣኒ ኔናታቴ ፆኦሲ ባንሢ ሺኢኪ","poem":1},{"text":"ሜታሢ ታኣኮ ቢያ ዒዛም ታ ኬኤዜያ ናንዳኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዒዚ ፓይዲንቱዋያ ማዔ ዒዛ ዎልቆና ማዺንታ ማዾ","poem":1},{"text":"ሃይማኬ ጌይ ዔርቱዋ ዼኤፒ ባኣዚ ማዻኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሳዖይዳ ዒርዚ ዋርቂሳኔ፤","poem":1},{"text":"ጎዦዋ ዋኣሢና ሎጪሳኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ቶኦቺንቴዞንሢ ቦንቺሲ ዼጊዳኔ፤","poem":1},{"text":"ዖዬዞንሢያ ዶዲሺ ዎዛሳኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ዔያቶኮ ማዻ ጊኢጉዋጉዲ ጌኖ ዓሶኮ ማሊፆ ጉሪ ማሃኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዔሮ ዓሶ ዔያቶኮ ጌና ፒሮጉዲ ዓርቃንዳጉዲ ዒ ማሃኔ፤","poem":1},{"text":"ጌኖ ዓሶኮ ማሊፃኣ ሩኡሪና ባይቃኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሮኦራ ዔያቶም ዹሚ ማዓኔ፤","poem":1},{"text":"ሃጊ ዓባ ሳዛ ዓኣንቴ፥ ዋንቶ ዹሞይዳ ዓኣያጉዲ ዔያታ ዹቃዻኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ማንቆ ዓሶ ዔያቶ ሞርኮኮ ጬንቾ ዓፓራፓ ፆኦሲ ዓውሳኔ፤","poem":1},{"text":"ሜታዼ ዓሶዋ ሄርቂ ሜታሳ ዓሶ ዴማፓ ዒ ኬሳኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ማንቆ ዓሶም ሃጊ ማዓንዳ ዎዛ ዒንጋኔ፤","poem":1},{"text":"ዋይዚ ዒፂሢያ ዒዚ ዓጪፓ ጋፒሲ ባይዛኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«ፆኦሲ ዞሪ ጎራ ዓሲ ዓንጂንቴያኬ!","poem":1},{"text":"ዬያሮ ዼኤፖ ፆኦዛሢኮ ጎሮ ቦሂፖ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ፆኦሲ ኔና ሜንሤቶ ማሂ ዒ ኔና ኮኦላኔ፤","poem":1},{"text":"ፔቴ ኩጮና ኔና ዒ ሜንሤቶ ባጎ ኩጮና ኔና ፓሣኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ባይዛ ሜቶ ላሆይዳፓ ዒ ኔና ዓውሳንዳኔ፤","poem":1},{"text":"ላንካሳሢናኣ ዓይጎ ሜታኣ ኔና ሄላዓኬ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ናዮ ዎዶና ሼምፔና ኔና ዒ ጌሣኔ፤","poem":1},{"text":"ዖሎ ዎዶናኣ ሃይቢፓ ኔና ዒ ዓውሳኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ፆኦሲ ፑርታ ዒንዲርሲዳፓ ኔና ካፓኔ፤","poem":1},{"text":"ባይሲንታ ሙኬቴያ ኔ ዒጊጫዓኬ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ፑርታ ዖልዚና ናይዚና ሙኬ ዎዶና ኔኤኒ ሚሚኢጫንዳኔ፤","poem":1},{"text":"ካዮ ቦዖዋ ኔ ዒጊጫዓኬ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ኔ ጎሽካ ጎዣ ሹቺ ማዒ ኔና ሜታሳዓኬ፤","poem":1},{"text":"ካዮ ቦዖና ዎላ ኔ ኮሺና ናንጋንዳኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ማኣሮይዳ ኔኤኮ ኮሹሞ ኩማንዳሢ ኔ ዔራንዳኔ፤","poem":1},{"text":"ማራቶኮ ባርቶ ኔ ዛጋኣና ቢያሢ ኮሺ ዓኣንቴ ኔ ዴንቃንዳኔ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ኔኤኮ ሾይንታ ሚርጋንዳሢያ ኔ ዔራንዳኔ፤","poem":1},{"text":"ዜርፃ ኔኤኮ ቦኦሎ ማኣቶጉዲ ሚርጋንዳኔ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዛርጎ ቲሻሢ ካፃንዳኣና ጎዣ ኔጋሢጉዲ","poem":1},{"text":"ኔኤኒያ ጋርቻንዳያ ሄላንዳኣና ሚርጌ ሌዔ ናንጋንዳኔ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ኑኡኒ ዬይ ቢያ ጎኔ ማዔሢ ዛጊ ዔሬኔ፤","poem":1},{"text":"ዬያሮ ኔኤኒ ማሊ ጶቂሢጋፓ ማዾይዳ ፔኤሼ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}