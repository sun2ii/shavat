{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["ዬካፓ ዒዮቤ ሂዚ ጌይ ማሄኔ፦"]},{"type":"verse","number":2,"content":[{"text":"«ዖዪፃ ታኣኮ ዴኤሡሞ ዔሮ ባኮይዳ ጌሢንቴያታቴ ዓይጎ!","poem":1},{"text":"ሜታሢያ ቢያ ታኣኮ ዴኤሡሞ ዔሮ ባኮና ዛጊንቴያታቴ ዓይጎ!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ባዞ ማኣሻሎይዳፓ ባሼ ዴኤፃንዳንቴኬ።","poem":1},{"text":"ዬያሮ ዳንዳዒፃ ፓጬ ታኣኮ ጌኤዛ ኔና ዲቃሢ ሄርሺሳንዳያ ኮይሱዋሴ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ቢያ ባኮ ዳንዳዓ ጎዳሢ ፔ ሂኢዦና ታና ዱኬኔ፤","poem":1},{"text":"ዬያ ሂኢዦኮ ዳኣና ዑፆ ታኣኮ ዓኣዺ ሃሼኔ፤","poem":2},{"lineBreak":true},{"text":"ፆኦሲኮ ዲቃሣያ ማዔ ባይዛ ባካ ኮይሎ ታኣኮ ማንጌኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኪርሞሌ ማኣቲ ዋዺ ዴንቄቴ","poem":1},{"text":"ጌማይያኣ ዖሃ ዴንቄቴ ጉዹዋሴ፤","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሶኦጌ ዋሂንቲባኣ፥ ዓኣፁዋ ካሣ ሙይንታ?","poem":1},{"text":"ጱኡላኮ ሃሎ ዋኣፃ ዓኣፃ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታኣኒ ታ ዛሎና ዬያጉዴ ሙዖ ሻሻኣኪንታኔ፤","poem":1},{"text":"ታ ሙዔታቴያ ታኣም ኮሽኩዋሴ።»","poem":2}]},{"type":"verse","number":8,"content":[{"text":"«ፆኦሲ ታ ኮዓ ባኮ ታኣም ዒንጋቴ ዓይጎ!","poem":1},{"text":"ታኣኮ ሺኢጲፆዋ ዒ ዋይዛቴ ዓይጎ!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሃያ ቢያይዳፓ ዒ ታና ዎዼቴ ኮሺቱዋኣዓዳ?","poem":1},{"text":"ፔ ኩጮ ዔቂሲ ዒ ታና ባይዜቴ!","poem":2},{"lineBreak":true},{"text":"ዬይ ታኣም ዶዲሢ ዒንጋንዳንቴኬ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዓይዲ ማዔቴያ ዱማዼ ፆኦዛሢኮ ቃኣሎ ታ ሃሺባኣሢሮ","poem":1},{"text":"ዎዚ ታኣኮ ሜታሢ ሚርጌቴያ","poem":2},{"lineBreak":true},{"text":"ዎዛና ታ ኮኦማንዳንቴኬ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሼምፔና ናንጋኒ ታና ማሃ ዓይጎ ዶዱሞ ታኣኮ ዓኣይ?","poem":1},{"text":"ሃጊ ማዓ ዎዛ ታኣኮ ባኣያ ማዔቴ ታ ዓይጋ ናንጋይ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታኣኒ ሹቺጉዲ ዶዳያዳ?","poem":1},{"text":"ታኣኮ ዑፃኣ ሞኦና ዓንጊጉዲ ጪኢሊዳ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታኣኒ ታና ማኣዳኒ ዎልቄ ታኣኮ ፔቴታዖ ባኣሴ፤","poem":1},{"text":"ታኣኮ ዓኣ ዎልቃ ቢያ ዔውቴኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«ፔ ላጋሢም ዓኣ ጉሙርቂንቲፆ ፓጪሳ ዓሲ","poem":1},{"text":"ፆኦሲ ዒጊቹሞ ሃሼ ዓሲኬ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታ ላጎንሢ ጋዓንቴ ዲጲ ዴንዴስካፓ ሚጫያና","poem":1},{"text":"ጉሙርሱዋኣ ዎሮጉዲ ጌጌሻያኬ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዎሮይዳ ባርጎ ዎዶና","poem":1},{"text":"ሻጫ ኩሊንታኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዖጎፆና ጋዓንቴ ዓልቂ ዴንዲ ባይቃኔ፤","poem":1},{"text":"ዎራኣ ሚጪ ጉሪ ማዓኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ጫኣኖ ጫኣና ቆልሞ ዒሺ ዒሺ ጎይፆ ዓኣዻ ዓሳ","poem":1},{"text":"ጎይፃፓ ኬስኪ ዋኣፆ ኮይፆ ዓሳ ናንጉዋ ዳውሎ ጌሊ ዒኢካ ሃይቃኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ቴማ ዓጫፓ ሃንቲፆ ዴንዳ ዓሳ ዋኣሢ ኮዓኔ፤","poem":1},{"text":"ሳኣባ ዓጮኮ ኮርሞ ኮርማ ዓሳኣ ዋኣሢ ዴንቃኒ ሃጋኣ ዎዛ ጌሣኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዔያታ ጉሙርቄ ዎራ ሚጪ ጴዻዛ ሃጋኣ ዎዛ ዔያታ ቲቃኔ፤","poem":1},{"text":"ዒኢካ ቤዞ ሄላዖ ዔያታ ዻዻጋዻኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዒንሢ ሃሢ ታኣም ዬንሢ ሚጬ ዎሮንሢጉዲኬ፤","poem":1},{"text":"ታና ሄሌ ሜታሢ ዛጊ ዒጊቹሞና ጊንሢም ዒንሢ ዶጬኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዔዛታ ሃያ፥ ዬያ ታኣም ዒንጉዋቴ፤","poem":1},{"text":"ሃሣ ጊንሣ ዒንሢኮ ቆሎና ታና ዓውሱዋቴ ታ ዒንሢ ጌይያ?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ታ ሞርኮ ኩጫፓ ታና ዓውሱዋቴ፤","poem":1},{"text":"ታና ሄርቂ ዎይሣ ዓሶ ኩጫፓኣ ታና ዓውሱዋቴ ታ ዒንሢ ጌይያ?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"«ዒንሢ ታና ዔርዙዋቴ፥ ታ ዚቲ ጋዓንዳኔ፤","poem":1},{"text":"ዻቢንቶዋ ታኣኮ ታኣም ኬኤዙዋቴ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ጎኔ ሃይሴ ጫንቺታቴያ ዔውታያኬ፤","poem":1},{"text":"ዒንሢኮ ቦሂፆ ጌኤዛ ጋዓንቴ ፔቴታዖ ፓሡዋያኬ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዒንሢ ታ ጌኤዞ ዛጋሢ ጉሪ ዢባሬ ማሂኬ፤","poem":1},{"text":"ሂንዳ ታና፥ ሃጋኣ ዎዛ ቲቄሢም ዓይጎ ማሂ ዒንሢ ኬኤዛኒ ኮዓይ?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዜኤሮ ናኣቶይዳ ዒፃ ዒንሢ ዓጋኔ፤","poem":1},{"lineBreak":true},{"text":"ዒንሢኮ ላጎ ዒንሢ ሻንቻኒ ሻንቾንዶ ባኮ ዛሎ ማርማኔ!","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"ሃዳራቴ ታኣኮ ዓኣፖ ካሮ ዛጉዋቴ፤","poem":1},{"text":"ዒንሢ ቤርታ ታ ሉኡቃ?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ዻቢንቲ ዒንሢኮ ማዑዋጉዲ ሃሹዋቴ፤","poem":1},{"text":"ሃሢ ሃሹዋቴ፤ ታኣኒ ፒዜኬ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ጎኔና ታ ዒንዲርዛ ዻቢንቲ ዓኣ?","poem":1},{"text":"ታ ዻንጋ ጌኖ ማሊፆ ዱማሲ ዔራኒ ዳንዳዑዋኣዓዳ?»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}