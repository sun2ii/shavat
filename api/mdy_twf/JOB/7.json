{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"«ዓሲኮ ናንጊ ሳዖይዳ ዶዲ ማሹምቦቱዋኣዓዳ?","poem":1},{"text":"ኬላ ዔያቶኮ ማዾ ማዼም ዓጊኒና ጪጎ ኬሎ ጉዲቱዋኣዓዳ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዔያታ ሺቢ ዴንካ ሃውሻኒ ኮዓ ማዾ ማዻ ዓሲና","poem":1},{"text":"ማዼሢ ዛሎ ጪጎ ሚኢሾ ዔካኒ ካፓ ማዻዞንሢጉዲ ቱዋኣዓዳ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታኣኒ ላቤ ዓጊና ታና ማኣዱዋኣያ ማዔኔ፤","poem":1},{"text":"ታኣኮ ሜታሢ ዒባኖንሢ ታኣም ዋኣዪሢ ዋንታ ማዔኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታኣኒ ላሃ ዎዶና","poem":1},{"text":"ዓይዶ ካሬም ታ ዔቃንዳይ ጋዓኔ፤","poem":2},{"lineBreak":true},{"text":"ጋዓንቴ ዋንታ ታኣም ዖዶቃኔ፤","poem":2},{"lineBreak":true},{"text":"ካራንዳያ ሄላንዳኣና ጉሪ ሺሪ ሺሪ ታ ላሃኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዑፃ ታኣኮ ቢያ ዛኣሌ ኩሜኔ፤","poem":1},{"text":"ዓሽካ ታኣኮ ጎኦጌ ዒልዒ ሌሊ ማዔኔ፤","poem":2},{"lineBreak":true},{"text":"ዹኡቂያኣ ጊኢሽኬኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታኣኮ ናንጎ ሌዓ ሃርፖኮ ሞኮኬይዳፓ ባሼ ሩኡራኔ፤","poem":1},{"text":"ፔቴታዖ ሃጊ ማዓንዳ ዎዛ ባኣያ ማዒ ጋፒንፆ ሄላኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ፆኦሲዮ! ታኣኮ ሼምፓሢ ዑኡሲ ዔኪሢፓ ቃሚቄሢ ማሌ፤","poem":1},{"text":"ሃካፓ ሴካ ፔቴታዖ ኮሺ ባኣዚ ታ ዛጋዓኬ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«ሃሢ ታና ዛጋሢ ላሚ ዛጋዓኬ፤","poem":1},{"text":"ኮዔቴያ ዒ ታና ዴንቃኒ ዳንዳዑዋሴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሻኣሬ ላኣሊንቲ ባይቃሢጉዲ","poem":1},{"text":"ሃይቂ ዱኡኪንታ ዓሲ ማዒ ጊንሣ ሙኩዋሴ፤","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጊንሣ ሃሣ ፔ ማኣሪያ ማዑዋሴ፤","poem":1},{"text":"ዒዛ ዔራ ዓሳኣ ቢያ ዒዛ ዋላኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ማይ ሃካፓ ሴካ ታኣኒ ዚቲ ጋዓዓኬ!","poem":1},{"text":"ታኣኮ ዓያኖ ዋኣዪፆይዳፓ ዔቄያና ታ ኬኤዛኔ፤","poem":2},{"lineBreak":true},{"text":"ሼምፓሢ ታኣኮ ሜታዼሢሮ ታ ጉንዱማኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«ሃያይዲ ኔ ታና ካፖ ዓሲ ማዓንዳጉዲ ማሄሢ","poem":1},{"text":"ታኣኒ ባዚዳ? ሃሣ ባዛ ናንጋ ዼኤፖ ቦዖዳ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"‹ታኣኮ ሻኣላ ታና ዶዲሻኔ፤","poem":1},{"text":"ታኣኮ ላሆ ቤዛኣ ሃርጋሢ ዳንዳዒሳኔ፤›","poem":2},{"lineBreak":true},{"text":"ጌይ ታ ማሌኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኔኤኒ ጋዓንቴ ዓውቲና ታና ዒጊቻኔ፤","poem":1},{"text":"ባልባቲሢናኣ ኔ ታና ዲቃሣኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሃያ ዋኣዪፃ ዺቤ ዑፆ ኬዲ ሃንቲፃፓ","poem":1},{"text":"ሱፂንቲ ታ ሃይቃኒ ኮዓኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሃጊ ማዓ ዎዛ ታ ቲቄኔ፤ ናንጋኒያ ታ ኮዑዋሴ፤","poem":1},{"lineBreak":true},{"text":"ታኣኮ ናንጎ ዎዳ ቃሚሢታሢሮ ታና ሃሼ።»","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"«ሃኣዺኬ ኔ ጋዓኒና","poem":1},{"text":"ዔያቶ ዛሎ ኔ ማላንዳጉዲ ዓሲ ዓይጎ ባኣዚዳይ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ጉቴ ጉቴ ኔ ዔያቶ ማሂ ዛጋንዳጉዲ","poem":1},{"text":"ሃሣ ቢያ ዎዴ ዎይታቴያ ዛጋንዳጉዲ ዓሲንሢ ዓይጎ ባኣዚዳይ?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ጩጮ ታ ዔኤዻንዳኣናታዖ","poem":1},{"text":"ዻካ ዎዴ ኔ ታና ሃሹዋዓዳ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኔኤኒ ዓሲ ሙሪ ዛጋ ፆኦዛሢዮ፥","poem":1},{"text":"ታኣኒ ጎሜ ማዼሢሮ ኔኤም ዓይጌ ፑርቴይ?","poem":2},{"text":"ታጊዳ ኔ ቲፕ ጌይ ዓይጋ ዔቄይ?","poem":1},{"text":"ያዺ ማዓንዳኣና ታ ኔኤም ኬዲ ማዒያ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ጎሞ ኔ ታኣኮ ፔቴታዖ ዓቶም ጎውዋዓዳ?","poem":1},{"text":"ታ ማዼ ዻቢንቶ ኔ ታኣኮ ባይዙዋዓዳ?","poem":2},{"text":"ዱኡኪንቲፃ ታኣኮ ሄሌኔ፤","poem":1},{"text":"ሃካፓ ሴካ ኔ ታና ኮዔያታቴያ ታ ጴዻዓኬ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}