{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["ሹሃ ዓጮ ዓሢ፥ ቢልዳዴ ሂዚ ጌይ ማሄኔ፦"]},{"type":"verse","number":2,"content":[{"text":"ኔኤኮ ዒንዲርዛፓ ኬስካ ሃይሳ ዓልጎ ዢባሬጉዲኬ፤","poem":1},{"text":"ዎማ ሄላንዳኣና ዬማይዲ ኔ ጌስታንዳይ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ፆኦሲ ፔቴታዖ ዎጌ ዎቢሱዋሴ፤","poem":1},{"text":"ቢያሢ ዳንዳዓ ጎዳሢ ቢያ ዎዴ ፒዜ ባኣዚ ማዻኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ናኣታ ኔኤኮ ፆኦሲም ዻቤያ ማዔቴ","poem":1},{"text":"ዔያታ ዔያቶም ኮይሳ ሜቶ ዔኬኔ ጌይሢኬ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጋዓንቴ ፆኦሲ ባንሢ ኔ ማዔቴ","poem":1},{"text":"ቢያ ባኮ ዳንዳዓ ጎዳ ኔ ሺኢቄቴ","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ፒዜ ሃሣ ኔ ጌኤሺ ማዔቴ","poem":1},{"text":"ዒዚ ዑኬና ኔና","poem":2},{"lineBreak":true},{"text":"ኔኤም ኮይሳ ቤዞ ጊንሣ ማሃንዳኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዓይፃ ኔኤኮ ዻካ ማሊ ጴዼቴያ","poem":1},{"text":"ሴካ ቤርታኣ ናንጋ ኔኤኮ ዑሣ ዓኣዼ ማዓንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«ሂንዳ ቤርታኣ ሾይንቶ ዖኦጬ፤","poem":1},{"text":"ሃሣ ቤርታኣ ዓዶንሢ ማዼ ጎይፆዋ ዛጌ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሌዓ ኑኡኮ ሃጊ ዻካታሢሮ ፔቴ ባኣዚታዎ ኑ ዔሩዋሴ፤","poem":1},{"text":"ናንጎ ሌዓ ኑኡኮ ሺቢጉዲ ቤዛፓ ዴንዳያኬ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዔያታ ኔኤም ዔርዛሢና ኬኤዛሢ","poem":1},{"text":"ዔያታ ማሊ ጶቂሤሢፓ ዔኪቱዋዓዳ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጎኔና ጫሬ ማዒባኣ ቤሲዳ ማጫሬ ኬስካ?","poem":1},{"text":"ዋኣሢባኣ ቤሲዳ ሃሣ ፒሌ ኬስኪ ዑጋ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ያዺ ማዒባኣቶ ዑጊ ጲሺንታንዳሢኮ ቤርታ","poem":1},{"text":"ሜሌ ባቃላ ባኮፓ ቢያ ቤርታዺ ሜላኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ፆኦሲ ዋላ ዓሲኮ ቢያ ጋፒንፃ ዒማጉዲኬ፤","poem":1},{"text":"ሃሣ ፆኦሲ ባኣሴ ጋዓ ዓሶኮ ሃጊ ማዓ ዎዛ ቲቂንታኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዔያታ ሻንጌ ፓቲሌጉዲ ዱጳ ባኣዚና ጉሙርቂንታኔ፤","poem":1},{"text":"ሃጋ ማዓ ዎዛ ዔያታ ጌሣ ባኣዚ ዓኣታቴያ ቤዞና ባይቃኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሻንጎ ፓቲሎይዳ ዔያታ ጌኤቂንቴቴ ዶዲ ዔያታ ዔቃዓኬ፤","poem":1},{"text":"ዬያ ሻንጎ ፓቲሎ ዔያታ ዓርቄቴ ዱዱጳንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«ሆኦሪ ዓቢና ኬስኪ ጎሺዳ ዺባሢጉዲ","poem":1},{"text":"ፑርታ ዓሲ ዒማዺ ሚርጋኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ፃጳ ዔያቶኮ ኬኤላ ሹቺ ዑስካ ማርታኔ፤","poem":1},{"text":"ሃሣ ዼኤፖ ሹጮ ዑፃኣ ዓዓርቂንታኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ፔቴ ዓሲ ዓኣ ቤዛፓ ዔያቶ ቱጌቴ","poem":1},{"text":"ቤርታ ዓኣ ቤዛ ዔያቶኮ ዔርቱዋሴ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ጎሞ ዓሶኮ ዎዛ ያዺ ማዓኔ፤","poem":1},{"text":"ሜሌ ዓሲ ዔያቶ ቤዞ ዔካኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«ፆኦሲ ኮዦ ዓሶ ኬኤሩዋሴ፤","poem":1},{"text":"ሃሣ ፑርቶ ዓሶዋ ማኣዱዋሴ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዬያሮ ኔኤኒያ ዎዛና ሚኢጫንዳጉዲና","poem":1},{"text":"ዒላሻንዳጉዲያኣ ኔና ማሃንዳኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ኔና ዒፃ ዓሳ ጋዓንቴ ቦርሲንታንዳኔ፤","poem":1},{"text":"ፑርቶ ዓሶኮዋ ማኣራ ባይቃንዳኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}