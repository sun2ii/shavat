{"type":"verse","number":20,"content":[{"text":"ታኣኒ ጌኤሺ ሃሣ ጎኔ ዓሲኬ፤","poem":1},{"text":"ጋዓንቴ ጌኤዛ ታኣኮ ታና ዻቢንቴያ ማሃኔ፤","poem":2},{"lineBreak":true},{"text":"ታ ጋዓ ባካ ቢያ ታ ዑፃ ዎጋኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዎዚ ታ ፂሎታቴያ","poem":1},{"text":"ታ ዛሎ ታ ማሉዋሴ፤","poem":2},{"lineBreak":true},{"text":"ታ ሼምፓሢያ ታኣኒ ሻኣኪንታኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ፆኦሲ ፂላሢንታ ዻቢንቴሢንታ ዎላ ባይዛሢሮ","poem":1},{"text":"‹ፔቴታዖ ዱሙሞ ባኣሴ›","poem":2},{"lineBreak":true},{"text":"ታ ጌዔሢ ዬያሮኬ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዓሲ ፔቴ ባኣዚና ቤዛ ሃይቄቴ","poem":1},{"text":"ፆኦሲ ዬያ ጌኤዦ ዓሢኮ ሜቶ ሚኢጪ ዓዓማላኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ሳዓ ፑርቶ ዓሶ ኩጫ ዓኣሢ ዒንጊንታዛ","poem":1},{"text":"ዒዚ ዎጎ ዎጋ ዓሶኮ ዓኣፖ ካንቃኔ፤","poem":2},{"text":"ዓካሪ ዬያ ቢያ ማዼሢ ፆኦሲቱዋቴ","poem":1},{"text":"ሃንጎ ዖናዳይ?»","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"«ታኣኮ ናንጎ ሌዓ ጳሽካ ዓሲዳፓ ባሼ ሩኡራኔ፤","poem":1},{"text":"ፔቴታዖ ዎዛ ታ ዴንቁዋንቴ ዓኣዻኔ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዔያታ ማጫሬና ኮሺንቴ ዋኣፆና ፒንቆ ጎንጎጉዲ ጳሽካኔ፤","poem":1},{"text":"ሃሣ ዓርቂ ዔካ ኮኦኬጉዲያኣ ሩኡራኔ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ታ ሜታሢ ኬኤዚ ሺሪፆ ታ ዋሎም","poem":1},{"text":"ዓኣፖ ካሮዋ ታኣኒ ቱኪፆ ሃሺ ሙስታንዳኔ ጋዓዛ፥","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ፆኦሲ ጌኤሺ ማሂ ታና ፓይዲንዱዋሢ ታ ዔራሢሮ","poem":1},{"text":"ሜቶና ዋኣዪሢና ታና ሄላንዳኔ ጌይ ታ ዒጊጫኔ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ዓካሪ ዻቢንቴያ ማዒ ታ ፓይዲንቴቴ","poem":1},{"text":"ጉሪ ታኣኮ ላቢፃ ዓይጎሮዳይ?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ዑፆ ታኣኮ ታ ሳኣሙናና ማስቴቴ","poem":1},{"text":"ኩጮዋ ታኣኮ ታ ዖንዶዴና ጌኤሼቴ፤","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ዬይ ቢያ ማዺንቴቴያ","poem":1},{"text":"ኔ ታና ዔኪ ቶርጴይዳ ኬኤራኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኮ ማኣዓሢታዖ ታና ሻኣኪንታኔ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ዒዚ ታጉዲ ዓሲቱዋኣሢሮ","poem":1},{"text":"ዎጎ ዎጋ ዓሶ ኮይላ ኑ ዎላ ዴንዲ","poem":2},{"lineBreak":true},{"text":"ሞኦቶም ታ ዒዛ ጋዓኒ ዳንዳዑዋሴ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ታኣኮ ዙላፓ ፆኦሲ ፔ ኮኦሎ ዔቂሳንዳጉዲና","poem":1},{"text":"ዒዛኮ ዓውካራ ታና ዒጊቹዋጉዲ","poem":2},{"lineBreak":true},{"text":"ፔኤኮ ኩጮ ኑና ላምዓሢ ዑፃ ጌሣ ሱኡጌ ጴዻቴ ዓይጎ!","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ታኣኒ ዓሳ ታና ማላ ጎይፆጉዲ ማዒባኣሢሮ","poem":1},{"text":"ታ ዒዛ ዒጊጩዋዖ ኬኤዜያ ናንዳንቴኬ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":34}