{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOB","translationId":"mdy_twf","name":"ዒዮቤ ማፃኣፖ","commonName":"ዒዮቤ ማፃኣፖ","title":"ዒዮቤ ማፃኣፖ","order":18,"numberOfChapters":42,"sha256":"9c828d0d84ed0e24067a8701c47b01bb33eada0f6df825f34ac07f87490c0673","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mdy_twf/JOB/42.json","totalNumberOfVerses":1066},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":["ዒዮቤ ሂዚ ጌዒ ማሄኔ፦"]},{"type":"verse","number":2,"content":[{"text":"«ሂዮ! ዬይ ቢያ ጎኔታሢ ታ ዔራኔ፤","poem":1},{"text":"ጋዓንቴ ዓሲ ፆኦሲ ቤርቲዳ","poem":2},{"lineBreak":true},{"text":"ዎይቲ ጌኤሺ ማዓኒ ዳንዳዓይ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዒዛና ዎላ ማርማኒ ዳንዳዓሢ ዖናዳይ?","poem":1},{"text":"ዒዚ ፔቴ ሺያ ዖኦጪሢ ዖኦጬቶ","poem":2},{"lineBreak":true},{"text":"ዒንሢዳፓ ፔቴማታዎ ማሃኒ ዳንዳዓ ዓሲ ባኣሴ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ፆኦሲ ዔሮ፥ ሃሣ ዎልቄና ዓኣያኬ፤","poem":1},{"text":"ዖናዳይ ዒዛ ቃዛኒ ጌይ ባሺንቲባኣይ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዔርቲባኣንቴ ዹኮ ዒ ዓዓጊሣኔ፤","poem":1},{"text":"ፔኤኮ ዻጎና ዒ ዶይሳኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ፆኦሲ ሳዖ ዓኣ ቤዛፓ ጎቃይሳኔ፤","poem":1},{"text":"ሃሣ ሳዖኮ ቱርቱሮዋ ዒ ሪቂንሣኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዓባ ፆርቁዋጉዲ ዒ ማሃኒ ዳንዳዓኔ፤","poem":1},{"text":"ዦኦጋሢያ ፖዑዋጉዲ ዒ ማሃኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዖኦኒያ ዒዛ ማኣዱዋንቴ ጫሪን