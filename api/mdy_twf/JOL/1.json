{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOL","translationId":"mdy_twf","name":"ዒዩዔኤሌ ማፃኣፖ","commonName":"ዒዩዔኤሌ ማፃኣፖ","title":"ዒዩዔኤሌ","order":29,"numberOfChapters":3,"sha256":"e4298703325adda99c788b95f3833fca1e3dd7b946a7de245c5955bec5851daa","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mdy_twf/JOL/3.json","totalNumberOfVerses":72},"chapter":{"number":1,"content":[{"type":"heading","content":["ዓቢፃ ዒስራዔኤሌ ዓጮ ሙይ ባይዜሢ"]},{"type":"verse","number":1,"content":["ባኣቱዔኤሌ ናኣዚ ዒዩዔኤሌም ናንጊና ናንጋ ጎዳፓ ዳኪንቴ ኪኢቶ ቃኣላ ያዺኬ፦"]},{"type":"verse","number":2,"content":[{"text":"ዒንሢ ጋርቾ ዓሳ ዋይዙዋቴ!","poem":1},{"text":"ዪሁዳ ዓጫ ናንጋ ዓሳ ቢያ ዒናፓ ዋይዙዋቴ!","poem":2},{"text":"ዒንሢ ናንጌ ዎዶይዳ ሃያ ጉዴ ባኣዚ፤","poem":1},{"text":"ጊንሣ ሃሣ ዒንሢኮ ቤርታኣ ዓዶንሢ ዎዶናኣ ዓሲ ዛጊ ቤቂያ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዬያ ባኮ ዒንሢኮ ናኣቶም ኬኤዙዋቴ፤","poem":1},{"text":"ዒንሢኮ ናኣታ ጊንሣ ፔ ናኣቶም ኬኤዞንጎ፤","poem":2},{"lineBreak":true},{"text":"ዬያታኣ ዔያቶ ሄሊ ሙካ ሾይንቶም ኬኤዞንጎ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሜልካሢዳፓ ዓቴ ሃኣኮ ባቃሎ","poem":1},{"text":"ሻዻ ዓቢፃ ሙዔኔ፤","poem":2},{"lineBreak":true},{"text":"ዬካፓ ዓቴሢ ሃሣ ዢኢፓ ዒርዚጉዲ ዲኢና","poem":2},{"lineBreak":true},{"text":"ዓቢፃ ሙይ ባይዜኔ፤","poem":2},{"lineBreak":true},{"text":"ዓቴሢያኣ ማካሢ ሙዔኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሃይካፓ ሴካ ዒንሢ ሙርጎ ዎይኖ ዑዦ ዻንጋ ካንሢንዱዋኣሢሮ","poem":1},{"text":"ዒንሢ ማሢንታ ዓሳ ጊንዓስካፓ ጴጪ ዬኤኩዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢ ቢያ ዎዴ ዎይኖ ዑዦ ዑሽካ ዓሳ!","poem":2},{"lineBreak":true},{"text":"ዒናፓ ቃዪ ዬኤኩዋቴ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዎልቄና ዓኣ ዑሣ ዓኣዼ ዺቤ ሜሌ ዴሬ","poem":1},{"text":"ታ ዓጮ ዖሊ ባይዛኒ ሙኬኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያ ዖሎ ዓሶኮ ዓጫ ዞቢ ዓቺጉዲኬ፤","poem":2},{"lineBreak":true},{"text":"ባንጋላ ጊንሣ ሃሣ ዒንዴ ዞቢሮጉዲኬ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታኣኮ ቱኮና ዎይኖ ቢያ ሙይ ባይዜኔ፤","poem":1},{"text":"ቤሌሴ ሚፆዋ ቆፂ ሙዔኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያ ሚፆኮ ዛንዞዋ ቦኦሪሺ","poem":2},{"lineBreak":true},{"text":"ቁኡሮ ቢያ ፒኢቲ ሙዔኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዒዞ ጎቺ ዴዓያታዖ ሃይቄ ዼጌሮ","poem":1},{"text":"ሲዬ ፓቲሌ ማይንቲ ዬኤካ","poem":2},{"lineBreak":true},{"text":"ዉዱሮ ናይጉዲ ዒንሢያ ዬኤኩዋቴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማኣሮይዳ ዒንጎ ባኣዚ ማሂ ሺኢሾ","poem":1},{"text":"ሃኣኮንታ ዎይኖ ዑዦንታ ባይቄሢሮ","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳም ማዻያ ማዔ ቄኤሳ ዬኤካኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጎዣ ጎሽኪንቴ ጎይሣ ጉሪ ዓቴኔ፤","poem":1},{"text":"ሃኣኮ ዒኢካ ባኣያ ማዔኔ፤","poem":2},{"lineBreak":true},{"text":"ቱኮና ዎይናኣ ሃይቄኔ፤","poem":2},{"lineBreak":true},{"text":"ዛይታኣ ባይቄኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያሮ ሳዓ ዬኤካኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዛርጋሢንታ ዔልዖንታ፤ ሜሌ ካፃ ሃኣካኣ ቢያ ባይቄሢሮ","poem":1},{"text":"ዒንሢ ጎዦ ጎሽካ ዓሳ ዖዩዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢ ዎይኖ ቱካ ዓሳኣ ዬኤኩዋቴ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ቱኮና ዎይኖንታ ቤሌሶ ሚፆንታ ሹሌኔ፤","poem":1},{"text":"ሮኦማኣኔ፥ ቴሚሬ ጌይንታ ሚፃ፥ ሙቃሎንታ ሜሌ ዓኣፖ ዓኣፓ ሚፃ ቢያ ሜሌኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያሮ ጎኔና ዓሲ ዎዛዻ ዎዛ ባይቄኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዒንሢ ፆኦዛሢም ዒንሢ ዒንጋ ሃኣኮንታ ዎይኖ ዑዦ ዒንጊፆንታ ባኣሢሮ","poem":1},{"text":"ዒንሢ ታ ፆኦዛሢም ማዻ ቄኤሳ!","poem":2},{"lineBreak":true},{"text":"ሃኒ ዬዒ፥ ሲዬ ፓቲሌ ማይንቲ ዋንቶ ጉቤ ዬኤኩዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢ ዒንጎ ባኮ ዒንጎ ቤዞይዳ ማዻ ዓሳ ቃዪ ዬኤኩዋቴ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሙኡዚ ሃሾ ዱማ ኬሊ ሜንሡዋቴ!","poem":1},{"text":"ፆኦሲም ዱማዼ ቡኪንቲ ዴሮ ቡኩሱዋቴ!","poem":2},{"lineBreak":true},{"text":"ጋርቾንታ ዓጮይዳ ናንጋ ዓሶዋ ቢያ","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢ ማኣሪ ቡኩሱዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዒኢካ ፆኦሲ ዒንሢም ዋይዛንዳጉዲ ዬኤኩዋቴ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ባዴዔ! ናንጊና ናንጋ ጎዳ ኬላ ዑኬኔ!","poem":1},{"text":"ቢያ ባኮ ዳንዳዓ ጎዳሢ ባይሲንታ ዔኬ ሙካ ኬላ ሄሌኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ሃኣኮ ኑ ዓኣፓፓ","poem":1},{"text":"ዎዛና ዒላሺሢና ኑ ፆኦዛሢኮ ጌኤዦ ማኣራፓ","poem":2},{"lineBreak":true},{"text":"ጋፒ ባይቄኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዜርቂንቴ ዜርፃ ቢያ ሳዖይዳ ሙርዒ ዓቴኔ፤","poem":1},{"text":"ሃኣካ ባይቄሢሮ ሃኣኮ ናቶ ቤዛ ቢያ ጉሪ ማዔኔ፤","poem":2},{"lineBreak":true},{"text":"ኮናኣ ዶዔኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ባኣታ ሄንቃንዳ ማኣቲ ባይቄሢሮ ዖኦላኔ፤","poem":1},{"text":"ማራታኣ ቢያ ናይዺንቲ ካራ ባይዚ ዓኣኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ቦኦሎይዳ ዓኣ ማኣቶ ቢያ ታሚ ሙዔሢሮ","poem":1},{"text":"ካዮ ሚፆዋ ታሚ ሚቼሢሮ","poem":2},{"lineBreak":true},{"text":"ታኣኒ ኔ ባንሢ ዒላታኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዎራ ሚጬሢሮ","poem":1},{"text":"ቦኦሎ ማኣታ ቢያ ሜሊ ባይቄሢሮ","poem":2},{"lineBreak":true},{"text":"ካዮ ቦዓታዖ ዓቱዋዖ ኔ ባንሢ ዒላታኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}