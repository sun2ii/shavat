{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JOL","translationId":"mdy_twf","name":"ዒዩዔኤሌ ማፃኣፖ","commonName":"ዒዩዔኤሌ ማፃኣፖ","title":"ዒዩዔኤሌ","order":29,"numberOfChapters":3,"sha256":"e4298703325adda99c788b95f3833fca1e3dd7b946a7de245c5955bec5851daa","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mdy_twf/JOL/3.json","totalNumberOfVerses":72},"chapter":{"number":2,"content":[{"type":"heading","content":["ናንጊና ናንጋ ጎዳ ኬሎ ሙኮ ዓቢፃ ዔርዛያ ማዒፆ"]},{"type":"verse","number":1,"content":[{"text":"ፂዮኔይዳ ዛዬ ዋርቁዋቴ! ፆኦሲም ዱማዼ ዹኮይዳኣ","poem":1},{"text":"ኬስኪ ዒላቱዋቴ!","poem":2},{"text":"ናንጊና ናንጋ ጎዳ ኬላ ሙካኒ ዑኬሢሮ","poem":1},{"text":"ዓጬሎይዳ ናንጋ ዓሳ ቢያ ጎጋይቆንጎ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዬና ኬላ ዹማያና ቃኣያዻ ኬሊ፤","poem":1},{"text":"ሻኣራዻያና ሻኒ ዹማ ኬሊኬ፤","poem":2},{"lineBreak":true},{"text":"ዓባ ፆርቃኣና ፖዓ ዹኮ ዑፆይዳ ጴዻሢጉዲ","poem":2},{"lineBreak":true},{"text":"ዺቢ፤ ሃሣ ዎልቃዻ ሜሌ ዴሬ ቢያ ቤዞ ሙኪ ባይዛንዳኔ።","poem":2},{"text":"ዬያጉዴ ባኣዚ ሃያኮ ቤርታ ዛጊንቲ ቤቂባኣሴ፤","poem":1},{"text":"ሃካፓ ሴካ ዓይዲያ ጴዻዓኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ዔያቶኮ ቤርታ ጴዻ ዓኣዔ ባኮ ቢያ ታሚጉዲ ዔያታ ሙዓንዳኔ፤","poem":1},{"text":"ዔኤታ ታሚጉዲያኣ ሚቻንዳኔ።","poem":2},{"lineBreak":true},{"text":"ሃጊ ዔያታ ሄሊባኣ፥ ቤርታ ዓኣ ሳዓ","poem":2},{"lineBreak":true},{"text":"ዔዴኔ ጌይንታ ቤዞጉዴያ ዓኣዔ ባኣዚ ዋርቂ ዓኣያኬ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ሙይ ጊዴና ዓኣዻ ሳዓ ጋዓንቴ","poem":2},{"lineBreak":true},{"text":"ጋፒ ባይቄያ ዓሲ ናንጉዋ ዳውሌ ማዓኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶይዳፓ ቶሊ ዓታንዳ ዓይጎ ባኣዚያ ባኣሴ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዔያቶኮ ማላሢ ፓሮ ማላኔ፤","poem":1},{"text":"ዔያታ ዖሎ ፓራሢጉዲያኣ ሳጋራኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዓዳ ሳርጌሎ ዖይቶጉዴ ዑኡሲ ዋይዚሲ ዋይዚሲ","poem":1},{"text":"ዹኮ ቶኦኮይዳ ኮኦማኔ፤","poem":2},{"lineBreak":true},{"text":"ሃኣኮኮ ዲኢሪ ሙዓ ታሚጉዲ","poem":2},{"lineBreak":true},{"text":"ቢያ ባኮ ዔያታ ሙዓኔ፤","poem":2},{"lineBreak":true},{"text":"ዖልዚም ጊኢጊንቴ ዺቢ ዖልዚ ዓሲጉዲ ቤሲ ቤሲ ዓርቂ ዴዔኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዔያቶ ዴንቃ ዴራ ካራ ባይዚ ጎጋይቃኔ፤","poem":1},{"text":"ዓሶኮ ቢያ ዓኣፖ ካራ ዒጊቹሞና ቦኦራኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዔያታ ዖልዚ ዓሲጉዲ ዔርቲባኣንቴ ዖልዚ ቡላኔ፤","poem":1},{"text":"ዖላ ዓሶጉዲያኣ ኬኤሎ ዲሮ ዑፆ ጊዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ቢያሢ ዔያታ ዓርቄ ጎይፆ ዻቡዋዖ","poem":2},{"lineBreak":true},{"text":"ዓኣዻ ካሮማና ጎዓንዳኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ፔቴይ ባጋሢና ዎሊ ሂዑዋሴ፤","poem":1},{"text":"ፔቴ ፔቴሢ ፔ ጎይፆማ ዓኣዻኔ፤","poem":2},{"lineBreak":true},{"text":"ሞርኮኮ ዋርዲዮ ሻሂ ዓኣዻኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶ ቃዛ ባኣዚ ባኣሴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዔያታ ካታሞ ጌሊ ዓርቃኔ፤","poem":1},{"text":"ካታሞኮ ዙሎ ዲርቆና ኬኤሎ ዲፆ ዑፃ ጳሽካኔ፤","poem":2},{"lineBreak":true},{"text":"ጱሊ ጱሊ ማኣሮ ዑፆዋ ኬስካኔ፤","poem":2},{"lineBreak":true},{"text":"ዓዳ ዉሲጉዲ ማኣሮኮ ፑልቶ ካሮና ጋሮ ጌላኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ሳዖ ዔያታ ጎቃይሳኔ፤","poem":1},{"text":"ጫሪንጮዋ ዔያታ ዓጊሣኔ፤","poem":2},{"text":"ዓቦንታ ዓጊኖንታ ዹማኔ፤","poem":1},{"text":"ዦኦጋሢያ ፖዑዋያ ማዓኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ናንጊና ናንጋ ጎዳ ጉጉንሢጉዴ ዑኡዞ ዬያ ዖሎ ዓሶ ዋይዚሳኔ፤","poem":1},{"text":"ዬይ ዖሎ ዓሳ ዎዚ ሚርጋይ!","poem":2},{"text":"ዓይሢፆ ዒዛኮ ኩንሣ ዬይ ዖሎ ዓሳ ኮሺ ዺቢኬ፤","poem":1},{"text":"ዬይ ሚርጌ ዒጊቻያ ማዔሢሮ ዬያ ኬሎና ዖኦኒ ዳንዳዒ ዔቃንዳይ?","poem":2}]},{"type":"heading","content":["ጎሜ ቡኡፆም ኬኤዚንቴ ኪኢታ"]},{"type":"verse","number":12,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ሃሢ ሙኡዚ ሃሺሢና ዬኤፒና ዖዪሢና","poem":2},{"lineBreak":true},{"text":"ጉቤ ዒናፓ ታ ባንሢ ማዑዋቴ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዒንሢ ዖያያ ማዒፆ ዔርዛኒ ማኣዓሢ ዒንሢኮ ዳርዚፖቴ፤","poem":1},{"text":"ጋዓንቴ ዒኖ ዒንሢኮ ሺኢቺ፥ ጎሞ ቡኡፁዋቴ።»","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢ ኮሺ፥ ማኣራያ፥ ሩኡሪና ዻጋዹዋያ","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ናሹማ ዺቢ፤","poem":2},{"lineBreak":true},{"text":"ፑርታ ባኣዚ ዓጋኒ ሩኡሩዋያ ማዔሢሮ","poem":2},{"lineBreak":true},{"text":"ዒዛ ባንሢ ማዑዋቴ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ጎዖንቴ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢ ዻጎ ሃሺ","poem":1},{"text":"ዓንጆ ዒንሢም ዒንጋንዳያ ናንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢያ ዒማና ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢም","poem":2},{"lineBreak":true},{"text":"ሃኣኮንታ ዑዦ ዒንጊፆንታ ዔኪ ሺኢሻንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ፂዮኔ ዹኮይዳ ዛያሢ ዋርቁዋቴ!","poem":1},{"text":"ዴሮ ፆኦሲም ዱማዼ ቡኪንቲሮ ዔኤሉዋቴ!","poem":2},{"lineBreak":true},{"text":"ሙኡዚ ሃሻንዳጉዲያኣ ዴሮም ኬኤዙዋቴ!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዴሮ ቢያ ፔቴይዳ ቡኩሲ","poem":1},{"text":"ፆኦሲም ዱማዼ ቡኪንቲም ጊኢጊሹዋቴ፤","poem":2},{"lineBreak":true},{"text":"ጋርቾ ዓሶ ዔኤሉዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዻኮ ናኣቶንታ ዻንፆ ዻንቃ ዓኣሎ ናኣቶዋ ዓይሱዋዖ ቡኩሱዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዑኡታኣ ዓቱዋዖ ዑኡቱሞ ኬኤፃፓ ኬስኮንጎ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ናንጊና ናንጋ ጎዳም ማዻ ቄኤሳ","poem":1},{"text":"ፆኦሲም ዒንጎ ባኮ ዒንጎ ቤዞና","poem":2},{"lineBreak":true},{"text":"ጌኤዦ ማኣሮይዳ ዓሳ ቡካ ጶኦኮናኮ ባኣካ ዔቂ ዬኤኮንጎ፤","poem":2},{"text":"ዔያታ፦ «ናንጊና ናንጋ ጎዳሢዮ! ኔኤኮ ዴሮ ሚጪንቴ፤","poem":1},{"text":"ሜሌ ዴራ ‹ዒንሢኮ ፆኦዛሢ ዎካ ዓኣይ?› ጌይ","poem":2},{"lineBreak":true},{"text":"ኑና ቶኦቻንዳጉዲና ሚኢጪ ዓማላንዳጉዲ ማሂፖ» ጎዖንጎ።","poem":2}]},{"type":"heading","content":["ናንጊና ናንጋ ጎዳ ፔ ዴሮ ጊንሣ ዶዲሺ ዔቂሳንዳሢ ኬኤዜሢ"]},{"type":"verse","number":18,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሳዔላ ዒዛሮ ሌሊ ማዓንዳጉዲ ኮዒ","poem":1},{"text":"ፔ ዴሮም ሚጪንቴኔ፤","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዬያሮ ዒዚ ሂዚ ጌዔኔ፦","poem":1},{"text":"«ሃኣኮንታ ዎይኖ ዑዦንታ ሪሚቶ ዛይቶንታ","poem":2},{"lineBreak":true},{"text":"ዒንሢ ሚሽካንዳያ ሄላንዳኣና ታ ዒንሢም ዒንጋንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሃካፓ ሴካ ሜሌ ዴራ","poem":2},{"lineBreak":true},{"text":"ሚኢጪ ዒንሢ ዓማላንዳጉዲ ታ ሃሻዓኬ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዓጮኮ ኬዶ ዛላፓ ሙካ ዺቦ ዓቢፆ","poem":1},{"text":"ታ ዒንሢ ኮይላፓ ሃኪሳንዳኔ፤","poem":2},{"text":"ዓሲ ናንጉዋ ዳውሎ ቦኦሎ ታኣኒ ዳውሲ ዳካንዳኔ፤","poem":1},{"text":"ዬያቶኮ ሶሮፖ ታኣኒ ሶኦጌ ባዚ፤","poem":2},{"lineBreak":true},{"text":"ጊንፃ ዓቴሢ ሃሣ ታኣኒ ሜዲቴራኒያ ባዞ ዳውሲ ጌልዛንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒኢካ ዔያቶኮ ሌዛ ዛዓንዳኔ፤","poem":2},{"text":"ጎኔና ታኣኒ፥ ናንጊና ናንጋ ጎዳ ዼኤፒ ባኣዚ ዒንሢም ማዼኔ።»","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«ሳዔሌ ዒጊጪፖ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ኔኤም ዼኤፒ ባኣዚ ማዼሢሮ ዎዛዼ!","poem":2},{"lineBreak":true},{"text":"ሃሣ ዒላሼ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዒንሢ ካዮ ቦዓ ዒጊጪፖቴ፤","poem":1},{"text":"ዒንሢ ሄንቃ ቤዛ ዓኣ ማኣታ ዋርቄኔ፤","poem":2},{"lineBreak":true},{"text":"ሚፃኣ ዓኣፔኔ፤","poem":2},{"lineBreak":true},{"text":"ቤሌሶንታ ዎይኖ ዓኣፖንታ ኮሺ ሚርጌኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"«ዒንሢ ፂዮኔ ዴራ!","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢ ዒንሢም ማዼ ባኮሮ","poem":2},{"lineBreak":true},{"text":"ዎዛዹዋቴ፥ ሃሣ ዒላሹዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዒዚ ፒዜ ዎጌ ዎጊ","poem":2},{"lineBreak":true},{"text":"ዓዳ ቤርታኣ ጎይፆ ዖጎፆንታ ባርጎ ዓጊኖንታይዳ","poem":2},{"lineBreak":true},{"text":"ጊዳ ዒርዚ ዒንሢም ዋርቂሴኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዒንሢኮ ሃኣኮ ሺርኮ ቆይዶይዳ ሃኣኮ ኩማንዳኔ፤","poem":1},{"text":"ዎይኖ ዑዦንታ ሪሚቶ ዛይቶንታ","poem":2},{"lineBreak":true},{"text":"ዒንሢ ጩኡጳ ዔቶ ኩሚ ሾኦታንዳኔ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ሚርጌ ዎዴ፦ ዺቢ ዖልዚ ዓሲጉዴያ ታ ዒንሢም ዳኬ፥ ዢኢፖ ዒሮጉዲ ዲኢና ዓቢፃ፥","poem":1},{"text":"ማካሢ፥ ሜልካሢንታ ሻዻ ዓቢፆንታ","poem":2},{"lineBreak":true},{"text":"ዒንሢኮ ሙይ ጋፒሴ ሃኣኮ ቤዛ ታ ዒንሢም ዒንጋንዳኔ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ሚርጌ ሙይ ዒንሢ ሚሽካንዳኔ፤","poem":1},{"text":"ሚርጌ ዲቃሢ ሄርሺሳ ባኣዚ ዒንሢም ማዼ","poem":2},{"lineBreak":true},{"text":"ታና፥ ናንጊና ናንጋ ጎዳ ማዔ ዒንሢኮ ፆኦዛሢ ዒንሢ ጋላታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዴራ ታኣኮ ሃካፓ ሴካ ቦርሲንታዓኬ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ታ ዴሬዮቴ! ታኣኒ ዒንሢ ባኣካ ዓኣሢ፤","poem":1},{"text":"ዒንሢኮ ፆኦዛሢያ ታና ሌሊ ማዔሢ፤","poem":2},{"lineBreak":true},{"text":"ታ ጊዳፓ ዓታዛ ሜሌ ፆኦሲ ባኣሢያ ዒንሢ ዔራንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኮ ዴራ ሃካፓ ሴካ ቦርሲንታዓኬ።»","poem":2}]},{"type":"heading","content":["ናንጊና ናንጋ ጎዳ ኬሎ"]},{"type":"verse","number":28,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ዓካሪ ታኣኮ ዓያኖ ዓሲ ቢያ ዑስካ ታኣኒ ኬይሳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢኮ ዓቲንቆንታ ዉዱሮ ናኣቶንታ ታ ማሊሢ ኬኤዛንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ጋርቻ ዒንሢኮ ዓውቲ ዓውታዻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዼጌሢያ ታኣኒ ፔጋሲ ዻዋ ባኣዚ ዛጋንዳኔ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ዬያጉዲ ሃሣ ዬንሢ ኬሎይዳ","poem":1},{"text":"ታኣም ማዻ ዓቲንቆንታ ላኣሎንታይዳ","poem":2},{"lineBreak":true},{"text":"ታኣኮ ዓያኖ ታኣኒ ኬይሳንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"«ጫሪንጮና ሳዖናይዳ ዲቃሢ ሄርሺሳ ባኣዚ ታኣኒ ዻዋንዳኔ፤","poem":1},{"text":"ሱጉሢንታ ታሚንታ ጩቢያ ሻኣሬጉዲ ላሂ ጴዻንዳኔ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ዼኤፖ፥ ዒጊቻ፥ ጎዳ ኬላ ሙካንዳሢኮ ቤርታ","poem":1},{"text":"ዓባ ዹማንዳኔ፤ ዓጊናኣ ሱጉሢጉዲ ዞቃንዳኔ፤","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማኣዳንዳጉዲ ዔኤላሢ ቢያ ዻቃንዳኔ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ኬኤዜ ጎይፆ ፂዮኔ ዹኮና","poem":2},{"text":"ዬሩሳላሜናይዳፓ ዼኤሻ ጴዻንዳኔ፤","poem":1},{"text":"ዻቃ ዓሶ ባኣኮይዳ ናንጊና ናንጋ ጎዳ ዶኦሬ ዓሳ ዓኣያ ማዓንዳኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}