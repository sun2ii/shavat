{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"JON","translationId":"mdy_twf","name":"ዮናኣሴ ማፃኣፖ","commonName":"ዮናኣሴ ማፃኣፖ","title":"ዮናኣሴ","order":32,"numberOfChapters":4,"sha256":"880e4874ce5ad2a5307970da4b63460e48a42a6af3485b3f4613927ff2907d94","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/mdy_twf/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["ዮናኣሴ ሺኢቄ ሺኢጲፆ"]},{"type":"verse","number":1,"content":["ዮናኣሴ ሞላሢ ጎጶይዳ ዓኣዖ ሂዚ ጌይ ናንጊና ናንጋ ጎዳ ማዔ ፔ ፆኦዛሢ ሺኢቄኔ፦"]},{"type":"verse","number":2,"content":[{"text":"«ናንጊና ናንጋ ጎዳሢዮ! ታኣኒ ሜታዺ ዓኣዖ ኔና ዔኤሌኔ፤","poem":1},{"text":"ኔኤኒያ ታኣም ዬሄኔ፤","poem":2},{"text":"ኔኤኒ ታና ማኣዶንጎ ጌይ ሃይቄ ዓሶ ዓጮ፥ ዔቶይዳ ዓኣዖ","poem":1},{"text":"ኔ ዓውሳንዳጉዲ ታኣኒ ዒላቴኔ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኒያ ታኣም ዋይዜኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኮሺ ዔታዻ ባዞኮ ዴሞይዳ ኔኤኒ ታና ኬኤሬኔ፤","poem":1},{"text":"ኮይላ ታኣኮ ዋኣሢ ሌሊ ማዔኔ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ዴቺንታ ዋኣፆና ባዞ ጉዳሢና ታኣኮ ዑሢና ዓኣዼኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኔ ዓኣፓፓ ታኣኒ ኬኤሪንቲ ባይቄኔ፤","poem":1},{"text":"ያዺ ማዔቴያ ኔኤኮ ጌኤዦ ማኣሮ ላሚ ታኣኒ ዛጋኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዋኣፃ ታኣኮ ሆሎ ሄላንዳኣና","poem":1},{"text":"ዼኤፖ ባዞ ዋኣፃኣ ጋፒሲ ታና ዔኤዼኔ፤","poem":2},{"lineBreak":true},{"text":"ዼኤፖ ባዞይዳ ባቃሊ ዓኣ ማኣታ ቶኦኮ ታኣኮ ማሬኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሊካ ዹኮኮ ዴሞ ታኣኒ ኬዴኔ፤","poem":1},{"text":"ዬያኮዋ ዴማ ዓኣ ሳዖ ዴማ","poem":2},{"lineBreak":true},{"text":"ናንጊና ታኣኒ ካራ ዎዺንቴም ዴዔኔ፤","poem":2},{"text":"ኔኤኒ ጋዓንቴ ናንጊና ናንጋ ጎዳ ማዔ ታ ፆኦዛሢዮ!","poem":1},{"text":"ዬያ ዋኣፆ ዔቶይዳፓ ኬሲ ዔኪ ሼምፓሢ ታኣኮ ዓውሴኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታኣኒ ሃይቄያ ታኣም ማሌ ዎዶና","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ታኣኒ ማሊ ጶቂሤኔ፤","poem":2},{"lineBreak":true},{"text":"ኔና ታኣኮ ፆኦዛሢ ታኣኒ ሺኢቄኔ፤","poem":2},{"lineBreak":true},{"text":"ሺኢቂፆ ታኣሲ ኔኤኮ ጌኤዦ ማኣሮይዳ ኔ ዋይዜኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሉኡዚ ማዔ ፆኦዞ ካኣሽካ ዓሳ ቢያ","poem":1},{"text":"ኔኤም ጉሙርቂንታያ ማዒፆ ሃሼኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዻቂሻሢ ናንጊና ናንጋ ጎዳታሢሮ","poem":1},{"text":"ታኣኒ ጋላታ ዓይኑሞና ዎላ ዒንጎ ባኣዚያ ሺኢሻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒዛም ታኣኒ ናኣቤ ባኮዋ ዒንጋንዳኔ።»","poem":2}]},{"type":"verse","number":10,"content":["ዬካፓ ናንጊና ናንጋ ጎዳ ዓይሤም ሞላሢ ዮናኣሴ ዔኪ ኬሲ ባዞ ዓጫ ጮኦሽኬኔ።"]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}