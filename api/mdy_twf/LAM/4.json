{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"LAM","translationId":"mdy_twf","name":"ዔርሚያሴኮ ቃዮ ማፃኣፖ","commonName":"ዔርሚያሴኮ ቃዮ ማፃኣፖ","title":"ዔርሚያሴኮ ቃዮ ማፃኣፖ","order":25,"numberOfChapters":5,"sha256":"540f88e532b11b835f424ae2f194cbd99cbbc3023fe73481c1871758542e34bd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/mdy_twf/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"heading","content":["ዬሩሳላሜይዳ ሄሌ ሜቶ"]},{"type":"verse","number":1,"content":[{"text":"ጌኤዦ ማኣሮ ማዦና ሹጫ ጉሪ ዞኦስካ ኬኤሪንቴኔ።","poem":1},{"text":"ዎዎይቴዖ ዎርቃ ሳልፔንቴሞ!","poem":2},{"lineBreak":true},{"text":"ጌኤዦ ዎርቃ ሜሌ ባኣዚ ማዔንቴሞ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ፂዮኔይዳ ዓኣ ዓቲንቆ ናኣታ ጌኤሺ ዎርቄጉዲታዖኬ፤","poem":1},{"text":"ሃይሾ ሃሢ ማኒ ዢኢጬ ዓጪና ማዤ","poem":2},{"lineBreak":true},{"text":"ሜሄ ማዒ ዓቴንቴሞ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ዉኡካሢታዖ ፔኤኮ ሾዖና ናኣቶ ዻዻንሢሣኔ፤","poem":1},{"text":"ሃይ ታኣኮ ዴራ ዓሲ ናንጉዋ ዳውሎይዳ ዓኣ ቱኡቴጉዲ","poem":2},{"lineBreak":true},{"text":"ፔኤኮ ናኣቶም ሚጪንቱዋያ ማዔንቴሞ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ናኣቶ ዔያቶኮ ዋኣፃ ዼኤቤሢሮ ናኣቶኮ ዒንዲርዛ","poem":1},{"text":"ዻንጎይዳ ዓዺንቲ ዴዔኔ፤","poem":2},{"lineBreak":true},{"text":"ናኣታ ዔያቶኮ ሙኡዚ ሺኢቃኔ፤","poem":2},{"text":"ጋዓንቴ ፔቴታዖ ዔኤቢ ዔያቶም ዒንጋ ዓሲ ባኣሴ።","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ሃያኮ ቤርታ ቃውቲ ቃውቲ ኮሺ ባኣዚ ሙዓ ዓሳ","poem":1},{"text":"ካራ ባይዚ ሴካ ሃንጋ ጉሪ ዤኤማኔ።","poem":2},{"lineBreak":true},{"text":"ጋላፒ ማዔ ሚዛጶ ማኣዓሢ ማይንቲ ዲጬ ዓሳ","poem":2},{"lineBreak":true},{"text":"ሃሢ ዲቢንሢ ላኣሎ ዱባይዳ ፔና ሃሺ ላሄኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ታ ዴሮይዳ ሄሌ ሜታ","poem":1},{"text":"ዖኦኒያ ካኣሙዋንቴ ዶዒ ባይቄ","poem":2},{"lineBreak":true},{"text":"ሶዶሜ ካታሞ ሜታፓ ባሻያኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ካኣቶ ናኣቶ ማዔ ዔያቶ ሱኡጋ ዔያቶ ኮይላ","poem":1},{"text":"ሻቺፓ ባሼ፤ ዲኢቂፓኣ ባሼ ጌኤሽኪ ጴዻያኬ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶኮ ሚዛጱማ ሴንፔሬ ጌይንታ ሹጮጉዲኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ሃሢ ጋዓንቴ ዓኣፖ ካራ ዔያቶኮ ጪላንቺጉዲ ካርቴኔ፤","poem":1},{"text":"ዞኦዛ ዔያታ ሜታዺ ሃንታኣና ዔያቶ ዔራ ዓሲያኣ ባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ሜልዚ ሚሢጉዲ ዒልዓ ዔያቶኮ ዑፆይዳ ፓፂ ባይቄኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ናዮና ሃይቂ ኩዳ ዓሶይዳፓ","poem":1},{"text":"ጬንቾ ዓራፖና ዎዾ ዓሳ ቃራኬ፤","poem":2},{"lineBreak":true},{"text":"ሙዓ ባይቄሢሮ ዓሳ ዞኦዛ ናዮና ሜሊ ጉሪ ኩዳኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ባይሲንታ ኬዴም ካታማ ካራ ባይቄ ዎዶና","poem":1},{"text":"ናኣቶ ሚጪንታ ላኣላ ፔ ኩቻ ፔኤኮ ናኣቶ ካሢ ሙዔኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ናንጊና ናንጋ ጎዳ ፔኤኮ ዼኤፖ ዻጎ ዴንሢ","poem":1},{"text":"ፂዮኔኮ ፃጶ ሙይ ዶዶይሳንዳ ታሚጉዲ","poem":2},{"lineBreak":true},{"text":"ዔዔኤታ ፑርታ ባኣዚ ኬይሴኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዓጮ ቢያሢዳ ዓኣ ካኣቶዋ ማዖም ዴራ","poem":1},{"text":"ዬሩሳላሜ ካታሞኮ ጌሎ ካሮና","poem":2},{"lineBreak":true},{"text":"ሞርኬ ጌላንዳኔ ጌይ ፔቴታዖ ማሊባኣሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ጋዓንቴ ዬይ ያዺ ማዔሢ ዒኢካ ጌኤዦ ዓሶ ዎዼ","poem":1},{"text":"ቄኤሶንታ ፆኦሲ ማሊፆ ኬኤዛ ዓሶ ጎሞ ዛሎናኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ዔያታ ዬያ ሱጉፆና ዒኢቴያታሢሮ","poem":1},{"text":"ዔያቶኮ ማኣዓሢታዖ ጫርቂ ካኣማ ዓሲ ባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ዓኣፒ ባይቄ ዓሲጉዲ ጎይፆይዳ ሴካ ሃንጋ ቴኤም ጋዓኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ዬያሮ ዴራ፦ «ዴንዲ ባይቁዋቴ!","poem":1},{"text":"ዒንሢ ዒኢቴ ዓሲታሢሮ ኑና ሄሊፖቴ!» ጌይ ዒላታኔ።","poem":2},{"lineBreak":true},{"text":"ዬያሮ ዔያታ ዒፂ ዳውሶና ዓሲ፥ ሃሣ ቤሲ ባይዜ ዓሲ ማዔኔ፤","poem":1},{"text":"ዴራ፦ «ሃካፓ ሴካ ማይ ዔያታ ኑ ባኣካ ዴይንዱዋሴ» ጌዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዔያቶ ፔኤሮ ዜሪ ዳኬሢሮ","poem":1},{"text":"ሃካፓ ሴካ ዒዚ ዔያቶ ዛሎ ማላዓኬ፤","poem":2},{"lineBreak":true},{"text":"ቄኤሶዋ ዒዚ ቦንቺሳዓኬ፤","poem":2},{"lineBreak":true},{"text":"ዒኢካ ዓኣ ጋርቾማኣ ኮሺ ባኣዚ ማዺንታዓኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«ኑና ማኣዳንዳያ ሙካንዳኔ» ጌይ ኑ ጎይሢ ዛጋኣና ላቤኔ፤","poem":1},{"text":"ኑና ዓውሳኒ ዳንዳዑዋ ዓሲ ኑኡኮ ሴኤሎይዳ ዔቂ ኑ ጉሪ ካፔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ኑኡኒ ጎይፆይዴና ሴካ ሃንጋ ሃንቱዋጉዲ","poem":1},{"text":"ሞርካ ኑና ዚርቂ ዔቂ ካፓኔ፤","poem":2},{"lineBreak":true},{"text":"ኑኡኮ ጋፒ ዎዴ ሄሌኔ፥ ኬሊ ኑም ሜንሦናኣኬ፤","poem":2},{"lineBreak":true},{"text":"ኑኡኒ ኩዳኒ ዑኬኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ኑና ዳውሳ ሞርካ ኮኦኬይዳፓ ባሼ ሩኡራያኬ፤","poem":1},{"text":"ዹኮ ዑፆይዳ ኑና ዳውሴኔ፤","poem":2},{"lineBreak":true},{"text":"ዓሲ ናንጉዋ ዳውሎ ቦኦሎይዳኣ ኑና ካቴኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ናንጊና ናንጋ ጎዳ ካኣቲ ማሂ ዶኦሜ","poem":1},{"text":"ኑኡኮ ሼምፓሢኮ ዑኡዞ ማዔሢ","poem":2},{"lineBreak":true},{"text":"ዔያታ ፔ ፒራሢና ፒሪ ዓይሤኔ፤","poem":2},{"text":"ዒዛ ሺቦ ዴማ ዴዒ","poem":1},{"text":"ዴሮ ባኣኮይዳ ናንጋንዳኔ ጌይ ኑኡኒ ማሌንቴኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ዒንሢ ዑፄይዳ ናንጋ፥ ዔዶኦሜ ዴራ","poem":1},{"text":"ዎዛዹዋቴ፥ ዒላሹዋቴ!","poem":2},{"lineBreak":true},{"text":"ጋዓንቴ ዒንሢም ጊኢጊሾና ጳዻሢ","poem":2},{"lineBreak":true},{"text":"ፔ ዎዶ ካፒ ሙኮ ዓታዓኬ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢያ ማሢንቲ፥ ማኣዓሢ ኬኤሪ ካላዻንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ዬሩሳላሜ ዴሬዮቴ! ዒንሢ ዻቢንቶሮ","poem":1},{"text":"ዒንሢም ዓጎና ፑርቶ ባካ ጊዳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ዑኬና ዒንሢ ዳውሲንቲ ዴንዴ ባዛፓ ማሃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ጋዓንቴ ዔዶሚያሴ ዴሬዮቴ! ዒንሢ ዻቢንቶ ዛሎ","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ዒንሢዳ ሜቶ ዓጋንዳኔ፤ ዻቢንቶዋ ዒንሢኮ ፔጋሳንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}