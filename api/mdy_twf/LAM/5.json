{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"LAM","translationId":"mdy_twf","name":"ዔርሚያሴኮ ቃዮ ማፃኣፖ","commonName":"ዔርሚያሴኮ ቃዮ ማፃኣፖ","title":"ዔርሚያሴኮ ቃዮ ማፃኣፖ","order":25,"numberOfChapters":5,"sha256":"540f88e532b11b835f424ae2f194cbd99cbbc3023fe73481c1871758542e34bd","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/mdy_twf/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"heading","content":["ፆኦሲ ሚጪንታንዳጉዲ ሺኢቂንቴ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኑና ሄሌ ባኮ ዛሎሮ ኑም ማሌ፤","poem":1},{"text":"ኑኡኮ ዻውሲንቶ ዛጌ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ኑኡኮ ዴና ዔውቲ ሜሌ ዓሲም ዒንጊንቴኔ፤","poem":1},{"text":"ኑኡኮ ኬኤፃ ቢያ ሜሌ ፃንጎ ዓሲ ናንጋ ኬኤሢ ማዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ኑኡኒ ዓዴ ሃይቄ ዜኤሪ ማዔም","poem":1},{"text":"ኑኡኮ ዒንዶንሢያ ዜኤሪ ዒንዶ ማዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ኑኡኒ ዑሽካ ዋኣፆንታ","poem":1},{"text":"ካያፓ ሃኣኮ ሃንፂሎንታ ሻሻንቃኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ኑና ዳውሳ ዓሳ ኑኡኮ ባቃና ዴዒ ዓኣኔ፤","poem":1},{"text":"ኑኡኒ ላቤኔ፥ ሃውሾዋ ኑኡኮ ባኣሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ኑም ጊዳ ሙኡዚ ዴንቃኒ ጊብፄ ዓጮና","poem":1},{"text":"ዓሶኦሬ ዓጮናም ኩቺ ኑ ዒንጌኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ኑ ዓዶንሢ ጎሜ ማዺ ኑም ሃሼኔ፤","poem":1},{"text":"ኑኡኒ ዔያቶም ዓጎና ሜቶ ዔኪሢዳኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ሃያኮ ቤርታ ዓይሌ ማዔ ዓሳ ሃሢ ኑና ዎይሣያ ማዔኔ፤","poem":1},{"text":"ዔያቶ ኩጫፓ ኑና ዓውሳኒ ዳንዳዓ ዓሲያኣ ባኣሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ዳውሎ ቦኦሎይዳ ዎዻ ዓሲ ዓኣሢሮ","poem":1},{"text":"ኑኡኒ ሙዖ ባኣዚ ዴንቃኒ ዳንዳዓሢ","poem":2},{"lineBreak":true},{"text":"«ዎዼቴ ዎዼ፥ ዻቂሼቴ ዻቂሼ» ጌይኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ናያ ኑና ባሼሢሮ","poem":1},{"text":"ዑፃ ኑኡኮ ናኣቦጉዲ ጪላንቄኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ኑኡኮ ላኣላ ፂዮኔይዳ","poem":1},{"text":"ኑኡኮ ዉዱሮ ናኣታኣ ዪሁዳ ካታሞይዳ","poem":2},{"lineBreak":true},{"text":"ዎልቄና ዓርቂንቴኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ኑ ሱኡጎኮ ኩጮ ቱኪ ሱፂ ዎዾናኔ፤","poem":1},{"text":"ኑኡኮ ጋርቾዋ ቦንቺቦኦሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ዓቲንቆ ዼጌሢ ዎልቃዺ ዎንሢ ዎዺሾናኔ፤","poem":1},{"text":"ዓቲንቆ ናኣቶ ዻካኣ ዴኤሢ ሃንፂሌ ኬዲና ሜታዼኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ዓጮ ጋርቻ ዴይ ዎጎ ዎጋ ቤዞ ሃሺ ዴንዴኔ፤","poem":1},{"text":"ዼጌሢያ ኮርጋ ኮፆ ሃሼኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ዎዛ ኑኡኮ ዒናፓ ባይቄኔ፤","poem":1},{"text":"ኑ ዎንዴ ዎዛዺ ኮርጋ ኮፆ ባይዚ ዖዪሢ ዓርቄኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ቦንቻ ኑኡኮ ዔውቲ ባይቄኔ፤","poem":1},{"text":"ኑኡኒ ጎሜ ማዼሢሮ ኑና ባዴዔ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ያዺ ማዔሢሮ ኑኡኒ ሃርጌ ዓሲ ማዔኔ፤","poem":1},{"text":"ዓኣፓኣ ኑኡኮ ፒዜ ዛጎ ባሺንቲ ላቤኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ፂዮኔ ዹካ ዓሲባኣያ ጉሪ ቤሲ ማዒ ዓቴሢሮ","poem":1},{"text":"ዉኡካ ዒኢካ ዓማሊ ሺራ ቤሲ ማዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ኔኤኒ ጋዓንቴ ናንጊና ናንጋ ጎዳሢዮ! ናኣናና ካኣቲኬ፤","poem":1},{"text":"ኔኤኮ ካኣቱሞ ዖይታ ሙካ ዎዶ ቢያይዳ ባይቃዓኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ኔ ኑና ዎይታዛ ጋፒ ዋሊ ሃሼዖ?","poem":1},{"text":"ሚርጌ ዎዴ ኔ ኑና ኬንኬሊዲ ሃሼንቴሞ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔ ባንሢ ኑና ማሄ፥ ኑኡኒ ማዓንዳኔ፤","poem":1},{"text":"ኑኡኒ ናንጋ ናንጎ ቤርታኣ ዎዶጉዲ ማሂ ጊንሣ ኮሼ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ኔኤኒ ዬያይዲባኣቴ ጋፒ ኑና ኔ ሃሺ","poem":1},{"text":"ኑኡኒ ማዼ ባኮሮዋ ዑሣ ዓኣዼ ኔ ዻጋዼኔ ጌይሢኬ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}