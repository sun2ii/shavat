{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"NAM","translationId":"mdy_twf","name":"ናሆኦሜ ማፃኣፖ","commonName":"ናሆኦሜ ማፃኣፖ","title":"ናሆኦሜ ማፃኣፖ","order":34,"numberOfChapters":3,"sha256":"584f665565a2d5f69d2b7d5297b0826c2753cbc0d412d04432f092ea4ffb3805","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/mdy_twf/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["ኔኔዌኮ ሎኦሚፆ"]},{"type":"verse","number":1,"content":[{"text":"ኔኔዌ! ኔጊዳ ሜታ ዬዔኔ!","poem":1},{"text":"ዬያሮ ኔኤኮ ዋርዲዮ ኬኤሎ ዲፆ ዶዲሼ!","poem":2},{"text":"ዚጊሮ ጎይፆ ቢያ ዛጊ ካፔ! ዖልዚ ዓንጋሞ ዓርቂ ጊኢጌ!","poem":1},{"text":"ዓኣ ዎልቆ ኔኤኮ ቢያ ቡኩሲ ዶዲሼ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሞርካ ዔያቶንታ ዔያቶኮ ዓኣ ባኮንታ","poem":1},{"text":"ዲርካቺ ባይዚ ኩርሴታቴያ","poem":2},{"text":"ናንጊና ናንጋ ጎዳ ያይቆኦቤ ናኣቶ ማዔ","poem":1},{"text":"ዒስራዔኤሌ ጊንሣ ማሂ ቦንቺሳንዳኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዖሎ ዓሳ ዞቄ ዞቄ ጊቲማ ዔኪ ዓኣኔ፤","poem":1},{"text":"ዔያታ ማኣዔ ማኣዓሢያ ዞቄ ዲንኪኬ፤","poem":2},{"lineBreak":true},{"text":"ዒዚ ዔያቶ ዖሎሮ ኬሳዛ ሳርጌሎ ዖይታ ዓኣፓ ዱዱካያኬ፤","poem":2},{"lineBreak":true},{"text":"ፓራሢና ዖላ ዓሳኣ ፓራሢዳ ዴዒ ዖሎሮ ዓፃዺ ዋኣጪንታኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ሳርጌሎ ዖይታ ዢባሬጉዲ ጎይፆይዳ ዎላ ሄሌሎ ጳሽካኔ፤","poem":1},{"text":"ጶኦኮይዳ ሴካ ሃንጋ ዣኣቂ ሺራኔ፤","poem":2},{"text":"ዔዔኤታ ታሚ ማላኔ፤","poem":1},{"text":"ዜኤሊንሢጉዲያኣ ዡኡዣኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዒዚ ፔኤኮ ዖሎ ዓሶ ዓይሣ ቢቶ ዔኤላኔ፤","poem":1},{"text":"ዔያታኣ ዹቂንቲ ሎኦሚ ሎኦሚ ዬዓኔ፤","poem":2},{"lineBreak":true},{"text":"ሞርኮኮ ዖሎ ዓሳ ጳሽኪ ጳሽኪ","poem":2},{"lineBreak":true},{"text":"ካታሞኮ ዙሎ ኬልቂ ዲርቆና ዲፆ ባንሢ ጳሽካኔ፤","poem":2},{"lineBreak":true},{"text":"ዱኪንታ ሂኢዦ ዔያታ ፔኤኮ ዼኤፖ ጊቲሞና","poem":2},{"lineBreak":true},{"text":"ዔያቶ ዓይዱዋጉዲ ቃዛኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ዎሮ ዛሊና ዓኣ ካታሞ ጌሎ ካራ","poem":1},{"text":"ሜኤሊዮ ጌይ ፖዒ ቡሊንቴኔ፤","poem":2},{"lineBreak":true},{"text":"ካኣቱሞ ማኣሮይዳ ዓኣ ዓሶማኣ ካራ ባይቄኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኔኔዌ ዻውሲንቴኔ፥ ጌኤሻ ዲዒንቲ ዔውቴኔ፤","poem":1},{"text":"ዒዞም ማዾ ማዻ ላኣላ ኩኡኬ ዑኡሲና","poem":2},{"lineBreak":true},{"text":"ዳዶዋ ፔኤኮ ዱሊ ዱሊ ዒላቲ ቃያኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኔኔዌ ሚናፓ ዴዴዔ ቦቆሊ ዋኣሢኬ፤","poem":1},{"text":"ሃሢ ዒኢካፓ ኬስኪ ሾኦቲ ዴንዳኣና","poem":2},{"lineBreak":true},{"text":"«ዔቁዋቴ! ዔቁዋቴ!» ዓሲ ጌዔም ሺሪ ሺሪ ዛጋዓኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ካታሞይዳ ዓኣ ባካ ጋፓ ባኣዚቱዋሴ፤","poem":1},{"text":"ሚዛጶ ሹጮኮ ሚርጉማ ሃይማኬ ጌይንታያቱዋሴ፤","poem":2},{"lineBreak":true},{"text":"ዬያሮ ዴንዲ ቢሮ ዓንጎንታ ዎርቆንታ ቡሪ ዔኩዋቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ኔኔዌ ዲርካቺንቲ ባይቄኔ፤","poem":1},{"text":"ቤሲ ባይቂያ ዶዔኔ፤","poem":2},{"lineBreak":true},{"text":"ዓሶኮ ጎጳ ዒጊጪ ዋኣፄኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያ ዒጊቹማፓ ዔቄያና ዎልቃ ዔያቶኮ ጌሌኔ፤","poem":2},{"lineBreak":true},{"text":"ዓሲ ቢያ ዒጊጪ ጎጋይቄኔ፤","poem":2},{"lineBreak":true},{"text":"ዓሶ ቢያሢኮ ዓኣፖ ካራ ቦኦሪ ሜሌ ማዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ሚርጌ ዞቢ ናንጋ ቤሲ","poem":1},{"text":"ሃጊ ዔቃ ዞቦ ናኣታ ሙዖ ሙዓ ቤሲ","poem":2},{"lineBreak":true},{"text":"ዓዶንታ ዒንዶ ዞቦንታ ፔኤኮ ናኣቶና ዎላ","poem":2},{"lineBreak":true},{"text":"ሂርጋ ባኣያ ላሂ ዓማሊ ሺራ ቤሲ ማላ","poem":2},{"lineBreak":true},{"text":"ዬና ካታሜላ ሃሢ ዎካዳዖ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዞባሢ ፔኤኮ ናኣቶም ጊዳንዳያ ኬሚ ዎዺ ዔኪ ዬዔኔ፤","poem":1},{"text":"ዞቦ ዒንዴሎማኣ ሙዖንዶያ ዔኪ ሙኬኔ፤","poem":2},{"lineBreak":true},{"text":"ዒኢካ ዔያታ ናንጋ ቤዞ ኬሚ ዎዾና ቦዖና","poem":2},{"lineBreak":true},{"text":"ዴኖ ዔቶዋ ሾኦሊ ሾኦሊ ላኣሎና ዓሽኪና ዒ ኩንሤኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":["ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢ፦ «ኔኔዌ! ታ ኔና ባይዛኒ ዔቄኔ፤ ሳርጌሎ ዖይቶዋ ታኣኒ ኔኤኮ ሚቻንዳኔ፤ ሃጊ ዔቃ ዞቦ ናኣቶዋ ጬንቻ ዓራፖ ዎዻንዳኔ፤ ሳዖይዳ ኔኤኒ ዖሊ ባሻንዳ ዓሲ ባኣያ ታኣኒ ማሃንዳኔ፤ ኔኤኒ ዳካ ኪኢቶ ዓሶኮዋ ዑኡሲ ሃይካፓ ሴካ ዋይዚንታዓኬ» ጋዓኔ።"]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}