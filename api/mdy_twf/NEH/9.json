{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"NEH","translationId":"mdy_twf","name":"ኔሄሚያ ማፃኣፖ","commonName":"ኔሄሚያ ማፃኣፖ","title":"ኔሄሚያ ማፃኣፖ","order":16,"numberOfChapters":13,"sha256":"1b1dd6a2505e9e166526179d1748aab8bd52c63964f1cd4236b5e8aa49422baf","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/NEH/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/mdy_twf/NEH/13.json","totalNumberOfVerses":312},"chapter":{"number":9,"content":[{"type":"heading","content":["ዒስራዔኤሌ ዴራ ጎሞ ቡኡፄሢ"]},{"type":"verse","number":1,"content":["ዬኖ ዓጊኖኮ ላማታሚ ዖይዳሳ ዓቦና ዒስራዔኤሌ ዴራ ፔቴይዳ ቡኪንቴኔ፤ ዔያታ ዒማና ፔኤኮ ጎሞ ዛሎ ዻቤያ ማዒፆ ዔርዛኒ ሲዬ ፓቲሌ ማይንቲ፥ ፔኤኮ ቶኦኮይዳ ዓጪ ዋሂ፥ ሙዖ ሃሾ ዳምቦዋ ኩንሤኔ፤"]},{"type":"verse","number":2,"content":["ዔያታ ፔና ሜሌ ዴሮይዳፓ ዱማሴኔ፤ ዬያይዴስካፓ ቢያሢ ዴዔ ቤዛፓ ዔቃዖ ዔያቶና ዔያቶኮ ቤርታኣ ዓዶንሢና ማዼ ጎሞ ቢያ ቡኡፄኔ።"]},{"type":"verse","number":3,"content":["ዔያታ ዔቄ ቤዞማካ ዓኣንቴ ሃይሦ ሳኣቴ ጉቤ ናንጊና ናንጋ ጎዳ ማዔ ዔያቶ ፆኦዛሢኮ ዎጎ ማፃኣፓ ዔያቶም ናባቢንቴኔ፤ ጊንሣ ሃሣ ዒማ ዔያታ ኔጌማጉዴያ ኔጊ ፔኤኮ ጎሞ ቡኡፂ ቡኡፂ ናንጊና ናንጋ ጎዳ ማዔ ፔ ፆኦዛሢም ዚጌኔ።"]},{"type":"verse","number":4,"content":["ዒኢካ ሌዊ ዓሶም ዔቆንዶ ዼጌ ቤሲ ኮሾናያ ዓኣኔ፤ ዬኖ ቤዞይዳ፦ ዒያሱ፥ ባኒ፥ ቃድሚዔኤሌ፥ ሼባኒያ፥ ቡኒ፥ ሼሬቢያ፥ ባኒንታ ኬናኒንታ ዔቃዖ ናንጊና ናንጋ ጎዳ ማዔ ዔያቶኮ ፆኦዛሢ ዼግ ጌዔ ዑኡሲና ሺኢቄኔ።"]},{"type":"verse","number":5,"content":["ሃሣ ዒያሱ፥ ቃድሚዔኤሌ፥ ባኒ፥ ሃሻቤኒያ፥ ሼሬቢያ፥ ሆዲያ፥ ሼባኒያንታ ፔታህያ ጌይንታ ሌዊ ዓሶንሢ፦",{"text":"«ዒንሢ ዔቂጋፓ ናንጊና ናንጋ ጎዳ","poem":1},{"text":"ዒንሢኮ ፆኦዛሢ ጋላቱዋቴ፤","poem":2},{"text":"ጋላታና ዓንጆናኮ ቢያ ዑሣ","poem":1},{"lineBreak":true},{"text":"ዒ ዼግ ዼጊ ጎዖንጎ! ጎውዋቴ» ጌዔኔ።","poem":1}]},{"type":"heading","content":["ቡኡፃ ሺኢጲሢ"]},{"type":"verse","number":6,"content":["ዬካፓ ዒስራዔኤሌ ዴራ ሂዚ ጌይ ሺኢቄኔ፦",{"text":"«ናንጊና ናንጋ ጎዳሢዮ! ኔኤኒ ሌሊ ፆኦሲኬ፤","poem":1},{"text":"ጫሪንጮንታ","poem":2},{"lineBreak":true},{"text":"ጫሪንጮኮ ጫሪንጮ ዦኦጋሢንታ","poem":2},{"lineBreak":true},{"text":"ሳዖና ዒኢካ ዓኣ ባኮ ቢያ","poem":2},{"lineBreak":true},{"text":"ባዞንታ ዬያቶይዳ ዓኣ ባኮ ቢያ","poem":2},{"lineBreak":true},{"text":"ኔ ማዤኔ፤ ቢያሢም ሼምፔ ኔ ዒንጌኔ፤","poem":2},{"lineBreak":true},{"text":"ጫሪንጮ ማዢንታ ኔኤም ዚጋኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ባብሎኔይዳ ዑሬ ጌይንታ ካታሜሎይዳፓ","poem":1},{"text":"ዓብራሜ ዶኦሪ ሃይካ ዔኪ ሙኬሢ","poem":2},{"lineBreak":true},{"text":"ሱንፆዋ ዒዛኮ ‹ዓብራሃሜ› ጌይ ጌሤሢ","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ናንጊና ናንጋ ጎዳ ፆኦሲኬ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዒዚ ኔኤም ጉሙርቂንቴያ ማዔሢ ኔ ዛጊ","poem":1},{"text":"ዒዛና ዎላ ኔ ጫኣቄኔ፤","poem":2},{"lineBreak":true},{"text":"ካኣናኔ ዓሳ፥ ሂኢታ ዓሳ፥","poem":2},{"lineBreak":true},{"text":"ዓሞራ ዓሳ፥ ፔርዛ ዓሳ፥","poem":2},{"lineBreak":true},{"text":"ዒያቡሳ ዓሶንታ ጌርጌሳ ዓሶንታ","poem":2},{"lineBreak":true},{"text":"ናንጋ ካኣናኔ ዓጮ","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ዜርፆም ናንጊ ዓጪ ማሂ","poem":2},{"lineBreak":true},{"text":"ዒንጋኒ ኔ ዒዛም ጫኣቄኔ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ጉሙርቂንታያታሢሮ","poem":2},{"lineBreak":true},{"text":"ኔ ጫኣቁሞ ኔኤኒ ዶዲ ካፔኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«ኔኤኒ ኑኡኮ ቤርታኣ ዓዶንሢ ጊብፄይዳ","poem":1},{"text":"ሄሌ ሜታሢ ዛጌኔ፤","poem":2},{"lineBreak":true},{"text":"ሃሣ ዞቄ ባዞ ኮይላ ዓኣዖ","poem":2},{"lineBreak":true},{"text":"ዔያቶ ኔ ማኣዶም ዔያታ ኔና ሺኢቄሢ ኔ ዋይዜኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጊብፄ ካኣቲዳ","poem":1},{"text":"ዒዛኮ ቢታንታ ዓኣ ዓሶና ዓጮናይዳ","poem":2},{"lineBreak":true},{"text":"ናንጋ ዴሮ ቢያይዳ","poem":2},{"lineBreak":true},{"text":"ዲቃሣያ ማዔ ኔ ዎልቆና ማዺንታ ባኮ ፔጋሲ ኔ ዻዌኔ።","poem":2},{"lineBreak":true},{"text":"ዬያ ኔ ማዼሢ ዔያታ ኑኡኮ ቤርታኣ ዓዶንሢ","poem":2},{"lineBreak":true},{"text":"ዎማይዲ ሄርቂ ዎይሤቴያ ኔ ዛጌሢሮኬ፤","poem":2},{"lineBreak":true},{"text":"ዬያ ኔ ማዺፆና ሃኖ ሄላንዳኣና","poem":2},{"lineBreak":true},{"text":"ዼኤፑማ ኔኤኮ ዔርቴያ ማዔኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ባዞ ዋኣፆ ኔ ዔያቶኮ ቤርታ ላምዖ ፓቄም","poem":1},{"text":"ዔያታ ፃኣዺ ሳዓና ፒንቄኔ፤","poem":2},{"lineBreak":true},{"text":"ሹቺ ባዞ ዋኣፆይዳ ኬኤሪንታሢጉዲ","poem":2},{"lineBreak":true},{"text":"ዔያቶ ዳውሳዞንሢ","poem":2},{"lineBreak":true},{"text":"ባዞ ዋኣፆ ዔቶይዳ ዔኪ ኔ ዓጌኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሮኦሮ ኔ ዔያቶ ፒዝ ጌይ ዔቄ ሻኣሬና ካኣሌሤኔ፤","poem":1},{"text":"ዋንቶ ጎይፆ ዔያቶኮ ኔ ፒዝ ጌዒ ዔቄ ታሚና ፖዔኔ፤","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ጫሪንጫፓ ሲና ዹኮይዳ ኔ ኬዲ","poem":1},{"text":"ዴሮና ኔኤኮ ኔ ጌስቴኔ፤","poem":2},{"lineBreak":true},{"text":"ፒዜ ማዔ ዎጎና ዳምቦና","poem":2},{"lineBreak":true},{"text":"ኮሺ ማዔ ዳምቦና ዓይሢፆና ኔ ዔያቶም ዒንጌኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኔኤኮ ዱማዼ ሃውሾ ኬሎ ዔያቶ ኔ ዔርዜኔ፤","poem":1},{"text":"ኔ ዓይላሢ ሙሴ ዛሎና","poem":2},{"lineBreak":true},{"text":"ኔ ዓይሢፆ፥ ኔ ዳምቦንታ ኔኤኮ ዎጎንታ ኔ ዔያቶም ዒንጌኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«ዔያታ ናይዻዛ ጫሪንጫፓ ሙኡዚ ኔ ዔያቶም ዒንጌኔ፤","poem":1},{"text":"ዔኤታ ዼኤቢንታዛ ላላፓ ዋኣሢ ኔ ዔያቶም ኬሴኔ፤","poem":2},{"text":"ኔ ዔያቶም ዒንጋኒ ጫኣቄ ዓጮ","poem":1},{"text":"ዔያታ ፔ ዴማ ማሃንዳጉዲ ኔ ዔያቶ ዓይሤኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጋዓንቴ ኑኡኮ ቤርታኣ ዓዶንሢ ዖቶርቃያና ዋይዚ ዒፃ ዓሲ ማዔኔ፤","poem":1},{"text":"ኔ ዎጎና ናንጊፆዋ ዔያታ ዒፄኔ፤","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዔያታ ዓይሢንታያ ማዒባኣሴ።","poem":1},{"text":"ኔ ዎልቆና ኔ ዔያቶ ባኣካ ማዼ ባኮ ቢያ ዔያታ ዋሌኔ፤","poem":2},{"lineBreak":true},{"text":"ዋይዞ ዒፂ ዶዳያ ማዒ","poem":2},{"lineBreak":true},{"text":"ጊብፄ ዓይሉሞ ባንሢ ዔያቶ ዔኪ ዓኣዻንዳ","poem":2},{"lineBreak":true},{"text":"ሱኡጌ ዔያታ ዶኦሬኔ።","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ጋዓንቴ ናሹሞ ኩሜያ","poem":2},{"lineBreak":true},{"text":"ዻጋዻኒ ሩኡሩዋያ ዓቶም ጋዓያ","poem":2},{"lineBreak":true},{"text":"ኮሺ፥ ሃሣ ዓቶም ጋዓ ፆኦሲ ማዔሢሮ ዔያቶ ኔ ሃሺባኣሴ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ናኣሪ ማሊሲ ካኣሽኮ ባኣዚ ፔኤም ዔያታ ኮሺ","poem":1},{"text":"‹ጊብፄ ዓጫፓ ዔኪ ኑና ኬሴ ጎዳ ሃያኬ› ጌዔኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያ ሌሊቱዋንቴ ዴኤሢ ጫሺ ኔና