{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"NUM","translationId":"mdy_twf","name":"ፓይዲ ማፃኣፔ","commonName":"ፓይዲ ማፃኣፔ","title":"ፓይዲ ማፃኣፔ","order":4,"numberOfChapters":36,"sha256":"08e1c5fb1596e69959dcfa7d4583127df42d4e7ab040ee9cf5171cba5040117a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/mdy_twf/NUM/36.json","totalNumberOfVerses":1183},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["ናንጊና ናንጋ ጎዳ ዒስራዔኤሌ ዓሶ ዒ ዓንጃንዳጉዲ ኮዔሢ ባኣላኣሜ ዔራዖ፥ ቤርታ ዒ ማዻ ጎይፆ ማርሾ ማርሻኒ ዳንዳዒባኣሴ፤ ጋዓንቴ ዓሲ ናንጉዋ ዳውሎ ባንሢ ሺሪ ዔቃዖ፦"]},{"type":"verse","number":2,"content":["ዒስራዔኤሌ ዴራ፥ ፔኤኮ ፃጶና ፃጶና ዎሊ ሄሊ ዱንኪ ዴዔሢ ዴንቄኔ፤ ዒማና ፆኦሲ ዓያና ዒዛይዳ ሙኬም፥"]},{"type":"verse","number":3,"content":["ፆኦሲ ማሊሢ ሂዚ ጌይ ኬኤዚሢ ዓርቄኔ፦",{"text":"«ዓኣፓ ቡሊንቴም ዛጌ","poem":1},{"lineBreak":true},{"text":"ቢዖሬ ናኣዚ ባኣላኣሜ ኬኤዛ ባካ ያዺኬ፤","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ፆኦሲ ቃኣሎ ዋይዛሢ","poem":1},{"text":"ቢያ ባኣዚ ዳንዳዓ ፆኦዛሢዳፓ ማዔ ጊንዑዋንቴ ጴዼ ዓውቶ ዛጋሢ","poem":2},{"lineBreak":true},{"text":"ጊንዒ ዓኣንቴ ዓኣፓ ቡሊንቴሢ ሂዚ ጋዓኔ፤","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ያይቆኦቤ! ኔኤኮ ዓፒሎና ማዢንቴ ማኣራ","poem":1},{"text":"ዒስራዔኤሌ! ኔ ዎርቃ ቤዛ","poem":2},{"lineBreak":true},{"text":"ዎዚ ሚዛጳይ!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዬይ ማኣራ ፑኡሲንቴያ ማላ ዛሮጉዲ","poem":1},{"text":"ዎሮ ዓጫ ዓኣ ዱማ ዱማ ሚፃ ባቃሌ ቤዞጉዲ ጌሢንቲ ዴዒ ዓኣኔ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ቱኬ ዋላንጎጉዲ","poem":2},{"lineBreak":true},{"text":"ሃሣ ዋኣሢ ዓቺዳ ባቃሊ ዓኣ ዴኤሊ ዚቢቂጉዲኬ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሚርጌ ዒርዚ ዔያቶም ዋርቄኔ፤","poem":1},{"text":"ዔያታ ዜርቄ ባካ ጊዳንዳ ዋኣሢ ዴንቄኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶኮ ካኣቲ ዓጋጌይዳፓ ባሼ ማዓንዳኔ፥","poem":2},{"lineBreak":true},{"text":"ዓጫ ዒዛኮ ሚርጌና ዳልጊ ዳልጊ ዓኣዻንዳኔ፤","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጊብፄ ዓጫፓ ዔያቶ ኬሴ ፆኦዛሢ","poem":1},{"text":"ዔያቶኮ ሜኤኒ ካኣሪጉዲ ማዒ ሙካ ባኮ ዔያቶም ዹዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶኮ ሞርኮ ዔያታ ዞቢጉዲ ሾኦሊ ሙዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሜጌፆዋ ዔያቶኮ ጋኣጫንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሂዦዋ ዔያቶኮ ሜንሢ ባይዛንዳኔ፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዬይ ዓሳ ዒጊቻ ዞቢጉዲ ላሂ ዓኣኔ፤","poem":1},{"text":"ዔያቶ ጴቺ ዔቂሳንዳ፥ ጫርሺ ዖናዳይ?","poem":2},{"lineBreak":true},{"text":"ዒስራዔኤሌ ዓንጃሢ ዓንጂንቴያ","poem":2},{"lineBreak":true},{"text":"ጋዳንቃሢያ ሃሣ ጋዳንቂንቴያ ማዖንጎ!»","poem":2}]},{"type":"verse","number":10,"content":["ዬካፓ ባኣላኣቄ ሚርጌና ዻጋዺ፥ ፔ ኬኤሎ ዉፁርቃዖ ባኣላኣሜ ኮይላ፦ «ታኣኮ ሞርኮ ኔ ጋዳንቃንዳጉዲ ታ ኔና ዔኤላዛ፥ ኔ ጋዓንቴ ሃይሢ ማይንቲ ዓንጄኔ፤"]},{"type":"verse","number":11,"content":["ዓካሪ፥ ኔ ማኣሪ ዑኬ ዓኣዼ፤ ኔ ማዼ ባኮ ዛሎኮ ኮይሳሢጉዴያ ታ ጪጋኒ ማሌንቴ ናንጊና ናንጋ ጎዳ ኔና ዬያ ኔ ዴንቁዋጉዲ ላኣጌኔ» ጌዔኔ።"]},{"type":"verse","number":12,"content":["ባኣላኣሜ ባኣላኣቄም፦ «ኔኤኒ ታ ኮይላ ዳኬ ዓሶም፥"]},{"type":"verse","number":13,"content":["‹ኔ ማኣሮይዳ ዓኣ ዎርቆና ቢሮና ቢያ ኔ ታኣም ዒንጌቴታዖ ፆኦሲ ጌዔማ ኬኤዚሢዳፓዓቴም ሜሌ ታ ማሊሢና ኮሺ ባኣዚያ ማዖም ፑርታ ባኣዚ ታ ማዻኒ ዳንዳዑዋሴ› ጌይ ታ ኬኤዚባይ» ጌዔኔ።"]},{"type":"heading","content":["ባኣላኣሜ ኬኤዜ ጋፒንፆ ፆኦሲ ማሊፆ"]},{"type":"verse","number":14,"content":["ጋፒንፆይዳ ባኣላኣሜ ባኣላኣቄም፦ «ዓካሪ፥ ታኣኒ ታ ዓሶ ባንሢ ማዒ ዴንዳኔ፤ ጋዓንቴ ዬያኮ ቤርታ ዒስራዔኤሌ ዴራ ሃጊ ኔ ዓሶ ማዻንዳ ባኮ ታ ኔኤም ኬኤዛንዳኔ» ጌዔስካፓ፥"]},{"type":"verse","number":15,"content":["ፆኦሲ ማሊሢ ሂዚ ጌይ ኬኤዚሢ ዓርቄኔ፦",{"text":"«ቢዖሬ ናኣዚ፥ ባኣላኣሜ ኬኤዛ ባካ","poem":1},{"text":"ዓኣፓ ቡሊንቴም ዛጌሢ ሂዚ ጋዓኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ፆኦሲ ኬኤዜ ባኮ ዋይዛሢ","poem":1},{"text":"ዼኤፖ ፆኦዛሢዳፓ ዔራቶ ዴንቄሢ","poem":2},{"lineBreak":true},{"text":"ቢያ ባኮ ዳንዳዓሢ ፔጋሲ ዻዋ ባኮ ዛጋሢ","poem":2},{"lineBreak":true},{"text":"ጊንዒ ዓኣንቴ ዓኣፓ ቡሊንቲ ዛጋሢ ሂዚ ጋዓኔ፦","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ታ ዛጋኔ፤ ጋዓንቴ ሃሢቱዋሴ።","poem":1},{"text":"ታኣም ጴዻኔ፥ ጋዓንቴ ዑኬቱዋሴ፤","poem":2},{"lineBreak":true},{"text":"ዦኦጌ ያይቆኦቤይዳፓ ኬስካንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዎልቄና ዓኣ ካኣቲ ዒስራዔኤሌፓ ኬስካንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሞዓኣቤ ዓሶኮ ሱኡጎ ጳርቃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሞዓኣቤ ዒጊኒ ማዔ ሴኤቴ ዜርፆ ማዔ ዓቲንቆኮ ቶኦኮ ዳኣፃንዳኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዔዶኦሜ ዓሶ ባሻንዳኔ፤","poem":1},{"text":"ዒዛኮ ሞርኮ ማዔ ሴኤሬ ዓሶዋ ባሻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያይዲ ዒስራዔኤሌ ዓሳ ባባሻያ ማዒ ናንጋንዳኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዎይሣያ ያይቆኦቤይዳፓ ኬስካንዳኔ፤","poem":1},{"text":"ዬካ ካታማ ዓቴ ዓሶ ቢያ ዒ ባይዛንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":["ዬካፓ ሃሣ ባኣላኣሜ ዓማሌቄ ዓጮ ባንሢ ዛጊ ዛጊ፦",{"text":"«ዓማሌቄ ዴሮ ቢያይዳፓ ባሻ ካኣቶኬ፤","poem":1},{"text":"ጋፒንፆይዳ ጋዓንቴ ዒ ባይቃንዳኔ።»","poem":2}]},{"type":"verse","number":21,"content":["ቄና ዓሶዋ ዛጋዖ ሃሣ፦",{"text":"«ዒንሢ ናንጋ ቤዛ ጉሙርሳያኬ፤","poem":1},{"text":"ዒንሢ ማዤ ማኣራኣ ዔኤቢ ሄሉዋ ዼጌ ቤሲዳኬ፤","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዬይ ያዺ ማዔቴያ ዒንሢ ቄና ዓሳ","poem":1},{"text":"ዓሶኦሬ ዒንሢ ባሺ ዲዒ ዔኬ ዎዶና ዒንሢ ባይቃንዳኔ»","poem":2},"ጌይሢ ዓርቄኔ።"]},{"type":"verse","number":23,"content":["ሃሣ ዒ ኬኤዛዖ፦",{"text":"«ካኣ! ፆኦሲ ዬያይዳዛ","poem":1},{"text":"ዓይጎ ዓሲ ዓታንዳይ?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ኪቲሜ ኮይላፓ ዋኣሢ ካኣሚሌ ሙካንዳኔ፤","poem":1},{"text":"ዬያታ ሙኪ ዓሶኦሬንታ ዔቦኦሬያ ዓርቃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ጋዓንቴ ዔያታኣ ባይቃንዳኔ።»","poem":2}]},{"type":"verse","number":25,"content":["ዬካፓ ባኣላኣሜ ፔ ማኣሪ ማዒ ዓኣዻዛ፥ ባኣላኣቄያ ፔ ቤዞ ዴንዴኔ።"]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/NUM/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}