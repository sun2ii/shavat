{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PRO","translationId":"mdy_twf","name":"ኮኦኪንሢ ማፃኣፔ","commonName":"ኮኦኪንሢ ማፃኣፔ","title":"ኮኦኪንሢ ማፃኣፔ","order":20,"numberOfChapters":31,"sha256":"fef55438cb57e7a543072bf980cb9c53430183dde2c8044cd23d0e611ed7aa5e","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mdy_twf/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"ፔና ናሽካ ዓሲ ፔ ማሊፆ ጎይፆማ ሌሊ ዓኣዻኔ፤","poem":1},{"text":"ሜሌ ዓሲዳፓ ዒዛም ኬኤዚንታ ፒዜ ማሊሢታቴታዖ ዒፂ ማማካኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዔኤያ ዓሲ ፔ ኬኤዛ ባኮማ ሌሊ ፔጋሳኒ ኮዓፓዓቴም","poem":1},{"text":"ዔራቶ ሜሌ ዓሲዳፓ ዔኪሢ ዒዛ ዎዛሱዋሴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጎሜና ቦርሲንቲና ዎሊፓ ዱማዹዋ ባኣዚኬ፤","poem":1},{"text":"ኔኤኒ ቦንቺንቲ ባኣቴ ቦቦርሲንታንዳኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዓሲ ዻንጋፓ ኬስካ ዔራቶ ጌኤሲ","poem":1},{"text":"ኮሺ ዔታዼ ዔቴይዳ ዓኣ ዋኣሢጉዲኬ፤","poem":2},{"lineBreak":true},{"text":"ሃሣ ዓልቃ ዋኣሢጉዲያኣ ዓኣፃያኬ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዻቤ ዓሲ ማኣዲ ጌስቲሢና","poem":1},{"text":"ጌኤሺ ዓሲ ፒዜ ዎጌ ዴንቁዋጉዲ ማዺሢ ኮይሳያቱዋሴ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዔኤያ ዓሲ ጌኤሲ ዑራ ማዣኔ፤","poem":1},{"text":"ዒዚ ጉሪ ጌስቲ ሺራ ባካ ኮኦሎና ጳርቂሳኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዔኤያ ዓሲ ጌስታኣና ፔና ሜቶይዳ ዓጋኔ፤","poem":1},{"text":"ዒዛኮ ጌኤዛ ፒሮ ማዒ ዒዛ ዓርቃኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዾንኮ ዓሲኮ ጌኤዛ ዓኣሢ ሙኡዚጉዲ","poem":1},{"text":"ዎዛሲ ዎዛሲ ዴንዲ ዓሽኮ ጋሮ ሄላያኬ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ቤልፃ ዓሲ ዔኤቢ ፑርቲሴ ዓሲፓ ዱማዺ ዛጊንቱዋሴ፤","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳኮ ሱንፃ ዶዲ ዋርዲያ ቤሲጉዲኬ፤","poem":1},{"text":"ዬያሮ ኮሺ ዓሲ ዬያ ባንሢ ዶጪጋፓ ዻቃኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዖርጎጮ ዓሳ ጋዓንቴ ዔያቶኮ ቆላ ካታሞ ዙላ ዓኣ ዼጌ፤","poem":1},{"text":"ሃሣ ጊንሣ ዶዲ ኬኤሌ ማዒ ዔያቶ ካፓያ ዔያቶም ማላኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሎኦሞኮ ቤርታ ዓሲኮ ዒኔ ዖዖቶርቃኔ፤","poem":1},{"text":"ሼሌዔ ዓሲ ቦቦንቺንታኔ።","poem":2},{"lineBreak":true},{"text":"ሼሌዑሞ ጋዓንቴ ቦንቾፓ ቢራኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዋይዚ ዔኩዋዖ ማሂ ኬኤዚሢ","poem":1},{"text":"ዔኤያ ማሃኔ፤ ሃሣ ቦርሲሳያኬ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሃርጌ ሃርጋ ዎዴና ዶዲሢ ማማኣዳኔ፤","poem":1},{"text":"ላቢ ሺኢታያ ማዔቴ ማኣዳ ባኣዚ ባኣሴ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዔራ ዓሲኮ ዒኔ ዔራቶ ሚኢሼ ማሃኔ፤","poem":1},{"text":"ማሊ ጶቂሣ ዓሶኮ ዋያ ዔራቶ ኮዓኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዒንጊሢ ዒንጋሢም ጎይሢ ቡላኔ፤","poem":1},{"text":"ዼኤፖ ዓሶ ቤርቶዋ ዒዛ ኬሳኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዓሳ ቡካ ጶኦካ ቤርታዺ ኬስኪ ጌስታ ዓሢ","poem":1},{"text":"ዒዛና ሞኦታሢ ሙኪ ዒዛ ዖኦጫንዳያ ሄላንዳኣና","poem":2},{"lineBreak":true},{"text":"ቢያ ዎዴ ዒዚ ሌሊ ፒዜ ማዔያ ዒዛም ማላኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዒፃ ዓጊሢ ዑራ ሺሚሳኔ፤","poem":1},{"text":"ላምዖ ዶዲ ማርማዞንሢያ ዎላ ቡቡኩሳኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኔ ጌርሲ ማኣዴ፤","poem":1},{"lineBreak":true},{"text":"ዒዚ ካታሞኮ ዙላ ዓኣ ዶዲ ኬኤሌጉዲ ኔና ካፓኔ፤","poem":1},{"text":"ዒዛና ኔ ፑርቴቴ ጋዓንቴ ካሮ ኔኤም ዒ ዎዻንዳኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኔኤኮ ኮዦ ጌኤዛ ዔኪ ሙካ ባኮና","poem":1},{"text":"ኔኤኒ ዎዛዺ ናንጋኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ኔ ዻንጋ ሼምፓሢ ኔኤኮ ዓውሳኒና ባይዛኒያ ዳንዳዓኔ፤","poem":1},{"text":"ዬያሮ ኔ ዻንጎና ላጌ ኔኤኮ ኔ ማዤቴ ዎዛዺ ናንጋንዳኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ማቻ ናንጊና ናንጋ ጎዳይዳፓ ዒንጊንታ ዓንጆ ማዔሢሮ","poem":1},{"text":"ማቾ ኔኤኒ ዔኬቴ ኮሺ ባኣዚ ኔ ዴንቄኔ ጌይሢኬ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ማንቆ ዓሲ ፔና ሂርኪሲ ሼሌዑሞና ጌስታኔ፤","poem":1},{"text":"ዖርጎቺ ዓሲ ጋዓንቴ ሄርሺንቲና ማሂ ኬኤዛኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዎሊኮ ላጌቱዋዖ ላጌ ማሊ ጴዻ ዓሲ ዓኣኔ፤","poem":1},{"text":"ጎኔ ላጌ ጋዓንቴ ጌርሲዳፓ ባሼኬ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}