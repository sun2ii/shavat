{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":10,"content":[{"type":"heading","content":["ፒዜ ዎጌ ዎጊንታንዳጉዲ ሺኢቂንቴ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ዓይጎሮ ኔኤኒ ሃያይዲ ሃኪ ዔቄይ?","poem":2},{"lineBreak":true},{"text":"ሜታሢ ዎዶና ዓይጋ ኔ ዓኣሺንታይ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ፑርቶ ማዻ ዓሳ ዖቶርቃኔ፥ ማንቆ ዓሶዋ ዔያታ ዳውሳኔ፤","poem":1},{"text":"ሜሌ ዓሶም ዔያታ ፒራ ፒራሢዳ ፔኤሮ ዓዺንቶንጎ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ፑርቶ ዓሳ ፔኤኮ ፑርቶ ዓፁሞና ሄርሺንታኔ፤","poem":1},{"text":"ዔኤቢ ጊዴኔ ጎዑዋ ጎጋይቂ ሺራ ዓሶ ዔያታ ዓንጃኔ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ዔያታ ጫጫሽካኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ፑርቶ ማዻ ዓሳ ፆኦሲ ዔኤቢኬ ጎዑዋሴ፤","poem":1},{"text":"ዔያታ ፔ ዖቶርሙሞና ፆኦሲ ባኣሴ ጌይ ማላኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ፑርቶ ዓሶም ዔኤቢ ቢያ ዎዴ ጊኢጋኔ፤","poem":1},{"text":"ፆኦሲ ዎጎ ዔያታ ዔራኒ ዳንዳዑዋሴ፤","poem":2},{"lineBreak":true},{"text":"ዬያሮ ዒዚ ፔ ሞርኮ ሚሚኢጫኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዔያታ ፔ ማሊፆና፦ «ኑና ዓጊሣንዳይ ባኣሴ፤","poem":1},{"text":"ዓይጎ ሜታኣ ባኣያ ቢያ ዎዴ ኑ ዎዛዻንዳኔ» ጋዓኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዔያታ ጌስታ ጌኤዞይዳ","poem":1},{"text":"ጋዳማንታ ሉኡዙሞንታ ዚርቂሢያ ኩሜያኬ፤","poem":2},{"lineBreak":true},{"text":"ጌኔ ባኣዚንታ ፑርቱሞዋ ዔያቶ ዻንጋኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ጉርዶኮ ጎይፆ ዓጫ ካቲ ዔያታ ዴዓኔ፤","poem":1},{"text":"ፂሎ ዓሶዋ ዉቱንቃ ካርካ ዔያታ ዎዻኔ፤","poem":2},{"lineBreak":true},{"text":"ዓኣፓ ዔያቶኮ ማንቆ ዓሶ ፑርቱሞና ዛጋኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ካይዚዳ ናንጋ ዞቢጉዲ ዓኣሺንቲ ዔያታ ዴዓኔ፤","poem":1},{"text":"ማንቆ ዓሶ ዓርቃኒ ዒኢካ ካታኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶኮ ፒራሢና ዓይሢ ጎቺ ዔያታ ዔካኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ማንቆ ዓሶ ጳርቂ ዔያታ ኬኤራኔ፤","poem":1},{"text":"ማኣዳይ ባኣ ላቤ ዓሳ","poem":2},{"lineBreak":true},{"text":"ዔያቶ ኩጮ ጋሮ ጌሊ ሎኦሚ ዓታኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ፑርታ ማዻ ዓሲ ፔ ዒኖና፦","poem":1},{"text":"«ፆኦሲ ታና ዋሌኔ፤","poem":2},{"lineBreak":true},{"text":"ዓኣፖ ካሮ ፔኤኮ ካንቂ ታና ዴንቁዋሴ!» ጋዓኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ ዔቄ!","poem":1},{"text":"ፆኦዛሢዮ ኔኤኮ ዎልቆ ኩጮ ዔቂሴ!","poem":2},{"lineBreak":true},{"text":"ሄርቂንቲ ዎርቃ ዓሶ ዋሊፖ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ፑርቶ ማዻ ዓሳ","poem":1},{"text":"ፆኦሲ ዑፃ ዓይጋ ፑርታ ጌስታይ?","poem":2},{"lineBreak":true},{"text":"ፔ ዒኖና፦","poem":2},{"lineBreak":true},{"text":"«ታ ማዻ ባኮሮ ዒ ታጊዳ ሜቶ ዓጋዓኬ» ዓይጋ ጋዓይ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ፆኦሲዮ! ኔኤኒ ጋዓንቴ ሜቶና ዋኣዮና ዛጊ","poem":1},{"text":"ዬያ ሼሌዒሶንዶ ጎይሢ ጊኢጊሻኔ፤","poem":2},{"lineBreak":true},{"text":"ሜታዼ ዓሳ ፔና ኔኤም ሃሻኔ፤","poem":2},{"lineBreak":true},{"text":"ዜኤሮ ናኣቶዋ ኔኤኒ ማኣዳኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ጎሞ ዓሶንታ ፑርቶ ዓሶንታኮ ዎልቆ ላቢሴ፤","poem":1},{"text":"ሃካፓ ሴካ ፑርታ ባኣዚ ዔያታ ማዹዋጉዲ","poem":2},{"lineBreak":true},{"text":"ዔያታ ማዻ ፑርቶ ማዾሮ ሜቶ ዔያቶይዳ ዓጌ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ናንጊና ናንጋ ጎዳ ካኣቲ ማዒ ናኣናና ናንጋኔ፤","poem":1},{"text":"ሜሌ ፆኦዞም ዚጋ ሜሌ ዴራ ጋዓንቴ","poem":2},{"lineBreak":true},{"text":"ሳዖይዳፓ ጋፒ ባይቃንዳኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ኔኤኒ ማንቆ ዓሶኮ ሺኢጲፆ ዋይዛኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ሺኢቃ ሺኢጲፆ ዋይዚ ኔ ዔያቶ ዶዲሻኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሳዖይዳ ዓሲ ማዒ ማዢንቴ ዓሲ","poem":1},{"text":"ሜሌ ዓሶ ዲቃሡዋጉዲ","poem":2},{"lineBreak":true},{"text":"ዜኤሮ ናኣቶንታ ሄርቂንቲ ዎርቃ ዓሶንታ ዛሎ","poem":2},{"text":"ኔኤኒ ሞኦታኔ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}