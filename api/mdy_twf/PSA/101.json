{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":101,"content":[{"type":"heading","content":["ዳውቴ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ካኣታ ፆኦሲም ጫኣቃ ጫኣቁሞ"]},{"type":"verse","number":1,"content":[{"text":"ኔኤኮ ሚጪንቲፆና ፒዜ ዎጊፆና ዛሎ ታ ዓይናዻኔ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳሢዮ! ጋላታ ዓይኑሞ ታ ኔኤም ሺኢሻኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዻቢንቲባኣ ጎይፄሎ ዶዲሺ ታ ዓርቃንዳኔ፤","poem":1},{"text":"ኔኤኒ ታ ኮራ ዓይዲ ዬዓንዳይ?","poem":2},{"lineBreak":true},{"text":"ታ ማኣሮ ዓሶና ዎላ ፒዜ ዒኔና ታ ናንጋንዳኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ፑርታ ባኣዚ ማዺንቴም ታ ዛጊ ዚቲ ጋዓዓኬ፤","poem":1},{"text":"ፆኦሲዳፓ ሃኬ ዓሳ ማዻ ባኮ ቢያ ታ ዒፃኔ፤","poem":2},{"lineBreak":true},{"text":"ፔቴታዖ ታ ዔያቶና ዎላ ካኣማዓኬ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዎቦ ዒና ዓኣ ዓሳ ታ ኮራፓ ሺኢኮንጎ፤","poem":1},{"text":"ፑርቱሞና ዎላ ታኣኮ ፔቱሞ ባኣሴ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ፔ ላጋሢ ካሽካሺ ዾንካሢ ታ ጎራኔ፤","poem":1},{"text":"ዖቶርቃ ዓኣፒና ሄርሺንታ ዒኔያ ዓኣ ዓሢ ታ ቲኢሩዋሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ታኣና ዎላ ናንጋንዳጉዲ","poem":1},{"text":"ታኣኮ ዓኣፓ ሳዖይዳ ጉሙርቂንታዞንሢዳኬ፤","poem":2},{"lineBreak":true},{"text":"ጌኤሺ ጎይሢና ሃንታሢ ዒዚ ታኣም ማዻንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ጌሻያ ማዔ ዓይጎ ዓሲያ ታ ማኣሮይዳ ናንጋዓኬ፤","poem":1},{"text":"ሉኡዙሞ ጌስታሢያ ታ ቤርታ ፒዝ ጌዒ ዔቃዓኬ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሳዖይዳ ፑርቶ ማዻ ዓሶ ቢያ","poem":1},{"text":"ጉቴ ጉቴ ታ ባይዛንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ፑርቶ ማዻ ዓሶ ቢያ","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ካታማፓ ታ ጋፒሳንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}