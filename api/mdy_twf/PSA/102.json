erse","number":7,"content":[{"text":"ጊንዓ ባኣያ ታ ዎርቃኔ፤","poem":1},{"text":"ማኣሮኮ ሄላሢዳ ፔኤሮ ዓኣ","poem":2},{"lineBreak":true},{"text":"ሚኢሻካፒ ታ ማዔኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሞርካ ታኣኮ ሮኦሮ ጉቤ ታና ሚኢጫኔ፤","poem":1},{"text":"ታና ፑርቲሳ ዓሳ ሱንፆ ታኣኮ ጋዳንቂንቴያ ማሂ ዛጋኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ዲቢንሢ ታኣኒ ዺኢሊጉዲ ኩኡሌኔ፤","poem":1},{"text":"ዑዦ ታኣኮ ታኣኒ ዓቢፆና ሲኢሬኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኔኤኮ ጎሪንቶና ዻጎናፓ ዔቄያና","poem":1},{"text":"ሌካ ታና ኔ ኬሴ ቤዛፓ ሊካ ኬኤሬኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ናንጎ ሌዓ ታኣኮ ዓቢ ጌሊ ዔኤዤጉዲኬ፤","poem":1},{"text":"ታኣኒያ ማኣቲጉዲ ሹሌኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ኔኤኒ ጋዓንቴ ናንጊና ኔኤኮ ካኣቱሞ ዖይታ ዴዔኔ፤","poem":2},{"lineBreak":true},{"text":"ሱንፃ ኔኤኮ ሾይቲፓ ሾይንቲ ሄላንዳኣና ናንጋኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኔ ዔቃንዳኔ፥ ፂዮኔያ ሚጪንታ ዓኣፒና ዛጋንዳኔ፤","poem":1},{"text":"ዒዞም ኔኤኒ ኮሹሞ ኔኤሲ ዻዋ ዎዶ ማዔሢሮ","poem":2},{"lineBreak":true},{"text":"ኔ ጌዔ ዎዳ ሄሌኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኔኤኮ ዓይላ ሹጮ ዒዞኮ ዛጊ ዎዛዻንዳኔ፤","poem":1},{"text":"ሳዖ ዓጮማኣ ሚጪንታንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ዴራ ናንጊና ናንጋ ጎዳሢ ሱንፆ","poem":1},{"text":"ሳዖ ካኣታኣ ቢያ ቦንቾ ኔኤሲ ዒጊጫንዳኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ናንጊና ናንጋ ጎዳ ፂዮኔ ጊንሣ ማሂ ማዣንዳኔ፤","poem":1},{"text":"ፔኤኮ ቦንቾና ፔጋዺ ጴዻንዳኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዒዚ ማንቆ ዓሶ ሺኢጲፆ ባንሢ ዛጋንዳኔ፤","poem":1},{"text":"ዔያታ ሺኢቃ ሺኢጲፆ ዒ ቦሃዓኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ሃጊ ሾይንቲባኣ ዓሳ ዒዛ ጋላታንዳንጉዲ","poem":1},{"text":"ሃያ ናንጊና ናንጋ ጎዳ ማዼ ዲቃሢ ሄርሺሳ ባኮ","poem":2},{"lineBreak":true},{"text":"ሙካ ሾይንቶም ፃኣፑዋቴ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዼጌ ቤዛ ዓኣ","poem":1},{"text":"ናንጎ ማኣራፓ ሊካ ዛጌኔ፤","poem":2},{"lineBreak":true},{"text":"ጫሪንጮይዳ ዓኣዖ ሳዖ ዛጌኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዬያ ዒ ማዼሢ","poem":1},{"text":"ቱኡቴ ዓሶኮ ዒላቶ ዋይዛኒ","poem":2},{"lineBreak":true},{"text":"ሃይቆም ዎጊንቴ ዓሶዋ ዓውሳኒኬ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዬያሮ ናንጊና ናንጋ ጎዳኮ ሱንፃ ፂዮኔይዳ","poem":1},{"text":"ጋላታኣ ዬሩሳላሜይዳ ኬኤዚንታንዳኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዬይያ ዴሮንታ ካኣቶንታ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ካኣሽካኒ","poem":2},{"lineBreak":true},{"text":"ፔቱሞና ቡኪንታኣና ማዓንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ዶዱሞ ታኣኮ ጎይፃ ዓይሴኔ፤","poem":1},{"text":"ናንጎ ታኣኮ ዒ ዑኬና ጋፒሴኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዬካፓ ታኣኒያ፦ «ፆኦሲዮ ኔኤኒ ናንጋሢ","poem":1},{"text":"ሾይንቲፓ ሾይንቲ ሄላንዳኣናታሢሮ","poem":2},{"lineBreak":true},{"text":"ናንጎ ታኣሲ ታኣኒ ጋፒሲባኣንቴ","poem":2},{"lineBreak":true},{"text":"ታ ናንጋ ሃጊ ዓኣ ጎይሣ ዓኣንቴ","poem":2},{"lineBreak":true},{"text":"ታና ዔኪፖ» ጌዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ኔኤኒ ሚና ቤርታ ሳዖ ማዤኔ፤","poem":1},{"text":"ጫሪንጫኣ ኔ ማዤሢኬ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዔያታ ባይቃንዳኔ፤","poem":1},{"text":"ኔኤኒ ጋዓንቴ ዶዲ ናንጋንዳኔ።","poem":2},{"lineBreak":true},{"text":"ዬይ ቢያሢ ማኣዖጉዲ ጪንቃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዓፒላጉዲያኣ ኔ ዔያቶ ላኣማንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ቤዞና ኬኤሪንታንዳኔ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ኔኤኒ ጋዓንቴ ኔናኬ፤","poem":1},{"text":"ሌዓኣ ኔኤኮ ፔቴታዖ ጋፑዋሴ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ኔ ዓይሎኮ ናኣታ ዔያቶም ጊኢጌም ናንጋንዳኔ፤","poem":1},{"text":"ዜርፃ ዔያቶኮ ኔ ቤርታ ዶዲ ዴዓንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}