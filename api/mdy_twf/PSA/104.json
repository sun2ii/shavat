[{"text":"ዔያቶ ኔ ጎሬ ዎዶና ጋዓንቴ ቤዞና ሺኢኬኔ፤","poem":1},{"text":"ኔኤኮ ጉጉንፆ ዑኡዞ ዔያታ ዋይዛዖ","poem":2},{"lineBreak":true},{"text":"ጳሽኪ ፑኔኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዹኮኮ ዑፃ ዔያታ ላኣሊንቴኔ፤","poem":1},{"text":"ኔኤኒ ዔያቶም ጊኢጊሼ፥ ዶኦጫዼ ጊንፆ ዎቴኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጊንሣ ዔያታ ሳዖ ዔኤዺ ባይዙዋጉዲ","poem":1},{"text":"ዑሣ ኬስኪያ ላኣሊንቱዋጉዲ","poem":2},{"lineBreak":true},{"text":"ጌዲ ኔ ጌሤኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ዓልቃ ዋኣፃ ዶኦጫዼ ጊንፆ ዎታንዳጉዲ ኔ ማሄኔ፤","poem":1},{"text":"ዹኮኮዋ ባኣኮና ዔያታ ዎታኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ካዮ ቦዓ ዒኢካፓ ዑሽካኔ፤","poem":1},{"text":"ኪርሞላ ዒኢካፓ ዼኤቦ ፔኤሲ ዛኣራኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ካፓ ማኣሮ ፔኤኮ ዎሮ ዓጫ ማዣኔ፤","poem":1},{"text":"ሚፆ ካኣፖ ባኣካኣ ዱላኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ኔኤኒ ሎ ኔ ማኣራፓ ዹኮ ዑሻኔ፤","poem":1},{"text":"ሳዓኣ ኔ ማዾ ዓኣፖ ሙይ ሚሽካኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ቆልሞም ሳዓፓ ማኣቲ ኔ ባቃልሳኔ፤","poem":1},{"text":"ዓሲም ሙኡዚ ማኣዳንዳ ዱማ ዱማ ባኣዚ ኔ ኬሳኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዓሲ ዎዛሳ ዎይኔ","poem":1},{"text":"ዓኣፖ ካሮዋ ዓኣዒሳ ዛይቴ","poem":2},{"lineBreak":true},{"text":"ዎልቄ ዒንጊ ዶዲሻ ሃኣኮዋ ዒኢፓ ጴዻኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ዬያጉዲ ሃሣ ናንጊና ናንጋ ጎዳኮ ሚፃ","poem":1},{"text":"ዒዚ ቱኬ ሊባኖኦሴ ሚፃ ዋኣፆ ዑሽኪ ሚሽካኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ካፓ ፔኤኮ ማኣሮ ዒኢካ ማዣኔ፤","poem":1},{"text":"ቦኦካሢ ዚቢቆ ባኣካ ዎርቆ ቤሲ ዴንቃኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዖዶዞ ዹካ ዎሻ ናንጋ ቤሲ","poem":1},{"text":"ላሎ ቆኦፓኣ ሾኦና ጌላ ቤሲኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ዓጊና ዎዶ ዱማሳንዳጉዲ ኔ ማዼኔ፤","poem":1},{"text":"ዓባኣ ፔ ጌላ ዎዶ ዔዔራኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ሳዓ ኔ ዓሚሻዛ ዹሚ ማዓኔ፤","poem":1},{"text":"ዒማና ካዮ ቦዓ ቢያ ኬስኪ ዲርጊ ሺራኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ሃጊ ዔቃ ዞባ ሙዖ ኮይ ጉዻኔ፤","poem":1},{"text":"ሙዖንዶ ባኮዋ ፆኦሲዳፓ ኮዓኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዓባ ፆርቃኣና ዓኣሺንቲ ካዮ ጌላኔ፤","poem":1},{"text":"ፔኤኮ ቡኡላ ቡኡላ ጌሊ ላሃኔ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዬካፓ ዓሳ ማዾይዳ ሶኦፓኔ፤","poem":1},{"text":"ሳዓ ዓማንዳያ ሄላንዳኣና ፔኤቃኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ማዻ ኔኤኮ ዎዚ ሚርጋይ!","poem":2},{"lineBreak":true},{"text":"ዬያ ቢያ ኔኤኒ ኔ ቢታንቶና ኮሼኔ፤","poem":2},{"lineBreak":true},{"text":"ሳዓ ኔኤኒ ማዤ ማዢንቶና ኩሜኔ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ሃይ ዼኤፖ ባዛ ዳልጊና ሚጪንቴያኬ፤","poem":1},{"text":"ዼኤፒንታ ዻካ ቦዖንታ ፓይዲባኣ ዓጊፃ ባኣዚ ዒኢካ ዓኣኔ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዋኣፆ ካኣሚላ ዒኢካ ዑፃ ሃንታኔ፤","poem":1},{"text":"ኔኤኒ ማዤ ሌዋታኔያ","poem":2},{"noteId":3},{"text":"ዒኢካ ዴማ ዓማላኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ዔያታ ሙዓንዳ ባኮ ዎዶና ኔ ዔያቶም ዒንጋኔ፤","poem":1},{"text":"ዬይ ቢያ ዎዛና ኔና ካፓኔ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ኔኤኒ ዔያቶም ዒንጋ ዎዶና ዬያ ዔያታ ቡኩሳኔ፤","poem":1},{"text":"ኔኤኮ ኩጮ ኔ ቡላ ዎዶና","poem":2},{"lineBreak":true},{"text":"ኮሺ ባኣዚ ሙዒ ዔያታ ሚሽካኔ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ዔያቶይዳፓ ዓኣፖ ካሮ ኔኤኮ ኔ ሺርሻዛ","poem":1},{"text":"ዲቃቲሢ ሌሊ ዔያታ ሚርጋኔ፤","poem":2},{"lineBreak":true},{"text":"ሼምፓሢ ኔ ዔያቶኮ ዔካዛ ሃሃይቃኔ፤","poem":2},{"lineBreak":true},{"text":"ኬስኬ ዓጮ ባንሢያ ማዓኔ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ኔኤኮ ዓያኖ ኔ ዳካዛ ዔያታ ማማዢንታኔ፤","poem":1},{"text":"ሳዖዋ ኔኤኒ ዓኪ ማሃኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"ናንጊና ናንጋ ጎዳኮ ቦንቻ ናንጊና ዶዲ ናንጎም፤","poem":1},{"text":"ዒዚ ፔኤኮ ማዼ ማዾና ዎዛዾንጎ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ሳዖ ዒዚ ዛጋዛ ዓዓጊፃኔ፤","poem":1},{"text":"ዹኮዋ ካኣማዛ ጩጩባኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"ታኣኒ ሼምፔና ዓኣና ናንጊና ናንጋ ጎዳም ዓይናዻንዳኔ፤","poem":1},{"text":"ዔቂ ታ ሃንታ ዎዳ ዒዛ ታ ዓኣሣንዳኔ።",