poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዒ ጫኣቄ ጫኣቁሞ ዒዛሲ ናንጊና","poem":1},{"text":"ዒ ዓይሤ ቃኣሎዋ ሺያ ሾይንቲ ሄላንዳኣና","poem":2},{"lineBreak":true},{"text":"ማሌ ጎይሣኬ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዓብራሃሜና ዒዚ ጫኣቄ ጫኣቁሞ","poem":1},{"text":"ዪሳኣቄም ሳላዺ ዒ ዒንጌ ዎዞ ዋሉዋሴ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ያይቆኦቤም ዒ ዬያ ዳምቤ ማሂ","poem":1},{"text":"ዒስራዔኤሌማኣ ናንጊና ጫኣቄያ ማሂ ዶዲሼኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዒማና ዒዚ፦ «ኔ ዴኔ ማሂ","poem":1},{"text":"ካኣናኔ ታ ኔኤም ዒንጋንዳኔ» ጌዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ዬይ ያዼ ማዔሢ ዔያቶኮ ፓይዳ ሚርጊባኣንቴ","poem":1},{"text":"ዬኖ ዓጬሎም ዔያታ ሾኦቺ ማዒ ዓኣንቴኬ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዬያ ዴሮ ኮራፓ ሜሌ ዴሬ ባንሢ","poem":1},{"text":"ፔቴ ዓጮፓ ሜሌ ዓጪ ባንሢ","poem":2},{"lineBreak":true},{"text":"ቤቲ ቤቲ ዔያታ ሜታዼኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዖኦኒያ ጌኔ ማዾ ዔያቶ ዑፃ ማዻንዳጉዲ ዒ ሃሺባኣሴ፤","poem":1},{"text":"ዔያቶ ዛሎሮ፦","poem":2}]},{"type":"verse","number":15,"content":[{"text":"«ታ ዶኦሜዞንሢ ሄሊፖቴ፤","poem":1},{"text":"ታ ማሊፆ ኬኤዛዚንሢ ዑፃ ፑርታ ማዺፖቴ» ጌዒ ካኣቶ ጎሬኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ዓጮይዳ ዒ ናይዚ ዔኤሌኔ፤","poem":1},{"text":"ሃኣኮ ጎዖ ባኣዚያ ቢያ ባይዜኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዓይሌ ማዒ ሻንቺንቴ ዓሢ","poem":1},{"text":"ዮሴፔ ዔያቶኮ ቤርታሲ ዳኬኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዒማና ቶካ ዒዛኮ ዓንጊ ዱፄና","poem":1},{"text":"ዒዛኮ ዑፃኣ ዓንጊና ቱኡቴኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዒዛም ሎንሢንቴ ቃኣላ ኩማንዳያ ሄላንዳኣና","poem":1},{"text":"ናንጊና ናንጋ ጎዳኮ ቃኣላ ዮሴፔ ዎይታቴያ ጌዒ ዛጌኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዬካፓ ካኣቲ ዓሲ ዳኪ ዒዛ ቡሊሴኔ፤","poem":1},{"text":"ዓሶ ዎይሣሢያ ዒዛ ኬሴኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ማኣሮኮ ዓዳሢ","poem":1},{"text":"ፔኤኮ ዓኣ ባኮ ቢያ ዎይሣያ ዒዛ ማሄኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዬይያ ሱኡጎ ዒ ፔ ዔራ ጎይፆ ማዺሻንዳጉዲ","poem":1},{"text":"ዼኤ