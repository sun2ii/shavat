pe":"line_break"},{"type":"verse","number":6,"content":[{"text":"ኑኡኒ ኑ ዓዶንሢጉዲ ጎሜ ማዼኔ፤","poem":1},{"text":"ኑ ዻቢንቴኔ፥ ፑርታ ማዼኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኑኡኮ ዓዶንሢ ጊብፄ ዓጫ ዓኣዖ","poem":1},{"text":"ኔ ዎልቆና ማዺንታ ዓኮ ባኮ ማሊ ጶቂሢባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ሚጪንቲፆ ሚርጉሞዋ ዔያታ ማሊባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ዞቄ ባዞ ዓጫ ዋይዚ ኔኤም ዒፄኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዒዚ ጋዓንቴ ፔ ዎልቆኮ ዼኤፑሞ ቤኤዛኒ","poem":1},{"text":"ፔ ሱንፆሮ ዔያቶ ዒ ዓውሴኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዞቄ ባዞ ዒ ጎሬኔ፤","poem":1},{"text":"ባዛኣ ሚጬኔ፤","poem":2},{"text":"ዓሲ ናንጉዋ ዳውሌ ቦኦሊና ዓኣዾሢጉዲ","poem":1},{"text":"ዋኣፆ ዔቶኮ ባኣኪና ዔኪ ዔያቶ ዒ ዓኣዼኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዔያቶ ዒፃ ዓሶ ኩጫፓ ዒ ዓውሴኔ፤","poem":1},{"text":"ሞርኮ ኩጫፓኣ ዒ ሄሊ ዓይሴኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሞርኮ ዔያቶኮ ዋኣፃ ሙዔኔ፤","poem":1},{"text":"ዬያ ሞርኮይዳፓ ፔቴታዖ ቶሊ ዓቲባኣሴ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዬካፓ ዔያታ ዔያቶም ኬኤዞና ቃኣሎ ጉሙርቄኔ፤","poem":1},{"text":"ዓይኑሞናኣ ዒዛ ጋላቴኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ጋዓንቴ ዔያታ ዒ ማዼ ባኮ ቤዞና ዋሌኔ፤","poem":1},{"text":"ዒዛኮ ዞሮና ዓኣዻኒ ጊቢ ዳንዳዒባኣሴ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዓሳ ናንጉዋ ዳውሎይዳ ሱኡካዺሢ ዔያታ ዓርቄኔ፤","poem":1},{"text":"ዒኢካ ፆኦሲ ዎይታቴያ ጌዒ ዒዛ ዛጌኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዒዚ ዔያታ ዒዛ ዖኦጬሢ ዔያቶም ዒንጌኔ፤","poem":1},{"text":"ጋዓንቴ ዔያቶ ዖኦፒሳ ዶርዓ ዳኪንቴኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ጉርዶይዳ ዔያታ ዓኣዖ","poem":1},{"text":"ሙሴንታ ፆኦሲም ዱማዼ ዓኣሮኔንታ","poem":2},{"lineBreak":true},{"text":"ማዻ ማዾ ዛጊ «ዬይ ዔያቶም ሌሊ ዓይጋ ማዔይ» ጌዒ ማሌኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሳዓ ዳርዒ ዳኣታኔ ጎዖሢ ዔኤዼኔ፤","poem":1},{"text":"ዓቤሮኔንታ ዒዛኮ ማኣሮ ዓሶዋ ጉኡፔኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዔያቶኮ ቡኪንቶ ባኣካ ታሚ ዔኤቴኔ፤","poem":1},{"text":"ሎስታሢ ፑርቶ ዓሶ ሚቺ ባይዜኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ዔያታ ኮሬቤ ጌይንታ ቤዛ ዓኣዖ ዎርቄና ናኣሪ ኮሼኔ፤","poem":1},{"text":"ዬያ ዓንጎ ሼኤሺ ማዦና ፆኦዞም ዚጌኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዔያቶኮ ቦንቾ ማዔ ፆኦዛሢ ዔያታ","poem":1},{"text":"ማኣቶ ሄንቃ ቆልሞ ማላ ባኮና ላኣሜኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ጊብፄ ዓጮይዳ ዼኤፒ ባኣዚ ማዺ","poem":1},{"text":"ዔያቶ ዓውሴ ፆኦዛሢ ዔያታ ዋሌኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዒዚ ጋዓንቴ ካኣሜ ዓጮይዳ ዲቃሣ ማዾ","poem":1},{"text":"ዞቄ ባዞይዳኣ ዲቃሢ ሄርሺሳ ባኣዚ ማዼኔ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዬያሮ ዱማ ዱማ ዎዻ ባኮና","poem":1},{"text":"ዔያቶ ዒ ባይዙዋጉዲ ማዻኒ","poem":2},{"text":"ዒዚ ዶኦሬ ሙሴ ፆኦሲንታ ዔያቶንታ ባኣኮ ጌሊ","poem":1},{"text":"ዒዛኮ ቤርታ ዔቂባኣያታቴ","poem":2},{"lineBreak":true},{"text":"ዔያቶ ዒ ባይዛንዳሢ ኬኤዜያኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ዬካፓ ዔያታ ኮዦ ዓጬሎ ቶኦቼኔ፤","poem":1},{"text":"ዒዚ ዔያቶም ዒንጌ ዎዞ ቃኣሎዋ ጉሙርቂባኣሴ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዔያታ ዓፒሎና ማዢንቴ ፔ ማኣራ ማኣራ ጉንዱሜኔ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳሢ ዑኡዞዋ ዋይዚባኣሴ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዓሳ ናንጉዋ ዳውሎ ቦኦላ ዔያቶ ኬኤራኒ","poem":1},{"text":"ኩጮ ፔኤሲ ዔቂሲ ዒ ጫኣቄኔ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዜርፆ ዔያቶኮ ዒ ሜሌ ዴሮ ባኣካ ሃሻኒ","poem":1},{"text":"ዱማ ዱማ ዓጮ ዔያቶ ላኣላኒ ጫኣቄኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ዔያታ ፔና ቢዔልፔጎሬና ዎላ ፔቴ ማሄኔ፤","poem":1},{"text":"ሼምፓባኣ ፆኦዞም ሹኮና ዓሽኮዋ ሙዔኔ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ዔያታ ፔ ማዾና ናንጊና ናንጋ ጎዳ ዻጋሴኔ፤","poem":1},{"text":"ዱማ ዱማ ባይዛ ባካ ዔያቶ ሄሌኔ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ጋዓንቴ ፒንሃሴ ዔቂ","poem":1},{"text":"ዻቢንቶ ማዼ ዓሶ ዎዼ ዎዶና","poem":2},{"lineBreak":true},{"text":"ዱማ ዱማ ዎዻ ባካ ዎዺፆ ሃሼኔ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ዬይያ ሾይንቲፓ ሾይንቲ ሄላንዳኣና","poem":1},{"text":"ናንጊና ዒዛም ፂሉሞ ማዒ ፓይዲንቴኔ።","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ዬያጉዲ ሃሣ ሜሪባ ጌይንታ ዋኣፆ ዓጫ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ዔያታ ዻጋሴኔ፤","poem":2},{"lineBreak":true},{"text":"ሙሴያ ዬያ ዛሎና ሜቶይዳ ኬዴኔ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ሙሴ ዔያታ ዻጋሴሢሮ","poem":1},{"text":"ዒዚ ኮይሱዋ ዑኡሲ ፔ ዻንጋፓ ኬሴኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዔያቶ ዓይሤ","poem":1},{"text":"ሜሌ ዴሮ ባይዚፆ ዔያታ ሃሼኔ።","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ዔያታ ሜሌ ዴሮና ዎላ ሲኢሪንቴኔ፤","poem":1},{"text":"ዬይ ዓሳ ማዺ ሃንታ ባኮ ዔያታኣ ዔሬኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"ዬያቶኮ ካኣሽኮ ፆኦዞዋ ዔያታ ካኣሽኬኔ፤","poem":1},{"text":"ዬይ ዔያቶም ፒሮ ማዔኔ።","poem":2}]},{"type":"verse","number":37,"content":[{"text":"ዔያቶኮ ዓቲንቆንታ ዉዱሮ ናኣቶንታ","poem":1},{"text":"ፑርቶ ዓያኖም ዔያታ ሹኬኔ።","poem":2}]},{"type":"verse","number":38,"content":[{"text":"ዔያቶኮ ዓቲንቆንታ ዉዱሮ ናኣቶንታኮ ጌኤዦ ሱጉፆ","poem":1},{"text":"ሜሌ ካኣናኔ ፆኦዞም ላኣሊፆና","poem":2},{"lineBreak":true},{"text":"ሳዔሎ ሱጉሢ ሳዓ ማሂ ዔያታ ዒኢሴኔ።","poem":2}]},{"type":"verse","number":39,"content":[{"text":"ዔያታ ፔ ማዾና ዒኢቴኔ፤","poem":1},{"text":"ዞኦስካ ኮኦማ ላኣሊጉዲ ፔ ፆኦዛሢም ዔያታ ጉሙርቂንቲባኣሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"ዬያሮ ናንጊና ናንጋ ጎዳኮ ዻጋ","poem":1},{"text":"ዒዛ ዴሮ ዑፃ ዔኤቴኔ፤","poem":2},{"lineBreak":true},{"text":"ፔ ዓሶዋ ዒ ሻኣኪንቴኔ።","poem":2}]},{"type":"verse","number":41,"content":[{"text":"ዔያቶ ዒዚ ሜሌ ዴሮም ዓኣሢ ዒንጌኔ፤","poem":1},{"text":"ሞርካ ዔያቶኮ ዔያቶ ዎይሣያ ማዔኔ።","poem":2}]},{"type":"verse","number":42,"content":[{"text":"ሞርካ ሄርቂ ዔያቶ ዎሣያ ማዔኔ፤","poem":1},{"text":"ፔ ቢታንቶኮ ዴማ ማሄኔ።","poem":2}]},{"type":"verse","number":43,"content":[{"text":"ዒዚ ሚርጌ ዎዴና ዔያቶ ሄሊ ዓውሴኔ፤","poem":1},{"text":"ዔያታ ጋዓንቴ ዋይዚ ዒፂሢ «ኑ ሃሻዓኬ» ጌዔኔ፤","poem":2},{"lineBreak":true},{"text":"ፔ ጎሞና ዔያታ ዻውሲንቴኔ።","poem":2}]},{"type":"verse","number":44,"content":[{"text":"ጋዓንቴ ዒላቶ ዔያቶኮ ዒ ዋይዜ ዎዶና","poem":1},{"text":"ሜታሢ ዔያቶኮ ዛጌኔ።","poem":2}]},{"type":"verse","number":45,"content":[{"text":"ዔያቶሮ ጌይጋፓ ጫኣቄ ጫኣቁሞ ዒ ማሌኔ፤","poem":1},{"text":"ዒዛኮ ዓኣ ሚጪንቲፆ ሚርጉሞጉዴያ","poem":2},{"lineBreak":true},{"text":"ዻጋፓ ዒ ማዔኔ።","poem":2}]},{"type":"verse","number":46,"content":[{"text":"ዔያቶ ዲዒ ዔኬ ዓሳ ቢያ","poem":1},{"text":"ሚጪንታንዳጉዲ ዒ ማዼኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢዮ! ዓውሴ ኑና፤","poem":1},{"lineBreak":true},{"text":"ኔኤኮ ዱማዼ ሱንፆም ጋላታ ኑ ሺኢሻንዳጉዲ","poem":1},{"text":"ኔና ኑ ኬኤዚ ሄርሻንዳጉዲ","poem":2},{"text":"ዴሮ ባኣካፓ ቡኩሲ ኑና ኔ ዔኪ ዬዔኔ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ","poem":1},{"text":"ናንጊፓ ናንጊ ሄላንዳኣና ዓንጂንቶንጎ!","poem":2},{"lineBreak":true},{"text":"ዴራ ቢያ ዓኣሜን ጎዖንጎ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ጋላቱዋቴ!","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}