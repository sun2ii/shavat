{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":108,"content":[{"type":"heading","content":["ዳውቴኮ ጋላቶ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ፆኦሲዳፓ ማኣዶ ዴንቃኒ ሺኢቂንቴ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ፆኦሲዮ! ዒና ታኣኮ ኔና ጉሙርቂ ሂርጉዋሴ፤","poem":1},{"text":"ታኣኒ ዓይናዻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ጎኔ ዒናፓኣ ታ ዓይናዻንዳኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሚርጌ ሻዦ ዴንሢ ዋርቆ ጎኦሎንታ","poem":1},{"text":"ሜሌ ዓይኑሞ ዓንጋማኣ ዔቁዋቴ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒያ ሚኢሪ ዔቃንዳኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ዴሮ ባኣካ ታ ኔና ጋላታኔ፤","poem":1},{"text":"ዓሶ ባኣካኣ ታ ኔኤም ዓይናዻኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሚጪንቲፃ ኔኤኮ ጫሪንጫፓ ዑሣ ዼኤፒኬ፤","poem":1},{"text":"ጉሙርቂንቲፃኣ ሌካ ሻኣሮ ሄላኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ፆኦሲዮ! ኔኤኒ ጫሪንጫፓ ዑሣ ሌካ ዼግ ዼጊ ጌዔ፤","poem":1},{"text":"ቦንቻ ኔኤሲ ሳዖ ዑፃ ቢያ ማዖንጎ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኔ ናሽካ ዴራ ዻቃንዳጉዲ","poem":1},{"text":"ኔኤኮ ሚዛቆ ኩጮና ታና ዓውሴ፤","poem":2},{"lineBreak":true},{"text":"ታኣም ዋይዜ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ፆኦሲ ፔኤኮ ዱማዼ ማኣራፓ ሂዚ ጌዔኔ፦","poem":1},{"text":"«ታኣኒ ባሺ ሴኬሜ ዶኦጮ ፓቃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሱኩቴ ዶኦጮዋ ታ ዴሮም ታ ጊሽካንዳኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጌሌዓዴንታ ሚናሴንታ ታኣሮኬ፤","poem":1},{"text":"ዔፕሬኤሜ ታኣኮ ዖሎሮ ቶኦካ ዓጎ ዓንጎ ቆኦባሢኬ፤","poem":2},{"lineBreak":true},{"text":"ዪሁዳ ታኣኮ ካኣቱሞ ኮኦሎኬ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሞዓኣቤ ታኣኮ ዋኣፆ ማስቶ ጎንጎኬ፤","poem":1},{"text":"ዔዶኦሜይዳ ታ ዱርዞ ታኣኒ ኬሲ ጌሣንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ፒሊስፄኤሜ ዓሶ ባሺ ታኣኒ ሜርታንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ኬልቂ ዲርቆና ካታሜሎ ባንሢ ዖ ታና ዔኪ ዓኣዻንዳይ?","poem":1},{"text":"ዔዶኦሜያ ዖ ታና ሄሊሳንዳይ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ፆኦሲዮ! ኬኤሪ ታና ሃሼሢ ኔናቱዋዓዳ?","poem":1},{"text":"ኑኡኮ ዖላ ዓሶና ዎላ ኬዞ ኔ ዒፄኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሃሢያ ዓሲ ዓሲ ዓውሳኔ ጎዖሢ ጉሪኬ፤","poem":1},{"text":"ኑ ሞርኮ ኑ ባሻንዳጉዲ ኔ ኑና ማኣዴ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ፆኦሲ ኑና ማኣዳዛ ዶዲ ኑ ማዓንዳኔ፤","poem":1},{"text":"ኑ ሞርኮ ኑ ቶኮ ዴማ ሄርቂሳንዳሢ ዒዛኬ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}