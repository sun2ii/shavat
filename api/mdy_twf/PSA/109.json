"text":"ዒዚ ሺኢቃ ሺኢጲፃኣ ዒዛ ዎጋያ ማዖንጎ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ናንጎ ዎዳ ዒዛኮ ቃሚቆንጎ፤","poem":1},{"text":"ሱኡጋቶ ዒዛሲ ሜሌ ዔኮንጎ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ናኣታ ዒዛኮ ዓዴ ባኣያ ማዒ ዓቶንጎ፤","poem":1},{"text":"ማቻኣ ዜኤሪንዶ ማዖንጎ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ናኣታ ዒዛሲ ካራ ባይዚ ሜታዾንጎ፤","poem":1},{"text":"ሺኢቂ ሃንታያ ማዖንጎ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶኮ ሻሂንቴ ማኣራፓ ዳውሲንቲ ባይቆንጎ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዒዛ ባኮ ቢያ ጋሌ ዓኣ ዓሲ ዔኮንጎ፤","poem":1},{"text":"ዒዚ ላቢ ዴንቄ ባኮ ፃንጎ ዓሲ ቡሮንጎ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዖኦኒያ ዒዛም ሚጪንቶፓ፤","poem":1},{"text":"ዒዛኮ ዜኤሮ ናኣቶም ዓይጎ ዓሲያ ማሎፓ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዜርፃ ዒዛሲ ዱማዺ ባይቆንጎ፤","poem":1},{"text":"ሱንፃ ዔያቶሲ ሙካ ሾይንቶ ባኣካፓ ዲርካቺንቶንጎ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዒዛኮ ዓዶንሢ ዻቢንቶ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ዓርቃያ ማዖንጎ፤","poem":2},{"lineBreak":true},{"text":"ዒንዶ ጎማኣ ባይቆፓ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሳዓፓ ዜርሢ ዔያቶኮ ባይዛኒ","poem":1},{"text":"ጎማ ዔያቶሲ ናንጊና ናንጋ ጎዳ ቤርታ","poem":2},{"lineBreak":true},{"text":"ዔርቴያ ማዒ ዴዖንጎ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ዓይጎሮ ጌዔቴ ዒዚ ሜታዼ ዓሶንታ ማንቆ ዓሶንታ","poem":1},{"text":"ሃሣ ዒና ሜቄ ዓሶዋ","poem":2},{"lineBreak":true},{"text":"ሃይቃንዳያ ሄላንዳኣና ዳውሳንዳኣፓ ዓቴም ሚጪንቲባኣሴ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ጋዳማ ዒዚ ናሽኬሢሮ ዒዛ ባንሢ ሙኬኔ፤","poem":1},{"text":"ዓንጆ ናሽኪባኣሢሮ ዒዛፓ ሃኬኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ጋዳማ ዓዳ ማኣዖጉዲ ዒ ማይንቴኔ፤","poem":1},{"text":"ዬይ ዋኣሢጉዲ ዒዛኮ ዑፆ ጋሮ","poem":2},{"lineBreak":true},{"text":"ዛይቴጉዲያ ዒዛኮ ሜጌፆና ዓኣዼኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዑፆ ዒዛኮ ዒ ዓኣቻ ማኣዓሢጉዲ","poem":1},{"text":"ቢያ ዎዴ ዒ ቱኡታ ቃልሾጉዲ ዬይ ማዖንጎ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ታና ፑርታ ማሃ ዓሶም","poem":1},{"text":"ታ ሼምፓሢዳ ፑርታ ጌስታዞንሢም","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ጪጋንዳ ባካ ዬያ ማዖም።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ኔኤኒ ጋዓንቴ ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ኔ ሱንፆሮ ጌዒ ኮሹሞና ታና ዛጌ፤","poem":2},{"lineBreak":true},{"text":"ሚጪንቲፃ ኔኤኮ ዼኤፒታሢሮ ታና ዓውሴ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ታኣኒ ማንቆ፥ ሜታዼ ዓሲኬ፤","poem":1},{"text":"ጋሮ ዒና ታኣኮ ኪፃዼኔ፤","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዋኣንታኣ ዔኤዤጉዲ ታ ዛጋማፓ ሺሬኔ፤","poem":1},{"text":"ታኣኒ ዓቢሢጉዲ ሃርፒንቴኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ሙዖ ሃሺፆ ዳምቦና ዎልቃ ታኣኮ ላቤኔ፤","poem":1},{"text":"ዑፃኣ ታኣኮ ዖኦፒ ዲቢንሢ ማዔኔ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ታ ዔያቶኮ ሚኢቺ ማዔኔ፤","poem":1},{"text":"ታና ዔያታ ዛጋዖ ቦሂ ቶኦኪ ዓጊሣኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዔ ታ ፆኦዛሢዮ! ታና ማኣዴ፤","poem":1},{"text":"ኔ ሚጪንቲፆና ታና ዓውሴ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔ ኩጮኬ ሃያይዴሢ","poem":1},{"text":"ኔኤኒ ማዼያ ማዔሢ ዔያታ ዔሮንጎ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ዔያታ ጋጋዳንቃኔ፥ ኔ ጋዓንቴ ዓንጃኔ፤","poem":1},{"text":"ዔያታ ዔቃዖ ዻውሲንታኔ፤","poem":2},{"text":"ኔኤኮ ዓይላሢ ጋዓንቴ ዎዛዻኔ።","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"ታና ፑርታ ማሃ ዓሳ ዻውሲንቶንጎ፤","poem":1},{"text":"ቦርሲንቲና ዔያታ ቦኦሪ ዴዖንጎ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"ናንጊና ናንጋ ጎዳ ታ ዻንጎና ታኣኒ ጋላታኔ፤","poem":1},{"text":"ሚርጌ ዓሶ ባኣካ ታ ዒዛ ሄርሻኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"ዓይጎሮ ጌዔቴ ዎዻኒ ዎጋ ዓሶይዳፓ ዓውሳኒ","poem":1},{"text":"ዬያ ሜታዼ ዓሢኮ ሚዛቆ ዛላ ዒ ዔቃሢሮኬ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}