:[{"text":"ናንጊና ናንጋ ጎዳ","poem":1},{"text":"ፂሎ ዓሶንታ ጎሞ ዓሶዋ ዎይታቴያ ዛጋኔ፤","poem":2},{"lineBreak":true},{"text":"ፑርቱሞ ናሽካ ዓሶ ጋዓንቴ ዒዚ ዒዒፃኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ዒዚ ፑርቶ ማዻ ዓሶ ዑፃ","poem":1},{"text":"ታሚ ቄንሢና ሙርቁንሢና ኬይሳኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶም ዓጊንቴ ባካ ታሚጉዲ ሼሼኤላ ዢባሬኬ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ናንጊና ናንጋ ጎዳ ፂሎ ማዔሢሮ ፂሉሞ ማዾ ዒ ናሽካኔ፤","poem":1},{"text":"ፒዜ ማዾ ማዻ ዓሲ ቢያ ዒዛኮ ዓኣፖ ካሮ ዛጋንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}