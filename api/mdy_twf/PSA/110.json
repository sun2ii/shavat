":true},{"text":"ናንጊና ናንጋ ጎዳ ጫኣቄኔ፤","poem":2},{"lineBreak":true},{"text":"ዒዚ ፔኤኮ ማሌ ማሊፆ ሺርሹዋሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ናንጊና ናንጋ ጎዳ ኔኤኮ ሚዛቃኬ፤","poem":1},{"text":"ፔኤኮ ጎሪንቶ ዓቦና ካኣቶ ዒ ጋኣጫንዳኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዴሮ ባኣካ ዒዚ ዎጋንዳኔ፤","poem":1},{"text":"ዖሎ ቤዞዋ ሌሲ ሌሊ ማሃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሳዖይዳ ዓኣ ካኣታ ቢያ ጋፒ ባይቃንዳኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዒዚ ጎይፆ ዓጫ ዓኣ ዓልቃ ዋኣፆ ዑሽካንዳኔ፤","poem":1},{"text":"ዬያሮ ዒዚ ዼግ ዼጊ ጋዓንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}