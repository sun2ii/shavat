erse","number":7,"content":[{"text":"ማዻ ዒዛኮ ጎኔ፥ ሃሣ ፒዜኬ፤","poem":1},{"text":"ዳምባ ዒዛሲ ቢያ ጉሙርቂንታያኬ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዬይ ናኣናና ዶዲ ዴዓያኬ፤","poem":1},{"text":"ጎኑሞና ፒዙሞና ማዺንቴያኬ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፔ ዴሮም ዻቂንታ ዒዚ ዳኬኔ፤","poem":1},{"text":"ናንጊና ዶዲ ዴዓ ጫኣቁሞ ዒ ጫኣቄኔ፤","poem":2},{"lineBreak":true},{"text":"ሱንፃ ዒዛሲ ዱማዼያና ዒጊጪንታያኬ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዔራቶኮ ካራ ማዓ ባኣዚ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ዒጊጪሢኬ፤","poem":2},{"text":"ዓይሢፆ ዒዛሲ ማዺ ኩንሣዞንሢኮ","poem":1},{"text":"ማሊ ጶቂሣ ዒኔ ዓኣያ ማዓኔ፤","poem":2},{"text":"ናንጊና ናንጋ ጎዳ ጋላቲንቴ ጎይሣ ናንጋንዳኔ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}