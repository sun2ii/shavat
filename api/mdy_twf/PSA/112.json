type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ፑርታ ሃይሴ ዒዛ ዲቃሡዋሴ፤","poem":1},{"text":"ዒና ዒዛኮ ናንጊና ናንጋ ጎዳ ጉሙርቂ ዶዴያኬ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዒና ዒዛኮ ዶዲኬ፥ ፔቴታዖ ዒጊጩዋሴ፤","poem":1},{"text":"ጋፒንፆይዳ ሞርካ ዒዛኮ ሎኦማሢ ዒ ዛጋንዳኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ማንቆ ዓሶም ፔ ሼኔና ዒዚ ዒንጌኔ፤","poem":1},{"text":"ፂሉማ ዒዛሲ ናንጊና ናንጋንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒዚ ቦንቺንቲ ዎልቄና ዼግ ዼጊ ጋዓንዳኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ፑርቶ ዓሳ ዬያ ዛጋዖ ሮኦጋዻንዳኔ፤","poem":1},{"text":"ዓቺ ዻይ፥ ዖኦፒ ዖኦፒ ዓኣዻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያ ዓሶኮ ማሊፃ ጉሪ ማዓንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}