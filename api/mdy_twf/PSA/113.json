{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":113,"content":[{"type":"heading","content":["ናንጊና ናንጋ ጎዳኮ ኮሹሞ ዔርዛ ጋላታ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳም ጋላታ!","poem":1},{"text":"ዒንሢ ናንጊና ናንጋ ጎዳ ዓይላ ጋላቱዋቴ!","poem":2},{"lineBreak":true},{"text":"ሱንፆ ዒዛኮ ሄርሹዋቴ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሃናፓ ዓርቃዖ ናንጊና ናንጊ ሄላንዳኣና","poem":1},{"text":"ናንጊና ናንጋ ጎዳኮ ሱንፃ ጋላቲንቶንጎ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዓባ ፆርቃ ካራፓ ጌላ ካሮ ሄላንዳኣና","poem":1},{"text":"ናንጊና ናንጋ ጎዳኮ ሱንፃ ጋላቲንቴያ ማዖም!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዴራፓ ዑሣ ዼግ ጌዔያኬ፤","poem":1},{"text":"ዒዛኮ ቦንቻ ጫሪንጮኮ ዑሣኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢጉዲ ዖኦኒያ ባኣሴ፤","poem":1},{"text":"ዒዛኮ ካኣቱሞ ዖይታ ቢያፓ ባሼኬ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ጫሪንጮና ሳዖናይዳ ዓኣዞንሢ ዛጋኒ","poem":1},{"text":"ፔ ቶኦኮ ሂርኪዳይ ዖናዳይ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዒዚ ማንቆ ዓሶ ሳዖ ሲላላፓ ዔቂሳኔ፤","poem":1},{"text":"ሜታዼሢያ ዲቢንሢፓ ዼግ ዼጊዳኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ቦንቺንታ ዓሶና ዎላ ሄኮ ማሃኔ፤","poem":1},{"text":"ዴሮኮ ሱኡጎና ዎላ ዒዛ ዴይሣኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዞኦኮ ላኣሎዋ ማኣሪንዶ ማሂ ዴይሣኔ፤","poem":1},{"text":"ዎዛዻያ፥ ሃሣ ናይንዶዋ ማሃኔ።","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳም ጋላታ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}