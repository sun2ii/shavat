,{"lineBreak":true},{"text":"ፔ ጎርዦና ዑኡሲያ ዔያታ ኬሳኒ ዳንዳዑዋሴ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዬያጉዴ ባኮ ኮሻ ዓሳ","poem":1},{"text":"ዬያቶ ጉሙርቃ ዓሳኣ ቢያ","poem":2},{"lineBreak":true},{"text":"ዔያቶጉዴያ ማዖንጎ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ዒስራዔኤሌ ዓሲዮቴ! ናንጊና ናንጋ ጎዳ ጉሙርቁዋቴ፤","poem":1},{"text":"ዒንሢ ማኣዳሢና ጊቲማሢያ ዒንሢኮ ዒዛኬ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዓኣሮኔ ዓሲዮቴ! ናንጊና ናንጋ ጎዳ ጉሙርቁዋቴ፤","poem":1},{"text":"ዒንሢ ማኣዳሢና ጊቲማሢያ ዒንሢኮ ዒዛኬ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዒንሢ ናንጊና ናንጋ ጎዳ ዒጊጫ ዓሳ ዒዛ ጉሙርቁዋቴ፤","poem":1},{"text":"ዒንሢ ማኣዳሢና ጊቲማሢያ ዒንሢኮ ዒዛኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ናንጊና ናንጋ ጎዳ ኑም ማላኔ፤","poem":1},{"text":"ዓንጂያ ኑና ዓንጃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒዚ ዓኣሮኔንታ ዒስራዔኤሌንታ ማኣሮ ዓንጃንዳኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዒዛ ዒጊጫዞንሢ ቢያ","poem":1},{"text":"ዼኤፖንታ ዻኮንታ ዓንጃንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዒንሢንታ ዒንሢኮ ናኣቶንታ","poem":1},{"text":"ዓንጂ ዒዚ ዒንሢ ሚርጊሾንጎ!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ጫሪንጮንታ ሳዖንታ ማዤ፥ ናንጊና ናንጋ ጎዳ","poem":1},{"text":"ዒንሢ ዓንጆንጎ!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ጫሪንጮኮ ጫሪንጫ ናንጊና ናንጋ ጎዳሮኬ፤","poem":1},{"text":"ሳዖ ጋዓንቴ ዓሲም ዒዚ ዒንጌኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ናንጊና ናንጋ ጎዳ ጋላታዞንሢ","poem":1},{"text":"ሃይቄ ዓሶቱዋሴ፤","poem":2},{"lineBreak":true},{"text":"ዚቲዮ ጌዔ፥ ዱኡፖ ጌሌ ዓሶዋቱዋሴ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሃናፓ ዓርቃዖ ዒዛ ዓንጃንዳዞንሢ ኑናኬ።","poem":1},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳም ጋላታ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}