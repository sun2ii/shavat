{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":116,"content":[{"type":"heading","content":["ሃይቢፓ ዓቴ ዓሲ ፆኦሲም ጋላቴ ጋላታ"]},{"type":"verse","number":1,"content":[{"text":"ታኣኮ ዒላቶንታ ሺኢጲፆዋ ዋይዜሢሮ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ታ ናሽካኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዋዮ ፔኤሲ ዒ ታ ባንሢ ማሄሢሮ","poem":1},{"text":"ታ ናንጎ ዎዶ ቢያይዳ ታ ዒዛ ባንሢ ዒላታንዳኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሃይቢ ፒራ ታና ዓርቄኔ፤","poem":1},{"text":"ዱኡፖኮ ዒጊቺፃ ታና ሜታሴኔ፤","poem":2},{"lineBreak":true},{"text":"ዖዪሢንታ ሜቶንታ ታና ባሼኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታኣኒ ናንጊና ናንጋ ጎዳ ሱንፆ ዔኤላዖ፦","poem":1},{"text":"«ናንጊና ናንጋ ጎዳሢዮ! ታኣኮ ሼምፓሢ","poem":2},{"lineBreak":true},{"text":"ኔ ዓውሳንዳጉዲ ታ ሺኢቃኔ» ጌዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ናንጊና ናንጋ ጎዳ ኮሺ፥ ሃሣ ፂሎኬ፤","poem":1},{"text":"ኑ ፆኦዛሢ ሚጪንታያኬ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዒና ሼሌዔዞንሢ ካፓኔ፤","poem":1},{"text":"ታኣኒ ሚርጌና ሜታዺ ዓኣንቴ ዒ ታና ዓውሴኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ናንጊና ናንጋ ጎዳ ኮሺ ባኣዚ ኔኤም ማዼሢሮ","poem":1},{"text":"ታ ሼምፔሌ! ኔኤኮ ሃውሾሢ ባንሢ ማዔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ዒዚ ሼምፓሢ ታኣኮ ሃይቢፓ","poem":1},{"text":"ዓኣፖዋ ታኣኮ ዓቢሢዳፓ","poem":2},{"lineBreak":true},{"text":"ቶኮ ታኣኮ ዹቆይዳፓ ዓይሴኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዬያሮ ሼምፔና ዓኣ ዓሳ ናንጋ ቤዛ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ኮራ ታ ናንጋንዳኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"«ኮሺ ታ ሜታዼኔ» ጌዔ ዎዶናታዖ","poem":1},{"text":"ኔና ጉሙርቂፆ ታ ሃሺባኣሴ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ካራ ታኣም ባይቄ ዎዶና","poem":1},{"text":"«ዓሲ ቢያ ሉኡዚኬ» ታ ጌዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ዒዚ ታኣም ማዼ ኮዦ ባኮሮ ቢያ","poem":1},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳም ታ ዓይጎ ጪጋንዳይ?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ታና ዓውሴሢሮ ጋላታንዳኔ፤","poem":1},{"text":"ዎይኖ ዑዦ ዒንጊሢ ማሂ ታ ዒዛም ሺኢሻንዳኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ቡኬ ዴሮ ቢያሢ ቤርታ ኬስኪ","poem":1},{"text":"ታ ናኣቤ ናኣቦ ኩንሣንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ፆኦሲም ዱማዼ ዓሶኮ ሃይባ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ቤርታ ቦንቺንቴያኬ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ታኣኒ ኔኤኮ ዓይላሢኬ፤","poem":1},{"text":"ታ ኔ ዓይሌሎ ናኣዚ፥ ኔኤም ማዻሢኬ፤","poem":2},{"lineBreak":true},{"text":"ታኣኮ ቱኡዛፓ ኔ ታና ቡሌኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ታ ኔኤም ዒንጎ ባኣዚ ማሂ ጋላታ ሺኢሻኔ፤","poem":1},{"text":"ሱንፆዋ ኔኤኮ ታ ዔኤላኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ቡኬ ዴሮ ቢያሢ ቤርታ","poem":1},{"text":"ናንጊና ናንጋ ጎዳም ታ ናኣቤ ናኣቦ ኩንሣንዳኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዬሩሳላሜ! ታኣኒ ኔ ጋራ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ማኣሮኮ ዓሳ ቡካ ጶኦካ","poem":2},{"lineBreak":true},{"text":"ዬያ ማዻንዳኔ።","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳም ጋላታ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/116.json","thi