]},{"type":"verse","number":7,"content":[{"text":"ታና ማኣዳኒ ዒዚ ታኣና ዎላኬ፤","poem":1},{"text":"ታ ሞርካ ሎኦማሢ ታ ዛጋንዳኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዓሲዳ ጌኤቂንቲሢዳፓ ባሼ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ፑኖ ካይዚ ማሂሢ ቃራኬ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዎይሣ ዓሶ ጉሙርቂፆይዳፓ ባሼ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ፑኖ ካይዚ ማሂፃ ቃራኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ዴራ ቢያ ታና ማንጌኔ፤","poem":1},{"text":"ጋዓንቴ ታ ዔያቶ ናንጊና ናንጋ ጎዳ ሱንፆና ባይዜኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ማንጊፆ ዔያታ ቢያ ዛሎና ታና ማንጌኔ፤","poem":1},{"text":"ጋዓንቴ ታ ዔያቶ ናንጊና ናንጋ ጎዳ ሱንፆና ባሼኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዓዳ ማሢጉዲ ዔያታ ታ ዑፃ ቁንዴኔ፤","poem":1},{"text":"ጋዓንቴ ዓንጊሢ ታሚዳ ዔኤታሢጉዲ ዔያታ ጋፔኔ፤","poem":2},{"lineBreak":true},{"text":"ጎኔና ናንጊና ናንጋ ጎዳ ሱንፆና ታ ዔያቶ ባይዜኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሂዖም ሎኦማኒ ታ ጋኣዲንቴኔ፤","poem":1},{"text":"ጋዓንቴ ናንጊና ናንጋ ጎዳ ታና ማኣዴኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ናንጊና ናንጋ ጎዳ ታኣኮ ዶዱማሢና ዓይናዾሢናኬ፤","poem":1},{"text":"ዒዚ ታኣኮ ታና ዓውሳሢኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ፂሎ ዓሶኮ ማኣራ ዒላሺሢና ሶራይቲና ዋይዚንታኔ፤","poem":1},{"text":"ዑኡዛ ሂዚ ጋዓኔ፦","poem":2},{"lineBreak":true},{"text":"«ናንጊና ናንጋ ጎዳኮ ዎልቃ ዶዲ ማዾ ማዼኔ!»","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ናንጊና ናንጋ ጎዳኮ ሚዛቆ ኩጫ ዼግ ዼጊ ጌዔኔ፤","poem":1},{"text":"ዬይ ኩጫ ዶዲ ማዾ ማዼኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ቶሊ ዓቲ ሼምፔና ናንጋንዳኣፓ ዓቴም ታ ሃይቂንዱዋሴ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳኮ ማዾ ታ ሃጋኣ ኬኤዛንዳኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ጎሪፆ ናንጊና ናንጋ ጎዳ ታና ኮሺ ጎሬኔ፤","poem":1},{"text":"ጋዓንቴ ሃይቢም ዓኣሢ ታና ዒዚ ዒንጊባኣሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ፂሉሞኮ ካራ ታኣም ቡሉዋቴ","poem":1},{"noteId":4},{"text":"፤","poem":1},{"text":"ዬያና ጌሊ ታ ናንጊና ናንጋ ጎዳ ጋላታንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ዬና ካሬላ ዒዛ ካራኬ፤","poem":1},{"text":"ፂሎ ዓሳ ዒዞና ጌላኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ዋይዚ ኔ ታኣም ማሄኔ፤","poem":1},{"text":"ታና ኔ ዓውሳሢ ማዔሢሮዋ ታ ኔና ጋላታኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ማኣሮ ሹጮና ማዣ ዓሳ ቶኦቼ ሹጫሢ","poem":1},{"text":"ማኣሮኮ ሄላሢ ማዔኔ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዬያ ናንጊና ናንጋ ጎዳ ማዼኔ፤","poem":1},{"text":"ዬይ ኑ ዓኣፖም ዲቃሣያኬ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዤ ኬሌላ ሃኖኬ፤","poem":1},{"text":"ዬያሮ ኮሺ ኑ ዎዛዾም!","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ሃዳራ ኑና ዓውሴ!","poem":1},{"text":"ናንጊና ናንጋ ጎዳሢዮ! ሃዳራ ኑኡም ጊኢጊሼ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ፆኦሲ ሱንፆና ሙካሢ ዓንጂንቴያኬ!","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ማኣራፓ ኑ ዒንሢ ዓንጄኔ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ናንጊና ናንጋ ጎዳ ፆኦሲኬ፤","poem":1},{"text":"ፔኤኮ ፖዖ ዒ ኑ ዑፃ ፖዔኔ፤","poem":2},{"text":"ዒንሢ ቦንቾ ኬሎሮ ዔኪ ሙካ ባኮ","poem":1},{"text":"ዒንጊፆ ሺኢሾ ባኮኮ ጉራኖና ዓይሢ ቱኩዋቴ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ኔኤኒ ታኣኮ ፆኦሲኬ፥ ታ ኔና ጋላታኔ፤","poem":1},{"text":"ኔኤኒ ታኣኮ ፆኦሲኬ፥ ታ ኔና ዼግ ዼጊዳንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ዒዚ ኮሺ ማዔሢሮ ዒዛ ጋላቱዋቴ!","poem":1},{"text":"ሚጪንቲፃ ዒዛኮ ናንጊና ዶዲ ናንጋያኬ።","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"118፡19 ፂሉሞኮ ካራ ታኣም ቡሉዋቴ ጋዓዛ ዔብሬ ዓሶ ሙኡጮ ማፃኣፖይዳ ዒማዺ ጋዓያ ማዓዛ ማሊፆ ዛጎዛ ጌኤዦ ማኣሮኮ ካሮ ታኣም ቡሉዋቴ ጋዓያ ማላኔ።","reference":{"chapter":118,"verse":19}}]},"thisChapterLink":"/api/mdy_twf/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}