rse","number":8,"content":[{"text":"ዎጎ ኔኤሲ ታ ካፓንዳኔ፤","poem":1},{"text":"ኔኤኒ ታና ጋፒ ሃሺፖ።","poem":2}]},{"type":"heading","content":["ፆኦሲ ዎጎም ዓይሢንቲሢ"]},{"type":"verse","number":9,"content":[{"text":"ዼጌሢ ጎይፆ ፔኤሲ ዎማይዲ ጌኤሻንዳይ?","poem":1},{"text":"ኔኤኮ ቃኣላ ጋዓ ጎይፆ ናንጊሢናኬ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታኣኒ ጉቤ ዒናፓ ኔና ኮዔኔ፤","poem":1},{"text":"ኔ ዓይሢፃፓ ታ ዓጊፁዋጉዲ ታና ካፔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ኔኤም ዋይዞ ዒፂ ዻቢንቱዋጉዲ","poem":1},{"text":"ቃኣሎ ኔኤሲ ታ ዒና ታኣኒ ዓኣቼኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔኤኒ ዓንጂንቴያኬ፤","poem":1},{"text":"ዳምቦ ኔኤሲ ኔ ታና ዔርዜ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኔ ዻንጋፓ ኬስካ ዎጎ ቢያ","poem":1},{"text":"ታ ዻንጎና ታኣኒ ኬኤዛንዳኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዓሲ ፔ ቆሎና ዎዛዻሢጉዲ","poem":1},{"text":"ኔ ዓይሢፆጉዴያ ሃንቲፃ ታና ዎዎዛሳኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኔኤኮ ዳምቦ ታኣኒ ታ ዒኖና ማላኔ፤","poem":1},{"text":"ዒኖ ታኣሲ ታኣኒ ኔ ጎይፃ ማሄኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዳምባ ኔኤሲ ታና ዎዛሳኔ፤","poem":1},{"text":"ቃኣሎዋ ኔኤኮ ታ ዋሉዋሴ።","poem":2}]},{"type":"heading","content":["ፆኦሲ ዎጋፓ ጴዻ ዎዛ"]},{"type":"verse","number":17,"content":[{"text":"ናንጊና ናንጋኒ ቃኣሎ ኔኤኮ ታ ካፓንዳንጉዲ","poem":1},{"text":"ታና ኔኤኮ ዓይላሢም ኮሺ ማዼ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኔኤኮ ዎጋፓ ዲቃሢ ሄርሺሳ ባኣዚ ታ ዛጋንዳጉዲ","poem":1},{"text":"ዓኣፖ ታኣሲ ቡሌ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ታኣኮ ሳዖይዳ ቤሲባኣ ዓሲኬ፤","poem":1},{"text":"ኔኤኮ ዓይሢፆ ታ ጊዳፓ ዓኣቺፖ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ቢያ ዎዴ ዎጎ ኔኤኮ ጶቂሥሢና","poem":1},{"text":"ሼምፓሢ ታኣኮ ኮሺ ዶጬኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ኔኤኮ ዓይሢፆይዳፓ ዻቢንቴዞንሢ","poem":1},{"text":"ሄርሺንታዞንሢና ጋዳንቂንቴዞንሢና ኔ ጎራኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ኔኤኮ ዓይሢፆ ታ ካፔሢሮ","poem":1},{"text":"ዔያቶኮ ጫዦና ቶኦቺፆና ታኣፓ ሺኢሼ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዎይሣ ዓሳ ዴዒ ታና ባይዛኒ ዞርቴያታቴያ","poem"