ak":true},{"text":"«ኔና ናሽካ ዓሳ ቢያ ጊኢጎንጎ፤","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኔኤኮ ኬኤሎ ዲፃ ቢያ ኮሺ ማዒ ዴዖንጎ፤","poem":1},{"text":"ኔኤኮ ካኣቶ ማኣራ ሜታ ባኣያ ኮሺ ናንጎንጎ።»","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታኣኮ ዒጊኖንታ ታ ላጎንታሮ","poem":1},{"text":"«ዬሩሳላሜ! ኮሹሞ ኔኤም ማዖንጎ!» ታኣኒ ጋዓንዳኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዬሩሳላሜ!","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢ ማኣሮ ዛሎሮ","poem":2},{"lineBreak":true},{"text":"ኔኤም ኮሺ ሙካንዳጉዲ ታ ኮዓኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}