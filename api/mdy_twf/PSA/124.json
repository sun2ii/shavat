 ካፒጉዲ ኑኡም ፒሮና ፒራስካፓ ቶሌኔ፤","poem":1},{"text":"ዬይ ፒራሢ ሜቄም፥ ኑኡኒ ዓዺንቱዋዖ ዓቴኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዬያይዲ ኑና ማኣዴሢ","poem":1},{"text":"ጫሪንጮና ሳዖና ማዤ ናንጊና ናንጋ ጎዳ ሱንፆኬ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}