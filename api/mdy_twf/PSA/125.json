Break":true},{"text":"ኮሹሞ ዒስራዔኤሌም ማዖንጎ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}