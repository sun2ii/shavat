oem":2},{"lineBreak":true},{"text":"ኮሹሞ ዒስራዔኤሌም ማዖም!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}