{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":129,"content":[{"type":"heading","content":["ፂዮኔ ኬዞ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ዒስራዔኤሌኮ ሞርኮፓ ቶላኒ ሺኢቂንቴ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ናኣቶፓ ዓርቃዖ ፑርታ ባኣዚ ታና ሄሌኔ፤","poem":1},{"text":"ዒስራዔኤሌ ዓሳ ሂዚ ጎዖንጎ፦","poem":2}]},{"type":"verse","number":2,"content":[{"text":"«ታኣኒ ናኣቶ ዓኣንቴ ዓርቃዖ","poem":1},{"text":"ታኣኮ ሞርካ ታና ሚጪንቲቃይዶ ዳውሳኔ፤","poem":2},{"lineBreak":true},{"text":"ጋዓንቴ ታና ዔያታ ባሺባኣሴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታኣኮ ዙሎ ዔያታ ዢራፓና ጳርቂ","poem":1},{"text":"ጎሺ ጎሽኮማጉዲ ሹኬኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ናንጊና ናንጋ ጎዳ ቢያ ዎዴ ፒዜኬ፤","poem":1},{"text":"ዬያቶ ሚጪንቱዋ ፑርቶ ዓሶ ቱኡዛፓ ታና ዒ ቡሌኔ።»","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ፂዮኔ ዒፃ ዓሲ ቢያ","poem":1},{"text":"ቦርሲንቲ ጊንሢም ማዖም።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ማኣሪ ዑሢዳ ባቃሌ ማኣቲጉዲ","poem":1},{"text":"ሃጊ ዑጉዋዖ ሹሊ ባይቃያ ማዖም።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዬያጉዴ ማኣታ ዎዻ ዓሲኮ ኩጮ ኩሙዋያ","poem":1},{"text":"ጌኤቴ ማሂ ቱካኒ ጋዓሢማኣ ኮኦማ ኩሙዋያ ማዖም።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዔያቶኮ ኮይሊና ዴንዳ ዓሲ ቢያ ፂዮኔኮ ሞርኮ፦","poem":1},{"text":"«ናንጊና ናንጋ ጎዳ ዒንሢ ዓንጆንጎ!","poem":2},{"lineBreak":true},{"text":"ኑኡኒያ ናንጊና ናንጋ ጎዳ ሱንፆና ዒንሢ ዓንጃኔ!»","poem":2},{"lineBreak":true},{"text":"ዔያቶ ጋዓዓኬ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}