,{"type":"verse","number":5,"content":[{"text":"ታኣኒ ኔኤኮ ጋፑዋ ናሹሞ ጉሙርቃኔ፤","poem":1},{"text":"ዒና ታኣኮ ኔ ዓውሴሢሮ ዎዛዻኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ኔኤኒ ታኣም ኮሺ ባኣዚ ማዼሢሮ","poem":2},{"lineBreak":true},{"text":"ኔ ቦንቾም ታ ዓይናዻኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}