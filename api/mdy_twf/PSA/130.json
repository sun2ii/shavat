":"ዒስራዔኤሌ! ዒዛኮ ናሹማ ናንጊና ናንጋያ ማዔሢሮ","poem":1},{"text":"ዓሲ ዓውሳኒያ ዎልቄ ዓኣያ ማዔሢሮ","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳይዳ ሃጋ ዎዛ ጌሢ ጉሙርቄ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳ ፔኤኮ ዴሮ ዒስራዔኤሌ","poem":1},{"text":"ዔያቶኮ ጎሞ ቢያይዳፓ ዓውሳያኬ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}