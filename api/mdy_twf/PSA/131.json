{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":131,"content":[{"type":"heading","content":["ፂዮኔ ኬዞ ዓይኑሞ ዳውቴ ዓይናዼሢ"]},{"type":"hebrew_subtitle","content":["ፆኦሲ ጉሙርቂሢ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ታ ዒኖይዳ ዖቶርሙሞ ባኣሴ፤","poem":1},{"text":"ዓኣፓ ታኣኮ ዖቶርሙሞና ዛጌ ጎይሢ ባኣሴ፤","poem":2},{"text":"ዒና ታኣኮ ኮይሱዋ ዼኤፓቶ ኮዒባኣሴ፤","poem":1},{"text":"ታኣም ሃናኑዋ ባኣዚ ሄላኒ ታ ጪኢዺንቲባኣሴ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዻንሢፓ ጉኡጴ ናይ ዒንዶኮ ዳዳ ሊች ጌይ ዴዓሢጉዲ","poem":1},{"text":"ታኣኒ ዔኤቢያ ጎዑዋዖ ዚቲ ጌዔኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዒስራዔኤሌ! ሃሢፓ ዓርቃዖ ናንጊና ናንጊ ሄላንዳኣና","poem":1},{"text":"ናንጊና ናንጋ ጎዳሢ ጉሙርቂ ናንጌ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}