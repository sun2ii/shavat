{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":132,"content":[{"type":"heading","content":["ፂዮኔ ኬዞ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ጌኤዦ ማኣሮ ዛሎ ዓይናዺንቴ ዓይኑሞ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ታና ዳውቴያ ማሊ ጶቂሣዎ፤","poem":2},{"lineBreak":true},{"text":"ዒዚ ሜታዺ ዓኣሤ ሜቶዋ ቢያ ሃዳራ ዋሊፖ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔኤና ዎላ ዒ ጫኣቄ ጫኣቁሞና","poem":1},{"text":"ቢያ ባኮ ዳንዳዓ፥ ያይቆኦቤ ፆኦዛሢ፥ ኔኤም","poem":2},{"lineBreak":true},{"text":"ሂዚ ጌይ ዒ ጫኣቂ ናኣቤ ናኣቦ ማሊ ጶቂሤ፦","poem":2}]},{"type":"verse","number":3,"content":[{"text":"«ናንጊና ናንጋ ጎዳሢም ኬኤሢ ታኣኒ ማዣንዳኣና","poem":1},{"text":"ቢያ ባኮ ዳንዳዓ ያይቆኦቤ ፆኦሲም ማኣሪ ታ ኮሻንዳኣና","poem":2},{"lineBreak":true},{"text":"ታ ኬኤፆ ታኣኒ ጌላዓኬ፤","poem":2},{"lineBreak":true},{"text":"ታ ዓርሶይዳኣ ታኣኒ ላሃዓኬ፤","poem":2},{"lineBreak":true},{"text":"ሃውሺ ጊንዖ ጋዓ ባኣዚያ ታ ጊንዓዓኬ።»","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዔፕራታይዳ ኑ ዓኣዖ","poem":1},{"text":"ዒዚ ጫኣቁሞ ጫኣቄ ሳኣፂኖ ዛሎ ኑ ዋይዜኔ፤","poem":2},{"lineBreak":true},{"text":"ቂሪያትይዓሪሜይዳ ዬያ ሳኣፂኖ ኑኡኒ ዴንቄኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዬካፓ ኑኡኒ፦ «ናንጊና ናንጋ ጎዳሢኮ ማኣሪ ኑ ዓኣዾም፤","poem":1},{"text":"ቶካ ዒዛኮ ሄርቃ ሳዖይዳ ሂርኪ ጌይ ኑ ዒዛም ዚጎም» ጌዔኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ኔኤኮ ዎልቆ ፔጋሲ ዔርዛያ ማዔ","poem":2},{"lineBreak":true},{"text":"ጫኣቁሞ ሳኣፂኖና ዎላ ኔኤኒ ሃውሻ ቤዞ","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ጌኤዦ ማኣሮ ጌሌ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኔኤም ማዻ ቄኤሳ ፂሎ ማዾ ማዾም!","poem":1},{"text":"ኔኤም ጉሙርቂንታያ ማዔዞንሢ ዎዛና ኔና ቦንቺ ዓይናዾም!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኔ ዓይላሢ ዳውቴ ጋይቴ ጌይጋፓ","poem":1},{"text":"ኔኤኒ ካኣታሣኒ ቲሽኪ ዶኦሜሢ ሃሺፖ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዳውቴም","poem":1},{"lineBreak":true},{"text":"ሂዚ ጌይ ላኣሚንቱዋ ጫኣቁሞ ጫኣቄኔ፦","poem":1},{"text":"«ኔ ናኣቶፓ ፔቴሢ ታኣኒ ካኣታሣንዳኔ፤","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኔኤኮ ናኣታ ታኣኒ ዔያቶም ጫኣቄ ጫኣቁሞንታ","poem":1},{"text":"ታ ዔያቶ ዓይሤ ባኮንታ ካፒ ኩንሣያ ማዔቴ","poem":2},{"text":"ዔያቶኮ ናኣታ ሃሣ ኔና ሄሊሲ","poem":1},{"text":"ናንጊና ካኣታዺ ናንጋያ ማዓንዳኔ።»","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ናንጊና ናንጋ ጎዳ ፂዮኔ ፔኤም ማሂ ዶኦሬኔ፤","poem":1},{"text":"ዒኢካ ማኣሪ ማሂ ናንጋኒያ ኮዔኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሃና ታኣኮ ናንጊና ሃውሺ ናንጎ ቤሲኬ፤","poem":1},{"text":"ሃይካ ታኣኒ ናንጋኒ ሚርጌ ኮዔያታሢሮ","poem":2},{"lineBreak":true},{"text":"ሃኖ ቤዞ ታ ማኣሪ ታኣኒ ማሄኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ፂዮኔ ታ ኮሺ ዑሣ ዓኣሢ ዓንጃንዳኔ፤","poem":1},{"text":"ማንቆ ዓሶ ሙኡዚ ታኣኒ ሚሻንዳኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ቄኤሶ ታኣኒ ዻቂንታ ማኣዖጉዲ ማይሳንዳኔ፤","poem":1},{"text":"ዒኢካ ናንጋ፥ ጉሙርቂንታ ዓሳኣ ዎዛና ዓይናዻንዳኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዳውቴ ዜርፃፓ ካኣቲ ማዓያ ታኣኒ ኬሳንዳኔ፤","poem":1},{"text":"ታኣኒ ዶኦሚ ካኣታሤሢም ዼኤፒ ዎልቄ ታ ዒንጋንዳኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዒዛኮ ሞርኮ ታኣኒ ቦርሲንቲ ዓፒላንቲኖ ማይሳንዳኔ፤","poem":1},{"text":"ጋዓንቴ ዒዛኮ ቶኦካ ታኣኒ ዓጋንዳ ቦንቾ ባካ ዓኣፓ ዱካያ ማዓንዳኔ።","poem":2}]}],"footnotes":[]}