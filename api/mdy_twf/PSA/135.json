k":true},{"text":"ኮይሴ ባኣዚ ቢያ ዒ ማማዻያኬ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዒርዚና ዓኣ ሻኣሬ ሳዖኮ ጋፓፓ ዔኪ ዬዓኔ፤","poem":1},{"text":"ዒራ ዋርቃኣና ዜኤሊንሢ ዒዚ ዜኤሊንሢሳኔ፤","poem":2},{"lineBreak":true},{"text":"ዢባሮዋ ፔ ኮናፓ ኬሲ ዳካኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጊብፄ ዓጮይዳ ዓሶንታ ቆሎንታኮ","poem":1},{"text":"ቶይዶ ናኣቶ ዎዼሢ ዒዛኬ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጊብፄ! ኔ ጊዳ ኔኤኮ ካኣቲንታ","poem":1},{"text":"ዒዛም ማዻ ዓሶ ቢያሢዳ ሜቶ ዓጋኒ","poem":2},{"lineBreak":true},{"text":"ፔ ዎልቆና ማዺንታ ባኣዚንታ","poem":2},{"lineBreak":true},{"text":"ዲቃሢ ሄርሺሳ ባኣዚ ናንጊና ናንጋ ጎዳ ዳኬኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዒዚ ሜሌ ሚርጌ ዴሬ ዎዺ ኩርሴኔ፤","poem":1},{"text":"ዼኤፖ ዼኤፖ ካኣቶዋ ዎዼኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዓሞራ ዓሶ ካኣቲ ሲሆኔ","poem":1},{"text":"ባኣሳኣኔ ዓሶ ካኣቲ ዖኦጌ","poem":2},{"lineBreak":true},{"text":"ካኣናኔ ዓጮ ካኣቶዋ ቢያ ዒዚ ዎዼኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዬያቶ ዓሶኮ ሳዖ ፔ ዴሮ ዒስራዔኤሌም","poem":1},{"text":"ዴኔ ማሂ ዒዚ ዒንጌኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ሱንፃ ኔኤኮ ናንጊና ናንጋያኬ፤","poem":1},{"text":"ዎዶና ዎዶና ኬስካ ዓሳ ቢያ ኔና ዋሉዋ ጶቂሣንዳኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ናንጊና ናንጋ ጎዳ ፔ ዴሮም ፒዜ ዎጌ ዎጋኔ፤","poem":1},{"text":"ዒዛም ማዻ ዓይሎማኣ ሚጪንታኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሜሌ ዴሮኮ ፆኦዛ","poem":1},{"text":"ቢራ ዓንጊና ዎርቄናይዳፓ ዹይ ኮሾናያኬ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዬያ ፆኦዞኮ ዻንጋ ዓኣዖ ጌስቱዋያ","poem":1},{"text":"ዓኣፒ ዓኣዖዋ ዴንቁዋያኬ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዋይዚያ ዓኣኔ፥ ጋዓንቴ ዋይዙዋሴ፤","poem":1},{"text":"ፔ ሲኢዾና ዑኡሲ ዔካኒ ዳንዳዑዋያኬ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዬያቶ ኮሼ ዓሶንታ ጉሙርቃ ዓሳኣ ቢያ","poem":1},{"text":"ዬያቶ ፆኦዞጉዲ ማዒ ዓቶንጎ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዒስራዔኤሌ ዴሬዮቴ!","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ጋላቱዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢ፥ ናንጊና ናንጋ ጎዳም ማዻ ቄኤሳ!","poem":2},{"lineBreak":true},{"text":"ናን