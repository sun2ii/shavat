{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":137,"content":[{"type":"heading","content":["ዲዒንቲ ዴንዲ ዓኣ ዒስራዔኤሌ ዓሶኮ ዬኤፖ"]},{"type":"verse","number":1,"content":[{"text":"ኑኡኒ ባብሎኔ ዎሮ ዓጫ ዴዒ","poem":1},{"text":"ፂዮኔ ማሊ ጶቂሣዖ ዬኤኬኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዒኢካ ዓሃይያ ጌይንታ ሚፆ ዑፃ","poem":1},{"text":"ጎኦሎ ኑኡኮ ኑ ሱፂ ሃሼኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኑና ዲዒ ዔኪ ዴንዲ ሜታሳ ዓሳ","poem":1},{"text":"ዓይኑሞ ዓይናዺ ኑ ዔያቶ ዎዛሳንዳጉዲ","poem":2},{"lineBreak":true},{"text":"«ፂዮኔይዳ ዒንሢ ዓይናዻ ዓይኑሞፓ ፔቴ ሂንዳ ዓይናዹዋቴ» ጌዔኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ናንጊና ናንጋ ጎዳ ቦንቺ ዓይናዾ ዓይኑሞ","poem":1},{"text":"ዓሲ ዓጪዳ ዴይ ዎይቲ ኑ ዓይናዻንዳይ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዬሩሳላሜ! ኔና ታ ዋሌያ ማዔቴ","poem":1},{"text":"ታኣኮ ጎኦሎ ዋርቃ ሚዛቆ ኩጫ ዞዲ ዓቶም።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዬሩሳላሜ! ታ ኔና ጶቂሡዋዖ ዓቲ፥ ጊንሣ ሃሣ","poem":1},{"text":"ታና ጋፒንሢ ዎዛሳያ ማዓሢ ኔና ማሂ ታ ዔኪባኣቴ","poem":2},{"lineBreak":true},{"text":"ዒንዲርዛ ታኣኮ ሆንጎላሢና ዎላ ዓዺንቶም።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ዬሩሳላሜ ዓዺንቴ ዓቦና","poem":1},{"text":"ዔዶኦሜ ዓሳ ማዼ ባኮ ማሊ ጶቂሤ፤","poem":2},{"text":"«ሹጮና ኬልቆና ዲፆ ፃጳፓ ቱጊ ዶይሱዋቴ!» ጌይ","poem":1},{"text":"ዔያታ ዒላቴ ዒላቶ ጶቂሤ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ባብሎኔ! ኔኤኒ ሻሂንቲ ባይቃንዳኔ፤","poem":1},{"text":"ኔኤኒ ኑጊዳ ማዼ ጌኖ ማዾ ቢያሢ ዛሎ","poem":2},{"lineBreak":true},{"text":"ኮሞ ኮፃሢ ጋላቲንቴያኬ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኔኤኮ ናኣቶ ዔኪ ዔኪ","poem":1},{"text":"ላሎ ሹጮይዳ ጳዺሲ ዳኣፃሢ ጋላቲንቴያኬ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}