{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":138,"content":[{"type":"heading","content":["ዳውቴ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ጋላታ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ጉቤ ዒኔፓ ታ ኔና ጋላታኔ፤","poem":1},{"text":"ሜሌ ፆኦዛ ዛጋንቴ ኔኤም ታኣኒ ጋላታ ዓይኑሞ ዓይናዻኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኔኤኮ ናንጊና ናንጋ ናሹሞንታ ፒዙሞንታ","poem":1},{"text":"ኔኤኮ ሱንፆ ዼኤፑሞንታ፥ ሃሣ ኔ ዓይሢፆ ፑኡፑሞንታ","poem":2},{"lineBreak":true},{"text":"ፔጋሲ ኔኤኒ ታኣም ዻዌሢሮ","poem":2},{"text":"ኔኤም ዱማዼ ኔኤኮ ጌኤዦ ማኣሮ ባንሢ ሺሪ","poem":1},{"text":"ሂርኪ ጌይ ዚጊ ዚጊ ታ ኔና ጋላታኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታ ኔና ዔኤላዛ ኔ ታኣኮ ሺኢጲፆ ዋይዜኔ፤","poem":1},{"text":"ኔ ዶዱሞና ኔኤኒ ታና ዶዲሼኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ኔ ጌዔ ቃኣሎ ዔያታ ዋይዜሢሮ","poem":2},{"lineBreak":true},{"text":"ዓጮ ካኣታ ቢያ ኔና ጋላታኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኔ ማዼ ባኮ ቢያሢንታ","poem":1},{"text":"ኔኤኮ ዼኤፖ ቦንቾንታሮ","poem":2},{"lineBreak":true},{"text":"ዓይናዺ ዔያታ ዼኤፒሳኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኔኤኒ ሌካ ዼጌ ቤዛ ዓኣያ ማዔቴያ","poem":1},{"text":"ሂርኬ ማዔ ቦሂንቴዞንሢ ኔ ዛጋኔ፤","poem":2},{"lineBreak":true},{"text":"ዖቶሮ ዓሶ ሃኬ ዓኣ ቤዛ ዓኣዖ ኔኤኒ ዔራኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታኣኒ ሜቶኮ ባኣኮ ጌሌቴያ","poem":1},{"text":"ኔኤኒ ሼምፔና ታና ጌሣኔ።","poem":2},{"text":"ዻጋዺ ታጊዳ ዔቄ ሞርኮ ኔኤኒ ማካኔ፤","poem":1},{"text":"ኔኤኮ ዼኤፖ ዎልቆና ኔ ታና ዓውሳኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳ ታኣም ማሌ ማሊፆ ኩንሣንዳኔ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔኤኮ ናሹማ ናንጊና ናንጋያኬ፤","poem":2},{"lineBreak":true},{"text":"ኔ ኩጮና ኔኤኒ ማዤሢ ዋሊ ሃሺፖ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}