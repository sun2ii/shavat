{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":139,"content":[{"type":"heading","content":["ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆ ዓይናዺንታ ዳውቴ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ፆኦሲ ቢያ ዎዴ ዑኬ ማዒፆ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔ ታና ሙሪ ዛጊ ዔሬኔ።","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ታኣኒ ዴዓኣና ማዖም ዔቃኣና ኔ ታና ዔራኔ፤","poem":1},{"text":"ታኣኮ ማሊፆ ሃኬ ዓኣዖ ኔኤኒ ዔዔራኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታ ሃንታ ቤዞንታ ዴይ ሃውሻ ቤዞ ኔ ዋሉዋሴ፤","poem":1},{"text":"ታ ማዺ ሃንታ ባኮ ቢያ ኔ ዔራኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ታኣኒ ሃጊ ኬኤዛንዳሢኮ ቤርታ","poem":1},{"text":"ታ ዎዚ ጋዓኒ ጋዓቴያ ኔ ዔራኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ታ ኮይሎይዳ ቢያ ኔኤኒ ዓኣኔ፤","poem":1},{"text":"ኔ ኩጮና ጎኦቢ ፑርታፓ ኔ ታና ካፓኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኔኤኮ ዔራታ ኮሺ ጪሊል ጋዓያኬ፤","poem":1},{"text":"ታኣኒ ማሊ ጶቂሢ ዔራንዳሢኮ ዑሣኬ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዓንኮዋ ታ ዓኣዺ ኔኤፓ ቶላኒ ዳንዳዑዋሴ፤","poem":1},{"text":"ኔ ቤርታፓ ዓንኮዋ ታ ዴንዲ ፑናንዳ ቤሲ ባኣሴ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጫሪንጮ ታ ኬስኬቶ ኔኤኒ ዒኢካ ዓኣኔ፤","poem":1},{"text":"ሳዖ ዴሞ ዓሶ ኮይላ ታኣኒ ጌሌቴያ ኔ ዒኢካኬ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዓባ ኬስካ ባንፆ ታኣኒ ባራኒ ዴንዴቴያ","poem":1},{"text":"ባዞ ዼኤፖ ሶፒ ዴንዲ ታ ናንጌቴያ፥","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዒኢካ ኔ ዓኣያ ማዒ ኔ ኩቻ ኔ ታና ጎቺ ሃንቲሳኔ፤","poem":1},{"text":"ኔኤኮ ሚዛቆ ኩጮና ኔ ታና ዶዲሺ ዓርቃኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታኣኒ፦ «ዹማ ታና ዓኣቺ ዓይሳንዳኔ፤","poem":1},{"text":"ታ ኮይላ ዓኣ ፖዓ ዹሞንጎ» ጌዔቴያ፥","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዹማ ኔኤኮ ዓኣፖ ዴንቂ ላኣጉዋሴ፤","poem":1},{"text":"ዹማ ኔ ኮይላ ሮኦሪጉዲ ፖዓኔ፤","poem":2},{"lineBreak":true},{"text":"ኔ ኮይላ ዹሚንታ ሮኦሪንታ ዱማዹዋያኬ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታና ጉቤና ማዤሢ ኔናኬ፤","poem":1},{"text":"ታ ዒንዶ ጎጳ ታ ዑፆ ዎላ ካንሢ ማዤሢ ኔናኬ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዲቃሢ ሄርሺሳ ጎይሢና ታ ማዢንቴሢሮ ታ ኔና ጋላታኔ፤","poem":1},{"text":"ኔኤኮ ማዻ ቢያ ሄርሺሲ ዲቃሣያ ማዔሢ ጋፒ ታኣኒ ዔራኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ጴዹዋያ ማዔ ዓኣሺንቴ ቤዛ ታ ማዢንቴያና","poem":1},{"text":"ሳዖ ዴሞ ማዔ ቤዞይዳኣ ታ ዑፃ ፔቴይዳ ዎላ ካንሢንቴያና","poem":2},{"lineBreak":true},{"text":"ታ ዑፃ ኔ ዓኣፓፓ ዓኣቺንቲ ማዢንቴያቱዋሴ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታ ዒንዶ ጎጳ ታኣኒ ሱጉሢ ዓኣንቴ ኔ ታና ዴንቄኔ፤","poem":1},{"text":"ታኣም ጎዖና ኬላ ሃጊ ፔቴ ጌይ ዓርቂንቱዋንቴ","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ማዝጋቦይዳ ፃኣፒንቲ ዴዔኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ፆኦሲዮ! ኔ ታኣም ማላ ማሊፃ ኮሺ ዼኤፒኬ፤","poem":1},{"text":"ፓይዳኣ ኮሺ ዺባያኬ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ኔ ታኣም ማላ ማሊፃ ፓይዲንቴቴ","poem":1},{"text":"ባዚ ዓቺ ማኣሻላፓ ባሻያኬ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ጊንዒ፥ ጊንሣ ጴጫኣናኣ","poem":2},{"lineBreak":true},{"text":"ሃይሾ ኔ ታ ኮይላ ዓኣ ጎይሣኬ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ፆኦሲዮ! ፑርቶ ዓሶ ባይዜቴራ!","poem":1},{"text":"ዒንሢ ሃይ፥ ሱጉፆ ዼኤቤ ዓሳ ታ ኮይላፓ ባይቁዋቴ!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዔያታ ኔኤም ፑርታ ጌኤሲ ጌስታኔ፤","poem":1},{"text":"ኔኤኮ ሞርኬ ማዒ ኔ ሱንፆ ፑርቲሲ ዔያታ ዾንካኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔና ዒፃ ዓሶ ዒናፓ ታ ዒፃዓዳ?","poem":1},{"text":"ኔኤም ጌኤታዻ ዓሶ ኮሺ ታኣኒ ሻኣኪንታዓዳ?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ጉቤ ዒናፓ ጋፒ ታ ዔያቶ ዒፃኔ፤","poem":1},{"text":"ታ ሞርኬ ማሂ ታ ዔያቶ ዛጋኔ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ፆኦሲዮ! ታና ሙሪ ዛጊ፥ ታ ዒኖ ዴንቄ፤","poem":1},{"text":"ታ ዎዚምታቴያ ዛጊ፥ ታ ሜታዺ ማላ ማሊፆ ዔሬ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ፑርታ ጎይሢ ማላ ዒኔ ታኣኮ ዓኣቴ ዛጊ ዴንቄ፤","poem":1},{"text":"ናንጊና ናንጋ ጎይፆ ታ ዓኣዻንዳጉዲ ታና ዻዌ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}