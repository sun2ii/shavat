{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":14,"content":[{"type":"heading","content":["ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆና ዓይናዺንታ ዳውቴ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ዓሲኮ ፑርቱሞ"]},{"type":"verse","number":1,"content":[{"text":"ዔኤዮ ዓሳ ፔ ዒኖና፦ «ፆኦሲ ባኣሴ» ጋዓኔ፤","poem":1},{"text":"ዬያጉዴ ዓሳ ማኣሳኔ ዓሲኬ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ሻኣካ ማዾ ማዻኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶ ባኣኮይዳ ኮሺ ባኣዚ ማዻ ዓሲ ፔቴታዖ ባኣሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ማሊ ጶቂሣ ዓሲንታ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ኮዓ ዓሲያኣ ዓኣቶ ዴንቃኒ","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ጫሪንጫፓ ሊካ ዓሶ ዛጌኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጋዓንቴ ዓሳ ቢያሢ ዣኣሌኔ፤","poem":1},{"text":"ጉቤሢ ፔቴ ማዒ ፑርቴኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶይዳፓ ፔቴ ዓሲታዎ ኮሺ ማዻይ ባኣሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ናንጊና ናንጋ ጎዳ፦ «ፆኦሲ ዔሪ ሺኢቁዋ ዓሶኮ","poem":1},{"text":"ታኣኮ ዴሮ ዓዳ ካሣጉዲ ሙዓ","poem":2},{"lineBreak":true},{"text":"ፑርቶ ማዻ ዓሶኮ ማሊ ጶቂሣ ዒኔ ባኣዓዳ?» ጋዓኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ናንጊና ናንጋ ጎዳ ፂሎ ዓሶ ባኣካ ዓኣሢሮ","poem":1},{"text":"ዔያታ ዓኣ ቤዛ ዓኣዖ ዲቃቲ ጋፔኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዒንሢ ማንቆ ዓሶኮ ማሊፆ ዹቃኒ ማሌያታቴያ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ጋዓንቴ ዔያቶኮ ጊቲማሢኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ዒስራዔኤሌ ዓሶም ዻቂንታ ፂዮኔይዳፓ ሙካቴ ዓይጎ!","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ፔ ዴሮኮ ዲዒንቴ ባኮ ማሃ ዎዶና","poem":2},{"text":"ያይቆኦቤ ዎዛዻንዳኔ፤","poem":1},{"text":"ዒስራዔኤሌ ዴራኣ ዒላሻንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}