{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":140,"content":[{"type":"heading","content":["ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆ ዓይናዺንታ ዳውቴ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ፆኦሲ ማኣዳንዳጉዲ ሺኢቂንታ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ፑርቶ ዓሶፓ ታና ዓውሴ፤","poem":1},{"text":"ጌኖ ማዻ ዓሶ ኩጫፓኣ ታና ቶሊሴ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዔያቶኮ ዒና ፑርታ ማዾንዳያ ማሊ ቱካኔ፤","poem":1},{"text":"ቢያ ዎዴ ዑራ ሌሊ ዔያታ ማዣኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዔያቶኮ ዒንዲርዛ ፑርታ ሾኦሺጉዲ ዻዻዓያኬ፤","poem":1},{"text":"ዔያታ ዻንጋፓ ኬሳ ባካ ዶርባ ሾኦሺ ማርዜኬ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ፑርቶ ዓሶ ኩጫፓ ታና ዓውሴ፤","poem":1},{"lineBreak":true},{"text":"ታኣኮ ቶኮ ቡኡዳኒ ማላ ጌኖ ዓሶፓ ቶሊሴ።","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ዖቶሮ ዓሳ ፒሮ ታኣም ዓኣቺ ፒሬኔ፤","poem":1},{"text":"ፒሮ ሱሲ ታና ቡኡዳኒ ዔያታ ታ ቤርታ ዋሄኔ፤","poem":2},{"lineBreak":true},{"text":"ፒራሢና ታና ዓይሣኒ ታኣኒ ሃንታ ጎይፃ ዔያታ ፒሬኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ናንጊና ናንጋ ጎዳሢ፥ «ታኣኮ ኔኤኒ ፆኦሲኬ» ታ ጋዓኔ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳሢዮ! ታ ኔና ሺኢቂ ዒላታ ዒላቶ ዋይዜ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዎልቄና ዓኣያ ማዒ ታና ዓውሳ","poem":1},{"lineBreak":true},{"text":"ናንጊና ናንጋ ታ ጎዳ ማዔ ፆኦዛሢዮ!","poem":1},{"text":"ዖሎ ዓቦና ጊቲማ ማዒ ሂኢዣ ታና ዓይዱዋጉዲ ቃዜ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ፑርቶ ዓሶም ዔያታ ኮዓ ባኮ ዒንጊፖ፤","poem":1},{"text":"ዔያታ ማሊ ቱካ ቱኡዞ ዔያቶም ሃኒሲፖ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታና ማንጌ ታ ሞርካ ታና ባሻንዳጉዲ ማሂፖ፤","poem":1},{"text":"ዔያታ ማዻኒ ማላ ጌኖ ማዾ ዔያቶ ባንሢ ሺርሼ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታሚ ቄንሢ ዔያቶ ዑፃ ኬዶም፤","poem":1},{"text":"ዬካፓ ዔያታ ቶሊ ኬስኩዋጉዲ ታሚዳ ዓጊንቶም፤","poem":2},{"lineBreak":true},{"text":"ኮሺ ዔታዻያ ቶርጴ ዓኣ ዔቴይዳ ኬኤሪንቶም።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሉኡዙሞና ዓሲ ፑሽኪ ሃንታ ዓሲ ሳዖይዳ ናንጎፓ፤","poem":1},{"text":"ጌኔ ማዻ ፑርቶ ዓሶ ፑርታ ባኣዚ ኬሚ ባባይዞም።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ማንቆ ዓሶም ፒዜ ዎጌ ኔ ዎጋሢንታ","poem":1},{"text":"ሄርቂንቲ ዎይሢፆና ሜታዻ ዓሶ ዛሎ ኔ ሞኦታሢ ታ ዔራኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኮዦ ዓሳ ጎኔና ኔና ጋላታኔ፤","poem":1},{"text":"ኔ ዓኣ ቤዞይዳ ኔኤና ዎላ ዶዲ ዔያታ ናንጋንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}