{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":141,"content":[{"type":"heading","content":["ዳውቴ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ፆኦሲ ዓውሳንዳጉዲ ሺኢቂንታ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ታ ኔ ዋይዞም ዒላታኔ፤","poem":1},{"text":"ኔጉዋዖ ዑኬና ታና ማኣዴ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ኔ ዋይዞም ዒላታሢ ዋይዜ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታኣኒ ሺኢቃ ሺኢጲፃ ዑንጄ ኔኤም ጩቢሾያጉዲ","poem":1},{"text":"ኔ ባንሢ ዔቂሳ ኩጫኣ ዒባናኣና ዒንጎ ዒንጊፆጉዲ ማዖም።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ታ ዻንጎ ካፓ ዓሲ ጌሤ፤","poem":1},{"text":"ታ ሙሱሮዋ ቃዛንዳ ዓሲ ዔቂሴ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ፑርቶ ዓሶና ዎላ ፑርታ ማዾ ታ ማዹዋጉዱ","poem":1},{"text":"ታኣኮ ዒኖ ፑርቱሞ ባንሢ ማሊሲፖ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶና ዎላ ዴይ ሙዎ ሙኡዚያ ታና ሙዒሲፖ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ፂሎ ዓሲ ታና ፁንቆንጎ፥ ዬይ ታና ሚጪንቲሢኬ፤","poem":1},{"text":"ዒዚ ታና ጎሮንጎ፥ ዬይ ታ ቶኦኮ ዖይሲና ቲሽኪሢኬ፤","poem":2},{"lineBreak":true},{"text":"ጋዓንቴ ታ ቢያ ዎዴ ፑርቶ ዓሶ ማዾ ማኪ ማኪ ሺኢቃኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሱኡጋ ዔያቶኮ ዼኤፖ ላሎ ማጋ ኬኤሪንታኣና","poem":1},{"text":"ታ ጋዓ ባካ ጎኔታሢ ዔያታ ዔራንዳኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሳዓ ጎሽኪንታኣና ቦኪ ቡርሺንታሢጉዲ","poem":1},{"text":"ዔያቶኮ ሜጌፃ ዱኡፖ ካራ ካራ ዜርቂንታንዳኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዔ ታ ፆኦዛሢዮ!","poem":1},{"text":"ታኣኒ ጋዓንቴ ኔና ጉሙርቂፆ ሃሻዓኬ፤","poem":2},{"lineBreak":true},{"text":"ኔ ታና ዓኣቻንዳጉዲ ታ ኮዓሢሮ ሃይቆም ጌይ ታና ሃሺፖ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዔያታ ዓኣቺ ፒሬ ፒራስካፓ ታና ቶሊሴ፤","poem":1},{"text":"ፑርቶ ማዻ ዓሶኮ ዹቃስካፓ ታና ዓይሴ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታኣኒ ኮሺና ዖኦኪ ዴንዳዛ","poem":1},{"text":"ፑርቶ ዓሳ ዔያታ ፒሬ ፒራስካ ፔኤሮ ዓዺንቶንጎ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}