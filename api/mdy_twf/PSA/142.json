{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":142,"content":[{"type":"heading","content":["ዳውቴ ዴኖ ዔቶይዳ ዓኣ ዎዶና ዔራቶና ካላሌ ካላሎ"]},{"type":"hebrew_subtitle","content":["ፆኦሲ ማኣዳንዳጉዲ ሺኢቆ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ዑኡዞ ታኣኒ ዼጊዲ ናንጊና ናንጋ ጎዳ ዋይዞም ዒላታኔ፤","poem":1},{"text":"ታና ዒዚ ሚጪንታንዳጉዲ ታ ሺኢቃኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታ ዒዛ ሃዳርሳ ባኮ ቢያ ዒዛ ቤርቶ ሺኢሻኔ፤","poem":1},{"text":"ሜቶዋ ታኣኮ ቢያ ታ ዒዛም ኬኤዛኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዒና ታኣኮ ጋፒ ዖያኒ ዑካኣና","poem":1},{"text":"ታኣኒ ዓይጎ ዎዳኒ ኮይሳቴያ ዒዚ ዔዔራኔ፤","poem":2},{"text":"ታኣኒ ዴንዳ ጎይፆይዳ","poem":1},{"text":"ሞርካ ታኣም ፒሮ ዓኣቺ ፒሬኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኮይሎ ታ ሺሪ ዛጋንቴ ታና ዓኣቻንዳ ካይዚ ባይቄኔ፤","poem":1},{"text":"ፔቴታዖ ታና ማኣዳ ዓሲ ባኣያ ማዔኔ፤","poem":2},{"lineBreak":true},{"text":"ታና ካፓያና ታ ዛሎ ሂርጋ ዓሲያኣ ባኣሴ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔኤኒ ታና ማኣዳንዳጉዲ","poem":1},{"text":"ታኣኒ ኔ ባንሢ ዒላታኔ፤","poem":2},{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔኤኒ ታኣኮ ፑኖ ካያሢኬ፤","poem":1},{"text":"ሼምፖና ዓኣ ዓሳ ናንጋ ዓጮይዳ ታኣኮ ዓኣያ ማዔሢ ኔናኬ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታኣኒ ጋፒ ዎዛ ቲቂ ዴዔሢሮ","poem":1},{"text":"ኔ ታና ማኣዳንዳጉዲ ኔ ባንሢ ታ ዒላታሢ ዋይዜ፤","poem":2},{"lineBreak":true},{"text":"ዑሣ ዓኣዼ ታኣም ዔያታ ዎልቃዼሢሮ ታ ሞርኮፓ ታና ዓውሴ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታኣኒ ኔና ጋላታንዳጉዲ ሃያ ቱኡዛፓ ታና ቡሌ፤","poem":1},{"text":"ኔኤኒ ታኣም ማዼ ኔኤኮ ኮሹሞ ማዾ ዛጋዖ","poem":2},{"lineBreak":true},{"text":"ፂሎ ዓሳ ሙኪ ታ ኮይላ ቡካንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}