{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":143,"content":[{"type":"heading","content":["ዳውቴ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ፆኦሲፓ ማኣዶ ዴንቃኒ ሺኢቆ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ሺኢጲፆ ታኣኮ ዋይዜ፤","poem":1},{"text":"ታኣኒ ኔና ሺኢቃ ሺኢጲፆ ባንሢ ዋይዚ ጌሤ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ጉሙርቂንታያ፥ ሃሣ ፒዜ ማዔ ጎይፆና","poem":2},{"lineBreak":true},{"text":"ታ ሺኢቃ ባኮ ታኣም ዒንጌ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኔ ቤርታ ፔቴታዖ ፂሎ ማዓ ዓሲ ባኣሢሮ","poem":1},{"text":"ታና ኔ ዓይላሢ ዎጌሮ ኔ ቤርቶ ዔኪ ሺኢሺፖ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታ ሞርካሢ ታና ዎዻኒ ዳውሳኔ፤","poem":1},{"text":"ዹሚዳ ጌልዚ ቱኪ ታኣኮ ካራ ባይዜኔ፤","poem":2},{"lineBreak":true},{"text":"ሚርጌ ዎዴኮ ቤርታ ሃይቂ ዱኡቴ ዓሶጉዲ ታኣኒ ማዔኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታኣኮ ጋሮይዳ ዓኣ ሼምፓሢ ባኣያ ማዔኔ፤","poem":1},{"text":"ዒና ዲቃቴም ካራ ታኣኮ ባይቄኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ታኣኒ ሚናኣ ዎዶ ጶቂሢ ማሌኔ፤","poem":1},{"text":"ኔኤኒ ማዼ ማዾዋ ሺርሺ ሺርሺ ታ ማሌኔ፤","poem":2},{"lineBreak":true},{"text":"ኔ ዎልቆና ኔ ማዼ ባኮዋ ቢያ ታ ጶቂሴኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታ ኩጮ ኔና ሺኢቂ፥ ኔ ባንሢ ታ ዔቂሴኔ፤","poem":1},{"text":"ዳውሌ ዓጪዳ ዋኣሢ ዼኤባሢጉዲ","poem":2},{"lineBreak":true},{"text":"ታኣኮ ሼምፔላ ዒማዺ ኔና ዼኤቤኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ሼምፓሢ ታኣኮ ላቤሢሮ","poem":1},{"text":"ኔጉዋዖ ታ ሺኢቃ ባኮ ታኣም ዒንጌ፤","poem":2},{"lineBreak":true},{"text":"ኔ ዓኣፖ ካሮ ታ ባንፃፓ ሺርሺፖ፤","poem":2},{"lineBreak":true},{"text":"ኔ ዬያይዴቴ ሳዖ ዴሞ ኬዳ ዓሶጉዲ ታኣኒ ማዓንዳኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታኣኒ ጉሙርቃሢ ኔና ማዔሢሮ","poem":1},{"text":"ኬላ ኬላ ኔኤኮ ናንጊና ናንጋ ናሹሞ ታና ዔርዜ፤","poem":2},{"text":"ታ ሼምፓሢ ሃዳርሲ ታ ኔኤም ዒንጌሢሮ","poem":1},{"text":"ታኣኒ ዴንዳንዳ ጎይፆ ታና ዻዌ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ታኣኒ ኔና ፑኖ ካያሢ ማሄሢሮ","poem":1},{"text":"ታኣኮ ሞርኮይዳፓ ታና ማኣዲ ዓውሴ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኔኤኒ ታኣኮ ፆኦዛሢኬ፤","poem":1},{"text":"ኔ ጋዓ ባኮ ታኣኒ ማዺ ኩንሣንጉዲ ታና ዔርዜ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ኮዦ ዓያኖና ኮሺ ጎይሢ ታኣም ዻዌ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔ ቦንቾም ጌይ ታ ሼምፓሢ ካፔ፤","poem":1},{"text":"ኔኤኮ ፒዙሞ ማዾና ታኣኮ ሜቶይዳፓ ቢያ ታና ኬሴ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኔኤኮ ናንጊና ናንጋ ናሹሞ ፔጋሲ ታኣም ዻዋኒ","poem":1},{"text":"ታኣኮ ሞርኮ ዎዺ ባይዜ፤","poem":2},{"text":"ታኣኒ ኔኤኮ ዓይላሢታሢሮ","poem":1},{"text":"ታኣም ፑርታ ባኣዚ ማዻ ዓሶ ቢያ ኩርሴ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}