{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":144,"content":[{"type":"heading","content":["ዳውቴ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ባሺሢ ዴንቃዖ ዓይናዾ ዓይኑሞ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዔ ታኣኮ ላላሢ ጋላቲንቶንጎ!","poem":1},{"text":"ዒዚ ታና ዖልዚ ዖሎ ጎይሢ ዔርዚ፥ ዖልዚም ጊኢጊሻኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ናንጊና ናንጋ ጎዳ ታና ካፓያ ታኣኮ ጊቲማኬ፤","poem":1},{"text":"ታኣኮ ፑኖ ካያሢ፥ ሃሣ ታና ዓውሳሢኬ፤","poem":2},{"text":"ታኣኒ ዒዛ ጉሙርቂ ኮሺ ናንጋኔ፤","poem":1},{"text":"ዴራኣ ታኣም ዓይሢንታንዳጉዲ ማሃሢ ዒዛኬ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ዓሲንሢ ዓይጎኬ ጌይ ኔ ሃያይዲ ቶኦኮ ዛጋይ?","poem":2},{"lineBreak":true},{"text":"ሃያይዲ ኔ ሂርጊ ዔያቶም ማላሢ ዓይጎኬ ጌይዳይ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዓሲ ዢባሬጉዴ ባኣዚኬ፤","poem":1},{"text":"ናንጋ ዎዳኣ ዔኤዤ ሺቢጉዴ ዴንዲ ባይቃያኬ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ጫሪንጮ ዳርዚ ሊካ ኬዴ፤","poem":1},{"text":"ዹኮ ኔ ኩጮና ካኣሚ ጩቢሼ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኔኤኮ ዜኤሊንፆ ዜኤሊንሢ ኔ ሞርኮ ዳውሲ ባይዜ፤","poem":1},{"text":"ኔኤኮ ሂኢዦና ዔያቶ ዱኪ ዳውሴ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኔ ኩጮ ሎኦፓ ሊካ ዳኬ፤","poem":1},{"text":"ዼኤፖ ዋኣፆ ዴማፓ ታና ጎቺ ኬሲ፥ ዓውሴ፤","poem":2},{"lineBreak":true},{"text":"ፃንጎ ማዔ ሜሌ ዓጮ ዓሶፓ ታና ዓይሴ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዔያታ ፔቴታዖ ጎኔ ባኣዚ ጌስቱዋሴ፤","poem":1},{"text":"ሚዛቆ ኩጮ ዔያታ ዔቂሲ ሉኡዙሞና ጫኣቃኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፆኦሲዮ! ዓኪ ዓይኑሞ ኔና ቦንቺ ታ ዓይናዻንዳኔ፤","poem":1},{"text":"ታጶ ሻሺ ዴንሢንታ ጎኦሎዋ ዋርቂ ታኣኒ ዓይናዻንዳኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዖልዚና ባሻንዳጉዲ ካኣቶም ኔኤኒ ዎልቄ ዒንጋኔ፤","poem":1},{"text":"ኔ ዓይላሢ ዳውቴያ ጬንቾ ዓራፖ ዓጬሢፓ ኔ ዓውሳያኬ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ፃንጎ ማዔ ሜሌ ዓጮ ሞርኮይዳፓ ታና ዓውሴ፤","poem":1},{"text":"ዔያቶኮ ዻንጋ ሉኡዚ ባኣዚ ጌስታያኬ፤","poem":2},{"lineBreak":true},{"text":"ሚዛቆ ኩጮ ዔያታ ሉኡዙሞ ጫኣቁሞሮ ዔዔቂሳኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኑኡኮ ዼጌ ናኣታ ሃጊ ዔቃኣና","poem":1},{"text":"ሃጊ ባቃሊ ዑጊ ዴንዳ ሚሢጉዲ ማዖንጎ፤","poem":2},{"text":"ኑኡኮ ዉዱሮ ናኣታ ካኣቱሞ ማኣሮኮ ጎንጃሢ ዎላ ካኣማ ካሮይዳ","poem":1},{"text":"ዾቂንቲ ኬኤፆ ሚዛጲሳ፥ ዓርሲ ኮሾና ፒዜ ቱርቱሮጉዲ ማዖንጎ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኮና ኑኡኮ ዱማ ዱማ ቶኦኪ ሃኣኮና ኩሜያ ማዖንጎ፤","poem":1},{"text":"ሄንፆሮ ዞኦዞ ኬስኬ ኑኡኮ ማራታ","poem":2},{"lineBreak":true},{"text":"ሚርጌ ሺያና ፓይዲንታ ማሪናይ ሾይ ዺቦንጎ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ባኣታ ኑኡኮ ካኣሽኮንጎ፤","poem":1},{"text":"ቡሉዋዖ ሾይ ሾይ ዺቦንጎ፤","poem":2},{"lineBreak":true},{"text":"ኑና ዲዒ ዔኪ ዴንዳ ባኣዚ ባይቆንጎ፤","poem":2},{"lineBreak":true},{"text":"ኑ ካታሞኮ ሳዞ ጎይፆ ዼኤፖይዳ ዬኤፒ ዑኡሲ ዋይዚንቶፓ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዬያጉዴ ዓንጆ ዒንጊንቴ ዴሬ ጋላቲንቴያኬ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ዔያቶኮ ፆኦሲ ማዔ ዴሬ ዓንጂንቴያኬ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}