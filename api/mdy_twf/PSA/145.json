,"content":[{"text":"ዴራ ኔኤኮ ዲቃሢ ሄርሺሳ ዼኤፖ ማዾ ዛሎ ኬኤዛንዳኔ፤","poem":1},{"text":"ታኣኒያ ኔኤኮ ዼኤፖ ማዾ ሄርሺ ዼጊዲ ኬኤዛንዳኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዔያታ ኔኤኮ ኮሹሞ ሚርጊፆ ኬኤዛንዳኔ፤","poem":1},{"text":"ኔኤኮ ፂሉሞ ዎልቆ ዛሎ ዼግ ጌዔ ዑኡሲና ዓይናዻንዳኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳ ኮሺ፥ ሃሣ ሚጪንታያኬ፤","poem":1},{"text":"ዻጋዻኒ ሩኡሩዋያ፥ ናሹማኣ ናንጊና ጋፑዋያኬ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዒዚ ቢያ ባኮም ኮሺኬ፤","poem":1},{"text":"ዒ ማዤ ባኮ ቢያ ሚጪንታያኬ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ኔ ማዤ ባካ ቢያ ኔና ጋላታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ኔኤም ዱማዼ ኔ ዴራ ቢያ ኔና ዼኤፒሲ ሄርሻንዳኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኔኤኮ ካኣቱሞ ቦንቾ ዛሎ ኬኤዛንዳኔ፤","poem":1},{"text":"ኔኤኮ ዎልቆ ዛሎዋ ሄርሺ ጌስታንዳኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዬያይዲ፥ ዓሲ ቢያ","poem":1},{"text":"ኔ ዎልቆና ኔኤኒ ማዼ ዼኤፖ ማዾንታ","poem":2},{"lineBreak":true},{"text":"ጊንሣ ሃሣ ኔኤኮ ካኣቱሞ ቦንቾ ዼኤፑሞዋ ዔራንዳኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኬስካ ዎዶ ቢያይዳ ዎይሣ ካኣታሢ ኔናኬ፤","poem":1},{"text":"ኔኤኮ ካኣቱማ ናንጊና ባይቁዋያኬ።","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ጋዓ ባኮ ጉሙርቂንቲ ኩንሣያኬ፤","poem":1},{"text":"ዒዚ ማዻ ባካ ቢያ ኮሺኬ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሎኦማኒ ቡኡዲንታ ዓሶ ዒ ኬኤሊንቃኔ፤","poem":1},{"text":"ሳዓ ሎኦሚ ዓኣ ዓሶዋ ዔቂሳኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ቢያሢ ጉሙርቂ ኔና ዛጋኔ፤","poem":1},{"lineBreak":true},{"text":"ኔኤኒያ ዔያቶም ኮይሳ ዎዶና","poem":1},{"text":"ዔያታ ሙዓንዳ ሙዖ ዒንጋኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኔኤኒ ኔኤኮ ኩጮ ቡሊ","poem":1},{"text":"ፔቴ ፔቴ ሼምፔና ዓኣ ባኮም","poem":2},{"lineBreak":true},{"text":"ኮይሳ ባኮ ዒንጊ ዒኖ ዔያቶኮ ሃውሺሳኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዻ ባኮና ቢያ ፂሎኬ፤","poem":1},{"text":"ጊንሣ ሃሣ ኮሺኬ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዒዛ ሺኢቃዞንሢም ቢያ","poem":1},{"text":"ጎኔ ዒኔፓ ሺኢቃዞንሢም ቢያ ዒ ዑኬኬ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ቦንቺ ዒዛ ዒጊጫዞንሢም","poem":1},{"text":"ኮይሳ ባኮ ቢያ ዒዚ ዒንጋኔ፤","poem":2},{"lineBreak":true},{"text":"ሜታዺ ዒላታ ዒላቶዋ ዋይዚ ዔያቶ ማኣዳኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዒዛ ናሽካዞንሢ ቢያ ዒ ፑርታፓ ካፓኔ፤","poem":1},{"text":"ፑርቶ ዓሶ ጋዓንቴ ዒዚ ዎዺ ባይዛኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ታኣኒ ቢያ ዎዴ ናንጊና ናንጋ ጎዳ ጋላታንዳኔ፤","poem":1},{"text":"ዒዚ ማዤ ባካ ቢያ","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ዱማዼ ጌኤዦ ሱንፆ ሄርሺ ሄርሺ ናንጎንጎ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}