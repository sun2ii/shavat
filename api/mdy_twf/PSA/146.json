{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":146,"content":[{"type":"heading","content":["ዻቂሻ ፆኦሲም ሺኢካ ጋላታ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳም ጋላታ!","poem":1},{"text":"ታ ሼምፔሌ! ናንጊና ናንጋ ጎዳ ጋላቴ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሼምፔና ዓኣ ዎዶ ቢያይዳ ናንጊና ናንጋ ጎዳ ታ ጋላታንዳኔ፤","poem":1},{"text":"ናንጋ ዎዶ ቢያይዳ ታ ፆኦዛሢ ታኣኒ ቦንቺ ዓይናዻንዳኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዻቂሻኒ ዳንዳዑዋ፥ ዓሲ ማዢንቲ ማዔ ዓሶና","poem":1},{"text":"ሱኡጎ ማዒ ዎይሣ ዼኤፖ ዓሶ ጉሙርቂፖቴ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዔያታ ሃይቃዖ ሳኣ ዴሚ ጌላኔ፤","poem":1},{"text":"ዒማ ኬሎይዳ ዔያታ ማዻኒ ማሌ ባካ ቢያ ጉሪ ባይቃኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ያይቆኦቤ ፆኦሲ ዒዛ ማኣዳያ ማዔ ዓሢ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ማዔ ፔ ፆኦዛሢዳ ጌኤቂንቴሢ ዎዛዾንጎ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ናንጊና ናንጋ ጎዳ ጫሪንጮንታ ሳዖንታ","poem":1},{"text":"ዼኤፖ ባዞንታ ጊዳ ዓኣ ባኮ ቢያ ማዤሢኬ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ጉሙርቂንቴ ጎይሣ ናንጋያኬ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሄርቂንቲ ዎርቃ ዓሶም ፒዜ ዎጌ ዎጋኔ፤","poem":1},{"text":"ናይዺንቴዞንሢም ሙኡዚ ዒንጋኔ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ቱኡቴ ዓሶዋ ቱኡዛፓ ዒ ቡላኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዓኣፓ ባይቄ ዓሶኮ ዓኣፖ ቡላኔ፤","poem":1},{"text":"ሎኦሚ ዓኣ ዓሶ ሳዓፓ ዔቂሳኔ፤","poem":2},{"lineBreak":true},{"text":"ፂሎ ማዔ ዓሶዋ ዒዚ ናሽካኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሜሌ ዓጪፓ ሙኬ ዓሲ ማዒ ናንጋ ዓሶ ካፓኔ፤","poem":1},{"text":"ዜኤሪንዶ ማዔ ላኣሎንታ ዜኤሮ ናኣቶዋ ማኣዳኔ፤","poem":2},{"lineBreak":true},{"text":"ፑርቶ ዓሶኮ ጌኖ ማሊፆ ጉሪ ማሃኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ናንጊና ናንጋ ጎዳ ካኣቲ ማዒ ናንጋያኬ፤","poem":1},{"text":"ፂዮኔ! ኔ ፆኦዛሢ ኬስካ ዎዶ ቢያይዳ ካኣታዺ ናንጋኔ።","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳም ጋላታ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}