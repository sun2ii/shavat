{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":147,"content":[{"type":"heading","content":["ቢያ ባኮ ዳንዳዓ ፆኦሲም ሺኢካ ጋላታ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳ ጋላቱዋቴ!","poem":1},{"text":"ኑ ፆኦሲ ቦንቺ ጋላታ ዓይኑሞ ዓይናዺሢ ቃራኬ፤","poem":2},{"lineBreak":true},{"text":"ዒዛ ጋላቲፃ ዎዛሳያ፥ ሃሣ ኮይሳያኬ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዬሩሳላሜ ጊንሣ ዓካሲ ማዣኔ፤","poem":1},{"text":"ዒስራዔኤሌፓ ዳውሲንቲ ዴንዴ ዓሶ ጊንሣ ዒ ማሃኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዒኔ ሜቂ ዖዬ ዓሶ ዒዚ ዶዲሻኔ፤","poem":1},{"text":"ኪፆዋ ኑኡኮ ዒ ፓሣኒ ማራኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ዦኦጋሢኮ ሚርጉሞ ዒዚ ፓይዲ ዔራኔ፤","poem":1},{"text":"ፔቴ ፔቴሢኮዋ ሱንፆ ዒ ጌሣኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ናንጊና ናንጋ ኑ ጎዳሢ ዼኤፒ፥ ሃሣ ዎልቄና ዓኣያኬ፤","poem":1},{"text":"ዒዚ ዔራ ዔራታ ሃይማኬ ጌይንቱዋያኬ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዒኖ ሼሌዔ ዓሶ ዒዚ ቦንቺሲ ዼጊሳኔ፤","poem":1},{"text":"ፑርቶ ማዻ ዓሶ ጋዓንቴ ሳዓ ኬኤሪ ዻውሲሳኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ናንጊና ናንጋ ጎዳ ቦንቺ ዓይኑሞ ዓይናዹዋቴ፤","poem":1},{"text":"ጎኦላ ዋርቂ ዋርቂያኣ ኑ ፆኦዛሢ ዓይናዺ ቦንቹዋቴ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዒዚ ሻኣሮ ጫሪንጮይዳ ሚጫኔ፤","poem":1},{"text":"ሳዖይዳ ዒርዚ ዋርቂሳኔ፤","poem":2},{"lineBreak":true},{"text":"ዹኮይዳ ማኣቲ ኬሲ ዓኣዒሳኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ካዮ ቦዖንታ ቆሎንታም ቢያ ሙኡዚ ዒንጋኔ፤","poem":1},{"text":"ሙኡዚ ባይቄም ዒላታ ቁራኮ ናኣቶ ዒ ሙኡዛኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዒዚ ዎዛዻሢ ዶዶ ፓራሢንታ","poem":1},{"text":"ዖሎ ዓሶንታኮ ዎልቆ ዛጊቱዋሴ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዒዛ ዎዛሳሢ","poem":1},{"text":"ዒዛ ቦንቺ ዒጊጫዞንሢና","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ናሹሞ ዒዛኮ ጉሙርቃዞንሢኬ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዬሩሳላሜ! ናንጊና ናንጋ ጎዳ ጋላቴ!","poem":1},{"text":"ፂዮኔ! ኔ ፆኦዛሢ ፑኡፒሲ ዒላሼ!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዒዚ ኔኤኮ ማርሾ ካሮኮ ጋጋርዞ ዶዲሺ ካፓኔ፤","poem":1},{"text":"ኔ ጋራ ዓኣ ዴሮ ዒዚ ዓንጃኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዒዚ ኔ ዓጮኮ ዛጶ ኮሺ ማሂ ካፓኔ፤","poem":1},{"text":"ቃራ ዛርጌ ካፂሲ ኔና ዒ ሚሻኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሳዖ ፔ ቢታንቶና ዒዚ ዓይሣኔ፤","poem":1},{"text":"ዒዚ ጋዓ ባካ ኔጉዋዖ ማዺንቲ ኩማኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዼኤፖ ሻጮ ዎዺንቴ ፑኡታጉዲ ሳዓ ዒዚ ሚጫኔ፤","poem":1},{"text":"ሊኢሎጉዲ ላሃ ዖልኮዋ ዲቢንሢጉዲ ሳዓ ላኣላኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሻጮ ቃንፆጉዲ ሳዓ ዒዚ ዲኢኒሻኔ፤","poem":1},{"text":"ዬያ ኬዳ ሻጮ ቤርታ ዖኦኒያ ጫርቂ ዔቃኒ ዳንዳዑዋሴ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዬካፓ ዒዚ ዓይሥሢ ዓይሣኔ፤","poem":1},{"text":"ዬይ ላኣዳዺ ዴይ ዓኣ ሻጫ ዓልቃኔ፤","poem":2},{"lineBreak":true},{"text":"ዢባሬ ዒዚ ዢባርሺሴም ዋኣሢ ዒኢፓ ጎዓኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ፔ ቃኣሎ ያይቆኦቤ ናኣቶም","poem":1},{"text":"ዒዛኮ ዎጎንታ ዳምቦንታ ዒስራዔኤሌም ፔጋሲ ዔርዛኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዬያ ቢያ ዒዚ ሜሌ ዓይጎ ዴሬማኣ ማዺባኣሴ፤","poem":1},{"text":"ዬያታ ዒዛኮ ዎጎ ዔሩዋሴ።","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳም ጋላታ!","poem":1}]}],"footnotes":[]},