{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":148,"content":[{"type":"heading","content":["ማዢንቲ ቢያ ፆኦሲ ጋላታንዳያ ኮይሳሢ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳ ጫሪንጫፓ ጋላቱዋቴ!","poem":1},{"text":"ሎ ዼጌ ጫሪንጫ ዓኣ ማዢንታ","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳሢ ጋላቱዋቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ዒንሢ፥ ዒዛኮ ኪኢታንቻ ዒዛ ጋላቱዋቴ፤","poem":1},{"text":"ጫሪንጮይዳ ዓኣ ዒዛኮ ዖሎ ዓሳ ቢያ ዒዛ ጋላቱዋቴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዓቦንታ ዓጊኖንታ ጋላቱዋቴ፤","poem":1},{"text":"ጫሪንጫ ፖዓ ዦኦጋሢያ ዒዛ ጋላቱዋቴ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሌካ ዼግ ጌይ ዓኣ ጫሪንጫ ዒዛ ጋላቱዋቴ፤","poem":1},{"text":"ዼጌ ቤዞኮ ዑፃ ዓኣ ዋኣፃኣ ጋላቱዋቴ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ቢያ ባካ ናንጊና ናንጋ ጎዳ ጋላቶንጎ!","poem":1},{"text":"ዒዚ ዓይሤም ዬይ ባካ ቢያ ማዢንቴኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኬስካ ዎዶይዳ ቢያ ላኣሚንቱዋ ዳምቤና","poem":1},{"text":"ናንጊና ናንጋንዳጉዲ ማዢ ዶዲሺ ዔያቶ ዒ ጌሤኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ባዞይዳ ዓኣ ዼኤፖ ቦዖንታ","poem":1},{"text":"ኮሺ ዔታዻ ቁልቦ ዋኣፃኣ ቢያ","poem":2},{"lineBreak":true},{"text":"ሳዓፓ ናንጊና ናንጋ ጎዳ ጋላቱዋቴ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዜኤሊንፃ፥ ዻኮ ሻጫ፥ ሻጮ ዼኤፖንታ ሻኣሮንታ","poem":1},{"text":"ዒዛኮ ዓይሢፆ ማዺ ኩንሣ ዼኤፖ ዓልጋሢ ቢያ","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ጋላቱዋቴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጌሜሮንታ ዹኮንታ","poem":1},{"text":"ዓኣፓ ሙይንታ ሚፆንታ","poem":2},{"lineBreak":true},{"text":"ዴኤሎ ካያ ዓኣ ሚፃኣ ቢያ ዒዛ ጋላቱዋቴ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ካዮ ቦዖንታ ጋራ ዓኣ ቆልሞንታ","poem":1},{"text":"ሳዖይዳ ጎቺንቲ ሃንታ ባኮንታ ጋኣዞና ባራና ባካ ቢያ","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳሢ ጋላቱዋቴ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ካኣቶንታ ሳዖይዳ ዓኣ ዴራ ቢያ","poem":1},{"text":"ቢታንታ ዓኣ ሱኡጎንታ ዎጎ ዎጋ ዓሳኣ ቢያ ዒዛ ጋላቱዋቴ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዓቲንቆ ዼጌሢንታ ዉዱራሢንታ","poem":1},{"text":"ጋርቾንታ ናኣቶንታ ቢያ ዒዛ ጋላቱዋቴ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዒዛኮ ሱንፃ ሜሌ ሱንፆ ቢያፓ ባሻሢሮ","poem":1},{"text":"ዒዛኮ ቦንቻ ሳዖና ጫሪንጮናፓ ባሼ ዼኤፒታሢሮ","poem":2},{"lineBreak":true},{"text":"ቢያሢ ናንጊና ናንጋ ጎዳ ጋላቶንጎ!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዒዛኮ ዒኖና ዎላ ቱኡቴያ ማዔ ዒዛ ዴሮ","poem":1},{"text":"ዒስራዔኤሌ ዒዚ ዼጊዲ ቦንቺሴኔ፤","poem":2},{"lineBreak":true},{"text":"ጋላታ ጋላታንዳጉዲያኣ ዒዚ ዔያቶ ማሄኔ።","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ጋላቱዋቴ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}