{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":149,"content":[{"type":"heading","content":["ጋላታ ዓይኑሞ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳ ጋላቱዋቴ!","poem":1},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳሢም ዓኪ ዓይኑሞ ኬሲ ዓይናዹዋቴ!","poem":1},{"text":"ፆኦሲ ዓሳ ቡኬ ቤዞይዳ ዒዛ ቦንቾም ዓይናዹዋቴ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዒስራዔኤሌ ማዤ ፆኦሲና ዎዛዾንጎ!","poem":1},{"text":"ፂዮኔ ዴራኣ ካኣቲሮ ኮኦሚ ዎዛዾንጎ!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዒዛ ቦንቾም ዓጊፂ ዓጊፂ ጋላቶንጎ፤","poem":1},{"text":"ካራቤ ባዒ፥ ጎኦላኣ ዋርቂ ዋርቂ ዒዛ ጋላቶንጎ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ናንጊና ናንጋ ጎዳ ፔ ዴሮ ዛጋዖ ዎዛዻኔ፤","poem":1},{"text":"ባሺሢ ዒንጊ፥ ዒኖ ሼሌዔ ዓሶ ዒዚ ቦንቺሳኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ፆኦሲ ዴራ ዬያ ቦንቺንቴ ቦንቾሮ ዎዛዾንጎ፤","poem":1},{"text":"ዋንቶ ላሄ ቤዛ ቢያ ዎዛዺ ዓይናዾንጎ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ጬንቻ ዓራፖ ዔያቶኮ ኩጫ ዓኣኔ፤","poem":1},{"text":"ዬያሮ ዔያታ","poem":2},{"lineBreak":true},{"text":"ዒላሺ ዒላሺ፥ ዼግ ጌዔ ዑኡሲና ፆኦሲ ጋላቶንጎ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዔያታ ዬያይዴቴ","poem":1},{"text":"ሜሌ ካኣቶ ባሻኒ","poem":2},{"lineBreak":true},{"text":"ሜሌ ዴሮይዳ ዼኤፒ ሜቶ ዓጋኒ፥","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዬያ ዴሮኮ ካኣቶ ካኒ ቢራታና","poem":1},{"text":"ዼኤፖ ዼኤፖ ሱኡጎዋ ዱፄና ዓርቂ ቱካኒ፥","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዔያቶይዳ ዎጌ ዎጎ ማዺ ኩንሣኒ","poem":1},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳኮ ዴራ ባሺሢ ዎልቄ ዴንቃንዳኔ።","poem":1},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ጋላቲንቶም!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}