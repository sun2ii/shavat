{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":150,"content":[{"type":"heading","content":["ናንጊና ናንጋ ጎዳ ጋላቱዋቴ!"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳሢ ጋላቱዋቴ!","poem":1},{"lineBreak":true},{"text":"ዒዛም ዱማዼ ጌኤዦ ማኣሮይዳ ፆኦሲ ጋላቱዋቴ!","poem":1},{"text":"ዒዛኮ ዲቃሢ ሄርሺሳ ዎልቃ ዓኣ ጫሪንጮይዳኣ ዒዛ ጋላቱዋቴ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዒዚ ማዼ ዲቃሢ ሄርሺሳ ማዾሮ ጋላቱዋቴ፤","poem":1},{"text":"ቤቃያ ባኣያ ማዔ ዼኤፑሞሮ ዒዛ ጋላቱዋቴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዛዬ ዋርቂ ዒዛ ጋላቱዋቴ፤","poem":1},{"text":"ጎኦላንታ ዺቢ ሻሺና ዴንሢ ዋርቆ ጎኦሎዋ","poem":2},{"lineBreak":true},{"text":"ዋርቂ ዋርቂ ዒዛ ጋላቱዋቴ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ካራቤ ባዒ ዒዛ ቦንቾም ዓጊፂ ዓጊፂ ጋላቱዋቴ፤","poem":1},{"text":"ጎኦላንታ ሹሉንጎንታ ዋርቂ ዒዛ ጋላቱዋቴ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዑኡቱቡሎ ዎሺ ዎሺ ዒዛ ጋላቱዋቴ፤","poem":1},{"text":"ዑኡዛ ኮሺ ሚዛጳ ዑኡቱቡሎናኣ ዒዛ ጋላቱዋቴ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሼምፔና ዓኣያ ማዔ ማዢንታ ቢያ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ጋላቱዋቴ!","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ጋላቲንቶም!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}