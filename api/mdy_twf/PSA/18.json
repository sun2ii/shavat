{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":18,"content":[{"type":"heading","content":["ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆና ዓይናዺንታ ፆኦሲ ዓይላሢ ዳውቴ ዓይኑሞ፤ ፆኦሲ ሳኣዖኦሌና ዒዛኮ ሞርኮናይዳፓ ዒዛ ቶሊሴያና ፆኦሲ ቦንቾም ዓይናዺንቴያኬ።"]},{"type":"hebrew_subtitle","content":["ዳውቴ ባሺሢ ዴንቃዖ ዓይናዼ ዓይኑሞ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ታኣም ዎልቄ ዒንጋሢ ኔናታሢሮ ታ ኔና ናሽካኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ናንጊና ናንጋ ጎዳ ታኣኮ ላላሢ","poem":1},{"text":"ታኣኮ ዹካሢንታ ታና ዓውሳሢያኬ፤","poem":2},{"lineBreak":true},{"text":"ታ ፆኦዛሢ ታኣኮ ዓኣሺንቶ ካያሢኬ፤","poem":2},{"lineBreak":true},{"text":"ዒዚ ታኣኮ ጊቲማሢና ጉራናሢኬ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጋላታ ኮይሳ ናንጊና ናንጋ ጎዳ ታኣኒ ሺኢቃኔ፤","poem":1},{"text":"ዒዚ ታ ሞርኮይዳፓ ታና ዓውሳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ሃይቢ ካራ ባይዚ ታና ሜታሴኔ፤","poem":1},{"text":"ባይሲንታ ዲጲያ ታና ዱኡኬኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዱኡፒ ሱሲ ታና ማሬኔ፤","poem":1},{"text":"ሃይቢ ፒሮጉዲ ታኣም ፒሪንቴኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታኣኒ ሜታዼ ዎዶና ናንጊና ናንጋ ጎዳ ዔኤሌኔ፤","poem":1},{"text":"ታና ዒ ማኣዳንዳጉዲ ታ ፆኦሲ ታኣኒ ሺኢቄኔ፤","poem":2},{"text":"ዒዚያ ፔኤኮ ጌኤዦ ማኣራ ዓኣዖ ዑኡዞ ታኣሲ ዋይዜኔ፤","poem":1},{"text":"ታኣኮ ዒላቶዋ ዒዚ ዒና ዔኬኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ሳዓ ዚምባሪ ጎጋይቄኔ፤","poem":1},{"text":"ዹኮኮዋ ፃጳ ዓጊፂፆና ኮሬኔ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ዻጋዼሢሮ ዔያታ ዓጊፄኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዒዛኮ ሲኢዻፓ ዻጎ ጩባ ኬስኬኔ፤","poem":1},{"text":"ዻንጋፓ ዒዛኮ ሙሙዓ ታሚ ሎስቶና","poem":2},{"lineBreak":true},{"text":"ሚሚቻ ቄንሢያኣ ኬስኬኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጫሪንጮ ዳርዚ ሊካ ዒ ኬዴኔ፤","poem":1},{"text":"ዒዛኮ ቶኮ ዴማ ዲም ጌዔ ሻኣሬ ዓኣኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዒዚ ኪሩቤኤሎ ዑፃ ዴይ ባራኔኔ፤","poem":1},{"text":"ዢባሮ ጋኣዞና ባራኒ ሌካ ዒ ኬስኬኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ፔና ዒዚ ዹሞና ዓኣቼኔ፤","poem":1},{"text":"ካርሤ ሻኣራኣ ዒዛ ካንቂ ዓኣኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዒዛኮ ዓኣ ፖዖፓ ዔቄያና ሻቺንታ ታሚ ፖዒንታ","poem":1},{"text":"ዲም ጌዔ ሻኣሮ ባኣኪና ሶፒ ኬስኬኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ናንጊና ናንጋ ጎዳ ጫሪንጫፓ ጉጉንሤኔ፤","poem":1},{"text":"ዼኤፖ ፆኦዛሢ ዑኡዞ ፔኤሲ ማኣሚሴኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዒዚ ሂኢዦ ፔኤሲና ዱኪ ሞርኮ ላኣሊሼኔ፤","poem":1},{"text":"ጉጉንፆ ሚርጊሺ ካራ ባይዚ ዔያቶ ዳውሴኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ኔኤኒ ኔኤኮ ሞርኮ ጎሬ ዎዶና","poem":2},{"lineBreak":true},{"text":"ዻጎ ዑኡዞ ኔኤኮ ኔ ዋይዚሴ ዎዶና","poem":2},{"lineBreak":true},{"text":"ዼኤፖ ባዞኮ ዴማ ፔጋዺ ጴዼኔ፤","poem":2},{"lineBreak":true},{"text":"ሳዖኮዋ ማዢንቶ ዓይፆ ካራ ፔጋ ኬስኬኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሎኦፓ ኩጮ ዳኪ ታና ዓርቄኔ፤","poem":1},{"text":"ሚርጌና ዔቴ ማዔ ዋኣፆፓ ጎቺ ታና ዒ ኬሴኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ታጊዳፓ ዎልቆና ባሼ ማዔ ታ ሞርኮፓ","poem":1},{"text":"ታና ዒዚ ዓውሴኔ፤","poem":2},{"lineBreak":true},{"text":"ታና ዒፃ ዓሶ ቢያሢ ኩጫፓ","poem":2},{"lineBreak":true},{"text":"ዒዚ ታና ዓይሴኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዔያታ ታኣኒ ሜታዼ ዎዶና ታኣኮ ሞርኬ ማዒ ዔቄኔ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ጋዓንቴ ታና ካፔኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዒዚ ታና ዳልጊ ቤሲ ኬሴኔ፤","poem":1},{"text":"ዒዛ ታኣኒ ዎዛሴሢሮ ዒ ታና ዓውሴኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ናንጊና ናንጋ ጎዳ ታኣም ታ ፂሉሞጉዲ ጪጋንዳኔ፤","poem":1},{"text":"ታ ጌኤሹሞጉዲያኣ ማሂ ታኣም ዒንጋንዳኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ናንጊና ናንጋ ጎዳኮ ጎይፆ ታ ሃንቴኔ፤","poem":1},{"text":"ፑርታ ባኣዚ ማዻኒ","poem":2},{"lineBreak":true},{"text":"ታ ዓኣፖ ካሮ ታ ፆኦዛሢ ቤርታፓ ሺርሺባኣሴ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዒዛኮ ዎጎ ቢያ ታኣኒ ማዺ ኩንሣኔ፤","poem":1},{"text":"ዳምቦዋ ታ ዒዛኮ ቦንቺፆ ሃሺባኣሴ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዒዚ ታና ዛጌ ጎይፆ ታኣኒ ፂሎኬ፤","poem":1},{"text":"ጎሜይዳፓ ታና ታኣኒ ካፔኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ናንጊና ናንጋ ጎዳ ታኣኮ ፂሉሞጉዴያ","poem":1},{"text":"ኩጫኣ ታኣኮ ጌኤሺ ማዔሢጉዴያ","poem":2},{"lineBreak":true},{"text":"ታኣም ኮይሳ ባኮ ዒዚ ጪጌኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔኤም ጉሙርቂንታዞም","poem":1},{"text":"ኔኤኒያኣ ጉሙርቂንታያኬ፤","poem":2},{"lineBreak":true},{"text":"ጎኔ ዓሲ ማዔዞንሢም ኔኤኒያኣ ጎኔ ማዓያኬ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ጌኤዦ ዓሶም ኔኤኒ ጌኤሺኬ፤","poem":1},{"text":"ዎቦ ዓሶም ጋዓንቴ ዔያቶም ኮይሳሢ ኔ ዒንጋኔ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዒኖ ሼሌዔ ዓሶ ኔኤኒ ዓውሳኔ፤","poem":1},{"text":"ዖቶርቃዞንሢ ጋዓንቴ ኔኤኒ ዻውሲሳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ታኣኮ ኔኤኒ ፖዓሢኬ፤","poem":1},{"text":"ታ ፆኦዛሢዮ! ዹሞ ታኣኮ ኔ ፖዒሣኔ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ኔ ዎልቆና ዖሎ ዖላ ዓሶ ባሺ ታኣኒ ሄርቄኔ፤","poem":1},{"text":"ኔ ዎልቆና ኬኤሎ ዲሮና ጱሊ ታ ጌሌኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"ፆኦሲ ጎይፃ ሃይማ ፓጬኔ ጌይሳ ባኣዚ ባኣያ ፒዜኬ!","poem":1},{"text":"ቃኣላኣ ዒዛሲ ጌኤሺኬ!","poem":2},{"lineBreak":true},{"text":"ዒዛና ካናዻ ዓሶም ዒዚ ጊቲማሢኬ።","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ናንጊና ናንጋ ጎዳፓ ዓታዛ ዖናዳይ ፆኦሲ?","poem":1},{"text":"ዒዛይዳፓ ዓታዛ ላሌ ማዓሢ ዖናዳይ?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ታኣም ዶዱሞ ዒንጋሢንታ","poem":1},{"text":"ጎይፆዋ ታኣኮ ፒዚሳሢ ፆኦሲኬ።","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ዒዚ ቶኮ ታኣኮ ዎሾ ቶኪጉዲ ዶዲሻኔ፤","poem":1},{"text":"ጌሜሮይዳ ሂርጋ ባኣያ ታና ዒዚ ዔቂሳኔ።","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ኩጮ ታኣኮ ዒ ዖልዚ ዖሎንዶ ጎይሢ ዔርዛኔ፤","poem":1},{"text":"ኩጫ ታኣኮ ሞኦኖ ዓንጎ ቆኦዞ ጎቻንዳጉዲ ዒ ዶዲሻኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"ኔኤኮ ባሺፆ ጊቲሞ ኔኤኒ ታኣም ዒንጌኔ፤","poem":1},{"text":"ኔኤኮ ሚዛቆ ኩጫኣ ታና ካፓኔ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ታና ማኣዳኒ ሙኪ ዼኤፒ ማዾ ማዼኔ።","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ታ ሃንታንዳ ጎይፆ ኔኤኒ ታኣም ዳልጊሼኔ፤","poem":1},{"text":"ቶካኣ ታኣኮ ዹቂንቲባኣሴ።","poem":2}]},{"type":"verse","number":37,"content":[{"text":"ሞርኮ ታኣኮ ታኣኒ ዳኪ ዓርቄኔ፤","poem":1},{"text":"ጋፒሲ ባይዙዋዖ ጊንሢም ታኣኒ ማዒባኣሴ።","poem":2}]},{"type":"verse","number":38,"content":[{"text":"ላሚ ጊንሣ ዔያታ ዔቁዋጉዲ ታኣኒ ዔያቶ ጋኣጬኔ፤","poem":1},{"text":"ዔያታ ታኣኮ ቶኮ ዴማኣ ሎኦሜኔ።","poem":2}]},{"type":"verse","number":39,"content":[{"text":"ዖላንዳጉዲ ዎልቄ ኔኤኒ ታኣም ዒንጌኔ፤","poem":1},{"text":"ታ ሞርኮ ታ ቶኮ ዴማ ኔኤኒ ጉምዓሤኔ።","poem":2}]},{"type":"verse","number":40,"content":[{"text":"ታ ሞርካ ጊንሢም ባሺንቲ ጳሽካንዳጉዲ ኔ ማሄኔ፤","poem":1},{"text":"ታኣኒያ ታና ዒፃዞንሢ ጋፒሲ ባይዜኔ።","poem":2}]},{"type":"verse","number":41,"content":[{"text":"ዔያቶ ማኣዳ ዓሲ ኮይ ዔያታ ዒላቴኔ፤","poem":1},{"text":"ጋዓንቴ ዔያታ ዴንቂባኣሴ፤","poem":2},{"text":"ናንጊና ናንጋ ጎዳ ባንሢ ዔያታ ዒላቴኔ፤","poem":1},{"text":"ዒዚ ጋዓንቴ ዔያቶም ዋይዚባኣሴ።","poem":2}]},{"type":"verse","number":42,"content":[{"text":"ዢባሬ ፒፂ ዔኪ ዓኣዻ ሲላሊ ማዓንዳያ ሄላንዳኣና","poem":1},{"text":"ታኣኒ ዔያቶ ጋኣጬኔ፤","poem":2},{"lineBreak":true},{"text":"ጎይሢዳ ዓኣ ዾቃሌጉዲ ታ ዔያቶ ሄርቄኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"ዋይዞ ዒፃ ዴሮይዳፓ ኔኤኒ ታና ዓውሴኔ፤","poem":1},{"text":"ዴሮ 