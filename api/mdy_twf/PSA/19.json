{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":19,"content":[{"type":"heading","content":["ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆና ዓይናዺንታ ዳውቴ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ማዢንታ ቢያ ፆኦሲኮ ቦንቾ ፔጋሲ ዔርዛያ ማዒፆ"]},{"type":"verse","number":1,"content":[{"text":"ጫሪንጫ ፆኦሲኮ ቦንቾ ኬኤዛኔ፤","poem":1},{"text":"ሳዓፓ ሌካ ዼጌ ቤዛኣ ዒዛኮ ማዾ ዒላቲ ዋይዚሳኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ፔቴ ኬላ ሜሌ ኬሎም ዬያ ኬኤዛኔ፤","poem":1},{"text":"ዋንታኣ ሄላ ዋንቶም ዔራቶ ዒዛሲ ሃይሳታኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዔያታ ጌስታ ሃይሴንታ ሙኡቺያ ባኣሴ፤","poem":1},{"text":"ዔያቶኮ ዑኡሲያ ዋይዚንቱዋሴ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ያኣዼ ማዔቴያ ዔያቶኮ ኪኢታ ዓጮ ቢያ ሄላኔ፤","poem":1},{"text":"ሳዓ ማዔ ካሮ ሄላንዳኣና ዋይዚንታኔ፤","poem":2},{"text":"ፆኦሲ ጫሪንጮይዳ ዓቢም ማኣሪ ማዤኔ።","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ዑኡቱሞ ማርካፓ ዑኡታ ኬስካሢጉዲ","poem":1},{"text":"ዓቢያኣ ጌኤሺ ማዒ ፆርቃኔ፤","poem":2},{"lineBreak":true},{"text":"ጳሺ ጳሽካ ዓሲ ሄሌሎ ጳሽካኒ ዎዛዻሢጉዲ ዎዛዻኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዓባ ፆርቃሢ ጫሪንጮኮ ዓይፆ ካራፓኬ፤","poem":1},{"text":"ሺሪ ዴንዲ ጌላሢ ባጎ ዛሎ ጋፖይዳኬ፤","poem":2},{"lineBreak":true},{"text":"ዬያኮ ሩኡጶ ዖይዻፓ ቶሊ ዓታኒ ዳንዳዓይ ባኣሴ።","poem":2}]},{"type":"heading","content":["ናንጊና ናንጋ ጎዳኮ ዎጎ"]},{"type":"verse","number":7,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዎጎኮ","poem":1},{"text":"ሃይማ ፓጬኔ ጌይሳ ባኣዚ ባኣያኬ፤","poem":2},{"lineBreak":true},{"text":"ሼምፔ ማሂ ጊንሣ ዓካሳኔ፤","poem":2},{"text":"ዓይሢፃ ዒዛኮ ጉሙርቂንታያኬ፤","poem":1},{"text":"ዔኤዮ ዓሶ ዔሮ ማሃኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳኮ ዎጋ ፒዜኬ፤","poem":1},{"text":"ዓሲኮ ዒና ዎዛሳኔ፤","poem":2},{"text":"ዓይሢፃ ዒዛኮ ጌኤሺኬ፤","poem":1},{"text":"ዓሲኮ ዓኣፒማኣ ፖዒ ማዓኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዒጊጪሢ","poem":1},{"text":"ናንጊና ናንጋ ጌኤሹሞኬ፤","poem":2},{"lineBreak":true},{"text":"ዒ ዎጋ ዎጊፃ ፔቴ ፔቴሢ ጎኔ፥ ሃሣ ፂሎኬ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዬይ ዒ ዎጋ ዎጋ ጌኤሺ ዎርቄፓ ባሼ ዋኣጌ ኬሳያኬ፤","poem":1},{"text":"ዔኤሲ ፆሎሊዳፓ ባሼ ዓኣፃያኬ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኔኤም ማዻሢ ዬይ ዎጋ ዞራኔ፤","poem":1},{"text":"ዬያ ካፒሢና ዼኤፒ ባኣዚ ዒዚ ዴንቃኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ፔ ዻቢንቲ ዴንቃ ዓሲ ባኣሴ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":2},{"lineBreak":true},{"text":"ታኣኮ ዓኣሺንቴ ዺቢንቶፓ ታና ጌኤሼ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታኣኒ ኔኤኮ ዓይላሢ ጫርቂ ማዻ ጎሞይዳፓ ታና ካፔ፤","poem":1},{"text":"ዬይ ጎማ ታና ቆሉዋጉዲ ኔኤኒ ታና ማኣዴ።","poem":2},{"text":"ኔኤኒ ያዺዴያታቴ ታኣኒ ዻቢንቲ ባኣያ ማዓንዳኔ፤","poem":1},{"lineBreak":true},{"text":"ዼኤፖ ዻቢንቶይዳፓኣ ታኣኒ ጌኤሽካንዳኔ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ታኣኮ ላላሢንታ ታና ዓውሳ ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ታኣኮ ጌኤዞንታ ዒኖ ማሊፆንታ ኔኤም ኮሽካያ ማዖንጎ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}