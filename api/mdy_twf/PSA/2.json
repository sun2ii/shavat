,{"type":"verse","number":7,"content":[{"text":"«ናንጊና ናንጋ ጎዳ ጌዔ ባኮ ዒላቲ ታ ኬኤዛንዳኔ፤","poem":1},{"text":"ዒዚ ታኣም ሂዚ ጌዔኔ፦","poem":2},{"lineBreak":true},{"text":"‹ኔኤኒ ታኣኮ ናዓሢኬ፤","poem":2},{"lineBreak":true},{"text":"ታ ኔና ሃኖ ሾዔኔ፤","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታና ሺኢቄ፤ ዴራ ቢያ","poem":1},{"text":"ኔ ቢታንቶ ዴማ ዎርቃንዳጉዲ ታ ማሃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዓጪ ማዔ ካራና ቢያ ኔ ዴኔ ማዓንዳኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዓንጊ ኮኦሎና ኔ ዔያቶ ጳርቃንዳኔ፤","poem":1},{"text":"ዓጪና ማዢንቴ ሜሄጉዲ ኔ ዔያቶ ጋኣጫንዳኔ› » ጌዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ዒንሢ፥ ካኣታ ማሊ ጶቂሡዋቴ፤","poem":1},{"text":"ዒንሢ፥ ዓጮ ዎይሣ ዓሳ ዒንሢና ዔሩዋቴ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ናንጊና ናንጋ ጎዳም ዒጊቹሞና ማዹዋቴ፤","poem":1},{"text":"ጎጋይቂ ጎጋይቂያኣ ዒዛ ቢታንቶ ዴማ ዎርቁዋቴ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዻጋ ዒዛኮ ዔኤታንዳሢኮ ቤርታ","poem":1},{"text":"ዒንሢያ ዒ ባይዙዋንቴ ቤርታ","poem":2},{"lineBreak":true},{"text":"ጎጋይቂ ጎጋይቂ ናዓሢም ዳዲ ባዑዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዒዛ ፑኖ ካይዚ ማሃዞንሢ ቢያ ዓንጂንቴያኬ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}