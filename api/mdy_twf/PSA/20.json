:"ዒዚ ማኣዳንዳሢ ታኣኒ ዔራኔ፤","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ሚዛቆ ኩጮና ዒዛ ኔኤኒ ባሺሲ","poem":2},{"lineBreak":true},{"text":"ኔኤም ዱማዼ፥ ጫሪንጫፓ ሺኢጲፆ ኔ ዒዛኮ ዋይዛንዳኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ፔቴ ፔቴ ዖሎ ዓሳ ፔኤኮ ዖሎ ሳርጌሎ ዖይቶና","poem":1},{"text":"ዓቴ ዓሳ ሃሣ ፔኤኮ ፓራሢና ሄርሺንታኔ፤","poem":2},{"text":"ኑኡኒ ጋዓንቴ ናንጊና ናንጋ ጎዳ ማዔ","poem":1},{"text":"ኑ ፆኦዛሢ ዎልቆ ጉሙርቃኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዔያታ ዹቂንቲ ሎኦማንዳኔ፤","poem":1},{"text":"ኑኡኒ ጋዓንቴ ዔቃንዳኔ፥ ዶዲያኣ ኑ ዓታንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ካኣታሢ ዒዛኮ ሞርኮ ኩጫፓ ዓውሴ፤","poem":2},{"lineBreak":true},{"text":"ኑኡኒያኣ ኔና ዔኤላ ዎዶና ኑኡም ዋይዜ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}