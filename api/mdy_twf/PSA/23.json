ና ዓኣያ ማዓንዳኔ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ማኣራ ቢያ ዎዴ ታ ናንጋንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}