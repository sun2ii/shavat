{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":26,"content":[{"type":"heading","content":["ዳውቴ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ጌኤሺ ዓሲ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ፒዙሞና ሴካ ሃንጋ ዓጊፁዋዖ","poem":1},{"text":"ኔና ጉሙርቂ ታ ናንጌሢሮ ታኣም ዎጌ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ታ ዒና ዎማዺታቴያ ዓጊሢ ዛጌ፤","poem":1},{"text":"ታኣኒ ሱኡካዻ ሱኡኮንታ ታኣኮ ማሊፆዋ ዛጊ ዔሬ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኔኤኮ ጋፑዋ ናሹማ ታ ዓኣፓፓ ባይቁዋሴ፤","poem":1},{"text":"ቢያ ዎዴ ታና ዔኪ ዓኣዻሢ ኔኤኮ ጉሙርቂንቲፆኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ጌሻ ዓሶና ዎላ ታኣኒ ላጋቲባኣሴ፤","poem":1},{"text":"ፔና ጌኤሺ ማሃ ዓሶና ዎላ ታ ሶኦሪባኣሴ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ፑርቶ ማዻ ዓሶኮ ቡኪንቶ ታኣኒ ዒፄኔ፤","poem":1},{"text":"ዬያ ዓሶና ዎላ ታ ዴዓኒያ ናሽኩዋሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ታኣኒ ጌኤሺ ማዔሢ ዔርዛኒ","poem":2},{"lineBreak":true},{"text":"ኩጮ ታኣኮ ታኣኒ ማስታኔ፤","poem":2},{"text":"ዒንጎ ባኮ ኔኤም ሺኢሾ ቤዞኮ","poem":1},{"text":"ዓጮ ታ ሺሪ ሺሪ ኔና ካኣሽካኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ጋላታ ዓይኑሞ ዓይናዺ ዓይናዺ","poem":1},{"text":"ኔ ዎልቆና ማዺንታ ዓኮ ባኮ ቢያ ታ ኬኤዛኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ኔኤኒ ናንጋ ማኣሮና","poem":2},{"lineBreak":true},{"text":"ቦንቻኣ ኔኤኮ ጴዻ ቤዞ ታ ናሽካኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሼምፓሢ ታኣኮ ሱጉፆ ላኣላ ዓሶሲና ዎላ ዔኪፖ፤","poem":1},{"text":"ናንጎዋ ታኣኮ ዓሶ ዎዻ ዓሶና ዎላ ባይዚፖ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዬያቶኮ ኩጫ ጌኔ ማዾ ማዻኒ ዔቄያ","poem":1},{"text":"ሚዛቆ ኩጫኣ ዔያቶኮ ዴሜና ዒንጎ ሚኢሼ ቡኩሳያኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ታኣኒ ታ ዛሎና ፓጬ ባኣዚባኣ ፒዜ ናንጊ ናንጋኔ፤","poem":1},{"text":"ታና ሚጪንቴ፥ ዓውሲያ ዓውሴ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ቶካ ታኣኮ ባኣሲንቲ ጊኢጌ ቤሲዳ ዔቄኔ፤","poem":1},{"text":"ሚርጌ ቡኬ ኔ ዓሶ ባኣካ ናንጊና ናንጋ ጎዳ ታ ጋላታኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}