{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":27,"content":[{"type":"heading","content":["ዳውቴ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ጋላታ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳ ታኣኮ","poem":1},{"text":"ፖዓሢና ዼኤሻሢናታሢሮ ዖናኣ ታ ዒጊጩዋሴ፤","poem":2},{"text":"ናንጊና ናንጋ ጎዳ ታ ናንጎኮ","poem":1},{"text":"ሺባሢታሢሮ ዖኦኒያ ታና ዒጊቹዋሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ፑርቶ ማዻ ዓሳ ባሺ ታና ዎዻኒ ማላኔ፤","poem":1},{"text":"ጋዓንቴ ፔኤሮ ዔያታ ዹቂንቲ ሎኦማኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሚርጌ ዖላ ዓሳ ታና ማንጌታቴያ ታኣኒ ዒጊጩዋሴ፤","poem":1},{"text":"ታኣኮ ሞርካ ታና ዖሌታቴያ","poem":2},{"lineBreak":true},{"text":"ታኣኒ ፆኦሲ ጉሙርቂፆ ሃሻዓኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ናንጊና ናንጋ ጎዳ ታኣኒ ፔቴ ባኣዚ ሺኢቃኔ፤","poem":1},{"text":"ዬና ታ ሺኢቃዛ","poem":2},{"lineBreak":true},{"text":"ታ ናንጎ ዎዶ ቢያይዳ ፆኦሲ ማኣራ ናንጋኒ","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳኮ ዲቃሢ ሄርሺሳያ ማዒፆዋ ዛጋኒ","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ጌኤዦ ማኣሮይዳኣ ሺኢቃኒ ዳንዳዓንዳጉዲኬ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሜታሢ ኬሎና ዒዚ ታና ፔ ሺቦ ዴማ ዓኣቻኔ፤","poem":1},{"text":"ዬያ ዒዛ ማኣሮኮ ጋሮይዳ ታና ዒ ጌልዚ ጌሣኔ፤","poem":2},{"lineBreak":true},{"text":"ላሌ ሹቺዳኣ ዼጊዲ ታና ዔቂሳኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሃሢ ታ ኮሮይዳ ዓኣ ታ ሞርኮ ዑፃ","poem":1},{"text":"ታኣኒ ታና ዼግ ዼጊዴኔ፤","poem":2},{"lineBreak":true},{"text":"ዎዛና ታ ዒላሺ ዒላሺ","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ጌኤዦ ማኣሮይዳ ዒንጎ ዒንጊሢ ታ ሺኢሻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዓይናዺ ዓይናዺ ናንጊና ናንጋ ጎዳ ጋላታንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ዑኡዞ ታኣኒ ዼጊዲ ዒላታኣና ኔኤኒ ዋይዜ!","poem":2},{"lineBreak":true},{"text":"ማኣሪያ ታና ማኣሬ፤ ሺኢጲፆዋ ታኣኮ ዋይዜ!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዒና ታና «ዒዛኮ ዓኣፖ ካሮ ኮዔ» ጌዔኔ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳሢዮ! ታኣኒ ኔኤኮ ዓኣፖ ካሮ ኮዓኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኔኤኮ ዓኣፖ ካሮ ታጊዳፓ ማሂፖ፤","poem":1},{"text":"ዻጋዺ ኔ ዓይላሢ፥ ታና ኔኤፓ ሃኪሲፖ፤","poem":2},{"text":"ዎይቴቴያ ኔኤኒ ታኣኮ ማኣዳሢኬ፤","poem":1},{"text":"ታና ዓውሳ ታ ፆኦዛሢዮ!","poem":2},{"lineBreak":true},{"text":"ታና ኬኤሪፖ፥ ሃሺያ ሃሺፖ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ዓዶና ታ ዒንዶና ታና ሃሼቴያ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ታ ቶኦኮ ዛጋንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ጎይፆ ኔኤሲ ታና ዔርዜ፤","poem":1},{"text":"ታኣኮ ሚርጌ ሞርኬ ዓኣሢሮ ኮሺ ጎይሢና ታና ዔኪ ዓኣዼ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሉኡዙሞና ማርካዻ ዓሳ ፑርቱሞ ጌስቲ ጌስቲ ታ ዑፃ ዔቄሢሮ","poem":1},{"text":"ታ ሞርካ ኮዓ ጎይፆ ዓኣሢ ታና ኔ ዔያቶም ዒንጊፖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ሼምፓሢና ዓኣ ዓሳ ናንጋ ሳዔሎይዳ ታ ዓኣ ዎዶና","poem":1},{"text":"ናንጊና ናንጋ ጎዳኮ ኮሹሞ ታ ዛጋንዳሢ ጉሙርቃኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ናንጊና ናንጋ ጎዳ ጉሙርቄ፤","poem":1},{"text":"ዶዴ፥ ዎዛ ቲቂፖ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ጉሙርቄ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}