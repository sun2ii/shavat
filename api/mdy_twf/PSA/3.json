{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":3,"content":[{"type":"heading","content":["ዳውቴ ፔ ናኣዚ ዓብሴሎሜፓ ቶላኒ ጳሽኬያና ዓይናዼ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ማኣዶሮ ጉቴና ሺኢቂንቴ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ሞርካ ታኣኮ ዎዚ ሚርጌዖ!","poem":1},{"text":"ዓኣፒኒ ዓሲ ታ ዑፃ ፑርቱሞና ዔቄዖ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሜርጌ ዓሳ፦ «ፆኦሲ ዒዛ ዓውሲንዱዋሴ» ጌይ ጌይ","poem":1},{"text":"ታ ዛሎ ጌስታኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔኤኒ ታኣኮ ጊቲማሢኬ፤","poem":1},{"text":"ታ ባሻንዳጉዲ ማሂ ቦንቾ ታኣም ዒንጌሢ ኔናኬ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታኣኒ ዑኡዞ ዼጊዲ ናንጊና ናንጋ ጎዳ ባንሢ ዒላታኔ፤","poem":1},{"text":"ዒዚያኣ ፔኤኮ ዱማዼ ዹኮ ዑፃ ማዒ ታ ዒላቶ ዋይዛኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ታ ላሃኔ፥ ጊንዓኔ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ዋንቶ ቢያ ታና ካፔሢሮ","poem":2},{"lineBreak":true},{"text":"ጊንዓስካፓኣ ጊንሣ ታኣኒ ጴጫኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዓጮ ታኣኮ ማንጊ ዓኣ","poem":1},{"text":"ፓይዲንቱዋ ታ ሞርኮ ታኣኒ ዒጊጩዋሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ዔቄ!","poem":1},{"text":"ታ ፆኦዛሢዮ! ሙኪ ታና ዓውሴ!","poem":2},{"lineBreak":true},{"text":"ታ ሞርኮኮ ባንጋሎ ሜንሤ፤","poem":2},{"lineBreak":true},{"text":"ዓጮዋ ዔያቶኮ ኬይሴ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዓሲ ዓውሳይ ናንጊና ናንጋ ጎዳኬ፤","poem":1},{"text":"ፆኦሲዮ! ዓንጃ ኔኤሲ ኔ ዴሮም ማዖንጎ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}