{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":30,"content":[{"type":"heading","content":["ጌኤዦ ማኣሮ ዓንጂ ማዾም ጊኢጊሾ ኬሎ ዓይናዺንቴ ዳውቴ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ጋላታ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ሂርኬ ቤዛፓ ኔ ታና ዔቂሴሢሮ","poem":1},{"text":"ታ ሞርካ ታኣኮ ሜቶና ዎዛዻንዳጉዲ ኔ ማሂባኣሢሮ","poem":2},{"lineBreak":true},{"text":"ታ ኔና ዼግ ዼጊዳኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢዮ!","poem":1},{"text":"ኔ ታና ማኣዳንዳጉዲ ታ ኔና ዔኤሌም","poem":2},{"lineBreak":true},{"text":"ኔኤኒያ ታና ፓሤኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ሼምፓሢ ታኣኮ ሄሊንቱዋያ ማዔ","poem":1},{"text":"ዹሞ ዔታፓ ኔኤኒ ኬሴኔ፤","poem":2},{"lineBreak":true},{"text":"ሊካ ዱኡፖ ዔቶ ኬዲፆይዳፓ ኔ ታና ካፔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ዒንሢ ዒዛም ጉሙርቂንታያ ማዒ ማዻዛንሢ ቢያ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ዓይኑሞና ጋላቱዋቴ!","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ዱማዼ ሱንፆማኣ ጋላታ ሺኢሹዋቴ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዒዚ ዻጋዻሢ ቃሚሢ ዎዴምኬ፤","poem":1},{"text":"ኮሹማ ዒዛኮ ጋዓንቴ ናንጊና ናንጋያኬ፤","poem":2},{"text":"ዋንቶ ዬኤኬ ጎይሣ ዎርቂንቴቴያ","poem":1},{"text":"ጉቶ ዎዎዛዺንታኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ታና ጉሙርሳ ዓሢ ታኣኒ ዔራሢሮ","poem":1},{"text":"«ፔቴታዖ ታ ባሺንታዓኬ» ጌዔኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔ ዼኤፑሞና ዹካ ታኣሲ ዶዴኔ፤","poem":1},{"text":"ኔኤኮ ዓኣፖ ካሮ ታ ጊዳፓ ኔ ማሄ ዎዶና ዒና ታኣኮ ዲቃቴኔ፤","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔና ታ ዔኤላኔ፤","poem":1},{"text":"ኔ ባንሢ ሂዚ ጌዒያ ታ ሺኢቄኔ፦","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታኣኮ ዱኡኪንቲፆና ሃይቦና ዓይጎ ኔና ማኣዳንዳይ?","poem":1},{"text":"ዓጪ ኔና ጋላታ?","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ጉሙርቂንታያ ማዔሢ ዓጫ ኬኤዛንዳ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ታኣም ዋይዜ፥ ታና ሚጪንቴ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳሢዮ! ታና ማኣዳሢ ኔና ማዔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ዖዪፆ ኔኤኒ ታኣኮ ዎዛና ላኣሜኔ፤","poem":1},{"text":"ሲዮ ፓቲሎ ኔኤኒ ታኣኮ ጉሲ","poem":2},{"lineBreak":true},{"text":"ፓልሞ ኔ ታና ማይሴኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዬያያሮ ታኣኒ ዚቲ ጋዓዓኬ፤","poem":1},{"text":"ጋላታ ዓይኑሞ ኔኤም ታ ዓይናዻንዳኔ፤","poem":2},{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔኤኒ ታ ፆኦዛሢኬ፤","poem":1},{"text":"ዬያሮ ናንጊና ታኣኒ ኔና ጋላታንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}