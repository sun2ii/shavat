},{"type":"verse","number":5,"content":[{"text":"ጎኑሞ ፆኦሲ ማዔ ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ታኣኮ ሼምፓሢ ታ ኔኤም ሃሼኔ፤","poem":2},{"lineBreak":true},{"text":"ታና ኔኤኒ ዓውሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ዔኤቢ ፓሡዋያ ማዔ ሜሌ ፆኦዞም","poem":1},{"text":"ዚጋዞንሢ ቢያ ኔኤኒ ዒዒፃኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ጋዓንቴ ኔና ጉሙርቃኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኔኤኮ ናንጊና ናንጋ ናሹማ ታና ዎዎዛሳኔ፤","poem":1},{"text":"ሚርጌናኣ ታ ዎዛዻኔ፤","poem":2},{"text":"ሜታሢ ኔ ታኣኮ ዛጌኔ፥ ዋኣዪፆዋ ታኣኮ ኔ ዔራኔ።","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ሞርኮም ዓኣሢ ኔ ታና ዒንጊባኣሴ፤","poem":1},{"text":"ጋዓንቴ ኔኤኒ ታኣም ዳልጊ ጎይሢ ጲሼኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ታኣኒ ሜቶይዳታሢሮ","poem":1},{"text":"ታና ሚጪንቴ፤","poem":2},{"text":"ዓኣፓ ታኣኮ ዖዪፆና ላቤኔ፤","poem":1},{"text":"ሼምፓሢንታ ዑፆንታ ታኣኮ ዶጬኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታኣኮ ናንጋ ሜቶና፥ ሌዓኣ ታኣኮ ዚኢሊንቲሢና ጋፔኔ፤","poem":1},{"lineBreak":true},{"text":"ሜታ ታኣኮ ሚርጌሢሮ ዎልቄ ታኣኮ ባይቄኔ፤","poem":1},{"text":"ሜጌፃኣ ታኣኮ ላቤኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ታኣኒ ታኣኮ ሞርኮም ሚኢቺ","poem":1},{"text":"ታኣኮ ዓሺኖማኣ ዲቃሣያ","poem":2},{"lineBreak":true},{"text":"ታና ዔራ ዓሶም ታኣኒ ዒጊቻያ","poem":2},{"lineBreak":true},{"text":"ጎይፃ ታና ዔያታ ዴንቃዖ ታ ጋይቴ ዓዓኣሺንታኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዓዳ ሃይቄ ዓሲጉዲ ታኣኒ ዋሊንቴኔ፤","poem":1},{"text":"ሃይቄም ኬኤሮና ቦኦቆና ዖቲናጉዲ ታ ማዔኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሚርጌ ዓሲ ካሽካሻንቴ ታኣኒ ዋይዜኔ፤","poem":1},{"text":"ጉቤ ባንፆና ዒጊቻያ ማዔኔ፤","poem":2},{"text":"ታና ባይዛኒ ዔያታ ዎሊና ጌስታኔ፤","poem":1},{"text":"ዎዻኒያ ዎላ ዔያታ ዞርታኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔኤኒ ታኣኮ ፆኦዛሢኬ፤","poem":1},{"text":"ታኣኒ ኔና ጉሙርቃኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታኣኒ ቢያ ዎዴ ኔ ኩጫኬ፤","poem":1},{"text":"ታኣኮ ሞርኮና ዒፂ ታና ዳውሳዞንሢናፓ ቢያ ታና ዓውሴ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኔኤኮ ዓይላሢ፥ ታና ጌኤሺ ዓኣፒ ካራና ዛጌ፤","poem":1},{"text":"ኔኤኮ ጋፑዋ ናሹሞና ታና ዓውሴ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ታኣኒ ኔና ዔኤላ ዎዶና ኔ ታና ቦርሲሲፖ፤","poem":2},{"text":"ፑርቶ ማዻ ዓሳ ጋዓንቴ ቦርሲንቶንጎ፤","poem":1},{"text":"ዔያታ ዓጊፁዋያ ማዒ ሊካ ዹሞ ዔታ ሎኦሞንጎ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ፂላሢዳ ዔያታ ሆኦሊንቲሢና ዖቶርሙሞና ጌስታሢሮ","poem":1},{"text":"ዔያቶኮ ሉኡቃ ዻንጎ ዚቲዴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ኔ ዴማ ዓታኒ ኔ ባንሢ ዑካዞንሢም","poem":1},{"text":"ዓሶ ቢያ ቤርታ ኔ ዒንጋ","poem":2},{"lineBreak":true},{"text":"ኔና ዒጊጫዞንሢም ኔ ጊኢጊሼ ኮሹማ","poem":2},{"text":"ዎዚ ዼኤፓይ!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ዓሳ ዔያቶ ባይዛኒ ዞርታሢዳፓ ኔ ማኣሮ ዴማ ኔ ዔያቶ ዓኣቼኔ፤","poem":1},{"text":"ማርማሢዳፓ ዔያቶ ዓውሳኒ ኔ ኬኤፆ ጋሮ ኔ ዔያቶ ጌልዜኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ማንጊንቴ ካታሜሎ ጋራ ታኣኒ ዓኣንቴ","poem":1},{"text":"ዲቃሢ ሄርሺሳ ናሹሞ ኔኤኒ ታና ዻዌኔ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ዓንጂንቶንጎ!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ታኣኒ ሚርጌና ዲቃቴሢሮ","poem":1},{"text":"ኔ ዓኣፓፓ ኔ ታና ጋፒ ሂዔያ ታኣም ማሌኔ፤","poem":2},{"text":"ጋዓንቴ ታ ኔ ባንሢ ማኣዳሢ ኮዒ ዒላታዛ","poem":1},{"text":"ዒላቶ ኔ ታኣሲ ዋይዜኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ዒንሢ ዒዛም ዱማዼ ዓሳ ቢያ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ናሽኩዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዒዚ ጉሙርቂንታዞንሢ ካፓኔ፤","poem":2},{"lineBreak":true},{"text":"ዖቶርቃዞንሢም ጋዓንቴ ሜቶ ዒ ዓጋኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዒንሢ ናንጊና ናንጋ ጎዳ ሃጋኣ ዎዛ ማሂ ጌሣ ዓሳ ቢያ","poem":1},{"text":"ዒጊጪፖቴ፤ ዒናኣ ዒንሢኮ ዶዶንጎ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}