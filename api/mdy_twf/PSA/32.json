":"line_break"},{"type":"verse","number":6,"content":[{"text":"ዬያሮ ፂሎ ዓሲ ቢያ ሜቶ ዎዴና ኔና ሺኢቆንጎ፤","poem":1},{"text":"ዎልቄና ዓኣ ዶዲ ዲጲ ኩሚ ሙካ ዎዶና","poem":2},{"text":"ዬይ ዲጳ ዒዛ ዔኤቢ ዎኦታዓኬ።","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ኔኤኒ ታኣኮ ፑኖ ካያሢኬ፤","poem":1},{"text":"ሜታስካፓ ኔ ታና ካፓንዳኔ፤","poem":2},{"text":"ኔኤኒ ታና ዓውሴሢሮ ዒላቲ ዎዛና ታኣኒ ዓይናዻኔ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳ ታኣም፦ «ታኣኒ ኔና ዔርዛንዳኔ፤","poem":1},{"text":"ኔኤኒ ሃንታንዳ ጎይፆዋ ታ ኔና ዻዋንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ታ ኔና ዞራንዳኔ፥ ካፒያ ካፓንዳኔ» ጌዔኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዔያቶ ዓርቂ ቃዛኒ፥ ቢፃልቂያ ጫኣናኒ","poem":1},{"text":"ጎቺ ዓኣዾ ፓሮና ባቁሎናጉዲ","poem":2},{"lineBreak":true},{"text":"ጊኢጉዋያ ማዒፖቴ።","poem":2},{"lineBreak":true},{"text":"ፓሮና ባቁሎና ዒንሢ ዬያይዲባኣቴ","poem":2},{"lineBreak":true},{"text":"ዒንሢ ባንሢ ዑካዓኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ጎሞ ዓሶኮ ሜታሢ ሚርጌኬ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ጉሙርቃ ዓሳ ጋዓንቴ","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ናንጊና ናንጋ ናሹሞና ካንቂንታንዳኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ፂሎ ዓሲዮቴ! ናንጊና ናንጋ ጎዳና ዎዛዹዋቴ፤","poem":1},{"text":"ዒኖ ፒዜዞንሢዮቴ! ዒላሹዋቴ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}