:1},{"text":"ናንጊና ናንጋ ጎዳኣ ዒዛኮ ዬያ ዋይዜኔ፤","poem":2},{"lineBreak":true},{"text":"ሜታሢዳፓኣ ቢያ ዒዛ ዓውሴኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ናንጊና ናንጋ ጎዳኮ ኪኢታንቻሢ","poem":1},{"text":"ፆኦሲ ዒጊጫ ዓሶኮ ዓጮ ማንጊ ዔቂ ካፓኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶኮ ኮይላ ማዒ ፑርታ ሜቶይዳፓ ዓውሳኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳኮ ኮሹሞ ሂንዳ ዛጉዋቴ፤","poem":1},{"text":"ዒዛ ፔኤኮ ጊቲማ ማሃ ዓሳ ዓንጂንቴያኬ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዒንሢ ዱማዼ ዓሳ ዒዛ ዒጊጩዋቴ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ዒጊጫ ዓሶም ፓጫ ባኣዚ ባኣሴ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዞባ ካራ ባይዛኒና ናይዺንታኒያ ዳንዳዓኔ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ኮዓዞንሢም ጋዓንቴ","poem":2},{"lineBreak":true},{"text":"ኮሺ ባኣዚ ፔቴታዖ ፓጫዓኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ታ ናይዮቴ! ሃኒ ሙኪ ዋይዙዋቴ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ዒጊጮንዶ ጎይሢ ታ ዒንሢ ዔርዛንዳኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዒንሢዳፓ ናንጊ ናንጋኒ ናሽካያና","poem":1},{"text":"ሚርጌ ዎዴ ኮሺ ባኣዚ ዛጋኒ ኮዓሢ ዖናዳይ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ያዺ ማዔቴ ዻንጎ ኔኤኮ ፑርታ ባኣዚ ጌስቱዋጉዲ ዓርቄ፤","poem":1},{"text":"ዒንዲርዛ ኔኤኮ ሉኡዙሞ ባኣዚ ጌስቱዋጉዲ ካፔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ፑርታ ባኣዚዳፓ ሺኢኬ፤","poem":1},{"text":"ኮሺ ባኣዚ ማዼ፤","poem":2},{"lineBreak":true},{"text":"ኮሹሞ ኮዔ፥ ጊንፆማ ዒዞኮ ዓኣዼ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ናንጊና ናንጋ ጎዳሢኮ ዓኣፓ ፂሎንሢ ባንሢ ዛጋኔ፤","poem":1},{"text":"ዋያ ዒዛሲ ዒላቶ ዔያቶኮ ዋይዛኒ ቡሊንቴያኬ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሳዓፓ ዔያቶ ማሊሲ ጶቂሣ ባኣዚ ባይዛኒ","poem":1},{"text":"ዓኣፓ ዒዛኮ ፑርቶ ማዻዞንሢዳኬ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ፂሎ ዓሳ ዒላታዛ ናንጊና ናንጋ ጎዳ ዋይዛኔ፤","poem":1},{"text":"ዔያቶኮ ዓኣ ሜታስካፓ ዒ ዔያቶ ዓውሳኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዒኖ ሜቂ ማላዞንሢም ዑኬኬ፤","poem":1},{"text":"ካራ ባይቂ ማላዞንሢያ ዒ ዓውሳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ፂሎ ዓሶኮ ሜታ ሚርጌኬ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ጋዓንቴ ዬያ ቢያይዳፓ ዔያቶ ዓውሳኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዔያቶኮ ሜጌፆ ቢያ ዒ ካፓሢሮ","poem":1},{"text":"ዬያቶይዳፓ ፔቴ ሜጌሢታዖ ሜቁዋሴ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ፑርቶ ማዻ ዓሶ ፑርቱማ ዎዻኔ፤","poem":1},{"text":"ኮዦ ዓሶ ዒፃ ዓሳ ሜቶ ዛጋንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዒዛም ማዻዞንሢኮ ሼምፓሢ ዓውሳንዳኔ፤","poem":1},{"text":"ዒዛ ጉሙርቃ ዓሶ ፑርታ ባኣዚ ሄላዓኬ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}