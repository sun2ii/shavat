{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":35,"content":[{"type":"heading","content":["ዳውቴ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ሜታዼ ዓሲ ሺኢቄ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ታና ዒፂ ማካ ዓሶ ኔ ማኬ፤","poem":1},{"text":"ታና ዖላ ዓሶዋ ኔኤኒ ዖሌ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኔኤኮ ዖሎ ዓንጋሞንታ ጊቲሞንታ ዓርቄ፤","poem":1},{"text":"ሙኪያ ታና ማኣዴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዒፂ ታና ዳውሳ ዓሶም","poem":1},{"lineBreak":true},{"text":"ኔኤኮ ዎርፆንታ ጬንቾ ዓፓሮንታ ቱጊ","poem":1},{"text":"«ታኣኒ ኔና ዓውሳሢኬ» ጌዒ ጎናሲ ኬኤዜ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ታና ዎዻኒ ኮዓዞንሢም ቢያ","poem":1},{"text":"ቦርሲንቲና ዻውሲንቲና ማዖንጎ!","poem":2},{"text":"ታኣም ፑርታ ማዻኒ ዎሊና ዞርታዞንሢ ቢያ","poem":1},{"text":"ዻውሲንቲ ጊንሢም ማዖንጎ!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ናንጊና ናንጋ ጎዳኮ ኪኢታንቻ ዔያቶ ዳውሳኣና","poem":1},{"text":"ዢባሬ ፒፂ ዔኪ ዓኣዻ ዱባጉዲ ዔያታ ማዖንጎ!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ናንጊና ናንጋ ጎዳኮ ኪኢታንቻ ዔያቶ ዳውሳኣና","poem":1},{"text":"ጎይፃ ዔያቶሲ ዹሜያና ሃሊፃያና ማዖንጎ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ታኣኒ ዔኤቢ ፑርቲሴ ባኣዚ ባኣንቴ","poem":1},{"text":"ፒሮ ዔያታ ታኣም ዓኣቺ ፒሬኔ፤","poem":2},{"lineBreak":true},{"text":"ታና ሎንሣኒ ዔቴያ ቦኦኬኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዔያታ ማሊባኣ ባይሲንታ ዔያቶ ሄሎም፤","poem":1},{"text":"ዔያታ ዓኣቼ ፒራሢ ዔያቶ ዓርቆም፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ቦኦኬ ዔቶይዳ ፔኤሮ ሎኦሞንጎ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ሼምፔላ ታኣኮ ናንጊና ናንጋ ጎዳሢና ዎዛዻኔ፤","poem":1},{"text":"ዒዚ ዓውሴሢሮ ሚርጌና ዎዛዻኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔኤኒ ማዤ ታኣኮ ዑፃ፦","poem":1},{"text":"«ሄርቂንቲ ዎርቃ ዓሶ ሄርቃ ዓሶይዳፓ ዓውሳያ","poem":2},{"lineBreak":true},{"text":"ማንቆ ዓሶንታ ሜታዻ ዓሶንታ ቡራ ዓሶይዳፓ ካፓያ","poem":2},{"lineBreak":true},{"text":"ኔጉዴያ ዖኦኒ ዓኣይ?» ጋዓኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ፑርቶ ዓሳ","poem":1},{"text":"ታኣኒ ማዺባኣ ዻቢንቲሮ ዎጌና ታና ዓይሢሴኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ዔሩዋ ባኣዚ ሉኡዙሞና ታ ዑፃ ማርካዼኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታኣኒ ኮሺ ማዼሢ ዛሎ ፑርታ ታኣም ዔያታ ማሄኔ፤","poem":1},{"text":"ታና ታኣሮ ሌሊ ማሂ ዔያታ ሃሼኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታኣኒ ጋዓንቴ ዔያታ ሃርጊንቴ ዎዶና ሲዬ ፓቲሌ ማይንቴኔ፤","poem":1},{"text":"ታኣኮ ዑፆዋ ሙዖ ሃሾ ዳምቦና ታ ዖኦፒሴኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ሺኢቄ ሺኢጲፃ ዋይዚንቱዋያ ማዒ ዓቴኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታኣኒ ዖዬ ዖዪፃ","poem":1},{"text":"ታኣኮ ላጌም ጊንሣ ሃሣ ጌርሲም ዖያያጉዲኬ፤","poem":2},{"text":"ዒንዳ ሃይቄ ዓሲ ዖያሢጉዲ","poem":1},{"text":"ታኣኒ ሱሊ ዴዒ ዬኤኬኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ታኣኒ ዹቂንቴ ዎዶና ዔያታ ዎዛና ቡኬኔ፤","poem":1},{"text":"ታኣኒ ዔሩዋ ጌኔ ማዻ ዓሲ ሙኪ","poem":2},{"lineBreak":true},{"text":"ታና ሚኢጫዖ ጋፒ ዒፄኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ፑርቶ ማዻ ዓሳ ማዻ ጎይፆ","poem":1},{"text":"ፑርቱሞና ታና ሚኢጪ","poem":2},{"lineBreak":true},{"text":"ሃኣሚያ ታኣም ዔያታ ዻዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ዎማ ሄላንዳኣና ዚቲዮ ጌይ ኔ ታና ዛጋይ?","poem":2},{"text":"ዔያቶኮ ፑርቶ ማዻፓ ታና ዓውሴ፤","poem":1},{"text":"ሃንሢ ዞቦጉዲ ቂኢሮንሢዳፓ ኔ ታና ካፔ!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሚርጌ ቡኬ ኔ ዴሮ ባኣካ ታኣኒ ኔና ጋላታንዳኔ፤","poem":1},{"text":"ዬያ ቡኬ ዓሶ ቤርታ ታ ኔና ቦንቻንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ዔኤቢ ማዺንቴ ባኣዚ ባኣንቴ ታና ዒፃ ታ ሞርካ","poem":1},{"text":"ታ ሜቶ ዛጊ ዎዛዻንዳጉዲ ማሂፖ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ታና ዓኣፒ ዎዺ ዓማሊ ሺራንዳጉዲ ሃሺፖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ዔያታ ጌስታ ጌኤዛ ሞርኬ ጌስታንዳ ጌኤሲኬ፤","poem":1},{"text":"ኮሺ ዓሲ ዑስካ ጌኔ ማሊሢ ማሊ ዔያታ ቱካኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"«ሂዮ! ቃራ!","poem":1},{"text":"ኑኡኒ ኑ ቶኦኪና ኔ ማዼሢ ዛጌኔ!»","poem":2},{"lineBreak":true},{"text":"ጌዒ ጌዒ ዒላቲና ቶኦኪ ዔያታ ታኣኮ ባይዜኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ኔኤኒ ዬያ ዛጌኔ፤","poem":2},{"text":"ዬያሮ ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ኔኤኒ ዚቲዮ ጌዒፖ! ታ ኮራፓኣ ሃኪፖ!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ታኣኮ ናንጊና ናንጋ ጎዳ ማዔ ፆኦዛሢዮ!","poem":1},{"text":"ታ ዛሎ ኔኤኒ ሞኦቲንቴ፤","poem":2},{"lineBreak":true},{"text":"ዎጊያ ታኣም ዎጌ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዔ ታ ፆኦዛሢዮ!","poem":1},{"text":"ኔኤኮ ፂሉሞጉዴያ","poem":2},{"lineBreak":true},{"text":"ጎኑሞና ታኣም ዎጌ፤","poem":2},{"lineBreak":true},{"text":"ታ ሞርካ ታ ሜቶና ዎዛዻንዳጉዲ ማሂፖ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"«ሂዮ! ቃራ! ኑ ማሊፆጉዲ ማዔኔ!» ጌዒ ዔያታ ማላንዳጉዲ","poem":1},{"text":"ጊንሣ ሃሣ «ኑኡኒ ዒዛ ባሼያንቴ!» ኔኤኒ ዔያቶ ጌይሲፖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ታና ሄሌ ሜታሢና ዎዛዺ ቶኦቺሢና ዛጋ ዓሳ ቢያ","poem":1},{"text":"ቦርሲንቶንጎ፥ ዔርቶ ዒፂ ካራ ዔያቶም ባይቆንጎ፤","poem":2},{"text":"ታ ዑፃ ፔና ዼግ ዼጊዳዞንሢ ቢያ","poem":1},{"text":"ቦርሲንቲ ዻውሲንቶንጎ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ታኣኮ ባሺፃ ዎዛሳ ዓሳ ቢያ ዎዛዾንጎ፤","poem":1},{"text":"«ናንጊና ናንጋ ጎዳ ዼኤፒኬ!","poem":2},{"lineBreak":true},{"text":"ዒዛም ማዻ ዓይላሢም ዔባ ቢያ ጊኢጋዛ","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳኣ ዎዎዛሳኔ!» ጎዖንጎ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ታኣኮ ዻንጋ ሮኦሮ ጉቤ","poem":1},{"text":"ኔኤኮ ፂሉሞና ጋላቶና ዛላ ኬኤዛኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}