{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":36,"content":[{"type":"heading","content":["ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆና ዓይናዺንታ ፆኦሲ ዓይላሢ ዳውቴ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ጎሞ ዓሶኮ ፑርቱሞና ፆኦሲኮዋ ኮሹሞ"]},{"type":"verse","number":1,"content":[{"text":"ፑርታ ባኣዚ ማዻ ዓሲ ፔ ዒኖና ዬያ ፑርቱሞ ማላኔ፤","poem":1},{"text":"ፆኦሲ ዒጊጩዋሴ፥ ቦንቺያ ቦንቹዋሴ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ፑርቶ ማዻ ዓሢ ዒዛኮ ፑርቱማ ሳልማሳሢሮ","poem":1},{"text":"ፔኤኮ ጎሞ ዛጋኒታቴያ ዒፃኒ ኮዑዋሴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጌኤዛ ዒዛኮ ጌኔ ማሊሢና ሉኡዙሞና ኩሜያኬ፤","poem":1},{"text":"ማሊ ጶቂሥሢና ኮሺ ባኣዚ ማዺሢያ ዒዛ ባሼኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ላሄ ቤዛ ዓኣዖ ጌኔ ባኣዚ ማሊ ቱካኔ፤","poem":1},{"text":"ፔና ዒ ፑርታ ጎይሢ ዔኪ ዓኣዻኔ፤","poem":2},{"lineBreak":true},{"text":"ፑርቱሞ ባኮዋ ፔ ኮራፓ ሃኪሱዋሴ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ኔኤኮ ናንጊና ናንጋ ናሹማ ጫሪንጮ","poem":2},{"lineBreak":true},{"text":"ጎኑማኣ ኔኤኮ ሻኣሮ ዴንዲ ሄላኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ዓሶንታ ቆልሞንታ ሜቶይዳፓ ኔኤኒ ዓውሳኔ፤","poem":2},{"text":"ፂሉማ ኔኤሲ ዓዳ ዹኮጉዲ ኮሺ ዼግ ጌዔያኬ፤","poem":1},{"text":"ኔኤኮ ዎጋ ባዚ ዔታዻጉዲ ዔታዻያኬ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ፆኦዛሢዮ!","poem":1},{"text":"ኔኤኮ ናንጊና ናንጋ ናሹማ ዎዚ ቦንቺንታያዳይ!","poem":2},{"lineBreak":true},{"text":"ዓሶ ኔኤኒ ካፓሢሮ ኔ ዴማ ካፒንቲ ዴዓኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኔ ማኣራ ጊዲ ዑሣ ዓኣዻ ሙኡዚ ዔያታ ሙዓኔ፤","poem":1},{"text":"ኔኤኮ ዎዛሳ ዎራፓ ዋኣፆ ዔያቶ ኔ ዑሻኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኔኤኒ ናንጊኮ ቢያ ዓልቃ ካራኬ፤","poem":1},{"text":"ኔኤኮ ፖዓ ፖዓሢሮ ኑ ዛጋኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ኔና ዔራዞንሢም ናንጊና ናንጋ ናሹማ ኔኤኮ ጋፖፓ፤","poem":1},{"text":"ዓውሲፃኣ ኔኤኮ ዒኖ ፒዜዞንሢም ጋፑዋያ ማዖንጎ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዖቶርቃ ዓሶኮ ቶካ ታና ሄርቃንዳጉዲ","poem":1},{"text":"ፑርቶ ማዻ ዓሳ ዎልቃዺ ታና ዳውሳንዳጉዲ","poem":2},{"lineBreak":true},{"text":"ታና ሃሺፖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ፑርቶ ማዻ ዓሳ ዎማይዲ ሎኦሚ ላሄቴያ ዛጌ!","poem":1},{"text":"ዔያታ ኬኤሪንቴኔ፥ ዔቃኒያ ያፓ ዳንዳዑዋሴ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}