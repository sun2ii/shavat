{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":39,"content":[{"type":"heading","content":["ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆና ዔዶታሜ ዛሎ ዓይናዺንቴ ዳውቴ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ዓሲ ሜታ ሄላዛ ዔልቃሚጉዲ ሺኢቃ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ታኣኒ፦ «ታ ማዾንታ ዒንዲርዞዋ ጎሜፓ ካፓንዳኔ፤","poem":1},{"text":"ፑርቶ ማዻ ዓሳ ታ ኮራ ዓኣ ዎዶና ዻንጎ ታኣኮ ታ ቢፃልቃንዳኔ»","poem":2},{"text":"ጌዒ ታ ጫኣቄኔ።","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ዻንጋ ባይቄ ዓሲጉዲ ዚቲ ታ ጌዔኔ፤","poem":1},{"text":"ኮሺ ባኣዚ ጌስታኒታዖ ዻንጎ ታኣሲ ታ ዓርቄኔ፤","poem":2},{"lineBreak":true},{"text":"ዬይ ያዺ ማዔታቴያ ሜታሢ ታኣኮ ሃቺም ሚርጌኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዒና ታኣኮ ጋራ ዖይዼኔ፤","poem":1},{"text":"ማሊፆ ታ ማሌሢሮ ዬይ ታማ ዔኤቴኔ፤","poem":2},{"lineBreak":true},{"text":"ዬካፓ ዻንጎ ቡሊ ሂዚ ጌይ ታ ኬኤዜኔ፦","poem":2}]},{"type":"verse","number":4,"content":[{"text":"«ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ናንጎኮ ታኣኮ ጋፒንፆ ሌዖኮዋ ፓይዶ ታና ዔርዜ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ዓኣዻያና ባይቃያ ማዔሢ ታ ዔሮም።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«ሃይሾ ታኣኒ ናንጋንዳ ዎዶ ኬኤላና ዋርቂ ኔ ዛጊ ሃሼኔ፤","poem":1},{"text":"ታኣኒ ናንጋ ሌዓ ኔ ቤርታ ዔኤቢ ማዒ ፓይዲንቱዋሴ፤","poem":2},{"lineBreak":true},{"text":"ጎኔና ዓሲኮ ናንጊ ቢያ ዓዳ ሱኡሌጉዴያኬ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዓሲ ናንጊ ሺቢዳፓ ዱማቱዋሴ፤","poem":1},{"text":"ጉሪ ላቢንታኔ፥ ቆሎዋ ቡኩሳኔ፤","poem":2},{"lineBreak":true},{"text":"ጋዓንቴ ዬይ ቆላ ዖኦም ማዓንዳቴያ ዔሩዋሴ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ሂዴቴ ታኣኮ ሃጊ ማዓ ዎዛሢ ዖናዳይ?","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳቱዋዓዳ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታኣኮ ጎማፓ ቢያ ታና ዓውሴ፤","poem":1},{"text":"ዔቦ ዔሩዋ ዓሶም ሚኢቺ ታና ማሂፖ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሃያ ቢያ ማዼሢ ኔናታሢሮ","poem":1},{"text":"ታኣኒ ዚቲዮ ጋዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዻንጎዋ ታኣኮ ታ ቡላዓኬ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ቃሶ ኔኤኮ ታ ዑፃፓ ዔቂሴ፤","poem":1},{"text":"ኩጫ ኔኤኮ ታና ጳርቄሢሮ ሚርጌና ታ ላቤኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዓሶ ዔያቶኮ ጎሞ ዛሎሮ ሜታሳኒ፥ ኔ ዔያቶ ጎራኔ፤","poem":1},{"text":"ቆሎዋ ኔ ዔያቶኮ ቢሎና ባይዛኔ፤","poem":2},{"lineBreak":true},{"text":"ጎኔና ዓሲኮ ናንጊ ሱኡሌይዳፓ ባሼቱዋሴ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ሺኢጲፆ ታኣኮ ዋይዜ፥ ዒላቶዋ ዔኬ፤","poem":2},{"lineBreak":true},{"text":"ታ ዬኤካኣና ዑኬና ታና ማኣዴ፤","poem":2},{"lineBreak":true},{"text":"ዻካ ዎዴም ታ ኔኤኮ ሾኦቺኬ፤","poem":2},{"text":"ታኣኒ ታኣኮ ቤርታኣ ዓዶንሢጉዲ ቤሲባኣያ ማዒ ናንጌያኬ።","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ሃይቂ ታኣኒ ማዑዋ ቤዞ ዓኣዻንዳሢኮ ቤርታ","poem":1},{"text":"ሃዳራ ታ ዎዛዻንዳጉዲ ዻካ ታኣም ጌዔቴራ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}