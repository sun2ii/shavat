{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":41,"content":[{"type":"heading","content":["ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆና ዓይናዺንታ ዳውቴ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ዓሲ ሃርጊንታዖ ሺኢቃ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ማንቆ ዓሶ ማኣዳ ዓሳ ዓንጂንቴያኬ፤","poem":1},{"text":"ዔያታ ሜታዼ ዓቦና ናንጊና ናንጋ ጎዳ ዔያቶ ማኣዳኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዒዚ ዔያቶ ካፓኔ፤","poem":1},{"text":"ሼምፔናኣ ጌሣኔ፤","poem":2},{"lineBreak":true},{"text":"ሳዖይዳ ዔያቶ ዓንጃኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶኮ ሞርኮማኣ ዓኣሢ ዒንጉዋሴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሃርጊንቲ ዔያታ ላሃዛ ናንጊና ናንጋ ጎዳ ዔያቶ ማይሣኔ፤","poem":1},{"text":"ፓሢያ ዔያቶ ፓሣኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ታኣኒያ፦ «ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ታ ዻቤሢሮ ታና ሚጪንቲ ማኣሬ፤","poem":2},{"lineBreak":true},{"text":"ሃርጎይዳፓኣ ታና ፖዒሴ» ጌዔኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ታ ሞርካ ታ ዑፃ ፑርቱሞ ጌስታዖ፦","poem":1},{"text":"«ዓይዲ ዒዚ ሃይቃንዳይ?","poem":2},{"lineBreak":true},{"text":"ሱንፃ ዒዛኮ ሳዖይዳፓ ዋሊንታንዳሢ ዓይዲ ናንዳይ» ጋዓኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታና ዔያታ ዖኦጫኒ ሙካሢ ዒናፓቱዋሴ፤","poem":1},{"text":"ታ ዑፃ ፑርታ ባኣዚ ጌስታኔ፤","poem":2},{"lineBreak":true},{"text":"ዱማ ዱማ ቤዞ ሃንቲ ሃንቲ ሱንፆ ዔያታ ታኣኮ ፑርቲሳኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሞርካ ታኣኮ ዎላ ፔቴ ማዒጋፓ ታ ዑፃ ካሽካሻኔ፤","poem":1},{"text":"ፑርታ ታና ሄላንዳጉዲ ፑርቱሞ ማላኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዔያታ ማላዖ፦ «ዒዚ ሃርጊንቲ ሃይቃኒ ዑኬኔ፤","poem":1},{"text":"ማይ ላሄ ቤዛፓ ዒዚ ዔቃዓኬ» ጋዓኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታኣኮ ካሦ ታኣና ዎላ ሙዔሢ","poem":1},{"text":"ታ ጉሙርቃ ዑኬ ማዔ ላጋሢ","poem":2},{"lineBreak":true},{"text":"ዬይያ ዓቱዋዖ ሞርኬ ማዒ ታ ጊዳ ዔቄኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔኤኒ ጋዓንቴ ታና ሚጪንቴ፤","poem":1},{"text":"ታ ሞርኮ ኮሜ ታ ኮፃንዳጉዲ ታና ፓሤ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ሞርካ ታና ባሺፆና ዎዛዺ ዴዒንዱዋሴ፤","poem":1},{"text":"ዬያና ኔኤኒ ታና ናሽካያ ማዔሢ ታ ዔሬኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታኣኮ ፂሉሞሮ ኬልቂ ኔ ታና ዓርቄኔ፤","poem":1},{"text":"ናንጊና ኔ ኮራ ኔኤኒ ታና ናንጊሻንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ናንጊና ናንጊ ሄላንዳኣና","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ጋላቲንቶንጎ!","poem":2},{"lineBreak":true},{"text":"ዓኣሜን! ዓኣሜን!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}