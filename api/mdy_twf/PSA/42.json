{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":42,"content":[{"type":"heading","content":["ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆና ቆሬ ናኣታ ኬኤዚ ዔርዜ ባኮ"]},{"type":"hebrew_subtitle","content":["ዒፂ ዳውሶ ዎዴና ሺኢቆ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ሮኦቶ ዼኤቢንቲ ዓልቃ ዋኣሢ ዴንቃኒ ኮዓሢጉዲ","poem":1},{"text":"ፆኦሲዮ! ታ ሼምፓሢያ ኔና ዴንቃኒ ዼኤቢንቲ ኮዓኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታ ሼምፓሢ ፆኦሲ፥ ናንጊና ባይቁዋ ፆኦዛሢ ዼኤቤኔ፤","poem":1},{"text":"ዓይዲ ታኣኒ ሄሊ ፆኦሲኮ ዓኣፖ ካሮ ዛጋንዳይ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዓሳ ቢያ፦ «ፆኦዛሢ ኔኤኮ ዎካዳዖ?» ጋዓ ዎዶና","poem":1},{"text":"ዓቢፃ ታኣኮ ሮኦሮንታ ዋንቶዋ ሙኡዚ ማዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ታኣኒ ዓሶኮ ዓርና ማዒ","poem":1},{"text":"ሚርጌ ዓሶና ዎላ ፆኦሲ ማኣሪ ዴንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ቦንቾ ኬሎ ቦንቻ ዓሳ ዓይኑሞና ዒላሺሢና","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ጋላታኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያ ታኣኒ ሚናኣ ናንጎ ማላዛ","poem":2},{"lineBreak":true},{"text":"ዒና ታኣኮ ዖዪሢና ዋኣፃኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ታኣኒ ዓይጎሮ ዎዛ ቲቃንዳይ?","poem":1},{"text":"ዓይጌንዴሮ ታ ሜታዻንዳይ?","poem":2},{"lineBreak":true},{"text":"ታኣኒ ፆኦሲ ጉሙርቃኔ፤","poem":2},{"lineBreak":true},{"text":"ዒዚ ታና ማኣዳሢሮዋ ታ ጋላታኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ታ ፆኦዛሢዮ! ታ ዎዛ ቲቄኔ፤","poem":1},{"text":"ሼምፔላ ታኣኮ ዖዬኔ፤","poem":2},{"text":"ዬያሮ ዮርዳኖሴንታ ዓርሞኒዔሜ ዓጮይዳ ዓኣ","poem":1},{"text":"ሚዛሬ ዹካ ዴዒ ታ ኔና ማላኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኔኤኮ ሶኦሪንታ ዋኣፆኮ ጉኡሚፃፓ ዔቄያና","poem":1},{"text":"ፔቴ ቁልባ ባጎ ቁልቦ ዔኤላኔ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ዋኣፆ ጉዳሢ ዢባራ ዱኡኪ ታና ባይዜኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳ ፔ ማኣሪፆ ሮኦራ ዳካኔ፤","poem":1},{"text":"ዋንቶ ታ ዒዛም ዓይናዻ ዓይኑሞ ታኣኮ ዓኣኔ፤","poem":2},{"lineBreak":true},{"text":"ታ ናንጎኮ ፆኦዛሢያ ታ ሺኢቃኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ታኣኒ ታ ፆኦዛሢ፥ ታኣኮ ላላሢም፦","poem":1},{"text":"«ኔኤኒ ታና ዓይጋ ዋሌይ?","poem":2},{"lineBreak":true},{"text":"ሞርካ ታና ዋኣዪሴም ዓይጋ ታ ዖዪ ሃንታዖ?» ጋዓንዳኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሞርካ ታኣኮ ቢያ ዎዴ፦ «ፆኦዛሢ ኔኤኮ ዎካ ዓኣዖ?» ጌዒ","poem":1},{"text":"ቶኦቻ ዎዶና ሜጌፃኣ ታኣኮ ዓቱዋዖ ቆፃኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ታኣኮ ሼምፔሌ ዓይጋ ኔ ዖያይ?","poem":1},{"text":"ዓይጋ ኔኤኒ ሻሊንታይ?","poem":2},{"text":"ጉሙርቂፆ ዎዞ ኔኤኮ ፆኦዛሢዳ ማሄ፤","poem":1},{"text":"ታና ዓውሳያ ማዔ ታ ፆኦዛሢ ሃጋኣ ታኣኒ ጋላታንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}