{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":43,"content":[{"type":"heading","content":["ዒፂ ዳውሶ ዎዴና ሺኢቆ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ፆኦሲዮ! ታኣም ዎጌ፤","poem":1},{"text":"ኔና ጉሙርቁዋ ሜሌ ዴሮና ዎላ ታ ዛሎ ሞኦቲንቴ፤","poem":2},{"lineBreak":true},{"text":"ፑርቶ ማዻ ዓሶና ጌሻ ዓሶናይዳፓ ታና ዓውሴ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታ ፆኦዛሢዮ! ኔኤኒ ታኣኮ ዶዶ ዋርዲያሢኬ፤","poem":1},{"text":"ኔኤኒ ታና ዓይጋ ሃሻይ?","poem":2},{"text":"ሞርካ ታና ዓይጋ ሮኦጋሲ ዖዪሳይ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ኔኤኮ ፖዖና ጎኑሞና ታኣም ዳኬ፤","poem":1},{"text":"ዔያታ ታና ዔኪ ኔኤኮ ዱማዼ ዹኮ","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ዎርቆ ማኣሮዋ ታና ሄሊሶንጎ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታኣኒ ፆኦሲም ዒንጎ ባኮ ሺኢሾ ቤዞ ዓኣዻንዳኔ፤","poem":1},{"text":"ሃይማ ፓጬኔ ጌይሱዖ ዎዛሳ ፆኦዛሢ ባንሢ ታ ዴንዳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ማዔ ታ ፆኦዛሢዮ!","poem":2},{"lineBreak":true},{"text":"ሚርጌ ሻዦ ዴንሦ ጎኦሎ ዋርቂ ዋርቂ ታ ኔና ጋላታንዳኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ታኣኮ ሼምፔሌ ዓይጋ ኔ ዖያይ?","poem":1},{"text":"ዓይጋ ኔኤኒ ሻሊንታይ?","poem":2},{"text":"ጉሙርቂፆ ዎዞ ኔኤኮ ፆኦዛሢዳ ማሄ፤","poem":1},{"text":"ታና ዓውሳሢ ማዔ ፆኦዛሢ ሃጊ ታ ጋላታንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}