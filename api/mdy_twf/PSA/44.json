rse","number":4,"content":[{"text":"ኔኤኒ ታኣኮ ካኣቲኬ፤","poem":1},{"text":"ጊንሣ ሃሣ ኔ ታኣኮ ፆኦዛሢኬ፤","poem":2},{"text":"ያይቆኦቤ ዜርፆ ማዔ ኔ ዴራ","poem":1},{"text":"ባሻንዳጉዲ ማዼሢ ኔናኬ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኔ ኑና ማኣዴም ኑ ሞርኮ ኑ ባሻኔ፤","poem":1},{"text":"ኑ ዑፃ ዔቃ ዓሶ ኔ ሱንፆና ኑ ዻውሲሳኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታኣኒ ታኣኮ ሂኢዦ ጉሙርቁዋሴ፤","poem":1},{"text":"ታኣኮ ጬንቾ ዓፓራኣ ታና ዓውሱዋሴ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኑ ሞርካፓ ኑና ዓውሳንዳሢ ኔናኬ፤","poem":1},{"text":"ኑና ዒፃ ዓሶ ቦርሲሳንዳሢያ ኔናኬ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ፆኦሲዮ! ኔኤና ኑ ሄርሺንታኔ፤","poem":1},{"text":"ሱንፆዋ ኑ ኔኤኮ ናንጊና ጋላታኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ሃሢ ጋዓንቴ ኔ ኑና ኬኤሬኔ፥ ቦርሲሲያ ቦርሲሴኔ፤","poem":1},{"lineBreak":true},{"text":"ኑኡኮ ዖሎ ዓሶና ዎላ","poem":1},{"text":"ኔኤኒ ኬስኪፆዋ ሃሼኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኑኡኮ ሞርኮ ቤርታፓ ዓኣሺንቲ ጳሽካንዳጉዲ ኔ ኑና ማሄኔ፤","poem":1},{"text":"ኑ ሞርካኣ ኑኡኮ ዓኣ ባኮ ቢያ ቡሬኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኔ ኑና ሹኪንታ ማራይጉዲ ማሄኔ፤","poem":1},{"text":"ሜሌ ዴሮ ዓጫ ኔ ኑና ዜርቄኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዴሮ ኔኤኮ ኔ ዻካ ሚኢሼም ሻንቼኔ፤","poem":1},{"text":"ዬያ ኔ ሻንቺፆና ቃሲ ዴንቄ ባኣዚ ባኣሴ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኑኡኮ ዓሺና ኑና ጫሽካንዳጉዲ","poem":1},{"text":"ኑ ኮሮይዳ ዓኣ ዓሶማኣ ኑ ሚኢቺ","poem":2},{"lineBreak":true},{"text":"ሃሣ ዓማሊ ባኣዚ ማዓንዳጉዲ ኔ ማዼኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዴሬ ኑ ዛላ ጌስቲ ዓማላያ","poem":1},{"text":"ቶኦቺሢና ቶኦኮዋ ፔኤኮ ዓጊሣንዳጉዲ ኔ ማዼኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ቢያ ኬላ ዓኣፖ ካራ ታኣኮ ዻውሲንቲናኬ፤","poem":1},{"text":"ቢያ ባኣዚና ታ ቦርሲንታያ ማዔኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታኣኒ ያዺ ማዔሢ","poem":1},{"text":"ሞርካ ታኣኮ ኮሞ ኮፃ ዎዶና","poem":2},{"lineBreak":true},{"text":"ሜሌ ዓሳ ቄኤዺ ታና ቶኦቻሢ ዋይዜሢሮኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ዬይ ቢያ ኑና ሄሌሢ","poem":1},{"text":"ኔና ኑ ዋሊባኣንቴ፥ ኔኤኮ ጫኣቁሞ ኑ ሃሺ ሻሂባኣንቴኬ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዒና ኑኡኮ ኔኤም ጉሙርቂንታ ጎይሣ ዓኣንቴኬ፤","poem":1},{"text":"ቶካኣ ኑኡኮ ኔ ጎይፃፓ ኬስኪባኣሴ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ኔኤኒ ጋዓንቴ ቦዓ ፔኤቃ ቤዛ ሜንሢ ኑና ኬኤሬኔ፤","poem":1},{"text":"ሻኔ ዹሚና ኔ ኑና ባይዜኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ኑ ፆኦዛሢኮ ሱንፆ ኑ ዋሊ","poem":1},{"text":"ኩጮዋ ሜሌ ፆኦዞ ባንሢ ዔቂሴያ ኑ ማዔቴ፥","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ኑ ፆኦዛሢ ዬያ ዔሩዋዓዳ?","poem":1},{"text":"ዒዚ ዒናይዳ ዓኣ ባኣዚ ዔዔራያኬ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ጋዓንቴ ኔ ዛሎ ኬላ ኬላ ኑ ሃይቄዖ ዓቲ ዓቲ ዓኣኔ፤","poem":1},{"text":"ሹኪንታ ማራይጉዲያ ኑ ፓይዲንቴኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ዔቄ! ዓይጋ ኔ ጊንዓይ?","poem":1},{"text":"ዔቄ! ናንጊና ኑና ኔ ኬኤሪ ሃሺፖ!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ኔኤኮ ዓኣፖ ካሮ ኑ ጊዳፓ ኔ ዓይጋ ሺርሻይ?","poem":1},{"text":"ኑኡኮ ሜታዺፆና ሄርቂንቲ ዎይፆዋ ዓይጋ ኔ ዋላይ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ሳዖ ኬዲ ሄላኒ ዑኪ ኑ ኩንቴኔ፤","poem":1},{"text":"ዒኢካ ኑ ሎኦሚ ላሄኔ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ዔቂጋፓ ኑና ማኣዳኒ ሙኬ!","poem":1},{"lineBreak":true},{"text":"ኔኤኮ ናንጊና ናንጋ ናሹሞሮ ጌይጋፓ","poem":1},{"text":"ጊንሣ ማሂ ኑና ሻንቂ ዔኪ ዓውሴ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}