:"ዓይናዹዋቴ፥ ኑ ካኣቲም ዓይናዹዋቴ!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኑ ፆኦዛሢ ዓጮ ቢያኮ ካኣቲኬ፤","poem":1},{"text":"ዬያሮ ጋላታ ዓይኑሞ ዒዛም ዓይናዹዋቴ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ፆኦሲ ፔኤኮ ዱማዼ ካኣቱሞ ዖይታ ዴዔኔ፤","poem":1},{"text":"ዓጮ ዴሮዋ ዎይሣሢ ዒዛኬ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዓብራሃሜ ፆኦዛሢ ዴሮና ዎላ","poem":1},{"text":"ዓጮ ዴሮኮ ሱኡጋ ቡኪንቴኔ፤","poem":2},{"lineBreak":true},{"text":"ዓጮ ካኣታኣ ዒዛሮኬ፤","poem":2},{"lineBreak":true},{"text":"ዒዚያ ኮሺ ዼግ ዼጊ ጌዔያኬ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}