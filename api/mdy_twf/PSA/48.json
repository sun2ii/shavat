"verse","number":7,"content":[{"text":"ዓባ ኬስካ ባንፆ ዢባራ","poem":1},{"text":"ቴርሴሴ ዓጮኮ ዋኣፆ ካኣሚሎ ሜንሣሢጉዲ","poem":2},{"lineBreak":true},{"text":"ኔኤኒያ ዔያቶኮ ዎልቆ ላቢሲ ጎቃይሴኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዼ ባኮ ኑ ዋይዜሢጉዲ","poem":1},{"text":"ቢያ ባኮ ዳንዳዓ ጎዳሢ ካታማ ዬኖ ጎይፆ ማዓንቴ","poem":2},{"lineBreak":true},{"text":"ኑ ዓኣፒና ኑ ዛጌኔ፤","poem":2},{"lineBreak":true},{"text":"ዒዚ ዬኖ ካታሜሎ","poem":2},{"lineBreak":true},{"text":"ናንጊና ዶዲሺ ዴይሣንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ፆኦሲዮ! ኑኡኒ ኔኤኮ ጌኤዦ ማኣሮይዳ ማዒ","poem":1},{"text":"ኔኤኮ ማኣሪፆ ኑ ማላኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ፆኦዛሢዮ! ኔና ጋላቲፃ ዓጫ ማዔ ካሮና ሄሌሢጉዲ","poem":1},{"text":"ሱንፃኣ ኔኤኮ ዒማ ጎይፆ ማዔኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኔኤኒ ፒዜ ዎጋያ ማዔሢሮ","poem":1},{"text":"ፂዮኔይዳ ናንጋ ዴራ ዎዛዻኔ፤","poem":2},{"lineBreak":true},{"text":"ዪሁዳ ካታማ ናንጋ ዓሶዋ ዎዛሳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ዎሊ ጊንፆ ኬስኪ ፂዮኔ ሺሩዋቴ፤","poem":1},{"text":"ዒዞ ዴዒ ካፖ ሴኤሎዋ ፓይዱዋቴ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዒንሢ ሙካ ሾይንቶም ኬኤዛኒ","poem":1},{"text":"ዒዞኮ ዶዶ ኬኤሎ ዲፆዋ ማሊ ጶቂሡዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዋርዲዮ ቤዞዋ ዛጉዋቴ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዒንሢ ዔያቶም ኬኤዛንዳሢ፦ «ፆኦሲ ያዺኬ፤","poem":1},{"text":"ኑ ፆኦዛሢ ናንጊና ናንጋያኬ፤","poem":2},{"lineBreak":true},{"text":"ሴካ ቤርቲማኣ ዒ ኑና ዔኪ ዓኣዻንዳኔ» ጌዒኬ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}