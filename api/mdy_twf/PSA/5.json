{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":5,"content":[{"type":"heading","content":["ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆና ሹሉንጎና ዓይናዺንታ ዳውቴ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ፆኦሲ ማኣዳንዳጉዲ ሺኢቂንታ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ታ ዑኡዞ ዋይዜ፤","poem":1},{"text":"ጋርሲና ታ ዚኢሊንቲ ጋዓ ባኮ ዔኬ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታ ካኣቲዮ፥ ታኣኮ ፆኦዛሢዮ!","poem":1},{"text":"ታ ኔና ሺኢቃሢሮ","poem":2},{"lineBreak":true},{"text":"ታና ኔ ማኣዳንዳጉዲ ታ ዒላታ ዒላቶ ዋይዜ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ጉቶ ጉቶ ታ ሺኢቃ ሺኢጲፆ ዋይዜ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ታኣም ዎዚ ጋዓቴያ ጉሙርቂ ታ ካፓኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ኔኤኒ ፑርታ ማዾና ዎዛዻ ፆኦሲቱዋሴ፤","poem":1},{"text":"ፑርቶ ማዻ ዓሳኣ ኔኤና ዎላ ናንጉዋሴ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዖቶርቃ ዓሳ ኔ ቤርታ ዔቁዋሴ፤","poem":1},{"text":"ፑርቶ ማዻ ዓሶዋ ቢያ ኔኤኒ ዒፃኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሉኡዙሞ ጌስታ ዓሶ ቢያ ኔ ባይዛኔ፤","poem":1},{"text":"ዓሲ ዎዻ ዓሶንታ ጌሻ ዓሶዋ ኔኤኒ ሻኣኪንታኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ታኣኒ ጋዓንቴ ኔኤኮ ዼኤፖ ማኣሪፆና ኔ ማኣሪ ጌላንዳኔ፤","poem":1},{"text":"ኔኤም ዱማዼ ጌኤዦ ማኣሮ ባንሢያ ቦንቾና ታ ዚጋንዳኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ታኣኮ ሚርጌ ሞርኬ ዓኣሢሮ","poem":1},{"text":"ኔ ፂሉሞና ኔኤኒ ታና ዔኪ ዓኣዼ፤","poem":2},{"lineBreak":true},{"text":"ኔ ጎይፆዋ ኔኤኒ ታኣም ኮሼ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ዔያታ ጌስታ ጌኤዞይዳ ጎኑሞ ባኣሴ፤","poem":1},{"text":"ማሊፆ ዔያቶሲዳ ጌኔ ኩሜያኬ፤","poem":2},{"lineBreak":true},{"text":"ቆርጫ ዔያቶሲ ሲንሢንቲባኣ ዱኡፒ ዔቴጉዲኬ፤","poem":2},{"lineBreak":true},{"text":"ዻንጋ ዔያቶሲያኣ ዓሲ ጌሻያኬ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ፆኦሲዮ! ዔያቶ ዒንሢ ዻቢንቴያኬ ጌዔ፤","poem":1},{"text":"ጌኖ ማዻ ዔያቶሲ ዔያቶ ባይዞንጎ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶኮ ጎማ ሚርጌሢሮ ዔያቶ ባይዜ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ኔና ፑኖ ካዮ ማሃዞንሢ ቢያ ዎዛዾንጎ፤","poem":1},{"text":"ናንጊና ዔያታ ዒላሾንጎ፤","poem":2},{"lineBreak":true},{"text":"ሱንፆ ኔኤኮ ናሽካ ዓሳ ቢያ ዒናፓ ዎዛዻንዳጉዲ","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ዔያቶኮ ጊቲማ ማዒ ካፔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔኤኒ ፂሎ ዓሶ ዓንጃኔ፤","poem":1},{"text":"ኔኤኮ ሚጪንቲፆና ጊቲማ ማዒ ኔ ዔያቶ ዓውሳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}