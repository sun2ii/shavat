{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":50,"content":[{"type":"heading","content":["ዓሳኣፔ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ፆኦሲ ዎዛሳ ጎኔ ካኣሺ"]},{"type":"verse","number":1,"content":[{"text":"ዼኤፖ ፆኦዛሢ ማዔ ናንጊና ናንጋ ጎዳ ኬኤዛኔ፤","poem":1},{"text":"ዓባ ኬስካ ካራፓ ዴንዲ ጌላ ካሮ ሄላንዳኣና","poem":2},{"text":"ሳዖይዳ ዓኣ ዓሶ ቢያ ዒዚ ዔኤላኔ።","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ፆኦሲ ሚርጌና ሚዛጳያ ማዔ","poem":1},{"text":"ፂዮኔ ካታማፓ ሼኤሪ ፖዓኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ኑ ፆኦሲ ሙካንዳኔ፥ ዚቲ ጋዓዓኬ፤","poem":1},{"text":"ዒዛኮ ቤርታ ዔኤታ ታሚ ዓኣኔ፤","poem":2},{"lineBreak":true},{"text":"ኮሮይዳኣ ዎልቄና ዓኣ ዓልጎ ዢባሬ ዓኣኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዒዚ ፔ ዴሮ ዎጋ ዎዶና","poem":1},{"text":"ጫሪንጮንታ ሳዖንታ ማርካ ማሂ ዔኤላንዳኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"«ዒንጎ ባኮ ታኣም ሺኢሺፆና ታኣና ዎላ ጫኣቄ ዓሶ","poem":1},{"text":"ታኣም ጉሙርቂንታያ ማዔ ታ ዓሶ","poem":2},{"lineBreak":true},{"text":"ታ ቤርታ ቡኩሱዋቴ» ጋዓኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ፆኦሲ ፔኤሮ ዎጋያ ማዔሢሮ","poem":1},{"text":"ጫሪንጫ ዒዛኮ ዼጊ ጌዔ ፂሉሞ ኬኤዛኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"«ዒስራዔኤሌ! ታ ኔ ዑፃ ማርካዾም፤","poem":1},{"text":"ዒንሢ ታ ዴራ! ዋይዙዋቴ ታ ኬኤዞም፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ናንጊና ናንጋ ጎዳ ማዔ ኔ ፆኦዛሢኬ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኔኤኒ ታኣም ዒንጋ ዒንጊፆሮ ታ ኔና ቦሁዋሴ፤","poem":1},{"text":"ቢያ ዎዴ ሚቺ ኔ ዒንጋ ዒንጊፃ ታ ቤርታ ጴዻኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታኣኒ ጋዓንቴ ኔኤኮ ሞኦፃፓ ዚዮ ጌማቶ","poem":1},{"text":"ኔኤኮ ባርታፓ ኮላቶ ኮዑዋሴ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ካዮ ቦዓ ቢያ","poem":1},{"text":"ዹካ ሄንቃ፥ ሺያና ፓይዲንታ ቆልማ ታኣሮኬ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጫሪንጮ ካፖ ቢያ ታኣኒ ዔራኔ፤","poem":1},{"text":"ዓሳ ናንጉዋ ዳውሎይዳ ዓኣ ቦዓኣ ታኣሮኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ሳዖንታ ዒኢካ ዓኣ ባካ ቢያ ታኣሮታሢሮ","poem":1},{"text":"ዔያታ ናይዺንቴቴያ ታ ኔኤም ኬኤዙዋሴ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታኣኒ ዚዮ ጌማቶኮ ዓሽኮ ሙዓ?","poem":1},{"text":"ኮላቶ ሱጉፆዋኣ ታኣኒ ዑሽካ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ፆኦሲም ጋላታ ዒንጊሢ ሺኢሼ፤","poem":1},{"text":"ናኣቦዋ ኔኤኮ ዼኤፖ ፆኦዛሢም ዒንጌ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሜታ ኔና ሄሌ ዎዶና ታና ዔኤሌ፤","poem":1},{"text":"ታኣኒ ኔና ዓውሳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዬካፓ ኔ ታና ጋላታንዳኔ» ጋዓኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ጎሞሲም ጋዓንቴ ፆኦሲ፦","poem":1},{"text":"«ኔኤኒ ታኣኮ ዎጎ ናባባኒ","poem":2},{"lineBreak":true},{"text":"ታኣኮ ጫኣቁሞ ኔ ዻንጎና ኬኤዛኒ","poem":2},{"lineBreak":true},{"text":"ዓይጎ ዔራቶ ኔኤኮ ዓኣይ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ጎሪ ታ ኔና ዞራ ዞሮ ኔ ዒፃኔ፤","poem":1},{"text":"ቃኣሎ ታኣሲ ጊንሢም ኬኤራኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ዉሲ ዓሲ ኔ ዴንቃዖ ዎላ ጳሽካኔ፤","poem":1},{"text":"ዞኦዛ ኮኦማ ዓሶና ዎላ ፔቴ ኔ ማዓኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«ኔ ዻንጋ ፑርታ ባኣዚ ጌስታንዳጉዲ ኔ ሃሻኔ፤","poem":1},{"text":"ጌኤዛ ኔኤኮ ቢያ ጌሺሢ ሌሊኬ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዴዒጋፓ ኔኤኒ ኔ ጌርሲ ዾንካኔ፤","poem":1},{"text":"ኔ ዒንዶ ናዖኮዋ ሱንፆ ፑርቲሳኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዬያ ኔ ማዼንቴያ ታኣኒ ዚቲዮ ጌዔኔ፤","poem":1},{"text":"ዬያሮ ታኣኒ ኔጉዲ ማዔያ ኔኤም ማላኔ፤","poem":2},{"lineBreak":true},{"text":"ሃሢ ጋዓንቴ ፔጌና ታ ኔና ጎሪ ዞራኔ። »","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«ዒንሢ ታና ቶኦቻ ዓሳ ቢያ ሃያ ዒና ዔኪ ዋይዙዋቴ፤","poem":1},{"text":"ሃንጎ ታ ዒንሢ ባይዛንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢ ዓውሳንዳያኣ ባኣሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ታኣም ጋላታ ዒንጊሢ ሺኢሻሢ ታና ቦንቻኔ፤","poem":1},{"text":"ጎይፆ ፔኤሲ ፒዚሳሢም","poem":2},{"text":"ፆኦሲኮ ዓውሲፆ ታኣኒ ቤኤዛንዳኔ» ጋዓኔ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}