{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":52,"content":[{"type":"heading","content":["ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆና ዔራቶና ካላሊንታ ዳውቴ ካላሎ፤ ዔዶኦሜ ዓሢ ዶይቄ ሳኣዖኦሌ ኮራ ሙኪ፥ «ዳውቴ ዓቤሜሌኬ ማኣሪ ሙኬኔ» ጌይ ኬኤዜያና ዓይናዺንቴያኬ።"]},{"type":"hebrew_subtitle","content":["ፆኦሲኮ ዎጎና ኮሹሞና"]},{"type":"verse","number":1,"content":[{"text":"ዔዞ ዎልቆሶ ፑርቱሞና ዓይጋ ኔ ጪኢዺንታይ?","poem":1},{"text":"ፆኦሲ ዓኣፓ ኔኤኒ ቶኦቺንቴያታዖ","poem":2},{"text":"ቢያ ዎዴ ዎይቲ ኔ ዖቶርቃይ?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ኔኤኒ ጌሺሢ ታኣኮ ማዾኬ ጌዒ ዓርቄሦ","poem":1},{"text":"ዻንጋ ኔኤኮ ዓጬ ሺጊሬጉዲ ባይሲንታ ሱኪ ሺራኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኮሹሞይዳፓ ባሼ ፑርቱሞ","poem":1},{"text":"ጎኑሞይዳፓ ሉኡዙሞ ባሼ ኔኤኒ ዶኦራኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኔኤኒ ዓሶ ጌሻ ዓሢ","poem":1},{"text":"ዓሲ ማኣሳንሦንዶ ጎይሢ ጌስታኒ ናሽካኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ዬያሮ ፆኦሲ ኔና ጋፒ ባይዛንዳኔ፤","poem":1},{"text":"ኔ ማኣራፓ ኬሲ ኔና ዒዚ ዳውሳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዓሳ ናንጋ ሳዓፓ ኔና ቱጊ ኬኤራንዳኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ፂሎ ዓሳ ዬያ ዛጊ ዒጊጫንዳኔ፤","poem":1},{"text":"ሚኢቺያ ሂዚ ጌዒ ዔያታ ሚኢጫንዳኔ፦","poem":2}]},{"type":"verse","number":7,"content":[{"text":"«ፆኦሲ ፔኤኮ ጊቲማጉዲ ማሂባኣ","poem":1},{"text":"ፔ ቆሎ ሚርጉሞና ሄርሺንቴ","poem":2},{"lineBreak":true},{"text":"ፔ ፑርቱሞናኣ ዶዴ","poem":2},{"lineBreak":true},{"text":"ሃያ ዓሢ ዛጉዋቴ።»","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታኣኒ ጋዓንቴ ፆኦሲ ማኣሮይዳ","poem":1},{"text":"ዋርቂ ዓኣ ዛይቶ ሪሚቶጉዲኬ፤","poem":2},{"text":"ዒዛኮ ጋፑዋ ናሹሞ","poem":1},{"text":"ናኣናና ታ ጉሙርቄ ጎይሣ ናንጋንዳኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፆኦሲዮ!","poem":1},{"text":"ኔኤኒ ማዼ ኮዦ ባኮሮ ቢያ ናንጊና ታ ኔና ጋላታኔ፤","poem":2},{"lineBreak":true},{"text":"ሱንፃ ኔኤኮ ኮሺታሢሮ ኔ ሱንፆ ታ ሃጋኣ ዎዛ ማሃኔ፤","poem":2},{"lineBreak":true},{"text":"ኔኤም ዱማዼ ዓሶ ባኣካ ታ ኔና ጋላታኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}