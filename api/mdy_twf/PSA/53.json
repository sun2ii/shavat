{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":53,"content":[{"type":"heading","content":["ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆና ዔራቶና ካላሊንቴ ዳውቴ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ዓሲኮ ፑርቱሞ"]},{"type":"verse","number":1,"content":[{"text":"ዔኤያ ዓሲ ፔ ዒናና «ፆኦሲ ባኣሴ» ጋዓኔ፤","poem":1},{"text":"ዬያታ ፑርታ ዓሲኬ፤","poem":2},{"lineBreak":true},{"text":"ማዻ ዔያቶኮ ሻኣካያኬ፤","poem":2},{"lineBreak":true},{"text":"ዔያቶ ባኣካ ፔቴታዖ ኮሺ ማዻይ ባኣሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ማሊ ጶቂሣ ዓሲና ፆኦሲ ኮዓ ዓሲያ ዓኣቴ ዛጋኒ","poem":1},{"text":"ዒዚ ጫሪንጫፓ ዓሶ ዛጌኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ጋዓንቴ ቢያሢ ዣኣሌኔ፤","poem":1},{"text":"ዔያታ ፔቴ ማዒያ ፑርቴኔ፤","poem":2},{"text":"ዔያቶይዳ ፔቴታዖ ኮሺ ባኣዚ ማዻይ ባኣሴ።","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ዓሲ ካሣ ሙዓሢጉዲ ዴሮ ታኣኮ ሙዓ ዓሳ","poem":1},{"text":"ታና ዔኤሊ ዔሩዋ ዓሳ","poem":2},{"text":"ዬያታ ፑርቶ ማዻ ዓሳ","poem":1},{"text":"ፔቴታዖ ዔኤቢ ዛጊ ዔሩዋዓዳ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ፆኦሲ ፔ ዴሮ ሞርኮ ሜንሤሢሮ","poem":1},{"text":"ዎኖ ዎዳፓኣ ባሼ ዒጊቹሞ ዔያታ ዓርቄኔ፤","poem":2},{"lineBreak":true},{"text":"ዒዚ ዔያቶ ዒፄሢሮ ጋፒ ዔያታ ቦርሲንታንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ፂዮኔይዳፓ ዒስራዔኤሌም ዻቂንታ ዬዓያታቴ ዓይጎ!","poem":1},{"text":"ፆኦሲ ፔ ዴሮኮ ዲዒንቴ ባኮ ማሃ ዎዶና","poem":2},{"text":"ያይቆኦቤ ናኣታ ዎዛዻንዳኔ፤","poem":1},{"text":"ዒስራዔኤሌ ዴራኣ ኮሺ ዎዛዻንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}