{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":54,"content":[{"type":"heading","content":["ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆና ጎኦላና ዓይናዺንታ ዳውቴ ዓይኑሞ፤ ዜፓ ዓሳ ሳኣዖኦሌ ኮራ ሙኪ፥ «ዳውቴ ፑኒ ኑ ኮራ ዓኣኔ» ጌዒ ኬኤዜያና ዓይናዺንቴያኬ።"]},{"type":"hebrew_subtitle","content":["ሞርኮ ኩጫፓ ዓታኒ ሺኢቂንቴ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ፆኦሲዮ! ኔ ሱንፆና ታና ዓውሴ፤","poem":1},{"text":"ኔ ዎልቆና ታኣም ዎጌ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ፆኦሲዮ! ሺኢጲፆ ታኣኮ ዋይዜ!","poem":1},{"text":"ታኣኒ ጋዓ ባኮዋ ዒና ዔኬ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ፃንጎ ዓሳ ታኣም ዔቄኔ፤","poem":1},{"text":"ጌኔ ማዻ ዓሳ ሼምፓሢ ታኣኮ ዼሂ ሃንታኔ፤","poem":2},{"lineBreak":true},{"text":"ፆኦሲ ዔያታ ዔኤቢኬ ጎዑዋሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ጋዓንቴ ፆኦሲ ታና ማኣዳሢኬ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳኣ ታና ኬኤሊንቂ ዓርቄኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዔያቶኮ ጌኖ ማዾ ታና ዋኣዪሳ ታ ሞርኮም ማሄ፤","poem":1},{"text":"ዔያቶ ባይዚ፥ ኔኤኒ ጉሙርቂንታያ ማዒፆ ዻዌ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ኔኤም ዒንጎ ባኣዚ ታ ሼኔና ታ ዒንጋንዳኔ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":2},{"lineBreak":true},{"text":"ዬይ ኮይሳያ ማዔሢሮ ታ ኔና ጋላታኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታ ሜታፓ ቢያ ኔ ታና ዓውሴኔ፤","poem":1},{"text":"ታ ሞርኮኮዋ ሎኦሚፆ ታ ዛጌኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}