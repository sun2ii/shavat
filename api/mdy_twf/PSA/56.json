,"poem":2},{"lineBreak":true},{"text":"ቢያ ዎዴ ታና ባይዛኒ ዎላ ዞርታኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ቡኪንቲ ታና ዔያታ ካታኔ፤","poem":1},{"text":"ሄፆ ቢያ ዔያታ ታኣኮ ኮጲሳኔ፤","poem":2},{"lineBreak":true},{"text":"ሼምፓሢ ታኣኮ ባይዛኒ ኮዓኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ፆኦሲዮ! ዎይቴቴያ ዔያታ ቶሊ ዓቱዋጉዲ ማዼ!","poem":1},{"text":"ያቶ ዴሮ ኔኤኮ ጎሪንቶና ዻውሲሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ቃያሢ ታኣኮ ፃኣፒ ዓርቄ፤","poem":1},{"text":"ዓቢፆዋ ኔ ዶሎዞይዳ ቃዼ፤","poem":2},{"lineBreak":true},{"text":"ቢያሢ ፃኣፒ ዓርቆ ቤዛ ዓርቂንቴያቱዋዓዳ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኔ ባንሢ ታኣኒ ዔኤሊንታ ኬሎና","poem":1},{"text":"ሞርካ ታኣኮ ጊንሢም ማዓኔ፤","poem":2},{"text":"ዬያና ፆኦሲ ታኣኮ ኮራ ማዔሢ ታ ዔራኔ።","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ዬይ ታኣና ዎላ ማዔ ፆኦዛሢ","poem":1},{"text":"ቃኣሎ ታ ዒዛኮ ጋላታሢና ቦንቻ ፆኦዛሢኬ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታኣኒ ዒዛ ጉሙርቃሢሮ ዒጊጫዓ፤","poem":1},{"text":"ዓሲ ታና ዓይጎ ዎዳንዳይ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ፆኦሲዮ!","poem":1},{"text":"ኔኤም ታኣኒ ናኣቤ ናኣቢ ዓኣኔ፤","poem":2},{"lineBreak":true},{"text":"ዬይያ ጋላታ ታ ኔኤም ሺኢሻያኬ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ሃይቢዳፓ ኔኤኒ ታና ዓውሴኔ፤","poem":1},{"text":"ዹቂንቲ ታኣኒ ሎኦሙዋጉዲ ኔ ታና ማኣዴኔ፤","poem":2},{"text":"ዬያሮ ሼምፖና ዓኣ ዓሶ ዑፃ ፖዓ ፖዖይዳ","poem":1},{"text":"ፆኦሲ ቤርታ ታኣኒ ሃንታኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}