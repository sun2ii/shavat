{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":58,"content":[{"type":"heading","content":["«ባይዚፖ» ጌይንታ ዓይኑሞና ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆ ካላሊንቴ ዳውቴ ካላሎ"]},{"type":"hebrew_subtitle","content":["ፆኦሲ ፑርቶ ዓሶ ዎጋንዳጉዲ ሺኢቂንቴ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ዒንሢ ዎይሣ ዓሳ!","poem":1},{"text":"ፒዜ ዒንሢ ጌስታ?","poem":2},{"text":"ዓሶም ጎኑሞና ሄኮ ዒንሢ ዎጋ?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ዬያ ዒንሢ ሃሺ ዒኖና ዒንሢ ፑርታ ባኣዚ ማሊ ቱካኔ፤","poem":1},{"text":"ሳዖይዳ ዒንሢ ማዻ ባካ ቢያ ፑርታ ሌሊኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ፑርቶ ዓሳ ዒንዶ ጎጳ ዓኣዖ ዣኣሌያኬ፤","poem":1},{"text":"ሾይንቴማፓ ዓርቃዖ ዻባኔ፥ ሉኡዙሞዋ ዔያታ ጌስታኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዔያታ ሾኦሺጉዲ ዳኣኒናኬ፤","poem":1},{"text":"ዋይዚ ባይቄ ጎፖ ሾኦሺ ጉዴያኬ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ጎፖ ሾኦዣ ዋዮ ፔኤሲ ቱጫሢ","poem":1},{"text":"ሾኦዦ ማርሻ ዓሶንታ ሳጎ ዓሶንታኮ ዑኡዞ ዋይዞ ዒፂኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ፆኦሲዮ! ዬያቶ ዞቦጉዴ ፑርቶ ዓሶንሢኮ ዓጮ ሜንሤ፤","poem":1},{"text":"ባንጋሎዋ ዔያቶሲ ሾኦሌ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ላኣሊንታዖ ጋፓ ዋኣሢጉዲ ዔያታ ባይቆንጎ!","poem":1},{"text":"ሂኢዦ ዔያታ ዱካዛ ዻዻቦንጎ!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሃንታዖ ማኣሽኪ ጋፓ ዻኣዼጉዲ","poem":1},{"text":"ጊንሣ ሃሣ ፖዒ ዛጉዋ፥ ቡሊሢጉዲ","poem":2},{"lineBreak":true},{"text":"ዔያታ ማዖንጎ!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዔያታ ዔርቲባኣንቴ ዓንጊሢጉዲ","poem":1},{"text":"ቱጊንቲ ኬኤሪንታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ፆኦሲ ፔኤኮ ዼኤፖ ዻጎና","poem":2},{"lineBreak":true},{"text":"ሼምፔና ዓኣንቴ ዜርቂ ዔያቶ ባይዛንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ጎሞ ዓሶኮ ኮማ ኮፂንታኣና ዛጋዖ","poem":1},{"text":"ፂሎ ዓሳ ዎዛዻኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ቶኮ ፔኤሲ ፑርቶ ዓሶ ሱጉፆና ማስታኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዬኖ ዎዶና ዓሳ፦ «ፂሎ ዓሳ","poem":1},{"text":"ፔኤኮ ኮዦ ማዾ ዛሎ ዒንጎ ባኮ ዔኬኔ፤","poem":2},{"lineBreak":true},{"text":"ሳዖይዳ ዎጋ ፆኦሲ ጎኔና ዓኣኔ» ጋዓንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}