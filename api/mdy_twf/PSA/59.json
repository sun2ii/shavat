{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":59,"content":[{"type":"heading","content":["«ባይዚፖ» ጌይንታ ዓይኑሞና ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆ ካላሊንቴ ዳውቴ ካላሊ (ዳውቴ ዎዻኒ ማኣሮ ዒዛኮ ማንጋንዳጉዲ ሳኣዖኦሌ ዓሶ ዳኬያና ዒ ዓይናዼያኬ።)"]},{"type":"hebrew_subtitle","content":["ፆኦሲ ካፓንዳጉዲ ሺኢቂንቴ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ፆኦሲዮ! ታኣኮ ሞርኮይዳፓ ታና ዓውሴ፤","poem":1},{"text":"ታና ማኣሳንሣኒ ዔቄ ዓሶይዳፓ ካፔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ፑርቶ ማዻ ዓሶይዳፓ ሄሊ ታና ዓይሴ፤","poem":1},{"text":"ዓሶ ዎዻ ዓሶይዳፓኣ ታና ዓውሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ዔያታ ታና ካቲ ዓኣ ጎይፆ ዛጌ!","poem":1},{"text":"ፆኦሲዮ! ሚጪንቱዋ ዓሳ","poem":2},{"lineBreak":true},{"text":"ታ ዻቤ ባኣዚንታ ጎሜያ ታኣኮ ባኣንቴ","poem":2},{"lineBreak":true},{"text":"ታ ዑፃ ቡኪ ዔያታ ዞርቴኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዔያታ ታ ዻቤ ባኣዚ ባኣንቴ ታና ማኣሳንሣኒ ጊኢጊንቴኔ፤","poem":1},{"text":"ኔኤኒ ዬያ ዛጊጋፓ ዔቂ ታና ማኣዴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ኔኤኒ ቢያ ባኮ ዎይሣ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢኬ፤","poem":1},{"text":"ሜሌ ዴሮይዳ ሜቶ ዓጋኒ ኬስኬ፤","poem":2},{"text":"ዔያታ ፔኤኮ ጌኖ ማዾና ማዻ ባኮሮዋ","poem":1},{"text":"ሚጪንቱዋዖ ሜቶ ዔያቶይዳ ኬኤሬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ካታሞይዳ ዔያታ ዓዳ ካኒጉዲ","poem":1},{"text":"ቦጪ ሃንቲ ሺራኣ ሺራ ፔኤቂ ዒባኒ ማዓንዳኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዻንጋፓ ዔያቶኮ ኬስካ ባኮ ኔኤኒ ዋይዜ፤","poem":1},{"text":"ዻንጋ ዔያቶኮ ጬንቻ ዓፓሮ ዓኣኔ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ፦ «ዖኦኒያ ኑኡሲ ዋይዙዋሴ» ጋዓኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ኔኤኒ ጋዓንቴ ዔያቶ ሚሚኢጫኔ፤","poem":2},{"lineBreak":true},{"text":"ሜሌ ዴሮ ቢያ ቶኦቺ ኔ ዛጋኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታኣኮ ዶዱማሢዮ! ታና ኔ ካፔ፤","poem":1},{"text":"ፆኦዛሢዮ! ኔኤኒ ታኣኮ ፑኖ ካያሢኬ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ፆኦሲ ፔ ማኣሪፆና ታኣና ካኣማንዳኔ፤","poem":1},{"text":"ታ ጎዳሢ ታ ሞርኮኮ ሎኦሚፆ ታና ዻዋንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዔ ኑ ጊቲማሢዮ!","poem":1},{"text":"ታኣኮ ዒጊና ኔኤኒ ኮሜ ኮፃያ ማዔሢ ዋሉዋጉዲ ዔያቶ ዎዺፖ፤","poem":2},{"lineBreak":true},{"text":"ጋዓንቴ ኔኤኮ ዎልቆና ዔያቶ ዜርቄ፥ ሃሣ ዻውሲሴ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ፔኤኮ ዔያታ ዻንጋፓ ኬሳ ጎሞሮ","poem":1},{"text":"ፔ ሙሱሮና ዔያታ ጌስታ ዑኡዞሮ","poem":2},{"text":"ዔያታ ጋዳንቂ ሉኡቃሢሮ","poem":1},{"text":"ፔ ዖቶርሙሞና ዓዺንቶንጎ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኔኤኮ ዻጎና ዔያቶ ባይዜ፤","poem":1},{"text":"ዔያቶ ጋጋፒሴ፤","poem":2},{"text":"ያዺ ማዓዛ ፆኦሲ ዒስራዔኤሌ ዓሶ ዎይሣያ ማዔሢ","poem":1},{"text":"ዓጮኮ ጋፖ ሄላንዳኣና ዔርቴያ ማዓንዳኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታኣኮ ሞርካ ጉሪ ካታሞይዳ","poem":1},{"text":"ካኒጉዲ ቦጪ ሃንቲ ሺራኣ ሺራ","poem":2},{"lineBreak":true},{"text":"ዒባኒ ማዒ ሙካኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሙዖ ባይዚ ዔያታ ጳሽኪ ሺራኔ፤","poem":1},{"text":"ዔያታ ሚሽኪባኣያታቴ ጉሪ ቦጪ ሺራኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ታኣኒ ጋዓንቴ ኔኤኮ ዎልቆ ዛሎ ዓይናዻንዳኔ፤","poem":1},{"text":"ኔኤኒ ታኣኮ ፑኖ ካያሢኬ፤","poem":2},{"lineBreak":true},{"text":"ታና ሜቴ ኬሎ ኔ ታኣኮ ዹካሢኬ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ፆኦዛሢዮ! ኔ ታኣኮ ዱማዼሢኬ፤","poem":1},{"text":"ኔኤኒ ታኣኮ ፑኖ ካያሢኬ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ናንጊና ናንጋ ናሹሞ ኔ ታና ቤኤዛኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያሮ ጋላታ ዓይኑሞ ታ ኔኤም ሺኢሻኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}