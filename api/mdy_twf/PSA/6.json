{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":6,"content":[{"type":"heading","content":["ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆና ሳሊ ሻሺ ጎኦላና ዓይናዺንታ ዳውቴ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ሜቶ ዎዴና ሺኢቂንታ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔ ዻጎና ታና ጎሪፖ፤","poem":1},{"text":"ኔኤኮ ታሞጉዴ ዻጎና ታጊዳ ሜቶ ዓጊፖ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ታኣኒ ላኣፓታሢሮ ታና ሚጪንቴ፤","poem":1},{"text":"ሜጌፃ ታኣኮ ኮልኮልቄሢሮ ሃዳራ ታና ዓውሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ሼምፓሢ ታኣኮ ጉቤ ካራ ባይዚ ሜታዼኔ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ማኣዱዋዖ ዴዓሢ ዎማ ሄላንዳኣናዳይ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ጊንሣ ማዒ ታና ዓውሴ፤","poem":1},{"text":"ኔኤኮ ናንጊና ናንጋ ናሹሞና ታና ፓሤ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሃይቄ ዓሶይዳፓ ኔና ማሊ ጶቂሣይ ባኣሴ፤","poem":1},{"text":"ዱኡኪንቴ ቤዛ ዓኣዖ ኔና ጋላታይ ዖናዳይ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ዖዪፆ ሚርጊፆፓ ዔቄያና ታኣኒ ላቤኔ፤","poem":1},{"text":"ዬኤፓ ታኣኮ ሚርጌሢሮ ዋንቶ ሻኣላ ታኣኮ ዎዓኔ፤","poem":2},{"lineBreak":true},{"text":"ኬራኣ ታኣኮ ማስኪንታኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታ ሞርኮኮ ማኪፃፓ ዔቄያና","poem":1},{"text":"ሚርጌ ታ ዬኤኬሢሮ ዓኣፓ ታኣኮ ዴይ ዔቴኔ፤","poem":2},{"lineBreak":true},{"text":"ዴንቃኒያ ታኣኒ ዳንዳዑዋሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዬኤፖ ዒላቶ ታኣኮ ዋይዜሢሮ","poem":1},{"text":"ዒንሢ ፑርቶ ማዻ ዓሳ ታ ኮራፓ ባይቁዋቴ!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሺኢጲፆ ታኣኮ ዋይዜኔ፤","poem":1},{"text":"ታ ሺኢቄ ሺኢጲፆዋ ዒዚ ዔኬኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሞርካ ታኣኮ ቢያ ቦርሲንታንዳኔ፤","poem":1},{"text":"ማሊባኣዖ ዻውሲንቲ ጊንሢም ዔያታ ጳሽካንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}