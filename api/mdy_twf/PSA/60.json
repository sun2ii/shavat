{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":60,"content":[{"type":"heading","content":["ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆና «ሳሌ ቡኒ» ጌይንታ ዓይኑሞና ዓይናዺንታ ዳውቴ ካላሊ (ኬዶ ዛሎኮ ዓባ ጌላ ባንፃ ዓኣ ሜሴፖታሚያና ሶኦሪያ ዓጮኮ ሳዞይዳ ናንጋ ዓራማ ዓሳ ዒስራዔኤሌ ዓሶ ዖሌያና፥ ጊንሣ ሃሣ ዒዮዓኣቤያ ሶኦጎ ዶኦጮይዳ ታጶ ላምዖ ሺያ ማዓ ዔዶኦሜ ዓሶ ዎዼያና ዓሶ ዔርዛኒ ዳውቴ ካላሌ ካላሊኬ።)"]},{"type":"hebrew_subtitle","content":["ፆኦሲ ዓውሳያ ማዒፆ ዔርዛ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ፆኦሲዮ! ኔ ኑና ኬኤሬኔ፥ ሜንሢያ ጋኣጬኔ፤","poem":1},{"text":"ኔ ኑና ጎሬኔ፤","poem":2},{"text":"ሃሢ ጋዓንቴ ማሂ ኑና ኮሼ።","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ሳዔሎ ኔ ዓጊሢ ፃሂሲ ዳርዜኔ፤","poem":1},{"text":"ሴካ ሃንጋ ዒዛ ጋዓሢሮ ዒዞ ኮኦሌ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኔኤኮ ዴሮ ሜቶ ኔ ዻዌኔ፤","poem":1},{"text":"ማሣ ዎይኔ ዑሺ","poem":2},{"lineBreak":true},{"text":"ኑ ዑሽካንዳጉዲ ኔ ዒንጌኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ፔኤኮ ሞርኮ ዓንጋፓ ቶሊ ዓታንዳጉዲ","poem":1},{"text":"ኔና ዒጊጫዞንሢ ዴንቂ ፔና ካፓንዳንጉዲ","poem":2},{"lineBreak":true},{"text":"ማላታ ማሂ ኔ ዔያቶም ዒንጌኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኔ ናሽካ ዴራ ዻቃንዳጉዲ","poem":1},{"text":"ሚዛቆ ኩጮና ኑና ማኣዴ፥ ማሂያ ኑም ኬኤዜ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ፆኦሲ ፔ ናንጋ ዱማዼ ማኣራፓ ኬኤዛዖ፦","poem":1},{"text":"«ታኣኒ ዎዛና ሴኬሜ ሳዖ ጊሽካንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሱኮቴ ዶኦጮዋ ፓቃንዳኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ጌሌዓዴንታ ሚናኣሴ ዓጮንታ ታኣሮኬ፤","poem":1},{"text":"ዔፕሬኤሜ ዖሎሮ ታኣኮ ቶኦካ ዓጎ ዓንጎኬ፤","poem":2},{"lineBreak":true},{"text":"ዪሁዳ ታኣኮ ካኣቱሞ ዎልቆኮ ማላታኬ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሞዓኣቤ ታኣኮ ዑፆ ማስቶ ጎንጎኬ፤","poem":1},{"text":"ዔዶኦሜ ታኣሮ ማዒፆ ዔርዛኒ ዱርዞ ታኣሲ","poem":2},{"lineBreak":true},{"text":"ዒኢካ ታ ጌሣንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ፒሊስፄኤሜ ዓሳኣ ታ ዴማ ዎርቃንዳኔ» ጌዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ኬልቂ ዲርቂንቴ ካታሜሎ ዖ ታና ዔኪ ዓኣዻንዳይ?","poem":1},{"text":"ዴንዲ ዔዶሚያሴ ሄላኒ ዖ ታና ካኣሌሣንዳይ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ፆኦሲዮ! ኑና ኬኤሬሢ ኔናኬ፤","poem":1},{"text":"ኑኡኮ ዖሎ ዓሶና ዎላ ኬስኪፆ ኔ ሃሼኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዓሲ ዓሲ ማኣዳሢ ዔኤቢ ፓሡዋያኬ፤","poem":1},{"text":"ዬያሮ ሞርኮ ኑኡኮ ኑ ባሻንዳጉዲ ኔ ኑና ማኣዴ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ፆኦሲ ኑኡና ዎላ ማዔያታቴ ኑ ባሻንዳኔ፤","poem":1},{"text":"ዒዚ ሞርኮ ኑኡኮ ዻውሲሳንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}