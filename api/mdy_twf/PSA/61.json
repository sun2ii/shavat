verse","number":6,"content":[{"text":"ካኣቲ ናንጎይዳ ሚርጌ ሌዔ ቃሴ፤","poem":1},{"text":"ሚርጌ ዎዴ ዒዛ ናንጊሼ!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኔ ቤርታ ናንጊና ዒ ካኣታዾንጎ፤","poem":1},{"text":"ዒዛ ካፓንዳጉዲ ኔኤኮ ማኣሪፆንታ ጉሙርቂንቲፆዋ","poem":2},{"lineBreak":true},{"text":"ዒዛም ጊኢጊሼ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ኬላ ኬላ ኔኤም ታ ናኣቤ ናኣቦ ሺኢሺሢና","poem":1},{"text":"ቢያ ዎዴ ጋላታ ዓይኑሞ ታ ኔኤም ዓይናዻንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}