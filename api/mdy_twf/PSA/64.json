{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":64,"content":[{"type":"heading","content":["ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆና ዓይናዺንታ ዳውቴ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ሜታፓ ቶሊ ኬስካኒ ሺኢቂንቴ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ፆኦሲዮ! ታኣኮ ሜቶሮ ኔና ታ ሺኢቃሢ ዋይዜ፤","poem":1},{"text":"ታ ሞርካ ታና ዒጊቻሢዳፓ ታና ካፔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ፑርቶ ዓሳ ታ ጊዳ ጌኔ ማሊሢና ዔቄሢፓ","poem":1},{"text":"ዔያቶኮ ዎጎ ዎጋኒ ቡኮሢዳፓኣ ታና ዓይሴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዔያታ ዒንዲርዞ ፔኤኮ ዓዳ ጬንቻ ዓፓሮጉዲ ዋርቃኔ፤","poem":1},{"text":"ዔያቶኮ ጫንጮ ዑኡዛ ሂኢሺጉዲ ዱካኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ካቲ ዴዒ ፂሎ ዓሶ ዔያታ ዱካኔ፤","poem":1},{"text":"ዓሳ ማሊባኣንቴ ዒጊጩዋዖ ዱካኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ፑርታ ባኣዚ ማዻኒ ዎላ ዞርታኔ፤","poem":1},{"text":"ፒራሢያ ዓኣቺ ፒራኒ ዔያታ ጌስታኔ፤","poem":2},{"text":"ዔያታ ዬያ ቢያ ሂዳዖ፦","poem":1},{"text":"«ዖኦኒያ ዴንቃኒ ኑና ዳንዳዑዋሴ» ጋዓኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዔያታ ጌኔ ማሊሢ ማሊ ቱኬስካፓ፦","poem":1},{"text":"«ዓካሪ ፑርታ ማሊሢ ዶዲ ኑኡኒ ቱኬኔ» ጋዓኔ።","poem":2},{"text":"ዬይያ፦","poem":1},{"text":"ዓሲኮ ዒናንታ ማሊሢያ ጌኔ ባኣዚና ኩሜያ ማዒፆ ዔርዛኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ፆኦሲ ጋዓንቴ ዔያቶ ፔ ሂኢዦና ዱካንዳኔ፤","poem":1},{"text":"ዔያታ ማሊባኣዖ ማኣሳናንዳኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ፔ ዻንጎና ዔያታ ዹቂንታንዳኔ፤","poem":1},{"text":"ባይሲንታ ዔያቶ ሄላንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያሮ ዔያቶ ዛጋ ዓሳ ቢያ ዔያቶ ዾንኪ","poem":2},{"lineBreak":true},{"text":"ቶኦኮ ፔኤሲ ዓጊሣንዳኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዓሲ ቢያ ዒጊጫንዳኔ፤","poem":1},{"text":"ፆኦሲ ማዼ ባኮ ፔጌና ዔያታ ኬኤዛንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒናፓኣ ዔያታ ማላንዳኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ፂሎ ዓሳ ፆኦሲና ዎዛዾንጎ፤","poem":1},{"text":"ዒዛ ፔኤኮ ፑኖ ካያሢ ማሄ ዓሳ","poem":2},{"text":"ዒኖ ፒዜዚንሢያ ቢያ ዎዛዾንጎ።","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}