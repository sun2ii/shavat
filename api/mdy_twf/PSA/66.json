xt":"ባዞ ዒዚ ሳዓ ማሄኔ፤","poem":1},{"text":"ኑኡኮ ቤርታኣ ዓዶንሢ ዎሮ ቶኪና ፒንቄኔ፤","poem":2},{"text":"ዒዚ ማዼ ባኮና ኑኡኒያ ዎዛዼኔ።","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ፔኤኮ ዎልቆና ዒዚ ናንጊና ዎይሣኔ፤","poem":1},{"text":"ዓኣፖና ዴሮ ጊዥ ጌዒ ዛጋኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያሮ ዋይዞ ዒፃ ዓሳ ዒዛ ዑፃ ዔቂባኣቴ ቃራኬ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዒንሢ ዴራ ቢያ ኑ ፆኦዛሢ ቦንቹዋቴ፤","poem":1},{"text":"ዑኡዞ ዒንሢሲ ዼጊዲ ዒዛም ጋላታ ሺኢሹዋቴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኑና ሼምፔና ጌሣሢ","poem":1},{"text":"ቶኮዋ ኑኡኮ ሃሊፁዋጉዲ ካፓሢ ዒዛኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ፆኦሲዮ! ኑ ዎይታቴያ ኔ ኑና ዛጌኔ፤","poem":1},{"text":"ዓዳ ቢራ ዓንጊጉዲ ኔ ኑና ሼኤሼኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ፒሮይዳ ኔ ኑና ዓይሤኔ፤","poem":1},{"text":"ዴኤሢ ባሲ ኑና ኔ ባሲሴኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኑኡኮ ሞርካ ኑና ጎይሢ ባይዚ ሄርቃንዳጉዲ ኔ ኑና ማሄኔ፤","poem":1},{"text":"ታሚና ዲጲናኮ ባኣኪና ኑ ዓኣዼኔ፤","poem":2},{"lineBreak":true},{"text":"ሃሢ ጋዓንቴ ዖርጎቹሞ ኩሜ ዳልጎ ቤዞ ዔኪ ኔ ኑና ሙኬኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ኔ ማኣሪ ሚቺ ዒንጎ ዒንጊፆ ዔኪ ታ ጌላንዳኔ፤","poem":1},{"text":"ታኣኮ ናኣቦዋ ታ ኔኤም ሺኢሻንዳኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ፑርታ ሜታ ታና ሄሌ ዎዶና","poem":1},{"text":"«ኔኤም ታ ዒንጋንዳኔ» ጌዔ ናኣቦ ታ ሺኢሻንዳኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሶቦሮ ጌማቶ ሚቺ ዒንጎ ዒንጊሢ ማሂ","poem":1},{"text":"ዓዶ ማራቶዋ ሳውቃ ዒንጊሢ ማሂ","poem":2},{"lineBreak":true},{"text":"ታ ኔኤም ሺኢሻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዚዮ ጌማቶንታ ኮላቶንታ ታ ኔኤም ሹካንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ዒንሢ ፆኦሲ ዒጊጫ ዓሳ ሃኒ ሙኪ ዋይዙዋቴ፤","poem":1},{"text":"ታ ሼምፔሎም ዒዚ ማዼ ባኮ ታ ዒንሢም ኬኤዞም።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ታኣኒ ዒዛ ባንሢ ዒላቴኔ፤","poem":1},{"text":"ታ ዻንጎናኣ ታ ዒዛ ጋላቴኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ጎሞ ታኣኮ ታ ቡኡፁዋዖ ዎንዴ ዒና ዓኣቼያታቴ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ሺኢጲፆ ታኣኮ ዋይዚንዱዋንቴኬ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ሃሢ ጋዓንቴ ፆኦሲ ጎኔና ዋይዜኔ፤","poem":1},{"text":"ታኣኒ ሺኢቃ ዑኡዞ ዒናፓ ዒ ዋይዜኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ሺኢጲፆ ታኣኮ ቦሂባኣሢ","poem":1},{"text":"ሚጪንቲፆዋ ታና ሃሺባኣሢ","poem":2},{"lineBreak":true},{"text":"ዬይ ፆኦዛሢ ጋላቲንቶንጎ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}