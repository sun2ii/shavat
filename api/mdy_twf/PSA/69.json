":[{"text":"ፆኦሲዮ! ኔኤኒ ታኣኮ ዔኤያቶ ዔራኔ፤","poem":1},{"text":"ታ ዻቢንታ ኔኤም ዓኣሺንቴያቱዋሴ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ቢያ ባኮ ዎይሣ ጎዳሢዮ!","poem":1},{"text":"ኔና ዎዛ ማሂ ካፓ ዓሳ","poem":2},{"text":"ታ ጊዳ ማዺንታ ባኮ ዛጊ ቦርሲንቶፓ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢዮ!","poem":2},{"lineBreak":true},{"text":"ኮሺ ኔና ኮዓ ዓሳ ታ ጊዳ ማዺንታ ባኮ ዛጊ ዻውሲንቶፓ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኔ ጋይቴ ጌዒ ጫሺ ታ ጊቤኔ፤","poem":1},{"text":"ቦርሲንቲና ዓኣፖ ካራ ታኣኮ ቦኦሬኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታ ጌርሲንሢም ዓዳ ፃንጎ ዓሲጉዲ","poem":1},{"text":"ታኣኮ ዒንዶ ናኣቶማኣ ሾኦቺ ታ ማዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ኔ ማኣሮ ዛሎ ባካ ታና ሻላኔ፤","poem":1},{"text":"ኔና ጫሽኮ ጫዣ ታ ዑፃ ማዔኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሼምፓሢ ታኣኮ ታ ሙዖ ሃሾ ዳምቦና ሜታሴኔ፤","poem":1},{"text":"ዬያሮዋ ዔያታ ታና ፓሴኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሲዮ ፓቲሎ ታ ማይንቴ ዎዶና","poem":1},{"text":"ዔያታ ታና ዓማሊ ማሂ ሚኢጬኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዲሮ ካራ ዴዓ ዓሶም ጌኤሲ ጌስቶያ","poem":1},{"text":"ማሢንቴ ዓሶማኣ ኮሢ ኮርጎያ ታ ማዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ኔ ናሽካ ዎዶና ታ ኔና ሺኢቃንዳኔ፤","poem":2},{"text":"ፆኦሲዮ! ኔኤኮ ዼኤፖ ማኣሪፆና","poem":1},{"text":"ኔኤኮ ዓውሲፆ ጎኑሞና ታኣም ዋይዜ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ቶኦጳሢዳፓ ታና ኬሴ፤","poem":1},{"text":"ዔኤዺንታንዳጉዲ ታና ሃሺፖ፤","poem":2},{"text":"ዋኣፆ ዔታፓ","poem":1},{"text":"ዬያቶንታ ታና ዒፃዞንሢናፓ ሄሊ ዓውሴ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዲጳ ኩሚ ዔኪ ታና ዓኣዾፓ፤","poem":1},{"text":"ዋኣፆ ዔታኣ ታና ዔኤዾፓ፤","poem":2},{"lineBreak":true},{"text":"ዔታ ዶዒ ካሮ ታኣኮ ባይዞፓ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ማኣሪፃ ኔኤኮ ሚርጌ ማዔሢሮ","poem":1},{"text":"ታኣም ዋይዜ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ሚጪንቶ ሚርጉሞና","poem":2},{"lineBreak":true},{"text":"ታ ባንሢ ሺሬ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ታና ኔ ዓይላሢዳፓ ዓኣፖ ኔኤሲ ሺርሺፖ፤","poem":1},{"text":"ታኣኒ ሜቶይዳታሢሮ ዑኬና ታኣም ዋይዜ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ታ ባንሢ ሙኪጋፓ ታና ዓውሴ፤","poem":1},{"text":"ታ ሞርኮ ኩጫፓኣ ታና ጊንሣ ማሂ ሻንቂ ዓይሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ታና ሄሌ ጫዦንታ ቦርሲንቶንታ","poem":1},{"text":"ዻውሲንቶዋ ኔ ዔራኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኮ ሞርኮዋ ፔቴ ፔቴ ኔ ዔራኔ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ጫዣ ዒኖ ታኣኮ ሜንሤኔ፤","poem":1},{"text":"ዎዛ ባይቂ ታኣኮ ጋፔኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣም ሚጪንታ ዓሲ ታ ኮዔኔ፤","poem":2},{"lineBreak":true},{"text":"ጋዓንቴ ታ ዴንቂባኣሴ።","poem":2},{"text":"ታና ዶዲሻ ዓሲያ ታ ኮዔንቴ","poem":1},{"text":"ፔቴታዖ ባኣሴ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ዔያታ ሙዖ ታኣኮ ጪሼና ሲኢሬኔ፤","poem":1},{"text":"ታ ዼኤቢንታዛ ሶልኪ ዑሺ ታኣም ዒንጌኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዔያቶም ሺኢሾና ካፃ ፒሮ ዔያቶም ማዖንጎ፤","poem":1},{"text":"ዔያቶኮ ሙዖሮ ቡኪንቲፃኣ ባይሲንታ ካራ ማዖንጎ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዓኣፓ ዔያቶሲ ዛጉዋጉዲ ዹሞንጎ፤","poem":1},{"text":"ጊኢራ ቢያ ዎዴ ዎቦንጎ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዱማ ዱማ ኔኤኮ ዎዻ ባኮ ዔያቶ ዑፃ ኬይሴ፤","poem":1},{"text":"ዔያታ ዔሪባኣንቴ ኔ ዻጎ ዔያቶ ዑፃ ጮኦሽኬ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ጉርዳ ዔያቶሲ ዳውሌ ማዖንጎ፤","poem":1},{"text":"ዓፒሎና ማዦና ማኣራ ዔያቶኮ ዓሲ ናንጎፓ።","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ኔ ጳርቄ ዓሶ ዔያታ ዳውሴኔ፤","poem":1},{"text":"ኔ ኪፃሴ ዓሶኮ ሜታሢ ዔያታ ዳልጊሼኔ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዻቢንቶይዳ ዔያቶኮ ዻቢንቲ ቃሴ፤","poem":1},{"text":"ኔ ፂሉሞ ባንሢያ ዑኮፓ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ናንጎ ማፃኣፓፓ ዔያታ ቃኣጪንቶንጎ፤","poem":1},{"text":"ፂሎ ዓሶና ዎላ ፃኣፒንቶፓ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ጋዓንቴ ታኣኒ ሜቶ ዋኣዪሢዳ ዓኣኔ፤","poem":1},{"text":"ፆኦሲዮ! ኔኤኮ ዓውሲፃ ኬልቂ ታና ዓርቆንጎ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ፆኦሲኮ ሱንፆ ጋላቲሢና ታ ዓይናዻንዳኔ፤","poem":1},{"text":"ጋላቲሢና ታኣኒ ዼግ ዼጊዳንዳ