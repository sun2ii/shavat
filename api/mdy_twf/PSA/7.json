{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":7,"content":[{"type":"heading","content":["ዳውቴ ቢኢኒያሜ ዓሢ ኩዛ ዛሎ ፆኦሲም ዓይናዼ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ፒዚ ዎጌ ዎጊንታንዳጉዲ ሺኢቂንቴ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዔ ታ ፆኦዛሢዮ!","poem":1},{"text":"ኔኤኒ ታኣኮ ዓኣሺንቲ ቶሎ ካያሢኬ፤","poem":2},{"lineBreak":true},{"text":"ታና ዳውሳ ዓሶ ቢያሢፓ ማኣዲ ዓውሴ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኔኤኒ ዬያይዲባኣያ ማዔቴ","poem":1},{"text":"ዔያታ ታና ዓዳ ዞቢጉዲ ሾኦላንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዓውሳ ዓሲባኣ ቤስካ ዳርዚ ታና ዔያታ ላኣላንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዔ ታ ፆኦዛሢዮ!","poem":1},{"text":"ፔቴ ዓሲምታዎ ፑርታ ባኣዚ ታ ማዼቴ","poem":2},{"lineBreak":true},{"text":"ታ ላጋሢ ታኣም ማዼ ኮዦ ባኮ ዛሎ ፑርታ ማዺ ታ ማሄቴ","poem":2},{"lineBreak":true},{"text":"ታ ሞርካሢ ዚቲ ጋዓዖ ታኣኒ ቡሬያ ማዔቴ","poem":2},{"lineBreak":true},{"text":"ዬያ ባኮ ቢያይዳፓ ፔቴማታዎ ታ ማዼያታቴ፥","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ታ ሞርካሢ ዳውሲ ታና ዓርቆንጎ!","poem":1},{"text":"ሲላሎይዳ ኮላሲ ቦንቾ ታኣኮ ባይዞንጎ፤","poem":2},{"lineBreak":true},{"text":"ዒዚ ታና ዎዎዾንጎ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔ ዻጎና ዔቄ፤","poem":1},{"text":"ታ ሞርኮኮ ዻጎ ኔኤኒ ባይዜ፤","poem":2},{"lineBreak":true},{"text":"ዎጋ ፒዜ ማዓንዳጉዲ ኔኤኒ ዓይሤ ጎይፆና","poem":2},{"lineBreak":true},{"text":"ታና ማኣዳኒ ዔቄ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሜሌ ዴሮ ኔ ባንሢ ቡኩሲ","poem":1},{"text":"ዑፃ ዔያቶኮ ካኣቲ ማዒ ዎይሤ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሜሌ ዴሮ ዑፃ ዎጋኔ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳሢዮ! ታ ፂሉሞጉዴያ ታኣም ዎጌ፤","poem":2},{"lineBreak":true},{"text":"ዼኤፖ ፆኦዛሢዮ! ታ ፒዙሞጉዴያ ታኣም ዒንጌ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዓሲኮ ዒኔና ማሊሢና ዛጋ ፂሎ ፆኦዛሢዮ!","poem":1},{"text":"ፑርቶ ዓሶኮ ዋይዞ ዒፂፆ ባይዜ፤","poem":2},{"lineBreak":true},{"text":"ፂሎ ዓሶ ጋዓንቴ ኔኤኒ ካፔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ታኣኮ ጊቲማሢ፥ ዼኤፖ ፆኦዛሢኬ፤","poem":1},{"text":"ዒኖ ፒዜ ዓሶ ዒዚ ዓውሳኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ፆኦሲ ፂሎ ዎጌ ዎጋያኬ፤","poem":1},{"text":"ዻጎዋ ፔኤሲ ኬላ ኬላ ፔጋሲ ዻዋያኬ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዓሲ ፔኤኮ ጎሞ ቡኡፂ ሃሹዋያ ማዔቴ","poem":1},{"text":"ዒዚ ጬንቾ ዓፓሮ ፔኤሲ ዋርቃኔ፤","poem":2},{"lineBreak":true},{"text":"ሂኢዦዋ ፔኤኮ ዓኣሣኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዒዚ ፔኤኮ ዎዻ ዖሎ ዓንጋሞ ኮሻኔ፤","poem":1},{"text":"ታሚጉዲ ዔኤታ ሂኢዦዋ ጊኢጊሻኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ፑርቱሞ ማሊ ማሊ ዓኣ ዓሲ","poem":1},{"text":"ጌኔ ማዾ ጎጳዺ፥ ሉኡዙሞ ሾዓኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሜሌ ዓሲም ኬሴ ዔቴ ቦኦካ ዓሲ","poem":1},{"text":"ዬያ ዒ ቦኦኬ ዔታ ፔኤሮ ጌላኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዒዚ ማዼ ጌኖ ማዻ ዒዛም ማዓኔ፤","poem":1},{"text":"ዒ ማዼ ፑርቶ ባካ ዒዛ ቶኦካ ኬዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ናንጊና ናንጋ ጎዳኮ ፂሉሞሮ ታ ዒዛ ጋላታንዳኔ፤","poem":1},{"text":"ዼኤፖ ፆኦዛሢ ሱንፆ ቦንቺ ጋላታ ዓይኑሞ ታ ዓይናዻንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}