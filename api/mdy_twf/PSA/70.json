{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":70,"content":[{"type":"heading","content":["ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆና ማሊ ጶቂሥሢሮ ዓይናዺንታ ዳውቴ ዓይኑሞ"]},{"type":"verse","number":1,"content":[{"text":"ፆኦሲዮ! ታና ዓውሳኒ ታ ባንሢ ሺሬ!","poem":1},{"text":"ናንጊና ናንጋ ጎዳሢዮ! ታና ማኣዳኒ ሩኡሬቴራ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታኣኮ ሼምፓሢ ባይዛኒ ኮዓዞንሢ","poem":1},{"text":"ቦርሲንቶንጎ፥ ዲቃቲ ካራ ባይዞንጎ፤","poem":2},{"text":"ታኣኮ ባይሲንቶ ካፓዞንሢ","poem":1},{"text":"ዻውሲንቲ ጊንሢም ማዖንጎ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታ ዑፆይዳ፦ «ማዳ ዒዛም!» ጋዓዞንሢ","poem":1},{"text":"ቦርሲንቲ ጊንሢም ማዖንጎ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ጋዓንቴ ኔና ኮዓዞንሢ ቢያ ኔኤና ሚርጌና ዎዛዾንጎ፤","poem":1},{"text":"ኔኤኮ ዓውሲፆ ናሽካዞንሢ ቢያ ዎዴ፦","poem":2},{"lineBreak":true},{"text":"«ፆኦሲ ዼኤፒኬ!» ጎዖንጎ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ፆኦሲዮ! ታኣኒ ጋዓንቴ ማንቆ፥ ሃሣ ሜታዼ ዓሲኬ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳሢዮ! ሩኡሪና ታና ሄሌ፤","poem":2},{"text":"ታና ማኣዳሢና ዓውሳሢያ ኔናታሢሮ","poem":1},{"text":"ፆኦሲዮ! ኔኤኒ ኔጊፖ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}