ue},{"text":"ቢያ ዎዴ ታኣኮ ጋላቶሢ ኔናኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ኔኤኒ ታ ዛሎ ዶዲ ዖልታሢ ማዔሢሮ","poem":1},{"text":"ናንጋ ታኣኮ ሚርጌ ዓሶም ማላታ ማዔኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሮኦሮ ጉቤ ኔኤኮ ቦንቾ ኬኤዛኒ","poem":1},{"text":"ዻንጋ ታኣኮ ጋላታ ሌሊ ማዔኔ፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ሃሢ ታ ጋርቼቴያ ታና ኬኤሪፖ፤","poem":1},{"text":"ዎልቃ ታኣኮ ጋፓዛኣ ታና ሃሺፖ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሞርካ ታኣኮ ዎላ ጌስቴኔ፤","poem":1},{"text":"ሼምፓሢ ታኣኮ ባይዛኒ ኮዓ ዓሳ ዎሊና ዞርቴኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዔያታ ዒማና፦ «ፆኦሲ ዒዛ ሃሼኔ፤","poem":1},{"text":"ዒዛ ዓውሳንዳይ ባኣሢሮ","poem":2},{"lineBreak":true},{"text":"ዳውሲ ዒዛ ዓርቁዋቴራ» ጌዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ፆኦሲዮ! ኔ ታ ኮራፓ ሃኪፖ፤","poem":1},{"text":"ታ ፆኦዛሢዮ! ታና ማኣዳኒ ሩኡሬ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ማኪ ታና ዒፃዞንሢ ዒጊጪ ባይቆንጎ፤","poem":1},{"text":"ማኣሳንሣኒ ኮዓዞንሢያ ቶኦቺንቲ ዻውሲንቶንጎ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታኣኒ ጋዓንቴ ቢያ ዎዴ ኔና ጉሙርቃኔ፤","poem":1},{"text":"ቃሲ ቃሲ ጋላታ ታ ኔኤም ሺኢሻኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዻንጋ ታኣኮ ኔ ፂሉሞ ሮኦሮ ጉቤ","poem":1},{"text":"ኔ ዻቂሺፆ ኬኤዛኔ፤","poem":2},{"lineBreak":true},{"text":"ጌኤዞ ዎማካ ዔቂሶንዶቴያ ታኣም ዔርቲባኣሴ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታኣኒ ሙኪ ናንጊና ናንጋ ጎዳኮ","poem":1},{"text":"ዶዶ ማዾ ኬኤዛንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ኔ ፂሉሞ ሌሊ ታኣኒ ኬኤዛንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ፆኦሲዮ! ኔኤኒ ታና ናኣቱሞፓ ዓርቃዖ ዔርዜኔ፤","poem":1},{"text":"ታኣኒያ ሃኖ ሄላንዳኣና ኔኤኮ ሄርሺሲ ዲቃሣ ዓኮ ማዾ ኬኤዛኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ፆኦሲዮ! ታኣኒ ጋርቺ ቡኡቄቴያ","poem":1},{"text":"ኩጮ ኔኤኮ ሙካ ሾይንቶም","poem":2},{"lineBreak":true},{"text":"ዎልቆዋ ጊንፃ ኬስካ ዴሮም","poem":2},{"lineBreak":true},{"text":"ቢያ ታ ኬኤዛንዳያ ሄላንዳኣና ኔ ታና ሃሺፖ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ፆኦሲዮ! ፂሉማ ኔኤሲ ጫሪንጮ ሄላያኬ፤","poem":1},{"text":"ኔኤኒ ዼኤፒ ዼኤፒ ባኣዚ ማዼኔ፤","poem":2},{"lineBreak":true},{"text":"ፆኦዛሢዮ! ኔጉዴያ ዖናዳይ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ኔኤኒ ታና ሚርጌ ሜቶና ዋኣዪሢና ሄሊሴታቴያ","poem":1},{"text":"ናንጎ ታኣሲ ኔ ጊንሣ ዓካሳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሳዖ ዴሞ ዔቶይዳፓ","poem":2},{"lineBreak":true},{"text":"ላሚ ታና ኔ ኬሳንዳኔ።","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ታኣኮ ቦንቾ ታኣም ኔ ቃሳንዳኔ፤","poem":1},{"text":"ማሂ ኔ ታና ጊንሣ ዶዶሻንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ፆኦሲዮ! ኔኤኮ ጉሙርቂንቲፆ ዛሎ","poem":1},{"text":"ጎኦላ ዋርቂ ታ ኔና ጋላታንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዒስራዔኤሌ ዓሶኮ ፆኦዛሢዮ!","poem":2},{"lineBreak":true},{"text":"ዓይኑሞ ዓንጋሞና ጋላታ ዓይኑሞ ታ ኔኤም ሺኢሻኔ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ታኣኒ ኔኤም ዓይኑሞ ዓይናዻ ዎዶና","poem":1},{"text":"ሙሱራ ታኣኮ ዎዛና","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ማሂ ሻንቂ ዓውሴ ሼምፔላኣ ዒላሻኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዻንጋ ታኣኮ ኔ ፂሉሞ ዛሎ ሮኦሮ ጉቤ ኬኤዛኔ፤","poem":1},{"text":"ታና ሜታ ሄላንዳጉዲ ኮዓዞንሢ","poem":2},{"lineBreak":true},{"text":"ቦርሲንቴኔ፥ ጋፒ ዻውሲንቴኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}