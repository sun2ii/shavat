{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":72,"content":[{"type":"heading","content":["ሃጊ ሙካ ካኣታሢ ፆኦሲ ማኣዳንዳጉዲ ሺኢቂንቴ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ፆኦሲዮ! ኔኤኮ ዎጎ ካኣቲም","poem":1},{"text":"ፂሉሞዋ ኔኤኮ ካኣቲ ናኣዚም ዒንጌ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዒዚ ኔ ዴሮኮ ጌኤዞ ፂሉሞና ዛጋንዳኔ፤","poem":1},{"text":"ሜታዼዞንሢማኣ ፒዙሞና ዎጋንዳኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዹካ ዖርጎቹሞ","poem":1},{"text":"ጌሜራኣ ዴሮም ፂሉሞ ዓኣፒ ዔኪ ዬዓንዳኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዒዚ ሜታዼ ዴሮም ሞኦቲንታንዳኔ፤","poem":1},{"text":"ማንቆ ዓሶዋ ዓውሳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዓሶ ሄርቂ ዎይሣ ዓሶዋ ዒ ጋኣጫንዳኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዓባ ዓኣ ዎዶይዳ ቢያ","poem":1},{"text":"ዓጊናኣ ፖዓ ዎዶይዳ ቢያ","poem":2},{"lineBreak":true},{"text":"ሾይንቲፓ ሾይንቲ ሄላንዳኣና ዒዚ ናንጋንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ሃኣኮ ቡሪንቴም ማኣሊዳ ዋርቃ ዒርዚጉዲ","poem":1},{"text":"ዒ ዋርቃንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዓዳ ፁቢ ዒርዚጉዲ ሳዓ ጌላንዳኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዒዛ ካኣቱሞና ፂሉሞ ሚርጋንዳኔ፤","poem":1},{"text":"ዓጊና ፖዖ ሃሻንዳያ ሄላንዳኣና","poem":2},{"lineBreak":true},{"text":"ዖርጎቹማ ዒዛኮ ሚርጊ ዴዓንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ዒዛ ዓጮኮ ዛጳ ባዛፓ ባዞ ሄላንዳኣና","poem":1},{"text":"ዔፕራፂሴ ዎራፓ ዴንዲ ዓጮ ጋፖ ሄላንዳኣናኬ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዳውሎ ዓጮ ዓሳ ዒዛም ዚጋንዳኔ፤","poem":1},{"noteId":1},{"text":"ሞርካ ዒዛኮ ዒዛ ቤርታ ሎኦሚ ዓጪ ኩኡላንዳኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ቴርሴሴንታ ዋኣፆ ሳዛ ዓኣ ዓጮ ካኣታኣ","poem":1},{"text":"ጊኢራ ሚኢሼ ዒዛም ዔኪ ዬዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ዓሬቤንታ ሳኣባ ዓጮ ካኣታኣ ዔኤቢ ዒንጋኒ ዒዛም ሺኢሻንዳኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ካኣታ ቢያ ዒዛም ዚጋንዳኔ፤","poem":1},{"text":"ዴራኣ ቢያ ዒዛም ዎርቃንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ሜታዼሢ ዒላታ ዎዶና","poem":1},{"text":"ማንቆ ዓሶንታ ማኣዳይ ባኣ ዓሶዋ ዒዚ ሄሊ ዓውሳንዳኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ማንቆንታ ሜታዼ ዓሶንታም ዒ ሚጪንታንዳኔ፤","poem":1},{"text":"ዬያቶ ሃይቢዳፓኣ ዒ ዓውሳንዳኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ሄርቂንቲ ዎርቆ ዎይፆይዳፓ ዒዚ ዔያቶ ኬሳኔ፤","poem":1},{"text":"ሱጉፃ ዔያቶሲ ዒዛ ቤርታ ቦንቺንቴያኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ካኣታሢ ሚርጌ ሌዔ ናንጎም!","poem":1},{"text":"ሳኣባ ዓጮይዳፓ ዎርቄ ዒዛም ሺኢኮም፤","poem":2},{"lineBreak":true},{"text":"ሺኢጲሢያ ቢያ ዎዴ ዒዛም ሺኢቂንቶም፤","poem":2},{"lineBreak":true},{"text":"ቢያ ዎዴ ፆኦሲኮ ዓንጃ ዒዛም ማዖም።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዓጫ ዒዛሲ ሚርጌ ሃኣኮ ካሦም፤","poem":1},{"text":"ዹካ ዒዛኮ ሃኣኮ ባቃልሶም፤","poem":2},{"lineBreak":true},{"text":"ሊባኖኦሴ ዹኮጉዲ ማሊ ማዖም፤","poem":2},{"text":"ሃኣኮኮ ናታ ዒዛኮ ማኣቲጉዲ ሚርጎም።","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ሱንፃ ዒዛሲ ናንጊና ዶዲ ናንጎም!","poem":1},{"text":"ዔርቲፃ ዒዛኮ ዓቢ ናንጋሢጉዲ ማዖም፤","poem":2},{"text":"ዴሬ ቢያ ዒዛና ዓንጂንቶም፤","poem":1},{"text":"ዴራ ቢያ፦ «ኔኤኒ ዓንጂንቴያኬ!» ዒዛ ጎዖም።","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ፔኤሮ ሌሊ ሄርሺሲ ዲቃሣ ዓኪ ባኣዚ ማዻ","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ማዔ ዒስራዔኤሌ ፆኦዛሢ ዓንጂንቶም!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ዒዛኮ ቦንቾ ሱንፃ ናንጊና ዓንጂንቶም፤","poem":1},{"text":"ዓጫ ቢያ ዒዛኮ ቦንቾና ኩሞም!","poem":2},{"lineBreak":true},{"text":"ዓኣሜን! ዓኣሜን!","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ዒሴዬ ናኣዚ ዳውቴ ሺኢጲፃ","poem":1},{"text":"ሃይማ ሄሊ ጋፔኔ።","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"72፡9 ዳውሎ ዓጮ ዓሳ ዒዛም ዚጋንዳኔ ጋዓዞ፦ ላንካይታሞ ዓሳ ቡሌ ማፃኣፖይዳ «ዒቶጲያ ዒዛም ዚጋንዳኔ» ጋዓኔ።","reference":{"chapter":72,"verse":9}}]},"thisChapterLink":"/api/mdy_twf/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}