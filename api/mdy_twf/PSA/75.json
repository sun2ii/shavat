se","number":6,"content":[{"text":"ዎጌ ዓባ ኬስካ ባንፃፓ ማዖም ጌላ ባንፃፓ","poem":1},{"text":"ጊንሣ ሃሣ ዓሲ ናንጉዋ ዳውላፓ ሙኩዋሴ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ፔቴሢ «ዻቤኔ» ጌዒ ዎጋሢ","poem":1},{"text":"ባጋሢ «ዔኤቢ ኔኤኮ ባኣሴ» ጌዒ","poem":2},{"lineBreak":true},{"text":"ፒዜ ዎጋሢ ፆኦሲኬ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዑዦ ዑሽኮ ዓንጋ ናንጊና ናንጋ ጎዳኮ ኩጫ ዓኣኔ፤","poem":1},{"text":"ኮይሳሢጉዲ ጊኢጊሾና ዱባዻ ዎይኖ ዑዣ ኩሚ ዓኣኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያ ዒ ዓንጋፓ ላኣላዛ ሳዖይዳ ዋይዞ ዒፃ ዓሳ","poem":2},{"lineBreak":true},{"text":"ሞጮዋ ዓይሱዋዖ ጋፒሲ ዑሽካንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ታኣኒ ጋዓንቴ ዬያ ናንጊና ኬኤዛንዳኔ፤","poem":1},{"text":"ያይቆኦቤ ፆኦዛሢም ዓይኑሞ ሺኢሻንዳኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ፑርቶ ዓሶኮ ካኣሮ ቢያ ታ ሜንሣንዳኔ፤","poem":1},{"text":"ፂሎ ዓሶሲ ጋዓንቴ ዼግ ጋዓንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}