,{"lineBreak":true},{"text":"ፓራሢ ቶጌ ዓሳ ፓራሢና ዎላ ሃይቄኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ዒጊጮንዶያ ኮይሳሢ ኔና ሌሊኬ፤","poem":1},{"text":"ኔኤኒ ዻጋዼ ዎዶና ኔ ቤርታ ዖኦኒ ዔቃኒ ዳንዳዓንዳይ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኔኤኒ ጫሪንጫፓ ዎጎ ኬኤዜም","poem":1},{"text":"ሳዔላ ዋይዚ ዒጊቹሞና ዚቲዮ ጌዔኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፆኦሲዮ! ዬይ ያዺ ማዔሢ","poem":1},{"text":"ኔኤኒ ሳዖይዳ ሜታዼ ዓሶ ዓውሳኒ","poem":2},{"lineBreak":true},{"text":"ዎጎሮ ዔቄ ዎዶናኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ዓሲ ሜቶ ዓጊ ኔኤኒ ጎሬቴያ ኔ ቦንቾም ማዓኔ፤","poem":1},{"text":"ዬያ ጎሪንቶፓ ቶሌዞንሢያ ሪኢራኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዔ ዒንሢ ፆኦዛሢም ናኣቡዋቴ፤","poem":1},{"text":"ዒንሢ ናኣቤ ናኣቦዋ ኩንሡዋቴ፤","poem":2},{"text":"ዒዛኮ ዑኬ ዓኣ ዓሳ ቢያ","poem":1},{"text":"ዒጊቻያ ማዔሢም ዒንጎ ባኣዚ ሺኢሾንጎ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዒዚ ዖቶርቃ ሱኡጎ ዻውሲሳኔ፤","poem":1},{"text":"ዼኤፖ ዼኤፖ ካኣቶዋ ጎቃይሳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}