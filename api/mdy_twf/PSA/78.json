pe":"verse","number":19,"content":[{"text":"ፆኦሲ ዑፃ ጉንዱሚ ጌስቴሢ","poem":1},{"text":"«ፆኦሲ ዓሲ ናንጉዋ ዳውሎይዳ ሙኡዚ ጊኢጊሺ ዒንጋኒ ዳንዳዓ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ዒዚ ላሎ ዹኡሲሢና ዋኣፆ ዲጲጉዲ ዎይሴሢ ጎኔኬ፤","poem":1},{"text":"ሂዴቴያ ሙኡዚ ኑም ዒንጋኒና ዓሽኪ ጊኢጊሻኒ ዳንዳዓኔ ጌይሢዳ?» ጌዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዬያ ዋይዛዖ ሚርጌና ዻጋዼኔ፤","poem":1},{"text":"ያይቆኦቤ ዑፆይዳ ታሚ ዔኤቴኔ፤","poem":2},{"lineBreak":true},{"text":"ዻጋ ዒዛኮ ዒስራዔኤሌይዳ ዔቄኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ዔያታ ዒዛ ጉሙርቂባኣሴ፤","poem":1},{"text":"ዒዛኮ ዓውሲፆናኣ ጌኤቂንቲባኣሴ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዒዚ ጋዓንቴ ሎፓ ሻኣሮ ዓይሤኔ፤","poem":1},{"text":"ጫሪንጮኮዋ ካሮ ቡሌኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዔያታ ሙዓንዳጉዲ ማና ዒ ዲኢኒሼኔ፤","poem":1},{"text":"ጫሪንቺዳ ዓኣ ሙኡዚ ዔያቶም ዒንጌኔ።","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ዓሲ ኪኢታንቾ ካሦ ሙዔኔ፤","poem":1},{"text":"ሚሽኪ ዶምባ ዓይሳንዳያ ሄላንዳኣና","poem":2},{"text":"ሙዖ ዔያቶም ዒንጌኔ።","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ጫሪንጫፓ ዓባ ኬስካ ባንፆ ዢባሮ ዒ ዔቂሴኔ፤","poem":1},{"text":"ዾኦሎ ባንፆ ዢባሮዋ ዔኪ ሙኬኔ።","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ዓሽኪ ዔያቶም ዓጪጉዲ","poem":1},{"text":"ባራና ካፖዋ ባዞ ዓጮ ማኣሻሎጉዲ ዒ ኬይሴኔ።","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ዔያቶኮ ጉርዶ ባኣኮይዳ","poem":1},{"text":"ዓፒሎና ማዢንቴ ማኣሮ ኮራኣ ኬይሴኔ።","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ዔያታ ሚሽካንዳያ ሄላንዳኣና ሙዔኔ፤","poem":1},{"text":"ዔያታ ሚርጌና ዓፃዼ ባኮ ዔያቶም ዒ ዒንጌኔ።","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ጋዓንቴ ሃጊ ሱኡካ ዔያቶኮ ማዑዋንቴ","poem":1},{"text":"ሙዓ ዔያቶኮ ዻንጋ ዓኣ ጎይሣ ዓኣንቴ","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ፆኦሲኮ ጎሪንታ ዔያቶ ዑፃ ሙኬኔ፤","poem":1},{"text":"ዔያቶ ባኣካፓ «ኑ ዶዲኬ» ጋዓ ዓሶ ዎዼኔ፤","poem":2},{"lineBreak":true},{"text":"ሃጋ ቡኖ ማዔ ዼጌሢያ ማንፄኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"ዬይ ቢያ ማዔንቴያ ዔያታ ፔኤኮ ዻቢንቶና ዶዴኔ፤","poem":1},{"text":"ዒዚ ማዻ ዲቃሣ ባኮ