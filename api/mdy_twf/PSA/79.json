{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":79,"content":[{"type":"heading","content":["ዓሳኣፔ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ዴሮኮ ኮሹሞ ዛላ ሺኢቂንቴ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ፆኦሲዮ! ሜሌ ዴራ ዴኖ ኔኤኮ ዓርቄኔ፤","poem":1},{"text":"ኔኤኮ ዱማዼ ጌኤዦ ማኣሮዋ ዔያታ ዒኢሴኔ፤","poem":2},{"lineBreak":true},{"text":"ዬሩሳላሜ ሻሂ ዔያታ ባይዜኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኔ ዓይሎኮ ሌዞ ጫሪንጮ ካፖም","poem":1},{"text":"ኔኤኮ ዱማዼዞንሢኮዋ ዓሽኮ ካዮ ቦዖም","poem":2},{"lineBreak":true},{"text":"ሙኡዚ ማሂ ዔያታ ዒንጌኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሱጉፆ ዔያቶኮ ዬሩሳላሜይዳ ዓዳ ዋኣሢጉዲ ዔያታ ላኣሌኔ፤","poem":1},{"text":"ዬያ ዓሶ ዱኡካ ዓሲያ ጴዺባኣሴ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኑኡኒ ኑ ዓሺኖም ሚኢቺ","poem":1},{"text":"ኑ ኮይላ ዓኣ ዓሶማኣ ዓማሊ ባኣዚ ማዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ሃይ ዓይዲ ሄላንዳኣናዳይ?","poem":1},{"text":"ኔኤኒ ዻጋዻሢ ናንጊና ጋፑዋያዳ?","poem":2},{"lineBreak":true},{"text":"ሜሌ ካኣሽኪንቱዋጉዲ ኮዓ ኔ ማሊፃ ታሚጉዲ ዔኤቴ ጎይሣ ናናንጋ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኔና ዔሩዋ ሜሌ ዴሮ ዑፃ","poem":1},{"text":"ሱንፆዋ ኔኤኮ ዔኤሉዋ ካኣቶ ዑፃ","poem":2},{"lineBreak":true},{"text":"ዱማ ዱማ ኔኤኮ ዎዻ ባኮ ዳኬ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዔያታ ያይቆኦቤ ሙዔኔ፤","poem":1},{"text":"ዔያቶኮ ናንጎ ቤዞዋ ዓሲ ናንጉዋ ዳውሌ ማሄኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ኑ ዓዶንሢ ጎሞ ኑ ዑፃ ማሂፖ፤","poem":1},{"text":"ማኣሪፃ ኔኤኮ ዑኬና ኑ ባንሢ ሙኮንጎ፤","poem":2},{"lineBreak":true},{"text":"ኑኡኒ ዓኣሢያ ሜቶይዳኬ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኑና ዓውሳያ ማዔ ፆኦዛሢዮ!","poem":1},{"text":"ኔ ሱንፆ ቦንቾሮ ጌዒ ኑና ማኣዴ፤","poem":2},{"lineBreak":true},{"text":"ኔ ሱንፆሮ ጌዒያ ሄሊ ኑና ዓውሴ፤","poem":2},{"lineBreak":true},{"text":"ጎሞዋ ኑኡኮ ዓቶም ጌዔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዴራ፦ «ፆኦዛሢ ዔያቶኮ ዎካዳዖ?» ዓይጎሮ ጋዓይ?","poem":1},{"text":"ኔኤም ማዻ ዓሶ ሱጉፆ ዛሎ ኮሞ ኮፄ፤","poem":2},{"lineBreak":true},{"text":"ኑ ዓኣፓ ዛጋንቴ ዬያ ማዼ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ቱኪንቲ ዓኣ ዓሶኮ ሜቶ ዒላታ ኔ ቤርቶ ሄሎንጎ፤","poem":1},{"text":"ሃይቆንጎ ጌይ ዎጊንቴ ዓሶዋ ኔ ዎልቆና ዓውሴ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኑ ዓሺና ኔና ሚኢጬ ሚኢጮ","poem":1},{"text":"ላንካይ ጳንጬ ማሂ ዔያቶ ኮንቂሴኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኑኡኒ ኔኤኮ ዴራ፥ ኔኤኒ ሄንቃ ማራታ","poem":1},{"text":"ናንጊና ጋላታ ኔኤም ሺኢሻኔ፤","poem":2},{"lineBreak":true},{"text":"ሾይንታፓ ሾይንቲ ሄላንዳኣና","poem":2},{"lineBreak":true},{"text":"ኔ ኑም ማዼ ባኮ ኑ ኬኤዛንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}