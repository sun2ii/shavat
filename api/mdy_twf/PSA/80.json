{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":80,"content":[{"type":"heading","content":["«ጫኣቁሞ ቡኒ» ጌይንታ ዓይኑሞና ሱኡጋሢ ዓይሣ ጎይፆ ዓይናዺንታ ዓሳኣፔ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ዒስራዔኤሌ ካኣታ ጊንሣ ዶዳንዳጉዲ ሺኢቂንቴ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ዮሴፔ ማራይጉዲ ሄንቃ፥ ዒስራዔኤሌያ ሄንቃሦ ኑም ዋይዜ!","poem":1},{"text":"ኪሩቤኤሎይዳ ዓኣ ካኣቱሞ ዖይታ ዴዓሦ","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ፖዖና ፔጋዺ ጴዼ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዔፕሬኤሜንታ ቢኢኒያሜንታ ሚናሴንታም","poem":1},{"text":"ኔና ፔጋሲ ዻዌ፤","poem":2},{"lineBreak":true},{"text":"ዎልቆ ኔኤሲ ዓጊሤ፤","poem":2},{"lineBreak":true},{"text":"ሙኪያ ኑና ዓውሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ፆኦሲዮ! ኑና ማሄ፤","poem":1},{"text":"ኑ ዻቃንዳጉዲ ኔ ዓኣፖ ካሮ ኑኡም ፖዒሤ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ቢያ ባኮ ዎይሣ ጎዳ ማዔ ዼኤፖ ፆኦዛሢዮ!","poem":1},{"text":"ኔ ዴሮኮ ሺኢጲፆ ዋይዞ ዒፂ","poem":2},{"lineBreak":true},{"text":"ጎሪንቶ ኔኤኮ ኔ ቤኤዛሢ ዎማ ሄላንዳኣናዳይ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዖዪሢ ዓዳ ሙኡዚጉዲ","poem":1},{"text":"ዓቢሢያ ዑሺጉዲ ሚርጌና ኔ ዔያቶ ዑሼኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኑ ዓሺኖም ኔ ኑና ዑራ ማዣ ዓሲ ማሄኔ፤","poem":1},{"text":"ኑኡኮ ሞርካኣ ኑና ሚኢጬኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ቢያ ባኮ ዳንዳዓ ፆኦዛሢዮ! ኑና ማሄ፤","poem":1},{"text":"ኑ ዻቃንዳጉዲ ኔ ዓኣፖ ካሮ ኑም ፖዒሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ጊብፄ ዓጫፓ ዎይኔ ዞንዜ ኔ ዔኪ ሙኬኔ፤","poem":1},{"text":"ሜሌ ዴሮ ዳውሲ ዔያቶ ቤዛ ዬያ ኔ ቱኬኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዬይ ዑጋንዳ ቤዞ ኔ ጲሺ ጊኢጊሼኔ፤","poem":1},{"text":"ዬያሮ ፃጲ ዳኪ ዓጬሎ ባልጊ ኩሜኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዹካ ዬያ ዒላዦና ሺቢንቴኔ፤","poem":1},{"text":"ዼኤፖ ዚቢቃኣ ዬያ ካኣፖ ዴማ ዔቄኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዬይ ካኣፓ ዴንዲ ባዞ ሄላንዳኣና","poem":1},{"text":"ቶሻኣ ዔፕራፂሴ ዎሮ ሄላንዳኣና ጋምፒንቴኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዓካሪ ዒኢና ሊካ ሌካ ጋዓሢ ዓኣፖ ዬያ ማንፃንዳጉዲ","poem":1},{"text":"ዲፆ ኔኤኒ ዓይጋ ሻሄይ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ጉዱንፃ ካያፓ ኬስኪ ዬያ ፑርቲሳንዳኔ፤","poem":1},{"text":"ቆልማ ሄንቃ ቤዛ ዲርጋ ቆልማ ቢያ ሙዓንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ቢያ ባኮ ዎይሣ ጎዳሢዮ! ዓካሪ ኑ ባንሢ ማዔ፤","poem":1},{"text":"ጫሪንጫፓ ሊካ ኑ ባንሢ ዛጌ፤","poem":2},{"lineBreak":true},{"text":"ሃኖ ኔኤኒ ቱኬ ዎይኔሎ ዛጊ ካፔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሃይ ኔኤኮ ሚዛቆ ኩጫ ቱኬ ባቃላ","poem":1},{"text":"ኔ ዛላ ማሂ ኔ ባቃልሴ ናዓሢኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ዬይ ዎይናሢ ቲቂንቲ ታሚዳ ሚጬኔ፤","poem":1},{"text":"ኔ ዻጎ ጎሪንታ ኔ ዓሶ ባይዛንዳኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ኔኤሮ ማሂ ኔኤኒ ዶዲሺ ዔቂሴ ዓሢ ዑፃ","poem":1},{"text":"ኔኤኮ ሚዛቆ ዛላ ዓኣ ኔ ናዓሢ ዑፃ","poem":2},{"text":"ኔ ኩጫ ማዖንጎ።","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ሃይካፓ ሴካ ኔና ሃሺ ጊንሢም ኑ ማዓዓኬ፤","poem":1},{"text":"ናንጊና ባይቁዋያ ኑና ማሄ፤","poem":2},{"lineBreak":true},{"text":"ኑኡኒያ ኔና ካኣሽካንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዔ ዼኤፖ ፆኦዛሢዮ!","poem":1},{"text":"ኑና ጊንሣ ቤዞ ማሄ፤","poem":2},{"lineBreak":true},{"text":"ኑኡኒ ዻቃንዳጉዲ ኔ ዓኣፖ ካሮ ኑም ፖዒሴ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}