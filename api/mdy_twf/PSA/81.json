{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":81,"content":[{"type":"heading","content":["ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆ ሹሉንጎና ዓይናዺንታ ዓሳኣፔ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ቦንቾ ኬሊና ዓይናዺንታ ዓይኑሞ"]},{"type":"verse","number":1,"content":[{"text":"ኑኡኮ ዶዱማሢ ማዔ ፆኦዛሢም ዓይናዹዋቴ!","poem":1},{"text":"ያይቆኦቤ ፆኦዛሢም ዒላሹዋቴ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዓይኑሞ ዓርቁዋቴ፥ ታምቡሮዋ ባዑዋቴ፤","poem":1},{"text":"ፔቴ ሻሺና ዴንሢ ዋርቆ ጎኦሎንታ","poem":2},{"lineBreak":true},{"text":"ሜሌ ዓይኑሞ ዓንጋሞዋ ዴንሢ ኮሺ ዑኡሲና ዓይናዹዋቴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዓጊና ፄኤራኣና ጊንሣ ዋኣፃ ጌላኣና","poem":1},{"text":"ዼኤፖ ቦንቾ ኬሎናይዳኣ ዛዬ ዋርቁዋቴ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዬይ ዒስራዔኤሌ ዓሶም ዒንጊንቴ ዳምቤ","poem":1},{"text":"ያይቆኦቤ ፆኦዛሢ ኬሴ ዎጌኬ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዒዚ ጊብፄ ዓጮይዳ ሜቶ ዓጌ ኬሎና","poem":1},{"text":"ዬይ ዮሴፔም ኬሶናያኬ፤","poem":2},{"text":"ታ ዔሩዋ ሙኡቺና ሂዚ ጋዓንቴ ታ ዋይዜኔ፦","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«ጌኤቶ ታ ዒዛኮ ኬዲዳፓ ሃውሺሴኔ፤","poem":1},{"text":"ኩጫ ዒ ዔካ ዴኤፆ ባኮ ታ ዒዛ ሃሺሴኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኔና ሜቴ ዎዶና ኔ ታና ዔኤሌኔ፤","poem":1},{"text":"ታኣኒያ ኔና ዓውሴኔ፤","poem":2},{"text":"ታ ዓኣሺንቲ ዓኣ ዹሞ ሻኣሮ ጉጉንፆሲ ባኣካ ዓኣዖ","poem":1},{"lineBreak":true},{"text":"ታ ኔኤም ዋይዜኔ፤","poem":1},{"text":"ዣላሢ ዎሮኮ ዋኣፃ ዓልቃ ቤዛ","poem":2},{"lineBreak":true},{"text":"ኔ ዎይታቴያ ጌዒ ታ ኔና ዛጌኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ታ ዴሬዮቴ! ታ ላታ ባኮ ዋይዙዋቴ፤","poem":1},{"text":"ዒስራዔኤሌ! ኔ ታኣም ዋይዛቴ ዓይጎ!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኔ ካኣሽካ ፃንጎ ፆኦሲ","poem":1},{"lineBreak":true},{"text":"ሃሣ ዔርቱዋ ፆኦሲ ኔኤኮ ባኣያ ማዖንጎ፤","poem":1},{"text":"ዬያ ካኣሽኪፖ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጊብፄ ዓጫፓ ኔና ኬሴ ናንጊና ናንጋ ጎዳ ማዔ","poem":1},{"text":"ኔ ፆኦዛሢ ታናኬ፤","poem":2},{"lineBreak":true},{"text":"ዻንጎ ኔኤሲ ኮሺ ሾኦኬ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ኩንሢ ኩልሳንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«ታኣኮ ዴራ ጋዓንቴ ታኣም ዋይዚባኣሴ፤","poem":1},{"text":"ዒስራዔኤሌ ዓሳኣ ታኣም ዓይሢንቲባኣሴ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዬያሮ ዔያታ ማሌ ማሊፆጉዴያ ዓኣዻንዳጉዲ","poem":1},{"text":"ዔያቶኮ ባይቄ ዒኖም ዓኣሢ ታ ዔያቶ ዒንጌኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታ ዴራ ዎንዴ ታኣም ዋይዜያ ማዔያታቴ","poem":1},{"text":"ዒስራዔኤሌ ዓሳ ታ ጎይፆና ዓኣዼያታቴ","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ቤዞና ታ ዔያቶኮ ሞርኮ ባሼያ ናንዳንቴኬ፤","poem":1},{"text":"ዔያቶ ሞርኮ ዑፃ ታ ኩጮ ታ ዔቂሴያ ናንዳንቴኬ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ፆኦሲም ዋይዞ ዒፃ ዓሳ ዒዛ ቤርታ ዻውሲንታንዳኔ፤","poem":1},{"text":"ዔያቶ ሄላ ሜታሢያ ናንጊና ጋፑዋያ ማዓንዳኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዒንሢ ታ ጋዓንቴ ኮሺ ዛርጌ ሙኡዛንዳኔ፤","poem":1},{"text":"ዑታሢ ዔኤዞና ታ ዒንሢ ሚሻንዳኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}