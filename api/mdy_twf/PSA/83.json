{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":83,"content":[{"type":"heading","content":["ዒስራዔኤሌኮ ሞርካ ባሺንታንዳጉዲ ሺኢቂንቴ ሺኢጲሢ"]},{"type":"hebrew_subtitle","content":["ዓሳኣፔኮ ፆኦሲ ሄርሺፆ ዓይኑሞ"]},{"type":"verse","number":1,"content":[{"text":"ፆኦሲዮ! ኔኤኒ ዚቲዮ ጌዒፖ፤","poem":1},{"text":"ፆኦሲዮ! ኔኤኒ ጬዊዮ ጌዒፖ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሞርካ ኔኤኮ ዎማይዲ ዔቄያታቴ ዛጌ፤","poem":1},{"text":"ኔና ዒፃ ዓሳ ቶኦኮ ፔኤሲ ዎማይዲ ዼጊሴቴያ ዛጌ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኔኤኮ ዴሮ ዑፃ ጌኔ ማዻኒ ዓኣቺ ጌስታኔ፤","poem":1},{"text":"ኔኤኒ ካፓ ዓሶ ኮምባኒ ዔያታ ዞርታኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"«ሃካፓ ሴካ ዒስራዔኤሌ ዓሶ ሱንፃ ዔርቱዋጉዲ","poem":1},{"text":"ሃኒ ሙኩዋቴ ዴሬ ማዑዋጉዲ ኑ ዔያቶ ጋፒሶም» ጋዓኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ፔቴ ማሊሢና ዎላ ጊኢጊ ዔያታ ዞርቴኔ፤","poem":1},{"text":"ኔ ዑፃ ዔቃኒ ዎላ ጫኣቄኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዔያታ፦ ዔዶኦሜ፥ ዒስማዔኤሌ፥ ሞዓኣቤ፥ ዓጋሪያኔ፥","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ጌባሌ፥ ዓሞኔ፥ ዓማሌቄ፥ ፒሊስፄኤሜንታ ፂሮሴ ዴሮንታኬ።","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ዓሶኦሬ ዓሳኣ ዔያቶና ዎላ ፔቴ ማዔኔ፤","poem":1},{"text":"ሎኦፄ ናኣቶዋ ዔያታ ማኣዳያ ማዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ሚዲያሜ ዓጮይዳ ኔ ማዼ ጎይፆ ዔያቶይዳ ማዼ፤","poem":1},{"text":"ቂሶኔ ዎራ ሲሳራና ዒያቢሴናይዳ ኔ ሄሊሴ ባካ ዔያቶ ሄሎንጎ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዔያታ ዓይኔዶሬ ጌይንታ ቤዛ ባይቄኔ፤","poem":1},{"text":"ዓዳ ሳዓይዳ ኬኤሪንቴ ቡኡራ ማዔኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዖሬቤና ዜቤ ዓሶና ዑፃ ኔ ማዼ ጎይፆ","poem":1},{"text":"ሃያ ዓሶ ሱኡጎ ዑፃኣ ማዼ፤","poem":2},{"text":"ዜባሄና ፃልሙናዔ ዓሶና ዑፃ ኔ ማዼ ጎይፆ","poem":1},{"text":"ሃያ ዓሶ ዎይሣ ዓሶይዳኣ ማዼ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዔያታ፦ «ፆኦሲ ዓሶ ቤዞ","poem":1},{"text":"ኑኡኒ ኑኡሮ ማሃንዳኔ» ጌዔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ዬያሮ ታ ፆኦዛሢዮ! ዔያቶ ሲላሊጉዲ","poem":1},{"text":"ዢባሬ ዔኪ ዓኣዻ ዲልባጉዲ ላኣሌ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታሚ ዴኤሊ ካይዚ ሙዓሢጉዲ","poem":1},{"text":"ታሚኮ ሎስታ ዹካ ዓርቃሢጉዲ","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኔኤኮ ጉዳሢ ዢባሮና ዔያቶ ዳውሴ፤","poem":1},{"text":"ዓልጎ ዢባሮናኣ ዲቃሤ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ዔያታ ሱንፆ ኔኤሲ ኮዓንዳጉዲ","poem":1},{"text":"ቦርሲንቲ ዔያቶይዳ ዋሄ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ናንጊና ዔያታ ካራ ባይዚ ቦርሲንቶንጎ፤","poem":1},{"text":"ዻውሲንቲ ዔያታ ባይቆንጎ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሱንፃ ኔኤኮ ናንጊና ናንጋ ጎዳ ማዔሢ ኔ ሌሊ","poem":1},{"text":"ሳዖ ቢያይዳ ዼኤፓሢ ኔና ማዔሢያ ዔያታ ዔሮንጎ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}