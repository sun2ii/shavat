{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":84,"content":[{"type":"heading","content":["ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆና ቆሬ ናኣታ ሹሉንጎና ዓይናዼ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ፆኦሲኮ ጌኤዦ ማኣሮ ጶቂሥሢ"]},{"type":"verse","number":1,"content":[{"text":"ቢያ ባኮ ዎይሣ ጎዳሢዮ!","poem":1},{"text":"ኔ ዎርቃ ማኣራ ዎዚጉዲ ናሽኪንታያዳይ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሼምፓሢ ታኣሲ ናንጊና ናንጋ ጎዳ ካራ","poem":1},{"text":"ዓሳ ቡካ ጶኦኮ ጶቂሣኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣኮ ዒኖንታ ዑፆንታ ናንጊና ባይቁዋ ፆኦዛሢም ዒላሹዋቴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ቢያ ባኮ ዎይሣ ጎዳ ማዔ ፆኦዛሢዮ፥ ታ ጎዳ!","poem":1},{"text":"ኔኤም ዒንጎ ባኮ ሺኢሾ ቤዞ ኮራ","poem":2},{"lineBreak":true},{"text":"ሱኡታታዖ ናንጋ ማኣሪ","poem":2},{"lineBreak":true},{"text":"ዶኦሌያ ፔ ናኣቶ ዴይሣ ማኣሪ ማዣኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኔ ማኣራ ናንጋዞንሢ ዓንጂንቴያኬ፤","poem":1},{"text":"ናንጊና ዔያታ ኔና ጋላታኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ኔና ፔኤኮ ዎልቃሢ ማሄዞንሢ","poem":1},{"text":"ዒኖና ፔኤኮ ፂዮኔ ጎይፆ ማላዞንሢ","poem":2},{"lineBreak":true},{"text":"ሚርጌና ዓንጂንቴያኬ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ባካ ጌይንታ ዋኣፃ ባኣ ዶኦጮና ዔያታ ፒንቃ ዎዶና","poem":1},{"text":"ዓልቃ ዋኣሢ ፆኦሲ ዔያቶም ዑራኔ፤","poem":2},{"lineBreak":true},{"text":"ሲሎ ዒራኣ ቦቆሎ ዔቶ ዋኣሢና ኩንሣንዳኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዎልቄይዳ ዎልቄ ዔያታ ቃሳንዳኔ፤","poem":1},{"text":"ፔቴ ፔቴሢ ፂዮኔ ዹኮይዳ ዓኣ ፆኦሲ ቤርቶ ሺኢካንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ቢያ ባኮ ዎይሣ ጎዳሢዮ! ሺኢጲፆ ታኣኮ ዋይዜ፤","poem":1},{"text":"ያይቆኦቤ ፆኦዛሢዮ! ታኣም ዋይዜ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ፆኦሲዮ! ዶኦሪ ኔ ኑም ዶኦሜ ካኣቲ ዓንጄ፤","poem":1},{"text":"ዒዚ ኑኡኮ ጊቲማ ማዔሢሮ ዒዛ ዛጌ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ሜሌ ቤስካ ሺያ ኬሊ ዴይሢዳፓ","poem":1},{"text":"ኔ ጌኤዦ ማኣሮ ካራ ፔቴ ኬሊ ፔኤቂሢ ኮሺኬ፤","poem":2},{"text":"ፑርቶ ዓሶ ማኣራ ናንጊፆይዳፓ","poem":1},{"text":"ፆኦሲ ማኣሮ ካፓያ ማዒ ናንጋኒ ታ ኮዓኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኑኡኮ ጎዳሢና ፆኦዛሢዮ!","poem":1},{"text":"ኔኤኒ ዓዳ ዓቢና ጊቲማና ጉዲኬ፤","poem":2},{"lineBreak":true},{"text":"ኔ ኮሹሞና ኔ ቦንቾና ኔ ኑና ካፓኔ፤","poem":2},{"lineBreak":true},{"text":"ኮሺ ማዻ ዓሲም ዓይጎዋ ኮሺ ማዔ ባኣዚ ኔ ላኣጉዋሴ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ቢያ ባኮ ዎይሣ ጎዳሢዮ!","poem":1},{"text":"ኔና ጉሙርቃዞንሢ ዎዚ ዓንጂንቴያዳይ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}