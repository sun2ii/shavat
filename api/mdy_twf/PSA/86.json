ናንጊና ናንጋ ጎዳሢዮ! ሺኢጲፆ ታኣኮ ዒናፓ ዋይዜ፤","poem":1},{"text":"ታ ሜታዺ ሺኢቃ ሺኢጲፆ ዋይዜ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኔኤኒ ታኣም ማሂ ኬኤዛያታሢሮ","poem":1},{"text":"ታኣኮ ሜታሢ ኬሎ ታ ኔ ባንሢ ዒላታኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ጎዳሢዮ! ሜሌ ፆኦዞ ባኣካ ኔጉዴይ ባኣሴ፤","poem":1},{"text":"ኔ ማዾና ቤቃ ማዾዋ ባኣሴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጎዳሢዮ! ኔኤኒ ማዤ ዴራ ቢያ","poem":1},{"text":"ኔ ቤርቶ ሙኪ ኔኤም ዚጋንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ኔ ሱንፆም ቦንቾዋ ዒንጋንዳኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኔኤኒ ዼኤፒ ማዔሢሮ","poem":1},{"text":"ኔ ዎልቄና ማዺንታ ዓኪ ባኣዚ ኔ ማዻኔ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ሌሊ ፆኦሲኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ኔኤኮ ጎይፆ ታና ዔርዜ፤","poem":2},{"lineBreak":true},{"text":"ኔ ጎኑሞና ታ ዓኣዻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሱንፆ ኔኤኮ ታ ዒጊጫንዳጉዲ ኩሙሢ ዒኔ ታኣም ዒንጌ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዔ ታ ፆኦዛሢዮ!","poem":1},{"text":"ጎኔ ዒናፓ ታ ኔና ጋላታኔ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ሱንፆ ታ ኔኤኮ ቦንቻኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኔ ታና ሚጪንቴ ሚጪንቲፃ ኮሺ ዼኤፒኬ!","poem":1},{"text":"ሼምፓሢ ታኣኮ ኔ ሄሊንቱዋ ዔታፓ ዓውሴኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ፆኦሲዮ! ዖቶርቃ ዓሳ ታ ጊዳ ፑርቱሞና ዔቄኔ፤","poem":1},{"text":"ዒጊቻ ፑርቶ ዓሳ ዎዻኒ ታና ኮዓኔ።","poem":2},{"lineBreak":true},{"text":"ኔና ዔያታ ዔኤቢኬ ጌይባኣሴ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ጎዳሢዮ!","poem":1},{"text":"ኔኤኒ ጋዓንቴ ኮሺ ሃሣ ሚጪንታ ፆኦሲኬ፤","poem":2},{"lineBreak":true},{"text":"ሩኡሪና ዻጋዹዋያ፥ ኮሹሞንታ ጉሙርቂንቲፃኣ ኔኤኮ ሚርጌኬ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ታ ባንሢ ዛጊ ታና ሚጪንቴ፤","poem":1},{"text":"ታና ኔ ዓይላሢም ዎልቄ ዒንጌ፤","poem":2},{"text":"ታና፥ ኔ ዓይሌሎ ናዓሢ ዓውሴ።","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ታና ዒፃ ዓሳ ዛጊ ቦርሲንታንዳጉዲ","poem":1},{"text":"ኔኤኮ ሚጪንቲፆ ማላቶ ታና ዻዌ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":2},{"lineBreak":true},{"text":"ኔ ታና ማኣዴኔ፥ ዶዲሼኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}