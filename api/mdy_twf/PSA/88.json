{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":88,"content":[{"type":"heading","content":["ቆሬ ናኣቶኮ ጋላቶ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆና ዎሊም ዓጊ ዓጊ ዓይናዾያ፥ ዒዝራዔኤሌ ዓሢ ዔማኔ ካላሎ፥ ፆኦሲ ማኣዶ ዴንቃኒ ሺኢቂንቴ ሺኢጲሢ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዔ ታና ዓውሳ ፆኦዛሢዮ!","poem":1},{"text":"ሮኦሮና ዋንቶና ታ ኔ ቤርታ ዒላታኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሺኢጲፃ ታኣሲ ኔ ቤርቶ ሄሎንጎ፤","poem":1},{"text":"ዋዮ ኔኤኮ ታ ዒላቶ ባንሢ ማሄ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ሚርጌ ሜታ ታና ሄሌሢሮ","poem":1},{"text":"ሃይቃኒ ታኣኒ ዑኬኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ሃይቂ ዱኡኪንታ ዓሶና ዎላ ታኣኒ ፓይዲንቴኔ፤","poem":1},{"text":"ፔቴታዖ ማኣዳ ዓሲባኣያ ታ ማዔኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሃይቄ ዓሶ ባኣካ ኬኤሪንቴ ዓሶጉዲ","poem":1},{"text":"ዎዺ ዱኡኮና ዓሲጉዲ ታ ላሄኔ፤","poem":2},{"lineBreak":true},{"text":"ሃካፓ ሴካ ኔ ማሊ ጶቂሡዋ ዓሶጉዲ","poem":2},{"lineBreak":true},{"text":"ኔ ኩጫፓ ኬስኪ ኬኤሪንቴ ዓሶጉዲ ታ ማዔኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ኔ ታና ዔቶ ቶርጳሢዳ ኬኤሬኔ፤","poem":1},{"text":"ዹሚ ዔቴይዳ ኔ ታና ዓጌኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኔ ጎሪንቶ ዴኤሡማ ታ ዑፃ ማዔኔ፤","poem":1},{"text":"ኔኤኮ ዋኣፆ ጉዳሢና ኔ ታና ዱኡኬኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ታኣኮ ዑካ ላጎ ታ ኮራፓ ኔ ሃኪሴኔ፤","poem":1},{"text":"ዔያታ ታና ሻኣኪንታንዳጉዲ ኔ ማዼኔ፤","poem":2},{"lineBreak":true},{"text":"ታ ማንጊንቴኔ፥ ቶላኒያ ታ ዳንዳዒባኣሴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዓኣፓ ታኣኮ ዖዪፆና ዴዒ ዓቴኔ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳሢዮ! ታ ኔ ባንሢ ዒላታኔ፤","poem":2},{"lineBreak":true},{"text":"ኩጮዋ ታ ኔ ባንሢ ዔቂሳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ኔኤኮ ዲቃሢ ሄርሺሳ ማዾ ሃይቄ ዓሶም ኔ ቤኤዛ?","poem":1},{"text":"ሃይቄ ዓሶኮ ዔኤዣ ዔቂ ኔና ጋላታ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ሚጪንቲፃ ኔኤኮ ዱኡፒ ቤስካ","poem":1},{"text":"ጉሙርቂንቲፃኣ ባይሲንታ ቤስካ ኬኤዚንታ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዲቃሢ ሄርሺሳ ማዻ ኔኤኮ ዹሞ ቤዛ","poem":1},{"text":"ፂሉማኣ ኔኤሲ ዋሊንቴ ሳዓይዳ ዔርታ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ኔ ታና ማኣዳንዳጉዲ ኔ ባንሢ ታ ዒላታኔ፤","poem":2},{"lineBreak":true},{"text":"ጉቶዋ ሺኢጲፆ ታኣኮ ታ ኔ ቤርቶ ሺኢሻኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ዓይጋ ኔ ታና ሃኪሳይ?","poem":1},{"text":"ኔኤኮ ዓኣፖ ካሮዋ ታ ጊዳፓ ዓይጋ ኔ ሺርሻይ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ታኣኒ ናኣቱሞፓ ዓርቃዖ ሜታዼያና","poem":1},{"text":"ሃይቃኒያ ዑኬያኬ፤","poem":2},{"lineBreak":true},{"text":"ኔ ታና ሚርጌና ዲቃሤኔ፤","poem":2},{"lineBreak":true},{"text":"ዔርቲያ ታኣም ዒፄኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ኔ ጎሪንታ ዑፆ ታኣኮ ካንቄኔ፤","poem":1},{"text":"ዱማ ዱማ ባይዛ ባካኣ ታና ኩርሴኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ሮኦሮ ጉቤ ዓዳ ዲጲጉዲ ታና ማንጌኔ፤","poem":1},{"text":"ጋፒ ታና ዬይ ዔኤዼኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ታኣኮ ዒጊኖንታ ላጎንታ ኔኤኒ ታ ኮራፓ ሃኪሴኔ፤","poem":1},{"text":"ዹሚ ሌሊ ታኣኮ ላጌ ማዒ ዓቴኔ።","poem":2}]}],"footnotes":[]},"thisChapte