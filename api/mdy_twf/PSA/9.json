{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":9,"content":[{"type":"heading","content":["ዓይኑሞ ሱኡጋሢ ዓይሣ ጎይፆና «ናኣዚ ሃይቦና» ጌይ ዓይናዾ ዳውቴ ዓይኑሞ"]},{"type":"hebrew_subtitle","content":["ፒዜ ዎጋያ ማዔ ፆኦሲም ሺኢካ ጋላታ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ጉቤ ዒናፓ ታ ኔና ጋላታኔ፤","poem":1},{"text":"ኔኤኮ ዲቃሢ ሄርሺሳ ማዾ ዛሎ ቢያ ታኣኒ ኬኤዛኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ኔኤና ዔኤቢ ታኣም ኮሽካሢሮ ታ ዎዛዻኔ፤","poem":1},{"text":"ዼኤፖ ፆኦዛሢዮ!","poem":2},{"lineBreak":true},{"text":"ኔ ሱንፆ ጋላታ ዓይኑሞና ታ ሄርሻኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ኔኤኒ ፔጋዺ ጴዻኣና ታ ሞርካ ጊንሢም ማዓንዳኔ፤","poem":1},{"text":"ዹቂንቲ ሎኦሚ ኔ ቤርታፓ ዔያታ ባይቃንዳኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኔኤኮ ካኣቱሞ ዖይቶይዳ ኔኤኒ ዴዒ","poem":1},{"text":"ፒዜ ዎጌ ዎጋያኬ፤","poem":2},{"lineBreak":true},{"text":"ታ ጌኤዞዋ ጌስቲ ፒዜና ኔ ታኣም ዎጋንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ሜሌ ዴሮ ኔኤኒ ጎሬኔ፤","poem":1},{"text":"ፑርቶ ማዻ ዓሶዋ ኔ ባይዜኔ፤","poem":2},{"lineBreak":true},{"text":"ሱንፆዋ ኔ ዔያቶኮ ናንጊና ዲርካቺ ባይዜኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሞርካ ኑኡኮ ናንጊና ባይቄኔ፤","poem":1},{"text":"ካታሞዋ ኔ ዔያቶኮ ዶይሲ ጋፒሴኔ፤","poem":2},{"lineBreak":true},{"text":"ማሊ ዔያቶ ጶቂሦ ባኣዚ ባኣያ ማዒ ባይቄኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ናንጊና ናንጋ ጎዳ ጋዓንቴ ካኣታዺ ናኣናና ናንጋኔ፤","poem":1},{"text":"ካኣቱሞ ዖይቶዋ ዒኢካ ዴዒ ዎጋኒ ዒዚ ጊኢጊሼኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዓጮም ዒዚ ፂሉሞና ዎጋንዳኔ፤","poem":1},{"text":"ሜሌ ዴሮዋ ፒዙሞና ዒ ዎይሣንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሄርቂንቲ ዎርቃ ዓሶም ፑኖ ካይዚኬ፤","poem":1},{"text":"ሜታሢ ዎዶና ዼጌ ቤዞ ማዒ ዒዚ ማኣዳኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሱንፆ ኔኤኮ ዔራ ዓሳ ኔና ጉሙርቃኔ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔና ኮዓ ዓሶዋ ኔ ሃሹዋሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ፂዮኔይዳ ናንጋ፥ ናንጊና ናንጋ ጎዳም","poem":1},{"text":"ጋላታ ዓይኑሞ ዓይናዹዋቴ!","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ዲቃሢ ሄርሺሳ ማዾዋ","poem":2},{"lineBreak":true},{"text":"ዴሮ ባኣካ ኬኤዙዋቴ!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሱጉፆ ማሃሢ ዔያቶም ማሌኔ፤","poem":1},{"text":"ሄርቂንቲ ዎርቃ ዓሶኮ ዒላቶ ዒዚ ዋሊባኣሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ታኣኮ ሞርካ ታና ሜታሳ ሜቶ ዛጌ!","poem":2},{"text":"ታኣም ሚጪንቴ!","poem":1},{"text":"ሃይቦ ቤዛፓኣ ዔኪ ታና ማሄ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ዬያ ኔኤኒ ታኣም ማዼቴ","poem":1},{"text":"ፂዮኔይዳ ዓሳ ቡካ ቤዛ","poem":2},{"text":"ዼጊዲ ታ ኔና ጋላታንዳኔ፤","poem":1},{"text":"ኔኤኒ ታና ዓይሴሢሮዋ ታ ዎዛዻንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ሜሌ ዴራ ፔ ቦኦኬ ዔታ ፔኤሮ ሎኦሜኔ፤","poem":1},{"text":"ዔያታ ዓኣቺ ፒሬ ፒራሢዳ ቶካ ዔያቶኮ ዓዺንቴኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ናንጊና ናንጋ ጎዳ ፒዜ ዎጊሢና ዔርቴያኬ፤","poem":1},{"text":"ፑርቶ ማዻ ዓሳ ፔኤኮ ፑርቶ ማዾ ፒራሢና ዓዺንቴኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ፑርቶ ማዻ ዓሳ ሃይቄ ዓሶ ዓጮ ዴንዳንዳኔ፤","poem":1},{"text":"ፆኦሲ ዋሊ ሃሻ ዓሳኣ ቢያ ዒማዒ ማዓንዳኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ሜታዻ ዓሳ ጋዓንቴ ቢያ ዎዴ ዋሊንቲንዱዋሴ፤","poem":1},{"text":"ማንቆ ዓሶኮ ሃጊ ማዓ ዎዛኣ ናንጊና ጉሪ ማዒ ዓቱዋሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ዓሲ ፔ ዶዱሞና","poem":1},{"text":"ኔጊዳፓ ዑሣ ዎልቃዻንጉዲ ማሂፖ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ዔቄ፥ ሜሌ ዴሮ ዑፃ ኔ ዎጌ።","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ዲቃሣ ባኣዚ ዔያቶ ዑፃ ኬይሴ፤","poem":2},{"lineBreak":true},{"text":"ዔያታ ዓሲ ማዒ ማዢንቴሢያ ኔኤኒ ዔያቶ ዔርዜ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}