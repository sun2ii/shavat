:2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ኔኤኮ ጎሪንታ ኑና ኩርሴኔ፤","poem":1},{"text":"ዱማ ዱማ ዎዻ ባኮናኣ ኑ ዲቃቴኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ጎሞ ኑኡሲ ኔ ቤርታ ኔ ጌሣኔ፤","poem":1},{"text":"ኑኡኮ ዓኣሺንቴ ዻቢንቶ ኔኤም ጴዻ ቤስካ ኔኤኒ ዴይሣኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ኑኡኮ ናንጎ ዎዳ ቢያ ኔ ጎሪንቶና ጋፔኔ፤","poem":1},{"text":"ናንጎ ኑኡሲ ኑ ጎኦሺንቴ ጎይሣ ጋፒሳኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ናንጎ ሌዓ ኑኡኮ ላንካይታሚ ሌዔ፤","poem":1},{"text":"ሚርጌኔ ጌዔያታቴ ሳሊታሚ ሌዔኬ፤","poem":2},{"text":"ዬካፓ ዑሣ ዓኣዼያ ማዔቴ","poem":1},{"text":"ላቢሢና ሜቶና ሌሊ ማዓያኬ፤","poem":2},{"lineBreak":true},{"text":"ናንጋ ኑኡኮ ዑኬ ጋፓኔ፥ ኑኡኒ ዓዓኣዻኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ኔኤኮ ዻጎ ዎልቆ ዖኦኒ ዔራይ?","poem":1},{"text":"ዱማ ዱማ ዎዻ ባካ ኔኤኮ ዒጊቺፆጉዴያ ዼኤፒኬ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኑኡኮ ናንጎ ሌዖንሢዳ ዔራቶና ኑ ናንጋንዳጉዲ","poem":1},{"text":"ዔራቶ ዓኣ ዒኔ ኑም ዒንጌ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔኤኒ ማዔ፤","poem":1},{"text":"ሃይ ዓይዲ ሄላንዳኣና ሃኣዺ ማዓንዳይ?","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ማዻ ዓይሎም ሚጪንቴ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ኑኡኮ ናንጎ ዎዶይዳ ቢያ ኑ ዎዛዻንዳጉዲ","poem":1},{"text":"ኔኤኮ ሚጪንቲፆ ጉቴና ጉቴና ዺቢሺ ዻዌ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ሜታሢ ኔ ኑና ዻዌ ሌዖጉዴያ","poem":1},{"text":"ፑርቶ ባኮዋ ኑ ዛጌ ሌዖጉዴያ","poem":2},{"lineBreak":true},{"text":"ኑና ዎዛሴ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ማዻ ኔኤኮ ኔ ዓይሎም","poem":1},{"text":"ቦንቻኣ ዔያቶኮ ናኣቶም ፔጋዺ ጴዾም።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢኮ ኮሹማ","poem":1},{"text":"ኑ ዑፃ ማዖም!","poem":2},{"lineBreak":true},{"text":"ኑ ማዻ ባኮዋ ኑኡም ዓንጄ፤","poem":2},{"lineBreak":true},{"text":"ሂዮ ኑኡም ዓኣፒሴ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/91.json","nextChapterAudioLinks":{},