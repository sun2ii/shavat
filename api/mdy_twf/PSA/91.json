{"text":"«ኮይሎይዳ ኔኤኮ ሺያ፤","poem":1},{"text":"ሚዛቆ ዛሎና ታጶ ሺያ ሎኦማንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ጋዓንቴ ዬይ ኔ ባንሢ ዑካዓኬ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ኔኤኒ ኔኤኮ ዓኣፖና ሌሊ ዬያ ዛጋንዳኔ፤","poem":1},{"text":"ፑርቶ ዓሳ ሜታሢ ዔካሢ ዛጊ ኔ ዛጋንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«ናንጊና ናንጋ ጎዳ ኔኤኮ ዓኣሺንቶ ቤዛሢ","poem":1},{"text":"ዼኤፖ ፆኦዛሢያ ፑኖ ካያሢ","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ማሄኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዬያሮ ፑርታ ባኣዚ ኔና ሄላዓኬ፤","poem":1},{"text":"ባይዛ ሃይቢያ ኔ ማኣሪ ጌላዓኬ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኔ ሃንታ ጎይፃ ቢያ ኔና ዒ ካፓንዳጉዲ","poem":1},{"text":"ኪኢታንቾ ዒዚ ኔኤም ጌዒ ዓይሣንዳኔ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ቶካ ኔኤኮ ሹጮይዳ ዹቂንቱዋጉዲ","poem":1},{"text":"ዔያታ ፔኤኮ ኩጮና ኔና ኬዲ ዓርቃንዳኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዞቦንታ ዶርቦ ሾኦዦንታይዳ ኔ ሄርቃንዳኔ፤","poem":1},{"text":"ሃጊ ዔቃ ዓዶ ዞቦንታ ቃራሢያ ኔኤኒ ዒማይዳንዳኔ።»","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሂዚ ጋዓኔ፦","poem":1},{"text":"«ታና ዒ ናሽኬሢሮ ታ ዒዛ ሄሊ ዓውሳንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ታ ሱንፆ ዒዚ ዔሬሢሮ ታ ዒዛ ጎኦቢ ዓይሳንዳኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዒዚ ታና ዔኤላኣና ታ ዋይዛንዳኔ፤","poem":1},{"text":"ዒዛኮ ሜታሢ ዎዶና ዒዛና ማዓንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ታ ዒዛ ዓውሳንዳኔ፥ ቦንቻንዳኔ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ሚርጌ ሌዔ ዒዛ ታ ናንጊሻንዳኔ፤","poem":1},{"text":"ታኣኮ ዓውሲፆዋ ዒዛም ዻዋንዳኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}