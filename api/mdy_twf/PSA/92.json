},{"lineBreak":true},{"text":"ዬያ ዳንዳዑዋሴ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ፑርቶ ማዻ ዓሳ ማኣቲጉዲ ባቃላያ ማዔቴያ","poem":1},{"text":"ጌኔ ማዻ ዓሳ ቡኔቴያ","poem":2},{"lineBreak":true},{"text":"ናንጊና ዔያታ ባይቃንዳኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":1},{"text":"ኔኤኒ ጋዓንቴ ዼኤፒ ማዒ ናንጋያኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ሞርካ ኔኤኮ ባይቃንዳኔ፤","poem":1},{"text":"ፑርቶ ማዻዞንሢያ ቢያ ላኣሊንታንዳኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታኣኮ ካኣሮ ጋዓንቴ ዖሶ ካኣሪጉዲ ኔ ዼጊሴኔ፤","poem":1},{"text":"ሃጊ ጊሲንቴ ዛይቴና ኔኤኒ ታና ቲሽኬኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ሞርኮኮ ሎኦሚፆ ዓኣፓ ታኣኮ ዛጌኔ፤","poem":1},{"text":"ዋያ ታኣኮ ፑርቶ ሞርኮኮ ባሺንቲፆ ዋይዜኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ፂሎ ዓሳ ዓዳ ሜኤፄጉዲ ጋምፒንታኔ፤","poem":1},{"text":"ሊባኖኦሴ ሚፆጉዲያኣ ዑጋኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዔያታ ናንጊና ናንጋ ጎዳ ማኣራ ቱኪንቴኔ፤","poem":1},{"text":"ዓሳ ቡካ ጶኦካኣ ጋምፒንታንዳኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ጋርቼ ዎዶናታዖ ዔያታ ዓኣፓንዳኔ፤","poem":1},{"text":"ዓኣዓያ ማዒ ዶዴ ጎይሣ ናንጋንዳኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"«ናንጊና ናንጋ ጎዳ ፒዜኬ፤","poem":1},{"text":"ዒዚ ታኣኮ ላላሢኬ፤","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ዻቢንቲ ባኣያኬ» ዔያታ ጋዓንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}