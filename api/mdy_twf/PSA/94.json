m":2},{"lineBreak":true},{"text":"ያይቆኦቤ ፆኦዛሢ ዬያ ዔሩዋሴ» ጋዓኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ዒንሢ ዒዛ ዴሮ ባኣካ ዓኣ ማሉዋ ዓሳ","poem":1},{"text":"ሂንዳ ኮሺ ማሉዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዒንሢ ዔኤዮ ዓሳ ዔራ ዒንሢ ማዓንዳሢ ዓይዲዳይ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዋዮ ዾቄሢ ፔኤሮ ዋይዙዋያዳ?","poem":1},{"text":"ዓኣፖ ማዤሢያ ዛጉዋዓዳ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዴሮ ጎሪ ዞሪ ፔ ጎይፆ ባንሢ ማሃሢ","poem":1},{"text":"ዔራቶ ዓሲም ዒንጋሢ ሜቶ ዓጋዓዳ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዓሲኮ ማሊሢ","poem":1},{"text":"ዔኤቢ ፓሡዋያ ጉሪ ማዔሢ ዔራኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ናንጊና ናንጋ ጎዳሢዮ! ኔኤኒ ጎሪ ዞራ ዓሲ","poem":1},{"text":"ኔ ዎጎዋ ኔ ዔርዛ ዓሲ ዓንጂንቴያኬ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ጎሞ ዓሳ ሎኦማንዳ ዔቴ ቦኦኪንታንዳያ ሄላንዳኣና","poem":1},{"text":"ኔኤኒ ዒዛ ፑርታ ሜቶፓ ሃውሺሳንዳኔ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዴሮ ፔኤሲ ኬኤሩዋሴ፤","poem":1},{"text":"ፔ ዓሶዋ ሃሹዋሴ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ዎጌ ጊንሣ ፒዜ ጎይሢና ዎጊንታንዳኔ፤","poem":1},{"text":"ዒኖ ፒዜ ዓሳ ቢያ ዬያ ጊንፆ ዓኣዻንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ፑርቶ ዓሶ ታኣም ቃዛንዳያ ዖናዳይ?","poem":1},{"text":"ፑርቶ ማዻ ዓሶና ታ ዛሎ ሞኦቲንታንዳያ ዖናዳይ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዎንዴ ታና ማኣዲባኣያታቴ","poem":1},{"text":"ቤዞና ታ ሄኤዶ ሃይቄ ዓሶ ሳዖ ኬዴያ ናንዳኔ።","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ታኣኒ «ታና ሃሊፄኔ» ጌዔ ዎዶና","poem":1},{"text":"ናንጊና ናንጋ ጎዳሢዮ!","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ሚጪንቲፃ ላባዒ ታና ዓርቄኔ።","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ማሊፃ ታኣኮ ሚርጌ ጎይፆ","poem":1},{"text":"ኔኤኮ ዶዲሺፃ ሼምፓሢ ታኣኮ ዎዛሳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ዎጌ ሱንሢና ጊኢጊሺንቴ ጌኔ ማዾና","poem":1},{"text":"ዎቢሲ ዎጊንቴ ዎጌና ፔቴ ኔ ማዓንዳ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ፂሎ ዓሶ ዑፃ ጌኔ ጌስቲ ዔያታ ኬስካኔ፤","poem":1},{"text":"ጌኤዦ ዓሳ ሃይቃንዳጉዲ ዔያታ ዎጋኔ።","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ታኣም ጋዓንቴ ናንጊና ናንጋ ጎዳ ዋርዲዬ ቤሲ፤","poem":1},{"text":"ታኣኮ ፆኦዛሢያ ፑኖ ካይዚ ማዔኔ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ዒዚ ዻቢንቶ ዔያቶሲ ዔያቶም ማሃንዳኔ፤","poem":1},{"text":"ዔያቶ ፑርቱሞሮ ዒ ባይዛንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢ ዔያቶ ጋጋፒሳንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}