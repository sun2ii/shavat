},{"text":"ኑና ዒ ሄንቃ ዒዛኮ ዴሮኬ፤","poem":2},{"text":"ዬያሮ ዒዚ ሃኖ ሂዚ ጌዒ ኬኤዛሢ ዋይዙዋቴ፦","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«ዬያ ዓሳ ናንጉዋ ዳውላ ሜሪባና ማሳ ጌይንታ ቤዛ","poem":1},{"text":"ዒንሢኮ ቤርታኣ ዓዶንሢ ማዼሢጉዲ","poem":2},{"lineBreak":true},{"text":"ዒንሢያ ዋይዚ ዒፃያ ማዒፖቴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዔያታ ማዾ ታኣሲ ዛጌያ ማዔያታቴያ","poem":1},{"text":"‹ታ ዎይታቴያ› ጌዒ ታና ዔያታ ዛጌኔ፤","poem":2},{"lineBreak":true},{"text":"ማሂ ማሂ ታና ዔያታ ዎይታቴያ ዛጌኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዬኖ ሾይንቶ ዖይዲታሚ ሌዔ ጉቤ ታኣኒ ሻኣኪንቴኔ፤","poem":1},{"text":"ዒማና ታኣኒያ፦ ‹ዒና ዔያቶኮ ታና ሃሼ ዴሬኬ፤","poem":2},{"lineBreak":true},{"text":"ጎይፆዋ ታኣሲ ዔያታ ዔሩዋሴ› ጌዔኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዬያሮ፦ ‹ፔቴታዖ ታኣኮ ሃውሾይዳ ዔያታ ጌላዓኬ›","poem":1},{"text":"ጌዒ ታኣኮ ዻጎና ታ ጫኣቄኔ።»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}