{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":96,"content":[{"type":"heading","content":["ፆኦሲ ቢያሢኮ ዑፃ ማዔሢ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳም ዓኪ ዓይኑሞ ዓይናዹዋቴ!","poem":1},{"text":"ዓጫ ቢያ ናንጊና ናንጋ ጎዳም ዓይናዹዋቴ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ናንጊና ናንጋ ጎዳም ዓይናዹዋቴ፥ ዒዛኮ ሱንፆ ዓንጁዋቴ፤","poem":1},{"text":"ዒዛኮ ዓውሲፆ ጉቴ ጉቴ ኬኤዙዋቴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ቦንቾ ዒዛኮ ዴሮ ባኣካ","poem":1},{"text":"ዲቃሢ ሄርሺሳ ማዾዋ ዓሲ ቢያ ቤርታ ኬኤዙዋቴ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ናንጊና ናንጋ ጎዳ ዼኤፒኬ፤","poem":1},{"text":"ዒዛ ሄርሻኒያ ኮይሳያኬ፤","poem":2},{"lineBreak":true},{"text":"ሜሌ ካኣሽኮ ፆኦዛፓ ቢያ ዑሣ","poem":2},{"lineBreak":true},{"text":"ዒዚ ዒጊጪንታንዳያ ኮይሳኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሜሌ ዴሮ ፆኦዛ ቢያ ፃላሄሮኬ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ጋዓንቴ ጫሪንጮ ማዤኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ቦንቾና ዼኤፑሞዋ ዒዛ ኮራኬ፤","poem":1},{"text":"ዒዛኮ ጌኤዦ ማኣራ ዶዱሞና ሚዛጱሞና ዓኣኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ሳዖይዳ ናንጋ ዴራ ናንጊና ናንጋ ጎዳ ጋላቱዋቴ!","poem":1},{"text":"ዒዛኮ ቦንቾና ዎልቆናሮ ዒዛ ጋላቱዋቴ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳ ሱንፆም ቦንቾ ዒንጉዋቴ፤","poem":1},{"text":"ዒንጎ ባኣዚ ዓርቂ ዒዛኮ ዓሳ ቡካ ጶኦኮ ጌሉዋቴ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዒዛኮ ዱማዼያ ማዔ ዼኤፑሞሮ ዒዛም ዚጉዋቴ፤","poem":1},{"text":"ሳዓ ቢያ ዒዛ ቤርታ ጎጋይቁዋቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ዴሮ ቢያሢ ባኣካ፦ «ናንጊና ናንጋ ጎዳ ካኣታዼኔ!» ጎዑዋቴ፤","poem":1},{"text":"ሳዔላ ዶዲና ማዢንቴሢሮ ዓጊፃዓኬ፤","poem":2},{"lineBreak":true},{"text":"ዓሲም ቢያ ዒ ፒዙሞና ዎጋኔ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ጫሪንጫ ዎዛዹዋቴ! ሳዔሌ ኔኤኒያ ዎዛዼ!","poem":1},{"text":"ባዞንታ ዬያይዳ ዓኣ ባካ ቢያ ዑኡዞ ዋይዚሱዋቴ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ጎዦንታ ጊዳ ዓኣ ባካኣ ቢያ ፂኩዋቴ!","poem":1},{"text":"ያዺ ማዓዛ ካዮ ሚፃ ቢያ ዎዛና ዓይናዻንዳኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ዒዚ ሙካንዳኔ፤","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ቤርታ ዔያታ ዓይናዻንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሳዖይዳ ዎጋኒ ዒ ሙካንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሳዖይዳ ፂሉሞና ዴሮ ዑፃ ጎኑሞና ዎጋንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}