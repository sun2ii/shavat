xt":"ዓይኑሞ ዓንጋሞና ዑኡሲ ኬሲ ዒዛም ዓይናዹዋቴ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዲንኮና ዛዬ ዑኡሲና","poem":1},{"text":"ናንጊና ናንጋ ጎዳ ማዔ ካኣታሢ ቤርታ ዒላሹዋቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ባዞንታ ዬያይዳ ዓኣ ባካ ቢያ","poem":1},{"text":"ሳዖንታ ዒኢካ ናንጋ ባካ ቢያ","poem":2},{"lineBreak":true},{"text":"ዑኡዞ ዋይዚሱዋቴ!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ዎራ ኩጮ ፔኤኮ ባዖንጎ፤","poem":1},{"text":"ዹካኣ ዎሊ ዑፃ ዓይናዾንጎ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዬያታ ፆኦዛሢ ቤርታ ዓይናዾንጎ፤","poem":1},{"text":"ዒዚ ሳዖይዳ ዎጋኒ ሙካንዳኔ፤","poem":2},{"text":"ዓጮ ዑፃ ዒዚ ፂሉሞና","poem":1},{"text":"ዴሮ ዑፃኣ ጎኑሞና ዎጋንዳኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}