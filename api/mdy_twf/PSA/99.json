{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"PSA","translationId":"mdy_twf","name":"ዓይኑሞ ማፃኣፖ","commonName":"ዓይኑሞ ማፃኣፖ","title":"ዓይኑሞ ማፃኣፖ","order":19,"numberOfChapters":150,"sha256":"5dbdb8e788d85ae7eaf866b1af6a4cffdc06d84b34713eb0e37b0e5b57e75e2a","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mdy_twf/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":99,"content":[{"type":"heading","content":["ፆኦሲ ዼኤፒ ካኣቲ ማዔሢ"]},{"type":"verse","number":1,"content":[{"text":"ናንጊና ናንጋ ጎዳ ካኣታዼኔ፤","poem":1},{"text":"ዴራ ጎጋይቆንጎ፤","poem":2},{"text":"ዒዚ ኪሩቤኤሎ ዑፃ ዓኣ ካኣቱሞ ዖይታ ዴዔኔ፤","poem":1},{"text":"ሳዓኣ ዓጊፆንጎ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ናንጊና ናንጋ ጎዳ ፂዮኔይዳ ዼኤፒኬ፤","poem":1},{"text":"ዴሮኮ ቢያ ዑሣ ዒ ዼግ ዼጊ ጌዔኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኔኤኮ ዔያታ ዼኤፑሞና ዒጊቻ ሱንፆና ሄርሾንጎ፤","poem":1},{"text":"ዒዚ ዱማዼያኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ፒዜ ዎጌ ናሽካ ዎልቆ ካኣቲዮ!","poem":1},{"text":"ኔኤኒ ፒዜ ባኣዚ ማዺንታንዳጉዲ ማሄኔ፤","poem":2},{"lineBreak":true},{"text":"ፒዜ ዎጊሢና ፂሉሞና ያይቆኦቤ ዓሶም ዔኪ ሙኬኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢ ዼግ ዼጊዱዋቴ!","poem":1},{"text":"ቶካ ዒዛኮ ሄርቃ ሳዖይዳ ዚጉዋቴ!","poem":2},{"lineBreak":true},{"text":"ዒዚ ዱማዼያኬ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዒዛም ቄኤሶ ማዔዞንሢ ባኣካ ሙሴና ዓኣሮኔና ዓኣኔ፤","poem":1},{"text":"ሃሣ ዒዛ ሺኢቄዞንሢ ባኣካፓ ሳሙዔኤሌ ፔቴሢኬ፤","poem":2},{"text":"ዔያታ ናንጊና ናንጋ ጎዳ ዔኤላዛ","poem":1},{"text":"ዒዚ ዔያቶም ማሂ ዬሄኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ቱርቱሮጉዲ ዔቄ ሻኣሮ ባኣኮይዳ ዒ ጌስቴኔ፤","poem":1},{"text":"ዔያታኣ ዒዚ ዔያቶም ዒንጌ ዳምቦና ዎጎና ካፔኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢዮ!","poem":1},{"text":"ኔኤኒያ ዔያቶም ዬሄኔ፤","poem":2},{"lineBreak":true},{"text":"ኔ ዔያቶኮ ዻቢንቶሮ ኮሜ ኮፃያ ማዔቴያ","poem":2},{"text":"ኔኤኒ ዔያቶም ዓቶንጎ ጋዓ ፆኦሲኬ።","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢ ዼግ ዼጊዱዋቴ!","poem":1},{"text":"ዒዛኮ ዱማዼ ዹካ ዒዛም ዚጉዋቴ፤","poem":2},{"lineBreak":true},{"text":"ናንጊና ናንጋ ጎዳ ማዔ ኑ ፆኦዛሢ ዱማዼያኬ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}