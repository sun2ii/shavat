{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"REV","translationId":"mdy_twf","name":"ዮሃኒሴም ፆኦሲ ዻዌ ባኮ","commonName":"ዮሃኒሴም ፆኦሲ ዻዌ ባኮ","title":"ዮሃኒሴም ፆኦሲ ፔጋሲ ዻዌ ባኮ","order":66,"numberOfChapters":22,"sha256":"21ee27498e0f32d3590a358becc3f65cafb91172702e2c13c648b7b869fa62d0","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/mdy_twf/REV/22.json","totalNumberOfVerses":401},"chapter":{"number":15,"content":[{"type":"heading","content":["ጋፒንፆ ማዔ ባይዛ ባኮ ዔኪ ዓኣ ኪኢታንቾንሢ"]},{"type":"verse","number":1,"content":["ዬካፓ ሜሌ ዼኤፒ ሃሣ ዲቃሢ ሄርሺሳ ማላታ ጫሪንጫ ታ ዛጌኔ፤ ዬይያ፦ ፆኦሲ ዻጋ ዔያቶና ኩማያ ማዔ፥ ላንካይ ባይዛ ባኣዚ ዔኪ ዓኣ፥ ላንካይ ኪኢታንቾ ታ ዛጌኔ።"]},{"type":"verse","number":2,"content":["ዒማና ሃሣ ታሚ ሲኢሪንቴያ ሌማሌኤሼ ባዚ ማላያ ታ ዴንቄኔ፤ ዒኢካ ባዞ ዓጫ ቦዓሢና ቦዓሢኮ ማላቶና ሃሣ ዒዛ ሱንፆ ፓይዶ ዖሊ ባሼ ዓሳ ዔቂ ዓኣንቴ ታ ዴንቄኔ፤ ዔያታ ፆኦሲዳፓ ዒንጊንቴ ጎኦላ ዔኪ ዓኣኔ፤"]},{"type":"verse","number":3,"content":["ዔያታ ፆኦሲም ማዻ፥ ሙሴ ዓይኑሞና ማራዓሢናኮ ዓይኑሞ፦",{"text":"«ቢያ ባኣዚ ዳንዳዓ ጎዳ ማዔ ፆኦዛሢዮ!","poem":1},{"text":"ማዻ ኔኤኮ ዼኤፒ ሃሣ ዲቃሢ ሄርሺሳያኬ፤","poem":2},{"text":"ሚርጌ ዴሮኮ ካኣታሢዮ!","poem":1},{"text":"ኔኤኮ ጎይፃ ፒዜ ሃሣ ጎኔኬ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጎዳሢዮ! ኔና ዒጊጩዋያ","poem":1},{"text":"ሃሣ ሱንፆዋ ኔኤኮ ቦንቹዋይ ዖናዳይ?","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ሌሊ ዱማዼያኬ።","poem":2},{"text":"ኔኤኮ ፒዜ ማዻ ፔጋዺ ዔርቴሢሮ","poem":1},{"text":"ዺቦ ዴራ ቢያ ሙኪ ኔ ቤርታ ኔኤም ዚጋንዳኔ»","poem":2},"ጌዒ ጌዒ ዓይናዻኔ።"]},{"type":"verse","number":5,"content":["ዬካፓ ሃሣ ዓፒላና ማዢንቴ፥ ፆኦሲም ዱማዼ፥ ጌኤሺ ማኣሪ ጫሪንጫ ቡሊንቲ ዓኣንቴ ታ ዛጌኔ፤"]},{"type":"verse","number":6,"content":["ዒማና ላንካዎ ባይዛ ባኮንሢ ዔኪ ዓኣ፥ ላንካይ ኪኢታንቻ ጌኤዦ ማኣራፓ ኬስኬኔ፤ ዬያታ ዓኣፒዳ ዱካ ቦኦሬ ማኣዖ ማይንቲ ዓኣኔ፤ ሃሣ ዳዶይዳኣ ዎርቄና ኮሺንቴ ቃልሾ ቱኡቲ ዓኣኔ።"]},{"type":"verse","number":7,"content":["ዬኖና ዖይዶ ባኮንሢዳፓ ፔቴሢ ናንጊና ናንጋ ፆኦዛሢኮ ዻጋ ኩሚ ዓኣ፥ ዎርቆና ኮሺንቴ ላንካይ ዑሺ ዓንጊ ላንካዎ ኪኢታንቾንሢም ዒንጌኔ፤"]},{"type":"verse","number":8,"content":["ሃሣ ጌኤዦ ማኣራ ፆኦሲኮ ቦንቾና ዎልቆናይዳፓ ኬስካ ጩቦና ኩሜኔ፤ ላንካዎ ኪኢታንቾንሢኮ ላንካዎ ባይዛ ባኮንሢ ማዺንቲ ኩማንዳያ ሄላንዳኣና ዖኦኒያ ጌኤዦ ማኣሮ ጌላኒ ዳንዳዒባኣሴ።"]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/REV/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/REV/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/REV/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}