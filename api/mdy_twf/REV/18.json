{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"REV","translationId":"mdy_twf","name":"ዮሃኒሴም ፆኦሲ ዻዌ ባኮ","commonName":"ዮሃኒሴም ፆኦሲ ዻዌ ባኮ","title":"ዮሃኒሴም ፆኦሲ ፔጋሲ ዻዌ ባኮ","order":66,"numberOfChapters":22,"sha256":"21ee27498e0f32d3590a358becc3f65cafb91172702e2c13c648b7b869fa62d0","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/mdy_twf/REV/22.json","totalNumberOfVerses":401},"chapter":{"number":18,"content":[{"type":"heading","content":["ባብሎኔ ካታሞኮ ሎኦሚፆ"]},{"type":"verse","number":1,"content":["ዬካፓ ሃሣ ዼኤፒ ቢታንቶ ዓኣ፥ ሜሌ ኪኢታንቾስኬይ ጫሪንጫፓ ኬዳንዳቴ ታ ዛጌኔ፤ ዒዛኮ ቦንቾ ፖዖ ሼኤሪፃፓ ዔቄያና ሳዓ ፖዔኔ፤"]},{"type":"verse","number":2,"content":["ዒዚ ዼኤፒ ዑኡሲና፦",{"text":"«ዼኤፖ፥ ባብሎኔ ካታሜላ ሎኦሜኔ! ሎኦሜኔ!","poem":1},{"text":"ፃላሄኮዋ ናንጊ ቤሲ ማዔኔ!","poem":2},{"lineBreak":true},{"text":"ሃሣ ፑርቶ ዓያኖኮዋ ዎይሢ ቤሲ ማዔኔ፤","poem":2},{"text":"ፑርታ ሃሣ ሻኣካያ ማዔ፥ ካፖኮ ቢያ","poem":1},{"text":"ዎይሢ ቤሲ ማዔኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዴራ ቢያ ዒዞኮ","poem":1},{"text":"ፑርቶ ሱኡኮ ማዾ ዑዦ ዑሽኬኔ፤","poem":2},{"lineBreak":true},{"text":"ዓጮ ካኣታ ዒዞና ዎላ ዞኦዛ ኮኦሜኔ፤","poem":2},{"text":"ሃሣ ዓጮይዳ ኮርሞ ኮርማ ዓሳኣ","poem":1},{"text":"ዑሣ ዓኣዼ ዒዛ ሳኣ ናንጊም ጊኢጋያታሢሮ ዖርጎጬኔ»","poem":2},"ጌዒ ዒላቴኔ።"]},{"type":"verse","number":4,"content":[{"text":"ሃሣ ሜሌ ዑኡሲ ጫሪንጫፓ፦","poem":1},{"text":"«ታ ዴሬዮቴ! ዒዛ ማዻ ጎሞ ዒንሢ ማዹዋጉዲ","poem":2},{"lineBreak":true},{"text":"ዒዞም ዓጎና ባይሲንቶና ዒንሢያ ባይቁዋጉዲ፤","poem":2},{"text":"ዒዞይዳፓ ኬስኩዋቴ።","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ዓይጎሮ ጌዔቴ ጎማ ዒዞኮ ኩሊንቲ","poem":1},{"text":"ጫሪንጮ ሄሌሢሮ","poem":2},{"text":"ፆኦሲ ዒዞኮ ፑርቱሞ ጶቂሤሢሮኬ።","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ዒዛ ዒንጌማጉዲ ማሂ ዒንጉዋቴ፤","poem":1},{"text":"ዒዛ ማዼ ማዾኮዋ ጳንጬ ዒዞም ማሁዋቴ፤","poem":2},{"text":"ዒዛ ሲኢሪ ዒንጌ ዑዦ፥ ጳንጬ ማሂ","poem":1},{"text":"ሲኢሪ ዒዞም ዒንጉዋቴ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዒዛ ፔና ቦንቺሲ ሳኣ ናንጊም ጊኢጋያ ማሄማጉዲ","poem":1},{"text":"ዒዞ ሜታሲ ዖዪሱዋቴ፤","poem":2},{"text":"ዒዛ ፔኤኮ ዒኖና፦","poem":1},{"lineBreak":true},{"text":"‹ታኣኒ ካኣቲ ማዒ ዴዔኔ፤","poem":1},{"text":"ዓኒ ታኣኮ ሃይቄያቱዋሴ፤","poem":2},{"lineBreak":true},{"text":"ፔቴታዖ ዖዪያ ታ ዖዩዋሴ›","poem":2},"ጌዒ ጌዒ ሄርሺንታኔ።"]},{"type":"verse","number":8,"content":[{"text":"ዬያሮ ዒዞም ዓጎና ባይሲንታ","poem":1},{"text":"ፔቴ ኬሊ ዒዞ ሄላንዳኔ፤","poem":2},{"lineBreak":true},{"text":"ሃይቢና ዖዪሢና ናይዚና ዒዞ ሄላንዳኔ፤","poem":2},{"text":"ዒዞይዳ ዎጋ ጎዳ ማዔ ፆኦዛሢ ዼኤፒ ማዔሢሮ","poem":1},{"text":"ታሚና ዒዛ ሚቺንታንዳኔ»","poem":2},"ጋዓንቴ ታ ዋይዜኔ።"]},{"type":"verse","number":9,"content":["ዒዞና ዎላ ዞኦዛ ኮኦሚ፥ ጊኢጋ ናንጊ ናንጌ፥ ሳዖ ካኣታ ዒዛ ሚቺንታ ዎዶና ኬስካ ጩቦ ዛጊ ዒዞሮ ዒላቲ ዒላቲ ዬኤካንዳኔ።"]},{"type":"verse","number":10,"content":["ዔያታ ዒዞይዳ ሄሌ ሜታሢ ዛጎ ዒጊጪ፥ ሃኬ ዔቂ፦",{"text":"«ኔኤኒ ሃና ዼኤፖ ካታሜሌ!","poem":1},{"text":"ኔኤኒ ሃና ፑኡፒ ማዔ፥ ባብሎኔ!","poem":2},{"text":"ፑርቶ ዎጋ ኔ ጊዳ ዑኬና ሙኬሢሮ","poem":1},{"text":"ባዴዔ ኔና! ባዴዔ ኔና!»","poem":2},"ጋዓንዳኔ።"]},{"type":"verse","number":11,"content":["ዔያቶኮ ዋኣፆ ካኣሚላ ጫኣኔ ባኮ ሃካፓ ሴካ ሻንቃ ዓሲ ባኣሢሮ፥ ሳዖይዳ ኮርሞ ኮርማ ዓሳ ዒዞ ዛሎ ዬኤኪ ዖያንዳኔ፤"]},{"type":"verse","number":12,"content":["ዔያታ ዋኣፆ ካኣሚሎይዳ ጫኣኔ ባካ፦ ዎርቄ፥ ቢራ ዓንጊ፥ ቦንቺንታ ሹቺ፥ ሚዛጲ ሹቺ፥ ቦኦሬ ሻኣዣ ዓፒላ፥ ጮልዔ ዲንኪ ማኣዓ፥ ሱኡፔ ዓፒላ፥ ዞቄ ዓፒላ፥ ቃራ ሳውቃ ዱማ ዱማ ሚሢ፥ ዳርሲ ዓቺንታ ሚርጌ ሚኢሼ ዔካ ሚሢንታ ሞኦና ዓንጊንታ ሜሌ ዓንጎንታ ቦኦሬ ሚዛጶ ሹጮንታይዳፓ ኮሺንቴ ባካ ቢያ፥"]},{"type":"verse","number":13,"content":["ሳውቃ ሚሢ ቁኡሪ፥ ዱማ ዱማ ሳውቃ ዼኤሻ፥ ካርቤ፥ ቲሺ፥ ዑንጄ፥ ዎይኖ ዑዣ፥ ሪሚቶ ዛይታ፥ ሺኢቺ ዺኢሊ፥ ዛርጌ፥ ባይ፥ ማራይ፥ ፓራ፥ ሳርጌላ ዖይታ፤ ዬያጉዲ ሃሣ ዓይሎ ማዔ ዓሶንታ ዖሎና ዲዒ ዔኮና ዓሶንታኬ።"]},{"type":"verse","number":14,"content":["ዬንሢ ኮርሞ ኮርማዞንሢ፦ «ኔኤኒ ናሽካ ኮዦ ባካ ቢያ ኔ ጊዳፓ ቤቲ፥ ዴንዴኔ፤ ኔኤኮ ዖርጎቹሞና ፓልሞና ቢያ ባይቄኔ፤ ማይ ዬይ ባካ ኔኤም ጊንሣ ጴዻዓኬ» ዒዞም ጋዓኔ።"]},{"type":"verse","number":15,"content":["ዬያ ባኮ ዒዞይዳፓ ሻንቂ ኮርሚ ዖርጎጬ ኮርማ ዓሳ ዒዞይዳ ሄሌ ሜቶ ዒጊጪሢና ሃኬ ዒዞኮ ዔቃንዳኔ፤ ሃሣ ዔያታ ዒዞ ዛሎ ዬኤኪ ዬኤኪ ዖያንዳኔ፤"]},{"type":"verse","number":16,"content":["ዑኡዞዋ ዔያታ ዼጊዲ፦",{"text":"«ሻኣዦ ዓፒሎንታ ዲንኮ ዞቄ ዓፒሎንታ ማይንታዞ","poem":1},{"text":"ዎርቆና ሚዛጶ ሹጮና ፓልሚንቴዞ","poem":2},{"lineBreak":true},{"text":"ዼኤፖ፥ ካታሜሎ ባብሎኔም ባዴዔ! ባዴዔ!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዬይ ቆላ ቢያ ኔጉዋዖ ኔኤኮ ባይቂባይ!» ጋዓንዳኔ።","poem":1},"ዋኣፆ ካኣሚሎኮ ሱኡጋ ቢያ፥ ዋኣፆ ካኣሚሎ ቶጊ ዓኣዻ ዓሳ ቢያ፥ ዋኣፆ ካኣሚሎይዳ ማዻ ዓሶንታ ባዞ ዑፃ ሃንቲ ሃንቲ ኮርማ ዓሳ ቢያ ዒዞኮ ሃኬ ዔቃንዳኔ፤"]},{"type":"verse","number":18,"content":["ዒዛ ሚቺንታኣና ኬስካ ጩቦ ዛጋዖ፦ «ሃኖ ዼኤፖ ካታሜሎጉዴያ ሜሌ ካታማ ዎካዳይ?» ጌይ ጌይ ዔያታ ዒላቴኔ።"]},{"type":"verse","number":19,"content":["ሃሣ ዔያታ ፔኤኮ ቶኦካ ሲላሊ ዋሂ፥ ዖዪ ዬኤኪ ዬኤኪ፦",{"text":"«ባዞይዳ ዋኣፆ ካኣሚላ ዓኣ ዓሳ ቢያ","poem":1},{"text":"ዒዞ ቆሎና ዖርጎጬ ዓሳ","poem":2},{"text":"ዼኤፖ ካታሜላ ዑኬና፥ ኔጉዋዖ ባይቄሢሮ","poem":1},{"lineBreak":true},{"text":"ባዴዔ! ባዴዔ!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ጫሪንቺዮ! ዒዛ ባይቄሢሮ ዎዛዼ፤","poem":1},{"text":"ዒንሢ ፆኦሲም ዱማዼዞንሢና ፆኦሲ ማዾም ዳኪንቴዞንሢዮ","poem":2},{"lineBreak":true},{"text":"ሃሣ ፆኦሲ ማሊፆ ኬኤዛዞንሢዮ ዎዛዹዋቴ፤","poem":2},{"text":"ዓይጎሮ ጌዔቴ፦","poem":1},{"text":"ፆኦሲ ዒንሢዳ ዒዛ ሄሊሴ ሜቶሮ ጌዒ","poem":2},{"lineBreak":true},{"text":"ዒዞ ፑርታና ዎጌኔ» ጌይ ጌይ ዒላቴኔ።","poem":2}]},{"type":"verse","number":21,"content":["ዬካፓ ሃሣ ፔቴ ዼኤፒ ኪኢታንቻስኬይ ፑኡፒ ዎንሢ ሹቺጉዴ ሹቺ ዔኪ ባዞይዳ ኬኤራዖ፦ «ዼኤፖ ካታሜላ፥ ባብሎኔ ሃኣዺዲ ዎልቄና ኬኤሪንታንዳኔ፤ ሃካፓ ሴካ ዒዛ ጴዻዓኬ፤"]},{"type":"verse","number":22,"content":[{"text":"ጎኦሎ ዋርቃ ዓሶንታ ዓይኑሞ ዓይናዻ ዓሶ ዑኡዛ","poem":1},{"text":"ሹሉንጎንታ ዛያሢንታ ዋርቃ ዓሶ ዑኡዛ","poem":2},{"lineBreak":true},{"text":"ላሚ ኔ ጊዳ ማይ ዋይዚንታዓኬ፤","poem":2},{"text":"ዱማ ዱማ ባኣዚ ሃኣማቶና ማዻ ዓይጎ ዓሲያ","poem":1},{"text":"ሃይፓ ሴካ ኔ ጊዳ ጴዻዓኬ፤","poem":2},{"lineBreak":true},{"text":"ዎንሢ ዎዺንታያኣ ማይ ኔ ጊዳ ዋይዚንታዓኬ።","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ፖዓ፥ ፖዒያ ኔ ጊዳ","poem":1},{"text":"ሃይፓ ሴካ ፖዓዓኬ፤","poem":2},{"lineBreak":true},{"text":"ዔፒ ሃይሴያ ሃይፓ ሴካ ኔ ጊዳ ዋይዚንታዓኬ።","poem":2},{"text":"ኔ ዓጮኮ ኮርሞ ኮርማ ዓሳ","poem":1},{"text":"ዓጮ ቢያይዳ ዔርቴ ዼኤፖ ዓሶኬ፤","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ማርሾና ዓሶ ቢያ ኔ ዻቢሼኔ።","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ዒዞይዳ ፆኦሲ ማሊፆ ኬኤዛዞንሢንታ","poem":1},{"text":"ፆኦሲም ዱማዼዞንሢንታ","poem":2},{"lineBreak":true},{"text":"ሳዖይዳ ዎዺንቴ ዓሶኮዋ ቢያ ሱጉፃ ጴዼኔ» ጌዔኔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}