{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"REV","translationId":"mdy_twf","name":"ዮሃኒሴም ፆኦሲ ዻዌ ባኮ","commonName":"ዮሃኒሴም ፆኦሲ ዻዌ ባኮ","title":"ዮሃኒሴም ፆኦሲ ፔጋሲ ዻዌ ባኮ","order":66,"numberOfChapters":22,"sha256":"21ee27498e0f32d3590a358becc3f65cafb91172702e2c13c648b7b869fa62d0","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/mdy_twf/REV/22.json","totalNumberOfVerses":401},"chapter":{"number":5,"content":[{"type":"heading","content":["ማሪንቴ ማፃኣፖና ማራዓሢና ዛላ"]},{"type":"verse","number":1,"content":["ካኣቱሞ ዖይቶይዳ ዴዔሢኮ ሚዛቆ ኩጫ ጋሮና ዙሎናይዳ ቢያ ፃኣፒንቴያ ሃሣ ላንካይ ዔርዛ ማላታ ዑፃ ዖኦኒያ ቡሉዋጉዲ ዓይሦና ማሪንቴ ማፃኣፔ ታ ዛጌኔ፤"]},{"type":"verse","number":2,"content":["ፔቴ ዼኤፒ፥ ኪኢታንቾስኬይ ዼጊ ጌዔ ዑኡሲና፦ «ዬንሢ ዔርዛ ማላቶንሢ ቡላኒና ማፃኣፖዋ ቡላኒ ዳንዳዓሢ ዖናዳይ?» ጋዓንቴ ታ ዛጌኔ።"]},{"type":"verse","number":3,"content":["ጋዓንቴ ጫሪንጮይዳ ሳዖይዳ ሃሣ ሳዖኮዋ ዴማ ማፃኣፖ ቡሊ ጋሮይዳ ዓኣ ባኮ ዛጋኒ ዳንዳዓ ዓሲ ዖኦኒያ ባኣያ ማዔኔ፤"]},{"type":"verse","number":4,"content":["ማፃኣፓሢ ቡሊ ጋሮ ዛጋኒ ዳንዳዓ ዓሲ ጴዺባኣያ ማዔሢ ታ ዴንቄ ዎዶና ሚርጌና ዬኤኬኔ፤"]},{"type":"verse","number":5,"content":["ዬማና ጋርቾንሢዳፓ ፔቴይ፦ «ዬኤኪፖ፤ ሃኣዛጌ ዪሁዳ ማኣራፓ ማዔ፥ ዞባሢ፥ ዳውቴ ፃጳሢ ዖሎና ባሼያ ማዔሢሮ ዒዚ ማፃኣፓሢና ላንካዎ ‹ቡሎፓ› ጌይንቴ ማላቶንሢ ቡላኒ ዳንዳዓያኬ» ታኣም ጌዔኔ።"]},{"type":"verse","number":6,"content":["ዬካፓ ካኣቱሞ ዖይቶና ዖይዶ ባኮንሢናኮ ሃሣ ጪሞንሢኮዋ ባኣካ ዎዾናያ ማላ ማራይ ዔቂ ዓኣንቴ ታ ዛጌኔ፤ ዬያ ማራዓሢኮ ላንካይ ጉራኒና ላንካይ ዓኣፒና ዓኣኔ፤ ዬያታ ዓጮ ቢያ ዳኪንቴ ላንካዎ ፆኦሲ ዓያኖንሢኬ።"]},{"type":"verse","number":7,"content":["ማራዓሢ ሙኪ ካኣቱሞ ዖይቶይዳ ዴዔሢኮ ሚዛቆ ኩጫ ዓኣ፥ ማፃኣፓሢ ዔኬኔ፤"]},{"type":"verse","number":8,"content":["ዒዚ ማፃኣፖ ዔካማና ዖይዶ ባኮንሢንታ ላማታሞ ዖይዶ ጪሞንሢንታ ማራዓሢኮ ቤርታ ጉምዓቲ፥ ባሊቶና ሂርኪ ጌዒ ዚጌኔ፤ ዬያታ ፔቴ ፔቴሢ ኩጮይዳ ጎኦላ ዔኪ ሃሣ ፆኦሲም ዱማዼ ዓሶኮ ሺኢጲፆ ማዔ ዑንጆ ዓርቄያ ዎርቄና ኮሾና ዔቴ ማዔ ዻካ ሳኣኔ ዔኪ ዓኣኔ።"]},{"type":"verse","number":9,"content":["ዔያታ ቤርታ ጌይንቲ ቤቂባኣ ፆኦሲ ቦንቾም ማዓ ዓይኑሞ፦",{"text":"«ማፃኣፓሢ ዔካኒና","poem":1},{"text":"‹ቡሎፖ› ጌይንቴ ማላቶንሢያ ቡላኒ","poem":2},{"lineBreak":true},{"text":"ኔ ዳንዳዓያ ማዔኔ፤","poem":2},{"text":"ዎይቲ ጌዔቴ ኔኤኒ ዎዺንቴኔ፤","poem":1},{"text":"ኔኤኮ ሱጉፆና ዱማ ዱማ ቶኦካፓ","poem":2},{"lineBreak":true},{"text":"ዱማ ሙኡቺ ጌስታ ዓሶፓ፥ ዜርፃፓ","poem":2},{"lineBreak":true},{"text":"ሃሣ ዓሲ ቢያ ባኣካፓ ዱማሲ","poem":2},{"lineBreak":true},{"text":"ዓሶ ፆኦሲም ኔ ጊንሣ ማሂ ሻንቄኔ፤","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኑ ፆኦዛሢማኣ ቄኤሴ ማዒ","poem":1},{"text":"ዔያታ ማዻንዳጉዲ ኔ ማሄኔ፤","poem":2},{"lineBreak":true},{"text":"ሳዖይዳኣ ዔያታ ካኣታዻንዳኔ»","poem":2},"ጌዒ ጌዒ ዓይናዼኔ።"]},{"type":"verse","number":11,"content":["ዬካፓ ሃሣ ታ ዛጋዖ ካኣቱሞ ዖይቶና ዖይዶ ባኮንሢና ጪሞንሢናኮ ኮይላ ሚርጌ ኪኢታንቾኮ ዑኡሲ ታ ዋይዜኔ፤ ዬያቶኮ ሚርጉማ ሚርጌ ሺያፓ ዑሣ ሃሣ ፓይዲንታኒያ ዳንዳዒንቱዋያኬ፤"]},{"type":"verse","number":12,"content":["ዬያታ ዼኤፒ ዑኡሲና፦",{"text":"«ዎዺንቴ ማራዓሢም ዎልቄ፥ ቆሎ","poem":1},{"text":"ዔራቶ፥ ዶዱሞ፥ ቦንቾንታ ሄርሺሢንታ","poem":2},{"lineBreak":true},{"text":"ጋላታንታ ኮይሳያኬ» ጌይ ዓይናዼኔ።","poem":2}]},{"type":"verse","number":13,"content":["ዬካፓ ጫሪንጮና ሳዖናይዳ፥ ሳዖኮዋ ዴማ ሃሣ ዼኤፖ ባዞናይዳ፥ ዬያ ባኮ ቢያይዳ ዓኣ ማዢንታ ቢያ፦",{"text":"«ካኣቱሞ ዖይቶይዳ ዴዔሢና ማራዓሢናም","poem":1},{"text":"ጋላታ፥ ቦንቾ፥ ሄርሺሢንታ ዎልቄንታ","poem":2},{"lineBreak":true},{"text":"ናንጊና ማዖንጎ» ጌይ ዓይናዻንቴ ታ ዋይዜኔ።","poem":2}]},{"type":"verse","number":14,"content":["ዖይዶ ባኮንሢያ «ዓኣሜን» ጌዔኔ፤ ጋርቾንሢ ጊንሣ ባሊቶ ሳዖ ባንሢ ሂርኪዲ ጉምዓቲ ዚጌኔ።"]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/REV/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/REV/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/REV/4.json","previousChapterAudioLinks":{},"numberOfVerses":14}