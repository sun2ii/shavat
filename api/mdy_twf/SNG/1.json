{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"SNG","translationId":"mdy_twf","name":"ቢያፓ ባሼ ዓይኑሞ","commonName":"ቢያፓ ባሼ ዓይኑሞ","title":"ቢያፓ ባሼ ማዔ ዓይኑሞ","order":22,"numberOfChapters":8,"sha256":"2df956ff2845a42570eab898a1fb8f6d7254908e9b99a513984b49fbe808d265","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/mdy_twf/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ሴሎሞኔ ዓይናዼ፥ ቢያፓ ባሻ ዓይኑሞ"]},{"type":"heading","content":["ቤርታሳ ዓይኑሞ"]},{"type":"verse","number":2,"content":[{"text":"ናሹማ ኔኤሲ ዎይኖ ዑዣፓ ባሼ ታና ዎዛሳያ ማዔሢሮ","poem":1},{"text":"ኔ ሙሱራ ታና ሄርቆንጎ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ኔኤኒ ቲሽቴ ቲዣ ቃራ ሳውቃያኬ፤","poem":1},{"text":"ሱንፆ ኔኤኮ ዔኤሊፃ ሳውቃ ቲዦ ፑኡኪሢጉዲኬ፤","poem":2},{"lineBreak":true},{"text":"ዉዱራሢ ኔና ናሽካሢ ዬያሮኬ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ኩጮ ታኣኮ ዓርቂ ጎቺ ታና ዔኪ ዓኣዼ፤","poem":1},{"lineBreak":true},{"text":"ኑ ዎላ ዑካዺ ዓኣዾም፤","poem":1},{"text":"ካኣቲ ፔ ቆልዖ ጋሮ ታና ዔኪ ጌልዜኔ።","poem":2},"ዑኡቴሎኮ ላጎ ዓይኑሞ",{"text":"ኔኤኮ ናሹማ ኮሺ ኑና ዎዛሳኔ፤","poem":1},{"text":"ዎይኖ ዑዦይዳፓ ባሼ ናሹሞ ኔኤሲ ኑ ሄርሻኔ።","poem":2},"ዑኡቴሎ ዓይኑሞ",{"text":"ዔያታ ኔና ሃያይዲ ናሽካሢ ፒዜኬ።","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ዒንሢ ዬሩሳላሜ ዓጮ ዉዱራሢ ዋይዙዋቴ!","poem":1},{"text":"ታኣኒ ካርሢኬ፤","poem":2},{"lineBreak":true},{"text":"ማዔቴያ ታኣኒ ሚዛጲኬ፤","poem":2},{"lineBreak":true},{"text":"ካርሡማ ታኣኮ ቄዳሬይዳ ዓፒሎና ማዢንቴ ማኣሮጉዲኬ፤","poem":2},{"lineBreak":true},{"text":"ሚዛጱማ ታኣኮ ጋዓንቴ ሴሎሞኔኮ ካኣቱሞ ማኣሮ ጎኦቦ ዓፒሎጉዲኬ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታና ካርሤሢ ዓቦ ሩኡጶኬ፤","poem":1},{"text":"ታኣኒ ካርቴሢሮ ታና ቶኦቺፖቴ፤","poem":2},{"lineBreak":true},{"text":"ታ ዒንዶ ናኣቶ ማዔ ታ ጌርሲንሢ ታኣና ፑርቴሢሮ","poem":2},{"lineBreak":true},{"text":"ዎይኖ ጎዦ ታና ዔያታ ካፒሴኔ፤","poem":2},{"lineBreak":true},{"text":"ዬያሮ ታኣኒ ታ ዎይኖ ጎዦ ካፒፆ ሃሼኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታ ዒሼ! ታኣም ሂንዳ ኬኤዜ፤","poem":1},{"text":"ኔኤኮ ማራቶ ኔኤኒ ዓንካ ሄንቃይ?","poem":2},{"lineBreak":true},{"text":"ዓባ ሳዛ ማዓኣና ኔ ዔያቶ ዓንካ ቃኣቲሳንዳቴያ ታኣም ኬኤዜ፤","poem":2},{"lineBreak":true},{"text":"ታ ኔና ኮይፆ ኔ ላጎ ቆልሞ ጊንፆ ዓኣዺሢና","poem":2},{"lineBreak":true},{"text":"ዓፒላ ቶኦኪና ጉኡሊንቴ ላኣሊጉዲ ማዒሢና","poem":2},{"lineBreak":true},{"text":"ዣኣሊ ሺራሢ ዓይጎሮዳይ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ኔኤኒ ላኣሎይዳፓ ቢያ ባሼ ሚዛጴሌ!","poem":1},{"text":"ቤዞ ኔ ዔሩዋያ ማዔቴ","poem":2},{"lineBreak":true},{"text":"ማራቶ ኮጲዞ ዓርቂ ዓኣዼ፤","poem":2},{"text":"ዋናናኣቶ ኔኤኮ","poem":1},{"text":"ሞኦፆ ናኣቶ ጉርዶ ዓጫ ሄንቄ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ታ ሚሼ! ጊብፄ ካኣቲኮ ሳርጌሎ ዖይቶ ጎቻ","poem":1},{"text":"ፓራሢ ባኣካ ዓኣ ዒንዶ ፓሮ ኔኤኒ ማላኔ፤","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ጋንጋራ ኔኤኮ ሚዛጲ ሙሊሢ ሹቺጉዲኬ፤","poem":1},{"text":"ባቃና ኔኤኮ ሚዛጶ ፓልማሢና ማዒ ዴንቃያኬ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኑኡኒ ጋዓንቴ ቢራ ዓንጊ ፓልሞ","poem":1},{"text":"ዎርቄና ሚዛጲሶናያ ኔኤም ኮሻንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ካኣቲ ቃሚፆ ሻኣሎይዳ ሙዖሮ ዴይ ዓኣንቴ","poem":1},{"text":"ታኣኮ ሳውቃ ቲዦ ሳውማ ጋሮ ዒዛኮ ዔኬኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ታ ዒሼ፥ ታኣኮ ዻንፆ ባኣካ ላሃ","poem":1},{"text":"ሳውማ ዒዛኮ ዖሺንቲ ዓኣ ኬርቤጉዲኬ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ታ ዒሼ፥ ዒንጌዴ ጌይንታ ዎይኖ ቱኮ ቤዛ","poem":1},{"text":"ባቃሊ ዓኣ ቦኦሊ ቡኒጉዲኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ታ ሚሼ! ዎዚ ኔኤኒ ሚዛጳይ!","poem":1},{"text":"ዓውካራ ኔኤኮ ዎዚ ኮሽካይ!","poem":2},{"lineBreak":true},{"text":"ዓኣፓ ኔኤኮ ዶኦሌ ዓኣፒጉዲ ሚዛጳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ታ ዒሼ! ኔኤኒያ ሚዛጲታንቴሞ፤","poem":1},{"text":"ኮሺ ኔ ታና ዎዛሳኔ፤","poem":2},{"lineBreak":true},{"text":"ሻኣላ ኑኡኮ ዋርቂ ዓኣ ማኣቲጉዲ ዎዛሳያኬ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ማኣሮኮ ኑኡኮ ቱርቱራ ሊባኖኦሴ ሚፆኬ፤","poem":1},{"text":"ሳካኣ ዚቢቆ ሚፆና ማዢንቴያኬ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}