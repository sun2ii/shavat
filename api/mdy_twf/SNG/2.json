{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"SNG","translationId":"mdy_twf","name":"ቢያፓ ባሼ ዓይኑሞ","commonName":"ቢያፓ ባሼ ዓይኑሞ","title":"ቢያፓ ባሼ ማዔ ዓይኑሞ","order":22,"numberOfChapters":8,"sha256":"2df956ff2845a42570eab898a1fb8f6d7254908e9b99a513984b49fbe808d265","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/mdy_twf/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"ታኣኒ፥ ሳኣሮኔ ቦኦሎ ቡኖጉዲ","poem":1},{"text":"ዶኦቺዳ ባቃሌ ሚዛጲ ቡኒጉዲኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ታኣኮ ሚሼላ፥ ኔኤኒ ዉዱራሢ ባኣካ ጴዻ ዎዶና","poem":1},{"text":"ዓንጊሢ ባኣካ ዓኣ ሚዛጲ ቡኒጉዲኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ታኣኮ ዒሼ፥ ሜሌ ዼጌሢና ዎላ ቤኤዞዛ","poem":1},{"text":"ካዮ ሚፆ ባኣካ ሚዛጲ ጴዻ ጋሲጉዲኬ፤","poem":2},{"text":"ታኣኒያ ሚርጌ ታና ዎዛሴም ዒዛኮ ሺባ ዴይ ሃውሼኔ፤","poem":1},{"text":"ዓኣፖዋ ሙይ ታኣኒ ዎዛዼኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዒዛኮ ሙዖ ሙዎ ዳልጎ ኬኤፆ ታና ዒ ጌልዜኔ፤","poem":1},{"text":"ዒ ታ ዑፃ ባንዴራ ማሂ ዓርቄ ባካ ናሹሞኬ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ታ ዒዛ ናሽኪ ሃርጊንቴሢሮ","poem":1},{"text":"ዎይኖኮ ሜሌ ዓኣፖ ሙኡዚ ታና ዶዲሹዋቴ፤","poem":2},{"lineBreak":true},{"text":"ጋዞ ዓኣፖዋ ሙኡዚ ታና ዎዛሱዋቴ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ፔኤኮ ሻውሎ ኩጮ ኬሬ ማሂ ጌሣኔ፤","poem":1},{"text":"ሚዛቆ ኩጮና ታና ዒ ኮንቃኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዒንሢ፥ ዬሩሳላሜ ዉዱራሢ!","poem":1},{"text":"ዒዚ ፔኤሮ ኮዓንዳያ ሄላንዳኣና","poem":2},{"lineBreak":true},{"text":"ዒዛ ዒንሢ ካኣሚ ጴቹዋጉዲ፤","poem":2},{"lineBreak":true},{"text":"ካዮ ቦዖ፥ ዶቆዞና ሞይሎ","poem":2},{"noteId":0},{"text":"ሱንፆና","poem":2},{"lineBreak":true},{"text":"ታኣኒ ዒንሢ ሺኢቃኔ።","poem":2}]},{"type":"heading","content":["ላምዓሳ ዓይኑሞ"]},{"type":"verse","number":8,"content":[{"text":"ታ ዒሼ ዹኮና ጌሜሮና ዑፃ ኮኦሚ ኮኦሚ ሙካኣና","poem":1},{"text":"ዑኡዛ ዒዛሲ ታኣም ዋይዚንታኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታኣኮ ዒሼ፥ ሞይሌና ዶቆሲናኮ ናይ ማላኔ፤","poem":1},{"text":"ሃይሾ ኑ ማኣሮኮ ቲኢፆ ዓጫ ዒ ዔቂ ዓኣኔ፤","poem":2},{"text":"ማኣሮኮ ፑልቶ ካሮና ጋሮ ባንሢ ዒ ዛጋኔ፤","poem":1},{"text":"ፑልቶ ካራ ጋሲ ኮሾና ፂኢኖና ሞኦኪ ዒ ታና ዛጋኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታ ዒሼ ሂዚ ታኣም ጋዓኔ፦","poem":1},{"lineBreak":true},"ዑኡታሢ ዓይኑሞ",{"text":"ታ ሚሼሌ! ዔቄ፤","poem":1},{"text":"ታኣኮ ሚዛጴሌ! ሃኒ ዬኤ ኑ ዎላ ዓኣዾም፤","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ማይ፥ ባርጋ ጋፔኔ፤","poem":1},{"text":"ዒራኣ ሻንቄኔ፤","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዱማ ዱማ ቦኦሎ ቡና ቡኒፆ ዓርቄኔ፤","poem":1},{"text":"ዓይናዺ ኮርጎ ዎዳ ሄሌኔ፤","poem":2},{"lineBreak":true},{"text":"ዶኦሎ ዱላሢያኣ ኑ ዓጫ ዋይዚንታኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ቤሌሶ ሚፃ ዓሚፆ ዓርቄኔ፤","poem":1},{"text":"ዎይኖ ቡኖ ሳውማ ሳዖ ዔኬኔ፤","poem":2},{"text":"ዬያሮ ታ ሚሼሌ! ዔቄ፤","poem":1},{"text":"ታኣኮ ሚዛጴሌ! ሃኒ ዬኤ ኑ ዎላ ዓኣዾም።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ጋጋ ዓኣ ላሎ ዛኣዚንፆይዳ","poem":1},{"text":"ዓኣሺንቲ ዴዔ ታኣኮ ዶኦሌሌ","poem":2},{"text":"ሂንዳ ዓኣፖ ካሮ ኔኤኮ ታና ዻዌ፤","poem":1},{"text":"ዑኡዞዋ ኔኤኮ ታና ዋይዚሴ፤","poem":2},{"lineBreak":true},{"text":"ዑኡዛ ኔኤኮ ታና ዎዛሳያ","poem":2},{"lineBreak":true},{"text":"ኔኤኒ ኮሺ ሚዛጳያኬ።","poem":2},"ዑኡቴሎኮ ጌርሲንሢ ዓይኑሞ"]},{"type":"verse","number":15,"content":[{"text":"ዎይኖ ጎዣ ቡኒ ዓኣ ዎይኖ ፑርቲሳ","poem":1},{"text":"ዬያ ዻኮ ዻኮ ዉኡካሢ","poem":2},{"lineBreak":true},{"text":"ፒሪ ኑም ዓርቁዋቴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ታ ዒሼ ታኣሮኬ፥ ታኣኒያ ዒዛሮኬ፤","poem":1},{"text":"ዒዚ ሚዛጶ ቡኖ ባኣካ ቆልሞ ፔኤኮ ሄንቃኔ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዹማ ካራንዳያ ሄላንዳኣና","poem":1},{"text":"ጉቶ ዢባራ ዢባርሻንዳያ ሄላንዳኣና","poem":2},{"text":"ታ ዒሼ! ሞይሌ ናይ፥ ጊንሣ ሃሣ ዶቆሲ ናይጉዲ","poem":1},{"text":"ጋጎ ማዔ ዹኮ ቶኦካ ኮኦሚ ኮኦሚ ማዒ ሙኬ።","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"2፡7 ዶቆዞና ሞይሎ ዬንሢ ቦዖንሢ ሚናኣ ጫኣቁሞ ዎዶና ጌኤሺ ቦዖኬ ጌይ ካኣሽኪንታሢሮ ዔያቶኮ ዱማ ዎልቄ ዓኣኔ ጌይ ዬኖ ዎዶ ዓሳ ጉሙርቃኔ።","reference":{"chapter":2,"verse":7}}]},"thisChapterLink":"/api/mdy_twf/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}