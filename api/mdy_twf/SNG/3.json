{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"SNG","translationId":"mdy_twf","name":"ቢያፓ ባሼ ዓይኑሞ","commonName":"ቢያፓ ባሼ ዓይኑሞ","title":"ቢያፓ ባሼ ማዔ ዓይኑሞ","order":22,"numberOfChapters":8,"sha256":"2df956ff2845a42570eab898a1fb8f6d7254908e9b99a513984b49fbe808d265","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/mdy_twf/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"ዋንቶ ጉቤ ሻኣሎይዳ ታ ላሃዖ","poem":1},{"text":"ዒናፓ ታ ናሽኬሢ ታኣኒ ኮዔኔ፤","poem":2},{"lineBreak":true},{"text":"ታ ኮዔኔ፥ ጋዓንቴ ታ ዒዛ ዴንቂባኣሴ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ሃሢ ታኣኒ ዔቂ ካታሞ ኬስካንዳኔ፤","poem":1},{"text":"ዼኤፖ ጎይፆና ዓሳ ቡካ ጶኦኮናይዳ ታ ሃንታንዳኔ፤","poem":2},{"text":"ዒናፓ ታ ናሽኬሢ ታ ኮዓንዳኔ፤","poem":1},{"text":"ታ ዒዛ ኮዔኔ፥ ጋዓንቴ ታኣኒ ዴንቂባኣሴ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ዒማና ካታሞ ሳዛ ሃንታ","poem":1},{"text":"ካታሞ ካፓ ዓሳ ታና ዴንቄኔ፤","poem":2},{"text":"ታኣኒያ ዔያቶ ኮራ","poem":1},{"text":"«ዒናፓ ታ ናሽካ ናዓሢ ዒንሢ ዴንቂያ?» ጌይ ዖኦጬኔ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ዔያቶይዳፓ ዻካ ታ ዓኣዻዖ","poem":1},{"text":"ዒናፓ ታ ናሽካሢ ታኣኒ ዴንቄኔ፤","poem":2},{"lineBreak":true},{"text":"ቶሉዋጉዲ ዶዲሺ ታ ዒዛ ዓርቄኔ፤","poem":2},{"text":"ዬካፓ ታ ዒንዶ ማኣሪ ታ ዒዛ ዔኪ ዓኣዺ","poem":1},{"text":"ታና ፔ ጎጳ ኬዴ፥ ታ ዒንዶ ቆልዖ ሄሊሳንዳኣና","poem":2},{"lineBreak":true},{"text":"ታ ዒዛ ሃሺባኣሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ዒንሢ ዬሩሳላሜ ዉዱራሢ!","poem":1},{"text":"ታ ናሽካሢ ፔኤሮ ኮዓንዳያ ሄላንዳኣና","poem":2},{"lineBreak":true},{"text":"ዒንሢ ዒዛ ካኣሚ ጴቹዋጉዲ","poem":2},{"lineBreak":true},{"text":"ካዮ ቦዖ፥ ዶቆዞና ሞይሎ","poem":2},{"noteId":1},{"text":"ሱንፆና","poem":2},{"lineBreak":true},{"text":"ታ ዒንሢ ሺኢቃኔ።","poem":2}]},{"type":"heading","content":["ሃይሣሳ ዓይኑሞ"]},{"type":"verse","number":6,"content":[{"text":"ኮርሞ ዓሶኮ ሳውቃ ዼኤሾጉዲ ቃራ ሳውሞ ዓኣ","poem":1},{"text":"ዑንጄና ኬርቤ ጩቦናጉዲ ዔቂ","poem":2},{"lineBreak":true},{"text":"ዓሳ ናንጉዋ ዳውላፓ ሙካዛ ዬና ዖናዳይ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሃይሾ፥ ሴሎሞኔኮ ሳርጌሎ ዖይታ ሙኪ ሙኪኬ፤","poem":1},{"text":"ዒስራዔኤሌኮ ዖሎና ዔርቴ ዓሶ ባኣካፓ ዶኦሪንቴያ","poem":2},{"lineBreak":true},{"text":"ዒዞ ካፓ ላሂታሚ ፖኦሊሴ ዎላ ዓኣኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ቢያሢ ጬንቾ ዓፓሮና ዖልቶ ጎይፆ ዔሬያ","poem":1},{"text":"ዖልዚናኣ ኮሺ ዔርቴያኬ፤","poem":2},{"text":"ዹሞና ሄላኒ ዳንዳዓ ሜቶ ቃዛኒ","poem":1},{"text":"ፔቴ ፔቴ ጬንቻ ዓፓሮ ኬርና ዔያታ ቱኡቲ ዓኣኔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ካኣቲ ሴሎሞኔ ፔኤም ሳርጌላ ዖይታ ኮሼኔ፤","poem":1},{"text":"ዒዚ ኮሼሢያ ሊባኖኦሴ ሚፆናኬ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዬያ ዖይቶኮ ቶካ ቢራ ዓንጊና ጳርቂንቴያኬ፤","poem":1},{"text":"ቶኦኮ ጌኤቂሶሢያ ዎርቄና ኮሾናያኬ፤","poem":2},{"text":"ዒ ዴዓ ቤዛኣ ዞቄ ዲንኪ ሻኣዣ ዓፒላና ካንቂንቴያኬ፤","poem":1},{"text":"ኬኤፆ ጋራ ዬሩሳላሜ ዉዱራሢ ሚዛጲሴያኬ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዒንሢ ፂዮኔ ዉዱራሢ! ካኣቲ ሴሎሞኔ ዛጋኒ ሃኒ ኬስኩዋቴ፤","poem":1},{"text":"ካኣቲ ሴሎሞኔ ፔኤኮ ቦንቾሮ ዓጎ ባኮ ዓጊ ዓኣሢ ዛጉዋቴ፤","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ዬይ ቦንቾሮ ዓጎ ባካ ዒና ዒዛኮ ዎዛዼ","poem":2},{"lineBreak":true},{"text":"ዒዛኮ ዔፖ ዓቤሎና ዒንዳ ዒዛኮ ቶኦካ ዓጌ ቦንቾ ባኮኬ።","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"3፡5 ዶቆዞና ሞይሎ ጋዓዞ፦ ዓይሢ 2፡7ይዳ ዛጌ።","reference":{"chapter":3,"verse":5}}]},"thisChapterLink":"/api/mdy_twf/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}