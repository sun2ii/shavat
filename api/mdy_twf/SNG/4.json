{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"SNG","translationId":"mdy_twf","name":"ቢያፓ ባሼ ዓይኑሞ","commonName":"ቢያፓ ባሼ ዓይኑሞ","title":"ቢያፓ ባሼ ማዔ ዓይኑሞ","order":22,"numberOfChapters":8,"sha256":"2df956ff2845a42570eab898a1fb8f6d7254908e9b99a513984b49fbe808d265","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/mdy_twf/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"ታ ሚሼሌ! ዎዚ ኔ ሚዛጳይ!","poem":1},{"text":"ዎዚ ኔኤኒ ኮሽካይ!","poem":2},{"text":"ዓኣፖ ካሮ ኔኤኮ ካንቆና ባኮ ባኣኪና ዓኣፓ ኔኤኮ ጴዻኣና","poem":1},{"text":"ዶኦሌ ዓኣፒጉዲ ሚዛጳያኬ፤","poem":2},{"text":"ቶኦኮ ጋማ ኔኤኮ ጌሌዓዴ ዹካፓ ጎዒ ኬዳ","poem":1},{"text":"ዺቢ ዋኣሪጉዲኬ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ዓጫ ኔኤኮ ዔያቶ ባኣካ ሴኤካባኣ","poem":1},{"text":"ጉቤሢ ሜንቴ ሜንቴ ሾዓ","poem":2},{"text":"ጋፓኖ ታይዛዖዋ ዋኣሢና ማስታ","poem":1},{"text":"ቦኦሬ ማራይጉዲ ሚዛጳያኬ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ሙሱራ ኔኤኮ ዲንኪ ዞቄ ፓቲሌጉዲ ሚዛጳኔ፤","poem":1},{"text":"ኔ ጌስታኣና ሚርጌና ኮሽካኔ፤","poem":2},{"text":"ኔኤኮ ላምዖ ዛሎ ጋንጋራ","poem":1},{"lineBreak":true},{"text":"ዓኣፖ ካሮ ካንቆና ባኮ ባኣኪና ጴዻኣና","poem":1},{"text":"ላምዖ ፓቂንቴ ሮኦማኔ ዓኣፒ ማላያኬ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ባቃና ኔኤኮ ሺያና ፓይዲንታ ዖሎና ዔርቴ ዓሶኮ","poem":1},{"text":"ጊቲሞና ዖሎ ዓንጋሞና ሱፂንቲ ዴዓ","poem":2},{"text":"ዖልዚም ዋርዲያ ማዓንዳጉዲ ኮሺንቴያ","poem":1},{"text":"ዳውቴኮ ዼጌ ቤዞ ማላኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ላምዖ ዻንፃ ኔኤኮ ሜንቴ ማይ ሾይንቴያ","poem":1},{"text":"ሚዛጶ ቡኖ ባኣካ ሄንቃ","poem":2},{"lineBreak":true},{"text":"ሞይሌ ናይ ማላኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ሳዓ ካራንዳያ ሄላንዳኣና","poem":1},{"text":"ዹማ ፖዓንዳያ ሄላንዳኣና","poem":2},{"lineBreak":true},{"text":"ሌካ ኬርቤ ዹኮ","poem":2},{"lineBreak":true},{"text":"ጊንሣ ሃሣ ዑንጆ ጌሜሮ ታ ዴንዲ ሃውሻንዳኔ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ታ ሚሼሌ! ጉቤ ካራና ኔኤኒ ሚዛጲኬ፤","poem":1},{"text":"ሃይማ ፓጬኔ ጎዖንዶ ባኣዚ ኔኤኮ ባኣሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ታኣኮ ዑኡቴሌ! ሊባኖኦሴፓ ታ ባንሢ ሃኒ ዬዔ፤","poem":1},{"text":"ሂዮ፥ ሊባኖኦሴፓ ታ ኮይላ ሙኬ።","poem":2},{"text":"ዓማኣና ዹኮ ቶኦካፓ ኬዴ፤","poem":1},{"lineBreak":true},{"text":"ዞቢና ማኣኪናኮ ናንጎ ቤዞ ማዔ","poem":1},{"text":"ሴኒሬና ሄርሞኔ ዹኮናፓ ኬዲ ሃኒ ዬዔ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ታኣኮ ናሽኪንታያ ሜዔ ዑኡቴሌ","poem":1},{"text":"ፔቴና ኔኤኒ ታና ዛጌ ዛጎና","poem":2},{"lineBreak":true},{"text":"ኔኤኮ ቆርጮይዳ ዓኣ ሚዛጶ ፓልማሢና","poem":2},{"lineBreak":true},{"text":"ዒኖ ታኣኮ ኔኤኒ ዲዔኔ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታኣኮ ናሽኪንታ ዑኡቴሌ!","poem":1},{"text":"ናሹማ ኔኤሲ ዎዚ ታና ዎዛሳይ!","poem":2},{"text":"ናሹማ ኔኤሲ ዎይኖ ዑዣፓ ባሼ ታኣም ኮሽካኔ፤","poem":1},{"text":"ሳውቃ ቲዦኮ ሳውማ ሳዎ ቲዦ ቢያፓ ባሼኬ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታኣኮ ዑኡቴሌ! ኔኤኮ ሙሱራፓ ዔኤሲ ፆሎሊ ፆዻኔ፤","poem":1},{"text":"ዻንጋፓ ኔኤኮ ዔኤሲና ዲኢቂና ዓልቃኔ፤","poem":2},{"lineBreak":true},{"text":"ዓፒሎኮ ኔኤኮ ሳውማ ሊባኖኦሴይዳ ዓኣ ሳውቃ ዼኤሾጉዲኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ኔኤኒ ታኣኮ ናሽኪንታ ዑኡቴሌ!","poem":1},{"text":"ኔኤኒ ዲርቆና ዱማ ዱማ ባኣዚ ቱኮ ጎሺ","poem":2},{"lineBreak":true},{"text":"ጊንሣ ሃሣ ኮይላ ዲርቂንቴ ዓልቃ ዋኣሢኬ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኔኤኮ ሃንቶ ጎይፃ ዓኣሢ ዓኣፒ ኩሜ","poem":1},{"text":"ሮኦማኖ ሚፃ ዓኣ ጎሺጉዲኬ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ናርዶኦሴ፥ ሃምባልታ፥ ዳጅሳኣሬንታ ቄሬፓንታ","poem":1},{"text":"ዬያጉዲ ሳውማ ዑንጄጉዲ ማዔ","poem":2},{"lineBreak":true},{"text":"ዱማ ዱማ ቱኮና ባኣዚ ዒዞይዳ ዓኣኔ፤","poem":2},{"text":"ኬርቤንታ ዋላንጎ ቡኒንታ","poem":1},{"text":"ዱማ ዱማ ሳዊ ዼኤሻ ዒኢካ ባቃላኔ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ኔኤኒ ቱኪንቴ ዱማ ዱማ ባኮ ዑሻ ዓልቃ ዋኣሢጉዲኬ፤","poem":1},{"text":"ዓልቃ ዋኣሢ ዓኣ ዋኣሢ ዔቴጉዲኬ፤","poem":2},{"lineBreak":true},{"text":"ዬያ ሌሊቱዋንቴ ሊባኖኦሴ ዹኮ ዴማፓ ዓልቃ ዎርዚጉዲኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ኬዶ ባንፆ ዢባራሢዮ! ጴጪ ዔቄ!","poem":1},{"text":"ኔኤኒ ሃሣ ዾኦሎ ባንፆ ዢባራሢዮ! ሃኒ ሙኬ!","poem":2},{"lineBreak":true},{"text":"ታኣኮ ዱማ ዱማ ባኮ ቱኮና ቤዞይዳ ዢባርሼ፤","poem":2},{"lineBreak":true},{"text":"ዬይ ዢባራ ኮሺ ሳውሞ ዓኣያ ማዖንጎ፤","poem":2},{"text":"ታ ዒሼ፥ ዱማ ዱማ ባኮ ቱኮና ቤዞ ሙኮንጎ፤","poem":1},{"text":"ኮሺ ዓኣፃያ ማዔ ሚፆ ዓኣፖዋ ሙዖንጎ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}