{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"SNG","translationId":"mdy_twf","name":"ቢያፓ ባሼ ዓይኑሞ","commonName":"ቢያፓ ባሼ ዓይኑሞ","title":"ቢያፓ ባሼ ማዔ ዓይኑሞ","order":22,"numberOfChapters":8,"sha256":"2df956ff2845a42570eab898a1fb8f6d7254908e9b99a513984b49fbe808d265","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/mdy_twf/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"ታኣኮ ናሽኪንታ ዑኡቴሌ!","poem":1},{"text":"ሃይሾ ታኣኒ ታኣኮ ዱማ ዱማ ባኮ ቱኮና ጎዦ ጋሮ ጌሌኔ፤","poem":2},{"text":"ኬርቤንታ ዱማ ዱማ ሳውቃ ቡኖ ታኣኒ ማንፄኔ፤","poem":1},{"text":"ዔኤዞ ፆሎሎ ሾፖና ዎላ ታኣኒ ሙዔኔ፤","poem":2},{"lineBreak":true},{"text":"ዎይኖ ዑዦንታ ዲኢቆንታ ታኣኒ ዑሽኬኔ።","poem":2},{"lineBreak":true},"ዑኡቴሎ ላጎንሢ ዓይኑሞ",{"text":"ኑ ላጎንሢዮቴ!","poem":1},{"text":"ናሹሞ ዒንሢ ዒና ዓኣሣንዳያ ሄላንዳኣና","poem":2},{"lineBreak":true},{"text":"ሙይ፥ ዑሽኩዋቴ።","poem":2}]},{"type":"line_break"},{"type":"heading","content":["ዖይዳሳ ዓይኑሞ"]},{"type":"verse","number":2,"content":[{"text":"ታኣኒ ጊንዓዛ፥ ዒና ታኣኮ ጋዓንቴ ጴቺኬ፤","poem":1},{"text":"ታ ዒሼ ሂዚ ጌይ ዔኤሊንታንቴ ታ ዋይዜኔ፤","poem":2},{"lineBreak":true},{"text":"«ታኣኮ ናሽኪንታ ዑኡቴሌ!","poem":2},{"lineBreak":true},{"text":"ሃይማ ፓጬኔ ጌይሳ ባኣዚ ባኣ ዶኦሌሌ!","poem":2},{"lineBreak":true},{"text":"ሃዳራ ካሮ ታኣም ቡሌ፤","poem":2},{"lineBreak":true},{"text":"ቶኦካ ታኣኮ ዖልካዼኔ፤","poem":2},{"lineBreak":true},{"text":"ጋማኣ ታኣኮ ዋንታኣ ቃኣያሢና ዎዔኔ።»","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ማኣዓሢ ታኣኮ ታኣኒ ኬሴኔ፤","poem":1},{"text":"ማይ ጊንሣ ታኣኒ ማኣዖንዶ?","poem":2},{"text":"ቶኮዋ ታኣኮ ታኣኒ ማስቴኔ፤","poem":1},{"text":"ዓካሪ፥ ጊንሣ ዎዲ ፑርቲሶንዶይ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ታ ዒሼ ፂኢኖና","poem":1},{"text":"ኩጮ ፔኤሲ ዳኬኔ፤","poem":2},{"lineBreak":true},{"text":"ዒና ታኣኮ ዒዛ ጋይቴ ዱጴኔ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ዬያሮ ታ ዒሾም ካሮ ቡላኒ ታኣኒ ዔቄኔ፤","poem":1},{"text":"ካሮ ጎቺ ቡሎ ባኮ ታኣኒ ዓርቃዛ","poem":2},{"lineBreak":true},{"text":"ኩጫ ታኣኮ ኬርቤ ፆዺሴኔ፤","poem":2},{"lineBreak":true},{"text":"ኬኤላኣ ታኣኮ ዬያ ሌሊ ማዔኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ታ ዒሾም ካሮ ታኣኒ ቡሌኔ፤","poem":1},{"text":"ጋዓንቴ ታ ዒሼ ባኣሴ፥ ዴንዴኔ፤","poem":2},{"text":"ዬያሮ ዒና ታኣኮ ኮሺ ዱጴኔ፤","poem":1},{"text":"ሚርጌና ታ ኮዔኔ፥ ጋዓንቴ ዒዛ ዴንቃኒ ዳንዳዒባኣሴ፤","poem":2},{"lineBreak":true},{"text":"ታ ዒዛ ዔኤሌኔ፥ ጋዓንቴ ዒ ታኣም ዬሂባኣሴ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ካታሞ ሳዞ ሃንቲ ሃንቲ ካፓ ዓሳ ዒማና ታና ዴንቄኔ፤","poem":1},{"text":"ዔያታ ታና ጳርቂ ማኣሳንሤኔ፤","poem":2},{"text":"ኬኤሎ ዲፆ ዑፃ ዴዒ ካታሞ ካፓ ዓሳ","poem":1},{"text":"ዖዶዞ ማኣዓሢ ታኣኮ ጉሲ ዔኬኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ዒንሢ ዬሩሳላሜ ዉዱራሢ","poem":1},{"text":"ታ ዒሾ ዒንሢ ዴንቄያ ማዔቴ","poem":2},{"text":"ታኣኒ ዒዛ ማሊፃፓ ዔቄያና ሃርጊንቴያታሢ","poem":1},{"text":"ዒንሢ ዒዛም ኬኤዛንዳጉዲ ታ ሺኢቃኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ኔኤኒ ላኣሎ ቢያይዳፓ ሚዛጴሌ!","poem":1},{"text":"ጎኔና ዒሼ ኔኤኮ ሃንጎ ዓሶይዳፓ ዱማዻ?","poem":2},{"text":"ኔ ዒዛ ዛሎ ሃያይዲ ሃዳርሳሢ?","poem":1},{"text":"ዒዚ ሜሌ ዓሶይዳፓ ዱማዻሢ ዓይጎናዳይ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ዒሼ ታኣኮ ኮሺ ሚዛጳያ ሃሣ ሃርጌ ባኣያኬ፤","poem":1},{"text":"ታጶ ሺያ ዓቲንቄ ባኣካፓ","poem":2},{"lineBreak":true},{"text":"ዒዛ ሄላያ ባኣሴ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ቶኦካ ዒዛኮ ጌኤሺ ዎርቄ ማላኔ፤","poem":1},{"text":"ጋሞ ዒዛኮ ጋምፒ ማዦናያ ቁራኬጉዲ ካርታያኬ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ዓኣፓ ዒዛኮ ዎርዚ ዓቺዳ ዓኣ","poem":1},{"text":"ዑፆ ፔኤኮ ዲኢቂና ማስቴ ዶኦሌ ማላኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ጋንጋሮ ሚዛጱማ ዒዛኮ ዱማ ዱማ ሳውቃ ዼኤሻ","poem":1},{"text":"ባቃሊ ዓኣ ጎሺጉዲኬ።","poem":2},{"text":"ሙሱራ ዒዛኮ ቃራ ሳውሞ ዓኣ ኬርቤ ጌይንታ ዼኤሾ","poem":1},{"text":"ፆዺሳ ሚዛጶ ቡኖጉዲኬ።","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ቃሳ ዒዛኮ ሚዛጶ ሹዎና ሚዛጲሶና ዎርቄ ኮኦሎጉዲኬ፤","poem":1},{"text":"ዑፃ ዒዛኮ ሴንፔሬ ጌይንታ ሚዛጶ ሹዎና ሚዛጲሶና ዳርሲ ዓቺጉዲኬ።","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ቶካ ዒዛኮ ዎርቄይዳ ዾቂንቴ","poem":1},{"text":"ዒብኔቤሬዴ ጌይንታ ሹዎ ቱርቱሮ ማላኔ፤","poem":2},{"text":"ማላሢ ዒዛኮ ሊባኖኦሴ ሚፆና ሚዛጲሶና","poem":1},{"text":"ሊባኖኦሴ ዹኮጉዲኬ።","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ዻንጋ ዒዛኮ ዔኤሲጉዲ ዓኣፃያኬ፤","poem":1},{"text":"ጉቤና ዒዚ ኮሺ ሚዛጳኔ፤","poem":2},{"text":"ዒንሢ፥ ዬሩሳላሜ ዉዱራሢዮቴ","poem":1},{"text":"ታኣኮ ዒሼ ያዺኬ፤ ታ ላጋሢያ ዒዛኬ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}