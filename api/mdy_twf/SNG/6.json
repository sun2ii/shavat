{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"SNG","translationId":"mdy_twf","name":"ቢያፓ ባሼ ዓይኑሞ","commonName":"ቢያፓ ባሼ ዓይኑሞ","title":"ቢያፓ ባሼ ማዔ ዓይኑሞ","order":22,"numberOfChapters":8,"sha256":"2df956ff2845a42570eab898a1fb8f6d7254908e9b99a513984b49fbe808d265","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/mdy_twf/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"ኔኤኒ ላኣሎ ቢያይዳፓ ሚዛጴሌ!","poem":1},{"text":"ኔ ዒሼ ዎዚም ዓኣዼይ?","poem":2},{"text":"ኑ ዎላ ዒዛ ኮዓንዳጉዲ","poem":1},{"text":"ዒ ዴንዴ ባንፆ ኔ ኑም ኬኤዜ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ታኣኮ ዒሼ ማራቶ ሄንቃኒና","poem":1},{"text":"ሚዛጶ ቡኖ ዔካኒ","poem":2},{"lineBreak":true},{"text":"ዱማ ዱማ ሳውቃ ዼኤሻ ቱኪንቴ ቤዞ ዓኣዼኔ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ታ ዒሼ ታኣሮኬ፥ ታኣኒያ ዒዛሮኬ፤","poem":1},{"text":"ዒዚ ሚዛጶ ቡኖ ባኣካ ቆልሞ ሄንቃኔ።","poem":2}]},{"type":"heading","content":["ዶንጋሳ ዓይኑሞ"]},{"type":"verse","number":4,"content":[{"text":"ታ ሚሼሌ! ኔኤኒ ቲርፃ ካታሞጉዲ ሚዛጳኔ፤","poem":1},{"text":"ዬሩሳላሜ ካታማ ኮሽካሢጉዲ ኔኤኒ ኮሽካኔ፤","poem":2},{"text":"ዖሎ ባንዲሮ ዓርቂ ኬስኬ ዓሶጉዲ","poem":1},{"text":"ዓውካራ ኔኤሲ ዓሲ ዲቃሣያኬ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ታ ሚሼሌ፥ ሃዳራ ዓኣፖ ኔኤኮ ታጊዳፓ ሺርሼ፤","poem":1},{"text":"ዬይ ዓኣፓ ኔኤኮ ታና ዲዒ ዔኪ ቱኡሲ ዓሲ ማሄኔ።","poem":2},{"text":"ቶኦኮ ጋማ ኔኤኮ ጌሌዓዴ ዹካፓ","poem":1},{"text":"ጎዒ ኬዳ ዋኣሪጉዲኬ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዓጫ ኔኤኮ ዔያቶ ባኣካ ፔቴታዖ ሴኤካባኣ","poem":1},{"text":"ሜንቴ ሜንቴ ሾዓያና ዋኣሢና ማስቴ","poem":2},{"lineBreak":true},{"text":"ቦኦሬ ማራይጉዲ ዎዛሳያኬ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ኔኤኮ ላምዖ ዛሎ ጋንጋራ","poem":1},{"text":"ዓኣፖ ካሮ ካንቆና ባኮ ባኣኪና ጴዻኣና","poem":2},{"lineBreak":true},{"text":"ላምዖ ፓቂንቴ ሮኦማኔ ዓኣፒ ማላኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ላሂታሚ ጌኤሾንሢንታ ሳሊታሚ ሌጎንሢንታ","poem":1},{"text":"ፓይዳ ዔርቱዋያ ማዔ ሚዛጲ ዉዱሮ ናይ ዓኣያ ማዓኒ ዳንዳዓኔ፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ጋዓንቴ ታኣኒ ናሽካዛ ፔቴዞ ሌሊኬ፤","poem":1},{"text":"ዒዛ ሃይማ ፓጬኔ ጌይንታ ባኣዚባኣ","poem":2},{"lineBreak":true},{"text":"ዶኦሌጉዲ ሚዛጳያኬ፤","poem":2},{"text":"ዒዛ ፔ ዒንዶኮ ፔቴኬ፤","poem":1},{"text":"ዒዞ ሾኤ ዒንዳ ቢያፓ ዑሣ ዓኣሢ ዒዞ ናሽካኔ፤","poem":2},{"text":"ዉዱሮ ናኣታ ዒዞ ዛጊ ዛጊ «ኔ ዓንጂንቴያኬ» ጋዓኔ፤","poem":1},{"text":"ጌኤሾንሢንታ ሜሌ ሌጎንሢ ማዔ ካኣቲ ላኣላ ዒዞ ሄርሻኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ሃና ፖዒጉዲ ፖዒ ጴዻዛ","poem":1},{"text":"ዓጊኒ ዖይዺ ፖዓያጉዲ ፖዓዛ","poem":2},{"lineBreak":true},{"text":"ዓቢጉዲ ፖዒ ጴዻዛ","poem":2},{"lineBreak":true},{"text":"ዖሎ ባንዲሮ ዓርቂ ኬስኬ ዖሎ ዓሶጉዲ","poem":2},{"lineBreak":true},{"text":"ዓውካራ ዒጊቻያ ማዔዛ","poem":2},{"lineBreak":true},{"text":"ሃና ዖናዳይ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ዶኦጮይዳ ባቃሊ ዋርቂ ዓኣ ባኮ ታኣኒ ዛጋኒ","poem":1},{"text":"ዎይና ቱሼቴ፥ ሮኦማናኣ ቡኔቴ ዛጋኒ","poem":2},{"lineBreak":true},{"text":"ሌውዞ ጎዦ ታኣኒ ኬዴኔ፤","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታ ዬያ ዔሪባኣንቴ፥ ታኣኮ ዓፃዺፃ ታና","poem":1},{"text":"ሳርጌሎ ዖይቶይዳ ካኣቲ ናይጉዲ ዔኪ ዴይሤኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ኔኤኒ ሱላሜ ዓሲ ማዔዜሌ! ዔዞ ሃኒ ማዔቴራ፤","poem":1},{"text":"ኔና ኑ ኮሺ ዛጎም ሃዳራ ማዔቴራ።","poem":2},{"lineBreak":true},"ዑኡቴሎ ዓይኑሞ",{"text":"ማሃናይሜ ኮፆ ዛጋ ዓሲ ማሂ","poem":1},{"text":"ሱላሜ ዓሴሎ ዒንሢ ዓይጋ ዛጋይ?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}