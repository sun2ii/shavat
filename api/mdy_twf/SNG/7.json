{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"SNG","translationId":"mdy_twf","name":"ቢያፓ ባሼ ዓይኑሞ","commonName":"ቢያፓ ባሼ ዓይኑሞ","title":"ቢያፓ ባሼ ማዔ ዓይኑሞ","order":22,"numberOfChapters":8,"sha256":"2df956ff2845a42570eab898a1fb8f6d7254908e9b99a513984b49fbe808d265","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/mdy_twf/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"ካኣቲ ናዔሌ!","poem":1},{"text":"ዱርዞ ዓኣሢ ዓኣ ቶካ ኔኤኮ ዎዚ ሚዛጳይ!","poem":2},{"lineBreak":true},{"text":"ጉባዛ ኔኤኮ ዓንጎ ሼኤሺ ኮሻ ዓሳ ሚዛጲሲ ኮሼ ፓልሞ ማላኔ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ጉልዓ ኔኤኮ ዎይኔ ዑሺ ዓርሦና ቢሪሌ ማላኔ፤","poem":1},{"text":"ኬርና ኔኤኮ ሚዛጲ ቡኒ ሺርሺ ቱኮና","poem":2},{"lineBreak":true},{"text":"ዛርጎ ናቲጉዲኬ።","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ላምዖ ዻንፃ ኔኤኮ ሜንቴ ሾይንቴ ሞይሌ ናይ ማላኔ።","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ባቃና ኔኤኮ ዳርሲ ዓቺና ሚዛጲሶና ዼጌ ቤዞጉዲኬ፤","poem":1},{"text":"ዓኣፓ ኔኤኮ ዼኤፖ ካታሞ ሃሴቦኦኔ ጌሎ ካራ ዓኣ","poem":2},{"lineBreak":true},{"text":"ቦቆሎ ዋኣፆ ማላኔ።","poem":2},{"text":"ሲኢዻ ኔኤኮ ዒኢካ ዴዒ ዴማስቆ ዛጋኒ","poem":1},{"text":"ኮሾና ሊባኖኦሴይዳ ዓኣ ዼጌ ቤዞጉዲኬ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ኔኤኮ ቶኦካ ቄርሜሎሴ ዹኮጉዲኬ፤","poem":1},{"text":"ኔኤኮ ማዢንቴ ቶኦኮ ጋማ ጉኡፂሲ ሱኮና ቃጪና ማላኔ።","poem":2},{"lineBreak":true},{"text":"ካኣቲ ኔኤኮ ዬያ ማዢንቴ ቶኦኮ ሚዛጱሞና ዲዒንቴኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ታ ሚሼሌ! ዎዚ ኔኤኒ ሚዛጳይ?","poem":1},{"text":"ዎዚ ኔኤኒ ኮሽካይ?","poem":2},{"lineBreak":true},{"text":"ኔ ናሽካ ናሹማ ዎዚ ዎዛሳይ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ዔጳ ኔኤኮ ሜኤፄጉዲኬ፤","poem":1},{"text":"ዻንፃ ኔኤኮ ሜኤፆ ዓሞ ማላኔ።","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ሜኤፆ ሚፆ ታኣኒ ጊዒ","poem":1},{"text":"ዓኣፖ ማንፂፆ ናሽካኔ፤","poem":2},{"text":"ዻንፃ ኔኤኮ ዎይኖ ዓሞጉዲኬ፤","poem":1},{"text":"ካሳ ኔኤኮ ጋሲ ካሢ ሳውቃያጉዲኬ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዻንጋ ኔኤኮ ቃራ ዎይኔ ዑሺጉዲኬ።","poem":1},{"lineBreak":true},"ዑኡቴሎ ዓይኑሞ",{"text":"ያዺ ማዔቴ ኮዦ ዎይኖ ዑዣ","poem":1},{"lineBreak":true},{"text":"ታ ዒሾኮ ሙሱሮና ዓጮ ባኣኪና","poem":1},{"text":"ሻኣዺ ኬዳያ ማዖንጎ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ታኣኒ ታ ዒሻሢሮኬ፤","poem":1},{"text":"ዒዚያ ዓፃዺ ማላሢ ታናኬ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ታ ዒሼ! ሃኒ ዬዔ፤","poem":1},{"text":"ካታማፓ ዙሎ ኬስኪ ኑ ዎላ ዓኣዾም፤","poem":2},{"lineBreak":true},{"text":"ዒባኖ ዒኢካ ኑ ዴንዲ ዎርቆም።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ሚኢሪ ዔቂ ዎይኖ ጎዦ ኑ ዓኣዾም፤","poem":1},{"text":"ዎይኖ ቡና ዹኡቄያ ማዔቴ","poem":2},{"lineBreak":true},{"text":"ሮኦማናኣ ቡኔቴ ኑ ዛጎም፤","poem":2},{"lineBreak":true},{"text":"ዒኢካ ታና ታኣኒ ኔኤም ጉቤና ዓኣሢ ዒንጋንዳኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ማንዳሪክሴ","poem":1},{"noteId":2},{"text":"ጌይንታ ሚፆ ቡኖ ሳውሞንታ","poem":1},{"text":"ሃሢ ዱኡዞናሢ ማዔቴያ ካፄ ሚፆ ዓኣፓኣ","poem":2},{"lineBreak":true},{"text":"ኑ ካራ ኩሚ ዓኣኔ፤","poem":2},{"text":"ታ ዒሼ! ዬያይዳፓ ታ ኔኤም ጌሤኔ።","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"7፡13 ማንዳሪክሴ ጋዓዞ፦ ማዢ. ማፃ 30፡14ይዳ ዛጌ።","reference":{"chapter":7,"verse":13}}]},"thisChapterLink":"/api/mdy_twf/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}