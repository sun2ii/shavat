{"translation":{"id":"mdy_twf","name":"ጌኤዦ ማፃኣፖ","website":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mdyeth","licenseNotes":null,"shortName":"TWF","englishName":"Maale Bible (Ethiopic script)","language":"mdy","textDirection":"ltr","sha256":"5f00941a6a27461893338730f5d3147117737059c59de63eb719852559b93428","availableFormats":["json"],"listOfBooksApiLink":"/api/mdy_twf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30506,"languageName":"Male (Ethiopia)","languageEnglishName":"Male (Ethiopia)"},"book":{"id":"SNG","translationId":"mdy_twf","name":"ቢያፓ ባሼ ዓይኑሞ","commonName":"ቢያፓ ባሼ ዓይኑሞ","title":"ቢያፓ ባሼ ማዔ ዓይኑሞ","order":22,"numberOfChapters":8,"sha256":"2df956ff2845a42570eab898a1fb8f6d7254908e9b99a513984b49fbe808d265","firstChapterNumber":1,"firstChapterApiLink":"/api/mdy_twf/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/mdy_twf/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"ኔኤኒ ታ ዒንዶ ዻንፆ ዻንቄ","poem":1},{"text":"ታ ጌርሲጉዲ ማዔቴ ዓይጎ፤","poem":2},{"text":"ጎይፃ ታ ኔኤና ካኣሚ ሄርቄቴ","poem":1},{"text":"ዓይጎ ዓሲያኣ ታና ቶኦቺንዱዋንቴኬ።","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ታ ዒንዶ ማኣሪ ታ ኔና ዔኪ ጌልዜም","poem":1},{"text":"ዒኢካ ናሹሞ ዛላ ኔ ታና ዔርዛንዳያታንቴኬ፤","poem":2},{"text":"ታኣኒ ሮኦማኖ ዓኣፖ ጩኡጴ","poem":1},{"text":"ዓኣፆ ዎይኖ ዑዦ ኔና ዑሼያናንዳንቴኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ዒዚ ሻውሎ ኩጮ ኬሬ ማሂ ታኣም ጌሣኔ፤","poem":1},{"text":"ሚዛቆ ኩጮና ታና ዒ ኮንቃኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ዒንሢ ዬሩሳላሜ ዉዱራሢ!","poem":1},{"text":"ታ ዒሻሢ ፔኤሮ ዔቂ ኮዓንዳያ ሄላንዳኣና","poem":2},{"lineBreak":true},{"text":"ዒንሢ ዒዛ ካኣሚ ጴቹዋጉዲ ሃዳራ ታ ዒንሢ ጋዓኔ።","poem":2}]},{"type":"heading","content":["ላሃሳ ዓይኑሞ"]},{"type":"verse","number":5,"content":[{"text":"ፔ ላጋሢኮ ጌኤታ ጌኤቂንቲ","poem":1},{"text":"ዓሳ ናንጉዋ ዳውላፓ ሙካዛ ሃና ዖናዳይ?","poem":2},{"lineBreak":true},"ዑኡቴሎ ዓይኑሞ",{"text":"ሚና ኔ ዒንዳ ኔና ባኒ ሾዔ ቤዞ","poem":1},{"text":"ጋዞ ዴማፓ ታ ኔና ጴቼኔ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ጋፑዋ ናሹሞና ኔ ዒኖ ጋራ ታና ኮንኮጉዲ ጫርጊ ሃሼ፤","poem":1},{"text":"ኔኤኮ ኩጮይዳኣ ዒማይዲ ታና ሌሊ ዓርቄ።","poem":2},{"text":"ናሹሞ ሃይቢጉዲ ዎልቄና ዓኣያኬ፤","poem":1},{"text":"ዒናፓ ናሽኮ ናሹሞዋ ዱኡፒጉዲ ፑርታኬ፤","poem":2},{"lineBreak":true},{"text":"ናሹሞ ሼኤላሢ ፆኦሲ ታሞ ሼኤሎጉዲኬ።","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ሚርጌ ዋኣሢ ናሹሞ ታሚ ዎዻኒ ዳንዳዑዋሴ፤","poem":1},{"text":"ዬይ ዺቦ ዋኣፃ ዔኤዻኒያ ዳንዳዑዋሴ፤","poem":2},{"text":"ዓሲ ፔኤኮ ዓኣ ቆሎና ቢያ ናሹሞ ሻንቃኒ ማሌቴ","poem":1},{"text":"ናሹሞ ሚኢሼና ሻንቂንቱዋኣሢሮ ዬይ ሚሚኢቻ ባኣዚ ማዓኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ሃጊ ኮንቾ ዴይሢባኣ ዻካ ጌኤዳ ኑኡኮ ዓኣኔ፤","poem":1},{"text":"ዓሲ ዒዞ ጎቻኒ ኑና ዖኦጬቴ","poem":2},{"lineBreak":true},{"text":"ኑ ዓይጎ ባኣዚ ማዻኒ ዳንዳዓይ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ዎንዴ ዒዛ ኬኤሌ ዲሢ ማዔያታቴ","poem":1},{"text":"ዒዞ ዑፃ ቢራ ዓንጊ ሴኤላ ኑ ኮሼያናንዳኔ፤","poem":2},{"text":"ዒዛ ካታሞ ጌሎ ካሮ ማዔያታቴ","poem":1},{"text":"ሊባኖኦሴ ሚፆ ዓርሶና ላሾ ጋጋርዞና ኑ ዎዼያናንዳኔ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ዓካሪ ታኣኒ ኬኤሌ ዲሢኬ፤","poem":1},{"text":"ዻንፃ ታኣኮ ሹዎና ኮሺንቴ ካፒፆ ካፖ ዼጌ ቤዞኬ፤","poem":2},{"lineBreak":true},{"text":"ታኣኒ ዒዛና ዎላ ማዓኣና ታ ዒሾ ሃውሺሳያኬ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ሴሎሞኔኮ ባዓልሃሞኔይዳ ዎይኔ ጎሺ ዓኣኔ፤","poem":1},{"text":"ዬያ ዎይኖ ጎዦ ጎሽኪ ዎርቃ ዓሶም","poem":2},{"lineBreak":true},{"text":"ሚኢሼ ጪጊ ጪጊ ጎሽካንዳጉዲ ዒዚ ዒንጌኔ፤","poem":2},{"text":"ዬይ ፔቴ ፔቴ ዓሳ ፔቴ ሺያ ማዓ ሹቺ ቢራ ዒዛም ጪጋኔ።","poem":1}]},{"type":"verse","number":12,"content":[{"text":"ታኣኮ ዎይኖ ጎዣ ታኣሮኬ፤","poem":1},{"text":"ዔዞ ሴሎሞኔ! ኔኤኒ ፔቴ ሺያ ሹቺ ቢራ","poem":2},{"lineBreak":true},{"text":"ጎዦ ጎሽካ ዓሳኣ ላምዖ ፄኤታ ሹቺ ቢራ ዔካኒ ዳንዳዓኔ።","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ኔኤኒ ታ ዑኡቴሌ! ዱማ ዱማ ባኮ ቱኮና ቤዞ ኬስኬቴ","poem":1},{"text":"ታ ላጋ ኔኤኮ ዑኡዞ ዋይዛኒ ኮዓኔ፤","poem":2},{"lineBreak":true},{"text":"ታኣም ሂንዳ ኔኤኮ ዑኡዞ ዋይዚሴ።","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ታ ዒሼ! ዑኬና ታ ባንሢ ሙኬ፤","poem":1},{"text":"ሳውቃ ዼኤሻ ባቃላ ዹኮ ዑፃ","poem":2},{"lineBreak":true},{"text":"ፂካ ሮኦታሢንታ ሞይላሢ ናኣቶጉዲ ማዔ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mdy_twf/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mdy_twf/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mdy_twf/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}