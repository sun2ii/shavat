"type":"verse","number":5,"content":[{"text":"Iehova ihanamolaina anedia avabi,","poem":1},{"text":"badina be kara hereadia vada e kara,","poem":2},{"lineBreak":true},{"text":"tanobada idoinai unu bae diba toma.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Siona inoholaina taumui, a lolo, moale anedia avabi;","poem":1},{"text":"badina be Israel ena Helaḡa Diravana na bada,","poem":2},{"lineBreak":true},{"text":"umui bogaragimui ai.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}