{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"ISA","translationId":"meu_png","name":"ISAIA","commonName":"ISAIA","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"c40f9aa33906feefd5e311b6c31428cf15c2496f2b7bbf1502597f7c67b0f16b","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/meu_png/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":2,"content":[{"type":"heading","content":["Iehova ena Maino"]},{"type":"verse","number":1,"content":["Isaia, Amoso natuna, ese e itaia herevana, Iuda bona Ierusalem daidiai."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dina gabedia ai ina na baine vara:","poem":1},{"text":"Iehova ena dubu ororona na","poem":2},{"text":"atai-herea ororona ai baine hahelao,","poem":1},{"text":"bona baine heabi isi ororo maraḡidia daediai.","poem":2},{"text":"Bese iboudiai ese bae aru henia,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"taunimanima loḡora baema, baeto:","poem":2},{"text":"Aoma, Iehova ena ororo baita dara dae henia,","poem":1},{"text":"Iakob ena Dirava ena dubu ai;","poem":2},{"text":"ia ese ena kara baine hadibalaida,","poem":1},{"text":"ena dala ai baita raka helaoreana.","poem":2},{"text":"Badina be Siona lalona amo taravatu bainela,","poem":1},{"text":"Ierusalem amo Iehova ena hereva bainela.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ia ese bese idau-idau padadiai baine hahemaoro,","poem":1},{"text":"bona hahemaoro herevadia na taunimanima loḡora baine gwaurai henidia;","poem":2},{"text":"bena idia ese edia dare bae hododia, ruarua auridia ai bae halaodia,","poem":1},{"text":"bona edia io bae hododia, kwama-kwama kaiadia ae bae halaodia;","poem":2},{"text":"bese ta ese dare basine veri lasi, bese ta ihadikana totona,","poem":1},{"text":"bona tuari daladia basie hahedibalai lou.","poem":2}]},{"type":"heading","content":["Heaḡi taudia ihahemaoro-henidia"]},{"type":"verse","number":5,"content":["Iakob besena e, aoma,",{"text":"Iehova ena diari ai baita raka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Badina be oi ese emu orea taudia vada o dadaraidia,","poem":1},{"text":"Iakob besena vada o dadaraia;","poem":2},{"text":"badina be mari-abi taudia mairiveina kahana amo","poem":1},{"text":"bona rohe taudia Filistia taudia hetomadia ai e honumu,","poem":2},{"lineBreak":true},{"text":"bona idau bese taudia ida e utua hehenimu mai ima udeudedia ida.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Edia tano na silver bona gold ai e honumu,","poem":1},{"text":"bona edia dava-bada kohudia na asie oremu;","poem":2},{"text":"edia tano na hosi ai e honumu,","poem":1},{"text":"bona edia kariota na asie oremu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Edia tano na kaivakuku ai e honumu;","poem":1},{"text":"imadia amo vada e kara ḡaudia,","poem":2},{"text":"ima kwakikwakidia amo vada e kara ḡaudia,","poem":1},{"text":"e toma henidia dihomu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Taunimanima na unu amo e hamanaudiamu,","poem":1},{"text":"taunimanima na e hamaraḡidiamu;","poem":2},{"lineBreak":true},{"text":"edia dika basio gwau tao.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nadi-gini lalonai ba komu,","poem":1},{"text":"ḡahu ai ba hetahuni ahu,","poem":2},{"text":"Iehova igari-henina amo,","poem":1},{"text":"bona ena pavapava hairaina amo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vairadia ai e hekokorokumu taudia ita-itadia bae hamaragi,","poem":1},{"text":"taunimanima edia heaḡi bae hamanau;","poem":2},{"text":"Iehova sibona mo bae imodaia","poem":1},{"text":"una dina ai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Badina be Iehova Sabaota na mai ena dina ta,","poem":1},{"text":"heaḡi bona hekokoroku idoidiai","poem":2},{"text":"bona e heabi isimu, atai ai e heatomu, ḡaudia iboudiai ihadikadia dinana;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Lebanon sida-audia iboudiai,","poem":1},{"text":"ḡau-latalatadia bona kidotaodia,","poem":2},{"text":"bona Basan oak audia iboudiai","poem":1},{"text":"ihadikadia dinana;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ororo badadia iboudiai","poem":1},{"text":"bona ororo ḡau-latalatadia iboudiai","poem":2},{"lineBreak":true},{"text":"ihadikadia dinana;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"kohoro latadia iboudiai","poem":1},{"text":"bona maḡu aukadia iboudiai","poem":2},{"lineBreak":true},{"text":"ihadikadia dinana;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tarasisi lagatoidia iboudiai","poem":1},{"text":"bona lagatoi herea-daedia iboudiai","poem":2},{"lineBreak":true},{"text":"ihadikadia dinana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Taunimanima edia hekokoroku bae hamanau,","poem":1},{"text":"taunimanima edia heaḡi bae hamaraḡi,","poem":2},{"text":"bona Iehova sibona mo bae imodaia","poem":1},{"text":"una dina ai.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bona kaivakuku na bae hapuki,","poem":1},{"text":"bae hapuki vaitani.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bena taunimanima na nadi kohuadia lalodiai bae raka vareai,","poem":1},{"text":"bona tano guridia lalodiai danu,","poem":2},{"text":"Iehova igari-henina amo,","poem":1},{"text":"bona ena pavapava hairaina amo,","poem":2},{"text":"tanobada ihagarina totona","poem":1},{"text":"baine tore isi negana ai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Una dina ai taunimanima ese","poem":1},{"text":"edia silver kaivakukudia bona edia gold kaivakukudia,","poem":2},{"text":"bae toma henidia diho totona e karadia ḡaudia,","poem":1},{"text":"na migu bona sisiboi ediai bae negedia;","poem":2}]},{"type":"verse","number":21,"content":[{"text":"bena nadi kohuadia lalodiai bae raka vareai,","poem":1},{"text":"bona nadi-hagadia padadiai danu,","poem":2},{"text":"Iehova igari-henina amo,","poem":1},{"text":"bona ena pavapava hairaina amo,","poem":2},{"text":"tanobada ihagarina totona","poem":1},{"text":"baine tore isi negana ai.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Taunimanima, laḡa na udu-baubauna ai e miamu ḡauna,","poem":1},{"text":"ena amo ba raka oho,","poem":2},{"lineBreak":true},{"text":"badina be ia namona be dahaka?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}