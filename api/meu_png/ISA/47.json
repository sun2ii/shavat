{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"ISA","translationId":"meu_png","name":"ISAIA","commonName":"ISAIA","title":"ISAIA","order":23,"numberOfChapters":66,"sha256":"c40f9aa33906feefd5e311b6c31428cf15c2496f2b7bbf1502597f7c67b0f16b","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/meu_png/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":47,"content":[{"type":"heading","content":["Hahemaoro Babulono latanai"]},{"type":"verse","number":1,"content":[{"text":"Babulono hane-ulato rami-hebouna e,","poem":1},{"text":"aoma, gahu ai ba helai.","poem":2},{"text":"Kaldea natuna hahinena e,","poem":1},{"text":"tano ai ba helai, asi emu lohia helai ḡauna.","poem":2},{"text":"Badina be tau-anina manada-manada bona aniani inonoḡadia ianidia hahinena na","poem":1},{"text":"basie gwauraimu lou.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Huro nadidia avabi, uit ba idi patapata;","poem":1},{"text":"vairamu iḡovalaina dabuana ba kokia;","poem":2},{"text":"emu hahedoki ba doki oho, aemu bae ḡaḡae,","poem":1},{"text":"sinavai amo ba turu hanai.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asi ramimu bae itamu,","poem":1},{"text":"emu hemarai baine hedinarai.","poem":2},{"text":"Dava baina abia,","poem":1},{"text":"tau ta basina bogaia hisi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ihamaurida Diravana ladana na Iehova Sabaota;","poem":1},{"text":"ia na Israel ena Helaga Diravana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kaldea natuna hahinena e, asi reḡereḡemu a helai,","poem":1},{"text":"dibura lalonai baola;","poem":2},{"text":"badina be basileia ilohiadia hahinena na","poem":1},{"text":"basie gwauraimu lou.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Egu bese taudia na badu henidia,","poem":1},{"text":"ahugu na hamiroa;","poem":2},{"text":"oi imamu ai na atodia,","poem":1},{"text":"oi ese so bogadia hisi;","poem":2},{"text":"emu maduna o hametaua herea,","poem":1},{"text":"iahu latadiai.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Oi oto “Baina lohia hanaihanai”,","poem":1},{"text":"taunabunai ini gau so lalodia,","poem":2},{"lineBreak":true},{"text":"bona dokodia so lalo tao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Taunabunai, moale iura-henina hahinemu e,","poem":1},{"text":"ina hereva ba kamonaia.","poem":2},{"text":"O helai namonamomu,","poem":1},{"text":"lalomu ai o tomamu","poem":2},{"text":"“Lau binai, idauna ta na lasi;","poem":1},{"text":"lau na basina vabu, bona natugu ta basine mase”.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"A ini ḡau rua na emu ai bae kau,","poem":1},{"text":"nega tamona ai, dina tamona ai:","poem":2},{"text":"ena be emu mea karadia na momo,","poem":1},{"text":"bona emu babalau karadia na siahu-herea,","poem":2},{"text":"to natumu edia mase bona emu vabu ese","poem":1},{"text":"bae hametaumu herea.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Emu kara havara ai o noho namonamova oto;","poem":1},{"text":"oto “Ta ese se itagumu”;","poem":2},{"text":"emu aonega bona emu lalo-parara ese","poem":1},{"text":"e hakaumu kerere;","poem":2},{"text":"bona lalomu ai oto","poem":1},{"text":"“Lau binai, idauna ta na lasi”.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"A dika na oi latamu ai baine kau,","poem":1},{"text":"basio hamamaia ahu diba;","poem":2},{"text":"ala-ala na latamu ai baine diho,","poem":1},{"text":"basio hamamaia ahu diba;","poem":2},{"text":"hahebua-tari ese baine lasimu tao taku,","poem":1},{"text":"asi dibamu ḡauna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Emu babalau karadia ba kara balaheni,","poem":1},{"text":"bona emu mea karadia danu, kekenimu negana amo vada o goadalai ḡaudia,","poem":2},{"text":"bena readia anidia bae vara,","poem":1},{"text":"bena taunimanima na ba hagaridia.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Emu hahealo taudia na hutuma dainai lalomu na e hekwarahimu;","poem":1},{"text":"vada bae gini tore, bena bae hamaurimu.","poem":2},{"text":"Idia ese guba e hahetohoamu,","poem":1},{"text":"bona hisiu e orodiamu,","poem":2},{"text":"bona hua matamata negadia ai e gwaurai hatamu,","poem":1},{"text":"dahaka na emu ai baine vara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"A itaia, idia na rei kakoro na heto,","poem":1},{"text":"lahi ese e aradia oremu;","poem":2},{"text":"idia na lahi hururu-hururudia amo","poem":1},{"text":"sibodia irauadia asi dibadia.","poem":2},{"text":"Ina na dia gida, bena bae hegana;","poem":1},{"text":"eiava lahi, bena badibadinai bae helai.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Oi ida vada o hekwarahi hebou taudia,","poem":1},{"text":"kekenimu negana amo oi ida vada o gaukara hebou taudia,","poem":2},{"lineBreak":true},{"text":"oiemu ai na unu heheto.","poem":2},{"text":"Idia na e loa eva-evamu, ta ta ena dala ena dala ai,","poem":1},{"text":"a oi na asi ihamaurimu ta.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}