notes":[]},"thisChapterLink":"/api/meu_png/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}