{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"MIC","translationId":"meu_png","name":"MIKA","commonName":"MIKA","title":"MIKA","order":33,"numberOfChapters":7,"sha256":"76495e1706de327e2afa27bde19e8cddc6ea2a30f17d8131b73320c5d1828237","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/meu_png/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"heading","content":["Rohe-ahu Samaria bona Ierusalem latadiai"]},{"type":"verse","number":1,"content":["Iehova ena hereva, Mika, tau Moresete, enai e kau, Iuda pavapavadia Iotam bona Ahasa bona Hesekia edia nega ai, Samaria bona Ierusalem herevadia."]},{"type":"verse","number":2,"content":[{"text":"Taunimanima iboumui ai, a kamonai;","poem":1},{"text":"tanobada mai lalona ḡaudia iboudiai ida, a hakala;","poem":2},{"text":"Ḡaubada Iehova ese baine habadelaimw,","poem":1},{"text":"Ḡaubada ese ena dubu helaḡana amo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Badina be, a itaia, Iehova na ena gabu amo e raka lasimu,","poem":1},{"text":"ia na baine diho, tanobada ena atai gabudia baine moimoilaidia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ia henunai ororo bae veve,","poem":1},{"text":"bona koura bae parara,","poem":2},{"text":"wax lahi vairanai na heto,","poem":1},{"text":"ranu haga amo e hebubu dobimu na heto.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ina idoinai na Iakob ena kerere dainai,","poem":1},{"text":"Israel besena ena kara dika dainai.","poem":2},{"text":"Iakob ena kerere be dahaka?","poem":1},{"text":"Ena kerere na Samaria ani?","poem":2},{"text":"Bona Iuda besena ena kara dika be dahaka?","poem":1},{"text":"Ena kara dika na Ierusalem ani?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taunabunai, lau ese Samaria baina hasenua tano paka ai,","poem":1},{"text":"vine imeadia ihadodia gabuna ai baina halaoa;","poem":2},{"text":"ena nadi na koura ai baina bubudia dobi,","poem":1},{"text":"ena badi nadidia baina hulalai.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ena dirava laulaudia iboudiai bae huaridia patapata,","poem":1},{"text":"ena ariara karadia davadia iboudiai na lahi ese baine goledia oho;","poem":2},{"lineBreak":true},{"text":"ena kaivakuku iboudiai na lau ese baina habuadia tari;","poem":2},{"text":"badina be lebulebu hahinena ahuna amo e haboudia,","poem":1},{"text":"bena lebulebu hahinena ahuna ai ma baela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ina dainai baina rohe ahu, baina tai lolololo;","poem":1},{"text":"egu dabua baina doki oho, gagaegu ai bainala;","poem":2},{"text":"uda sisiadia na heheto baina tai lolololo,","poem":1},{"text":"kokokoko na heheto baina tai badabada.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Badina be ia berona na basie hanamoa diba;","poem":1},{"text":"Iuda ai vada e kau,","poem":2},{"text":"egu bese taudia edia ikoukou ai vada e kau,","poem":1},{"text":"Ierusalem ai vada e kau.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gata al basio herevalaia,","poem":1},{"text":"basio tai;","poem":2},{"text":"Bete-le-afra ai","poem":1},{"text":"ḡahu ai ba hekui-hekui.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Safiri taumui e,","poem":1},{"text":"emui dala ai ba raka lao,","poem":2},{"lineBreak":true},{"text":"ḡaḡaemui ai, mai hemaraimui ida.","poem":2},{"text":"Saanan taudia na","poem":1},{"text":"asie raka lasimu;","poem":2},{"text":"Bet-esele ena taitai ese","poem":1},{"text":"ena gini gabuna na emui amo baine abia oho.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Maroto taudia ese namo e nariamu,","poem":1},{"text":"mai kudou-hetahadia ida;","poem":2},{"text":"badina be dika na Iehova ena amo vada e diho,","poem":1},{"text":"Ierusalem ikoukouna enai.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lakisi taumui e,","poem":1},{"text":"hosi na kariota ai ba guidia;","poem":2},{"text":"umui na kara dika matamana","poem":1},{"text":"Siona natuna kekenina enai,","poem":2},{"text":"badina be umui lalomui ai","poem":1},{"text":"Israel ena kerere e davaridia.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Taunabunai hahetoni herahiadia na","poem":1},{"text":"Moresete-gata ba henia;","poem":2},{"text":"Aksib rumadia na koikoi ḡaudia ai baela","poem":1},{"text":"Israel pavapavadia ediai.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Maresa inoholaina taumui e,","poem":1},{"text":"kwalimu tauna na ihadareremui totona ma baina mailaia;","poem":2},{"text":"Israel hairaina na","poem":1},{"text":"Adulama enai baine kau.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kwaramui ba nau, huimui ba utu,","poem":1},{"text":"emui lalokau memerodia daidiai;","poem":2},{"text":"kwaramui ba nau, ugava kwaradia na heheto,","poem":1},{"text":"badina be natumui na emui amo bae raka oho,","poem":2},{"lineBreak":true},{"text":"gabu daudauna ai bae hanohodia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}