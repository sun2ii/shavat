{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Taunimanima binai vada e namo:","poem":1},{"text":"ia na kara dika taudia edia henega sela,","poem":2},{"text":"kara kerere-kerere taudia edia dala ai se gini,","poem":1},{"text":"hevaseha taudia edia helai gabudia ai se helai;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"A Iehova ena taravatu ia ese e moalelaiamu,","poem":1},{"text":"ena taravatu e laloa boimu, e laloa ranimu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ia na sinavai isena ai e hadoa auna na heto:","poem":1},{"text":"ena huahua negana ai ia anina do baine dobi,","poem":2},{"text":"ia rauna danu do basine marai,","poem":1},{"lineBreak":true},{"text":"ḡau idoidiai ia baine kara be anidia do bae vara ḡoevaḡoeva.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kara dika taudia na dia unuheto:","poem":1},{"text":"idia na uit momodia na heheto,","poem":2},{"lineBreak":true},{"text":"lai ese e oda ohomu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taunabunai kara dika taudia na","poem":1},{"text":"hahemaoro negana ai do basie gini,","poem":2},{"text":"kara kerere-kerere taudia danu","poem":1},{"text":"kara maoromaoro hebouna ai do basie gini.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Badina be Iehova na kara maoromaoro taudia","poem":1},{"text":"edia dala dibana;","poem":2},{"text":"A kara dika taudia,","poem":1},{"text":"edia dala do baine doko.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}