{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":100,"content":[{"type":"verse","number":1,"content":[{"text":"Tanobada idoinai, Iehova ba moale hisi dae henia.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Iehova isiaina ba lao heni mai moalemui ida,","poem":1},{"text":"ia vairanai baoma mai anemui ida.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Umui ba diba Iehova na Dirava.","poem":1},{"text":"Ia ese e karada, ita na iena;","poem":2},{"lineBreak":true},{"text":"ita na ia besena, bona ena heubu mamoedia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ena ikoukou ai ba raka vareai mai hahenamomui ida,","poem":1},{"text":"ena dubu ai danu mai anemui ida","poem":2},{"lineBreak":true},{"text":"ia ba hanamoa, ia ladana ba imodaia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Badina be Iehova na namo;","poem":1},{"text":"ena hebogahisi na e hesiriu hanaihanaimu,","poem":2},{"lineBreak":true},{"text":"bona ena heabidadama ela bona uru iboudiai.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}