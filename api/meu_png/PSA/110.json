{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":110,"content":[{"type":"verse","number":1,"content":[{"text":"Iehova ese egu lohia e hamaoroamu, e tomu","poem":1},{"text":"“Lau idibagu kahana ai ba helai,","poem":2},{"text":"ela bona oi inaimu na aemu ihadaidia ḡaudia ai baina halaodia”.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Iehova ese ena siahu dagina auna na Siona amo vada e siaia,","poem":1},{"text":"oi inaimu bogaragidiai ba lohia.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Emu tuari oreana na ororo helagadia ai ba hakaua lao dinana ai,","poem":1},{"text":"emu orea taudia ese kunudia bae rahu pou;","poem":2},{"text":"Daba matana ai, hunu na heto,","poem":1},{"text":"emu goada matamatana bainema.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iehova vada e gwau hamata,","poem":1},{"text":"bona lalona basine ha-idaua:","poem":2},{"text":"oi na hahelaḡa tauna hanaihanai,","poem":1},{"text":"Melkisedek ena orea tauna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ḡaubada na oi idibamu kahana ai;","poem":1},{"text":"ena badu dinana ai pavapava baine huaridia.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bese idau idau bogaragidiai hahemaoro baine karaia,","poem":1},{"text":"edia gabu na mase tau-anidia ai baine hahonudia;","poem":2},{"text":"ia ese ikwaradia taudia baine huaridia, tanobada heḡeḡemadai ai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dala ai ia na sinavai ranuna baine inua;","poem":1},{"text":"taunabunai ia na baine gaga dae.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}