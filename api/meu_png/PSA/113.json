{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Iehova ba imodaia.","poem":1},{"text":"Iehova ena hesiai taumui, ia ba imodaia,","poem":2},{"lineBreak":true},{"text":"Iehova ladana ba heatolaia.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iehova ladana na bae hanamoa,","poem":1},{"text":"ina harihari ela bona hanaihanai;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"dina dae ela bona dina diho,","poem":1},{"text":"Iehova ladana na bae heatolaia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iehova na atai ai, bese iboudiai daediai;","poem":1},{"text":"ia hairaina na guba daenai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Iehova, eda Dirava, idaina be daika?","poem":1},{"text":"Ia na atai ai e helaimu,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"e igo dobimu,","poem":1},{"text":"guba bona tanobada e nenediamu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ia ese ogoḡami taudia na ḡahu amo e abidia isimu,","poem":1},{"text":"e dabumu taudia na kahu gabuna amo e veridia isimu;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"pavapava ida e hahelaidia heboumu,","poem":1},{"text":"ena orea taudia edia pavapava ida.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ia ese gabani hahinena na ena noho gabuna e heniamu,","poem":1},{"text":"e hamoaleamu, memero kekeni sinadia ai e halaoamu.","poem":2},{"lineBreak":true},{"text":"Iehova ba imodaia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}