{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Israel na Aigupto amo e raka lasi,","poem":1},{"text":"Iakob besena na gado-idau taudia edia amo e raka oho,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"una negana ai Iuda na ena gabu helaḡana ai ela,","poem":1},{"text":"Israel na ena basileia ai ela.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Davara e itaia, bena e heau,","poem":1},{"text":"Ioridane sinavaina e lou ela;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ororo badadia e roho isi roho isi, mamoe mamaruanedia na heheto,","poem":1},{"text":"bona ororo maraḡidia mamoe-mamoe na heheto.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Davara e, oi be edeheto, be o heaumu?","poem":1},{"text":"Ioridane e, oi danu edeheto, be o Ioumu?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ororo badadia e, umui be edeheto, be o roho isi roho isimu, mamoe mamaruanedia na heheto?","poem":1},{"text":"Ororo maraḡidia e, umui danu edeheto, be mamoe-mamoe na o hetomu?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tanobada e, Ḡaubada vairanai a heude-heude,","poem":1},{"text":"Iakob ena Dirava vairanai.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ia ese haga-nadina na gohu ai e halaoa,","poem":1},{"lineBreak":true},{"text":"vasiga na ranu e lohilohimu gabuna ai e halaoa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}