{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":120,"content":[{"type":"verse","number":1,"content":[{"text":"Egu lalo-hisihisi ai Iehova na tai henia,","poem":1},{"text":"baine haere henigu totona.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nato: Iehova e,","poem":1},{"text":"koikoi bibinadia bona hedibagani maladia amo ba hamaurigu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hedibaḡani malana e, dahaka baine henimu?","poem":1},{"text":"ede ma baine kara henimu toma?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tuari tauna ena diba mai matadia,","poem":1},{"text":"roteme","poem":2},{"noteId":5},{"text":"audia e aramu gidadia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Madi ihabaigu, Mesek ai na noho hedoamu,","poem":1},{"text":"Kedara kalagadia bogaragidiai na nohomu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Egu noho vada eme daudau herea,","poem":1},{"text":"maino e inai heniamu taudia bogaragidiai.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lau na maino na uramu,","poem":1},{"text":"a na herevamu negadia ai,","poem":2},{"lineBreak":true},{"text":"idia na tuari e uramu.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"“Roteme” na au ta ladana Heberu gado ai.","reference":{"chapter":120,"verse":4}}]},"thisChapterLink":"/api/meu_png/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}