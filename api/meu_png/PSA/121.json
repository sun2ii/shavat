{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":121,"content":[{"type":"verse","number":1,"content":[{"text":"Lau matagu na gaga isimu, ororo na haḡerediamu;","poem":1},{"text":"ikahagu na ede amo e maimu?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ikahagu na Iehova ena amo e maimu;","poem":1},{"text":"ia ese guba bona tanobada e karadia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Oi aemu ia ese baine naria, basine marere;","poem":1},{"text":"oi igimamu Diravana na basine mahuta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Oibe, Israel igimana Diravana na","poem":1},{"text":"matana basine ḡaraia, basine mahuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Iehova na oi igimamu Diravana;","poem":1},{"text":"Iehova na oi ihahemetaimu, idibamu kahana ai.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dina siahuna basine hagoreremu dina ai,","poem":1},{"text":"eiava hua hanuaboi ai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Iehova ese dika iboudiai lalodia amo baine gimamu;","poem":1},{"text":"ia ese emu mauri baine gimaia.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Emu raka lasi ai bona emu raka vareai ai","poem":1},{"text":"Iehova ese baine gimamu,","poem":2},{"lineBreak":true},{"text":"harihari ela bona hanaihanai.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}