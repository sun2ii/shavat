{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":122,"content":[{"type":"verse","number":1,"content":[{"text":"“Iehova ena ruma aitala”;","poem":1},{"text":"unu e hamaorogu toma negana ai na moale.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ierusalem e, ai aemai vada e gini,","poem":1},{"text":"emu ikoukou lalodiai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ierusalem na vada e hadaia, hanua badana,","poem":1},{"text":"vada e hahekuboua tutuka-tutuka;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"iduhu hidaosi ese e dara heniamu,","poem":1},{"text":"Iehova ena bese iduhudia;","poem":2},{"text":"hahediba herevana na Israel e henia heḡereḡerena,","poem":1},{"text":"Iehova ladana bae hanamoa totona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hahemaoro teronodia unuseni ai e hadai,","poem":1},{"text":"David garana edia terono bunu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ierusalem ena maino dainai ba guriḡuri!","poem":1},{"text":"E ura henimumu taudia na bae namo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Maino na emu maḡu ialodiai baine mia,","poem":1},{"text":"bona mauri na emu kohoro lalodiai.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tadikakagu bona bamogu bagudiai bainato","poem":1},{"text":"“Maino na oi lalomu ai baine mia”.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Iehova, eda Dirava, ena ruma bagunai,","poem":1},{"text":"oi namomu baina tahua.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}