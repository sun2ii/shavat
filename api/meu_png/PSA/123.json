{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":123,"content":[{"type":"verse","number":1,"content":[{"text":"Matagu na roha isimu oiemu ai,","poem":1},{"text":"guba ai emu terono ai o helaimu Diravana e!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hesiai taudia matadia ese","poem":1},{"text":"biagudia imana e raraia taomu","poem":2},{"text":"eiava hesiai kekenina matana ese","poem":1},{"text":"biaguna hahinena imana e raraia taomu na heto,","poem":2},{"text":"ita matada ese Iehova, eda Dirava, unu ta raraia tao tomamu,","poem":1},{"text":"ela bona ia ese baine bogada hisi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"A bogamai hisi, Iehova e, a bogamai hisi,","poem":1},{"text":"badina be taunimanima ese vada e kirikirilaimai ai vada a hesiku.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nega daudau herea taḡa taudia edia heihi-ihirai bona heaḡi taudia edia hekinkirilai ese","poem":1},{"text":"lalomai vada e hahonu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}