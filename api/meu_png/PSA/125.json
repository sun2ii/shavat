{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":125,"content":[{"type":"verse","number":1,"content":[{"text":"Iehova e abidadama heniamu taudia na Siona ororona na heto;","poem":1},{"text":"basine marere diba, baine mia hanaihanai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ororo ese Ierusalem e ḡeḡea ahumu heḡereḡerena,","poem":1},{"text":"Iehova ese ena orea taudia unu e ḡeḡedia ahu tomamu,","poem":2},{"lineBreak":true},{"text":"hari ina negana amo ela bona hanaihanai.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Badina be kara dika ena dagi auna na","poem":1},{"text":"kara maoromaoro taudia e henidia tanona latanai basine mia","poem":2},{"text":"kara maoromaoro taudia na imadia bema toia roro","poem":1},{"text":"bona kara dika bema kara na garina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Iehova e, kara namo taudia na ba hanamodia,","poem":1},{"text":"bona lalodia mamaoro-mamaoro taudia danu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"A dala gageva-gagevadia ai e rakamu taudia na","poem":1},{"text":"Iehova ese kara dika taudia ida baine hakaudia lao.","poem":2},"Maino na Israel ai baine mia."]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}