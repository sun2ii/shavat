{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":126,"content":[{"type":"verse","number":1,"content":[{"text":"Iehova ese Siona e hanamoa lou negana ai,","poem":1},{"lineBreak":true},{"text":"ita na e nihimu taudia na heheto.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Una negana ita ududa na kiri ai e honu honu dae,","poem":2},{"text":"bona malada e moale hisi dae.","poem":1},{"text":"Bena bese idau-idau bogaragidiai ini e gwau toma:","poem":2},{"text":"Iehova ese kara badadia vada e kara idia edia.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Oibe, Iehova ese kara badadia vada e kara ita eda;","poem":2},{"text":"ita na ta moalemu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Iehova e, ma ba hanamomai lou,","poem":1},{"text":"diho kahana sinavaidia na heheto.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mai iruru-matadia ida e hadohadomu taudia na","poem":1},{"text":"mai moaledia ida bae ḡeiḡei;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"uhe ihadodia totona mai taitaina ida e raka lasimu tauna na","poem":1},{"text":"mai hisi-daena ida ena ruma baine lou henia,","poem":2},{"lineBreak":true},{"text":"ena uit iḡuidia baine lasilaidia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}