moalemu.","poem":2},{"text":"Hanua ikoukouna ai ia inaina ida bae hereva negana ai,","poem":1},{"text":"tau ta ese basine hahemaraia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}