{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":129,"content":[{"type":"verse","number":1,"content":[{"text":"Merogu negana amo vada e hahisigu bada,","poem":1},{"text":"(Harihari Israel ini baine gwau toma),","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Merogu negana amo vada e hahisigu bada,","poem":1},{"text":"to asie hadareregu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ruarua taudia ese dorugu e ruaia,","poem":1},{"text":"edia ruarua gabudia e halatadia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Iehova ena kara na maoromaoro;","poem":1},{"text":"ia ese kara dika varodia vada e utudia.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Siona e inai heniamu taudia iboudiai na","poem":1},{"text":"bae hahemaraidia bona bae haloudia.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Idia na ruma guhidia ai rei e varamu na heto:","poem":1},{"text":"do se huahua ai na e maraimu,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"bena iutuna tauna na imana ai se abiamu,","poem":1},{"text":"bona iḡuina tauna na kemena ai se rosiamu;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"e raka hanaimu taudia danu asie herevalaiamu, asie tomu","poem":1},{"text":"“Iehova ena hahenamo na latamu ai baine mia,","poem":2},{"lineBreak":true},{"text":"Iehova ladana ai a hanamomumu”.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}