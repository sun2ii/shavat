{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Iehova e, ela bona edena nega ai?","poem":1},{"text":"Ba lalogu boio ela bona hanaihanai a?","poem":2},{"text":"Vairamu na egu amo ba hamuea ela bona edena nega ai?","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Daragu baine doko ela bona edena nega ai?","poem":2},{"text":"Lalogu na dina idoinai baine hisihisi a?","poem":1},{"text":"Lau inaigu baine hereagu ela bona edena nega ai?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Iehova e, egu Dirava, ba haeroa bona ba haere henigu;","poem":1},{"text":"matagu ba hadiaridia, mase ena mahuta ai baina mahuta na garina,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"inaigu na baineto “Vada na hadarerea” na garina,","poem":1},{"text":"bona na manokamu dainai e inai henigumu taudia bae moale na garina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"A lau na emu hebogahisi vada na abidadama henia;","poem":1},{"text":"lau lalogu ese emu hahemauri baine moalelaia.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ane baina abia, Iehova ena;","poem":1},{"text":"badina be ia ese ena harihari-bada ai vada e hanamogu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}