{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":130,"content":[{"type":"verse","number":1,"content":[{"text":"Iehova e, dobu gabuna amo na tai henimumu.","poem":1},{"text":"Ḡaubada e, gadogu a kamonai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taiamu ae kirara,","poem":1},{"text":"egu noinoi a hakala henia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Iehova e, kara dika boma lalo tao,","poem":1},{"text":"Ḡaubada e, daika bema gini?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"A dika igwau-taodia na oiemu amo,","poem":1},{"text":"una dainai oi garimu bae gari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Iehova na nariamu, laumagu ese e nariamu,","poem":1},{"text":"iena hereva na laroamu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Laumagu ese Ḡaubada e nariamu,","poem":1},{"text":"hegima taudia ese daba e nariamu na e hereadiamu,","poem":2},{"lineBreak":true},{"text":"hegima taudia ese daba e nariamu na e hereadiamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Israel e, Iehova ba laroa.","poem":1},{"text":"Badina be Iehova na mai ena hebogahisi,","poem":2},{"lineBreak":true},{"text":"bona ena hahemauri na bada herea.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ia ese Israel na","poem":1},{"text":"ena kara dika iboudiai lalodia amo baine hamauria.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}