{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"Babulono sinavaidia badibadidiai,","poem":1},{"lineBreak":true},{"text":"a helai dihova, a taiva,","poem":1},{"text":"Siona a laloa taova negadia ai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Unuseni ai emai hatai-hatai ḡaudia na","poem":1},{"text":"sinavai isedia audia ai a taudia dae.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Badina be unuseni ai e ḡuimai taudia ese e haḡanimai, ane baia abi,","poem":1},{"text":"e hahisimai taudia ese e haḡanimai, baia moale;","poem":2},{"lineBreak":true},{"text":"“Siona anedia ta bavabia” eto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Idau tano ai Iehova ena ane na","poem":1},{"text":"ede baia abia toma?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ierusalem e, bama lalomu boio,","poem":1},{"text":"imagu bema heveri;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"basinama lalomu tao,","poem":1},{"text":"bona egu moale ḡauna hereana daenai Ierusalem basinama atoa,","poem":2},{"lineBreak":true},{"text":"malagu na udugu atai maona ai bema kape dae.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Iehova e, Ierusalem ena dina ba laloa tao,","poem":1},{"text":"Edom taudia latadiai.","poem":2},{"text":"Idia e tomava: A ḡiḡia dobi, a ḡiḡia dobi,","poem":1},{"text":"a ḡiḡia rohoroho.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Babulono natuna hahinena e, hahebua-tari hahinemu:","poem":1},{"text":"o kara henimaiva karadia davadia ma baine halou henimu tauna na baine moale;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"bona natumu maraḡidia baine abidia, haga-nadina ai","poem":1},{"text":"baine huaridia, tauna na baine moale.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}