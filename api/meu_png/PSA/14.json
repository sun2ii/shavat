{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Kavakava tauna ese lalona e hadaiamu, e tomu","poem":1},{"lineBreak":true},{"text":"“Dirava na lasi”.","poem":1},{"text":"Idia na didika, kara mirodia vada e kara;","poem":2},{"text":"asi tauna ta ese kara namodia e karamu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Iehova na guba amo e roha dobimu,","poem":1},{"text":"taunimanima natudia e nenediamu;","poem":2},{"text":"baine itadia, ta e kara aonegamu eiava,","poem":1},{"text":"ta ese Dirava e tahuamu eiava.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iboudiai vada e raka boioboio, iboudiai na didika;","poem":1},{"text":"ta se kara namomu, lasi ona lasi vaitani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hari kara dika taudia,","poem":1},{"text":"hari egu bese taudia e anidiamu flaoa e animu heḡereḡerena","poem":2},{"lineBreak":true},{"text":"bona Iehova ladana asie hahaneamu taudia na","poem":2},{"text":"asi aonegadia a?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gari bada ese baine butudia tao,","poem":1},{"text":"badina be Dirava na kara maoromaoro taudia edia uru ida e nohomu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ogoḡami tauna ena lalo-hadai vada o hahemaraidia,","poem":1},{"text":"a Iehova na iena maḡu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Israel ihamaurina na Siona amo bainema be namo!","poem":1},{"lineBreak":true},{"text":"Iehova ese ena bese taudia baine ruhadia nege negana ai na","poem":1},{"text":"Iakob baine moale,","poem":2},{"lineBreak":true},{"text":"Israel baine moale hisi dae.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}