{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":142,"content":[{"type":"verse","number":1,"content":[{"text":"Eregu amo Iehova na tai heniamu,","poem":1},{"text":"eregu amo Iehova na noinoi heniamu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Egu lalo-hisihisi na ia vairanai na herevalaiamu,","poem":1},{"text":"egu lalo-hekwarahi na ia vairanai na gwauraiamu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Laumagu e dauremu negana ai,","poem":1},{"text":"egu dala oi mai dibamu.","poem":2},{"lineBreak":true},{"text":"Na rakalaiamu dalana ai,","poem":1},{"text":"iabigu rikirikina vada e hunia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Idiba kahana na roha heniamu bona na henarimu,","poem":1},{"text":"a ta ese se lalogumu;","poem":2},{"text":"asi egu roho-mauri gabuna ta,","poem":1},{"text":"asi tauna ta ese e dosigumu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Iehova e, na tai henimumu,","poem":1},{"text":"na tomu “Egu roho-mauri gabuna na oi,","poem":2},{"lineBreak":true},{"text":"oi na lau ahugu, mauri taudia edia tano ai”.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Egu noinoi a kamonai,","poem":1},{"text":"badina be vada e taogu tao.","poem":2},{"lineBreak":true},{"text":"E daḡedaḡe henigumu taudia edia amo ba hamaurigu,","poem":1},{"text":"badina be lauegu ai idia na gogoada heherea.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dibura rumana amo ba hakaugu lasi,","poem":1},{"text":"bena oi ladamu baina hanamoa.","poem":2},{"text":"Kara maoromaoro taudia ese bae gegegu ahu,","poem":1},{"text":"badina be oi ese ba harihari henigu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}