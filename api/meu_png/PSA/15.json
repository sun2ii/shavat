:5,"content":[{"text":"ia ese ena moni se heni torehaimu davana iabina totona,","poem":1},{"text":"bona asi ena kerere tauna ihadikana monina danu ia se abiamu.","poem":2},{"text":"Unu e kara tomamu tauna na do basine marere ela bona hanaihanai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}