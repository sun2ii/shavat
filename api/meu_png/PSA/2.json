{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Badina be dahaka lalo-dibura taudia na e heloḡo-heloḡomu?","poem":1},{"text":"Badina be dahaka taunimanima edia lalo-hadai na kavakava?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tanobada pavapavadia e gini toremu,","poem":1},{"text":"bona lohia taudia na e henega boumu;","poem":2},{"text":"Iehova bona ia ese e horoa tauna na","poem":1},{"text":"idia ese e inai henidiamu.","poem":2},{"text":"Idia na e tomu:","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Edia gadea baita hamotudia,","poem":1},{"text":"e ḡuilaida varodia baita negedia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Guba ai e nohomu Diravana ese baine kirikirilaidia;","poem":1},{"text":"Ḡaubada ese baine hevasehalaidia.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ia ese baine gwau henidia mai baduna ida,","poem":1},{"text":"ena badu-ḡaraḡara ese baine hahisihisidia.","poem":2},{"text":"Baineto:","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Egu pavapava vada na atoa,","poem":2},{"lineBreak":true},{"text":"egu ororo Siona dorina ai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Iehova ena hereva baina harorolaia,","poem":1},{"text":"ia ese vada e hadibagu heḡereḡerena, eto:","poem":2},{"text":"Oi na lau natugu,","poem":1},{"text":"hari dina ai vada na havaramu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ba noigu, bena bese idau-idau baina henimu, oi ahumu,","poem":1},{"text":"tanobada dokodia do baina henimu, emu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Auri itotohina amo ba hamakohidia,","poem":1},{"text":"uro na heto ba huaridia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Pavapava e, ba aonega;","poem":1},{"text":"tanobada lohiamui e, ba diba.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iehova ba toma henia diho mai garimui,","poem":1},{"text":"bona mai heude-heudemui ida.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ia aena palapaladia ba harahudia,","poem":1},{"text":"baine badu henimui bena dala ai ba mase na garina;","poem":2},{"text":"badina be ena badu e vara haraḡamu.","poem":1},{"lineBreak":true},{"text":"Ia e abidadama heniamu taudia be nanamo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}