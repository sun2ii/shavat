{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"Lau ireḡugu tauna mamoe ireḡuna na heto Iehova mo;","poem":1},{"text":"lau na ḡau ta ai basina dabu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Rei manoka-manoka gabudia ai ia ese e hahekuregumu;","poem":1},{"text":"deḡedeḡerahu gabuna ranudia badibadidiai e hakaugumu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lau laumagu ia ese e hamauria loumu;","poem":1},{"text":"kara maoromaoro daladia ai ia ese e hakaugumu,","poem":2},{"lineBreak":true},{"text":"ia ladana dainai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Oibe, ena be mase diburana kourana ai baina raka,","poem":1},{"text":"to dika garina basina gari;","poem":2},{"text":"badina be oi na lau ida,","poem":1},{"text":"emu kareva bona emu itotohi ese lau taugu e haloamu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Agu aniani oi ese o dabaraiamu,","poem":1},{"text":"lau inaigu vairadiai;","poem":2},{"text":"lau kwaragu na dehoro ai o horoamu,","poem":1},{"text":"egu kehere na e hepurai dobimu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Momokani, namo bona hebogahisi do bae ḡavagu,","poem":1},{"text":"egu mauri dinadia idoidiai;","poem":2},{"text":"bona Iehova ena ruma ai","poem":1},{"text":"baina noho hanaihanai.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}