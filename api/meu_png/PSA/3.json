{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["Iehova e, e inai henigumu taudia na ede hohodia!",{"text":"E tuari henigumu taudia na hutuma.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hutuma herea ese lau e herevalaigumu,","poem":1},{"text":"etomu, Dirava ese se kahaiamu. (Selah)","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iehova, e, o ḡeḡegu ahumu, egu kesi ai o laomu;","poem":1},{"text":"oi na egu diari, lau kwaragu o abia isimu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Iehova na boi heniamu,","poem":1},{"text":"bena ena ororo helaḡana amo e haere henigumu. (Selah)","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lau na hekure, na mahuta, ma na noga;","poem":1},{"text":"badina be Iehova na egu imuda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taunimanima gerebu gerebu basina gari henidia;","poem":1},{"text":"e ḡeḡegu ahumu bona e tuari henigumu taudia na garidia basina gari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Iehova e, a tore isi!","poem":1},{"text":"Egu Dirava e, a hamaurigu!","poem":2},{"text":"Badina be inaigu iboudiai na vahadia vada o patadia,","poem":1},{"text":"kara dika taudia danu isedia vada o hakwaidudia.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hahemauri na Iehova ena amo e maimu;","poem":1},{"text":"emu hahenamo na emu orea taudia latadiai e miamu. (Selah)","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}