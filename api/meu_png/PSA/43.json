{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Dirava e, ba gwauraigu maoro;","poem":1},{"text":"se matauraimumu besena enai maorogu ba gwauraia;","poem":2},{"lineBreak":true},{"text":"kara koikoi bona kara gageva-gageva taudia imadia amo ba hamaurigu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Oi na lau igimagu Diravana;","poem":1},{"text":"dahaka dainai vada o negegu daure?","poem":2},{"text":"Badina be dahaka na tai ḡadeḡademu,","poem":1},{"text":"inaigu edia daḡedaḡe karadia daidiai?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Emu diari bona emu hereva momokani a siaia mai,","poem":1},{"text":"idia ese bae hakaugu;","poem":2},{"text":"emu ororo helaḡana bona emu noho kalagana ediai","poem":1},{"text":"bae hakaugu vasi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bena Dirava ena ihaboulaina patana baina lao henia;","poem":1},{"text":"na moalelaia badamu Diravana baina lao henia.","poem":2},{"text":"Dirava e, egu Dirava,","poem":1},{"text":"lau ese gitara amo baina hanamomu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Laumagu e, dahaka dainai vada o metau?","poem":1},{"text":"Dahaka hekwarahina lalogu ai o karaiamu?","poem":2},{"text":"Dirava ba laroa; badina be lau do baina hanamoa lou,","poem":1},{"text":"lau ikahagu bona egu Dirava.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}