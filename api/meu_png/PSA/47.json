{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":47,"content":[{"type":"verse","number":1,"content":[{"text":"Bese idau-idau iboumui ai, imamui ba poupou;","poem":1},{"text":"Dirava ba lolo henia, moale anedia ba lololai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Badina be Iehova, Herea Mikamika, na mai garina;","poem":1},{"text":"ia na Pavapava badana, tanobada idoinai e lohiaiamu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ia ese bese idau-idau ita henudai vada e hamanadadia,","poem":1},{"text":"orea idau-idau aeda henudiai vada e atodia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ia ese ahuda vada e abia hidi,","poem":1},{"text":"ena lalokau tauna Iakob ena heaḡi. (Selah)","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dirava na mai lolona ida vada e dae,","poem":1},{"text":"Iehova na mai kibi reḡena ida vada e dae.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dirava ba hanamoa, ia ihanamolaina anedia bavabi;","poem":1},{"text":"eda Pavapava ba hanamoa, ia ihanamolaina anedia bavabi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Badina be Dirava na tanobada idoinai pavapavana;","poem":1},{"text":"salamo amo ba hanamoa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dirava ese bese idau-idau e lohiadiamu;","poem":1},{"text":"Dirava na ena terono helaḡana ai e helaimu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bese idau-idau lohiadia e heboumu,","poem":1},{"text":"Abraham ena Dirava ena bese ai baela.","poem":2},{"text":"Badina be tanobada kesidia na Dirava ena;","poem":1},{"text":"ia bae imodaia bada.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}