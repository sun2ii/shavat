{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":[{"text":"Dirava e, oi ladamu amo ba hamaurigu,","poem":1},{"text":"oi goadamu amo ba gwauraigu maoro.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dirava e, egu noinoi a kamonai,","poem":1},{"text":"lau udugu herevadia ba hakala henidia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Badina be asi edia hemataurai taudia vada e tore isi,","poem":1},{"text":"lau ihadikagu totona;","poem":2},{"text":"daḡedaḡe taudia ese egu mauri iabi-ohona e tahuamu,","poem":1},{"text":"idia lalodia ai na Dirava asie hanohoamu. (Selah)","poem":2}]},{"type":"verse","number":4,"content":[{"text":"A itaia, Dirava na lau ikahagu,","poem":1},{"text":"Ḡaubada na egu mauri imudana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lau inaigu na dava dikana baine henidia;","poem":1},{"text":"emu momokani ai ba habuadia tari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Egu lalo-namo ai egu boubou ḡauna baina hahelaḡaia oiemu;","poem":1},{"text":"Iehova e, oi ladamu baina hanamoa,","poem":2},{"lineBreak":true},{"text":"badina be ia na namo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Badina be oi ese hekwakwanai iboudiai lalodia amo vada o harohogu mauri;","poem":1},{"text":"inaigu na egu kwalimu ai na itadia nenenenemu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}