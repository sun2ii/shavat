{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":[{"text":"Dirava e, egu taitai a kamonai,","poem":1},{"text":"egu ḡuriḡuri bavabia dae;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"lau kudougu e hetahamu negana ai na","poem":1},{"text":"tanobada dokona amo baina boi henimu.","poem":2},{"lineBreak":true},{"text":"Mani a hakaugu lao,","poem":1},{"text":"baine hagagu tao nadina enai;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"badina be egu roho mauri gabuna na oiemu ai,","poem":1},{"text":"egu kohoro na oi, inai taudia ilao-ahudia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Emu kalaga ai baina noho hanaihanai,","poem":1},{"text":"oi hanimu ikerukerudia ai baina mauri. (Selah)","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Badina be, Dirava e, oi ese egu gwauhamata vada o kamonai","poem":1},{"text":"oi ese oi ladamu e matauraiamu taudia ahudia vada o henigu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hanua pavapavana ena mauri ba hadaudaua,","poem":1},{"text":"ena mauri laḡanidia bae hesiriu ela bona uru iboudiai,","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ena terono ai baine helai hanaihanai, Dirava vairanai;","poem":2},{"text":"lalokau bona momokani amo ba reḡua.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Taunabunai lau ese oi ladamu baina hanamoa egu ane ai;","poem":1},{"text":"dina ta ta amo egu gwauhamata anidia baina kara.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}