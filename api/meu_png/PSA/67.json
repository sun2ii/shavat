{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":67,"content":[{"type":"verse","number":1,"content":[{"text":"Dirava baine bogada hisi, baine hanamoda,","poem":1},{"text":"ia vairana diarina baine henida. (Selah)","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tanobada ai oiemu dala bae diba totona;","poem":1},{"text":"bona emu hahemauri siahuna bese iboudiai bogaragidiai danu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dirava e, bese idau-idau bae hanamomu,","poem":1},{"text":"bese iboudiai bae imodaimu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bese idau-idau bae moale, moale anedia bae abi,","poem":1},{"text":"badina be tanobada taudia o hahemaoro henidiamu mai maoromaoromu ida,","poem":2},{"lineBreak":true},{"text":"bona tanobada besedia o hakaudiamu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dirava e, bese idau-idau bae hanamomu,","poem":1},{"text":"bese iboudiai bae imodaimu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tano anina vada e vara ḡoevaḡoeva;","poem":1},{"text":"Dirava, iseda Dirava, ese vada e hanamoda.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dirava vada e hanamoda;","poem":1},{"text":"bona tanobada dokodia iboudiai ese ia garina bae gari.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}