{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":70,"content":[{"type":"verse","number":1,"content":[{"text":"Dirava e, a harohogu mauri,","poem":1},{"text":"Iehova e, ba durugu haraḡa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lauegu mauri iabi-ohona dalana e tahuamu taudia na","poem":1},{"text":"ba hahemaraidia bona ba haheḡonudia;","poem":2},{"text":"ihahisigu e uramu taudia na","poem":1},{"text":"ba haloudia bona ba hahemaraidia.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"E gwau henigumu, e tomu “Aha, aha”, taudia na","poem":1},{"text":"edia hemarai dainai bae kudou hetaha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"E tahumunu taudia iboudiai na","poem":1},{"text":"bae moale, oi bae moalelaimu;","poem":2},{"text":"emu hahemauri e ura heniamu taudia na","poem":1},{"text":"bae hereva loulou, baeto “Dirava na herea-dae”.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"A lau be na ogoḡamimu bona na dabumu;","poem":1},{"text":"Dirava e, aoma haraḡa dekegu ai.","poem":2},{"text":"Oi na lau ikahagu bona lau ihamaurigu;","poem":1},{"text":"Iehova e, basio halahe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}