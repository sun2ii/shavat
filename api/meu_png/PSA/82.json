{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":82,"content":[{"type":"verse","number":1,"content":[{"text":"Dirava ese dirava edia hebou lalonai ena gabu vada e abia,","poem":1},{"text":"dirava idau-idau bogaragidiai hahemaoro e karaiamu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Umui na ba hahemaoro kerere-kerere ela bona edena nega ai?","poem":1},{"text":"Kara dika taudia ediai ba tao ela bona edena nega ai? (Selah)","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asie goadamu taudia bona ihareha na hahemaoro maorona ba henidia,","poem":1},{"text":"hisihisi taudia bona ogoḡami taudia edia dala maorodia ba gwaurai.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Asie goadamu taudia bona e dabumu taudia ba hamauridia;","poem":1},{"text":"kara dika taudia imadia amo ba harohodia mauri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Idia na asi edia aonega bona asi edia lalo-parara,","poem":1},{"text":"dibura ai a loa eva-evamu;","poem":2},{"lineBreak":true},{"text":"tanobada badidia iboudiai na e heude-heudemu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lau na tomamu: Umui na dirava;","poem":1},{"text":"iboumui ai na Herea Mikamika natuna;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ḡau tamona, taunimanima heḡereḡeredia do ba mase,","poem":1},{"text":"hanua pavapavana natuna ta heḡereḡerena ba keto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dirava e, a tore isi, tanobada ba hahemaoro henia;","poem":1},{"text":"badina be bese iboudiai na oiemu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}