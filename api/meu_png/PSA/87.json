{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"PSA","translationId":"meu_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO","order":19,"numberOfChapters":150,"sha256":"8b8a9b86fad037b3aec179dccd699937f10a2415e55ca34b1f8748198d9cef2a","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/meu_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":87,"content":[{"type":"verse","number":1,"content":[{"text":"Ororo helaḡana ai Iehova ese e hadaia hanuana na e ginimu;","poem":1}]},{"type":"verse","number":2,"content":[{"text":"ia ese Siona ikoukoudia e ura henidia badamu,","poem":2},{"lineBreak":true},{"text":"Iakob ena noho gabudia iboudiai na e ura henidia maraḡimu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dirava ena hanua e,","poem":1},{"text":"oi hairaimu na e imodaiamu. (Selah)","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Rahaba bona Babulono na dibadia lau,","poem":1},{"text":"Filistia bona Turo bona Etiopia danu:","poem":2},{"lineBreak":true},{"text":"“Ina na unuseni ai e vara”, e tomu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Siona danu bae herevalaia, baeto","poem":1},{"text":"“Ina bona una na ia lalonai e vara”.","poem":2},{"text":"Badina be Herea Mikamika ese","poem":1},{"text":"baine haginia tutuka-tutuka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bese idau-idau e hagaudiamu negana ai Iehova na e gwaumu","poem":1},{"text":"“Ina na unuseni ai e vara”. (Selah)","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ane-abi taudia bona mavaru taudia na e gwaumu","poem":1},{"text":"“Lau badigu idoinai na oiemu ai”.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}