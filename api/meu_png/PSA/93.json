na momokani;","poem":1},{"text":"emu ruma na helaḡa,","poem":2},{"lineBreak":true},{"text":"bona do baine helaḡa hanaihanai.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}