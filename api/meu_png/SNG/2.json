{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"SNG","translationId":"meu_png","name":"SOLOMON ENA ANE","commonName":"SOLOMON ENA ANE","title":"SOLOMON ENA ANE","order":22,"numberOfChapters":8,"sha256":"e3c105fbd2855adef2183b841b49afacafbc32455ad9ff0ae9cb539f08e4dec9","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/meu_png/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Lau na Saron vahuvahuna,","poem":1},{"text":"koura ai e varamu sosanana.","poem":2},{"noteId":3},"*****"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ulato bogaragidiai egu lalokau na","poem":1},{"text":"sosana burena siniura bogaragidiai na heto.","poem":2},"*****"]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Uhau bogaragidiai egu lalokau na","poem":1},{"text":"apolo auna uda audia bogaragidiai na heto.","poem":2},{"text":"Ia ikerukeruna ai na helai mai moale-badagu ida;","poem":1},{"text":"huahuana na mai gaihona udugu ai.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Aria rumana ai e hakaugu lao;","poem":1},{"lineBreak":true},{"text":"ena pepe lau daegu ai na lalokau.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vine huahuadia kakorodia amo ba ubugu,","poem":1},{"text":"apolo huahuadia amo ba hagoadagu,","poem":2},{"lineBreak":true},{"text":"badina be uraheni ese e hamasegumu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Imana laurina amo bema hahekwinagu,","poem":1},{"text":"imana idibana amo bema rosigu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ierusalem kekenimui e, na haḡanimuimu,","poem":1},{"text":"uda nanidia bona dia daidiai,","poem":2},{"text":"uraheni na basio haoa","poem":1},{"text":"ela bona sibona baine noga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Egu lalokau tauna gadona!","poem":1},{"text":"A itaia, ia na e maimu;","poem":2},{"text":"ororo badadia ai e roho daemu,","poem":1},{"text":"ororo maraḡidia ai e roho laomu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Egu lalokau tauna na uda nanina","poem":1},{"text":"eiava dia natuna na heto.","poem":2},{"lineBreak":true},{"text":"A itaia, emai ruma murimurinai e ginimu,","poem":1},{"text":"gaba-mauruna amo e ha-igomu,","poem":2},{"lineBreak":true},{"text":"makamaka amo e igo vareaimu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Egu lalokau tauna ese e hereva henigumu,","poem":1},{"text":"ini e gwau tomamu:","poem":2},{"lineBreak":true},{"text":"Egu lalokau e, a tore isi!","poem":1},{"text":"Hane namo e, aitala!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Keru negana vada e ore;","poem":1},{"text":"medu vada e doko.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tano heraheradia vada e tubu;","poem":1},{"text":"ane-abi negana vada e kau;","poem":2},{"lineBreak":true},{"text":"bona pune na e taimu eda tano ai.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Suke huahuadia e dobimu,","poem":1},{"text":"vine buredia e papamu,","poem":2},{"lineBreak":true},{"text":"bonadia na e daemu.","poem":2},{"text":"Egu lalokau e, a tore isi!","poem":1},{"text":"Hane namo e, aitala!","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Egu pune e, oi na nadi matudia ai;","poem":1},{"text":"oi na haga kohuadia ai.","poem":2},{"text":"Vairamu bama itaia,","poem":1},{"text":"bona gadomu bama kamonai;","poem":2},{"text":"badina be gadomu na namo,","poem":1},{"lineBreak":true},{"text":"bona vairamu na mai hairaina.","poem":1},"*****"]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Aoma, mariboi baita idoadia,","poem":1},{"text":"ena be mamaragi to","poem":2},{"text":"idia ese vine imeadia e hadikamu,","poem":1},{"text":"badina na eda vine buredia e papamu.","poem":2},"*****"]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ia na egu lalokau, lau be ena lalokau;","poem":1},{"text":"ia ese ena mamoe e ubudiamu, sosana bogaragidiai.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Egu lalokau taumu e, a kerehai,","poem":1},{"text":"uda nanina eiava dia natuna","poem":2},{"lineBreak":true},{"text":"ororo gabaedia ai na heto;","poem":2},{"text":"ela bona dina baine keruma,","poem":1},{"text":"bona hanua baine boi.","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"“Sosana” na Heberu taudia edia herahera avana ta.","reference":{"chapter":2,"verse":1}}]},"thisChapterLink":"/api/meu_png/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}