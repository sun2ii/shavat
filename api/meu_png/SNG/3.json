{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"SNG","translationId":"meu_png","name":"SOLOMON ENA ANE","commonName":"SOLOMON ENA ANE","title":"SOLOMON ENA ANE","order":22,"numberOfChapters":8,"sha256":"e3c105fbd2855adef2183b841b49afacafbc32455ad9ff0ae9cb539f08e4dec9","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/meu_png/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Hanuaboi ai, egu mahuta patana ai,","poem":1},{"text":"egu lalokau tauna na tahua;","poem":2},{"text":"na tahua, to asina davaria,","poem":1},{"text":"na boiria, to ia na se haere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Aina tore isi, hanua ai baina loa eva-eva,","poem":1},{"text":"ariara ai bona noho-bou gabudia ai","poem":2},{"text":"egu lalokau tauna baina tahua.","poem":1},{"text":"Na tahua, to asina davaria.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gima taudia ese e davarigu,","poem":1},{"text":"hanua ai e loa eva-evava ai;","poem":2},{"text":"na tai henidia, nato","poem":1},{"text":"“Egu lalokau tauna so itaia a?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Na rakatanidia, bena asi vanahana","poem":1},{"text":"egu lalokau tauna na davaria.","poem":2},{"text":"Na dogoa tao, asina kahua nege,","poem":1},{"text":"ema bona sinagu ena ruma ai,","poem":2},{"text":"e havaragu hahinena ena daiutu ai,","poem":1},{"text":"na hakaua dae.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ierusalem kekenimui e, na haḡanimuimu,","poem":1},{"text":"uda nanidia bona dia daidiai,","poem":2},{"text":"uraheni na basio haoa","poem":1},{"text":"ela bona sibona baine noga.","poem":2},"*****"]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Una na dahaka, tano ḡaḡaena amo e maimu,","poem":1},{"text":"kwalahu dubuna na heto,","poem":2},{"text":"mai bonana, muro bona lebona","poem":1},{"noteId":4},{"text":"bona hoihoi tauna ena muramura mai bonadia ibouboudiai?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"A itaia, Solomon ena ivitoto,","poem":1},{"text":"goada taudia tauratoi-ahui ese e ginia heḡeḡemu!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Idia na Israel ena goada taudia,","poem":1},{"text":"iboudiai na mai daredia gabadia ai.","poem":2},{"text":"Tuari na mai dibadia;","poem":1},{"text":"ta ta edia dare na koekoedia ai;","poem":2},{"lineBreak":true},{"text":"hanuaboi ena hahegari ḡaudia ilao-ahudia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"King Solomon ena laolao kalagana na","poem":1},{"text":"Lebanon audia amo e karaia.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Aena na silver, tabekau kahana na gold;","poem":1},{"text":"helai ḡauna iḡovana na dabua kakakakana.","poem":2},{"text":"Laloma kahana na e haheraia ḡoevaḡoeva,","poem":1},{"text":"Ierusalem kekenidia ese.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Siona kekenimui e, a raka lasi;","poem":1},{"text":"King Solomon ba itaia.","poem":2},{"text":"Ena havava ḡauna be kwarana ai;","poem":1},{"text":"ena headava dinana ai,","poem":2},{"text":"lalona e moaleva dinana ai,","poem":1},{"text":"sinana ese ia kwarana e havavalaia.","poem":2},"*****"]},{"type":"line_break"}],"footnotes":[{"noteId":4,"caller":"+","text":"“Muro” bona “lebona” na Heberu taudia edia muramura mai bonadia ladadia.","reference":{"chapter":3,"verse":6}}]},"thisChapterLink":"/api/meu_png/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}