{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"SNG","translationId":"meu_png","name":"SOLOMON ENA ANE","commonName":"SOLOMON ENA ANE","title":"SOLOMON ENA ANE","order":22,"numberOfChapters":8,"sha256":"e3c105fbd2855adef2183b841b49afacafbc32455ad9ff0ae9cb539f08e4dec9","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/meu_png/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Egu lalokau e, oi na hane namo;","poem":1},{"text":"momokani, oi na hane namo.","poem":2},{"text":"Matamu na pune,","poem":1},{"text":"vairamu iḡovalaina dabuana murinai.","poem":2},{"text":"Huimu na nani serina,","poem":1},{"text":"Gilead ororona amo e hekei dihomu na heto.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isemu na mamoe serina huidia vada e utu","poem":1},{"text":"bena digu gabuna amo e daemu na heto;","poem":2},{"text":"iboudiai na mai natudia vara-hekapa,","poem":1},{"text":"ta se raka edeamu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Udumu bibinadia na varo kakakakadia na heheto;","poem":1},{"text":"udumu na mai hairaina.","poem":2},{"text":"Vahamu ruaosi na rimono","poem":1},{"noteId":5},{"text":"huahuana e ivaia parara na heto,","poem":1},{"text":"vairamu iḡovalaina dabuana murinai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Aiomu na David ena kohoro na heto,","poem":1},{"text":"ena tuari ḡaudia e haboumu gabuna;","poem":2},{"text":"unuseni ai kesi daha-ta hetau dadae,","poem":1},{"text":"iboudiai na tuari taudia edia kesi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ratamu ruaosi na uda nanidia natudia rua na heheto,","poem":1},{"text":"uda nanina hahinena natuna vara-hekapa,","poem":2},{"lineBreak":true},{"text":"sosana bogaragidiai e anianimu ḡaudia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lau na muro ororona bainala,","poem":1},{"text":"lebona","poem":2},{"noteId":6},{"text":"ororona baina lao henia,","poem":2},{"text":"ela bona dina baine keruma,","poem":1},{"text":"bona hanua baine boi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Egu lalokau e, oi na hane namo;","poem":1},{"text":"oi na asi bebeka-bebekamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Adavagu e, Lebanon amo baita raka hebou,","poem":1},{"text":"Lebanon amo baita raka hebou.","poem":2},{"text":"Amana bona Seniri bona Heremon ororodia doridia,","poem":1},{"text":"bona leona edia kohua bona taiga edia ororo,","poem":2},{"lineBreak":true},{"text":"ba rakatanidia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Taihugu e, adavagu e,","poem":1},{"text":"lalogu vada o hamanokaia.","poem":2},{"text":"Matamu ena halari tamona ai,","poem":1},{"text":"aiomu agevana ena herahera nadina tamona ai,","poem":2},{"text":"lalogu vada o hamanokaia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Taihugu e adavagu e,","poem":1},{"text":"emu uraheni na daka gaiho!","poem":2},{"lineBreak":true},{"text":"Emu uraheni ese vine ranuna e hereaiamu,","poem":1},{"text":"emu dehoro bonana ese muramura iboudiai bonadia e hereadiamu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Adavagu e, bada-ranuna na udumu bibinadia amo e hetuturumu,","poem":1},{"text":"bada-ranuna bona rata na malamu henunai;","poem":2},{"text":"emu dabua bonadia na","poem":1},{"text":"Lebanon bonana na heto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Taihugu, adavagu, na e hekou kunuka-kunuka umana;","poem":1},{"text":"e hekou kunuka-kunuka umana,","poem":2},{"lineBreak":true},{"text":"e hekou ahu ranuna.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Emu uma ai e varamu ḡaudia na","poem":1},{"text":"rimono","poem":2},{"noteId":7},{"text":"audia mai huahuadia herea-daedia,","poem":2},{"text":"bona kofere bona nerede;","poem":1}]},{"type":"verse","number":14,"content":[{"text":"oibe, nerede bona karakomo,","poem":2},{"text":"bona kane bona kinamomo,","poem":1},{"text":"bona lebona audia iboudiai;","poem":2},{"text":"bona muro bona aloe,","poem":1},{"noteId":8},{"text":"bona muramura hereadia iboudiai.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hari uma na mai ranu-lohilohi gabuna,","poem":1},{"text":"bona mai mauri-ranuna gurina,","poem":2},{"text":"bona mai sinavai-sinavaina,","poem":1},{"text":"Lebanon amo e arumu.","poem":2},"*****"]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Lai mirigini e, a noga!","poem":1},{"text":"Diho e, a toa! Egu uma ba toa henia,","poem":2},{"lineBreak":true},{"text":"ena muramura bonadia ba oda rohoroholai.","poem":2},{"text":"Egu lalokau tauna na ena uma ai baine raka vareai","poem":1},{"text":"ena huahua herea-daedia baine ani.","poem":2},"*****"]},{"type":"line_break"}],"footnotes":[{"noteId":5,"caller":"+","text":"“Rimono” na Heberu taudia edia au huahua ta.","reference":{"chapter":4,"verse":3}},{"noteId":6,"caller":"+","text":"“Muro” bona “lebona” na Heberu taudia edia muramura mai bonadia ladadia.","reference":{"chapter":4,"verse":6}},{"noteId":7,"caller":"+","text":"“Rimono” na Heberu taudia edia au huahua ta.","reference":{"chapter":4,"verse":13}},{"noteId":8,"caller":"+","text":"Kofere; nerede; karakomo; kane; kinamomo; lebona; muro; aloe. Ini na Heberu taudia edia muramura mai bonadia haida ladadia.","reference":{"chapter":4,"verse":14}}]},"thisChapterLink":"/api/meu_png/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}