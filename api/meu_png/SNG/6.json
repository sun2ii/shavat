{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"SNG","translationId":"meu_png","name":"SOLOMON ENA ANE","commonName":"SOLOMON ENA ANE","title":"SOLOMON ENA ANE","order":22,"numberOfChapters":8,"sha256":"e3c105fbd2855adef2183b841b49afacafbc32455ad9ff0ae9cb539f08e4dec9","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/meu_png/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Hane namo e,","poem":1},{"text":"emu lalokau tauna na ede ela?","poem":2},{"text":"Emu lalokau tauna na ede kaha ai vada e raka siri?","poem":1},{"text":"Edeseni ai baita tahua?","poem":2},"*****"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Egu lalokau na ena uma vada ela,","poem":1},{"text":"ena muramura avadia umana.","poem":2},{"text":"Uma ai ena mamoe baine ubudia,","poem":1},{"text":"bona sosana heraheradia baine haboudia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ia na egu lalokau, lau be ena lalokau;","poem":1},{"text":"ia ese ena mamoe e ubudiamu,","poem":2},{"lineBreak":true},{"text":"sosana","poem":2},{"noteId":11},{"text":"bogaragidiai.","poem":2},"*****"]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Egu lalokau e, oi na mai hairaimu, Tirisa na heto;","poem":1},{"text":"hairaimu na herea, Ierusalem na heto;","poem":2},{"text":"itamu na mai garina, tuari oreana mai pepena na heto.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Asio raraigu, badina be matamu ese e hamanoka-manokagumu.","poem":2},{"lineBreak":true},{"text":"Huimu na nani serina","poem":1},{"text":"Gilead ororona amo e hekei dihomu na heto.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isemu na mamoe serina","poem":1},{"text":"digu gabuna amo e daemu na heto;","poem":2},{"text":"iboudiai na mai natudia vara-hekapa,","poem":1},{"text":"ta se raka edeamu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vahamu ruaosi na rimono","poem":1},{"noteId":12},{"text":"huahuana e ivaia parara na heto,","poem":1},{"text":"Vairamu iḡovalaina dabuana murinai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lohia hahinedia na tauratoi-ahui,","poem":1},{"text":"hesiai hahinedia na taurahani-ahui,","poem":2},{"lineBreak":true},{"text":"ulato na asi iduahidia.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Egu pune na ḡoeva-dae, ia mo sibosibona;","poem":1},{"text":"ia na sinana ena lalokau,","poem":2},{"lineBreak":true},{"text":"e havaraia hahinena natuna herea-daena.","poem":2},{"text":"Ulato ese e itaia, bena e hanamoa;","poem":1},{"text":"lohia hahinedia bona hesiai hahinedia ese e itaia,","poem":2},{"lineBreak":true},{"text":"bena e imodaia.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ina be daika, ita-itana na daba e reremu na heto?","poem":1},{"text":"Mai hairaina hua na heto?","poem":2},{"text":"Mai diaridiarina dina na heto?","poem":1},{"text":"Itana na mai garina, tuari oreana mai pepena na heto, ani?","poem":2},"*****"]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Okari imeana na lao henia,","poem":1},{"text":"koura heraheradia baina itadia;","poem":2},{"text":"baina itaia, vine vada e tubu eiava;","poem":1},{"text":"baina diba, rimono","poem":2},{"noteId":13},{"text":"vada e kobo eiava.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Asi vanahana na mata hanai: lau na kariota ai,","poem":1},{"text":"egu lohia tauna badibadinai nato.","poem":2},"*****"]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Sulama kekenina e, a lou mai, a lou mai;","poem":1},{"text":"baina raraimu tao, a lou mai, a lou mai.","poem":2},"*****",{"lineBreak":true},{"text":"Badina be dahaka Sulama kekenina ba raraia,","poem":1},{"text":"Mahanaim mavaruna boma raraia na heto?","poem":2},"*****"]}],"footnotes":[{"noteId":11,"caller":"+","text":"“Sosana” na Heberu taudia edia herahera avana ta.","reference":{"chapter":6,"verse":3}},{"noteId":12,"caller":"+","text":"“Rimono” na Heberu taudia edia au huahua ta.","reference":{"chapter":6,"verse":7}},{"noteId":13,"caller":"+","text":"“Rimono” na Heberu taudia edia au huahua ta.","reference":{"chapter":6,"verse":11}}]},"thisChapterLink":"/api/meu_png/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}