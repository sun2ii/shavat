{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"SNG","translationId":"meu_png","name":"SOLOMON ENA ANE","commonName":"SOLOMON ENA ANE","title":"SOLOMON ENA ANE","order":22,"numberOfChapters":8,"sha256":"e3c105fbd2855adef2183b841b49afacafbc32455ad9ff0ae9cb539f08e4dec9","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/meu_png/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Lohia kekenimu e,","poem":1},{"text":"emu mai tamakadia ida be daka hairai!","poem":2},{"text":"Mamumu bauka-baukadia na herahera nadidia na heheto,","poem":1},{"text":"karakara tauna namona ese e kara.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hudomu na kehere kuboruna na heto,","poem":1},{"text":"vine ranuna ai e honu hanaihanaimu.","poem":2},{"text":"Bogamu na uit isenuna ta,","poem":1},{"text":"sosana","poem":2},{"noteId":14},{"text":"ese e haheḡeḡea daemu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ratamu ruaosi na uda nanidia natudia rua na heheto,","poem":1},{"text":"uda nanina natuna vara-hekapa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Aiomu na kohoro na heto,","poem":1},{"text":"aivori","poem":2},{"noteId":15},{"text":"amo e hadaia ḡauna.","poem":2},{"text":"Matamu na Hesebon gohugohudia,","poem":1},{"text":"Batarabim ikoukouna badibadinai.","poem":2},{"text":"Udu-baubaumu na Lebanon kohorona na heto,","poem":1},{"text":"Damasko roha-hekeina.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwaramu na mai hairaina, Karamele ororona na heto;","poem":1},{"text":"bona huimu heveriveridia na varo kakakakadia na heheto,","poem":2},{"lineBreak":true},{"text":"hanua pavapavana na huimu ai vada e heau kau.","poem":2},"*****"]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lalokau e, moale ihavarana kekenimu,","poem":1},{"text":"oi na hane namo, oi na mai hairaimu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Emu lata na buatau auna na heto,","poem":1},{"text":"bona ratamu na buatau takodia na heheto.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lau na tomu, Buatau auna baina dae,","poem":1},{"text":"bona takona baina abidia.","poem":2},{"text":"Ratamu na vine takodia ida bae heḡereḡere,","poem":1},{"text":"udumu bonana na apolo bonadia heḡereḡeredia.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Emu haherahu na vine ranuna namo-hereana na heto,","poem":1},{"text":"i'inuna na mai gaihona,","poem":2},{"lineBreak":true},{"text":"bibinagu ai bona isegu ai.","poem":2},"*****"]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Lau na egu lalokau tauna ena;","poem":1},{"text":"ia ese e ura henigumu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Egu lalokau e, aoma!","poem":1},{"text":"aita raka lasi tano paka ai,","poem":2},{"lineBreak":true},{"text":"hanua maraḡidia ai baita noho;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"daba ai vine imeadia baitala,","poem":1},{"text":"baita itaia, vine vada e kobo dae eiava,","poem":2},{"text":"baita diba, buredia vada e papa eiava,","poem":1},{"text":"baita tahua, rimono","poem":2},{"noteId":16},{"text":"vada e tubu eiava lasi.","poem":2},{"text":"Unuseni ai baina ura henimu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dudai","poem":1},{"noteId":17},{"text":"bonadia na e daemu,","poem":1},{"text":"emai iduara daediai na huahua namo-hereadia idau-idau,","poem":2},{"text":"matamatadia bona gunadia,","poem":1},{"text":"vada na haboudia oiemu,","poem":2},{"lineBreak":true},{"text":"egu lalokau e!","poem":2}]}],"footnotes":[{"noteId":14,"caller":"+","text":"“Sosana” na Heberu taudia edia herahera avana ta.","reference":{"chapter":7,"verse":2}},{"noteId":15,"caller":"+","text":"“Aivori” na elefant doana.","reference":{"chapter":7,"verse":4}},{"noteId":16,"caller":"+","text":"“Rimono” na Heheru taudia edia au huahua ta.","reference":{"chapter":7,"verse":12}},{"noteId":17,"caller":"+","text":"“Dudai” na Heheru taudia edia muramura avana ta.","reference":{"chapter":7,"verse":13}}]},"thisChapterLink":"/api/meu_png/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}