{"translation":{"id":"meu_png","name":"Buk Baibel long tokples Motu","website":"https://ebible.org/Scriptures/details.php?id=meu","licenseUrl":"https://ebible.org/Scriptures/details.php?id=meu","licenseNotes":null,"shortName":"PNG","englishName":"Motu Bible","language":"meu","textDirection":"ltr","sha256":"0eec67cac37e6b89e034b623eb35940247a2e247769f0470331a80eddfc62a00","availableFormats":["json"],"listOfBooksApiLink":"/api/meu_png/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31089,"languageName":"Motu","languageEnglishName":"Motu"},"book":{"id":"SNG","translationId":"meu_png","name":"SOLOMON ENA ANE","commonName":"SOLOMON ENA ANE","title":"SOLOMON ENA ANE","order":22,"numberOfChapters":8,"sha256":"e3c105fbd2855adef2183b841b49afacafbc32455ad9ff0ae9cb539f08e4dec9","firstChapterNumber":1,"firstChapterApiLink":"/api/meu_png/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/meu_png/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Bema oi na lau taihugu,","poem":1},{"text":"sinagu ratana e inuava tauna,","poem":2},{"text":"ariara ai baitama hedavari bena bama harahumu,","poem":1},{"text":"bona ta ese basinema ihi-ihiraigu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sinagu ena ruma ai,","poem":1},{"text":"e havaragu hahinena ena daiutu ai,","poem":2},{"lineBreak":true},{"text":"bama hakaumu vareai.","poem":2},{"text":"Vine ranuna mai muramurana bama henimu,","poem":1},{"text":"egu rimono ranuna bama ha-inulaimu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Imana laurina amo bema hahekwinagu,","poem":1},{"text":"imana idibana amo bema rosigu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ierusalem kekenimui e, na haḡanimuimu,","poem":1},{"text":"uraheni na basio haoa,","poem":2},{"lineBreak":true},{"text":"ela bona sibona baine noga.","poem":2},"*****"]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Una na daika, tano ḡaḡaena amo e maimu,","poem":1},{"text":"ena lalokau tauna enai e tabe kaumu?","poem":2},"*****",{"lineBreak":true},{"text":"Apolo auna henunai na haomu;","poem":1},{"text":"unuseni ai sinamu e hekamonaiva,","poem":2},{"lineBreak":true},{"text":"unuseni ai e havaramu hahinena na hisi e aniva.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Toagu avatoa lalomu ai,","poem":1},{"text":"toagu avatoa imamu ai.","poem":2},{"text":"Lalokau ena goada na mase ena goada heḡereḡerena,","poem":1},{"text":"bona mama ena daḡedaḡe na mase gabuna ena daḡedaḡe heḡereḡerena;","poem":2},{"text":"ena ḡaraḡara na lahi ḡaraḡarana na heto,","poem":1},{"text":"ena siahu na lahi hururu-hururuna siahuna na heto.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ranu momo ese lalokau basie habodoa diba;","poem":1},{"text":"utu-utu badadia ese basie utua dae diba.","poem":2},{"text":"Tau ta ese ena taḡa idoinai bema heni dudu kau, lalokau davana,","poem":1},{"text":"to basinema heḡereḡere;","poem":2},{"lineBreak":true},{"text":"bema dadaraia vaitani.","poem":2},"*****"]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tadimai ta do asi ratana.","poem":1},{"text":"Tadimai ede baia durua toma,","poem":2},{"lineBreak":true},{"text":"tau ta ese baine herevalaia negana ai?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ia na bema magu, silver amo baia ha-aukaia;","poem":1},{"text":"bema iduara, sida reireidia amo baia koua ahu.","poem":2},"*****"]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Lau na maḡu, ratagu na kohoro na heto;","poem":1},{"text":"e herevalaigu tauna vairanai","poem":2},{"lineBreak":true},{"text":"lau na maino imailaina.","poem":2},"*****"]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Solomon ena vine imeana ta be Baal-hamono ai;","poem":1},{"text":"ia ese imea ireguna taudia e habadinalaidia.","poem":2},{"text":"Ta ta silver monidia daha-ta daha-ta e heni,","poem":1},{"text":"imea anina davana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Solomon e, oiemu daha-ta bavabia;","poem":1},{"text":"vine ireḡuna taudia edia sinahu-rua bae abi danu.","poem":2},{"text":"A lauegu vine imeana na lauegu korikori,","poem":1},{"text":"lau sibogu egu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Imea ai o nohomu taumu e,","poem":1},{"text":"bamogu na e hakalamu, gadomu ikamonaina totona;","poem":2},{"lineBreak":true},{"text":"lau danu eremu bama kamonai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Egu lalokau e, aoma haraḡa,","poem":1},{"text":"uda nanina eiava dia natuna","poem":2},{"lineBreak":true},{"text":"muramura ororodia ai na heto.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/meu_png/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/meu_png/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/meu_png/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}