{"translation":{"id":"mfx_ewf","name":"ኦሮꬅ ጫቆ","website":"https://ebible.org/Scriptures/details.php?id=mfxe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mfxe","licenseNotes":null,"shortName":"EWF","englishName":"Melo NT Ethiopic","language":"mfx","textDirection":"ltr","sha256":"7ef31996970f101d638bc8a4c9ce01f9f3641bfad44b337f615b8a5768dc3197","availableFormats":["json"],"listOfBooksApiLink":"/api/mfx_ewf/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7938,"languageName":"Melo","languageEnglishName":"Melo"},"book":{"id":"1CO","translationId":"mfx_ewf","name":"1ቆሮንቶሳ","commonName":"1ቆሮንቶሳ","title":"ጳዉሎሳ ቆሮንቶሳ አሳይስ ጻፌዝ ቲና ኪታ","order":46,"numberOfChapters":16,"sha256":"1c2fa76812ac69aa0550f8a00160655c8073a92b01a76409a4aa713f7f98153d","firstChapterNumber":1,"firstChapterApiLink":"/api/mfx_ewf/1CO/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/mfx_ewf/1CO/16.json","totalNumberOfVerses":437},"chapter":{"number":2,"content":[{"type":"heading","content":["ሶትንቴዝ ክርስቶሳ ባጋ"]},{"type":"verse","number":1,"content":["ታ እሹን፥ ታኒ ቲና ጾሳ ቃላ ይንትስ ኦድታታር የኤዝ ዎደ ዶና ቢላሞትራኔ ኤጨትር የኤካያ።"]},{"type":"verse","number":2,"content":["ታኒ ይንታር የዛ ዎደ ማዝቃለል አፋ ሶትንቴዝ የሱስ ክርስቶሳፕ አትን ሀራ ባዝ ኤራም ግ ታ ሙርቴዛ።"]},{"type":"verse","number":3,"content":["ታ ይንታር የዝ ዎደ ዳቡራር፥ ያሻራኔ ኩኩርሳር የዛ።"]},{"type":"verse","number":4,"content":["ታ ኪታኔ ታ ትምርታ ዶና ቢላሞትራኔ ኤጨትር ባዝን ጌሻ አያና ዎልቃ ቆንጭስራ።"]},{"type":"verse","number":5,"content":["የይካ፥ ይ አማናይ ጾሳ ዎልቃይራፕ አትን አስ ኤጨትል ካታማይ ጋርከሲ።"]},{"type":"heading","content":["ጾስ ኤጨት"]},{"type":"verse","number":6,"content":["አያና ደኦር ድጬዝታይስ ኑኒ ኤጨት ቃላር ኦድዛ። ዝን Ꮊ ኤጨትይ፥ Ꮊ ሳአ ኤጨት ዎይ ቦስ የዝ Ꮊ ሳአ ሀርዝታይ ኤጨት ባያ።"]},{"type":"verse","number":7,"content":["ዝን ኑኒ ኦድዛ ኤጨትይ፥ ጋመ ዎደፕ ቲና ጾሳይ ኑ ቦንቻይስ ጊግሴዛኔ ጌማ የዝ ጹራ ኤጨት።"]},{"type":"verse","number":8,"content":["Ꮊ ሳአ ሀርዝታይፕ ፐታካ Ꮊ ኤጨት ኤረካያ። ኡንቲ ኤሬዝባዝ ማቄዛኮ፥ ቦንቾ ጎዳ ማዝቃለል አፋ ሶታምዝን።"]},{"type":"verse","number":9,"content":["ዝን ጌሻ ማጻፋይድ፥",{"text":"«ኣፈ በኤካ ባዝ፥","poem":1},{"text":"ሀየ ስኤካባዝ፥","poem":2},{"lineBreak":true},{"text":"ዎዝና ቆፐካባዝ፥","poem":2},{"lineBreak":true},{"text":"ጾሳይ ፋ ዶስዝታይስ ጊግሴዛ» ዬግዛ።","poem":2}]},{"type":"verse","number":10,"content":["ጾሳይ ፋ ጹራ ፋ አያና ባጋር ኑስ ቆንጭሴዛ። ጌሻ አያናይ ሀራ አቶዝን ጌሜዝ ጾስ ጹራ ኡባ ፕላግዛ።"]},{"type":"verse","number":11,"content":["አስ ጋንጨ የዝ አስ አያናፕ አትን አስባዝ ኦካ ኤሮያ። የይ ጋርከካ፥ ጾስ ባዝ ጾስ አያናፕ አትን ኦካ ኤሮያ።"]},{"type":"verse","number":12,"content":["ጾሳይ ኑስ ጨረ እንጌዝባዝ ኑ ኤሮዳይ ጋርክ ጾሳ አያና ኤኬዛፕ አትን Ꮊ ሳአ አያና ኤከካያ።"]},{"type":"verse","number":13,"content":["ኑኒ አያና ባዝ፥ አያና አሳይስ አስ ኤጨትር ባዝን ጾስ አያናይ እንግዛ ኤጨትር ታማርስዛ።"]},{"type":"verse","number":14,"content":["ዝን ጌሻ አያና ባ አስ ጾስ አያና እሞትታ ኤካሚ። የይ ኤስ ቦዘት፤ ኡባይ ጌሻ አያናር ፕላግንትዝ ግሾስ ኤ ኤሮዳይስ ዳንዳኦያ።"]},{"type":"verse","number":15,"content":["ዝን ጌሻ አያና የዝ አሲ ኡባ ባዝ ፕላግዛ፥ ዝን ኤዛ ኦካ ፕላጎያ።"]},{"type":"verse","number":16,"content":["ጌሻ ማጻፋይድ፥",{"text":"«ጎዳ ዎዝና ኤርዛይ ኦኖ?","poem":1},{"text":"ኤዛ ዞሮዳይስ ዳንዳእዛይ ኦኖ?»","poem":2},"ግንትንቲ ጻፍንቴዛይ ጋርከ። ኑስ ክርስቶሳ ዎዝና የዛ።"]}],"footnotes":[]},"thisChapterLink":"/api/mfx_ewf/1CO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mfx_ewf/1CO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mfx_ewf/1CO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}