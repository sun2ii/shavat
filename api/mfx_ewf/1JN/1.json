{"translation":{"id":"mfx_ewf","name":"ኦሮꬅ ጫቆ","website":"https://ebible.org/Scriptures/details.php?id=mfxe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mfxe","licenseNotes":null,"shortName":"EWF","englishName":"Melo NT Ethiopic","language":"mfx","textDirection":"ltr","sha256":"7ef31996970f101d638bc8a4c9ce01f9f3641bfad44b337f615b8a5768dc3197","availableFormats":["json"],"listOfBooksApiLink":"/api/mfx_ewf/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7938,"languageName":"Melo","languageEnglishName":"Melo"},"book":{"id":"1JN","translationId":"mfx_ewf","name":"1ዋንሳ","commonName":"1ዋንሳ","title":"ዋንሳ ጻፌዝ ቲና ኪታ","order":62,"numberOfChapters":5,"sha256":"9df267358c02dea37526d8e748d1308da0168a21ec25e788c970c2e95a83e67f","firstChapterNumber":1,"firstChapterApiLink":"/api/mfx_ewf/1JN/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/mfx_ewf/1JN/5.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"heading","content":["ደኦ ቃላ"]},{"type":"verse","number":1,"content":["ቲናፕ አይኪ የዝ፥ ደኦ ቃላይ ባጋ ኑ ይንትስ ጻፍዛ። Ꮊ ደኦ ቃላይ ኑ ኑ ሀየር ስኤዝ፥ ኑ ኣፈር በኤዝ፥ ኑ ኩሸር አይኬዛያ።"]},{"type":"verse","number":2,"content":["የ ደኦ እንግዛይ ቆንጭን፥ ኑኒ ኤዛ ብኢ፥ ኤባዝ ማርካትዛ። አዳይ ካለ የዛይ ኑስ ቆንጬዝ፥ መና ደኦባጋ ይንትስ ኦዶዳ።"]},{"type":"verse","number":3,"content":["ኑራ ይንትስ ፐትፐት የዞዳይ ጋርክ ኑኒ በኤዛናኔ ስኤዛና ይንትስ ኦዶዳ። ኑ ፐትፐትይ አዳይራኔ ኤ ናአ የሱስ ክርስቶሳር ዎላ።"]},{"type":"verse","number":4,"content":["ኑ ኡፋይሳይ ፎሎ ማቆዳይ ጋርክ Ꮊያ ይንትስ ኑ ጻፎዳ።"]},{"type":"heading","content":["ጾስ ፖኦ"]},{"type":"verse","number":5,"content":["ኑኒ ኤፕ ስኢ፥ ይንትስ ኦድዛ ኪታይ፦ «ጾሲ ፖኦ፤ ኤዛር ማ የሻ ባያ» ዬግዛያ።"]},{"type":"verse","number":6,"content":["ኑስ ኤዛር ፐትፐተ የዛ ዬግታር ኑ ማ የዝኮ፥ ኑኒ ዎርዶትዛ። ቱማካ ኑር ባያ።"]},{"type":"verse","number":7,"content":["ዝን ኤ ፖኦ የዛይ ጋርክ፥ ኑካ ፖኦ የዝኮ፥ ኑስ ዎል ጋንጨ ፐትፐተ የዛ። ኤ ናአ፥ የሱሳ ሱይ ናጋራ ኡባይፕ ኑና ጌሽዛ።"]},{"type":"verse","number":8,"content":["ኑኒ፥ ኑር ናጋራ ባያ ጊኮ ኑ ኑና ዶሽዛ፤ ኑር ቱማትካ ባያ።"]},{"type":"verse","number":9,"content":["ዝን ጾሳይስ ኑ ናጋራ ቡጽኮ፥ ኤ ኑ ናጋራ አቶ ጎዳይስኔ ኑ ቆሆ ኦሶ ኡባይፕ ኑና ጌሾዳይስ፥ አማንንቴዛያኔ ጌሻ።"]},{"type":"verse","number":10,"content":["ኑኒ ናጋራ ኦካ ጊኮ ጾሳና ዎርዶ ከስዛ፤ ኤ ቃላይካ ኑር ባያ።"]}],"footnotes":[]},"thisChapterLink":"/api/mfx_ewf/1JN/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mfx_ewf/1JN/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mfx_ewf/2PE/3.json","previousChapterAudioLinks":{},"numberOfVerses":10}