{"translation":{"id":"mfx_ewf","name":"ኦሮꬅ ጫቆ","website":"https://ebible.org/Scriptures/details.php?id=mfxe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mfxe","licenseNotes":null,"shortName":"EWF","englishName":"Melo NT Ethiopic","language":"mfx","textDirection":"ltr","sha256":"7ef31996970f101d638bc8a4c9ce01f9f3641bfad44b337f615b8a5768dc3197","availableFormats":["json"],"listOfBooksApiLink":"/api/mfx_ewf/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7938,"languageName":"Melo","languageEnglishName":"Melo"},"book":{"id":"1TI","translationId":"mfx_ewf","name":"1ጽማቶሳስ","commonName":"1ጽማቶሳስ","title":"ጳዉሎሳ ጽማቶሳስ ጻፌዝ ቲና ኪታ","order":54,"numberOfChapters":6,"sha256":"0e2cddbad80f0a8b532dea7d13e7fbdf9cf1efccf8122cb327bf79858ae1492d","firstChapterNumber":1,"firstChapterApiLink":"/api/mfx_ewf/1TI/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/mfx_ewf/1TI/6.json","totalNumberOfVerses":113},"chapter":{"number":3,"content":[{"type":"heading","content":["ዎሳ ኬ ጭምታ"]},{"type":"verse","number":1,"content":["ኦንካ፥ «ዎሳ ኬ ካልዛ አስ ማቆዳይስ ኮይኮ ሎኦ ባዝ አሞትዛ» ግዝ ኦዳይ ቱማ።"]},{"type":"verse","number":2,"content":["ዎሳ ኬ ካልዛ አስ ቦርንቶዋዛ፥ ፐቲ ማቾ ኣዳ ኤኬዛያ፥ ማራር የዛያ፥ ፋና ሃርዛያ፥ ቤዝዛይ ጋርክ ኦዛያ፥ እማ ሞክዛያ፥ ታማርሶ ዳንዳእዛያ፥"]},{"type":"verse","number":3,"content":["ማዋዛ፥ ዋላሶዋዛ፥ ፓላሞዋዛ፥ ሃዮ፥ ሚሸ ሲቆዋዛ፥"]},{"type":"verse","number":4,"content":["ኤ ናእታይ ኤስ ኪትንትዛኔ ቦንችዝታያ፥ ፋ ካራ አሳ አቅሶ ዳንዳእዛያ ማቆዳይስ ቤዝዛ።"]},{"type":"verse","number":5,"content":["ፐቲ አስ ፋ ካራ አቅሶዳይስ ዳንዳኣም እጽኮ፥ ጾስ ዎሳ ኬ ዋይዚ አቅሶዳይስ ዳንዳኤ?"]},{"type":"verse","number":6,"content":["ኡትራር ኩሚ፥ ዳቡሎሳ ፕርድንቴዛይ ጋርክ ፕርድንታማይ ጋርክ፥ ሀጋ አማኔዝ አስ ማቆዳይስ ቤዞዋ።"]},{"type":"verse","number":7,"content":["ቦርንታማይ ጋርከኔ ጻላሄ ጽኬ ጋንጨ ገላማይ ጋርክ የ አይ አማኖዋ አስ ካለ ሎኦ ማርካት የዛ አስ ማቆዳይስ ቤዝዛ።"]},{"type":"heading","content":["ዎሳ ኬ ዳቆንታ"]},{"type":"verse","number":8,"content":["የይ ጋርከካ ማ ዎሳ ኬ ዳቆንታይ ቦንችንቴዝታ፥ ናምኢ እንጻርስ ኦድንቶዋዝታ፥ ማስዝ ኡሽ ኡዦዝታ፥ ሚሸ ዶሶዝታ፥"]},{"type":"verse","number":9,"content":["አማኖ ጹራ ጌሻ ካሃር ናግዝታ ማቆዳይስ ቤዝዛ።"]},{"type":"verse","number":10,"content":["ኡንቲ ቲናቲ ፓጭንቶዳይስ ኮሽዛ፤ ኡንታል አፋ ቦረ ባዝታ ማቅኮ፥ ዎሳ ኬ ዳቆነ ማቂ ኦ።"]},{"type":"verse","number":11,"content":["የይ ጋርከካ፥ ማችታይ ቦንችንቴዝታ፥ ዝግሮዝታ፥ ማራር የዝታ፥ ኡባ ባዛር አማንንትዝታ ማቆዳይስ ቤዝዛ።"]},{"type":"verse","number":12,"content":["ዎሳ ኬ ዳቆንታይ ፐቲ ማቻ ኣዳ የዛ ማቆ። ፋ ናእታኔ ፋ ካራ ሎእ አቅስዝታያ ማቆዳይስ ቤዝዛ።"]},{"type":"verse","number":13,"content":["ዎሳ ኬ ዳቆነ ማቂ፥ ሎኦ ኦሶ ኦዝታይስ፥ ኡንትስ ግታ ቦንቾ ቤዝዛ ማ ክርስቶሳ የሱሳል ፓስ የዝ አማኖ ባጋ ኦዶዳይስ ምኖት ደንጎዳ።"]},{"type":"heading","content":["ዳማ ጹራ"]},{"type":"verse","number":14,"content":["ታኒ Ꮊ ኪታ ኔስ ጻፍታር፥ ኤልሲ ኔኮ የኦዳ ግ ኡፋይስ ጋድዛ።"]},{"type":"verse","number":15,"content":["ዝን ታኒ የኤካ ጋምእኮ፥ ጾስ ካራ አሳይ ዋይዚ የዞዳይስ ቤዝዛኮ ኤሮድ ጋርክ Ꮊያ ኔስ ጻፍዛ። ደኦ ጾስ ካራይ ቱማትስ ቱስኔ ባሶ።"]},{"type":"verse","number":16,"content":["ኑ አማኖ ጹራይ ስ ባይ ግታ።",{"text":"ክርስቶሳ አስ ማቂ በንቴዛ፤","poem":1},{"text":"ኤ ቱማት ጌሻ አያናይ ማርካቴዛ።","poem":2},{"text":"ኪታንቾስ በንቴዛ፤","poem":1},{"text":"ኤ ካተትይ ኡባይስ ሳባክንቴዛ።","poem":2},{"text":"አላመል የዝ አሳይር አማንንቴዛ፤","poem":1},{"text":"ቦንቾር ሳሎ ኤክንቴዛ።","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mfx_ewf/1TI/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mfx_ewf/1TI/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mfx_ewf/1TI/2.json","previousChapterAudioLinks":{},"numberOfVerses":16}