{"translation":{"id":"mfx_ewf","name":"ኦሮꬅ ጫቆ","website":"https://ebible.org/Scriptures/details.php?id=mfxe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mfxe","licenseNotes":null,"shortName":"EWF","englishName":"Melo NT Ethiopic","language":"mfx","textDirection":"ltr","sha256":"7ef31996970f101d638bc8a4c9ce01f9f3641bfad44b337f615b8a5768dc3197","availableFormats":["json"],"listOfBooksApiLink":"/api/mfx_ewf/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7938,"languageName":"Melo","languageEnglishName":"Melo"},"book":{"id":"HEB","translationId":"mfx_ewf","name":"እብራወ","commonName":"እብራወ","title":"እብራወ አሳይስ ጻፍንቴዝ ኪታ","order":58,"numberOfChapters":13,"sha256":"7f47fd1a8c6ca7cb3ccf8a1f8a173b170697d293fc6f406c1012d9f76f8a8387","firstChapterNumber":1,"firstChapterApiLink":"/api/mfx_ewf/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/mfx_ewf/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["ናአይ ኪታንችታይፕ ኣ"]},{"type":"verse","number":1,"content":["ብኒ ብንኮ ጾስ፥ ኑ አድታይስ ናብታይ ባጋር ዱማ ዱማ ኦገር ጋመ ዎደ ኦዴዛ።"]},{"type":"verse","number":2,"content":["ዝን Ꮊ ዉርስ ዎደ ኡባ ባዝ ኤዛ ላትሴዝ፥ ማ አላማካ ኤ ባጋር መዝ ፋ ናአይ ባጋር ኑስ ኦዴዛ።"]},{"type":"verse","number":3,"content":["ናአይ ጾስ ቦንቾ ፖጭኔ ሀናይር ሙመር ጾስ ኣዚ ኩን ጾስ ጾሳት ኤኪ፥ ፋ ማዉተ ቃላይር Ꮊ አላማ ሚን አይኬዛ። አሳ ኡ ናጋራይፕ ሻግሼዛይፕ ጉየ ኡባፕ አፋ ጾስ ኡሻች ሳሎ በቴዛ።"]},{"type":"verse","number":4,"content":["ኤስ እንግንቴዝ ሱንይ ኪታንችታይ ሱንይፕ ኣ ማቄዛይ ጋርክ ኤ ኡንታፕ ሎእ ኣዝ ግሾሲ።"]},{"type":"verse","number":5,"content":["ይኬ፥ ጾስ ኪታንችታይፕ ኦኮ፥",{"text":"«ኔኒ ታ ናአ፤","poem":1},{"text":"ታ Ꮊይኖ ኔስ አደ ማቄዛ» ዬጌኔ?","poem":2},"ዎይ ኦኮ፥",{"text":"«ታኒ ኤስ አደ ማቆዳ፤","poem":1},{"text":"ኤካ ታስ ናአ ማቆዳ» ዬጌኔ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ማ ጾሲ ፋ ባይራ ናአ Ꮊ አላመ ኪትታር፥","poem":1},{"lineBreak":true},{"text":"«ጾስ ኪታንችታይ ኡባይ ኤስ ጎይኖ»","poem":1},"ዬጌዛ።"]},{"type":"verse","number":7,"content":["ጾስ ኪታንችታይ ባጋ ኦድታር፥",{"text":"«ጾሲ ፋ ኪታንችታ ጫርክታ፥","poem":1},{"text":"ፋ አይልታ ታማ ላ ኡድዛ»","poem":2},"ዬግዛ።"]},{"type":"verse","number":8,"content":["ዝን ፋ ናአይ ባጋ ኦድታር፥",{"text":"«ጾሶ፥ ነ ካተትይ መናስ የዝዛ።","poem":1},{"text":"ነ ካተት ነ ጽሎትር አቅሶዳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኔኒ ጽሎት ዶሴዛ፤ ኢታት እጼዛ።","poem":1},{"text":"ጾሳይ፥ ነ ጎዳይ፥ ነና ነ ዣምታይፕ ኣ ዶሬዛ፥","poem":2},{"lineBreak":true},{"text":"ኡፋይስ ዛይተ","poem":2},{"noteId":0},{"text":"ነና ትዤዛ»","poem":2},"ዬግዛ።"]},{"type":"verse","number":10,"content":["ጾሲ ማሂ፥",{"text":"«ጎዳዮ፥ ቲና ኔኒ ሳአ መዛ፤","poem":1},{"text":"ሳልታይ ነ ኩሸ ኦስታ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"የይትታይ ኡባይ ቦዳ፤","poem":1},{"text":"ዝን ኔኒ የዞዳ።","poem":2},{"lineBreak":true},{"text":"ኡንቲ ኡባይ አፍላ ጋርክ ዉሮዳ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ኔኒ ኡንታን ሳልነ ጋርክ ጻጾዳ፤","poem":1},{"text":"ማ ኡንቲ አፍላ ጋርክ ላምንቶዳ።","poem":2},{"text":"ዝን ኔኒ ኡባ ዎደ ነና፤","poem":1},{"text":"ነ ላይታይስካ ዉርስ ባያ»","poem":2},"ዬግዛ።"]},{"type":"verse","number":13,"content":["ዝን ጾሲ ኪታንችታይፕ ኦኮ፥",{"text":"«ታኒ ነ ሞርክታ ነ ቶካይ","poem":1},{"text":"የዝ አቆ ኡዶድ ሄሎዳይስ፥","poem":2},{"lineBreak":true},{"text":"Ꮊይዳ ታፕ ኡሻች ባጋር በቶባ» ዬጌኔ?","poem":2}]},{"type":"verse","number":14,"content":["ኪታንችታይ ኡባይ አቶት ደንጎዳይስ የዝ አስታ ማዶዳይስ ጾስ ኪቴዝ አያንታ ባሳኔ?"]}],"footnotes":[{"noteId":0,"caller":"+","text":"ኡፋይስ ዛይተ፦ ኤ ካዉትዛ ዎደ አሳይ ኡፋይሳር እልሊ ኤዛ ካዉትስዛ ቤዝዛ።","reference":{"chapter":1,"verse":9}}]},"thisChapterLink":"/api/mfx_ewf/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mfx_ewf/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mfx_ewf/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}