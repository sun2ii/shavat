{"translation":{"id":"mfx_ewf","name":"ኦሮꬅ ጫቆ","website":"https://ebible.org/Scriptures/details.php?id=mfxe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mfxe","licenseNotes":null,"shortName":"EWF","englishName":"Melo NT Ethiopic","language":"mfx","textDirection":"ltr","sha256":"7ef31996970f101d638bc8a4c9ce01f9f3641bfad44b337f615b8a5768dc3197","availableFormats":["json"],"listOfBooksApiLink":"/api/mfx_ewf/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7938,"languageName":"Melo","languageEnglishName":"Melo"},"book":{"id":"HEB","translationId":"mfx_ewf","name":"እብራወ","commonName":"እብራወ","title":"እብራወ አሳይስ ጻፍንቴዝ ኪታ","order":58,"numberOfChapters":13,"sha256":"7f47fd1a8c6ca7cb3ccf8a1f8a173b170697d293fc6f406c1012d9f76f8a8387","firstChapterNumber":1,"firstChapterApiLink":"/api/mfx_ewf/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/mfx_ewf/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":3,"content":[{"type":"heading","content":["የሱሳ ሙሰፕ ኣዛ"]},{"type":"verse","number":1,"content":["የይ ግሾስ፥ ጾስ ጼስ ሻግንቴዝ ጌሽ እሹን፥ ኑ አማኖስ ጎዳ ግ ጼግዝ ሀዋረኔ ቄሰ ሀላቃ የሱሳ ቦኦይታ።"]},{"type":"verse","number":2,"content":["ሙሰ ጾስ ካራ ኡባይድ አማንንቴዛይ ጋርክ የሱሳካ ፋና ሹሜዝ ጾሳይስ አማንንቴዛያ።"]},{"type":"verse","number":3,"content":["ኬ ኬጽዛይ ኬይፕ ኣ ቦንችንትዛይ ጋርክ የሱሳ ሙሰፕ ኣዝ ቦንቾ ኤኮዳይስ ቤዝዛ።"]},{"type":"verse","number":4,"content":["ፐቲ ፐቲ ኬስ ኬጼዝ አሲ የዛ፥ ዝን ኡባ ሀንሴዛይ ጾሰ።"]},{"type":"verse","number":5,"content":["ሙሰ ጾስ ካራ ኡባይድ አማንንቴዝ አይለ ማቂ፥ ጾሲ ቲናፕ ጎድባዛይስ ማርካ ማቄዛ።"]},{"type":"verse","number":6,"content":["ዝን ክርስቶሳ ጾስስ ናአ ጋርክ አማንንቴዛያ። ኑኒ ኤኮዳ ግ ያሻ ባይ ጬቆር ናግዛ ኡፋይሳ ሚን ናግኮ ኑ ኤ ካራ።"]},{"type":"heading","content":["ጾስ ዎያስ የዝ ሸምፖ"]},{"type":"verse","number":7,"content":["የይ ግሾስ፥ ጌሻ አያናይ ግዛይ ጋርክ፥",{"text":"«Ꮊይኖ ይ ጾሳይ ግዛ ስእኮ","poem":1}]},{"type":"verse","number":8,"content":[{"text":"ሊዦ ቢታ ይ ታና ፓጬዝ ጋላስ፥","poem":2},{"lineBreak":true},{"text":"ይ ዎርዣቴዛይ ጋርክ፥","poem":2},{"lineBreak":true},{"text":"ይ ዎዝና ምንፓተ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ኤዛይድ ይ አድታይ ታና ፓጬዛ፤","poem":1},{"text":"ኦይታም ላይ ታ ኦሳ በኤዛ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"የይ ግሾስ፥ ታ የ የለት ሴሬዛ፥","poem":1},{"text":"‹ኡንቲ ኡባ ዎደ ፋ ዎዛናይር ባልንትዛ፤","poem":2},{"lineBreak":true},{"text":"ታ ኦጋ ኤረካያ› ታ ዬጌዛ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"የይ ግሾስ፥","poem":1},{"text":"‹ታ ሸምፖ አቃ ኡባራካ ገላሚ› ዬጊ፥","poem":2},{"lineBreak":true},{"text":"ታኒ ታ ሴራይድ ጫቄዛ፥ ዬጌዛ» ዬግዛ።","poem":2}]},{"type":"verse","number":12,"content":["ታ እሹን፥ ይንትፕ ኦ ጋንጨካ፥ ደኦ ጾሳይፕ ይንታን ሻክዛ ኢታኔ አማኖዋ ዎዝና የዛማይ ጋርክ ናግንቶይታ።"]},{"type":"verse","number":13,"content":["ይንትፕ ኦናካ ናጋራ ባልን፥ ፋ ዎዝና ምንማይ ጋርክ «Ꮊይኖ» ዬግንቲ ጼግንቶዳር ጋላስ ጋላስ ዎልር ዞርንቶይታ።"]},{"type":"verse","number":14,"content":["ኑ ቲና አማና ኑኒ ዉርስ ሄሎዳይስ ሚን ናግኮ፥ ክርስቶሳር ፐትፕ ላቶዳ።"]},{"type":"verse","number":15,"content":["ጌሻ ማጻፋይድ፥",{"text":"«Ꮊይኖ ጾስ ግዛ ይ ስእዝ ዎደ","poem":1},{"text":"የ ዎደ ኡንቲ ዎርዠትር ሀኔዛይ ጋርክ፥","poem":2},{"lineBreak":true},{"text":"ይ ዎዝና ሚንፓተ»","poem":2},"ዬጌዛ።"]},{"type":"verse","number":16,"content":["ጾስ ግዝባዝ ስኢ ዎርዠቴዝታይ ኦናንታራ? ሙሰ ግብጸፕ ካል ከሴዝ ኡብታ ባሳኔ?"]},{"type":"verse","number":17,"content":["ጾስ ኦይታም ላይ ኦና ሴሬኔ? ናጋራ ኦዝታኔ ኡ አሃይ ሊዦ ቢታ ዎ አቴዝ አስታ ባሳኔ?"]},{"type":"verse","number":18,"content":["ማ ጾስ፥ «ታ ሸምፖ አቃ ኡ ገላሚ» ዬጊ ጫቄዛይ፥ ኤስ ኪትንታም እጼዝ አሳይሳፕ አትን ኦሶ?"]},{"type":"verse","number":19,"content":["ይኬ፥ ኡንቲ የ ሸምፖ አቃ ገለካ አቴዛይ አማነካ ግሾስ ማቄዛና ኑ ቦኦዳ።"]}],"footnotes":[]},"thisChapterLink":"/api/mfx_ewf/HEB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mfx_ewf/HEB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mfx_ewf/HEB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}