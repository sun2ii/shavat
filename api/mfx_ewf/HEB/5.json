{"translation":{"id":"mfx_ewf","name":"ኦሮꬅ ጫቆ","website":"https://ebible.org/Scriptures/details.php?id=mfxe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mfxe","licenseNotes":null,"shortName":"EWF","englishName":"Melo NT Ethiopic","language":"mfx","textDirection":"ltr","sha256":"7ef31996970f101d638bc8a4c9ce01f9f3641bfad44b337f615b8a5768dc3197","availableFormats":["json"],"listOfBooksApiLink":"/api/mfx_ewf/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7938,"languageName":"Melo","languageEnglishName":"Melo"},"book":{"id":"HEB","translationId":"mfx_ewf","name":"እብራወ","commonName":"እብራወ","title":"እብራወ አሳይስ ጻፍንቴዝ ኪታ","order":58,"numberOfChapters":13,"sha256":"7f47fd1a8c6ca7cb3ccf8a1f8a173b170697d293fc6f406c1012d9f76f8a8387","firstChapterNumber":1,"firstChapterApiLink":"/api/mfx_ewf/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/mfx_ewf/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":["ፐቲ ፐቲ ቄስታይ ሀላቃ አሳይ ጋንጨፕ ማራጽንቲ፥ ጾሳር ሄልዛ ባዛ አሳይ ግሾስ እሞታራኔ ናጋራ ያርሾ ያርሾዳይስ ሹምንትዛ።"]},{"type":"verse","number":2,"content":["ኤ ፋ ኦማስ ዳቡራ ማቄዝ ግሾስ ኤሮዝታይስኔ ባልንትዝታይስ ቃንቶዳይስ ዳንዳእዛ።"]},{"type":"verse","number":3,"content":["ኤ ፋ ናጋራ ግሾኔ አስ ኡባ ናጋራ ግሾስ ያርሾ ያርሾዳይስ ቤዝዛይ የይሲ።"]},{"type":"verse","number":4,"content":["ኦንካ Ꮊ ቦንቻ ፓስ ኤኮዳይስ ዳንዳኦዋ፥ ዝን ኣሮና ቄስታይ ሀላቃ ማቆዳይስ ጼግንቴዛይ ጋርክ ጾሳር ጼግንቶዳይስ ቤዝዛ።"]},{"type":"verse","number":5,"content":["የይ ጋርከካ፥ ክርስቶሳ ቄስታይ ሀላቃ ማቅ ቦንቻ ታስ ቤዝዛ ግ ፋ ኦማስ ኤከካያ። ዝን ጾሲ ኤዛ፥",{"text":"«ኔኒ ታ ናአ።","poem":1},{"text":"Ꮊይኖ ነና ታ የሌዛ» ኤኮ","poem":2},"ዬግዛ።"]},{"type":"verse","number":6,"content":["ማ ሀራ አቆ፥",{"text":"«ማልከጻድቀ ቄሰ ማቄዛይ ጋርክ፥","poem":1},{"text":"ኔኒ መናስ ቄሰ ማቆዳ»","poem":2},"ዬግዛ።"]},{"type":"verse","number":7,"content":["የሱሳ አስ ማቂ Ꮊ አላመል የዝ ዎደ ፋና Ꮊይቆፐ አሾዳይስ ዳንዳእዛ ጾሳ ጋመ ዬፎራኔ አፉር ዎሴዛ። ኤ፥ ኤዛ ቦንቺ ኪትንቴዝ ግሾስ ጾስ ኤ ዎሳ ስኤዛ።"]},{"type":"verse","number":8,"content":["የሱሳ ጾስ ናአ ማቅኮካ ፋ ዋይንቴዝ ዋያይድ ኪትንታ ታማሬዛ።"]},{"type":"verse","number":9,"content":["የይዳካ፥ የሱሳ ፎሎ ማቄዛይፕ ጉየ ፓስ ኪትንትዛ ኡባይ መና አቶት ደንጎዳይ ጋርክ ኦገ ማቄዛ።"]},{"type":"verse","number":10,"content":["ጾስ ማልከጻድቀ ቄሰትስ ሹሜዛይ ጋርክ ቄስታይ ሀላቃ ኡዲ ኤዛ ሹሜዛ።"]},{"type":"heading","content":["አማኖር ድጮዳይ ጋርክ እንግንቴዝ ናግሶ"]},{"type":"verse","number":11,"content":["ያ ኑ ኦዳይል አፋ ጉጂ ናሾድ ጋመ ባዝ የዛ፥ ዝን ይ አካካይ ጽቃ ማቄዝ ግሾስ ይንትስ ኦዲ ገልሶዳይ ዋይዛ።"]},{"type":"verse","number":12,"content":["ይ Ꮊኖንተ አስታማረ ማቆዳይስ ቤዝዛ፥ ዝን ጾስ ቃላ ቲና ትምርታ ይንታን ማሂ ታማርስዛ ሀራ አስ ኮሽዛ። ይ ምኖ ካ ማዳይስ ዳንዳኦዛይ ግሾስ ማ ኮሽዛ።"]},{"type":"verse","number":13,"content":["ማ ፓክንትዛ ኦንካ ዱደ ናአ ማቄዝ ግሾስ ሎኦኔ ኢታ ሻኪ ኤሮያ።"]},{"type":"verse","number":14,"content":["ዝን ምኖ ካ ሎኦኔ ኢታ ሻኪ ኤሮር ሎሄዝ አሳይሲ።"]}],"footnotes":[]},"thisChapterLink":"/api/mfx_ewf/HEB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mfx_ewf/HEB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mfx_ewf/HEB/4.json","previousChapterAudioLinks":{},"numberOfVerses":14}