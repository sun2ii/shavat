{"translation":{"id":"mfx_ewf","name":"ኦሮꬅ ጫቆ","website":"https://ebible.org/Scriptures/details.php?id=mfxe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mfxe","licenseNotes":null,"shortName":"EWF","englishName":"Melo NT Ethiopic","language":"mfx","textDirection":"ltr","sha256":"7ef31996970f101d638bc8a4c9ce01f9f3641bfad44b337f615b8a5768dc3197","availableFormats":["json"],"listOfBooksApiLink":"/api/mfx_ewf/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7938,"languageName":"Melo","languageEnglishName":"Melo"},"book":{"id":"HEB","translationId":"mfx_ewf","name":"እብራወ","commonName":"እብራወ","title":"እብራወ አሳይስ ጻፍንቴዝ ኪታ","order":58,"numberOfChapters":13,"sha256":"7f47fd1a8c6ca7cb3ccf8a1f8a173b170697d293fc6f406c1012d9f76f8a8387","firstChapterNumber":1,"firstChapterApiLink":"/api/mfx_ewf/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/mfx_ewf/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":8,"content":[{"type":"heading","content":["የሱሳ ኦሮ ጫቆ ቄስታይ ሀላቃ"]},{"type":"verse","number":1,"content":["ኑኒ ኦዴዝ ባዛይፕ ኣፈ ቆፋይ የያ። ሳሎ ኡባፕ አፋ ጾስ ዙፋናይፕ ኡሻች ባጋ በቴዝ Ꮊይ ጋርክ ቄሰ ሀላቃይ ኑስ የዛ።"]},{"type":"verse","number":2,"content":["ኤ ኦዛይ ቱማ ዱንካነ ማቄዝ ጌሽ አቆ፥ የ ዱንካናት ቱክንቴዛና አስ ኩሸር ባዝን ጎዳይ ኩሸራ።"]},{"type":"verse","number":3,"content":["ቄሰ ሀላቃ ኡባይ ሙጻታስኔ ያርሾ ያርሾዳይስ ሹምንትዛ። የይ ግሾስ፥ Ꮊ ቄሳይ ያርሾዳይስ ፐትባዚ የዞዳይስ ኮሽዛ።"]},{"type":"verse","number":4,"content":["ህገ ኪትዛይ ጋርክ ያርሽዛ ቄስታይ የዝ ግሾስ ክርስቶሳ ሳአ የዛ ባዝ ማቄዛኮ ቄሰ ባያ።"]},{"type":"verse","number":5,"content":["ኡንቲ ቄሰት ኦዛ ዱንካናይ ሳሎ የዛይስ ኣዝሶኔ ኤሾ። ሙሰ ዱንካና ኤስዛ ዎደ ጾሲ ኤኮ፥ «ታኒ ነና ደረል አፋ ቤዜዝ ኣዝሳ ካሊ ናግንቶር ኦባ» ዬጌዛ።"]},{"type":"verse","number":6,"content":["Ꮊት ማቅኮ የሱሳ ጋንጨ ገሊ ዳቦዛ ቃላ ጫቃይ፥ ቲና ቃላ ጫቃይፕ ኣዛይ ግሾስ ኤ ኤኬዝ ኦሳይ ኡንቲሳይፕ ኣዛ። የይ ኤቄዛይ ኣዝ ኡፋይስ ቃላይዳ።"]},{"type":"verse","number":7,"content":["ቲና ቃላ ጫቃይድ ቦሮ ባ ማቄዛኮ ናምእን ቃላ ጫቆ ኮሾያ።"]},{"type":"verse","number":8,"content":["ዝን ጎዳይ ኤዛ ቦሪ፥ Ꮊይ ጋርክ ዬጌዛ፦",{"text":"«ታኒ እስሬለ አሳይራኔ ይሁዳ አሳይራ","poem":1},{"text":"ኦሮ ቃላ ጫቆ ጫቂዛ ዎደ የኦዳ።","poem":2}]},{"type":"verse","number":9,"content":[{"text":"የ ቃላ ጫቃይ ታ ኡ አድታይ ግብጸ ቢታፕ ኩሸ አይኪ፥","poem":1},{"text":"ጎቺ ከሴዝ ዎደ ኡንታር ጫቄዝ ጫቃይ ጋርክ ባያ።","poem":2},{"text":"ጎዳይ ኡንቲ ታ ጫቃይድ አማንንተካዛይ ግሾስ","poem":1},{"text":"ታኒ ኡንታን ኦሊ አሼዛ ዬግዛ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ዝን ይከፕ ጉየ እስሬለ አሳይራ","poem":1},{"text":"ታ ጫቆድ ጫቃይ Ꮊያ ዬግዛ ጎዳይ።","poem":2},{"text":"ታኒ ታ ህጋ ኡ ካሃይድ ጋዶዳ፤","poem":1},{"text":"ኡ ዎዝናይዳካ ጻፎዳ።","poem":2},{"text":"ታኒ ኡ ጾሳ ማቆዳ፤","poem":1},{"text":"ኡንትካ ታ ወያ ማቆዳ።","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ኡንታፕ ኦንካ ፋ ሾራ ዎይ ፋ እሻ፥","poem":1},{"text":"‹ጎዳ ኤሮባ› ዬጊ ታማርሳሚ።","poem":2},{"text":"ኡንቲ ጽቃፕ ዳማ ሄሎዳይስ","poem":1},{"text":"ኡባይ ታና ኤሮዳ።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ታኒ ኡ ናቃ አቶ ጎዳ፤","poem":1},{"text":"ኡ ቆሃ ማሂ ቆፓሚ»","poem":2},"ዬግዛ።"]},{"type":"verse","number":13,"content":["ጾሲ Ꮊ ጫቃ «ኦሮ ቃላ ጫቆ» ጉሳይ ቲናሳ ጭማ ማሄዛ። ይኬ፥ ጭማይኔ ጬጋይ ብዛ ዎደ ሄሌዛ።"]}],"footnotes":[]},"thisChapterLink":"/api/mfx_ewf/HEB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mfx_ewf/HEB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mfx_ewf/HEB/7.json","previousChapterAudioLinks":{},"numberOfVerses":13}