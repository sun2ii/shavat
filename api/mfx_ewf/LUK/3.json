{"translation":{"id":"mfx_ewf","name":"ኦሮꬅ ጫቆ","website":"https://ebible.org/Scriptures/details.php?id=mfxe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mfxe","licenseNotes":null,"shortName":"EWF","englishName":"Melo NT Ethiopic","language":"mfx","textDirection":"ltr","sha256":"7ef31996970f101d638bc8a4c9ce01f9f3641bfad44b337f615b8a5768dc3197","availableFormats":["json"],"listOfBooksApiLink":"/api/mfx_ewf/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7938,"languageName":"Melo","languageEnglishName":"Melo"},"book":{"id":"LUK","translationId":"mfx_ewf","name":"ሉቃሳ","commonName":"ሉቃሳ","title":"ሉቃሳ ጻፌዝ የሱስ ክርስቶሳ ዎንግለ","order":42,"numberOfChapters":24,"sha256":"55a0ee79ac36bfdc13937ea9be09daec1be3b9ea163f9a0d287446b503de7325","firstChapterNumber":1,"firstChapterApiLink":"/api/mfx_ewf/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/mfx_ewf/LUK/24.json","totalNumberOfVerses":1146},"chapter":{"number":3,"content":[{"type":"heading","content":["ጻማቅዛ ዋንሳ ስብካተ"]},{"type":"verse","number":1,"content":["ካታይ ጽባሮሳ ኦሮመ ቢታል ካዉትን፥ ታጶ እችን ላይር፥ ጰንጸ ጵላጾሳ ይሁዳ አቅስዛ ላይ ሄሮዶሳ ጋልላ አቅስዛ ላይ ኤ እሻ ፍልጶሳ ኢጹራሳኔ ጽራኮንዶሳ አቅስዛ ዎደ ልሳኖሳ አብላንሳና አቅስዛ ዎደ"]},{"type":"verse","number":2,"content":["ሃናራኔ ቃያፋራ ቄሰ ሀላቃ ማቂ የዝን፥ ጾስ ቃላይ ዛክሬሳ ናአ ዋንሳኮ ሊዦ ጋ የኤዛ።"]},{"type":"verse","number":3,"content":["ዋንሳ፥ «ይ ናጋራይፕ ማቆይታኔ ጻማቅንቶይታ። ጾሳይ ይ ናጋራ አቶ ጎዳ» ዬጊ ታማርስታር ዮርዳኖሳ ቦርካ ሄራ የዝ ቢታ ኡባ Ꮊንጌዛ።"]},{"type":"verse","number":4,"content":["የይካ ናበ ኢስያሳ ፋ ማጻፋይድ፥",{"text":"«ሊዦ ጋ ፋ ቃላ ቅ ኡዲ፥","poem":1},{"text":"ኡክዛ አይ ቃላይ፥","poem":2},{"text":"‹ጎዳይስ ኦገ ሎእይታ፥","poem":1},{"text":"ጎሳካ ፕድ ኡዶይታ።","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ሎጳ ኡቢታይ ኩሞ፥","poem":1},{"text":"አምባይኔ ደራይ ዝቂ ጎ።","poem":2},{"text":"ዎቦ ኦጋይ ሉሎ፥","poem":1},{"text":"ጊገካ ጎሳይ ቅንጺ ጎ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"አሾ ማኤዝ አስ ኡብታይ፥","poem":1},{"text":"ጾሲ አሽዛና ቦኦ› »","poem":2},"ግ ጻፍንቴዛይ ሀኔዛ።"]},{"type":"verse","number":7,"content":["ዋንሳ፥ ኤ ኩሸ ጻማቅንቶዳይስ የኤዝ ጋመ አሳይኮ፥ «ይንታኖ፥ ሾሽ ናኡን የኦዳይስ የዝ ቦቻይፕ ቡቶድ ጋርክ ይንታን ዞሬዛይ ኦኖ?"]},{"type":"verse","number":8,"content":["ይኬ፥ ይ ማቅ ቤዝዛ ሎኦ ኦሶ ኦይታ፥ ይ ዎዝናር፥ ‹ኑስ፥ ኑ አዳይ አፍራመ የዛ ግ ጋይርፓተ።› Ꮊና ስኦይታ፥ Ꮊ ሹችታይፕ ጾሳይ አፍራመስ ናአ ከሶዳይስ ዳንዳእዛ።"]},{"type":"verse","number":9,"content":["ዬዛኮ፥ ጋንደ ምንጻይስ ጻጳይድ የዛ። ይኬ፥ ሎኦ ኣፈ ኣፎዋ ም ኡቢታይ ጋችንቲ ታማ ጋንጨ ዎዳ» ዬጌዛ።"]},{"type":"verse","number":10,"content":["አሳይ፥ «የዝን ኑኒ አብ ኦ?» ዬጊ ኦይጬዛ።"]},{"type":"verse","number":11,"content":["ዋንሳ ማሂ፥ «ናምኢ አፍላ የዛ አሲ ባዛይስ እንጎ። ካ የዛይ ባዛይስ ሻጎ» ዬጌዛ።"]},{"type":"verse","number":12,"content":["ቃራጸ ጋችስዝታይ ጻማቅንቶዳይስ ይኢ፥ «አስታማራዮ፥ ኑ አብ ኡዶ?» ዬጌዛ።"]},{"type":"verse","number":13,"content":["ኤ ማሂ፥ «ይንታን ኪቴዛንፕ ኣ ኤክፓተ» ዬጌዛ።"]},{"type":"verse","number":14,"content":["ማ ዎታዳርታይ ይኢ፥ «ኑ አብ ኡዶ» ዬጊ ኦይጬዛ። ዋንሳ፥ «ኦባዝካ ዎልቃር ዳፍ ኤክፓተ፥ ኦናካ ዎርዶር ሞትፓተ፥ ይ ዳሞዛይ ይንትስ ግዶዳ» ዬጌዛ።"]},{"type":"verse","number":15,"content":["አሳይ ክርስቶሳ ኡፋይሳር ናግታር የዛ ግሾ ዋንሳና፥ «ኤ ክርስቶሳ ማቃደሻ?» ዬጊ ኡ ፋ ዎዝናይድ ቆፕዛ።"]},{"type":"verse","number":16,"content":["ዋንሳ ኡብታይስ ማሂ፥ «ታኒ ይንታን ሃር ጻማቅዛ፥ ዝን ታፕ ኣ ዎልቃምዛይ የኦዳ። ታኒ ኤ ጫማይ ዎዶራ ብሎዳይስ ቤዞዋ አሲ። ኤ ይንታን ጌሻ አያናራኔ ታማር ጻማቆዳ።"]},{"type":"verse","number":17,"content":["ዉዱማ የዝ ካ ጌሾዳይስ ፕይ ኤ ኩሻይድ የዛ። ጌዤዝ ካ ፋ ሻላይድ ቆሎዳ፤ ቡናና ቦዋ ታማር ጹጎዳ» ዬጌዛ።"]},{"type":"verse","number":18,"content":["ማ ዋንሳ አሳ ጋመ ዞረ ዞሪ ዎንግለ",{"noteId":0},"ሳባኬዛ።"]},{"type":"verse","number":19,"content":["ዝን ዋንሳ ሄሮዶሳ ፋ እሻይ ማቻት፥ ሄሮድያዳ፥ ኤኬዝ ግሾኔ ሀራ ኢታ ኦስታ ኦዝ ግሾስ ካጬዝ ዎደ"]},{"type":"verse","number":20,"content":["ሄሮዶሳ ካሰሳይል አፋ ሀራ ኢታ ባዝ ኡባ ጉጂ ዋንሳና ዎይነ ገልሴዛ።"]},{"type":"heading","content":["የሱሳ ጻማቅንቶ"]},{"type":"verse","number":21,"content":["ዎያይ ኡባይ ጻማቅንቴዛይፕ ጉየ፥ የሱሳካ ማ ጻማቅንቴዛ። ኤ ዎሶዳር ሳሎ ዶይንቴዛ፥"]},{"type":"verse","number":22,"content":["ጌሻ አያናይ ሆለ ጋርከ ማቂ ኤዛል አፋ ዎዛ። ሳሎፕ «ታኒ ቃዛ ናአይ ነና፤ ነ ታና ኡፋይስዛ ዬግዝ» ቃላ የኤዛ።"]},{"type":"heading","content":["የሱሳ የለት ጹስ"]},{"type":"verse","number":23,"content":["የሱሳ ታማርሶ አይኮዳር ኤስ ሀስታም ላይ ዝን፥ አሳይ ኤዛ ዮሴፋ ናአ ግ ቆፔዛ።",{"text":"ዮሴፋ ኤለ ናአ፥","poem":1}]},{"type":"verse","number":24,"content":[{"text":"ኤለ ማተ ናአ፥","poem":1},{"lineBreak":true},{"text":"ማተ ለወ ናአ፥ ለወ ምልካ ናአ፥","poem":1},{"lineBreak":true},{"text":"ምልካ ዮና ናአ፥ ዮና ዮሴፋ ናአ፥","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"ዮሴፋ ማታተ ናአ፥ ማታተ አሞጸ ናአ፥","poem":1},{"lineBreak":true},{"text":"አሞጸ ናሆመ ናአ፥ ናሆመ አስሊመ ናአ፥","poem":1},{"lineBreak":true},{"text":"አስሊመ ናገ ናአ፥","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ናገ ማአተ ናአ፥","poem":1},{"lineBreak":true},{"text":"ማአተ ማታትየ ናአ፥ ማታትየ ሳማየ ናአ፥","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ሳማየ ዮሴፋ ናአ፥ ዮሴፋ ዮዳ ናአ፥","poem":1},{"lineBreak":true},{"text":"ዮዳ ዮናነ ናአ፥ ዮናነ ራሰ ናአ፥","poem":1},{"lineBreak":true},{"text":"ራሰ ዘሩባበላ ናአ፥ ዘሩባበላ ሳላትያለ ናአ፥","poem":1},{"lineBreak":true},{"text":"ሳላትያለ ኔራ ናአ፥","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"ኔራ ምልካ ናአ፥","poem":1},{"lineBreak":true},{"text":"ምልካ ሃደ ናአ፥ ሃደ ቆሳመ ናአ፥","poem":1},{"lineBreak":true},{"text":"ቆሳመ ኤልሞዳኔ ናአ፥ ኤልሞዳኔ ኤረ ናአ፥","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"ኤረ ዮሴኤ ናአ፥ ዮሴኤ አላዛራ ናአ፥","poem":1},{"lineBreak":true},{"text":"አላዛረ ዮራመ ናአ፥ ዮራመ ማጻተ ናአ፥","poem":1},{"lineBreak":true},{"text":"ማጻተ ለወ ናአ፥","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"ለወ ስሞነ ናአ፥","poem":1},{"lineBreak":true},{"text":"ስሞና ይሁዳ ናአ፥ ይሁዳ ዮሴፋ ናአ፥","poem":1},{"lineBreak":true},{"text":"ዮሴፋ ዮናነ ናአ፥ ዮናነ ኤልያቀመ ናአ፥","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"ኤልያቀመ ማልየ ናአ፥ ማልየ ማይናነ ናአ፥","poem":1},{"lineBreak":true},{"text":"ማይናነ ማጻተ ናአ፥ ማጻተ ናታነ ናአ፥","poem":1},{"lineBreak":true},{"text":"ናታነ ዳዉተ ናአ፥","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"ዳዉተ ኢሳየ ናአ፥","poem":1},{"lineBreak":true},{"text":"ኢሳየ ኢዮቤደ ናአ፥ ኢዮቤደ ቦኤዛ ናአ፥","poem":1},{"lineBreak":true},{"text":"ቦኤዛ ሳልሞና ናአ፥ ሳልሞና ናአሶና ናአ፥","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"ናአሶና አምናዳባ ናአ፥ አምናዳባ ራመ ናአ፥ ራመ አርና ናአ፥","poem":1},{"lineBreak":true},{"text":"አርነ አስሮመ ናአ፥","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"አስሮመ ፓረሰ ናአ፥","poem":1},{"lineBreak":true},{"text":"ፓረሰ ይሁዳ ናአ፥","poem":1},{"lineBreak":true},{"text":"ይሁዳ ያይቆባ ናአ፥","poem":1},{"lineBreak":true},{"text":"ያይቆባ እሳቃ ናአ፥ ይሳቃ አፍራመ ናአ፥","poem":1},{"lineBreak":true},{"text":"አፍራመ ታር ናአ፥","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"ታር ናኮረ ናአ፥","poem":1},{"lineBreak":true},{"text":"ናኮረ ሳሩገ ናአ፥ ሳሩገ ረሁ ናአ፥","poem":1},{"lineBreak":true},{"text":"ረሁ ፋላቃ ናአ፥ ፋላቃ ኤቤራ ናአ፥","poem":1},{"lineBreak":true},{"text":"ኤቤሮ ሴላ ናአ፥","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"ሴላ ቃይናመ ናአ፥","poem":1},{"lineBreak":true},{"text":"ቃይናመ አርፋክሳዳ ናአ፥ አርፋክሳደ ሴመ ናአ፥","poem":1},{"lineBreak":true},{"text":"ሴመ ኖሄ ናአ፥ ኖሄ ላመ ናአ፥","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"ላመሄ ማቱሳላ ናአ፥ ማቱሳላ እኖኬ ናአ፥","poem":1},{"lineBreak":true},{"text":"ሄኖኬ ያረደ ናአ፥ ያረደ ማላልኤላ ናአ፥","poem":1},{"lineBreak":true},{"text":"ማላልኤላ ቃይናነ ናአ፥","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"ቃይናነ ሄኖሳ ናአ፥","poem":1},{"lineBreak":true},{"text":"ሄኖሰ ሴተ ናአ፥ ሴተ አዳማ ናአ፥","poem":1},{"lineBreak":true},{"text":"አዳማ ጾስ ናአ።","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"ዎንግለ፦ ግርከ ዶናር ዎንግለ ግዝ ቃላይ ጋመ ኡፋይስዛ ኦዳ ዎይ ምሽራቾ ጉሲ። የ ምሽራቻይካ ክርስቶሳ አስ ኮቺ ኡባ መና ፕርደፕ አሾዳይስ ኪትንቲ የኤዝ ጋመ ኡፋይሳ (ሉቃ 1:19፤ 2:10)","reference":{"chapter":3,"verse":18}}]},"thisChapterLink":"/api/mfx_ewf/LUK/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mfx_ewf/LUK/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mfx_ewf/LUK/2.json","previousChapterAudioLinks":{},"numberOfVerses":38}