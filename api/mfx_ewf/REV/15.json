{"translation":{"id":"mfx_ewf","name":"ኦሮꬅ ጫቆ","website":"https://ebible.org/Scriptures/details.php?id=mfxe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mfxe","licenseNotes":null,"shortName":"EWF","englishName":"Melo NT Ethiopic","language":"mfx","textDirection":"ltr","sha256":"7ef31996970f101d638bc8a4c9ce01f9f3641bfad44b337f615b8a5768dc3197","availableFormats":["json"],"listOfBooksApiLink":"/api/mfx_ewf/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7938,"languageName":"Melo","languageEnglishName":"Melo"},"book":{"id":"REV","translationId":"mfx_ewf","name":"ዋንሳ ቆንጭ","commonName":"ዋንሳ ቆንጭ","title":"ዋንሳ ቆንጭይስ","order":66,"numberOfChapters":22,"sha256":"d793c7dc72624f02052c56349e3b78ae510886a9d07e42d3803953092516b55c","firstChapterNumber":1,"firstChapterApiLink":"/api/mfx_ewf/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/mfx_ewf/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":15,"content":[{"type":"heading","content":["ዉርስ ቦሽታ"]},{"type":"verse","number":1,"content":["ታኒ ሳሎል ሀራ ዳማኔ ፓላ ማላባዝ በኤዛ። ጾስ ዉርስ ካች ፖልዛ ላፑን ቦሽታ አይኬዝ ላፑን ኪታንችታ ታ በኤዛ።"]},{"type":"verse","number":2,"content":["የይፕ ጉየ ታማር ዋላክንቴዝ ቡርጩኮ አባ ኣዝዛ ባዝ ታ በኤዛ። የ አባይ ጋጻ ዶአ፥ ኤ ምስላኔ ኤ ሱንይ ታይባ ጋሜዝታ ታ በኤዛ። ጾሲ ኡንትስ እንጌዝ ዲ አይኪ ቡርጩኮ አባል ኤቄዛ።"]},{"type":"verse","number":3,"content":["ኡንቲ ጾስ አይለ ሙሰ ማዝሙራኔ ዱራይ ማዝሙራና Ꮊይ ጋርክ ዬጊ የጼዛ።",{"text":"«ጎዳዮ፥ ኡባፕ ዎልቃማ ጾሳዮ፥","poem":1},{"text":"ነ ኦሳይ ዳማኔ ማላባዚ።","poem":2},{"text":"ዎያ ኡባይስ ካታዮ፥","poem":1},{"text":"ነ ኦጋይ ጽሎኔ ቱማ።","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ጌሺ ነ ኣዳ ማቄዝ ግሾስ","poem":1},{"text":"ጎዳዮ፥ ኔስ ያሽቶዛይኔ","poem":2},{"lineBreak":true},{"text":"ነ ሱን ቦንቾዛይ ኦኖ?","poem":2},{"text":"ነ ጽሎ ኦሳይ አስ ኡባይስ ቆንጨ ማቄዝ ግሾስ ዎያ","poem":1},{"text":"ኡባይ ነ ቲና ይኢ ጎይኖዳ»","poem":2},"ዬጊ የጽዛ።"]},{"type":"verse","number":5,"content":["የይፕ ጉየ፥ ሳሎ ዶይንቲ የዝ ማርካት ዱንካነ ማቄዝ ጾስ ኬ ታ በኤዛ።"]},{"type":"verse","number":6,"content":["ላፑን ቦሽታ አይኬዝ ላፑን ኪታንችታይ ጾስ ኬይፕ ከዜዝ። ኡንቲ ጌሽኔ ፖጭዝ ሊኖ ማኦ ማኤዛ፤ ፋ ትራል ዎርቀ ዳንጮ ዳንጬዛ።"]},{"type":"verse","number":7,"content":["ኦይዲ መትታይፕ ፐታይ፥ መናስ የዝ ጾስ ካቺ ኩሜዝ ላፑን ዎርቃ ጹእታ ላፑን ኪታንችታይስ እንጌዛ።"]},{"type":"verse","number":8,"content":["ጾስ ቦንቻይፐኔ ኤ ዎልቃይፕ ደንዴዛይድ ጾስ ኬይ ጩያር ኩሜዛ። ላፑን ኪታንችታይ አይኬዝ ላፑን ቦሽታይ ፖልንቶድ ሄሎዳይስ ጾስ ካራ ኦንካ ገሎዳይስ ዳንዳኤካያ።"]}],"footnotes":[]},"thisChapterLink":"/api/mfx_ewf/REV/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mfx_ewf/REV/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mfx_ewf/REV/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}