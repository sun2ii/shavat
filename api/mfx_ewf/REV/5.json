{"translation":{"id":"mfx_ewf","name":"ኦሮꬅ ጫቆ","website":"https://ebible.org/Scriptures/details.php?id=mfxe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mfxe","licenseNotes":null,"shortName":"EWF","englishName":"Melo NT Ethiopic","language":"mfx","textDirection":"ltr","sha256":"7ef31996970f101d638bc8a4c9ce01f9f3641bfad44b337f615b8a5768dc3197","availableFormats":["json"],"listOfBooksApiLink":"/api/mfx_ewf/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7938,"languageName":"Melo","languageEnglishName":"Melo"},"book":{"id":"REV","translationId":"mfx_ewf","name":"ዋንሳ ቆንጭ","commonName":"ዋንሳ ቆንጭ","title":"ዋንሳ ቆንጭይስ","order":66,"numberOfChapters":22,"sha256":"d793c7dc72624f02052c56349e3b78ae510886a9d07e42d3803953092516b55c","firstChapterNumber":1,"firstChapterApiLink":"/api/mfx_ewf/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/mfx_ewf/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":5,"content":[{"type":"heading","content":["ዱራኔ ማጻፍቶ"]},{"type":"verse","number":1,"content":["የይፕ ጉየ፥ ዙፋናይል አፋ በቴዛይ ኡሻች ኩሻይድ ጋንጨራኔ አፋር ጻፍንቲ ላፑን ማታመር ጎርድንቴዝ ጻ ማጻፍቶ ታ በኤዛ።"]},{"type":"verse","number":2,"content":["ፐቲ ምኖ ኪታንቻይ ፋ ቃላ ቅ ኡዲ፥ «ማታማ ብሎዳይስኔ ማጻፍቶ ዶዮዳይስ ቤዝዛይ ኦኖ?» ዬጊ አዋጆዳር በኤዛ።"]},{"type":"verse","number":3,"content":["ዝን ሳሎ ማቅን ሳአ ዎይ ሳአፕ ኦሞ ማቅን የ ጻ ማጻፍቶ ዶዮዳይስኔ ጋንጫ በአዳይስ ዳንዳኤዝ ኦንካ ባያ።"]},{"type":"verse","number":4,"content":["ጻ ማጻፍቶ ዶዮዳይስኔ እ ጋንጫ በአዳይስ ቤዝዛ አስ ቤዝ ግሾስ ታ ኢታ ዬኬዛ።"]},{"type":"verse","number":5,"content":["የ ዎደ፥ ጭምታይፕ ፐታይ ታኮ፥ «ዬክፐ! ይሁዳ ዘረ ማቄዝ ጋማይ፥ ዳዉተ ሼሻይ፥ ላፑን ማታምታ ብሎዳይስኔ ማጻፍቶ ዶዮዳይስ ዳንዳኤዛ» ዬጌዛ።"]},{"type":"verse","number":6,"content":["የይፕ ጉየ፥ ዙፋናይል ኦይዲ መተታይስኔ ጭምታይስ ጋንጨ፥ ሹክንቴዝ ዱር ጋርክ ኤቄዛና ታ በኤዛ። ኤስ ላፑን ካጭታይኔ ላፑን ኣፍታይ የዛ። የይትታይ ሳአ ኡባይል ኪትንቴዝ ጾስ አያና ላፑንታ።"]},{"type":"verse","number":7,"content":["የ ዱራይ ይኢ፥ ዙፋናይል አፋ በቴዛይ ኡሻች ኩሸፕ ጻ ማጻፍቶ ኤኬዛ።"]},{"type":"verse","number":8,"content":["ኤ የ ጻ ማጻፍቶ ኤኬዝ ዎደ ኦይዲ መትታይኔ ላታማኔ ኦይዲ ጭምታይ ዱራይ ቲናይድ ጉጲንጌዛ። ኡንቲ ፐታይ ፐታይ ዲኔ ጌሽታይ ዎሳ ማቄዝ እጻኔ ኩሜዝ ዎርቃ ሻተ አይኬዛ።"]},{"type":"verse","number":9,"content":["ኡንቲ፥",{"text":"«ጻ ማጻፍቶ ኤኮዳይስ፥","poem":1},{"text":"ማታመ ብልኦዳይስ ኔስ ቤዝዛ።","poem":2},{"text":"አብስ ጊኮ፥ ኔኒ ሹክንቴዛያ፤","poem":1},{"text":"ዘረ ኡባይፕ፥ ዱማ ዱማ ዶናፕ፥","poem":2},{"lineBreak":true},{"text":"ያርታይፐኔ ካተት ኡባይፕ፥","poem":2},{"lineBreak":true},{"text":"ነ ሱይር ጾሳይስ ዎዜዛ።","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ኑ ጾሳይስ ካተትኔ ቄሰ ማቃዳይ ጋርክ ኡዴዛ","poem":1},{"text":"ኡንቲ ቢታል አፋ ካዉቶዳ።","poem":2},{"text":"ኡንትካ ጋደ ኡባ ሞዶዳይ»","poem":1},"ዬጊ ኦሮ ማዝሙረ የጼዛ።"]},{"type":"verse","number":11,"content":["ታ በአዳር ዙፋናይ፥ ኦይዲ መትታይኔ ጭምታይ ዩሻይድ ጋመ ኪታንችታይ የዛ። ኡ ጋመትይ ሙኩሎ ቶኬ ሙኩሎኔ ታጲ ሙኩሎ ቶኬ ታጲ ሙኩሎ ማቄዝ ጊር ስኤዛ።"]},{"type":"verse","number":12,"content":["የ ኪታንችታይ ቅ ጌዝ ቃላር፥",{"text":"«ሹክንቴዝ ዱራይ ዎልቃ፥ ዱረት፥","poem":1},{"text":"ኤጨትኔ ምኖት፥ ቦንቾ፥ ሳባኔ","poem":2},{"lineBreak":true},{"text":"አንጆ ኤኮዳይስ ቤዝዛ»","poem":2},"ዬጌዛ።"]},{"type":"verse","number":13,"content":["የይፕ ጉየ፥ ሳአ፥ ሳሎ፥ ሳአፕ ኦሞራኔ አባ ጋንጨ የዝ መት ኡባይ፥",{"text":"«ዙፋነል አፋ በቴዛይስኔ ዱራይስ፥","poem":1},{"text":"ጋላታ፥ ቦንቾ፥ ሳባኔ ዎልቃ","poem":2},{"lineBreak":true},{"text":"መፐ መናስ ማቆ»","poem":2},"ዬጊ የጾዳር ስኤዛ።"]},{"type":"verse","number":14,"content":["ኦይዲ መትታይካ፥ «አምንኤ» ዬጌዛ፤ ማ ጭምታይካ ጹጉኒ ጎይኔዛ።"]}],"footnotes":[]},"thisChapterLink":"/api/mfx_ewf/REV/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mfx_ewf/REV/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mfx_ewf/REV/4.json","previousChapterAudioLinks":{},"numberOfVerses":14}