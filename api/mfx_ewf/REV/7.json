{"translation":{"id":"mfx_ewf","name":"ኦሮꬅ ጫቆ","website":"https://ebible.org/Scriptures/details.php?id=mfxe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mfxe","licenseNotes":null,"shortName":"EWF","englishName":"Melo NT Ethiopic","language":"mfx","textDirection":"ltr","sha256":"7ef31996970f101d638bc8a4c9ce01f9f3641bfad44b337f615b8a5768dc3197","availableFormats":["json"],"listOfBooksApiLink":"/api/mfx_ewf/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7938,"languageName":"Melo","languageEnglishName":"Melo"},"book":{"id":"REV","translationId":"mfx_ewf","name":"ዋንሳ ቆንጭ","commonName":"ዋንሳ ቆንጭ","title":"ዋንሳ ቆንጭይስ","order":66,"numberOfChapters":22,"sha256":"d793c7dc72624f02052c56349e3b78ae510886a9d07e42d3803953092516b55c","firstChapterNumber":1,"firstChapterApiLink":"/api/mfx_ewf/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/mfx_ewf/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":7,"content":[{"type":"heading","content":["ጼታኔ ኦይታማኔ ኦይዲ ሙኩሎ እስረልታ"]},{"type":"verse","number":1,"content":["የይፕ ጉየ፥ ኦይዲ ኪታንችታይ ኦይዲ ሳአ ጎንትታይል ኤቄዝታ በኤዛ። የ ኪታንችታይ ሳአል አፋ ዎይ አባል አፋ ዎይ አባ ምላካ አፋ ጫርካይ ኦይዲ ሳአ ጋጻፕ ጫርካማይ ጋርክ አይኬዛ።"]},{"type":"verse","number":2,"content":["ማ ደኦ ጾስ ማታመ የዝ ሀራ ኪታንቻይ አዋ ከስ ባጋፕ ከሳዳር ታ በኤዛ። የ ኪታንቻይ ፋ ቃላ ቅ ኡዲ፥ ሳአኔ አባ ቆሆዳይስ ዎልቃ እንግንቴዝ ኦይዲ ኪታንችታይኮ፥"]},{"type":"verse","number":3,"content":["«ኑኒ ጾስ አይልታይ ስናይድ ማታመ ጋዶድ ሄሎዳይስ ቢታ ዎይ አባ ዎይ ም ቆህፓተ» ዬጌዛ።"]},{"type":"verse","number":4,"content":["የዝን፥ ታኒ ጾስ ማታመ ስኖል ጋድንቴዝታይ ፓይዳ ስኤዛ። እስሬለ ኮች ኡባይፕ ጼታኔ ኦይታማነ ኦይዲ ሙኩሎ አሳይስ ስናይል ማታመ ጋዴዛ።"]},{"type":"verse","number":5,"content":[{"text":"ይሁዳ ኮቻፕ ታጶ ናምኢ ሙኩሎ፥","poem":1},{"lineBreak":true},{"text":"ሮቤላ ኮቻፕ ታጶ ናምኢ ሙኩሎ፥","poem":1},{"lineBreak":true},{"text":"ጋደ ኮቻፕ ታጶ ናምኢ ሙኩሎ፥","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ኣሴራ ኮቻፕ ታጶ ናምኢ ሙኩሎ፥","poem":1},{"lineBreak":true},{"text":"ንፍታለመ ኮቻፕ ታጶ ናምኢ ሙኩሎ፥","poem":1},{"lineBreak":true},{"text":"ምናሰ ኮቻፕ ታጶ ናምኢ ሙኩሎ፥","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ስሞና ኮቻፕ ታጶ ናምኢ ሙኩሎ፤","poem":1},{"lineBreak":true},{"text":"ለወ ኮቻፕ ታጶ ናምኢ ሙኩሎ፥","poem":1},{"lineBreak":true},{"text":"ይሳኮሬ ኮቻፕ ታጶ ናምኢ ሙኩሎ፥","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ዛብሎነ ኮቻፕ ታጶ ናምኢ ሙኩሎ፥","poem":1},{"lineBreak":true},{"text":"ዮሴፋ ኮቻፕ ታጶ ናምኢ ሙኩሎ፥","poem":1},{"lineBreak":true},{"text":"ቢናማ ኮቻፕ ታጶ ናምኢ ሙኩሎ፥","poem":1},"አሳይ ስናይል ማታመ ጋዴዛ።"]},{"type":"heading","content":["ቦ ማኦ ማኤዝ ጋመ ዎይታ"]},{"type":"verse","number":9,"content":["የይፕ ጉየ፥ ዘረ ኡባይፕ፥ ካተት ኡባይፕ፥ ኮች ኡባይፐኔ ዱማ ዱማ ዶና ኦድንትዝታይፕ ዛዋ ባ ጋመ ዎያ ታ በኤዛ። የ አሳይ ቦ አዱስ ማኦ ማኢ፥ ዛምባ ሀየ ፋ ኩሸ አይኪ፥ ዙፋናይ ቲናኔ ዱራይ ቲና ኤቄዛ።"]},{"type":"verse","number":10,"content":["ኡንቲ ፋ ቃላ ቅ ኡዲ፥ «አቶት ዙፋናይል በቴዝ ኑ ጾሳይፐኔ ዱራይፕ ይእዛ» ዬጌዛ።"]},{"type":"verse","number":11,"content":["ኪታንችታይ ኡባይ፥ ዙፋናይስኔ፥ ጭምታይስኔ ኦይዲ መትታይ ዩሻይር ማር ኤቄዛ። ኡንቲ ዙፋናይ ቲና ጹጉኒ ጾሳይስ ጎይኔዛ።"]},{"type":"verse","number":12,"content":[{"text":"«አምንኤ!","poem":1},{"text":"አንጆ፥ ቦንቾ፥ ኤጨት፥ ጋላታ፥ ሳባ","poem":2},{"lineBreak":true},{"text":"ዎልቃ፥ ምኖት መናፕ መና ሄሎዳይስ","poem":2},{"lineBreak":true},{"text":"ኑ ጾሳይስ ማቆ።","poem":2},{"text":"አምንኤ!» ዬጌዛ።","poem":1}]},{"type":"verse","number":13,"content":["ጭምታይፕ ፐታይ ታኮ፥ «Ꮊ ቦ ማአ ማኤዝ አስታይ ኦናንታራ? ኡንቲ አናፕ የኤኔ?» ዬጊ ታ ኦይጬዛ።"]},{"type":"verse","number":14,"content":["ታንካ ማሂ፥ «ጎዳዮ፥ ነ ኤርዛ» ዬጌዛ። ኤካ ታኮ፥ «የይትታይ ጋመ ዋየ ኣ የኤዝታ። ኡንቲ ፋ ማአ ዱራይ ሱር ሜጪ ቦ ኡዴዛ።"]},{"type":"verse","number":15,"content":["የይ ግሾስ፥",{"text":"«ኡንቲ ጾስ ዙፋናይ ቲና የዝ","poem":1},{"text":"ቃማኔ ጋላስ ኤ ኬ ኤዛ ጎይኔዛ።","poem":2},{"text":"ማ ዙፋናይል አፋ በቴዛይ ኡንትስ ካምፓ ማቆዳ።","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ይከፕ ጉየ፥ ኡንቲ ናይንታሚ፥ ሳምንታሚ።","poem":1},{"text":"አዋ ምቻካ ኡንታን ሾጫሚ።","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ዙፋንታይ ግዶ በቴዝ ዱራይ ኡንታን ሄንጎዳ።","poem":1},{"text":"ደኦ ፑልቶ ሃኮ ኡንታን ካልዳ።","poem":2},{"text":"ጾሲ ኡ ኣፋይፕ አፉ ኡባ ኡጮዳ»","poem":1},"ዬጌዛ።"]}],"footnotes":[]},"thisChapterLink":"/api/mfx_ewf/REV/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mfx_ewf/REV/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mfx_ewf/REV/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}