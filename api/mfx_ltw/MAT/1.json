{"translation":{"id":"mfx_ltw","name":"Oroth Caaqo","website":"https://ebible.org/Scriptures/details.php?id=mfxl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mfxl","licenseNotes":null,"shortName":"LTW","englishName":"Melo NT","language":"mfx","textDirection":"ltr","sha256":"33b79bd75e2687eaa25f61d0f0e025f9992461da909478f5641a75efa4a303c6","availableFormats":["json"],"listOfBooksApiLink":"/api/mfx_ltw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7938,"languageName":"Melo","languageEnglishName":"Melo"},"book":{"id":"MAT","translationId":"mfx_ltw","name":"Maatoosa","commonName":"Maatoosa","title":"Maatoosa Xaafeez Yesuus Kiristtoosa Wonggile","order":40,"numberOfChapters":28,"sha256":"a2722377735c788beee4c5ce6cbc2d687796c150b9f6cd4d1d6d32b01df8bc06","firstChapterNumber":1,"firstChapterApiLink":"/api/mfx_ltw/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/mfx_ltw/MAT/28.json","totalNumberOfVerses":1068},"chapter":{"number":1,"content":[{"type":"heading","content":["Yesuusa yeletith xussii"]},{"type":"verse","number":1,"content":["Dawute na7a Afraame na7a maaqqeez Yesuus Kiristtoosa yeletith."]},{"type":"verse","number":2,"content":["Afraame Isaaqa yeleeza;",{"text":"Isaaqa Yayqqooba yeleeza;","poem":1},{"lineBreak":true},{"text":"Yayqqooba Yihudarannee e ishita yeleeza;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yihuda Ti7imaaripp Paaresannee Zaara yeleeza;","poem":1},{"lineBreak":true},{"text":"Paaresa Asroome yeleeza;","poem":1},{"lineBreak":true},{"text":"Asrooma Raame yeleeza;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Raame Aminadaba yeleeza;","poem":1},{"lineBreak":true},{"text":"Aminadaba Na7asoona yeleeza;","poem":1},{"lineBreak":true},{"text":"Na7asoona Salmoone yeleeza;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Salmoona Ra7aabppe Boo7eeza yeleeza;","poem":1},{"lineBreak":true},{"text":"Boo7eeza Uritppe Iyobeede yeleeza;","poem":1},{"lineBreak":true},{"text":"Iyobeede Issaye yeleeza;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Issaye kaata Dawite yeleeza;","poem":1},{"lineBreak":true},{"text":"Kaat Dawite Ooriyo machchattippe Solomone yeleeza;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Solomone Robi7aama yeleeza;","poem":1},{"lineBreak":true},{"text":"Robi7aame Abiya yeleeza;","poem":1},{"lineBreak":true},{"text":"Abiye Asaafe yeleeza;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asaafe Iyosaafexe yeleeza;","poem":1},{"lineBreak":true},{"text":"Iyosaafixe Iyoraame yeleeza;","poem":1},{"lineBreak":true},{"text":"Iyoraame Oozanee yeleeza;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Oozanee Iyo7ataame yeleeza;","poem":1},{"lineBreak":true},{"text":"Iyo7ataame Akkaza yeleeza;","poem":1},{"lineBreak":true},{"text":"Akkaza Hiziqasa yeleeza;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hiziqasa Minaase yeleeza;","poem":1},{"lineBreak":true},{"text":"Minaase Amooxa yeleeza;","poem":1},{"lineBreak":true},{"text":"Amooxa Iyosaasa yeleeza;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Iyosaasa Ikonaanarannee e ishita yeleez ya laythate Isreele asay di7inttii Baabiloone biitta yhanigeeza.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Baabiloone biitta Isreele asay di7inttii yhanigeezaypp guye Ikonaana Salatiyaale yeleeza.","poem":1},{"lineBreak":true},{"text":"Salatiyaale Zerubaabela yeleeza;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zerubaabela Abdiyu yeleeza;","poem":1},{"lineBreak":true},{"text":"Abdiyu Eliyaaqeme yeleeza;","poem":1},{"lineBreak":true},{"text":"Eliyaaqeme Azoora yeleeza;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Azoora Sadooqe yeleeza;","poem":1},{"lineBreak":true},{"text":"Sadooqe Akime yeleeza;","poem":1},{"lineBreak":true},{"text":"Akime Eliyuuda yeleeza;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Eliyuuda Alaazara yeleeza;","poem":1},{"lineBreak":true},{"text":"Alaazare Maatane yeleeza;","poem":1},{"lineBreak":true},{"text":"Maatane Yayqqooba yeleeza;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yayqqooba Yooseefa yeleeza;","poem":1},{"lineBreak":true},{"text":"Yooseefa Kiristtoosa giz Yesuusana yeleez Mayramii azina.","poem":1}]},{"type":"verse","number":17,"content":["Yikkee, yeletithii Afraamepp Dawute hellodayis taphpho oydde. Dawutepp yhanigii Baabiloone di7a hellodayis taphpho oydde. Baabiloone di7aypp yhanigii Kiristtoosa hellodayis taphpho oyddii yeletithi maaqqiza."]},{"type":"heading","content":["Yesuus Kiristtoosa yeletithi"]},{"type":"verse","number":18,"content":["Yesuus Kiristtoosa yelintto taarikay yhaypp kaalliza. E indat Mayrama Yooseefas oyccinttii yezar Yooseefar wolla aqekkazar geeshsha Ayyanapp woddexeeza."]},{"type":"verse","number":19,"content":["Yooseefa geesh as maaqqeez gisho izo asii ododay garkk koyekkazay gishos geemar ashshodayis qoppeeza."]},{"type":"verse","number":20,"content":["E ye qofayil yezin Xoossa kiitanchchay abukkar ees benttii, «Dawute na7a, Yooseefa, Mayrama woddexeezay geesha Ayyanapp maaqqeez gisho izo ekkodayis yashittippe» yeegeeza."]},{"type":"verse","number":21,"content":["Iza dhiirath na7a yeloda, E woyita u nagaraypp ashshizay gisho e suntha ne Yesuusa gi xeegoda."]},{"type":"verse","number":22,"content":["Goday nabay doonar,"]},{"type":"verse","number":23,"content":["«Yeezako wudirtta wodexxoda; dhiirath na7a yeloda; e sunthay Amanu7eela ginttinttoda» geezay polinttoday garkk yha ubbay haneeza. Amanu7eela guusayis birshshithay «Xoossay nuuri yeza» guussii."]},{"type":"verse","number":24,"content":["Yooseefa genttapp barkkii Goday kiitanchchay kiitteezay garkk Mayramo fa kara kanggeeza."]},{"type":"verse","number":25,"content":["Zin fa bayra na7a yelod gatho izo bochchekaya;",{"noteId":0},"yelintteez na7akka Yesuusa gi xeegeeza."]}],"footnotes":[{"noteId":0,"caller":"+","text":"Izo bochchekaya: Machchir azinar aqizaygarkk wolla aqekka guussii.","reference":{"chapter":1,"verse":25}}]},"thisChapterLink":"/api/mfx_ltw/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mfx_ltw/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":25}