{"translation":{"id":"mfx_ltw","name":"Oroth Caaqo","website":"https://ebible.org/Scriptures/details.php?id=mfxl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mfxl","licenseNotes":null,"shortName":"LTW","englishName":"Melo NT","language":"mfx","textDirection":"ltr","sha256":"33b79bd75e2687eaa25f61d0f0e025f9992461da909478f5641a75efa4a303c6","availableFormats":["json"],"listOfBooksApiLink":"/api/mfx_ltw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7938,"languageName":"Melo","languageEnglishName":"Melo"},"book":{"id":"REV","translationId":"mfx_ltw","name":"Waannisa Qonccitha","commonName":"Waannisa Qonccitha","title":"Waannisa Qonccithayis","order":66,"numberOfChapters":22,"sha256":"f52694ebffb659b03741cbfb7f8d6ff256ff8811641ac2102fa3d101fbc786ba","firstChapterNumber":1,"firstChapterApiLink":"/api/mfx_ltw/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/mfx_ltw/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":7,"content":[{"type":"heading","content":["Xeetannee oyttamannee oyddii mukulo Isrelita"]},{"type":"verse","number":1,"content":["Yeypp guye, oydd kiitanchchitay oydd sa7a gontte eqqeezita be7eeza. Ye kiitanchchitay sa7all afa woy abbal afa woy aba mithalkka afa carkkay oydd sa7a gaxapp carkkaamay garkk aykkeeza."]},{"type":"verse","number":2,"content":["Ma de7o Xooss maatame yez hara kiitanchchay awa kess baggapp kezodar ta be7eeza. Ye kiitanchchay fa qaala dhoq udii, sa7annee abba qohodayis wolqqa inggintteez oyddii kiitanchchitayiko,"]},{"type":"verse","number":3,"content":["«Nuunii Xooss ayllitay sinayid maatame gaddod hellodayis biitta woy abba woy mitha qohipattee» yeegeeza."]},{"type":"verse","number":4,"content":["Yeezin, taanii Xooss maatame sino gadintteezitay payida si7eeza. Isra7eele kochch ubbaypp xeetannee oytamanne oydd mukulo asayis sinayil maatame gaddeeza."]},{"type":"verse","number":5,"content":[{"text":"Yihuda kochchapp taphpho nam77ii mukulo,","poem":1},{"lineBreak":true},{"text":"Roobela kochchapp taphpho nam77ii mukulo,","poem":1},{"lineBreak":true},{"text":"Gade kochchapp taphpho nam77ii mukulo,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aseera kochchapp taphpho nam77ii mukulo,","poem":1},{"lineBreak":true},{"text":"Niftaaleme kochchapp taphpho nam77ii mukulo,","poem":1},{"lineBreak":true},{"text":"Minaase kochchapp taphpho nam77ii mukulo,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Simoona kochchapp taphpho nam77ii mukulo;","poem":1},{"lineBreak":true},{"text":"Lewe kochchapp taphpho nam77ii mukulo,","poem":1},{"lineBreak":true},{"text":"Yisaakoree kochchapp taphpho nam77ii mukulo,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zaabiloone kochchapp taphpho nam77ii mukulo,","poem":1},{"lineBreak":true},{"text":"Yooseefa kochchapp taphpho nam77ii mukulo,","poem":1},{"lineBreak":true},{"text":"Biinama kochchapp taphpho nam77ii mukulo,","poem":1},"asay sinayil maatame gaddeeza."]},{"type":"heading","content":["Booth ma7o ma77eez gaame woyita"]},{"type":"verse","number":9,"content":["Yeypp guye, zerethi ubbaypp, kaatetitha ubbaypp, kochch ubbayppennee duma duma doona odinttizitaypp zawa baa gaame woya ta be7eeza. Ye asay booth aduss ma7o ma77ii, zambba haye fa kushe aykkii, zufaanay tiinannee Duray tiina eqqeeza."]},{"type":"verse","number":10,"content":["Unttii fa qaala dhoqq udii, «Atotith zufaanayil betteez nu Xoossayppenne Duraypp yi7iza» yeegeeza."]},{"type":"verse","number":11,"content":["Kiitanchchitay ubbay, zufaanayisnnee, cimitayisinnee oydd medhetithitay yuushayir mari eqqeeza. Unttii zufaanay tiina xuggunii Xoossayis goynneeza."]},{"type":"verse","number":12,"content":[{"text":"«Amin77ii!","poem":1},{"text":"Anjjo, bonchcho, ecetith, galata, Saaba","poem":2},{"lineBreak":true},{"text":"wolqqa, minotithii medhinapp medhina hellodayis","poem":2},{"lineBreak":true},{"text":"nu Xoossayis maaqqo.","poem":2},{"text":"Amin77ee!»","poem":1},"yeegeeza."]},{"type":"verse","number":13,"content":["Cimitaypp pettay taako, «Yha booth ma7a ma77eez asitay oonanttara? Unttii anapp ye7eenee?» yeegii ta oycceeza."]},{"type":"verse","number":14,"content":["Taanikka mahii, «Godayyo, ne eriza» yeegeeza. Eekka taako, «Yeyititay gaame waaye aadhii ye7eezita. Unttii fa ma7a Duray suuthar meeccii boothii udeeza."]},{"type":"verse","number":15,"content":["Yeyi gishos,",{"text":"«Unttii Xooss zufaanay tiina yezi","poem":1},{"text":"qammannee gallas e keetha eza goynneeza.","poem":2},{"text":"Ma zufaanayil afa betteezay unttis kamppa maaqqoda.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yikkepp guye, unttii nayinttaamii, saaminttaamii.","poem":1},{"text":"Awa michakka unttan shocaamii.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Zufaanitay gido betteez Duray unttan heenggoda.","poem":1},{"text":"De7o pultto haathiko unttan kaalithoda.","poem":2},{"text":"Xoossii u aafaypp afuth ubba uccoda»","poem":1},"yeegeeza."]}],"footnotes":[]},"thisChapterLink":"/api/mfx_ltw/REV/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mfx_ltw/REV/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mfx_ltw/REV/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}