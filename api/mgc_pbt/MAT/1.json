{"translation":{"id":"mgc_pbt","name":"Morokodo","website":"https://ebible.org/Scriptures/details.php?id=mgc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mgc","licenseNotes":null,"shortName":"PBT","englishName":"Morokodo Bible Portions","language":"mgc","textDirection":"ltr","sha256":"e430410bc3a2f5d2e57204309e223000a1ab3332286726e978b038c580916278","availableFormats":["json"],"listOfBooksApiLink":"/api/mgc_pbt/books.json","numberOfBooks":6,"totalNumberOfChapters":103,"totalNumberOfVerses":3827,"languageName":"Morokodo","languageEnglishName":"Morokodo"},"book":{"id":"MAT","translationId":"mgc_pbt","name":"Matayo","commonName":"Matayo","title":"Kö'du Yöyö Laka 'ba Yësu ma Matayo ayöru","order":40,"numberOfChapters":28,"sha256":"be4ecf2b9fc53cef1445389767e1b0cda6a00730b3e7e644bb228c483b540ca0","firstChapterNumber":1,"firstChapterApiLink":"/api/mgc_pbt/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/mgc_pbt/MAT/28.json","totalNumberOfVerses":1068},"chapter":{"number":1,"content":[{"type":"heading","content":["Zutu 'ba Yësu"]},{"type":"verse","number":1,"content":["Nenye zutu 'ba Yësu Korisitɔ kozo 'ba Dawidi, kozo 'ba Abarayama."]},{"type":"verse","number":2,"content":[{"text":"Abarayama ra o'jo Yisika,","poem":1},{"lineBreak":true},{"text":"Yisika ra o'jo Yakoba,","poem":1},{"lineBreak":true},{"text":"Yakoba ra o'jo Yuda, öndu nï ëtï.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yuda ra o'jo Pereze Zera aba,","poem":1},{"lineBreak":true},{"text":"ma zë ra Tamara,","poem":1},{"lineBreak":true},{"text":"Pereze ra o'jo Ezerona,","poem":1},{"lineBreak":true},{"text":"Ezerona ra o'jo Rama,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rama ra o'jo Aminadaba,","poem":1},{"lineBreak":true},{"text":"Aminadaba ra o'jo Nasona,","poem":1},{"lineBreak":true},{"text":"Nasona ra o'jo Salamono,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Salamono ra o'jo Bowoza,","poem":1},{"lineBreak":true},{"text":"ma mo ra Raba.","poem":1},{"lineBreak":true},{"text":"Bawoza ra o'jo Obede,","poem":1},{"lineBreak":true},{"text":"ma mo ra Ruta.","poem":1},{"lineBreak":true},{"text":"Obede ra o'jo Jese.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Jese ra o'jo Dawidi vo damöku.","poem":1},{"lineBreak":true},{"text":"Dawidi ra o'jo Solomono","poem":1},{"lineBreak":true},{"text":"ma mo ra lu'bë pëtï Uriya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Solomono ra o'jo Rebama,","poem":1},{"lineBreak":true},{"text":"Rebama ra o'jo Abiya,","poem":1},{"lineBreak":true},{"text":"Abiya ra o'jo Asa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asa ra o'jo Yesopata,","poem":1},{"lineBreak":true},{"text":"Yesopata ra o'jo Yorama,","poem":1},{"lineBreak":true},{"text":"Yorama ra o'jo Uziya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Uziya ra o'jo Yotama,","poem":1},{"lineBreak":true},{"text":"Yotama ra o'jo Aza,","poem":1},{"lineBreak":true},{"text":"Aza ra o'jo Ezikiya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ezikiya ra o'jo Manase,","poem":1},{"lineBreak":true},{"text":"Manase ra o'jo Amona,","poem":1},{"lineBreak":true},{"text":"Amona ra o'jo Yosiya.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yosiya ra o'jo Yekoniya zë 'dö","poem":1},{"lineBreak":true},{"text":"öndu nï ëtï kadra 'ba kïrï vïdï tï'bë Babalönï.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tapëtï kïrï vïdï tï'bë Babalönï ne.","poem":1},{"lineBreak":true},{"text":"Yekoniya ra o'jo Salatele,","poem":1},{"lineBreak":true},{"text":"Salatele ra o'jo Zerobabele,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zerobabele ra o'jo Abiyuda,","poem":1},{"lineBreak":true},{"text":"Abiyuda ra o'jo Elikima,","poem":1},{"lineBreak":true},{"text":"Elikima ra o'jo Azora,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Azora ra o'jo Zadoka,","poem":1},{"lineBreak":true},{"text":"Zadoka ra o'jo Akimo,","poem":1},{"lineBreak":true},{"text":"Akimo ra o'jo Eliyuda,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Eliyuda ra o'jo Elizara,","poem":1},{"lineBreak":true},{"text":"Elizara ra o'jo Matana,","poem":1},{"lineBreak":true},{"text":"Matana ra o'jo Yakoba,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yakoba ra o'jo Yosepa","poem":1},{"lineBreak":true},{"text":"kora 'ba Mariya ma 'ba","poem":1},{"lineBreak":true},{"text":"Yësu ma ako'jo Korisitɔ ne.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":["Here kozo ëdï kazi Abarayama zi Dawidi 'butë dɔmosowɔ, ëdï kazi Dawidi ma ï'bënnï mï Babalönï 'butë dɔmosowɔ le mï ko'jo 'ba Korisitɔ."]},{"type":"heading","content":["Ko'jo Yësu"]},{"type":"verse","number":18,"content":["Nenye hala kö'du ko'jo 'ba Yësu Korisitɔ. Alivö ma mo zi koze zi Yosepa, mora gba adrɔ'bo rë nnï dë mo ayɔlɔ rë nnï mo ɔmɔ ku kyigɔ 'ba Lawo Kölö Laka aba."]},{"type":"verse","number":19,"content":["Mora kora 'bɔmo Yosepa vo kö'du laka ko'dɔ mo omba dë zi gburu mo komo vïdï kayo. Mo asösu gbɔ zi kinga mo liwo."]},{"type":"verse","number":20,"content":["Mora mati mo ëdï kö'du ne sösu mo here ne, malayika 'ba Yere ayada rë nï zi mo tëmï wïrï, iya henye, “Yosepa Kozo 'ba Dawidi, ere dë ta bi Mariya kïrï zi yï na mbara 'bëyï, ga kö'du wisi mï mo ne Lawo Kölö Laka ra ï'dï mo ɔmɔ."]},{"type":"verse","number":21,"content":["Mo ako'jo na wisi kora akako'jo ru mo Yësu ga kö'du mo ra akakɔnyi vïdï 'bënï 'e tëmï kö'du kyënyë 'bëzë.”"]},{"type":"verse","number":22,"content":["Kö'du ne biya o'dɔ rë nï zi tëdï kaa Wïrï ï'dï me'do mo ku kyere zi nëbï, iya henye,"]},{"type":"verse","number":23,"content":["Wu'jë maako gba na wu'jë ngulu ako'jo wisi kora akako'jo ru mo Imanowele, mï me'do ne iya henye, “Wïrï ëdï ze aba.”"]},{"type":"verse","number":24,"content":["Mora Yosepa ongɔ here oze Mariya gbɔ kaa malayika 'ba Wïrï iya zi mo."]},{"type":"verse","number":25,"content":["Mati gba zë ïrï dë nnï dë Mariya aba mo o'jo wisi ënï ne na kora, mora mo ï'dï ru mo gbɔ Yësu."]}],"footnotes":[]},"thisChapterLink":"/api/mgc_pbt/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mgc_pbt/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":25}