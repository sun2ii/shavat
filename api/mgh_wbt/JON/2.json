{"translation":{"id":"mgh_wbt","name":"Makhuwa-Meetto do Novo Testamento","website":"https://ebible.org/Scriptures/details.php?id=mgh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mgh","licenseNotes":null,"shortName":"WBT","englishName":"Makhuwa-Meetto NT","language":"mgh","textDirection":"ltr","sha256":"6388255bf6c42703032d5d5d82c5d6edd6c06e1102a4de7f2596e802ce9eef16","availableFormats":["json"],"listOfBooksApiLink":"/api/mgh_wbt/books.json","numberOfBooks":4,"totalNumberOfChapters":75,"totalNumberOfVerses":2367,"languageName":"Makua","languageEnglishName":"Makhuwa-Meetto"},"book":{"id":"JON","translationId":"mgh_wbt","name":"Yona","commonName":"Yona","title":"Yona","order":32,"numberOfChapters":4,"sha256":"f367739857b324fb17316b062808bb063c8f261445051072a6661b57032e8b3e","firstChapterNumber":1,"firstChapterApiLink":"/api/mgh_wbt/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/mgh_wbt/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Vano Yona nari mmirimani mohopa ahoswali aasukuruku Mwaneene Nluku"]},{"type":"verse","number":2,"content":["eeraka:",{"text":"Mmahuvihoni kihokhuwelela Mwaneene Nluku","poem":1},{"text":"ni ahokaakhula.","poem":2},{"text":"Mmirimani mahiye kihokhuwa,","poem":1},{"text":"ni nyu nheewa ncu naka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nhokirihela mpaharini mapuro oowiisya cinenne","poem":1},{"text":"ni kihokhala oorukureriya ni maasi","poem":2},{"lineBreak":true},{"text":"ni mawimpi moolupale othene yaavira waculu waka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kihoona toko kihomwalaanihiya ni nyu.","poem":1},{"text":"Akaacuwela wiira kaanhala woona tho inupa enyu ittakattifu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Maasi othene yahokikhuneela mpaka ukittiya iphumu;","poem":1},{"text":"ni ipahari yahokimirya","poem":2},{"lineBreak":true},{"text":"ni makukhu o mpaharini yahokivilikelela mmuru.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kihokhuruwela mpaka vathi waya myaako,","poem":1},{"text":"mpaka ilapo ya atthu ookhwa","poem":2},{"lineBreak":true},{"text":"ni mikhora caya cahokitthukela mommo.","poem":2},{"text":"Nanso nyu nhokikumiha mapuro oowiisa,","poem":1},{"text":"nuukivaha ukumi;","poem":2},{"lineBreak":true},{"text":"Mwaneene Nluku; Nluku aka!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Upheelaka nnepa aka urimela","poem":1},{"text":"mi kihowuupuwelelani nyu, Mwaneene Nluku,","poem":2},{"lineBreak":true},{"text":"ni iswali caka cowela warinyu,","poem":2},{"lineBreak":true},{"text":"mpaani mwinyu moottakattifihiya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ale anaswalela anluku oohimaana","poem":1},{"text":"ahiyaka ikiriri ca Nluku.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nanso mi kinaahala uwiipelani macipo oowunnuwihani","poem":1},{"text":"ni wuuvahani itthuvo.","poem":2},{"text":"Kinkopanka ile yookhuluvelihilyakani.","poem":1},{"text":"Woopwa ukhuma wa Mwaneene Nluku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":["Vano Mwaneene Nluku ahoolumana ihopa wiira inraphye Yona, ni Yona ahoraphenya ucenkweni."]}],"footnotes":[]},"thisChapterLink":"/api/mgh_wbt/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mgh_wbt/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mgh_wbt/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}