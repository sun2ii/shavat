{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"AMO","translationId":"mkw_wbt","name":"Amose","commonName":"Amose","title":"Dibuku ya AMOSE","order":30,"numberOfChapters":9,"sha256":"4cb688c40b9bf75d94d0c10d91d587622f8a8c880d7f5054b4a646d8bbc762ef","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/mkw_wbt/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["Nzimbu ya mafwa samu na Isayeli"]},{"type":"verse","number":1,"content":["Beno kuwa mambu yayi, beno bantu ya Isayeli. Beno kuwa nzimbu ya mafwa yina mu ke yimbila samu na beno."]},{"type":"verse","number":2,"content":[{"text":"Isayeli me kubwa, yandi ke vumbuka dyaka ve.","poem":1},{"lineBreak":true},{"text":"Isayeli, ndumba ya kitoko.","poem":1},{"lineBreak":true},{"text":"Yandi me kubwa na ntoto ya yandi mosi,","poem":1},{"lineBreak":true},{"text":"ata muntu samu na kutelemisa yandi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ni yawu yina, na yina me tadila bantu ya Isayeli,","poem":1},{"lineBreak":true},{"text":"Yave Mfumu ke na kutuba mutindu yayi:","poem":1},{"lineBreak":true},{"text":"«Mbanza yina vwandaka baka funda mosi (1 000) ya babakala","poem":1},{"lineBreak":true},{"text":"samu na kukwenda na mvita,","poem":1},{"lineBreak":true},{"text":"yawu ke bikana kaka na babakala nkama (100).","poem":1},{"lineBreak":true},{"text":"Mbanza yina vwandaka baka babakala nkama (100),","poem":1},{"lineBreak":true},{"text":"samu na kukwenda na mvita,","poem":1},{"lineBreak":true},{"text":"yawu ke bikana kaka na babakala kumi.»","poem":1}]},{"type":"heading","content":["Yave ke na kulomba Isayeli na kuviluka"]},{"type":"verse","number":4,"content":[{"text":"Yave ke na kutuba mutindu yayi na bantu ya Isayeli:","poem":1},{"lineBreak":true},{"text":"«Beno sosa munu mpe beno ke zinga!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kasi beno sosa munu na mbanza Betele ve.","poem":1},{"lineBreak":true},{"text":"Beno sosa munu na mbanza Ngilengale ve,","poem":1},{"lineBreak":true},{"text":"beno meka ve na kulutila kuna.","poem":1},{"lineBreak":true},{"text":"Beno kota ve kuna na Beele-Seba,","poem":1},{"lineBreak":true},{"text":"samu ti ba ke nata na ngolo bantu ya Ngilengale na yinsi ya nzenza","poem":1},{"lineBreak":true},{"text":"mpe ata kima ya yimbi ke bikana na Betele.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Beno sosa Yave mpe beno ke zinga.","poem":1},{"lineBreak":true},{"text":"Beno sala keba samu ti yandi bika","poem":1},{"lineBreak":true},{"text":"na kulakisa ngolo ya yandi","poem":1},{"lineBreak":true},{"text":"na bantu ya Yosefi mutindu tiya.","poem":1},{"lineBreak":true},{"text":"Tiya yina ke nyengisa bantu ya Yosefi,","poem":1},{"lineBreak":true},{"text":"mpe ya ke vwanda ve na muntu kuna na Betele,","poem":1},{"text":"samu na kufwa yawu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Beno ke na kusala ti mambu","poem":1},{"lineBreak":true},{"text":"ya kusungama kuvwanda kima ya ndudi ya kulutila.","poem":1},{"lineBreak":true},{"text":"Beno me bwisa ludedomo na ntoto!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ni yandi yidikaka bambwetete ya konso mutindu,","poem":1},{"lineBreak":true},{"text":"yandi ke kitulaka kitombe ya lufwa","poem":1},{"lineBreak":true},{"text":"na nsemo ya suka,","poem":1},{"lineBreak":true},{"text":"yandi ke bumbaka nsemo","poem":1},{"lineBreak":true},{"text":"samu ti mpimpa kuvwanda.","poem":1},{"lineBreak":true},{"text":"Yandi ke kutikaka maza ya mubu","poem":1},{"lineBreak":true},{"text":"samu na kumwangisa yawu na ntoto.","poem":1},{"lineBreak":true},{"text":"Nkumbu ya yandi kele Yave.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ni yandi ke salaka ti","poem":1},{"lineBreak":true},{"text":"ba botola bimvwama ya muntu ya ngolo.","poem":1},{"lineBreak":true},{"text":"Ni yandi ke salaka ti","poem":1},{"lineBreak":true},{"text":"vwanzi kukota na mbanza","poem":1},{"lineBreak":true},{"text":"yina kele na bibaka ya lukengolo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Na bisika ya lufundusu,","poem":1},{"lineBreak":true},{"text":"bawu ke yinaka mpe ke talaka yimbi","poem":1},{"lineBreak":true},{"text":"muntu ya kusungama","poem":1},{"lineBreak":true},{"text":"yina ke zonzaka mambu ya tsyelika.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Mutindu beno ke vunaka muntu ya mpamba","poem":1},{"lineBreak":true},{"text":"mpe beno ke bakaka mwa ndambu ya bambuma ya faline","poem":1},{"lineBreak":true},{"text":"yina ke na yandi,","poem":1},{"lineBreak":true},{"text":"bayinzo yayi ya matadi yina beno tungaka,","poem":1},{"lineBreak":true},{"text":"beno ke zinga ve na yawu.","poem":1},{"lineBreak":true},{"text":"Bilanga yayi ya bayinti ya vinu ya kitoko","poem":1},{"lineBreak":true},{"text":"yina beno kundaka,","poem":1},{"lineBreak":true},{"text":"beno ke kunwa ve vinu ya yawu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Samu ti mu me zaba mingi yimbi ya beno","poem":1},{"lineBreak":true},{"text":"mpe bunene ya masumu ya beno.","poem":1},{"lineBreak":true},{"text":"Beno bayina ke nyokolaka","poem":1},{"lineBreak":true},{"text":"bantu ya kudedama.","poem":1},{"lineBreak":true},{"text":"Beno ke ndimaka madeso ya bana.","poem":1},{"lineBreak":true},{"text":"Mpe na bisika ya lufundusu,","poem":1},{"lineBreak":true},{"text":"beno ke zolaka ve ti","poem":1},{"lineBreak":true},{"text":"bamputu kununga beno.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ni yawu yina,","poem":1},{"lineBreak":true},{"text":"na bantangu ya mutindu yayi,","poem":1},{"lineBreak":true},{"text":"muntu ya kulwenga","poem":1},{"lineBreak":true},{"text":"me lunga na kuvwanda swii,","poem":1},{"lineBreak":true},{"text":"samu ti ya kele bantangu ya mpasi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Beno sadila mambu ya mbote","poem":1},{"lineBreak":true},{"text":"kasi ya yimbi ve, samu ti beno kuzinga.","poem":1},{"lineBreak":true},{"text":"Na mutindu yina,","poem":1},{"lineBreak":true},{"text":"Yave, Nzambi ya Binwani,","poem":1},{"lineBreak":true},{"text":"ke vwanda na beno","poem":1},{"lineBreak":true},{"text":"mutindu beno ke na kutuba yawu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Beno kuyina mambu ya yimbi","poem":1},{"lineBreak":true},{"text":"mpe beno kuzola mambu ya mbote.","poem":1},{"lineBreak":true},{"text":"Na bisika ya lufundusu,","poem":1},{"lineBreak":true},{"text":"beno fundisa na mutindu ya kusungama.","poem":1},{"lineBreak":true},{"text":"Na kusalaka mutindu yina,","poem":1},{"lineBreak":true},{"text":"kuzaba ve kana Yave,","poem":1},{"lineBreak":true},{"text":"Nzambi ya lulendo, ke fwila kyadi","poem":1},{"lineBreak":true},{"text":"dikanda ya Yosefi yina me bikana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ni yawu yina,","poem":1},{"lineBreak":true},{"text":"Yave, Nzambi ya binwani,","poem":1},{"lineBreak":true},{"text":"Mfumu ya munu ke na kutuba:","poem":1},{"lineBreak":true},{"text":"«Na bisika nyonso yina","poem":1},{"lineBreak":true},{"text":"bantu ke yonzamaka,","poem":1},{"lineBreak":true},{"text":"ba ke kuwa bantu ke na kuyawula.","poem":1},{"lineBreak":true},{"text":"Na banzila nyonso, bantu ke banda","poem":1},{"lineBreak":true},{"text":"na kwendaka looka: “Kyadi! Kyadi!”","poem":1},{"lineBreak":true},{"text":"Na kulutisa bantangu ya kyadi,","poem":1},{"lineBreak":true},{"text":"ba ke bokila bayina ke salaka bilanga.","poem":1},{"lineBreak":true},{"text":"Samu na mikunga ya mafwa,","poem":1},{"lineBreak":true},{"text":"ba ke bokila bayina zaba","poem":1},{"lineBreak":true},{"text":"kuyimbila banzimbu ya mafwa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ntangu mu ke luta","poem":1},{"lineBreak":true},{"text":"na kati-kati ya beno,","poem":1},{"lineBreak":true},{"text":"beno ke banda na kwendaka dila","poem":1},{"lineBreak":true},{"text":"tii na kati ya bilanga nyonso ya bayinti ya vinu.","poem":1},{"lineBreak":true},{"text":"Ni Yave me tuba yawu.»","poem":1}]},{"type":"heading","content":["Kilumbu ya Yave"]},{"type":"verse","number":18,"content":[{"text":"Kyadi na bayina ke na nsatu","poem":1},{"lineBreak":true},{"text":"ya kutala Kilumbu ya Yave!","poem":1},{"lineBreak":true},{"text":"Yinki beno ke kuzwa","poem":1},{"lineBreak":true},{"text":"na Kilumbu ya Yave?","poem":1},{"lineBreak":true},{"text":"Beno ke na kubanza ti","poem":1},{"lineBreak":true},{"text":"yawu ke vwanda kilumbu ya nsemo?","poem":1},{"lineBreak":true},{"text":"Ve, yawu ke vwanda kilumbu ya kitombe.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yawu ke vwanda mutindu muntu","poem":1},{"lineBreak":true},{"text":"ke na kukima nkosi","poem":1},{"lineBreak":true},{"text":"kasi yandi ke na kubwabana uluse.","poem":1},{"lineBreak":true},{"text":"Yawu ke vwanda mutindu muntu","poem":1},{"lineBreak":true},{"text":"me kota na yinzo ya yandi,","poem":1},{"lineBreak":true},{"text":"yandi me tula diboko na kibaka","poem":1},{"lineBreak":true},{"text":"mpe nyoka me tatika yandi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"- Kilumbu ya Yave","poem":1},{"lineBreak":true},{"text":"ke vwanda kilumbu ya nsemo?","poem":1},{"lineBreak":true},{"text":"- Ve, yawu ke vwanda","poem":1},{"lineBreak":true},{"text":"kilumbu ya kitombe,","poem":1},{"lineBreak":true},{"text":"kilumbu ya mpimpa ya kulutila,","poem":1},{"lineBreak":true},{"text":"ata nsemo ke talana ve!","poem":1}]},{"type":"heading","content":["Lusambulu yina Yave ke yinaka"]},{"type":"verse","number":21,"content":[{"text":"«Mu ke yinaka mikembo ya beno,","poem":1},{"lineBreak":true},{"text":"mu ke mangaka yawu.","poem":1},{"lineBreak":true},{"text":"Mu ke zolaka ve","poem":1},{"lineBreak":true},{"text":"balukutakanu ya beno ya lusambulu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ntangu beno ke pesaka munu minkayulu ya kuyoka,","poem":1},{"lineBreak":true},{"text":"munkayulu ya beno ya madya ya bilanga,","poem":1},{"lineBreak":true},{"text":"yawu ke yangidikaka munu ve.","poem":1},{"lineBreak":true},{"text":"Minkayulu ya beno ya kiwisa,","poem":1},{"lineBreak":true},{"text":"minkayulu ya beno ya bibulu yina ke na mafuta,","poem":1},{"lineBreak":true},{"text":"mu ke yinaka yawu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Beno katula makelele ya banzimbu","poem":1},{"lineBreak":true},{"text":"ya beno na makutu ya munu.","poem":1},{"lineBreak":true},{"text":"Mu me manga na kuwa","poem":1},{"lineBreak":true},{"text":"muningu ya bansambi ya beno.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Beno bika ti lufundusu kusalama mbote,","poem":1},{"lineBreak":true},{"text":"mutindu maza ke tangaka,","poem":1},{"lineBreak":true},{"text":"ludedomo kuvwanda mutindu","poem":1},{"lineBreak":true},{"text":"muzumba ya maza yina ke yumaka ve!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":["«Bantu ya Isayeli, na bamvula makumi yiya yina beno salaka na yinsi ya kuyuma, beno pesaka munu minkayulu mpe makabu?"]},{"type":"verse","number":26,"content":["Kasi beno nataka Sikute, ntinu ya beno ya kiteki, mpe Kiyune, kiteki ya nzambi ya beno, mbwetete ya banzambi ya beno yina beno yidikaka.»"]},{"type":"verse","number":27,"content":[{"text":"«Ni yawu yina,","poem":1},{"lineBreak":true},{"text":"mu ke nata beno ntama","poem":1},{"lineBreak":true},{"text":"kuluta mbanza ya Damase.»","poem":1},{"lineBreak":true},{"text":"Ni Yave me tuba yawu.","poem":1},{"lineBreak":true},{"text":"Nkumbu ya yandi:","poem":1},{"lineBreak":true},{"text":"«Nzambi ya Binwani.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}