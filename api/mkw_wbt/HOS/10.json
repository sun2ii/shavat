{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"HOS","translationId":"mkw_wbt","name":"Oseya","commonName":"Oseya","title":"Dibuku ya OSEYA","order":28,"numberOfChapters":14,"sha256":"a132b6ae332f399aaf75150ac9a0a22b26c6bf240355823fa374d18784796325","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mkw_wbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"heading","content":["Nsukunu ya kintinu mpe ya kinzambi ya biteki"]},{"type":"verse","number":1,"content":[{"text":"Isayeli vwandaka mutindu","poem":1},{"lineBreak":true},{"text":"yinti ya vinu ya kitoko.","poem":1},{"lineBreak":true},{"text":"Yawu vwandaka lutila na kubuta","poem":1},{"lineBreak":true},{"text":"bambuma ya mingi.","poem":1},{"lineBreak":true},{"text":"Mutindu yawu vwandaka buta mingi,","poem":1},{"lineBreak":true},{"text":"ni mutindu yina mpe","poem":1},{"lineBreak":true},{"text":"Isayeli vwandaka yidika biyokolo mingi ya minkayulu.","poem":1},{"lineBreak":true},{"text":"Mutindu yinsi ya bawu","poem":1},{"lineBreak":true},{"text":"vwandaka lutila kitoko,","poem":1},{"lineBreak":true},{"text":"ni mutindu yina mpe bawu vwandaka","poem":1},{"lineBreak":true},{"text":"bongisa matadi ya bawu ya longo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bawu ke na bantima ya yimbi.","poem":1},{"lineBreak":true},{"text":"Ntangu yayi, bawu ke futa masumu ya bawu.","poem":1},{"lineBreak":true},{"text":"Yave, yandi mosi ke mwangisa","poem":1},{"lineBreak":true},{"text":"biyokolo ya bawu ya minkayulu.","poem":1},{"lineBreak":true},{"text":"Yandi ke mwangisa matadi ya bawu ya longo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ntangu yayi,","poem":1},{"lineBreak":true},{"text":"bawu ke na kutuba","poem":1},{"lineBreak":true},{"text":"mutindu yayi:","poem":1},{"lineBreak":true},{"text":"«Beto me zitisa ve Yave.","poem":1},{"lineBreak":true},{"text":"Ni yawu yina,","poem":1},{"lineBreak":true},{"text":"beto ke dyaka ve na ntinu.","poem":1},{"lineBreak":true},{"text":"Kasi bubu yayi,","poem":1},{"lineBreak":true},{"text":"yinki ntinu lenda kusala dyaka","poem":1},{"lineBreak":true},{"text":"samu na beto?»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bawu ke na kwendaka zonza.","poem":1},{"lineBreak":true},{"text":"Bawu ke na kudya bandefi ya luvunu.","poem":1},{"lineBreak":true},{"text":"Bawu ke na kusala bangwisani.","poem":1},{"lineBreak":true},{"text":"Mpe ludedomo ke na kukuma na bawu","poem":1},{"lineBreak":true},{"text":"mutindu yinti yina ke na pwazon","poem":1},{"lineBreak":true},{"text":"yina ke na kumena na mikala ya bilanga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bantu yina ke zingaka na Samaliya","poem":1},{"lineBreak":true},{"text":"kele na boma, samu na kiteki ya mwana ya ngombe","poem":1},{"lineBreak":true},{"text":"yina kele na Bete-Awene.","poem":1},{"lineBreak":true},{"text":"Bantu na banganga-Nzambi","poem":1},{"lineBreak":true},{"text":"me kota bufwidi samu na kiteki yina.","poem":1},{"lineBreak":true},{"text":"Bawu lenda kuyangalala","poem":1},{"lineBreak":true},{"text":"samu na nkembo ya kiteki yina,","poem":1},{"lineBreak":true},{"text":"kasi nkembo ya yawu ke na kukwenda ntama na bawu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ba ke nata Kiteki yango na Asili.","poem":1},{"lineBreak":true},{"text":"Ba ke pesa yawu mutindu","poem":1},{"lineBreak":true},{"text":"dikabu na ntinu Yaleve.","poem":1},{"lineBreak":true},{"text":"Efalayime ke tala nsoni,","poem":1},{"lineBreak":true},{"text":"mpe Isayeli ke vwanda na nsoni","poem":1},{"lineBreak":true},{"text":"ya mambu yina bawu me sadila.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yimeni samu na Samaliya.","poem":1},{"lineBreak":true},{"text":"Ntinu ya yandi ke na kufwa","poem":1},{"lineBreak":true},{"text":"mutindu kibuku ya yinti","poem":1},{"lineBreak":true},{"text":"na zulu ya maza.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bisika ya luvunu ya lusambulu yina kele na zulu ya myongo,","poem":1},{"lineBreak":true},{"text":"bisika yina bantu ya Isayeli sumukaka, yawu ke mwangana.","poem":1},{"lineBreak":true},{"text":"Bayinti ya bansende na matiti","poem":1},{"lineBreak":true},{"text":"ya bansende ke mena na zulu ya biyokolo ya bawu ya minkayulu.","poem":1},{"lineBreak":true},{"text":"Na yina, bawu ke tuba:","poem":1},{"lineBreak":true},{"text":"«Myongo, beno fuka beto!»","poem":1},{"lineBreak":true},{"text":"«Myongo ya fyoti, beno bwidila beto!»","poem":1}]},{"type":"heading","content":["Isayeli ke yonzika yina yandi me kunda"]},{"type":"verse","number":9,"content":[{"text":"«Kubanda na mambu ya yimbi","poem":1},{"lineBreak":true},{"text":"yina salamaka na Ngibeya,","poem":1},{"lineBreak":true},{"text":"Isayeli ke na kutatamana","poem":1},{"lineBreak":true},{"text":"na kusala masumu.","poem":1},{"lineBreak":true},{"text":"Yandi ke na kusoba ve.","poem":1},{"lineBreak":true},{"text":"Mvita samu na bantu ya yimbi,","poem":1},{"lineBreak":true},{"text":"ke bwidila ve bawu kuna na Ngibeya?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mu ke semba bawu mutindu mu zola.","poem":1},{"lineBreak":true},{"text":"Na yina, bantu ya bayinsi ke vukana","poem":1},{"lineBreak":true},{"text":"na kunwanisa bawu.","poem":1},{"lineBreak":true},{"text":"Ba ke kanga bawu na bampanga,","poem":1},{"lineBreak":true},{"text":"samu na yimbi ya bawu yina ba salaka bambala zole.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Efalayime vwandaka mwana","poem":1},{"lineBreak":true},{"text":"ya ngombe ya nkento ya kutumama.","poem":1},{"lineBreak":true},{"text":"Yandi vwandaka zola kusala kisalu","poem":1},{"lineBreak":true},{"text":"ya kudyata bambuma ya faline","poem":1},{"noteId":6},{"text":".","poem":1},{"lineBreak":true},{"text":"Kasi mu ke kanga yandi kipusu-pusu ya kisalu","poem":1},{"lineBreak":true},{"text":"na laka ya yandi ya kitoko.","poem":1},{"lineBreak":true},{"text":"Yuda ke balula ntoto,","poem":1},{"lineBreak":true},{"text":"Yakobi ke benda bansengo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Beno kunda mambu ya kudedama,","poem":1},{"lineBreak":true},{"text":"beno yonzika bambuma ya bumbote.","poem":1},{"lineBreak":true},{"text":"Beno sola bilanga ya malu-malu.","poem":1},{"lineBreak":true},{"text":"Ya me kuma ntangu ya kusosa Yave.","poem":1},{"lineBreak":true},{"text":"Beno sosa yandi tii ntangu yandi ke kwiza,","poem":1},{"lineBreak":true},{"text":"yandi ke nokisina beno ludedomo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Beno kundaka mambu ya yimbi,","poem":1},{"lineBreak":true},{"text":"beno yonzikaka mambu ya kudedama ve.","poem":1},{"lineBreak":true},{"text":"Beno kudyaka mbuma ya luvunu ya beno.","poem":1},{"lineBreak":true},{"text":"«Beno tulaka kivuvu ya beno","poem":1},{"lineBreak":true},{"text":"na banzila yina beno vwandaka landa,","poem":1},{"lineBreak":true},{"text":"mpe na lutangu ya binwani ya beno.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ni yawu yina,","poem":1},{"lineBreak":true},{"text":"makelele ke wakana na kati ya bantu ya nge.","poem":1},{"lineBreak":true},{"text":"Bambanza ya nge yina kele na bibaka ya lukengolo,","poem":1},{"lineBreak":true},{"text":"ke mwangana,","poem":1},{"lineBreak":true},{"text":"mutindu ntinu Salemane","poem":1},{"lineBreak":true},{"text":"mwangisaka Bete-Alebele,","poem":1},{"lineBreak":true},{"text":"na kilumbu ya mvita yina,","poem":1},{"lineBreak":true},{"text":"ba nikaka bamama","poem":1},{"lineBreak":true},{"text":"na zulu ya bana ya bawu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ni mambu yayi ke kumina beno","poem":1},{"lineBreak":true},{"text":"samu na Betele,","poem":1},{"lineBreak":true},{"text":"samu na yimbi ya beno ya kulutila","poem":1},{"lineBreak":true},{"text":"yina beno salaka.","poem":1},{"lineBreak":true},{"text":"Na suka-suka,","poem":1},{"lineBreak":true},{"text":"ba ke kufwa ntinu ya Isayeli.»","poem":1}]}],"footnotes":[{"noteId":6,"caller":"+","text":"10.11 kudyata bambuma kele mutindu ba vwandaka sadila samu na kukabula bambuma na matiti ya yawu.","reference":{"chapter":10,"verse":11}}]},"thisChapterLink":"/api/mkw_wbt/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}