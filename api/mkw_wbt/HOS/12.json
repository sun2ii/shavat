{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"HOS","translationId":"mkw_wbt","name":"Oseya","commonName":"Oseya","title":"Dibuku ya OSEYA","order":28,"numberOfChapters":14,"sha256":"a132b6ae332f399aaf75150ac9a0a22b26c6bf240355823fa374d18784796325","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mkw_wbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"heading","content":["Luvunu ya bantu ya Isayeli katuka mbandukulu"]},{"type":"verse","number":1,"content":[{"text":"Efalayime me zunga munu","poem":1},{"lineBreak":true},{"text":"na luvunu,","poem":1},{"lineBreak":true},{"text":"mutindu mosi mpe Isayeli na mambu ya","poem":1},{"lineBreak":true},{"text":"yandi ya luvunu.","poem":1},{"lineBreak":true},{"text":"Kasi Yuda ke ntete na kutambulaka na Nzambi","poem":1},{"lineBreak":true},{"text":"mpe yandi kele ya kukwikama","poem":1},{"lineBreak":true},{"text":"na bantu ya longo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Efalayime ke zolaka kuvwanda kintwadi na bantu,","poem":1},{"lineBreak":true},{"text":"yina kele mutindu mupepe.","poem":1},{"lineBreak":true},{"text":"Mpe konso kilumbu,","poem":1},{"lineBreak":true},{"text":"yandi ke landaka mupepe ya tiya yina ke yumisaka.","poem":1},{"lineBreak":true},{"text":"Yandi ke na kulutila na kwendaka sala,","poem":1},{"lineBreak":true},{"text":"mambu ya luvunu mpe yimbi.","poem":1},{"lineBreak":true},{"text":"Yandi me sala ngwisani na bantu ya Asili","poem":1},{"lineBreak":true},{"text":"mpe yandi ke na kutekisa mafuta na Ngipiti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yave ke na kufundisa bantu ya Yuda.","poem":1},{"lineBreak":true},{"text":"Yandi ke semba bantu ya Yakobi samu na ndyatulu ya bawu.","poem":1},{"lineBreak":true},{"text":"Mpe yandi ke futisa bawu mavanga ya bawu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Katuka ntangu Yakobi na Esawu vwandaka","poem":1},{"lineBreak":true},{"text":"na kati ya kivumu ya mama ya bawu,","poem":1},{"lineBreak":true},{"text":"Yakobi simbaka mpangi ya yandi Esawu na kinkoso.","poem":1},{"lineBreak":true},{"text":"Ntangu Yakobi kulaka, yandi nwanaka na Nzambi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yandi nwanaka na mbazi","poem":1},{"lineBreak":true},{"text":"mpe yandi nungaka.","poem":1},{"lineBreak":true},{"text":"Yandi dilaka,","poem":1},{"lineBreak":true},{"text":"mpe yandi bondilaka mbazi yango.","poem":1},{"lineBreak":true},{"text":"Yandi bwabanaka mbazi yina na Betele","poem":1},{"lineBreak":true},{"text":"mpe ni kuna Nzambi zonzilaka beto.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yave kele Nzambi ya binwani.","poem":1},{"lineBreak":true},{"text":"«Yave» kele nkumbu ya yandi,","poem":1},{"lineBreak":true},{"text":"ni mutindu yayi ba ke bambukilaka yandi moyo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"«Nge, vutuka na Nzambi ya nge.","poem":1},{"lineBreak":true},{"text":"Vwanda ya kukwikama","poem":1},{"lineBreak":true},{"text":"mpe sadila ludedomo.","poem":1},{"lineBreak":true},{"text":"Konso ntangu,","poem":1},{"lineBreak":true},{"text":"tula kivuvu ya nge na Nzambi ya nge.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Bantu ya Kaana kele na","poem":1},{"lineBreak":true},{"text":"kipezolo ya luvunu na","poem":1},{"lineBreak":true},{"text":"maboko ya bawu","poem":1},{"lineBreak":true},{"text":"mpe bawu ke zolaka kuvuna.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Efalayime ke na kutuba:","poem":1},{"lineBreak":true},{"text":"“Ya tsyelika mu me vwama.","poem":1},{"lineBreak":true},{"text":"Mu me kuzwa bimvwama","poem":1},{"lineBreak":true},{"text":"ya munu na kisalu ya munu.","poem":1},{"lineBreak":true},{"text":"Ba lenda kuzwa ve dyambu ya yimbi","poem":1},{"lineBreak":true},{"text":"yina kele disumu na munu.”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Munu, mu kele Yave Nzambi ya nge","poem":1},{"lineBreak":true},{"text":"kubanda na ntangu yina","poem":1},{"lineBreak":true},{"text":"nge vwandaka na yinsi ya Ngipiti.","poem":1},{"lineBreak":true},{"text":"Mu ke sala ti nge zinga dyaka","poem":1},{"lineBreak":true},{"text":"na kati ya bayinzo ya lele,","poem":1},{"lineBreak":true},{"text":"mutindu nge vwandaka sala","poem":1},{"lineBreak":true},{"text":"na bilumbu ya mbwabani ya mukembo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mu zonzaka na mimbikudi.","poem":1},{"lineBreak":true},{"text":"Mu pesaka bawu balumoni mingi.","poem":1},{"lineBreak":true},{"text":"Mu zonzaka na yinwa ya mimbikudi na bingana.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kana bantu ya Ngalaade ke na mavanga ya yimbi,","poem":1},{"lineBreak":true},{"text":"bawu ke kuma bantu ya mpamba.","poem":1},{"lineBreak":true},{"text":"Bawu ke na kupesa minkayulu ya","poem":1},{"lineBreak":true},{"text":"bangombe na Ngilengale.","poem":1},{"lineBreak":true},{"text":"Mpe biyokolo ya bawu ya minkayulu","poem":1},{"lineBreak":true},{"text":"ke kuma mutindu bikunku ya matadi","poem":1},{"lineBreak":true},{"text":"ya kumwangana na zulu ya mikala ya bilanga.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yakobi kimaka na ntoto ya Alame.","poem":1},{"lineBreak":true},{"text":"Kuna, yandi vwandaka sadila muntu ya nkaka,","poem":1},{"lineBreak":true},{"text":"samu na kukwela kento.","poem":1},{"lineBreak":true},{"text":"Mpe samu na kuzwa kento,","poem":1},{"lineBreak":true},{"text":"yandi kumaka munkebi ya mameme.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kasi Yave sadilaka mumbikudi mosi","poem":1},{"lineBreak":true},{"text":"samu na kubasisa Isayeli na Ngipiti.","poem":1},{"lineBreak":true},{"text":"Yandi sadilaka mpe mumbikudi","poem":1},{"lineBreak":true},{"text":"mosi samu na kukeba Isayeli.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Efalayime me fwemisa mingi Nzambi.","poem":1},{"lineBreak":true},{"text":"Ni yawu yina, lufwa ya bantu yina Efalayime kufwaka,","poem":1},{"lineBreak":true},{"text":"Mfumu, ya yandi Nzambi ke tula yawu","poem":1},{"lineBreak":true},{"text":"na zulu ya yintu ya yandi.","poem":1},{"lineBreak":true},{"text":"Nzambi ke futisa yandi","poem":1},{"lineBreak":true},{"text":"yimbi yina yandi salaka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":15}