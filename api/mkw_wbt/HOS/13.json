{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"HOS","translationId":"mkw_wbt","name":"Oseya","commonName":"Oseya","title":"Dibuku ya OSEYA","order":28,"numberOfChapters":14,"sha256":"a132b6ae332f399aaf75150ac9a0a22b26c6bf240355823fa374d18784796325","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mkw_wbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"heading","content":["Lufwa ya bantu ya Isayeli"]},{"type":"verse","number":1,"content":[{"text":"Ntangu Efalayime vwandaka zonza,","poem":1},{"lineBreak":true},{"text":"bantu nyonso vwandaka tala boma mingi.","poem":1},{"lineBreak":true},{"text":"Yandi vwandaka dyata bantu nyonso na Isayeli.","poem":1},{"lineBreak":true},{"text":"Kasi yandi salaka yimbi","poem":1},{"lineBreak":true},{"text":"na kusambila nzambi Baale.","poem":1},{"lineBreak":true},{"text":"Ni yawu yina, yandi me kufwa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Na ntangu yayi, bawu ke na","poem":1},{"lineBreak":true},{"text":"ku tatamana na kusumuka.","poem":1},{"lineBreak":true},{"text":"Bawu me yidika biteki samu na bawu mosi na palata ya bawu yina bawu me sulumuna na tiya.","poem":1},{"lineBreak":true},{"text":"Na mayela ya bawu,","poem":1},{"lineBreak":true},{"text":"bawu me yidika banzambi","poem":1},{"lineBreak":true},{"text":"ya biteki samu na bawu mosi.","poem":1},{"lineBreak":true},{"text":"Nyonso yina kele kaka","poem":1},{"lineBreak":true},{"text":"bisalu ya maboko ya bantu.","poem":1},{"lineBreak":true},{"text":"Samu na biteki yina, ba ke na","poem":1},{"lineBreak":true},{"text":"kutuba mutindu yayi:","poem":1},{"lineBreak":true},{"text":"«Bayina ke pesaka bantu mutindu","poem":1},{"lineBreak":true},{"text":"minkayulu lenda kuzitisa biteki bana ya bangombe!»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ni yawu yina, bawu ke kuma","poem":1},{"lineBreak":true},{"text":"mutindu dituti yina","poem":1},{"lineBreak":true},{"text":"ke basikaka na suka.","poem":1},{"lineBreak":true},{"text":"Bawu ke kuma mutindu kinoko","poem":1},{"lineBreak":true},{"text":"ya suka-suka yina ke yumaka","poem":1},{"lineBreak":true},{"text":"na mwa ntangu fyoti.","poem":1},{"lineBreak":true},{"text":"Bawu ke kuma mutindu matiti yina mupepe","poem":1},{"lineBreak":true},{"text":"me katula na kisika yina ba ke kabulaka","poem":1},{"lineBreak":true},{"text":"bambuma na matiti ya yawu","poem":1},{"lineBreak":true},{"text":"mpe ke na kunataka ntama.","poem":1},{"lineBreak":true},{"text":"Bawu ke kuma mutindu mulinga yina","poem":1},{"lineBreak":true},{"text":"ke basikaka na nela.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Munu, mu kele Yave Nzambi ya nge","poem":1},{"lineBreak":true},{"text":"kubanda na ntangu yina","poem":1},{"lineBreak":true},{"text":"ke vwandaka na yinsi ya Ngipiti.","poem":1},{"lineBreak":true},{"text":"Nge zabaka Nzambi ya nkaka ve,","poem":1},{"lineBreak":true},{"text":"kana kaka munu ve.","poem":1},{"lineBreak":true},{"text":"Ya kele mpe ve na Nzambi ya nkaka yina ke","poem":1},{"lineBreak":true},{"text":"vuukisaka, kana kaka ni munu ve.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mu zabaka nge na yinsi ya kuyuma,","poem":1},{"lineBreak":true},{"text":"na yinsi yina ke na tiya mingi mpe ntoto ya kukawuka.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Na ntangu yina nge kumaka","poem":1},{"lineBreak":true},{"text":"na kisika yina bibulu ke","poem":1},{"lineBreak":true},{"text":"kudyaka, nge kudyaka","poem":1},{"lineBreak":true},{"text":"mpe nge yukutaka.","poem":1},{"lineBreak":true},{"text":"Na manima ya kuyukuta,","poem":1},{"lineBreak":true},{"text":"nge fulukaka na lunangu.","poem":1},{"lineBreak":true},{"text":"Ni yawu yina nge zimbanaka munu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Na yina mu ke kuma mutindu","poem":1},{"lineBreak":true},{"text":"nkosi samu na beno.","poem":1},{"lineBreak":true},{"text":"Mu ke bumbama beno","poem":1},{"lineBreak":true},{"text":"na nzila mutindu yingo.","poem":1},{"lineBreak":true},{"text":"Mu ke na kuketa beno.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mu ke nwanisa beno","poem":1},{"lineBreak":true},{"text":"mutindu uluse, kibulu ya nsisi yina ba me botola bana.","poem":1},{"lineBreak":true},{"text":"Mu ke pasula bantulu ya beno.","poem":1},{"lineBreak":true},{"text":"Mu ke kudya beno kuna","poem":1},{"lineBreak":true},{"text":"mutindu nkosi ya kento.","poem":1},{"lineBreak":true},{"text":"Bibulu ya mfinda ke manisa","poem":1},{"lineBreak":true},{"text":"na kupasula bamvumbi ya beno.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Isayeli, nge me mwangana,","poem":1},{"lineBreak":true},{"text":"samu ti nge me kuma mbeni","poem":1},{"lineBreak":true},{"text":"ya munu.","poem":1},{"lineBreak":true},{"text":"Mbeni ya muntu yina lenda kusadisa nge.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wapi sika kele ntinu ya nge,","poem":1},{"lineBreak":true},{"text":"samu ti, yandi kuvuukisa nge na kati ya","poem":1},{"lineBreak":true},{"text":"bambanza ya nge nyonso?","poem":1},{"lineBreak":true},{"text":"Wapi sika kele bazuzi ya nge,","poem":1},{"lineBreak":true},{"text":"yina nge vwandaka tuba: «Pesa munu ntinu","poem":1},{"lineBreak":true},{"text":"mpe bamfumu»?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Na nkele ya munu,","poem":1},{"lineBreak":true},{"text":"mu pesaka nge ntinu.","poem":1},{"lineBreak":true},{"text":"Mpe na nkele ya munu ya kulutila,","poem":1},{"lineBreak":true},{"text":"mu ke katula nge yandi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ba me keba mbote yimbi ya Efalayime.","poem":1},{"lineBreak":true},{"text":"Ba me bumba mbote masumu ya yandi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bampasi ya kento yina ke na kubuta ke kumina yandi.","poem":1},{"lineBreak":true},{"text":"Kasi mwana yina fwana kubutuka ke na mayela ve:","poem":1},{"lineBreak":true},{"text":"Na ntangu ya kubutuka,","poem":1},{"lineBreak":true},{"text":"yandi ke manga na kubasika na kivumu ya mama ya yandi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mu zolaka kuula bawu na kubasisa","poem":1},{"lineBreak":true},{"text":"bawu ya yinsi ya bantu ya kufwa?","poem":1},{"lineBreak":true},{"text":"Mu zolaka vuukisa bawu na lufwa?","poem":1},{"lineBreak":true},{"text":"Lufwa, wapi binwanunu ya nge?","poem":1},{"lineBreak":true},{"text":"Yinsi ya bantu ya kufwa,","poem":1},{"lineBreak":true},{"text":"wapi sika kele lulendo ya nge ya kufwa bantu?","poem":1},{"lineBreak":true},{"text":"Mu ke tala dyaka ve bawu kyadi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ata ti Efalayime ke na kubonga","poem":1},{"lineBreak":true},{"text":"kulutila bampangi ya yandi,","poem":1},{"lineBreak":true},{"text":"mupepe ya tiya ke kwiza.","poem":1},{"lineBreak":true},{"text":"Mupepe ya Yave ke katuka na yinsi ya kuyuma.","poem":1},{"lineBreak":true},{"text":"Yawu ke kwiza yumisa mukelo ya yandi,","poem":1},{"lineBreak":true},{"text":"yinto ya maza ya yandi ke sika.","poem":1},{"lineBreak":true},{"text":"Ba ke botola bima nyonso ya ntalu yina kele","poem":1},{"lineBreak":true},{"text":"na bibumbulu ya yandi ya bimvwama.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":15}