{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"HOS","translationId":"mkw_wbt","name":"Oseya","commonName":"Oseya","title":"Dibuku ya OSEYA","order":28,"numberOfChapters":14,"sha256":"a132b6ae332f399aaf75150ac9a0a22b26c6bf240355823fa374d18784796325","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mkw_wbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Samaliya ke futa yimbi ya yandi samu ti,","poem":1},{"lineBreak":true},{"text":"yandi me manga na kutumama na Nzambi ya yandi.","poem":1},{"lineBreak":true},{"text":"Ba ke kufwa yandi na bambele ya mvita.","poem":1},{"lineBreak":true},{"text":"Ba ke nika bana ya yandi ya fyoti.","poem":1},{"lineBreak":true},{"text":"Mpe ba ke pasula bivumu ya bakento","poem":1},{"lineBreak":true},{"text":"ya yandi yina kele na bivumu.","poem":1}]},{"type":"heading","content":["Kuvutuka na Yave"]},{"type":"verse","number":2,"content":[{"text":"Isayeli, vutuka na Yave Nzambi ya nge,","poem":1},{"lineBreak":true},{"text":"samu ti, yimbi ya nge me bwisa nge.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Beno vutuka na Yave.","poem":1},{"lineBreak":true},{"text":"Beno zabisa yandi mambu yayi:","poem":1},{"lineBreak":true},{"text":"«Lemvokila yimbi nyonso ya beto.","poem":1},{"lineBreak":true},{"text":"Ndima mambu ya mbote yina ke na beto.","poem":1},{"lineBreak":true},{"text":"Beto ke pesa nge ve minkayulu ya bangombe,","poem":1},{"lineBreak":true},{"text":"kasi beto ke pesa nge bampova ya bayinwa","poem":1},{"lineBreak":true},{"text":"ya beto mutindu minkayulu.»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Asili ke vuukisa beto ve.","poem":1},{"lineBreak":true},{"text":"Beto ke vwanda ve","poem":1},{"lineBreak":true},{"text":"na zulu ya bampunda ya mvita.","poem":1},{"lineBreak":true},{"text":"Beto ke tuba dyaka ve","poem":1},{"lineBreak":true},{"text":"na bima yina beto yidikaka na maboko","poem":1},{"lineBreak":true},{"text":"ya beto «Nzambi ya beto»","poem":1},{"lineBreak":true},{"text":"samu ti, kaka ni nge","poem":1},{"lineBreak":true},{"text":"ke fwilaka mwana-nsaana kyadi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Mu ke belusa Isayeli na kimbevo ya yandi","poem":1},{"lineBreak":true},{"text":"ya kondwa kiminu na munu.","poem":1},{"lineBreak":true},{"text":"Mu ke zola yandi na ntima mosi","poem":1},{"lineBreak":true},{"text":"samu ti, mu ke dyaka ve na nkele na yandi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mu ke vwanda mutindu kinoko","poem":1},{"lineBreak":true},{"text":"samu na Isayeli.","poem":1},{"lineBreak":true},{"text":"Yandi ke basisa bifulu","poem":1},{"lineBreak":true},{"text":"mutindu yinti ya bifulu ke basisaka bifulu ya mbote.","poem":1},{"lineBreak":true},{"text":"Yandi ke mena myanzi mutindu bayinti ya","poem":1},{"lineBreak":true},{"text":"yinsi ya Libane.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bintala ya yawu ke yalumuka.","poem":1},{"lineBreak":true},{"text":"Kitoko ya yawu ke vwanda","poem":1},{"lineBreak":true},{"text":"mutindu yinti ya olive.","poem":1},{"lineBreak":true},{"text":"Nsunga ya yawu ke vwanda","poem":1},{"lineBreak":true},{"text":"mutindu nsunga ya bayinti","poem":1},{"lineBreak":true},{"text":"ya yinsi ya Libane.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bantu ke kwiza vwanda dyaka na yisi","poem":1},{"lineBreak":true},{"text":"ya mpewo ya yandi.","poem":1},{"lineBreak":true},{"text":"Bawu ke kunda dyaka bambuma ya faline","poem":1},{"lineBreak":true},{"text":"mpe yawu ke mena mbote.","poem":1},{"lineBreak":true},{"text":"Bawu ke buta bifulu mutindu bayinti ya vinu.","poem":1},{"lineBreak":true},{"text":"Bawu ke vwanda na nsangu","poem":1},{"lineBreak":true},{"text":"mutindu vinu ya yinsi ya Libane.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Efalayime, na yinki nge ke na kufwanikisa munu na biteki?","poem":1},{"lineBreak":true},{"text":"Munu, mu ke pesaka nge bamvutu,","poem":1},{"lineBreak":true},{"text":"mpe mu ke kebaka nge.","poem":1},{"lineBreak":true},{"text":"Munu, mu kele mutindu","poem":1},{"lineBreak":true},{"text":"yinti ya sipelese yina ke vwandaka","poem":1},{"lineBreak":true},{"text":"konso ntangu na makasa ya maza.","poem":1},{"lineBreak":true},{"text":"Ni munu ke butisaka bima","poem":1},{"lineBreak":true},{"text":"yina nge ke kundaka.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nani ke na ndwenga","poem":1},{"lineBreak":true},{"text":"samu na kuvisa mambu yayi?","poem":1},{"lineBreak":true},{"text":"Nani ke na mayela na kuzaba yawu?","poem":1},{"lineBreak":true},{"text":"Ya tsyelika, banzila ya Yave kele ya kusungama,","poem":1},{"lineBreak":true},{"text":"mpe bantu ya kudedama ke dyatilaka na yawu.","poem":1},{"lineBreak":true},{"text":"Kasi bayina ke tumamaka ve ke bulaka","poem":1},{"lineBreak":true},{"text":"mabaku na yawu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":10}