{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"HOS","translationId":"mkw_wbt","name":"Oseya","commonName":"Oseya","title":"Dibuku ya OSEYA","order":28,"numberOfChapters":14,"sha256":"a132b6ae332f399aaf75150ac9a0a22b26c6bf240355823fa374d18784796325","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mkw_wbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":2,"content":[{"type":"heading","content":["Nzambi ke ndima dyaka bantu ya yandi"]},{"type":"verse","number":1,"content":[{"text":"Kasi kilumbu kele,","poem":1},{"lineBreak":true},{"text":"yina lutangu ya bantu ya Isayeli","poem":1},{"lineBreak":true},{"text":"ke kuma mutindu munyenge ya mubu.","poem":1},{"lineBreak":true},{"text":"Ba ke fwanikisa yawu ve,","poem":1},{"lineBreak":true},{"text":"mpe ba ke lenda ve na kutanga","poem":1},{"lineBreak":true},{"text":"lutangu ya yawu.","poem":1},{"lineBreak":true},{"text":"Kisika yina ba vwandaka tuba na bawu:","poem":1},{"lineBreak":true},{"text":"«Beno kele ve bantu ya munu»,","poem":1},{"lineBreak":true},{"text":"ba ke tuba na bawu:","poem":1},{"lineBreak":true},{"text":"«Beno kele bana ya Nzambi ya moyo»","poem":1},{"noteId":0},{"text":".","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Na yina, bana ya Yuda","poem":1},{"lineBreak":true},{"text":"mpe bana ya Isayeli,","poem":1},{"lineBreak":true},{"text":"ke vukana, mpe bawu ke vwanda kisika mosi.","poem":1},{"lineBreak":true},{"text":"Bawu ke soola mfumu mosi","poem":1},{"lineBreak":true},{"text":"mpe bawu ke yala yinsi.","poem":1},{"lineBreak":true},{"text":"Yawu ke vwanda kilumbu ya nene ya Izeleele.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Beno tuba na bampangi ya beno:","poem":1},{"lineBreak":true},{"text":"«Ami» (yina zola kutuba bantu ya munu)","poem":1},{"lineBreak":true},{"text":"mpe na bibusi ya beno:","poem":1},{"lineBreak":true},{"text":"«Luwama» (yina zola kutuba yina ba ke fwilaka kyadi).","poem":1}]},{"type":"heading","content":["Isayeli, kento yina kele ve ya kukwikama"]},{"type":"verse","number":4,"content":[{"text":"Beno funda mama ya beno.","poem":1},{"lineBreak":true},{"text":"Beno funda yandi,","poem":1},{"lineBreak":true},{"text":"samu ti, yandi kele ve kento ya munu,","poem":1},{"lineBreak":true},{"text":"mpe mu kele ve bakala ya yandi.","poem":1},{"lineBreak":true},{"text":"«Yandi katula na kizizi ya yandi bidimbu ya kindumba!","poem":1},{"lineBreak":true},{"text":"Mpe yandi katula bidimbu ya kinsuza na kati-kati ya mabene ya yandi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kana yandi sala yawu ve,","poem":1},{"lineBreak":true},{"text":"mu ke katula yandi binkuti nyonso.","poem":1},{"lineBreak":true},{"text":"Yandi ke vwanda,","poem":1},{"lineBreak":true},{"text":"mutindu kilumbu yina, ba butaka yandi.","poem":1},{"lineBreak":true},{"text":"Mu ke sala ti, yandi kukuma","poem":1},{"lineBreak":true},{"text":"mutindu yinsi ya kuyuma.","poem":1},{"lineBreak":true},{"text":"Mu ke sala ti yandi vwanda","poem":1},{"lineBreak":true},{"text":"mutindu ntoto ya kuyuma,","poem":1},{"lineBreak":true},{"text":"mpe mu ke kufwa yandi na nsatu ya maza.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Mu ke tala ve bana ya yandi kyadi,","poem":1},{"lineBreak":true},{"text":"samu ti, bawu kele bana yina,","poem":1},{"lineBreak":true},{"text":"ba kuzwaka na kindumba.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ee, mama ya bawu me sala kindumba,","poem":1},{"lineBreak":true},{"text":"mama yina nataka kivumu ya bawu,","poem":1},{"lineBreak":true},{"text":"me sala mambu ya nsoni.","poem":1},{"lineBreak":true},{"text":"Yandi vwandaka tuba:","poem":1},{"lineBreak":true},{"text":"Mu ke landa makangu ya munu","poem":1},{"lineBreak":true},{"text":"yina ke pesaka munu dimpa na maza,","poem":1},{"lineBreak":true},{"text":"lele ya mika ya mameme","poem":1},{"lineBreak":true},{"text":"mpe lele ya lino, mafuta mpe malafu.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ni yawu yina munu Yave,","poem":1},{"lineBreak":true},{"text":"mu ke kanga yandi nzila,","poem":1},{"lineBreak":true},{"text":"na bayinti ya bansende.","poem":1},{"lineBreak":true},{"text":"Mu ke zunga yawu na kibaka,","poem":1},{"lineBreak":true},{"text":"samu ti, yandi tala dyaka ve,","poem":1},{"lineBreak":true},{"text":"nzila ya yandi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yandi ke landa makangu ya yandi,","poem":1},{"lineBreak":true},{"text":"kasi yandi ke kuzwa ve bawu.","poem":1},{"lineBreak":true},{"text":"Yandi ke sosa bawu,","poem":1},{"lineBreak":true},{"text":"kasi yandi ke tala ve bawu.","poem":1},{"lineBreak":true},{"text":"Yandi ke tuba:","poem":1},{"lineBreak":true},{"text":"«Mu fwana kuvutuka na bakala ya munu ya ntete,","poem":1},{"lineBreak":true},{"text":"samu ti, luzingu ya munu","poem":1},{"lineBreak":true},{"text":"vwandaka ya kulutila mbote","poem":1},{"lineBreak":true},{"text":"na ya bubu yayi!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«Yandi vwandaka bakula ve","poem":1},{"lineBreak":true},{"text":"ti ni munu vwandaka pesa","poem":1},{"lineBreak":true},{"text":"yandi bambuma ya faline, vinu ya malu-malu mpe mafuta ya malu-malu.","poem":1},{"lineBreak":true},{"text":"Ni munu vwandaka vwamisa yandi","poem":1},{"lineBreak":true},{"text":"na kupesaka yandi wolo na palata","poem":1},{"lineBreak":true},{"text":"yina yandi vwandaka sadila","poem":1},{"lineBreak":true},{"text":"samu na kusambilaka Baale.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ni yawu yina,","poem":1},{"lineBreak":true},{"text":"mu ke kwiza botola yandi","poem":1},{"lineBreak":true},{"text":"bambuma ya munu ya faline","poem":1},{"lineBreak":true},{"text":"na ntangu yina, ba ke yonzikaka yawu mpe vinu ya munu ya malu-malu na ntangu ya yawu.","poem":1},{"lineBreak":true},{"text":"Mu ke botola yandi bilele ya munu ya mika ya mameme mpe bilele ya lino","poem":1},{"lineBreak":true},{"text":"yina yandi vwandaka vwata,","poem":1},{"lineBreak":true},{"text":"samu na kufuka kipene ya yandi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kasi na ntangu yayi,","poem":1},{"lineBreak":true},{"text":"mu ke katula yandi bilele,","poem":1},{"lineBreak":true},{"text":"samu na kufwisa yandi nsoni","poem":1},{"lineBreak":true},{"text":"na meso ya makangu ya yandi","poem":1},{"lineBreak":true},{"text":"mpe ata muntu ke kabikisa munu","poem":1},{"lineBreak":true},{"text":"na kusala yawu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mu ke sukisa kyese ya yandi,","poem":1},{"lineBreak":true},{"text":"mikembo ya yandi,","poem":1},{"lineBreak":true},{"text":"mikembo ya yandi yina yandi ke salaka","poem":1},{"lineBreak":true},{"text":"na bilumbu ya ntete ya bangonda.","poem":1},{"lineBreak":true},{"text":"Mu ke sukisa basaba ya yandi,","poem":1},{"lineBreak":true},{"text":"mpe mikembo ya yandi nyonso.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mu ke mwangisa bilanga ya yandi","poem":1},{"lineBreak":true},{"text":"ya bayinti ya vinu mpe ya bafike»,","poem":1},{"lineBreak":true},{"text":"yina yandi vwandaka tuba:","poem":1},{"lineBreak":true},{"text":"«Yayi ni difuta yina makangu ya","poem":1},{"lineBreak":true},{"text":"munu pesaka munu.»","poem":1},{"lineBreak":true},{"text":"«Mu ke sala ti bilanga yango,","poem":1},{"lineBreak":true},{"text":"kukuma mfinda kisika bibulu ya mfinda","poem":1},{"lineBreak":true},{"text":"ke banda na kwizaka kudya.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mu ke pesa yandi kitumbu,","poem":1},{"lineBreak":true},{"text":"samu na bilumbu yina,","poem":1},{"lineBreak":true},{"text":"yandi vwandaka sadila Baale,","poem":1},{"lineBreak":true},{"text":"ntangu yandi vwandaka yoka Maaka ya nsunga ya mbote,","poem":1},{"lineBreak":true},{"text":"yandi vwandaka vwata milunga ya misapi","poem":1},{"lineBreak":true},{"text":"mpe bampanga na laka,","poem":1},{"lineBreak":true},{"text":"yandi vwandaka landa makangu ya yandi","poem":1},{"lineBreak":true},{"text":"mpe vwandaka zimbana munu.","poem":1},{"lineBreak":true},{"text":"Ni Yave me tuba yawu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ni yawu yina,","poem":1},{"lineBreak":true},{"text":"mu ke leba yandi,","poem":1},{"lineBreak":true},{"text":"mu ke benda yandi na yinsi ya kuyuma","poem":1},{"lineBreak":true},{"text":"mpe mu ke zonza na ntima ya yandi,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"mpe kuna, mu ke vutula yandi bilanga ya yandi ya bayinti ya vinu","poem":1},{"lineBreak":true},{"text":"mpe mu ke sala ti mudimba ya Akole","poem":1},{"noteId":1},{"text":",","poem":1},{"lineBreak":true},{"text":"kukuma mwelo yina,","poem":1},{"lineBreak":true},{"text":"ke pesa yandi kivuvu.","poem":1},{"lineBreak":true},{"text":"Yandi ke landa dyaka munu","poem":1},{"lineBreak":true},{"text":"mutindu yandi vwandaka sala yawu","poem":1},{"lineBreak":true},{"text":"ntangu yandi vwandaka ntwenya,","poem":1},{"lineBreak":true},{"text":"mpe mutindu ntangu yina yandi","poem":1},{"lineBreak":true},{"text":"basikaka na Ngipiti.»","poem":1}]},{"type":"heading","content":["Kilumbu ya kuvutula ngwisani"]},{"type":"verse","number":18,"content":[{"text":"«Yave ke na kutuba, na kilumbu yina,","poem":1},{"lineBreak":true},{"text":"yandi ke bokila munu “Bakala ya munu”,","poem":1},{"lineBreak":true},{"text":"mpe yandi ke bokila dyaka munu ve,","poem":1},{"lineBreak":true},{"text":"“Baale ya munu”, (yina zola kutuba mfumu ya munu).","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mu ke sala ti yandi bika na","poem":1},{"lineBreak":true},{"text":"kutangunaka dyaka nkumbu ya Baale,","poem":1},{"lineBreak":true},{"text":"mpe bankumbu ya banzambi ya mutindu yina,","poem":1},{"lineBreak":true},{"text":"ba ke zonzila dyaka yawu ve.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Na kilumbu yina,","poem":1},{"lineBreak":true},{"text":"mu ke tula na bantu ya munu,","poem":1},{"lineBreak":true},{"text":"ngwisani na bibulu ya mfinda,","poem":1},{"lineBreak":true},{"text":"na bandeke ya mazulu,","poem":1},{"lineBreak":true},{"text":"na bibulu ya fyoti yina kele na ntoto.","poem":1},{"lineBreak":true},{"text":"Mu ke zenga minani ya mvita,","poem":1},{"lineBreak":true},{"text":"mpe bambele ya mvita.","poem":1},{"lineBreak":true},{"text":"Mu ke sukisa mvita,","poem":1},{"lineBreak":true},{"text":"nyonso yina ke zimbana","poem":1},{"lineBreak":true},{"text":"mpe mu ke sala ti,","poem":1},{"lineBreak":true},{"text":"bantu ya munu lala na kizunu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Isayeli, nge ke vwanda","poem":1},{"lineBreak":true},{"text":"kento ya munu,","poem":1},{"lineBreak":true},{"text":"ya bamvula na bamvula.","poem":1},{"lineBreak":true},{"text":"Na kukwela nge,","poem":1},{"lineBreak":true},{"text":"mu ke futa ntalu yayi:","poem":1},{"lineBreak":true},{"text":"ludedomo, kusungama,","poem":1},{"lineBreak":true},{"text":"kukwikama mpe luzolo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mu ke kwela nge na kukwikama nyonso,","poem":1},{"lineBreak":true},{"text":"mpe nge ke zaba mbote Yave.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Yave ke na kutuba:","poem":1},{"lineBreak":true},{"text":"Na kilumbu yina,","poem":1},{"lineBreak":true},{"text":"mu ke pesa mvutu.","poem":1},{"lineBreak":true},{"text":"Mu ke pesa mvutu na mazulu","poem":1},{"lineBreak":true},{"text":"mpe mazulu ke pesa mvutu na ntoto.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ntoto ke vutula mvutu na kupesa bambuma ya faline,","poem":1},{"lineBreak":true},{"text":"vinu ya malu-malu,","poem":1},{"lineBreak":true},{"text":"mpe mafuta ya malu-malu.","poem":1},{"lineBreak":true},{"text":"Mpe bima yayi ke pesa mvutu na Izeleele.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Mu ke sala ti,","poem":1},{"lineBreak":true},{"text":"yandi vwanda mutindu bambuma","poem":1},{"lineBreak":true},{"text":"ba me mwanga na yinsi nyonso samu na munu.","poem":1},{"lineBreak":true},{"text":"Mu ke fwila Lo-Luwama kyadi.","poem":1},{"lineBreak":true},{"text":"Mu ke tuba na Lo-Ami:","poem":1},{"lineBreak":true},{"text":"“Nge kele bantu ya munu”,","poem":1},{"lineBreak":true},{"text":"mpe yandi ke tuba:","poem":1},{"lineBreak":true},{"text":"“Nzambi ya munu.”»","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":0,"caller":"+","text":"2.1 Na kati ya babibila ya nkaka, 2.1 mpe 2.2 kele ni 1.10 mpe 1.11, mutindu mosi mpe na yina me tadila 2.3-25 kele ni 2.1-23. Nsukunu ya yawu, kele mpe na Lom 9.26.","reference":{"chapter":2,"verse":1}},{"noteId":1,"caller":"+","text":"2.17 Akole zola kutuba: Kisika ya kyadi.","reference":{"chapter":2,"verse":17}}]},"thisChapterLink":"/api/mkw_wbt/HOS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/HOS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/HOS/1.json","previousChapterAudioLinks":{},"numberOfVerses":25}