{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"HOS","translationId":"mkw_wbt","name":"Oseya","commonName":"Oseya","title":"Dibuku ya OSEYA","order":28,"numberOfChapters":14,"sha256":"a132b6ae332f399aaf75150ac9a0a22b26c6bf240355823fa374d18784796325","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mkw_wbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["Yave ke na kubokila bantu ya yandi na lufundusu"]},{"type":"verse","number":1,"content":[{"text":"Beno bantu ya Isayeli,","poem":1},{"lineBreak":true},{"text":"beno kuwa mambu ya Yave.","poem":1},{"lineBreak":true},{"text":"Yave ke na kubokila na lufundusu","poem":1},{"lineBreak":true},{"text":"bantu yina ke zingaka na yinsi,","poem":1},{"lineBreak":true},{"text":"yandi ke na kutuba:","poem":1},{"lineBreak":true},{"text":"«Butsyelika kele ve,","poem":1},{"lineBreak":true},{"text":"luzolo ya mpangi kele ve,","poem":1},{"lineBreak":true},{"text":"luzabu ya Nzambi kele ve na yinsi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bisika nyonso ba ke na kusinga,","poem":1},{"lineBreak":true},{"text":"kuvuna, kufwa bantu,","poem":1},{"lineBreak":true},{"text":"kulaba, kusadila kinsuza,","poem":1},{"lineBreak":true},{"text":"mpe menga ke na kumwanganaka kaka.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ni yawu yina, yinsi ke vwanda na kati ya kyadi,","poem":1},{"lineBreak":true},{"text":"bayina nyonso ke zingaka kuna","poem":1},{"lineBreak":true},{"text":"ke manisa na kufwa.","poem":1},{"lineBreak":true},{"text":"Ya vwanda bibulu ya mfinda,","poem":1},{"lineBreak":true},{"text":"bandeke ya mazulu,","poem":1},{"lineBreak":true},{"text":"bambisi ya mubu mpe, ke zimbana.»","poem":1}]},{"type":"heading","content":["Yave ke na kufunda banganga-Nzambi"]},{"type":"verse","number":4,"content":[{"text":"«Ata muntu kufunda nge,","poem":1},{"lineBreak":true},{"text":"ata muntu kusemba nge,","poem":1},{"lineBreak":true},{"text":"samu ti, bantu ya nge","poem":1},{"lineBreak":true},{"text":"kele mutindu bayina","poem":1},{"lineBreak":true},{"text":"ke fundaka banganga-Nzambi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nge ke bula dibaku na ntangu,","poem":1},{"lineBreak":true},{"text":"mimbikudi ya nge mpe","poem":1},{"lineBreak":true},{"text":"ke bula mabaku na mpimpa,","poem":1},{"lineBreak":true},{"text":"Mu ke kufwa mama ya nge.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bantu ya munu ke na kufwa,","poem":1},{"lineBreak":true},{"text":"samu ti, bawu kele ve na luzabu.","poem":1},{"lineBreak":true},{"text":"Mutindu nge me losa luzabu,","poem":1},{"lineBreak":true},{"text":"mu ke losa nge,","poem":1},{"lineBreak":true},{"text":"mpe nge ke sala dyaka ve","poem":1},{"lineBreak":true},{"text":"kisalu ya bunganga-Nzambi samu na munu.","poem":1},{"lineBreak":true},{"text":"Mutindu nge me zimbana","poem":1},{"lineBreak":true},{"text":"Musiku ya Nzambi ya nge,","poem":1},{"lineBreak":true},{"text":"munu mpe, mu ke zimbana bana ya nge.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Mutindu bawu kumaka mingi,","poem":1},{"lineBreak":true},{"text":"ni mutindu yina mpe,","poem":1},{"lineBreak":true},{"text":"masumu ya bawu kumaka mingi.","poem":1},{"lineBreak":true},{"text":"Mu ke kitula nkembo ya bawu na nsoni.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bawu ke kuzwaka madya","poem":1},{"lineBreak":true},{"text":"na minkayulu yina","poem":1},{"lineBreak":true},{"text":"bantu ya munu ke pesaka,","poem":1},{"lineBreak":true},{"text":"samu na mulemvo ya masumu.","poem":1},{"lineBreak":true},{"text":"Ni yawu yina, bawu ke zolaka","poem":1},{"lineBreak":true},{"text":"ti bantu ya munu kusala masumu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kitumbu yina bantu ke kuzwa,","poem":1},{"lineBreak":true},{"text":"kaka ni yawu mpe banganga-Nzambi ke kuzwa.","poem":1},{"lineBreak":true},{"text":"Mu ke pesa bawu musendo na ndyatulu ya bawu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bawu ke kudya,","poem":1},{"lineBreak":true},{"text":"kasi bawu ke yukuta ve.","poem":1},{"lineBreak":true},{"text":"Bawu ke sala kindumba,","poem":1},{"lineBreak":true},{"text":"kasi bawu ke buta ve,","poem":1},{"lineBreak":true},{"text":"samu ti, bawu ke na kuzitisa dyaka ve Yave.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Kindumba, vinu ya ngolo","poem":1},{"lineBreak":true},{"text":"na vinu ya malu-malu","poem":1},{"lineBreak":true},{"text":"ke na kupesaka bawu buzoba.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bantu ya munu","poem":1},{"lineBreak":true},{"text":"ke talisaka mambu ya bawu na kiteki ya yinti,","poem":1},{"lineBreak":true},{"text":"mpe, ni kibuku ya mukawa ke zabisaka bawu mambu.","poem":1},{"lineBreak":true},{"text":"Ya tsyelika mpeve ya kindumba","poem":1},{"lineBreak":true},{"text":"ke na kuzimbisa bawu.","poem":1},{"lineBreak":true},{"text":"Na kindumba yina bawu ke na kusala,","poem":1},{"lineBreak":true},{"text":"bawu ke na kukabuka na Nzambi ya bawu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bawu ke na kifu ya kupesaka minkayulu","poem":1},{"lineBreak":true},{"text":"na zulu ya myongo.","poem":1},{"lineBreak":true},{"text":"Bawu ke yokaka maaka ya nsunga ya mbote na myongo ya fyoti","poem":1},{"lineBreak":true},{"text":"na yisi ya bayinti yina kele na mpewo ya mbote.","poem":1},{"lineBreak":true},{"text":"Ni yawu yina, bana ya beno ya bakento","poem":1},{"lineBreak":true},{"text":"ke na kusala kindumba,","poem":1},{"lineBreak":true},{"text":"mpe bakento ya bana ya beno ke na kusala kinsuza.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mu ke pesa ve kitumbu na bana ya beno ya","poem":1},{"lineBreak":true},{"text":"bakento, yina ke na kusala kindumba,","poem":1},{"lineBreak":true},{"text":"mpe bakento ya bana ya beno,","poem":1},{"lineBreak":true},{"text":"yina ke na kusala kinsuza,","poem":1},{"lineBreak":true},{"text":"samu ti, bawu mosi banganga-Nzambi","poem":1},{"lineBreak":true},{"text":"ke basikaka na bakento yina ke salaka kindumba.","poem":1},{"lineBreak":true},{"text":"Bawu ke pesaka minkayulu","poem":1},{"lineBreak":true},{"text":"kintwadi na bakento yina ke salaka","poem":1},{"lineBreak":true},{"text":"kindumba na nkumbu ya nzambi,","poem":1},{"lineBreak":true},{"text":"mutindu ke tubaka kingana yayi:","poem":1},{"lineBreak":true},{"text":"“Bantu yina kele ve na mayela ya","poem":1},{"lineBreak":true},{"text":"kuswasikisa mambu, kele bantu ya kufwa.”»","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Nge Isayeli, kana nge sala kindumba,","poem":1},{"lineBreak":true},{"text":"bantu ya Yuda kusala yawu ve.","poem":1},{"lineBreak":true},{"text":"Beno kwenda ve na Ngilengale","poem":1},{"noteId":3},{"text":",","poem":1},{"lineBreak":true},{"text":"beno kwenda ve na Bete-Awene.","poem":1},{"lineBreak":true},{"text":"Beno kudya ve ndefi na kutuba ti:","poem":1},{"lineBreak":true},{"text":"“Yave kele moyo!”»","poem":1}]},{"type":"verse","number":16,"content":["Ya tsyelika, Isayeli me kuma na yintu ngolo mutindu mwana ya ngombe ya kento yina kele na nkele. Wapi mutindu beno zola ti, Yave kudikila bawu mutindu bana ya mameme yina ba ke na kunata na kisika yina bawu ke kudyaka?"]},{"type":"verse","number":17,"content":["Bantu ya Efalayime",{"noteId":4},"me kangama na biteki. Beno bika bawu."]},{"type":"verse","number":18,"content":["Ntangu bawu ke manisaka na kunwa, bawu ke lutaka na kindumba. Bamfumu ya bawu ke zolaka mambu ya nsoni."]},{"type":"verse","number":19,"content":["Kitembo ya ngolo ke nata bawu, mpe bawu ke tala nsoni, samu na minkayulu ya bawu."]}],"footnotes":[{"noteId":3,"caller":"+","text":"4.15 Ngilengale vwandaka kisika ya kupesilaka minkayulu.","reference":{"chapter":4,"verse":15}},{"noteId":4,"caller":"+","text":"4.17 EfalayimeYa kele nkumbu ya kifumba mosi yina me lutila nene na kimfumu ya Isayeli, kimfumu ya londe. Kasi awa yawu kele ni kimfumu nyonso ya Isayeli.","reference":{"chapter":4,"verse":17}}]},"thisChapterLink":"/api/mkw_wbt/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}