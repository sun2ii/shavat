{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"HOS","translationId":"mkw_wbt","name":"Oseya","commonName":"Oseya","title":"Dibuku ya OSEYA","order":28,"numberOfChapters":14,"sha256":"a132b6ae332f399aaf75150ac9a0a22b26c6bf240355823fa374d18784796325","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mkw_wbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["Bipesi-malongi ya yimbi na Isayeli"]},{"type":"verse","number":1,"content":[{"text":"Beno banganga-Nzambi,","poem":1},{"lineBreak":true},{"text":"beno kuwa dyambu yayi.","poem":1},{"lineBreak":true},{"text":"Beno bantu ya Isayeli,","poem":1},{"lineBreak":true},{"text":"beno sala keba.","poem":1},{"lineBreak":true},{"text":"Beno bantu ya yinzo ya ntinu,","poem":1},{"lineBreak":true},{"text":"beno fungula makutu.","poem":1},{"lineBreak":true},{"text":"Beno bayina zolaka sala ti ludedomo kuvwanda,","poem":1},{"lineBreak":true},{"text":"ni beno me kuma mutambu na bwala Misepa.","poem":1},{"lineBreak":true},{"text":"Beno me kuma mpwasa,","poem":1},{"lineBreak":true},{"text":"yina ba me tanda na zulu","poem":1},{"lineBreak":true},{"text":"ya mongo ya Tabole.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bayina ke na kusadila yimbi,","poem":1},{"lineBreak":true},{"text":"ke na kulutila na kusala yimbi.","poem":1},{"lineBreak":true},{"text":"Munu, mu ke na kukubika","poem":1},{"lineBreak":true},{"text":"kitumbu, samu na bawu nyonso.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«Munu, mu zaba Efalayime,","poem":1},{"lineBreak":true},{"text":"mpe Isayeli kele ve ya","poem":1},{"lineBreak":true},{"text":"kubumbama na meso ya munu.","poem":1},{"lineBreak":true},{"text":"Efalayime, kindumba yina","poem":1},{"lineBreak":true},{"text":"nge me sala, yawu me sala ti,","poem":1},{"lineBreak":true},{"text":"Isayeli kuvwanda dyaka ve ya kuvedila.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mavanga ya bawu,","poem":1},{"lineBreak":true},{"text":"ke na kukabikisa bawu","poem":1},{"lineBreak":true},{"text":"na kuvutuka na Nzambi ya bawu","poem":1},{"lineBreak":true},{"text":"samu ti, mpeve ya kindumba kele na bawu,","poem":1},{"lineBreak":true},{"text":"mpe bawu zaba ve Yave.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kasi, lunangu ya bantu ya Isayeli","poem":1},{"lineBreak":true},{"text":"ke na kufunda bawu.","poem":1},{"lineBreak":true},{"text":"Bantu ya Isayeli mpe","poem":1},{"lineBreak":true},{"text":"bantu ya Efalayime ke banda","poem":1},{"lineBreak":true},{"text":"na kwendaka bula mabaku","poem":1},{"lineBreak":true},{"text":"samu na masumu ya bawu mosi.","poem":1},{"lineBreak":true},{"text":"Bantu ya Yuda mpe","poem":1},{"lineBreak":true},{"text":"ke banda na kwendaka","poem":1},{"lineBreak":true},{"text":"bula mabaku kintwadi na bawu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bawu na bangombe ya bawu,","poem":1},{"lineBreak":true},{"text":"na mameme, na bankombo,","poem":1},{"lineBreak":true},{"text":"bawu ke kwenda sosa Yave,","poem":1},{"lineBreak":true},{"text":"kasi bawu ke tala yandi ve.","poem":1},{"lineBreak":true},{"text":"Yandi ke kuma ntama na bawu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bawu me vwanda ve ya kukwikama na Yave,","poem":1},{"lineBreak":true},{"text":"samu ti, bawu me buta bana na makangu.","poem":1},{"lineBreak":true},{"text":"Ni yawu yina, kaka na ngonda mosi,","poem":1},{"lineBreak":true},{"text":"bawu na bimvwama ya bawu ke mwangana.","poem":1}]},{"type":"heading","content":["Mvita ya Efalayime na Yuda"]},{"type":"verse","number":8,"content":[{"text":"Beno sika mpungi na mbanza Ngibeya.","poem":1},{"lineBreak":true},{"text":"Beno sika kulumenta na mbanza Lama.","poem":1},{"lineBreak":true},{"text":"Beno sala milolo ya mvita","poem":1},{"lineBreak":true},{"text":"na mbanza Bete-Avene.","poem":1},{"lineBreak":true},{"text":"Nge Bezame, sala keba samu ti,","poem":1},{"lineBreak":true},{"text":"mbeni kele na manima ya nge.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Efalayime ke mwangana","poem":1},{"lineBreak":true},{"text":"na kilumbu ya nsembolo.","poem":1},{"lineBreak":true},{"text":"Mu ke na kuzabisa dyambu","poem":1},{"lineBreak":true},{"text":"ya tsyelika na bifumba ya Isayeli.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bamfumu ya Yuda","poem":1},{"lineBreak":true},{"text":"kele mutindu bantu yina ke sobaka bandilu.","poem":1},{"lineBreak":true},{"text":"Mu ke dasukila bawu","poem":1},{"lineBreak":true},{"text":"mutindu nyamba ya maza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Efalayime ke na kunyokwama.","poem":1},{"lineBreak":true},{"text":"Lufundusu me nika bawu","poem":1},{"lineBreak":true},{"text":"samu ti, yandi vwandaka","poem":1},{"lineBreak":true},{"text":"tatamana na kusadila mambu","poem":1},{"lineBreak":true},{"text":"yina ntima ya yandi vwandaka zola.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mu ke vwanda mutindu makoko ya yintu,","poem":1},{"lineBreak":true},{"text":"samu na Efalayime.","poem":1},{"lineBreak":true},{"text":"Mu ke vwanda mutindu","poem":1},{"lineBreak":true},{"text":"mputa ya kubola, samu na dikanda ya Yuda.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Efalayime me tala kimbevo ya yandi.","poem":1},{"lineBreak":true},{"text":"Yuda me tala mputa ya yandi.","poem":1},{"lineBreak":true},{"text":"Efalayime me kwenda na yinsi ya Asili.","poem":1},{"lineBreak":true},{"text":"Yandi me fidisa bantumwa na ntinu Yaleve.","poem":1},{"lineBreak":true},{"text":"Kasi yandi ke lenda ve na kunyakisa beno,","poem":1},{"lineBreak":true},{"text":"to kubelusa mputa ya beno,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"samu ti, mu ke vwanda mutindu nkosi","poem":1},{"lineBreak":true},{"text":"samu na Efalayime.","poem":1},{"lineBreak":true},{"text":"Mu ke vwanda mutindu nkosi ya ntwenya, samu na dikanda ya Yuda.","poem":1},{"lineBreak":true},{"text":"Munu, mu ke pasula yawu.","poem":1},{"lineBreak":true},{"text":"Mu ke kwenda na yawu,","poem":1},{"lineBreak":true},{"text":"mpe ata muntu ke botola munu yawu.»","poem":1}]},{"type":"heading","content":["Nzambi ke na kubenda nzutu"]},{"type":"verse","number":15,"content":[{"text":"«Mu ke kwenda ya munu.","poem":1},{"lineBreak":true},{"text":"Mu ke vutuka na kisika ya munu,","poem":1},{"lineBreak":true},{"text":"tii na ntangu yina bawu","poem":1},{"lineBreak":true},{"text":"ke ndima yimbi ya bawu,","poem":1},{"lineBreak":true},{"text":"mpe bawu ke sosa dyaka","poem":1},{"lineBreak":true},{"text":"kizizi ya munu.","poem":1},{"lineBreak":true},{"text":"Na bampasi ya bawu ya kulutila,","poem":1},{"lineBreak":true},{"text":"bawu ke sosa munu.»","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}