{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"HOS","translationId":"mkw_wbt","name":"Oseya","commonName":"Oseya","title":"Dibuku ya OSEYA","order":28,"numberOfChapters":14,"sha256":"a132b6ae332f399aaf75150ac9a0a22b26c6bf240355823fa374d18784796325","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mkw_wbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Na yina, beno ke na kutuba:","poem":1},{"lineBreak":true},{"text":"«Beno kwiza, beto vutuka na Yave,","poem":1},{"lineBreak":true},{"text":"samu ti, ni yandi me talisa beto mpasi,","poem":1},{"lineBreak":true},{"text":"ni yandi mpe ke nyakisa beto.","poem":1},{"lineBreak":true},{"text":"Yandi me lwalisa beto,","poem":1},{"lineBreak":true},{"text":"ni yandi mpe ke belusa bamputa ya beto.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Na bilumbu zole,","poem":1},{"lineBreak":true},{"text":"yandi ke vutula beto luzingu.","poem":1},{"lineBreak":true},{"text":"Na kilumbu ya tatu,","poem":1},{"lineBreak":true},{"text":"yandi ke telemisa beto","poem":1},{"lineBreak":true},{"text":"mpe beto ke zinga na ntadisi ya yandi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Beto sala ngolo na kuzaba Yave.","poem":1},{"lineBreak":true},{"text":"Nkwizulu ya yandi ke vwanda","poem":1},{"lineBreak":true},{"text":"ya tsyelika mutindu nsemo ya suka-suka.","poem":1},{"lineBreak":true},{"text":"Yandi ke kwiza na beto","poem":1},{"lineBreak":true},{"text":"mutindu ke kwizilaka mvula.","poem":1},{"lineBreak":true},{"text":"Mutindu mvula ya ntombo,","poem":1},{"lineBreak":true},{"text":"yina ke salaka ti ntoto basisa madya.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kasi Yave ke na kuvutula:","poem":1},{"lineBreak":true},{"text":"«Efalayime, yinki mu ke sala na nge?","poem":1},{"lineBreak":true},{"text":"Yuda, yinki mu ke sala na nge?","poem":1},{"lineBreak":true},{"text":"Kukwikama ya beno,","poem":1},{"lineBreak":true},{"text":"kele mutindu dituti yina","poem":1},{"lineBreak":true},{"text":"ke basikaka na suka.","poem":1},{"lineBreak":true},{"text":"Yawu kele mpe mutindu","poem":1},{"lineBreak":true},{"text":"kinoko ya suka-suka yina","poem":1},{"lineBreak":true},{"text":"ke yumaka na mwa ntangu fyoti!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ni yawu yina, mu me bula","poem":1},{"lineBreak":true},{"text":"beno na mambu yina me basika","poem":1},{"lineBreak":true},{"text":"na yinwa ya mimbikudi.","poem":1},{"lineBreak":true},{"text":"Mu me kufwa beno na mambu","poem":1},{"lineBreak":true},{"text":"yina me basika na yinwa ya munu.","poem":1},{"lineBreak":true},{"text":"Lufundusu ya munu ke talana","poem":1},{"lineBreak":true},{"text":"mutindu nsemo,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"samu ti, ni kukwikama mu","poem":1},{"lineBreak":true},{"text":"ke zolaka, kasi Minkayulu ve.","poem":1},{"lineBreak":true},{"text":"Mu ke zolaka luzabu ya Nzambi","poem":1},{"lineBreak":true},{"text":"kulutila minkayulu ya kuyoka.»","poem":1}]},{"type":"heading","content":["Yimbi ya kulutila na Isayeli"]},{"type":"verse","number":7,"content":[{"text":"«Kasi bawu, mutindu Adami,","poem":1},{"lineBreak":true},{"text":"bawu me zitisa ve ngwisani ya munu.","poem":1},{"lineBreak":true},{"text":"Bawu me vwanda ve ya kukwikama na munu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ngalaade kele mbanza ya bantu ya yimbi,","poem":1},{"lineBreak":true},{"text":"yawu kele ya kufuluka na menga.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mutindu nkonga ya binwani yina","poem":1},{"lineBreak":true},{"text":"me kubama na kubwila muntu,","poem":1},{"lineBreak":true},{"text":"nkonga ya banganga-Nzambi","poem":1},{"lineBreak":true},{"text":"ke na kufwa bantu na nzila ya Siseme.","poem":1},{"lineBreak":true},{"text":"Bawu ke na kusala mambu ya busafu!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mu me tala mambu ya busafu","poem":1},{"lineBreak":true},{"text":"ya kulutila na dikanda ya Isayeli.","poem":1},{"lineBreak":true},{"text":"Kindumba ya Efalayime","poem":1},{"lineBreak":true},{"text":"me sala ti Isayeli kuvwanda","poem":1},{"lineBreak":true},{"text":"dyaka ve ya kuvedila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Nge mpe Yuda,","poem":1},{"lineBreak":true},{"text":"mu me kubama samu na kuyonzika mavanga ya nge.»","poem":1},"Vwanzi ya nene mpe mpasi yina ke kwiza",{"text":"Yave ke na kutuba:","poem":1},{"lineBreak":true},{"text":"«Na ntangu yina mu zola kuvutula","poem":1},{"lineBreak":true},{"text":"luzingu ya mbote na bantu ya munu,","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}