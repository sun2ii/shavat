{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"HOS","translationId":"mkw_wbt","name":"Oseya","commonName":"Oseya","title":"Dibuku ya OSEYA","order":28,"numberOfChapters":14,"sha256":"a132b6ae332f399aaf75150ac9a0a22b26c6bf240355823fa374d18784796325","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mkw_wbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"na ntangu yina mu zola kunyakisa Isayeli,","poem":1},{"lineBreak":true},{"text":"yimbi ya Efalayime","poem":1},{"lineBreak":true},{"text":"na masumu ya Samaliya","poem":1},{"lineBreak":true},{"text":"me talana, samu ti,","poem":1},{"lineBreak":true},{"text":"bawu ke na kusadila luvunu.","poem":1},{"lineBreak":true},{"text":"Muyibi ke na kukota na yinzo,","poem":1},{"lineBreak":true},{"text":"nkonga ya binwani","poem":1},{"lineBreak":true},{"text":"me mwangana na ngaanda.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Na bantima ya bawu,","poem":1},{"lineBreak":true},{"text":"bawu ke na kuyindula ata fyoti ve ti,","poem":1},{"lineBreak":true},{"text":"mu me zimbana ve yimbi","poem":1},{"lineBreak":true},{"text":"yina bawu ke na kusala.","poem":1},{"lineBreak":true},{"text":"Na ntangu yayi, mavanga ya","poem":1},{"lineBreak":true},{"text":"bawu ke ya kukangama na bawu,","poem":1},{"lineBreak":true},{"text":"mpe mu ke na kutala yawu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na yimbi ya bawu,","poem":1},{"lineBreak":true},{"text":"bawu ke na kutalisa ntinu kilengi.","poem":1},{"lineBreak":true},{"text":"Na luvunu ya bawu,","poem":1},{"lineBreak":true},{"text":"bawu ke na kuyangidika bamfumu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bawu nyonso ke na kusala kinsuza.","poem":1},{"lineBreak":true},{"text":"Bawu kele mutindu bafuule yina","poem":1},{"lineBreak":true},{"text":"kisadi-mampa me tulaka tiya.","poem":1},{"lineBreak":true},{"text":"Yandi me bika na kubwela yawu tiya,","poem":1},{"lineBreak":true},{"text":"kubanda ntangu yina yandi yidikaka","poem":1},{"lineBreak":true},{"text":"kiputi ya faline,","poem":1},{"lineBreak":true},{"text":"tii na ntangu yina yawu ke funa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na kilumbu ya mukembo ya ntinu ya beto,","poem":1},{"lineBreak":true},{"text":"bamfumu ke belaka na manima","poem":1},{"lineBreak":true},{"text":"ya kunwa vinu ya mingi,","poem":1},{"lineBreak":true},{"text":"mpe ntinu ke salaka mutindu","poem":1},{"lineBreak":true},{"text":"bawu, na kusekaka bampangi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bayina ke kubikaka mambu ya yimbi,","poem":1},{"lineBreak":true},{"text":"bawu kele tiya mutindu bafuule.","poem":1},{"lineBreak":true},{"text":"Na mpimpa nyonso,","poem":1},{"lineBreak":true},{"text":"nkele ya bawu ke talanaka ve.","poem":1},{"lineBreak":true},{"text":"Kasi na suka,","poem":1},{"lineBreak":true},{"text":"nkele yango ke talanaka,","poem":1},{"lineBreak":true},{"text":"mpe yawu ke yokaka mutindu tiya ya nene.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bawu nyonso kele tiya mutindu fuule.","poem":1},{"lineBreak":true},{"text":"Bawu me kufwa bazuzi ya bawu.","poem":1},{"lineBreak":true},{"text":"Bantinu ya bawu nyonso me kufwa,","poem":1},{"lineBreak":true},{"text":"mpe ata muntu na kati ya bawu me bokila munu.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Efalayime ke na kuvukana na bantu ya nkaka.","poem":1},{"lineBreak":true},{"text":"Efalayime kele mutindu","poem":1},{"lineBreak":true},{"text":"galete yina ba me balula ve","poem":1},{"lineBreak":true},{"text":"mpe me nyenga lweka mosi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Banzenza ke na kumanisa yandi ngolo,","poem":1},{"lineBreak":true},{"text":"kasi yandi ke na kuzaba ve.","poem":1},{"lineBreak":true},{"text":"Yandi me kuma na","poem":1},{"lineBreak":true},{"text":"bansuki ya mpembe,","poem":1},{"lineBreak":true},{"text":"kasi yandi ke na kuzaba ve.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lunangu ya bantu Isayeli","poem":1},{"lineBreak":true},{"text":"ke na kufunda bawu.","poem":1},{"lineBreak":true},{"text":"Kasi bawu ke na kuvutuka ve","poem":1},{"lineBreak":true},{"text":"na Yave, Nzambi ya bawu.","poem":1},{"lineBreak":true},{"text":"Na kati ya mambu nyonso yina,","poem":1},{"lineBreak":true},{"text":"bawu me sosa ve yandi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Efalayime kele mutindu dibembe ya kizoba,","poem":1},{"lineBreak":true},{"text":"yina kele ve na mayela.","poem":1},{"lineBreak":true},{"text":"Bawu me bokila bantu ya Ngipiti,","poem":1},{"lineBreak":true},{"text":"bawu me kwenda tii na Asili.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Na ntangu yina bawu ke kwenda,","poem":1},{"lineBreak":true},{"text":"mu ke losila bawu mpwasa ya munu.","poem":1},{"lineBreak":true},{"text":"Mu ke bwisa bawu mutindu","poem":1},{"lineBreak":true},{"text":"bandeke ya mazulu.","poem":1},{"lineBreak":true},{"text":"Mu ke bwila bawu ntangu mu ke kuwa ti,","poem":1},{"lineBreak":true},{"text":"bawu me vukana.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Kyadi na bawu samu ti,","poem":1},{"lineBreak":true},{"text":"bawu me kima ntama na munu.","poem":1},{"lineBreak":true},{"text":"Yawu ke vwanda mwangusulu","poem":1},{"lineBreak":true},{"text":"mpe nyonso ke beba samu na bawu,","poem":1},{"lineBreak":true},{"text":"samu ti, bawu me manga","poem":1},{"lineBreak":true},{"text":"na kutumama na munu.","poem":1},{"lineBreak":true},{"text":"Munu, mu zolaka vuukisa bawu","poem":1},{"lineBreak":true},{"text":"kasi bawu ke na kuzonza mambu ya luvunu","poem":1},{"lineBreak":true},{"text":"samu na munu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bawu ke na kubokila munu","poem":1},{"lineBreak":true},{"text":"na ntima mosi ve.","poem":1},{"lineBreak":true},{"text":"Bawu ke na yawula na","poem":1},{"lineBreak":true},{"text":"zulu ya bamfulu ya bawu.","poem":1},{"lineBreak":true},{"text":"Bawu ke na kulwalisa banzutu","poem":1},{"lineBreak":true},{"text":"ya bawu samu na kuzwa","poem":1},{"lineBreak":true},{"text":"bambuma ya faline na","poem":1},{"lineBreak":true},{"text":"vinu ya malu-malu.","poem":1},{"lineBreak":true},{"text":"Na kusalaka mutindu yina,","poem":1},{"lineBreak":true},{"text":"bawu ke na kupesa munu manima.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Na kutala mbote,","poem":1},{"lineBreak":true},{"text":"ni munu longaka bawu.","poem":1},{"lineBreak":true},{"text":"Ni munu pesaka bawu ngolo,","poem":1},{"lineBreak":true},{"text":"kasi bawu me banzila munu mambu ya yimbi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kana bawu ke vutuka,","poem":1},{"lineBreak":true},{"text":"ni na sika ya munu ve bawu ke vutuka.","poem":1},{"lineBreak":true},{"text":"Bawu kele mutindu munani ya kutengama.","poem":1},{"lineBreak":true},{"text":"Bamfumu ya bawu ke kufwa na mvita,","poem":1},{"lineBreak":true},{"text":"samu ti, bawu ke na kuzonza","poem":1},{"lineBreak":true},{"text":"yimbi samu na munu,","poem":1},{"lineBreak":true},{"text":"mpe kuna na Ngipiti,","poem":1},{"lineBreak":true},{"text":"bantu ke seka bawu!»","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}