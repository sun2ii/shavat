{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"HOS","translationId":"mkw_wbt","name":"Oseya","commonName":"Oseya","title":"Dibuku ya OSEYA","order":28,"numberOfChapters":14,"sha256":"a132b6ae332f399aaf75150ac9a0a22b26c6bf240355823fa374d18784796325","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mkw_wbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["Nsembolo ya Nzambi"]},{"type":"verse","number":1,"content":[{"text":"Beno sika mpungi samu","poem":1},{"lineBreak":true},{"text":"na kulwengisa bantu.","poem":1},{"lineBreak":true},{"text":"Mpasi ke na kukwiza na Yinzo","poem":1},{"lineBreak":true},{"text":"ya Yave mutindu mbemba.","poem":1},{"lineBreak":true},{"text":"Yave me tuba: «Bantu me","poem":1},{"lineBreak":true},{"text":"zitisa ve ngwisani ya munu.","poem":1},{"lineBreak":true},{"text":"Bawu me tumama ve","poem":1},{"lineBreak":true},{"text":"na Musiku ya munu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bawu ke looka na munu:","poem":1},{"lineBreak":true},{"text":"“Nzambi ya beto,","poem":1},{"lineBreak":true},{"text":"beto bana ya Isayeli, beto me zaba nge.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bantu ya Isayeli me manga mambu ya mbote,","poem":1},{"lineBreak":true},{"text":"na yina, mutantu ke landa bawu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bawu me soola bantinu","poem":1},{"lineBreak":true},{"text":"ata kuyufula luzolo ya munu.","poem":1},{"lineBreak":true},{"text":"Bawu me soola bamfumu,","poem":1},{"lineBreak":true},{"text":"munu ata kuzaba.","poem":1},{"lineBreak":true},{"text":"Bawu me yidika banzambi ya biteki","poem":1},{"lineBreak":true},{"text":"na wolo mpe palata ya bawu.","poem":1},{"lineBreak":true},{"text":"Mpe yawu me zimbisa bawu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bantu ya Samaliya,","poem":1},{"lineBreak":true},{"text":"mu me nyafuna kiteki ya beno","poem":1},{"lineBreak":true},{"text":"ya mwana ya ngombe.","poem":1},{"lineBreak":true},{"text":"Mu me dasukila bawu.","poem":1},{"lineBreak":true},{"text":"Tii wapi ntangu bawu ke","poem":1},{"lineBreak":true},{"text":"lenda ve na kuvwanda ya kuvedila?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kiteki yina ya mwana ya ngombe","poem":1},{"lineBreak":true},{"text":"me katuka na Isayeli.","poem":1},{"lineBreak":true},{"text":"Ni muntu yidikaka yawu,","poem":1},{"lineBreak":true},{"text":"yawu kele ve Nzambi.","poem":1},{"lineBreak":true},{"text":"Ee, mwana ya ngombe ya Samaliya","poem":1},{"lineBreak":true},{"text":"ke mwangana na bitini.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bawu me kunda mupepe,","poem":1},{"lineBreak":true},{"text":"mpe bawu ke yonzika kitembo ya ngolo.","poem":1},{"lineBreak":true},{"text":"Bambuma ya faline ke mena ve.","poem":1},{"lineBreak":true},{"text":"Kana yawu mena, yawu lenda kubuta ve.","poem":1},{"lineBreak":true},{"text":"Kana yawu pesa bambuma ya faline,","poem":1},{"lineBreak":true},{"text":"ni banzenza ke kudya yawu.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Ba me mina bantu ya Isayeli.","poem":1},{"lineBreak":true},{"text":"Bawu me kuma mutindu","poem":1},{"lineBreak":true},{"text":"kima yina bantu nyonso","poem":1},{"lineBreak":true},{"text":"ke na kuyina.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bawu me kwenda na Asili.","poem":1},{"lineBreak":true},{"text":"Mbuluku ya mfinda ke","poem":1},{"lineBreak":true},{"text":"kebaka kimpwanza ya yandi.","poem":1},{"lineBreak":true},{"text":"Kasi bantu ya Efalayime","poem":1},{"lineBreak":true},{"text":"me futa samu na kuzwa makangu!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ata ti bawu me futa bamfumu ya bayinsi,","poem":1},{"lineBreak":true},{"text":"ntangu yayi mu ke yonzika bawu.","poem":1},{"lineBreak":true},{"text":"Na mwa ntangu fyoti,","poem":1},{"lineBreak":true},{"text":"bawu ke tala mpasi na maboko ya ntinu ya Asili.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bantu ya Efalayime me yidika","poem":1},{"lineBreak":true},{"text":"biyokolo mingi ya minkayulu","poem":1},{"lineBreak":true},{"text":"samu na mulemvo ya masumu.","poem":1},{"lineBreak":true},{"text":"Kasi biyokolo yango, ni yawu ke","poem":1},{"lineBreak":true},{"text":"na kusala ti bawu kubwa na masumu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ata ti mu sonikina bawu","poem":1},{"lineBreak":true},{"text":"lutangu ni lutangu ya misiku ya munu,","poem":1},{"lineBreak":true},{"text":"bawu ke tala yawu mutindu","poem":1},{"lineBreak":true},{"text":"ti yawu kele dyambu ya nzenza.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bawu ke pesaka munu minkayulu","poem":1},{"lineBreak":true},{"text":"ya bibulu mpe bawu ke kudyaka","poem":1},{"lineBreak":true},{"text":"mbisi ya yawu.","poem":1},{"lineBreak":true},{"text":"Kasi, munu Yave,","poem":1},{"lineBreak":true},{"text":"mu ke ndimaka yawu ve.","poem":1},{"lineBreak":true},{"text":"Na ntangu yayi,","poem":1},{"lineBreak":true},{"text":"yandi ke bambuka moyo","poem":1},{"lineBreak":true},{"text":"na yimbi ya bawu,","poem":1},{"lineBreak":true},{"text":"yandi ke futisa bawu masumu ya bawu,","poem":1},{"lineBreak":true},{"text":"mpe bawu ke vutuka na Ngipiti.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Isayeli me zimbana Nzambi yina yidikaka yandi.","poem":1},{"lineBreak":true},{"text":"Yandi me tunga bayinzo ya kitoko.","poem":1},{"lineBreak":true},{"text":"Na yina me tadila Yuda,","poem":1},{"lineBreak":true},{"text":"yandi me tunga bambanza mingi","poem":1},{"lineBreak":true},{"text":"yina kele na bibaka ya lukengolo.","poem":1},{"lineBreak":true},{"text":"Kasi mu ke fidisa tiya na","poem":1},{"lineBreak":true},{"text":"bambanza yina","poem":1},{"lineBreak":true},{"text":"mpe yawu ke yoka bayinzo ya bawu ya kitoko.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}