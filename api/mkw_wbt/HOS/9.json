{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"HOS","translationId":"mkw_wbt","name":"Oseya","commonName":"Oseya","title":"Dibuku ya OSEYA","order":28,"numberOfChapters":14,"sha256":"a132b6ae332f399aaf75150ac9a0a22b26c6bf240355823fa374d18784796325","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mkw_wbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["Bantu ya Nzambi ke wombisa nyonso"]},{"type":"verse","number":1,"content":[{"text":"Isayeli, kuyangalala ve,","poem":1},{"lineBreak":true},{"text":"kuvwanda ve na kilengi ya kulutila","poem":1},{"lineBreak":true},{"text":"mutindu bantu ya nkaka.","poem":1},{"lineBreak":true},{"text":"Nge me bika Nzambi ya nge na kusalaka kindumba.","poem":1},{"lineBreak":true},{"text":"Nge me tala kilengi na kuzwa difuta ya kindumba","poem":1},{"lineBreak":true},{"text":"na bisika nyonso yina ba ke","poem":1},{"lineBreak":true},{"text":"kabulaka bambuma na matiti ya yawu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bisika yina ba ke kabulaka bambuma na matiti ya yawu","poem":1},{"lineBreak":true},{"text":"mpe bikamununu ya bambuma ya vinu","poem":1},{"lineBreak":true},{"text":"ke yukutisa dyaka ve.","poem":1},{"lineBreak":true},{"text":"Vinu ya malu-malu yina nge","poem":1},{"lineBreak":true},{"text":"ke na kuvingilaka,","poem":1},{"lineBreak":true},{"text":"nge ke kuzwa yawu ve.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bantu ya Efalayime ke zinga ve","poem":1},{"lineBreak":true},{"text":"na yinsi ya Yave.","poem":1},{"lineBreak":true},{"text":"Bawu ke vutuka na Ngipiti","poem":1},{"lineBreak":true},{"text":"mpe ni na Asili bawu ke kudya","poem":1},{"lineBreak":true},{"text":"madya yina kele ve ya kuvedila.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bawu ke pesa dyaka ve","poem":1},{"lineBreak":true},{"text":"minkayulu ya vinu na Yave.","poem":1},{"lineBreak":true},{"text":"Yandi ke yangalala ve na","poem":1},{"lineBreak":true},{"text":"minkayulu ya bawu.","poem":1},{"lineBreak":true},{"text":"Yawu ke vwanda mutindu","poem":1},{"lineBreak":true},{"text":"mampa yina ba ke kudyaka","poem":1},{"lineBreak":true},{"text":"na kisika ya mafwa.","poem":1},{"lineBreak":true},{"text":"Bayina nyonso ke kudya yawu","poem":1},{"lineBreak":true},{"text":"ke vwanda dyaka ve ya kuvedila.","poem":1},{"lineBreak":true},{"text":"Samu ti, mampa ya bawu","poem":1},{"lineBreak":true},{"text":"ke vwanda kaka ya bawu mosi.","poem":1},{"lineBreak":true},{"text":"Yawu ke kota ve na Yinzo ya Yave.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yinki beno ke sala na kilumbu","poem":1},{"lineBreak":true},{"text":"ya mukembo ya nene,","poem":1},{"lineBreak":true},{"text":"kilumbu ya mukembo ya Yave?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Beno ke kima mwangusulu.","poem":1},{"lineBreak":true},{"text":"Ngipiti ke yamba beno.","poem":1},{"lineBreak":true},{"text":"Kasi ba ke zika beno na Memfi.","poem":1},{"lineBreak":true},{"text":"Matiti ya bansende ke fuluka","poem":1},{"lineBreak":true},{"text":"na bimvwama ya beno ya","poem":1},{"lineBreak":true},{"text":"palata.","poem":1},{"lineBreak":true},{"text":"Bayinti ya bansende ke fuluka","poem":1},{"lineBreak":true},{"text":"na bayinzo ya beno.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ntangu ya kitumbu me kuma.","poem":1},{"lineBreak":true},{"text":"Ntangu ya musendo mpe me kuma.","poem":1},{"lineBreak":true},{"text":"Isayeli fwana kuzaba yawu.","poem":1},{"lineBreak":true},{"text":"«Mumbikudi me lawuka.","poem":1},{"lineBreak":true},{"text":"Muntu yina kele na mpeve","poem":1},{"lineBreak":true},{"text":"ke na kuzonza kidi-kidi.»","poem":1},{"lineBreak":true},{"text":"Samu na bunene ya yimbi ya beno","poem":1},{"lineBreak":true},{"text":"mpe samu na kintantu","poem":1},{"lineBreak":true},{"text":"ya beno ya ngolo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Munkebi ya Efalayime, ni mumbikudi.","poem":1},{"lineBreak":true},{"text":"Nzambi ya munu kele na yandi.","poem":1},{"lineBreak":true},{"text":"Kasi ba me tambila yandi","poem":1},{"lineBreak":true},{"text":"mitambu na banzila ya yandi nyonso.","poem":1},{"lineBreak":true},{"text":"Ba ke na kunwanisa yandi","poem":1},{"lineBreak":true},{"text":"tii na Yinzo ya Nzambi ya yandi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Beno me sadila masumu ya kulutila, mutindu","poem":1},{"lineBreak":true},{"text":"Bawu ke nata dyaka bivumu ve. Yawu salamaka na Ngibeya.","poem":1},{"lineBreak":true},{"text":"Nzambi ke bambuka moyo na yimbi ya beno.","poem":1},{"lineBreak":true},{"text":"Yandi ke futisa beno yimbi ya beno.","poem":1}]},{"type":"heading","content":["Yave ke na kunyonga"]},{"type":"verse","number":10,"content":[{"text":"«Mu kutaka Isayeli mutindu","poem":1},{"lineBreak":true},{"text":"bambuma ya vinu na yinsi ya kuyuma.","poem":1},{"lineBreak":true},{"text":"Mu talaka bankooko ya beno","poem":1},{"lineBreak":true},{"text":"mutindu bambuma ya ntete","poem":1},{"lineBreak":true},{"text":"yina ke talanaka na yinti ya fike.","poem":1},{"lineBreak":true},{"text":"Kasi na ntangu bawu kumaka","poem":1},{"lineBreak":true},{"text":"na Baale-Pewole,","poem":1},{"lineBreak":true},{"text":"bawu me kukipesa na kusambila kima ya nsoni.","poem":1},{"lineBreak":true},{"text":"Mpe bawu me kuma bantu yina ba ke yinaka","poem":1},{"lineBreak":true},{"text":"mutindu kima yina bawu me tula luzolo ya bawu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nkembo ya Efalayime ke katuka","poem":1},{"lineBreak":true},{"text":"mutindu ndeke yina me dumuka.","poem":1},{"lineBreak":true},{"text":"Bana ke butuka dyaka ve.","poem":1},{"lineBreak":true},{"text":"Bakento ke nata dyaka bivumu ve.","poem":1},{"lineBreak":true},{"text":"Bawu ke kuzwa dyaka bivumu ve.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ata ti bawu ke na kuyundula bana,","poem":1},{"lineBreak":true},{"text":"mu ke kufwa bana yina tekila ba kula.","poem":1},{"lineBreak":true},{"text":"Kyadi na bawu ntangu mu ke pesa bawu mukongo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ntangu yina mu","poem":1},{"lineBreak":true},{"text":"talaka Efalayime,","poem":1},{"lineBreak":true},{"text":"yandi vwandaka mutindu","poem":1},{"lineBreak":true},{"text":"diba yina kele","poem":1},{"lineBreak":true},{"text":"na kisika yina madya ke","poem":1},{"lineBreak":true},{"text":"menaka mbote.","poem":1},{"lineBreak":true},{"text":"Kasi yandi ke yekula bana ya yandi","poem":1},{"lineBreak":true},{"text":"na muntu yina ke kufwa bawu.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yave, kana nge ke semba","poem":1},{"lineBreak":true},{"text":"bawu, soola nsembolo yina","poem":1},{"lineBreak":true},{"text":"nge ke pesa bawu.","poem":1},{"lineBreak":true},{"text":"Sala ti bivumu ya bakento ya bawu","poem":1},{"lineBreak":true},{"text":"kwendaka katuka konso ntangu.","poem":1},{"lineBreak":true},{"text":"Yumisa mabene ya bawu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«Yimbi ya bawu me talana tii na Ngilengale","poem":1},{"noteId":5},{"text":".","poem":1},{"lineBreak":true},{"text":"Ni kuna mu me banda na kuyina bawu.","poem":1},{"lineBreak":true},{"text":"Mu ke bingisa bawu na yinzo ya munu","poem":1},{"lineBreak":true},{"text":"samu na mavanga ya bawu ya yimbi.","poem":1},{"lineBreak":true},{"text":"Mu ke zola dyaka bawu ve.","poem":1},{"lineBreak":true},{"text":"Bamfumu ya bawu nyonso","poem":1},{"lineBreak":true},{"text":"ke na kutumama ve.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Efalayime me kuzwa nsembolo.","poem":1},{"lineBreak":true},{"text":"Myanzi ya yandi me yuma.","poem":1},{"lineBreak":true},{"text":"Yawu ke pesa dyaka bambuma ve.","poem":1},{"lineBreak":true},{"text":"Ata ti bakento ya bawu kubuta bana,","poem":1},{"lineBreak":true},{"text":"mu ke kufwa bana yango ya luzolo.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Nzambi ya munu ke losa bawu","poem":1},{"lineBreak":true},{"text":"samu ti, bawu me kuwa yandi ve.","poem":1},{"lineBreak":true},{"text":"Bawu ke banda na kwendaka tambula","poem":1},{"lineBreak":true},{"text":"kidi-kidi na bayinsi.","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"9.15 Ngilengale tala na kidimbu yina kele na Ose 4.15; Amo 4.4; 5.5.","reference":{"chapter":9,"verse":15}}]},"thisChapterLink":"/api/mkw_wbt/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}