{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"ISA","translationId":"mkw_wbt","name":"Esaya","commonName":"Esaya","title":"Dibuku ya ESAYA","order":23,"numberOfChapters":66,"sha256":"03fddabf9c91e1229b3ded68617c48443600e291109343f6461ef826628ce639","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mkw_wbt/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":12,"content":[{"type":"heading","content":["Masiika na Nzambi yina ke vuukisaka"]},{"type":"verse","number":1,"content":[{"text":"Na kilumbu yina, nge ke tuba mutindu yayi:","poem":1},{"lineBreak":true},{"text":"«Yave mu ke na kukembila nge,","poem":1},{"lineBreak":true},{"text":"samu ti ata ti nge dasukilaka munu,","poem":1},{"lineBreak":true},{"text":"nkele ya nge me manisa ya yawu,","poem":1},{"lineBreak":true},{"text":"mpe nge me kindisa munu.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«Ya tsyelika, Yave kele Muvuukisi ya munu,","poem":1},{"lineBreak":true},{"text":"mu ke na kivuuvu mpe ata kima ke na kutalisa munu boma,","poem":1},{"lineBreak":true},{"text":"samu ti ngolo ya munu mpe lulendo ya munu ni Yave Nzambi,","poem":1},{"lineBreak":true},{"text":"Yandi kele Mpulusu ya munu.»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na kyese nyonso, beno ke kwenda teka maza,","poem":1},{"lineBreak":true},{"text":"kuna na bayinto ya mpulusu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Na kilumbu yina, nge ke tuba mutindu yayi:","poem":1},{"lineBreak":true},{"text":"«Beno kembila Yave, beno tanguna Nkumbu ya yandi,","poem":1},{"lineBreak":true},{"text":"beno zabisa mambu ya yandi ya nene na sika ya bantu ya bayinsi,","poem":1},{"lineBreak":true},{"text":"beno bambula moyo na bantu nyonso ti Nkumbu ya yandi kele ya kuzanguka.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Beno yimbidila Yave,","poem":1},{"lineBreak":true},{"text":"samu ti yandi ke salaka mambu ya mbote.","poem":1},{"lineBreak":true},{"text":"Bika ti ba zabisa yawu na ntoto nyonso!»","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Beno bantu yina ke zingaka na Siyone,","poem":1},{"lineBreak":true},{"text":"beno yangalala mpe beno sala milolo ya nsayi!","poem":1},{"lineBreak":true},{"text":"Samu ti Nzambi yina kele na beno,","poem":1},{"lineBreak":true},{"text":"yandi kele Nzambi ya nene, Nzambi ya longo ya Isayeli!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}