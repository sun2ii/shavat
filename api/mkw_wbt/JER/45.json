{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"JER","translationId":"mkw_wbt","name":"Yelemya","commonName":"Yelemya","title":"Dibuku ya YELEMYA","order":24,"numberOfChapters":52,"sha256":"41ea7ef040997a05d5c3c65799df636bf76c59f19d47cb2a342de4e4963da805","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/mkw_wbt/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":45,"content":[{"type":"heading","content":["Mambu yina me tadila Baluke"]},{"type":"verse","number":1,"content":["Na mvula ya yiya ya kintinu ya Yoyakime, mwana ya Yosiya, ntinu ya Yuda, Baluke mwana ya Neliya sonikaka na dibuku, mambu yina mumbikudi Yelemya zabisaka yandi na kusonika. Yelemya tubaka:"]},{"type":"verse","number":2,"content":["«Na yina me tadila nge Baluke Yave, Nzambi ya Isayeli, ke na kutuba na nge mutindu yayi:"]},{"type":"verse","number":3,"content":["Nge ke na kutuba: “Aa, kyadi na munu! Samu ti Yave me bwela mpasi na zulu ya mpasi ya munu yina tekilaka. Ngolo ke na kumanisa munu na kuyawula mpe mu ke na kuzwa ve kizunu.”»"]},{"type":"verse","number":4,"content":["Nge ke zabisa yandi ti, Yave ke na kutuba:",{"text":"«Mu ke na kumwangisa yina mu tungaka,","poem":1},{"lineBreak":true},{"text":"mu ke na kutimuna yina mu kundaka.","poem":1},{"lineBreak":true},{"text":"Mu ke na kumwangisa yinsi nyonso.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mpe nge, nge ke na kusosa kaka","poem":1},{"lineBreak":true},{"text":"ndandu ya nge mosi?","poem":1},{"lineBreak":true},{"text":"Kulomba ata kima ve.","poem":1},{"lineBreak":true},{"text":"Samu ti mu ke talisa mpasi","poem":1},{"lineBreak":true},{"text":"na konso kima yina ke na kuzinga.","poem":1},{"lineBreak":true},{"text":"Kasi nge, na bisika nyonso yina nge ke kwenda,","poem":1},{"lineBreak":true},{"text":"mu ke sala ti luzingu ya nge vwanda kimvwama ya nge","poem":1},{"lineBreak":true},{"text":"yina nge me kuzwa na mvita.","poem":1},{"lineBreak":true},{"text":"Ni Yave me tuba yawu.»","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/JER/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/JER/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/JER/44.json","previousChapterAudioLinks":{},"numberOfVerses":5}