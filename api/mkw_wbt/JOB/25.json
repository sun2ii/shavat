{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"JOB","translationId":"mkw_wbt","name":"Yobi","commonName":"Yobi","title":"Dibuku ya YOBI","order":18,"numberOfChapters":42,"sha256":"3e89edab179a55690f40c9dbb62b014ff25a5c9ed663a07440917fbaba6ee4dc","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mkw_wbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["Kinzonzi ya Biledade: Ba ke swanaka ve na Nzambi-Mpungu"]},{"type":"verse","number":1,"content":["Biledade mu-Suwa vutulaka:"]},{"type":"verse","number":2,"content":[{"text":"Ni Nzambi kele Nzambi ya nsisi mpe ni yandi ke yalaka,","poem":1},{"lineBreak":true},{"text":"yandi ke salaka ti kizunu kuvwanda na mazulu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ba lenda tanga lutangu ya binwani ya yandi?","poem":1},{"lineBreak":true},{"text":"Na zulu ya nani nsemo ya yandi ke lezimaka ve?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wapi mutindu muntu lenda vwanda ya kudedama na ntadisi ya Nzambi?","poem":1},{"lineBreak":true},{"text":"Wapi mutindu muntu yina me butuka na kento lenda vwanda ya kuvedila?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kana na mantwala ya yandi ngonda ke lezimaka ve,","poem":1},{"lineBreak":true},{"text":"kana bambwetete kele ve ya kuvedila na meso ya yandi,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Na yina, yinki ba ke zonza samu na muntu yina ke kufwaka,","poem":1},{"lineBreak":true},{"text":"yandi kele kaka ngambu ya mpamba?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}