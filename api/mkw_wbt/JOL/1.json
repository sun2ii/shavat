{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"JOL","translationId":"mkw_wbt","name":"Yowele","commonName":"Yowele","title":"Dibuku ya YOWELE","order":29,"numberOfChapters":4,"sha256":"d1bb6717d7ef6d0ba3315fb488cc8bbcf3eaf94a695e8b026364b60fa50f6006","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/JOL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/mkw_wbt/JOL/4.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Yayi ni mambu ya Yave yina yandi",{"text":"zabisaka na Yowele, mwana ya Petwele.","poem":1}]},{"type":"heading","content":["Makonko manisaka na kubebisa bilanga"]},{"type":"verse","number":2,"content":[{"text":"Beno Bakuluntu,","poem":1},{"lineBreak":true},{"text":"beno kuwa dyambu yayi,","poem":1},{"lineBreak":true},{"text":"beno nyonso bantu ya yinsi,","poem":1},{"lineBreak":true},{"text":"beno fungula makutu.","poem":1},{"lineBreak":true},{"text":"Dyambu ya mutindu yayi","poem":1},{"lineBreak":true},{"text":"me salamaka na ntangu ya beno","poem":1},{"lineBreak":true},{"text":"to na ntangu ya bankooko ya beno?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Beno zabisa yawu na bana ya beno,","poem":1},{"lineBreak":true},{"text":"bawu mpe ke zabisa yawu","poem":1},{"lineBreak":true},{"text":"na bana ya bawu,","poem":1},{"lineBreak":true},{"text":"samu ti, bana ya bawu kuzabisa yawu","poem":1},{"lineBreak":true},{"text":"na mbandu yina ke landa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Madya yina bidongolo me bika,","poem":1},{"lineBreak":true},{"text":"ni makonko me kudya yawu.","poem":1},{"lineBreak":true},{"text":"Madya yina makonko me bika,","poem":1},{"lineBreak":true},{"text":"ni banzenze me kudya yawu.","poem":1},{"lineBreak":true},{"text":"Mpe madya yina banzenze me bika,","poem":1},{"lineBreak":true},{"text":"ni bambele-mbele me kudya yawu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Beno, bayina ke kolaka malafu,","poem":1},{"lineBreak":true},{"text":"beno vumbuka mpe beno dila.","poem":1},{"lineBreak":true},{"text":"Beno, bayina nyonso ke kunwaka vinu,","poem":1},{"lineBreak":true},{"text":"beno yawula na ngolo samu ti,","poem":1},{"lineBreak":true},{"text":"beno ke kunwa dyaka ve","poem":1},{"lineBreak":true},{"text":"vinu ya mbote.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Samu ti, yinsi mosi me kwiza nwanisa","poem":1},{"lineBreak":true},{"text":"yinsi ya munu.","poem":1},{"lineBreak":true},{"text":"Yawu kele na ngolo mingi,","poem":1},{"lineBreak":true},{"text":"mpe ba lenda tanga ve lutangu ya bawu.","poem":1},{"lineBreak":true},{"text":"Meno ya yawu kele mutindu","poem":1},{"lineBreak":true},{"text":"meno ya nkosi ya mbakala,","poem":1},{"lineBreak":true},{"text":"mpe bayinwa ya yawu kele mutindu","poem":1},{"lineBreak":true},{"text":"yinwa ya nkosi ya nkento.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yawu me mwangisa bilanga ya munu ya vinu,","poem":1},{"lineBreak":true},{"text":"mpe yawu me zenga bayinti","poem":1},{"lineBreak":true},{"text":"ya munu nyonso ya fike.","poem":1},{"lineBreak":true},{"text":"Yawu me katula bampusu ya yawu,","poem":1},{"lineBreak":true},{"text":"mpe me losa yawu na ntoto.","poem":1},{"lineBreak":true},{"text":"Bintala ya yawu me kuma mpembe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yawula mutindu ndumba","poem":1},{"lineBreak":true},{"text":"yina me zaba ntete ve babakala,","poem":1},{"lineBreak":true},{"text":"yina me vwata ngoto","poem":1},{"lineBreak":true},{"text":"samu na bufwidi,","poem":1},{"lineBreak":true},{"text":"mpe ke na kudila","poem":1},{"lineBreak":true},{"text":"bakala ya yandi ya buntwenya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ba ke na kunata dyaka ve minkayulu ya faline","poem":1},{"lineBreak":true},{"text":"mpe minkayulu ya vinu na Yinzo ya Yave.","poem":1},{"lineBreak":true},{"text":"Ni yawu yina, banganga-Nzambi me kuma na kyadi,","poem":1},{"lineBreak":true},{"text":"bawu, bayina ke sadilaka Yave.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bilanga nyonso me mwangana,","poem":1},{"lineBreak":true},{"text":"ntoto me kuma na kyadi.","poem":1},{"lineBreak":true},{"text":"Bambuma ya faline ke dyaka ve,","poem":1},{"lineBreak":true},{"text":"vinu ya malu-malu me manisa.","poem":1},{"lineBreak":true},{"text":"Mafuta ya malu-malu me sika.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bayina ke salaka bilanga, me lemba.","poem":1},{"lineBreak":true},{"text":"Bayina ke salaka bilanga ya vinu","poem":1},{"lineBreak":true},{"text":"ke na kuyawula na ngolo nyonso,","poem":1},{"lineBreak":true},{"text":"samu na bambuma ya faline mpe ya oloze,","poem":1},{"lineBreak":true},{"text":"samu ti, bambuma nyonso yina ba yonzikaka ke dyaka ve.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bayinti nyonso ya bilanga ya vinu me yuma,","poem":1},{"lineBreak":true},{"text":"bayinti ya fike me beba.","poem":1},{"lineBreak":true},{"text":"Bayinti ya ba-ngelenade,","poem":1},{"lineBreak":true},{"text":"bayinti ya pome, na maba,","poem":1},{"lineBreak":true},{"text":"bayinti nyonso ya bambuma","poem":1},{"lineBreak":true},{"text":"ya bilanga me yuma.","poem":1},{"lineBreak":true},{"text":"Bantu ke dyaka ve na kilengi.","poem":1}]},{"type":"heading","content":["Mbokolo na kumina nsoki mpe kubondila Yave"]},{"type":"verse","number":13,"content":[{"text":"Beno banganga-Nzambi,","poem":1},{"lineBreak":true},{"text":"beno lwata binkuti ya beno ya kyadi,","poem":1},{"lineBreak":true},{"text":"beno vwanda na manyongo,","poem":1},{"lineBreak":true},{"text":"beno yawula na ngolo nyonso.","poem":1},{"lineBreak":true},{"text":"Beno, bayina ke sadilaka Nzambi","poem":1},{"lineBreak":true},{"text":"kuna na kiyokolo ya minkayulu,","poem":1},{"lineBreak":true},{"text":"beno vwata bangoto,","poem":1},{"lineBreak":true},{"text":"mpe beno kwiza lutisa mpimpa ya muvimba,","poem":1},{"lineBreak":true},{"text":"samu ti na Yinzo ya Nzambi ya beno,","poem":1},{"lineBreak":true},{"text":"minkayulu ya faline mpe ya vinu ke dyaka ve.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Beno sala kilumbu ya kumina nsoki.","poem":1},{"lineBreak":true},{"text":"Beno bokila bantu","poem":1},{"lineBreak":true},{"text":"samu na kusala lukutakanu ya nene samu na Yave.","poem":1},{"lineBreak":true},{"text":"Beno kutikisa Bakuluntu na bantu nyonso ya yinsi","poem":1},{"lineBreak":true},{"text":"na Yinzo ya Yave, Nzambi ya beno.","poem":1},{"lineBreak":true},{"text":"Mpe beno looka na Yave.","poem":1}]},{"type":"heading","content":["Kilumbu ya Yave"]},{"type":"verse","number":15,"content":[{"text":"Kyadi mingi na kilumbu yina!","poem":1},{"lineBreak":true},{"text":"Samu ti, Kilumbu ya Yave","poem":1},{"lineBreak":true},{"text":"me kuma pene-pene.","poem":1},{"lineBreak":true},{"text":"Yawu ke na kukwiza","poem":1},{"lineBreak":true},{"text":"mutindu mwangusulu yina","poem":1},{"lineBreak":true},{"text":"me katuka na Nzambi-Mpungu.","poem":1},{"lineBreak":true},{"text":"Kilumbu yango ke na kukwiza.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ni na meso ya beno","poem":1},{"lineBreak":true},{"text":"madya ke na kutalana dyaka ve.","poem":1},{"lineBreak":true},{"text":"Mpe kyese na kilengi me zimbana","poem":1},{"lineBreak":true},{"text":"na kati ya Yinzo ya Nzambi ya beto.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Bambuma yina ba kundaka","poem":1},{"lineBreak":true},{"text":"me yuma na yisi ya ntoto.","poem":1},{"lineBreak":true},{"text":"Bikebolo ya madya","poem":1},{"lineBreak":true},{"text":"ke dyaka na kima ve.","poem":1},{"lineBreak":true},{"text":"Bibumbulu ya bambuma","poem":1},{"lineBreak":true},{"text":"me mwangana, samu ti,","poem":1},{"lineBreak":true},{"text":"bambuma ya faline ke dyaka ve.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Beno kuwa mutindu","poem":1},{"lineBreak":true},{"text":"bibulu ke na kudila!","poem":1},{"lineBreak":true},{"text":"Bankonga ya bangombe","poem":1},{"lineBreak":true},{"text":"ke na kwendaka tambula kidi-kidi,","poem":1},{"lineBreak":true},{"text":"samu ti, matiti ya bawu ke dyaka ve.","poem":1},{"lineBreak":true},{"text":"Ya vwanda bankonga ya bankombo na ya mameme,","poem":1},{"lineBreak":true},{"text":"bawu mpe ke na kutala mpasi.","poem":1}]},{"type":"heading","content":["Lusambulu ya mumbikudi"]},{"type":"verse","number":19,"content":[{"text":"Yave, mu ke na kuyawula","poem":1},{"lineBreak":true},{"text":"na sika ya nge, samu ti,","poem":1},{"lineBreak":true},{"text":"tiya me manisa na kuyoka","poem":1},{"lineBreak":true},{"text":"matiti nyonso ya bisika yina","poem":1},{"lineBreak":true},{"text":"bibulu ke kwendaka kudya.","poem":1},{"lineBreak":true},{"text":"Mpe milaka ya tiya me manisa","poem":1},{"lineBreak":true},{"text":"na kunyengisa bayinti nyonso ya bilanga.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Bibulu ya mfinda mpe","poem":1},{"lineBreak":true},{"text":"ke na kuyawula na sika ya nge,","poem":1},{"lineBreak":true},{"text":"samu ti, miila nyonso me sika.","poem":1},{"lineBreak":true},{"text":"Tiya mpe me manisa na kunyengisa","poem":1},{"lineBreak":true},{"text":"matiti nyonso ya bisika yina bibulu","poem":1},{"lineBreak":true},{"text":"ke kwendaka kudya.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}