{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"JOL","translationId":"mkw_wbt","name":"Yowele","commonName":"Yowele","title":"Dibuku ya YOWELE","order":29,"numberOfChapters":4,"sha256":"d1bb6717d7ef6d0ba3315fb488cc8bbcf3eaf94a695e8b026364b60fa50f6006","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/JOL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/mkw_wbt/JOL/4.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["Kilumbu ya Yave me kuma pene-pene"]},{"type":"verse","number":1,"content":[{"text":"Beno sika mpungi na Siyone,","poem":1},{"lineBreak":true},{"text":"beno looka na zulu ya mongo","poem":1},{"lineBreak":true},{"text":"ya munu ya longo.","poem":1},{"lineBreak":true},{"text":"Bika ti bantu nyonso ya yinsi kutekita na boma,","poem":1},{"lineBreak":true},{"text":"samu ti Kilumbu ya Yave ke na kukwiza,","poem":1},{"lineBreak":true},{"text":"yawu me kuma pene-pene.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ya ke vwanda kilumbu mosi","poem":1},{"lineBreak":true},{"text":"ya kufuluka na mpimpa ya ngolo,","poem":1},{"lineBreak":true},{"text":"kilumbu ya kufuluka na dibungi","poem":1},{"lineBreak":true},{"text":"na matuti ya ndombe.","poem":1},{"lineBreak":true},{"text":"Mutindu nsemo ya suka-suka,","poem":1},{"lineBreak":true},{"text":"ke yalumukaka na zulu ya myongo,","poem":1},{"lineBreak":true},{"text":"ni mutindu yina mpe kele","poem":1},{"lineBreak":true},{"text":"nkonga ya nene ya bantu ya ngolo.","poem":1},{"lineBreak":true},{"text":"Yawu me talanaka ntete ve,","poem":1},{"lineBreak":true},{"text":"mpe yawu ke talana dyaka ve","poem":1},{"lineBreak":true},{"text":"na bambandu nyonso yina ke kwiza.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na mantwala ya yawu,","poem":1},{"lineBreak":true},{"text":"tiya ke na kunyengisa,","poem":1},{"lineBreak":true},{"text":"na manima ya yawu,","poem":1},{"lineBreak":true},{"text":"milaka ya tiya ke na kuyoka.","poem":1},{"lineBreak":true},{"text":"Na mantwala ya yandi,","poem":1},{"lineBreak":true},{"text":"yinsi kele mutindu bilanga ya Edeni.","poem":1},{"lineBreak":true},{"text":"Na manima ya yandi,","poem":1},{"lineBreak":true},{"text":"yawu kele mutindu","poem":1},{"lineBreak":true},{"text":"yinsi ya kuyuma,","poem":1},{"lineBreak":true},{"text":"kisika ba me mwangisa.","poem":1},{"lineBreak":true},{"text":"Ata kima me vuuka.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yawu kele mutindu bampunda.","poem":1},{"lineBreak":true},{"text":"Yawu ke kimaka mutindu bampunda ya mvita.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yawu kele mutindu makelele ya bapusu-pusu ya mvita,","poem":1},{"lineBreak":true},{"text":"yina ke kwendaka denda na zulu ya myongo.","poem":1},{"lineBreak":true},{"text":"Yawu kele mutindu makelele ya tiya,","poem":1},{"lineBreak":true},{"text":"yina ke na kuyoka matiti ya kuyuma.","poem":1},{"lineBreak":true},{"text":"Yawu kele mutindu bantu ya ngolo,","poem":1},{"lineBreak":true},{"text":"yina me kubama na mvita.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Na mantwala ya yandi,","poem":1},{"lineBreak":true},{"text":"bantu ke tekita,","poem":1},{"lineBreak":true},{"text":"bizizi ya bawu nyonso","poem":1},{"lineBreak":true},{"text":"ke soba samu na boma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yawu ke kimaka mutindu","poem":1},{"lineBreak":true},{"text":"bantu yina kele na kibakala.","poem":1},{"lineBreak":true},{"text":"Yawu ke yulukaka bibaka","poem":1},{"lineBreak":true},{"text":"ya lupangu mutindu binwani.","poem":1},{"lineBreak":true},{"text":"Konso muntu ke landaka nzila","poem":1},{"lineBreak":true},{"text":"ya yandi, ata kutengama.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ata muntu mosi ke botanaka","poem":1},{"lineBreak":true},{"text":"na mpangi ya yandi,","poem":1},{"lineBreak":true},{"text":"konso muntu ke landaka nzila ya yandi.","poem":1},{"lineBreak":true},{"text":"Ata ti ba ke na kulosilaka bawu bima,","poem":1},{"lineBreak":true},{"text":"bawu ke tatamanaka kaka,","poem":1},{"lineBreak":true},{"text":"bawu ke kubwaka ve.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bawu ke mwanganaka","poem":1},{"lineBreak":true},{"text":"na kati ya mbanza.","poem":1},{"lineBreak":true},{"text":"Bawu ke kimaka","poem":1},{"lineBreak":true},{"text":"na zulu ya bibaka ya mbanza.","poem":1},{"lineBreak":true},{"text":"Bawu ke yulukaka","poem":1},{"lineBreak":true},{"text":"na zulu ya bayinzo.","poem":1},{"lineBreak":true},{"text":"Bawu ke kotilaka","poem":1},{"lineBreak":true},{"text":"na banela mutindu miyibi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Na mantwala ya bawu,","poem":1},{"lineBreak":true},{"text":"ntoto ke tekita, zulu ke ningana.","poem":1},{"lineBreak":true},{"text":"Ntangu na ngonda ke pesa dyaka ve nsemo,","poem":1},{"lineBreak":true},{"text":"bambwetete ke lezima dyaka ve.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yave ke dumisa ndinga ya yandi","poem":1},{"lineBreak":true},{"text":"na mantwala ya mukangu ya yandi ya binwani.","poem":1},{"lineBreak":true},{"text":"Bankonga ya binwani","poem":1},{"lineBreak":true},{"text":"ya yandi kele mingi.","poem":1},{"lineBreak":true},{"text":"Muntu yina ke sadilaka","poem":1},{"lineBreak":true},{"text":"mambu ya yandi,","poem":1},{"lineBreak":true},{"text":"yandi ke na lulendo.","poem":1},{"lineBreak":true},{"text":"Kilumbu ya Yave kele ya nene,","poem":1},{"lineBreak":true},{"text":"yawu kele ya kusakana ve.","poem":1},{"lineBreak":true},{"text":"Nani ke lenda na kuvibidila","poem":1},{"lineBreak":true},{"text":"na kilumbu yango?","poem":1}]},{"type":"heading","content":["Yayi ni ntangu ya kuvutuka na Yave"]},{"type":"verse","number":12,"content":[{"text":"Mpe dyaka, ntangu yayi,","poem":1},{"lineBreak":true},{"text":"Yave ke na kutuba:","poem":1},{"lineBreak":true},{"text":"«Beno vutuka na sika ya munu","poem":1},{"lineBreak":true},{"text":"na ntima ya beno nyonso,","poem":1},{"lineBreak":true},{"text":"na Kumina-nsoki,","poem":1},{"lineBreak":true},{"text":"na bidilu na manyongo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Beno pasula ve binkuti ya beno,","poem":1},{"lineBreak":true},{"text":"kasi beno soba nkadulu ya beno,","poem":1},{"lineBreak":true},{"text":"mpe beno vutuka na Yave, Nzambi ya beno.","poem":1},{"lineBreak":true},{"text":"Yandi kele mbote, yandi kele Nzambi ya kyadi.","poem":1},{"lineBreak":true},{"text":"Yandi ke dasukaka ve na mbangu,","poem":1},{"lineBreak":true},{"text":"yandi kele ya kufuluka na luzolo.","poem":1},{"lineBreak":true},{"text":"Yandi ke sobaka mabanza ya yandi","poem":1},{"lineBreak":true},{"text":"ya kupesa kitumbu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nani zaba kana yandi","poem":1},{"lineBreak":true},{"text":"lenda kusoba mayindu,","poem":1},{"lineBreak":true},{"text":"kunyonga na kitumbu","poem":1},{"lineBreak":true},{"text":"yina yandi zolaka pesa,","poem":1},{"lineBreak":true},{"text":"mpe, na manima,","poem":1},{"lineBreak":true},{"text":"kubikila beno lusakumunu?","poem":1},{"lineBreak":true},{"text":"Na yina, beno ke nata minkayulu","poem":1},{"lineBreak":true},{"text":"ya bambuma ya faline mpe ya vinu,","poem":1},{"lineBreak":true},{"text":"samu na Yave, Nzambi ya beno.»","poem":1}]},{"type":"heading","content":["Kumina nsoki mpe kubondila Yave"]},{"type":"verse","number":15,"content":[{"text":"Beno sika mpungi na Siyone,","poem":1},{"lineBreak":true},{"text":"Beno sala kilumbu ya Kumina nsoki.","poem":1},{"lineBreak":true},{"text":"Beno bokila bantu","poem":1},{"lineBreak":true},{"text":"samu na kusala lukutakanu ya nene samu na Yave.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Beno kutikisa bantu,","poem":1},{"lineBreak":true},{"text":"beno sala Lukutakanu ya longo.","poem":1},{"lineBreak":true},{"text":"Beno kutikisa bakuluntu,","poem":1},{"lineBreak":true},{"text":"bantwenya na bana ya fyoti nyonso.","poem":1},{"lineBreak":true},{"text":"Ditoko yina me kwela","poem":1},{"lineBreak":true},{"text":"malu-malu yayi,","poem":1},{"lineBreak":true},{"text":"yandi basika na kivinga ya yandi.","poem":1},{"lineBreak":true},{"text":"Ndumba yina ba me kwela","poem":1},{"lineBreak":true},{"text":"malu-malu yayi,","poem":1},{"lineBreak":true},{"text":"yandi basika mpe","poem":1},{"lineBreak":true},{"text":"na kivinga ya yandi ya dikwela.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Banganga-Nzambi, yina ke sadilaka Yave,","poem":1},{"lineBreak":true},{"text":"bawu dila na kisika yina kele","poem":1},{"lineBreak":true},{"text":"na kati-kati ya nkotolo,","poem":1},{"lineBreak":true},{"text":"mpe Kiyokolo ya minkayulu.","poem":1},{"lineBreak":true},{"text":"Bawu tuba:","poem":1},{"lineBreak":true},{"text":"«Yave, tala bantu ya nge kyadi.","poem":1},{"lineBreak":true},{"text":"Kundima ve ti bantu","poem":1},{"lineBreak":true},{"text":"yina kele mvwilu ya nge","poem":1},{"lineBreak":true},{"text":"kufwa nsoni ya kulutila,","poem":1},{"lineBreak":true},{"text":"samu ti, bantu ya bayinsi","poem":1},{"lineBreak":true},{"text":"ya nzenza kuseka bawu ve","poem":1},{"lineBreak":true},{"text":"na kutuba:","poem":1},{"lineBreak":true},{"text":"“Wapi Nzambi ya bawu?”»","poem":1}]},{"type":"heading","content":["Mvutu ya Yave"]},{"type":"verse","number":18,"content":[{"text":"Yave kele ya kufuluka","poem":1},{"lineBreak":true},{"text":"na kimbanda samu na yinsi ya yandi.","poem":1},{"lineBreak":true},{"text":"Yandi me fwila bantu ya yandi kyadi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yave me pesa mvutu","poem":1},{"lineBreak":true},{"text":"na bantu ya yandi.","poem":1},{"lineBreak":true},{"text":"Yandi me tuba:","poem":1},{"lineBreak":true},{"text":"«Ee, mu ke fidisa beno","poem":1},{"lineBreak":true},{"text":"bambuma ya faline,","poem":1},{"lineBreak":true},{"text":"vinu ya malu-malu","poem":1},{"lineBreak":true},{"text":"na mafuta ya malu-malu.","poem":1},{"lineBreak":true},{"text":"Beno ke yukuta na yawu.","poem":1},{"lineBreak":true},{"text":"Mu ke fwisa dyaka beno ve","poem":1},{"lineBreak":true},{"text":"nsoni ya kulutila,","poem":1},{"lineBreak":true},{"text":"ata kilumbu mosi,","poem":1},{"lineBreak":true},{"text":"na ntadisi ya bayinsi ya nzenza.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Muntu yina ke katuka na londe,","poem":1},{"lineBreak":true},{"text":"mu ke bingisa yandi ntama na beno.","poem":1},{"lineBreak":true},{"text":"Mu ke losa yandi na yinsi ya kuyuma,","poem":1},{"lineBreak":true},{"text":"kisika yina kele ve na kima.","poem":1},{"lineBreak":true},{"text":"Binwani ya yandi,","poem":1},{"lineBreak":true},{"text":"yina ke tekilaka na mantwala,","poem":1},{"lineBreak":true},{"text":"mu ke losa bawu","poem":1},{"lineBreak":true},{"text":"na mubu ya kulutila mungwa.","poem":1},{"lineBreak":true},{"text":"Binwani yina ke landaka na manima,","poem":1},{"lineBreak":true},{"text":"mu ke losa bawu na mubu","poem":1},{"lineBreak":true},{"text":"yina kele na wesete.","poem":1},{"lineBreak":true},{"text":"Bamvumbi ya bawu","poem":1},{"lineBreak":true},{"text":"ke basika nsunga ya yimbi","poem":1},{"lineBreak":true},{"text":"yina ke bebisa mupepe, samu ti,","poem":1},{"lineBreak":true},{"text":"yandi ke salaka mambu ya nene.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ntoto, kutala boma ve,","poem":1},{"lineBreak":true},{"text":"yangalala mpe vwanda na kyese,","poem":1},{"lineBreak":true},{"text":"samu ti Yave me sala mambu ya nene.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Beno bibulu ya mfinda,","poem":1},{"lineBreak":true},{"text":"beno vwanda ve na boma,","poem":1},{"lineBreak":true},{"text":"samu ti, matiti me mena dyaka","poem":1},{"lineBreak":true},{"text":"na bisika yina","poem":1},{"lineBreak":true},{"text":"beno ke kwendaka kudya.","poem":1},{"lineBreak":true},{"text":"Bayinti ke na kubuta","poem":1},{"lineBreak":true},{"text":"bambuma ya yawu.","poem":1},{"lineBreak":true},{"text":"Bayinti ya fike na ya vinu","poem":1},{"lineBreak":true},{"text":"ke na kupesa bimvwama ya yawu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Beno bantu ya Siyone,","poem":1},{"lineBreak":true},{"text":"beno yangalala,","poem":1},{"lineBreak":true},{"text":"beno vwanda na kyese","poem":1},{"lineBreak":true},{"text":"na Yave, Nzambi ya beno,","poem":1},{"lineBreak":true},{"text":"samu ti yandi ke nokisa","poem":1},{"lineBreak":true},{"text":"bamvula ya ntombo,","poem":1},{"lineBreak":true},{"text":"samu na kuvuukisa beno.","poem":1},{"lineBreak":true},{"text":"Yandi ke nokisa bamvula","poem":1},{"lineBreak":true},{"text":"ya ndolo, ya ntombo","poem":1},{"lineBreak":true},{"text":"na ya mansukina","poem":1},{"lineBreak":true},{"text":"mutindu yawu vwandaka","poem":1},{"lineBreak":true},{"text":"salama na ntama.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Bisika yina ba ke kabulaka","poem":1},{"lineBreak":true},{"text":"bambuma ya faline na matiti ya yawu ke fuluka.","poem":1},{"lineBreak":true},{"text":"Banzungu ya nene ya vinu","poem":1},{"lineBreak":true},{"text":"ke fuluka ya kulutila","poem":1},{"lineBreak":true},{"text":"na vinu ya malu-malu","poem":1},{"lineBreak":true},{"text":"mpe na mafuta ya malu-malu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Mu ke vutudila beno madya","poem":1},{"lineBreak":true},{"text":"nyonso yina makonko,","poem":1},{"lineBreak":true},{"text":"banzenze, bambele-mbele","poem":1},{"lineBreak":true},{"text":"na bidongolo kudyaka.","poem":1},{"lineBreak":true},{"text":"Ni bawu binwani ya munu yina mu fidisaka na kunwanisa beno.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Beno ke kudya mpe beno ke yukuta.","poem":1},{"lineBreak":true},{"text":"Beno ke siika Nkumbu ya Yave,","poem":1},{"lineBreak":true},{"text":"Nzambi ya beno,","poem":1},{"lineBreak":true},{"text":"yina me sadila beno","poem":1},{"lineBreak":true},{"text":"mambu ya ngitukulu.","poem":1},{"lineBreak":true},{"text":"Bantu ya munu ke kufwa dyaka ve","poem":1},{"lineBreak":true},{"text":"nsoni, ata kilumbu mosi.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Beno ke zaba ti munu,","poem":1},{"lineBreak":true},{"text":"mu kele na kati-kati ya Isayeli.","poem":1},{"lineBreak":true},{"text":"Ni munu Yave, Nzambi ya beno.","poem":1},{"lineBreak":true},{"text":"Ya kele na Nzambi ya nkaka ve.","poem":1},{"lineBreak":true},{"text":"Bantu ya munu","poem":1},{"lineBreak":true},{"text":"ke kufwa dyaka ve nsoni,","poem":1},{"lineBreak":true},{"text":"ata kilumbu mosi.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":27}