{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"JOL","translationId":"mkw_wbt","name":"Yowele","commonName":"Yowele","title":"Dibuku ya YOWELE","order":29,"numberOfChapters":4,"sha256":"d1bb6717d7ef6d0ba3315fb488cc8bbcf3eaf94a695e8b026364b60fa50f6006","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/JOL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/mkw_wbt/JOL/4.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["Mpeve ya Yave samu na bantu nyonso"]},{"type":"verse","number":1,"content":[{"text":"Na manima ya mambu yina","poem":1},{"noteId":0},{"text":", mu ke mwangisa Mpeve ya munu na bantu nyonso.","poem":1},{"lineBreak":true},{"text":"Bana ya beno ya babakala","poem":1},{"lineBreak":true},{"text":"mpe ya bakento ke bikula.","poem":1},{"lineBreak":true},{"text":"Binunu ya beno ke kuzwa bandosi,","poem":1},{"lineBreak":true},{"text":"mpe bantwenya ya beno","poem":1},{"lineBreak":true},{"text":"ke kuzwa balumoni.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Na bilumbu yina,","poem":1},{"lineBreak":true},{"text":"mu ke mwangisa mpe Mpeve","poem":1},{"lineBreak":true},{"text":"ya munu na bisadi","poem":1},{"lineBreak":true},{"text":"ya babakala mpe ya bakento.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mu ke sala mambu ya ngitukulu","poem":1},{"lineBreak":true},{"text":"na zulu mpe na ntoto.","poem":1},{"lineBreak":true},{"text":"Ya ke vwanda: menga, tiya,","poem":1},{"lineBreak":true},{"text":"mpe mulinga ke nanguka.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ntangu ke kuma ndombe,","poem":1},{"lineBreak":true},{"text":"mpe ngonda ke kuma","poem":1},{"lineBreak":true},{"text":"mbwaki mutindu menga.","poem":1},{"lineBreak":true},{"text":"Mambu nyonso yayi ke salama","poem":1},{"lineBreak":true},{"text":"ntete Kilumbu ya Yave kuma,","poem":1},{"lineBreak":true},{"text":"kilumbu ya nene mpe ya nsisi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na yina, konso muntu yina ke bokila Nkumbu ya Yave ke vuuka.","poem":1},{"lineBreak":true},{"text":"Ya tsyelika, na zulu ya mongo ya Siyone,","poem":1},{"lineBreak":true},{"text":"na Yelusalemi, ke vwanda na bayina ke vuuka na lufwa, mutindu Yave tubaka yawu.","poem":1},{"lineBreak":true},{"text":"Ni na kati ya bawu Yave ke bokila","poem":1},{"lineBreak":true},{"text":"bayina ke zinga.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"3.1 Na babibila ya nkaka, bibuku ya 1-5 kele ya kusonama na kikapu ya 2.28-32.","reference":{"chapter":3,"verse":1}}]},"thisChapterLink":"/api/mkw_wbt/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/JOL/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":5}