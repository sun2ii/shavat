{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"JOL","translationId":"mkw_wbt","name":"Yowele","commonName":"Yowele","title":"Dibuku ya YOWELE","order":29,"numberOfChapters":4,"sha256":"d1bb6717d7ef6d0ba3315fb488cc8bbcf3eaf94a695e8b026364b60fa50f6006","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/JOL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/mkw_wbt/JOL/4.json","totalNumberOfVerses":73},"chapter":{"number":4,"content":[{"type":"heading","content":["Mfundusulu ya Yave samu na bayinsi ya nzenza"]},{"type":"verse","number":1,"content":[{"text":"Yave me tuba: «Ya tsyelika, na bilumbu yina,","poem":1},{"lineBreak":true},{"text":"ntangu mu ke bongisa dyaka Yuda na Yelusalemi","poem":1},{"noteId":1},{"text":",","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"mu ke vukisa bayinsi","poem":1},{"lineBreak":true},{"text":"nyonso ya nzenza,","poem":1},{"lineBreak":true},{"text":"mpe mu ke kulumuna bawu","poem":1},{"lineBreak":true},{"text":"na mudimba, yina ba ke bokilaka","poem":1},{"lineBreak":true},{"text":"Yewosafate, yina zola kutuba","poem":1},{"lineBreak":true},{"text":"“Yave ke na kufundisa”.","poem":1},{"lineBreak":true},{"text":"Mpe ni kuna mu ke fundisa bawu,","poem":1},{"lineBreak":true},{"text":"samu na mambu yina","poem":1},{"lineBreak":true},{"text":"ba salaka na Isayeli,","poem":1},{"lineBreak":true},{"text":"bantu ya munu,","poem":1},{"lineBreak":true},{"text":"mpe mvwilu ya munu,","poem":1},{"lineBreak":true},{"text":"samu ti, ba me mwangisa","poem":1},{"lineBreak":true},{"text":"bantu ya munu","poem":1},{"lineBreak":true},{"text":"na bayinsi ya nzenza,","poem":1},{"lineBreak":true},{"text":"mpe ba me kabula yinsi ya munu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ba me budila bantu ya munu dzeke.","poem":1},{"lineBreak":true},{"text":"Ba me pesa bana ya fyoti ya babakala","poem":1},{"lineBreak":true},{"text":"samu na kuzwa bakento ya kindumba.","poem":1},{"lineBreak":true},{"text":"Ba me tekisa bana ya fyoti ya bakento","poem":1},{"lineBreak":true},{"text":"samu na vinu yina ba me kunwa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Beno mpe,","poem":1},{"lineBreak":true},{"text":"beno bantu ya Tile na bantu ya Sidone,","poem":1},{"lineBreak":true},{"text":"mpe bizunga nyonso ya ba-Filiseti,","poem":1},{"lineBreak":true},{"text":"yinki beno ke na kusosila munu?","poem":1},{"lineBreak":true},{"text":"Beno zola kuvutula munu yimbi?","poem":1},{"lineBreak":true},{"text":"Kana beno vutula munu yimbi,","poem":1},{"lineBreak":true},{"text":"na nswalu nyonso,","poem":1},{"lineBreak":true},{"text":"mu ke vutudila beno","poem":1},{"lineBreak":true},{"text":"yimbi yina beno salaka.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Beno bakaka wolo na palata ya munu,","poem":1},{"lineBreak":true},{"text":"bima ya munu ya ntalu mpe ya kitoko,","poem":1},{"lineBreak":true},{"text":"beno kwendaka tula yawu","poem":1},{"lineBreak":true},{"text":"na kati ya bayinzo ya banzambi ya beno.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ni beno tekisaka bantu ya Yuda","poem":1},{"lineBreak":true},{"text":"mpe ya Yelusalemi","poem":1},{"lineBreak":true},{"text":"na sika ya ba-Ngeleke,","poem":1},{"lineBreak":true},{"text":"samu ti, bawu vwanda ntama","poem":1},{"lineBreak":true},{"text":"na yinsi ya bawu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kasi munu, mu ke syamisa bawu","poem":1},{"lineBreak":true},{"text":"samu ti ba basika na kisika yina","poem":1},{"lineBreak":true},{"text":"beno tekisaka bawu.","poem":1},{"lineBreak":true},{"text":"Mpe mu ke vutudila beno","poem":1},{"lineBreak":true},{"text":"yimbi yina beno salaka.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mu ke tekisa bana ya beno ya babakala","poem":1},{"lineBreak":true},{"text":"mpe ya bakento na sika ya bantu ya Yuda.","poem":1},{"lineBreak":true},{"text":"Mpe bantu ya Yuda ke tekisa","poem":1},{"lineBreak":true},{"text":"bawu na ba-Sabeye,","poem":1},{"lineBreak":true},{"text":"bayina ke zingaka na yinsi yina kele ntama.","poem":1},{"lineBreak":true},{"text":"Ni Yave me tuba yawu.»","poem":1}]},{"type":"heading","content":["Mvita ya nsuka mpe mfundusu"]},{"type":"verse","number":9,"content":[{"text":"Beno zabisa na bantu ya","poem":1},{"lineBreak":true},{"text":"bayinsi ya nzenza mutindu yayi:","poem":1},{"lineBreak":true},{"text":"«Beno kubama samu na mvita,","poem":1},{"lineBreak":true},{"text":"beno kubika bayina ke na kibakala.","poem":1},{"lineBreak":true},{"text":"Bawu telema samu na kukwenda na mvita.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Beno kitula bisengo ya","poem":1},{"lineBreak":true},{"text":"kubalula ntoto na","poem":1},{"lineBreak":true},{"text":"bambele ya mvita,","poem":1},{"lineBreak":true},{"text":"mpe minkwati ya beno","poem":1},{"lineBreak":true},{"text":"na madyonga.","poem":1},{"lineBreak":true},{"text":"Muntu yina kele ve na ngolo,","poem":1},{"lineBreak":true},{"text":"yandi tuba ti,","poem":1},{"lineBreak":true},{"text":"mu ke kinwani yina ke na kibakala.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Beno bantu ya bayinsi","poem":1},{"lineBreak":true},{"text":"yina kele pene-pene,","poem":1},{"lineBreak":true},{"text":"beno kwiza pesa maboko.","poem":1},{"lineBreak":true},{"text":"Beno vukana kisika mosi.»","poem":1},{"lineBreak":true},{"text":"Yave, fidisa bantu ya nge","poem":1},{"lineBreak":true},{"text":"yina ke na kibakala kuna.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"«Bika ti bantu ya bayinsi ya nzenza kutelama.","poem":1},{"lineBreak":true},{"text":"Bawu kwenda na mudimba,","poem":1},{"lineBreak":true},{"text":"yina ba ke bokilaka Yewosafate","poem":1},{"noteId":2},{"text":".","poem":1},{"lineBreak":true},{"text":"Ni kuna, mu ke vwanda","poem":1},{"lineBreak":true},{"text":"samu na kufundisa bayinsi nyonso","poem":1},{"lineBreak":true},{"text":"yina kele pene-pene.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Beno baka minkwati ya beno","poem":1},{"lineBreak":true},{"text":"samu ti ntangu ya kuyonzika bambuma me lunga.","poem":1},{"lineBreak":true},{"text":"Beno dyata bambuma ya vinu","poem":1},{"lineBreak":true},{"text":"yina me fuluka na kikamununu.","poem":1},{"lineBreak":true},{"text":"Vinu ke na kufuluka ya kulutila","poem":1},{"lineBreak":true},{"text":"na banzungu ya nene.","poem":1},{"lineBreak":true},{"text":"Ya tsyelika, yimbi ya bawu kele nene.»","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bankonga na bankonga me fuluka","poem":1},{"lineBreak":true},{"text":"na mudimba ya mfundusu.","poem":1},{"lineBreak":true},{"text":"Kilumbu ya Yave me kuma","poem":1},{"lineBreak":true},{"text":"pene-pene na mudimba ya mfundusu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ntangu na ngonda me kuma ndombe.","poem":1},{"lineBreak":true},{"text":"Bambwetete ke na kulezima dyaka ve.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yave ke duma na Siyone.","poem":1},{"lineBreak":true},{"text":"Katuka Yelusalemi,","poem":1},{"lineBreak":true},{"text":"yandi ke wakisa ndinga ya yandi.","poem":1},{"lineBreak":true},{"text":"Na yina, zulu na ntoto ke ningana.","poem":1},{"lineBreak":true},{"text":"Kasi Yave kele kiswamunu","poem":1},{"lineBreak":true},{"text":"samu na bantu ya yandi.","poem":1},{"lineBreak":true},{"text":"Yandi kele kibumbamanu ya ngolo","poem":1},{"lineBreak":true},{"text":"ya bantu ya Isayeli.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"«Na yina, beno ke zaba ti,","poem":1},{"lineBreak":true},{"text":"mu kele Yave, Nzambi ya beno,","poem":1},{"lineBreak":true},{"text":"yina ke zingaka na Siyone,","poem":1},{"lineBreak":true},{"text":"mongo ya munu ya longo.","poem":1},{"lineBreak":true},{"text":"Yelusalemi ke kuma kisika ya longo.","poem":1},{"lineBreak":true},{"text":"Mpe banzenza ke banda","poem":1},{"lineBreak":true},{"text":"na kukotaka dyaka ve kuna.»","poem":1}]},{"type":"heading","content":["Luzingu ya malu-malu mpe ya kitoko samu na bantu ya Nzambi"]},{"type":"verse","number":18,"content":[{"text":"«Na kilumbu yina,","poem":1},{"lineBreak":true},{"text":"vinu ya mbote ke kulumuka na myongo.","poem":1},{"lineBreak":true},{"text":"Miliki ke kulumuka na myongo ya fyoti.","poem":1},{"lineBreak":true},{"text":"Maza ke banda na kuluta","poem":1},{"lineBreak":true},{"text":"na miila nyonso ya Yuda.","poem":1},{"lineBreak":true},{"text":"Yinto ke basisa maza na Yinzo ya Yave,","poem":1},{"lineBreak":true},{"text":"mpe yawu ke kulumuka","poem":1},{"lineBreak":true},{"text":"na muzumba yina ba ke bokilaka Akasya.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yinsi ya Ngipiti ke kuma","poem":1},{"lineBreak":true},{"text":"kisika ya kumwangana.","poem":1},{"lineBreak":true},{"text":"Yinsi ya Edome ke kuma ntoto ya kuyuma","poem":1},{"lineBreak":true},{"text":"mpe ya kumwangana,","poem":1},{"lineBreak":true},{"text":"samu na yimbi","poem":1},{"lineBreak":true},{"text":"yina ba salaka bana ya Yuda,","poem":1},{"lineBreak":true},{"text":"na ntangu ba tangisaka,","poem":1},{"lineBreak":true},{"text":"na yinsi ya bawu,","poem":1},{"lineBreak":true},{"text":"menga ya bantu yina salaka kima ve.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kasi bambandu na bambandu,","poem":1},{"lineBreak":true},{"text":"bantu ke bika ve na kuzinga","poem":1},{"lineBreak":true},{"text":"na Yuda mpe na Yelusalemi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mu vwandaka me vutudila ntete ve bawu yimbi","poem":1},{"lineBreak":true},{"text":"yina bawu salaka.","poem":1},{"lineBreak":true},{"text":"Kasi, mu ke vutudila bawu yimbi","poem":1},{"lineBreak":true},{"text":"samu na menga ya bantu","poem":1},{"lineBreak":true},{"text":"yina ba tangisaka.","poem":1},{"lineBreak":true},{"text":"Mpe munu Yave, ke zinga na Siyone.»","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"4.1 Na babibila ya nkaka, kibuku yayi kele ni Yow 3.1.","reference":{"chapter":4,"verse":1}},{"noteId":2,"caller":"+","text":"4.12 Yewosafate kele ni mudimba yina ba ke bokilaka mpe: Yave ke fundisaka.","reference":{"chapter":4,"verse":12}}]},"thisChapterLink":"/api/mkw_wbt/JOL/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}