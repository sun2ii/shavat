{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":1,"content":[{"type":"heading","content":["Musiku ya Yave ke nataka na buyenge"]},{"type":"verse","number":1,"content":[{"text":"Kyese na muntu,","poem":1},{"lineBreak":true},{"text":"muntu yina ke landaka ve malongi ya bantu ya yimbi,","poem":1},{"lineBreak":true},{"text":"yandi ke telamaka ve na banzila ya bantu ya masumu,","poem":1},{"lineBreak":true},{"text":"yandi ke vwandaka ve kintwadi na bantu yina ke sekaka bantu,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"kasi yandi ke yangalalaka na Musiku ya Yave,","poem":1},{"lineBreak":true},{"text":"yandi ke fyongoninaka yawu mpimpa na ntangu!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yandi kele mutindu yinti,","poem":1},{"lineBreak":true},{"text":"yinti yina ba me kunda pene-pene ya mwila,","poem":1},{"lineBreak":true},{"text":"yinti yina ke butaka bambuma na ntangu ya yawu,","poem":1},{"lineBreak":true},{"text":"makasa ya yawu ke yumaka ve,","poem":1},{"lineBreak":true},{"text":"nyonso yina yandi ke salaka ke yilamaka.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kasi yawu kele mutindu yina ve samu na bantu ya yimbi,","poem":1},{"lineBreak":true},{"text":"bawu kele mutindu bampusu ya bambuma yina mupepe ke na kunata.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ni yawu yina, bantu ya yimbi ke vibidila ve na kilumbu ya lufundusu,","poem":1},{"lineBreak":true},{"text":"bantu ya masumu mpe ke kota ve na mukangu ya bantu ya kudedama.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ya tsyelika, Yave zaba banzila ya bantu ya kudedama,","poem":1},{"lineBreak":true},{"text":"kasi banzila yina bantu ya yimbi ke landaka,","poem":1},{"lineBreak":true},{"text":"yawu ke nataka bawu na mwangusulu.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}