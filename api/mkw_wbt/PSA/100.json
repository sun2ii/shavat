{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":100,"content":[{"type":"heading","content":["Beto kele bantu ya yandi"]},{"type":"verse","number":1,"content":[{"text":"Mukunga samu na kuvutula matondo.","descriptive":true},{"text":"Beno sala milo ya nsayi samu na Yave,","poem":1},{"lineBreak":true},{"text":"bantu nyonso ya yinza!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Beno sadila Yave na nsayi nyonso,","poem":1},{"lineBreak":true},{"text":"beno kwiza na ntadisi ya yandi na milolo ya nsayi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Beno zaba ti ni Yave kele Nzambi,","poem":1},{"lineBreak":true},{"text":"ni yandi yidikaka beto, beto kele ya Yave,","poem":1},{"lineBreak":true},{"text":"beto kele bantu ya yandi, beto kele mameme yina yandi ke dikilaka.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Beno kota na myelo ya yandi na kwendaka vutula yandi matondo,","poem":1},{"lineBreak":true},{"text":"beno kota na lupangu ya Yinzo ya yandi na mikunga ya nzitusu!","poem":1},{"lineBreak":true},{"text":"Beno kembila yandi,","poem":1},{"lineBreak":true},{"text":"beno tonda Nkumbu ya yandi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ya tsyelika, Yave kele mbote, bumbote ya yandi ke zingilaka bantangu nyonso,","poem":1},{"lineBreak":true},{"text":"kukwikama ya yandi ke zingilaka bambandu na bambandu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}