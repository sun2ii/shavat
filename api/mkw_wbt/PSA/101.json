{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":101,"content":[{"type":"heading","content":["Nsilulu ya ntinu na Yave"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya Davidi.","descriptive":true},{"text":"Mu ke yimbidila kukwikama ya nge mpe ludedomo ya nge.","poem":1},{"lineBreak":true},{"text":"Samu na nge Yave, mu ke yimbidila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mu ke sala nyonso samu na kulanda nzila ya bantu ya kusungama.","poem":1},{"lineBreak":true},{"text":"Wapi ntangu nge ke kwiza na sika ya munu?","poem":1},{"lineBreak":true},{"text":"Mu ke landa nzila ya ntima ya munu ya kusungama,","poem":1},{"lineBreak":true},{"text":"na kati ya yinzo ya munu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mu me manga na kutala mambu nyonso ya yimbi,","poem":1},{"lineBreak":true},{"text":"na meso ya munu.","poem":1},{"lineBreak":true},{"text":"Mu me yina nkadulu ya bantu ya masumu,","poem":1},{"lineBreak":true},{"text":"yimbi ke kangama ve na munu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Muntu ya ntima ya yimbi ke vwanda ntama na munu,","poem":1},{"lineBreak":true},{"text":"mu ke zola ve kuzaba yimbi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Muntu yina ke zonzaka yimbi samu na mpangi ya yandi na mansweki,","poem":1},{"lineBreak":true},{"text":"mu ke kangisa yandi yinwa.","poem":1},{"lineBreak":true},{"text":"Mu ke ndima ve na kutala bantu yina kele na kisayi mpe lunangu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Meso ya munu ke vwanda na kutalaka bantu ya kukwikama ya yinsi,","poem":1},{"lineBreak":true},{"text":"samu ti bawu kwiza vwanda na sika ya munu.","poem":1},{"lineBreak":true},{"text":"Muntu yina ke landaka nzila ya bantu ya kusungama,","poem":1},{"lineBreak":true},{"text":"yandi ke sadila munu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Muntu yina salaka mambu ya kulunga ve, yandi ke vwanda ve na Yinzo ya munu.","poem":1},{"lineBreak":true},{"text":"Muntu ya luvunu ke zingila ve na ntadisi ya munu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Konso suka, mu ke dingimisa,","poem":1},{"lineBreak":true},{"text":"bantu nyonso ya ntima ya yimbi na kati ya yinsi,","poem":1},{"lineBreak":true},{"text":"na kati ya mbanza ya Yave,","poem":1},{"lineBreak":true},{"text":"mu ke manisa na kufwa bantu nyonso,","poem":1},{"lineBreak":true},{"text":"yina ke sadilaka ve ludedomo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}