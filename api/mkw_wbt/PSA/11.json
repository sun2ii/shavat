{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":11,"content":[{"type":"heading","content":["Kana kivuvu ke dyaka ve"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya mfumu ya miyimbidi.","descriptive":true},{"text":"Mukunga ya Davidi.","poem":1},{"lineBreak":true},{"text":"Ni Yave kele kiswamunu ya munu.","poem":1},{"lineBreak":true},{"text":"Wapi mutindu beno lenda tuba na munu ti:","poem":1},{"lineBreak":true},{"text":"«Kwenda bumbama na mongo mutindu ndeke?»","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ya tsyelika, bantu ya yimbi me kubika minani ya bawu,","poem":1},{"lineBreak":true},{"text":"bawu me tula madyonga ya bawu na basinga ya minani,","poem":1},{"lineBreak":true},{"text":"samu na kukubula na mpimpa, bantu yina kele na bantima ya kusungama.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kana balufulu me mwangana yimeni,","poem":1},{"lineBreak":true},{"text":"yinki muntu ya kudedama lenda sala dyaka?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yave kele na kati ya Yinzo ya yandi ya longo,","poem":1},{"lineBreak":true},{"text":"Yave kele na kiti ya yandi ya kintinu na mazulu.","poem":1},{"lineBreak":true},{"text":"Meso ya yandi ke na kutala,","poem":1},{"lineBreak":true},{"text":"meso ya yandi ke fyongonina bantu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yave ke fyongonina muntu ya kudedama mpe muntu ya yimbi.","poem":1},{"lineBreak":true},{"text":"Yandi ke yinaka muntu yina ke zolaka kusala yimbi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Na bantu ya yimbi yandi ke nokisaka mvula ya makala ya tiya,","poem":1},{"lineBreak":true},{"text":"mvula ya tiya mpe mvula ya sufe,","poem":1},{"lineBreak":true},{"text":"mupepe ya tiya, ni yawu kele kikunku ya bawu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ya tsyelika, Yave kele ya kudedama,","poem":1},{"lineBreak":true},{"text":"yandi ke zolaka mambu yina ba ke salaka na ludedomo nyonso.","poem":1},{"lineBreak":true},{"text":"Ni bantu ya kusungama lenda tala kizizi ya yandi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}