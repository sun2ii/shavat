{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":110,"content":[{"type":"heading","content":["Ntinu, nganga-Nzambi"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya Davidi.","descriptive":true},{"text":"Yave tubaka na mfumu ya munu mutindu yayi:","poem":1},{"lineBreak":true},{"text":"«Vwanda na lweka ya munu ya lubakala,","poem":1},{"lineBreak":true},{"text":"tii ntangu mu ke tula bambeni ya nge na yisi ya makulu ya nge!»","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yave ke lambula mukawa ya lulendo ya yandi na Siyone:","poem":1},{"lineBreak":true},{"text":"Yaala na kati-kati ya bambeni ya nge!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bantu ya nge ke ya kukubama na kukwenda na mvita,","poem":1},{"lineBreak":true},{"text":"na kilumbu yina nge ke kutika binwani ya nge,","poem":1},{"lineBreak":true},{"text":"na zulu ya myongo ya longo,","poem":1},{"lineBreak":true},{"text":"ntangu bwisi ke kutsyaka,","poem":1},{"lineBreak":true},{"text":"bantwenya ya nge ke kwiza na sika ya nge mutindu kinoko.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yave me kudya ndefi,","poem":1},{"lineBreak":true},{"text":"mpe yandi ke nyonga ve samu na yawu.","poem":1},{"lineBreak":true},{"text":"«Nge kele nganga-Nzambi ya mankululu,","poem":1},{"lineBreak":true},{"text":"na mutindu ya Melekisedeke.»","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yave kele na lweka ya nge ya lubakala,","poem":1},{"lineBreak":true},{"text":"na kilumbu ya nkele ya yandi, yandi ke nika bantinu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yandi ke fundisaka bayinsi, bisika nyonso me fuluka na bamvumbi,","poem":1},{"lineBreak":true},{"text":"yandi ke nika ntinu ya yinsi ya nene.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Na nzila, yandi ke kunwaka maza ya muzumba.","poem":1},{"lineBreak":true},{"text":"Ni yawu yina yandi ke vumbulaka yintu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}