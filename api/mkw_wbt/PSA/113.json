{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":113,"content":[{"type":"heading","content":["Bumbote ya Nzambi samu na bamputu"]},{"type":"verse","number":1,"content":[{"text":"Aleluya!","poem":1},{"lineBreak":true},{"text":"Beno bisyelo ya Yave, beno kembila yandi,","poem":1},{"lineBreak":true},{"text":"beno kembila Nkumbu ya Yave!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bika ti ba kutonda Nkumbu ya Yave,","poem":1},{"lineBreak":true},{"text":"kubanda ntangu yayi tii bantangu nyonso!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kubanda na esete tii na wesete,","poem":1},{"lineBreak":true},{"text":"bika ti Nkumbu ya Yave kukemboswa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yave ke na zulu ya bayinsi nyonso,","poem":1},{"lineBreak":true},{"text":"nkembo ya yandi me lutila kuzangama na mazulu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nani yina kele mutindu Yave, Nzambi ya beto?","poem":1},{"lineBreak":true},{"text":"Yandi ke ya kuvwanda na kisika ya kulutila kuzangama.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yandi ke betamaka samu na kutala,","poem":1},{"lineBreak":true},{"text":"mazulu na ntoto.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yandi ke telemisaka muntu ya mpamba na kati ya fundu-fundu,","poem":1},{"lineBreak":true},{"text":"yandi ke basisaka mputu na kati ya mboloso,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"samu na kuvwandisa yandi na bantu ya mfunu,","poem":1},{"lineBreak":true},{"text":"bantu ya mfunu ya yinsi ya yandi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yave ke salaka ti kisita kuvwanda na yinzo ya makwela,","poem":1},{"lineBreak":true},{"text":"mutindu kento ya nsayi na kati-kati ya bana ya yandi.","poem":1},{"lineBreak":true},{"text":"Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}