{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":114,"content":[{"type":"heading","content":["Mukunga ntangu Isayeli basikaka na yinsi ya Ngipiti"]},{"type":"verse","number":1,"content":[{"text":"Ntangu Isayeli basikaka na yinsi ya Ngipiti,","poem":1},{"lineBreak":true},{"text":"ntangu bana ya Yakobi bikaka yinsi ya bantu yina ke zonzaka ndinga ya nzenza,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yuda kumaka Yinzo ya longo ya Nzambi,","poem":1},{"lineBreak":true},{"text":"Isayeli kumaka mvwilu ya yandi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mubu talaka yawu mpe yawu kimaka,","poem":1},{"lineBreak":true},{"text":"nzadi ya Yolodani talaka yawu mpe yawu vutukaka manima.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Myongo vwandaka duzumuka mutindu mameme ya mbakala,","poem":1},{"lineBreak":true},{"text":"myongo ya fyoti vwandaka duzumuka mutindu bana ya bankombo mpe ya mameme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nge mubu, samu na yinki nge me kima?","poem":1},{"lineBreak":true},{"text":"Nge nzadi ya Yolodani, samu na yinki nge me vutuka manima?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Myongo samu na yinki beno ke na duzumuka mutindu mameme ya mbakala?","poem":1},{"lineBreak":true},{"text":"Myongo ya fyoti samu na yinki beno ke na duzumuka mutindu bana ya bankombo mpe ya mameme?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nge ntoto, tekita na mantwala ya Yave!","poem":1},{"lineBreak":true},{"text":"Tekita na mantwala ya Nzambi ya Yakobi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yandi ke kitulaka ditadi ya nene na kizinga ya maza,","poem":1},{"lineBreak":true},{"text":"yandi ke kitulaka ditadi ya nene na yinto ya maza.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}