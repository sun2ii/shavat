{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":120,"content":[{"type":"heading","content":["Lusambulu ya muntu na mantwala ya bantu yina ke zolaka ve kizunu"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya kuyuluka.","descriptive":true},{"text":"Mu me bokila Yave na kati ya mpasi ya munu,","poem":1},{"lineBreak":true},{"text":"yandi me pesa munu mvutu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Yave kuula munu, kuula munu na maboko ya bantu ya luvunu,","poem":1},{"lineBreak":true},{"text":"mpe yina ke zonzaka mambu ya kulunga ve.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yinki beno ke kuzwa?","poem":1},{"lineBreak":true},{"text":"Wapi mutindu ya kitumbu yina Nzambi ke pesa beno, beno bantu ya luvunu?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yandi ke losila nge madyonga ya kinwani ya ngolo,","poem":1},{"lineBreak":true},{"text":"na makala ya tiya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ya kele mpasi mingi samu na munu na kwiza zinga na bunzenza na Meseke,","poem":1},{"lineBreak":true},{"text":"mpasi mingi na munu na kwiza zinga na bayinzo ya bantu ya Kedale.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mu me zinga mingi na kati-kati ya bantu,","poem":1},{"lineBreak":true},{"text":"yina ke yinaka kizunu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mu ke zolaka kizunu, kasi kaka na ntangu yina mu ke tubaka,","poem":1},{"lineBreak":true},{"text":"bawu ke sosa mvita.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}