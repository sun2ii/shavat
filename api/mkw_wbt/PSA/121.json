{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":121,"content":[{"type":"heading","content":["Yave nkebi ya munu"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya kuyuluka.","descriptive":true},{"text":"Mu me vumbula meso na kutala na myongo,","poem":1},{"lineBreak":true},{"text":"wapi kisika ke katuka lusalusu ya munu?","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Lusalusu ya munu ke katuka na sika ya Yave,","poem":1},{"lineBreak":true},{"text":"yandi yina yidikaka zulu na ntoto.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yandi ke bika ve ti makulu ya nge kubula mabaku,","poem":1},{"lineBreak":true},{"text":"Nzambi yina ke bumbaka nge ke nonginaka ve,","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ve, Nzambi yina ke kebaka Isayeli,","poem":1},{"lineBreak":true},{"text":"yandi ke nonginaka ve, mpe yandi ke lalaka ve.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ni Yave ke kebaka nge,","poem":1},{"lineBreak":true},{"text":"yandi kele mpewo ya nge na lweka ya nge ya lubakala,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Na ntangu, ntangu ke talisa nge mpasi ve,","poem":1},{"lineBreak":true},{"text":"na mpimpa, ngonda mpe ke talisa nge mpasi ve.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yave ke keba nge na mambu nyonso ya yimbi,","poem":1},{"lineBreak":true},{"text":"yandi ke keba luzingu ya nge.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yave ke keba nge ntangu nge ke basika mpe ntangu nge ke vutuka,","poem":1},{"lineBreak":true},{"text":"kubanda bubu yayi tii bantangu nyonso.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}