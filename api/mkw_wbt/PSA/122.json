{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":122,"content":[{"type":"heading","content":["Lusambulu samu na Yelusalemi"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya kuyuluka. Mukunga ya Davidi.","descriptive":true},{"text":"Mu ke yangalalaka ntangu ba ke tubaka na munu ti:","poem":1},{"lineBreak":true},{"text":"«Beto kwenda na Yinzo ya Yave!»","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Beto me tambula, beto me kwiza suka","poem":1},{"lineBreak":true},{"text":"na mantwala ya myelo ya nge, Yelusalemi!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yelusalemi, nge kele ya kutungama,","poem":1},{"lineBreak":true},{"text":"nge kele mbanza ya kutungama mutindu kima kaka mosi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ni na sika ya nge, bifumba ya Isayeli,","poem":1},{"lineBreak":true},{"text":"bifumba ya Yave ke kwizaka,","poem":1},{"lineBreak":true},{"text":"samu na kukembila Nkumbu ya Yave,","poem":1},{"lineBreak":true},{"text":"ni mutindu yina kele ntumunu na Isayeli.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ya tsyelika, bakiti ya kintinu samu na lufundusu kele ni na sika ya nge,","poem":1},{"lineBreak":true},{"text":"bakiti ya kintinu samu na dikanda ya Davidi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Beno sambila samu na kizunu ya Yelusalemi:","poem":1},{"lineBreak":true},{"text":"«Bika ti bayina ke zolaka nge, bawu kuzinga na kizunu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bika ti kizunu kuvwanda na bibaka ya nge,","poem":1},{"lineBreak":true},{"text":"luvundulu kuvwanda na kati ya bayinzo ya kintinu!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Samu na bampangi ya munu, mpe samu na bandiku ya munu, mu ke na kutuba:","poem":1},{"lineBreak":true},{"text":"“Bika ti kizunu kuvwanda na nge!”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Samu na Yinzo ya Yave, Nzambi ya beto,","poem":1},{"lineBreak":true},{"text":"mu ke na lomba buyenge ya nge!»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}