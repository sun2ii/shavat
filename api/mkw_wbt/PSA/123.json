Break":true},{"text":"Bamvwama ke na kuseka beto mingi,","poem":1},{"lineBreak":true},{"text":"bantu ya lunangu ke na kuvweza beto.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}