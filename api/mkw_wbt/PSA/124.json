{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":124,"content":[{"type":"heading","content":["Yave me kuula bantu ya yandi"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya kuyuluka. Mukunga ya Davidi.","descriptive":true},{"text":"Kana Yave vwandaka ve na beto!","poem":1},{"lineBreak":true},{"text":"Bika ti Isayeli kutuba yawu:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Kana Yave vwandaka ve na beto!»","poem":1},{"lineBreak":true},{"text":"Ntangu bantu telamaka samu na kunwanisa beto,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"bawu zolaka kunda beto ya moyo,","poem":1},{"lineBreak":true},{"text":"ntangu yina bawu kumaka na nkele ya kulutila samu na beto.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Na yina, nyamba ya maza zolaka nata beto,","poem":1},{"lineBreak":true},{"text":"maza zolaka dyamisa beto.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ya tsyelika, nyamba ya maza ya ngolo,","poem":1},{"lineBreak":true},{"text":"nyamba yango zolaka dyamisa beto.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nkembo na Yave!","poem":1},{"lineBreak":true},{"text":"Yandi salaka ti beto kuvwanda ve mutindu madya na kati ya bayinwa ya bambeni.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Beto vuukaka mutindu ndeke yina me vuuka na mutambu ya bandeke.","poem":1},{"lineBreak":true},{"text":"Mutambu zenganaka mpe beto vuukaka.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lusalusu ya beto kele na Nkumbu ya Yave,","poem":1},{"lineBreak":true},{"text":"yina yidikaka zulu na ntoto.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}