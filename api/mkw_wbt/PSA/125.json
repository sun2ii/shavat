{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":125,"content":[{"type":"heading","content":["Yave ke kebaka bantu ya yandi"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya kuyuluka.","descriptive":true},{"text":"Bayina ke tulaka kivuuvu ya bawu na Yave,","poem":1},{"lineBreak":true},{"text":"bawu kele mutindu mongo ya Siyone,","poem":1},{"lineBreak":true},{"text":"mongo yina ke ninganaka ve, mongo ya bantangu nyonso.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mutindu Yelusalemi kele ya kuzungama na myongo,","poem":1},{"lineBreak":true},{"text":"Yave mpe ke zungidilaka bantu ya yandi,","poem":1},{"lineBreak":true},{"text":"kubanda ntangu yayi mpe bantangu nyonso.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Luyalu ya bantu ya yimbi ke zingila ve,","poem":1},{"lineBreak":true},{"text":"na yinsi ya bantu ya kudedama,","poem":1},{"lineBreak":true},{"text":"samu ti bantu ya kudedama, kukota ve na mavanga ya yimbi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yave, lakisa bumbote ya nge na bantu ya mbote,","poem":1},{"lineBreak":true},{"text":"lakisa yawu, na bantu ya bantima ya kusungama!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kasi bayina ke balukaka na kulanda banzila ya kutengama,","poem":1},{"lineBreak":true},{"text":"bika ti Yave kubingisa bawu,","poem":1},{"lineBreak":true},{"text":"kintwadi na bantu ya yimbi!","poem":1},{"lineBreak":true},{"text":"Bika ti kizunu kuvwanda na Isayeli!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}