,{"lineBreak":true},{"text":"mutindu maza yina ke lutaka na yinsi ya kuyuma ya Nengeve!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bayina ke kundaka na bidilu,","poem":1},{"lineBreak":true},{"text":"bawu ke yonzikaka na milolo ya nsayi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Muntu yina ke kwendaka na kumwanga bambuma na kudila nyonso,","poem":1},{"lineBreak":true},{"text":"yandi ke vutukaka na kyese kana yandi,","poem":1},{"lineBreak":true},{"text":"me nata matiti ya bambuma ya faline.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}