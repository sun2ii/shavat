{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":127,"content":[{"type":"heading","content":["Ni Yave ke tungaka yinzo"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya kuyuluka. Mukunga ya Salomoni.","descriptive":true},{"text":"Kana Yave kutunga ve yinzo,","poem":1},{"lineBreak":true},{"text":"bayina ke tunga yawu,","poem":1},{"lineBreak":true},{"text":"bawu ke sala kaka kisalu ya mpampa,","poem":1},{"lineBreak":true},{"text":"kana Yave kukeba ve mbanza,","poem":1},{"lineBreak":true},{"text":"bayina ke keba yawu, bawu ke sala kaka kisalu ya mpampa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Beno ke vumbukaka na suka-suka,","poem":1},{"lineBreak":true},{"text":"mpe beno ke lalaka na kati-kati ya mpimpa,","poem":1},{"lineBreak":true},{"text":"nyonso yina ke kaka ya mpamba.","poem":1},{"lineBreak":true},{"text":"Beno ke na kuzwa madya ya kudya na mpasi,","poem":1},{"lineBreak":true},{"text":"Nzambi ke pesaka yawu na muntu yina yandi zola ntangu yandi ke ntete ya kulala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ya tsyelika, bana kele mvwilu ya Yave,","poem":1},{"lineBreak":true},{"text":"mbuma ya kivumu ya mama ni musendo yina Yave ke pesaka.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bana ya buntwenya kele mutindu madyonga,","poem":1},{"lineBreak":true},{"text":"yina kele na maboko ya kinwani ya ngolo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nsayi mingi na muntu yina me fulusa nkutu ya yandi na madyonga!","poem":1},{"lineBreak":true},{"text":"Yandi ke tala ve nsoni ntangu yandi ke kuzwa mwa dyambu,","poem":1},{"lineBreak":true},{"text":"na mbeni ya yandi, kuna na mwelo ya mbanza.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}