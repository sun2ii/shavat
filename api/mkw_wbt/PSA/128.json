{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":128,"content":[{"type":"heading","content":["Buyenge ya dikanda muntu ya kukwikama"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya kuyuluka.","descriptive":true},{"text":"Kyese na konso muntu yina ke zitisaka Yave,","poem":1},{"lineBreak":true},{"text":"yandi ke landaka banzila ya Nzambi!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nge ke yangalala na difuta ya kisalu ya maboko ya nge,","poem":1},{"lineBreak":true},{"text":"nge kele muntu ya nsayi, mpe buyenge kele ya nge!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kento ya nge kele mutindu bilanga ya bayinti ya vinu yina me buta bambuma,","poem":1},{"lineBreak":true},{"text":"na kati ya yinzo ya nge,","poem":1},{"lineBreak":true},{"text":"bana ya nge kele mutindu mwa bayinti ya olive,","poem":1},{"lineBreak":true},{"text":"yina me zunga mesa ya nge.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ni mutindu yina kele lusakumunu,","poem":1},{"lineBreak":true},{"text":"ya muntu yina ke zitisaka Yave.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kuna na Siyone, Yave ke sakumuna nge,","poem":1},{"lineBreak":true},{"text":"nge ke tala buyenge ya Yelusalemi","poem":1},{"lineBreak":true},{"text":"bilumbu nyonso ya luzingu ya nge.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nge ke tala bana ya bana ya nge.","poem":1},{"lineBreak":true},{"text":"Bika ti kizunu kuvwanda na Isayeli!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}