{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":129,"content":[{"type":"heading","content":["Ba ke talisaka munu mpasi mingi"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya kuyuluka.","descriptive":true},{"text":"Bantangu nyonso, bawu ke na kunwanisa munu, katuka buntwenya ya munu,","poem":1},{"lineBreak":true},{"text":"bika ti Isayeli kutuba yawu:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Bantangu nyonso, bawu ke na kunwanisa munu, katuka buntwenya ya munu,»","poem":1},{"lineBreak":true},{"text":"kasi bawu me nunga munu ve.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bantu yina ke balulaka ntoto, bawu ke na kusala yawu na mukongo ya munu,","poem":1},{"lineBreak":true},{"text":"bawu me sala mikala ya yinda.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yave kele ya kudedama,","poem":1},{"lineBreak":true},{"text":"yandi me zenga basinga ya bantu ya yimbi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bayina nyonso ke yinaka Siyone,","poem":1},{"lineBreak":true},{"text":"bika ti bawu kutala nsoni,","poem":1},{"lineBreak":true},{"text":"bika ti bawu nyonso kuvutuka manima!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bika ti bawu kuvwanda mutindu matiti ya bayinzo, yina kele na miludi ya kuyalumuka,","poem":1},{"lineBreak":true},{"text":"yina ke yumaka ntete ti ba katula yawu!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kiyonziki ya bambuma ke fulusaka ve maboko ya yandi,","poem":1},{"lineBreak":true},{"text":"muntu yina ke kangaka yawu ke fulusaka ve maboko ya yandi,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"bayina ke na kuluta ke na kutuba ve:","poem":1},{"lineBreak":true},{"text":"«Bika ti Yave kusakumuna beno!»","poem":1},{"lineBreak":true},{"text":"Beto ke na kusakumuna beno na Nkumbu ya Yave!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}