{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":13,"content":[{"type":"heading","content":["Yave tii wapi ntangu nge ke zimbana munu?"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya mfumu ya miyimbidi. Mukunga ya Davidi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Yave, tii wapi ntangu nge ke tatamana na kuzimbana munu?","descriptive":true},{"text":"Tii wapi ntangu nge ke bumba munu kizizi ya nge?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tii wapi ntangu mwela ya munu ke vwanda na manyongo","poem":1},{"lineBreak":true},{"text":"mpe ntima ya munu konso kilumbu na kyadi?","poem":1},{"lineBreak":true},{"text":"Tii wapi ntangu mbeni ya munu ke tatamana na kutediminaka munu?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yave, Nzambi ya munu tala, pesa munu mvutu!","poem":1},{"lineBreak":true},{"text":"Kyenzola meso ya munu,","poem":1},{"lineBreak":true},{"text":"samu ti mu lala ve mpongi ya lufwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ya tsyelika, mbeni ya munu lenda tuba ti:","poem":1},{"lineBreak":true},{"text":"«Beto me nunga yandi!»","poem":1},{"lineBreak":true},{"text":"Bika ti mitantu ya munu kuyangalala ve kana mu kubwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kasi munu, mu me tula kivuvu ya munu na bumbote ya nge,","poem":1},{"lineBreak":true},{"text":"ntima ya munu kele na nsayi mingi na mpulusu ya nge.","poem":1},{"lineBreak":true},{"text":"Mu ke yimbidila Yave samu ti yandi me sadila munu mambu ya mbote.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}