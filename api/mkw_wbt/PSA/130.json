{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":130,"content":[{"type":"heading","content":["Lusambulu na kati ya mpasi ya kulutila"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya kuyuluka.","descriptive":true},{"text":"Na kati ya mpasi ya kulutila, mu ke na kubokila nge, Yave!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yave, kuwa ndinga ya munu!","poem":1},{"lineBreak":true},{"text":"Teka makutu na kuwa,","poem":1},{"lineBreak":true},{"text":"kubondila yina mu ke na kubondila nge!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yave, kana nge ke bambukaka moyo na masumu ya beto,","poem":1},{"lineBreak":true},{"text":"Yave, nani zolaka zinga dyaka?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kasi ni nge ke lemvokilaka,","poem":1},{"lineBreak":true},{"text":"samu ti bantu kuzitisa nge.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mu me tula kivuvu ya munu na Yave.","poem":1},{"lineBreak":true},{"text":"Ya tsyelika mu me tula kivuvu,","poem":1},{"lineBreak":true},{"text":"mu me tula ntima ya munu na mambu ya yandi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mu me tula kivuvu ya munu na Yave,","poem":1},{"lineBreak":true},{"text":"kulutila nkebi ke vingilaka suka kukuma,","poem":1},{"lineBreak":true},{"text":"ya tsyelika, kulutila nkebi ke vingilaka suka kukuma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Isayeli, tula kivuvu ya nge na Yave,","poem":1},{"lineBreak":true},{"text":"samu ti yandi kele mbote,","poem":1},{"lineBreak":true},{"text":"yandi kele na mutindu mingi ya kukuula bantu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ni yandi ke kuula Isayeli,","poem":1},{"lineBreak":true},{"text":"na yimbi ya yandi nyonso.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}