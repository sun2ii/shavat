{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":137,"content":[{"type":"heading","content":["Mukunga ya kyadi na yinsi ya Babilone"]},{"type":"verse","number":1,"content":[{"text":"Beto vwandaka ya kuvwanda pene-pene ya banzadi ya Babilone,","descriptive":true},{"text":"beto vwandaka dila,","poem":1},{"lineBreak":true},{"text":"mpe beto vwandaka bambuka moyo na Siyone.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Beto ledikaka bansambi ya beto","poem":1},{"lineBreak":true},{"text":"na bayinti yina vwandaka kuna.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kuna, bayina nataka beto na ngolo, bawu vwandaka tumisa beto na kuyimbila mikunga,","poem":1},{"lineBreak":true},{"text":"bayina vwandaka kwamisa beto,","poem":1},{"lineBreak":true},{"text":"bawu vwandaka tumisa beto na kuyimbila mikunga ya nsayi:","poem":1},{"lineBreak":true},{"text":"«Beno yimbila beto mikunga ya Siyone!»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wapi mutindu beto lenda yimbila mukunga ya Yave,","poem":1},{"lineBreak":true},{"text":"kwaku na yinsi ya nzenza?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yelusalemi kana mu zimbana nge,","poem":1},{"lineBreak":true},{"text":"bika ti diboko ya munu ya lubakala kufwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kana mu bika na kubambukila nge moyo,","poem":1},{"lineBreak":true},{"text":"kana mu sala ti nge bika na kuvwanda","poem":1},{"lineBreak":true},{"text":"nsayi ya munu ya kulutila,","poem":1},{"lineBreak":true},{"text":"bika ti ludimi ya munu kukangama na yinwa ya munu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yave, bambuka moyo na bantu ya yinsi ya Edome,","poem":1},{"lineBreak":true},{"text":"na kilumbu yina ba bakaka mbanza Yelusalemi,","poem":1},{"lineBreak":true},{"text":"bawu vwandaka tuba:","poem":1},{"lineBreak":true},{"text":"«Beno mwangisa,","poem":1},{"lineBreak":true},{"text":"beno mwangisa tii na lufulu!»","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Babilone mbanza ya kitoko, ba ke mwangisa nge,","poem":1},{"lineBreak":true},{"text":"kyese na bayina ke vutula nge","poem":1},{"lineBreak":true},{"text":"yimbi yina nge salaka beto!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kyese na bantu yina ke simba bantwenya ya nge","poem":1},{"lineBreak":true},{"text":"mpe ke nika bawu na zulu ya ditadi ya nene!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}