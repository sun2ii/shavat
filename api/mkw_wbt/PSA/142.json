{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":142,"content":[{"type":"heading","content":["Yave kele kiswamunu ya nsuka"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya Davidi, ntangu yandi vwandaka ya bumbamaka na kati ya ntadi. Lusambulu.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Mu ke na kulooka na sika ya Yave na ndinga ya ngolo,","poem":1},{"lineBreak":true},{"text":"mu ke na kubondila Yave na ndinga ya ngolo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mu ke na kumwangisa lusambulu ya munu mutindu maza na ntadisi ya Yave,","poem":1},{"lineBreak":true},{"text":"mu me lakisa yandi mpasi ya munu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ntangu yina mpeve ya munu me lemba,","poem":1},{"lineBreak":true},{"text":"nge, nge me zaba nzila ya munu.","poem":1},{"lineBreak":true},{"text":"Ba me sadila munu mutambu,","poem":1},{"lineBreak":true},{"text":"na nzila yina mu ke lutilaka.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tala na lweka ya lubakala,","poem":1},{"lineBreak":true},{"text":"ata muntu ke na kuzaba dyaka munu,","poem":1},{"lineBreak":true},{"text":"mu ke dyaka ve na kisika ya kwenda bumbama.","poem":1},{"lineBreak":true},{"text":"Ata muntu ve ke na kutala ntima mpasi samu na luzingu ya munu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yave ni na sika ya nge mu ke na kulooka!","poem":1},{"lineBreak":true},{"text":"Mu me tuba: «Nge kele kibumbamanu ya munu,","poem":1},{"lineBreak":true},{"text":"nge kele mvwilu ya munu awa na ntoto ya bantu ya moyo.»","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kuwa kulooka ya munu,","poem":1},{"lineBreak":true},{"text":"samu ti mu me lemba mingi,","poem":1},{"lineBreak":true},{"text":"kuula munu na maboko ya bantu yina ke na kulanda munu,","poem":1},{"lineBreak":true},{"text":"samu ti bawu me lutila munu ngolo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Basisa munu na boloko,","poem":1},{"lineBreak":true},{"text":"samu ti mu kembila Nkumbu ya nge!","poem":1},{"lineBreak":true},{"text":"Bantu ya kudedama ke kwiza zunga munu,","poem":1},{"lineBreak":true},{"text":"ntangu yina nge ke sadila munu mambu ya mbote.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":8}