{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":15,"content":[{"type":"heading","content":["Yina Nzambi ke lombaka na mikwikisi ya yandi"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya Davidi.","descriptive":true},{"text":"Yave, nani lenda vwanda mwa ntangu na yinzo ya nge ya lele?","poem":1},{"lineBreak":true},{"text":"Nani lenda zinga na mongo ya nge ya longo?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kaka ni muntu yina kele ya kusungama,","poem":1},{"lineBreak":true},{"text":"yina ke sadilaka ludedomo","poem":1},{"lineBreak":true},{"text":"mpe ke zonzaka mambu ya tsyelika na ntima ya yandi nyonso.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yinwa ya yandi ke tongaka ve bantu,","poem":1},{"lineBreak":true},{"text":"yandi ke salaka ve yimbi na mpangi muntu,","poem":1},{"lineBreak":true},{"text":"yandi ke safulaka ve bayina kele pene-pene na yandi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yandi ke zolaka ve kutala muntu yina kele na mavanga ya busafu,","poem":1},{"lineBreak":true},{"text":"kasi yandi ke zitisaka bayina ke na boma ya Yave.","poem":1},{"lineBreak":true},{"text":"Yandi ke vutukaka ve manima,","poem":1},{"lineBreak":true},{"text":"yandi ke lungisaka nsilulu ya yandi ata ti yawu kele mpasi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yandi ke defisaka ve mbongo ya yandi na ndandu na zulu.","poem":1},{"lineBreak":true},{"text":"Yandi ke ndimaka ve madeso ya bana,","poem":1},{"lineBreak":true},{"text":"samu na kubwisa muntu yina me sala yimbi ve.","poem":1},{"lineBreak":true},{"text":"Muntu yina ke salaka mutindu yina lenda kubwa ata fyoti ve.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}