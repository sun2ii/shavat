t":"Beno kembila yandi na bansambi na dituutu!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Beno kembila yandi na bisasala!","poem":1},{"lineBreak":true},{"text":"Beno kembila yandi na bangongi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bika ti nyonso yina ke wumunaka kukembila Yave!","poem":1},{"lineBreak":true},{"text":"Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}