{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":23,"content":[{"type":"heading","content":["Yave kele Muvungi ya munu"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya Davidi.","descriptive":true},{"text":"Yave kele Muvungi ya munu,","poem":1},{"lineBreak":true},{"text":"mu ke kondwa kima ve.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yandi ke pemisaka munu na matiti ya maza,","poem":1},{"lineBreak":true},{"text":"yandi ke nataka munu na maza ya kuzuna","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yandi ke pesaka mwela ya munu ngolo,","poem":1},{"lineBreak":true},{"text":"yandi ke twadisaka munu na banzila ya ludedomo,","poem":1},{"lineBreak":true},{"text":"samu na Nkumbu ya yandi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ntangu mu ke tambulaka na mudimba ya mpewo ya lufwa,","poem":1},{"lineBreak":true},{"text":"mu ke talaka boma ve, samu ti nge kele na munu.","poem":1},{"lineBreak":true},{"text":"Mukawa na yinti ya nge ya Muvungi ke kebaka munu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nge me kubika mesa samu na munu","poem":1},{"lineBreak":true},{"text":"na mantwala ya mitantu ya munu.","poem":1},{"lineBreak":true},{"text":"Nge me dukula munu mafuta na yintu,","poem":1},{"lineBreak":true},{"text":"mbungu ya munu me fuluka,","poem":1},{"lineBreak":true},{"text":"mafuta ke na kumwangana.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ya tsyelika, buyenge mpe bumbote ke vwanda na munu","poem":1},{"lineBreak":true},{"text":"bilumbu nyonso ya luzingu ya munu.","poem":1},{"lineBreak":true},{"text":"Mu ke vutuka dyaka na Yinzo ya Yave","poem":1},{"lineBreak":true},{"text":"bilumbu nyonso ya luzingu ya munu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}