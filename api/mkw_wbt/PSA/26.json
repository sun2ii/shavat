{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":26,"content":[{"type":"heading","content":["Lusambulu ya muntu ya kusungama"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya Davidi.","descriptive":true},{"text":"Yave, nungisa munu!","poem":1},{"lineBreak":true},{"text":"Samu ti mu ke landaka nzila ya kusungama,","poem":1},{"lineBreak":true},{"text":"mu ke tulaka kivuvu ya munu na Yave, mu ke kubwa ve!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yave fyongonina munu, meka munu,","poem":1},{"lineBreak":true},{"text":"tala mbote-mbote luketo mpe ntima ya munu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kukwikama ya nge kele na ntwala ya meso ya munu,","poem":1},{"lineBreak":true},{"text":"mu ke na kulanda nzila ya butsyelika.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mu ke vwandaka ve na bantu ya luvunu,","poem":1},{"lineBreak":true},{"text":"mu ke tambulaka ve na bantu ya bantima zole.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mu ke yinaka mukangu ya bantu yina ke salaka yimbi,","poem":1},{"lineBreak":true},{"text":"mu ke vwandaka ve kintwadi na bantu ya yimbi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mu me sukula maboko ya munu kidimbu ya muntu me sala ve yimbi,","poem":1},{"lineBreak":true},{"text":"mu ke zungidila kiyokolo ya nge ya minkayulu, Yave,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"samu na kuvutula matondo,","poem":1},{"lineBreak":true},{"text":"mpe kusamuna mambu ya nge ya ngitukulu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yave, mu zola Yinzo kisika yina nge ke zingaka,","poem":1},{"lineBreak":true},{"text":"mpe kisika yina nkembo ya nge ke vwandaka.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kusemba munu ve mutindu mosi na misumuki,","poem":1},{"lineBreak":true},{"text":"kukatula ve luzingu ya munu mutindu mosi na bayina kufwaka bantu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Maboko ya bawu ke salaka mambu ya busafu,","poem":1},{"lineBreak":true},{"text":"maboko ya bawu ya lubakala me fuluka na madeso ya bana.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kasi munu, muke tambula na kusungama nyonso.","poem":1},{"lineBreak":true},{"text":"Kuula munu mpe tala munu kyadi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mu ke na kutambula na nzila ya kusungama,","poem":1},{"lineBreak":true},{"text":"mu ke tonda Yave na kati ya balukutakanu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}