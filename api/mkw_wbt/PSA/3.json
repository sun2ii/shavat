{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":3,"content":[{"type":"heading","content":["Mpulusu ke katukaka na Yave"]},{"type":"verse","number":1,"content":[{"text":"Mukunga yina Davidi yimbilaka na ntangu yina yandi vwandaka kima Abesalome, mwana ya yandi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Yave, mitantu ya munu kele mingi!","poem":1},{"lineBreak":true},{"text":"Bayina ke na kunwanisa munu, bawu kele mingi!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na yina me tadila munu, mingi ke na kutuba:","poem":1},{"lineBreak":true},{"text":"«Nzambi ke vuukisa ve yandi!» Kupema","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kasi nge Yave, nge kele kinwanunu ya munu yina ke kebaka nzutu ya munu.","poem":1},{"lineBreak":true},{"text":"Nge kele nkembo ya munu, nge ke pesaka munu lunungu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ntangu mu ke lookaka na sika ya Yave,","poem":1},{"lineBreak":true},{"text":"yandi ke pesaka munu mvutu, katuka kuna na mongo ya yandi ya longo. Kupema","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ntangu mu ke lalaka, mu ke kuzwaka mpongi,","poem":1},{"lineBreak":true},{"text":"mu ke vumbukaka, samu ti Yave kele kiyekamanu ya munu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mu kele ve na boma ya bantu ya mingi-mingi yayi,","poem":1},{"lineBreak":true},{"text":"yina me zunga munu samu na kunwanisa munu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yave, telama!","poem":1},{"lineBreak":true},{"text":"Nzambi ya munu, vuukisa munu!","poem":1},{"lineBreak":true},{"text":"Ya tsyelika, nge ke bulaka bambeni ya munu nyonso na ditama,","poem":1},{"lineBreak":true},{"text":"nge ke mwangisaka meno ya bantu ya yimbi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yave, mpulusu ke katukaka na sika ya nge.","poem":1},{"lineBreak":true},{"text":"Bika ti lusakumunu ya nge kuvwanda na bantu ya nge! Kupema","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}