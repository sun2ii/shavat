{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Nzambi, kuula munu,","poem":1},{"lineBreak":true},{"text":"nwanina munu na maboko,","poem":1},{"lineBreak":true},{"text":"ya bantu ya yinsi yina ke zolaka nge ve!","poem":1},{"lineBreak":true},{"text":"Kuula munu na maboko ya bantu ya luvunu,","poem":1},{"lineBreak":true},{"text":"bantu yina ke salaka yimbi!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nge kele Nzambi ya munu, kibaka ya munu ya lukengolo,","poem":1},{"lineBreak":true},{"text":"samu na yinki nge me losa munu?","poem":1},{"lineBreak":true},{"text":"Samu na yinki mu ke na kwendaka tambula na kati ya kyadi,","poem":1},{"lineBreak":true},{"text":"na kati ya bankwamusu ya mbeni?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fidisa nsemo ya nge mpe butsyelika ya nge!","poem":1},{"lineBreak":true},{"text":"Yawu kunata munu na mongo ya nge ya longo!","poem":1},{"lineBreak":true},{"text":"Yawu kutwadisa munu na Yinzo ya nge!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mu ke belama pene-pene ya kiyokolo ya minkayulu ya Nzambi.","poem":1},{"lineBreak":true},{"text":"Mu ke belama pene-pene ya Nzambi.","poem":1},{"lineBreak":true},{"text":"Yandi kele nsayi ya munu mpe kyese ya munu.","poem":1},{"lineBreak":true},{"text":"Mu ke kembila nge na nsambi!","poem":1},{"lineBreak":true},{"text":"Oo, Nzambi, nge kele Nzambi ya munu!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Samu na yinki mu ke lemba,","poem":1},{"lineBreak":true},{"text":"samu na yinki mu ke looka?","poem":1},{"lineBreak":true},{"text":"Tula kivuvu ya nge na Nzambi!","poem":1},{"lineBreak":true},{"text":"Mu ke kembila dyaka yandi","poem":1},{"lineBreak":true},{"text":"samu ti yandi kele Muvuukisi ya munu, Nzambi ya munu!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}