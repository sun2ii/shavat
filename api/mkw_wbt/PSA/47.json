{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":47,"content":[{"type":"heading","content":["Beno bula maboko samu na ntinu ya nene"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya bana ya Kole yina ba yimbilaka na lutwadusu ya mfumu ya miyimbidi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Beno bantu nyonso, beno bula maboko!","poem":1},{"lineBreak":true},{"text":"Beno sala milolo ya nsayi samu na Nzambi!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ya tsyelika, Yave Nzambi ya Kulutila Kuzangama, kele Nzambi ya nsisi,","poem":1},{"lineBreak":true},{"text":"yandi kele ntinu ya nene na ntoto nyonso.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yandi me sala ti bantu kuvwanda na yisi ya lutumu ya beto,","poem":1},{"lineBreak":true},{"text":"yandi me tula bayinsi na yisi ya makulu ya beto.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yandi me soola mvwilu samu na beto,","poem":1},{"lineBreak":true},{"text":"yawu ke na kusala nkembo ya Yakobi, yina yandi me zola. Kupema","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nzambi ke na kukota na Yinzo ya yandi,","poem":1},{"lineBreak":true},{"text":"na kati ya milolo ya nsayi.","poem":1},{"lineBreak":true},{"text":"Yave ke na kubelama na muningu ya mpungi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Beno yimbila! Beno yimbila samu na Nzambi!","poem":1},{"lineBreak":true},{"text":"Beno yimbila! Beno yimbila samu na ntinu ya beto!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ya tsyelika, Nzambi kele ntinu ya ntoto nyonso,","poem":1},{"lineBreak":true},{"text":"beno yimbila mukunga!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nzambi kele ntinu na bayinsi,","poem":1},{"lineBreak":true},{"text":"Nzambi kele ya kuvwanda na kiti ya yandi ya longo ya kintinu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bamfumu ya makanda ke na kuvukana,","poem":1},{"lineBreak":true},{"text":"ya kele bantu ya Nzambi ya Abalayami.","poem":1},{"lineBreak":true},{"text":"Ya tsyelika, bamfumu ya ntoto kele bantu ya Nzambi,","poem":1},{"lineBreak":true},{"text":"Nzambi kele na zulu ya bantu nyonso.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":10}