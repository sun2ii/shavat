{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":54,"content":[{"type":"heading","content":["Lusambulu ya muntu yina ba ke na kukwamisa"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya Davidi. Mukunga yina ba twadisaka na mfumu ya miyimbidi, ba ke yimbilaka yawu na muningu ya nsambi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ntangu bantu ya Zife kwizaka tuba na Sawule ti: «Davidi kele ya kubumbama na sika ya beto.»","descriptive":true}]},{"type":"verse","number":3,"content":[{"text":"Nzambi, na Nkumbu ya nge, vuukisa munu,","poem":1},{"lineBreak":true},{"text":"nwanina munu na lulendo ya nge.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nzambi kuwa lusambulu ya munu,","poem":1},{"lineBreak":true},{"text":"teka makutu na mambu yina ke na kubasika na yinwa ya munu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Samu ti banzenza ke na kunwanisa munu,","poem":1},{"lineBreak":true},{"text":"bantu ya yimbi ke na kusosa na kufwa munu,","poem":1},{"lineBreak":true},{"text":"bawu me tula ve Nzambi na mantwala ya bawu. Kupema","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kasi Nzambi kele lusalusu ya munu,","poem":1},{"lineBreak":true},{"text":"Mfumu ke simbaka mwela ya munu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bika ti yandi sala ti mpasi kubwidila bambeni ya munu,","poem":1},{"lineBreak":true},{"text":"na kukwikama ya nge, sala ti bawu kuvwanda swii.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mu ke pesa nge minkayulu na luzolo ya munu mosi,","poem":1},{"lineBreak":true},{"text":"Yave, mu ke kembila Nkumbu ya nge, samu ti yawu kele mbote.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nge me kuula munu na bampasi nyonso,","poem":1},{"lineBreak":true},{"text":"mu ke na kutala kubwa ya bambeni ya munu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":9}