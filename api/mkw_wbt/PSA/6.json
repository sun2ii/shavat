{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":6,"content":[{"type":"heading","content":["Yave, kusemba munu ve!"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya mfumu ya miyimbidi,","descriptive":true},{"text":"ba ke yimbilaka yawu na nsambi,","poem":1},{"lineBreak":true},{"text":"na nsambi ya basinga nana.","poem":1},{"lineBreak":true},{"text":"Mukunga ya Davidi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yave, kupesa ve munu kitumbu na kati ya nkele ya nge,","poem":1},{"lineBreak":true},{"text":"kusemba ve munu na kudasuka nyonso!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yave, lakisa munu bumbote ya nge, mu kele dyaka na ngolo ve!","poem":1},{"lineBreak":true},{"text":"Yave nyakisa munu, samu ti mu ke na kutekita tii na mikwa!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nzutu ya munu nyonso ke na kutekita.","poem":1},{"lineBreak":true},{"text":"Nge Yave, tii wapi ntangu?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yave, kwiza, kuula munu,","poem":1},{"lineBreak":true},{"text":"vuukisa munu samu na bumbote ya nge.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ya tsyelika, na kati ya lufwa, muntu ve lenda bokila Nkumbu ya nge.","poem":1},{"lineBreak":true},{"text":"Na yinsi ya bantu ya kufwa, nani lenda kembila nge?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mu me lemba na kuyawula.","poem":1},{"lineBreak":true},{"text":"Konso mpimpa, mu ke fulusaka mfulu ya munu na mansangasa.","poem":1},{"lineBreak":true},{"text":"Mu ke bolisaka mfulu ya munu na maza ya meso ya munu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Meso ya munu me lemba, samu ti manyongo me lutila.","poem":1},{"lineBreak":true},{"text":"Yawu ke na kutala dyaka mbote ve, samu na bambeni ya munu nyonso.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Beno katuka na sika ya munu, beno bayina ke salaka yimbi,","poem":1},{"lineBreak":true},{"text":"samu ti Yave me kuwa bidilu ya munu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yave me kuwa kuyawula ya munu.","poem":1},{"lineBreak":true},{"text":"Yave me ndima lusambulu ya munu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bambeni ya munu nyonso me kuma na nsoni,","poem":1},{"lineBreak":true},{"text":"bawu ke na kutekita na boma.","poem":1},{"lineBreak":true},{"text":"Na mpamukunu, bawu ke vutuka na nsoni nyonso.","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}