{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":61,"content":[{"type":"heading","content":["Mu zola kuvwanda bantangu nyonso na Yinzo ya nge"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya Davidi. Mukunga yina ba twadisaka na mfumu ya miyimbidi, ba ke yimbilaka yawu na muningu ya nsambi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Nzambi, kuwa kulooka ya munu,","poem":1},{"lineBreak":true},{"text":"kuwa mbote lusambulu ya munu!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Katuka na bandilu ya ntoto,","poem":1},{"lineBreak":true},{"text":"mu ke na kusambila nge na ntima ya kulemba.","poem":1},{"lineBreak":true},{"text":"Twadisa munu na ditadi ya nene yina me lutila kuzangama na munu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Samu ti nge kele kiswamunu ya munu,","poem":1},{"lineBreak":true},{"text":"yinzo ya mutela ya yinda ya lukengolo na mantwala ya bambeni.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mu zola kuzinga bantangu nyonso na Yinzo ya nge ya lele,","poem":1},{"lineBreak":true},{"text":"mu kuzwa kiswamunu na yisi ya mapapu ya nge. Kupema","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ya tsyelika, Nzambi, nge ke kuwaka balukanu ya munu.","poem":1},{"lineBreak":true},{"text":"Nge me pesa mvwilu ya nge na bayina ke zitisaka Nkumbu ya nge.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bwela bilumbu na luzingu ya ntinu,","poem":1},{"lineBreak":true},{"text":"bamvula ya yandi kubwelama bambandu na bambandu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yandi vwanda na kiti ya kintinu bantangu nyonso na ntadisi ya Nzambi.","poem":1},{"lineBreak":true},{"text":"Sala ti kukwikama ya nge na luzolo ya nge kukeba yandi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Na yina, mu ke yimbila nge bantangu nyonso,","poem":1},{"lineBreak":true},{"text":"mu ke lungisa balukanu ya munu ya konso kilumbu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":9}