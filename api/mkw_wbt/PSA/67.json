{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":67,"content":[{"type":"heading","content":["Bika ti bantu nyonso kukembila nge"]},{"type":"verse","number":1,"content":[{"text":"Mukunga yina ba twadisaka na mfumu ya miyimbidi, ba ke yimbilaka yawu na muningu ya nsambi. Mukunga.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Bika ti Nzambi kufwila beto kyadi,","poem":1},{"lineBreak":true},{"text":"mpe yandi kusakumuna beto.","poem":1},{"lineBreak":true},{"text":"Yandi kusala ti kizizi ya yandi kulezima na sika ya beto. Kupema","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na yina, bantu nyonso ya ntoto ke zaba nzila ya nge.","poem":1},{"lineBreak":true},{"text":"Mpulusu ya nge ke zabakana na bantu nyonso!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bika ti bantu kukembila nge, Nzambi!","poem":1},{"lineBreak":true},{"text":"Bika ti bantu nyonso kukembila nge!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bantu ya bayinsi nyonso ke na kuyangalala,","poem":1},{"lineBreak":true},{"text":"bawu ke na kusala milolo ya nsayi.","poem":1},{"lineBreak":true},{"text":"Samu ti nge ke fundisaka bantu na kati ya kusungama nyonso.","poem":1},{"lineBreak":true},{"text":"Ni nge ke twadisaka bantu ya bayinsi awa na ntoto. Kupema","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bika ti bantu kukembila nge, Nzambi!","poem":1},{"lineBreak":true},{"text":"Bika ti bantu nyonso kukembila nge!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ntoto me pesa madya ya yawu,","poem":1},{"lineBreak":true},{"text":"Nzambi, Nzambi ya beto me sakumuna beto.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nzambi me sakumuna beto,","poem":1},{"lineBreak":true},{"text":"tii na bandilu nyonso ya ntoto ba ke na kuzitisa yandi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":8}