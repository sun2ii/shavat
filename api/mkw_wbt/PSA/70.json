{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":70,"content":[{"type":"heading","content":["Yave kwiza nswalu mpe sadisa munu"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya Davidi. Mukunga yina ba twadisaka na mfumu ya miyimbidi. Mukunga samu na kubambukaka Nzambi moyo.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Oo, Nzambi kuula munu!","poem":1},{"lineBreak":true},{"text":"Yave, kwiza mbangu samu na kusadisa munu!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bika ti bayina ke na kusosa lufwa ya munu,","poem":1},{"lineBreak":true},{"text":"bawu kutala nsoni, bawu kusafuka!","poem":1},{"lineBreak":true},{"text":"Bika ti bayina ke na kusosa kusala munu yimbi!","poem":1},{"lineBreak":true},{"text":"Bawu kuvutuka manima na nsoni.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bika ti bayina ke na kuseka munu,","poem":1},{"lineBreak":true},{"text":"bawu kuvutuka na nsoni.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bika ti bayina nyonso ke na kusosa nge,","poem":1},{"lineBreak":true},{"text":"bawu yangalala mpe bawu vwanda na kyese!","poem":1},{"lineBreak":true},{"text":"Bika ti bayina ke zolaka mpulusu ya nge, bawu kutuba ntangu nyonso:","poem":1},{"lineBreak":true},{"text":"«Nzambi kele Nzambi ya nene!»","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Munu, mu kele mputu mpe muntu ya mpasi.","poem":1},{"lineBreak":true},{"text":"Oo, Nzambi kwiza nswalu.","poem":1},{"lineBreak":true},{"text":"Nge kele nsadisi mpe kikuudi ya munu.","poem":1},{"lineBreak":true},{"text":"Yave kulutisa ve ntangu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":6}