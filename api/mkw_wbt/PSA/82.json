{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":82,"content":[{"type":"heading","content":["Nzambi, ludedomo ya bantu nyonso"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya Asafe.","descriptive":true},{"text":"Nzambi kele na kati ya lukutakanu ya Nzambi.","poem":1},{"lineBreak":true},{"text":"Yandi ke na kufundisa na kati-kati ya Banzambi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tii wapi ntangu beno ke fundisa na kati ya kondwa ludedomo,","poem":1},{"lineBreak":true},{"text":"mpe beno ke na kunungisa bantu ya yimbi? Kupema","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Beno fundisa mbote muntu ya kyadi mpe mwana-nsaana,","poem":1},{"lineBreak":true},{"text":"beno sadila ludedomo na mputu mpe na muntu ya mpasi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Beno vuukisa muntu ya kyadi mpe mputu","poem":1},{"lineBreak":true},{"text":"beno kuula bawu na maboko ya bantu ya yimbi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Bawu kele ve na luzabu mpe mayela,","poem":1},{"lineBreak":true},{"text":"bawu ke na kati kitombe, ni yawu yina,","poem":1},{"lineBreak":true},{"text":"balufulu yina ke na kusimba ntoto ke na kuningana.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mu tubaka ti beno kele banzambi,","poem":1},{"lineBreak":true},{"text":"beno nyonso kele bana ya Nzambi ya Kulutila Kuzangama.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kasi, beno ke na kufwa mutindu bantu ya mpamba,","poem":1},{"lineBreak":true},{"text":"beno ke na kubwa mutindu bamfumu ya mutindu na mutindu.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nzambi, telama mpe fundisa yinza,","poem":1},{"lineBreak":true},{"text":"samu ti bayinsi nyonso kele mvwilu ya nge!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}