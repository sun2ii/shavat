{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":87,"content":[{"type":"heading","content":["Siyone mama ya bambanza ya bantu nyonso"]},{"type":"verse","number":1,"content":[{"text":"Mukunga ya bana ya Kole. Mukunga.","descriptive":true},{"text":"Nzambi me tunga Siyone na zulu ya myongo ya longo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yave ke zolaka myelo ya mbanza Siyone","poem":1},{"lineBreak":true},{"text":"kulutila bayinzo nyonso ya bana ya Yakobi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nge mbanza ya Nzambi,","poem":1},{"lineBreak":true},{"text":"ba me zonzila mambu ya nkembo na yina me tadila nge. Kupema","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«Mu ke zonzila na yinsi ya Ngipiti mpe ya Babilone,","poem":1},{"lineBreak":true},{"text":"na kati ya bayinsi yina zaba munu,","poem":1},{"lineBreak":true},{"text":"yinsi ya ba-Filiseti, ya bantu ya Tile, mpe ya bantu ya Kuse,","poem":1},{"lineBreak":true},{"text":"ni kuna ba butaka bawu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kasi na mbanza Siyone, yandi me tuba:","poem":1},{"lineBreak":true},{"text":"Ni kuna ba butaka bawu nyonso,","poem":1},{"lineBreak":true},{"text":"ni Nzambi ya Kulutila Kuzangama yidikaka yawu.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ntangu Yave ke tangaka bantu,","poem":1},{"lineBreak":true},{"text":"yandi ke sonikaka ti yandi yayi «butukaka na kisika yayi.» Kupema","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bantu yina ke na kuyimba mpe yina ke na kubina, bawu ke na kulooka:","poem":1},{"lineBreak":true},{"text":"«Nsayi nyonso ya beto ke katukaka na nge.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}