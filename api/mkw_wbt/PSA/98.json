{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"PSA","translationId":"mkw_wbt","name":"Mikunga","commonName":"Mikunga","title":"Dibuku ya MIKUNGA","order":19,"numberOfChapters":150,"sha256":"6535423dbab0977ec818c8702a76c43ddddd91d74584351b4c93c184b9d064de","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mkw_wbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":98,"content":[{"type":"heading","content":["Yave ke kwiza yala"]},{"type":"verse","number":1,"content":[{"text":"Mukunga.","descriptive":true},{"text":"Beno yimbidila Yave mukunga ya malu-malu,","poem":1},{"lineBreak":true},{"text":"samu ti yandi ke salaka mambu ya ngitukulu,","poem":1},{"lineBreak":true},{"text":"diboko ya yandi ya lubakala mpe diboko ya yandi ya longo me pesa yandi lunungu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yave me sala ti bantu kuzaba ti yandi ke vuukisaka,","poem":1},{"lineBreak":true},{"text":"yandi me lakisa ludedomo ya yandi na meso ya bantu ya bayinsi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yandi me bambuka moyo na bumbote","poem":1},{"lineBreak":true},{"text":"mpe na kukwikama ya yandi, samu na bantu ya Isayeli,","poem":1},{"lineBreak":true},{"text":"bantu yina kele na bandilu nyonso ya ntoto,","poem":1},{"lineBreak":true},{"text":"me tala mpulusu ya Nzambi ya beto.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Beno sala milolo ya nsayi, beno bantu nyonso ya ntoto!","poem":1},{"lineBreak":true},{"text":"Beno looka na nsayi nyonso, beno yimbila!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Beno sika nsambi samu na Yave,","poem":1},{"lineBreak":true},{"text":"beno wakisa muningu ya nsambi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Beno sika bakulumenta mpe beno wakisa muningu ya mpungi,","poem":1},{"lineBreak":true},{"text":"beno sala milolo ya nsayi na ntadisi ya Yave ntinu!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bika ti mubu na nyonso yina kele na yawu kusala makelele,","poem":1},{"lineBreak":true},{"text":"mutindu mosi mpe yinza na bantu nyonso yina ke zingaka na yinza!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bika ti banzadi kubula maboko,","poem":1},{"lineBreak":true},{"text":"kintwadi na banzadi, myongo kusala milolo ya nsayi,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"na ntadisi ya Yave,","poem":1},{"lineBreak":true},{"text":"samu ti yandi ke na kwiza fundisa yinza!","poem":1},{"lineBreak":true},{"text":"Yandi ke fundisa yinza na ludedomo,","poem":1},{"lineBreak":true},{"text":"yandi ke fundisa bantu na kusungama nyonso.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}