{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"ZEC","translationId":"mkw_wbt","name":"Zakali","commonName":"Zakali","title":"Dibuku ya ZAKALI","order":38,"numberOfChapters":14,"sha256":"becedd244aef6b7c0036c5278346784131d63ed76621623855462a9e733badb7","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mkw_wbt/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":14,"content":[{"type":"heading","content":["Kilumbu Yave ke na kukwiza"]},{"type":"verse","number":1,"content":["Yelusalemi, Kilumbu ya Yave ke na",{"text":"kukwiza mpe ba ke kabula bimvwama","poem":1},{"lineBreak":true},{"text":"ya nge na meso ya nge.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mu ke vukisa bantu ya bayinsi nyonso","poem":1},{"lineBreak":true},{"text":"samu na kunwanisa Yelusalemi.","poem":1},{"lineBreak":true},{"text":"Bawu ke baka mbanza,","poem":1},{"lineBreak":true},{"text":"ke mwangisa bayinzo,","poem":1},{"lineBreak":true},{"text":"mpe ke baka bakento na ngolo.","poem":1},{"lineBreak":true},{"text":"Ndambu ya bantu ke kwenda","poem":1},{"lineBreak":true},{"text":"na bayinsi ya nzenza,","poem":1},{"lineBreak":true},{"text":"kasi ndambu ya nkaka ya bantu","poem":1},{"lineBreak":true},{"text":"ke bikana na kati ya mbanza.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yave ke talana mpe yandi","poem":1},{"lineBreak":true},{"text":"ke nwanisa bantu ya bayinsi yina,","poem":1},{"lineBreak":true},{"text":"mutindu yandi ke nwanaka","poem":1},{"lineBreak":true},{"text":"na kilumbu ya mvita.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Na kilumbu yina, yandi ke","poem":1},{"lineBreak":true},{"text":"kwenda telama na zulu","poem":1},{"lineBreak":true},{"text":"ya mongo ya ba-Olive,","poem":1},{"lineBreak":true},{"text":"ntama ve na mbanza Yelusalemi,","poem":1},{"lineBreak":true},{"text":"na lweka ya esete ya mbanza.","poem":1},{"lineBreak":true},{"text":"Mongo ya ba-Olive ke pasuka","poem":1},{"lineBreak":true},{"text":"na kati-kati, dibenga","poem":1},{"lineBreak":true},{"text":"ya nene ke talana kubanda","poem":1},{"lineBreak":true},{"text":"na esete tii na wesete.","poem":1},{"lineBreak":true},{"text":"Ndambu ya mongo ke kwenda","poem":1},{"lineBreak":true},{"text":"na node, ndambu ya","poem":1},{"lineBreak":true},{"text":"nkaka ke kwenda na sude.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Beno ke kima na kati ya dibenga","poem":1},{"lineBreak":true},{"text":"ya myongo ya munu, samu ti","poem":1},{"lineBreak":true},{"text":"dibenga ya myongo ke","poem":1},{"lineBreak":true},{"text":"kwenda tii na yinsi ya Asale.","poem":1},{"lineBreak":true},{"text":"Beno ke kima mutindu bankooko","poem":1},{"lineBreak":true},{"text":"ya beno kimaka ntangu ntoto","poem":1},{"lineBreak":true},{"text":"ninganaka na ntangu yina","poem":1},{"lineBreak":true},{"text":"Ozyase vwandaka ntinu ya Yuda.","poem":1},{"lineBreak":true},{"text":"Yave ke kwiza kintwadi","poem":1},{"lineBreak":true},{"text":"na balongo ya yandi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Na kilumbu yina, nsemo ke vwanda ve,","poem":1},{"lineBreak":true},{"text":"madidi mpe madidi ya kulutila ke vwanda.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yawu ke vwanda kilumbu","poem":1},{"lineBreak":true},{"text":"ya mutindu ya nkaka,","poem":1},{"lineBreak":true},{"text":"kaka ni Yave zaba yawu.","poem":1},{"lineBreak":true},{"text":"Mpimpa na ntangu","poem":1},{"lineBreak":true},{"text":"ke vwanda dyaka ve","poem":1},{"lineBreak":true},{"text":"kasi na nkokila, nsemo ke lezima.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Na kilumbu yina, mukelo ya maza","poem":1},{"lineBreak":true},{"text":"ke basika na Yelusalemi.","poem":1},{"lineBreak":true},{"text":"Ndambu ya maza","poem":1},{"lineBreak":true},{"text":"ke kwenda na mubu yina kele","poem":1},{"lineBreak":true},{"text":"na esete, ndambu ya nkaka","poem":1},{"lineBreak":true},{"text":"ke kwenda na mubu yina kele na wesete.","poem":1},{"lineBreak":true},{"text":"Yawu ke vwandila mutindu","poem":1},{"lineBreak":true},{"text":"yina na kisiwu mpe na bamvula.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Na kilumbu yina, Yave ke kuma","poem":1},{"lineBreak":true},{"text":"ntinu ya ntoto nyonso.","poem":1},{"lineBreak":true},{"text":"Ni Yave Nzambi mosi kaka","poem":1},{"lineBreak":true},{"text":"mpe kaka ni Nkumbu ya yandi","poem":1},{"lineBreak":true},{"text":"ke kemboswa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yinsi nyonso ke kituka mutindu","poem":1},{"lineBreak":true},{"text":"ntoto ya mudimba ya Yolodani yina ata kima ke menaka ve kubanda","poem":1},{"lineBreak":true},{"text":"na Ngeba tii na Limone na sude ya","poem":1},{"lineBreak":true},{"text":"Yelusalemi. Yelusalemi ke vwanda","poem":1},{"lineBreak":true},{"text":"kaka na zulu ya mongo na kisika","poem":1},{"lineBreak":true},{"text":"yina yawu kele, Kubanda na mwelo","poem":1},{"lineBreak":true},{"text":"ya Bezame tii na kisika yina kele","poem":1},{"lineBreak":true},{"text":"mwelo ya ntete, kubanda na yinzo","poem":1},{"lineBreak":true},{"text":"ya mutela ya yinda ya Ananeele","poem":1},{"lineBreak":true},{"text":"tii na kisika yina ba ke","poem":1},{"lineBreak":true},{"text":"kamunaka vinu ya ntinu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bantu ke zinga na kati ya mbanza,","poem":1},{"lineBreak":true},{"text":"ba ke mwangisa dyaka yawu ve,","poem":1},{"lineBreak":true},{"text":"Yelusalemi ke vwanda na kizunu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Na yina me tadila bantu","poem":1},{"lineBreak":true},{"text":"yina nwanisaka Yelusalemi,","poem":1},{"lineBreak":true},{"text":"Yave ke pesa bawu kitumbu yayi:","poem":1},{"lineBreak":true},{"text":"Tekila bawu kufwa, banzutu,","poem":1},{"lineBreak":true},{"text":"baludimi mpe meso ya bawu ke bola.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Na kilumbu yina, Yave ke kotisa","poem":1},{"lineBreak":true},{"text":"mvwanzi na kati ya bawu","poem":1},{"lineBreak":true},{"text":"mpe ba ke nwana bawu na bawu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bantu ya Yuda mpe ke","poem":1},{"lineBreak":true},{"text":"nwana na kati ya Yelusalemi.","poem":1},{"lineBreak":true},{"text":"Bawu ke baka bimvwama","poem":1},{"lineBreak":true},{"text":"ya bayinsi nyonso yina kele","poem":1},{"lineBreak":true},{"text":"pene-pene na Yelusalemi mutindu","poem":1},{"lineBreak":true},{"text":"wolo, palata mpe lutangu mingi ya binkuti.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nsembolo ke kubwa na bibulu nyonso,","poem":1},{"lineBreak":true},{"text":"ya vwanda bampunda,","poem":1},{"lineBreak":true},{"text":"bampunda ya ntela ya mwa nkufi,","poem":1},{"lineBreak":true},{"text":"basamo, bambuluku mpe bibulu nyonso","poem":1},{"lineBreak":true},{"text":"yina kele na kisika yina,","poem":1},{"lineBreak":true},{"text":"yawu ke tala mpasi mutindu mpasi ya ntete.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Na yina, bantu ya bayinsi","poem":1},{"lineBreak":true},{"text":"yina kwizaka nwanisa Yelusalemi","poem":1},{"lineBreak":true},{"text":"mpe ke ntete moyo, ke kwenda","poem":1},{"lineBreak":true},{"text":"konso mvula kuna na Yelusalemi","poem":1},{"lineBreak":true},{"text":"samu na kusambila Ntinu,","poem":1},{"lineBreak":true},{"text":"Yave, Nzambi ya Binwani","poem":1},{"lineBreak":true},{"text":"mpe samu na kusala","poem":1},{"lineBreak":true},{"text":"mukembo ya mileba.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kasi samu na makanda yina","poem":1},{"lineBreak":true},{"text":"ke kwenda ve na Yelusalemi samu","poem":1},{"lineBreak":true},{"text":"na kuyinama na mantwala ya Ntinu,","poem":1},{"lineBreak":true},{"text":"Yave, Nzambi ya Binwani,","poem":1},{"lineBreak":true},{"text":"mvula ke noka ve na ntoto ya bawu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kana dikanda ya Ngipiti","poem":1},{"lineBreak":true},{"text":"kwenda ve kuna na Yelusalemi","poem":1},{"lineBreak":true},{"text":"samu na mukembo ya mileba,","poem":1},{"lineBreak":true},{"text":"Yave ke sala ti yawu mpe kutala","poem":1},{"lineBreak":true},{"text":"mpasi mutindu bayinsi ya nkaka","poem":1},{"lineBreak":true},{"text":"yina ke manga na kukwenda","poem":1},{"lineBreak":true},{"text":"na mukembo yango.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yayi kele mpasi yina ke tala Ngipiti","poem":1},{"lineBreak":true},{"text":"mpe bayinsi ya nkaka,","poem":1},{"lineBreak":true},{"text":"bayina ke manga na kukwenda","poem":1},{"lineBreak":true},{"text":"na mukembo yina.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Na kilumbu yina, na zulu","poem":1},{"lineBreak":true},{"text":"ya mwa bangunga yina","poem":1},{"lineBreak":true},{"text":"ba ke lwatisaka bampunda,","poem":1},{"lineBreak":true},{"text":"ba ke sonika mutindu yayi:","poem":1},{"lineBreak":true},{"text":"«Ya kele ya kubyekwa samu na Yave.»","poem":1},{"lineBreak":true},{"text":"Banzungu ya Yinzo ya Yave","poem":1},{"lineBreak":true},{"text":"mpe ke vwanda ya kuvedila mutindu","poem":1},{"lineBreak":true},{"text":"bambungu yina ba ke sadilaka na","poem":1},{"lineBreak":true},{"text":"kiyokolo ya minkayulu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Banzungu nyonso yina kele","poem":1},{"lineBreak":true},{"text":"na Yelusalemi mpe na Yuda,","poem":1},{"lineBreak":true},{"text":"ba ke byeka yawu samu na Yave,","poem":1},{"lineBreak":true},{"text":"Nzambi ya binwani. Bayina nyonso","poem":1},{"lineBreak":true},{"text":"ke kwiza samu na kuyoka minkayulu,","poem":1},{"lineBreak":true},{"text":"ke sadila na banzungu yina samu","poem":1},{"lineBreak":true},{"text":"na kulambila na yawu.","poem":1},{"lineBreak":true},{"text":"Na kilumbu yina, muntu","poem":1},{"lineBreak":true},{"text":"ya mumbungu ke vwanda dyaka ve","poem":1},{"lineBreak":true},{"text":"na kati ya Yinzo ya","poem":1},{"lineBreak":true},{"text":"Yave, Nzambi ya Binwani.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/ZEC/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/MAL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/ZEC/13.json","previousChapterAudioLinks":{},"numberOfVerses":21}