{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"ZEC","translationId":"mkw_wbt","name":"Zakali","commonName":"Zakali","title":"Dibuku ya ZAKALI","order":38,"numberOfChapters":14,"sha256":"becedd244aef6b7c0036c5278346784131d63ed76621623855462a9e733badb7","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mkw_wbt/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":3,"content":[{"type":"heading","content":["Lumoni ya yiya: Yeswa mfumu ya banganga-Nzambi"]},{"type":"verse","number":1,"content":["Yave lakisaka munu Yeswa, mfumu ya banganga-Nzambi, yina vwandaka ya kutelama na mantwala ya mbazi ya Yave, mpe Satana vwandaka ya kutelama na lubakala ya Yeswa samu na kufunda yandi."]},{"type":"verse","number":2,"content":["Mpe Yave tubaka na Satana: «Satana, bika Yave kangisa nge yinwa. Ee, ni Yave me soola Yelusalemi, bika yandi kangisa nge yinwa. Yeswa kele ve mutindu kisisi yina ba me katula na tiya?»"]},{"type":"verse","number":3,"content":["Yeswa vwandaka ya kutelama na mantwala ya mbazi, yandi vwandaka ya kulwata binkuti ya mvindu."]},{"type":"verse","number":4,"content":["Mbazi zabisaka na bayina vwandaka na yandi na kukatula Yeswa binkuti yina. Mpe yandi tubaka na Yeswa: «Tala, mu me katula masumu ya nge mpe mu ke lwatisa nge binkuti ya feti.»"]},{"type":"verse","number":5,"content":["Mbazi tubaka dyaka: «Beno tula Yeswa yimpu ya bunganga-Nzambi na yintu.» Bawu tulaka yandi yawu mpe lwatisaka yandi binkuti. Mbazi ya Yave vwandaka ya kutelama kuna."]},{"type":"verse","number":6,"content":["Mbazi ya Yave singisaka Yeswa na kutuba:"]},{"type":"verse","number":7,"content":["Yave, Nzambi ya Binwani",{"text":"ke na kutuba:","poem":1},{"lineBreak":true},{"text":"«kana nge landa banzila ya munu,","poem":1},{"lineBreak":true},{"text":"kana nge sadila misiku ya munu,","poem":1},{"lineBreak":true},{"text":"nge ke kuma ntwadisi ya Yinzo ya munu,","poem":1},{"lineBreak":true},{"text":"nge ke kengidila lupangu ya munu,","poem":1},{"lineBreak":true},{"text":"mpe mu ke tula nge na mulonga ya bayina","poem":1},{"lineBreak":true},{"text":"ke na kusadilaka munu awa.»","poem":1}]},{"type":"heading","content":["Kisyelo ya Yave"]},{"type":"verse","number":8,"content":[{"text":"«Kuwa, nge Yeswa mfumu ya","poem":1},{"lineBreak":true},{"text":"banganga-Nzambi, mutindu mosi","poem":1},{"lineBreak":true},{"text":"mpe beno banganga-Nzambi","poem":1},{"lineBreak":true},{"text":"yina kele na yandi,","poem":1},{"lineBreak":true},{"text":"beno kele kidimbu ya mambu","poem":1},{"lineBreak":true},{"text":"yina ke kwiza.","poem":1},{"lineBreak":true},{"text":"Mu ke fidisa kisyelo ya munu,","poem":1},{"lineBreak":true},{"text":"ba ke bokila yandi “Mutwikila”.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tala, ditadi yayi mu me tula","poem":1},{"lineBreak":true},{"text":"na mantwala ya Yeswa,","poem":1},{"lineBreak":true},{"text":"yawu kele na meso nsambwadi,","poem":1},{"lineBreak":true},{"text":"na zulu ya ditadi kaka mosi yayi.","poem":1},{"lineBreak":true},{"text":"Munu mosi ke sonika","poem":1},{"lineBreak":true},{"text":"mambu na zulu ya yawu, mpe","poem":1},{"lineBreak":true},{"text":"mu ke katula masumu ya yinsi yayi","poem":1},{"lineBreak":true},{"text":"na kilumbu mosi.","poem":1},{"lineBreak":true},{"text":"Ni Yave, Nzambi ya Binwani me tuba yawu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yave, Nzambi ya Binwani","poem":1},{"lineBreak":true},{"text":"ke na kutuba, na kilumbu yina,","poem":1},{"lineBreak":true},{"text":"konso muntu na kati ya beno ke","poem":1},{"lineBreak":true},{"text":"bokila bampangi ya yandi,","poem":1},{"lineBreak":true},{"text":"samu na kwiza kuvukana na kyese","poem":1},{"lineBreak":true},{"text":"na yisi ya yinti ya vinu","poem":1},{"lineBreak":true},{"text":"mpe na yisi ya yinti ya fike.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/ZEC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/ZEC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/ZEC/2.json","previousChapterAudioLinks":{},"numberOfVerses":10}