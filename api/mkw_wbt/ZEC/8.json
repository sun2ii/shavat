{"translation":{"id":"mkw_wbt","name":"Mambu ya Nzambi","website":"https://ebible.org/Scriptures/details.php?id=mkw","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mkw","licenseNotes":null,"shortName":"WBT","englishName":"Kituba Bible","language":"mkw","textDirection":"ltr","sha256":"42013135311271cd3e39e54c1db8664108a7c128f4925bc67ee2cf6f23f5a3f1","availableFormats":["json"],"listOfBooksApiLink":"/api/mkw_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31165,"languageName":"Kituba (Congo)","languageEnglishName":"Kituba (Congo)"},"book":{"id":"ZEC","translationId":"mkw_wbt","name":"Zakali","commonName":"Zakali","title":"Dibuku ya ZAKALI","order":38,"numberOfChapters":14,"sha256":"becedd244aef6b7c0036c5278346784131d63ed76621623855462a9e733badb7","firstChapterNumber":1,"firstChapterApiLink":"/api/mkw_wbt/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/mkw_wbt/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":8,"content":[{"type":"heading","content":["Bansilulu ya Yave samu na Yelusalemi"]},{"type":"verse","number":1,"content":["Mambu ya Yave, Nzambi ya Binwani,",{"text":"kuminaka munu mutindu yayi:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Yave, Nzambi ya Binwani, ke na kutuba:","poem":1},{"lineBreak":true},{"text":"Mu ke na kimbanda ya kulutila samu","poem":1},{"lineBreak":true},{"text":"na Siyone, mu ke na nkele ya kulutila","poem":1},{"lineBreak":true},{"text":"mpe mu zola yandi mingi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yave ke na kutuba, mu ke vutuka","poem":1},{"lineBreak":true},{"text":"na Siyone mpe mu ke zinga","poem":1},{"lineBreak":true},{"text":"na kati-kati ya Yelusalemi.","poem":1},{"lineBreak":true},{"text":"Ba ke bokila Yelusalemi","poem":1},{"lineBreak":true},{"text":"“Mbanza ya kukwikama”","poem":1},{"lineBreak":true},{"text":"mpe mongo ya Yave, Nzambi","poem":1},{"lineBreak":true},{"text":"ya Binwani, ba ke bokila yawu","poem":1},{"lineBreak":true},{"text":"“Mongo ya longo.”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yave, Nzambi ya Binwani, ke na kutuba:","poem":1},{"lineBreak":true},{"text":"Biboba mingi ya bakento","poem":1},{"lineBreak":true},{"text":"mpe ya babakala,","poem":1},{"lineBreak":true},{"text":"konso muntu na yinti ya yandi na diboko,","poem":1},{"lineBreak":true},{"text":"bawu ke banda na kuvwandaka","poem":1},{"lineBreak":true},{"text":"dyaka na bisika yina bantu ke bakaka","poem":1},{"lineBreak":true},{"text":"mupepe na Yelusalemi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bisika yango ke fuluka dyaka","poem":1},{"lineBreak":true},{"text":"na bantwenya ya bakento","poem":1},{"lineBreak":true},{"text":"mpe ya babakala,","poem":1},{"lineBreak":true},{"text":"bawu ke banda na kwendaka sakana kuna.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yave, Nzambi ya Binwani,","poem":1},{"lineBreak":true},{"text":"ke na kutuba ti,","poem":1},{"lineBreak":true},{"text":"kana bantu ya Isayeli, bayina","poem":1},{"lineBreak":true},{"text":"katukaka na yinsi ya nzenza","poem":1},{"lineBreak":true},{"text":"ke na kubanza ti mambu yayi","poem":1},{"lineBreak":true},{"text":"lenda kusalama ve na ntangu ya bawu,","poem":1},{"lineBreak":true},{"text":"munu mpe Yave, Nzambi ya Binwani, mu ke ndima ti","poem":1},{"lineBreak":true},{"text":"yawu lenda kusalama ve?","poem":1},{"lineBreak":true},{"text":"Ni munu Yave, Nzambi ya","poem":1},{"lineBreak":true},{"text":"Binwani, me tuba yawu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ni yawu yina, Yave, Nzambi ya","poem":1},{"lineBreak":true},{"text":"Binwani, ke na kutuba:","poem":1},{"lineBreak":true},{"text":"Ya tsyelika, mu ke kuula bantu","poem":1},{"lineBreak":true},{"text":"ya munu bayina kwendaka zinga","poem":1},{"lineBreak":true},{"text":"na bayinsi ya nzenza yina","poem":1},{"lineBreak":true},{"text":"kele na esete mpe na wesete.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mu ke katula bawu kuna","poem":1},{"lineBreak":true},{"text":"mpe bawu ke kwiza zinga na Yelusalemi,","poem":1},{"lineBreak":true},{"text":"bawu ke vwanda bantu ya munu mpe mu","poem":1},{"lineBreak":true},{"text":"ke vwanda Nzambi ya bawu,","poem":1},{"lineBreak":true},{"text":"na kati ya kukwikama mpe ludedomo.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yave, Nzambi ya Binwani ke na kutuba:","poem":1},{"lineBreak":true},{"text":"«Beno vwanda na kibakala!","poem":1},{"lineBreak":true},{"text":"Beno bayina ke na kuwa mambu","poem":1},{"lineBreak":true},{"text":"yina mimbikudi tubaka, na","poem":1},{"lineBreak":true},{"text":"ntangu yina bantu vwandaka tunga lufulu,","poem":1},{"lineBreak":true},{"text":"samu na kutunga dyaka,","poem":1},{"lineBreak":true},{"text":"Yinzo ya Yave, Nzambi ya Binwani.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Na ntangu ya ntama, bantu vwandaka","poem":1},{"lineBreak":true},{"text":"kuzwa ve difuta ya bisalu ya bawu","poem":1},{"lineBreak":true},{"text":"mpe bibulu vwandaka na ndandu ve,","poem":1},{"lineBreak":true},{"text":"ata muntu vwandaka lenda na","poem":1},{"lineBreak":true},{"text":"kutambula na kimpwanza samu na bambeni,","poem":1},{"lineBreak":true},{"text":"mu salaka ti bantu kuwisana dyaka ve.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kasi ntangu yayi, mu ke tala beno","poem":1},{"lineBreak":true},{"text":"mutindu mosi ve na bayina","poem":1},{"lineBreak":true},{"text":"katukaka na yinsi ya nzenza,","poem":1},{"lineBreak":true},{"text":"ni Yave, Nzambi ya Binwani, me tuba yawu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mu ke tula kizunu na kati-kati ya beno:","poem":1},{"lineBreak":true},{"text":"Bilanga ya bayinti ya vinu ke buta bambuma,","poem":1},{"lineBreak":true},{"text":"ntoto ke pesa madya mingi,","poem":1},{"lineBreak":true},{"text":"bamvula ke noka mingi mpe mu","poem":1},{"lineBreak":true},{"text":"ke pesa bima nyonso yayi","poem":1},{"lineBreak":true},{"text":"mutindu kimvwama","poem":1},{"lineBreak":true},{"text":"na sika ya bantu yayi, yina me bikana.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Beno bantu ya Yuda mpe ya Isayeli,","poem":1},{"lineBreak":true},{"text":"na ntangu yina beno vwandaka","poem":1},{"lineBreak":true},{"text":"na kati-kati ya bayinsi ya nkaka,","poem":1},{"lineBreak":true},{"text":"beno vwandaka mutindu bantu yina ke na nsingulu.","poem":1},{"lineBreak":true},{"text":"Kasi ntangu yayi, mu ke vuukisa beno","poem":1},{"lineBreak":true},{"text":"mpe mu ke sakumuna beno, beno tala","poem":1},{"lineBreak":true},{"text":"boma ve, beno vwanda na kibakala!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yave, Nzambi ya Binwani, ke na kutuba:","poem":1},{"lineBreak":true},{"text":"«Mu bakaka lukanu ya kupesa beno","poem":1},{"lineBreak":true},{"text":"kitumbu samu ti bankooko","poem":1},{"lineBreak":true},{"text":"ya beno pesaka munu nkele,","poem":1},{"lineBreak":true},{"text":"mpe mu sobaka ve lukanu ya munu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kasi, na ntangu yayi mu me soba lukanu ya munu,","poem":1},{"lineBreak":true},{"text":"mu me baka lukanu ya kusala beno mambu ya mbote.","poem":1},{"lineBreak":true},{"text":"Dikanda ya Yuda mpe ya Yelusalemi,","poem":1},{"lineBreak":true},{"text":"beno tala boma ve.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Beno ke sala mutindu yayi:","poem":1},{"lineBreak":true},{"text":"Beno sadila butsyelika na kati ya beno,","poem":1},{"lineBreak":true},{"text":"na bisika yina beno ke fundisaka bantu,","poem":1},{"lineBreak":true},{"text":"beno sala lufundusu ya kudedama,","poem":1},{"lineBreak":true},{"text":"yina ke pesaka kizunu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Beno ke vwanda ve na dibanza","poem":1},{"lineBreak":true},{"text":"ya kusala yimbi na bampangi ya beno,","poem":1},{"lineBreak":true},{"text":"beno ke kudya ve bandefi ya luvunu,","poem":1},{"lineBreak":true},{"text":"samu ti mambu nyonso yayi,","poem":1},{"lineBreak":true},{"text":"mu ke yinaka yawu.","poem":1},{"lineBreak":true},{"text":"Ni Yave me tuba yawu.»","poem":1}]},{"type":"heading","content":["Bilumbu ya kyadi ke kituka bilumbu ya kyese"]},{"type":"verse","number":18,"content":["Mambu ya Yave, Nzambi ya Binwani, kuminaka munu mutindu yayi:"]},{"type":"verse","number":19,"content":["«Yave, Nzambi ya Binwani, ke na kutuba: Kumina nsoki ya ngonda ya yiya, ya ngonda ya tanu, ya ngonda ya nsambwadi mpe na ngonda ya kumi, yawu ke kituka bilumbu ya kyese, ya kilengi mpe ya mikembo samu na bantu ya Yuda.» «Beno zola butsyelika mpe kizunu!»"]},{"type":"verse","number":20,"content":["Yave, Nzambi ya Binwani, ke na kutuba:",{"text":"«Bantu mingi ke kwiza awa","poem":1},{"lineBreak":true},{"text":"mpe bambanza mingi ke butuka.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Na yina, bantu ya mbanza","poem":1},{"lineBreak":true},{"text":"mosi ke tuba na bantu ya mbanza","poem":1},{"lineBreak":true},{"text":"ya nkaka ti: “Beto kwenda","poem":1},{"lineBreak":true},{"text":"sambila mpe kusosa","poem":1},{"lineBreak":true},{"text":"kizizi ya Yave, Nzambi ya Binwani”,","poem":1},{"lineBreak":true},{"text":"bantu ya nkaka ke vutula:","poem":1},{"lineBreak":true},{"text":"“Ee, beto ke kwenda kintwadi na beno.”","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ya tsyelika, bantu mingi","poem":1},{"lineBreak":true},{"text":"mpe bantu ya bayinsi yina ke na lulendo,","poem":1},{"lineBreak":true},{"text":"ke kwiza awa na Yelusalemi,","poem":1},{"lineBreak":true},{"text":"samu na kusosa mpe samu na kubondila,","poem":1},{"lineBreak":true},{"text":"Yave, Nzambi ya Binwani.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Yave, Nzambi ya Binwani,","poem":1},{"lineBreak":true},{"text":"ke na kutuba, na bilumbu yina,","poem":1},{"lineBreak":true},{"text":"bantu kumi bayina ke zonzaka ve","poem":1},{"lineBreak":true},{"text":"ndinga mosi, ke simba Zwife mosi","poem":1},{"lineBreak":true},{"text":"na nsongi ya kinkuti ya yandi","poem":1},{"lineBreak":true},{"text":"mpe bawu ke tuba:","poem":1},{"lineBreak":true},{"text":"“Beto ke kwenda kintwadi na beno","poem":1},{"lineBreak":true},{"text":"samu ti beto kuwaka ti","poem":1},{"lineBreak":true},{"text":"Nzambi kele na beno.” »","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mkw_wbt/ZEC/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mkw_wbt/ZEC/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mkw_wbt/ZEC/7.json","previousChapterAudioLinks":{},"numberOfVerses":23}