{"translation":{"id":"mna_png","name":"Anutu Sua Kini Potomaxana","website":"https://ebible.org/Scriptures/details.php?id=mna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mna","licenseNotes":null,"shortName":"PNG","englishName":"Mbula Bible","language":"mna","textDirection":"ltr","sha256":"281d81352a1ed91b722e7b7d70660e3e2f8e439790183a14d2fe70e88a146633","availableFormats":["json"],"listOfBooksApiLink":"/api/mna_png/books.json","numberOfBooks":33,"totalNumberOfChapters":529,"totalNumberOfVerses":13204,"languageName":"Mbula","languageEnglishName":"Mbula"},"book":{"id":"PSA","translationId":"mna_png","name":"Mboe","commonName":"Mboe","title":"Mboe","order":19,"numberOfChapters":150,"sha256":"1881f96f8a9b47c9899f02a6628a728b2c26ffcf75b7e60b1bd75d7e84744e00","firstChapterNumber":1,"firstChapterApiLink":"/api/mna_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mna_png/PSA/150.json","totalNumberOfVerses":2406},"chapter":{"number":100,"content":[{"type":"heading","content":["Tembeeze pa Merere raama lelende ambai"]},{"type":"hebrew_subtitle","content":["Mboe tabe tapakur Anutu pa i"]},{"type":"verse","number":1,"content":[{"text":"Niom karkari ta karao pa toono ma ila na, kalŋoyom isala mi menmeen yom pa Yooba!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kembeeze pini raama leleyom ambai.","poem":1},{"lineBreak":true},{"text":"Kamar kereene uunu, mi kombo mboe raama menmeen yom.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mi kuute kat ta kembei: Yooba, ni ta Anutu ŋonoono.","poem":1},{"lineBreak":true},{"text":"Ni iur iti, mi ikam ti ma tewe lene kek.","poem":1},{"lineBreak":true},{"text":"Iti sipsip kini tau. Tana ni mataana piti mi imborro iti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kapaŋuru urum kini kwoono mi leleyom ambai pini.","poem":1},{"lineBreak":true},{"text":"Kombo mboe pini mi kapakuri.","poem":1},{"lineBreak":true},{"text":"Leleyom ambai pini mi kiwit uruunu pa kampeŋana kini.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pa Yooba, ni ambaiŋana.","poem":1},{"lineBreak":true},{"text":"Ni ko iurur leleene pa wal kini mi imuŋaiŋai zin ma alok.","poem":1},{"lineBreak":true},{"text":"Mi mataana iŋgalŋgal sua kini mbukŋana, mi iseeŋge iseeŋge ma ila.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mna_png/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mna_png/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mna_png/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}