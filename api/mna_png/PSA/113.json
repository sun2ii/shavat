{"translation":{"id":"mna_png","name":"Anutu Sua Kini Potomaxana","website":"https://ebible.org/Scriptures/details.php?id=mna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mna","licenseNotes":null,"shortName":"PNG","englishName":"Mbula Bible","language":"mna","textDirection":"ltr","sha256":"281d81352a1ed91b722e7b7d70660e3e2f8e439790183a14d2fe70e88a146633","availableFormats":["json"],"listOfBooksApiLink":"/api/mna_png/books.json","numberOfBooks":33,"totalNumberOfChapters":529,"totalNumberOfVerses":13204,"languageName":"Mbula","languageEnglishName":"Mbula"},"book":{"id":"PSA","translationId":"mna_png","name":"Mboe","commonName":"Mboe","title":"Mboe","order":19,"numberOfChapters":150,"sha256":"1881f96f8a9b47c9899f02a6628a728b2c26ffcf75b7e60b1bd75d7e84744e00","firstChapterNumber":1,"firstChapterApiLink":"/api/mna_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mna_png/PSA/150.json","totalNumberOfVerses":2406},"chapter":{"number":113,"content":[{"type":"heading","content":["Yooba, ni biibi ŋonoono mi muŋaiŋana katuunu"]},{"type":"verse","number":1,"content":[{"text":"Haleluya!","poem":1},{"lineBreak":true},{"text":"Niom mbesooŋo ki Yooba, kapakuri.","poem":1},{"lineBreak":true},{"text":"Kapakur zaana ma isala kor!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kapakurkur Yooba zaana pa kampeŋana kini","poem":1},{"lineBreak":true},{"text":"ta buri, mi iseeŋge iseeŋge ma ila!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Niom ta zoŋ uunu koyom, mi ila irao lele ta zoŋ izulla pa i,","poem":1},{"lineBreak":true},{"text":"kapakur Yooba zaana!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yooba, ni imbotmbot sala kor kat. Ni ilip pa tomtom ta boozomen ki toono ti.","poem":1},{"lineBreak":true},{"text":"Mi zaana biibi mi mburaana ilip pa koroŋ ta boozomen ki saamba.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Asiŋ ta ni irao pa Anutu tiam Yooba? Som. Ni kadoono sa som.","poem":1},{"lineBreak":true},{"text":"Ni imbotmbot se muriini peeze kana ta imbot sala kor kat.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tana sombe leleene be ire koroŋ sa ki saamba, som toono,","poem":1},{"lineBreak":true},{"text":"na bela ituundu mi mataana isu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tamen zin sorrokŋan ŋonoono ta timbot ŋoobo kat mi tilala musmuuzu muriini be tiru kan kini na, ni mataana mbeleele zin som.","poem":1},{"lineBreak":true},{"text":"Ni iuluulu zin ma timbot ambai mini, mi ipakurkur zin.","poem":1},{"lineBreak":true},{"text":"Tana zin tirao be tigaaba zin wal zanŋan ta tikamam peeze pa wal kini na, ma ziŋan timbotmbot.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mi zin moori ta kopon somŋan i, na ni iuluulu zin mi iurur len zaala be tikam len pikin boozo.","poem":1},{"lineBreak":true},{"text":"Tana timbotmbot raama lutun bizin ma lelen ambai kat.","poem":1},{"lineBreak":true},{"text":"Haleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mna_png/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mna_png/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mna_png/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":8}