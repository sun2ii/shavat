{"translation":{"id":"mna_png","name":"Anutu Sua Kini Potomaxana","website":"https://ebible.org/Scriptures/details.php?id=mna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mna","licenseNotes":null,"shortName":"PNG","englishName":"Mbula Bible","language":"mna","textDirection":"ltr","sha256":"281d81352a1ed91b722e7b7d70660e3e2f8e439790183a14d2fe70e88a146633","availableFormats":["json"],"listOfBooksApiLink":"/api/mna_png/books.json","numberOfBooks":33,"totalNumberOfChapters":529,"totalNumberOfVerses":13204,"languageName":"Mbula","languageEnglishName":"Mbula"},"book":{"id":"PSA","translationId":"mna_png","name":"Mboe","commonName":"Mboe","title":"Mboe","order":19,"numberOfChapters":150,"sha256":"1881f96f8a9b47c9899f02a6628a728b2c26ffcf75b7e60b1bd75d7e84744e00","firstChapterNumber":1,"firstChapterApiLink":"/api/mna_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mna_png/PSA/150.json","totalNumberOfVerses":2406},"chapter":{"number":114,"content":[{"type":"heading","content":["Zin Israel matan iŋgal mazwaana ta tizem Aikuptu"]},{"type":"verse","number":1,"content":[{"text":"Muŋgu zin Israel ta Yakop popoŋana kini na, tizem Aikuptu.","poem":1},{"lineBreak":true},{"text":"Tizem zin wal ta tizzo kalŋan toro.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Indeeŋe tana, zin Yuda tiwe wal potomŋan ki Yooba.","poem":1},{"lineBreak":true},{"text":"Zin Israel tiwe Yooba lene, mi ni ikamam peeze pizin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Indeeŋe Tai Siŋsiŋŋana ire i na, iko ma ila lene.","poem":1},{"lineBreak":true},{"text":"Mi yok Yordan ire i na, imiili ma ila, mi ipot ma imbotmbot.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Zin abal tiseŋeeŋe mi tilulu zin kembei ta mekmek.","poem":1},{"lineBreak":true},{"text":"Mi lele mbukunbukun timorsop, mi tilulu zin kembei ta sipsip popoŋan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"O tai, nu tina ko pa so uunu i?","poem":1},{"lineBreak":true},{"text":"Mi yok Yordan, parei ta nu miili ma la mi pot?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mi niom abalabal mi lele mbukunbukun na,","poem":1},{"lineBreak":true},{"text":"keseŋeeŋe mi kululu yom paso?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"O toono, re u kek? Pa molo som, to Yooba imar.","poem":1},{"lineBreak":true},{"text":"Iŋgi be Anutu ki Yakop iswe kat mburaana.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ni ta ikam ma yok ipet pa pat mi irereere ma biibi.","poem":1},{"lineBreak":true},{"text":"Mi ikam ma yok ipet pa raŋ, mi irereere ma isu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mna_png/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mna_png/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mna_png/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}