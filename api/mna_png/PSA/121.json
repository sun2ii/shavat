{"translation":{"id":"mna_png","name":"Anutu Sua Kini Potomaxana","website":"https://ebible.org/Scriptures/details.php?id=mna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mna","licenseNotes":null,"shortName":"PNG","englishName":"Mbula Bible","language":"mna","textDirection":"ltr","sha256":"281d81352a1ed91b722e7b7d70660e3e2f8e439790183a14d2fe70e88a146633","availableFormats":["json"],"listOfBooksApiLink":"/api/mna_png/books.json","numberOfBooks":33,"totalNumberOfChapters":529,"totalNumberOfVerses":13204,"languageName":"Mbula","languageEnglishName":"Mbula"},"book":{"id":"PSA","translationId":"mna_png","name":"Mboe","commonName":"Mboe","title":"Mboe","order":19,"numberOfChapters":150,"sha256":"1881f96f8a9b47c9899f02a6628a728b2c26ffcf75b7e60b1bd75d7e84744e00","firstChapterNumber":1,"firstChapterApiLink":"/api/mna_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mna_png/PSA/150.json","totalNumberOfVerses":2406},"chapter":{"number":121,"content":[{"type":"heading","content":["Merere imbotmbot raama iti mi mataana piti"]},{"type":"hebrew_subtitle","content":["Mboe kizin wal ta tizalla pa Yerusalem"]},{"type":"verse","number":1,"content":[{"text":"Nio motoŋ izalla pa zin abal.","poem":1},{"lineBreak":true},{"text":"Ko leŋ ulaaŋa sa imar be parei?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ulaaŋa tio na Yooba itutamen tau.","poem":1},{"lineBreak":true},{"text":"Ni ta iur saamba mi toono.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ni ko irao izemu ma tutkat kumbum mi mel na som.","poem":1},{"lineBreak":true},{"text":"Pa mboroŋan ku, ni mata ŋenŋeene somŋana.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ŋonoono kat, mboroŋan kiti Israel, mata ŋenŋeene somŋana,","poem":1},{"lineBreak":true},{"text":"mi ikenne som.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yooba, ni mataana pu mi imborro u.","poem":1},{"lineBreak":true},{"text":"Mi imbotmbot zilŋom uunu totomen mi iwe ur pu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tana zoŋ mataana ko ilasu pa aigule na som.","poem":1},{"lineBreak":true},{"text":"Mi mbeŋ na, puulu ko irao be ipasaanu na som.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yooba ko mataana pu mi iporoukalkaalu pa koroŋ sananŋan ta munŋaana men.","poem":1},{"lineBreak":true},{"text":"Ni ko imboro u ma mbot ambai men.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ni ko mataana pu pa pai ku ta boozomen. Tana nu sombe le ma mar, som pet ma la, na ni ko imbotmbot raamu mi mataana pu,","poem":1},{"lineBreak":true},{"text":"ta buri mi iseeŋge iseeŋge ma ila.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mna_png/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mna_png/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mna_png/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}