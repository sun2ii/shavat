{"translation":{"id":"mna_png","name":"Anutu Sua Kini Potomaxana","website":"https://ebible.org/Scriptures/details.php?id=mna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mna","licenseNotes":null,"shortName":"PNG","englishName":"Mbula Bible","language":"mna","textDirection":"ltr","sha256":"281d81352a1ed91b722e7b7d70660e3e2f8e439790183a14d2fe70e88a146633","availableFormats":["json"],"listOfBooksApiLink":"/api/mna_png/books.json","numberOfBooks":33,"totalNumberOfChapters":529,"totalNumberOfVerses":13204,"languageName":"Mbula","languageEnglishName":"Mbula"},"book":{"id":"PSA","translationId":"mna_png","name":"Mboe","commonName":"Mboe","title":"Mboe","order":19,"numberOfChapters":150,"sha256":"1881f96f8a9b47c9899f02a6628a728b2c26ffcf75b7e60b1bd75d7e84744e00","firstChapterNumber":1,"firstChapterApiLink":"/api/mna_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mna_png/PSA/150.json","totalNumberOfVerses":2406},"chapter":{"number":123,"content":[{"type":"heading","content":["Merere mbesooŋo kini tipase pa muŋaiŋana kini"]},{"type":"hebrew_subtitle","content":["Mboe kizin wal ta tizalla pa Yerusalem"]},{"type":"verse","number":1,"content":[{"text":"O Yooba, nu mbotmbot se murim peeze kana ta saamba a.","poem":1},{"lineBreak":true},{"text":"Tana aŋurur motoŋ pu mi aŋpase pu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yooba, Anutu tiam, niam ko amrre ma pu ma irao nu muŋai yam mi uulu yam. Pa nu ta biibi tiam.","poem":1},{"lineBreak":true},{"text":"Tana ampase pu pa koroŋ ta boozomen,","poem":1},{"lineBreak":true},{"text":"kembei ta zin mbesooŋo tomooto ma moori tipase pa zin bibip kizin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O Yooba, lelem isaana piam, mi muŋai yam mi uulu yam. Pa niam mbesooŋo ku tau.","poem":1},{"lineBreak":true},{"text":"Re. Iŋgi zin wal ta timoto u som, mi tipase pa zitun ma tiso zin tirao pa koroŋ ta boozomen, ta timbel repiiliŋoyam kek.","poem":1},{"lineBreak":true},{"text":"Zin tana matan pasom yam mi tirepilpiili yam ndabok!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mna_png/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mna_png/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mna_png/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":3}