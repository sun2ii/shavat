{"translation":{"id":"mna_png","name":"Anutu Sua Kini Potomaxana","website":"https://ebible.org/Scriptures/details.php?id=mna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mna","licenseNotes":null,"shortName":"PNG","englishName":"Mbula Bible","language":"mna","textDirection":"ltr","sha256":"281d81352a1ed91b722e7b7d70660e3e2f8e439790183a14d2fe70e88a146633","availableFormats":["json"],"listOfBooksApiLink":"/api/mna_png/books.json","numberOfBooks":33,"totalNumberOfChapters":529,"totalNumberOfVerses":13204,"languageName":"Mbula","languageEnglishName":"Mbula"},"book":{"id":"PSA","translationId":"mna_png","name":"Mboe","commonName":"Mboe","title":"Mboe","order":19,"numberOfChapters":150,"sha256":"1881f96f8a9b47c9899f02a6628a728b2c26ffcf75b7e60b1bd75d7e84744e00","firstChapterNumber":1,"firstChapterApiLink":"/api/mna_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mna_png/PSA/150.json","totalNumberOfVerses":2406},"chapter":{"number":124,"content":[{"type":"heading","content":["Merere, ni iporoukaala wal kini pa kan koi bizin"]},{"type":"hebrew_subtitle","content":["Mboe kizin wal ta tizalla pa Yerusalem Mboe ki Dabit"]},{"type":"verse","number":1,"content":[{"text":"“Sombe Yooba ilae kiti som, mi iuulu iti som, nako parei piti?”","poem":1},{"lineBreak":true},{"text":"Niom iwal biibi ki Israel koso ta kembei:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“Indeeŋe tau kanda koi bizin timaŋga piti na,","poem":1},{"lineBreak":true},{"text":"sombe Yooba ilae kiti mi iuulu iti som,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"so kanda koi bizin tipambiriizi iti ma tamap lup.","poem":1},{"lineBreak":true},{"text":"Paso, keten malmal piam biibi kat.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pataŋana tana, ina kembei wo mburaanaŋana ta isur ti mabe tala lende.","poem":1},{"lineBreak":true},{"text":"Mi ina kembei nonor biibi ta ikamam be ilol ti. Mi som.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tana tapakur Yooba pa kampeŋana kini!","poem":1},{"lineBreak":true},{"text":"Pa ni izem ti ila kanda koi bizin naman be tipasaana iti na som.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Indeeŋe tana, iti kembei ŋge ta kilis ikami.","poem":1},{"lineBreak":true},{"text":"Tamen Yooba iputke wooro tana piti,","poem":1},{"lineBreak":true},{"text":"mi matanda yaryaara mi toko ma tala lende.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ulaaŋa kiti na, Yooba itutamen tau.","poem":1},{"lineBreak":true},{"text":"Ni ta iur saamba mi toono.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mna_png/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mna_png/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mna_png/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":7}