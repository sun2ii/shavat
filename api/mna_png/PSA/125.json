{"translation":{"id":"mna_png","name":"Anutu Sua Kini Potomaxana","website":"https://ebible.org/Scriptures/details.php?id=mna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mna","licenseNotes":null,"shortName":"PNG","englishName":"Mbula Bible","language":"mna","textDirection":"ltr","sha256":"281d81352a1ed91b722e7b7d70660e3e2f8e439790183a14d2fe70e88a146633","availableFormats":["json"],"listOfBooksApiLink":"/api/mna_png/books.json","numberOfBooks":33,"totalNumberOfChapters":529,"totalNumberOfVerses":13204,"languageName":"Mbula","languageEnglishName":"Mbula"},"book":{"id":"PSA","translationId":"mna_png","name":"Mboe","commonName":"Mboe","title":"Mboe","order":19,"numberOfChapters":150,"sha256":"1881f96f8a9b47c9899f02a6628a728b2c26ffcf75b7e60b1bd75d7e84744e00","firstChapterNumber":1,"firstChapterApiLink":"/api/mna_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mna_png/PSA/150.json","totalNumberOfVerses":2406},"chapter":{"number":125,"content":[{"type":"heading","content":["Merere ni imenderkalkaala wal kini"]},{"type":"hebrew_subtitle","content":["Mboe kizin wal ta tizalla pa Yerusalem"]},{"type":"verse","number":1,"content":[{"text":"Zin wal ta tipase pa Yooba na, zin kembei ta abal Sion.","poem":1},{"lineBreak":true},{"text":"Pa abal tana irao imuzik na som. Tuŋ ma imbotmbot ma alok.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yerusalem na, abal boozomen iliu i.","poem":1},{"lineBreak":true},{"text":"Mi ina raraate men pa Yooba wal kini. Ni iwe kembei siiri mbolŋana ta iliu zin.","poem":1},{"lineBreak":true},{"text":"Mi imenderkalkaala zin ta buri, mi iseeŋge iseeŋge ma ila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tana toono ta Anutu ikam pa wal kini ndeeŋeŋan na, zin wal sananŋan ko tikam peeze pa ma alok na som.","poem":1},{"lineBreak":true},{"text":"Kokena tikam ma zin wal ndeeŋeŋan tomini tisemboron zitun pa mbulu sananŋana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"O Yooba, kampe zin wal ku ambaimbaiŋan ta lelen ŋgeezeŋan na.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tamen zin wal ta tipizil ndemen pa zaala ku, mi titoto zaala pakaamŋana na,","poem":1},{"lineBreak":true},{"text":"ziiri zin ma tila len raama zin wal sananŋan.","poem":1},{"lineBreak":true},{"text":"O Yooba, mboro zin Israel ma timbot ambai men!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mna_png/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mna_png/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mna_png/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}