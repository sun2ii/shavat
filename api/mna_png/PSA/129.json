{"translation":{"id":"mna_png","name":"Anutu Sua Kini Potomaxana","website":"https://ebible.org/Scriptures/details.php?id=mna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mna","licenseNotes":null,"shortName":"PNG","englishName":"Mbula Bible","language":"mna","textDirection":"ltr","sha256":"281d81352a1ed91b722e7b7d70660e3e2f8e439790183a14d2fe70e88a146633","availableFormats":["json"],"listOfBooksApiLink":"/api/mna_png/books.json","numberOfBooks":33,"totalNumberOfChapters":529,"totalNumberOfVerses":13204,"languageName":"Mbula","languageEnglishName":"Mbula"},"book":{"id":"PSA","translationId":"mna_png","name":"Mboe","commonName":"Mboe","title":"Mboe","order":19,"numberOfChapters":150,"sha256":"1881f96f8a9b47c9899f02a6628a728b2c26ffcf75b7e60b1bd75d7e84744e00","firstChapterNumber":1,"firstChapterApiLink":"/api/mna_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mna_png/PSA/150.json","totalNumberOfVerses":2406},"chapter":{"number":129,"content":[{"type":"heading","content":["Merere ikoto zin Israel kan koi bizin"]},{"type":"hebrew_subtitle","content":["Mboe kizin wal ta tizalla pa Yerusalem"]},{"type":"verse","number":1,"content":[{"text":"“Indeeŋe ta nio naŋgaŋŋoŋ mi imar na, koŋ koi bizin timbel motoŋ seezeŋana.”","poem":1},{"lineBreak":true},{"text":"O niom iwal biibi ki Israel, koso ta kembei:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“Ŋonoono kat. Indeeŋe ta nio naŋgaŋŋoŋ mi imar na, koŋ koi bizin timbel motoŋ seezeŋana.","poem":1},{"lineBreak":true},{"text":"Tamen tirao be tilip pio na som.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tiballis yo ma tau ndemeŋ mbelŋan men.”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mi Yooba, ni ndeeŋeŋana.","poem":1},{"lineBreak":true},{"text":"Tana iuulu yo ma iyembut re ta wal sananŋan tipo yo pa na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wal boozomen ta tiurur koi pa kar Sion na,","poem":1},{"lineBreak":true},{"text":"Yooba ko ipimiili zin ma tila len raama kan miaŋ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pa zin tipiyooto koroŋ ambaiŋana sa som.","poem":1},{"lineBreak":true},{"text":"Tana zin kembei kini ambaiŋana ta tomtom tiŋgaama, mi tikam ma ila ruumu i, na som.","poem":1},{"lineBreak":true},{"text":"Zin ko tiwe kembei mbutmbuutu ta ise sorok, mi karau men mi imelle.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mi sombe tomtom pakan tipa se keren uunu,","poem":1},{"lineBreak":true},{"text":"nako irao tipombol zin pa Merere zaana","poem":1},{"lineBreak":true},{"text":"mi tiso “Yooba ko ikampe yom” na som.","poem":1},{"lineBreak":true},{"text":"Mi niom na, amsuŋ Yooba be ikampe yom mi ipombol yom.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mna_png/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mna_png/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mna_png/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":7}