{"translation":{"id":"mna_png","name":"Anutu Sua Kini Potomaxana","website":"https://ebible.org/Scriptures/details.php?id=mna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mna","licenseNotes":null,"shortName":"PNG","englishName":"Mbula Bible","language":"mna","textDirection":"ltr","sha256":"281d81352a1ed91b722e7b7d70660e3e2f8e439790183a14d2fe70e88a146633","availableFormats":["json"],"listOfBooksApiLink":"/api/mna_png/books.json","numberOfBooks":33,"totalNumberOfChapters":529,"totalNumberOfVerses":13204,"languageName":"Mbula","languageEnglishName":"Mbula"},"book":{"id":"PSA","translationId":"mna_png","name":"Mboe","commonName":"Mboe","title":"Mboe","order":19,"numberOfChapters":150,"sha256":"1881f96f8a9b47c9899f02a6628a728b2c26ffcf75b7e60b1bd75d7e84744e00","firstChapterNumber":1,"firstChapterApiLink":"/api/mna_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mna_png/PSA/150.json","totalNumberOfVerses":2406},"chapter":{"number":13,"content":[{"type":"heading","content":["Suŋŋana ki tomtom ta ibaada pataŋana ma molo"]},{"type":"hebrew_subtitle","content":["Mboe ki Dabit"]},{"type":"verse","number":1,"content":[{"text":"O Yooba, pataŋana biibi taiŋgi imbel teegeŋoŋ kek. Ŋiizi na motom iŋgal yo mini?","poem":1},{"lineBreak":true},{"text":"Ko piŋgis motom pio, mi zem yo ma aŋbotmbot ta kembei ma alok? Ŋiizi na motom imiili pio mini?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mbeŋ ma aigule na, leleŋ ipata kat mi aŋkamam ŋgar boozo.","poem":1},{"lineBreak":true},{"text":"Ŋiizi na mar uulu yo? Pa iŋgi koŋ koi ilip pio kek.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yooba Anutu tio, re yo mi ŋgun talŋom pa suŋŋana tio ti.","poem":1},{"lineBreak":true},{"text":"Pombol yo mi payaryaara motoŋ. Kokena pataŋana taiŋgi ikoto yo, som ipun yo ma aŋmeete.","poem":1},{"lineBreak":true},{"text":"To koŋ koi bizin tirepiili yo,","poem":1},{"lineBreak":true},{"text":"mi nin se ma tiso tilip pio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mi nio na, aŋpase pa mbulu ku ta toto sua ku mbukŋana mi urur lelem pa wal ku.","poem":1},{"lineBreak":true},{"text":"Tana leleŋ ambai kat. Pa nio aŋute: Nu ko kamke yo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nio ko aŋbo mboe mi aŋpakur Yooba zaana.","poem":1},{"lineBreak":true},{"text":"Paso ni ikampe yo ma biibi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mna_png/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mna_png/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mna_png/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":5}