ext":"ta buri, mi iseeŋge iseeŋge ma ila.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mna_png/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mna_png/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mna_png/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}