{"translation":{"id":"mna_png","name":"Anutu Sua Kini Potomaxana","website":"https://ebible.org/Scriptures/details.php?id=mna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mna","licenseNotes":null,"shortName":"PNG","englishName":"Mbula Bible","language":"mna","textDirection":"ltr","sha256":"281d81352a1ed91b722e7b7d70660e3e2f8e439790183a14d2fe70e88a146633","availableFormats":["json"],"listOfBooksApiLink":"/api/mna_png/books.json","numberOfBooks":33,"totalNumberOfChapters":529,"totalNumberOfVerses":13204,"languageName":"Mbula","languageEnglishName":"Mbula"},"book":{"id":"PSA","translationId":"mna_png","name":"Mboe","commonName":"Mboe","title":"Mboe","order":19,"numberOfChapters":150,"sha256":"1881f96f8a9b47c9899f02a6628a728b2c26ffcf75b7e60b1bd75d7e84744e00","firstChapterNumber":1,"firstChapterApiLink":"/api/mna_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mna_png/PSA/150.json","totalNumberOfVerses":2406},"chapter":{"number":133,"content":[{"type":"heading","content":["Taparlup lelende. Naso kampeŋana ki Anutu imbotmbot se kiti"]},{"type":"hebrew_subtitle","content":["Mboe kizin wal ta tizalla pa Yerusalem Mboe ki Dabit"]},{"type":"verse","number":1,"content":[{"text":"Sombe zin toŋmatiziŋ timbot la mbata, mi tiparlup lelen ma iwe tamen, ina ambai kat.","poem":1},{"lineBreak":true},{"text":"Tere na, ikam ti ma lelende ambai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pa ina kembei ŋgere kuziiniŋana ta tiliŋ sala Aron uteene","poem":1},{"lineBreak":true},{"text":"mi ireere ma isula pa kezeene ruunu","poem":1},{"lineBreak":true},{"text":"ma tuŋ sula kawaala kini molo kwopiriini na.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mi ina kembei ta tolou biibi ki abal Hermon isu pa zin abal ta tigarau kar Sion na.","poem":1},{"lineBreak":true},{"text":"Pa sombe taparlup ti ma tewe tamen su kar Sion, na Yooba ko iur kampeŋana kini ma isalakaala iti.","poem":1},{"lineBreak":true},{"text":"Kampeŋana tana na, mbotŋana ambaiŋana ta iseeŋge iseeŋge ma ila.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mna_png/PSA/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mna_png/PSA/134.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mna_png/PSA/132.json","previousChapterAudioLinks":{},"numberOfVerses":3}