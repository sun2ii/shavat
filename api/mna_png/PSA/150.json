xt":"Mi sombe kupun, na kupun kat bekena kalŋaana biibi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tana niom koroŋ mata yaryaaraŋoyom ta munŋaana men, kapakur Yooba!","poem":1},{"lineBreak":true},{"text":"Haleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mna_png/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mna_png/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mna_png/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}