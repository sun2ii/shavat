{"translation":{"id":"mna_png","name":"Anutu Sua Kini Potomaxana","website":"https://ebible.org/Scriptures/details.php?id=mna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mna","licenseNotes":null,"shortName":"PNG","englishName":"Mbula Bible","language":"mna","textDirection":"ltr","sha256":"281d81352a1ed91b722e7b7d70660e3e2f8e439790183a14d2fe70e88a146633","availableFormats":["json"],"listOfBooksApiLink":"/api/mna_png/books.json","numberOfBooks":33,"totalNumberOfChapters":529,"totalNumberOfVerses":13204,"languageName":"Mbula","languageEnglishName":"Mbula"},"book":{"id":"PSA","translationId":"mna_png","name":"Mboe","commonName":"Mboe","title":"Mboe","order":19,"numberOfChapters":150,"sha256":"1881f96f8a9b47c9899f02a6628a728b2c26ffcf75b7e60b1bd75d7e84744e00","firstChapterNumber":1,"firstChapterApiLink":"/api/mna_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mna_png/PSA/150.json","totalNumberOfVerses":2406},"chapter":{"number":23,"content":[{"type":"heading","content":["Merere ni mboroŋan tio ŋonoono"]},{"type":"hebrew_subtitle","content":["Mboe ki Dabit"]},{"type":"verse","number":1,"content":[{"text":"Yooba, ni mboroŋan tio ŋonoono.","poem":1},{"lineBreak":true},{"text":"Tana nio ko aŋbot ŋoobo pa koroŋ sa som.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pa ni itunu ko iyaaru yo ma aŋla lele ta ambaiŋana kat be keteŋ su mi aŋbotmbot pa.","poem":1},{"lineBreak":true},{"text":"Lele tina na, ka kiniŋana ma yokŋana, mi narenren ambaiŋana.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ni ipombolmbol yo ma mburoŋ imilmiili.","poem":1},{"lineBreak":true},{"text":"Mi izzo yo pa zaala kini ndabokŋana.","poem":1},{"lineBreak":true},{"text":"Pa ina, mbulu kini ta kembena.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yooba, sombe pataŋana sananŋana ikam yo mabe aŋmeete, som zugut biibi izukkaala yo,","poem":1},{"lineBreak":true},{"text":"nako irao aŋmoto na som.","poem":1},{"lineBreak":true},{"text":"Pa nu mbotmbot raama yo.","poem":1},{"lineBreak":true},{"text":"Mi nu ko poroukaala yo mi pazal yo.","poem":1},{"lineBreak":true},{"text":"Tana aŋmoto kosa sa som, mi leleŋ ambai men.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nu pomoozo yo kat.","poem":1},{"lineBreak":true},{"text":"Pa ŋgun mbalia, mi kam koŋ kini biibi ila koŋ koi bizin matan.","poem":1},{"lineBreak":true},{"text":"Mi nu kam yo ma aŋwe leembe ku, mi liŋ ŋgere isala uteŋ, mi kam koŋ yok ambaiŋana be aŋwin.","poem":1},{"lineBreak":true},{"text":"Tabe kam ma leleŋ ambai kat.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ŋonoono kat, Yooba, nu toto sua ku mbukŋana mi urur lelem pio.","poem":1},{"lineBreak":true},{"text":"Kampeŋana mi muŋaiŋana ku ko imarmar pio ma irao aŋzem toono ti.","poem":1},{"lineBreak":true},{"text":"Mi nio ko aŋbotmbot raamu lela itum murim,","poem":1},{"lineBreak":true},{"text":"mi iseeŋge iseeŋge ma ila.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mna_png/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mna_png/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mna_png/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}