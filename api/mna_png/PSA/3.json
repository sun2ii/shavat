{"translation":{"id":"mna_png","name":"Anutu Sua Kini Potomaxana","website":"https://ebible.org/Scriptures/details.php?id=mna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mna","licenseNotes":null,"shortName":"PNG","englishName":"Mbula Bible","language":"mna","textDirection":"ltr","sha256":"281d81352a1ed91b722e7b7d70660e3e2f8e439790183a14d2fe70e88a146633","availableFormats":["json"],"listOfBooksApiLink":"/api/mna_png/books.json","numberOfBooks":33,"totalNumberOfChapters":529,"totalNumberOfVerses":13204,"languageName":"Mbula","languageEnglishName":"Mbula"},"book":{"id":"PSA","translationId":"mna_png","name":"Mboe","commonName":"Mboe","title":"Mboe","order":19,"numberOfChapters":150,"sha256":"1881f96f8a9b47c9899f02a6628a728b2c26ffcf75b7e60b1bd75d7e84744e00","firstChapterNumber":1,"firstChapterApiLink":"/api/mna_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mna_png/PSA/150.json","totalNumberOfVerses":2406},"chapter":{"number":3,"content":[{"type":"heading","content":["Suŋŋana berek kana be Merere iporoukaala iti"]},{"type":"hebrew_subtitle","content":["Mboe ki Dabit Indeeŋe Dabit iko pa lutuunu Absalom na, itooro mboe ti"]},{"type":"verse","number":1,"content":[{"text":"O Yooba, koŋ koi bizin na, munŋaana ma munŋaana men.","poem":1},{"lineBreak":true},{"text":"Tomtom iwal kat, ta timaŋga be tizooro yo","poem":1},{"lineBreak":true},{"text":"mi tikam malmal pio.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wal boozomen tizzo pio ta kembei:","poem":1},{"lineBreak":true},{"text":"“Kere. Anutu ko irao iuuli na som.","poem":1},{"lineBreak":true},{"text":"Pa ipizil ndemeene pini kek.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tamen Yooba, nu we siŋgiao pio mi poroukalkaala yo.","poem":1},{"lineBreak":true},{"text":"Nu ta kam yo ma zoŋ iwe biibi. Koroŋ toro sa som.","poem":1},{"lineBreak":true},{"text":"Mi nu ko pombol yo ma niŋ ise.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nio aŋboobo Yooba be iuulu yo.","poem":1},{"lineBreak":true},{"text":"Mi ni imbot sala abal kini potomŋana, mi ileŋ suŋŋana tio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tana nio aŋsu muriŋ na, Yooba mataana pio","poem":1},{"lineBreak":true},{"text":"mi aŋkam kene tio ambai men mi aŋmaŋga mini.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mi koŋ koi bizin munŋaana ka tieene ta timar tiliu yo na,","poem":1},{"lineBreak":true},{"text":"aŋmoto zin som.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yooba, maŋga mi swe mburom!","poem":1},{"lineBreak":true},{"text":"Anutu tio, kamke yo pa zin wal sananŋan.","poem":1},{"lineBreak":true},{"text":"Peeze koŋ koi bizin kwon ma zoŋon ipolpol.","poem":1},{"lineBreak":true},{"text":"Pun zin ma mburan imap kat.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yooba, ni ulaaŋa ŋonoono.","poem":1},{"lineBreak":true},{"text":"Ni ko ikampe wal kini mi ipombol zin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mna_png/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mna_png/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mna_png/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}