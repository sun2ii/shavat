{"translation":{"id":"mna_png","name":"Anutu Sua Kini Potomaxana","website":"https://ebible.org/Scriptures/details.php?id=mna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mna","licenseNotes":null,"shortName":"PNG","englishName":"Mbula Bible","language":"mna","textDirection":"ltr","sha256":"281d81352a1ed91b722e7b7d70660e3e2f8e439790183a14d2fe70e88a146633","availableFormats":["json"],"listOfBooksApiLink":"/api/mna_png/books.json","numberOfBooks":33,"totalNumberOfChapters":529,"totalNumberOfVerses":13204,"languageName":"Mbula","languageEnglishName":"Mbula"},"book":{"id":"PSA","translationId":"mna_png","name":"Mboe","commonName":"Mboe","title":"Mboe","order":19,"numberOfChapters":150,"sha256":"1881f96f8a9b47c9899f02a6628a728b2c26ffcf75b7e60b1bd75d7e84744e00","firstChapterNumber":1,"firstChapterApiLink":"/api/mna_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mna_png/PSA/150.json","totalNumberOfVerses":2406},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Anutu, zin wal tau titoto zaala ku som, ta tiseseeze motoŋ.","poem":1},{"lineBreak":true},{"text":"Tana mender pio mi so zin ta kembei: Nio leŋ uunu sa isaana som.","poem":1},{"lineBreak":true},{"text":"Tatke yo pa zin wal pakamkaamŋan mi wal sananŋan naman.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pa nu ta Anutu tio. Tana aŋpase pu be we siiri mbolŋana pio.","poem":1},{"lineBreak":true},{"text":"Parei ta pizil ndemem pio?","poem":1},{"lineBreak":true},{"text":"Mi parei ta gedgeede koŋ koi bizin, mi tikototo yo ma tikamam pataŋana pio?","poem":1},{"lineBreak":true},{"text":"Re. Iŋgi aŋbotmbot raama leleŋ ipata kat.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ur mat pio mi so yo pa sua ku ŋonoono.","poem":1},{"lineBreak":true},{"text":"Naso kam peeze pio,","poem":1},{"lineBreak":true},{"text":"mi pazal yo be aŋmiili ma aŋsala mini pa abal ku potomŋana Sion.","poem":1},{"lineBreak":true},{"text":"Pa ina nu murim kat ta tina.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Anutu, nio leleŋ be aŋkoŋuru artaal ku mi aŋmender la kerem uunu.","poem":1},{"lineBreak":true},{"text":"Pa nu potortor leleŋ, mi kamam ma leleŋ ambai kat.","poem":1},{"lineBreak":true},{"text":"Mi nio ko aŋse kombom, mi aŋbo mboe be aŋpakuru.","poem":1},{"lineBreak":true},{"text":"Pa nu ta Anutu tio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mi parei ta iŋgi leleŋ isaana mini ma kembei?","poem":1},{"lineBreak":true},{"text":"Parei ta leleŋ ipata?","poem":1},{"lineBreak":true},{"text":"Nio aŋbotmbot ta kembei, na ambai som.","poem":1},{"lineBreak":true},{"text":"Tana ko aŋur motoŋ pa Anutu mi aŋpase pini,","poem":1},{"lineBreak":true},{"text":"mi aŋpakuri mini.","poem":1},{"lineBreak":true},{"text":"Pa ni Merere tio mi ulaaŋa tio.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mna_png/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mna_png/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mna_png/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}