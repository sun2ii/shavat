{"translation":{"id":"mna_png","name":"Anutu Sua Kini Potomaxana","website":"https://ebible.org/Scriptures/details.php?id=mna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mna","licenseNotes":null,"shortName":"PNG","englishName":"Mbula Bible","language":"mna","textDirection":"ltr","sha256":"281d81352a1ed91b722e7b7d70660e3e2f8e439790183a14d2fe70e88a146633","availableFormats":["json"],"listOfBooksApiLink":"/api/mna_png/books.json","numberOfBooks":33,"totalNumberOfChapters":529,"totalNumberOfVerses":13204,"languageName":"Mbula","languageEnglishName":"Mbula"},"book":{"id":"PSA","translationId":"mna_png","name":"Mboe","commonName":"Mboe","title":"Mboe","order":19,"numberOfChapters":150,"sha256":"1881f96f8a9b47c9899f02a6628a728b2c26ffcf75b7e60b1bd75d7e84744e00","firstChapterNumber":1,"firstChapterApiLink":"/api/mna_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mna_png/PSA/150.json","totalNumberOfVerses":2406},"chapter":{"number":67,"content":[{"type":"heading","content":["Tusuŋ Anutu be ikampe iti"]},{"type":"verse","number":1,"content":[{"text":"Anutu ko imuŋai iti mi ikampe iti.","poem":1},{"lineBreak":true},{"text":"Ni ko iswe itunu ramaki kampeŋana kini piti, mi ikam mat kini ma iyaara piti.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Naso tomtom ta tirao toono ta boozomen na, tikilaala mbulu kini,","poem":1},{"lineBreak":true},{"text":"mi zin karkari ta boozomen tiute ulaaŋa kini.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Anutu, zin karkari ko tiwe kwom mi tipakuru.","poem":1},{"lineBreak":true},{"text":"Tomtom ta munŋaana men ko tiwit urum.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Zin karkari ko menmeen zin mi timbo mboe pu.","poem":1},{"lineBreak":true},{"text":"Pa nu kamam mbulu ndeeŋeŋana men, mi urpewe pataŋana kizin tomtom.","poem":1},{"lineBreak":true},{"text":"Mi nu ta kamam peeze pizin tomtom ta timbotmbot su toono i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Anutu, zin karkari ko tiwe kwom mi tipakuru.","poem":1},{"lineBreak":true},{"text":"Tomtom ta munŋaana men ko tiwit urum.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Anutu kiti, ni ikampe iti, tana toono ipiyooto mai ambaiŋana.","poem":1},{"lineBreak":true},{"text":"Mi kampeŋana kini ko imbotmbot men se kiti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Anutu ko ikampe iti.","poem":1},{"lineBreak":true},{"text":"Mi tomtom ta tirao pa toono ta boozomen ko timototo i mi tileŋleŋ la kalŋaana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mna_png/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mna_png/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mna_png/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}