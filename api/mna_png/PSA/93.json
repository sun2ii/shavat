{"translation":{"id":"mna_png","name":"Anutu Sua Kini Potomaxana","website":"https://ebible.org/Scriptures/details.php?id=mna","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mna","licenseNotes":null,"shortName":"PNG","englishName":"Mbula Bible","language":"mna","textDirection":"ltr","sha256":"281d81352a1ed91b722e7b7d70660e3e2f8e439790183a14d2fe70e88a146633","availableFormats":["json"],"listOfBooksApiLink":"/api/mna_png/books.json","numberOfBooks":33,"totalNumberOfChapters":529,"totalNumberOfVerses":13204,"languageName":"Mbula","languageEnglishName":"Mbula"},"book":{"id":"PSA","translationId":"mna_png","name":"Mboe","commonName":"Mboe","title":"Mboe","order":19,"numberOfChapters":150,"sha256":"1881f96f8a9b47c9899f02a6628a728b2c26ffcf75b7e60b1bd75d7e84744e00","firstChapterNumber":1,"firstChapterApiLink":"/api/mna_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mna_png/PSA/150.json","totalNumberOfVerses":2406},"chapter":{"number":93,"content":[{"type":"heading","content":["Anutu peeze kini ko imbol ma imbotmbot"]},{"type":"verse","number":1,"content":[{"text":"Yooba, ni king biibi ŋonoono ta ikamam peeze pa koroŋ ta boozomen.","poem":1},{"lineBreak":true},{"text":"Zaana biibi mi mburaana, ina iwe kembei mburu ta ni irru pa be ikam malmal.","poem":1},{"lineBreak":true},{"text":"Muŋgu kat, ni iur toono ma uunu imbol kat. Tana kosa sa ko irao ikam ma imuzik na som.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"O Yooba, muŋgu kat, indeeŋe ta ur kosa sa zen na, nu mbotmbot.","poem":1},{"lineBreak":true},{"text":"Mi peeze ku ta kembena. Ta muŋgu mi imar na, imbol ma imbotmbot.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yooba, tai imaŋga raama mburaana biibi,","poem":1},{"lineBreak":true},{"text":"mi kalŋaana izalla kembei lele ikuruŋ.","poem":1},{"lineBreak":true},{"text":"Duubu ipol mi kalŋaana biibi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tamen Yooba, nu mburom keskeezeŋom.","poem":1},{"lineBreak":true},{"text":"Nu mbotmbot ta kor a, mi kamam peeze pa koroŋ ta boozomen.","poem":1},{"lineBreak":true},{"text":"Mburom ilip kat pa tai ma duubu mburan.","poem":1},{"lineBreak":true},{"text":"Mi nonor ma wo tomini, nu lip pizin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"O Yooba, tutu ta ur pa wal ku, ina imbol ma imbotmbot.","poem":1},{"lineBreak":true},{"text":"Mi mbulu ku potomŋana mi mbulu potomŋana ki wal ku ko ipeŋgeeze urum ku ma alok.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mna_png/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mna_png/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mna_png/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}