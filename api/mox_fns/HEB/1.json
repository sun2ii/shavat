{"translation":{"id":"mox_fns","name":"Molima New Testament","website":"https://ebible.org/Scriptures/details.php?id=mox","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mox","licenseNotes":null,"shortName":"FNS","englishName":"Molima NT","language":"mox","textDirection":"ltr","sha256":"694fe6ff77e1bfaa1cf8926df54d2a5d8ea6b3775287bb9130a464968d0dc9e6","availableFormats":["json"],"listOfBooksApiLink":"/api/mox_fns/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7837,"languageName":"Molima","languageEnglishName":"Molima"},"book":{"id":"HEB","translationId":"mox_fns","name":"Ibeliu","commonName":"Ibeliu","title":"Me Ibeliu edi leta","order":58,"numberOfChapters":13,"sha256":"53bd7b8c69fd180adf2cb97f08f268dbd5a79be4917230efcec3ba9f19f24473","firstChapterNumber":1,"firstChapterApiLink":"/api/mox_fns/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/mox_fns/HEB/13.json","totalNumberOfVerses":295},"chapter":{"number":1,"content":[{"type":"heading","content":["Ieisu Keliso tauna Yaubada Natuna"]},{"type":"verse","number":1,"content":["Tuta lova ʼinaya Yaubada ʼeda taha taha ʼidiega ta wese yani qabudi ʼidiega ena vona tubudavo neidi ena tovesimasimanayavo ʼidiega."]},{"type":"verse","number":2,"content":["Ta baʼitaga tuta ʼebeluʼovoa ʼinaya Natuna ʼinega simasimana ʼidaya. Lova baʼe Natuna nana ʼinega yani qabudi mahalaya be wese bwaʼobwaʼoya ʼivaʼavaʼaidi, ʼinega venuaʼivinea be ena kuyavata qabudi naʼewedi."]},{"type":"verse","number":3,"content":["Ta toyani Yaubada ʼinaya iʼenoʼeno baʼitagana wese kana ʼitea Natuna ʼinaya, mana yani qabuna aʼukamanedi ʼinaya ʼidewani ena ilivu be, ena aqiaqina be wese ena kaikaiwabu simasimatalina. Tauna wese ena vona waiwaina ʼinega kuyavata qabudi nawale ʼitaʼitamakidi ta kafikafidi. Tauna eda luveifanayavo ʼewa yavuledi ena ʼaliga ʼinega, ta ʼabibodanaya Tamana Toatoa Vanena ʼataqinaya toabui diʼwe gwalagwalana ʼinaya."]},{"type":"verse","number":4,"content":["Ta baʼe yani diavona ʼinega tauna Yaubada ena tovaleʼewayavo veqidua vaʼinedi, ta wese ʼidewana wawa nana Yaubada neia tovaleʼewayavo adi wawa veqidua vaʼinedi."]},{"type":"verse","number":5,"content":["Baʼe ʼiuna ʼinega Yaubada ena tovaleʼewayavo qabudi ʼidiega ge taha toga ʼinaya davonei,",{"text":"“Oʼa Natugu,","poem":1},{"text":"baʼitaga yavetama ʼiuya.”","poem":2},"Ta wese Yaubada ge taha toga ʼidiega davonei,",{"text":"“Yaʼa tauna tamana,","poem":1},{"text":"ta tauna yaʼa natugu.”","poem":2}]},{"type":"verse","number":6,"content":["Ta tuta nana Yaubada ena ʼunutau vetunei mai bwaʼobwaʼoya ʼinega vonaya,",{"text":"“Yaubada ena tovaleʼewayavo qabudi","poem":1},{"text":"luaqiaqiedi be ina iwaʼodu","poem":2},{"lineBreak":true},{"text":"Natuna ʼinaya.”","poem":2}]},{"type":"verse","number":7,"content":["Ta Yaubada ena tovaleʼewayavo weaqidi vonaya,",{"text":"“Taudi egu tovaleʼewayavo","poem":1},{"text":"yaviaqidi kavonaya nuba,","poem":2},{"lineBreak":true},{"text":"ta egu tofewayavo","poem":2},{"lineBreak":true},{"text":"kavonaya ʼaiwe saesaelina.”","poem":2}]},{"type":"verse","number":8,"content":["Ta Natuna weaqina vonaya,",{"text":"“Oʼa Yaubada eu luvine","poem":1},{"text":"naʼeno vataya.","poem":2},{"text":"Ta eu tomotauyavo una luvinedi","poem":1},{"text":"luvine ʼaideganega ta tunutunuqinega.","poem":2}]},{"type":"verse","number":9,"content":["Oʼa ilivu be ʼeda tunutunuqidi",{"text":"uʼawahaqiaqiedi,","poem":2},{"lineBreak":true},{"text":"ta luvine qabudi adi qeu","poem":2},{"lineBreak":true},{"text":"unoga aqiaqiea.","poem":2},{"text":"ʼInega yaʼa Yaubada","poem":1},{"text":"eu Yaubada yavenuaʼivineu","poem":2},{"lineBreak":true},{"text":"ta dedeʼwa ʼebeqaiawa","poem":2},{"lineBreak":true},{"text":"ana gihiwaqa","poem":2},{"lineBreak":true},{"text":"ʼinega yagiveqaiaweu qiduana,","poem":2},{"lineBreak":true},{"text":"ta ʼabiboda emwavo.”","poem":2}]},{"type":"verse","number":10,"content":["Ta wese vonaya,",{"text":"“Kaiwabu,","poem":1},{"text":"oʼa tuta ana ʼebeveʼale ʼinaya","poem":2},{"lineBreak":true},{"text":"bwaʼobwaʼo uʼivaʼavaʼaia","poem":2},{"lineBreak":true},{"text":"ta wese tauʼu nimauyega mahala uviaqia.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Baʼe ʼivaʼavaʼata diavona ina awala,","poem":1},{"text":"ta oʼa una toa vataya.","poem":2},{"text":"Ta wese ina veyani kavokavovo","poem":1},{"text":"ʼidewani kaleko ʼituʼituwaidi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ta oʼa mahala be bwaʼobwaʼo","poem":1},{"text":"una nunumidi kavonaya","poem":2},{"lineBreak":true},{"text":"ʼafwala kuena ʼidewani,","poem":2},{"lineBreak":true},{"text":"ta ina ʼwaya ʼidewani","poem":2},{"lineBreak":true},{"text":"kaleko ʼituʼituwaidi.","poem":2},{"text":"Ta oʼa ge taha tuta uda vedumaduma,","poem":1},{"text":"ta wese yawaiu ge ena ʼebeluʼovoamo.”","poem":2}]},{"type":"verse","number":13,"content":["Ge taha tuta Yaubada ena tovaleʼewayavo ʼidia davonaya,",{"text":"“Utoabui ʼataqiguya ana laba","poem":1},{"text":"au aviayavo ena miedi","poem":2},{"lineBreak":true},{"text":"ena aʼuwebuiedi ʼaqeu ʼayanaya","poem":2},{"lineBreak":true},{"text":"ta una luvinedi.”","poem":2}]},{"type":"verse","number":14,"content":["Mana tovaleʼewa diavona taudi niboniboana ta toiula, ta Yaubada vevetunedi tomotau ʼidia sabi iuladi ʼetoyavua ana ʼewa weaqina."]}],"footnotes":[]},"thisChapterLink":"/api/mox_fns/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mox_fns/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mox_fns/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}