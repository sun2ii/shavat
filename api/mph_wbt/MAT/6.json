{"translation":{"id":"mph_wbt","name":"Mawng Mark and other Scripture portions","website":"https://ebible.org/Scriptures/details.php?id=mph","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mph","licenseNotes":null,"shortName":"WBT","englishName":"Mawng Bible Portions","language":"mph","textDirection":"ltr","sha256":"663ae41e39bc9c73a5ebacebd8788cf3e7d43c5e46f869dd610e96043d01bf32","availableFormats":["json"],"listOfBooksApiLink":"/api/mph_wbt/books.json","numberOfBooks":5,"totalNumberOfChapters":20,"totalNumberOfVerses":614,"languageName":"Maung","languageEnglishName":"Maung"},"book":{"id":"MAT","translationId":"mph_wbt","name":"Matthew","commonName":"Matthew","title":"Matthew","order":40,"numberOfChapters":1,"sha256":"d091bdc5eefbea1ef74bd0655011ac84217210e19e71d43565fa2421aca30fe4","firstChapterNumber":6,"firstChapterApiLink":"/api/mph_wbt/MAT/6.json","lastChapterNumber":6,"lastChapterApiLink":"/api/mph_wbt/MAT/6.json","totalNumberOfVerses":5},"chapter":{"number":6,"content":[{"type":"verse","number":9,"content":[{"text":"Punyi God nuyi ta ngarrunmalkpany ta kanpani kapa yurrng.","poem":1},{"lineBreak":true},{"text":"Ngarri ngarrungmiyarma ngarrkarrayirrk ngarrungpawurrun nuyi ta nukurlyak mira.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ngarri kurrunmiyarma ta kanguken ngarru.","poem":1},{"lineBreak":true},{"text":"Ngarri ngarrungmiyarma amparrkamparrk wukarrayirrk kunak arrkpanamin tuka nuyi kungmiyarma, kapin wigarrayirrk kapa yurrng kamin tuka nuyi kungmiyarma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kurruntakajpun ngarrununi walij ta kayirrk.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kurruntakajpun kungpaka ngarru ta nungmurrunti ngatpin la anpanarrapularngalk kirrk ta nungmurrunti, ngarri ngatpanarrapularlngalk ta nungmurrunti kamin ngarru.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ngarri kurruntakajpun arrkpayirtiki nuyu marrik ngatpi ta nungmurrunti, ngarri kurruntakajpun arrkpayirtiki ja kiwken manya marrik ngarruningulay ngarriyarru yanat.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mph_wbt/MAT/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mph_wbt/MRK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":5}