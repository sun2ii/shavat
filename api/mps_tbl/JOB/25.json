{"translation":{"id":"mps_tbl","name":"Godigo dwagi yai po buku","website":"https://ebible.org/Scriptures/details.php?id=mps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mps","licenseNotes":null,"shortName":"TBL","englishName":"Dadibi Bible","language":"mps","textDirection":"ltr","sha256":"cb51e2cbab13c1c590235061c349f341ee5819d5715ba243bb00a6374aa23e6a","availableFormats":["json"],"listOfBooksApiLink":"/api/mps_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30314,"languageName":"Dadibi","languageEnglishName":"Dadibi"},"book":{"id":"JOB","translationId":"mps_tbl","name":"Jopgo Po Asęani Elalubo Buku","commonName":"Jopgo Po Asęani Elalubo Buku","title":"Jopgo Po Asęani Elalubo Buku","order":18,"numberOfChapters":42,"sha256":"4029db4578a2aa3479b4769c1dfcf91d5664fceae342a6f7954378fcc516b8aa","firstChapterNumber":1,"firstChapterApiLink":"/api/mps_tbl/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/mps_tbl/JOB/42.json","totalNumberOfVerses":1047},"chapter":{"number":25,"content":[{"type":"heading","content":["Godigo gedude da bidi olo nai tiwai dao"]},{"type":"verse","number":1,"content":["Jopgo po ola silibo si, te Bildat te bulu Suha bidigo po wei ponoyu, e tama wali."]},{"type":"verse","number":2,"content":[{"text":"“Godigo genuai bomo elaluyu,","poem":1},{"text":"agai tigidali nai tonalubo.","poem":3},{"text":"Agai tigidali nai dabe noma selama, wi emainu ebo dao.","poem":1},{"lineBreak":true},{"text":"Tama agai dagalude elalubo nai dabe","poem":1},{"text":"dua bugagia bidimainu ebo dao.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Te dagalude ami bidi hauwa mu,","poem":1},{"text":"tama bidigo nedebo usu egobeo.","poem":2},{"text":"Tama Godigo ula tigidali we bidibolo mabo dao.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mena tama da tǫde bidi doloba pelama,","poem":1},{"lineBreak":true},{"text":"Godigo gedude meda meni yai pedalaibawe?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dago polua ula genuai subo dao.","poem":1},{"lineBreak":true},{"text":"Tiali goli, Godigo gedude da, te dwasianunu mu dao.","poem":1},{"lineBreak":true},{"text":"Tama hǫ dabe me agai gedude dwagi yai menio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Te mu tama, da bidi agai gedude doloba pai menio.","poem":1},{"lineBreak":true},{"text":"Da te tǫde dwasianu sawi tiwai dao.","poem":1},{"lineBreak":true},{"text":"Da te olo nai osogane tiwai naga dao,”","poem":1},"Bildatgo te po wai."]}],"footnotes":[]},"thisChapterLink":"/api/mps_tbl/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mps_tbl/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mps_tbl/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}