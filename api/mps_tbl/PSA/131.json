{"translation":{"id":"mps_tbl","name":"Godigo dwagi yai po buku","website":"https://ebible.org/Scriptures/details.php?id=mps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mps","licenseNotes":null,"shortName":"TBL","englishName":"Dadibi Bible","language":"mps","textDirection":"ltr","sha256":"cb51e2cbab13c1c590235061c349f341ee5819d5715ba243bb00a6374aa23e6a","availableFormats":["json"],"listOfBooksApiLink":"/api/mps_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30314,"languageName":"Dadibi","languageEnglishName":"Dadibi"},"book":{"id":"PSA","translationId":"mps_tbl","name":"Godigo Nogi Ugwaba Sabo Tęąbi Po Wabo Buku Dabe","commonName":"Godigo Nogi Ugwaba Sabo Tęąbi Po Wabo Buku Dabe","title":"Godigo Nogi Ugwaba Sabo Tęąbi Po Wabo Buku Dabe","order":19,"numberOfChapters":150,"sha256":"e715883e6f179e607ff28e2a6350146f636f0c342e56139821e9801f27fd65a6","firstChapterNumber":1,"firstChapterApiLink":"/api/mps_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mps_tbl/PSA/150.json","totalNumberOfVerses":2451},"chapter":{"number":131,"content":[{"type":"heading","content":["Bidigo te konealubo po dąų olama, Godiba gedu haluasa po wali"]},{"type":"verse","number":1,"content":[{"text":"Genuai Bidi, eno te hagoma yali kolesaga","poem":1},{"text":"tagalama, tama eno te ena digi te nogi","poem":2},{"text":"ugwaba me sabeo.","poem":3},{"text":"Eno te genuai nai dabede homu kone me isiąma,","poem":1},{"text":"tama te eno konesiąwai nai dabede","poem":2},{"lineBreak":true},{"text":"me eno homu kone me ebo menio.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tiali goli, ena te bugagia duagulama,","poem":1},{"text":"tama ena homu dua tegaluai.","poem":2},{"text":"Ena te wai bǫų aga idago nogode digi","poem":1},{"text":"pagealubo tiwai elalubao.","poem":2},{"text":"Tama tiwai naga, eno haliga me te dua digi elalubao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Te Israel dabe, dagego konealubo","poem":1},{"text":"homu Genuai Bidiba muiyąo,","poem":2},{"lineBreak":true},{"text":"megi me, tigidali sogo nosali me, te tama tiao.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mps_tbl/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mps_tbl/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mps_tbl/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}