{"translation":{"id":"mpx_png","name":"Bateli Vavaluna","website":"https://ebible.org/Scriptures/details.php?id=mpx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mpx","licenseNotes":null,"shortName":"PNG","englishName":"Misima-Paneati Bible","language":"mpx","textDirection":"ltr","sha256":"7ef93c99e8d5cd2b1564810c10382aaacd5cccf705d815b16cef2b05dfba702b","availableFormats":["json"],"listOfBooksApiLink":"/api/mpx_png/books.json","numberOfBooks":37,"totalNumberOfChapters":463,"totalNumberOfVerses":12043,"languageName":"Misima-Panaeati","languageEnglishName":"Misima-Panaeati"},"book":{"id":"MAT","translationId":"mpx_png","name":"MATAIYO","commonName":"MATAIYO","title":"Yeisu Wasana Waiwaisana Mataiyo wana Leleli","order":40,"numberOfChapters":28,"sha256":"90fd241bc6b54933bdb9ded371f958210ba12cc7ba84abe390563706c2f56bc8","firstChapterNumber":1,"firstChapterApiLink":"/api/mpx_png/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/mpx_png/MAT/28.json","totalNumberOfVerses":1068},"chapter":{"number":1,"content":[{"type":"heading","content":["Yeisu ana Lihu"]},{"type":"verse","number":1,"content":["Yeisu Keliso ana lihu i ola hiwe. Yeisu Keliso iya Deibid tubutubunina, Deibid iya Abalahama tubutubunina."]},{"type":"verse","number":2,"content":[{"text":"Abalahama natuna Aisake,","poem":1},{"lineBreak":true},{"text":"Aisake natuna Yakobo,","poem":1},{"lineBreak":true},{"text":"Yakobo natunau Yuda ge talinau,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yuda natunau Peles ge Sela, hinaliya Tama,","poem":1},{"lineBreak":true},{"text":"Peles natuna Hesiloni,","poem":1},{"lineBreak":true},{"text":"Hesiloni natuna Lama,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lama natuna Aminadab,","poem":1},{"lineBreak":true},{"text":"Aminadab natuna Nason,","poem":1},{"lineBreak":true},{"text":"Nason natuna Salimon,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Salimon natuna Bowasa, hinana heiya Leyabi,","poem":1},{"lineBreak":true},{"text":"Bowasa natuna Obedi, hinana heiya Ludi,","poem":1},{"lineBreak":true},{"text":"Obedi natuna Diyesi,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Diyesi natuna Kin Deibid.","poem":1},{"lineBreak":true},{"text":"Deibid natuna Solomon, hinana heiya toto valila Ulaiya lagona,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Solomon natuna Lehobowam,","poem":1},{"lineBreak":true},{"text":"Lehobowam natuna Abaidiya,","poem":1},{"lineBreak":true},{"text":"Abaidiya natuna Asa,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asa natuna Yehosepat,","poem":1},{"lineBreak":true},{"text":"Yehosepat natuna Yolama,","poem":1},{"lineBreak":true},{"text":"Yolama natuna Usaiya,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Usaiya natuna Yotami,","poem":1},{"lineBreak":true},{"text":"Yotami natuna Ehasi,","poem":1},{"lineBreak":true},{"text":"Ehasi natuna Hesekaiya,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hesekaiya natuna Manasa,","poem":1},{"lineBreak":true},{"text":"Manasa natuna Eimon,","poem":1},{"lineBreak":true},{"text":"Eimon natuna Yosaiya,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yosaiya natunau Yehoyasin ge talinau,","poem":1},{"text":"sauga toto Babiloni hi nem Isileli hi ahel ge hi na hi telel Babiloni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Isileli hi ahel ge hi na hi telel Babiloni inoke enaa:","poem":1},{"lineBreak":true},{"text":"Yehoyasin natuna Seyaltiyel,","poem":1},{"lineBreak":true},{"text":"Seyaltiyel natuna Selababel,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Selababel natuna Abiuda,","poem":1},{"lineBreak":true},{"text":"Abiuda natuna Elayakim,","poem":1},{"lineBreak":true},{"text":"Elayakim natuna Eiso,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Eiso natuna Seidok,","poem":1},{"lineBreak":true},{"text":"Seidok natuna Akim,","poem":1},{"lineBreak":true},{"text":"Asim natuna Eliuda,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Eliuda natuna Eliyesa,","poem":1},{"lineBreak":true},{"text":"Eliyesa natuna Meitan,","poem":1},{"lineBreak":true},{"text":"Meitan natuna Yakobo,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ge Yakobo natuna Yosepa, Meli lagona.","poem":1},{"lineBreak":true},{"text":"Meli i ab Yeisu, heiya te ta ba Mesaiya.","poem":1}]},{"type":"verse","number":17,"content":["He inoke Abalahama ana siga Deibid ta pwawa heyan ali gewi potin, Deibid ana siga sauga toto Isileli hi telel Babiloni heyan ali gewi potin, ge sauga toto o ana siga Mesaiya i masal heyan ali gewi potin."]},{"type":"heading","content":["Yeisu Keliso wana Masal"]},{"type":"verse","number":18,"content":["Yeisu Keliso wana masal i ola hiwe. Hinana Meli alona ge Yosepa hi kawakawalolu. Nigeya ga hi aalolon, hi pwawa Meli iyaka i liyan Yayaluwa Bwabwalena wana gasisi eliyana."]},{"type":"verse","number":19,"content":["Yosepa wana pagan i sapu ge nige nuwana Meli ni papuluwawi-an boda mataliyaa, inoke i nuwatu tage wali kawakawalolu ni leke sume."]},{"type":"verse","number":20,"content":["I nuwanuwatu ola o, yaka ana kenonou elana Yehoba wana anelose i masala elana ge i ba, “Yosepa, Deibid tubuna, bahi nu lolovakun te Meli nu ahe lagom, kaiwena wana liyan i neem Yayaluwa Bwabwalena elana."]},{"type":"verse","number":21,"content":["Abwe ni ab natuna melutau, inoke alana nu tun Yeisu,",{"noteId":0},"kaiwena wana gamagalau ni pwamwalil wali gegi elana.”"]},{"type":"verse","number":22,"content":["He i masal i ola to, inoke Yehoba wana baaba toto palopita etega i pamasal i tabwa tunahot,"]},{"type":"verse","number":23,"content":["i ba, “Gamaina matabubuwa ni liyan ge ni ab natuna melutau, inoke alana nihi tun Imanuwela.” Imanuwela ana sapu heiya “Yehoba avala.”"]},{"type":"verse","number":24,"content":["Sauga Yosepa i kenu lut, inoke Meli i alolonan i ola Yehoba wana anelose wana baaba eliyana."]},{"type":"verse","number":25,"content":["Yaa nige alona hi kekenu toyawa ana siga i ab natuna melutau. Inoke Yosepa wawaya alana i tun Yeisu."]}],"footnotes":[{"noteId":0,"caller":"*","text":"Alan “Yeisu” ana sapu i gan heiya “Yehoba ni pwamwal.”","reference":{"chapter":1,"verse":21}}]},"thisChapterLink":"/api/mpx_png/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mpx_png/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mpx_png/MAL/4.json","previousChapterAudioLinks":{},"numberOfVerses":25}