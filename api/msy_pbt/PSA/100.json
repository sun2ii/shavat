{"translation":{"id":"msy_pbt","name":"Godɨn Eghaghanim: Akar Gavgavir Dɨkɨrɨzir Ghurim ko Igiam","website":"https://ebible.org/Scriptures/details.php?id=msy2020","licenseUrl":"https://ebible.org/Scriptures/details.php?id=msy2020","licenseNotes":null,"shortName":"PBT","englishName":"Aruamu Bible","language":"msy","textDirection":"ltr","sha256":"7dab2faa4b507139019ab1a025a5b37ac686c1ada2bc387f9f86d3b08ce01b90","availableFormats":["json"],"listOfBooksApiLink":"/api/msy_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29926,"languageName":"Aruamu","languageEnglishName":"Aruamu"},"book":{"id":"PSA","translationId":"msy_pbt","name":"Onger Akaba","commonName":"Onger Akaba","title":"Godɨn Ziam Fer Onger Akabar Akɨnafarim O Onger Akaba","order":19,"numberOfChapters":150,"sha256":"4a07ef308b7cd74649f2c6c06ed28936f83e1b3ee511b0dab14b3c5b37cfd991","firstChapterNumber":1,"firstChapterApiLink":"/api/msy_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/msy_pbt/PSA/150.json","totalNumberOfVerses":2438},"chapter":{"number":100,"content":[{"type":"heading","content":["God mɨnabir ighiam"]},{"type":"verse","number":1,"content":[{"text":"Ia nguazimɨn itir gumazamiziba bar,","poem":1},{"text":"ia Ikiavɨra Itir God bagh pamtem dɨmɨva,","poem":2},{"text":"bar akongegh an ziam fɨ.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Ia Ikiavɨra Itir Godɨn ingangarim damu","poem":1},{"text":"an ziam fɨ bar akongegh.","poem":2},{"text":"Ia an boroghɨn izɨva","poem":1},{"text":"bar akongezir ighiaba bangɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ia kamaghɨn fogh,","poem":1},{"text":"Ikiavɨra Itir God a guizbangɨra God.","poem":2},{"text":"A uabɨ en ingarizɨma e an adarazira.","poem":1},{"text":"E an gumazamiziba,","poem":2},{"text":"egha an sipsipbar mɨn iti.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"E an Dɨpenimɨn aven mangɨ","poem":1},{"text":"an ziam fɨva a mɨnamam.","poem":2},{"text":"E a mɨnabagh","poem":1},{"text":"an ziar ekiam bar a pɨrafam.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"E fo, Ikiavɨra Itir God arazir aghuibaram amua,","poem":1},{"text":"egha zurara bar en apangkuvighavɨra iti.","poem":2},{"text":"A damuasa mɨkemegha gɨvazir biziba,","poem":1},{"text":"a zurara dagh amua kamaghɨra iti.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/msy_pbt/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/msy_pbt/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/msy_pbt/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}