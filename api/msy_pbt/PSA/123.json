{"translation":{"id":"msy_pbt","name":"Godɨn Eghaghanim: Akar Gavgavir Dɨkɨrɨzir Ghurim ko Igiam","website":"https://ebible.org/Scriptures/details.php?id=msy2020","licenseUrl":"https://ebible.org/Scriptures/details.php?id=msy2020","licenseNotes":null,"shortName":"PBT","englishName":"Aruamu Bible","language":"msy","textDirection":"ltr","sha256":"7dab2faa4b507139019ab1a025a5b37ac686c1ada2bc387f9f86d3b08ce01b90","availableFormats":["json"],"listOfBooksApiLink":"/api/msy_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29926,"languageName":"Aruamu","languageEnglishName":"Aruamu"},"book":{"id":"PSA","translationId":"msy_pbt","name":"Onger Akaba","commonName":"Onger Akaba","title":"Godɨn Ziam Fer Onger Akabar Akɨnafarim O Onger Akaba","order":19,"numberOfChapters":150,"sha256":"4a07ef308b7cd74649f2c6c06ed28936f83e1b3ee511b0dab14b3c5b37cfd991","firstChapterNumber":1,"firstChapterApiLink":"/api/msy_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/msy_pbt/PSA/150.json","totalNumberOfVerses":2438},"chapter":{"number":123,"content":[{"type":"heading","content":["Gumazim Godɨn apangkuvim iniasa a ko mɨgei"]},{"type":"hebrew_subtitle","content":["Godɨn Dɨpenimɨn ghuavanaga an ziam fer ighiam."]},{"type":"verse","number":1,"content":[{"text":"O, Ikiavɨra Itir God, nɨ uan Nguibamɨn atrivimɨn itima,","poem":1},{"text":"kɨ kogha nɨn akurvazim bagha gari.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ingangarir gumazim, a uan gumazir dapanimɨn gantɨ, an an akurvagham.","poem":1},{"text":"Ingangarir amizim, a uan amizir dapanimɨn gantɨ, an an akurvagham.","poem":2},{"text":"Kamaghɨra, e Ikiavɨra Itir Godɨn ganvɨra ikɨ mangɨtɨ,","poem":1},{"text":"a uan apangkuvim en akakagham.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O, Ikiavɨra Itir God, gumazamiziba arazir kurabar e gami,","poem":1},{"text":"kamagh nɨ en apangkufigh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dughiar bar ruarimɨn dagɨaba itir gumazamiziba dɨbovir akabar e mɨgɨa,","poem":1},{"text":"uari fa pazava e gami.","poem":2},{"text":"Ezɨ e bar amɨra.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/msy_pbt/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/msy_pbt/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/msy_pbt/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}