{"translation":{"id":"msy_pbt","name":"Godɨn Eghaghanim: Akar Gavgavir Dɨkɨrɨzir Ghurim ko Igiam","website":"https://ebible.org/Scriptures/details.php?id=msy2020","licenseUrl":"https://ebible.org/Scriptures/details.php?id=msy2020","licenseNotes":null,"shortName":"PBT","englishName":"Aruamu Bible","language":"msy","textDirection":"ltr","sha256":"7dab2faa4b507139019ab1a025a5b37ac686c1ada2bc387f9f86d3b08ce01b90","availableFormats":["json"],"listOfBooksApiLink":"/api/msy_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29926,"languageName":"Aruamu","languageEnglishName":"Aruamu"},"book":{"id":"PSA","translationId":"msy_pbt","name":"Onger Akaba","commonName":"Onger Akaba","title":"Godɨn Ziam Fer Onger Akabar Akɨnafarim O Onger Akaba","order":19,"numberOfChapters":150,"sha256":"4a07ef308b7cd74649f2c6c06ed28936f83e1b3ee511b0dab14b3c5b37cfd991","firstChapterNumber":1,"firstChapterApiLink":"/api/msy_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/msy_pbt/PSA/150.json","totalNumberOfVerses":2438},"chapter":{"number":124,"content":[{"type":"heading","content":["Godɨn gumazamiziba, a uabɨ men akurvazim"]},{"type":"hebrew_subtitle","content":["Ighiar kam, Devit an osiri."]},{"type":"hebrew_subtitle","content":["Godɨn Dɨpenimɨn ghuavanaga an ziam fer ighiam."]},{"type":"verse","number":1,"content":[{"text":"Ikiavɨra Itir God en akuraghan koghtɨ, e manmaghɨra damuam?","poem":1},{"text":"Ia Israelia azangsɨzir kam ikaragh mɨkɨm suam:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"En apaniba faragha naviba en ikuvigha e mɨsoke.","poem":1},{"text":"Ikiavɨra Itir God en akurazir puvatɨzɨ,","poem":2},{"text":"apaniba pazavɨra en atara bar e gasɨghasighai.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Puvatɨzɨ apaniba aperiamɨn mɨn e inigha ghuzɨ","poem":1},{"text":"dɨpam e avarazɨ moghɨn e oveghai.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mati aperiar ekiam","poem":1},{"text":"bar e adugha ghueghai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"E datɨrɨghɨn Ikiavɨra Itir God mɨnabagham.","poem":1},{"text":"A itima en apaniba asɨzir atiamɨn mɨn e givir puvatɨ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mati gumazim kuarazimɨn suighasa azuazim gura,","poem":1},{"text":"e kuarazimɨn mɨn mɨghegha a gitagha ghu.","poem":2},{"text":"Me gurazir azuazir kam dutuaghirɨ,","poem":3},{"text":"ezɨ e a gitagha ghu.","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Bar guizbangɨra, Ikiavɨra Itir Godɨn overiam ko nguazimɨn ingarizim,","poem":1},{"text":"a uabɨra en akurvasi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/msy_pbt/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/msy_pbt/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/msy_pbt/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":7}