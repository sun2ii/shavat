{"translation":{"id":"msy_pbt","name":"Godɨn Eghaghanim: Akar Gavgavir Dɨkɨrɨzir Ghurim ko Igiam","website":"https://ebible.org/Scriptures/details.php?id=msy2020","licenseUrl":"https://ebible.org/Scriptures/details.php?id=msy2020","licenseNotes":null,"shortName":"PBT","englishName":"Aruamu Bible","language":"msy","textDirection":"ltr","sha256":"7dab2faa4b507139019ab1a025a5b37ac686c1ada2bc387f9f86d3b08ce01b90","availableFormats":["json"],"listOfBooksApiLink":"/api/msy_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29926,"languageName":"Aruamu","languageEnglishName":"Aruamu"},"book":{"id":"PSA","translationId":"msy_pbt","name":"Onger Akaba","commonName":"Onger Akaba","title":"Godɨn Ziam Fer Onger Akabar Akɨnafarim O Onger Akaba","order":19,"numberOfChapters":150,"sha256":"4a07ef308b7cd74649f2c6c06ed28936f83e1b3ee511b0dab14b3c5b37cfd991","firstChapterNumber":1,"firstChapterApiLink":"/api/msy_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/msy_pbt/PSA/150.json","totalNumberOfVerses":2438},"chapter":{"number":125,"content":[{"type":"heading","content":["God uan gumazamizibagh amizɨ, me deragha apia"]},{"type":"hebrew_subtitle","content":["Godɨn Dɨpenimɨn ghuavanaga an ziam fer ighiam."]},{"type":"verse","number":1,"content":[{"text":"Gumazamizir nɨghnɨzir gavgavim Ikiavɨra Itir Godɨn itiba,","poem":1},{"text":"me Saionɨn Mɨghsɨamɨn mɨn iti.","poem":2},{"text":"Mɨghsɨar kam bar gavgavigha","poem":1},{"text":"mozoroziba puvatɨ,","poem":2},{"text":"a ikɨ kamaghɨra ikiam.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Kamaghɨra, mɨghsɨaba Jerusalemɨn nguibam ekɨaruzɨ moghɨn,","poem":1},{"text":"datɨrɨghɨn ko gɨn Ikiavɨra Itir God,","poem":2},{"text":"uan gumazamiziba ekɨarugh men ganam.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gumazir arazir kurabagh amiba,","poem":1},{"text":"Godɨn gumazamizibar nguazim gativagh zurara men ganan kogham.","poem":2},{"text":"Me kamagh damutɨ,","poem":1},{"text":"Godɨn gumazamiziba uaghan arazir kurabar amuam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"O, Ikiavɨra Itir God, gumazamizir nɨ baghavɨra ikia nɨn akamɨn gɨn zuiba,","poem":1},{"text":"nɨ deraghvɨra me damu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nɨ gumazir kurabagh asɨghasɨgh,","poem":1},{"text":"egh gumazir ifara uan nɨghnɨzibar gɨn zuiba sarama asɨghasɨkigh.","poem":2},{"lineBreak":true},{"text":"Eghtɨ Israelia deraghvɨra ikiam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/msy_pbt/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/msy_pbt/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/msy_pbt/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}