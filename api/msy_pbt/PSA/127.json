{"translation":{"id":"msy_pbt","name":"Godɨn Eghaghanim: Akar Gavgavir Dɨkɨrɨzir Ghurim ko Igiam","website":"https://ebible.org/Scriptures/details.php?id=msy2020","licenseUrl":"https://ebible.org/Scriptures/details.php?id=msy2020","licenseNotes":null,"shortName":"PBT","englishName":"Aruamu Bible","language":"msy","textDirection":"ltr","sha256":"7dab2faa4b507139019ab1a025a5b37ac686c1ada2bc387f9f86d3b08ce01b90","availableFormats":["json"],"listOfBooksApiLink":"/api/msy_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29926,"languageName":"Aruamu","languageEnglishName":"Aruamu"},"book":{"id":"PSA","translationId":"msy_pbt","name":"Onger Akaba","commonName":"Onger Akaba","title":"Godɨn Ziam Fer Onger Akabar Akɨnafarim O Onger Akaba","order":19,"numberOfChapters":150,"sha256":"4a07ef308b7cd74649f2c6c06ed28936f83e1b3ee511b0dab14b3c5b37cfd991","firstChapterNumber":1,"firstChapterApiLink":"/api/msy_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/msy_pbt/PSA/150.json","totalNumberOfVerses":2438},"chapter":{"number":127,"content":[{"type":"heading","content":["God arazir aghuimɨn me gamizɨ me an ziam fe"]},{"type":"hebrew_subtitle","content":["Ighiar kam, Solomon an osiri."]},{"type":"hebrew_subtitle","content":["Godɨn Dɨpenimɨn ghuavanaga an ziam fer ighiam."]},{"type":"verse","number":1,"content":[{"text":"Ikiavɨra Itir God uabɨ dɨpenimɨn ingar.","poem":1},{"text":"Puvatɨghtɨma, dɨpenir kamɨn ingarir gumaziba pura an ingarigham.","poem":2},{"text":"Ikiavɨra Itir God uabɨ nguibamɨn gan.","poem":1},{"text":"Puvatɨghtɨma, nguibar kamɨn garir gumaziba pura ingarigham.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"E dagheba ko dagɨaba bagha bar mɨzarazibara dɨkava ingara zui amɨniba pɨri.","poem":1},{"text":"E pura ingangarir kabagh ami.","poem":2},{"text":"Ikiavɨra Itir God uabɨ gumazamizir a ifongeziba biziba me ganɨdima,","poem":1},{"text":"me pura ikia avughsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Boriba, kar bizir aghuir Ikiavɨra Itir God anɨdiba,","poem":1},{"text":"da bar dera.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gumazir igiamɨn boriba,","poem":1},{"text":"mati afuziba mɨdorozir gumazir mamɨn dafarimɨn iti.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gumazir borir avɨriba itim a bar akongegh.","poem":1},{"text":"A uan apaniba ko kotiam damuamim dughiamɨn,","poem":2},{"text":"me kotiar danganimɨn an akurvagham.","poem":3},{"text":"Eghtɨ an kotiam deragh mangam.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/msy_pbt/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/msy_pbt/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/msy_pbt/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}