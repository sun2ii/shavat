{"translation":{"id":"msy_pbt","name":"Godɨn Eghaghanim: Akar Gavgavir Dɨkɨrɨzir Ghurim ko Igiam","website":"https://ebible.org/Scriptures/details.php?id=msy2020","licenseUrl":"https://ebible.org/Scriptures/details.php?id=msy2020","licenseNotes":null,"shortName":"PBT","englishName":"Aruamu Bible","language":"msy","textDirection":"ltr","sha256":"7dab2faa4b507139019ab1a025a5b37ac686c1ada2bc387f9f86d3b08ce01b90","availableFormats":["json"],"listOfBooksApiLink":"/api/msy_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29926,"languageName":"Aruamu","languageEnglishName":"Aruamu"},"book":{"id":"PSA","translationId":"msy_pbt","name":"Onger Akaba","commonName":"Onger Akaba","title":"Godɨn Ziam Fer Onger Akabar Akɨnafarim O Onger Akaba","order":19,"numberOfChapters":150,"sha256":"4a07ef308b7cd74649f2c6c06ed28936f83e1b3ee511b0dab14b3c5b37cfd991","firstChapterNumber":1,"firstChapterApiLink":"/api/msy_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/msy_pbt/PSA/150.json","totalNumberOfVerses":2438},"chapter":{"number":150,"content":[{"type":"heading","content":["Godɨn ziam fer ighiar abuananam"]},{"type":"verse","number":1,"content":[{"text":"God uan Dɨpenimɨn itima, e an ziam fam.","poem":1},{"text":"A gavgavir bar ekiam ikia uan Nguibamɨn itima,","poem":2},{"text":"e an ziam pɨrafam.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"A bar bizir ekiabagh ami.","poem":1},{"text":"E ziar ekiam a danɨngam.","poem":2},{"text":"A bar faraghavɨra ikia, an ziar ekiam bar pɨn mar iti.","poem":1},{"text":"E an ziam fam.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"E sɨghabagh iviva, dɨbɨariba ko gitabav sogh,","poem":1},{"text":"Ikiavɨra Itir Godɨn ziam pɨrafam.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"E tambarinbav soghɨva, ighɨ an ziam fam.","poem":1},{"text":"E gitan avɨrir igharagha garibav soghɨva, itabagh iviva ziar ekiam a danɨngam.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"E brasɨn itaribav soghtɨ da bar puvɨrama arangtɨ,","poem":1},{"text":"e Ikiavɨra Itir Godɨn ziam fam.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"E bizir bar angamɨra itiba,","poem":1},{"text":"e bar Ikiavɨra Itir Godɨn ziam fam.","poem":2},{"lineBreak":true},{"text":"E bar Ikiavɨra Itir Godɨn ziam fam!","poem":1},{"text":"Aleluia!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/msy_pbt/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/msy_pbt/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/msy_pbt/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}