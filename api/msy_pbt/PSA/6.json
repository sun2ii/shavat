{"translation":{"id":"msy_pbt","name":"Godɨn Eghaghanim: Akar Gavgavir Dɨkɨrɨzir Ghurim ko Igiam","website":"https://ebible.org/Scriptures/details.php?id=msy2020","licenseUrl":"https://ebible.org/Scriptures/details.php?id=msy2020","licenseNotes":null,"shortName":"PBT","englishName":"Aruamu Bible","language":"msy","textDirection":"ltr","sha256":"7dab2faa4b507139019ab1a025a5b37ac686c1ada2bc387f9f86d3b08ce01b90","availableFormats":["json"],"listOfBooksApiLink":"/api/msy_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29926,"languageName":"Aruamu","languageEnglishName":"Aruamu"},"book":{"id":"PSA","translationId":"msy_pbt","name":"Onger Akaba","commonName":"Onger Akaba","title":"Godɨn Ziam Fer Onger Akabar Akɨnafarim O Onger Akaba","order":19,"numberOfChapters":150,"sha256":"4a07ef308b7cd74649f2c6c06ed28936f83e1b3ee511b0dab14b3c5b37cfd991","firstChapterNumber":1,"firstChapterApiLink":"/api/msy_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/msy_pbt/PSA/150.json","totalNumberOfVerses":2438},"chapter":{"number":6,"content":[{"type":"heading","content":["Gumazim osɨmtɨzim ikia uabɨn akurvaghasa God ko mɨgei"]},{"type":"hebrew_subtitle","content":["Devit onger akar kam osiri."]},{"type":"hebrew_subtitle","content":["Gumazir onger akar kamɨn faragha zuim, gita gikararang ongasa me mɨkeme."]},{"type":"verse","number":1,"content":[{"text":"O Ikiavɨra Itir God, nɨ adarim ikɨ","poem":1},{"text":"pamten na mɨkɨman markɨ.","poem":2},{"text":"Nɨn navim ikuvightɨ,","poem":1},{"text":"nɨ ivezir kuram na danɨngan markɨ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O Ikiavɨra Itir God, kɨ bar osemegha ua gavgaviba puvatɨ,","poem":1},{"text":"ezɨ nɨ nan apangkufigh.","poem":2},{"text":"Nan gavgaviba bar gɨfa,","poem":1},{"text":"eghtɨ nɨ gavgavir igiam na danɨngightɨ kɨ ua deragham.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O Ikiavɨra Itir God, nan navim osɨmtɨzir ekiam a itaragha ghuaghiri.","poem":1},{"text":"Ezɨ dughiaba manmaghɨn,","poem":2},{"text":"osɨmtɨzir ekiar kam nan navir averiamɨn ikɨvɨra ikiam?","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"O Ikiavɨra Itir God, nɨ iragh izɨ","poem":1},{"text":"nan akuragh ua na inigh.","poem":2},{"text":"Nɨn apangkuvim zurara ikia mamaghɨra iti,","poem":1},{"text":"nɨ uan apangkuvim ginɨrɨgh nan akuraghtɨ","poem":2},{"text":"kɨ ovengan kogham.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Gumazamizir oveaghueziba,","poem":1},{"text":"me ua nɨ gɨnɨghnɨzir puvatɨ.","poem":2},{"text":"Gumazamizir Oveaghuezibar Nguibamɨn,","poem":1},{"text":"tina ua nɨn ziam fam?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kɨ dia ghuavti, nan gavgaviba bar gɨfa.","poem":1},{"text":"Nan temeriba zurara dɨmagaribar nan mɨsiam giri,","poem":2},{"text":"kɨ ara ghuav itima,","poem":3},{"text":"nan dapanir aghoghonim bar kumkumi.","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Nan apanir avɨriba iti,","poem":1},{"text":"kamaghɨn amizɨ, kɨ dughiabar aziavɨra iti.","poem":2},{"text":"Nan damazimning nan bezɨ,","poem":1},{"text":"kɨ deragha bizibar garir puvatɨ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ikiavɨra Itir God nan azirakam baregha gɨfa,","poem":1},{"text":"kamaghɨn, ia gumazir arazir kurabagh amiba,","poem":2},{"text":"na gitagh.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Kɨ uabɨn akurvaghasa Ikiavɨra Itir God ko mɨgeima,","poem":1},{"text":"a na baregha gɨfa.","poem":2},{"text":"Kɨ a ko mɨgeir mɨgɨrɨgɨaba, a da baregha gɨfa.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Nan apaniba osɨmtɨzir ekiam inigh,","poem":1},{"text":"bar aghumsɨgh atiatigham.","poem":2},{"text":"Me zuamɨra na ategh onganigh arɨ","poem":1},{"text":"tintinibar mangegham.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/msy_pbt/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/msy_pbt/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/msy_pbt/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}