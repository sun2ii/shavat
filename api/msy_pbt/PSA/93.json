"poem":1},{"text":"nɨn Nguibamɨn itir biziba, nɨ bar dagh ativagha dar gari.","poem":2},{"text":"Ongarim dɨpɨra nɨdir nɨgɨnim, a sufi.","poem":1},{"text":"Nɨn gavgavim a gafiragha bar ekefe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ikiavɨra Itir God, nɨn Akar Gavgaviba ikɨ kamaghɨra ikiam.","poem":1},{"text":"Nɨn Dɨpenim zurara zuegh kamaghɨra ikiam.","poem":2},{"text":"Bar guizbangɨra!","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/msy_pbt/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/msy_pbt/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/msy_pbt/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":6}