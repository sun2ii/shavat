{"translation":{"id":"msy_pbt","name":"Godɨn Eghaghanim: Akar Gavgavir Dɨkɨrɨzir Ghurim ko Igiam","website":"https://ebible.org/Scriptures/details.php?id=msy2020","licenseUrl":"https://ebible.org/Scriptures/details.php?id=msy2020","licenseNotes":null,"shortName":"PBT","englishName":"Aruamu Bible","language":"msy","textDirection":"ltr","sha256":"7dab2faa4b507139019ab1a025a5b37ac686c1ada2bc387f9f86d3b08ce01b90","availableFormats":["json"],"listOfBooksApiLink":"/api/msy_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29926,"languageName":"Aruamu","languageEnglishName":"Aruamu"},"book":{"id":"SNG","translationId":"msy_pbt","name":"Solomon","commonName":"Solomon","title":"Solomonɨn Onger Akam O Solomon","order":22,"numberOfChapters":8,"sha256":"f1799e3f69619476613bc304bd77ce062ce89e5334acab7461245f9fcc0280c0","firstChapterNumber":1,"firstChapterApiLink":"/api/msy_pbt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/msy_pbt/SNG/8.json","totalNumberOfVerses":120},"chapter":{"number":7,"content":[{"type":"heading","content":["Gumazir igiamɨn onger akam"]},{"type":"verse","number":1,"content":[{"text":"O kɨ ifongezir amizim, nɨ bar amizir igharazibagh afira,","poem":1},{"text":"egha mati atrivimɨn guivim.","poem":2},{"text":"Nɨ dagarir asuaba aghuizɨ,","poem":1},{"text":"nɨn dagarimning bar aghungi.","poem":2},{"text":"Nɨn oghɨriamningɨn ganganimning, bar dera,","poem":1},{"text":"mati nedazir mamning, fofozir gumazim dagɨar aghuimɨn aning aghore.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nɨn overapanim,","poem":1},{"text":"mati itarir mam, me wainɨn dɨpam ko pauran isɨngtɨzim verezɨ, an a gizɨfa.","poem":2},{"text":"Nɨn navim bar dera,","poem":1},{"text":"mati witɨn pozir mam, me akɨmarir aghuaribar an kuruke.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nɨn otemning bar dera,","poem":1},{"text":"mati asɨzir dian atiar aghuarir pumuning.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nɨn fɨragharim bar dera,","poem":1},{"text":"mati tauan ruarir ghurghurim.","poem":2},{"text":"Nɨn damazimning bar dera,","poem":1},{"text":"mati dɨpar akarer muziarir Hesbonɨn nguibar ekiamɨn tiar akamɨn boroghɨn itimning.","poem":2},{"text":"Nɨn atinim bar dera,","poem":1},{"text":"mati Lebanon geghuvir gumazibar tauan ruarim.","poem":2},{"text":"Me an ikiava, Damaskusɨn nguibar ekiam geghufi.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Nɨn dapanim nɨn namnam gisɨn ikia bar dera,","poem":1},{"text":"mati atrivimɨn dapanir asuam,","poem":2},{"text":"egha mati Karmelɨn Mɨghsɨar orazim.","poem":3},{"text":"Nɨn dapanir arɨzir gɨrakɨrangɨn guraghav itim, pigha ruaragha bar deragha taghtasi,","poem":1},{"text":"mati atrivimɨn inir aghuim.","poem":2},{"text":"Egh nɨn dapanarɨzir kam,","poem":1},{"text":"atrivim damutɨ, a nɨ gakuegh, nɨn kalabuziar gumazimɨn mɨn otogham.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"O nan amizir kɨ ifongezim, nɨ amizir bar dirim.","poem":1},{"lineBreak":true},{"text":"Kɨ bar nɨ gifonge,","poem":1},{"text":"ezɨ nɨn biziba bar na gamima,","poem":2},{"text":"kɨ bar akonge.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Nɨn ruarim bar dera,","poem":1},{"text":"mati iruem voroghɨra tughav iti.","poem":2},{"text":"Ezɨ nɨn otemning,","poem":1},{"text":"mati iruer foroziamning.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kɨ ghaze, kɨ iruer kamɨn mavanang,","poem":1},{"text":"egh an dagheba iniam.","poem":2},{"text":"Kɨ nɨn otemningɨn gari,","poem":1},{"text":"aning mati wainɨn orozaghar ovɨzir avɨriba itimning.","poem":2},{"text":"Ezɨ nɨn akamɨn otivir mughuriam,","poem":1},{"text":"mati ter ovɨzir mughuriar aghuim itim.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nɨ nan torima bar dera,","poem":1},{"text":"mati wainɨn bar aghuim, nan amizimɨn akatorimɨn amɨraghavɨra emɨri.","poem":2},{"text":"Nɨ nan tora,","poem":1},{"text":"mati ga uaning inigha akua wainɨn isɨngtɨzim api.","poem":2}]},{"type":"heading","content":["Amizir igiamɨn onger akam"]},{"type":"verse","number":10,"content":[{"text":"Nan roroar gumazir kɨ bar ifongezim,","poem":1},{"text":"kɨ an amuim,","poem":2},{"text":"ezɨ a bar na gifonge.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"O nan roroar gumazir kɨ bar ifongezim,","poem":1},{"text":"nɨ na ko izɨ.","poem":3},{"text":"Ga dɨmagarimɨn ruarimɨn mangɨ,","poem":2},{"text":"egh nguibar dozibar ikɨ dakuam.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Egh mɨzaraghara dɨkavigh mangɨ","poem":1},{"text":"wainɨn ikarɨzir azenibar ganam.","poem":2},{"text":"Dar atiba ko akɨmariba ti oneghama?","poem":3},{"text":"Egh uaghan pomigranetɨn ovɨzir aghuiba ber temebar ganam,","poem":2},{"text":"dar akɨmariba ti onez, o puvatɨ?","poem":3},{"text":"Ga wainɨn azenir kamɨn ikɨ,","poem":1},{"text":"egh kɨ uabɨ isɨ nɨ danɨng kamaghɨn nɨn akagham,","poem":2},{"text":"kɨ bar nɨ gifonge.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"O nan roroar gumazir kɨ bar ifongezim,","poem":1},{"text":"kɨ temer ovɨzir aghuiba ini,","poem":2},{"text":"ter ovɨzir kaba e dav gɨa ghaze, amiziba an ovɨziba isa akavsiar arazim gamua da apima,","poem":3},{"lineBreak":true},{"text":"dar mughuriam gumazim damutɨ, an amuim ko daku, egh boriba batam,","poem":3},{"text":"kɨ da isa tiar akamɨn boroghɨn da atɨ,","poem":1},{"text":"eghtɨ nɨ dar amam.","poem":2},{"text":"Kɨ fomɨra maba ini,","poem":1},{"text":"egha maba kɨ datɨrɨghɨra da ini.","poem":2},{"text":"Kɨ uan ifongiam isa nɨ baghavɨra anetɨ.","poem":1},{"lineBreak":true},{"text":"Egh ga ter ovɨzir kamɨn mughuriam ini ga uan ifongiam damutɨ, a dɨkavam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/msy_pbt/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/msy_pbt/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/msy_pbt/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}