{"translation":{"id":"mya_jvb","name":"မြန်မာကျမ်းစာ","website":"https://ebible.org/Scriptures/details.php?id=myajvb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=myajvb","licenseNotes":null,"shortName":"JVB","englishName":"Judson Burmese Bible","language":"mya","textDirection":"ltr","sha256":"ded586b0c99fd77f0a6fc6709e7c5032181d5b8e33f61b16656fbd45ce3101d2","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_jvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"ISA","translationId":"mya_jvb","name":"ဟေရှာယအနာဂတ္တိကျမ်း။","commonName":"ဟေရှာယအနာဂတ္တိကျမ်း။","title":"ဟေရှာယအနာဂတ္တိကျမ်း။","order":23,"numberOfChapters":66,"sha256":"fb5244b51b8765d0aa172477b7f3a33e17f1017cc7f4c3a04fb0bae03184ff52","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_jvb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mya_jvb/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":["ထို ကာလ ၌ သင် မြွက်ဆို ရမည်ကား၊ အိုထာဝရ ဘုရား ၊ အကျွန်ုပ်သည် ဂုဏ်ကျေးဇူးတော်ကို ချီးမွမ်း ပါမည်။ အကျွန်ုပ် ကို အမျက်ထွက် တော်မူသော်လည်း ၊ တဖန် အမျက် တော်ငြိမ်း ၍ ၊ အကျွန်ုပ် ကို နှစ်သိမ့် စေတော်မူ၏။"]},{"type":"verse","number":2,"content":["ဘုရား သခင်သည် ငါ့ ကို ကယ်တင် သော အရှင် ဖြစ်တော်မူ၏။ ကြောက်လန့် သောစိတ် မ ရှိဘဲ ရဲရင့် မည်။ ထာဝရဘုရား သည် ငါ ချီးမွမ်း ရာ၊ ငါသီချင်း ဆိုရာ၊ ငါ့ ကို ကယ်တင် တော်မူသောအရှင်ဖြစ် တော်မူ၏။"]},{"type":"verse","number":3,"content":["သင် တို့သည် ဝမ်းမြောက် သောစိတ် နှင့် ကယ်တင် ခြင်းစမ်းရေတွင်း တို့၌ ရေ ခပ် ရကြလိမ့်မည်။"]},{"type":"verse","number":4,"content":["ထို ကာလ ၌ လည်း ထာဝရဘုရား ၏ ဂုဏ်တော် ကို ချီးမွမ်း ကြလော့။ နာမ တော်ကို ပဌနာ ပြုကြလော့။ အမှု တော်တို့ကို လူ များတို့တွင် ဘော်ပြ လော့။ နာမ တော်သည် မြင့်မြတ် သောကြောင့် ချီးမွမ်း ကြလော့။"]},{"type":"verse","number":5,"content":["ထာဝရဘုရား ကိုထောမနာသီချင်းဆို ကြလော့။ထူးဆန်း သောအမှုကိုပြု တော်မူပြီ။အမှု တော်သည်မြေ တပြင် လုံး၌ ထင်ရှား ပါစေ။"]},{"type":"verse","number":6,"content":["အိုဇိအုန် သတို့သမီး၊ ကြွေးကြော် လော့။ဝမ်းမြောက်သဖြင့်အော်ဟစ် လော့။ အကြောင်း မူကား၊ဣသရေလ အမျိုး၏သန့်ရှင်း သောဘုရားသည်သင် ၏အလယ် ၌ ဘုန်းကြီး တော်မူ၏ဟုမြွက် ဆိုရလိမ့်မည်။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_jvb/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_jvb/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_jvb/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}