{"translation":{"id":"mya_jvb","name":"မြန်မာကျမ်းစာ","website":"https://ebible.org/Scriptures/details.php?id=myajvb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=myajvb","licenseNotes":null,"shortName":"JVB","englishName":"Judson Burmese Bible","language":"mya","textDirection":"ltr","sha256":"ded586b0c99fd77f0a6fc6709e7c5032181d5b8e33f61b16656fbd45ce3101d2","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_jvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_jvb","name":"ဆာလံကျမ်း","commonName":"ဆာလံကျမ်း","title":"ဆာလံကျမ်း","order":19,"numberOfChapters":150,"sha256":"3fe29b959d800ec0d34719cfbd4ce2a11f3d3a06bc8ca729838924502bce0990","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_jvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_jvb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["မတရား သောသူတို့၏ တိုက်တွန်း ခြင်းသို့ မ လိုက်၊"]},{"type":"verse","number":2,"content":["လူ ဆိုးတို့၏ လမ်း တွင် မ ရပ် မနေ၊ မထီမဲ့မြင် ပြုသောသူတို့ ၏ အစည်း အဝေး၌ မ ထိုင် ၊ ထာဝရဘုရား ၏ တရား တော်၌ မွေ့လျော် ၍ ၊ တရား တော်ကို နေ့ ညဉ့် မပြတ် ဆင်ခြင် အောက်မေ့သောသူသည် မင်္ဂလာ ရှိ၏။"]},{"type":"verse","number":3,"content":["အကြောင်း မူကား၊ ထို သူသည် မြစ် နား မှာ စိုက် လျက် မိမိ အချိန် တန်မှ အသီး ကိုသီး၍ ၊ အရွက် မ ညှိုးနွမ်း တတ်သော အပင် နှင့် တူ၏။ ပြု လေသမျှ တို့၌ အောင် လိမ့်သတည်း။"]},{"type":"verse","number":4,"content":["မတရား သောသူတို့ မူကား ထို ကဲ့သို့မ ဟုတ်။ လေ တိုက်၍ လွင့် သောဖွဲ နှင့်တူ ကြ၏။"]},{"type":"verse","number":5,"content":["ထိုကြောင့် တရား ဆုံးဖြတ်တော်မူရာကာလ၌ ၊ မတရား သောသူတို့သည် မ တည် မနေရကြ။ ဖြောင့်မတ် သောသူတို့ ၏အပေါင်း အသင်းထဲသို့ လူဆိုး တို့သည် မဝင်ရကြ။"]},{"type":"verse","number":6,"content":["အကြောင်း မူကား၊ ဖြောင့်မတ် သောသူတို့၏ လမ်း ကို ထာဝရဘုရား သိကျွမ်း တော်မူ၏။ မတရား သောသူတို့ ၏ လမ်း သည်ဆုံးရှုံး ခြင်းသို့ ရောက်ရလိမ့်သတည်း။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_jvb/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_jvb/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_jvb/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}