{"translation":{"id":"mya_jvb","name":"မြန်မာကျမ်းစာ","website":"https://ebible.org/Scriptures/details.php?id=myajvb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=myajvb","licenseNotes":null,"shortName":"JVB","englishName":"Judson Burmese Bible","language":"mya","textDirection":"ltr","sha256":"ded586b0c99fd77f0a6fc6709e7c5032181d5b8e33f61b16656fbd45ce3101d2","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_jvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_jvb","name":"ဆာလံကျမ်း","commonName":"ဆာလံကျမ်း","title":"ဆာလံကျမ်း","order":19,"numberOfChapters":150,"sha256":"3fe29b959d800ec0d34719cfbd4ce2a11f3d3a06bc8ca729838924502bce0990","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_jvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_jvb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":["မတရား သောသူတို့သည် သဘော ဖြောင့် သောသူတို့ကို မ ထင်မရှားပစ် အံ့သောငှါ လေး ကိုတင် ၍၊ လေးညှို့ ပေါ်မှာ မြှား ကိုပြင် ကြ၏။"]},{"type":"verse","number":2,"content":["အမှီတကဲ တို့သည်ပျက် လျှင် ဖြောင့်မတ် သောသူသည် အဘယ်သို့ ပြု နိုင်သနည်း။"]},{"type":"verse","number":3,"content":["ငါ့ ဝိညာဉ် အား သင် သည် ငှက် ကဲ့သို့ ကိုယ်နေရာတောင် ပေါ်သို့ပြေး ချေဟု အဘယ်ကြောင့် ပြော ကြသနည်း။ ထာဝရဘုရား သည် ငါခိုလှုံရာ ဖြစ်တော်မူ၏။"]},{"type":"verse","number":4,"content":["ထာဝရဘုရား သည် သန့်ရှင်း သော ဗိမာန် တော်၌ ရှိတော်မူ၏။ ထာဝရ ဘုရား၏ ပလ္လင် တော်သည် ကောင်းကင် ပေါ် မှာတည်၏။ မျက်စိ တော်သည် ကြည့်ရှု ၍ မျက်ခမ်း တော်သည် လူ သား တို့ကို စစ် တော်မူ၏။"]},{"type":"verse","number":5,"content":["ထာဝရဘုရား သည် ဖြောင့်မတ် သောသူကို စုံစမ်း တော်မူ၏။ မတရား သောသူနှင့် လုယူ ဖျက်ဆီးလို သော သူကိုဝိညာဉ် တော်သည် မုန်း တော်မူ၏။"]},{"type":"verse","number":6,"content":["မတရား သောသူတို့အပေါ် မှာ တောက်သော မီးခဲ၊ ကန့် နှင့် ရောသောမီးလျှံ ၊ ပူလောင် သော မုန်တိုင်း ကို သက်ရောက် စေ၍ ၊ သူ တို့သောက် စရာဘို့ စီရင်တော်မူ မည်။"]},{"type":"verse","number":7,"content":["တရား သဖြင့် ပြုတော်မူသောထာဝရဘုရား သည် တရား သောအမှုကို နှစ်သက် ၍ သဘော ဖြောင့် သောသူ ကို မျက်နှာ ပြု တော်မူ၏။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_jvb/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_jvb/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_jvb/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}