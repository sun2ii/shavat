,"number":8,"content":["ဘုရားသခင်သည် ကျောက် ကို ရေ ကန် ၊ မီး ကျောက်ကို စမ်းရေ တွင်းဖြစ်စေ တော်မူသတည်း။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_jvb/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_jvb/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_jvb/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}