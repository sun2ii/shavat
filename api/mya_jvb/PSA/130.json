":8,"content":["ဣသရေလ အမျိုးကို ခပ်သိမ်း သောဒုစရိုက် အပြစ်တို့အထဲက ရွေးနှုတ် တော်မူလိမ့်မည်။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_jvb/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_jvb/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_jvb/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}