{"translation":{"id":"mya_jvb","name":"မြန်မာကျမ်းစာ","website":"https://ebible.org/Scriptures/details.php?id=myajvb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=myajvb","licenseNotes":null,"shortName":"JVB","englishName":"Judson Burmese Bible","language":"mya","textDirection":"ltr","sha256":"ded586b0c99fd77f0a6fc6709e7c5032181d5b8e33f61b16656fbd45ce3101d2","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_jvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_jvb","name":"ဆာလံကျမ်း","commonName":"ဆာလံကျမ်း","title":"ဆာလံကျမ်း","order":19,"numberOfChapters":150,"sha256":"3fe29b959d800ec0d34719cfbd4ce2a11f3d3a06bc8ca729838924502bce0990","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_jvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_jvb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":["ဗာဗုလုန် မြစ် တို့အနား မှာ ငါတို့သည်ထိုင် ၍ ၊ ဇိအုန် မြို့ကို အောက်မေ့ လျက် ငိုကြွေး ကြ၏။"]},{"type":"verse","number":2,"content":["ငါ တို့စောင်း များကိုလည်း ထို အရပ်တွင် မိုဃ်းမခ ပင်တို့၌ ဆွဲထား ကြ၏။"]},{"type":"verse","number":3,"content":["အကြောင်း မူကား၊ ထို အရပ်၌ ငါ တို့ကို ဘမ်း သွားချုပ်ထားသော သူနှင့် ၊ ငါ တို့ကိုညှဉ်းဆဲ သောသူတို့က၊ ဇိအုန် သီချင်း ကို ငါ တို့အား ဆို ကြလော့ဟု၊ သီချင်း ဆိုသံ ကို၎င်း၊ ရွှင်လန်း သော အသံကို၎င်း၊ ငါ တို့၌ တောင်း ကြပါ သည်တကား။"]},{"type":"verse","number":4,"content":["တကျွန်း တနိုင်ငံ၌ ထာဝရဘုရား ၏ သီချင်း ကို အဘယ်သို့ ဆို ရပါမည်နည်း။"]},{"type":"verse","number":5,"content":["အိုယေရုရှလင် မြို့၊ သင့် ကို ငါမေ့ လျှင် ငါ့ လက်ျာ လက်သည် မိမိအတတ်ကိုမေ့ ပါစေ။"]},{"type":"verse","number":6,"content":["သင့် ကိုငါမ အောက်မေ့ ၊ အမြတ် ဆုံးသော ဝမ်းမြောက် ခြင်းအကြောင်း ထက်၊ ယေရုရှလင် မြို့ကို အမြတ် မ ထားလျှင် ၊ ငါ့ လျှာ သည် အာခေါင် ၌ ထပ် ပါစေ။"]},{"type":"verse","number":7,"content":["အိုထာဝရဘုရား ၊ ယေရုရှလင် မြို့၏ နေ့ရက်အချိန်ရောက်သောအခါ၊ မြို့ရိုး ကို အမြစ် တိုင်အောင် ရှင်း လိုက်ကြ၊ ရှင်း လိုက်ကြဟု ဆို ကြသော ဧဒုံ အမျိုးသား တို့ကို အောက်မေ့ တော်မူပါ။"]},{"type":"verse","number":8,"content":["ဖျက်ဆီး တတ်သော ဗာဗုလုန် မင်းသမီး ၊ သင် သည် ငါ တို့၌ ပြု သည်အတိုင်း ၊ သင် ၌ အပြစ် ကိုဆပ်ပေး သောသူ သည် မင်္ဂလာ ရှိ၏။"]},{"type":"verse","number":9,"content":["သင် ၏သူငယ် တို့ကိုကိုင်ယူ ၍ ၊ ကျောက် ပေါ် မှာ ဆောင့် သောသူသည် မင်္ဂလာ ရှိ၏။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_jvb/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_jvb/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_jvb/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}