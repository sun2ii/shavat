{"translation":{"id":"mya_jvb","name":"မြန်မာကျမ်းစာ","website":"https://ebible.org/Scriptures/details.php?id=myajvb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=myajvb","licenseNotes":null,"shortName":"JVB","englishName":"Judson Burmese Bible","language":"mya","textDirection":"ltr","sha256":"ded586b0c99fd77f0a6fc6709e7c5032181d5b8e33f61b16656fbd45ce3101d2","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_jvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_jvb","name":"ဆာလံကျမ်း","commonName":"ဆာလံကျမ်း","title":"ဆာလံကျမ်း","order":19,"numberOfChapters":150,"sha256":"3fe29b959d800ec0d34719cfbd4ce2a11f3d3a06bc8ca729838924502bce0990","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_jvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_jvb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":["အိုငါ့ ဝိညာဉ် ၊ ထာဝရဘုရား ကိုချီးမွမ်း လော့။"]},{"type":"verse","number":2,"content":["ငါ သည် အသက်ရှင် စဉ်အခါ ၊ ထာဝရဘုရား ကို ချီးမွမ်း မည်။ ငါ ဖြစ်စဉ် ကာလ ပတ်လုံး၊ ငါ ၏ဘုရား သခင်ကို ထောမနာသီချင်း ဆိုမည်။"]},{"type":"verse","number":3,"content":["မင်း များမှစ၍ မကယ်တင် နိုင်သော လူသား ကို မ ကိုးစား ကြနှင့်။"]},{"type":"verse","number":4,"content":["သူ သည်အသက် ထွက် ၍ မြေ သို့ ပြန် သွားတတ် ၏။ ထို နေ့ခြင်းတွင်၊ သူ ၏အကြံ အစည်တို့သည် ပျက်စီး ကြ၏။"]},{"type":"verse","number":5,"content":["ယာကုပ် အမျိုး၏ ဘုရား သခင်မစ တော်မူသောသူ၊ မိမိ ဘုရား သခင် ထာဝရဘုရား ကို မြော်လင့် သောသူသည် မင်္ဂလာ ရှိ၏။"]},{"type":"verse","number":6,"content":["ထိုဘုရားသခင်သည် ကောင်းကင် ၊ မြေကြီး ၊ သမုဒ္ဒရာ နှင့်တကွ အရပ်ရပ် ၌ ရှိသမျှတို့ကို ဖန်ဆင်း တော်မူ၏။ သစ္စာ တော်ကို အစဉ် အမြဲစောင့် တော်မူ၏။"]},{"type":"verse","number":7,"content":["ညှဉ်းဆဲ ခြင်းကိုခံရသောသူတို့ အား တရား ပြု တော်မူ၏။ ငတ်မွတ် သောသူတို့ ကိုကျွေးမွေး တော်မူ၏။ ထာဝရဘုရား သည် ချုပ်ထား ခြင်းကို ခံရသောသူတို့ကို လွှတ် တော်မူ၏။"]},{"type":"verse","number":8,"content":["ထာဝရဘုရား သည် မျက်စိ ကန်းသောသူတို့ကို မြင် စေတော်မူ၏။ ထာဝရဘုရား သည် နှိမ့်ချ သောသူတို့ ကို ကြွ ပင့်တော်မူ၏။ ထာဝရဘုရား သည် ဖြောင့်မတ် သောသူတို့ ကို ချစ် တော်မူ၏။"]},{"type":"verse","number":9,"content":["ထာဝရဘုရား သည် ဧည့်သည် တို့ကို စောင့်မ တော်မူ၍ ၊ မုတ်ဆိုးမ နှင့်မိဘ မရှိသောသူတို့ ကို ထောက်မတော်မူ၏။ မ တရားသောသူတို့၏ လမ်း ကိုကား ၊ ကွေ့ကောက် စေတော်မူ၏။"]},{"type":"verse","number":10,"content":["အိုဇိအုန် မြို့၊ သင် ၏ဘုရား သခင် တည်း ဟူသော ထာဝရဘုရား သည် ကာလ အစဉ်အမြဲ ကမ္ဘာ အဆက်ဆက်စိုးစံ တော်မူ လတံ့ သတည်း။ ဟာလေလုယ။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_jvb/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_jvb/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_jvb/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}