{"translation":{"id":"mya_jvb","name":"မြန်မာကျမ်းစာ","website":"https://ebible.org/Scriptures/details.php?id=myajvb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=myajvb","licenseNotes":null,"shortName":"JVB","englishName":"Judson Burmese Bible","language":"mya","textDirection":"ltr","sha256":"ded586b0c99fd77f0a6fc6709e7c5032181d5b8e33f61b16656fbd45ce3101d2","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_jvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_jvb","name":"ဆာလံကျမ်း","commonName":"ဆာလံကျမ်း","title":"ဆာလံကျမ်း","order":19,"numberOfChapters":150,"sha256":"3fe29b959d800ec0d34719cfbd4ce2a11f3d3a06bc8ca729838924502bce0990","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_jvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_jvb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":["အိုထာဝရဘုရား ၊ တဲ တော်၌ အဘယ်သူ သည် တည်း ရပါမည်နည်း။ သန့်ရှင်း သောတောင် တော်ပေါ် မှာ အဘယ်သူ သည် နေ ရပါမည်နည်းဟူမူကား၊"]},{"type":"verse","number":2,"content":["ဖြောင့်မတ် သောအကျင့်၊ တရား သောအမှုကို ပြု ကျင့်၍ ၊ သစ္စာ စကားကို စိတ် နှလုံးပါလျက်ပြော ထသော၊"]},{"type":"verse","number":3,"content":["သူတပါး၏အသရေ ကို ပျက်စေခြင်းငှါ ပြောဆို ခြင်း၊ ကိုယ် နှင့်စပ်ဆိုင်သောသူ၏ အကျိုးကိုပြစ်မှားခြင်း၊ ကိုယ် နှင့်စပ်ဆိုင်သော သူကိုလည်း ကဲ့ရဲ့ ခြင်းကို ရှောင်ထ သော၊"]},{"type":"verse","number":4,"content":["ဆိုးယုတ် သောသူကို အယုတ် ဟူ၍ ထင် မှတ်လျက် ၊ ထာဝရ ဘုရားအား ကြောက်ရွံ့ သောသူကို ရိုသေ ထသော၊ ကိုယ်အကျိုး ပျက်ရသော်လည်း ကိုယ်ကျိန်ဆို သော သစ္စာဂတိကိုမ ဖျက်၊"]},{"type":"verse","number":5,"content":["ကိုယ် ငွေ ကို ချေး ၍ အတိုး မ ယူ၊ အပြစ် မရှိသောသူ ၏တဘက် မှ တံစိုး ကို မ ခံ ဘဲကျင့် သောသူသည် လှုပ်ရှား ခြင်းနှင့် အစဉ် အမြဲကင်းလွတ် လိမ့်မည်သတည်း။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_jvb/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/m