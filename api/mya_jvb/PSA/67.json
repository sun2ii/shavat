{"translation":{"id":"mya_jvb","name":"မြန်မာကျမ်းစာ","website":"https://ebible.org/Scriptures/details.php?id=myajvb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=myajvb","licenseNotes":null,"shortName":"JVB","englishName":"Judson Burmese Bible","language":"mya","textDirection":"ltr","sha256":"ded586b0c99fd77f0a6fc6709e7c5032181d5b8e33f61b16656fbd45ce3101d2","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_jvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_jvb","name":"ဆာလံကျမ်း","commonName":"ဆာလံကျမ်း","title":"ဆာလံကျမ်း","order":19,"numberOfChapters":150,"sha256":"3fe29b959d800ec0d34719cfbd4ce2a11f3d3a06bc8ca729838924502bce0990","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_jvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_jvb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"verse","number":1,"content":["ဘုရား သခင်သည် အကျွန်ုပ် တို့ကို သနားခြင်း ကရုဏာစိတ်တော်ရှိသဖြင့် ၊ ကောင်းကြီး ပေး၍ မျက်နှာ တော်၏အလင်း ကို လွှတ်တော်မူပါစေသော။"]},{"type":"verse","number":2,"content":["ထိုသို့သောအားဖြင့် မြေကြီး သားတို့သည် အမှု တော်တို့ကို သိ ၍ ၊ ခပ်သိမ်း သော လူမျိုး တို့သည် ကယ်တင် တော်မူခြင်း ကျေးဇူးကိုခံ ရကြပါစေသော။"]},{"type":"verse","number":3,"content":["အို ဘုရား သခင်၊ လူ များတို့သည် ကိုယ်တော် ကို ချီးမွမ်း ကြပါစေသော။ လူ များအပေါင်း တို့သည် ကိုယ်တော် ကို ချီးမွမ်း ကြပါစေသော။"]},{"type":"verse","number":4,"content":["လူ အမျိုးမျိုးတို့သည် ဝမ်းမြောက် ၍ ရွှင်လန်း စွာ သီချင်းဆိုကြပါစေသော။ အကြောင်း မူကား၊ ကိုယ်တော်သည် လူ တို့ကို ဖြောင့်မတ် စွာ တရား စီရင်၍ ၊ မြေကြီး ပေါ် မှာ ရှိသောလူမျိုး တို့ကို ချမ်းသာ ပေးတော်မူမည်။"]},{"type":"verse","number":5,"content":["အို ဘုရား သခင်၊ လူ များတို့သည် ကိုယ်တော် ကို ချီးမွမ်း ကြပါစေသော။ လူ များအပေါင်း တို့သည် ကိုယ်တော် ကို ချီးမွမ်း ကြပါစေသော။"]},{"type":"verse","number":6,"content":["မြေ သည် မိမိ ဘဏ္ဍာ ကို ပေး ၍၊ ဘုရား သခင်တည်းဟူသောငါ တို့၏ဘုရား သခင်သည် ငါ တို့ကို ကောင်းကြီး ပေးတော်မူ၏။"]},{"type":"verse","number":7,"content":["ဘုရား သခင်သည် ငါ တို့ကို ကောင်းကြီး ပေးတော်မူဦးမည်။ မြေကြီး စွန်း အပေါင်း တို့သည်လည်း ၊ ဘုရား သခင်ကို ကြောက်ရွံ့ ကြလိမ့်မည်။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_jvb/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_jvb/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_jvb/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}