"verse","number":8,"content":["အိုဘုရား သခင်၊ ထ ၍မြေကြီး ကို တရားစီရင် တော်မူပါ။ ကိုယ်တော် သည် လူမျိုး အပေါင်း တို့ကို အပိုင် ရတော်မူ၏။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_jvb/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_jvb/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_jvb/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}