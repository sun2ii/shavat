{"translation":{"id":"mya_jvb","name":"မြန်မာကျမ်းစာ","website":"https://ebible.org/Scriptures/details.php?id=myajvb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=myajvb","licenseNotes":null,"shortName":"JVB","englishName":"Judson Burmese Bible","language":"mya","textDirection":"ltr","sha256":"ded586b0c99fd77f0a6fc6709e7c5032181d5b8e33f61b16656fbd45ce3101d2","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_jvb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_jvb","name":"ဆာလံကျမ်း","commonName":"ဆာလံကျမ်း","title":"ဆာလံကျမ်း","order":19,"numberOfChapters":150,"sha256":"3fe29b959d800ec0d34719cfbd4ce2a11f3d3a06bc8ca729838924502bce0990","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_jvb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_jvb/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"verse","number":1,"content":["ဘုံ ဗိမာန ်တော်တိုက်မြစ် သည် သန့်ရှင်း သော တောင် ရိုးပေါ် မှာ တည်လျက်ရှိ၏။"]},{"type":"verse","number":2,"content":["ထာဝရဘုရား သည် ယာကုပ် ၏ နေရာ အပေါင်း တို့ထက် ဇိအုန် တံခါး တို့ကို သာ၍နှစ်သက် တော်မူ၏။"]},{"type":"verse","number":3,"content":["အိုဘုရား သခင်၏ မြို့ တော်၊ သင် သည် ဘုန်း အသရေကြီးလိမ့်မည်ဟူသောစကားကို ပြော ထားလျက် ရှိ၏။"]},{"type":"verse","number":4,"content":["ငါ့ ကိုသိကျွမ်း သောသူတို့ တွင် ၊ ရာခပ် မြို့နှင့် ဗာဗုလုန် မြို့ကို ငါမှတ် ထားမည်။ ဖိလိတ္တိ ပြည်၊ တုရု ပြည်၊ ကုရှ ပြည်တို့ကိုလည်း ကြည့် ကြလော့။ ဤ မည်သော ပြည်သားသည် မြို့ တော်၌ ဘွားမြင် သောသူဖြစ်၏။"]},{"type":"verse","number":5,"content":["ဇိအုန် မြို့ကို လည်း လူ အမျိုးမျိုးတို့သည်၊ ထိုမြို့ ၌ ဘွားမြင် ကြပြီ။ အမြင့်ဆုံး သောဘုရားသည် ထိုမြို့ ကို ကိုယ်တော်တိုင် မြဲမြံ စေတော်မူပြီဟု ပြော ဆိုကြလိမ့်မည်။"]},{"type":"verse","number":6,"content":["ထာဝရဘုရား သည် လူမျိုး တို့ကို စာရင်း ယူတော်မူ သောအခါ ၊ ဤမည်သော အမျိုးသည် မြို့တော်၌ ဘွားမြင်သောအမျိုးဖြစ်သည်ဟု မှတ်တော်မူမည်။"]},{"type":"verse","number":7,"content":["သီချင်း သည်နှင့် ပွဲသဘင်ခံသောသူ အစရှိသော ငါ၏ပျော်မွေ့ခြင်းအကြောင်းရှိသမျှ တို့သည် သင် ၌ ရှိကြ သတည်း။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_jvb/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_jvb/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_jvb/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}