{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"1CH","translationId":"mya_ojv","name":"၁ ရာ​ချုပ်","commonName":"၁ ရာ​ချုပ်","title":"ရာ​ဇ​ဝင်​ချုပ်​ပ​ထ​မ​စောင်","order":13,"numberOfChapters":29,"sha256":"33f803075b06753fb06ace3df31ebeaf3ba6b0b2a3cefbd64d63164282adb95e","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/mya_ojv/1CH/29.json","totalNumberOfVerses":745},"chapter":{"number":17,"content":[{"type":"heading","content":["ဒါ​ဝိဒ်​မင်း​အား​ပ​ရော​ဖက်​နာ​သန်​ဖော်​ပြ​သည့် ဗျာ​ဒိတ်​တော်"]},{"type":"verse","number":1,"content":["ယ​ခု​အ​ခါ​ဒါ​ဝိဒ်​မင်း​သည် မိ​မိ​နန်း​တော်​တွင် စံ​မြန်း​လျက်​နေ​တော်​မူ​လေ​ပြီ။ တစ်​နေ့​သ​၌ သူ​သည်​ပ​ရော​ဖက်​နာ​သန်​အား​ခေါ်​ပြီး​လျှင်``ငါ သည်​အာ​ရစ်​သား​နှင့်​တည်​ဆောက်​သော​နန်း​တော် တွင်​စံ​နေ​ရ​၏။ ဘု​ရား​သ​ခင်​၏​ပ​ဋိ​ညာဉ် သေတ္တာ​တော်​မူ​ကား တဲ​တော်​၌​ပင်​ရှိ​နေ​ပေ သည်'' ဟု​မိန့်​တော်​မူ​၏။"]},{"type":"verse","number":2,"content":["နာ​သန်​က``အ​ကြံ​အ​စည်​တော်​ရှိ​သည့်​အ​တိုင်း ပြု​တော်​မူ​ပါ။ ဘု​ရား​သ​ခင်​သည်​အ​ရှင်​မင်း ကြီး​နှင့်​အ​တူ​ရှိ​တော်​မူ​ပါ​၏'' ဟု​လျှောက်​၏။"]},{"type":"verse","number":3,"content":["သို့​ရာ​တွင်​ထို​ည​၌​ဘု​ရား​သ​ခင်​သည်​နာ​သန် အား၊"]},{"type":"verse","number":4,"content":["``ငါ​၏​အ​စေ​ခံ​ဒါ​ဝိဒ်​ထံ​သို့​သွား​၍​သူ​သည် ငါ​ကျိန်း​ဝပ်​ရန်​ဗိ​မာန်​တော်​ကို​တည်​ဆောက် ရ​မည့်​သူ​မ​ဟုတ်​ကြောင်း​ပြော​ကြား​လော့။-"]},{"type":"verse","number":5,"content":["ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​ကို​အီ​ဂျစ်​ပြည်​မှ ထု