{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"1CH","translationId":"mya_ojv","name":"၁ ရာ​ချုပ်","commonName":"၁ ရာ​ချုပ်","title":"ရာ​ဇ​ဝင်​ချုပ်​ပ​ထ​မ​စောင်","order":13,"numberOfChapters":29,"sha256":"33f803075b06753fb06ace3df31ebeaf3ba6b0b2a3cefbd64d63164282adb95e","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/mya_ojv/1CH/29.json","totalNumberOfVerses":745},"chapter":{"number":3,"content":[{"type":"heading","content":["ဒါ​ဝိဒ်​မင်း​၏​သား​သ​မီး​များ"]},{"type":"verse","number":1,"content":["ဟေ​ဗြုန်​မြို့​တွင်​ဒါ​ဝိဒ်​မင်း​နန်း​စံ​စဉ်​အ​ခါ ရ​ရှိ​သော​သား​များ​ကား ကြီး​စဉ်​ငယ်​လိုက် အောက်​ပါ​အ​တိုင်း​ဖြစ်​၏။",{"text":"ယေ​ဇ​ရေ​လ​မြို့​သူ​အ​ဟိ​နောင်​က​မွေး​သော သား​အာ​မ​နုန်၊","poem":1},{"lineBreak":true},{"text":"က​ရ​မေ​လ​မြို့​သူ​အ​ဘိ​ဂဲ​လ​က​မွေး​သော သား​ဒံ​ယေ​လ၊","poem":1},{"lineBreak":true},{"text":"ဂေ​ရှု​ရ​ဘု​ရင်​တာ​လ​မဲ​၏​သ​မီး​မာ​ခါ​က မွေး​သော​သား​အ​ဗ​ရှ​လုံ၊","poem":1},{"lineBreak":true},{"text":"ဟ္ဂိတ်​က​မွေး​သော​သား​အ​ဒေါ​နိ​ယ၊ အ​ဘိ တ​လ​က​မွေး​သော​သား​ရှေ​ဖ​တိ၊","poem":1},{"lineBreak":true},{"text":"ဧ​ဂ​လ​မွေး​သော​သား​ဣ​သ​ရံ။","poem":1}]},{"type":"verse","number":4,"content":["ဒါ​ဝိဒ်​မင်း​သည်​ဟေ​ဗြုန်​မြို့​တွင်​ခု​နစ်​နှစ်​နှင့် ခြောက်​လ​နန်း​စံ​တော်​မူ​စဉ် ဤ​သား​ခြောက် ပါး​စ​လုံး​ကို​ရ​ရှိ​သ​တည်း။ သူ​သည်​ယေ​ရု​ရှ​လင်​မြို့​တွင်​သုံး​ဆယ့်​သုံး နှစ်​နန်း​စံ​တော်​မူ​၍၊-"]},{"type":"verse","number":5,"content":["သား​များ​ထပ်​မံ​၍​ရ​ရှိ​လေ​သည်။ အ​မျေ​လ​၏​သ​မီး​ဗာ​သ​ရှေ​ဘ​သည်​ရှမွာ၊ ရှော​ဗပ်၊ နာ​သန်​နှင့်​ရှော​လ​မုန်​ဟူ​သော​သား တော်​လေး​ပါး​ကို​မွေး​ဖွား​၏။"]},{"type":"verse","number":6,"content":["ဒါ​ဝိဒ်​မင်း​တွင်​ဣ​ဗ​ဟာ၊ ဧ​လိ​ရွှ၊ ဧ​လိ​ပ​လက်၊ နော​ဂ၊ နေ​ဖက်၊ ယာ​ဖျာ၊ ဧ​လိ​ရှ​မာ၊ ဧ​လျာ​ဒ၊ ဧ​လိ​ဖ​လက်​ဟူ​၍​အ​ခြား​သား​တော်​ကိုး ပါး​ရှိ​၏။-"]},{"type":"verse","number":9,"content":["ဤ​သား​များ​အ​ပြင်​မောင်း​မ​တော်​များ​နှင့်​ရ​ရှိ သည့်​သား​များ​ရှိ​သေး​သည်။ သူ့​မှာ​တာ​မာ​နာ မည်​တွင်​သော​သ​မီး​တော်​တစ်​ပါး​လည်း​ရှိ​၏။"]},{"type":"heading","content":["ရှော​လ​မုန်​မင်း​၏​သား​မြေး​များ"]},{"type":"verse","number":10,"content":["အ​ဖ​အ​မည်​နှင့်​သား​အ​မည်​မျိုး​ရိုး​စဉ်​ဆက်​မှာ ရှော​လ​မုန်၊ ရော​ဗောင်၊ အ​ဘိ​ယ၊ အာ​သံ၊ ယော​ရှ​ဖတ်၊ ယော​ရံ၊ အာ​ခ​ဇိ၊ ယော​ရှ၊ အာ​မ​ဇိ၊ သြ​ဇိ၊ ယော​သံ၊ အာ​ခတ်၊ ဟေ​ဇ​ကိ၊ မ​နာ​ရှေ၊ အာ​မုန်၊ ယော​ရှိ​တည်း။-"]},{"type":"verse","number":15,"content":["ယော​ရှိ​တွင်​ယော​ဟာ​နန်၊ ယော​ယ​ကိမ်၊ ဇေ​ဒ​ကိ နှင့် ရှလ္လုံ​ဟူ​၍​သား​တော်​လေး​ပါး​ရှိ​၏။-"]},{"type":"verse","number":16,"content":["ယော​ယ​ကိမ်​တွင်​ယေ​ခေါ​နိ​နှင့် ဇေ​ဒ​ကိ​ဟူ သော​သား​တော်​နှစ်​ပါး​ရှိ​၏။"]},{"type":"heading","content":["ယေ​ခေါ​နိ​မင်း​၏​သား​မြေး​များ"]},{"type":"verse","number":17,"content":["ဗာ​ဗု​လုန်​အ​မျိုး​သား​တို့​ဖမ်း​ဆီး​ထိန်း​သိမ်း သွား​သည့် ယေ​ခေါ​နိ​မင်း​တွင်​သား​တော်​ခု​နစ် ပါး​ရှိ​၏။ ထို​မင်း​၏​သား​များ​မှာ​ရှာ​လ သေ​လ၊-"]},{"type":"verse","number":18,"content":["မာ​လ​ခိ​ရံ၊ ပေ​ဒါ​ယ၊ ရှေ​န​ဇာ၊ ယေ​က​မိ၊ ဟော​ရှ​မ၊ နေ​ဒ​ဘိ​တို့​ဖြစ်​၏။-"]},{"type":"verse","number":19,"content":["ပေ​ဒါ​ယ​တွင်​ဇေ​ရု​ဗ​ဗေ​လ​နှင့် ရှိ​မိ​ဟူ​သော သား​တော်​နှစ်​ပါး​ရှိ​၏။ ဇေ​ရု​ဗ​ဗေ​လ​တွင် မေ​ရှု​လံ​နှင့်​ဟာ​န​နိ​ဟူ​သော​သား​တော်​နှစ် ပါး​နှင့် ရှေ​လော​မိတ်​ဟူ​သော​သ​မီး​တော် တစ်​ပါး​ရှိ​၏။-"]},{"type":"verse","number":20,"content":["ထို့​ပြင်​ဟ​ရှု​ဘ၊ သြ​ဟေ​လ၊ ဗေ​ရ​ခိ၊ ဟ​သ​ဒိ၊ ယု​ရှ​ဿေ​သက်​ဟူ​၍​အခြား​သား​တော်​ငါး ပါး​လည်း​ရှိ​၏။"]},{"type":"verse","number":21,"content":["ဟာ​န​နိ​တွင်​ပေ​လ​တိ​နှင့်​ယေ​ရှာ​ယ​ဟူ သော​သား​တော်​နှစ်​ပါး​ရှိ​၏။ ယေ​ရှာ​ယ​၏ သား​သည်​ရေ​ဖာ​ယ၊ ရေ​ဖာ​ယ​၏​သား​မှာ အာ​နန်၊ အာ​နန်​၏​သား​ကား​သြ​ဗ​ဒိ၊ သြ​ဗ​ဒိ​၏​သား​သည်​ရှေ​ခ​နိ",{"noteId":0},"တည်း။-"]},{"type":"verse","number":22,"content":["ရှေ​ခ​နိ​တွင်​ရှေ​မာ​ယ​ဟူ​သော​သား​တော် တစ်​ပါး​နှင့် ဟတ္တုတ်၊ ဣ​ဂါ​လ၊ ဗာ​ရိ၊ နာ​ရိ၊ အာ​ဇ​ရိ၊ ရှာ​ဖတ်​ဟူ​သော​မြေး​တော် ခြောက်​ပါး​ရှိ​၏။-"]},{"type":"verse","number":23,"content":["နာ​ရိ​တွင်​ဧ​လိ​သြ​နဲ၊ ဟေ​ဇ​ကိ၊ အာ​ဇ​ရိ​ကံ ဟူ​၍​သား​တော်​သုံး​ပါး​ရှိ​၏။-"]},{"type":"verse","number":24,"content":["ဧ​လိ​သြ​နဲ​တွင်​ဟော​ဒါ​ယ၊ ဧ​လျာ​ရှိပ်၊ ပေ လာ​ယ၊ အက္ကုပ်၊ ယော​ဟန်၊ ဒ​လာ​ယ၊ အာ​န​နိ ဟူ​၍​သား​တော်​ခု​နစ်​ပါး​ရှိ​သ​တည်း။"]}],"footnotes":[{"noteId":0,"caller":"1","text":"* အ​ခန်း​ငယ် ၂၁ ဟေ​ဗြဲ​မူ​တွင်​မ​ရှင်း​ပါ။","reference":{"chapter":3,"verse":21}}]},"thisChapterLink":"/api/mya_ojv/1CH/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/1CH/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/1CH/2.json","previousChapterAudioLinks":{},"numberOfVerses":16}