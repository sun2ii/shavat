{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"1CH","translationId":"mya_ojv","name":"၁ ရာ​ချုပ်","commonName":"၁ ရာ​ချုပ်","title":"ရာ​ဇ​ဝင်​ချုပ်​ပ​ထ​မ​စောင်","order":13,"numberOfChapters":29,"sha256":"33f803075b06753fb06ace3df31ebeaf3ba6b0b2a3cefbd64d63164282adb95e","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/mya_ojv/1CH/29.json","totalNumberOfVerses":745},"chapter":{"number":6,"content":[{"type":"heading","content":["ယဇ်​ပု​ရော​ဟိတ်​မင်း​များ​၏​ဆွေ​တော်​စဉ် မျိုး​တော်​ဆက်​စာ​ရင်း"]},{"type":"verse","number":1,"content":["လေ​ဝိ​တွင်​ဂေ​ရ​ရှုံ၊ ကော​ဟတ်၊ မေ​ရာ​ရိ​ဟူ​၍ သား​သုံး​ယောက်​ရှိ​၏။"]},{"type":"verse","number":2,"content":["ကော​ဟတ်​တွင်​အာ​မ​ရံ၊ ဣ​ဇ​ဟာ၊ ဟေ​ဗြုန်၊ သြ​ဇေ​လ​ဟူ​၍​သား​လေး​ယောက်​ရှိ​၏။"]},{"type":"verse","number":3,"content":["အာ​မ​ရံ​တွင်​အာ​ရုန်၊ မော​ရှေ​ဟူ​သော​သား နှစ်​ယောက်​နှင့်​မိ​ရိ​အံ​ဟူ​သော​သ​မီး​တစ် ယောက်​ရှိ​၏။ အာ​ရုန်​တွင်​နာ​ဒပ်၊ အ​ဘိ​ဟု၊ ဧ​လာ​ဇာ နှင့်​ဣ​သ​မာ​ဟူ​၍​သား​လေး​ယောက်​ရှိ​၏။"]},{"type":"verse","number":4,"content":["အ​ဖ​နှင့်​သား​နာ​မည်​များ​အ​စဉ်​လိုက်​အ​တိုင်း ဧ​လ​ဇာ​၏​သား​မြေး​စာ​ရင်း​မှာ​ဧ​လ​ဇာ၊ ဖိ​န​ဟတ်၊ အ​ဘိ​ရွှ၊ ဗုက္ကိ၊ သြ​ဇိ၊ ဇေ​ရ​ဟိ၊ မေ​ရာ​ယုတ်၊ အာ​မ​ရိ၊ အ​ဟိ​တုပ်၊-"]},{"type":"verse","number":8,"content":["ဇာ​ဒုတ်၊ အ​ဟိ​မတ်၊-"]},{"type":"verse","number":9,"content":["အာ​ဇ​ရိ၊ ယော​ဟနန်​ဟူ​၍​လည်း​ကောင်း၊"]},{"type":"verse","number":10,"content":["(ရှော​လ​မုန်​မင်း​ယေ​ရု​ရှ​လင်​မြို့​တွင်​တည်