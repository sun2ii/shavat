{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"1CH","translationId":"mya_ojv","name":"၁ ရာ​ချုပ်","commonName":"၁ ရာ​ချုပ်","title":"ရာ​ဇ​ဝင်​ချုပ်​ပ​ထ​မ​စောင်","order":13,"numberOfChapters":29,"sha256":"33f803075b06753fb06ace3df31ebeaf3ba6b0b2a3cefbd64d63164282adb95e","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/mya_ojv/1CH/29.json","totalNumberOfVerses":745},"chapter":{"number":7,"content":[{"type":"heading","content":["ဣ​သ​ခါ​၏​သား​မြေး​များ"]},{"type":"verse","number":1,"content":["ဣ​သ​ခါ​တွင်​တော​လ၊ ဖု​ဝါ၊ ယာ​ရှုပ်၊ ရှိ​မ​ရုန် ဟူ​၍​သား​လေး​ယောက်​ရှိ​၏။"]},{"type":"verse","number":2,"content":["တော​လ​တွင်​သြ​ဇိ၊ ရေ​ဖာ​ယ၊ ယေ​ရေ​လ၊ ယာ​မဲ၊ ယိ​ဗ​သံ၊ ရှ​မွေ​လ​ဟူ​၍​သား​ခြောက်​ယောက်​ရှိ ၏။ ထို​သူ​တို့​သည်​တော​လ​သား​ချင်း​စု​၏ ဦး​စီး​ခေါင်း​ဆောင်​များ၊ ထင်​ပေါ်​ကျော်​စော သော​စစ်​သူ​ရဲ​များ​ဖြစ်​ကြ​၏။ သူ​တို့​၏​သား မြေး​ဦး​ရေ​သည်​ဒါ​ဝိဒ်​မင်း​၏​လက်​ထက်​၌ နှစ်​သောင်း​နှစ်​ထောင်​ခြောက်​ရာ​ရှိ​သ​တည်း။"]},{"type":"verse","number":3,"content":["သြ​ဇိ​တွင်​ဣ​ဇ​ရ​ဟိ​ဟူ​သော​သား​တစ် ယောက်​ရှိ​၏။ ဣ​ဇ​ရ​ဟိ​နှင့်​သူ​၏​သား​များ ဖြစ်​ကြ​သော​မိက္ခေ​လ၊ သြ​ဗ​ဒိ၊ ယော​လ၊ ဣ​ရှ​ယ​တို့​သည်​အိမ်​ထောင်​ဦး​စီး​များ ဖြစ်​ကြ​၏။-"]},{"type":"verse","number":4,"content":["သူ​တို့​တွင်​သား​မယား​အ​များ​အ​ပြား​ရှိ သော​ကြောင့် သူ​တို့​၏​သား​မြေး​များ​မှ​စစ် မှု​ထမ်း​ရန်​လူ​ပေါင်း​သုံး​သောင်း​ခြောက် ထောင်​ရ​ရှိ​နိုင်​လေ​သည်။"]},{"type":"verse","number":5,"content":["အ​စိုး​ရ​မှတ်