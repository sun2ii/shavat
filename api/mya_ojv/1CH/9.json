{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"1CH","translationId":"mya_ojv","name":"၁ ရာ​ချုပ်","commonName":"၁ ရာ​ချုပ်","title":"ရာ​ဇ​ဝင်​ချုပ်​ပ​ထ​မ​စောင်","order":13,"numberOfChapters":29,"sha256":"33f803075b06753fb06ace3df31ebeaf3ba6b0b2a3cefbd64d63164282adb95e","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/mya_ojv/1CH/29.json","totalNumberOfVerses":745},"chapter":{"number":9,"content":[{"type":"heading","content":["ဖမ်း​ဆီး​သိမ်း​ယူ​သွား​ခြင်း​ခံ​ရ​ရာ​မှ ပြန်​လာ​သူ​များ"]},{"type":"verse","number":1,"content":["ဣ​သ​ရေ​လ​ပြည်​သူ​အ​ပေါင်း​တို့​အား​အိမ် ထောင်​စု​များ​အ​လိုက်​စာ​ရင်း​ပြု​လုပ်​ထား ကြောင်း ဣ​သ​ရေ​လ​ဘု​ရင်​များ​ကျမ်း​တွင် မှတ်​တမ်း​တင်​၍​ထား​လေ​သည်။ ယု​ဒ​ပြည်​သား​တို့​သည်​မိ​မိ​တို့​၏​အ​ပြစ် များ​ကြောင့် ဗာ​ဗု​လုန်​ပြည်​သို့​ပြည်​နှင်​ဒဏ် အ​ပေး​ခံ​ရ​ကြ​၏။-"]},{"type":"verse","number":2,"content":["ပ​ထ​မ​ဦး​ဆုံး​မိ​မိ​တို့​၏​ဘိုး​ဘွား​ပိုင်​မြို့ ရွာ​များ​သို့​ပြန်​လည်​ရောက်​ရှိ​လာ​ကြ​သူ များ​အ​ထဲ​တွင် ဣ​သ​ရေ​လ​အ​မျိုး​သား ဝတ်​ကြောင်​များ၊ ယဇ်​ပု​ရော​ဟိတ်​များ၊ လေ​ဝိ အ​နွယ်​ဝင်​များ​နှင့်​ဗိ​မာန်​တော်​အ​လုပ် သ​မား​များ​ပါ​ဝင်​လေ​သည်။-"]},{"type":"verse","number":3,"content":["ယု​ဒ၊ ဗင်္ယာ​မိန်၊ ဧ​ဖ​ရိမ်​နှင့်​မ​နာ​ရှေ​အ​နွယ် ဝင်​တို့​သည် ယေ​ရု​ရှ​လင်​မြို့​သို့​သွား​ရောက် နေ​ထိုင်​ကြ​၏။"]},{"type":"verse","number":4,"content":["ယု​ဒ​အ​နွယ်​မှ​အိမ်​ထောင်​စု​ပေါင်း​ခြောက်​ရာ ကိုး​ဆယ်​တို့​သည် ယေ​ရု​ရှ​လင်​မြို့​တွင်​နေ ထိုင်​ကြ