{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"1CO","translationId":"mya_ojv","name":"၁ ကော","commonName":"၁ ကော","title":"ကော​ရိန္သု​သြ​ဝါ​ဒ​စာ ပ​ထ​မ​စာ​စောင်","order":46,"numberOfChapters":16,"sha256":"a3b3c874f8230ccc37243546f8a92e7581c3973b188e54636dcc1771293f7bce","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/1CO/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/mya_ojv/1CO/16.json","totalNumberOfVerses":432},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":["သို့​ဖြစ်​၍​ငါ​သည်​ခ​ရစ်​တော်​ထံ​မှ​အ​တု ယူ​သ​ကဲ့​သို့ သင်​တို့​သည်​ငါ့​ထံ​မှ​အ​တု ယူ​ကြ​လော့။"]},{"type":"heading","content":["ကိုး​ကွယ်​ဝတ်​ပြု​ချိန်​၌​ဦး​ခေါင်း​ကို​ဖုံး​အုပ်​ခြင်း"]},{"type":"verse","number":2,"content":["သင်​တို့​သည်​ငါ့​ကို​အ​စဉ်​အောက်​မေ့​သ​တိ​ရ​၍ ငါ​ပေး​အပ်​ခဲ့​သည့်​သွန်​သင်​ချက်​အ​တိုင်း​လိုက် နာ​ပြု​ကျင့်​ကြ​သော​ကြောင့်​သင်​တို့​အား​ငါ ချီး​ကူး​၏။-"]},{"type":"verse","number":3,"content":["သို့​သော်​ခ​ရစ်​တော်​သည်​ယောကျာ်း​တိုင်း​၏​အ​ထွတ် အ​ထိပ်၊ ယောကျာ်း​သည်​မိန်း​မ​၏​အ​ထွတ်​အ​ထိပ်၊ ဘု​ရား​သ​ခင်​သည်​ခ​ရစ်​တော်​၏​အ​ထွတ်​အ​ထိပ် ဖြစ်​ကြောင်း​ကို​သင်​တို့​အား​သိ​စေ​လို​၏။-"]},{"type":"verse","number":4,"content":["သို့​ဖြစ်​၍​ယောကျာ်း​သည်​ဝတ်​ပြု​အ​စည်း​အ​ဝေး တွင်​မိ​မိ​၏​ဦး​ခေါင်း​ကို​ဖုံး​အုပ်​၍​ပတ္ထ​နာ​ပြု သော်​လည်း​ကောင်း၊ တ​ရား​ဟော​သော်​လည်း​ကောင်း ခ​ရစ်​တော်​၏​အ​သ​ရေ​တော်​ကို​ရှုတ်​ချ​သူ ဖြစ်​၏။-"]},{"type":"verse","number":5,"content":["မိန်း​မ​သည်​စု​ဝေး​ဝတ်​ပြု​ခြင်း​တွင်​မိ​မိ​၏​ဦ