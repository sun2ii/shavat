{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"1CO","translationId":"mya_ojv","name":"၁ ကော","commonName":"၁ ကော","title":"ကော​ရိန္သု​သြ​ဝါ​ဒ​စာ ပ​ထ​မ​စာ​စောင်","order":46,"numberOfChapters":16,"sha256":"a3b3c874f8230ccc37243546f8a92e7581c3973b188e54636dcc1771293f7bce","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/1CO/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/mya_ojv/1CO/16.json","totalNumberOfVerses":432},"chapter":{"number":14,"content":[{"type":"heading","content":["ဝိ​ညာဉ်​တော်​ဆု​ကျေး​ဇူး​များ​အ​ကြောင်း ထပ်​လောင်း​ဖော်​ပြ​ချက်"]},{"type":"verse","number":1,"content":["ထို့​ကြောင့်​သင်​တို့​သည်​မေတ္တာ​တ​ရား​ကို​ကျင့်​သုံး ရန် ကြိုး​ပမ်း​အား​ထုတ်​ကြ​လော့။ ဝိ​ညာဉ်​ဆု​ကျေး​ဇူး များ​ကို​တောင့်​တ​လို​ချင်​ကြ​လော့။ အ​ထူး​သ​ဖြင့် နှုတ်​က​ပတ်​တ​ရား​တော်​ဟော​ပြော​နိုင်​သော​ဆု ကျေး​ဇူး​ကို​လို​လား​ကြ​လော့။-"]},{"type":"verse","number":2,"content":["ထူး​ဆန်း​သော​ဘာ​သာ​စ​ကား​အ​မျိုး​မျိုး​ဖြင့် ပြော​ဆို​သော​သူ​သည်​လူ​နှင့်​ပြော​ဆို​သည် မ​ဟုတ်။ ဘု​ရား​နှင့်​သာ​ပြော​ဆို​ခြင်း​ဖြစ်​၏။ သူ​၏​စ​ကား​ကို​အ​ဘယ်​သူ​မျှ​နား​မ​လည်။ သူ​သည်​ဝိ​ညာဉ်​တော်​တန်​ခိုး​ဖြင့်​လျှို့​ဝှက် နက်​နဲ​သည့်​အ​ကြောင်း​အ​ရာ​များ​ကို​ပြော ဆို​၏။-"]},{"type":"verse","number":3,"content":["သို့​ရာ​တွင်​ဘု​ရား​သ​ခင်​၏​နှုတ်​က​ပတ်​တော်​ကို ဟော​ပြော​သော​သူ​သည်​ကား လူ​တို့​အား​ဆောက် တည်​ရာ​ရ​စေ​သော​စ​ကား၊ အား​ပေး​သော စ​ကား၊ နှစ်​သိမ့်​သော​စ​ကား​တို့​ကို​ပြော​၏။-"]},{"type":"verse","number":4,"content":["ထူး​ဆန်း​သော​ဘာ​သာ​စ​ကား​အ​မျိ