{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"1CO","translationId":"mya_ojv","name":"၁ ကော","commonName":"၁ ကော","title":"ကော​ရိန္သု​သြ​ဝါ​ဒ​စာ ပ​ထ​မ​စာ​စောင်","order":46,"numberOfChapters":16,"sha256":"a3b3c874f8230ccc37243546f8a92e7581c3973b188e54636dcc1771293f7bce","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/1CO/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/mya_ojv/1CO/16.json","totalNumberOfVerses":432},"chapter":{"number":15,"content":[{"type":"heading","content":["ခ​ရစ်​တော်​သေ​ခြင်း​မှ​ရှင်​ပြန်​ထ​မြောက်​ခြင်း"]},{"type":"verse","number":1,"content":["ညီ​အစ်​ကို​တို့၊ သင်​တို့​အား​ငါ​ဟော​ပြော​သည့် သ​တင်း​ကောင်း​ကို​ပြန်​လည်​သ​တိ​ရ​စေ​လို​၏။ ထို​သ​တင်း​ကောင်း​ကို​သင်​တို့​ခံ​ယူ​ကာ​ယင်း အ​ပေါ်​၌ သင်​တို့​၏​ယုံ​ကြည်​ခြင်း​ခိုင်​မြဲ​စွာ အ​မြစ်​စွဲ​လျက်​ရှိ​ပေ​သည်။-"]},{"type":"verse","number":2,"content":["ထို​သ​တင်း​ကောင်း​ကား​သင်​တို့​အား​ငါ​ဟော ပြော​သည့်​တ​ရား​ဖြစ်​သည်။ သင်​တို့​သည်​ထို သ​တင်း​ကောင်း​ကို​စွဲ​မြဲ​စွာ​ယုံ​ကြည်​လက်​ခံ လျှင်​ကယ်​တင်​ခြင်း​ကို​ခံ​ကြ​ရ​၏။ သို့​မ​ဟုတ် လျှင်​သင်​တို့​ယုံ​ကြည်​ခဲ့​သည်​မှာ​အ​ချည်း​နှီး ဖြစ်​သည်။"]},{"type":"verse","number":3,"content":["ငါ​သည်​မိ​မိ​ခံ​ယူ​ရ​ရှိ​၍​သင်​တို့​အား​ပေး အပ်​သည့်​အ​ရေး​ကြီး​လှ​သော​အ​ကြောင်း အ​ရာ​များ​မှာ ကျမ်း​စာ​လာ​သည့်​အ​တိုင်း ခ​ရစ်​တော်​သည်​ငါ​တို့​အ​တွက်​အ​သေ​ခံ တော်​မူ​ကြောင်း၊-"]},{"type":"verse","number":4,"content":["ကိုယ်​တော်​သည်​သင်္ဂြိုဟ်​ခြင်း​ကို​ခံ​ပြီး​နောက် ကျမ်း​စာ​လာ​သည်​အ​တိုင်း​သုံး​ရက်​မြောက် သ