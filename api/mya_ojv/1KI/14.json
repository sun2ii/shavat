{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"1KI","translationId":"mya_ojv","name":"၃ ရာ","commonName":"၃ ရာ","title":"ဋ္ဌမ္မ​ရာ​ဇဝင်​တ​တိ​ယ​စောင်","order":11,"numberOfChapters":22,"sha256":"d72d9788a5ad1d220d41866965c262345043a4a27ce113a77a5f3603c2aaf2af","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/1KI/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/mya_ojv/1KI/22.json","totalNumberOfVerses":792},"chapter":{"number":14,"content":[{"type":"heading","content":["ယေ​ရော​ဗောင်​၏​သား​ကွယ်​လွန်​ခြင်း"]},{"type":"verse","number":1,"content":["ထို​အ​ချိန်​၌​ယေ​ရော​ဗောင်​၏​သား​အ​ဘိ​ယ သည်​ဖျား​နာ​လျက်​နေ​၏။-"]},{"type":"verse","number":2,"content":["ယေ​ရော​ဗောင်​သည်​မိ​မိ​၏​မိ​ဖု​ရား​အား``သင် သည်​မိ​ဖု​ရား​မှန်း​မ​သိ​စေ​ရန်​ရုပ်​ဖျက်​၍ ငါ့ အား​ဣ​သ​ရေ​လ​ဘု​ရင်​ဖြစ်​လိမ့်​မည်​ဟု ဟော​ခဲ့​သူ​ပ​ရော​ဖက်​အ​ဟိ​ယ​နေ​ထိုင် ရာ​ရှိ​လော​မြို့​သို့​သွား​လော့။-"]},{"type":"verse","number":3,"content":["သူ့​အ​တွက်​မုန့်​ဆယ်​လုံး၊ မုန့်​ပြား​အ​ချို့​နှင့် ပျား​ရည်​တစ်​ဘူး​ကို​ယူ​ဆောင်​သွား​ပြီး​လျှင် ငါ​တို့​၏​သား​အ​ဘယ်​သို့​ဖြစ်​မည်​ကို​စုံ​စမ်း မေး​မြန်း​လော့။ သူ​သည်​သင့်​အား​ပြော​ပြ လိမ့်​မည်'' ဟု​ဆို​၏။"]},{"type":"verse","number":4,"content":["သို့​ဖြစ်​၍​မိ​ဖု​ရား​သည် ရှိ​လော​မြို့​ရှိ​အ​ဟိ​ယ ၏​အိမ်​သို့​သွား​လေ​သည်။ အ​ဟိ​ယ​သည် အ​သက်​ကြီး​သ​ဖြင့်​မျက်​စိ​ကွယ်​လျက်​နေ​၏။-"]},{"type":"verse","number":5,"content":["ထာ​ဝ​ရ​ဘု​ရား​က``ယေ​ရော​ဗောင်​၏​မိ​ဖု​ရား သည် ဖျား​နာ​နေ​သော​သား​အ​ကြောင်း​ကို​မေး မြန်း​စုံ​စမ်း​ရ