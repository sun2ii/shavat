{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"1KI","translationId":"mya_ojv","name":"၃ ရာ","commonName":"၃ ရာ","title":"ဋ္ဌမ္မ​ရာ​ဇဝင်​တ​တိ​ယ​စောင်","order":11,"numberOfChapters":22,"sha256":"d72d9788a5ad1d220d41866965c262345043a4a27ce113a77a5f3603c2aaf2af","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/1KI/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/mya_ojv/1KI/22.json","totalNumberOfVerses":792},"chapter":{"number":15,"content":[{"type":"heading","content":["ယု​ဒ​ဘု​ရင်​အ​ဘိ​ယ"]},{"type":"verse","number":1,"content":["ဣ​သ​ရေ​လ​ဘု​ရင်​ယေ​ရော​ဗောင်​နန်း​စံ​တစ် ဆယ့်​ရှစ်​နှစ်​မြောက်​၌ အ​ဘိ​ယ​သည်​ယု​ဒ ပြည်​တွင်​နန်း​တက်​၍၊-"]},{"type":"verse","number":2,"content":["ယေ​ရု​ရှ​လင်​မြို့​၌​သုံး​နှစ်​နန်း​စံ​တော်​မူ​၏။ သူ​၏​မယ်​တော်​မှာ​အ​ဗ​ရှ​လုံ​၏​သ​မီး​မာ​ခါ ဖြစ်​၏။-"]},{"type":"verse","number":3,"content":["အ​ဘိ​ယ​သည်​မိ​မိ​၏​ခ​မည်း​တော်​ကူး​ခဲ့​သည့် အ​ပြစ်​များ​ကို​ဆက်​လက်​၍​ကူး​လွန်​၏။ သူ​သည် မိ​မိ​၏​ဘု​ရား​သ​ခင်​ထာ​ဝ​ရ​ဘု​ရား​အား ဘေး​တော်​ဒါ​ဝိဒ်​ကဲ့​သို့​အ​ကြွင်း​မဲ့​သစ္စာ​မ​စောင့်။-"]},{"type":"verse","number":4,"content":["သို့​ရာ​တွင်​သူ​၏​ဘု​ရား​သ​ခင်​ထာ​ဝ​ရ​ဘု​ရား သည် ဒါ​ဝိဒ်​၏​မျက်​နှာ​ကို​ထောက်​၍​အ​ဘိ​ယ​မ​ရှိ သည့်​နောက်​၌ ယေ​ရု​ရှ​လင်​မြို့​ကို​အုပ်​စိုး​ရန်​နှင့် ယေ​ရု​ရှ​လင်​မြို့​ကို​ဘေး​မဲ့​လုံ​ခြုံ​စွာ​စောင့်​ထိန်း ရန်​သား​တော်​တစ်​ပါး​ကို​ပေး​တော်​မူ​၏။-"]},{"type":"verse","number":5,"content":["အ​ဘယ်​ကြောင့်​ဆို​သော်​ဒါ​ဝိဒ်​သည် ဘု​ရား​သ​ခင် နှစ်​သက်​တော်​မူ​သည့်​အ​မှု​တို့​