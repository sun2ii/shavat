{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"1KI","translationId":"mya_ojv","name":"၃ ရာ","commonName":"၃ ရာ","title":"ဋ္ဌမ္မ​ရာ​ဇဝင်​တ​တိ​ယ​စောင်","order":11,"numberOfChapters":22,"sha256":"d72d9788a5ad1d220d41866965c262345043a4a27ce113a77a5f3603c2aaf2af","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/1KI/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/mya_ojv/1KI/22.json","totalNumberOfVerses":792},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":["ဟာ​နန်​၏​သား​ပ​ရော​ဖက်​ယေ​ဟု​ထံ​သို့၊ ဗာ​ရှာ အား​ဆင့်​ဆို​ရန်၊ ထာ​ဝ​ရ​ဘု​ရား​ထံ​တော်​မှ ဗျာ​ဒိတ်​တော်​ရောက်​ရှိ​လာ​၏။ ``သင်​သည်​မ​ရေ ရာ​သူ​ဖြစ်​ခဲ့​သော်​လည်း ငါ​သည်​သင့်​အား​ငါ ၏​လူ​မျိုး​တော်​ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့ ၏​ခေါင်း​ဆောင်​အ​ဖြစ်​ခန့်​ထား​တော်​မူ​ခဲ့​၏။ သို့​ရာ​တွင်​သင်​သည်​ယေ​ရော​ဗောင်​ကဲ့​သို့​ပင် အ​ပြစ်​ကူး​ပြီး​လျှင် ငါ​၏​လူ​မျိုး​တော်​အား လည်း​အ​ပြစ်​ကူး​ရန်​ရှေ့​ဆောင်​လမ်း​ပြ​ခဲ့ လေ​ပြီ။ သူ​တို့​၏​အ​ပြစ်​များ​သည်​ငါ​၏ အ​မျက်​တော်​ကို​လှုံ့​ဆော်​ပေး​သည်​ဖြစ်​၍၊-"]},{"type":"verse","number":3,"content":["ငါ​သည်​ယေ​ရော​ဗောင်​အား​ပြု​သ​ကဲ့​သို့ သင် နှင့်​သင့်​အိမ်​ထောင်​စု​သား​များ​အား​သုတ် သင်​ပယ်​ရှင်း​ပစ်​မည်။-"]},{"type":"verse","number":4,"content":["မြို့​တွင်​သေ​သူ​သင်​၏​အိမ်​ထောင်​စု​သား​တို့ သည်​ခွေး​စာ၊ မြို့​ပြင်​တွင်​သေ​သူ​သည်​လင်း တ​စာ​ဖြစ်​ကြ​လိမ့်​မည်။''"]},{"type":"verse","number":5,"content":["ဗာ​ရှာ​ဆောင်​ရွက်​ခဲ့​သည့် အ​ခြား​အ​မှု​အ​ရာ များ​ရှိ​သ​မျှ​နှင့် သူ​၏​စွန့်​စား​ခန်း​များ​ကို ဣ​သ​ရေ​လ