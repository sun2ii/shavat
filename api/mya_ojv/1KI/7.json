{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"1KI","translationId":"mya_ojv","name":"၃ ရာ","commonName":"၃ ရာ","title":"ဋ္ဌမ္မ​ရာ​ဇဝင်​တ​တိ​ယ​စောင်","order":11,"numberOfChapters":22,"sha256":"d72d9788a5ad1d220d41866965c262345043a4a27ce113a77a5f3603c2aaf2af","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/1KI/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/mya_ojv/1KI/22.json","totalNumberOfVerses":792},"chapter":{"number":7,"content":[{"type":"heading","content":["ရှော​လ​မုန်​၏​နန်း​တော်"]},{"type":"verse","number":1,"content":["ရှော​လ​မုန်​မင်း​သည်​မိ​မိ​အ​တွက်​နန်း​တော်​ကို တစ်​ဆယ့်​သုံး​နှစ်​နှင့်​အ​ပြီး​သတ်​တည်​ဆောက် တော်​မူ​လေ​သည်။-"]},{"type":"verse","number":2,"content":["လေ​ဗ​နုန်​တော​ခေါ်​ခန်း​မ​ဆောင်",{"noteId":2},"အ​လျား​တစ်​ရာ့​ငါး​ဆယ်​ပေ၊ အ​နံ​ခု​နစ်​ဆယ့် ငါး​ပေ၊ အ​မြင့်​လေး​ဆယ့်​ငါး​ပေ​ရှိ​၏။ ထို ခန်း​မ​ဆောင်​တွင်​သစ်​က​တိုး​သား​တစ်​ဆယ့် ငါး​တိုင်​ရှိ​သော​တိုင်​တန်း​သုံး​တန်း​ရှိ​၏။ ထို တိုင်​များ​ပေါ်​တွင်​သစ်​က​တိုး​သား​ထုပ်​များ တင်​ထား​၏။ မျက်​နှာ​ကျက်​ကို​လည်း​သစ် က​တိုး​သား​ဖြင့်​ပြု​လုပ်​ထား​လေ​သည်။-"]},{"type":"verse","number":4,"content":["နံ​ရံ​နှစ်​ခု​၌​မျက်​နှာ​ချင်း​ဆိုင်​ပြူ​တင်း ပေါက်​သုံး​တန်း​စီ​ရှိ​၏။-"]},{"type":"verse","number":5,"content":["တံ​ခါး​ပေါက်​များ​နှင့်​ပြူ​တင်း​ပေါက်​များ​တွင် ထောင့်​မှန်​စ​တု​ဂံ​ပုံ​သဏ္ဌာန်​တံ​ခါး​ဘောင်​များ ရှိ​၏။"]},{"type":"verse","number":6,"content":["ထောက်​တိုင်​များ​ပါ​သော​ခန်း​မ​ဆောင်​မှာ​အ​လျား ခု​နစ်​ဆယ့်​ငါး​ပေ၊ အ​နံ​လေ