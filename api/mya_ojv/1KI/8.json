{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"1KI","translationId":"mya_ojv","name":"၃ ရာ","commonName":"၃ ရာ","title":"ဋ္ဌမ္မ​ရာ​ဇဝင်​တ​တိ​ယ​စောင်","order":11,"numberOfChapters":22,"sha256":"d72d9788a5ad1d220d41866965c262345043a4a27ce113a77a5f3603c2aaf2af","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/1KI/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/mya_ojv/1KI/22.json","totalNumberOfVerses":792},"chapter":{"number":8,"content":[{"type":"heading","content":["ပ​ဋိ​ညာဉ်​သေတ္တာ​တော်​ကို​ဗိ​မာန်​တော်​သို့ ပင့်​ဆောင်​ခြင်း"]},{"type":"verse","number":1,"content":["ရှော​လ​မုန်​မင်း​သည် ထာ​ဝရ​ဘု​ရား​၏​ပ​ဋိ​ညာဉ် သေတ္တာ​တော်​ကို​ဇိ​အုန်​တည်း​ဟူ​သော​ဒါ​ဝိဒ်​မြို့ မှ ဗိ​မာန်​တော်​သို့​ပင့်​ဆောင်​ရန်​အ​တွက် ဣ​သ​ရေ​လ ခေါင်း​ဆောင်​များ​ဖြစ်​သည့်​အ​နွယ်​ခေါင်း​ဆောင်​များ နှင့်​သား​ချင်း​စု​ခေါင်း​ဆောင်​များ​အား အ​ထံ​တော် သို့​ဆင့်​ခေါ်​တော်​မူ​၏။-"]},{"type":"verse","number":2,"content":["ထို​သူ​အ​ပေါင်း​တို့​သည်​ဧ​သ​နိမ်​အ​မည်​တွင် သော​သတ္တ​မ​လ​၌ ကျင်း​ပ​သည့်​သစ်​ခက်​တဲ​နေ ပွဲ​တော်​သို့​လာ​ရောက်​စု​ဝေး​ကြ​၏။-"]},{"type":"verse","number":3,"content":["ခေါင်း​ဆောင်​အ​ပေါင်း​တို့​လာ​ရောက်​စု​ဝေး​ကြ သော​အ​ခါ ယဇ်​ပု​ရော​ဟိတ်​တို့​သည်​ပဋိညာဉ် သေတ္တာ​တော်​ကို​ထမ်း​၍၊-"]},{"type":"verse","number":4,"content":["ဗိ​မာန်​တော်​သို့​ပင့်​ဆောင်​သွား​ကြ​၏။ ယဇ်​ပု​ရော ဟိတ်​များ​နှင့်​လေ​ဝိ​အ​နွယ်​ဝင်​တို့​သည် ထာ​ဝ​ရ ဘု​ရား​ကိန်း​ဝပ်​တော်​မူ​ရာ​တဲ​တော်​နှင့်​တဲ​တော် တန်​ဆာ​များ​ကို​လည်း ဗိ​မာန်​တော်​သို့​သယ် ဆောင်​ကြ​၏