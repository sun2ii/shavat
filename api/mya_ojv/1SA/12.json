{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"1SA","translationId":"mya_ojv","name":"၁ ရာ","commonName":"၁ ရာ","title":"ဋ္ဌမ္မ​ရာ​ဇ​ဝင်​ပ​ထ​မ​စောင်","order":9,"numberOfChapters":31,"sha256":"76e11fba715dcc9e678986b25f7e84df433483d525cc1baf214f610f57767524","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mya_ojv/1SA/31.json","totalNumberOfVerses":797},"chapter":{"number":12,"content":[{"type":"heading","content":["ရှ​မွေ​လ​၏​နှုတ်​ဆက်​စ​ကား"]},{"type":"verse","number":1,"content":["ထို​နောက်​ရှ​မွေ​လ​သည် ဣ​သ​ရေ​လ​အ​မျိုး သား​တို့​အား``ငါ​သည်​သင်​တို့​တောင်း​ဆို သည့်​အ​တိုင်း​သင်​တို့​အား​ဘု​ရင်​ကို​ခန့် အပ်​ပေး​သ​ဖြင့်၊-"]},{"type":"verse","number":2,"content":["ယ​ခု​သင်​တို့​သည်​ခေါင်း​ဆောင်​ကို​ရ​ရှိ​ကြ လေ​ပြီ။ ငါ​မူ​ကား​အ​သက်​အ​ရွယ်​အို​မင်း ၍​ဆံ​ပင်​ဖြူ​လျက်​ရှိ​၏။ ငါ​၏​သား​များ သည်​လည်း​သင်​တို့​နှင့်​အ​တူ​ရှိ​နေ​ကြ​၏။ ငါ​သည်​အ​သက်​ငယ်​စဉ်​မှ​အ​စ​ပြု​၍ သင်​တို့​အား​ဦး​စီး​ခေါင်း​ဆောင်​ပြု​ခဲ့​၏။-"]},{"type":"verse","number":3,"content":["ယ​ခု​ငါ​ရှိ​နေ​သေး​စဉ်​အ​ကယ်​၍​ငါ့​မှာ အ​ပြစ်​တစ်​စုံ​တစ်​ရာ​ရှိ​ပါ​က ဘု​ရား​သ​ခင် ၏​ရှေ့​တော်​တွင်​လည်း​ကောင်း၊ ကိုယ်​တော်​ဘိ သိက်​ပေး​တော်​မူ​သည့်​ဘု​ရင်​၏​ရှေ့​တွင်​လည်း ကောင်း သင်​တို့​သည်​ယ​ခု​ငါ့​အား​စွပ်​စွဲ​ဖော် ပြ​ကြ​လော့။ ငါ​သည်​အ​ဘယ်​သူ​၏​နွား​ကို ယူ​ဖူး​ပါ​သ​နည်း။ အ​ဘယ်​သူ​၏​မြည်း​ကို မ​တ​ရား​သိမ်း​ယူ​ဖူး​ပါ​သ​နည်း။ ငါ​သည် လူ​တစ်​စုံ​တစ်​ယောက်​အား​လိမ်​လည်​လှည့် စား​မှု​ကို​သော်​လည်း​ကောင်း၊ ညှ