{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"1SA","translationId":"mya_ojv","name":"၁ ရာ","commonName":"၁ ရာ","title":"ဋ္ဌမ္မ​ရာ​ဇ​ဝင်​ပ​ထ​မ​စောင်","order":9,"numberOfChapters":31,"sha256":"76e11fba715dcc9e678986b25f7e84df433483d525cc1baf214f610f57767524","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mya_ojv/1SA/31.json","totalNumberOfVerses":797},"chapter":{"number":17,"content":[{"type":"heading","content":["တစ်​ဦး​ချင်း​စစ်​ထိုး​ရန်​ဣ​သ​ရေ​လ အ​မျိုး​သား​တို့​အား​ဂေါ​လျတ်​က​စိန်​ခေါ်​ခြင်း"]},{"type":"verse","number":1,"content":["ဖိ​လိတ္တိ​အ​မျိုး​သား​တို့​သည်​ယု​ဒ​ပြည်​ရှော​ခေါ မြို့​တွင်​စု​ရုံး​ကာ ထို​မြို့​နှင့်​အ​ဇေ​ကာ​မြို့​စပ် ကြား​ဧ​ဖက်​ဒ​မိမ်​အ​ရပ်​တွင်​တပ်​ချ​ထား ကြ​၏။-"]},{"type":"verse","number":2,"content":["ရှော​လု​နှင့်​ဣ​သ​ရေ​လ​အ​မျိုး​သား​များ​သည် လည်း​စု​ရုံး​၍ ဝက်​သစ်​ချ​ချိုင့်​ဝှမ်း​တွင်​တပ်​ချ ပြီး​လျှင်​ဖိ​လိတ္တိ​တပ်​သား​တို့​အား​တိုက်​ခိုက် ရန်​အ​သင့်​ပြင်​ဆင်​ကြ​၏။-"]},{"type":"verse","number":3,"content":["ဖိ​လိတ္တိ​အ​မျိုး​သား​တို့​က​တောင်​ကုန်း​တစ်​ခု ပေါ်​တွင်​လည်း​ကောင်း၊ ဣ​သ​ရေ​လ​အ​မျိုး​သား တို့​က​အ​ခြား​တောင်​ကုန်း​တစ်​ခု​ပေါ်​တွင် လည်း​ကောင်း​နေ​ရာ​ယူ​ထား​ကြ​၏။ သူ​တို့​၏ စပ်​ကြား​တွင်​ကား​ချိုင့်​ဝှမ်း​ခံ​လျက်​နေ​သ​တည်း။"]},{"type":"verse","number":4,"content":["ဂါ​သ​မြို့​သား​ဂေါ​လျတ်​ဆို​သူ​သည်​ဖိ​လိတ္တိ​တပ် စခန်း​မှ​ထွက်​လာ​ပြီး​လျှင် ဣ​သ​ရေ​လ​အ​မျိုး​သား တို့​အား​မိ​မိ​နှင့်​တစ်​ဦး​ချင်း​စစ်​ထိုး​ရန်