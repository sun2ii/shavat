{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"1SA","translationId":"mya_ojv","name":"၁ ရာ","commonName":"၁ ရာ","title":"ဋ္ဌမ္မ​ရာ​ဇ​ဝင်​ပ​ထ​မ​စောင်","order":9,"numberOfChapters":31,"sha256":"76e11fba715dcc9e678986b25f7e84df433483d525cc1baf214f610f57767524","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mya_ojv/1SA/31.json","totalNumberOfVerses":797},"chapter":{"number":26,"content":[{"type":"heading","content":["ရှော​လု​အား​တစ်​ဖန်​ဒါ​ဝိဒ် အ​သက်​ချမ်း​သာ​ပေး​ခြင်း"]},{"type":"verse","number":1,"content":["ဇိ​ဖ​မြို့​မှ​လူ​အ​ချို့​တို့​သည်​ရှော​လု​ရှိ​ရာ​ဂိ​ဗာ မြို့​သို့​လာ​ရောက်​၍ ဒါ​ဝိဒ်​သည်​ယု​ဒ​တော​ကန္တာ​ရ အ​စွန်​နား​ရှိ​ဟ​ခိ​လ​တောင်​ပေါ်​တွင်​ပုန်း​အောင်း နေ​ပါ​သည်​ဟု​လျှောက်​ထား​ကြ​၏။-"]},{"type":"verse","number":2,"content":["ရှော​လု​သည်​ချက်​ချင်း​ပင်​မိ​မိ​၏​လက်​ရွေး စင်​စစ်​သည်​တော်​သုံး​ထောင်​နှင့်​အ​တူ ဒါ​ဝိဒ် ကို​ရှာ​ရန်​ဇိ​ဖ​တော​ကန္တာ​ရ​သို့​ချီ​တက်​ပြီး လျှင်၊-"]},{"type":"verse","number":3,"content":["ဟ​ခိ​လ​တောင်​ပေါ်​လမ်း​အနီး​တွင်​တပ်​စ​ခန်း ချ​၏။ ထို​အ​ချိန်​၌​ဒါ​ဝိဒ်​သည်​တော​ကန္တာ​ရ တွင်​ပင်​ရှိ​၍ မိ​မိ​အား​ရှာ​ဖွေ​ရန်​ရှော​လု​တော ကန္တာ​ရ​ထဲ​သို့​ရောက်​ရှိ​လာ​သည့်​သ​တင်း ကို​ကြား​သော​အ​ခါ၊-"]},{"type":"verse","number":4,"content":["သူ​လျှို​များ​ကို​စေ​လွှတ်​စုံ​စမ်း​စေ​ရာ​အ​ကယ် ပင်​ရှော​လု​ရောက်​ရှိ​နေ​ကြောင်း​သိ​ရှိ​ရ​လေ သည်။-"]},{"type":"verse","number":5,"content":["သူ​သည်​ရှော​လု​တပ်​ချ​ရာ​သို့​ချက်​ချင်း​သွား ၍​ရှော​