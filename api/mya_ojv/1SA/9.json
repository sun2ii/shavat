{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"1SA","translationId":"mya_ojv","name":"၁ ရာ","commonName":"၁ ရာ","title":"ဋ္ဌမ္မ​ရာ​ဇ​ဝင်​ပ​ထ​မ​စောင်","order":9,"numberOfChapters":31,"sha256":"76e11fba715dcc9e678986b25f7e84df433483d525cc1baf214f610f57767524","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/1SA/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/mya_ojv/1SA/31.json","totalNumberOfVerses":797},"chapter":{"number":9,"content":[{"type":"heading","content":["ရှ​မွေ​လ​နှင့်​ရှော​လု​တွေ့​ဆုံ​ခြင်း"]},{"type":"verse","number":1,"content":["ဗင်္ယာ​မိန်​အ​နွယ်​ဝင်​လူ​တစ်​ယောက်​ရှိ​၏။ သူ​၏ နာ​မည်​မှာ​ကိ​ရှ​ဖြစ်​၏။ သူ့​အ​ဖ​သည်​အ​ဗျေ​လ၊ အ​ဖိုး​ကား​ဇေ​ရော်​ဖြစ်​၏။ သူ​သည်​အာ​ဖိ​သား ချင်း​စု​ဝင်​ဖြစ်​သော​ဗေ​ခေါ​ရတ်​အိမ်​ထောင်​စု မှ​ဆင်း​သက်​လာ​သူ​တည်း။ ကိ​ရှ​သည်​ချမ်း​သာ ကြွယ်​ဝ​၍​သြ​ဇာ​တိ​က္က​မ​ရှိ​သူ​တစ်​ယောက် ဖြစ်​ပေ​သည်။-"]},{"type":"verse","number":2,"content":["သူ့​မှာ​ရှော​လု​နာ​မည်​တွင်​သော​သား​တစ် ယောက်​ရှိ​၏။ ထို​သား​သည်​ပျို​ရွယ်​၍​အ​ဆင်း လှ​၏။ ဣ​သ​ရေ​လ​အ​မျိုး​သား​ရှိ​သ​မျှ တို့​ထက်​အ​ရပ်​တစ်​ပေ​မျှ​ပို​၍​မြင့်​၏။ အ​ဆင်း​လည်း​ပို​၍​လှ​၏။"]},{"type":"verse","number":3,"content":["ကိ​ရှ​သည်​မိ​မိ​၏​မြည်း​အ​ချို့​ပျောက်​သွား သ​ဖြင့် ရှော​လု​အား``အ​စေ​ခံ​တစ်​ယောက်​ကို ခေါ်​ပြီး​လျှင်​မြည်း​တို့​ကို​လိုက်​ရှာ​ပါ​လော့'' ဟု​ဆို​၏။-"]},{"type":"verse","number":4,"content":["သူ​တို့​နှစ်​ယောက်​သည်​ဧ​ဖ​ရိမ်​တောင်​ပိုင်း အ​ရပ်​နှင့် ရှ​လိ​ရှ​ဒေ​သ​တစ်​လျှောက်​တွင် ရှာ​ဖွေ​ကြ​သော်​လည်း​မြည်း​များ​ကို​