{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"2CH","translationId":"mya_ojv","name":"၂ ရာ​ချုပ်","commonName":"၂ ရာ​ချုပ်","title":"ရာ​ဇ​ဝင်​ချုပ်​ဒု​တိ​ယ​စောင်","order":14,"numberOfChapters":36,"sha256":"fe8a87dc385fbb88805479abbe1ede4bbcebe7bb004c5a57730b6edc3eb010b7","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/2CH/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/mya_ojv/2CH/36.json","totalNumberOfVerses":794},"chapter":{"number":18,"content":[{"type":"heading","content":["အာ​ဟပ်​အား​ပ​ရော​ဖက်​မိက္ခာ​သ​တိ​ပေး​ခြင်း"]},{"type":"verse","number":1,"content":["ယော​ရှ​ဖတ်​မင်း​သည်​ချမ်း​သာ​ကြွယ်​ဝ​၍​ဂုဏ် သ​တင်း​ကျော်​စော​လာ​သော​အ​ခါ ဣ​သ​ရေ​လ ဘုရင်​အာ​ဟပ်​မင်း​နှင့်​အ​မျိုး​ဆက်​တော်​မူ​၏။-"]},{"type":"verse","number":2,"content":["နှစ်​အ​နည်း​ငယ်​ကြာ​သော​အ​ခါ​ယော​ရှ​ဖတ် သည် အာ​ဟပ်​ထံ​လည်​ပတ်​ရန်​ရှ​မာ​ရိ​မြို့​သို့ ရောက်​ရှိ​လာ​လေ​သည်။ အာ​ဟပ်​သည်​ယော​ရှ ဖတ်​နှင့်​တ​ကွ​သူ​နှင့်​လိုက်​ပါ​လာ​သူ​တို့​ကို ဂုဏ်​ပြု​ရန် သိုး​နွား​အ​မြောက်​အ​မြား​ကို​သတ် ၍​ဧည့်​ခံ​ပွဲ​ကျင်း​ပ​တော်​မူ​၏။ သူ​သည်​ယော ရှ​ဖတ်​အား​မိ​မိ​နှင့်​အ​တူ​ဂိ​လဒ်​ပြည်​ရာ မုတ်​မြို့​ကို​တိုက်​ခိုက်​ရန်​သွေး​ဆောင်​လေ​၏။-"]},{"type":"verse","number":3,"content":["သူ​က``အ​ဆွေ​တော်​သည်​ရာ​မုတ်​မြို့​ကို​တိုက် ခိုက်​ရန်​ကျွန်ုပ်​နှင့်​အ​တူ​လိုက်​မည်​လော'' ဟု မေး​၏။ ယော​ရှ​ဖတ်​က``အ​ဆွေ​တော်​အ​ဆင်​သင့်​ရှိ ချိန်​၌​ကျွန်ုပ်​လည်း​အ​ဆင်​သင့်​ရှိ​ပါ​၏။ ကျွန်ုပ်​၏​တပ်​မ​တော်​သည်​လည်း​ထို​နည်း​တူ ပင်​ဖြစ်​ပါ​၏။ ကျွန်ုပ်​တို့​သည်​သင်​နှင့်​အ​တူ လိုက