{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"2CH","translationId":"mya_ojv","name":"၂ ရာ​ချုပ်","commonName":"၂ ရာ​ချုပ်","title":"ရာ​ဇ​ဝင်​ချုပ်​ဒု​တိ​ယ​စောင်","order":14,"numberOfChapters":36,"sha256":"fe8a87dc385fbb88805479abbe1ede4bbcebe7bb004c5a57730b6edc3eb010b7","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/2CH/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/mya_ojv/2CH/36.json","totalNumberOfVerses":794},"chapter":{"number":24,"content":[{"type":"heading","content":["ယု​ဒ​ဘု​ရင်​ယော​ရှ"]},{"type":"verse","number":1,"content":["ယော​ရှ​သည်​သက်​တော်​ခု​နစ်​နှစ်​ရှိ​သော​အ​ခါ ယု​ဒ​ပြည်​ဘု​ရင်​အ​ဖြစ်​နန်း​တက်​၍ ယေ​ရု ရှ​လင်​မြို့​၌​အ​နှစ်​လေး​ဆယ်​တိုင်​တိုင်​နန်း​စံ လေ​သည်။ သူ​၏​မယ်​တော်​မှာ​ဗေ​ရ​ရှေ​ဘ​မြို့ သူ​ဇိ​ဗိ​ဖြစ်​၏။-"]},{"type":"verse","number":2,"content":["သူ​သည်​ယဇ်​ပု​ရော​ဟိတ်​ယော​ယ​ဒ​အ​သက် ရှင်​သ​မျှ​ကာ​လ​ပတ်​လုံး ထာ​ဝ​ရ​ဘု​ရား နှစ်​သက်​တော်​မူ​သော​အ​မှု​ကို​ပြု​၏။-"]},{"type":"verse","number":3,"content":["ယော​ယ​ဒ​သည်​ယော​ရှ​အ​တွက်​မိ​ဖု​ရား နှစ်​ပါး​ကို​ရွေး​ချယ်​ပေး​၏။ ယော​ရှ​သည် လည်း​ထို​မိ​ဖု​ရား​များ​ဖြင့်​သား​သ​မီး များ​ကို​ရ​ရှိ​လေ​သည်။"]},{"type":"verse","number":4,"content":["ယော​ရှ​သည်​နန်း​တက်​ပြီး​နောက်​ကာ​လ​အ​တန် ကြာ​သော​အ​ခါ ထာ​ဝ​ရ​ဘု​ရား​၏​ဗိ​မာန် တော်​ကို​မွမ်း​မံ​ပြင်​ဆင်​ရန်​အ​ကြံ​ရှိ​တော် မူ​၏။-"]},{"type":"verse","number":5,"content":["သူ​သည်​ယဇ်​ပု​ရော​ဟိတ်​များ​နှင့်​လေဝိ​အ​နွယ် ဝင်​များ​အား​ယု​ဒ​ပြည်​အ​မြို့​မြို့​သို့​စေ​လွှတ် ၍ ဗိ​မာန်​တော်​ကို​နှစ်​