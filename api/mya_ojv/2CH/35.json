{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"2CH","translationId":"mya_ojv","name":"၂ ရာ​ချုပ်","commonName":"၂ ရာ​ချုပ်","title":"ရာ​ဇ​ဝင်​ချုပ်​ဒု​တိ​ယ​စောင်","order":14,"numberOfChapters":36,"sha256":"fe8a87dc385fbb88805479abbe1ede4bbcebe7bb004c5a57730b6edc3eb010b7","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/2CH/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/mya_ojv/2CH/36.json","totalNumberOfVerses":794},"chapter":{"number":35,"content":[{"type":"heading","content":["ပ​သ​ခါ​ပွဲ​တော်​ကို​ယော​ရှိ​ကျင်း​ပ​ခြင်း"]},{"type":"verse","number":1,"content":["ယော​ရှိ​မင်း​သည်​ထာ​ဝရ​ဘု​ရား​၏​ဂုဏ်​တော် ကို​ချီး​မွမ်း​သည့်​အ​နေ​ဖြင့်​ယေ​ရု​ရှ​လင်​မြို့ တွင် ပ​သ​ခါ​ပွဲ​တော်​ကျင်း​ပ​၍​ပ​ထ​မ​လ တစ်​ဆယ့်​လေး​ရက်​နေ့​၌​ထို​ပွဲ​တော်​အ​တွက် သိုး​နွား​များ​ကို​သတ်​စေ​၏။-"]},{"type":"verse","number":2,"content":["မင်း​ကြီး​သည်​ယဇ်​ပု​ရော​ဟိတ်​တို့​အား​ဗိ​မာန် တော်​တွင်​ထမ်း​ဆောင်​ရ​မည့်​တာ​ဝန်​ဝတ္တ​ရား များ​ကို​သတ်​မှတ်​ပေး​ပြီး​လျှင် ယင်း​တို့​ကို ကျေ​ပွန်​စွာ​ထမ်း​ဆောင်​ကြ​ရန်​အား​ပေး တိုက်​တွန်း​တော်​မူ​၏။-"]},{"type":"verse","number":3,"content":["ဣသ​ရေ​လ​အ​မျိုး​သား​တို့​ကို​သြ​ဝါ​ဒ​ပေး ရ​သော၊ မိ​မိ​တို့​ကိုယ်​ကို ထာ​ဝ​ရ​ဘု​ရား​အား ဆက်​ကပ်​ပူ​ဇော်​ထား​သူ​များ​ဖြစ်​သော​လေ​ဝိ အ​နွယ်​ဝင်​တို့​အား​မင်း​ကြီး​က``ဒါ​ဝိဒ်​၏​သား တော်​ရှော​လ​မုန်​မင်း​တည်​ဆောက်​တော်​မူ​ခဲ့ သည့်​ဗိ​မာန်​တော်​တွင် ပ​ဋိ​ညာဉ်​သေတ္တာ​တော် ကို​ထား​ရှိ​ကြ​လော့။ သင်​တို့​သည်​ထို​သေတ္တာ တော်​ကို​တစ်​နေ​ရာ​မှ​တစ်​နေ​ရာ​သို့​ပြောင်း ရွှေ့