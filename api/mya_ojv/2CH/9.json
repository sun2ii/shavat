{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"2CH","translationId":"mya_ojv","name":"၂ ရာ​ချုပ်","commonName":"၂ ရာ​ချုပ်","title":"ရာ​ဇ​ဝင်​ချုပ်​ဒု​တိ​ယ​စောင်","order":14,"numberOfChapters":36,"sha256":"fe8a87dc385fbb88805479abbe1ede4bbcebe7bb004c5a57730b6edc3eb010b7","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/2CH/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/mya_ojv/2CH/36.json","totalNumberOfVerses":794},"chapter":{"number":9,"content":[{"type":"heading","content":["ရှေ​ဘ​ဘု​ရင်​မ​အ​လည်​အ​ပတ်​ကြွ​လာ​ခြင်း"]},{"type":"verse","number":1,"content":["ရှေ​ဘ​ပြည်​ဘု​ရင်​မ​သည်​ရှော​လ​မုန်​၏​ဂုဏ် သတင်း​ကို​ကြား​သိ​ရ​သ​ဖြင့် ခက်​ခဲ​သော​ပုစ္ဆာ များ​ဖြင့်​မင်း​ကြီး​အား​ပ​ညာ​စမ်း​ရန်​ယေ​ရု ရှ​လင်​မြို့​သို့​ကြွ​လာ​တော်​မူ​၏။ ဘု​ရင်​မ သည်​များ​စွာ​သော​အ​ခြွေ​အ​ရံ​လိုက်​ပါ လျက်​နံ့​သာ​မျိုး​များ၊ ကျောက်​မျက်​ရ​တ​နာ များ၊ ရွှေ​အ​မြောက်​အ​မြား​တင်​ဆောင်​သည့် ကု​လား​အုတ်​များ​နှင့်​ရောက်​ရှိ​လာ​လေ​သည်။ သူ​သည်​မင်း​ကြီး​၏​ရှေ့​တော်​သို့​ရောက်​ရှိ လာ​သော​အ​ခါ​မိ​မိ​စဉ်း​စား​ရ​သ​မျှ​သော ပုစ္ဆာ​တို့​ကို​မေး​တော်​မူ​၏။-"]},{"type":"verse","number":2,"content":["မင်း​ကြီး​သည်​တစ်​ခု​မ​ကျန်​ဖြေ​ကြား​တော်​မူ သည်။ မင်း​ကြီး​မ​ဖြေ​ရှင်း​နိုင်​သော​ပုစ္ဆာ​ဟူ​၍ မ​ရှိ။-"]},{"type":"verse","number":3,"content":["ရှေ​ဘ​ပြည်​ဘု​ရင်​မ​သည်​ရှော​လ​မုန်​ထံ​မှ ဉာဏ်​ပညာ​နှင့်​ယှဉ်​သော​စ​ကား​များ​ကို​ကြား ၍ သူ​ဆောက်​လုပ်​ထား​သည့်​နန်း​တော်​ကို​မြင် တော်​မူ​၏။-"]},{"type":"verse","number":4,"content":["ဘု​ရင်​မ​သည်​မင်း​ကြီး