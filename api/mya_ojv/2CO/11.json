{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"2CO","translationId":"mya_ojv","name":"၂ ကော","commonName":"၂ ကော","title":"ကော​ရိန္သု​သြ​ဝါ​ဒ​စာ ဒု​တိ​ယ​စောင်","order":47,"numberOfChapters":13,"sha256":"c87c42c249abcea442b558b871bbf5de4bdc82a7810e381a43699d413cd79a0e","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/2CO/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/mya_ojv/2CO/13.json","totalNumberOfVerses":253},"chapter":{"number":11,"content":[{"type":"heading","content":["ပေါ​လု​နှင့်​တ​မန်​တော်​အ​တု​များ"]},{"type":"verse","number":1,"content":["ငါ​၏​အ​နည်း​ငယ်​မိုက်​မဲ​မှု​ကို​သင်​တို့​သည်း​ခံ ကြ​လိမ့်​မည်​ဟု​မျှော်​လင့်​ပါ​၏။ ကျေး​ဇူး​ပြု​၍ သည်း​ခံ​ကြ​လော့။-"]},{"type":"verse","number":2,"content":["ဘု​ရား​သ​ခင်​သည်​သင်​တို့​ကို​မ​နာ​လို​စိတ်​ရှိ တော်​မူ​သ​ကဲ့​သို့ ငါ​သည်​သင်​တို့​ကို​မ​နာ​လို စိတ်​ရှိ​၏။ သင်​တို့​သည်​ခ​ရစ်​တော်​တစ်​ဦး​တည်း နှင့်​စုံ​ဖက်​ထိမ်း​မြား​ရန် ငါ​က​တိ​ပြု​ထား​သည့် အ​ပျို​စင်​နှင့်​တူ​ကြ​၏။-"]},{"type":"verse","number":3,"content":["ဧ​ဝ​သည်​မြွေ​၏​ကောက်​ကျစ်​စဉ်း​လဲ​မှု​ဖြင့် အ​လှည့်​စား​ခံ​ရ​သ​ကဲ့​သို့​သင်​တို့​သည်​လည်း စိတ်​ဖောက်​ပြန်​ကာ ခ​ရစ်​တော်​အား​အ​ကြွင်း​မဲ့ ချစ်​ခင်​စွဲ​လမ်း​မှု​ကို​စွန့်​လွှတ်​လိုက်​ကြ​မည် လော​ဟု​ငါ​စိုး​ရိမ်​မိ​၏။-"]},{"type":"verse","number":4,"content":["လူ​တစ်​စုံ​တစ်​ယောက်​သည်​သင်​တို့​ထံ​ရောက်​လာ​၍ ငါ​တို့​မ​ကြေ​ညာ​ဘူး​သည့်​အ​ခြား​တစ်​ပါး​သော ယေ​ရှု​၏​အ​ကြောင်း​ကို​ဟော​ပြော​ကြေ​ညာ​သော အ​ခါ သင်​တို့​သည်​ဝမ်း​မြောက်​စွာ​လက်​ခံ​ခွင့်