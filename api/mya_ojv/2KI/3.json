{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"2KI","translationId":"mya_ojv","name":"၄ ရာ","commonName":"၄ ရာ","title":"ဋ္ဌမ္မ​ရာ​ဇ​ဝင်​စ​တုတ္ထ​စောင်","order":12,"numberOfChapters":25,"sha256":"eb961357865cc3aae5715c48ea30d6e843dc51017d8cbc3178cd99ba3dd0a912","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/2KI/1.json","lastChapterNumber":25,"lastChapterApiLink":"/api/mya_ojv/2KI/25.json","totalNumberOfVerses":704},"chapter":{"number":3,"content":[{"type":"heading","content":["ဣ​သ​ရေ​လ​ပြည်​နှင့်​မော​ဘ​ပြည်​စစ်​ဖြစ်​ခြင်း"]},{"type":"verse","number":1,"content":["ယု​ဒ​ပြည်​ဘု​ရင်​ယော​ရှ​ဖတ်​၏​နန်း​စံ​တစ်​ဆယ့် ရှစ်​နှစ်​မြောက်​၌ အာ​ဟပ်​၏​သား​တော်​ယော​ရံ​သည် ဣ​သ​ရေ​လ​ပြည်​ဘု​ရင်​အ​ဖြစ်​နန်း​တက်​၍ ရှ​မာ​ရိ​မြို့​တွင်​တစ်​ဆယ့်​နှစ်​နှစ်​စိုး​စံ​ရ​၏။-"]},{"type":"verse","number":2,"content":["သူ​သည်​ဘု​ရား​သခင်​အား​ပြစ်​မှား​သော်​လည်း မိ​မိ ၏​ခ​မည်း​တော်​သို့​မ​ဟုတ်​မယ်​တော်​ယေ​ဇ​ဗေ​လ လောက်​မ​ဆိုး​ချေ။ သူ​သည်​ခ​မည်း​တော်​တည်​လုပ် ခဲ့​သော​ဗာ​လ​ဘု​ရား​ကျောက်​တိုင်​ကို​ပယ်​ရှား လိုက်​လေ​သည်။-"]},{"type":"verse","number":3,"content":["သို့​ရာ​တွင်​မိ​မိ​အ​လျင်​အုပ်​စိုး​ခဲ့​သည့်​နေ​ဗတ် ၏​သား​ယေ​ရော​ဗောင်​မင်း​ကဲ့​သို့​ပင် ဣ​သ​ရေ​လ အ​မျိုး​သား​တို့​အား​အ​ပြစ်​ကူး​စေ​ရန်​ရှေ့ ဆောင်​လမ်း​ပြ​ပေး​လေ​သည်။ ထို​သို့​အ​ပြစ် ကူး​လွန်​မှု​ကို​အ​မြဲ​ပြု​၏။"]},{"type":"verse","number":4,"content":["မော​ဘ​ဘု​ရင်​မေ​ရှာ​သည်​သိုး​များ​ကို​မွေး​မြူ​ကာ နှစ်​စဉ်​နှစ်​တိုင်း​ဣ​သ​ရေ​လ​ဘု​ရင်​အား​သိုး​ငယ် အ​ကောင်​တစ်​သိန်း​ကို​လည်း​ကော