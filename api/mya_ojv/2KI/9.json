{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"2KI","translationId":"mya_ojv","name":"၄ ရာ","commonName":"၄ ရာ","title":"ဋ္ဌမ္မ​ရာ​ဇ​ဝင်​စ​တုတ္ထ​စောင်","order":12,"numberOfChapters":25,"sha256":"eb961357865cc3aae5715c48ea30d6e843dc51017d8cbc3178cd99ba3dd0a912","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/2KI/1.json","lastChapterNumber":25,"lastChapterApiLink":"/api/mya_ojv/2KI/25.json","totalNumberOfVerses":704},"chapter":{"number":9,"content":[{"type":"heading","content":["ယေ​ဟု​အား​ဣသ​ရေ​လ​ဘုရင်​အ​ဖြစ် ဘိ​သိက်​ပေး​ခြင်း"]},{"type":"verse","number":1,"content":["ဤ​အ​တော​အ​တွင်း​၌​ပ​ရော​ဖက်​ဧ​လိ​ရှဲ သည် လူ​ငယ်​ပ​ရော​ဖက်​တစ်​ပါး​ကို​ခေါ်​၍``သင် သည်​ရာ​မုတ်​မြို့​သို့​သွား​ရန်​အ​သင့်​ပြင်​လော့။ ဤ​သံ​လွင်​ဆီ​ဘူး​ကို​လည်း​ယူ​သွား​လော့။ ထို မြို့​သို့​ရောက်​သော​အ​ခါ၊-"]},{"type":"verse","number":2,"content":["နိမ်​ရှိ​၏​မြေး၊ ယေ​ဟော​ရှ​ဖတ်​၏​သား​ယေ​ဟု ကို​ရှာ​လော့။ သူ့​ကို​အ​ဖော်​များ​ရှိ​ရာ​မှ​ဝေး ရာ​ဆိတ်​ကွယ်​သည့်​အ​ခန်း​သို့​ခေါ်​ပြီး​လျှင်၊-"]},{"type":"verse","number":3,"content":["ဤ​ဆီ​ကို​သူ​၏​ဦး​ခေါင်း​ပေါ်​တွင်​လောင်း​၍ ထာ​ဝ​ရ​ဘု​ရား​က`ငါ​သည်​သင့်​အား​ဣ​သ​ရေ လ​ဘု​ရင်​အ​ဖြစ်​ဘိ​သိက်​ပေး​၏' ဟု​မိန့်​တော် မူ​ကြောင်း​ဆင့်​ဆို​လော့'' ဟု​မှာ​ကြား​လိုက်​၏။"]},{"type":"verse","number":4,"content":["သို့​ဖြစ်​၍​ပ​ရော​ဖက်​ငယ်​သည်​ရာ​မုတ်​မြို့ သို့​သွား​ရာ၊-"]},{"type":"verse","number":5,"content":["ထို​အ​ရပ်​တွင်​တပ်​မှူး​များ​တိုင်​ပင်​နေ​ကြ​သည် ကို​တွေ့​လျှင်``တပ်​မှူး​မင်း၊ အ​ကျွန်ုပ်​သည်​အ​ရှင့် အ​တွက်​