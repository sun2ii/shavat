{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"2SA","translationId":"mya_ojv","name":"၂ ရာ","commonName":"၂ ရာ","title":"ဋ္ဌမ္မ​ရာ​ဇ​ဝင်​ဒု​တိ​ယ​စောင်","order":10,"numberOfChapters":24,"sha256":"676ef35c29cb31a9b80d0c6675902841edf153fe2176f024a8e40b13dd2a075d","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/mya_ojv/2SA/24.json","totalNumberOfVerses":673},"chapter":{"number":13,"content":[{"type":"heading","content":["အာ​မ​နုန်​နှင့်​တာ​မာ"]},{"type":"verse","number":1,"content":["ဒါ​ဝိဒ်​၏​သား​တော်​အ​ဗ​ရှ​လုံ​တွင် တာ​မာ နာ​မည်​ရှိ​သော​အ​ဆင်း​လှ​သူ​နှ​မ​တော်​ရှိ ၏။ ဒါ​ဝိဒ်​၏​သား​တော်​တစ်​ပါး​ဖြစ်​သူ​အာ မ​နုန်​သည်​ထို​နှ​မ​တော်​ကို​အ​လွန်​စုံ​မက်​၏။-"]},{"type":"verse","number":2,"content":["သူ​သည်​တာ​မာ​ကို​အ​လွန်​ချစ်​လှ​သ​ဖြင့် စိတ္တ​ဇ​ရော​ဂါ​စွဲ​ကပ်​လာ​လေ​သည်။ နှ​မ​တော် သည်​အ​ပျို​စင်​ဖြစ်​သ​ဖြင့် အာ​မ​နုန်​သည် မိ​မိ​အ​လို​ပြည့်​စေ​ရန်​မ​ကြံ​တတ်​အောင် ဖြစ်​လေ​၏။-"]},{"type":"verse","number":3,"content":["သို့​ရာ​တွင်​သူ့​မှာ​ယော​န​ဒပ်​အ​မည်​တွင်​သော မိတ်​ဆွေ​ရှိ​၏။ ယော​န​ဒပ်​သည်​ဒါ​ဝိဒ်​၏​အစ်​ကို ရှိ​မာ​၏​သား​ဖြစ်​၏။ သူ​သည်​အ​လွန်​ပါး​နပ် လိမ္မာ​သူ​တည်း။-"]},{"type":"verse","number":4,"content":["ယော​န​ဒပ်​က``သင်​သည်​ဘု​ရင့်​သား​တော်​ဖြစ် ပါ​လျက် နေ့​စဉ်​ရက်​ဆက်​စိတ်​မ​ချမ်း​မ​သာ ဖြစ်​လျက်​နေ​သည်​ကို​ငါ​တွေ့​မြင်​ရ​ပါ​၏။ အ​ကြောင်း​အ​ဘယ်​သို့​ရှိ​သည်​ကို​ငါ့​အား ပြော​လော့'' ဟု​အာ​မ​နုန်​အား​ဆို​၏။ အာ​မ​နုန်​က``ငါ​နှင့်​အ​ဖေ​တူ​အ​မေ​ကွဲ​ညီ အစ်​