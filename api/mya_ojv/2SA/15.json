{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"2SA","translationId":"mya_ojv","name":"၂ ရာ","commonName":"၂ ရာ","title":"ဋ္ဌမ္မ​ရာ​ဇ​ဝင်​ဒု​တိ​ယ​စောင်","order":10,"numberOfChapters":24,"sha256":"676ef35c29cb31a9b80d0c6675902841edf153fe2176f024a8e40b13dd2a075d","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/mya_ojv/2SA/24.json","totalNumberOfVerses":673},"chapter":{"number":15,"content":[{"type":"heading","content":["အ​ဗ​ရှ​လုံ​ပုန်​ကန်​ခြင်း"]},{"type":"verse","number":1,"content":["ထို​နောက်​အ​ဗ​ရှ​လုံ​သည်​မြင်း​ရ​ထား​တစ်​စီး၊ မြင်း​များ​နှင့်​ရှေ့​တော်​ပြေး​စစ်​သည်​ငါး​ဆယ် ကို​မိ​မိ​အ​တွက်​ထား​ရှိ​လေ​သည်။-"]},{"type":"verse","number":2,"content":["သူ​သည်​နံ​နက်​စော​စော​ထ​ပြီး​လျှင်​မြို့​တံ​ခါး ဝ​လမ်း​နံ​ဘေး​တွင်​ရပ်​လျက်​နေ​တတ်​၏။ ဘု​ရင် ၏​အ​ဆုံး​အ​ဖြတ်​ကို​ခံ​ရန်​အ​မှု​သည်​တစ်​စုံ တစ်​ယောက်​ရောက်​ရှိ​လာ​သော​အ​ခါ​သူ့​ကို​ခေါ် ၍``သင်​သည်​အ​ဘယ်​အ​ရပ်​က​လာ​သနည်း'' ဟု မေး​လေ့​ရှိ​၏။ အ​မှု​သည်​က``အ​ရှင်​အ​ကျွန်ုပ် သည်​ဤ​မည်​သော​ဣ​သ​ရေ​လ​အ​နွယ်​မှ​ဖြစ် ပါ​သည်'' ဟု​ဆို​လျှင်၊-"]},{"type":"verse","number":3,"content":["အ​ဗ​ရှ​လုံ​က``ကြည့်​လော့၊ သင်​၏​အ​မှု​သည် တ​ရား​ဥ​ပ​ဒေ​အ​ရ​မှန်​ကန်​၏။ သို့​ရာ​တွင် ဘု​ရင်​၏​ကိုယ်​စား​သင့်​အ​မှု​ကို​စီ​ရင်​ပေး မည့်​သူ​တစ်​ယောက်​မျှ​မ​ရှိ။-"]},{"type":"verse","number":4,"content":["ငါ​သာ​လျှင်​တ​ရား​သူ​ကြီး​ဖြစ်​ခဲ့​ပါ​မူ​ငြင်း ခုံ​မှု၊ တ​ရား​မှု​ရှိ​သူ​သည်​ငါ့​ထံ​သို့​လာ​၍ ငါ​သည်​တ​ရား​သ​ဖြင့်​စီ​ရင်​မည်'' ဟု​ပြေ