{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"2SA","translationId":"mya_ojv","name":"၂ ရာ","commonName":"၂ ရာ","title":"ဋ္ဌမ္မ​ရာ​ဇ​ဝင်​ဒု​တိ​ယ​စောင်","order":10,"numberOfChapters":24,"sha256":"676ef35c29cb31a9b80d0c6675902841edf153fe2176f024a8e40b13dd2a075d","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/mya_ojv/2SA/24.json","totalNumberOfVerses":673},"chapter":{"number":24,"content":[{"type":"heading","content":["ဒါ​ဝိဒ်​မင်း​သန်း​ခေါင်​စာ​ရင်း​ကောက်​ယူ​ခြင်း"]},{"type":"verse","number":1,"content":["တစ်​ဖန်​ထာ​ဝ​ရ​ဘု​ရား​သည်​ဣသ​ရေ​လ​အ​မျိုး သား​တို့​အ​ပေါ်​တွင်​အ​မျက်​ထွက်​တော်​မူ​သ​ဖြင့် သူ​တို့​ကို​ဒဏ်​ခတ်​ရန်​ဒါ​ဝိဒ်​အား​အ​ပြစ်​ကူး မိ​စေ​တော်​မူ​၏။ ထာ​ဝ​ရ​ဘု​ရား​က``သင်​သည် သွား​၍​ဣ​သ​ရေ​လ​နှင့်​ယု​ဒ​ပြည်​တွင်​သန်း ခေါင်​စာ​ရင်း​ကောက်​ယူ​လော့'' ဟု​ဒါ​ဝိဒ်​အား မိန့်​တော်​မူ​၏။-"]},{"type":"verse","number":2,"content":["သို့​ဖြစ်​၍​ဒါ​ဝိဒ်​သည်​မိ​မိ​၏​တပ်​မ​တော် ဗိုလ်​ချုပ်​ယွာ​ဘ​အား``သင်​၏​တပ်​မှူး​များ​နှင့် အ​တူ​တိုင်း​ပြည်​တစ်​စွန်း​မှ​တစ်​စွန်း​တိုင်​အောင် ဣ​သ​ရေ​လ​အ​နွယ်​ရှိ​သ​မျှ​တို့​ထံ​သို့​သွား ၍​သန်း​ခေါင်​စာ​ရင်း​ကောက်​ယူ​လော့။ လူ​ဦး ရေ​မည်​မျှ​ရှိ​သည်​ကို​ငါ​သိ​လို​သည်'' ဟု​မိန့်​တော်​မူ​၏။"]},{"type":"verse","number":3,"content":["သို့​ရာ​တွင်​ယွာ​ဘ​က``အ​ရှင်​မင်း​ကြီး၊ အ​ရှင် ၏​ဘု​ရား​သ​ခင်​ထာ​ဝ​ရ​ဘု​ရား​သည်​ဣ​သ ရေ​လ​အ​မျိုး​သား​တို့​အား ယ​ခု​ထက်​အ​ဆ တစ်​ရာ​ပို​၍​တိုး​ပွား​အောင်​ပြု​တော်​မူ​ပါ စေ​သော။ အ​ရှင်​သည်​လည်း​ယင်း​သိ