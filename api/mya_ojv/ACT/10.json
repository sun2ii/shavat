{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"ACT","translationId":"mya_ojv","name":"တမန်တော်ဝတ္ထု","commonName":"တမန်တော်ဝတ္ထု","title":"တမန်တော်ဝတ္ထု","order":44,"numberOfChapters":28,"sha256":"319ecad817efbefd2f24f841576fe730cccfab07fdbec204e5acb1dbc418630c","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/ACT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/mya_ojv/ACT/28.json","totalNumberOfVerses":993},"chapter":{"number":10,"content":[{"type":"heading","content":["ပေ​တ​ရု​နှင့်​ကော်​နေ​လိ"]},{"type":"verse","number":1,"content":["ကဲ​သ​ရိ​မြို့​တွင်​ကော်​နေ​လိ​နာ​မည်​ရှိ​သူ​လူ တစ်​ယောက်​ရှိ​၏။ သူ​သည် ``ဣ​တ​လိ​တပ်'' ဟု ခေါ်​သော​တပ်​မှ​တပ်​ခွဲ​မှူး​တစ်​ယောက်​ဖြစ်​၏။-"]},{"type":"verse","number":2,"content":["သူ​နှင့်​တ​ကွ​သူ​၏​အိမ်​ထောင်​စု​သား​တို့​သည် ဘု​ရား​တ​ရား​ကြည်​ညို​၍​ဘု​ရား​သ​ခင်​ကို ကြောက်​ရွံ့​ရို​သေ​သူ​များ​ဖြစ်​ကြ​၏။ သူ​သည် ဆင်း​ရဲ​သော​ယု​ဒ​အ​မျိုး​သား​တို့​အား ရက် ရော​စွာ​လှူ​ဒါန်း​တတ်​၏။ သူ​သည်​ဘု​ရား သ​ခင်​ထံ​အ​ချိန်​မှန်​မှန်​ပတ္ထနာ​ပြု​လေ​၏။-"]},{"type":"verse","number":3,"content":["မွန်း​လွဲ​သုံး​နာ​ရီ​ခန့်​အ​ချိန်​၌​ဘု​ရား​သ​ခင် ၏​ကောင်း​ကင်​တ​မန်​သည်​သူ့​ထံ​သို့​လာ​၍ ``ကော် နေ​လိ'' ဟု​ခေါ်​သည်​ကို​ဗျာ​ဒိတ်​ရူ​ပါ​ရုံ​တွင် အ​ထင်​အ​ရှား​မြင်​ရ​၏။"]},{"type":"verse","number":4,"content":["သူ​သည်​ထိတ်​လန့်​လျက်​ကောင်း​ကင်​တ​မန်​ကို စိုက်​ကြည့်​ပြီး​လျှင် ``အ​ရှင်၊ အ​ဘယ်​အ​မှု အ​ခင်း​ရှိ​ပါ​သ​နည်း'' ဟု​မေး​လျှောက်​၏။ ကောင်း​ကင်​တ​မန်​က​လည်း ``သင်​၏​ဆု​တောင်း ပတ္ထ​နာ​နှင့်​စွန