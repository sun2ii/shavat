{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"ACT","translationId":"mya_ojv","name":"တမန်တော်ဝတ္ထု","commonName":"တမန်တော်ဝတ္ထု","title":"တမန်တော်ဝတ္ထု","order":44,"numberOfChapters":28,"sha256":"319ecad817efbefd2f24f841576fe730cccfab07fdbec204e5acb1dbc418630c","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/ACT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/mya_ojv/ACT/28.json","totalNumberOfVerses":993},"chapter":{"number":13,"content":[{"type":"heading","content":["ဗာ​န​ဗ​နှင့်​ရှော​လု​တို့​အား အ​သင်း​တော်​က​ရွေး​ချယ်​စေ​လွှတ်​ခြင်း"]},{"type":"verse","number":1,"content":["အန္တိ​အုတ်​မြို့​အ​သင်း​တော်​တွင် ပ​ရော​ဖက်​များ နှင့်​ဆ​ရာ​များ​ရှိ​၏။ ထို​သူ​တို့​ကား​ဗာ​န​ဗ၊ နိ​ဂါ​ခေါ်​ရှုမောင်၊ ကု​ရေ​နေ​ပြည်​သား​လု​ကိ၊ (စော်​ဘွား​ဟေ​ရုဒ်​၏​ငယ်​သူ​ငယ်​ချင်း​ဖြစ်​သူ) မာ​နင်​နှင့်​ရှော​လု​တို့​တည်း။-"]},{"type":"verse","number":2,"content":["ထို​သူ​တို့​သည်​သ​ခင်​ဘု​ရား​၏​အ​မှု​တော် ကို​ဆောင်​ရွက်​၍ အ​စာ​ရှောင်​လျက်​နေ​ကြ​စဉ် သန့်​ရှင်း​သော​ဝိ​ညာဉ်​တော်​က​သူ​တို့​အား ``ရှော​လု နှင့်​ဗာ​န​ဗ​တို့​ကို ငါ​၏​အ​မှု​တော်​ဆောင်​ရန် အ​တွက်​သီး​သန့်​ရွေး​ချယ်​ကြ​လော့'' ဟု​မိန့် တော်​မူ​၏။"]},{"type":"verse","number":3,"content":["ထို​အ​ခါ​သူ​တို့​သည်​အ​စာ​ရှောင်​၍​ဆု တောင်း​ပတ္ထ​နာ​ပြု​ပြီး​လျှင် ဗာ​န​ဗ​နှင့်​ရှော​လု တို့​၏​ဦး​ခေါင်း​ပေါ်​တွင်​မိ​မိ​တို့​လက်​ကို​တင် ကြ​၏။ ထို​နောက်​သူ​တို့​အား​အ​မှု​တော် ဆောင်​ရွက်​ရန်​စေ​လွှတ်​လိုက်​ကြ​၏။"]},{"type":"heading","content":["ကု​ပ​ရု​ကျွန်း​တွင်​အ​မှု​တော်​ဆောင်​