{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"ACT","translationId":"mya_ojv","name":"တမန်တော်ဝတ္ထု","commonName":"တမန်တော်ဝတ္ထု","title":"တမန်တော်ဝတ္ထု","order":44,"numberOfChapters":28,"sha256":"319ecad817efbefd2f24f841576fe730cccfab07fdbec204e5acb1dbc418630c","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/ACT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/mya_ojv/ACT/28.json","totalNumberOfVerses":993},"chapter":{"number":19,"content":[{"type":"heading","content":["ဧ​ဖက်​မြို့​သို့​ပေါ​လု​ရောက်​ရှိ​ခြင်း"]},{"type":"verse","number":1,"content":["ကော​ရိန္သု​မြို့​တွင်​အာ​ပေါ​လု​ရှိ​နေ​စဉ်​ပေါ​လု သည် အ​ထက်​ပါ​ဒေ​သ​တစ်​လျှောက်​သို့​လှည့်​လည် ပြီး​နောက် ဧ​ဖက်​မြို့​သို့​ရောက်​ရှိ​လာ​၏။ ထို​မြို့​တွင် တ​ပည့်​တော်​အ​ချို့​တို့​ကို​တွေ့​၍၊-"]},{"type":"verse","number":2,"content":["``သင်​တို့​သည်​ယုံ​ကြည်​သူ​များ​ဖြစ်​လာ​ကြ သော​အ​ခါ သန့်​ရှင်း​သော​ဝိ​ညာဉ်​တော်​ကို​ခံ ယူ​ရ​ကြ​ပါ​၏​လော'' ဟု​မေး​၏။ ထို​သူ​တို့​က ``သန့်​ရှင်း​သော​ဝိ​ညာဉ်​တော်​ရှိ တော်​မူ​ကြောင်း​ကို​ပင် ကျွန်ုပ်​တို့​မ​ကြား​ဘူး ပါ'' ဟု​ဆို​ကြ​၏။"]},{"type":"verse","number":3,"content":["ပေါ​လု​က ``ဤ​သို့​ဖြစ်​ပါ​မူ​သင်​တို့​သည် အ​ဘယ်​မည်​သော​ဗတ္တိ​ဇံ​မင်္ဂ​လာ​ကို​ခံ​ခဲ့ ကြ​ပါ​သ​နည်း'' ဟု​မေး​၏။ သူ​တို့​က ``ယော​ဟန်​၏​ဗတ္တိ​ဇံ​မင်္ဂ​လာ​ကို ခံ​ခဲ့​ပါ​သည်'' ဟု​ဆို​ကြ​၏။"]},{"type":"verse","number":4,"content":["ပေါ​လု​က ``ယော​ဟန်​၏​ဗတ္တိ​ဇံ​မင်္ဂ​လာ​သည် နောင်​တ​ရ​သူ​တို့​အ​ဖို့​ဖြစ်​၏။ ယော​ဟန်​သည် မိ​မိ​၏​နောက်​တွင်​ကြွ​လာ​တော်​မူ​မည့်​အ​