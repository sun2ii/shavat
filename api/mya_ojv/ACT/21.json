{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"ACT","translationId":"mya_ojv","name":"တမန်တော်ဝတ္ထု","commonName":"တမန်တော်ဝတ္ထု","title":"တမန်တော်ဝတ္ထု","order":44,"numberOfChapters":28,"sha256":"319ecad817efbefd2f24f841576fe730cccfab07fdbec204e5acb1dbc418630c","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/ACT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/mya_ojv/ACT/28.json","totalNumberOfVerses":993},"chapter":{"number":21,"content":[{"type":"heading","content":["ယေ​ရု​ရှ​လင်​မြို့​သို့​ပေါ​လု​ရောက်​ရှိ​ခြင်း"]},{"type":"verse","number":1,"content":["ကျွန်ုပ်​တို့​သည်​ထို​သူ​တို့​ထံ​မှ​ခွဲ​ခွာ​ပြီး​လျှင် တည့်​တည့်​သင်္ဘော​လွှင့်​၍​ကော​သ​ကျွန်း​သို့​ရောက် ကြ​၏။ နောက်​တစ်​နေ့​၌​ရော​ဒု​ကျွန်း​သို့​လည်း ကောင်း၊ ထို​ကျွန်း​မှ​တစ်​ဖန်​ပါ​တ​ရ​မြို့​သို့ လည်း​ကောင်း​ရောက်​ကြ​၏။-"]},{"type":"verse","number":2,"content":["ဖိ​နိတ်​ပြည်​သို့​သွား​မည့်​သင်္ဘော​တစ်​စင်း​ကို တွေ့​သ​ဖြင့် ထို​သင်္ဘော​ပေါ်​သို့​တက်​၍​ခ​ရီး ပြု​ကြ​ပြီး​နောက်၊-"]},{"type":"verse","number":3,"content":["ကျွန်ုပ်​တို့​သည်​ကု​ပ​ရု​ကျွန်း​ကို​မြင်​ရ​သော​အ​ခါ ထို​ကျွန်း​၏​တောင်​ဘက်​မှ​ဖြတ်​၍​ရှု​ရိ​ပြည်​သို့ သင်္ဘော​လွှင့်​ကြ​လေ​သည်။ တု​ရု​မြို့​တွင်​ကုန်​ပစ္စည်း များ​ကို​ချ​ရ​မည်​ဖြစ်​၍ ထို​မြို့​တွင်​သင်္ဘော​ကို ဆိုက်​ကပ်​ကြ​၏။-"]},{"type":"verse","number":4,"content":["ထို​အ​ရပ်​တွင်​ယုံ​ကြည်​သူ​အ​ချို့​တို့​ကို​တွေ့ သ​ဖြင့် ကျွန်ုပ်​တို့​သည်​သူ​တို့​နှင့်​အ​တူ​ခု​နစ် ရက်​မျှ​နေ​ကြ​၏။ ထို​တ​ပည့်​တော်​တို့​သည် ဝိ​ညာဉ်​တော်​၏​တ