{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"DAN","translationId":"mya_ojv","name":"ဒံ​ယေ​လ","commonName":"ဒံ​ယေ​လ","title":"ဒံ​ယေ​လ​အ​နာ​ဂတ္တိ​ကျမ်း","order":27,"numberOfChapters":12,"sha256":"97691c139cb2c15697a3b024667379cf92f0d674d6e9d2d9ccbbe70e5131fdef","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/DAN/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/mya_ojv/DAN/12.json","totalNumberOfVerses":354},"chapter":{"number":9,"content":[{"type":"heading","content":["မိ​မိ​၏​လူ​မျိုး​အ​တွက်​ဒံ​ယေ​လ​ဆု​တောင်း​ခြင်း"]},{"type":"verse","number":1,"content":["မေ​ဒိ​လူ​မျိုး​ဖြစ်​သူ​အာ​ရွှေ​ရု​၏​သား​တော် ဒါ​ရိ​သည် ဗာ​ဗု​လုန်​နိုင်​ငံ​တွင်​မင်း​ပြု​တော် မူ​၏။-"]},{"type":"verse","number":2,"content":["သူ​၏​နန်း​စံ​ပ​ထ​မ​နှစ်​၌​ငါ​ဒံ​ယေ​လ​သည် ကျမ်း​စာ​တော်​များ​ကို​လေ့​လာ​ကာ​ပ​ရော ဖက်​ယေ​ရ​မိ​အား ဘု​ရား​သခင်​မိန့်​တော်​မူ သည်​အ​တိုင်း​အ​နှစ်​ခု​နစ်​ဆယ်​တိုင်​တိုင် ယေ​ရု​ရှ​လင်​မြို့​ပျက်​စီး​ရ​မည်​အ​ကြောင်း ကို​စဉ်း​စား​ဆင်​ခြင်​လျက်​နေ​၏။-"]},{"type":"verse","number":3,"content":["ထို​နောက်​ငါ​သည်​အ​စာ​ရှောင်​ပြီး​လျှင်​လျှော် တေ​ကို​ဝတ်​၍ ပြာ​ထဲ​တွင်​ထိုင်​ကာ ထာ​ဝ​ရ ဘု​ရား​သ​ခင်​ထံ​တော်​သို့​ဆု​တောင်း​အ​သ နား​ခံ​၏။-"]},{"type":"verse","number":4,"content":["ငါ​သည်​ငါ​၏​ဘု​ရား​သ​ခင်​ထာ​ဝ​ရ​ဘု​ရား အား ဆု​တောင်း​ပတ္ထနာ​ပြု​၍​ငါ့​လူ​မျိုး​၏ အ​ပြစ်​များ​ကို​ဖော်​ပြ​ဝန်​ခံ​၏။ ငါ​က``အို ထာ​ဝ​ရ​အ​ရှင်​ဘု​ရား​သ​ခင်၊ ကိုယ်​တော်​သည်​ကြီး​မြတ်​တော်​မူ​သည်​ဖြစ်​၍ အ​ကျွန်ုပ်​တို့​သည်​ကိုယ်​တော်​ကို​ချီး​ကူး​ကြ ပါ