{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"EST","translationId":"mya_ojv","name":"ဧ​သ​တာ","commonName":"ဧ​သ​တာ","title":"ဧ​သ​တာ​ဝတ္ထု","order":17,"numberOfChapters":10,"sha256":"4dfe859c4fc4fff9c5766f860e846a09134579a79e150821d05cba1f85852ea6","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/EST/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/mya_ojv/EST/10.json","totalNumberOfVerses":160},"chapter":{"number":9,"content":[{"type":"heading","content":["ရန်​သူ​များ​ကို​ယု​ဒ​အ​မျိုး​သား​တို့​ချေ​မှုန်း​ခြင်း"]},{"type":"verse","number":1,"content":["အာ​ဒါ​လ​ဆယ့်​သုံး​ရက်​နေ့​ကျ​ရောက်​လာ​၏။ ထို​နေ့​ရက်​သည်​ဘု​ရင့်​ကြေ​ညာ​ချက်​စ​တင် အ​တည်​ဖြစ်​သည့်​နေ့၊ မိ​မိ​တို့​လက်​တွင်း​သို့ ယု​ဒ​အ​မျိုး​သား​များ​ရောက်​ရှိ​လာ​ရန်​အ တွက်​ရန်​သူ​တို့​စောင့်​မျှော်​နေ​သော​နေ့​ဖြစ်​၏။ သို့​ရာ​တွင်​သူ​တို့​မျှော်​လင့်​သည့်​အ​တိုင်း မ​ဖြစ်​ဘဲ​ယု​ဒ​အ​မျိုး​သား​တို့​က​သူ တို့​အား​အ​နိုင်​ရ​ကြ​လေ​သည်။-"]},{"type":"verse","number":2,"content":["အင်​ပါ​ယာ​နိုင်​ငံ​တော်​အ​တွင်း​မြို့​တိုင်း​၌ ယု​ဒ​အ​မျိုး​သား​များ​သည် ဘေး​အန္တ​ရာယ် ပြု​မည့်​သူ​တို့​ကို​တိုက်​ခိုက်​ရန်​မိ​မိ​တို့​ရပ် ကွက်​များ​တွင်​စု​ရုံး​လျက်​နေ​ကြ​၏။ အ​ရပ် ရပ်​ရှိ​လူ​တို့​သည်​သူ​တို့​အား​ကြောက်​လန့် ကြ​၏။ အ​ဘယ်​သူ​မျှ​သူ​တို့​ကို​ခု​ခံ တိုက်​ခိုက်​နိုင်​စွမ်း​မ​ရှိ​ချေ။-"]},{"type":"verse","number":3,"content":["အ​မှန်​အား​ဖြင့်​ဆို​သော်​အုပ်​ချုပ်​ရေး​မှူး များ၊ ဘု​ရင်​ခံ​များ​နှင့်​ဘု​ရင့်​အ​မှု​တော် ထမ်း​များ​ဖြစ်​သည့်​ပြည်​နယ်​အ​ရာ​ရှိ အ​ပေါင်း​တို့