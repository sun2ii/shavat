{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"EXO","translationId":"mya_ojv","name":"ထွက်​မြောက်","commonName":"ထွက်​မြောက်","title":"ထွက်​မြောက်​ရာ​ကျမ်း","order":2,"numberOfChapters":40,"sha256":"ea441566ba0781c88335c274d3f5f186a84f8de88410051352e01bc1b62e2a75","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/mya_ojv/EXO/40.json","totalNumberOfVerses":1187},"chapter":{"number":28,"content":[{"type":"heading","content":["ယဇ်​ပု​ရော​ဟိတ်​တို့​၏​အ​ဝတ်​တန်​ဆာ"]},{"type":"verse","number":1,"content":["``သင်​၏​အစ်​ကို​အာ​ရုန်​နှင့် သူ​၏​သား​များ​ဖြစ် သော​နာ​ဒပ်၊ အ​ဘိ​ဟု၊ ဧ​လာ​ဇာ၊ ဣသ​မာ​တို့ အ​ထဲ​က​ရွေး​ထုတ်​လော့။-"]},{"type":"verse","number":2,"content":["သင့်​အစ်​ကို​အာ​ရုန်​အ​တွက်​ခန့်​ညား​ထည်​ဝါ သော​ယဇ်​ပု​ရော​ဟိတ်​ဝတ်​စုံ​ကို​ချုပ်​လုပ်​ပေး ရ​မည်။-"]},{"type":"verse","number":3,"content":["အာ​ရုန်​သည်​ငါ့​ထံ​၌​ယဇ်​ပု​ရော​ဟိတ်​အ​ဖြစ် ဆက်​ကပ်​၍ အ​မှု​တော်​ကို​ထမ်း​ဆောင်​နိုင်​စေ​ရန်၊ ငါ​ကျွမ်း​ကျင်​မှု​ပ​ညာ​ပေး​ထား​သူ​တို့​ကို​ဆင့် ခေါ်​၍​သူ့​အ​တွက်​ဝတ်​စုံ​ကို​ချုပ်​စေ​ရ​မည်။-"]},{"type":"verse","number":4,"content":["ထို​သူ​တို့​ချုပ်​လုပ်​ရ​မည့်​အ​ထည်​ဝတ်​စုံ​တို့ သည်​ကား ရင်​ဖုံး၊ သင်​တိုင်း၊ ဝတ်​ရုံ၊ ပန်း​ဖောက်​ထား သော​အင်္ကျီ၊ ခေါင်း​ပေါင်း၊ ခါး​ပန်း​တို့​ဖြစ်​သည်။ ထို အ​ဝတ်​တန်​ဆာ​တို့​သည်​သင်​၏​အစ်​ကို​အာ​ရုန် နှင့်​သူ​၏​သား​များ​သည်၊ ယဇ်​ပု​ရော​ဟိတ်​များ အ​ဖြစ် ငါ​၏​အ​မှု​ကို​ထမ်း​ဆောင်​ရာ​၌​ဝတ် ဆင်​ရ​မည့်​ယဇ်​ပု​ရော​ဟိတ်​ဝတ်​စုံ​များ​ဖြ