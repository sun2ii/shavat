{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"EXO","translationId":"mya_ojv","name":"ထွက်​မြောက်","commonName":"ထွက်​မြောက်","title":"ထွက်​မြောက်​ရာ​ကျမ်း","order":2,"numberOfChapters":40,"sha256":"ea441566ba0781c88335c274d3f5f186a84f8de88410051352e01bc1b62e2a75","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/mya_ojv/EXO/40.json","totalNumberOfVerses":1187},"chapter":{"number":29,"content":[{"type":"heading","content":["အာ​ရုန်​နှင့်​သူ​၏​သား​များ​ကို​ယဇ်​ပု​ရော​ဟိတ်​များ အ​ဖြစ်​ဘိ​သိက်​ပေး​ခြင်း"]},{"type":"verse","number":1,"content":["``ယဇ်​ပု​ရော​ဟိတ်​များ​အ​ဖြစ်​ငါ​၏​အ​မှု​တော် ကို​ထမ်း​ဆောင်​ရန်​အာ​ရုန်​နှင့်​သူ​၏​သား​တို့​အား ဤ​သို့​ဆက်​ကပ်​ရ​မည်။ အ​ပြစ်​အ​နာ​ကင်း​သော နွား​ပေါက်​တစ်​ကောင်​နှင့်​သိုး​ထီး​နှစ်​ကောင်​ကို ယူ​ခဲ့​လော့။-"]},{"type":"verse","number":2,"content":["ဆီ​ပါ​သော​မုန့်၊ ဆီ​လူး​သော​မုန့်​ချပ်​တို့​ကို လည်း​ယူ​လော့။ ထို​မုန့်​များ​ကို​တ​ဆေး​မ​ပါ သော​အ​ကောင်း​ဆုံး​ဂျုံ​မုန့်​ညက်​ဖြင့်​ပြု​လုပ် ရ​မည်။-"]},{"type":"verse","number":3,"content":["ထို​မုန့်​များ​ကို​တောင်း​တစ်​လုံး​တွင်​ထည့် လော့။ နွား​နှင့်​သိုး​နှစ်​ကောင်​ကို​ယဇ်​ပူ​ဇော် သော​အ​ခါ၊ မုန့်​များ​ကို​ပါ​ငါ့​အား​ပူ​ဇော် လော့။"]},{"type":"verse","number":4,"content":["``အာ​ရုန်​နှင့်​သူ​၏​သား​များ​ကို ငါ​စံ​ရာ​တဲ တော်​တံ​ခါး​ဝ​သို့​ခေါ်​ဆောင်​ခဲ့​ပြီး​လျှင် သူ တို့​အား​ရေ​ချိုး​စေ​ရ​မည်။-"]},{"type":"verse","number":5,"content":["ထို​နောက်​ယဇ်​ပု​ရော​ဟိတ်​အ​ဝတ်​