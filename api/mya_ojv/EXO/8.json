{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"EXO","translationId":"mya_ojv","name":"ထွက်​မြောက်","commonName":"ထွက်​မြောက်","title":"ထွက်​မြောက်​ရာ​ကျမ်း","order":2,"numberOfChapters":40,"sha256":"ea441566ba0781c88335c274d3f5f186a84f8de88410051352e01bc1b62e2a75","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/mya_ojv/EXO/40.json","totalNumberOfVerses":1187},"chapter":{"number":8,"content":[{"type":"heading","content":["ဒု​တိ​ယ​ဘေး​ဒဏ်"]},{"type":"heading","content":["ဖား"]},{"type":"verse","number":1,"content":["ထာ​ဝ​ရ​ဘု​ရား​က​မော​ရှေ​အား``ဘု​ရင်​ထံ သို့​သွား​၍`ငါ​ထာ​ဝ​ရ​ဘု​ရား​အား​ဝတ်​ပြု နိုင်​ရန် ငါ​၏​လူ​မျိုး​တော်​ကို​သွား​ခွင့်​ပြု လော့။-"]},{"type":"verse","number":2,"content":["သင်​သည်​သူ​တို့​ကို​သွား​ခွင့်​မ​ပြု​လျှင် ငါ သည်​သင်​၏​တစ်​တိုင်း​ပြည်​လုံး​ကို​ဖား​ဖြင့် ဒဏ်​ခတ်​မည်။-"]},{"type":"verse","number":3,"content":["မြစ်​ထဲ​တွင်​ဖား​များ​ဖြင့်​ပြည့်​စေ​မည်။ ထို​ဖား တို့​သည်​မြစ်​ထဲ​မှ​သင်​၏​နန်း​တော်၊ အိပ်​ခန်း၊ အိပ်​ရာ၊ သင်​၏​မှူး​မတ်​နှင့်​ပြည်​သား​တို့​၏​အိမ် များ၊ သင်​၏​မီး​ဖို​နှင့်​မုန့်​နယ်​ရာ​ခွက်​များ​သို့ တက်​လာ​ကြ​လိမ့်​မည်။-"]},{"type":"verse","number":4,"content":["ဖား​တို့​သည်​သင်​နှင့်​သင်​၏​မှူး​မတ်၊ ပြည်​သူ​တို့ အ​ပေါ်​သို့​ခုန်​တက်​ကြ​လိမ့်​မည်' ဟု​ပြော​လော့'' ဟူ​၍​မိန့်​တော်​မူ​၏။"]},{"type":"verse","number":5,"content":["တစ်​ဖန်​ထာ​ဝ​ရ​ဘု​ရား​က``အာ​ရုန်​အား​မြစ် များ၊ ချောင်း​များ၊ အင်း​အိုင်​များ​ပေါ်​သို့​သ