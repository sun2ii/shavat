{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"EZK","translationId":"mya_ojv","name":"ယေ​ဇ​ကျေ​လ","commonName":"ယေ​ဇ​ကျေ​လ","title":"ယေ​ဇ​ကျေ​လ​အ​နာ​ဂတ္တိ​ကျမ်း","order":26,"numberOfChapters":48,"sha256":"d04c37208c0c0e52a31c750d97e24b45387b0c9715c595d020d5eeb77d379876","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/mya_ojv/EZK/48.json","totalNumberOfVerses":1227},"chapter":{"number":13,"content":[{"type":"heading","content":["ပ​ရော​ဖက်​အ​တု​တို့​အား​ရှုတ်​ချခြင်း"]},{"type":"verse","number":1,"content":["ထာ​ဝ​ရ​ဘု​ရား​၏​နှုတ်​က​ပတ်​တော်​သည် ငါ့​ထံ​သို့​ရောက်​လာ​၏။-"]},{"type":"verse","number":2,"content":["ကိုယ်​တော်​က``အ​ချင်း​လူ​သား၊ ဣ​သ​ရေ​လ အ​မျိုး​သား​တို့​၏​ပ​ရော​ဖက်​များ​ကို​ရှုတ်​ချ လော့။ ဗျာ​ဒိတ်​စ​ကား​များ​ကို မိ​မိ​တို့​ကိုယ်​တိုင် လုပ်​ကြံ​ဟော​ပြော​ကြ​သူ​တို့​အား ထာ​ဝ​ရ ဘု​ရား​၏​အ​မိန့်​တော်​ကို​နား​ထောင်​ကြ​ရန် ပြော​ကြား​လော့'' ဟု​မိန့်​တော်​မူ​၏။"]},{"type":"verse","number":3,"content":["အ​ရှင်​ထာ​ဝရ​ဘု​ရား​က``ဤ​ပ​ရော​ဖက်​မိုက် တို့​သည်​အ​မင်္ဂ​လာ​ရှိ​ကြ​၏။ သူ​တို့​သည်​ငါ ၏​ဝိ​ညာဉ်​တော်​နှိုး​ဆော်​ခြင်း​ကို​မ​ခံ​ရ​ဘဲ မိ​မိ​တို့​ကိုယ်​တိုင်​ဗျာ​ဒိတ်​ရူ​ပါ​ရုံ​များ ကို​လုပ်​ကြံ​ဟော​ပြော​ကြ​၏။-"]},{"type":"verse","number":4,"content":["ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့၊ သင်​တို့​၏​ပ​ရော ဖက်​များ​သည် ယို​ယွင်း​ပျက်​စီး​နေ​သော​မြို့​ရှိ ခွေး​အ​များ​နှင့်​တူ​ကြ​၏။-"]},{"type":"verse","number":5,"content":["ထို​ပ​ရော​ဖက်​တို့​သည်​မြို့​ရိုး​မျ