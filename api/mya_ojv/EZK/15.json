{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"EZK","translationId":"mya_ojv","name":"ယေ​ဇ​ကျေ​လ","commonName":"ယေ​ဇ​ကျေ​လ","title":"ယေ​ဇ​ကျေ​လ​အ​နာ​ဂတ္တိ​ကျမ်း","order":26,"numberOfChapters":48,"sha256":"d04c37208c0c0e52a31c750d97e24b45387b0c9715c595d020d5eeb77d379876","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/mya_ojv/EZK/48.json","totalNumberOfVerses":1227},"chapter":{"number":15,"content":[{"type":"heading","content":["စ​ပျစ်​နွယ်​အ​ကြောင်း​ပုံ​ဥ​ပ​မာ"]},{"type":"verse","number":1,"content":["ထာ​ဝ​ရ​ဘု​ရား​၏​နှုတ်​က​ပတ်​တော်​သည် ငါ့​ထံ​သို့​ရောက်​လာ​၏။-"]},{"type":"verse","number":2,"content":["ကိုယ်​တော်​က``အ​ချင်း​လူ​သား၊ စ​ပျစ်​ပင်​သည် သာ​မန်​သစ်​ပင်​နှင့်​အ​ဘယ်​သို့​ခြား​နား​သ​နည်း။ စ​ပျစ်​နွယ်​သား​သည်​တော​မှ​သစ်​ပင်​များ​၏ သစ်​ကိုင်း​များ​နှင့်​အ​သုံး​ဝင်​ပုံ​မည်​သို့​ခြား နား​သ​နည်း။-"]},{"type":"verse","number":3,"content":["သင်​သည်​စ​ပျစ်​နွယ်​သား​ဖြင့်​အ​ဘယ်​အ​ရာ ကို​ပြု​လုပ်​နိုင်​သ​နည်း။ ပစ္စည်း​တစ်​စုံ​တစ်​ခု ကို​ဆွဲ​ချိတ်​ရန်​အ​တွက်​ယင်း​ကို​အ​စို့​အ​ဖြစ် ဖြင့်​အ​သုံး​ပြု​နိုင်​သ​လော။-"]},{"type":"verse","number":4,"content":["စ​ပျစ်​ပင်​သည်​မီး​မွှေး​ရန်​အ​တွက်​သာ​လျှင် ကောင်း​၏။ အဖျား​ပိုင်း​များ​လောင်​ကျွမ်း​၍​အ​လယ် ပိုင်း​သည်​ပြာ​ဖြစ်​သွား​သော​အ​ခါ သင်​သည် ထို​စ​ပျစ်​ပင်​ကို​အ​ဘယ်​သို့​အ​သုံး​ပြု​နိုင် မည်​နည်း။-"]},{"type":"verse","number":5,"content":["ယင်း​သည်​မီး​မ​ရှို့​မီ​အ​ခါ​က​လည်း​အ​သုံး မ​ဝင်။ မီး​ရှို့​၍​ပြာ​ဖြစ်​သွား​သော​အ​ခါ​၌ လည်း ပို​၍​ပင်​အ​သုံး​မ​ဝင်​ချေ'' ဟု​မိန့် တော်​မူ​၏။"]},{"type":"verse","number":6,"content":["အ​ရှင်​ထာ​ဝ​ရ​ဘု​ရား​မိန့်​တော်​မူ​သည် ကား``စ​ပျစ်​နွယ်​သား​ကို​တော​မှ​ယူ​၍​မီး မွှေး​ကြ​သ​ကဲ့​သို့ ငါ​သည်​ယေ​ရု​ရှ​လင် မြို့​မှ​လူ​တို့​ကို​ယူ​၍၊-"]},{"type":"verse","number":7,"content":["အ​ပြစ်​ဒဏ်​ခတ်​မည်။ သူ​တို့​သည်​မီး​ဘေး တစ်​ခု​မှ​လွတ်​မြောက်​ခဲ့​ကြ​သော်​လည်း ယ​ခု အ​ခါ​၌​အ​ခြား​မီး​ဘေး​တစ်​ခု​သင့်​ကြ လိမ့်​မည်။ ထို​သူ​တို့​အ​ပြစ်​ဒဏ်​ခံ​ရ​ကြ သော​အ​ခါ ငါ​သည်​ထာ​ဝ​ရ​ဘု​ရား​ဖြစ် တော်​မူ​ကြောင်း​သင်​တို့​သိ​ရှိ​ကြ​လိမ့်​မည်။-"]},{"type":"verse","number":8,"content":["သူ​တို့​သည်​ငါ့​အား​သစ္စာ​ဖောက်​ကြ​သ​ဖြင့် ငါ​သည်​သူ​တို့​၏​ပြည်​ကို​လူ​သူ​ကင်း​မဲ့ စေ​မည်'' ဟူ​၍​တည်း။ ဤ​ကား​အ​ရှင်​ထာ​ဝ​ရ ဘု​ရား​မိန့်​တော်​မူ​သော​စ​ကား​ဖြစ်​၏။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/EZK/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/EZK/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/EZK/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}