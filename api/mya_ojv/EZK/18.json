{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"EZK","translationId":"mya_ojv","name":"ယေ​ဇ​ကျေ​လ","commonName":"ယေ​ဇ​ကျေ​လ","title":"ယေ​ဇ​ကျေ​လ​အ​နာ​ဂတ္တိ​ကျမ်း","order":26,"numberOfChapters":48,"sha256":"d04c37208c0c0e52a31c750d97e24b45387b0c9715c595d020d5eeb77d379876","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/mya_ojv/EZK/48.json","totalNumberOfVerses":1227},"chapter":{"number":18,"content":[{"type":"heading","content":["တစ်​ဦး​ချင်း​၌​တာ​ဝန်​ရှိ​ခြင်း"]},{"type":"verse","number":1,"content":["ထာ​ဝ​ရ​ဘု​ရား​နှုတ်​က​ပတ်​တော်​သည်​ငါ့ ထံ​သို့​ရောက်​လာ​၏။-"]},{"type":"verse","number":2,"content":["ကိုယ်​တော်​က",{"text":"``မိ​ဘ​တို့​စ​ပျစ်​ချဉ်​သီး​ကို​သုံး​ဆောင်​ခြင်း ကြောင့်၊ သား​သ​မီး​များ​သွား​ကျိန်း​ရ​ကြ​၏''","poem":1},"ဟူ​သော​စ​ကား​ပုံ​ကို​ဣ​သ​ရေ​လ​အ​မျိုး သား​တို့ ထပ်​ကာ​ထပ်​ကာ​ပြော​ဆို​နေ​ကြ​ရာ ၌​အ​ဘယ်​သို့​ဆို​လို​သ​နည်း။''"]},{"type":"verse","number":3,"content":["``ငါ​သည်​အ​သက်​ရှင်​တော်​မူ​သော​ဘု​ရား ဖြစ်​သည်​နှင့်​အ​ညီ ဣ​သ​ရေ​လ​နိုင်​ငံ​တွင် ဤ​စ​ကား​ပုံ​ကို​နောက်​တစ်​ဖန်​သုံး​စွဲ​ရ တော့​မည်​မ​ဟုတ်။-"]},{"type":"verse","number":4,"content":["အ​ဖ​၏​အ​သက်​ကို​ငါ​ပိုင်​၏။ သား​၏​အ​သက် ကို​လည်း​ငါ​ပိုင်​၏။ လူ​တိုင်း​၏​အ​သက်​ကို ငါ​ပိုင်​၏။ သေ​ရ​မည့်​သူ​ကား​အ​ပြစ်​ကူး​လွန် သူ​ပင်​ဖြစ်​၏။"]},{"type":"verse","number":5,"content":["``အ​ကယ်​၍​ကောင်း​မြတ်​ဖြောင့်​မတ်​၍​ရိုး​သား သူ​ရှိ​အံ့။-"]},{"type":"verse","number":6,"content":["သူ​သည်​ဣ​