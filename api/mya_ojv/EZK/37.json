{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"EZK","translationId":"mya_ojv","name":"ယေ​ဇ​ကျေ​လ","commonName":"ယေ​ဇ​ကျေ​လ","title":"ယေ​ဇ​ကျေ​လ​အ​နာ​ဂတ္တိ​ကျမ်း","order":26,"numberOfChapters":48,"sha256":"d04c37208c0c0e52a31c750d97e24b45387b0c9715c595d020d5eeb77d379876","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/mya_ojv/EZK/48.json","totalNumberOfVerses":1227},"chapter":{"number":37,"content":[{"type":"heading","content":["သွေ့​ခြောက်​သော​အ​ရိုး​များ​ဖြင့် ဖုံး​လွှမ်း​သည့်​ချိုင့်​ဝှမ်း"]},{"type":"verse","number":1,"content":["ထာ​ဝ​ရ​ဘု​ရား​၏​တန်​ခိုး​တော်​သည်​ငါ့​ကို လွှမ်း​မိုး​၍​ကိုယ်​တော်​၏​ဝိ​ညာဉ်​တော်​သည် ငါ့ ကို​ဆောင်​သွား​ပြီး​လျှင်​အ​ရိုး​များ​ဖြင့်​ဖုံး လွှမ်း​နေ​သည့်​ချိုင့်​ဝှမ်း​တွင်​ချ​ထား​တော် မူ​၏။-"]},{"type":"verse","number":2,"content":["ကိုယ်​တော်​သည်​ငါ့​အား​ထို​ချိုင့်​ဝှမ်း​တစ်​လျှောက် သို့​ခေါ်​ဆောင်​သွား​တော်​မူ​သ​ဖြင့် ထို​အ​ရပ်​၌ အ​ရိုး​အ​မြောက်​အ​မြား​ရှိ​သည့်​အ​ပြင်၊ ထို အ​ရိုး​တို့​သည်​အ​လွန်​သွေ့​ခြောက်​လျက်​နေ သည်​ကို​လည်း​ငါ​မြင်​ရ​လေ​သည်။-"]},{"type":"verse","number":3,"content":["ကိုယ်​တော်​က``အ​ချင်း​လူ​သား​ဤ​အ​ရိုး​တို့ သည်​ပြန်​၍​အ​သက်​ရှင်​နိုင်​ကြ​မည်​လော'' ဟု​ငါ့​အား​မေး​တော်​မူ​လျှင်၊ ငါ​က``အို အ​ရှင်​ထာ​ဝရ​ဘု​ရား၊ ဤ​မေး​ခွန်း ကို​ကိုယ်​တော်​ရှင်​သာ​လျှင်​ဖြေ​ကြား​တော် မူ​နိုင်​ပါ​၏'' ဟု​လျှောက်​ထား​၏။"]},{"type":"verse","number":4,"content":["ကိုယ်​တော်​က``အ​ရိုး​တို့​အား​ဟော​ပြော​လော့။ ထာ​ဝ​ရ​ဘု