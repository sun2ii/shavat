{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"EZK","translationId":"mya_ojv","name":"ယေ​ဇ​ကျေ​လ","commonName":"ယေ​ဇ​ကျေ​လ","title":"ယေ​ဇ​ကျေ​လ​အ​နာ​ဂတ္တိ​ကျမ်း","order":26,"numberOfChapters":48,"sha256":"d04c37208c0c0e52a31c750d97e24b45387b0c9715c595d020d5eeb77d379876","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/mya_ojv/EZK/48.json","totalNumberOfVerses":1227},"chapter":{"number":40,"content":[{"type":"heading","content":["ယေ​ဇ​ကျေ​လ​အား​ယေ​ရု​ရှ​လင်​မြို့​သို့​ခေါ်​ဆောင်​သွား​ခြင်း"]},{"type":"verse","number":1,"content":["နေ့​ရက်​ကား​ငါ​တို့​ပြည်​နှင်​ဒဏ်​ခံ​ရ​ပြီး​နောက်​နှစ်​ဆယ့်​ငါး​နှစ်​မြောက်၊ ပ​ထ​မ​လ၊ လ​ဆန်း​ဆယ်​ရက်​နေ့၊ ယေ​ရု​ရှ​လင်​မြို့​အ​သိမ်း​ခံ​ရ​ချိန်​တစ်​ဆယ့်​လေး​နှစ်​စေ့​သော​နေ့​ဖြစ်​၏။ ထို​နေ့​၌​ငါ​သည်​ထာ​ဝ​ရ​ဘု​ရား​၏​တန်​ခိုး​တော်​လွှမ်း​မိုး​ခြင်း​ခံ​ရ​ပြီး​လျှင် ကိုယ်​တော်​သည်​ငါ့​အား​ဆောင်​ယူ​သွား​တော်​မူ​၏။-"]},{"type":"verse","number":2,"content":["ဗျာ​ဒိတ်​ရူ​ပါ​ရုံ​တွင်​ငါ့​အား​ဘု​ရား​သ​ခင်​သည် ဣ​သ​ရေ​လ​ပြည်​သို့​ခေါ်​ဆောင်​တော်​မူ​၍ မြင့်​သော​တောင်​ပေါ်​တွင်​ချ​ထား​တော်​မူ​၏။ ထို​တောင်​၏​တောင်​ဘက်​၌​မြို့​တစ်​မြို့​နှင့်​တူ​သော​အ​ဆောက်​အ​အုံ​များ​ကို​ငါ​မြင်​ရ​၏။-"]},{"type":"verse","number":3,"content":["ကိုယ်​တော်​သည်​ငါ့​အား​ထို​မြို့​အ​နီး​သို့​ခေါ်​ဆောင်​သွား​တော်​မူ​သော​အ​ခါ ငါ​သည်​ကြေး​ဝါ​ကဲ့​သို့​တောက်​ပြောင်​လျက်​နေ​သော​လူ​တစ်​ယောက်​ကို​မြင်​ရ​၏။ သူ​သည်​ပေ​ကြိုး​နှင့်​တိုင်း​တာ​ရန် ကူ​လုံး​တို့​ကို​ကိုင်​