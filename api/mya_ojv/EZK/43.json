{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"EZK","translationId":"mya_ojv","name":"ယေ​ဇ​ကျေ​လ","commonName":"ယေ​ဇ​ကျေ​လ","title":"ယေ​ဇ​ကျေ​လ​အ​နာ​ဂတ္တိ​ကျမ်း","order":26,"numberOfChapters":48,"sha256":"d04c37208c0c0e52a31c750d97e24b45387b0c9715c595d020d5eeb77d379876","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/mya_ojv/EZK/48.json","totalNumberOfVerses":1227},"chapter":{"number":43,"content":[{"type":"heading","content":["ဗိ​မာန်​တော်​သို့​ထာ​ဝရ​ဘု​ရား​ပြန်​လည် ကြွ​လာ​တော်​မူ​ခြင်း"]},{"type":"verse","number":1,"content":["ထို​လူ​သည်​ငါ့​အား​အ​ရှေ့​ဘက်​သို့​မျက် နှာ​မူ​နေ​သည့်​မုခ်​ပေါက်​သို့​ခေါ်​ဆောင်​သွား ၏။-"]},{"type":"verse","number":2,"content":["ထို​အ​ရပ်​တွင်​ဣသ​ရေ​လ​အ​မျိုး​သား​တို့ ၏​ဘု​ရား​သ​ခင်​၏​တောက်​ပ​သော​ဘုန်း အ​သ​ရေ​တော်​သည်​အ​ရှေ့​အ​ရပ်​မှ​ပေါ် ထွက်​လာ​သည်​ကို​ငါ​မြင်​ရ​၏။ ဘု​ရား​သ​ခင်​၏​အ​သံ​တော်​သည်​ပင်​လယ်​မြည် ဟည်း​သံ​နှင့်​တူ​၏။ ကမ္ဘာ​မြေ​ကြီး​သည် လည်း​ကိုယ်​တော်​၏​ဘုန်း​အ​သ​ရေ​တော် နှင့်​တောက်​ပ​လျက်​ရှိ​၏။-"]},{"type":"verse","number":3,"content":["ဤ​ဗျာ​ဒိတ်​ရူ​ပါ​ရုံ​သည်​ယေ​ရု​ရှ​လင်​မြို့ ကို​ဖျက်​ဆီး​တော်​မူ​ရန်​ထာ​ဝ​ရ​ဘု​ရား ကြွ​လာ​တော်​မူ​ချိန်​၌​ငါ​မြင်​ခဲ့​ရ​သော ဗျာ​ဒိတ်​ရူ​ပါ​ရုံ​နှင့်​ခေ​ဗာ​မြစ်​အ​နီး​၌ ငါ​မြင်​ခဲ့​ရ​သော​ဗျာ​ဒိတ်​ရူ​ပါ​ရုံ​တို့​နှင့် တူ​၏။ သို့​ဖြစ်​၍​ငါ​သည်​မြေ​ပေါ်​သို့​ဝမ်း လျား​မှောက်​လှဲ​ချ​ပျပ်​ဝပ်​၏။-"]},{"type":"verse","number":4,"content":["တောက်​ပ​သော​ဘုန်း​အ​သ​ရေ​တော်​သည် အ​ရ