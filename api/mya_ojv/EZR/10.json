]},{"type":"verse","number":30,"content":["ပါ​ဟတ်​မော​ဘ​သား​ချင်း​စု​မှ အ​ဒ​န၊ ခေ​လာ​လ၊ ဗေ​နာ​ယ၊ မာ​သေ​ယ ၊မတ္တ​နိ၊ ဗေ​ဇ​လေ​လ၊ ဗိ​နွိ​နှင့် မ​နာ​ရှေ။"]},{"type":"verse","number":31,"content":["ဟာ​ရိမ်​သား​ချင်း​စု​မှ ဧ​လျေဇာ၊ ဣရှိ​ယ၊ မာ​လ​ခိ၊ ရှေ​မာ​ယ၊ ရှိ​မောင်၊-"]},{"type":"verse","number":32,"content":["ဗင်္ယာ​မိန်၊ မလ္လုတ်​နှင့်​ရှေ​မ​ရိ။"]},{"type":"verse","number":33,"content":["ဟာ​ရှုံ​သား​ချင်း​စု​မှ​မတ္တ​နဲ၊ မတ္တ​သ၊ ဇာ​ဗဒ်၊ ဧ​လိ​ဖ​လက်၊ ယေ​ရ​မဲ၊ မ​နာ​ရှေ​နှင့်​ရှိ​မိ။"]},{"type":"verse","number":34,"content":["ဗာ​နိ​သား​ချင်း​စု​မှ​မာ​ဒဲ၊ အာ​မ​ရံ၊ ဝေ​လ၊ ဗေ​နာ​ယ၊ ပေ​ဒိ၊ ခေ​လု၊ ဝါ​နိ၊ မေ​ရ​မုတ်၊ ဧ​လျာ​ရှိပ်၊ မ​တ္တ​နိ၊ မတ္တနဲ​နှင့်​ယာ​သော။"]},{"type":"verse","number":38,"content":["ဗိ​နွိ​သား​ချင်း​စု​မှ​ရှိ​မိ၊ ရှေ​လ​မိ၊ နာ​သန်၊ အ​ဒါ​ယ၊ မာ​ခ​န​ဒေ​ဗဲ၊ ရှာ​ရှဲ၊ ရှာ​ရဲ၊ အ​ဇ ရေ​လ၊ ရှေ​လ​မိ၊ ရှေ​မ​ရိ၊ ရှလ္လုံ၊ အာ​မ​ရိ နှင့်​ယော​သပ်။"]},{"type":"verse","number":43,"content":["နေ​ဗော​သား​ချင်း​စု​မှ ယေ​လ၊ မတ္တိ​သိ၊ ဇာ​ဗဒ်၊ ဇေ​ဗိ​န၊ ယာ​ဒေါ၊ ယော​လ​နှင့်​ဗေ​နာ​ယ။"]},{"type":"verse","number":44,"content":["ဤ​သူ​အ​ပေါင်း​တို့​သည် လူ​မျိုး​ခြား​အ​မျိုး သ​မီး​များ​နှင့်​အိမ်​ထောင်​ကျ​သူ​များ​ဖြစ် ကြ​၏။ သူ​တို့​သည်​မိ​မိ​တို့​ဇ​နီး​များ​ကို လည်း​ကောင်း၊ သူ​တို့​နှင့်​ရ​သော​သား​သ​မီး များ​ကို​လည်း​ကောင်း​စွန့်​လိုက်​ကြ​၏။",{"noteId":8},"ဧ​ဇ​ရ​မှတ်​စာ​ပြီး​၏။"]}],"footnotes":[{"noteId":8,"caller":"9","text":"* အ​ခန်း​ငယ် ၄၄ သည်​ဟေ​ဗြဲ​မူ​တွင်​မ​ရှင်း မ​လင်း​ဖြစ်​သည်။","reference":{"chapter":10,"verse":44}}]},"thisChapterLink":"/api/mya_ojv/EZR/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/NEH/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/EZR/9.json","previousChapterAudioLinks":{},"numberOfVerses":35}