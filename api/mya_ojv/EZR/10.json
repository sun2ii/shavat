{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"EZR","translationId":"mya_ojv","name":"ဧ​ဇ​ရ","commonName":"ဧ​ဇ​ရ","title":"ဧ​ဇ​ရ​မှတ်​စာ","order":15,"numberOfChapters":10,"sha256":"2c6dca79588afe79a2d94a877a8862ef2db59e81e3ac1458139a5a9f9bdd8b71","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/EZR/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/mya_ojv/EZR/10.json","totalNumberOfVerses":202},"chapter":{"number":10,"content":[{"type":"heading","content":["လူ​မျိုး​ခြား​တို့​နှင့်​ထိမ်း​မြား​စုံ​ဖက်​မှု​ကို ရပ်​စဲ​ရန်​စီ​မံ​ခြင်း"]},{"type":"verse","number":1,"content":["ဧ​ဇ​ရ​သည်​ဗိ​မာန်​တော်​ရှေ့​တွင်​ခေါင်း​ငုံ့​လျက် ငို​ကြွေး​ကာ ဤ​အ​ပြစ်​များ​ကို​ဖော်​ပြ​ဝန်​ခံ လျက်​ဆု​တောင်း​ပတ္ထ​နာ​ပြု​နေ​စဉ် ဣ​သ​ရေ​လ အ​မျိုး​သား၊ အ​မျိုး​သ​မီး​နှင့်​က​လေး​ပါ ဝင်​သော​လူ​အုပ်​ကြီး​သည်​ငို​ကြွေး​လျက် သူ့​ထံ​စု​ရုံး​ကြ​ကုန်​၏။-"]},{"type":"verse","number":2,"content":["ထို​အ​ခါ​ဧ​လံ​သား​ချင်း​စု​မှ​ယေ​ဟေ​လ​၏ သား ရှေ​က​နိ​က​ဧ​ဇ​ရ​အား``အ​ကျွန်ုပ်​တို့​သည် လူ​မျိုး​ခြား​အ​မျိုး​သ​မီး​များ​နှင့်​ထိမ်း​မြား စုံ​ဖက်​ခြင်း​အား​ဖြင့် ဘု​ရား​သ​ခင်​ကို​သစ္စာ ဖောက်​ကြ​ပါ​ပြီ။ သို့​သော်​လည်း​ဣ​သ​ရေ​လ အ​မျိုး​သား​တို့​အ​တွက် မျှော်​လင့်​စ​ရာ​ရှိ ပါ​သေး​၏။-"]},{"type":"verse","number":3,"content":["ယ​ခု​အ​ကျွန်ုပ်​တို့​သည်​ထို​မိန်း​မ​များ​နှင့် သား​သ​မီး​များ​ကို​စွန့်​ကြ​ပါ​မည်​ဟု အ​ကျွန်ုပ် တို့​၏​ဘု​ရား​သ​ခင်​အား​ကျိန်​ဆို​က​တိ​ပြု ရ​ကြ​မည်။ ဘု​ရား​သ​ခင်​၏​အ​မိန့်​တော်​များ ကို​ရို​သေ​လေး​စား​ကြ​သော​အ​ရှင်​နှင့် အ​ခြား သ