{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"GEN","translationId":"mya_ojv","name":"ကမ္ဘာ​ဦး","commonName":"ကမ္ဘာ​ဦး","title":"ကမ္ဘာ​ဦး​ကျမ်း","order":1,"numberOfChapters":50,"sha256":"b2facda36c6817d22c4b7fb2c4a637ba2c021b7a4c0b578f509ba7229b5509a3","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/mya_ojv/GEN/50.json","totalNumberOfVerses":1494},"chapter":{"number":16,"content":[{"type":"heading","content":["ဟာ​ဂ​ရ​နှင့်​ဣရှ​မေ​လ"]},{"type":"verse","number":1,"content":["အာ​ဗြံ​၏​မ​ယား​စာ​ရဲ​တွင်​သား​တစ်​ယောက်​မျှ မ​ထွန်း​ကား​ချေ။ စာ​ရဲ​၌​ဟာ​ဂ​ရ​အ​မည်​ရှိ သော​အီ​ဂျစ်​ပြည်​သူ​ကျွန်​မ​တစ်​ယောက်​ရှိ​၏။-"]},{"type":"verse","number":2,"content":["သို့​ဖြစ်​၍​စာ​ရဲ​က​အာ​ဗြံ​အား``ထာ​ဝ​ရ​ဘု​ရား သည် ကျွန်​မ​ကို​သား​သ​မီး​မ​ထွန်း​ကား​စေ​ပါ။ ကျွန်​မ​၏​ကျွန်​မ​ကို​သိမ်း​ပိုက်​ပါ​လော့။ သူ့​အား ဖြင့်​ကျွန်​မ​သား​ရ​ကောင်း​ရ​လိမ့်​မည်'' ဟု​ပြော​၏။ အာ​ဗြံ​သည်​စာ​ရဲ​အ​ကြံ​ပေး​ချက်​ကို​လက်​ခံ သ​ဖြင့်၊-"]},{"type":"verse","number":3,"content":["စာ​ရဲ​သည်​ဟာ​ဂ​ရ​ကို​သူ့​လက်​သို့​အပ်​လေ​၏။ (အာ​ဗြံ​သည်​ခါ​နာန်​ပြည်​တွင်​ဆယ်​နှစ်​နေ​ထိုင် ပြီး​နောက် ဟာ​ဂ​ရ​ကို​မ​ယား​ငယ်​အ​ဖြစ် သိမ်း​ပိုက်​ခဲ့​လေ​သည်။-)"]},{"type":"verse","number":4,"content":["အာ​ဗြံ​သည်​ဟာ​ဂ​ရ​နှင့်​ဆက်​ဆံ​သ​ဖြင့် ဟာ​ဂ​ရ ၌​ပ​ဋိ​သန္ဓေ​စွဲ​လေ​၏။ ဟာ​ဂ​ရ​သည်​သူ​၌​ပ​ဋိ သန္ဓေ​စွဲ​ကြောင်း​သိ​ရ​လျှင် မာန်​မာ​န​ဝင်​လာ​၍ စာ​ရဲ​ကို​မ​ထီ​လေး​စား​ပြု​လေ​၏။"]},{"type":"verse","number":5,"content":["ထို​အ​ခါ​စာ​ရဲ​က​အာ​ဗြံ​အား``ကိုယ်​တော်​ကြောင့် ဟာ​ဂ​ရ​သည် ကျွန်​မ​အား​မ​ထီ​လေး​စား​ပြု​ပါ ပြီ။ ကျွန်​မ​က​သူ့​ကို​ကိုယ်​တော်​ထံ​အပ်​၍ သူ​၌ ပ​ဋိ​သန္ဓေ​စွဲ​ကြောင်း​သိ​သည်​နှင့် ကျွန်​မ​အား မ​ထီ​လေး​စား​ပြု​လာ​ပါ​သည်။ ကိုယ်​တော်​နှင့် ကျွန်​မ​တို့​နှစ်​ဦး​အ​တွက် တ​ရား​သ​ဖြင့်​ဖြစ် စေ​ရန်​ထာ​ဝ​ရ​ဘု​ရား​စီ​ရင်​တော်​မူ​ပါ​စေ'' ဟု​ဆို​၏။"]},{"type":"verse","number":6,"content":["အာ​ဗြံ​က``သူ​သည်​သင်​၏​ကျွန်​မ​ဖြစ်​၍​သင့် လက်​ထဲ​၌​ရှိ​သည်။ သူ့​အား​သင်​ပြု​လို​ရာ​ပြု နိုင်​သည်'' ဟု​ပြန်​ပြော​၏။ ထို​အ​ခါ​စာ​ရဲ​သည် ဟာ​ဂ​ရ​အား​မ​နေ​နိုင်​လောက်​အောင်​ညှင်း​ဆဲ သ​ဖြင့် ဟာ​ဂ​ရ​ထွက်​ပြေး​လေ​သည်။"]},{"type":"verse","number":7,"content":["ထာ​ဝ​ရ​ဘု​ရား​၏​ကောင်း​ကင်​တ​မန်​သည် ရှု​ရ​မြို့​သို့​သွား​ရာ​လမ်း၊ တော​ကန္တာ​ရ​ထဲ ရှိ​စမ်း​ရေ​တွင်း​အ​နီး​တွင်​ဟာ​ဂ​ရ​ကို​တွေ့ လျှင်၊-"]},{"type":"verse","number":8,"content":["``စာ​ရဲ​၏​ကျွန်​မ​ဟာ​ဂ​ရ၊ သင်​ဘယ်​အ​ရပ် သို့​သွား​မည်​နည်း'' ဟု​မေး​လေ​၏။ ဟာ​ဂ​ရ​က``ကျွန်​မ​သည်​သ​ခင်​မ​ထံ​မှ​ထွက် ပြေး​လာ​ပါ​သည်'' ဟု​ပြန်​ဖြေ​၏။"]},{"type":"verse","number":9,"content":["ထာ​ဝ​ရ​ဘု​ရား​၏​ကောင်း​ကင်​တ​မန်​က လည်း``သ​ခင်​မ​ထံ​သို့​ပြန်​၍​ကျွန်​ခံ​လော့'' ဟု ဆို​၏။-"]},{"type":"verse","number":10,"content":["တစ်​ဖန်​ထာ​ဝ​ရ​ဘု​ရား​၏​ကောင်း​ကင်​တ​မန် က``သင်​၏​အ​မျိုး​အ​နွယ်​ကို​မ​ရေ​မ​တွက် နိုင်​အောင်​များ​ပြား​စေ​မည်။-"]},{"type":"verse","number":11,"content":["သင်​သည်​သား​ကို​ဖွား​မြင်​လိမ့်​မည်။ ထာ​ဝ​ရ ဘု​ရား​သည်​သင်​၏​ညည်း​တွား​သံ​ကို​ကြား တော်​မူ​ပြီ။ ထို​သား​ကို​ဣ​ရှ​မေ​လ​အ​မည် ဖြင့်​မှည့်​ခေါ်​ရ​မည်။-"]},{"type":"verse","number":12,"content":["သို့​ရာ​တွင်​သင်​၏​သား​သည်​မြည်း​ရိုင်း​ကဲ့​သို့​နေ ထိုင်​ရ​လိမ့်​မည်။ သူ​သည်​လူ​တိုင်း​နှင့်​ရန်​ဘက် ဖြစ်​၍ လူ​တိုင်း​က​လည်း​သူ့​ကို​ရန်​ဘက်​ပြု လိမ့်​မည်။ သူ​သည်​မွေး​ချင်း​ပေါက်​ဖော်​တို့​နှင့် ခွဲ​ခွာ​နေ​ထိုင်​ရ​လိမ့်​မည်'' ဟု​မြွက်​ဆို​လေ​၏။"]},{"type":"verse","number":13,"content":["ထို​အ​ခါ​ဟာ​ဂ​ရ​က``ငါ​သည်​ထာ​ဝ​ရ ဘု​ရား​ကို​အ​ကယ်​ပင်​ဖူး​မြင်​ရ​ပြီး​နောက် အ​သက်​ရှင်​သေး​ပါ​တ​ကား'' ဟု​ဆို​ပြီး လျှင်​သူ့​အား​ထို​သို့​မိန့်​ကြား​တော်​မူ​သော ထာ​ဝ​ရ​ဘု​ရား​ကို``မြင်​တော်​မူ​သော​ဘု​ရား'' ဟူ​သော​နာ​မည်​ဖြင့်​ခေါ်​ဝေါ်​လေ​၏။-"]},{"type":"verse","number":14,"content":["ထို​အ​ကြောင်း​ကြောင့်​ကာ​ဒေ​ရှ​မြို့​နှင့်​ဗေ​ရက် မြို့​စပ်​ကြား​ရှိ​ရေ​တွင်း​ကို``ငါ့​ကို​မြင်​တော်​မူ သည့်​အ​သက်​ရှင်​တော်​မူ​သော​အ​ရှင်​၏​ရေ​တွင်း'' ဟု​ခေါ်​တွင်​လေ​သည်။"]},{"type":"verse","number":15,"content":["အာ​ဗြံ​သည်​ဟာ​ဂ​ရ​ဖြင့်​သား​ကို​ရ​၍ သူ​သည် ထို​သား​ကို​ဣ​ရှ​မေ​လ​ဟု​နာ​မည်​မှည့်​ခေါ်​၏။-"]},{"type":"verse","number":16,"content":["ထို​သား​ဖွား​သော​အ​ချိန်​၌ အာ​ဗြံ​သည်​အ​သက် ရှစ်​ဆယ့်​ခြောက်​နှစ်​ရှိ​သ​တည်း။"]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/GEN/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/GEN/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/GEN/15.json","previousChapterAudioLinks":{},"numberOfVerses":16}