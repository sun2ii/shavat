{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"GEN","translationId":"mya_ojv","name":"ကမ္ဘာ​ဦး","commonName":"ကမ္ဘာ​ဦး","title":"ကမ္ဘာ​ဦး​ကျမ်း","order":1,"numberOfChapters":50,"sha256":"b2facda36c6817d22c4b7fb2c4a637ba2c021b7a4c0b578f509ba7229b5509a3","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/mya_ojv/GEN/50.json","totalNumberOfVerses":1494},"chapter":{"number":18,"content":[{"type":"heading","content":["အာ​ဗြ​ဟံ​သား​ရ​မည်​ဟူ​သော​က​တိ​တော်"]},{"type":"verse","number":1,"content":["ထာ​ဝ​ရ​ဘု​ရား​သည်​မံ​ရေ​ပိုင်​သော​သစ်​ပင်​များ ရှိ​ရာ​အ​ရပ်​တွင် အာ​ဗြ​ဟံ​အား​ကိုယ်​ထင်​ပြ တော်​မူ​၏။ နေ​အ​လွန်​ပူ​ပြင်း​သော​အ​ချိန်​၌ အာ​ဗြ​ဟံ​သည်​မိ​မိ​၏​တဲ​ဝ​မှာ​ထိုင်​နေ​စဉ်၊-"]},{"type":"verse","number":2,"content":["မျက်​နှာ​ကို​မော်​ကြည့်​လိုက်​ရာ လူ​သုံး​ဦး​ရပ်​နေ​သည် ကို​တွေ့​မြင်​ရ​လေ​သည်။ အာ​ဗြ​ဟံ​သည်​သူ​တို့​ကို မြင်​လျှင် ခ​ရီး​ဦး​ကြို​ဆို​ခြင်း​ငှာ​ပြေး​သွား​လေ​၏။ သူ​သည်​ဦး​ညွှတ်​ပျပ်​ဝပ်​လျက်၊-"]},{"type":"verse","number":3,"content":["``အ​ရှင်​သ​ခင်​တို့၊ အ​ရှင်​တို့​အား​ဧည့်​ဝတ်​ပြု ပါ​ရ​စေ။ အ​ကျွန်ုပ်​၏​အိမ်​သို့​မ​ဝင်​ဘဲ​မ​နေ ပါ​နှင့်။-"]},{"type":"verse","number":4,"content":["ခြေ​ဆေး​ရန်​ရေ​ယူ​ခဲ့​ပါ​ရ​စေ။ ဤ​သစ်​ပင် အောက်​တွင်​အ​ပန်း​ဖြေ​နိုင်​ပါ​သည်။-"]},{"type":"verse","number":5,"content":["အ​ရှင်​တို့​အ​တွက်​စား​စ​ရာ​အ​နည်း​ငယ်​ယူ​ခဲ့ ပါ​မည်။ သို့​မှ​သာ​လျှင်​အား​ပြည့်​လာ​၍​ခ​ရီး ဆက်​နိုင်​ပါ​မည်။ အ​ရှင်​တို့​သည်​အ​ကျွန်ုပ်​အိမ် သို့​ကြွ