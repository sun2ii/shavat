{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"GEN","translationId":"mya_ojv","name":"ကမ္ဘာ​ဦး","commonName":"ကမ္ဘာ​ဦး","title":"ကမ္ဘာ​ဦး​ကျမ်း","order":1,"numberOfChapters":50,"sha256":"b2facda36c6817d22c4b7fb2c4a637ba2c021b7a4c0b578f509ba7229b5509a3","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/mya_ojv/GEN/50.json","totalNumberOfVerses":1494},"chapter":{"number":23,"content":[{"type":"heading","content":["စာ​ရာ​ကွယ်​လွန်​၍​အာ​ဗြ​ဟံ​သင်္ချိုင်း​မြေ​ဝယ်​ခြင်း"]},{"type":"verse","number":1,"content":["စာ​ရာ​သည်​အ​သက်​တစ်​ရာ​နှစ်​ဆယ့်​ခု​နစ်​နှစ်​ရှိ​သော်၊-"]},{"type":"verse","number":2,"content":["ခါ​နာန်​ပြည်​ဟေ​ဗြုန်​မြို့​၌​ကွယ်​လွန်​ရာ​အာ​ဗြ​ဟံ​သည် သူ့​အ​တွက်​ငို​ကြွေး​မြည်​တမ်း​လေ​သည်။"]},{"type":"verse","number":3,"content":["အာ​ဗြ​ဟံ​သည်​အ​လောင်း​ရှိ​ရာ​မှ​ထ​၍​ဟိတ္တိ​အ​မျိုး​သား​တို့​ထံ​သို့​သွား​ပြီး​လျှင်၊-"]},{"type":"verse","number":4,"content":["ငါ​သည်​သင်​တို့​ထံ​တွင်​ဧည့်​သည်​အာ​ဂန္တု​ဖြစ်​ပါ​၏။ ငါ​၏​မ​ယား​အ​လောင်း​ကို​မြှုပ်​နှံ​ရန်​မြေ​တစ်​ကွက်​ကို​ရောင်း​ပါ'' ဟု​ဆို​လေ​သည်။"]},{"type":"verse","number":5,"content":["သူ​တို့​က``ကျွန်ုပ်​တို့​အ​စီ​ရင်​ခံ​ပါ​ရ​စေ။ ကိုယ်​တော်​သည်​ကျွန်ုပ်​တို့​တွင်​တန်​ခိုး​ကြီး​သော​အ​ကြီး​အ​ကဲ​တစ်​ဦး​ဖြစ်​ပါ​သည်။ ကျွန်ုပ်​တို့​၏​အ​ကောင်း​ဆုံး​သော​သင်္ချိုင်း​တွင်​သင်​၏​မ​ယား​ကို​မြှုပ်​နှံ​ပါ။ သူ​၏​အ​လောင်း​ကို​မြှုပ်​နှံ​ရန်​အ​တွက်​သင်္ချိုင်း​ကို​ကျွန်ုပ်​တို့​က​ဝမ်း​သာ​စွာ​ပေး​ပါ​မည်'' ဟု​အာ​ဗြ​ဟံ​အား​ပြန်​ပြော​ကြ​၏။"]},{"type":"verse","number":7,"content":["ထို​အ​ခါ​အာ​ဗြ​ဟံ​သည်​သူ​တို့​ရှေ့​တွင်​ဦး​ညွှတ်​၍၊"]},{"type":"verse","number":8,"content":["``သင်​တို့​သည်​ငါ​၏​မ​ယား​အ​လောင်း​ကို​ဤ​အ​ရပ်​တွင်​မြှုပ်​နှံ​စေ​လို​လျှင် ဇော​ဟာ​၏​သား​ဧ​ဖ​ရုန်​ပိုင်​မြေ​ကွက်​အ​စွန်း​၌​ရှိ​သော၊-"]},{"type":"verse","number":9,"content":["မပ္ပေလ​ဂူ​ကို​ငါ့​အား​ရောင်း​ချ​ရန်​ကျေး​ဇူး​ပြု​၍​သူ့​ကို​တိုက်​တွန်း​ပေး​ကြ​ပါ။ သင်္ချိုင်း​မြေ​တစ်​ကွက်​ငါ​အ​ပိုင်​ရ​ရန်​ထို​မြေ​ကို​တန်​ရာ​တန်​ဖိုး​ဖြင့်​ငါ့​အား​သင်​တို့​ရှေ့​မှောက်​တွင်​ရောင်း​ချ​စေ​ပါ'' ဟု​ဆို​လေ​၏။"]},{"type":"verse","number":10,"content":["ဧ​ဖ​ရုန်​ကိုယ်​တိုင်​အ​ခြား​ဟိတ္တိ​အ​မျိုး​သား​တို့​နှင့်​အ​တူ မြို့​တံ​ခါး​အ​နီး​ရှိ​စု​ဝေး​ရာ​အ​ရပ်​၌​ထိုင်​လျက်​ရှိ​သည်။ သူ​က​အာ​ဗြ​ဟံ​အား၊-"]},{"type":"verse","number":11,"content":["``အ​စီ​ရင်​ခံ​ပါ​ရ​စေ။ ဂူ​နှင့်​တ​ကွ​မြေ​ကွက်​တစ်​ခု​လုံး​ကို​ကျွန်ုပ်​ပေး​ပါ​၏။ အ​ရှင်​၏​မယား​ကို​သင်္ဂြိုဟ်​ရန်​ကျွန်ုပ်​တို့​၏​အ​မျိုး​သား​တို့​ရှေ့​မှောက်​တွင်​ထို​မြေ​ကို​ကျွန်ုပ်​ပေး​ပါ​၏'' ဟု​ရှိ​သ​မျှ​သော​သူ​တို့​ကြား​နိုင်​အောင်​ပြော​ကြား​လေ​သည်။"]},{"type":"verse","number":12,"content":["အာ​ဗြ​ဟံ​သည်​လည်း​မြို့​သား​တို့​ရှေ့​တွင်​ဦး​ညွတ်​၍၊-"]},{"type":"verse","number":13,"content":["အ​များ​ကြား​နိုင်​အောင်​ဧ​ဖ​ရုန်​အား``ငါ​တင်​ပြ​ချက်​ကို​လက်​ခံ​ပါ။ ထို​မြေ​တစ်​ကွက်​လုံး​ကို​ငါ​ဝယ်​ပါ​မည်။ မြေ​ဖိုး​ငွေ​ကို​လက်​ခံ​ပါ။ ငါ​၏​မယား​ကို​ထို​မြေ​၌​မြှုပ်​နှံ​ပါ​မည်'' ဟု​ပြန်​လည်​ပြော​ကြား​လေ​သည်။"]},{"type":"verse","number":14,"content":["ထို​အ​ခါ​ဧ​ဖ​ရုန်​က``အ​ရှင်၊ ထို​မြေ​ကွက်​သည်​ငွေ​သား​လေး​ရာ​မျှ​သာ​တန်​ဖိုး​ရှိ​၏။ ထို​ငွေ​မှာ​မ​ပြော​ပ​လောက်​ပါ။ ထို​မြေ​တွင်​အရှင်​၏​မယား​ကို​သင်္ဂြိုဟ်​ပါ​လော့'' ဟု​ဆို​လေ​၏။-"]},{"type":"verse","number":16,"content":["အာ​ဗြ​ဟံ​သည်​သ​ဘော​တူ​၍​လူ​တို့​ရှေ့​တွင်​ဧ​ဖ​ရုန်​တန်​ဖိုး​ဖြတ်​သော​ငွေ​သား​လေး​ရာ​ကို​ကုန်​သည်​သုံး​စံ​ချိန်​အ​ရ​ချိန်​တွယ်​၍​ဧ​ဖ​ရုန်​အား​ပေး​လေ​၏။"]},{"type":"verse","number":17,"content":["ထို​သို့​အား​ဖြင့်​မံ​ရေ​မြို့​အ​ရှေ့၊ မပ္ပေလ​အ​ရပ်​တွင်​ရှိ​သော​ဧ​ဖ​ရုန်​ပိုင်​မြေ​ကွက်​သည်​အာ​ဗြ​ဟံ​ပိုင်​မြေ​ဖြစ်​လာ​သည်။ သူ​ပိုင်​သော​မြေ​ကွက်​တွင်​ဂူ​နှင့် မြေ​ကွက်​ပေါ်​တွင်​ပေါက်​သ​မျှ​သော​သစ်​ပင်​များ၊ မြေ​ကွက်​အ​စွန်း​တိုင်​အောင်​ပေါက်​သ​မျှ​သော​သစ်​ပင်​များ​ပါ​ဝင်​လေ​သည်။-"]},{"type":"verse","number":18,"content":["ထို​အ​စည်း​အ​ဝေး​တွင်​ရှိ​ကြ​သော​ဟိတ္တိ​အ​မျိုး​သား​အ​ပေါင်း​တို့​က​ထို​မြေ​ကွက်​ကို​အာ​ဗြ​ဟံ​၏​ပိုင်​မြေ​အ​ဖြစ်​အ​သိ​အ​မှတ်​ပြု​ကြ​၏။"]},{"type":"verse","number":19,"content":["ထို​နောက်​အာ​ဗြ​ဟံ​သည်​သူ​၏​မ​ယား​စာ​ရာ​အ​လောင်း​ကို​ခါ​နာန်​ပြည်​ရှိ​ထို​ဂူ​တွင်​သင်္ဂြိုဟ်​လေ​သည်။-"]},{"type":"verse","number":20,"content":["သို့​ဖြစ်​၍​ဟိတ္တိ​အ​မျိုး​သား​တို့​ပိုင်​သော​မြေ​ကွက်​နှင့်​ဂူ​သည်​အာ​ဗြ​ဟံ​ပိုင်​သင်္ချိုင်း​မြေ​ဖြစ်​လာ​လေ​သည်။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/GEN/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/GEN/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/GEN/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}