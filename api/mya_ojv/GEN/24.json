{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"GEN","translationId":"mya_ojv","name":"ကမ္ဘာ​ဦး","commonName":"ကမ္ဘာ​ဦး","title":"ကမ္ဘာ​ဦး​ကျမ်း","order":1,"numberOfChapters":50,"sha256":"b2facda36c6817d22c4b7fb2c4a637ba2c021b7a4c0b578f509ba7229b5509a3","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/mya_ojv/GEN/50.json","totalNumberOfVerses":1494},"chapter":{"number":24,"content":[{"type":"heading","content":["ဣ​ဇာက်​အ​တွက်​မ​ယား​ရှာ​ပေး​ခြင်း"]},{"type":"verse","number":1,"content":["ထို​အ​ချိန်​၌​အာ​ဗြ​ဟံ​သည်​အ​သက်​အ​ရွယ် အ​လွန်​ကြီး​ရင့်​လာ​ပြီ​ဖြစ်​၏။ ထာ​ဝ​ရ​ဘု​ရား သည်​အ​ရာ​ရာ​၌​သူ့​အား​ကောင်း​ချီး​ပေး​တော် မူ​ခဲ့​၏။-"]},{"type":"verse","number":2,"content":["သူ​သည်​သူ​၏​ပစ္စည်း​ဥစ္စာ​အား​လုံး​တို့​ကို​အုပ် ထိန်း​ရ​သော အ​သက်​အ​ကြီး​ဆုံး​အ​စေ​ခံ​ကို ခေါ်​လျက်``သင်​၏​လက်​ကို​ငါ့​ပေါင်​အောက်​မှာ ထား​၍​သစ္စာ​ဆို​လော့။-"]},{"type":"verse","number":3,"content":["သင်​သည်​ငါ့​သား​အ​တွက်​မ​ယား​ကို​ခါ​နာန် လူ​မျိုး​တို့​တွင်​မ​ရှာ​ပါ​ဟု ကောင်း​ကင်​နှင့်​မြေ ကြီး​အ​ရှင်​ဘု​ရား​သ​ခင်​ထာ​ဝ​ရ​ဘု​ရား​၏ နာ​မ​တော်​ကို​တိုင်​တည်​၍​သစ္စာ​ဆို​လော့။-"]},{"type":"verse","number":4,"content":["သင်​သည်​ငါ​မွေး​ရာ​ဇာ​တိ​ပြည်​သို့​ပြန်​သွား​၍ ငါ​၏​အ​မျိုး​သား​ချင်း​တို့​ထဲ​မှ​ငါ​၏​သား ဣဇာက်​အ​တွက်​မ​ယား​ရှာ​ခဲ့​ရ​မည်'' ဟု​ဆို လေ​၏။"]},{"type":"verse","number":5,"content":["ထို​အ​ခါ​အ​စေ​ခံ​က``အ​မျိုး​သ​မီး​သည်​သူ​၏ အိမ်​ရာ​ကို​စွန့်​၍​ဤ​ပြည်​သို့ ကျွန်​တော်​နှင့်​အ​