{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"GEN","translationId":"mya_ojv","name":"ကမ္ဘာ​ဦး","commonName":"ကမ္ဘာ​ဦး","title":"ကမ္ဘာ​ဦး​ကျမ်း","order":1,"numberOfChapters":50,"sha256":"b2facda36c6817d22c4b7fb2c4a637ba2c021b7a4c0b578f509ba7229b5509a3","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/mya_ojv/GEN/50.json","totalNumberOfVerses":1494},"chapter":{"number":27,"content":[{"type":"heading","content":["ယာ​ကုပ်​အား​ဣ​ဇာက်​ကောင်း​ချီး​ပေး​ခြင်း"]},{"type":"verse","number":1,"content":["ဣ​ဇာက်​သည်​အို​မင်း​လာ​၍​မျက်​စိ​မ​မြင်​တော့ ချေ။ သူ​သည်​သား​အ​ကြီး​ဧ​သော​ကို``သား'' ဟု​ခေါ်​လျှင်​ဧ​သော​က၊ ``ရှိ​ပါ​သည်​အ​ဖ'' ဟု​ပြန်​ဖြေ​၏။"]},{"type":"verse","number":2,"content":["ထို​အ​ခါ​ဣ​ဇာက်​က``ငါ​သည်​ယ​ခု​အို​လှ​ပြီ။ မ​ကြာ​မီ​သေ​ရ​မည်။-"]},{"type":"verse","number":3,"content":["သင်​သည်​လေး​နှင့်​မြား​ကို​ယူ​၍​တော​ထဲ​သို့ သွား​ပြီး​လျှင် ငါ့​အ​တွက်​အ​မဲ​ရှာ​ဖွေ​ခဲ့​ပါ။-"]},{"type":"verse","number":4,"content":["ငါ​ကြိုက်​နှစ်​သက်​သော​အ​မဲ​ဟင်း​လျာ​ကို​ချက် ၍​ငါ့​ထံ​သို့​ယူ​ခဲ့​ပါ။ ထို​ဟင်း​ကို​ငါ​စား​ပြီး လျှင်​ငါ​မ​သေ​မီ​သင့်​အား​ကောင်း​ချီး​ပေး​မည်'' ဟု​မှာ​ကြား​လေ​သည်။"]},{"type":"verse","number":5,"content":["ဣ​ဇာက်​က​ဧ​သော​အား ထို​သို့​မှာ​ကြား​နေ​စဉ် ရေ​ဗက္က​သည်​နား​ထောင်​လျက်​ရှိ​၏။ ထို့​ကြောင့် ဧသော​အ​မဲ​ပစ်​ထွက်​သွား​သော​အ​ခါ၊-"]},{"type":"verse","number":6,"content":["ရေ​ဗက္က​သည်​ယာ​ကုပ်​ကို​ခေါ်​၍``သင့်​အ​ဖ က​ဧ​သော​အား၊-"]},{"type":"verse","number":7,"content":["`အ​မဲ​ပစ်​၍​ငါ့​အ​တွက်​ဟင်း​ချက်​ခဲ့​ပါ။ ငါ စား​ပြီး​လျှင်​ထာ​ဝ​ရ​ဘု​ရား​ရှေ့​တော်​၌ သင့် အား​ငါ​မ​သေ​မီ​ကောင်း​ချီး​ပေး​မည်' ဟု​မှာ ကြား​သည်​ကို​ငါ​ကြား​ပြီ။-"]},{"type":"verse","number":8,"content":["သို့​ဖြစ်​၍​ငါ့​သား၊ ငါ့​စ​ကား​ကို​နား​ထောင် ၍​ငါ​ပြော​သ​မျှ​အ​တိုင်း​ပြု​လုပ်​လော့။-"]},{"type":"verse","number":9,"content":["ဆိတ်​အုပ်​ရှိ​ရာ​သို့​သွား​ပြီး​လျှင် ဆူ​ဖြိုး​သော ဆိတ်​ငယ်​နှစ်​ကောင်​ကို​ရွေး​ယူ​ခဲ့​လော့။ ငါ​သည် သင့်​ဖ​ခင်​ကြိုက်​နှစ်​သက်​သော​ဟင်း​ကို​ချက် ပေး​မည်။-"]},{"type":"verse","number":10,"content":["ထို​အ​မဲ​ဟင်း​ကို​သူ့​ထံ​သို့​ယူ​သွား​လော့။ သူ မ​သေ​မီ သင့်​အား​ကောင်း​ချီး​ပေး​လိမ့်​မည်'' ဟု ဆို​လေ​၏။"]},{"type":"verse","number":11,"content":["ယာ​ကုပ်​က``အစ်​ကို​ဧ​သော​သည်​အ​မွေး​ထူ သော​သူ​ဖြစ်​ပြီး ကျွန်​တော်​မှာ​အ​သား​အ​ရေ ချော​မွတ်​သူ​ဖြစ်​ပါ​၏။-"]},{"type":"verse","number":12,"content":["ဖ​ခင်​က​ကျွန်​တော်​အား​စမ်း​သပ်​ကြည့်​မိ​၍ သူ့​အား​လှည့်​ဖြား​ကြောင်း​သိ​လျှင် ကျွန်​တော် ကောင်း​ချီး​မင်္ဂလာ​ကို​ခံ​ရ​မည့်​အ​စား​ကျိန် စာ​သင့်​ခြင်း​ကို​ခံ​ရ​ပါ​မည်'' ဟု​မိ​ခင်​အား ပြန်​ပြော​လေ​၏။"]},{"type":"verse","number":13,"content":["ငါ့​သား၊ သင်​ခံ​ရ​မည့်​ကျိန်​စာ​သင့်​ခြင်း​ကို ငါ​ခံ​ရ​ပါ​စေ။ ငါ​ပြော​သည့်​အ​တိုင်း​ဆိတ် များ​ကို​သာ​ငါ့​ထံ​သို့​ယူ​ခဲ့​ပါ'' ဟု​မိခင် က​ဆို​လေ​၏။-"]},{"type":"verse","number":14,"content":["ယာ​ကုပ်​သည်​သွား​၍​ဆိတ်​များ​ကို​မိ​ခင်​ထံ​သို့ ယူ​ဆောင်​ခဲ့​သ​ဖြင့် ရေ​ဗက္က​သည်​ဣ​ဇာက်​ကြိုက် နှစ်​သက်​သော​အ​မဲ​ဟင်း​ကို​ချက်​လေ​သည်။-"]},{"type":"verse","number":15,"content":["ထို​နောက်​သူ​သည်​မိ​မိ​အိမ်​တွင်​သိမ်း​ဆည်း ထား​သော​ဧ​သော​၏​အ​ကောင်း​ဆုံး​အ​ဝတ် ကို​ယာ​ကုပ်​အား​ဝတ်​ဆင်​ပေး​၏။-"]},{"type":"verse","number":16,"content":["သူ​၏​လက်​မောင်း​များ​နှင့်​အ​မွေး​မ​ပေါက်​သော လည်​ပင်း​တို့​တွင်​ဆိတ်​သား​ရေ​ကို​ပတ်​စည်း ပေး​၏။-"]},{"type":"verse","number":17,"content":["ထို​နောက်​ချက်​ပြီး​သော​အ​မဲ​ဟင်း​နှင့်​ဖုတ် ထား​သော​မုန့်​တို့​ကို​ယာ​ကုပ်​အား​ပေး​၏။"]},{"type":"verse","number":18,"content":["ယာ​ကုပ်​သည်​သူ​၏​ဖ​ခင်​ထံ​သို့​သွား​၍``အ​ဖ'' ဟု​ခေါ်​လျှင်၊ ဣ​ဇာက်​က``သား'' ဟု​ထူး​ပြီး​လျှင်``သား​ကြီး လော၊ သား