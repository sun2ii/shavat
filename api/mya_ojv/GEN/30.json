{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"GEN","translationId":"mya_ojv","name":"ကမ္ဘာ​ဦး","commonName":"ကမ္ဘာ​ဦး","title":"ကမ္ဘာ​ဦး​ကျမ်း","order":1,"numberOfChapters":50,"sha256":"b2facda36c6817d22c4b7fb2c4a637ba2c021b7a4c0b578f509ba7229b5509a3","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/mya_ojv/GEN/50.json","totalNumberOfVerses":1494},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":["ရာ​ခေ​လ​သည်​ယာ​ကုပ်​နှင့်​သား​သ​မီး​မ​ထွန်း ကား​သ​ဖြင့် အစ်​မ​ကို​မ​နာ​လို​ဖြစ်​ပြီး​လျှင် ယာ​ကုပ်​အား``ကျွန်​မ​တွင်​သား​သ​မီး​မ​ရ ပါ​က​သေ​ရ​ပါ​တော့​မည်'' ဟု​ပြော​လေ​၏။"]},{"type":"verse","number":2,"content":["ထို​အ​ခါ​ယာ​ကုပ်​သည်​အ​မျက်​ထွက်​၍``ငါ သည်​ဘု​ရား​လော။ ဘု​ရား​က​သာ​သင့်​အား သား​ဖွား​ခွင့်​ကို​ပေး​တော်​မူ​နိုင်​သည်​မ​ဟုတ် လော'' ဟု​ပြန်​ဖြေ​လေ​သည်။"]},{"type":"verse","number":3,"content":["ရာ​ခေ​လ​က``ကျွန်​မ​အ​တွက်​က​လေး​ရ​စေ​ရန် ကျွန်​မ​၏​ကျွန်​ဗိ​လ​ဟာ​နှင့်​အိပ်​ပါ​လော့။ သူ့ အား​ဖြင့်​က​လေး​ရ​လျှင်​ကျွန်​မ​သည်​အ​မေ တစ်​ယောက်​ဖြစ်​လာ​နိုင်​ပါ​မည်'' ဟု​ဆို​လေ​၏။-"]},{"type":"verse","number":4,"content":["သူ​သည်​ဗိ​လ​ဟာ​ကို​ယာ​ကုပ်​အား​ပေး​အပ်​၍ ယာ​ကုပ်​သည်​ဗိ​လ​ဟာ​နှင့်​အိပ်​သ​ဖြင့်၊-"]},{"type":"verse","number":5,"content":["ဗိ​လ​ဟာ​သည်​ကိုယ်​ဝန်​ဆောင်​၍​သား​တစ်​ယောက် ကို​ဖွား​မြင်​လေ​သည်။-"]},{"type":"verse","number":6,"content":["ရာ​ခေ​လ​က``ဘု​ရား​သ​ခင်​သည်​ငါ့​ဘက်​၌ တ​ရား​စီ​ရင်​တော်​မူ​ပြီ။ ငါ​၏​ဆု​တောင်း​ပတ္ထ​နာ က