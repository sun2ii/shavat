{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"GEN","translationId":"mya_ojv","name":"ကမ္ဘာ​ဦး","commonName":"ကမ္ဘာ​ဦး","title":"ကမ္ဘာ​ဦး​ကျမ်း","order":1,"numberOfChapters":50,"sha256":"b2facda36c6817d22c4b7fb2c4a637ba2c021b7a4c0b578f509ba7229b5509a3","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/mya_ojv/GEN/50.json","totalNumberOfVerses":1494},"chapter":{"number":41,"content":[{"type":"heading","content":["ရှင်​ဘု​ရင်​၏​အိပ်​မက်​ကို​ယော​သပ်​အ​နက်​ဖွင့်​ခြင်း"]},{"type":"verse","number":1,"content":["ထို​နောက်​နှစ်​နှစ်​မျှ​ကြာ​သော​အ​ခါ အီ​ဂျစ်​ဘု​ရင် သည်​အိပ်​မက်​မြင်​မက်​လေ​၏။ အိပ်​မက်​ထဲ​တွင် ဘု​ရင်​သည်​နိုင်း​မြစ်​နား​၌​ရပ်​နေ​စဉ်၊-"]},{"type":"verse","number":2,"content":["ဝ​ဖြိုး​၍​အ​ဆင်း​လှ​သော​နွား​မ​ခု​နစ်​ကောင်​သည် မြစ်​ထဲ​မှ​တက်​လာ​ပြီး​လျှင်​မြက်​စား​လျက်​နေ ကြ​၏။-"]},{"type":"verse","number":3,"content":["ထို​နွား​တို့​နောက်​မှ​ပိန်​လှီ​၍​အ​ဆင်း​မ​လှ​သော နွား​မ​ခု​နစ်​ကောင်​တို့​သည်​မြစ်​ထဲ​မှ​တက်​လာ ကြ​ပြီး​လျှင် မြစ်​ကမ်း​နား​ပေါ်​သို့​ဦး​စွာ​ရောက် ရှိ​နေ​သော​နွား​များ​အ​နီး​သို့​သွား​၍​ရပ်​နေ ကြ​၏။-"]},{"type":"verse","number":4,"content":["ထို​နောက်​နွား​ပိန်​တို့​က​ဝ​ဖြိုး​သော​နွားမ​ခု​နစ် ကောင်​ကို​မျို​လိုက်​ကြ​၏။ ထို​အ​ချိန်​၌​ဘုရင် အိပ်​ရာ​မှ​နိုး​လေ​၏။-"]},{"type":"verse","number":5,"content":["ဘု​ရင်​သည်​တစ်​ဖန်​အိပ်​ပျော်​၍​အိပ်​မက်​မက် ပြန်​၏။ အိပ်​မက်​ထဲ​တွင်​စ​ပါး​ပင်​တစ်​ပင်​တည်း မှ​အ​ဆန်​အောင်​၍ ဝင်း​မှည့်​နေ​သေ