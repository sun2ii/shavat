{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"ISA","translationId":"mya_ojv","name":"ဟေ​ရှာ​ယ","commonName":"ဟေ​ရှာ​ယ","title":"ဟေ​ရှာ​ယ​အ​နာ​ဂတ္တိ​ကျမ်း","order":23,"numberOfChapters":66,"sha256":"0ecde7adeefb35d34c2ca35ea2ed2a55a58709f1aa577ee75335df64c34e73d7","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mya_ojv/ISA/66.json","totalNumberOfVerses":1281},"chapter":{"number":12,"content":[{"type":"heading","content":["ကျေး​ဇူး​တော်​ချီး​မွမ်း​သည့်​ဋ္ဌမ္မ​သီ​ချင်း"]},{"type":"verse","number":1,"content":[{"text":"``အို ထာ​ဝ​ရ​ဘု​ရား​ကိုယ်​တော်​ရှင်​အား၊ ကျွန်​တော်​မျိုး​ထော​မ​နာ​ပြု​ပါ​၏။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​ယ​ခင်​က​ကျွန်​တော်​မျိုး​အား အ​မျက်​ထွက်​တော်​မူ​ခဲ့​သော်​လည်း၊","poem":2},{"text":"ယ​ခု​အ​ခါ​အ​မျက်​ထွက်​တော်​မ​မူ​တော့​ဘဲ နှစ်​သိမ့်​မှု​ကို​ပေး​တော်​မူ​ပါ​ပြီ'' ဟု","poem":1},{"text":"လူ​တို့​သီ​ဆို​ကူး​ဧ​ကြ​မည့်​အ​ချိန်​ကာ​လ ရောက်​လာ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"``ဘု​ရား​သ​ခင်​သည်​ငါ​၏​ကယ်​တင်​ရှင်​ဖြစ် တော်​မူ​၏။","poem":1},{"text":"ငါ​သည်​ကိုယ်​တော်​အား​ကြောက်​လန့်​၍​မ​နေ​ဘဲ ယုံ​ကြည်​ကိုး​စား​မည်။","poem":2},{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ငါ့​အား​တန်​ခိုး​နှင့် ခွန်​အား​ကို","poem":1},{"text":"ပေး​တော်​မူ​သော​အ​ရှင်​ဖြစ်​ပါ​၏။","poem":2},{"text":"ကိုယ်​တော်​သည်​ငါ​၏​ကယ်​တင်​ရှင်​တည်း။","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ရေ​ကောင်း​ရေ​သန့်​သည်​ရေ​ငတ်​သူ​တို့​အား ရွှင်​ပြ​စေ​သ​ကဲ့​သို့","poem":1},{"text":"ဘု​ရား​သ​ခင်​၏​လူ​မျိုး​တော်​သည်၊","poem":2},{"lineBreak":true},{"text":"ကိုယ်​တော်​ကယ်​တင်​တော်​မူ​သော​အ​ခါ ရွှင်​လန်း​ဝမ်း​မြောက်​လိမ့်​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​အား​ထော​မ​နာ​ပြု​ကြ​လော့။ ကူ​မ​တော်​မူ​ရန်​တောင်း​လျှောက်​ကြ​လော့။","poem":1},{"text":"ကိုယ်​တော်​ပြု​တော်​မူ​သော​အ​မှု​တော်​တို့​ကို လူ​မျိုး​တ​ကာ​တို့​အား​ပြော​ကြား​ကြ​လော့။","poem":2},{"text":"ကိုယ်​တော်​၏​ကြီး​မြတ်​တော်​မူ​ပုံ​ကို သူ​တို့​အား​ပြော​ကြား​ကြ​လော့'' ဟု","poem":1},{"text":"လူ​တို့​သီ​ဆို​ကူး​ဧ​မည့်​အ​ချိန်​ကာ​လ ကျ​ရောက်​လာ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"``ကိုယ်​တော်​ပြု​တော်​မူ​သော​ကြီး​မြတ်​သည့် အ​မှု​တော်​တို့​အ​တွက်","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​၏​ဂုဏ်​တော်​ကို​ချီး​ကူး သီ​ဆို​ကြ​လော့။","poem":2},{"text":"ကမ္ဘာ​သူ​ကမ္ဘာ​သား​အ​ပေါင်း​တို့​အား ထို​သ​တင်း​ကို​ကြေ​ညာ​ကြ​လော့။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ဇိ​အုန်​မြို့​သူ​မြို့​သား​အ​ပေါင်း​တို့​အား ကြွေး​ကြော်​သီ​ဆို​စေ​ကြ​လော့။","poem":1},{"text":"ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​၏ ဘု​ရား​သ​ခင်​သည်​ကြီး​မြတ်​တော်​မူ​၍၊","poem":2},{"text":"မိ​မိ​လူ​မျိုး​တော်​အ​လယ်​၌​ကျိန်း​ဝပ်​တော် မူ​၏။''","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}