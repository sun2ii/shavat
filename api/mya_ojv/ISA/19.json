{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"ISA","translationId":"mya_ojv","name":"ဟေ​ရှာ​ယ","commonName":"ဟေ​ရှာ​ယ","title":"ဟေ​ရှာ​ယ​အ​နာ​ဂတ္တိ​ကျမ်း","order":23,"numberOfChapters":66,"sha256":"0ecde7adeefb35d34c2ca35ea2ed2a55a58709f1aa577ee75335df64c34e73d7","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mya_ojv/ISA/66.json","totalNumberOfVerses":1281},"chapter":{"number":19,"content":[{"type":"heading","content":["အီ​ဂျစ်​ပြည်​ကို​ဘု​ရား​သ​ခင်​အ​ပြစ်​ဒဏ် ခတ်​တော်​မူ​မည့်​အ​ကြောင်း"]},{"type":"verse","number":1,"content":["ဤ​ဗျာ​ဒိတ်​တော်​သည်​အီ​ဂျစ်​ပြည်​နှင့် သက် ဆိုင်​သော​ဗျာ​ဒိတ်​တော်​ဖြစ်​၏။ ထာ​ဝ​ရ​ဘု​ရား​သည်​မိုး​တိမ်​ကို​စီး​၍ အီ​ဂျစ် ပြည်​သို့​လျင်​မြန်​စွာ​ကြွ​လာ​တော်​မူ​လေ​ပြီ။ အီ​ဂျစ်​ပြည်​ရှိ​ရုပ်​တု​ဆင်း​တု​များ​သည် ကိုယ် တော်​၏​ရှေ့​တော်​၌​ကြောက်​လန့်​တုန်​လှုပ်​ကြ ကုန်​၏။ အီ​ဂျစ်​ပြည်​သူ​တို့​သည်​လည်း​သူ​ရဲ ဘော​ကြောင်​၍​သွား​ကုန်​၏။-"]},{"type":"verse","number":2,"content":["ထာ​ဝ​ရ​ဘု​ရား​က``ငါ​သည်​အီ​ဂျစ်​ပြည်​တွင် ပြည်​တွင်း​စစ်​ဖြစ်​စေ​ရန်​လှုံ့​ဆော်​၍​ညီ​အစ်​ကို အ​ချင်း​ချင်း၊ အိမ်​နီး​ချင်း​အ​ချင်း​ချင်း​ခိုက် ရန်​ဖြစ်​ပွား​စေ​မည်။ ဂုဏ်​ပြိုင်​ဘက်​မြို့​များ​သည် လည်း​ကောင်း၊ ဂုဏ်​ပြိုင်​ဘက်​မင်း​တို့​သည်​လည်း ကောင်း၊ အ​ချင်း​ချင်း​တိုက်​ခိုက်​ကာ​အာ​ဏာ လု​ကြ​လိမ့်​မည်။-"]},{"type":"verse","number":3,"content":["ငါ​သည်​အီ​ဂျစ်​အ​မျိုး​သား​တို့​၏ အ​ကြံ အ​စည်​များ​ကို​ပျက်​စီး​စေ​၍ သူ​တို့​၏​စိတ် ဋ္ဌာတ်​ကို​လည်း​ပျက်​ပြား