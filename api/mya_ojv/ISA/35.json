{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"ISA","translationId":"mya_ojv","name":"ဟေ​ရှာ​ယ","commonName":"ဟေ​ရှာ​ယ","title":"ဟေ​ရှာ​ယ​အ​နာ​ဂတ္တိ​ကျမ်း","order":23,"numberOfChapters":66,"sha256":"0ecde7adeefb35d34c2ca35ea2ed2a55a58709f1aa577ee75335df64c34e73d7","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mya_ojv/ISA/66.json","totalNumberOfVerses":1281},"chapter":{"number":35,"content":[{"type":"heading","content":["သန့်​ရှင်း​မြင့်​မြတ်​ရာ​သို့​သွား​သည့်​လမ်း​ခ​ရီး"]},{"type":"verse","number":1,"content":[{"text":"ကန္တာ​ရ​သည်​ရွှင်​မြူး​လိမ့်​မည်။","poem":1},{"text":"မြေ​ရိုင်း​များ​တွင်​လည်း​ပန်း​များ​ပွင့်​လိမ့်​မည်။","poem":2},{"text":"ကန္တာ​ရ​သည်​ဝမ်း​မြောက် ရွှင်​လန်း​သ​ဖြင့်","poem":1},{"text":"သီ​ချင်း​ဆို​ကြွေး​ကြော်​လိမ့်​မည်။","poem":2},{"text":"လေ​ဗ​နုန်​တောင်​ကဲ့​သို့​လှ​ပ​တင့်​တယ်​လျက်","poem":1},{"text":"ကာ​ရ​မေ​လ​နှင့်​ရှာ​ရုန်​တောင်​ကုန်း","poem":2},{"text":"လယ်​ယာ​များ​ကဲ့​သို့​အ​သီး​အ​နှံ​များ ဝေ​ဆာ​လျက် ရှိ​လိမ့်​မည်။","poem":1},{"text":"လူ​အ​ပေါင်း​တို့​သည်​ဘု​ရား​သ​ခင်​၏ ဘုန်း​အ​သ​ရေ​တော်​ကို​လည်း​ကောင်း၊","poem":2},{"text":"ကိုယ်​တော်​၏​တန်​ခိုး​အာ​နု​ဘော်​တော်​ကို လည်း​ကောင်း ဖူး​မြင်​ရ​ကြ​လိမ့်​မည်။","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"နွမ်း​နယ်​လျက်​ရှိ​သည့်​လက်​တို့​ကို​လည်း​ကောင်း၊","poem":1},{"text":"အား​နည်း​တုန်​လှုပ်​လျက်​နေ​သည့် ဒူး​တို့​ကို​လည်း​ကောင်း​အား​ဖြည့်​၍​ပေး​ကြ​လော့။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"စိတ်​ပျက်​အား​လျော့​၍​နေ​သူ​အ​ပေါင်း​တို့​အား ``ကြံ့​ခိုင်​မှု​ရှိ​ကြ​လော့။","poem":1},{"text":"မ​ကြောက်​ကြ​နှင့်​ဘု​ရား​သ​ခင်​သည်","poem":2},{"text":"သင်​တို့​ကို​ကယ်​ဆယ်​ရန် ကြွ​လာ​တော်​မူ​လိမ့်​မည်။","poem":1},{"text":"သင်​တို့​၏​ရန်​သူ​များ​အား​လည်း လက်​စား​ချေ​တော်​မူ​လိမ့်​မည်'' ဟု ပြော​ကြား​ကြ​လော့။","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"မျက်​မ​မြင်​တို့​သည်​မျက်​စိ​မြင်​ကြ​လိမ့်​မည်။","poem":1},{"text":"နား​ပင်း​သူ​တို့​သည်​လည်း​နား​ကြား​ကြ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ခြေ​မ​စွမ်း​မ​သန်​သူ​တို့​သည် ခုန်​ကြ​လိမ့်​မည်။","poem":1},{"text":"ဆွံ့​အ​သူ​တို့​သည်​လည်း​ဝမ်း​မြောက်​ရွှင်​လန်း​စွာ ကြွေး​ကြော်​ကြ​လိမ့်​မည်။","poem":2},{"text":"ကန္တာ​ရ​၌​စမ်း​ရေ​ပေါက်​၍​ကန္တာ​ရ​တွင် စမ်း​ချောင်း​စီး​လိမ့်​မည်။","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ခြစ်​ခြစ်​တောက်​ပူ​လောင်​လျက်​ရှိ​သည့်​သဲ​များ​သည် ရေ​အိုင်​ဖြစ်​၍၊","poem":1},{"text":"ခြောက်​သွေ့​သော​မြေ​သည်​လည်း​စမ်း​ရေ​တွင်း​များ ပြည့်​နှက်​၍​နေ​လိမ့်​မည်။","poem":2},{"text":"ခွေး​အ​များ​ကျက်​စား​လေ့​ရှိ​သည့်​အ​ရပ်​တွင် ကိုင်း​ပင်​ကူ​ပင်​များ​ပေါက်​လာ​လိမ့်​မည်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ထို​အ​ရပ်​တွင်``သန့်​ရှင်း​မြင့်​မြတ်​ရာ​သို့ သွား​သည့်​လမ်း'' ဟု","poem":1},{"text":"နာ​မည်​တွင်​သော​လမ်း​မ​ကြီး​တစ်​သွယ် ပေါ်​ပေါက်​၍​လာ​လိမ့်​မည်။","poem":2},{"text":"အ​ဘယ်​အ​ပြစ်​ကူး​သူ​မှန်​သ​မျှ​ထို​လမ်း​ကို လျှောက်​သွား​ရ​လိမ့်​မည်​မ​ဟုတ်။","poem":1},{"text":"အ​ဘယ်​လူ​မိုက်​က​မျှ​ထို​လမ်း​တွင် လျှောက်​နေ​သူ​တို့​အား","poem":2},{"lineBreak":true},{"text":"လမ်း​မှား​စေ​နိုင်​လိမ့်​မည်​မ​ဟုတ်။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ထို​အ​ရပ်​တွင်​အ​ဘယ်​ခြင်္သေ့​မျှ​ရှိ​လိမ့်​မည်​မ​ဟုတ်။","poem":1},{"text":"ထို​အ​ရပ်​သို့​အ​ဘယ်​သား​ရဲ​တိရစ္ဆာန်​မျှ​လည်း လာ​ရ​ကြ​လိမ့်​မည်​မ​ဟုတ်။","poem":2},{"text":"ထာ​ဝ​ရ​ဘု​ရား​ကယ်​ဆယ်​ထား​တော်​မူ​သော သူ​တို့​သည်","poem":1},{"text":"ထို​လမ်း​အ​တိုင်း​မိ​မိ​တို့​နေ​ရပ်​သို့ ပြန်​ရ​ကြ​လိမ့်​မည်မဟုတ်။","poem":2}]},{"type":"verse","number":10,"content":[{"text":"သူ​တို့​သည်​ဝမ်း​မြောက်​ပျော်​ရွှင်​စွာ​သီ​ချင်း ဆို​လျက် ယေ​ရု​ရှ​လင်​မြို့​သို့​ရောက်​ရှိ​လာ​ကြ​လိမ့်​မည်။","poem":1},{"lineBreak":true},{"text":"သူ​တို့​သည်​ထာ​ဝ​စဉ်​ရွှင်​လန်း​ဝမ်း​မြောက်​ကြ လိမ့်​မည်။","poem":1},{"text":"ဝမ်း​နည်း​ပူ​ဆွေး​ခြင်း​နှင့်​ထာ​ဝ​စဉ်​ကင်း​လွတ် ကြ​လိမ့်​မည်။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":9}