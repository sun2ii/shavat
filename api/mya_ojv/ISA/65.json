{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"ISA","translationId":"mya_ojv","name":"ဟေ​ရှာ​ယ","commonName":"ဟေ​ရှာ​ယ","title":"ဟေ​ရှာ​ယ​အ​နာ​ဂတ္တိ​ကျမ်း","order":23,"numberOfChapters":66,"sha256":"0ecde7adeefb35d34c2ca35ea2ed2a55a58709f1aa577ee75335df64c34e73d7","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/mya_ojv/ISA/66.json","totalNumberOfVerses":1281},"chapter":{"number":65,"content":[{"type":"heading","content":["ပုန်​ကန်​သူ​တို့​အား​ဘု​ရား​သခင်​အ​ပြစ်​ဒဏ် ခတ်​တော်​မူ​ခြင်း"]},{"type":"verse","number":1,"content":["ထာ​ဝ​ရ​ဘု​ရား​က``ငါ​သည်​မိ​မိ​လူ​မျိုး တော်​၏​ဆု​တောင်း​ပတ္ထ​နာ​များ​ကို​နား​ညောင်း ရန်​အ​သင့်​ရှိ​သော်​လည်း သူ​တို့​သည်​ဆု​တောင်း ပတ္ထ​နာ​မ​ပြု​ကြ။ ငါ​သည်​သူ​တို့​ရှာ​လျှင် တွေ့​မြင်​နိုင်​ရန်​အ​သင့်​စောင့်​၍​နေ​သော်​လည်း သူ​တို့​သည်​ငါ့​ကို​ရှာ​ရန်​ပင်​မ​ကြိုး​စား​ကြ။ ငါ​သည်​ဤ​အ​ရပ်​တွင်​ရှိ​၏။ ငါ​သည်​ကူ​မ​မည် ဟု​ဖြေ​ကြား​ရန်​အ​သင့်​ရှိ​သော်​လည်း၊ ဣ​သ ရေ​လ​အ​မျိုး​သား​တို့​သည်​ငါ့​ထံ​သို့​ဆု တောင်း​ပတ္ထ​နာ​မ​ပြု​ကြ။-"]},{"type":"verse","number":2,"content":["ခေါင်း​မာ​လျက်​အ​မှား​ကို​ပြု​ကျင့်​ကာ​မိ​မိ တို့​၏​ထင်​ရာ​သို့​လိုက်​တတ်​သူ ဤ​လူ​စု​အား ငါ​သည်​ကြို​ဆို​လက်​ခံ​ရန်​အ​စဉ်​အ​မြဲ အ​သင့်​ရှိ​ပါ​၏။-"]},{"type":"verse","number":3,"content":["သို့​ရာ​တွင်​သူ​တို့​သည်​အ​ရှက်​မ​ရှိ။ ငါ​၏ အ​မျက်​တော်​ကို​လှုံ့​ဆော်​ကြ​၏။ သူ​တို့​သည် မြေ​သြ​ဇာ​နတ်​ဘု​ရား​တို့​ကို​ဥ​ယျာဉ်​များ တွင်​ယဇ်​ပူ​ဇော်​ကြ​၏။ ရုပ်​တု​ကိုး​ကွယ်​ရာ ယဇ်​ပလ္