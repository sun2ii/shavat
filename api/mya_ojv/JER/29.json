{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"JER","translationId":"mya_ojv","name":"ယေ​ရ​မိ","commonName":"ယေ​ရ​မိ","title":"ယေ​ရ​မိ​အ​နာ​ဂတ္တိ​ကျမ်း","order":24,"numberOfChapters":52,"sha256":"d08217b8d949fa379cabf0dca1da439fc47b6bad2d7113986204b1240a83a1ba","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/mya_ojv/JER/52.json","totalNumberOfVerses":1327},"chapter":{"number":29,"content":[{"type":"heading","content":["ဗာ​ဗု​လုန်​မြို့​ရှိ​ယု​ဒ​အ​မျိုး​သား​တို့​ထံ​သို့ ယေ​ရ​မိ​ပေး​စာ"]},{"type":"verse","number":1,"content":["ငါ​သည်​ယေ​ရု​ရှ​လင်​မြို့​မှ​သုံ့​ပန်း​များ​အ​ဖြစ် ဗာ​ဗု​လုန်​မြို့​သို့​နေ​ဗု​ခဒ်​နေ​ဇာ​ဖမ်း​ဆီး​ခေါ် ဆောင်​သွား​သည့်​ခေါင်း​ဆောင်​များ၊ ယဇ်​ပု​ရော ဟိတ်​များ​နှင့်​ပြည်​သူ​အ​ပေါင်း​တို့​ထံ​သို့ စာ​တစ်​စောင်​ပေး​ပို့​လိုက်​၏။-"]},{"type":"verse","number":2,"content":["ငါ​သည်​ယေ​ခေါ​နိ​မင်း၊ ထို​မင်း​၏​မယ်​တော်၊ နန်း​တွင်း​အ​ရာ​ရှိ​များ၊ ယု​ဒ​ပြည်​နှင့်​ယေ​ရု ရှ​လင်​မြို့​မှ​ခေါင်း​ဆောင်​များ၊ အ​တတ်​ပ​ညာ သည်​များ​နှင့်​လုပ်​ရည်​ကိုင်​ရည်​ရှိ​သူ​အ​လုပ် သ​မား​များ​သိမ်း​သွား​ခြင်း​ကို​ခံ​ရ​သည့် နောက် ထို​စာ​ကို​ရေး​သား​လေ​သည်။-"]},{"type":"verse","number":3,"content":["ငါ​သည်​စာ​ကို​ယု​ဒ​ဘု​ရင်​ဇေ​ဒ​ကိ​က နေ​ဗု​ခဒ်​နေ​ဇာ​ထံ​စေ​လွှတ်​သော ရှာ​ဖန်​၏​သား ဧ​လာ​သာ​နှင့်​ဟိ​လ​ခိ​၏​သား​ဂေ​မ​ရိ​တို့ အား​ဖြင့်​ပေး​ပို့​လိုက်​၏။ စာ​တွင်၊"]},{"type":"verse","number":4,"content":["``ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​၏​ဘု​ရား​သခင်၊ အ​နန္တ​တန်​ခိုး​ရ