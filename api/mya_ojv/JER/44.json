{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"JER","translationId":"mya_ojv","name":"ယေ​ရ​မိ","commonName":"ယေ​ရ​မိ","title":"ယေ​ရ​မိ​အ​နာ​ဂတ္တိ​ကျမ်း","order":24,"numberOfChapters":52,"sha256":"d08217b8d949fa379cabf0dca1da439fc47b6bad2d7113986204b1240a83a1ba","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/mya_ojv/JER/52.json","totalNumberOfVerses":1327},"chapter":{"number":44,"content":[{"type":"heading","content":["အီ​ဂျစ်​ပြည်​ရှိ​ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​အ​တွက် ထာ​ဝ​ရ​ဘု​ရား​၏​ဗျာ​ဒိတ်​တော်"]},{"type":"verse","number":1,"content":["ထာ​ဝ​ရ​ဘု​ရား​သည်​အီ​ဂျစ်​ပြည်​မိ​ဂ​ဒေါ​လ မြို့၊ တာ​ပ​နက်​မြို့၊ နော​ဖ​မြို့​နှင့်​တောင်​ပိုင်း​ဒေ​သ ၌​ရှိ​သော​ဣ​သ​ရေ​လ​အ​မျိုး​သား​အ​ပေါင်း တို့​ကို​ရည်​မှတ်​၍ ငါ့​အား​ဗျာ​ဒိတ်​ပေး​တော် မူ​၏။-"]},{"type":"verse","number":2,"content":["ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​၏​ဘု​ရား​သ​ခင် အ​နန္တ​တန်​ခိုး​ရှင်​ထာဝ​ရ​ဘု​ရား​က``ယေ​ရု ရှ​လင်​မြို့​နှင့်​အ​ခြား​ယု​ဒ​မြို့​တို့​အား​ငါ အ​ဘယ်​သို့​ကပ်​သင့်​စေ​သည်​ကို သင်​တို့​ကိုယ် တိုင်​တွေ့​မြင်​ခဲ့​ရ​လေ​ပြီ။ ထို​မြို့​များ​သည် ယ​ခု​တိုင်​အောင်​ပင်​ယို​ယွင်း​ပျက်​စီး​ကာ လူ​သူ​ဆိတ်​ငြိမ်​လျက်​ရှိ​ကြ​၏။-"]},{"type":"verse","number":3,"content":["ယင်း​သို့​ငါ​ဖြစ်​စေ​ရ​သည့်​အ​ကြောင်း​မှာ​ထို မြို့​တို့​မှ​မြို့​သူ​မြို့​သား​များ​သည်​မ​ကောင်း မှု​များ​ကို​ပြု​၍ ငါ​၏​အ​မျက်​တော်​ကို​လှုံ့ ဆော်​ကြ​သော​ကြောင့်​ဖြစ်​၏။ သူ​တို့​သည် အ​ခြား​ဘု​ရား​များ​ကို​ယဇ်​ပူ​ဇော်​ကြ လျက် သူ​တို့​ကိုယ်