{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"JHN","translationId":"mya_ojv","name":"ရှင်ယောဟန်","commonName":"ရှင်ယောဟန်","title":"ရှင်ယောဟန် ပြုစုသည့်သတင်းကောင်း","order":43,"numberOfChapters":21,"sha256":"1872d3fb9d1d1537f08a0366349dc3b307a02784e572c382eb4481bbe9c65474","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/JHN/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/mya_ojv/JHN/21.json","totalNumberOfVerses":868},"chapter":{"number":12,"content":[{"type":"heading","content":["ဗေ​သ​နိ​ရွာ​တွင်​ကိုယ်​တော်​၏​ခြေ​တော်​ကို ဆီ​မွှေး​ဖြင့်​လိမ်း​ခြင်း"]},{"type":"verse","number":1,"content":["ပ​သ​ခါ​ပွဲ​တော်​ကျ​ရောက်​ရန်​ခြောက်​ရက်​မျှ အ​လို​၌ သေ​လွန်​ပြီး​မှ​ပြန်​၍​အ​သက်​ရှင် စေ​တော်​မူ​ခဲ့​သူ လာ​ဇ​ရု​နေ​ထိုင်​ရာ​ဗေ​သ​နိ ရွာ​သို့​သ​ခင်​ယေ​ရှု​ကြွ​တော်​မူ​၏။-"]},{"type":"verse","number":2,"content":["ကိုယ်​တော်​အား​ည​စာ​ဖြင့်​ဧည့်​ခံ​ရာ​၌​မာ​သ​က ဧည့်​ဝတ်​ကို​ပြု​၏။ ကိုယ်​တော်​နှင့်​အ​တူ​စား​ပွဲ​တွင် ထိုင်​ကြ​သူ​များ​အ​ထဲ​တွင်​လာ​ဇ​ရု​လည်း​ပါ​၏။-"]},{"type":"verse","number":3,"content":["ထို​အ​ခါ​မာ​ရိ​သည်​အ​လွန်​အ​ဖိုး​ထိုက်​သော နာ​ဒု​ဆီ​မွှေး​အ​စစ်​သုံး​ဆယ်​သား​ကို​ယူ​၍ သ​ခင်​ယေ​ရှု​၏​ခြေ​တော်​ကို​လိမ်း​ပြီး​နောက် မိ​မိ​၏​ဆံ​ပင်​နှင့်​သုတ်​လေ​၏။ ဤ​ဆီ​မွှေး​၏ ရ​နံ့​သည်​တစ်​အိမ်​လုံး​မွှေး​ကြိုင်​လျက်​ရှိ​၏။-"]},{"type":"verse","number":4,"content":["တ​ပည့်​တော်​တစ်​ဦး​ဖြစ်​သူ​ယု​ဒ​ရှ​ကာ​ရုတ် က ``ဤ​ဆီ​မွှေး​ကို​အ​ဘယ်​ကြောင့်​ဒေ​နာ​ရိ သုံး​ရာ​ဖြင့်​ရောင်း​၍ ဆင်း​ရဲ​သူ​တို့​အား​မ​စွန့် မ​ကြဲ​ပါ​သ​နည