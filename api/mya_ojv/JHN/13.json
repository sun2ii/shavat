{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"JHN","translationId":"mya_ojv","name":"ရှင်ယောဟန်","commonName":"ရှင်ယောဟန်","title":"ရှင်ယောဟန် ပြုစုသည့်သတင်းကောင်း","order":43,"numberOfChapters":21,"sha256":"1872d3fb9d1d1537f08a0366349dc3b307a02784e572c382eb4481bbe9c65474","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/JHN/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/mya_ojv/JHN/21.json","totalNumberOfVerses":868},"chapter":{"number":13,"content":[{"type":"heading","content":["တ​ပည့်​တော်​တို့​၏​ခြေ​ကို ဆေး​တော်​မူ​ခြင်း"]},{"type":"verse","number":1,"content":["အ​ခါ​ကား​ပ​သ​ခါ​ပွဲ​တော်​မ​တိုင်​မီ​တစ်​ရက် ဖြစ်​၏။ သ​ခင်​ယေ​ရှု​သည်​ဤ​လော​က​မှ​ထွက် ခွာ​၍ ခ​မည်း​တော်​ထံ​သို့​ကြွ​တော်​မူ​ရ​မည့် အ​ချိန်​ကျ​ရောက်​လာ​ကြောင်း​ကို​သိ​တော်​မူ ၏။ ကိုယ်​တော်​သည်​ဤ​လော​က​ရှိ​မိ​မိ​၏​တပည့် သား​ရင်း​များ​ကို​အ​စဉ်​ပင်​ချစ်​တော်​မူ​၏။ သူ​တို့​အား​ဆုံး​ခန်း​တိုင်​အောင်​ချစ်​တော် မူ​ပေ​သည်။"]},{"type":"verse","number":2,"content":["သ​ခင်​ယေ​ရှု​နှင့်​တ​ပည့်​တော်​တို့​သည်​ည​စာ စား​လျက်​နေ​ကြ​၏။ မာရ်​နတ်​သည်​ရှိ​မုန်​ရှ ကာ​ရုတ်​သား​ယု​ဒ​အား ကိုယ်​တော်​ကို​ရန်​သူ့ လက်​သို့​အပ်​နှံ​စေ​ရန်​အ​ကြံ​ပေး​ထား​ပြီး ဖြစ်​ပေ​သည်။-"]},{"type":"verse","number":3,"content":["သ​ခင်​ယေ​ရှု​သည်​မိ​မိ​အား​ခ​မည်း​တော်​က အာ​ဏာ​ကုန်​လွှဲ​အပ်​ထား​သည်​ကို​လည်း​ကောင်း၊ မိ​မိ​သည်​ဘု​ရား​သ​ခင်​ထံ​တော်​မှ​ကြွ​လာ ၍ ဘု​ရား​သ​ခင်​ထံ​တော်​သို့​ပြန်​တော့​မည်​ကို လည်း​ကောင်း​သိ​တော်​မူ​၏။-"]},{"type":"verse","number":4,"content":["သို့​ဖြစ်​၍​စ