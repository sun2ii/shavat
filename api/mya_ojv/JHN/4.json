{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"JHN","translationId":"mya_ojv","name":"ရှင်ယောဟန်","commonName":"ရှင်ယောဟန်","title":"ရှင်ယောဟန် ပြုစုသည့်သတင်းကောင်း","order":43,"numberOfChapters":21,"sha256":"1872d3fb9d1d1537f08a0366349dc3b307a02784e572c382eb4481bbe9c65474","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/JHN/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/mya_ojv/JHN/21.json","totalNumberOfVerses":868},"chapter":{"number":4,"content":[{"type":"heading","content":["သ​ခင်​ယေ​ရှု​နှင့်​ရှ​မာ​ရိ​အ​မျိုး​သ​မီး"]},{"type":"verse","number":1,"content":["သ​ခင်​ယေ​ရှု​သည်​ယော​ဟန်​ထက်​ပို​၍​များ သော​တ​ပည့်​များ​ကို ဗတ္တိ​ဇံ​မင်္ဂ​လာ​ပေး​လျက် နေ​သည်​ကို​ဖာ​ရိ​ရှဲ​တို့​ကြား​သိ​ကြ​၏။-"]},{"type":"verse","number":2,"content":["(အ​မှန်​မှာ​သ​ခင်​ယေ​ရှု​ကိုယ်​တော်​တိုင်​ဗတ္တိ​ဇံ မင်္ဂ​လာ​ကို​ပေး​တော်​မ​မူ။ တ​ပည့်​တော်​တို့​သာ လျှင်​ပေး​ခြင်း​ဖြစ်​၏။)-"]},{"type":"verse","number":3,"content":["ယင်း​သို့​ဖာ​ရိ​ရှဲ​တို့​ကြား​သိ​ကြ​ကြောင်း​ကို သ​ခင်​ယေ​ရှု​သိ​တော်​မူ​လျှင် ယု​ဒ​ပြည်​မှ ထွက်​ခွာ​တော်​မူ​၍​ဂါ​လိ​လဲ​ပြည်​သို့​ကြွ တော်​မူ​၏။-"]},{"type":"verse","number":4,"content":["လမ်း​တွင်​ရှ​မာ​ရိ​ပြည်​ကို​ဖြတ်​၍​သွား​ရ​၏။"]},{"type":"verse","number":5,"content":["ရှု​ခါ​နာ​မည်​ရှိ​သော​မြို့​သို့​ရောက်​တော်​မူ​၏။ ထို​မြို့​သည်​ယာ​ကုပ်​က​သား​ယော​သပ်​အား ပေး​သည့်​မြေ​ယာ​အ​နီး​တွင်​တည်​ရှိ​၏။-"]},{"type":"verse","number":6,"content":["ထို​အ​ရပ်​တွင်​ယာကုပ်​၏​ရေ​တွင်း​ရှိ​၏။ သ​ခင် ယေ​ရှု​သည်​ခ​ရီး​ပန်