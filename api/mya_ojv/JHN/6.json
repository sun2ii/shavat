{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"JHN","translationId":"mya_ojv","name":"ရှင်ယောဟန်","commonName":"ရှင်ယောဟန်","title":"ရှင်ယောဟန် ပြုစုသည့်သတင်းကောင်း","order":43,"numberOfChapters":21,"sha256":"1872d3fb9d1d1537f08a0366349dc3b307a02784e572c382eb4481bbe9c65474","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/JHN/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/mya_ojv/JHN/21.json","totalNumberOfVerses":868},"chapter":{"number":6,"content":[{"type":"heading","content":["လူ​ငါး​ထောင်​ကို​ကျွေး​မွေး​တော်​မူ​ခြင်း"]},{"type":"verse","number":1,"content":["ထို​သို့​မိန့်​တော်​မူ​ပြီး​နောက်​သ​ခင်​ယေ​ရှု​သည် ဂါ​လိ​လဲ​အိုင် (တိ​ဗေ​ရိ​အိုင်​ဟု​လည်း​ခေါ်​သည်) ကို​ကူး​တော်​မူ​၏။-"]},{"type":"verse","number":2,"content":["သူ​နာ​များ​အား​ရော​ဂါ​ပျောက်​ကင်း​စေ​တော် မူ​သည်​ကို​တွေ့​မြင်​ခဲ့​ကြ​သ​ဖြင့် လူ​ပ​ရိ​သတ် ကြီး​သည်​နောက်​တော်​သို့​လိုက်​ကြ​၏။-"]},{"type":"verse","number":3,"content":["သ​ခင်​ယေ​ရှု​သည်​တောင်​ပေါ်​သို့​တက်​တော်​မူ​၍ တ​ပည့်​တော်​တို့​နှင့်​အ​တူ​ထိုင်​တော်​မူ​၏။-"]},{"type":"verse","number":4,"content":["ယု​ဒ​အ​မျိုး​သား​တို့​၏​ပွဲ​တော်​ဖြစ်​သော ပ​သ​ခါ​ပွဲ​ကျ​ရောက်​ရန်​အ​ခါ​ကား​နီး ပေ​ပြီ။-"]},{"type":"verse","number":5,"content":["သ​ခင်​ယေ​ရှု​သည်​မျှော်​ကြည့်​လိုက်​သော​အ​ခါ မိ​မိ​ထံ​သို့​လူ​ပ​ရိ​သတ်​ကြီး​လာ​လျက်​နေ သည်​ကို​မြင်​တော်​မူ​၍ ``ဤ​သူ​တို့​စား​ရန် အ​စား​အ​စာ​ကို​အ​ဘယ်​မှာ​ဝယ်​နိုင်​သ​နည်း'' ဟု​ဖိ​လိပ္ပု​အား​မေး​တော်​မူ​၏။-"]},{"type":"verse","number":6,"content":["(ဤ