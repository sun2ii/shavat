{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"JON","translationId":"mya_ojv","name":"ယော​န","commonName":"ယော​န","title":"ယော​န​ဝတ္ထု","order":32,"numberOfChapters":4,"sha256":"8544da77bef080ae82ecaed48eaa0b858415d19265569e9b277ccf82b3751e2d","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/mya_ojv/JON/4.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["ယော​န​၏​ဆု​တောင်း​ပတ္ထ​နာ"]},{"type":"verse","number":1,"content":["ထို​နောက်​ယော​န​သည်​ငါး​ကြီး​၏​ဝမ်း​ဗိုက် တွင်း​မှ​နေ​၍ မိ​မိ​၏​ဘု​ရား​သ​ခင်​ထာ​ဝ​ရ ဘု​ရား​အား၊"]},{"type":"verse","number":2,"content":[{"text":"``အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"အ​ကျွန်ုပ်​သည်​ဘေး​နှင့်​ကြုံ​တွေ့​နေ​ရ​သည့်​အ​တွက် ကိုယ်​တော်​အား​ဟစ်​ခေါ်​ခဲ့​ပါ​သည်။","poem":2},{"text":"ကိုယ်​တော်​က​လည်း​ကြား​တော်​မူ​ပါ​၏။","poem":1},{"text":"အ​ကျွန်ုပ်​သည်​သေ​မင်း​၏​ခံ​တွင်း​မှ​နေ​၍","poem":2},{"text":"ကိုယ်​တော်​အား​ဟစ်​အော်​သံ​ကို​ကိုယ်​တော် ကြား​တော်​မူ​ပါ​၏။","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​သည်​အ​ကျွန်ုပ်​အား​နက်​ရှိုင်း​သော ပင်​လယ်​ထဲ​သို့​လည်း​ကောင်း၊","poem":1},{"text":"ပင်​လယ်​အောက်​ဆုံး​ပိုင်း​တိုင်​အောင်​လည်း​ကောင်း ပစ်​ချ​လိုက်​သ​ဖြင့်၊","poem":2},{"text":"အ​ကျွန်ုပ်​မှာ​ပင်​လယ်​ရေ​ပတ်​လည် ဝိုင်း​ရံ​ခြင်း​ကို​ခံ​လျက်","poem":1},{"text":"ကိုယ်​တော်​၏​လှိုင်း​လုံး​ကြီး​များ​သည် အ​ကျွန်ုပ်​ကို​လွှမ်း​မိုး​သွား​ပါ​သည်။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"အ​ကျွန်ုပ်​သည်​ကိုယ်​တော်​၏​မျက်​မှောက်​မှ နှင်​ထုတ်​ခြင်း​ကို​ခံ​ရ​သ​ဖြင့်၊","poem":1},{"text":"ကိုယ်​တော်​၏​သန့်​ရှင်း​မြင့်​မြတ်​သော​ဗိ​မာန် တော်​ကို အ​ဘယ်​အ​ခါ​၌​မျှ​တွေ့​မြင်​ရ​တော့​မည် မ​ဟုတ်​ဟု​ထင်​မှတ်​ခဲ့​ပါ​၏။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ရေ​သည်​အ​ကျွန်ုပ်​ကို​ဝိုင်း​ရံ​သ​ဖြင့်​အ​ကျွန်ုပ် သည် အ​သက်​ရှူ​၍​ပင်​မ​ရ​တော့​ပါ။","poem":1},{"text":"ပင်​လယ်​ရေ​သည်​အ​ကျွန်ုပ်​အား​လွှမ်း​မိုး​လျက်၊ ပင်​လယ်​ဒိုက်​ပင်​တို့​သည်​လည်း","poem":2},{"text":"အ​ကျွန်ုပ်​၏​ဦး​ခေါင်း​ကို​ရစ်​ပတ်​ကြ​ပါ​၏။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"အ​ကျွန်ုပ်​သည်​တောင်​များ​၏​အောက်​ခြေ​သို့ တိုင်​အောင်​လည်း​ကောင်း၊","poem":1},{"text":"ပြန်​လမ်း​မ​ရှိ​သည့်​မ​ရ​ဏာ​နိုင်​ငံ​သို့ လည်း​ကောင်း နစ်​မြုပ်​သွား​ပါ​သည်။","poem":2},{"text":"သို့​ဖြစ်​လျက်​ပင်​အ​ကျွန်ုပ်​၏​ဘု​ရား​သ​ခင် ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​သည်​အ​ကျွန်ုပ်​၏​အ​သက်​ကို နက်​ရာ​မှ ကယ်​ဆယ်​တော်​မူ​ခဲ့​ပါ​၏။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"အ​ကျွန်ုပ်​သည်​သေ​အံ့​ဆဲ​ဆဲ​အ​ချိန်​တွင်","poem":1},{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊ ကိုယ်​တော်​၏​ထံ​တော်​သို့​ဆု​တောင်း​ခဲ့​ပါ​၏။","poem":2},{"text":"ကိုယ်​တော်​သည်​လည်း​ကိုယ်​တော်​၏","poem":1},{"text":"သန့်​ရှင်း​မြင့်​မြတ်​သော​ဗိ​မာန်​တော်​မှ အ​ကျွန်ုပ်​၏ ဆု​တောင်း​ပတ္ထ​နာ​သံ​ကို​ကြား​တော်​မူ​ပါ​၏။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"အ​ချည်း​နှီး​ဖြစ်​သော​ရုပ်​တု​များ​ကို","poem":1},{"text":"ကိုး​ကွယ်​သူ​တို့​သည်​ကိုယ်​တော်​၏​အ​ပေါ်​တွင် သစ္စာ​မဲ့​ကြ​ပါ​၏။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"သို့​ရာ​တွင်​အ​ကျွန်ုပ်​တို့​သည်​အ​ရှင်​၏ ဂုဏ်​တော်​ကို​ချီး​ကူး​ပါ​မည်။","poem":1},{"text":"ကိုယ်​တော်​အား​ယဇ်​ပူ​ဇော်​ပါ​မည်။","poem":2},{"text":"ထို့​ပြင်​အ​ကျွန်ုပ်​ပြု​ခဲ့​သည့်​သစ္စာ​က​တိ အ​တိုင်း လိုက်​နာ​ပါ​မည်။","poem":1},{"text":"အ​ကြောင်း​မှာ​ကယ်​တင်​ခြင်း​အ​မှု​သည်","poem":2},{"text":"ထာ​ဝ​ရ​ဘု​ရား​ထံ​တော်​မှ​လာ​ပါ​သည်'' ဟု ဆု​တောင်း​ပတ္ထ​နာ​ပြု​လေ​၏။","poem":1}]},{"type":"verse","number":10,"content":["ထို​အ​ခါ​ထာ​ဝ​ရ​ဘု​ရား​သည်​ငါး​ကြီး အား​အ​မိန့်​ပေး​သ​ဖြင့် ငါး​ကြီး​သည်​ယော​န အား​ကုန်း​ပေါ်​သို့​အန်​ထုတ်​လေ​၏။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}