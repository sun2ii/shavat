{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"JOS","translationId":"mya_ojv","name":"ယော​ရှု","commonName":"ယော​ရှု","title":"ယော​ရှု​မှတ်​စာ","order":6,"numberOfChapters":24,"sha256":"106561b53310a1f1dc42705b83bb6645630977619826a3b7dee2ca306ead4899","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/JOS/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/mya_ojv/JOS/24.json","totalNumberOfVerses":599},"chapter":{"number":10,"content":[{"type":"heading","content":["အာ​မော​ရိ​အ​မျိုး​သား​များ​စစ်​ရှုံး​ခြင်း"]},{"type":"verse","number":1,"content":["ယေ​ရု​ရှ​လင်​မြို့​၏​ဘု​ရင်​အ​ဒေါ​နိ​ဇေ​ဒက် သည်​ယေ​ရိ​ခေါ​မြို့​ကို​ယော​ရှု​တိုက်​ခိုက်​သိမ်း ပိုက်​၍ ၎င်း​၏​ဘု​ရင်​ကို​ကွပ်​မျက်​ခဲ့​သည့်​နည်း တူ​အာ​ဣ​မြို့​ကို​တိုက်​ခိုက်​သိမ်း​ပိုက်​၍ ၎င်း​၏ ဘု​ရင်​ကို​လည်း​ကွပ်​မျက်​ခဲ့​ကြောင်း​ကြား သိ​ရ​လေ​သည်။ ထို့​အ​ပြင်​ဂိ​ဗောင်​မြို့​သား တို့​သည်​ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​နှင့် ငြိမ်း​ချမ်း​ရေး​စာ​ချုပ်​ချုပ်​၍​အ​တူ​တ​ကွ နေ​ထိုင်​ကြ​ကြောင်း​ကို​လည်း​ကြား​သိ​ရ လေ​သည်။-"]},{"type":"verse","number":2,"content":["ယေ​ရု​ရှ​လင်​မြို့​သား​တို့​သည်​အ​လွန်​ကြောက် လန့်​ကြ​၏။ အ​ဘယ်​ကြောင့်​ဆို​သော်​ဂိ​ဗောင် မြို့​သည်​မင်း​နေ​ပြည်​တော်​မြို့​များ​ကဲ့​သို့ ကြီး​ကျယ်​ခမ်း​နား​သော​မြို့​ဖြစ်​သော​ကြောင့် လည်း​ကောင်း၊ အာ​ဣ​မြို့​ထက်​ကြီး​၍​မြို့​သား တို့​သည်​တိုက်​ရည်​ခိုက်​ရည်​ကောင်း​သူ​များ ဖြစ်​သော​ကြောင့်​လည်း​ကောင်း​ဖြစ်​သ​တည်း။-"]},{"type":"verse","number":3,"content":["သို့​ဖြစ်​၍​ယေ​ရု​ရှ​လင်​မြို့​ဘု​ရင်​မင်း​ကြီး အ​ဒေါ​န