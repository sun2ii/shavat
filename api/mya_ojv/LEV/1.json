{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"LEV","translationId":"mya_ojv","name":"ဝတ်​ပြု","commonName":"ဝတ်​ပြု","title":"ဝတ်​ပြု​ရာ​ကျမ်း","order":3,"numberOfChapters":27,"sha256":"a14473e40194a5deee71e6359dc6ae9c99dd7c235ee2237df96ddbe2f991e9ff","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/LEV/1.json","lastChapterNumber":27,"lastChapterApiLink":"/api/mya_ojv/LEV/27.json","totalNumberOfVerses":783},"chapter":{"number":1,"content":[{"type":"heading","content":["အ​ကောင်​လိုက်​ပူ​ဇော်​ရာ​ယဇ်"]},{"type":"verse","number":1,"content":["ထာ​ဝ​ရ​ဘု​ရား​သည် စံ​တော်​မူ​ရာ​တဲ​တော် ထဲ​မှ​မော​ရှေ​ကို​ဆင့်​ခေါ်​၍ ဣ​သ​ရေ​လ​အ​မျိုး သား​တို့​ယဇ်​ပူ​ဇော်​ရာ​တွင်​လိုက်​နာ​ရန် အောက် ဖော်​ပြ​ပါ​ပြ​ဋ္ဌာန်း​ချက်​များ​ကို​ချ​မှတ်​ပေး တော်​မူ​သည်။ တစ်​စုံ​တစ်​ယောက်​သော​သူ​သည် တိ​ရစ္ဆာန်​ကို​ယဇ် ပူ​ဇော်​သည့်​အ​ခါ မိ​မိ​နွား​အုပ်​ထဲ​မှ​ဖြစ်​စေ၊ သိုး​အုပ်​သို့​မ​ဟုတ်​ဆိတ်​အုပ်​ထဲ​မှ​ဖြစ်​စေ တိ​ရစ္ဆာန်​တစ်​ကောင်​ကို​ပူ​ဇော်​ရ​မည်။-"]},{"type":"verse","number":3,"content":["နွား​ကို​မီး​ရှို့​ရာ​ယဇ်​အ​ဖြစ်​ပူ​ဇော်​မည်​ဆို​လျှင် ထို​နွား​၌​အ​ပြစ်​အ​နာ​မ​ရှိ​စေ​ရ။ ထာ​ဝ​ရ ဘု​ရား​သည်​ထို​သူ​ကို​နှစ်​သက်​လက်​ခံ​ရန်​သူ သည်​နွား​ကို ထာ​ဝ​ရ​ဘု​ရား​စံ​တော်​မူ​ရာ​တဲ တော်​တံ​ခါး​ဝ​သို့​ယူ​ဆောင်​ခဲ့​ရ​မည်။-"]},{"type":"verse","number":4,"content":["သူ​သည်​နွား​၏​ဦး​ခေါင်း​ပေါ်​တွင် မိ​မိ​လက်​ကို တင်​သ​ဖြင့် နွား​ကို​သူ​၏​အ​ပြစ်​ဖြေ​ရာ​ယဇ် အ​ဖြစ်​ထာ​ဝ​ရ​ဘု​ရား​လက်​ခံ​တော်​မူ​မည်။-"]},{"type":"verse","number":5,"content":["သူ​သည်​ထို​နေ​ရာ​တွင်​နွား​ကို​သတ်​၍ အာ​ရုန် ၏​သား​များ​ဖြစ်​ကြ​သော​ယဇ်​ပု​ရော​ဟိတ်​တို့ က​သွေး​ကို ထာ​ဝ​ရ​ဘု​ရား​အား​ဆက်​သ​ပြီး လျှင် တဲ​တော်​တံ​ခါး​ဝ​တွင်​ရှိ​သော​ယဇ်​ပလ္လင် ဘေး​လေး​ဘက်​စ​လုံး​ပေါ်​သို့​ပက်​ဖျန်း​ရ ကြ​မည်။-"]},{"type":"verse","number":6,"content":["ထို​နောက်​သူ​သည်​နွား​ကို​အ​ရေ​ဆုတ်​၍ ခုတ် ဖြတ်​ရ​မည်။-"]},{"type":"verse","number":7,"content":["ယဇ်​ပု​ရော​ဟိတ်​တို့​က​ယဇ်​ပလ္လင်​ပေါ်​တွင် ထင်း​ကို​စီ​ခင်း​၍ မီး​ညှိ​ရ​မည်။-"]},{"type":"verse","number":8,"content":["ထို့​နောက်​အ​သား​တစ်၊ ဦး​ခေါင်း​နှင့်​အ​ဆီ​ကို ထင်း​ပေါ်​တွင်​စီ​တင်​ရ​မည်။-"]},{"type":"verse","number":9,"content":["ဝမ်း​တွင်း​သား​နှင့်​နောက်​ခြေ​များ​ကို​ရေ​ဆေး ရ​မည်။ ထို့​နောက်​တာ​ဝန်​ကျ​ယဇ်​ပု​ရော​ဟိတ် သည် တိ​ရစ္ဆာန်​တစ်​ကောင်​လုံး​ကို​ပလ္လင်​ပေါ်​တွင် မီး​ရှို့​ပူ​ဇော်​ရ​မည်။ ဤ​ပူ​ဇော်​သ​ကာ​၏​ရ​နံ့ ကို ထာ​ဝ​ရ​ဘု​ရား​နှစ်​သက်​တော်​မူ​၏။"]},{"type":"verse","number":10,"content":["ထို​သူ​သည်​သိုး​သို့​မ​ဟုတ်​ဆိတ်​ကို​ယဇ်​ပူ ဇော်​လို​လျှင် ထို​ယဇ်​ကောင်​သည်​အ​ပြစ်​အ​နာ ကင်း​သည့်​သိုး​ထီး​ဆိတ်​ထီး​ဖြစ်​ရ​မည်။-"]},{"type":"verse","number":11,"content":["သူ​သည်​ယဇ်​ကောင်​ကို​ယဇ်​ပလ္လင်​၏​မြောက်​ဘက် တွင်​သတ်​ရ​မည်။ ယဇ်​ပု​ရော​ဟိတ်​များ​သည်​ယဇ် ကောင်​၏​သွေး​ကို ပလ္လင်​ဘေး​လေး​ဘက်​စ​လုံး ပေါ်​သို့​ပက်​ဖျန်း​ရ​မည်။-"]},{"type":"verse","number":12,"content":["သူ​သည်​ယဇ်​ကောင်​ကို​ခုတ်​ဖြတ်​ပြီး​နောက် တာ​ဝန် ကျ​ယဇ်​ပု​ရော​ဟိတ်​သည်​အ​သား​တစ်၊ ဦး​ခေါင်း နှင့်​အ​ဆီ​ကို​ထင်း​မီး​ပေါ်​တွင်​တင်​ရ​မည်။-"]},{"type":"verse","number":13,"content":["သူ​သည်​ဝမ်း​တွင်း​သား​နှင့်​နောက်​ခြေ​များ​ကို ရေ​ဆေး​ရ​မည်။ ယဇ်​ပု​ရော​ဟိတ်​သည်​တစ်​ကောင် လုံး​ကို​ပလ္လင်​ပေါ်​တွင်​မီး​ရှို့​ပူ​ဇော်​ရ​မည်။ ဤ ပူ​ဇော်​သ​ကာ​၏​ရ​နံ့​ကို​ထာ​ဝ​ရ​ဘု​ရား နှစ်​သက်​တော်​မူ​၏။"]},{"type":"verse","number":14,"content":["တစ်​စုံ​တစ်​ယောက်​သည်​ငှက်​ကို​ယဇ်​ပူ​ဇော် လို​လျှင် ငှက်​သည်​ချိုး​ငှက်​သို့​မ​ဟုတ်​ခို​ဖြစ် ရ​မည်။-"]},{"type":"verse","number":15,"content":["ယဇ်​ပု​ရော​ဟိတ်​သည်​ငှက်​ကို​ပလ္လင်​သို့​ယူ​ဆောင် ခဲ့​၍ လည်​ပင်း​ကို​လိမ်​ချိုး​ပြီး​လျှင် ငှက်​ဦး​ခေါင်း ကို​ပလ္လင်​တွင်​မီး​ရှို့​ရ​မည်။ ငှက်​သွေး​ကို​ပလ္လင် ဘေး​ပေါ်​သို့​ညှစ်​ချ​ရ​မည်။-"]},{"type":"verse","number":16,"content":["ထို့​နောက်​စ​လုတ်​ရှိ​အ​စာ​နှင့်​တ​ကွ​စ​လုတ် ကို​ထုတ်​၍ ပလ္လင်​အ​ရှေ့​ဘက်​ရှိ​ပြာ​ပုံ​ထဲ​သို့ ပစ်​လိုက်​ရ​မည်။-"]},{"type":"verse","number":17,"content":["သူ​သည်​အ​တောင်​ပံ​များ​ကို​ကိုင်​၍​ငှက်​ကိုယ် ကို​ဆွဲ​ဖွင့်​ရ​မည်။ သို့​ရာ​တွင်​အ​တောင်​များ​မ ကျွတ်​ထွက်​စေ​ရ။ ထို့​နောက်​တစ်​ကောင်​လုံး​ကို ပလ္လင်​ပေါ်​တွင်​မီး​ရှို့​ပူ​ဇော်​ရ​မည်။ ဤ​ပူ​ဇော် သ​ကာ​၏​ရ​နံ့​ကို​ထာ​ဝ​ရ​ဘု​ရား​နှစ်​သက် တော်​မူ​၏။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/LEV/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/LEV/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/EXO/40.json","previousChapterAudioLinks":{},"numberOfVerses":16}