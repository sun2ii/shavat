{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"LEV","translationId":"mya_ojv","name":"ဝတ်​ပြု","commonName":"ဝတ်​ပြု","title":"ဝတ်​ပြု​ရာ​ကျမ်း","order":3,"numberOfChapters":27,"sha256":"a14473e40194a5deee71e6359dc6ae9c99dd7c235ee2237df96ddbe2f991e9ff","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/LEV/1.json","lastChapterNumber":27,"lastChapterApiLink":"/api/mya_ojv/LEV/27.json","totalNumberOfVerses":783},"chapter":{"number":12,"content":[{"type":"heading","content":["သား​ဖွား​ပြီး​စ​အ​မျိုး​သ​မီး​သန့်​စင်​ခြင်း​နှင့် ဆိုင်​ရာ​ပ​ညတ်​များ"]},{"type":"verse","number":1,"content":["ထာ​ဝ​ရ​ဘု​ရား​သည်​ဣ​သ​ရေ​လ​အ​မျိုး သား​တို့​လိုက်​နာ​ရန်​အောက်​ပါ​ပ​ညတ်​များ​ကို မော​ရှေ​မှ​တစ်​ဆင့်​ချ​မှတ်​ပေး​တော်​မူ​၏။ အ​မျိုး သ​မီး​တစ်​ဦး​သည်​ဋ္ဌမ္မ​တာ​ရာ​သီ​ပေါ်​ချိန်​၌ မ​သန့်​ရှင်း​သ​ကဲ့​သို့ သား​ယောကျာ်း​ကို​ဖွား​မြင် ပြီး​ခု​နစ်​ရက်​အ​တွင်း​တွင်​ဘာ​သာ​ရေး​ထုံး နည်း​အ​ရ​မ​သန့်​ရှင်း​ချေ။-"]},{"type":"verse","number":3,"content":["အ​ဋ္ဌ​မ​နေ့​၌​အ​ရေ​ဖျား​လှီး​ခြင်း​မင်္ဂ​လာ​ကို သား​အား​ပေး​ရ​မည်။-"]},{"type":"verse","number":4,"content":["မိ​ခင်​သည်​နောက်​ထပ်​သုံး​ဆယ့်​သုံး​ရက်​အ​တွင်း ဘာ​သာ​ရေး​ထုံး​နည်း​အ​ရ​မ​သန့်​ရှင်း​သ​ဖြင့် သွေး​သန့်​သည့်​ကာ​လ​မ​တိုင်​မီ​သန့်​ရှင်း​သော အ​ရာ​တစ်​စုံ​တစ်​ခု​ကို​မ​ထိ​မ​ကိုင်​ရ။ တဲ တော်​အ​တွင်း​သို့​လည်း​မ​ဝင်​ရ။"]},{"type":"verse","number":5,"content":["သ​မီး​ကို​ဖွား​မြင်​သော​အ​မျိုး​သ​မီး​သည် ဋ္ဌမ္မ တာ​ရာ​သီ​ပေါ်​ချိန်​၌​မ​သန့်​ရှင်း​သ​ကဲ့​သို့ မီး ဖွား​ပြီး​တစ်​ဆယ့်​လေး​ရက်​အ​တွင်း​ဘာ​သာ ရေး​ထုံး​နည်း​အ​ရ​မ​သန့်​ရှင်း​ချေ။ မိ​ခင်​သည် သွေး​သန့်​သည့်​ကာ​လ​မ​တိုင်​မီ နောက်​ထပ်​ခြောက် ဆယ့်​ခြောက်​ရက်​အ​တွင်း​ဘာ​သာ​ရေး​ထုံး​နည်း အ​ရ​မ​သန့်​ရှင်း​ချေ။"]},{"type":"verse","number":6,"content":["မိ​ခင်​သည်​သား​ကို​ဖွား​မြင်​သည်​ဖြစ်​စေ၊ သမီး​ကို ဖွား​မြင်​သည်​ဖြစ်​စေ​သွေး​မ​သန့်​သည့်​ကာ​လ​ပြီး ဆုံး​သော​အ​ခါ မီး​ရှို့​ရာ​ယဇ်​ပူ​ဇော်​ရန်​တစ်​နှစ်​သား သိုး​က​လေး​ကို​လည်း​ကောင်း၊ အ​ပြစ်​ဖြေ​ရာ​ယဇ်​ပူ ဇော်​ရန် ချိုး​သို့​မ​ဟုတ်​ခို​တစ်​ကောင်​ကို​လည်း​ကောင်း ထာ​ဝ​ရ​ဘု​ရား​စံ​တော်​မူ​ရာ​တဲ​တော်​တံ​ခါး​ဝ သို့​ယူ​ဆောင်​ခဲ့​၍​ယဇ်​ပု​ရော​ဟိတ်​ထံ​အပ်​ရ​မည်။-"]},{"type":"verse","number":7,"content":["ယဇ်​ပု​ရော​ဟိတ်​သည်​ထို​ယဇ်​များ​ကို ထာ​ဝ​ရ ဘု​ရား​အား​ပူ​ဇော်​လျက် မိ​ခင်​အ​တွက်​သန့်​ရှင်း စေ​ခြင်း​ဝတ်​ကို​ဆောင်​ရွက်​သ​ဖြင့် မိ​ခင်​သည် ဘာ​သာ​ရေး​ထုံး​နည်း​အ​ရ​သန့်​ရှင်း​လာ​လိမ့် မည်။ ဤ​ပ​ညတ်​ကား​သား​ဖွား​ပြီး​အ​မျိုး သ​မီး​တို့​လိုက်​နာ​ရ​မည့်​ပညတ်​ဖြစ်​သ​တည်း။"]},{"type":"verse","number":8,"content":["မိ​ခင်​သည်​သိုး​က​လေး​ကို​မ​ပူ​ဇော်​နိုင်​လျှင် ချိုး နှစ်​ကောင်​သို့​မ​ဟုတ်​ခို​နှစ်​ကောင်​ကို​ယူ​ခဲ့​ရ​မည်။ တစ်​ကောင်​သည်​မီး​ရှို့​ရာ​ယဇ်​အ​တွက်​ဖြစ်​၍ အ ခြား​တစ်​ကောင်​သည်​အ​ပြစ်​ဖြေ​ရာ​ယဇ်​အ​တွက် ဖြစ်​သည်။ ယဇ်​ပု​ရော​ဟိတ်​သည်​မိ​ခင်​အ​တွက် သန့်​ရှင်း​စေ​ခြင်း​ဝတ်​ကို​ဆောင်​ရွက်​သ​ဖြင့် မိ​ခင် သည်​ဘာ​သာ​ရေး​ထုံး​နည်း​အ​ရ​သန့်​ရှင်း​လာ လိမ့်​မည်။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/LEV/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/LEV/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/LEV/11.json","previousChapterAudioLinks":{},"numberOfVerses":7}