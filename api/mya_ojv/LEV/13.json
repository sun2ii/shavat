{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"LEV","translationId":"mya_ojv","name":"ဝတ်​ပြု","commonName":"ဝတ်​ပြု","title":"ဝတ်​ပြု​ရာ​ကျမ်း","order":3,"numberOfChapters":27,"sha256":"a14473e40194a5deee71e6359dc6ae9c99dd7c235ee2237df96ddbe2f991e9ff","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/LEV/1.json","lastChapterNumber":27,"lastChapterApiLink":"/api/mya_ojv/LEV/27.json","totalNumberOfVerses":783},"chapter":{"number":13,"content":[{"type":"heading","content":["ကိုယ်​ရေ​ပြား​ရော​ဂါ​နှင့်​ဆိုင်​သော​ပ​ညတ်​များ"]},{"type":"verse","number":1,"content":["ထာ​ဝ​ရ​ဘု​ရား​သည်​မော​ရှေ​နှင့်​အာ​ရုန်​တို့ အား အောက်​ဖော်​ပြ​ပါ​ပ​ညတ်​များ​ကို​ချ မှတ်​ပေး​တော်​မူ​၏။-"]},{"type":"verse","number":2,"content":["တစ်​စုံ​တစ်​ယောက်​တွင်​အ​ရေ​ပြား​၌​အ​နာ​စိမ်း ဖြစ်​စေ၊ ဖူး​ယောင်​နာ​ဖြစ်​စေ၊ အ​နာ​ကွက်​ဖြစ်​စေ၊ ပေါ်​လာ​သ​ဖြင့် ဆိုး​ရွား​သော​ကိုယ်​ရေ​ပြား​ရော​ဂါ စွဲ​မည့်​လက္ခ​ဏာ​ရှိ​လာ​လျှင် ထို​သူ​ကို​အာ​ရုန်​မှ ဆင်း​သက်​သော​ယဇ်​ပု​ရော​ဟိတ်​ထံ​သို့​ခေါ် ဆောင်​ခဲ့​ရ​မည်။-"]},{"type":"verse","number":3,"content":["ယဇ်​ပု​ရော​ဟိတ်​သည်​အ​နာ​ကို​စစ်​ဆေး​ပြီး လျှင် အ​နာ​ပေါ်​ရှိ​အ​မွေး​များ​ဖြူ​၍​အ​နာ တွင်း​နက်​နေ​လျှင် ထို​သူ​၌​ဆိုး​ဝါး​သော​ကိုယ် ရေ​ပြား​ရော​ဂါ​စွဲ​ကပ်​နေ​ပြီ​ဖြစ်​သော​ကြောင့် မ​သန့်​ရှင်း​သူ​ဟူ​၍​အ​ဆုံး​အ​ဖြတ်​ပေး​ရ မည်။-"]},{"type":"verse","number":4,"content":["သို့​ရာ​တွင်​အ​နာ​ကွက်​ဖြူ​သော်​လည်း အ​မွေး မ​ဖြူ၊ အ​နာ​ကွက်​လည်း​ချိုင့်​နေ​ဟန်​မ​ရှိ​လျှင် ယဇ်​ပု​ရော​ဟိတ်​သည် ထို​သူ​အား​ခု​နစ်​ရက် ပတ်​လုံး​သီး