{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"LEV","translationId":"mya_ojv","name":"ဝတ်​ပြု","commonName":"ဝတ်​ပြု","title":"ဝတ်​ပြု​ရာ​ကျမ်း","order":3,"numberOfChapters":27,"sha256":"a14473e40194a5deee71e6359dc6ae9c99dd7c235ee2237df96ddbe2f991e9ff","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/LEV/1.json","lastChapterNumber":27,"lastChapterApiLink":"/api/mya_ojv/LEV/27.json","totalNumberOfVerses":783},"chapter":{"number":16,"content":[{"type":"heading","content":["အ​ပြစ်​ပြေ​ရာ​ယဇ်​ပူ​ဇော်​သော​နေ့"]},{"type":"verse","number":1,"content":["အာ​ရုန်​၏​သား​နှစ်​ယောက်​တို့​သည် ထာ​ဝ​ရ ဘု​ရား​အား​မ​သန့်​စင်​သော​မီး​ဖြင့်​ပူ​ဇော် သော​ကြောင့် သေ​ဆုံး​ကြ​ပြီး​နောက်​ကိုယ် တော်​သည်​မော​ရှေ​အား၊-"]},{"type":"verse","number":2,"content":["``သင်​၏​အစ်​ကို​အာ​ရုန်​သည် ကန့်​လန့်​ကာ အ​တွင်း​ရှိ​အ​လွန်​သန့်​ရှင်း​ရာ​ဌာ​န​တော် ထဲ​သို့ သတ်​မှတ်​သည့်​အ​ချိန်​၌​သာ​ဝင်​ရ​မည် ဖြစ်​ကြောင်း​ပြော​ကြား​လော့။ အ​ဘယ်​ကြောင့် ဆို​သော် ငါ​သည်​အ​လွန်​သန့်​ရှင်း​ရာ​ဌာ​န တော်​ရှိ ပ​ဋိ​ညာဉ်​သေတ္တာ​အ​ဖုံး​အ​ထက်​မိုး တိမ်​၌​ထင်​ရှား​တော်​မူ​မည်​ဖြစ်​သည်။ သူ သည်​ဤ​ပ​ညတ်​ကို​မ​နာ​ခံ​လျှင်​သေ​ရ လိမ့်​မည်။-"]},{"type":"verse","number":3,"content":["သူ​သည်​အ​ပြစ်​ဖြေ​ရာ​ယဇ်​အ​တွက် နွား ပျို​တစ်​ကောင်​နှင့် မီး​ရှို့​ရာ​ယဇ်​အ​တွက်​သိုး ထီး​တစ်​ကောင်​ကို​ယူ​ဆောင်​လာ​ပြီး​မှ အ​လွန် သန့်​ရှင်း​ရာ​ဌာ​န​တော်​ထဲ​သို့​ဝင်​ရ​မည်'' ဟု မိန့်​တော်​မူ​၏။"]},{"type":"verse","number":4,"content":["ထို​နောက်​ထာ​ဝ​ရ​ဘု​ရား​သည် အောက်​ပါ​ညွှန် ကြား​ချက်​များ​ကို