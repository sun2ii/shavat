{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"LEV","translationId":"mya_ojv","name":"ဝတ်​ပြု","commonName":"ဝတ်​ပြု","title":"ဝတ်​ပြု​ရာ​ကျမ်း","order":3,"numberOfChapters":27,"sha256":"a14473e40194a5deee71e6359dc6ae9c99dd7c235ee2237df96ddbe2f991e9ff","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/LEV/1.json","lastChapterNumber":27,"lastChapterApiLink":"/api/mya_ojv/LEV/27.json","totalNumberOfVerses":783},"chapter":{"number":3,"content":[{"type":"heading","content":["မိတ်​သ​ဟာ​ယ​ယဇ်"]},{"type":"verse","number":1,"content":["တစ်​စုံ​တစ်​ယောက်​သည် မိ​မိ​၏​နွား​တစ်​ကောင် ကို​မိတ်​သ​ဟာ​ယ​ယဇ်​အ​ဖြစ်​ပူ​ဇော်​လို​လျှင် ထို​နွား​သည်​အ​ပြစ်​အ​နာ​ကင်း​သော​နွား​ထီး သို့​မ​ဟုတ်​နွား​မ​ဖြစ်​ရ​မည်။-"]},{"type":"verse","number":2,"content":["ထို​သူ​သည်​ထာ​ဝ​ရ​ဘု​ရား​စံ​တော်​မူ​ရာ​တဲ တော်​တံ​ခါး​ဝ​၌ နွား​၏​ဦး​ခေါင်း​ပေါ်​တွင်​လက် ကို​တင်​၍​နွား​ကို​သတ်​ရ​မည်။ အာ​ရုန်​၏​သား များ​ဖြစ်​ကြ​သော​ယဇ်​ပု​ရော​ဟိတ်​တို့​သည် ယဇ်​ကောင်​၏​သွေး​ကို​ပလ္လင်​၏​ဘေး​လေး​ဘက် စ​လုံး​ပေါ်​သို့​ပက်​ဖျန်း​ရ​မည်။-"]},{"type":"verse","number":3,"content":["ထို့​နောက်​နွား​၏​ဝမ်း​တွင်း​သား​များ​ရှိ​သ​မျှ အ​ဆီ၊ ကျောက်​ကပ်​များ​နှင့်​ကျောက်​ကပ်​အ​ဆီ၊ အ​သည်း​မှ​အ​ကောင်း​ဆုံး​အ​ပိုင်း​တို့​ကို​ထာ ဝ​ရ​ဘု​ရား​အား​ပူ​ဇော်​ရ​မည်။-"]},{"type":"verse","number":5,"content":["ယဇ်​ပု​ရော​ဟိတ်​တို့​သည်​ယင်း​တို့​ကို​မီး​ရှို့​ရာ ယဇ်​နှင့်​အ​တူ​ပလ္လင်​ပေါ်​တွင်​မီး​ရှို့​ပူ​ဇော်​ရ မည်။ ဤ​ပူ​ဇော်​သ​ကာ​၏​ရ​နံ့​ကို​ထာ​ဝ​ရ ဘု​ရား​နှစ်​သက်​တော်​မူ​၏။"]},{"type":"verse","number":6,"content":["သိုး​ကို​ဖြစ်​စေ၊ ဆိတ်​ကို​ဖြစ်​စေ၊ မိတ်​သ​ဟာ​ယ ယဇ်​အ​ဖြစ်​ပူ​ဇော်​လို​လျှင် အ​ပြစ်​အ​နာ​ကင်း သော​အ​ထီး​ကို​ဖြစ်​စေ​အ​မ​ကို​ဖြစ်​စေ​ပူ ဇော်​ရ​မည်။-"]},{"type":"verse","number":7,"content":["သိုး​ကို​ပူ​ဇော်​သူ​သည်၊"]},{"type":"verse","number":8,"content":["တဲ​တော်​ရှေ့​တွင်​သိုး​၏​ဦး​ခေါင်း​ပေါ်​၌​လက် ကို​တင်​၍​သိုး​ကို​သတ်​ရ​မည်။ ယဇ်​ပု​ရော​ဟိတ် တို့​သည် ယဇ်​ကောင်​၏​သွေး​ကို​ယဇ်​ပလ္လင်​လေး ဘက်​စ​လုံး​ပေါ်​သို့​ပက်​ဖျန်း​ရ​မည်။-"]},{"type":"verse","number":9,"content":["ထို့​နောက်​သိုး​အ​ဆီ၊ ဆူ​ဖြိုး​သော​အ​မြီး၊ ဝမ်း တွင်း​သား​များ​မှ​ရှိ​သ​မျှ​အ​ဆီ၊ ကျောက်​ကပ် များ​နှင့်​ကျောက်​ကပ်​အ​ဆီ၊ အ​သည်း​မှ​အ​ကောင်း ဆုံး​အ​ပိုင်း​တို့​ကို​ထာ​ဝ​ရ​ဘု​ရား​အား​ဆက် ကပ်​ရ​မည်။-"]},{"type":"verse","number":11,"content":["တာ​ဝန်​ကျ​ယဇ်​ပု​ရော​ဟိတ်​သည်​ယင်း​တို့ ကို​ယဇ်​ပလ္လင်​ပေါ်​တွင်​မီး​ရှို့​ပူ​ဇော်​ရ​မည်။"]},{"type":"verse","number":12,"content":["ဆိတ်​ကို​ပူ​ဇော်​သူ​သည်။-"]},{"type":"verse","number":13,"content":["တဲ​တော်​ရှေ့​တွင်​ဆိတ်​၏​ဦး​ခေါင်း​ပေါ်​၌ လက် ကို​တင်​၍​ဆိတ်​ကို​သတ်​ရ​မည်။ ယဇ်​ပု​ရော ဟိတ်​တို့​သည် ယဇ်​ကောင်​၏​သွေး​ကို​ယဇ်​ပလ္လင် ဘေး​လေး​ဘက်​စ​လုံး​ပေါ်​သို့​ပက်​ဖျန်း​ရ​မည်။-"]},{"type":"verse","number":14,"content":["ထို့​နောက်​ဝမ်း​တွင်း​သား​များ​မှ​ရှိ​သ​မျှ အ​ဆီ၊ ကျောက်​ကပ်​များ​နှင့်​ကျောက်​ကပ်​အ​ဆီ၊ အ​သည်း​မှ​အ​ကောင်း​ဆုံး​အ​ပိုင်း​တို့​ကို ထာ​ဝ​ရ​ဘု​ရား​အား​ဆက်​ကပ်​ရ​မည်။-"]},{"type":"verse","number":16,"content":["ယဇ်​ပု​ရော​ဟိတ်​သည်​ယင်း​တို့​ကို​ယဇ်​ပလ္လင် ပေါ်​တွင် မီး​ရှို့​ပူ​ဇော်​ရ​မည်။ ဤ​ပူ​ဇော်​သကာ ၏​ရ​နံ့​ကို​ထာ​ဝ​ရ​ဘု​ရား​နှစ်​သက်​တော် မူ​၏။ အ​ဆီ​ရှိ​သ​မျှ​တို့​သည်​ထာ​ဝ​ရ ဘု​ရား​နှင့်​ဆိုင်​၏။-"]},{"type":"verse","number":17,"content":["ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​သည်​အ​ဆီ ကို​သော်​လည်း​ကောင်း၊ သွေး​ကို​သော်​လည်း ကောင်း​မ​စား​ရ။ အ​ရပ်​ရပ်​တွင်​နေ​ထိုင်​သော ဣ​သ​ရေ​လ​အ​မျိုး​သား​အ​ပေါင်း​တို့​သည် ဤ​ပ​ညတ်​ကို​ထာ​ဝ​စဉ်​လိုက်​နာ​ရ​ကြ​မည်။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/LEV/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/LEV/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/LEV/2.json","previousChapterAudioLinks":{},"numberOfVerses":14}