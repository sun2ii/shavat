{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"LEV","translationId":"mya_ojv","name":"ဝတ်​ပြု","commonName":"ဝတ်​ပြု","title":"ဝတ်​ပြု​ရာ​ကျမ်း","order":3,"numberOfChapters":27,"sha256":"a14473e40194a5deee71e6359dc6ae9c99dd7c235ee2237df96ddbe2f991e9ff","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/LEV/1.json","lastChapterNumber":27,"lastChapterApiLink":"/api/mya_ojv/LEV/27.json","totalNumberOfVerses":783},"chapter":{"number":7,"content":[{"type":"heading","content":["အ​ပြစ်​ဒဏ်​ပြေ​ရာ​ပူ​ဇော်​သ​ကာ"]},{"type":"verse","number":1,"content":["အ​ပြစ်​ဒဏ်​ပြေ​ရာ​ပူ​ဇော်​သ​ကာ​နှင့်​ဆိုင် သော​ပြ​ဋ္ဌာန်း​ချက်​များ​မှာ အောက်​ပါ​အ​တိုင်း ဖြစ်​သည်။ ဤ​ပူ​ဇော်​သ​ကာ​သည်​အ​လွန် သန့်​ရှင်း​၏။-"]},{"type":"verse","number":2,"content":["ယဇ်​ပလ္လင်​၏​မြောက်​ဘက်​ရှိ​မီး​ရှို့​ရာ​ယဇ်​ကောင် များ​ကို​သတ်​သည့်​နေ​ရာ​တွင် အ​ပြစ်​ဒဏ်​ပြေ ရာ​ပူ​ဇော်​သ​ကာ​အ​တွက်​ယဇ်​ကောင်​ကို​သတ် ရ​မည်။ သွေး​ကို​ယဇ်​ပလ္လင်​လေး​ဘက်​စ​လုံး ပေါ်​သို့​ပက်​ဖျန်း​ရ​မည်။-"]},{"type":"verse","number":3,"content":["ယဇ်​ပု​ရော​ဟိတ်​သည်​ဆူ​ဖြိုး​သော​အ​မြီး ဝမ်း​တွင်း​သား​မှ​အ​ဆီ၊ ကျောက်​ကပ်​နှင့် ကျောက်​ကပ်​အ​ဆီ၊ အ​သည်း​မှ​အ​ကောင်း ဆုံး​အ​ပိုင်း​စ​သည်​တို့​ကို​ထုတ်​ယူ​၍​ယဇ် ပလ္လင်​ပေါ်​တွင်​ပူ​ဇော်​ရ​မည်။-"]},{"type":"verse","number":5,"content":["ယဇ်​ပု​ရော​ဟိတ်​သည်​အ​ဆီ​ရှိ​သ​မျှ​ကို​ယဇ် ပလ္လင်​ပေါ်​တွင်​မီး​ရှို့​ပူ​ဇော်​ရ​မည်။ ဤ​ကား အ​ပြစ်​ဒဏ်​ပြေ​ရာ​ထာ​ဝ​ရ​ဘု​ရား​အား ပူ​ဇော်​သ​ကာ​ဖြစ်​သ​တည်း။-"]},{"type":"verse","number":6,"content":["ယဇ်​ပု​ရော​ဟိတ်​ယော