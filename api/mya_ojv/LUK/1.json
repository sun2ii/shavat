xt":"ကြောက်​ရွံ့​ခြင်း​ကင်း​လျက်​ဆောင်​ရွက်​စေ​မည်​ဟု ငါ​တို့​၏ အ​ဖ​အာ​ဗြ​ဟံ​အား​ကျိန်​ဆို​တော်​မူ​ခဲ့​ပြီ။","poem":1}]},{"type":"line_break"},{"type":"verse","number":76,"content":[{"text":"အ​ချင်း​သူ​ငယ်၊သင်​သည်​အ​မြင့်​မြတ်​ဆုံး​သော​ဘု​ရား​၏ ပ​ရော​ဖက်​ဟု​အ​ခေါ်​ခံ​ရ​လိမ့်​မည်။","poem":1},{"text":"သင်​သည်​ဘု​ရား​ရှင်​အ​တွက်​လမ်း​ကို​အ​သင့် ပြင်​ဆင်​ရ​လိမ့်​မည့်​ရှေ့​တော်​ပြေး​ဖြစ်​ပြီး​လျှင်၊","poem":2}]},{"type":"verse","number":77,"content":[{"text":"ကိုယ်​တော်​၏​လူ​စု​တော်​အား​အ​ပြစ်​ဖြေ​လွှတ်​၍","poem":1},{"text":"ကယ်​တင်​တော်​မူ​မည်​ဖြစ်​ကြောင်း​ပြော​ကြား​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":78,"content":[{"text":"ငါ​တို့​၏​ဘု​ရား​သ​ခင်​သည်​သ​နား​ခြင်း​က​ရု​ဏာ​နှင့် ကြွယ်​ဝ​တော်​မူ​၏။","poem":1},{"text":"ကိုယ်​တော်​သည်​ကယ်​တင်​ခြင်း​ကျေး​ဇူး​တော်​ကို","poem":2},{"text":"ကောင်း​ကင်​မှ​နေ​အ​ရုဏ်​သ​ဖွယ်​ငါ​တို့​အ​ပေါ်​သို့ သက်​ရောက်​စေ​၍၊","poem":1}]},{"type":"verse","number":79,"content":[{"lineBreak":true},{"text":"သေ​မင်း​၏​အ​ရိပ်​တွင်​နေ​ထိုင်​သူ​များ​အ​ပေါ် ထွန်း​လင်း​စေ​လိမ့်​မည်။","poem":1},{"text":"ထို့​အ​ပြင်​ငါ​တို့​အား​ငြိမ်း​ချမ်း​ရေး​လမ်း​သို့ ပို့​ဆောင်​စေ​လိမ့်​မည်'' ဟူ​၍​တည်း။","poem":2}]},{"type":"verse","number":80,"content":["သူ​ငယ်​သည်​ကြီး​ပြင်း​လျက်​အ​သိ​ဉာဏ်​ရင့်​သန် လာ​၏။ သူ​သည်​ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​၏ ရှေ့​တွင် ထင်​ထင်​ပေါ်​ပေါ်​အ​မှု​တော်​ကို​စ​၍ မ​ဆောင်​မီ​တော​ကန္တာ​ရ​တွင်​နေ​၏။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/LUK/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/LUK/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/MRK/16.json","previousChapterAudioLinks":{},"numberOfVerses":78}