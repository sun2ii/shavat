{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"LUK","translationId":"mya_ojv","name":"လုကာ","commonName":"လုကာ","title":"ရှင်​လု​ကာ ပြု​စု​သည့်​သ​တင်း​ကောင်း","order":42,"numberOfChapters":24,"sha256":"a14291cb023b3b57446c8ccb416a3709561a9079a351de03695042725550edfb","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/mya_ojv/LUK/24.json","totalNumberOfVerses":1137},"chapter":{"number":13,"content":[{"type":"heading","content":["နောင်​တ​မ​ရ​လျှင်​သေ​ကြေ​ပျက်​စီး​ရ​လိမ့်​မည်"]},{"type":"verse","number":1,"content":["ထို​အ​ချိန်​၌​လူ​အ​ချို့​တို့​သည်​ကိုယ်​တော် ၏​ထံ​သို့​လာ​၍ ပိ​လတ်​မင်း​သတ်​ဖြတ်​လိုက် သည့်​ဂါ​လိ​လဲ​အ​မျိုး​သား​များ​အ​ကြောင်း ကို​လျှောက်​ထား​ကြ​၏။ ထို​သူ​တို့​သည်​ယဇ် ပူ​ဇော်​လျက်​ရှိ​နေ​စဉ်​သတ်​ဖြတ်​ခြင်း​ကို ခံ​ခဲ့​ရ​ကြ​၏။-"]},{"type":"verse","number":2,"content":["ကိုယ်​တော်​က ``ထို​လူ​စု​သည်​ယင်း​သို့​အ​သတ် ခံ​ရ​သ​ဖြင့်​အ​ခြား​ဂါ​လိ​လဲ​အ​မျိုး​သား အ​ပေါင်း​တို့​ထက်​ပို​၍ အ​ပြစ်​ကူး​သူ​များ ဖြစ်​သည်​ဟု​သင်​တို့​ထင်​မှတ်​ကြ​သ​လော။ သူ တို့​ကား​ပို​၍​အ​ပြစ်​ကူး​သူ​များ​မ​ဟုတ် ဟု​သင်​တို့​အား​ငါ​ဆို​၏။-"]},{"type":"verse","number":3,"content":["သို့​ရာ​တွင်​သင်​တို့​သည်​လည်း​နောင်​တ​မ​ရ ကြ​လျှင် ထို​သူ​တို့​နည်း​တူ​သေ​ကျေ​ပျက်​စီး ရ​လိမ့်​မည်။-"]},{"type":"verse","number":4,"content":["ရှိ​လောင်​မျှော်​စင်​ပြို​ကျ​သ​ဖြင့် ပိ​၍​သေ​သူ လူ​တစ်​ဆယ့်​ရှစ်​ယောက်​တို့​သည် အ​ခြား​ယေ​ရု ရှ​လင်​မြို့​သူ​မြို့​သား​များ​ထက်​ပို​၍​အ​ပြစ် ကူး​သူ​များ