mber":43,"content":["ပွဲ​တော်​ပြီး​ဆုံး​ချိန်​၌​အိမ်​သို့​ပြန်​ကြ​၏။ ထို အ​ခါ​သူ​ငယ်​တော်​သည်​ယေ​ရု​ရှ​လင်​မြို့​မှာ နေ​ရစ်​၏။ ထို​သို့​နေ​ရစ်​သည်​ကို​မိ​ဘ​များ မ​သိ​ကြ။-"]},{"type":"verse","number":44,"content":["ခ​ရီး​သည်​လူ​စု​ထဲ​တွင်​ပါ​လာ​လိမ့်​မည်​ဟု ထင်​မှတ်​ကြ​၏။ တစ်​နေ့​ခ​ရီး​ပြု​ကြ​ပြီး​မှ ဆွေ​မျိုး​အ​သိ​အ​ကျွမ်း​များ​ထဲ​တွင်​သူ​ငယ် တော်​ကို​ရှာ​ကြ​၏။-"]},{"type":"verse","number":45,"content":["မ​တွေ့​သ​ဖြင့်​ယော​သပ်​နှင့်​မာ​ရိ​သည်​ယေ​ရု​ရှ​လင် မြို့​သို့​ပြန်​၍​ရှာ​ကြ​၏။ တ​တိ​ယ​နေ့​တွင်​သူ​ငယ် တော်​ကို​ဗိ​မာန်​တော်​အ​တွင်း​မှာ​တွေ့​ကြ​၏။-"]},{"type":"verse","number":46,"content":["သူ​သည်​ယု​ဒ​ဆ​ရာ​တော်​များ​နှင့်​အ​တူ​ထိုင် ကာ​သူ​တို့​၏​တ​ရား​စ​ကား​များ​ကို​ကြား​နာ လျက်၊ သူ​တို့​နှင့်​ဆွေး​နွေး​မေး​မြန်း​လျက်​နေ​၏။-"]},{"type":"verse","number":47,"content":["သူ​ငယ်​တော်​၏​စ​ကား​ကို​ကြား​ကြ​သော​သူ အ​ပေါင်း​တို့​သည်​သူ​၏​အ​သိ​ပ​ညာ​နှင့်​ဖြေ ကြား​ချက်​များ​ကို​အံ့​သြ​ကြ​၏။-"]},{"type":"verse","number":48,"content":["ယော​သပ်​နှင့်​မာ​ရိ​တို့​သည်​တွေ့​လျှင်​အံ့​အား​သင့် ကြ​၏။ ထို​နောက်​မယ်​တော်​က ``ငါ့​သား၊ သင်​သည် အ​ဘယ်​ကြောင့်​ငါ​တို့​ကို​ဤ​သို့​ပြု​ပါ​သ​နည်း။ သင့်​ဖ​ခင်​နှင့်​ငါ​သည်​စိုး​ရိမ်​ကြီး​စွာ​ဖြင့်​ရှာ​ခဲ့ ရ​၏'' ဟု​ပြော​၏။"]},{"type":"verse","number":49,"content":["သူ​ငယ်​တော်​က ``အ​ဘယ်​ကြောင့်​အ​ကျွန်ုပ်​ကို​ရှာ ကြ​ပါ​သ​နည်း။ အ​ကျွန်ုပ်​သည်​ခ​မည်း​တော်​၏​အိမ် တွင်​ရှိ​နေ​ရ​မည်​ကို​မ​သိ​ကြ​ပါ​သ​လော'' ဟု ပြန်​ပြော​၏။-"]},{"type":"verse","number":50,"content":["သူ​တို့​သည်​ထို​စ​ကား​ကို​နား​မ​လည်​ကြ။"]},{"type":"verse","number":51,"content":["ထို​နောက်​သူ​ငယ်​တော်​သည်​မိ​ဘ​တို့​နှင့်​အ​တူ လိုက်​၍ နာ​ဇ​ရက်​မြို့​သို့​ရောက်​သော်​မိ​ဘ​တို့​၏ စ​ကား​ကို​နာ​ခံ​လျက်​နေ​၏။ မယ်​တော်​သည်​ဤ အ​ဖြစ်​အ​ပျက်​အ​လုံး​စုံ​တို့​ကို​စိတ်​နှ​လုံး​ထဲ မှာ​မှတ်​ကျုံး​ထား​၏။-"]},{"type":"verse","number":52,"content":["သူ​ငယ်​တော်​ယေ​ရှု​သည်​ကာ​ယ​ညာ​ဏ​ကြီး ပွား​တိုး​တက်​လျက်​ဘု​ရား​သ​ခင့်​ရှေ့၊ လူ​တို့ ရှေ့​တွင်​မျက်​နှာ​ပွင့်​လန်း​တော်​မူ​၏။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/LUK/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/LUK/3.js