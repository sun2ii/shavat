{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"LUK","translationId":"mya_ojv","name":"လုကာ","commonName":"လုကာ","title":"ရှင်​လု​ကာ ပြု​စု​သည့်​သ​တင်း​ကောင်း","order":42,"numberOfChapters":24,"sha256":"a14291cb023b3b57446c8ccb416a3709561a9079a351de03695042725550edfb","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/mya_ojv/LUK/24.json","totalNumberOfVerses":1137},"chapter":{"number":22,"content":[{"type":"heading","content":["သ​ခင်​ယေ​ရှု​ကို​သတ်​ရန်​ကြံ​စည်​မှု"]},{"type":"verse","number":1,"content":["ပ​သ​ခါ​ပွဲ​ဟု​နာ​မည်​တွင်​သော​တ​ဆေး​မဲ့ မုန့်​ပွဲ​တော်​အ​ခါ​ကျ​ရန်​နီး​ကပ်​လာ​၏။-"]},{"type":"verse","number":2,"content":["ယဇ်​ပု​ရော​ဟိတ်​ကြီး​များ​နှင့်​ကျမ်း​တတ်​ဆ​ရာ များ​သည်​လူ​တို့​ကို​ကြောက်​သော​ကြောင့် ကိုယ်​တော် ကို​လျှို့​ဝှက်​စွာ​သတ်​ရန်​နည်း​လမ်း​ရှာ​လျက်​နေ ကြ​၏။"]},{"type":"heading","content":["သ​ခင်​ယေ​ရှု​ကို​အပ်​နှံ​ရန် ယု​ဒ​သ​ဘော​တူ​ခြင်း"]},{"type":"verse","number":3,"content":["ထို​အ​ခါ​စာ​တန်​သည် တစ်​ကျိပ်​နှစ်​ပါး​အ​ပါ အ​ဝင်​ဖြစ်​သူ​ရှ​ကာ​ရုတ်​ဟု​နာ​မည်​တွင်​သော ယု​ဒ​၏​စိတ်​နှ​လုံး​ထဲ​သို့​ဝင်​လေ​၏။-"]},{"type":"verse","number":4,"content":["ထို့​ကြောင့်​သူ​သည်​ယဇ်​ပု​ရော​ဟိတ်​ကြီး​များ နှင့်​ဗိ​မာန်​တော်​အ​စောင့်​တပ်​မှူး​များ​ထံ​သို့ သွား​၍ ကိုယ်​တော်​အား​အ​ဘယ်​နည်း​ဖြင့်​သူ​တို့ လက်​သို့​အပ်​ရ​မည်​ကို​ဆွေး​နွေး​တိုင်​ပင်​၏။-"]},{"type":"verse","number":5,"content":["သူ​တို့​သည်​ဝမ်း​မြောက်​သ​ဖြင့်​ယု​ဒ​အား ငွေ​ပေး​ရန်​က​