{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"LUK","translationId":"mya_ojv","name":"လုကာ","commonName":"လုကာ","title":"ရှင်​လု​ကာ ပြု​စု​သည့်​သ​တင်း​ကောင်း","order":42,"numberOfChapters":24,"sha256":"a14291cb023b3b57446c8ccb416a3709561a9079a351de03695042725550edfb","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/mya_ojv/LUK/24.json","totalNumberOfVerses":1137},"chapter":{"number":5,"content":[{"type":"heading","content":["တ​ပည့်​တော်​ဦး​များ​ကို​ခေါ်​ယူ​တော်​မူ​ခြင်း"]},{"type":"verse","number":1,"content":["တစ်​နေ့​သ​၌​ကိုယ်​တော်​သည်​ဂင်​နေ​သ​ရက် အိုင်​ကမ်း​ခြေ​တွင်​ရပ်​လျက်​နေ​တော်​မူ​စဉ် လူ တို့​သည်​ဘု​ရား​သ​ခင်​၏​နှုတ်​က​ပတ်​တော်​ကို ကြား​နာ​ရန်​ကိုယ်​တော်​၏​အ​နီး​သို့​တိုး​ကြိတ် လာ​ကြ​၏။-"]},{"type":"verse","number":2,"content":["ထို​အ​ခါ​ကိုယ်​တော်​သည်​ကမ်း​နား​မှာ​ဆိုက်​ထား သော​လှေ​နှစ်​စင်း​ကို​မြင်​တော်​မူ​၏။ တံ​ငါ​သည် တို့​သည်​ထို​လှေ​များ​ပေါ်​မှ​ဆင်း​ပြီး​နောက် မိ​မိ တို့​၏​ပိုက်​ကွန်​များ​ကို​ဆေး​ကြော​လျက်​နေ ကြ​၏။-"]},{"type":"verse","number":3,"content":["ကိုယ်​တော်​သည်​ထို​လှေ​နှစ်​စင်း​အ​နက်​ရှိ​မုန်​၏ လှေ​သို့​တက်​တော်​မူ​ပြီး​လျှင်​လှေ​ကို​ကမ်း​မှ အ​နည်း​ငယ်​ခွာ​စေ​ရန်​ရှိ​မုန်​အား​စေ​ခိုင်း​တော် မူ​၏။ ထို​နောက်​ထိုင်​၍​လူ​ပ​ရိ​သတ်​တို့​အား ဟော​ပြော​သွန်​သင်​တော်​မူ​၏။"]},{"type":"verse","number":4,"content":["ထို​သို့​ဟော​ပြော​သွန်​သင်​ပြီး​သော​အ​ခါ ``ရေ နက်​ရာ​သို့​ခွာ​ထွက်​လော့။ ငါး​များ​ဖမ်း​မိ​စေ ရန်​သင်​နှင့်​သင်​တို့