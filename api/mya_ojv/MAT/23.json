{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"MAT","translationId":"mya_ojv","name":"မဿဲ","commonName":"မဿဲ","title":"ရှင်​မ​ဿဲ ပြု​စု​သည့်​သ​တင်း​ကောင်း","order":40,"numberOfChapters":28,"sha256":"ea97bb7036e2f6b53a60f88607385cca62158c0543399906a39e19c74c3c163f","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/mya_ojv/MAT/28.json","totalNumberOfVerses":1061},"chapter":{"number":23,"content":[{"type":"heading","content":["ကျမ်း​တတ်​ဆ​ရာ​နှင့်​ဖာ​ရိ​ရှဲ​တို့​ကို သ​တိ​ပြု​ရန်​နှိုး​ဆော်​တော်​မူ​ခြင်း"]},{"type":"verse","number":1,"content":["ထို​နောက်​သ​ခင်​ယေ​ရှု​သည်​လူ​ပ​ရိ​သတ်​နှင့် တ​ပည့်​တော်​တို့​အား၊"]},{"type":"verse","number":2,"content":["``ကျမ်း​တတ်​ဆ​ရာ​နှင့်​ဖာ​ရိ​ရှဲ​များ​သည်​မော​ရှေ ၏​ပ​ညတ်​ကျမ်း​ကို​အ​ဋ္ဌိပ္ပါယ်​ဖွင့်​ပြ​ရန်​အ​ခွင့် အာ​ဏာ​ရ​ရှိ​ထား​သူ​များ​ဖြစ်​ကြ​၏။-"]},{"type":"verse","number":3,"content":["သို့​ဖြစ်​၍​ထို​သူ​တို့​ပြော​ဆို​သွန်​သင်​သ​မျှ အ​တိုင်း​လိုက်​နာ​ပြု​ကျင့်​ကြ​လော့။ သို့​သော် သူ​တို့​သည်​မိ​မိ​တို့​ဟော​သည့်​အ​တိုင်း​မ​ကျင့် ကြ​သ​ဖြင့်​သူ​တို့​ကျင့်​သ​ကဲ့​သို့​မ​ကျင့်​ကြ​နှင့်။-"]},{"type":"verse","number":4,"content":["သူ​တို့​သည်​လေး​လံ​၍​အ​ထမ်း​ရ​ခက်​သည့်​ဝန်​ထုပ် များ​ကို​သူ​တစ်​ပါး​တို့​အား​ထမ်း​စေ​ကြ​၏။ မိ​မိ တို့​ကိုယ်​တိုင်​မူ​ထို​ဝန်​ထုပ်​များ​ကို​လက်​ဖျား​နှင့် မျှ​မ​တို့​လို​ကြ။-"]},{"type":"verse","number":5,"content":["မိ​မိ​တို့​ပြု​လုပ်​သ​မျှ​သော​အ​ရာ​တို့​ကို​လူ​မြင် သာ​အောင်​ပြု​လုပ်​တတ်​