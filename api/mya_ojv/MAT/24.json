{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"MAT","translationId":"mya_ojv","name":"မဿဲ","commonName":"မဿဲ","title":"ရှင်​မ​ဿဲ ပြု​စု​သည့်​သ​တင်း​ကောင်း","order":40,"numberOfChapters":28,"sha256":"ea97bb7036e2f6b53a60f88607385cca62158c0543399906a39e19c74c3c163f","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/mya_ojv/MAT/28.json","totalNumberOfVerses":1061},"chapter":{"number":24,"content":[{"type":"heading","content":["ဗိ​မာန်​တော်​ပြို​ပျက်​မည်​ဖြစ်​ကြောင်း​မိန့်​တော်​မူ​ခြင်း"]},{"type":"verse","number":1,"content":["သ​ခင်​ယေ​ရှု​သည်​ဗိ​မာန်​တော်​မှ​ထွက်​ခွာ​သွား တော်​မူ​စဉ်​တ​ပည့်​တော်​တို့​သည်​အ​ထံ​တော်​သို့ ချဉ်း​ကပ်​၍ ဗိ​မာန်​တော်​အ​ဆောက်​အ​အုံ​များ ကို​ကိုယ်​တော်​အား​ပြ​ကြ​၏။-"]},{"type":"verse","number":2,"content":["ကိုယ်​တော်​က ``ဤ​အ​ဆောက်​အ​အုံ​အ​ပေါင်း​ကို သင်​တို့​မြင်​ကြ​သည်​မ​ဟုတ်​လော။ အ​မှန်​အ​ကန် သင်​တို့​အား​ငါ​ဆို​သည်​ကား ဤ​အ​ဆောက်​အ​အုံ တို့​သည်​ကျောက်​တစ်​တုံး​ပေါ်​တစ်​တုံး​တင်​၍ မ​ကျန်​ရစ်​သည်​တိုင်​အောင်​ပြို​ပျက်​ကြ​လိမ့်​မည်'' ဟု​မိန့်​တော်​မူ​၏။"]},{"type":"heading","content":["ဆင်း​ရဲ​ဒုက္ခ​များ​နှင့်​ညှဉ်း​ပန်း​နှိပ်​စက်​ခြင်း​များ"]},{"type":"verse","number":3,"content":["ကိုယ်​တော်​သည်​သံ​လွင်​တောင်​ပေါ်​တွင်​တစ်​ကိုယ်​တည်း ထိုင်​နေ​တော်​မူ​စဉ်​တ​ပည့်​တော်​တို့​သည်​အ​ထံ​တော် သို့​ချဉ်း​ကပ်​၍ ``အ​ရှင်​မိန့်​တော်​မူ​သော​အ​မှု​အ​ရာ များ​သည်​အ​ဘယ်​အ​ခါ​ကာ​လ​၌​ဖြစ်​ပျက်​ပါ​မည် နည်း။ အ​ရှင်​ကြွ​လာ​တော်​မူ​ချိန်​နှင့်​