{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"MRK","translationId":"mya_ojv","name":"ရှင်မာကု","commonName":"ရှင်မာကု","title":"ရှင်မာကု ပြုစုသည့်သတင်းကောင်း","order":41,"numberOfChapters":16,"sha256":"f5d7e7b58b3ee7df9f2f412c32f4907f4c1654a05787e86288bdeddd0d8ff5d1","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/mya_ojv/MRK/16.json","totalNumberOfVerses":666},"chapter":{"number":10,"content":[{"type":"heading","content":["လင်​မ​ယား​ကွာ​ရှင်း​မှု​ပြ​ဿ​နာ"]},{"type":"verse","number":1,"content":["ထို​နောက်​ကိုယ်​တော်​သည်​ထို​အ​ရပ်​မှ​ထွက်​ခွာ​တော် မူ​၍ ယု​ဒ​ပြည်​သို့​ကြွ​တော်​မူ​ပြီး​လျှင်​ယော်​ဒန် မြစ်​ကို​ကူး​တော်​မူ​၏။ လူ​ပ​ရိ​သတ်​တို့​သည်​အ​ထံ တော်​သို့​တစ်​ဖန်​လာ​ရောက်​စု​ရုံး​ကြ​ပြန်​၏။ ကိုယ်​တော် သည်​အ​လေ့​တော်​ရှိ​သည့်​အ​တိုင်း​သူ​တို့​အား​ဟော ပြော​သွန်​သင်​တော်​မူ​၏။"]},{"type":"verse","number":2,"content":["ထို​အ​ခါ​ဖာ​ရိ​ရှဲ​တို့​သည်​အ​ထံ​တော်​သို့​လာ ၍ ``လူ​တစ်​စုံ​တစ်​ယောက်​သည်​မိ​မိ​၏​မ​ယား​နှင့် ကွာ​ရှင်း​အပ်​ပါ​သ​လော'' ဟု​ပ​ရိ​ယာယ်​ဆင်​၍ မေး​လျှောက်​ကြ​၏။"]},{"type":"verse","number":3,"content":["ကိုယ်​တော်​က ``မော​ရှေ​သည်​သင်​တို့​အား​မည်​သို့ ပ​ညတ်​သ​နည်း'' ဟု​ပြန်​၍​မေး​တော်​မူ​၏။"]},{"type":"verse","number":4,"content":["သူ​တို့​က ``မ​ယား​ကို​ဖြတ်​စာ​နှင့်​ကွာ​ရှင်း​ရန် မော​ရှေ​ခွင့်​ပြု​ပါ​သည်'' ဟု​ဖြေ​ကြား​ကြ​၏။"]},{"type":"verse","number":5,"content":["သ​ခင်​ယေ​ရှု​က ``သင်​တို့​သည်​အ​ပြော​ရ​ခက်​သူ များ​ဖြစ်​၍ မော​ရှေ​သည်