{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"MRK","translationId":"mya_ojv","name":"ရှင်မာကု","commonName":"ရှင်မာကု","title":"ရှင်မာကု ပြုစုသည့်သတင်းကောင်း","order":41,"numberOfChapters":16,"sha256":"f5d7e7b58b3ee7df9f2f412c32f4907f4c1654a05787e86288bdeddd0d8ff5d1","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/MRK/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/mya_ojv/MRK/16.json","totalNumberOfVerses":666},"chapter":{"number":5,"content":[{"type":"heading","content":["လူ​တစ်​ယောက်​ထံ​မှ​ညစ်​ညမ်း​သော​နတ်​များ​ကို နှင်​ထုတ်​တော်​မူ​ခြင်း"]},{"type":"verse","number":1,"content":["ကိုယ်​တော်​နှင့်​တ​ပည့်​တော်​တို့​သည် ဂါ​လိ​လဲ​အိုင် တစ်​ဖက်​ကမ်း​တွင်​ရှိ​သော​ဂါ​ရ​စ​ဒေ​သ​သို့ ရောက်​ကြ​၏။-"]},{"type":"verse","number":2,"content":["ကိုယ်​တော်​လှေ​ထဲ​က​ထွက်​ကြွ​တော်​မူ​သည့်​ခ​ဏ ၌​နတ်​ပူး​ဝင်​နေ​သူ​လူ​တစ်​ယောက်​သည် သင်္ချိုင်း တ​စ​ပြင်​မှ​ထွက်​လာ​ပြီး​လျှင်​ကိုယ်​တော်​နှင့် တွေ့​ဆုံ​၏။-"]},{"type":"verse","number":3,"content":["သူ​သည်​သင်္ချိုင်း​ဂူ​များ​အ​ကြား​တွင်​နေ​၏။ သူ့ အား​မည်​သူ​မျှ​သံ​ကြိုး​နှင့်​ချည်​နှောင်​၍​မ​ထား နိုင်။-"]},{"type":"verse","number":4,"content":["သူ့​အား​ကြိမ်​ဖန်​များ​စွာ​သံ​ကြိုး​များ​ဖြင့်​ချည် နှောင်​ခဲ့​ဖူး​ကြ​၏။ သံ​ကြိုး​နှင့်​လက်​ထိတ်​ခြေ​ထိတ် များ​ခတ်​ခဲ့​ဖူး​ကြ​၏။ သံ​ကြိုး​နှင့်​လက်​ထိတ်​ခြေ ထိတ်​များ​သာ​ပြတ်​သွား​ခဲ့​၏။ မည်​သူ​မျှ​သူ့​အား နှိမ်​နင်း​၍​မ​ရ။-"]},{"type":"verse","number":5,"content":["သူ​သည်​သင်္ချိုင်း​ဂူ​များ​အ​ကြား​တွင်​လည်း​ကောင်း၊ တောင်​ကုန်