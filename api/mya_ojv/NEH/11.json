{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"NEH","translationId":"mya_ojv","name":"နေ​ဟ​မိ","commonName":"နေ​ဟ​မိ","title":"နေ​ဟ​မိ​မှတ်​စာ","order":16,"numberOfChapters":13,"sha256":"f5a8847a508d85df21e9193998d0a95ab0ff56eb32a4b7202aa122c2bf179916","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/NEH/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/mya_ojv/NEH/13.json","totalNumberOfVerses":310},"chapter":{"number":11,"content":[{"type":"heading","content":["ယေ​ရု​ရှ​လင်​မြို့​တွင်​နေ​ထိုင်​သူ​များ"]},{"type":"verse","number":1,"content":["ခေါင်း​ဆောင်​များ​သည်​ယေ​ရု​ရှ​လင်​မြို့​တွင် နေ​ထိုင်​ကြ​၏။ အ​ခြား​သူ​တို့​မူ​ကား​ဆယ် အိမ်​ထောင်​လျှင် တစ်​အိမ်​ထောင်​ကျ​သန့်​ရှင်း သော​ယေ​ရု​ရှ​လင်​မြို့​တော်​တွင်​လည်း​ကောင်း၊ ကျန်​သော​သူ​တို့​ကို​အ​ခြား​မြို့​ရွာ​များ တွင်​လည်း​ကောင်း​နေ​ထိုင်​စေ​ရန်​မဲ​ချ​၍ ဆုံး​ဖြတ်​ကြ​၏။-"]},{"type":"verse","number":2,"content":["ယေ​ရု​ရှ​လင်​မြို့​တွင်​မိ​မိ​တို့​အ​လို​အ​လျောက် နေ​ထိုင်​သူ​တို့​အား​ပြည်​သူ​တို့​က​ချီး​ကူး ကြ​၏။-"]},{"type":"verse","number":3,"content":["အ​ခြား​မြို့​ရွာ​များ​တွင်​ဣ​သ​ရေ​လ​အ​မျိုး သား​များ၊ ယဇ်​ပု​ရော​ဟိတ်​များ၊ လေ​ဝိ​အ​နွယ် ဝင်​များ၊ ဗိ​မာန်​တော်​အ​လုပ်​သ​မား​များ၊ ရှော လ​မုန်​၏​အ​စေ​ခံ​များ​မှ​ဆင်း​သက်​လာ သူ​များ​သည်​ကိုယ်​ပိုင်​အိမ်​များ​တွင်​နေ​ထိုင် ကြ​လေ​သည်။ ယေ​ရု​ရှ​လင်​မြို့​တွင်​နေ​ထိုင်​သော​ယု​ဒ​ပြည် နယ်​အ​ကြီး​အ​ကဲ​များ​ကို​ဖော်​ပြ​အံ့။"]},{"type":"verse","number":4,"content":["ယု​ဒ​အ​နွယ်​ဝင်​များ​မှာ​အောက်​ပါ​အ​တိုင်း ဖြ