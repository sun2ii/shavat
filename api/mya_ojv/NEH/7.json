{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"NEH","translationId":"mya_ojv","name":"နေ​ဟ​မိ","commonName":"နေ​ဟ​မိ","title":"နေ​ဟ​မိ​မှတ်​စာ","order":16,"numberOfChapters":13,"sha256":"f5a8847a508d85df21e9193998d0a95ab0ff56eb32a4b7202aa122c2bf179916","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/NEH/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/mya_ojv/NEH/13.json","totalNumberOfVerses":310},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":["ယ​ခု​အ​ခါ​၌​မြို့​ရိုး​ကို​ပြန်​လည်​တည်​ဆောက်​ပြီး​၍ တံ​ခါး​များ​ကို​နေ​ရာ​တ​ကျ​တပ်​ဆင်​ကာ​ဗိ​မာန်​တော်​အ​စောင့်​တပ်​သား​များ၊ ဋ္ဌမ္မ​သီ​ချင်း​သည်​များ​နှင့်​လေ​ဝိ​အ​နွယ်​ဝင်​များ​အား​အ​လုပ်​တာ​ဝန်​များ​ကို​ခွဲ​ဝေ​သတ်​မှတ်​ပေး​ပြီး​လေ​ပြီ။-"]},{"type":"verse","number":2,"content":["ထို​နောက်​ငါ​သည်​ယေ​ရု​ရှ​လင်​မြို့​ကို​အုပ်​ချုပ်​ရန် ငါ့​ညီ​ဟာ​နန်​နှင့်​ရဲ​တိုက်​မှူး​ဟာ​န​နိ​တို့​ကို​တာ​ဝန်​ပေး​အပ်​၏။ ဟာ​န​နိ​သည်​စိတ်​ချ​ယုံ​ကြည်​ရ​သူ၊ ဘု​ရား​သ​ခင်​ကို​အ​ထူး​ကြောက်​ရွံ့​ရို​သေ​သူ​ဖြစ်​၏။-"]},{"type":"verse","number":3,"content":["ငါ​သည်​သူ​တို့​အား``နံ​နက်​ချိန်​၌​နေ​မ​မြင့်​မ​ချင်း​ယေ​ရု​ရှ​လင်​မြို့​တံ​ခါး​များ​ကို​မ​ဖွင့်​စေ​နှင့်။ နေ​ဝင်​ချိန်​၌​တံ​ခါး​စောင့်​များ​တာ​ဝန်​ပြီး​ဆုံး​ချိန်​မ​တိုင်​မီ တံ​ခါး​များ​ကို​ပိတ်​၍​ကန့်​လန့်​ကျင်​များ​ကို​ထိုး​ထား​စေ'' ဟု​မှာ​ကြား​ထား​၏။ ယေ​ရု​ရှ​လင်​မြို့​တွင်​နေ​ထိုင်​သူ​များ​ထဲ​မှ​ကင်း​စောင့်​သူ​များ​ခန့်​ထား​ပြီး​လျှင် ထို​သူ​အ​ချို့​ကို​နေ​ရာ​အ​တိ​အ​ကျ​တွင်​ကင်း​စောင့်​စေ​၍​အ​ချို့​