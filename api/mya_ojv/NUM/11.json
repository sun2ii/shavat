{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"NUM","translationId":"mya_ojv","name":"တော​လည်","commonName":"တော​လည်","title":"တော​လည်​ရာ​ကျမ်း","order":4,"numberOfChapters":36,"sha256":"84e8da7f0b0a4f96c5d7481962476414c60010bb2d647dcef5e721ca26ed879f","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/mya_ojv/NUM/36.json","totalNumberOfVerses":1016},"chapter":{"number":11,"content":[{"type":"heading","content":["တ​ဗေ​ရ​နာ​မည်​တွင်​သည့်​အ​ရပ်"]},{"type":"verse","number":1,"content":["လူ​အ​ပေါင်း​တို့​သည်​မိ​မိ​တို့​တွေ့​ကြုံ​ရ​သော ဆင်း​ရဲ​ဒုက္ခ​များ​ကြောင့် ထာ​ဝ​ရ​ဘု​ရား​ထံ တော်​သို့​ညည်း​ညူ​သံ​ကို​ကြား​ရ​သော​အ​ခါ အ​မျက်​တော်​ထွက်​၍​သူ​တို့​အ​ပေါ်​တွင်​လောင် မီး​ကျ​စေ​၏။ မီး​သည်​စ​ခန်း​တစ်​ဘက်​စွန်း တွင်​ရှိ​သော​လူ​များ​ကို​လောင်​ကျွမ်း​စေ​၏။-"]},{"type":"verse","number":2,"content":["ထို​အ​ခါ​လူ​တို့​သည်​မော​ရှေ​အား​အော်​ဟစ်​၍ အ​ကူ​အ​ညီ​တောင်း​ခံ​၏။ မော​ရှေ​သည်​ထာ​ဝ​ရ ဘု​ရား​ထံ​ဆု​တောင်း​သ​ဖြင့်​မီး​ငြိမ်း​သွား လေ​သည်။-"]},{"type":"verse","number":3,"content":["သူ​တို့​အ​ပေါ်​တွင်​ထာ​ဝ​ရ​ဘု​ရား​မှ​လောင် မီး​ကျ​သ​ဖြင့် ထို​အ​ရပ်​ကို​တ​ဗေ​ရ​ဟု သ​မုတ်​ကြ​၏။"]},{"type":"heading","content":["ခေါင်း​ဆောင်​ခု​နစ်​ဆယ်​ကို​မော​ရှေ​ရွေး​ချယ်​ခြင်း"]},{"type":"verse","number":4,"content":["ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​နှင့်​အ​တူ​လိုက် ပါ​လာ​သော နိုင်​ငံ​ခြား​သား​တို့​သည်​အ​သား ကို​တောင့်​တ​ကြ​၏။ ဣ​သ​ရေ​လ​အ​မျိုး​သား တို့​က​ပင်​လျှင်``အ​သား​ကို​စား​ချင်​လှ​ပါ​ဘ