{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"NUM","translationId":"mya_ojv","name":"တော​လည်","commonName":"တော​လည်","title":"တော​လည်​ရာ​ကျမ်း","order":4,"numberOfChapters":36,"sha256":"84e8da7f0b0a4f96c5d7481962476414c60010bb2d647dcef5e721ca26ed879f","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/mya_ojv/NUM/36.json","totalNumberOfVerses":1016},"chapter":{"number":14,"content":[{"type":"heading","content":["ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​ညည်း​ညူ​ကြ​ခြင်း"]},{"type":"verse","number":1,"content":["ထို​အ​ခါ​လူ​အ​ပေါင်း​တို့​သည်​တစ်​ည​လုံး ငို​ကြွေး​မြည်​တမ်း​ကြ​လေ​သည်။-"]},{"type":"verse","number":2,"content":["သူ​တို့​သည်​မော​ရှေ​နှင့်​အာ​ရုန်​တို့​အား``ငါ​တို့ သည်​အီ​ဂျစ်​ပြည်​၌​ဖြစ်​စေ၊ ဤ​တော​ကန္တာ​ရ ၌​ပင်​ဖြစ်​စေ​သေ​ရ​ခြင်း​က​သာ​၍​ကောင်း ပါ​သေး​သည်။-"]},{"type":"verse","number":3,"content":["ထာ​ဝ​ရ​ဘု​ရား​သည်​အ​ဘယ်​ကြောင့်​ငါ​တို့ ကို​ထို​ပြည်​သို့​ပို့​ဆောင်​ရ​ပါ​သ​နည်း။ ငါ​တို့ သည်​စစ်​ပွဲ​တွင်​ကျ​ဆုံး​ကြ​ပါ​လိမ့်​မည်။ ငါ တို့​၏​သား​မ​ယား​တို့​သည်​လည်း​ရန်​သူ​ဖမ်း သွား​ခြင်း​ခံ​ရ​ပါ​လိမ့်​မည်။ အီ​ဂျစ်​ပြည်​သို့ ပြန်​လျှင်​ကောင်း​မည်'' ဟု​ညည်း​ညူ​ကြ​လေ သည်။-"]},{"type":"verse","number":4,"content":["ထို​ကြောင့်​သူ​တို့​က``ငါ​တို့​ကို​အီ​ဂျစ်​ပြည်​သို့ ပြန်​၍ ပို့​ဆောင်​မည့်​ခေါင်း​ဆောင်​တစ်​ဦး​ကို​ရွေး ကြ​ပါ​စို့'' ဟူ​၍​အ​ချင်း​ချင်း​ပြော​ဆို​ကြ လေ​သည်။"]},{"type":"verse","number":5,"content":["ထို​အ​ခါ​မော​ရှေ​နှင့်​အာ​ရုန်​တို့​သည် လူ အ​ပေါင်