{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"NUM","translationId":"mya_ojv","name":"တော​လည်","commonName":"တော​လည်","title":"တော​လည်​ရာ​ကျမ်း","order":4,"numberOfChapters":36,"sha256":"84e8da7f0b0a4f96c5d7481962476414c60010bb2d647dcef5e721ca26ed879f","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/mya_ojv/NUM/36.json","totalNumberOfVerses":1016},"chapter":{"number":15,"content":[{"type":"heading","content":["ယဇ်​ပူ​ဇော်​ခြင်း​ဆိုင်​ရာ​ပ​ညတ်​များ"]},{"type":"verse","number":1,"content":["ထာ​ဝ​ရ​ဘု​ရား​သည်​ပေး​တော်​မူ​မည့်​ပြည် တွင် ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​လိုက်​နာ​ရန် ပ​ညတ်​များ​ကို၊-"]},{"type":"verse","number":2,"content":["မော​ရှေ​မှ​တစ်​ဆင့်​အောက်​ပါ​အ​တိုင်း ပြ​ဋ္ဌာန်း​ပေး​တော်​မူ​၏။-"]},{"type":"verse","number":3,"content":["``သင်​တို့​သည်​ထာ​ဝ​ရ​ဘု​ရား​အား​မီး​ရှို့ ရာ​ယဇ်​ဖြစ်​စေ၊ သစ္စာ​ဝတ်​ဖြေ​ရာ​ယဇ်​ဖြစ် စေ၊ စေ​တ​နာ​အ​လျောက်​ပူ​ဇော်​သော​သ​ကာ ကို​ဖြစ်​စေ​ကျင်း​ပ​မြဲ​ဘာ​သာ​ရေး​ပွဲ​တော် များ​၌ ပူ​ဇော်​သော​ပူ​ဇော်​သ​ကာ​ကို​ဖြစ် စေ​ပူ​ဇော်​သည့်​အ​ခါ သိုး၊ နွား၊ ဆိတ်​တို့​ကို ပူ​ဇော်​နိုင်​သည်။ ဤ​သ​ကာ​တို့​၏​ရ​နံ့​ကို ထာ​ဝ​ရ​ဘု​ရား​နှစ်​သက်​တော်​မူ​၏။-"]},{"type":"verse","number":4,"content":["ထာ​ဝ​ရ​ဘု​ရား​အား​သိုး​သို့​မ​ဟုတ်​ဆိတ်​ကို မီး​ရှို့​ရာ​ယဇ်​အ​ဖြစ်​ပူ​ဇော်​သော​သူ​သည် ယဇ် ကောင်​နှင့်​အ​တူ​ဘော​ဇဉ်​သကာ​အ​ဖြစ် သံ​လွင် ဆီ​နှစ်​ပိုင့်​နှင့်​ရော​ထား​သော​မုန့်​ညက်​နှစ်​ပေါင် အ​ပြင် စ​ပျစ်​ရည်​နှစ်​ပိုင့်​ကို​လည်း​ယူ​ဆောင် ခဲ့​ရ​မည်။-