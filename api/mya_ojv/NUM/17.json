{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"NUM","translationId":"mya_ojv","name":"တော​လည်","commonName":"တော​လည်","title":"တော​လည်​ရာ​ကျမ်း","order":4,"numberOfChapters":36,"sha256":"84e8da7f0b0a4f96c5d7481962476414c60010bb2d647dcef5e721ca26ed879f","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/mya_ojv/NUM/36.json","totalNumberOfVerses":1016},"chapter":{"number":17,"content":[{"type":"heading","content":["အာ​ရုန်​၏​တောင်​ဝှေး"]},{"type":"verse","number":1,"content":["ထာ​ဝ​ရ​ဘု​ရား​က​မော​ရှေ​အား၊"]},{"type":"verse","number":2,"content":["``ဣ​သ​ရေ​လ​တစ်​ဆယ့်​နှစ်​နွယ်​၏​ဦး​စီး​ခေါင်း ဆောင်​တို့​ထံ​မှ တစ်​ဦး​လျှင်​တောင်​ဝှေး​တစ်​ချောင်း ကျ​ဖြင့် တောင်​ဝှေး​တစ်​ဆယ့်​နှစ်​ချောင်း​ကို​သင့် ထံ​သို့​ယူ​ဆောင်​လာ​စေ​လော့။ ခေါင်း​ဆောင်​တစ် ဦး​စီ​သည်​မိ​မိ​၏​နာ​မည်​ကို​တောင်​ဝှေး​ပေါ် တွင်​ရေး​ရ​မည်။-"]},{"type":"verse","number":3,"content":["လေ​ဝိ​အ​နွယ်​၏​တောင်​ဝှေး​ပေါ်​တွင်​အာ​ရုန် ၏​နာ​မည်​ကို​ရေး​ရ​မည်။ အ​နွယ်​ဦး​စီး​ခေါင်း ဆောင်​တစ်​ဦး​လျှင်​တောင်​ဝှေး​တစ်​ချောင်း ရှိ​ရ​မည်။-"]},{"type":"verse","number":4,"content":["တောင်​ဝှေး​များ​ကို​ငါ​စံ​တော်​မူ​ရာ​တဲ တော်​သို့​ယူ​ဆောင်​၍​သင့်​ကို​ငါ​တွေ့​ဆုံ​ရာ ပ​ဋိ​ညာဉ်​သေတ္တာ​တော်​ရှေ့​တွင်​ထား​လော့။-"]},{"type":"verse","number":5,"content":["ငါ​ရွေး​ကောက်​သော​သူ​၏​တောင်​ဝှေး​မှ အ​ညှောက်​ထွက်​လိမ့်​မည်။ ဤ​နည်း​အား​ဖြင့် ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့ သင့်​အား မ​ကြာ​ခ​ဏ​ညည်း​ညူ​အ​ပြစ်​တင်​ခြင်း ပြု​တော့​မည်​မ​ဟုတ်'' ဟု​မိန့်​တော်​မူ​၏။"]},{"type":"verse","number":6,"content":["သို့​ဖြစ်​၍​မော​ရှေ​သည်​ဣ​သ​ရေ​လ​အ​မျိုး သား​တို့​အား​ဆင့်​ဆို​သ​ဖြင့် အ​နွယ်​ဦး​စီး ခေါင်း​ဆောင်​တစ်​ဦး​စီ​က​တောင်​ဝှေး​တစ် ချောင်း​ကျ တောင်​ဝှေး​တစ်​ဆယ့်​နှစ်​ချောင်း​ကို သူ့​ထံ​သို့​ယူ​ဆောင်​ခဲ့​ကြ​သည်။ အာ​ရုန်​၏ တောင်​ဝှေး​သည်​တစ်​ဆယ့်​နှစ်​ချောင်း​တွင် ပါ​ဝင်​၏။-"]},{"type":"verse","number":7,"content":["ထို​နောက်​မော​ရှေ​သည်​တဲ​တော်​ထဲ​ရှိ​ထာ​ဝ​ရ ဘု​ရား​၏ ပ​ဋိ​ညာဉ်​သေတ္တာ​ရှေ့​တွင်​တောင်​ဝှေး များ​ကို​ထား​လေ​သည်။"]},{"type":"verse","number":8,"content":["နောက်​တစ်​နေ့​တွင်​မော​ရှေ​သည်​တဲ​တော်​ထဲ သို့​ဝင်​သော​အ​ခါ လေ​ဝိ​အ​နွယ်​ဝင်​အာ​ရုန် ၏​တောင်​ဝှေး​မှ​အ​ညှောက်​ထွက်​လျက်​ရှိ​သည် ကို​တွေ့​မြင်​ရ​လေ​သည်။ ထို​တောင်​ဝှေး​မှ အ​ဖူး၊ အ​ပွင့်​များ​ဖူး​ပွင့်​၍​ဗာ​ဒံ​သီး​မှည့် များ​သီး​လျက်​ရှိ​ပေ​သည်။-"]},{"type":"verse","number":9,"content":["မော​ရှေ​သည်​ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့ အား တောင်​ဝှေး​အား​လုံး​ကို​ထုတ်​ပြ​ရာ​သူ တို့​သည်​ဖြစ်​ခဲ့​သော​အ​ခြင်း​အ​ရာ​ကို​တွေ့ မြင်​ကြ​၏။ ဦး​စီး​ခေါင်း​ဆောင်​တို့​သည်​မိ​မိ တို့​ဆိုင်​ရာ​တောင်​ဝှေး​ကို​ပြန်​ယူ​ကြ​လေ​သည်။-"]},{"type":"verse","number":10,"content":["ထာ​ဝ​ရ​ဘု​ရား​က``အာ​ရုန်​၏​တောင်​ဝှေး​ကို သေတ္တာ​တော်​ရှေ့​တွင်​ပြန်​ထား​လော့။ ပုန်​ကန် တတ်​သော​ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့ သည်​အ​ပြစ်​တင်​ညည်း​ညူ​နေ​လျှင် အ​သက် သေ​ဆုံး​ရ​မည်​ဖြစ်​ကြောင်း​သ​တိ​ပေး​သည့် အ​နေ​ဖြင့်​အာ​ရုန်​၏​တောင်​ဝှေး​ကို​ထို နေ​ရာ​၌​ထား​ရ​မည်'' ဟု​မိန့်​တော်​မူ ၏။-"]},{"type":"verse","number":11,"content":["ထာ​ဝ​ရ​ဘု​ရား​မိန့်​တော်​မူ​သည့်​အ​တိုင်း မော​ရှေ​ဆောင်​ရွက်​လေ​သည်။"]},{"type":"verse","number":12,"content":["ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​က​မော​ရှေ အား``အ​ကျွန်ုပ်​တို့​၏​ဘ​ဝ​ဆုံး​ရှုံး​ပါ​ပြီ။-"]},{"type":"verse","number":13,"content":["တဲ​တော်​အ​နီး​သို့​ချဉ်း​ကပ်​မိ​သူ​တိုင်း​သေ ရ​မည်​ဆို​လျှင် အ​ကျွန်ုပ်​တို့​အား​လုံး​သေ​ဆုံး ရ​ပါ​တော့​မည်'' ဟု​ဆို​ကြ​လေ​သည်။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/NUM/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/NUM/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/NUM/16.json","previousChapterAudioLinks":{},"numberOfVerses":13}