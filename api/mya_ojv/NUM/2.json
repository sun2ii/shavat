{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"NUM","translationId":"mya_ojv","name":"တော​လည်","commonName":"တော​လည်","title":"တော​လည်​ရာ​ကျမ်း","order":4,"numberOfChapters":36,"sha256":"84e8da7f0b0a4f96c5d7481962476414c60010bb2d647dcef5e721ca26ed879f","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/mya_ojv/NUM/36.json","totalNumberOfVerses":1016},"chapter":{"number":2,"content":[{"type":"heading","content":["အ​နွယ်​လိုက်​စ​ခန်း​ချ​ပုံ"]},{"type":"verse","number":1,"content":["ထာ​ဝ​ရ​ဘု​ရား​သည် မော​ရှေ​နှင့်​အာ​ရုန်​တို့​အား အောက်​ပါ​ညွှန်​ကြား​ချက်​များ​ကို​ပေး​တော်​မူ​၏။-"]},{"type":"verse","number":2,"content":["ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​သည်​စ​ခန်း​ချ​သော​အ​ခါ လူ​တိုင်း​မိ​မိ​တပ်​နှင့်​ဆိုင်​သော​အ​လံ​နှင့် မိ​မိ​သား​ချင်း​စု​နှင့်​ဆိုင်​သော​အ​လံ​အ​နီး​တွင်​နေ​ရာ​ယူ​ရ​မည်။ ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​သည်​တဲ​တော်​ပတ်​လည်​တွင်​စ​ခန်း​ချ​ရ​မည်။"]},{"type":"verse","number":3,"content":["အ​ရှေ့​ဘက်​မျက်​နှာ​တွင် ယု​ဒ​တပ်​နှင့်​ဆိုင်​သော​အ​လံ​အ​နီး​တွင် အောက်​ဖော်​ပြ​ပါ​အ​တိုင်း​အ​စု​လိုက်​မိ​မိ​တို့​၏​ခေါင်း​ဆောင်​များ​နှင့်​စ​ခန်း​ချ​ရ​မည်။ အ​နွယ်ခေါင်း​ဆောင်ဦး​ရေယု​ဒအ​မိ​န​ဒပ်​၏​သား​နာ​ရှုန်၇၄၆၀၀ဣ​သ​ခါဇု​အာ​၏​သား​နာ​သ​နေ​လ၅၄၄၀၀ဇာ​ဗု​လုန်ဟေ​လုန်​၏​သား​ဧ​လျာ​ဘ၅၇၄၀၀စု​စု​ပေါင်း၁၈၆၄၀၀ ယု​ဒ​တပ်​သည်​ရှေ့​ဆုံး​မှ​ချီ​တက်​ရ​မည်။"]},{"type":"verse","number":10,"content":["တောင်​ဘက်​မျက်​နှာ​တွင်​ရု​ဗင်​တပ်​နှင့်​ဆိုင်​သော​အ​လံ​အ​နီး​တွင် အောက်​ဖော်​ပြ​ပါ​အ​တိုင်း​အ​စု​လိုက်​မိ​မိ​တို့​၏​ခေါင်း​ဆောင်​များ​နှင့်​စ​ခန်း​ချ​ရ​မည်။ အ​နွယ်ခေါင်း​ဆောင်ဦး​ရေရု​ဗင်ရှေ​ဒု​ရ​၏​သား​ဧ​လိ​ဇု​ရ၄၆၅၀၀ရှိ​မောင်ဇု​ရိ​ရှဒ္ဒဲ​၏​သား​ရှေ​လု​မျေလ၅၉၃၀၀ဂဒ်ဒွေ​လ​၏​သား​ဧ​လျာ​သပ်၄၅၆၅၀စု​စု​ပေါင်း၁၅၁၄၅၀ ရု​ဗင်​တပ်​သည်​ဒု​တိ​ယ​နေ​ရာ​မှ​လိုက်​၍​ချီ​တက်​ရ​မည်။"]},{"type":"verse","number":17,"content":["အ​ရှေ့​မှ​ချီ​တက်​သော​တပ်​နှစ်​တပ်​နှင့်​အ​နောက်​မှ ချီ​တက်​သော​တပ်​နှစ်​တပ်​တို့​၏​အ​ကြား​တွင် လေ​ဝိ​အ​နွယ်​ဝင်​တို့​သည်​တဲ​တော်​ကို​သယ်​ဆောင်​၍​ချီ​တက်​ရ​ကြ​မည်။ တပ်​တစ်​တပ်​စီ​သည်​စ​ခန်း​ချ​သည့်​အ​ခါ မိ​မိ​တို့​အ​လံ​အ​နီး​တွင်​နေ​ရာ​ယူ​သည့်​အ​စီ​အ​စဉ်​အ​တိုင်း​ချီ​တက်​ရ​မည်။"]},{"type":"verse","number":18,"content":["အ​နောက်​ဘက်​မျက်​နှာ​တွင်​ဧ​ဖ​ရိမ်​တပ်​နှင့်​ဆိုင်​သော​အ​လံ​အ​နီး​တွင် အောက်​ဖော်​ပြ​ပါ​အ​တိုင်း​အစု​လိုက်​မိ​မိ​တို့​၏​ခေါင်း​ဆောင်​များ​နှင့်​စ​ခန်း​ချ​ရ​မည်။ အ​နွယ်ခေါင်း​ဆောင်ဦး​ရေဧ​ဖ​ရိမ်အ​မိ​ဟုဒ်​၏​သား​ဧ​လိ​ရှ​မာ၄၀၅၀၀မ​နာ​ရှေပေ​ဒါ​ဇု​ရ​၏​သား​ဂါ​မ​လျေ​လ၃၂၂၀၀ဗင်္ယာ​မိန်ဂိ​ဒေါ​နိ​၏​သား​အ​ဘိ​ဒန်၃၅၄၀၀စု​စု​ပေါင်း၁၀၈၁၀၀ ဧ​ဖ​ရိမ်​တပ်​သည်​တ​တိ​ယ​နေ​ရာ​မှ​လိုက်​၍​ချီ​တက်​ရ​မည်။-"]},{"type":"verse","number":25,"content":["မြောက်​ဘက်​မျက်​နှာ​တွင်​ဒန်​၏​တပ်​နှင့်​ဆိုင်​သော​အ​လံ​အ​နီး​တွင် အောက်​ဖော်​ပြ​ပါ​အ​တိုင်း​အ​စု​လိုက်​မိ​မိ​တို့​၏​ခေါင်း​ဆောင်​များ​နှင့်​စ​ခန်း​ချ​ရ​မည်။ အ​နွယ်ခေါင်း​ဆောင်ဦး​ရေဒန်အ​မိ​ရှဒ္ဒဲ​၏​သား​အ​ဟေ​ဇာ၆၂၇၀၀အာ​ရှာသြ​က​ရန်​၏​သား​ပါ​ဂျေ​လ၄၁၅၀၀န​ဿ​လိဧ​နန်​၏​သား​အ​ဟိ​ရ၅၃၄၀၀စု​စု​ပေါင်း၁၅၇၆၀၀ ဒန်​၏​တပ်​သည်​နောက်​ဆုံး​နေ​ရာ​မှ​လိုက်​၍​ချီ​တက်​ရ​မည်။"]},{"type":"verse","number":32,"content":["ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​၏​တပ်​အ​လိုက်​နှင့်​သား​ချင်း​စု​အ​လိုက်​လူ​ဦး​ရေ​စာ​ရင်း​စု​စု​ပေါင်း​မှာ​ခြောက်​သိန်း​သုံး​ထောင့်​ငါး​ရာ​ငါး​ဆယ်​ယောက်​ဖြစ်​သည်။-"]},{"type":"verse","number":33,"content":["ထာ​ဝ​ရ​ဘု​ရား​သည်​မော​ရှေ​အား​မိန့်​မှာ​တော်​မူ​သည့်​အ​တိုင်း လေ​ဝိ​အ​နွယ်​ဝင်​တို့​ကို​စာ​ရင်း​ကောက်​၍​မှတ်​တမ်း​တင်​ထား​ခြင်း​မ​ရှိ​ချေ။"]},{"type":"verse","number":34,"content":["ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​သည် ထာ​ဝ​ရ​ဘု​ရား​မိန့်​တော်​မူ​သ​မျှ​အ​တိုင်း​ဆောင်​ရွက်​ကြ​၏။ သူ​တို့​သည်​မိ​မိ​တို့​နှင့်​သက်​ဆိုင်​ရာ​အ​လံ​အ​နီး​တွင်​စ​ခန်း​ချကြ​၏။ ချီ​တက်​သည့်​အ​ခါ​သား​ချင်း​စု​အ​လိုက်​ချီ​တက်​ကြ​၏။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/NUM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/NUM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/NUM/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}