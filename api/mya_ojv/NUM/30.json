{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"NUM","translationId":"mya_ojv","name":"တော​လည်","commonName":"တော​လည်","title":"တော​လည်​ရာ​ကျမ်း","order":4,"numberOfChapters":36,"sha256":"84e8da7f0b0a4f96c5d7481962476414c60010bb2d647dcef5e721ca26ed879f","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/mya_ojv/NUM/36.json","totalNumberOfVerses":1016},"chapter":{"number":30,"content":[{"type":"heading","content":["သစ္စာ​ပြု​ခြင်း​ဆိုင်​ရာ​ပ​ညတ်​များ"]},{"type":"verse","number":1,"content":["မော​ရှေ​သည်​သစ္စာ​ပြု​ခြင်း​နှင့်​ဆိုင်​သော​ပ​ညတ် များ​ကို ဣ​သ​ရေ​လ​အ​နွယ်​များ​ခေါင်း​ဆောင် တို့​အား​အောက်​ပါ​အ​တိုင်း​ညွှန်​ကြား​လေ သည်။-"]},{"type":"verse","number":2,"content":["တစ်​စုံ​တစ်​ယောက်​သော​သူ​သည်​ထာ​ဝ​ရ ဘု​ရား​အား တစ်​စုံ​တစ်​ခု​ကို​ဆက်​သ​ရန် က​တိ​ပြု​လျှင်​သော်​လည်း​ကောင်း၊ တစ်​စုံ တစ်​ရာ​ကို​ရှောင်​ကြဉ်​ရန်​သစ္စာ​ဆို​လျှင်​သော် လည်း​ကောင်း ထို​သစ္စာ​က​တိ​ကို​မ​ချိုး​ဖောက် ရ။ က​တိ​သစ္စာ​ပြု​ထား​သည့်​အ​တိုင်း​တစ် သ​ဝေ​မ​တိမ်း​ဆောင်​ရွက်​ရ​မည်။"]},{"type":"verse","number":3,"content":["အ​ဖ​၏​အုပ်​ထိန်း​မှု​အောက်​တွင်​ရှိ​နေ​သေး သော​မိန်း​မ​ပျို​တစ်​ဦး​သည် ထာ​ဝ​ရ​ဘု​ရား အား​တစ်​စုံ​တစ်​ခု​ကို​ဆက်​သ​ရန်​က​တိ​ပြု လျှင်​သော်​လည်း​ကောင်း၊ တစ်​စုံ​တစ်​ရာ​ကို ရှောင်​ကြဉ်​ရန်​သစ္စာ​ဆို​လျှင်​သော်​လည်း ကောင်း၊-"]},{"type":"verse","number":4,"content":["သူ​၏​ဖ​ခင်​ကြား​၍​မ​တား​မြစ်​လျှင် သူ​သည် က​တိ​သစ္စာ​ပြု​ထား​သည်​အ​တိုင်း​တစ်​သ​ဝေ မ​တိမ်း​ဆောင်​ရွက်​ရ​မည်။-"]},{"type":"verse","number":5,"content":["သို့​ရာ​တွင်​သူ​၏​ဖ​ခင်​ကြား​၍​တား​မြစ်​ပါ​မူ သူ​သည်​က​တိ​သစ္စာ​အ​တိုင်း​ဆောင်​ရွက်​ရန်​မ လို။ ဖ​ခင်​၏​တားမြစ်​မှု​ကြောင့်​က​တိ​သစ္စာ​ပျက် ခြင်း​ကို​ထာ​ဝ​ရ​ဘု​ရား​ခွင့်​လွှတ်​တော်​မူ​မည်။"]},{"type":"verse","number":6,"content":["အိမ်​ထောင်​မ​ကျ​သေး​သော​အ​မျိုး​သ​မီး​တစ် ဦး​သည် သိ​လျက်​နှင့်​သော်​လည်း​ကောင်း၊ အ​မှတ် တမဲ့​သော်​လည်း​ကောင်း​တစ်​စုံ​တစ်​ရာ​ကို​ရှောင် ကြဉ်​ရန် က​တိ​သစ္စာ​ပြု​ပြီး​နောက်​အိမ်​ထောင် ကျ​လျှင် သူ​၏​ခင်​ပွန်း​သည်​ကြား​၍​မ​တား မြစ်​သော်၊-"]},{"type":"verse","number":7,"content":["သူ​သည်​က​တိ​သစ္စာ​ပြု​ထား​သည်​အ​တိုင်း တစ်​သ​ဝေ​မ​တိမ်း​ဆောင်​ရွက်​ရ​မည်။-"]},{"type":"verse","number":8,"content":["သူ​၏​ခင်​ပွန်း​ကြား​၍​တား​မြစ်​လျှင်​မူ​ကား သူ​သည်​က​တိ​သစ္စာ​အ​တိုင်း​ဆောင်​ရွက်​ရန် မ​လို။ ထာ​ဝ​ရ​ဘု​ရား​သည်​သူ့​ကို​ခွင့်​လွှတ် တော်​မူ​မည်။"]},{"type":"verse","number":9,"content":["မု​ဆိုး​မ​ဖြစ်​စေ၊ လင်​ကွာ​မိန်း​မ​ဖြစ်​စေ မိ​မိ ပြု​ခဲ့​သ​မျှ​သော​က​တိ​သစ္စာ​ကို​တည်​စေ ရ​မည်။"]},{"type":"verse","number":10,"content":["လင်​ရှိ​မိန်း​မ​သည်​တစ်​စုံ​တစ်​ရာ​ကို​ရှောင် ကြဉ်​ရန် က​တိ​သစ္စာ​ပြု​ခဲ့​သော်​သူ​၏​ခင်​ပွန်း ကြား​၍​မ​တား​မြစ်​လျှင်၊-"]},{"type":"verse","number":11,"content":["သူ​သည်​မိ​မိ​၏​က​တိ​သစ္စာ​ကို​တည်​စေ​ရ​မည်။-"]},{"type":"verse","number":12,"content":["သို့​ရာ​တွင်​သူ​၏​ခင်​ပွန်း​ကြား​၍​တား​မြစ်​ပါ မူ သူ​သည်​က​တိ​သစ္စာ​အ​တိုင်း​ဆောင်​ရွက်​ရန် မ​လို။ ခင်​ပွန်း​၏​တား​မြစ်​မှု​ကြောင့်​က​တိ​ပျက် ခြင်း​ကို ထာ​ဝ​ရ​ဘု​ရား​ခွင့်​လွှတ်​တော်​မူ​မည်။-"]},{"type":"verse","number":13,"content":["သူ​၏​ခင်​ပွန်း​သည်​သူ​ပြု​ခဲ့​သော​က​တိ သစ္စာ​ကို တည်​စေ​နိုင်​ခွင့်​နှင့်​ပယ်​ဖျက်​ပိုင်​ခွင့် ရှိ​၏။-"]},{"type":"verse","number":14,"content":["သို့​ရာ​တွင်​ခင်​ပွန်း​သည်​ဇ​နီး​၏​က​တိ​သစ္စာ အ​ကြောင်း​ကို​ကြား​ရ​သော​နေ့​၌​မ​တား​မြစ် လျှင် ဇ​နီး​သည်​မိ​မိ​၏​က​တိ​သစ္စာ​ကို​တည် စေ​ရ​မည်။ ခင်​ပွန်း​သည်​ကြား​ရ​သော​နေ့​၌ မ​တား​မြစ်​သ​ဖြင့်​သ​ဘော​တူ​ရာ​ရောက် သည်။-"]},{"type":"verse","number":15,"content":["သူ​သည်​တစ်​ရက်​လွန်​ပြီး​မှ​ဇ​နီး​၏​က​တိ သစ္စာ​ကို​ပယ်​ဖျက်​လျှင် က​တိ​သစ္စာ​ပျက်​ခြင်း အ​ပြစ်​ဒဏ်​ကို​ခံ​စေ​ရ​မည်။"]},{"type":"verse","number":16,"content":["ဤ​ပ​ညတ်​များ​သည်​ကား​ဖ​ခင်​၏​အုပ်​ထိန်း မှု​အောက်​တွင် ရှိ​နေ​သေး​သော​မိန်း​မ​ပျို​နှင့် အိမ်​ထောင်​ကျ​ပြီး​သော​အ​မျိုး​သ​မီး​တို့ က​တိ​သစ္စာ​ပြု​ခြင်း​နှင့်​ဆိုင်​သည့်​ပ​ညတ် များ​ဖြစ်​သ​တည်း။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/NUM/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/NUM/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/NUM/29.json","previousChapterAudioLinks":{},"numberOfVerses":16}