{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"NUM","translationId":"mya_ojv","name":"တော​လည်","commonName":"တော​လည်","title":"တော​လည်​ရာ​ကျမ်း","order":4,"numberOfChapters":36,"sha256":"84e8da7f0b0a4f96c5d7481962476414c60010bb2d647dcef5e721ca26ed879f","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/mya_ojv/NUM/36.json","totalNumberOfVerses":1016},"chapter":{"number":32,"content":[{"type":"heading","content":["ယော်​ဒန်​မြစ်​အ​ရှေ့​ဘက်​ရှိ​အ​နွယ်​များ"]},{"type":"verse","number":1,"content":["ရု​ဗင်​အ​နွယ်​နှင့်​ဂဒ်​အ​နွယ်​တို့​တွင် သိုး​နွား တိ​ရစ္ဆာန်​မြောက်​မြား​စွာ​ရှိ​ကြ​၏။ ယာ​ဇာ ပြည်​နှင့်​ဂိ​လဒ်​ပြည်​တွင်​စား​ကျက်​ကောင်း များ​ရှိ​ကြောင်း​သိ​ရှိ​ရ​သော​အ​ခါ၊-"]},{"type":"verse","number":2,"content":["သူ​တို့​သည်​မော​ရှေ၊ ဧ​လာ​ဇာ​နှင့်​ဣ​သ​ရေ​လ ခေါင်း​ဆောင်​တို့​ထံ​သို့​သွား​၍၊-"]},{"type":"verse","number":3,"content":["``ထာ​ဝ​ရ​ဘု​ရား​ကူ​မ​တော်​မူ​ခြင်း​ဖြင့်​ဣ​သ ရေ​လ​အ​မျိုး​သား​တို့​သိမ်း​ပိုက်​ရ​ရှိ​သော အ​တ ရုတ်​မြို့၊ ဒိ​ဘုန်​မြို့၊ ယာ​ဇာ​မြို့၊ နိ​မ​ရ​မြို့၊ ဟေ​ရှ ဘုန်​မြို့၊ ဧ​လာ​လေ​မြို့၊ ရှေ​ဘံ​မြို့၊ နေ​ဗော​မြို့​နှင့် ဗော​န​မြို့​များ​တည်​ရှိ​ရာ​ဒေ​သ​တွင်​စား​ကျက် ကောင်း​များ​ရှိ​ပါ​သည်။ အ​ကျွန်ုပ်​တို့​တွင်​သိုး နွား​တိ​ရစ္ဆာန်​များ​စွာ​ရှိ​ပါ​သည်။-"]},{"type":"verse","number":5,"content":["သို့​ဖြစ်​၍​ဤ​ဒေ​သ​တွင်​အ​ကျွန်ုပ်​တို့​နေ ထိုင်​ရန်​အ​ပိုင်​ပေး​သနား​ပါ။ အ​ကျွန်ုပ်​တို့ အား​ယော်​ဒန်​မြစ်​တစ်​ဖက်​သို့​ကူး​၍​မ​နေ ထိုင်​စေ​