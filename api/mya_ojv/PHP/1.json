{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PHP","translationId":"mya_ojv","name":"ဖိ​လိပ္ပိ","commonName":"ဖိ​လိပ္ပိ","title":"ဖိ​လိပ္ပိ​သြ​ဝါ​ဒ​စာ","order":50,"numberOfChapters":4,"sha256":"4c381be496324923872ea94ce6fdc905c77c833818ee2e399de0a69f3c448a8d","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PHP/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/mya_ojv/PHP/4.json","totalNumberOfVerses":99},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ခ​ရစ်​တော်​ယေ​ရှု​၏​အ​စေ​ခံ​များ​ဖြစ်​သည့် ပေါ​လု​နှင့်​တိ​မော​သေ​တို့​ထံ​မှ ဖိလိပ္ပိ​မြို့​တွင် နေ​ထိုင်​ကြ​ကုန်​သော​သင်း​အုပ်​များ​နှင့်​သင်း ထောက်​လူ​ကြီး​များ​မှ​စ​၍ ခ​ရစ်​တော်​ယေ​ရှု နှင့်​တစ်​လုံး​တစ်​ဝ​တည်း​ဖြစ်​ကြ​သော​သ​ခင် ဘု​ရား​၏​လူ​စု​တော်​ဝင်​အ​ပေါင်း​တို့​ထံ​သို့ စာ​ရေး​လိုက်​ပါ​သည်။"]},{"type":"verse","number":2,"content":["သင်​တို့​သည်​ငါ​တို့​အ​ဖ​ဘု​ရား​သ​ခင်​နှင့် သ​ခင်​ယေ​ရှု​ခ​ရစ်​ထံ​တော်​မှ​ကျေး​ဇူး​တော်​နှင့် ငြိမ်​သက်​ခြင်း​ကို​ခံ​စား​ရ​ကြ​ပါ​စေ​သော။"]},{"type":"heading","content":["ဖိ​လိ​ပ္ပိ​အ​သင်း​တော်​ဝင်​တို့​အ​တွက် ရှင်​ပေါ​လု​၏​ဆု​တောင်း​ပတ္ထနာ"]},{"type":"verse","number":3,"content":["သင်​တို့​အ​ကြောင်း​ကို​သ​တိ​ရ​သည့်​အ​ခါ​တိုင်း ငါ​သည်​ဘု​ရား​သ​ခင်​၏​ကျေး​ဇူး​တော်​ကို ချီး​မွမ်း​ပါ​၏။-"]},{"type":"verse","number":4,"content":["အ​မှု​တော်​ကို​ငါ​စ​တင်​ဆောင်​ရွက်​ချိန်​မှ​ယ​နေ့ တိုင်​အောင်​သ​တင်း​ကောင်း​ကို​ကြေ​ညာ​ရာ​တွင် ငါ နှင့်​အ​တူ​သင်​တို့​ဆောင်​ရွက်​ခဲ့​ကြ​သ​ဖြင့်​ငါ သည်​သင်​တို့​အ​တွက်​ဝမ်