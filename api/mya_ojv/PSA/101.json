{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":101,"content":[{"type":"heading","content":["ဘု​ရင်​၏​က​တိ​သစ္စာ​တော်101:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​သစ္စာ​စောင့်​သိ​ခြင်း​နှင့်","poem":2},{"text":"တ​ရား​မျှ​တ​ခြင်း​အ​ကြောင်း​ကို​သီ​ချင်း​ဆို​ပါ​မည်။ ရှေ့​တော်​၌​သီ​ချင်း​ဆို​ပါ​မည်။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​သည်​အ​ပြစ်​ဆို​ဖွယ်​မ​ရှိ​အောင် ကျင့်​ကြံ​ပါ​မည်။","poem":1},{"text":"ကိုယ်​တော်​သည်​အ​ဘယ်​အ​ခါ​မှ​ကျွန်​တော်​မျိုး ထံ​သို့ ကြွ​လာ​တော်​မူ​ပါ​မည်​နည်း။","poem":2},{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​သည်​မိ​မိ​၏​အိမ်​တွင်​ဖြူ​စင်​သည့် စိတ်​သ​ဘော​ထား​ဖြင့်​ကျင့်​ကြံ​ပြု​မူ​ပါ​မည်။","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"မ​ကောင်း​မှု​ကို​အ​ဘယ်​အ​ခါ​၌​မျှ​သည်း​ခံ​မည် မ​ဟုတ်​ပါ။","poem":1},{"text":"ဘု​ရား​သ​ခင်​အား​ကျော​ခိုင်း​သူ​တို့​၏ အ​ပြု​အ​မူ​တို့​ကို​မုန်း​၍","poem":2},{"text":"ထို​အ​ပြု​အ​မူ​တို့​နှင့်​အ​ဘယ်​သို့​မျှ​ပတ်​သက် မည် မ​ဟုတ်​ပါ။","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ငါ​သည်​လိမ်​လည်​ကောက်​ကျစ်​မည်​မ​ဟုတ်​ပါ။","poem":1},{"text":"မ​ကောင်း​မှု​ပြု​သူ​တို့​နှင့်​ပေါင်း​ဖော်​မည်​မဟုတ်​ပါ။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"သူ​တစ်​ပါး​အ​ကြောင်း​မ​ကောင်း​သ​တင်း တီး​တိုး​လွှင့်​တတ်​သူ​ကို​ဖယ်​ရှား​ပစ်​ပါ​မည်။","poem":1},{"text":"မာန်​မာ​န​ထောင်​လွှား​လျက်​စိတ်​နေ​မြင့်​သူ​ကို သည်း​ခံ​မည်​မ​ဟုတ်​ပါ။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ငါ​သည်​ထာ​ဝ​ရ​ဘု​ရား​အား​သစ္စာ​စောင့်​သူ​တို့​ကို နှစ်​သက်​ပါ​မည်။","poem":1},{"text":"သူ​တို့​အား​ငါ​၏​နန်း​တော်​တွင်​နေ​ခွင့်​ပြု​ပါ​မည်။","poem":2},{"text":"လိမ်​လည်​ကောက်​ကျစ်​မှု​ကင်း​ရှင်း​သူ​တို့​အား ငါ​၏​အ​မှု​တို့​ကို​ထမ်း​ဆောင်​စေ​ပါ​မည်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"လိမ်​လည်​ပြော​ဆို​တတ်​သူ​သည်​ငါ​၏​နန်း​တော်​တွင် နေ​ရ​မည်​မ​ဟုတ်​ပါ။","poem":1},{"text":"သူ​တော်​ယောင်​ဆောင်​တတ်​သူ​သည် ငါ​၏​ရှေ့​မှောက်​တွင်​နေ​ရ​မည်​မ​ဟုတ်​ပါ။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ငါ​တို့​တိုင်း​နိုင်​ငံ​တွင်​ရှိ​သ​မျှ​သော​သူ​ယုတ်​မာ တို့​ကို ငါ​သည်​နေ့​စဉ်​နေ့​တိုင်း​သုတ်​သင်​ပစ်​ပါ​မည်။","poem":1},{"text":"ဆိုး​ညစ်​သူ​အ​ပေါင်း​တို့​အား​ထာ​ဝ​ရ​ဘုရား​၏ မြို့​တော်​မှ​နှင်​ထုတ်​ပါ​မည်။","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}