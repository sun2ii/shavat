{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":102,"content":[{"type":"heading","content":["ဒုက္ခ​ရောက်​သူ​လူ​ငယ်​တစ်ဦး​၏ ဆု​တောင်း​ပတ္ထနာ102:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ မော​ပန်း​၍​ဝေ​ဒ​နာ​ခံ​ရ​သူ​သည် ထာ​ဝ​ရ​ဘု​ရား​အား​မြည်​တမ်း​၍​ပြု သော​ပတ္ထ​နာ။"]},{"type":"verse","number":1,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​ဆု​တောင်း​ပတ္ထ​နာ​ကို နား​ထောင်​တော်​မူ​ပါ။","poem":2},{"text":"ကယ်​မ​တော်​မူ​ရန်​ကျွန်​တော်​မျိုး​အော်​ဟစ်​သံ​ကို ကြား​တော်​မူ​ပါ။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​ဒုက္ခ​ရောက်​ချိန်​၌​မျက်​နှာ​တော်​ကို လွှဲ​တော်​မ​မူ​ပါ​နှင့်။","poem":1},{"text":"ကျွန်​တော်​မျိုး​ခေါ်​သော​အ​ခါ​နား​ထောင်​တော်​မူ​၍ လျင်​မြန်​စွာ​ထူး​တော်​မူ​ပါ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ကျွန်​တော်​မျိုး​၏​ဘ​ဝ​အ​သက်​တာ​သည် မီး​ခိုး​ကဲ့​သို့​လွင့်​ပျောက်​လျက်","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​ကိုယ်​ခန္ဓာ​သည် မီး​ကဲ့​သို့​လောင်​ကျွမ်း​လျက်​နေ​ပါ​၏။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ကျွန်​တော်​မျိုး​သည်​မြက်​ပင်​ကဲ့​သို့​အ​ထိ​အ​ခိုက် ခံ​ရ​၍​ညှိုး​နွမ်း​လျက်​ရှိ​ပါ​၏။","poem":1},{"text":"ကျွန်​တော်​မျိုး​မှာ​အ​စား​စား​ချင်​စိတ်​မ​ရှိ တော့​ပါ။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ကျွန်​တော်​မျိုး​သည်​အ​သံ​ကျယ်​စွာ​ညည်း​ညူ ရ​ပါ​၏။","poem":1},{"text":"ကျွန်​တော်​မျိုး​မှာ​အ​ရိုး​နှင့်​အ​ရေ​သာ​လျှင် ရှိ​ပါ​တော့​သည်။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ကျွန်​တော်​မျိုး​သည်​တော​ကန္တာ​ရ​ရှိ တော​ငှက်​ကဲ့​သို့​လည်း​ကောင်း၊","poem":1},{"text":"ယို​ယွင်း​ပျက်​စီး​နေ​သော​အ​ဆောက်​အ​အုံ​ရှိ ဇီး​ကွက်​ကဲ့​သို့​လည်း​ကောင်း​ဖြစ်​ပါ​၏။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ကျွန်​တော်​မျိုး​သည်​အိပ်​၍​မ​ပျော်​နိုင်​ဘဲ ဖြစ်​နေ​ပါ​၏။","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​အိမ်​မိုး​ပေါ်​တွင်​တစ်​ကောင်​တည်း နား​နေ​ရ​သော​ငှက်​နှင့်​တူ​ပါ​၏။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ကျွန်​တော်​မျိုး​အား​ရန်​သူ​များ​သည်​တစ်​နေ့​လုံး စော်​ကား​ကြ​ပါ​၏။","poem":1},{"text":"သူ​တို့​သည်​ကျွန်​တော်​မျိုး​ကို​ပုံ​ခိုင်း​၍ ကျိန်​ဆဲ​ကြ​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ကိုယ်​တော်​ရှင်​၏​ပြင်း​ထန်​သော​အ​မျက်​တော် ကြောင့်","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​ပြာ​ကို​အ​စား​အ​စာ အ​ဖြစ်​ဖြင့် စား​ရ​ပါ​၏။","poem":2},{"text":"စ​ပျစ်​ရည်​ကို​လည်း​မျက်​ရည်​နှင့်​ရော​၍​သောက် ရ​ပါ​၏။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​အား ချီး​မြှောက်​တော်​မူ​ပြီး​မှ​ပစ်​ချ​တော်​မူ​ပါ​၏။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ကျွန်​တော်​မျိုး​၏​ဘ​ဝ​အ​သက်​တာ​သည်​ည နေ​ချိန်​၌ ကျ​ရောက်​သည့်​အ​ရိပ်​ကဲ့​သို့​ဖြစ်​ပါ​၏။","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​မြက်​ကဲ့​သို့​ခြောက်​သွေ့ သွား​ပါ​၏။","poem":2}]},{"type":"verse","number":12,"content":[{"text":"သို့​ရာ​တွင် အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​ထာ​ဝ​ရ​ဘု​ရင်​ဖြစ် တော်​မူ​ပါ​၏။","poem":2},{"text":"နာ​မ​တော်​သည်​ကာ​လ​အ​စဉ်​အ​ဆက်​တည်​လိမ့်​မည်။","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​ရှင်​သည်