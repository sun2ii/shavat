{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":106,"content":[{"type":"heading","content":["ထာ​ဝ​ရ​ဘု​ရား​သည်​မိ​မိ​၏​လူ​စု​တော်​အ​ပေါ် ကောင်း​မြတ်​တော်​မူ​ခြင်း"]},{"type":"verse","number":1,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​အား​ထော​မ​နာ​ပြု​ကြ​လော့။","poem":1},{"text":"ကိုယ်​တော်​သည်​ကောင်း​မြတ်​တော်​မူ​သည်​ဖြစ်​၍ ကျေး​ဇူး​တော်​ကို​ချီး​မွမ်း​ကြ​လော့။","poem":2},{"text":"ကိုယ်​တော်​၏​မေတ္တာ​တော်​သည်​ထာ​ဝ​ရ​တည် ၏။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"အ​ဘယ်​သူ​သည်​ကိုယ်​တော်​၏​အံ့​သြ​ဖွယ်​ကောင်း သော အ​မှု​တော်​အ​ပေါင်း​တို့​ကို​ဖော်​ပြ​နိုင်​ပါ​သ​နည်း။","poem":1},{"text":"အ​ဘယ်​သူ​သည်​ကိုယ်​တော်​၏​ဂုဏ်​တော်​ရှိ သ​မျှ​ကို ဖော်​ကူး​နိုင်​ပါ​သ​နည်း။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"တ​ရား​မျှ​တ​စွာ​ပြု​မူ​၍​အ​မှန်​တ​ရား​ကို အ​စဉ် ကျင့်​သုံး​သူ​တို့​သည်​မင်္ဂလာ​ရှိ​ကြ​၏။","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​၏​လူ​စု​တော်​အား ကူ​မ​တော်​မူ​သော​အ​ခါ","poem":2},{"text":"ကျွန်​တော်​မျိုး​ကို​လည်း​သ​တိ​ရ​တော်​မူ​ပါ။","poem":1},{"text":"သူ​တို့​အား​ကယ်​တော်​မူ​သော​အ​ခါ ကျွန်​တော်​မျိုး​ကို​လည်း​ကယ်​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ကိုယ်​တော်​ရှင်​၏​လူ​စု​တော်​ကောင်း​စား​သည်​ကို ကျွန်​တော်​မျိုး​မြင်​ပါ​ရ​စေ။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​၏​ပြည်​တော်​သား​များ ဝမ်း​မြောက်​ရာ​၌​လည်း​ကောင်း၊","poem":2},{"text":"ကိုယ်​တော်​ပိုင်​တော်​မူ​သော​သူ​တို့​ရွှင်​လန်း​အား ရ​စွာ","poem":1},{"text":"ဂုဏ်​ယူ​ဝါ​ကြွား​ရာ​၌​လည်း​ကောင်း​ကျွန်​တော်​မျိုး ပါ​ဝင်​ပါ​ရ​စေ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ကျွန်​တော်​မျိုး​တို့​သည်​ဘိုး​ဘေး​များ​နည်း​တူ","poem":1},{"text":"အ​ပြစ်​ကူး​ကြ​ပါ​ပြီ။ ယုတ်​မာ​ဆိုး​ညစ်​ကြ ပါ​ပြီ။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ကျွန်​တော်​မျိုး​တို့​၏​ဘိုး​ဘေး​များ​သည်​အီ​ဂျစ် ပြည်​၌","poem":1},{"text":"ဘု​ရား​သ​ခင်​ပြု​တော်​မူ​သော​အံ့​သြ​ဖွယ်​ရာ အ​မှု​တော်​ကို​နား​မ​လည်​ကြ​ပါ။","poem":2},{"text":"သူ​တို့​အား​ကြိမ်​ဖန်​များ​စွာ​ပြ​တော်​မူ​သော မေတ္တာ​တော်​ကို​မေ့​လျော့​ကြ​ပါ​၏။","poem":1},{"text":"ထို​နောက်​ပင်​လယ်​နီ​အ​နီး​တွင်​အ​နန္တ တန်​ခိုး​ရှင်​ကို ပုန်​ကန်​ကြ​ပါ​၏။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"သို့​ရာ​တွင်​ကိုယ်​တော်​သည်​မိ​မိ​၏ မ​ဟာ​တန်​ခိုး​တော်​ကို​ပြ​ရန်","poem":1},{"text":"က​တိ​တော်​ရှိ​သည်​အ​တိုင်း​သူ​တို့​အား ကယ်​တော်​မူ​ပါ​၏။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ကိုယ်​တော်​သည်​ပင်​လယ်​နီ​ကို​အ​မိန့်​ပေး​တော် မူ​လျှင် ယင်း​သည်​ခန်း​ခြောက်​၍​သွား​၏။","poem":1},{"text":"ထို​နောက်​မိ​မိ​၏​လူ​စု​တော်​အား​ခန်း​ခြောက်​သော ပင်​လယ်​ကို​ဖြတ်​စေ​ရန်​ပို့​ဆောင်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ကိုယ်​တော်​သည်​သူ​တို့​ကို​မုန်း​သော​သူ​တို့​၏​လက်​မှ ကယ်​တော်​မူ​၏။","poem":1},{"text":"သူ​တို့​၏​ရန်​သူ​များ​လက်​မှ​ကယ်​ဆယ်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"သူ​တို့​၏​ရန်​သူ​များ​သည်​ရေ​နစ်​၍​သေ​ကြ​ကုန်​၏။","poem":1},{"text":"တစ်​စုံ​တစ်​ယောက်​မျှ​အ​သက်​ရှင်​၍​မ​ကျန်​ခဲ့။","poem":2}]},{"type":"verse",