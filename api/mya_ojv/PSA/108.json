{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":108,"content":[{"type":"heading","content":["ရန်​သူ​တို့​နှင့်​တိုက်​ခိုက်​ရာ​တွင်​ကူ​မ​တော်​မူ​ရန် ဆု​တောင်း​ပတ္ထနာ108:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သော​ဆာ​လံ​သီ​ချင်း။"]},{"type":"verse","number":1,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​လုံး​ဝ​ယုံ​ကြည်​စိတ်​ချ ပါ​၏။","poem":2},{"text":"ကျွန်​တော်​မျိုး​သည်​သီ​ချင်း​ဆို​၍​ကိုယ်​တော်​ရှင် အား ထော​မ​နာ​ပြု​ပါ​မည်။ အို ငါ့​ဝိ​ညာဉ်၊နိုး​ထ​လော့။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ငါ​၏​စောင်း​ကြီး​စောင်း​ငယ်​တို့၊နိုး​ထ​ကြ​လော့။ ငါ​သည်​နေ​ကို​နိုး​ထ​စေ​မည်။","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"လူ​မျိုး​တ​ကာ​တို့​အ​လယ်​တွင်​ကျွန်​တော်​မျိုး သည် ကိုယ်​တော်​ရှင်​၏​ကျေး​ဇူး​တော်​ကို​ချီး​မွမ်း​ပါ​မည်။","poem":2},{"text":"လူ​မျိုး​အ​ပေါင်း​တို့​အ​လယ်​တွင်​ကိုယ်​တော်​ရှင် အား ထော​မ​နာ​ပြု​ပါ​မည်။","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​ရှင်​၏​ခိုင်​မြဲ​သော​မေတ္တာ​တော်​သည် မိုး​ကောင်း​ကင်​အ​ထက်​သို့​လည်း​ကောင်း၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​၏​သစ္စာ​တော်​သည်​ကောင်း​ကင် တိုင်​အောင်​လည်း​ကောင်း​ရောက်​ရှိ​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​၏​ကြီး​မြတ်​သော​ဂုဏ်​တော်​ကို","poem":2},{"text":"မိုး​ကောင်း​ကင်​၌​လည်း​ကောင်း၊ဘုန်း​အ​သ​ရေ တော်​ကို ကမ္ဘာ​တစ်​ဝှမ်း​လုံး​တွင်​လည်း​ကောင်း​ပြ​တော်​မူ​ပါ။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​ရှင်​ချစ်​တော်​မူ​သော​လူ​စု​တော်​သည် အ​သက်​ချမ်း​သာ​ကြ​စေ​ရန်","poem":1},{"text":"ဘုန်း​အာ​နု​ဘော်​တော်​ဖြင့်​ကျွန်​တော်​မျိုး​တို့​ကို ကယ်​တော်​မူ​ပါ။","poem":2},{"text":"ကျွန်​တော်​မျိုး​၏​ဆု​တောင်း​ပတ္ထ​နာ​ကို နား​ညောင်း​တော်​မူ​ပါ။","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ဗိ​မာန်​တော်​တွင်​ဘု​ရား​သ​ခင်​က","poem":1},{"text":"``ငါ​သည်​အောင်​ပွဲ​ခံ​၍​ရှေ​ခင်​မြို့​ကို​ပိုင်း ခြား​မည်။","poem":2},{"text":"သု​ကုတ်​ချိုင့်​ဝှမ်း​ကို​လည်း​ငါ​၏​လူ​စု​တော် အား ခွဲ​ဝေ​ပေး​မည်။","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ဂိ​လဒ်​ပြည်​ကို​ငါ​ပိုင်​၏။ မ​နာ​ရှေ​ပြည်​ကို လည်း ငါ​ပိုင်​၏။","poem":1},{"text":"ဧ​ဖ​ရိမ်​ပြည်​သည်​ငါ​၏​သံ​ခ​မောက်​ဖြစ်​၍ ယု​ဒ​ပြည်​သည်​ငါ​၏​ရာ​ဇ​လှံ​တံ​ဖြစ်​၏။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"သို့​ရာ​တွင်​ငါ​သည်​မော​ဘ​ပြည်​ကို​ငါ​၏ ခြေ​ဆေး​အိုး​အ​ဖြစ်​ဖြင့်​လည်း​ကောင်း၊","poem":1},{"text":"ဧ​ဒုံ​ပြည်​ကို​ငါ​ပိုင်​ကြောင်း","poem":2},{"text":"ငါ့​ဖိ​နပ်​တင်​ရာ​အ​ဖြစ်​ဖြင့်​လည်း​ကောင်း အ​သုံး​ပြု​မည်။","poem":1},{"text":"ဖိ​လိတ္တိ​ပြည်​ပေါ်​၌​အောင်​ပွဲ​ခံ​၍​ကြွေး​ကြော် မည်'' ဟု​မိန့်​တော်​မူ​ပေ​သည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ဘု​ရား​သ​ခင်၊ခံ​တပ်​တည်​ဆောက်​ထား​သည့်","poem":1},{"text":"မြို့​အ​တွင်း​သို့​အ​ဘယ်​သူ​သည်​ကျွန်​တော် မျိုး​အား ပို့​ဆောင်​ပါ​မည်​နည်း။","poem":2},{"text":"အ​ဘယ်​သူ​သည်​ကျွန်​တော်​မျိုး​အား​ဧ​ဒုံ ပြည်​သို့ ပို့​ဆောင်​ပါ​မည်​နည်း။","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​အား​အ​ကယ်​ပင် စွန့်​ပစ်​တော်​မူ​ပါ​ပြီ​လော။","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​တပ်​များ​နှင့်​အ​တူ​ချီ​တက် တော်​မ​မူ​တော့​ပြီ​လော။","poem":2}]},{"type":"verse","number":12,"content":[{"text":"လူ​တို့​၏​အ​ကူ​အ​ညီ​သည်​အ​ချည်း​နှီး​ပင်","poem":1},{"text":"ဖြစ်​သော​ကြောင့်​ရန်​သူ​များ​ကို​တိုက်​ခိုက်​နိုင်​ရန် ကျွန်​တော်​မျိုး​အား​ကူ​မ​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ဘု​ရား​သ​ခင်​သည်​ငါ​တို့​ဘက်​၌​ရှိ​တော် မူ​လျှင် ငါ​တို့​သည်​အ​နိုင်​ရ​ကြ​လိမ့်​မည်။","poem":1},{"text":"ကိုယ်​တော်​သည်​ငါ​တို့​၏​ရန်​သူ​များ​ကို အ​ရေး​ရှုံး​နိမ့်​စေ​တော်​မူ​လိမ့်​မည်။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}