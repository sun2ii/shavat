{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":109,"content":[{"type":"heading","content":["ဒုက္ခ​ရောက်​သူ​တစ်​ဦး​၏​ဆု​တောင်း​ပတ္ထနာ109:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင်​အား ထော​မ​နာ​ပြု​ပါ​၏။ ဆိတ်​ဆိတ်​နေ​တော် မ​မူ​ပါ​နှင့်။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"သူ​ယုတ်​မာ​များ​နှင့်​လူ​လိမ်​များ​သည်​ကျွန်​တော် မျိုး​ကို တိုက်​ခိုက်​ကြ​ပါ​၏။","poem":1},{"text":"သူ​တို့​သည်​ကျွန်​တော်​မျိုး​၏​အ​ကြောင်း မု​သား​စ​ကား​ပြော​ကြ​ပါ​၏။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"သူ​တို့​သည်​ကျွန်​တော်​မျိုး​အား​အ​ကြောင်း​မဲ့","poem":1},{"text":"တိုက်​ခိုက်​၍​ကျွန်​တော်​မျိုး​၏​အ​ကြောင်း ဆိုး​ရွား​သော​သ​တင်း​များ​ကို​လွှင့်​ကြ​ပါ​၏။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ကျွန်​တော်​မျိုး​သည်​သူ​တို့​အား​မေတ္တာ​ပြ​လျက် သူ​တို့​အ​တွက်​ဆု​တောင်း​ပတ္ထ​နာ​ပြု​သော်​လည်း","poem":1},{"text":"သူ​တို့​သည်​ကျွန်​တော်​မျိုး​အား​ရန်​ဘက်​ပြု ကြ​ပါ​၏။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"သူ​တို့​သည်​ကျွန်​တော်​မျိုး​ပြု​သည့်​ကျေး​ဇူး​ကို ဆိုး​ညစ်​မှု​ဖြင့်​လည်း​ကောင်း၊ကျွန်​တော်​မျိုး​၏","poem":1},{"text":"မေတ္တာ​ကို​မုန်း​တီး​ခြင်း​ဖြင့်​လည်း​ကောင်း ပြန်​လည်​ပေး​ဆပ်​ကြ​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ကျွန်​တော်​မျိုး​၏​ရန်​သူ​အား​တ​ရား​စီ​ရင်​ရန်","poem":1},{"text":"အ​ဂ​တိ​လိုက်​စား​သော​တ​ရား​သူ​ကြီး​ကို ခန့်​ထား​ရွေး​ချယ်​ပေး​တော်​မူ​ပါ။","poem":2},{"text":"သူ​၏​ရန်​သူ​တစ်​ယောက်​က​ပင်​လျှင်​သူ့​အား ပြစ်​တင်​စွပ်​စွဲ​စေ​တော်​မူ​ပါ။","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"သူ့​အား​စစ်​ဆေး​၍​ပြစ်​မှု​ထင်​ရှား​ပါ​စေ​သော။","poem":1},{"text":"သူ​၏​ဆု​တောင်း​ပတ္ထ​နာ​သည်​ပင်​လျှင် ပြစ်​မှု​ကူး​ရာ​ရောက်​ပါ​စေ​သော။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"သူ​၏​အ​သက်​သည်​မ​ကြာ​မီ​ကုန်​ဆုံး​လျက် သူ​၏​ရာ​ထူး​ကို​အ​ခြား​သူ​တစ်​ဦး​ရ​ရှိ ပါ​စေ​သော။","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"သူ​၏​သား​သ​မီး​များ​သည်​မိ​ဘ​မဲ့​များ​ဖြစ် ကြ​လျက် သူ​၏​ဇ​နီး​သည်​မု​ဆိုး​မ​ဖြစ်​ပါ​စေ​သော။","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"သူ​၏​သား​သ​မီး​တို့​သည်​အိမ်​ရာ​မဲ့​သူ​တောင်း စား​များ ဖြစ်​ကြ​၍","poem":1},{"text":"မိ​မိ​တို့​နေ​ထိုင်​ရာ​အိမ်​ပျက်​များ​မှ​နှင်​ထုတ် ခြင်း​ကို ခံ​ရ​ကြ​ပါ​စေ​သော။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ကြွေး​ရှင်​တို့​သည်​သူ​၏​ဥစ္စာ​ပစ္စည်း​ရှိ​သ​မျှ​တို့​ကို သိမ်း​ယူ​ကြ​လျက်​သူ​စိမ်း​တစ်​ရံ​ဆံ​တို့​သည်","poem":1},{"text":"သူ​လုပ်​ကိုင်​၍​ရ​သ​မျှ​သော​အ​ကျိုး​ခံ​စား ရ​ကြ​ပါ​စေ​သော။","poem":2}]},{"type":"verse","number":12,"content":[{"text":"အ​ဘယ်​အ​ခါ​၌​မျှ​သူ့​အား​သ​နား​ကြင်​နာ မည့်​သူ၊","poem":1},{"text":"သူ​၏​ဘ​သက်​ဆိုး​များ​ကို​ကြည့်​ရှု​စောင့်​ရှောက် မည့်​သူ မ​ရှိ​ပါ​စေ​နှင့်။","poem":2}]},{"type":"verse","number":13,"content":[{"text":"သူ​၏​အ​မျိုး​တိမ်​ကော​ပါ​စေ​သော။","poem":1},{"text":"သူ​၏​နာ​မည်​သည်​နောက်​မျိုး​ဆက်​၌​ပင်​လျှင် ပျောက်​ကွယ်​သွား​ပါ​စေ​သော။","poem":2}]},{"type":"verse","number":14,"content":[{"text":"သူ​၏​ဘိုး​ဘေး​တို့​ပြု​ခဲ့​သည့်​မ​ကောင်း​မှု များ​ကို ထာ​ဝ​ရ​ဘု​ရား​သည်​သ​တိ​ရ​တော်​မူ​ပါ​စေ​သော။","poem":1},{"text":"သူ​၏​မိ​ခင်​ကူး​လွန်​ခဲ့​သည့်​အ​ပြစ်​များ​ကို​လည်း ဖြေ​လွှတ်​တော်​မ​မူ​ပါ​နှင့်။","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​သူ​တို့​၏​အ​ပြစ်​တို့​ကို သ​တိ​ရ​တော်​မူ​ပါ​စေ​သော။","poem":1},{"text":"သို့​ရာ​တွင်​သူ​တို့​၏​နာ​မည်​သည်​လော​က​မှ လုံး​ဝ​ပျောက်​ကွယ်​သွား​ပါ​စေ​သော။","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ထို​သူ​သည်​အ​ဘယ်​အ​ခါ​၌​မျှ​သ​နား ကြင်​နာ​ရန် စိတ်​မ​ကူး​ခဲ့။","poem":1},{"text":"ဆင်း​ရဲ​သူ၊ချို့​တဲ့​နွမ်း​ပါး​သူ​နှင့်​ခို​ကိုး​ရာ​မဲ့ သူ​တို့​အား​ညှဉ်း​ဆဲ​နှိပ်​စက်​သတ်​ဖြတ်​ခဲ့​၏။","poem":2}]},{"type":"verse","number":17,"content":[{"text":"သူ​သည်​ကျိန်​ဆဲ​ရန်​နှစ်​သက်​သည်​ဖြစ်​၍ သူ​ကိုယ်​တိုင်​ကျိန်​ဆဲ​ခြင်း​ကို​ခံ​ရ​ပါ​စေ သော။","poem":1},{"text":"သူ​သည်​သူ​တစ်​ပါး​အား​ကောင်း​ချီး​မင်္ဂလာ​ပေး​ရန် အ​လို​မ​ရှိ​သည်​ဖြစ်​၍","poem":2},{"text":"မည်​သူ​က​မျှ​သူ့​အား​ကောင်း​ချီး​မင်္ဂ​လာ မ​ပေး​ပါ​စေ​နှင့်။","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ကျိန်​ဆဲ​မှု​သည်​သူ​၏​အ​တွက်​ခါး​ဝတ် ပု​ဆိုး​သ​ဖွယ်​ဖြစ်​၏။","poem":1},{"text":"သူ​၏​ကျိန်​ဆဲ​ချက်​များ​သည်​ရေ​ကဲ့​သို့","poem":2},{"text":"သူ​၏​ကိုယ်​ခန္ဓာ​ထဲ​သို့​လည်း​ကောင်း၊ဆီ​ကဲ့​သို့ သူ​၏ အ​ရိုး​များ​ထဲ​သို့​လည်း​ကောင်း​စိမ့်​ဝင်​ပါ စေ​သော။","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ယင်း​ကျိန်​ဆဲ​ချက်​တို့​သည်​အ​ထည်​အ​ဝတ်​ကဲ့​သို့","poem":1},{"text":"သူ့​ကို​ဖုံး​လွှမ်း​၍​ခါး​ပတ်​သ​ဖွယ်​သူ့​ကို​အ​စဉ် အ​မြဲ ပတ်​၍​ထား​ပါ​စေ​သော။","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊ ကျွန်​တော်​မျိုး​၏​အ​ကြောင်း​ဆိုး​ရွား​သည့်","poem":1},{"text":"သ​တင်း​ကို​လွှင့်​သူ​ကျွန်​တော်​မျိုး​၏​ရန်​သူ​တို့ အား ဤ​နည်း​အ​တိုင်း​အ​ပြစ်​ပေး​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":21,"content":[{"text":"သို့​ရာ​တွင် အို ထာ​ဝ​ရ​ဘု​ရား၊ ကျွန်​တော်​မျိုး​၏​ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​က​တိ​တော်​ရှိ​သည်​အ​တိုင်း ကျွန်​တော်​မျိုး​အား​ကူ​မ​တော်​မူ​ပါ။","poem":2},{"text":"ကိုယ်​တော်​ရှင်​၏​မေတ္တာ​တော်​ကို​ထောက်​၍ ကျွန်​တော်​မျိုး​အား​ကယ်​ဆယ်​တော်​မူ​ပါ။","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​သည်​ဆင်း​ရဲ​ချို့​တဲ့​နွမ်း​ပါး ပါ​၏။","poem":1},{"text":"အ​သည်း​နှ​လုံး​ထဲ​တွင်​နာ​ကြည်း​လျက်​ရှိ​ပါ​၏။","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ကျွန်​တော်​မျိုး​သည် ည​နေ​ချိန်​အ​ရိပ်​ကဲ့​သို့ ပျောက်​ကွယ်​ရန်​နီး​ပါ​ပြီ။","poem":1},{"text":"ပိုး​ကောင်​ကဲ့​သို့​လေ​တိုက်​၍​လွင့်​သွား​ပါ​၏။","poem":2}]},{"type":"verse","number":24,"content":[{"text":"အ​စား​အ​စာ​ချို့​တဲ့​မှု​ကြောင့်​ကျွန်​တော်​မျိုး​၏ ဒူး​တို့​သည်​ချည့်​နဲ့​လျက်​ရှိ​ပါ​၏။","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​ကိုယ်​ခန္ဓာ​သည် အ​ရိုး​နှင့်​အ​ရေ​သာ​ရှိ​ပါ​၏။","poem":2}]},{"type":"verse","number":25,"content":[{"text":"လူ​တို့​သည်​ကျွန်​တော်​မျိုး​ကို​မြင်​သော​အ​ခါ ပြက်​ရယ်​ပြု​ကြ​ပါ​၏။ ဦး​ခေါင်း​ကို​ခါ​ကြ ပါ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ကျွန်​တော်​မျိုး​၏​ဘု​ရား​သ​ခင်​ထာ​ဝ​ရ​ဘု​ရား၊ ကျွန်​တော်​မျိုး​အား​ကူ​မ​တော်​မူ​ပါ။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​၏​ခိုင်​မြဲ​သော​မေတ္တာ​တော်​ကို ထောက်​၍​ကျွန်​တော်​မျိုး​အား​ကယ်​တော် မူ​ပါ။","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ကျွန်​တော်​မျိုး​အား​ကယ်​တော်​မူ​သော​သူ​သည်","poem":1},{"text":"ကိုယ်​တော်​ရှင်​ပင်​ဖြစ်​တော်​မူ​ကြောင်း​ကို ရန်​သူ​တို့​အား​သိ​စေ​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":28,"content":[{"text":"သူ​တို့​သည်​ကျွန်​တော်​မျိုး​အား","poem":1},{"text":"ကျိန်​ဆဲ​ကြ​သော်​လည်း​ကိုယ်​တော်​ရှင် မူ​ကား ကောင်း​ချီး​ပေး​တော်​မူ​ပါ​မည်။","poem":2},{"text":"ကျွန်​တော်​မျိုး​အား​နှိပ်​စက်​ညှဉ်း​ဆဲ​သော သူ​တို့​သည် အ​ရေး​ရှုံး​နိမ့်​ကြ​ပါ​စေ​သော။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​၏ အ​စေ​ခံ​ကျွန်​တော်​မျိုး​မူ​ကား ဝမ်း​မြောက်​ရ​ပါ​စေ​သော။","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ကျွန်​တော်​မျိုး​၏​ရန်​သူ​များ​သည်​ဂုဏ်​အ​သ​ရေ ပျက်​ရ​ကြ​ပါ​စေ​သော။","poem":1},{"text":"သူ​တို့​သည်​အ​ရှက်​နှင့်​မိ​မိ​တို့​ကိုယ်​ကို ဝတ်​လုံ​သ​ဖွယ်​ဖုံး​လွှမ်း​ရ​ကြ​ပါ​စေ​သော။","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"ငါ​သည်​အ​သံ​ကျယ်​စွာ​ထာ​ဝ​ရ​ဘု​ရား​၏ ကျေး​ဇူး​တော်​ကို​ချီး​မွမ်း​ပါ​မည်။","poem":1},{"text":"ပ​ရိ​သတ်​တို့​အ​လယ်​တွင်​ကိုယ်​တော်​အား ထော​မ​နာ​ပြု​ပါ​မည်။","poem":2}]},{"type":"verse","number":31,"content":[{"text":"အ​ဘယ်​ကြောင့်​ဆို​သော်​ကိုယ်​တော်​သည် ဆင်း​ရဲ​သူ​ကို​ကာ​ကွယ်​၍","poem":1},{"text":"သူ့​အား​သေ​ဒဏ်​စီ​ရင်​ကြ​သော​သူ​တို့ ၏​လက်​မှ ကယ်​တော်​မူ​သော​ကြောင့်​ဖြစ်​၏။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}