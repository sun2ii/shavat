em":1},{"text":"ကိုယ်​တော်​သည်​သ​နား​ကြင်​နာ​တော်​မူ​၍ က​ရု​ဏာ​တော်​နှင့်​ပြည့်​ဝ​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ကိုယ်​တော်​ကို​ကြောက်​ရွံ့​ရို​သေ​သူ​တို့​အား ကျွေး​မွေး​တော်​မူ​၏။","poem":1},{"text":"မိ​မိ​ပ​ဋိ​ညာဉ်​တော်​ကို​အ​ဘယ်​အ​ခါ​၌​မျှ မေ့​လျော့​တော်​မ​မူ။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ကိုယ်​တော်​သည်​အ​ခြား​လူ​မျိုး​တို့​၏​နယ်​မြေ များ​ကို","poem":1},{"text":"မိ​မိ​၏​လူ​စု​တော်​အား​ပေး​တော်​မူ​ခြင်း အား​ဖြင့် တန်​ခိုး​တော်​ကို​ပြ​တော်​မူ​လေ​ပြီ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ကိုယ်​တော်​ပြု​လေ​သ​မျှ​သော​အ​မှု​တို့​သည် သစ္စာ​နှင့်​လည်း​ကောင်း၊","poem":1},{"text":"တ​ရား​မျှ​တ​မှု​နှင့်​လည်း​ကောင်း​ညီ​ပါ​၏။","poem":2},{"text":"ကိုယ်​တော်​၏​ပ​ညတ်​တော်​မှန်​သ​မျှ​သည် ယုံ​ကြည်​အား​ထား​ထိုက်​ပါ​ပေ​သည်။","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ထို​ပ​ညတ်​တော်​တို့​သည်​ထာ​ဝ​စဉ်​တည်​ပါ​၏။","poem":1},{"text":"ယင်း​တို့​ကို​သစ္စာ​တ​ရား​နှင့်​လည်း​ကောင်း၊","poem":2},{"text":"ဖြောင့်​မတ်​ခြင်း​တ​ရား​နှင့်​လည်း​ကောင်း စီ​ရင်​ထား​တော်​မူ​ပြီ။","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​သည်​မိ​မိ​၏​လူ​စု​တော်​အား လွတ်​မြောက်​စေ​တော်​မူ​ပြီး​လျှင်","poem":1},{"text":"သူ​တို့​နှင့်​ထာ​ဝ​ရ​ပ​ဋိ​ညာဉ်​ပြု​တော် မူ​၏။","poem":2},{"text":"ကိုယ်​တော်​သည်​သန့်​ရှင်း​မြင့်​မြတ်​တော်​မူ​၍ တန်​ခိုး​ကြီး​တော်​မူ​ပါ​သည်​တ​ကား။","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ထာ​ဝ​ရ​ဘု​ရား​ကို​ကြောက်​ရွံ့​ရို​သေ​တတ်​သော သ​ဘော​သည်​ပ​ညာ​၏​အ​ချုပ်​အ​ခြာ​ဖြစ်​၏။","poem":1},{"text":"ပ​ညတ်​တော်​ကို​စောင့်​ထိန်း​သူ​အ​ပေါင်း​တို့​အား","poem":2},{"text":"မှန်​ကန်​စွာ​ဆုံး​ဖြတ်​နိုင်​ခွင့်​ကို​ကိုယ်​တော်​ပေး တော်​မူ​၏။","poem":1},{"text":"ကိုယ်​တော်​အား​ထာ​ဝ​စဉ်​ထော​မ​နာ​ပြု​ကြ ပါ​စေ​သ​တည်း။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/112.json","nextChapterAudioLinks":{},"pr