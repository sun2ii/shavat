oem":2}]},{"type":"verse","number":5,"content":[{"text":"ရက်​ရော​စွာ​ချေး​ငှား​တတ်​သော​မိ​မိ​အ​လုပ် တွင် ရိုး​သား​စွာ​ပြု​မူ​တတ်​သော​သူ​သည်​မင်္ဂ​လာ ရှိ​၏။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"သူ​တော်​ကောင်း​သည်​အ​ဘယ်​အ​ခါ​၌​မျှ ဆုံး​ရှုံး​ရ​လိမ့်​မည်​မ​ဟုတ်။","poem":1},{"text":"လူ​တို့​သည်​သူ့​အား​အ​ဘယ်​အ​ခါ​၌​မျှ မေ့​လျော့​ကြ​လိမ့်​မည်​မ​ဟုတ်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"သို့​ဖြစ်​၍​သူ​သည်​သ​တင်း​ဆိုး​ကို​ကြား​ရန် မ​ကြောက်​ရ။","poem":1},{"text":"သူ​သည်​ထာ​ဝ​ရ​ဘု​ရား​ကို​ယုံ​ကြည်","poem":2},{"text":"ကိုး​စား​သူ​ဖြစ်​သ​ဖြင့်​သူ​၏​စိတ်​နှ​လုံး သည် တည်​ကြည်​ခိုင်​မြဲ​ပေ​သည်။","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"သူ​သည်​စိုး​ရိမ်​ပူ​ပန်​မှု​နှင့်​သော်​လည်း​ကောင်း၊ ကြောက်​လန့်​မှု​နှင့်​သော်​လည်း​ကောင်း​ကင်း​၏။","poem":1},{"text":"မိ​မိ​၏​ရန်​သူ​များ​အ​ရေး​ရှုံး​နိမ့်​သည်​ကို​မု​ချ တွေ့​မြင်​ရ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"သူ​သည်​ချို့​တဲ့​နွမ်း​ပါး​သူ​တို့​ကို​ရက်​ရော​စွာ ပေး​ကမ်း​တတ်​၏။","poem":1},{"text":"သူ​သည်​အ​စဉ်​သ​နား​ကြင်​နာ​တတ်​၏။","poem":2},{"text":"သူ​သည်​တန်​ခိုး​ကြီး​၍​ရို​သေ​လေး​စား​မှု​ကို ခံ​ရ​လိမ့်​မည်။","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"သူ​ယုတ်​မာ​တို့​သည်​ဤ​အ​ခြင်း​အ​ရာ​ကို","poem":1},{"text":"မြင်​သော​အ​ခါ​ဒေါ​သ​ထွက်​၍​အံ​သွား​ခဲ ကြိတ်​လျက် ပျောက်​ကွယ်​သွား​ကြ​လိမ့်​မည်။","poem":2},{"text":"သူ​တို့​၏​အ​လို​ဆန္ဒ​သည်​ပျက်​ပြား​ရ​လိမ့်​မည်။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}