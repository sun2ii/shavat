{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":115,"content":[{"type":"heading","content":["တစ်​ဆူ​တည်း​စစ်​မှန်​သော​ဘု​ရား"]},{"type":"verse","number":1,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​၏​ခိုင်​မြဲ​သော​မေတ္တာ​တော်​နှင့်","poem":2},{"text":"သစ္စာ​တော်​ကြောင့်​ကိုယ်​တော်​တစ်​ပါး​တည်း ၌​သာ​လျှင် ဘုန်း​အ​သ​ရေ​ရှိ​တော်​မူ​ပါ​၏။","poem":1},{"text":"ကျွန်​တော်​မျိုး​တို့​၌​ဘုန်း​အ​သ​ရေ​မ​ရှိ​ပါ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"``သင်​တို့​၏​ဘု​ရား​သည်​အ​ဘယ်​မှာ​ရှိ​သ​နည်း'' ဟု","poem":1},{"text":"လူ​မျိုး​တ​ကာ​တို့​သည်​အ​ဘယ်​ကြောင့်​ငါ​တို့​အား မေး​ရ​ကြ​ပါ​သနည်း။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ငါ​တို့​ဘု​ရား​သည်​ကောင်း​ကင်​ဘုံ​တွင်​ရှိ​တော်​မူ​၍","poem":1},{"text":"အ​လို​တော်​အ​ရ​ခပ်​သိမ်း​သော​အ​မှု​တို့​ကို ပြု​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"သူ​တို့​ဘု​ရား​များ​ကား​ရွှေ​ငွေ​ဖြင့်​ပြီး​၍ လူ့​လက်​ဖြင့် ပြု​လုပ်​သော​ဘု​ရား​များ​ဖြစ်​ကြ​၏။","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ယင်း​တို့​သည်​နှုတ်​များ​ပါ​ရှိ​လျက်​နှင့်​စ​ကား မပြော​နိုင်။","poem":1},{"text":"မျက်​စိ​များ​ပါ​ရှိ​လျက်​နှင့်​မ​မြင်​နိုင်။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"နား​များ​ပါ​ရှိ​လျက်​နှင့်​မ​ကြား​နိုင်။","poem":1},{"text":"နှာ​ခေါင်း​များ​ရှိ​ပါ​လျက်​နှင့်​အ​နံ့​မ​ရ​နိုင်။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"လက်​များ​ပါ​ရှိ​လျက်​နှင့်​မ​ထိ​မ​တွေ့​နိုင်။ ခြေ​များ​ရှိ​ပါ​လျက်​နှင့်​လမ်း​မ​လျှောက်​နိုင်။","poem":1},{"text":"သူ​တို့​သည်​အ​သံ​တစ်​စုံ​တစ်​ခု​ကို​မျှ မ​ပြု​နိုင်။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ထို​ရုပ်​တု​တို့​ကို​ပြု​လုပ်​သူ​များ​နှင့်​ကိုး​စား သူ​တို့​သည်","poem":1},{"text":"မိ​မိ​တို့​ပြု​လုပ်​သည့်​ရုပ်​တု​များ​ကဲ့​သို့ ဖြစ်​ကြ​ပါ​စေ​သော။","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့၊ထာ​ဝ​ရ​ဘု​ရား ကို ကိုး​စား​ကြ​လော့။","poem":1},{"text":"ကိုယ်​တော်​သည်​သင်​တို့​ကို​ကူ​မ​တော်​မူ​၍ ကာ​ကွယ်​စောင့်​ရှောက်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":10,"content":[{"text":"အ​ချင်း​ဘု​ရား​သ​ခင်​၏​ယဇ်​ပု​ရော​ဟိတ် တို့၊ ထာ​ဝ​ရ​ဘု​ရား​ကို​ကိုး​စား​ကြ​လော့။","poem":1},{"text":"ကိုယ်​တော်​သည်​သင်​တို့​ကို​ကူ​မ​တော်​မူ​၍ ကာ​ကွယ်​စောင့်​ရှောက်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​ကို​ကြောက်​ရွံ့​ရို​သေ​သူ အ​ပေါင်း​တို့၊ ကိုယ်​တော်​ကို​ကိုး​စား​ကြ​လော့။","poem":1},{"text":"ကိုယ်​တော်​သည်​သင်​တို့​ကို​ကူ​မ​တော်​မူ​၍ ကာ​ကွယ်​စောင့်​ရှောက်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ငါ​တို့​ကို​သ​တိ​ရ​တော် မူ​၍ ကောင်း​ချီး​ပေး​တော်​မူ​လိမ့်​မည်။","poem":1},{"text":"ကိုယ်​တော်​သည်​ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့ ကို​လည်း​ကောင်း၊ဘု​ရား​သ​ခင်​၏","poem":2},{"text":"ယဇ်​ပု​ရော​ဟိတ်​အ​ပေါင်း​တို့​ကို​လည်း ကောင်း ကောင်း​ချီး​ပေး​တော်​မူ​လိမ့်​မည်။","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​သည်​မိ​မိ​အား​ကြောက်​ရွံ့​ရို​သေ​သူ","poem":1},{"text":"အ​ပေါင်း​တို့​အား​ယုတ်​မြတ်​မ​ရွေး​ကောင်း​ချီး ပေး​တော်​မူ​လိမ့်​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​သင်​တို့​နှင့်","poem":1},{"text":"သင်​တို့​၏​သား​မြေး​တို့​အား​သား​သ​မီး​များ​ကို ပေး​တော်​မူ​ပါ​စေ​သော။","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ကောင်း​ကင်​နှင့်​ကမ္ဘာ​မြေ​ကြီး​ကို​ဖန်​ဆင်း​တော် မူ​သော","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​သင်​တို့​အား​ကောင်း​ချီး​ပေး တော်​မူ​ပါ​စေ​သော။","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ကောင်း​ကင်​ကို​ထာ​ဝ​ရ​ဘု​ရား​တစ်​ပါး​တည်း သာ​လျှင် ပိုင်​တော်​မူ​၏။","poem":1},{"text":"ကမ္ဘာ​မြေ​ကြီး​ကို​မူ​ကား​လူ​သား​တို့​အား ပေး​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":17,"content":[{"text":"သေ​လွန်​ကြ​သူ၊ဆိတ်​ငြိမ်​ရာ​သို့","poem":1},{"text":"သက်​ဆင်း​ကြ​သူ​များ​သည်​ထာ​ဝ​ရ​ဘု​ရား​ကို ထော​မ​နာ​မ​ပြု​ကြ။","poem":2}]},{"type":"verse","number":18,"content":[{"text":"သို့​ရာ​တွင်​အ​သက်​ရှင်​နေ​သူ​ငါ​တို့​မူ​ကား","poem":1},{"text":"ယ​ခု​မှ​စ​၍​အ​စဉ်​အ​ဆက်​ကိုယ်​တော်​၏ ကျေး​ဇူး​တော်​ကို​ချီး​မွမ်း​ကြ​ပါ​မည်။","poem":2},{"lineBreak":true},{"text":"ထာ​ဝ​ရ​ဘု​ရား​အား​ထော​မ​နာ​ပြု​ကြ​လော့။","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}