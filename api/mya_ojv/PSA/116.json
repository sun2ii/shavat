{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":116,"content":[{"type":"heading","content":["သေ​ဘေး​မှ​လွတ်​မြောက်​သူ​က​ထာ​ဝ​ရ ဘု​ရား​အား​ထော​မ​နာ​ပြု​ခြင်း"]},{"type":"verse","number":1,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ငါ​၏​ပန်​ကြား","poem":1},{"text":"လျှောက်​ထား​ချက်​ကို​ကြား​တော်​မူ​သည်​ဖြစ်​၍ ငါ​သည်​ကိုယ်​တော်​ကို​ချစ်​မြတ်​နိုး​၏။","poem":2},{"text":"ကိုယ်​တော်​သည်​ငါ​၏​ဆု​တောင်း​ပတ္ထနာ​ကို နား​ထောင်​တော်​မူ​၏။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ငါ​လျှောက်​ထား​သည့်​အ​ခါ​တိုင်း​ကိုယ်​တော် နား​ထောင်​တော်​မူ​၏။","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"သေ​မင်း​၏​ကျော့​ကွင်း​သည်​ငါ့​ကို​ဖမ်း​မိ​လျက် နေ​၏။ သေ​ဘေး​သည်​ငါ့​ကို​ဝိုင်း​ရံ​လျက်​နေ​၏။","poem":1},{"text":"ငါ​သည်​ကြောက်​လန့်​၍​စိုး​ရိမ်​ပူ​ပန်​ရ​၏။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ထို​အ​ခါ``အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​အား​ကျွန်​တော်​မျိုး​တောင်း​ပန် ပါ​၏။","poem":2},{"text":"ကျွန်​တော်​မျိုး​ကို​ကယ်​တော်​မူ​ပါ'' ဟု","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​၏​ထံ​တော်​သို့​ငါ​ဆု​တောင်း ပတ္ထ​နာ​ပြု​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​သ​နား​ကြင်​နာ​တော်​မူ​၍ ကျေး​ဇူး​ပြု​တော်​မူ​တတ်​၏။","poem":1},{"text":"ငါ​တို့​၏​ဘု​ရား​သ​ခင်​သည်​က​ရု​ဏာ​တော်​ရှင် ဖြစ်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ခို​ကိုး​ရာ​မဲ့​သူ​တို့​ကို ကာ​ကွယ်​စောင့်​ရှောက်​တော်​မူ​၏။","poem":1},{"text":"ငါ​ဘေး​ဥ​ပဒ်​ရောက်​သော​အ​ခါ​ငါ့​ကို ကယ်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"အို ငါ့​စိတ်​နှ​လုံး၊ထာ​ဝ​ရ​ဘု​ရား​သည်","poem":1},{"text":"ငါ့​အား​ကျေး​ဇူး​ပြု​တော်​မူ​ပြီ​ဖြစ်​၍ ယုံ​ကြည်​စိတ်​ချ​စွာ​နေ​လော့။","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ငါ့​အ​သက်​ကို သေ​ဘေး​မှ​လည်း​ကောင်း၊","poem":1},{"text":"ငါ့​မျက်​စိ​ကို​မျက်​ရည်​ကျ​ခြင်း​မှ​လည်း ကောင်း၊","poem":2},{"text":"ငါ​၏​ခြေ​ကို​ချော်​လဲ​ခြင်း​မှ​လည်း​ကောင်း ကယ်​တော်​မူ​ပြီ။","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"သို့​ဖြစ်​၍​ငါ​သည်​အ​သက်​ရှင်​သူ လူ​သား​တို့​၏​ဘောင်​တွင်","poem":1},{"text":"ဘု​ရား​သ​ခင်​၏​မျက်​မှောက်​တော်​၌","poem":2},{"lineBreak":true},{"text":"သက်​ရှင်​လှုပ်​ရှား​လျက်​နေ​ရ​၏။","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ငါ​သည်​ကြောက်​လန့်​သ​ဖြင့်``ငါ့​မှာ​ယုံ​ကြည် နိုင်​သူ တစ်​ယောက်​မျှ​မ​ရှိ'' ဟူ​၍​လည်း​ကောင်း","poem":1},{"text":"``ငါ​သည်​စိတ်​ဒုက္ခ​ကြီး​စွာ​ရောက်​ပါ​ပြီ'' ဟူ​၍​လည်း​ကောင်း​ဆို​စဉ်​၌​ပင်​လျှင်","poem":2},{"text":"ထာ​ဝ​ရ​ဘု​ရား​ကို​ယုံ​ကြည်​မြဲ​ယုံ​ကြည် လျက်​နေ​ပါ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​ငါ့​အား​ပြု​တော်​မူ​သော","poem":1},{"text":"ကျေး​ဇူး​များ​အ​တွက်​ငါ​သည်​ကိုယ်​တော်​အား အ​ဘယ်​အ​ရာ​ကို​ပူ​ဇော်​ရ​ပါ​မည်​နည်း။","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ငါ့​ကို​ကယ်​တော်​မူ​သည့်​အ​တွက်","poem":1},{"text":"ကျေး​ဇူး​တော်​ကို​ချီး​မွမ်း​ရန်​ငါ​သည် ထာ​ဝ​ရ​ဘု​ရား​အား​စ​ပျစ်​ရည်​ကို ပူ​ဇော်​မည်။","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ငါ​သည်​ကိုယ်​တော်​အား​သစ္စာ​က​တိ​ပြု​ခဲ့ သည့်​အ​တိုင်း","poem":1},{"text":"ကိုယ်​တော်​၏​လူ​စု​တော်​စု​ဝေး​ရာ​တွင် မိ​မိ​၏​သစ္စာ​ဝတ်​ကို​ဖြေ​ပါ​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​၏​လူ​စု​တော်​အ​နက်​တစ်​စုံ တစ်​ယောက် သေ​ဆုံး​သွား​လျှင်","poem":1},{"text":"ကိုယ်​တော်​အ​တွက်​ကြီး​မား​သော​ဆုံး​ရှုံး​မှု ဖြစ်​ပါ​သည်​တ​ကား။","poem":2}]},{"type":"verse","number":16,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင်​၏​အ​စေ​ခံ ဖြစ်​ပါ​၏။","poem":2},{"text":"ကျွန်​တော်​မျိုး​၏​မိ​ခင်​နည်း​တူ​ကျွန်​တော်​မျိုး သည် ကိုယ်​တော်​ရှင်​၏​အ​စေ​ကို​ခံပါ​၏။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​အား​သေ ဘေး​မှ ကယ်​တော်​မူ​ပါ​ပြီ။","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ကျွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင်​အား ကျေး​ဇူး​တော်​ကို​ချီး​မွမ်း​ရာ​ယဇ်​ကို​ပူ​ဇော် ပါ​မည်။","poem":1},{"text":"အ​ထံ​တော်​သို့​ဆု​တောင်း​ပတ္ထ​နာ​ပြု​ပါ​မည်။","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ကျွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင်​အား သစ္စာ​က​တိ​ပြု​ခဲ့​သည့်​အ​တိုင်း","poem":1},{"text":"ကိုယ်​တော်​ရှင်​၏​လူ​စု​တော်​ဝင်​တို့ စု​ဝေး​ရာ","poem":2},{"text":"ယေ​ရု​ရှ​လင်​မြို့​ရှိ​ကိုယ်​တော်​ရှင်​၏​ဗိ​မာန် တော်​၌ သစ္စာ​ဝတ်​ကို​ဖြေ​ပါ​မည်။","poem":1},{"lineBreak":true},{"text":"ထာ​ဝ​ရ​ဘု​ရား​ကို​ထော​မ​နာ​ပြု​ကြ​လော့။","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":17}