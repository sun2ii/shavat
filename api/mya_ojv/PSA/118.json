{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":118,"content":[{"type":"heading","content":["အောင်​ပွဲ​အ​တွက်​ကျေး​ဇူး​တော်​ချီး​မွမ်း​သည့် ဆု​တောင်း​ပတ္ထနာ"]},{"type":"verse","number":1,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ကောင်း​မြတ်​တော်​မူ​၍","poem":1},{"text":"မေတ္တာ​တော်​သည်​ထာ​ဝ​စဉ်​တည်​တော်​မူ​သ​ဖြင့် ကိုယ်​တော်​၏​ကျေး​ဇူး​တော်​ကို​ချီး​မွမ်း​ကြ လော့။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"``ကိုယ်​တော်​၏​မေတ္တာ​တော်​သည်","poem":1},{"text":"ထာ​ဝ​စဉ်​တည်​ပါ​၏'' ဟု​ဣ​သ​ရေ​လ အ​မျိုး​သား​တို့​ဝန်​ခံ​ကြ​စေ။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"``ကိုယ်​တော်​၏​မေတ္တာ​တော်​သည်​ထာ​ဝ​စဉ်","poem":1},{"text":"တည်​တော်​မူ​ပါ​၏'' ဟု​ဘု​ရား​သ​ခင်​၏ ယဇ်​ပု​ရော​ဟိတ်​တို့​ဝန်​ခံ​ကြ​စေ။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"``ကိုယ်​တော်​၏​မေတ္တာ​တော်​သည်​ထာ​ဝ​စဉ် တည်​တော်​မူ​ပါ​၏'' ဟု","poem":1},{"text":"ကိုယ်​တော်​ကို​ကြောက်​ရွံ့​ရို​သေ​သူ​အ​ပေါင်း​တို့ ဝန်​ခံ​ကြ​စေ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ငါ​သည်​အ​လွန်​ဒုက္ခ​ရောက်​သ​ဖြင့်​ထာ​ဝ​ရ ဘု​ရား​အား ပတ္ထ​နာ​ပြု​ပါ​၏။","poem":1},{"text":"ကိုယ်​တော်​သည်​လည်း​ထူး​တော်​မူ​၍ ငါ့​ကို​လွတ်​မြောက်​စေ​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ငါ​နှင့်​အ​တူ ရှိ​တော်​မူ​သည်​ဖြစ်​၍","poem":1},{"text":"ငါ​သည်​ကြောက်​လန့်​လိမ့်​မည်​မ​ဟုတ်။ လူ​သည် ငါ့​ကို​အ​ဘယ်​သို့​ပြု​နိုင်​ပါ​သနည်း။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ငါ့​ကို​ကူ​မ​တော်​မူ​သော​အ​ရှင်​သည် ထာ​ဝ​ရ​ဘု​ရား​ဖြစ်​တော်​မူ​သ​ဖြင့်","poem":1},{"text":"ငါ​သည်​ရန်​သူ​များ​အ​ရေး​ရှုံး​နိမ့်​ကြ သည်​ကို မြင်​ရ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"လူ​ကို​အား​ကိုး​သည်​ထက်​ထာ​ဝ​ရ​ဘု​ရား​ကို အား​ကိုး​ခြင်း​က​ပို​၍​ကောင်း​၏။","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"လူ့​ခေါင်း​ဆောင်​တို့​ကို​ကိုး​စား​သည်​ထက်","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​ကို​ကိုး​စား​ခြင်း​က​ပို​၍ ကောင်း​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ငါ​၏​ပတ်​လည်​တွင်​ရန်​သူ​အ​များ​ပင်​ရှိ​သော် လည်း","poem":1},{"text":"ငါ​သည်​ထာ​ဝ​ရ​ဘု​ရား​၏​တန်​ခိုး​တော် အား​ဖြင့် သူ​တို့​ကို​သုတ်​သင်​ဖျက်​ဆီး​ပစ်​၏။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"သူ​တို့​သည်​အ​ဘက်​ဘက်​မှ​ငါ့​ကို​ဝိုင်း​ရံ​လျက် နေ​ကြ​သော်​လည်း","poem":1},{"text":"ငါ​သည်​ထာ​ဝ​ရ​ဘု​ရား​၏​တန်​ခိုး​တော် အား​ဖြင့် သူ​တို့​ကို​သုတ်​သင်​ဖျက်​ဆီး​ပစ်​၏။","poem":2}]},{"type":"verse","number":12,"content":[{"text":"သူ​တို့​သည်​ပျား​များ​ကဲ့​သို့​ငါ့​ထံ​သို့ ဝိုင်း​အုံ​၍ လာ​ကြ​သော်​လည်း","poem":1},{"text":"ဆူး​ချုံ​ကို​လောင်​သော​မီး​ကဲ့​သို့​လျင်​မြန်​စွာ ချုပ်​ငြိမ်း​၍​သွား​ကြ​၏။","poem":2},{"text":"ငါ​သည်​ထာ​ဝ​ရ​ဘု​ရား​၏​တန်​ခိုး​တော်​အား​ဖြင့် သူ​တို့​ကို​သုတ်​သင်​ဖျက်​ဆီး​ပစ်​လိုက်​၏။","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ငါ​သည်​ပြင်း​ထန်​စွာ​တိုက်​ခိုက်​ခြင်း​ကို​ခံ​ရ​၍ အ​ရေး​ရှုံး​နိမ့်​နေ​သော်​လည်း","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ငါ့​ကို​ကူ​မ​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ငါ့​အား​တန်​ခိုး​စွမ်း​ရည် ကြီး​မား​စေ​တော်​မူ​၏။","poem":1},{"text":"ကိုယ်​တော်​သည်​ငါ့​ကို​ကယ်​တင်​တော်​မူ ပြီ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"``ထာ​ဝ​ရ​ဘု​ရား​သည်​မ​ဟာ​တန်​ခိုး​တော် အား​ဖြင့်","poem":1},{"text":"အံ့​သြ​ဖွယ်​ကောင်း​သော​အ​မှု​တို့​ကို​ပြု တော်​မူ​လေ​ပြီ။","poem":2},{"text":"ကြီး​မား​သည့်​တန်​ခိုး​တော်​ကြောင့်​ငါ​တို့​သည်","poem":1},{"text":"အောင်​ပွဲ​ကို​ရ​ရှိ​လေ​ပြီ'' ဟု​ဘု​ရား​သ​ခင်​၏ လူ​စု​တော်​သည်","poem":2},{"text":"မိ​မိ​တို့​တဲ​များ​မှ​ဝမ်း​မြောက်​စွာ​အောင်​သံ​ပေး​၍ ကြွေး​ကြော်​ကြ​သည်​ကို​နား​ထောင်​ကြ​လော့။","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ငါ​သည်​မ​သေ​သေး​ဘဲ​အ​သက်​ရှင်​၍​ထာ​ဝ​ရ ဘု​ရား ပြု​တော်​မူ​သော​အ​မှု​တော်​ကို​ဖော်​ပြ​မည်။","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​သည်​ငါ့​ကို​ကြပ်​တည်း​စွာ","poem":1},{"text":"ဆုံး​မ​တော်​မူ​သော်​လည်း​သေ​မင်း​၏​လက်​သို့ အပ်​တော်​မ​မူ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ငါ​၏​အ​တွက်​ဗိ​မာန်​တော်​တံ​ခါး​တို့​ကို​ဖွင့် လိုက်​ကြ။","poem":1},{"text":"ငါ​သည်​ဝင်​၍​ထာ​ဝ​ရ​ဘု​ရား​အား​ထော​မ​နာ ပြု​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ဤ​တံ​ခါး​သည်​ထာ​ဝ​ရ​ဘု​ရား​၏​တံ​ခါး​ဖြစ်​၍ သူ​တော်​ကောင်း​တို့​သာ​လျှင်​ဝင်​ရ​ကြ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​သည်​ကျွန်​တော်​မျိုး​လျှောက်​ထား ချက်​ကို ကြား​တော်​မူ​၍","poem":2},{"text":"ကျွန်​တော်​မျိုး​အား​အောင်​ပွဲ​ကို​ပေး​တော်​မူ သ​ဖြင့်","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​အား​ထော​မ​နာ ပြု​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"တိုက်​ကို​တည်​ဆောက်​သူ​တို့​ပစ်​ပယ်​ထား​သော","poem":1},{"text":"ကျောက်​သည်​အ​ရေး​အ​ကြီး​ဆုံး​ဖြစ်​သော ထောင့်​ချုပ်​ကျောက်​ဖြစ်​လာ​ရ​၏။","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ဤ​အ​မှု​ကား​ဘု​ရား​သ​ခင်​ပြု​တော်​မူ​သော အ​မှု​ဖြစ်​၏။","poem":1},{"text":"ငါ​တို့​မျက်​မှောက်​၌​အံ့​သြ​ဖွယ် ကောင်း​လှ​ပါ​သည်​တ​ကား။","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ဤ​နေ့​ရက်​သည်​ထာ​ဝ​ရ​ဘု​ရား​အောင်​ပွဲ ခံ​တော်​မူ​သော​နေ့​ရက်​ဖြစ်​၍","poem":1},{"text":"ငါ​တို့​သည်​ဝမ်း​မြောက်​ရွှင်​လန်း​စွာ​ကျင်း​ပ ကြ​ကုန်​အံ့။","poem":2}]},{"type":"verse","number":25,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊ ကျွန်​တော်​မျိုး​တို့​အား​ကယ်​တော်​မူ​ပါ။","poem":1},{"text":"ကျွန်​တော်​မျိုး​တို့​အား​ကယ်​တော်​မူ​ပါ။","poem":2},{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊ ကျွန်​တော်​မျိုး​အား​အောင်​မြင်​ခွင့်​ကို​ပေး​တော် မူ​ပါ။","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​၏​အ​ခွင့်​နှင့်​ကြွ​လာ​သော​သူ​အား ဘု​ရား​သ​ခင်​ကောင်း​ချီး​ပေး​တော်​မူ​ပါ​စေ​သော။","poem":1},{"text":"ငါ​တို့​သည်​ထာ​ဝ​ရ​ဘု​ရား​၏​အိမ်​တော်​မှ​နေ​၍ ကိုယ်​တော်​ကို​ကောင်း​ချီး​ပေး​ပါ​၏။","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ဘု​ရား​ဖြစ်​တော်​မူ​၏။","poem":1},{"text":"ကိုယ်​တော်​သည်​ငါ​တို့​အား​ကျေး​ဇူး​ပြု​တော်​မူ​ပြီ။","poem":2},{"text":"သင်​တို့​သည်​သစ်​ခက်​များ​ကိုင်​၍၊","poem":1},{"text":"ပွဲ​သ​ဘင်​ကို​အ​စ​ပြု​ကာ​ယဇ်​ပလ္လင်​ကို​လှည့်​၍ ချီ​တက်​ကြ​လော့။","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​၏​ဘု​ရား​သ​ခင် ဖြစ်​တော်​မူ​၍","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင်​၏ ကျေး​ဇူး​တော်​ကို​ချီး​မွမ်း​ပါ​မည်။","poem":2},{"text":"ကိုယ်​တော်​ရှင်​ကြီး​မြတ်​တော်​မူ​ကြောင်း​ကို ထုတ်​ဖော်​ကြေ​ညာ​ပါ​မည်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ကောင်း​မြတ်​တော်​မူ​၍","poem":1},{"text":"မေတ္တာ​တော်​သည်​လည်း​ထာ​ဝ​စဉ် တည်​တော်​မူ​သ​ဖြင့်","poem":2},{"text":"ကိုယ်​တော်​၏​ကျေး​ဇူး​တော်​ကို​ချီး​မွမ်း ကြ​လော့။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":28}