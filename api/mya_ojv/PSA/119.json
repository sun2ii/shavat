{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":119,"content":[{"type":"heading","content":["ထာ​ဝ​ရ​ဘု​ရား​၏​ပ​ညတ်​တော်"]},{"type":"verse","number":1,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​၏​တ​ရား​တော်​ကို​လိုက်​လှောက် လက်","poem":1},{"text":"အ​ပြစ်​ဆို​ဖွယ်​မ​ရှိ​အောင်​သက်​ရှင်​လှုပ်​ရှား သူ​တို့​သည်​မင်္ဂ​လာ​ရှိ​ကြ​၏။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"သွန်​သင်​တော်​မူ​ခက်​တို့​ကို​လိုက်​နာ​၍","poem":1},{"text":"ကိုယ်​တော်​၏​စ​ကား​တော်​ကို​စိတ်​နှ​လုံး အ​ကြွင်း​မဲ့ ခံ​ယူ​သူ​တို့​သည်​မင်္ဂလာ​ရှိ​ကြ​၏။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ထို​သူ​တို့​သည်​ဒု​စ​ရိုက်​ကို​မ​ပြု​မ​ကင့်​ဘဲ","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​၏​တ​ရား​လမ်း​အ​တိုင်း လိုက်​လှောက်​တတ်​ကြ​၏။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား\"","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​မိ​မိ​၏​ပ​ညတ်​တော်​တို့​ကို ကွန်​တော်​မျိုး​တို့​အား​ပေး​အပ်​တော်​မူ​လက်","poem":2},{"text":"ယင်း​တို့​ကို​တစ်​သ​ဝေ​မ​တိမ်း​လိုက်​နာ​ကြ ရန် မှာ​ကြား​တော်​မူ​ပါ​ပြီ။","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ကွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင်​၏","poem":1},{"text":"ည\"န်​ကြား​ခက်​တို့​ကို​တစ်​သ​ဝေ​မ​တိမ်း လိုက်​နာ​ရန် ဆန္ဒ​ပြင်း​ပြ​ပါ​၏။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ကွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင်​၏​အ​မိန့်​တော် ရှိ​သ​မှ​ကို​အ​လေး​ဂ​ရု​ပြု​ပါ​လှင်","poem":1},{"text":"အ​ရှက်​တ​ကွဲ​အ​ကျိုး​နည်း​ရ​လိမ့်​မည်​မ​ဟုတ်​ပါ။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ကွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင်​၏​ဖြောင့်​မှန် သည့် စီ​ရင်​တော်​မူ​ခက်​မား​ကို​ခံ​ယူ​မှတ်​သား​ကာ","poem":1},{"text":"ဖြူ​စင်​သည့်​စိတ်​နှ​လုံး​ဖြင့်​ကိုယ်​တော်​ရှင်​အား ထော​မ​နာ​ပြု​ပါ​မည်။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ကွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင်​၏​ပ​ညတ် တော်​မား အ​တိုင်း​လိုက်​နာ​ဆောင်​ရွက်​ပါ​မည်။","poem":1},{"text":"ကွန်​တော်​မျိုး​အား​အ​ဘယ်​အ​ခါ​၌​မှ စွန့်​ပစ်​တော်​မ​မူ​ပါ​နှင့်။","poem":2}]},{"type":"heading","content":["ထာ​ဝ​ရ​ဘု​ရား​၏​ပ​ညတ်​တော်​ကို​စောင့်​ထိန်း​ခြင်း"]},{"type":"verse","number":9,"content":[{"text":"လူ​ငယ်​လူ​ရွယ်​သည်​အ​ဘယ်​သို့​အား​ဖြင့် ဖြောင့်​မတ်​စွာ​ကင့်​ကြံ​ပြု​မူ​နိုင်​ပါ​သ​နည်း။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​၏​ပ​ညတ်​တော်​တို့​ကို","poem":2},{"text":"စောင့်​ထိန်း​ခြင်း​အား​ဖြင့်​ဖြောင့်​မတ်​စွာ ကင့်​ကြံ​ပြု​မူ​နိုင်​ပါ​၏။","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ကွန်​တော်​မျိုး​သည်​စိတ်​နှ​လုံး​အ​ကြွင်း​မဲ့ ကိုယ်​တော်​၏ အ​စေ​ကို​ခံ​နိုင်​ရန်​ကြိုး​စား​ပါ​မည်။","poem":1},{"text":"ကွန်​တော်​မျိုး​အား​ကိုယ်​တော်​ရှင်​၏ ပ​ညတ်​တော်​တို့​မှ​သွေ​ဖည်​၍​မ​သွား​ပါ​စေ​နှင့်။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ကိုယ်​တော်​ရှင်​အား​မ​ပြစ်​မှား​စေ​ရန်","poem":1},{"text":"ကွန်​တော်​မျိုး​သည်​မိ​မိ​၏​စိတ်​နှ​လုံး​ထဲ​တွင် ကိုယ်​တော်​ရှင်​၏​တ​ရား​တော်​ကို​သို​ထား​ပါ​၏။","poem":2}]},{"type":"verse","number":12,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား\"","poem":1},{"text":"ကွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင်​အား ထော​မ​နာ​ပြု​ပါ​၏။","poem":2},{"text":"ကွန်​တော်​မျိုး​အား​ကိုယ်​တော်​ရှင်​၏","poem":1},{"text":"နည်း​လမ်း​