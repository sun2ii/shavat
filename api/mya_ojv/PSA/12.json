{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":12,"content":[{"type":"heading","content":["ကူ​မ​တော်​မူ​ရန်​ဆု​တောင်း​ပတ္ထ​နာ12:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊ ကျွန်​တော်​မျိုး​တို့​အား​ကူ​မ​တော်​မူ​ပါ။","poem":1},{"text":"သူ​တော်​ကောင်း​တစ်​ယောက်​မျှ​မ​ကျန်​မ​ရှိ တော့​ပါ။","poem":2},{"text":"ရိုး​သား​ဖြောင့်​မတ်​သူ​များ​ကို​လည်း​ရှာ​၍ မ​တွေ့​နိုင်​တော့​ပါ။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"လူ​အ​ပေါင်း​တို့​သည်​အ​ချင်း​ချင်း​လိမ်​လည် ပြော​ဆို​၍ မြှောက်​ပင့်​ကာ​လှည့်​စား​ကြ​ပါ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား","poem":1},{"text":"မြှောက်​ပင့်​ပြော​ဆို​တတ်​သည့်​လျှာ​များ​ကို ဖြတ်​ပစ်​တော်​မူ​ပါ။","poem":2},{"text":"ဝါ​ကြွား​တတ်​သူ​တို့​၏​နှုတ်​များ​ကို​လည်း ပိတ်​တော်​မူ​၏။","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ဝါ​ကြွား​တတ်​သူ​တို့​က``ငါ​တို့​သည်​မိ​မိ​တို့​၏ စ​ကား​အား​ဖြင့်​လို​ချင်​သည့်​အ​ရာ​ကို​ရ​ရှိ ကြ​၏။","poem":1},{"text":"ငါ​တို့​သည်​မိ​မိ​တို့​အ​လို​ဆန္ဒ​အ​တိုင်း​ပြော ဆို​မည်။","poem":2},{"text":"အ​ဘယ်​သူ​မျှ​ငါ​တို့​အား​ဆီး​တား​၍​ရ​လိမ့်​မည် မ​ဟုတ်'' ဟု​ဆို​ကြ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​က","poem":1},{"text":"``သို့​ရာ​တွင်​ချို့​တဲ့​နွမ်း​ပါး​သူ​တို့​သည်​ဖိ​စီး နှိပ်​စက်​ခြင်း​ကို​ခံ​ရ​ကြ​သ​ဖြင့်​လည်း​ကောင်း၊","poem":2},{"text":"နှိပ်​စက်​ညှဉ်း​ဆဲ​ခြင်း​ခံ​ရ​ကြ​သူ​တို့​သည် ဝေ​ဒ​နာ​နှင့် ညည်း​တွား​နေ​ကြ​သ​ဖြင့်​လည်း​ကောင်း၊","poem":1},{"text":"ငါ​သည်​ယ​ခု​ပင်​ကြွ​လာ​မည်။","poem":2},{"text":"သူ​တို့​လို​လား​တောင့်​တ​ကြ​သည့်​ဘေး​လွတ် လုံ​ခြုံ​မှု​ကို သူ​တို့​အား​ငါ​ပေး​မည်'' ဟု​မိန့်​တော်​မူ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​၏​က​တိ​တော်​များ​ကို ယုံ​ကြည်​စိတ်​ချ​နိုင်​၏။","poem":1},{"text":"မီး​ဖို​၌​ခု​နစ်​ကြိမ်​ချွတ်​ပြီး​သော​ငွေ​စင်​ကဲ့​သို့ ယုံ​ကြည်​စိတ်​ချ​နိုင်​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​တို့​အား​အ​စဉ်​ပင် ဘေး​လွတ်​လုံ​ခြုံ​စွာ​ထား​တော်​မူ​ပါ။","poem":2},{"text":"သူ​ယုတ်​မာ​တို့​၏​လက်​မှ​ကွယ်​ကာ စောင့်​ရှောက်​တော်​မူ​ပါ။","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"သူ​ယုတ်​မာ​တို့​သည်​နေ​ရာ​တ​ကာ​တွင်​ရှိ​၏။","poem":1},{"text":"လူ​အ​ပေါင်း​တို့​သည်​မ​ကောင်း​မှု​ကို​ချီး​ကူး​ကြ​၏။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}