{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":121,"content":[{"type":"heading","content":["ကွယ်​ကာ​စောင့်​ရှောက်​တော်​မူ​သော​ထာ​ဝ​ရ​ဘု​ရား"]},{"type":"verse","number":1,"content":[{"text":"ငါ​သည်​တောင်​ရိုး​များ​သို့​မျှော်​ကြည့်​၏။","poem":1},{"text":"အ​ဘယ်​မှ​ကူ​ညီ​မ​စ​မှု​ကို​ငါ​ရ​ပါ​မည်​နည်း။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ကောင်း​ကင်​နှင့်​ကမ္ဘာ​မြေ​ကြီး​ကို​ဖန်​ဆင်း​တော် မူ​သော ထာ​ဝ​ရ​ဘု​ရား​၏​ထံ​တော်​မှ​ရ​ပါ​လိမ့်​မည်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ကိုယ်​တော်​သည်​သင့်​အား​ခြေ​ချော်​၍ လဲ​စေ​တော်​မူ​လိမ့်​မည်​မ​ဟုတ်။","poem":1},{"text":"သင့်​ကို​ကွယ်​ကာ​စောင့်​ရှောက်​တော်​မူ​သော အ​ရှင်​သည်​အိပ်​တော်​မ​မူ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​ကို​ကွယ်​ကာ စောင့်​ရှောက်​တော်​မူ​သော​အ​ရှင်​သည်","poem":1},{"text":"အ​ဘယ်​အ​ခါ​၌​မျှ​ငိုက်​မျည်း​အိပ်​စက်​ခြင်း ရှိ​တော်​မ​မူ။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​သင့်​ကို​စောင့်​ကြပ်​တော် မူ​လိမ့်​မည်။","poem":1},{"text":"ကိုယ်​တော်​သည်​သင်​၏​အ​နီး​တွင်​ရှိ​သော​သင့်​ကို ကွယ်​ကာ​ရာ​အ​ရိပ်​ဖြစ်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"နေ​သည်​နေ့​အ​ခါ​၌​လည်း​ကောင်း၊","poem":1},{"text":"လ​သည်​ညဥ့်​အ​ခါ​၌​လည်း​ကောင်း သင့်​ကို​ဥ​ပဒ်​ပေး​လိမ့်​မည်​မ​ဟုတ်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ဘေး​အန္တ​ရာယ်​အ​ပေါင်း တို့​မှ သင့်​ကို​ကွယ်​ကာ​တော်​မူ​လိမ့်​မည်။","poem":1},{"text":"သင့်​ကို​ဘေး​မဲ့​လုံ​ခြုံ​စွာ​ထား​တော်​မူ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ကိုယ်​တော်​သည်​ယ​ခု​မှ​စ​၍​ကာ​လ​အ​စဉ်​မ​ပြတ်","poem":1},{"text":"သင်​သွား​လာ​လေ​ရာ​တို့​၌​သင့်​အား ကွယ်​ကာ​စောင့်​ရှောက်​တော်​မူ​လိမ့်​မည်။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}