{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":122,"content":[{"type":"heading","content":["ယေ​ရု​ရှ​လင်​မြို့​ကို​ချီး​မွမ်း​ခန်း122:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သည်။"]},{"type":"verse","number":1,"content":[{"text":"သူ​တို့​က``ထာ​ဝ​ရ​ဘု​ရား​၏​အိမ်​တော်​သို့","poem":1},{"text":"ငါ​တို့​သွား​ကြ​ကုန်​အံ့'' ဟု​ဆို​သော​အ​ခါ ငါ​သည်​ရွှင်​လန်း​ဝမ်း​မြောက်​ပါ​၏။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ယ​ခု​အ​ခါ​ငါ​တို့​သည်​ယေ​ရု​ရှ​လင်​မြို့ တံ​ခါး​အ​တွင်း​ရပ်​လျက်​ရှိ​နေ​ကြ​ပါ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ယေ​ရု​ရှ​လင်​မြို့​သည်​တင့်​တယ်​လျောက်​ပတ်​စွာ ပြန်​လည်​တည်​ဆောက်​ထား​သော​မြို့​ဖြစ်​ပေ​၏။","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ဤ​မြို့​သည်​ဘု​ရား​သ​ခင်​အ​မိန့်​တော်​ရှိ​သည့် အ​တိုင်း","poem":1},{"text":"ကိုယ်​တော်​၏​ကျေး​ဇူး​တော်​ကို​ချီး​မွမ်း​ရန် ဣ​သ​ရေ​လ​အ​နွယ်​တို့​စု​ရုံး​ရာ​အ​ရပ် ဖြစ်​၏။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ဤ​မြို့​သည်​ဣ​သ​ရေ​လ​ဘု​ရင်​တို့​နန်း​စိုက်​၍ ပြည်​သူ​တို့​အား​တ​ရား​စီ​ရင်​ရာ​ဌာ​န​ဖြစ်​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"``သင့်​ကို​ချစ်​မြတ်​နိုး​သူ​တို့​သည်​ကောင်း​စား ကြ​ပါ​စေ​သော။","poem":1},{"text":"သင်​၏​မြို့​ရိုး​များ​အ​တွင်း​၌​ငြိမ်း​ချမ်း​သာ​ယာ မှု​ရှိ​၍","poem":2},{"text":"သင်​၏​နန်း​တော်​များ​အ​တွင်း​၌​ဘေး​မဲ့​လုံ​ခြုံ​မှု ရှိ​ပါ​စေ​သော'' ဟု","poem":1},{"text":"ယေ​ရု​ရှ​လင်​မြို့​၏​ငြိမ်း​ချမ်း​သာ​ယာ​ရေး​အ​တွက် ဆု​တောင်း​ပတ္ထနာ​ပြု​ကြ​လော့။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ငါ​သည်​ဆွေ​မျိုး​များ​နှင့်​မိတ်​ဆွေ​များ​ကို ထောက်​ထား​၍​ယေ​ရု​ရှ​လင်​မြို့​အား","poem":1},{"text":"``သင်​၌​ငြိမ်း​ချမ်း​သာ​ယာ​ခြင်း​ရှိ​ပါ​စေ​သော'' ဟု မြွက်​ဆို​ပါ​၏။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ငါ​တို့​ဘု​ရား​သ​ခင်​ထာ​ဝ​ရ​ဘု​ရား​၏ အိမ်​တော်​ကို​ထောက်​ထား​၍","poem":1},{"text":"သင်​၏​စည်​ပင်​သာ​ယာ​မှု​အ​တွက် ဆု​တောင်း​ပတ္ထ​နာ​ပြု​ပါ​၏။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":8}