{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":129,"content":[{"type":"heading","content":["ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​၏​ရန်​သူ​များ အ​ရေး​ရှုံး​နိမ့်​ကြ​စေ​ရန်​ဆု​တောင်း​ပတ္ထနာ"]},{"type":"verse","number":1,"content":[{"text":"ဣ​သ​ရေ​လ၊သင်​ငယ်​စဉ်​အ​ခါ​မှ​စ​၍ ရန်​သူ​များ​သည်","poem":1},{"lineBreak":true},{"text":"သင့်​ကို​အ​ဘယ်​သို့​ရက်​စက်​စွာ​ညှဉ်း​ဆဲ နှိပ်​စက်​ကြ​ကြောင်း​ကို​ငါ​တို့​အား​ဖော်​ပြ​လော့။","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"``ငယ်​စဉ်​အ​ခါ​မှ​အ​စ​ပြု​၍​ငါ့​အား​ရန်​သူ​တို့​သည် ရက်​စက်​စွာ​ညှဉ်း​ဆဲ​ခဲ့​ကြ​လေ​ပြီ။","poem":1},{"text":"သို့​ရာ​တွင်​သူ​တို့​သည်​ငါ့​အ​ပေါ်​တွင် အ​နိုင်​မ​ရ​ခဲ့​ကြ။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"သူ​တို့​သည်​ငါ​၏​ကျော​ကုန်း​ကို​ပြင်း​ထန်​သည့်","poem":1},{"text":"ဒဏ်​ရာ​များ​ရ​စေ​သ​ဖြင့်​ထွန်​ကြောင်း​များ​ရှိ​သည့် လယ်​ကွက်​သ​ဖွယ်​ဖြစ်​စေ​ကြ​၏။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"သို့​ရာ​တွင်​ဖြောင့်​မတ်​တော်​မူ​သော​အ​ရှင်","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ငါ့​ကို​ကျွန်​ဘ​ဝ​မှ လွတ်​မြောက်​စေ​တော်​မူ​လေ​ပြီ''","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ဇိ​အုန်​မြို့​ကို​မုန်း​သော​သူ​အ​ပေါင်း​တို့​သည် အ​ရေး​ရှုံး​နိမ့်​လျက်​တပ်​လန်​ကြ​ပါ​စေ​သော။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"သူ​တို့​သည်​အိမ်​ခေါင်​မိုး​ပေါ်​တွင်​ပေါက်​၍","poem":1},{"text":"မ​ကြီး​ထွား​မီ​ခြောက်​သွေ့​သွား​သည့် မြက်​ပင်​များ​ကဲ့​သို့​ဖြစ်​ပါ​စေ​သော။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ထို​မြက်​တို့​ကို​အ​ဘယ်​သူ​မျှ​စု​သိမ်း​သယ်​ယူ​မှု​ကို ပြု​လိမ့်​မည်​မ​ဟုတ်။","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"``ထာ​ဝ​ရ​ဘု​ရား​သည်​သင်​တို့​ကို​ကောင်း​ချီး ပေး​တော်​မူ​ပါ​စေ​သော။","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​၏​နာ​မ​တော်​ကို​အ​မှီ​ပြု​၍","poem":2},{"text":"ငါ​တို့​သည်​သင်​တို့​အား​ကောင်း​ချီး​ပေး ပါ​၏'' ဟူ​၍","poem":1},{"text":"အ​နီး​မှ​ဖြတ်​သန်း​သွား​လာ​သူ​တို့​က​သူ​တို့​အား ပြော​ဆို​ကြ​လိမ့်​မည်​မ​ဟုတ်။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}