{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":135,"content":[{"type":"heading","content":["ထော​မ​နာ​သီ​ချင်း"]},{"type":"verse","number":1,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​ကို​ထော​မ​နာ​ပြု​ကြ​လော့။","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​၏​အ​စေ​ခံ​သူ၊ထာ​ဝ​ရ ဘု​ရား​၏ အိမ်​တော်​တည်း​ဟူ​သော","poem":2},{"text":"ငါ​တို့​ဘု​ရား​၏​ဗိ​မာန်​တော်​တွင်​ရပ်​နေ​သူ​တို့ နာ​မ​တော်​အား​ထော​မ​နာ​ပြု​ကြ​လော့။","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ကောင်း​မြတ်​တော်​မူ​သည် ဖြစ်​၍ ကိုယ်​တော်​အား​ထော​မ​နာ​ပြု​ကြ​လော့။","poem":1},{"text":"ကိုယ်​တော်​သည်​သ​နား​ကြင်​နာ​တော်​မူ​သည် ဖြစ်​၍ နာ​မ​တော်​အား​ထော​မ​နာ​သီ​ချင်း​ဆို​ကြ​လော့။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ကိုယ်​တော်​သည်​ယာ​ကုပ်​အား​မိ​မိ​အ​ဖို့​လည်း ကောင်း၊","poem":1},{"text":"ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​အား​မိ​မိ​၏ ပိုင်​ရာ​တော် ဖြစ်​စေ​ရန်​လည်း​ကောင်း​ရွေး​ချယ်​တော်​မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ငါ​တို့​၏​ထာ​ဝ​ရ​ဘု​ရား​သည်​ကြီး​မြတ် တော်​မူ​ကြောင်း​ကို​ငါ​သိ​၏။","poem":1},{"text":"ကိုယ်​တော်​သည်​ဘု​ရား​ရှိ​သ​မျှ​တို့​ထက် ကြီး​မြတ်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ကိုယ်​တော်​သည်​ကောင်း​ကင်​နှင့်​ကမ္ဘာ မြေ​ကြီး​ပေါ်​၌​လည်း​ကောင်း၊","poem":1},{"text":"ပင်​လယ်​နှင့်​ပင်​လယ်​အောက်​နက်​ရှိုင်း​ရာ အ​ရပ်​တို့​၌​လည်း​ကောင်း","poem":2},{"text":"အ​လို​တော်​အ​ရ​ခပ်​သိမ်း​သော​အ​မှု​တို့​ကို ပြု​တော်​မူ​၏။","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ကမ္ဘာ​မြေ​ကြီး​စွန်း​မှ​မိုး​တိမ်​တို့​ကို​တက်​စေ တော်​မူ​၍","poem":1},{"text":"မိုး​သက်​မုန်​တိုင်း​များ​အ​တွက်​လျှပ်​စစ်​လျှပ် နွယ်​တို့​ကို ဖန်​ဆင်း​တော်​မူ​၏။","poem":2},{"text":"လေ​ကို​လည်း​မိ​မိ​၏​လှောင်​တိုက်​တော်​ထဲ​က ထုတ်​ဆောင်​လာ​တော်​မူ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"အီ​ဂျစ်​ပြည်​တွင်​လူ​နှင့်​တိ​ရစ္ဆာန်​သား​ဦး​ရှိ သ​မျှ​ကို သေ​ဒဏ်​ခတ်​တော်​မူ​၏။","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ထို​ပြည်​တွင်​ဖာ​ရော​ဘု​ရင်​နှင့်","poem":1},{"text":"သူ​၏​အ​မှု​ထမ်း​အ​ပေါင်း​တို့​ကို​ဒဏ်​ခတ်​တော် မူ​ရန်","poem":2},{"text":"ကိုယ်​တော်​သည်​ထူး​ဆန်း​သော​နိ​မိတ်​လက္ခ​ဏာ များ​နှင့် အံ့​သြ​ဖွယ်​အ​မှု​တို့​ကို​ပြု​တော်​မူ​၏။","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"များ​စွာ​သော​တိုင်း​နိုင်​ငံ​တို့​ကို","poem":1},{"text":"ပြို​ပျက်​စေ​တော်​မူ​၍​ဘုန်း​ကြီး​သော ဘု​ရင်​တို့​ကို​ကွပ်​မျက်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"အာ​မော​ရိ​ဘု​ရင်​ရှိ​ဟုန်​မင်း၊ဗာ​ရှန်​ဘု​ရင်","poem":1},{"text":"သြ​ဃ​မင်း​နှင့်​ခါ​နာန်​နိုင်​ငံ​မှ​ဘု​ရင်​အ​ပေါင်း တို့​ကို ကွပ်​မျက်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":12,"content":[{"text":"သူ​တို့​၏​နယ်​မြေ​များ​ကို​မိ​မိ​၏​လူ​စု​တော်​အား ပေး​တော်​မူ​၏။","poem":1},{"text":"ထို​နယ်​မြေ​များ​ကို​ဣသ​ရေ​လ​အ​မျိုး​သား တို့​အား ပေး​တော်​မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​ဘု​ရား​ဖြစ်​တော်​မူ​ကြောင်း​ကို","poem":2},{"text":"လူ​တို့​သည်​အ​ခါ​ခပ်​သိမ်း​ကြား​သိ​ကြ​ပါ လိမ့်​မည်။","poem":1},{"text":"ကိုယ်​တော်​၏​နာ​မ​တော်​သည်​ကာ​လ​အ​စဉ် အ​ဆက် ကျော်​ကြား​ပါ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​မိ​မိ​၏​လူ​စု​တော်​အား ကွယ်​ကာ​တော်​မူ​လိမ့်​မည်။","poem":1},{"text":"မိ​မိ​၏​အ​စေ​ခံ​တို့​အား​က​ရု​ဏာ ထား​တော်​မူ​လိမ့်​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"လူ​မျိုး​တ​ကာ​တို့​ကိုး​ကွယ်​ကြ​သည့်​ရုပ်​တု များ​သည် ရွှေ​ငွေ​ဖြင့်​ပြီး​ကြ​၏။","poem":1},{"text":"ယင်း​တို့​သည်​လူ​တို့​လက်​ဖြင့်​ပြု​လုပ်​သော အ​ရာ​များ​ဖြစ်​ပေ​သည်။","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ထို​ရုပ်​တု​တို့​သည်​နှုတ်​များ​ရှိ​ပါ​လျက် စ​ကား​မပြော​နိုင်၊","poem":1},{"text":"မျက်​စိ​များ​ရှိ​ပါ​လျက်​မ​မြင်​နိုင်။","poem":2}]},{"type":"verse","number":17,"content":[{"text":"သူ​တို့​သည်​နား​များ​ရှိ​ပါ​လျက်​မ​ကြား​နိုင်။","poem":1},{"text":"သူ​တို့​၏​ခံ​တွင်း​၌​လည်း​ထွက်​သက်​ဝင်​သက်​မ​ရှိ။","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ရုပ်​တု​များ​ကို​ပြု​လုပ်​သူ​တို့​နှင့်​ရုပ်​တု​ကို","poem":1},{"text":"ကိုး​စား​သူ​အ​ပေါင်း​တို့​သည်​မိ​မိ​တို့​ပြု လုပ်​သည့် ရုပ်​တု​များ​ကဲ့​သို့​ဖြစ်​ကြ​ပါ​စေ​သော။","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"အို ဣသ​ရေ​လ​အ​မျိုး​သား​တို့၊ထာ​ဝ​ရ ဘု​ရား​အား ထော​မ​နာ​ပြု​ကြ​လော့။","poem":1},{"text":"ဘု​ရား​သ​ခင်​၏​ယဇ်​ပု​ရော​ဟိတ်​တို့၊ကိုယ်​တော် အား ထော​မ​နာ​ပြု​ကြ​လော့။","poem":2}]},{"type":"verse","number":20,"content":[{"text":"လေ​ဝိ​အ​နွယ်​ဝင်​တို့၊ထာ​ဝ​ရ​ဘု​ရား​အား ထော​မ​နာ​ပြု​ကြ​လော့။","poem":1},{"text":"ကိုယ်​တော်​ကို​ကြောက်​ရွံ့​ရို​သေ​သူ​အပေါင်း​တို့၊ ကိုယ်​တော်​အား​ထော​မ​နာ​ပြု​ကြ​လော့။","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ဇိ​အုန်​တောင်​တော်​ပေါ်​တွင်​လည်း​ကောင်း၊ ကိုယ်​တော်​ကိန်း​ဝပ်​တော်​မူ​ရာ","poem":1},{"text":"ယေ​ရု​ရှ​လင်​မြို့​တွင်​လည်း​ကောင်း​ကိုယ်​တော် အား ထော​မ​နာ​ပြု​ကြ​လော့။","poem":2},{"lineBreak":true},{"text":"ထာ​ဝ​ရ​ဘု​ရား​အား​ထော​မ​နာ​ပြု​ကြ​လော့။","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":20}