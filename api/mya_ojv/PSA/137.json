{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":137,"content":[{"type":"heading","content":["တိုင်း​တစ်​ပါး​တွင်​နေ​ရ​ချိန်​၌​ဣသ​ရေ​လ အ​မျိုး​သား​တို့​ညည်း​တွား​မြည်​တမ်း​ခြင်း"]},{"type":"verse","number":1,"content":[{"text":"ဇိ​အုန်​မြို့​ကို​သ​တိ​ရ​သော​အ​ခါ","poem":1},{"text":"ငါ​တို့​သည်​ဗာ​ဗု​လုံ​ပြည်​မြစ်​ချောင်း​များ အ​နီး​တွင်​ထိုင်​၍​ငို​ကြွေး​ကြ​၏။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"အ​နီး​အ​နား​ရှိ​မိုး​မ​ခ​ပင်​များ​တွင်​ငါ​တို့​၏ စောင်း​များ​ကို​ချိတ်​ဆွဲ​ထား​ကြ​၏။","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ငါ​တို့​ကို​ဖမ်း​သွား​ကြ​သူ​များ​က``ငါ​တို့​အား","poem":1},{"text":"ဖျော်​ဖြေ​ရန်​ဇိ​အုန်​မြို့​အ​ကြောင်း သီ​ချင်း​ဆို​ပြ​ပါ'' ဟု​ငါ​တို့​အား​ခိုင်း​ကြ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သ​ခင်​၏​ဂုဏ်​တော်​ချီး​မွမ်း သီ​ချင်း​ကို","poem":1},{"text":"ငါ​တို့​သည်​အ​ဘယ်​သို့​လျှင်​နိုင်​ငံ​ရပ်​ခြား​၌ ဆို​နိုင်​ကြ​ပါ​မည်​နည်း။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"အို ယေ​ရု​ရှ​လင်​မြို့၊သင့်​ကို​ငါ​မေ့​လျော့​ပါ​လျှင်","poem":1},{"text":"ငါ​သည်​စောင်း​ကို​နောက်​တစ်​ဖန်​အ​ဘယ်​အ​ခါ ၌​မျှ မ​တီး​နိုင်​ဘဲ​နေ​ပါ​စေ​သော။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ငါ​သည်​သင့်​ကို​သ​တိ​မ​ရ​လျှင်​သော်​လည်း​ကောင်း၊","poem":1},{"text":"သင့်​ကို​ငါ့​အား​ဝမ်း​မြောက်​ရွှင်​လန်း​ဆုံး​ဖြစ်​စေ​သည့် မြို့​အ​ဖြစ်​ဖြင့်","poem":2},{"text":"အ​မြတ်​တ​နိုး​မ​ထား​လျှင်​သော်​လည်း​ကောင်း","poem":1},{"text":"ငါ​သည်​နောက်​တစ်​ဖန်​အ​ဘယ်​အ​ခါ​၌​မျှ သီ​ချင်း​မ​ဆို​နိုင်​ဘဲ​နေ​ပါ​စေ​သော။","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊ ယေ​ရု​ရှ​လင်​မြို့​ကို​သိမ်း​ယူ​ချိန်​၌","poem":1},{"text":"ဧ​ဒုံ​အ​မျိုး​သား​တို့​ပြု​သည့်​အ​မှု​ကို သ​တိ​ရ​တော်​မူ​ပါ။","poem":2},{"text":"``ဤ​မြို့​ကို​မြေ​ပြင်​နှင့်​တ​ပြေး​ညီ​အောင်","poem":1},{"text":"ဖြို​ဖျက်​ကြ​လော့'' ဟု​ထို​သူ​တို့​ပြော​ဆို​ခဲ့​ကြ​သော စ​ကား​ကို​သ​တိ​ရ​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"အို ဗာ​ဗု​လုန်​မြို့၊သင်​သည်​ဖြို​ဖျက်​ခြင်း​ခံ​ရ ပေ​လိမ့်​မည်။","poem":1},{"text":"ငါ​တို့​ကို​သင်​ပြု​ကျင့်​ခဲ့​သည့်​အ​မှု​အ​တွက် သင့်​အား​လက်​စား​ချေ​သူ၊","poem":2},{"text":"သင်​၏​နို့​စို့​က​လေး​တို့​ကို​ကိုင်​၍​ကျောက်​ပေါ်​တွင် ဆောင့်​သတ်​သူ​သည်​မင်္ဂလာ​ရှိ​၏။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":8}