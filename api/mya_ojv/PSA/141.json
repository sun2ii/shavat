{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":141,"content":[{"type":"heading","content":["ညဥ့်​ဦး​ယံ​ဆု​တောင်း​ပတ္ထနာ141:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​အား​ကျွန်​တော်​မျိုး​ဟစ်​ခေါ်​ပါ​၏။","poem":2},{"text":"ယ​ခု​ပင်​ကျွန်​တော်​မျိုး​အား​ကူ​မ​တော်​မူ​ပါ။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​အား​ကျွန်​တော်​မျိုး​ဟစ်​ခေါ်​သော အ​ခါ နား​ထောင်​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ကျွန်​တော်​မျိုး​၏​ဆု​တောင်း​ပတ္ထ​နာ​ကို​မီး​ရှို့ ပူ​ဇော်​ရာ နံ့​သာ​ပေါင်း​ကဲ့​သို့​လည်း​ကောင်း၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​လက်​အုပ်​ချီ​ခြင်း​ကို​ညဥ့်​ဦး ပူ​ဇော်​ရာ ယဇ်​ကဲ့​သို့​လည်း​ကောင်း​လက်​ခံ​တော်​မူ​ပါ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​ခံ​တွင်း​အ​တွက် အ​စောင့်​အ​ကြပ်​ကို​လည်းကောင်း၊","poem":2},{"text":"ကျွန်​တော်​မျိုး​၏​နှုတ်​ဝ​တွင်​ကင်း​စောင့် ကို​လည်း​ကောင်း​ထား​ရှိ​တော်​မူ​ပါ။","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"မ​ကောင်း​မှု​ကို​သော်​လည်း​ကောင်း၊ ဆိုး​ညစ်​သူ​တို့​နှင့်​အ​တူ","poem":1},{"text":"ယုတ်​မာ​မှု​များ​ကို​သော်​လည်း​ကောင်း","poem":2},{"text":"ပြု​ကျင့်​လို​သော​စိတ်​ဆန္ဒ​နှင့်​ကျွန်​တော်​မျိုး​အား ကင်း​ဝေး​စေ​တော်​မူ​ပါ။","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​ထို​သူ​တို့​၏​စား​သောက်​ပွဲ များ​ကို အ​စဉ်​အ​မြဲ​ရှောင်​ရှား​နိုင်​ပါ​စေ​သော။","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"သူ​တော်​ကောင်း​သည်​ကျွန်​တော်​မျိုး​အား","poem":1},{"text":"သ​နား​ကြင်​နာ​စွာ​ဒဏ်​ပေး​ခြင်း​ပြော​ဆို ဆုံး​မ​ခြင်း​ကို​ပြု​ပေ​လိမ့်​မည်။","poem":2},{"text":"သို့​ရာ​တွင်​သူ​ယုတ်​မာ​တို့​၏​ချီး​မြှင့်​ဂုဏ်​ပြု ခြင်း​ကို ခံ​ယူ​လိမ့်​မည်​မ​ဟုတ်​ပါ။","poem":1},{"text":"အ​ဘယ်​ကြောင့်​ဆို​သော်​ထို​သူ​တို့​အ​ပြစ် ဒု​စ​ရိုက်​နှင့်​ပတ်​သက်​၍","poem":2},{"text":"ကျွန်​တော်​မျိုး​အ​စဉ်​ပတ္ထနာ​ပြု​လျက်​နေ​သော ကြောင့် ဖြစ်​ပါ​၏။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"သူ​တို့​ကို​အ​စိုး​ရ​သော​မင်း​တို့​သည်","poem":1},{"text":"ချောက်​ကမ်း​ပါး​ပေါ်​မှ​ပစ်​ချ​ခြင်း​ကို ခံ​ရ​ကြ​သော​အ​ခါ","poem":2},{"text":"လူ​တို့​သည်​ကျွန်​တော်​မျိုး​၏​စ​ကား​များ မှန်​ကန်​ကြောင်း​ကို​ဝန်​ခံ​ကြ​ပါ​လိမ့်​မည်။","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ထို​မင်း​တို့​၏​အ​ရိုး​များ​သည်​အ​စိတ်​စိတ် အ​မြွှာ​မြွှာ ခွဲ​စိတ်​ဖြတ်​တောက်​ခြင်း​ခံ​ရ​သော​ထင်း​ကဲ့​သို့","poem":1},{"text":"သင်္ချိုင်း​တွင်း​ဝ​၌​ပြန့်​ကြဲ​၍​နေ​လိမ့်​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"သို့​ရာ​တွင် အို ဘု​ရား​ရှင်​ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင်​ကို ကိုး​စား​မြဲ​ကိုး​စား​ပါ​၏။","poem":2},{"text":"ကျွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင်​၏​ထံ​တော်​တွင် ခို​လှုံ​ပါ​၏။","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​အ​သက်​ကို​ကွယ်​ကာ​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ကျွန်​တော်​မျိုး​အ​တွက်​ထို​သူ​တို့​ထောင်​ထား​သော ထောင်​ချောက်​မှ​လည်းကောင်း၊","poem":1},{"text":"မ​ကောင်း​မှု​ပြု​သူ​တို့​၏​ကျော့​ကွင်း​မှ​လည်း​ကောင်း ကွယ်​ကာ​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ကျွန်​တော်​မျိုး​သည်​ဘေး​မဲ့​လုံ​ခြုံ​စွာ​ထောင်​ချောက်​ကို ကျော်​သွား​နိုင်​ပါ​စေ​သော။","poem":1},{"text":"သူ​ယုတ်​မာ​တို့​မူ​ကား​မိ​မိ​တို့​ထောင်​ထား​သော ထောင်​ချောက်​ထဲ​သို့​ကျ​ကြ​ပါ​စေ​သော။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}