{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":144,"content":[{"type":"heading","content":["စစ်​ပွဲ​နိုင်​သည့်​အ​တွက်​ဘု​ရား​သ​ခင် ကျေး​ဇူး​တော်​ကို​ရှင်​ဘု​ရင်​က​ချီး​မွမ်း​ခြင်း"]},{"type":"verse","number":1,"content":[{"text":"ငါ့​ကျောက်​တောင်​ဖြစ်​တော်​မူ​သော​အ​ရှင်​ထာ​ဝ​ရ ဘု​ရား​အား​ထော​မ​နာ​ပြု​ကြ​လော့။","poem":1},{"text":"ကိုယ်​တော်​သည်​ငါ့​ကို​တိုက်​ပွဲ​ဝင်​ရန်​အ​တွက် လေ့​ကျင့်​ပေး​တော်​မူ​၏။","poem":2},{"text":"စစ်​ဆင်​မှု​ကို​သွန်​သင်​ပေး​တော်​မူ​၏။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​သည်​ငါ့​ကို​ကွယ်​ကာ​ရာ​ငါ့​ခံ​တပ်၊","poem":1},{"text":"ငါ့​ရဲ​တိုက်၊ငါ​၏​ကယ်​တင်​ရှင်၊ငါ​ကိုး​စား​ရာ ဒိုင်း​လွှား​ဖြစ်​တော်​မူ​၏။","poem":2},{"text":"ကိုယ်​တော်​သည်​လူ​မျိုး​တ​ကာ​တို့​ကို​ငါ​၏ လက်​အောက်​သို့​ရောက်​စေ​တော်​မူ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊ လူ​သည်​အ​ဘယ်​သို့​သော​သူ​ဖြစ်​၍","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​သူ့​ကို​ပ​မာ​ဏ ပြု​တော်​မူ​ရ​ပါ​သ​နည်း။","poem":2},{"text":"သာ​မန်​လူ​သား​သည်​အ​ဘယ်​သို့​သော​သူ​ဖြစ်​၍","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​သူ့​ကို​ဂ​ရု​ပြု​တော်​မူ ရ​ပါ​သ​နည်း။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"လူ​သည်​ထွက်​သက်​ဝင်​သက်​လေ​နှင့်​တူ​ပါ​၏။","poem":1},{"text":"သူ​၏​အ​သက်​တာ​သည်​လွန်​သွား​တတ်​သော အ​ရိပ်​နှင့်​တူ​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"မိုး​ကောင်း​ကင်​ကို​ကွေး​ညွှတ်​စေ​၍​ဆင်း​သက် ကြွ​လာ​တော်​မူ​ပါ။","poem":2},{"text":"တောင်​ရိုး​များ​ကို​တို့​ထိ​တော်​မူ​ပါ။ ယင်း​တို့​မှ​မီး​ခိုး​ထွက်​ပါ​လိမ့်​မည်။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"လျှပ်​စစ်​ပြက်​တော်​မူ​၍​ကိုယ်​တော်​၏​ရန်​သူ တို့​ကို က​စဥ့်​က​ရဲ​ဖြစ်​စေ​တော်​မူ​ပါ။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​၏​လေး​တော်​တို့​ကို​ပစ်​တော်​မူ​၍ သူ​တို့​အား​ထွက်​ပြေး​စေ​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"အ​ထက်​ဘုံ​မှ​လက်​တော်​ကို​ဆန့်​တော်​မူ​၍","poem":1},{"text":"ကျွန်​တော်​မျိုး​အား​ရေ​နက်​ရာ​မှ​ဆွဲ​တင် ကယ်​ဆယ်​တော်​မူ​ပါ။","poem":2},{"lineBreak":true},{"text":"တိုင်း​တစ်​ပါး​သား​တို့​၏​လက်​မှ​ကယ်​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ထို​သူ​တို့​သည်​အ​ဘယ်​အ​ခါ​၌​မျှ​မှန်​သော စကား​ကို မ​ပြော​တတ်​ကြ​ပါ။","poem":1},{"text":"ကျမ်း​ကျိန်​၍​ပြော​ဆို​ရာ​၌​ပင်​လျှင် လိမ်​လည်​တတ်​ကြ​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​သီ​ချင်း​သစ်​ကို​ဆို​၍ ကိုယ်​တော်​ရှင်​၏​ဂုဏ်​တော်​ကို​ချီး​မွမ်း​ပါ​မည်။","poem":2},{"text":"စောင်း​ကို​တီး​၍​သီ​ချင်း​ဆို​ကာ​ဂုဏ်​တော်​ကို ချီး​မွမ်း​ပါ​မည်။","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​ရှင်​သည်​ဘု​ရင်​တို့​အား​စစ်​ပွဲ​အောင်​ခွင့်​ကို ပေး​တော်​မူ​ပါ​၏။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​၏​အ​စေ​ခံ​ဒါ​ဝိဒ်​ကို ကယ်​ဆယ်​တော်​မူ​ပါ​၏။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ရက်​စက်​ကြမ်း​ကြုတ်​သော​ရန်​သူ​များ​၏​လက်​မှ ကျွန်​တော်​မျိုး​အား​ကယ်​တော်​မူ​ပါ။","poem":1},{"text":"တိုင်း​တစ်​ပါး​သား​တို့​၏​လက်​မှ​ကယ်​ဆယ်​တော် မူ​ပါ။","poem":2},{"text":"ထို​သူ​တို့​သည်​အ​ဘယ်​အ​ခါ​၌​မျှ​မှန်​သော စ​ကား​ကို​မ​ပြော​တတ်​ကြ​ပါ။","poem":1},{"text":"ကျမ်း​ကျိန်​၍​ပြော​ဆို​ရာ​၌​ပင်​လျှင် လိမ်​လည်​တတ်​ကြ​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ကျွန်​တော်​မျိုး​တို့​၏​သား​များ​သည်​အ​သက်","poem":1},{"text":"ပျို​ရွယ်​ချိန်​၌​သန်​မာ​ကြီး​ထွား​လာ​သော အ​ပင်​ငယ်​များ​ကဲ့​သို့​ဖြစ်​ပါ​စေ​သော။","poem":2},{"text":"ကျွန်​တော်​မျိုး​တို့​၏​သ​မီး​များ​သည်​နန်း​တော် ထောင့်​များ​တွင်​အ​လှ​စိုက်​ထူ​ထား​သော","poem":1},{"text":"ခန့်​ညား​သည့်​ကျောက်​တိုင်​များ​ကဲ့​သို့​ဖြစ်​ပါ စေ​သော။","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ကျွန်​တော်​မျိုး​တို့​၏​ကျီ​များ​သည်​အ​သီး​အ​နှံ အ​မျိုး​မျိုး​ဖြင့်​ပြည့်​လျက်​ရှိ​ပါ​စေ​သော။","poem":1},{"text":"ကွင်း​ပြင်​များ​ရှိ​သိုး​များ​သည်​ထောင်​ပေါင်း","poem":2},{"text":"များ​စွာ​သော​သိုး​ငယ်​တို့​ကို​မွေး​ဖွား​ကြ ပါ​စေ​သော။","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​တို့​၏​နွား​များ​သည်​လည်း​ဇီး​မ​လျှော၊ မ​သေ​မ​ပျောက်​ဘဲ​များ​စွာ​တိုး​ပွား​ကြ​ပါ​စေ​သော။","poem":1},{"text":"ကျွန်​တော်​မျိုး​တို့​၏​လမ်း​များ​သည်","poem":2},{"text":"ဒုက္ခ​ရောက်​သူ​တို့​၏​အော်​ဟစ်​ညည်း​တွား​သံ​များ​နှင့် ကင်း​ဝေး​ပါ​စေ​သော။","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ဤ​သို့​သော​အ​ခြေ​အ​နေ​၌​ရှိ​သည့်​နိုင်​ငံ​သည် မင်္ဂလာ​ရှိ​ပါ​၏။","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​ကို​ဘု​ရား​အ​ဖြစ်​ကိုး​ကွယ်​သော လူ​မျိုး​သည်​မင်္ဂလာ​ရှိ​ပါ​၏။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}