{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":145,"content":[{"type":"heading","content":["ထော​မ​နာ​သီ​ချင်း145:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သော​ထော​မ​နာ​သီ​ချင်း။"]},{"type":"verse","number":1,"content":[{"text":"ကျွန်​တော်​မျိုး​၏​ဘု​ရား၊ကျွန်​တော်​မျိုး​၏​ဘု​ရင်၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင် ကြီး​မြတ်​တော်​မူ​ပုံ​ကို​ထုတ်​ဖော်​ကြေ​ညာ​ပါ​မည်။","poem":2},{"text":"ကိုယ်​တော်​ရှင်​၏​ကျေး​ဇူး​တော်​ကို​ကာ​လ​အစဉ် အ​ဆက် ချီး​မွမ်း​ပါ​မည်။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"နေ့​စဉ်​နေ့​တိုင်း​ကိုယ်​တော်​ရှင်​၏​ကျေး​ဇူး​တော်​ကို ချီး​မွမ်း​ပါ​မည်။","poem":1},{"text":"ကာ​လ​အ​စဉ်​အ​ဆက်​ကိုယ်​တော်​ရှင်​အား ထော​မ​နာ​ပြု​ပါ​မည်။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ကြီး​မြတ်​တော်​မူ​၍ ထော​မ​နာ​ပြု​ခြင်း​ကို​အ​လွန်​ခံ​ထိုက်​တော်​မူ​၏။","poem":1},{"text":"ကြီး​မြတ်​တော်​မူ​ပုံ​ကို​ဆင်​ခြင်​တိုင်း​ထွာ​၍ မ​ရ​နိုင်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ကိုယ်​တော်​ရှင်​ပြု​တော်​မူ​သော​အ​မှု​တော်​ကို","poem":1},{"text":"လူ​တို့​သည်​သား​စဉ်​မြေး​ဆက်​ထော​မ​နာ​ပြု ပါ​လိမ့်​မည်။","poem":2},{"text":"သူ​တို့​သည်​ကိုယ်​တော်​ရှင်​၏​အံ့​သြ​ဖွယ်​ကောင်း​သော","poem":1},{"text":"မ​ဟာ​အ​မှု​တော်​တို့​ကို​ထုတ်​ဖော်​ကြေ​ညာ ကြ​ပါ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"သူ​တို့​သည်​ကိုယ်​တော်​ရှင်​၏​ဘုန်း​အ​သ​ရေ တော်​နှင့် အာ​နု​ဘော်​တော်​ကို​ပြော​ကြား​ကြ​ပါ​လိမ့်​မည်။","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင်​ပြု​တော်​မူ​သော","poem":2},{"text":"အံ့​သြ​ဖွယ်​အ​မှု​တော်​တို့​ကို​စဉ်း​စား​ဆင်​ခြင် ပါ​မည်။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"လူ​တို့​သည်​ကိုယ်​တော်​ရှင်​၏​အံ့​သြ​ဖွယ်​ကောင်း​သော မ​ဟာ​အ​မှု​တော်​တို့​ကို​ကြား​ပြော​ကြ​ပါ​လိမ့်​မည်။","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​လည်း​ကိုယ်​တော်​ရှင်​၏ ကြီး​မြတ်​တော်​မူ​ပုံ​ကို​ထုတ်​ဖော်​ကြေညာ​ပါ​မည်။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"သူ​တို့​သည်​ကိုယ်​တော်​ကောင်း​မြတ်​တော်​မူ​ကြောင်း​ကို","poem":1},{"text":"မြွက်​ဆို​၍​ကိုယ်​တော်​ကောင်း​မြတ်​တော်​မူ​ကြောင်း သီ​ချင်း​ဆို​ကြ​ပါ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ချစ်​တတ်​သော​သ​ဘော၊ သည်း​ခံ​တတ်​သော​သ​ဘော​ရှိ​တော်​မူ​၍","poem":1},{"text":"ခိုင်​မြဲ​သော​မေတ္တာ​တော်​နှင့်​ကြွယ်​ဝ​တော် မူ​၏။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ကိုယ်​တော်​သည်​လူ​တိုင်း​ကို​ကျေး​ဇူး​ပြု​တော် မူ​၍","poem":1},{"text":"မိ​မိ​ဖန်​ဆင်း​တော်​မူ​သ​မျှ​သော​သတ္တ​ဝါ​တို့ အား က​ရု​ဏာ​ထား​တော်​မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​ဖန်​ဆင်း​တော်​မူ​သ​မျှ​သော","poem":2},{"text":"သတ္တ​ဝါ​တို့​သည်​ကိုယ်​တော်​ရှင်​အား​ထော​မ​နာ ပြု​ကြ​ပါ​လိမ့်​မည်။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​၏​လူ​စု​တော်​သည်​ကျေး​ဇူး တော်​ကို ချီး​မွမ်း​ကြ​ပါ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"သူ​တို့​သည်​ကိုယ်​တော်​ရှင်​၏​ဘုန်း​အ​သ​ရေ တော်​နှင့်","poem":1},{"text":"အာ​နု​ဘော်​တော်​အကြောင်း​ကို​ပြော​ကြား ပါ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ဤ​နည်း​အား​ဖြင့်​လူ​အ​ပေါင်း​တို့​သည်​ကိုယ်​တော် ရှင်​၏ မ​ဟာ​အ​မှု​တော်​တို့​ကို​လည်း​ကောင်း၊","poem":1},{"text":"နိုင်​ငံ​တော်​၏​ဘုန်း​အ​သ​ရေ​တော်​ကို​လည်း ကောင်း သိ​ရှိ​ကြ​ပါ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ကိုယ်​တော်​ရှင်​၏​နိုင်​ငံ​တော်​သည်​နိစ္စ​ထာ​ဝ​ရ တည်​တော်​မူ​ပါ​၏။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​လည်း​ထာ​ဝ​ရ​ဘု​ရင် ဖြစ်​တော်​မူ​ပါ​၏။","poem":2},{"lineBreak":true},{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​မိ​မိ​၏​က​တိ​တော်​တို့​ကို တည်​စေ​တော်​မူ​၍","poem":1},{"text":"ပြု​တော်​မူ​သ​မျှ​သော​အ​မှု​တို့​တွင်​မေတ္တာ​တော်​ကို ဖော်​ပြ​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ကိုယ်​တော်​သည်​ဒုက္ခ​ရောက်​သူ​အ​ပေါင်း​ကို ကူ​မ​တော်​မူ​၏။","poem":1},{"text":"လဲ​ကျ​နေ​သူ​အ​ပေါင်း​ကို​ကူ​မ​တော်​မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"သက်​ရှိ​သတ္တ​ဝါ​အ​ပေါင်း​တို့​သည်​ကိုယ်​တော်​ကို မျှော်​ကြည့်​ကြ​၏။","poem":1},{"text":"ကိုယ်​တော်​သည်​သူ​တို့​ကို​အ​ချိန်​တန်​လျှင် ကျွေး​မွေး​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ကိုယ်​တော်​သည်​သူ​တို့​၏​လို​အင်​များ​ကို လုံ​လောက်​စွာ","poem":1},{"text":"ဖြည့်​တင်း​ပေး​ကာ​သူ​တို့​ကို​ရောင့်​ရဲ​စေ​တော်​မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ပြု​လေ​သ​မျှ​သော","poem":1},{"text":"အ​မှု​တို့​တွင်​ဖြောင့်​မတ်​ခြင်း​နှင့်​က​ရု​ဏာ တော်​ကို ဖော်ပြ​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ကိုယ်​တော်​သည်​မိ​မိ​အား​စိတ်​ရော​ကိုယ်​ပါ","poem":1},{"text":"ပတ္ထ​နာ​ပြု​ကြ​သူ​အ​ပေါင်း​တို့​၏​အ​နီး​တွင် ရှိ​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ကိုယ်​တော်​သည်​မိ​မိ​အား","poem":1},{"text":"ကြောက်​ရွံ့​ရို​သေ​သူ​အ​ပေါင်း​တို့​၏​လို​အင် များ​ကို ဖြည့်​တင်း​ပေး​တော်​မူ​၏။","poem":2},{"text":"သူ​တို့​၏​ဟစ်​အော်​သံ​ကို​ကြား​တော်​မူ​၍ သူ​တို့​အား​ကယ်​တော်​မူ​၏။","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​သည်​မိ​မိ​အား​ချစ်​သော​သူ​အ​ပေါင်း တို့​ကို ကာ​ကွယ်​စောင့်​ရှောက်​တော်​မူ​၏။","poem":1},{"text":"သူ​ယုတ်​မာ​အ​ပေါင်း​တို့​ကို​မူ​ကား သုတ်​သင်​တော်​မူ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ငါ​သည်​ထာ​ဝ​ရ​ဘု​ရား​အား​အ​စဉ်​အ​မြဲ ထော​မ​နာ​ပြု​မည်။","poem":1},{"text":"သတ္တ​ဝါ​အ​ပေါင်း​တို့​သည်​ကိုယ်​တော်​၏","poem":2},{"text":"သန့်​ရှင်း​မြင့်​မြတ်​သည့်​နာ​မ​တော်​အား ကာ​လ အ​စဉ်​အ​ဆက်​ထော​မ​နာ​ပြု​ကြ​ပါ​စေ။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}