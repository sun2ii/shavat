{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":147,"content":[{"type":"heading","content":["အ​နန္တ​တန်​ခိုး​ရှင်​ဘု​ရား​သခင်​အား ထော​မ​နာ​ပြု​ခြင်း"]},{"type":"verse","number":1,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​အား​ထော​မ​နာ​ပြု​ကြ​လော့။","poem":1},{"text":"ငါ​တို့​၏​ဘု​ရား​အား​ထော​မ​နာ သီ​ချင်း​ဆို​ခြင်း​သည်​မွန်​မြတ်​ပါ​ပေ​သည်။","poem":2},{"text":"ကိုယ်​တော်​ကို​ထော​မ​နာ​ပြု​ရ​ခြင်း​သည် မှန်​ကန်​လျောက်​ပတ်​ဖွယ်​ကောင်း​ပါ​ပေ​သည်။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ယေ​ရု​ရှ​လင်​မြို့​ကို","poem":1},{"text":"ပြန်​လည်​ထူ​ထောင်​လျက်​တိုင်း​တစ်​ပါး​တွင် နေ​ကြ​ရ​သူ","poem":2},{"text":"ဣသ​ရေ​လ​အ​မျိုး​သား​တို့​အား​ပြန်​လည် ခေါ်​ဆောင်​လာ​တော်​မူ​၏။","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"စိတ်​နှလုံး​ကြေ​ကွဲ​သူ​တို့​ကို​နှစ်​သိမ့်​စေ​တော် မူ​၍","poem":1},{"text":"သူ​တို့​၏​ဒဏ်​ရာ​ဒဏ်​ချက်​များ​ကို​ပတ်​စည်း တော်​မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ကိုယ်​တော်​သည်​ကြယ်​တာ​ရာ​များ​၏​အ​ရေ အ​တွက်​ကို","poem":1},{"text":"သတ်​မှတ်​တော်​မူ​၍​ကြယ်​တစ်​လုံး​စီ​ကို​နာ​မည် မှည့်​ခေါ်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ငါ​တို့​၏​ဘု​ရား​ရှင်​သည်​ကြီး​မြတ်​တော်​မူ​၍ တန်​ခိုး​နှင့်​ပြည့်​စုံ​တော်​မူ​၏။","poem":1},{"text":"ကိုယ်​တော်​၏​ဉာဏ်​ပ​ညာ​တော်​ကို​တိုင်း​ထွာ​၍ မ​ရ​နိုင်​ပါ။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ကိုယ်​တော်​သည်​နိမ့်​ကျ​သူ​တို့​ကို​ထူ​ပင့်​တော် မူ​၍","poem":1},{"text":"ယုတ်​မာ​သူ​တို့​ကို​မူ​မြေ​သို့​တိုင်​အောင်​လဲ​ကျ စေ​တော်​မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ထော​မ​နာ​သီ​ချင်း​များ​ကို​ဆို​၍​ထာ​ဝ​ရ ဘု​ရား​၏ ဂုဏ်​တော်​ကို​ချီး​မွမ်း​ကြ​လော့။","poem":1},{"text":"စောင်း​ကို​တီး​၍​ဂီ​တ​သံ​ဖြင့်​ငါ​တို့​ဘု​ရား အား ဂုဏ်​တော်​ကို​ချီး​မွမ်း​ကြ​လော့။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ကိုယ်​တော်​သည်​ကောင်း​ကင်​ပြင်​ကို​မိုး​တိမ် များ​ဖြင့် ဖုံး​လွှမ်း​တော်​မူ​၏။","poem":1},{"text":"ကမ္ဘာ​မြေ​ကြီး​ပေါ်​သို့​မိုး​ရွာ​စေ​တော်​မူ​၍","poem":2},{"text":"တောင်​ကုန်း​များ​တွင်​မြက်​များ​ကို​ပေါက်​စေ တော်​မူ​၏။","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​သည်​တိ​ရစ္ဆာန်​များ​အား အ​စာ​ရေ​စာ​ကို​ပေး​တော်​မူ​၏။","poem":1},{"text":"ကျီး​သား​ငယ်​တို့​အော်​သော​အ​ခါ ကျွေး​မွေး​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ကိုယ်​တော်​သည်​ခွန်​အား​ကြီး​မား​သော​မြင်း​တို့ ကို​သော်​လည်း​ကောင်း၊","poem":1},{"text":"ရဲ​စွမ်း​သတ္တိ​ရှိ​သော​စစ်​သည်​တို့​ကို​လည်း​ကောင်း နှစ်​သက်​တော်​မူ​သည်​မဟုတ်။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"သို့​ရာ​တွင်​မိ​မိ​အား​ကြောက်​ရွံ့​ရို​သေ​သူ​များ၊","poem":1},{"text":"ခိုင်​မြဲ​သော​မေတ္တာ​တော်​ကို​ကိုး​စား​သူ​များ ကို နှစ်​သက်​တော်​မူ​ပေ​သည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"အို ယေ​ရု​ရှ​လင်​မြို့၊ထာ​ဝ​ရ​ဘု​ရား​အား ထော​မ​နာ​ပြု​လော့။","poem":1},{"text":"အို ဇိ​အုန်​မြို့၊သင်​၏​ဘု​ရား​ကို​ထော​မ​နာ​ပြု လော့။","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ကိုယ်​တော်​သည်​သင်​၏​မြို့​တံ​ခါး​ကို​ခိုင်​ခံ့ စေ​တော်​မူ​၍","poem":1},{"text":"သင်​၏​မြို့​သူ​မြို့​သား​တို့​ကို​ကောင်း​ချီး​ပေး တော်​မူ​၏။","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ကိုယ်​တော်​သည်​သင်​၏​မြို့​တံ​ခါး​ကို​ဘေး​မဲ့ လုံ​ခြုံ​စွာ​ထား​တော်​မူ​၍","poem":1},{"text":"သင့်​အား​အ​ကောင်း​ဆုံး​သော​ဂျုံ​ဆန်​ဖြင့် ရောင့်​ရဲ​စေ​တော်​မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ကိုယ်​တော်​သည်​ကမ္ဘာ​မြေ​ကြီး​အား အ​မိန့်​ပေး​တော်​မူ​၏။","poem":1},{"text":"ထို​အ​မိန့်​တော်​အ​တိုင်း​လျင်​မြန်​စွာ​ဖြစ် ပျက်​လာ​၏။","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ကိုယ်​တော်​သည်​သိုး​မွေး​သ​ဖွယ်​ထူ​ထပ်​သော မိုး​ပွင့်​များ​ကို​ကျ​စေ​တော်​မူ​၍","poem":1},{"text":"ပြာ​မှုန့်​သ​ဖွယ်​ဆီး​နှင်း​ခဲ​များ​ကို​ကြဲ​ချ တော်​မူ​၏။","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ကိုယ်​တော်​သည်​မိုး​သီး​များ​ကို​မုန့်​ကျိုး မုန့်​ပဲ့​များ​သ​ဖွယ်​ကျ​စေ​တော်​မူ​၏။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​စေ​လွှတ်​တော်​မူ​လိုက်​သည့် အ​အေး​ဋ္ဌာတ်​ကို​အ​ဘယ်​သူ​မျှ​မ​ခံ နိုင်​ပေ။","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ထို​နောက်​ကိုယ်​တော်​သည်​အ​မိန့်​ပေး​တော်​မူ​သ​ဖြင့် ရေ​ခဲ​သည်​အ​ရည်​ပျော်​လေ​၏။","poem":1},{"text":"လေ​ကို​တိုက်​စေ​တော်​မူ​သ​ဖြင့် ရေ​သည်​စီး​ဆင်း​လေ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ကိုယ်​တော်​သည်​နှုတ်​က​ပတ်​တော်​ကို​မိ​မိ လူ​စု​တော်​အား​လည်း​ကောင်း၊","poem":1},{"text":"အ​ထုံး​အ​ဖွဲ့​တော်​နှင့်​ပ​ညတ်​တော်​များ​ကို ဣသ​ရေ​လ​အား​လည်း​ကောင်း​ပေး​အပ်​တော် မူ​၏။","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ကိုယ်​တော်​သည်​အ​ခြား​လူ​မျိုး​တို့​အ​တွက် ဤ​သို့​ပြု​တော်​မ​မူ။","poem":1},{"text":"သူ​တို့​သည်​ကိုယ်​တော်​၏​ပ​ညတ်​တော်​များ​ကို မ​သိ​ရ​ကြ။","poem":2},{"lineBreak":true},{"text":"ထာ​ဝ​ရ​ဘု​ရား​အား​ထော​မ​နာ​ပြု​ကြ​လော့။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}