{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":16,"content":[{"type":"heading","content":["အ​နာ​ဂတ်​အ​တွက်​ယုံ​ကြည်​မျှော်​လင့်​ချက်16:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင်​၏​ထံ​တော်​တွင် ခို​လှုံ​ပါ​၏။","poem":2},{"text":"သို့​ဖြစ်​၍​ကျွန်​တော်​မျိုး​အား​ကွယ်​ကာ​စောင့်​ရှောက် တော်​မူ​ပါ။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"``ကိုယ်​တော်​သည်​ကျွန်​တော်​မျိုး​၏​အ​ရှင် ဖြစ်​တော်​မူ​ပါ​၏။","poem":1},{"text":"ကျွန်​တော်​မျိုး​ခံ​စား​ရ​သော​ကောင်း​ကျိုး​ချမ်း​သာ ဟူ​သ​မျှ​သည်","poem":2},{"text":"ကိုယ်​တော်​ပေး​သ​နား​တော်​မူ​သော​အ​ရာ​များ ဖြစ်​ပါ​၏'' ဟု","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​အား​ငါ​လျှောက်​ထား​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​ကို​သစ္စာ​စောင့်​သော​လူ​စု တော်​သည် ထူး​မြတ်​လှ​ပါ​သည်​တ​ကား။","poem":1},{"text":"ငါ​၏​အ​နှစ်​သက်​ဆုံး​အ​ရာ​သည်​ထို​သူ​တို့ နှင့်​အ​တူ နေ​ထိုင်​ခွင့်​ပင်​ဖြစ်​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"အ​ခြား​ဘု​ရား​များ​အား​ဆည်း​ကပ်​ကိုး​ကွယ် ကြ​သော","poem":1},{"text":"သူ​တို့​သည်​များ​စွာ​ဆင်း​ရဲ​ဒုက္ခ​ရောက်​ကြ​ရ လိမ့်​မည်။","poem":2},{"text":"ငါ​သည်​သူ​တို့​၏​ယဇ်​ပူ​ဇော်​မှု​များ​တွင် ပါ​ဝင်​လိမ့်​မည်​မ​ဟုတ်။","poem":1},{"text":"သူ​တို့​၏​ဘု​ရား​များ​ကို​လည်း​ကိုး​ကွယ် ဆည်း​ကပ် လိမ့်​မည်​မ​ဟုတ်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"အို ထာ​ဝ​ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​မှီ​ခို​ရာ​ကိုယ်​တော်​ရှင်​တစ်​ပါး သာ​လျှင် ရှိ​ပါ​၏။","poem":2},{"text":"ကျွန်​တော်​မျိုး​လို​သော​အ​ရာ​ရှိ​သ​မျှ​တို့​ကို​လည်း ကိုယ်​တော်​ရှင်​ပေး​တော်​မူ​ပါ​၏။","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​အ​နာ​ဂတ်​သည်​ကိုယ်​တော်​၏ လက်​ဝယ်​ရှိ​ပါ​၏။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ကျွန်​တော်​မျိုး​အား​ကိုယ်​တော်​ရှင်​ပေး​တော်​မူ​သော","poem":1},{"text":"ဆု​ကျေး​ဇူး​တော်​များ​သည် အံ့​သြ​ဖွယ်​ကောင်း​လှ​ပါ​သည်။","poem":2},{"text":"ယင်း​တို့​သည်​ကောင်း​မြတ်​လှ​ပါ​သည်​တ​ကား။","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်","poem":1},{"text":"ငါ့​ကို​လမ်း​ပြ​ပို့​ဆောင်​တော်​မူ​သ​ဖြင့် ငါ​သည်​ကိုယ်​တော်​အား​ထော​မ​နာ​ပြု​၏။","poem":2},{"text":"ငါ​၏​သြတ္တပ္ပ​စိတ်​သည်​ညဥ့်​အ​ခါ​ငါ့​ကို သ​တိ​ပေး​နှိုး​ဆော်​တတ်​၏။","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ငါ​နှင့်​အ​တူ​ရှိ​တော် မူ​သည်​ကို ငါ​အ​စဉ်​သိ​၏။","poem":1},{"text":"ကိုယ်​တော်​သည်​ငါ​၏​အ​နီး​၌​ရှိ​တော်​မူ​သ​ဖြင့်","poem":2},{"text":"အ​ဘယ်​အ​ရာ​မျှ​ငါ့​ကို​တုန်​လှုပ်​စေ​နိုင်​မည် မ​ဟုတ်​ပါ။","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"သို့​ဖြစ်​၍​ကျွန်​တော်​မျိုး​သည်​ရွှင်​လန်း​ဝမ်း​မြောက် ပါ​၏။","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​ဘေး​ကင်း​လုံ​ခြုံ​လျက်​ရှိ​ပါ​၏။","poem":2}]},{"type":"verse","number":10,"content":[{"text":"အ​ဘယ်​ကြောင့်​ဆို​သော်​ကိုယ်​တော်​ရှင်​သည် ကျွန်​တော်​မျိုး​အား​မ​ရ​ဏာ​နိုင်​ငံ​သို့​လား​ရန်","poem":1},{"text":"အ​ခွင့်​ပေး​တော်​မူ​မည်​မ​ဟုတ်​သော​ကြောင့်​တည်း။","poem":2},{"text":"ကျွန်​တော်​မျိုး​သည်​အ​မှု​တော်​ကို​သစ္စာ​ရှိ​စွာ ထမ်း​ခဲ့​ပါ​၏။","poem":1},{"text":"ကွန်​တော်​မျိုး​အား​သေ​မင်း​၏​လက်​သို့ အပ်​တော်​မူ​မည်​မ​ဟုတ်​ပါ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​အား​အ​သက်​ရှင်​ရာ လမ်း​ကို​ပြ​ညွှန်​တော်​မူ​လိမ့်​မည်။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​၏​အ​နီး​တွင် ရှိ​တော်​မူ​သည်​ဖြစ်​၍","poem":2},{"text":"ကျွန်​တော်​မျိုး​သည်​ရွှင်​လန်း​ဝမ်း​မြောက်​၍ ထာ​ဝ​စဉ်​ပျော်​မွေ့​လျက်​ရှိ​ပါ​၏။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}