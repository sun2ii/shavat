{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":17,"content":[{"type":"heading","content":["အ​ပြစ်​ကင်း​သူ​တစ်​ဦး​၏​ဆု​တောင်း​ပတ္ထ​နာ17:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သော​ဆု​တောင်း​ပတ္ထ​နာ။"]},{"type":"verse","number":1,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"တ​ရား​မျှ​တ​မှု​ရ​ရန်​အ​တွက်​ကျွန်​တော်​မျိုး ပန်​ကြား​သည်​ကို​နား​ထောင်​တော်​မူ​ပါ။","poem":2},{"text":"ကူ​မ​တော်​မူ​ရန်​ကျွန်​တော်​မျိုး​အော်​ဟစ်​သံ​ကို ဂ​ရု​ပြု​တော်​မူ​ပါ။","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​ရိုး​ဖြောင့်​စွာ တောင်း​လျှောက်​သည်​ဖြစ်​၍","poem":2},{"text":"ကျွန်​တော်​မျိုး​၏​ဆု​တောင်း​ပတ္ထ​နာ​ကို နား​ထောင်​တော်​မူ​ပါ။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​သည်​အ​မှန်​တ​ရား​ကို​သိ​မြင်​တော် မူ​သ​ဖြင့်","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​အ​ကျိုး​ကို​ထောက်​၍ တ​ရား​စီ​ရင်​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ကိုယ်​တော်​သည်​ကျွန်​တော်​မျိုး​၏​စိတ်​နှ​လုံး​ကို သိ​တော်​မူ​ပါ​၏။","poem":1},{"text":"ညဥ့်​အ​ခါ​၌​ကျွန်​တော်​မျိုး​ထံ​သို့​ကြွ​လာ​၍","poem":2},{"text":"ကျွန်​တော်​မျိုး​၏​စိတ်​နှ​လုံး​ကို​သေ​ချာ​စွာ စစ်​ဆေး​ကြည့်​တော်​မူ​သော​အ​ခါ","poem":1},{"text":"ဆိုး​ယုတ်​သော​အ​ကြံ​အ​စည်​ကို​တွေ့​ရှိ​တော် မ​မူ​ပါ။","poem":2},{"text":"ကျွန်​တော်​မျိုး​သည်​အ​ခြား​သူ​တို့​ကဲ့​သို့ ညစ်​ညမ်း​သည့် စ​ကား​ကို​မ​ပြော​မ​ဆို​ပါ။","poem":1},{"text":"ကိုယ်​တော်​၏​ပ​ညတ်​တော်​ကို​လိုက်​လျှောက်​ပါ​၏။ အ​ဋ္ဌမ္မ​လမ်း​စဉ်​ကို​မ​လိုက်​မ​လျှောက်​ခဲ့​ပါ။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ကိုယ်​တော်​၏​လမ်း​စဉ်​ကို​သာ​လိုက်​လျှောက်​ခဲ့​ပါ​၏။ ထို​လမ်း​စဉ်​မှ​မ​တိမ်း​မ​စောင်း​ခဲ့​ပါ။","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​နား​ညောင်း​တော်​မူ တတ်​သည်​ဖြစ်​၍","poem":2},{"text":"ကျွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင်​အား ဆု​တောင်း​ပတ္ထ​နာပြု​ပါ​၏။","poem":1},{"text":"သို့​ဖြစ်​၍​ကျွန်​တော်​မျိုး​ဘက်​သို့​လှည့်​တော်​မူ​၍","poem":2},{"text":"ကျွန်​တော်​မျိုး​၏​ပတ္ထ​နာ​စ​ကား​များ​ကို နား​ထောင်​တော်​မူ​ပါ။","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​၏​အံ့​သြ​ဖွယ်​မေတ္တာ​တော်​ကို ပေါ်​လွင်​ထင်​ရှား​စေ​တော်​မူ​၍","poem":1},{"text":"ကျွန်​တော်​မျိုး​ကို​ကယ်​တင်​တော်​မူ​ပါ။","poem":2},{"text":"ကိုယ်​တော်​၏​ထံ​တော်​ပါး​တွင်​ကျွန်​တော်​မျိုး​သည် ရန်​သူ​များ​၏​ဘေး​မှ​ကင်း​လွတ်​လုံ​ခြုံ​ခွင့် ရ​ရှိ​ပါ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ကိုယ်​တော်​၏​မျက်​ဆန်​တော်​ကဲ့​သို့​ကျွန်​တော်​မျိုး​ကို စောင့်​ရှောက်​တော်​မူ​ပါ။","poem":1},{"text":"သူ​ယုတ်​မာ​တို့​၏​တိုက်​ခိုက်​မှု​မှ​ကျွန်​တော်​မျိုး​ကို","poem":2},{"text":"ကိုယ်​တော်​၏​အ​တောင်​တော်​ရိပ်​အောက်​၌ ဖုံး​အုပ်​တော်​မူ​ပါ။","poem":1},{"lineBreak":true},{"text":"အ​သက်​အန္တ​ရာယ်​ကို​ရှာ​ကြံ​သော​ရန်​သူ​များ သည် ကျွန်​တော်​မျိုး​ကို​ဝိုင်း​ရံ​လျက်​နေ​ကြ​ပါ​၏။","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"သူ​တို့​သည်​သ​နား​ကြင်​နာ​စိတ်​ကင်း​မဲ့​လျက် မာန်​မာ​န​ထောင်​လွှား​၍​ပြော​ဆို​နေ​ကြ​ပါ​၏။","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"သူ​တို့​သည်​ကျွန်​တော်​မျိုး​သွား​လေ​ရာ​တွင်","poem":1},{"text":"ကျွန်​တော်​မျိုး​အား​အ​လဲ​ထိုး​ရန် စောင့်​မျှော်​ဝိုင်း​ရံ​လျက်​နေ​ကြ​ပါ​၏။","poem":2}]},{"type":"verse","number":12,"content":[{"text":"သူ​တို့​သည်​ခြင်္သေ့​များ​ကဲ့​သို့​ကျွန်​တော်​မျိုး​အား","poem":1},{"text":"အ​ပိုင်း​ပိုင်း​ဆုတ်​ဖြဲ​လို​ကြ​၍​ကျွန်​တော်​မျိုး​ကို ချောင်း​မြောင်း​နေ​ကြ​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊ ကြွ​လာ​တော်​မူ​ပါ။","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​ရန်​သူ​များ​ကို​တွန်း​လှန် ဖြို​ခွင်း​တော်​မူ​ပါ။","poem":2},{"text":"ကိုယ်​တော်​ဋ္ဌား​တော်​ဖြင့်​သူ​ယုတ်​မာ​တို့​၏​လက်​မှ ကျွန်​တော်​မျိုး​အား​ကယ်​တော်​မူ​ပါ။","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ဤ​ဘ​ဝ​တွင်​အလို​ဆန္ဒ​ရှိ​သ​မျှ​အ​တိုင်း","poem":1},{"text":"ပြည့်​ဝ​ကြ​သူ​တို့​၏​လက်​မှ​ကျွန်​တော်​မျိုး​အား ကယ်​တော်​မူ​ပါ။","poem":2},{"text":"သူ​တို့​အ​တွက်​ကိုယ်​တော်​သို​မှီး​ထား​သည့် ဆင်း​ရဲ​ဒုက္ခ​များ​အား​ဖြင့်","poem":1},{"text":"သူ​တို့​အား​အ​ပြစ်​ဒဏ်​စီ​ရင်​တော်​မူ​ပါ။","poem":2},{"text":"ဤ​ဆင်း​ရဲ​ဒုက္ခ​များ​ကို​သူ​တို့​၏ သား​သ​မီး​များ​သည်​သာ​မ​က","poem":1},{"text":"သူ​တို့​၏​မြေး​မြစ်​များ​သည်​လည်း ခံ​စား​ရ​စေ​တော်​မူ​ပါ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ကျွန်​တော်​မျိုး​သည်​အ​ပြစ်​မ​ကူး​လွန်​ခဲ့​သ​ဖြင့် ကိုယ်​တော်​ရှင်​ကို​ဖူး​မြင်​ရ​ပါ​လိမ့်​မည်။","poem":1},{"text":"ကျွန်​တော်​မျိုး​အိပ်​ရာ​မှ​နိုး​ထ​သော​အ​ခါ​၌","poem":2},{"text":"ကိုယ်​တော်​ရှင်​ကျွန်​တော်​မျိုး​နှင့်​အ​တူ​ရှိ​တော် မူ​သ​ဖြင့် ရွှင်​လန်း​ဝမ်း​မြောက်​ရ​ပါ​လိမ့်​မည်။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":13}