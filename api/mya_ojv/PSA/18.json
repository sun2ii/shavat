"poem":1},{"text":"သို့​သော်​လည်း​ထာ​ဝ​ရ​ဘု​ရား​သည်​ငါ့​ကို ကွယ်​ကာ​စောင့်​ရှောက်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ငါ​ဘေး​ရောက်​သော​အ​ခါ​ကိုယ်​တော်​သည် ငါ့​ကို​ကူ​မ​တော်​မူ​၏။","poem":1},{"text":"ငါ့​ကို​နှစ်​သက်​တော်​မူ​သ​ဖြင့်​ကယ်​တော်​မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ငါ​သည်​မှန်​ရာ​ကို​ပြု​သ​ဖြင့်​ကိုယ်​တော်​သည် ငါ့​အား​ကောင်း​ကျိုး​ကို​ချ​ပေး​တော်​မူ​၏။","poem":1},{"text":"ငါ​သည်​အ​ပြစ်​ကင်း​သူ​ဖြစ်​၍​ကောင်း​ချီး ပေး​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ငါ​သည်​ထာ​ဝ​ရ​ဘု​ရား​၏​ပ​ညတ်​တော်​ကို လိုက်​လျှောက်​ခဲ့​၏။","poem":1},{"text":"ငါ​၏​ဘု​ရား​ထံ​တော်​မှ​ရှောင်​ခွာ​၍​မ​သွား ခဲ့​ပါ။","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ငါ​သည်​ကိုယ်​တော်​၏​ပ​ညတ်​တော်​ရှိ​သ​မျှ​ကို စောင့်​ထိန်း​ခဲ့​၏။","poem":1},{"text":"ကိုယ်​တော်​၏​အ​မိန့်​တော်​တို့​ကို​မ​ဖီ​ဆန်​ခဲ့​ပါ။","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ငါ​သည်​အပြစ်​မဲ့​သူ​ဖြစ်​ကြောင်း​ကို​လည်း ကောင်း၊","poem":1},{"text":"ဒု​စ​ရိုက်​ရှောင်​ကြဉ်​ကြောင်း​ကို​လည်း​ကောင်း ကိုယ်​တော်​သိ​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ငါ​သည်​အ​ပြစ်​ကင်း​သူ​ဖြစ်​ကြောင်း​ကို သိ​တော်​မူ​သ​ဖြင့်​လည်း​ကောင်း၊","poem":1},{"text":"ငါ​သည်​တ​ရား​မျှ​တ​စွာ​ပြု​ကျင့်​သ​ဖြင့် လည်း​ကောင်း","poem":2},{"text":"ကိုယ်​တော်​သည်​ငါ့​အား​ကောင်း​ကျိုး​ကို ပေး​သ​နား​တော်​မူ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​သည်​သစ္စာ​ရှိ​သူ​တို့​အား သစ္စာ​စောင့်​တော်​မူ​၏။","poem":2},{"text":"အ​ပြစ်​ဆို​ဖွယ်​မ​ရှိ​အောင်​ကောင်း​မြတ်​သူ​တို့ အား အ​ကြွင်း​မဲ့​ကျေး​ဇူး​ပြု​တော်​မူ​တတ်​ပါ​၏။","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"စိတ်​နှ​လုံး​ဖြူ​စင်​သူ​တို့​အား​ဖြူ​စင်​သော စိတ်​သ​ဘော​ထား​ကို​လည်း​ကောင်း၊","poem":1},{"text":"သူ​ယုတ်​မာ​တို့​အား​ရန်​လို​သော​စိတ်​သ​ဘော ကို​လည်း​ကောင်း​ပြ​တော်​မူ​ပါ​၏။","poem":2}]},{"type":"verse","number":2