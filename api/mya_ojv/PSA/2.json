{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":2,"content":[{"type":"heading","content":["ဘု​ရား​သ​ခင်​ရွေး​ချယ်​တော်​မူ​သော​ဘု​ရင်"]},{"type":"verse","number":1,"content":[{"text":"တိုင်း​နိုင်​ငံ​တို့​သည်​အ​ဘယ်​ကြောင့်​ဆူ​ပူ​ပုန်​ကန်​ရန် ကြံ​စည်​ကြ​သ​နည်း။","poem":1},{"text":"လူ​တို့​သည်​အ​ဘယ်​ကြောင့်​အ​ချည်း​နှီး လျှို့​ဝှက်​ကြံ​စည်​ကြ​သ​နည်း။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ထို​သူ​တို့​၏​ဘု​ရင်​တို့​သည်​ပုန်​ကန်​ကြ​၏။","poem":1},{"text":"သူ​တို့​၏​ဘု​ရင်​တို့​သည်​ထာ​ဝ​ရ​ဘု​ရား​နှင့်","poem":2},{"text":"ကိုယ်​တော်​ဘိ​သိက်​ပေး​တော်​မူ​သော​ဘု​ရင်​အား ပုန်​ကန်​ရန်​လျှို့​ဝှက်​တိုင်​ပင်​ကြ​၏။","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"သူ​တို့​က``ငါ​တို့​သည်​သူ​တို့​စိုး​မိုး​မှု​မှ လွတ်​မြောက်​အောင်​ဆောင်​ရွက်​ကြ​ကုန်​အံ့။","poem":1},{"text":"သူ​တို့​၏​အ​ချုပ်​အ​နှောင်​ကို​ပယ်​ရှား​ကြ ကုန်​အံ့'' ဟု​ဆို​ကြ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ကောင်း​ကင်​ဘုံ​ရှိ​ပလ္လင်​တော်​ပေါ်​မှာ​ထာ​ဝ​ရ ဘု​ရား​သည် ပြုံး​ရယ်​တော်​မူ​လျက်","poem":1},{"text":"ထို​သူ​တို့​၏​အ​ကြံ​အ​စည်​ကို​ပြက်​ရယ်​ပြု တော်​မူ​၏။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ထို​နောက်​ကိုယ်​တော်​သည်​အ​မျက်​တော်​ထွက် လျက် သူ​တို့​အား​သ​တိ​ပေး​တော်​မူ​သ​ဖြင့်","poem":1},{"text":"သူ​တို့​သည်​အ​မျက်​တော်​အ​ရှိန်​ကြောင့် ကြောက်​လန့်​တုန်​လှုပ်​ကြ​ကုန်​၏။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ကိုယ်​တော်​က``သန့်​ရှင်း​မြင့်​မြတ်​သော ဇိ​အုန်​တောင်","poem":1},{"noteId":0},{"text":"ပေါ်​တွင်","poem":1},{"text":"ငါ​ရွေး​ချယ်​ထား​သော​ရှင်​ဘု​ရင်​ကို​ငါ​ကိုယ်​တိုင် တင်​မြှောက်​ပြီ'' ဟု​မိန့်​တော်​မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"မင်း​ကြီး​က``ထာ​ဝ​ရ​ဘု​ရား​၏​ဗျာ​ဒိတ်​တော်​ကို ငါ​ကြေ​ငြာ​မည်။","poem":1},{"text":"ကိုယ်​တော်​က​ငါ့​အား`သင်​သည်​ငါ​၏​သား ဖြစ်​၏။","poem":2},{"text":"ယ​နေ့​ပင်​လျှင်​ငါ​သည်​သင်​၏​အ​ဖ​ဖြစ်​လာ ပြီ။","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"တောင်း​လော့။ လူ​မျိုး​တ​ကာ​တို့​ကို​သင့်​အား ငါ​ပေး​မည်။","poem":1},{"text":"ကမ္ဘာ​မြေ​ပြင်​တစ်​ခု​လုံး​ကို​သင်​ပိုင်​ဆိုင်​ရ လိမ့်​မည်။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"သင်​သည်​လူ​မျိုး​တ​ကာ​တို့​ကို​သံ​လှံ​တံ​ဖြင့် အုပ်​စိုး​လိမ့်​မည်။","poem":1},{"lineBreak":true},{"text":"သူ​တို့​အား​မြေ​အိုး​ကို​ခွဲ​သ​ကဲ့​သို့","poem":1},{"text":"အ​စိတ်​စိတ်​အ​မြွှာ​မြွှာ​ဖြစ်​စေ​လိမ့်​မည်' ဟု မိန့်​တော်​မူ​ပါ​၏'' ဟူ​၍​ဆို​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"အ​ချင်း​ဘု​ရင်​တို့၊ပ​ညာ​သ​တိ​ရှိ​ကြ​လော့။","poem":1},{"text":"အ​ချင်း​မင်း​အ​ပေါင်း​တို့၊သ​တိ​မူ​ကြ​လော့။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"သင်​တို့​သည်​ကြောက်​ရွံ့​ရို​သေ​သော​စိတ်​နှင့်","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​၏​အ​မှု​တော်​ကို​ထမ်း​ရွက်​ကြ​လော့။","poem":2}]},{"type":"verse","number":12,"content":[{"text":"တုန်​လှုပ်​လျက်​ရှေ့​တော်​တွင်​ဦး​ညွှတ်​ပျပ်​ဝပ်​ကြ​လော့။","poem":1},{"text":"ယင်း​သို့​မ​ပြု​ပါ​မူ​ကိုယ်​တော်​သည် အ​မျက်​တော်​ထွက်​တော်​မူ​သ​ဖြင့်","poem":2},{"lineBreak":true},{"text":"သင်​တို့​သည်​မု​ချ​သေ​ကြေ​ပျက်​စီး​ကြ​လိမ့်​မည်။","poem":2},{"text":"ကိုယ်​တော်​ထံ​တော်​သို့​ချဉ်း​ကပ်​ခို​လှုံ​သူ အ​ပေါင်း​တို့​သည်​မင်္ဂ​လာ​ရှိ​ကြ​၏။","poem":1}]}],"footnotes":[{"noteId":0,"caller":"1","text":"* ဇိ​အုန်​တောင်။ မူ​လ​တွင်​ဒါ​ဝိဒ်​၏​မြို့။ ထို​နောက်​ဗိ​မာန် တော်​တည်​ရာ​တောင်​ကို​ဆို​လို​သည်။","reference":{"chapter":2,"verse":6}}]},"thisChapterLink":"/api/mya_ojv/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}