{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":20,"content":[{"type":"heading","content":["အောင်​ပွဲ​ရ​ရန်​ဆု​တောင်း​ပတ္ထနာ20:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သော​ဆာ​လံ"]},{"type":"verse","number":1,"content":[{"text":"ဒုက္ခ​ရောက်​စဉ်​အ​ခါ​အ​ရှင်​မင်း​ကြီး​၏ ပတ္ထ​နာ​ကို","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​နား​ညောင်း​တော်​မူ ပါ​စေ​သော။","poem":2},{"text":"ယာ​ကုပ်​ကိုး​ကွယ်​သော​ဘု​ရား​သ​ခင်​သည် အ​ရှင်​မင်း​ကြီး​အား","poem":1},{"text":"ကွယ်​ကာ​စောင့်​ထိန်း​တော်​မူ​ပါ​စေ​သော။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ကိုယ်​တော်​သည်​အ​ရှင်​မင်း​ကြီး​အား​ဗိ​မာန် တော်​ထဲ​က အ​ကူ​အ​ညီ​ပေး​တော်​မူ​ပါ​စေ​သော။","poem":1},{"text":"ဇိ​အုန်​တောင်​တော်​ပေါ်​မှ​အ​ထောက်​အ​ကူ ပေး​တော်​မူ​ပါ​စေ​သော။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ကိုယ်​တော်​သည်​အ​ရှင်​မင်း​ကြီး​၏​ပူ​ဇော် သ​ကာ ရှိ​သ​မျှ​ကို​လက်​ခံ​တော်​မူ​လျက်","poem":1},{"text":"မီး​ရှို့​ရာ​ယဇ်​အ​ပေါင်း​ကို​လည်း​နှစ်​သက် တော်​မူ​ပါ​စေ​သော။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"အ​ရှင်​မင်း​ကြီး​၏​လို​အင်​ဆန္ဒ​ကို​ပြည့်​ဝ​စေ တော်​မူ​၍","poem":1},{"text":"အ​ကြံ​အ​စည်​ရှိ​သ​မျှ​တို့​ကို​လည်း​အောင် မြင်​စေ​ရန် ကူ​မ​တော်​မူ​ပါ​စေ​သော။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ထို​အ​ခါ​ကျွန်​တော်​မျိုး​တို့​သည်​အ​ရှင်​မင်း ကြီး​၏","poem":1},{"text":"အောင်​ပွဲ​အ​တွက်​ရွှင်​လန်း​ဝမ်း​မြောက်​စွာ ကြွေး​ကြော်​ကြ​ပါ​လိမ့်​မည်။","poem":2},{"text":"ထာ​ဝ​ရ​ဘု​ရား​အား​ထော​မ​နာ​ပြု​လျက် အ​ရှင် မင်း​ကြီး​၏​အောင်​ပွဲ​ကို​ဆင်​နွှဲ​ကြ​ပါ​လိမ့်​မည်။","poem":1},{"text":"ဘု​ရား​သ​ခင်​သည်​အ​ရှင်​မင်း​ကြီး​တောင်း လျှောက် သ​မျှ​ကို​ပေး​သ​နား​တော်​မူ​ပါ​စေ​သော။","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​မိ​မိ​ဘိ​သိက်​ပေး​တော် မူ​သော","poem":1},{"text":"ဘု​ရင်​အား​စစ်​ပွဲ​နိုင်​စေ​တော်​မူ​ကြောင်း​ကို ယ​ခု​ငါ​သိ​၏။","poem":2},{"text":"ကိုယ်​တော်​သည်​မင်း​ကြီး​၏​ပန်​ကြား​ချက်​ကို သန့်​ရှင်း မြင့်​မြတ်​သည့်​ကောင်း​ကင်​ဘုံ​မှ​ကြား​တော်​မူ​၍","poem":1},{"text":"တန်​ခိုး​တော်​ဖြင့်​မင်း​ကြီး​အား​အောင်​ပွဲ​ကြီး များ​ကို ပေး​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"အ​ချို့​သော​သူ​တို့​သည်​မိ​မိ​တို့​၏ စစ်​ရ​ထား​များ​ကို​လည်း​ကောင်း၊","poem":1},{"text":"မြင်း​များ​ကို​လည်း​ကောင်း​အား​ကိုး​ကြ​၏။","poem":2},{"text":"သို့​ရာ​တွင်​ငါ​တို့​မူ​ကား​ငါ​တို့​၏​ဘု​ရား​သ​ခင် ထာ​ဝ​ရ​ဘု​ရား​ကို​အား​ကိုး​ကြ​၏။","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ထို​သူ​တို့​သည်​ခြေ​ချော်​၍​လဲ​ကြ​လိမ့်​မည်။","poem":1},{"text":"ငါ​တို့​မူ​ကား​ထ​၍​ကြံ့​ကြံ့​ခိုင်​ရပ်​တည်​ကြ လိမ့်​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊ မင်း​ကြီး​အား​အောင်​ပွဲ​ကို​ပေး​တော်​မူ​ပါ။","poem":1},{"text":"ကျွန်​တော်​မျိုး​တို့​ခေါ်​သော​အ​ခါ​ထူး​တော်​မူ​ပါ။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}