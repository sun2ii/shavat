{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":21,"content":[{"type":"heading","content":["စစ်​ပွဲ​အောင်​သည့်​အ​တွက်​ထော​မ​နာ​ပြု​ခြင်း21:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​မင်း​ကြီး​အား​ခွန်​အား​စွမ်း ရည်​ကို ပေး​တော်​မူ​သ​ဖြင့်​သူ​သည်​ဝမ်း​မြောက်​ပါ​၏။","poem":2},{"text":"ကိုယ်​တော်​ရှင်​သည်​စစ်​ပွဲ​ကို​အောင်​စေ​တော်​မူ သ​ဖြင့် သူ​သည်​အ​လွန်​အား​ရ​ရွှင်​လန်း​ပါ​၏။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​ရှင်​သည်​သူ​လို​လား​တောင့်​တ​သည့် အ​ရာ​ကို​ပေး​တော်​မူ​ပြီ။","poem":1},{"text":"သူ​၏​ဆု​တောင်း​ပတ္ထ​နာ​ကို​နား​ညောင်း​တော် မူ​ပြီ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ကိုယ်​တော်​ရှင်​သည်​သူ့​အား​မွန်​မြတ်​သော ကောင်း​ချီး​မင်္ဂ​လာ​များ​ကို​ချ​ပေး​တော်​မူ​ပြီ။","poem":1},{"text":"သူ့​အား​ရွှေ​သ​ရ​ဖူ​ကို​ဆောင်း​စေ​တော်​မူ​ပြီ။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"သူ​သည်​အ​သက်​ကို​တောင်း​ခံ​၍​ကိုယ်​တော်​ရှင်​သည် သူ့​အား​အ​သက်​ကို​ပေး​တော်​မူ​သည်​သာ​မ​က","poem":1},{"text":"ရှည်​၍​မ​ကုန်​မ​ဆုံး​နိုင်​သော​အ​သက်​ကို ပေး​တော်​မူ​ပြီ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ကိုယ်​တော်​ရှင်​ကယ်​မ​တော်​မူ​သ​ဖြင့်​မင်း​ကြီး​သည် ဘုန်း​အ​သ​ရေ​ထွန်း​တောက်​ရ​ပါ​၏။","poem":1},{"text":"ကိုယ်​တော်​သည်​သူ့​အား​ကျော်​စော​ကိတ္တိ​နှင့် ခန့်​ညား​တင့်​တယ်​ခြင်း​ကို​ပေး​တော်​မူ​ပြီ။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ကိုယ်​တော်​ရှင်​၏​ကောင်း​ချီး​မင်္ဂ​လာ​များ​သည် သူ​၏​အ​ပေါ်​သို့​အ​စဉ်​သက်​ရောက်​လျက် ရှိ​ပါ​၏။","poem":1},{"text":"သူ​၏​အ​နီး​တွင်​ကိုယ်​တော်​ရှိ​တော်​မူ​သည် ဖြစ်​၍ သူ​သည်​ရွှင်​လန်း​ဝမ်း​မြောက်​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"မင်း​ကြီး​သည်​အ​နန္တ​တန်​ခိုး​ရှင်​ထာ​ဝ​ရ​ဘု​ရား ကို ယုံ​ကြည်​ကိုး​စား​ပါ​၏။","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​၏​ခိုင်​မြဲ​သော​မေ​တ္တာ​ကြောင့် သူ​သည် ဘေး​မဲ့​လုံ​ခြုံ​တော်​မူ​ပါ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"မင်း​ကြီး​သည်​မိ​မိ​၏​ရန်​သူ​အ​ပေါင်း​ကို ဖမ်း​ဆီး​တော်​မူ​လိမ့်​မည်။","poem":1},{"text":"ကိုယ်​တော်​အား​မုန်း​သော​သူ​အ​ပေါင်း​တို့​ကို လက်​ရ​ဖမ်း​ဆီး​တော်​မူ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ကိုယ်​တော်​ကြွ​လာ​တော်​မူ​သော​အ​ခါ","poem":1},{"text":"အ​လျှံ​ထ​လျက်​နေ​သော​မီး​သ​ဖွယ် သူ​တို့​အား​ဖျက်​ဆီး​တော်​မူ​လိမ့်​မည်။","poem":2},{"lineBreak":true},{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​အ​မျက်​တော်​ထွက်​၍ သူ​တို့​အား​ဖျက်​ဆီး​ပစ်​တော်​မူ​လိမ့်​မည်။","poem":1},{"text":"သူ​တို့​သည်​မီး​တွင်​ကျွမ်း​လောင်​ကုန်​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":10,"content":[{"text":"မင်း​ကြီး​သည်​သူ​တို့​၏​သား​သ​မီး​အ​ပေါင်း ကို သေ​ကြေ​ပျက်​စီး​စေ​တော်​မူ​လိမ့်​မည်။","poem":1},{"text":"သူ​တို့​၏​အ​မျိုး​အ​နွယ်​အ​ပေါင်း​ကို သုတ်​သင်​တော်​မူ​လိမ့်​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"သူ​တို့​သည်​မင်း​ကြီး​ကို​လုပ်​ကြံ​ရန်​မ​သ​မာ သော အ​ကြံ​အ​စည်​များ​ကို​ပြု​ကြ​၏။","poem":1},{"text":"သို့​ရာ​တွင်​အောင်​မြင်​ကြ​လိမ့်​မည်​မဟုတ်။","poem":2}]},{"type":"verse","number":12,"content":[{"text":"မင်း​ကြီး​သည်​လေး​နှင့်​ခွင်း​တော်​မူ​လျက် သူ​တို့​အား တပ်​ခေါက်​၍​ထွက်​ပြေး​စေ​တော်​မူ​လိမ့်​မည်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​၌​မ​ဟာ​တန်​ခိုး​တော်​ရှိ​တော်​မူ သော​ကြောင့်","poem":2},{"text":"ကိုယ်​တော်​အား​ကျွန်​တော်​မျိုး​တို့​ထော​မ​နာ ပြု​ကြ​ပါ​၏။","poem":1},{"text":"ကိုယ်​တော်​၏​ဘုန်း​အာ​နု​ဘော်​တော်​ကို ထော​မ​နာ​သီ​ချင်း​ဆို​ပါ​မည်။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}