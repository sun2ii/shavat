{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":27,"content":[{"type":"heading","content":["ထော​မ​နာ​ပြု​သည့်​ဆု​တောင်း​ပတ္ထ​နာ"]},{"type":"verse","number":1,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ငါ​၏​အ​လင်း၊ ငါ​၏​ကယ်​တင်​ရှင်​ဖြစ်​တော်​မူ​၏။","poem":1},{"text":"ငါ​သည်​အ​ဘယ်​သူ​ကို​မျှ​ကြောက်​လန့်​ရ အံ့​နည်း။","poem":2},{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ဘေး​အန္တ​ရာယ်​အ​ပေါင်း​မှ ငါ့​ကို​ကွယ်​ကာ​စောင့်​ရှောက်​တော်​မူ​၏။","poem":1},{"text":"ငါ​သည်​ကြောက်​လန့်​လိမ့်​မည်​မ​ဟုတ်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ဆိုး​ညစ်​သူ​တို့​ငါ့​ကို​သတ်​ရန်​တိုက်​ခိုက်​ကြ​သော အ​ခါ သူ​တို့​သည်​ခြေ​ချော်​၍​လဲ​ကြ​၏။","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"စစ်​တပ်​တစ်​တပ်​လုံး​ပင်​ငါ့​ကို​ဝိုင်း​ရံ​ထား​စေ​ကာ​မူ ငါ​သည်​ကြောက်​လန့်​လိမ့်​မည်​မ​ဟုတ်။","poem":1},{"text":"အ​ကယ်​၍​ငါ​၏​ရန်​သူ​များ​က​ပင်​လျှင်","poem":2},{"text":"ငါ့​ကို​တိုက်​ခိုက်​စေ​ကာ​မူ​ငါ​သည် ထာ​ဝ​ရ​ဘု​ရား​အား​ကိုး​စား​မည်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​အား​ငါ​တောင်း​လျှောက်​လို သော​ဆု၊ ငါ​လို​ချင်​တောင့်​တ​သော​ဆု​တစ်​ခု​တည်း​ရှိ​၏။","poem":1},{"text":"ထို​ဆု​ကား​ဘု​ရား​သ​ခင်​၏​အိမ်​တော်​တွင်","poem":2},{"text":"တစ်​သက်​လုံး​နေ​ရ​၍​ကျေး​ဇူး​တော်​ကို ချီး​မွမ်း​အံ့​သြ​လျက်","poem":1},{"text":"ကိုယ်​တော်​၏​လမ်း​ပြ​မှု​ကို​တောင်း​ခံ​နိုင်​ခွင့် ပင်​ဖြစ်​၏။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ဘေး​အန္တ​ရာယ်​ရောက်​သည့်​ကာ​လ","poem":1},{"text":"ငါ့​အား​ကိုယ်​တော်​ကွယ်​ကာ​စောင့်​ရှောက်​၍ ထား​တော်​မူ​လိမ့်​မည်။","poem":2},{"text":"ဗိ​မာန်​တော်​တွင်​လုံ​ခြုံ​စွာ​ထား​တော်​မူ​လိမ့်​မည်။","poem":1},{"text":"ဘေး​ကင်း​စေ​ရန်​ကျောက်​ဆောင်​မြင့်​ပေါ်​မှာ​တင်​၍ ထား​တော်​မူ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"သို့​ဖြစ်​၍​ငါ​သည်​မိ​မိ​အား​ဝိုင်း​ရံ​ထား​သည့် ရန်​သူ​များ​ကို​အောင်​မြင်​ခွင့်​ရ​လိမ့်​မည်။","poem":1},{"text":"ငါ​သည်​ဝမ်း​မြောက်​ရွှင်​လန်း​စွာ​ကြွေး​ကြော် လျက် ဗိ​မာန်​တော်​တွင်​ယဇ်​ပူ​ဇော်​မည်။","poem":2},{"text":"သီ​ချင်း​ဆို​မည်။ ထာ​ဝ​ရ​ဘု​ရား​အား ထော​မ​နာ​ပြု​မည်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​အား​ကျွန်​တော်​မျိုး​ခေါ်​သော​အ​ခါ ထူး​တော်​မူ​ပါ။","poem":2},{"text":"က​ရု​ဏာ​ထား​တော်​မူ​၍​ထူး​တော်​မူ​ပါ။","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"``ငါ့​ထံ​သို့​ချဉ်း​ကပ်​၍​ကိုး​ကွယ်​ဝတ်​ပြု​လော့'' ဟု ကိုယ်​တော်​ရှင်​မိန့်​တော်​သည်​အ​တိုင်း","poem":1},{"lineBreak":true},{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​အ​ထံ​တော်​သို့​ချဉ်း​ကပ် ပါ​မည်။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ကျွန်​တော်​မျိုး​အား​မျက်​နှာ​တော်​ကို​လွှဲ​တော် မ​မူ​ပါ​နှင့်။ အ​မျက်​ထွက်​တော်​မ​မူ​ပါ​နှင့်။","poem":1},{"lineBreak":true},{"text":"ကိုယ်​တော်​ရှင်​၏​အ​စေ​ခံ​ဖြစ်​သူ​ကျွန်​တော် မျိုး​အား ကူ​မ​တော်​မူ​သော​အ​ရှင်​ဖြစ်​တော်​မူ​ပါ​၏။","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​ကယ်​တင်​ရှင် အို ဘု​ရား​သ​ခင်၊","poem":2},{"text":"ကျွန်​တော်​မျိုး​အား​ပစ်​ထား​တော်​မ​မူ​ပါ​နှင့်။ စွန့်​ပစ်​တော်​မ​မူ​ပါ​နှင့်။","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ငါ​၏​မိ​ဘ​တို့​သည်​ငါ့​အား​စွန့်​ပစ်​စေ​ကာ​မူ","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ငါ့​ကို​ကြည့်​ရှု စောင့်​ရှောက်​တော်​မူ​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​ပြု​စေ​လို​သော​အ​မှု​အ​ရာ​တို့​ကို ကျွန်​တော်​မျိုး​အား​သွန်​သင်​တော်​မူ​ပါ။","poem":2},{"text":"ကျွန်​တော်​မျိုး​မှာ​ရန်​သူ​များ​လှ​ပါ​၏။","poem":1},{"text":"သို့​ဖြစ်​၍​ကျွန်​တော်​မျိုး​အား​ဘေး​မဲ့​လုံ​ခြုံ​ရာ လမ်း​၌ ပို့​ဆောင်​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":12,"content":[{"text":"လိမ်​လည်​ခြိမ်း​ခြောက်​သည့်​ရန်​သူ​များ​၏​လက်​တွင် ကျွန်​တော်​မျိုး​ကို​စွန့်​ပစ်​၍​ထား​တော်​မ​မူ​ပါ​နှင့်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​ပြု​တော်​မူ​သော​ကျေး​ဇူး​တော်​ကို","poem":1},{"text":"ငါ​သည်​ဤ​ဘ​ဝ​တွင်​တွေ့​မြင်​မည်​ဟု​ယုံ​ကြည်​၏။","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​အား​ကိုး​စား​လော့။","poem":1},{"text":"စိတ်​မ​ပျက်​နှင့်၊ယုံ​ကြည်​ခြင်း​ရှိ​လော့။ ထာ​ဝ​ရ​ဘု​ရား​အား​ကိုး​စား​လော့။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}