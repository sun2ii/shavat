{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":28,"content":[{"type":"heading","content":["ကူ​မ​တော်​မူ​ရန်​ဆု​တောင်း​ပတ္ထ​နာ28:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သည်။"]},{"type":"verse","number":1,"content":[{"text":"ကျွန်​တော်​မျိုး​၏​ကွယ်​ကာ​ရာ​အ​ရှင်","poem":1},{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":2},{"text":"ကိုယ်​တော်​ရှင်​၏​ထံ​တော်​သို့​ကျွန်​တော်​မျိုး ဟစ်​ခေါ်​ပါ​၏။ ထူး​တော်​မူ​ပါ။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​ထူး​တော်​မ​မူ​ပါ​လျှင် ကျွန်​တော်​မျိုး​သည်​သေ​ရွာ​သွား​ရ​ပါ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ကိုယ်​တော်​ရှင်​၏​သန့်​ရှင်း​မြင့်​မြတ်​သော​ဗိ​မာန် တော်​သို့ လက်​အုပ်​ချီ​လျက်``ကူ​မ​တော်​မူ​ပါ'' ဟု","poem":1},{"text":"ကျွန်​တော်​မျိုး​ဟစ်​အော်​သော​အ​ခါ နား​ထောင်​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"မ​ကောင်း​မှု​ပြု​သည့်​သူ​ယုတ်​မာ​များ​နှင့်​အ​တူ","poem":1},{"text":"ကျွန်​တော်​မျိုး​အား​အ​ပြစ်​ဒဏ်​စီ​ရင်​တော်​မ​မူ ပါ​နှင့်။","poem":2},{"text":"ထို​သူ​တို့​သည်​နှုတ်​ချို​သော်​လည်း​မုန်း​စိတ်​ရှိ ကြ​ပါ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ထို​သူ​တို့​ပြု​သော​အ​မှု​များ​နှင့်​ကူး​လွန်​သော","poem":1},{"text":"အ​ပြစ်​များ​အ​တွက်​သူ​တို့​အား​အ​ပြစ်​ဒဏ် ပေး​တော်​မူ​ပါ။","poem":2},{"text":"သူ​တို့​၏​အ​ကျင့်​ဆိုး​များ​အ​တွက် အ​ပြစ်​ဒဏ်​ခတ်​တော်​မူ​ပါ။","poem":1},{"text":"သူ​တို့​အ​ပြစ်​နှင့်​ထိုက်​သင့်​သည့်​အ​ပြစ်​ဒဏ်​ကို စီ​ရင်​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"သူ​တို့​သည်​ထာ​ဝ​ရ​ဘု​ရား​ပြု​တော်​မူ​သော အ​မှု​တော်​တို့​ကို​လည်း​ကောင်း၊ကိုယ်​တော်","poem":1},{"text":"ဖန်​ဆင်း​တော်​မူ​သော​အ​ရာ​များ​ကို​လည်း​ကောင်း ပ​မာ​ဏ​မ​ပြု​ကြ​ပါ။","poem":2},{"text":"သို့​ဖြစ်​၍​ကိုယ်​တော်​သည်​သူ​တို့​အား","poem":1},{"text":"အ​ပြစ်​ဒဏ်​ခတ်​တော်​မူ​၍​ထာ​ဝ​စဉ်​ဆုံး​ပါး ပျက်​စီး​စေ​တော်​မူ​လိမ့်​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​အား​ထော​မ​နာ​ပြု​ကြ​လော့။","poem":1},{"text":"ကူ​မ​တော်​မူ​ရန်​ငါ​အော်​ဟစ်​သည်​ကို ကိုယ်​တော်​ကြား​တော်​မူ​ပြီ။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ငါ့​ကို​ကွယ်​ကာ စောင့်​ရှောက်​တော်​မူ​၏။","poem":1},{"text":"ငါ​သည်​ကိုယ်​တော်​အား​ကိုး​စား​၏။","poem":2},{"text":"ကိုယ်​တော်​သည်​ငါ့​အား​ကူ​မ​တော်​မူ​သ​ဖြင့်","poem":1},{"text":"ငါ​သည်​ဝမ်း​မြောက်​လျက်​ကိုယ်​တော်​အား ထော​မ​နာ​သီ​ချင်း​များ​ကို​ဆို​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​မိ​မိ​၏​လူ​စု​တော်​အား ကွယ်​ကာ​စောင့်​ရှောက်​တော်​မူ​၏။","poem":1},{"text":"မိ​မိ​ဘိ​သိက်​ပေး​တော်​မူ​သော​ရှင်​ဘု​ရင်​အား ကွယ်​ကာ​စောင့်​ရှောက်​၍​ကယ်​မ​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​၏​လူ​စု​တော်​အား​ကယ်​တော်​မူ​ပါ။","poem":2},{"text":"ကိုယ်​တော်​ရှင်​ပိုင်​တော်​မူ​သော​သူ​တို့​အား ကောင်း​ချီး​ပေး​တော်​မူ​ပါ။","poem":1},{"text":"သူ​တို့​အား​သိုး​ထိန်း​သ​ဖွယ်​ထာ​ဝ​စဉ်​ကြည့်​ရှု စောင့်​ရှောက်​တော်​မူ​ပါ။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}