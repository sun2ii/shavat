{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":30,"content":[{"type":"heading","content":["ကျေး​ဇူး​တော်​ချီး​မွမ်း​သည့်​ဆု​တောင်း​ပတ္ထ​နာ30:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဗိ​မာန်​တော်​ကို​ဆက်​ကပ်​သည့်​သီ​ချင်း​ဒါ​ဝိဒ် စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​ကို ကယ်​တော်​မူ​သော​ကြောင့်​လည်း​ကောင်း၊","poem":2},{"text":"ကျွန်​တော်​မျိုး​၏​ဝေ​ဒ​နာ​ကြောင့်","poem":1},{"text":"ရန်​သူ​တို့​အား​နှစ်​ထောင်း​အား​ရ​ခွင့်​ကို ပေး​တော်​မ​မူ​သော​ကြောင့်​လည်း​ကောင်း","poem":2},{"text":"ကိုယ်​တော်​ရှင်​အား​ကျွန်​တော်​မျိုး​ထော​မ​နာ ပြု​ပါ​၏။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​၏​ဘု​ရား​သ​ခင်၊ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကယ်​မ​တော်​မူ​ရန်​ကိုယ်​တော်​ရှင်​၏​ထံ​တော်​သို့ ကျွန်​တော်​မျိုး​အော်​ဟစ်​ခဲ့​ပါ​၏။","poem":2},{"text":"ကိုယ်​တော်​ရှင်​သည်​လည်း​ကျွန်​တော်​မျိုး​၏ ဝေ​ဒ​နာ​ကို​ငြိမ်း​စေ​တော်​မူ​ပါ​၏။","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​အား​သေ​ရွာ​မှ​ပြန်​၍ ခေါ်​ဆောင်​တော်​မူ​ခဲ့​ပါ​၏။","poem":1},{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​သည်​သင်္ချိုင်း​တွင်း​သို့​ဆင်း​လျက် ရှိ​ခဲ့​သော်​လည်း","poem":1},{"text":"ကိုယ်​တော်​သည်​ကျွန်​တော်​မျိုး​အား​မ​သေ​စေ​ဘဲ အ​သက်​ချမ်း​သာ​ပေး​တော်​မူ​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ကိုယ်​တော်​အား​သစ္စာ​စောင့်​သူ​တို့၊​ထာ​ဝ​ရ ဘု​ရား​အား ထော​မ​နာ​သီ​ချင်း​ဆို​ကြ​လော့။","poem":1},{"text":"သန့်​ရှင်း​မြင့်​မြတ်​တော်​မူ​သော​အ​ရှင်​ပြု တော်​မူ​သော","poem":2},{"text":"အ​မှု​တော်​ကို​အောက်​မေ့​သ​တိ​ရ​လျက် ကျေး​ဇူး​တော်​ကို​ချီး​မွမ်း​ကြ​လော့။","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​အ​မျက်​ထွက်​တော်​မူ​သည်​မှာ ခ​ဏ​သာ​လျှင်​ဖြစ်​၏။","poem":1},{"text":"ကျေး​ဇူး​ပြု​တော်​မူ​သည်​ကား​တစ်​သက်​လုံး ဖြစ်​သ​တည်း။","poem":2},{"text":"ညဥ့်​အ​ခါ​၌​မျက်​ရည်​များ​ပင်​ကျ​စေ​ကာ​မူ","poem":1},{"text":"မိုး​သောက်​ချိန်​၌​ကား​ဝမ်း​မြောက်​ရွှင်​လန်း ခွင့်​ကို ရ​ရှိ​တတ်​၏။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"မိ​မိ​တွင်​လုံ​ခြုံ​မှု​ရှိ​ပြီ​ဟု​ယုံ​ကြည်​လျက်","poem":1},{"text":"``ငါ​သည်​အ​ဘယ်​အ​ခါ​၌​မျှ​အ​ရေး​ရှုံး​နိမ့် ရ​လိမ့်​မည်​မ​ဟုတ်'' ဟု","poem":2},{"text":"ကျွန်​တော်​မျိုး​သည်​တစ်​ကိုယ်​တည်း​ပြော​ဆို​ခဲ့ ပါ​၏။","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​အား ကျေး​ဇူး​ပြု​တော်​မူ​ခဲ့​ပါ​ပြီ။","poem":2},{"text":"တောင်​ပေါ်​ရဲ​တိုက်​ကဲ့​သို့​ကျွန်​တော်​မျိုး​အား လုံ​ခြုံ​စွာ​ကွယ်​ကာ​တော်​မူ​ခဲ့​ပါ​၏။","poem":1},{"text":"သို့​ရာ​တွင်​ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး အား မျက်​နှာ​တော်​ကို​လွှဲ​၍​နေ​တော်​မူ​စဉ်​က","poem":2},{"text":"ကျွန်​တော်​မျိုး​သည်​ကြောက်​လန့်​ပါ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင်​၏​ထံ​တော်​သို့ ဟစ်​ခေါ်​လျက်","poem":2}]},{"type":"verse","number":9,"content":[{"text":"``ကျွန်​တော်​မျိုး​သေ​ရ​ခြင်း​ဖြင့်​အ​ဘယ်​အ​ကျိုး ရှိ​ပါ​မည်​နည်း။","poem":1},{"text":"သင်္ချိုင်း​တွင်း​သို့​ရောက်​ရ​ခြင်း​ဖြင့်​အ​ဘယ်​အ​ကျိုး ဖြစ်​ထွန်း​ပါ​မည်​နည်း။","poem":2},{"text":"သူ​သေ​တို့​သည်​ကိုယ်​တော်​ရှင်​အား​ထော​မ​နာ ပြု​နိုင်​ပါ​သ​လော။","poem":1},{"text":"သူ​တို့​သည်​ကိုယ်​တော်​ရှင်​၏​သစ္စာ​တော်​ကို ဖော်​ပြ​ကြေ​ညာ​နိုင်​ကြ​ပါ​သ​လော။","poem":2}]},{"type":"verse","number":10,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​ခေါ်​သံ​ကို​နား​ထောင်​တော်​မူ​၍ ကျွန်​တော်​မျိုး​အား​သ​နား​ကြင်​နာ​တော်​မူ​ပါ။","poem":2},{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​ကို​ကူ​မ​တော်​မူ​ပါ'' ဟူ​၍ တောင်း​လျှောက်​ခဲ့​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​အား","poem":1},{"text":"ဝမ်း​နည်း​ပူ​ဆွေး​ရာ​မှ​က​ခုန်​မြူး​တူး​စေ​တော် မူ​ပါ​ပြီ။","poem":2},{"text":"ကျွန်​တော်​မျိုး​၏​ဝမ်း​နည်း​ခြင်း​လက္ခ​ဏာ​ဖြစ်​သည့် လျှော်​တေ​ကို​ချွတ်​၍","poem":1},{"text":"ဝမ်း​မြောက်​ရွှင်​လန်း​ခြင်း​လက္ခ​ဏာ​ဖြစ်​သည့် အ​ဝတ်​ကို​ဝတ်​ဆင်​ပေး​တော်​မူ​ပါ​ပြီ။","poem":2}]},{"type":"verse","number":12,"content":[{"text":"သို့​ဖြစ်​၍​ကျွန်​တော်​မျိုး​သည်​ဆိတ်​ဆိတ်​နေ​မည် မ​ဟုတ်​ပါ။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​အား​ထော​မ​နာ​သီ​ချင်း​ဆို​ပါ​မည်။","poem":2},{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​၏​ဘု​ရား ဖြစ်​တော်​မူ​ပါ​၏။","poem":2},{"text":"ကျွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင်​၏​ကျေး​ဇူး တော်​ကို အ​စဉ်​အ​မြဲ​ချီး​မွမ်း​ပါ​မည်။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}