{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":32,"content":[{"type":"heading","content":["အ​ပြစ်​ဖော်​ပြ​ဝန်​ခံ​ခြင်း​နှင့် အ​ပြစ်​ဖြေ​လွှတ်​ခြင်း32:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"မိ​မိ​၏​အ​ပြစ်​များ​မှ​ဖြေ​လွှတ်​ခြင်း​ခံ​ရ​၍","poem":1},{"text":"ကူး​လွန်​မှု​များ​အ​တွက်​လွတ်​ငြိမ်း​ချမ်း​သာ​ခွင့် ရ​သော​သူ​သည်​မင်္ဂ​လာ​ရှိ​၏။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"မ​ကောင်း​မှု​ပြု​သူ​ဟု​ထာ​ဝ​ရ​ဘု​ရား အ​ပြစ်​တင် တော်​မူ​ခြင်း​ကို​မ​ခံ​ရ​ဘဲ","poem":1},{"text":"လိမ်​လည်​လှည့်​စား​မှု​မှန်​သ​မျှ​နှင့်​ကင်း​စင်​သူ​သည် မင်္ဂ​လာ​ရှိ​၏။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ကျွန်​တော်​မျိုး​သည်​မိ​မိ​၏​အ​ပြစ်​များ​ကို မ​ဖော်​ပြ၊​ဝန်​မ​ခံ​ဘဲ​နေ​သော​အ​ခါ","poem":1},{"text":"တစ်​နေ့​လုံး​ငို​ကြွေး​ရ​သ​ဖြင့်​မော​ပန်း​နွမ်း​နယ် ခဲ့​ပါ​၏။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​အား​နေ့​ရော​ည​ပါ အ​ပြစ်​ဒဏ်​ပေး​တော်​မူ​ပါ​၏။","poem":2},{"text":"နွေ​ရာ​သီ​အ​ပူ​ရှိန်​ကြောင့်​အ​စို​ဋ္ဌာတ်​သည် ခန်း​ခြောက်​သွား​သ​ကဲ့​သို့","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​အား​အင်​သည်​လည်း လုံး​ဝ​ခန်း​သွား​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ထို​အ​ခါ​ကျွန်​တော်​မျိုး​သည်​မိ​မိ​၏​အ​ပြစ် များ​ကို ကိုယ်​တော်​၏​ထံ​တွင်​ဖော်​ပြ​ဝန်​ခံ​ပါ​၏။","poem":1},{"text":"ကျွန်​တော်​မျိုး​ပြု​မိ​သည့်​အ​မှား​များ​ကို အ​ထံ​တော်​မှ​ဖုံး​ကွယ်​၍​မ​ထား​ပါ။","poem":2},{"text":"ယင်း​တို့​ကို​ကိုယ်​တော်​အား​ဖော်​ပြ​ဝန်​ခံ​ရန် ကျွန်​တော်​မျိုး​စိတ်​ပိုင်း​ဖြတ်​လိုက်​ပါ​၏။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​၏​ကူး​လွန်​မှု ရှိ​သ​မျှ​တို့​အ​တွက်​အ​ပြစ်​ဖြေ​လွှတ်​တော် မူ​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"သို့​ဖြစ်​၍​ကိုယ်​တော်​ရှင်​အား​သစ္စာ​စောင့်​သူ​တို့​သည် အ​ရေး​ကြုံ​သည့်​အ​ခါ​များ​၌","poem":1},{"text":"အ​ထံ​တော်​သို့​ဆု​တောင်း​ပတ္ထ​နာ​ပြု​သင့်​ကြ ပါ​သည်။","poem":2},{"text":"အ​ဟုန်​ပြင်း​စွာ​လွှမ်း​မိုး​၍​လာ​သော​ရေ​သည် သူ​တို့​ထံ​သို့​ရောက်​ရှိ​လိမ့်​မည်​မ​ဟုတ်​ပါ။","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​ခို​လှုံ​ရာ ဖြစ်​တော်​မူ​ပါ​၏။","poem":1},{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​အား​ဒုက္ခ​မှ​ကယ်​တော်​မူ​လိမ့်​မည်။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​ကို​ကွယ်​ကာ စောင့်​ရှောက်​တော်​မူ​သ​ဖြင့်","poem":2},{"text":"ကျွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင်​၏","poem":1},{"text":"ကယ်​တင်​ခြင်း​ကျေး​ဇူး​တော်​အ​ကြောင်း​ကို အ​သံ​ကျယ်​စွာ​သီ​ချင်း​ဆို​ပါ​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​က","poem":1},{"text":"``ငါ​သည်​သင်​လိုက်​လျှောက်​သင့်​သည့်​လမ်း​ကို ပြ​ညွှန်​မည်။","poem":2},{"text":"သင့်​အား​အ​ကြံ​ဉာဏ်​ပေး​၍​ကြည့်​ရှု​ပြု​စု​မည်။","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"သင်​သည်​ဇက်​နှင့်​ဇက်​ကြိုး​ဖြင့်​ထိန်း​ရ​သော","poem":1},{"text":"မြင်း​သို့​မ​ဟုတ်​လား​ကဲ့​သို့​ဉာဏ်​မ​တုံး​နှင့်'' ဟု မိန့်​တော်​မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"သူ​ယုတ်​မာ​တို့​သည်​ဒုက္ခ​ရောက်​ကြ​ရ​လိမ့်​မည်။","poem":1},{"text":"သို့​ရာ​တွင်​ဘု​ရား​သ​ခင်​ကို​ကိုး​စား​သူ​တို့​မူ​ကား","poem":2},{"text":"ခိုင်​မြဲ​သော​မေတ္တာ​တော်​ဖြင့်​ကွယ်​ကာ​ခြင်း​ကို ခံ​ရ​၏။","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"အို သူ​တော်​ကောင်း​အ​ပေါင်း​တို့၊","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​ပြု​တော်​မူ​သော​အ​မှု​တော် အ​တွက် ဝမ်း​မြောက်​ရွှင်​မြူး​ကြ​လော့။","poem":2},{"text":"ကိုယ်​တော်​၏​စ​ကား​ကို​နား​ထောင်​သူ​အ​ပေါင်း​တို့၊ ရွှင်​လန်း​စွာ​ကြွေး​ကြော်​ကြ​လော့။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}