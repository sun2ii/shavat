{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":33,"content":[{"type":"heading","content":["ထော​မ​နာ​သီ​ချင်း"]},{"type":"verse","number":1,"content":[{"text":"အို သူ​တော်​ကောင်း​အ​ပေါင်း​တို့၊​သင်​တို့​သည်","poem":1},{"text":"ဘု​ရား​သ​ခင်​ပြု​တော်​မူ​သော​အ​မှု​တော်​အ​တွက် ဝမ်း​မြောက်​စွာ​ကြွေး​ကြော်​ကြ​လော့။","poem":2},{"text":"ကိုယ်​တော်​၏​စ​ကား​ကို​နား​ထောင်​သူ​အ​ပေါင်း​တို့၊ ကိုယ်​တော်​အား​ထော​မ​နာ​ပြု​ကြ​လော့။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"စောင်း​တီး​၍​ဘု​ရား​သ​ခင်​၏​ကျေး​ဇူး​တော်​ကို ချီး​မွမ်း​ကြ​လော့။","poem":1},{"text":"ကြိုး​ဆယ်​ပင်​ရှိ​သော​တူ​ရိ​ယာ​ဖြင့်​ရှေ့​တော်​၌ သီ​ချင်း​ဆို​ကြ​လော့။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ရှေ့​တော်​၌​သီ​ချင်း​သစ်​ကို​ဆို​ကြ​လော့။","poem":1},{"text":"သာ​ယာ​စွာ​စောင်း​ကို​တီး​ကြ​လော့။ ဝမ်း​မြောက်​စွာ​ကြွေး​ကြော်​ကြ​လော့။","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​၏​နှုတ်​က​ပတ်​တော်​သည်​မှန်​ကန် ပေ​၏။","poem":1},{"text":"ကိုယ်​တော်​ပြု​တော်​မူ​ရာ​အ​မှု​အ​ရာ​တို့​သည်​လည်း သစ္စာ​တ​ရား​နှင့်​ကိုက်​ညီ​၏။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ဖြောင့်​မတ်​မှန်​ကန်​မှု​ကို နှစ်​သက်​တော်​မူ​၏။","poem":1},{"text":"ကိုယ်​တော်​၏​ခိုင်​မြဲ​သော​မေတ္တာ​တော်​သည် ကမ္ဘာ​မြေ​ကြီး​ကို​ဖုံး​လွှမ်း​လျက်​ရှိ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​အ​မိန့်​တော်​ဖြင့် မိုး​ကောင်း​ကင်​ကို​လည်း​ကောင်း၊","poem":1},{"text":"နှုတ်​တော်​ထွက်​စ​ကား​အား​ဖြင့်","poem":2},{"text":"နေ၊လ၊ကြယ်​တာ​ယာ​များ​ကို​လည်း​ကောင်း ဖန်​ဆင်း​တော်​မူ​၏။","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ပင်​လယ်​ရှိ​သ​မျှ​တို့​ကို​တစ်​နေ​ရာ​တည်း​တွင် စု​ဝေး​စေ​တော်​မူ​၏။","poem":1},{"text":"နက်​ရှိုင်း​သော​သ​မုဒ္ဒ​ရာ​ရေ​များ​ကို သို​လှောင်​ခန်း​များ​တွင်​သိမ်း​ဆည်း​ထား​တော် မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ကမ္ဘာ​မြေ​ကြီး​သား​အ​ပေါင်း​တို့၊​ထာ​ဝ​ရ ဘု​ရား​အား ရို​သေ​ကိုင်း​ရှိုင်း​ကြ​လော့။","poem":1},{"text":"ကမ္ဘာ​ပေါ်​ရှိ​လူ​အ​ပေါင်း​တို့၊​ကိုယ်​တော်​အား ကြောက်​ရွံ့​ရို​သေ​ကြ​လော့။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ကိုယ်​တော်​မြွက်​ဆို​တော်​မူ​သော​အ​ခါ ကမ္ဘာ​လော​က​သည်​ဖြစ်​ပေါ်​လာ​၏။","poem":1},{"text":"ကိုယ်​တော်​မိန့်​တော်​မူ​သော​အ​ခါ​ခပ်​သိမ်း​သော အ​ရာ​တို့​သည်​ပေါ်​ပေါက်​လာ​ကြ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​လူ​မျိုး​တ​ကာ​တို့​၏ ရည်​မှန်း​ချက်​များ​ကို​ပျက်​ပြား​စေ​တော်​မူ​၏။","poem":1},{"text":"သူ​တို့​၏​အ​ကြံ​အ​စည်​များ​ကို​လည်း အ​ထ​မ​မြောက်​စေ​ရန်​ဆီး​တား​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"သို့​ရာ​တွင်​ကိုယ်​တော်​၏​အ​ကြံ​အ​စည်​တော်​တို့ မူ​ကား အ​ဘယ်​ကာ​လ​၌​မျှ​ပျက်​ပြား​လိမ့်​မည်​မ​ဟုတ်။","poem":1},{"text":"ကိုယ်​တော်​၏​ရည်​မှန်း​ချက်​တို့​သည်​ထာ​ဝ​စဉ် အောင်​မြင်​သ​တည်း။","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​အား​ဘု​ရား​အ​ဖြစ်​နှင့်​ကိုး​ကွယ် သော လူ​မျိုး​သည်​မင်္ဂ​လာ​ရှိ​၏။","poem":1},{"text":"ကိုယ်​တော်​၏​လူ​စု​တော်​အ​ဖြစ်​ဖြင့်","poem":2},{"text":"ရွေး​ချယ်​တော်​မူ​ခြင်း​ကို​ခံ​ရ​သော​လူ​တို့​သည် မင်္ဂ​လာ​ရှိ​ကြ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ကောင်း​ကင်​ဘုံ​မှ ငုံ့​၍​ကြည့်​တော်​မူ​ရာ၊","poem":1},{"text":"လူ​သား​အ​ပေါင်း​ကို​မြင်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ကိုယ်​တော်​သည်​မိ​မိ​စိုး​စံ​တော်​မူ​ရာ​အ​ရပ် မှ​ငုံ့​၍","poem":1},{"text":"ကမ္ဘာ​မြေ​ကြီး​ပေါ်​ရှိ​သတ္တ​ဝါ​အ​ပေါင်း​တို့​ကို ကြည့်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ကိုယ်​တော်​သည်​သူ​တို့​၏​စိတ်​နှ​လုံး​များ​ကို ဖန်​ဆင်း​တော်​မူ​သော​အ​ရှင်​ဖြစ်​တော်​မူ​သ​ဖြင့်","poem":1},{"text":"သူ​တို့​ကြံ​စည်​ပြု​ကျင့်​သ​မျှ​သော အ​မှု​အ​ရာ​များ​ကို​သိ​တော်​မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ရှင်​ဘု​ရင်​မည်​သည်​မှာ​မိ​မိ​၏​ကြီး​မား​သော","poem":1},{"text":"စစ်​သည်​အ​လုံး​အ​ရင်း​ကြောင့်​စစ်​ပွဲ​တွင် အ​နိုင်​ရ​သည်​မ​ဟုတ်။","poem":2},{"text":"စစ်​သား​သည်​လည်း​မိ​မိ​၏​ခွန်​အား​ဗ​လ​ကြောင့် အ​နိုင်​ရ​သည်​မ​ဟုတ်။","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"စစ်​မြင်း​တို့​သည်​အောင်​ပွဲ​ရ​မှု​အ​တွက်​အ​သုံး​မ​ဝင်။ သူ​တို့​၏​ကြီး​မား​သော​ခွန်​အား​က​မ​ကယ်​နိုင်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ဘု​ရား​သ​ခင်​သည်​မိ​မိ​အား​ကြောက်​ရွံ့ ရို​သေ​သော၊","poem":1},{"text":"ခိုင်​မြဲ​သော​မေတ္တာ​တော်​ကို​ကိုး​စား​သော​သူ များ​အား ကြည့်​ရှု​စောင့်​ထိန်း​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ကိုယ်​တော်​သည်​ထို​သူ​တို့​အား​သေ​ဘေး​မှ ကယ်​တော်​မူ​၏။","poem":1},{"text":"အ​စာ​ငတ်​မွတ်​ခေါင်း​ပါး​ရာ​ကာ​လ​များ​၌ သူ​တို့​အား​အ​သက်​ရှင်​နိုင်​ခွင့်​ကို​ပေး​တော် မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ငါ​တို့​သည်​ထာ​ဝ​ရ​ဘု​ရား​ကို​စောင့်​မျှော်​ကြ​၏။","poem":1},{"text":"ကိုယ်​တော်​သည်​ငါ​တို့​အား​ကူ​မ​တော်​မူ​၍ ကွယ်​ကာ​စောင့်​ရှောက်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ငါ​တို့​သည်​ကိုယ်​တော်​ကြောင့်​ရွှင်​လန်း ဝမ်း​မြောက်​ကြ​ရ​၏။","poem":1},{"text":"ငါ​တို့​သည်​သန့်​ရှင်း​မြင့်​မြတ်​တော်​မူ​သော နာ​မ​တော်​ကို​ကိုး​စား​ကြ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​အား​ကျွန်​တော်​မျိုး​တို့ စောင့်​မျှော်​သည်​ဖြစ်​၍","poem":2},{"text":"ကျွန်​တော်​မျိုး​တို့​အား​ခိုင်​မြဲ​သော​မေတ္တာ တော်​ကို ခံ​စား​စေ​တော်​မူ​ပါ။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}