{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":37,"content":[{"type":"heading","content":["သူ​ယုတ်​မာ​များ​နှင့်​သူ​တော်​ကောင်း​တို့​၏​ကံ​ကြမ္မာ"]},{"type":"verse","number":1,"content":[{"text":"သူ​ယုတ်​မာ​တို့​၏​အ​တွက်​ကြောင့်​စိုး​ရိမ်​ပူ​ပန်​မှု မ​ဖြစ်​နှင့်။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"သူ​တို့​သည်​ခြောက်​သွေ့​သွား​သော​မြက်​ပင်​ကဲ့​သို့ ပျောက်​ပျက်​ကြ​ကုန်​လိမ့်​မည်။","poem":1},{"text":"ညှိုး​နွမ်း​သော​အ​ပင်​ငယ်​များ​ကဲ့​သို့ သေ​ကြေ​ပျက်​စီး​ကြ​လိမ့်​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​ကို​ကိုး​စား​လျက်","poem":1},{"text":"အ​ကျင့်​ကောင်း​ကို​ပြု​ကျင့်​လော့။ ပြည်​တော်​တွင်​လုံ​ခြုံ​စွာ​နေ​လော့။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​၌​မွေ့​လျော်​ပျော်​ပိုက်​မှု​ကို ရှာ​လော့။","poem":1},{"text":"သို့​ပြု​လျှင်​သင်​၏​အ​လို​ဆန္ဒ​ကို​ပြည့်​စုံ စေ​တော်​မူ​လိမ့်​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"သင်​သည်​မိ​မိ​ကိုယ်​ကို​ဘု​ရား​သ​ခင်​လက်​သို့ အပ်​နှံ​လော့။ ကိုယ်​တော်​ကို​ကိုး​စား​လော့။","poem":1},{"text":"သို့​ပြု​လျှင်​ကိုယ်​တော်​သည်​သင့်​ကို ကူ​မ​တော်​မူ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"သင်​၏​ဖြောင့်​မတ်​ခြင်း​ကို​မွန်း​တည့်​ရောင်​ခြည် ကဲ့​သို့ ထွန်း​လင်း​တောက်​ပ​စေ​တော်​မူ​လိမ့်​မည်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ကိုယ်​တော်​၏​စီ​ရင်​တော်​မူ​ချက်​ကို​သည်း​ခံ​၍ စောင့်​မျှော်​လော့။","poem":1},{"text":"ကောင်း​စား​သူ​တို့​ကြောင့်​လည်း​ကောင်း၊ အ​ကြံ​အ​စည်​အောင်​မြင်​သော","poem":2},{"text":"ဆိုး​ညစ်​သူ​တို့​ကြောင့်​လည်း​ကောင်း​ပူ​ပင်​သော​က မ​ဖြစ်​နှင့်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"မ​စိုး​ရိမ်​နှင့်။ ဒေါ​သ​အ​မျက်​မ​ထွက်​နှင့်။","poem":1},{"text":"စိုး​ရိမ်​မှု​နှင့်​ဒေါ​သ​အ​မျက်​သည်​သင့်​အား ဆိုး​ကျိုး​သာ​ပေး​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​ကို​ကိုး​စား​သော​သူ​တို့ သည် ပြည်​တော်​ကို​ပိုင်​ရ​ကြ​လိမ့်​မည်။","poem":1},{"text":"သို့​ရာ​တွင်​သူ​ယုတ်​မာ​တို့​မူ​ကား​ပြည်​နှင် ဒဏ်​ကို ခံ​ရ​ကြ​လိမ့်​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ကာ​လ​အ​နည်း​ငယ်​အ​တွင်း​၌​သူ​ယုတ်​မာ တို့​သည် ပျောက်​ကွယ်​သွား​ကြ​လိမ့်​မည်။","poem":1},{"text":"သင်​သည်​သူ​တို့​ကို​ရှာ​သော်​လည်း တွေ့​လိမ့်​မည်​မ​ဟုတ်။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"သို့​ရာ​တွင်​စိတ်​နှိမ့်​ချ​သော​သူ​တို့​သည်","poem":1},{"text":"ပြည်​တော်​ကို​ပိုင်​ရ​လျက်​ငြိမ်း​ချမ်း​သာ​ယာ​မှု​နှင့် ကြီး​ပွား​တိုး​တက်​မှု​တို့​ကို​ခံ​စား​ကြ​ရ လိမ့်​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"သူ​ယုတ်​မာ​သည်​သူ​တော်​ကောင်း​အား","poem":1},{"text":"မ​ကောင်း​ကြံ​လျက်​မုန်း​စိတ်​နှင့်​စူး​စူး​ဝါး​ဝါး ကြည့်​တတ်​၏။","poem":2}]},{"type":"verse","number":13,"content":[{"text":"သို့​ရာ​တွင်​ထို​သူ​သည်​မ​ကြာ​မ​မြင့်​မီ​ဆုံး​ပါး ပျက်​စီး ရ​တော့​မည်​ဖြစ်​ကြောင်း","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​သိ​တော်​မူ​သ​ဖြင့်​သူ့​အား ကြည့်​၍ ပြုံး​ရယ်​တော်​မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"သူ​ယုတ်​မာ​တို့​သည်​ဆင်း​ရဲ​နွမ်း​ပါး​သူ​တို့​အား","poem":1},{"text":"သတ်​ဖြတ်​ရန်​လည်း​ကောင်း၊မှန်​ရာ​ကို​ပြု​သူ​တို့ အား အ​ဆုံး​စီ​ရင်​ရန်​လည်း​ကောင်း","poem":2},{"text":"ဋ္ဌား​များ​ကို​ဆွဲ​ထုတ်​၍​လေး​များ​ကို တင်​ကြ​၏။","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"သို့​ရာ​တွင်​ထို​သူ​တို့​သည်​မိ​မိ​၏​ဋ္ဌား​များ​ဖြင့် ပင်​လျှင် ထိုး​သတ်​ခံ​ကြ​ရ​လိမ့်​မည်။","poem":1},{"text":"သူ​တို့​၏​လေး​များ​သည်​လည်း​ကျိုး​ကုန်​ကြ လိမ့်​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"သူ​တော်​ကောင်း​တစ်​ယောက်​၏​ဥစ္စာ​ပစ္စည်း အ​နည်း​ငယ်​သည်","poem":1},{"text":"သူ​ယုတ်​မာ​အ​ပေါင်း​တို့​၏​စည်း​စိမ်​ချမ်း​သာ ထက် ပို​၍​တန်​ဖိုး​ရှိ​၏။","poem":2}]},{"type":"verse","number":17,"content":[{"text":"အ​ဘယ်​ကြောင့်​ဆို​သော်​ထာ​ဝ​ရ​ဘု​ရား​သည် သူ​ယုတ်​မာ​တို့​၏​စွမ်း​ရည်​ကို​သိမ်း​ယူ​၍","poem":1},{"text":"သူ​တော်​ကောင်း​တို့​အား​ကွယ်​ကာ စောင့်​ရှောက်​တော်​မူ​မည်​ဖြစ်​သော​ကြောင့် တည်း။","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​မိ​မိ​၏​စ​ကား​ကို နား​ထောင်​သူ​တို့​အား​စောင့်​ရှောက်​တော်​မူ​၏။","poem":1},{"text":"သူ​တို့​သည်​ပြည်​တော်​ကို​ထာ​ဝ​စဉ်​ပိုင်​ဆိုင် ရ​ကြ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ခဲ​ယဉ်း​ရာ​ကာ​လ​များ​၌​သူ​တို့​သည် ဒုက္ခ​ရောက်​ကြ​လိမ့်​မည်​မ​ဟုတ်။","poem":1},{"text":"အ​စာ​ငတ်​မွတ်​ခေါင်း​ပါး​ချိန်​များ​၌​အ​စာ ရေ​စာ လုံ​လောက်​စွာ​ရ​ရှိ​ကြ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":20,"content":[{"text":"သူ​ယုတ်​မာ​တို့​မူ​ကား​သေ​ကြ​လိမ့်​မည်။","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​အား​ရန်​ဘက်​ပြု​သူ​တို့​သည်","poem":2},{"text":"တော​ပန်း​များ​ကဲ့​သို့​ပျောက်​ကွယ်​ကြ​လိမ့်​မည်။","poem":1},{"text":"မီး​ခိုး​ကဲ့​သို့​လွင့်​ပျောက်​ကြ​လိမ့်​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"သူ​ယုတ်​မာ​သည်​ချေး​ငှား​ပြီး​နောက် ပြန်​၍​မ​ပေး​မ​ဆပ်​တတ်။","poem":1},{"text":"သူ​တော်​ကောင်း​မူ​ကား​ရက်​ရော​စွာ​ပေး​ကမ်း တတ်​၏။","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​ကောင်း​ချီး​ပေး​တော်​မူ​သော သူ​တို့​သည် ပြည်​တော်​ကို​ပိုင်​ရ​ကြ​လိမ့်​မည်။","poem":1},{"text":"သို့​ရာ​တွင်​ကိုယ်​တော်​ကျိန်​တော်​မူ​ခြင်း​ခံ​ရ​သော သူ​တို့​မူ​ကား​ပြည်​နှင်​ဒဏ်​သင့်​ကြ​လိမ့်​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​လူ​တို့​လိုက်​လျှောက်​အပ်​သည့် လမ်း​ကို​ပြ​ညွှန်​တော်​မူ​၏။","poem":1},{"text":"ကိုယ်​တော်​နှစ်​သက်​တော်​မူ​သော​သူ​တို့​ကို ကွယ်​ကာ​တော်​မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​သူ​တို့​အား","poem":1},{"text":"ကူ​မ​တော်​မူ​မည်​ဖြစ်​၍​သူ​တို့​သည်​လဲ သော်​လည်း မ​ထ​ဘဲ​နေ​လိမ့်​မည်​မ​ဟုတ်။","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ယ​ခု​အ​ခါ​ငါ​သည်​အ​သက်​ကြီး​ရင့်​လေ​ပြီ။ ငါ​သည်​ကြာ​ရှည်​စွာ​အ​သက်​ရှင်​ခဲ့​ပါ​ပြီ။","poem":1},{"text":"သို့​ရာ​တွင်​သူ​တော်​ကောင်း​အား​ထာ​ဝ​ရ​ဘု​ရား စွန့်​ပစ်​တော်​မူ​သည်​ကို​လည်း​ကောင်း၊","poem":2},{"text":"သူ​၏​သား​သ​မီး​တို့​တောင်း​စား​ရ​သည်​ကို လည်း​ကောင်း တစ်​ချိန်​တစ်​ခါ​မျှ​ငါ​မ​တွေ့​မ​မြင်​ခဲ့​ဘူး​ပါ။","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"သူ​သည်​အ​စဉ်​ပင်​သူ​တစ်​ပါး​တို့​အား​ရက်​ရော​စွာ ပေး​ကမ်း​ချေး​ငှား​တတ်​၏။","poem":1},{"text":"သူ​၏​သား​သ​မီး​များ​သည်​လည်း​ကောင်း​ချီး မင်္ဂ​လာ​ကို​ခံ​ရ​ကြ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ဒု​စ​ရိုက်​ကို​ရှောင်​ကြဉ်​၍​သု​စ​ရိုက်​ကို​ပြု​လော့။","poem":1},{"text":"သို့​ပြု​လျှင်​သင်​၏​သား​မြေး​တို့​သည်​ပြည်​တော် တွင် အ​စဉ်​အ​မြဲ​နေ​ရ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":28,"content":[{"text":"အ​ဘယ်​ကြောင့်​ဆို​သော်​ထာ​ဝ​ရ​ဘု​ရား​သည် အ​မှန်​တ​ရား​ကို​နှစ်​သက်​တော်​မူ​၍","poem":1},{"text":"မိ​မိ​အား​သစ္စာ​စောင့်​သည့်​လူ​စု​တော်​ကို စွန့်​ပစ်​တော်​မ​မူ​သော​ကြောင့်​ဖြစ်​၏။","poem":2},{"text":"ကိုယ်​တော်​သည်​သူ​တို့​အား​အ​စဉ်​အ​မြဲ ကာ​ကွယ်​စောင့်​ရှောက်​တော်​မူ​၏။","poem":1},{"text":"သို့​ရာ​တွင်​သူ​ယုတ်​မာ​တို့​၏​သား​မြေး​များ​မူ​ကား ပြည်​နှင်​ဒဏ်​သင့်​ကြ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ဖြောင့်​မတ်​သော​သူ​တို့​သည်​ပြည်​တော်​ကို​ပိုင်​ဆိုင်​၍ အ​စဉ်​နေ​ထိုင်​ရ​ကြ​လိမ့်​မည်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"သူ​တော်​ကောင်း​သည်​ဉာဏ်​ပ​ညာ​အ​မြော်​အ​မြင်​ရှိ​သော စ​ကား​ကို​ပြော​ဆို​တတ်​၏။","poem":1},{"text":"သူ​သည်​အ​စဉ်​ပင်​တ​ရား​မျှ​တ​၏။","poem":2}]},{"type":"verse","number":31,"content":[{"text":"သူ​သည်​မိ​မိ​ဘု​ရား​၏​တ​ရား​တော်​ကို နှ​လုံး​သွင်း​၍​ထား​၏။","poem":1},{"lineBreak":true},{"text":"အ​ဘယ်​အ​ခါ​၌​မျှ​ထို​တ​ရား​တော်​မှ သွေ​ဖည်​၍​မ​သွား​ပေ။","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"သူ​ယုတ်​မာ​သည်​သူ​တော်​ကောင်း​အား​ချောင်း​မြောင်း​၍ သတ်​ရန်​ကြိုး​စား​တတ်​၏။","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"သို့​ရာ​တွင်​ထာ​ဝ​ရ​ဘု​ရား​သည်","poem":1},{"text":"သူ​တော်​ကောင်း​အား​ရန်​သူ​၏​လက်​တွင်​စွန့်​ပစ်​၍ ထား​တော်​မူ​လိမ့်​မည်​မ​ဟုတ်။","poem":2},{"text":"သူ​သည်​တ​ရား​ရုံး​သို့​ရောက်​၍​အ​စစ်​ခံ​ရ​သော် သူ့​အား အ​ပြစ်​ဒဏ်​သင့်​စေ​တော်​မူ​လိမ့်​မည်​မ​ဟုတ်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​ကို​မျှော်​ကိုး​လျက်​ပ​ညတ်​တော် တို့​ကို စောင့်​ထိန်း​လော့။","poem":1},{"text":"ကိုယ်​တော်​သည်​သင့်​အား​ပြည်​တော်​ကို","poem":2},{"text":"ပိုင်​ဆိုင်​ရ​သော​အ​ခွင့်​နှင့်​ချီး​မြှင့်​တော်​မူ လိမ့်​မည်။","poem":1},{"text":"သင်​သည်​သူ​ယုတ်​မာ​တို့​ပြည်​နှင်​ဒဏ် သင့်​ကြ​သည်​ကို​မြင်​ရ​လိမ့်​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"ငါ​သည်​ပိုင်​စိုး​ပိုင်​နင်း​ပြု​တတ်​သည့် သူ​ယုတ်​မာ​တစ်​ယောက်​ကို​တွေ့​မြင်​ဖူး​၏။","poem":1},{"text":"သူ​သည်​လေ​ဗ​နုန်​တော​မှ​အာ​ရဇ်​ပင်​ကဲ့​သို့ လူ​အ​ပေါင်း​တို့​အ​ပေါ်​တွင်​လွှမ်း​မိုး​လျက်​နေ​၏။","poem":2}]},{"type":"verse","number":36,"content":[{"text":"သို့​ရာ​တွင်​နောက်​တစ်​ကြိမ်​ငါ​ဖြတ်​သွား​သော အ​ခါ သူ​သည်​ထို​အ​ရပ်​တွင်​မ​ရှိ​တော့​ပြီ။","poem":1},{"text":"သူ့​ကို​ရှာ​သော်​လည်း​မ​တွေ့​မ​မြင်​နိုင်​တော့​ပေ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"သူ​တော်​ကောင်း​ကို​ကြည့်​ရှု​လော့။","poem":1},{"text":"ဖြောင့်​မတ်​သော​သူ​ကို​ကြည့်​ရှု​ဆင်​ခြင်​လော့။","poem":2},{"text":"ငြိမ်း​ချမ်း​မှု​ကို​လို​လား​သူ​တွင်​သား​မြေး အ​ဆက်​အ​နွယ်​ထွန်း​ကား​၏။","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"သို့​ရာ​တွင်​အ​ပြစ်​ကူး​သူ​တို့​မူ​ကား","poem":1},{"text":"တစ်​ယောက်​မ​ကျန်​ဆုံး​ပါး​ပျက်​စီး​ကြ ကုန်​၏။","poem":2},{"text":"သူ​တို့​၏​သား​မြေး​အ​ဆက်​အ​နွယ်​များ​သည်​လည်း သုတ်​သင်​ဖယ်​ရှား​ခြင်း​ကို​ခံ​ကြ​ရ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ဖြောင့်​မတ်​သော​သူ​တို့​ကို ကယ်​တော်​မူ​၏။","poem":1},{"text":"ဒုက္ခ​ရောက်​ချိန်​များ​၌​သူ​တို့​အား ကာ​ကွယ်​စောင့်​ရှောက်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":40,"content":[{"text":"ကိုယ်​တော်​သည်​သူ​တို့​အား​ကူ​မ​တော်​မူ​၏။ ကယ်​မ​တော်​မူ​၏။","poem":1},{"text":"သူ​တို့​သည်​ကိုယ်​တော်​၏​ထံ​တော်​တွင်","poem":2},{"text":"ခို​လှုံ​ကြ​သည်​ဖြစ်​၍​ကိုယ်​တော်​သည်​သူ​တို့​အား သူ​ယုတ်​မာ​များ​၏​လက်​မှ​ကယ်​တော်​မူ​၏။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}