{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":38,"content":[{"type":"heading","content":["ဝေ​ဒ​နာ​ရှင်​တစ်​ဦး​၏​ဆု​တောင်း​ပတ္ထနာ38:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သော​ဆာ​လံ။ မြည်​တမ်း​ခြင်း။"]},{"type":"verse","number":1,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"အ​မျက်​တော်​ထွက်​၍​ကျွန်​တော်​မျိုး​အား အ​ပြစ်​ဒဏ်​ပေး​တော်​မ​မူ​ပါ​နှင့်။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​အား​မြား ဖြင့်​ပစ်​၍ ဒဏ်​ရာ​ရ​ရှိ​စေ​တော်​မူ​ပါ​ပြီ။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​အား​ပြို​လဲ စေ​တော်​မူ​ပါ​ပြီ။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ကိုယ်​တော်​၏​အ​မျက်​တော်​ကြောင့်​ကျွန်​တော်​မျိုး​သည် ဝေ​ဒ​နာ​ခံ​လျက်​နေ​ရ​ပါ​၏။","poem":1},{"text":"မိ​မိ​၏​အ​ပြစ်​များ​ကြောင့်​တစ်​ကိုယ်​လုံး ရော​ဂါ​စွဲ​လျက်​နေ​ပါ​၏။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"အ​ပြစ်​ဒု​စ​ရိုက်​ရေ​လွှမ်း​မိုး​ရာ​တွင်​ကျွန်​တော် မျိုး​သည် နစ်​မွန်း​လျက်​ရှိ​ပါ​၏။","poem":1},{"text":"ယင်း​တို့​သည်​လေး​လံ​သော​အ​ပြစ်​ဝန်​ထုပ်​ဖြစ်​၍ ကျွန်​တော်​မျိုး​မ​ထမ်း​နိုင်​ပါ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ကျွန်​တော်​မျိုး​၏​မိုက်​မဲ​မှု​ကြောင့်​ရ​ရှိ​သော အ​နာ​များ​သည်​ပုပ်​စပ်​နံ​စော်​လျက်​နေ​ပါ​၏။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​သည်​မ​ချိ​မ​ဆန့်​ဝေ​ဒ​နာ​ခံ​၍ နေ​ရ​ပါ​၏။","poem":1},{"text":"တစ်​နေ့​လုံး​ပင်​ပူ​ဆွေး​ငို​ယို​လျက်​နေ​ရ​ပါ​၏။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ကျွန်​တော်​မျိုး​သည်​အ​ဖျား​အ​ပူ​ရှိန်​ပြင်း​ထန်​လျက် အ​သဲ​အ​သန်​ဖြစ်​နေ​ပါ​၏။","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"စိ​စိ​ညက်​ညက်​ကြေ​၍​နုန်း​နဲ့​ခွေ​ယိုင်​လျက်​ရှိ​ပါ​၏။","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​စိတ်​ဒုက္ခ​ရောက်​၍​ဝေ​ဒနာ​ကြောင့် ညည်း​ညူ​လျက်​ရှိ​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​၏​အ​လို​ဆန္ဒ​ကို သိ​တော်​မူ​ပါ​၏။","poem":2},{"text":"ကျွန်​တော်​မျိုး​၏​ညည်း​ညူ​သံ​ကို​ကြား​တော်​မူ​ပါ​၏။","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​၏​နှ​လုံး​သည်​ခုန်​၍​နေ​ပါ​၏။ ကျွန်​တော်​မျိုး​တွင်​ခွန်​အား​မ​ရှိ​တော့​ပါ။","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​မျက်​စိ​များ​သည်​လည်း မှုံ​လျက်​နေ​ပါ​၏။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ကျွန်​တော်​မျိုး​၏​အ​နာ​များ​ကြောင့်​မိတ်​ဆွေ​များ​နှင့် အိမ်​နီး​ချင်း​များ​သည်","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​အ​နီး​သို့​မ​ကပ်​ကြ​တော့​ပါ။","poem":2},{"text":"ကျွန်​တော်​မျိုး​၏​အိမ်​ထောင်​စု​သား​များ​ပင်​လျှင် ကျွန်​တော်​မျိုး​ထံ​သို့​မ​လာ​ကြ​ပါ။","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​အား​သတ်​ဖြတ်​လို​သူ​တို့​သည် ကျော့​ကွင်း​များ​ကို​ထောင်​ကြ​ပါ​၏။","poem":1},{"text":"ကျွန်​တော်​မျိုး​အား​ဥ​ပဒ်​ပြု​လို​သူ​တို့​သည် ခြိမ်း​ခြောက်​ပြော​ဆို​ကြ​ပါ​၏။","poem":2},{"text":"သူ​တို့​သည်​ကျွန်​တော်​မျိုး​အား​လုပ်​ကြံ​ရန် အ​စဉ်​မ​ပြတ်​ကြံ​စည်​လျက်​နေ​ကြ​ပါ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ကျွန်​တော်​မျိုး​သည်​နား​ပင်း​သူ​ကဲ့​သို့​မ​ကြား နိုင်​ပါ။ ဆွံ့​အ​သူ​ကဲ့​သို့​စ​ကား​မ​ပြော​နိုင်​ပါ။","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​သည်​နား​မ​ကြား​သ​ဖြင့် စ​ကား​ပြန်​မ​ပြော​နိုင်​သူ​ကဲ့​သို့​ဖြစ်​ပါ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"သို့​ရာ​တွင် အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင်​ကို​ကိုး​စား​ပါ​၏။","poem":2},{"text":"သို့​ဖြစ်​၍​ကျွန်​တော်​မျိုး​၏​အ​ရှင်​ဘု​ရား​သ​ခင်၊ ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​၏","poem":1},{"text":"လျှောက်​ထား​ချက်​ကို​နား​ညောင်း​တော်​မူ​မည်​ဖြစ်​ပါ​၏။","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ကျွန်​တော်​မျိုး​၏​ဒုက္ခ​ကို​အ​ကြောင်း​ပြု​ကာ","poem":1},{"text":"ရန်​သူ​တို့​သည်​နှစ်​ထောင်း​အား​ရ​ခွင့်​ကို ပေး​တော်​မ​မူ​ပါ​နှင့်။","poem":2},{"text":"သူ​တို့​အား​ကျွန်​တော်​မျိုး​ပြို​လဲ​မှု​ကို​အ​ကြောင်း ပြု​ကာ ကြွား​ဝါ​ခွင့်​ပေး​တော်​မ​မူ​ပါ​နှင့်။","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​သည်​ပြို​လဲ​လု​ပါ​ပြီ။","poem":1},{"text":"ဝေ​ဒ​နာ​ကို​အ​စဉ်​ခံ​စား​လျက်​နေ​ရ​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ကျွန်​တော်​မျိုး​သည်​မိ​မိ​၏​အ​ပြစ်​များ​ကို ဖော်​ပြ​ဝန်​ခံ​ပါ​၏။","poem":1},{"text":"ယင်း​အ​ပြစ်​များ​ကြောင့်​စိုး​ရိမ်​ပူ​ပန်​ပါ​၏။","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ကျွန်​တော်​မျိုး​၏​ရန်​သူ​တို့​သည်​ကျန်း​မာ သန်​စွမ်း​ကြ​ပါ​၏။","poem":1},{"text":"အ​ကြောင်း​မဲ့​ကျွန်​တော်​မျိုး​အား​မုန်း​သူ​တို့​သည် များ​ပြား​ကြ​ပါ​၏။","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ကျွန်​တော်​မျိုး​သည်​မှန်​ရာ​ကို​ပြု​ကျင့်​ရန် ကြိုး​စား​သဖြင့်","poem":1},{"text":"အ​ကောင်း​ကို​အ​ဆိုး​အား​ဖြင့်​ပြန်​လည် ပေး​ဆပ်​တတ်​သူ​တို့​သည်","poem":2},{"text":"ကျွန်​တော်​မျိုး​ကို​ဆန့်​ကျင်​ဘက်​ပြု​ကြ​ပါ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​ကို​စွန့်​ပစ်​တော်​မ​မူ​ပါ​နှင့်။","poem":2},{"text":"ကျွန်​တော်​မျိုး​၏​ဘု​ရား၊​ကျွန်​တော်​မျိုး​နှင့် ဝေး​ဝေး​နေ​တော်​မ​မူ​ပါ​နှင့်။","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​ကို​ကယ်​တင်​မူ​သော​ဘု​ရား​ရှင်၊ ယ​ခု​ပင်​ကျွန်​တော်​မျိုး​ကို​ကူ​မ​တော်​မူ​ပါ။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}