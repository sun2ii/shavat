{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":39,"content":[{"type":"heading","content":["ဝေ​ဒ​နာ​ရှင်​တစ်​ဦး​၏​ဖော်​ပြ​ဝန်​ခံ​ချက်39:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သည်။"]},{"type":"verse","number":1,"content":[{"text":"``ငါ​ပြု​သည့်​အ​မှု​အ​တွက်​ငါ​သ​တိ​ထား​မည်။","poem":1},{"text":"နှုတ်​ဖြင့်​မျှ​မ​ပြစ်​မှား​မိ​စေ​ရန်​ငါ​သည်​သ​တိ ပြု​မည်။","poem":2},{"text":"ဆိုး​ညစ်​သူ​တို့​အ​နီး​၌​ရှိ​စဉ်​ငါ​သည်​အ​ဘယ် စ​ကား​ကို​မျှ​မ​ပြော​ဘဲ​နေ​မည်'' ဟု​ငါ​ဆို​၏။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ငါ​သည်​စ​ကား​တစ်​ခွန်း​မျှ​မ​ပြော​ဘဲ ဆိတ်​ဆိတ်​နေ​ခဲ့​၏။ အ​ကောင်း​ကို​ပင်​မ​ပြော ဆို​ခဲ့​ပါ။","poem":1},{"text":"သို့​ရာ​တွင်​ငါ​၏​ဝေ​ဒ​နာ​သည်​ပို​မို​ဆိုး​ရွား ၍​သာ​လာ​၏။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ငါ​သည်​ပူ​ပင်​သော​က​ရောက်​ခဲ့​၏။","poem":1},{"text":"စဉ်း​စား​လေ​လေ​ပို​၍​စိတ်​ဒုက္ခ​ရောက်​လေ​လေ ဖြစ်​ခဲ့​၏။","poem":2},{"text":"``အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​အ​ဘယ်​မျှ​အ​သက်​ရှည်​ပါ မည်​နည်း။","poem":2},{"text":"အ​ဘယ်​အ​ခါ​သေ​ရ​ပါ​မည်​နည်း။","poem":1},{"text":"ကျွန်​တော်​မျိုး​အား​အနိစ္စ​တ​ရား​ကို သိ​စေ​တော်​မူ​ပါ'' ဟု","poem":2},{"text":"ကိုယ်​တော်​အား​ငါ​မ​မေး​မ​လျှောက်​ဘဲ​မ​နေ​နိုင်​ပါ။","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ကိုယ်​တော်​သည်​ကျွန်​တော်​မျိုး​၏​အ​သက်​ကို လွန်​စွာ​တို​စေ​တော်​မူ​ပါ​ပြီ​တ​ကား။","poem":1},{"text":"ကိုယ်​တော်​၏​ရှေ့​တော်​တွင်​ကျွန်​တော်​မျိုး​၏","poem":2},{"text":"အ​သက်​တာ​သည်​ဘာ​မျှ​မ​ဟုတ်​သ​ကဲ့​သို့​ဖြစ်​ပါ​၏။","poem":1},{"text":"အ​ကယ်​စင်​စစ်​သက်​ရှိ​လူ​သတ္တ​ဝါ​မည်​သည်​ကား ထွက်​သက်​ဝင်​သက်​တ​မျှ၊","poem":2}]},{"type":"verse","number":6,"content":[{"text":"အ​ရိပ်​တ​မျှ​ခ​ဏ​သာ​အ​သက်​ရှင်​ပါ​၏။","poem":1},{"text":"သူ​ပြု​သ​မျှ​သော​အ​မှု​အ​ရာ​တို့​သည်​ဘာ​မျှ အ​ကျိုး​မ​ရှိ။","poem":2},{"text":"သူ​သည်​စည်း​စိမ်​ဥစ္စာ​ကို​စု​ဆောင်း​သော်​လည်း","poem":1},{"text":"အ​ဘယ်​အ​ရာ​ကို​အ​ဘယ်​သူ​ရ​ရှိ​လိမ့်​မည်​ကို သူ​မ​သိ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"သို့​ဖြစ်​၍ အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​အ​ဘယ်​အ​ရာ​ကို မျှော်​ကိုး​နိုင်​ပါ​မည်​နည်း။","poem":2},{"text":"ကျွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ကို​မျှော်​ကိုး​ပါ​၏။","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​၏​အ​ပြစ်​အ​ပေါင်း​မှ​ကယ်​တော် မူ​ပါ။","poem":1},{"text":"ကျွန်​တော်​မျိုး​အား​လူ​မိုက်​တို့​လှောင်​ပြောင် စေ​တော်​မ​မူ​ပါ​နှင့်။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ကိုယ်​တော်​သည်​ကျွန်​တော်​မျိုး​အား","poem":1},{"text":"ဤ​သို့​ဝေ​ဒ​နာ​ခံ​စေ​တော်​မူ​သော​ကြောင့် ကျွန်​တော်​မျိုး​သည်​ဆိတ်​ဆိတ်​နေ​ပါ​မည်။","poem":2},{"text":"စ​ကား​တစ်​ခွန်း​မျှ​ပြော​မည်​မ​ဟုတ်​ပါ။","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ထပ်​မံ​၍​ကျွန်​တော်​မျိုး​အား အ​ပြစ်​ဒဏ်​ပေး​တော်​မ​မူ​ပါ​နှင့်။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​ပေး​တော်​မူ​သည့်","poem":2},{"text":"ဒဏ်​ရာ​ဒဏ်​ချက်​များ​ကြောင့်​ကျွန်​တော်​မျိုး သည် သေ​လု​ပါ​ပြီ။","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​ရှင်​သည်​လူ​အား​သူ​၏","poem":1},{"text":"အ​ပြစ်​ဒု​စ​ရိုက်​အ​တွက်​ဆုံး​မ​၍​အ​ပြစ်​ဒဏ် ပေး​တော်​မူ​ပါ​၏။","poem":2},{"text":"သူ​နှစ်​သက်​စွဲ​လန်း​သော​အ​ရာ​တို့​ကို​ပိုး​ဖ​လံ ကဲ့​သို့ ကိုယ်​တော်​ဖျက်​ဆီး​ပစ်​တော်​မူ​ပါ​၏။","poem":1},{"text":"အ​ကယ်​စင်​စစ်​လူ​သည်​ထွက်​သက်​ဝင်​သက်​မျှ​သာ ဖြစ်​ပါ​သည်​တ​ကား။","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​ဆု​တောင်း​ပတ္ထ​နာ​ကို နား​ညောင်း​တော်​မူ​ပါ။","poem":2},{"text":"ကျွန်​တော်​မျိုး​၏​ပန်​ကြား​ချက်​ကို နား​ထောင်​တော်​မူ​ပါ။","poem":1},{"text":"ကျွန်​တော်​မျိုး​ငို​ယို​သော​အ​ခါ​ကူ​မ​ရန်​ကြွ တော်​မူ​ပါ။","poem":2},{"text":"ဘိုး​ဘေး​တို့​ကဲ့​သို့​ကျွန်​တော်​မျိုး​သည်","poem":1},{"text":"ကိုယ်​တော်​ရှင်​၏​ဧည့်​သည်​အ​ဖြစ်​နှင့် ခ​ဏ​မျှ​သာ​နေ​ရ​ပါ​၏။","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ကျွန်​တော်​မျိုး​သေ​၍​ပျောက်​ကွယ်​မ​သွား​မီ ရွှင်​လန်း​မှု​အ​နည်း​ငယ်​ရ​ရှိ​စေ​ရန်","poem":1},{"text":"ကျွန်​တော်​မျိုး​ထံ​မှ​မျက်​နှာ​တော်​ကို​လွှဲ​တော်​မူ​ပါ။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":12}