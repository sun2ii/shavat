{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":4,"content":[{"type":"heading","content":["ကူ​မ​တော်​မူ​ရန်​ည​နေ​ချိန်​ဆု​တောင်း​ပတ္ထနာ4:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​ကို​ကွယ်​ကာ​တော်​မူ​သော​အ​ရှင်၊ ကျွန်​တော်​မျိုး​ခေါ်​သော​အ​ခါ​ထူး​တော်​မူ​ပါ။","poem":2},{"text":"ကျွန်​တော်​မျိုး​ဒုက္ခ​ရောက်​စဉ်​အ​ခါ​၌​ကျွန်​တော် မျိုး​အား ကူ​မ​တော်​မူ​ခဲ့​ပါ​၏။","poem":1},{"text":"ယ​ခု​အ​ခါ​၌​လည်း​ကျွန်​တော်​မျိုး​အား သ​နား​တော်​မူ​၍","poem":2},{"text":"ကျွန်​တော်​မျိုး​၏​ဆု​တောင်း​ပတ္ထ​နာ​ကို နား​ညောင်း​တော်​မူ​ပါ။","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"အ​ချင်း​လူ​တို့၊သင်​တို့​သည်​အ​ဘယ်​ကာ​လ​တိုင် အောင် ငါ့​အား​စော်​ကား​ကြ​မည်​နည်း။","poem":1},{"text":"အ​ဘယ်​ကာ​လ​တိုင်​အောင်​သင်​တို့​သည် အ​ကျိုး​မ​ရှိ​သည့်​အ​ရာ​ကို​နှစ်​သက်​၍","poem":2},{"text":"အ​မှား​နောက်​သို့​လိုက်​ကြ​မည်​နည်း။","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​မိ​မိ​၏​အ​ဖို့​အ​လို့​ငှာ","poem":1},{"text":"သူ​တော်​ကောင်း​အား​ရွေး​ချယ်​ထား​တော်​မူ​သည်​ကို သိ​မှတ်​ကြ​လော့။","poem":2},{"text":"ငါ​ခေါ်​သော​အ​ခါ​ကိုယ်​တော်​ကြား​တော်​မူ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"သင်​တို့​သည်​ကြောက်​လန့်​လျက်​အ​ပြစ်​ဒု​စ​ရိုက်​ကို ရှောင်​ကြ​လော့။","poem":1},{"text":"သင်​တို့​သည်​အိပ်​ရာ​ပေါ်​တွင်​တစ်​ကိုယ်​တည်း ဆိတ်​ငြိမ်​စွာ","poem":2},{"text":"ဤ​အ​ချက်​ကို​နက်​နက်​နဲ​နဲ​စဉ်း​စား​ဆင်​ခြင် ကြ​လော့။","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ထာ​ဝ​ရ​ဘု​ရား​အား​ထိုက်​လျောက်​သည့်","poem":1},{"text":"ယဇ်​များ​ကို​ပူ​ဇော်​၍​ကိုယ်​တော်​ကို ယုံ​ကြည်​ကိုး​စား​ကြ​လော့။","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"``အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကောင်း​ချီး​မင်္ဂ​လာ​ကို​ထပ်​မံ​၍​ချ​ပေး​တော်​မူ​ပါ။","poem":2},{"text":"ကျွန်​တော်​မျိုး​တို့​အား​က​ရု​ဏာ​စိတ်​ဖြင့်","poem":1},{"text":"ကြည့်​တော်​မူ​ပါ'' ဟု​လူ​အ​များ​က​ဆု​တောင်း ကြ​၏။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"သို့​ရာ​တွင်​ကျွန်​တော်​မျိုး​အား​ကိုယ်​တော် ပေး​တော်​မူ​သော​ဝမ်း​မြောက်​ခြင်း​သည်","poem":1},{"text":"ဂျုံ​စ​ပါး​နှင့်​စ​ပျစ်​ရည်​ပေါ​များ​သူ​တို့​ရ​ရှိ​သည့် ဝမ်း​မြောက်​ခြင်း​ထက်​သာ​လွန်​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ကျွန်​တော်​မျိုး​သည်​လဲ​လျောင်း​လိုက်​သော​အ​ခါ ငြိမ်​သက်​စွာ​အိပ်​ပျော်​သွား​ပါ​၏။","poem":1},{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":2},{"text":"ကိုယ်​တော်​သာ​လျှင်​ကျွန်​တော်​မျိုး​အား​လုံ​ခြုံ​စွာ နေ​နိုင်​ခွင့်​ကို​ပေး​တော်​မူ​ပါ​၏။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}