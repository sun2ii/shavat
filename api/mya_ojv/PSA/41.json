{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":41,"content":[{"type":"heading","content":["လူ​မ​မာ​တစ်​ဦး​၏​ဆု​တောင်း​ပတ္ထနာ41:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"ဆင်း​ရဲ​သူ​တို့​အ​တွက်​စိုး​ရိမ်​ကြောင့်​ကြ​သော​သူ​သည် မင်္ဂ​လာ​ရှိ​၏။","poem":1},{"text":"ထို​သူ​ဒုက္ခ​ရောက်​သော​အ​ခါ​ထာ​ဝ​ရ​ဘု​ရား ကူ​မ​တော်​မူ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​သူ့​အား","poem":1},{"text":"ကွယ်​ကာ​စောင့်​ထိန်း​တော်​မူ​၍​သူ​၏​အ​သက်​ကို စောင့်​ထိန်း​တော်​မူ​လိမ့်​မည်။","poem":2},{"text":"ကိုယ်​တော်​သည်​သူ့​အား​ပြည်​တော်​တွင်​ဝမ်း မြောက်​စွာ နေ​ရ​သော​အ​ခွင့်​ကို​ပေး​တော်​မူ​လိမ့်​မည်။","poem":1},{"text":"ရန်​သူ​တို့​၏​လက်​သို့​အပ်​တော်​မူ​မည်​မ​ဟုတ်။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"သူ​ဖျား​နာ​ချိန်​၌​ကိုယ်​တော်​သည်​ကူ​မ​တော်​မူ​၍ သူ့​အား​ပြန်​လည်​ကျန်း​မာ​စေ​တော်​မူ​လိမ့်​မည်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"``အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင်​အား​ပြစ်​မှား​ပါ​ပြီ။","poem":2},{"text":"ကျွန်​တော်​မျိုး​အား​သ​နား​တော်​မူ​၍​ရော​ဂါ​ကို ပျောက်​ကင်း​စေ​တော်​မူ​ပါ'' ဟု​ငါ​လျှောက်​ထား​၏။","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ရန်​သူ​များ​သည်​ငါ​၏​အ​ကြောင်း​မ​ကောင်း ပြော​ကြ​၏။","poem":1},{"text":"သူ​တို့​က``ဤ​သူ​သည်​အ​ဘယ်​အ​ခါ​၌​သေ​၍","poem":2},{"text":"သူ​၏​နာ​မည်​ကို​လူ​တို့​မေ့​ပျောက်​သွား​မည်​နည်း'' ဟု​မ​နာ​လို​စိတ်​ဖြင့်​ဆို​ကြ​၏။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ငါ့​အား​လာ​၍​ကြည့်​ကြ​သူ​များ​သည်","poem":1},{"text":"စိတ်​ရိုး​သ​ဘော​ရိုး​ရှိ​သူ​များ​မ​ဟုတ်။","poem":2},{"text":"သူ​တို့​သည်​ငါ​၏​အ​ကြောင်း​မ​ကောင်း​သ​တင်း များ​ကို","poem":1},{"text":"ရှာ​ဖွေ​စု​ဆောင်း​လျက်​နေ​ရာ​အ​နှံ့​အ​ပြား​သို့ သွား​၍​ပြော​ဆို​တတ်​ကြ​၏။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ငါ့​ကို​မုန်း​သော​သူ​အ​ပေါင်း​တို့​သည်​ငါ့​အ​ကြောင်း အ​ချင်း​ချင်း​တီး​တိုး​ပြော​ဆို​တတ်​ကြ​၏။","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"သူ​တို့​က``ဤ​သူ​သည်​အ​သဲ​အ​သန်​ဖျား နာ​လျက်​ရှိ​၏။","poem":1},{"text":"နောက်​တစ်​ဖန်​အ​ဘယ်​အ​ခါ​၌​မျှ​အိပ်​ရာ​ပေါ်​မှ ထ​နိုင်​တော့​မည်​မ​ဟုတ်'' ဟု​ဆို​ကြ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ငါ​အ​ချစ်​ဆုံး၊ငါ​အား​အ​ကိုး​ဆုံး၊ ငါ​နှင့်​ထ​မင်း​လက်​ဆုံ​စား​သူ၊","poem":1},{"text":"ငါ​၏​မိတ်​ဆွေ​က​ပင်​လျှင်​ငါ့​ကို​ခြေ​ဖြင့် ကျောက်​ကန်​လေပြီ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊ ရန်​သူ​တို့​ကို​က​လဲ့​စား​ချေ​နိုင်​ရန်","poem":1},{"text":"ကျွန်​တော်​မျိုး​အား​သ​နား​တော်​မူ​၍ ပြန်​လည်​ကျန်း​မာ​စေ​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ရန်​သူ​တို့​သည်​ကျွန်​တော်​မျိုး​အား အ​နိုင်​ရ​စေ​တော်​မ​မူ​မည်​ဖြစ်​၍","poem":1},{"text":"ကျွန်​တော်​မျိုး​အား​ကိုယ်​တော်​ရှင်","poem":2},{"text":"နှစ်​သက်​တော်​မူ​ကြောင်း​ကို​ကျွန်​တော်​မျိုး သိ​ရ​ပါ​လိမ့်​မည်။","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​သည်​မှန်​ရာ​ကို​ပြု​ကျင့်​သူ​ဖြစ် သ​ဖြင့်","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​အား ကူ​မ​တော်​မူ​၍","poem":2},{"text":"ကိုယ်​တော်​ရှင်​၏​ရှေ့​တော်​တွင်​ထာ​ဝ​စဉ်​နေ​ရ​ခွင့်​ကို ပေး​တော်​မူ​လိမ့်​မည်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​၏​ဘု​ရား​ဖြစ်​တော် မူ​သော ထာ​ဝ​ရ​ဘု​ရား​ကို​ထော​မ​နာ​ပြု​ကြ​လော့။","poem":1},{"text":"ကိုယ်​တော်​အား​ယ​ခု​မှ​စ​၍​ကာ​လ​အ​စဉ် အ​ဆက် ထော​မ​နာ​ပြု​ကြ​လော့။","poem":2},{"text":"အာ​မင်၊ အာ​မင်။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}