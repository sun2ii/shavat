{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":46,"content":[{"type":"heading","content":["ဘု​ရား​သ​ခင်​သည်​ငါ​တို့​နှင့်​အ​တူ​ရှိ​တော်​မူ​၏46:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ကော​ရ​၏​သား​များ​စပ်​ဆို​သော​သီ​ချင်း။"]},{"type":"verse","number":1,"content":[{"text":"ဘု​ရား​သ​ခင်​သည်​ငါ​တို့​ခို​လှုံ​ရာ၊ ငါ​တို့​စွမ်း​အား​ဖြစ်​တော်​မူ​၏။","poem":1},{"text":"ဒုက္ခ​ရောက်​ချိန်​၌​ငါ​တို့​အား​ကူ​မ​ရန်​အ​စဉ်​ပင် အ​သင့်​ရှိ​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"သို့​ဖြစ်​၍​ပ​ထ​ဝီ​မြေ​ကြီး​တုန်​လှုပ်​လျက်","poem":1},{"text":"တောင်​များ​သည်​နက်​ရှိုင်း​ရာ​သ​မုဒ္ဒ​ရာ​ထဲ​သို့ ကျ​လျှင်​သော်​လည်း​ကောင်း၊","poem":2},{"text":"ပင်​လယ်​လှိုင်း​တံ​ပိုး​ထ​၍​အ​သံ​မြည်​ဟည်း​သ​ဖြင့်","poem":1},{"text":"တောင်​များ​တုန်​လှုပ်​သော်​လည်း​ကောင်း​ငါ​တို့​သည် ကြောက်​လန့်​လိမ့်​မည်​မ​ဟုတ်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ဘု​ရား​သ​ခင်​၏​မြို့​တော်​တည်း​ဟူ​သော","poem":1},{"text":"အ​မြင့်​မြတ်​ဆုံး​ဘု​ရား​ကိန်း​ဝပ်​တော်​မူ​ရာ ဌာ​န​တော်​ကို​သာ​ယာ​ရွှင်​လန်း​စေ​သော မြစ်​ရှိ​၏။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ထို​မြို့​တော်​သည်​ဘု​ရား​သ​ခင်​ကိန်း​ဝပ်​တော် မူ​ရာ ဖြစ်​သ​ဖြင့်​အ​ဘယ်​အ​ခါ​၌​မျှ​မ​ပျက်​စီး​ရ။","poem":1},{"text":"နေ​အ​ရုဏ်​တက်​စ​အ​ချိန်​၌​ကိုယ်​တော်​သည် ကြွ​လာ​တော်​မူ​၍​ထို​မြို့​ကို​ကူ​မ​တော်​မူ လိမ့်​မည်။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"လူ​မျိုး​အ​ပေါင်း​တို့​သည်​ထိတ်​လန့်​တုန်​လှုပ်​ကြ​၏။","poem":1},{"text":"ဘု​ရား​သ​ခင်​မိန့်​မြွက်​တော်​မူ​သော​အ​ခါ ကမ္ဘာ​မြေ​ကြီး​သည်​အ​ရည်​ပျော်​လေ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"အ​နန္တ​တန်​ခိုး​ရှင်​ထာ​ဝ​ရ​ဘု​ရား​သည် ငါ​တို့​နှင့်​အ​တူ​ရှိ​တော်​မူ​၏။","poem":1},{"text":"ယာ​ကုပ်​၏​ဘု​ရား​သည်​ငါ​တို့​ခို​လှုံ​ရာ​ဖြစ် တော်​မူ​၏။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"လာ​ကြ၊ထာ​ဝ​ရ​ဘု​ရား​ပြု​တော်​မူ​သော အ​မှု​တော်​တို့​ကို​ကြည့်​ကြ​လော့။","poem":1},{"text":"ကမ္ဘာ​မြေ​ပေါ်​တွင်​ပြု​တော်​မူ​သော​အံ့​သြ​ဖွယ် အ​မှု​အ​ရာ​များ​ကို​ကြည့်​ကြ​လော့။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ကိုယ်​တော်​သည်​ကမ္ဘာ​တစ်​ဝန်း​လုံး​တွင် တိုက်​ခိုက်​မှု​များ​ကို​ငြိမ်း​စေ​တော်​မူ​၏။","poem":1},{"text":"လေး​တို့​ကို​ချိုး​၍​လှံ​တို့​ကို​အ​ပိုင်း​ပိုင်း​ဖြတ်​ကာ ဒိုင်း​တို့​ကို​မီး​ရှို့​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ကိုယ်​တော်​က``တိုက်​ခိုက်​မှု​ကို​ရပ်​စဲ​ကြ​လော့၊","poem":1},{"text":"ငါ​သည်​လူ​မျိုး​တ​ကာ​တို့​တွင်​လည်း​ကောင်း၊ ကမ္ဘာ​တစ်​ဝန်း​လုံး​တွင်​လည်း​ကောင်း","poem":2},{"text":"ဘု​ရား​ဖြစ်​တော်​မူ​သည်​ကို​သိ​မှတ်​ကြ​လော့'' ဟု မိန့်​တော်​မူ​၏။","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"အ​နန္တ​တန်​ခိုး​ရှင်​ဘု​ရား​သ​ခင်​သည် ငါ​တို့​နှင့်​အ​တူ​ရှိ​တော်​မူ​၏။","poem":1},{"text":"ယာ​ကုပ်​၏​ဘု​ရား​သည်​ငါ​တို့​ခို​လှုံ​ရာ​ဖြစ် တော်​မူ​၏။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":10}