{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":47,"content":[{"type":"heading","content":["တန်​ခိုး​အ​ကြီး​ဆုံး​ဘု​ရင်47:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ကော​ရ​၏​သား​များ​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"လူ​မျိုး​အ​ပေါင်း​တို့၊ရွှင်​လန်း​စွာ​လက်​ခုပ်​တီး ကြ​လော့။","poem":1},{"text":"အ​သံ​ကျယ်​စွာ​သီ​ချင်း​ဆို​၍​ထာ​ဝ​ရ​ဘု​ရား အား ထော​မ​နာ​ပြု​ကြ​လော့။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"အ​မြင့်​မြတ်​ဆုံး​ဖြစ်​တော်​မူ​သော​ထာ​ဝ​ရ​ဘု​ရား သည် ကြောက်​မက်​ဖွယ်​ကောင်း​ပေ​၏။","poem":1},{"text":"ကိုယ်​တော်​သည်​ကမ္ဘာ​တစ်​ဝန်း​လုံး​ကို","poem":2},{"text":"အ​စိုး​ရ​တော်​မူ​သော​ဘု​ရင်​မင်း​မြတ်​ဖြစ်​တော် မူ​၏။","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​သည်​ငါ​တို့​အား​လူ​မျိုး​တ​ကာ​တို့​ကို အ​နိုင်​ရ​စေ​၍","poem":1},{"text":"တိုင်း​နိုင်​ငံ​တို့​ကို​အုပ်​စိုး​စေ​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ကိုယ်​တော်​သည်​ငါ​တို့​နေ​ထိုင်​ရာ​ပြည်​ကို ရွေး​ချယ်​ပေး​တော်​မူ​၏။","poem":1},{"text":"ထို​ပြည်​ကား​ကိုယ်​တော်​ချစ်​မြတ်​နိုး​တော်​မူ သော","poem":2},{"text":"လူ​စု​တော်​ပိုင်​ဆိုင်​၍​ဂုဏ်​ယူ​ဝါ​ကြွား​စ​ရာ​ဖြစ် ပေ​သည်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ဘု​ရား​သ​ခင်​သည်​မိ​မိ​၏​ရာ​ဇ​ပလ္လင်​တော်​သို့ တက်​ကြွ​တော်​မူ​၏။","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​တက်​ကြွ​တော်​မူ​သော​အ​ခါ","poem":2},{"text":"ရွှင်​လန်း​ဝမ်း​မြောက်​စွာ​ကြွေး​ကြော်​သည့်​အ​သံ များ​နှင့် တံ​ပိုး​ခ​ရာ​မှုတ်​သံ​များ​ကို​ကြား​ရ​ကြ​၏။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ဘု​ရား​သ​ခင်​အား​ထော​မ​နာ​ပြု​ကြ​လော့။ ငါ​တို့​ဘု​ရင်​အား​ချီး​မွမ်း​သီ​ချင်း​ဆို​ကြ​လော့။","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ဘု​ရား​သ​ခင်​သည်​ကမ္ဘာ​တစ်​ဝန်း​လုံး​၏​ဘု​ရင်","poem":1},{"text":"ဖြစ်​တော်​မူ​၏။","poem":2},{"text":"သီ​ချင်း​များ​ဖြင့်​ကိုယ်​တော်​အား​ထော​မ​နာ​ပြု ကြ​လော့။","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ဘု​ရား​သ​ခင်​သည်​သန့်​ရှင်း​မြင့်​မြတ်​သော ရာ​ဇ​ပလ္လင်​တော်​ပေါ်​တွင်​ထိုင်​တော်​မူ​၏။","poem":1},{"text":"တိုင်း​နိုင်​ငံ​အ​ပေါင်း​ကို​အုပ်​စိုး​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"တိုင်း​နိုင်​ငံ​တို့​ကို​အုပ်​စိုး​သည့်​မင်း​တို့​သည် လာ​၍","poem":1},{"text":"အာ​ဗြ​ဟံ​ကိုး​ကွယ်​သော​ထာ​ဝ​ရ​ဘု​ရား​၏ လူ​စု​တော်​နှင့်​အ​တူ​စု​ဝေး​ကြ​ကုန်​၏။","poem":2},{"text":"ကိုယ်​တော်​သည်​လော​က​စစ်​တပ်​ရှိ​သ​မျှ​တို့ ထက် တန်​ခိုး​ကြီး​တော်​မူ​၏။","poem":1},{"text":"ကိုယ်​တော်​သည်​တန်​ခိုး​အ​ကြီး​ဆုံး​ဘု​ရင် ဖြစ်​တော်​မူ​ပါ​၏။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}