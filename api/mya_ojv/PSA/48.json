{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":48,"content":[{"type":"heading","content":["ထာ​ဝ​ရ​ဘု​ရား​၏​မြို့​တော်​ဇိ​အုန်48:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ကော​ရ​၏​သား​များ​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ကြီး​မြတ်​တော်​မူ​၍​သန့်​ရှင်း မြင့်​မြတ်​သည့်​တောင်​တော် တည်း​ဟူ​သော","poem":1},{"text":"ငါ​တို့​ဘု​ရား​၏​မြို့​တော်​တွင်​အ​လွန် ထော​မ​နာ​ပြု​ခြင်း​ကို​ခံ​ထိုက်​ပေ​၏။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ဘု​ရား​သ​ခင်​၏​တောင်​တော်​ဖြစ်​သည့်","poem":1},{"text":"ဇိ​အုန်​တောင်​သည်​မြင့်​မား​၍​လှ​ပ​တင့်​တယ် ပါ​၏။","poem":2},{"text":"မ​ဟာ​မင်း​မြတ်​၏​မြို့​တော်​သည်​ကမ္ဘာ​သူ ကမ္ဘာ​သား​တို့​အား​စိတ်​ရွှင်​လန်း​စေ​ပါ​၏။","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ထို​မြို့​တော်​၏​ခံ​တပ်​များ​အ​တွင်း​အ​ထံ တော်​တွင်","poem":1},{"text":"ဘေး​မဲ့​လုံ​ခြုံ​မှု​ရှိ​ကြောင်း​ကို​ဘု​ရား​သ​ခင် ပြ​သ​တော်​မူ​ပြီ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ရှင်​ဘု​ရင်​တို့​သည်​စု​ရုံး​လျက်​ဇိ​အုန်​တောင်​ကို တိုက်​ခိုက်​ရန်​ချီ​တက်​လာ​ကြ​၏။","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ထို​တောင်​ကို​မြင်​သော​အ​ခါ​သူ​တို့​သည် အံ့​သြ​ထိတ်​လန့်​၍​ထွက်​ပြေး​ကြ​၏။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"သူ​တို့​သည်​သား​ဖွား​ချိန်​နီး​သည့် အ​မျိုး​သ​မီး​ကဲ့​သို့​လည်း​ကောင်း၊","poem":1},{"text":"ပြင်း​ထန်​သော​လေ​မုန်​တိုင်း​မိ​သ​ဖြင့်​လူး​နေ​ရ​သော","poem":2},{"text":"သင်္ဘော​ကြီး​များ​ကဲ့​သို့​လည်း​ကောင်း ထိတ်​လန့်​တုန်​လှုပ်​ကြ​ကုန်​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ကိုယ်​တော်​ပြု​တော်​မူ​သော​အ​မှု​အ​ရာ​များ​ကို ငါ​တို့​ကြား​ဖူး​ကြ​၏။","poem":1},{"text":"ယင်း​သို့​ကြား​ဖူး​ကြ​သည့်​အ​တိုင်း​အ​နန္တ​တန်​ခိုး​ရှင်","poem":2},{"text":"ထာ​ဝ​ရ​ဘု​ရား​တည်း​ဟူ​သော​ငါ​တို့​ဘု​ရား​၏ မြို့​တော်​တွင်​ယ​ခု​ငါ​တို့​တွေ့​မြင်​ကြ​ရ​လေ​ပြီ။","poem":1},{"text":"ကိုယ်​တော်​သည်​ထို​မြို့​တော်​ကို​ကာ​လ​အ​စဉ်​အ​ဆက် ဘေး​မဲ့​လုံ​ခြုံ​စွာ​ထား​တော်​မူ​လိမ့်​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​၏​ဗိ​မာန်​တော်​အ​တွင်း​၌","poem":2},{"text":"ကျွန်​တော်​မျိုး​တို့​သည်​ကိုယ်​တော်​၏​ခိုင်​မြဲ​သော မေတ္တာ​တော်​အ​ကြောင်း​ကို​ဆင်​ခြင်​ကြ​ပါ​၏။","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"နေ​ရာ​တ​ကာ​တွင်​လူ​အ​ပေါင်း​တို့​သည် ကိုယ်​တော်​ရှင်​အား​ထော​မ​နာ​ပြု​ကြ​ပါ​၏။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​၏​ဂုဏ်​သ​တင်း​သည် ကမ္ဘာ​တစ်​ဝန်း​လုံး​သို့​ပျံ့​နှံ့​နေ​ပါ​၏။","poem":2},{"text":"ကိုယ်​တော်​ရှင်​သည်​တ​ရား​မျှ​တ​စွာ အုပ်​စိုး​တော်​မူ​ပါ​၏။","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ဇိ​အုန်​မြို့​သူ​မြို့​သား​တို့​သည်​ဝမ်း​မြောက် ကြ​ပါ​စေ။","poem":1},{"text":"ကိုယ်​တော်​သည်​ဖြောင့်​မှန်​စွာ​တ​ရား​စီ​ရင် တော်​မူ​ပါ​၏။","poem":2},{"text":"ယု​ဒ​ပြည်​မြို့​ကြီး​များ​တွင်​ရွှင်​လန်း​မှု​ရှိ ပါ​စေ။","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ဘု​ရား​သ​ခင်​၏​လူ​စု​တော်​ဝင်​တို့၊ဇိ​အုန်​တောင် ကို လှည့်​ပတ်​၍​ပြ​အိုး​တို့​ကို​ရေ​တွက်​လော့။","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ထို​မြို့​၏​တံ​တိုင်း​များ​ကို​မှတ်​သား​၍​ခံ​တပ် များ​ကို စစ်​ဆေး​ကြည့်​ရှု​ကြ​လော့။","poem":1},{"text":"ထို​အ​ခါ​သင်​တို့​သည်``ဤ​ဘု​ရား​ကား ကမ္ဘာ​အ​ဆက်​ဆက်​ငါ​တို့​၏​ဘု​ရား​ဖြစ်​တော်​မူ​၏။","poem":2},{"text":"ကိုယ်​တော်​သည်​ထာ​ဝ​စဉ်​ငါ​တို့​အား လမ်း​ပြ​ပို့​ဆောင်​တော်​မူ​လိမ့်​မည်'' ဟု","poem":1},{"text":"နောင်​လာ​နောက်​သား​တို့​အား ပြော​ကြား​နိုင်​ကြ​လိမ့်​မည်။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":12}