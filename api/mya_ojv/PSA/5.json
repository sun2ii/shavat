{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":5,"content":[{"type":"heading","content":["ကွယ်​ကာ​စောင့်​ထိန်း​တော်​မူ​ရန် ဆု​တောင်း​ပတ္ထနာ5:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​မြွက်​ဆို​ချက်​ကို​နား​ထောင်​တော်​မူ​ပါ။","poem":2},{"text":"ကျွန်​တော်​မျိုး​၏​မြည်​တမ်း​သံ​များ​ကို​ကြား​တော်​မူ​ပါ။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​၏​ဘု​ရင်၊ကျွန်​တော်​မျိုး​၏​ဘု​ရား၊ ကူ​မ​တော်​မူ​ရန်","poem":1},{"text":"ကျွန်​တော်​မျိုး​ဟစ်​အော်​တောင်း​လျှောက်​သည်​ကို နား​ထောင်​တော်​မူ​ပါ။","poem":2},{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​အ​ထံ​တော်​သို့​ဆု​တောင်း ပတ္ထ​နာ​ပြု​ပါ​သည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ကိုယ်​တော်​သည်​နံ​နက်​ချိန်​၌​ကျွန်​တော်​မျိုး​၏ ပတ္ထ​နာ​သံ​ကို​ကြား​ပါ​၏။","poem":1},{"text":"နေ​ထွက်​ချိန်​၌​ကျွန်​တော်​မျိုး​ဆု​တောင်း​၍ ကိုယ်​တော်​၏​အ​ဖြေ​ကို​စောင့်​မျှော်​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ကိုယ်​တော်​သည်​ဒု​စ​ရိုက်​ကို​နှစ်​သက်​တော်​မူ​သော ဘု​ရား​မ​ဟုတ်​ပါ။","poem":1},{"text":"ရှေ့​တော်​၌​ဆိုး​ယုတ်​မှု​ကို​ခွင့်​ပြု​တော်​မ​မူ​ပါ။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"မာ​န​ကြီး​သူ​တို့​သည်​ရှေ့​တော်​သို့​မ​ဝင်​ရ။","poem":1},{"text":"ကိုယ်​တော်​သည်​ယုတ်​မာ​သူ​အ​ပေါင်း​တို့​ကို မုန်း​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ကိုယ်​တော်​သည်​လိမ်​လည်​သူ​အ​ပေါင်း​တို့​ကို ဖျက်​ဆီး​တော်​မူ​၍​အ​ကြမ်း​ဖက်​သူ၊","poem":1},{"text":"ကောက်​ကျစ်​သူ​တို့​ကို​စက်​ဆုပ်​ရွံ​ရှာ​တော်​မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ကျွန်​တော်​မျိုး​အ​ဖို့​မှာ​မူ​ကိုယ်​တော်​၏​ကြီး မား​သော မေတ္တာ​တော်​ကို​ခံ​စား​ရ​သ​ဖြင့်","poem":1},{"text":"အိမ်​တော်​သို့​ဝင်​နိုင်​ပါ​၏။","poem":2},{"text":"ကိုယ်​တော်​၏​သန့်​ရှင်း​မြင့်​မြတ်​သော​ဗိ​မာန်​တော်​တွင် ကိုး​ကွယ်​ဝတ်​ပြု​ကာ","poem":1},{"text":"ကိုယ်​တော်​အား​ရို​သေ​လေး​မြတ်​စွာ ဦး​ညွှတ်​ရှိ​ခိုး​နိုင်​ပါ​၏။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​မှာ​ရန်​သူ​များ​စွာ​ရှိ​ပါ​၏။","poem":2},{"text":"ကိုယ်​တော်​၏​အ​လို​တော်​အ​တိုင်း​ပြု​ကျင့်​ရန် ကျွန်​တော်​မျိုး​အား​လမ်း​ပြ​တော်​မူ​ပါ။","poem":1},{"text":"ကျွန်​တော်​မျိုး​အား​ကိုယ်​တော်​ရှင်","poem":2},{"text":"လိုက်​လျှောက်​စေ​လို​သည့်​လမ်း​ကို ဖြောင့်​ဖြူး​စေ​တော်​မူ​ပါ။","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ကျွန်​တော်​မျိုး​၏​ရန်​သူ​များ​စ​ကား​ကို အ​ဘယ်​အ​ခါ​၌​ယုံ​ကြည်​၍​မ​ရ​ပါ။","poem":1},{"text":"သူ​တို့​တွင်​ဖျက်​ဆီး​လို​စိတ်​သာ​လျှင်​ရှိ​ပါ​၏။","poem":2},{"text":"သူ​တို့​၏​ခံ​တွင်း​သည်​ပွင့်​လျက်​နေ​သော သင်္ချိုင်း​တွင်း​နှင့်​တူ​ပါ​၏။","poem":1},{"text":"သူ​တို့​၏​လျှာ​သည်​လည်း​မြှောက်​ပင့်​လိမ်​လည် လှည့်​စား​တတ်​ပါ​၏။","poem":2}]},{"type":"verse","number":10,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊","poem":1},{"text":"သူ​တို့​အား​ရှုတ်​ချ​လျက်​အ​ပြစ်​ဒဏ်​ပေး​တော်​မူ​ပါ။","poem":2},{"text":"သူ​တို့​၏​ဆိုး​ညစ်​သော​အ​ကြံ​အ​စည်​များ​က","poem":1},{"text":"သူ​တို့​ကို​ပင်​အ​ကျိုး​နည်း​စေ​တော်​မူ​ပါ။","poem":2},{"text":"သူ​တို့​၏​များ​မြောင်​သော","poem":1},{"text":"အ​ပြစ်​များ​ကြောင့်​လည်း​ကောင်း၊ကိုယ်​တော်​ကို ပုန်​ကန်​ကြ​သည့်​အ​တွက်​ကြောင့်​လည်း​ကောင်း","poem":2},{"text":"သူ​တို့​အား​ရှေ့​တော်​မှောက်​မှ​နှင်​ထုတ်​တော်​မူ​ပါ။","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"သို့​ရာ​တွင်​ကိုယ်​တော်​ရှင်​ထံ​တော်​တွင်​လုံ​ခြုံ​စွာ","poem":1},{"text":"ခို​လှုံ​ကြ​သော​သူ​အ​ပေါင်း​တို့​သည် ဝမ်း​မြောက်​ရွှင်​လန်း​ရ​ကြ​ပါ​လိမ့်​မည်။","poem":2},{"text":"သူ​တို့​သည်​ဝမ်း​မြောက်​သ​ဖြင့်​အ​စဉ် သီ​ချင်း​ဆို​ကြ​ပါ​လိမ့်​မည်။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​မိ​မိ​အား​ချစ်​သူ​တို့​ကို ကွယ်​ကာ​စောင့်​ထိန်း​တော်​မူ​ပါ​၏။","poem":2},{"text":"ကိုယ်​တော်​ရှင်​ကြောင့်​သူ​တို့​သည်​အ​ကယ်​ပင် ဝမ်း​မြောက်​ရ​ကြ​ပါ​၏။","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​မိ​မိ​စ​ကား​ကို​နား​ထောင် သူ​တို့​အား​ကောင်း​ချီး​ပေး​တော်​မူ​ပါ​၏။","poem":2},{"text":"ကိုယ်​တော်​၏​မေတ္တာ​တော်​သည်​ဒိုင်း​လွှား​သ​ဖွယ် သူ​တို့​အား​ကွယ်​ကာ​စောင့်​ရှောက်​တော်​မူ​ပါ​၏။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}