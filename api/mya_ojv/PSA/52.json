{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":52,"content":[{"type":"heading","content":["ဘု​ရား​သ​ခင်​၏​တ​ရား​စီ​ရင်​တော်​မူ​ခြင်း​နှင့် ကျေး​ဇူး​တော်52:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ အ​ဟိ​မ​လက်​အိမ်​သို့​ဒါ​ဝိဒ်​ရောက်​ကြောင်း ကို​ဧ​ဒုံ​အ​မျိုး​သား​ဒေါ​ဂ​သည်​ရှော​လု​ထံ သို့​သွား​ရောက်​၍​လျှောက်​ထား​ပြီး​နောက်​ဒါ​ဝိဒ် စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"တန်​ခိုး​ကြီး​သော​အ​ချင်း​လူ၊အ​ဘယ်​ကြောင့် မိ​မိ​၏​ဆိုး​ညစ်​မှု​ကို​ကြွား​ဝါ​သ​နည်း။","poem":1},{"text":"ဘု​ရား​သ​ခင်​၏​သစ္စာ​တော်​သည်​အ​စဉ်​အ​မြဲ​တည်​၏။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"သင်​သည်​သူ​တစ်​ပါး​ပျက်​စီး​ရာ​ပျက်​စီး​ကြောင်း​ကို ကြံ​စည်​တတ်​၏။","poem":1},{"text":"သင်​၏​လျှာ​သည်​သင်​တုန်း​ဋ္ဌား​ကဲ့​သို့​ထက်​မြက်​၏။","poem":2},{"text":"သင်​သည်​မ​ဟုတ်​မ​မှန်​သည့်​စ​ကား​ကို​အ​စဉ်​ပင် လုပ်​ကြံ​ပြော​ဆို​တတ်​၏။","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"သင်​သည်​အ​ကောင်း​ထက်​အ​ဆိုး​ကို​လည်း​ကောင်း၊","poem":1},{"text":"သစ္စာ​စ​ကား​ထက်​မု​သား​စ​ကား​ကို​လည်း​ကောင်း ပို​၍​နှစ်​သက်​တတ်​၏။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"အ​ချင်း​လူ​လိမ်၊သင်​သည်​မိ​မိ​၏​နှုတ်​အား​ဖြင့်","poem":1},{"text":"လူ​တို့​အား​ထိ​ခိုက်​နစ်​နာ​အောင်​ပြော​ဆို​ရန် နှစ်​သက်​ပါ​သည်​တ​ကား။","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"သို့​ဖြစ်​၍​ဘု​ရား​သ​ခင်​သည်​သင့်​အား​ထာ​ဝ​စဉ် ပြို​လဲ​စေ​တော်​မူ​လိမ့်​မည်။","poem":1},{"text":"ကိုယ်​တော်​သည်​သင့်​ကို​နေ​အိမ်​မှ​ဆွဲ​ထုတ် တော်​မူ​လိမ့်​မည်။","poem":2},{"text":"သင့်​ကို​သက်​ရှင်​နေ​သူ​တို့​နေ​ထိုင်​ရာ​လူ့​ပြည်​မှ ဖယ်​ရှား​တော်​မူ​လိမ့်​မည်။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"သူ​တော်​ကောင်း​တို့​သည်​ဤ​အ​ခြင်း​အ​ရာ​ကို မြင်​လျှင် ကြောက်​လန့်​ကြ​လိမ့်​မည်။","poem":1},{"text":"သူ​တို့​သည်​သင့်​အား​ကြည့်​၍​ပြုံး​ရယ်​ကြ​လျက်","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"``မိ​မိ​၏​လုံ​ခြုံ​မှု​အ​တွက်​ထာ​ဝ​ရ​ဘု​ရား​ကို","poem":1},{"text":"အား​ကိုး​မည့်​အ​စား​မိ​မိ​၏​စည်း​စိမ်​ချမ်း​သာ ကို အား​ကိုး​သူ​ကို​ကြည့်​ကြ​လော့။","poem":2},{"text":"သူ​သည်​ယုတ်​မာ​မှု​အား​ဖြင့်​မိ​မိ​၏​လုံ​ခြုံ​မှု​ကို ရှာ​သူ​ဖြစ်​၏'' ဟု​ဆို​ကြ​လိမ့်​မည်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ငါ​မူ​ကား​ထာ​ဝ​ရ​ဘု​ရား​၏​အိမ်​တော်​အ​နီး​တွင် ပေါက်​သည့်​သံ​လွင်​ပင်​နှင့်​တူ​၏။","poem":1},{"text":"ငါ​သည်​ကိုယ်​တော်​၏​ခိုင်​မြဲ​သော​မေတ္တာ​ကို ကာ​လ​အ​စဉ်​အ​မြဲ​ကိုး​စား​၏။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​ပြု​တော်​မူ​သော​အ​မှု​တော်​အ​တွက်","poem":2},{"text":"ကျွန်​တော်​မျိုး​သည်​အ​စဉ်​အ​မြဲ​ကျေး​ဇူး​တော်​ကို ချီး​မွမ်း​ပါ​မည်။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကောင်း​မြတ်​တော်​မူ​ကြောင်း​ကို","poem":2},{"text":"ကိုယ်​တော်​ရှင်​၏​လူ​စု​တော်​ရှေ့​တွင်​ထုတ်​ဖော် ကြေ​ညာ​ပါ​မည်။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}