{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":53,"content":[{"type":"heading","content":["လူ​တို့​၏​ဆိုး​ညစ်​ယုတ်​မာ​မှု53:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သော​က​ဗျာ။"]},{"type":"verse","number":1,"content":[{"text":"လူ​မိုက်​တို့​က``ဘု​ရား​မ​ရှိ'' ဟု​တွေး​တော ထင်​မှတ်​တတ်​ကြ​၏။","poem":1},{"text":"သူ​တို့​အား​လုံး​ပင်​အ​ကျင့်​ပျက်​ပြား​၍ စက်​ဆုပ်​သော​အ​မှု​တို့​ကို​ပြု​ကြ​လေ​ပြီ။","poem":2},{"text":"မှန်​ရာ​ကို​ပြု​ကျင့်​သူ​တစ်​ယောက်​မျှ​မ​ရှိ။","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ဘု​ရား​သ​ခင်​သည်​အ​သိ​ပ​ညာ​ရှိ​သူ​များ၊ မိ​မိ​အား ကိုး​ကွယ်​ဝတ်​ပြု​သူ​များ​ရှိ​မ​ရှိ​ကို​သိ​မြင် နိုင်​ရန်","poem":1},{"text":"ကောင်း​ကင်​ဘုံ​မှ​လူ​သား​တို့​အား​ကြည့်​တော် မူ​၏။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"သို့​ရာ​တွင်​လူ​တို့​သည်​ကိုယ်​တော်​အား ကျော​ခိုင်း​ကြ​ကုန်​လေ​ပြီ။","poem":1},{"text":"သူ​တို့​အား​လုံး​ပင်​လျှင်​တ​ညီ​တ​ညွတ်​တည်း ဆိုး​ညစ်​ကြ​၏။","poem":2},{"text":"သူ​တို့​တွင်​မှန်​ရာ​ကို​ပြု​ကျင့်​သူ​မ​ရှိ။","poem":1},{"text":"တစ်​ဦး​တစ်​ယောက်​မျှ​မ​ရှိ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ဘု​ရား​သ​ခင်​က","poem":1},{"text":"``သူ​တို့​သည်​မ​သိ​နား​မ​လည်​သူ​များ​ပေ​လော။","poem":2},{"text":"ဤ​သူ​ယုတ်​မာ​များ​သည်​အ​သိ​ပ​ညာ​ကင်း​မဲ့ သူ​များ​ပေ​လော။","poem":1},{"text":"သူ​တို့​သည်​ငါ​၏​လူ​စု​တော်​ဝင်​များ​ထံ​မှ လု​ယူ​တိုက်​ခိုက်​၍​အ​သက်​မွေး​ကြ​ကုန်​၏။","poem":2},{"text":"ငါ့​ထံ​သို့​လည်း​ဆု​တောင်း​ပတ္ထ​နာ​မ​ပြု​ကြ'' ဟု မိန့်​တော်​မူ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"သို့​ရာ​တွင်​ဘု​ရား​သ​ခင်​သည်​ကိုယ်​တော့် လူ​စု​တော်​၏ ရန်​သူ​များ​၏​အ​ရိုး​များ​ကို","poem":1},{"text":"ဖ​ရို​ဖ​ရဲ​ကွဲ​လွင့်​စေ​တော်​မူ​မည်​ဖြစ်​၍​သူ​တို့​သည်","poem":2},{"text":"တစ်​ခါ​မျှ​မ​ခံ​စား​ခဲ့​ဘူး​သည့်​ကြောက်​ခြင်း​မျိုး ဖြင့် အ​လွန်​ကြောက်​လန့်​ကြ​လိမ့်​မည်။","poem":1},{"text":"ဘု​ရား​သ​ခင်​သည်​သူ​တို့​ကို​ပစ်​ပယ်​တော်​မူ ပြီ​ဖြစ်​၍","poem":2},{"text":"ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​သည်​လုံး​ဝ​အ​နိုင် ရ​ကြ​လိမ့်​မည်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​ကို​ကယ်​တင်​ခြင်း ကျေး​ဇူး​တော်​သည်​ဇိ​အုန်​တောင်​တော်​မှ","poem":1},{"text":"ထွက်​ပေါ်​လာ​စေ​ရန်​ငါ​သည်​စိတ်​အား​ထက်​သန်​စွာ ဆု​တောင်း​ပတ္ထ​နာ​ပြု​ပါ​၏။","poem":2},{"text":"ဘု​ရား​သ​ခင်​သည်​ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့ အား","poem":1},{"text":"တစ်​ဖန်​ပြန်​လည်​၍​ကောင်း​စား​စေ​တော်​မူ​သော အ​ခါ သူ​တို့​သည်​လွန်​စွာ​ဝမ်း​မြောက်​ကြ​လိမ့်​မည်။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}