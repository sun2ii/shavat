{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":55,"content":[{"type":"heading","content":["သစ္စာ​မဲ့​မိတ်​ဆွေ​စွန့်​ပယ်​ခြင်း​ခံ​ရ​သူ​၏ ဆု​တောင်း​ပတ္ထ​နာ55:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​ဆု​တောင်း​ပတ္ထ​နာ​ကို​ကြား​တော်​မူ​ပါ။","poem":2},{"text":"ကျွန်​တော်​မျိုး​ပန်​ကြား​သော​အ​ခါ မျက်​နှာ​လွှဲ​တော်​မ​မူ​ပါ​နှင့်။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​တောင်း​လျှောက်​သည်​ကို နား​ထောင်​တော်​မူ​၍​ထူး​တော်​မူ​ပါ။","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​စိုး​ရိမ်​ပူ​ပန်​မှု​များ​ဖြင့် အား​အင်​ကုန်​ခန်း​လျက်​နေ​ပါ​၏။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ရန်​သူ​များ​၏​ခြိမ်း​ခြောက်​မှု​ကြောင့်​ကျွန်​တော်​မျိုး ကြောက်​လန့်​ပါ​၏။","poem":1},{"text":"သူ​ယုတ်​မာ​တို့​၏​နှိပ်​စက်​ညှဉ်း​ဆဲ​မှု​ကြောင့် ကျွန်​တော်​မျိုး​စိတ်​ပျက်​အား​လျော့​ပါ​၏။","poem":2},{"text":"သူ​တို့​သည်​ကျွန်​တော်​မျိုး​အား​ဆင်း​ရဲ​ဒုက္ခ ရောက်​စေ​ကြ​ပါ​၏။","poem":1},{"text":"သူ​တို့​သည်​ကျွန်​တော်​မျိုး​အား​အ​မျက်​ထွက်​၍ မုန်း​ကြ​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ကျွန်​တော်​မျိုး​၏​စိတ်​နှ​လုံး​သည်​ကြောက်​လန့်​လျက် နေ​ပါ​၏။","poem":1},{"text":"သေ​ဘေး​ကို​လွန်​စွာ​ထိတ်​လန့်​လျက်​ရှိ​ပါ​၏။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ကြောက်​လန့်​တုန်​လှုပ်​လျက်၊လွန်​စွာ​တုန်​လှုပ် ချောက်​ချား​လျက်​ရှိ​ပါ​၏။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"အ​ကယ်​၍​ချိုး​ငှက်​ကဲ့​သို့​ငါ့​မှာ​အ​တောင်​များ","poem":1},{"text":"ရှိ​ခဲ့​ပါ​မူ​ငါ​သည်​အ​ဝေး​သို့​ပျံ​သွား​ကာ နား​နေ​စ​ရာ​အ​ရပ်​ကို​ရှာ​မည်။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ငါ​သည်​အ​လွန်​ဝေး​ရာ​အ​ရပ်​သို့​ပျံ​သွား​လျက် တော​ကန္တာ​ရ​တွင်​နေ​ထိုင်​ပါ​မည်။","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ငါ​သည်​လျင်​မြန်​စွာ​သွား​၍​လေ​ပြင်း​နှင့်","poem":1},{"text":"မိုး​သက်​မုန်​တိုင်း​တို့​မှ​အ​ကာ​အ​ကွယ်​ကို​ရှာ​မည်။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"အို ဘု​ရား​ရှင်၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​ရန်​သူ​များ​ပြော​ဆို​သည့် စ​ကား​များ​ကို​ရှုပ်​ထွေး​စေ​တော်​မူ​ပါ။","poem":2},{"lineBreak":true},{"text":"မြို့​တွင်း​၌​အ​ကြမ်း​ဖက်​မှု​နှင့်​လု​ယက်​မှု​တို့​ကို ကျွန်​တော်​မျိုး​မြင်​ပါ​၏။","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ထို​သူ​တို့​သည်​မြို့​ကို​နေ့​ည​မ​ပြတ်​ဝိုင်း​ရံ​ထား ကြ​ပါ​၏။","poem":1},{"text":"မြို့​ထဲ​တွင်​ရာ​ဇ​ဝတ်​မှု၊နှောင့်​ယှက်​မှု​များ​နှင့် ပြည့်​နှက်​လျက်​ရှိ​ပါ​၏။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"နေ​ရာ​တ​ကာ​တွင်​အ​ပျက်​အ​စီး​များ​ရှိ​နေ​ပါ​၏။","poem":1},{"text":"လမ်း​များ​၌​နှိပ်​စက်​ညှဉ်း​ဆဲ​မှု၊လိမ်​လည် လှည့်​စား​မှု​များ​နှင့်​ပြည့်​နှက်​လျက်​ရှိ​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"အ​ကယ်​၍​ငါ့​အား​ပြောင်​လှောင်​သူ​သည်","poem":1},{"text":"ငါ​၏​ရန်​သူ​ဖြစ်​ခဲ့​သော်​ငါ​သည်​သည်း​ခံ​နိုင် ပါ​၏။","poem":2},{"text":"ငါ့​ကို​အ​ကြောင်း​ပြု​၍​ကြွား​ဝါ​သော​ရန်​ဘက် ဖြစ်​ခဲ့​သော် ငါ​သည်​သူ့​ကို​ရှောင်​ရှား​နိုင်​၏။","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"သို့​ရာ​တွင်​ယင်း​သို့​ပြု​သူ​မှာ​ငါ​၏​အ​ပေါင်း​အ​ဖော်၊ လုပ်​ဖော်​ဆောင်​ဘက်၊","poem":1},{"text":"ရင်း​နှီး​သည့်​မိတ်​ဆွေ​ဖြစ်​သူ​ပင်​ဖြစ်​ပါ​သည်​တ​ကား။","poem":2}]},{"type":"verse","number":14,"content":[{"text":"သင်​နှင့်​ငါ​သည်​ရင်း​နှီး​စွာ​ဆွေး​နွေး​တိုင်​ပင်​ခဲ့​ကြ​၏။","poem":1},{"text":"ဗိ​မာန်​တော်​တွင်​လည်း​အ​တူ​တူ ကိုး​ကွယ်​ဝတ်​ပြု​ခဲ့​ကြ​၏။","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ငါ​၏​ရန်​သူ​များ​သည်​သေ​နေ့​မ​စေ့​မီ သေ​ရ​ကြ​ပါ​စေ​သော။","poem":1},{"text":"အ​ရှင်​လတ်​လတ်​သေ​ရွာ​သို့​သွား​ရ​ကြ​ပါ​စေ​သော။","poem":2},{"text":"သူ​တို့​၏​နေ​အိမ်​များ​သည်​ဆိုး​ညစ်​မှု​ကြီး​စိုး​ရာ ဌာ​န​များ​ဖြစ်​ကြ​၏။","poem":1},{"text":"သူ​တို့​၏​စိတ်​နှ​လုံး​သည်​ဆိုး​ညစ်​မှု​နှင့် ပြည့်​နှက်​လျက်​ရှိ​၏။","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ငါ​မူ​ကား​ထာ​ဝ​ရ​ဘု​ရား​၏​ထံ​တော်​သို့ ကူ​မ​တော်​မူ​ရန်​ဆု​တောင်း​ပတ္ထ​နာ​ပြု​၏။","poem":1},{"text":"ကိုယ်​တော်​သည်​ငါ့​ကို​ကယ်​တော်​မူ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ငါ​၏​ညည်း​တွား​မြည်​တမ်း​သံ​များ​သည်​နံ​နက်​ချိန်၊ မွန်း​တည့်​ချိန်၊ညဥ့်​အ​ချိန်​တို့​၌","poem":1},{"text":"အ​ထံ​တော်​သို့​ရောက်​သ​ဖြင့်​ကိုယ်​တော်​သည် ကြား​တော်​မူ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ဤ​မျှ​များ​လှ​သော​ရန်​သူ​တို့​နှင့်","poem":1},{"text":"တိုက်​ခိုက်​ရာ​စစ်​ပွဲ​များ​မှ​ငါ့​အား​ဘေး​မဲ့​လုံ​ခြုံ​စွာ ပြန်​လာ​စေ​တော်​မူ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ရှေး​ကမ္ဘာ​အ​ဆက်​ဆက်​မှ​စ​၍ လူ​သတ္တ​ဝါ​အ​ပေါင်း​တို့​အား","poem":1},{"text":"ပိုင်​သ​အုပ်​စိုး​တော်​မူ​သော​ဘု​ရား​သ​ခင်​သည်","poem":2},{"text":"ငါ​၏​ပတ္ထနာ​စ​ကား​ကို​ကြား​၍​ရန်​သူ​တို့​အား အ​ရေး​ရှုံး​နိမ့်​စေ​တော်​မူ​လိမ့်​မည်။","poem":1},{"text":"အ​ဘယ်​ကြောင့်​ဆို​သော်​သူ​တို့​သည်​စိတ်​နှ​လုံး ပြောင်း​လဲ​မှု​မ​ရှိ​ကြ။","poem":2},{"text":"ကိုယ်​တော်​ကို​လည်း​မ​ကြောက်​ရွံ့​ကြ​သော​ကြောင့် ဖြစ်​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ငါ​၏​မိတ်​ဆွေ​ဟောင်း​သည်​မိ​မိ​၏​မိတ်​ဆွေ​များ​ကို တိုက်​ခိုက်​၍​မိ​မိ​၏​က​တိ​ကို​လည်း​ဖျက်​၏။","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"သူ​၏​စ​ကား​တို့​သည်​ထော​ပတ်​ထက်​ပင် ချော​မွတ်​သော်​လည်း","poem":1},{"text":"သူ​၏​စိတ်​နှ​လုံး​ထဲ​၌​မူ​ကား မုန်း​တီး​တတ်​သော​သ​ဘော​ရှိ​၏။","poem":2},{"text":"သူ​၏​စ​ကား​တို့​သည်​ဆီ​ကဲ့​သို့​ပျော့​ပျောင်း သော်​လည်း ထက်​သော​ဋ္ဌား​ကဲ့​သို့​ထိ​ခိုက်​နာ​ကြင်​စေ​တတ်​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"သင်​၏​ဝန်​ကို​ထာ​ဝ​ရ​ဘု​ရား​အား​လွှဲ​အပ်​လော့။","poem":1},{"text":"ကိုယ်​တော်​သည်​သင့်​ကို​ကွယ်​ကာ​စောင့်​ရှောက် တော်​မူ​လိမ့်​မည်။","poem":2},{"text":"သူ​တော်​ကောင်း​တို့​ကို​အ​ဘယ်​အ​ခါ​၌ အ​ရေး​ရှုံး​နိမ့်​စေ​တော်​မူ​လိမ့်​မည်​မ​ဟုတ်။","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"သို့​ရာ​တွင် အို ဘု​ရား​သ​ခင်၊ကိုယ်​တော်​ရှင်​သည် လူ​သတ်​သ​မား​များ​နှင့်​လူ​လိမ်​များ​အား","poem":1},{"text":"သူ​တို့​သက်​တမ်း​ထက်​ဝက်​မ​ကျိုး​မီ​သင်္ချိုင်း တွင်း​သို့ သက်​ဆင်း​စေ​တော်​မူ​မည်။","poem":2},{"text":"ကျွန်​တော်​မျိုး​မူ​ကား​ကိုယ်​တော်​ရှင်​ကို​ကိုး​စား ပါ​မည်။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}