{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":56,"content":[{"type":"heading","content":["ဘု​ရား​သခင်​အား​ကိုး​စား​သူ​၏​ဆု​တောင်း ပတ္ထနာ56:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဂါ​သ​သည်​ဖိ​လိတ္တိ​အ​မျိုး​သား​တို့​လက်​တွင်း သို့​ရောက်​ပြီး​နောက်​ဒါ​ဝိဒ်​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​တိုက်​ခိုက်​ခြင်း​ကို​ခံ​နေ​ရ​သ​ဖြင့် ကျွန်​တော်​မျိုး​ကို​သ​နား​တော်​မူ​ပါ။","poem":2},{"text":"ရန်​သူ​များ​သည်​ကျွန်​တော်​မျိုး​အား​နေ့​ရှိ​သ​မျှ ညှဉ်း​ဆဲ​နှိပ်​စက်​ကြ​ပါ​၏။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​၏​ရန်​ဘက်​တို့​သည်​တစ်​နေ့​လုံး​ပင် ကျွန်​တော်​မျိုး​အား​တိုက်​ခိုက်​ကြ​ပါ​၏။","poem":1},{"text":"ကျွန်​တော်​မျိုး​အား​တိုက်​ခိုက်​သူ​တို့​များ​လှ​ပါ​၏။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"အို အ​နန္တ​တန်​ခိုး​ရှင်​ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​ကြောက်​လန့်​သော​အ​ခါ ကိုယ်​တော်​ရှင်​အား​ကိုး​စား​ပါ​၏။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ငါ​သည်​ဘု​ရား​သ​ခင်​အား​ကိုး​စား​သ​ဖြင့် အ​ဘယ်​သူ​ကို​မျှ​ကြောက်​လန့်​မည်​မ​ဟုတ်။","poem":1},{"text":"ကိုယ်​တော်​၏​က​တိ​တော်​အ​တွက်​ကိုယ်​တော်​အား ထော​မ​နာ​ပြု​မည်။","poem":2},{"text":"လူ​သည်​ငါ့​အား​အ​ဘယ်​သို့​ပြု​နိုင်​မည်​နည်း။","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ငါ​၏​ရန်​သူ​များ​သည်​ငါ့​ကို​တစ်​နေ့​လုံး စော်​ကား​ပြော​ဆို​ကြ​၏။","poem":1},{"text":"ငါ့​အား​အ​ကျိုး​နည်း​စေ​ရန်​နည်း​လမ်း​ကို အ​စဉ်​ပင်​ရှာ​ကြံ​လျက်​နေ​ကြ​၏။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"သူ​တို့​သည်​ပုန်း​ကွယ်​ရာ​အ​ရပ်​များ​တွင် စု​ရုံး​ကာ","poem":1},{"text":"ငါ့​ကို​သတ်​ဖြတ်​နိုင်​ရန်​ငါ​ပြု​သ​မျှ​သော အ​မှု​တို့​ကို​ချောင်း​မြောင်း​၍​ကြည့်​ကြ​၏။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊","poem":1},{"text":"သူ​တို့​ပြု​သော​ဒု​စ​ရိုက်​အ​တွက် အ​ပြစ်​ဒဏ်​ခတ်​တော်​မူ​ပါ။","poem":2},{"text":"အ​မျက်​တော်​ထွက်​၍​သူ​တို့​အား​နှိမ်​နင်း တော်​မူ​ပါ။","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ကျွန်​တော်​မျိုး​သည်​အ​တိ​ဒုက္ခ​ရောက်​လျက်​ရှိ သည်​ကို","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သိ​တော်​မူ​ပါ​၏။","poem":2},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​၏​မျက်​ရည်​ပေါက် များ​ကို​စာ​ရင်း​ပြု​၍​ထား​တော်​မူ​ပြီ။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​၏​စာ​စောင်​တွင်​စာ​ရင်း​ပြု​၍​ထား​သည် မ​ဟုတ်​ပါ​လော။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ကိုယ်​တော်​ရှင်​အား​ကျွန်​တော်​မျိုး","poem":1},{"text":"တောင်း​လျှောက်​သော​နေ့​၌​ရန်​သူ​တို့​သည် တပ်​လန်​ကြ​ပါ​လိမ့်​မည်။","poem":2},{"text":"ဘု​ရား​သ​ခင်​သည်​ငါ​၏​ဘက်​တွင်​ရှိ​တော်​မူ ကြောင်း​ကို ငါ​သိ​၏။","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ငါ​သည်​ထာ​ဝ​ရ​ဘု​ရား​၏​က​တိ​တော်​များ​ကို ချီး​မွမ်း​ပါ​၏။","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ငါ​သည်​ကိုယ်​တော်​ကို​ကိုး​စား​သ​ဖြင့် အ​ဘယ်​သူ​ကို​မျှ ကြောက်​လန့်​မည်​မ​ဟုတ်။","poem":1},{"text":"လူ​သည်​ငါ့​အား​အ​ဘယ်​သို့​ပြု​နိုင်​သ​နည်း။","poem":2}]},{"type":"verse","number":12,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင်​အား​သစ္စာ​က​တိ ပြု​ခဲ့​သည့်​အ​တိုင်း​သစ္စာ​ဝတ်​ကို​ဖြေ​ပါ​မည်။","poem":2},{"text":"ချီး​မွမ်း​ရာ​ပူ​ဇော်​သ​ကာ​ကို​ကိုယ်​တော်​ရှင်​အား ဆက်​သ​ပါ​မည်။","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"အ​ဘယ်​ကြောင့်​ဆို​သော်​ကိုယ်​တော်​ရှင်​သည်","poem":1},{"text":"ကျွန်​တော်​မျိုး​အား​သေ​ဘေး​မှ​ကယ်​ဆယ်​တော်​မူ​၍","poem":2},{"text":"အ​ရေး​ရှုံး​နိမ့်​စေ​တော်​မ​မူ​ခဲ့​သော​ကြောင့်​ဖြစ်​ပါ​၏။","poem":1},{"text":"သို့​ဖြစ်​၍​ကျွန်​တော်​မျိုး​သည်","poem":2},{"text":"အ​သက်​ရှင်​သူ​တို့​၏​အ​လင်း​ထဲ​မှာ ဘု​ရား​သ​ခင်​၏​ရှေ့​တော်​၌​သွား​လာ​ပါ​၏။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}