{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":58,"content":[{"type":"heading","content":["သူ​ယုတ်​မာ​တို့​အား​အ​ပြစ်​ဒဏ်​ခတ်​တော်​မူ​ရန် ဆု​တောင်း​ပတ္ထနာ58:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"အ​ချင်း​အာ​ဏာ​ပိုင်​တို့၊သင်​တို့​သည်​တ​ရား သ​ဖြင့် ဆုံး​ဖြတ်​မှု​ကို​ပြု​ကြ​သ​လော။","poem":1},{"text":"လူ​အ​ပေါင်း​တို့​အား​တ​ရား​မျှ​တ​စွာ စီ​ရင်​ကြ​သ​လော။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"သင်​တို့​ကား​ယင်း​သို့​မ​ပြု၊မိ​မိ​တို့​ပြု​မည့် ဒု​စ​ရိုက်​ကို​သာ​လျှင်​စဉ်း​စား​ကြံ​စည်​လျက်","poem":1},{"text":"တိုင်း​ပြည်​တွင်​အ​ဋ္ဌမ္မ​အ​ကြမ်း​ဖက်​မှု​ကို ကူး​လွန်​ကြ​၏။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ဒု​စ​ရိုက်​သ​မား​တို့​သည်​တစ်​သက်​လုံး​အ​မှား​ကို သာ​လျှင်​ပြု​တတ်​ကြ​၏။","poem":1},{"text":"သူ​တို့​သည်​မိ​မိ​တို့​မွေး​က​တည်း​က မု​သား​စ​ကား​ကို​ပြော​ဆို​တတ်​ကြ​၏။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"သူ​တို့​သည်​အ​ဆိပ်​ရှိ​သည့်​မြွေ​များ​နှင့်​တူ ကြ​၏။","poem":1},{"text":"နား​ပင်း​သည့်​မြွေ​ဟောက်​သည်​အ​လမ္ပာယ် ဆ​ရာ​၏","poem":2},{"text":"အ​သံ​ကို​သော်​လည်း​ကောင်း၊ကျင်​လည်​သော","poem":1},{"text":"မျက်​လှည့်​ဆ​ရာ​၏​မန္တန်​ကို​သော်​လည်း​ကောင်း မ​ကြား​ရ။","poem":2},{"text":"သူ​တို့​သည်​နား​ပင်း​သည့်​မြွေ​ဟောက်​နည်း​တူ မိ​မိ​တို့​၏​နား​များ​ကို​ပိတ်​ထား​ကြ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ဤ​ရက်​စက်​ကြမ်း​ကြုတ်​သော​ခြင်္သေ့​၏​အ​စွယ် များ​ကို ချိုး​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"သူ​တို့​သည်​စီး​ဆင်း​ပျောက်​ကွယ်​သွား​တတ်​သည့် ရေ​ကဲ့​သို့​ဖြစ်​ကြ​ပါ​စေ​သော။","poem":1},{"text":"လူ​သွား​လမ်း​ပေါ်​မှ​ပေါင်း​ပင်​များ​ကဲ့​သို့ ကြေ​မွ​သွား​ကြ​ပါ​စေ​သော။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"သူ​တို့​သည်​အ​ကျိ​အ​ချွဲ​အ​ဖြစ်​သို့​အ​ရည် ပျော်​၍","poem":1},{"text":"သွား​တတ်​သည့်​ပက်​ကျိ​များ​ကဲ့​သို့​ဖြစ်​ကြ​ပါ​စေ​သော။","poem":2},{"text":"အ​လင်း​ရောင်​ကို​အ​ဘယ်​အ​ခါ​၌​မျှ​မ​မြင်​ရ​သည့် လျှော​မွေး​ကဲ့​သို့​ဖြစ်​ကြ​ပါ​စေ​သော။","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"သူ​တို့​သည်​မ​မျှော်​လင့်​သော​အ​ချိန်​တွင်​ချုံ​ဖုတ် ကဲ့​သို့ ခုတ်​ပစ်​ခြင်း​ကို​ခံ​ကြ​ရ​၏။","poem":1},{"text":"ဘု​ရား​သ​ခင်​သည်​ပြင်း​စွာ​အ​မျက်​ထွက်​တော်​မူ​၍","poem":2},{"text":"သူ​တို့​အား​ကွယ်​ပျောက်​သွား​စေ​တော်​မူ​လိမ့်​မည်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"သူ​တော်​ကောင်း​တို့​သည်​အ​ပြစ်​ကူး​သူ​များ","poem":1},{"text":"အ​ပြစ်​ဒဏ်​သင့်​ကြ​သည်​ကို​မြင်​သော​အ​ခါ ဝမ်း​မြောက်​ကြ​လိမ့်​မည်။","poem":2},{"text":"သူ​တို့​သည်​သူ​ယုတ်​မာ​တို့​၏​သွေး​အိုင်​တွင် ခြေ​ဆေး​ကြ​လိမ့်​မည်။","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"လူ​တို့​က``သူ​တော်​ကောင်း​တို့​သည်​ဧ​ကန်​အ​မှန်​ပင် ကောင်း​ကျိုး​ချမ်း​သာ​ခံ​စား​ကြ​ရ​၏။","poem":1},{"text":"ကမ္ဘာ​လော​က​ကို​တ​ရား​စီ​ရင်​တော်​မူ​သော​ဘု​ရား","poem":2},{"text":"ဧ​ကန်​အ​မှန်​ရှိ​တော်​မူ​ပေ​သည်'' ဟု​ဆို​ကြ​လိမ့်​မည်။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":10}