{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":60,"content":[{"type":"heading","content":["ကယ်​ဆယ်​တော်​မူ​ရန်​ဆု​တောင်း​ပတ္ထနာ60:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​သည်​မေ​သော​ပေါ​တာ​မိ​နှင့် ဇော​တ​မှ​လူ​တို့​ကို​တိုက်​ခိုက်​၍​ယွာ​ဘ​သည် ပြန်​လှည့်​၍​ဧ​ဒုံ​အ​မျိုး​သား​တစ်​သောင်း​နှစ် ထောင်​တို့​ကို​ဆား​ချိုင့်​တွင်​သတ်​ပြီး​နောက် သွန်​သင်​ရန်​ဒါ​ဝိဒ်​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​တို့​အား စွန့်​ပစ်​တော်​မူ​၍​အ​ရေး​ရှုံး​နိမ့်​စေ​တော်​မူ​ပါ​ပြီ။","poem":2},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​တို့​အား အ​မျက်​ထွက်​တော်​မူ​ပါ​ပြီ။","poem":1},{"text":"သို့​ရာ​တွင်​ယ​ခု​ကျွန်​တော်​မျိုး​တို့​ထံ​သို့ ပြန်​၍​ကြွ​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ကိုယ်​တော်​ရှင်​သည်​ပြည်​တော်​ကို​သိမ့်​သိမ့်​တုန် စေ​၍ ကွဲ​အက်​စေ​တော်​မူ​ပါ​ပြီ။","poem":1},{"text":"ပြည်​တော်​သည်​ပြို​ကွဲ​လျက်​ရှိ​သ​ဖြင့် ကွဲ​အက်​ရာ​များ​ကို​ပြု​ပြင်​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ကိုယ်​တော်​ရှင်​သည်​မိ​မိ​၏​လူ​စု​တော်​အား အ​တိ​ဒုက္ခ​ရောက်​စေ​တော်​မူ​ပါ​ပြီ။","poem":1},{"text":"ကျွန်​တော်​မျိုး​တို့​အား​သေ​သောက်​ကူး သူ​များ​သ​ဖွယ်​ယိမ်း​ယိုင်​စေ​တော်​မူ​ပါ​ပြီ။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ကိုယ်​တော်​ရှင်​အား​ကြောက်​ရွံ့​ရို​သေ​သူ​တို့ သည်","poem":1},{"text":"အ​ပြစ်​ဒဏ်​လွတ်​မြောက်​စေ​ရန်​သူ​တို့​အား ကိုယ်​တော်​သ​တိ​ပေး​တော်​မူ​ပါ​ပြီ။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ကိုယ်​တော်​ရှင်​၏​တန်​ခိုး​တော်​အား​ဖြင့် ကျွန်​တော်​မျိုး​တို့​အား​ကယ်​တော်​မူ​ပါ။","poem":1},{"text":"ချစ်​တော်​မူ​သော​သူ​တို့​သည်​ကယ်​ဆယ် ခြင်း ခံ​ရ​ကြ​စေ​ရန်​ကျွန်​တော်​မျိုး​တို့​၏","poem":2},{"text":"ဆု​တောင်း​ပတ္ထ​နာ​ကို​နား​ညောင်း​တော်​မူ​ပါ။","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"သန့်​ရှင်း​ရာ​ဌာ​န​တော်​မှ​ထာ​ဝ​ရ​ဘု​ရား က``ငါ​သည် အောင်​ပွဲ​ခံ​၍​ရှေ​ခင်​မြို့​ကို​ပိုင်း​ခြား​မည်။","poem":1},{"text":"သု​ကုတ်​ချိုင့်​ဝှမ်း​ကို​ငါ​၏​လူ​စု​တော်​အား ခွဲ​ဝေ​ပေး​မည်။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ဂိ​လဒ်​ပြည်​ကို​ငါ​ပိုင်​၏။ မ​နာ​ရှေ​ပြည်​ကို​လည်း ငါ​ပိုင်​၏။","poem":1},{"text":"ဧ​ဖ​ရိမ်​ပြည်​သည်​ငါ​၏​မ​ကိုဋ်​ဖြစ်​၍ ယု​ဒ​ပြည်​ကား​ငါ​၏​ရာ​ဇ​လှံ​တံ​ဖြစ်​၏။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"သို့​ရာ​တွင်​ငါ​သည်​မော​ဘ​ပြည်​ကို​ငါ​၏ ခြေ​ဆေး​ခွက်​အ​ဖြစ်​ဖြင့်​လည်း​ကောင်း၊","poem":1},{"text":"ဧ​ဒုံ​ပြည်​ကို​ငါ​၏​ဖိ​နပ်​ချွတ်​အ​ဖြစ်​ဖြင့် လည်း​ကောင်း အ​သုံး​ပြု​မည်။","poem":2},{"text":"ဖိ​လိတ္တိ​ပြည်​သည်​ငါ့​ကို​အ​နိုင်​ရ​၍​အောင်​သံ ဖြင့်","poem":1},{"text":"ကြွေး​ကြော်​နိုင်​မည်​ဟု​ထင်​မှတ်​သ​လော'' ဟု မိန့်​တော်​မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ခိုင်​ခံ့​လုံ​ခြုံ​သည့်​မြို့​တွင်း​သို့​အ​ဘယ်​သူ​သည် ကျွန်​တော်​မျိုး​အား​ခေါ်​ဆောင်​သွား​ပါ​မည် နည်း။","poem":2},{"text":"အ​ဘယ်​သူ​သည်​ကျွန်​တော်​မျိုး​အား​ဧ​ဒုံ​ပြည် သို့ ပို့​ဆောင်​ပါ​မည်​နည်း။","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​တို့​အား အ​ကယ်​ပင် စွန့်​ပစ်​တော်​မူ​ပါ​ပြီ​လော။","poem":1},{"text":"ကျွန်​တော်​မျိုး​တို့​၏​စစ်​တပ်​များ​နှင့်​အ​တူ ချီ​တက်​တော်​မ​မူ​ဘဲ​နေ​ပါ​မည်​လော။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ရန်​သူ​ကို​တိုက်​ခိုက်​နိုင်​ရန်​ကျွန်​တော်​မျိုး​တို့​အား ကူ​မ​တော်​မူ​ပါ။","poem":1},{"text":"လူ​သား​တို့​၏​အ​ကူ​အ​ညီ​သည်​အ​ချည်း​နှီး ဖြစ်​ပါ​၏။","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ငါ​တို့​၏​ဘက်​တွင်​ဘု​ရား​သ​ခင်​ရှိ​တော်​မူ​လျှင် ငါ​တို့​သည်​အောင်​မြင်​ကြ​လိမ့်​မည်။","poem":1},{"text":"ကိုယ်​တော်​သည်​ငါ​တို့​၏​ရန်​သူ​များ​ကို နှိမ်​နင်း​တော်​မူ​လိမ့်​မည်။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}