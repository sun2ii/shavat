{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":64,"content":[{"type":"heading","content":["ကွယ်​ကာ​တော်​မူ​ရန်​ဆု​တောင်း​ပတ္ထနာ64:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊ ကျွန်​တော်​မျိုး​သည်​ဒုက္ခ​ရောက်​လျက်​ရှိ​ပါ​၏။","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​ဆု​တောင်း​ပတ္ထ​နာ​ကို နား​ညောင်း​တော်​မူ​ပါ။","poem":2},{"text":"ကျွန်​တော်​မျိုး​သည်​ရန်​သူ​များ​ကို​ကြောက်​လန့်​၍ နေ​ပါ​၏။","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​အ​သက်​ကို​ကယ်​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"သူ​ယုတ်​မာ​တို့​၏​လျှို့​ဝှက်​ကြံ​စည်​မှု​များ မှ​လည်း​ကောင်း၊","poem":1},{"text":"ဆိုး​ညစ်​သူ​လူ​စု​လူ​ဝေး​တို့​၏​ဘေး​မှ​လည်း ကောင်း ကွယ်​ကာ​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"သူ​တို့​သည်​မိ​မိ​တို့​၏​လျှာ​ကို​ဋ္ဌား​သ​ဖွယ် သွေး​ကြ​ပါ​၏။","poem":1},{"text":"သ​နား​ကြင်​နာ​ခြင်း​ကင်း​မဲ့​သော​စ​ကား များ​ဖြစ်​သော မြား​များ​ကို​ချိန်​ရွယ်​ကြ​၏။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"သူ​တို့​သည်​အ​ရှက်​ကင်း​မဲ့​စွာ​မိ​မိ​တို့​၏ မု​သား​စ​ကား​များ​ကို​လျင်​မြန်​စွာ​ပျံ့​နှံ့​စေ ကြ​၏။","poem":1},{"text":"သူ​တို့​သည်​စက်​ဆုတ်​ဖွယ်​ကောင်း​သော ဂုံး​ချော​စ​ကား​များ​ပြော​ဆို​ကာ","poem":2},{"text":"သူ​တော်​ကောင်း​တို့​၏​အ​သ​ရေ​ကို​ဖျက်​ကြ​၏။","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"သူ​တို့​သည်​ဆိုး​ညစ်​သည့်​အ​မှု​များ​ကို​ကြံ​စည် ရာ​တွင် အ​ချင်း​ချင်း​အား​ပေး​ကြ​၏။","poem":1},{"text":"သူ​တို့​သည်​ထောင်​ချောက်​များ​ထား​ရန်​နေ​ရာ​ကို တိုင်​ပင်​ပြီး​နောက်","poem":2},{"text":"``ဤ​ထောင်​ချောက်​များ​ကို​အ​ဘယ်​သူ​မျှ​တွေ့​မြင် နိုင်​လိမ့်​မည်​မ​ဟုတ်'' ဟု​ဆို​ကြ​၏။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"သူ​တို့​သည်​ဆိုး​ညစ်​သည့်​အ​မှု​များ​ကို​ကြံ​စည် ပြီး​လျှင်","poem":1},{"text":"``လွန်​စွာ​ပါး​နပ်​လိမ္မာ​သည့်​အ​မှု​ကို​ငါ​တို့​ကြံ​စည်​၍ ပြီး​လေ​ပြီ'' ဟု​ဆို​ကြ​၏။","poem":2},{"text":"လူ​၏​စိတ်​နှ​လုံး​နှင့်​အ​ကြံ​အ​စည်​ကို​သိ​ရှိ​ရန် လွန်​စွာ​ပင်​ခက်​ခဲ​နက်​နဲ​လှ​ပါ​သည်​တ​ကား။","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"သို့​ရာ​တွင်​ဘု​ရား​သ​ခင်​သည်​ထို​သူ​တို့​အား","poem":1},{"text":"မြား​တော်​ဖြင့်​ပစ်​တော်​မူ​၍​ချက်​ချင်း​ပင် ဒဏ်​ရာ​ရ​စေ​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"သူ​တို့​ပြော​ဆို​သည့်​စ​ကား​များ​ကြောင့်​ပင်​လျှင်","poem":1},{"text":"ကိုယ်​တော်​သည်​သူ​တို့​အား​သေ​ကြေ​ပျက်​စီး စေ​တော်​မူ​လိမ့်​မည်။","poem":2},{"text":"သူ​တို့​ကို​တွေ့​မြင်​သူ​အ​ပေါင်း​တို့​သည် ဦး​ခေါင်း​ကို​ခါ​ကြ​လိမ့်​မည်။","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ထို​သူ​အ​ပေါင်း​တို့​သည်​ကြောက်​လန့်​လျက်","poem":1},{"text":"ဘု​ရား​သ​ခင်​စီ​ရင်​တော်​မူ​သော​အ​မှု​ကို ဆင်​ခြင်​ကာ","poem":2},{"text":"ကိုယ်​တော်​ပြု​တော်​မူ​သော​အ​မှု​တော်​များ အ​ကြောင်း​ကို ပြော​ကြား​ကြ​လိမ့်​မည်။","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ထာ​ဝ​ရ​ဘု​ရား​ပြု​တော်​မူ​သော​အ​မှု​တော်​ကြောင့်","poem":1},{"text":"သူ​တော်​ကောင်း​အ​ပေါင်း​တို့​သည်​ရွှင်​လန်း ဝမ်း​မြောက်​ကြ​လိမ့်​မည်။","poem":2},{"text":"သူ​တို့​သည်​ထာ​ဝ​ရ​ဘု​ရား​၏​ထံ​တော်​တွင် ခို​လှုံ​ကြ​လိမ့်​မည်။","poem":1},{"lineBreak":true},{"text":"စိတ်​နှ​လုံး​ဖြူ​စင်​ဖြောင့်​မတ်​သူ​အ​ပေါင်း​တို့​သည် ကိုယ်​တော်​အား​ထော​မ​နာ​ပြု​ကြ​လိမ့်​မည်။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}