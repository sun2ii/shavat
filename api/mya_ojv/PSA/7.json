{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":7,"content":[{"type":"heading","content":["တ​ရား​မျှ​တ​မှု​အ​တွက်​ဆု​တောင်း​ပတ္ထနာ7:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​သည်​ဗင်္ယာ​မိန်​အ​မျိုး​သား​ကု​ရှ​ကြောင့်​ထာ​ဝ​ရ​ဘု​ရား​၏​ရှေ့​တော်​တွင်​ဆို​သော​သီ​ချင်း​"]},{"type":"verse","number":1,"content":[{"text":"ကျွန်​တော်​မျိုး​၏​ဘု​ရား​သ​ခင်​ထာ​ဝ​ရ​ဘု​ရား၊​ကိုယ်​တော်​၌​ကျွန်​တော်​မျိုး​ခို​လှုံ​ပါ​၏။","poem":1},{"text":"ကျွန်​တော်​မျိုး​အား​လိုက်​လံ​ဖမ်း​ဆီး​နေ​သူ​အ​ပေါင်း​တို့​၏​လက်​မှ","poem":2},{"text":"ကျွန်​တော်​မျိုး​အား​ကယ်​တော်​မူ​ပါ။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ကယ်​ဆယ်​တော်​မ​မူ​ပါ​လျှင်​သူ​တို့​သည်​ခြင်္သေ့​ကဲ့​သို့","poem":1},{"text":"ကျွန်​တော်​မျိုး​အား​ကယ်​မည့်​သူ​မ​ရှိ​သည့်​အ​ရပ်​သို့​ဆွဲ​ယူ​ကာ​အ​ပိုင်း​ပိုင်း​ကိုက်​ဖြတ်​ကြ​ပါ​လိမ့်​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ကျွန်​တော်​မျိုး​၏​ဘု​ရား​သ​ခင်​ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"အ​ကယ်​၍​ကျွန်​တော်​မျိုး​သည်​တစ်​စုံ​တစ်​ယောက်​ကို​ပြစ်​မှား​မိ​ခဲ့​လျှင်​သော်​လည်း​ကောင်း၊","poem":2},{"text":"မိတ်​ဆွေ​ကို​သစ္စာ​ဖောက်​ခဲ့​လျှင်​သော်​လည်း​ကောင်း၊","poem":1},{"text":"ရန်​သူ​ကို​အ​ကြောင်း​မဲ့​အ​ကျိုး​နည်း​စေ​ခဲ့​လျှင်​သော်​လည်း​ကောင်း","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ရန်​သူ​များ​သည်​ကျွန်​တော်​မျိုး​အား​လိုက်​၍​မီ​ကာ​သတ်​ဖြတ်​နိုင်​လျက်","poem":1},{"text":"ကျွန်​တော်​မျိုး​ကို​မြေ​ပေါ်​တွင်​ပစ်​ထား​ကြ​ပါ​စေ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊ အ​မျက်​တော်​ထွက်​၍​ထ​တော်​မူ​ပါ။","poem":1},{"text":"ကျွန်​တော်​မျိုး​အား​ရန်​ဘက်​ပြု​သူ​တို့​၏​ဒေါ​သ​ကို​ဆီး​တား​တော်​မူ​ပါ။","poem":2},{"text":"နိုး​ထ​တော်​မူ​လျက်​ကျွန်​တော်​မျိုး​အား​ကူ​မ​တော်​မူ​ပါ။","poem":1},{"text":"တ​ရား​မျှ​တ​မှု​ကို​ကိုယ်​တော်​အ​လို​ရှိ​တော်​မူ​သည်​ဖြစ်​၍","poem":2}]},{"type":"verse","number":7,"content":[{"text":"လူ​အ​ပေါင်း​တို့​ကို​ကိုယ်​တော်​ရှင်​၏​ပတ်​လည်​တွင်​စု​ရုံး​စေ​တော်​မူ​ပြီး​နောက်","poem":1},{"text":"အ​ထက်​အ​ရပ်​မှ​သူ​တို့​အား​အုပ်​စိုး​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​လူ​အ​ပေါင်း​တို့​ကို​တ​ရား​စီ​ရင်​တော်​မူ​သော​အ​ရှင်​ဖြစ်​တော်​မူ​၏။","poem":2},{"text":"ကျွန်​တော်​မျိုး​အ​ပြစ်​ကင်း​သည်​ကို​ထောက်​ထား​၍","poem":1},{"text":"ကျွန်​တော်​မျိုး​အား​မျက်​နှာ​သာ​ပေး​၍​တ​ရား​စီ​ရင်​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ကိုယ်​တော်​ရှင်​သည်​ဖြောင့်​မတ်​တော်​မူ​သော​ဘု​ရား​ဖြစ်​တော်​မူ​ပါ​၏။","poem":1},{"text":"လူ​တို့​၏​အ​ကြံ​အ​စည်​များ​နှင့်​လို​အင်​ဆန္ဒ​များ​ကို​လည်း​စစ်​ဆေး​တော်​မူ​ပါ​၏။","poem":2},{"text":"သူ​ယုတ်​မာ​တို့​၏​ဆိုး​ညစ်​မှု​ကို​ဆီး​တား​တော်​မူ​လျက်၊","poem":1},{"text":"သူ​တော်​ကောင်း​တို့​အား​ကောင်း​ကျိုး​ကို​ပေး​သ​နား​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ဘု​ရား​သ​ခင်​သည်​ငါ့​ကို​ကွယ်​ကာ​စောင့်​ရှောက်​တော်​မူ​သော​အ​ရှင်​ဖြစ်​တော်​မူ​၏။","poem":1},{"text":"ကိုယ်​တော်​သည်​မိ​မိ​စ​ကား​ကို​နား​ထောင်​သူ​တို့​အား​ကယ်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ဘု​ရား​သ​ခင်​သည်​ဖြောင့်​မှန်​စွာ​တ​ရား​စီ​ရင်​တော်​မူ​သော​အ​ရှင်​ဖြစ်​တော်​မူ​၍","poem":1},{"text":"သူ​ယုတ်​မာ​တို့​အား​အ​စဉ်​အ​ပြစ်​ဒဏ်​ချ​မှတ်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":12,"content":[{"text":"အ​ကယ်​၍​လူ​တို့​သည်​နောင်​တ​မ​ရ​ကြ​ပါ​မူ","poem":1},{"text":"ဘု​ရား​သ​ခင်​သည်​ဋ္ဌား​တော်​ကို​သွေး​တော်​မူ​၍ လေး​တော်​ကို​အ​ဆင်​သင့်​တင်​တော်​မူ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":13,"content":[{"text":"သေ​စေ​တတ်​သော​လက်​နက်​များ​ကို​ကိုင်​ဆောင်​တော်​မူ​၍","poem":1},{"text":"မီး​လျှံ​ထ​သည့်​မြား​တော်​ကို​ချိန်​ရွယ်​တော်​မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"သူ​ယုတ်​မာ​တို့​သည်​မ​ကောင်း​မှု​ပြု​ရန်​အ​ဘယ်​သို့​စဉ်း​စား​ကြံ​စည်​သည်​ကို​ကြည့်​လော့။","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"သို့​ရာ​တွင်​သူ​တို့​သည်​မြေ​တွင်း​ကို​နက်​စွာ​တူး​၍","poem":1},{"text":"မိ​မိ​တို့​တူး​သည့်​တွင်း​များ​ထဲ​သို့​ပင်​ကျ​ကြ​၏။","poem":2}]},{"type":"verse","number":16,"content":[{"text":"သို့​ဖြစ်​၍​သူ​တို့​သည်​မိ​မိ​တို့​ပြု​သည့်​မ​ကောင်း​မှု​ကြောင့်​အ​ပြစ်​ဒဏ်​ခံ​ရ​ကြ​၏။","poem":1},{"text":"မိ​မိ​တို့​ပြု​သည့်​အ​ကြမ်း​ဖက်​မှု​ကြောင့်​ဒဏ်​ရာ​ရ​ကြ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​တ​ရား​မျှ​တ​တော်​မူ​သည့်​အ​တွက်","poem":1},{"text":"ငါ​သည်​ကိုယ်​တော်​၏​ကျေး​ဇူး​တော်​ကို​ချီး​မွမ်း​ပါ​မည်။","poem":2},{"text":"အ​မြင့်​မြတ်​ဆုံး​သော​ဘု​ရား​ဖြစ်​တော်​မူ​သော","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​ကို​ထော​မ​နာ​ပြု​၍​သီ​ချင်း​ဆို​ပါ​မည်။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}