{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":70,"content":[{"type":"heading","content":["ကူ​မ​တော်​မူ​ရန်​ဆု​တောင်း​ပတ္ထနာ70:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သော​ဆာ​လံ။ ဝမ်း​နည်း​မြည် တမ်း​ခြင်း။"]},{"type":"verse","number":1,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊ ကျွန်​တော်​မျိုး​အား​ကယ်​တော်​မူ​ပါ။","poem":1},{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊ ယ​ခု​ပင်​ကျွန်​တော်​အား​ကူ​မ​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ကျွန်​တော်​မျိုး​အား​သတ်​ရန်​ကြိုး​စား​သူ​တို့​သည် အ​ရေး​ရှုံး​နိမ့်​၍​က​စဥ့်​က​ရဲ​ဖြစ်​ကြ​ပါ​စေ သော။","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​ဆင်း​ရဲ​ဒုက္ခ​များ​ကို​အကြောင်း​ပြု​၍","poem":2},{"text":"ဝမ်း​မြောက်​ကြ​သူ​တို့​သည်​တပ်​လန်​၍​ကွဲ​ကြ ပါ​စေ​သော။","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​အား​ပြောင်​လှောင်​ကြ​သူ​တို့​သည် အ​ရေး​ရှုံး​နိမ့်​သည့်​အ​တွက်","poem":1},{"text":"အ​လွန်​ကြောက်​လန့်​ကြ​ပါ​စေ​သော။","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ကိုယ်​တော်​ရှင်​၏​ထံ​တော်​သို့​ချဉ်း​ကပ်​သူ","poem":1},{"text":"အ​ပေါင်း​တို့​သည်​ဝမ်း​မြောက်​ရွှင်​လန်း​ကြ​ပါ စေ​သော။","poem":2},{"text":"ကိုယ်​တော်​ရှင်​၏​ကယ်​တင်​ခြင်း​ကျေး​ဇူး​တော် အ​တွက်","poem":1},{"text":"ကျေး​ဇူး​တော်​ကို​ချီး​မွမ်း​ကြ​သူ​အ​ပေါင်း​တို့ သည်","poem":2},{"text":"``ဘု​ရား​သ​ခင်​သည်​အ​လွန်​ကြီး​မြတ်​တော်​မူ","poem":1},{"text":"ပါ​ပေ​သည်'' ဟု​အ​စဉ်​မ​ပြတ်​ချီး​ကူး ကြ​ပါ​စေ​သော။","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ကျွန်​တော်​မျိုး​သည်​အား​အင်​ချိ​နဲ့​လျက် ဆင်း​ရဲ​၍​နေ​ပါ​၏။","poem":1},{"text":"အို ဘု​ရား​သ​ခင်၊ ကျွန်​တော်​မျိုး​ထံ​သို့​လျင်​မြန်​စွာ​ကြွ​လာ တော်​မူ​ပါ။","poem":2},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​အား","poem":1},{"text":"ကယ်​တင်​တော်​မူ​သော​အ​ရှင်၊ကျွန်​တော်​မျိုး​၏ ထာ​ဝ​ရ​ဘု​ရား​ဖြစ်​တော်​မူ​၏။","poem":2},{"text":"ကျွန်​တော်​မျိုး​အား​ကူ​မ​ရန်​အ​လျင်​အ​မြန် ကြွ​တော်​မူ​ပါ။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}