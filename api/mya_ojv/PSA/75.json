{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":75,"content":[{"type":"heading","content":["တ​ရား​စီ​ရင်​တော်​မူ​သော​ဘု​ရား​သ​ခင်75:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ အာ​သပ်​စပ်​ဆို​သော​ဆာ​လံ၊သီ​ချင်း။"]},{"type":"verse","number":1,"content":[{"text":"ကျွန်​တော်​မျိုး​တို့​သည်​ကိုယ်​တော်​ရှင်​၏ ကျေး​ဇူး​တော်​ကို​ချီး​မွမ်း​ကြ​ပါ​၏။","poem":1},{"text":"အို ဘု​ရား​သ​ခင်၊","poem":2},{"text":"ကျွန်​တော်​မျိုး​တို့​သည်​ကိုယ်​တော်​ရှင်​၏ ကျေး​ဇူး​တော်​ကို​ချီး​မွမ်း​ကြ​ပါ​၏။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​အ​ဘယ်​မျှ​ကြီး​မြတ်​တော်​မူ သည်​ကို​ထုတ်​ဖော်​ကြေ​ညာ​၍","poem":2},{"text":"ပြု​တော်​မူ​သော​အံ့​သြ​ဖွယ်​ရာ​များ​အ​ကြောင်း ကို ပြော​ကြား​ကြ​ပါ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ဘု​ရား​သ​ခင်​က``တ​ရား​စီ​ရင်​မည့်​အ​ချိန်​ကို ငါ​သတ်​မှတ်​ထား​လေ​ပြီ။","poem":1},{"text":"ငါ​သည်​ဖြောင့်​မှန်​စွာ​တ​ရား​စီ​ရင်​မည်။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ကမ္ဘာ​မြေ​ကြီး​နှင့်​တ​ကွ​သက်​ရှိ​သတ္တဝါ အ​ပေါင်း​တို့​သည် တုန်​လှုပ်​ကြ​စေ​ကာ​မူ","poem":1},{"text":"ငါ​သည်​ကမ္ဘာ​မြေ​ကြီး​၏​အ​ခြေ​ခံ​အုတ်​မြစ်​တို့​ကို တည်​တံ့​ခိုင်​မြဲ​စေ​မည်။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ငါ​ဤ​သို့​အ​မိန့်​ရှိ​၏။ သူ​ယုတ်​မာ​တို့​အား​မ​ကြွား​မ​ဝါ​ကြ​နှင့်။","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"မာန်​မာ​န​မ​ထောင်​လွှား​ကြ​နှင့်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"တ​ရား​စီ​ရင်​သော​သူ​သည်​အ​ရှေ့​အ​ရပ်​သို့​မ​ဟုတ် အ​နောက်​အ​ရပ်​မှ​သော်​လည်း​ကောင်း၊","poem":1},{"text":"တောင်​အ​ရပ်​သို့​မ​ဟုတ်​မြောက်​အ​ရပ်​မှ သော်​လည်း​ကောင်း​ပေါ်​ထွက်​လာ​သည်​မ​ဟုတ်။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"တ​ရား​စီ​ရင်​တော်​မူ​သော​အ​ရှင်​ကား​ဘု​ရား​သ​ခင်​ပင်","poem":1},{"text":"ဖြစ်​ပေ​သည်။","poem":2},{"text":"ကိုယ်​တော်​သည်​အ​ချို့​သော​သူ​တို့​ကို​အ​ပြစ်​ဒဏ် စီ​ရင်​တော်​မူ​လျက်","poem":1},{"text":"အ​ချို့​တို့​ကို​လွတ်​ငြိမ်း​ချမ်း​သာ​စေ​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​အ​မျက်​တော်​တည်း​ဟူ​သော အ​လွန်​ပြင်း​သည့်​စ​ပျစ်​ရည်​ထည့်​ထား​သော","poem":1},{"text":"ခွက်​ဖ​လား​ကို​လက်​တော်​တွင်​ကိုင်​ထား​တော်​မူ​၏။","poem":2},{"text":"ထို​စ​ပျစ်​ရည်​ကို​ကိုယ်​တော်​လောင်း​ချ တော်​မူ​သော​အ​ခါ","poem":1},{"text":"သူ​ယုတ်​မာ​အ​ပေါင်း​တို့​သည်​သောက်​ကြ​ကုန်​၏။","poem":2},{"text":"သူ​တို့​သည်​တစ်​စက်​မျှ​မ​ကျန်​အောင်​သောက် ကြ​ကုန်​၏။","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"သို့​ရာ​တွင်​ငါ​မူ​ကား​ယာ​ကုပ်​၏","poem":1},{"text":"ဘု​ရား​အ​ကြောင်း​တော်​ကို​အ​စဉ်​မ​ပြတ် ပြော​ကြား​ပါ​မည်။","poem":2},{"text":"ကိုယ်​တော်​အား​ထော​မ​နာ​သီ​ချင်း​ဆို​မည်။","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​သည်​သူ​ယုတ်​မာ​တို့​၏​တန်​ခိုး အာ​ဏာ​ကို ချိုး​နှိမ်​တော်​မူ​မည်။","poem":1},{"text":"သူ​တော်​ကောင်း​တို့​၏​တန်​ခိုး​အာ​ဏာ​ကို​မူ​ကား တိုး​တက်​စေ​တော်​မူ​လိမ့်​မည်။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/76.json","nextChapterAudioLinks":{},"previousChapterA