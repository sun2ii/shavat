eak":true},{"text":"မိ​မိ​၏​လူ​စု​တော်​ယင်း​သို့​ပြု​ကြ​သည်​ကို တွေ့​မြင်​တော်​မူ​သော​အ​ခါ","poem":1},{"text":"ကိုယ်​တော်​သည်​အ​မျက်​ထွက်​လျက်​သူ​တို့​အား လုံး​လုံး​စွန့်​ပစ်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":60,"content":[{"text":"ငါ​တို့​တွင်​ကိန်း​ဝပ်​တော်​မူ​ရာ​ရှိ​လော​မြို့​ရှိ တဲ​တော်​ကို ကိုယ်​တော်​သည်​စွန့်​ပစ်​တော်​မူ​၏။","poem":1}]},{"type":"verse","number":61,"content":[{"lineBreak":true},{"text":"တန်​ခိုး​တော်​နှင့်​ဘုန်း​အ​သ​ရေ​တော်​အ​ထိမ်း အ​မှတ် ဖြစ်​သော​ပ​ဋိ​ညာဉ်​သေတ္တာ​တော်​ကို​လည်း","poem":1},{"text":"ရန်​သူ​တို့​အား​သိမ်း​ယူ​ခွင့်​ပြု​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":62,"content":[{"text":"ကိုယ်​တော်​သည်​မိ​မိ​၏​လူ​စု​တော်​အား အ​မျက်​ထွက်​တော်​မူ​သ​ဖြင့်","poem":1},{"text":"သူ​တို့​ကို​သတ်​ဖြတ်​ရန်​ရန်​သူ​တို့​အား အ​ခွင့် ပေး​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":63,"content":[{"text":"ငယ်​ရွယ်​သူ​အ​မျိုး​သား​တို့​သည်​စစ်​ပွဲ​တွင် ကျ​ဆုံး​ကုန်​သ​ဖြင့်​ငယ်​ရွယ်​သူ","poem":1},{"text":"အ​မျိုး​သ​မီး​တို့​နှင့်​လက်​ထပ်​ထိမ်း​မြား​မည့်​သူ တစ်​စုံ​တစ်​ယောက်​မျှ​မ​ရှိ​တော့​ပေ။","poem":2}]},{"type":"verse","number":64,"content":[{"text":"ယဇ်​ပု​ရော​ဟိတ်​တို့​သည်​ဋ္ဌား​ဘေး​ဖြင့် သေ​ဆုံး​သွား​ကြ​ကုန်​၏။","poem":1},{"lineBreak":true},{"text":"သူ​တို့​၏​မု​ဆိုး​မ​များ​သည်​ငို​ကြွေး​မြည်​တမ်း​ခွင့် မ​ရ​ကြ။","poem":1}]},{"type":"line_break"},{"type":"verse","number":65,"content":[{"text":"နောက်​ဆုံး​၌​ထာ​ဝ​ရ​ဘု​ရား​သည်​အိပ်​ရာ​မှ နိုး​ထ​သူ​ကဲ့​သို့​လည်း​ကောင်း","poem":1},{"text":"စ​ပျစ်​ရည်​အ​ရှိန်​ဖြင့်​စိတ်​တက်​ကြွ​လာ​သော သူ​ရဲ​ကဲ့​သို့​လည်း​ကောင်း​နိုး​ထ​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":66,"content":[{"text":"မိ​မိ​၏​ရန်​သူ​များ​ကို​ထာ​ဝ​စဉ်​အ​ရှက်​ကွဲ အ​ရေး​ရှုံး​နိမ့်​စေ​တော်​မူ​၏။","poem":1}]},{"type":"verse","number":67,"content":[{"lineBreak":true},{"text":"သို့​ရာ​တွင်​ကိုယ်​တော်​သည်​ယော​သပ်​၏​သား​မြေး တို့​ကို ပစ်​ပယ်​တော်​မူ​၏။","poem":1},{"text":"ဧ​ဖ​ရိမ်​အ​မျိုး​အ​နွယ်​ကို​ရွေး​ချယ်​တော်​မ​မူ။","poem":2}]},{"type":"verse","number":68,"content":[{"text":"သူ​တို့​ကို​ရွေး​ချယ်​မည့်​အ​စား၊ယု​ဒ အ​မျိုး​အ​နွယ်​ကို​လည်း​ကောင်း၊","poem":1},{"text":"ကိုယ်​တော်​လွန်​စွာ​ချစ်​မြတ်​နိုး​သည့်","poem":2},{"text":"ဇိ​အုန်​တောင်​တော်​ကို​လည်း​ကောင်း ရွေး​ချယ်​တော်​မူ​၏။","poem":1}]},{"type":"verse","number":69,"content":[{"lineBreak":true},{"text":"ထို​တောင်​တော်​ပေါ်​တွင်​ကောင်း​ကင်​ဘုံ​ရှိ​အိမ်​တော်​နှင့် တူ​သော​ဗိ​မာန်​တော်​ကို​တည်​ဆောက်​တော်​မူ​၏။","poem":1},{"text":"ထို​ဗိ​မာန်​တော်​ကို​ကမ္ဘာ​မြေ​ကြီး​ကဲ့​သို့ ကာ​လ​ခပ်​သိမ်း​တည်​တံ့​ခိုင်​မြဲ​စေ​တော်​မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":70,"content":[{"text":"ကိုယ်​တော်​သည်​မိ​မိ​၏​အ​စေ​ခံ​ဒါ​ဝိဒ်​ကို ရွေး​ချယ်​တော်​မူ​၏။","poem":1},{"lineBreak":true},{"text":"သိုး​များ​ကို​ထိန်း​ကျောင်း​ရာ​မှ​သူ့​ကို​ခေါ်​ယူ တော်​မူ​၍ ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​၏​ဘု​ရင်၊","poem":1},{"text":"ဘု​ရား​သ​ခင်​လူ​စု​တော်​ကို​စောင့်​ထိန်း​သော သိုး​ထိန်း​အ​ဖြစ်​ခန့်​ထား​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":72,"content":[{"text":"ဒါ​ဝိဒ်​မင်း​သည်​သိုး​ထိန်း​အ​ဖြစ်​နှင့်​ထို​သူ​တို့​အား ကိုယ်​ကျိုး​စွန့်​ကာ​စောင့်​ရှောက်​ကြည့်​ရှု​၍","poem":1},{"text":"လိမ္မာ​ကျွမ်း​ကျင်​စွာ​ရှေ့​ဆောင်​လမ်းပြ​လေ​သည်။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":69}