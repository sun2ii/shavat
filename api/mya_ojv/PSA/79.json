{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":79,"content":[{"type":"heading","content":["အ​မျိုး​သား​လွတ်​မြောက်​ရေး​အ​တွက် ဆု​တောင်း​ပတ္ထနာ79:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ အာ​သပ်​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ပြည်​တော်​ထဲ​သို့​ဘု​ရား​မဲ့​သူ​တို့​ချဉ်း​နင်း ဝင်​ရောက်​ကြ​ပါ​ပြီ။","poem":2},{"text":"သူ​တို့​သည်​ကိုယ်​တော်​ရှင်​၏​သန့်​ရှင်း​မြင့်​မြတ်​သည့် ဗိ​မာန်​တော်​ကို​ညစ်​ညမ်း​စေ​ကြ​ပါ​ပြီ။","poem":1},{"lineBreak":true},{"text":"ယေ​ရု​ရှ​လင်​မြို့​ကို​လည်း​ဖြို​ဖျက်​လိုက်​ကြ ပါ​ပြီ။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"သူ​တို့​သည်​ကိုယ်​တော်​ရှင့်​လူ​စု​တော်​၏","poem":1},{"text":"အ​လောင်း​များ​ကို​ငှက်​စာ​ဖြစ်​စေ​ရန်​လည်း​ကောင်း၊","poem":2},{"text":"ကိုယ်​တော်​ရှင့်​အ​စေ​ခံ​တို့​၏​အ​လောင်း​များ​ကို","poem":1},{"text":"သား​ရဲ​တိရစ္ဆာန်​စာ​ဖြစ်​စေ​ရန်​လည်း​ကောင်း ပစ်​ထား​ကြ​ပါ​ပြီ။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"သူ​တို့​သည်​ကိုယ်​တော်​ရှင့်​လူ​စု​၏​သွေး​ကို ရေ​ကဲ့​သို့ ယို​စီး​စေ​ကြ​ပါ​၏။","poem":1},{"text":"သွေး​ချောင်း​သည်​ယေ​ရု​ရှ​လင်​မြို့​ကို​ဖြတ်​၍ စီး​ဆင်း​လျက်​ရှိ​ပါ​၏။","poem":2},{"text":"အ​လောင်း​များ​ကို​သင်္ဂြိုဟ်​မည့်​သူ​တစ်​စုံ တစ်​ယောက်​မျှ မ​ကျန်​တော့​ပါ။","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ပတ်​လည်​ရှိ​တိုင်း​နိုင်​ငံ​တို့​သည်​ကျွန်​တော်​မျိုး တို့​အား ပြက်​ရယ်​ပြု​ကြ​ပါ​၏။ ကဲ့​ရဲ့​ပြောင်​လှောင်​ကြ​ပါ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​သည်​ကျွန်​တော်​မျိုး​တို့​အား​ထာ​ဝ​စဉ် အ​မျက်​ထွက်​လျက်​နေ​တော်​မူ​ပါ​မည်​လော။","poem":2},{"text":"အ​မျက်​တော်​သည်​မ​ပြေ​ဘဲ​မီး​ကဲ့​သို့​တောက်​လောင် နေ​ပါ​မည်​လော။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​ရှင်​အား​ရှိ​မ​ခိုး၊ဝတ်​မ​ပြု​သည့်","poem":1},{"text":"လူ​မျိုး​တို့​အား​လည်း​ကောင်း၊ကိုယ်​တော်​ရှင်​ထံ","poem":2},{"text":"ဆု​တောင်း​ပတ္ထ​နာ​မ​တောင်း​မ​လျှောက် သူ​တို့​အား​လည်း​ကောင်း​အ​မျက်​ထွက်​တော်​မူ​ပါ။","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ထို​သူ​တို့​သည်​ကိုယ်​တော်​ရှင်​၏​လူ​စု​တော်​ကို သတ်​ဖြတ်​ကြ​ပါ​ပြီ။","poem":1},{"text":"ပြည်​တော်​ကို​လည်း​ယို​ယွင်း​ပျက်​စီး​စေ​ကြ​ပါ​ပြီ။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ဘိုး​ဘေး​တို့​၏​အ​ပြစ်​များ​အ​တွက်","poem":1},{"text":"ကျွန်​တော်​မျိုး​တို့​အား​ဒဏ်​ခတ်​တော်​မ​မူ​ပါ​နှင့်။","poem":2},{"text":"ယ​ခု​ကျွန်​တော်​မျိုး​တို့​ကို​သ​နား​တော်​မူ​ပါ။","poem":1},{"text":"ကျွန်​တော်​မျိုး​တို့​သည်​မျှော်​လင့်​ရာ​မဲ့​လျက် ရှိ​ကြ​ပါ​၏။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​တို့​ကို​ကူ​မ​တော်​မူ​ပါ။ ကယ်​မ​တော်​မူ​ပါ။","poem":2},{"text":"ကိုယ်​တော်​ရှင်​၏​နာ​မ​တော်​ကို​ထောက်​၍ ကျွန်​တော်​မျိုး​တို့​ကို​ကယ်​ဆယ်​တော်​မူ​၍","poem":1},{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​တို့​၏​အ​ပြစ်​များ​ကို ဖြေ​လွှတ်​တော်​မူ​ပါ။","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"``သင်​တို့​၏​ဘု​ရား​သည်​အ​ဘယ်​မှာ​နည်း'' ဟု","poem":1},{"text":"လူ​မျိုး​တ​ကာ​တို့​သည်​အ​ဘယ်​ကြောင့် မေး​ရ​ကြ​ပါ​မည်​နည်း။","poem":2},{"text":"ကိုယ်​တော်​ရှင်​၏​အ​စေ​ခံ​တို့​၏​သွေး​ကို​သွန်​သည့် လူ​မျိုး​တို့​အား​အ​ပြစ်​ဒဏ်​ခတ်​တော်​မူ​သည်​ကို","poem":1},{"text":"ကျွန်​တော်​မျိုး​တို့​မြင်​ရ​ကြ​ပါ​စေ​သော။","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"အ​ကျဉ်း​သား​တို့​၏​ညည်း​ညူ​သံ​များ​ကို နား​ထောင်​တော်​မူ​၍​သေ​ဒဏ်​သင့်​သူ​တို့​အား","poem":1},{"text":"ကိုယ်​တော်​ရှင်​၏​မ​ဟာ​တန်​ခိုး​တော်​ဖြင့် လွတ်​မြောက်​စေ​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":12,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊ ကိုယ်​တော်​ရှင်​အား​စော်​ကား​ပြော​ဆို ကြ​သည့်","poem":1},{"text":"တိုင်း​နိုင်​ငံ​တို့​သည်​ခု​နစ်​ဆ​မျှ​ပို​၍ အ​စော်​ကား​ခံ​စေ​တော်​မူ​ပါ။","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ထို​အ​ခါ​သိုး​စု​တော်​တည်း​ဟူ​သော​ကိုယ်​တော်​ရှင်​၏ လူ​စု​တော်​ဖြစ်​သည့်​ကျွန်​တော်​မျိုး​တို့​သည်","poem":1},{"text":"ကျေး​ဇူး​တော်​ကို​အ​စဉ်​မ​ပြတ်​ချီး​မွမ်း​ကြ ပါ​မည်။","poem":2},{"text":"သား​စဉ်​မြေး​ဆက်​ဂုဏ်​တော်​ကို​ချီး​ကူး​ကြ ပါ​မည်။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}