{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":8,"content":[{"type":"heading","content":["ထာ​ဝ​ရ​ဘု​ရား​၏​ဘုန်း​အ​သ​ရေ​တော်​နှင့် လူ​၏​ဂုဏ်​ဒြပ်8:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"အို ကျွန်​တော်​မျိုး​တို့​၏​ဘု​ရား​ရှင်​ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ကြီး​မြတ်​တော်​မူ​ပုံ​ကို ကမ္ဘာ​တစ်​ပြင်​လုံး​တွင်​တွေ့​မြင်​ရ​ကြ​ပါ​၏။","poem":2},{"text":"ကိုယ်​တော်​အား​ထော​မ​နာ​ပြု​သည့်​သီ​ချင်း သံ​သည် ကောင်း​ကင်​ဘ​ဝဂ်​တိုင်​အောင်​ရောက်​ရှိ​ပါ​၏။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ယင်း​သီ​ချင်း​ကို​က​လေး​များ​နှင့်​နို့​စို့​သူ​ငယ် များ​က သီ​ဆို​ကြ​ပါ​၏။","poem":1},{"text":"ကိုယ်​တော်​သည်​ရန်​သူ​များ​၏​ဘေး​မှ ကင်း​လွတ်​လုံ​ခြုံ​ပါ​၏။","poem":2},{"text":"ကိုယ်​တော်​အား​ရန်​မူ​သူ​များ​ကို​ဆီး​တား​တော် မူ​ပါ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ကိုယ်​တော်​ရှင်​ဖန်​ဆင်း​တော်​မူ​သော မိုး​ကောင်း​ကင်​ကို​လည်း​ကောင်း၊","poem":1},{"text":"စီ​မံ​ထား​ရှိ​တော်​မူ​သော","poem":2},{"text":"လ​နှင့်​ကြယ်​တာ​ရာ​များ​ကို​လည်း​ကောင်း ကျွန်​တော်​မျိုး​တွေ့​မြင်​ရ​ပါ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"သို့​ဖြစ်​၍​လူ​သည်​အ​ဘယ်​သို့​သော​သူ​ဖြစ်​၍","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​သူ့​အား အောက်​မေ့​တော်​မူ​ရ​ပါ​သ​နည်း။","poem":2},{"text":"လူ​သား​သည်​အ​ဘယ်​သို့​သော​သူ​ဖြစ်​၍","poem":1},{"text":"ကိုယ်​တော်​သည်​သူ့​ကို​ကြည့်​ရှု​စောင့်​ရှောက် တော်​မူ​ရ​ပါ​သ​နည်း။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"သူ့​အား​ကောင်း​ကင်​တ​မန်​တို့​ထက်​သာ နိမ့်​ကျ​စေ​တော်​မူ​လျက်","poem":1},{"text":"သူ့​အား​ဘုန်း​အ​သ​ရေ​ကို​လည်း​ကောင်း၊","poem":2},{"text":"ဂုဏ်​အ​သ​ရေ​ကို​လည်း​ကောင်း​ချီး​မြှင့်​တော် မူ​၏။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"သူ့​အား​ကိုယ်​တော်​ဖန်​ဆင်း​တော်​မူ​သော​အ​ရာ ရှိ​သ​မျှ​တို့​ကို​အုပ်​စိုး​ခွင့်​ပေး​တော်​မူ​၏။","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​ဖန်​ဆင်း​တော်​မူ​သော​သိုး၊နွား၊ တော​တိရစ္ဆာန်၊ငှက်၊ငါး​နှင့်","poem":1},{"text":"ပင်​လယ်​ရေ​သတ္တ​ဝါ​တို့​ကို​အုပ်​စိုး​ခွင့်​ပေး​တော် မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"အို ကျွန်​တော်​မျိုး​တို့​၏​ဘု​ရား​ရှင်​ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ကြီး​မြတ်​တော်​မူ​ပုံ​ကို​ကမ္ဘာ​မြေ တစ်​ပြင်​လုံး​တွင်​တွေ့​မြင်​ရ​ကြ​ပါ​၏။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":8}