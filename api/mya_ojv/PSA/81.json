{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":81,"content":[{"type":"heading","content":["ပွဲ​သ​ဘင်​သီ​ချင်း81:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ အာ​သပ်​စပ်​ဆို​သည်။"]},{"type":"verse","number":1,"content":[{"text":"ငါ​တို့​ဘက်​မှ​ကာ​ကွယ်​တော်​မူ​သော​အ​ရှင် တည်း​ဟူ​သော​ဘု​ရား​သ​ခင်​အား","poem":1},{"text":"ဝမ်း​မြောက်​စွာ​သီ​ချင်း​ဆို​ကြ​လော့။","poem":2},{"text":"ယာ​ကုပ်​၏​ဘု​ရား​အား​ထော​မ​နာ​သီ​ချင်း​ဆို ကြ​လော့။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"သီ​ဆို​တီး​မှုတ်​မှု​ကို​အ​စ​ပြု​ကြ​လော့။ စောင်း ကြီး စောင်း​ငယ်​တို့​ကို​သာ​ယာ​စွာ​တီး​ကြ​လော့။","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"လ​ဆန်း​နေ့​နှင့်​လ​ပြည့်​နေ့​တွင်​ပွဲ​သ​ဘင်","poem":1},{"text":"ကျင်း​ပ​ရန်​အ​တွက်​တံ​ပိုး​ခ​ရာ​မှုတ်​ကြ လော့။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ဤ​သို့​ပွဲ​သ​ဘင်​ကျင်း​ပ​ရန်​ဣ​သ​ရေ​လ အ​မျိုး​သား​တို့​၌​ဥ​ပ​ဒေ​ရှိ​ပေ​သည်။","poem":1},{"text":"ယာ​ကုပ်​၏​ဘု​ရား​သ​ခင်​ပေး​တော်​မူ​သော အ​မိန့်​တော်​လည်း​ဖြစ်​ပေ​သည်။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ကိုယ်​တော်​သည်​အီ​ဂျစ်​ပြည်​ကို​တိုက်​ခိုက်​တော် မူ​စဉ်​က","poem":1},{"text":"ယင်း​အ​မိန့်​ကို​ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​အား ပေး​တော်​မူ​၏။","poem":2},{"lineBreak":true},{"text":"မ​သိ​မ​ကျွမ်း​သော​အ​သံ​ကို​ငါ​ကြား​ရ​၏။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ထို​အ​သံ​က``သင်​တို့​၏​ပ​ခုံး​ထက်​မှ​လေး​လံ သော ဝန်​ထုပ်​ကို​ငါ​ယူ​ပစ်​လျက်","poem":1},{"text":"သင်​တို့​အုတ်​သယ်​သည့်​ခြင်း​တောင်း​များ​ကို ချ​ထား​စေ​၏။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"သင်​တို့​သည်​ဒုက္ခ​ရောက်​စဉ်​အ​ခါ​၌ ငါ့​ကို​အော်​ဟစ်​သော​အ​ခါ","poem":1},{"text":"ငါ​သည်​သင်​တို့​အား​ကယ်​ခဲ့​၏။","poem":2},{"text":"မိုး​သက်​မုန်​တိုင်း​အ​တွင်း​မ​မြင်​နိုင်​သော​အ​ရပ် မှ​နေ​၍ သင်​တို့​အား​ငါ​ဖြေ​ကြား​ခဲ့​၏။","poem":1},{"text":"မေ​ရိ​ဘ​စမ်း​ရေ​အ​နီး​တွင်​သင်​တို့​အား​ငါ သွေး​စမ်း​ခဲ့​၏။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ငါ​၏​လူ​စု​တော်​တို့၊ငါ​သ​တိ​ပေး​သည်​ကို နား​ထောင်​စေ​ချင်​စမ်း​ပါ​ဘိ။","poem":1},{"text":"ဣသ​ရေ​လ​အ​မျိုး​သား​တို့၊သင်​တို့​သည်​ငါ့ စ​ကား​ကို နား​ထောင်​ကြ​လော့။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"သင်​တို့​သည်​အ​ခြား​သော​ဘု​ရား​ကို​အ​ဘယ် အ​ခါ​၌​မျှ မ​ကိုး​ကွယ်​ရ။","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ငါ​သည်​သင်​တို့​ကို​အီ​ဂျစ်​ပြည်​မှ​ထုတ်​ဆောင် ခဲ့​သော သင်​တို့​၏​ဘု​ရား​သ​ခင်​ထာ​ဝ​ရ​ဘု​ရား​ဖြစ်​၏။","poem":1},{"text":"သင်​တို့​ခံ​တွင်း​ကို​ဖွင့်​ဟ​ကြ​လော့။ ငါ​သည်​သင်​တို့​အား​ကျွေး​မွေး​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"သို့​ရာ​တွင်​ငါ​၏​လူ​စု​တော်​ကား​ငါ့​စ​ကား​ကို နား​မ​ထောင်​ကြ။","poem":1},{"lineBreak":true},{"text":"ဣသ​ရေ​လ​အ​မျိုး​သား​တို့​သည်​ငါ့​အ​မိန့်​ကို မ​နာ​ခံ​ကြ။","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"သို့​ဖြစ်​၍​ငါ​သည်​သူ​တို့​အား​ခေါင်း​မာ​မြဲ​မာ စေ​ရန်​နှင့်","poem":1},{"text":"သူ​တို့​အ​လို​အ​တိုင်း​ပြု​ကျင့်​စေ​ရန်​အ​ခွင့်​ပေး​၏။","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ငါ​၏​လူ​စု​တော်​သည်​ငါ့​စ​ကား​ကို နား​ထောင်​စေ​ချင်​စမ်း​ပါ​ဘိ။","poem":1},{"text":"ငါ့​အ​မိန့်​ကို​နာ​ခံ​စေ​ချင်​စမ်း​ပါ​ဘိ။","poem":2}]},{"type":"verse","number":14,"content":[{"text":"သို့​ဖြစ်​လျှင်​ငါ​သည်​သူ​တို့​၏​ရန်​သူ​များ​ကို အ​လျင်​အ​မြန်​အ​ရေး​ရှုံး​နိမ့်​စေ​မည်။","poem":1},{"text":"သူ​တို့​၏​ရန်​ဘက်​အား​လုံး​ကို​နှိမ်​နင်း​မည်။","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ငါ့​ကို​မုန်း​သော​သူ​တို့​သည်​ငါ့​ရှေ့​၌ ကြောက်​ရွံ့​ပျပ်​ဝပ်​ကြ​လိမ့်​မည်။","poem":1},{"text":"သူ​တို့​သည်​ထာ​ဝ​ရ​အ​ပြစ်​ဒဏ်​ခံ​ရ​ကြ လိမ့်​မည်။","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ငါ​သည်​သင်​တို့​အား​အ​ကောင်း​ဆုံး​ဂျုံ​ဆန်​ကို ကျွေး​မွေး​၍","poem":1},{"text":"တော​ပျား​ရည်​ကို​သုံး​ဆောင်​စေ​မည်'' ဟု​ဆို​၏။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}