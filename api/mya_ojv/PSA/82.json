{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":82,"content":[{"type":"heading","content":["ဘု​ရင်​တ​ကာ​တို့​၏​ဘု​ရင်​ဖြစ်​တော်​မူ​သော ဘု​ရား​သ​ခင်82:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ အာ​သပ်​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"ဘု​ရား​သ​ခင်​သည်​ကောင်း​ကင်​တွင်​ကျင်း​ပ သည့် ကောင်​စီ​အ​စည်း​အ​ဝေး​၌​နေ​ရာ​ယူ​တော်​မူ​၏။","poem":1},{"text":"ကိုယ်​တော်​သည်​ဘု​ရား​တို့​၏​အ​စည်း​ဝေး​၌ စီ​ရင်​ဆုံး​ဖြတ်​တော်​မူ​သည်​မှာ","poem":2}]},{"type":"verse","number":2,"content":[{"text":"``သင်​တို့​သည်​မ​တ​ရား​သ​ဖြင့်​စီ​ရင်​ဆုံး​ဖြတ် မှု​ကို မ​ပြု​ကြ​တော့​နှင့်။","poem":1},{"text":"သူ​ယုတ်​မာ​တို့​၏​မျက်​နှာ​ကို​ထောက်​၍","poem":2},{"text":"တ​ရား​စီ​ရင်​မှု​ကို​မ​ကျင့်​သုံး​ကြ​တော့​နှင့်။","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ဆင်း​ရဲ​သူ​နှင့်​မိ​ဘ​မဲ့​သူ​တို့​၏​ရ​ပိုင်​ခွင့် များ​ကို ကွယ်​ကာ​စောင့်​ရှောက်​ရ​ကြ​မည်။","poem":1},{"text":"ချို့​တဲ့​နွမ်း​ပါး​သူ​နှင့်​ခို​ကိုး​ရာ​မဲ့​သူ​တို့​အ​တွက် တ​ရား​မျှ​တ​စွာ​တ​ရား​စီ​ရင်​ရ​ကြ​မည်။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"သူ​တို့​အား​မ​တ​ရား​သော​သူ​တို့​၏​လက်​မှ ကယ်​ဆယ်​ရ​ကြ​မည်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"``သင်​တို့​သည်​အ​သိ​ဉာဏ်​ကင်း​မဲ့​လျက်​လွန်​စွာ​ပင် မိုက်​မဲ​ကြ​ပါ​သည်​တ​ကား။","poem":1},{"text":"သင်​တို့​သည်​လုံး​ဝ​အ​ကျင့်​ပျက်​ကြ​ပြီ။","poem":2},{"text":"တ​ရား​မျှ​တ​မှု​သည်​ကမ္ဘာ​လော​က​မှ ကွယ်​ပျောက်​သွား​လေ​ပြီ။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"သင်​တို့​သည်​ဘု​ရား​များ​ဖြစ်​ကြောင်း၊","poem":1},{"text":"အ​မြင့်​မြတ်​ဆုံး​ဖြစ်​တော်​မူ​သော​ဘု​ရား​၏ သား​များ ဖြစ်​ကြောင်း​ကို​ငါ​ဖော်​ပြ​ခဲ့​၏။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"သို့​ရာ​တွင်​သင်​တို့​သည်​လူ​သာ​မန်​များ​နည်း​တူ သေ​ရ​ကြ​မည်။","poem":1},{"lineBreak":true},{"text":"မင်း​သား​တို့​နည်း​တူ​အ​သက်​ကုန်​ဆုံး​ရ​ကြ​မည်။''","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"အို ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ကြွ​လာ​တော်​မူ​၍​ကမ္ဘာ​လော​က​ကို​အုပ်​စိုး​တော် မူ​ပါ။","poem":2},{"text":"လူ​မျိုး​တ​ကာ​တို့​ကို​ကိုယ်​တော်​ရှင်​ပိုင်​တော် မူ​ပါ​၏။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}