{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":84,"content":[{"type":"heading","content":["ဘု​ရား​သ​ခင်​၏​အိမ်​တော်​ကို​တ​သ​ခြင်း84:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ အာ​သပ်​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"အ​နန္တ​တန်​ခိုး​ရှင်​ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​ကိုယ်​တော်​ရှင်​၏​ဗိ​မာန် တော်​ကို အ​လွန်​နှစ်​သက်​မြတ်​နိုး​လျက်","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ထို​အ​ရပ်​တွင်​လွန်​စွာ​နေ​လို​လှ​ပါ​သည်။","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​ထာ​ဝ​ရ​ဘု​ရား​၏​ဗိ​မာန်​တော် တံ​တိုင်း​များ​ကို​တ​သ​ပါ​၏။","poem":2},{"text":"အ​သက်​ရှင်​တော်​မူ​သော​ဘု​ရား​သ​ခင်​အား","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​စိတ်​ရော​ကိုယ်​ပါ​ဝမ်း မြောက်​စွာ ထော​မ​နာ​သီ​ချင်း​ဆို​ပါ​၏။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ကျွန်​တော်​မျိုး​၏​ဘု​ရင်၊ကျွန်​တော်​မျိုး​၏​ဘု​ရား ဖြစ်​တော်​မူ​သော​အ​နန္တ​တန်​ခိုး​ရှင်​ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"စာ​ငှက်​များ​နှင့်​ဇ​ရက်​များ​ပင်​လျှင်​မိ​မိ​တို့​၏ အ​သိုက်​အ​အုံ​များ​ကို","poem":2},{"text":"ကိုယ်​တော်​ရှင်​၏​ယဇ်​ပလ္လင်​အ​နီး​တွင်​ဆောက် လုပ်​၍ သား​ငယ်​များ​ကို​ထား​ကြ​ပါ​၏။","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​ရှင်​အား​အ​စဉ်​မ​ပြတ်​ထော​မ​နာ ပြု​လျက်","poem":1},{"text":"ဗိ​မာန်​တော်​တွင်​နေ​ကြ​သူ​တို့​သည်​အ​လွန်​ပင် မင်္ဂ​လာ​ရှိ​ပါ​သည်​တ​ကား။","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ကိုယ်​တော်​ရှင်​၏​ထံ​တော်​မှ​ခွန်​အား​စွမ်း​ရည်​ကို ခံ​ယူ​ရ​ရှိ​သော​သူ​တို့​သည်​မင်္ဂ​လာ​ရှိ​ကြ​ပါ​၏။","poem":1},{"text":"သူ​တို့​သည်​ဇိ​အုန်​တောင်​တော်​သို့​ခ​ရီး​ပြု​ရန် စိတ်​ထက်​သန်​ကြ​ပါ​၏။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ထို​သူ​တို့​သည်​ခြောက်​သွေ့​နေ​သည့်​ဗာ​ကာ ချိုင့်​ဝှမ်း​ကို ဖြတ်​သန်း​သွား​စဉ်​ရေ​များ​ပေါက်​၍​လာ​ပါ​၏။","poem":1},{"text":"မိုး​ဦး​ရွာ​သ​ဖြင့်​အိုင်​များ​ထွန်း​၍​လာ​ပါ​၏။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ထို​သူ​တို့​သည်​ခ​ရီး​ပြု​ရင်း​ခွန်​အား​တိုး​၍ လာ​ကြ​ပါ​၏။","poem":1},{"text":"ဇိ​အုန်​တောင်​တော်​ပေါ်​တွင်​ဘု​ရား​တ​ကာ တို့​၏ ဘု​ရား​ကို​ဖူး​မြင်​ရ​ကြ​ပါ​လိမ့်​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"အ​နန္တ​တန်​ခိုး​ရှင်​ဘု​ရား​သ​ခင်​ထာ​ဝ​ရ ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​ဆု​တောင်း​ပတ္ထနာ​ကို နား​ညောင်း​တော်​မူ​ပါ။","poem":2},{"text":"အို ယာ​ကုပ်​၏​ဘု​ရား​သ​ခင်၊ နား​ထောင်​တော်​မူ​ပါ။","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"အို ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​ရွေး​ချယ်​ထား​တော်​မူ​သော","poem":2},{"text":"ဘု​ရင်​တည်း​ဟူ​သော​ကျွန်​တော်​မျိုး​တို့ ၏​ဘု​ရင်​ကို ကောင်း​ချီး​ပေး​တော်​မူ​ပါ။","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ကိုယ်​တော်​ရှင်​၏​ဗိ​မာန်​တော်​တွင်​တစ်​ရက်​မျှ နေ​ရ​ခြင်း​သည်","poem":1},{"text":"အ​ခြား​သော​အ​ရပ်​တွင်​ရက်​ပေါင်း​တစ်​ထောင် နေ​ရ​ခြင်း​ထက်​သာ​၍​မြတ်​ပါ​၏။","poem":2},{"text":"ဘု​ရား​သ​ခင်​၏​အိမ်​တော်​တံ​ခါး​စောင့်​ဖြစ်​ရ ခြင်း​သည်","poem":1},{"text":"သူ​ယုတ်​မာ​တို့​၏​အိမ်​တွင်​နေ​ရ​ခြင်း​ထက် သာ​၍​မြတ်​ပါ​၏။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ငါ​တို့​အား","poem":1},{"text":"ကွယ်​ကာ​တော်​မူ​သော​အ​ရှင်၊ဘုန်း​ကြီး​တော် မူ​သော ဘု​ရင်​ဖြစ်​တော်​မူ​၏။","poem":2},{"text":"ကိုယ်​တော်​သည်​ငါ​တို့​အား​သ​နား​ကြင်​နာ​၍ ချီး​မြှင့်​တော်​မူ​၏။","poem":1},{"text":"ကိုယ်​တော်​သည်​မှန်​ရာ​ကို​ပြု​ကျင့်​သူ​တို့​အား","poem":2},{"text":"ကောင်း​မြတ်​သည့်​အ​ရာ​များ​ကို​ပေး​ရန်​ငြင်း တော်​မ​မူ။","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"အ​နန္တ​တန်​ခိုး​ရှင်​ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​ကို​ကိုး​စား​သူ​တို့​သည် အ​လွန်​မင်္ဂလာ​ရှိ​ပါ​သည်​တ​ကား။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}