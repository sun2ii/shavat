{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":85,"content":[{"type":"heading","content":["နိုင်​ငံ​၏​အ​ကျိုး​စီး​ပွား​အ​တွက်​ဆု​တောင်း​ပတ္ထနာ85:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ကော​ရ​၏​သား​များ​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​မိ​မိ​၏​ပြည်​တော်​ကို သ​နား​တော်​မူ​ပါ​ပြီ။","poem":2},{"text":"ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​အား​တစ်​ဖန် ပြန်​လည်​ချမ်း​သာ​ကြွယ်​ဝ​စေ​တော်​မူ​ပါ​ပြီ။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​သည်​မိ​မိ​လူ​စု​တော်​၏​အ​ပြစ် များ​ကို","poem":1},{"text":"ဖြေ​လွှတ်​တော်​မူ​၍​သူ​တို့​၏​အ​မှား​များ​ကို ခွင့်​လွှတ်​တော်​မူ​ပါ​ပြီ။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"သူ​တို့​အား​အ​မျက်​ထွက်​တော်​မ​မူ​တော့​ဘဲ","poem":1},{"text":"ကိုယ်​တော်​၏​ပြင်း​ထန်​သော​အ​မျက်​ပြေ​တော် မူ​ပါ​ပြီ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ကျွန်​တော်​မျိုး​တို့​၏​ကယ်​တင်​ရှင်​ဘု​ရား​သ​ခင်၊ ကျွန်​တော်​မျိုး​တို့​အား​ပြန်​လာ​စေ​တော်​မူ​ပါ။","poem":1},{"text":"ကျွန်​တော်​မျိုး​တို့​အား​မ​နှစ်​သက်​မှု​ရှိ​တော် မ​မူ​ပါ​နှင့်။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ကိုယ်​တော်​ရှင်​သည်​အ​စဉ်​အ​မြဲ​အ​မျက်​ထွက်​၍ နေ​တော်​မူ​ပါ​မည်​လော။","poem":1},{"text":"အ​မျက်​တော်​သည်​အ​ဘယ်​အ​ခါ​၌​မျှ ပြေ​တော်​မ​မူ​တော့​ပြီ​လော။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ကျွန်​တော်​မျိုး​တို့​ကို​အား​သစ်​လောင်း​တော် မူ​ပါ။","poem":1},{"text":"သို့​ပြု​တော်​မူ​ပါ​လျှင်​ကိုယ်​တော်​ရှင်​၏","poem":2},{"text":"လူ​စု​တော်​ဖြစ်​သော​ကျွန်​တော်​မျိုး​တို့​သည် ကိုယ်​တော်​ရှင်​အား​ထော​မ​နာ​ပြု​ကြ​ပါ​မည်။","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​၏​ခိုင်​မြဲ​သော​မေတ္တာ​တော်​ကို","poem":2},{"text":"ပြ​တော်​မူ​၍​ကျွန်​တော်​မျိုး​တို့​အား ကယ်​တင်​တော်​မူ​ပါ။","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ငါ​သည်​ထာ​ဝ​ရ​အ​ရှင်​ဘု​ရား​သ​ခင်","poem":1},{"text":"မိန့်​တော်​မူ​သည်​ကို​နား​ထောင်​လျက်​နေ​၏။","poem":2},{"text":"ငါ​တို့​သည်​မိုက်​မဲ​သော​လမ်း​စဉ်​ကို​စွန့်​ပစ်​ပါ​လျှင် ကိုယ်​တော်​သည်​မိ​မိ​၏​လူ​စု​တော်​တည်း​ဟူ​သော","poem":1},{"text":"ငါ​တို့​အား​ငြိမ်း​ချမ်း​သာ​ယာ​မှု​ကို​ပေး​တော် မူ​မည်​ဟု က​တိ​ပြု​တော်​မူ​ပါ​၏။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ကိုယ်​တော်​သည်​မိ​မိ​အား​ကြောက်​ရွံ့​ရို​သေ​သော","poem":1},{"text":"သူ​တို့​ကို​ကယ်​တော်​မူ​ရန်​အ​မှန်​ပင် အ​သင့်​ရှိ​တော်​မူ​၏။","poem":2},{"text":"ကိုယ်​တော်​၏​ဘုန်း​အ​သ​ရေ​တော်​သည်​လည်း ငါ​တို့​ပြည်​တွင်​ကျိန်း​ဝပ်​လျက်​နေ​လိမ့်​မည်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"မေတ္တာ​နှင့်​သစ္စာ​သည်​ဆုံ​မိ​ကြ​လိမ့်​မည်။","poem":1},{"text":"တ​ရား​မျှ​တ​မှု​နှင့်​ငြိမ်း​ချမ်း​သာ​ယာ​မှု​သည် ဖက်​ယမ်း​ကြ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"လူ​တို့​သစ္စာ​စောင့်​မှု​သည်​ကမ္ဘာ​လော​က​မှ ပေါ်​ထွက်​လာ​၍","poem":1},{"text":"ဘု​ရား​သ​ခင်​၏​တ​ရား​မျှ​တ​မှု​သည် ကောင်း​ကင်​ဘုံ​မှ​ငုံ့​ကြည့်​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ငါ​တို့​အား ကြွယ်​ဝ​ချမ်း​သာ​စေ​တော်​မူ​လိမ့်​မည်။","poem":1},{"text":"ငါ​တို့​၏​ပြည်​သည်​လည်း​ကောက်​ပဲ​သီး​နှံ များ​စွာ​ထွက်​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":13,"content":[{"text":"တ​ရား​မျှ​တ​မှု​သည်​ထာ​ဝ​ရ​ဘု​ရား​၏","poem":1},{"text":"ရှေ့​တော်​ပြေး​ဖြစ်​၍​ကြွ​လာ​တော်​မူ​ရာ​လမ်း ခ​ရီး​ကို ကြို​တင်​ပြင်​ဆင်​ပေး​လိမ့်​မည်။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}