{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":87,"content":[{"type":"heading","content":["ယေ​ရု​ရှ​လင်​မြို့​ကို​ထော​မ​နာ​ပြု​ခြင်း87:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ကော​ရ​၏​သား​များ​စပ်​ဆို​သော​ဆာ​လံ​သီ​ချင်း။"]},{"type":"verse","number":1,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​မိ​မိ​၏​မြို့​တော်​ကို","poem":1},{"text":"သန့်​ရှင်း​မြင့်​မြတ်​သည့်​တောင်","poem":2},{"noteId":6},{"text":"ပေါ်​တွင် တည်​ဆောက်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ကိုယ်​တော်​သည်​ယေ​ရု​ရှ​လင်​မြို့​ကြီး​ကို","poem":1},{"text":"ဣ​သ​ရေ​လ​နိုင်​ငံ​ရှိ​အ​ခြား​မြို့​အ​ပေါင်း​တို့​ထက် ပို​၍​နှစ်​သက်​မြတ်​နိုး​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"အို ဘု​ရား​သ​ခင်​၏​မြို့​တော်၊","poem":1},{"text":"သင်​၏​အ​ကြောင်း​ကိုယ်​တော်​ယ​ခု​မိန့်​တော် မူ​သော အံ့​သြ​ဖွယ်​ရာ​များ​ကို​နား​ထောင်​လော့။","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ကိုယ်​တော်​မိန့်​တော်​မူ​သည်​မှာ","poem":1},{"text":"``ငါ​၏​စ​ကား​ကို​နား​ထောင်​သည့်​နိုင်​ငံ​များ","poem":2},{"text":"စာ​ရင်း​ကို​ယူ​သော​အ​ခါ​အီ​ဂျစ်​ပြည်​နှင့် ဗာ​ဗု​လုန်​ပြည်​ကို​ငါ​ထည့်​သွင်း​မည်။","poem":1},{"lineBreak":true},{"text":"ဖိ​လိတ္တိ​ပြည်၊တု​ရု​ပြည်​နှင့်​ဆူ​ဒန်​ပြည်​မှ","poem":1},{"text":"လူ​တို့​သည်​လည်း​ယေ​ရု​ရှ​လင်​မြို့​သား​များ စာ​ရင်း​တွင်​ငါ​ဖော်​ပြ​မည်။''","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ဇိ​အုန်​တောင်​အား​လူ​မျိုး​အ​ပေါင်း​တို့​ဖွား​မြင်​ရာ မိ​ခင်​ဟူ​၍​လည်း​ကောင်း၊","poem":1},{"text":"အ​မြင့်​မြတ်​ဆုံး​ဖြစ်​တော်​မူ​သော​ဘု​ရား​သည်","poem":2},{"text":"ထို​တောင်​ကို​ခိုင်​ခံ့​စေ​တော်​မူ​လိမ့်​မည် ဟူ​၍​လည်း​ကောင်း​လူ​တို့​ပြော​ဆို​ကြ လိမ့်​မည်။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​လူ​မျိုး​တို့​ကို​စာ​ရင်း ပြု​စု​တော်​မူ​လိမ့်​မည်။","poem":1},{"text":"ယင်း​စာ​ရင်း​တွင်​ပါ​ရှိ​သော​သူ​အ​ပေါင်း တို့​ကို","poem":2},{"text":"ယေ​ရု​ရှ​လင်​မြို့​သား​များ​အ​ဖြစ်​ဖြင့်​ထည့်​သွင်း ရေး​မှတ်​တော်​မူ​လိမ့်​မည်။","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ထို​သူ​အ​ပေါင်း​တို့​သည်​က​ခုန်​လျက် ``ဇိ​အုန်​တောင်​သည်","poem":1},{"text":"ငါ​တို့​ခံ​စား​ရ​သော​ကောင်း​ချီး​မင်္ဂလာ​အ​ပေါင်း စီး​ဆင်း​ရာ​ဖြစ်​ပေ​သည်'' ဟု​သီ​ဆို​ကြ​၏။","poem":2}]}],"footnotes":[{"noteId":6,"caller":"5","text":"* သန့်​ရှင်း​မြင့်​မြတ်​သည့်​တောင်။ ၂:၆ ကို​ကြည့်​ပါ။","reference":{"chapter":87,"verse":1}}]},"thisChapterLink":"/api/mya_ojv/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}