{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":88,"content":[{"type":"heading","content":["ကူ​မ​တော်​မူ​ရန်​အော်​ဟစ်​တောင်း​လျှောက်​ခြင်း88:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ကော​ရ​၏​သား​များ​စပ်​ဆို​သော​ဆာ​လံ​သီ​ချင်း။"]},{"type":"verse","number":1,"content":[{"text":"ကျွန်​တော်​မျိုး​ကို​ကယ်​တင်​တော်​မူ​သော ထာ​ဝ​ရ​အ​ရှင်​ဘု​ရား​သ​ခင်၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​နေ့​အ​ချိန်​၌​ဟစ်​အော်​၍","poem":2},{"text":"ည​အ​ချိန်​၌​ကိုယ်​တော်​ရှင်​၏​ထံ​တော်​သို့ ချဉ်း​ကပ်​ပါ​၏။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​၏​ဆု​တောင်း​ပတ္ထ​နာ​ကို နား​ညောင်း​တော်​မူ​ပါ။","poem":1},{"text":"ကူ​မ​တော်​မူ​ရန်​ကျွန်​တော်​မျိုး​အော်​ဟစ်​သံ​ကို နား​ထောင်​တော်​မူ​ပါ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ကျွန်​တော်​မျိုး​သည်​ဒုက္ခ​ရောက်​ရ​ဖန်​များ​လှ သ​ဖြင့် သေ​လု​ပါ​ပြီ။","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​သည်​သေ​အံ့​ဆဲ​ဆဲ​ဖြစ်​လျက် နေ​သူ​တစ်​ယောက်​ဖြစ်​ပါ​၏။","poem":1},{"text":"အား​အင်​လည်း​ကုန်​ခန်း​ပါ​ပြီ။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ကျွန်​တော်​မျိုး​သည်​သူ​သေ​ကဲ့​သို့​ဖြစ်​ပါ​၏။","poem":1},{"text":"အ​သတ်​ခံ​ရ​၍​သင်္ချိုင်း​တွင်း​ထဲ​သို့​ရောက်​ရှိ​နေ​သည့် သူ​သေ​ကဲ့​သို့​ဖြစ်​ပါ​၏။","poem":2},{"text":"ကိုယ်​တော်​လုံး​ဝ​သ​တိ​မ​ရ​သော​သူ၊ကိုယ်​တော် မ​စ​ရန် မ​ဖြစ်​နိုင်​သော​သူ​ကဲ့​သို့​ဖြစ်​ပါ​၏။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​အား အ​မှောင်​ဆုံး၊ အ​နက်​ဆုံး​သော​တွင်း​တည်း​ဟူ​သော​နက်​ရှိုင်း​ရာ","poem":1},{"text":"သင်္ချိုင်း​တွင်း​ထဲ​သို့​ပစ်​ချ​တော်​မူ​ပါ​ပြီ။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"အ​မျက်​တော်​သည်​ကျွန်​တော်​မျိုး​အား​ဖိ​လျက် ရှိ​ပါ​၏။","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​အ​မျက်​တော်​၏ လှိုင်း​တံ​ပိုး​အောက်​တွင်​ပိ​ပြား​၍​နေ​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ကျွန်​တော်​မျိုး​အား​မိတ်​ဆွေ​များ​စွန့်​ပစ်​စေ​တော် မူ​ပါ​ပြီ။","poem":1},{"text":"ထို​သူ​တို့​၏​ရှေ့​တွင်​ကျွန်​တော်​မျိုး​အား စက်​ဆုပ်​ရွံ​ရှာ​ဖွယ်​ဖြစ်​စေ​တော်​မူ​ပါ​ပြီ။","poem":2},{"text":"ကျွန်​တော်​မျိုး​သည်​ပိတ်​မိ​နေ​သ​ဖြင့် မ​လွတ်​မြောက်​နိုင်​တော့​ပါ။","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​ခံ​ရ​သော​ဒုက္ခ​ကြောင့်​မျက်​စိ​များ​သည် ပြာ​ဝေ​လျက်​ရှိ​ပါ​၏။","poem":1},{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":2},{"text":"ကျွန်​တော်​မျိုး​သည်​နေ့​စဉ်​နေ့​တိုင်း​ကိုယ်​တော်​ရှင် အား​ခေါ်​ပါ​၏။","poem":1},{"lineBreak":true},{"text":"လက်​အုပ်​ချီ​၍​ကိုယ်​တော်​ထံ​ဆု​တောင်း​ပတ္ထနာ​ပြု​ပါ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ကိုယ်​တော်​ရှင်​သည်​သူ​သေ​တို့​အ​တွက်​ထူး​ဆန်း​သော နိ​မိတ်​လက္ခ​ဏာ​များ​ကို​ပြ​တော်​မူ​ပါ​သ​လော။","poem":1},{"text":"သူ​တို့​သည်​သေ​ရာ​မှ​ထ​၍​ကိုယ်​တော်​ရှင်​အား ထော​မ​နာ​ပြု​ပါ​သ​လော။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ကိုယ်​တော်​ရှင်​၏​ခိုင်​မြဲ​သော​မေတ္တာ​တော် အ​ကြောင်း​ကို သင်္ချိုင်း​တွင်း​၌​လည်း​ကောင်း၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​၏​သစ္စာ​တော်​အ​ကြောင်း​ကို ပျက်​စီး​ရာ​ဌာ​န​၌​လည်း​ကောင်း","poem":2},{"text":"ထုတ်​ဖော်​ပြော​ဆို​ခြင်း​ရှိ​ပါ​သ​လော။","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​ရှင်​၏​ထူး​ဆန်း​သော​နိ​မိတ်​လက္ခ​ဏာ များ​ကို ထို​မှောင်​မိုက်​ရာ​အ​ရပ်​၌​လည်း​ကောင်း၊","poem":1},{"text":"ကိုယ်​တော်​၏​ကောင်း​မြတ်​တော်​မူ​ခြင်း​ကို","poem":2},{"text":"မေ့​လျော့​ရာ​အ​ရပ်​၌​လည်း​ကောင်း​သိ​မြင်​ခြင်း ရှိ​ပါ​သ​လော။","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကူ​မ​တော်​မူ​ရန်​ကိုယ်​တော်​အား​ဟစ်​ခေါ်​ပါ​၏။","poem":2}]},{"type":"verse","number":14,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"အ​ဘယ်​ကြောင့်​ကျွန်​တော်​မျိုး​ထံ​မှ​မျက်​နှာ​တော်​ကို လွှဲ​တော်​မူ​ပါ​သ​နည်း။","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ကျွန်​တော်​မျိုး​သည်​ငယ်​စဉ်​က​တည်း​က​ဝေ​ဒ​နာ ခံ​ရ​လျက်​သေ​လု​နီး​ပါး​ဖြစ်​ခဲ့​ပါ​၏။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​ပေး​တော်​မူ​သော","poem":2},{"text":"အ​ပြစ်​ဒဏ်​ကြီး​လေး​မှု​ကြောင့်​ကျွန်​တော်​မျိုး​သည် မော​ပန်း​နွမ်း​နယ်​ပါ​၏။","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​ရှင်​၏​ပြင်း​ထန်​သော​အ​မျက်​တော်​သည် ကျွန်​တော်​မျိုး​အား​ပြို​လဲ​စေ​ပါ​၏။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​၏​ကြောက်​မက်​ဖွယ်​သော","poem":2},{"text":"တိုက်​ခိုက်​မှု​များ​သည်​ကျွန်​တော်​မျိုး​အား ချေ​မှုန်း​စေ​ပါ​၏။","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ယင်း​တို့​သည်​မြစ်​ရေ​လျှံ​သ​ကဲ့​သို့​တစ်​နေ့​လုံး ကျွန်​တော်​မျိုး​အား​ဝိုင်း​ရံ​လျက်​ရှိ​ပါ​၏။","poem":1},{"text":"အ​ဘက်​ဘက်​မှ​နေ​၍​ကျွန်​တော်​မျိုး​အ​နီး​သို့ ချဉ်း​ကပ်​လာ​ကြ​ပါ​၏။","poem":2}]},{"type":"verse","number":18,"content":[{"text":"အ​ရင်း​နှီး​ဆုံး​သော​မိတ်​ဆွေ​များ​အား​ပင် လျှင် ကျွန်​တော်​မျိုး​ကို​စွန့်​ပစ်​စေ​တော်​မူ​ပါ​ပြီ။","poem":1},{"text":"ကျွန်​တော်​မျိုး​မှာ​မိတ်​ဆွေ​ဖွဲ့​ရန်​မှောင်​မိုက်​သာ​လျှင် ကျန်​ရှိ​ပါ​တော့​၏။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}