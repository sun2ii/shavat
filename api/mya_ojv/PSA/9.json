{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":9,"content":[{"type":"heading","content":["တ​ရား​မျှ​တ​မှု​အ​တွက်​ဘု​ရား​သ​ခင်​၏ ကျေး​ဇူး​တော်​ကို​ချီး​မွမ်း​ခြင်း9:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဒါ​ဝိဒ်​စပ်​ဆို​သော​ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​စိတ်​နှ​လုံး​အ​ကြွင်း​မဲ့ ကိုယ်​တော်​ရှင်​အား​ထော​မ​နာ​ပြု​ပါ​မည်။","poem":2},{"text":"ကိုယ်​တော်​ရှင်​ပြု​တော်​မူ​သော​အံ့​သြ​ဖွယ် အ​မှု​အ​ရာ​များ​ကို​ဖော်​ပြ​ပါ​မည်။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​ရှင်​ကို​အ​မှီ​ပြု​၍​ဝမ်း​မြောက်​ရွှင်​လန်း​စွာ သီ​ချင်း​ဆို​ပါ​မည်။","poem":1},{"text":"အ​နန္တ​တန်​ခိုး​ရှင်​ဘု​ရား​သ​ခင်၊ကျွန်​တော်​မျိုး​သည် ကိုယ်​တော်​ရှင်​အား​ထော​မ​နာ​သီ​ချင်း​ဆို​ပါ​မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ကိုယ်​တော်​ရှင်​ကြွ​လာ​တော်​မူ​သော​အ​ခါ၊","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​ရန်​သူ​များ​သည်​ဆုတ်​ခွာ ထွက်​ပြေး​ကြ​ပါ​၏။","poem":2},{"text":"သူ​တို့​သည်​လဲ​ကျ​သေ​ဆုံး​ကြ​ပါ​၏။","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​ရှင်​သည်​ပလ္လင်​တော်​ပေါ်​တွင်​စံ​တော်​မူ​၍ ဖြောင့်​မှန်​စွာ​တ​ရား​စီ​ရင်​တော်​မူ​၏။","poem":1},{"text":"ကျွန်​တော်​မျိုး​၏​အ​ကျိုး​ကို​ထောက်​လျက် တ​ရား​စီ​ရင်​တော်​မူ​ပါ​ပြီ။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ကိုယ်​တော်​ရှင်​သည်​ဘု​ရား​မဲ့​သူ​တို့​အား အ​ပြစ်​ဒဏ်​စီ​ရင်​တော်​မူ​ပြီ။","poem":1},{"text":"သူ​ယုတ်​မာ​တို့​အား​ဖျက်​ဆီး​ပစ်​တော်​မူ​သ​ဖြင့်","poem":2},{"text":"သူ​တို့​၏​အ​မျိုး​သည်​တိမ်​ကော​သွား​လိမ့်​မည်။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ကျွန်​တော်​မျိုး​တို့​၏​ရန်​သူ​များ​သည်​ထာ​ဝ​စဉ် အ​ရေး​ရှုံး​နိမ့်​ကြ​လေ​ပြီ၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​သူ​တို့​၏​မြို့​ကြီး​များ​ကို ဖြို​ဖျက်​တော်​မူ​သ​ဖြင့်","poem":2},{"text":"ယင်း​တို့​အား​မေ့​လျော့​လျက်​လုံး​ဝ ကွယ်​ပျောက်​သွား​လေ​ပြီ။","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"သို့​ရာ​တွင်​ထာ​ဝ​ရ​ဘု​ရား​မူ​ကား​ထာ​ဝ​ရ ဘု​ရင် ဖြစ်​တော်​မူ​၏။","poem":1},{"lineBreak":true},{"text":"ကိုယ်​တော်​သည်​တ​ရား​စီ​ရင်​ရန်​ပလ္လင်​တော်​ကို တည်​တော်​မူ​လေ​ပြီ။","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"လော​က​ကို​တ​ရား​သ​ဖြင့်​အုပ်​စိုး​တော်​မူ​၍","poem":1},{"text":"လူ​မျိုး​အ​ပေါင်း​တို့​အား​ဖြောင့်​မှန်​စွာ တ​ရား​စီ​ရင်​တော်မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ဖိ​စီး​နှိပ်​စက်​ခြင်း ခံ​ရ​သူ​တို့​၏​ခို​လှုံ​ရာ၊","poem":1},{"text":"ဆင်း​ရဲ​ဒုက္ခ​ရောက်​ချိန်​များ​၌​ဘေး​လွတ်​လုံ​ခြုံ​ရာ ဖြစ်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":10,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊ ကိုယ်​တော်​ရှင်​ကို​သိ​ကျွမ်း​သူ​တို့​သည်","poem":1},{"text":"ကိုယ်​တော်​ရှင်​အား​ယုံ​ကြည်​ကိုး​စား​ကြ​ပါ လိမ့်​မည်။","poem":2},{"text":"ကိုယ်​တော်​ရှင်​သည်​အ​ထံ​တော်​သို့​ချဉ်း​ကပ်​သူ မှန်​သ​မျှ​ကို​စွန့်​ပစ်​တော်​မ​မူ​ပါ။","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ဇိ​အုန်​မြို့​တော်​တွင်​စိုး​စံ​တော်​မူ​သော","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​ကို​ထော​မ​နာ​သီ​ချင်း​ဆို ကြ​လော့။","poem":2},{"text":"ကိုယ်​တော်​ပြု​တော်​မူ​သော​အ​မှု​အ​ရာ​များ​ကို လူ​မျိုး​တ​ကာ​တို့​အား​ဖော်​ပြ​ကြ​လော့။","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ဒုက္ခ​ရောက်​သော​သူ​တို့​ကို သ​တိ​ရ​တော်​မူ​၏။","poem":1},{"text":"သူ​တို့​၏​အော်​ဟစ်​သံ​ကို​မေ့​တော်​မ​မူ။","poem":2},{"text":"သူ​တို့​အား​မ​တ​ရား​ပြု​သော​သူ​တို့​ကို အ​ပြစ်​ဒဏ်​ခတ်​တော်​မူ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊ ကျွန်​တော်​မျိုး​အား​သ​နား​တော်​မူ​ပါ။","poem":1},{"text":"ရန်​သူ​များ​ကြောင့်​ကျွန်​တော်​မျိုး​အ​ဘယ်​မျှ ဆင်း​ရဲ ဒုက္ခ​ခံ​ရ​ကြောင်း​ကို​ရှု​မှတ်​တော်​မူ​ပါ။","poem":2},{"text":"အို ထာ​ဝ​ရ​ဘု​ရား","poem":1},{"text":"ကျွန်​တော်​မျိုး​အား​သေ​ဘေး​မှ​ကယ်​ဆယ်​တော် မူ​ပါ။","poem":2}]},{"type":"verse","number":14,"content":[{"text":"သို့​မှ​သာ​လျှင်​ကျွန်​တော်​မျိုး​သည် ယေ​ရု​ရှ​လင်​မြို့​သား​တို့​၏​ရှေ့​တွင်​ရပ်​လျက်","poem":1},{"text":"ကိုယ်​တော်​၏​ဂုဏ်​ကျေး​ဇူး​တော်​အ​ပေါင်း​ကို ဖော်​ပြ​နိုင်​ပါ​လိမ့်​မည်။","poem":2},{"text":"ကိုယ်​တော်​၏​ကယ်​တင်​ခြင်း​ကျေး​ဇူး​တော် ကြောင့် ကျွန်​တော်​မျိုး​ရွှင်​လန်း​ဝမ်း​မြောက်​ပါ​မည်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ဘု​ရား​မဲ့​သူ​တို့​သည်​မိ​မိ​တို့​တူး​သော​ကျင်း ထဲ​သို့ ပြန်​၍​ကျ​ကြ​လေ​ပြီ။","poem":1},{"text":"မိ​မိ​တို့​ထောင်​ထား​သော​ကျော့​ကွင်း​တွင်း​၌ ပင်​လျှင် ပြန်​၍​မိ​ကြ​လေ​ပြီ။","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ဖြောင့်​မှန်​စွာ","poem":1},{"text":"တ​ရား​စီ​ရင်​တော်​မူ​ခြင်း​အား​ဖြင့်​မိ​မိ​ကိုယ် ကို ပေါ်​လွင်​ထင်​ရှား​စေ​တော်​မူ​ပြီ။","poem":2},{"text":"သူ​ယုတ်​မာ​တို့​သည်​မိ​မိ​တို့​၏​အ​ကျင့်​များ အား​ဖြင့် ပြန်​၍​ကျော့​မိ​ကြ​ကုန်​၏။","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ထာ​ဝ​ရ​ဘု​ရား​ကို​ပစ်​ပယ်​သူ​အ​ပေါင်း​နှင့်","poem":1},{"text":"သူ​ယုတ်​မာ​တို့​သည်​သေ​ခြင်း​တွင် လမ်း​ဆုံး​ရ​ကြ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ချို့​တဲ့​နွမ်း​ပါး​သူ​တို့​ကို","poem":1},{"text":"အ​စဉ်​အ​မြဲ​မေ့​လျော့​တော်​မူ​လိမ့်​မည်​မ​ဟုတ်။","poem":2},{"text":"ဆင်း​ရဲ​သော​သူ​တို့​သည်​လည်း​ထာ​ဝ​စဉ် မျှော်​လင့်​ရာ​မဲ့​ဖြစ်​ရ​ကြ​လိမ့်​မည်​မ​ဟုတ်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊ ကြွ​လာ​တော်​မူ​ပါ။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​အား​လူ​တို့​အာ​ခံ​ရန် ခွင့်​ပြု​တော်​မ​မူ​ပါ​နှင့်။","poem":2},{"text":"ဘု​ရား​မဲ့​သူ​တို့​အား​ရှေ့​တော်​သို့​ခေါ်​ဆောင်​၍ တ​ရား​စီ​ရင်​တော်​မူ​ပါ။","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊ သူ​တို့​အား​ကြောက်​လန့်​စေ​တော်​မူ​ပါ။","poem":1},{"text":"မိ​မိ​တို့​သည်​လူ​မျှ​သာ​ဖြစ်​ကြောင်း​ကို သိ​စေ​တော်​မူ​ပါ။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}