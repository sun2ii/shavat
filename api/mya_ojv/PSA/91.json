{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":91,"content":[{"type":"heading","content":["ငါ​တို့​ကို​ကွယ်​ကာ​သော​ဘု​ရား​သ​ခင်"]},{"type":"verse","number":1,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​ထံ​တော်​သို့​ခို​လှုံ​ရန် ချဉ်း​ကပ်​သူ​သည်​လည်း​ကောင်း၊","poem":1},{"text":"အ​နန္တ​တန်​ခိုး​ရှင်​၏​ကွယ်​ကာ​စောင့်​ထိန်း​မှု​ကို ခံ​ယူ​သူ​သည်​လည်း​ကောင်း၊","poem":2}]},{"type":"verse","number":2,"content":[{"text":"``ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​၏​ကွယ်​ကာ​ရာ၊ ကျွန်​တော်​မျိုး​ခို​လှုံ​ရာ​ရဲ​တိုက်​ဖြစ်​တော်​မူ​ပါ​၏။","poem":1},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​၏​ဘု​ရား ဖြစ်​တော်​မူ​၍​ကျွန်​တော်​မျိုး​သည်","poem":2},{"text":"ကိုယ်​တော်​ရှင်​ကို​ကိုး​စား​ပါ​၏'' ဟူ​၍","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​အား​လျှောက်​ထား​နိုင်​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ကိုယ်​တော်​သည်​မ​မြင်​နိုင်​သော","poem":1},{"text":"ဘေး​ဥ​ပဒ်​များ​မှ​လည်း​ကောင်း၊","poem":2},{"text":"သေ​စေ​တတ်​သော​အ​နာ​ရော​ဂါ​များ​မှ လည်း​ကောင်း သင့်​ကို​ကင်း​လွတ်​စေ​တော်​မူ​လိမ့်​မည်။","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​သည်​မိ​မိ​၏​အ​တောင်​တော်​ဖြင့် သင့်​ကို​ဖုံး​အုပ်​တော်​မူ​လိမ့်​မည်။","poem":1},{"text":"သင်​သည်​ကိုယ်​တော်​၏​ကြည့်​ရှု​စောင့်​ရှောက်​ခြင်း​ကို ခံ​ရ​၍​ဘေး​မဲ့​လုံ​ခြုံ​လျက်​နေ​လိမ့်​မည်။","poem":2},{"text":"ကိုယ်​တော်​၏​သစ္စာ​တော်​သည်​သင့်​ကို​စောင့်​ထိန်း ကွယ်​ကာ​ရာ​ဒိုင်း​လွှား​ဖြစ်​လိမ့်​မည်။","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ညဥ့်​အ​ခါ​တွေ့​ရ​တတ်​သော​ဘေး​ဥ​ပဒ်​များ ကို​သော်​လည်း​ကောင်း၊","poem":1},{"text":"နေ့​အ​ချိန်​ပေါ်​ပေါက်​တတ်​သည့်​အန္တရာယ်​များ ကို​သော်​လည်း​ကောင်း၊","poem":2}]},{"type":"verse","number":6,"content":[{"text":"မှောင်​မိုက်​တွင်​ကျ​ရောက်​တတ်​သည့်​ကပ်​ရော​ဂါ​များ ကို​သော်​လည်း​ကောင်း၊","poem":1},{"text":"နေ့​လည်​ချိန်​၌​သေ​စေ​တတ်​သည့်​ဘေး​ဥ​ပဒ်​များ ကို​သော်​လည်း​ကောင်း၊","poem":2},{"text":"ကြောက်​လန့်​ရ​လိမ့်​မည်​မ​ဟုတ်။","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"သင်​၏​အ​နီး​တွင်​လူ​တစ်​ထောင်၊","poem":1},{"text":"သင်​၏​ပတ်​လည်​တွင်​လူ​တစ်​သောင်း ကျ​ဆုံး​သော်​လည်း​သင်​၌​အ​ထိ​အ​ခိုက် မ​ရှိ​ရ။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"သူ​ယုတ်​မာ​တို့​အ​ဘယ်​သို့​အ​ပြစ်​ဒဏ်​သင့်​ကြ သည်​ကို သင်​သည်​ဒိ​ဌ​မြင်​ရ​လိမ့်​မည်။","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"သင်​သည်​ထာ​ဝ​ရ​ဘု​ရား​အား​သင့်​ကို​ကွယ်​ကာ​သော အ​ရှင်​အ​ဖြစ်​ဖြင့်​လည်း​ကောင်း၊","poem":1},{"text":"အ​မြင့်​မြတ်​ဆုံး​ဖြစ်​တော်​မူ​သော​ဘု​ရား​အား","poem":2},{"text":"သင်​ခို​လှုံ​သော​အ​ရှင်​အ​ဖြစ်​ဖြင့်​လည်း​ကောင်း လက်​ခံ​သည်​ဖြစ်​၍","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"သင်​သည်​ဘေး​ဒုက္ခ​နှင့်​တွေ့​ကြုံ​ရ​လိမ့်​မည်​မ​ဟုတ်၊","poem":1},{"text":"သင်​၏​အိမ်​အ​နီး​သို့​လည်း​အ​ဘယ်​ဘေး​ဥ​ပဒ်​မျှ ချဉ်း​ကပ်​ရ​လိမ့်​မည်​မ​ဟုတ်။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"သွား​လေ​ရာ​ရာ​၌​သင့်​ကို​စောင့်​ရှောက်​စေ​ရန်","poem":1},{"text":"ဘု​ရား​သ​ခင်​သည်​မိ​မိ​၏​ကောင်း​ကင်​တ​မန် များ​ကို တာ​ဝန်​ပေး​အပ်​တော်​မူ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":12,"content":[{"text":"သူ​တို့​သည်​သင်​၏​ခြေ​ကို​ကျောက်​နှင့်","poem":1},{"text":"မ​ထိ​မ​ခိုက်​စေ​ရန်​မိ​မိ​တို့​၏​လက်​ဖြင့်​သင့်​အား ချီ​ပင့်​ကြ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":13,"content":[{"text":"သင်​သည်​ခြင်္သေ့​နှင့်​မြွေ၊ကြောက်​မက်​ဖွယ်​ကောင်း​သည့်","poem":1},{"text":"ခြင်္သေ့​နှင့်​မြွေ​ဆိုး​တို့​ကို​ခြေ​ဖြင့်​နင်း​ရ​လိမ့် မည်။","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ဘု​ရား​သ​ခင်​က","poem":1},{"text":"``ငါ့​ကို​ချစ်​သော​သူ​တို့​အား​ငါ​ကယ်​မည်။","poem":2},{"text":"ငါ​သည်​ထာ​ဝ​ရ​ဘု​ရား​ဖြစ်​တော်​မူ​ကြောင်း ဝန်​ခံ​သော သူ​တို့​အား​ငါ​ကွယ်​ကာ​စောင့်​ရှောက်​မည်။","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"သူ​တို့​သည်​ငါ့​ကို​ခေါ်​သော​အ​ခါ​ငါ​ထူး​မည်။","poem":1},{"text":"သူ​တို့​ဒုက္ခ​ရောက်​သော​အ​ခါ​သူ​တို့​နှင့်​အ​တူ ငါ​ရှိ​မည်။","poem":2},{"text":"ငါ​သည်​သူ​တို့​အား​ကယ်​ဆယ်​၍​ချီး​မြှင့်​မည်။","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"သူ​တို့​အား​အ​သက်​ရှည်​စေ​၍​ကယ်​တင်​ခြင်း ကျေး​ဇူး​ကို​ခံ​စား​စေ​မည်'' ဟု​မိန့်​တော်​မူ​၏။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}