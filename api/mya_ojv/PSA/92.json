{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":92,"content":[{"type":"heading","content":["ထော​မ​နာ​သီ​ချင်း92:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဥ​ပုသ်​နေ့​အ​တွက်​သီ​ချင်း။"]},{"type":"verse","number":1,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​၏​ကျေး​ဇူး​တော်​ကို ချီး​မွမ်း​ရ​ခြင်း​သည်​လည်း​ကောင်း၊","poem":2},{"text":"အ​မြင့်​မြတ်​ဆုံး​ဖြစ်​တော်​မူ​သော​ဘု​ရား​သ​ခင်၊","poem":1},{"lineBreak":true},{"text":"ကိုယ်​တော်​ရှင်​၏​ဂုဏ်​တော်​ကို​ထော​မ​နာ သီ​ချင်း ကူး​အေး​ရ​ခြင်း​သည်​လည်း​ကောင်း၊","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ချို​သာ​နာ​ပျော်​ဖွယ်​သော​စောင်း​သံ​နှင့်​တ​ကွ ကြိုး​တပ်​တူ​ရိ​ယာ​သံ​တို့​ဖြင့်","poem":1},{"text":"နံ​နက်​တိုင်း​ကိုယ်​တော်​ရှင်​၏​ခိုင်​မြဲ​သော မေတ္တာ​တော်​ကို​ဖော်​ကူး​၍","poem":2},{"text":"ညဥ့်​တိုင်း​ကိုယ်​တော်​ရှင်​၏​သစ္စာ​တော်​ကို","poem":1},{"text":"ထုတ်​ဖော်​ကြေ​ညာ​ရ​ခြင်း​သည်​လည်း​ကောင်း လျောက်​ပတ်​လှ​ပါ​၏။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊ ကိုယ်​တော်​ရှင်​၏​အံ့​သြ​ဖွယ်​ကောင်း​သော","poem":1},{"text":"အ​မှု​တော်​များ​သည်​ကျွန်​တော်​မျိုး​အား ဝမ်း​မြောက်​ရွှင်​လန်း​စေ​ပါ​၏။","poem":2},{"text":"ကိုယ်​တော်​ရှင်​ပြု​တော်​မူ​သော​အ​မှု​တော်​များ​ကြောင့်","poem":1},{"text":"ကျွန်​တော်​မျိုး​သည်​ဝမ်း​မြောက်​စွာ​သီ​ချင်း​ဆို​ပါ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​ပြု​တော်​မူ​သော​အ​မှု​တော်​တို့​သည် ကြီး​မြတ်​လှ​ပါ​၏။","poem":2},{"text":"ကိုယ်​တော်​ရှင်​၏​အ​ကြံ​အ​စည်​တော်​သည်​လည်း နက်​နဲ​လှ​ပါ​၏။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"လူ​မိုက်​တို့​မ​သိ​နိုင်​သော​အ​ရာ၊အ​သိ​ဉာဏ်​တုံး သူ​တို့ နား​မ​လည်​နိုင်​သော​အ​ရာ​တစ်​ခု​ရှိ​ပါ​၏။","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ထို​အ​ရာ​ကား၊သူ​ယုတ်​မာ​တို့​သည်​ပေါင်း​ပင်​များ သ​ဖွယ် ကြီး​ပွား​တိုး​တက်​၍","poem":1},{"text":"မ​ကောင်း​မှု​ပြု​သူ​တို့​သည်​ကောင်း​စား​ကြ​သော်​လည်း","poem":2},{"text":"ထို​သူ​တို့​သည်​လုံး​ဝ​သုတ်​သင်​ပယ်​ရှင်း​ခြင်း​ကို ခံ​ကြ​ရ​မည်​ဖြစ်​၏။","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"အ​ဘယ်​ကြောင့်​ဆို​သော်​ထာ​ဝ​ရ​ဘု​ရား ဖြစ်​တော်​မူ​သော​ကိုယ်​တော်​ရှင်​သည်","poem":1},{"text":"ထာ​ဝ​စဉ်​အ​ချုပ်​အ​ခြာ​အာ​ဏာ​ပိုင် ဖြစ်​တော်​မူ​သော​ကြောင့်​တည်း။","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ကိုယ်​တော်​ရှင်​၏​ရန်​သူ​တို့​သည်​သေ​ကြေ​ပျက်​စီး ရ​ကြ​မည်​ကို​လည်း​ကောင်း၊","poem":1},{"text":"သူ​ယုတ်​မာ​အ​ပေါင်း​တို့​သည်","poem":2},{"text":"အ​ရေး​ရှုံး​နိမ့်​ရ​ကြ​မည်​ကို​လည်း​ကောင်း ကျွန်​တော်​မျိုး​တို့​သိ​ပါ​၏။","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​ရှင်​သည်​ကျွန်​တော်​မျိုး​အား နွား​လား​ရိုင်း​ကဲ့​သို့​သန်​စွမ်း​စေ​တော်​မူ​ပါ​ပြီ။","poem":1},{"text":"ကျွန်​တော်​မျိုး​အား​ရွှင်​လန်း​ဝမ်း​မြောက်​ရ​ခြင်း ကောင်း​ချီး​မင်္ဂလာ​ကို​ပေး​တော်​မူ​ပါ​ပြီ။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ရန်​သူ​တို့​အ​ရေး​ရှုံး​နိမ့်​ကြ​သည်​ကို​ကျွန်​တော်​မျိုး မြင်​ရ​ပါ​ပြီ။","poem":1},{"text":"သူ​ယုတ်​မာ​တို့​ငို​ကြွေး​သံ​ကို​ကြား​ရ​ပါ​ပြီ။","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"သူ​တော်​ကောင်း​တို့​သည်​စွန်​ပ​လွံ​ပင်​များ​ကဲ့​သို့ စိမ်း​လန်း​စို​ပြေ​လျက်​ရှိ​လိမ့်​မည်။","poem":1},{"text":"သူ​တို့​သည်​လေ​ဗ​နုန်​တောင်​မှ​အာ​ရဇ်​ပင်​များ ကဲ့​သို့ ကြီး​ပွား​တိုး​တက်​ကြ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":13,"content":[{"text":"သူ​တို့​သည်​ထာ​ဝ​ရ​ဘု​ရား​၏​အိမ်​တော်​တွင်​စိုက်​ပျိုး​၍","poem":1},{"text":"ငါ​တို့​ဘု​ရား​သ​ခင်​၏​ဗိ​မာန်​တော်​တွင်​စိမ်း​လန်း စို​ပြေ​လျက်​နေ​သည့်​သစ်​ပင်​များ​နှင့်​တူ​ကြ​၏။","poem":2},{"text":"ထို​သစ်​ပင်​တို့​သည်​အ​သက်​အို​ချိန်​၌​ပင်​လျှင်","poem":1},{"text":"အ​သီး​များ​သီး​၍​အ​စဉ်​အ​မြဲ​စိမ်း​လန်း သန်​မာ​လျက်​ရှိ​ကြ​၏။","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ဤ​ကား​ထာ​ဝ​ရ​ဘု​ရား​သည်​တ​ရား","poem":1},{"text":"မျှ​တ​တော်​မူ​ကြောင်း​ကို​လည်း​ကောင်း","poem":2},{"text":"ငါ့​ကို​ကွယ်​ကာ​သော​အ​ရှင်​သည်​ကောင်း​မြတ်","poem":1},{"text":"စုံ​လင်​တော်​မူ​ကြောင်း​ကို​လည်း​ကောင်း ဖော်​ပြ​လိုက်​ခြင်း​ဖြစ်​သည်။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":13}