{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":95,"content":[{"type":"heading","content":["ထော​မ​နာ​သီ​ချင်း"]},{"type":"verse","number":1,"content":[{"text":"လာ​ကြ၊ထာ​ဝ​ရ​ဘု​ရား​အား​ထော​မ​နာ​ပြု ကြ​ကုန်​အံ့။","poem":1},{"text":"ငါ​တို့​ခို​လှုံ​ရာ​ဘု​ရား​သ​ခင်​၏​ဂုဏ်​တော်​ကို ဝမ်း​မြောက်​စွာ​သီ​ချင်း​ဆို​ကြ​ကုန်​အံ့။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ကျေး​ဇူး​တော်​ကို​ချီး​မွမ်း​လျက်​ရှေ့​တော်​သို့ ဝင်​ကြ​ကုန်​အံ့။","poem":1},{"text":"ဝမ်း​မြောက်​စွာ​ထော​မ​နာ​သီ​ချင်း​များ​ကို ဆို​ကြ​ကုန်​အံ့။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"အ​ဘယ်​ကြောင့်​ဆို​သော်​ထာ​ဝ​ရ​ဘု​ရား​သည် တန်​ခိုး​ကြီး​တော်​မူ​သော​ဘု​ရား၊","poem":1},{"text":"ဘု​ရား​တ​ကာ​တို့​ထက်​တန်​ခိုး​ကြီး​သည့်​ဘု​ရင် ဖြစ်​တော်​မူ​သော​ကြောင့်​ဖြစ်​၏။","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ကိုယ်​တော်​သည်​အ​နက်​ဆုံး​သော​မြေ​ကြီး နက်​ရှိုင်း​ရာ​များ​မှ","poem":1},{"text":"အ​မြင့်​ဆုံး​သော​တောင်​ထိပ်​များ​တိုင်​အောင် ကမ္ဘာ​လော​က​တစ်​ခု​လုံး​ကို​အ​စိုး​ရ​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ကိုယ်​တော်​သည်​မိ​မိ​ဖန်​ဆင်း​တော်​မူ​သော ပင်​လယ်​ကို​လည်း​ကောင်း၊","poem":1},{"text":"မိ​မိ​လက်​တော်​ဖြင့်​ပြု​ပြင်​တော်​မူ​သည့်​ကုန်း​မြေ ကို​လည်း​ကောင်း​အ​စိုး​ရ​တော်​မူ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"လာ​ကြ၊ကိုယ်​တော်​အား​ဦး​ညွှတ်​ပျပ်​ဝပ်​၍ ရှိ​ခိုး​ကြ​ကုန်​အံ့။","poem":1},{"text":"ငါ​တို့​အား​ဖန်​ဆင်း​တော်​မူ​သော​ထာ​ဝ​ရ ဘု​ရား​၏ ရှေ့​တော်​တွင်​ဒူး​ထောက်​ကြ​ကုန်​အံ့။","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ကိုယ်​တော်​သည်​ငါ​တို့​၏​ဘု​ရား​ဖြစ်​တော်​မူ​၏။ ငါ​တို့​သည်​ကိုယ်​တော်","poem":1},{"text":"စောင့်​ရှောက်​တော်​မူ​သော​သူ​များ၊ကိုယ်​တော် ကျွေး​မွေး​တော်​မူ​သော​သိုး​စု​ဖြစ်​ကြ​၏။","poem":2},{"lineBreak":true},{"text":"ကိုယ်​တော်​မိန့်​တော်​မူ​သော​စ​ကား​ကို ယ​နေ့​နား​ထောင်​ကြ​လော့။","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​က​မော​ရိ​ဘ​အ​ရပ်​တွင်​ရောက်​ရှိ နေ​သော","poem":1},{"text":"သင်​တို့​ဘိုး​ဘေး​များ​ကဲ့​သို့​သင်​တို့​သည် ခေါင်း​မ​မာ​ကြ​နှင့်။","poem":2},{"text":"တော​ကန္တာ​ရ​ရှိ​မဿာ​အ​ရပ်​တွင်​ရောက်​ရှိ​နေ​သော ဘိုး​ဘေး​များ​ကဲ့​သို့​ခေါင်း​မ​မာ​ကြ​နှင့်။","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ထို​သူ​တို့​သည်​မိ​မိ​တို့​၏​အ​တွက်​ငါ​ပြု​သည့်","poem":1},{"text":"အ​မှု​ကို​တွေ့​မြင်​ကြ​ပြီး​ဖြစ်​သော်​လည်း ထို​အ​ရပ်​တွင်​ငါ့​ကို​သွေး​စမ်း​ကြ​၏။","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ငါ​သည်​အ​နှစ်​လေး​ဆယ်​တိုင်​တိုင်​ထို​သူ​တို့​အား အ​မျက်​ထွက်​ခဲ့​၏။","poem":1},{"text":"``သူ​တို့​သည်​လွန်​စွာ​သစ္စာ​ဖောက်​သူ​များ​ပါ တ​ကား။","poem":2},{"text":"ငါ​၏​ပ​ညတ်​တို့​ကို​လိုက်​နာ​ရန်​ငြင်း​ဆန်​သူ​များ ပါ​တ​ကား'' ဟု​ငါ​ဆို​၏။","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ငါ​သည်​သူ​တို့​အား​အ​မျက်​ထွက်​သ​ဖြင့်``သင်​တို့ စိတ်​အေး​ချမ်း​သာ​စွာ​နေ​ထိုင်​ရ​မည့်​ပြည်​ကို","poem":1},{"text":"သင်​တို့​သည်​အ​ဘယ်​အ​ခါ​၌​မျှ​မ​ဝင်​ရ​ကြ'' ဟု​ကျိန်​ဆို​၏။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}