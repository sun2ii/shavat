{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":96,"content":[{"type":"heading","content":["ဘု​ရင်​တ​ကာ​တို့​၏​ဘု​ရင်​ဖြစ်​တော်​မူ​သော ဘု​ရား​သ​ခင်"]},{"type":"verse","number":1,"content":[{"text":"သီ​ချင်း​သစ်​ကို​ဆို​၍​ထာ​ဝ​ရ​ဘု​ရား​၏ ဂုဏ်​တော်​ကို​ချီး​ကူး​ကြ​လော့။","poem":1},{"text":"ကမ္ဘာ​သူ​ကမ္ဘာ​သား​အ​ပေါင်း​တို့၊သီ​ချင်း​ဆို​၍ ထာ​ဝ​ရ​ဘု​ရား​၏​ဂုဏ်​တော်​ကို​ချီး​မွမ်း ကြ​လော့။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"သီ​ချင်း​ဆို​၍​ထာ​ဝ​ရ​ဘု​ရား​၏​ဂုဏ်​တော်​ကို ချီး​မွမ်း​ကြ​လော့။","poem":1},{"text":"ကိုယ်​တော်​အား​ထော​မ​နာ​ပြု​ကြ​လော့။","poem":2},{"text":"ကိုယ်​တော်​သည်​ငါ​တို့​အား","poem":1},{"text":"ကယ်​တော်​မူ​ကြောင်း​သ​တင်း​ကောင်း​ကို နေ့​စဉ်​နေ့​တိုင်း​ပြော​ကြား​ကြ​လော့။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"လူ​မျိုး​တ​ကာ​တို့​အား​ကိုယ်​တော်​၏ ဘုန်း​အ​သ​ရေ​တော်​ကို​လည်း​ကောင်း၊","poem":1},{"text":"လူ​အ​ပေါင်း​တို့​အား​ကိုယ်​တော်​၏","poem":2},{"text":"အံ့​သြ​ဖွယ်​ကောင်း​သော​အ​မှု​တော်​တို့​ကို လည်း​ကောင်း ထုတ်​ဖော်​ကြေ​ညာ​ကြ​လော့။","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ကြီး​မြတ်​တော်​မူ​သည် ဖြစ်​၍ အ​လွန်​ပင်​ထော​မ​နာ​ပြု​ခြင်း​ကို​ခံ​ထိုက်​တော် မူ​၏။","poem":1},{"text":"ကိုယ်​တော်​သည်​ဘု​ရား​တ​ကာ​တို့​ထက် ကြောက်​ရွံ့​ရို​သေ​ခြင်း​ကို​ခံ​ထိုက်​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"အ​ခြား​လူ​မျိုး​အ​ပေါင်း​တို့​၏​ဘု​ရား​များ​သည် ရုပ်​တု​များ​သာ​ဖြစ်​ကြ​၏။","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​မူ​ကား​မိုး​ကောင်း​ကင်​ကို ဖန်​ဆင်း​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ဘုန်း​တော်​နှင့်​ဂုဏ်​တော်​သည်​ကိုယ်​တော်​ကို ခြံ​ရံ​လျက်​ရှိ​၏။","poem":1},{"text":"တန်​ခိုး​တော်​နှင့်​ဂုဏ်​ကြက်​သ​ရေ​တော်​သည် ဗိ​မာန်​တော်​၌​တည်​လျက်​ရှိ​၏။","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ကမ္ဘာ​မြေ​ပေါ်​ရှိ​လူ​အ​ပေါင်း​တို့၊ထာ​ဝ​ရ ဘု​ရား​ကို ထော​မ​နာ​ပြု​ကြ​လော့။","poem":1},{"text":"ကိုယ်​တော်​၏​ဘုန်း​အ​သ​ရေ​တော်​နှင့်​တန်​ခိုး အာ​နု​ဘော်​တော်​ကို​ထော​မ​နာ​ပြု​ကြ​လော့။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​၏​ဘုန်း​ကြီး​သော​နာ​မ​တော်​ကို ထော​မ​နာ​ပြု​ကြ​လော့။","poem":1},{"text":"ပူ​ဇော်​သ​ကာ​ကို​ယူ​ဆောင်​၍​ကိုယ်​တော်​၏ ဗိ​မာန်​တော်​ထဲ​သို့​ဝင်​ကြ​လော့။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"သန့်​ရှင်း​မြင့်​မြတ်​တော်​မူ​သော​အ​ရှင်​ကြွ​လာ တော်​မူ​သော​အ​ခါ​ဦး​ညွှတ်​ပျပ်​ဝပ်​ကြ​လော့။","poem":1},{"text":"ကမ္ဘာ​မြေ​ကြီး​သား​အ​ပေါင်း​တို့၊ကိုယ်​တော်​၏ ရှေ့​တော်​၌​ကြောက်​လန့်​တုန်​လှုပ်​ကြ​လော့။","poem":2}]},{"type":"verse","number":10,"content":[{"text":"``ထာ​ဝ​ရ​ဘု​ရား​သည်​ရှင်​ဘု​ရင်​ဖြစ်​တော်​မူ​၏။","poem":1},{"text":"ကိုယ်​တော်​သည်​ကမ္ဘာ​မြေ​ကြီး​ကို​ခိုင်​မြဲ​စွာ တည်​စေ​တော်​မူ​သည်​ဖြစ်​၍​လှုပ်​ရှား​၍​မ​ရ နိုင်​ရာ။","poem":2},{"text":"ကိုယ်​တော်​သည်​လူ​အ​ပေါင်း​တို့​ကို​ဖြောင့်​မှန်​စွာ တ​ရား​စီ​ရင်​တော်​မူ​လိမ့်​မည်'' ဟူ​၍","poem":1},{"text":"လူ​မျိုး​တ​ကာ​တို့​အား​ပြော​ကြား​ကြ​လော့။","poem":2}]},{"type":"verse","number":11,"content":[{"text":"အ​ချင်း​ကုန်း​မြေ​နှင့်​ကောင်း​ကင်​တို့၊ရွှင်​လန်း ဝမ်း​မြောက်​ကြ​လော့။","poem":1},{"text":"အ​ချင်း​ပင်​လယ်​နှင့်​ပင်​လယ်​ထဲ​ရှိ","poem":2},{"text":"သတ္တဝါ​အ​ပေါင်း​တို့၊အ​သံ​ကျယ်​စွာ ကြွေး​ကြော်​ကြ​လော့။","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"အ​ချင်း​လယ်​ပြင်​နှင့်​လယ်​ပြင်​တွင်​ရှိ​သ​မျှ သော အ​ရာ​တို့၊ရွှင်​လန်း​ဝမ်း​မြောက်​ကြ​လော့။","poem":1},{"text":"တော​၌​ရှိ​သော​သစ်​ပင်​တို့​သည်​ရွှင်​လန်း ဝမ်း​မြောက်​စွာ​ကြွေး​ကြော်​ကြ​လိမ့်​မည်။","poem":2}]},{"type":"verse","number":13,"content":[{"text":"အ​ဘယ်​ကြောင့်​ဆို​သော်​ကိုယ်​တော်​သည် ကမ္ဘာ​မြေ​ကြီး​ကို​အုပ်​စိုး​ရန်","poem":1},{"text":"ကြွ​လာ​တော်​မူ​ပြီ​ဖြစ်​သော​ကြောင့်​တည်း။","poem":2},{"text":"ကိုယ်​တော်​သည်​ကမ္ဘာ​သူ​ကမ္ဘာ​သား​တို့​အား တ​ရား​မျှ​တ​စွာ​အုပ်​စိုး​တော်​မူ​လိမ့်​မည်။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}