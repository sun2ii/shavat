{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":97,"content":[{"type":"heading","content":["တန်​ခိုး​အ​ကြီး​ဆုံး​ဘု​ရင်​ဖြစ်​တော်​မူ​သော ဘု​ရား​သ​ခင်"]},{"type":"verse","number":1,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​ဘု​ရင်​ဖြစ်​တော်​မူ​၏။","poem":1},{"text":"အ​ချင်း​ကမ္ဘာ​မြေ​ကြီး၊ရွှင်​လန်း​ဝမ်း​မြောက်​လော့။","poem":2},{"text":"ပင်​လယ်​များ​တွင်​ရှိ​သည့်​ကျွန်း​အ​ပေါင်း​တို့၊ ဝမ်း​မြောက်​ရွှင်​မြူး​ကြ​လော့။","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"မိုး​တိမ်​များ​နှင့်​မှောင်​မိုက်​တို့​သည်​ကိုယ်​တော်​ကို ဝိုင်း​ရံ​လျက်​ရှိ​၏။","poem":1},{"text":"ကိုယ်​တော်​၏​အုပ်​စိုး​ခြင်း​သည်​အ​မှန်​တ​ရား​နှင့် တ​ရား​မျှ​တ​မှု​အ​ပေါ်​တွင်​အ​ခြေ​ခံ​၏။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"မီး​လျှံ​သည်​ရှေ့​တော်​မှ​သွား​၍​ကိုယ်​တော်​၏ ပတ်​လည်​ရှိ​ရန်​သူ​တို့​ကို​ကျွမ်း​လောင်​စေ​၏။","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ကိုယ်​တော်​၏​လျှပ်​စစ်​လျှပ်​နွယ်​တို့​သည် ကမ္ဘာ​လော​က​ကို​လင်း​စေ​ကြ​၏။","poem":1},{"text":"ထို​အ​ချင်း​အ​ရာ​ကို​မြင်​သော​အ​ခါ ကမ္ဘာ​မြေ​ကြီး​သည်​တုန်​လှုပ်​လေ​၏။","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ကမ္ဘာ​မြေ​ကြီး​ကို​အ​စိုး​ရ​သော","poem":1},{"text":"အ​ရှင်​တည်း​ဟူ​သော​ထာ​ဝ​ရ​ဘု​ရား ၏​ရှေ့","poem":2},{"text":"တော်​၌​တောင်​တို့​သည်​ဖ​ယောင်း​ကဲ့​သို့ အ​ရည်​ပျော်​ကြ​ကုန်​၏။","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"မိုး​ကောင်း​ကင်​သည်​ကိုယ်​တော်","poem":1},{"text":"ဖြောင့်​မှန်​တော်​မူ​ကြောင်း​ကို​ထုတ်​ဖော်​ကြေ ညာ​၍","poem":2},{"text":"လူ​အ​ပေါင်း​တို့​သည်​ကိုယ်​တော်​၏​ဘုန်း အ​သ​ရေ​တော်​ကို​မြင်​ကြ​ရ​၏။","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ရုပ်​တု​များ​ကို​ရှိ​ခိုး​ဝတ်​ပြု​သူ​အ​ပေါင်း​တို့​သည် အ​ရှက်​ရ​ကြ​၏။","poem":1},{"text":"ဘု​ရား​ရှိ​သ​မျှ​တို့​သည်​လည်း​ကိုယ်​တော်​၏ ရှေ့​တော်​၌​ဦး​ညွှတ်​ပျပ်​ဝပ်​ကြ​၏။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"အို ထာ​ဝ​ရ​ဘု​ရား၊","poem":1},{"text":"ကိုယ်​တော်​ရှင်​၏​တ​ရား​စီ​ရင်​တော်​မူ​ချက် များ​ကြောင့်","poem":2},{"text":"ဇိ​အုန်​မြို့​သူ​မြို့​သား​တို့​သည်​ရွှင်​လန်း ဝမ်း​မြောက်​ကြ​ပါ​၏။","poem":1},{"text":"ယု​ဒ​မြို့​တို့​သည်​လည်း​အား​ရ​ရွှင်​မြူး​ကြ​ပါ​၏။","poem":2}]},{"type":"verse","number":9,"content":[{"text":"အ​နန္တ​တန်​ခိုး​ရှင်​ထာ​ဝ​ရ​ဘု​ရား၊ကိုယ်​တော် ရှင်​သည်","poem":1},{"text":"ကမ္ဘာ​မြေ​တစ်​ပြင်​လုံး​ကို​အ​စိုး​ရ​တော်​မူ​သော အ​ရှင်​ဖြစ်​တော်​မူ​ပါ​၏။","poem":2},{"text":"ဘု​ရား​ရှိ​သ​မျှ​တို့​ထက်​အ​လွန်​ကြီး​မြတ်​တော် မူ​ပါ​၏။","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​မ​ကောင်း​မှု​ကို မုန်း​သော​သူ​တို့​အား​ချစ်​တော်​မူ​၏။","poem":1},{"text":"မိ​မိ​လူ​စု​တော်​၏​စည်း​စိမ်​ကို​ကာ​ကွယ် စောင့်​ရှောက်​တော်​မူ​၏။","poem":2},{"text":"ကိုယ်​တော်​သည်​သူ​တို့​အား​သူ​ယုတ်​မာ​တို့ ၏​လက်​မှ ကယ်​ဆယ်​တော်​မူ​၏။","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"သူ​တော်​ကောင်း​တို့​အ​ပေါ်​သို့​ရွှင်​လန်း ဝမ်း​မြောက်​ခြင်း​သည်​လည်း​ကောင်း၊","poem":1},{"text":"သ​ဘော​ဖြောင့်​သူ​တို့​အ​ပေါ်​သို့","poem":2},{"text":"ရွှင်​လန်း​ဝမ်း​မြောက်​ခြင်း​သည်​လည်း​ကောင်း သက်​ရောက်​၏။","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"အို သူ​တော်​ကောင်း​အ​ပေါင်း​တို့၊","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​ပြု​တော်​မူ​သော​အ​မှု​တော် ကြောင့် ရွှင်​လန်း​ဝမ်း​မြောက်​ကြ​လော့။","poem":2},{"text":"သန့်​ရှင်း​မြင့်​မြတ်​တော်​မူ​သော​ဘု​ရား ပြု​တော်​မူ​ခဲ့​သည့် အ​မှု​တော်​ကို​အောက်​မေ့​သ​တိ​ရ​လျက်","poem":1},{"text":"ကျေး​ဇူး​တော်​ကို​ချီး​မွမ်း​ကြ​လော့။","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}