{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"PSA","translationId":"mya_ojv","name":"ဆာ​လံ","commonName":"ဆာ​လံ","title":"ဆာ​လံ​ကျမ်း","order":19,"numberOfChapters":150,"sha256":"c2f0ab24f3e56c2ee9d5fa5ae119eee39426c3521377ea6f371c84f1136c813b","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/mya_ojv/PSA/150.json","totalNumberOfVerses":2401},"chapter":{"number":98,"content":[{"type":"heading","content":["ကမ္ဘာ​လော​က​ကို​အ​စိုး​ရ​တော်​မူ​သော ဘု​ရား​သ​ခင်98:0 * ဟေ​ဗြဲ​ခေါင်း​စဉ်။ ဆာ​လံ။"]},{"type":"verse","number":1,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​အား​သီ​ချင်း​သစ်​ကို​ဆို​၍ ဂုဏ်​တော်​ကို​ချီး​မွမ်း​ကြ​လော့။","poem":1},{"text":"ကိုယ်​တော်​သည်​အံ့​သြ​ဖွယ်​ရာ​အ​မှု​တော်​တို့​ကို ပြု​တော်​မူ​ပြီ။","poem":2},{"text":"ကိုယ်​တော်​သည်​မိ​မိ​၏​တန်​ခိုး​တော်​ဖြင့် လည်း​ကောင်း၊","poem":1},{"text":"ခွန်​အား​စွမ်း​ရည်​တော်​ဖြင့်​လည်း​ကောင်း အောင်​ပွဲ​ကို​ရ​တော်​မူ​ပြီ။","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ထာ​ဝ​ရ​ဘု​ရား​သည်​မိ​မိ​၏​အောင်​ပွဲ​ကို ကြေ​ညာ​တော်​မူ​၍","poem":1},{"text":"ကယ်​တင်​နိုင်​သော​တန်​ခိုး​တော်​ကို လူ​မျိုး​တ​ကာ​တို့​အား​ဖော်​ပြ​တော်​မူ​၏။","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ကိုယ်​တော်​သည်​မိ​မိ​၏​ခိုင်​မြဲ​သော​မေတ္တာ​တော်​နှင့် သစ္စာ​တော်​နှင့်​အ​ညီ","poem":1},{"text":"ဣ​သ​ရေ​လ​အ​မျိုး​သား​တို့​အား​ထား​တော်​မူ​သော က​တိ​တော်​ကို​တည်​စေ​တော်​မူ​၏။","poem":2},{"text":"အ​ရပ်​တ​ကာ​ရှိ​လူ​အ​ပေါင်း​တို့​သည်​ငါ​တို့ ဘု​ရား​၏ အောင်​ပွဲ​ကို​တွေ့​မြင်​ကြ​ရ​လေ​ပြီ။","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ကမ္ဘာ​မြေ​ကြီး​သား​အ​ပေါင်း​တို့၊ဝမ်း​မြောက်​စွာ သီ​ချင်း​ဆို​၍","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​၏​ဂုဏ်​တော်​ကို​ချီး​မွမ်း​ကြ​လော့။","poem":2},{"text":"သီ​ချင်း​များ​ကို​ဆို​၍​ဝမ်း​မြောက်​စွာ​ကြွေး ကြော်​လျက် ကိုယ်​တော်​အား​ထော​မ​နာ​ပြု​ကြ​လော့။","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ထော​မ​နာ​သီ​ချင်း​ကို​ဆို​ကာ​ထာ​ဝ​ရ​ဘု​ရား​၏ ဂုဏ်​တော်​ကို​ချီး​မွမ်း​ကြ​လော့။","poem":1},{"text":"စောင်း​များ​ကို​တီး​၍​ဂုဏ်​တော်​ကို​ချီး​မွမ်း​ကြ​လော့။","poem":2}]},{"type":"verse","number":6,"content":[{"text":"တံ​ပိုး​ခ​ရာ​နှင့်​နှဲ​တို့​ကို​မှုတ်​၍​ငါ​တို့​ဘု​ရင်","poem":1},{"text":"ထာ​ဝ​ရ​ဘု​ရား​၏​ရှေ့​တော်​၌​ဝမ်း​မြောက်​စွာ ကြွေး​ကြော်​ကြ​လော့။","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"အ​ချင်း​ပင်​လယ်​နှင့်​ပင်​လယ်​ရှိ​သတ္တ​ဝါ​အ​ပေါင်း တို့၊ အ​သံ​ကျယ်​စွာ​ကြွေး​ကြော်​ကြ​လော့။","poem":1},{"text":"အ​ချင်း​ကုန်း​မြေ​နှင့်​ကုန်း​မြေ​ပေါ်​တွင် အ​သက်​ရှင်​သူ​အ​ပေါင်း​တို့​သီ​ချင်း​ဆို​ကြ လော့။","poem":2}]},{"type":"verse","number":8,"content":[{"text":"အ​ချင်း​မြစ်​တို့၊လက်​ခုပ်​တီး​ကြ​လော့။","poem":1},{"text":"အ​ချင်း​တောင်​များ​တို့၊ထာ​ဝ​ရ​ဘု​ရား​သည်","poem":2},{"text":"ကမ္ဘာ​လော​က​ကို​အုပ်​စိုး​ရန်​ကြွ​လာ​တော်​မူ ပြီ​ဖြစ်​၍","poem":1},{"text":"တစ်​ပြိုင်​နက်​ရှေ့​တော်​တွင်​ရွှင်​လန်း​ဝမ်း​မြောက်​စွာ သီ​ချင်း​ဆို​ကြ​လော့။","poem":2},{"text":"ကိုယ်​တော်​သည်​ကမ္ဘာ​ပေါ်​ရှိ​လူ​အ​ပေါင်း​တို့​အား တ​ရား​မျှ​တ​စွာ​အုပ်​စိုး​တော်​မူ​လိမ့်​မည်။","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":8}