{"translation":{"id":"mya_ojv","name":"Common Language Bible","website":"https://ebible.org/Scriptures/details.php?id=mya","licenseUrl":"https://ebible.org/Scriptures/details.php?id=mya","licenseNotes":null,"shortName":"OJV","englishName":"Burmese Common Language Bible","language":"mya","textDirection":"ltr","sha256":"1ab5e08a90694e1d0bb40e84208c64fafd8353684620cfbf45f2e1b0881bd89a","availableFormats":["json"],"listOfBooksApiLink":"/api/mya_ojv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29794,"languageName":"မြန်မာ","languageEnglishName":"Burmese"},"book":{"id":"REV","translationId":"mya_ojv","name":"ဗျာ​ဒိတ်","commonName":"ဗျာ​ဒိတ်","title":"ဗျာ​ဒိတ်​ကျမ်း","order":66,"numberOfChapters":22,"sha256":"2499b4f17b8f508734c1041e5e8b633cbcfdda9fd534bd6f8e0437e26932755e","firstChapterNumber":1,"firstChapterApiLink":"/api/mya_ojv/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/mya_ojv/REV/22.json","totalNumberOfVerses":400},"chapter":{"number":10,"content":[{"type":"heading","content":["စာ​စောင်​ငယ်​ကိုင်​ထား​သော​ကောင်း​ကင်​တ​မန်"]},{"type":"verse","number":1,"content":["ထို​နောက်​ကောင်း​ကင်​မှ​ခွန်​အား​ကြီး​မား​သော ကောင်း​ကင်​တ​မန်​တစ်​ပါး​ဆင်း​သက်​လာ​သည် ကို​ငါ​မြင်​ရ​၏။ သူ​သည်​မိုး​တိမ်​ကို​ဝတ်​ဆင် ၍​သူ​၏​ဦး​ခေါင်း​ပတ်​လည်​တွင်​သက်​တန့်​ရှိ​၏။ သူ​၏​မျက်​နှာ​သည်​နေ​နှင့်​တူ​၏။ သူ​၏​ခြေ ထောက်​တို့​သည်​မီး​ဖြင့်​ပြီး​သော​တိုင်​များ နှင့်​တူ​၏။-"]},{"type":"verse","number":2,"content":["သူ​သည်​ဖွင့်​ထား​သော​စာ​စောင်​ငယ်​ကို​ကိုင် ထား​၏။ လက်ယာ​ခြေ​ဖြင့်​ပင်​လယ်​ပေါ်​၌​လည်း ကောင်း၊ လက်​ဝဲ​ခြေ​ဖြင့်​ကုန်း​မြေ​ပေါ်​၌​လည်း ကောင်း​ရပ်​လျက်၊-"]},{"type":"verse","number":3,"content":["ခြင်္သေ့​ဟောက်​သ​ကဲ့​သို့​ကျယ်​သော​အ​သံ​ဖြင့် ကြွေး​ကြော်​၏။ ယင်း​သို့​ကြွေး​ကြော်​လိုက်​သော အ​ခါ​မိုး​ကြိုး​သံ​ခု​နစ်​ချက်​မြည်​လေ​၏။-"]},{"type":"verse","number":4,"content":["ထို​အ​ချိန်​၌​မိုး​ကြိုး​သံ​တို့​က​မိန့်​မြွက်​သည့် စ​ကား​ကို ငါ​သည်​ရေး​မှတ်​မည်​ပြု​သော်``မ​ရေး မ​မှတ်​နှင့်။ မိုး​ကြိုး​သံ​ခု​နစ်​ချက်​မိန့်​မြွက်​သည့် စ​ကား​ကို​လျှို့​ဝှက်​ထား​လော့'' ဟု​ကောင်း​ကင် မှ​ထွက်​သော​အ​သံ​ကို​ငါ​ကြား​ရ​၏။"]},{"type":"verse","number":5,"content":["ထို​နောက်​ပင်​လယ်​နှင့်​ကုန်း​မြေ​ပေါ်​တွင်​ရပ်​နေ သော​ကောင်း​ကင်​တ​မန်​သည် မိ​မိ​၏​လက်ယာ ကို​ကောင်း​ကင်​သို့​မြှောက်​ချီ​ကာ၊-"]},{"type":"verse","number":6,"content":["ကမ္ဘာ​အ​ဆက်​ဆက်​အ​သက်​ရှင်​တော်​မူ​၍​မိုး၊ မြေ၊ ပင်​လယ်​မှ​စ​၍​အ​ရာ​ခပ်​သိမ်း​တို့​ကို ဖန်​ဆင်း​တော်​မူ​သော​ဘု​ရား​သ​ခင်​၏​နာ​မ တော်​ကို​တိုင်​တည်​လျက်``နောက်​ထပ်​နှောင့်​နှေး ကြန့်​ကြာ​မှု​ရှိ​မည်​မ​ဟုတ်။ ဘု​ရား​သ​ခင် သည်​မိ​မိ​၏​အ​စေ​ခံ​ပ​ရော​ဖက်​တို့​အား ဗျာ​ဒိတ်​ပေး​တော်​မူ​ခဲ့​သည်​နှင့်​အ​ညီ၊-"]},{"type":"verse","number":7,"content":["သတ္တမ​ကောင်း​ကင်​တ​မန်​တံ​ပိုး​ခ​ရာ​မှုတ်​သော အ​ခါ​၌ ကိုယ်​တော်​သည်​မိ​မိ​၏​နက်​နဲ​သော အ​ကြံ​အ​စည်​တော်​တို့​ကို​ပြီး​မြောက်​စေ တော်​မူ​မည်'' ဟု​ဆို​လေ​သည်။"]},{"type":"verse","number":8,"content":["ကောင်း​ကင်​မှ​ငါ​ကြား​ရ​သည့်​မိန့်​မြွက်​သံ​က ငါ့​အား``သွား​လော့။ ပင်​လယ်​နှင့်​ကုန်း​မြေ​ပေါ် တွင်​ရပ်​လျက်​နေ​သော​ကောင်း​ကင်​တ​မန်​လက် ၌​ဖွင့်​ထား​သော​စာ​စောင်​ကို​ယူ​လော့'' ဟု​ဆို ပြန်​၏။"]},{"type":"verse","number":9,"content":["သို့​ဖြစ်​၍​ငါ​သည်​ထို​ကောင်း​ကင်​တ​မန်​ထံ သို့​သွား​ပြီး​လျှင် စာ​စောင်​ငယ်​ကို​ပေး​ရန် တောင်း​၏။ ကောင်း​ကင်​တ​မန်​က``ဤ​စာ​စောင် ကို​ယူ​၍​စား​လော့။ သင်​၏​ဝမ်း​ကို​ခါး​စေ လိမ့်​မည်။ သို့​ရာ​တွင်​သင်​၏​ခံ​တွင်း​၌​ပျား ရည်​ကဲ့​သို့​ချို​လိမ့်​မည်'' ဟု​ဆို​၏။"]},{"type":"verse","number":10,"content":["ငါ​သည်​ကောင်း​ကင်​တ​မန်​၏​လက်​မှ​စာ​စောင် ငယ်​ကို​ယူ​၍​စား​၏။ ထို​စာ​စောင်​သည်​ငါ​၏ ခံ​တွင်း​၌​ပျား​ရည်​ကဲ့​သို့​ချို​၏။ ဝမ်း​တွင်း သို့​ရောက်​သော​အ​ခါ​၌​မူ​ခါး​လေ​သည်။-"]},{"type":"verse","number":11,"content":["ထို​နောက်​ကောင်း​ကင်​တ​မန်​က``သင်​သည် များ​စွာ​သော​တိုင်း​နိုင်​ငံ​များ၊ ဘာ​သာ​စ​ကား အ​မျိုး​မျိုး​ပြော​ဆို​သော​လူ​မျိုး​များ၊ ရှင် ဘု​ရင်​များ​၏​အ​ကြောင်း​နှင့်​စပ်​လျဉ်း​သည့် ဘု​ရား​သ​ခင်​၏​ဗျာ​ဒိတ်​တော်​ကို​နောက် တစ်​ဖန်​ဟော​ကြား​ရ​ဦး​မည်'' ဟု​ငါ့​အား ဆို​၏။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/REV/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/REV/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/REV/9.json","previousChapterAudioLinks":{},"numberOfVerses":11}