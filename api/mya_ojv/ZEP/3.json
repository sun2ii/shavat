ရော​ဖက်​ဇေ​ဖ​နိ​စီ​ရင်​ရေး​ထား​သော အ​နာ​ဂတ္တိ​ကျမ်း​ပြီး​၏။"]}],"footnotes":[]},"thisChapterLink":"/api/mya_ojv/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/mya_ojv/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/mya_ojv/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}