{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"ISA","translationId":"nch_tbl","name":"ISAÍAS","commonName":"ISAÍAS","title":"Isaías","order":23,"numberOfChapters":66,"sha256":"1cdbe128f5f590c15814380c7af2472073ebea5df35ce4a2c8782ce0d35522dc","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nch_tbl/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":12,"content":[{"type":"heading","content":["Huicat ten tascamatili para TOTECO"]},{"type":"verse","number":1,"content":["Hualas se tonali quema masehualme huicase:",{"text":"“Nimitzhueyitalía, TOTECO.","poem":1},{"lineBreak":true},{"text":"Masque tahuel ticualaniyaya ica na,","poem":1},{"lineBreak":true},{"text":"ama timoyoltalijtoc huan techtasojtatoc.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xiquitaca anmasehualme, Toteco Dios yaya notemaquixtijca.","poem":1},{"lineBreak":true},{"text":"Huajca nimotemachis ipan ya huan ayecmo nimajmahuis.","poem":1},{"lineBreak":true},{"text":"TOTECO itztoc cati techmaca nochicahualis huan yeca san para ya nihuicas.","poem":1},{"lineBreak":true},{"text":"San yaya notemaquixtijca.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Quej se ajhuiyac at quinmaca paquilisti cati amiquij,","poem":1},{"lineBreak":true},{"text":"quej nopa tipaquij tojuanti, tiimasehualhua TOTECO cati yaya techmaquixtijtoc.”","poem":1}]},{"type":"verse","number":4,"content":["Huan ipan nopa tonali quiijtose:",{"text":"“¡Xijtascamatica TOTECO!","poem":1},{"lineBreak":true},{"text":"¡Xijhueyitalica ya!","poem":1},{"lineBreak":true},{"text":"¡Xitepohuilica ipan nochi talme nopa huejhueyi tamanti cati yaya quichijtoc!","poem":1},{"lineBreak":true},{"text":"¡Xiteilhuica para TOTECO yaya nelía hueyi!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xihuicaca tiohuicat para TOTECO pampa yaya quichijtoc huejhueyi tamanti.","poem":1},{"lineBreak":true},{"text":"Ma quimatica taya quichijtoc nochi ipan taltipacti.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Huan ma huicaca huan ma tzajtzica ica paquilisti,","poem":1},{"lineBreak":true},{"text":"nochi cati itztoque ipan altepet Jerusalén.","poem":1},{"lineBreak":true},{"text":"Pampa tatajco ten tojuanti itztoc TOTECO cati nelía hueyi,","poem":1},{"lineBreak":true},{"text":"Quena, yaya nopa Dios cati Tatzejtzeloltic huan itztoc tohuaya tiisraelitame.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}