{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":1,"content":[{"type":"heading","content":["Tajtacolchihuani huan cati itztoque xitahuaque iixpa Toteco"]},{"type":"verse","number":1,"content":[{"text":"Paqui nopa masehuali cati amo quitacaquilía inincamanal amo cuajcualme,","poem":1},{"lineBreak":true},{"text":"yon amo quintoquilía tajtacolchihuani.","poem":1},{"lineBreak":true},{"text":"Yon amo mohuica inihuaya cati ica paquij TOTECO.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nopa masehuali quipantía hueyi paquilisti pampa quichijtinemi cati quiijtohuaj itanahuatilhua TOTECO,","poem":1},{"lineBreak":true},{"text":"huan ipan nopa tanahuatilme moyolilhuijtinemi tonaya huan tayohua.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nopa masehuali itztoc quej se cuahuit cati moscaltía nechca atenti,","poem":1},{"lineBreak":true},{"text":"huan temaca itajca quema ipohual huan amo quema xihuiyo tepehui.","poem":1},{"lineBreak":true},{"text":"Nochi cati quichihua quisa cuali.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pero amo quej nopa ica masehualme cati amo cuajcualme,","poem":1},{"lineBreak":true},{"text":"pampa inijuanti itztoque quej tasoli cati quihuica ajacat.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yeca quema TOTECO tetajtolsencahuas,","poem":1},{"lineBreak":true},{"text":"nopa amo cuajcualme amo huelise quiijyohuise,","poem":1},{"lineBreak":true},{"text":"pampa yaya tahuel chicahuac quintatzacuiltis.","poem":1},{"lineBreak":true},{"text":"Quena, ipan nopa tonali tajtacolchihuani ayecmo huelis itztose inihuaya masehualme cati itztoque xitahuaque iixpa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pampa TOTECO quiixmati nopa ojti cati quitoquilíaj masehualme cati itztoque xitahuaque,","poem":1},{"lineBreak":true},{"text":"pero masehualme cati quichihuaj cati amo cuali, polihuise.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}