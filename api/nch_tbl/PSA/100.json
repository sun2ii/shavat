{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":100,"content":[{"type":"heading","content":["Ma tijtascamatica Toteco"]},{"type":"verse","number":1,"content":[{"text":"Xihuicaca ica paquilisti para TOTECO,","poem":1},{"lineBreak":true},{"text":"nochi anmasehualme cati anitztoque ipan ni taltipacti.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xijtequipanoca TOTECO ica paquilisti.","poem":1},{"lineBreak":true},{"text":"Huan quema anhualahuij iixpa, xihuicatihualaca.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xijmatica cuali para TOTECO, yaya Toteco Dios.","poem":1},{"lineBreak":true},{"text":"Yaya techchijchijqui.","poem":1},{"lineBreak":true},{"text":"Amo timochijchijtoque tojuanti.","poem":1},{"lineBreak":true},{"text":"Tojuanti tiimasehualhua huan tiitztoque quej tiiborregojhua cati techpixtoc ipan ipotrero para techmocuitahuis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quema ticalaquij ipan itiopa, ma tijtascamatica miyac.","poem":1},{"lineBreak":true},{"text":"Huan quema tinemij icalixpa, ma tihuicaca.","poem":1},{"lineBreak":true},{"text":"Quena, ma tijtascamatica huan ma tijpaquilismacaca.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pampa TOTECO yaya nelía cuali.","poem":1},{"lineBreak":true},{"text":"Nochipa teicnelía huan tetasojta.","poem":1},{"lineBreak":true},{"text":"Yaya itztos temachti para nochipa ica nochi masehualme cati tacajtihualahuij.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}