{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":113,"content":[{"type":"heading","content":["Toteco quitanana se cati teicneltzi"]},{"type":"verse","number":1,"content":[{"text":"¡Xijpaquilismacaca TOTECO!","poem":1},{"lineBreak":true},{"text":"¡Quena, nochi amojuanti cati anitequipanojcahua TOTECO, xijhueyimatica!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma tijhueyimatica TOTECO ama huan para nochipa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Quena, nochi masehualme ten campa quisa tonati hasta campa oncalaqui ma quihueyimatica TOTECO.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"TOTECO quipiya tanahuatili ica nochi cati itztoque ipan nochi talme.","poem":1},{"lineBreak":true},{"text":"Huan ihueyitilis conpano ilhuicacti.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¿Ajquiya seyoc más hueyi quej TOTECO toDios cati mosehuía nepa huejcapa para tanahuatis?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tatzinta ten ya eltoc ilhuicacti huan taltipacti.","poem":1},{"lineBreak":true},{"text":"Huan yaya mohuijtzoma para tachiyas ipan ni taltipacti.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Huan quitanana nopa teicneltzi cati eltoc quej masitoc ipan soquit cati huejcata.","poem":1},{"lineBreak":true},{"text":"Huan cati huetztoc campa quitepehuaj tasoli quitanana huan quisehuía campa cuali.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Quena, quitanana huan quisehuía inihuaya huejhueyi tacame","poem":1},{"lineBreak":true},{"text":"cati quinyacanaj inialtepet ehuani.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yaya quichihua para nopa sihuat cati amo quema conepixqui","poem":1},{"lineBreak":true},{"text":"ma quinpiya iconehua huan ichaj.","poem":1},{"lineBreak":true},{"text":"Quena, quichihua ma eli se tenanti cati senpactoc.","poem":1},{"lineBreak":true},{"text":"¡Paquilisti!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}