{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":12,"content":[{"type":"heading","content":["Techpalehui, TOTECO"]},{"type":"verse","number":1,"content":[{"text":"Techpalehui, TOTECO,","poem":1},{"lineBreak":true},{"text":"pampa ayecmo aquijme cati nelía mitzneltoquilía.","poem":1},{"lineBreak":true},{"text":"Ayecmo aquijme masehualme cati quiijtohuaj cati melahuac.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Se ica seyoc moistacahuíaj.","poem":1},{"lineBreak":true},{"text":"Quipiyaj ome inixayac huan quipataj inincamanal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"TOTECO quintzontamiltis nochi cati quipiyaj ome inixayac huan cati mohueyimatij quema camanaltij.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quintzontamiltis cati quiijtohuaj:","poem":1},{"lineBreak":true},{"text":"“San ica tocamanal titatanise.","poem":1},{"lineBreak":true},{"text":"Sinta tijnequij tiistacatise,","poem":1},{"lineBreak":true},{"text":"tojuanti tijmatij.","poem":1},{"lineBreak":true},{"text":"Amo aqui huelis technahuatis.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pero quej ni quiijtojtoc TOTECO:","poem":1},{"lineBreak":true},{"text":"“Inijuanti cati teicneltzitzi huan cati amo quipiyaj fuerza nechtzajtzilíaj por nopa fiero masehualme cati quintaijyohuiltíaj.","poem":1},{"lineBreak":true},{"text":"Yeca ama nimotananas para niquinpalehuis.","poem":1},{"lineBreak":true},{"text":"Niquinmaquixtis inimaco cati quincualancaitaj.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nelía temachti cati quiijtohua TOTECO.","poem":1},{"lineBreak":true},{"text":"Icamanal senquisa melahuac.","poem":1},{"lineBreak":true},{"text":"Quena, eltoc quej se cuali plata cati quinelicxitijtoque,","poem":1},{"lineBreak":true},{"text":"huan quipajpactoque miyac huelta hasta senquisa cuali.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"TOTECO, ta techmocuitahuía.","poem":1},{"lineBreak":true},{"text":"Techmanahuis para nochipa ica masehualme cati amo cuajcualme quej ama itztoque.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Quena, masque mosisinijca masehualme mooquichmajtinemij campa hueli huan nochi masehualme san quipatiitaj cati amo cuali,","poem":1},{"lineBreak":true},{"text":"Ta techmocuitahuía.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}