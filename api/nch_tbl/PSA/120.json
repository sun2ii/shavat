{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":120,"content":[{"type":"heading","content":["Netatajtili para Toteco ma quimanahui ten nopa istacatini"]},{"type":"verse","number":1,"content":[{"text":"Quema niitztoya ipan taijyohuilisti,","poem":1},{"lineBreak":true},{"text":"nijtzajtzili TOTECO huan yaya nechnanquili.","poem":1},{"lineBreak":true},{"text":"Niquilhui:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“TOTECO, techmanahui inimaco nopa masehualme,","poem":1},{"lineBreak":true},{"text":"cati nechistacahuíaj huan nechejelnamiquij.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma moilhuica nopa istacatini taya ininpantis por iniistacaticayo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quintamicocoyotzase ica cuataminti huan quintatise ipan ticoli.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nelía niteicneltzi na cati niitztoc inihuaya ni masehualme ten tali Mesec huan Cedar.","poem":1},{"lineBreak":true},{"text":"Nelía nitaijyohuía tatajco ten inijuanti,","poem":1},{"lineBreak":true},{"text":"pampa yon se ten inijuanti amo mitztepanita, Toteco.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ya nisiyajqui para niitztoc inihuaya ni masehualme cati amo quinequij ma onca tasehuilisti.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Quema niquincamanalhuía quenicatza hueli tiitztose ica tasehuilisti,","poem":1},{"lineBreak":true},{"text":"inijuanti quisencahuaj quenicatza tatehuise.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}