{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":121,"content":[{"type":"heading","content":["Toteco yaya mitzmocuitahuis"]},{"type":"verse","number":1,"content":[{"text":"Quema nijtananas noxayac,","poem":1},{"lineBreak":true},{"text":"huan nitachiyas ipan nopa tepeme, nimoilhuía:","poem":1},{"lineBreak":true},{"text":"“¿Canque huala notapalehuil?”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Notapalehuil huala ten TOTECO,","poem":1},{"lineBreak":true},{"text":"yaya cati quichijchijqui ilhuicacti huan taltipacti.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yaya amo quema mitzcahuilis para timotepotanis o tihuetzis.","poem":1},{"lineBreak":true},{"text":"Yaya mitzmocuitahuis huan amo quema cochis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quena, TOTECO cati quinmocuitahuía israelitame amo ixijcopi,","poem":1},{"lineBreak":true},{"text":"yon amo cochi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"TOTECO yaya mitzmocuitahuía.","poem":1},{"lineBreak":true},{"text":"Yaya itztoc monechca para mitzmanahuis.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yaya mitzmocuitahuía tonaya huan tayohua.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"TOTECO mitzmocuitahuis para amo mitzajsis yon se tamanti cati amo cuali.","poem":1},{"lineBreak":true},{"text":"Quena, yaya quimocuitahuis monemilis.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"TOTECO yaya mitzmocuitahuis campa hueli tiyas o tihualas,","poem":1},{"lineBreak":true},{"text":"ama huan para nochipa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}