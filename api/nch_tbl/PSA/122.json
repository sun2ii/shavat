{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":122,"content":[{"type":"heading","content":["Netatajtili para ma onca tasehuilisti ipan altepet Jerusalén"]},{"type":"verse","number":1,"content":[{"text":"Na nipajqui quema nechilhuijque:","poem":1},{"lineBreak":true},{"text":"“Ma tiyacajya ichaj TOTECO.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pero ama ya tiitztoque nica ipan altepet Jerusalén.","poem":1},{"lineBreak":true},{"text":"Quena, ya ticalactoque campa icaltehua ni altepe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jerusalén quisencajtoque para nopona nochi ma mosentilica.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nochi imasehualhua TOTECO ten cati hueli hueyi familia ten israelitame hualahuij nica sese xihuit,","poem":1},{"lineBreak":true},{"text":"para quitascamatise huan quipaquilismacase Toteco senquisa quej quiijtohua itajtol.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pampa nopona mosehuía para tetajtolsencahuas nopa tanahuatijquet cati iixhui David.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ximotatajtica ica TOTECO para ma onca tasehuilisti ipan altepet Jerusalén.","poem":1},{"lineBreak":true},{"text":"Xijtiochihua Jerusalén ica ni camanali:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"“Ma itztoca cuali nochi cati quiicnelíaj ni altepet Jerusalén.","poem":1},{"lineBreak":true},{"text":"Ma onca tasehuilisti ica calijtic nopa tepamit cati quiyahualojtoc.","poem":1},{"lineBreak":true},{"text":"Ma itztoca ica paquilisti ipan nochi tequicalme.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pampa niquinicnelía noicnihua huan nohuampoyohua cati itztoque nica, niquijtohua:","poem":1},{"lineBreak":true},{"text":"“Ma quipiya tasehuilisti ni altepet.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pampa niquicnelía ichaj TOTECO cati eltoc nica,","poem":1},{"lineBreak":true},{"text":"ma onca tasehuilisti ipan ni altepet.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}