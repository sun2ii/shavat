{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":123,"content":[{"type":"heading","content":["Netatajtili para Toteco ma quitasojta"]},{"type":"verse","number":1,"content":[{"text":"Na nijtananas noxayac para nimitztachilis ta, TOTECO,","poem":1},{"lineBreak":true},{"text":"cati timosehuijtoc ipan ilhuicac.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tojuanti timitztachilíaj ta,","poem":1},{"lineBreak":true},{"text":"TOTECO toDios, para ma techtasojta san se quej se tequipanojquet quitachilía iteco,","poem":1},{"lineBreak":true},{"text":"o quej se sihua tequipanojquet quitachilía iteco isihua para ma quichihuili cati cuali.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"TOTECO, techtasojta.","poem":1},{"lineBreak":true},{"text":"Quena, xijpiya hueyi moyolo ica tojuanti.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ya tisiyajtoque ica nopa masehualme cati techitaj quej amo teno topati.","poem":1},{"lineBreak":true},{"text":"Inijuanti cati mohueyimatij huan cati tominpiyani tahuel techpinajtíaj,","poem":1},{"lineBreak":true},{"text":"hasta ya techyolajsic.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}