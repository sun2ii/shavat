{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":124,"content":[{"type":"heading","content":["David quihueyimatqui Toteco pampa quimanahui ten icualancaitacahua"]},{"type":"verse","number":1,"content":[{"text":"Nochi israelitame ma quiijtoca taya tijchijtosquíaj sinta TOTECO amo itztosquía tohuaya huan amo techpalehuijtosquía.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sinta TOTECO amo itztosquía tohuaya quema nopa tacame motananque para techtehuise,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"techtolojtosquíaj tiyoltoque huan techtzontamiltijtosquíaj ica inihueyi cualancayo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Inijuanti techhuahuatatztosquíaj quej at tatilana,","poem":1},{"lineBreak":true},{"text":"huan huajca eltosquía quej hueyat panotosquía topani.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Quena, eltosquía quej topani panotosquía tahuel miyac at cati tetetztic,","poem":1},{"lineBreak":true},{"text":"cati tehuahuatatza huan titzontantosquíaj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma tijtascamatica TOTECO pampa amo quincahuili ma techcococa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Quej se totot cholohua ten se taquetzti,","poem":1},{"lineBreak":true},{"text":"quej nopa nojquiya Toteco techchololti inimaco tocualancaitacahua,","poem":1},{"lineBreak":true},{"text":"cati quinequiyayaj techmasiltise.","poem":1},{"lineBreak":true},{"text":"Nopa laso cotonqui huan tojuanti timocajque timajcajtoque.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tojuanti totapalehuil huala ten TOTECO,","poem":1},{"lineBreak":true},{"text":"cati quichijchijqui ilhuicacti huan taltipacti.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}