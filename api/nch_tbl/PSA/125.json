{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":125,"content":[{"type":"heading","content":["Toteco quinmocuitahuía imasehualhua."]},{"type":"verse","number":1,"content":[{"text":"Masehualme cati motemachíaj ipan TOTECO itztoque neltemachme,","poem":1},{"lineBreak":true},{"text":"quej nopa tepet Sion cati amo mojmolinía,","poem":1},{"lineBreak":true},{"text":"huan ijcatoc cuali para nochipa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Quej Jerusalén quiyahualojtoque miyac tepeme para quimanahuise,","poem":1},{"lineBreak":true},{"text":"quej nopa nojquiya TOTECO quinyahualojtoc imasehualhua huan quinmanahuía.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Toteco amo quincahuilis ma tanahuatica masehualme cati fiero inintalnamiquilis,","poem":1},{"lineBreak":true},{"text":"pampa huelis imasehualhua cati itztoque xitahuaque nojquiya pehuase quichihuase tamanti cati amo cuali.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"TOTECO, xiquinchihuili cati cuali masehualme cati cuajcualme,","poem":1},{"lineBreak":true},{"text":"huan cati xitahuac iniyolo moixpa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pero nopa masehualme cati moiyocaquixtijtoque ten nopa ojti ten cuali huan yahuij ipan ojti cati amo cuali, xiquinhuica campa tiquintatzacuiltis.","poem":1},{"lineBreak":true},{"text":"Huan ma onca paquilisti huan tasehuilisti ipan tali Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}