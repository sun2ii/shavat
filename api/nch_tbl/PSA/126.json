{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":126,"content":[{"type":"heading","content":["Toteco quicualtalis ital"]},{"type":"verse","number":1,"content":[{"text":"Quema TOTECO sempa quinhualicas ipan Jerusalén nochi imasehualhua cati tetequipanohuaj ipan sequinoc talme,","poem":1},{"lineBreak":true},{"text":"elis quej tijtemiquij.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Nelía tihuetzcase huan tihuicase ica paquilisti!","poem":1},{"lineBreak":true},{"text":"Huan nopa masehualme ten sequinoc talme quiijtose:","poem":1},{"lineBreak":true},{"text":"“¡Dios quichijtoc huejhueyi tamanti para nopa israelitame!”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Quena, nelía melahuac TOTECO techchihuilis huejhueyi tamanti.","poem":1},{"lineBreak":true},{"text":"¡Ma tipaquica!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"TOTECO, sempa techmaca tamanti cati cuali quej tijpixtoyaj achtohuiya.","poem":1},{"lineBreak":true},{"text":"Quena, quej nopa hueyame cati ajsi ipan nopa huactoc tali huan quiyancuilía,","poem":1},{"lineBreak":true},{"text":"quej nopa xijyancuili tonemilis, TOTECO.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Cati tocaj ica choquisti, ica paquilisti pixcase.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Quena, masque chocatiyase quema quitoctiyase inixinach,","poem":1},{"lineBreak":true},{"text":"pero quema pixcatij huicatihualase ica paquilisti pampa ya quihualicase cati quipixcatose.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}