{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":128,"content":[{"type":"heading","content":["Cuali ipanti nopa masehuali cati quitepanita Toteco"]},{"type":"verse","number":1,"content":[{"text":"Nelía paqui nopa masehuali cati quiimacasi huan quitepanita TOTECO.","poem":1},{"lineBreak":true},{"text":"Quena, paqui cati nemi xitahuac ipan iojhui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Quiselis itaxtahuil pampa tequiti cuali.","poem":1},{"lineBreak":true},{"text":"Yaya paquis miyac huan nochi cati quichihuas quisas cuali.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Isihua paquis ipan ichaj.","poem":1},{"lineBreak":true},{"text":"Yaya elis quej se cuali xocomeca tzonti cati achi más quimocuitahuíaj huan cati temaca miyac itajca.","poem":1},{"lineBreak":true},{"text":"Quinpiyas miyac ininconehua cati mosehuise campa imesa huan quipiyase miyac chicahualisti.","poem":1},{"lineBreak":true},{"text":"Quena, itztose quej olivo cuame cati nelía cuali.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quej nopa TOTECO quitiochihuas nopa tacat cati quiimacasi huan quitepanita.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"TOTECO quitiochihuas ten altepet Sion.","poem":1},{"lineBreak":true},{"text":"Quicahuilis ma quiita para nochi eltoc cuali ipan Jerusalén nochi tonali ten inemilis.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Quicahuilis para itztos hasta quinitas iixhuihua.","poem":1},{"lineBreak":true},{"text":"¡Toteco quimacas tasehuilisti nopa tali Israel!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}