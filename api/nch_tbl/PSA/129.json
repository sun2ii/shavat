{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":129,"content":[{"type":"heading","content":["Ma huetzica cati quincualancaitaj israelitame huan altepet Jerusalén"]},{"type":"verse","number":1,"content":[{"text":"Nochi israelitame hueli quiijtose para hasta quema pejqui itztose israelitame,","poem":1},{"lineBreak":true},{"text":"huan pejqui timochihuaj se altepet ten san se toeso timasehualme,","poem":1},{"lineBreak":true},{"text":"tocualancaitacahua techtepotztocatinentoque.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Techcuesolmacatoque hasta quema tiisraelita masehualme tipejque timoscaltíaj quej se telpocat.","poem":1},{"lineBreak":true},{"text":"Pero amo quema hueltoque techtzontamiltíaj.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tocuitapa techtamicocojque quema techmaquiliyayaj hasta huejcajquiya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pero TOTECO yaya nelía xitahuac,","poem":1},{"lineBreak":true},{"text":"quicotonqui nopa tepos cadenas cati ica techtatacatzohuayayaj nopa masehualme cati amo quitepanitaj TOTECO.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma huetzica ipan se hueyi pinahualisti nochi cati quicualancaitaj altepet Jerusalén.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma elica quej nopa xihuit cati nimantzi pilini huan huaqui pampa ixhuatoc ipan tali cati amo huejcata.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Quena, ma elica quej nopa xihuit cati amo aqui quimehua,","poem":1},{"lineBreak":true},{"text":"yon amo aqui quipixca itajca pampa amo teno ipati.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nimitztajtanía para yon se cati pano campa nopa fiero masehualme ma amo quintiochihua.","poem":1},{"lineBreak":true},{"text":"Amo aqui ma quiijto:","poem":1},{"lineBreak":true},{"text":"“Ma TOTECO amechtiochihua.”","poem":1},{"lineBreak":true},{"text":"Yon ma amo quiijtoca:","poem":1},{"lineBreak":true},{"text":"“Tojuanti timechtiochihuaj ica itequiticayo TOTECO.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}