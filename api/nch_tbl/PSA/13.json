{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":13,"content":[{"type":"heading","content":["Se netatajtili para quitajtanis itapalehuil TOTECO"]},{"type":"verse","number":1,"content":[{"text":"TOTECO, ¿hasta quema techelcajtos?","poem":1},{"lineBreak":true},{"text":"¿Ayecmo quema techelnamiquis?","poem":1},{"lineBreak":true},{"text":"Nijmati techcuanecatatilía quema nimitztemohua.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¿Hasta quema nijpiyas tequipacholi ipan noyolo huan noyoltzi taijyohuijtinemis?","poem":1},{"lineBreak":true},{"text":"¿Hasta quema nocualancaitaca noja nechtanis?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Techtachili huan technanquili, TOTECO.","poem":1},{"lineBreak":true},{"text":"¡NoTeco Dios!","poem":1},{"lineBreak":true},{"text":"Techmaca taahuili para nitachiyas ipan ni tzintayohuilot huan amo nimiquis.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amo xijcahuili nocualancaitaca ma quiijto nechtanqui.","poem":1},{"lineBreak":true},{"text":"Amo techcahuili ma nihuetzi para amo nechhuetzquilise inijuanti cati nechcualancaitaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na nimotemachijtoc ipan moteicnelijcayo cati huejcahua para nochipa.","poem":1},{"lineBreak":true},{"text":"Nipaqui ipan noyolo pampa techmaquixtijtoc.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nihuicas para ta, TOTECO,","poem":1},{"lineBreak":true},{"text":"pampa miyac cati cuali techchihuilijtoc.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}