{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":130,"content":[{"type":"heading","content":["Ximotemachica ipan Toteco para amechmanahuis"]},{"type":"verse","number":1,"content":[{"text":"TOTECO, quema nimopantía ipan se hueyi taohuijcayot,","poem":1},{"lineBreak":true},{"text":"na nimitztzajtzilía para techtitanili motapalehuil.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Toteco, techtacaquili quema nimitznojnotza.","poem":1},{"lineBreak":true},{"text":"Xijchihuili cuenta cati nimitztajtanía huan techpalehui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"TOTECO, sinta tiquelnamiquisquía nochi totajtacolhua,","poem":1},{"lineBreak":true},{"text":"amo aqui huelisquía moquetzas moixpa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pero ta nelía titetapojpolhuía,","poem":1},{"lineBreak":true},{"text":"para nochi masehualme ma mitztepanitaca.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na nimochiya ipan ta, TOTECO, para techpalehuis,","poem":1},{"lineBreak":true},{"text":"Quena, ica nochi noyolo nimotemachía ipan nopa cati techtajtolcahuilijtoc ipan mocamanal.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ipan noalma senquisa nitachixtoc para ta, TOTECO, xitequiti.","poem":1},{"lineBreak":true},{"text":"Nitachixtoc para techpalehuis,","poem":1},{"lineBreak":true},{"text":"quej nopa tamocuitahuiani quichiyaj ma tanesi.","poem":1},{"lineBreak":true},{"text":"Quena, más nitachixtoc huan amo quej tamocuitahuiani cati tahuel quinequij ma tanesi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nochi anisraelitame, ximotemachica ipan TOTECO,","poem":1},{"lineBreak":true},{"text":"pampa san yaya quipiya hueyi iyolo huan san yaya temaquixtía talojtzitzi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yaya quinmaquixtis israelitame ten nochi inintajtacolhua.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}