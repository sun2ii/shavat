s":[]},"thisChapterLink":"/api/nch_tbl/PSA/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/134.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/132.json","previousChapterAudioLinks":{},"numberOfVerses":3}