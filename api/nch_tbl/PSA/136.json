{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":136,"content":[{"type":"heading","content":["Ma tijtascamatica Toteco"]},{"type":"verse","number":1,"content":[{"text":"Xijtascamatica TOTECO pampa yaya nelía cuali,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xijtascamatica Toteco Dios cati más hueyi ten nochi sequinoc “dioses”,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xijtascamatica Toteco Dios cati ininTeco nochi tetecome,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xijtascamatica TOTECO pampa san ya hueli quichihua huejhueyi tamanti,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xijtascamatica yaya cati quichijchijqui ilhuicacti ica miyac talnamiquilisti,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Xijtascamatica yaya cati quitali ni tali ipani at,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Xijtascamatica yaya cati quinchijchijqui nopa taahuilme cati onca nepa ilhuicac,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Quichijchijqui nopa tonati para ma taahui tonaya,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Huan quichijchijqui metzti huan sitalime para ma taahuica tayohua,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Xijtascamatica TOTECO cati quintzontamilti nopa achtohui ehuani ten tali Egipto,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Xijtascamatica cati quinquixti israelitame ipan inintal nopa egiptome,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Quena, quinquixti ica ihueyi chicahualis huan ica inejmat quinpalehui,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Xijtascamatica yaya cati quixelo nopa Hueyi At Chichiltic para ma panoca imasehualhua,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Huan quinpanolti nopa israelitame ipan tali huactoc tatajco nopa hueyi at,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Pero quinatzonpolihuilti Faraón huan isoldados ipan nopa hueyi at,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Xijtascamatica Toteco cati quinyacanqui imasehualhua ipan nopa huactoc tali,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Xijtascamatica yaya cati quinmanahui imasehualhua inimaco tanahuatiani cati quipixque miyac chicahualisti,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yaya quintzontamilti huejhueyi tanahuatiani cati tahuel quipiyayayaj chicahualisti,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Quitzontamilti Sehón, inintanahuatijca nopa amorreos,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nojquiya quimicti Og, tanahuatijquet ten tali Basán,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Huan inintal nopa tanahuatiani,","poem":1},{"lineBreak":true},{"text":"Toteco quinmacac imasehualhua quej se tamanti cati inintata quincahuilijtejqui,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Quena, quimacac itequipanojca Israel para ma moaxcati nopa tali para nochipa,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Yaya cati techelnamijqui tiisraelitame quema ayecmo tijpiyayayaj chicahualisti,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Yaya techmanahui inimaco tocualancaitacahua,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Yaya quinmaca tacualisti nochi tamanti cati yoltoque,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Xijtascamatica Toteco Dios cati quinahuatía ilhuicacti,","poem":1},{"lineBreak":true},{"text":"pampa itaicnelijcayo amo quema tami.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}