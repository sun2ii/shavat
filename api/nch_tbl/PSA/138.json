{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":138,"content":[{"type":"heading","content":["Tascamatili por itapalehuil Toteco"]},{"type":"verse","number":1,"content":[{"text":"Ica nochi noyolo nimitztascamatis, TOTECO,","poem":1},{"lineBreak":true},{"text":"huan nihuicas para ta iniixpa moilhuicac ejcahua.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nimotancuaquetza iixmelac motiopa cati tatzejtzeloltic,","poem":1},{"lineBreak":true},{"text":"huan nimitztascamatis pampa nelía titetasojta huan titemachti.","poem":1},{"lineBreak":true},{"text":"Nochi cati techtajtolcahuilijtoc para tijchihuas,","poem":1},{"lineBreak":true},{"text":"tijtamichihuas pampa mocamanal nelía temachti quej ta titemachti.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Quema nimitztzajtzilía,","poem":1},{"lineBreak":true},{"text":"ta technanquilía huan techfuerzajmaca.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"TOTECO, nochi tanahuatiani cati itztoque ipan ni taltipacti mitztascamatise,","poem":1},{"lineBreak":true},{"text":"pampa nochi inijuanti quicaquise cati tijtajtolcajtoc.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Quena, huicase por nochi nopa huejhueyi tamanti cati quichijtoc TOTECO,","poem":1},{"lineBreak":true},{"text":"pampa ihueyitilis nelhueyi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Masque TOTECO tahuel hueyi,","poem":1},{"lineBreak":true},{"text":"yaya quintacaquilía cati moechcapanohuaj.","poem":1},{"lineBreak":true},{"text":"Pero cati mohueyimatij,","poem":1},{"lineBreak":true},{"text":"monequi moquetzase huejca ten Toteco,","poem":1},{"lineBreak":true},{"text":"pampa yaya amo quinequi quinitas.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sinta niitztoc ipan taijyohuilisti, ta TOTECO,","poem":1},{"lineBreak":true},{"text":"techmanahuía huan techmaquixtía.","poem":1},{"lineBreak":true},{"text":"Huan quema nechtehuíaj nocualancaitacahua,","poem":1},{"lineBreak":true},{"text":"ta tijxitahua momax huan techmaquixtía ica mohueyi chicahualis.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"TOTECO, ta tijchihuas nochi cati timoilhuijtoc para tijchihuas ipan na nonemilis.","poem":1},{"lineBreak":true},{"text":"Pampa nopa taicnelijcayot cati tijpiya ica na, TOTECO,","poem":1},{"lineBreak":true},{"text":"amo quema tami.","poem":1},{"lineBreak":true},{"text":"Amo techtahuelcahua pampa ta techchijchijqui.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}