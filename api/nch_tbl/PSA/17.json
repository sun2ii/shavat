{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":17,"content":[{"type":"heading","content":["Motatajtía para quitajtanis TOTECO ma quimanahui"]},{"type":"verse","number":1,"content":[{"text":"Techtacaquili, TOTECO,","poem":1},{"lineBreak":true},{"text":"pampa nimitznojnotza.","poem":1},{"lineBreak":true},{"text":"Nijchijtoc cati xitahuac,","poem":1},{"lineBreak":true},{"text":"huan amo niistacati.","poem":1},{"lineBreak":true},{"text":"Xijtacaquili cati nimitztajtanía huan techpalehui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Techtajtolsencahua iniixpa nochi masehualme.","poem":1},{"lineBreak":true},{"text":"Xiquinnextili para amo teno nijchijtoc,","poem":1},{"lineBreak":true},{"text":"pampa nochipa tijmati cati xitahuac.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Masque tijhualtachilía noyolo ica tayohua huan techyejyecojtoc,","poem":1},{"lineBreak":true},{"text":"amo teno amo cuali tijpantijtoc.","poem":1},{"lineBreak":true},{"text":"Amo niquijtojtoc cati amo monequi,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"quej quichihuaj ne sequinoc.","poem":1},{"lineBreak":true},{"text":"Na nimoiyocatalijtoc ten iniojhui amo cuajcualme.","poem":1},{"lineBreak":true},{"text":"Nijchijtoc senquisa quej quiijtohua motanahuatil.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nijtoquilijtoc moojhui huan amo nihuetztoc ipan tajtacoli.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nimitznojnotza, noTeco Dios, pampa nijmati technanquilis.","poem":1},{"lineBreak":true},{"text":"Techtacaquili huan techchihuili cuenta.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Technextili moteicnelijcayo cati cuajcualtzi.","poem":1},{"lineBreak":true},{"text":"Ta tiquinmaquixtía ica mochicahualis cati motemachiyaj ipan ta.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Techmocuitahui quej se quimocuitahuía iixsital.","poem":1},{"lineBreak":true},{"text":"Quej se piyo quintatía ipilconehua ieltapaltzala,","poem":1},{"lineBreak":true},{"text":"nojquiya quej nopa techmocuitahui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Techtati ten nopa amo cuajcualme cati nechyahualojtoque para nechmictise.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nelía mocualnequij huan quema camanaltij,","poem":1},{"lineBreak":true},{"text":"san mohueyimatij.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nechtoquilijtinemij campa ninentinemi huan san quichiyaj nopa talojtzi quema huelise nechtahuisose talchi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Inijuanti itztoque quej tecuanime cati tahuel mayanaj huan quinequij tecuase,","poem":1},{"lineBreak":true},{"text":"huan motatijtoque ostoijtic para quiitzquise se masehuali quema panos.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ximotanana, TOTECO,","poem":1},{"lineBreak":true},{"text":"xiquinnamiquiti.","poem":1},{"lineBreak":true},{"text":"Xiquinchihualti ma motancuaquetzaca moixpa.","poem":1},{"lineBreak":true},{"text":"Ica momacheta, techmanahui ten nopa amo cuajcualme.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ica mochicahualis, TOTECO,","poem":1},{"lineBreak":true},{"text":"techmaquixti inimaco inijuanti cati san quipiyaj cati eltoc ipan ni taltipacti.","poem":1},{"lineBreak":true},{"text":"Tijmiyaquilijtoc cati iniaxca nica.","poem":1},{"lineBreak":true},{"text":"Nojquiya xiquinmaca miyac tatzacuiltili hasta mocahuas para ininconehua.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Pero na niitztoc xitahuac moixpa,","poem":1},{"lineBreak":true},{"text":"huan se tonali nimitzitas, TOTECO,","poem":1},{"lineBreak":true},{"text":"huan yeca nipaqui.","poem":1},{"lineBreak":true},{"text":"Se tonali quema niisas nijpiyas nochi cati nijtemojtinentoc,","poem":1},{"lineBreak":true},{"text":"pampa niitztos monechca huan ica paquilisti timoixtachilise.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}