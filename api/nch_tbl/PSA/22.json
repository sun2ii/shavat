{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":22,"content":[{"type":"heading","content":["Se tacat quitzajtzilía Toteco huan teipa quipaquilismaca"]},{"type":"verse","number":1,"content":[{"text":"¡NoTeco Dios! ¡NoTeco Dios!","poem":1},{"lineBreak":true},{"text":"¿Para ten techtahuelcajtoc?","poem":1},{"lineBreak":true},{"text":"¿Para ten timohuejcatalijtoc huan amo tihualajtoc para techmanahuiqui?","poem":1},{"lineBreak":true},{"text":"Amo tijtacaquilía quema nimitztzajtzilía.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"NoTeco, tonaya huan tayohua amo nimosiyajquetza nimitznotza,","poem":1},{"lineBreak":true},{"text":"pero amo technanquilía.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Huan masque quej nopa eltoc,","poem":1},{"lineBreak":true},{"text":"ta quejipa titatzejtzeloltic.","poem":1},{"lineBreak":true},{"text":"Nochi tohuejcapan tatahua tiisraelitame mitzyahualojque huan mitzhueyichijque.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Totatahua mochixque ipan ta.","poem":1},{"lineBreak":true},{"text":"Quena, motemachijque ipan ta huan ta tiquinmanahui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mitznojnotzque quema taijyohuiyayaj huan tiquinmaquixti.","poem":1},{"lineBreak":true},{"text":"Ipan ta motemachijque huan amo tiquinpinahualti.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pero na nimomati quej se pilocuiltzi huan amo nise masehuali.","poem":1},{"lineBreak":true},{"text":"Sequij san nechhuetzquilíaj huan sequinoc nechcualancaitaj.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nochi cati nechitaj san noca paquij,","poem":1},{"lineBreak":true},{"text":"huan nechhuihuiitaj huan motzonojoliníaj,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"huan quiijtohuaj:","poem":1},{"lineBreak":true},{"text":"“Yaya motemachía ipan TOTECO,","poem":1},{"lineBreak":true},{"text":"huajca ma tiquitaca sinta quimaquixtis.","poem":1},{"lineBreak":true},{"text":"Sinta nelía quiicnelía,","poem":1},{"lineBreak":true},{"text":"ma quimanahuiqui.”","poem":1},"Quej nopa quiijtohuaj masehualme."]},{"type":"verse","number":9,"content":[{"text":"Pero TOTECO, na nijmati para techpalehuijtoc.","poem":1},{"lineBreak":true},{"text":"Techquixti iijtico nonana.","poem":1},{"lineBreak":true},{"text":"Techmocuitahuijtoc hasta ten quema noja nichichiyaya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Huan quema nitacatqui ya ipa nimotemachijtoc ipan ta.","poem":1},{"lineBreak":true},{"text":"Nochi tonali tieltihualajtoc tinoTeco Dios.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Amo techtalcahui san pampa hualajtoc ni tequipacholi huan amo aqui seyoc cati hueli nechpalehuis.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Miyaqui nocualancaitacahua nechyahualojtoque quej torojme cati mosisiníaj.","poem":1},{"lineBreak":true},{"text":"Quena, nesij quej nopa huejhueyi torojme cati itztoque ipan tali Basán.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nanalcaj quej tecuanime cati mosisiníaj.","poem":1},{"lineBreak":true},{"text":"Camachalohuaj huan nechmelaitaj.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Na nimomati quej at cati mopatzcatoc huan campa hueli toyajtoc.","poem":1},{"lineBreak":true},{"text":"Nochi noomiyo lelecuecatoc.","poem":1},{"lineBreak":true},{"text":"Noyolo eltoc quej cera cati atiya.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tantoc nochi nochicahualis.","poem":1},{"lineBreak":true},{"text":"Nijpiya nocamac huactoc quej se chachapal tepalcat,","poem":1},{"lineBreak":true},{"text":"huan nonenepil tatzquitoc ica nocholec.","poem":1},{"lineBreak":true},{"text":"Techtalijtoc campa tahuactoc huan campa onca miquilisti.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Masehualme cati amo cuajcualme nechyahualojtoque quej chichime.","poem":1},{"lineBreak":true},{"text":"Quicocoyotztoque nomax huan noicxihua.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hasta hueli nijpohuas noomiyohua,","poem":1},{"lineBreak":true},{"text":"pampa sese nechcocohua.","poem":1},{"lineBreak":true},{"text":"Nocualancaitacahua nechtachilijtoque huan san noca paquij.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Momajmacaj cati nimoquentiyaya.","poem":1},{"lineBreak":true},{"text":"Quena, mahuiltíaj ica piltetzitzi para quiitase ajquiya quitocaros sesen noyoyo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Pero ta, TOTECO, amo techtalcahui,","poem":1},{"lineBreak":true},{"text":"pampa na niitztoc momaco.","poem":1},{"lineBreak":true},{"text":"Xihuala nimantzi techpalehuiqui.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Techmanahui ten inimacheta ni mosisinijca masehualme cati itztoque quej chichime.","poem":1},{"lineBreak":true},{"text":"Amo xiquincahuili ma nechmictica.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Eltoc quej niitztoc inincamaco tecuanime,","poem":1},{"lineBreak":true},{"text":"huajca techmaquixti. Nopa masehualme itztoque quej torojme,","poem":1},{"lineBreak":true},{"text":"amo ma nechtompojhuica.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Huan na niquinpohuilis noicnihua ten ta, TOTECO,","poem":1},{"lineBreak":true},{"text":"huan quema oncas tasentilisti,","poem":1},{"lineBreak":true},{"text":"nimitzhueyichihuas iniixpa nochi.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"TOTECO, tojuanti cati timitztepanitaj huan tiquimacasij timitzixpanose timitzpaquilismacaj.","poem":1},{"lineBreak":true},{"text":"Nochi tiiteipan ixhuihua Israel,","poem":1},{"lineBreak":true},{"text":"timitzhueyichihuaj.","poem":1},{"lineBreak":true},{"text":"Quena, timitzhueyimatij nochi tiisraelitame.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Pampa amo techelcajtoc quema titaijyohuíaj,","poem":1},{"lineBreak":true},{"text":"yon amo techhuejcamajcajtoc.","poem":1},{"lineBreak":true},{"text":"Amo cana techcuanecatatilía.","poem":1},{"lineBreak":true},{"text":"¡Amo! Ta techtacaquilía quema timitztajtaníaj techpalehuiqui.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Huajca, TOTECO, ipan nopa hueyi tasentilisti nimitzpaquilismacas iniixpa nochi momasehualhua,","poem":1},{"lineBreak":true},{"text":"pampa ta titemachti.","poem":1},{"lineBreak":true},{"text":"Iniixpa cati mitztepanitaj huan quiimacasij mitzixpanose,","poem":1},{"lineBreak":true},{"text":"na nijchihuas cati nimitztencahuilijtoc para nijchihuas.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Huajca nochi cati teicnetzitzi tacuase huan ixhuise.","poem":1},{"lineBreak":true},{"text":"Nochi cati quitemohuaj TOTECO quipantise huan quipaquilismacase.","poem":1},{"lineBreak":true},{"text":"Quena, paquise para nochipa.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Masehualme ten nochi talme campa hueli ipan taltipacti motepotztocase huan quielnamiquise TOTECO.","poem":1},{"lineBreak":true},{"text":"Inijuanti pehuase quihueyimatise huan motancuaquetzase iixpa.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Pampa TOTECO, yaya nopa tanahuatijquet cati quinnahuatía nochi talme.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Nochi cati quipiyaj tomi huan nochi cati teicneltzitzi ipan ni taltipacti motancuaquetzase iixpa.","poem":1},{"lineBreak":true},{"text":"Quena, nochi taltipac ehuani cati teipa miquise, quihueyimatise.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Nojquiya noteipan ixhuihua quihueyimatise TOTECO huan tepohuilise ten ya nochi ininemilis.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Quema toteipan ixhuihua tacactiyase,","poem":1},{"lineBreak":true},{"text":"tepohuilise para xitahuac TOTECO huan nochi nopa huejhueyi tamanti cati techchihuilijtoc.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}