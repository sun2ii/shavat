{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":23,"content":[{"type":"heading","content":["TOTECO techmocuitahuía"]},{"type":"verse","number":1,"content":[{"text":"Quej se tamocuitahuijquet quinmocuitahuía pilborregojtzitzi,","poem":1},{"lineBreak":true},{"text":"TOTECO techmocuitahuía.","poem":1},{"lineBreak":true},{"text":"Huan yeca amo teno techpolohua.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yaya techsiyajquetza campa onca cuajcualtzi sacat cati xoxohuic.","poem":1},{"lineBreak":true},{"text":"Techhuica campa onca cuali at cati amo mahuilili.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Quema ayecmo hueli nimoquetza,","poem":1},{"lineBreak":true},{"text":"techmaca yancuic chicahualisti.","poem":1},{"lineBreak":true},{"text":"Yaya techyacana ipan ojti xitahuac para nijchijtinemis cati cuali,","poem":1},{"lineBreak":true},{"text":"huan quej nopa nochi quihueyitalise.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Masque ninemis ipan tzintayohuilot nechca miquilisti,","poem":1},{"lineBreak":true},{"text":"amo teno niquimacasis, pampa ta, TOTECO,","poem":1},{"lineBreak":true},{"text":"tiitztoc nohuaya.","poem":1},{"lineBreak":true},{"text":"Ica mocuatopil techmanahuía ten cati amo cuali.","poem":1},{"lineBreak":true},{"text":"Huan ica mocuachicol ten huehueyac, techtilana quema seyoc ojti nijtoquilisnequi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Techsencahuilía se cuali tacualisti iniixpa nocualancaitacahua.","poem":1},{"lineBreak":true},{"text":"Ica aceite techtzonaltía.","poem":1},{"lineBreak":true},{"text":"Techtiochijtoc hasta mocahua.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nijmati para ta, TOTECO, techyacanas nochi nonemilis ica motaicnelijcayo,","poem":1},{"lineBreak":true},{"text":"pampa tijpiya hueyi moyolo ica na.","poem":1},{"lineBreak":true},{"text":"Huan teipa nimocahuas mohuaya ipan mochaj nepa ilhuicac para nochipa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}