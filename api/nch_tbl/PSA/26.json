{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":26,"content":[{"type":"heading","content":["Nopa nemilisti cati tahuel tapajpacti"]},{"type":"verse","number":1,"content":[{"text":"TOTECO, techtajtolsencahua.","poem":1},{"lineBreak":true},{"text":"Xiteyolmelahua para amo teno cati fiero nijchijtoc.","poem":1},{"lineBreak":true},{"text":"Nimotemachijtoc san ipan ta huan amo quema nimoilhuijtoc nimitzcahuas.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Techyoltachili, TOTECO,","poem":1},{"lineBreak":true},{"text":"huan techyejyeco.","poem":1},{"lineBreak":true},{"text":"Xijtachili cuali noyolo huan notalnamiquilis cati más noyolijtic eltoc.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pampa na nijpatiita motaicnelilis, huan nochipa nijtoquilía mocamanal cati melahuac.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amo quema ninejnentoc inihuaya masehualme cati tacajcayahuaj,","poem":1},{"lineBreak":true},{"text":"yon amo nimohuicatoc inihuaya cati quipiyaj ome inixayac.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nijcualancaita inintasentilis amo cuajcualme.","poem":1},{"lineBreak":true},{"text":"Amo quema nimosentilijtoc inihuaya cati fiero quichihuaj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tapajpacti nomax ten nochi tajtacoli,","poem":1},{"lineBreak":true},{"text":"huan san quej nopa nimonechcahuis motaixpa, TOTECO.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nepa nihuicas huicat para nimitzhueyitalis huan niteyolmelahuas nochi cati cuajcualtzi cati ta tijchijtoc.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tahuel niquicnelía mochaj campa tiitztoc, TOTECO,","poem":1},{"lineBreak":true},{"text":"campa monextía motatanex.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Amo techchihuili quej tiquinchihuilía tajtacolchihuani huan temictiani.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Inijuanti quisencahuaj quenicatza huelis tetacuijcuilise.","poem":1},{"lineBreak":true},{"text":"Quipiyaj inimax temitoc ica tomi cati ichtaca tainantoque.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pero na ninemi xitahuac.","poem":1},{"lineBreak":true},{"text":"Xijpiya hueyi moyolo ica na,","poem":1},{"lineBreak":true},{"text":"huan techmaquixti.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"TOTECO, nimitzhueyichihua miyacapa.","poem":1},{"lineBreak":true},{"text":"Ica ta, cuali niijcatoc,","poem":1},{"lineBreak":true},{"text":"huan amo techcahuilijtoc ma nihuetzi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}