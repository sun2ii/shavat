{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":27,"content":[{"type":"heading","content":["TOTECO nechtaahuilía huan nechmaquixtía"]},{"type":"verse","number":1,"content":[{"text":"TOTECO nechtaahuilía huan nechmaquixtía.","poem":1},{"lineBreak":true},{"text":"¿Ajquiya niquimacasis?","poem":1},{"lineBreak":true},{"text":"TOTECO yaya nochicahualis,","poem":1},{"lineBreak":true},{"text":"huan na niitztoc imaco.","poem":1},{"lineBreak":true},{"text":"Amo aqui niquimacasis.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Quema amo cuajcualme quinequise nechtehuise huan quinequise nechmictise,","poem":1},{"lineBreak":true},{"text":"motepotanise huan huetzise.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Masque nochi isoldados se hueyi tali motananase noixpa,","poem":1},{"lineBreak":true},{"text":"amo niyolmajmahuis.","poem":1},{"lineBreak":true},{"text":"Masque nechtehuise,","poem":1},{"lineBreak":true},{"text":"na nimotemachijtos ipan TOTECO pampa yaya itztoc nohuaya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"San se tamanti nijtajtanijtoc TOTECO.","poem":1},{"lineBreak":true},{"text":"San se tamanti nijnequi.","poem":1},{"lineBreak":true},{"text":"Nijnequi niitztos ipan ichaj TOTECO nochi tonali.","poem":1},{"lineBreak":true},{"text":"Nijnequi nijhueyichihuas nepa huan nimopaquilismacas ica nochi ihueyitilis huan itatanex.","poem":1},{"lineBreak":true},{"text":"Quena, ipan ichaj nijtemos cati ya ipaquilis.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Quema ajsis tonali cati amo cuali,","poem":1},{"lineBreak":true},{"text":"TOTECO nechmocuitahuis.","poem":1},{"lineBreak":true},{"text":"Nechtatis ipan itiopa campa más tatzejtzeloltic,","poem":1},{"lineBreak":true},{"text":"huan teipa nechquetzas ipan se hueyi tet para nechhueyitalis.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Quena, nechhueyitalis iniixpa nocualancaitacahua.","poem":1},{"lineBreak":true},{"text":"Yeca na nijtencahuas tacajcahualisti ipan itiopa,","poem":1},{"lineBreak":true},{"text":"huan nicuatzajtzis ica paquilisti.","poem":1},{"lineBreak":true},{"text":"Nihuicas huan nitatzotzonas para nijpaquilismacas TOTECO.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"TOTECO, techtacaquili pampa nimitznojnotza.","poem":1},{"lineBreak":true},{"text":"Xijpiya hueyi moyolo ica na,","poem":1},{"lineBreak":true},{"text":"huan technanquili.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"TOTECO, quema techilhuía:","poem":1},{"lineBreak":true},{"text":"“Techcamanalhuiqui”,","poem":1},{"lineBreak":true},{"text":"na nimitznanquilía:","poem":1},{"lineBreak":true},{"text":"“Nimitzcamanalhuiti”.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Amo techcuanecatatili!","poem":1},{"lineBreak":true},{"text":"¡Amo techhuejcamajcahua pampa ticualantoc ica na!","poem":1},{"lineBreak":true},{"text":"San ta cati techpalehuía,","poem":1},{"lineBreak":true},{"text":"noTeco Dios, ta cati tinotemaquixtijca.","poem":1},{"lineBreak":true},{"text":"Amo techiyocacahua, yon amo techcajtehua noselti.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Masque notata huan nonana nechtahuelcahuase,","poem":1},{"lineBreak":true},{"text":"TOTECO, ta nochipa techmocuitahuis.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"TOTECO, technextili cati tijnequi ma nijchihua.","poem":1},{"lineBreak":true},{"text":"Techyacana san ipan nopa ojti cati cuali campa tijnequi ma ninejnemi,","poem":1},{"lineBreak":true},{"text":"pampa nocualancaitacahua nechyahualojtoque.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Amo techtemactili inimaco quej inijuanti quinequij,","poem":1},{"lineBreak":true},{"text":"pampa ica na motanantoque masehualme cati istacatij huan san quimatij cati más fiero nechchihuilise.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Pero na cuali nijmati TOTECO nechmanahuis,","poem":1},{"lineBreak":true},{"text":"huan sempa niquitas quenicatza cuali iyolo ica na ipan ni taltipacti campa niitztoc.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ximochiya ipan TOTECO.","poem":1},{"lineBreak":true},{"text":"Ximosemaca huan ximoyolchicahua huan amo ximomajmati.","poem":1},{"lineBreak":true},{"text":"Quena, ximotemachi ipan TOTECO.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}