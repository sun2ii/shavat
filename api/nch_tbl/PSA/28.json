{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":28,"content":[{"type":"heading","content":["Toteco quitacaquilía quema timotatajtíaj"]},{"type":"verse","number":1,"content":[{"text":"TOTECO, tinotamanahuijca.","poem":1},{"lineBreak":true},{"text":"San ica ta nimotatía.","poem":1},{"lineBreak":true},{"text":"Ta cati nimitztzajtzilía techpalehuiqui.","poem":1},{"lineBreak":true},{"text":"Amo ximohuexnequi para technanquilis,","poem":1},{"lineBreak":true},{"text":"pampa sinta amo technanquilis,","poem":1},{"lineBreak":true},{"text":"san nimotemacas para ma nechmictica.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xijcaqui nocamanal quema nimitztajtanía tapalehuili.","poem":1},{"lineBreak":true},{"text":"Techchihuili cuenta quema nimomatanana huan nitachía imelac motiopa cati tahuel tatzejtzeloltic.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amo techtatzacuilti inihuaya masehualme cati amo cuajcualme cati san quichihuaj cati amo monequi.","poem":1},{"lineBreak":true},{"text":"Inijuanti camanaltij cuajcualtzi ica sequinoc,","poem":1},{"lineBreak":true},{"text":"pero quipiyaj nochi cati amo cuali ipan iniyolo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xiquincuepili nochi cati amo cuali quichijtoque ica cati amo cuali nojquiya.","poem":1},{"lineBreak":true},{"text":"Xiquintaxtahui ica cati fiero san se quej fiero quinchihuilijtoque sequinoc.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"TOTECO, inijuanti amo quichihuilíaj cuenta nochi cati tijchijtoc,","poem":1},{"lineBreak":true},{"text":"huajca tiquintzontamiltis huan amo quema tiquintananas sempa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"TOTECO, nimitzpaquilismacas pampa tijtacaquilijtoc cati nimitztajtanijtoc.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"TOTECO, yaya nochicahualis huan notamanahuijca ten nochi cati mahuilili.","poem":1},{"lineBreak":true},{"text":"Ipan ya nimoneltemachijtoc huan nechpalehuijtoc,","poem":1},{"lineBreak":true},{"text":"yeca ipan noyolo nijpiya miyac paquilisti.","poem":1},{"lineBreak":true},{"text":"Nihuicas huan nimitztascamatis, TOTECO.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"TOTECO, ta tiquinpixtoc momaco nochi momasehualhua.","poem":1},{"lineBreak":true},{"text":"Yeca san ipan ta motemachía motanahuatijca cati tijtapejpenijtoc.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Xijmaquixti moaltepe, TOTECO.","poem":1},{"lineBreak":true},{"text":"Huan xiquintiochihua inijuanti cati moaxcahua.","poem":1},{"lineBreak":true},{"text":"Techmocuitahui quej se quinmocuitahuía ipilborregojhua.","poem":1},{"lineBreak":true},{"text":"Techhuica momaco para nochipa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}