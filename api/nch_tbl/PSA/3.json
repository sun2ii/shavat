{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":3,"content":[{"type":"heading","content":["Se netatajtili para Toteco Dios ma quipalehui"]},{"type":"verse","number":1,"content":[{"text":"TOTECO, nelía momiyaquilíaj nocualancaitacahua.","poem":1},{"lineBreak":true},{"text":"Quena, nelmiyaqui motananaj para techtehuise.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Miyaqui quiijtohuaj para ta amo quema techpalehuis.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pero TOTECO, ta techyahualohua para techmanahuis.","poem":1},{"lineBreak":true},{"text":"Ta cati techhueyitalía huan san ta cati tihueli techyolchicahua.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chicahuac nimitztzajtzili, TOTECO,","poem":1},{"lineBreak":true},{"text":"para techpalehuis.","poem":1},{"lineBreak":true},{"text":"Huan ta technanquili hasta campa tionitztoc nepa ipan motepe cati tatzejtzeloltic.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yeca nimotejqui huan cuali nicochqui.","poem":1},{"lineBreak":true},{"text":"Huan quema niisac,","poem":1},{"lineBreak":true},{"text":"amo teno nopantitoya pampa ta, TOTECO, techmocuitahuía.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ama ayecmo nechmajmatise masque majtacti mil nocualancaitacahua nechyahualose para nechtehuise.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ximotanana, TOTECO.","poem":1},{"lineBreak":true},{"text":"Techmaquixti, ta tinoTeco Dios.","poem":1},{"lineBreak":true},{"text":"Chicahuac xiquinmaquili nochi nocualancaitacahua ipan inixayac.","poem":1},{"lineBreak":true},{"text":"Xiquintanpojpostequi nopa mosisinijca masehualme,","poem":1},{"lineBreak":true},{"text":"para tamis nochi ininchicahualis huan amo teno huelis nechchihuilise.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"San ta, TOTECO, hueli titemaquixtía.","poem":1},{"lineBreak":true},{"text":"Hueyi paquilisti quipiyaj nochi momasehualhua.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}