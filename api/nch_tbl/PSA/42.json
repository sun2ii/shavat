{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":42,"content":[{"type":"heading","content":["Israelitame cati quinhuicatoque seyoc tali quielnamiquij inintal"]},{"type":"verse","number":1,"content":[{"text":"Quej se masat cati tahuel amiqui quitemojtinemi se atajti para atis,","poem":1},{"lineBreak":true},{"text":"quej nopa na nimitzyoltemohua, noTeco Dios.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Quena, quej se cati tahuel amiqui,","poem":1},{"lineBreak":true},{"text":"na ipan noyolo nimitznequi Toteco,","poem":1},{"lineBreak":true},{"text":"ta cati nelnelía tiitztoc.","poem":1},{"lineBreak":true},{"text":"¿Hasta quema huelis niyas huan nimonextis moixpa?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tayohua huan tonaya nichoca huan amo nitacua.","poem":1},{"lineBreak":true},{"text":"Nocualancaitacahua talojtzitzi nechtatzintoquilíaj:","poem":1},{"lineBreak":true},{"text":"“¿Canque itztoc moDios?","poem":1},{"lineBreak":true},{"text":"¿Para ten amo mitzpalehuía?”","poem":1},{"lineBreak":true},{"text":"Quej nopa nechilhuíaj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Quema niquelnamiqui quenicatza eliyaya achtohuiya nepa ipan notal, eltoc quej atiya noyolo.","poem":1},{"lineBreak":true},{"text":"Niyahuiyaya inihuaya miyaqui masehualme hasta ichaj Toteco Dios.","poem":1},{"lineBreak":true},{"text":"Na niquinyacanayaya nochi hasta ichaj ipan nopa hueyi ilhuit.","poem":1},{"lineBreak":true},{"text":"Titzajtzitiyahuiyayaj ica paquilisti,","poem":1},{"lineBreak":true},{"text":"huan tijtascamatiyayaj Toteco Dios pampa para ya tiilhuichihuayayaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Huajca nimoilhuía:","poem":1},{"lineBreak":true},{"text":"“Amo monequi nimotequipachos.","poem":1},{"lineBreak":true},{"text":"Na nimotemachijtoc ipan noTeco Dios,","poem":1},{"lineBreak":true},{"text":"huan sempa nijpaquilismacas,","poem":1},{"lineBreak":true},{"text":"pampa yaya noDios huan notemaquixtijca.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Pero noTeco, nelía nimotequipachohua nica campa niitztoc ipan ni tali cati huejca.","poem":1},{"lineBreak":true},{"text":"Yeca nimitzelnamiquis,","poem":1},{"lineBreak":true},{"text":"huan niquelnamiquis quenicatza tijpixqui hueyi moyolo ica tojuanti cati tiehuani ipan motal.","poem":1},{"lineBreak":true},{"text":"Niquelnamiqui nopa tali cuajcualtzi cati pehua campa motalohua nopa atajti Jordán,","poem":1},{"lineBreak":true},{"text":"huan ontami hasta campa motanantoc nopa tepeme Hermón huan Mizar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ama ta techtitanilijtoc tequipacholi cati nechijyomictía.","poem":1},{"lineBreak":true},{"text":"Quena, miyac tequipacholi nechajsitoc quej imiyaca at cati huetzi ten tepeixco hasta ipan na.","poem":1},{"lineBreak":true},{"text":"Caquisti quej miyac at cati ajcahuacatoc,","poem":1},{"lineBreak":true},{"text":"huan nochi nopa at nopan panotoc.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Pero ica ijnaloc TOTECO nechtitanilis itaicnelilis.","poem":1},{"lineBreak":true},{"text":"Huan ica tayohua yaya nechmacas se huicat para nijhueyichihuas,","poem":1},{"lineBreak":true},{"text":"huan nimotatajtis ica ya.","poem":1},{"lineBreak":true},{"text":"Quena, nijnojnotza NoTeco cati mojmosta nechmaca nemilisti.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Niquilhuis Toteco Dios:","poem":1},{"lineBreak":true},{"text":"“Ipan ta nimotatía huan amo aqui hueli nechajsis.","poem":1},{"lineBreak":true},{"text":"¿Para ten techelcajtoc?","poem":1},{"lineBreak":true},{"text":"Na san nimotequipachojtinemi,","poem":1},{"lineBreak":true},{"text":"pampa nocualancaitacahua nechtaijyohuiltíaj.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Cati nocualancaitacahua nechchihuilíaj nechcocohua hasta ajsi ipan noomiyohua,","poem":1},{"lineBreak":true},{"text":"pampa nechtaijilhuíaj huan nechtatzintoquilíaj talojtzitzi:","poem":1},{"lineBreak":true},{"text":"‘¿Canque itztoc moDios?","poem":1},{"lineBreak":true},{"text":"¿Para ten amo mitzpalehuía?’ ”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pero amo monequi nimocuesihuilmacas,","poem":1},{"lineBreak":true},{"text":"yon nimotequipachos.","poem":1},{"lineBreak":true},{"text":"Na nimotemachijtoc ipan noTeco Dios,","poem":1},{"lineBreak":true},{"text":"huan teipa sempa nijpaquilismacas pampa yaya noDios huan noTemaquixtijca.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}