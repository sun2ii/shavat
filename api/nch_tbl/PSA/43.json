{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":43,"content":[{"type":"heading","content":["Se netatajtili para quitajtanis Toteco ma quinhuica ipan inintal"]},{"type":"verse","number":1,"content":[{"text":"NoTeco Dios, techtajtolsencahua xitahuac huan xitenextili para amo teno nijchijtoc.","poem":1},{"lineBreak":true},{"text":"Techmanahui ten ni istacatica masehualme huan amo cuajcualme cati nechtelhuíaj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pampa san ta tinoTeco huan tinoDios huan notamanahuijca na.","poem":1},{"lineBreak":true},{"text":"¿Para ten techtahuelcajtoc?","poem":1},{"lineBreak":true},{"text":"Nimotequipachojtinemi huan más nechtaijyohuiltíaj nocualancaitacahua,","poem":1},{"lineBreak":true},{"text":"huan amo teno tijchihua.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Toteco Dios, techyacana ica motaahuil huan technextili cati melahuac.","poem":1},{"lineBreak":true},{"text":"Quej nopa, quena, huelis niyas ipan motal huan campa motepe cati tatzejtzeloltic campa ta tiitztoc ipan motiopa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quena, noTeco Dios, nicalaquis huan niajsiti hasta motaixpa campa masehualme mitzhueyichihuaj.","poem":1},{"lineBreak":true},{"text":"Nepa nimitzpaquilismacas ica arpa, ta cati techmaca paquilisti,","poem":1},{"lineBreak":true},{"text":"pampa ta tinoTeco Dios.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"San tapic nimotequipachos.","poem":1},{"lineBreak":true},{"text":"Na nimotemachijtoc ipan ta, noTeco Dios, huan sempa nimitzpaquilismacas,","poem":1},{"lineBreak":true},{"text":"pampa, ta tinoDios, huan tinotemaquixtijca.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}