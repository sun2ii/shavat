{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":54,"content":[{"type":"heading","content":["Se netatajtili para Toteco ma quimanahui ten icualancaitacahua"]},{"type":"verse","number":1,"content":[{"text":"¡NoTeco Dios, xihuala techmaquixtiqui pampa nochi quimatij ta tihueyi!","poem":1},{"lineBreak":true},{"text":"¡Techmanahuiqui ica mohueyi chicahualis!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Techtacaquili quema nimotatajtía ica ta.","poem":1},{"lineBreak":true},{"text":"Quena, xijtacaquili cati nimitzpohuilía,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"pampa tatehuijca masehualme motanantoque ica na.","poem":1},{"lineBreak":true},{"text":"Quena, masehualme cati amo quema mitzelnamiquij nechtemohuaj para nechmictise.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Pero Toteco Dios nochipa nechpalehuía,","poem":1},{"lineBreak":true},{"text":"huan amo quincahuilis ma nechmictica.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Toteco quincuepilis nocualancaitacahua nochi nopa tamanti amo cuali cati inijuanti quisencajtoque nechchihuilise.","poem":1},{"lineBreak":true},{"text":"Quena, TOTECO, ta cati nelía titemachti, xijchihua senquisa quej techtencahuilijtoc,","poem":1},{"lineBreak":true},{"text":"huan xiquintzontamilti nochi nocualancaitacahua.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ica paquilisti nimitzmacas notacajcahualis.","poem":1},{"lineBreak":true},{"text":"Nimitzhueyimatis pampa ta nelía ticuali,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"pampa ta techmanahuijtoc ten nochi taohuijcayot,","poem":1},{"lineBreak":true},{"text":"huan niquitztoc quenicatza tiquintantoc nochi nocualancaitacahua.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}