{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":59,"content":[{"type":"heading","content":["Se netatajtili para Toteco ma quimanahui David"]},{"type":"verse","number":1,"content":[{"text":"¡NoTeco Dios, techmanahui inimaco nocualancaitacahua!","poem":1},{"lineBreak":true},{"text":"¡Techmocuitahui ten inijuanti cati hualajtoque para nechtzontamiltise!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Techmanahui inimaco tajtacolchijca masehualme,","poem":1},{"lineBreak":true},{"text":"inijuanti cati temictíaj!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nechtachilíaj para quiitase quenicatza nechmictise.","poem":1},{"lineBreak":true},{"text":"Masehualme cati quipiyaj chicahualisti nechchixtoque yahualtic.","poem":1},{"lineBreak":true},{"text":"Pero amo pampa niquinchihuilijtoc se tamanti cati amo cuali","poem":1},{"lineBreak":true},{"text":"o pampa niquinixpanotoc.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡Amo! Amo teno cati fiero niquinchihuilijtoc,","poem":1},{"lineBreak":true},{"text":"pero inijuanti mocualtalíaj para nechmictise.","poem":1},{"lineBreak":true},{"text":"¡TOTECO, xiisa!","poem":1},{"lineBreak":true},{"text":"¡Xihuala techpalehuiqui!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"TOTECO, Ta Cati Tijpiya Nochi Chicahualisti,","poem":1},{"lineBreak":true},{"text":"ta cati titoDios tiisraelitame,","poem":1},{"lineBreak":true},{"text":"ximotanana huan xiquintatzacuilti nopa talme campa itztoque masehualme cati amo israelitame,","poem":1},{"lineBreak":true},{"text":"pampa techyahualojtoque.","poem":1},{"lineBreak":true},{"text":"Amo xiquintapojpolhui nopa masehualme cati mosisiníaj huan nimantzi taixpanoj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mojmosta ica tapoyahui hualahuij para quitachilise quenicatza huelis techtanise.","poem":1},{"lineBreak":true},{"text":"Tzajtzitinemij quej chichime cati quiyahualojtinemij ni altepet.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nijcaqui camanaltij fiero hasta camaposonij,","poem":1},{"lineBreak":true},{"text":"huan mitztelchihuaj Toteco,","poem":1},{"lineBreak":true},{"text":"pampa inijuanti quiijtohuaj:","poem":1},{"lineBreak":true},{"text":"“Amo aqui techcaqui.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pero ta TOTECO, san xiquinhuetzquili,","poem":1},{"lineBreak":true},{"text":"huan xiquinpinahualti ni masehualme ten sequinoc talme cati nechyahualojtoque.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"NoTeco Dios, pampa nocualancaitacahua quipiyaj chicahualisti, ipan ta nimotemachis,","poem":1},{"lineBreak":true},{"text":"pampa ta cati techmanahuía.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"NoTeco Dios, ta nochipa techicnelijtoc miyac,","poem":1},{"lineBreak":true},{"text":"yeca nijmati para temachti techyacantiyas.","poem":1},{"lineBreak":true},{"text":"Tijchihuas ma niquita cati tahuel nijnectoc ma ininpanti nocualancaitacahua.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"NoTeco, ta cati techmanahuía,","poem":1},{"lineBreak":true},{"text":"amo xiquinmicti nimantzi ni nocualancaitacahua,","poem":1},{"lineBreak":true},{"text":"pampa huelis ni nomasehualhua nimantzi quielcahuase cati ininpantis nopa mosisinijca masehualme.","poem":1},{"lineBreak":true},{"text":"Más cuali san xiquinsemana ica mohueyi chicahualis huan xiquinechcapantali.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Quena, xiquintatzacuilti pampa nochi inijuanti tahuel istacatij, mohueyimatij huan tatelchihuaj.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Xiquintzontamilti ica mohueyi cualancayo,","poem":1},{"lineBreak":true},{"text":"huan xiquintamiixpolihuilti.","poem":1},{"lineBreak":true},{"text":"Huan quej nopa nochi masehualme quimatise para ta, Toteco Dios,","poem":1},{"lineBreak":true},{"text":"titanahuatía ipan tali Israel,","poem":1},{"lineBreak":true},{"text":"huan ipan nochi taltipacti.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nocualancaitacahua mocuepaj ica tiotac huan tzajtzij quej chichime,","poem":1},{"lineBreak":true},{"text":"huan quiyahualojtinemij ni altepet.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nentinemij campa hueli para quitemojtinemise inintacualis.","poem":1},{"lineBreak":true},{"text":"Huan quema amo ixhuij,","poem":1},{"lineBreak":true},{"text":"tzajtzij seyohual quej chichime.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Pero na sese ijnaloc nihuicas ica nopa chicahualisti cati techmaca.","poem":1},{"lineBreak":true},{"text":"Huan nimitzhueyimatis pampa techtasojta miyac.","poem":1},{"lineBreak":true},{"text":"San ta techmanahuía huan san ipan ta nimotemachía,","poem":1},{"lineBreak":true},{"text":"quema huala taohuijcayot.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Toteco Dios, momaco ta niitztoc temachti,","poem":1},{"lineBreak":true},{"text":"yeca nimitzhueyimatis huan nihuicas para ta,","poem":1},{"lineBreak":true},{"text":"pampa san ta techmocuitahuía huan techicnelía.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}