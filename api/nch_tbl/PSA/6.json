{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":6,"content":[{"type":"heading","content":["Quenicatza ma timotatajtica quema timotequipachohuaj"]},{"type":"verse","number":1,"content":[{"text":"TOTECO, amo techajhua quema ticualani.","poem":1},{"lineBreak":true},{"text":"Amo techtatzacuilti quema tahuel ticualantoc.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Techtasojta, pampa nimococohua.","poem":1},{"lineBreak":true},{"text":"TOTECO, techchicahua, pampa tahuel nechcocohua nochi notacayo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nihuihuipica ica majmajti huan amo nijmati taya nijchihuas.","poem":1},{"lineBreak":true},{"text":"Huan ta TOTECO, ¿hasta quema tihualas para techtananas?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xihuala, TOTECO, techmanahuiqui para amo nimiquis.","poem":1},{"lineBreak":true},{"text":"Techmaquixti pampa tahuel techicnelía.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amo aqui cati mictoc huelis mitzelnamiquis.","poem":1},{"lineBreak":true},{"text":"¿Ajquiya huelis mitzhueyichihuas sinta mictoc huan ya quitalpachojtoque?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ya tanqui nofuerza ica choquisti.","poem":1},{"lineBreak":true},{"text":"Sese tayohua nichoca miyac hasta nijtamixolonía notzonteto.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nichocatoc miyac hasta nechcocohua noixteyol huan ayecmo hueli nitachiya.","poem":1},{"lineBreak":true},{"text":"Quena, nichoca quema nimoilhuía cati nocualancaitacahua nechchihuilijtoque.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Techtalcahuica, tajtacolchijca masehualme,","poem":1},{"lineBreak":true},{"text":"pampa TOTECO quicactoc quenicatza nichoca.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yaya quicactoc cati nijtajtanijtoc,","poem":1},{"lineBreak":true},{"text":"huan quiselijtoc nonetatajtilis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nochi nocualancaitacahua pinahuase huan huetzise.","poem":1},{"lineBreak":true},{"text":"Ica se talojtzi TOTECO quintahuisos ipan pinahualisti.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}