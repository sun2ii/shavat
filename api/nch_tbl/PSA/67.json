{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":67,"content":[{"type":"heading","content":["Se huicat para quitascamatis Toteco"]},{"type":"verse","number":1,"content":[{"text":"Toteco Dios, xijpiya hueyi moyolo ica tojuanti huan techtiochihua.","poem":1},{"lineBreak":true},{"text":"Ma petani moxayac pampa tipaqui ica tojuanti quema techhualtachilía hasta ten nepa ilhuicac.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nochi masehualme ipan taltipacti ma quiixmatica moojhui.","poem":1},{"lineBreak":true},{"text":"Masehualme ipan nochi talme ma quimatica para ta titemaquixtía.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"NoTeco Dios, ma mitzpaquilismacaca nochi masehualme ipan taltipacti.","poem":1},{"lineBreak":true},{"text":"Quena, nochi masehualme ma mitzhueyimatica.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡Ma paquica nochi masehualme ipan nochi talme huan ma huicaca pampa ta, tiinintanahuatijca!","poem":1},{"lineBreak":true},{"text":"Ta tiquintajtolsencahuas quej quinamiqui,","poem":1},{"lineBreak":true},{"text":"huan nochi talme tiquinyacanas xitahuac.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡NoTeco Dios, ma mitzpaquilismacaca nochi ipan taltipacti!","poem":1},{"lineBreak":true},{"text":"¡Quena, nochi masehualme ma mitzhueyimatica!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ni tali temacatoc miyac pixquisti, pampa ta, Toteco Dios,","poem":1},{"lineBreak":true},{"text":"cati titoDios tojuanti, tahuel techtiochijtoc.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Quena, noja más techtiochihuas, Toteco Dios,","poem":1},{"lineBreak":true},{"text":"huan masehualme campa hueli ipan ni taltipacti mitztepanitase huan mitzimacasise mitzixpanose.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}