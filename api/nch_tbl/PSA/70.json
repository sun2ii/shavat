{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":70,"content":[{"type":"heading","content":["Se netatajtili para Toteco ma quipalehuiqui"]},{"type":"verse","number":1,"content":[{"text":"¡NoTeco Dios, xihuala techmanahuiqui inimaco nocualancaitacahua!","poem":1},{"lineBreak":true},{"text":"¡Quena, ximoisihuilti, Toteco Dios!","poem":1},{"lineBreak":true},{"text":"¡Xihuala techpalehuiqui!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Inijuanti nentinemij notepotzco huan paquij quema nechtaijyohuiltíaj.","poem":1},{"lineBreak":true},{"text":"Yeca nimitztajtanía xiquinpinahualti,","poem":1},{"lineBreak":true},{"text":"huan xiquincuepalti para ayecmo ma nechchihuilica cati amo cuali.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xiquincuepa ica pinahualisti huan ayecmo xiquincahuili ma nechpinajtica.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pero nochi masehualme cati mitztemohuaj,","poem":1},{"lineBreak":true},{"text":"xiquinmaca miyac paquilisti.","poem":1},{"lineBreak":true},{"text":"Nochi cati paquij pampa tiquinmaquixtijtoc, ma quiijtoca:","poem":1},{"lineBreak":true},{"text":"“Ma tijhueyitalica Toteco Dios.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pero na cati tahuel nitaijyohuía,","poem":1},{"lineBreak":true},{"text":"nimitztajtanía xihuala nimantzi huan techmanahuiqui,","poem":1},{"lineBreak":true},{"text":"pampa san ta hueli techpalehuis huan techmaquixtis.","poem":1},{"lineBreak":true},{"text":"¡NoTeco Dios, amo xihuejcahua!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}