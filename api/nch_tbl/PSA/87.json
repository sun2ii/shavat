{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":87,"content":[{"type":"heading","content":["Nelía elis se hueyi paquilisti para cati ehuani altepet Jerusalén"]},{"type":"verse","number":1,"content":[{"text":"Altepet Jerusalén eltoc ipan nopa tepet tatzejtzeloltic cati iaxca Toteco.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Huan TOTECO quiicnelía Jerusalén achi más que nopa sequinoc pilaltepetzitzi ipan tali Israel.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Quena, Jerusalén eltoc ialtepe Toteco Dios,","poem":1},{"lineBreak":true},{"text":"huan quema masehualme quielnamiquij,","poem":1},{"lineBreak":true},{"text":"camanaltij nelcuajcualtzi ten nopa altepet.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Quema tatajco nohuampoyohua niquintocaxtía nopa talme cati inintoca Egipto, Babilonia, Filistea, Tiro huan Etiopía,","poem":1},{"lineBreak":true},{"text":"itztos se cati mohueyimatis pampa tacatqui ipan se ten nopa talme.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pero ajsis tonali quema masehualme quiselise más hueyi tatepanitacayot pampa tacatque ipan altepet Jerusalén,","poem":1},{"lineBreak":true},{"text":"pampa Toteco Cati Más Hueyi quitiochihuas ni altepet.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Huan TOTECO quiijcuilos inintoca nochi cati itztoque ipan nopa altepet.","poem":1},{"lineBreak":true},{"text":"Huan nochi cati tacatque nopona quintalilis se tanextili campa ijcuilijtos inintoca.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Huan quema ilhuichihuase inijuanti, huicase ica paquilisti huan quiijtose:","poem":1},{"lineBreak":true},{"text":"“Nochi noyolo nijtalijtoc ipan Jerusalén.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}