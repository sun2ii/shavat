{"translation":{"id":"nch_tbl","name":"Icamanal toteco; Santa Biblia","website":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nchBl","licenseNotes":null,"shortName":"TBL","englishName":"Huasteca Central Nahuatl Bible","language":"nch","textDirection":"ltr","sha256":"12a61ba7db68185c4e761ac4918e52a748f62b79b3267b0d2acc85dcb6a14d27","availableFormats":["json"],"listOfBooksApiLink":"/api/nch_tbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30813,"languageName":"Central Huasteca Nahuatl","languageEnglishName":"Central Huasteca Nahuatl"},"book":{"id":"PSA","translationId":"nch_tbl","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"71b9c7b533e6bea478909ef5bed20e3d7a74837ecce8641a80ae1140a7743806","firstChapterNumber":1,"firstChapterApiLink":"/api/nch_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nch_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":93,"content":[{"type":"heading","content":["Toteco tahuel hueyi"]},{"type":"verse","number":1,"content":[{"text":"¡TOTECO tanahuatía!","poem":1},{"lineBreak":true},{"text":"Yaya tahuel hueyi hasta quipiya itatanex cati tahuel cuajcualtzi.","poem":1},{"lineBreak":true},{"text":"Quitatzquilti nelcuali ni taltipacti,","poem":1},{"lineBreak":true},{"text":"huan amo hueli mojmolinis ten itatzinpehualtil.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nochipa hasta ten huejcajquiya ta tijpixtoc tanahuatili,","poem":1},{"lineBreak":true},{"text":"huan nochi cati itztoque ipan motanahuatilis itztoque temachme.","poem":1},{"lineBreak":true},{"text":"San ta tiitztoc para nochipa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"TOTECO, nopa hueyame caquisti para mitzpaquilismacaj quema mocoxoníaj.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pero ta, TOTECO, cati tiitztoc hasta huejcapa tijpiya más chicahualisti,","poem":1},{"lineBreak":true},{"text":"huan amo quej nopa at cati mocoxonía ipan nochi huejhueyi at ipan taltipacti.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Motanahuatilhua amo quema mopataj.","poem":1},{"lineBreak":true},{"text":"TOTECO, para nochi xihuit huan para nochi tonali motequiticayo eltoc senquisa tatzejtzeloltic.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nch_tbl/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nch_tbl/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nch_tbl/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}