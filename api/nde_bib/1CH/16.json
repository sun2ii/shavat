{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"1CH","translationId":"nde_bib","name":"1 ImiLando","commonName":"1 ImiLando","title":"Ugwalo Lwakuqala LwemiLando","order":13,"numberOfChapters":29,"sha256":"8a4aab5e45f6b41a4e3b4260b1e87fbd80d45b4642345f146a6e138363a8d071","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/nde_bib/1CH/29.json","totalNumberOfVerses":942},"chapter":{"number":16,"content":[{"type":"heading","content":["Ibhokisi Lesivumelwano SikaThixo Libekwa Ethenteni"]},{"type":"verse","number":1,"content":["Balithwala ibhokisi lesivumelwano sikaNkulunkulu bayalingenisa ethenteni uDavida ayelilungiselele lona, banikela ngeminikelo yokutshiswa leyobudlelwano phambi kukaNkulunkulu."]},{"type":"verse","number":2,"content":["UDavida eseqedile ukunikela ngeminikelo yokutshiswa langeyobudlelwano, wabusisa abantu ngebizo likaThixo."]},{"type":"verse","number":3,"content":["Wababela bonke abako-Israyeli, abesilisa labesifazane, yilowo lalowo isinkwa, lekhekhe lezithelo kanye lekhekhe lamavini awonyisiweyo."]},{"type":"verse","number":4,"content":["Wakhetha abanye abaLevi ukukhonza phambi kwebhokisi lesivumelwano sikaThixo bedumisa uThixo, bebonga uNkulunkulu ka-Israyeli:"]},{"type":"verse","number":5,"content":["Induna kwakungu-Asafi, uZakhariya engumsekeli, kulandela uJeyeli, loShemiramothi, loJehiyeli, loMathithiya, lo-Eliyabi, loBhenaya, lo-Obhedi-Edomi kanye loJeyiyeli. Babezatshaya amachacho lemihubhe, u-Asafi etshaya izigubhu,"]},{"type":"verse","number":6,"content":["abaphristi uBhenaya loJahaziyeli bengabokuvuthela amacilongo phambi kwebhokisi lesivumelwano sikaNkulunkulu."]},{"type":"heading","content":["Ihubo Lokubonga KukaDavida"]},{"type":"verse","number":7,"content":["Ngalolosuku uDavida wamisa ukuba u-Asafi labanye bakhe bahlabelele lelihubo bebonga uThixo:"]},{"type":"verse","number":8,"content":[{"text":"Bongani uThixo, memezani ibizo lakhe,","poem":1},{"text":"lizazise phakathi kwabantu izenzo zakhe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hlabelelani kuye, hlabelelani indumiso kuye;","poem":1},{"text":"likhulume ngezenzo zakhe zonke ezimangalisayo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jabulani ebizweni lakhe elingcwele;","poem":1},{"text":"kazithokoze inhliziyo zabo abamdingayo uThixo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dingani uThixo lamandla akhe,","poem":1},{"text":"limdinge yena njalonjalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Khumbulani izenzo zakhe ezimangalisayo azenzayo,","poem":1},{"text":"izimangaliso azenzayo, lezahlulelo azikhulumayo,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"lina zizukulwane zika-Israyeli inceku yakhe,","poem":1},{"text":"lina madodana kaJakhobe, abakhethiweyo bakhe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yena unguThixo uNkulunkulu wethu;","poem":1},{"text":"izahlulelo zakhe zigcwele wonke umhlaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Uyakhumbula isivumelwano sakhe nini lanini,","poem":1},{"text":"ilizwi lomlayo wakhe, okwezizukulwane ezizinkulungwane,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"isivumelwano asenza lo-Abhrahama,","poem":1},{"text":"isifungo asenza lo-Isaka,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"wasiqinisa kuJakhobe saba yisimiso,","poem":1},{"text":"laku-Israyeli saba yisivumelwano esingapheliyo,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"wathi “Ngizalinika ilizwe laseKhenani","poem":1},{"text":"njengesabelo selifa lenu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kwathi lisesebalutshwana,","poem":1},{"text":"bebalutshwana kakhulu, beyizihambi kulo,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"bezula kuzizwe ngezizwe","poem":1},{"text":"besuka komunye umbuso besiya komunye.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kavumelanga loba ngubani ukubancindezela;","poem":1},{"text":"wawakhuza amakhosi ngenxa yabo,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“Lingabathinti abagcotshiweyo bami;","poem":1},{"text":"lingahlukuluzi abaphrofethi bami.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Hlabelani kuThixo lina, mhlaba wonke,","poem":1},{"text":"limemezele insindiso yakhe insuku ngezinsuku.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Fakazani ngobukhosi bakhe ezizweni zonke,","poem":1},{"text":"lemisebenzi yakhe emangalisayo phakathi kwabantu bonke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ngoba umkhulu uThixo, ufanele ukudunyiswa ngokuphindiweyo;","poem":1},{"text":"kumele esatshwe ngaphezu kwabonkulunkulu bonke.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ngoba bonke onkulunkulu bezizwe bayizithombe;","poem":1},{"text":"kodwa uThixo wadala amazulu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Inkazimulo lobukhosi kuphambi Kwakhe","poem":1},{"text":"Amandla lentokozo kusendaweni yakhe yokuhlala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Mnikeni uThixo, lina zizukulwane zezizwe.","poem":1},{"text":"Mnikeni uThixo ubukhosi lamandla.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Mnikeni uThixo udumo olufanele ibizo lakhe.","poem":1},{"text":"Lethani umnikelo libuye phambi kwakhe.","poem":2},{"text":"Mkhonzeni uThixo enkazimulweni yobungcwele bakhe;","poem":1}]},{"type":"verse","number":30,"content":[{"text":"thuthumelani phambi kwakhe mhlaba wonke!","poem":2},{"lineBreak":true},{"text":"Umhlaba ugxilile, ngeke ugudluzwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Amazulu kawathokoze, lomhlaba ujabule,","poem":1},{"text":"kabathi phakathi kwabezizwe, “UThixo uyabusa.”","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ulwandle kaluhlokome lakho konke okukulo,","poem":1},{"text":"amasimu kawathakazelele lakho konke okukuwo.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Lapho-ke izihlahla zonke zeganga zizahlabela","poem":1},{"text":"ngentokozo phambi kukaThixo,","poem":2},{"lineBreak":true},{"text":"ngoba uyeza ukuzakwahlulela umhlaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Bongani uThixo ngoba ulungile.","poem":1},{"text":"Uthando lwakhe olungapheliyo lumi kokuphela.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Celani lithi: “Sisindise, Oh Nkulunkulu Mkhululi wethu,","poem":1},{"text":"usiqoqe usikhulule phakathi kwezizwe,","poem":2},{"text":"ukuze silibonge ibizo lakho elingcwele,","poem":1},{"text":"sijabule ekukudumiseni.”","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Kabongwe uThixo, uNkulunkulu ka-Israyeli,","poem":1},{"text":"kusukela endulo kuze kube nininini.","poem":2},"Bonke abantu bathi: “Ameni. Kabongwe uThixo!”"]},{"type":"line_break"},{"type":"verse","number":37,"content":["UDavida wasetshiya o-Asafi labakhula bakhe ukuba bagcine ibhokisi lesivumelwano sikaThixo, bakhonze njalo benze konke okufanele kwenziwe lapho ngezinsuku zonke."]},{"type":"verse","number":38,"content":["Abanye abatshiya lapho ukuze bakhonze labo ngo-Obhedi-Edomi labakhula bakhe, ababengamatshumi ayisithupha lasificaminwembili. U-Obhedi-Edomi indodana kaJeduthuni, kanye loHosa babengabalindi bamasango."]},{"type":"verse","number":39,"content":["UDavida watshiya uZadokhi umphristi kanye labanye abaphristi phambi kwethabanikeli likaThixo endaweni ephakemeyo yokukhonzela eGibhiyoni"]},{"type":"verse","number":40,"content":["ukunikela kuThixo iminikelo yokutshiswa e-alithareni ngezikhathi zonke, ekuseni lantambama, njengokulotshiweyo eMthethweni kaThixo, awupha abako-Israyeli."]},{"type":"verse","number":41,"content":["Abanye abasala labo babengoHemani loJeduthuni labanye bonke balabo ababekhethiwe beqanjwa ngamabizo ukuba badumise uThixo, “ngoba uthando lwakhe lumi kuze kube nininini.”"]},{"type":"verse","number":42,"content":["UHemani loJeduthuni babengabokuvuthela amacilongo lokutshaya izigubhu lamanye amachacho ezingoma ezingcwele. Amadodana kaJeduthuni ayehlala esangweni."]},{"type":"verse","number":43,"content":["Abanye bonke basuka, ngulowo lalowo waqonda emzini wakhe, uDavida wabuyela emzini wakhe ukuyabusisa abendlu yakhe."]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/1CH/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/1CH/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/1CH/15.json","previousChapterAudioLinks":{},"numberOfVerses":43}