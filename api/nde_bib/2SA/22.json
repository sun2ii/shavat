{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"2SA","translationId":"nde_bib","name":"2 USamuyeli","commonName":"2 USamuyeli","title":"Ugwalo Lwesibili LukaSamuyeli","order":10,"numberOfChapters":24,"sha256":"c5d3d0cb9601ba2d0cbf06992aaa6d2fa8c5816b3e86a5cfe202a2bd190a8aeb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/nde_bib/2SA/24.json","totalNumberOfVerses":695},"chapter":{"number":22,"content":[{"type":"heading","content":["Ihubo LikaDavida Lokudumisa"]},{"type":"verse","number":1,"content":["UDavida wahlabelela uThixo amazwi alelihubo lapho uThixo wamsindisa esandleni sezitha zakhe zonke lasesandleni sikaSawuli."]},{"type":"verse","number":2,"content":["Wathi:",{"text":"“UThixo ulidwala lami, inqaba yami lomsindisi wami;","poem":1}]},{"type":"verse","number":3,"content":[{"text":"uNkulunkulu wami ulidwala lami, lapho engiphephela khona,","poem":2},{"lineBreak":true},{"text":"isihlangu sami lophondo lokusindiswa kwami.","poem":2},{"text":"Uyinqaba yami, isiphephelo sami lomsindisi wami","poem":1},{"text":"uyangisindisa ebantwini abalodlakela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ngakhuleka kuThixo ofanele ukudunyiswa,","poem":1},{"text":"njalo ngikhululwe ezitheni zami.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Amagagasi okufa angikhulela;","poem":1},{"text":"lezikhukhula zokubhubhisa zangikhulela.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Izibopho zengcwaba zangithandela;","poem":1},{"text":"imijibila yokufa yangijamela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ekukhathazekeni kwami ngakhuleka kuThixo;","poem":1},{"text":"ngakhala kuNkulunkulu wami.","poem":2},{"text":"Esethempelini lakhe walizwa ilizwi lami;","poem":1},{"text":"ukukhala kwami kwafika ezindlebeni zakhe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Umhlaba wagedezela wazamazama,","poem":1},{"text":"izisekelo zamazulu zanyikinyeka;","poem":2},{"lineBreak":true},{"text":"zagedezela ngoba wayethukuthele.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Intuthu yalanquka emakhaleni akhe;","poem":1},{"text":"umlilo ohangulayo waphuma emlonyeni wakhe,","poem":2},{"lineBreak":true},{"text":"amalahle avuthayo alavuka ephuma kuwo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Waqhekeza amazulu wehlela phansi;","poem":1},{"text":"amayezi amnyama ayengaphansi kwezinyawo zakhe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wagada amakherubhi waphapha;","poem":1},{"text":"wantweza phezu kwamaphiko omoya.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wenza umnyama isigubuzelo esimhanqileyo,","poem":1},{"text":"amayezi ezulu amnyama asemkhathini.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Phakathi kokukhazimula kobukhona bakhe,","poem":1},{"text":"izikhatha zombane zalavuza khona.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"UThixo wakhwaza esezulwini;","poem":1},{"text":"ilizwi loPhezukonke lanqenqetha.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Waciba imitshoko wazihlakaza izitha,","poem":1},{"text":"ngezikhatha zombane waziqothula.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Izigodi zolwandle zambulwa","poem":1},{"text":"lezisekelo zomhlaba zavezwa obala","poem":2},{"text":"ekukhuzeni kukaThixo,","poem":1},{"text":"ngomfutho wokuphefumula kwamakhala akhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Welula isandla sakho usezulwini wangibamba","poem":1},{"text":"wangihlenga enzikini yamanzi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wangihlenga esitheni sami esilamandla,","poem":1},{"text":"ezitheni zami ezazingigabhela ngamandla.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Zangijamela mhla ngisebunzimeni,","poem":1},{"text":"kodwa uThixo waba yinsika yami.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wangikhupha wangibeka endaweni ebanzi;","poem":1},{"text":"wangihlenga ngoba wayethokoza ngami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"UThixo ungenzele okulingene ukulunga kwami;","poem":1},{"text":"wangivuza ngokufanele ukuhlanzeka kwezandla zami.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ngoba ngizigcinile izindlela zikaThixo;","poem":1},{"text":"angenzanga okubi ngokufulathela uNkulunkulu wami.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yonke imithetho yakhe iphambi kwami;","poem":1},{"text":"angizifulathelanga izimiso zakhe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ngibe ngilokhu ngimsulwa phambi kwakhe","poem":1},{"text":"njalo ngisixwayile isono.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"UThixo ungivuze ngokufanele ukulunga kwami;","poem":1},{"text":"ngokufanele ukuhlanzeka kwami phambi kwakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Kwabathembekileyo lawe uthembekile,","poem":1},{"text":"kwabamsulwa lawe umsulwa,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"kwabahlanzekileyo uziveza uhlanzekile,","poem":1},{"text":"kodwa kwabangaqondanga uziveza ukhaliphile.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Uyabasindisa abathobekileyo;","poem":1},{"text":"kodwa amehlo akho akhangele abazigqajayo ukuba ubehlisele phansi.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Uyisibane sami, Oh Thixo,","poem":1},{"text":"uThixo uguqula ubumnyama bami bube yikukhanya.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ngosizo lwakho ngingaphuma ngimelane lebutho lempi,","poem":1},{"text":"ngoNkulunkulu wami ngingawukhwela umduli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Izindlela zikaNkulunkulu uqobo lwakhe ziphelele;","poem":1},{"text":"ilizwi likaThixo kalilasici.","poem":2},{"lineBreak":true},{"text":"Ulihawu labo bonke abaphephela kuye.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ngoba ngubani uNkulunkulu ngaphandle kukaThixo?","poem":1},{"text":"Njalo ngubani oliDwala ngaphandle kukaNkulunkulu wethu na?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"NguNkulunkulu ongihlomisa amandla","poem":1},{"text":"enze indlela yami iphelele.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Wenza inyawo zami zibe njengezempala;","poem":1},{"text":"ungenza ngime ezingqongweni.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ufundisa izandla zami ukulwa impi,","poem":1},{"text":"izingalo zami zingaligobisa idandili lethusi.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Uyanginika isihlangu sakho sokunqoba;","poem":1},{"text":"uyazehlisela phansi ukuze ungenze ngibe mkhulu.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Uqhelisa indlela enginyathela kuyo,","poem":1},{"text":"ukuze inqagala zami zingapheci.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"Ngaxotshana lezitha zami ngaziqothula;","poem":1},{"text":"kangibuyanga ngingakazibhubhisi zonke.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Ngaziqothula okupheleleyo, njalo zazingeke zisavuka;","poem":1},{"text":"zawela ngaphansi kwezinyawo zami.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Wangihlomisa ngamandla okulwa impi;","poem":1},{"text":"wenza abaxabana lami bakhothama ezinyaweni zami.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Wenza izitha zami zafulathela zabaleka,","poem":1},{"text":"njalo ngazibhubhisa izitha zami.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Bakhala becela uncedo, kodwa wayengekho owayengabahlenga","poem":1},{"text":"kuThixo, kodwa kaphendulanga.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Ngabatshaya bacholeka njengothuli lomhlabathi;","poem":1},{"text":"ngabagxoba ngabanyathela njengodaka ezindleleni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"Ungikhulule ekuhlaselweni yilababantu;","poem":1},{"text":"ungigcine ngiyinhloko yezizwe.","poem":2},{"text":"Abantu engangingabazi sebebuswa yimi,","poem":1}]},{"type":"verse","number":45,"content":[{"text":"abezizweni bayatshotshobala phambi kwami;","poem":2},{"lineBreak":true},{"text":"bathi bengizwa nje ngendaba, bangilalele.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Bonke badelile;","poem":1},{"text":"beza bethuthumela bevela ezinqabeni zabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"UThixo uyaphila! Alidunyiswe iDwala lami!","poem":1},{"text":"Kaphakanyiswe uNkulunkulu wami, iDwala, uMsindisi wami!","poem":2}]},{"type":"verse","number":48,"content":[{"text":"UnguNkulunkulu ongiphindiselelayo,","poem":1},{"text":"obeka izizwe ngaphansi kwami,","poem":2}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"ongikhululayo ezitheni zami.","poem":2},{"text":"Wena wangiphakamisela ngaphezu kwezitha zami;","poem":1},{"text":"wangihlenga ebantwini bodlakela.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Ngakho ngizakudumisa, Oh Thixo, phakathi kwezizwe;","poem":1},{"text":"ngizahlabelela indumiso yebizo lakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"Unika inkosi yakhe ukunqoba okukhulu;","poem":1},{"text":"ubonakalisa umusa wakhe ongapheliyo kogcotshiweyo wakhe,","poem":2},{"lineBreak":true},{"text":"kuDavida lenzalo yakhe kuze kube phakade.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}