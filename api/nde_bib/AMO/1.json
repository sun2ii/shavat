,{"type":"verse","number":4,"content":[{"text":"ngizathumela umlilo endlini kaHazayeli","poem":1},{"text":"ozalobisa izinqaba zikaBheni-Hadadi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngizabhidliza isango laseDamaseko;","poem":1},{"text":"ngizachitha inkosi ephakathi kweSigodi sase-Aveni","poem":2},{"text":"lalowo ophethe intonga yobukhosi eBhethi Edeni.","poem":1},{"text":"Abantu base-Aramu bazathunjwa","poem":2},{"lineBreak":true},{"text":"basiwe eKhiri,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":6,"content":["Nanku okutshiwo nguThixo:",{"text":"“Ngenxa yezono ezintathu zeGaza","poem":1},{"text":"loba ngenxa yezine,","poem":2},{"lineBreak":true},{"text":"kangiyikulunqanda ulaka lwami","poem":2},{"text":"ngenxa yokuthi yathumba abantu bezigaba zonke","poem":1},{"text":"yabathengisa e-Edomi,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ngizathumela umlilo emidulini yaseGaza","poem":1},{"text":"ozalobisa izinqaba zayo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngizayichitha inkosi yase-Ashidodi","poem":1},{"text":"kanye lalowo ophatha intonga yobukhosi e-Ashikheloni.","poem":2},{"text":"Ngizaphendulela isandla sami ekuhlaseleni i-Ekroni","poem":1},{"text":"kuze kufe umFilistiya wokucina,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo Wobukhosi.","poem":2}]},{"type":"verse","number":9,"content":["Nanku okutshiwo nguThixo:",{"text":"“Ngenxa yezono ezintathu zaseThire","poem":1},{"text":"loba ngenxa yezine, kangiyikulunqanda ulaka lwami.","poem":2},{"text":"Ngenxa yokuthi yabathengisela e-Edomi","poem":1},{"text":"bonke abantu bezigaba zonke ezathunjwayo","poem":2},{"lineBreak":true},{"text":"inganaki isivumelwano sobuzalwane,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ngizathumela umlilo emidulini yaseThire","poem":1},{"text":"ozalobisa izinqaba zayo.”","poem":2}]},{"type":"verse","number":11,"content":["Nanku okutshiwo nguThixo:",{"text":"“Ngenxa yezono ezintathu zase-Edomi","poem":1},{"text":"loba ngenxa yezine, kangiyikulunqanda ulaka lwami.","poem":2},{"text":"Ngenxa yokuthi waxotshana lomfowabo ngenkemba,","poem":1},{"text":"enqabela isihawu sonke,","poem":2},{"text":"ngoba ulaka lwakhe lwavutha kokuphela","poem":1},{"text":"lentukuthelo yakhe yabhebha ingelakuthitshwa,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ngizathumela umlilo eThemani","poem":1},{"text":"ozalobisa izinqaba zaseBhozira.”","poem":2}]},{"type":"verse","number":13,"content":["Nanku okutshiwo nguThixo:",{"text":"“Ngenxa yezono ezintathu zase-Amoni, loba langenxa yezine,","poem":1},{"text":"kangiyikulunqanda ulaka lwami.","poem":2},{"text":"Ngenxa yokuthi waqhaqha abesifazane abazithweleyo baseGiliyadi","poem":1},{"text":"ukuze aqhelise ilizwe lakhe,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ngizathungela imiduli yaseRaba ngomlilo","poem":1},{"text":"ozalobisa izinqaba zayo","poem":2},{"text":"kumenyezelwa izitsho zempi ngosuku lokulwa","poem":1},{"text":"kulomoya olamandla ngosuku lwesiphepho.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Inkosi yalo izathunjwa,","poem":1},{"text":"yona kanye lezikhulu zayo,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}