","poem":2},{"text":"ngoba bawalile umthetho kaThixo","poem":1},{"text":"kabaze bagcina lezimiso zakhe,","poem":2},{"text":"ngoba badukiswe ngonkulunkulu bamanga,","poem":1},{"text":"onkulunkulu abalandelwa ngokhokho babo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngizathumela umlilo koJuda","poem":1},{"text":"ozalobisa izinqaba zaseJerusalema.”","poem":2}]},{"type":"heading","content":["Ukwahlulelwa Kuka-Israyeli"]},{"type":"verse","number":6,"content":["Nanku okutshiwo nguThixo:",{"text":"“Ngenxa yezono ezintathu zika-Israyeli","poem":1},{"text":"loba ngenxa yezine, kangiyikulunqanda ulaka lwami","poem":2},{"text":"ngoba bathengisa abalungileyo ngesiliva,","poem":1},{"text":"labaswelayo ngamanyathelo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Banyathela phezu kwamakhanda abayanga","poem":1},{"text":"njengaphezu kothuli lomhlabathi","poem":2},{"lineBreak":true},{"text":"banqabele imfanelo yabancindezelweyo.","poem":2},{"text":"Uyise lendodana bembatha lentombi yinye","poem":1},{"text":"kanjalo bangcolise ibizo lami elingcwele.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bacambalala phansi emaceleni ama-alithare wonke,","poem":1},{"text":"phezu kwezembatho ezithethwe ziyizibambiso.","poem":2},{"text":"Endlini kankulunkulu wabo","poem":1},{"text":"banatha iwayini elithethwe njengenhlawulo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ngachitha umʼAmori phambi kwabo,","poem":1},{"text":"lanxa wayemude njengemisedari","poem":2},{"lineBreak":true},{"text":"njalo eqine njengomʼokhi.","poem":2},{"text":"Ngachitha izithelo zakhe phezulu","poem":1},{"text":"kanye lempande zakhe ngaphansi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngalikhupha eGibhithe","poem":1},{"text":"ngalikhokhela iminyaka engamatshumi amane enkangala","poem":2},{"lineBreak":true},{"text":"ukuba ngilinike ilizwe lama-Amori.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ngakhupha labaphrofethi bephuma phakathi kwamadodana enu,","poem":1},{"text":"kanye lamaNaziri ephuma phakathi kwezinsizwa zenu.","poem":2},{"text":"Lokhu akuqotho na, bantu bako-Israyeli?”","poem":1},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Kodwa lanathisa amaNaziri iwayini,","poem":1},{"text":"lalaya abaphrofethi ukuba bangaphrofethi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Khathesi-ke mina ngizalichoboza","poem":1},{"text":"njengokuchoboza kwenqola ithwele amabele.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Olejubane kayikubaleka,","poem":1},{"text":"oqinileyo uzawaswela amandla akhe,","poem":2},{"lineBreak":true},{"text":"lebutho kaliyikusindisa impilo yalo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Umtshoki akayikugxila,","poem":1},{"text":"ibutho elilejubane kaliyikuphunyuka","poem":2},{"lineBreak":true},{"text":"lomgadi webhiza kayikusindisa impilo yakhe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Lebutho elilesibindi kakhulu,","poem":1},{"text":"ngalolosuku lizabaleka linqunu,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}