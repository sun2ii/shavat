{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"AMO","translationId":"nde_bib","name":"U-Amosi","commonName":"U-Amosi","title":"U-Amosi","order":30,"numberOfChapters":9,"sha256":"1fde47fe81068f0ae74184fb789183317ff219492f3636d339a94aa15ea772d5","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/nde_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"heading","content":["Ofakazi Bokumelana Lo-Israyeli"]},{"type":"verse","number":1,"content":["Zwanini ilizwi elikhulunywe nguThixo ngani lina bantu bako-Israyeli Lomndeni wonke engawukhupha eGibhithe:"]},{"type":"verse","number":2,"content":[{"text":"“Yini kuphela engalikhethayo","poem":1},{"text":"kuyo yonke imideni yasemhlabeni;","poem":2},{"text":"ngakho ngizalijezisela","poem":1},{"text":"zonke izono zenu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ababili bayahamba bendawonye","poem":1},{"text":"ngaphandle kokuba bevumelene ukwenzanjalo na?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Isilwane siyabhonga ehlathini","poem":1},{"text":"kungelalutho esingalubamba na?","poem":2},{"text":"Siyabhonga esikhundleni saso","poem":1},{"text":"singabambanga lutho na?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inyoni iyabanjwa emhlabathini","poem":1},{"text":"okungelamjibila othiywe khona na?","poem":2},{"text":"Umjibila uyathanca usuke emhlabathini","poem":1},{"text":"kungelalutho olubambayo na?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lapho icilongo likhala edolobheni","poem":1},{"text":"abantu kabethuki na?","poem":2},{"text":"Lapho incithakalo isehlela idolobho","poem":1},{"text":"kayenziwanga nguThixo na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Impela uThixo Wobukhosi kenzi lutho","poem":1},{"text":"engavezanga icebo","poem":2},{"lineBreak":true},{"text":"lakhe ezincekwini zakhe abaphrofethi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Isilwane sibhongile,","poem":1},{"text":"ngubani ongayikwesaba na?","poem":2},{"text":"UThixo Wobukhosi usekhulumile","poem":1},{"text":"ngubani ongayekela ukuphrofitha na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Memezelani ezinqabeni zase-Ashidodi","poem":1},{"text":"lasezinqabeni zaseGibhithe lithi:","poem":2},{"text":"“Buthanani phezu kwezintaba zaseSamariya;","poem":1},{"text":"libone isiyaluyalu esikhulu phakathi kwayo","poem":2},{"lineBreak":true},{"text":"lokuncindezela phakathi kwabantu bayo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Kabakwazi ukwenza okulungileyo,” kutsho uThixo,","poem":1},{"text":"“bona ababuthelela impango","poem":2},{"lineBreak":true},{"text":"baphange lasezinqabeni zabo.”","poem":2}]},{"type":"verse","number":11,"content":["Ngakho uThixo Wobukhosi uthi:",{"text":"“Isitha sizachitha ilizwe;","poem":1},{"text":"sizadiliza izinqaba zenu,","poem":2},{"lineBreak":true},{"text":"siphange izinqaba zenu.”","poem":2}]},{"type":"verse","number":12,"content":["Nanku okutshiwo nguThixo:",{"text":"“Njengomelusi ehlenga emlonyeni wesilwane","poem":1},{"text":"amathambo amabili kuphela omlenze loba isiqa sendlebe,","poem":2},{"text":"bazahlengwa kanjalo abako-Israyeli abahlala eSamariya","poem":1},{"text":"bethithibele ekucineni kwemibheda yabo,","poem":2},{"lineBreak":true},{"text":"kanye laseDamaseko phezu kwemibheda yabo yokuphumulela.”","poem":2}]},{"type":"verse","number":13,"content":["“Zwanini lokhu lifakaze ngendlu kaJakhobe,” kutsho iNkosi, uThixo uNkulunkulu uSomandla."]},{"type":"verse","number":14,"content":[{"text":"“Ngosuku engizajezisela u-Israyeli izono zakhe","poem":1},{"text":"ngizabhidliza ama-alithare aseBhetheli;","poem":2},{"text":"impondo ze-alithare zizaqunywa","poem":1},{"text":"ziwele emhlabathini.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngizadiliza indlu yebusika kanye","poem":1},{"text":"lendlu yehlobo,","poem":2},{"text":"izindlu eziceciswe ngempondo zendlovu zizadilizwa","poem":1},{"text":"lezindlu ezinkulu zizabhidlizwa,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}