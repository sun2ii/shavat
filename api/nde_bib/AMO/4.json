{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"AMO","translationId":"nde_bib","name":"U-Amosi","commonName":"U-Amosi","title":"U-Amosi","order":30,"numberOfChapters":9,"sha256":"1fde47fe81068f0ae74184fb789183317ff219492f3636d339a94aa15ea772d5","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/nde_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":4,"content":[{"type":"heading","content":["U-Israyeli Kakabuyeli KuNkulunkulu"]},{"type":"verse","number":1,"content":[{"text":"Zwanini ilizwi leli lina mankomokazi aseBhashani phezu kweNtaba iSamariya,","poem":1},{"text":"lina besifazane elincindezela abayanga lichoboze abaswelayo","poem":2},{"lineBreak":true},{"text":"beselisithi kubomkenu, “Siletheleni okunathwayo!”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"UThixo Wobukhosi usefunge ngobungcwele bakhe wathi:","poem":1},{"text":"“Isikhathi sizafika impela","poem":2},{"text":"lapho elizathathwa khona ngewuka,","poem":1},{"text":"owokucina wenu ngewuka yenhlanzi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lizaphuma ngamunye","poem":1},{"text":"ngezikhala emdulini liqonde nta phandle,","poem":2},{"text":"njalo lizalahlelwa ngaphandle ngokuya eHamoni,”","poem":1},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Hambani eBhetheli liyekwenza isono;","poem":1},{"text":"hambani eGiligali liyekwenza isono ngokudlulayo.","poem":2},{"text":"Lethani imihlatshelo yenu nsuku zonke ekuseni","poem":1},{"text":"lokwetshumi kwenu minyaka yonke emithathu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tshisani isinkwa esilemvubelo njengomnikelo wokubonga","poem":1},{"text":"lintele ngeminikelo yenu yokuzithandela","poem":2},{"text":"lizikhukhumeze ngayo, lina bako-Israyeli,","poem":1},{"text":"ngoba lokhu yikho elithanda ukukwenza,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo Wobukhosi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Ngalilethela indlala emadolobheni wonke","poem":1},{"text":"lokusweleka kokudla emadolobheni wonke,","poem":2},{"text":"kodwa kalibuyelanga kimi,”","poem":1},{"text":"kutsho uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ngagodla izulu futhi","poem":1},{"text":"kusasele inyanga ezintathu ukuba kuvunwe.","poem":2},{"text":"Izulu ngalinisa kwelinye idolobho","poem":1},{"text":"kodwa ngaligodla kwelinye.","poem":2},{"text":"Enye insimu yaba lezulu,","poem":1},{"text":"enye kayaze yaba lalo njalo yoma qha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abantu babhadazela besuka kwelinye idolobho besiya kwelinye befuna amanzi","poem":1},{"text":"kodwa kabawatholanga anele ukuba bakholwe,","poem":2},{"text":"ikanti kalibuyelanga kimi,”","poem":1},{"text":"kutsho uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ezikhathini ezinengi ngahlasela izivande zenu lezivini zenu,","poem":1},{"text":"ngizihlasela ngesona langengumane.","poem":2},{"text":"Izintethe zadla imikhiwa yenu lezihlahla zenu zama-oliva,","poem":1},{"text":"kodwa kalibuyelanga kimi,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Ngathumela izifo phakathi kwenu","poem":1},{"text":"njengengakwenza kweleGibhithe.","poem":2},{"text":"Ngabulala izinsizwa zenu ngenkemba","poem":1},{"text":"ndawonye lamabhiza enu athunjwayo.","poem":2},{"text":"Ngavimbanisa amakhala enu ngomnuko wezihonqo zenu,","poem":1},{"text":"kodwa kalibuyelanga kimi,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ngachitha abanye benu","poem":1},{"text":"njengalokhu ngachitha iSodoma leGomora.","poem":2},{"text":"Lalinjengesikhuni esitshayo esihluthunwe emlilweni,","poem":1},{"text":"kodwa kalibuyelanga kimi,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Ngakho-ke engizakwenza kuwe Israyeli yilokhu,","poem":1},{"text":"njalo njengoba lokhu ngizakwenza kuwe,","poem":2},{"lineBreak":true},{"text":"zilungisele ukuhlangana loNkulunkulu wakho, wena Israyeli.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yena obumba izintaba,","poem":1},{"text":"udala umoya,","poem":2},{"lineBreak":true},{"text":"aveze lemicabango yakhe ebantwini,","poem":2},{"text":"yena oguqula ukusa kube ngumnyama,","poem":1},{"text":"anyathele lezindawo eziphakemeyo zomhlaba,","poem":2},{"lineBreak":true},{"text":"uThixo uNkulunkulu uSomandla yilo ibizo lakhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}