{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"AMO","translationId":"nde_bib","name":"U-Amosi","commonName":"U-Amosi","title":"U-Amosi","order":30,"numberOfChapters":9,"sha256":"1fde47fe81068f0ae74184fb789183317ff219492f3636d339a94aa15ea772d5","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/nde_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["Isililo Lesimemezelo Sokuphenduka"]},{"type":"verse","number":1,"content":["Zwana ilizwi leli, wena ndlu ka-Israyeli, isililo lesi engisenzayo ngani:"]},{"type":"verse","number":2,"content":[{"text":"“Iwile iNtombi u-Israyeli,","poem":1},{"text":"kayiphindi ivuke futhi,","poem":2},{"text":"ideliwe elizweni layo,","poem":1},{"text":"kungekho ongayiphakamisela phezulu.”","poem":2}]},{"type":"verse","number":3,"content":["Nanku okutshiwo nguThixo Wobukhosi:",{"text":"“Idolobho lenu elikhupha inkulungwane eziqinileyo","poem":1},{"text":"lizasala labalikhulu kuphela;","poem":2},{"text":"idolobho elikhupha abalikhulu abaqinileyo lizasala","poem":1},{"text":"labalitshumi kuphela.”","poem":2}]},{"type":"verse","number":4,"content":["Nanku okutshiwo nguThixo endlini ka-Israyeli:",{"text":"“Dingani mina, liphile;","poem":1}]},{"type":"verse","number":5,"content":[{"text":"lingadingi iBhetheli,","poem":2},{"text":"lingayi eGiligali,","poem":1},{"text":"lingayi eBherishebha.","poem":2},{"text":"Ngoba impela iGiligali izakuya ekuthunjweni,","poem":1},{"text":"leBhetheli izadliwa iphele nya.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dingani uThixo liphile","poem":1},{"text":"hlezi adabule phakathi kwendlu kaJosefa njengomlilo;","poem":2},{"text":"uzatshisa uqothule,","poem":1},{"text":"njalo iBhetheli kayiyikuba lomuntu ozawucitsha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lina eliguqula ukulunga kube yibuhlungu,","poem":1},{"text":"lilahlele ubuqotho emhlabathini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yena owenza iSilimela loMthala,","poem":1},{"text":"oguqula umnyama ube yikusa","poem":2},{"lineBreak":true},{"text":"enze imini ibe yibusuku obumnyama,","poem":2},{"text":"yena obiza amanzi olwandle,","poem":1},{"text":"awathele phezu kobuso belizwe,","poem":2},{"lineBreak":true},{"text":"uThixo yilo ibizo lakhe,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"wehlisela incithakalo phezu kwenqaba atshabalalise","poem":1},{"text":"idolobho elivikelweyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Liyamzonda okhuzayo emthethwandaba limeyise","poem":1},{"text":"lalowo okhuluma iqiniso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Linyathezela umyanga limncindezele","poem":1},{"text":"ukuba aliphe amabele.","poem":2},{"text":"Ngakho-ke, lanxa lakhe izindlu ezinkulukazi zamatshe","poem":1},{"text":"kaliyikuhlala kuzo;","poem":2},{"text":"lanxa lihlanyele izivini ezinhle,","poem":1},{"text":"iwayini lazo kaliyikulinatha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngoba iziphambeko zenu ngiyazazi ukuthi zingaki","poem":1},{"text":"kanye lokuthi izono zenu zinkulu okunganani.","poem":2},{"lineBreak":true},{"text":"Lincindezela abalungileyo lamukele isivalamlomo,","poem":1},{"text":"njalo emithethwandaba linqabela abayanga imfanelo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngakho ezikhathini ezinjalo umuntu ohlakaniphileyo uyazithulela,","poem":1},{"text":"ngoba izikhathi zimbi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dingani okuhle, hatshi okubi,","poem":1},{"text":"ukuze liphile.","poem":2},{"text":"Lapho-ke uThixo uNkulunkulu uSomandla uzakuba lani","poem":1},{"text":"njengoba lisithi ulani.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Zondani okubi lithande okuhle;","poem":1},{"text":"qinisani ukulunga emithethwandaba.","poem":2},{"text":"Mhlawumbe uThixo uNkulunkulu uSomandla uzakuba lomusa","poem":1},{"text":"kuzinsalela zakoJosefa.","poem":2}]},{"type":"verse","number":16,"content":["Ngakho nanku okutshiwo yiNkosi, uThixo, uNkulunkulu uSomandla,",{"text":"“Kuzakuba lokulila emigwaqweni yonke","poem":1},{"text":"lokukhala kabuhlungu ezinkundleni zonke zikazulu.","poem":2},{"text":"Abalimi bazabizwa ukuba bakhale,","poem":1},{"text":"labakhalayo ukuba balile.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kuzakuba lokulila ezivinini zonke,","poem":1},{"text":"ngoba ngizadlula phakathi kwenu,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"heading","content":["Usuku LukaThixo"]},{"type":"verse","number":18,"content":[{"text":"Maye kini lina elilangazelela","poem":1},{"text":"usuku lukaThixo!","poem":2},{"text":"Kungani lilangazelela lolosuku lukaThixo na?","poem":1},{"text":"Lolosuku luzakuba ngumnyama, hatshi ukukhanya.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kuzafana lokuthi umuntu ubalekele isilwane","poem":1},{"text":"wahlangana lebhele,","poem":2},{"text":"njengangathi ungene endlini yakhe","poem":1},{"text":"wabambelela emdulini ngesandla","poem":2},{"lineBreak":true},{"text":"waselunywa yinyoka.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Usuku lukaThixo kaluyikuba ngumnyama na,","poem":1},{"text":"hatshi ukukhanya,","poem":2},{"lineBreak":true},{"text":"lumnyama bhuqe, kungekho nhlansi yokukhanya?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Ngiyayizonda, ngiyayeyisa imikhosi yokholo lwenu;","poem":1},{"text":"angingeke ngiyimele imbuthano yenu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Lanxa lingangilethela iminikelo yokutshiswa leminikelo","poem":1},{"text":"yamabele kangiyikuyamukela.","poem":2},{"text":"Lanxa liletha iminikelo emihle kakhulu yobuzalwane,","poem":1},{"text":"lokunonisiweyo kangiyikuyinanza.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Sukani lomsindo wezingoma zenu!","poem":1},{"text":"Kangiyikuwulalela umculo wamachacho enu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kodwa ukulunga kakugeleze njengamanzi,","poem":1},{"text":"lobuqotho njengesifula esingatshiyo!","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Kanje wake wangilethela imihlatshelo leminikelo","poem":1},{"text":"eminyakeni engamatshumi amane enkangala,","poem":2},{"lineBreak":true},{"text":"wena ndlu ka-Israyeli na?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Seliphakamise indawo yokukhonzela izithombe zenu,","poem":1},{"text":"isenabelo senkosi unkulunkulu wenu uSakhuthi,","poem":2},{"lineBreak":true},{"text":"lenkanyezi kankulunkulu wenu uKhayiwani,","poem":2},{"lineBreak":true},{"text":"elazenzela khona lina ngokwenu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ngakho ngizalisa ekuthunjweni ngale kweDamaseko,”","poem":1},{"text":"kutsho uThixo obizo lakhe nguNkulunkulu uSomandla.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}