{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"AMO","translationId":"nde_bib","name":"U-Amosi","commonName":"U-Amosi","title":"U-Amosi","order":30,"numberOfChapters":9,"sha256":"1fde47fe81068f0ae74184fb789183317ff219492f3636d339a94aa15ea772d5","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/nde_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":6,"content":[{"type":"heading","content":["Maye Kulabo Abangakhathaliyo"]},{"type":"verse","number":1,"content":[{"text":"Maye kini lina elingakhathaliyo eZiyoni,","poem":1},{"text":"lakini elizizwa livikelekile eNtabeni iSamariya,","poem":2},{"text":"lina madoda adumileyo esizwe sokuqala,","poem":1},{"text":"abantu bako-Israyeli abaya kuso!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yanini eKhaline liyikhangele;","poem":1},{"text":"lisuka lapho yanini eHamathi enkulu,","poem":2},{"lineBreak":true},{"text":"beselisehlela eGathi eseFilistiya.","poem":2},{"text":"Bangcono kulemibuso yenu emibili na?","poem":1},{"text":"Ilizwe labo likhulu kulelenu na?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lisusa usuku olubi","poem":1},{"text":"lisondeze eduze ukubusa ngodlakela.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lilala emibhedeni eyenziwa ngempondo zendlovu","poem":1},{"text":"licambalale phezu kwemibheda yenu yokuphumulela.","poem":2},{"text":"Lidla inyama yezimvu zekhethelo","poem":1},{"text":"leyamathole anonisiweyo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lihweba amachacho njengoDavida","poem":1},{"text":"kodwa engamachacho ezaba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Linatha iwayini ligcwele inqayi,","poem":1},{"text":"ligcobe ngamagcobo amahle,","poem":2},{"lineBreak":true},{"text":"kodwa kalikhathazeki ngokuchitheka kukaJosefa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngakho-ke lizakuba ngabanye bakuqala ekuthunjweni;","poem":1},{"text":"ukuzitika kwenu lokuhleka kuzaphela.","poem":2}]},{"type":"heading","content":["Inkosi Iyakwenyanya Ukuzigqaja Kuka-Israyeli"]},{"type":"verse","number":8,"content":["UThixo Wobukhosi uzifungele yena ngokwakhe, uThixo uNkulunkulu uSomandla uthi:",{"text":"“Ngiyakwenyanya ukuzigqaja kukaJakhobe","poem":1},{"text":"njalo ngiyazizonda izinqaba zakhe;","poem":2},{"text":"ngizalinikela idolobho lakho","poem":1},{"text":"konke okukulo.”","poem":2}]},{"type":"verse","number":9,"content":["Nxa amadoda alitshumi esele endlini eyodwa, lawo azakufa."]},{"type":"verse","number":10,"content":["Njalo nxa isihlobo okumele sitshise izidumbu zifika ukuba sizisuse kuleyondlu besesibuza loba ngubani oyabe elokhu ecatshile khonapho, sithi, “Kulomunye olawe na?” Yena athi, “Hatshi,” lapho-ke uzakuthi, “Thula! Akumelanga sithinte ibizo likaThixo.”"]},{"type":"verse","number":11,"content":[{"text":"Ngoba uThixo usekhuphe umlayo,","poem":1},{"text":"njalo uzaphahlaza indlukazi ibe yizihlephu","poem":2},{"lineBreak":true},{"text":"kuthi indlu encinyane ibe yizicucu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Amabhiza ayagijima emadwaleni angamawa na?","poem":1},{"text":"Umuntu uyalima khonapho ngenkabi na?","poem":2},{"text":"Kodwa lina liphendule ukulunga kwaba yitshefu","poem":1},{"text":"lesithelo sokulunga saba yibuhlungu,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"lina elithokoziswa yikunqotshwa kweLo-Debhari","poem":1},{"text":"beselisithi, “IKharinayimi kasiyithumbanga ngamandla ethu na?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ngoba uThixo uNkulunkulu uSomandla uthi,","poem":1},{"text":"“Ngizakuvusela isizwe, wena ndlu ka-Israyeli,","poem":2},{"text":"esizakuncindezela indawo yonke","poem":1},{"text":"kusukela eLebho Hamathi kusiyafika esigodini sase-Arabha.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/AMO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/AMO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/AMO/5.json","previousChapterAudioLinks":{},"numberOfVerses":14}