{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"AMO","translationId":"nde_bib","name":"U-Amosi","commonName":"U-Amosi","title":"U-Amosi","order":30,"numberOfChapters":9,"sha256":"1fde47fe81068f0ae74184fb789183317ff219492f3636d339a94aa15ea772d5","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/nde_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":8,"content":[{"type":"heading","content":["Isitsha Sezithelo Ezivuthiweyo"]},{"type":"verse","number":1,"content":["Nanku engakutshengiswa nguThixo Wobukhosi: isitsha esilezithelo ezivuthiweyo."]},{"type":"verse","number":2,"content":["Wangibuza wathi, “Kuyini okubonayo, Amosi?” Mina ngaphendula ngathi, “Yisitsha esilezithelo ezivuthiweyo.” UThixo wasesithi kimi, “Isikhathi sabantu bami bako-Israyeli sesifikile; kangisabaxoleli futhi."]},{"type":"verse","number":3,"content":["Ngalolosuku, izingoma zethempelini zizaphenduka zibe yikulila. Izidumbu ezinengi kakhulu zidaklazelwe indawo yonke! Thulani!” Kutsho uThixo Wobukhosi."]},{"type":"verse","number":4,"content":[{"text":"Zwanini lokhu, lina elincindezela abaswelayo njalo","poem":1},{"text":"lichitha labayanga elizweni,","poem":2}]},{"type":"verse","number":5,"content":["lisithi,",{"text":"“Ukuthwasa kweNyanga Entsha kuzaphela nini","poem":1},{"text":"ukuze sithengise amabele,","poem":2},{"text":"leSabatha lidlule","poem":1},{"text":"ukuze sithengise ingqoloyi na?”","poem":2},{"text":"Sinciphise isilinganiso,","poem":1},{"text":"sikhweze intengo","poem":2},{"lineBreak":true},{"text":"siqilibezele ngezilinganiso zenkohliso,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"sithenge abayanga ngesiliva,","poem":1},{"text":"abaswelayo sibathenge ngamanyathelo,","poem":2},{"lineBreak":true},{"text":"sithengise lamakhoba ngengqoloyi.","poem":2}]},{"type":"verse","number":7,"content":["UThixo ufungile ngokuziQhenya kukaJakhobe wathi, “Angisoze ngakhohliswa loba yini abayenzileyo."]},{"type":"verse","number":8,"content":[{"text":"Ilizwe kaliyikuthuthumela ngalokhu yini","poem":1},{"text":"labo bonke abahlala kulo kabayikulila na?","poem":2},{"text":"Ilizwe lonke lizaqubuka njengeNayili;","poem":1},{"text":"lizadungeka beselitshona phansi","poem":2},{"lineBreak":true},{"text":"njengomfula waseGibhithe.","poem":2}]},{"type":"verse","number":9,"content":["Ngalolosuku,” kutsho uThixo Wobukhosi,",{"text":"“ngizakwenza ilanga litshone emini,","poem":1},{"text":"ngenze emhlabeni kube mnyama emini ekhanyayo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngizaphendula imikhosi yenu yokukhonza ibe yikulila","poem":1},{"text":"lokuhlabelela kwenu konke kube yikukhala.","poem":2},{"text":"Lonke ngizalenza ligqoke amasaka,","poem":1},{"text":"njalo liphuce amakhanda enu.","poem":2},{"text":"Lesosikhathi ngizasenza sifane lokulilela indodana eyiyo yodwa","poem":1},{"text":"lokuphela kwaso kube njengosuku olubuhlungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Insuku ziyeza, kutsho uThixo Wobukhosi,","poem":1},{"text":"lapho engizathumela khona indlala elizweni","poem":2},{"text":"hatshi indlala yokudla kumbe ukomela amanzi,","poem":1},{"text":"kodwa indlala yokuzwa amazwi kaThixo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abantu bazaphamazela besuka elwandle besiya elwandle,","poem":1},{"text":"njalo bazule kusukela enyakatho kusiya empumalanga,","poem":2},{"text":"bedinga ilizwi likaThixo,","poem":1},{"text":"kodwa kabayikulithola.","poem":2}]},{"type":"verse","number":13,"content":["Ngalolosuku",{"text":"izintombi ezinhle lezinsizwa eziqinileyo","poem":1},{"text":"zizaqaleka ngenxa yokoma.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bona labo abafunga ngesono seSamariya,","poem":1},{"text":"loba bathi, ‘Ngeqiniso","poem":2},{"lineBreak":true},{"text":"njengoba unkulunkulu wakho ephila, wena Dani,’","poem":2},{"text":"loba bathi, ‘Ngeqiniso","poem":1},{"text":"njengoba unkulunkulu waseBherishebha ephila,’","poem":2},{"lineBreak":true},{"text":"bazakuwa, bangaphindi bavuke futhi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/AMO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/AMO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/AMO/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}