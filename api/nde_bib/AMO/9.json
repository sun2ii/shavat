{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"AMO","translationId":"nde_bib","name":"U-Amosi","commonName":"U-Amosi","title":"U-Amosi","order":30,"numberOfChapters":9,"sha256":"1fde47fe81068f0ae74184fb789183317ff219492f3636d339a94aa15ea772d5","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/nde_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":9,"content":[{"type":"heading","content":["U-Israyeli Uzachithwa"]},{"type":"verse","number":1,"content":["Ngabona uThixo emi phansi kwe-alithari, wasesithi:",{"text":"“Tshaya izihloko zensika","poem":1},{"text":"ukuze imibundu inyikinyeke.","poem":2},{"text":"Ziwisele phansi phezu kwamakhanda abantu bonke;","poem":1},{"text":"labo abazasala ngizababulala ngenkemba.","poem":2},{"text":"Kakho lamunye ozaphunyuka,","poem":1},{"text":"kakho ozabaleka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Loba besimba baze bafike ekudepheni kwengcwaba,","poem":1},{"text":"isandla sami sizabathatha khonapho.","poem":2},{"text":"Loba bekhwela baye phezulu emazulwini,","poem":1},{"text":"bekhonapho ngizabehlisela phansi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Loba becatsha engqongweni yeKhameli,","poem":1},{"text":"khonapho ngizabadinga ngibabambe.","poem":2},{"text":"Loba bengicatshela enzikini yolwandle,","poem":1},{"text":"khonapho ngizalaya inyoka ukuba ibalume.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Loba izitha zabo zingabasa ekuthunjweni,","poem":1},{"text":"khonale ngizalaya inkemba ukuba ibabulale.","poem":2},{"lineBreak":true},{"text":"Ngizagxilisa amehlo ami kubo","poem":1},{"text":"ngenxa yobubi hatshi ngobuhle.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"INkosi, uThixo uSomandla,","poem":1},{"lineBreak":true},{"text":"yena othinta umhlaba uncibilike,","poem":1},{"text":"kuthi bonke abahlezi kuwo bakhale,","poem":2},{"text":"ilizwe lonke liyaphakama njengoNayili","poem":1},{"text":"liphinde litshone phansi njengomfula waseGibhithe,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"yena owakha indlu yakhe yobukhosi ephakemeyo emazulwini","poem":1},{"text":"njalo ubeka isisekelo sakhe phezu komhlaba,","poem":2},{"text":"ebiza amanzi olwandle","poem":1},{"text":"awathele phezu kobuso bomhlaba,","poem":2},{"lineBreak":true},{"text":"uThixo yilo ibizo lakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Lina ma-Israyeli,","poem":1},{"text":"kimi kalinjengamaKhushi na?”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2},{"text":"“U-Israyeli kangimkhuphanga eGibhithe,","poem":1},{"text":"lamaFilistiya eKhafithori,","poem":2},{"lineBreak":true},{"text":"kanye lama-Aramu eKhiri na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Impela amehlo kaThixo Wobukhosi","poem":1},{"text":"aphezu kombuso olesono.","poem":2},{"text":"Ngizawukhucula ebusweni bomhlaba","poem":1},{"text":"ikanti indlu kaJakhobe","poem":2},{"text":"angiyikuyichitha ngokupheleleyo,”","poem":1},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Ngoba ngizakupha umlayo,","poem":1},{"text":"njalo ngizahlungula indlu ka-Israyeli","poem":2},{"lineBreak":true},{"text":"phakathi kwezizwe zonke","poem":2},{"text":"njengokuhlungulwa kwamabele ekhomaneni","poem":1},{"text":"njalo akukho hlamvu oluzawela phansi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Izoni zonke phakathi kwabantu bami","poem":1},{"text":"zizakufa ngenkemba,","poem":2},{"text":"bonke labo abathi,","poem":1},{"text":"‘Umonakalo kawuyikusifica loba usihlangabeze.’ ”","poem":2}]},{"type":"heading","content":["Ukubuyiswa Kuka-Israyeli"]},{"type":"verse","number":11,"content":["“Ngalolosuku",{"text":"ngizavusa ithente likaDavida elawayo.","poem":1},{"text":"Ngizavala izikhala zalo,","poem":2},{"lineBreak":true},{"text":"ngivuselele okwadilikayo kwalo,","poem":2},{"lineBreak":true},{"text":"ngilakhe njengelaliyikho khona,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ukuze bathathe insalela ye-Edomi","poem":1},{"text":"kanye lezizwe zonke ezizabizwa ngebizo lami,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo, ozazenza lezizinto.","poem":2}]},{"type":"verse","number":13,"content":["UThixo uthi, “Zinsuku ziyeza,",{"text":"lapho ovunayo ezaficwa ngolimayo,","poem":1},{"text":"lohlanyelayo aficwe ngokhama amavini.","poem":2},{"text":"Iwayini elitsha lizagobhoza ezintabeni,","poem":1},{"text":"njalo ligeleze emaqaqeni wonke.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngizababuyisela abantu bami","poem":1},{"text":"bako-Israyeli abathunjwayo.","poem":2},{"lineBreak":true},{"text":"Bazawakha kutsha amadolobho adilikayo bahlale kuwo.","poem":1},{"text":"Bazahlanyela izivini banathe iwayini lazo;","poem":2},{"lineBreak":true},{"text":"bazakwenza izivande badle izithelo zazo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngizagxumeka u-Israyeli elizweni lakhe","poem":1},{"text":"angaphindi asitshunwe futhi","poem":2},{"lineBreak":true},{"text":"elizweni engimnike lona,”","poem":2},"kutsho uThixo uNkulunkulu wenu."]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/OBA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}