{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"DEU","translationId":"nde_bib","name":"UDutheronomi","commonName":"UDutheronomi","title":"UDutheronomi","order":5,"numberOfChapters":34,"sha256":"e3a852815d841357a8d3fe15db9b0549dbea96f518801dd775538361bb128929","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/nde_bib/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":[{"text":"“Lalelani, we mazulu, ngizakhuluma,","poem":1},{"text":"zwana, we mhlaba, amazwi omlomo wami.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akuthi imfundiso yami inethe njengezulu","poem":1},{"text":"kuthi amazwi ami ehle njengamazolo,","poem":2},{"text":"njengemifefezo etshanini obutsha,","poem":1},{"text":"njengezulu elinengi phezu kwamahlumela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngizaliphakamisa ibizo likaThixo.","poem":1},{"text":"Yebo dumisani ubukhulu bukaNkulunkulu wethu!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"UliDwala, imisebenzi yakhe iphelele,","poem":1},{"text":"njalo zonke izindlela zakhe zilungile.","poem":2},{"text":"UNkulunkulu othembekileyo ongenzi okubi,","poem":1},{"text":"uqotho njalo ulungile yena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sebenze okubi phambi kwakhe;","poem":1},{"text":"balihlazo kabase bantwabakhe,","poem":2},{"lineBreak":true},{"text":"kodwa isizukulwane esixhwalileyo lesingaqondanga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yiyonale na indlela yokubonga kwenu uThixo,","poem":1},{"text":"lina ziwula zabantu abangelakuhlakanipha?","poem":2},{"text":"KasuYihlo, uMdali wenu,","poem":1},{"text":"owalenzayo njalo owalibumbayo na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Khumbulani insuku zakudala;","poem":1},{"text":"likhumbule izizukulwane zasendulo.","poem":2},{"text":"Buza uyihlo yena uzakutshela,","poem":1},{"text":"abadala benu, njalo bazakuchasisela.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kwathi oPhezukonke esephe izizwe ilifa lazo,","poem":1},{"text":"eselwahlukanisile uluntu,","poem":2},{"text":"walufakela imingcele,","poem":1},{"text":"kusiya ngenani lamadodana ka-Israyeli.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngoba isabelo sikaThixo ngabantu bakhe,","poem":1},{"text":"uJakhobe yisabelo sakhe esikhethiweyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wamfica elizweni eliyinkangala,","poem":1},{"text":"indawo engatheli lutho njalo elodlame.","poem":2},{"text":"Wamvikela, wamonga;","poem":1},{"text":"wamsingatha njengegugu lakhe,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"njengokhozi lunyakazisa isidleke salo,","poem":1},{"text":"beselundiza phezu kwamachwane alo,","poem":2},{"text":"lwelule amaphiko alo ukuwagola,","poem":1},{"text":"luwathwale ngamaphiko alo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nguye yedwa uThixo owamkhokhelayo;","poem":1},{"text":"kungekho unkulunkulu wezizweni owayelaye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Wamkhweza engqongeni yelizwe","poem":1},{"text":"wamondla ngezithelo zeganga.","poem":2},{"text":"Wamondla ngoluju olwaluvela edwaleni,","poem":1},{"text":"langamafutha aphuma ezingoxweni zeliwa,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"lezankefu langochago oluvela emihlambini yenkomo leyezimvu;","poem":1},{"text":"lamazinyane anonisiweyo ezimvu lembuzi,","poem":2},{"text":"lenqama zekhethelo zaseBhashani,","poem":1},{"text":"kanye lengqoloyi elezinhlamvu ezinhle.","poem":2},{"text":"Wanatha igazi eliphuphumayo lesithelo samavini.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"UJeshuruni wazimuka watshakala;","poem":1},{"text":"esesuthi ukudla, wakhuluphala waba butshelezi.","poem":2},{"text":"Wamlahla uNkulunkulu owamdalayo","poem":1},{"text":"waliphika iDwala uMsindisi wakhe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bambangela ubukhwele ngabonkulunkulu babo bezizweni","poem":1},{"text":"bamthukuthelisa ngezithombe zabo ezinengekayo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Benza imihlatshelo kuwo amadimoni, wona angasiNkulunkulu,","poem":1},{"text":"onkulunkulu ababengazange babazi,","poem":2},{"lineBreak":true},{"text":"onkulunkulu ababesanda kuvela,","poem":2},{"lineBreak":true},{"text":"onkulunkulu ababengakhonzwa ngoyihlo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Walihlamukela iDwala, elinguyihlo;","poem":1},{"text":"wakhohlwa uNkulunkulu owakuzalayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"UThixo wakubona lokhu wabafulathela","poem":1},{"text":"ngoba wathukutheliswa ngamadodana lamadodakazi akhe.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"‘Ngizabufihla ubuso bami kubo,’ watsho uThixo,","poem":1},{"text":"‘ngize ngibone ukuthi bazaphetha ngani;","poem":2},{"text":"ngoba bayisizukulwana esixhwalileyo","poem":1},{"text":"abantwana abangathembekanga.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bangenza ngaba lobukhwele ngalokho okwakungasinkulunkulu","poem":1},{"text":"njalo bangithukuthelisa ngezithombe zabo ezingasizi lutho.","poem":2},{"text":"Ngizabavusela umhawu ngesizwe esingesibantu balutho;","poem":1},{"text":"ngibazondise ngesizwe esingazwisisiyo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ngoba umlilo usulunyathiswe yikuthukuthela kwami,","poem":1},{"text":"wona otshisa ujule uze uyethinta ukufa ngaphansi.","poem":2},{"text":"Uzahangula udle umhlaba kanye lesivuno sawo","poem":1},{"text":"uthungele lezinsika zezintaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ngizabehlisela izigigaba,","poem":1},{"text":"imitshoko yami iphelele phezu kwabo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ngizabathumela inkengane eqeda amandla,","poem":1},{"text":"izifo ezibhubhisayo lomkhuhlane otshabalalisayo;","poem":2},{"text":"ngizabathumela amazinyo abukhali ezinyamazana zeganga,","poem":1},{"text":"ubuthi bezinhlangwana ezihuquzelayo emhlabathini.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ezindleleni inkemba izabaswelisa abantwana,","poem":1},{"text":"emizini kuzabusa uchuku.","poem":2},{"text":"Amadodana lamadodakazi azabhujiswa aphele,","poem":1},{"text":"abantwana abancinyane kanye lamadoda alenwele ezimhlophe.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ngithe ngizabachitha","poem":1},{"text":"ngisuse imbali yabo bakhohlakale emhlabeni,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"kodwa ngesaba ukweyisa kwesitha,","poem":1},{"text":"funa isitha singezwisisi","poem":2},{"text":"besesisithi, “Isandla sethu sinqobile,","poem":1},{"text":"njalo uThixo kakwenzanga konke lokhu.” ’","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Bayisizwe esingelangqondo,","poem":1},{"text":"akukho ukuqedisisa kubo.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ngabe kodwa bahlakaniphile njalo bezwisise lokhu,","poem":1},{"text":"babe lokuqedisisa ukuthi sizakuba yini isiphetho sabo!","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kungenzeka njani ukuthi umuntu oyedwa axotshane lenkulungwane,","poem":1},{"text":"loba ababili basukele izinkulungwane ezilitshumi zibaleke na,","poem":2},{"text":"ngaphandle kokuthi iDwala labo nxa labathengisa;","poem":1},{"text":"langaphandle kokuthi uThixo wabo esebahlanekele?","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ngoba elabo idwala alinjengelethu iDwala,","poem":1},{"text":"njengoba lezitha zethu zivuma.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Iwayini labo livela esivinini saseSodoma","poem":1},{"text":"lasemasimini aseGomora.","poem":2},{"text":"Amagrebisi abo agcwele itshefu,","poem":1},{"text":"lamaxha awo amunyu.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Iwayini labo liyibuthi bezinyoka,","poem":1},{"text":"ubuhlungu obubulalayo bezinhlangwana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"‘Kambe lokhu angikugodlanga na","poem":1},{"text":"ngakugcikela eziphaleni zami na?","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ukuphindisela ngokwami; ngizabuyisela.","poem":1},{"text":"Ngesikhathi esifaneleyo unyawo lwabo luzatshelela;","poem":2},{"text":"usuku lwabo lokubhujiswa luseduze,","poem":1},{"text":"ukuchitheka kwabo kubalanda ngesiqubu.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"UThixo uzakwahlulela abantu bakhe,","poem":1},{"text":"abe lozwelo ezincekwini zakhe","poem":2},{"text":"lapho esebona amandla abo ephela","poem":1},{"text":"njalo kakho ozasala, isigqili loba okhululekileyo.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Uzakuthi: ‘Kanti bangaphi onkulunkulu babo,","poem":1},{"text":"lelodwala ababephephela kulo,","poem":2}]},{"type":"verse","number":38,"content":[{"text":"onkulunkulu abadla amafutha emihlatshelo yabo","poem":1},{"text":"njalo banatha iwayini elingumnikelo wokunathwayo kwabo?","poem":2},{"text":"Kabaphakame balincedise!","poem":1},{"text":"Kabaliphe umthunzi wokuphephela!","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Angithi liyazibonela ukuthi Mina ngiNguye!","poem":1},{"text":"Kakho omunye unkulunkulu ngaphandle kwami.","poem":2},{"text":"Ngiyabhubhisa njalo ngiyaphilisa.","poem":1},{"text":"Ngilimazile njalo ngizelapha,","poem":2},{"lineBreak":true},{"text":"kakho ongaphunyuka esandleni sami.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Ngiphakamisela isandla sami ezulwini ngithi:","poem":1},{"text":"Njengoba ngeqiniso ngiphila nini lanini,","poem":2}]},{"type":"verse","number":41,"content":[{"text":"nxa ngilola inkemba yami ephazimayo","poem":1},{"text":"lesandla sami siyibamba ekwehluleleni,","poem":2},{"text":"ngizaphindisela kuzozonke izitha zami,","poem":1},{"text":"ngiphindisele kulabo abangizondayo.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Imitshoko yami izagava igazi,","poem":1},{"text":"kanti inkemba izakudla enyameni:","poem":2},{"text":"igazi lalabo ababulawayo labathunjwayo,","poem":1},{"text":"amakhanda alabo abangabakhokheli bezitha.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Jabulani, lina zizwe, kanye labantu bakhe,","poem":1},{"text":"ngoba uzaphindisela igazi lezinceku zakhe,","poem":2},{"text":"uzaphindisela ezitheni zakhe,","poem":1},{"text":"njalo enzele ilizwe lakhe labantu bakhe indlela yokubuyisana.”","poem":2}]},{"type":"verse","number":44,"content":["UMosi weza loJoshuwa indodana kaNuni wethula wonke amazwi engoma le abantu bonke besizwa."]},{"type":"verse","number":45,"content":["UMosi wathi eqeda ukuwethula lamazwi phambi kwabo bonke abako-Israyeli,"]},{"type":"verse","number":46,"content":["wathi kubo, “Alondolozeni ezinhliziyweni zenu wonke lamazwi engiwethule phambi kwenu ngesifungo lamuhla, ukuze libe lakho ukubalaya abantwabenu ukuba bawalalele ngonanzelelo amazwi alo umthetho."]},{"type":"verse","number":47,"content":["Akusimazwi alula nje kini, ayikuphila kwenu. Ngala amazwi lizaphila isikhathi eside elizweni eselingena kulo lichapha uJodani ukuba lilithathe libe ngelenu.”"]},{"type":"heading","content":["UMosi Uzafela Entabeni YaseNebho"]},{"type":"verse","number":48,"content":["Ngalolosuku uThixo watshela uMosi wathi,"]},{"type":"verse","number":49,"content":["“Khwela uye okhahlamba lwezintaba zase-Abharimi eNtabeni yaseNebho kwelamaMowabi, ngaphetsheya kweJerikho, ukuze ubone iKhenani, ilizwe engilinika abako-Israyeli ukuba balithathe libe ngelabo."]},{"type":"verse","number":50,"content":["Phezu kwaleyontaba okhwele phezu kwayo uzakufa umbelwe uye kubokhokho bakho njengoba u-Aroni laye wafela entabeni yaseHori wembelwa kwabakibo."]},{"type":"verse","number":51,"content":["Lokhu kungenxa yokuthi lina lobabili lalahla ithemba lenu kimi phambi kwabako-Israyeli emachibini aseMeribha Khadeshi, eNkangala yaseZini langenxa yokuthi alizange lime ngobungcwele bami phambi kwabako-Israyeli."]},{"type":"verse","number":52,"content":["Ngenxa yalokho, ilizwe uzalibonela kude, awusoze ungene elizweni esengilinika abako-Israyeli ukuba bangene kulo.”"]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":52}