{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"DEU","translationId":"nde_bib","name":"UDutheronomi","commonName":"UDutheronomi","title":"UDutheronomi","order":5,"numberOfChapters":34,"sha256":"e3a852815d841357a8d3fe15db9b0549dbea96f518801dd775538361bb128929","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/nde_bib/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":33,"content":[{"type":"heading","content":["UMosi Ubusisa Izizwana Zako-Israyeli"]},{"type":"verse","number":1,"content":["Lesi yiso isibusiso esethulwa nguMosi umuntu kaNkulunkulu kwabako-Israyeli engakafi."]},{"type":"verse","number":2,"content":["Wathi:",{"text":"“UThixo wehla evela eSinayi","poem":1},{"text":"njalo wakhazimula kubo ngaseSeyiri;","poem":2},{"lineBreak":true},{"text":"wakhanyisa njalo kusiya eNtabeni yasePharani.","poem":2},{"text":"Wabuya labazinkulungwane ezilitshumi zabangcwele","poem":1},{"text":"bevelela eningizimu, emehlweni ezintaba zakhe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngempela nguwe othanda abantu,","poem":1},{"text":"bonke abangcwele basezandleni zakho.","poem":2},{"text":"Ezinyaweni zakho bayakhothama","poem":1},{"text":"bonke bamukele iziqondiso ezivela kuwe,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"umthetho esawuphiwa nguMosi,","poem":1},{"text":"inotho yebandla likaJakhobe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wayeyinkosi phezu kukaJeshuruni","poem":1},{"text":"lapho abakhokheli babantu bebuthene,","poem":2},{"lineBreak":true},{"text":"ndawonye lezizwana zako-Israyeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kaphile uRubheni njalo angafi,","poem":1},{"text":"abesilisa bakhe bangaphunguki babebalutshwana.”","poem":2}]},{"type":"verse","number":7,"content":["Lokhu wakutsho ngoJuda:",{"text":"“Zwana, wena Thixo wami, ukukhala kukaJuda;","poem":1},{"text":"mlethe ebantwini bakhe.","poem":2},{"text":"Ngezandla zakhe uvikela lokho akumeleyo.","poem":1},{"text":"Yebo, msize amelane lezitha zakhe!”","poem":2}]},{"type":"verse","number":8,"content":["NgoLevi wathi:",{"text":"“IThumimi kanye le-Urimi yakho ngokwayo","poem":1},{"text":"inceku yakho ethembekileyo.","poem":2},{"text":"Wamhlola eMasa;","poem":1},{"text":"waba laye emachibini aseMeribha.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wathi ngoyise lonina,","poem":1},{"text":"‘Angilandaba labo mina.’","poem":2},{"text":"Kazange akwamukele ukuthi ulabafowabo","poem":1},{"text":"njalo kazange ananze abantwabakhe,","poem":2},{"text":"kodwa walilondoloza ilizwi lakho","poem":1},{"text":"wasigcina isivumelwano sakho.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ufundisa amanyathelo akho kuJakhobe","poem":1},{"text":"lomthetho wakho ku-Israyeli.","poem":2},{"text":"Unikela ngempepha phambi kwakho","poem":1},{"text":"langeminikelo egcweleyo yokutshiswa e-alithareni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Busisa bonke ubuciko bakhe, Thixo,","poem":1},{"text":"ujabule ngomsebenzi wezandla zakhe.","poem":2},{"text":"Babhubhise labo abamvukelayo;","poem":1},{"text":"zitshaye izitha zakhe zingaphindi zimvukele.”","poem":2}]},{"type":"verse","number":12,"content":["NgoBhenjamini wathi:",{"text":"“Yekelani othandekayo kaThixo","poem":1},{"text":"aphumule kuye evikelekile,","poem":2},{"text":"ngoba umvikela ilanga lonke,","poem":1},{"text":"kanti njalo lowo uThixo amthandayo","poem":2},{"lineBreak":true},{"text":"uphumula emahlombe akhe.”","poem":2}]},{"type":"verse","number":13,"content":["NgoJosefa wathi:",{"text":"“Sengathi uThixo angabusisa umhlaba wakhe","poem":1},{"text":"ngamazolo aligugu avela phezulu ezulwini","poem":2},{"lineBreak":true},{"text":"langamanzi ajulileyo ageleza ngaphansi;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"langobuhle obuyingqala obulethwa lilanga","poem":1},{"text":"kanye lokucoleka okungalethwa yinyanga;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"lezipho zekhethelo zasezintabeni zendulo","poem":1},{"text":"lokuthela kwezithelo zamaqaqa emi nini lanini;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"langezipho eziyingqala zomhlaba lokugcwala kwawo","poem":1},{"text":"lozwelo lwakhe yena owayesesixukwini esivuthayo.","poem":2},{"text":"Konke lokhu akube sekhanda likaJosefa,","poem":1},{"text":"ebunzini lobuso benkosana phakathi kwabafowabo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ebukhosini unjengenkunzi encane elizibulo;","poem":1},{"text":"impondo zakhe zinjengezenyathi.","poem":2},{"text":"Ngazo uzagweba abhuqe izizwe,","poem":1},{"text":"aze agwebe lalezo ezisemaphethelweni omhlaba.","poem":2},{"text":"Banjalo abezinkulungwane zamatshumi baka-Efrayimi;","poem":1},{"text":"banjalo abezinkulungwane zikaManase.”","poem":2}]},{"type":"verse","number":18,"content":["NgoZebhuluni wathi:",{"text":"“Jabula, Zebhuluni, ekuphumeni kwakho,","poem":1},{"text":"lawe wena, Isakhari, emathenteni akho.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bazabizela abantu ezintabeni khonale","poem":1},{"text":"banikele imihlatshelo yabo yokulunga;","poem":2},{"text":"bazakudla baminze ngobunengi bokusolwandle","poem":1},{"text":"ngawo amagugu afihlakele etshebetshebeni.”","poem":2}]},{"type":"verse","number":20,"content":["NgoGadi wathi:",{"text":"“Ubusisiwe lowo oqhelisa umbuso kaGadi!","poem":1},{"text":"UGadi uhlala khona njengesilwane,","poem":2},{"lineBreak":true},{"text":"edlithiza engalweni loba ekhanda.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wazikhethela umhlaba omuhle okwamagama waba ngowakhe;","poem":1},{"text":"isabelo somkhokheli sagcinelwa yena.","poem":2},{"text":"Kwathi ekuhlanganeni kwabakhokheli babantu,","poem":1},{"text":"wakwenza lokho okufunwa nguThixo olungileyo,","poem":2},{"lineBreak":true},{"text":"kanye lokwahlulela kwakhe kwabako-Israyeli.”","poem":2}]},{"type":"verse","number":22,"content":["NgoDani wathi:",{"text":"“UDani ngumdlwane wesilwane,","poem":1},{"text":"otshakala uphuma eBhashani.”","poem":2}]},{"type":"verse","number":23,"content":["NgoNafithali wathi:",{"text":"“UNafithali uyaphuphuma ngozwelo lukaThixo","poem":1},{"text":"njalo ugcwele izibusiso zakhe;","poem":2},{"lineBreak":true},{"text":"elakhe ilifa uzazuza kusiya eningizimu ngechibini.”","poem":2}]},{"type":"verse","number":24,"content":["Ngo-Asheri wathi:",{"text":"“Obusisiweyo kakhulu kulawo wonke amadodana ngu-Asheri;","poem":1},{"text":"ababelozwelo kuye abafowabo,","poem":2},{"lineBreak":true},{"text":"myekeleni ageze inyawo zakhe emafutheni.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Amabhawudo emasangweni akho azakuba ngawensimbi lethusi","poem":1},{"text":"njalo amandla akho azalingana insuku zakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Kakho ofana loNkulunkulu kaJeshuruni,","poem":1},{"text":"ophezulu emazulwini ukuze akuncede","poem":2},{"lineBreak":true},{"text":"kanti njalo lasemayezini ngobukhosi bakhe.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"UNkulunkulu ongusimakade uyisiphephelo sakho,","poem":1},{"text":"njalo ngaphansi kuzingalo ezingelakuphela.","poem":2},{"text":"Uzazixotsha izitha phambi kwakho","poem":1},{"text":"esithi, ‘Mbulale!’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ngakho u-Israyeli uzaphila yedwa evikelekile,","poem":1},{"text":"umthombo kaJakhobe uvikelekile,","poem":2},{"text":"elizweni lamabele kanye lewayini elitsha,","poem":1},{"text":"lapho amazulu phezulu akhithizela khona amazolo.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ubusisiwe wena, Oh Israyeli!","poem":1},{"text":"Ngubani onjengawe,","poem":2},{"lineBreak":true},{"text":"abantu abahlengwa nguThixo?","poem":2},{"text":"Ulihawu lakho lomsizi wakho","poem":1},{"text":"njalo uyinkemba yakho ekhazimulayo.","poem":2},{"text":"Izitha zakho zizatshotshobala phambi kwakho","poem":1},{"text":"njalo uzazinyathela phansi","poem":2},{"lineBreak":true},{"text":"zonke izindawo zabo zokukhonza eziphakemeyo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}