{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ECC","translationId":"nde_bib","name":"UMtshumayeli","commonName":"UMtshumayeli","title":"UMtshumayeli","order":21,"numberOfChapters":12,"sha256":"e1094335c9804c31de01cfc04ef50953437f9f7e48739ca7f220e53357d56de8","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/nde_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":1,"content":[{"type":"heading","content":["Konke Kuyize"]},{"type":"verse","number":1,"content":["Amazwi oMtshumayeli, indodana kaDavida inkosi yaseJerusalema:"]},{"type":"verse","number":2,"content":[{"text":"“Ize! Ize!”","poem":1},{"text":"kutsho uMtshumayeli.","poem":2},{"text":"“Ize elipheleleyo!","poem":1},{"text":"Konke kuyize.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Umuntu uzuzani ngawo wonke umsebenzi wakhe awusebenza nzima","poem":1},{"text":"ngaphansi kwelanga?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Izizukulwane ziyafika, izizukulwane ziyedlula,","poem":1},{"text":"kodwa umhlaba umi lanini.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ilanga liyaphuma njalo ilanga liyatshona,","poem":1},{"text":"liphinde liphange libuyele lapho eliphuma khona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Umoya uphephethela eningizimu","poem":1},{"text":"ujike uye enyakatho;","poem":2},{"text":"uyabhoda, ubhode njalo","poem":1},{"text":"ujinge ubuyela endleleni yawo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Zonke izifula zigelezela olwandle,","poem":1},{"text":"kodwa ulwandle kalugcwali.","poem":2},{"text":"Endaweni lapho izifula ezidabuka khona","poem":1},{"text":"zicina zibuyela khona njalo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zonke izinto ziyadina,","poem":1},{"text":"lokho okungelandiswe muntu.","poem":2},{"text":"Ilihlo kalidinwa yikubona,","poem":1},{"text":"lendlebe layo kayigcwali ngokuzwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Lokho okwake kwaba khona kuzakuba khona njalo;","poem":1},{"text":"okwake kwenziwa kuzakwenziwa njalo;","poem":2},{"lineBreak":true},{"text":"akulalutho olutsha ngaphansi kwelanga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kukhona yini umuntu angathi ngakho,","poem":1},{"text":"“Khangela! Lolulutho lutsha?”","poem":2},{"text":"Selwake lwaba khona ngaphambili, kudala;","poem":1},{"text":"lwalukhona singakabi khona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kayikho imikhumbulo ngabantu bakudala,","poem":1},{"text":"njalo lalabo abezayo abayikukhunjulwa","poem":2},{"lineBreak":true},{"text":"yilabo abalandelayo.","poem":2}]},{"type":"heading","content":["Ukuhlakanipha Kuyize"]},{"type":"verse","number":12,"content":["Mina Mtshumayeli, ngangiyinkosi yako-Israyeli eJerusalema."]},{"type":"verse","number":13,"content":["Ngazinikela ekufundeni lokudingisisa ngolwazi konke okwenziwayo ngaphansi kwezulu. Unzima kangakanani umthwalo uNkulunkulu awethese abantu!"]},{"type":"verse","number":14,"content":["Sengizibonile zonke izinto ezenziwayo ngaphansi kwelanga; zonke kazitsho lutho, kuyikuxotshana lomoya."]},{"type":"verse","number":15,"content":[{"text":"Okutshileneyo kungaze kwaqondiswa;","poem":1},{"text":"okungekho kungaze kwabalwa.","poem":2}]},{"type":"verse","number":16,"content":["Ngacabanga ngedwa ngathi, “Khangela, sengikhulile njalo kwanda ukuhlakanipha kwami okudlula bonke asebake babusa eJerusalema ngaphambi kwami; sengibe lakho ukuhlakanipha okukhulu lolwazi.”"]},{"type":"verse","number":17,"content":["Ngasengizimisela ukuzwisisa ukuhlakanipha, njalo lokuphambana ingqondo lobuwula, kodwa ngafunda ukuthi lokhu lakho kuyikuxotshana lomoya."]},{"type":"verse","number":18,"content":[{"text":"Phela ngokwanda kokuhlakanipha kuyanda lokukhathazeka;","poem":1},{"text":"ukwandisa ulwazi yikwandisa usizi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}