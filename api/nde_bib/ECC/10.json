{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ECC","translationId":"nde_bib","name":"UMtshumayeli","commonName":"UMtshumayeli","title":"UMtshumayeli","order":21,"numberOfChapters":12,"sha256":"e1094335c9804c31de01cfc04ef50953437f9f7e48739ca7f220e53357d56de8","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/nde_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Njengoba impukane ezifele phakathi kwamakha ziwenza anuke kubi,","poem":1},{"text":"kunjalo lobuwula obuncinyane bugabhela ukuhlakanipha lodumo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inhliziyo yolungileyo ikhungathekela ekulungeni,","poem":1},{"text":"kodwa inhliziyo yesiwula ikhungathekela ebubini.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Loba ehamba nje emgwaqweni","poem":1},{"text":"oyisiwula kalangqondo,","poem":2},{"lineBreak":true},{"text":"utshengisa loba ngubani ubuphukuphuku bakhe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Aluba umbusi ekuthukuthelela,","poem":1},{"text":"ungasuki esikhundleni sakho;","poem":2},{"lineBreak":true},{"text":"ukuthobeka kungathoba umonakalo obungaba khona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bukhona ububi esengibubonile ngaphansi kwelanga,","poem":1},{"text":"kuliphutha elenziwa ngumbusi:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iziwula ziphakanyiselwa ezikhundleni ezinengi eziphezulu,","poem":1},{"text":"kodwa abanothileyo belezikhundla eziphansi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sengibone izichaka zigade amabhiza,","poem":1},{"text":"kuthi amakhosana ahambe ngezinyawo njengezichaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lowo ogebha umgodi angawela kuwo;","poem":1},{"text":"odiliza umduli angalunywa yinyoka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Oqhekeza amatshe angalinyazwa yiwo;","poem":1},{"text":"obanda inkuni angaba sengozini yazo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Lapho ihloka libuthundu","poem":1},{"text":"ubukhali balo bungalolwanga,","poem":2},{"text":"kudingeka amandla amanengi","poem":1},{"text":"kodwa ubungcitshi buyaphumelelisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nxa inyoka ihle ilume ingakalunjwa,","poem":1},{"text":"umlumbi kaselanzuzo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Amazwi aphuma emlonyeni wesihlakaniphi amnandi,","poem":1},{"text":"kodwa isiwula sichithwa yizindebe zaso.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ekuqaleni amazwi aso ayibuwula;","poem":1},{"text":"ekucineni aseyikuwumana okubi","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"njalo isiwula sanda ngamazwi.","poem":2},{"lineBreak":true},{"text":"Kakho okwaziyo okuzayo","poem":1},{"text":"ngubani ongamazisa okuzakwenzakala ngemva kwakhe na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Umtshikatshika wesiwula uyasidinisa;","poem":1},{"text":"kasiyazi indlela eya edolobheni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Maye kuwe, wena lizwe onkosi yalo yayiyisichaka,","poem":1},{"text":"amakhosana akho azitika ngamadili ekuseni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ubusisiwe wena, wena lizwe onkosi yalo izalwa esikhosini","poem":1},{"text":"amakhosana alo adla ngezikhathi eziqondileyo","poem":2},{"lineBreak":true},{"text":"edlela ukuqina hatshi ukudakwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Nxa indoda ilivila intungo ziyabhensa;","poem":1},{"text":"nxa izandla zayo ziyekethisa indlu iyavuza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Idili lenzelwa ukujabula,","poem":1},{"text":"lewayini lenza impilo ibe mnandi,","poem":2},{"lineBreak":true},{"text":"kodwa imali yiyo impendulo yakho konke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ungayithuki inkosi lasemicabangweni yakho,","poem":1},{"text":"loba uqalekise abanothileyo loba usendlini yakho yokulala,","poem":2},{"text":"ngoba mhlawumbe inyoni yasemoyeni ingawathwala amazwi akho,","poem":1},{"text":"loba inyoni ephaphayo ingayabika okutshoyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ECC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ECC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ECC/9.json","previousChapterAudioLinks":{},"numberOfVerses":20}