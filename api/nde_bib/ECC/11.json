{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ECC","translationId":"nde_bib","name":"UMtshumayeli","commonName":"UMtshumayeli","title":"UMtshumayeli","order":21,"numberOfChapters":12,"sha256":"e1094335c9804c31de01cfc04ef50953437f9f7e48739ca7f220e53357d56de8","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/nde_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":11,"content":[{"type":"heading","content":["Isinkwa Emanzini"]},{"type":"verse","number":1,"content":[{"text":"Phosela isinkwa sakho phezu kwamanzi,","poem":1},{"text":"ngoba ngemva kwensuku ezinengi uzasifumana futhi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yabela abayisikhombisa, yebo abayisificaminwembili,","poem":1},{"text":"ngoba kawuwazi umonakalo ongehlela elizweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nxa amayezi ethwele, anisa izulu emhlabathini.","poem":1},{"text":"Aluba isihlahla singawela eningizimu loba enhla,","poem":2},{"lineBreak":true},{"text":"silala khonapho esiwele khona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lowo onanzelela umoya kayikuhlanyela;","poem":1},{"text":"lowo okhangela amayezi akazukuvuna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Njengoba ungayazi indlela yomoya,","poem":1},{"text":"loba ukubunjwa komzimba esiswini sikanina,","poem":2},{"text":"yikho ungeke uzwisise umsebenzi kaNkulunkulu,","poem":1},{"text":"uMenzi wezinto zonke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hlanyela inhlanyelo yakho ekuseni,","poem":1},{"text":"kuthi ntambama uphumuze izandla zakho,","poem":2},{"text":"ngoba kawukwazi okuzaphumelela,","poem":1},{"text":"kumbe yilokhu loba yilokhuyana,","poem":2},{"lineBreak":true},{"text":"langabe kokubili kuzalunga ngokufananayo.","poem":2}]},{"type":"heading","content":["Khumbula UMenzi Wakho UseseMutsha"]},{"type":"verse","number":7,"content":[{"text":"Ukukhanya kumnandi,","poem":1},{"text":"njalo kuhle emehlweni ukubona ilanga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Umuntu angaze aphile iminyaka emingaki,","poem":1},{"text":"kayikholise yonke.","poem":2},{"text":"Kodwa makakhumbule insuku zobumnyama,","poem":1},{"text":"ngoba zizabe zizinengi.","poem":2},{"lineBreak":true},{"text":"Konke okuzakuza kuyize.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Jabula nsizwa usesemutsha,","poem":1},{"text":"uvumele inhliziyo yakho ikuthokozise ensukwini zobutsha bakho.","poem":2},{"text":"Landela izindlela zenhliziyo yakho","poem":1},{"text":"lakho konke amehlo akho akubonayo,","poem":2},{"text":"kodwa yazi ukuthi ngenxa yazo zonke lezizinto","poem":1},{"text":"uNkulunkulu uzakumisa ekwahlulelweni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngakho-ke, susa ukukhathazeka enhliziyweni yakho","poem":1},{"text":"ulahlele kude inhlupheko zomzimba wakho,","poem":2},{"lineBreak":true},{"text":"ngoba ubutsha lamadlabuzane kuyize.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}