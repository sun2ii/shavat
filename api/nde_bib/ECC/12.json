{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ECC","translationId":"nde_bib","name":"UMtshumayeli","commonName":"UMtshumayeli","title":"UMtshumayeli","order":21,"numberOfChapters":12,"sha256":"e1094335c9804c31de01cfc04ef50953437f9f7e48739ca7f220e53357d56de8","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/nde_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Khumbula uMdali wakho","poem":1},{"text":"ngezinsuku zobutsha bakho,","poem":2},{"text":"kungakafiki insuku zokuhlupheka","poem":1},{"text":"njalo kusondele leminyaka","poem":2},{"lineBreak":true},{"text":"lapho ozakuthi,","poem":2},{"lineBreak":true},{"text":"“Angizuzi kuthokoza kuyo”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"andubana ilanga lokukhanya","poem":1},{"text":"kanye lenyanga lezinkanyezi kufiphale,","poem":2},{"text":"lamayezi achitheke","poem":1},{"text":"ngemva kwezulu;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"lapho abalindi bendlu","poem":1},{"text":"bezathuthumela,","poem":2},{"text":"amadoda aqinileyo akhokhobe,","poem":1},{"text":"labacholi batshiye umsebenzi","poem":2},{"text":"ngoba sebebalutshwana,","poem":1},{"text":"kuthi labalunguzayo ngamawindi","poem":2},{"lineBreak":true},{"text":"sebebona lufifi;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"lapho iminyango ephumela emigwaqweni isivaliwe","poem":1},{"text":"lomsindo wokuchola usufiphala;","poem":2},{"text":"lapho abantu besethuswa yikukhala kwenyoni,","poem":1},{"text":"lezingoma zazo zincipha;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"lapho abantu sebesesaba izindawo eziphakemeyo","poem":1},{"text":"lezingozi emigwaqweni;","poem":2},{"text":"lapho isihlahla se-alimondi sesiqhakaza","poem":1},{"text":"lentethe isihamba ngokuzihudula nje","poem":2},{"lineBreak":true},{"text":"njalo kungasekho ukulangazelela.","poem":2},{"text":"Lapho-ke umuntu usesiya ekhaya lakhe","poem":1},{"text":"laphakade njalo abalilayo","poem":2},{"lineBreak":true},{"text":"bagcwale emigwaqweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mkhumbule intambo yesiliva ingakaqamuki,","poem":1},{"text":"kumbe umganu wegolide ungakabhidlizwa;","poem":2},{"text":"lodiwo lungakahlikizwa emthonjeni,","poem":1},{"text":"loba ivili lephulwe emgodini wamanzi,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kuthi umhlabathi ubuyele emhlabathini","poem":1},{"text":"lapho owavela khona,","poem":2},{"text":"lomphefumulo ubuyele kuNkulunkulu","poem":1},{"text":"onguye owawuphayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ize! Ize!” kutsho uMtshumayeli,","poem":1},{"text":"“Konke kuyize!”","poem":2}]},{"type":"heading","content":["Isiphetho Sendaba"]},{"type":"verse","number":9,"content":["UMtshumayeli wayehlakaniphile, njalo esabela abantu ulwazi. Wazidla ingqondo wadingisisa wamisa kuhle izaga ezinengi."]},{"type":"verse","number":10,"content":["UMtshumayeli wadingisisa ukuze azuze amazwi ayiwonawona, kwathi-ke konke akulobayo kwaqonda njalo kuliqiniso."]},{"type":"verse","number":11,"content":["Amazwi abahlakaniphileyo anjengenswazi zokwethusa izimvu, izitsho zabo eziqoqiweyo zinjengezipikili ezibethelwe zatshona, zivela kuMalusi munye."]},{"type":"verse","number":12,"content":["Limuka, ndodana yami, loba kuyini okudlula lapho. Ukulotshwa kwezincwadi ezinengi akulamkhawulo, njalo ukufunda kakhulu kuhlukuluza umzimba."]},{"type":"verse","number":13,"content":[{"text":"Manje-ke konke sekuzwakele;","poem":1},{"text":"nansi isiphetho sendaba:","poem":2},{"text":"Mesabe uNkulunkulu ugcine imiyalo yakhe,","poem":1},{"text":"ngoba lo yiwo wonke umlandu womuntu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngoba uNkulunkulu uzazahlulela zonke izenzo,","poem":1},{"text":"lalokho okufihliweyo","poem":2},{"lineBreak":true},{"text":"loba kuhle loba kubi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ECC/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/SNG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ECC/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}