{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ECC","translationId":"nde_bib","name":"UMtshumayeli","commonName":"UMtshumayeli","title":"UMtshumayeli","order":21,"numberOfChapters":12,"sha256":"e1094335c9804c31de01cfc04ef50953437f9f7e48739ca7f220e53357d56de8","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/nde_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":3,"content":[{"type":"heading","content":["Konke Kulesikhathi Sakho"]},{"type":"verse","number":1,"content":[{"text":"Zonke izinto zilesikhathi sazo,","poem":1},{"text":"konke okwenziwayo ngaphansi kwelanga kulesibanga sakho:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"isikhathi sokuzalwa lesikhathi sokufa,","poem":2},{"lineBreak":true},{"text":"isikhathi sokuhlanyela lesikhathi sokusiphuna,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"isikhathi sokubulala lesikhathi sokuphilisa,","poem":2},{"lineBreak":true},{"text":"isikhathi sokubhidliza lesikhathi sokwakha,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"isikhathi sokukhala lesikhathi sokuhleka,","poem":2},{"lineBreak":true},{"text":"isikhathi sokulila lesikhathi sokugida,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"isikhathi sokuchithiza amatshe lesikhathi sokuwabutha,","poem":2},{"lineBreak":true},{"text":"isikhathi sokugona lesikhathi sokunina,","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"isikhathi sokudinga lesikhathi sokukhalala,","poem":2},{"lineBreak":true},{"text":"isikhathi sokugcina lesikhathi sokulahla,","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"isikhathi sokudabula lesikhathi sokuthunga,","poem":2},{"lineBreak":true},{"text":"isikhathi sokuthula lesikhathi sokukhuluma,","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"isikhathi sokuthanda lesikhathi sokuzonda,","poem":2},{"lineBreak":true},{"text":"isikhathi sempi lesikhathi sokuthula.","poem":2}]},{"type":"verse","number":9,"content":["Umuntu osebenzayo uzuzani na ngokusadalala kwakhe?"]},{"type":"verse","number":10,"content":["Sengiwubonile umthwalo uNkulunkulu awethese abantu."]},{"type":"verse","number":11,"content":["Yonke into uyenze yabanhle ngesikhathi sayo. Wamupha umuntu iphakade enhliziyweni yakhe; kodwa abantu bangeke bafinyelele kulokho uNkulunkulu asakwenzayo kwasekuqaleni kusiya ekupheleni."]},{"type":"verse","number":12,"content":["Ngiyakwazi ukuthi kakukho okungcono ebantwini kulokuthi bajabule njalo benze okuhle besaphila."]},{"type":"verse","number":13,"content":["Ukuthi wonke umuntu adle, anathe asuthiseke ekusebenzeni kwakhe gadalala, lokhu kuyisipho sikaNkulunkulu."]},{"type":"verse","number":14,"content":["Ngiyazi yonke into eyenziwa nguNkulunkulu izakuba khona kokuphela; akulalutho olungengezwa kukho loba kususwe kukho. UNkulunkulu uyenza lokho ukuze abantu bamkhonze."]},{"type":"verse","number":15,"content":[{"text":"Loba yini ekhona seyake yaba khona,","poem":1},{"text":"kulalokho okuzakuba khona sekwaba khona ngaphambili;","poem":2},{"lineBreak":true},{"text":"njalo uNkulunkulu uzakubalisa okwedlulayo.","poem":2}]},{"type":"verse","number":16,"content":["Njalo ngabona okunye ngaphansi kwelanga:",{"text":"endaweni yokwahlulela, ububi babukhona,","poem":1},{"text":"endaweni yokulungisa, ububi babukhona.","poem":2}]},{"type":"verse","number":17,"content":["Ngacabanga ngenhliziyo yami,",{"text":"“UNkulunkulu uzabehlulela","poem":1},{"text":"bonke abalungileyo lababi,","poem":2},{"text":"ngoba sizaba khona isikhathi sezenzakalo zonke,","poem":1},{"text":"isikhathi sawo wonke umsebenzi.”","poem":2}]},{"type":"verse","number":18,"content":["Ngacabanga njalo ngathi, “UNkulunkulu uyabahlola abantu ukuze babone ukuthi banjengezinyamazana."]},{"type":"verse","number":19,"content":["Isiphetho somuntu siyafana lesezinyamazana; isiphetho sinye sibalindele bonke: njengoba lokhu kuyafa, kanjalo lokunye kuyafa. Konke kokubili kulomphefumulo munye; umuntu kangcono kulenyamazana. Konke kuyize."]},{"type":"verse","number":20,"content":["Konke kuya ndawo yinye; konke kuvela othulini, yikho konke kubuyela othulini."]},{"type":"verse","number":21,"content":["Ngubani owaziyo ingabe umphefumulo womuntu uyakhwela uye phezulu kuthi owenyamazana wehlele phansi phakathi emhlabathini?”"]},{"type":"verse","number":22,"content":["Yikho ngabona ukuthi kakukho okungcono emuntwini ngaphandle kokuthi akholise umsebenzi wakhe ngoba leso yiso isabelo sakhe. Ngoba kambe ngubani ongamenza ukuthi abone lokho okuzakwenzakala yena esedlule?"]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ECC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ECC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ECC/2.json","previousChapterAudioLinks":{},"numberOfVerses":22}