{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ECC","translationId":"nde_bib","name":"UMtshumayeli","commonName":"UMtshumayeli","title":"UMtshumayeli","order":21,"numberOfChapters":12,"sha256":"e1094335c9804c31de01cfc04ef50953437f9f7e48739ca7f220e53357d56de8","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/nde_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":4,"content":[{"type":"heading","content":["Ukuhlupheka, Ukusebenza Nzima, Ukuswela Umngane"]},{"type":"verse","number":1,"content":["Ngakhangela njalo ngabona konke ukuncindezelwa okwakukhona ngaphansi kwelanga:",{"text":"Ngabona inyembezi zabancindezelwayo","poem":1},{"text":"babengelabaduduzi;","poem":2},{"text":"amandla ayekulaba abancindezelayo","poem":1},{"text":"abalaye umduduzi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngangifakaza ukuthi abafileyo,","poem":1},{"text":"abavele sebefile,","poem":2},{"text":"bayathokoza kulabaphilayo,","poem":1},{"text":"abalokhu besaphila.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kodwa okungcono kulakho kokubili","poem":1},{"text":"ngulowo ongakabikhona,","poem":2},{"text":"ongakaboni ububi","poem":1},{"text":"obenziwayo ngaphansi kwelanga.","poem":2}]},{"type":"verse","number":4,"content":["Ngasengibona ukuthi konke ukusebenza lokuphumelela konke kuvela emhawini womuntu ngomakhelwane wakhe. Lokhu lakho kuyize, kuyikuxotshana lomoya."]},{"type":"verse","number":5,"content":[{"text":"Isiwula sigoqa izandla zaso","poem":1},{"text":"sidilize impilo yaso.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kungcono isandla esisodwa esigcweleyo silokuthula","poem":1},{"text":"kulezandla ezimbili ezingagcwalanga ezilomtshikatshika","poem":2},{"lineBreak":true},{"text":"lokuxotshana lomoya.","poem":2}]},{"type":"verse","number":7,"content":["Njalo ngabona okunye okuyize ngaphansi kwelanga:"]},{"type":"verse","number":8,"content":[{"text":"Kwakulendoda eyayiyodwa zwi;","poem":1},{"text":"yayingelandodana loba umfowabo.","poem":2},{"text":"Yayisebenza gadalala ingaphumuli,","poem":1},{"text":"kodwa amehlo ayo ayengasuthiswa yinotho yayo.","poem":2},{"text":"Yabuza yathi, “Ngiginqela bani kangaka,","poem":1},{"text":"njalo kungani ngizincitsha intokozo?”","poem":2},{"text":"Lokhu lakho kuyize","poem":1},{"text":"umsebenzi othelela usizi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ababili bangcono kuloyedwa,","poem":1},{"text":"ngoba balomvuzo obonakalayo ngomsebenzi wabo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Omunye angawa,","poem":1},{"text":"umngane wakhe uyamncedisa amvuse.","poem":2},{"text":"Kodwa maye lowomuntu owayo","poem":1},{"text":"kungelamuntu ongamsiza amvuse!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Njalo nxa ababili belala ndawonye bazakhudumezana.","poem":1},{"text":"Kanti umuntu angakhudumala kanjani eyedwa na?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Loba umuntu engehlulwa nxa eyedwa,","poem":1},{"text":"ababili bangazivikela.","poem":2},{"text":"Intambo elemicu emithathu kayiqamuki lula.","poem":1}]},{"type":"heading","content":["Ukuphiwa Isikhundla Kuyize"]},{"type":"verse","number":13,"content":["Lingcono ijaha elingumyanga kodwa lihlakaniphile kulenkosi endala eyisiwula eyalayo ukwamukela izixwayiso."]},{"type":"verse","number":14,"content":["Ijaha lelo kungabe ngeliphuma ejele libe yinkosi, loba lingelazalelwa ebuyangeni elizweni lalowombuso."]},{"type":"verse","number":15,"content":["Ngabona ukuthi bonke ababephila behamba ngaphansi kwelanga balilandela lelojaha elathatha isikhundla sobukhosi."]},{"type":"verse","number":16,"content":["Amakhosi la (endala lencinyane) kungabe ayelodumo elandelwa ngabantu abanengi abangelakubalwa. Kodwa izizukulwane ezilandelayo azimthandanga lowo owathatha ubukhosi. Lokhu lakho kuyize, yikuxotshana lomoya."]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ECC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ECC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ECC/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}