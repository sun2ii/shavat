{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ECC","translationId":"nde_bib","name":"UMtshumayeli","commonName":"UMtshumayeli","title":"UMtshumayeli","order":21,"numberOfChapters":12,"sha256":"e1094335c9804c31de01cfc04ef50953437f9f7e48739ca7f220e53357d56de8","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/nde_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":7,"content":[{"type":"heading","content":["Inhlakanipho"]},{"type":"verse","number":1,"content":[{"text":"Ibizo elihle lingcono kulamakha amnandi,","poem":1},{"text":"lelanga lokufa lingcono kulelanga lokuzalwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kungcono ukuya endlini yesililo","poem":1},{"text":"kulokuya endlini yamadili,","poem":2},{"text":"ngoba ukufa kuyisiphetho somuntu wonke;","poem":1},{"text":"abaphilayo kabakunanzelele lokho.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Usizi lungcono kulokuhleka,","poem":1},{"text":"ngoba ubuso obudanileyo buyayisiza inhliziyo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inhliziyo yabahlakaniphileyo isendlini yokulila,","poem":1},{"text":"kodwa inhliziyo yeziwula isendlini yokuzithokozisa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kungcono ukulalela izixwayiso zomuntu ohlakaniphileyo","poem":1},{"text":"kulokulalela ingoma yeziwula.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Njengokuchachamba kwameva ngaphansi kwembiza,","poem":1},{"text":"lunjalo uhleko lweziwula.","poem":2},{"lineBreak":true},{"text":"Lokhu lakho kuyize.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ukuqilibezela kwenza ohlakaniphileyo abe yisiwula,","poem":1},{"text":"lesivalamlomo siyayona inhliziyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Isiphetho sendaba singcono kulokuqala kwayo,","poem":1},{"text":"lokubekezela kungcono kulokuqinisa intamo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ungaphangisi ukufuthelana ngaphakathi,","poem":1},{"text":"ngoba ulaka luhlezi lugonwe yiziwula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ungaze wathi, “Kungani insuku zayizolo zazingcono kulalezi?”","poem":1},{"text":"Ngoba kakukuhle ukubuza imibuzo enjalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ukuhlakanipha, njengelifa, kuyinto enhle","poem":1},{"text":"njalo kuyabasiza bonke abaphilayo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ukuhlakanipha kuyisiphephelo","poem":1},{"text":"njengoba imali iyisiphephelo,","poem":2},{"text":"kodwa ubungcono bolwazi yilobu:","poem":1},{"text":"ukuthi ukuhlakanipha kuyayilondoloza impilo yalowo olakho.","poem":2}]},{"type":"verse","number":13,"content":["Nakana ngalokho uNkulunkulu akwenzayo:",{"text":"Ngubani ongakuqondisa","poem":1},{"text":"lokho akwenze kwagoba na?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngezikhathi konke kukuhle, thokoza;","poem":1},{"text":"kodwa ngezikhathi zobubi, cabanga ukuthi:","poem":2},{"text":"uNkulunkulu ukwenzile lokhu","poem":1},{"text":"kanye lalokhuyana njalo.","poem":2},{"text":"Ngakho-ke umuntu ngeke akwazi","poem":1},{"text":"ukuthi ikusasa lakhe lizakuba yini.","poem":2}]},{"type":"verse","number":15,"content":["Kuyonale impilo yami eyize sengizibonile izinto lezi zombili:",{"text":"umuntu olungileyo uyafa elungile enjalo,","poem":1},{"text":"lomuntu omubi uba lempilo enhle emubi enjalo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ungalungi wedlulise,","poem":1},{"text":"futhi ungabi lokuhlakanipha okweqileyo","poem":2},{"lineBreak":true},{"text":"kambe uzibulalelani na?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ungaxhwali okudlulisileyo,","poem":1},{"text":"njalo ungabi yisiwula","poem":2},{"lineBreak":true},{"text":"kambe ufelani singakafiki isikhathi sakho?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kuhle ukuthi uthi ubambe lokhu","poem":1},{"text":"ungayekeli uphunyukwe ngokunye.","poem":2},{"lineBreak":true},{"text":"Umuntu owesaba uNkulunkulu kedlulisi amalawulo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ukuhlakanipha kwenza umuntu ohlakaniphileyo oyedwa abe lamandla","poem":1},{"text":"kulababusi abalitshumi edolobheni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Akulamuntu loyedwa olungileyo emhlabeni","poem":1},{"text":"owenza okulungileyo ongazake enze isono.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ungaphiki ngokulalela wonke amazwi akhulunywa ngabantu,","poem":1},{"text":"funa uzwe inceku yakho ikuthuka","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ngoba uyakwazi enhliziyweni yakho","poem":1},{"text":"ukuthi wena ngokwakho uyawubathuke abanye.","poem":2}]},{"type":"verse","number":23,"content":["Konke lokhu ngakuhlolisisa ngokuhlakanipha ngathi,",{"text":"“Ngizimisele ukuhlakanipha”","poem":1},{"text":"kodwa lokhu kwakungaphezu kwami.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ukuhlakanipha okungabe kukhona,","poem":1},{"text":"kukhatshana kakhulu njalo kuzikile kakhulu:","poem":2},{"lineBreak":true},{"text":"ngubani ongakufinyelela na?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ngasengibeka ingqondo yami ukuthi ngizwisise,","poem":1},{"text":"ngidingisise njalo ngichwayisise ukuhlakanipha kanye lesimo sezinto","poem":2},{"text":"lokuzwisisa ubuphukuphuku bokuxhwala","poem":1},{"text":"lobuhlanya lobuwula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ngibona ukuthi uyingozi eyedlula ukufa","poem":1},{"text":"umfazi ongumjibila,","poem":2},{"text":"onhliziyo yakhe iyisithiyo","poem":1},{"text":"njalo ozandla zakhe zingamaketane.","poem":2},{"text":"Indoda eyesaba uNkulunkulu izaphepha kuye,","poem":1},{"text":"kodwa isigangi uzasihilela.","poem":2}]},{"type":"verse","number":27,"content":["Uthi uMtshumayeli, “Khangela, nanku esengikunanzelele:",{"text":"Ngihlanganisa lokhu lalokhu ngizama ukubona isimo sezinto","poem":1}]},{"type":"verse","number":28,"content":[{"text":"ngilokhu ngisachwayisisa","poem":2},{"lineBreak":true},{"text":"kodwa ngingatholi","poem":2},{"text":"ngafumanisa indoda eyodwa elungileyo kwabayinkulungwane,","poem":1},{"text":"kodwa ngitsho loyedwa umfazi oqondileyo kubo.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yilokhu kuphela esengikufumene:","poem":1},{"text":"UNkulunkulu wamenza umuntu wabaqotho,","poem":2},{"lineBreak":true},{"text":"kodwa abantu basuka bazenzele okwabo.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ECC/6.json","previousChapterAudioLinks":{},"numberOfVerses":29}