{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"EXO","translationId":"nde_bib","name":"U-Eksodasi","commonName":"U-Eksodasi","title":"U-Eksodasi","order":2,"numberOfChapters":40,"sha256":"192a794be0cb07dbb50e01b3077d520f7b93d57de2a8766be4047f7ed92fb645","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/nde_bib/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":15,"content":[{"type":"heading","content":["Ingoma KaMosi LoMiriyemu"]},{"type":"verse","number":1,"content":["Ngakho uMosi labako-Israyeli basebehlabelela lelihubo kuThixo:",{"text":"“Ngizamhlabelela uThixo","poem":1},{"text":"ngoba uphakeme kakhulu.","poem":2},{"text":"Ibhiza lomgadi walo","poem":1},{"text":"ukuphosele ngamandla olwandle.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"UThixo ungamandla ami lehubo lami;","poem":1},{"text":"useyikusindiswa kwami.","poem":2},{"text":"UnguNkulunkulu wami, ngizamdumisa;","poem":1},{"text":"uNkulunkulu kababa ngizamphakamisa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"UThixo ulibutho;","poem":1},{"text":"nguThixo ibizo lakhe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Izinqola zikaFaro lempi yakhe","poem":1},{"text":"ukuphosele ngamandla olwandle.","poem":2},{"text":"Izikhulu zikaFaro ezithenjiweyo,","poem":1},{"text":"zigalule oLwandle oluBomvu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inziki zamanzi zibagubuzele;","poem":1},{"text":"batshona ekujuleni njengelitshe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isandla sakho sokunene, Oh Thixo,","poem":1},{"text":"saba lamandla obukhosi.","poem":2},{"text":"Isandla sakho sokunene, Oh Thixo,","poem":1},{"text":"sasihlikiza isitha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ebukhulwini bobukhosi bakho","poem":1},{"text":"wabasakazela phansi abakuphikisayo.","poem":2},{"text":"Wavulela ulaka lwakho oluvuthayo,","poem":1},{"text":"lwabatshisa njengencwathi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngokuphefumula kwamakhala akho","poem":1},{"text":"amanzi aqoqana aba yinqwaba.","poem":2},{"text":"Amanzi ageleza ngenhlokomo ema enza udonga;","poem":1},{"text":"amanzi azikileyo ajiya enzikini yolwandle.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isitha sakloloda sathi,","poem":1},{"text":"‘Ngizabaxhuma, ngibedlule.","poem":2},{"text":"Ngizakwaba impango;","poem":1},{"text":"ngizazitika ngokungokwabo.","poem":2},{"text":"Ngizakhokha inkemba yami,","poem":1},{"text":"isandla sami sibabhubhise.’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kodwa wena wavuthela ngomoya wokuphefumula kwakho,","poem":1},{"text":"ulwandle lwabasibekela.","poem":2},{"text":"Batshona njengomnuso","poem":1},{"text":"emanzini esabekayo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngubani kubonkulunkulu bonke","poem":1},{"text":"onjengawe, Thixo?","poem":2},{"text":"Ngubani onjengawe,","poem":1},{"text":"olobukhosi ebungcweleni bakhe,","poem":2},{"text":"owesabekayo ngenkazimulo,","poem":1},{"text":"owenza izimangaliso?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Welula isandla sakho sokunene","poem":1},{"text":"umhlabathi uziginye izitha zakho.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngothando lwakho olungapheliyo uzabahola","poem":1},{"text":"abantu obahlengileyo.","poem":2},{"text":"Ngamandla akho uzabaholela","poem":1},{"text":"endaweni yakho engcwele.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Izizwe zizakuzwa zithuthumele;","poem":1},{"text":"umhedehede ubahlukuluze abantu baseFilistiya.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Izinduna zase-Edomi zizatshaywa luvalo,","poem":1},{"text":"abakhokheli baseMowabi bafikelwe yikwesaba,","poem":2},{"text":"abantu baseKhenani banyamalale nya!","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Ukwesaba lokuthuthumela kuzabehlela.","poem":2},{"text":"Ngamandla engalo yakho,","poem":1},{"text":"bazathula njengelitshe,","poem":2},{"text":"abantu bakho baze bedlule, Oh Thixo,","poem":1},{"text":"abantu owabadalayo baze bedlule.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Uzabangenisa ubahlanyele","poem":1},{"text":"entabeni yelifa lakho,","poem":2},{"text":"indawo, Oh Thixo,","poem":1},{"text":"owayenzela ukuthi uhlale kuyo,","poem":2},{"text":"indawo engcwele, Oh Thixo,","poem":1},{"text":"eyamiswa ngezandla zakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"UThixo uzabusa","poem":1},{"text":"kuze kube nini lanini.”","poem":2}]},{"type":"verse","number":19,"content":["Kwathi lapho amabhiza kaFaro, izinqola kanye labagadi bamabhiza sebengenile olwandle, uThixo wawabuyisa amanzi alo phezu kwabo, kodwa abako-Israyeli bona bazihambela badabula ulwandle phezu komhlabathi owomileyo."]},{"type":"verse","number":20,"content":["Khonapho uMiriyemu umphrofethikazi, udadewabo ka-Aroni, wathatha isigubhu sakhe ngesandla, bamlandela bonke abesifazane bephethe izigubhu begida."]},{"type":"verse","number":21,"content":["UMiriyemu wabahlabelela wathi:",{"text":"“Mhlabeleleni uThixo","poem":1},{"text":"ngoba uphakeme kakhulu.","poem":2},{"text":"Ibhiza lomgadi walo","poem":1},{"text":"ukuphosele ngamandla olwandle.”","poem":2}]},{"type":"heading","content":["Amanzi EMara Le-Elimi"]},{"type":"verse","number":22,"content":["UMosi wasebahola abako-Israyeli basuka oLwandle Olubomvu baya enkangala yeShuri bengatholi manzi."]},{"type":"verse","number":23,"content":["Kwathi befika eMara behluleka ukunatha amanzi akhona ngoba ayebaba. (Yikho indawo leyo kuthiwa yiMara.)"]},{"type":"verse","number":24,"content":["Abantu basebekhonona kuMosi besithi, “Sinatheni-ke manje?”"]},{"type":"verse","number":25,"content":["UMosi wasekhala kuThixo, uThixo wasemtshengisa isigojwana. Wasiphosela emanzini, amanzi aphenduka aba mnandi. Khonapho uThixo wabenzela isimiso lomthetho, njalo khonapho wabalinga."]},{"type":"verse","number":26,"content":["Wathi, “Nxa lilalela kakuhle ilizwi likaThixo uNkulunkulu wenu, lenze okulungileyo kuye, lilandele imilayo yakhe njalo ligcine lezimiso zakhe, kangisoze ngilehlisele iziga lezo engazehlisela amaGibhithe; ngoba nginguThixo olisilisayo.”"]},{"type":"verse","number":27,"content":["Basebefika e-Elimi lapho okwakulemithombo yamanzi elitshumi lambili khona, lezihlahla zelala ezingamatshumi ayisikhombisa. Basebemisa khona lapho eduze kwamanzi."]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}