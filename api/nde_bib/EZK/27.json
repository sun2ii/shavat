{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"EZK","translationId":"nde_bib","name":"UHezekhiyeli","commonName":"UHezekhiyeli","title":"UHezekhiyeli","order":26,"numberOfChapters":48,"sha256":"2911cbec6fb243baec46c34637622c1f7188478716b86948986b8ccdc706d864","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/nde_bib/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":27,"content":[{"type":"heading","content":["Ukulilela IThire"]},{"type":"verse","number":1,"content":["Ilizwi likaThixo lafika kimi lisithi:"]},{"type":"verse","number":2,"content":["“Ndodana yomuntu, khala isililo ngeThire,"]},{"type":"verse","number":3,"content":["uthi kuyo iThire esesangweni lasolwandle, yona engumthengiseli wabantu abanengi abangasolwandle, ‘Nanku okutshiwo nguThixo Wobukhosi:",{"text":"Wena Thire uthi,","poem":1},{"text":"“Ngiphelele ngobuhle.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Umbuso wakho wawuphakathi kolwandle;","poem":1},{"text":"abakhi bakho baphelelisa ubuhle bakho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wonke amapulanka akho","poem":1},{"text":"bawenza ngezihlahla zejanipha ezivela eSeniri;","poem":2},{"text":"bathatha umsedari eLebhanoni","poem":1},{"text":"ukuba bakwenzele insika.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngemi-okhi eyavela eBhashani","poem":1},{"text":"bakwenzela amaphini okugwedla izikepe;","poem":2},{"text":"ngezigodo zomsipresi ezavela ngasolwandle lwaseKhithimi","poem":1},{"text":"benza indawo yokuhamba kuyo, yendlalwe impondo zendlovu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iseyili lakho kwakuyilineni elihle elicecisiweyo elavela eGibhithe,","poem":1},{"text":"elaba yilona phawu lwakho;","poem":2},{"text":"amaseyili akho okusitha ilanga ayengawokuluhlaza lokuyibubende","poem":1},{"text":"okwavela ngasolwandle lwase-Elisha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Amadoda aseSidoni le-Avadi ayengabagwedli bakho;","poem":1},{"text":"izazi zakho, wena Thire,","poem":2},{"lineBreak":true},{"text":"zazisemkhunjini njengabatshayeli bomkhumbi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Izingcwethi ezindala zaseGebhali zaziphakathi komkhumbi","poem":1},{"text":"njengabalungisi bemikhumbi ukuba bagcike imiphetho yakho.","poem":2},{"text":"Yonke imikhumbi yasolwandle labatshayeli bayo","poem":1},{"text":"yeza ikanye lawe ukuzathenga impahla zakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Amadoda asePhezhiya, leLudi kanye lePhuthi","poem":1},{"text":"asebenza njengamabutho ebuthweni lakho.","poem":2},{"text":"Alengisa amahawu awo lezingowane emidulini yakho,","poem":1},{"text":"akulethela ubuhle obukhulu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amadoda ase-Avadi kanye leHelekhi","poem":1},{"text":"abakhona emidulini yakho ezinhlangothini zonke;","poem":2},{"text":"amadoda aseGamadi","poem":1},{"text":"ayesemiphotshongweni yakho.","poem":2},{"text":"Aphanyeka amahawu awo inxa zonke zemiduli yakho;","poem":1},{"text":"aphelelisa ubuhle bakho.","poem":2}]},{"type":"verse","number":12,"content":["IThashishi yathengiselana lawe ngenxa yenotho yezimpahla zakho ezinengi; impahla yakho ethengiswayo bayithenga ngesiliva, insimbi, ithusi kanye lomnuso."]},{"type":"verse","number":13,"content":["IJavani, leThubhali kanye leMesheki athengiselana lawe, athenga impahla zakho ngezigqili langezinto ezenziwe ngethusi."]},{"type":"verse","number":14,"content":["Abantu baseBhethi Thogarima bathenga impahla zakho ngamabhiza omsebenzi, amabhiza empi kanye lezimbongolo."]},{"type":"verse","number":15,"content":["Abantu baseRodesi bathengiselana lawe, njalo amazwe amanengi angasolwandle athenga kuwe, akubhadala ngempondo zendlovu langesihlahla esithiwa yi-ebhoni."]},{"type":"verse","number":16,"content":["I-Aramu yathengiselana lawe ngenxa yezimpahla zakho ezinengi, impahla zakho ezithengiswayo bazithenga ngamatshe aligugu aluhlaza, amalembu alubende, umsebenzi ocecisiweyo, ilineni elihle, ikhorali langelitshe eliligugu elibomvu."]},{"type":"verse","number":17,"content":["UJuda lo-Israyeli bathengiselana lawe; impahla zakho ezithengiswayo bazithenga ngengqoloyi eyavela eMinithi langokumnandi, uluju, amafutha kanye lenhlaka."]},{"type":"verse","number":18,"content":["Ngenxa yezimpahla zakho ezinengi kanye lenotho enkulu yempahla, iDamaseko yathengiselana lawe ngewayini elivela eHelibhoni langewulu evela eZahari."]},{"type":"verse","number":19,"content":["AbakoDani lamaGrikhi avela e-Uzali athenga impahla zakho; azithenga ngensimbi ekhandiweyo, langekhasiya kanye lekhalamusi."]},{"type":"verse","number":20,"content":["IDedani yathengiselana lawe ngezingubo zezihlalo."]},{"type":"verse","number":21,"content":["I-Arabhiya lazozonke izikhulu zaseKhedari babethenga kuwe; bathengiselana lawe ngezimvu, inqama kanye lembuzi."]},{"type":"verse","number":22,"content":["Abathengi baseShebha labaseRahama bathengiselana lawe; impahla zakho bazithenga ngezinhlobo zonke ezinhle zeziyoliso langamatshe aligugu kanye legolide."]},{"type":"verse","number":23,"content":["IHarani, leKhane le-Edeni kanye labathengi baseShebha, le-Asiriya kanye leKhilimadi bathengiselana lawe."]},{"type":"verse","number":24,"content":["Endaweni yakho yokuthengiselana, bakuthengisela izembatho ezinhle, amalembu aluhlaza, imisebenzi ececisiweyo kanye lamajali alemibala eminengi lezintshaka eziphothiweyo njalo zilamafindo abotshwe aqina."]},{"type":"verse","number":25,"content":[{"text":"Imikhumbi yaseThashishi","poem":1},{"text":"isebenza ukuthwala impahla zakho.","poem":2},{"text":"Ugcwele impahla ezinzima","poem":1},{"text":"enzikini yolwandle.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Abagwedli bakho","poem":1},{"text":"bakusa elwandle olukhulu.","poem":2},{"text":"Kodwa umoya wasempumalanga uzakwephula ube","poem":1},{"text":"yiziqayiqa enzikini yolwandle.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Inotho yakho, okuthengiswayo kanye lempahla,","poem":1},{"text":"abatshayeli bakho, labaqondisi kanye labalungisi bemikhumbi,","poem":2},{"text":"abathengisi bakho lawo wonke amabutho akho,","poem":1},{"text":"labanye bonke abaphakathi komkhumbi","poem":2},{"text":"bazatshona enzikini yolwandle","poem":1},{"text":"ngosuku lokonakala komkhumbi.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Amazwe angaselwandle azanyikinyeka","poem":1},{"text":"lapho abahambisa umkhumbi bakho sebehlaba umkhosi.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Bonke abaphethe amaphini okugwedla","poem":1},{"text":"bazayitshiya imikhumbi yabo;","poem":2},{"text":"abatshayeli bayo kanye labaqondisi bayo bonke","poem":1},{"text":"bazakuma ekhunjini.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Bazaphakamisa amazwi abo","poem":1},{"text":"bakhale kabuhlungu ngawe;","poem":2},{"text":"bazathela uthuli emakhanda abo","poem":1},{"text":"bagiqike emlotheni.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Bazaphuca amakhanda abo ngenxa yakho","poem":1},{"text":"njalo bazagqoka amasaka.","poem":2},{"text":"Bazaqhinqa isililo ngawe","poem":1},{"text":"ngesililo esibuhlungu.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Lapho bekukhalela bekulilela","poem":1},{"text":"bazaqhinqa isililo ngawe bathi,","poem":2},{"text":"“Ngubani owake wathuliswa njengeThire,","poem":1},{"text":"elizungezwe lulwandle na?”","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ekuphumeni kwempahla yakho elwandle","poem":1},{"text":"wasuthisa izizwe ezinengi;","poem":2},{"text":"ngenotho yakho enengi langempahla yakho","poem":1},{"text":"wanothisa amakhosi omhlaba.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Khathesi usuphahlazwe lulwandle","poem":1},{"text":"ezinzikini zamanzi:","poem":2},{"text":"impahla yakho lenhlanganiso yakho yonke","poem":1},{"text":"kuzatshona phansi kanye lawe.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Bonke abahlala emazweni angasolwandle","poem":1},{"text":"balokwesaba ngawe;","poem":2},{"text":"amakhosi abo ayathuthumela ngokwesaba","poem":1},{"text":"lobuso bawo bunyukubaliswe luvalo.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Abathengi phakathi kwezizwe bayakuncifela;","poem":1},{"text":"usufike ekucineni okwesabekayo,","poem":2},{"lineBreak":true},{"text":"njalo kawuyikuba khona futhi.’ ”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/EZK/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/EZK/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/EZK/26.json","previousChapterAudioLinks":{},"numberOfVerses":36}