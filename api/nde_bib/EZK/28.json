{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"EZK","translationId":"nde_bib","name":"UHezekhiyeli","commonName":"UHezekhiyeli","title":"UHezekhiyeli","order":26,"numberOfChapters":48,"sha256":"2911cbec6fb243baec46c34637622c1f7188478716b86948986b8ccdc706d864","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/nde_bib/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":28,"content":[{"type":"heading","content":["Isiphrofethi Ngokumelana Lenkosi YaseThire"]},{"type":"verse","number":1,"content":["Ilizwi likaThixo lafika kimi lisithi:"]},{"type":"verse","number":2,"content":["“Ndodana yomuntu, tshono kumbusi waseThire uthi, ‘Nanku okutshiwo nguThixo Wobukhosi:",{"text":"Ngokuzigqaja kwenhliziyo yakho","poem":1},{"text":"uthi, “Ngingunkulunkulu;","poem":2},{"text":"ngihlala esihlalweni sobukhosi sikankulunkulu","poem":1},{"text":"enzikini yezilwandle.”","poem":2},{"text":"Kodwa wena ungumuntu hatshi uNkulunkulu,","poem":1},{"text":"lanxa ucabanga ukuthi uhlakaniphe njengoNkulunkulu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kambe uhlakaniphile kuloDanyeli na?","poem":1},{"text":"Akulamfihlo esithekileyo kuwe na?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngenhlakanipho yakho lokuqedisisa","poem":1},{"text":"uzizuzele inotho","poem":2},{"text":"njalo wabuthela igolide lesiliva","poem":1},{"text":"eziphaleni zengcebo yakho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngolwazi lwakho olukhulu ekuthengiseni","poem":1},{"text":"uyandisile inotho yakho,","poem":2},{"text":"njalo ngenxa yenotho yakho,","poem":1},{"text":"inhliziyo yakho isizigqaja.","poem":2}]},{"type":"verse","number":6,"content":["Ngakho nanku okutshiwo nguThixo Wobukhosi:",{"text":"Njengoba ucabanga ukuthi uhlakaniphile,","poem":1},{"text":"uhlakaniphe njengoNkulunkulu,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ngizaletha abezizweni ukuba bamelane lawe,","poem":1},{"text":"izizwe ezilesihluku kakhulu;","poem":2},{"text":"zizahwatsha inkemba zazo zimelane lobuhle bakho","poem":1},{"text":"kanye lenhlakanipho,","poem":2},{"lineBreak":true},{"text":"zone lobuhle bakho obukhazimulayo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zizakwehlisela phansi egodini,","poem":1},{"text":"njalo uzakufa kabuhlungu","poem":2},{"lineBreak":true},{"text":"enzikini yezilwandle.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Lapho-ke uzakutsho na phambi kwalabo abakubulalayo ukuthi,","poem":1},{"text":"“Mina ngingunkulunkulu?”","poem":2},{"text":"Uzakuba ngumuntu nje, hatshi unkulunkulu,","poem":1},{"text":"ezandleni zalabo abakubulalayo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Uzakufa ukufa kwabangasokanga","poem":1},{"text":"ezandleni zabezizweni.","poem":2},"Sengikhulumile, kutsho uThixo Wobukhosi.’ ”"]},{"type":"line_break"},{"type":"verse","number":11,"content":["Ilizwi likaThixo lafika kimi lisithi:"]},{"type":"verse","number":12,"content":["“Ndodana yomuntu, khala isililo ngenkosi yaseThire uthi kuyo: ‘Nanku okutshiwo nguThixo Wobukhosi:",{"text":"Wawuyisibonelo sokuphelela","poem":1},{"text":"ugcwele inhlakanipho lobuhle obupheleleyo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wawuse-Edeni","poem":1},{"text":"isivande sikaNkulunkulu;","poem":2},{"text":"waceca ngawo wonke amatshe aligugu:","poem":1},{"text":"irubhi, lethophazi le-emeralidi,","poem":2},{"lineBreak":true},{"text":"ikhrisolithe, i-onikisi lejaspa,","poem":2},{"lineBreak":true},{"text":"isafire, ithukhwayizi lebherili.","poem":2},{"text":"Izibonakaliso zakho lezisekelo kwakwenziwe ngegolide;","poem":1},{"text":"kwalungiswa ngosuku owadalwa ngalo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wagcotshwa njengekherubhi elondlayo,","poem":1},{"text":"ngoba ngakumisela lokho.","poem":2},{"text":"Wawuphezu kwentaba engcwele kaNkulunkulu;","poem":1},{"text":"wahamba phakathi kwamatshe avutha umlilo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wawungelasici ezindleleni zakho","poem":1},{"text":"kusukela ngosuku owadalwa ngalo","poem":2},{"lineBreak":true},{"text":"ububi baze bafunyanwa kuwe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngenxa yokuthengisa kwakho ezindaweni ezinengi","poem":1},{"text":"wagcwala udlakela,","poem":2},{"lineBreak":true},{"text":"wasusona.","poem":2},{"text":"Ngakho ngakususa njengehlazo entabeni kaNkulunkulu,","poem":1},{"text":"njalo ngakuxotsha, wena kherubhi elondlayo,","poem":2},{"lineBreak":true},{"text":"phakathi kwamatshe avutha umlilo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Inhliziyo yakho yazigqaja","poem":1},{"text":"ngenxa yobuhle bakho,","poem":2},{"text":"njalo wonakalisa inhlakanipho yakho","poem":1},{"text":"ngenxa yobucwazicwazi bakho.","poem":2},{"text":"Ngakho ngakuphosela emhlabeni;","poem":1},{"text":"ngakwenza umbukiso phambi kwamakhosi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngezono zakho ezinengi lokuthengisa lobuqili","poem":1},{"text":"usungcolise izindawo zakho ezingcwele.","poem":2},{"text":"Ngakho ngaphemba umlilo phakathi kwakho","poem":1},{"text":"wakutshisa wakuqeda,","poem":2},{"text":"njalo ngakwenza waba ngumlotha emhlabathini","poem":1},{"text":"phambi kwabo bonke ababekhangele.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Zonke izizwe ezazikwazi","poem":1},{"text":"zithithibele ngawe;","poem":2},{"text":"usufike ekucineni okwesabekayo","poem":1},{"text":"njalo kawuyikuba khona futhi.’ ”","poem":2}]},{"type":"heading","content":["Isiphrofethi Ngokumelana LeSidoni"]},{"type":"verse","number":20,"content":["Ilizwi likaThixo lafika kimi lisithi:"]},{"type":"verse","number":21,"content":["“Ndodana yomuntu, khangelisa ubuso bakho eSidoni; uphrofithe okubi ngalo"]},{"type":"verse","number":22,"content":["uthi: ‘Nanku okutshiwo nguThixo Wobukhosi:",{"text":"Ngimelana lawe, wena Sidoni,","poem":1},{"text":"njalo ngizathola udumo phakathi kwakho.","poem":2},{"text":"Bazakwazi ukuthi mina nginguThixo","poem":1},{"text":"lapho sengiletha isijeziso kulo","poem":2},{"lineBreak":true},{"text":"njalo ngizibonakalisa ngingongcwele phakathi kwalo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ngizathumela isifo kulo,","poem":1},{"text":"ngenze igazi ligeleze ezindleleni zalo.","poem":2},{"text":"Abafileyo bazakuba phakathi kwalo,","poem":1},{"text":"inkemba imelane lalo amacele wonke.","poem":2},{"text":"Lapho-ke bazakwazi ukuthi mina nginguThixo.","poem":1}]},{"type":"verse","number":24,"content":["Abantu bako-Israyeli kabasayikuba labomakhelwane abalenhliziyo ezimbi njalo abangameva abuhlungu lameva ahlabayo. Lapho-ke bazakwazi ukuthi mina nginguThixo Wobukhosi."]},{"type":"verse","number":25,"content":["Nanku okutshiwo nguThixo Wobukhosi: Lapho sengiqoqa abantu bako-Israyeli ezizweni ababehlakazelwe kuzo, ngizazibonakalisa ngingongcwele phakathi kwabo phambi kwezizwe. Emva kwalokho bazahlala elizweni labo, engalinika inceku yami uJakhobe."]},{"type":"verse","number":26,"content":["Bazahlala kulo bevikelekile njalo bazakwakha izindlu bahlanyele lezivini; bazahlala bevikelekile lapho sengiletha isijeziso kubo bonke omakhelwane babo ababaphatha kubi. Lapho-ke bazakwazi ukuthi mina nginguThixo uNkulunkulu wabo.’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/EZK/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/EZK/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/EZK/27.json","previousChapterAudioLinks":{},"numberOfVerses":26}