{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"EZK","translationId":"nde_bib","name":"UHezekhiyeli","commonName":"UHezekhiyeli","title":"UHezekhiyeli","order":26,"numberOfChapters":48,"sha256":"2911cbec6fb243baec46c34637622c1f7188478716b86948986b8ccdc706d864","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/nde_bib/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":30,"content":[{"type":"heading","content":["Ukulilela IGibhithe"]},{"type":"verse","number":1,"content":["Ilizwi likaThixo lafika kimi lisithi:"]},{"type":"verse","number":2,"content":["“Ndodana yomuntu, phrofetha uthi: ‘Nanku okutshiwo nguThixo Wobukhosi:",{"text":"Lilani lithi,","poem":1},{"text":"“Maye ngalolosuku!”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngoba usuku seluseduze,","poem":1},{"text":"usuku lukaThixo seluseduze","poem":2},{"text":"usuku lwamayezi,","poem":1},{"text":"isikhathi sokutshabalala kwezizwe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inkemba izakumelana leGibhithe,","poem":1},{"text":"losizi luzakwehlela phezu kukaKhushi.","poem":2},{"text":"Lapho ababuleweyo besiwa eGibhithe","poem":1},{"text":"inotho yalo izathunjwa","poem":2},{"lineBreak":true},{"text":"lezisekelo zalo zidilizelwe phansi.","poem":2}]},{"type":"verse","number":5,"content":["IKhushi lePhuthi, iLudi le-Arabhiya yonke, iLibhiya kanye labantu belizwe lesivumelwano bazabulawa ngenkemba ndawonye leGibhithe."]},{"type":"verse","number":6,"content":["Nanku okutshiwo nguThixo Wobukhosi:",{"text":"Abasekeli beGibhithe bazakufa,","poem":1},{"text":"lamandla alo aziqhenyayo azaphela.","poem":2},{"text":"Kusukela eMigidoli kusiya e-Asiwani","poem":1},{"text":"bazakuwa ngenkemba phakathi kwalo,","poem":2},{"lineBreak":true},{"text":"kutsho uThixo Wobukhosi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bazachitheka","poem":1},{"text":"phakathi kwamazwe achithekileyo,","poem":2},{"text":"njalo amadolobho abo","poem":1},{"text":"azakuba phakathi kwamadolobho adiliziweyo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lapho-ke bazakwazi ukuthi mina nginguThixo,","poem":1},{"text":"lapho sengithungela iGibhithe ngomlilo","poem":2},{"lineBreak":true},{"text":"labasizi balo bonke sebeqothulwe.","poem":2}]},{"type":"verse","number":9,"content":["Ngalolosuku izithunywa zizaphuma zisuka kimi ngemikhumbi ziyetshayisa iKhushi ngovalo, kuphele ukungazikhathazi kwalo. Bazakwehlelwa lusizi ngosuku lokutshabalala kweGibhithe, ngoba ngempela kuzafika."]},{"type":"line_break"},{"type":"verse","number":10,"content":["Nanku okutshiwo nguThixo Wobukhosi:",{"text":"Ngizawaqeda amaxuku aseGibhithe","poem":1},{"text":"ngesandla sikaNebhukhadineza inkosi yaseBhabhiloni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yena lebutho lakhe, abalolunya olukhulu phakathi kwezizwe,","poem":1},{"text":"bazalethwa ukuba bachithe ilizwe.","poem":2},{"text":"Bazahwatsha izinkemba zabo ukuba bamelane leGibhithe","poem":1},{"text":"bagcwalise ilizwe ngababuleweyo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngizakomisa izifula zeNayili","poem":1},{"text":"lelizwe ngilithengisele abantu ababi;","poem":2},{"text":"ngesandla sabezizweni,","poem":1},{"text":"ngizalichitha ilizwe, lakho konke okukulo.","poem":2},"Mina Thixo sengikhulumile."]},{"type":"line_break"},{"type":"verse","number":13,"content":["Nanku okutshiwo nguThixo Wobukhosi:",{"text":"Ngizachitha izithombe","poem":1},{"text":"ngiqede izifanekiso eMemfisi.","poem":2},{"text":"Akusayikuba khona inkosana eGibhithe,","poem":1},{"text":"njalo ngizaletha ukwesaba kulolonke ilizwe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngizachitha iPhathrosi,","poem":1},{"text":"ngithungele iZowani ngomlilo,","poem":2},{"lineBreak":true},{"text":"besengiletha isijeziso phezu kweThebesi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngizakwehlisela ulaka lwami phezu kwePhelusiyami,","poem":1},{"text":"inqaba yaseGibhithe,","poem":2},{"lineBreak":true},{"text":"ngiqede lamaxuku aseThebesi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngizathungela iGibhithe ngomlilo;","poem":1},{"text":"iPhelusiyami izajanqula ngobuhlungu.","poem":2},{"text":"IThebesi izathunjwa ngesidumo esikhulu;","poem":1},{"text":"iMemfisi izakuba sosizini olumiyo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Amajaha aseHeliyopholisi leBhubhastisi","poem":1},{"text":"azabulawa ngenkemba,","poem":2},{"lineBreak":true},{"text":"lamadolobho wona ngokwawo azathunjwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"EThahiphanesi imini izakuba mnyama,","poem":1},{"text":"lapho ngisephula ijogwe leGibhithe;","poem":2},{"lineBreak":true},{"text":"khonale-ke amandla alo aziqhenyayo azaphela.","poem":2},{"text":"Azakwembeswa ngamayezi,","poem":1},{"text":"njalo imizi yalo izakuya ekuthunjweni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ngokunjalo ngizakwehlisela isijeziso phezu kweGibhithe,","poem":1},{"text":"njalo bazakwazi ukuthi mina nginguThixo.’ ”","poem":2}]},{"type":"verse","number":20,"content":["Ngomnyaka wetshumi lanye, ngenyanga yakuqala ngosuku lwesikhombisa, ilizwi likaThixo lafika kimi lisithi:"]},{"type":"verse","number":21,"content":["“Ndodana yomuntu, sengiyephule ingalo kaFaro inkosi yaseGibhithe. Kayibotshwanga ukuba iphole kumbe ifakwe uhlaka ukuze iqine okwanele ukuthi iphathe inkemba."]},{"type":"verse","number":22,"content":["Ngakho-ke nanku okutshiwo nguThixo Wobukhosi: Ngimelana loFaro inkosi yaseGibhithe. Ngizazephula zombili izingalo zakhe, eqinileyo kanye leyephukileyo, ngenze inkemba iwe esandleni sakhe."]},{"type":"verse","number":23,"content":["Ngizachithela amaGibhithe phakathi kwezizwe ngiwahlakazele emazweni."]},{"type":"verse","number":24,"content":["Ngizaqinisa izingalo zenkosi yaseBhabhiloni ngifake inkemba yami ezandleni zayo, kodwa izingalo zikaFaro ngizazephula, njalo uzabubula phambi kwayo njengomuntu olimale okokufa."]},{"type":"verse","number":25,"content":["Ngizaqinisa izingalo zenkosi yaseBhabhiloni, kodwa izingalo zikaFaro zizakuba buthakathaka. Lapho-ke bazakwazi ukuthi mina nginguThixo lapho sengifaka inkemba yami esandleni senkosi yaseBhabhiloni layo isiyizunguza imelane leGibhithe."]},{"type":"verse","number":26,"content":["Ngizachithela amaGibhithe phakathi kwezizwe ngiwahlakazele emazweni futhi. Lapho-ke azakwazi ukuthi mina nginguThixo.”"]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/EZK/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/EZK/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/EZK/29.json","previousChapterAudioLinks":{},"numberOfVerses":26}