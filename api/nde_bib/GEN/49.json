{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"GEN","translationId":"nde_bib","name":"UGenesisi","commonName":"UGenesisi","title":"UGenesisi","order":1,"numberOfChapters":50,"sha256":"bf86faf5d736148c09abb7c483f683a4467460a8962e27bb681c873a419865ae","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/nde_bib/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":49,"content":[{"type":"heading","content":["UJakhobe Ubusisa Amadodana Akhe"]},{"type":"verse","number":1,"content":["UJakhobe wabiza amadodana akhe wathi: “Sondelani eduze ngilitshele lokho okuzakwenzakala kini ensukwini ezizayo."]},{"type":"verse","number":2,"content":[{"text":"Buthanani lilalele, madodana kaJakhobe,","poem":1},{"text":"lalelani kuyihlo u-Israyeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"URubheni, ulizibulo lami,","poem":1},{"text":"amandla ami, isibonakaliso sokuqala samandla ami,","poem":2},{"lineBreak":true},{"text":"ukuphelela ngodumo, ukuphelela ngamandla.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Uhlokoma njengamanzi, kawusayikuba liciko,","poem":1},{"text":"ngoba wakhwela embhedeni kayihlo,","poem":2},{"lineBreak":true},{"text":"waya phezu kwesihlalo sami wasingcolisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"USimiyoni loLevi bayizelamani","poem":1},{"text":"inkemba zabo yizikhali zodlakela.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mangingangeni enkundleni yabo,","poem":1},{"text":"mangingangeni emhlanganweni wabo,","poem":2},{"text":"ngoba bababulala abantu ngokuthukuthela kwabo","poem":1},{"text":"njalo inkabi baziquma imisipha santando.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Luqalekisiwe ulaka lwabo, lwesabeka kubi,","poem":1},{"text":"lentukuthelo yabo, ilesihluku esibi!","poem":2},{"text":"Ngizakubachithiza kuJakhobe,","poem":1},{"text":"njalo ngibahlakaze ko-Israyeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Juda, abafowenu bazakudumisa;","poem":1},{"text":"isandla sakho sizakuba sentanyeni yezitha zakho;","poem":2},{"lineBreak":true},{"text":"amadodana kayihlo azakukhothamela.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ungumdlwane wesilwane, Oh Juda;","poem":1},{"text":"uvela ekuzingeleni, ndodana yami.","poem":2},{"text":"Njengesilwane uyacathama alale phansi,","poem":1},{"text":"njengesilwanekazi, ngubani olesibindi sokumhlokoza?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Intonga yobukhosi kayiyikusuka kuJuda,","poem":1},{"text":"loba umqwayi wombusi phakathi kwezinyawo zakhe,","poem":2},{"text":"aze ayofika kumnini wayo","poem":1},{"text":"lokulalela kwezizwe kukuye.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Uzabophela ubabhemi wakhe evinini,","poem":1},{"text":"inkonyane kababhemi wakhe ogatsheni oluhle;","poem":2},{"text":"uzagezisa izembatho zakhe ngewayini,","poem":1},{"text":"izigqoko zakhe egazini lamagrebisi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Amehlo akhe azathuba okudlula iwayini,","poem":1},{"text":"amazinyo akhe abe mhlophe kulochago.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"UZebhuluni uzahlala okhunjini lolwandle","poem":1},{"text":"abe litheku lemikhumbi;","poem":2},{"lineBreak":true},{"text":"umngcele wakhe uzaqhelela eSidoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"U-Isakhari ulithambo likababhemi elilohlonzi","poem":1},{"text":"olele ephahlwe ngamasaka amabili emithwalo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Uthi nxa ebona ubuhle bendawo yakhe yokuphumula","poem":1},{"text":"lokubukeka kwelizwe lakhe,","poem":2},{"text":"uzakwehlisa ihlombe lakhe ukuthwala umthwalo","poem":1},{"text":"azimisele emsebenzini wesigqili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"UDani uzakwahlulela kahle abantu bakibo","poem":1},{"text":"njengesinye sezizwe zako-Israyeli.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"UDani uzakuba yinyoka esemgwaqweni,","poem":1},{"text":"inhlangwana elele endleleni,","poem":2},{"text":"eluma izithende zebhiza","poem":1},{"text":"ukuze umgadi walo atshelele aye emuva.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ngilindele ukuhlenga kwakho, Oh Thixo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"UGadi uzahlaselwa liqula lamanxusa,","poem":1},{"text":"kodwa uzabahlasela bamuphe izithende zabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ukudla kuka-Asheri kuzakuba ngokunonileyo,","poem":1},{"text":"uzakupha okumnandi okufanele inkosi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"UNafithali yimpalakazi ekhululiweyo","poem":1},{"text":"ezala amazinyane amahle.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"UJosefa ulivini elithela kakhulu,","poem":1},{"text":"ivini elithela kakhulu eduze komthombo,","poem":2},{"lineBreak":true},{"text":"elimagatsha alo akhwela emdulini.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Abahlaseli bemitshoko bamhlasela ngolaka;","poem":1},{"text":"bamciba ngenzondo embi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kodwa kawalazelanga ngedandili lakhe,","poem":1},{"text":"ingalo zakhe eziqinileyo zala zilokhu ziqinile","poem":2},{"text":"ngenxa yesandla soMninimandla kaJakhobe,","poem":1},{"text":"ngenxa kaMalusi, iDwala lika-Israyeli,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ngenxa kaNkulunkulu kayihlo, okusizayo,","poem":1},{"text":"ngenxa kaSomandla okubusisayo","poem":2},{"text":"ngezibusiso zasezulwini ngaphezulu,","poem":1},{"text":"izibusiso zolwandle olungaphansi,","poem":2},{"lineBreak":true},{"text":"izibusiso zebele lenzalo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Izibusiso zikayihlo zinkulu","poem":1},{"text":"kulezibusiso zezintaba zekadeni,","poem":2},{"lineBreak":true},{"text":"kulezithelo zamaqaqa adabuka endulo.","poem":2},{"text":"Zonke lezi kazehlele ekhanda likaJosefa,","poem":1},{"text":"ebunzini lenkosana phakathi kwabafowabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"UBhenjamini yimpisi ephangayo;","poem":1},{"text":"ekuseni uyakudlithiza akujimbileyo,","poem":2},{"lineBreak":true},{"text":"ntambama akwabe.”","poem":2}]},{"type":"verse","number":28,"content":["Zonke lezi yizizwana ezilitshumi lambili zako-Israyeli, njalo yikho lokho uyise akutsho kubo lapho wayebabusisa, esipha ilowo lalowo isibusiso esimfaneleyo."]},{"type":"heading","content":["Ukufa KukaJakhobe"]},{"type":"verse","number":29,"content":["Emva kwalokho wasebanika imilayo le: “Sekusondele ukuba ngimbelwe ebantwini bakithi. Lingimbele labokhokho ebhalwini ensimini ka-Efroni umHithi,"]},{"type":"verse","number":30,"content":["ubhalu olusensimini kaMakhaphela, eduze leMamure eKhenani, eyathengwa ngu-Abhrahama kanye lensimu leyo ku-Efroni umHithi, ukuba yindawo yokungcwaba."]},{"type":"verse","number":31,"content":["Khonapho kwangcwatshwa u-Abhrahama lomkakhe uSara, kwembelwa u-Isaka lomkakhe uRabheka, njalo khonapho ngambela uLeya."]},{"type":"verse","number":32,"content":["Insimu kanye lobhalu oluphakathi kwathengwa kumaHithi.”"]},{"type":"verse","number":33,"content":["Kwathi uJakhobe eseqedile ukunika imilayezo emadodaneni akhe, wakhweza inyawo zakhe embhedeni, waphefumula okokucina, wasiwa kwabakibo."]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}