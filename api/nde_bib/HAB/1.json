{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"HAB","translationId":"nde_bib","name":"UHabhakhukhi","commonName":"UHabhakhukhi","title":"UHabhakhukhi","order":35,"numberOfChapters":3,"sha256":"3b790d4914576c7ccef8830742e1f3b0cbed09c471e03b4d2599d7d0aaf70b0a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nde_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Isiphrofethi esemukelwa nguHabhakhukhi umphrofethi."]},{"type":"line_break"},{"type":"heading","content":["Insolo KaHabhakhukhi"]},{"type":"verse","number":2,"content":[{"text":"Koze kube nini, awu Thixo, ngicela usizo,","poem":1},{"text":"kodwa ungalaleli na?","poem":2},{"text":"Loba ngimemezela kuwe ngisithi, “Udlakela!”","poem":1},{"text":"kodwa ungangihlengi na?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kungani ungitshengisa okungasimfanelo na?","poem":1},{"text":"Kungani ubekezelela okungalunganga na?","poem":2},{"text":"Ukuchitheka lodlakela kuphambi kwami; kulokulwa,","poem":1},{"text":"lengxabano yandile.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngakho umthetho usuthundubezekile,","poem":1},{"text":"lokulunga akusabi khona.","poem":2},{"text":"Ababi baminyezela abalungileyo","poem":1},{"text":"ukuze ukulunga konakaliswe.","poem":2}]},{"type":"heading","content":["Impendulo KaThixo"]},{"type":"verse","number":5,"content":[{"text":"“Khangelani ezizweni libone","poem":1},{"text":"njalo limangale kakhulu.","poem":2},{"text":"Ngoba ensukwini zenu","poem":1},{"text":"ngizakwenza into elingasoze liyikholwe,","poem":2},{"lineBreak":true},{"text":"lanxa lingabe litsheliwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sengivusa amaKhaladiya,","poem":1},{"text":"lesiya isizwe esilesihluku lamawala,","poem":2},{"text":"esitshaya sibhuqe umhlaba wonke,","poem":1},{"text":"sithumba izindawo zokuhlala ezingasizo zaso.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bayisizwe esesabekayo lesitshayisa uvalo;","poem":1},{"text":"bangumthetho bona ngokwabo","poem":2},{"lineBreak":true},{"text":"njalo baziphakamisa udumo lwabo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Amabhiza abo alesiqubu esedlula esamahlosi,","poem":1},{"text":"ayesabeka kulezimpisi kusihlwa.","poem":2},{"text":"Amabhiza abo empi amatha ephulukundlela,","poem":1},{"text":"abagadi bawo amabhiza bavela khatshana.","poem":2},{"text":"Bandiza njengamanqe ehwitha ukudla,","poem":1}]},{"type":"verse","number":9,"content":[{"text":"bonke beza belande udlakela.","poem":2},{"text":"Amaxuku abo aqhubekela phambili njengomoya wasenkangala","poem":1},{"text":"abuthe abathunjiweyo njengenhlabathi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Baklolodela amakhosi,","poem":1},{"text":"bahleke ababusi usulu.","poem":2},{"text":"Wonke amadolobho avikelweyo bayawahleka;","poem":1},{"text":"bakha amadundulu ngenhlabathi bawathumbe lawo madolobho.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Emva kwalokho badlula ngesiqubu njengomoya baqhubeke,","poem":1},{"text":"abantu abalecala abamandla abo angunkulunkulu wabo.”","poem":2}]},{"type":"heading","content":["Insolo Yesibili KaHabhakhukhi"]},{"type":"verse","number":12,"content":[{"text":"Awu Thixo, kawuveli phakade na?","poem":1},{"text":"Nkulunkulu wami, Ngcwele wami, kasiyikufa.","poem":2},{"text":"Awu Thixo, ubabekile ukuba bahlulele.","poem":1},{"text":"Awu Dwala, ubamisile ukuba bajezise.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Amehlo akho ahlanzeke kakhulu ukuba akhangele okubi;","poem":1},{"text":"awungeke ubekezelele okungalunganga.","poem":2},{"text":"Pho kungani ubekezelela abachithayo na?","poem":1},{"text":"Uthulelani lapho ababi","poem":2},{"lineBreak":true},{"text":"beqeda labo abalunge kakhulu kulabo na?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wenze abantu bafana lenhlanzi olwandle,","poem":1},{"text":"njengezidalwa zasolwandle ezingelambusi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Isitha esibi siyazikhupha zonke ngewuka,","poem":1},{"text":"siyazibamba ngembule laso,","poem":2},{"text":"sizibuthele embuleni laso elidonswayo;","poem":1},{"text":"ngalokho siyajabula sithokoze.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngakho-ke senzela imbule laso umhlatshelo,","poem":1},{"text":"sitshisele imbule laso elidonswayo","poem":2},{"text":"impepha ngoba ngenxa yembule laso","poem":1},{"text":"sithe pekle phakathi kwenotho,","poem":2},{"lineBreak":true},{"text":"sizitika ngokudla okumnandi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kuzamele siqhubeke sithulula umambule waso,","poem":1},{"text":"sitshabalalisa izizwe kungekho sihawu na?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/NAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}