{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"HAB","translationId":"nde_bib","name":"UHabhakhukhi","commonName":"UHabhakhukhi","title":"UHabhakhukhi","order":35,"numberOfChapters":3,"sha256":"3b790d4914576c7ccef8830742e1f3b0cbed09c471e03b4d2599d7d0aaf70b0a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nde_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Ngizakuma esilindweni sami","poem":1},{"text":"ngime phezu komthangala;","poem":2},{"text":"ngizakhangela ukuba ngibone ukuthi uzakuthini kimi,","poem":1},{"text":"lokuthi yimpendulo bani engizayitsho ngale insolo.","poem":2}]},{"type":"heading","content":["Impendulo KaThixo"]},{"type":"verse","number":2,"content":["UThixo waphendula wathi:",{"text":"“Loba phansi isibonakaliso","poem":1},{"text":"usenze sicace ezicecedwini","poem":2},{"lineBreak":true},{"text":"ukuze isithunywa sigijime laso.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngoba isibonakaliso silindela isikhathi esimisiweyo;","poem":1},{"text":"sikhuluma ngesiphetho","poem":2},{"lineBreak":true},{"text":"njalo kasiyikuba ngamanga.","poem":2},{"text":"Lanxa siphuza, silindele;","poem":1},{"text":"sizafika impela","poem":2},{"lineBreak":true},{"text":"njalo kasiyikuphuza.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Khangela, uyazigqaja;","poem":1},{"text":"izifiso zakhe kazilunganga,","poem":2},{"lineBreak":true},{"text":"kodwa olungileyo uzaphila ngokholo lwakhe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Impela iwayini liyamkhohlisa;","poem":1},{"text":"uyazikhukhumeza njalo kalakho ukuphumula.","poem":2},{"text":"Ngoba uyisihwaba njengengcwaba,","poem":1},{"text":"njalo kasuthi njengokufa,","poem":2},{"text":"ubuthelela izizwe zonke kuye","poem":1},{"text":"athumbe labantu bonke.","poem":2}]},{"type":"verse","number":6,"content":["Bonke kabayikumchothoza na bamhleke besithi,",{"text":"‘Maye kulowo obuthelela impahla zokwebiwa","poem":1},{"text":"azinothise ngobugebenga!","poem":2},{"lineBreak":true},{"text":"Koze kube nini lokhu kusenzakala na?’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Labo olezikwelede kubo kabayikukujuma na?","poem":1},{"text":"Kabayikuvuka bakuthuthumelise na?","poem":2},{"lineBreak":true},{"text":"Lapho-ke uzakuba yinto yabo yokuhlutshwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngoba sewaphanga izizwe ezinengi,","poem":1},{"text":"abantu abaseleyo bazakuphanga","poem":2},{"text":"ngoba wachitha igazi labantu;","poem":1},{"text":"watshabalalisa amazwe lamadolobho labo bonke abakuwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Maye kulowo obumba umbuso ngenzuzo embi","poem":1},{"text":"ukuba akhele isidleke sakhe phezulu","poem":2},{"lineBreak":true},{"text":"ukuba abalekele ukuwelwa yingozi!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ucebe ukubhujiswa kwabantu abanengi,","poem":1},{"text":"wayangisa indlu yakho, walahlekelwa yikuphila kwakho.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amatshe omduli azakhala","poem":1},{"text":"imijabo yamapulanka izasabela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Maye kulowo owakha idolobho ngokuchitha igazi","poem":1},{"text":"akhe umuzi ngobudlwangudlwangu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"UThixo uSomandla kakumisanga na","poem":1},{"text":"ukuthi umsebenzi uzinkuni zomlilo nje kuphela,","poem":2},{"lineBreak":true},{"text":"lokuthi izizwe ziqeda amandla azo ngeze?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngoba umhlaba uzagcwala ngolwazi lodumo lukaThixo,","poem":1},{"text":"njengamanzi egcwalisa ulwandle.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Maye kulowo onika omakhelwane bakhe","poem":1},{"text":"okunathwayo ekuthulula","poem":2},{"lineBreak":true},{"text":"esigujini sewayini badakwe,","poem":2},{"lineBreak":true},{"text":"ukuze akhangele imizimba yabo enqunu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Uzakuba lehlazo elikhulu endaweni yodumo.","poem":1},{"text":"Khathesi sekulithuba lakho! Natha uchayeke.","poem":2},{"text":"Inkezo yesandla sokunene kaThixo iyeza kuwe,","poem":1},{"text":"ihlazo lizamboza udumo lwakho.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Udlakela olwenze eLebhanoni luzakuqeda amandla,","poem":1},{"text":"lokubulala kwakho izinyamazana kuzakuthuthumelisa.","poem":2},{"text":"Ngoba uchithe igazi labantu;","poem":1},{"text":"uchithe amazwe lamadolobho labo bonke abakuwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Silosizo bani isithombe njengoba sibazwe ngumuntu?","poem":1},{"text":"Kumbe isifanekiso esifundisa amanga?","poem":2},{"text":"Ngoba lowo osenzayo uthemba isidalwa sakhe;","poem":1},{"text":"wenza izithombe ezingeke zikhulume.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Maye kulowo othi esigodweni, ‘Vuka uphile!’","poem":1},{"text":"loba athi elitsheni elingaphiliyo, ‘Phaphama!’","poem":2},{"text":"Linganika iseluleko na?","poem":1},{"text":"Lembeswe ngegolide langesiliva,","poem":2},{"lineBreak":true},{"text":"akulamphefumulo phakathi kwalo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kodwa uThixo usethempelini lakhe elingcwele;","poem":1},{"text":"umhlaba wonke kawuthule phambi kwakhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/HAB/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/HAB/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/HAB/1.json","previousChapterAudioLinks":{},"numberOfVerses":20}