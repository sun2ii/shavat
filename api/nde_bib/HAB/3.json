{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"HAB","translationId":"nde_bib","name":"UHabhakhukhi","commonName":"UHabhakhukhi","title":"UHabhakhukhi","order":35,"numberOfChapters":3,"sha256":"3b790d4914576c7ccef8830742e1f3b0cbed09c471e03b4d2599d7d0aaf70b0a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nde_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["Umkhuleko KaHabhakhukhi"]},{"type":"verse","number":1,"content":["Umkhuleko kaHabhakhukhi umphrofethi. NgeShigiyonothi."]},{"type":"verse","number":2,"content":[{"text":"Thixo, ngizwile ngodumo lwakho;","poem":1},{"text":"ngiyazesaba izenzo zakho, awu Thixo.","poem":2},{"text":"Zivuselele ensukwini zethu,","poem":1},{"text":"yenza zazakale esikhathini sethu;","poem":2},{"lineBreak":true},{"text":"ekuthukutheleni khumbula isihawu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"UNkulunkulu wavela eThemani,","poem":1},{"text":"oNgcwele wavela eNtabeni iPharani.","poem":2},{"text":"Inkazimulo yakhe yasibekela amazulu","poem":1},{"text":"lokudunyiswa kwakhe kwagcwala umhlaba wonke.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ubucwazicwazi bakhe babunjengokuphuma kwelanga;","poem":1},{"text":"imisebe yaphazima esandleni sakhe","poem":2},{"lineBreak":true},{"text":"lapho amandla akhe ayefihlwe khona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isifo sahamba phambi kwakhe,","poem":1},{"text":"umkhuhlane walandela amanyathelo akhe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wasukuma, wanyikinya umhlaba;","poem":1},{"text":"wakhangela, waqhaqhazelisa izizwe.","poem":2},{"text":"Izintaba zasendulo zabhidlika","poem":1},{"text":"lamaqaqa akudala adilika.","poem":2},{"lineBreak":true},{"text":"Izindlela zakhe ngezanini lanini.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngabona amathente aseKhushani ephakathi kosizi,","poem":1},{"text":"lezindawo zokuhlala zaseMidiyani zisebuhlungwini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Awu Thixo, imifula wawuyithukuthelele na?","poem":1},{"text":"Ulaka lwakho lwavuthela izifula na?","poem":2},{"text":"Ulwandle wawuluthukuthelele na","poem":1},{"text":"lapho ugade amabhiza akho","poem":2},{"lineBreak":true},{"text":"lezinqola zakho zempi ezinqobayo?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Idandili lakho ulembule,","poem":1},{"text":"ufune imitshoko eminengi.","poem":2},{"text":"Uqhekeze umhlaba ngemifula;","poem":1}]},{"type":"verse","number":10,"content":[{"text":"izintaba zakubona zajanqula,","poem":2},{"text":"izikhukhula zamanzi zedlula,","poem":1},{"text":"ulwandle lwahlokoma,","poem":2},{"lineBreak":true},{"text":"lwaphakamisela amagagasi alo phezulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ilanga lenyanga kwema mpo emazulwini","poem":1},{"text":"ekubenyezeleni kwemitshoko yakho entwezayo,","poem":2},{"lineBreak":true},{"text":"ekuphazimeni kwemitshoko yakho ecazimulayo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wanyathela umhlaba ngolaka,","poem":1},{"text":"wabhula izizwe ngentukuthelo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Waphuma ukuba ukhulule abantu bakho,","poem":1},{"text":"ukuba usindise ogcotshiweyo wakho.","poem":2},{"text":"Umkhokheli welizwe lobubi umchobozile,","poem":1},{"text":"wamebula kusukela ekhanda kusiya enyaweni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Umhlabe ikhanda ngomkhonto wakhe","poem":1},{"text":"lapho amabutho akhe ephume ngesiqubu ukuba asihlakaze,","poem":2},{"text":"ethokoza kungani asezakudla","poem":1},{"text":"abahluphekayo abebecatshile.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wanyathela ulwandle ngamabhiza akho,","poem":1},{"text":"uqubula amanzi amanengi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ngezwa, inhliziyo yami yatshaya,","poem":1},{"text":"izindebe zami zabikizeliswa ngumsindo;","poem":2},{"text":"amathambo ami angenwa yikubola,","poem":1},{"text":"imilenze yami yaqhaqhazela.","poem":2},{"text":"Kodwa ngizalindela ngesineke usuku lomonakalo","poem":1},{"text":"ukuba lufike esizweni esihlasela esethu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Lanxa isihlahla somkhiwa singanunkuli","poem":1},{"text":"lamavini engekho emivinini;","poem":2},{"text":"lanxa ama-oliva engathelanga,","poem":1},{"text":"lamasimu engabanga lokudla,","poem":2},{"text":"lanxa kungelazimvu esibayeni","poem":1},{"text":"lenkomo zingekho ezibayeni,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"kodwa ngizathokoza kuThixo,","poem":1},{"text":"ngizajabula kuNkulunkulu uMsindisi wami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"UThixo Wobukhosi ungamandla ami;","poem":1},{"text":"wenza inyawo zami zibe njengezempala,","poem":2},{"lineBreak":true},{"text":"ungenza ngihambe ezindaweni eziphakemeyo.","poem":2},{"text":"Ngeyomqondisi womculo. Ezigincini zami.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}