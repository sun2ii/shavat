{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"HEB","translationId":"nde_bib","name":"AmaHebheru","commonName":"AmaHebheru","title":"KumaHebheru","order":58,"numberOfChapters":13,"sha256":"97e0e82a206f2f3815ff4a1e840655cbe4614b9db70a61819ccef27e3ad30e62","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/nde_bib/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["ILizwi Lika Nkulunkulu Lokucina: INdodana Yakhe"]},{"type":"verse","number":1,"content":["Kudala uNkulunkulu wakhuluma kubokhokho kanenginengi ngabaphrofethi langezindlela ezehlukeneyo"]},{"type":"verse","number":2,"content":["kodwa ngalezizinsuku zokucina ukhulume kithi ngeNdodana yakhe, ayibeka ukuba yindlalifa yezinto zonke, yona adala ngayo izulu lomhlaba."]},{"type":"verse","number":3,"content":["INdodana iyikubenyezela kwenkazimulo kaNkulunkulu kanye lomfanekiso wokuba nguye kwakhe uqobo, iqinisa izinto zonke ngelizwi layo elilamandla. Emva kokuba isikufezile ukuhlanjululwa kwezono, yahlala phansi esandleni sokunene sobukhosi ezulwini."]},{"type":"verse","number":4,"content":["Ngakho yaba ngaphezu kwezingilosi ngoba ibizo eyalithola njengelifa lilikhulu kulelazo."]},{"type":"heading","content":["INdodana Ingaphezulu Kwezingilosi"]},{"type":"verse","number":5,"content":["Ngoba kukuyiphi ingilosi uNkulunkulu ake wathi kuyo:",{"text":"“Wena uyiNdodana yami;","poem":1},{"text":"lamhla sengibe nguYihlo”","poem":2},{"noteId":0},{"text":"?","poem":2},"Kumbe njalo wathi,",{"text":"“Ngizakuba nguYise,","poem":1},{"text":"yona izakuba yiNdodana yami”","poem":2},{"noteId":1},{"text":"?","poem":2}]},{"type":"verse","number":6,"content":["Njalo, lapho uNkulunkulu eletha izibulo lakhe emhlabeni, uthi:",{"text":"“Zonke izingilosi zikaNkulunkulu kazimkhonze.”","poem":1},{"noteId":2}]},{"type":"verse","number":7,"content":["Lapho ekhuluma ngezingilosi uthi,",{"text":"“Wenza izingilosi zakhe zibe yimimoya,","poem":1},{"text":"izinceku zakhe zibe ngamalangabi omlilo.”","poem":2},{"noteId":3}]},{"type":"verse","number":8,"content":["Kodwa ngeNdodana uthi,",{"text":"“Isihlalo sakho sobukhosi, Oh Nkulunkulu,","poem":1},{"text":"sizakuma nini lanini,","poem":2},{"text":"intonga yokwahlulela okulungileyo","poem":1},{"text":"izakuba yintonga yombuso wakho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ukuthandile ukulunga wazonda ububi;","poem":1},{"text":"ngakho uNkulunkulu,","poem":2},{"text":"uNkulunkulu wakho","poem":1},{"text":"usekubeke ngaphezu kwabakhula bakho","poem":2},{"lineBreak":true},{"text":"ngokukugcoba ngamafutha entokozo.”","poem":2},{"noteId":4}]},{"type":"verse","number":10,"content":["Njalo uthi,",{"text":"“Ekuqaleni, Oh Nkosi, wabeka izisekelo zomhlaba,","poem":1},{"text":"lamazulu angumsebenzi wezandla zakho.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kuzabhubha kodwa wena uzasala;","poem":1},{"text":"konke kuzaguga njengesigqoko.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Uzakugoqa njengesembatho;","poem":1},{"text":"kuzantshintshwa njengesigqoko.","poem":2},{"text":"Kodwa wena uhlala unjalo,","poem":1},{"text":"leminyaka yakho kayiyikuphela.”","poem":2},{"noteId":5}]},{"type":"verse","number":13,"content":["Kukuyiphi ingilosi uNkulunkulu ake wathi kuyo:",{"text":"“Hlala ngakwesokunene sami;","poem":2},{"text":"ngize ngenze izitha zakho","poem":1},{"text":"zibe yisinyathelo senyawo zakho”","poem":2},{"noteId":6},{"text":"?","poem":2}]},{"type":"verse","number":14,"content":["Izingilosi kazisimimoya esebenzayo yini, ethunywe ukukhonza labo abazakudla ilifa lokusindiswa na?"]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.5 AmaHubo 2.7","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"+","text":"1.5 2 USamuyeli 7.14; 1 ImiLando 17.13","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"1.6 UDutheronomi 32.43","reference":{"chapter":1,"verse":6}},{"noteId":3,"caller":"+","text":"1.7 AmaHubo 104.4","reference":{"chapter":1,"verse":7}},{"noteId":4,"caller":"+","text":"1.9 AmaHubo 45.6-7","reference":{"chapter":1,"verse":9}},{"noteId":5,"caller":"+","text":"1.12 AmaHubo 102.25-27","reference":{"chapter":1,"verse":12}},{"noteId":6,"caller":"+","text":"1.13 AmaHubo 110.1","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/nde_bib/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}