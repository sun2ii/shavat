{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"HEB","translationId":"nde_bib","name":"AmaHebheru","commonName":"AmaHebheru","title":"KumaHebheru","order":58,"numberOfChapters":13,"sha256":"97e0e82a206f2f3815ff4a1e840655cbe4614b9db70a61819ccef27e3ad30e62","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/nde_bib/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":8,"content":[{"type":"heading","content":["Umphristi Omkhulu Wesivumelwano Esitsha"]},{"type":"verse","number":1,"content":["Isiqokoqela salokho esikutshoyo yilesi: Silaye umphristi omkhulu onjalo, owahlala phansi esandleni sokunene kwesihlalo sobukhosi soMkhulu ezulwini,"]},{"type":"verse","number":2,"content":["okhonzayo endaweni engcwele, ithabanikeli eliqotho elamiswa yiNkosi hatshi ngabantu."]},{"type":"verse","number":3,"content":["Umphristi omkhulu ngamunye ubekelwe ukunikela izipho lemihlatshelo, ngakho kwakufanele ukuba lalo abe lolutho alunikelayo."]},{"type":"verse","number":4,"content":["Aluba wayesemhlabeni wayengayikuba ngumphristi ngoba bevele bekhona abantu abanikela izipho eziphawulwa ngumthetho."]},{"type":"verse","number":5,"content":["Bakhonza endaweni engcwele engumfanekiso lesithunzi salokho okusezulwini. Yikho-nje uMosi waxwayiswa lapho esezakwakha ithabanikeli ngokuthi: “Qaphela ukuba wenze konke njengalokhu owakutshengiswa entabeni.”",{"noteId":23}]},{"type":"verse","number":6,"content":["Kodwa inkonzo uJesu ayemukeleyo ingcono kuleyabo njengesivumelwano yena angumeli waso singcono kulesidala njalo sakhelwe phezu kwezithembiso ezingcono."]},{"type":"verse","number":7,"content":["Ngoba aluba kwakungelalutho olungalunganga kusivumelwano sakuqala leso, akulasizatho esasingadingelwa esinye."]},{"type":"verse","number":8,"content":["Kodwa uNkulunkulu wathola isici ebantwini wasesithi:",{"text":"“Isikhathi siyeza, kutsho iNkosi,","poem":1},{"text":"lapho engizakwenza khona isivumelwano esitsha","poem":2},{"text":"lendlu ka-Israyeli","poem":1},{"text":"kanye lendlu kaJuda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kasiyikufana lesivumelwano","poem":1},{"text":"engasenza labokhokho babo","poem":2},{"text":"lapho engababamba khona ngesandla","poem":1},{"text":"ukuba ngibakhuphe eGibhithe,","poem":2},{"text":"ngoba kabaqhubekanga bethembekile esivumelwaneni sami,","poem":1},{"text":"ngasengibadela,","poem":2},{"lineBreak":true},{"text":"kutsho iNkosi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nansi isivumelwano engizasenza lendlu ka-Israyeli,","poem":1},{"text":"ngemva kwalesosikhathi, kutsho iNkosi.","poem":2},{"text":"Ngizabeka imithetho yami ezingqondweni zabo,","poem":1},{"text":"ngiyilobe ezinhliziyweni zabo.","poem":2},{"text":"Ngizakuba nguNkulunkulu wabo,","poem":1},{"text":"bona babengabantu bami.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Umuntu kasayikufundisa umakhelwane wakhe,","poem":1},{"text":"kumbe umfowabo, esithi, ‘Yazi iNkosi,’","poem":2},{"text":"ngoba bonke bazangazi,","poem":1},{"text":"kusukela komncinyane wabo kusiya komkhulu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngoba ngizabathethelela ububi babo,","poem":1},{"text":"njalo angiyikukhumbula izono zabo futhi.”","poem":2},{"noteId":24}]},{"type":"verse","number":13,"content":["Ngokuthi isivumelwano lesi “sitsha” wenze esakuqala sangasasebenzi; futhi okungasasebenzi lokugugileyo kuzanyamalala masinyane."]}],"footnotes":[{"noteId":23,"caller":"+","text":"8.5 U-Eksodasi 25.40","reference":{"chapter":8,"verse":5}},{"noteId":24,"caller":"+","text":"8.12 UJeremiya 31.31-34","reference":{"chapter":8,"verse":12}}]},"thisChapterLink":"/api/nde_bib/HEB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/HEB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/HEB/7.json","previousChapterAudioLinks":{},"numberOfVerses":13}