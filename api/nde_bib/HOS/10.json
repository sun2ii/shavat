{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"HOS","translationId":"nde_bib","name":"UHosiya","commonName":"UHosiya","title":"UHosiya","order":28,"numberOfChapters":14,"sha256":"3445b0e1290e1a022a101ba68d37532d3620ecee62fe870fdc3a986713f5c88c","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nde_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"U-Israyeli wayelivini eliqhelayo,","poem":1},{"text":"wazizalela izithelo.","poem":2},{"text":"Ngokwanda kwezithelo zakhe","poem":1},{"text":"wakha ama-alithare amanengi;","poem":2},{"text":"kwathi ngokuphumelela kwelizwe lakhe","poem":1},{"text":"wahlobisa amatshe akhe akhonzwayo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inhliziyo zabo ziyakhohlisa,","poem":1},{"text":"khathesi kufanele bathwale icala labo.","poem":2},{"text":"UThixo uzawabhidliza ama-alithare abo,","poem":1},{"text":"uwachithile lamatshe abo, akhonzwayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngakho bazakuthi, “Thina kasilankosi","poem":1},{"text":"ngoba kasimhloniphanga uThixo.","poem":2},{"text":"Kodwa loba sasingaba lenkosi,","poem":1},{"text":"kuyini eyayingasenzela khona?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Benza izithembiso ezinengi,","poem":1},{"text":"bafunge izifungo zamanga,","poem":2},{"lineBreak":true},{"text":"benze lezivumelwano;","poem":2},{"text":"ngakho amacala ayanda","poem":1},{"text":"njengokhula olubulalayo ensimini elinyiweyo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abantu abahlala eSamariya bayesaba","poem":1},{"text":"ngenxa yesithombe sethole saseBhethi-Aveni.","poem":2},{"text":"Abantu bakhona bazasililela","poem":1},{"text":"benzenjalo labaphristi bakhona abakhonza izithombe,","poem":2},{"text":"labo abathokozela ubuhle baso","poem":1},{"text":"ngoba sithethwe kubo ekuthunjweni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sizathwalelwa e-Asiriya","poem":1},{"text":"njengomthelo enkosini enkulu.","poem":2},{"text":"U-Efrayimi uzayangeka;","poem":1},{"text":"u-Israyeli uzakuba lenhloni ngezithombe zakhe zezigodo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ISamariya lenkosi yakhona kuzabhujiswa","poem":1},{"text":"kuzakhukhulwa kuhambe njengogatshanyana phezu kwamanzi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Izindawo zokukhonzela zobuxhwali zizachithwa,","poem":1},{"text":"kuyisono sika-Israyeli.","poem":2},{"text":"Ameva lokhula kuzakhula","poem":1},{"text":"kwembese ama-alithare abo.","poem":2},{"text":"Lapho-ke bazakuthi ezintabeni, “Sembeseni!”","poem":1},{"text":"Lakuwo amaqaqa bathi, “Welani phezu kwethu!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Kusukela ensukwini zaseGibhiya wenze isono, we Israyeli,","poem":1},{"text":"njalo ulokhu usele khonapho.","poem":2},{"text":"Kanje impi kayibaficanga yini","poem":1},{"text":"abenza okubi eGibhiya?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lapho sengifuna, ngizabajezisa;","poem":1},{"text":"izizwe zizaqoqanela ukumelana labo","poem":2},{"lineBreak":true},{"text":"ukuba zibabophele isono sabo esiphindiweyo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"U-Efrayimi ulithokazi elifundisiweyo","poem":1},{"text":"elithanda ukubhula amabele;","poem":2},{"text":"ngakho ngizagaxa ijogwe","poem":1},{"text":"entanyeni yakhe enhle.","poem":2},{"text":"U-Efrayimi ngizamtshayela,","poem":1},{"text":"uJuda kumele alime","poem":2},{"lineBreak":true},{"text":"uJakhobe kumele abulale amagade.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Zihlanyeleleni ukulunga,","poem":1},{"text":"vunani isithelo sothando olungapheliyo,","poem":2},{"text":"liqeqebule lomhlabathi wenu ongalinywanga; ngoba","poem":1},{"text":"kuyisikhathi sokudinga uThixo,","poem":2},{"text":"aze abuye","poem":1},{"text":"athele ukulunga phezu kwenu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kodwa lina lihlanyele ukuxhwala,","poem":1},{"text":"livune ububi,","poem":2},{"lineBreak":true},{"text":"lidle isithelo senkohliso.","poem":2},{"text":"Njengoba lithembe amandla enu","poem":1},{"text":"lamabutho enu amanengi,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ukuhlokoma kwempi kuzakuba khona ebantwini bakini,","poem":1},{"text":"ngakho zonke izinqaba zenu zizabhidlizwa","poem":2},{"text":"njengalokhu uShalimani wabhidliza iBhethi-Abheli ngosuku lwempi,","poem":1},{"text":"lapho onina basakazelwa phansi labantwababo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kuzakwenzakala kanjalo lakuwe, wena Bhetheli,","poem":1},{"text":"ngoba ukuxhwala kwakho kukhulu.","poem":2},{"text":"Lapho lolosuku lusisa,","poem":1},{"text":"inkosi yako-Israyeli izachithwa okupheleleyo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}