{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"HOS","translationId":"nde_bib","name":"UHosiya","commonName":"UHosiya","title":"UHosiya","order":28,"numberOfChapters":14,"sha256":"3445b0e1290e1a022a101ba68d37532d3620ecee62fe870fdc3a986713f5c88c","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nde_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["Uthando LukaNkulunkulu Kwabako-Israyeli"]},{"type":"verse","number":1,"content":[{"text":"“U-Israyeli esesengumntwana, ngangimthanda","poem":1},{"text":"njalo indodana yami ngayikhupha eGibhithe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kodwa kwathi lapho u-Israyeli ngimbiza kanengi","poem":1},{"text":"kwayikhona ehlehlela khatshana lami.","poem":2},{"text":"Banikela imihlatshelo kuboBhali,","poem":1},{"text":"batshisela lezifanekiso impepha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yimi engafundisa u-Efrayimi ukuhamba,","poem":1},{"text":"ngibabambe ngezingalo;","poem":2},{"text":"kodwa kababonanga","poem":1},{"text":"ukuthi yimi engabelaphayo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngabakhokhela ngentambo zomusa woluntu,","poem":1},{"text":"ngezibopho zothando;","poem":2},{"text":"ngaba njengomuntu osusa","poem":1},{"text":"amajogwe entanyeni zabo,","poem":2},{"lineBreak":true},{"text":"ngakhothamela phansi ukuba angiphe ukudla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kabayikubuyela eGibhithe na,","poem":1},{"text":"njalo i-Asiriya kayiyikubabusa na","poem":2},{"lineBreak":true},{"text":"njengoba besala ukuphenduka?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Izinkemba zizaphazima emadolobheni abo,","poem":1},{"text":"zizachitha imigoqo yamasango abo","poem":2},{"lineBreak":true},{"text":"ziqede amacebo abo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abantu bami bazimisele ukungihlamukela.","poem":1},{"text":"Lanxa bekhuleka koPhezukonke","poem":2},{"lineBreak":true},{"text":"kasoze abaphakamise.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ngingakukhalela kanjani, Efrayimi?","poem":1},{"text":"Ngingakunikela kanjani, Israyeli?","poem":2},{"text":"Ngingakuphatha kanjani njengo-Adima na?","poem":1},{"text":"Ngingakwenza kanjani, njengoZebhoyimi na?","poem":2},{"text":"Inhliziyo yami iguqukile phakathi kwami;","poem":1},{"text":"isihawu sami sonke siqubukile.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kangiyikwenza okwentukuthelo yami eyesabekayo,","poem":1},{"text":"kumbe ngiphenduke ngimqothule u-Efrayimi.","poem":2},{"text":"Ngoba nginguNkulunkulu, hatshi umuntu,","poem":1},{"text":"oNgcwele phakathi kwenu.","poem":2},{"lineBreak":true},{"text":"Kangiyikuza ngolaka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bazamlandela uThixo;","poem":1},{"text":"uzabhonga njengesilwane.","poem":2},{"text":"Lapho esebhonga,","poem":1},{"text":"abantwana bakhe bazakuza beqhaqhazela bevela entshonalanga.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bazakuza bevela eGibhithe","poem":1},{"text":"beqhaqhazela njengezinyoni","poem":2},{"lineBreak":true},{"text":"bevela e-Asiriya bephaphazela njengamajuba.","poem":2},{"text":"Ngizabahlalisa emakhaya abo,”","poem":1},{"text":"kutsho uThixo.","poem":2}]},{"type":"heading","content":["Isono Sika-Israyeli"]},{"type":"verse","number":12,"content":[{"text":"“U-Efrayimi usengizingeleze ngamanga,","poem":1},{"text":"lendlu ka-Israyeli ngenkohliso.","poem":2},{"text":"LoJuda uluhlaza kuNkulunkulu,","poem":1},{"text":"kanye lakuye othembekileyo oNgcwele.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}