{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"HOS","translationId":"nde_bib","name":"UHosiya","commonName":"UHosiya","title":"UHosiya","order":28,"numberOfChapters":14,"sha256":"3445b0e1290e1a022a101ba68d37532d3620ecee62fe870fdc3a986713f5c88c","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nde_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"U-Efrayimi udla umoya;","poem":1},{"text":"uxotshana lomoya wasempumalanga ilanga lonke","poem":2},{"lineBreak":true},{"text":"andise amanga lodlakela.","poem":2},{"text":"Wenza isivumelwano le-Asiriya,","poem":1},{"text":"athumele amafutha e-oliva eGibhithe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kulecala uThixo azalethesa uJuda;","poem":1},{"text":"uzajezisa uJakhobe mayelana lezindlela zakhe","poem":2},{"lineBreak":true},{"text":"aphindisele kuye mayelana lezenzo zakhe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Esiswini wabamba isithende sikamfowabo;","poem":1},{"text":"eseyindoda wabindana loNkulunkulu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wabindana lengilosi wayehlula;","poem":1},{"text":"wakhala wacela umusa kuyo.","poem":2},{"text":"Wayifica eBhetheli","poem":1},{"text":"wakhuluma layo khonapho,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"uThixo uNkulunkulu uSomandla,","poem":1},{"text":"uThixo yilo ibizo lakhe lodumo!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kodwa kumele ubuyele kuNkulunkulu wakho;","poem":1},{"text":"ugcine uthando lokulunga,","poem":2},{"lineBreak":true},{"text":"umlindele kokuphela uNkulunkulu wakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Umthengisi usebenzisa izikali zenkohliso;","poem":1},{"text":"uthanda ukuqilibezela.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"U-Efrayimi uyazincoma esithi,","poem":1},{"text":"“Nginothe kakhulu; sengiyisipatsha.","poem":2},{"text":"Ngenotho yami kabayikufumana ububi","poem":1},{"text":"loba isono kimi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Mina nginguThixo uNkulunkulu wenu","poem":1},{"text":"owalikhupha eGibhithe;","poem":2},{"text":"ngizalenza lihlale emathenteni futhi,","poem":1},{"text":"njengasezinsukwini zemikhosi yenu emisiweyo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngakhuluma labaphrofethi,","poem":1},{"text":"ngabatshengisa imibono eminengi","poem":2},{"lineBreak":true},{"text":"ngakhuluma imizekeliso ngabo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"IGiliyadi ixhwalile na?","poem":1},{"text":"Abantu bakhona bakhohlakele!","poem":2},{"text":"EGiligali bayanikela umhlatshelo wenkunzi na?","poem":1},{"text":"Ama-alithare abo azakuba njengezinqwaba zamatshe","poem":2},{"lineBreak":true},{"text":"ensimini elinyiweyo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"UJakhobe wabalekela elizweni lase-Aramu;","poem":1},{"text":"u-Israyeli wasebenzela ukuthola umfazi,","poem":2},{"lineBreak":true},{"text":"njalo welusa izimvu ukuba amlobole.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"UThixo wasebenzisa umphrofethi ekukhupheni u-Israyeli eGibhithe;","poem":1},{"text":"wamlondoloza ngomphrofethi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kodwa u-Efrayimi umthukuthelise kabuhlungu;","poem":1},{"text":"UThixo wakhe uzaliyekela liphezu kwakhe","poem":2},{"lineBreak":true},{"text":"icala lokuchitha kwakhe igazi","poem":2},{"lineBreak":true},{"text":"njalo uzaphindisela kuye ukudelela kwakhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}