{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"HOS","translationId":"nde_bib","name":"UHosiya","commonName":"UHosiya","title":"UHosiya","order":28,"numberOfChapters":14,"sha256":"3445b0e1290e1a022a101ba68d37532d3620ecee62fe870fdc3a986713f5c88c","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nde_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"heading","content":["Ulaka LukaThixo Ku-Israyeli"]},{"type":"verse","number":1,"content":[{"text":"Lapho u-Efrayimi ekhuluma, abantu bathuthumela;","poem":1},{"text":"wabatshazwa ko-Israyeli.","poem":2},{"lineBreak":true},{"text":"Kodwa waba lecala lokukhonza uBhali wasesifa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Khathesi benza izono njalonjalo;","poem":1},{"text":"bazenzela izithombe ngesiliva sabo,","poem":2},{"text":"izifanekiso ezenziwe ngokuhlakanipha,","poem":1},{"text":"zonke ziyimisebenzi yezingcitshi.","poem":2},{"text":"Ngabantu laba kuthiwa,","poem":1},{"text":"“Banikela imihlatshelo yabantu,","poem":2},{"lineBreak":true},{"text":"bange izithombe zamathole.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngakho bazakuba njengenkungu yekuseni,","poem":1},{"text":"njengamazolo ekuseni anyamalalayo,","poem":2},{"lineBreak":true},{"text":"njengamakhoba asuka ezizeni,","poem":2},{"lineBreak":true},{"text":"njengentuthu iphuma ewindini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Kodwa mina nginguThixo uNkulunkulu wenu,","poem":1},{"text":"owalikhupha elizweni laseGibhithe.","poem":2},{"text":"Kaliyikwamukela omunye uNkulunkulu ngaphandle kwami,","poem":1},{"text":"hatshi omunye uMsindisi ngaphandle kwami.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngalilondoloza enkangala,","poem":1},{"text":"elizweni elilokutshisa okuvuthayo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lapho ngibapha ukudla, basutha;","poem":1},{"text":"sebesuthi, basuka bazigqaja;","poem":2},{"lineBreak":true},{"text":"basebengikhohlwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngizakwehlela phezu kwabo njengesilwane,","poem":1},{"text":"ngizacathama ngasendleleni njengengwe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Njengebhele elithathelwe imidlwane yalo","poem":1},{"text":"ngizabahlasela ngibaqhaqhe.","poem":2},{"text":"Ngizabadla njengesilwane,","poem":1},{"text":"inyamazana yeganga izabadabula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Uchithiwe, wena Israyeli,","poem":1},{"text":"ngoba umelane lami, umelane lomsizi wakho.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ingaphi inkosi yakho, ukuba ikusize na?","poem":1},{"text":"Bangaphi ababusi bakho kuwo wonke amadolobho akho,","poem":2},{"text":"bona owathi ngabo,","poem":1},{"text":"‘Ngipha inkosi lababusi’?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngakho ngakunika inkosi ngithukuthele,","poem":1},{"text":"njalo ngolaka lwami ngayisusa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Icala lika-Efrayimi ligciniwe,","poem":1},{"text":"izono zakhe zigcinwe emibhalweni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ufikelwa yibuhlungu obunjengowesifazane ehelelwa,","poem":1},{"text":"kodwa ungumntwana ongelalwazi;","poem":2},{"text":"lapho isikhathi sifika,","poem":1},{"text":"kabuyi ekuvulekeni kwesizalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ngizabahlenga emandleni engcwaba;","poem":1},{"text":"ngizabasindisa ekufeni.","poem":2},{"text":"Zingaphi, we kufa izifo zakho?","poem":1},{"text":"Kungaphi, we ngcwaba, ukuchitha kwakho?","poem":2},{"lineBreak":true},{"text":"Kangiyikuba lesihawu,","poem":1}]},{"type":"verse","number":15,"content":[{"text":"lanxa ekhula phakathi kwabafowabo.","poem":2},{"text":"Umoya wasempumalanga ovela kuThixo uzafika,","poem":1},{"text":"uphephetha uvela enkangala;","poem":2},{"text":"intwasa yakhe izakwehluleka,","poem":1},{"text":"lemithombo yakhe itshe.","poem":2},{"text":"Indlu yakhe yokugcinela izaphangwa","poem":1},{"text":"yonke ingcebo yayo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abantu baseSamariya kuzamela balithwale icala labo,","poem":1},{"text":"ngoba bamhlamukele uNkulunkulu wabo.","poem":2},{"text":"Bazabulawa ngenkemba;","poem":1},{"text":"insane zabo zizasakazelwa phansi,","poem":2},{"lineBreak":true},{"text":"abesifazane babo abazithweleyo baqhaqhwe.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":16}