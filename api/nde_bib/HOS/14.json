{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"HOS","translationId":"nde_bib","name":"UHosiya","commonName":"UHosiya","title":"UHosiya","order":28,"numberOfChapters":14,"sha256":"3445b0e1290e1a022a101ba68d37532d3620ecee62fe870fdc3a986713f5c88c","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nde_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"heading","content":["Ukuphenduka Kuzaletha Izibusiso"]},{"type":"verse","number":1,"content":[{"text":"Buyela, we Israyeli, kuThixo uNkulunkulu wakho.","poem":1},{"text":"Izono zakho yizo ezikuwisileyo!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Thatha amazwi","poem":1},{"text":"ubuyele kuThixo.","poem":2},{"text":"Uthi kuye,","poem":1},{"text":"“Sithethelele zonke izono zethu","poem":2},{"text":"njalo usamukele ngomusa","poem":1},{"text":"ukuba sinikele isithelo sezindebe zethu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I-Asiriya ayingeke isikhulule;","poem":1},{"text":"kasiyikugada amabhiza empi.","poem":2},{"text":"Kasisoze siphinde sithi, ‘Onkulunkulu bethu’","poem":1},{"text":"kulokho okwenziwa yizandla zethu,","poem":2},{"lineBreak":true},{"text":"ngoba abazintandane bathola isihawu kuwe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ngizakwelapha ubuphakaphaka babo","poem":1},{"text":"ngibathande ngokukhululeka,","poem":2},{"lineBreak":true},{"text":"ngoba ukuthukuthela kwami sekusukile kubo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngizakuba njengamazolo ku-Israyeli;","poem":1},{"text":"uzaqhakaza njengeluba.","poem":2},{"text":"Uzatshonisa impande zakhe","poem":1},{"text":"phansi njengomsedari waseLebhanoni;","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"amahlumela akhe amatsha azakhula.","poem":2},{"text":"Ubuhle bakhe buzakuba njengesihlahla se-oliva,","poem":1},{"text":"iphunga lakhe libe njengomsedari waseLebhanoni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abantu bazahlala njalo emthunzini wakhe.","poem":1},{"text":"Uzakhula kuhle njengamabele.","poem":2},{"text":"Uzaqhakaza njengevini,","poem":1},{"text":"lodumo lwakhe luzakuba njengolwewayini laseLebhanoni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Awu Efrayimi, kuyini futhi engingakwenza ngezithombe?","poem":1},{"text":"Ngizamphendula ngimlondoloze.","poem":2},{"text":"Mina nginjengesihlahla sephayini esiluhlaza,","poem":1},{"text":"ukuthela kwakho izithelo kuvela kimi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ngubani ohlakaniphileyo? Uzazibona lezizinto.","poem":1},{"text":"Ngubani oqedisisayo? Uzazizwisisisa.","poem":2},{"text":"Izindlela zikaThixo zilungile","poem":1},{"text":"abalungileyo bahamba kuzo,","poem":2},{"lineBreak":true},{"text":"kodwa abahlamuki bayakhubeka kuzo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}