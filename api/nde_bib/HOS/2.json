{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"HOS","translationId":"nde_bib","name":"UHosiya","commonName":"UHosiya","title":"UHosiya","order":28,"numberOfChapters":14,"sha256":"3445b0e1290e1a022a101ba68d37532d3620ecee62fe870fdc3a986713f5c88c","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nde_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["“Tshono kubafowenu uthi, ‘Bantu bami,’ ngabodadewenu uthi, ‘Bathandekayo bami.’ ”"]},{"type":"heading","content":["U-Israyeli Uyajeziswa Abuye Abuyiselwe"]},{"type":"verse","number":2,"content":[{"text":"“Mkhuze unyoko, mkhuze,","poem":1},{"text":"ngoba engasuye mkami,","poem":2},{"lineBreak":true},{"text":"lami kangisuye mkakhe.","poem":2},{"text":"Kasuse ukukhangeleka kobufebe ebusweni bakhe","poem":1},{"text":"kanye lokungathembeki phakathi kwamabele akhe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Funa ngimhlubule abe nqunu,","poem":1},{"text":"ngimenze abeze njengamhla ezalwa;","poem":2},{"text":"ngizamenza abe njengenkangala,","poem":1},{"text":"ngimenze abe yilizwe elomileyo","poem":2},{"lineBreak":true},{"text":"ngimbulale ngokomela amanzi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kangiyikubonakalisa uthando lwami ebantwaneni bakhe,","poem":1},{"text":"ngoba bangabantwana bobufebe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Unina ubeyisifebe,","poem":1},{"text":"njalo ubemule ngehlazo.","poem":2},{"text":"Wathi, ‘Ngizazilandela izithandwa zami,","poem":1},{"text":"ezingipha ukudla kwami lamanzi ami,","poem":2},{"lineBreak":true},{"text":"iwulu yami lamalembu ami,","poem":2},{"lineBreak":true},{"text":"amafutha ami lokunathwayo kwami.’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngakho-ke indlela yakhe ngizayivala ngamahlahla ameva;","poem":1},{"text":"ngizamhonqolozela ngomduli ukuze indlela yakhe angayifumani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Uzaxotshana lezithandwa zakhe kodwa angazifici,","poem":1},{"text":"uzazidinga kodwa angazitholi.","poem":2},{"text":"Ngakho uzakuthi,","poem":1},{"text":"‘Ngizabuyela endodeni yami yakuqala,","poem":2},{"lineBreak":true},{"text":"ngoba ngalesosikhathi ngangingcono kulakhathesi.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kavumanga ukuthi yimi engamnika amabele,","poem":1},{"text":"lewayini elitsha lamafutha ngamnika isiliva esinengi legolide","poem":2},{"lineBreak":true},{"text":"abakusebenzisela uBhali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ngakho-ke ngizawathatha amabele ami lapho esevuthiwe,","poem":1},{"text":"lewayini lami elitsha lapho selilungile.","poem":2},{"text":"Ngizayithatha lewulu yami kanye lelineni lami,","poem":1},{"text":"okwakumiselwe ukuvala ubunqunu bakhe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngakho khathesi ngizahlazulula ukuxhwala bakhe","poem":1},{"text":"emehlweni ezithandwa zakhe;","poem":2},{"lineBreak":true},{"text":"kakho ozamsusa ezandleni zami.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngizayiqeda yonke imikhosi yakhe yokuthokoza:","poem":1},{"text":"imikhosi yakhe yeminyaka yonke, ukuThwasa kweziNyanga,","poem":2},{"lineBreak":true},{"text":"insuku zakhe zamaSabatha,","poem":2},{"lineBreak":true},{"text":"yonke imikhosi yakhe emisiweyo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngizatshabalalisa izivini zakhe lezihlahla zakhe zemikhiwa,","poem":1},{"text":"lokhu athi yinhlawulo yakhe evela kuzithandwa zakhe;","poem":2},{"text":"ngizazenza zibe liguswanyana","poem":1},{"text":"zidliwe yizinyamazana zeganga.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngizamjezisela insuku atshisela ngazo","poem":1},{"text":"oBhali impepha;","poem":2},{"text":"wazicecisa ngamasongo langamangqongqo,","poem":1},{"text":"walandela izithandwa zakhe,","poem":2},{"lineBreak":true},{"text":"kodwa mina wangikhohlwa,” kutsho uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Ngakho sengizamhuga;","poem":1},{"text":"ngizamholela enkangala","poem":2},{"lineBreak":true},{"text":"ngikhulume laye kakuhle.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lapho-ke ngizambuyisela izivini zakhe,","poem":1},{"text":"ngenze iSigodi sase-Akhori sibe ngumnyango wethemba.","poem":2},{"text":"Khonapho uzahlabelela njengasezinsukwini zobutsha bakhe,","poem":1},{"text":"njengamhla ephuma eGibhithe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ngalolosuku,” kutsho uThixo,","poem":1},{"text":"“lizangibiza ngokuthi ‘ndoda yami’;","poem":2},{"lineBreak":true},{"text":"kalisayikungibiza ngokuthi ‘nkosi yami.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngizawasusa amabizo aboBhali ezindebeni zakhe;","poem":1},{"text":"amabizo abo akusayikukhulekwa ngawo futhi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngalolosuku ngizabenzela isivumelwano","poem":1},{"text":"lezinyamazana zeganga lezinyoni zasemoyeni","poem":2},{"lineBreak":true},{"text":"kanye lezidalwa ezihuquzela emhlabathini.","poem":2},{"text":"Idandili lenkemba kanye lempi","poem":1},{"text":"ngizakuqeda elizweni","poem":2},{"lineBreak":true},{"text":"ukuze konke kulale phansi kuvikelekile.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ngizakwendisela kimi kuze kube nininini;","poem":1},{"text":"ngizakwendisa ngokulunga langemfanelo,","poem":2},{"lineBreak":true},{"text":"ngothando langesihawu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ngizakwendisa ngokuthembeka,","poem":1},{"text":"njalo uzamamukela uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ngalolosuku ngizasabela,”","poem":1},{"text":"kutsho uThixo,","poem":2},{"text":"“Ngizasabela emikhathini,","poem":1},{"text":"layo izasabela emhlabeni,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"lomhlaba uzasabela emabeleni","poem":1},{"text":"lasewayinini elitsha kanye lasemafutheni,","poem":2},{"lineBreak":true},{"text":"lokhu kuzasabela kuJezerili.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ngizazihlanyelela yena elizweni;","poem":1},{"text":"ngizabonakalisa uthando lwami","poem":2},{"lineBreak":true},{"text":"kulowo engambiza ngokuthi,","poem":2},{"lineBreak":true},{"text":"‘Akasi sithandwa sami.’","poem":2},{"text":"Ngizakuthi kulabo ababizwa ngokuthi,","poem":1},{"text":"‘Abangasibantu bami,’","poem":2},{"lineBreak":true},{"text":"‘Lingabantu bami’;","poem":2},{"text":"bona bazakuthi,","poem":1},{"text":"‘UnguNkulunkulu wethu.’ ”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/HOS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/HOS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/HOS/1.json","previousChapterAudioLinks":{},"numberOfVerses":23}