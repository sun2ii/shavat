{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"HOS","translationId":"nde_bib","name":"UHosiya","commonName":"UHosiya","title":"UHosiya","order":28,"numberOfChapters":14,"sha256":"3445b0e1290e1a022a101ba68d37532d3620ecee62fe870fdc3a986713f5c88c","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nde_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["Icala Eletheswa Abako-Israyeli"]},{"type":"verse","number":1,"content":[{"text":"Zwanini ilizwi likaThixo, lina bako-Israyeli","poem":1},{"text":"ngoba kulecala uThixo alethesa lina elihlala elizweni:","poem":2},{"text":"“Akulakwethembeka, akulathando, akukho ukumamukela","poem":1},{"text":"uNkulunkulu elizweni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kulokuthuka kuphela, lokuqamba amanga lokubulala,","poem":1},{"text":"lokuntshontsha kanye lobufebe;","poem":2},{"text":"benza ububi bonke,","poem":1},{"text":"njalo ukuchithwa kwegazi kulandela ukuchithwa kwegazi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ilizwe liyalila ngenxa yalokhu,","poem":1},{"text":"njalo bonke abahlala kulo bayacikizeka;","poem":2},{"text":"izinyamazana zeganga lezinyoni zasemoyeni","poem":1},{"text":"kanye lenhlanzi zasolwandle kuyafa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kodwa akungabi lamuntu omangalayo,","poem":1},{"text":"akungabi lomuntu owethesa omunye icala","poem":2},{"text":"ngoba abantu bakho bafana lalabo","poem":1},{"text":"abamangalela umphristi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Liyakhubeka emini lebusuku,","poem":1},{"text":"labaphrofethi bakhubeka kanye lani.","poem":2},{"text":"Ngakho unyoko ngizamchitha,","poem":1}]},{"type":"verse","number":6,"content":[{"text":"abantu bami bachithwa yikungabi lolwazi.","poem":2},{"lineBreak":true},{"text":"Njengoba likwalile ukwazi,","poem":1},{"text":"lami ngiyalala njengabaphristi bami;","poem":2},{"text":"ngoba kaliwunakanga umthetho kaNkulunkulu wenu,","poem":1},{"text":"lami angiyikubanaka abantwana benu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngokwanda kwabaphristi,","poem":1},{"text":"kwanda kanjalo lokona kwabo kimi,","poem":2},{"lineBreak":true},{"text":"benanisa uDumo lwabo ngento elihlazo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Badla izono zabantu bami","poem":1},{"text":"bajabuliswe yikuxhwala kwabo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Njalo kuzakuba kanje: Njengabantu, njengabaphristi.","poem":1},{"text":"Bonke ngizabajezisela izindlela zabo,","poem":2},{"lineBreak":true},{"text":"ngiphindisele kubo lezenzo zabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bazakudla kodwa bangasuthi;","poem":1},{"text":"bazakwenza ubufebe kodwa bangandi,","poem":2},{"text":"ngoba bamdelile uThixo","poem":1},{"text":"ukuba bazinikele","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ebufebeni,","poem":2},{"text":"lewayini elidala kanye lelitsha","poem":1},{"text":"elisusa ukuqedisisa kwabantu bami.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Badinga izeluleko esithombeni sesigodo","poem":1},{"text":"baphendulwe yiluthi lwesigodo.","poem":2},{"text":"Umoya wobufebe uyabedukisa;","poem":1},{"text":"kabathembekanga kuNkulunkulu wabo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Banikela imihlatshelo ezingqongweni zezintaba","poem":1},{"text":"batshise iminikelo phezu kwamaqaqa,","poem":2},{"text":"ngaphansi komʼokhi, lomphophila kanye lomtherebhinti,","poem":1},{"text":"lapho okulomthunzi omnandi.","poem":2},{"text":"Ngakho amadodakazi enu enza ubuwule,","poem":1},{"text":"labomalukazana benu benze ubufebe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Angiyikuwajezisa amadodakazi enu","poem":1},{"text":"lapho esenza ubuwule","poem":2},{"text":"loba omalukazana benu","poem":1},{"text":"lapho besenza ubufebe,","poem":2},{"text":"ngoba amadoda uqobo azwana lezifebe anikele","poem":1},{"text":"imihlatshelo lezifebe ezisezindaweni zokukhonzela","poem":2},{"lineBreak":true},{"text":"abantu abangelakuqedisisa bazabhubha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Lanxa ufeba, we Israyeli,","poem":1},{"text":"uJuda kangabi lecala.","poem":2},{"lineBreak":true},{"text":"Lingayi eGiligali;","poem":1},{"text":"lingayi eBhethi-Aveni.","poem":2},{"lineBreak":true},{"text":"Njalo lingafungi lisithi,","poem":2},{"lineBreak":true},{"text":"‘Ngeqiniso njengoba uThixo ekhona!’","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Abako-Israyeli bayiziqholo,","poem":1},{"text":"njengethokazi eliyisiqholo.","poem":2},{"text":"Pho uThixo angabelusela njani","poem":1},{"text":"emadlelweni njengezimvu na?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"U-Efrayimi uhlangene lezithombe;","poem":1},{"text":"myekeleni enjalo!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Lalapho okunathwayo kwabo sekuphelile,","poem":1},{"text":"bayaqhubeka ngobufebe babo;","poem":2},{"lineBreak":true},{"text":"ababusi babo bazithanda kakhulu izindlela ezilihlazo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Isavunguzane sizabakhukhula,","poem":1},{"text":"lemihlatshelo yabo izabalethela ihlazo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}