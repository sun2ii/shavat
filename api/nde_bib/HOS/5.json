{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"HOS","translationId":"nde_bib","name":"UHosiya","commonName":"UHosiya","title":"UHosiya","order":28,"numberOfChapters":14,"sha256":"3445b0e1290e1a022a101ba68d37532d3620ecee62fe870fdc3a986713f5c88c","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nde_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["Ukwahlulela Okumelane Lo-Israyeli"]},{"type":"verse","number":1,"content":[{"text":"“Zwanini lokhu, lina baphristi!","poem":1},{"text":"Lalelani, lina bako-Israyeli.","poem":2},{"text":"Lalela, wena ndlu yobukhosi!","poem":1},{"text":"Ukwahlulela lokhu kumelane lani:","poem":2},{"text":"Kade lingumjibila eMizipha,","poem":1},{"text":"umambule owendlalwe eThabhori.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abahlamuki batshonile ekubulaleni,","poem":1},{"text":"ngizabalaya bonke.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mina ngazi konke ngo-Efrayimi;","poem":1},{"text":"u-Israyeli kafihlakalanga kimi.","poem":2},{"text":"Efrayimi, khathesi ususenza ubufebe;","poem":1},{"text":"u-Israyeli uxhwalile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Izenzo zabo kazibavumeli","poem":1},{"text":"ukubuyela kuNkulunkulu wabo.","poem":2},{"text":"Umoya wobufebe usezinhliziyweni zabo;","poem":1},{"text":"kabamamukeli uThixo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ukuzigqaja kuka-Israyeli kufakaza okubi ngaye;","poem":1},{"text":"abako-Israyeli, kanye laye u-Efrayimi,","poem":2},{"text":"bayakhubeka ezonweni zabo.","poem":1},{"text":"LoJuda laye ukhubeka labo","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lapho behamba lemihlambi yezimvu zabo leyenkomo","poem":1},{"text":"ukuyadinga uThixo,","poem":2},{"text":"kabayikumfumana;","poem":1},{"text":"uzisusile kubo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kabathembekanga kuThixo;","poem":1},{"text":"bazala abantwana ngokungemthetho.","poem":2},{"text":"Khathesi imikhosi yabo yokuThwasa Kwezinyanga","poem":1},{"text":"izabaqothula kanye lamasimu abo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Khalisani icilongo eGibhiya,","poem":1},{"text":"lophondo eRama.","poem":2},{"text":"Hlabani umkhosi wempi eBhethi-Aveni;","poem":1},{"text":"khokhela, wena Bhenjamini.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"U-Efrayimi uzachithwa","poem":1},{"text":"ngosuku lokwahlulela.","poem":2},{"text":"Phakathi kwezizwana zako-Israyeli","poem":1},{"text":"ngimemezela okuliqiniso.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abakhokheli bakoJuda","poem":1},{"text":"banjengalabo abatshedisa amatshe omngcele.","poem":2},{"text":"Ngizathululela ulaka lwami phezu kwabo","poem":1},{"text":"njengesikhukhula samanzi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"U-Efrayimi uncindezelwe,","poem":1},{"text":"wanyathelwa ekwahluleleni,","poem":2},{"lineBreak":true},{"text":"ehlose ukulandela izithombe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mina nginjengenondo ku-Efrayimi,","poem":1},{"text":"njengokubola ebantwini bakoJuda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kwathi u-Efrayimi ebona umkhuhlane wakhe,","poem":1},{"text":"loJuda ebona izilonda zakhe,","poem":2},{"text":"u-Efrayimi waya e-Asiriya,","poem":1},{"text":"wathumela ilizwi loncedo enkosini enkulu.","poem":2},{"text":"Kodwa kayenelisi ukukwelapha,","poem":1},{"text":"kayenelisi ukwelapha izilonda zakho.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngoba ngizakuba njengesilwane ku-Efrayimi,","poem":1},{"text":"lanjengesilwane esikhulu kuJuda.","poem":2},{"text":"Ngizabadabudabula ngisuke ngihambe;","poem":1},{"text":"ngizabathwala ngihambe labo,","poem":2},{"lineBreak":true},{"text":"kungekho ozabahlenga.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngizabuyela endaweni yami","poem":1},{"text":"baze balivume icala labo.","poem":2},{"lineBreak":true},{"text":"Njalo bazabudinga ubuso bami;","poem":2},{"text":"esizini lwabo","poem":1},{"text":"bazangidinga impela.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}