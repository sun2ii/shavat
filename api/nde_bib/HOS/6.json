{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"HOS","translationId":"nde_bib","name":"UHosiya","commonName":"UHosiya","title":"UHosiya","order":28,"numberOfChapters":14,"sha256":"3445b0e1290e1a022a101ba68d37532d3620ecee62fe870fdc3a986713f5c88c","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nde_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["U-Israyeli Kaphenduki"]},{"type":"verse","number":1,"content":[{"text":"“Wozani sibuyele kuThixo.","poem":1},{"lineBreak":true},{"text":"Usesidabule saba yizicucu","poem":1},{"text":"kodwa uzaselapha;","poem":2},{"text":"usilimazile","poem":1},{"text":"kodwa uzawabopha amanxeba ethu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Emva kwensuku ezimbili uzasivuselela;","poem":1},{"text":"ngosuku lwesithathu uzasibuyisela","poem":2},{"lineBreak":true},{"text":"ukuze sihlale lapho akhona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kasimamukeleni uThixo;","poem":1},{"text":"kasiqiniseni ukumamukela.","poem":2},{"text":"Ngoqotho njengoba ilanga liphuma,","poem":1},{"text":"uzabonakala;","poem":2},{"text":"uzakuza kithi njengezulu lebusika,","poem":1},{"text":"lanjengezulu lentwasa elithambisa umhlaba.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ngingenzani ngawe, Efrayimi na?","poem":1},{"text":"Ngingenzani ngawe, Juda na?","poem":2},{"text":"Uthando lwenu lunjengenkungu yekuseni,","poem":1},{"text":"lunjengamazolo ekuseni anyamalalayo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngakho ngaliqumaquma ngabaphrofethi bami,","poem":1},{"text":"ngalibulala ngamazwi omlomo wami;","poem":2},{"lineBreak":true},{"text":"ukwahlulela kwami kwaphazima njengombane phezu kwenu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngoba mina ngifuna isihawu, hatshi umhlatshelo,","poem":1},{"text":"lokwamukela uNkulunkulu kuleminikelo yokutshiswa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Njengo-Adamu, sebesephule isivumelwano","poem":1},{"text":"babengathembekanga khonale.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"IGiliyadi lidolobho labantu abaxhwalileyo.","poem":1},{"text":"Lingcolile ngezinyathelo zegazi","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Njengezigebenga zicathamela umuntu,","poem":1},{"text":"zenzanjalo izigangi zabaphristi;","poem":2},{"text":"zibulala abantu emgwaqweni oya eShekhemu","poem":1},{"text":"zisenza izinto ezimbi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sengibone into etshaqisayo endlini ka-Israyeli.","poem":1},{"text":"U-Efrayimi uwela khonapho,","poem":2},{"lineBreak":true},{"text":"lo-Israyeli ungcolisiwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Lakuwe futhi Juda,","poem":1},{"text":"ukuvuna sekulungiselwe.","poem":2},{"lineBreak":true},{"text":"Lapho ngingabuyisela inotho yabantu bami.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}