text":"kusukela ekuvoxeni inhlama ize ikhukhumale.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngosuku lomkhosi wenkosi yethu","poem":1},{"text":"ababusi bathukutheliswa liwayini,","poem":2},{"lineBreak":true},{"text":"inkosi izihlanganise labaklolodayo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inhliziyo zabo zinjengeziko,","poem":1},{"text":"inkosi bayilanda ngamacebo ensitha.","poem":2},{"text":"Ukufutheka kwabo kuyadeda ubusuku bonke;","poem":1},{"text":"ekuseni kuyavutha njengomlilo obhebhayo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bonke batshisa njengeziko;","poem":1},{"text":"batshwabadele ababusi babo.","poem":2},{"text":"Wonke amakhosi abo ayawa,","poem":1},{"text":"kayikho ekhuleka kimi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"U-Efrayimi uxubana lezizwe;","poem":1},{"text":"u-Efrayimi ulikhekhe eliyisicecedu elingaphendulwanga.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abezizweni bacikiza amandla akhe,","poem":1},{"text":"kodwa yena kakunanzeleli.","poem":2},{"text":"Inwele zakhe sezilezimvu","poem":1},{"text":"kodwa yena kakunanzeleli.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ubuqholo buka-Israyeli bufakaza okubi ngaye,","poem":1},{"text":"kodwa phezu kwakho konke lokhu","poem":2},{"text":"kabuyeli kuThixo uNkulunkulu wakhe","poem":1},{"text":"loba amdinge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"U-Efrayimi unjengejuba,","poem":1},{"text":"ukhohliseka lula kalangqondo","poem":2},{"text":"ucela usizo eGibhithe,","poem":1},{"text":"abuye alucele e-Asiriya.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lapho sebehamba, ngizaphosa umambule wami phezu kwabo;","poem":1},{"text":"ngizabadonsela phansi njengezinyoni zasemoyeni.","poem":2},{"text":"Ngizabezwa behamba bonke,","poem":1},{"text":"ngizababamba.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Maye kubo","poem":1},{"text":"ngoba bedukile kimi!","poem":2},{"text":"Akube lencithakalo kubo","poem":1},{"text":"ngoba bangihlamukele!","poem":2},{"text":"Ngiyafisa ukubahlenga","poem":1},{"text":"kodwa bona bakhuluma amanga ngami.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kabakhalazi kimi ngezinhliziyo zabo","poem":1},{"text":"kodwa bakhalela emibhedeni yabo.","poem":2},{"text":"Babuthanela amabele lewayini elitsha","poem":1},{"text":"kodwa mina basuka bangidele.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngabafundisa ngabaqinisa,","poem":1},{"text":"kodwa baceba okubi ngami.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kabaphendukeli koPhezukonke","poem":1},{"text":"banjengedandili elisolekayo.","poem":2},{"text":"Abakhokheli babo bazabulawa ngenkemba","poem":1},{"text":"ngenxa yamazwi abo okweyisa.","poem":2},{"text":"Ngalokhu bazahlekwa","poem":1},{"text":"elizweni laseGibhithe.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}