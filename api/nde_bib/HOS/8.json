{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"HOS","translationId":"nde_bib","name":"UHosiya","commonName":"UHosiya","title":"UHosiya","order":28,"numberOfChapters":14,"sha256":"3445b0e1290e1a022a101ba68d37532d3620ecee62fe870fdc3a986713f5c88c","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nde_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["U-Israyeli Uzavuna Isavunguzane"]},{"type":"verse","number":1,"content":[{"text":"“Faka icilongo ezindebeni zakho!","poem":1},{"text":"Ukhozi lungaphezu kwendlu kaThixo","poem":2},{"text":"ngoba abantu basephule isivumelwano sami","poem":1},{"text":"bahlamukela lomthetho wami.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"U-Israyeli uyakhalaza kimi esithi,","poem":1},{"text":"‘Oh Nkulunkulu wethu, siyakwamukela!’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kodwa u-Israyeli ukwalile okuhle;","poem":1},{"text":"isitha sizaxotshana laye.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Babeka amakhosi kungekho mvumo yami;","poem":1},{"text":"bakhetha ababusi kungekho mvumo yami.","poem":2},{"text":"Ngesiliva sabo langegolide,","poem":1},{"text":"bazenzela izithombe zibe yikubhujiswa kwabo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lahla isithombe sakho sethole, wena Samariya!","poem":1},{"text":"Ulaka lwami luyavutha ngawe.","poem":2},{"text":"Koze kube nini bengelamandla okuhlambuluka na?","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Bavela ko-Israyeli!","poem":2},{"text":"Ithole leli labunjwa yingcwethi;","poem":1},{"text":"kalisuye Nkulunkulu.","poem":2},{"text":"Lizachobozwa libe yizicucu,","poem":1},{"text":"ithole lelo laseSamariya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bahlanyela umoya","poem":1},{"text":"bavune isavunguzane.","poem":2},{"text":"Ihlanga kalilasikhwebu;","poem":1},{"text":"kaliyikuthela ifulawa.","poem":2},{"text":"Aluba belingathela amabele,","poem":1},{"text":"abezizweni kade bezawamimiliza.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"U-Israyeli useginyiwe;","poem":1},{"text":"khathesi phakathi kwezizwe","poem":2},{"lineBreak":true},{"text":"unjengento engelasizo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngoba sebeye e-Asiriya","poem":1},{"text":"njengobabhemi weganga entula yedwa.","poem":2},{"lineBreak":true},{"text":"U-Efrayimi uzithengisile kuzithandwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lanxa bezithengisile phakathi kwezizwe,","poem":1},{"text":"ngizabaqoqela ndawonye.","poem":2},{"text":"Bazaqalisa ukucikizeka","poem":1},{"text":"bengaphansi kwencindezelo yenkosi elamandla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Lanxa u-Efrayimi wakha ama-alithare amanengi eminikelo yezono,","poem":1},{"text":"asebe ngama-alithare okwenza izono.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngabalobela izinto ezinengi zomthetho wami","poem":1},{"text":"kodwa bona bazithatha njengento engaziwayo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Banikela imihlatshelo njengezipho kimi","poem":1},{"text":"babuye badle inyama yakhona,","poem":2},{"lineBreak":true},{"text":"kodwa uThixo kathokozi ngabo.","poem":2},{"text":"Khathesi usezakhumbula ukuxhwala kwabo","poem":1},{"text":"abajezisele izono zabo:","poem":2},{"lineBreak":true},{"text":"Bazabuyela eGibhithe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"U-Israyeli usemkhohliwe uMenzi wakhe","poem":1},{"text":"wakha izindlu zamakhosi;","poem":2},{"lineBreak":true},{"text":"uJuda usevikele amadolobho amanengi ngezinqaba.","poem":2},{"text":"Kodwa ngizathumela umlilo emadolobheni abo","poem":1},{"text":"ozaqothula izinqaba zabo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}