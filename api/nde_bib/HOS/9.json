{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"HOS","translationId":"nde_bib","name":"UHosiya","commonName":"UHosiya","title":"UHosiya","order":28,"numberOfChapters":14,"sha256":"3445b0e1290e1a022a101ba68d37532d3620ecee62fe870fdc3a986713f5c88c","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/nde_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["Isijeziso Sika-Israyeli"]},{"type":"verse","number":1,"content":[{"text":"Ungathokozi, we Israyeli;","poem":1},{"text":"ungajabuli njengezinye izizwe.","poem":2},{"text":"Ngoba ube ungathembekanga kuNkulunkulu wakho;","poem":1},{"text":"uthanda umholo wesifebe","poem":2},{"lineBreak":true},{"text":"ezizeni zonke zokubhulela.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Iziza lezikhamelo zewayini kakuyikunika abantu ukudla;","poem":1},{"text":"iwayini elitsha lizabehlulekisa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kabayikuhlala elizweni likaThixo;","poem":1},{"text":"u-Efrayimi uzabuyela eGibhithe","poem":2},{"lineBreak":true},{"text":"adle ukudla okungcolileyo e-Asiriya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kabayikuthululela iminikelo yewayini kuThixo,","poem":1},{"text":"lemihlatshelo yabo kayiyikumthokozisa.","poem":2},{"text":"Imihlatshelo enje kubo izakuba njengesinkwa sabalilayo;","poem":1},{"text":"bonke abayidlayo bazangcola.","poem":2},{"text":"Ukudla lokhu kuzakuba ngokwabo;","poem":1},{"text":"akuyikufika ethempelini likaThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lizakwenzani ngosuku lwemikhosi yenu emisiweyo,","poem":1},{"text":"ngensuku zamadili kaThixo na?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lanxa bengaphunyuka ekubhujisweni,","poem":1},{"text":"iGibhithe izababutha,","poem":2},{"lineBreak":true},{"text":"njalo iMemfisi izabangcwaba.","poem":2},{"text":"Ingcebo yabo yesiliva izathathwa yimbabazane,","poem":1},{"text":"njalo ameva azagcwala emathenteni abo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Insuku zokujeziswa ziyeza,","poem":1},{"text":"insuku zokwahlulelwa sezifikile.","poem":2},{"lineBreak":true},{"text":"U-Israyeli kumele akwazi lokhu.","poem":2},{"text":"Ngoba izono zenu zinengi kakhulu","poem":1},{"text":"lenzondo yenu inkulu kakhulu,","poem":2},{"text":"umphrofethi ubalwa njengesiwula","poem":1},{"text":"umuntu oholwa ngomoya enziwe njengohlanya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Umphrofethi, ekanye loNkulunkulu wami,","poem":1},{"text":"ungumuntu olinda u-Efrayimi,","poem":2},{"text":"kodwa imijibila imlindele kuzozonke izindlela zakhe,","poem":1},{"text":"kanye lenzondo endlini kaNkulunkulu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Batshone baphelela ekonakaleni,","poem":1},{"text":"njengasezinsukwini zaseGibhiya.","poem":2},{"text":"UNkulunkulu uzakukhumbula ukuxhwala kwabo","poem":1},{"text":"abajezisele izono zabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Ekufumaneni kwami u-Israyeli","poem":1},{"text":"kwakunjengokuthola amagrebisi enkangala;","poem":2},{"text":"ekuboneni kwami okhokho benu,","poem":1},{"text":"kwakunjengokubona izithelo zakuqala zomkhiwa.","poem":2},{"text":"Kodwa ekufikeni kwabo kuBhali-Pheyori,","poem":1},{"text":"bazinikela kulesosithombe esihlazisayo","poem":2},{"lineBreak":true},{"text":"benyanyeka njengaleyonto ababeyithanda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Udumo luka-Efrayimi luzaphapha luhambe njengenyoni,","poem":1},{"text":"akuyikuba lokuzala, lokukhulelwa, lokuthatha izisu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Loba bangaze bondle abantwana,","poem":1},{"text":"ngizabemuka bonke.","poem":2},{"text":"Maye kubo,","poem":1},{"text":"lapho sengibadelile!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngimbonile u-Efrayimi, njengeThire,","poem":1},{"text":"ebekwe endaweni enhle.","poem":2},{"text":"Kodwa u-Efrayimi uzakhuphela","poem":1},{"text":"abantwana bakhe phandle kobulalayo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Baphe, Oh Thixo","poem":1},{"text":"uzabaphani na?","poem":2},{"text":"Baphe izibeletho eziphunzayo","poem":1},{"text":"lamabele angelalutho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Ngenxa yokuxhwala kwabo konke eGiligali,","poem":1},{"text":"ngabazonda khonale.","poem":2},{"text":"Ngenxa yezenzo zabo eziyizono,","poem":1},{"text":"ngizabaxotsha endlini yami.","poem":2},{"text":"Kangisayikubathanda futhi;","poem":1},{"text":"bonke abakhokheli babo bangabahlamuki.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"U-Efrayimi udlekile,","poem":1},{"text":"impande zabo zomile,","poem":2},{"lineBreak":true},{"text":"kabatheli zithelo.","poem":2},{"text":"Loba bengazala abantwana,","poem":1},{"text":"ngizayibulala inzalo yabo abayithandayo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"UNkulunkulu wami ubalile","poem":1},{"text":"ngoba kabamlalelanga;","poem":2},{"lineBreak":true},{"text":"bazakuba zinzulane phakathi kwezizwe.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}