{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Umbono omayelana ngoJuda leJerusalema owabonwa ngu-Isaya indodana ka-Amozi ensukwini zokubusa kuka-Uziya, loJothamu, lo-Ahazi loHezekhiya amakhosi akoJuda."]},{"type":"line_break"},{"type":"heading","content":["Isizwe Esihlamukayo"]},{"type":"verse","number":2,"content":[{"text":"Zwanini, mazulu! Lalelani, mhlaba!","poem":1},{"text":"Ngoba uThixo usekhulumile:","poem":2},{"text":"“Ngondla abantwana ngabakhulisa,","poem":1},{"text":"kodwa sebengihlamukele.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inkabi iyamazi umniniyo,","poem":1},{"text":"lobabhemi uyasazi isibaya somnikazi wakhe,","poem":2},{"text":"kodwa u-Israyeli kazi,","poem":1},{"text":"abantu bami kabaqedisisi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Maye kuso isizwe esonayo,","poem":1},{"text":"abantu abathwele amacala,","poem":2},{"text":"inzalo yabenza okubi,","poem":1},{"text":"abantwana abaxhwalileyo!","poem":2},{"text":"Sebemlahlile uThixo;","poem":1},{"text":"bamdelele oNgcwele ka-Israyeli,","poem":2},{"lineBreak":true},{"text":"bamfulathela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kungani kumele litshaywe futhi?","poem":1},{"text":"Kungani liqhubeka ngokuhlamuka?","poem":2},{"text":"Ikhanda lakho lonke lilimele,","poem":1},{"text":"yonke inhliziyo yakho ihlukuluziwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kusukela ngaphansi kwentende yonyawo lwakho kusiya esicholo sekhanda","poem":1},{"text":"lakho akukho kuphelela,","poem":2},{"text":"kodwa izilonda lemvivinya kuphela,","poem":1},{"text":"kanye lamanxeba;","poem":2},{"text":"akugeziswanga, akubotshwanga","poem":1},{"text":"kumbe kwathanjiswa ngamafutha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ilizwe lenu lichithekile,","poem":1},{"text":"amadolobho enu atshiswa ngomlilo,","poem":2},{"text":"umhlaba wenu uphundlwa ngabezizweni,","poem":1},{"text":"phambi kwenu uqobo,","poem":2},{"lineBreak":true},{"text":"uchitheka njengalapho udilizwa ngabezizweni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Indodakazi yaseZiyoni isele","poem":1},{"text":"njengedumba esivinini,","poem":2},{"text":"njengendlwana ensimini yamajodo,","poem":1},{"text":"njengedolobho elihonqolozelweyo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Aluba uThixo uSomandla","poem":1},{"text":"kasitshiyelanga abalutshwana abasindayo,","poem":2},{"text":"sasizakuba njengeSodoma;","poem":1},{"text":"sasizafana leGomora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Zwanini ilizwi likaThixo,","poem":1},{"text":"lina babusi baseSodoma,","poem":2},{"text":"lalelani umthetho kaNkulunkulu wethu,","poem":1},{"text":"lina bantu baseGomora!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Ubunengi bemihlatshelo yenu","poem":1},{"text":"buyini kimi?”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2},{"text":"“Ngileminikelo yokutshiswa edlula efunekayo,","poem":1},{"text":"eyenqama lamahwahwa ezifuyo ezinonisiweyo;","poem":2},{"text":"igazi lenkunzi,","poem":1},{"text":"lelamawundlu lelembuzi kalingithokozisi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lapho lisiza phambi kwami,","poem":1},{"text":"ngubani othe linyathele amaguma ami na?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yekelani ukuletha iminikelo eyize!","poem":1},{"text":"Impepha yenu iyisinengiso kimi.","poem":2},{"text":"Angingeke ngibekezelele imbuthano yenu yobubi,","poem":1},{"text":"eyokuThwasa kweNyanga, amaSabatha lemihlangano.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Umphefumulo wami uyawazonda","poem":1},{"text":"amadili enu okuthwasa kwezinyanga","poem":2},{"lineBreak":true},{"text":"lemikhosi yenu emisiweyo.","poem":2},{"text":"Sekube ngumthwalo kimi;","poem":1},{"text":"sengikhathele ngokukuthwala.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lapho lichaya izandla zenu likhuleka,","poem":1},{"text":"ngizalifihlela amehlo ami;","poem":2},{"text":"loba selikhuleka imikhuleko eminengi,","poem":1},{"text":"angiyikulalela.","poem":2},{"lineBreak":true},{"text":"Izandla zenu zigcwele igazi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Gezani libe ngabahlambulukileyo.","poem":1},{"text":"Susani izenzo zenu ezimbi phambi kobuso bami;","poem":2},{"lineBreak":true},{"text":"yekelani ukwenza okubi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Fundani ukwenza okulungileyo; funani ukwahlulela okuhle.","poem":1},{"text":"Khuthazani abancindezelweyo.","poem":2},{"text":"Vikelani izintandane;","poem":1},{"text":"lamulelani umfelokazi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Wozani, siqondisane sindawonye,”","poem":1},{"text":"kutsho uThixo.","poem":2},{"text":"“Lanxa izono zenu zibomvu gebhu,","poem":1},{"text":"zizakuba mhlophe njengonqwaqwane,","poem":2},{"text":"loba zibomvu njengegazi,","poem":1},{"text":"zizakuba njengoboya bezimvu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nxa livuma njalo lilalela,","poem":1},{"text":"lizakudla okuhle kwelizwe;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"kodwa nxa linqaba, lihlamuka,","poem":1},{"text":"lizadliwa yinkemba.”","poem":2},{"text":"Ngoba umlomo kaThixo usukhulumile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Khangelani ukuthi idolobho elithembekileyo","poem":1},{"text":"seliphenduke laba yisifebe kanjani!","poem":2},{"text":"Lake lagcwala ngokufaneleyo;","poem":1},{"text":"ukulunga kwakuhlala kulo,","poem":2},{"lineBreak":true},{"text":"kodwa khathesi sekuhlala ababulali!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Isiliva senu sesingamanyele,","poem":1},{"text":"iwayini lenu elihle selihlanganiswe lamanzi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ababusi benu bangabahlamuki,","poem":1},{"text":"abangane bamasela;","poem":2},{"text":"bonke bathanda izivalamlomo,","poem":1},{"text":"bafune izipho.","poem":2},{"text":"Izintandane kabazivikeli;","poem":1},{"text":"indaba yomfelokazi kayifiki kibo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ngakho-ke iNkosi, uThixo uSomandla,","poem":1},{"text":"uMninimandla ka-Israyeli, uthi:","poem":2},{"text":"“Yebo! Ngizabhodlisela ezitheni zami,","poem":1},{"text":"ngibuye ngiphindisele kwabayizitha zami.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ngizaphakamisela isandla sami kini;","poem":1},{"text":"ngizawahlambulula ngokupheleleyo amanyele enu,","poem":2},{"lineBreak":true},{"text":"ngisuse lakho konke ukungcola kwenu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ngizabuyisa abehluleli benu njengezinsukwini zakudala,","poem":1},{"text":"labeluleki benu njengasekuqaleni.","poem":2},{"text":"Muva uzabizwa ngokuthi","poem":1},{"text":"iDolobho Lokulunga,","poem":2},{"lineBreak":true},{"text":"iDolobho Elithembekileyo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"IZiyoni izahlengwa ngemfanelo,","poem":1},{"text":"abaphendukayo bayo bahlengwe ngokulunga.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kodwa abahlamuki lezoni bazachithwa,","poem":1},{"text":"lalabo abalahla uThixo bazabhubha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Lizayangeka ngenxa yezihlahla zomʼokhi ezingcwele","poem":1},{"text":"elazithokozisa ngazo.","poem":2},{"text":"Lizadana ngamasimu elawakhethayo.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Lizafana lomʼokhi olamahlamvu asebuna,","poem":1},{"text":"lanjengensimu engelamanzi.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Indoda elamandla izafana lencwathi,","poem":1},{"text":"umsebenzi wayo ufane lenhlansi;","poem":2},{"text":"kokubili kuzakutsha kanyekanye,","poem":1},{"text":"kungekho ozacitsha umlilo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}