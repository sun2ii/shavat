{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Maye kulabo abenza imithetho emibi,","poem":1},{"text":"lakulabo ababhala izimiso ezincindezelayo,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ukuba kwamukwe abayanga amalungelo abo","poem":1},{"text":"lokugodla okufaneleyo kwabantu bami abancindezelweyo;","poem":2},{"text":"bazingela abafelokazi","poem":1},{"text":"baqhwage izintandane.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lizakwenzani ngosuku lokuthonisiswa","poem":1},{"text":"lapho incithakalo isiza ivela khatshana?","poem":2},{"text":"Lizabalekela kubani ukuba lithole usizo na?","poem":1},{"text":"Lizayitshiya ngaphi inotho yenu?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Akukho okuzasala, kodwa ukuba baquthe phakathi kwabathunjiweyo","poem":1},{"text":"loba bafe lababuleweyo.","poem":2},{"lineBreak":true},{"text":"Ikanti kukho konke lokhu, ukuthukuthela kwakhe akupheli,","poem":1},{"text":"isandla sakhe silokhu siphakanyisiwe.","poem":2}]},{"type":"heading","content":["UNkulunkulu Wahlulela I-Asiriya"]},{"type":"verse","number":5,"content":[{"text":"“Maye kumʼAsiriya, intonga yentukuthelo yami,","poem":1},{"text":"esandleni sayo kulesagila solaka lwami!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngimthumela ukuyamelana lesizwe esingelankulunkulu,","poem":1},{"text":"ngimthumela ukuyamelana labantu abangithukuthelisayo,","poem":2},{"text":"ukuba athumbe ahluthune impahla yokuthunjwa,","poem":1},{"text":"lokubanyathelela phansi njengodaka ezindleleni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kodwa lokhu akusikho akujongileyo,","poem":1},{"text":"lokhu akusikho okusengqondweni yakhe;","poem":2},{"text":"injongo yakhe yikutshabalalisa,","poem":1},{"text":"abhubhise izizwe ezinengi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Uthi, ‘Izinduna zami zebutho kazisimakhosi zonke na?","poem":1}]},{"type":"verse","number":9,"content":[{"text":"IKhalino kaliphumelelanga njengeKharikhemishi na?","poem":2},{"text":"IHamathi kalinjenge-Ariphadi na?","poem":1},{"text":"LeSamariya kayinjengeDamaseko na?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lanjengoba isandla sami sabamba imibuso yezithombe,","poem":1},{"text":"imibuso ezifanekiso zayo zedlula ezeJerusalema lezeSamariya,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"angiyikuliphatha iJerusalema lezithombe zalo","poem":1},{"text":"ngendlela engaphatha ngayo iSamariya lezithombe zayo na?’ ”","poem":2}]},{"type":"verse","number":12,"content":["Lapho uThixo esewuqedile wonke umsebenzi wakhe mayelana lentaba iZiyoni leJerusalema uzakuthi, “Ngizayijezisa inkosi yase-Asiriya ngenxa yokuzigqaja kwayo lokuzazisa okubonakala emehlweni ayo.”"]},{"type":"verse","number":13,"content":["Ngoba uthi:",{"text":"“ ‘Ngamandla esandla sami langokuhlakanipha kwami","poem":1},{"text":"sengenze lokhu ngoba ngilokuqedisisa.","poem":2},{"text":"Ngayisusa imingcele yezizwe,","poem":1},{"text":"ngathumba inotho yazo;","poem":2},{"lineBreak":true},{"text":"njengolamandla nganqoba amakhosi azo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Njengomuntu efinyelela isidleke senyoni,","poem":1},{"text":"ngokunjalo isandla sami safinyelela enothweni yezizwe,","poem":2},{"text":"njengabantu bebutha amaqanda atshiyiweyo,","poem":1},{"text":"kanjalo ngaqoqa amazwe wonke;","poem":2},{"text":"akukho okwaphaphazelisa amaphiko","poem":1},{"text":"loba okwavula umlomo wakho kwatshiyoza.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Konje ihloka liyaziphakamisela ngaphezu kwalowo olizulisayo na,","poem":1},{"text":"loba isaha izincome imelane lalowo oyisebenzisayo na?","poem":2},{"text":"Njengangathi induku izanyikinya lowo oyiphakamisayo,","poem":1},{"text":"kumbe isagila sinyikinye lowo ongasiso sigodo!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngakho-ke, iNkosi, uThixo uSomandla,","poem":1},{"text":"uzathumela isifo esicikizayo emabuthweni ayo aqinileyo;","poem":2},{"text":"ngaphansi kobukhosi bayo kuzaphembeka umlilo","poem":1},{"text":"njengelangabi elibhebhayo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ukukhanya kuka-Israyeli kuzakuba ngumlilo,","poem":1},{"text":"oNgcwele wabo abe lilangabi,","poem":2},{"text":"ngosuku olulodwa lizatshisa liqede","poem":1},{"text":"ameva akhe lokhula lwakhe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ubuhle bamahlathi akhe lamasimu akhe avundileyo,","poem":1},{"text":"uzakuqeda ngokupheleleyo","poem":2},{"lineBreak":true},{"text":"njengalapho umuntu ogulayo ecikizeka.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Izihlahla zamahlathi ezisalayo zizakuba zilutshwana,","poem":1},{"text":"okungathi lomntwana azibale.","poem":2}]},{"type":"heading","content":["Insalela Yako-Israyeli"]},{"type":"verse","number":20,"content":[{"text":"Ngalolosuku insalela yako-Israyeli,","poem":1},{"text":"abendlu kaJakhobe abasindayo,","poem":2},{"text":"kabasayikwethemba kuye","poem":1},{"text":"owabatshayayo wababhubhisa","poem":2},{"text":"kodwa ngeqiniso bazathembela kuThixo,","poem":1},{"text":"oNgcwele ka-Israyeli.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Insalela izabuyela, insalela kaJakhobe","poem":1},{"text":"izabuyela kuSomandla uNkulunkulu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Loba abantu bakho, we Israyeli, benjengetshebetshebe olwandle,","poem":1},{"text":"kuzabuya insalela kuphela.","poem":2},{"text":"Incithakalo isimenyezelwe,","poem":1},{"text":"iyabakhulela kodwa ilungile.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"INkosi, uThixo uSomandla, uzasifeza isimemezelo","poem":1},{"text":"sokubhujiswa elizweni lonke.","poem":2}]},{"type":"verse","number":24,"content":["Ngakho-ke lokho yikho iNkosi, uThixo uSomandla akutshoyo:",{"text":"“Awu bantu bami abahlala eZiyoni,","poem":1},{"text":"lingawesabi ama-Asiriya","poem":2},{"text":"alitshaya ngentonga","poem":1},{"text":"njalo lawo aliphakamisela isagila njengokwenziwa yiGibhithe.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Masinyane ukulithukuthelela kwami kuzaphela,","poem":1},{"text":"ulaka lwami luzaqondiswa ekubhujisweni kwabo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"UThixo uSomandla uzabatshaya ngomchilo","poem":1},{"text":"njengalapho atshaya iMidiyani edwaleni lase-Orebi,","poem":2},{"text":"njalo uzaphakamisela intonga yakhe ngaphezu kwamanzi","poem":1},{"text":"njengalokhu akwenza eGibhithe.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ngalolosuku imithwalo yabo izasuswa emahlombe enu,","poem":1},{"text":"lejogwe labo entanyeni zenu;","poem":2},{"text":"ijogwe lizakwephulwa","poem":1},{"text":"ngoba selizimukile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Bayangena e-Ayathi;","poem":1},{"text":"badabula phakathi kweMigironi;","poem":2},{"lineBreak":true},{"text":"bagcina impahla eMikhimashi.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Badlula emkhandlwini bathi,","poem":1},{"text":"“Ebusuku sizalala eGebha.”","poem":2},{"text":"IRama liyathuthumela;","poem":1},{"text":"iGibhiya likaSawuli liyabaleka.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Hlaba umkhosi, We! Ndodakazi kaGalimi,","poem":1},{"text":"lalela we Layisha!","poem":2},{"lineBreak":true},{"text":"Anathothi ozihawulelayo!","poem":2}]},{"type":"verse","number":31,"content":[{"text":"IMadimena iyabaleka;","poem":1},{"text":"abantu baseGebhimu bazacatsha.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ngalolosuku bazakuma kancane, kancane eNobhi,","poem":1},{"text":"bazakhomba ngezinqindi zabo","poem":2},{"text":"intaba yeNdodakazi yeZiyoni,","poem":1},{"text":"eqaqeni lwaseJerusalema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Khangelani, iNkosi, uThixo uSomandla,","poem":1},{"text":"uzaquma ingatsha ngamandla amakhulu.","poem":2},{"text":"Izihlahla ezidephileyo zizaqunywa.","poem":1},{"text":"Ezinde zazo zizakwehliselwa phansi.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ngehloka uzagamula izixuku zehlathi;","poem":1},{"text":"iLebhanoni izakuwa phambi kwakhe olaMandla.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/9.json","previousChapterAudioLinks":{},"numberOfVerses":34}