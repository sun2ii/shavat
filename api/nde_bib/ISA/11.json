{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":11,"content":[{"type":"heading","content":["UGatsha Oluvela KuJese"]},{"type":"verse","number":1,"content":[{"text":"Ihlumela lizavela esidindini sikaJese;","poem":1},{"text":"uGatsha oluhlume empandeni zakhe luzathela izithelo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"UMoya kaThixo uzakuba phezu kwakhe,","poem":1},{"text":"uMoya wokuhlakanipha lowokuqedisisa,","poem":2},{"lineBreak":true},{"text":"uMoya wokweluleka lowamandla,","poem":2},{"lineBreak":true},{"text":"uMoya wokwazi lowokwesaba uThixo,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"njalo uzathokoziswa yikwesaba uThixo.","poem":1},{"lineBreak":true},{"text":"Kayikwahlulela ngalokho akubona ngamehlo akhe,","poem":1},{"text":"loba aqume ngalokho akuzwa ngendlebe zakhe;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"kodwa abaswelayo uzabehlulela ngokulunga","poem":1},{"text":"athathe izinqumo ngabayanga basemhlabeni ngokulunga.","poem":2},{"text":"Uzatshaya umhlaba ngentonga yomlomo wakhe;","poem":1},{"text":"ngomoya wendebe zakhe uzabulala ababi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ukulunga kuzakuba libhanti lakhe,","poem":1},{"text":"ukwethembeka kube luzwezwe ekhalweni lwakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Impisi izahlala lezinyane lemvu,","poem":1},{"text":"ingwe izalala phansi lembuzi,","poem":2},{"text":"ithole kanye lesilwane kudle ndawonye;","poem":1},{"text":"umntwana omncane akukhokhele.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inkomokazi izakudla lebhele,","poem":1},{"text":"amankonyane akho alale ndawonye;","poem":2},{"lineBreak":true},{"text":"njalo isilwane sizakudla utshani njengenkabi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Usane luzadlalela phansi komlindi webululu,","poem":1},{"text":"umntwana omncane angenise isandla sakhe","poem":2},{"lineBreak":true},{"text":"emlonyeni womlindi wenhlangwana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abayikulimaza loba badilize","poem":1},{"text":"kuyo yonke intaba yami engcwele,","poem":2},{"text":"ngoba umhlaba uzagcwala ngolwazi lukaThixo","poem":1},{"text":"njengamanzi egcwalisa ulwandle.","poem":2}]},{"type":"verse","number":10,"content":["Ngalolosuku iMpande kaJese izakuma njengophawu ebantwini; izizwe zizabuthana kuye, indawo yakhe yokuphumula izakuba lodumo."]},{"type":"verse","number":11,"content":["Ngalolosuku uThixo uzakwelula isandla sakhe okwesibili ukuba abuyise insalela zabantu bakhe abasala e-Asiriya, eGibhithe, ePhathrosi, eTiyopiya, eKhushi, e-Elamu, eShinari, eHamathi lasezihlengeni zolwandle."]},{"type":"verse","number":12,"content":[{"text":"Uzaphakamisela izizwe uphawu","poem":1},{"text":"aqoqe abaxotshwayo ko-Israyeli.","poem":2},{"text":"Uzahlanganisa abantu bakoJuda abahlakazekileyo","poem":1},{"text":"bevela emagumbini amane omhlaba.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ubukhwele buka-Efrayimi buzaphela,","poem":1},{"text":"izitha zikaJuda zizaqunywa;","poem":2},{"text":"u-Efrayimi akayikukhwelezela uJuda,","poem":1},{"text":"kumbe uJuda abe lobutha ku-Efrayimi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bazahwitha phansi emithezukweni yaseFilistiya ngasentshonalanga;","poem":1},{"text":"bebonke bazaphanga abantu basempumalanga.","poem":2},{"text":"Bazanqoba i-Edomi leMowabi lama-Amoni","poem":1},{"text":"azakuba ngaphansi kwabo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"UThixo uzacitsha","poem":1},{"text":"umsele wolwandle lwaseGibhithe,","poem":2},{"text":"ngomoya otshisayo uzadlulisa isandla sakhe","poem":1},{"text":"phezu komfula uYufrathe.","poem":2},{"text":"Uzawahlukanisa ube yizifula eziyisikhombisa","poem":1},{"text":"ukuze abantu bawuchaphe befake amanyathelo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kuzakuba lomgwaqo omkhulu wezinsalela zabantu bakhe","poem":1},{"text":"abasele e-Asiriya,","poem":2},{"text":"njengoba kwakunjalo ko-Israyeli","poem":1},{"text":"ekubuyeni kwabo bevela eGibhithe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/10.json","previousChapterAudioLinks":{},"numberOfVerses":16}