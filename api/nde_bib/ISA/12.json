{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["Izingoma Zokubonga"]},{"type":"verse","number":1,"content":["Ngalolosuku wena uzakuthi:",{"text":"“Ngizakubonga Oh Thixo.","poem":1},{"text":"Lanxa wawungithukuthelele","poem":2},{"text":"ulaka lwakho seluphelile,","poem":1},{"text":"njalo usungiduduzile.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngeqiniso uNkulunkulu uyinsindiso yami;","poem":1},{"text":"ngizathemba ngingesabi.","poem":2},{"text":"UThixo, uThixo ngokwakhe ungamandla lengoma yami;","poem":1},{"text":"usebe yinsindiso yami.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngentokozo uzakukha amanzi","poem":1},{"text":"emithonjeni yensindiso.","poem":2}]},{"type":"verse","number":4,"content":["Ngalolosuku uzakuthi:",{"text":"“Mbongeni uThixo, bizani ibizo lakhe,","poem":1},{"text":"zaziseni izizwe ngalokhu akwenzileyo,","poem":2},{"lineBreak":true},{"text":"limemezele ukuthi ibizo lakhe liphakeme.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hlabelelani kuThixo, ngoba wenze izinto ezinhle kakhulu;","poem":1},{"text":"lokhu kwenzeni kwazakale emhlabeni wonke.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Memezani kakhulu lihlabele ngokuthokoza, bantu baseZiyoni,","poem":1},{"text":"ngoba mkhulu oNgcwele ka-Israyeli phakathi kwenu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}