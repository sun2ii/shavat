{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":13,"content":[{"type":"heading","content":["Isiphrofethi NgeBhabhiloni"]},{"type":"verse","number":1,"content":["Leli yilizwi elimayelana leBhabhiloni elaboniswa u-Isaya indodana ka-Amozi:"]},{"type":"verse","number":2,"content":[{"text":"Phakamisa uphawu phezu koqaqa oluligceke,","poem":1},{"text":"umemezele kubo,","poem":2},{"text":"ubaqhwebe ngesandla","poem":1},{"text":"ukuba bangene emasangweni asesikhosini.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sengibalayile abangcwele bami,","poem":1},{"text":"sengiwalayile amaqhawe ami ukuba afeze ulaka lwami,","poem":2},{"lineBreak":true},{"text":"lawo athokozela ukunqoba kwami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lalelani, umsindo phezu kwezintaba,","poem":1},{"text":"onjengowexuku elikhulu.","poem":2},{"text":"Lalelani, ukuxokozela phakathi kwemibuso","poem":1},{"text":"njengezizwe zibuthana ndawonye!","poem":2},{"text":"UThixo uSomandla ubutha","poem":1},{"text":"ibutho elibuthela impi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bavela emazweni akude,","poem":1},{"text":"emikhawulweni yamazulu,","poem":2},{"text":"uThixo lezikhali zolaka lwakhe,","poem":1},{"text":"ukuba kuchithwe ilizwe lonke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lilani ngoba usuku lukaThixo seluseduze.","poem":1},{"text":"Luzafika njengokuchithakala okuvela kuSomandla.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngenxa yalokhu izandla zonke zizakuba buthakathaka,","poem":1},{"text":"inhliziyo zabantu bonke zizaphela amandla.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bazakuba lokwesaba okukhulu,","poem":1},{"text":"baphathwe yibuhlungu losizi;","poem":2},{"lineBreak":true},{"text":"bazabhinqika njengowesifazane ehelelwa.","poem":2},{"text":"Bazakhangelana bemangele,","poem":1},{"text":"ubuso babo bungamalangabi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Khangelani usuku lukaThixo luyeza,","poem":1},{"text":"usuku lwesihluku, ulaka lokuthukuthela okukhulu,","poem":2},{"text":"ukwenza ilizwe lichitheke,","poem":1},{"text":"kubhujiswe izoni eziphakathi kwalo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Izinkanyezi zezulu lemithala yazo","poem":1},{"text":"akuyikukhanyisa.","poem":2},{"text":"Ilanga eliphumayo lizafiphazwa","poem":1},{"text":"lenyanga ayiyikukhanyisa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Umhlaba ngizawujezisa ngenxa yobubi bawo,","poem":1},{"text":"lababi ngenxa yezono zabo.","poem":2},{"text":"Ngizaqeda ukukloloda kwabazikhukhumezayo,","poem":1},{"text":"ngehlise ukuzigqaja kwabalesihluku.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngizakwenza abantu basweleke okudlula igolide elicengekileyo,","poem":1},{"text":"basweleke okudlula igolide lase-Ofiri.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngakho-ke ngizakwenza amazulu anyikinyeke;","poem":1},{"text":"lomhlaba uzamazame endaweni yawo","poem":2},{"text":"ngokuthukuthela kukaThixo uSomandla,","poem":1},{"text":"ngosuku lolaka lwakhe oluvuthayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Njengempala ezingelwayo,","poem":1},{"text":"lanjengezimvu ezingelamelusi,","poem":2},{"text":"omunye lomunye uzabuyela ebantwini bakibo,","poem":1},{"text":"omunye lomunye uzabalekela elizweni lakibo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lowo ozathunjwa uzagwazwa;","poem":1},{"text":"bonke abazabanjwa bazabulawa ngenkemba.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Izingane zabo zizamahlazelwa phambi kwamehlo abo;","poem":1},{"text":"izindlu zabo zizakhuthuzwa, omkabo babanjwe ngodlakela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Khangelani, ngizabavusela amaMede","poem":1},{"text":"angelandaba lesiliva,","poem":2},{"lineBreak":true},{"text":"njalo engalijabuleli legolide.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Imitshoko yawo izabulala izinsizwa;","poem":1},{"text":"kawayikuba lozwelo ezinganeni","poem":2},{"lineBreak":true},{"text":"loba abe lesihawu ebantwaneni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"IBhabhiloni, igugu lemibuso,","poem":1},{"text":"ubukhazikhazi bokuziqhenya kwamaKhaladiya,","poem":2},{"text":"lizachithwa nguNkulunkulu","poem":1},{"text":"njengeSodoma leGomora.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Akuyikuhlalwa kulo futhi","poem":1},{"text":"loba kwakhiwe kulo kuzozonke izizukulwane;","poem":2},{"text":"akulama-Arabhu azamisa amathente awo khona,","poem":1},{"text":"loba umelusi ozaphumuza imihlambi yakhe khona.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kodwa izinyamazana zeganga zizahlala khona,","poem":1},{"text":"amakhanka azahlala ezindlini zakhona","poem":2},{"text":"lezikhova zizahlala khona,","poem":1},{"text":"lamagogo aqolotshe khona.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Impisi zizakhala ezinqabeni zakhona,","poem":1},{"text":"amakhanka ezindlini ezinhle zobukhosi.","poem":2},{"text":"Isikhathi salo sesizafika","poem":1},{"text":"njalo insuku zalo kaziyikwandiswa.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}