{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"UThixo uzakuba lesihawu kuJakhobe;","poem":1},{"text":"uzamkhetha njalo u-Israyeli,","poem":2},{"lineBreak":true},{"text":"abahlalise elizweni labo.","poem":2},{"text":"Abezizwe bazahlangana labo","poem":1},{"text":"bamanyane lendlu kaJakhobe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Izizwe zizabathatha","poem":1},{"text":"zibase endaweni yabo.","poem":2},{"text":"Indlu ka-Israyeli izathumba izizwe","poem":1},{"text":"zibe yizisebenzi zesilisa lezesifazane elizweni likaThixo.","poem":2},{"text":"Bazakwenza abathumbi babo babe yizigqili,","poem":1},{"text":"babuse abancindezeli babo.","poem":2}]},{"type":"verse","number":3,"content":["Ngosuku uThixo azaliphumuza ngalo ekuhluphekeni, ekutshikatshikeni, lasebugqilini obulesihluku,"]},{"type":"verse","number":4,"content":["lizakutsho la amazwi okukloloda enkosini yaseBhabhiloni lithi:",{"text":"Umncindezeli usefikile ekucineni,","poem":1},{"text":"ukuthukuthela kwakhe sekuphelile!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"UThixo useyephule intonga yababi,","poem":1},{"text":"induku yobukhosi eyababusi,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"abatshaya abantu ngokuthukuthela,","poem":1},{"text":"langokugalela okungapheliyo,","poem":2},{"text":"banqoba izizwe ngentukuthelo","poem":1},{"text":"langokuncindezela okungapheliyo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Amazwe wonke alokuphumula lokuthula;","poem":1},{"text":"aphahluka ahlabelele izingoma.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lezihlahla zamaphayini lemisedari yaseLebhanoni","poem":1},{"text":"ziyathokoza ngawe zithi,","poem":2},{"text":"“Njengoba khathesi usuwiselwe phansi","poem":1},{"text":"akula ozakuzasigamula.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ithuna ngaphansi liyanyakaza","poem":1},{"text":"ukuba likuhlangabeze ekufikeni kwakho.","poem":2},{"text":"Livusa imimoya yabafayo ukuba ikubingelele,","poem":1},{"text":"bonke labo ababengababusi emhlabeni;","poem":2},{"text":"libenza basukume ezihlalweni zabo zobukhosi,","poem":1},{"text":"bonke labo ababengamakhosi ezizwe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bazaphendula bonke,","poem":1},{"text":"bazakuthi kuwe,","poem":2},{"text":"“Lawe usubuthakathaka njengathi,","poem":1},{"text":"usube njengathi.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bonke ubukhosi bakho sebehliselwe phansi ethuneni,","poem":1},{"text":"kanye lomsindo wamachacho akho.","poem":2},{"text":"Impethu zendlaliwe ngaphansi kwakho,","poem":1},{"text":"inhlavane zikwembesile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yeka ukuwa kwakho uvela ezulwini,","poem":1},{"text":"wena nkanyezi yekuseni, ndodana yokusa!","poem":2},{"text":"Uphoselwe phansi emhlabeni,","poem":1},{"text":"wena owake wehlisela izizwe phansi!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wathi enhliziyweni yakho,","poem":1},{"text":"“Ngizakwenyukela ezulwini,","poem":2},{"text":"ngizaphakamisela isihlalo sami sobukhosi","poem":1},{"text":"ngaphezu kwezinkanyezi zikaNkulunkulu;","poem":2},{"text":"ngizahlala ebukhosini phezu kwentaba yombuthano,","poem":1},{"text":"ezingqongweni zentaba engcwele.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngizakwenyukela phezu kwezindawo","poem":1},{"text":"eziphakemeyo emayezini;","poem":2},{"lineBreak":true},{"text":"ngizazenza ngibe njengoPhezukonke.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kodwa ulethwe phansi ethuneni,","poem":1},{"text":"ekuzikeni kwegodi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Labo abakubonayo bakudonsela amehlo,","poem":1},{"text":"bayacabanga ngowakudalelwayo bathi:","poem":2},{"text":"“Nguye lo na umuntu owanyikinya umhlaba","poem":1},{"text":"wenza imibuso yaqhaqhazela,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"umuntu owenza umhlaba waba lugwadule,","poem":1},{"text":"owadiliza amadolobho awo,","poem":2},{"text":"kazavumela abathunjwayo bakhe","poem":1},{"text":"ukubuyela ekhaya na?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Wonke amakhosi ezizwe alele ebukhosini,","poem":1},{"text":"enye lenye ethuneni layo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kodwa wena uphoselwe ngaphandle kwethuna","poem":1},{"text":"lakho njengogatsha olulahliweyo;","poem":2},{"text":"welekwe ngababulawayo,","poem":1},{"text":"lalabo abagwazwa ngenkemba,","poem":2},{"lineBreak":true},{"text":"labo abehlela ematsheni egodi.","poem":2},{"text":"Njengesidumbu esinyathelwe ngezinyawo,","poem":1}]},{"type":"verse","number":20,"content":[{"text":"kawuyikuhlangana labo ekungcwatshweni;","poem":2},{"text":"ngoba usulichithile ilizwe lakho","poem":1},{"text":"wabulala labantu bakini.","poem":2},{"lineBreak":true},{"lineBreak":true},{"text":"Inzalo yababi","poem":1},{"text":"kakungakhulunywa ngayo futhi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Lungisa indawo yokubulalela abantwabakhe","poem":1},{"text":"ngenxa yezono zabokhokho babo.","poem":2},{"text":"Kabamelanga bavuke ukuba bathathe ilizwe","poem":1},{"text":"bagcwalise umhlaba ngamadolobho abo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Ngizabavukela,”","poem":1},{"text":"kutsho uThixo uSomandla.","poem":2},{"text":"“Ngizakwesula iBhabhiloni labasindayo","poem":1},{"text":"abantwabakhe lezizukulwane,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“Ngizalenza libe yindawo yezikhova","poem":1},{"text":"lelizwe elilixhaphozi.","poem":2},{"text":"Ngizalithanyela ngomthanyelo wencithakalo,”","poem":1},{"text":"kutsho uThixo uSomandla.","poem":2}]},{"type":"heading","content":["Isiphrofethi Nge-Asiriya"]},{"type":"verse","number":24,"content":["UThixo uSomandla ufungile wathi,",{"text":"“Ngeqiniso, njengoba sengilungisile, kuzakuba njalo,","poem":1},{"text":"njalo njengoba ngikumisile kuzakuma kanjalo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ngizamchoboza umʼAsiriya elizweni lami;","poem":1},{"text":"ezintabeni zami ngizamnyathelela phansi.","poem":2},{"text":"Ijogwe lakhe lizasuswa ebantwini bami,","poem":1},{"text":"umthwalo wakhe ususwe emahlombe abo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Lokhu yikho okumiselwe umhlaba wonke,","poem":1},{"text":"lesi yisandla eselulelwe phezu kwezizwe zonke.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ngoba uThixo uSomandla usenze isimiso,","poem":1},{"text":"ngubani ongamvimbela na?","poem":2},{"text":"Isandla sakhe siphakanyisiwe,","poem":1},{"text":"ngubani ongasibuyisela emuva na?","poem":2}]},{"type":"heading","content":["Isiphrofethi Ngamafilistiya"]},{"type":"verse","number":28,"content":["Ilizwi leli lafika nyakana kusifa inkosi u-Ahazi:"]},{"type":"verse","number":29,"content":[{"text":"Lingathokozi, lonke lina maFilistiya,","poem":1},{"text":"lisithi intonga eyalitshayayo yephukile;","poem":2},{"text":"ngoba empandeni yenyoka leyana kuzavela inhlangwana,","poem":1},{"text":"inzalo yayo izakuba yinyoka elobuthi obutshokayo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Abangabayanga kubayanga bazathola amadlelo,","poem":1},{"text":"abaswelayo bazalala phansi bevikelekile.","poem":2},{"text":"Kodwa impande yakho ngizayitshabalalisa ngendlala;","poem":1},{"text":"izabulala abaseleyo bakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Lila wena sango! Bubula wena dolobho!","poem":1},{"text":"Chithekani lonke lina maFilistiya!","poem":2},{"text":"Iyezi lentuthu livela enyakatho;","poem":1},{"text":"njalo akulamatshida eviyweni lalo.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Yimpendulo bani ezanikwa","poem":1},{"text":"izithunywa zalesosizwe na?","poem":2},{"text":"“UThixo useyakhile iZiyoni,","poem":1},{"text":"abantu bakhe abahluphekileyo bazaphephela kuye.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/13.json","previousChapterAudioLinks":{},"numberOfVerses":32}