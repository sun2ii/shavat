oni le-Eliyale kuyakhala,","poem":1},{"text":"amazwi akho azwakala laseJahazi.","poem":2},{"text":"Ngakho-ke amabutho aseMowabi ayakhala,","poem":1},{"text":"inhliziyo zawo zidangele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Inhliziyo yami ikhalela iMowabi,","poem":1},{"text":"ababalekayo bayo babaleka baze bayefika kude eZowari;","poem":2},{"lineBreak":true},{"text":"kude njengase-Egilathi Shelishiya.","poem":2},{"text":"Bahamba ngendlela eya eLuhithi,","poem":1},{"text":"bakhala ohanjweni lwabo;","poem":2},{"text":"endleleni eya eHoronayimi","poem":1},{"text":"balilela ukubhujiswa kwabo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amanzi aseNimirimi acitshile,","poem":1},{"text":"utshani bubunile,","poem":2},{"text":"uhlaza kalusekho,","poem":1},{"text":"akukho lutho oluluhlaza oluseleyo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngakho inotho abayizuzileyo bayigcina,","poem":1},{"text":"bayithwalela ngaphetsheya kweSifula semiDubu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ukuklabalala kwabo kuzwakele emngceleni waseMowabi,","poem":1},{"text":"ukukhala kwabo kufika kude e-Egilayimi,","poem":2},{"lineBreak":true},{"text":"ukulila kwabo kufika eBheri-Elimi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Amanzi aseDimoni agcwele igazi","poem":1},{"text":"kodwa ngizajinge ngilethe okunengi phezu kweDimoni,","poem":2},{"text":"isilwane phezu kwababalekayo baseMowabi,","poem":1},{"text":"lakulabo abazasala elizweni.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}