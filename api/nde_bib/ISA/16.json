”","poem":2},{"lineBreak":true},{"text":"Umncindezeli uzakufa,","poem":1},{"text":"ukuchitheka kuzaphela,","poem":2},{"lineBreak":true},{"text":"umhlaseli uzanyamalala elizweni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngothando, kuzamiswa isihlalo sobukhosi;","poem":1},{"text":"ngokwethembeka, indoda izahlala kuso,","poem":2},{"lineBreak":true},{"text":"ivela endlini kaDavida,","poem":2},{"text":"yona ethi ekwahluleleni ifune imfanelo,","poem":1},{"text":"njalo iphangisisa indlela yokulunga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sizwile ngokuzigqaja kukaMowabi.","poem":1},{"text":"Ukuzigqaja kwakhe kokuzikhukhumeza lokuzazisa,","poem":2},{"text":"ukuzigqaja kwakhe lobuqholo bakhe,","poem":1},{"text":"kodwa ukuzikhukhumeza kwakhe kuyize.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngakho-ke abaseMowabi bayalila,","poem":1},{"text":"balilela iMowabi bonke.","poem":2},{"text":"Khalani libubulele","poem":1},{"text":"izinkwa ezilezithelo zevini eKhiri-Haresethi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Amasimu aseHeshibhoni ayabuna,","poem":1},{"text":"anjalo lamavini aseSibhima.","poem":2},{"text":"Ababusi bezizwe","poem":1},{"text":"sebewanyathelele phansi amavini amahle","poem":2},{"text":"kuqala ayefika eJazeri,","poem":1},{"text":"njalo anda kusiya ngasenkangala.","poem":2},{"text":"Amahlumela awo anaba","poem":1},{"text":"aze ayafika ngasolwandle.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngakho ngiyakhala njengalokhu iJazeri ikhala,","poem":1},{"text":"ngikhalela amavini aseSibhima.","poem":2},{"text":"Awu Heshibhoni lawe Eliyale,","poem":1},{"text":"ngilithambisa ngezinyembezi.","poem":2},{"text":"Ukuklabalalela izithelo zenu esezivuthiwe","poem":1},{"text":"ngentokozo lezivuno zenu sekuphelile.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ukuthokoza lokuthaba akusekho ezivinini;","poem":1},{"text":"kakho ohlabelayo loba amemeze ezivinini;","poem":2},{"text":"kakho onyathela iwayini ezikhamelweni","poem":1},{"text":"ngoba umsindo sengiwuqedile.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inhliziyo yami ikhalela uMowabi njengechacho,","poem":1},{"text":"ingaphakathi yami ikhalela iKhiri-Haresethi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lapho uMowabi evela endaweni yakhe ephakemeyo","poem":1},{"text":"uyazidinisa nje kuphela;","poem":2},{"text":"lalapho esiya endaweni yakhe yokukhonzela","poem":1},{"text":"ukuba akhuleke akusizi lutho.","poem":2}]},{"type":"verse","number":13,"content":["Leli yilizwi uThixo avele eselikhulumile ngoMowabi."]},{"type":"verse","number":14,"content":["Kodwa khathesi uThixo uthi: “Phakathi kweminyaka emithathu, njengesisebenzi esibotshwe yisivumelwano singayibala, udumo lukaMowabi labantu bakhe bonke abanengi kuzakweyiswa, njalo abazasinda bakhona bazakuba balutshwana kakhulu njalo bengelamandla.”"]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/15.json","previousChapterAudioLinks":{},"numberOfVerses":14}