{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":17,"content":[{"type":"heading","content":["Isiphrofethi NgeDamaseko"]},{"type":"verse","number":1,"content":["Isiqalekiso esimayelana leDamaseko:",{"text":"“Khangela iDamaseko kayisayikuba lidolobho","poem":1},{"text":"kodwa izakuba yinqumbi yamanxiwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amadolobho ase-Aroyeri azatshiywa,","poem":1},{"text":"etshiyelwa imihlambi ezalala phansi","poem":2},{"lineBreak":true},{"text":"kungekho ozayenza yesabe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Idolobho elivikelweyo lizanyamalala ko-Efrayimi","poem":1},{"text":"lamandla obukhosi eDamaseko;","poem":2},{"text":"insalela ka-Aramu izakuba","poem":1},{"text":"njengodumo lwabako-Israyeli,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo uSomandla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ngalolusuku udumo lukaJakhobe luzakwehla;","poem":1},{"text":"amafutha asemzimbeni wakhe azancipha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kuzakuba njengalapho umvuni evuna amabele amiyo","poem":1},{"text":"evuna amabele ngengalo yakhe,","poem":2},{"text":"njenganxa umuntu edobha izikhwebu zamabele","poem":1},{"text":"eSigodini saseRefayi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ikanti ezinye izikhwebu zizasala,","poem":1},{"text":"njengalapho isihlahla se-oliva sibhuliwe,","poem":2},{"text":"kusale ama-oliva amabili loba amathathu","poem":1},{"text":"ezingatsheni eziphezulu kakhulu,","poem":2},{"lineBreak":true},{"text":"amane loba amahlanu ezingabeni zezithelo,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo, uNkulunkulu ka-Israyeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ngalolosuku abantu bazathembela kuMenzi","poem":1},{"text":"wabo amehlo abo aphendukele koNgcwele ka-Israyeli.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abayikuthembela ema-alithareni,","poem":1},{"text":"umsebenzi wezandla zabo,","poem":2},{"text":"njalo kabayikuzinanza izinsika zika-Ashera","poem":1},{"text":"lama-alithare empepha enziwa yiminwe yabo.","poem":2}]},{"type":"verse","number":9,"content":["Ngalolosuku amadolobho abo aqinileyo, abawatshiyayo ngenxa yama-Israyeli azafana lezindawo ezatshiyelwa izixukwana lezihlahlanyana. Konke kuzakuba yincithakalo."]},{"type":"verse","number":10,"content":[{"text":"Selimkhohliwe uNkulunkulu uMsindisi wenu,","poem":1},{"text":"kalilikhumbulanga iDwala, inqaba yenu.","poem":2},{"text":"Ngakho lanxa ligxumeka izihlahla ezinhle,","poem":1},{"text":"lihlanyele lamavini avela ezizweni,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"lanxa lingawenza akhule ngelanga","poem":1},{"text":"elizawagxumeka ngalo,","poem":2},{"text":"loba liwenze ahlume","poem":1},{"text":"ngekuseni eliwahlanyele ngayo,","poem":2},{"text":"kodwa isivuno sizakuba yize","poem":1},{"text":"ngosuku lwesifo lobuhlungu obungelaphekiyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Maye, ukuhlokoma kwezizwe ezinengi,","poem":1},{"text":"zihlokoma njengokuhlokoma kolwandle!","poem":2},{"text":"Yeka ukuxokozela kwezizwe,","poem":1},{"text":"zihuba njengokuhuba kwamanzi amanengi!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lanxa izizwe zihuba njengokugubhuza kwamanzi,","poem":1},{"text":"nxa ezikhuza zibalekela khatshana,","poem":2},{"text":"njengamakhoba ephetshulwa ngumoya emaqaqeni,","poem":1},{"text":"lanjengothuli olubangwa yisivunguzane.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kusihlwa kuba lokuthuthumela.","poem":1},{"text":"Kungakasi, kabasekho.","poem":2},{"text":"Lesi yiso isabelo salabo abasikhuthuzayo,","poem":1},{"text":"isabelo salabo abasihlaselayo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/16.json","previousChapterAudioLinks":{},"numberOfVerses":14}