{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":18,"content":[{"type":"heading","content":["Isiphrofethi NgeKhushi"]},{"type":"verse","number":1,"content":[{"text":"Maye ngelizwe elilokuphaphazela kwempiko","poem":1},{"text":"emifuleni yaseKhushi,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"elithuma izithunywa zihamba olwandle","poem":1},{"text":"ngezikepe zemihlanga phezu kwamanzi.","poem":2},{"lineBreak":true},{"text":"Hambani, zithunywa ezilejubane,","poem":1},{"lineBreak":true},{"text":"liye ebantwini abade abalejwabu elibutshelezi,","poem":1},{"text":"ebantwini abesatshwayo ezindaweni zonke,","poem":2},{"text":"isizwe esilolaka, esilolimi olungaziwayo,","poem":1},{"text":"esilizwe laso lehlukaniswe yimifula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Lonke lina bantu bomhlaba,","poem":1},{"text":"lina elihlala emhlabeni,","poem":2},{"text":"lapho uphawu luphakanyiswa phezu kwezintaba","poem":1},{"text":"lizalubona,","poem":2},{"text":"lalapho uphondo lukhala","poem":1},{"text":"lizaluzwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lokhu yikho uThixo akutshoyo kimi:","poem":1},{"text":"“Ngizakwala ngithule,","poem":2},{"lineBreak":true},{"text":"ngikhangele ngisendaweni yami yokuhlala,","poem":2},{"text":"njengokucwebezela kokutshisa ekukhanyeni kwelanga,","poem":1},{"text":"lanjengenkungu yamazolo ngesikhathi sokuvuna.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngoba kungakavunwa, lapho ukukhahlela sekudlule,","poem":1},{"text":"amaluba esesiba livini elivuthiweyo,","poem":2},{"text":"uzaquma amahlumela ngamahloka okuthena,","poem":1},{"text":"aqume lengatsha ezinabayo, azisuse.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zonke zizatshiyelwa izinyoni zasezintabeni ezidla inyama,","poem":1},{"text":"lezinyamazana zeganga;","poem":2},{"text":"izinyoni zizakudla ihlobo lonke,","poem":1},{"text":"izinyamazana zeganga ubusika bonke.","poem":2}]},{"type":"verse","number":7,"content":["Ngalesosikhathi izipho zizalethwa kuThixo uSomandla",{"text":"zivela ebantwini abade abalamajwabu abutshelezi,","poem":1},{"text":"zivela ebantwini abesatshwayo ezindaweni zonke.","poem":2},{"text":"Isizwe esilolaka, esilolimi olungaziwayo,","poem":1},{"text":"esilizwe laso lehlukaniswe yimifula,","poem":2},"izipho zizalethwa entabeni iZiyoni, endaweni yeBizo likaThixo uSomandla."]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/17.json","previousChapterAudioLinks":{},"numberOfVerses":7}