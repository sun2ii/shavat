{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":19,"content":[{"type":"heading","content":["Isiphrofethi NgeGibhithe"]},{"type":"verse","number":1,"content":["Isiphrofethi esimayelana leGibhithe sithi:",{"text":"Khangela uThixo ukhwele phezu kweyezi elilesiqubu","poem":1},{"text":"esiza eGibhithe.","poem":2},{"text":"Izithombe zaseGibhithe ziyathuthumela phambi kwakhe,","poem":1},{"text":"njalo inhliziyo zamaGibhithe ziba buthakathaka ngaphakathi kwawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Ngizadunga umGibhithe alwe lomGibhithe,","poem":1},{"text":"umuntu uzakulwa lomfowabo,","poem":2},{"lineBreak":true},{"text":"umakhelwane alwe lomakhelwane,","poem":2},{"lineBreak":true},{"text":"idolobho lilwe ledolobho,","poem":2},{"lineBreak":true},{"text":"umbuso ulwe lombuso.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"AbaseGibhithe bazaphelelwa lithemba,","poem":1},{"text":"njalo ngizakwenza amacebo abo abe yize;","poem":2},{"text":"bazabuza izithombe lemimoya yabafayo,","poem":1},{"text":"amadlozi lezanuse.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"AbaseGibhithe ngizabanikela","poem":1},{"text":"enkosini elesihluku,","poem":2},{"text":"inkosi eyesabekayo izababusa,”","poem":1},{"text":"kutsho iNkosi, uThixo uSomandla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Amanzi omfula azakutsha,","poem":1},{"text":"umfula uzacitsha, wome.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Imigelo izanuka,","poem":1},{"text":"izifula zaseGibhithe zizakwentsha zitshe.","poem":2},{"text":"Imihlanga lebhuma kuzabuna,","poem":1}]},{"type":"verse","number":7,"content":[{"text":"kanjalo lezihlahlanyana emakhunjini kaNayili","poem":2},{"lineBreak":true},{"text":"lapho umfula othela khona.","poem":2},{"text":"Konke okuhlanyelwe eduzane loNayili","poem":1},{"text":"Kuzakoma, kuphephukele khatshana Kungabikhona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abagoli benhlanzi bazabubula balile,","poem":1},{"text":"bonke abaphosa amawuka kuNayili,","poem":2},{"text":"loba abajika amambule emanzini","poem":1},{"text":"bazaphela amandla.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Labo abasebenzisa isikusha bazadangala,","poem":1},{"text":"abeluka ilineni elihle bazaphelelwa lithemba.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Izisebenzi zasemalenjini zizadana,","poem":1},{"text":"njalo bonke abahola imiholo bazakuba lusizi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Izikhulu zaseZowani azisilutho kodwa izithutha nje;","poem":1},{"text":"abaluleki bakaFaro abahlakaniphileyo banika izeluleko zobuwula.","poem":2},{"text":"Ungatsho kanjani kuFaro uthi,","poem":1},{"text":"“Mina ngingomunye wamadoda ahlakaniphileyo,","poem":2},{"lineBreak":true},{"text":"umfundi wamakhosi endulo?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Khathesi bangaphi abantu bakini abahlakaniphileyo?","poem":1},{"text":"Kabalitshengise balazise","poem":2},{"text":"ngalokhu uThixo uSomandla","poem":1},{"text":"asecebe ukukwenza emelana leGibhithe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Izikhulu zaseZowani sezibe yizithutha,","poem":1},{"text":"abakhokheli baseMemfisi bakhohlisiwe,","poem":2},{"text":"abazinsika zabantu bakhona","poem":1},{"text":"sebedukise iGibhithe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"UThixo usethele umoya wesiyezi phakathi kwabo;","poem":1},{"lineBreak":true},{"text":"benza iGibhithe ibhadazele kukho konke ekwenzayo,","poem":1},{"text":"njengesidakwa sidiyazela emahlanzweni aso.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Akulalutho iGibhithe engalwenza,","poem":1},{"text":"ikhanda loba umsila, ugatsha lwelala loba umhlanga.","poem":2}]},{"type":"verse","number":16,"content":["Ngalolosuku abaseGibhithe bazafana labesifazane. Bazathuthumela ngokwesaba isandla esiphakanyisiweyo uThixo uSomandla abaphakamisele sona."]},{"type":"verse","number":17,"content":["Lelizwe lakoJuda lizaletha ukwesaba kwabaseGibhithe. Bonke okuzakhulunywa kubo ngoJuda bazathuthumela, ngenxa yalokho uThixo uSomandla aceba ukukwenza kubo."]},{"type":"verse","number":18,"content":["Ngalolosuku amadolobho amahlanu aseGibhithe azakhuluma ulimi lwaseKhenani, afungele ukwethembeka kuThixo uSomandla. Elinye lawo lizathiwa liDolobho leNcithakalo."]},{"type":"verse","number":19,"content":["Ngalolosuku kuzakuba le-alithari likaThixo phakathi kwelizwe laseGibhithe, lelitshe lesikhumbuzo sikaThixo emngceleni walo."]},{"type":"verse","number":20,"content":["Lizakuba yisibonakaliso lobufakazi kuThixo uSomandla elizweni laseGibhithe. Lapho bekhalaza kuThixo ngenxa yabancindezeli babo, uzabathumela umsindisi lomvikeli, abahlenge."]},{"type":"verse","number":21,"content":["Kanjalo uThixo uzakwenza ukuba azakale kwabaseGibhithe, njalo ngalolosuku bazamvuma uThixo. Bazakhonza ngemihlatshelo langeminikelo yamabele; bazakwenza izifungo kuThixo, bazigcine."]},{"type":"verse","number":22,"content":["UThixo uzatshaya iGibhithe ngesifo; uzabatshaya aphinde abasilise. Bazaphendukela kuThixo, njalo uzakuzwa imikhuleko yabo abasilise."]},{"type":"verse","number":23,"content":["Ngalolosuku bazakuba lomgwaqo osuka eGibhithe usiya e-Asiriya. Abase-Asiriya bazakuya eGibhithe, abeGibhithe labo baye e-Asiriya. AbaseGibhithe labase-Asiriya bazakhonza ndawonye."]},{"type":"verse","number":24,"content":["Ngalolosuku i-Israyeli izakuba ngeyesithathu kanye leGibhithe le-Asiriya kube yisibusiso emhlabeni."]},{"type":"verse","number":25,"content":["UThixo uSomandla uzababusisa esithi, “Kayibusiswe iGibhithe abantu bami, i-Asiriya umsebenzi wezandla zami le-Israyeli ilifa lami.”"]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/18.json","previousChapterAudioLinks":{},"numberOfVerses":25}