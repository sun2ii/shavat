{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":2,"content":[{"type":"heading","content":["Intaba KaThixo"]},{"type":"verse","number":1,"content":["Lokhu yikho okwabonwa ngu-Isaya indodana ka-Amozi mayelana loJuda leJerusalema:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["Ngezinsuku zokucina",{"text":"intaba yethempeli likaThixo izamiswa","poem":1},{"text":"njengenhloko phakathi kwezintaba;","poem":2},{"text":"izaphakanyiselwa phezu kwezintaba","poem":1},{"text":"njalo izizwe zonke zizabekelela zisiya kuyo.","poem":2}]},{"type":"verse","number":3,"content":["Abantu abanengi bazakuza bathi,",{"text":"“Wozani siye phezu kwentaba kaThixo,","poem":1},{"text":"siye ethempelini likaNkulunkulu kaJakhobe.","poem":2},{"text":"Uzasifundisa izindlela zakhe,","poem":1},{"text":"ukuze sihambe emikhondweni yakhe.”","poem":2},{"text":"Umthetho uzavela eZiyoni,","poem":1},{"text":"ilizwi likaThixo livele eJerusalema.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Uzakwahlulela phakathi kwezizwe,","poem":1},{"text":"alamule ingxabano zabantu abanengi.","poem":2},{"text":"Bazakhanda izinkemba zabo zibe yimihlathi yamakhuba,","poem":1},{"text":"lemikhonto yabo ibe ngamahloka okuthena izihlahla.","poem":2},{"text":"Isizwe asiyikuhlomela isizwe ngenkemba","poem":1},{"text":"loba sifundele ukulwa impi futhi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Woza, ndlu kaJakhobe,","poem":1},{"text":"kasihambe ekukhanyeni kukaThixo.","poem":2}]},{"type":"heading","content":["Usuku LukaThixo"]},{"type":"verse","number":6,"content":[{"text":"Wena, Thixo, usubalahlile abantu bakho,","poem":1},{"text":"isizukulwane sikaJakhobe.","poem":2},{"text":"Bagcwele ukholo oluyize lwaseMpumalanga","poem":1},{"text":"benza lemisebenzi yobungoma njengamaFilisti,","poem":2},{"lineBreak":true},{"text":"njalo babambana izandla labangakholwayo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ilizwe labo ligcwele isiliva legolide;","poem":1},{"text":"inotho yabo ayilakuphela.","poem":2},{"text":"Ilizwe labo ligcwele amabhiza;","poem":1},{"text":"izinqola zabo zempi kazipheli.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ilizwe labo ligcwele izithombe;","poem":1},{"text":"bakhothamela umsebenzi wezandla zabo,","poem":2},{"lineBreak":true},{"text":"lakulokho okwenziwa yiminwe yabo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngakho abantu bazakwehliselwa phansi","poem":1},{"text":"bonke bazehliswa","poem":2},{"lineBreak":true},{"text":"ungabathetheleli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ngenani ezimbalwini zamatshe lasemhlabathini,","poem":1},{"text":"licatshele ukwesabeka kukaThixo","poem":2},{"lineBreak":true},{"text":"lenkazimulo yobukhosi bakhe!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amehlo omuntu oziphakamisayo azathotshiswa,","poem":1},{"text":"lokuziphakamisa kwabantu kwehliselwe phansi;","poem":2},{"text":"uThixo kuphela nguye ozaphakanyiswa ngalolosuku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"UThixo uSomandla ulosuku alubekele","poem":1},{"text":"bonke abazazigqajayo labazikhukhumezayo;","poem":2},{"text":"lakho konke okuphakemeyo","poem":1},{"text":"(kuzathotshiswa),","poem":2}]},{"type":"verse","number":13,"content":[{"text":"olwazo zonke izihlahla zemisedari zaseLebhanoni ezinde leziphakemeyo,","poem":1},{"text":"lazozonke izihlahla zomʼOkhi zaseBhashani,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"olwazo zonke izintaba ezindekazi","poem":1},{"text":"lamaqaqa wonke aphakemeyo,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"olwayo yonke imiphotshongo ephakemeyo","poem":1},{"text":"layo yonke imiduli eyinqaba,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"olwemikhumbi yonke yaseThashishi","poem":1},{"text":"layo yonke imikolo emihle.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ukuziphakamisa kwabantu kuzakwehliselwa phansi,","poem":1},{"text":"ukuzazisa kwabantu kuthobekiswe;","poem":2},{"text":"uThixo kuphela nguye ozadunyiswa ngalolosuku,","poem":1}]},{"type":"verse","number":18,"content":[{"text":"izithombe zizanyamalala zithi nya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Abantu bazabalekela ezimbalwini zamatshe","poem":1},{"text":"lasemilindini emhlabathini","poem":2},{"text":"bebalekela ukwesabeka kukaThixo","poem":1},{"text":"lenkazimulo yobukhosi bakhe","poem":2},{"lineBreak":true},{"text":"lapho ephakama ukuba anyikinye umhlaba.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ngalolosuku abantu bazazilahlela","poem":1},{"text":"emvukuzaneni lakubomalulwane","poem":2},{"text":"izithombe zabo zesiliva lezegolide","poem":1},{"text":"abazenzela ukuba bazikhonze.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bazabalekela ezimbalwini zamatshe","poem":1},{"text":"lasezingoxweni zamawa","poem":2},{"text":"bebalekela ukwesabeka kukaThixo","poem":1},{"text":"lenkazimulo yobukhosi bakhe,","poem":2},{"lineBreak":true},{"text":"lapho ephakama ukuba anyikinye umhlaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Yekelani ukwethemba umuntu","poem":1},{"text":"olomphefumulo nje kuphela emakhaleni akhe.","poem":2},{"lineBreak":true},{"text":"Ngoba uyini yena na?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}