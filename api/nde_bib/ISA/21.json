{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":21,"content":[{"type":"heading","content":["Isiphrofethi NgeBhabhiloni"]},{"type":"verse","number":1,"content":["Isiphrofethi mayelana leNkangala engasoLwandle:",{"text":"Njengesivunguzane sidlula eNegebi,","poem":1},{"text":"umhlaseli uvela enkangala evelela","poem":2},{"lineBreak":true},{"text":"elizweni elesabekayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ngitshengiswe umbono owesabekayo.","poem":1},{"text":"Umthengisi uyathengisa, umkhuthuzi uthatha impahla.","poem":2},{"text":"Elamu, hlasela! Mediya, vimbezela!","poem":1},{"text":"Mina ngizakuqeda konke ukububula akudalileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngalokhu umzimba wami uyafuthelwa,","poem":1},{"text":"ngiphethwe yibuhlungu obufana lobowesifazane ehelelwa.","poem":2},{"text":"Ngithithibaliswa yilokhu engikuzwayo,","poem":1},{"text":"ngidideka ngalokhu engikubonayo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inhliziyo yami iphela amandla,","poem":1},{"text":"ukwesaba kungenza ngiqhaqhazele;","poem":2},{"text":"ukuhlwa engibe ngikufisa,","poem":1},{"text":"sekusesabeka kimi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Itafula bayilungisile,","poem":1},{"text":"bendlala amalembu","poem":2},{"lineBreak":true},{"text":"bayadla, bayanatha.","poem":2},{"text":"Sukumani lina zikhulu,","poem":1},{"text":"ligcobe amahawu!","poem":2}]},{"type":"verse","number":6,"content":["Lokhu yikho uThixo akutshoyo kimi:",{"text":"“Hamba uyefaka umlindi","poem":1},{"text":"ukuze abike akubonayo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Angabona izinqola zempi,","poem":1},{"text":"kulemihlambi yamabhiza,","poem":2},{"text":"abagadi phezu kwabobabhemi","poem":1},{"text":"loba abagadi phezu kwamakamela,","poem":2},{"text":"kaqaphele;","poem":1},{"text":"aqaphelisise sibili.”","poem":2}]},{"type":"verse","number":8,"content":["Umlindi wasememeza esithi,",{"text":"“Nkosi yami, usuku ngosuku ngiyema phezu komphotshongo wokulinda;","poem":1},{"text":"ubusuku ngabunye ngihlala ensikeni yami.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Khangela, nangu umuntu esiza esenqoleni yempi","poem":1},{"text":"lomhlambi wamabhiza.","poem":2},{"text":"Uphendula esithi,","poem":1},{"text":"‘IBhabhiloni isidilikile, isidilikile!","poem":2},{"text":"Zonke izifanekiso zezithombe zayo","poem":1},{"text":"zihlakazekele phansi!’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Awu bantu bami elibhulelwe esizeni,","poem":1},{"text":"ngilitshela engikuzwileyo","poem":2},{"text":"kuvela Thixo uSomandla,","poem":1},{"text":"uNkulunkulu ka-Israyeli.","poem":2}]},{"type":"heading","content":["Isiphrofethi Nge-Edomi"]},{"type":"verse","number":11,"content":["Isiphrofethi esimayelana leDuma:",{"text":"Umuntu othile uyangimemeza eseSeyiri, esithi,","poem":1},{"text":"“Mlindi, kuyini okwebusuku okusaseleyo?","poem":2},{"lineBreak":true},{"text":"Mlindi, kuyini okwebusuku okusaseleyo?”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Umlindi uphendula esithi,","poem":1},{"text":"“Ukusa kuyeza, kodwa lobusuku buyeza.","poem":2},{"text":"Nxa ufuna ukubuza, buza;","poem":1},{"text":"uphinde ubuye futhi.”","poem":2}]},{"type":"heading","content":["Isiphrofethi Nge-Arabhiya"]},{"type":"verse","number":13,"content":["Isiphrofethi esimayelana le-Arabhiya:",{"text":"Lina zindwendwe zabakoDedani","poem":1},{"text":"ezimise emahlabathini ase-Arabhiya,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"lethelani abomileyo amanzi;","poem":2},{"text":"lina elihlala eThema,","poem":1},{"text":"lethelani ababalekayo ukudla.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Babalekela inkemba,","poem":1},{"text":"inkemba eqhatshisiweyo,","poem":2},{"text":"babalekela idandili eligotshiweyo,","poem":1},{"text":"lokutshisa kwempi.","poem":2}]},{"type":"verse","number":16,"content":["Lokhu yikho uThixo akutshoyo kimi ukuthi: “Phakathi komnyaka owodwa nje, njengendlela isisebenzi esiqhatshiweyo esingawubala ngayo, lonke udumo lweKhedari luzaphela."]},{"type":"verse","number":17,"content":["Abasindayo kwabemitshoko, amabutho aseKhedari, bazakuba balutshwana.” UThixo, uNkulunkulu ka-Israyeli, usekhulumile."]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}