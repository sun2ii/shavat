{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":22,"content":[{"type":"heading","content":["Isiphrofethi NgeJerusalema"]},{"type":"verse","number":1,"content":["Isiphrofethi ngesiGodi soMbono:",{"text":"Kuyini okukukhathazayo khathesi,","poem":1},{"text":"wena sewakhwela phezu kwezimpahla zezindlu,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"wena dolobho eligcwele iziphithiphithi,","poem":1},{"text":"wena dolobho lokuxokozela lokuthokoza?","poem":2},{"text":"Abafayo bakho ababulawanga ngenkemba,","poem":1},{"text":"njalo kabafelanga empini.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bonke abakhokheli bakho babaleke bebonke,","poem":1},{"text":"bathunjiwe bengazange basebenzise mtshoko.","poem":2},{"text":"Lonke lina elabanjwayo lathathwa ukuba libe yizibotshwa ndawonye,","poem":1},{"text":"libalekile isitha sisesekhatshana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngakho ngathi, “Sukani kimi;","poem":1},{"text":"lingiyekele ngikhale kabuhlungu.","poem":2},{"text":"Lingazami ukungiduduza","poem":1},{"text":"ngenxa yokuchithwa kwabantu bakithi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"INkosi, uThixo uSomandla, ulosuku","poem":1},{"text":"lokuxokozela lokugxoba lokwesaba","poem":2},{"lineBreak":true},{"text":"eSigodini soMbono, usuku","poem":2},{"text":"lokudiliza imiduli","poem":1},{"text":"lokumemezela ezintabeni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I-Elamu ithatha isikhwama semitshoko,","poem":1},{"text":"labatshayeli balo bezinqola zempi, lamabhiza;","poem":2},{"lineBreak":true},{"text":"iKhiri lambula ihawu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Izigodi zakho ezinhle kakhulu zigcwele izinqola zempi,","poem":1},{"text":"abagadi bamabhiza bamiswe emasangweni edolobho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ukuvikeleka kukaJuda kususiwe,","poem":1},{"text":"Ngalolosuku wathemba","poem":2},{"lineBreak":true},{"text":"izikhali eziseSigodlweni seHlathi,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"wabona ukuthi iDolobho likaDavida","poem":1},{"text":"lalilezikhala ezinengi ezivikelweni zalo;","poem":2},{"lineBreak":true},{"text":"wagcina amanzi eSizibeni esingaPhansi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wabala izindlu zaseJerusalema,","poem":1},{"text":"wazidiliza ukuze kuqiniswe umduli.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Phakathi kwemiduli yomibili wakha indawo yokugcinela","poem":1},{"text":"amanzi eSiziba esiDala.","poem":2},{"text":"Kodwa kawukhangelanga kuLowo owasenzayo,","poem":1},{"text":"kumbe umnake Lowo owaceba ukusenza kudala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ngalolosuku iNkosi, uThixo uSomandla,","poem":1},{"text":"wakubiza ukuba","poem":2},{"text":"ukhale ulile,","poem":1},{"text":"usiphune inwele zakho, ugqoke isaka.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kodwa khangela, kulokuthaba lokuthokoza,","poem":1},{"text":"ukuhlatshwa kwezinkomo lokubalwa kwezimvu,","poem":2},{"lineBreak":true},{"text":"ukudliwa kwenyama lokunathwa kwewayini! Lithi,","poem":2},{"text":"“Kasidleni sinathe,","poem":1},{"text":"ngoba kusasa sizakufa!”","poem":2}]},{"type":"verse","number":14,"content":["UThixo uSomandla usekuvezile lokhu ngisizwa: “Lesisono kasiyikuthethelelwa kuze kube lusuku lwakho lokufa,” kutsho iNkosi, uThixo uSomandla."]},{"type":"verse","number":15,"content":["Lokhu yikho okutshiwo yiNkosi, uThixo uSomandla, uthi:",{"text":"“Hamba, uthi encekwini le,","poem":1},{"text":"kuShebhina ongumphathi wesigodlo:","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wenzani lapha, njalo ngubani okuphe imvumo ukuba","poem":1},{"text":"uzimbele ingcwaba lapha,","poem":2},{"text":"ugubha ingcwaba lakho endaweni ephezulu,","poem":1},{"text":"ugubha indawo yakho yokuphumula edwaleni?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Qaphela, sekuseduze ukuthi uThixo akubambe aqinise,","poem":1},{"text":"akuphosele khatshana, wena ndoda elamandla.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Uzakugoqa ngokuqinisa akubumbe njengebhola","poem":1},{"text":"akuphosele elizweni elikhulu.","poem":2},{"text":"Uzafela khonapho.","poem":1},{"text":"Lezigqoko zakho zempi ezinhle zizasala khonapho,","poem":2},{"lineBreak":true},{"text":"wenza ihlazo endlini yenkosi yakho!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ngizakususa esikhundleni sakho,","poem":1},{"text":"njalo uzaxotshwa emsebenzini wakho.","poem":2}]},{"type":"verse","number":20,"content":["Ngalolosuku ngizabiza inceku yami, u-Eliyakhimu indodana kaHilikhiya."]},{"type":"verse","number":21,"content":["Ngizamgqokisa izembatho zakho, ngimbophe ngebhanti lakho, ngimnike amandla akho. Uzakuba nguyise walabo abahlala eJerusalema lakwabendlu kaJuda."]},{"type":"verse","number":22,"content":["Ngizabeka phezu kwamahlombe akhe isivulo sendlu kaDavida; akuvulayo kakho ongakuvala."]},{"type":"verse","number":23,"content":["Ngizambethela njengesikhonkwane endaweni eqinileyo; uzakuba yisihlalo sobukhosi sasendlini kayise."]},{"type":"verse","number":24,"content":["Lonke udumo lwakwabo luzakuba kuye, inzalo yakhona lezizukulwane zonke, izitsha zakhona ezincinyane, kusukela emiganwini kusiya enkonxeni zonke."]},{"type":"verse","number":25,"content":["“Ngalolosuku,” kutsho uThixo uSomandla, “isikhonkwane esabethelwa endaweni eqinileyo sizakhumuka; sizaqunywa siwe, umthwalo ophezu kwaso uzawela phansi.” UThixo usekhulumile."]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/21.json","previousChapterAudioLinks":{},"numberOfVerses":25}