{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":23,"content":[{"type":"heading","content":["Isiphrofethi NgeThire"]},{"type":"verse","number":1,"content":["Isiqalekiso esimayelana leThire:",{"text":"Khalani lina mikhumbi yaseThashishi!","poem":1},{"text":"Ngoba iThire selichithiwe","poem":2},{"lineBreak":true},{"text":"lasala lingaselandlu","poem":2},{"text":"kumbe indawo yokungenisa imikhumbi.","poem":1},{"text":"Ilizwi selifikile kibo","poem":2},{"lineBreak":true},{"text":"livela elizweni laseKhithimi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Thulani lina bantu basesihlengeni","poem":1},{"text":"lani bathengi baseSidoni,","poem":2},{"lineBreak":true},{"text":"asebanothiswa ngabahambi bolwandle.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Amabele aseShihori","poem":1},{"text":"eza ephezu kwamanzi,","poem":2},{"text":"isivuno saseNayili sasiyinzuzo yeThire,","poem":1},{"text":"njalo yaba yindawo yezizwe yokuthengiselana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Woba lenhloni wena Sidoni, lawe wena nqaba yasolwandle","poem":1},{"text":"ngoba ulwandle selukhulumile lwathi:","poem":2},{"text":"kangizange ngihelelwe kumbe ngizale;","poem":1},{"text":"“Kangizange ngondle amadodana kumbe ngikhulise amadodakazi.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lapho ilizwi lifika eGibhithe","poem":1},{"text":"bazakuba lusizi ngombiko ovela eThire.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Khuphukelani ngaseThashishi;","poem":1},{"text":"khalani lina bantu basesihlengeni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Leli yilo na idolobho lenu lentokozo,","poem":1},{"text":"idolobho elidaladala,","poem":2},{"text":"elinyawo zalo zalithatha","poem":1},{"text":"ukuyalihlalisa emazweni akude?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngubani ocebe lokhu ngeThire,","poem":1},{"text":"umethesi wemiqhele,","poem":2},{"text":"abathengisi bayo bangamakhosana,","poem":1},{"text":"abathengisi bayo badumile emhlabeni?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"UThixo uSomandla wakuceba lokhu,","poem":1},{"text":"ukwehlisa ukuzigqaja kwenkazimulo yonke","poem":2},{"lineBreak":true},{"text":"lokuthobisa bonke abalodumo emhlabeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Lima insimu yakho malungana leNayili","poem":1},{"text":"wena Ndodakazi yaseThashishi","poem":2},{"lineBreak":true},{"text":"ngoba kawuselayo indawo yokungenisa imikhumbi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"UThixo useselulele isandla sakhe phezu kolwandle","poem":1},{"text":"wenza imibuso yalo yanyikinyeka.","poem":2},{"text":"Usekhuphe umlayo ngeKhenani","poem":1},{"text":"ukuba izinqaba zayo zidilizwe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wathi, “Akusekho ukuthokoza kwakho","poem":1},{"text":"wena Ndodakazi Egcweleyo yaseSidoni esichoboziwe!","poem":2},{"lineBreak":true},{"text":"Vuka ukhuphukele ngaseKhithimi;","poem":1},{"text":"lakhona awuyikuthola ukuphumula.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Khangela elizweni lamaKhaladiya,","poem":1},{"text":"abantu laba khathesi abangaselutho!","poem":2},{"text":"Abase-Asiriya sebelenze","poem":1},{"text":"laba yindawo yezidalwa zeganga;","poem":2},{"text":"bakhe imiphotshongo yabo yokuzivikela,","poem":1},{"text":"bazibhidlizile izinqaba zalo","poem":2},{"lineBreak":true},{"text":"balenza laba lunxiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Khalani lina mikhumbi yaseThashishi,","poem":1},{"text":"inqaba yenu idiliziwe!","poem":2}]},{"type":"verse","number":15,"content":["Ngalesosikhathi iThire izakhohlakala okweminyaka engamatshumi ayisikhombisa, ibanga lokuphila kwenkosi. Kodwa ekupheleni kwaleyominyaka engamatshumi ayisikhombisa, eThire kuzakwenzakala okunjengokutshiwo yingoma yewule ukuthi:"]},{"type":"verse","number":16,"content":[{"text":"“Thatha ichacho, uhambahambe phakathi kwedolobho","poem":1},{"text":"wena wule elikhohlakeleyo.","poem":2},{"text":"Litshaye kuhle ichacho, uhlabele izingoma ezinengi,","poem":1},{"text":"ukuze ukhunjulwe.”","poem":2}]},{"type":"verse","number":17,"content":["Ekupheleni kweminyaka engamatshumi ayisikhombisa uThixo uzakhumbula iThire. IThire lizabuyela ekuthengiseni kwalo njengesifebe, njalo lizabuyela emsebenzini walo wokuthengiselana lemibuso yonke esemhlabeni."]},{"type":"verse","number":18,"content":["Inzuzo lemiholo yalo kuzakwahlukaniselwa uThixo; kakuyikulondolozwa loba kubuthelelwe. Inzuzo yalo izakuya kulabo abahlala loThixo ukuba babe lokudla okunengi lezigqoko ezinhle."]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}