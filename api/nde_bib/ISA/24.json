{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":24,"content":[{"type":"heading","content":["Ukuchithwa Komhlaba NguThixo"]},{"type":"verse","number":1,"content":[{"text":"Khangela, uThixo","poem":1},{"text":"uzabhidliza umhlaba utshabalale;","poem":2},{"lineBreak":true},{"text":"uzawuchitha, ahlakaze abahlala kuwo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kuzafanana","poem":1},{"text":"okuzenziwa kumphristi kuzenziwa lasebantwini,","poem":2},{"lineBreak":true},{"text":"okuzenziwa enkosini kuzenziwa lasencekwini,","poem":2},{"lineBreak":true},{"text":"okuzenziwa enkosikazini kuzenziwa lasencekukazini,","poem":2},{"lineBreak":true},{"text":"okuzenziwa kumthengisi kuzenziwa lakumthengi,","poem":2},{"lineBreak":true},{"text":"okuzenziwa kowebolekayo kuzenziwa lakumebolekisi,","poem":2},{"lineBreak":true},{"text":"okuzenziwa kokweledayo kuzenziwa lakokweledisayo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Umhlaba uzatshabalaliswa nya","poem":1},{"text":"uphangwe uqedwe du.","poem":2},{"text":"UThixo uselikhulumile ilizwi leli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Umhlaba uyoma ubune,","poem":1},{"text":"umhlaba uyahodoza ubune,","poem":2},{"lineBreak":true},{"text":"abaphakemeyo bomhlaba bayahodoza!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Umhlaba ungcoliswa ngabantu bawo.","poem":1},{"text":"Kabayilalelanga imithetho,","poem":2},{"text":"beqe imilayo","poem":1},{"text":"bephula isivumelwano esingapheliyo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngakho-ke umhlaba uchithwa yisiqalekiso;","poem":1},{"text":"abantu bawo kumele bahlupheke ngenxa yokona kwabo.","poem":2},{"text":"Ngakho abantu abahlala emhlabeni bayatshiswa,","poem":1},{"text":"njalo balutshwana kakhulu abaseleyo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iwayini elitsha liyaphela, amavini ayabuna;","poem":1},{"text":"bonke abenza umsindo bejabula bayabubula.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ukukhala kwamagedla kuthulisiwe,","poem":1},{"text":"umsindo wabajabulayo usuphelile,","poem":2},{"lineBreak":true},{"text":"ichacho lentokozo selithule.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kabasanathi iwayini behlabela,","poem":1},{"text":"utshwala buyababa kubanathi babo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Idolobho elidilikileyo litshabalele;","poem":1},{"text":"iminyango yezindlu zonke ivalekile.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Emigwaqweni bakhalela iwayini,","poem":1},{"text":"yonke intokozo iba yikudana,","poem":2},{"lineBreak":true},{"text":"ukujabula konke kuphelile emhlabeni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Idolobho lisele selingamanxiwa,","poem":1},{"text":"isango lalo libhidlizwe laba yizicucu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kuzakuba njalo emhlabeni","poem":1},{"text":"laphakathi kwezizwe,","poem":2},{"text":"njengalapho isihlahla somʼoliva sinyikinywa,","poem":1},{"text":"loba njengezithelo ezitholwa emva kokuvunwa kwamavini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Baphakamisa amazwi abo, bahlabele ngentokozo;","poem":1},{"text":"bememezela ubukhosi bukaThixo bengasentshonalanga.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngakho-ke dumisani uThixo empumalanga;","poem":1},{"text":"phakamisani uThixo, uNkulunkulu ka-Israyeli,","poem":2},{"lineBreak":true},{"text":"ezihlengeni zolwandle.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Sizwa ukuhlabelela okuvela emikhawulweni yomhlaba:","poem":1},{"text":"“Udumo kalube koLungileyo.”","poem":2},{"lineBreak":true},{"text":"Kodwa mina ngathi, “Ngiyacikizeka, ngiyacikizeka!","poem":1},{"text":"Maye mina!","poem":2},{"text":"Abakhohlisi bayaceba!","poem":1},{"text":"Ngenkohliso abakhohlisi bayaceba!”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ukwesaba, igodi lomjibila kulilindele,","poem":1},{"text":"lina bantu basemhlabeni.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Loba ngubani obalekela umsindo wokwesaba","poem":1},{"text":"uzawela egodini;","poem":2},{"text":"loba ngubani ophumayo egodini","poem":1},{"text":"uzabanjwa ngumjibila.","poem":2},{"lineBreak":true},{"text":"Amasango asezulwini avuliwe,","poem":1},{"text":"izisekelo zomhlaba ziyanyikinyeka.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Umhlaba usubhidlikile,","poem":1},{"text":"umhlaba usudabuke phakathi,","poem":2},{"lineBreak":true},{"text":"umhlaba usunyikinywe impela.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Umhlaba udiyazela njengesidakwa,","poem":1},{"text":"uzunguzeka njengendlu kulesiphepho;","poem":2},{"text":"siwusinda kangaka isono sokuhlamuka kwawo","poem":1},{"text":"uze uwe, awuyikuvuka futhi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ngalolosuku uThixo uzajezisa","poem":1},{"text":"amabutho asemazulwini phezulu","poem":2},{"lineBreak":true},{"text":"lamakhosi emhlabeni ngaphansi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bazabuthelwa ndawonye","poem":1},{"text":"njengezibotshwa zibotshiwe emgodini oyintolongo.","poem":2},{"text":"Bazavalelwa entolongweni","poem":1},{"text":"bajeziswe emva kwensuku ezinengi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Inyanga izayangeka,","poem":1},{"text":"ilanga libelenhloni;","poem":2},{"text":"ngoba uThixo uSomandla uzabusa ngenkazimulo phezu","poem":1},{"text":"kweNtaba iZiyoni laphakathi kweJerusalema,","poem":2},{"lineBreak":true},{"text":"laphambi kwabadala bakhona.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}