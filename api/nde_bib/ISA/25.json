{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":25,"content":[{"type":"heading","content":["Dumisani UThixo"]},{"type":"verse","number":1,"content":[{"text":"Oh Thixo, wena unguNkulunkulu wami;","poem":1},{"text":"ngizakudumisa ngibabaza ibizo lakho","poem":2},{"text":"ngoba ngokuthembeka okupheleleyo,","poem":1},{"text":"wenze izinto ezimangalisayo,","poem":2},{"lineBreak":true},{"text":"izinto ezamiswa endulo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wenze idolobho laba yinqwaba yemfucuza;","poem":1},{"text":"idolobho elivikelweyo laba lunxiwa,","poem":2},{"text":"inqaba yabezizweni kayiseyilo dolobho;","poem":1},{"text":"kayiyikwakhiwa futhi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngakho-ke abantu abalamandla bazakudumisa,","poem":1},{"text":"amadolobho ezizwe ezilolunya azakwesaba.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ubuyisiphephelo sabayanga,","poem":1},{"text":"isiphephelo soswelayo osizini lwakhe,","poem":2},{"text":"isivikelo phakathi kwesiphepho","poem":1},{"text":"lomthunzi ekutshiseni kwelanga.","poem":2},{"text":"Ngoba umoya wabalesihluku","poem":1},{"text":"unjengesiphepho sitshayeka emdulini,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"lanjengokutshisa kwasenkangala.","poem":2},{"text":"Wena uthulisa umsindo wabezizweni;","poem":1},{"text":"njengokutshisa kusehliswa ngumthunzi weyezi,","poem":2},{"lineBreak":true},{"text":"ithuliswa kanjalo lengoma yaba lesihluku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Phezu kwale intaba uThixo uSomandla uzakwenzela","poem":1},{"text":"abantu bonke idili lokudla okumnandi,","poem":2},{"text":"idili lewayini elidala,","poem":1},{"text":"inyama enhle kakhulu lewayini elihle kakhulu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Phezu kwale intaba uzadiliza","poem":1},{"text":"isembeso esimboze abantu bonke,","poem":2},{"text":"ilembu elembese izizwe zonke;","poem":1}]},{"type":"verse","number":8,"content":[{"text":"uzakuginya kokuphela ukufa.","poem":2},{"text":"UThixo Wobukhosi uzakwesula inyembezi","poem":1},{"text":"ebusweni babantu bonke;","poem":2},{"text":"uzasusa ihlazo labantu bakhe","poem":1},{"text":"emhlabeni wonke.","poem":2},{"text":"UThixo usekhulumile.","poem":1}]},{"type":"verse","number":9,"content":["Ngalolosuku bazakuthi,",{"text":"“Ngempela lo nguNkulunkulu wethu;","poem":1},{"text":"sethemba kuye, wasikhulula.","poem":2},{"text":"Lo nguThixo, sethemba kuye;","poem":1},{"text":"kasithokozeni sithabe ngokusisindisa kwakhe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Isandla sikaThixo sizahlala phezu kwalintaba;","poem":1},{"text":"kodwa uMowabi uzanyathelelwa ngaphansi ezweni lakhe","poem":2},{"lineBreak":true},{"text":"njengotshani bunyathelelwa phansi emqubeni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bazakwelulela izandla zabo kuye,","poem":1},{"text":"njengenhlambi iselula izandla zayo ukuba intsheze.","poem":2},{"text":"UNkulunkulu uzakuqeda ukuzigqaja kwabo","poem":1},{"text":"phezu kokuhlakanipha kwezandla zabo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Uzadiliza izinqaba zenu eziphakemeyo","poem":1},{"text":"azibhidlizele phansi;","poem":2},{"text":"uzazidilizela phansi emhlabathini,","poem":1},{"text":"kulo kanye uthuli.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}