{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":26,"content":[{"type":"heading","content":["Ingoma Yokubonga"]},{"type":"verse","number":1,"content":["Ngalolosuku ingoma le izahlatshelwa elizweni lakoJuda:",{"text":"Siledolobho eliqinileyo;","poem":1},{"text":"uNkulunkulu wenza ukusindisa","poem":2},{"lineBreak":true},{"text":"kube yimiduli yalo lezivikelo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Vulani amasango","poem":1},{"text":"ukuze isizwe esilungileyo singene,","poem":2},{"lineBreak":true},{"text":"isizwe esigcina ukuthembeka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lizamemeza abe lokuthula okupheleleyo","poem":1},{"text":"lowo olengqondo ebambelelayo,","poem":2},{"lineBreak":true},{"text":"ngoba wethemba kuwe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Thembani uThixo kokuphela,","poem":1},{"text":"ngoba uThixo, uThixo ngokwakhe, uliDwala laphakade.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ubehlisela phansi abahlala engqongeni;","poem":1},{"text":"ulehlisela phansi idolobho eliphakemeyo,","poem":2},{"text":"ulidilizela emhlabathini,","poem":1},{"text":"aliphosele phansi othulini.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inyawo zilinyathelela phansi,","poem":1},{"text":"inyawo zabancindezelweyo,","poem":2},{"lineBreak":true},{"text":"amanyathelo abayanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Indlela yabalungileyo iqondile;","poem":1},{"text":"awu wena oQotho,","poem":2},{"lineBreak":true},{"text":"wenza indlela yabalungileyo ibe butshelezi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yebo, Thixo, sihamba endleleni yemithetho yakho,","poem":1},{"text":"siyakulindela;","poem":2},{"text":"ibizo lakho lodumo lwakho","poem":1},{"text":"kulangathelelwa zinhliziyo zethu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Umphefumulo wami uyakulangazelela ebusuku,","poem":1},{"text":"ekuseni umoya wami uyakukhumbula.","poem":2},{"text":"Lapho ukwahlulela kwakho kufika emhlabeni,","poem":1},{"text":"abantu basemhlabeni bayakufunda ukulunga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lanxa ababi betshengiswa umusa,","poem":1},{"text":"kabakufundi ukulunga;","poem":2},{"text":"laselizweni lokulunga baqhubeka besenza okubi,","poem":1},{"text":"bengabunaki ubukhosi bukaThixo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Oh Thixo, isandla sakho siphakanyiselwe phezulu,","poem":1},{"text":"kodwa kabasiboni.","poem":2},{"text":"Babonise ukutshisekela kwakho abantu bakho bayangiswe;","poem":1},{"text":"umlilo olungiselwe izitha zakho kawubaqede.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Thixo, usilethela ukuthula;","poem":1},{"text":"konke esesikufezile sikwenzelwe nguwe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Oh Thixo, Nkulunkulu wethu, amanye amakhosi ngaphandle kwakho ake asibusa,","poem":1},{"text":"kodwa ibizo lakho yilo lodwa esilidumisayo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Khathesi asafa, kawasaphili;","poem":1},{"text":"imimoya leyana eyahambayo kayivuki.","poem":2},{"text":"Wawajezisa, wawatshabalalisa;","poem":1},{"text":"wesula konke ukukhunjulwa kwawo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Usandisile isizwe, Oh Thixo;","poem":1},{"text":"usandisile isizwe.","poem":2},{"text":"Uzilethele udumo;","poem":1},{"text":"uyiqhelisile yonke imikhawulo yelizwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Thixo, beza kuwe ekuhluphekeni kwabo;","poem":1},{"text":"kwathi lapho usubajezisile","poem":2},{"lineBreak":true},{"text":"banelisa ukunyenyeza umkhuleko.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Njengowesifazane okhulelweyo lapho esezabeletha","poem":1},{"text":"uyabhinqika ekhaliswa yibuhlungu,","poem":2},{"lineBreak":true},{"text":"lathi sabanjalo phambi kwakho, Oh Thixo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sasikhulelwe, sabhinqika ebuhlungwini,","poem":1},{"text":"kodwa sazala umoya.","poem":2},{"text":"Kasilethanga nsindiso emhlabeni;","poem":1},{"text":"kasibazalelanga lutho abantu basemhlabeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kodwa abafileyo bakho bazaphila Thixo,","poem":1},{"text":"imizimba yabo izavuka.","poem":2},{"text":"Lina elihlala othulini,","poem":1},{"text":"vukani lihlabelele ngentokozo.","poem":2},{"text":"Amazolo enu afana lamazolo ekuseni;","poem":1},{"text":"umhlaba uzabaveza abafileyo bawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Hambani bantu bami, ngenani ezindlini zenu,","poem":1},{"text":"lizivalele phakathi;","poem":2},{"text":"lizifihle okwesikhatshana","poem":1},{"text":"ulaka lwakhe luze luphele.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Khangelani, uThixo uyaphuma lapho ahlala khona","poem":1},{"text":"ukuba ajezise abantu basemhlabeni ngenxa yezono zabo.","poem":2},{"text":"Umhlaba uzaveza igazi elachithwa kuwo;","poem":1},{"text":"kawusayikubafihla ababulawayo bawo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}