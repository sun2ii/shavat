{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":27,"content":[{"type":"heading","content":["Ukukhululwa Kuka-Israyeli"]},{"type":"verse","number":1,"content":["Ngalolosuku,",{"text":"uThixo uzajezisa ngenkemba yakhe,","poem":1},{"text":"inkemba yakhe eyesabekayo, enkulu njalo elamandla,","poem":2},{"text":"uLeviyathani inyoka endizayo,","poem":1},{"text":"uLeviyathini inyoka egoqanayo;","poem":2},{"text":"uzayibulala inunu yasolwandle.","poem":1}]},{"type":"verse","number":2,"content":["Ngalolosuku:",{"text":"“Hlabelani ngesivini esithela izithelo.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Mina Thixo, ngiyasilinda;","poem":2},{"lineBreak":true},{"text":"ngiyasithelezela kokuphela.","poem":2},{"text":"Ngisilinda emini lebusuku","poem":1},{"text":"ukuze kungabikhona owenza okubi kuso.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Angithukuthelanga.","poem":2},{"text":"Sengathi kungabe kulokhula lameva okumelana lami!","poem":1},{"text":"Bengizakulanda ngilwe lakho empini;","poem":2},{"lineBreak":true},{"text":"bengizakutshisa konke ngomlilo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Loba phela kabeze bazephephela kimi;","poem":1},{"text":"kabenze ukuthula lami,","poem":2},{"lineBreak":true},{"text":"yebo, kabenze ukuthula lami.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ensukwini ezizayo uJakhobe uzagxila,","poem":1},{"text":"u-Israyeli uzahluma akhahlele","poem":2},{"lineBreak":true},{"text":"agcwalise umhlaba wonke ngezithelo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"UThixo usemtshayile na","poem":1},{"text":"njengokutshaya kwakhe abamtshayayo?","poem":2},{"text":"Usebulewe na","poem":1},{"text":"njengokubulawa kwalabo abambulalayo?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngempi langokumxotsha elizweni ulwe laye,","poem":1},{"text":"ngesiphepho sakhe esesabekayo umsusela phandle,","poem":2},{"lineBreak":true},{"text":"njengamhla kuvunguza umoya wasempumalanga.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngalokhu-ke ukona kukaJakhobe kuzahlawulelwa,","poem":1},{"text":"njalo lokhu kuzakuba yisithelo esigcweleyo","poem":2},{"lineBreak":true},{"text":"esokususwa kwesono sakhe:","poem":2},{"text":"Lapho esenza wonke amatshe e-alithare","poem":1},{"text":"abe njengamatshe ekalaga avuthuzwe izicucu,","poem":2},{"text":"akulazinsika zika-Ashera kumbe ama-alithare empepha","poem":1},{"text":"azatshiywa emi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Idolobho elivikelweyo libhidlikile,","poem":1},{"text":"indawo yokuhlala etshiyiweyo, yadelwa njengenkangala;","poem":2},{"text":"lapho asesidla khona amathole","poem":1},{"text":"lapho alala khona phansi;","poem":2},{"lineBreak":true},{"text":"aphundla ingatsha zalo zisale zize.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Lapho ingatsha zalo sezomile, ziyephulwa","poem":1},{"text":"kuze abesifazane babase umlilo ngazo.","poem":2},{"text":"Ngoba laba ngabantu abangelakuzwisisa;","poem":1},{"text":"ngakho uMenzi wabo kalasihawu kubo,","poem":2},{"lineBreak":true},{"text":"loMdali wabo akayikuba lomusa kubo.","poem":2}]},{"type":"verse","number":12,"content":["Ngalolosuku uThixo uzabhula kusukela kuYufrathe ogelezayo kusiya eMhotsheni waseGibhithe, njalo lina abako-Israyeli lizabuthwa munye ngamunye."]},{"type":"verse","number":13,"content":["Njalo ngalolusuku kuzakhaliswa icilongo elikhulu. Labo ababelahlekele elizweni lase-Asiriya lababexotshelwe elizweni laseGibhithe bazabuya bakhonze uThixo phezu kwentaba engcwele eJerusalema."]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}