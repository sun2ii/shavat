{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":28,"content":[{"type":"heading","content":["Maye Kubathungameli Bako-Efrayimi LakoJuda"]},{"type":"verse","number":1,"content":[{"text":"Maye kulowomqhele wamaluba,","poem":1},{"text":"iqhono lezidakwa zako-Efrayimi,","poem":2},{"lineBreak":true},{"text":"kuluba elibunayo, ubuhle obukhazimulayo,","poem":2},{"text":"obubekwe ngaphezulu kwesigodi esivundileyo,","poem":1},{"text":"kulelodolobho, iqhono lalabo asebelaliswe liwayini phansi!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Khangelani, uThixo ulaye olamandla oqinileyo.","poem":1},{"text":"Njengesiqhotho lomoya odilizayo,","poem":2},{"text":"njengezulu lesiphepho lesihlambi esilamandla,","poem":1},{"text":"uzakuphosa phansi ngamandla amakhulu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Umqhele lowo wamaluba, iqhono lezidakwa zako-Efrayimi","poem":1},{"text":"kuzanyathelwa ngaphansi kwezinyawo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Leliyaluba elibunayo, ubuhle bakhe obukhazimulayo,","poem":1},{"text":"kuhlanyelwe ngaphezu kwesigodi esivundileyo,","poem":2},{"text":"lizakuba njengomkhiwa ovuthiweyo kungakavunwa","poem":1},{"text":"okuthi khonokho nje omunye ewubona awukhe ngesandla","poem":2},{"lineBreak":true},{"text":"awuginye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ngalolosuku uThixo uSomandla","poem":1},{"text":"uzakuba ngumqhele okhazimulayo,","poem":2},{"text":"umqhele wamaluba omuhle","poem":1},{"text":"kulabo abayizinsalela zabantu bakhe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Uzakuba ngumoya wokulunga","poem":1},{"text":"kulowo owahlulelayo,","poem":2},{"text":"umthombo wamandla","poem":1},{"text":"kulabo ababuyisela impi emuva isisesangweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lalaba bayadiyazela ngenxa yewayini,","poem":1},{"text":"babhadazele ngenxa yotshwala.","poem":2},{"text":"Abaphristi labaphrofethi bayadiyazela ngenxa yotshwala,","poem":1},{"text":"njalo baphambene ngenxa yewayini;","poem":2},{"text":"bayabhadazela ngenxa yotshwala,","poem":1},{"text":"bayadiyazela,","poem":2},{"text":"lapho bebona imibono,","poem":1},{"text":"bayakhininda lapho besenza izinqumo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Amatafula wonke agcwele amahlanzo","poem":1},{"text":"njalo akulandawo engelamanyala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ngubani lowo ozama ukumfundisa?","poem":1},{"text":"Umbiko wakhe uwuchazela bani na?","poem":2},{"text":"Abantwana abangasamunyi,","poem":1},{"text":"kumbe abalunyuliweyo na?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngoba kumi kanje:","poem":1},{"text":"Yenza lokhu, yenza lokhuya,","poem":2},{"lineBreak":true},{"text":"umthetho walokhu, umthetho walokhuya;","poem":2},{"lineBreak":true},{"text":"ingcosana lapha, lengconsana laphayana.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kungasenani, ngezindebe zabezizweni langolimi","poem":1},{"text":"olungaziwayo, uNkulunkulu uzakhuluma lalababantu,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"atshoyo kubo wathi,","poem":1},{"text":"“Le yindawo yokuphumula, abadiniweyo kabaphumule”;","poem":2},{"text":"njalo, “Le yindawo yokucambalala,”","poem":1},{"text":"kodwa kabalalelanga.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngakho ilizwi likaThixo kubo lizakuba ngelithi:","poem":1},{"text":"Yenza lokhu, yenza lokhuya,","poem":2},{"lineBreak":true},{"text":"umthetho walokhu, umthetho walokhuya,","poem":2},{"lineBreak":true},{"text":"ingcosana lapha, ingcosana laphaya,","poem":2},{"text":"ukuze bahambe bawe nyovane,","poem":1},{"text":"balimale, bathiywe, bathunjwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ngakho-ke zwanini ilizwi likaThixo lina bantu abaklolodayo,","poem":1},{"text":"ababusa abantu laba eJerusalema.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lizitshaya izifuba lisithi, “Senze isivumelwano lokufa,","poem":1},{"text":"senza isivumelwano lethuna.","poem":2},{"text":"Nxa isijeziso esikhulu sifika,","poem":1},{"text":"kasiyikusithinta,","poem":2},{"text":"ngoba senze amanga aba yisiphephelo sethu","poem":1},{"text":"lenkohliso yaba yindawo yethu yokucatsha.”","poem":2}]},{"type":"verse","number":16,"content":["Ngakho lokhu yikho okutshiwo nguThixo woBukhosi:",{"text":"“Khangelani, ngibeka ilitshe eZiyoni,","poem":1},{"text":"ilitshe elihloliweyo,","poem":2},{"lineBreak":true},{"text":"ilitshe lengosi eliligugu;","poem":2},{"text":"elesisekelo esiqinisekileyo,","poem":1},{"text":"lowo othembayo akayikuphela amandla.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngizakwenza okufaneleyo kube yintambo yokulinganisa,","poem":1},{"text":"ukulunga kube yintambo yokuqondisa;","poem":2},{"text":"isiqhotho sizakhukhula isiphephelo senu, amanga,","poem":1},{"text":"lamanzi azagabhela indawo yenu yokucatsha.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Isivumelwano senu lokufa sizakwesulwa;","poem":1},{"text":"isivumelwano senu lengcwaba kasiyikuma.","poem":2},{"text":"Lapho isijeziso esikhulu sifika","poem":1},{"text":"sizalilahla phansi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ngazozonke izikhathi esizafika ngazo sizalithatha;","poem":1},{"text":"ukusa ngokusa, emini lebusuku,","poem":2},{"lineBreak":true},{"text":"sizalikhukhula.”","poem":2},{"lineBreak":true},{"text":"Ukulizwisisa ilizwi leli","poem":1},{"text":"kuzaletha ukwesaba khona ngokwakho.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Umbheda mfitshane kakhulu ukuba unabe kuwo,","poem":1},{"text":"ingubo incane kakhulu ukuba ugoqelwe ngayo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"UThixo uzavuka njengalokho akwenzayo entabeni iPherazimu;","poem":1},{"text":"uzathukuthela njengaseSigodini seGibhiyoni,","poem":2},{"text":"ukuba enze umsebenzi wakhe, umsebenzi oyisimanga,","poem":1},{"text":"enze umsebenzi wakhe, umsebenzi ongaziwayo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Khathesi-ke yekelani ukukloloda kwenu","poem":1},{"text":"funa amaketane elibotshwe ngawo alisinde kakhulu;","poem":2},{"text":"iNkosi, uThixo uSomandla usengitshele","poem":1},{"text":"ngesimiso sokutshabalalisa ilizwe lonke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Lalelani lizwe ilizwi lami;","poem":1},{"text":"lalelani lizwe engikutshoyo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Lapho umlimi elima ukuba ahlanyele, ulima kokuphela na?","poem":1},{"text":"Uqhubeka elima umhlabathi ewubhuqa kokuphela na?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nxa umhlabathi esewendlale kuhle,","poem":1},{"text":"kahlanyeli ikharawayi ahlanyele lekhumini na?","poem":2},{"text":"Kahlanyeli ingqoloyi endaweni yayo;","poem":1},{"text":"ibhali ensimini yayo,","poem":2},{"lineBreak":true},{"text":"lespelithi ensimini yaso na?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"UNkulunkulu wakhe uyamfundisa,","poem":1},{"text":"amfundise indlela eqondileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ikharawayi kayibhulwa ngesileyi;","poem":1},{"text":"lenqola kayihanjiswa phezu kwekhumini,","poem":2},{"text":"kodwa ikharawayi ibhulwa ngentonga,","poem":1},{"text":"kuthi ikhumini ibhulwe ngombhulo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Amabele kumele acholwe ukuba kwenziwe isinkwa,","poem":1},{"text":"ngakho umuntu kawabhuli kokuphela.","poem":2},{"text":"Lanxa ehambisa inqola yakhe yokubhula phezu kwawo,","poem":1},{"text":"amabhiza akhe kawawacholi.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Konke lokhu lakho kuvela kuThixo uSomandla","poem":1},{"text":"omangalisayo ngokweluleka,","poem":2},{"lineBreak":true},{"text":"njalo olenhlakanipho emangalisayo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/27.json","previousChapterAudioLinks":{},"numberOfVerses":29}