{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":29,"content":[{"type":"heading","content":["Maye Kulo Idolobho LikaDavida"]},{"type":"verse","number":1,"content":[{"text":"Maye kuwe Ariyeli, Ariyeli,","poem":1},{"text":"idolobho uDavida ahlala kulo!","poem":2},{"text":"Yengezelela umnyaka emnyakeni","poem":1},{"text":"Wenze ukulandelana kwemikhosi yakho kuqhubeke.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ikanti i-Ariyeli ngizalivimbezela,","poem":1},{"text":"lizakhala lilile,","poem":2},{"lineBreak":true},{"text":"kimi lizafana leziko le-alithari.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngizakuhlasela amacele wonke,","poem":1},{"text":"ngizakuzungeza ngemiphotshongo","poem":2},{"lineBreak":true},{"text":"ngikuvimbezele ngemisebenzi yokukuhlasela.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nxa usudilizelwe phansi, uzakhuluma uphansi,","poem":1},{"text":"inkulumo yakho ayiyikuzwakala ivela othulini.","poem":2},{"text":"Ilizwi lakho lizafana lelethonga liphuma phansi emhlabathini.","poem":1},{"text":"Ilizwi lakho lizanyenyeza liphuma othulini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kodwa izitha zakho ezinengi,","poem":1},{"text":"zizakuba njengothuli olucolekileyo,","poem":2},{"lineBreak":true},{"text":"amaxuku alesihluku afane lamakhoba aphephukayo.","poem":2},{"text":"Masinyazana, ngesikhatshana nje,","poem":1}]},{"type":"verse","number":6,"content":[{"text":"UThixo uSomandla uzafika","poem":2},{"text":"ngomdumo langokunyikinyeka komhlaba langomsindo omkhulu;","poem":1},{"text":"ngesiphepho langesivunguzane langamalangabi omlilo oqothulayo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lapho-ke amaxuku ezizwe zonke ezilwa le-Ariyeli,","poem":1},{"text":"ayihlaselayo kanye lezinqaba zayo,","poem":2},{"text":"njalo eyizungezile, azakuba njengephupho,","poem":1},{"text":"lilombono webusuku,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"njengomuntu olambileyo ephupha esidla,","poem":1},{"text":"kodwa aphaphame ukulamba kwakhe kulokhu kunjalo,","poem":2},{"text":"lanjengalapho umuntu owomileyo ephupha enatha","poem":1},{"text":"kodwa aphaphame engelamandla, ukoma kwakhe kungaphelanga.","poem":2},{"text":"Kuzakuba njalo lakumaxuku ezizwe zonke","poem":1},{"text":"ezilwa leNtaba iZiyoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Thithibalani limangale,","poem":1},{"text":"zenzeni iziphofu lingabe lisabona;","poem":2},{"text":"dakwani kodwa kungabi","poem":1},{"text":"ngenxa yotshwala.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"UThixo ulehlisele ubuthongo obukhulu:","poem":1},{"text":"uwavalile amehlo enu (abaphrofethi);","poem":2},{"lineBreak":true},{"text":"wagubuzela amakhanda enu (izanuse).","poem":2}]},{"type":"verse","number":11,"content":["Kini umbono wonke lo kawusilutho kodwa amazwi nje avalelwe encwadini egoqiweyo. Njalo nxa incwadi leyo liyiqhubela umuntu okwaziyo ukubala lithi kuye, “Ake ubale lokhu,” uzaphendula athi, “Anganelisi, ngoba ivaliwe.”"]},{"type":"verse","number":12,"content":["Loba nxa incwadi leyo liyiqhubela umuntu ongakwaziyo ukubala lithi kuye, “Ake ubale lokhu,” uzaphendula athi, “Angikwazi ukubala.”"]},{"type":"verse","number":13,"content":["UThixo uthi:",{"text":"“Abantu laba basondela kimi ngemilomo yabo","poem":1},{"text":"bangikhonze ngezindebe zabo,","poem":2},{"lineBreak":true},{"text":"kodwa inhliziyo zabo zikude lami;","poem":2},{"text":"ukungikhonza kwabo","poem":1},{"text":"kwenziwa kuphela nje ngemilayo abayifundiswa ngabantu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngakho-ke abantu laba ngizaphinda ngibethuse","poem":1},{"text":"ngesimanga phezu kwesimanga;","poem":2},{"text":"inhlakanipho yabahlakaniphileyo izaphela,","poem":1},{"text":"ulwazi lwezazi lunyamalale.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Maye kulabo abatshona phansi ukuba","poem":1},{"text":"bafihlele uThixo amacebo abo,","poem":2},{"text":"abenzela imisebenzi yabo emnyameni bacabange bathi,","poem":1},{"text":"“Ngubani osibonayo? Ngubani ozakwazi?”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Lina lihlanekela izinto kube","poem":1},{"text":"sengathi kucatshangwa ukuthi umbumbi unjengebumba.","poem":2},{"text":"Okubunjiweyo kungatsho yini kokubumbileyo kuthi,","poem":1},{"text":"“Kangibumbanga”?","poem":2},{"text":"Imbiza ingatsho na kumbumbi ithi,","poem":1},{"text":"“Kazi lutho”?","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ngesikhatshana esifitshane nje,","poem":1},{"text":"iLebhanoni kayiyikuphendulwa ibe yinsimu evundileyo,","poem":2},{"lineBreak":true},{"text":"kuthi insimu evundileyo ifane legusu na?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngalolosuku izacuthe zizawezwa amazwi omqulu,","poem":1},{"text":"njalo ekukhanyeni lebumnyameni","poem":2},{"lineBreak":true},{"text":"amehlo eziphofu abone emnyameni omkhulu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Abathobekileyo bazathokoza futhi kuThixo,","poem":1},{"text":"abaswelayo bazathokoza koNgcwele ka-Israyeli.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Abalesihluku bazanyamalala,","poem":1},{"text":"abahleka usulu abayikuba khona,","poem":2},{"lineBreak":true},{"text":"bonke abathanda ukwenza okubi bazabhujiswa,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"labo abenza umuntu abe lecala ngokufakaza amanga,","poem":1},{"text":"abathiya umvikeli enkundleni yamacala,","poem":2},{"text":"kuthi ngobufakazi obungamanga","poem":1},{"text":"benze omsulwa angehlulelwa ngemfanelo.","poem":2}]},{"type":"verse","number":22,"content":["Ngakho-ke lokhu yikho uThixo owahlenga u-Abhrahama akutshoyo kwabendlu kaJakhobe:",{"text":"“UJakhobe kasayikuba lenhloni,","poem":1},{"text":"ubuso bakhe kabusayikudana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Lapho bebona abantwana babo,","poem":1},{"text":"umsebenzi wezandla zami,","poem":2},{"text":"bazakwenza ibizo lami libengcwele;","poem":1},{"text":"bazabubona ubungcwele boNgcwele kaJakhobe,","poem":2},{"lineBreak":true},{"text":"njalo bazamesaba uNkulunkulu ka-Israyeli.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Abalahlekileyo emoyeni bazakuba lokuzwisisa;","poem":1},{"text":"abasolayo bazavuma ukufundiswa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/28.json","previousChapterAudioLinks":{},"numberOfVerses":24}