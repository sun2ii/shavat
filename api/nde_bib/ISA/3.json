{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":3,"content":[{"type":"heading","content":["Ukwahlulelwa KweJerusalema Lelizwe LakoJuda"]},{"type":"verse","number":1,"content":[{"text":"Khangelani khathesi UThixo,","poem":1},{"text":"uThixo uSomandla","poem":2},{"text":"usezasusa eJerusalema lelizweni lakoJuda","poem":1},{"text":"okufunekayo losizo:","poem":2},{"text":"konke ukudla lamanzi,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"iqhawe lebutho,","poem":2},{"text":"umahluleli lomphrofethi,","poem":1},{"text":"isangoma lomuntu omdala,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"induna yebutho labangamatshumi amahlanu","poem":1},{"text":"lamadoda ayizikhulu,","poem":2},{"text":"umeluleki, ingcitshi yemisebenzi,","poem":1},{"text":"lesanuse esihlakaniphileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ngizakwenza abafana babeyizikhulu zabo;","poem":1},{"text":"abantwana nje bazababusa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Abantu bazancindezelana,","poem":1},{"text":"umuntu avukele umuntu,","poem":2},{"lineBreak":true},{"text":"umakhelwane avukele umakhelwane.","poem":2},{"text":"Abatsha bazavukela abadala,","poem":1},{"text":"abeyisekayo bavukele abahlonitshwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Indoda izabamba omunye wabafowabo","poem":1},{"text":"emzini kayise ithi,","poem":2},{"text":"“Ulesembatho, woba ngumkhokheli wethu,","poem":1},{"text":"inqwaba yamanxiwa le","poem":2},{"lineBreak":true},{"text":"izakuba ngaphansi kombuso wakho.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kodwa ngalolosuku uzakhala athi,","poem":1},{"text":"“Angilamasiza.","poem":2},{"text":"Endlini yami akulakudla loba izigqoko;","poem":1},{"text":"ungangenzi umkhokheli wabantu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"IJerusalema liyadiyazela,","poem":1},{"text":"uJuda uyawa;","poem":2},{"text":"amazwi abo lezenzo zabo kuphambene loThixo,","poem":1},{"text":"kweyisa ubukhosi bakhe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ukukhangeleka kobuso babo kufakaza kubi ngabo;","poem":1},{"text":"babukisa izono zabo njengeSodoma;","poem":2},{"lineBreak":true},{"text":"kabazifihli.","poem":2},{"text":"Maye kubo!","poem":1},{"text":"Bazilethele incithakalo phezu kwabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tshela abalungileyo ukuthi kuzakuba kuhle kubo,","poem":1},{"text":"ngoba bazakholisa izithelo zezenzo zabo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Maye kwababi!","poem":1},{"text":"Incithakalo isiphezu kwabo!","poem":2},{"text":"Bazaphindiselwa","poem":1},{"text":"ngalokho izandla zabo ezikwenzileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Abatsha bancindezela abantu bami,","poem":1},{"text":"abesifazane bayababusa.","poem":2},{"text":"Awu, bantu bami, abakhokheli benu bayaliduhisa;","poem":1},{"text":"bayaliphambula endleleni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"UThixo uphakama ukuba afakaze indaba yakhe,","poem":1},{"text":"uyasukuma ukuba ahlulele abantu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"UThixo uqalisa ukwahlulela","poem":1},{"text":"abadala labakhokheli babantu esithi,","poem":2},{"text":"“Yini elitshabalalise isivini sami;","poem":1},{"text":"elikuthumbe kubayanga kusezindlini zenu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Litshoni ngokuchoboza abantu bami","poem":1},{"text":"langokuchola ubuso babayanga?”","poem":2},{"lineBreak":true},{"text":"kutsho iNkosi, uThixo uSomandla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"UThixo uthi,","poem":1},{"text":"“Abesifazane baseZiyoni bayaziphakamisa,","poem":2},{"text":"bahamba belule izintamo,","poem":1},{"text":"behuga ngamehlo abo,","poem":2},{"text":"begwenxeka ngamanyathelo amancane,","poem":1},{"text":"izigqizo zikhencezela enqagaleni zabo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngakho-ke uThixo uzakwenza amakhanda","poem":1},{"text":"abesifazane baseZiyoni abe lezilonda;","poem":2},{"text":"uThixo uzakwenza","poem":1},{"text":"isikhumba samakhanda abo siphuceke.”","poem":2}]},{"type":"verse","number":18,"content":["Ngalolosuku uThixo uzahluthuna imiceciso yabo: amasongo, imincwazi, lemigaxo yentanyeni"]},{"type":"verse","number":19,"content":["amacici, izigqizo lezimbombozo,"]},{"type":"verse","number":20,"content":["amaqhiye, izigetsho lamabhanti; amambodlela amakha lezintebe,"]},{"type":"verse","number":21,"content":["indandatho ezilophawu lamasongo empumulo,"]},{"type":"verse","number":22,"content":["izembatho ezinhle lezingubo lezigqoko, izikhwama"]},{"type":"verse","number":23,"content":["lezibuko, lezigqoko zelineni, imiqhele lamaveli."]},{"type":"verse","number":24,"content":[{"text":"Endaweni yephunga elimnandi","poem":1},{"text":"kuzakuba lomnuko omubi;","poem":2},{"lineBreak":true},{"text":"endaweni yebhanti kuzakuba legoda,","poem":2},{"text":"endaweni yenwele ezilungiswe kuhle","poem":1},{"text":"kuzakuba lempabanga,","poem":2},{"text":"endaweni yezigqoko ezinhle","poem":1},{"text":"kuzakuba ngamasaka,","poem":2},{"lineBreak":true},{"text":"endaweni yobuhle, kuzakuba lihlazo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Amadoda akini azakuwa ngenkemba,","poem":1},{"text":"kanjalo lamabutho akini empini.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Amasango aseZiyoni azakhala alile,","poem":1},{"text":"kuthi yona ihlale phansi ichithekile.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}