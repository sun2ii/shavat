{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":30,"content":[{"type":"heading","content":["Maye Esizweni Esiyisiqholo"]},{"type":"verse","number":1,"content":[{"text":"“Maye ebantwaneni abalobuqholo,”","poem":1},{"text":"kutsho uThixo,","poem":2},{"text":"“kulabo abafeza amacebo angasiwami,","poem":1},{"text":"abenza isivumelwano, kodwa kungesi ngoMoya wami,","poem":2},{"lineBreak":true},{"text":"besengeza isono phezu kwesono;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"labaya eGibhithe bengabuzanga kimi;","poem":1},{"text":"abadinga usizo lokuvikelwa nguFaro,","poem":2},{"lineBreak":true},{"text":"lomthunzi wokuphephela eGibhithe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kodwa-ke ukuvikelwa nguFaro kuzakuba lihlazo kini,","poem":1},{"text":"umthunzi weGibhithe uzaliyangisa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lanxa belabameli eZowani,","poem":1},{"text":"lezithunywa zabo sezifikile eHanesi,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"bonke bazayangeka","poem":1},{"text":"ngenxa yabantu abangalasizo kubo,","poem":2},{"text":"abangalethi sizo loba inzuzo,","poem":1},{"text":"kodwa ihlazo lokuyangeka kuphela.”","poem":2}]},{"type":"verse","number":6,"content":["Isiphrofethi mayelana lezinyamazana zeNegebi sithi:",{"text":"kulolonke ilizwe lobunzima losizi,","poem":1},{"text":"elezilwane lezilwanekazi,","poem":2},{"lineBreak":true},{"text":"elamabululu lezinyoka ezeqayo","poem":2},{"text":"izithunywa zithwala inotho yazo ngemihlane yabobabhemi,","poem":1},{"text":"impahla yazo eligugu ziyithwale ngamalunda amakamela,","poem":2},{"text":"zikusa ebantwini abangayikuba losizo kuzo.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Zisiwa eGibhithe osizo lwayo lungelamsebenzi.","poem":2},{"text":"Ngakho ngiyibiza ngokuthi","poem":1},{"text":"nguRahabi ivilavoxo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Hamba khathesi nje, ubalobele khona esibhebhedwini,","poem":1},{"text":"kulobe emqulwini,","poem":2},{"text":"ukuze kuthi ensukwini ezizayo","poem":1},{"text":"kube yibufakazi obungapheliyo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Laba ngabantu abangabahlamuki, abantwana abangabakhohlisi,","poem":1},{"text":"abantwana abangafuniyo ukulalela imfundiso kaThixo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bathi kwabayizanuse,","poem":1},{"text":"“Lingabe lisahlahlula futhi.”","poem":2},{"text":"Kubaphrofethi bathi,","poem":1},{"text":"“Lingasitsheli imibono ngalokho okuqondileyo.","poem":2},{"text":"Sitsheleni izinto ezinhle,","poem":1},{"text":"liphrofethe inkohliso.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tshiyani indlela le,","poem":1},{"text":"phambukani kulo umkhondo","poem":2},{"text":"liyekele ukusibelesela","poem":1},{"text":"ngoNgcwele ka-Israyeli!”","poem":2}]},{"type":"verse","number":12,"content":["Ngakho okutshiwo ngoNgcwele ka-Israyeli yilokhu:",{"text":"“Njengoba lilalile ilizwi leli,","poem":1},{"text":"lathembela ekuncindezelweni,","poem":2},{"lineBreak":true},{"text":"lagwaba ngokukhohliswa,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"isono lesi kini sizafana lomduli ophakemeyo,","poem":1},{"text":"olomnkenke njalo ohlephukayo,","poem":2},{"lineBreak":true},{"text":"odilika masinyane, ngesikhatshana nje.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Uzadilika ube yizicucu, njengembiza yombumbi","poem":1},{"text":"ephahazeke kakubi","poem":2},{"text":"akwaze kwatholakala lesihlephu sokokha amalahle eziko","poem":1},{"text":"ezicucwini zayo kumbe ukukha amanzi emgqonyeni.”","poem":2}]},{"type":"verse","number":15,"content":["Lokhu yikho okutshiwo nguThixo Wobukhosi, oNgcwele ka-Israyeli, ukuthi:",{"text":"“Ukusindiswa kwenu kusekuphendukeni lekuphumuleni,","poem":1},{"text":"amandla enu asekuthuleni lekwethembeni,","poem":2},{"lineBreak":true},{"text":"kodwa likwalile lokhu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Lithe, ‘Hatshi, sizabaleka ngamabhiza.’","poem":1},{"text":"Ngakho lizabaleka!","poem":2},{"text":"Lithe, ‘Sizagada amabhiza alejubane.’","poem":1},{"text":"Ngakho abalixotshayo bazakuba lejubane!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abayinkulungwane bazabaleka","poem":1},{"text":"besongelwe ngoyedwa nje;","poem":2},{"text":"ekusongeni kwabahlanu, lizabaleka lonke,","poem":1},{"text":"lize lisale linjengensika yophawu lwelizwe","poem":2},{"text":"elisengqongeni yentaba,","poem":1},{"text":"lanjengesiboniso phezu koqaqa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kodwa uThixo ulangatha ukuba lomusa kini;","poem":1},{"text":"uyavuka ukuba alitshengise isihawu.","poem":2},{"text":"Ngoba uThixo unguNkulunkulu wokulunga.","poem":1},{"text":"Babusisiwe bonke abamlindeleyo!","poem":2}]},{"type":"verse","number":19,"content":["Awu bantu baseZiyoni, abahlala eJerusalema, alisayikulila. UThixo uzakuba lomusa kini nxa licela usizo. Uzaliphendula khonokho nje ekulizweni kwakhe."]},{"type":"verse","number":20,"content":["Lanxa nje uThixo elinika isinkwa sokuhlupheka lamanzi osizi, abalifundisayo kabayikucatsha futhi; lizababona ngamehlo enu."]},{"type":"verse","number":21,"content":["Loba liphambukele kwesokudla kumbe kwesenxele lizalizwa ilizwi ngemva kwenu lisithi, “Le yiyo indlela; hambani ngayo.”"]},{"type":"verse","number":22,"content":["Lapho-ke lizangcolisa izithombe zenu ezihuqwe ngesiliva lezifanekiso zenu ezinanyekwe ngegolide; lizazilahlela khatshana njengelembu lowesifazane obesesikhathini, lithi kuzo, “Sukani lapha!”"]},{"type":"verse","number":23,"content":["UThixo uzalehlisela izulu lenhlanyelo yenu eliyihlanyele emhlabathini, lamabele azavela emhlabathini azakuba mahle njalo emanengi. Ngalolosuku inkomo zenu zizakudla emadlelweni abanzi."]},{"type":"verse","number":24,"content":["Inkabi labobabhemi elilima ngakho umhlabathi kuzakudla utshani lamabele ahlungulwe ngefologwe langefotsholo."]},{"type":"verse","number":25,"content":["Ngosuku lokubulawa okukhulu, lapho imiphotshongo isiwa, izifula zamanzi zizageleza kuzozonke izintaba ezinde lakuwo wonke amaqaqa adephileyo."]},{"type":"verse","number":26,"content":["Inyanga izakhanya njengelanga, ukukhanya kwelanga kukhanye ngokuphindwe kasikhombisa, njengokukhanya kwensuku eziyisikhombisa ezigcweleyo, lapho uThixo esebopha amanxeba abantu bakhe, epholisa lezilonda ezabangwa nguye."]},{"type":"verse","number":27,"content":[{"text":"Khangelani, ibizo likaThixo livela khatshana,","poem":1},{"text":"lolaka oluvuthayo kanye lokuthunqa kwentuthu enkulu;","poem":2},{"text":"izindebe zakhe zigcwele intukuthelo,","poem":1},{"text":"ulimi lwakhe lungumlilo ohangulayo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Umoya awuphefumulayo unjengesifula","poem":1},{"text":"esigcwele amanzi afika entanyeni.","poem":2},{"text":"Uhlungula izizwe ngesefa yokubhubhisa;","poem":1},{"text":"ufaka emihlathini yabantu","poem":2},{"lineBreak":true},{"text":"amatomu abasa ekulahlekeni.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Lizahlabela","poem":1},{"text":"njengasebusuku bokuthakazelela umkhosi ongcwele;","poem":2},{"text":"inhliziyo zenu zizathokoza","poem":1},{"text":"njengalapho abantu besiya entabeni kaThixo,","poem":2},{"text":"eDwaleni lika-Israyeli,","poem":1},{"text":"belemihubhe.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"UThixo uzakwenza abantu balizwe ilizwi lakhe lobukhosi,","poem":1},{"text":"njalo uzakwenza bayibone ingalo yakhe isehla","poem":2},{"text":"ngokuthukuthela okukhulu langomlilo oqothulayo,","poem":1},{"text":"langesihlambo esikhulu, lomdumo kanye lesiqhotho.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ilizwi likaThixo lizayichitha i-Asiriya;","poem":1},{"text":"abatshaye ngenduku yakhe yobukhosi.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Imvimvinya yinye uThixo abatshaya yona","poem":1},{"text":"ngentonga yakhe yokujezisa,","poem":2},{"text":"uzakuba ukanye lokutshaywa kwamagedla lemihubhe,","poem":1},{"text":"lapho esilwa labo impi ngezidutshulo zengalo yakhe.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"IThofethi sekukade yalungiswa;","poem":1},{"text":"seyenziwa yalungela inkosi.","poem":2},{"text":"Igodi layo lomlilo selenziwa latshona njalo laba banzi,","poem":1},{"text":"lomlilo lenkuni ezinengi;","poem":2},{"text":"umphefumulo kaThixo,","poem":1},{"text":"utshisa njengokugeleza komlilo wesolufa,","poem":2},{"lineBreak":true},{"text":"uyawulumathisa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}