{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":31,"content":[{"type":"heading","content":["Maye Kulabo Abathemba IGibhithe"]},{"type":"verse","number":1,"content":[{"text":"Maye kulabo abaya eGibhithe ukuyafuna usizo,","poem":1},{"text":"abathemba amabhiza,","poem":2},{"text":"abathembe ubunengi bezinqola zabo zempi","poem":1},{"text":"lamandla amakhulu abagadi bamabhiza abo,","poem":2},{"text":"kodwa bengathembeli koNgcwele ka-Israyeli,","poem":1},{"text":"kumbe bacele usizo kuThixo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ikanti laye uhlakaniphile njalo angaletha incithakalo;","poem":1},{"text":"ilizwi lakhe kalibuyeli emuva.","poem":2},{"text":"Uzavukela abendlu yababi","poem":1},{"text":"lalabo abasiza abenza okubi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kodwa amaGibhithe ngabantu kawasiNkulunkulu;","poem":1},{"text":"amabhiza awo yinyama kawasimoya.","poem":2},{"text":"Lapho uThixo eselula isandla sakhe,","poem":1},{"text":"lowo osizayo uzakhubeka,","poem":2},{"lineBreak":true},{"text":"lowo osizwayo uzakuwa,","poem":2},{"lineBreak":true},{"text":"bobabili bazabhubha.","poem":2}]},{"type":"verse","number":4,"content":["Lokhu yikho okutshiwo nguThixo kimi, ukuthi:",{"text":"“Njengesilwane sihwabha;","poem":1},{"text":"isilwane esikhulu sibhongela esikubambileyo,","poem":2},{"text":"lanxa ixuku lonke labelusi","poem":1},{"text":"libizwa ukuba lisihlasele,","poem":2},{"text":"kasethuswa yikuklabalala kwabo","poem":1},{"text":"kumbe sithikanyezwe ngumsindo wabo,","poem":2},{"text":"unjalo-ke uThixo uSomandla uzakwehla","poem":1},{"text":"ukuba alwe entabeni iZiyoni laseziqongweni zayo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Njengezinyoni zitshaya amaphiko emoyeni,","poem":1},{"text":"uThixo uSomandla uzavikela iJerusalema,","poem":2},{"text":"uzalivikela alikhulule,","poem":1},{"text":"uzadlula ‘ngaphezu’ kwalo alihlenge.”","poem":2}]},{"type":"verse","number":6,"content":["Awu bantu bako-Israyeli, buyelani kulowo elamhlamukela kakubi."]},{"type":"verse","number":7,"content":["Ngoba ngalolosuku lonke lizazilahla izithombe zenu zesiliva lezegolide elizenze ngezandla zenu ezonayo."]},{"type":"verse","number":8,"content":[{"text":"“I-Asiriya izachithwa ngenkemba engesiyabantu,","poem":1},{"text":"inkemba engasiyo yabantu izababhubhisa.","poem":2},{"text":"Bazayibalekela inkemba,","poem":1},{"text":"izinsizwa zabo zizakwenziwa izigqili.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inqaba yabo izadilika ngenxa yokwesaba;","poem":1},{"text":"lapho bebona uphawu lwempi izinduna zabo zempi zizatshaywa luvalo,”","poem":2},{"text":"kutsho uThixo","poem":1},{"text":"omlilo wakhe useZiyoni,","poem":2},{"lineBreak":true},{"text":"osithando sakhe siseJerusalema.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/30.json","previousChapterAudioLinks":{},"numberOfVerses":9}