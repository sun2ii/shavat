{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":32,"content":[{"type":"heading","content":["Umbuso Wokulunga"]},{"type":"verse","number":1,"content":[{"text":"Khangelani, inkosi izabusa ngokulunga","poem":1},{"text":"lababusi bazabusa ngemfanelo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Umuntu ngamunye uzakuba njengesihonqo sokuvikela umoya,","poem":1},{"text":"lesiphephelo sokucatshela isiphepho,","poem":2},{"text":"njengezihotsha zamanzi enkangala","poem":1},{"text":"njengomthunzi wedwala elikhulu elizweni elomileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Lapho-ke amehlo alabo ababonayo kawasayikuvaleka,","poem":1},{"text":"lezindlebe zalabo abezwayo zizalalela.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ingqondo yowalazelayo izakwazi, iqedisise,","poem":1},{"text":"ogagasayo ulimi lwakhe luzatshwaphuluka luzwakale kuhle.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isithutha kasisayikuthiwa ngumhlonitshwa,","poem":1},{"text":"lesigangi kasiyikuhlonitshwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngoba isithutha sikhuluma ubuwula,","poem":1},{"text":"ingqondo yaso isebenza ububi:","poem":2},{"text":"Senza imisebenzi yenkohlakalo,","poem":1},{"text":"siqambe amanga ngoThixo;","poem":2},{"text":"abalambayo kasibaniki lutho,","poem":1},{"text":"abomileyo sibancitsha amanzi okunatha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Izindlela zesigangi zimbi,","poem":1},{"text":"senza amacebo amabi","poem":2},{"text":"ukuba sichithe abayanga ngamanga,","poem":1},{"text":"lanxa isikhalazo sabaswelayo siqotho.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kodwa umuntu ohloniphekayo wenza amacebo ahloniphekayo,","poem":1},{"text":"njalo uma ngezenzo ezihloniphekayo.","poem":2}]},{"type":"heading","content":["Abesifazane BaseJerusalema"]},{"type":"verse","number":9,"content":[{"text":"Lina besifazane elingakhathazeki ngalutho,","poem":1},{"text":"vukani lilalele kimi;","poem":2},{"text":"lina madodakazi elizizwa livikelekile,","poem":1},{"text":"lalelani engikutshoyo!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngesikhatshana nje esedlula umnyaka","poem":1},{"text":"lina elizizwa livikelekile lizathuthumela;","poem":2},{"text":"ukuvunwa kwevini akuyikuphumelela,","poem":1},{"text":"lokuvunwa kwezithelo akuyikuba khona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Thuthumelani lina madodakazi azizwa evikelekile;","poem":1},{"text":"qhaqhazelani lina madodakazi azizwa evikelekile!","poem":2},{"text":"Khululani izigqoko zenu,","poem":1},{"text":"lithandele inkalo zenu ngamasaka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Zitshayeni izifuba zenu ngenxa yamasimu amahle,","poem":1},{"text":"langenxa yezivini ezithela izithelo,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"langenxa yelizwe labantu bami,","poem":1},{"text":"ilizwe eligcwele ukhula lameva,","poem":2},{"text":"yebo, lilelani zonke izindlu zenjabulo","poem":1},{"text":"ledolobho lokuzitika lentokozo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Inqaba enkulu izatshiswa,","poem":1},{"text":"idolobho elilomsindo lizatshiywa;","poem":2},{"text":"inqaba lomphotshongo wokulinda","poem":1},{"text":"kuzakuba ngumhlabathi ongatheli lutho kokuphela,","poem":2},{"lineBreak":true},{"text":"kube yintokozo yabobabhemi lamadlelo emihlambi,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"umoya uze uthelwe phezu kwethu uvela phezulu,","poem":1},{"text":"inkangala ibe ngumhlaba ovundileyo,","poem":2},{"lineBreak":true},{"text":"umhlaba ovundileyo ube njengenhlabathi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ukwahlulela kuhle kukaThixo kuzakuba khona enkangala,","poem":1},{"text":"ukulunga kube khona emhlabeni ovundileyo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Izithelo zokulunga zizakuba yikuthula;","poem":1},{"text":"okufaneleyo kuzaletha ukuthula zwi lethemba kuze kube nininini.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Abantu bami bazahlala ezindaweni ezilokuthula,","poem":1},{"text":"emakhaya avikelekileyo,","poem":2},{"lineBreak":true},{"text":"ezindaweni zokuphumula ezingelahlupho.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Lanxa isiqhotho sitshabalalisa ihlathi","poem":1},{"text":"ledolobho lidilizwe laphela nya,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"yeka ukubusiswa elizakuba yikho,","poem":1},{"text":"lihlanyela inhlanyelo yenu emaceleni ezifula zonke,","poem":2},{"lineBreak":true},{"text":"njalo liyekela inkomo zenu labobabhemi benu ukuba kusabalale.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}