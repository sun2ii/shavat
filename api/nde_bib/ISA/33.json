{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":33,"content":[{"type":"heading","content":["Usizi Losizo"]},{"type":"verse","number":1,"content":[{"text":"Maye kuwe, wena mchithi,","poem":1},{"text":"wena ongachithwanga!","poem":2},{"text":"Maye kuwe, wena mthengisi,","poem":1},{"text":"wena ongacetshwanga!","poem":2},{"text":"Lapho uyekela ukuthengisa,","poem":1},{"text":"lawe uzacetshwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Awu Thixo, woba lomusa kithi;","poem":1},{"text":"siyakulangazelela.","poem":2},{"text":"Woba ngamandla ethu ekuseni konke,","poem":1},{"text":"ube yinsindiso yethu esikhathini sosizi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ekukhwazeni kwelizwi lakho, izizwe ziyabaleka;","poem":1},{"text":"lapho uphakama izizwe ziyahlakazeka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Elakuthumbayo, lina zizwe, kubuthwa sengangathi kuqoqwa yisikhongwane,","poem":1},{"text":"abantu beqela kukho njengomtshitshi wentethe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"UThixo uphakeme ngoba uhlala phezulu,","poem":1},{"text":"uzagcwalisa iZiyoni ngokufaneleyo langokulunga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Uzakuba yisisekelo esithembekileyo sesikhathi senu,","poem":1},{"text":"isiphala esigcwele usindiso, ukuhlakanipha lokwazi;","poem":2},{"lineBreak":true},{"text":"ukumesaba uThixo kuyisiqokoqela sokuzuza ingcebo le.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Khangelani, amaqhawe akibo ahlaba umkhosi emigwaqweni!","poem":1},{"text":"Izithunywa zokuthula ziyakhala kakhulu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Imigwaqo emikhulu ibetha umoya,","poem":1},{"text":"akulazihambi kuyo.","poem":2},{"text":"Isivumelwano sephulwe,","poem":1},{"text":"ofakazi baso beyisiwe,","poem":2},{"lineBreak":true},{"text":"kakho ohlonitshwayo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ilizwe liyalila njalo liyachitheka.","poem":1},{"text":"ILebhanoni iyangekile njalo iyabuna;","poem":2},{"text":"iSharoni injengenkangala,","poem":1},{"text":"iBhashani leKhameli akhithizwa amahlamvu awo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"UThixo uthi, “Khathesi sengizavuka,","poem":1},{"text":"khathesi sengizadunyiswa,","poem":2},{"lineBreak":true},{"text":"khathesi sengizaphakanyiswa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Liqukethe ngamakhoba,","poem":1},{"text":"lizale izibi;","poem":2},{"lineBreak":true},{"text":"umoya wenu eliwuphefumulayo ungumlilo oliqedayo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abantu bazatshiswa bafane lekalaga;","poem":1},{"text":"bazathungelwa ngomlilo njengamahlahla ameva aganyuliweyo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Lina elikhatshana, zwanini engikwenzileyo;","poem":1},{"text":"lina abaseduze, vumani amandla ami!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Izoni zaseZiyoni ziyathuthumela;","poem":1},{"text":"abangamesabiyo uNkulunkulu bayaqhaqhazela:","poem":2},{"text":"“Ngubani owakithi ongahlala lomlilo oqothulayo na?","poem":1},{"text":"Ngubani owakithi ongahlala lokutshisa okungapheliyo na?”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngulowo owenza okulungileyo,","poem":1},{"text":"ekhuluma okuqotho","poem":2},{"text":"oyalayo inzuzo yokuncindezelwa,","poem":1},{"text":"ale ukwamukela isivalamlomo,","poem":2},{"text":"owalayo ukulalela amaqhinga okubulala,","poem":1},{"text":"avale amehlo akhe ukuze angaboni okubi,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"lo nguye umuntu ozahlala ekuphakameni,","poem":1},{"text":"osiphephelo sakhe sizakuba yinqaba yasentabeni.","poem":2},{"text":"Uzalethelwa isinkwa sakhe,","poem":1},{"text":"lamanzi kayikuwaswela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Amehlo enu azayibona inkosi ebuhleni bayo,","poem":1},{"text":"abuke lelizwe elibanzi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ezingqondweni zenu lizakhumbula ukwesaba kwakuqala lithi:","poem":1},{"text":"“Ingaphi induna yezikhulu leyana?","poem":2},{"text":"Ungaphi owayethatha imali yemithelo?","poem":1},{"text":"Singaphi isikhulu esigcina imiphotshongo na?”","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Abantu labayana abaklolodayo kalisayikubabona futhi,","poem":1},{"text":"abantu labayana abolimi olungazwakaliyo,","poem":2},{"lineBreak":true},{"text":"abolimi olungaziwayo, olungaqondakaliyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Khangelani iZiyoni, idolobho lemikhosi yethu;","poem":1},{"text":"amehlo enu azabona iJerusalema","poem":2},{"lineBreak":true},{"text":"indawo yokuhlala elokuthula, ithente elingeke lisuswe;","poem":2},{"text":"izikhonkwane zalo kaziyikusitshunwa","poem":1},{"text":"lezintambo zalo kaziyikuqamuka.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Khonapho uThixo uzakuba ngolaMandla wethu.","poem":1},{"text":"Kuzafana lendawo elemifula ebanzi kanye lezifula.","poem":2},{"text":"Akukho mkhumbi wempi ozagwedlwa khona,","poem":1},{"text":"akukho mkhumbi olamandla ozahamba khona.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ngoba uThixo ungumahluleli wethu,","poem":1},{"text":"uThixo usinika imithetho,","poem":2},{"text":"uThixo yinkosi yethu;","poem":1},{"text":"nguye ozasikhulula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Izintambo zakho zeseyili ziyaxega.","poem":1},{"text":"Insika kayiqiniswanga;","poem":2},{"lineBreak":true},{"text":"iseyili kayivulekanga.","poem":2},{"text":"Lapho-ke impango enengi izakwabiwa","poem":1},{"text":"kuthi labaqhulayo labo bazazuza impango.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Akulamuntu ohlala eZiyoni ozakuthi, “Mina ngiyagula”;","poem":1},{"text":"labantu abahlala khona bazathethelelwa izono zabo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}