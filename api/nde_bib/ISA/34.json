{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":34,"content":[{"type":"heading","content":["Ukwahlulelwa Kwezizwe"]},{"type":"verse","number":1,"content":[{"text":"Sondelani lina zizwe, lilalele;","poem":1},{"text":"zwanini lina bantu!","poem":2},{"text":"Umhlaba kawulalele, lakho konke okukiwo,","poem":1},{"text":"umhlaba, lakho konke okuvela kuwo!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"UThixo uthukuthelele izizwe zonke,","poem":1},{"text":"ulaka lwakhe luphezu kwezitha zabo zonke.","poem":2},{"text":"Uzazibhubhisa ngokupheleleyo,","poem":1},{"text":"uzazinikela ekubulaweni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ababuleweyo bakibo bazaphoselwa ngaphandle,","poem":1},{"text":"izidumbu zabo zizanuka;","poem":2},{"lineBreak":true},{"text":"izintaba zizacwila egazini labo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zonke izinkanyezi zasemazulwini zizanyamalala,","poem":1},{"text":"umkhathi ugoqwe njengomqulu;","poem":2},{"text":"wonke amaxuku ezinkanyezi","poem":1},{"text":"azakuwa njengamahlamvu abunileyo evinini","poem":2},{"lineBreak":true},{"text":"lanjengomkhiwa oswabileyo usiwa esihlahleni somkhiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Inkemba yami isinathe yanela emazulwini;","poem":1},{"text":"khangelani yehlela phezu kwe-Edomi ukulahlulela,","poem":2},{"lineBreak":true},{"text":"abantu esengibabhubhise baphela.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inkemba kaThixo igxanyuzwe egazini,","poem":1},{"text":"igcwele amafutha","poem":2},{"text":"igazi lezimvu lelembuzi,","poem":1},{"text":"amafutha ezinso zenqama.","poem":2},{"text":"Ngoba uThixo ulomhlatshelo eBhozira","poem":1},{"text":"lokubulawa okukhulu kwezifuyo e-Edomi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inyathi zizakufa kanye lazo,","poem":1},{"text":"amathole azinkunzi kanye lenkunzi ezinkulu.","poem":2},{"text":"Ilizwe labo lizagcwala igazi,","poem":1},{"text":"umhlabathi uzakuba manzi ngamafutha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ngoba uThixo ulosuku lokuphindisela,","poem":1},{"text":"umnyaka wokujezisa, ukuqinisa injongo yeZiyoni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Izifula zase-Edomi zizaphendulwa zibe yingcino,","poem":1},{"text":"umhlabathi wakhona ube ngumlilo wesolufa,","poem":2},{"lineBreak":true},{"text":"ilizwe lakhona lizakuba yingcino etshayo!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Aliyikucitshwa ebusuku lemini;","poem":1},{"text":"intuthu yalo izathunqa kokuphela.","poem":2},{"text":"Lizakuba ngelichithiweyo","poem":1},{"text":"kusukela kusizukulwane kusiya kwesinye;","poem":2},{"lineBreak":true},{"text":"kakho ozadabula phakathi kwalo futhi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isikhova senkangala lomandukulo kuzakwakha kulo;","poem":1},{"text":"isikhova esikhulu lewabayi kuzakwakha izidleke zakho kulo.","poem":2},{"text":"UNkulunkulu uzakwelulela phezu kwe-Edomi","poem":1},{"text":"intambo yokulinganisa incithakalo","poem":2},{"lineBreak":true},{"text":"lentambo yokulinganisa ukutshabalala.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Izikhulu zalo kaziyikuba lalutho olungathiwa ngumbuso,","poem":1},{"text":"wonke amakhosana alo azanyamalala.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Izinqaba zalo zizagcwala ameva,","poem":1},{"text":"imbabazane lokhula kugcwale kuziphephelo zalo.","poem":2},{"text":"Lizakuba yindawo yamakhanka,","poem":1},{"text":"lomuzi wezikhova.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Izinyamazana zenkangala zizahlangana lezimpisi,","poem":1},{"text":"amagogo azakhalelana;","poem":2},{"text":"izidalwa zebusuku zizalala khona","poem":1},{"text":"zizifunele izindawo zokuphumula.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Isikhova sizakwakha isidleke khona sibekele amaqanda,","poem":1},{"text":"sizawachamisela, sifukamele abantwana baso","poem":2},{"lineBreak":true},{"text":"ngaphansi komthunzi wempiko zaso,","poem":2},{"text":"lemizwazwa izabuthana khonapho,","poem":1},{"text":"yilowo lalowo lomngane wawo.","poem":2}]},{"type":"verse","number":16,"content":["Khangelani encwadini kaThixo lifunde okuthi:",{"text":"Akukho lakunye kwalokhu okuzasweleka;","poem":1},{"text":"akukho okuzaswela umngane wakho.","poem":2},{"text":"Ngoba nguThixo onike umlayo,","poem":1},{"text":"loMoya wakhe uzazigoqela ndawonye.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Uzakwahlukanisela izabelo zakho;","poem":1},{"text":"isandla sakhe sizakwabela ngesilinganiso.","poem":2},{"text":"Isabelo sizakuba lilifa lakho kokuphela,","poem":1},{"text":"njalo sizahlala khona kusukela kusizukulwane kusiya kusizukulwane.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}