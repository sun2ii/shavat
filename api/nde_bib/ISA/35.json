{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":35,"content":[{"type":"heading","content":["Intokozo Yabahlengiweyo"]},{"type":"verse","number":1,"content":[{"text":"Inkangala lelizwe elomileyo kuzathokoza;","poem":1},{"text":"inkangala izajabula iqhakaze.","poem":2},{"text":"Njengeluba","poem":1}]},{"type":"verse","number":2,"content":[{"text":"izakhahlela,","poem":1},{"text":"ithokoze kakhulu, ihlabele isithi.","poem":2},{"text":"Inkazimulo yaseLebhanoni izanikezwa kuyo","poem":1},{"text":"ubuhle beKhameli leSharoni,","poem":2},{"text":"kuzabona inkazimulo kaThixo","poem":1},{"text":"lobukhosi bukaNkulunkulu wethu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Qinisani izandla ezibuthakathaka,","poem":1},{"text":"liqinise lamadolo axegayo;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"tshonini kulabo abalezinhliziyo ezilokwesaba lithi:","poem":1},{"text":"“Qinani, lingesabi;","poem":2},{"text":"uNkulunkulu wenu uzakuza,","poem":1},{"text":"uzakuza ezophindisela,","poem":2},{"text":"ajezise ngokulunga","poem":1},{"text":"uzakuza ukuba alikhulule.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lapho-ke amehlo eziphofu azavuleka,","poem":1},{"text":"lezindlebe zezacuthe zivuleke.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lapho-ke abaqhulayo bazakweqa njengempala,","poem":1},{"text":"izimungulu zihlabele ngokuthokoza.","poem":2},{"text":"Amanzi azampompoza ogwaduleni,","poem":1},{"text":"izifula zigeleze enkangala.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Itshebetshebe elitshisayo lizakuba yisiziba,","poem":1},{"text":"umhlabathi owomileyo ube yimithombo echaphaka amanzi.","poem":2},{"text":"Ezindaweni amakhanka ake ahlala kuzo,","poem":1},{"text":"utshani lemihlanga lebhuma kuzakhula khona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Njalo kuzakuba lomgwaqo omkhulu:","poem":1},{"text":"uzathiwa yiNdlela yobuNgcwele,","poem":2},{"lineBreak":true},{"text":"izakuba ngeyalabo abahamba ngokuqonda.","poem":2},{"text":"Abangcolileyo kabayikuhamba kuwo;","poem":1},{"text":"uzakuba ngowalabo abahamba kuleyoNdlela lezithutha","poem":2},{"lineBreak":true},{"text":"ezonayo kaziyikuhambahamba kuwo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akuyikuba lesilwane khona,","poem":1},{"text":"loba esinye isilo esilolaka; sivuke kuwo","poem":2},{"lineBreak":true},{"text":"kaziyikutholwa khona.","poem":2},{"text":"Kodwa abahlengiweyo yibo kuphela abazahamba lapho,","poem":1}]},{"type":"verse","number":10,"content":[{"text":"njalo labahlengiweyo bakaThixo bazabuyela.","poem":2},{"text":"Bazangena eZiyoni behlabelela,","poem":1},{"text":"intokozo engapheliyo izakuba ngumqhele emakhanda abo.","poem":2},{"text":"Bazakuba lokuthula lenjabulo,","poem":1},{"text":"usizi lokububula kuzaphela.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}