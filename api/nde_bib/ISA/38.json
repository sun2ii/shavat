{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":38,"content":[{"type":"heading","content":["Ukugula KukaHezekhiya"]},{"type":"verse","number":1,"content":["Ngalezonsuku uHezekhiya wagula eselengela ekufeni. Umphrofethi u-Isaya, indodana ka-Amozi waya kuye wathi, “Nanku okutshiwo nguThixo: Lungisa indlu yakho ngoba uzakufa, awuyikusila.”"]},{"type":"verse","number":2,"content":["UHezekhiya waphenduka wakhangela emdulini wakhuleka kuThixo esithi,"]},{"type":"verse","number":3,"content":["“Khumbula, Thixo, ukuthi ngihambe phambi kwakho ngokuthembeka langokuzinikela ngenhliziyo yami yonke, njalo ngenze okuhle emehlweni akho.” UHezekhiya wakhala kabuhlungu."]},{"type":"verse","number":4,"content":["Emva kwalokho kwafika ilizwi likaThixo ku-Isaya lisithi:"]},{"type":"verse","number":5,"content":["“Yana kuHezekhiya uthi kuye, ‘Nanku okutshiwo nguThixo, uNkulunkulu kayihlo uDavida, uthi: Ngiwuzwile umkhuleko wakho, njalo ngizibonile lezinyembezi zakho. Ngizakwengezelela iminyaka elitshumi lanhlanu ekuphileni kwakho."]},{"type":"verse","number":6,"content":["Njalo ngizakukhulula wena, kanye ledolobho leli ezandleni zenkosi yase-Asiriya. Ngizavikela idolobho leli."]},{"type":"verse","number":7,"content":["Lesi yisibonakaliso sikaThixo kuwe sokuthi uThixo uzakwenza njengokuthembisa kwakhe:"]},{"type":"verse","number":8,"content":["Ngizakwenza umthunzi obangelwe lilanga ubuyele emuva amanyathelo alitshumi umthunzi owehle ngawo emakhwelelweni ka-Ahazi.’ ” Ngakho ukukhanya kwelanga kwabuyela emuva ngamanyathela alitshumi elaselikhothame ngawo."]},{"type":"line_break"},{"type":"verse","number":9,"content":["La ngamazwi alotshwa nguHezekhiya inkosi yakoJuda emva kokuba esesilile ekuguleni kwakhe:"]},{"type":"verse","number":10,"content":[{"text":"Ngathi, “Ebuhleni bokuphila kwami","poem":1},{"text":"kumele ngedlule emasangweni okufa","poem":2},{"lineBreak":true},{"text":"ngamukwe iminyaka yami eseleyo na?”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngathi, “Angiyikumbona futhi uThixo ngokwakhe","poem":1},{"text":"elizweni labaphilayo;","poem":2},{"text":"angisayikubabona futhi abantu bakithi","poem":1},{"text":"loba ngibe lalabo abahlala kulumhlaba.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Njengethente lomelusi indlu yami","poem":1},{"text":"idiliziwe ngayithathelwa.","poem":2},{"text":"Njengomaluki impilo yami ngiyigoqile,","poem":1},{"text":"ungisusile osungulweni;","poem":2},{"lineBreak":true},{"text":"emini lebusuku ungenze ngaphela.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngalinda ngokubekezela kwaze kwasa,","poem":1},{"text":"kodwa amathambo ami uwephule wonke njengesilwane;","poem":2},{"lineBreak":true},{"text":"emini lebusuku ungenze ngaphela.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngakhala njengenkonjane kumbe ihemu,","poem":1},{"text":"ngabubula njengejuba elililayo.","poem":2},{"text":"Amehlo ami afiphele ngokukhangela phezulu.","poem":1},{"text":"Awu Thixo, ngikhathazekile, woza ungisize!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kodwa ngingathini na?","poem":1},{"text":"Ukhulumile kimi, wena ngokwakho ukwenzile lokhu.","poem":2},{"text":"Ngizahamba ngokuzithoba ekuphileni kwami konke","poem":1},{"text":"ngenxa yobuhlungu bomoya wami.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Thixo, abantu baphila ngezinto ezinje;","poem":1},{"text":"lomoya wami uthola ukuphila kuzo.","poem":2},{"text":"Wangibuyisela empilweni","poem":1},{"text":"wangenza ngaphila.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngeqiniso kwaba lusizo kimi","poem":1},{"text":"ukuzwa ubuhlungu obungaka.","poem":2},{"text":"Ngothando lwakho wangivikela","poem":1},{"text":"emgodini wokutshabalaliswa;","poem":2},{"text":"izono zami zonke","poem":1},{"text":"uzibeke ngemva kwakho.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngoba ingcwaba alingeke likubonge","poem":1},{"text":"lokufa akungeke kukudumise;","poem":2},{"text":"labo abangena emgodini","poem":1},{"text":"abangeke bathemba ubuqotho bakho.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Abaphilayo, ngempela abaphilayo, bayakudumisa","poem":1},{"text":"njengalokhu engikwenzayo lamuhla;","poem":2},{"text":"abazali batshela abantwababo","poem":1},{"text":"ngobuqotho bakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"UThixo uzangisindisa;","poem":1},{"text":"njalo sizahlabelela ngamachacho","poem":2},{"text":"kuzozonke insuku zokuphila kwethu","poem":1},{"text":"ethempelini likaThixo.","poem":2}]},{"type":"verse","number":21,"content":["U-Isaya wayethe, “Lungisani isigaqa semikhiwa usifake phezu kwethumba, uzasila.”"]},{"type":"verse","number":22,"content":["UHezekhiya wayebuze wathi, “Kuyini okuzakuba yisibonakaliso sokuthi ngizakhwela ngiye phezulu ethempelini likaThixo na?”"]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}