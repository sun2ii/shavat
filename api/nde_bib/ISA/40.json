{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":40,"content":[{"type":"heading","content":["Induduzo Ebantwini BakaNkulunkulu"]},{"type":"verse","number":1,"content":[{"text":"Duduzani, libaduduze abantu bami,","poem":1},{"text":"kutsho uNkulunkulu wenu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Khulumani ngomusa kulo iJerusalema,","poem":1},{"text":"limemezele kulo","poem":2},{"text":"ukuthi ukusebenza kwalo nzima sekuphelile,","poem":1},{"text":"ukuthi isono salo sihlawulwe,","poem":2},{"text":"ukuthi selamukele okuvela esandleni sikaThixo","poem":1},{"text":"kuphindwe kabili kuzozonke izono zalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ilizwi lomemezayo lithi:","poem":1},{"lineBreak":true},{"text":"“Enkangala lungiselani","poem":1},{"text":"uThixo indlela,","poem":2},{"text":"lenzele uNkulunkulu wethu","poem":1},{"text":"umgwaqo oqondileyo enkangala.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zonke izigodi zizaphakanyiswa,","poem":1},{"text":"izintaba zonke lamaqaqa kuzakwehliselwa phansi.","poem":2},{"text":"Umhlabathi ongamakhilikithi uzakwendlaleka,","poem":1},{"text":"izindawo ezimadundulu zizakuba yisigcawu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inkazimulo kaThixo izabonakaliswa,","poem":1},{"text":"abantu bonke bazambona kanyekanye,","poem":2},{"text":"ngoba umlomo kaThixo usukhulumile.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ilizwi lithi, “Memeza!”","poem":1},{"text":"Mina ngathi, “Ngimemeze ngisithini na?”","poem":2},{"lineBreak":true},{"text":"“Abantu bonke banjengotshani","poem":1},{"text":"njalo ubuhle babo bunjengamaluba eganga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Utshani buyabuna amaluba ayakhithika,","poem":1},{"text":"ngoba umoya kaThixo uyakuphephetha.","poem":2},{"lineBreak":true},{"text":"Ngempela abantu babutshani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Utshani buyabuna, amaluba ayakhithika,","poem":1},{"text":"kodwa ilizwi likaNkulunkulu limi kuze kube nininini.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wena oletha izindaba ezinhle eZiyoni,","poem":1},{"text":"khwela entabeni ende.","poem":2},{"text":"Wena oletha izindaba ezinhle eJerusalema,","poem":1},{"text":"phakamisa ilizwi lakho ngokumemeza;","poem":2},{"text":"liphakamise, ungesabi,","poem":1},{"text":"tshono emadolobheni akoJuda uthi:","poem":2},{"lineBreak":true},{"text":"“Nangu uNkulunkulu wenu!”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Khangelani, uThixo Wobukhosi uza elamandla,","poem":1},{"text":"isandla sakhe sizabusa.","poem":2},{"text":"Khangelani, umvuzo wakhe ulawo,","poem":1},{"text":"lenhlawulo yakhe uhamba elayo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Welusa umhlambi wakhe njengomelusi:","poem":1},{"text":"ubuthelela amawundlu ezingalweni zakhe","poem":2},{"text":"awathwale eseduzane lenhliziyo yakhe;","poem":1},{"text":"awakhokhele kuhle lawo alamazinyane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ngubani olinganise amanzi entendeni yesandla sakhe,","poem":1},{"text":"loba walinganisa amazulu ngobubanzi besandla sakhe na?","poem":2},{"text":"Ngubani owaphatha uthuli lomhlabathi ngesitsha","poem":1},{"text":"loba walinganisa izintaba ezilinganisweni","poem":2},{"lineBreak":true},{"text":"lamaqaqa esikalini na?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngubani osewazwisisa imicabango kaThixo,","poem":1},{"text":"kumbe wamfundisa njengomeluleki wakhe na?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngubani owake wacelwa nguThixo ukuba ameluleke,","poem":1},{"text":"njalo ngubani owamfundisa indlela elungileyo na?","poem":2},{"text":"Ngubani lowo owamfundisa ukwazi,","poem":1},{"text":"loba owamtshengisa indlela yokuqedisisa na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ngeqiniso izizwe zinjengethonsi emgqonyeni;","poem":1},{"text":"zibalwa njengothuli ezilinganisweni;","poem":2},{"text":"uThixo ulinganisa izihlenge","poem":1},{"text":"angathi ziluthuli olucolekileyo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ILebhanoni kalaneli imililo ye-alithare,","poem":1},{"text":"lezinyamazana zalo kazaneli iminikelo yokutshiswa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Phambi kwakhe zonke izizwe zinjengeze;","poem":1},{"text":"yena uzikhangela njengento engasi yalutho","poem":2},{"lineBreak":true},{"text":"njalo zingaphansi kweze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Pho ngubani elingamfanisa loNkulunkulu na?","poem":1},{"text":"Yisifanekiso bani elingasilinganisa laye na?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Isithombe sibunjwa yingcwethi,","poem":1},{"text":"umkhandi wegolide asinameke ngegolide","poem":2},{"lineBreak":true},{"text":"asenzele imigaxo yesiliva.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Umuntu ongumyanga onganelisiyo ukunikela ngomnikelo onjalo","poem":1},{"text":"ukhetha isigodo esingaboliyo.","poem":2},{"text":"Udinga ingcitshi elolwazi","poem":1},{"text":"ukuba imise isithombe esingayikubhidlika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kalazi yini?","poem":1},{"text":"Kalizwanga na?","poem":2},{"text":"Kalikutshelwanga kwasekuqaleni na?","poem":1},{"text":"Kalizwisisanga na selokhu umhlaba wadalwayo?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"UThixo uhlezi ebukhosini ngaphezu kwendingiliza yomhlaba,","poem":1},{"text":"njalo abantu bakhe banjengezintethe.","poem":2},{"text":"Welula amazulu njengekhetheni,","poem":1},{"text":"awendlale njengethente lokuhlala kulo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Udiliza amakhosana,","poem":1},{"text":"enze ababusi bomhlaba lo babe yize.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Banele ukugxunyekwa nje,","poem":1},{"text":"banele ukuhlanyelwa nje,","poem":2},{"lineBreak":true},{"text":"banele ukugxila impande emhlabathini","poem":2},{"text":"abe ephephetha phezu kwabo, babune,","poem":1},{"text":"isavunguzane sibakhukhulele khatshana njengamakhoba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Ngubani elizangilinganisa laye na?","poem":1},{"text":"Loba ngubani olingana lami na?” kutsho yena oNgcwele.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Phakamisani amehlo enu likhangele phezulu:","poem":1},{"text":"Ngubani owadala konke lokhu na?","poem":2},{"text":"Yena okhupha amaxuku ezinkanyezi ngalinye ngalinye,","poem":1},{"text":"awabize ngalinye ngamabizo awo.","poem":2},{"text":"Ngenxa yamandla akhe amakhulu lokuqina okulamandla,","poem":1},{"text":"akukho lalinye elingekho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Kungani usithi, we Jakhobe,","poem":1},{"text":"usole usithi, we Israyeli,","poem":2},{"text":"“Indlela yami ifihlakele Thixo;","poem":1},{"text":"ilungelo lami kalinanzwa nguNkulunkulu wami na?”","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kalazi yini?","poem":1},{"text":"Kalizwanga na?","poem":2},{"text":"UThixo unguNkulunkulu waphakade,","poem":1},{"text":"uMdali wemikhawulo yomhlaba.","poem":2},{"text":"Kayikudinwa kumbe akhathale,","poem":1},{"text":"ukuqedisisa kwakhe kakho ongakulinganisa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Abakhatheleyo uyabanika amandla,","poem":1},{"text":"andise amandla ababuthakathaka.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Labatsha baphelelwa ngamandla bakhathale,","poem":1},{"text":"lamajaha ayakhubeka awe,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"kodwa labo abathemba uThixo","poem":1},{"text":"bazavuselelwa amandla abo.","poem":2},{"text":"Bazaqonga ngempiko njengezinkozi,","poem":1},{"text":"bazagijima kodwa bangadinwa,","poem":2},{"lineBreak":true},{"text":"bazahamba kodwa bangapheli amandla.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}