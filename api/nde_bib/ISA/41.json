{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":41,"content":[{"type":"heading","content":["Umsizi Ka-Israyeli"]},{"type":"verse","number":1,"content":[{"text":"“Thulani lithi zwi phambi kwami lina zihlenge!","poem":1},{"text":"Izizwe kazivuselele amandla azo!","poem":2},{"text":"Kazisondele phambili zikhulume;","poem":1},{"text":"kasihlanganeni sonke endaweni yokwahlulela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ngubani osevuse lowo ovela empumalanga,","poem":1},{"text":"embizela emsebenzini wakhe ngokulunga na?","poem":2},{"text":"Unikela izizwe kuye,","poem":1},{"text":"anqobe amakhosi phambi kwakhe.","poem":2},{"text":"Ngenkemba yakhe uwenza abe luthuli,","poem":1},{"text":"ngedandili lakhe awenze abe ngamakhoba aphetshulwa ngumoya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Uyawaxotsha yena adlule engathintwanga lutho,","poem":1},{"text":"endleleni angakaze ahambe ngayo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngubani owenze lokhu wakuphumelelisa,","poem":1},{"text":"ebiza izizukulwane kusukela ekuqaleni na?","poem":2},{"text":"Mina uThixo, kusukela kwesokuqala sazo","poem":1},{"text":"kanye lesokucina, nginguye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Izihlenge zikubonile njalo ziyesaba;","poem":1},{"text":"imikhawulo yomhlaba iyathuthumela,","poem":2},{"text":"iyasondela ize ngaphambili;","poem":1}]},{"type":"verse","number":6,"content":[{"text":"yilowo lalowo usiza omunye","poem":2},{"lineBreak":true},{"text":"athi kumfowabo, “Woba lesibindi!”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Umbazi ukhuthaza umkhandi wegolide,","poem":1},{"text":"lalowo ololonga ngesando","poem":2},{"lineBreak":true},{"text":"utshotshozela otshaya ihandila.","poem":2},{"text":"Mayelana lokunusela uthi, “Kulungile.”","poem":1},{"text":"Ubethelela isithombe phansi","poem":2},{"lineBreak":true},{"text":"ngezipikili ukuze singawi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Kodwa wena we Israyeli, nceku yami,","poem":1},{"text":"Jakhobe, wena engikukhethileyo,","poem":2},{"lineBreak":true},{"text":"wena nzalo ka-Abhrahama, umngane wami,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ngakuthatha emikhawulweni yomhlaba,","poem":1},{"text":"ngakubiza usemakhoneni akhatshana kakhulu.","poem":2},{"text":"Ngathi, ‘Wena uyinceku yami’;","poem":1},{"text":"ngikukhethile njalo angikulahlanga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngakho ungesabi, ngoba ngilawe;","poem":1},{"text":"ungakhathazeki, ngoba nginguNkulunkulu wakho.","poem":2},{"text":"Ngizakuqinisa, ngikusize;","poem":1},{"text":"ngizakusekela ngesandla sami sokudla esiqotho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bonke abakuthukutheleleyo,","poem":1},{"text":"ngoqotho bazayangeka babe lenhloni;","poem":2},{"text":"labo abakuphikisayo","poem":1},{"text":"bazakuba njengeze, babhubhe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lanxa izitha zakho uzidinga,","poem":1},{"text":"awuyikuzithola.","poem":2},{"text":"Labo abalwa impi lawe","poem":1},{"text":"bazakuba yize.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngoba mina nginguThixo uNkulunkulu wakho,","poem":1},{"text":"okubamba ngesandla sakho sokudla","poem":2},{"text":"athi kuwe: Ungesabi;","poem":1},{"text":"ngizakusiza.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ungesabi, wena mpethu enguJakhobe,","poem":1},{"text":"wena Israyeli omncinyazana, ungesabi,","poem":2},{"text":"ngoba mina ngokwami","poem":1},{"text":"ngizakusiza,” kutsho uThixo,","poem":2},{"lineBreak":true},{"text":"uMhlengi wakho, oNgcwele ka-Israyeli.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Khangela, ngizakwenza","poem":1},{"text":"ube yisileyi sokubhula esitsha","poem":2},{"lineBreak":true},{"text":"njalo esibukhali esilenhlendla ezinengi.","poem":2},{"text":"Uzabhula izintaba uzibhidlize.","poem":1},{"text":"Wenze amaqaqa abe ngamakhoba.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Uzawahlungula, umoya uwathathe,","poem":1},{"text":"isavunguzane siwaphephulele khatshana.","poem":2},{"text":"Kodwa wena uzathokoza kuThixo","poem":1},{"text":"njalo uzibule koNgcwele ka-Israyeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Abayanga labaswelayo badinga amanzi,","poem":1},{"text":"kodwa kawakho;","poem":2},{"lineBreak":true},{"text":"inlimi zabo sezitshile ngokoma.","poem":2},{"text":"Kodwa mina Thixo ngizabaphendula;","poem":1},{"text":"mina, Nkulunkulu ka-Israyeli, angiyikubalahla.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngizakwenza amanzi ageleze emiqolweni engelalutho","poem":1},{"text":"lemithombo phakathi kwezigodi.","poem":2},{"text":"Ngizaguqula inkangala ibe yiziziba zamanzi,","poem":1},{"text":"lomhlabathi owomileyo ube yimithombo yamanzi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Enkangala ngizamilisa khona","poem":1},{"text":"imisedari lemi-akhakhiya,","poem":2},{"lineBreak":true},{"text":"amamithili kanye lama-oliva.","poem":2},{"text":"Ogwaduleni ngizamisa izihlahla zamaphayini,","poem":1},{"text":"ndawonye lemifiri kanye lemisiphresi,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ukuze abantu babone njalo bazi,","poem":1},{"text":"bacabange bazwisise","poem":2},{"text":"ukuthi isandla sikaThixo yiso esenza lokhu,","poem":1},{"text":"lokuthi oNgcwele ka-Israyeli ukudalile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Bikani indaba yenu,”","poem":1},{"text":"kutsho uThixo.","poem":2},{"text":"“Bekani izizatho zenu,”","poem":1},{"text":"kutsho iNkosi kaJakhobe.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“Lethani izithombe zenu","poem":1},{"text":"zisitshele okuzakwenzakala.","poem":2},{"text":"Sitsheleni izinto zendulo ukuthi zaziyini","poem":1},{"text":"ukuze sizihlole,","poem":2},{"lineBreak":true},{"text":"sazi isiphetho sazo.","poem":2},{"text":"Loba sitsheleni izinto ezizayo,","poem":1}]},{"type":"verse","number":23,"content":[{"text":"lisazise okuqukethwe yizinsuku ezizayo,","poem":2},{"lineBreak":true},{"text":"ukuze sazi ukuthi lingonkulunkulu.","poem":2},{"text":"Yenzani okuthile, okuhle kumbe okubi,","poem":1},{"text":"ukuze sithuthumele, sibe lokwesaba.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kodwa lina liyize,","poem":1},{"text":"lemisebenzi yenu kayisilutho,","poem":2},{"lineBreak":true},{"text":"okhetha lina uyisinengiso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Sengithukuthelise omunye enyakatho, njalo uyeza","poem":1},{"text":"omunye ovela empumalanga obiza ibizo lami.","poem":2},{"text":"Lowo unyathela phezu kwababusi","poem":1},{"text":"kube sengathi baludaka,","poem":2},{"lineBreak":true},{"text":"kube angathi ngumbumbi evoxa ibumba.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ngubani owabika lokhu kwasekuqaleni,","poem":1},{"text":"ukuze sazi,","poem":2},{"text":"kumbe ngaphambilini","poem":1},{"text":"ukuze sithi, ‘Wayeqinisile na’?","poem":2},{"text":"Kakho owabika ngalokhu,","poem":1},{"text":"kakho owakutsho ngaphambilini,","poem":2},{"lineBreak":true},{"text":"kakho owake wezwa amazwi aphuma kuwe.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mina yimi engaba ngowokuqala","poem":1},{"text":"ukutshela iZiyoni ukuthi,","poem":2},{"lineBreak":true},{"text":"‘Khangela, nampa lapha!’","poem":2},{"text":"Nganika iJerusalema","poem":1},{"text":"isithunywa sezindaba ezinhle.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ngiyakhangela kodwa akulamuntu,","poem":1},{"text":"kakho phakathi kwabo onganika iseluleko,","poem":2},{"lineBreak":true},{"text":"kakho ongaphendula lapho ngibabuza.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Khangela, bonke bayize!","poem":1},{"text":"Izenzo zabo kazisilutho;","poem":2},{"text":"izithombe zabo ezibunjiweyo","poem":1},{"text":"zingumoya lensambatheka.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}