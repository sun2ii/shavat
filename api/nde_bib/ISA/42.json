{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":42,"content":[{"type":"heading","content":["Inceku KaThixo"]},{"type":"verse","number":1,"content":[{"text":"“Nansi inceku yami engiyisekelayo,","poem":1},{"text":"okhethiweyo wami, engithokoza ngaye.","poem":2},{"text":"Ngizabeka umoya wami phezu kwakhe,","poem":1},{"text":"uzaletha ukulunga ezizweni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kayikumemeza kumbe aklabalale,","poem":1},{"text":"loba aphakamise ilizwi lakhe emigwaqweni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Umhlanga ohluzukileyo akayikuwuquma,","poem":1},{"text":"lentambo yesibane etsha kancane akayikuyicima.","poem":2},{"text":"Ngokwethembeka uzaletha ukulunga;","poem":1}]},{"type":"verse","number":4,"content":[{"text":"akayikudinwa kumbe ephulwe inhliziyo","poem":2},{"text":"aze alethe ukulunga emhlabeni.","poem":1},{"text":"Izihlenge zizakwethemba umthetho wakhe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lokhu yikho okutshiwo nguNkulunkulu uThixo,","poem":1},{"lineBreak":true},{"text":"yena owadala amazulu wawelula,","poem":1},{"text":"yena owendlala umhlaba lakho konke okuphuma kuwo,","poem":2},{"lineBreak":true},{"text":"yena onika abantu abakuwo ukuphefumula,","poem":2},{"lineBreak":true},{"text":"kuthi abahamba kuwo abanike ukuphila:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Mina, uThixo ngikubizile ngokulunga;","poem":1},{"text":"ngizabamba isandla sakho.","poem":2},{"text":"Ngizakulondoloza","poem":1},{"text":"ngikwenze ube yisivumelwano sabantu","poem":2},{"lineBreak":true},{"text":"lokukhanya kwabeZizwe;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"uvule amehlo eziphofu,","poem":1},{"text":"ukhuphe abathunjiweyo entolongweni,","poem":2},{"lineBreak":true},{"text":"ubakhulule emigodini yezibotshwa labo abahlala emnyameni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mina nginguThixo, lelo yilo ibizo lami!","poem":1},{"text":"Ubukhosi bami angiyikubunika omunye","poem":2},{"lineBreak":true},{"text":"loba nginike izithombe udumo lwami.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Khangela, izinto zakuqala sezenzakele,","poem":1},{"text":"njalo ngimemezela izinto ezintsha;","poem":2},{"text":"zingakaveli ukuba zibe khona","poem":1},{"text":"ngiyakutshela ngazo.”","poem":2}]},{"type":"heading","content":["Ingoma Yokudumisa UThixo"]},{"type":"verse","number":10,"content":[{"text":"Hlabelelani uThixo ingoma entsha,","poem":1},{"text":"udumo lwakhe kusukela emikhawulweni yomhlaba,","poem":2},{"text":"lina eliya phansi olwandle, lakho konke okukulo,","poem":1},{"text":"lina zihlenge, labo bonke abahlala kini.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inkangala lamadolobho ayo kakuphakamise amazwi akho;","poem":1},{"text":"imizi uKhedari ahlala kuyo kayijabule.","poem":2},{"text":"Abantu baseSela kabahlabele ngentokozo;","poem":1},{"text":"kabaklabalale besezinqongweni zezintaba.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kabamdumise uThixo,","poem":1},{"text":"amemezele udumo lwakhe ezihlengeni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"UThixo uzaphuma njengendoda elamandla,","poem":1},{"text":"njengebutho uzavuthela ukutshiseka kwakhe;","poem":2},{"text":"ngokuklabalala uzakhuza isaga sempi","poem":1},{"text":"azinqobe izitha zakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Bengithule okwesikhathi eside kakhulu,","poem":1},{"text":"bengithule ngizithiba.","poem":2},{"text":"Kodwa khathesi, njengowesifazane ebeletha,","poem":1},{"text":"ngiyakhala, ngiyakhefuzela ngiphefuzela.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngizabhidliza izintaba lamaqaqa;","poem":1},{"text":"ngilomise lonke uhlaza lwabo;","poem":2},{"text":"ngizaphendula imifula ibe yizihlenge","poem":1},{"text":"ngomise lamachibi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngizakhokhela iziphofu ngezindlela ezingazaziyo,","poem":1},{"text":"ngizihole ngezindledlana ezingajwayelekanga.","poem":2},{"text":"Ngizaphendula umnyama ube yikukhanya phambi kwazo;","poem":1},{"text":"ngenze izindawo ezimakhilikithi zibe butshelezi.","poem":2},{"text":"Lezi yizo izinto engizazenza;","poem":1},{"text":"angiyikuziyekela.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kodwa labo abathemba izithombe,","poem":1},{"text":"abathi kuzifanekiso, ‘Lingonkulunkulu bethu,’","poem":2},{"lineBreak":true},{"text":"bazabuyiselwa emuva beyangeke impela.”","poem":2}]},{"type":"heading","content":["U-Israyeli Uyisiphofu Njalo Uyisacuthe"]},{"type":"verse","number":18,"content":[{"text":"“Zwanini, lina zacuthe;","poem":1},{"text":"khangelani, lina ziphofu, libone!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ngubani oyisiphofu ngaphandle kwenceku yami,","poem":1},{"text":"loyisacuthe njengesithunywa engisithumayo na?","poem":2},{"text":"Ngubani oyisiphofu njengalowo ozinikele kimi,","poem":1},{"text":"oyisiphofu njengenceku kaThixo na?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Selabona izinto ezinengi, kodwa kalinakanga;","poem":1},{"text":"indlebe zenu zivulekile, kodwa kalizwa lutho.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kwamthokozisa uThixo","poem":1},{"text":"ngenxa yokulunga kwakhe","poem":2},{"lineBreak":true},{"text":"ukuba akhulise umthetho wakhe ube mkhulu njalo ulodumo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kodwa laba ngabantu abaphangiweyo bathunjwa;","poem":1},{"text":"bonke bavalelwe emiwolweni,","poem":2},{"lineBreak":true},{"text":"loba bafihlwa ezintolongweni.","poem":2},{"text":"Sebenziwe baba yimpahla yokuthunjwa,","poem":1},{"text":"kungela ozabasindisa;","poem":2},{"text":"sebephendulwe baba yinto yokuthunjwa","poem":1},{"text":"kungekho othi, “Babuyiseleni emuva.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ngubani wenu olalela lokhu,","poem":1},{"text":"kumbe asinake isikhathi esizayo na?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ngubani owanikela uJakhobe ukuba abe yinto yokuthunjwa","poem":1},{"text":"wanikela lo-Israyeli kubaphangi na?","poem":2},{"text":"Kwakungasuye uThixo,","poem":1},{"text":"esamonelayo thina na?","poem":2},{"text":"Njengoba babengeke balandele izindlela zakhe;","poem":1},{"text":"kabalalelanga umthetho wakhe.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ngakho wathela ulaka lwakhe oluvuthayo phezu kwabo,","poem":1},{"text":"ukutshisa kwempi.","poem":2},{"text":"Wabamboza ngamalangabi, kodwa kabezwisisanga.","poem":1},{"text":"Wabaqothula, kodwa kabakhathalanga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}