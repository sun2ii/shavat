{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":43,"content":[{"type":"heading","content":["UMsindisi Yedwa Ka-Israyeli"]},{"type":"verse","number":1,"content":[{"text":"Kodwa khathesi, nanku akutshoyo uThixo uthi,","poem":1},{"text":"yena owakudalayo, wena Jakhobe,","poem":2},{"lineBreak":true},{"text":"yena owakubumbayo, wena Israyeli:","poem":2},{"text":"“Ungesabi, ngoba ngikuhlengile;","poem":1},{"text":"ngikubize ngebizo lakho; ungowami.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lapho udabula phakathi kwamanzi","poem":1},{"text":"ngizakuba lawe;","poem":2},{"text":"lalapho udabula emifuleni,","poem":1},{"text":"kayiyikukukhukhula.","poem":2},{"text":"Lapho uhamba phakathi komlilo, kawuyikutsha;","poem":1},{"text":"amalangabi kawayikukubhebhisa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngoba mina nginguThixo uNkulunkulu wakho,","poem":1},{"text":"oNgcwele ka-Israyeli, uMsindisi wakho.","poem":2},{"text":"Ngizanikela iGibhithe njengenhlawulo yakho,","poem":1},{"text":"iKhushi leSebha ime esikhundleni sakho.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Njengoba wena uligugu njalo udumile ebusweni bami,","poem":1},{"text":"futhi ngenxa yokuthi ngiyakuthanda,","poem":2},{"text":"ngizanikela abantu esikhundleni sakho,","poem":1},{"text":"labantu esikhundleni sempilo yakho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ungesabi, ngoba ngilawe;","poem":1},{"text":"ngizakulethela inzalo yakho ivela empumalanga","poem":2},{"lineBreak":true},{"text":"ngikubuthe kusukela entshonalanga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngizakutsho kuyo inyakatho ngithi, ‘Bakhulule!’","poem":1},{"text":"Ngitsho kuyo iningizimu ngithi, ‘Ungabagodli.’","poem":2},{"text":"Buyisani amadodana ami","poem":1},{"text":"akude lamadodakazi ami asemikhawulweni yomhlaba,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"wonke umuntu obizwa ngebizo lami,","poem":1},{"text":"engamdalela udumo lwami,","poem":2},{"lineBreak":true},{"text":"engambumbayo, ngamenza.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Phumani lalabo abayiziphofu amehlo belawo,","poem":1},{"text":"abayizacuthe indlebe belazo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Izizwe zonke kaziqoqane ndawonye","poem":1},{"text":"labantu babuthane.","poem":2},{"text":"Nguphi wabo owaphrofitha lokhu","poem":1},{"text":"wamemezela kithi ngezinto zendulo?","poem":2},{"text":"Kabalethe ofakazi babo babonakalise ukuthi baqinisile,","poem":1},{"text":"ukuze abanye bezwe, batsho bathi, “Kuqotho.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"UThixo uthi, “Lina lingofakazi bami,","poem":1},{"text":"lenceku zami engizikhethileyo,","poem":2},{"text":"ukuze lazi, likholwe kimi,","poem":1},{"text":"njalo lizwisise ukuthi mina nginguye.","poem":2},{"text":"Ngaphambi kwami kakho unkulunkulu owake wabakhona,","poem":1},{"text":"njalo kakho ozakuba khona emva kwami.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mina, mina uqobo, nginguThixo,","poem":1},{"text":"ngaphandle kwami kakho omunye umsindisi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngivezile ngasindisa, ngamemezela, mina ngokwami,","poem":1},{"text":"hatshi unkulunkulu wezizweni ophakathi kwenu.","poem":2},{"text":"Lingofakazi bami, ngokuthi mina yimi uNkulunkulu”","poem":1},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"“Ye, kusukela ensukwini zasendulo nginguye.","poem":2},{"text":"Kakho ongakhulula esandleni sami.","poem":1},{"text":"Lapho ngisenza, ngubani ongakuguqula na?”","poem":2}]},{"type":"heading","content":["Umusa KaNkulunkulu Lokungathembeki Kuka-Israyeli"]},{"type":"verse","number":14,"content":[{"text":"Lokhu yikho okutshiwo nguThixo,","poem":1},{"text":"uMhlengi wenu, oNgcwele ka-Israyeli, uthi,","poem":2},{"text":"“Ngenxa yenu ngizathumela impi eBhabhiloni","poem":1},{"text":"ilethe bonke abaseBhabhiloni,","poem":2},{"lineBreak":true},{"text":"njengeziphepheli ngemikhumbi ababezigqaja ngayo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mina nginguThixo, oNgcwele wenu,","poem":1},{"text":"uMdali ka-Israyeli, iNkosi yenu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nanku akutshoyo uThixo,","poem":1},{"text":"yena owenza indlela olwandle","poem":2},{"lineBreak":true},{"text":"lomkhondo emanzini alamandla,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"yena owakhupha izinqola zempi lamabhiza,","poem":1},{"text":"ibutho, lamanye awokuliqinisa endawonye;","poem":2},{"text":"njalo lalala lapho, kalaze lavuka futhi;","poem":1},{"text":"licitshe, liqunywe njengentambo yesibane:","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Khohlwani izinto zamandulo,","poem":1},{"text":"linganakani ngosekwedlulayo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Khangelani, ngenza okutsha!","poem":1},{"text":"Khathesi kuyavela ngokuphangisa; kalikuboni na?","poem":2},{"text":"Ngenza indlela enkangala","poem":1},{"text":"lezifula ogwaduleni.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Izinyamazana zeganga ziyangidumisa;","poem":1},{"text":"amakhanka lezikhova,","poem":2},{"text":"ngoba ngenza kube lamanzi enkangala","poem":1},{"text":"lezifula ogwaduleni","poem":2},{"text":"ukuze nginathise abantu abakhethiweyo,","poem":1}]},{"type":"verse","number":21,"content":[{"text":"abantu engazenzela bona","poem":2},{"lineBreak":true},{"text":"ukuba bangidumise.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kodwa kawukhalazanga kimi wena Jakhobe,","poem":1},{"text":"kodwa ukhathele ngami wena Israyeli.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kawungilethelanga izimvu zomnikelo wokutshiswa,","poem":1},{"text":"kumbe wangidumisa ngemihlatshelo yakho.","poem":2},{"text":"Angikuhluphanga ngeminikelo yamabele","poem":1},{"text":"kumbe ngakudinisa ngokufuna impepha.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kawungithengelanga amakha ekhane anuka mnandi,","poem":1},{"text":"kumbe wangisuthisa ngamahwahwa emihlatshelo yakho.","poem":2},{"text":"Kodwa ungikhathazile ngezono zakho","poem":1},{"text":"njalo wangidinisa ngezinengiso zakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Mina, mina uqobo, nginguye owesula","poem":1},{"text":"iziphambeko zakho ngenxa yami,","poem":2},{"lineBreak":true},{"text":"ngingabe ngisazikhumbula futhi izono zakho.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ngikhumbuza ngesikhathi esedlulayo,","poem":1},{"text":"sibonisane ngaleyondaba","poem":2},{"lineBreak":true},{"text":"ulandise ngoba msulwa kwakho.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ukhokho wakho wokuqala wona;","poem":1},{"text":"labakhulumeli bakho bangihlamukela.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ngakho izikhulu zethempelini lakho ngizaziyangisa;","poem":1},{"text":"nginikele uJakhobe ekubhujisweni","poem":2},{"lineBreak":true},{"text":"lo-Israyeli ekweyisweni.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":28}