{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":44,"content":[{"type":"heading","content":["U-Israyeli Okhethiweyo"]},{"type":"verse","number":1,"content":[{"text":"“Kodwa khathesi lalela, wena Jakhobe,","poem":1},{"text":"nceku yami, Israyeli, engikukhethileyo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nanku akutshoyo uThixo,","poem":1},{"text":"yena owakwenzayo, owakubumba esiswini,","poem":2},{"lineBreak":true},{"text":"njalo yena ozakusiza, uthi:","poem":2},{"text":"Ungesabi, wena Jakhobe, nceku yami,","poem":1},{"text":"Jeshuruni engikukhethileyo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngoba ngizathela amanzi elizweni elomileyo,","poem":1},{"text":"lezifula emhlabathini owomileyo.","poem":2},{"text":"Ngizathela uMoya wami phezu kwenzalo yakho","poem":1},{"text":"lezibusiso zami phezu kwezizukulwane zakho.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zizahluma njengotshani emadlelweni,","poem":1},{"text":"lanjengeminyezane ezifuleni ezigelezayo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Omunye uzakuthi, ‘Mina ngingokaThixo’;","poem":1},{"text":"lomunye azibize ngebizo likaJakhobe;","poem":2},{"text":"omunye laye uzaloba esandleni sakhe ukuthi, ‘OkaThixo,’","poem":1},{"text":"azinike ibizo lika-Israyeli.”","poem":2}]},{"type":"heading","content":["UThixo Hatshi Izithombe"]},{"type":"verse","number":6,"content":[{"text":"“Nanku akutshoyo uThixo,","poem":1},{"text":"iNkosi loMhlengi ka-Israyeli, uThixo uSomandla:","poem":2},{"text":"Mina ngingowokuqala njalo ngingowokucina;","poem":1},{"text":"ngaphandle kwami kakho uNkulunkulu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pho ngubani onjengami? Kakumemezele lokho.","poem":1},{"text":"Katsho, achaze phambi kwami","poem":2},{"text":"okwenzakalayo kusukela ekubekeni kwami abantu bami bendulo;","poem":1},{"text":"akutsho lokuzakwenzakala;","poem":2},{"lineBreak":true},{"text":"yebo, kakuqambe okuzayo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lingaqhaqhazeli, lingesabi.","poem":1},{"text":"Lokhu angikutshongo ngabika ngakho kudala na?","poem":2},{"text":"Lina lingofakazi bami. Kulomunye uNkulunkulu ngaphandle kwami na?","poem":1},{"text":"Hatshi, kalikho elinye iDwala; kalikho engilaziyo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bonke abenza izithombe kabasilutho,","poem":1},{"text":"lezinto abaziqakathekisayo ziyize.","poem":2},{"text":"Labo abangabakhulumela bayiziphofu,","poem":1},{"text":"kabazi lutho, kulihlazo kubo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngubani obaza unkulunkulu abumbe isithombe,","poem":1},{"text":"okungeke kumsize ngalutho?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yena labanjengaye bazayangiswa;","poem":1},{"text":"izingcitshi kazisilutho, ngabantu nje.","poem":2},{"text":"Kaziqoqane zonke zime ndawonye;","poem":1},{"text":"bazakuba lokwesaba kanye lehlazo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Umkhandi uthatha insimbi","poem":1},{"text":"ayifake emalahleni;","poem":2},{"text":"enze isithombe ngezando,","poem":1},{"text":"asikhande ngengalo yakhe elamandla.","poem":2},{"text":"Uyalamba aphelelwe ngamandla.","poem":1},{"text":"Anganathi manzi, amandla aphele.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Umbazi welula intambo yokulinganisa","poem":1},{"text":"asidwebe ngosungulo,","poem":2},{"text":"asibaze ngetshizela,","poem":1},{"text":"asidwebe ngensimbi ecijileyo,","poem":2},{"text":"abaze umfanekiso womuntu,","poem":1},{"text":"umuntu olobuhle bonke,","poem":2},{"lineBreak":true},{"text":"ukuba sihlale endlini yokukhonzela.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ugamula isihlahla somsedari,","poem":1},{"text":"loba athathe umsayiphresi kumbe umʼOkhi.","poem":2},{"text":"Uyasikhulisa phakathi kwezihlahla zegusu,","poem":1},{"text":"kumbe ahlanyele iphayini, izulu lisikhulise.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lapho-ke siba zinkuni zomuntu zokubasa;","poem":1},{"text":"okunye kwaso uyathatha othe,","poem":2},{"lineBreak":true},{"text":"ubasa umlilo abhekhe izinkwa.","poem":2},{"text":"Kodwa, njalo, wenza unkulunkulu amkhonze;","poem":1},{"text":"abaze isithombe asikhothamele.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ingxenye yezinkuni ubasa ngayo umlilo,","poem":1},{"text":"apheke ngawo ukudla kwakhe.","poem":2},{"lineBreak":true},{"text":"Ose inyama yakhe adle asuthe.","poem":2},{"text":"Njalo uyotha umlilo athi,","poem":1},{"text":"“Ha! Ngiyafudumala;","poem":2},{"lineBreak":true},{"text":"ngiyawubona umlilo.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngeziseleyo wenza unkulunkulu,","poem":1},{"text":"isithombe sakhe; uyasikhothamela, asikhonze.","poem":2},{"text":"Uyakhuleka kuso athi,","poem":1},{"text":"“Ngisindisa, ungunkulunkulu wami.”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kabazi lutho, kabaqedisisi lutho;","poem":1},{"text":"amehlo abo abhadiwe ukuze bangaboni","poem":2},{"lineBreak":true},{"text":"lezingqondo zabo zivalekile ukuze bangaqedisisi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kakho oke ame acabange,","poem":1},{"text":"kakho olokwazi loba ukuzwisisa ukuba athi,","poem":2},{"text":"“Ingxenye yazo ngabasa ngayo umlilo;","poem":1},{"text":"ngaze ngabhekha izinkwa emalahleni awo,","poem":2},{"lineBreak":true},{"text":"ngosa inyama ngayidla.","poem":2},{"text":"Ngokuseleyo ngizakwenza into enengisayo na?","poem":1},{"text":"Ngizasikhothamela na isigodo nje?”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Udla umlotha, inhliziyo ekhohlisekileyo iyamlahla,","poem":1},{"text":"angeke azihlenge, kumbe athi,","poem":2},{"lineBreak":true},{"text":"“Into le esesandleni sami sokudla kayisimanga na?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Khumbula lezizinto, wena Jakhobe,","poem":1},{"text":"ngoba uyinceku yami, wena Israyeli.","poem":2},{"text":"Ngakubumba, uyinceku yami;","poem":1},{"text":"wena Israyeli, angiyikukukhohlwa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ngesule iziphambeko zakho njengeyezi,","poem":1},{"text":"ngesula izono zakho njengenkungu yekuseni.","poem":2},{"text":"Buyela kimi,","poem":1},{"text":"ngoba ngikuhlengile.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Hlabelelani ngentokozo, lina mazulu,","poem":1},{"text":"ngoba uThixo usekwenzile lokhu;","poem":2},{"lineBreak":true},{"text":"hlaba umkhosi, wena mhlaba ngaphansi.","poem":2},{"text":"Tshayani ingoma lina zintaba,","poem":1},{"text":"lina mahlathi lazozonke izihlahla zenu,","poem":2},{"text":"ngoba uThixo usemhlengile uJakhobe,","poem":1},{"text":"ubonakalisa udumo lwakhe ko-Israyeli.","poem":2}]},{"type":"heading","content":["Kuzahlalwa EJerusalema"]},{"type":"verse","number":24,"content":[{"text":"“Nanku akutshoyo uThixo,","poem":1},{"text":"uMhlengi wakho, owakubumbayo esiswini:","poem":2},{"lineBreak":true},{"text":"Mina nginguThixo,","poem":1},{"text":"owenza izinto zonke,","poem":2},{"lineBreak":true},{"text":"owenza amazulu eyedwa,","poem":2},{"lineBreak":true},{"text":"owendlala umhlaba eyedwa,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ofubisa izibonakaliso zabaphrofethi bamanga,","poem":1},{"text":"enze izanuse zibe yizithutha,","poem":2},{"text":"ochitha ulwazi lwezihlakaniphi","poem":1},{"text":"alwenze lube yibuthutha,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ofeza amazwi ezinceku zakhe","poem":1},{"text":"aphelelise amacebo ezithunywa zakhe.","poem":2},{"lineBreak":true},{"text":"Athi kulo iJerusalema, ‘Kuzahlalwa kulo,’","poem":1},{"text":"ngamadolobho akoJuda athi, ‘Azakwakhiwa.’","poem":2},{"lineBreak":true},{"text":"Ngamanxiwa awo uthi, ‘Ngizawavusa,’","poem":2}]},{"type":"verse","number":27,"content":[{"text":"athi enzikini yamanzi, ‘Cima,","poem":1},{"text":"ngizakomisa izifula zakho,’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"athi ngoKhurosi, ‘Ungumelusi wami,","poem":1},{"text":"uzafeza konke engikufunayo;","poem":2},{"text":"uzakuthi ngeJerusalema, “Kalakhiwe futhi,”","poem":1},{"text":"ngethempeli athi, “Izisekelo zalo kazakhiwe.” ’ ”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/43.json","previousChapterAudioLinks":{},"numberOfVerses":28}