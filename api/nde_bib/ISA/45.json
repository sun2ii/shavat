{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":45,"content":[{"type":"verse","number":1,"content":[{"text":"“Nanku akutshoyo uThixo kogcotshiweyo wakhe,","poem":1},{"text":"uKhurosi, engibamba isandla sakhe sokudla","poem":2},{"text":"ukuba nginqobe izizwe eziphambi kwakhe,","poem":1},{"text":"ngithathele amakhosi izihlangu zawo,","poem":2},{"text":"ngivule iminyango phambi kwakhe","poem":1},{"text":"ukuze amasango angavaleki:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngizahamba phambi kwakho","poem":1},{"text":"ngenze izintaba zendlaleke.","poem":2},{"text":"Ngizadiliza amasango ethusi,","poem":1},{"text":"ngifohle emigoqweni yensimbi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngizakupha inotho yobumnyama,","poem":1},{"text":"lenotho egcinwe ezindaweni ezifihlakeleyo","poem":2},{"text":"ukuze wazi ukuthi mina nginguThixo,","poem":1},{"text":"uNkulunkulu ka-Israyeli, okubiza ngebizo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngenxa kaJakhobe inceku yami,","poem":1},{"text":"lo-Israyeli okhethiweyo wami,","poem":2},{"text":"ngikubiza ngebizo","poem":1},{"text":"ngikunike ibizo lokuhlonipha,","poem":2},{"lineBreak":true},{"text":"lanxa wena unganginakanga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mina nginguThixo, njalo kakho omunye;","poem":1},{"text":"ngaphandle kwami akulaNkulunkulu.","poem":2},{"text":"Ngizakuqinisa,","poem":1},{"text":"lanxa wena unganginakanga,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ukuze kuthi kusukela empumalanga","poem":1},{"text":"kusiya entshonalanga,","poem":2},{"text":"abantu bakwazi ukuthi kakho omunye ngaphandle kwami.","poem":1},{"text":"Mina nginguThixo, njalo kakho omunye.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngenza ukukhanya njalo ngidale umnyama,","poem":1},{"text":"ngiletha ukuphumelela njalo ngidale incithakalo;","poem":2},{"lineBreak":true},{"text":"mina Thixo ngiyazenza zonke lezizinto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lina mazulu angaphezulu, nisani ukulunga;","poem":1},{"text":"amayezi kawakuthululele phansi.","poem":2},{"text":"Umhlaba kawuvuleke kabanzi","poem":1},{"text":"kuhlume ukusindiswa,","poem":2},{"text":"ukulunga akukhule lakho;","poem":1},{"text":"mina, uThixo, ngikudalile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Maye kulowo ophikisa uMdali wakhe,","poem":1},{"text":"kulowo oludengezi nje","poem":2},{"lineBreak":true},{"text":"phakathi kwendengezi emhlabathini.","poem":2},{"text":"Ibumba liyatsho na kumbumbi lithi,","poem":1},{"text":"‘Kuyini okubumbayo?’","poem":2},{"text":"Umsebenzi wakho uyatsho na uthi,","poem":1},{"text":"‘Kalazandla?’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Maye kulowo othi kuyise,","poem":1},{"text":"‘Kuyini owakuzalayo?’","poem":2},{"text":"loba athi kunina,","poem":1},{"text":"‘Kuyini owakubelethayo?’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nanku okutshiwo nguThixo,","poem":1},{"text":"oNgcwele ka-Israyeli, loMdali wakhe uthi:","poem":2},{"text":"Mayelana lezinto ezizayo,","poem":1},{"text":"uyangibuza ngabatwabami na,","poem":2},{"lineBreak":true},{"text":"loba uyangilawula emsebenzini engiwenzayo na?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yimi engadala umhlaba,","poem":1},{"text":"ngenza labantu abahlala kuwo.","poem":2},{"text":"Ezami izandla yizo ezananabula amazulu;","poem":1},{"text":"ngahlela amaxuku ezinkanyezi zawo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngizamvusa uKhurosi ngokulunga kwami,","poem":1},{"text":"ngenze izindlela zakhe zonke ziqonde.","poem":2},{"text":"Uzalakha futhi idolobho lami,","poem":1},{"text":"akhulule abami abaxotshwayo elizweni,","poem":2},{"text":"kodwa kungekho nhlawulo kumbe umvuzo,","poem":1},{"text":"kutsho uThixo uSomandla.”","poem":2}]},{"type":"verse","number":14,"content":["Nanku akutshoyo uThixo:",{"text":"“Izithelo zaseGibhithe lempahla ethengiswayo yaseKhushi","poem":1},{"text":"lamaSebhina lawana amade,","poem":2},{"text":"bazakuza kuwe","poem":1},{"text":"babengabakho,","poem":2},{"text":"bazakhasabula ngemva kwakho,","poem":1},{"text":"beze kuwe bebotshwe ngamaketane.","poem":2},{"text":"Bazakukhothamela","poem":1},{"text":"bakuncenge besithi,","poem":2},{"text":"‘Ngempela uNkulunkulu ulawe, kakho omunye,","poem":1},{"text":"kakho omunye uNkulunkulu.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ngeqiniso unguNkulunkulu ozifihlayo,","poem":1},{"text":"Nkulunkulu loMsindisi ka-Israyeli.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bonke ababaza izithombe bazayangiswa badumazeke;","poem":1},{"text":"bonke bazahamba beyangekile.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kodwa u-Israyeli uzasindiswa nguThixo","poem":1},{"text":"ngensindiso engapheliyo;","poem":2},{"text":"kaliyikuyangiswa kumbe libe lehlazo","poem":1},{"text":"kuze kube nininini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ngoba nanku okutshiwo nguThixo","poem":1},{"lineBreak":true},{"text":"yena owadala amazulu,","poem":1},{"text":"unguNkulunkulu,","poem":2},{"text":"yena owabumba umhlaba wawenza,","poem":1},{"text":"wawusekela;","poem":2},{"text":"kawudalanga ukuba ungabi lalutho,","poem":1},{"text":"kodwa wawenza ukuba kuhlalwe kuwo,","poem":2},{"text":"uthi:","poem":1},{"lineBreak":true},{"text":"“Mina nginguThixo,","poem":1},{"text":"kakho omunye.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Angikhulumanga ensitha","poem":1},{"text":"kwenye indawo elizweni lomnyama;","poem":2},{"text":"angizange ngithi kuzizukulwane zikaJakhobe,","poem":1},{"text":"‘Ngidingani lingangitholi.’","poem":2},{"text":"Mina Thixo ngikhuluma iqiniso;","poem":1},{"text":"ngitsho okuqotho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Qoqanani ndawonye lize kimi;","poem":1},{"text":"buthanani lina elabaleka ezizweni.","poem":2},{"text":"Labo abahamba bethwele izithombe zezigodo kabazi lutho;","poem":1},{"text":"labo abakhuleka kubonkulunkulu abangeke babasize.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Memezelani okufanele kube yikho, likubike,","poem":1},{"text":"kabemukele izeluleko ndawonye.","poem":2},{"text":"Ngubani owabika lokhu endulo,","poem":1},{"text":"ngubani owamemezela ngakho kudala le?","poem":2},{"text":"Kwakungayisimi mina Thixo na?","poem":1},{"text":"Njalo kakho uNkulunkulu ngaphandle kwami,","poem":2},{"text":"uNkulunkulu olungileyo onguMsindisi;","poem":1},{"text":"kakho omunye, yimi kuphela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Phendukelani kimi lisindiswe,","poem":1},{"text":"lonke lina mikhawulo yomhlaba;","poem":2},{"text":"ngoba mina nginguNkulunkulu,","poem":1},{"text":"njalo kakho omunye.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ngifunge ngami,","poem":1},{"text":"ngobuqotho bonke","poem":2},{"lineBreak":true},{"text":"umlomo wami ukhulume ilizwi elingayikwesulwa.","poem":2},{"text":"Amadolo wonke azaguqa phambi kwami;","poem":1},{"text":"izindimi zonke zizafunga ngami.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Zizakutsho ngami zithi, ‘Ukulunga lamandla","poem":1},{"text":"kuThixo kuphela.’ ”","poem":2},{"text":"Bonke abamthukuthelelayo","poem":1},{"text":"bazakuza kuye bayangiswe.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kodwa Thixo yonke inzalo","poem":1},{"text":"ka-Israyeli izafunyanwa ilungile,","poem":2},{"lineBreak":true},{"text":"ithokoze iziqhenya ngaye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}