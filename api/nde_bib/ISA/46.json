nginguye ozaliqinisa.","poem":2},{"text":"Sengilenzile njalo ngizalithwala;","poem":1},{"text":"ngizaliqinisa ngilihlenge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ngubani elingangilinganisa laye kumbe limbale njengolingana lami na?","poem":1},{"text":"Ngubani elingangifananisa laye ukuba siqathaniswe na?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abanye bathulula igolide emigodleni yabo","poem":1},{"text":"balinganise isiliva ezikalini;","poem":2},{"text":"baqhatshe abakhandi begolide ukuba benze unkulunkulu ngalo,","poem":1},{"text":"bakhothame, bamkhonze.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bayamphakamisela emahlombe abo bamthwale;","poem":1},{"text":"bayambeka endaweni yakhe, ame khonapho.","poem":2},{"lineBreak":true},{"text":"Angeke asuke kuleyondawo.","poem":2},{"text":"Lanxa umuntu ememeza, kaphenduli;","poem":1},{"text":"angeke amsize ekuhluphekeni kwakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Khumbulani lokhu, likufake ezingqondweni zenu,","poem":1},{"text":"kukhumbuleni lina bahlamuki.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Khumbulani izinto zakuqala ezendulo.","poem":1},{"text":"Mina nginguNkulunkulu,","poem":2},{"text":"kakho omunye; mina nginguNkulunkulu,","poem":1},{"text":"kakho onjengami.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mina ngenza isiphetho sazakale","poem":1},{"text":"kusukela ekuqaleni lokuzakwenzakala,","poem":2},{"lineBreak":true},{"text":"kusukela ezikhathini zasendulo.","poem":2},{"text":"Ngithi: ‘Injongo yami izakuma kokuphela,","poem":1},{"text":"njalo ngizakwenza konke engikufunayo.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Empumalanga ngibiza inyoni edla ezinye;","poem":1},{"text":"elizweni elikhatshana ngibiza umuntu","poem":2},{"lineBreak":true},{"text":"ukuba afeze injongo yami.","poem":2},{"text":"Lokho engikutshiloyo ngizakufeza;","poem":1},{"text":"lokho engikucebileyo ngizakwenza.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngilalelani lina elilezinhliziyo ezilukhuni,","poem":1},{"text":"lina elikhatshana lokulunga.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngiletha ukulunga kwami eduzane,","poem":1},{"text":"akukho khatshana;","poem":2},{"lineBreak":true},{"text":"lokusindisa kwami akuyikuphuziswa.","poem":2},{"text":"IZiyoni ngizayinika ukusindiswa,","poem":1},{"text":"u-Israyeli inkazimulo yami.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}