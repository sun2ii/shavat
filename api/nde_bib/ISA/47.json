uSomandla libizo lakhe","poem":1},{"text":"ungoNgcwele ka-Israyeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Hlala ngokuthula, yana emnyameni,","poem":1},{"text":"ndodakazi yamaKhaladiya;","poem":2},{"text":"awuyikubizwa ngokuthi","poem":1},{"text":"ndlovukazi yemibuso futhi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngabathukuthelela abantu bami,","poem":1},{"text":"ngangcolisa ilifa lami,","poem":2},{"text":"ngabanikela ezandleni zakho,","poem":1},{"text":"kawaze waba lesihawu kubo.","poem":2},{"text":"Lasebeluphele,","poem":1},{"text":"wabethesa ijogwe elinzima.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wathi, ‘Ngizaqhubeka kokuphela","poem":1},{"text":"ngiyindlovukazi nini lanini.’","poem":2},{"text":"Kodwa kawuzinakanga lezizinto,","poem":1},{"text":"kumbe unakane ngokungenzakala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Khathesi-ke lalela, wena sidalwa esingazibekanga,","poem":1},{"text":"wena ocambaleleyo uvikelekile","poem":2},{"text":"usithi ngenhliziyo yakho,","poem":1},{"text":"‘Mina yimi, njalo kakho omunye ngaphandle kwami,","poem":2},{"text":"angisoze ngaba ngumfelokazi","poem":1},{"text":"kumbe ngifelwe ngabantwana.’","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kodwa lokhu kokubili kuzakwehlela","poem":1},{"text":"ngokuphangisa, ngasuku lunye","poem":2},{"lineBreak":true},{"text":"ukufelwa ngabantwana lobufelokazi.","poem":2},{"text":"Lokhu kuzakwehlela phezu kwakho ngokugcweleyo,","poem":1},{"text":"bungakhathelekile ubuthakathi bakho","poem":2},{"lineBreak":true},{"text":"layo yonke imilingo yakho elamandla.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wethembele ebubini bakho,","poem":1},{"text":"njalo watsho wathi, ‘Kakho ongibonayo.’","poem":2},{"text":"Inhlakanipho yakho lolwazi lwakho kuyakukhohlisa","poem":1},{"text":"lapho usithi kuwe,","poem":2},{"lineBreak":true},{"text":"‘Mina yimi, njalo kakho omunye ngaphandle kwami.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Incithakalo izakwehlela phezu kwakho,","poem":1},{"text":"njalo awuyikwazi ukuyivikela ngemilingo.","poem":2},{"text":"Umonakalo uzakwehlela phezu kwakho,","poem":1},{"text":"ongeke uwuvimbe ngenhlawulo,","poem":2},{"text":"lengozi ongeke uyikhumbulele","poem":1},{"text":"izakujuma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Qhubeka-ke ngemilingo yakho,","poem":1},{"text":"langobuthakathi bakho obunengi","poem":2},{"lineBreak":true},{"text":"okusebenza kusukela ebantwaneni bakho.","poem":2},{"text":"Mhlawumbe uzaphumelela,","poem":1},{"text":"kumbe njalo wenze kube lokwesaba.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Zonke izeluleko owazitholayo zikucobile.","poem":1},{"text":"Izazi zezinkanyezi kazisondele,","poem":2},{"text":"labahloli bezinkanyezi ababika ngokuzakwenzakala inyanga ngenyanga.","poem":1},{"text":"Kabakuhlenge kulokhu okuzakwehlela.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Impela banjengamahlanga;","poem":1},{"text":"umlilo uzabatshisa futhi","poem":2},{"text":"bangeke bazihlenga","poem":1},{"text":"emandleni amalangabi.","poem":2},{"text":"Lapha akulamalahle okothiwa ngumuntu;","poem":1},{"text":"lapha akulamlilo wokotha.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lokho yikho abangakwenzela khona","poem":1},{"text":"labo owasebenza labo,","poem":2},{"lineBreak":true},{"text":"uthengiselana labo kusukela ebuntwaneni.","poem":2},{"text":"Omunye lomunye wabo uyaqhubeka ngesiphosiso sakhe;","poem":1},{"text":"kakho ongakusindisa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}