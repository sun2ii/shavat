{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":48,"content":[{"type":"heading","content":["U-Israyeli Oyisiqholo"]},{"type":"verse","number":1,"content":[{"text":"“Zwana lokhu, wena ndlu kaJakhobe,","poem":1},{"text":"lina elibizwa ngebizo lika-Israyeli","poem":2},{"lineBreak":true},{"text":"elingabosendo lukaJuda,","poem":2},{"text":"lina elifunga ngoThixo,","poem":1},{"text":"licele usizo kuNkulunkulu ka-Israyeli,","poem":2},{"lineBreak":true},{"text":"kodwa kungasingeqiniso loba ngokulunga,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"lina elibizwa ngokuthi lingabasedolobheni elingcwele,","poem":1},{"text":"lethembe uNkulunkulu ka-Israyeli,","poem":2},{"lineBreak":true},{"text":"uThixo uSomandla yilo ibizo lakhe:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngamemezela ngezinto zakuqala endulo,","poem":1},{"text":"ngazitsho ngomlomo wami, ngazenza zazakala.","poem":2},{"lineBreak":true},{"text":"Ngazenza ngokuphangisa, zahle zenzakala.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngoba ngangikwazi ukuthi ulenkani,","poem":1},{"text":"imisipha yentamo yakho zinsimbi,","poem":2},{"lineBreak":true},{"text":"ibunzi lakho lithusi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngakho-ke ngakutsho kudala ngalezizinto,","poem":1},{"text":"ngakwazisa ngazo zingakenzakali","poem":2},{"text":"ukuze wena ungaze wathi,","poem":1},{"text":"‘Izithombe zami yizo ezazenzayo;","poem":2},{"lineBreak":true},{"text":"izithixo zami zezigodo lonkulunkulu wensimbi yibo abakumisayo.’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Usuzizwile lezizinto; zikhangele zonke.","poem":1},{"text":"Awuyikuzivuma na?","poem":2},{"lineBreak":true},{"text":"Kusukela khathesi ngizakutshela ngezinto ezintsha,","poem":1},{"text":"izinto ezifihlakeleyo wena ongazaziyo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Zidalwe khathesi nje, hatshi endulo;","poem":1},{"text":"awuzange uzwe ngazo mandulo.","poem":2},{"text":"Ngakho awungeke uthi,","poem":1},{"text":"‘Yebo, kade ngizazi.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kawuzange uzwe kumbe uqedisise;","poem":1},{"text":"kusukela endulo indlebe yakho ibingavulekanga.","poem":2},{"text":"Ngikwazi kuhle ukuthi wena uyingozi;","poem":1},{"text":"kwathiwa ungumhlamuki kusukela ekuzalweni kwakho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngenxa yebizo lami, ngiyaluphuzisa ulaka lwami;","poem":1},{"text":"ngenxa yodumo lwami ngiyalubamba ukuba lungehleli kuwe,","poem":2},{"lineBreak":true},{"text":"ukuze ngingakubhubhisi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Khangela, ngikulungisile lanxa kunganjengesiliva;","poem":1},{"text":"ngikuhlole emlilweni wokuhlupheka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngenxa yami, ngenxa yami, ngenza lokhu.","poem":1},{"text":"Ngingavuma njani ukuba ibizo lami ligconwe na?","poem":2},{"lineBreak":true},{"text":"Angiyikunika omunye udumo lwami.”","poem":2}]},{"type":"heading","content":["U-Israyeli Ukhululwe"]},{"type":"verse","number":12,"content":[{"text":"“Ngilalela wena Jakhobe,","poem":1},{"text":"Israyeli, engikubizileyo:","poem":2},{"text":"Mina nginguye;","poem":1},{"text":"ngingowokuqala njalo ngingowokucina.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Isandla sami sabeka izisekelo zomhlaba,","poem":1},{"text":"isandla sami sokudla sendlala amazulu;","poem":2},{"text":"lapho ngikubiza,","poem":1},{"text":"kuyasukuma konke kanyekanye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Buthanani ndawonye lonke lilalele:","poem":1},{"text":"Yisiphi sezithombe esamemezela ngalezizinto ngaphambilini na?","poem":2},{"text":"Umsekeli kaThixo okhethiweyo","poem":1},{"text":"uzafeza inhloso yakhe yokuhlasela amaKhaladiya;","poem":2},{"lineBreak":true},{"text":"ingalo yakhe izamelana lamaKhaladiya.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mina, mina ngokwami, sengikhulumile;","poem":1},{"text":"yebo ngimbizile.","poem":2},{"text":"Ngizamletha,","poem":1},{"text":"njalo uzaphumelela kuyo inhloso yakhe.","poem":2}]},{"type":"verse","number":16,"content":["Sondelani kimi lizwe lokhu:",{"text":"Kusukela esimemezelweni sakuqala angikhulumelanga ensitha;","poem":1},{"text":"lapho kusenzakala, mina ngikhona.”","poem":2},{"lineBreak":true},{"text":"Khathesi uThixo Wobukhosi ungithumile","poem":1},{"text":"ngoMoya wakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Nanku uThixo akutshoyo,","poem":1},{"text":"uMhlengi wakho, oNgcwele ka-Israyeli:","poem":2},{"text":"“Mina nginguThixo uNkulunkulu wakho,","poem":1},{"text":"okufundisa lokho okuhle kakhulu kuwe,","poem":2},{"lineBreak":true},{"text":"ekutshengisa indlela okumele uhambe ngayo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Aluba wawulalele imilayo yami nje,","poem":1},{"text":"ukuthula kwakho kwakuzakuba njengomfula,","poem":2},{"lineBreak":true},{"text":"ukulunga kwakho kunjengamagagasi olwandle.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Inzalo yakho yayizakuba ngangetshebetshebe,","poem":1},{"text":"abantwabakho babe ngangezinhlamvu zalo ezingeke zibalwe;","poem":2},{"text":"ibizo labo belingayikwesulwa","poem":1},{"text":"kumbe lidilizwe phambi kwami.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Sukani eBhabhiloni,","poem":1},{"text":"libalekele amaBhabhiloni!","poem":2},{"text":"Bikani lokhu lihlaba umkhosi ngentokozo","poem":1},{"text":"njalo likumemezele.","poem":2},{"text":"Kufikiseni emikhawulweni yomhlaba;","poem":1},{"text":"lithi, “UThixo uyihlengile inceku yakhe uJakhobe.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kabomanga ekubaholeni kwakhe bedabula ezinkangala;","poem":1},{"text":"wabenzela amanzi agelezayo ephuma edwaleni,","poem":2},{"text":"wadabula idwala","poem":1},{"text":"amanzi ampompoza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"UThixo uthi, “Akukho ukuthula kwababi.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/47.json","previousChapterAudioLinks":{},"numberOfVerses":22}