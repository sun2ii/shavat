{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":49,"content":[{"type":"heading","content":["Inceku KaThixo"]},{"type":"verse","number":1,"content":[{"text":"Ngilalelani lina zihlenge;","poem":1},{"text":"zwanini lokhu lina zizwe ezikude:","poem":2},{"text":"uThixo wangibiza ngingakazalwa;","poem":1},{"text":"kusukela ekuzalweni kwami ubelitsho ibizo lami.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wenza umlomo wami waba njengenkemba eloliweyo,","poem":1},{"text":"wangifihla emthunzini wesandla sakhe.","poem":2},{"text":"Wangenza ngaba ngumtshoko ololiweyo,","poem":1},{"text":"wangifihla emxhakeni wakhe wemitshoko.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wathi kimi, “Wena Israyeli uyinceku yami,","poem":1},{"text":"engizabonakalisa inkazimulo yami ngayo.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kodwa mina ngathi, “Mina ngisebenzele ize;","poem":1},{"text":"amandla ami ngiwachithele ize lobala,","poem":2},{"text":"ikanti okufanele mina kusesandleni sikaThixo,","poem":1},{"text":"lomvuzo wami ukuNkulunkulu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Khathesi uThixo uthi,","poem":1},{"text":"yena owangibumbayo esiswini ukuba ngibe yinceku yakhe","poem":2},{"text":"ukuze ngibuyisele uJakhobe","poem":1},{"text":"kuye lokuqoqela u-Israyeli kuye,","poem":2},{"text":"ngoba ngiphakanyisiwe emehlweni kaThixo","poem":1},{"text":"njalo uNkulunkulu wami ubengamandla ami","poem":2}]},{"type":"verse","number":6,"content":[{"text":"uthi:","poem":1},{"lineBreak":true},{"text":"“Kuyinto encane kakhulu kuwe ukuba yinceku yami","poem":1},{"text":"ukuze uvuselele izizwe zikaJakhobe","poem":2},{"lineBreak":true},{"text":"ubuyise labako-Israyeli engibalondolozileyo.","poem":2},{"text":"Ngizakwenza ube yikukhanya kwabeZizwe,","poem":1},{"text":"ukuze ufikise usindiso lwami emikhawulweni yomhlaba.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nanku okutshiwo nguThixo,","poem":1},{"text":"uMhlengi loNgcwele ka-Israyeli,","poem":2},{"text":"utsho kuye oweyiswa, wenyanywa yisizwe,","poem":1},{"text":"kuyo inceku yababusi:","poem":2},{"text":"“Amakhosi azakubona asukume,","poem":1},{"text":"amakhosana azakubona akhothame,","poem":2},{"text":"ngenxa kaThixo othembekileyo,","poem":1},{"text":"oNgcwele ka-Israyeli okukhethileyo.”","poem":2}]},{"type":"heading","content":["Ukubuyiselwa Kuka-Israyeli"]},{"type":"verse","number":8,"content":["Nanku okutshiwo nguThixo:",{"text":"“Ngesikhathi esifaneleyo kimi ngizakuphendula,","poem":1},{"text":"langosuku lwensindiso ngizakusiza.","poem":2},{"text":"Ngizakulondoloza ngikwenze","poem":1},{"text":"ube yisivumelwano sabantu,","poem":2},{"text":"ukubuyisela ilizwe","poem":1},{"text":"lokwaba kutsha amafa abo achithekayo,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"uthi kwabathunjiweyo, ‘Phumani,’","poem":1},{"text":"kulabo abasemnyameni uthi, ‘Khululekani!’","poem":2},{"lineBreak":true},{"text":"Bazadlela emaceleni emigwaqo","poem":1},{"text":"bathole amadlelo kuwo wonke amaqaqa alugwadule.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kabayikulamba kumbe bome,","poem":1},{"text":"lokutshisa kwasenkangala kumbe okwelanga kabayikukuzwa.","poem":2},{"text":"Lowo obazwela isihawu uzabakhokhela","poem":1},{"text":"abase emithonjeni yamanzi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Izintaba zami zonke ngizazenza zibe yizindlela,","poem":1},{"text":"imigwaqo yami izaphakamela phezulu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Khangelani, bazakuza bevela khatshana,","poem":1},{"text":"abanye bevela enyakatho, abanye bevela entshonalanga","poem":2},{"lineBreak":true},{"text":"labanye bevela emangweni wase-Asiwani.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Hlabelelani ngentokozo lina mazulu;","poem":1},{"text":"jabula lawe mhlaba;","poem":2},{"lineBreak":true},{"text":"tshayani ingoma lina zintaba.","poem":2},{"text":"Ngoba uThixo uyabaduduza abantu bakhe","poem":1},{"text":"njalo uzakuba lesihawu kwabahluphekayo bakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kodwa iZiyoni yathi, “UThixo ungilahlile,","poem":1},{"text":"uThixo usengikhohliwe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Owesifazane angamkhohlwa umntanakhe omunyayo na,","poem":1},{"text":"angabi lesihelo emntwaneni amzeleyo na?","poem":2},{"text":"Lanxa engamkhohlwa,","poem":1},{"text":"mina angiyikukukhohlwa!”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Khangela, sengikudwebe ezintendeni zezandla zami;","poem":1},{"text":"imiduli yakho ihlezi iphambi kwami.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Amadodana akho aphanga emuva,","poem":1},{"text":"lalabo abakuchithayo bayasuka kuwe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Phakamisa amehlo akho ukhangele emaceleni wonke,","poem":1},{"text":"wonke amadodana akho ayaqoqana eze kuwe.","poem":2},{"text":"UThixo uthi, “Ngeqiniso elinjengoba ngiphila,","poem":1},{"text":"bonke uzabagqiza njengezigqizo,","poem":2},{"lineBreak":true},{"text":"ucece ngabo njengomlobokazi.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Lanxa nje wadilizwa waba lunxiwa","poem":1},{"text":"lelizwe lakho lachithwa,","poem":2},{"text":"khathesi uzakuba mncane kakhulu ebantwini bakho;","poem":1},{"text":"lalabo abakuchithayo bazakuba khatshana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Abantwana abazalwa ngesikhathi sokufelwa kwakho","poem":1},{"text":"bazakutsho lawe usizwa bathi,","poem":2},{"text":"‘Indawo le incinyane kakhulu kithi;","poem":1},{"text":"siphe enye njalo indawo yokuhlala.’","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Lapho-ke uzakuthi enhliziyweni yakho,","poem":1},{"text":"‘Ngubani owangizalela laba na?","poem":2},{"text":"Ngafelwa njalo ngaba njengongazalanga;","poem":1},{"text":"ngaxotshwa elizweni, ngalahlwa.","poem":2},{"lineBreak":true},{"text":"Laba bondliwa ngubani?","poem":2},{"text":"Mina ngangisele ngedwa,","poem":1},{"text":"kodwa laba-ke, bavele ngaphi?’ ”","poem":2}]},{"type":"verse","number":22,"content":["Nanku okutshiwo nguThixo Wobukhosi:",{"text":"“Khangela, ngizaqhweba abeZizwe.","poem":1},{"text":"Ngizaphakamisela uphawu lwami ebantwini;","poem":2},{"text":"bazaletha amadodana akho bewagonile,","poem":1},{"text":"amadodakazi akho bewathwele ngamahlombe abo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Amakhosi azakuba ngoyihlo bokukukhulisa,","poem":1},{"text":"amakhosikazi awo abe ngonyoko bokukondla.","poem":2},{"text":"Bazakhothama phambi kwakho ubuso babo buphansi, emhlabathini,","poem":1},{"text":"bazakhotha uthuli ezinyaweni zakho.","poem":2},{"text":"Lapho-ke uzakwazi ukuthi mina nginguThixo;","poem":1},{"text":"labo abangithembayo abayikudaniswa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Amabutho angemukwa impango na,","poem":1},{"text":"kumbe abathunjiweyo bahlengwe kwabesabekayo na?","poem":2}]},{"type":"verse","number":25,"content":["Kodwa nanku okutshiwo nguThixo:",{"text":"“Yebo, abathunjiweyo bazathathwa emabuthweni","poem":1},{"text":"lempango izahluthunwa futhi kwabesabekayo,","poem":2},{"text":"ngoba ngizamelana lalabo abamelana lawe,","poem":1},{"text":"abantwabakho ngizabahlenga.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ngizakwenza abancindezeli bakho badle inyama yemizimba yabo;","poem":1},{"text":"bazadakwa ngelabo igazi njengewayini.","poem":2},{"text":"Lapho-ke izizwe zonke zizakwazi","poem":1},{"text":"ukuthi mina Thixo, nginguMsindisi wakho,","poem":2},{"lineBreak":true},{"text":"uMhlengi wakho, uMninimandla kaJakhobe.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/48.json","previousChapterAudioLinks":{},"numberOfVerses":26}