{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":5,"content":[{"type":"heading","content":["Ingoma Yesivini"]},{"type":"verse","number":1,"content":[{"text":"Ngizahlabelela lowo engimthandayo","poem":1},{"text":"ingoma ngesivini sakhe:","poem":2},{"text":"Othandwa yimi wayelesivini","poem":1},{"text":"eqaqeni oluvundileyo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wasigebha, wasusa amatshe kuso,","poem":1},{"text":"wahlanyela kuso amavini amahle.","poem":2},{"text":"Wakha umphotshongo ophakemeyo phakathi kwaso","poem":1},{"text":"njalo wagebha lesikhamelo sewayini kuso.","poem":2},{"text":"Walindela izithelo ezinhle,","poem":1},{"text":"kodwa amavini athela ezimbi kuphela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Manje-ke lina abahlala eJerusalema lani madoda akoJuda,","poem":1},{"text":"yahlulelani phakathi kwami lesivini sami.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kuyini okudlula lapho okwakumele kwenziwe esivinini sami","poem":1},{"text":"engingakwenzanga kuso na?","poem":2},{"text":"Lapho ngangilindele izithelo ezinhle","poem":1},{"text":"kungani sona sathela ezimbi kuphela na?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Khathesi-ke sengizalitshela","poem":1},{"text":"engizakwenza esivinini sami:","poem":2},{"text":"Ngizasusa uthango lwaso;","poem":1},{"text":"sizadilizwa.","poem":2},{"text":"Ngizabhidliza umduli waso,","poem":1},{"text":"sizagxotshwa ngezinyawo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngizasenza sibe liganga","poem":1},{"text":"kungabikho ukuthenwa kumbe ukuhlakulwa;","poem":2},{"lineBreak":true},{"text":"inkotha lameva kuzakhula kuso.","poem":2},{"text":"Ngizalaya amayezi","poem":1},{"text":"anganisi zulu kuso.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Isivini sikaThixo uSomandla","poem":1},{"text":"yindlu ka-Israyeli;","poem":2},{"text":"abantu bakoJuda","poem":1},{"text":"bayinsimu eligugu kuye.","poem":2},{"text":"Wayelindele okufaneleyo,","poem":1},{"text":"kodwa wabona ukuchitheka kwegazi;","poem":2},{"lineBreak":true},{"text":"endaweni yokulunga, wezwa ukukhala kosizi.","poem":2}]},{"type":"heading","content":["Izikhalazo Lezahlulelo"]},{"type":"verse","number":8,"content":[{"text":"Maye kini elengeza izindlu ngezindlu","poem":1},{"text":"lihlanganise insimu ensimini","poem":2},{"text":"kuze kusweleke indawo eseleyo,","poem":1},{"text":"njalo lihlala lodwa elizweni.","poem":2}]},{"type":"verse","number":9,"content":["UThixo uSomandla usetshilo ngisizwa wathi:",{"text":"“Ngeqiniso izindlu ezinengi zizakuba ngamanxiwa;","poem":1},{"text":"ezinkulu ezinhle zisale zingaselamuntu ohlala kuzo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Izindima ezilitshumi zesivini","poem":1},{"text":"zizathela ifatshi elilodwa lewayini,","poem":2},{"lineBreak":true},{"text":"ihomeri lenhlanyelo lithele ihefa lamabele.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Maye kulabo abavuka ngovivi ekuseni","poem":1},{"text":"begijimela ukunatha utshwala;","poem":2},{"text":"abaqhubekayo kuze kube phakathi kobusuku","poem":1},{"text":"baze badakwe butshwala.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Balamachacho lemihubhe emadilini abo,","poem":1},{"text":"amagedla, imihlanga, lewayini,","poem":2},{"text":"kodwa kabazinaki izenzo zikaThixo,","poem":1},{"text":"akukho nhlonipho yomsebenzi wezandla zakhe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngakho-ke abantu bami bazakuya ekuthunjweni","poem":1},{"text":"ngenxa yokungazwisisi;","poem":2},{"text":"izikhulu zabo zizabulawa yindlala","poem":1},{"text":"lenengi labo lizakoma ngomhawu wamanzi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngakho indawo yabafileyo izakwelula imihlathi yayo,","poem":1},{"text":"ikhamise umlomo wayo okungelamkhawulo;","poem":2},{"text":"izikhulu zabo lenengi labo bawele phakathi","poem":1},{"text":"labo bonke abaxokozelayo labazithokozisayo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Abantu bazakwehliselwa phansi,","poem":1},{"text":"abantu bazathobekiswa,","poem":2},{"lineBreak":true},{"text":"amehlo abaziphakamisayo athotshiswe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kodwa uThixo uSomandla uzaphakanyiswa","poem":1},{"text":"ngokwahlulela kwakhe okuhle;","poem":2},{"text":"ubungcwele bukaNkulunkulu","poem":1},{"text":"buzabonakala ngokulunga kwakhe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Lapho-ke izimvu zizakudla angathi kusemadlelweni azo,","poem":1},{"text":"amazinyane adle emanxiweni ezinothi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Maye kulabo abahudula isono ngentambo zenkohliso","poem":1},{"text":"lobubi kungathi kungamagoda enqola,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"kulabo abathi, “UNkulunkulu kaphangise,","poem":1},{"text":"kaphangisise umsebenzi wakhe","poem":2},{"lineBreak":true},{"text":"ukuze siwubone.","poem":2},{"text":"Kalisondele icebo loNgcwele ka-Israyeli","poem":1},{"text":"kalize ukuze silazi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Maye kulabo abathi okubi kuhle","poem":1},{"text":"bathi okuhle kubi,","poem":2},{"text":"ababeka umnyama esikhundleni sokukhanya;","poem":1},{"text":"ukukhanya esikhundleni somnyama;","poem":2},{"text":"ababeka okubabayo esikhundleni sokumnandi,","poem":1},{"text":"okumnandi esikhundleni sokubabayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Maye kulabo abahlakaniphileyo emehlweni abo","poem":1},{"text":"njalo besile ekuboneni kwabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Maye kulabo abangamaqhawe ekunatheni iwayini","poem":1},{"text":"njalo bezintshantshu ekuhlanganiseni okunathwayo,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"abakhulula abalamacala ngenxa yokufunjathiswa.","poem":1},{"text":"Kodwa banqabele abamsulwa imfanelo yabo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ngakho-ke, njengalokhu umlilo utshisa inhlanga,","poem":1},{"text":"utshani obomileyo buphelela phakathi kwamalangabi,","poem":2},{"lineBreak":true},{"text":"ngokunjalo impande zabo zizabola.","poem":2},{"text":"Lamaluba abo aphephuke njengothuli;","poem":1},{"text":"ngoba bawalile umthetho kaThixo uSomandla","poem":2},{"lineBreak":true},{"text":"balidelela ilizwi loNgcwele ka-Israyeli.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ngakho ulaka lukaThixo luzavutha ebantwini bakhe;","poem":1},{"text":"isandla sakhe siphakeme njalo uyabatshaya.","poem":2},{"text":"Izintaba ziyanyikinyeka,","poem":1},{"text":"izidumbu zabafileyo zinjengezibi ezindleleni.","poem":2},{"lineBreak":true},{"text":"Ikanti kukho konke lokhu ulaka lwakhe kaluphelanga,","poem":1},{"text":"isandla sakhe silokhu siphakanyisiwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Uphakamisela izizwe ezikude uphawu,","poem":1},{"text":"ubatshayela ikhwelo abasemaphethelweni omhlaba.","poem":2},{"text":"Nampa besiza","poem":1},{"text":"ngokuphangisa langejubane!","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kakho omunye wabo odinwayo loba okhubekayo,","poem":1},{"text":"kakho owozelayo kumbe olalayo,","poem":2},{"text":"akukho bhanti elixegiswayo ekhalweni,","poem":1},{"text":"akukho ntambo yenyathelo equmekileyo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Imitshoko yabo ibukhali,","poem":1},{"text":"wonke amadandili abo agotshisiwe;","poem":2},{"text":"amasondo amabhiza abo afana lelitshe elilukhuni,","poem":1},{"text":"amavili ezinqola zabo zokulwa anjengesivunguzane.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ukubhonga kwabo kufana lokwesilwane,","poem":1},{"text":"babhonga njengezilwane ezikhulayo,","poem":2},{"text":"bayabhavuma lapho bebamba inyamazana edliwayo,","poem":1},{"text":"babaleke layo kungekho ongabemuka.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ngalolosuku bazabhavumela phezu kwayo","poem":1},{"text":"njengokubhavuma kolwandle.","poem":2},{"text":"Njalo nxa umuntu ekhangela ilizwe,","poem":1},{"text":"uzabona umnyama losizi;","poem":2},{"lineBreak":true},{"text":"lelanga lizakwenziwa libe mnyama ngamayezi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/4.json","previousChapterAudioLinks":{},"numberOfVerses":30}