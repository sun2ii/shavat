{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":50,"content":[{"type":"heading","content":["Isono Sika-Israyeli Lokulalela Kwenceku"]},{"type":"verse","number":1,"content":["Nanku okutshiwo nguThixo:",{"text":"“Ingaphi incwadi kanyoko yokuchitha umtshado","poem":1},{"text":"engamxotsha ngayo na?","poem":2},{"text":"Kumbe nguphi kwababelezikwelede zami","poem":1},{"text":"engamthengisayo na?","poem":2},{"text":"Lathengiswa ngenxa yezono zenu,","poem":1},{"text":"lonyoko waliwa ngenxa yokona kwenu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ekufikeni kwami, kungani kwakungelamuntu na?","poem":1},{"text":"Ekubizeni kwami, kungani kungekho muntu owasabelayo na?","poem":2},{"text":"Ingalo yami yayimfitshane kakhulu ukuba ilihlenge na?","poem":1},{"text":"Angilamandla okulikhulula na?","poem":2},{"text":"Ngokukhuza nje kuphela, ngiyalomisa ulwandle,","poem":1},{"text":"ngiphendule imifula ibe yinkangala;","poem":2},{"text":"inhlanzi zayo zibole ngenxa yokuswela amanzi,","poem":1},{"text":"zife ngenxa yokoma.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngembathisa umkhathi ngomnyama.","poem":1},{"text":"Ngenze amasaka abe yisembeso sawo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"UThixo wobukhosi unginike ulimi olufundisiweyo","poem":1},{"text":"ukuba ngazi ilizwi lokuqinisa abadiniweyo.","poem":2},{"text":"Uyangivusa ekuseni kwansukuzonke,","poem":1},{"text":"avuse indlebe yami ukuba ilalele njengofundiswayo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"UThixo Wobukhosi uvule indlebe zami,","poem":1},{"text":"njalo angizange ngibe ngohlamukayo;","poem":2},{"lineBreak":true},{"text":"angibuyelanga emuva.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nganikela umhlana wami kulabo ababengitshaya,","poem":1},{"text":"lezihlathi zami kulabo abacutha indevu zami;","poem":2},{"text":"ubuso bami angibufihlanga","poem":1},{"text":"ekugconweni lekukhafulelweni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngenxa yokuthi uThixo Wobukhosi uyangisiza","poem":1},{"text":"angiyikuyangeka.","poem":2},{"text":"Ngakho-ke sengiqinise ubuso bami babanjengelitshe lomlilo;","poem":1},{"text":"njalo ngiyazi ukuthi angiyikuyangeka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lowo ongimelayo useduzane.","poem":1},{"text":"Ngubani-ke ongangethesa amacala?","poem":2},{"lineBreak":true},{"text":"Kasiqondane.","poem":2},{"text":"Ngubani ongimangalelayo na?","poem":1},{"text":"Kangiqonde!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"NguThixo Wobukhosi ongisizayo.","poem":1},{"text":"Ngubani lowo ongathi ngilecala na?","poem":2},{"text":"Bonke bazaguga njengesigqoko,","poem":1},{"text":"inondo izabadla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ngubani phakathi kwenu omesabayo uThixo","poem":1},{"text":"elalela ilizwi lenceku yakhe na?","poem":2},{"text":"Lowo ohamba emnyameni,","poem":1},{"text":"ongelakho ukukhanya,","poem":2},{"text":"kathembe ebizweni likaThixo","poem":1},{"text":"abambelele kuThixo wakhe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kodwa khathesi, lonke lina eliphemba imililo","poem":1},{"text":"lizenzele amalangabi okukhanyisa,","poem":2},{"text":"sukani, lihambe ekukhanyeni kwemililo yenu,","poem":1},{"text":"lokwezibane elizikhanyisileyo.","poem":2},{"text":"Elizakwamukela esandleni sami yilokhu:","poem":1},{"text":"Lizalala phansi lisebuhlungwini.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}