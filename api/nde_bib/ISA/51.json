{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":51,"content":[{"type":"heading","content":["Insindiso Engapheliyo YeZiyoni"]},{"type":"verse","number":1,"content":[{"text":"“Lalelani kimi lina elilandela ukulunga","poem":1},{"text":"lidinga loThixo:","poem":2},{"text":"Khangelani edwaleni elacezulwa kulo","poem":1},{"text":"lasegodini lamatshe elambiwa kulo;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"khangelani ku-Abhrahama, uyihlo,","poem":1},{"text":"lakuSara owalizalayo.","poem":2},{"text":"Ekumbizeni kwami wayemunye,","poem":1},{"text":"ngambusisa ngamandisa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngeqiniso uThixo uzaduduza iZiyoni","poem":1},{"text":"abe lesihawu kuwo wonke amanxiwa alo;","poem":2},{"text":"uzakwenza izinkangala zalo zibe njenge-Edeni,","poem":1},{"text":"amazwe alo alugwadule afane lesivande sikaThixo.","poem":2},{"text":"Ukuthaba lentokozo kuzafunyanwa kulo,","poem":1},{"text":"kanye lokubonga lelizwi lokuhlabela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lalelani kimi, bantu bami;","poem":1},{"text":"ungizwe lawe sizwe sami:","poem":2},{"text":"Kuzaphuma umthetho uvela kimi;","poem":1},{"text":"ukulunga kwami kuzakuba yikukhanya ezizweni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ukulunga kwami kusondela ngokuphangisa,","poem":1},{"text":"insindiso yami iyeza,","poem":2},{"lineBreak":true},{"text":"ingalo yami izaletha ukulunga ezizweni.","poem":2},{"text":"Izihlenge zizakhangela kimi,","poem":1},{"text":"zilinde zithembe amandla ami.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Phakamiselani amehlo enu phezulu emazulwini,","poem":1},{"text":"likhangele lasemhlabeni phansi;","poem":2},{"text":"amazulu azanyamalala njengentuthu;","poem":1},{"text":"umhlaba uzaguga njengesigqoko","poem":2},{"lineBreak":true},{"text":"abakhe kuwo bafe njengempukane.","poem":2},{"text":"Kodwa insindiso yami izakuba khona kuze kube nininini,","poem":1},{"text":"ukulunga kwami akuyikuphela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ngizwani lina elikwaziyo okulungileyo","poem":1},{"text":"lina bantu abagcina umthetho wami ezinhliziyweni zenu:","poem":2},{"text":"Lingakwesabi ukugconwa ngabantu,","poem":1},{"text":"kumbe lethuswe yizithuko zabo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngoba inondo izabadla njengesigqoko;","poem":1},{"text":"impethu ibadle njengewulu.","poem":2},{"text":"Kodwa ukulunga kwami kuzakuba khona kuze kube nininini;","poem":1},{"text":"lensindiso yami ikhona kuzizukulwane zonke.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Vuka, vuka, wena ngalo kaThixo;","poem":1},{"text":"uzigqokise ngamandla akho!","poem":2},{"text":"Vuka njengasezinsukwini zendulo,","poem":1},{"text":"lanjengakuzizukulwane zakudala.","poem":2},{"text":"Kayisuwe yini owaquma uRahabi waba yiziqa,","poem":1},{"text":"wagwaza lesilo lesiyana na?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kawusuwe yini owomisa ulwandle,","poem":1},{"text":"amanzi atshona kakhulu,","poem":2},{"text":"wenza umgwaqo ezinzikini zolwandle","poem":1},{"text":"ukuze abahlengiweyo bachaphe na?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Labahlengiweyo bakaThixo bazabuyela.","poem":1},{"text":"Bazangena eZiyoni behlabelela,","poem":2},{"lineBreak":true},{"text":"intokozo engapheliyo izakuba ngumqhele emakhanda abo.","poem":2},{"text":"Bazakuba lokuthula lenjabulo,","poem":1},{"text":"usizi lokububula kuzaphela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Mina, mina uqobo, nginguye oliduduzayo.","poem":1},{"text":"Ungubani wena ukuba wesabe abantu abafayo,","poem":2},{"lineBreak":true},{"text":"amadodana abantu, abutshani nje,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"uze ukhohlwe uThixo, uMenzi wakho,","poem":1},{"text":"owendlala amazulu","poem":2},{"lineBreak":true},{"text":"wabeka lezisekelo zomhlaba,","poem":2},{"text":"ukuthi uhlale ngokwesaba okungapheliyo nsuku zonke","poem":1},{"text":"ngenxa yolaka lomncindezeli,","poem":2},{"lineBreak":true},{"text":"ohlose ukuchitha na?","poem":2},{"text":"Ngoba lungaphi na ulaka lomncindezeli?","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Izibotshwa ezitshotshobeleyo zizakhululwa masinyazana,","poem":2},{"text":"aziyikufela emajele azo,","poem":1},{"text":"kumbe ziswele ukudla.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngoba mina nginguThixo uNkulunkulu wakho,","poem":1},{"text":"ophehla ulwandle ukuze amagagasi alo ahlokome,","poem":2},{"lineBreak":true},{"text":"ibizo lakhe nguThixo uSomandla.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngifake amazwi ami emlonyeni wakho","poem":1},{"text":"ngakwembesa ngomthunzi wesandla sami,","poem":2},{"text":"mina engabeka amazulu endaweni yawo,","poem":1},{"text":"ngabeka izisekelo zomhlaba,","poem":2},{"lineBreak":true},{"text":"njalo othi kuZiyoni, ‘Lina lingabantu bami.’ ”","poem":2}]},{"type":"heading","content":["Inkezo Yolaka LukaThixo"]},{"type":"verse","number":17,"content":[{"text":"Vuka, vuka!","poem":1},{"text":"Phakama wena Jerusalema,","poem":2},{"text":"wena onathe enkezweni esandleni sikaThixo","poem":1},{"text":"inkezo yolaka lwakhe,","poem":2},{"text":"wena oyikhoce wafika enzeceni zayo;","poem":1},{"text":"inkezo eyenza amadoda adiyazele.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kuwo wonke amadodana eliwazeleyo,","poem":1},{"text":"kayikho eyayingalikhokhela;","poem":2},{"text":"kuwo wonke amadodana elawondlayo,","poem":1},{"text":"kayikho eyayingalibamba ngesandla.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Lezizingozi ezimbili zikwehlele;","poem":1},{"text":"ngubani ongakududuza na?","poem":2},{"text":"Incithakalo lokubhujiswa, indlala lenkemba,","poem":1},{"text":"ngubani ongakududuza na?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Amadodana akho asephele amandla,","poem":1},{"text":"aselala ezihlokweni zemigwaqo yonke","poem":2},{"lineBreak":true},{"text":"njengebhalabhala elibanjwe ngumambule.","poem":2},{"text":"Agcwele ulaka lukaThixo","poem":1},{"text":"lokukhuza kukaNkulunkulu wakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ngakho-ke zwana lokhu wena ohluphekayo,","poem":1},{"text":"lodakisiweyo kodwa kungasingewayini.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nanku okutshiwo nguThixo Wobukhosi bakho,","poem":1},{"text":"uNkulunkulu wakho ovikela abantu bakhe:","poem":2},{"text":"“Khangela, sengiyisusile esandleni sakho","poem":1},{"text":"inkezo ekwenza udiyazele;","poem":2},{"text":"leyonkezo engeyolaka lwami,","poem":1},{"text":"awuyikunatha ngayo futhi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ngizayibeka ezandleni zabakuhluphayo,","poem":1},{"text":"abathi kuwe,","poem":2},{"lineBreak":true},{"text":"‘Cambalala ukuze sihambe phezu kwakho.’","poem":2},{"text":"Wena-ke wenza umhlane wakho waba njengenhlabathi,","poem":1},{"text":"lanjengomgwaqo okungahanjwa kuwo.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}