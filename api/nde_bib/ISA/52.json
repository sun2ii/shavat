{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"Vuka, vuka, wena Ziyoni,","poem":1},{"text":"uzembese ngamandla!","poem":2},{"text":"Gqoka izigqoko zakho zenkazimulo,","poem":1},{"text":"wena Jerusalema, muzi ongcwele.","poem":2},{"text":"Ongasokanga longcolileyo","poem":1},{"text":"akayikungena kuwe futhi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Thintitha uthuli lwakho;","poem":1},{"text":"sukuma, uhlale ebukhosini, wena Jerusalema.","poem":2},{"text":"Zikhulule izibopho ezisentanyeni yakho,","poem":1},{"text":"wena Ndodakazi ethunjiweyo yaseZiyoni.","poem":2}]},{"type":"verse","number":3,"content":["Ngoba nanku okutshiwo nguThixo:",{"text":"“Lathengiswa ngeze,","poem":1},{"text":"njalo lizahlengwa kungekho mali.”","poem":2}]},{"type":"verse","number":4,"content":["Ngoba nanku okutshiwo nguThixo Wobukhosi:",{"text":"“Ekuqaleni abantu bami baya eGibhithe besiyahlala khona;","poem":1},{"text":"muva i-Asiriya yabancindezela.","poem":2}]},{"type":"verse","number":5,"content":["Khathesi kuyini engilakho lapha?” kubuza uThixo.",{"text":"“Ngoba abantu bami bathunjwa kungekho sizatho,","poem":1},{"text":"njalo labo abababusayo bayakloloda,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2},{"text":"“Ilanga lonke","poem":1},{"text":"ibizo lami lihlanjazwa kokuphela.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngakho-ke abantu bami bazalazi ibizo lami,","poem":1},{"text":"ngakho-ke ngalolosuku bazakwazi","poem":2},{"text":"ukuthi yimi engamemezela lokho ngaphambilini.","poem":1},{"text":"Yebo, yimi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yeka ubuhle phezu kwezintaba,","poem":1},{"text":"bezinyawo zalabo abaletha izindaba ezinhle,","poem":2},{"text":"abamemezela ukuthula,","poem":1},{"text":"abaletha izindaba ezinhle,","poem":2},{"lineBreak":true},{"text":"abamemezela insindiso,","poem":2},{"text":"abathi kulo iZiyoni,","poem":1},{"text":"“UNkulunkulu wakho uyabusa!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lalela! Abalindi bakho baphakamisa amazwi abo,","poem":1},{"text":"bonke bahlaba umkhosi ngokuthokoza.","poem":2},{"text":"Lapho uThixo ebuyela eZiyoni","poem":1},{"text":"bazayibona iZiyoni ngamehlo abo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hlokomani ndawonye ngezingoma zokuthokoza,","poem":1},{"text":"lina manxiwa aseJerusalema,","poem":2},{"text":"ngoba uThixo usebaduduzile abantu bakhe,","poem":1},{"text":"uselihlengile iJerusalema.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"UThixo uzaveza ingalo yakhe engcwele","poem":1},{"text":"phambi kwezizwe zonke,","poem":2},{"text":"njalo yonke imikhawulo yomhlaba","poem":1},{"text":"izabona insindiso kaNkulunkulu wethu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Sukani, sukani, phumani lapho!","poem":1},{"text":"Lingathinti lutho olungcolileyo!","poem":2},{"text":"Phumani kulo libe ngabahlambulukileyo,","poem":1},{"text":"lina eliphatha izitsha zikaThixo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kodwa kaliyikusuka ngokuphangisa,","poem":1},{"text":"kumbe libaleka;","poem":2},{"text":"ngoba uThixo uzahamba phambi kwenu,","poem":1},{"text":"uNkulunkulu ka-Israyeli uzakuba ngumvikeli wenu emva kwenu.","poem":2}]},{"type":"heading","content":["Ukuhlupheka Lodumo Lwenceku"]},{"type":"verse","number":13,"content":[{"text":"Khangelani, inceku yami izakwenza ngokuhlakanipha,","poem":1},{"text":"izaphakanyiswa ikhwezwe, iphiwe lodumo olukhulu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Njengoba babebanengi abanengwayo yiyo,","poem":1},{"text":"ubuso bayo babulimele okudlula okwabantu bonke,","poem":2},{"lineBreak":true},{"text":"lesimo sayo sonakele singase njengesomuntu,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ngakho-ke izachela izizwe ezinengi,","poem":1},{"text":"amakhosi azavala imilomo yawo ngenxa yayo.","poem":2},{"text":"Ngoba lokho abangakutshelwanga bazakubona,","poem":1},{"text":"labangakuzwanga, bazakuqedisisa.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}