{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"Ngubani olikholiweyo ilizwi lethu,","poem":1},{"text":"njalo amandla kaThixo abonakaliswe kubani na?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wakhula phambi kwakhe njengehlumela,","poem":1},{"text":"lanjengempande emhlabathini owomileyo.","poem":2},{"text":"Wayengelabuhle lobukhosi ukuba asikhange,","poem":1},{"text":"kungelalutho esimeni sakhe olungenza simfune.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Weyiswa njalo waliwa ngabantu,","poem":1},{"text":"umuntu wezinsizi, njalo ekujayele ukuhlupheka.","poem":2},{"text":"Lowo abantu abangafuniyo ukukhangelana laye","poem":1},{"text":"weyiswa, asimhloniphanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ngempela wathatha inhlungu zethu","poem":1},{"text":"wathwala insizi zethu,","poem":2},{"text":"kodwa thina sathi utshaywe nguNkulunkulu,","poem":1},{"text":"ebethwe nguye, njalo uhlutshiwe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kodwa wagwazwa ngenxa yezono zethu,","poem":1},{"text":"wachobozwa ngenxa yokona kwethu,","poem":2},{"text":"ukuhlutshwa kwakhe kwasilethela ukuthula,","poem":1},{"text":"njalo sasiliswa ngamanxeba akhe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Thina sonke silahlekile njengezimvu,","poem":1},{"text":"munye ngamunye wethu uphambukele endleleni yakhe;","poem":2},{"text":"njalo uThixo ubeke phezu kwakhe","poem":1},{"text":"ukona kwethu sonke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wancindezelwa wahlutshwa,","poem":1},{"text":"kodwa kawuvulanga umlomo wakhe;","poem":2},{"text":"wakhokhelwa ukuyabulawa njengewundlu,","poem":1},{"text":"njalo njengemvu ithule phambi komgundi wayo,","poem":2},{"lineBreak":true},{"text":"laye kawuvulanga umlomo wakhe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngokuncindezelwa langokwahlulela wathathwa.","poem":1},{"text":"Ngubani ongakhuluma ngesizukulwane sakhe na?","poem":2},{"text":"Ngoba wasuswa elizweni labaphilayo;","poem":1},{"text":"watshaywa ngenxa yeziphambeko zabantu bami.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wabelwa ingcwaba kanye lababi,","poem":1},{"text":"kanye labanothileyo ekufeni kwakhe,","poem":2},{"text":"lanxa kungeladlakela alwenzayo","poem":1},{"text":"njalo kungekho inkohliso emlonyeni wakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ikanti kwakuyintando kaThixo ukumchoboza lokumenza ahlupheke,","poem":1},{"text":"njalo lanxa uThixo esenza ukuphila kwakhe umnikelo wecala,","poem":2},{"text":"uzabona inzalo yakhe, andise insuku zokuphila kwakhe,","poem":1},{"text":"lentando kaThixo izaphumelela ngaye.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Emva kokuhlupheka komoya wakhe,","poem":1},{"text":"uzabona ukukhanya kokuphila asuthiseke;","poem":2},{"text":"ngokwazi kwayo inceku yami elungileyo izalungisa abanengi,","poem":1},{"text":"ithwale izono zabo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngakho-ke ngizamnika isabelo phakathi kwabakhulu,","poem":1},{"text":"njalo uzakwabelana impango labalamandla","poem":2},{"text":"ngoba wanikela ukuphila kwakhe ekufeni,","poem":1},{"text":"wabalwa ndawonye lezoni;","poem":2},{"text":"ngoba wathwala izono zabanengi,","poem":1},{"text":"wancengela izoni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}