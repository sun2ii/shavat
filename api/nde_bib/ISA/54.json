azo adilikayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ungesabi, ngoba awuyikwehlelwa lihlazo.","poem":1},{"text":"Ungesabi ukuyangeka, ngoba awuyikudumazeka.","poem":2},{"text":"Uzalikhohlwa ihlazo lasebutsheni bakho,","poem":1},{"text":"ungakhumbuli lesithuko sobufelokazi bakho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngoba uMenzi wakho engumyeni wakho,","poem":1},{"text":"uThixo uSomandla libizo lakhe","poem":2},{"text":"oNgcwele ka-Israyeli unguMhlengi wakho;","poem":1},{"text":"ubizwa ngokuthi nguNkulunkulu womhlaba wonke.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"UThixo uzakubiza","poem":1},{"text":"njengowesifazane olahliweyo, odabukileyo emoyeni,","poem":2},{"text":"owesifazane owenda esesemncane,","poem":1},{"text":"waphanga waliwa,” kutsho uNkulunkulu wakho.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Ngakutshiya okomzuzwana omncane,","poem":1},{"text":"kodwa ngesihawu esikhulu ngizakubuyisa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngomfutho wokuthukuthela,","poem":1},{"text":"ngakufihlela ubuso bami okomzuzwana,","poem":2},{"text":"kodwa ngothando olungapheliyo,","poem":1},{"text":"ngizakuba lesihawu kuwe,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo uMhlengi wakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Kimi lokhu kunjengasezinsukwini zikaNowa,","poem":1},{"text":"lapho engafunga khona ngathi amanzi kaNowa","poem":2},{"lineBreak":true},{"text":"kawayikugcwala umhlaba futhi.","poem":2},{"text":"Ngakho khathesi sengifungile ngathi","poem":1},{"text":"angiyikukuthukuthelela futhi;","poem":2},{"lineBreak":true},{"text":"angiyikukusola njalo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lanxa izintaba zinganyikinyiswa,","poem":1},{"text":"lamaqaqa asuswe,","poem":2},{"text":"kodwa uthando lwami olungapheliyo kuwe kaluyikunyikinyiswa,","poem":1},{"text":"kumbe isivumelwano sami sokuthula sisuswe,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo olesihawu kuwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Wena dolobho elihluphekileyo,","poem":1},{"text":"elitshaywa yiziphepho alaze laduduzwa,","poem":2},{"text":"ngizakwakha ngamatshe amahle,","poem":1},{"text":"izisekelo zakho ngizakhe ngamasafire.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Izakhiwo zakho zokuvikela ngizazenza ngamarubhi,","poem":1},{"text":"amasango akho ngiwenze ngamatshe akhazimulayo, yonke","poem":2},{"lineBreak":true},{"text":"imithangala yakho ngiyenze ngamatshe aligugu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wonke amadodana akho azafundiswa nguThixo,","poem":1},{"text":"njalo kuzakuba kukhulu ukuthula kwabantwana bakho.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Uzaqiniswa ngokulunga:","poem":1},{"lineBreak":true},{"text":"uchuku luzakuba khatshana lawe,","poem":1},{"text":"awuyikwesaba lutho.","poem":2},{"text":"Ukwesaba kuzasuselwa khatshana,","poem":1},{"text":"akuyikusondela phansi kwakho.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nxa ekhona ozakuhlasela, kobe kungayisimi;","poem":1},{"text":"loba ngubani okuhlaselayo uzazinikela kuwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Khangela, yimi engadala umkhandi wensimbi","poem":1},{"text":"ovuthela amalahle abe lilangabi,","poem":2},{"lineBreak":true},{"text":"akhande isikhali esilungele umsebenzi waso.","poem":2},{"text":"Njalo yimi engadala umchithi ukuba enze umonakalo;","poem":1}]},{"type":"verse","number":17,"content":[{"text":"akulasikhali esikhandelwe wena esizaphumelela,","poem":2},{"lineBreak":true},{"text":"njalo bonke abakumangalelayo uzabehlula.","poem":2},{"text":"Leli yilifa lezinceku zikaThixo,","poem":1},{"text":"lokhu yikho ukwenaniswa kwazo yimi,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}