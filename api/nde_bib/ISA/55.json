{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":55,"content":[{"type":"heading","content":["Ukunxusa Kwabomileyo"]},{"type":"verse","number":1,"content":[{"text":"“Wozani, lonke lina abomileyo,","poem":1},{"text":"wozani emanzini,","poem":2},{"text":"lani lina elingelamali,","poem":1},{"text":"wozani, lithenge, lidle!","poem":2},{"text":"Wozani, thengani iwayini lochago","poem":1},{"text":"ingekho imali lendleko.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lichithelani imali kokungasikho kudla,","poem":1},{"text":"lokusebenza kwenu kulokho okungasuthisiyo na?","poem":2},{"text":"Lalelani, lalelani kimi, lidle okuhle,","poem":1},{"text":"umoya wenu uzathokoziswa yizibiliboco.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lalelani, lize kimi;","poem":1},{"text":"lingilalele ukuze umphefumulo wenu uphile.","poem":2},{"text":"Ngizakwenza isivumelwano esingapheliyo lani,","poem":1},{"text":"uthando lwami oluqotho olwathenjiswa uDavida.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Khangelani, ngimenze waba ngufakazi ebantwini,","poem":1},{"text":"umkhokheli lomlawuli wabantu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngeqiniso lizabiza izizwe elingazaziyo,","poem":1},{"text":"lezizwe ezingalaziyo zizagijimela kini,","poem":2},{"text":"ngenxa kaThixo uNkulunkulu wenu,","poem":1},{"text":"oNgcwele ka-Israyeli,","poem":2},{"lineBreak":true},{"text":"ngoba uselinike inkazimulo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mdingeni uThixo esatholakala,","poem":1},{"text":"mbizeni eseseduzane.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Omubi kayekele indlela yakhe","poem":1},{"text":"loxhwalileyo alahle imicabango yakhe.","poem":2},{"text":"Kaphendukele kuThixo, uzakuba lesihawu kuye,","poem":1},{"text":"lakuNkulunkulu wethu ngoba uzamthethelela ngesihle.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ngoba imicabango yami kayisiyo eyenu,","poem":1},{"text":"lezindlela zenu kayisizo ezami,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Njengomkhathi uphakeme kulomhlaba,","poem":1},{"text":"ngokunjalo izindlela zami ziphakeme kulezindlela zenu,","poem":2},{"lineBreak":true},{"text":"lemicabango yami iphakeme kulemicabango yenu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Njengoba izulu longqwaqwane","poem":1},{"text":"kusehla kuvela phezulu,","poem":2},{"text":"kungaphindi kubuyele khonale","poem":1},{"text":"kungathambisanga umhlaba","poem":2},{"text":"kuwenze ununkule ube lamahlumela,","poem":1},{"text":"ukuze unike umhlanyeli inhlanyelo, lodlayo umnike ukudla,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"linjalo lelizwi lami eliphuma emlonyeni wami:","poem":1},{"text":"kaliyikubuya kimi lize,","poem":2},{"text":"kodwa lizafeza engikufunayo","poem":1},{"text":"liphumelelise lokho engilithume khona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lina lizaphuma ngokuthokoza","poem":1},{"text":"likhokhelwe ngokuthula;","poem":2},{"text":"izintaba lamaqaqa","poem":1},{"text":"kuzasusa ingoma phambi kwenu,","poem":2},{"text":"njalo zonke izihlahla zeganga","poem":1},{"text":"zizaqakeza izandla zazo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Endaweni yesihlahla sameva kuzamila iphayini,","poem":1},{"text":"lendaweni yokhula kuzamila isihlahla somithili.","poem":2},{"text":"Lokhu kuzakwenza uThixo adunyiswe,","poem":1},{"text":"kube yisibonakaliso esingapheliyo,","poem":2},{"lineBreak":true},{"text":"esingayikudilizwa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}