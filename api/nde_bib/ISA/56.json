{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":56,"content":[{"type":"heading","content":["Ukusindiswa Kwabanye"]},{"type":"verse","number":1,"content":["Nanku okutshiwo nguThixo:",{"text":"“Londoloza ukulunga","poem":1},{"text":"wenze okuqondileyo,","poem":2},{"text":"ngoba ukusindisa kwami kuseduze","poem":1},{"text":"lokulunga kwami kuzabonakaliswa masinyane.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ubusisiwe umuntu okwenzayo lokhu,","poem":1},{"text":"umuntu obambelela kukho,","poem":2},{"text":"ogcina iSabatha engalingcolisi,","poem":1},{"text":"athibe isandla sakhe ekwenzeni okubi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Akungabi lowezizweni okuThixo othi,","poem":1},{"text":"“Ngeqiniso uThixo uzangehlukanisa labantu bakhe.”","poem":2},{"text":"Njalo lomthenwa kangavunyelwa ukusola athi,","poem":1},{"text":"“Mina ngiyisihlahla esomileyo.”","poem":2}]},{"type":"verse","number":4,"content":["Ngoba uThixo uthi:",{"text":"“Abathenwa abagcina amaSabatha ami","poem":1},{"text":"bakhethe okungithokozisayo,","poem":2},{"lineBreak":true},{"text":"babambelele kusivumelwano sami,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ngizabanika, phakathi kwethempeli lami lemiduli yalo,","poem":1},{"text":"isikhumbuzo lebizo","poem":2},{"lineBreak":true},{"text":"elingcono kulamadodana lamadodakazi.","poem":2},{"text":"Ngizabanika ibizo elingapheliyo.","poem":1},{"text":"Elingayikukhohlakala.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Labezizwe abazinikela kuThixo","poem":1},{"text":"ukuba bamkhonze,","poem":2},{"text":"bathande ibizo likaThixo,","poem":1},{"text":"njalo bamkhonze,","poem":2},{"text":"bonke abagcina iSabatha bengalingcolisi,","poem":1},{"text":"babambelele kusivumelwano sami,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"laba ngizabaletha entabeni yami engcwele,","poem":1},{"text":"ngibaphe intokozo endlini yami yokukhulekela.","poem":2},{"text":"Iminikelo yabo yokutshiswa, lemihlatshelo,","poem":1},{"text":"kuzakwamukelwa e-alithareni lami;","poem":2},{"text":"ngoba indlu yami izathiwa","poem":1},{"text":"yindlu yokukhuleka yezizwe zonke.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"UThixo Wobukhosi,","poem":1},{"text":"yena oqoqa abaxotshwayo elizweni abako-Israyeli uthi:","poem":2},{"text":"“Ngizaqoqela abanye kubo futhi","poem":1},{"text":"ngaphandle kwalabo abavele sebeqoqiwe.”","poem":2}]},{"type":"heading","content":["UThixo Usola Ababi"]},{"type":"verse","number":9,"content":[{"text":"Wozani lonke lina zilo zeganga;","poem":1},{"text":"wozani lidle, lonke lina zilo zamagusu!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abalindi bako-Israyeli bayiziphofu,","poem":1},{"text":"bonke kabazi lutho;","poem":2},{"text":"bonke bayimigaxa,","poem":1},{"text":"izinja ezingakhonkothiyo;","poem":2},{"text":"balala nje baphuphe;","poem":1},{"text":"bathanda ukulala.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bayizinja ezihlala zilomdlozela wokufuna ukudla,","poem":1},{"text":"azisuthi.","poem":2},{"text":"Bangabelusi abangaqedisisiyo,","poem":1},{"text":"bonke bazazenzela abakufunayo,","poem":2},{"lineBreak":true},{"text":"lowo lalowo udinga inzuzo yakhe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lowo lalowo uthi, “Wozani, ngilethe iwayini.","poem":1},{"text":"Kasinatheni utshwala sibusuthe.","poem":2},{"text":"Kusasa kuzafana lanamuhla,","poem":1},{"text":"loba kube ngcono kakhulu.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}