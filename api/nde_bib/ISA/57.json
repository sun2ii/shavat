{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":57,"content":[{"type":"verse","number":1,"content":[{"text":"Abalungileyo bayabhubha,","poem":1},{"text":"kodwa kakho ocabanga ngakho enhliziyweni yakhe.","poem":2},{"text":"Abantu abazinikele ekukhonzeni bayasuswa,","poem":1},{"text":"njalo kakho okuzwisisayo ukuthi","poem":2},{"text":"abalungileyo basuswa","poem":1},{"text":"ukuba baphetshiswe ebubini.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Labo abahamba ngokulunga","poem":1},{"text":"bayangena ekuthuleni;","poem":2},{"lineBreak":true},{"text":"bathola ukuphumula belele ekufeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Kodwa lina wozani lapha lina,","poem":1},{"text":"madodana esanusekazi lina nzalo yezifebe leziphingi!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngubani elimklolodelayo na?","poem":1},{"text":"Ngubani elimnemelayo","poem":2},{"lineBreak":true},{"text":"limkhuphela inlimi zenu?","poem":2},{"text":"Kalisinzalo yabahlamuki,","poem":1},{"text":"labantwana babaqamba amanga na?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Liyatshiseka ngenkanuko ezihlahleni zomʼOkhi,","poem":1},{"text":"langaphansi kwezihlahla zonke eziyizithingithingi;","poem":2},{"text":"lenza umhlatshelo ngabantwabenu emakhelekehleni","poem":1},{"text":"langaphansi kwamawa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Izithombe eziphakathi kwamatshe abutshelezi emakhelekehleni yiso isabelo senu,","poem":1},{"text":"yizo, yizo eziyisabelo senu.","poem":2},{"text":"Yebo, kuzo lithele iminikelo yokunathwayo","poem":1},{"text":"lanikela leminikelo yamabele.","poem":2},{"lineBreak":true},{"text":"Ngenxa yalezizinto ngingaba lozwelo na?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wenze umbheda wakho phezu koqaqa oluphakemeyo,","poem":1},{"text":"wakhwela wayanikela imihlatshelo yakho khona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngemva kwezivalo zakho langemva kwezinsika zomnyango wakho","poem":1},{"text":"ubeke izifanekiso zakho zobuhedeni.","poem":2},{"text":"Wathi ungilahla wembula umbheda wakho,","poem":1},{"text":"wakhwela kuwo wawuvula waba banzi,","poem":2},{"text":"wavumelana lalabo othanda imibheda yabo,","poem":1},{"text":"wakhangela ubunqunu babo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uye kuMoleki ulamafutha e-oliva,","poem":1},{"text":"wandisa lamakha akho.","poem":2},{"text":"Uthume izithunywa zakho khatshana","poem":1},{"text":"wangena ethuneni lona ngokwalo!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wadiniswa yizindlela zakho zonke,","poem":1},{"text":"kodwa wawungeke uthi, ‘Akusizi ngalutho.’","poem":2},{"text":"Wathola ukuvuselelwa kwamandla akho.","poem":1},{"text":"Ngakho kawuphelanga amandla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ngubani omesabe kangaka","poem":1},{"text":"waze waba lamanga kimi,","poem":2},{"text":"njalo kawaze wangikhumbula","poem":1},{"text":"loba ukucabanga lokhu enhliziyweni yakho na?","poem":2},{"text":"Akusingenxa yokuthi sengathula okwesikhathi eside kakhulu","poem":1},{"text":"waze wangasangesabi na?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ukulunga kwakho lemisebenzi yakho ngizakuveza obala,","poem":1},{"text":"njalo akuyikukusiza ngalutho.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lapho usukhalela ukusizwa,","poem":1},{"text":"iqoqo lezithombe zakho kalikuhlenge.","poem":2},{"text":"Umoya uzazithatha zonke,","poem":1},{"text":"lokuphephetha nje kuziphephulele khatshana.","poem":2},{"text":"Kodwa umuntu owenza mina isiphephelo sakhe","poem":1},{"text":"ilizwe lizakuba yilifa lakhe","poem":2},{"lineBreak":true},{"text":"lentaba yami engcwele ibe ngeyakhe.”","poem":2}]},{"type":"heading","content":["Induduzo Kwabazisolayo"]},{"type":"verse","number":14,"content":["Njalo kuzathiwa:",{"text":"“Candani, candani, lungisani indlela!","poem":1},{"text":"Susani izikhubekiso endleleni yabantu bami.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngoba ophakemeyo ongaPhezulu,","poem":1},{"text":"yena ophila kokuphela, obizo lakhe lingcwele uthi:","poem":2},{"text":"“Ngihlala endaweni ephakemeyo lengcwele,","poem":1},{"text":"kodwa laye ozisolayo lothobekileyo emoyeni,","poem":2},{"text":"ukuba kuvuselelwe umoya wabathobekileyo,","poem":1},{"text":"kuvuselelwe lezinhliziyo zabazisolayo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Angiyikulisola kokuphela","poem":1},{"text":"kumbe ngihlale ngithukuthele,","poem":2},{"text":"ngoba umoya womuntu ungaphela phambi kwami,","poem":1},{"text":"umoya womuntu engawudalayo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngathukutheliswa yibuhwaba bakhe obubi;","poem":1},{"text":"ngamjezisa, ngafihla ubuso bami ngithukuthele,","poem":2},{"lineBreak":true},{"text":"kodwa waqhubeka ngezindlela zakhe zenkani.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Izindlela zakhe sengizibonile, kodwa ngizamsilisa.","poem":1},{"text":"Ngizamkhokhela, ngimduduze futhi,","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ngenze ukubonga ezindebeni zabalilayo ko-Israyeli.","poem":2},{"text":"Ukuthula, ukuthula kwabakhatshana labaseduze,”","poem":1},{"text":"kutsho uThixo.","poem":2},{"text":"“Ngizabasilisa.”","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kodwa ababi banjengolwandle olugubhazelayo,","poem":1},{"text":"olungeke luphumule,","poem":2},{"lineBreak":true},{"text":"amagagasi alo ephosa udaka lengcekeza phezulu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“Akukho kuthula kwababi,” kutsho uNkulunkulu wami.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}