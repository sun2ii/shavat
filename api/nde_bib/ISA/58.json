{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":58,"content":[{"type":"heading","content":["Ukuzila Okuqotho"]},{"type":"verse","number":1,"content":[{"text":"“Memeza kakhulu, ungathuli.","poem":1},{"text":"Phakamisa ilizwi lakho njengecilongo.","poem":2},{"text":"Tshela abantu bami ngokuhlamuka kwabo,","poem":1},{"text":"lendlu kaJakhobe uyitshele ngezono zabo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngoba usuku ngosuku bayangidinga;","poem":1},{"text":"bafuna ukwazi izindlela zami,","poem":2},{"text":"sengathi bayisizwe esenza okulungileyo","poem":1},{"text":"esingalahlanga imilayo kaNkulunkulu waso.","poem":2},{"text":"Bacela izinqumo ezilungileyo kimi","poem":1},{"text":"bafune ukuthi uNkulunkulu asondele kubo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bathi, ‘Kungani sizilile,","poem":1},{"text":"kodwa wena wangakuboni na?","poem":2},{"text":"Kungani sizithobile","poem":1},{"text":"kodwa wangakunaki na?’","poem":2},{"lineBreak":true},{"text":"Ikanti ngosuku lokuzila kwenu lenza elikuthandayo,","poem":1},{"text":"lincindezele lezisebenzi zenu zonke.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ukuzila kwenu kucina ngengxabano lokulwa,","poem":1},{"text":"langokutshayana kubi ngenqindi.","poem":2},{"text":"Alingeke lizile njengelikwenzayo","poem":1},{"text":"lamhla lithembe ukuthi ilizwi lenu lizazwakala phezulu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lokhu yikho ukuzila engikukhethileyo na,","poem":1},{"text":"ukuthi umuntu azithobe okosuku olulodwa nje?","poem":2},{"text":"Yikuthi umuntu akhothamise ikhanda lakhe njengomhlanga nje,","poem":1},{"text":"lokulala esakeni lemlotheni na?","poem":2},{"text":"Lokho yikho elithi yikuzila,","poem":1},{"text":"usuku olwamukelekayo kuThixo na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lokhu akusikho yini ukuzila engikukhethileyo:","poem":1},{"lineBreak":true},{"text":"ukukhulula izibopho zokungalungi","poem":1},{"text":"lokuthukulula imichilo yejogwe,","poem":2},{"text":"kukhululwe abancindezelweyo,","poem":1},{"text":"kwephulwe amajogwe wonke na?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Akusikwabela abalambayo ukudla kwakho","poem":1},{"text":"lokunika umnyanga ongumhambuma indawo yokuhlala,","poem":2},{"text":"lapho ubona abanqunu ubagqokise,","poem":1},{"text":"lokungafulatheli izihlobo zakho zegazi na?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lapho-ke ukukhanya kwakho kuzavela njengokusa,","poem":1},{"text":"lokusila kwakho kuzabonakala masinyane,","poem":2},{"text":"kuthi ukulunga kwakho kuhambe phambi kwakho,","poem":1},{"text":"inkazimulo kaThixo izakuba yisivikelo ngemva kwakho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Lapho-ke uzabiza, uThixo asabele;","poem":1},{"text":"uzacela usizo, yena uzakuthi: Ngilapha.","poem":2},{"lineBreak":true},{"text":"Nxa ungalahla ijogwe lokuncindezela","poem":1},{"text":"lokukhomba ngomunwe kanye lezinkulumo ezimbi;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"njalo nxa unika abalambayo ukudla kwakho,","poem":1},{"text":"wanelise lenswelo zabancindezelweyo,","poem":2},{"text":"ukukhanya kwakho kuzavela emnyameni,","poem":1},{"text":"ubusuku bakho buzakuba njengemini.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"UThixo uzakukhokhela kokuphela;","poem":1},{"text":"uzakwanelisa inswelo zakho elizweni elitshiswa lilanga,","poem":2},{"lineBreak":true},{"text":"aqinise amathambo akho.","poem":2},{"text":"Uzakuba njengesivande esithelezelwa kuhle,","poem":1},{"text":"lanjengomthombo olamanzi angacitshiyo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abantu bakho bazawavusa amanxiwa amadala,","poem":1},{"text":"bavuse lezisekelo zakudala.","poem":2},{"text":"Uzabizwa ngokuthi uMakhi Wemiduli Eyadilikayo,","poem":1},{"text":"loMvuseleli wemiGwaqo leMizi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nxa ugcina inyawo zakho zingephuli iSabatha,","poem":1},{"text":"njalo ungenzi intando yakho ngosuku lwami olungcwele,","poem":2},{"text":"nxa iSabatha ulibiza ngokuthi yintokozo","poem":1},{"text":"njalo usuku lukaThixo olungcwele usithi lulodumo,","poem":2},{"text":"njalo nxa uluhlonipha ngokungahambi ngendlela yakho,","poem":1},{"text":"langokungenzi intando yakho loba ukukhuluma amazwi ayize,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"lapho-ke uzathola intokozo kuThixo,","poem":1},{"text":"njalo ngizakukhweza emiqolweni yelizwe,","poem":2},{"lineBreak":true},{"text":"ngikwenze udle ilifa likayihlo uJakhobe.”","poem":2},{"text":"Umlomo kaThixo usukhulumile.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/57.json","previousChapterAudioLinks":{},"numberOfVerses":14}