{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":59,"content":[{"type":"heading","content":["Isono, Ukuvuma Lokuhlengwa"]},{"type":"verse","number":1,"content":[{"text":"Ngeqiniso ingalo kaThixo kayimfitshane ukuba isindise,","poem":1},{"text":"lendlebe yakhe kayibuthundu ukuba izwe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kodwa ububi benu sebulahlukanise loNkulunkulu wenu;","poem":1},{"text":"lezono zenu sezisithe ubuso bakhe kini ukuze angezwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngoba izandla zenu zingcolisiwe ngegazi,","poem":1},{"text":"leminwe yenu ingcoliswe yibubi.","poem":2},{"text":"Izindebe zenu zikhulume amanga","poem":1},{"text":"lolimi lwenu luhlebeza izinto ezimbi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kakho odinga ukwahlulela okuhle,","poem":1},{"text":"kakho okhuluma ecaleni lakhe ngobuqotho.","poem":2},{"text":"Bathembe ukuphika ngeze bekhuluma amanga;","poem":1},{"text":"bemula uhlupho, bazale ububi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bachamisela amaqanda ezinhlangwana,","poem":1},{"text":"beluke ubulembu besayobe.","poem":2},{"text":"Langabe ngubani odla amaqanda azo uzakufa,","poem":1},{"text":"njalo nxa elinye lawo lichanyiselwe kuphuma ibululu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ubulembu babo kabusizi ekugqokeni;","poem":1},{"text":"abangeke bazimboze ngabakwenzayo.","poem":2},{"text":"Izenzo zabo yizenzo ezimbi,","poem":1},{"text":"izenzo zodlakela zisezandleni zabo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inyawo zabo zigijimela ukona;","poem":1},{"text":"bayaphangisa ukuchitha igazi elimsulwa.","poem":2},{"text":"Imicabango yabo yimicabango emibi;","poem":1},{"text":"ukuchitha lokubhubhisa kubonakalisa izindlela zabo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Indlela yokuthula kabayazi;","poem":1},{"text":"akukho kulunga ezindleleni zabo.","poem":2},{"text":"Sebenze zaba yimigwaqo ezombelezayo,","poem":1},{"text":"kakho ohamba ngazo ozakwazi ukuthula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ngakho-ke ukwahlulela okuhle kukhatshana lathi,","poem":1},{"text":"lokulunga akufiki kithi.","poem":2},{"text":"Sidinga ukukhanya, kodwa kulobumnyama kuphela;","poem":1},{"text":"sidinga ukucazimula, kodwa sihamba emathunzini amnyama.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Njengeziphofu siphumputha silandela umduli,","poem":1},{"text":"siphumputhe indlela yethu njengabantu abangelamehlo.","poem":2},{"text":"Sikhubeka emini ingathi kukusihlwa;","poem":1},{"text":"kwabalamandla, sinjengabafileyo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sonke siyahwabha njengamabhele,","poem":1},{"text":"sibubule ngosizi njengamajuba.","poem":2},{"text":"Sidinga ukwahlulela okuhle, kodwa kasikutholi;","poem":1},{"text":"sidinga ukuhlengwa, kodwa kukhatshana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ngoba ukona kwethu kuwe kunengi,","poem":1},{"text":"lezono zethu zifakaza okubi ngathi.","poem":2},{"text":"Ukona kwethu kuhlezi kulathi;","poem":1},{"text":"siyabuvuma ububi bethu,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ukuhlamuka lokungathembeki kuThixo,","poem":1},{"text":"ukufulathela uNkulunkulu wethu,","poem":2},{"text":"ukukhuthaza uncindezelo lomvukela,","poem":1},{"text":"ukukhuluma amanga esiwacabange ngezinhliziyo zethu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngakho ukwahlulela okuhle kufuqelwa emuva,","poem":1},{"text":"ukulunga kume khatshana;","poem":2},{"text":"iqiniso likhubekile ezindleleni,","poem":1},{"text":"ubuqotho bungeke bungene.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Iqiniso kalitholwa ndawo;","poem":1},{"text":"oxwaya ububi uyahlaselwa.","poem":2},{"lineBreak":true},{"text":"UThixo wakhangela wadaniswa","poem":1},{"text":"yikuswelakala kokwahlulela okuhle.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wabona ukuthi kwakungelamuntu,","poem":1},{"text":"wanengwa yikuthi kakho owayengalamula;","poem":2},{"text":"ngakho waletha ukukhululwa ngamandla akhe,","poem":1},{"text":"ukulunga kwakhe kwamqinisa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wagqoka ukulunga njengesivikelo sakhe sasesifubeni,","poem":1},{"text":"lengowane yensindiso ekhanda lakhe;","poem":2},{"text":"wagqoka izembatho zokuphindisela","poem":1},{"text":"njalo wazigoqela ngokutshiseka njengokuzigoqela ngengubo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Uzaphindisela ulaka ezitheni zakhe,","poem":1},{"text":"kusiya ngalokho abakwenzileyo;","poem":2},{"text":"lokujeziswa kwabamelana laye;","poem":1},{"text":"izihlenge uzaziphindisela ngemfanelo yazo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kusukela entshonalanga abantu bazalesaba ibizo likaThixo,","poem":1},{"text":"njalo kusukela ekuphumeni kwelanga bazadumisa ubukhosi bakhe.","poem":2},{"text":"Ngoba uzafika njengesikhukhula esifutheleneyo","poem":1},{"text":"esifuqwa ngumoya kaThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Umhlengi uzafika eZiyoni,","poem":1},{"text":"kwabakaJakhobe abavuma izono zabo,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":21,"content":["“Mina lesi yiso isivumelwano sami labo,” kutsho uThixo. “Umoya wami okuwe, lamazwi ami engiwabeke emlonyeni wakho akuyikusuka emlonyeni wakho, kumbe emilonyeni yabantwabakho, loba emilonyeni yezizukulwane zabo kusukela ngalesisikhathi kuze kube nininini,” kutsho uThixo."]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/58.json","previousChapterAudioLinks":{},"numberOfVerses":21}