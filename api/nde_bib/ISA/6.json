{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":6,"content":[{"type":"heading","content":["Ukuthunywa Kuka-Isaya"]},{"type":"verse","number":1,"content":["Ngomnyaka inkosi u-Uziya eyafa ngawo, ngabona uThixo ehlezi esihlalweni sobukhosi esiphezulu esiphakemeyo, injobo yesembatho sakhe igcwele ithempeli."]},{"type":"verse","number":2,"content":["Ngaphezu kwakhe kwakulamaserafimu, elinye lelinye lilempiko eziyisithupha. Ayegubuzele ubuso bawo ngezimpiko ezimbili, egubuzele inyawo zawo ngezimbili, ephapha ngezimbili."]},{"type":"verse","number":3,"content":["Elinye lamemezela kwelinye lisithi:",{"text":"“Ungcwele, ungcwele, ungcwele uThixo uSomandla,","poem":1},{"text":"umhlaba wonke ugcwele inkazimulo yakhe.”","poem":2}]},{"type":"verse","number":4,"content":["Ekuzwakaleni kwamazwi awo imigubazi lombundu kwanyikinyeka, kwathi ithempeli lagcwala intuthu."]},{"type":"verse","number":5,"content":["Mina ngakhala ngathi, “Maye mina! Sengibhujisiwe! Ngoba ngingumuntu olezindebe ezingcolileyo, njalo ngihlala phakathi kwabantu abalezindebe ezingcolileyo, lamehlo ami asebone iNkosi, uThixo uSomandla.”"]},{"type":"verse","number":6,"content":["Lapho-ke elinye lamaserafimu laphaphela kimi liphethe ilahle elivuthayo esandleni salo elalilithethe ngodlawu e-alithareni."]},{"type":"verse","number":7,"content":["Lathinta umlomo wami ngalo lathi, “Khangela, lokhu sekuthinte izindebe zakho; icala lakho selisusiwe, njalo lesono sakho sesihlawulelwe.”"]},{"type":"verse","number":8,"content":["Ngasengisizwa ilizwi leNkosi lisithi, “Ngizathuma bani na? Ngubani na ozasihambela?” Mina ngathi, “Ngilapha. Ngithuma!”"]},{"type":"verse","number":9,"content":["Yasisithi, “Hamba uyetshela abantu uthi:",{"text":"‘Zwanini kokuphela, kodwa lingaqedisisi;","poem":1},{"text":"libone kokuphela, kodwa lingabonisisi.’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yenza inhliziyo yalababantu ibe lukhuni;","poem":1},{"text":"wenze indlebe zabo zibe buthundu,","poem":2},{"lineBreak":true},{"text":"uvale amehlo abo.","poem":2},{"text":"Hlezi babone ngamehlo abo,","poem":1},{"text":"bezwe ngezindlebe zabo,","poem":2},{"lineBreak":true},{"text":"baqedisise ngezinhliziyo zabo,","poem":2},{"text":"baphenduke basiliswe.”","poem":1}]},{"type":"verse","number":11,"content":["Ngasengisithi, “Koze kube nini, Nkosi?” Yona yaphendula yathi:",{"text":"“Amadolobho aze achitheke","poem":1},{"text":"njalo kungaselabantu kuwo,","poem":2},{"text":"izindlu zize zisale zingaselabantu,","poem":1},{"text":"lamasimu ephundleke abhuquzeka,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"uThixo aze axotshele umuntu wonke khatshana","poem":1},{"text":"njalo ilizwe lidelwe ngokupheleleyo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lanxa ingxenye eyodwa etshumini isala elizweni","poem":1},{"text":"izachithwa futhi.","poem":2},{"text":"Kodwa njengezihlahla zetherebhinti lemi-okhi","poem":1},{"text":"zitshiya izidindi lapho seziganyulwe,","poem":2},{"lineBreak":true},{"text":"ngokunjalo inhlanyelo engcwele izakuba yisidindi elizweni.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}