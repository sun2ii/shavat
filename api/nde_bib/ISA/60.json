{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":60,"content":[{"type":"heading","content":["Inkazimulo YaseZiyoni"]},{"type":"verse","number":1,"content":[{"text":"“Vuka, khazimula, ngoba ukukhanya kwakho sekufikile,","poem":1},{"text":"lenkazimulo kaThixo iyavela phezu kwakho.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Khangela, umnyama wembese umhlaba,","poem":1},{"text":"umnyama omkhulu usibekele abantu.","poem":2},{"text":"Kodwa uThixo uyakhanya phezu kwakho","poem":1},{"text":"lenkazimulo yakhe iyabonakala phezu kwakho.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Izizwe zizakuza ekukhanyeni kwakho,","poem":1},{"text":"lamakhosi alande ukuqhama kokusa kwakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Phakamisa amehlo akho ukhangele amacele akho wonke:","poem":1},{"text":"bonke babuthana beze kuwe;","poem":2},{"text":"amadodana akho avela khatshana,","poem":1},{"text":"lamadodakazi akho athwelwe ngengalo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngakho uzakhangela ubobotheke ngokujabula,","poem":1},{"text":"inhliziyo yakho izatshaya ikhukhumale ngenxa yentokozo;","poem":2},{"text":"inotho yasolwandle izalethwa kuwe,","poem":1},{"text":"lenotho yezizwe izakuza kuwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Imihlambi yamakamela izagcwala elizweni lakho,","poem":1},{"text":"amakamela asakhulayo aseMidiyani lase-Efa.","poem":2},{"text":"Wonke avela eShebha azakuza","poem":1},{"text":"ethwele igolide lempepha","poem":2},{"lineBreak":true},{"text":"ememezela udumo lukaThixo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yonke imihlambi yaseKhedari izabuthelwa kuwe;","poem":1},{"text":"inqama zaseNebhayothi zizakusiza;","poem":2},{"text":"zizakwamukeleka njengeminikelo e-alithareni lami,","poem":1},{"text":"njalo ngizahlobisa ithempeli lami elilodumo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ngobani laba abandiza njengamayezi","poem":1},{"text":"lanjengamajuba esiya ezidlekeni zawo na?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngeqiniso izihlenge zithembe mina;","poem":1},{"text":"ekhokheleyo yimikhumbi yaseThashishi,","poem":2},{"text":"iletha amadodana akho avela khatshana,","poem":1},{"text":"lesiliva sawo kanye legolide","poem":2},{"text":"ukuba kudunyiswe uThixo uNkulunkulu wakho,","poem":1},{"text":"oNgcwele ka-Israyeli,","poem":2},{"lineBreak":true},{"text":"ngoba ukunike inkazimulo.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Abezizwe bazayakha futhi imiduli yakho,","poem":1},{"text":"lamakhosi abo azakukhonza.","poem":2},{"text":"Lanxa ekuthukutheleni kwami ngakutshaya,","poem":1},{"text":"kodwa ngomusa wami ngizakuba lesihawu kuwe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amasango akho azahlala evulekile;","poem":1},{"text":"kawayikuvalwa emini loba ebusuku","poem":2},{"text":"ukuze abantu bakulethele inotho yezizwe,","poem":1},{"text":"amakhosi azo ekhokhelwe ludwendwe lokunqoba.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngoba isizwe kumbe umbuso ongayikukukhonza uzatshabalala;","poem":1},{"text":"uzachitheka uphele nya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Udumo lwaseLebhanoni luzakuza kuwe;","poem":1},{"text":"zonke izihlahla ezamaphayini, umfiri lomsiphresi,","poem":2},{"text":"ukuzehlobisa indlu yami engcwele;","poem":1},{"text":"lendawo yezinyawo zami ngizayenza ikhazimule.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Amadodana abancindezeli bakho","poem":1},{"text":"azakuza akhothame phambi kwakho;","poem":2},{"text":"bonke abakweyisayo","poem":1},{"text":"bazakhothamela phansi ezinyaweni zakho,","poem":2},{"text":"njalo bazakubiza ngokuthi iDolobho likaThixo,","poem":1},{"text":"iZiyoni yakhe oNgcwele ka-Israyeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Lanxa ubulahliwe, uzondakala,","poem":1},{"text":"kungekho ohamba edabula phakathi kwakho,","poem":2},{"text":"ngizakwenza ube ligugu elingapheliyo,","poem":1},{"text":"uthokozise izizukulwane zonke.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Uzanatha uchago lwezizwe,","poem":1},{"text":"umunyiswe emabeleni asesikhosini.","poem":2},{"text":"Lapho-ke uzakwazi ukuthi nginguThixo, uMsilisi wakho,","poem":1},{"text":"uMhlengi wakho, uMninimandla kaJakhobe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Esikhundleni sethusi ngizakulethela igolide,","poem":1},{"text":"lesiliva esikhundleni sensimbi.","poem":2},{"text":"Esikhundleni sezigodo ngizakulethela ithusi,","poem":1},{"text":"lensimbi esikhundleni samatshe.","poem":2},{"text":"Ngizakwenza ukuthula kube ngumbusi wakho,","poem":1},{"text":"lokulunga kube yinkosi yakho.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Akusayikuba lodlakela elizweni lakho,","poem":1},{"text":"akusayikuba khona ukuchitheka","poem":2},{"lineBreak":true},{"text":"loba ukutshabalala phakathi kwelizwe lakini,","poem":2},{"text":"kodwa uzakuthi imiduli yakho yiNsindiso,","poem":1},{"text":"lamasango akho uthi yiNdumiso.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ilanga kalisayikuba yikukhanya kwakho emini","poem":1},{"text":"loba ukukhanya kwenyanga kukukhanyise,","poem":2},{"text":"ngoba uThixo uzakuba yikukhanya kwakho okungapheliyo,","poem":1},{"text":"loNkulunkulu wakho abe yinkazimulo yakho.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ilanga lakho kaliyikutshona futhi,","poem":1},{"text":"lenyanga yakho ayisayikufiphala njalo.","poem":2},{"text":"UThixo uzakuba yikukhanya kwakho okungapheliyo,","poem":1},{"text":"lezinsuku zakho zezinsizi zizaphela.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Lapho-ke bonke abantu bakho bazakuba ngabalungileyo,","poem":1},{"text":"lelizwe lizakuba lilifa labo kokuphela.","poem":2},{"text":"Bangamahlumela engawahlanyelayo,","poem":1},{"text":"umsebenzi wezandla zami,","poem":2},{"lineBreak":true},{"text":"ukuba ngibonakalise inkazimulo yami.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ingcosana yakho izakuba yinkulungwane,","poem":1},{"text":"abancinyane bazakuba yisizwe esilamandla.","poem":2},{"text":"Mina nginguThixo;","poem":1},{"text":"ngesikhathi esifaneleyo lokhu ngizakwenza ngokuphangisa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/59.json","previousChapterAudioLinks":{},"numberOfVerses":22}