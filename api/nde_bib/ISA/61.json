"poem":2},{"text":"lengubo yokudumisa","poem":1},{"text":"esikhundleni somoya wokulahla ithemba.","poem":2},{"text":"Bazabizwa ngokuthi yimʼokhi yokulunga,","poem":1},{"text":"ehlanyelwe nguThixo","poem":2},{"lineBreak":true},{"text":"ukuba abonakalise inkazimulo yakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bazavuselela njalo amanxiwa asendulo","poem":1},{"text":"bavuse lezindawo ezadilizwa kudala.","poem":2},{"text":"Bazavuselela amadolobho adilikayo","poem":1},{"text":"aleminyaka eminengi adilika.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abezizwe bazakwelusa imihlambi yenu;","poem":1},{"text":"abezizwe bazalima amasimu enu lezivini zenu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lizabizwa ngokuthi abaphristi bakaThixo,","poem":1},{"text":"kuzathiwa liyizikhonzi zikaNkulunkulu.","poem":2},{"text":"Lizakudla inotho yezizwe,","poem":1},{"text":"lizincome ngenotho yazo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Esikhundleni sehlazo labo","poem":1},{"text":"abantu bami bazaphiwa isabelo esiphindwe kabili,","poem":2},{"text":"njalo esikhundleni sokuyangeka","poem":1},{"text":"bazathokoza ngelifa labo;","poem":2},{"text":"ngakho isabelo selifa labo elizweni sizaphindwa kabili,","poem":1},{"text":"lentokozo engapheliyo izakuba ngeyabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ngoba mina, uThixo, ngithanda ukulunga,","poem":1},{"text":"ngizonda ubugebenga lobubi.","poem":2},{"text":"Ngobuqotho bami ngizabanika umvuzo","poem":1},{"text":"ngenze isivumelwano esingapheliyo labo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Izizukulwane zabo zizakwaziwa phakathi kwezizwe,","poem":1},{"text":"lenzalo yabo yaziwe phakathi kwabantu.","poem":2},{"text":"Bonke abababonayo bazavuma","poem":1},{"text":"ukuthi bangabantu ababusiswe nguThixo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ngiyathokoza kakhulu kuThixo;","poem":1},{"text":"umphefumulo wami uyajabula ngoNkulunkulu wami.","poem":2},{"text":"Ngoba ungigqokise izigqoko zokusindiswa,","poem":1},{"text":"wangicecisa ngezembatho zokulunga,","poem":2},{"text":"njengomyeni ececisa ikhanda lakhe njengomphristi,","poem":1},{"text":"lanjengomlobokazi ezicecise ngamatshe akhe aligugu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngoba njengomhlabathi owenza ihlumela limile,","poem":1},{"text":"lesivande esenza inhlanyelo ikhule,","poem":2},{"text":"ngokunjalo uThixo Wobukhosi uzakwenza ukulunga","poem":1},{"text":"lodumo kuvele phambi kwezizwe zonke.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}