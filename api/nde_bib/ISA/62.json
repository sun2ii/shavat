{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":62,"content":[{"type":"heading","content":["Ibizo Elitsha LeZiyoni"]},{"type":"verse","number":1,"content":[{"text":"Ngenxa yeZiyoni angiyikuthula;","poem":1},{"text":"ngenxa yeJerusalema angiyikuhlala ngithule,","poem":2},{"text":"ukulunga kwayo kuze kukhanye njengokusa,","poem":1},{"text":"ukusindiswa kwayo kuze kukhanye njengezibane ezivuthayo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Izizwe zizakubona ukulunga kwakho,","poem":1},{"text":"lamakhosi wonke ayibone inkazimulo yakho.","poem":2},{"text":"Uzabizwa ngebizo elitsha","poem":1},{"text":"umlomo kaThixo ozakunika lona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Uzakuba ngumqhele wenkazimulo esandleni sikaThixo,","poem":1},{"text":"umqhele wobukhosi esandleni sikaNkulunkulu wakho.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kabasayikukubiza ngokuthi oTshiyiweyo","poem":1},{"text":"kumbe babize ilizwe lakho ngokuthi Chithakele.","poem":2},{"text":"Kodwa uzabizwa ngokuthi Hefiziba","poem":1},{"text":"ilizwe lakho kuthiwe yiBhiyula,","poem":2},{"text":"ngoba uThixo uzathokoza ngawe,","poem":1},{"text":"lelizwe lakho lizakwenda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Njengejaha lithatha intombi,","poem":1},{"text":"ngokunjalo amadodana akho azakuthatha;","poem":2},{"text":"lanjengomyeni ethokozela umakoti wakhe,","poem":1},{"text":"ngokunjalo uNkulunkulu uzathokoza ngawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ngibeke abalindi phezu kwemiduli yakho wena Jerusalema;","poem":1},{"text":"kabayikuthula lanini emini loba ebusuku.","poem":2},{"text":"Lina elimbizayo uThixo,","poem":1},{"text":"musani ukuphumula,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"laye lingamphumuzi aze akhe iJerusalema","poem":1},{"text":"alenze libe lodumo emhlabeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"UThixo ufungile ngesandla sakhe sokudla","poem":1},{"text":"langengalo yakhe elamandla wathi;","poem":2},{"text":"“Angiyikuphinda lanini","poem":1},{"text":"ukunika izitha zenu amabele enu njengokudla kwazo,","poem":2},{"text":"njalo lanini abezizwe kabayikuphinda banathe iwayini elitsha","poem":1},{"text":"elilisebenzele nzima.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kodwa labo abawavunayo bazawadla","poem":1},{"text":"badumise uThixo,","poem":2},{"text":"lalabo ababutha amavini bazalinatha","poem":1},{"text":"emagumeni endlu yami engcwele.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dlulani, dlulani emasangweni!","poem":1},{"text":"Lungiselani abantu indlela.","poem":2},{"text":"Candani, candani umgwaqo!","poem":1},{"text":"Susani amatshe.","poem":2},{"text":"Phakamiselani izizwe uphawu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"UThixo usenze isimemezelo","poem":1},{"text":"emhlabeni wonke wathi;","poem":2},{"text":"“Wothini kuyo iNdodakazi yaseZiyoni,","poem":1},{"text":"‘Khangela uMsindisi wakho uyeza!","poem":2},{"text":"Khangela umvuzo wakhe ulawo,","poem":1},{"text":"lenhlawulo yakhe ulayo.’ ”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bazabizwa ngokuthi ngaBantu abaNgcwele,","poem":1},{"text":"abaHlengiweyo bakaThixo;","poem":2},{"text":"wena uzathiwa Ofunwayo,","poem":1},{"text":"iDolobho Elingasatshiywanga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}