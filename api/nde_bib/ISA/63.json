{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":63,"content":[{"type":"heading","content":["Usuku LukaNkulunkulu Lokuphindisela Lokuhlenga"]},{"type":"verse","number":1,"content":[{"text":"Ngubani lo ovela e-Edomi,","poem":1},{"text":"ovela eBhozira egqoke izembatho ezibomvu na?","poem":2},{"text":"Ngubani lo ogqoke ubucwazicwazi,","poem":1},{"text":"ohamba ngobukhulu bamandla akhe na?","poem":2},{"lineBreak":true},{"text":"“Yimi okhuluma ngokulunga,","poem":1},{"text":"olamandla okusindisa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kungani izigqoko zakho zibomvu","poem":1},{"text":"njengezomuntu onyathela isikhamelo sewayini na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Nginyathele isikhamelo sewayini ngedwa;","poem":1},{"text":"kakho owezizwe owayelami.","poem":2},{"text":"Ngabagxoba ngithukuthele,","poem":1},{"text":"ngabanyathela ngilolaka;","poem":2},{"text":"igazi labo lachaphakela ezambathweni zami,","poem":1},{"text":"langcolisa zonke izigqoko zami.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngoba usuku lokuphindisela lwalusenhliziyweni yami,","poem":1},{"text":"lomnyaka wokuhlenga kwami usufikile.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngakhangela, kodwa kakho owayengasiza.","poem":1},{"text":"Nganengwa yikungabi khona kosekelayo,","poem":2},{"text":"ngakho ingalo yami yangilethela insindiso","poem":1},{"text":"lolaka lwami lwangiqinisa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngagxoba izizwe ngokuthukuthela kwami,","poem":1},{"text":"ngazidakisa ngolaka lwami,","poem":2},{"lineBreak":true},{"text":"ngathela igazi lazo phansi.”","poem":2}]},{"type":"heading","content":["Ukudumisa Lokukhuleka"]},{"type":"verse","number":7,"content":[{"text":"Ngizalandisa ngomusa kaThixo,","poem":1},{"text":"izenzo okumele adunyiswe ngenxa yazo,","poem":2},{"lineBreak":true},{"text":"ngakho konke uThixo asenzele khona,","poem":2},{"text":"yebo, izinto ezinengi ezinhle","poem":1},{"text":"azenzele indlu ka-Israyeli,","poem":2},{"lineBreak":true},{"text":"ngesihawu sakhe langomusa wakhe omkhulu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wathi, “Ngeqiniso bangabantu bami;","poem":1},{"text":"amadodana angayikuba lamanga kimi”;","poem":2},{"lineBreak":true},{"text":"ngakho waba nguMsindisi wabo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kukho konke ukuhlupheka kwabo laye waba losizi;","poem":1},{"text":"ukuba khona kwengilosi yakhe kwabasindisa.","poem":2},{"text":"Ngothando lwakhe langesihawu sakhe wabahlenga;","poem":1},{"text":"wabaphakamisela phezulu,","poem":2},{"lineBreak":true},{"text":"wabathwala insuku zonke zakudala.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kodwa bamvukela","poem":1},{"text":"badanisa uMoya wakhe oNgcwele.","poem":2},{"text":"Ngakho waphenduka waba yisitha sabo","poem":1},{"text":"walwa labo yena ngokwakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Lapho-ke abantu bakhe bakhumbula insuku zakudala,","poem":1},{"text":"insuku zikaMosi labantu bakhe,","poem":2},{"text":"ungaphi lowo owabachaphisa ulwandle,","poem":1},{"text":"lomelusi wemihlambi yakhe na?","poem":2},{"text":"Ungaphi lowo owathela","poem":1},{"text":"uMoya wakhe oNgcwele phakathi kwabo,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"owathumela ingalo yakhe yamandla elodumo","poem":1},{"text":"ukuba ibe sesandleni sokudla sikaMosi,","poem":2},{"text":"owehlukanisa amanzi phambi kwabo","poem":1},{"text":"ukuba azizuzele udumo olungapheliyo,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"owabadabulisa ezinzikini na?","poem":1},{"lineBreak":true},{"text":"Njengebhiza emagcekeni,","poem":1},{"text":"kabakhubekanga;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"njengezinkomo zisehla esigodini,","poem":1},{"text":"baphunyuzwa nguMoya kaThixo.","poem":2},{"text":"Wena wabakhokhela kanjalo abantu bakho","poem":1},{"text":"ukuze uzenzele ibizo elilodumo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Khangela phansi usezulwini ubone,","poem":1},{"text":"usesihlalweni sakho sobukhosi esiphakemeyo,","poem":2},{"lineBreak":true},{"text":"esingcwele, esicwebezelayo.","poem":2},{"text":"Kungaphi ukutshiseka kwakho lamandla akho na?","poem":1},{"text":"Isisa sakho lesihawu sakho kugodliwe kithi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kodwa wena unguBaba wethu,","poem":1},{"text":"lanxa u-Abhrahama engasazi thina","poem":2},{"lineBreak":true},{"text":"lo-Israyeli engasivumi;","poem":2},{"text":"wena, Oh Thixo, unguBaba wethu,","poem":1},{"text":"uMhlengi wethu libizo lakho kusukela endulo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kungani, Thixo, usenza siphambuke ezindleleni zakho,","poem":1},{"text":"usenza lezinhliziyo zethu zibe lukhuni ukuba singakwesabi na?","poem":2},{"text":"Phenduka ubuye ngenxa yezinceku zakho,","poem":1},{"text":"izizwana eziyilifa lakho.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Indawo yakho engcwele","poem":1},{"text":"yayingeyabantu bakho okwesikhathi esifitshane,","poem":2},{"text":"kodwa khathesi izitha zethu seziyicakazele phansi","poem":1},{"text":"indlu yakho engcwele.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Thina singabakho kusukela endulo;","poem":1},{"text":"kodwa awukaze ubabuse,","poem":2},{"lineBreak":true},{"text":"kabazange babizwe ngebizo lakho.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/62.json","previousChapterAudioLinks":{},"numberOfVerses":19}