{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":[{"text":"Awu, sengathi ungaqhekeza amazulu wehlele phansi","poem":1},{"text":"ukuba izintaba zinyikinyeke phambi kwakho!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Njengalapho umlilo utshisa incwathi","poem":1},{"text":"wenze amanzi abile,","poem":2},{"text":"yehlela phansi ukuba wenze ibizo lakho lazakale ezitheni zakho,","poem":1},{"text":"wenze lezizwe zithuthumele phambi kwakho.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngoba wathi usenza izinto ezesabekayo esasingazilindelanga,","poem":1},{"text":"wehlela phansi, izintaba zathuthumela phambi kwakho.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kusukela endulo kakho owezwayo,","poem":1},{"text":"akulandlebe eyabambisisayo,","poem":2},{"text":"akulalihlo elabona omunye uNkulunkulu ngaphandle kwakho,","poem":1},{"text":"osebenzela labo abathembe kuye.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Uyeza ukuba usize labo abenza ukulunga ngokuthaba,","poem":1},{"text":"abazikhumbulayo izindlela zakho.","poem":2},{"text":"Kodwa lapho saqhubeka sisona kubo","poem":1},{"text":"wathukuthela.","poem":2},{"lineBreak":true},{"text":"Pho singasindiswa kanjani na?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sonke sesaba njengomuntu ongcolileyo,","poem":1},{"text":"lemisebenzi yethu yokulunga yonke injengenjobo ezingcolileyo,","poem":2},{"text":"sonke siyabuna njengehlamvu,","poem":1},{"text":"lanjengomoya izono zethu zisiphephulela khatshana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kakho okhuleka ebizweni lakho","poem":1},{"text":"lozamayo ukubambelela kuwe,","poem":2},{"text":"ngoba ubuso bakho ubufihlile kithi","poem":1},{"text":"wasenza sacikizeka ngenxa yezono zethu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ikanti wena Thixo unguBaba wethu.","poem":1},{"text":"Thina silibumba, wena ungumbumbi;","poem":2},{"lineBreak":true},{"text":"sonke singumsebenzi wezandla zakho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ungathukutheli wedlulise, awu Thixo;","poem":1},{"text":"izono zethu ungazikhumbuli kokuphela.","poem":2},{"text":"Awu, ake usikhangele, siyakhuleka,","poem":1},{"text":"ngoba sonke singabantu bakho.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Amadolobho akho angcwele aseyinkangala;","poem":1},{"text":"leZiyoni isiyinkangala, iJerusalema isiyincithakalo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ithempeli lethu elingcwele njalo elikhazimulayo lapho okhokho ababekudumisela khona,","poem":1},{"text":"litshiswe ngomlilo,","poem":2},{"lineBreak":true},{"text":"njalo konke okwakuligugu kithi sekungamanxiwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Emva kwakho konke lokhu Thixo, uzazithinta na?","poem":1},{"text":"Uzazithulela, usijezise ngokudlulisileyo na?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/63.json","previousChapterAudioLinks":{},"numberOfVerses":12}