{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":65,"content":[{"type":"heading","content":["Ukwahlulela LeNsindiso"]},{"type":"verse","number":1,"content":[{"text":"“Ngaziveza kulabo abangangicelanga;","poem":1},{"text":"ngafunyanwa yilabo abangangidinganga.","poem":2},{"text":"Isizwe esingakhulekanga kimi","poem":1},{"text":"ngathi kuso, ‘Ngilapha, ngilapha.’","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ilanga lonke ngelula izandla zami","poem":1},{"text":"ebantwini abayiziqholo,","poem":2},{"text":"abahamba ngezindlela ezingalunganga","poem":1},{"text":"belandela iminakano yabo,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"abantu abahlezi bengicunula","poem":1},{"text":"bengikhangele,","poem":2},{"text":"benikela imihlatshelo emasimini,","poem":1},{"text":"betshisa impepha phezu kwezitina;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"abahlala emangcwabeni","poem":1},{"text":"balale besenza imilindelo eyimfihlo ebusuku;","poem":2},{"text":"abadla inyama yengulube,","poem":1},{"text":"abambiza zabo zigcina umhluzi wenyama engcolileyo;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"abathi, ‘Hlala khatshana, ungasondeli phansi kwami,","poem":1},{"text":"ngoba ngingcwele kulawe!’","poem":2},{"text":"Abantu abanjalo banjengentuthu emakhaleni ami,","poem":1},{"text":"umlilo ovuthayo ilanga lonke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Khangela, kulotshiwe phambi kwami ukuthi:","poem":1},{"text":"Angiyikuthula, kodwa ngizaphindisela ngokugcweleyo;","poem":2},{"lineBreak":true},{"text":"ngizaphindisela ngokupheleleyo,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kokubili izono zenu lezono zabokhokho benu,”","poem":1},{"text":"kutsho uThixo.","poem":2},{"text":"“Ngoba batshisa imihlatshelo phezu kwezintaba","poem":1},{"text":"bangihlambaza phezu kwamaqaqa.","poem":2},{"text":"Ngizaphindisela kubo ngokugcweleyo","poem":1},{"text":"ngenxa yezenzo zabo abazenza ngaphambili.”","poem":2}]},{"type":"verse","number":8,"content":["Nanku akutshoyo uThixo:",{"text":"“Njengalapho umhluzi usatholakala ehlukuzweni lamavini","poem":1},{"text":"labantu besithi, ungalibhidlizi,","poem":2},{"lineBreak":true},{"text":"kusekhona okuhle kulo,","poem":2},{"text":"ngizazenzela okunjalo izinceku zami;","poem":1},{"text":"angiyikuzibhubhisa zonke.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngizaletha isizukulwane esivela kuJakhobe,","poem":1},{"text":"lakoJuda kuvele abazakuba ngabanikazi bezintaba zami;","poem":2},{"text":"zizakuba yilifa labakhethiweyo bami,","poem":1},{"text":"izinceku zami zizahlala khona.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ISharoni izakuba ngamadlelo emihlambi","poem":1},{"text":"lesiGodi sase-Akhori sibe yindawo yokuphumulela imihlambi,","poem":2},{"lineBreak":true},{"text":"yabantu bami abangidingayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kodwa lina elilahla uThixo","poem":1},{"text":"likhohlwe intaba yami engcwele;","poem":2},{"text":"liphakele unkulunkulu uNhlanhla ukudla","poem":1},{"text":"libuye ligcwalisele unkulunkulu uSimiselo iwayini elixutshiweyo,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ngizalimisela inkemba,","poem":1},{"text":"njalo lonke lizakhothamela ukubulawa,","poem":2},{"text":"ngoba ngamemeza kodwa kalisabelanga,","poem":1},{"text":"ngakhuluma kodwa lina kalilalelanga.","poem":2},{"text":"Lenza okubi phambi kwami","poem":1},{"text":"lakhetha okungicunulayo.”","poem":2}]},{"type":"verse","number":13,"content":["Ngakho-ke uThixo Wobukhosi uthi:",{"text":"“Izinceku zami zizakudla,","poem":1},{"text":"kodwa lina lizalamba;","poem":2},{"text":"izinceku zami zizanatha,","poem":1},{"text":"kodwa lina lizakoma;","poem":2},{"text":"izinceku zami zizathokoza,","poem":1},{"text":"kodwa lina lizayangiswa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Izinceku zami zizahlabelela","poem":1},{"text":"ngentokozo yezinhliziyo zazo,","poem":2},{"text":"kodwa lina lizakhala","poem":1},{"text":"ngobuhlungu bezinhliziyo","poem":2},{"lineBreak":true},{"text":"njalo lilile ngokudabuka komoya.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lizatshiya ibizo lenu","poem":1},{"text":"njengesithuko kwabakhethiweyo bami;","poem":2},{"text":"uThixo Wobukhosi uzalibulala,","poem":1},{"text":"kodwa izinceku zakhe uzazinika elinye ibizo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Lowo okhulekela isibusiso elizweni","poem":1},{"text":"uzakwenza lokho ngoNkulunkulu weqiniso;","poem":2},{"text":"lalowo owenza isifungo elizweni,","poem":1},{"text":"uzafunga ngoNkulunkulu weqiniso.","poem":2},{"text":"Ngoba inhlupheko ezedlulayo","poem":1},{"text":"zizakhohlakala zifihlakale emehlweni ami.”","poem":2}]},{"type":"heading","content":["Izulu Elitsha Lomhlaba Omutsha"]},{"type":"verse","number":17,"content":[{"text":"“Khangelani, ngizadala","poem":1},{"text":"izulu elitsha lomhlaba omutsha.","poem":2},{"text":"Izinto zakuqala aziyikukhunjulwa,","poem":1},{"text":"kumbe zifike engqondweni.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kodwa thabani lijabule kokuphela","poem":1},{"text":"ngalokho engizakudala,","poem":2},{"text":"ngoba ngizadala iJerusalema libe yintokozo","poem":1},{"text":"labantu balo babe yinjabulo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ngizathokoza ngeJerusalema","poem":1},{"text":"njalo ngijabule ngabantu bami;","poem":2},{"text":"ukulila lokukhala","poem":1},{"text":"akusayikuzwakala kulo futhi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kulo akusayikuba khona futhi","poem":1},{"text":"usane oluphila insuku ezilutshwane","poem":2},{"lineBreak":true},{"text":"kumbe umuntu omdala ongaphelelisi iminyaka yakhe;","poem":2},{"text":"lowo ofa elekhulu leminyaka","poem":1},{"text":"uzakhangelwa njengomntwana nje;","poem":2},{"text":"lowo ongafikiyo ekhulwini","poem":1},{"text":"uzakhangelwa njengoqalekisiweyo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bazakwakha izindlu bahlale kuzo;","poem":1},{"text":"bazahlanyela izivini badle izithelo zazo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kabasayikwakha izindlu zihlalwe ngabanye","poem":1},{"text":"kumbe bahlanyele, kudle abanye.","poem":2},{"text":"Ngoba njengezinsuku zesihlahla,","poem":1},{"text":"zizakuba njalo insuku zabantu bami;","poem":2},{"text":"abakhethiweyo bami bazakholisa","poem":1},{"text":"umsebenzi wezandla zabo okwesikhathi eside.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kabayikusebenzela ize,","poem":1},{"text":"kumbe abantwababo bazalelwe ukuhlupheka,","poem":2},{"text":"ngoba bazakuba ngabantu ababusisiweyo nguThixo,","poem":1},{"text":"bona kanye lezizukulwane zabo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ngizabaphendula bengakakhuleki;","poem":1},{"text":"ngibezwe besakhuluma.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Impisi lewundlu kuzakudla ndawonye,","poem":1},{"text":"lesilwane sizakudla utshani njengenkomo,","poem":2},{"lineBreak":true},{"text":"kodwa inyoka izakudla uthuli.","poem":2},{"text":"Kaziyikulimaza kumbe zibhubhise","poem":1},{"text":"kuyo yonke intaba yami engcwele,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/64.json","previousChapterAudioLinks":{},"numberOfVerses":25}