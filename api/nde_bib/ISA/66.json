{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":66,"content":[{"type":"heading","content":["Ukwahlulela Lethemba"]},{"type":"verse","number":1,"content":["Nanku okutshiwo nguThixo:",{"text":"“Izulu liyisihlalo sami sobukhosi,","poem":1},{"text":"lomhlaba uyisenabelo sami.","poem":2},{"text":"Ingaphi indlu elizangakhela yona na?","poem":1},{"text":"Indawo yami yokuphumula izakuba ngaphi na?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isandla sami kasizenzanga zonke lezizinto","poem":1},{"text":"ukuze zibe khona na?”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2},{"lineBreak":true},{"text":"“Engimbukayo ngulo:","poem":1},{"text":"lowo othobekileyo ozisolayo emoyeni,","poem":2},{"lineBreak":true},{"text":"olesabayo ilizwi lami.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kodwa lowo onikela ngenkunzi","poem":1},{"text":"ufana lomuntu obulala omunye umuntu,","poem":2},{"text":"lalowo onikela ngewundlu,","poem":1},{"text":"ufana lowephula intamo yenja;","poem":2},{"text":"lowo onikela ngamabele","poem":1},{"text":"ufana lonikela ngegazi lengulube,","poem":2},{"text":"lalowo otshisa impepha yesikhumbuzo","poem":1},{"text":"ufana lokhonza isithombe.","poem":2},{"text":"Sebekhethe izindlela zabo,","poem":1},{"text":"lemiphefumulo yabo ithokoziswa yizinengiso zabo;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ngakho-ke lami ngizakhetha ukubaphatha kalukhuni,","poem":1},{"text":"ngibehlisele lokho abakwesabayo.","poem":2},{"text":"Ngoba kwathi lapho ngibiza, kakho owasabelayo,","poem":1},{"text":"lapho ngikhuluma, kakho owalalelayo.","poem":2},{"text":"Benza okubi phambi kwami,","poem":1},{"text":"bakhetha okungicunulayo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Zwanini ilizwi likaThixo","poem":1},{"text":"lina elilesabayo ilizwi lakhe. Uthi,","poem":2},{"text":"“Abafowenu abalizondayo,","poem":1},{"text":"labalixwayayo ngenxa yebizo lami, sebethe,","poem":2},{"text":"kadunyiswe uThixo","poem":1},{"text":"ukuze sibone intokozo yenu!","poem":2},{"lineBreak":true},{"text":"Kodwa bazayangiswa.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zwanini ukuxokozela okusedolobheni,","poem":1},{"text":"zwanini umsindo osethempelini!","poem":2},{"text":"Ngumsindo kaThixo","poem":1},{"text":"ephindisela ezitheni zakhe ngakho konke okuzifaneleyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Uthi engakahelelwa,","poem":1},{"text":"abelethe;","poem":2},{"text":"ubuhlungu bungakamfikeli,","poem":1},{"text":"azale indodana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngubani owake wezwa into enje na?","poem":1},{"text":"Ngubani owake wabona izinto ezinje na?","poem":2},{"text":"Ilizwe lingazalwa ngelanga elilodwa","poem":1},{"text":"loba isizwe sizalwe ngesikhatshana na?","poem":2},{"text":"Ikanti iZiyoni ithi ngokuhelelwa nje","poem":1},{"text":"ihle ibazale abantwana bayo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kambe ngifikisa esikhathini sokukhululeka","poem":1},{"text":"ngingabe ngisabelethisa na?”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2},{"text":"“Ngiyasivala na isibeletho","poem":1},{"text":"ngesikhathi sengibelethisa na?”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Thokozani leJerusalema lilithabele,","poem":1},{"text":"lonke lina elilithandayo;","poem":2},{"text":"thokozani kakhulu lalo lonke","poem":1},{"text":"lina elilililelayo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngoba lizamunya lisuthe","poem":1},{"text":"emabeleni alo aduduzayo;","poem":2},{"text":"lizanatha kakhulu,","poem":1},{"text":"lithokoze ngenala yalo enengi.”","poem":2}]},{"type":"verse","number":12,"content":["Ngoba lokhu yikho okutshiwo nguThixo:",{"text":"“Ngizaletha ukuthula kini okugeleza njengesifula esigcweleyo","poem":1},{"text":"lomnotho wezizwe njengesifula esithelayo,","poem":2},{"text":"limunye liphethwe ngengalo yazo","poem":1},{"text":"njalo lidlaliswe emathangazini azo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Njengomama eduduza umntanakhe,","poem":1},{"text":"kanjalo lami ngizaliduduza,","poem":2},{"lineBreak":true},{"text":"njalo lizaduduzeka eJerusalema.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Lapho libona lokhu, inhliziyo zenu zizathokoza,","poem":1},{"text":"lani likhule njengotshani;","poem":2},{"text":"isandla sikaThixo sizakwazakala ezincekwini zakhe","poem":1},{"text":"kodwa ulaka lwakhe luzabonakaliswa ezitheni zakhe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Khangelani, uThixo uza ngomlilo,","poem":1},{"text":"izinqola zakhe zempi zinjengesivunguzane;","poem":2},{"text":"ulaka lwakhe uzalwehlisela phansi ngokufuthelana,","poem":1},{"text":"lokukhuza kwakhe kwehle ngamalangabi omlilo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngoba ngomlilo langenkemba yakhe","poem":1},{"text":"uThixo uzakwahlulela abantu bonke,","poem":2},{"lineBreak":true},{"text":"njalo abanengi bazakuba yilabo ababulewe nguThixo.","poem":2}]},{"type":"verse","number":17,"content":["“Labo abazahlukanisayo, bazihlambulule ukungena emasimini belandela lowo ophakathi kwalabo abadla inyama yengulube lamagundwane kanye lezinye izinto ezinengisayo, isiphetho sabo sizafika sikhathi sinye,” kutsho uThixo."]},{"type":"verse","number":18,"content":["Ngenxa yezenzo zabo lemicabango yabo, sekuseduze ukuthi ngizebutha izizwe zonke lezindimi zonke; njalo bazakuza babone inkazimulo yami."]},{"type":"verse","number":19,"content":["“Ngizabeka isibonakaliso phakathi kwabo, ngithumele abanye balabo abasalayo ezizweni zeThashishi, kumaLibhiya, lamaLudi (alodumo ekusebenziseni imitshoko), eThubhali leGrisi lasezihlengeni ezikhatshana ezingakaluzwa udumo lwami kumbe zibone inkazimulo yami. Bazamemezela udumo lwami phakathi kwezizwe."]},{"type":"verse","number":20,"content":["Njalo bazababuyisa bonke abafowenu entabeni yami engcwele eJerusalema njengomnikelo kuThixo bevela ezizweni zonke, bephezu kwamabhiza, izinqola zempi, imbongolo lamakamela,” kutsho uThixo. “Bazababuyisa njengabako-Israyeli beletha iminikelo yabo yamabele ethempelini likaThixo ngezitsha ezihlambulukileyo ngokomkhuba."]},{"type":"verse","number":21,"content":["Ngizakhetha abanye babo ukuba labo babe ngabaphristi labaLevi,” kutsho uThixo."]},{"type":"verse","number":22,"content":["“Njengamazulu amatsha lomhlaba omutsha engikwenzayo kuzakuma kokuphela phambi kwami,” kutsho uThixo, “ngokunjalo ibizo lakho lenzalo yakho izakuma kokuphela."]},{"type":"verse","number":23,"content":["Kusukela ekuThwaseni kwenye iNyanga kusiya ekuthwaseni kwenye, njalo kusukela kwelinye iSabatha kusiya kwelinye abantu bonke bazakuza bakhothame phambi kwami,” kutsho uThixo."]},{"type":"verse","number":24,"content":["“Bazaphuma babone izidumbu zabantu abangihlamukelayo; impethu yazo kayiyikufa, lomlilo wazo kawuyikucitshwa, njalo zizakwenyanyeka ebantwini bonke.”"]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/65.json","previousChapterAudioLinks":{},"numberOfVerses":24}