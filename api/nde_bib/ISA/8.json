{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":8,"content":[{"type":"heading","content":["U-Isaya Labantwabakhe Njengezibonelo"]},{"type":"verse","number":1,"content":["UThixo wathi kimi, “Thatha isibhebhedu selitshe esikhulu ulobe kuso ngolimi olujwayelekileyo ukuthi: Maheri-Shalali-Hashi-Bhazi (okutsho ukuthi: abaphanga ukuhuquluza okuphangiweyo)."]},{"type":"verse","number":2,"content":["Ngizabiza u-Uriya umphristi loZakhariya indodana kaJebherekhiya njengabofakazi bami abathembekileyo.”"]},{"type":"verse","number":3,"content":["Ngemva kwalokho ngaya kumphrofethikazi, wathatha isisu, wazala indodana. UThixo wasesithi kimi, “Mbize ngokuthi nguMaheri-Shalali-Hashi-Bhazi."]},{"type":"verse","number":4,"content":["Kuzakuthi umfana engakakwazi ukuthi ‘Ubaba’ loba ‘Umama,’ inotho yaseDamaseko lempahla ethunjwe eSamariya kuzathathwa yinkosi yase-Asiriya.”"]},{"type":"verse","number":5,"content":["UThixo wakhuluma kimi futhi wathi:"]},{"type":"verse","number":6,"content":[{"text":"“Ngenxa yokuthi abantu laba sebewalile","poem":1},{"text":"amanzi ageleza kuhle aseShilowa","poem":2},{"text":"bethokozela uRezini","poem":1},{"text":"lendodana kaRemaliya,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ngakho-ke iNkosi isiseduze ukubalethela","poem":1},{"text":"izikhukhula zamanzi ezilamandla,","poem":2},{"lineBreak":true},{"text":"eziyinkosi yase-Asiriya lobukhosi bayo bonke,","poem":2},{"lineBreak":true},{"text":"zivela eYufrathe.","poem":2},{"text":"Azachithekela ngaphandle kwayo yonke imigelo yawo,","poem":1},{"text":"ageleze phezu kwamakhumbi ayo wonke,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"afohlele koJuda, agcwale kulo,","poem":1},{"text":"adlule phakathi kwalo efika entanyeni.","poem":2},{"text":"Impiko zawo ezeluliweyo","poem":1},{"text":"zizakwembesa ububanzi belizwe lakho,","poem":2},{"lineBreak":true},{"text":"Awu, Emanuweli!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Hlabani umkhosi wempi lina zizwe, lichithwe!","poem":1},{"text":"Lalelani lonke lina mazwe akude.","poem":2},{"text":"Lungiselani impi, lichithwe!","poem":1},{"text":"Lungiselani impi lichithwe!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lungisani icebo lenu, kodwa kalisoze liphumelele:","poem":1},{"text":"bumbani isu lenu, kodwa kaliyikuma,","poem":2},{"lineBreak":true},{"text":"ngoba uNkulunkulu ulathi.","poem":2}]},{"type":"heading","content":["Mesabeni UThixo"]},{"type":"verse","number":11,"content":["UThixo wakhuluma kimi isandla sakhe esilamandla siphezu kwami, engixwayisa ukuba ngingalandeli indlela yalababantu. Wathi:"]},{"type":"verse","number":12,"content":[{"text":"“Ungabokuthi kungamacebo amabi","poem":1},{"text":"konke abantu laba abathi kungamacebo amabi;","poem":2},{"text":"ungakwesabi abakwesabayo","poem":1},{"text":"njalo ungakuqhuqhi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"UThixo uSomandla","poem":1},{"text":"nguye okumele limazi engongcwele,","poem":2},{"text":"nguye okumele limesabe,","poem":1},{"text":"nguye okumele limqhuqhe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Uzakuba yisiphephelo;","poem":1},{"text":"kodwa kuzo zombili izindlu zako-Israyeli","poem":2},{"text":"uzakuba yilitshe elikhubekisa abantu","poem":1},{"text":"ledwala elibenza bawe.","poem":2},{"text":"Ebantwini baseJerusalema uzakuba","poem":1},{"text":"yisifu lomjibila.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Inengi labo lizakhubeka;","poem":1},{"text":"bazakuwa bephuke,","poem":2},{"lineBreak":true},{"text":"bazathiywa bathunjwe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bopha ubufakazi besixwayiso,","poem":1},{"text":"uqinise umthetho phakathi kwabafundi bakaNkulunkulu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngizamlindela uThixo,","poem":1},{"text":"ofihlela indlu kaJakhobe ubuso bakhe.","poem":2},{"text":"Ngizabeka ithemba lami kuye.","poem":1}]},{"type":"verse","number":18,"content":["Mina ngilapha, kanye labantwana uThixo angiphe bona. Siyizibonakaliso lempawu ku-Israyeli ezivela kuThixo uSomandla, ohlala entabeni iZiyoni."]},{"type":"heading","content":["Ubumnyama Buphenduka Ukukhanya"]},{"type":"verse","number":19,"content":["Nxa abantu bekutshela ukuthi buza abalamadlozi labalemimoya yobuthakathi, labanyenyezayo bengunguza, kambe abantu akumelanga babuzisise uNkulunkulu wabo na? Kungani abaphilayo libabuzela kwabafayo na?"]},{"type":"verse","number":20,"content":["Emthethweni lakubo ubufakazi! Nxa bengakhulumi ngokumayelana lelizwi leli, kabalakho ukukhanya kokusa."]},{"type":"verse","number":21,"content":["Bazazula lelizwe behlulukelwe, belambile. Lapho sebephalwe yindlala, bazathukuthela, bathuke inkosi yabo loNkulunkulu wabo bekhangele phezulu."]},{"type":"verse","number":22,"content":["Emva kwalokho bazakhangela emhlabeni babone usizi kuphela, lomnyama owesabekayo, njalo bazaphoselwa emnyameni opheleleyo."]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}