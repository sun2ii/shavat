{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"ISA","translationId":"nde_bib","name":"U-Isaya","commonName":"U-Isaya","title":"U-Isaya","order":23,"numberOfChapters":66,"sha256":"3d14aef8938d04db738731f69ed18a47d7cd8cec678310974636b365c5df4c0e","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/nde_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":9,"content":[{"type":"heading","content":["Sizalelwe Umntwana"]},{"type":"verse","number":1,"content":["Kodwa-ke akusayikuba khona ukudangala kulabo ababesosizini. Ensukwini ezedlulayo walithobisa ilizwe likaZebhuluni lelizwe likaNafithali. Kodwa ensukwini ezizayo uzayipha udumo iGalile yabezizweni, eNdleleni eya oLwandle elandela iJodani:"]},{"type":"verse","number":2,"content":[{"text":"Abantu abahamba emnyameni","poem":1},{"text":"sebebone ukukhanya okukhulu;","poem":2},{"text":"kulabo abahlala elizweni lethunzi lokufa","poem":1},{"text":"ukukhanya sekukhanyisile.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Usikhulisile isizwe","poem":1},{"text":"wandisa intokozo yabo,","poem":2},{"text":"bayathokoza phambi kwakho","poem":1},{"text":"njengabantu bethokoza ekuvuneni,","poem":2},{"text":"njengempi ithokoza","poem":1},{"text":"isaba impango.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngoba njengamhla wokwehlulwa kukaMidiyani","poem":1},{"text":"usulephule ijogwe elibasindayo,","poem":2},{"text":"umgoqo onqume emahlombe abo,","poem":1},{"text":"intonga yomncindezeli wabo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lonke inyathela lebutho elisetshenziswe empini,","poem":1},{"text":"kanye lazozonke izigqoko ezigiqwe egazini","poem":2},{"text":"kuzakuya ekutshisweni;","poem":1},{"text":"kuzakuba ngokokubasisa umlilo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngoba sizalelwe umntwana,","poem":1},{"text":"siphiwe indodana,","poem":2},{"lineBreak":true},{"text":"umbuso uzakuba phezu kwamahlombe akhe.","poem":2},{"text":"Uzabizwa ngokuthi","poem":1},{"text":"uMeluleki Omangalisayo, uNkulunkulu uSomandla,","poem":2},{"lineBreak":true},{"text":"uBaba Waphakade, iNkosana yokuThula.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ukwanda kombuso wakhe lokuthula","poem":1},{"text":"akuyikuba lomkhawulo.","poem":2},{"text":"Uzabusa esihlalweni sobukhosi sikaDavida","poem":1},{"text":"laphezu kombuso wakhe,","poem":2},{"text":"ewumisa njalo ewuqinisa","poem":1},{"text":"ngokufaneleyo langokulunga,","poem":2},{"lineBreak":true},{"text":"kusukela ngalesisikhathi kuze kube nini lanini.","poem":2},{"text":"Ukutshiseka kukaThixo uSomandla","poem":1},{"text":"kuzakufeza lokhu.","poem":2}]},{"type":"heading","content":["UThixo Uthukuthelele Abako-Israyeli"]},{"type":"verse","number":8,"content":[{"text":"INkosi isithumele ilizwi lesixwayiso kuJakhobe","poem":1},{"text":"lizakwehlela phezu kuka-Israyeli.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abantu bonke bazakwazi","poem":1},{"text":"u-Efrayimi labakhele eSamariya,","poem":2},{"text":"abathi ngokuzigqaja","poem":1},{"text":"langokuzikhukhumeza kwenhliziyo,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Izitina sezidilikele phansi,","poem":1},{"text":"kodwa sizakwakha njalo ngamatshe abaziweyo;","poem":2},{"text":"imikhiwa isiganyulelwe phansi,","poem":1},{"text":"kodwa sizafaka imisedari endaweni yayo.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kodwa uThixo usebaqinisele izitha zikaRezini,","poem":1},{"text":"njalo usetshotshozele izitha zabo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ama-Aramu avela empumalanga lamaFilistiya avela entshonalanga","poem":1},{"text":"asedle u-Israyeli ngomlomo ovulekileyo.","poem":2},{"lineBreak":true},{"text":"Kodwa kukho konke lokhu, ukuthukuthela kwakhe akupheli,","poem":1},{"text":"isandla sakhe silokhu siphakanyisiwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kodwa abantu abakabuyeli kuye owabatshayayo.","poem":1},{"text":"Loba badinge uThixo uSomandla.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngakho uThixo uzaquma ko-Israyeli ikhanda lomsila,","poem":1},{"text":"ugatsha lwelala lomhlanga ngasuku lunye;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"abadala lezikhulu balikhanda,","poem":1},{"text":"abaphrofethi abafundisa amanga bangumsila.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Labo abakhokhela abantu laba bayabalahlekisa,","poem":1},{"text":"labo abakhokhelwayo bayedukiswa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngakho iNkosi kayiyikuthokoza ngezinsizwa zabo,","poem":1},{"text":"izintandane labafelokazi kayiyikuba lozwelo kubo,","poem":2},{"text":"ngoba bonke bayameyisa uNkulunkulu, njalo babi;","poem":1},{"text":"imilomo yonke ikhuluma amanyala.","poem":2},{"lineBreak":true},{"text":"Kodwa kukho konke lokhu,","poem":1},{"text":"ukuthukuthela kwayo akupheli,","poem":2},{"lineBreak":true},{"text":"isandla sayo silokhu siphakanyisiwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ngeqiniso ububi butshisa njengomlilo,","poem":1},{"text":"budla ukhula lameva,","poem":2},{"text":"buthungela izixuku zehlathi zivuthe amalangabi","poem":1},{"text":"izikhatha zentuthu ziqonga zisiya phezulu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ngolaka lukaThixo uSomandla","poem":1},{"text":"ilizwe lizatshiswa,","poem":2},{"text":"abantu bazakuba zinkuni zomlilo,","poem":1},{"text":"kakho ozaphephisa umfowabo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bazaqeda kwesokudla","poem":1},{"text":"kodwa babe belokhu belambile;","poem":2},{"text":"bazakudla kwesokhohlo,","poem":1},{"text":"kodwa bangasuthi.","poem":2},{"text":"Omunye lomunye uzakudla abantwabakhe:","poem":1}]},{"type":"verse","number":21,"content":[{"text":"UManase uzakudla u-Efrayimi, u-Efrayimi adle uManase;","poem":2},{"lineBreak":true},{"text":"bobabili bazamelana loJuda.","poem":2},{"lineBreak":true},{"text":"Kukho konke lokhu, ukuthukuthela kwakhe akupheli,","poem":1},{"text":"isandla sakhe silokhu siphakanyisiwe.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}