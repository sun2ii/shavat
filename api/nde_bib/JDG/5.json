{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JDG","translationId":"nde_bib","name":"Abahluleli","commonName":"Abahluleli","title":"Abahluleli","order":7,"numberOfChapters":21,"sha256":"bc82565a1c4150a465b80c2c2116ea4a3ae262f7be2b23b3be57567b6add54f3","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/nde_bib/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"heading","content":["Ingoma KaDibhora"]},{"type":"verse","number":1,"content":["Ngalolosuku uDibhora loBharakhi indodana ka-Abhinowami bahlabela ingoma le:"]},{"type":"verse","number":2,"content":[{"text":"“Lapho amakhosana ko-Israyeli esekhokhela,","poem":1},{"text":"lapho abantu bezinikela ngokuzithandela,","poem":2},{"lineBreak":true},{"text":"dumisani uThixo!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Zwanini lokhu lina makhosi! Lalelani lina babusi!","poem":1},{"text":"Ngizahlabelela kuThixo,","poem":2},{"lineBreak":true},{"text":"ngizahlabelela;","poem":2},{"text":"ngizahubela ihubo,","poem":1},{"text":"kuThixouNkulunkulu ka-Israyeli.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Awu Thixo, ekuqhamukeni kwakho eSeyiri,","poem":1},{"text":"lapho usuka elizweni lase-Edomi,","poem":2},{"text":"umhlaba wanyikinyeka, amazulu athululeka,","poem":1},{"text":"amayezi athululela amanzi phansi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Izintaba zazamazama phambi kukaThixo, yena owaseSinayi,","poem":1},{"text":"phambi kukaThixo, uNkulunkulu ka-Israyeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ensukwini zikaShamigari indodana ka-Anathi,","poem":1},{"text":"ensukwini zikaJayeli, imigwaqo yayideliwe;","poem":2},{"lineBreak":true},{"text":"izihambi zithatha izindledlana ezimazombe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Izakhamizi zako-Israyeli kazizange zilwe,","poem":1},{"text":"zahlehlela emuva kwaze kwavela mina Dibhora,","poem":2},{"lineBreak":true},{"text":"kwavela umama ko-Israyeli.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"UNkulunkulu wakhetha abakhokheli abatsha","poem":1},{"text":"lapho impi isifike emasangweni edolobho,","poem":2},{"text":"kodwa akulahawu kumbe umkhonto owabonakalayo","poem":1},{"text":"phakathi kwezinkulungwane ezingamatshumi amane ko-Israyeli.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inhliziyo yami ikanye lamakhosana ako-Israyeli,","poem":1},{"text":"kanye labazinikela ngokuzithandela phakathi kwabantu.","poem":2},{"lineBreak":true},{"text":"Dumisani uThixo!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Lina eligada obabhemi abamhlophe,","poem":1},{"text":"lihlezi ezihlalweni zenu zengubo,","poem":2},{"lineBreak":true},{"text":"lani elihamba emgwaqweni","poem":2},{"text":"cabangani","poem":1}]},{"type":"verse","number":11,"content":[{"text":"ilizwi labahlabeleli ezindaweni zamanzi okunathisa.","poem":1},{"text":"Bahuba ngokulunga kukaThixo,","poem":2},{"lineBreak":true},{"text":"ukunqoba kwezakhamizi zako-Israyeli.","poem":2},{"lineBreak":true},{"text":"Lapho-ke abantu bakaThixo","poem":1},{"text":"behlela emasangweni edolobho.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"‘Vuka, vuka, Dibhora!","poem":1},{"text":"Vuka, vuka, uhlabele ingoma!","poem":2},{"text":"Vuka weBharakhi!","poem":1},{"text":"Uthumbe abathunjiweyo bakho, wena ndodana ka-Abhinowami.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ngakho abantu ababesele bafika ezikhulwini;","poem":1},{"text":"abantu bakaThixo beza kimi labalamandla.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abanye bavela ko-Efrayimi, abamdabuko wabo use-Amaleki;","poem":1},{"text":"uBhenjamini wayelabantu abakulandelayo.","poem":2},{"text":"Izinduna zamabutho zavela eMakhiri,","poem":1},{"text":"koZebhuluni labo abaphatha intonga yomlawuli webutho.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Amakhosana ako-Isakhari ayeloDibhora;","poem":1},{"text":"yebo, u-Isakhari wayeloBharakhi","poem":2},{"lineBreak":true},{"text":"emxhuma ngesiqubu ezigodini.","poem":2},{"text":"Eziqintini zakoRubheni","poem":1},{"text":"kwaba lokuhlolwa okukhulu kwezinhliziyo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Lahlalelani ezibayeni","poem":1},{"text":"ukuzwa amakhwelo enqanda izimvu na?","poem":2},{"text":"Eziqintini zakoRubheni,","poem":1},{"text":"kwaba lokuhlolwa okukhulu kwezinhliziyo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"UGiliyadi wahlala ngaphetsheya kweJodani.","poem":1},{"text":"LoDani wasalelani ngasemikhunjini na?","poem":2},{"text":"U-Asheri wasala ngasokhunjini","poem":1},{"text":"wahlala emathekwini akhe olwandle.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Abantu bakoZebhuluni bafaka impilo yabo uqobo engozini;","poem":1},{"text":"wenza njalo loNafithali emiqolweni yeganga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Amakhosi afika, alwa;","poem":1},{"text":"amakhosi aseKhenani alwa,","poem":2},{"text":"eThanakhi ngasemachibini aseMegido,","poem":1},{"text":"kodwa kawazathwala isiliva, lempango.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Izinkanyezi zalwa zisemazulwini,","poem":1},{"text":"zalwa loSisera zisezindleleni zazo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Umfula uKhishoni wabakhukhula,","poem":1},{"text":"umfula wendulo, umfula uKhishoni.","poem":2},{"lineBreak":true},{"text":"Phambili, mphefumulo wami; Qina!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kwaduma amasondo amabhiza ematha,","poem":1},{"text":"ematha ehamba amabhiza akhe alamandla.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"‘Iqalekiseni iMerozi,’ kwatsho ingilosi kaThixo,","poem":1},{"text":"‘Baqalekiseni kabuhlungu abantu bayo,","poem":2},{"text":"ngoba kabezanga ukuzencedisa uThixo,","poem":1},{"text":"ukuzasiza uThixo emelane labalamandla.’","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kabe ngobusiswe kakhulu kwabesifazane uJayeli,","poem":1},{"text":"umkaHebheri umKheni,","poem":2},{"lineBreak":true},{"text":"obusiswe kakhulu kwabesifazane abahlala emathenteni.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Wacela amanzi, yena wamnika uchago,","poem":1},{"text":"wamlethela amasi ngomganu ofanele izikhulu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Wathatha isikhonkwane sethente ngesandla sakhe,","poem":1},{"text":"isandla sakhe sokudla sathatha isando somkhandi.","poem":2},{"text":"Watshaya uSisera, wachoboza ikhanda lakhe,","poem":1},{"text":"waphahaza wabhoboza inhlafuno yakhe.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Wawohlokela ezinyaweni zakhe,","poem":1},{"text":"wawa; wabhazalala khonapho.","poem":2},{"text":"Wawohlokela ezinyaweni zakhe wawa;","poem":1},{"text":"lapho awohlokela khona, wawela khonapho esefile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"UnakaSisera walunguza ngefasitela;","poem":1},{"text":"ngemva kwewindi wanqolonga wathi,","poem":2},{"text":"‘Kungani inqola yakhe yempi iphuze kangaka ukufika?","poem":1},{"text":"Kungani ukugodlozela kwezinqola zakhe zempi kuphuzile?’","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ohlakaniphe kakhulu kumakhosazana akhe wamphendula;","poem":1},{"text":"impela yena uhlezi ezitshela esithi,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"‘Kanti kabafumani mpango bayabelane na;","poem":1},{"text":"intombazana loba amabili indoda nganye,","poem":2},{"text":"izigqoko ezimibalabala eziyimpango kaSisera,","poem":1},{"text":"izigqoko ezimibalabala ezicecisiweyo,","poem":2},{"text":"izigqoko eziceciswe kakhulu zentamo yami,","poem":1},{"text":"konke lokhu kuyimpango?’","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ngakho sengathi zingabhubha zonke izitha zakho, Oh Thixo!","poem":1},{"text":"Kodwa sengathi labo abakuthandayo bangaba njengelanga","poem":2},{"lineBreak":true},{"text":"lapho liphuma ngamandla alo.”","poem":2},"Kwasekusiba lokuthula elizweni iminyaka engamatshumi amane."]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}