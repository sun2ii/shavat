azikhulumi,","poem":2},{"text":"kumele zithwalwe","poem":1},{"text":"ngoba azingeke zihambe.","poem":2},{"text":"Lingazesabi,","poem":1},{"text":"azingeke zenze okubi,","poem":2},{"lineBreak":true},{"text":"lokuhle azingeke zikwenze.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kakho ofana lawe, wena Thixo,","poem":1},{"text":"wena umkhulu,","poem":2},{"lineBreak":true},{"text":"lebizo lakho lilamandla amakhulu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngubani ongeke akwesabe,","poem":1},{"text":"wena Nkosi yezizwe?","poem":2},{"lineBreak":true},{"text":"Lokhu kukufanele.","poem":2},{"text":"Phakathi kwabantu bonke abahlakaniphileyo bezizwe","poem":1},{"text":"lakuyo yonke imibuso yabo,","poem":2},{"lineBreak":true},{"text":"kakho onjengawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bonke kabalangqondo njalo bayizithutha,","poem":1},{"text":"bafundiswa yizithombe zezigodo eziyize.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isiliva esikhandiweyo siyalethwa sivela eThashishi","poem":1},{"text":"legolide livela e-Ufazi.","poem":2},{"text":"Okwenziwe yingcwethi lomkhandi wegolide","poem":1},{"text":"kugqokiswa okuluhlaza lokuyibubende,","poem":2},{"lineBreak":true},{"text":"njalo konke kwenziwe zingcitshi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kodwa uThixo unguNkulunkulu oqotho,","poem":1},{"text":"unguNkulunkulu ophilayo, iNkosi yanininini.","poem":2},{"text":"Lapho ethukuthele, umhlaba uyagedezela,","poem":1},{"text":"izizwe azingeke zimelane lolaka lwakhe.","poem":2}]},{"type":"verse","number":11,"content":["“Batshele lokhu uthi, onkulunkulu laba, abangawenzanga amazulu lomhlaba, bazabhubha emhlabeni langaphansi kwamazulu.”"]},{"type":"verse","number":12,"content":[{"text":"Kodwa uNkulunkulu wenza umhlaba ngamandla akhe,","poem":1},{"text":"wamisa umhlaba ngokuhlakanipha kwakhe,","poem":2},{"lineBreak":true},{"text":"njalo wendlala lamazulu ngokuqedisisa kwakhe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lapho evungama, amanzi asemazulwini ayahlokoma,","poem":1},{"text":"wenza amayezi aphakame evela emikhawulweni yomhlaba.","poem":2},{"text":"Uthumela umbane ulezulu","poem":1},{"text":"njalo akhuphe umoya eziphaleni zakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Abantu bonke kabalangqondo njalo kabalalwazi,","poem":1},{"text":"wonke umkhandi wegolide uyangiswa yizithombe zakhe.","poem":2},{"text":"Izithombe zakhe azenzayo ziyinkohliso,","poem":1},{"text":"kazilamphefumulo phakathi kwazo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ziyize, izinto zenhlekisa nje,","poem":1},{"text":"lapho ukwahlulelwa kwazo sekufikile,","poem":2},{"lineBreak":true},{"text":"zizabhubha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Lowo oyiNgxenye kaJakhobe kafani lalaba,","poem":1},{"text":"ngoba unguMenzi wezinto zonke,","poem":2},{"text":"kubalwa lo-Israyeli,","poem":1},{"text":"isizwe selifa lakhe,","poem":2},{"lineBreak":true},{"text":"ibizo lakhe nguThixo uSomandla.","poem":2}]},{"type":"heading","content":["Ukubhujiswa Okuzayo"]},{"type":"verse","number":17,"content":[{"text":"Qoqani impahla yenu ukuba lisuke elizweni,","poem":1},{"text":"lina elihlezi livinjezelwe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngoba uThixo uthi,","poem":1},{"text":"“Ngalesisikhathi ngizabaphosela phandle labo abahlala kulelilizwe,","poem":2},{"text":"ngizabehlisela usizi","poem":1},{"text":"ukuze bathunjwe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Maye mina ngenxa yokulimala kwami!","poem":1},{"text":"Inxeba lami kalelapheki!","poem":2},{"text":"Ikanti ngazitshela ngathi,","poem":1},{"text":"“Lo ngumkhuhlane wami, njalo kumele ngiwubekezelele.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ithente lami lidiliziwe,","poem":1},{"text":"izintambo zalo zonke ziqumekile.","poem":2},{"text":"Amadodana ami asukile kimi njalo kawasekho,","poem":1},{"text":"kakho oseleyo ukuba angimisele ithente lami,","poem":2},{"lineBreak":true},{"text":"loba ongangilungisela amakhetheni ami.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Abelusi kabalangqondo","poem":1},{"text":"njalo kabambuzi uThixo,","poem":2},{"text":"ngakho kabaphumeleli,","poem":1},{"text":"njalo lemihlambi yabo yonke ihlakazekile.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Lalelani! Umbiko uyeza,","poem":1},{"text":"ukuxokozela okukhulu okuvela elizweni lenyakatho!","poem":2},{"text":"Kuzakwenza amadolobho akoJuda achitheke,","poem":1},{"text":"abe yizikhundla zamakhanka.","poem":2}]},{"type":"heading","content":["Umkhuleko KaJeremiya"]},{"type":"verse","number":23,"content":[{"text":"Ngiyazi, Oh Thixo, ukuthi ukuphila komuntu akusikho kwakhe,","poem":1},{"text":"umuntu akusikho kwakhe ukuthi aqondise izinyathelo zakhe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ngiqondise Thixo, kodwa kube ngokulunga,","poem":1},{"text":"kungabi ngolaka lwakho,","poem":2},{"lineBreak":true},{"text":"hlezi ungenze ngibe yize.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yehlisela ulaka lwakho phezu kwezizwe","poem":1},{"text":"ezingakwamukeliyo,","poem":2},{"lineBreak":true},{"text":"phezu kwabantu abangakhuleki ebizweni lakho.","poem":2},{"text":"Ngoba bamdlile uJakhobe,","poem":1},{"text":"bamdlile waphela bachitha lelizwe lakhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/9.json","previousChapterAudioLinks":{},"numberOfVerses":25}