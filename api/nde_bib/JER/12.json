{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":12,"content":[{"type":"heading","content":["Insolo KaJeremiya"]},{"type":"verse","number":1,"content":[{"text":"Wena ulungile izikhathi zonke,","poem":1},{"text":"Oh Thixo, lapho ngiletha indaba kuwe.","poem":2},{"text":"Ikanti ngingakhuluma lawe ngokulunga kwakho:","poem":1},{"text":"Kungani indlela yababi iphumelela na?","poem":2},{"lineBreak":true},{"text":"Kungani abangathembekanga behlezi kuhle na?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ubahlanyele, njalo sebemilile;","poem":1},{"text":"bayakhula bathele izithelo.","poem":2},{"text":"Bahlezi bekhuluma ngawe,","poem":1},{"text":"kodwa ezinhliziyweni zabo ukhatshana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kodwa mina, Oh Thixo, uyangazi;","poem":1},{"text":"uyangibona uhlole imicabango yami ngawe.","poem":2},{"text":"Bahudule njengezimvu eziyahlatshwa!","poem":1},{"text":"Bamisele usuku lokubulawa!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Koze kube nini ilizwe lomile","poem":1},{"text":"lotshani iganga lonke bubunile?","poem":2},{"text":"Ngenxa yokuthi labo abahlala kulo babi,","poem":1},{"text":"izinyamazana lezinyoni sezibhubhile.","poem":2},{"text":"Kanti futhi abantu bathi,","poem":1},{"text":"“Kasoze akubone okwenzakala kithi.”","poem":2}]},{"type":"heading","content":["Impendulo KaNkulunkulu"]},{"type":"verse","number":5,"content":[{"text":"“Nxa ugijime labantu ngezinyawo","poem":1},{"text":"bakudinisa,","poem":2},{"lineBreak":true},{"text":"ungancintisana njani lamabhiza na?","poem":2},{"text":"Nxa ukhubeka elizweni elingelangozi,","poem":1},{"text":"pho uzakwanelisa njani ezixukwini zaseJodani na?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abafowenu, abendlu yakwenu","poem":1},{"text":"labo futhi bakunikele;","poem":2},{"lineBreak":true},{"text":"baklabalale batsho okubi ngawe.","poem":2},{"text":"Ungabathembi,","poem":1},{"text":"lanxa bekhuluma kuhle ngawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Indlu yami ngizayitshiya,","poem":1},{"text":"ngilidele ilifa lami;","poem":2},{"text":"lowo engimthandayo","poem":1},{"text":"ngizamnikela ezandleni zezitha zakhe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ilifa lami kimi selibe","poem":1},{"text":"njengesilwane ehlathini.","poem":2},{"text":"Liyangihwabhela;","poem":1},{"text":"ngakho ngiyalizonda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ilifa lami kimi kaselibe","poem":1},{"text":"njengenyoni emabalabala edla inyama ehanqwa","poem":2},{"lineBreak":true},{"text":"ngezinye izinyoni ezidla inyama, ziyihlasela na?","poem":2},{"text":"Hamba uyebutha zonke izinyamazana zeganga;","poem":1},{"text":"uzilethe ukuba zidle.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abelusi abanengi bazasichitha isivini sami","poem":1},{"text":"bagandele insimu yami;","poem":2},{"text":"bazaguqula insimu yami enhle","poem":1},{"text":"ibe lugwadule oluphundlekileyo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Izakwenziwa ugwadule,","poem":1},{"text":"yome iphundlekile phambi kwami;","poem":2},{"text":"ilizwe lonke lizachitheka","poem":1},{"text":"ngoba kakho olinakayo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Emiqolweni yonke engelalutho enkangala","poem":1},{"text":"abachithi bazaphithizela,","poem":2},{"text":"ngoba inkemba kaThixo","poem":1},{"text":"izakudla kusukela komunye umkhawulo welizwe kusiya komunye;","poem":2},{"lineBreak":true},{"text":"kakho ozavikeleka.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bazahlanyela ingqoloyi kodwa bavune ameva;","poem":1},{"text":"bazazidinisa kodwa bangazuzi lutho.","poem":2},{"text":"Ngakho wobani lenhloni ngesivuno senu","poem":1},{"text":"ngenxa yolaka olwesabekayo lukaThixo.”","poem":2}]},{"type":"verse","number":14,"content":["UThixo uthi: “Bonke omakhelwane bami ababi abathumba ilifa engalinika abantu bami bako-Israyeli, ngizabasusa emazweni abo ngisuse lendlu kaJuda phakathi kwabo."]},{"type":"verse","number":15,"content":["Kodwa emva kokubasusa kwami, ngizaphinda ngibe lesihawu ngibuyisele omunye lomunye wabo endaweni eyilifa lakhe elizweni lakhe."]},{"type":"verse","number":16,"content":["Bangazifunda kuhle izindlela zabantu bami njalo bafunge ngebizo lami besithi, ‘Ngeqiniso elinjengoba uThixo ephila’ lanxa nje bake bafundisa abantu bami ukufunga ngoBhali, bazahlaliswa phakathi kwabantu bami."]},{"type":"verse","number":17,"content":["Kodwa nxa isizwe singalaleli, ngizasisusa ngokupheleleyo ngisibhubhise,” kutsho uThixo."]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}