{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":13,"content":[{"type":"heading","content":["Ibhanti LeLineni"]},{"type":"verse","number":1,"content":["UThixo wathi kimi: “Hamba uyethenga ibhanti lelineni ubophe ukhalo lwakho ngalo, kodwa lingathinti amanzi.”"]},{"type":"verse","number":2,"content":["Ngakho ngathenga ibhanti, njengokulaya kukaThixo, ngabopha ukhalo lwami ngalo."]},{"type":"verse","number":3,"content":["Ilizwi likaThixo labuya lafika kimi ngokwesibili lathi:"]},{"type":"verse","number":4,"content":["“Thatha ibhanti olithengileyo obophe ngalo ukhalo lwakho, uye eYufrathe, khathesi nje ulifihle khona eminkenkeni yamatshe.”"]},{"type":"verse","number":5,"content":["Ngakho ngahamba ngayalifihla eYufrathe, njengokutsho kukaThixo kimi."]},{"type":"verse","number":6,"content":["Sekudlule insuku ezinengi uThixo wathi kimi, “Hamba khathesi eYufrathe uyethatha ibhanti engathi lifihle khona.”"]},{"type":"verse","number":7,"content":["Ngakho ngaya eYufrathe ngagebha lapho engangifihle khona ibhanti, kodwa laselonakele impela lingaselasizo."]},{"type":"verse","number":8,"content":["Lapho-ke kwafika ilizwi likaThixo kimi lisithi:"]},{"type":"verse","number":9,"content":["“UThixo uthi: ‘Ngendlela efanayo ngizakuchitha ukuzigqaja kukaJuda lokuzigqaja okukhulu kweJerusalema."]},{"type":"verse","number":10,"content":["Lababantu abangalunganga, abalayo ukulalela amazwi ami, abalandela ubulukhuni bezinhliziyo zabo badinge abanye onkulunkulu ukuba babasebenzele njalo babakhonze, bazakuba njengebhanti leli, bengelasizo loluncane!"]},{"type":"verse","number":11,"content":["Ngoba njengebhanti libopha ukhalo lomuntu, ngayibophela kanjalo kimi yonke indlu ka-Israyeli layo yonke indlu kaJuda, kutsho uThixo, ukuba babengabantu bami ngenxa yodumo lwami, ukubongwa lokudunyiswa. Kodwa kabalalelanga.’ ”"]},{"type":"heading","content":["Izikhumba Zewayini"]},{"type":"verse","number":12,"content":["“Batshele uthi, ‘UThixo, uNkulunkulu ka-Israyeli uthi, zonke izikhumba zewayini kumele zigcwaliswe ngewayini.’ Bona bangathi kuwe, ‘Kanti thina kasikwazi yini ukuthi izikhumba zonke kumele zigcwaliswe ngewayini?’"]},{"type":"verse","number":13,"content":["wena uthi kubo, ‘UThixo uthi: Ngizabenza badakwe bonke abahlala kulelilizwe, kanye lamakhosi ahlala esihlalweni sobukhosi sikaDavida, abaphristi, abaphrofethi labo bonke abahlala eJerusalema."]},{"type":"verse","number":14,"content":["Ngizabamahlaza omunye komunye, oyise lamadodana ngokufananayo, kutsho uThixo. Angiyikuvumela isihawu loba umusa kumbe uzwelo ukuba kungivimbele ukubabhubhisa.’ ”"]},{"type":"heading","content":["Isisongo Sokuthunjwa"]},{"type":"verse","number":15,"content":[{"text":"Zwanini lilalele,","poem":1},{"text":"lingazigqaji,","poem":2},{"lineBreak":true},{"text":"ngoba uThixo usekhulumile.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dumisani uThixo uNkulunkulu wenu","poem":1},{"text":"engakalethi ubumnyama,","poem":2},{"text":"inyawo zenu zingakakhubeki","poem":1},{"text":"emaqaqeni asesembeswa yibumnyama.","poem":2},{"text":"Lilindele ukukhanya,","poem":1},{"text":"kodwa yena uzakwenza kube yibumnyama,","poem":2},{"lineBreak":true},{"text":"akuphendule kube yibumnyama obesabekayo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kodwa nxa lingalaleli,","poem":1},{"text":"ngizakhalela ensitha","poem":2},{"lineBreak":true},{"text":"ngenxa yokuzigqaja kwenu;","poem":2},{"text":"amehlo ami azalila kabuhlungu,","poem":1},{"text":"ageleze inyembezi,","poem":2},{"lineBreak":true},{"text":"ngoba umhlambi kaThixo uzathunjwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Tshono enkosini lasendlovukazini uthi,","poem":1},{"text":"“Yehlani ezihlalweni zenu zobukhosi lize phansi,","poem":2},{"text":"ngoba imiqhele yenu emihle kakhulu","poem":1},{"text":"izakuwa emakhanda enu.”","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Amadolobho aseNegebi azavalwa,","poem":1},{"text":"njalo akuyikuba khona ozawavula.","poem":2},{"text":"UJuda wonke uzathathwa asiwe ekuthunjweni,","poem":1},{"text":"uzasiwa ekuthunjweni ngokupheleleyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Phakamisani amehlo enu libone","poem":1},{"text":"labo abavela enyakatho.","poem":2},{"text":"Ungaphi umhlambi ababewugcinisiwe,","poem":1},{"text":"izimvu elalizazisa ngazo na?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Lizakuthini lapho uThixo esebabeka phezu kwenu","poem":1},{"text":"labo elabenza babangabangane benu abaqakathekileyo na?","poem":2},{"text":"Kaliyikubanjwa yibuhlungu","poem":1},{"text":"obufana lobowesifazane ehelelwa na?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Njalo nxa uzibuza usithi,","poem":1},{"text":"“Kungani lokhu kwenzakele kimi na?”","poem":2},{"text":"Kungenxa yezono zakho ezinengi","poem":1},{"text":"ukuthi izidwaba zakho zidatshulwe","poem":2},{"lineBreak":true},{"text":"lomzimba wakho waphathwa kubi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"UmTopiya angaliguqula yini ijwabu lakhe","poem":1},{"text":"loba ingwe iguqule amabala ayo na?","poem":2},{"text":"Lani lingeke lenze okuhle","poem":1},{"text":"lina selajwayela ukwenza okubi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Ngizalihlakaza njengamakhoba","poem":1},{"text":"ephetshulwa ngumoya wasenkangala.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Lokhu yikho okungokwenu,","poem":1},{"text":"isabelo engilimisele sona,” kutsho uThixo,","poem":2},{"text":"“ngoba lingikhohliwe","poem":1},{"text":"lathemba onkulunkulu bamanga.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ngizaphekulela izidwaba zakho ebusweni bakho","poem":1},{"text":"ukuba kubonakale ihlazo lakho,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ubufebe bakho lokububuliswa yisigwebo,","poem":1},{"text":"ukufeba kwakho ungelanhloni!","poem":2},{"text":"Ngizibonile izenzo zakho ezenyanyekayo","poem":1},{"text":"phezu kwamaqaqa lasegangeni.","poem":2},{"text":"Maye kuwe, wena Jerusalema!","poem":1},{"text":"Koze kube nini ungahlambulukanga na?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/12.json","previousChapterAudioLinks":{},"numberOfVerses":27}