{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":14,"content":[{"type":"heading","content":["Ukoma, Indlala, Inkemba"]},{"type":"verse","number":1,"content":["Leli yilizwi likaThixo elafika kuJeremiya mayelana lokoma elizweni lisithi:"]},{"type":"verse","number":2,"content":[{"text":"“UJuda uyalila,","poem":1},{"text":"amadolobho akhe ayahlupheka;","poem":2},{"text":"alilela ilizwe,","poem":1},{"text":"njalo isililo siyaqonga sivela eJerusalema.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Izikhulu zithuma izinceku zazo ukuyafuna amanzi;","poem":1},{"text":"ziya emithonjeni","poem":2},{"lineBreak":true},{"text":"kodwa zifice amanzi engekho.","poem":2},{"text":"Ziyabuyela lemigqomo yazo ingelalutho;","poem":1},{"text":"zithithibele njalo zidanile,","poem":2},{"lineBreak":true},{"text":"zemboze amakhanda azo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Umhlabathi uqhekezekile","poem":1},{"text":"ngoba akulazulu elizweni;","poem":2},{"text":"abalimi bathithibele","poem":1},{"text":"njalo bemboze amakhanda abo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lenyamazana ensikazi egangeni","poem":1},{"text":"iyabalekela inkonyane layo elizelweyo","poem":2},{"lineBreak":true},{"text":"ngoba akulatshani.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Obabhemi beganga bema emiqolweni elugwadule","poem":1},{"text":"bakhefuzele njengamakhanka;","poem":2},{"text":"amehlo abo asefiphele","poem":1},{"text":"ngenxa yokuswela amadlelo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lanxa izono zethu zifakaza kubi ngathi,","poem":1},{"text":"Oh Thixo, ake wenze okunye ngenxa yebizo lakho.","poem":2},{"text":"Ngoba ukuhlehlela kwethu emuva kunengi;","poem":1},{"text":"sonile kuwe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Oh Themba lika-Israyeli,","poem":1},{"text":"uMhlengi wakhe ezikhathini zokuhlupheka,","poem":2},{"text":"kungani usiba njengowezizweni elizweni,","poem":1},{"text":"njengesihambi esihlala ubusuku obubodwa kuphela?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kungani usiba njengomuntu ojunyiweyo,","poem":1},{"text":"lanjengebutho elingelamandla okusiza na?","poem":2},{"text":"Ukhona phakathi kwethu, wena Thixo,","poem":1},{"text":"njalo sibizwa ngebizo lakho;","poem":2},{"lineBreak":true},{"text":"ungasilahli!","poem":2}]},{"type":"verse","number":10,"content":["Nanku okutshiwo nguThixo ngalababantu:",{"text":"“Bayakuthanda kakhulu ukuntula;","poem":1},{"text":"kabazibambi inyawo zabo.","poem":2},{"text":"Ngakho uThixo kayikubamukela;","poem":1},{"text":"khathesi uzakhumbula ububi babo","poem":2},{"lineBreak":true},{"text":"abajezisele izono zabo.”","poem":2}]},{"type":"verse","number":11,"content":["UThixo wasesithi kimi, “Ungakhulekeli inhlalakahle yabantu laba."]},{"type":"verse","number":12,"content":["Lanxa bezila ukudla, ukukhala kwabo angiyikukulalela; loba benikela iminikelo yokutshiswa kanye leminikelo yamabele, angiyikuyamukela. Esikhundleni salokho, ngizabaqeda du ngenkemba, ngendlala langezifo.”"]},{"type":"verse","number":13,"content":["Kodwa mina ngathi, “Awu Thixo Wobukhosi, abaphrofethi bahlezi bebatshela besithi, ‘Kaliyikubona inkemba loba libulawe yindlala. Impela, ngizalipha ukuthula okungapheliyo kule indawo.’ ”"]},{"type":"verse","number":14,"content":["UThixo wasesithi kimi, “Abaphrofethi baphrofetha amanga ngebizo lami. Angibathumanga njalo angibakhethanga kumbe ngikhulume labo. Baphrofetha imibono yamanga kini, ukuhlahlula, ukukhonza izithombe lenkohliso yezingqondo zabo."]},{"type":"verse","number":15,"content":["Ngakho-ke, nanku okutshiwo nguThixo ngabaphrofethi abaphrofetha ngebizo lami ukuthi: Kangizange ngibathume, kodwa bona bathi, ‘Akulankemba kumbe indlala ezathinta ilizwe leli.’ Bona labo abaphrofethi bazabhujiswa ngenkemba langendlala."]},{"type":"verse","number":16,"content":["Abantu abaphrofetha kubo bazaphoselwa phandle emigwaqweni yaseJerusalema ngenxa yendlala lenkemba. Akulamuntu ozabangcwaba kumbe omkabo, amadodana abo loba amadodakazi abo. Ngizabehlisela ingozi ebafaneleyo."]},{"type":"verse","number":17,"content":["Khuluma ilizwi leli kubo uthi:",{"text":"‘Amehlo ami kawehlise inyembezi","poem":1},{"text":"ebusuku lemini zingomi;","poem":2},{"text":"ngoba indodakazi yami egcweleyo, labantu bami","poem":1},{"text":"balimele kakhulu,","poem":2},{"lineBreak":true},{"text":"balinyazwe yikutshaywa okwesabekayo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nxa ngingena elizweni,","poem":1},{"text":"ngibona labo ababulawa ngenkemba;","poem":2},{"text":"nxa ngingena edolobheni","poem":1},{"text":"ngibona umonakalo owenziwa yindlala.","poem":2},{"text":"Bobabili umphrofethi lomphristi","poem":1},{"text":"sebeye elizweni abangalaziyo.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"UJuda usumlahle kokuphela na?","poem":1},{"text":"IZiyoni uyaleyisa na?","poem":2},{"text":"Usitshayeleni kangaka","poem":1},{"text":"size singelapheki na?","poem":2},{"text":"Sasilindele ukuthula","poem":1},{"text":"kodwa akulabuhle obaba khona,","poem":2},{"text":"isikhathi sokwelatshwa","poem":1},{"text":"kodwa kulokwesaba kuphela.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Awu Thixo, siyakuvuma ukona kwethu","poem":1},{"text":"kanye lokona kwabokhokho bethu;","poem":2},{"lineBreak":true},{"text":"impela sonile kuwe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ngenxa yebizo lakho ungasenyanyi;","poem":1},{"text":"ungasigconi isihlalo sakho sobukhosi esihle kakhulu.","poem":2},{"text":"Khumbula isivumelwano sakho lathi","poem":1},{"text":"ungasephuli.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Zikhona yini izithombe eziyize zezizwe ezinganisa izulu na?","poem":1},{"text":"Imikhathi yona ngokwayo iyalinisa izulu na?","poem":2},{"text":"Hatshi, nguwe, Thixo Nkulunkulu wethu.","poem":1},{"text":"Ngakho ithemba lethu likuwe,","poem":2},{"lineBreak":true},{"text":"ngoba nguwe owenza konke lokhu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}