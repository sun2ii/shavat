{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":["UThixo wasesithi kimi, “Lanxa uMosi loSamuyeli bengema phambi kwami, inhliziyo yami ingeke iphendukele kulababantu. Basuse phambi kwami! Kabahambe!"]},{"type":"verse","number":2,"content":["Bangakubuza bathi, ‘Sizakuya ngaphi na?’ uthi kubo, uThixo uthi:",{"text":"‘Abamiselwe ukufa, baya ekufeni;","poem":1},{"lineBreak":true},{"text":"abenkemba, enkembeni;","poem":1},{"lineBreak":true},{"text":"abendlala, endlaleni;","poem":1},{"lineBreak":true},{"text":"abokuthunjwa, ekuthunjweni.’","poem":1}]},{"type":"verse","number":3,"content":["Ngizabathumela imihlobo emine yabachithi,” kutsho uThixo, “inkemba yokubulala lezinja zokuhudulela khatshana njalo lezinyoni zasemoyeni kanye lezinyamazana zeganga ukuba zidle zibhuqe."]},{"type":"verse","number":4,"content":["Ngizabenza banengeke emibusweni yonke yasemhlabeni ngenxa yalokho okwenziwa eJerusalema nguManase indodana kaHezekhiya inkosi yakoJuda."]},{"type":"verse","number":5,"content":[{"text":"Ngubani ozakuba lesihawu kuwe wena Jerusalema?","poem":1},{"text":"Ngubani ozakukhalela na?","poem":2},{"lineBreak":true},{"text":"Ngubani ozakuma abuze ukuthi unjani na?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ungalile,”","poem":1},{"text":"kutsho uThixo.","poem":2},{"lineBreak":true},{"text":"“Uqhubeka uhlehlela emuva.","poem":2},{"text":"Ngakho ngizabeka izandla phezu kwakho ngikuchithe;","poem":1},{"text":"ngingeke ngibe lesihawu futhi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngizabahlungula ngefologwe","poem":1},{"text":"yokwela emasangweni amadolobho elizwe.","poem":2},{"text":"Ngizaletha ukufelwa lokuchitheka ebantwini bami,","poem":1},{"text":"ngoba kabaguqulanga izindlela zabo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngizakwenza abafelokazi babo bande kakhulu","poem":1},{"text":"kuletshebetshebe lasolwandle.","poem":2},{"text":"Emini ngizakwehlisela umbulali","poem":1},{"text":"phezu kwabonina bamajaha akibo;","poem":2},{"text":"khonokho ngizabehlisela","poem":1},{"text":"usizi lokwesaba.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Unina wabayisikhombisa uzaqaleka","poem":1},{"text":"aphefumule okokucina.","poem":2},{"text":"Ilanga lakhe lizatshona kusesemini;","poem":1},{"text":"uzayangiswa njalo eyiswe.","poem":2},{"text":"Izinsalela ngizaziqeda ngenkemba","poem":1},{"text":"phambi kwezitha zazo,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Maye, wena mama, ngokuthi wangizala,","poem":1},{"text":"mina muntu ilizwe lonke elibangisana laye njalo liphikisana laye!","poem":2},{"text":"Kangikaze ngebolekise loba ngeboleke,","poem":1},{"text":"kodwa bonke bayangithuka.","poem":2}]},{"type":"verse","number":11,"content":["UThixo wathi,",{"text":"“Ngeqiniso ngizakukhulula ngenjongo enhle;","poem":1},{"text":"ngeqiniso ngizakwenza izitha zakho zikuncenge","poem":2},{"lineBreak":true},{"text":"ezikhathini zomonakalo lezokuhlupheka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Umuntu angayiqamula insimbi,","poem":1},{"text":"insimbi evela enyakatho kumbe ithusi na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Inotho yakho lamatshe akho aligugu","poem":1},{"text":"ngizakwenza kube yimpango, yamahala,","poem":2},{"text":"ngenxa yezono zakho","poem":1},{"text":"kulolonke ilizwe lakini.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngizakwenza ube yisigqili sezitha zakho","poem":1},{"text":"elizweni ongalaziyo,","poem":2},{"text":"ngoba ulaka lwami luzabhebha","poem":1},{"text":"umlilo ozakutshisa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Uyazwisisa wena Thixo;","poem":1},{"text":"ngikhumbula ungikhathalele.","poem":2},{"lineBreak":true},{"text":"Ungiphindiselele kwabangihluphayo.","poem":2},{"text":"Uyabekezela, ungangigudluli;","poem":1},{"text":"khumbula ukuthi ngithukwa njani ngenxa yakho.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ekufikeni kwamazwi akho, ngawadla;","poem":1},{"text":"ayeyintokozo yami lenjabulo yenhliziyo yami,","poem":2},{"text":"ngoba mina ngibizwa ngebizo lakho,","poem":1},{"text":"wena Thixo Nkulunkulu Somandla.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kangizange ngihlale enhlanganisweni yabazithokozisayo,","poem":1},{"text":"kumbe ngijabule labo;","poem":2},{"text":"ngahlala ngedwa ngoba isandla sakho sasiphezu kwami njalo","poem":1},{"text":"wawungenze ngagcwala intukuthelo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kungani ubuhlungu engibuzwayo bungapheli","poem":1},{"text":"lenxeba lami lilibi kakhulu njalo lingelapheki na?","poem":2},{"text":"Kimi uzakuba njengesifula esikhohlisayo,","poem":1},{"text":"lanjengomthombo ongelamanzi na?","poem":2}]},{"type":"verse","number":19,"content":["Ngakho uThixo uthi:",{"text":"“Ungaphenduka, ngizakubuyisela","poem":1},{"text":"ukuze ungikhonze;","poem":2},{"text":"nxa ukhuluma amazwi afaneleyo, hatshi angasizi lutho,","poem":1},{"text":"uzakuba yisikhulumeli sami.","poem":2},{"text":"Abantu laba kabaphendukele kuwe,","poem":1},{"text":"kodwa wena akumelanga uphendukele kubo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ngizakwenza ube ngumduli kulababantu,","poem":1},{"text":"umduli ovikelweyo wethusi;","poem":2},{"text":"bazakulwa lawe","poem":1},{"text":"kodwa kabayikukwehlula,","poem":2},{"text":"ngoba mina ngilawe","poem":1},{"text":"ukuba ngikuhlenge ngikusize,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“Ngizakuhlenga ezandleni zababi","poem":1},{"text":"ngikukhulule ezandleni zabalesihluku.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/14.json","previousChapterAudioLinks":{},"numberOfVerses":21}