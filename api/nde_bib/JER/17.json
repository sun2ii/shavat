{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":17,"content":[{"type":"heading","content":["Inhliziyo Iyakhohlisa"]},{"type":"verse","number":1,"content":[{"text":"“Isono sikaJuda sidwetshwe ngensimbi,","poem":1},{"text":"sabhalwa ngomcijo wedayimani","poem":2},{"text":"ezicecedwini zenhliziyo zabo","poem":1},{"text":"lasempondweni zama-alithare abo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Labantwababo bayawakhumbula","poem":1},{"text":"ama-alithare abo lezinsika zika-Ashera","poem":2},{"text":"phansi kwezihlahla eziluhlaza","poem":1},{"text":"laphezu kwamaqaqa aphakemeyo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Intaba yami eselizweni","poem":1},{"text":"lenotho yenu kanye lemfuyo yenu yonke","poem":2},{"text":"ngizakunikela kube yimpango,","poem":1},{"text":"ndawonye lezindawo zenu eziphakemeyo,","poem":2},{"lineBreak":true},{"text":"ngenxa yokona kulolonke ilizwe lenu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngenxa yezici zenu lizalahlekelwa","poem":1},{"text":"yilifa engalinika lona.","poem":2},{"text":"Ngizalenza libe yizigqili zezitha zenu","poem":1},{"text":"elizweni elingalaziyo,","poem":2},{"text":"ngoba livuse ulaka lwami,","poem":1},{"text":"njalo luzavutha kuze kube nininini.”","poem":2}]},{"type":"verse","number":5,"content":["UThixo uthi:",{"text":"“Uqalekisiwe lowo othemba umuntu,","poem":1},{"text":"othembe ukuthi amandla akhe asenyameni,","poem":2},{"lineBreak":true},{"text":"onhliziyo yakhe ihlamukela uThixo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Uzakuba njengesihlahlanyana enkangala;","poem":1},{"text":"ukuphumelela kayikukubona ekufikeni kwakho.","poem":2},{"text":"Uzahlala ezindaweni ezomileyo enkangala,","poem":1},{"text":"elizweni letswayi elingahlali muntu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kodwa ubusisiwe umuntu othemba uThixo,","poem":1},{"text":"othemba lakhe likuye.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Uzakuba njengesihlahla esihlanyelwe eduze lamanzi","poem":1},{"text":"esinabisela impande zaso esifuleni.","poem":2},{"text":"Kasesabi lapho ukutshisa kufika;","poem":1},{"text":"amahlamvu aso ahlala eluhlaza.","poem":2},{"text":"Kasikhathazeki ngomnyaka wokoma;","poem":1},{"text":"kasiphuthi ukuthela izithelo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Inhliziyo iyakhohlisa okudlula izinto zonke","poem":1},{"text":"njalo imbi kakhulu.","poem":2},{"lineBreak":true},{"text":"Ngubani ongayizwisisa na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Mina Thixo ngiyayihlola inhliziyo","poem":1},{"text":"ngihlole lengqondo,","poem":2},{"text":"ukuba umuntu ngimnike okufanele ukwenza kwakhe mayelana","poem":1},{"text":"lalokho okufanele izenzo zakhe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Umuntu ozuza inotho ngezindlela ezimbi","poem":1},{"text":"unjengesikhwehle esichamisela amaqanda esingawaqandelanga.","poem":2},{"text":"Lapho ingxenye yokuphila kwakhe isidlule, izaphela,","poem":1},{"text":"kuthi ekucineni abonakale eyisithutha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Isihlalo sobukhosi, esikhazimulayo esaphakanyiswayo kusukela ekuqaleni,","poem":1},{"text":"siyindawo yethu yokuphephela.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Awu Thixo, themba lika-Israyeli,","poem":1},{"text":"bonke abakudelayo bazayangiswa.","poem":2},{"text":"Labo abakuhlamukelayo bazabhalwa othulini","poem":1},{"text":"ngoba bedele uThixo,","poem":2},{"lineBreak":true},{"text":"umthombo wamanzi okuphila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ngisilisa, Thixo, njalo ngizasiliswa;","poem":1},{"text":"ungikhulule, ngizakhululeka,","poem":2},{"lineBreak":true},{"text":"ngoba nguwe engimdumisayo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bahlala besithi kimi,","poem":1},{"text":"“Lingaphi ilizwi likaThixo na?","poem":2},{"lineBreak":true},{"text":"Kaligcwaliseke khathesi!”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Angibalekanga ekubeni ngumelusi wenu;","poem":1},{"text":"liyakwazi ukuthi","poem":2},{"lineBreak":true},{"text":"angilufisanga usuku lokuphela ithemba.","poem":2},{"lineBreak":true},{"text":"Okudlula endebeni zami kusobala kini.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ungabi ngowesabekayo kimi;","poem":1},{"text":"uyisiphephelo sami ngosuku lokuhlupheka.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Abangihluphayo kabayangiswe,","poem":1},{"text":"kodwa mina ungivikele ehlazweni;","poem":2},{"text":"kababe lokwesaba,","poem":1},{"text":"kodwa mina ungivikele ekwesabeni.","poem":2},{"text":"Balethele usuku lobubi.","poem":1},{"text":"Ubabhubhise ngokuqothula okuphindiweyo.","poem":2}]},{"type":"heading","content":["Ukugcina ISabatha Lingcwele"]},{"type":"verse","number":19,"content":["UThixo wathi kimi: “Hamba uyekuma esangweni labantu, amakhosi akoJuda angena ngalo njalo aphume ngalo; ume futhi lakuwo wonke amanye amasango aseJerusalema."]},{"type":"verse","number":20,"content":["Uthi kubo, ‘Zwanini ilizwi likaThixo, lina makhosi akoJuda labo bonke abantu abahlala koJuda kanye labantu bonke abahlala eJerusalema abangena ngala amasango."]},{"type":"verse","number":21,"content":["UThixo uthi: Qaphelani lingathwali mthwalo ngosuku lweSabatha loba liwungenise ngamasango aseJerusalema."]},{"type":"verse","number":22,"content":["Lingaphumisi mthwalo ezindlini zenu kumbe lenze loba yiwuphi umsebenzi ngosuku lweSabatha, kodwa ligcine iSabatha lingcwele, njengokulaya kwami okhokho benu."]},{"type":"verse","number":23,"content":["Kodwa kabalalelanga loba banake; izintamo zabo zazilukhuni njalo kabalalelanga kumbe bamukele ukulaywa."]},{"type":"verse","number":24,"content":["UThixo uthi: Kodwa nxa liqaphele ukungilalela, lingangenisi mthwalo ngamasango edolobho leli ngeSabatha, kodwa ligcina usuku lweSabatha lungcwele ngokungenzi msebenzi ngalo,"]},{"type":"verse","number":25,"content":["lapho-ke amakhosi ahlezi esihlalweni sobukhosi sikaDavida azangena lezikhulu zawo ngamasango edolobho leli. Wona lezikhulu zawo bazafika begade izinqola zempi lamabhiza, belabantu bakoJuda lalabo abahlala eJerusalema; bahlale kulo idolobho kuze kube nininini."]},{"type":"verse","number":26,"content":["Abantu bazakuza bevela emadolobheni akoJuda lasemizini egqagqele iJerusalema, bevela elizweni lakoBhenjamini lasezintatshaneni zangasentshonalanga, bevela elizweni lamaqaqa laseNegebi, beletha iminikelo yokutshiswa lemihlatshelo, iminikelo yamabele, impepha kanye leminikelo yokubonga endlini kaThixo."]},{"type":"verse","number":27,"content":["Kodwa nxa lingangilaleli ekuthini ligcine usuku lweSabatha lungcwele ngokungathwali mthwalo lapho lingena ngamasango aseJerusalema ngosuku lweSabatha, lapho-ke ngizaphemba umlilo ongacitshekiyo emasangweni eJerusalema ozaqothula izinqaba zalo.’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/16.json","previousChapterAudioLinks":{},"numberOfVerses":27}