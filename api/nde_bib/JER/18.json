{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":18,"content":[{"type":"heading","content":["Endlini Yombumbi"]},{"type":"verse","number":1,"content":["Leli yilizwi elafika kuJeremiya livela kuThixo lisithi:"]},{"type":"verse","number":2,"content":["“Suka wehlele endlini yombumbi, lapho engizakutshelela khona ilizwi lami.”"]},{"type":"verse","number":3,"content":["Ngakho ngehlela endlini yombumbi, ngambona esebenza ngevili."]},{"type":"verse","number":4,"content":["Kodwa imbiza ayeyibumba ngebumba yonakala ezandleni zakhe; ngakho umbumbi wayenza yaba ngenye imbiza, ngendlela ayibona ingcono kuye."]},{"type":"verse","number":5,"content":["Ilizwi likaThixo laselifika kimi lisithi;"]},{"type":"verse","number":6,"content":["“Wena ndlu ka-Israyeli, ngingeze ngenza kuwe njengokwenziwa ngumbumbi lo na?” kutsho uThixo. “Njengebumba esandleni sombumbi lawe unjalo esandleni sami, wena ndlu ka-Israyeli."]},{"type":"verse","number":7,"content":["Nxa ngimemezela langasiphi isikhathi ukuthi isizwe loba umbuso uzasuswa udilizwe, uchithwe,"]},{"type":"verse","number":8,"content":["kuthi isizwe leso engisixwayisileyo siphenduke ebubini baso, ngizaxola ngingabe ngisasehlisela ebesengimise ukusehlisela khona."]},{"type":"verse","number":9,"content":["Njalo nxa ngesinye isikhathi ngimemezela ukuthi isizwe kumbe umbuso ngizawakha ngiwumise,"]},{"type":"verse","number":10,"content":["ube ususenza ububi emehlweni ami njalo ungangilaleli, ngizacabanga kutsha ngokuhle ebesengicebe ukukwenzela khona."]},{"type":"verse","number":11,"content":["Ngakho khathesi tshela abantu bakoJuda lalabo abahlala eJerusalema uthi, ‘Nanku okutshiwo nguThixo: Khangelani! Ngilungisela ukulehlisela umonakalo njalo ngibumba lecebo ngani. Ngakho phendukani ezindleleni zenu ezimbi, omunye lomunye wenu, lilungise izindlela zenu lezenzo zenu.’"]},{"type":"verse","number":12,"content":["Kodwa bazaphendula bathi, ‘Akusizi lutho. Sizaqhubeka ngamacebo ethu; lowo lalowo wethu uzalandela ubulukhuni benhliziyo yakhe embi.’ ”"]},{"type":"verse","number":13,"content":["Ngakho uThixo uthi:",{"text":"“Buzani phakathi kwezizwe ukuthi:","poem":1},{"text":"Ngubani owake wezwa okunjengalokhu na?","poem":2},{"text":"Kwenziwe into eyesabekayo kakhulu,","poem":1},{"text":"yenziwe yintombi egcweleyo u-Israyeli.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ungqwaqwane waseLebhanoni","poem":1},{"text":"uyake unyamalale emithezukweni yayo elamatshe na?","poem":2},{"text":"Amanzi akhona aqandayo avela kude","poem":1},{"text":"ayake eme ukugeleza na?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kodwa abantu bami sebengikhohliwe;","poem":1},{"text":"batshisela izithombe eziyize impepha,","poem":2},{"text":"ezabenza bakhubeka ezindleleni zabo","poem":1},{"text":"lasemikhondweni yasendulo.","poem":2},{"text":"Zabenza bahamba ngezindledlana zeganga","poem":1},{"text":"lasemigwaqweni engalungiswanga.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ilizwe labo lizatshabalaliswa,","poem":1},{"text":"into yokuhlekwa usulu;","poem":2},{"text":"bonke abadlula khona bazakwethuka","poem":1},{"text":"banyikinye amakhanda abo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Njengomoya ovela empumalanga,","poem":1},{"text":"ngizabahlakaza phambi kwezitha zabo;","poem":2},{"text":"ngizabafulathela ngibancitshe ubuso bami","poem":1},{"text":"ngosuku lokuhlupheka kwabo.”","poem":2}]},{"type":"verse","number":18,"content":["Bona bathi, “Wozani sicebe amacebo amabi ngoJeremiya; ngoba ukufundisa kwabaphristi umthetho akusoze kuphuthe, kumbe ukweluleka kwezihlakaniphi, loba ilizwi elivela kubaphrofethi. Ngakho wozani, simhlasele ngemilomo yethu singananzi lutho alutshoyo.”"]},{"type":"verse","number":19,"content":[{"text":"Ake ungizwe, awu Thixo;","poem":1},{"text":"ulalele okutshiwo yizitha zami!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Okuhle kuphindiselwa ngokubi na?","poem":1},{"text":"Ikanti sebengimbele igodi.","poem":2},{"text":"Khumbula ukuba ngema phambi kwakho","poem":1},{"text":"ngabakhulumela","poem":2},{"lineBreak":true},{"text":"ukuba ususe ulaka lwakho kubo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ngakho-ke abantwababo banikele endlaleni;","poem":1},{"text":"ubaqhubele emandleni enkemba.","poem":2},{"text":"Abafazi babo kabangabi labantwana njalo babe ngabafelokazi;","poem":1},{"text":"amadoda abo kawabulawe,","poem":2},{"lineBreak":true},{"text":"amajaha akhona abulawe ngenkemba empini.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kakuzwakale ukukhala ezindlini zabo,","poem":1},{"text":"lapho usulethe abahlaseli ukuba babajume,","poem":2},{"text":"ngoba sebegebhe igodi ukuba bangithumbe","poem":1},{"text":"njalo bathiya inyawo zami ngemijibila.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kodwa uyawazi, wena Thixo,","poem":1},{"text":"wonke amaqhinga abo okungibulala.","poem":2},{"text":"Ungabathetheleli amacala abo","poem":1},{"text":"loba ucitshe izono zabo phambi kobuso bakho.","poem":2},{"text":"Kabachithwe phambi kwakho;","poem":1},{"text":"bahlasele ngesikhathi sokuthukuthela kwakho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/17.json","previousChapterAudioLinks":{},"numberOfVerses":23}