{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":2,"content":[{"type":"heading","content":["U-Israyeli Udela UNkulunkulu"]},{"type":"verse","number":1,"content":["Ilizwi likaThixo lafika kimi lisithi,"]},{"type":"verse","number":2,"content":["“Hamba umemezele iJerusalema lisizwa uthi:",{"lineBreak":true},"Lokhu yikho okutshiwo nguThixo:",{"text":"‘Ngiyakukhumbula ukuzinikela kwasebutsheni bakho,","poem":1},{"text":"ukungithanda kwakho njengomlobokazi","poem":2},{"text":"ungilandela enkangala,","poem":1},{"text":"phakathi kwelizwe elingahlanyelwanga.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"U-Israyeli wayengcwele kuThixo,","poem":1},{"text":"eyizithelo zakuqala zesivuno sakhe,","poem":2},{"text":"bonke abamtshwabadelayo baba lecala,","poem":1},{"text":"behlelwa yincithakalo,’ ”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Zwana ilizwi likaThixo, we ndlu kaJakhobe,","poem":1},{"text":"lani lonke sendo lwendlu ka-Israyeli.","poem":2}]},{"type":"verse","number":5,"content":["UThixo uthi:",{"text":"“Yibubi bani okhokho benu ababubona kimi,","poem":1},{"text":"baze bedukele khatshana kangaka lami?","poem":2},{"text":"Balandela izithombe eziyize,","poem":1},{"text":"labo ngokwabo baba yize.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kababuzanga ukuthi, ‘Ungaphi uThixo,","poem":1},{"text":"owasikhupha elizweni laseGibhithe","poem":2},{"text":"wasikhokhela emagangeni alugwadule","poem":1},{"text":"phakathi kwelizwe lezinkangala lezindonga,","poem":2},{"text":"ilizwe lokoma lobumnyama,","poem":1},{"text":"ilizwe elingahanjwa muntu lelingelamuntu ohlala kulo?’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngaliletha elizweni elivundileyo","poem":1},{"text":"ukuba lidle izithelo zalo lezilimo ezinhle.","poem":2},{"text":"Kodwa lina lafika langcolisa ilizwe lami,","poem":1},{"text":"lenza ilifa lami langakhwabitheki.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abaphristi kababuzanga ukuthi,","poem":1},{"text":"‘Ungaphi UThixo?’","poem":2},{"text":"Labo abaphatha umthetho abangazanga;","poem":1},{"text":"abakhokheli bangihlamukela.","poem":2},{"text":"Abaphrofethi baphrofetha ngoBhali","poem":1},{"text":"balandela izithombe eziyize.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ngakho-ke ngilethesa amacala futhi,”","poem":1},{"text":"kutsho uThixo.","poem":2},{"lineBreak":true},{"text":"“Labantwana babantwana benu ngizabethesa amacala.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Welani liye ngasemakhunjini aseKhithimi likhangele,","poem":1},{"text":"thumelani eKhedari lihlolisise kuhle,","poem":2},{"lineBreak":true},{"text":"libone langabe sekwake kwaba lento enjengale:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isizwe sake santshintsha onkulunkulu baso na?","poem":1},{"text":"(Belo bavele kabasibo onkulunkulu.)","poem":2},{"text":"Kodwa abantu bami bantshintshe inkazimulo yabo","poem":1},{"text":"ngenxa yezithombe eziyize.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mangalani lokhu, lina mazulu,","poem":1},{"text":"lithuthumele ngokwesaba okukhulu,”","poem":2},{"lineBreak":true},{"text":"kutsho UThixo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Abantu bami benze izono ezimbili:","poem":1},{"lineBreak":true},{"text":"Bangidelile,","poem":1},{"text":"mina mthombo wamanzi okuphila,","poem":2},{"text":"bagebha eyabo imithombo,","poem":1},{"text":"imithombo evuzayo engagcini manzi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kambe u-Israyeli yisisebenzi, isigqili ngokuzalwa na?","poem":1},{"text":"Pho kungani eseyimpango na?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Izilwane zibhongile;","poem":1},{"text":"sezihwabhile kuye.","poem":2},{"text":"Zilichithile ilizwe lakhe;","poem":1},{"text":"amadolobho akhe atshisiwe, atshiywa engaselamuntu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Njalo, labantu baseMemfisi leThahiphanesi","poem":1},{"text":"baphuce ikhanda lakho.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Lokhu kawukwehliselanga phezu kwakho","poem":1},{"text":"ngokudela uThixo uNkulunkulu wakho","poem":2},{"lineBreak":true},{"text":"lapho ekukhokhela endleleni na?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Khathesi kungani usiya eGibhithe","poem":1},{"text":"ukuba unathe amanzi eShihori na?","poem":2},{"text":"Njalo kungani usiya e-Asiriya","poem":1},{"text":"ukuba unathe amanzi eYufrathe na?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ububi bakho buzakujezisa;","poem":1},{"text":"ukutshedela kwakho emuva kuzakukhuza.","poem":2},{"text":"Ngakho cabanga ubone ukuthi kubi","poem":1},{"text":"njalo kubuhlungu kanjani","poem":2},{"text":"lapho udela uThixo uNkulunkulu wakho","poem":1},{"text":"njalo ungelavalo ngami,”","poem":2},{"lineBreak":true},{"text":"kutsho iNkosi uThixo uSomandla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Endulo wephula ijogwe lakho,","poem":1},{"text":"waquma izibopho zakho;","poem":2},{"lineBreak":true},{"text":"wathi, ‘Kangiyikukukhonza!’","poem":2},{"text":"Lakanye, phezu kwamaqaqa wonke","poem":1},{"text":"langaphansi kwazo zonke izihlahla eziluhlaza","poem":2},{"lineBreak":true},{"text":"walala phansi njengesifebe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ngikuhlanyele njengevini elikhethiweyo","poem":1},{"text":"elohlobo oluqinileyo loluthembekileyo.","poem":2},{"text":"Pho kwenzakala njani ukuba ungiphendukele","poem":1},{"text":"ube livini elibolileyo, leganga?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Lanxa ugeza ngesepa","poem":1},{"text":"usebenzisa lesepa enengi,","poem":2},{"text":"ichatha lobubi bakho","poem":1},{"text":"lilokhu likhona phambi kwami,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo Wobukhosi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“Ungatsho kanjani na uthi, ‘Kangingcolanga,","poem":1},{"text":"kangibalandelanga oBhali’?","poem":2},{"text":"Khangela ukuthi waziphatha njani esigodini,","poem":1},{"text":"khumbula osukwenzile.","poem":2},{"text":"Ulikamela elisikazi elilesiqubu","poem":1},{"text":"eligijima lapha lalaphaya,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ubabhemi weganga ojwayele inkangala,","poem":1},{"text":"ophembela umoya enkanukweni yakhe,","poem":2},{"text":"ngubani ongamenqabela","poem":1},{"text":"ekukhanukeni kwakhe?","poem":2},{"text":"Abaduna abamxotshayo bangazidinisi ukuxotshana labo;","poem":1},{"text":"bazamthola ngesikhathi sezinsikazikhwela.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ungagijimi inyawo zakho zize zihlubuke","poem":1},{"text":"lomphimbo wakho uze wome.","poem":2},{"text":"Kodwa wena wathi,","poem":1},{"text":"‘Akusizi lutho!","poem":2},{"text":"Ngiyabathanda onkulunkulu bezizweni,","poem":1},{"text":"kumele ngibalandele.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Njengokuyangeka kwesela nxa selibanjiwe,","poem":1},{"text":"ngokunjalo abantu bako-Israyeli bayangekile,","poem":2},{"text":"bona kanye lamakhosi abo lezikhulu zabo,","poem":1},{"text":"abaphristi babo labaphrofethi babo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bathi esigodweni, ‘Wena ungubaba wami,’","poem":1},{"text":"elitsheni bathi, ‘Nguwe owangizalayo.’","poem":2},{"text":"Bangifulathele,","poem":1},{"text":"hatshi ngobuso babo nje;","poem":2},{"text":"kodwa nxa sebehlupheka bathi,","poem":1},{"text":"‘Woza usihlenge.’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Pho bangaphi onkulunkulu elazenzela bona?","poem":1},{"text":"Kabeze nxa bengakuhlenga","poem":2},{"lineBreak":true},{"text":"lapho usuphakathi kokuhlupheka!","poem":2},{"text":"Ngoba wena Juda ulabonkulunkulu abanengi","poem":1},{"text":"njengobunengi bamadolobho akho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Kungani lingethesa umlandu?","poem":1},{"text":"Lonke lingihlamukele,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"“Ukubajezisa kwami abantu bakho kwaba yize;","poem":1},{"text":"kabakuvumanga ukuqondiswa.","poem":2},{"text":"Inkemba yakho isibatshwabadele abaphrofethi bakho","poem":1},{"text":"njengesilwane esiphangayo.","poem":2}]},{"type":"verse","number":31,"content":["Wena owalesisizukulwane, khumbula ilizwi likaThixo:",{"text":"Ngibe ngiyinkangala ku-Israyeli","poem":1},{"text":"kumbe ilizwe lomnyama omkhulu na?","poem":2},{"text":"Kungani abantu bami besithi,","poem":1},{"text":"‘Sikhululekile ukuba sizulazule;","poem":2},{"lineBreak":true},{"text":"kasiyikuza kuwe futhi’?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Intombi ingazikhohlwa iziceciso zayo na,","poem":1},{"text":"lomlobokazi akhohlwe izembatho zakhe na?","poem":2},{"text":"Kodwa abantu bami bangikhohliwe,","poem":1},{"text":"okwensuku ezingeke zibalwe.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Yeka ukuhlakanipha kwakho ekufuneni uthando!","poem":1},{"text":"Labesifazane ababi kakhulu","poem":2},{"lineBreak":true},{"text":"bangafunda ezindleleni zakho.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ezigqokweni zakho","poem":1},{"text":"abantu bathola igazi lokuphila elabayanga","poem":2},{"lineBreak":true},{"text":"abangelacala lanxa ungababambanga befohlela phakathi.","poem":2},{"text":"Kodwa kukho konke lokhu","poem":1}]},{"type":"verse","number":35,"content":[{"text":"uthi, ‘Kangilacala;","poem":2},{"lineBreak":true},{"text":"kangithukuthelelanga.’","poem":2},{"text":"Kodwa mina ngizakwahlulela,","poem":1},{"text":"ngoba uthi, ‘Angonanga.’","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Kungani uqhubeka kangaka,","poem":1},{"text":"untshintsha izindlela zakho?","poem":2},{"text":"IGibhithe izakuyangisa njengalokhu","poem":1},{"text":"owakwenziwa yi-Asiriya.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Uzasuka kuleyondawo","poem":1},{"text":"izandla zakho zisekhanda lakho,","poem":2},{"text":"ngoba uThixo ubalahlile labo obathembayo;","poem":1},{"text":"kabayikukusiza.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}