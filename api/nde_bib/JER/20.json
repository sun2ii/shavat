{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":20,"content":[{"type":"heading","content":["UJeremiya LoPhashuri"]},{"type":"verse","number":1,"content":["Kwathi uPhashuri umphristi indodana ka-Imeri, induna enkulu ethempelini likaThixo, ezwe uJeremiya ephrofitha lezizinto,"]},{"type":"verse","number":2,"content":["wenza ukuthi uJeremiya umphrofethi atshaywe njalo wamvalela esitokisini eSangweni laPhezulu koBhenjamini ethempelini likaThixo."]},{"type":"verse","number":3,"content":["Ngosuku olwalandelayo, uPhashuri esemkhupha esitokisini, uJeremiya wathi kuye, “Ibizo lakho oliphiwe nguThixo akusiPhashuri, kodwa uMagori-Misabibi,"]},{"type":"verse","number":4,"content":["ngoba uThixo uthi: ‘Ngizakwenza ubelucuku ngokwakho lakubo bonke abangane bakho; uzababona ngamehlo akho besiwa ngenkemba yezitha zabo. UJuda wonke ngizamnikela enkosini yaseBhabhiloni, ezabathumba ibase eBhabhiloni loba ibabulale ngenkemba."]},{"type":"verse","number":5,"content":["Yonke inotho yedolobho leli ngizayipha izitha zabo lazozonke izithelo zalo, zonke izinto zalo eziligugu kanye lemfuyo yonke yamakhosi akoJuda zizayithumba njengempango ziyithwalele eBhabhiloni."]},{"type":"verse","number":6,"content":["Wena Phashuri, labo bonke abahlala endlini yakho lizathunjwa liye eBhabhiloni. Uzafela khonale, ungcwatshwe khonale, wena kanye labangane bakho bonke ophrofetha amanga kubo.’ ”"]},{"type":"heading","content":["Insolo KaJeremiya"]},{"type":"verse","number":7,"content":[{"text":"Awu Thixo, wangiyenga, ngayengeka;","poem":1},{"text":"wangehlula wanqoba.","poem":2},{"text":"Ngiyahlekwa insuku zonke;","poem":1},{"text":"bonke bayangiklolodela.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zonke izikhathi lapho ngikhuluma, ngiyakhala","poem":1},{"text":"ngimemezela ukuba kube lodlakela lokuchitheka.","poem":2},{"text":"Ngakho ilizwi likaThixo selingilethele","poem":1},{"text":"isithuko lensolo ilanga lonke.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kodwa nxa ngisithi, “Kangiyikumqamba","poem":1},{"text":"loba ngikhulume ngebizo lakhe futhi,”","poem":2},{"text":"ilizwi lakhe lisenhliziyweni yami njengomlilo,","poem":1},{"text":"umlilo ovalelwe emathanjeni ami.","poem":2},{"text":"Sengidiniwe ngokuligodla ngaphakathi;","poem":1},{"text":"impela, ngingeke nganelise.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngizwa abanengi benyenyeza besithi,","poem":1},{"text":"“Kulokuthuthumela indawo yonke!","poem":2},{"lineBreak":true},{"text":"Mmangaleleni! Kasimangalele!”","poem":2},{"text":"Abangane bami bonke","poem":1},{"text":"balindele ukuwa kwami, besithi,","poem":2},{"text":"“Mhlawumbe uzakhohliseka;","poem":1},{"text":"besesimehlula","poem":2},{"lineBreak":true},{"text":"siphindisele kuye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kodwa uThixo ulami njengebutho elilamandla;","poem":1},{"text":"ngakho abangihluphayo bazakuwa banganqobi.","poem":2},{"text":"Bazakwehluleka njalo bayangeke kakhulu;","poem":1},{"text":"ihlazo labo kaliyikukhohlakala lanini.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Awu Thixo Somandla, wena ohlola abalungileyo,","poem":1},{"text":"uhlole inhliziyo lengqondo,","poem":2},{"text":"kangibone ukuphindisela kwakho kubo,","poem":1},{"text":"ngoba indaba yami ngiyinikele kuwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Hlabelani uThixo!","poem":1},{"text":"Limdumise uThixo!","poem":2},{"text":"Uhlenga impilo yabaswelayo","poem":1},{"text":"ezandleni zababi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kaluqalekiswe usuku engazalwa ngalo!","poem":1},{"text":"Usuku umama angizala ngalo kalungabusiswa!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kaqalekiswe umuntu owayabikela ubaba izindaba,","poem":1},{"text":"owamemeza wathaba, esithi,","poem":2},{"lineBreak":true},{"text":"“Uzalelwe indodana!”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Lowomuntu kabe njengamadolobho","poem":1},{"text":"uThixo awachitha kungekho sihawu.","poem":2},{"text":"Kezwe ukulila ekuseni,","poem":1},{"text":"lomkhosi wempi emini.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngoba kangibulalelanga esiswini,","poem":1},{"text":"umama enjengengcwaba lami,","poem":2},{"lineBreak":true},{"text":"isisu sakhe sikhukhumele kokuphela.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngaphumelani esiswini","poem":1},{"text":"ukuba ngibone uhlupho losizi","poem":2},{"lineBreak":true},{"text":"njalo akuthi ngiphethe insuku zami ngiphakathi kwehlazo?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/19.json","previousChapterAudioLinks":{},"numberOfVerses":18}