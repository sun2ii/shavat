{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":22,"content":[{"type":"heading","content":["Ukwahlulelwa Kwamakhosi Angalunganga"]},{"type":"verse","number":1,"content":["Nanku akutshoyo uThixo: “Hamba wehlele endlini yenkosi yakoJuda umemezele khona ilizwi leli uthi,"]},{"type":"verse","number":2,"content":["‘Zwana ilizwi likaThixo, we nkosi yakoJuda, wena ohlala esihlalweni sobukhosi sikaDavida, wena lezikhulu zakho kanye labantu bakho abangena ngamasango la."]},{"type":"verse","number":3,"content":["UThixo uthi: Yenzani okulungileyo lokuqondileyo. Mhlenge esandleni somncindezeli wakhe lowo ophangiweyo. Lingenzi okubi loba udlakela kowezizweni, intandane loba umfelokazi, njalo lingachithi igazi elingelacala kule indawo."]},{"type":"verse","number":4,"content":["Ngoba nxa linanzelela ukulandela imilayo le, amakhosi ahlala esihlalweni sobukhosi sikaDavida azangena ngamasango ale indawo, egade izinqola zempi lamabhiza, elezikhulu zawo kanye labantu bawo."]},{"type":"verse","number":5,"content":["Kodwa nxa imilayo le lingayilaleli, kutsho uThixo, ngifunga ngami ukuthi indawo le izakuba lunxiwa.’ ”"]},{"type":"verse","number":6,"content":["Ngoba mayelana lendawo yenkosi yakoJuda uThixo uthi:",{"text":"“Lanxa unjengeGiliyadi kimi,","poem":1},{"text":"lanjengengqongo yeLebhanoni,","poem":2},{"text":"ngeqiniso ngizakwenza ufane lenkangala,","poem":1},{"text":"lanjengamadolobho angahlali muntu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngizakuthumela abachithi,","poem":1},{"text":"indoda nganye ilezikhali zayo,","poem":2},{"text":"njalo bazaquma imijabo yenu emihle yemisedari","poem":1},{"text":"bayiphosele emlilweni.","poem":2}]},{"type":"verse","number":8,"content":["Abantu abavela ezizweni ezinengi bazadlula kulelidolobho babuzane besithi, ‘Kungani uThixo enze into enje kulelidolobho elikhulu na?’"]},{"type":"verse","number":9,"content":["Impendulo izakuthi: ‘Ngoba basidelile isivumelwano sikaThixo uNkulunkulu wabo bakhonza abanye onkulunkulu njalo babasebenzela.’ ”"]},{"type":"verse","number":10,"content":[{"text":"Lingayikhaleli inkosi efileyo loba lililele ukulilahlekela kwayo;","poem":1},{"text":"kodwa, khalelani kakhulu othunjiweyo,","poem":2},{"text":"ngoba kasayikubuya","poem":1},{"text":"njalo loba abone ilizwe lakibo futhi.","poem":2}]},{"type":"verse","number":11,"content":["Ngoba mayelana loShalumi indodana kaJosiya, owangena esikhundleni sikayise esiba yinkosi yakoJuda kodwa osesukile kule indawo: UThixo uthi, “Kasoze abuye futhi."]},{"type":"verse","number":12,"content":["Uzafela kuleyondawo asiwa kuyo ethunjiwe; ilizwe leli kasoze alibone futhi.”"]},{"type":"verse","number":13,"content":[{"text":"“Maye kuye owakha indlu yakhe yobukhosi ngokungalungi,","poem":1},{"text":"lezindlu zakhe zangaphezulu ngokungafanelanga,","poem":2},{"text":"esenza abantu bakibo basebenzele ize,","poem":1},{"text":"engabaholisi lutho ngokusebenza kwabo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Uthi, ‘Ngizazakhela indlu enkulu yobukhosi","poem":1},{"text":"elezitezi ezibanzi.’","poem":2},{"text":"Ngakho uyenza ibe lamawindi amakhulu,","poem":1},{"text":"ayinameke ngemisidari,","poem":2},{"lineBreak":true},{"text":"ayicombe ngokubomvu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ukuba lemisedari eminenginengi","poem":1},{"text":"kukwenza ube yinkosi na?","poem":2},{"text":"Uyihlo kazange abe lokudla lokunathwayo na?","poem":1},{"text":"Wenza okuqondileyo lokulungileyo,","poem":2},{"lineBreak":true},{"text":"ngakho konke kwamlungela.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wavikela amalungelo abayanga labaswelayo,","poem":1},{"text":"ngakho konke kwamlungela.","poem":2},{"text":"Lokho akusikho okutsho ukungazi na?”","poem":1},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Kodwa amehlo akho lenhliziyo yakho","poem":1},{"text":"kukhangele inzuzo yenkohliso,","poem":2},{"text":"lokuchitha igazi elingelacala,","poem":1},{"text":"ukuncindezela kanye lodlakela.”","poem":2}]},{"type":"verse","number":18,"content":["Ngakho mayelana loJehoyakhimi indodana kaJosiya, inkosi yakoJuda, uThixo uthi:",{"text":"“Kabayikumkhalela besithi:","poem":1},{"text":"‘Maye ngomfowethu!","poem":2},{"lineBreak":true},{"text":"Maye ngodadewethu!’","poem":2},{"text":"Kabayikumkhalela besithi:","poem":1},{"text":"‘Maye ngenkosi yami!","poem":2},{"lineBreak":true},{"text":"Maye ngobuhle bayo obukhulu!’","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Uzangcwatshwa njengobabhemi,","poem":1},{"text":"ahudulwe aphoselwe","poem":2},{"lineBreak":true},{"text":"ngaphandle kwamasango aseJerusalema.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Qansa uye eLebhanoni umemeze,","poem":1},{"text":"wenze ilizwi lakho lizwakale eBhashani;","poem":2},{"text":"memeza use-Abharimi,","poem":1},{"text":"ngoba bonke abamanyane lawe banqotshiwe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ngakuxwayisa uzibona uvikelekile,","poem":1},{"text":"kodwa wena wathi, ‘Angiyikulalela!’","poem":2},{"text":"Le ibe iyindlela yakho kusukela ebutsheni bakho;","poem":1},{"text":"kawungilalelanga.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Umoya uzabaxotshela khatshana bonke abelusi bakho,","poem":1},{"text":"labamanyene lawe bazathunjwa.","poem":2},{"text":"Lapho-ke uzayangeka ube lenhloni","poem":1},{"text":"ngenxa yobubi bakho bonke.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Lina abahlala ‘eLebhanoni,’","poem":1},{"text":"eligcineke kuhle ezindlini zemisedari,","poem":2},{"text":"lizabubula kakhulu lapho inhlungu zilehlela,","poem":1},{"text":"ubuhlungu obunjengowesifazane ehelelwa!”","poem":2}]},{"type":"verse","number":24,"content":["UThixo uthi, “Ngeqiniso njengoba ngikhona, lanxa ngabe wena, Jehoyakhini ndodana kaJehoyakhimi inkosi yakoJuda, wawuyindandatho ebukekayo esandleni sami sokunene, ngangizakukhupha."]},{"type":"verse","number":25,"content":["Ngizakunikela kulabo abafuna ukukubulala, labo obesabayo, uNebhukhadineza inkosi yaseBhabhiloni lakumaKhaladiya."]},{"type":"verse","number":26,"content":["Wena kanye lonyoko owakuzalayo ngizaliphosela kwelinye ilizwe, lapho elingazalelwanga khona, lapho elizafela khona lobabili."]},{"type":"verse","number":27,"content":["Kaliyikuphinda libuye elizweni elifisa ukuza kulo.”"]},{"type":"verse","number":28,"content":[{"text":"Umuntu lo, uJehoyakhini, uyimbiza efileyo,","poem":1},{"text":"edelelwayo, into engafunwa muntu na?","poem":2},{"text":"Kungani yena labantwabakhe bezaphoselwa ngaphandle,","poem":1},{"text":"balahlelwe elizweni abangalaziyo na?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Wena lizwe, lizwe, lizwe,","poem":1},{"text":"zwana ilizwi likaThixo!","poem":2}]},{"type":"verse","number":30,"content":[{"text":"UThixo uthi:","poem":1},{"lineBreak":true},{"text":"“Bhalani umuntu lo njengongelabantwana,","poem":1},{"text":"umuntu ongayikuphumelela empilweni yakhe,","poem":2},{"text":"ngoba kakho owenzalo yakhe ozaphumelela,","poem":1},{"text":"kakho ozahlala esihlalweni sobukhosi sikaDavida","poem":2},{"lineBreak":true},{"text":"loba abuse futhi koJuda.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}