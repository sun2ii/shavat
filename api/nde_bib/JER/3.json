{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"“Indoda ingehlukana lomkayo","poem":1},{"text":"ayitshiye endele kwenye indoda,","poem":2},{"text":"kufanele imbuyise futhi na?","poem":1},{"text":"Kambe ilizwe lingeke langcoliswa kakhulukazi na?","poem":2},{"text":"Kodwa wena usuphile njengesifebe esilezithandwa ezinengi,","poem":1},{"text":"kambe khathesi ungabuyela kimi na?”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Khangela emiqolweni elugwadule ubone.","poem":1},{"text":"Kungaphi lapho ongazange udlwangululwe khona?","poem":2},{"text":"Emigwaqweni wahlala ulindele izithandwa,","poem":1},{"text":"wahlala njengomhambuma enkangala.","poem":2},{"text":"Ulingcolisile ilizwe ngobufebe bakho","poem":1},{"text":"langobubi bakho.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngalokho imikhizo imisiwe,","poem":1},{"text":"lezulu lentwasa kalinanga.","poem":2},{"text":"Ikanti wena uziphethe okwesifebe,","poem":1},{"text":"awulanhloni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kawungibizanga khathesi nje wathi,","poem":1},{"text":"‘Baba, mngane wami kusukela ebutsheni bami,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"uzahlala uzondile kokuphela na?","poem":1},{"text":"Ulaka lwakho luzaqhubeka kokuphela na?’","poem":2},{"text":"Le yindlela okhuluma ngayo,","poem":1},{"text":"kodwa wenza konke okubi ongakwenza.”","poem":2}]},{"type":"heading","content":["U-Israyeli Ongathembekanga"]},{"type":"verse","number":6,"content":["Ekubuseni kwenkosi uJosiya, uThixo wathi kimi, “Ukubonile yini okwenziwe ngu-Israyeli ongathembekanga? Usekhwele phezu kwamaqaqa wonke aphakemeyo langaphansi kwezihlahla zonke eziluhlaza wafebela khona."]},{"type":"verse","number":7,"content":["Ngacabanga ukuthi emva kokuba esenze konke lokhu uzaphinda eze kimi, kodwa kabuyanga, lodadewabo ongathembekanga uJuda wakubona lokho."]},{"type":"verse","number":8,"content":["U-Israyeli ongathembekanga ngamnika incwadi yakhe yesehlukaniso ngamxotsha ngenxa yobufebe bakhe bonke. Kodwa ngabona ukuthi udadewabo ongathembekanga, uJuda, kesabanga, laye wasuka wayafeba."]},{"type":"verse","number":9,"content":["Ngenxa yokuthi ububi buka-Israyeli babungatsho lutho kuye, wangcolisa ilizwe wakhonza amatshe lezihlahla."]},{"type":"verse","number":10,"content":["Kukho konke lokhu, udadewabo ongathembekanga uJuda kabuyelanga kimi ngenhliziyo yakhe yonke, kodwa ngokuzenzisa nje kuphela,” kutsho uThixo."]},{"type":"verse","number":11,"content":["UThixo wathi kimi, “U-Israyeli ongathembekanga ungcono kuloJuda ongelaqiniso."]},{"type":"verse","number":12,"content":["Hamba, uyememezela ilizwi leli ngasenyakatho:",{"text":"‘Phenduka Israyeli ongathembekanga,’ kutsho uThixo,","poem":1},{"text":"‘Kangisayikukuhwaqela futhi,","poem":2},{"text":"ngoba ngilesihawu,’ kutsho uThixo.","poem":1},{"text":"‘Kangiyikuthukuthela kokuphela.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Vuma icala lakho nje kuphela,","poem":1},{"text":"wahlamukela uThixo uNkulunkulu wakho,","poem":2},{"text":"uzihlakazelele kubonkulunkulu bezizweni","poem":1},{"text":"ngaphansi kwezihlahla zonke eziluhlaza,","poem":2},{"lineBreak":true},{"text":"njalo kawaze wangilalela,’ ”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":14,"content":["“Phendukani, bantu abangathembekanga,” kutsho uThixo, “ngoba ngingumyeni wenu. Ngizalikhetha, oyedwa edolobheni lababili emulini ngililethe eZiyoni."]},{"type":"verse","number":15,"content":["Lapho-ke ngizalinika abelusi abathandwa yimi, abazalikhokhela ngokwazi langokuqedisisa."]},{"type":"verse","number":16,"content":["Ngalezonsuku, ubunengi benu sebande kakhulu elizweni,” kutsho uThixo, “abantu kabasayikuthi, ‘Ibhokisi lesivumelwano sikaThixo.’ Kaliyikufika emicabangweni yabo kumbe likhunjulwe; kaliyikudingakala, njalo akuyikwenziwa elinye futhi."]},{"type":"verse","number":17,"content":["Ngalesosikhathi iJerusalema bazalibiza ngokuthi yisiHlalo Sobukhosi sikaThixo, njalo izizwe zonke zizabuthana eJerusalema ukuba zihloniphe ibizo likaThixo. Kabasayikulandela inkani yezinhliziyo zabo ezimbi."]},{"type":"verse","number":18,"content":["Ngalezonsuku indlu kaJuda izahlangana leka-Israyeli, njalo ndawonye, zivela elizweni elisenyakatho, zizakuza elizweni engalinika okhokho benu ukuba libe yilifa labo."]},{"type":"verse","number":19,"content":["Mina ngokwami ngathi,",{"text":"‘Kade ngingathaba kakhulu","poem":1},{"text":"ukuliphatha njengamadodana,","poem":2},{"lineBreak":true},{"text":"ngilinike ilizwe elifunekayo,","poem":2},{"text":"ilifa elihle kakhulu ezizweni zonke.’","poem":1},{"text":"Bengicabanga ukuthi lizangibiza ngokuthi ‘Baba’","poem":2},{"lineBreak":true},{"text":"njalo lingaphambuki ekungilandeleni.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kodwa njengowesifazane ongathembekanga kumkakhe,","poem":1},{"text":"ubungathembekanga kimi wena ndlu ka-Israyeli,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ilizwi liyezwakala emiqolweni elugwadule,","poem":1},{"text":"ukukhala lokuncenga kwabantu bako-Israyeli,","poem":2},{"text":"ngoba izindlela zabo bazonile","poem":1},{"text":"bakhohlwa loThixo uNkulunkulu wabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Phendukani, bantu abangathembekanga,","poem":1},{"text":"ngizalelapha ukungathembeki kwenu.”","poem":2},{"lineBreak":true},{"text":"“Yebo, sizakuza kuwe,","poem":1},{"text":"ngoba unguThixo uNkulunkulu wethu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Impela umsindo wokukhonza izithombe emaqaqeni","poem":1},{"text":"lasezintabeni uyinkohliso,","poem":2},{"text":"ngempela kuThixo uNkulunkulu wethu","poem":1},{"text":"kulensindiso ka-Israyeli.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kusukela ebutsheni bethu onkulunkulu abalihlazo","poem":1},{"text":"badlile izithelo zamandla abobaba,","poem":2},{"text":"imihlambi yezimvu zabo leyezinkomo zabo,","poem":1},{"text":"amadodana abo lamadodakazi abo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kasilaleni phansi silenhloni,","poem":1},{"text":"siphathwe lihlazo lethu.","poem":2},{"text":"Ngoba sonile kuThixo uNkulunkulu wethu,","poem":1},{"text":"thina sonke kanye labokhokho bethu;","poem":2},{"text":"kusukela ebutsheni bethu kuze kube lamhla,","poem":1},{"text":"kasimlalelanga uThixo uNkulunkulu wethu.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/2.json","previousChapterAudioLinks":{},"numberOfVerses":25}