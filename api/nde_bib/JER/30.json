{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":30,"content":[{"type":"heading","content":["Ukubuyiswa Kuka-Israyeli"]},{"type":"verse","number":1,"content":["Leli yilizwi elafika kuJeremiya livela kuThixo lisithi:"]},{"type":"verse","number":2,"content":["“UThixo, uNkulunkulu ka-Israyeli uthi, ‘Loba encwadini wonke amazwi engiwakhulume kuwe."]},{"type":"verse","number":3,"content":["Insuku ziyeza,’ kutsho uThixo, ‘lapho engizabuyisa abantu bami u-Israyeli loJuda bevela ekuthunjweni ngibabuyisele elizweni engalinika okhokho babo ukuba libe ngelabo,’ kutsho uThixo.”"]},{"type":"verse","number":4,"content":["Amazwi akhulunywa nguThixo ngo-Israyeli loJuda:"]},{"type":"verse","number":5,"content":["“Wathi:",{"text":"‘Ukukhala kokwesaba kuzwakele,","poem":1},{"text":"ukwesaba okukhulu, hatshi ukuthula.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Buzani libone:","poem":1},{"text":"Indoda ingazala abantwana na?","poem":2},{"text":"Pho kungani ngibona wonke amadoda aqinileyo","poem":1},{"text":"ebambe izisu zawo ngezandla njengowesifazane ohelelwayo,","poem":2},{"lineBreak":true},{"text":"ubuso bonke sebube mhlotshana okokufa?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yeka ukwesabeka okuzakuba yilolosuku!","poem":1},{"text":"Kalukho oluzakuba njengalo.","poem":2},{"text":"Kuzakuba yisikhathi sokuhlupheka kukaJakhobe,","poem":1},{"text":"kodwa uzahlengwa kukho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ngalolosuku,’ kutsho uThixo uSomandla,","poem":1},{"text":"‘ngizalephula ijogwe entanyeni zabo","poem":2},{"text":"ngiqamule lezibopho zabo;","poem":1},{"text":"abezizweni kabasayikubagqilaza futhi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Esikhundleni salokho, bazasebenzela uThixo uNkulunkulu wabo,","poem":1},{"text":"loDavida inkosi yabo,","poem":2},{"lineBreak":true},{"text":"engizabavusela yona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ngakho ungesabi, wena Jakhobe nceku yami;","poem":1},{"text":"ungadangali, wena Israyeli,’","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2},{"text":"‘Ngeqiniso ngizakuhlenga ezindaweni ezikude,","poem":1},{"text":"lenzalo yakho elizweni lokuthunjwa kwayo.","poem":2},{"text":"UJakhobe uzakuba lokuthula futhi kanye lokuvikeleka,","poem":1},{"text":"njalo kakho ozamenza esabe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngilawe njalo ngizakuhlenga,’","poem":1},{"text":"kutsho uThixo.","poem":2},{"text":"‘Lanxa ngizichitha ngokupheleleyo zonke izizwe","poem":1},{"text":"engikuhlakazela kuzo,","poem":2},{"lineBreak":true},{"text":"wena angiyikukuchitha ngokupheleleyo.","poem":2},{"text":"Ngizakuqondisa kodwa ngokufaneleyo kuphela;","poem":1},{"text":"kangiyikukuyekela ungajeziswanga.’","poem":2}]},{"type":"verse","number":12,"content":["UThixo uthi:",{"text":"‘Isilonda sakho kaselapheki,","poem":1},{"text":"ukulimala kwakho akupholi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kakho okhulumela inhloso yakho,","poem":1},{"text":"akulamuthi wesilonda sakho,","poem":2},{"lineBreak":true},{"text":"akukho kuphola kuwe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bonke abangane bakho sebekukhohliwe;","poem":1},{"text":"kabalandaba lawe.","poem":2},{"text":"Ngikutshaye njengokungenziwa yisitha","poem":1},{"text":"ngakujezisa njengokungenziwa ngolesihluku,","poem":2},{"text":"ngoba icala lakho likhulu kakhulu","poem":1},{"text":"lezono zakho zinengi kakhulu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kungani ukhaliswa linxeba lakho,","poem":1},{"text":"ubuhlungu bakho obungelaphekiyo na?","poem":2},{"text":"Ngenxa yecala lakho elikhulu lezono ezinengi","poem":1},{"text":"ngenze lezizinto kuwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kodwa bonke abakudlayo bazadliwa;","poem":1},{"text":"zonke izitha zakho zizathunjwa.","poem":2},{"text":"Labo abakuphangayo bazaphangwa;","poem":1},{"text":"bonke abakwemukayo ngizabemuka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kodwa ngizakusilisa ngipholise lamanxeba akho,’","poem":1},{"text":"kutsho uThixo,","poem":2},{"text":"‘ngoba kuthiwa ungolahliweyo,","poem":1},{"text":"iZiyoni okungekho olendaba lalo.’","poem":2}]},{"type":"verse","number":18,"content":["UThixo uthi:",{"text":"‘Ngizavuselela inotho yasemathenteni kaJakhobe","poem":1},{"text":"ngibe lesihawu emakhaya akhe;","poem":2},{"text":"idolobho lizakwakhiwa kutsha emanxiweni alo,","poem":1},{"text":"lendlu yobukhosi izakuma endaweni yayo uqobo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kubo kuzavela izingoma zokubonga","poem":1},{"text":"kanye lomsindo wokuthokoza.","poem":2},{"text":"Ngizakwandisa amanani abo,","poem":1},{"text":"njalo kabayikuphungulwa;","poem":2},{"text":"ngizabenza bahlonitshwe,","poem":1},{"text":"njalo kabayikweyiswa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Abantwana babo bazakuba njengezinsukwini zakudala,","poem":1},{"text":"lebandla labo lizamiselwa phambi kwami;","poem":2},{"lineBreak":true},{"text":"ngizabajezisa bonke ababancindezelayo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Umkhokheli wabo uzakuba ngomunye wabakibo;","poem":1},{"text":"umbusi wabo uzavela phakathi kwabo.","poem":2},{"text":"Ngizamsondeza eduze, uzakuza phansi kwami,","poem":1},{"text":"ngoba ngubani lowo ongazinikela","poem":2},{"lineBreak":true},{"text":"ukuba seduze kwami na?’","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"‘Ngakho lina lizakuba ngabantu bami,","poem":1},{"text":"mina ngibe nguNkulunkulu wenu.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Khangelani, isiphepho sikaThixo","poem":1},{"text":"sizakhupha ulaka,","poem":2},{"text":"umoya osasivunguzane usehlela","poem":1},{"text":"phezu kwamakhanda ababi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ulaka olwesabekayo lukaThixo kaluyikudeda","poem":1},{"text":"aze ayifeze ngokupheleleyo","poem":2},{"lineBreak":true},{"text":"injongo yenhliziyo yakhe.","poem":2},{"text":"Ensukwini ezizayo","poem":1},{"text":"lizakuzwisisa lokhu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}