{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["“Ngalesosikhathi ngizakuba nguNkulunkulu wezizwana zonke zako-Israyeli, bona bazakuba ngabantu bami,” kutsho uThixo."]},{"type":"verse","number":2,"content":["UThixo uthi:",{"text":"“Abantu abasilayo enkembeni","poem":1},{"text":"bazathola umusa enkangala;","poem":2},{"lineBreak":true},{"text":"ngizakuzanika u-Israyeli ukuphumula.”","poem":2}]},{"type":"verse","number":3,"content":["UThixo wabonakala kithi kudala esithi:",{"text":"“Ngikuthandile ngothando olungapheliyo;","poem":1},{"text":"ngikuhole ngesisa esikhulu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngizakwakha njalo uzakwakhiwa kutsha futhi,","poem":1},{"text":"wena Israyeli Ntombi emsulwa.","poem":2},{"text":"Uzathatha amagedla akho futhi uphume","poem":1},{"text":"uyegida labathokozayo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Uzalima izivini zakho futhi","poem":1},{"text":"emaqaqeni aseSamariya;","poem":2},{"lineBreak":true},{"text":"abalimi bazazilima badle izithelo zazo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kuzakuba losuku lapho abalindi bezamemeza","poem":1},{"text":"phezu kwamaqaqa ako-Efrayimi bathi,","poem":2},{"text":"‘Wozani, kasiyeni eZiyoni,","poem":1},{"text":"kuThixo uNkulunkulu wethu.’ ”","poem":2}]},{"type":"verse","number":7,"content":["UThixo uthi:",{"text":"“Mhlabeleleni uJakhobe ngokuthokoza;","poem":1},{"text":"nqongolozelani izizwe ezidumileyo.","poem":2},{"text":"Yenzani ukudumisa kwenu kuzwakale, lisithi,","poem":1},{"text":"‘Awu Thixo, bahlenge abantu bakho,","poem":2},{"lineBreak":true},{"text":"insalela ka-Israyeli.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Khangelani, ngizababuyisa bevela elizweni lasenyakatho,","poem":1},{"text":"ngibaqoqe emikhawulweni yomhlaba.","poem":2},{"text":"Phakathi kwabo kuzakuba leziphofu labaqhulayo;","poem":1},{"text":"abesifazane abazithweleyo labahelelwayo;","poem":2},{"lineBreak":true},{"text":"ixuku elikhulu lizabuya.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bazabuya bekhala;","poem":1},{"text":"bazakhuleka lapho ngibabuyisa.","poem":2},{"text":"Ngizabaholela ezihotsheni zamanzi","poem":1},{"text":"endleleni eyendlalekileyo lapho abangayikukhubeka khona,","poem":2},{"text":"ngoba nginguyise ka-Israyeli,","poem":1},{"text":"njalo u-Efrayimi yindodana yami elizibulo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Zwanini ilizwi likaThixo, lina zizwe;","poem":1},{"text":"limemezeleni emazweni angaselwandle khatshana lithi:","poem":2},{"text":"‘Yena owahlakaza u-Israyeli uzamqoqa","poem":1},{"text":"njalo uzakwelusa umhlambi wakhe njengomelusi.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngoba uThixo uzamhlenga uJakhobe,","poem":1},{"text":"abakhulule ezandleni zalabo abalamandla kulabo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bazakuza banqongoloze ngentokozo ezingqongeni zeZiyoni;","poem":1},{"text":"bazathokoza ngokuphana kukaThixo,","poem":2},{"text":"ngamabele, langewayini elitsha kanye lamafutha e-oliva,","poem":1},{"text":"ngamazinyane ezimvu langamathole enkomo.","poem":2},{"text":"Bazakuba njengesivande esithelelwa kuhle,","poem":1},{"text":"njalo kabasayikuba losizi futhi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Izintombi zizagida njalo futhi zithabe,","poem":1},{"text":"enzenjalo amajaha labadala.","poem":2},{"text":"Ngizaguqula ukukhala kwabo kube yikuthaba;","poem":1},{"text":"ngizabapha induduzo lentokozo esikhundleni sosizi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngizasuthisa abaphristi ngokunengi,","poem":1},{"text":"labantu bami bazasutha ngokuphana kwami,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":15,"content":["Nanku okutshiwo nguThixo:",{"text":"“Ilizwi lizwakala eRama,","poem":1},{"text":"lesililo lokukhala okukhulu,","poem":2},{"text":"uRasheli ukhalela abantwabakhe","poem":1},{"text":"njalo esala ukududuzwa,","poem":2},{"lineBreak":true},{"text":"ngoba kabasekho.”","poem":2}]},{"type":"verse","number":16,"content":["Nanku akutshoyo uThixo:",{"text":"“Bamba ilizwi lakho ungakhali,","poem":1},{"text":"lamehlo akho angehlisi inyembezi","poem":2},{"text":"ngoba umsebenzi wakho uzathola umvuzo,”","poem":1},{"text":"kutsho uThixo.","poem":2},{"lineBreak":true},{"text":"“Bazabuya bevela elizweni lesitha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngakho kulethemba ensukwini zakho ezizayo,”","poem":1},{"text":"kutsho uThixo.","poem":2},{"lineBreak":true},{"text":"“Abantwabakho bazabuyela elizweni labo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ngikuzwile impela ukukhala kuka-Efrayimi esithi:","poem":1},{"text":"‘Wangitshaya njengethole elingathambanga,","poem":2},{"lineBreak":true},{"text":"njalo sengajeziseka.","poem":2},{"text":"Ngibuyisa, njalo ngizabuya,","poem":1},{"text":"ngoba unguThixo uNkulunkulu wami.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Emva kokweduka kwami,","poem":1},{"text":"ngaphenduka;","poem":2},{"text":"emva kokuba sengizwisisile,","poem":1},{"text":"ngazitshaya isifuba.","poem":2},{"text":"Ngaba lenhloni ngadumazeka","poem":1},{"text":"ngoba ngangilehlazo lasebutsheni bami.’","poem":2}]},{"type":"verse","number":20,"content":[{"text":"U-Efrayimi kasindodana yami ethandekayo,","poem":1},{"text":"umntanami engithokoza ngaye na?","poem":2},{"text":"Lanxa ngihlala ngikhuluma kubi ngaye","poem":1},{"text":"ngisamkhumbula.","poem":2},{"text":"Ngakho inhliziyo yami iyamlangatha;","poem":1},{"text":"ngiyamzwela kakhulu,","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Beka izitshengiso zomgwaqo;","poem":1},{"text":"umise lezinsika zeziqondiso.","poem":2},{"text":"Nanzelela umgwaqo,","poem":1},{"text":"indlela ozahamba ngayo.","poem":2},{"text":"Phenduka, wena Ntombi egcweleyo Israyeli,","poem":1},{"text":"buyela emadolobheni akho.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Koze kube nini ulokhu uzulazula,","poem":1},{"text":"wena ndodakazi engathembekanga na?","poem":2},{"text":"UThixo uzadala into entsha emhlabeni,","poem":1},{"text":"owesifazane uzavikela indoda.”","poem":2}]},{"type":"verse","number":23,"content":["UThixo uSomandla, uNkulunkulu ka-Israyeli uthi, “Lapho ngibabuyisa bevela ekuthunjweni, abantu abaselizweni lakoJuda lasemadolobheni alo bazawasebenzisa futhi amazwi la athi, ‘UThixo akubusise wena ndawo yokuhlala elungileyo, wena ntaba engcwele.’"]},{"type":"verse","number":24,"content":["Abantu bazahlala ndawonye koJuda lasemadolobheni akhona wonke, abalimi kanye lalabo abazulazulayo lemihlambi yabo."]},{"type":"verse","number":25,"content":["Ngizaqinisa abadiniweyo ngisuthise abangelamandla.”"]},{"type":"verse","number":26,"content":["Lapho-ke ngaphaphama ngakhangela indawana yonke. Ubuthongo bami babubemnandi kimi."]},{"type":"verse","number":27,"content":["“Insuku ziyeza, lapho engizahlanyela khona indlu ka-Israyeli lendlu kaJuda lenzalo yabantu lezinyamazana."]},{"type":"verse","number":28,"content":["Njengoba ngabalinda ukusiphuna lokudiliza, ukuchitha lokubhubhisa kanye lokuletha umonakalo, ngokunjalo ngizabalinda ukwakha lokuhlanyela,” kutsho uThixo."]},{"type":"verse","number":29,"content":["“Ngalezonsuku abantu kabasayikutsho ukuthi,",{"text":"‘Abazali badle amavini amunyu,","poem":1},{"text":"ngakho amazinyo abantwana asetshelela.’","poem":2}]},{"type":"verse","number":30,"content":["Esikhundleni salokho, umuntu wonke uzafela izono zakhe; loba ngubani odla amavini amunyu amazinyo akhe azatshelela."]},{"type":"verse","number":31,"content":[{"text":"Isikhathi siyeza,","poem":1},{"text":"lapho engizakwenza khona isivumelwano esitsha","poem":2},{"text":"lendlu ka-Israyeli kanye lekaJuda,”","poem":1},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"“Kasiyikufana lesivumelwano","poem":1},{"text":"engasenza labokhokho babo","poem":2},{"text":"lapho engababamba khona ngesandla","poem":1},{"text":"ukuba ngibakhuphe eGibhithe,","poem":2},{"text":"ngoba bephula isivumelwano sami,","poem":1},{"text":"lanxa ngangingumyeni wabo,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"“Lesi yiso isivumelwano engizasenza lendlu ka-Israyeli","poem":1},{"text":"ngemva kwalesosikhathi,” kutsho uThixo.","poem":2},{"text":"“Ngizafaka umthetho wami ezingqondweni zabo,","poem":1},{"text":"ngiwulobe lasezinhliziyweni zabo.","poem":2},{"text":"Ngizakuba nguNkulunkulu wabo,","poem":1},{"text":"bona bazakuba ngabantu bami.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Umuntu kasayikufundisa umakhelwane wakhe,","poem":1},{"text":"kumbe umfowabo esithi, ‘Mazi uThixo,’","poem":2},{"text":"ngoba bonke bazangazi,","poem":1},{"text":"kusukela komncinyane wabo kusiya komkhulu,","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2},{"text":"Ngoba ngizabathethelela ububi babo,","poem":1},{"text":"njalo angiyikukhumbula izono zabo futhi.”","poem":2}]},{"type":"verse","number":35,"content":["Nanku akutshoyo uThixo,",{"text":"yena obeka ilanga ukuba likhanyise emini,","poem":1},{"text":"omisa inyanga lezinkanyezi ukuba kukhanye ebusuku,","poem":2},{"text":"onyakazisa ulwandle","poem":1},{"text":"ukuze amagagasi alo ahlokome,","poem":2},{"lineBreak":true},{"text":"uThixo uSomandla yilo ibizo lakhe, uthi:","poem":2}]},{"type":"verse","number":36,"content":[{"text":"“Nxa izimiso lezi zinganyamalala ebusweni bami,”","poem":1},{"text":"kutsho uThixo,","poem":2},{"text":"“kulapho lenzalo ka-Israyeli ezacina khona","poem":1},{"text":"ukuba yisizwe phambi kwami.”","poem":2}]},{"type":"verse","number":37,"content":["UThixo uthi:",{"text":"“Nxa amazulu phezulu engalinganiswa","poem":1},{"text":"lezisekelo zomhlaba ngaphansi zihlolwe,","poem":2},{"text":"kulapho engingayilahla khona yonke inzalo ka-Israyeli","poem":1},{"text":"ngenxa yakho konke abakwenzileyo,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":38,"content":["“Insuku ziyeza,” kutsho uThixo, “lapho idolobho leli ngizalakhelwa kutsha kusukela eMphotshongweni waseHananeli kusiya eSangweni leNgosi."]},{"type":"verse","number":39,"content":["Intambo yokulinganisa izasukela lapho iqonde eqaqeni lweGarebi ibe isijikela eGowa."]},{"type":"verse","number":40,"content":["Isigodi sonke lapho okulahlelwa khona izidumbu zabafileyo lomlotha, lawo wonke amasimu kusiyafika esigodini seKhidironi ngasempumalanga kusiyafika ejikweni leSango leBhiza, kuzakuba ngcwele kuThixo. Idolobho kaliyikusitshunwa futhi loba lidilizwe.”"]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}