{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"“Nxa uphenduka, wena Israyeli, buyela kimi,”","poem":1},{"text":"kutsho uThixo.","poem":2},{"text":"“Ungasusa phambi kwami izithombe zakho ezenyanyekayo","poem":1},{"text":"ungabe usaphambuka futhi,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"njalo nxa uzafunga ngobuqotho,","poem":1},{"text":"ngokulunga langokuqonda, uthi,","poem":2},{"lineBreak":true},{"text":"‘Ngeqiniso elinjengoba uThixo ekhona,’","poem":2},{"text":"ngakho izizwe uzazibusisa","poem":1},{"text":"ziziqhenye ngaye.”","poem":2}]},{"type":"verse","number":3,"content":["Ebantwini bakoJuda labeJerusalema uThixo uthi:",{"text":"“Qhathani ingqatho yenu,","poem":1},{"text":"lingahlanyeli phakathi kwameva.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Zisokeleni kuThixo,","poem":1},{"text":"lisoke inhliziyo zenu,","poem":2},{"lineBreak":true},{"text":"lina bantu bakoJuda lani bantu baseJerusalema,","poem":2},{"text":"hlezi ulaka lwami luvuke luvuthe njengomlilo","poem":1},{"text":"ngenxa yobubi elibenzileyo,","poem":2},{"lineBreak":true},{"text":"lutshise kungekho muntu ongalucitsha.”","poem":2}]},{"type":"heading","content":["Umonakalo Ovela Enyakatho"]},{"type":"verse","number":5,"content":[{"text":"“Bikani koJuda limemezele laseJerusalema lithi:","poem":1},{"text":"‘Tshayani icilongo elizweni lonke!’","poem":2},{"text":"Klabalalani lithi,","poem":1},{"text":"‘Buthanani ndawonye!","poem":2},{"lineBreak":true},{"text":"Kasibalekeleni emadolobheni avikelweyo!’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Phakamisani uphawu lokuya eZiyoni!","poem":1},{"text":"Balekelani ekusileni ngokuphangisa!","poem":2},{"text":"Ngoba ngiletha umonakalo ovela enyakatho,","poem":1},{"text":"lencithakalo embi kakhulu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Isilwane sesiphumile esikhundleni saso,","poem":1},{"text":"umchithi wezizwe usephumile.","poem":2},{"text":"Usesukile endaweni yakhe","poem":1},{"text":"ukuba achithe ilizwe lenu.","poem":2},{"text":"Amadolobho enu azakuba ngamanxiwa","poem":1},{"text":"engelamuntu ohlala kuwo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngakho gqokani amasaka,","poem":1},{"text":"khalani lilile,","poem":2},{"text":"ngoba ulaka lukaThixo olwesabekayo","poem":1},{"text":"kalususwanga kithi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"UThixo uthi,","poem":1},{"text":"“Ngalolosuku inkosi lezikhulu bazaphelelwa lithemba,","poem":2},{"text":"abaphristi bazathuthumela,","poem":1},{"text":"abaphrofethi bazakwesaba.”","poem":2}]},{"type":"verse","number":10,"content":["Lapho-ke mina ngathi, “Awu, Thixo Wobukhosi, ubakhohlisile sibili abantu laba kanye leJerusalema ngokuthi, ‘Lizakuba lokuthula,’ inkemba yona isemiphinjeni yethu!”"]},{"type":"verse","number":11,"content":["Ngalesosikhathi abantu laba leJerusalema kuzathiwa kubo, “Umoya otshisayo ovela enkangala emiqolweni elugwadule uvunguza usiya ebantwini bami, kodwa kungayisikwela kumbe ukuhlungula,"]},{"type":"verse","number":12,"content":["umoya olamandla kakhulu uvela kimi. Khathesi-ke sengimemezela ukwahlulela kwami kubo.”"]},{"type":"verse","number":13,"content":[{"text":"Khangela! Uyeza njengamayezi,","poem":1},{"text":"izinqola zakhe zempi zibuya njengesivunguzane,","poem":2},{"text":"amabhiza akhe alesiqubu esedlula esengqungqulu.","poem":1},{"text":"Maye! Sesiphelile!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"We Jerusalema, geza ububi obusenhliziyweni yakho usindiswe.","poem":1},{"text":"Koze kube nini ugcine imicabango emibi na?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ilizwi elivela koDani liyamemeza,","poem":1},{"text":"libika umonakalo ovela emaqaqeni ako-Efrayimi","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Izizwe zitshele lokhu,","poem":1},{"text":"ukubike laseJerusalema,","poem":2},{"text":"“Ibutho elivimbezelayo liyeza livela elizweni elikhatshana,","poem":1},{"text":"limemezela umkhosi wempi emadolobheni akoJuda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Balihanqile njengabantu abalinda insimu,","poem":1},{"text":"ngoba langihlamukela,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Ukuziphatha kwakho lezenzo zakho","poem":1},{"text":"kwehlisele lokhu phezu kwakho.","poem":2},{"text":"Lesi yisijeziso sakho.","poem":1},{"text":"Sibuhlungu kakhulu!","poem":2},{"lineBreak":true},{"text":"Sihlaba enhliziyweni!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Maye, ngobuhlungu, ubuhlungu engibuzwayo.","poem":1},{"text":"Ngiyazitshila ngenxa yobuhlungu.","poem":2},{"text":"Maye, ngokufuthelwa kwenhliziyo yami!","poem":1},{"text":"Inhliziyo yami iyatshaya ngaphakathi kwami,","poem":2},{"lineBreak":true},{"text":"angingeke ngithule,","poem":2},{"text":"ngoba ukukhala kwecilongo sengikuzwile,","poem":1},{"text":"umkhosi wempi sengiwuzwile.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Incithakalo ilandela incithakalo,","poem":1},{"text":"ilizwe lonke selingamanxiwa.","poem":2},{"text":"Ngesikhatshana nje amathente ami adiliziwe,","poem":1},{"text":"lamakhetheni ami ngomzuzwana nje.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Koze kube nini ngibona uphawu lwempi","poem":1},{"text":"ngisizwa lokukhala kwecilongo na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Abantu bami bayiziwula,","poem":1},{"text":"kabangazi.","poem":2},{"text":"Bangabantwana abangelangqondo,","poem":1},{"text":"kabalakho ukuqedisisa.","poem":2},{"text":"Bahlakaniphele ukwenza okubi,","poem":1},{"text":"kabakwazi ukwenza okulungileyo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ngakhangela umhlaba,","poem":1},{"text":"wawungelasimo njalo ungelalutho;","poem":2},{"text":"lasemazulwini,","poem":1},{"text":"ukukhanya kwawo kwakungasekho.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ngakhangela ezintabeni,","poem":1},{"text":"zazinyikinyeka,","poem":2},{"lineBreak":true},{"text":"lamaqaqa wonke ayezunguzeka.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ngakhangela, kwakungelabantu,","poem":1},{"text":"izinyoni zonke zasezisukile emkhathini.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ngakhangela, ilizwe elithelayo laseliyinkangala,","poem":1},{"text":"amadolobho alo wonke ayesengamanxiwa phambi kukaThixo,","poem":2},{"lineBreak":true},{"text":"phambi kolaka lwakhe olwesabekayo.","poem":2}]},{"type":"verse","number":27,"content":["UThixo uthi:",{"text":"“Ilizwe lonke lizachitheka","poem":1},{"text":"lanxa ngingayikulitshabalalisa ngokupheleleyo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ngakho umhlaba uzalila","poem":1},{"text":"iphezulu libe mnyama,","poem":2},{"text":"ngoba sengikhulumile njalo angiyikuyekethisa,","poem":1},{"text":"sengenze isinqumo angiyikubuyela emuva.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ekuzwakaleni komsindo wabagadi bamabhiza labemitshoko","poem":1},{"text":"amadolobho wonke ayabaleka.","poem":2},{"text":"Abanye bangena ezixukwini,","poem":1},{"text":"abanye bakhwele emadwaleni.","poem":2},{"text":"Amadolobho wonke atshiyiwe,","poem":1},{"text":"akulamuntu ohlala kuwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Wenzani na, wena ohlutshwe kakhulu?","poem":1},{"text":"Kungani ugqoka okubomvu gebhu","poem":2},{"lineBreak":true},{"text":"ufaka lezigqoko zegolide na?","poem":2},{"text":"Kungani ucomba amehlo akho ngomphendulo na?","poem":1},{"text":"Uzicecisela ize.","poem":2},{"text":"Izithandwa zakho ziyakweyisa,","poem":1},{"text":"zifuna ukukubulala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ngizwa ukukhala okunjengokowesifazane ohelelwayo,","poem":1},{"text":"ukububula okufana lozuza umntwana wakhe wakuqala,","poem":2},{"text":"ukukhala kweNdodakazi yaseZiyoni ikhefuzela,","poem":1},{"text":"yelule izandla zayo isithi,","poem":2},{"text":"“Maye mina! Amandla ami asephela,","poem":1},{"text":"ukuphila kwami sekunikelwe kubabulali.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}