phephe lokuphila kwakho.’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/44.json","previousChapterAudioLinks":{},"numberOfVerses":5}