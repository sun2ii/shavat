{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":46,"content":[{"type":"heading","content":["Ilizwi NgeGibhithe"]},{"type":"verse","number":1,"content":["Leli yilizwi likaThixo elafika kuJeremiya umphrofethi mayelana lezizwe:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["Mayelana leGibhithe:",{"lineBreak":true},"Leli yilizwi elimayelana lebutho likaFaro Nekho inkosi yaseGibhithe, elanqotshwayo eKharikhemishi emfuleni iYufrathe nguNebhukhadineza inkosi yaseBhabhiloni ngomnyaka wesine kaJehoyakhimi indodana kaJosiya inkosi yakoJuda:"]},{"type":"verse","number":3,"content":[{"text":"“Lungisani amahawu enu, amakhulu lamancane,","poem":1},{"text":"liphume liye empini.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bophani amabhiza,","poem":1},{"text":"liwagade!","poem":2},{"text":"Manini ezindaweni zenu","poem":1},{"text":"lilezingowane zenu!","poem":2},{"text":"Lolani imikhonto yenu,","poem":1},{"text":"ligqoke impahla zempi!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kuyini engikubonayo?","poem":1},{"text":"Bayesaba,","poem":2},{"text":"bahlehlela emuva,","poem":1},{"text":"amabutho abo ehlulwe.","poem":2},{"text":"Abaleka ngesiqubu","poem":1},{"text":"anganyemukuli,","poem":2},{"lineBreak":true},{"text":"njalo kulokwesaba izindawo zonke,” kutsho uThixo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Olejubane kasoze abaleke","poem":1},{"text":"kumbe olamandla aphephe.","poem":2},{"text":"Ngasenyakatho, emfuleni iYufrathe","poem":1},{"text":"bayakhubeka bawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ngubani lo ophakama njengeNayili,","poem":1},{"text":"njengemifula elamanzi agubhazelayo na?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"IGibhithe liphakama njengeNayili,","poem":1},{"text":"njengemifula elamanzi agubhazelayo.","poem":2},{"text":"Lithi: ‘Ngizaphakama ngembese umhlaba;","poem":1},{"text":"ngizachitha amadolobho labantu bawo.’","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hlaselani, lina mabhiza!","poem":1},{"text":"Qhubekani ngentukuthelo, lina zinqola zempi!","poem":2},{"text":"Yanini phambili, lina mabutho,","poem":1},{"text":"madoda aseKhushi lawePhuthi, aphatha amahawu,","poem":2},{"lineBreak":true},{"text":"madoda aseLudi agoba idandili.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kodwa usuku lolo ngolweNkosi, uThixo uSomandla,","poem":1},{"text":"usuku lokuphindisela, olokuphindisela ezitheni zakhe.","poem":2},{"text":"Inkemba izakudla ize isuthe,","poem":1},{"text":"ize icitshe ukoma kwayo ngegazi.","poem":2},{"text":"Ngoba iNkosi, uThixo uSomandla uzanikela umhlatshelo","poem":1},{"text":"elizweni lasenyakatho ngasemfuleni iYufrathe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yana eGiliyadi uyethatha umuthi wokwelapha,","poem":1},{"text":"wena Ndodakazi egcweleyo yaseGibhithe.","poem":2},{"text":"Kodwa imithi uyandisela ize;","poem":1},{"text":"akukho kusila kuwe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Izizwe zizakuzwa ngehlazo lakho;","poem":1},{"text":"ukukhala kwakho kuzagcwala umhlaba.","poem":2},{"text":"Elinye ibutho lizakhubeka kwelinye;","poem":1},{"text":"womabili azawela phansi ndawonye.”","poem":2}]},{"type":"verse","number":13,"content":["Leli yilizwi uThixo alikhuluma kuJeremiya umphrofethi ngokuza kukaNebhukhadineza inkosi yaseBhabhiloni ukuba ahlasele iGibhithe:"]},{"type":"verse","number":14,"content":[{"text":"“Memezelani lokhu eGibhithe, likubike laseMigidoli;","poem":1},{"text":"kumemezeleni njalo laseMemfisi laseThahiphanesi lithi:","poem":2},{"text":"‘Manini ezindaweni zenu lilunge,","poem":1},{"text":"ngoba inkemba idla abakhelene lani.’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Amabutho enu azabulawelwani na?","poem":1},{"text":"Angeke ame,","poem":2},{"lineBreak":true},{"text":"ngoba uThixo uzawalahlela phansi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Azakhubeka kokuphela;","poem":1},{"text":"azakuwa elekane.","poem":2},{"text":"Azakuthi, ‘Vukani, kasibuyeleni emuva","poem":1},{"text":"ebantwini bakithi lasemazweni akithi,","poem":2},{"lineBreak":true},{"text":"kude kwenkemba yomncindezeli.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Khonale bazamemeza bathi,","poem":1},{"text":"‘UFaro inkosi yaseGibhithe","poem":2},{"lineBreak":true},{"text":"ingumsindo omkhulu nje kuphela;","poem":2},{"lineBreak":true},{"text":"uselahlekelwe lithuba lakhe.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ngeqiniso elinjengokuthi ngikhona,” kutsho iNkosi,","poem":1},{"text":"obizo layo nguThixo uSomandla,","poem":2},{"text":"“kuzafika omunye onjengoThabhori phakathi kwezintaba,","poem":1},{"text":"njengoKhameli ngasolwandle.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Lungisani impahla zekuthunjweni,","poem":1},{"text":"lina abahlala eGibhithe,","poem":2},{"text":"ngoba iMemfisi izadilizwa","poem":1},{"text":"ibe lunxiwa olungahlali muntu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"IGibhithe ilithokazi elihle,","poem":1},{"text":"kodwa isibawu siyeza","poem":2},{"lineBreak":true},{"text":"silisongela sivela enyakatho.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Amabutho okuqatshwa aphakathi kwalo","poem":1},{"text":"anjengamathole anonisiweyo.","poem":2},{"text":"Lawo azaphenduka abaleke endawonye,","poem":1},{"text":"kawayikuma,","poem":2},{"text":"ngoba usuku lomonakalo luyeza phezu kwabo,","poem":1},{"text":"isikhathi sabo sokujeziswa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"IGibhithe izakhwaza njengenyoka ebalekayo","poem":1},{"text":"lapho isitha sisondela ngobunengi baso;","poem":2},{"text":"sizayihlasela ngamahloka","poem":1},{"text":"okwabantu abagamula izihlahla.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Sizagamula amahlathi ayo,” kutsho uThixo,","poem":1},{"text":"“lanxa eminyene kanjani.","poem":2},{"text":"Banengi kulentethe,","poem":1},{"text":"ngeke babalwe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Indodakazi yaseGibhithe izayangiswa,","poem":1},{"text":"inikelwe ebantwini basenyakatho.”","poem":2}]},{"type":"verse","number":25,"content":["UThixo uSomandla, uNkulunkulu ka-Israyeli uthi: “Sekuseduze ukuba ngijezise u-Amoni unkulunkulu waseThebesi, loFaro, leGibhithe kanye labonkulunkulu balo lamakhosi alo, lalabo abathembe uFaro."]},{"type":"verse","number":26,"content":["Ngizabanikela kulabo abafuna ukubabulala, kuNebhukhadineza inkosi yaseBhabhiloni lezikhulu zakhe. Kodwa muva, iGibhithe lizahlalwa ngabantu futhi njengasezinsukwini zakudala,” kutsho uThixo."]},{"type":"verse","number":27,"content":[{"text":"“Ungesabi, wena Jakhobe nceku yami;","poem":1},{"text":"ungathuthumeli, wena Israyeli.","poem":2},{"text":"Impela ngizakukhulula endaweni ekude,","poem":1},{"text":"lenzalo yakho elizweni lokuthunjwa kwayo.","poem":2},{"text":"UJakhobe uzakuba lokuthula","poem":1},{"text":"futhi kanye lokuvikeleka,","poem":2},{"lineBreak":true},{"text":"njalo kakho ozamthuthumelisa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ungesabi wena Jakhobe nceku yami","poem":1},{"text":"ngoba ngilawe,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2},{"text":"“Lanxa ngizachitha ngokupheleleyo izizwe zonke","poem":1},{"text":"engakuhlakazela kuzo,","poem":2},{"lineBreak":true},{"text":"wena angiyikukuchitha ngokupheleleyo.","poem":2},{"text":"Ngizakujezisa kodwa ngokufaneleyo kuphela;","poem":1},{"text":"angiyikukuyekela nje ungajeziswanga.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}