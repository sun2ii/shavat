{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["Ilizwi Ngamafilistiya"]},{"type":"verse","number":1,"content":["Leli yilizwi likaThixo elafika kuJeremiya umphrofethi mayelana lamaFilistiya ngesikhathi uFaro engakahlaseli iGaza:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["UThixo uthi:",{"text":"“Khangela ukuphakama kwamanzi enyakatho;","poem":1},{"text":"azakuba ngumfula okhukhulayo.","poem":2},{"text":"Azakhukhula ilizwe lakho konke okukulo,","poem":1},{"text":"amadolobho lalabo abahlala kuwo.","poem":2},{"text":"Abantu bazakhala,","poem":1},{"text":"bonke abahlala elizweni bazalila","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ekuzweni umsindo wamasondo amabhiza agijimayo,","poem":1},{"text":"lekuzweni umsindo wezinqola zesitha","poem":2},{"lineBreak":true},{"text":"lomdumo wamasondo azo.","poem":2},{"text":"Oyise kabayikuphenduka ukuba basize abantwababo;","poem":1},{"text":"izandla zabo zizalenga zingelamandla.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngoba usuku selufikile","poem":1},{"text":"ukuba abhujiswe wonke amaFilistiya,","poem":2},{"text":"lokuqeda bonke abasilayo","poem":1},{"text":"abangasiza iThire leSidoni.","poem":2},{"text":"Sekuseduze ukuba uThixo abhubhise amaFilistiya,","poem":1},{"text":"insalela emakhunjini eKhafithori.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"IGaza izaphuca ikhanda layo ilila;","poem":1},{"text":"i-Ashikheloni izathuliswa.","poem":2},{"text":"Lina nsalela esemagcekeni,","poem":1},{"text":"lizazisika kuze kube nini na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Likhala lisithi, ‘Maye, nkemba kaThixo,","poem":1},{"text":"koba nini ukuze uphumule?","poem":2},{"text":"Buyela emgodleni wakho;","poem":1},{"text":"khawuka ungathi nyiki.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kodwa ingaphumula njani","poem":1},{"text":"yona ilaywe nguThixo,","poem":2},{"text":"ithunywe nguye","poem":1},{"text":"ukuba ihlasele i-Ashikheloni lamakhumbi olwandle na?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}