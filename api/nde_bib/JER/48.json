{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":48,"content":[{"type":"heading","content":["Ilizwi NgeMowabi"]},{"type":"verse","number":1,"content":["Mayelana leMowabi:",{"lineBreak":true},"UThixo uSomandla, uNkulunkulu ka-Israyeli uthi:",{"text":"“Maye kuyo iNebho ngoba izachithwa.","poem":1},{"text":"IKhiriyathayimi izayangeka njalo ithunjwe;","poem":2},{"lineBreak":true},{"text":"inqaba izayangeka ibhidlizwe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"IMowabi kayiyikudunyiswa futhi;","poem":1},{"text":"eHeshibhoni abantu bazaceba ukumbhidliza:","poem":2},{"lineBreak":true},{"text":"besithi, ‘Wozani sitshabalalise isizwe lesiyana.’","poem":2},{"text":"Lawe, wena Madimeni uzathuliswa;","poem":1},{"text":"inkemba izaxotshana lawe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Zwanini ukukhala okuvela eHoronayimi;","poem":1},{"text":"ukukhala komonakalo omkhulu lencithakalo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"IMowabi izachitheka;","poem":1},{"text":"abancinyane bayo bazakhala.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Baqansa ngendlela eya eLuhithi,","poem":1},{"text":"bahamba belila kabuhlungu,","poem":2},{"text":"emgwaqweni owehlela eHoronayimi,","poem":1},{"text":"kuzwakala ukukhala okulosizi ngenxa yokuchitheka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Balekani! Gijimani lizivikele ekufeni;","poem":1},{"text":"wobani njengesihlahla enkangala.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Njengoba lithembe izenzo zenu lenotho yenu,","poem":1},{"text":"lani futhi lizathunjwa,","poem":2},{"text":"loKhemoshi uzakuya ekuthunjweni,","poem":1},{"text":"kanye labaphristi bakhe lezikhulu zakhe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Umchithi uzafika emadolobheni wonke,","poem":1},{"text":"njalo akukho dolobho elizaphepha.","poem":2},{"text":"Isigodi sizatshabalaliswa,","poem":1},{"text":"lamagceke azaqothulwa","poem":2},{"lineBreak":true},{"text":"ngoba uThixo usekhulumile.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Fakani itswayi kuyo iMowabi","poem":1},{"text":"ngoba izachitheka;","poem":2},{"text":"amadolobho ayo azakuba ngamanxiwa","poem":1},{"text":"angayikuba lamuntu ozahlala kuwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yeka isithuko kulowo oyekethisayo ekwenzeni umsebenzi kaThixo!","poem":1},{"text":"Yeka isithuko kulowo ogodla inkemba yakhe ekuchitheni igazi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"IMowabi ibiphumule kusukela ebutsheni bayo","poem":1},{"text":"njengewayini elisele phezu kwezinsipho zalo,","poem":2},{"text":"elingathelwanga kwenye imbiza lisuswa kwenye","poem":1},{"text":"kayithunjwanga.","poem":2},{"text":"Ngakho inambitheka njengakuqala,","poem":1},{"text":"iphunga layo kaliguqukanga.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kodwa insuku ziyeza,","poem":1},{"lineBreak":true},{"text":"lapho ngizathuma abantu abathulula okusembizeni,","poem":1},{"text":"njalo bazayithululela phandle;","poem":2},{"text":"bazachitha okusezimbizeni zayo","poem":1},{"text":"bazimahlaze imbiza zayo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lapho-ke iMowabi izayangeka ngoKhemoshi","poem":1},{"text":"njengokuyangeka kwendlu ka-Israyeli","poem":2},{"lineBreak":true},{"text":"lapho babethembe iBhetheli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Lingatsho kanjani na ukuthi, ‘Singamabutho,","poem":1},{"text":"amadoda alesibindi empini na’?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"IMowabi izachithwa, amadolobho ayo ahlaselwe;","poem":1},{"text":"amajaha ayo aqinileyo azacakazelwa phansi abulawe,”","poem":2},{"lineBreak":true},{"text":"kutsho iNkosi, obizo layo nguThixo uSomandla.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Ukuwa kweMowabi sekuseduze;","poem":1},{"text":"umonakalo wayo uzafika ngokuphangisa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ikhaleleni lonke lina elakhelene layo,","poem":1},{"text":"bonke abalwaziyo udumo lwayo,","poem":2},{"text":"lithi, ‘Yeka ukwephuka kwentonga yobukhosi elamandla,","poem":1},{"text":"yeka ukwephuka kodondolo oluhle kakhulu!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yehlani ebukhosini benu","poem":1},{"text":"lihlale emhlabathini owomileyo,","poem":2},{"lineBreak":true},{"text":"lina elihlala eNdodakazini yaseDibhoni.","poem":2},{"text":"Ngoba lowo ochitha iMowabi","poem":1},{"text":"uzakuzalihlasela","poem":2},{"lineBreak":true},{"text":"adilize amadolobho enu avikelweyo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Manini emgwaqweni lilinde,","poem":1},{"text":"lina elihlala e-Aroweri.","poem":2},{"text":"Buzani indoda ebalekayo lowesifazane obalekayo;","poem":1},{"text":"babuzeni lithi, ‘Kwenzakaleni na?’","poem":2}]},{"type":"verse","number":20,"content":[{"text":"IMowabi iyangekile, ngoba ichithekile.","poem":1},{"text":"Lilani likhale!","poem":2},{"text":"Bikani ngase-Arinoni","poem":1},{"text":"ukuthi iMowabi itshabalalisiwe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ukwehlulela sekufikile emagcekeni","poem":1},{"text":"eHoloni, leJahazi laseMefahathi,","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"eDibhoni, leNebho laseBhethi-Dibhilathayimi,","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"eKhiriyathayimi, leBhethi-Gamuli laseBhethi Meyoni,","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"eKheriyothi kanye laseBhozira","poem":2},{"lineBreak":true},{"text":"kuwo wonke amadolobho aseMowabi, aseduze lakhatshana.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Uphondo lweMowabi luqunyiwe,","poem":1},{"text":"ingalo yalo yephuliwe,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Idakiseni","poem":1},{"text":"ngoba idelele uThixo.","poem":2},{"text":"IMowabi kayizibhixe ngamahlanzo ayo;","poem":1},{"text":"kayibe yinto yokuhlekwa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"U-Israyeli wayengasinto yokuhlekisa kuwe na?","poem":1},{"text":"Watholakala ephakathi kwamasela na,","poem":2},{"text":"ukuba unikine ikhanda lakho ngokweyisa","poem":1},{"text":"ngasosonke isikhathi lapho ukhuluma ngaye?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Tshiyani amadolobho enu lihlale emadwaleni,","poem":1},{"text":"lina elihlala eMowabi.","poem":2},{"text":"Wobani njengejuba elakhela isidleke salo","poem":1},{"text":"emlonyeni wobhalu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Sizwile ngokuzigqaja kweMowabi,","poem":1},{"text":"ukuziqakisa kwayo lokuzazisa kwayo!","poem":2},{"text":"Ukuzigqaja lokuzikhukhumeza kwayo,","poem":1},{"text":"kanye lokuziphakamisa kwenhliziyo yayo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ngiyakwazi ukudelela kwayo, kodwa kuyize,","poem":1},{"text":"lokuzincoma kwayo akusizi lutho,” kutsho uThixo","poem":2}]},{"type":"verse","number":31,"content":[{"text":"“Ngakho-ke ngiyalila ngeMowabi,","poem":1},{"text":"ngikhalela iMowabi yonke,","poem":2},{"lineBreak":true},{"text":"ngililela abantu baseKhiri-Haresethi.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ngiyalikhalela njengokulila kweJazeri,","poem":1},{"text":"lina zivini zaseSibhima.","poem":2},{"text":"Ingatsha zenu zinaba zifike olwandle,","poem":1},{"text":"zafika olwandle lwaseJazeri.","poem":2},{"text":"Umchithi usehlele","poem":1},{"text":"phezu kwezithelo zakho ezivuthiweyo laphezu kwamavini.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ukuthokoza lokuthaba akusekho","poem":1},{"text":"ezivinini lasemasimini eMowabi.","poem":2},{"text":"Ukugeleza kwewayini ezikhamelweni sengikumisile;","poem":1},{"text":"kakho ozalikhama eklabalala ngentokozo.","poem":2},{"text":"Lanxa kulokuklabalala","poem":1},{"text":"akusikuklabalala kwentokozo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Umsindo wokukhala kwabo uyaphakama","poem":1},{"text":"uvelela eHeshibhoni usiya e-Eliyale laseJahazi,","poem":2},{"text":"uvela eZowari usiyafika eHoronayimi le-Egilathi Shelishiya,","poem":1},{"text":"ngoba lamanzi aseNimirimi asecitshile.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"EMowabi ngizabaqeda","poem":1},{"text":"labo abanikela iminikelo ezindaweni eziphakemeyo","poem":2},{"lineBreak":true},{"text":"batshisele labonkulunkulu babo impepha,” kutsho uThixo.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"“Ngakho inhliziyo yami ikhalela iMowabi njengemfegwana;","poem":1},{"text":"iyakhala njengemfegwana ikhalela abantu beKhiri-Haresethi.","poem":2},{"lineBreak":true},{"text":"Inotho ababeyizuzile kayisekho.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Amakhanda wonke aphuciwe","poem":1},{"text":"lezindevu zonke zigeliwe;","poem":2},{"text":"izandla zonke zisikiwe","poem":1},{"text":"lezinkalo zonke zigqokiswe amasaka.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Phezu kwezimpahla zonke zezindlu zaseMowabi","poem":1},{"text":"lasemagcekeni kazulu,","poem":2},{"text":"akulalutho ngaphandle kokukhala,","poem":1},{"text":"ngoba iMowabi ngiyibulele","poem":2},{"lineBreak":true},{"text":"njengembiza engafunwa muntu,” kutsho uThixo.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"“Yeka ukuphahlazwa kwayo! Yeka ukulila kwabo!","poem":1},{"text":"Yeka ukufulathela kweMowabi ilehlazo!","poem":2},{"text":"IMowabi isibe yinto yokuhlekwa;","poem":1},{"text":"into yokwesatshwa yibo bonke abakhelane layo.”","poem":2}]},{"type":"verse","number":40,"content":["UThixo uthi:",{"text":"“Khangela! Ukhozi lwehlela phansi ngesiqubu,","poem":1},{"text":"lwelulele impiko zalo phezu kweMowabi.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"IKheriyothi izathunjwa,","poem":1},{"text":"lezinqaba zithunjwe.","poem":2},{"text":"Ngalolosuku inhliziyo zamabutho aseMowabi","poem":1},{"text":"zizakuba njengenhliziyo yowesifazane ohelelwayo.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"IMowabi izachithwa ingabe isaba yisizwe","poem":1},{"text":"ngoba yadelela uThixo.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Ukwesaba lomgodi kanye lomjibila kulilindele","poem":1},{"text":"lina bantu baseMowabi,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"“Loba ngubani obalekela ukwesaba","poem":1},{"text":"uzawela emgodini,","poem":2},{"text":"loba ngubani ophuma emgodini","poem":1},{"text":"uzabanjwa ngumjibila;","poem":2},{"text":"ngoba ngizakwehlisela phezu kweMowabi","poem":1},{"text":"umnyaka wokujeziswa kwayo,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“Emthunzini waseHeshibhoni","poem":1},{"text":"ababalekayo bayema kungelasizo,","poem":2},{"text":"ngoba umlilo usuphumile eHeshibhoni,","poem":1},{"text":"ilangabi elivela phakathi kwakoSihoni;","poem":2},{"text":"litshisa amabunzi eMowabi","poem":1},{"text":"inkakhayi zamaqhalaqhala alomsindo.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Maye kuwe! wena Mowabi!","poem":1},{"text":"Abantu baseKhemoshi babhujisiwe;","poem":2},{"text":"amadodana athunjiwe","poem":1},{"text":"lamadodakazi akho athunjiwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Kodwa inhlanhla ye-Mowabi ngizayibuyisela","poem":1},{"text":"ensukwini ezizayo,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2},"Ukwahlulelwa kweMowabi kuphelela lapha."]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}