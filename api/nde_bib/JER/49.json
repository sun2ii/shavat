{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":49,"content":[{"type":"heading","content":["Ilizwi Ngama-Amoni"]},{"type":"verse","number":1,"content":["Mayelana lama-Amoni:",{"lineBreak":true},"Nanku akutshoyo uThixo:",{"text":"“U-Israyeli kalamadodana na?","poem":1},{"text":"Kalandlalifa na?","poem":2},{"text":"Pho kungani uMoleki esethumbe iGadi na?","poem":1},{"text":"Kungani abantu bakhe behlala emadolobheni alo na?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kodwa insuku ziyeza,","poem":1},{"lineBreak":true},{"text":"lapho engizahlaba khona umkhosi wempi","poem":1},{"text":"wokumelana leRabha yama-Amoni,","poem":2},{"text":"izakuba yindunduma yonxiwa;","poem":1},{"text":"lemizi eseduze layo izathungelwa ngomlilo.","poem":2},{"text":"Ngakho u-Israyeli uzabaxotsha","poem":1},{"text":"labo ababemxotshele phandle,” kutsho uThixo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Lila weHeshibhoni, ngoba i-Ayi ichithekile!","poem":1},{"text":"Khalani lina elihlala eRabha!","poem":2},{"text":"Gqokani amasaka lilile;","poem":1},{"text":"gijimelani lapha lalaphaya phakathi kwemiduli,","poem":2},{"text":"ngoba uMoleki uzathunjwa,","poem":1},{"text":"ndawonye labaphristi bakhe kanye lezikhulu zakhe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lizincomelani ngezigodi zenu,","poem":1},{"text":"lizincomelani ngezigodi ezithela kangaka?","poem":2},{"text":"Wena ndodakazi engathembekanga,","poem":1},{"text":"uthemba inotho yakho uthi,","poem":2},{"lineBreak":true},{"text":"‘Ngubani ozangihlasela na?’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngizalilethela ukwesaba","poem":1},{"text":"okuvela kubo bonke abaseduze lani,”","poem":2},{"lineBreak":true},{"text":"kutsho iNkosi, uThixo uSomandla.","poem":2},{"text":"“Lonke lizaxotshelwa khatshana,","poem":1},{"text":"njalo kakho ozaqoqa ababalekayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kodwa emva kwalokho","poem":1},{"text":"ngizabuyisela inhlanhla yama-Amoni,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"heading","content":["Ilizwi Nge-Edomi"]},{"type":"verse","number":7,"content":["Mayelana le-Edomi:",{"lineBreak":true},"Nanku akutshoyo uThixo uSomandla:",{"text":"“Kakuselakuhlakanipha eThemani na?","poem":1},{"text":"Izeluleko sezaphela na kwabahlakaniphileyo?","poem":2},{"lineBreak":true},{"text":"Ukuhlakanipha kwabo sekwabola na?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Phendukani libaleke, licatshe ezimbalwini ezitshonayo,","poem":1},{"text":"lina elihlala eDedani,","poem":2},{"text":"ngoba ngizaletha umonakalo phezu kuka-Esawu","poem":1},{"text":"ngesikhathi engizamjezisa ngaso.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nxa abavuni bamavini befike kuwe,","poem":1},{"text":"kabangeke batshiye amalutshwana na?","poem":2},{"text":"Nxa amasela efika ebusuku","poem":1},{"text":"kabayikuntshontsha lokho okwanele abakufunayo kuphela na?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kodwa u-Esawu ngizamhlubula asale eze;","poem":1},{"text":"ngizakwembula izindawo zakhe zokucatsha,","poem":2},{"lineBreak":true},{"text":"ukuze angacatshi.","poem":2},{"text":"Amabutho akhe ahlomileyo azabhubha","poem":1},{"text":"kanye labomakhelwane bakhe labahlanganyela laye,","poem":2},{"lineBreak":true},{"text":"angabikhona khona ozakuthi,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"‘Tshiya izintandane zakho; ngizavikela impilo yazo","poem":1},{"text":"labafelokazi bakho bangathemba kimi.’ ”","poem":2}]},{"type":"verse","number":12,"content":["UThixo uthi: “Nxa labo abangafanelanga ukunatha inkezo kumele bayinathe, kungani wena ungeze wajeziswa na? Kawuyikuphutha ukujeziswa, kumele uyinathe."]},{"type":"verse","number":13,"content":["Ngifunga ngami, ukuthi iBhozira izakuba lunxiwa lento yokwesatshwa, eyokuthukwa lokuqalekiswa, njalo wonke amadolobho ayo azakuba ngamanxiwa nini lanini,” kutsho uThixo."]},{"type":"verse","number":14,"content":[{"text":"Sengizwe ilizwi elivela kuThixo:","poem":1},{"text":"Kuthunywe isithunywa ezizweni ukuba sithi,","poem":2},{"text":"“Buthanani ukuba liyihlasele!","poem":1},{"text":"Vukani lilwe impi!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Khathesi ngizakwenza ube mncane phakathi kwezizwe,","poem":1},{"text":"udeleleke ebantwini.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ukuthuthumela okungabangwa nguwe,","poem":1},{"text":"lokuzigqaja kwenhliziyo yakho kukukhohlisile,","poem":2},{"text":"wena ohlala eminkenkeni yamadwala,","poem":1},{"text":"wena ohlala ezingqongeni zoqaqa.","poem":2},{"text":"Lanxa usakhela isidleke sakho phezulu njengengqungqulu,","poem":1},{"text":"ukhonapho ngizakwehlisela phansi,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“I-Edomi izakuba yinto yokwesatshwa,","poem":1},{"text":"bonke abadlula khona bazathuthumela baklolode","poem":2},{"lineBreak":true},{"text":"ngenxa yamanxeba ayo wonke.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Njengokuchitheka kweSodoma leGomora,","poem":1},{"text":"kanye lamadolobho awo ayeseduze,","poem":2},{"text":"ngakho kakho ozahlala kuyo,","poem":1},{"text":"kakho ozabuye ahlale khona” kutsho uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Njengesilwane siphuma emahlathini aseJodani","poem":1},{"text":"sisiya emadlelweni amahle,","poem":2},{"text":"i-Edomi ngizayixotsha elizweni layo ngesikhatshana.","poem":1},{"text":"Ngubani okhethiweyo engizamkhethela lokhu na?","poem":2},{"text":"Ngubani onjengami, ngubani ongamelana lami na?","poem":1},{"text":"Njalo nguphi umelusi ongajamelana lami na?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ngakho, zwanini lokho uThixo asecebe ukukwenza nge-Edomi,","poem":1},{"text":"asemise ukukwenza kulabo abahlala eThemani:","poem":2},{"text":"Amazinyane omhlambi azadonselwa le;","poem":1},{"text":"amadlelo awo uzawatshabalalisa ngokupheleleyo ngenxa yabo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ekuzwakaleni komsindo wokuwa kwabo umhlaba uzagedezela,","poem":1},{"text":"ukukhala kwabo kuzazwakala eLwandle oluBomvu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Khangelani! Ingqungqulu izaqonga iphinde yehlele phansi,","poem":1},{"text":"yelulele impiko zayo phezu kweBhozira.","poem":2},{"text":"Ngalolosuku inhliziyo zamabutho ase-Edomi","poem":1},{"text":"zizakuba njengenhliziyo yowesifazane ohelelwayo.","poem":2}]},{"type":"heading","content":["Ilizwi NgeDamaseko"]},{"type":"verse","number":23,"content":["Mayelana leDamaseko:",{"text":"“IHamathi le-Ariphadi athithibele,","poem":1},{"text":"ngoba azwe izindaba ezimbi.","poem":2},{"text":"Adanile,","poem":1},{"text":"akhathazeke njengolwandle olungela kuphumula.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"IDamaseko isibe buthakathaka,","poem":1},{"text":"isiphendukile ukuba ibaleke,","poem":2},{"lineBreak":true},{"text":"isiphethwe layikuphaphazela;","poem":2},{"text":"ibanjwe lusizi lobuhlungu,","poem":1},{"text":"ubuhlungu obunjengowesifazane ohelelwayo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kungani idolobho lodumo lingadelwanga,","poem":1},{"text":"idolobho engithokoza ngalo na?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ngeqiniso izinsizwa zayo zizakuwa emgwaqweni;","poem":1},{"text":"amabutho ayo wonke azathuliswa ngalolosuku,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo uSomandla.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"“Imiduli yaseDamaseko ngizayithungela ngomlilo;","poem":1},{"text":"uzaqothula izinqaba zaseBheni-Hadadi.”","poem":2}]},{"type":"heading","content":["Ilizwi NgeKhedari LeHazori"]},{"type":"verse","number":28,"content":["Mayelana leKhedari lemibuso yaseHazori, eyahlaselwa nguNebhukhadineza inkosi yaseBhabhiloni:",{"lineBreak":true},"UThixo uthi:",{"text":"“Vuka uhlasele iKhedari","poem":1},{"text":"ubhubhise labantu baseMpumalanga.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Amathente abo lemihlambi yabo kuzathunjwa;","poem":1},{"text":"amakhetheni abo azathathwa","poem":2},{"lineBreak":true},{"text":"layo yonke impahla yabo kanye lamakamela abo.","poem":2},{"text":"Abantu bazaklabalala besithi kubo,","poem":1},{"text":"‘Ukwesaba enhlangothini zonke!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Balekani ngokuphangisa!","poem":1},{"text":"Hlalani ezimbalwini ezitshonayo, lina elihlala eHazori,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2},{"text":"“UNebhukhadineza inkosi yaseBhabhiloni usecebe icebo ngani,","poem":1},{"text":"usebumbe icebo ngani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Vukani lihlasele isizwe esizinzileyo,","poem":1},{"text":"esihlezi ngethemba,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo,","poem":2},{"text":"“isizwe esingelawo amasango kumbe imigoqo;","poem":1},{"text":"abantu baso bahlala bodwa.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Amakamela aso azakuba yimpango,","poem":1},{"text":"lemihlambi yabo emikhulu izakuba yimpango.","poem":2},{"text":"Ngizabahlakazela emoyeni labo abasezindaweni ezikude","poem":1},{"text":"njalo ngizaletha umonakalo kubo uvelela enhlangothini zonke,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"“IHazori izakuba yisikhundla samakhanka,","poem":1},{"text":"indawo echithekileyo nini lanini.","poem":2},{"text":"Kakho ozahlala khona,","poem":1},{"text":"akulamuntu ozahlala kuyo.”","poem":2}]},{"type":"heading","content":["Ilizwi Nge-Elamu"]},{"type":"verse","number":34,"content":["Leli yilizwi likaThixo elafika kuJeremiya umphrofethi mayelana le-Elamu, ekuqaleni kombuso kaZedekhiya inkosi yakoJuda, elathi:"]},{"type":"line_break"},{"type":"verse","number":35,"content":["UThixo uSomandla uthi:",{"text":"“Khangela, idandili le-Elamu ngizalephula,","poem":1},{"text":"insika yamandla abo.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ngizalethela i-Elamu imimoya emine","poem":1},{"text":"ezavela emagumbini amane amazulu,","poem":2},{"text":"ngizabahlakazela emimoyeni emine,","poem":1},{"text":"njalo akuyikuba lesizwe","poem":2},{"lineBreak":true},{"text":"abathunjwe e-Elamu abangayikuya kuso.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"I-Elamu ngizayibhidliza phambi kwezitha zayo,","poem":1},{"text":"phambi kwalabo abafuna ukubabulala.","poem":2},{"text":"Ngizakwehlisela umonakalo phezu kwabo","poem":1},{"text":"kanye lolaka lwami oluvuthayo,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2},{"text":"“Ngizabaxhuma ngenkemba","poem":1},{"text":"ngize ngibaqede bonke.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ngizabeka isihlalo sami sobukhosi e-Elamu","poem":1},{"text":"ngichithe inkosi yayo lezikhulu zayo,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“Kodwa inhlanhla ye-Elamu ngizayibuyisa","poem":1},{"text":"ensukwini ezizayo,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/48.json","previousChapterAudioLinks":{},"numberOfVerses":39}