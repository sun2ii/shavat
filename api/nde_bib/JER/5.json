{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":5,"content":[{"type":"heading","content":["Kakho Loyedwa Olungileyo"]},{"type":"verse","number":1,"content":[{"text":"“Yehla ukhwele ngemigwaqo yaseJerusalema,","poem":1},{"text":"ukhangele emaceleni wonke, ucabange,","poem":2},{"lineBreak":true},{"text":"uhlolisise wonke amagceke ayo.","poem":2},{"text":"Nxa ungathola umuntu oyedwa nje","poem":1},{"text":"oqhuba ngobuqotho efuna iqiniso,","poem":2},{"lineBreak":true},{"text":"ngizalithethelela idolobho leli.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lanxa nje besithi, ‘Ngeqiniso elinjengoba uThixo ekhona,’","poem":1},{"text":"bajinge befunga amanga.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Awu Thixo, amehlo akho kawadingi qiniso na?","poem":1},{"text":"Wabatshaya, kodwa kabezwanga buhlungu,","poem":2},{"lineBreak":true},{"text":"wabahlifiza, kodwa bala ukuqondiswa.","poem":2},{"text":"Benza ubuso babo baba lukhuni kulamatshe,","poem":1},{"text":"bala ukuphenduka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngacabanga ngathi, “Laba ngabayanga nje,","poem":1},{"text":"bayizithutha,","poem":2},{"text":"ngoba indlela kaThixo kabayazi,","poem":1},{"text":"lemilayo kaNkulunkulu wabo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngakho-ke ngizakuya kubakhokheli","poem":1},{"text":"ngikhulume labo,","poem":2},{"text":"ngeqiniso indlela kaThixo bayayazi,","poem":1},{"text":"lemilayo kaNkulunkulu wabo.”","poem":2},{"text":"Kodwa nganhliziyonye labo balephula ijogwe","poem":1},{"text":"baqamula lezibopho.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngakho isilwane esivela ehlathini sizabahlasela,","poem":1},{"text":"lempisi evela enkangala ibadlwengule,","poem":2},{"text":"ingwe izabacathamela eduze lamadolobho abo","poem":1},{"text":"ukudabudabula loba ngubani ophumayo,","poem":2},{"text":"ngoba iziphambeko zabo zinkulu,","poem":1},{"text":"lokuhlehlela kwabo emuva kunengi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ngingalithethelela ngenxa yani na?","poem":1},{"text":"Abantwana benu bangidelile,","poem":2},{"lineBreak":true},{"text":"bafunga ngabonkulunkulu abangasibonkulunkulu,","poem":2},{"text":"ngabanika konke abakuswelayo,","poem":1},{"text":"kodwa bona bafeba","poem":2},{"lineBreak":true},{"text":"baminyana ezindlini zezifebe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bangamabhiza amaduna asuthayo, agcwele inkanuko,","poem":1},{"text":"omunye lomunye ekhalela umfazi wenye indoda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngingabajezisi kulokhu na?”","poem":1},{"text":"kutsho uThixo.","poem":2},{"text":"“Ngingaphindiseli esizweni","poem":1},{"text":"esinjengalesi na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ngenani lidabule phakathi kwezivini zaso lizidlwengule,","poem":1},{"text":"kodwa lingazitshabalalisi ngokupheleleyo.","poem":2},{"text":"Phundlani ingatsha zalo,","poem":1},{"text":"ngoba abantu laba kabasibo bakaThixo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Indlu ka-Israyeli lendlu kaJuda","poem":1},{"text":"kazithembekanga impela kimi,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Baqambe amanga ngoThixo","poem":1},{"text":"bathi, “Kasoze enze lutho!","poem":2},{"text":"Akulabubi obuzasehlela,","poem":1},{"text":"kasiyikubona impi loba indlala.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Abaphrofethi bangumoya nje,","poem":1},{"text":"lelizwi kalikho kubo,","poem":2},{"lineBreak":true},{"text":"ngakho abakutshoyo kakwenziwe kubo.”","poem":2}]},{"type":"verse","number":14,"content":["Ngakho-ke uThixo uNkulunkulu uSomandla uthi:",{"text":"“Njengoba abantu sebekhulume amazwi la,","poem":1},{"text":"ngizakwenza amazwi ami emlonyeni wakho abe ngumlilo","poem":2},{"lineBreak":true},{"text":"labantu laba babe zinkuni oziqothulayo.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"UThixo uthi, “Wena ndlu ka-Israyeli,","poem":1},{"text":"ngizaletha isizwe esivela khatshana ukuba sikuhlasele,","poem":2},{"text":"isizwe esidala esiqinileyo,","poem":1},{"text":"isizwe ulimi lwaso ongalwaziyo,","poem":2},{"lineBreak":true},{"text":"lenkulumo yaso ongayizwayo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Imixhaka yaso ifana lengcwaba elivulekileyo,","poem":1},{"text":"bonke bangamabutho alamandla.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bazatshwabadela amabele enu lokudla kwenu,","poem":1},{"text":"batshwabadele amadodana enu kanye lamadodakazi enu,","poem":2},{"text":"bazatshwabadela izimvu zenu kanye lenkomo zenu,","poem":1},{"text":"bazatshwabadela amavini enu kanye lemikhiwa yenu.","poem":2},{"text":"Amadolobho avikelweyo eliwathembileyo","poem":1},{"text":"bazawachitha ngenkemba.","poem":2}]},{"type":"verse","number":18,"content":["Ikanti langalezozinsuku,” kutsho uThixo, “angiyikuliqeda du."]},{"type":"verse","number":19,"content":["Lapho abantu bebuza besithi, ‘Kungani uThixo uNkulunkulu wethu enze konke lokhu kithi?’ Batshele uthi, ‘Njengoba lingilahlile lakhonza onkulunkulu bezizweni elizweni lenu, ngokunjalo khathesi lizasebenzela abezizweni elizweni elingayisilo lenu.’"]},{"type":"verse","number":20,"content":[{"text":"Memezela lokhu endlini kaJakhobe","poem":1},{"text":"njalo ukubike lakoJuda uthi:","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Zwanini lokhu, lina zithutha zabantu abangelangqondo,","poem":1},{"text":"abalamehlo kodwa kababoni,","poem":2},{"lineBreak":true},{"text":"abalezindlebe kodwa kabezwa:","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Akumelanga lingesabe na?”","poem":1},{"text":"kutsho uThixo.","poem":2},{"lineBreak":true},{"text":"“Kaliyikuthuthumela phambi kwami na?","poem":2},{"text":"Ngenza itshebetshebe laba ngumngcele wolwandle","poem":1},{"text":"umkhawulo wanini lanini olungeke luweqe.","poem":2},{"text":"Amagagasi angavinqoza, kodwa awangeke edlule,","poem":1},{"text":"angahlokoma, kodwa awangeke aweqe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kodwa abantu laba balezinhliziyo ezilukhuni ezihlamukayo,","poem":1},{"text":"baphambukile, balahleka.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kabatsho ezinhliziyweni zabo ukuthi,","poem":1},{"text":"‘Kasimesabeni uThixo uNkulunkulu wethu,","poem":2},{"text":"onisa izulu ngesikhathi salo ekwindla lentwasa,","poem":1},{"text":"osithembisa amaviki amiselwe ukuvuna.’","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ukona kwenu kukuvimbele lokhu,","poem":1},{"text":"izono zenu zilemuka okuhle.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Phakathi kwabantu bami kulabantu ababi","poem":1},{"text":"abacathama njengabantu abathiya izinyoni,","poem":2},{"lineBreak":true},{"text":"lanjengalabo abathiya imijibila yokubamba abantu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Njengezitsha ezigcwele izinyoni,","poem":1},{"text":"izindlu zabo zigcwele inkohliso;","poem":2},{"text":"sebenothile njalo sebelamandla","poem":1}]},{"type":"verse","number":28,"content":[{"text":"sebezimukile njalo babancwaba.","poem":2},{"text":"Izenzo zabo ezimbi kazilamkhawulo,","poem":1},{"text":"kabakudingi ukulunga.","poem":2},{"text":"Izintandane kabazikhulumeli ukuba zinqobe,","poem":1},{"text":"amalungelo abayanga kabawavikeli.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Akumelanga ngibajezisele lokhu na?”","poem":1},{"text":"kutsho uThixo.","poem":2},{"text":"“Akumelanga ngiphindisele esizweni","poem":1},{"text":"esinjengalesi na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Into eyesabekayo leyethusayo","poem":1},{"text":"isiyenzakele kulelilizwe:","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Abaphrofethi baphrofitha amanga,","poem":1},{"text":"abaphristi babusa ngamandla abo,","poem":2},{"text":"labantu bami bakuthanda kunjalo.","poem":1},{"text":"Kodwa lizakwenzani ekucineni?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}