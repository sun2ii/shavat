{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":50,"content":[{"type":"heading","content":["Ilizwi NgeBhabhiloni"]},{"type":"verse","number":1,"content":["Leli yilizwi uThixo alikhuluma ngoJeremiya umphrofethi mayelana leBhabhiloni lelizwe lamaKhaladiya:"]},{"type":"verse","number":2,"content":[{"text":"“Memezelani libike phakathi kwezizwe,","poem":1},{"text":"phakamisani uphawu lilubike;","poem":2},{"lineBreak":true},{"text":"lingafihli lutho, kodwa lithi,","poem":2},{"text":"‘IBhabhiloni izathunjwa,","poem":1},{"text":"iBheli izayangiswa,","poem":2},{"lineBreak":true},{"text":"iMariduki ibe lokwesaba.","poem":2},{"text":"Izifanekiso zayo zizayangiswa,","poem":1},{"text":"izithombe zayo zibe lokwesaba.’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isizwe esivela enyakatho sizayihlasela","poem":1},{"text":"sitshabalalise ilizwe layo.","poem":2},{"text":"Kakho ozahlala kuyo;","poem":1},{"text":"abantu lezinyamazana kuzasuka kubaleke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ngalezonsuku, ngalesosikhathi,","poem":1},{"lineBreak":true},{"text":"abantu bako-Israyeli ndawonye labantu bakoJuda","poem":1},{"text":"bazahamba bekhala bedinga uThixo uNkulunkulu wabo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bazabuza indlela eya eZiyoni","poem":1},{"text":"bakhangelise ubuso babo kuyo.","poem":2},{"text":"Bazakuza bazibophele kuThixo","poem":1},{"text":"ngesivumelwano esingapheliyo","poem":2},{"lineBreak":true},{"text":"esingayikukhohlakala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Abantu bami bebeyizimvu ezilahlekileyo,","poem":1},{"text":"abelusi babo babebadukisile","poem":2},{"lineBreak":true},{"text":"babenza bazulazula phezu kwezintaba.","poem":2},{"text":"Bantula phezu kwezintaba laphezu kwamaqaqa","poem":1},{"text":"bakhohlwa indawo yabo yokuphumula.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Loba ngubani owabatholayo wabadla;","poem":1},{"text":"izitha zabo zathi, ‘Kasilacala,","poem":2},{"text":"ngoba benza okubi kuThixo, idlelo labo eliqotho,","poem":1},{"text":"uThixo, ithemba laboyise.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Balekelani ngaphandle kweBhabhiloni;","poem":1},{"text":"sukani elizweni lamaKhaladiya,","poem":2},{"lineBreak":true},{"text":"libe njengembuzi ezikhokhela umhlambi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngoba iBhabhiloni ngizayivusela","poem":1},{"text":"umanyano lwezizwe ezinkulu ezivela elizweni lasenyakatho.","poem":2},{"text":"Bazaviva ezindaweni zabo bamelane layo.","poem":1},{"text":"Njalo izathunjwa kuvelelwa enyakatho.","poem":2},{"text":"Imitshoko yabo izakuba njengamabutho alolwazi","poem":1},{"text":"angaphenduki engelalutho.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngakho iBhabhiloni izaphangwa,","poem":1},{"text":"bonke abayiphangayo bazasuthiseka,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Njengoba lithokoza njalo lithabile,","poem":1},{"text":"lizaphanga ilifa lami ngoba","poem":2},{"text":"liyaqolotsha njengethokazi etshanini,","poem":1},{"text":"njalo likhale njengamabhiza amaduna,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"unyoko uzayangeka kakhulu,","poem":1},{"text":"yena owalizalayo uzakuba lenhloni.","poem":2},{"text":"Uzakuba ngowokucina phakathi kwezizwe,","poem":1},{"text":"inkangala, ilizwe elomileyo, ugwadule.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngenxa yolaka lukaThixo kayiyikuhlalwa muntu kodwa","poem":1},{"text":"izachithwa ngokupheleleyo.","poem":2},{"text":"Bonke abadlula eBhabhiloni bazakwesaba","poem":1},{"text":"baklolode ngenxa yamanxeba ayo wonke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Vivani inhlangothi zonke zeBhabhiloni","poem":1},{"text":"lonke lina eliphethe amadandili.","poem":2},{"text":"Itshokeni! Lingatshiyi mitshoko","poem":1},{"text":"ngoba yonile kuThixo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Klabalalani kuyo ezinhlangothini zonke!","poem":1},{"text":"Iyazinikela, imiphotshongo yayo iyawa,","poem":2},{"lineBreak":true},{"text":"imiduli yayo idilikela phansi.","poem":2},{"text":"Njengoba lokhu kuyikuphindisela kukaThixo,","poem":1},{"text":"phindiselani kuyo iBhabhiloni;","poem":2},{"lineBreak":true},{"text":"yenzani kuyo njengalokhu eyakwenza kwabanye.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Msuseni eBhabhiloni umhlanyeli,","poem":1},{"text":"lomvuni lesikela yakhe ekuvuneni.","poem":2},{"text":"Ngenxa yenkemba yomncindezeli,","poem":1},{"text":"umuntu wonke kabuyele ebantwini bakibo;","poem":2},{"lineBreak":true},{"text":"umuntu wonke kabalekele elizweni lakibo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"U-Israyeli ungumhlambi ohlakazekileyo","poem":1},{"text":"oxotshwe yizilwane.","poem":2},{"text":"Owaqalayo ukumudla","poem":1},{"text":"yinkosi yase-Asiriya;","poem":2},{"text":"owacinayo ukuqhoba amathambo akhe","poem":1},{"text":"nguNebhukhadineza inkosi yaseBhabhiloni.”","poem":2}]},{"type":"verse","number":18,"content":["Ngakho uThixo uSomandla, uNkulunkulu ka-Israyeli uthi:",{"text":"“Ngizayijezisa inkosi yaseBhabhiloni lelizwe layo","poem":1},{"text":"njengoba ngajezisa inkosi yase-Asiriya.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kodwa u-Israyeli ngizambuyisela edlelweni lakhe,","poem":1},{"text":"uzakudla eKhameli kanye laseBhashani;","poem":2},{"text":"inkanuko yakhe izasuthiswa","poem":1},{"text":"emaqaqeni ako-Efrayimi kanye leGiliyadi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ngalezonsuku, ngalesosikhathi,” kutsho uThixo,","poem":1},{"lineBreak":true},{"text":"“ukona kuka-Israyeli kuzadingwa,","poem":1},{"text":"kodwa akuyikuba khona;","poem":2},{"text":"kudingwe lezono zikaJuda","poem":1},{"text":"kodwa kasikho esizafunyanwa,","poem":2},{"lineBreak":true},{"text":"ngoba insalela engiyitshiyayo ngizayithethelela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Hlaselani ilizwe laseMerathayimi","poem":1},{"text":"lalabo abahlala ePhekhodi.","poem":2},{"text":"Xotshanani labo libabulale libaqede du,”","poem":1},{"text":"kutsho uThixo.","poem":2},{"lineBreak":true},{"text":"“Yenzani konke engililaye khona.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Umsindo wempi uselizweni,","poem":1},{"text":"umsindo wencithakalo enkulu!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yeka ukwephuka lokucezuka","poem":1},{"text":"kwesando somhlaba wonke!","poem":2},{"text":"Yeka ukuchitheka kweBhabhiloni","poem":1},{"text":"phakathi kwezizwe!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ngakuthiya ngomjibila, wena Bhabhiloni,","poem":1},{"text":"wabanjwa ungakakwazi lokho;","poem":2},{"text":"waficwa wathunjwa,","poem":1},{"text":"ngoba wamelana loThixo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"UThixo usevule indlu yakhe yezikhali","poem":1},{"text":"wakhupha izikhali zolaka lwakhe,","poem":2},{"text":"ngoba uThixo Wobukhosi, uSomandla","poem":1},{"text":"ulomsebenzi okumele awenze","poem":2},{"lineBreak":true},{"text":"elizweni lamaKhaladiya.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Wozani kuyo limelane layo livela kude.","poem":1},{"text":"Fohlelani eziphaleni zayo;","poem":2},{"lineBreak":true},{"text":"liyibuthelele njengezinqumbi zamabele.","poem":2},{"text":"Ichitheni okupheleleyo","poem":1},{"text":"lingayitshiyeli nsalela.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bulalani zonke inkunzi zayo ezisesengamaguqa;","poem":1},{"text":"ziwiseleni phansi ekuhlatshweni!","poem":2},{"text":"Maye kubo!","poem":1},{"text":"Ngoba usuku lwabo selufikile, isikhathi sabo sokujeziswa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Lalelani ababalekayo labaphephileyo abavela eBhabhiloni","poem":1},{"text":"bememezela eZiyoni","poem":2},{"text":"ngokuphindisela uThixo uNkulunkulu wethu asekwenzile,","poem":1},{"text":"ukuphindisela ngenxa yethempeli lakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Bizani abemitshoko bahlasele iBhabhiloni,","poem":1},{"text":"bonke labo abaphatha amadandili.","poem":2},{"text":"Ihanqeni inxa zonke;","poem":1},{"text":"kungabikhona ophunyukayo.","poem":2},{"text":"Iphindiseleni izenzo zayo;","poem":1},{"text":"yenzani kuyo njengekwenzileyo.","poem":2},{"text":"Ngoba idelele uThixo,","poem":1},{"text":"oNgcwele ka-Israyeli.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ngakho izinsizwa zayo zizakuwa emigwaqweni; ngalolosuku","poem":1},{"text":"wonke amabutho ayo azabulawa,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"“Khangela, ngimelane lawe, wena oyisiqholo,”","poem":1},{"text":"kutsho uThixo, uThixo uSomandla,","poem":2},{"lineBreak":true},{"text":"“ngoba usuku lwakho selufikile,","poem":2},{"lineBreak":true},{"text":"isikhathi sokujeziswa kwakho.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Oyisiqholo uzakhubeka awe,","poem":1},{"text":"njalo kakho ozamsiza amvuse.","poem":2},{"text":"Ngizabasa umlilo emadolobheni akhe","poem":1},{"text":"ozaqothula bonke abakhelene laye.”","poem":2}]},{"type":"verse","number":33,"content":["UThixo uSomandla uthi:",{"text":"“Abantu bako-Israyeli bancindezelwe,","poem":1},{"text":"kanye labantu bakoJuda futhi.","poem":2},{"text":"Bonke abathumbi babo babagagadlele,","poem":1},{"text":"besala ukubadedela bahambe.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Kodwa uMhlengi wabo ulamandla;","poem":1},{"text":"uThixo uSomandla yilo ibizo lakhe.","poem":2},{"text":"Uzavikela imfanelo zabo ngamandla","poem":1},{"text":"ukuze alethe ukuthula elizweni labo,","poem":2},{"lineBreak":true},{"text":"kodwa ukuxokozela kulabo abahlala eBhabhiloni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Inkemba imelana lamaKhaladiya,”","poem":1},{"text":"kutsho uThixo,","poem":2},{"text":"“imelane lalabo abahlala eBhabhiloni","poem":1},{"text":"kanye lezikhulu zayo lezihlakaniphi zayo!","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Inkemba izamelana labaphrofethi balo bamanga!","poem":1},{"text":"Bazakuba yizithutha.","poem":2},{"text":"Inkemba izamelana lamabutho ayo!","poem":1},{"text":"Azakuba lokwesaba okukhulu.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Inkemba izamelana lamabhiza ayo lezinqola zempi","poem":1},{"text":"labo bonke abezizweni abakuyo!","poem":2},{"lineBreak":true},{"text":"Bazakuba ngabafazi.","poem":2},{"text":"Inkemba izamelana lenotho yayo!","poem":1},{"text":"Izaphangwa.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Kuzakuba lokoma kwamanzi ayo!","poem":1},{"text":"Azacitsha.","poem":2},{"text":"Ngoba yilizwe lezithombe,","poem":1},{"text":"izithombe ezizahlanya ngenxa yokwesaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Ngakho izidalwa zasenkangala lezimpisi zizahlala khona,","poem":1},{"text":"lesikhova sizahlala khona.","poem":2},{"text":"Akusayikwakhiwa kuyo lanini","poem":1},{"text":"kumbe kuhlalwe kuyo kusukela kusizukulwane kusiya kusizukulwane.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Njengalokhu uNkulunkulu wachitha iSodoma leGomora","poem":1},{"text":"ndawonye lamadolobho ayeseduzane lawo,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo,","poem":2},{"text":"“ngokunjalo kakho ozahlala khona;","poem":1},{"text":"akulamuntu ozahlala phakathi kwayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"Khangelani! Ibutho liyeza livela enyakatho;","poem":1},{"text":"isizwe esikhulu lamakhosi amanengi","poem":2},{"lineBreak":true},{"text":"bayadungwa kusukela emikhawulweni yomhlaba.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Bahlome ngamadandili langemikhonto;","poem":1},{"text":"balesihluku, kabalasihawu.","poem":2},{"text":"Bezwakala njengolwandle oluhlokomayo","poem":1},{"text":"lapho begade amabhiza abo;","poem":2},{"text":"beza njengabantu abalungele impi ukuba","poem":1},{"text":"bakuhlasele, wena Ndodakazi yaseBhabhiloni.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"INkosi yaseBhabhiloni isiyizwile imibiko ngabo,","poem":1},{"text":"njalo izandla zayo zilenga zingelamandla.","poem":2},{"text":"Usizi seluyibambile,","poem":1},{"text":"ubuhlungu obunjengowesifazane ohelelwayo.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Njengesilwane siphuma emahlathini aseJodani sisiya","poem":1},{"text":"emadlelweni amahle,","poem":2},{"text":"iBhabhiloni ngizayixotsha elizweni layo ngesikhatshana.","poem":1},{"text":"Ngubani okhethiweyo engizamkhethela lokhu na?","poem":2},{"text":"Ngubani onjengami, ngubani ongamelana lami?","poem":1},{"text":"Njalo nguphi umelusi ongajamelana lami na?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"Ngakho, zwanini lokho uThixo asecebe ukukwenza ngeBhabhiloni,","poem":1},{"text":"asemise ukukwenza ngelizwe lamaKhaladiya:","poem":2},{"text":"Amazinyane omhlambi azadonselwa le,","poem":1},{"text":"amadlelo awo uzawatshabalalisa ngokupheleleyo ngenxa yabo.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Ekuzwakaleni komsindo wokuthunjwa kweBhabhiloni umhlaba uzagedezela;","poem":1},{"text":"ukukhala kwayo kuzazwakala phakathi kwezizwe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/49.json","previousChapterAudioLinks":{},"numberOfVerses":46}