{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":["UThixo uthi:",{"text":"“Khangelani, ngizavusa umoya ochithayo","poem":1},{"text":"umelane leBhabhiloni labantu beLebhi Khamayi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngizathumela abezizweni eBhabhiloni","poem":1},{"text":"ukuba bayihlungule njalo batshabalalise lelizwe layo;","poem":2},{"text":"bazamelana layo enhlangothini zonke","poem":1},{"text":"ngosuku lwencithakalo yayo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lingavumeli mtshoki ebopha idandili lakhe","poem":1},{"text":"loba limyekele egqoka isigqoko sakhe sensimbi.","poem":2},{"text":"Lingazitshiyi izinsizwa zayo,","poem":1},{"text":"liliqede du ibutho layo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bazawela phansi bebulewe eBhabhiloni","poem":1},{"text":"belinyazwe okokufa emigwaqweni yayo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngoba u-Israyeli loJuda kabalahlwanga","poem":1},{"text":"nguNkulunkulu wabo, uThixo uSomandla,","poem":2},{"text":"lanxa nje ilizwe labo ligcwele ukona","poem":1},{"text":"phambi koNgcwele ka-Israyeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Balekani eBhabhiloni!","poem":1},{"text":"Sindisani impilo yenu!","poem":2},{"text":"Lingabhujiswa ngenxa yezono zayo.","poem":1},{"text":"Yisikhathi sokuphindisela kukaThixo;","poem":2},{"lineBreak":true},{"text":"uzaphindisela kuyo ngokufaneleyo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"IBhabhiloni yayiyinkezo yegolide esandleni sikaThixo;","poem":1},{"text":"yenza umhlaba wonke wadakwa.","poem":2},{"text":"Izizwe zanatha iwayini layo;","poem":1},{"text":"ngakho khathesi sezihlanya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"IBhabhiloni izakuwa masinyane idilike.","poem":1},{"text":"Ilileleni!","poem":2},{"text":"Idingeleni umuthi wokupholisa ubuhlungu bayo;","poem":1},{"text":"mhlawumbe ingasila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"‘IBhabhiloni kade singayelapha","poem":1},{"text":"kodwa kayelapheki;","poem":2},{"text":"kasiyitshiyeni kuthi lowo lalowo aye elizweni lakibo,","poem":1},{"text":"ngoba ukwahlulela kufika emikhathini","poem":2},{"lineBreak":true},{"text":"kuqonga kuze kufike emayezini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"UThixo usebonakalisile ukuthi kasilacala,","poem":1},{"text":"wozani sibike eZiyoni","poem":2},{"lineBreak":true},{"text":"osekwenziwe nguThixo uNkulunkulu wethu.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Lolani imitshoko;","poem":1},{"text":"thathani amahawu!","poem":2},{"text":"UThixo usevuse amakhosi amaMede","poem":1},{"text":"ngoba inhloso yakhe yikuchitha iBhabhiloni.","poem":2},{"text":"UThixo uzaphindisela,","poem":1},{"text":"aphindisele ngenxa yethempeli lakhe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Phakamiselani imiduli yaseBhabhiloni uphawu!","poem":1},{"text":"Qinisani ukulinda,","poem":2},{"text":"bekani abalindayo,","poem":1},{"text":"lungiselani ukucathamela!","poem":2},{"text":"UThixo uzafeza inhloso yakhe,","poem":1},{"text":"isimiso sakhe ngabantu baseBhabhiloni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lina elihlala ngasemanzini amanengi,","poem":1},{"text":"njalo lilenotho enengi,","poem":2},{"text":"isiphetho senu sesifikile,","poem":1},{"text":"isikhathi senu sokuqunywa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"UThixo uSomandla usefungile ngayo wathi:","poem":1},{"text":"Impela ngizakugcwalisa ngabantu abangangesikhongwane,","poem":2},{"lineBreak":true},{"text":"njalo bazaklabalala ngamacilongo ngaphezu kwakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Wenza umhlaba ngamandla akhe;","poem":1},{"text":"wamisa umhlaba ngokuhlakanipha kwakhe","poem":2},{"lineBreak":true},{"text":"njalo wendlala lamazulu ngokuqedisisa kwakhe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Lapho evungama, amanzi asemazulwini ayahlokoma;","poem":1},{"text":"wenza amayezi aphakame evela emikhawulweni yomhlaba.","poem":2},{"text":"Uthumela umbane ulezulu njalo","poem":1},{"text":"akhuphe umoya eziphaleni zakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Abantu bonke kabalangqondo njalo kabalalwazi;","poem":1},{"text":"wonke umkhandi wegolide uyangiswa yizithombe zakhe.","poem":2},{"text":"Izithombe zakhe azenzayo ziyinkohliso;","poem":1},{"text":"kazilamphefumulo phakathi kwazo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ziyize, izinto zenhlekisa nje;","poem":1},{"text":"lapho ukwahlulelwa kwazo sekufikile, zizabhubha.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Lowo oyingxenye yesizwe sikaJakhobe kafani lalaba,","poem":1},{"text":"ngoba unguMenzi wezinto zonke,","poem":2},{"text":"kubalwa labantu belifa lakhe,","poem":1},{"text":"ibizo lakhe nguThixo uSomandla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Wena uyinduku yami yempi,","poem":1},{"text":"isikhali sami sokulwa","poem":2},{"text":"ngawe ngitshabalalisa izizwe,","poem":1},{"text":"ngawe ngichitha imibuso;","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ngawe ngihlifiza ibhiza lomgadi walo,","poem":1},{"text":"ngawe ngihlifiza inqola yempi lomtshayeli wayo,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ngawe ngihlifiza indoda lomfazi,","poem":1},{"text":"ngawe ngihlifiza amaxhegu labatsha,","poem":2},{"lineBreak":true},{"text":"ngawe ngihlifiza izinsizwa lezintombi,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ngawe ngihlifiza abelusi lemihlambi,","poem":1},{"text":"ngawe ngihlifiza umlimi lenkabi,","poem":2},{"lineBreak":true},{"text":"ngawe ngihlifiza ababusi lezikhulu.","poem":2}]},{"type":"verse","number":24,"content":["Emehlweni enu ngizaphindisela kuyo iBhabhiloni lakubo bonke abahlala kuyo ngenxa yobubi bonke ababenzileyo eZiyoni,” kutsho uThixo."]},{"type":"verse","number":25,"content":[{"text":"“Ngimelana lawe, wena ntaba echithayo,","poem":1},{"text":"wena ochitha umhlaba wonke,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2},{"text":"“Ngizakwelulela isandla sami kuwe,","poem":1},{"text":"ngikugiqe usuka emaweni,","poem":2},{"lineBreak":true},{"text":"ngikwenze ube yintaba eyatshiswayo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Akulalitshe elizasuswa kuwe ukuba libe ngelekhoneni,","poem":1},{"text":"loba elinye ilitshe ukuba ngelesisekelo","poem":2},{"lineBreak":true},{"text":"ngoba lizachithwa kokuphela,” kutsho uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Phakamisani uphawu elizweni!","poem":1},{"text":"Khalisani icilongo phakathi kwezizwe!","poem":2},{"text":"Lungisani izizwe ukuba zilwe layo;","poem":1},{"text":"ibizeleni imibuso le:","poem":2},{"lineBreak":true},{"text":"i-Ararathi leMini kanye le-Ashikhenazi.","poem":2},{"text":"Ibekeleni umlawuli wokulwa layo;","poem":1},{"text":"lithumele amabhiza anjengomtshitshi wentethe.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Lungisani izizwe ukuba zilwe layo,","poem":1},{"text":"amakhosi amaMede,","poem":2},{"text":"ababusi bawo lezikhulu zawo,","poem":1},{"text":"kanye lamazwe wonke awabusayo.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ilizwe liyaqhaqhazela libhinqike","poem":1},{"text":"ngoba inhloso kaThixo yokumelana leBhabhiloni imi injalo","poem":2},{"text":"ukuchitha ilizwe leBhabhiloni","poem":1},{"text":"ukuze kungabikhona ohlala kulo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Amabutho aseBhabhiloni aseyekele ukulwa;","poem":1},{"text":"ahlezi ezinqabeni zawo.","poem":2},{"text":"Amandla awo asephelile.","poem":1},{"text":"Asebe njengabesifazane.","poem":2},{"text":"Izindawo zayo zokuhlala zithungelwe ngomlilo;","poem":1},{"text":"imigoqo lamasango kwephukile.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Esinye isithunywa silandela esinye;","poem":1},{"text":"lesithunywa silandela esinye isithunywa","poem":2},{"text":"ukuyabika enkosini yaseBhabhiloni","poem":1},{"text":"ukuthi idolobho lonke selithunjiwe,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"amazibuko emifula athethwe,","poem":1},{"text":"amaxhaphozi atshiswe ngomlilo","poem":2},{"lineBreak":true},{"text":"lamabutho ethukile.”","poem":2}]},{"type":"verse","number":33,"content":["Nanku okutshiwo nguThixo uSomandla, uNkulunkulu ka-Israyeli:",{"text":"“Indodakazi yaseBhabhiloni injengesiza sokubhulela","poem":1},{"text":"ngesikhathi sokunyathelwa kwaso;","poem":2},{"lineBreak":true},{"text":"isikhathi sokuvunwa kwayo sizafika masinyane.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“UNebhukhadineza inkosi yaseBhabhiloni usesidlile,","poem":1},{"text":"usesenze saphambana amakhanda,","poem":2},{"lineBreak":true},{"text":"usesenze saba yimbiza engelalutho.","poem":2},{"text":"Usesiginyile njengenyoka,","poem":1},{"text":"wagcwalisa isisu sakhe ngezibiliboco zethu,","poem":2},{"lineBreak":true},{"text":"wasesihlanza futhi.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Udlakela olwenziwe emizimbeni yethu kalube phezu kweBhabhiloni,”","poem":1},{"text":"kutsho abahlala eZiyoni.","poem":2},{"text":"“Igazi lethu kalibe phezu kwalabo abahlala eBhabhiloni,”","poem":1},{"text":"kutsho iJerusalema.","poem":2}]},{"type":"verse","number":36,"content":["Ngakho uThixo uthi:",{"text":"“Khangelani, imfanelo yenu ngizayivikela,","poem":1},{"text":"ngiliphindiselele;","poem":2},{"text":"ngizacitsha ulwandle lwayo","poem":1},{"text":"ngomise lemithombo yayo.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"IBhabhiloni izakuba yinqumbi yonxiwa,","poem":1},{"text":"isikhundla samakhanka,","poem":2},{"text":"into yokwesatshwa lokuklolodelwa,","poem":1},{"text":"indawo engahlali muntu.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Abantu bayo bonke bayabhonga njengezilwane ezincane,","poem":1},{"text":"bayahwabha njengemidlwane yesilwane.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Kodwa lapho besesebukhali,","poem":1},{"text":"ngizabenzela idili ngibadakise,","poem":2},{"text":"ukuze baklabalale ngohleko,","poem":1},{"text":"babe sebelala kokuphela bangavuki futhi,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"“Ngizabehlisela phansi","poem":1},{"text":"njengamawundlu esilaheni,","poem":2},{"lineBreak":true},{"text":"njengenqama lembuzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"Yeka ukuthunjwa okuzakwenziwa iSheshaki,","poem":1},{"text":"ukuzincoma komhlaba wonke kuthunjiwe!","poem":2},{"text":"Yeka ukutshaqisa iBhabhiloni ezakuba yikho","poem":1},{"text":"phakathi kwezizwe!","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Ulwandle luzaphakama phezu kweBhabhiloni;","poem":1},{"text":"amagagasi alo ahlokomayo ayisibekele.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Amadolobho ayo azachitheka,","poem":1},{"text":"ilizwe elomileyo","poem":2},{"text":"leliyinkangala,","poem":1},{"text":"ilizwe okungekho ohlala khona,","poem":2},{"lineBreak":true},{"text":"okungekho muntu odabula phakathi kwalo.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Ngizamjezisa uBheli eBhabhiloni","poem":1},{"text":"ngimenze akuhlanze lokho akuginyileyo.","poem":2},{"text":"Izizwe kazisayikujulukela kuye.","poem":1},{"text":"Njalo umduli weBhabhiloni uzakuwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"Bantu bami, phumani kulo iBhabhiloni!","poem":1},{"text":"Balekelani ukufa!","poem":2},{"lineBreak":true},{"text":"Balekelani ulaka olwesabekayo lukaThixo.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Lingaphelelwa lithemba kumbe lesabe","poem":1},{"text":"lapho kuzwakala amahungahunga elizweni;","poem":2},{"text":"elinye ihungahunga lifika lonyaka, elinye kozayo,","poem":1},{"text":"amahungahunga odlakela elizweni","poem":2},{"lineBreak":true},{"text":"awombusi evukela umbusi.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Ngoba isikhathi sizafika impela","poem":1},{"text":"lapho ngizajezisa izithombe zaseBhabhiloni;","poem":2},{"text":"ilizwe layo lonke lizayangeka","poem":1},{"text":"lababuleweyo bayo bonke bazawela phakathi kwayo.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Lapho-ke izulu lomhlaba lakho konke okukukho","poem":1},{"text":"kuzamemezela intokozo ngeBhabhiloni,","poem":2},{"text":"ngoba abachithi bazayihlasela","poem":1},{"text":"bevelela enyakatho,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"“IBhabhiloni kumele idilike ngenxa yabako-Israyeli ababulawayo,","poem":1},{"text":"njengokubulawa kwabantu emhlabeni wonke,","poem":2},{"lineBreak":true},{"text":"batshabalala ngenxa yeBhabhiloni.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Lina eliphephileyo enkembeni,","poem":1},{"text":"sukani njalo lingalibali!","poem":2},{"text":"Khumbulani uThixo elizweni elikude,","poem":1},{"text":"licabange langeJerusalema.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"“Siyangekile, ngoba siqalekisiwe,","poem":1},{"text":"lehlazo lembese ubuso bethu,","poem":2},{"text":"ngoba abezizweni bangene","poem":1},{"text":"ezindaweni ezingcwele zendlu kaThixo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"UThixo uthi, “Kodwa insuku ziyeza,","poem":1},{"text":"lapho engizajezisa khona izithombe zayo,","poem":2},{"text":"njalo elizweni layo lonke","poem":1},{"text":"abalimeleyo bazabubula.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Lanxa iBhabhiloni ingafinyelela emkhathini","poem":1},{"text":"iqinise izinqaba zayo eziphakemeyo,","poem":2},{"lineBreak":true},{"text":"ngizathumela abachithi bayihlasele,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"“Umsindo wokukhala uvela eBhabhiloni,","poem":1},{"text":"umsindo wencithakalo enkulu","poem":2},{"lineBreak":true},{"text":"ovela elizweni lamaKhaladiya.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"UThixo uzayichitha iBhabhiloni;","poem":1},{"text":"uzathulisa umsindo wayo wenhlokomo.","poem":2},{"text":"Amagagasi ezitha azahlokoma njengamanzi amanengi;","poem":1},{"text":"ukuvungama kwamazwi azo kuzazwakala.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Umchithi uzakuzahlasela iBhabhiloni;","poem":1},{"text":"amabutho ayo azathunjwa,","poem":2},{"lineBreak":true},{"text":"lamadandili awo azakwephuka.","poem":2},{"text":"Ngoba uThixo unguNkulunkulu wempindiselo;","poem":1},{"text":"uzaphindisela ngokugcweleyo.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Ngizadakisa izikhulu lezihlakaniphi zayo,","poem":1},{"text":"kanye lababusi bayo, lezinduna kanye lamabutho;","poem":2},{"text":"bazalala kokuphela bangavuki futhi,”","poem":1},{"text":"kutsho uThixo, obizo lakhe nguThixo uSomandla.","poem":2}]},{"type":"verse","number":58,"content":["UThixo uSomandla uthi:",{"text":"“Umduli oqatha weBhabhiloni uzabhidlizwa","poem":1},{"text":"lamasango ayo aphakemeyo athungelwe ngomlilo;","poem":2},{"text":"abantu bazidinisela ize,","poem":1},{"text":"umsebenzi wezizwe ungamafutha amalangabi nje kuphela.”","poem":2}]},{"type":"verse","number":59,"content":["Leli yilizwi uJeremiya umphrofethi alinika induna yamabutho uSeraya indodana kaNeriya, indodana kaMahaseyiya, esesiya eBhabhiloni loZedekhiya inkosi yakoJuda ngomnyaka wesine wokubusa kwakhe."]},{"type":"verse","number":60,"content":["UJeremiya wayelobe emqulwini ngomonakalo wonke owawuzakwehlela iBhabhiloni lakho konke okwakubhalwe ngeBhabhiloni."]},{"type":"verse","number":61,"content":["Wathi kuSeraya, “Lapho usufikile eBhabhiloni ubowafunda wonke amazwi la ngelizwi eliphakemeyo."]},{"type":"verse","number":62,"content":["Ube ususithi, ‘Awu Thixo, wathi indawo le uzayichitha ukuze kungabi lamuntu kumbe inyamazana ezahlala kuyo; izaphundleka kuze kube nininini.’"]},{"type":"verse","number":63,"content":["Lapho usuqedile ukubala umqulu lo, ubophele ilitshe kuwo uwuphosele kuYufrathe,"]},{"type":"verse","number":64,"content":["ubususithi, ‘Izatshona kanje iBhabhiloni ingabe isavumbuluka ngenxa yomonakalo engizayehlisela wona. Labantu bayo bazakuwa.’ ”",{"lineBreak":true},{"lineBreak":true},"Amazwi kaJeremiya aphelela lapha."]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}