{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":6,"content":[{"type":"heading","content":["IJerusalema Livinjezelwe"]},{"type":"verse","number":1,"content":[{"text":"“Balekani ukuze liphephe, bantu bakoBhenjamini!","poem":1},{"text":"Balekani eJerusalema!","poem":2},{"text":"Tshayani icilongo eThekhowa!","poem":1},{"text":"Phakamisani uphawu phezu kweBhethi-Hakheremi.","poem":2},{"text":"Ngoba umonakalo uyabonakala ngasenyakatho,","poem":1},{"text":"kanye lencithakalo eyesabekayo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Indodakazi yaseZiyoni","poem":1},{"text":"enhle kangaka lebucayi ngizayibhubhisa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abelusi lemihlambi yabo bazakuza bamelane layo;","poem":1},{"text":"bazamisa amathente abo eyihanqile,","poem":2},{"lineBreak":true},{"text":"lowo lalowo elinde indawo yakhe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Lungelani ukulwa layo!","poem":1},{"text":"Vukani, kasihlaseleni emini!","poem":2},{"text":"Kodwa, habe, ukukhanya sekufiphala,","poem":1},{"text":"lamathunzi okuhlwa asesiba made.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngakho vukani, kasihlaseleni ebusuku","poem":1},{"text":"sidilize izinqaba zayo!”","poem":2}]},{"type":"verse","number":6,"content":["UThixo uSomandla uthi:",{"text":"“Gamulani izihlahla liziwise","poem":1},{"text":"lakhe imiduli yokuvimbezela iJerusalema.","poem":2},{"text":"Idolobho leli kumele lijeziswe,","poem":1},{"text":"ligcwele ukuncindezela.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Njengomthombo ugobhoza amanzi awo,","poem":1},{"text":"ngokunjalo lalo ligobhoza ububi balo.","poem":2},{"text":"Udlakela lokubhubhisa kuyezwakala phakathi kwalo,","poem":1},{"text":"umkhuhlane walo lamanxeba ngihlezi ngikukhangele.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Xwayiseka, we Jerusalema,","poem":1},{"text":"hlezi ngikutshiye,","poem":2},{"text":"lelizwe lakho ngilichithe,","poem":1},{"text":"kungabi lomuntu ohlala kulo.”","poem":2}]},{"type":"verse","number":9,"content":["UThixo uSomandla uthi:",{"text":"“Kababuthe izinsalela zako-Israyeli","poem":1},{"text":"ngokupheleleyo njengevini,","poem":2},{"text":"dlulisa futhi isandla sakho phezu kwezingatsha,","poem":1},{"text":"njengomuntu ovuna amavini.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ngubani engingakhuluma laye ngimxwayise na?","poem":1},{"text":"Ngubani ozangilalela na?","poem":2},{"text":"Indlebe zabo zivalekile","poem":1},{"noteId":0},{"text":"ngakho abangeke bezwe.","poem":2},{"text":"Ilizwi likaThixo liyisinengiso kubo.","poem":1},{"text":"Kabafumani ntokozo kulo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kodwa mina ngiyafuthelana ngolaka lukaThixo,","poem":1},{"text":"ngingeke ngibe ngisalugodla ngaphakathi.","poem":2},{"lineBreak":true},{"text":"“Lwehlisele phezu kwabantwana emgwaqweni","poem":1},{"text":"laphezu kwamajaha abuthene ndawonye,","poem":2},{"text":"bobabili indoda lomkayo luzabehlela,","poem":1},{"text":"kanye labadala, labo abakhulelwa yiminyaka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Izindlu zabo zizanikwa abanye,","poem":1},{"text":"konke lamasimu abo kanye labafazi babo,","poem":2},{"text":"lapho ngiselula isandla sami","poem":1},{"text":"ngimelana lalabo abahlala elizweni,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Kusukela kwabancane kusiya kwabakhulu,","poem":1},{"text":"bonke bayizihwaba ezifuna inzuzo,","poem":2},{"text":"banjalo abaphrofethi kanye labaphristi,","poem":1},{"text":"bonke benza inkohliso.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Babopha inxeba labantu bami","poem":1},{"text":"kungathi kalilibi kakhulu.","poem":2},{"text":"Bathi, ‘Ukuthula, ukuthula,’","poem":1},{"text":"khona ukuthula kungekho.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bayayangeka na ngokuziphatha kwabo okwenyanyekayo?","poem":1},{"text":"Hatshi, bavele kabalazo inhloni","poem":2},{"lineBreak":true},{"text":"lokuyangeka kabakwazi.","poem":2},{"text":"Ngakho bazawela phakathi kwabawileyo,","poem":1},{"text":"bazakwehliselwa phansi lapho sengibajezisa,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":16,"content":["UThixo, uthi:",{"text":"“Manini emahlanganweni emigwaqo likhangele,","poem":1},{"text":"libuze izindledlana ezindala,","poem":2},{"text":"libuze lapho okulendlela enhle khona, lihambe ngayo,","poem":1},{"text":"lizathola ukuphumula kwemiphefumulo yenu.","poem":2},{"lineBreak":true},{"text":"Kodwa lina lithe, ‘Kasiyikuhamba ngayo.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngalibekela abantu bokulilinda ngathi,","poem":1},{"text":"‘Lalelani ukukhala kwecilongo!’","poem":2},{"lineBreak":true},{"text":"Kodwa lina lathi, ‘Kasiyikulalela.’","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngakho zwanini, lina zizwe,","poem":1},{"text":"khangelani, lina elingofakazi,","poem":2},{"lineBreak":true},{"text":"libone okuzakwenzakala kubo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Zwana, wena mhlaba,","poem":1},{"text":"ngiletha umonakalo phezu kwabantu laba,","poem":2},{"lineBreak":true},{"text":"izithelo zamaqhinga abo,","poem":2},{"text":"ngoba kabawalalelanga amazwi ami","poem":1},{"text":"njalo bawalile lomthetho wami.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ngilani lempepha yaseShebha","poem":1},{"text":"loba imfe evela elizweni elikude na?","poem":2},{"text":"Iminikelo yenu yokutshiswa kayamukeleki,","poem":1},{"text":"imihlatshelo yenu kayingithokozisi.”","poem":2}]},{"type":"verse","number":21,"content":["Ngakho uThixo uthi:",{"text":"“Ngizabeka imigoqo phambi kwalababantu.","poem":1},{"text":"Abazali labantwana bazakhubeka kuyo,","poem":2},{"lineBreak":true},{"text":"omakhelwane labangane bazabhubha.”","poem":2}]},{"type":"verse","number":22,"content":["UThixo uthi:",{"text":"“Khangelani, ibutho liyeza","poem":1},{"text":"livela elizweni lasenyakatho,","poem":2},{"text":"isizwe esikhulu siyadungwa","poem":1},{"text":"kusukela emikhawulweni yomhlaba.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bahlome ngamadandili langemikhonto,","poem":1},{"text":"balesihluku kabalasihawu.","poem":2},{"text":"Bezwakala njengolwandle oluhlokomayo","poem":1},{"text":"lapho begade amabhiza abo,","poem":2},{"text":"beza njengabantu abalungele impi ukuba bakuhlasele,","poem":1},{"text":"wena Ndodakazi yaseZiyoni.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Sesizwe imibiko ngabo,","poem":1},{"text":"njalo izandla zethu zilenga zingelamandla.","poem":2},{"text":"Usizi lusibambile,","poem":1},{"text":"ubuhlungu obunjengowesifazane ohelelwayo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Lingayi phandle egangeni,","poem":1},{"text":"loba lihambe emigwaqweni,","poem":2},{"text":"ngoba isitha silenkemba,","poem":1},{"text":"njalo silencithakalo emaceleni wonke.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Awu bantu bami, gqokani amasaka,","poem":1},{"text":"lizibhuqe emlotheni,","poem":2},{"text":"khalani lilile kabuhlungu","poem":1},{"text":"njengokwendodana eyiyo yodwa,","poem":2},{"text":"ngoba masinyane nje umchithi","poem":1},{"text":"uzafika kithi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Ngikwenze umhloli wezinsimbi","poem":1},{"text":"labantu bami babayilitshe elixubene lensimbi","poem":2},{"text":"ukuba ukhangele ubone","poem":1},{"text":"ube usuhlola izindlela zabo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Bonke bangabahlamuki abalukhuni,","poem":1},{"text":"abahamba behleba.","poem":2},{"text":"Balithusi lensimbi,","poem":1},{"text":"bonke benza ukuxhwala.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Imvutho ivutha okwesabekayo","poem":1},{"text":"incibilikisa umnusu ngokutshisa komlilo","poem":2},{"text":"kodwa ukucenga kuqhubeka kuyize,","poem":1},{"text":"ababi kabakhutshwanga.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kuthiwa bayisiliva esilahliweyo,","poem":1},{"text":"ngoba uThixo usebalahlile.”","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"6.10 NgesiHebheru kutsho ukuthi abasokwanga","reference":{"chapter":6,"verse":10}}]},"thisChapterLink":"/api/nde_bib/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}