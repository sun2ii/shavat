{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":8,"content":[{"type":"heading","content":["Ukona Lobuqili BukaJuda"]},{"type":"verse","number":1,"content":["“ ‘Ngalesosikhathi, kutsho uThixo, amathambo amakhosi akoJuda lawezikhulu zakhona, amathambo abaphristi lawabaphrofethi, kanye lamathambo abantu baseJerusalema azakhutshwa emangcwabeni awo."]},{"type":"verse","number":2,"content":["Azachaywa elangeni lasenyangeni lakuzo zonke izinkanyezi zasemazulwini, abakuthandayo bakukhonza njalo abakulandelayo bakubuza bakudumisa. Kawayikubuthwa loba angcwatshwe, kodwa azakuba njengezibi phezu komhlabathi."]},{"type":"verse","number":3,"content":["Loba kungaphi engibaxotshela khona, bonke abasilayo balesisizwe esibi bazakhetha ukufa kulokuphila, kutsho uThixo uSomandla.’ ”"]},{"type":"heading","content":["Isono Lesijeziso"]},{"type":"verse","number":4,"content":["“Wothi kubo, ‘UThixo uthi:",{"text":"Abantu bangawa, kabavuki na?","poem":1},{"text":"Omunye angaphambuka, kaphenduki na?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pho kungani abantu laba bedukile?","poem":1},{"text":"Kungani iJerusalema lihlala liseduka?","poem":2},{"text":"Bayanamathela enkohlisweni,","poem":1},{"text":"bayala ukuphenduka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngilalele ngesineke,","poem":1},{"text":"kodwa kabatsho okulungileyo.","poem":2},{"text":"Kakho ophenduka ebubini bakhe,","poem":1},{"text":"esithi, “Kuyini engikwenzileyo na?”","poem":2},{"text":"Yilowo lalowo ulandela indlela yakhe","poem":1},{"text":"njengebhiza lizithela empini.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lengabuzane emoyeni","poem":1},{"text":"liyazazi izikhathi zalo zomnyaka,","poem":2},{"text":"lejuba, lenkonjane lohemu","poem":1},{"text":"kuyasigcina isikhathi sakho sokuthutha.","poem":2},{"text":"Kodwa abantu bami kabakwazi","poem":1},{"text":"okufunwa nguThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lingatsho kanjani ukuthi, “Sihlakaniphile,","poem":1},{"text":"ngoba silomthetho kaThixo,”","poem":2},{"text":"lona iqiniso kuyikuthi amanga alotshwe ngosiba lwababhali","poem":1},{"text":"asenze umthetho wangabi liqiniso?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abahlakaniphileyo bazayangiswa,","poem":1},{"text":"bazakwesaba bathiyeke.","poem":2},{"text":"Njengoba belalile ilizwi likaThixo,","poem":1},{"text":"balenhlakanipho bani na?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngakho abafazi babo ngizabapha amanye amadoda","poem":1},{"text":"lamasimu abo abe ngawabanye abatsha.","poem":2},{"text":"Kusukela kwabancane kusiya kwabakhulu,","poem":1},{"text":"bonke bayizihwaba ezifuna inzuzo,","poem":2},{"text":"banjalo abaphrofethi kanye labaphristi,","poem":1},{"text":"bonke benza inkohliso.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Babopha inxeba labantu bami","poem":1},{"text":"kungathi kalilibi kakhulu.","poem":2},{"text":"Bathi, “Ukuthula, ukuthula,”","poem":1},{"text":"khona ukuthula kungekho.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kambe bayayangeka na ngokuziphatha kwabo okunengisayo?","poem":1},{"text":"Hatshi, bavele kabalazo inhloni,","poem":2},{"lineBreak":true},{"text":"lokuyangeka kabakwazi.","poem":2},{"text":"Ngakho bazawela phakathi kwabawileyo,","poem":1},{"text":"bazakwehliselwa phansi lapho sebejeziswa,","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ngizabemuka isivuno sabo,","poem":1},{"text":"kutsho uThixo.","poem":2},{"lineBreak":true},{"text":"Akuyikuba lezithelo ezivinini zabo.","poem":2},{"text":"Akuyikuba lezithelo zomkhiwa esihlahleni,","poem":1},{"text":"lamahlamvu aso azabuna.","poem":2},{"text":"Engibanike khona","poem":1},{"text":"kuzathathwa kubo.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Pho sihlaleleni lapha?","poem":1},{"text":"Buthanini!","poem":2},{"text":"Kasibalekeleni emadolobheni avikelweyo","poem":1},{"text":"siyebhubhela khona!","poem":2},{"text":"Ngoba uThixo uNkulunkulu wethu usesilahlele ekubhubheni","poem":1},{"text":"wasinika amanzi aletshefu ukuba sinathe,","poem":2},{"lineBreak":true},{"text":"ngoba sonile kuye.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Sathemba ukuba lokuthula","poem":1},{"text":"kodwa akubanga lobuhle obukhona,","poem":2},{"text":"ekubeni kube yisikhathi sokwelatshwa","poem":1},{"text":"kwaba lokwesaba.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ukuthimula kwamabhiza esitha","poem":1},{"text":"kuyezwakala kuvelela koDani,","poem":2},{"text":"ekukhaleni kwamabhiza amaduna","poem":1},{"text":"ilizwe lonke liyaqhaqhazela.","poem":2},{"text":"Zilande ukuzatshwabadela","poem":1},{"text":"ilizwe lakho konke okukulo,","poem":2},{"lineBreak":true},{"text":"idolobho labo bonke abahlala kulo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Khangelani, ngizathumela phakathi kwenu","poem":1},{"text":"izinyoka ezilobuhlungu,","poem":2},{"lineBreak":true},{"text":"izinhlangwana ezingeke zithakathwe, njalo zizaliluma,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Awu Mduduzi wami osizini,","poem":1},{"text":"inhliziyo yami isiqaleka phakathi kwami.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Lalela ukukhala kwabantu bami","poem":1},{"text":"okuvela elizweni elikhatshana besithi:","poem":2},{"text":"“UThixo kakho eZiyoni na?","poem":1},{"text":"INkosi yalo kayisekho lapho na?”","poem":2},{"lineBreak":true},{"text":"“Kungani bevuse ulaka lwami ngezifanekiso zabo,","poem":1},{"text":"langezithombe zezizweni eziyize na?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Ukuvuna sekwedlule,","poem":1},{"text":"ihlobo seliphelile,","poem":2},{"lineBreak":true},{"text":"kodwa kasihlengwanga.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Njengoba abantu bami benqotshiwe lami nginqotshiwe,","poem":1},{"text":"ngiyalila njalo ukwesaba kungiphethe.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Akulamuthi yini eGiliyadi?","poem":1},{"text":"Kakho yini lomelaphi khona?","poem":2},{"text":"Pho kungani kungekho kwelatshwa","poem":1},{"text":"kwenxeba labantu bami na?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}