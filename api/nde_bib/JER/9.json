{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JER","translationId":"nde_bib","name":"UJeremiya","commonName":"UJeremiya","title":"UJeremiya","order":24,"numberOfChapters":52,"sha256":"98f1ed456be126961e522e0bf2f9f4975ecfcfbb826542d02643a3ed880ce9cb","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/nde_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"Awu, sengathi ngabe ikhanda lami lingumthombo wamanzi,","poem":1},{"text":"lamehlo ami angumthombo wezinyembezi!","poem":2},{"text":"Kade ngizakhala emini lebusuku","poem":1},{"text":"ngikhalela abantu bami ababuleweyo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Awu, sengathi ngabe enkangala","poem":1},{"text":"ngilendawo engahlala izihambi,","poem":2},{"text":"ukuba ngisuke ebantwini bami","poem":1},{"text":"ngisuke kubo,","poem":2},{"text":"ngoba bonke bayizifebe,","poem":1},{"text":"ixuku labantu abangathembekanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Benza izindimi zabo zilunge","poem":1},{"text":"njengesavutha ukuba batshoke amanga,","poem":2},{"text":"ukuthi bayanqoba elizweni","poem":1},{"text":"akusikho ngeqiniso.","poem":2},{"text":"Basuka kokunye ukona baye kokunye;","poem":1},{"text":"kabangamukeli,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Qaphela abangane bakho,","poem":1},{"text":"ungabathembi abafowenu.","poem":2},{"text":"Ngoba wonke umfowenu ungumkhohlisi,","poem":1},{"text":"njalo wonke umngane ungumhlebi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Umngane ukhohlisa umngane,","poem":1},{"text":"njalo kakho okhuluma iqiniso.","poem":2},{"text":"Sebafundisa izindimi zabo ukuqamba amanga,","poem":1},{"text":"bayazidinisa ngokona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lihlala phakathi kwenkohliso,","poem":1},{"text":"ngenkohliso yabo bayala ukungamukela,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":7,"content":["Ngakho uThixo uSomandla uthi:",{"text":"“Khangelani, ngizabacolisa ngibahlole,","poem":1},{"text":"ngoba kuyini okunye engingakwenza","poem":2},{"lineBreak":true},{"text":"ngenxa yesono sabantu bami?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ulimi lwabo lungumtshoko olobuthi,","poem":1},{"text":"lukhuluma inkohliso.","poem":2},{"text":"Lowo lalowo ukhuluma kuhle kubomakhelwane bakhe,","poem":1},{"text":"kodwa enhliziyweni zabo bebathiya ngemijibila.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kakufanele ngibajezisele lokhu na?”","poem":1},{"text":"kubuza uThixo.","poem":2},{"text":"“Kakufanele ngiphindisele","poem":1},{"text":"esizweni esinjengalesi na?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ngizakhala ngililele izintaba","poem":1},{"text":"ngibuye ngililele lamadlelo asenkangala.","poem":2},{"text":"Atshabalele njalo kakho ohambela kuwo,","poem":1},{"text":"lokubhonsa kwezinkomo akuzwakali.","poem":2},{"text":"Izinyoni zasemoyeni sezibalekile,","poem":1},{"text":"lezinyamazana kazisekho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“IJerusalema ngizalenza libe yinqumbi yonxiwa,","poem":1},{"text":"isikhundla samakhanka,","poem":2},{"text":"njalo ngizawadiliza amadolobho akoJuda","poem":1},{"text":"ukuze kungabikhona ohlala kuwo.”","poem":2}]},{"type":"verse","number":12,"content":["Nguphi umuntu ohlakaniphileyo ukuba akuzwisise lokhu? Ngubani ofundiswe nguThixo ongakuchaza? Kungani ilizwe litshabalalisiwe lachithwa njengenkangala ukuze kungadluli muntu kulo?"]},{"type":"verse","number":13,"content":["UThixo wathi, “Kungenxa yokuthi sebelahle umthetho wami engababekela wona; kabangilalelanga, lomthetho wami kabawulandelanga."]},{"type":"verse","number":14,"content":["Esikhundleni salokho, bona balandele ubulukhuni bezinhliziyo zabo; balandele oBhali, njengokufundiswa kwabo ngoyise.”"]},{"type":"verse","number":15,"content":["Ngakho-ke, uThixo uSomandla, uNkulunkulu ka-Israyeli uthi: “Khangelani, abantu laba ngizabadlisa ukudla okubabayo ngibanathise lamanzi alobuthi."]},{"type":"verse","number":16,"content":["Ngizabahlakazela ezizweni bona kanye laboyise abangazange bazazi, njalo ngizabalandela ngenkemba ngize ngibaqede du.”"]},{"type":"verse","number":17,"content":["UThixo uSomandla uthi:",{"text":"“Cabangani khathesi! Bizani abesifazane abalilayo beze,","poem":1},{"text":"libize labo abalobuciko obumangalisayo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kabeze ngokuphangisa,","poem":1},{"text":"bazesililela amehlo ethu aze ehlise inyembezi","poem":2},{"text":"lempophoma zamanzi zigeleze,","poem":1},{"text":"ziphuma enkopheni zethu.”","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ilizwi lokukhala liyezwakala livela eZiyoni:","poem":1},{"text":"“Yeka kunganani ukuchithakala kwethu!","poem":2},{"lineBreak":true},{"text":"Yeka ubukhulu behlazo lethu!","poem":2},{"text":"Kumele sisuke elizweni lethu","poem":1},{"text":"ngoba izindlu zethu zidiliziwe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Khathesi, lina abesifazane, zwanini ilizwi likaThixo,","poem":1},{"text":"vulani indlebe zenu lizwe amazwi omlomo wakhe.","poem":2},{"text":"Fundisani amadodakazi enu ukulila,","poem":1},{"text":"lifundisane amazwi okukhala.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ukufa kukhwele kwangena ngamafastela ethu,","poem":1},{"text":"njalo kungenile lasezinqabeni zethu,","poem":2},{"text":"sekususe abantwana emigwaqweni","poem":1},{"text":"kanye lamajaha ezindaweni zikazulu.","poem":2}]},{"type":"verse","number":22,"content":["Tshono uthi, uThixo uthi,",{"text":"“ ‘izidumbu zabafileyo zizalala","poem":1},{"text":"njengezibi egangeni,","poem":2},{"text":"njengamabele aqunywe ngemva kovunayo,","poem":1},{"text":"okungekho ozawabutha.’ ”","poem":2}]},{"type":"verse","number":23,"content":["UThixo uthi:",{"text":"“Ohlakaniphileyo kangazincomi ngokuhlakanipha kwakhe,","poem":1},{"text":"loba indoda elamandla izincome ngamandla ayo,","poem":2},{"lineBreak":true},{"text":"loba indoda enothileyo izincome ngenotho yayo,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"kodwa lowo ozincomayo,","poem":1},{"text":"kazincome ngokuthi uyaqedisisa njalo uyangazi,","poem":2},{"text":"ukuthi mina nginguThixo, osebenzisa umusa,","poem":1},{"text":"imfanelo lokulunga emhlabeni,","poem":2},{"lineBreak":true},{"text":"ngoba lezizinto ziyangithokozisa,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":25,"content":["UThixo uthi, “Insuku ziyeza, lapho engizabajezisa khona bonke abasoke enyameni kuphela,"]},{"type":"verse","number":26,"content":["iGibhithe, loJuda, lo-Edomi, lo-Amoni loMowabi labo bonke abahlala enkangala ezindaweni ezikhatshana. Ngoba izizwe zonke lezi kazisokanga, njalo lendlu yonke ka-Israyeli kayisokanga enhliziyweni.”"]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JER/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JER/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/8.json","previousChapterAudioLinks":{},"numberOfVerses":26}