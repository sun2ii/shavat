{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":10,"content":[{"type":"heading","content":["UJobe Uqhubeka Ekhuluma"]},{"type":"verse","number":1,"content":[{"text":"“Senginengwa yimpilo yami;","poem":1},{"text":"ngakho sengizasola ngingasathikazi","poem":2},{"lineBreak":true},{"text":"ngithulule ubuhlungu bomphefumulo wami.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngizakuthi kuNkulunkulu: Ungangilahli,","poem":1},{"text":"kodwa ngitshela ukuthi ungethesa cala bani.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kuyakuthabisa na ukungizwisa ubuhlungu,","poem":1},{"text":"ukulahla umsebenzi wezandla zakho,","poem":2},{"lineBreak":true},{"text":"ikanti uyahlekelela ngamacebo ababi?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ulamehlo enyama na?","poem":1},{"text":"Ubona njengokubona kwabantu na?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Insuku zakho ziyafanana lezabantu yini,","poem":1},{"text":"kumbe iminyaka yakho njengeyomuntu yini,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"osungaze uphenye iziphambeko zami","poem":1},{"text":"njalo ulandelele isono sami,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"loba wena ukwazi ukuthi angilacala","poem":1},{"text":"lokuthi kakho ongangikhulula esandleni sakho?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Izandla zakho zangibumba zangenza.","poem":1},{"text":"Pho usuzaphenduka ungibhidlize na?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Khumbula ukuthi wangibumba njengomdaka.","poem":1},{"text":"Pho usuzabuye ungiphendule uthuli na?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kawungichithanga yini njengochago","poem":1},{"text":"njalo wangijiyisa njengolaza,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"wangigqokisa ngesikhumba lenyama,","poem":1},{"text":"wangithungela ndawonye ngamathambo lemisipha?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wangipha ukuphila wangitshengisa umusa,","poem":1},{"text":"ukunanza kwakho kwawelusa umoya wami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kodwa lokhu yikho owakufihla enhliziyweni yakho,","poem":1},{"text":"njalo ngiyazi ukuthi lokhu kwakukhona engqondweni yakho:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nxa ngona, ngabe wawungikhangele","poem":1},{"text":"wawungeke wekela ukona kwami kungajeziswa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Aluba ngilecala, maye mina!","poem":1},{"text":"Laloba ngimsulwa, akukho engingakwenza,","poem":2},{"text":"ngoba ngiyafa ngenhloni","poem":1},{"text":"njalo ngiyagalula ekuhluphekeni kwami.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nxa ngingathi ngivusa ikhanda ungicwathela njengesilwane","poem":1},{"text":"uphinde utshengise amandla akho esabekayo kimi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Uletha ofakazi abatsha abangilahlayo,","poem":1},{"text":"wandise ulaka lwakho kimi;","poem":2},{"lineBreak":true},{"text":"amabutho akho angihlasela amaviyo ngamaviyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Pho kungani wangikhupha esibelethweni na?","poem":1},{"text":"Ngifisa ukuthi ngabe ngafa ngingakabonwa laloba yiliphi ilihlo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Aluba ngavele ngingabi ngophilayo,","poem":1},{"text":"loba ngathwalwa ngisuka esibelethweni ngasiwa ethuneni!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Insuku zami ezilutshwane kaseziphelile nje?","poem":1},{"text":"Akungifulathele ukuze ngizuze umzuzwana wentokozo nje","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ngingakayi lapho okungabuywa khona,","poem":1},{"text":"elizweni lobumnyama lethunzi elikhulu,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"elizweni lobusuku obujule ngempela,","poem":1},{"text":"elethunzi elinzima lengxubevange,","poem":2},{"lineBreak":true},{"text":"lapho lokukhanya kunjengobumnyama.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}