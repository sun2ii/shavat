{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":11,"content":[{"type":"heading","content":["Impendulo KaZofari"]},{"type":"verse","number":1,"content":["UZofari umNahama wasephendula wathi:"]},{"type":"verse","number":2,"content":[{"text":"“Uthi amazwi wonke la angayekelwa ukuphendulwa na?","poem":1},{"text":"Uwawane lolu luyekelwe nje lubheda?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Umbhedo wakho lo ungenza abantu bathule na?","poem":1},{"text":"Uthi ungangakhuzwa muntu wena ukhulumela eceleni?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Uthi kuNkulunkulu, ‘Inkolo yami kayilansolo","poem":1},{"text":"njalo ngimsulwa phambi kwakho.’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Oh, ngize ngifise ukuthi ngabe uNkulunkulu uyakhuluma,","poem":1},{"text":"avule izindebe zakhe ekusola","poem":2}]},{"type":"verse","number":6,"content":[{"text":"akuvulele imfihlo zokuhlakanipha,","poem":1},{"text":"ngoba inhlakanipho yeqiniso ikabili.","poem":2},{"text":"Yazi lokhu:","poem":1},{"text":"UNkulunkulu uvele usezikhohliwe ezinye izono zakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kambe ungayifinyelela yini imfihlakalo kaNkulunkulu?","poem":1},{"text":"Ungaziphenya iziphetho zikaSomandla na?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ziqongile ngaphezu kwamazulu, ungenzani kambe?","poem":1},{"text":"Zizikile kulokujula kolwandle, kuyini ongakwazi pho?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ukulinganiswa kwazo kude kulomhlaba","poem":1},{"text":"njalo kubanzi kulolwandle.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nxa engeza lapha akuphosele entolongweni","poem":1},{"text":"abize inkundla, ngubani ongamphikisa na?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Liqiniso ukuthi uyababona abantu abakhohlisayo;","poem":1},{"text":"njalo nxa ebona okubi, kananzeleli na?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kodwa umuntu oyisithutha ngeke ahlakaniphe","poem":1},{"text":"njengoba ubabhemi weganga engeke azalwa ngumuntu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kodwa nxa ugxilisa inhliziyo yakho kuye","poem":1},{"text":"uphakamisele izandla zakho kuye,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"nxa ulahla isono esisesandleni sakho","poem":1},{"text":"ungavumeli bubi buhlale ethenteni lakho,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"lapho-ke uzabuveza ubuso bakho ungelanhloni;","poem":1},{"text":"uzakuma uqine ungesabi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Uzalukhohlwa ngempela uhlupho lwakho,","poem":1},{"text":"lufike nje engqondweni njengezikhukhula ezadlulayo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Impilo izakhanya kulemini enkulu,","poem":1},{"text":"lobumnyama buzakuba njengasekuseni.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Uzavikeleka, ngoba ithemba likhona;","poem":1},{"text":"uzakhangela ofuna khona uzuze ukuphumula uvikelekile.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Uzazilalela, kungekho okwethusayo,","poem":1},{"text":"njalo abanengi bazabe sebezisondeza kuwe.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kodwa amehlo ababi azafiphala,","poem":1},{"text":"behluleke lokubaleka;","poem":2},{"lineBreak":true},{"text":"ithemba labo libe yikuhotsha umoya wokufa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}