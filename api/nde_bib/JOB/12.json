{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":12,"content":[{"type":"heading","content":["Impendulo KaJobe"]},{"type":"verse","number":1,"content":["Wasephendula uJobe wathi:"]},{"type":"verse","number":2,"content":[{"text":"“Wo, lina yini elizibona kuyini abantu,","poem":1},{"text":"njalo lolwazi luzakufa lani!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kodwa lami ngilayo ingqondo njengani;","poem":1},{"text":"kalingedluli ngalutho.","poem":2},{"lineBreak":true},{"text":"Ngubani ongazaziyo izinto zonke lezi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sengiyinto yokuhlekisa ebanganini bami,","poem":1},{"text":"lanxa ngacela kuNkulunkulu waphendula,","poem":2},{"lineBreak":true},{"text":"inhlekisa sibili, kodwa ngilungile, ngimsulwa!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abantu abahlezi kuhle bayakweyisa ukwehlelwa ngumnyama,","poem":1},{"text":"bathi kuyimfanelo yalabo onyawo zabo sezitshelela.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amathente ezigebenga avikelekile,","poem":1},{"text":"lalabo abamthukuthelisayo uNkulunkulu bavikelekile,","poem":2},{"lineBreak":true},{"text":"uNkulunkulu ulabo ezandleni zakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kodwa ake ubuze izinyamazana, zizakufundisa,","poem":1},{"text":"kumbe izinyoni zemoyeni, zizakutshela;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"kumbe khuluma lomhlaba, uzakufundisa,","poem":1},{"text":"loba uthi inhlanzi zolwandle zikwazise.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yikuphi kwalezizinto okungaziyo na","poem":1},{"text":"ukuthi yisandla sikaThixo esikwenzileyo lokhu?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Esandleni sakhe kulempilo yazo zonke izidalwa","poem":1},{"text":"lokuphefumula kwabantu bonke.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Indlebe kayiwahloli yini wonke amazwi","poem":1},{"text":"njengolimi lunambitha ukudla?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Angithi ukuhlakanipha kufunyanwa ebadaleni na?","poem":1},{"text":"Angithi impilo ende iletha ukuzwisisa na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"NgokukaNkulunkulu ukuhlakanipha lamandla;","poem":1},{"text":"ukweluleka lokuzwisisa kungokwakhe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Lokho akubhidlizayo kungeke kwamiswa njalo;","poem":1},{"text":"lowo amvalelayo ngeke avulelwe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Angaze awavale amanzi, kuba lokoma;","poem":1},{"text":"angawavulela kuba lomonakalo elizweni.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Angawakhe amandla lenhlakanipho;","poem":1},{"text":"okhohliswayo lomkhohlisi ngabakhe bonke.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abeluleki uyabakhupha bahambe beze","poem":1},{"text":"enze abehluleli babe yiziphukuphuku.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Uyanyomula izibopho ezibotshwe ngamakhosi","poem":1},{"text":"azibophe ngelembu ekhalweni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Abaphristi uyabakhupha beze","poem":1},{"text":"awagenqule amadoda abesithi asegxilile.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Uyazithulisa izindebe zabeluleki","poem":1},{"text":"abathenjiweyo asuse ulwazi lwabadala.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Izikhulu uzihleka usulu","poem":1},{"text":"abalamandla abathathele lawomandla.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Uyembula imfihlo ezenzeka emnyameni","poem":1},{"text":"amathunzi azikileyo awalethe ekukhanyeni.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Wenza izizwe zikhule, abesezidiliza;","poem":1},{"text":"uyaziqhelisa izizwe, aphinde azichithe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Abakhokheli basemhlabeni ubemuka ukuhlakanipha kwabo;","poem":1},{"text":"ubenza bantule enkangala.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bayaphumputha emnyameni kungelakukhanya;","poem":1},{"text":"ubenza badiyazele njengezidakwa.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}