{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":13,"content":[{"type":"heading","content":["UJobe Uqhubeka Ekhuluma"]},{"type":"verse","number":1,"content":[{"text":"“Amehlo ami asekubonile konke lokhu,","poem":1},{"text":"indlebe zami zikuzwile zakuqedisisa lokhu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Elikwaziyo lina lami ngiyakwazi;","poem":1},{"text":"kalingcono ngalutho kulami.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kodwa ngiloyisa ukukhuluma loSomandla,","poem":1},{"text":"ngiphikisane loNkulunkulu ngendaba yami.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kodwa lina lingigcona ngamanga;","poem":1},{"text":"lonke lizinyanga ezingelamsebenzi!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Thulani lithi zwi lonke!","poem":1},{"text":"Lokho kungaba yikuhlakanipha kini.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zwanini-ke manje engikutshoyo;","poem":1},{"text":"lalelani ukuncenga kwezindebe zami.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lingakhuluma okubi limele uNkulunkulu na?","poem":1},{"text":"Lingamkhulumela inkohliso na?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Limtshengisa ukuthi liyabandlulula yini?","poem":1},{"text":"Yini elimkhulumelayo uNkulunkulu akutshoyo?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kungalilungela yini nxa engalihlola?","poem":1},{"text":"Kambe lingamkhohlisa njengoba lingakhohlisa abantu na?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngempela angaligcona","poem":1},{"text":"nxa lingabe litshengisa ukubandlulula.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inkazimulo yakhe ingezake ilethuse na?","poem":1},{"text":"Ukwesabeka kwakhe kungezake kulehlele na?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Izitsho zenu ziyizaga zomlotha;","poem":1},{"text":"lezivikelo zenu yizivikelo zebumba kuphela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Thulani ngikhulume mina;","poem":1},{"text":"kungivelele loba kuyini okuvelayo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngizifakelani engozini na","poem":1},{"text":"ngiphathe impilo yami ezandleni zami?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lanxa engangibulala kodwa ngizakwala ngimethemba;","poem":1},{"text":"ngizazivikela izindlela zami phambi kwakhe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngeqiniso lokhu kuzangihlenga,","poem":1},{"text":"ngoba kakho umuntu ongakholwayo ongasondela kuye!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ake lilalele kuhle amazwi ami;","poem":1},{"text":"vulani indlebe zenu lizwe engikutshoyo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Manje-ke njengoba sengiyilungisile indaba yami,","poem":1},{"text":"ngiyabona ukuthi ngizakhululwa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ngubani kambe ongangethesa icala?","poem":1},{"text":"Nxa ekhona, ngizathula ngife.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Akungiphe lezizinto ezimbili nje, Oh Nkulunkulu,","poem":1},{"text":"lapho-ke angiyikukucatshela:","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Sisusele khatshana lami isandla sakho,","poem":1},{"text":"ukhawule ukungethusa ngokwesabeka kwakho.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ubusungibizela ecaleni, ngizaphendula,","poem":1},{"text":"kumbe ungiyekele ngikhulume, lawe uphendule.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Sengenze iziphambeko lezono ezinganani na?","poem":1},{"text":"Ngitshengisa isiphambeko sami lesono sami.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kungani ufihla ubuso bakho","poem":1},{"text":"ungithathe njengesitha sakho?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Uzahluphana lehlamvu eliphetshulwa ngumoya na?","poem":1},{"text":"Uzaxotshana lomule owomileyo na?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ngoba ubhala izinto ezibuhlungu ngami","poem":1},{"text":"ungenze ngivune izono zobutsha bami.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ukhina inyawo zami ngezibopho;","poem":1},{"text":"ulandelela zonke izindlela zami","poem":2},{"lineBreak":true},{"text":"ngokudweba uphawu ezinyathelweni zezinyawo zami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Yikho-ke umuntu ecikizeka njengento ebolileyo,","poem":1},{"text":"njengesigqoko esidliwe yinondo.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}