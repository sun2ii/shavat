{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":14,"content":[{"type":"heading","content":["UJobe Uqhubeka Ekhuluma"]},{"type":"verse","number":1,"content":[{"text":"“Umuntu ozelwe ngumfazi ulensuku ezilutshwane","poem":1},{"text":"njalo ezigcwele inhlupho.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Uyaqhakaza njengeluba aphinde abune;","poem":1},{"text":"njengesithunzi esithi tshazi, akemi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Onjalo ungala ulokhu umkhangele na?","poem":1},{"text":"Ungamisa phambi kwakho umthonisise na?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngubani ongaveza okuhlambulukileyo kokungcolileyo na?","poem":1},{"text":"Kakho!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Insuku zomuntu zimisiwe;","poem":1},{"text":"uzibekile izinyanga zokuphila kwakhe","poem":2},{"lineBreak":true},{"text":"wabeka lemikhawulo angeke ayeqe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngakho-ke myekele ungazihluphi ngaye,","poem":1},{"text":"aze aqede lesosikhathi sakhe njengomuntu oqhatshiweyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kungaba lethemba ngesihlahla;","poem":1},{"text":"singaganyulwa siyahluma njalo,","poem":2},{"lineBreak":true},{"text":"amahlumela aso kawayikwehluleka ukukhula.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Impande zaso zingaguga phansi emhlabathini","poem":1},{"text":"lesiphunzi saso sife emhlabathini,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"kodwa singezwa amanzi siyahluma","poem":1},{"text":"sikhuphe ingatsha njengesihlahla esitsha.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kodwa umuntu uyafa alaliswe phansi;","poem":1},{"text":"uphefumula okokucina angabe esabakhona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Njengamanzi esitsha olwandle","poem":1},{"text":"lanjengomfula ucitsha amanzi wome qha,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ngokunjalo umuntu ulala phansi angabe esavuka;","poem":1},{"text":"kuze kutshabalale amazulu abantu kabayikuvuka","poem":2},{"lineBreak":true},{"text":"kumbe baphatshanyiswe ebuthongweni babo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kube uyangifihla ethuneni","poem":1},{"text":"ungithukuze ulaka lwakho luze ludlule!","poem":2},{"text":"Kube ungibekela isikhathi","poem":1},{"text":"ube usungikhumbula!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Umuntu angafa uphinde aphile na?","poem":1},{"text":"Zonke insuku zokutshikatshika kwami","poem":2},{"lineBreak":true},{"text":"ngizalindela isikhathi sokuyekelwa kwami.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Uzabiza lami ngizasabela;","poem":1},{"text":"uzasifisa lesosidalwa esenziwa yizandla zakho.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngeqiniso lapho uzabala izinyathelo zami","poem":1},{"text":"kodwa kawuyikulandelela izono zami.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Iziphambeko zami zizananyekwa emgodleni;","poem":1},{"text":"uzasigubuzela isono sami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kodwa njengentaba ikhumuzeka ize ibhidlike,","poem":1},{"text":"lanjengedwala ligudluka endaweni yalo,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"njengamanzi awagubhayo amatshe","poem":1},{"text":"lezikhukhula zikhukhula umhlabathi,","poem":2},{"lineBreak":true},{"text":"kanjalo uyalibhidliza ithemba lomuntu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Umehlula kanye angaphindi abekhona, adlule;","poem":1},{"text":"uyabuguqula ubuso bakho umxotshe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nxa amadodana akhe ezuza udumo, kawakwazi;","poem":1},{"text":"nxa izizukulwane zakhe zisehliswa, kazikuboni.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bezwa kuphela ubuhlungu bemizimba yabo","poem":1},{"text":"bazikhalele bona.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}