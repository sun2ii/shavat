{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":15,"content":[{"type":"heading","content":["Impendulo Ka-Elifazi"]},{"type":"verse","number":1,"content":["Wasephendula u-Elifazi umThemani wathi:"]},{"type":"verse","number":2,"content":[{"text":"“Kambe indoda ehlakaniphileyo ingaphendula ngeze nje","poem":1},{"text":"loba igcwalise isisu sayo ngomoya otshisayo wempumalanga na?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ingadaza inkani ngamazwi angatsho lutho,","poem":1},{"text":"ngezinkulumo ezingelasisindo na?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wena uze weyise ukulunga","poem":1},{"text":"njalo uphazame lokukhonza uNkulunkulu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Isono sakho sikhuthaza umlomo wakho;","poem":1},{"text":"usuthethe ulimi lwamaqili.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Umlomo wakho yiwo okulahlayo, hatshi owami;","poem":1},{"text":"izindebe zakho zifakaza ububi bakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nguwe yini umuntu wokuqala ukuzalwa?","poem":1},{"text":"Wabakhona kuqala kulezintaba na?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Uyake ulalele yini enkundleni kaNkulunkulu?","poem":1},{"text":"Nguwe wedwa yini ololwazi?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kuyini okwaziyo wena thina esingakwaziyo?","poem":1},{"text":"Ulemibono bani wena thina esingelayo?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Asebezimpunga lamakhehla bavumelana lathi,","poem":1},{"text":"amadoda amadala kuloyihlo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Induduzo zikaNkulunkulu kazikwanelisi yini,","poem":1},{"text":"amazwi akhulunywa kamnandi kuwe?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kungani uvumela ukufuqwa yinhliziyo na,","poem":1},{"text":"kungani amehlo akho eqwayiza,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"uze ubhodlise ulaka lwakho kuNkulunkulu","poem":1},{"text":"ukhihlize amazwi anjalo ngomlomo wakho?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Umuntu uyini ukuthi abe ngohlanzekileyo na,","poem":1},{"text":"lozelwe ngowesifazane ongaba ngcwele?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nxa uNkulunkulu engazethembi izingilosi zakhe,","poem":1},{"text":"njalo lamazulu engathembekanga kuye,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"pho umuntu ongcolileyo ke, oxhwalileyo,","poem":1},{"text":"onatha ububi njengamanzi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Lalela kimi ngikuchazele;","poem":1},{"text":"wothi ngikutshele esengakubonayo,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"lokho osekwafakazwa yizihlakaniphi,","poem":1},{"text":"bengafihli lutho abaluthatha kubokhokho babo","poem":2}]},{"type":"verse","number":19,"content":[{"text":"(abayibo kuphela abaphiwa ilizwe","poem":1},{"text":"njalo akwaze kwedlula muntu wezizweni phakathi kwabo):","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ngezinsuku zakhe zonke umuntu omubi uhlutshwa yizinhlungu,","poem":1},{"text":"kube yisihluku seminyaka yonke ayibekelweyo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Imisindo eyesabisayo iyagcwala ezindlebeni zakhe;","poem":1},{"text":"nxa kusithi kuyalunga, izikliwi zimhlasele.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ulahlekelwa lithemba lokuwuphepha umnyama;","poem":1},{"text":"umiselwe inkemba.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Uyantula nje abe yikudla kwamanqe;","poem":1},{"text":"uyazi ukuthi usuku lobumnyama selusondele.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Usizi lobuhlungu emoyeni bumlethela uvalo;","poem":1},{"text":"inhlupho ziyamgabhela, njengenkosi isilungele ukuhlasela,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ngoba efumbathele uNkulunkulu inqindi,","poem":1},{"text":"ezimisela ukulwa loSomandla,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"aqholoze amhlasele","poem":1},{"text":"ngesihlangu esiqinileyo, esilohlonzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Lanxa ezimuke ubuso bungaka,","poem":1},{"text":"umkhaba ulenga ngedanga,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"uzahlala emadolobheni angamanxiwa","poem":1},{"text":"lezindlini ezingahlali muntu,","poem":2},{"lineBreak":true},{"text":"izindlu eziwohlokayo zibe yinqumbi.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kasayikunotha futhi lenotho yakhe kayiyikuma,","poem":1},{"text":"lezifuyo zakhe kazisayikugcwala ilizwe lonke.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kayikuphepha emnyameni;","poem":1},{"text":"ilangabi lizabunisa amahlumela akhe","poem":2},{"lineBreak":true},{"text":"lomoya wokuphefumula komlomo kaNkulunkulu uzamthwalela kude.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Makangazikhohlisi ngokuthemba okuyize,","poem":1},{"text":"ngoba akazukuzuza lutho ngakho.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Singakapheli isikhathi sakhe uzajeziswa,","poem":1},{"text":"lezingatsha zakhe kaziyikuhluma.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Uzaba njengevini eliphundlwe izithelo zalo zingakavuthwa,","poem":1},{"text":"njengesihlahla se-oliva sikhithiza impoko zaso.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ngoba ixuku labangamesabiyo uNkulunkulu kalizukuba lezithelo,","poem":1},{"text":"lomlilo uzawahangula amathente alabo abathanda isivalamlomo.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Bazithwala uhlupho babelethe ububi;","poem":1},{"text":"isibeletho sabo sibumba inkohliso.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}