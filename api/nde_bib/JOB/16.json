{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":16,"content":[{"type":"heading","content":["UJobe Uyaphendula"]},{"type":"verse","number":1,"content":["UJobe wasephendula wathi:"]},{"type":"verse","number":2,"content":[{"text":"“Sengezwa izinto ezinengi ezifana lalezi;","poem":1},{"text":"lingabaduduzi ababi lina lonke!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Zizaphela nini inkulumo zokubhuda kwenu lokhu?","poem":1},{"text":"Kuyini okulihluphayo laphikelela nje lidaza inkani?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lami bengingakhuluma njengani","poem":1},{"text":"aluba yini elisesikhundleni sami;","poem":2},{"text":"ngabe ngikhupha inkulumo ezimnandi ngilisola","poem":1},{"text":"ngize nginikine ikhanda lami.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kodwa umlomo wami ngabe uyaliqinisa;","poem":1},{"text":"induduzo yezindebe zami idedise inhlungu zenu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kodwa nxa ngikhuluma, ubuhlungu obukimi kabudedi;","poem":1},{"text":"loba ngingaze ngithule, kabupheli.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngeqiniso, Nkulunkulu, usungiqede amandla;","poem":1},{"text":"usuyitshabalalisile yonke imuli yami.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Usungibophile sekuyibo ubufakazi balokho;","poem":1},{"text":"lokucikizeka kwami kuyakhula kungilahla.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"UNkulunkulu uyanginxwanela angidlikize ngolaka lwakhe,","poem":1},{"text":"angigedlele amazinyo;","poem":2},{"lineBreak":true},{"text":"isitha sami singinyonkoloze ngamehlo ahlabayo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abantu bavula imilomo yabo bengihoza;","poem":1},{"text":"bangimakala esihlathini bengihlambaza","poem":2},{"lineBreak":true},{"text":"babambane bangihlanganyele.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"UNkulunkulu usenginikele ebantwini ababi","poem":1},{"text":"wangiphosela ezandleni zezigangi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Konke kwakukuhle kimi, kodwa wangibhidliza;","poem":1},{"text":"wangixhakalaza ngentamo wangichoboza.","poem":2},{"text":"Usengenze ngaba yinto yakhe yokunenjwa;","poem":1}]},{"type":"verse","number":13,"content":[{"text":"abacibi bemtshoko bakhe bangihanqile.","poem":2},{"text":"Ungiciba izinso zami engelazwelo","poem":1},{"text":"achithele inyongo yami phansi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ungisukela njalonjalo;","poem":1},{"text":"angidumele njengebutho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Sengithungele isembatho sesaka emzimbeni wami","poem":1},{"text":"ngathukuza ibunzi lami othulini.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ubuso bami sebubomvu ngokukhala,","poem":1},{"text":"amathunzi anzima ahonqolozela amehlo ami;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"kodwa izandla zami kaziluqhelanga udlakela,","poem":1},{"text":"lomkhuleko wami uhlanzekile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Awu mhlaba, ungaligqibeli igazi lami;","poem":1},{"text":"sengathi lokukhala kwami kungaze kwacitshwa lanini!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Lakhathesi ufakazi wami usezulwini;","poem":1},{"text":"umeli wami uphezulu khonale.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Umeli wami ngumngane wami","poem":1},{"text":"nxa amehlo ami empompoza inyembezi kuNkulunkulu;","poem":2}]},{"type":"verse","number":21,"content":[{"text":"uyamncengela umuntu kuNkulunkulu","poem":1},{"text":"njengomuntu encengela umngane wakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kusasele iminyakana engemingaki","poem":1},{"text":"andubana ngiye lapho kungabuywa khona.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}