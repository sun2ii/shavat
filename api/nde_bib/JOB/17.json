{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"heading","content":["UJobe Uqhubeka Ekhuluma"]},{"type":"verse","number":1,"content":[{"text":"“Umoya wami udabukile,","poem":1},{"text":"insuku zami ziqunyiwe,","poem":2},{"lineBreak":true},{"text":"ithuna lingimelele.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Impela abaklolodayo bangihanqile;","poem":1},{"text":"amehlo ami asehlezi elinde ulaka lwabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngipha, Oh Nkulunkulu, lesosibambiso osifunayo.","poem":1},{"text":"Kambe ngubani omunye ongangenzela lesosibambiso na?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Usuzivalile ingqondo zabo kabasazwisisi;","poem":1},{"text":"ngakho kawuzukubayekela bagiye.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nxa umuntu angaphika umngane wakhe ukuze ahlawulwe,","poem":1},{"text":"amehlo abantwabakhe azafiphala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"UNkulunkulu usengenze ngaba yisiga ebantwini bonke,","poem":1},{"text":"umuntu okhafulelwa ngabanye emehlweni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Amehlo ami asethundubele ngosizi;","poem":1},{"text":"umdumbu wami wonke usuyisithunzi nje.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Abantu abaqotho kuyabanenga lokhu;","poem":1},{"text":"abangelacala bayacaphuka ngabangakholwayo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kungenani, abalungileyo bazabambelela ezindleleni zabo,","poem":1},{"text":"kuthi labo abalezandla ezihlanzekileyo baqine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kodwa khathesi lina lonke ake lizame futhi!","poem":1},{"text":"Kangiboni loyedwa ohlakaniphileyo kini.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sezidlule insuku zami, amacebo ami asedilikile,","poem":1},{"text":"kunjalo lezifiso zenhliziyo yami.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lababantu bathatha ubusuku njengemini;","poem":1},{"text":"bathi bebona ubumnyama bathi, ‘Ukukhanya sekusondele.’","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nxa ikhaya engilithembileyo lilingcwaba kuphela,","poem":1},{"text":"nxa ngisendlala umbheda wami emnyameni,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"nxa ngisithi ekuboleni, ‘Baba,’","poem":1},{"text":"ngithi empethwini, ‘Mama’ kumbe ‘Dadewethu,’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"pho lingaphi ithemba lami na?","poem":1},{"text":"Ngubani ongabona ithemba ngami?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kuzakwehlela emasangweni okufa na?","poem":1},{"text":"Sizakwehlela ndawonye othulini na?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}