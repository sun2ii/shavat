{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"heading","content":["Impendulo KaBhilidadi"]},{"type":"verse","number":1,"content":["Kwathi lapho uBhilidadi umShuhi waphendula wathi:"]},{"type":"verse","number":2,"content":[{"text":"“Koze kube nini ulokhu uphethe emlonyeni?","poem":1},{"text":"Nakana andubana sikhulume.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kungani usithatha njengezinkomo","poem":1},{"text":"kube ingathi siyizithutha kuwe na?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wena ozidabudabulayo ube yiziqa ngokuthukuthela kwakho,","poem":1},{"text":"uthi sesingawudela umhlaba ngenxa yakho?","poem":2},{"lineBreak":true},{"text":"Loba uthi amadwala agudlulwe ezindaweni zawo na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Isibane somubi siyacima;","poem":1},{"text":"ilangabi lomlilo wakhe liyaphela ukubhebha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ukukhanya ethenteni lakhe kuyafiphala;","poem":1},{"text":"isibane esiseceleni kwakhe siyacima.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Izisinde zakhe zamandla ziyadeda;","poem":1},{"text":"lamacebo akhe yiwo amlahla phansi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Inyawo zakhe zimbeka emambuleni","poem":1},{"text":"acine esemthandele.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Umjibila umhwiphula ngesithende;","poem":1},{"text":"isihitshela simuthi nki.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isihitshela usifihlelwe phansi;","poem":1},{"text":"umjibila uthukuziwe endleleni yakhe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Uyethuka ngokwesaba inxa zonke","poem":1},{"text":"kumlandelele langaphi aya khona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Umonakalo umlambele;","poem":1},{"text":"incithakalo imlindele nxa esiwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kudla ingxenye yesikhumba sakhe;","poem":1},{"text":"izibulo lokufa lidla izitho zakhe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Uyasuswa ekuvikelekeni kwethente lakhe","poem":1},{"text":"aqhutshwe asiwe enkosini yokwesaba.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Umlilo uhlala ethenteni lakhe;","poem":1},{"text":"isolufa evuthayo ichithachithwe emzini wakhe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Impande zakhe ziyabuna ngaphansi","poem":1},{"text":"lamagatsha akhe abune ngaphezulu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ukukhunjulwa kwakhe kuyaphela emhlabeni;","poem":1},{"text":"kalabizo elizweni.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Uyasuswa ekukhanyeni aye ebumnyameni","poem":1},{"text":"njalo axotshwe emhlabeni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kalabantwana loba isizukulwane ebantwini bakibo,","poem":1},{"text":"kakho loyedwa owakhe lapho ake ahlala khona.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Abantu bentshonalanga bayanengwa yisiphetho sakhe;","poem":1},{"text":"abantu bempumalanga bayatshaqeka.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ngempela linjalo ikhaya lomuntu omubi;","poem":1},{"text":"yiyo indawo yalowo ongamaziyo uNkulunkulu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}