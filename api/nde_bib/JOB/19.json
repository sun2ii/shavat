{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":19,"content":[{"type":"heading","content":["Impendulo KaJobe"]},{"type":"verse","number":1,"content":["Wasephendula uJobe wathi:"]},{"type":"verse","number":2,"content":[{"text":"“Koze kube nini lilokhu lingichukuluza,","poem":1},{"text":"lingicobodisa ngamazwi na?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Selingithethise amahlandla alitshumi manje;","poem":1},{"text":"lingihlasela lingelanhloni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nxa kuliqiniso ukuthi ngiphambukile,","poem":1},{"text":"isiphambeko sami ngumlandu wami ngedwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nxa isibili liziphakamisa ngaphezulu kwami,","poem":1},{"text":"lingincindezele ngokuyangeka kwami,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"yazini ukuthi uNkulunkulu ungonile","poem":1},{"text":"wangithandela ngomambule wakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Loba ngingaze ngikhale ngithi, ‘Ngiyahlukuluzwa bo!’","poem":1},{"text":"angitholi mpendulo;","poem":2},{"text":"loba ngicela uncedo,","poem":1},{"text":"kangahlulelwa ngokulunga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Uyivalile indlela yami akudluleki;","poem":1},{"text":"izindlela zami uzembese ngomnyama.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Usengiphucile konke ukuhlonitshwa","poem":1},{"text":"wangethula umqhele ekhanda lami.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ungidabula inxa zonke ngize ngiphele du;","poem":1},{"text":"usiphuna ithemba lami njengesihlahla.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ulaka lwakhe luyavutha kimi;","poem":1},{"text":"ungibalela phakathi kwezitha zakhe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Amabutho akhe eza ngamandla;","poem":1},{"text":"angakhela isihonqo sokungivimbezela","poem":2},{"lineBreak":true},{"text":"amise egqagqele ithente lami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Usenze abafowethu bangihlamuka;","poem":1},{"text":"abangane bami sebemelana lami.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Izihlobo zami sezihambile;","poem":1},{"text":"abangane bami sebekhohliwe ngami.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Izethekeli zami lezincekukazi zami zithi ngingowemzini;","poem":1},{"text":"zingikhangela njengowezizweni.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngithi nxa ngibiza isisebenzi sami singasabeli,","poem":1},{"text":"lokuba ngisincenga ngomlomo wami.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ukuphefumula kwami kuyamnukela umkami;","poem":1},{"text":"ngiyenyanyeka kubafowethu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Labafanyana bayangiklolodela;","poem":1},{"text":"ngithi nxa ngiqhamuka bangihoze.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bonke abangane bami abasekhwapheni bayanengeka ngami;","poem":1},{"text":"labo engibathandayo sebengifulathele.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Angiselalutho ngaphandle kwesikhumba lamathambo kuphela;","poem":1},{"text":"ngiphephe manayinayi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ngizwelani usizi, bangane bami, wobani losizi,","poem":1},{"text":"ngoba isandla sikaNkulunkulu singitshayile.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Lingilandelelani njengoNkulunkulu na?","poem":1},{"text":"Lizakufa lasutha ngenyama yami na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Oh, uthi ngabe amazwi ami ayalotshwa,","poem":1},{"text":"ngabe abhaliwe emqulwini,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ngabe athwetshulwe ngensimbi phezu komnuso,","poem":1},{"text":"loba agujwe edwaleni lanininini!","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ngiyazi ukuthi uMhlengi wami uyaphila,","poem":1},{"text":"lokuthi ekupheleni uzakuma emhlabeni.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kuzakuthi nxa isikhumba sami sesibhujisiwe,","poem":1},{"text":"kodwa ngikuyo inyama yami ngizambona uNkulunkulu;","poem":2}]},{"type":"verse","number":27,"content":[{"text":"mina ngokwami ngizambona ngawami amehlo,","poem":1},{"text":"mina hatshi omunye.","poem":2},{"lineBreak":true},{"text":"Inhliziyo yami iyagubhazela ngokulangatha!","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Lingaze lithi, ‘Sizamzingela qho","poem":1},{"text":"ngoba nguye ozilethele ukuhlupheka,’","poem":2}]},{"type":"verse","number":29,"content":[{"text":"yini okumele liyesabe inkemba;","poem":1},{"text":"ngoba intukuthelo izaletha isijeziso ngenkemba,","poem":2},{"lineBreak":true},{"text":"lapho-ke lizakwazi ukuthi kulokwahlulela.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}