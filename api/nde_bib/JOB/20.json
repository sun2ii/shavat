{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":20,"content":[{"type":"heading","content":["Impendulo KaZofari"]},{"type":"verse","number":1,"content":["Wasephendula uZofari umNahama wathi:"]},{"type":"verse","number":2,"content":[{"text":"“Imicabango yami ekhathazekileyo ingifuqa ukuthi ngiphendule","poem":1},{"text":"ngoba sengikhubekile kakhulu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngizwa kulokukhuzwa okungilulazisayo","poem":1},{"text":"njalo ukuzwisisa kwami kungifuqela ukuthi ngiphendule.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ngempela uyakwazi ukuthi kwakuvele kunjani lendulo,","poem":1},{"text":"kusukela ukubekwa komuntu emhlabeni,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ukuthi injabulo yomubi imfitshane,","poem":1},{"text":"intokozo yongakholwayo ngeyomzuzwana nje.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Loba ukuzigqaja kwakhe kufika emazulwini","poem":1},{"text":"lekhanda lakhe lithinta emayezini,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"uzabhubha okwaphakade, njengobulongwe bakhe;","poem":1},{"text":"labo abake bambona bazakuthi, ‘Ungaphi kanti?’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Njengephupho uyanyamalala angabe esabonwa njalo,","poem":1},{"text":"axotshwe njengombono webusuku.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ilihlo elake lambona kalisayikumbona njalo;","poem":1},{"text":"indawo yakhe ingeke ibe isambona.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Abantwabakhe bazazincengela ebayangeni","poem":1},{"text":"ngezandla zakhe abuyisele inotho yakhe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amadlabuzane obutsha alawo emathanjeni akhe","poem":1},{"text":"azalala kanye laye othulini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Loba ububi bumnandi emlonyeni wakhe,","poem":1},{"text":"ebufihla ngaphansi kolimi lwakhe,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"loba esehluleka ukutshiyana labo","poem":1},{"text":"abugcine emlonyeni wakhe,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"kodwa ukudla kwakhe kuzahloba esiswini sakhe;","poem":1},{"text":"kuzaphenduka kube yibuhlungu bezinyoka ngaphakathi kwakhe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Uzayihlanza yonke inotho ayiginyayo;","poem":1},{"text":"uNkulunkulu uzakwenza isisu sakhe sikuhlanze konke.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Uzamunya ubuhlungu bezinyoka;","poem":1},{"text":"amazinyo ebululu azambulala.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Akayikuyikholisa imifula,","poem":1},{"text":"leyomifula egeleza uluju lolaza.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Lokho akuginqeleyo kumele akubuyise engakudlanga;","poem":1},{"text":"akayikuyikholisa inzuzo yokuthengiselana kwakhe.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ngoba ubebancindezela abayanga basala bengelalutho;","poem":1},{"text":"wathumba izindlu angazakhanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ngempela akayikudeda kulobubuhwaba bakhe;","poem":1},{"text":"ngeke azisindise ngenotho yakhe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Akusela lutho angabe esaludla;","poem":1},{"text":"ukuphumelela kwakhe kakuyikuma.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Phakathi kwenotho yakhe uzahlaselwa zinhlupho;","poem":1},{"text":"ubuhlungu buzamehlela ngamandla.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nxa esesigcwalisile isisu sakhe,","poem":1},{"text":"uNkulunkulu uzabhodlisela ulaka lwakhe oluvuthayo kuye","poem":2},{"lineBreak":true},{"text":"akhwele ehle ngezidutshulo phezu kwakhe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Lanxa angaze abalekele isikhali sensimbi","poem":1},{"text":"umtshoko wethusi uzamciba.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Uyawuhwatsha emhlane wakhe,","poem":1},{"text":"umcijo wawo ocazimulayo awuhwatshe esibindini.","poem":2},{"text":"Uzangenwa yikwesaba okukhulu;","poem":1}]},{"type":"verse","number":26,"content":[{"text":"umnyama omkhulu uyilindele inotho yakhe.","poem":2},{"text":"Umlilo ongungumayo uzamqeda","poem":1},{"text":"utshise lokho okuseleyo ethenteni lakhe.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Amazulu azabembula ububi bakhe;","poem":1},{"text":"umhlaba uzamvukela.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Isikhukhula sizayithwala indlu yakhe,","poem":1},{"text":"kungamanzi azimpophoma mhla wosuku lolaka lukaNkulunkulu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Sinjalo isiphetho uNkulunkulu asimisele ababi,","poem":1},{"text":"ilifa abalikhethelwe nguNkulunkulu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}