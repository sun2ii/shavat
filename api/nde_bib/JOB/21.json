{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":21,"content":[{"type":"heading","content":["UJobe Uyaphendula"]},{"type":"verse","number":1,"content":["UJobe wasephendula wathi:"]},{"type":"verse","number":2,"content":[{"text":"“Lalelani kuhle amazwi ami;","poem":1},{"text":"lokhu akube yinduduzo elingipha yona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ake lingibekezelele nxa ngisakhuluma,","poem":1},{"text":"ngithi nxa sengikhulumile liklolode.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ukusola kwami kuqonde umuntu yini?","poem":1},{"text":"Ngingayekelelani ukucunuka pho?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngikhangelani, lizamangala;","poem":1},{"text":"vulani imilomo yenu ngezandla.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nxa ngikhumbula ngalokhu ngitshaywa luvalo;","poem":1},{"text":"ngizwa umzimba wami uqhaqhazela.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kungani ababi bephila impilo ende,","poem":1},{"text":"baluphale nje amandla abo esanda?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Babona abantwababo bezinza benamile,","poem":1},{"text":"inzalo yabo layo beyikhangele.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Imizi yabo ihlezi kayilakwesaba;","poem":1},{"text":"induku kaNkulunkulu kayikho phezu kwabo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inkunzi zabo zikhuthele ziyazala;","poem":1},{"text":"amankomokazi abo azala kuhle kawaphunzi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abantwababo bayazihambela njengomhlambi;","poem":1},{"text":"izingane zabo ziyazigidela zichelesile.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bayahlabela betshaya izigubhu lamachacho;","poem":1},{"text":"bayazithokozisa ngomsindo wemiqangala.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yonke iminyaka yabo ngeyokuphumelela","poem":1},{"text":"baze bayongena egodini belokuthula.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kodwa bathi kuNkulunkulu, ‘Tshiyana lathi!","poem":1},{"text":"Kasifisi ukuzazi izindlela zakho.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ungubani yena uSomandla ofuna ukuthi simkhonze na?","poem":1},{"text":"Sizazuzani nxa sikhuleka kuye na?’","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kodwa ukuphumelela kwabo kakukho ezandleni zabo,","poem":1},{"text":"ngakho kangisondeli ezelulekweni zababi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kodwa kukangaki na isibane sababi sicinywa?","poem":1},{"text":"Kukangaki besehlelwa ngamabhadi na,","poem":2},{"lineBreak":true},{"text":"abawabelwa nguNkulunkulu ezondile?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kukangaki besiba njengomule emoyeni na,","poem":1},{"text":"njengamakhoba ephetshulwa yisivunguzane?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kuthiwa, ‘UNkulunkulu ulomba isijeziso somuntu","poem":1},{"text":"asibekele amadodana akhe.’","poem":2},{"text":"Kajezise yena umuntu ngokwakhe","poem":1},{"text":"ukuze akwazi!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Amehlo akhe kawakubone","poem":1},{"text":"ukuchithwa kwakhe;","poem":2},{"lineBreak":true},{"text":"kalunathe ulaka lukaSomandla.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ngoba uvele uzihlupha ngani ngemuli avele ezayitshiya","poem":1},{"text":"nxa izinyanga zakhe azabelweyo seziphelile na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kambe ukhona ongafundisa uNkulunkulu ulwazi,","poem":1},{"text":"njengoba yena esahlulela labaphezulu na?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Umuntu uyafa ephilile kuhle,","poem":1},{"text":"kukuhle konke ekhululekile,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"umzimba wakhe uzimukile,","poem":1},{"text":"amathambo akhe egcwele umnkantsho.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Omunye ufa elobuhlungu emphefumulweni wakhe,","poem":1},{"text":"evele engakaze akholise lutho oluhle.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bobabili balaliswe ndawonye eceleni komunye othulini,","poem":1},{"text":"impethu zinyakaze phezu kwabo bobabili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ngiyazi kamhlophe ukuthi licabangani,","poem":1},{"text":"amacebo elidinga ukungilimaza ngawo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Lithi, ‘Ingaphi-ke manje indlu yesikhulu,","poem":1},{"text":"amathente okwakuhlala kuwo abantu ababi?’","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kalikaze libuze labo abahambayo na?","poem":1},{"text":"Kalize lananzelela izinto abazilandisayo,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ukuthi umuntu omubi uyaphepha ngosuku lokubhujiswa na,","poem":1},{"text":"ukuthi uyakhululwa ngosuku lwesiphithiphithi?","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kambe ngubani omtshela ngobubi bakhe ebusweni bakhe na?","poem":1},{"text":"Ngubani ophindiselayo ngalokho akwenzileyo na?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Uthwalelwa engcwabeni,","poem":1},{"text":"lilindwe ingcwaba lakhe ngemfanelo.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Inhlabathi esigodini leso imnandi kuye;","poem":1},{"text":"bonke abantu bayamlandela,","poem":2},{"lineBreak":true},{"text":"banengi kakhulu njalo abahamba kuqala kulaye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Pho-ke lingangiduduza njani likhuluma ize nje?","poem":1},{"text":"Akusalanga lutho elilutshoyo ngaphandle kwenkohliso.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}