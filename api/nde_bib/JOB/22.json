{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":22,"content":[{"type":"heading","content":["Impendulo Ka-Elifazi"]},{"type":"verse","number":1,"content":["U-Elifazi umThemani wasephendula wathi:"]},{"type":"verse","number":2,"content":[{"text":"“Umuntu angasiza uNkulunkulu na?","poem":1},{"text":"Lesihlakaniphi uqobo kambe singamsiza na?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bekungamupha ntokozo bani uSomandla ukulunga kwakho na?","poem":1},{"text":"Ubengazuzani ngabe kuthiwa kawulasici na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yikumesaba kwakho yini akukhuzela khona","poem":1},{"text":"lakwethesela khona amacala na?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kabubukhulu ububi bakho na?","poem":1},{"text":"Lezono zakho angithi kazipheli na?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wawubiza isibambiso kubafowenu kungelasizatho;","poem":1},{"text":"uhlubula abantu izigqoko zabo basale beze.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abakhatheleyo wawubancitsha amanzi,","poem":1},{"text":"abalambileyo ungabaphi ukudla,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"lanxa wena wawuyindoda elamandla, ulepulazi,","poem":1},{"text":"indoda ehlonitshwayo, uphila kulo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abafelokazi wabaxotsha ungabaphanga lutho","poem":1},{"text":"izintandane waziqeda amandla.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kungenxa yalokho usuhanqwe yimijibila,","poem":1},{"text":"usuhlukuluzwa luhlupho masinyane,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"yikho kumnyama kangaka ungasaboni,","poem":1},{"text":"njalo yikho ususibekelwa zimpophoma zamanzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"UNkulunkulu kakho esiqongweni samazulu na?","poem":1},{"text":"Ake ubone phela ukuthi ziphakeme njani izinkanyezi ezisesiqongweni!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kodwa wena uthi, ‘UNkulunkulu wazini?","poem":1},{"text":"Angahlulela phakathi komnyama onje?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Usithwe ngamayezi amakhulu, ngakho kasiboni","poem":1},{"text":"nxa ehambahamba ezulwini eliphezulu.’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wena-ke uzakwalela endleleni endala na","poem":1},{"text":"eseyahanjwa ngababi?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bedluliswa singakafiki isikhathi sabo,","poem":1},{"text":"izisekelo zabo zakhukhulwa nguzamcolo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bathi kuNkulunkulu, ‘Tshiyana lathi!","poem":1},{"text":"USomandla angasenzani na?’","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ikanti kunguye owagcwalisa izindlu zabo ngezinto ezinhle,","poem":1},{"text":"ngakho kangingeni ezelulekweni zababi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Abalungileyo bayakubona lokho bathokoze;","poem":1},{"text":"abangelacala bayabahleka bathi,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"‘Ngempela izitha zethu zichithiwe,","poem":1},{"text":"lokuseleyo kwenotho yazo sekubhuqwe ngumlilo.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Zehlise kuNkulunkulu ukuze uwelelane laye;","poem":1},{"text":"ngaleyondlela ukuphumelela kuzakuza kuwe.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yamukela iziqondiso eziphuma emlonyeni wakhe,","poem":1},{"text":"amazwi akhe uwabeke enhliziyweni yakho.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nxa ubuyela kuSomandla, uzavuselelwa;","poem":1},{"text":"nxa ususa ububi bube kude lethente lakho","poem":2}]},{"type":"verse","number":24,"content":[{"text":"lomthuso wakho uwulahlele othulini,","poem":1},{"text":"igolide lakho lase-Ofiri ulilahlele emadwaleni ezifuleni,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"lapho-ke uSomandla uzakuba ligolide lakho,","poem":1},{"text":"lesiliva esikhethekileyo kuwe.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ngempela uzazuza ukuthokoza kuSomandla","poem":1},{"text":"uphakamisele ubuso bakho kuNkulunkulu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Uzakhuleka kuye, yena akuzwe,","poem":1},{"text":"njalo uzagcwalisa izifungo zakho.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Lokho okumisileyo kuzakwenziwa,","poem":1},{"text":"lokukhanya kuzazikhanyisa izindlela zakho.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nxa abantu besehliswa ubususithi, ‘Baphakamiseni!’","poem":1},{"text":"lapho-ke uzabasiza abahlulukelweyo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Uzabasiza lalabo abonayo,","poem":1},{"text":"abazakhululwa ngenxa yokubamsulwa kwakho.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}