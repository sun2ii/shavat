{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"heading","content":["UJobe Uyaphendula"]},{"type":"verse","number":1,"content":["Waphendula uJobe wathi:"]},{"type":"verse","number":2,"content":[{"text":"“Lalamuhla ukusola kwami kulokhu kubuhlungu kabi,","poem":1},{"text":"isandla sakhe siyasinda loba ngibubula kangaka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngabe ngiyakwazi lapho engingamfumana khona;","poem":1},{"text":"aluba nje bengingaya emzini wakhe!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bengizayibeka kuhle indaba yami phambi kwakhe","poem":1},{"text":"ngigcwalise umlomo wami ngamazwi empikiswano.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bengizakuzwa ukuthi yena uphendula athini,","poem":1},{"text":"ngikuhlolisise lokho akutshoyo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kambe angangiphikisa ngamandla na?","poem":1},{"text":"Hatshi, angazake angethese cala.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lapho umuntu oqotho ubengendlala indaba yakhe phambi kwakhe,","poem":1},{"text":"njalo bengizakhululwa lanini kumahluleli wami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kodwa nxa ngisiya empumalanga, yena kakho khona;","poem":1},{"text":"nxa ngisiya entshonalanga, kangimfumani khona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nxa esemsebenzini enyakatho,","poem":1},{"text":"kangimboni;","poem":2},{"text":"angaphendukela eningizimu,","poem":1},{"text":"kangiboni lokuthi tshazi kwakhe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kodwa uyayazi indlela engihamba ngayo;","poem":1},{"text":"nxa esengilingile, ngizaphuma senginjengegolide.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Inyawo zami bezilokhu zilandelana lezinyathelo zakhe;","poem":1},{"text":"ngalela endleleni yakhe angaze ngaphambuka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Angigudlukanga emilayweni yezindebe zakhe;","poem":1},{"text":"ngiwenze igugu amazwi omlomo wakhe","poem":2},{"lineBreak":true},{"text":"ukwedlula isinkwa sami sansukuzonke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kodwa uzimele yedwa, ngubani ongaphikisana laye na?","poem":1},{"text":"Uyenza loba yini ayifunayo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Uyagcwalisa isimiso sakhe ngami,","poem":1},{"text":"njalo manengi amacebo anjalo awagcinileyo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yikho-nje ngithuthumela ukuma phambi kwakhe;","poem":1},{"text":"ngithi ngingakukhumbula konke lokhu ngimesabe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"UNkulunkulu usenze inhliziyo yami yaphela amandla;","poem":1},{"text":"uSomandla usengethusile.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kodwa kawuyikungithulisa umnyama lo,","poem":1},{"text":"umnyama lo onzima ovala ubuso bami.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}