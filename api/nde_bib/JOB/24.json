{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":24,"content":[{"type":"heading","content":["UJobe Uqhubeka Ekhuluma"]},{"type":"verse","number":1,"content":[{"text":"“Kungani uSomandla engabeki izikhathi zokwahlulela na?","poem":1},{"text":"Kungani labo abamaziyo belindela ize bengazazi lezinsuku na?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abantu bayayiguqula imingcele ngokususa izikhonkwane;","poem":1},{"text":"bayayelusa imihlambi entshontshiweyo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bayathatha bahambe lobabhemi wentandane,","poem":1},{"text":"bathathe inkabi yomfelokazi ibe yisibambiso.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abaswelayo bayabagudlula endleleni","poem":1},{"text":"bancindezele abayanga belizweni baze bayocatsha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Njengabobabhemi beganga enkangala,","poem":1},{"text":"abayanga babhudula ukudla;","poem":2},{"lineBreak":true},{"text":"egwaduleni kulapho okuzuzwa khona ukudla kwabantwababo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Babutha ukudla kwenkomo emasimini","poem":1},{"text":"badobhe okuseleyo ezivinini zababi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngoba bengelazigqoko balala beze ubusuku bonke;","poem":1},{"text":"kabalalutho lokuzembesa emqandweni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bagxonxwa lizulu lezintabeni","poem":1},{"text":"bakhusele emadwaleni beswele indawo yokuphephela.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Umntwana oyintandane uhluthunwa ebeleni;","poem":1},{"text":"usane lomyanga luyathunjelwa isikwelede.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngoba bengelazigqoko bahamba nqunu;","poem":1},{"text":"bathwala izikhwebu zamabele kodwa belambile.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bahluza ama-oliva emigelweni;","poem":1},{"text":"bagidagida esikhamelweni sewayini kodwa bomile.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ukububula kwabafayo kuzwakala kuphuma edolobheni,","poem":1},{"text":"lemiphefumulo yabalimeleyo ikhala icela uncedo.","poem":2},{"lineBreak":true},{"text":"Kodwa uNkulunkulu kabeki muntu icala ngenxa yokona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bakhona labo abahlamukela ukukhanya,","poem":1},{"text":"abangazaziyo izindlela zalokho kukhanya","poem":2},{"lineBreak":true},{"text":"loba ukuhlala kuzo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nxa ukukhanya kwemini sekuhambile","poem":1},{"text":"isigebenga siyaphuma sibulale abampofu labaswelayo;","poem":2},{"lineBreak":true},{"text":"ebusuku siyanyonyoba njengesela.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ilihlo lesiphingi lilindela ukuhlwa;","poem":1},{"text":"sikhumbula sithi, ‘Akulamuntu ozangibona,’","poem":2},{"lineBreak":true},{"text":"sihlala sibusithile ubuso baso.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ebumnyameni abantu bayagqekeza izindlu,","poem":1},{"text":"kodwa emini bayazivalela endlini;","poem":2},{"lineBreak":true},{"text":"kabakufuni ukukhanya.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bonke labo ubumnyama obukhulu buyikusa kubo;","poem":1},{"text":"bathandana lezinto ezesabekayo ezobumnyama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ikanti baligwebu phezu kwamanzi;","poem":1},{"text":"esabo isabelo selizwe siqalekisiwe,","poem":2},{"lineBreak":true},{"text":"ukuze kungayi muntu ezivinini.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Njengalokhu ukutshisa lokoma kuhangula ungqwaqwane oncibilikayo,","poem":1},{"text":"kanjalo ingcwaba liyabahlwitha abenze isono.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Isibeletho siyabakhohlwa,","poem":1},{"text":"impethu zizitike phezu kwabo;","poem":2},{"text":"abantu ababi kabasakhunjulwa","poem":1},{"text":"kodwa bayafohlozwa njengesihlahla.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bancindezela owesifazane oyinyumba longelamntwana,","poem":1},{"text":"kumfelokazi kabalamusa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kodwa uNkulunkulu uyazihudulela kude izikhulu ngamandla akhe.","poem":1},{"text":"Noma bangaze bahlale bazinze kodwa kabalathemba lempilo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Angabayekela bahlale besizwa bevikelekile,","poem":1},{"text":"kodwa amehlo akhe ayazibona izindlela zabo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Okwesikhatshana nje balodumo, baphinde banyamalale;","poem":1},{"text":"bayehliswa njalo bafe njengabo bonke abanye;","poem":2},{"lineBreak":true},{"text":"bayaqunywa njengezihloko zamabele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Aluba lokhu kungenjalo, ngubani ongathi ngilamanga","poem":1},{"text":"alulazise amazwi ami abe yize?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}