 kuphela!”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}