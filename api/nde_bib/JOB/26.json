{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"heading","content":["UJobe Uyaphendula"]},{"type":"verse","number":1,"content":["UJobe wasephendula wathi:"]},{"type":"verse","number":2,"content":[{"text":"“Usumsize njani ongelamandla!","poem":1},{"text":"Usuyilamulele njani ingalo ebuthakathaka!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yiseluleko esinjani osusiphe lowo ongelakuhlakanipha!","poem":1},{"text":"Njalo usubonise mbono bani!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngubani okuncedisileyo ukukhuluma amazwi la na?","poem":1},{"text":"Ngokabani umoya okhulume ngomlomo wakho na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Abafileyo basebuhlungwini obukhulu,","poem":1},{"text":"labo abangaphansi kwamanzi lalabo abahlala kuwo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"UKufa kwambulekile phambi kukaNkulunkulu;","poem":1},{"text":"ikhamisile indawo yokubhubha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Uyawendlala umkhathi wenyakatho endaweni engelalutho;","poem":1},{"text":"aphanyeke umhlaba phezu kweze.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ugoqele amanzi emayezini akhe,","poem":1},{"text":"kodwa amayezi kawapatshaki yikusindwa ngamanzi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uyayigubuzela inyanga egcweleyo,","poem":1},{"text":"endlale amayezi phezu kwayo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Umisa umkhawulo wokwengama umkhathi emanzini","poem":1},{"text":"kube ngumngcele phakathi kokukhanya lobumnyama.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Izinsika zamazulu ziyazamazama,","poem":1},{"text":"zisethuswa yikukhuza kwakhe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngamandla akhe waluthulisa ulwandle;","poem":1},{"text":"ngenhlakanipho yakhe waquma uRahabi waba yiziqa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngomoya wakhe umkhathi wacethula;","poem":1},{"text":"isandla sakhe sayigwaza inyoka ibaleka.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Njalo le yimisebenzi yakhe engaphandle nje ekucineni;","poem":1},{"text":"esikuzwayo yilizwana nje lokunyenyeza kwakhe!","poem":2},{"lineBreak":true},{"text":"Pho ngubani ongawuzwisisa umdumo wamandla akhe na?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}