{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":27,"content":[{"type":"heading","content":["Amazwi KaJobe Okucina Ebanganini Bakhe"]},{"type":"verse","number":1,"content":["UJobe waqhubeka ngenkulumo yakhe wathi:"]},{"type":"verse","number":2,"content":[{"text":"“Ngifunga ngoNkulunkulu ophilayo,","poem":1},{"text":"ngubani ongithathele ilungelo lami lokwahlulelwa ngokulunga,","poem":2},{"lineBreak":true},{"text":"uSomandla, ongizwise ubuhlungu bomphefumulo,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"nxa ngilokhu ngiselempilo ngaphakathi kwami,","poem":1},{"text":"umphefumulo kaNkulunkulu usemakhaleni ami,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"izindebe zami kazisoze zikhulume ububi,","poem":1},{"text":"lolimi lwami kaluyikukhuluma inkohliso.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kangisoze ngivume ukuthi lina lilungile ngelikutshoyo;","poem":1},{"text":"ngizaze ngiyekufa ngingabulandulanga ubuqotho bami.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngizakugcina ukulunga kwami ngingakuyekeli;","poem":1},{"text":"umzwangedwa wami kawuyikungihlupha empilweni yami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sengathi izitha zami zingaba njengababi,","poem":1},{"text":"abaxabana lami babe njengabangaqondanga!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngoba ulethemba bani ongakholwayo nxa esefile,","poem":1},{"text":"uNkulunkulu angathatha impilo yakhe na?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"UNkulunkulu uyakulalela yini ukukhala kwakhe","poem":1},{"text":"nxa usizi lumehlela na?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Uzakuthola yini ukuthokoza kuSomandla?","poem":1},{"text":"Uzacela kuNkulunkulu sonke isikhathi na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ngizalifundisa mayelana lamandla kaNkulunkulu;","poem":1},{"text":"izindlela zikaSomandla kangiyikuzifihla.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lonke lizibonele lokhu ngokwenu.","poem":1},{"text":"Pho, ngeyani inkulumo yonke le eyize na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nansi isabelo uNkulunkulu asiqumela ababi,","poem":1},{"text":"ilifa elemukelwa ngumuntu olesihluku sivela kuSomandla:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Loba bebanengi njani abantwabakhe, isabelo sabo yinkemba;","poem":1},{"text":"lenzalo yakhe kayisoze lanini izuze ukudla okwaneleyo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Isifo esibi sizabangcwaba labo abatshiywa nguye besaphila,","poem":1},{"text":"labafelokazi babo kabayikubalilela.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Lokuba angaze abuthelele isiliva njengothuli","poem":1},{"text":"lezigqoko zibe yinqwaba njengodaka,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"lokho akubuthelelayo abalungileyo bazakugqokela,","poem":1},{"text":"labangelacala bazakwaba isiliva sakhe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Indlu ayakhayo injengesidleke sobulembu,","poem":1},{"text":"njengedumba elenziwe ngumlindi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Uthi esiyalala enothile, kodwa kasayikuphinda njalo;","poem":1},{"text":"uthi esevula amehlo, konke sekuphelile.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Utshaywa luvalo kungathi ufuqwa yisikhukhula;","poem":1},{"text":"isiphepho siyamhwitha ebusuku.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Umoya wempumalanga udlula laye, anyamalale;","poem":1},{"text":"uyamkhukhula endaweni yakhe.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Utshaya phezu kwakhe ngesihluku","poem":1},{"text":"esithi uyabaleka ecambalele evika amandla awo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Utshaya izandla umhleka ulunya","poem":1},{"text":"uvunguza laye umsusa endaweni yakhe.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}