{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":28,"content":[{"type":"heading","content":["Lapho Okutholakala Khona Inhakanipho"]},{"type":"verse","number":1,"content":[{"text":"Kulomgodi wesiliva","poem":1},{"text":"lendawo lapho okucengwa khona igolide.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Insimbi ithathwa emhlabathini,","poem":1},{"text":"lethusi lincibilikiswa emanyeleni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Umuntu uyawuxotsha umnyama;","poem":1},{"text":"uguduza ezingoxweni eziphansi kude","poem":2},{"lineBreak":true},{"text":"edinga amanyele emnyameni othe bhuqe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Khatshana kwezindawo zabantu ugebha umgodi,","poem":1},{"text":"ezindaweni lapho okungafiki nyawo lwamuntu;","poem":2},{"lineBreak":true},{"text":"khatshana kwabantu uyalenga, azunguzeke.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Umhlaba, okuphuma kuwo ukudla,","poem":1},{"text":"uyaguquka ngaphansi ingathi utshiswe ngomlilo;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"amasafire amatshe amahle ayaphuma emadwaleni,","poem":1},{"text":"uthuli lwawo lugcwele igolide.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kakukho nyoni edla inyama eyaziyo leyondlela efihlekileyo,","poem":1},{"text":"kakulalihlo laluphi ukhozi oselwake lwayibona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Izilo ezizithembileyo kazilubeki unyawo kuyo,","poem":1},{"text":"njalo kakulasilwane esizingela khona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isandla somuntu yiso esihlasela idwala eliyinsengetshe","poem":1},{"text":"siveze obala impande zezintaba.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Uyaligubha idwala angene;","poem":1},{"text":"ilihlo lakhe liwabone wonke amagugu alo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Uyathungatha lapho okudabuka khona imifula","poem":1},{"text":"aveze obala izinto ezifihlekileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kodwa ukuhlakanipha kungafunyanwa ngaphi na?","poem":1},{"text":"Kuhlala ngaphi na ukuzwisisa?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Umuntu kakuzwisisi ukuqakatheka kwakho;","poem":1},{"text":"kakufunyanwa elizweni labaphilayo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Phansi ekujuleni kuthi, “Kakukho kimi”;","poem":1},{"text":"ulwandle luthi, “Kangilakho mina.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kungeke kwathengwa ngegolide elicolekileyo,","poem":1},{"text":"njalo lentengo yakho ingeke yalinganiswa ngesiliva.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kungeke kwathengwa ngegolide lase-Ofiri,","poem":1},{"text":"loba nge-onikisi kumbe isafire.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kungazake kulinganiswe legolide loba amatshe akhazimulayo,","poem":1},{"text":"njalo kakuzuzwa ngemiceciso yegolide.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Amatshe amahle ekhorali lejaspa lawo kawabalwa lapha;","poem":1},{"text":"intengo yokuhlakanipha ingaphezulu kwamarubhi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ithophazi yaseKhushi ngeke ilinganiswe lakho;","poem":1},{"text":"ngeke kuthengwe langegolide elicolekileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Pho kuvela ngaphi ukuhlakanipha na?","poem":1},{"text":"Kuhlala ngaphi ukuzwisisa?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kufihliwe emehlweni ento yonke ephilayo,","poem":1},{"text":"kucatshisiwe lakuzo izinyoni zasemoyeni.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"INcithakalo loKufa kuthi,","poem":1},{"text":"“Amahungahunga akho yiwo kuphela esiwezwayo.”","poem":2}]},{"type":"verse","number":23,"content":[{"text":"UNkulunkulu uyayizwisisa indlela yakho","poem":1},{"text":"njalo nguye yedwa okwaziyo lapho okuhlala khona,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ngoba uyayikhangela imikhawulo yomhlaba","poem":1},{"text":"akubone konke okungaphansi kwamazulu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Wathi emisa umfutho womoya,","poem":1},{"text":"elinganisa isimo samanzi,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"wathi ebeka umthetho wezulu elinayo","poem":1},{"text":"lendlela yezulu elilesiphepho,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"wasekukhangela ukuhlakanipha wakuhlola butsha;","poem":1},{"text":"wakukholwa wakuqinisa, wakulinga ukuthi kuqinile.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Wathi emuntwini,","poem":1},{"text":"“Ukumesaba uThixo yikho ukuhlakanipha,","poem":2},{"lineBreak":true},{"text":"lokuxwaya ububi yikho ukuzwisisa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}