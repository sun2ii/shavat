{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":29,"content":[{"type":"heading","content":["Ukuzigeza KukaJobe Kokucina"]},{"type":"verse","number":1,"content":["UJobe waqhubeka ngenkulumo yakhe wathi:"]},{"type":"verse","number":2,"content":[{"text":"“Ngiyaziloyisa lezozinyanga esezadlulayo,","poem":1},{"text":"lezinsuku uNkulunkulu esangilinda,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"lapho isibane sakhe sisakhanyisa phezu kwekhanda lami","poem":1},{"text":"ngihamba ngokukhanya kwakhe emnyameni!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Oh, lezinsuku ngisazizwa ukuthi ngiyimi,","poem":1},{"text":"lapho ubudlelwano obukhulu loNkulunkulu busesendlini yami,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"lapho uSomandla eseselami","poem":1},{"text":"labantwabami besaphila lami,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"lapho indlela yami ifafazwe ngolaza ledwala","poem":1},{"text":"lingithululela impophoma zamafutha e-oliva.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ekuyeni kwami emasangweni edolobho","poem":1},{"text":"ngafika ngahlala enkundleni,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"amajaha angibona agudluka ema eceleni,","poem":1},{"text":"abadala baphakama bema ngezinyawo;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"amadoda ayizikhulu athula akaze akhuluma","poem":1},{"text":"avala imilomo yawo ngezandla zawo;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"amazwi ezikhulu ehliselwa phansi,","poem":1},{"text":"inlimi zazo zanamathela olwangeni lwazo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Loba ngubani owangizwayo wakhuluma kuhle ngami,","poem":1},{"text":"kwathi labo abangibonayo bangibuka,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ngoba ngalamulela abayanga abacela uncedo,","poem":1},{"text":"lezintandane ezazingelamsizi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Indoda eyayisifa yangibusisa;","poem":1},{"text":"ngenza inhliziyo yomfelokazi yahlabelela.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngavunula ukulunga njengezigqoko zami;","poem":1},{"text":"ukwahlulela ngokulunga kwaba yisembatho sami lengwane yami.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngangingamehlo kwabayiziphofu","poem":1},{"text":"lezinyawo kwabaqhulayo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nganginguyise kwabaswelayo;","poem":1},{"text":"ngayimela indaba yesihambi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngawephula amazinyo ababi","poem":1},{"text":"ngahluthuna labo ababebabambile ngamazinyo abo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ngakhumbula ngathi, ‘Ngizafela endlini yami,","poem":1},{"text":"insuku zami zinengi njengezinhlamvu zetshebetshebe.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Impande zami zizafinyelela emanzini,","poem":1},{"text":"amazolo azalala emagatsheni ubusuku bonke.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Udumo lwami luzahlala lulutsha kimi,","poem":1},{"text":"idandili lami lilitsha esandleni sami.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Abantu babengilalela belethemba,","poem":1},{"text":"belindele ukwelulekwa bethule zwi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nxa sekukhulume mina, kungakhulumi omunye njalo;","poem":1},{"text":"amazwi ami ayengena kamnandi ezindlebeni zabo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Babengilindela njengokulindela izulu,","poem":1},{"text":"bawanathe amazwi ami njengezulu lentwasa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ngangisithi ngingababobothekela, bathabe bangakholwa;","poem":1},{"text":"ukukhanya kobuso bami kwakuligugu kubo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Yimi engangibakhethela ukuthi benzeni ngoba ngisanduna kubo;","poem":1},{"text":"ngangihlala njengenkosi phakathi kwamabutho ayo;","poem":2},{"lineBreak":true},{"text":"ngangifana lomduduzi wabalilayo.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}