{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":3,"content":[{"type":"heading","content":["Inkulumo KaJobe"]},{"type":"verse","number":1,"content":["Ngemva kwalokho uJobe wavula umlomo wakhe waliqalekisa ilanga azalwa ngalo."]},{"type":"verse","number":2,"content":["Wathi:"]},{"type":"verse","number":3,"content":[{"text":"“Sengathi ilanga lokuzalwa kwami lingatshabalala,","poem":1},{"text":"lalobobusuku okwathiwa, ‘Kuzelwe umfana!’","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lolosuku sengathi lungaphenduka ubumnyama;","poem":1},{"text":"sengathi uNkulunkulu ophezulu angangalunanzi;","poem":2},{"lineBreak":true},{"text":"lokukhanya kucime ngalo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sengathi ubumnyama lethunzi elikhulu kungaluginya njalo;","poem":1},{"text":"sengathi iyezi lingalusibekela;","poem":2},{"lineBreak":true},{"text":"sengathi umnyama ungalugubuzela.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lobobusuku, sengathi ubumnyama bungabuthi jwamu;","poem":1},{"text":"sengathi bungayekelwa ukubalwa kanye lezinsuku zomnyaka","poem":2},{"lineBreak":true},{"text":"futhi bungangeniswa lakuyiphi inyanga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sengathi lobobusuku bungaba yinyumba;","poem":1},{"text":"sengathi kungeze kwezwakala umsindo wentokozo ngalo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sengathi labo abaqalekisa insuku bangaluqalekisa lolosuku,","poem":1},{"text":"labo abazimisele ukuhlokoza uLeviyathani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sengathi izinkanyezi zalo zokusa zingafiphala;","poem":1},{"text":"lulindele imini kube yize","poem":2},{"lineBreak":true},{"text":"lungayiboni imisebe yokuqala yokusa,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ngoba kaluyivalanga iminyango yesibeletho ngisiza","poem":1},{"text":"ukufihla uhlupho emehlweni ami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kungani ngingafanga ngizalwa,","poem":1},{"text":"ngahle ngacitsha ngisaphuma esiswini na?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kungani kwaba lamadolo okungemukela","poem":1},{"text":"lamabele okungimunyisa na?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngoba manje ngabe ngilele ekuthuleni;","poem":1},{"text":"ngabe ngisebuthongweni ekuphumuleni","poem":2}]},{"type":"verse","number":14,"content":[{"text":"kanye lamakhosi lababusi bomhlaba,","poem":1},{"text":"ababezakhele izindawo okwamanje sezingamanxiwa,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"kanye lamakhosana ayelegolide,","poem":1},{"text":"egcwalise izindlu zawo ngesiliva.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kumbe kungani ngingathukuzwanga emhlabathini njengomphunzo na,","poem":1},{"text":"njengosane oluvele lungazange lubone ukukhanya kosuku?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Khonale ababi kabasaxokozeli,","poem":1},{"text":"njalo khonale abakhatheleyo basekuphumuleni.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Abathunjiweyo labo bazuza ukukhululeka;","poem":1},{"text":"kabasakuzwa ukuhaladwa ngumtshayeli wabathunjiweyo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Abantukazana lezikhulu bakhonale,","poem":1},{"text":"lesigqili siyakhululwa enkosini yaso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kungani ukukhanya kuphiwa labo abasosizini na,","poem":1},{"text":"lokuphila kulabo abalobuhlungu emphefumulweni,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"kulabo abakhalela ukufa okungafikiyo,","poem":1},{"text":"abakuthungathayo ukwedlula ingcebo efihliweyo,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"abaphuphuma ngenjabulo","poem":1},{"text":"bathokoza nxa sebefika engcwabeni?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kungani impilo iphiwa umuntu","poem":1},{"text":"ondlela yakhe ifihliwe,","poem":2},{"lineBreak":true},{"text":"uNkulunkulu amhonqolozeleyo na?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ngoba ukububula sokuphenduke ukudla kwami kwansukuzonke;","poem":1},{"text":"ukugomela kwami kuthululeka njengamanzi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ebengikwesaba sekungehlele,","poem":1},{"text":"obekungitshayisa ngovalo sekwenzakele kimi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kangilakho ukuchelesa, kangilakho ukuthula;","poem":1},{"text":"kangilakuphumula, kodwa ukuhlupheka kuphela.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}