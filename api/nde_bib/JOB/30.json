{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":30,"content":[{"type":"heading","content":["UJobe Uqhubeka Ekhuluma"]},{"type":"verse","number":1,"content":[{"text":"“Kodwa manje bayangiklolodela,","poem":1},{"text":"amadoda angabantwana kimi,","poem":2},{"text":"oyise engangingabehlisa","poem":1},{"text":"ngibelusise izimvu zami.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amandla ezandla zabo ayengangisiza ngani mina,","poem":1},{"text":"ngoba amadlabuzane abo ayesephelile;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"sebejujukile ngokuswela langendlala,","poem":1},{"text":"bazula elizweni elomileyo","poem":2},{"lineBreak":true},{"text":"emangweni eyinkangala engelalutho ebusuku.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Enkotheni khonale bakha imibhida emunyu,","poem":1},{"text":"ukudla kwabo kuzimpande zezihlahla.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Baxotshwa ebantwini bakibo,","poem":1},{"text":"bathethiswa kungathi babengamasela.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kwasekumele bahlale ezihotsheni zezifula ezomileyo,","poem":1},{"text":"ezimbalwini emadwaleni lemilindini emhlabathini.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bakhonya phakathi kwezihlahla","poem":1},{"text":"baququbala ezixukwini.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Base bengabantu abaphansi abangaselabizo,","poem":1},{"text":"sebexotshiwe elizweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kodwa manje amadodana abo asengihaya ngengoma;","poem":1},{"text":"sengiyisiga kubo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bayangenyanya njalo bamela khatshana lami;","poem":1},{"text":"kabathikazi ukungikhafulela ebusweni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Khathesi njengoba uNkulunkulu eselithukulule idandili lami","poem":1},{"text":"wangitshaya ngezinhlupheko,","poem":2},{"lineBreak":true},{"text":"sebeklamasa kabasazithinti.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kwesokunene kwami ixuku liyangihlasela;","poem":1},{"text":"bathiya inyawo zami ngemijibila","poem":2},{"lineBreak":true},{"text":"bakhe imibundu yokungivimbezela.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Badiliza indlela yami;","poem":1},{"text":"bayaphumelela ukungibhidliza","poem":2},{"lineBreak":true},{"text":"besithi ‘Akekho ozamsiza.’","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bahlasela ingathi bafohlela esikhaleni esivulekileyo;","poem":1},{"text":"beza bethululeka phezu kwezinqwaba zamanxiwa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ukwesaba okukhulu kungiphethe;","poem":1},{"text":"isithunzi sami sobuntu singathi siphethwe ngumoya,","poem":2},{"lineBreak":true},{"text":"ukuvikeleka kwami kunyamalala njengeyezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Manje impilo yami isincipha;","poem":1},{"text":"insuku zokuhlupheka zingibambe nko.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ubusuku bugwaza amathambo ami;","poem":1},{"text":"lokuqaqamba kobuhlungu bami kakupheli.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngamandla akhe amakhulu uNkulunkulu unjengelembu kimi;","poem":1},{"text":"uyangikhama ngamabheqe entanyeni yami.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ungivoxela edakeni,","poem":1},{"text":"ngicina sengiluthuli lomlotha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ngikhala kuwe, Oh Nkulunkulu, kodwa kawuphenduli;","poem":1},{"text":"ngiyasukuma, kodwa uyangikhangela kuphela.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ungisukela ngesihluku;","poem":1},{"text":"ungihlasela ngamandla esandla sakho.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Uyangihlwitha ngiphetshulwe ngumoya;","poem":1},{"text":"ngiphoseke le lale phakathi kwesiphepho.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ngiyazi ukuthi uzangilalisa phansi ekufeni,","poem":1},{"text":"endaweni emiselwe konke okuphilayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ngempela kakho ombeka isandla umuntu oswelayo","poem":1},{"text":"nxa ekhalela ukusizwa esebunzimeni.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kangibakhalelanga yini labo abahluphekileyo?","poem":1},{"text":"Umoya wami kawubazwelanga usizi abayanga na?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kodwa ngathi ngilindele ubuhle, kweza ububi;","poem":1},{"text":"ngathi ngilindele ukukhanya kweza ubumnyama.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ukudunguluka ngaphakathi kwami kakukhawuli;","poem":1},{"text":"insuku zokuhlupheka zingijamele.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ngihamba nje ngimnyama kubi, kungesikutshiswa lilanga;","poem":1},{"text":"ngiyasukuma enkundleni ngicele uncedo.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Sengingumfowabo wamakhanka,","poem":1},{"text":"umkhula wezikhova.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Isikhumba sami siba mnyama, siyaxathuka;","poem":1},{"text":"umzimba wami uyatshisa ngomkhuhlane.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ichacho lami selilungiselwe isililo,","poem":1},{"text":"lomqangala wami ulindele umkhosi wokukhala.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}