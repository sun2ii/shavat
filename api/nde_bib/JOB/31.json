{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":31,"content":[{"type":"heading","content":["UJobe Uqhubeka Ekhuluma"]},{"type":"verse","number":1,"content":[{"text":"“Ngasenza isivumelwano lamehlo ami","poem":1},{"text":"ukuthi angakhangeli intombi ayihawukele.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Siyini isabelo somuntu asabelwe nguNkulunkulu ophezulu na,","poem":1},{"text":"ilifa lakhe elivela kuSomandla phezulu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Akusikubhujiswa kwababi","poem":1},{"text":"lokutshabalaliswa kwalabo abenza okubi na?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kanti kaziboni yini izindlela zami","poem":1},{"text":"abale zonke izinyathelo zami?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nxa ngike ngahamba ngokwamanga","poem":1},{"text":"loba unyawo lwami lwakhuthalela inkohliso","poem":2}]},{"type":"verse","number":6,"content":[{"text":"uNkulunkulu akangikale esikalini sakhe esiqotho","poem":1},{"text":"ukuze abone ukuthi angilasici,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"nxa izinyathelo zami zike zaphambuka endleleni,","poem":1},{"text":"nxa inhliziyo yami ikhokhelwe ngamehlo ami,","poem":2},{"lineBreak":true},{"text":"noma kumbe izandla zami zike zangcoliswa,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"lapho-ke abanye kabazidlele lokho engikuhlanyeleyo,","poem":1},{"text":"njalo amabele ami kawasitshunwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nxa inhliziyo yami ike yakhangwa ngowesifazane,","poem":1},{"text":"kumbe nxa ngike ngacathama ngasemnyango kamakhelwane,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"lapho-ke owami umfazi kacholele enye indoda,","poem":1},{"text":"njalo amanye amadoda kawalale laye.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngoba lokho bekuzakuba lihlazo,","poem":1},{"text":"isono esifanele ukwahlulelwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kungumlilo otshisayo onguMaqothula;","poem":1},{"text":"ngabe kwasiphuna isivuno sami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nxa ngingaphathanga kuhle izisebenzi zami,","poem":1},{"text":"esesilisa lesesifazane","poem":2},{"lineBreak":true},{"text":"nxa kukhona abakusolayo kimi,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ngizakuthini lapho uNkulunkulu esengibuza ngakho na?","poem":1},{"text":"Ngizaphendula ngithini nxa sekumele ngichaze na?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yena lowo owangenzayo esibelethweni kabenzanga labo na?","poem":1},{"text":"Kasuye yini yena kanye owasenzayo sonke","poem":2},{"lineBreak":true},{"text":"phakathi kwezisu zabomama na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nxa ngilahlele eceleni izifiso zabayanga","poem":1},{"text":"loba ngayekela amehlo omfelokazi edinwa yizinyembezi,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"nxa ngizidlele ngedwa isinkwa sami,","poem":1},{"text":"ngingasabelani lezintandane,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"kodwa ebutsheni bami ngabondla njengaboyise,","poem":1},{"text":"njalo kusukela ekuzalweni kwami ngamkhokhela umfelokazi,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"nxa ngike ngabona umuntu esifa ngokuswela izigqoko,","poem":1},{"text":"loba umuntu oswelayo engelasivunulo,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"njalo inhliziyo yakhe ayingibusisanga","poem":1},{"text":"ngokumfudumeza ngoboya bezimvu zami,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"nxa ngike ngaphakamisa isandla sami phezu kwentandane,","poem":1},{"text":"kodwa mina ngikwazi ukuthi bayangilalela emthethwandaba,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"nxa kunjalo kayikhumuke ingalo yami kusukela ehlombe,","poem":1},{"text":"kayephulwe endololwaneni.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ngoba ngesaba ukubhubhisa kukaNkulunkulu,","poem":1},{"text":"kwathi ngokwesaba inkazimulo yakhe,","poem":2},{"lineBreak":true},{"text":"ngayekela ukwenza izinto ezinjalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Nxa ngifake ithemba lami phezu kwegolide,","poem":1},{"text":"loba ngathi kulo igolide elicolekileyo, ‘Ulithemba lami,’","poem":2}]},{"type":"verse","number":25,"content":[{"text":"nxa bengithokoziswa yinotho yami enengi,","poem":1},{"text":"lenzuzo evele ngezandla zami,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"nxa ngilikhangele ilanga libenyezela","poem":1},{"text":"loba inyanga ihamba ngenkazimulo,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"yaze yayengeka inhliziyo yami ngaphakathi","poem":1},{"text":"nganga isandla sami ukuzikhonza,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"lezi lazo yizono ebezifanele ukwahlulelwa,","poem":1},{"text":"ngoba bengizabe ngingathembekanga kuNkulunkulu ophezulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Nxa ngike ngathokoza ngomnyama owehlele isitha sami","poem":1},{"text":"kumbe ngagqabhaza ngohlupho olumehleleyo,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"kangivumelanga umlomo wami ukuba wenze isono","poem":1},{"text":"ngokuqalekisa ukuphila kwakhe,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"nxa abantu bendlu yami bengakaze bathi,","poem":1},{"text":"‘Ngubani ongazange azitike ngenyama kaJobe na?’","poem":2}]},{"type":"verse","number":32,"content":[{"text":"kodwa kakulasihambi esake salala emgwaqweni,","poem":1},{"text":"ngoba umnyango wami wawuhlala uvulelwe izihambi","poem":2}]},{"type":"verse","number":33,"content":[{"text":"nxa ngisithukuzile isono sami njengokwenziwa ngabantu,","poem":1},{"text":"ngokufihla umlandu wami enhliziyweni yami","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ngoba ngisesaba abantu","poem":1},{"text":"ngithuthunyeliswa yikweyiswa ngabosendo","poem":2},{"lineBreak":true},{"text":"ngazithulela ngaze ngala lokuphumela phandle.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"(Oh, kube ukhona ongizwayo!","poem":1},{"text":"Sengisayina incwadi yokuzivikela kwami,","poem":2},{"text":"uSomandla kangiphendule;","poem":1},{"text":"ongimangalelayo kabhale phansi","poem":2},{"lineBreak":true},{"text":"icala angethesa lona.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Leyoncwadi ngingayithwala ehlombe lami,","poem":1},{"text":"ngingayithwala ekhanda njengomqhele.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Bengingamchazela ngokugcweleyo","poem":1},{"text":"ngazozonke izinyathelo zami;","poem":2},{"lineBreak":true},{"text":"ngisondele kuye njengenkosana.)","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"Nxa ilizwe lakithi lingiphika","poem":1},{"text":"lemifolo yalo imanzi ngezinyembezi,","poem":2}]},{"type":"verse","number":39,"content":[{"text":"nxa ngike ngadla izithelo zalo angaze ngabhadala","poem":1},{"text":"loba ngephula imimoya yabanikazi,","poem":2}]},{"type":"verse","number":40,"content":[{"text":"nxa kunjalo kakumile ameva esikhundleni sengqoloyi,","poem":1},{"text":"lokhula esikhundleni sebhali.”","poem":2},"Aphela lapha amazwi kaJobe."]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}