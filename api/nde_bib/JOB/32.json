{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":32,"content":[{"type":"heading","content":["Inkulumo Ka-Elihu"]},{"type":"verse","number":1,"content":["Amadoda la womathathu ema ukuphendula uJobe ngoba wayelungile ngokubona kwakhe."]},{"type":"verse","number":2,"content":["Kodwa u-Elihu indodana kaBharakeli umBhuzi, owendlu kaRamu, wamzondela uJobe ngokuzigeza yena endaweni yokugezwa nguNkulunkulu."]},{"type":"verse","number":3,"content":["Wayebazondele njalo labangane labo bobathathu ngoba babengayitholanga indlela yokuphikisa uJobe kodwa bemlahlile ngokumsola."]},{"type":"verse","number":4,"content":["U-Elihu wayeke wema ukukhuluma loJobe ngoba babebadala kulaye."]},{"type":"verse","number":5,"content":["Kodwa kwathi esebona ukuthi wonke amadoda womathathu ayengaselalutho ayengalutsho, ulaka lwakhe lwavutha."]},{"type":"verse","number":6,"content":["Ngakho-ke u-Elihu indodana kaBharakeli umBhuzi wathi:",{"text":"“Ngimncinyane ngeminyaka,","poem":1},{"text":"lina libadala;","poem":2},{"text":"yikho bengisesaba,","poem":1},{"text":"ngithikaza ukutsho engikwaziyo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngikhumbule ngathi, ‘Kakukhulume ubudala;","poem":1},{"text":"iminyaka yokukhula kayifundise ukuhlakanipha.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kodwa kungumoya osemuntwini,","poem":1},{"text":"ukuphefumula kukaSomandla, okumupha ukuqedisisa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kakusibo bodwa abadala abahlakaniphileyo,","poem":1},{"text":"njalo kakusibo bodwa abalupheleyo abakuzwisisayo okulungileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ngakho ngithi: Lalelani kimi;","poem":1},{"text":"lami ngizalitshela engikwaziyo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bengithule lisakhuluma,","poem":1},{"text":"ngikulalele ukucabanga kwenu;","poem":2},{"text":"lathi lisadinga amazwi,","poem":1}]},{"type":"verse","number":12,"content":[{"text":"ngalilalela ngokupheleleyo.","poem":2},{"text":"Kodwa kakho lamunye kini otshengise ukuthi uJobe ulahlekile;","poem":1},{"text":"kakho omunye wenu osephendule imibono yakhe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lingaze lathi, ‘Sesikutholile ukuhlakanipha;","poem":1},{"text":"uNkulunkulu kaveze ukuphosisa kwakhe, hatshi umuntu.’","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kodwa uJobe kakaqondisisi amazwi akhe kimi,","poem":1},{"text":"futhi kangiyikumphendula ngendlela yenu yokuphikisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Sebededile kabaselakho okunye abangakutsho;","poem":1},{"text":"sebesilela amazwi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngike ngime na njengoba sebethule,","poem":1},{"text":"sebemi nje laphayana bengaselampendulo?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Lami ngisake ngikhulume;","poem":1},{"text":"lami ngizakutsho engikwaziyo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngoba manengi amazwi engilawo,","poem":1},{"text":"umoya ongaphakathi kwami uyangifuqa;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ngaphakathi ngiyafuthelana njengewayini elivalelwe embodleleni;","poem":1},{"text":"njengemixhaka yewayini esifuna ukudubuka.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kumele ngikhulume ukuze ngibhodle;","poem":1},{"text":"kumele ngivule indebe zami ngiphendule.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kangizukutshengisa ubandlululo loba kukubani,","poem":1},{"text":"futhi kangisoze ngiyenge muntu;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ngoba ngabe ngangiligabazi ekukhulumeni,","poem":1},{"text":"uMenzi wami ubezangisusa masinyane.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}