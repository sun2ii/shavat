{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":33,"content":[{"type":"heading","content":["U-Elihu Uqhubeka Ekhuluma"]},{"type":"verse","number":1,"content":[{"text":"“Khathesi-ke, Jobe, lalela amazwi ami;","poem":1},{"text":"lalelisisa konke engikutshoyo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sengizawuvula umlomo wami;","poem":1},{"text":"amazwi ami asesolimini lwami.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Amazwi ami aphuma enhliziyweni eqotho;","poem":1},{"text":"izindebe zami zikhuluma ngokukholwa lokho engikwaziyo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"UMoya kaNkulunkulu wangenza;","poem":1},{"text":"umphefumulo kaSomandla ungipha impilo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngiphendula nxa usenelisa;","poem":1},{"text":"zilungiselele ukuthi ungiphikise.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lami nginjengawe phambi kukaNkulunkulu;","poem":1},{"text":"lami njalo ngathathwa emhlabathini.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ukungesaba kwakho makungakwethusi,","poem":1},{"text":"njalo isandla sami masingasindi kuwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kodwa ukhulumile ngisizwa,","poem":1},{"text":"ngiwezwile amazwi wona kanye,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"‘Ngimsulwa njalo kangilasono;","poem":1},{"text":"ngihlanzekile kangilamlandu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ikanti uNkulunkulu ubone okusolekayo kimi;","poem":1},{"text":"ungithatha njengesitha sakhe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Uyazikhina inyawo zami ngezibopho;","poem":1},{"text":"uyaziqaphelisisa zonke izindlela zami.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kodwa ngiyakutshela ukuthi lapha uyalahleka,","poem":1},{"text":"uNkulunkulu mkhulu kulomuntu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kungani umsola","poem":1},{"text":"usithi kaphenduli amazwi omuntu na?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngempela uNkulunkulu uyakhuluma,","poem":1},{"text":"khathesi akhulume ngale indlela,","poem":2},{"text":"aphinde akhulume ngenye","poem":1},{"text":"lokuba umuntu angaze akunanzelela.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kungaba ngephupho, kube ngombono ebusuku","poem":1},{"text":"lapho abantu belele befile","poem":2},{"lineBreak":true},{"text":"bethe nya emibhedeni yabo,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"angakhuluma ezindlebeni zabo,","poem":1},{"text":"abethuse ngezixwayiso,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ukuze aguqule umuntu ekwenzeni okubi","poem":1},{"text":"aqede ukuzikhukhumeza kwakhe,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ukulondoloza umphefumulo wakhe ungayi egodini,","poem":1},{"text":"lempilo yakhe ingabhubhi ngenkemba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Loba umuntu angajeziswa ngobuhlungu esembhedeni wakhe,","poem":1},{"text":"langokuqaqamba okungathuliyo emathanjeni akhe,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"aze ezwe umzimba wakhe usunengwa yikudla","poem":1},{"text":"lomoya wakhe usenyanya lokudla okumnandi kakhulu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Inyama yakhe iyacikizeka iphele,","poem":1},{"text":"lamathambo akhe ayekade evaliwe abonakale egcekeni.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Umoya wakhe uyasondela egodini,","poem":1},{"text":"lempilo yakhe kuzo izithunywa zokufa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kodwa nxa kulengilosi eceleni kwakhe,","poem":1},{"text":"engumeli, eyodwa phakathi kwenkulungwane,","poem":2},{"lineBreak":true},{"text":"ukutshela umuntu okuyikho okumfaneleyo,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ukuba lomusa kuye isithi,","poem":1},{"text":"‘Mxolele angayingena egodini;","poem":2},{"lineBreak":true},{"text":"sengimzuzele inhlawulo yakhe yokumhlenga","poem":2}]},{"type":"verse","number":25,"content":[{"text":"bese inyama yakhe ivuselelwa njengeyomntwana;","poem":1},{"text":"iyavuselelwa ibe njengezinsukwini zobutsha bakhe.’","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Uyakhuleka kuNkulunkulu amthokozele,","poem":1},{"text":"abubone ubuso bukaNkulunkulu amemeze ngentokozo;","poem":2},{"lineBreak":true},{"text":"uyabuyiselwa nguNkulunkulu esimeni sakhe sokulunga.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kuthi-ke abesebuya ebantwini athi,","poem":1},{"text":"‘Ngenza isono, ngahlanekela okulungileyo,","poem":2},{"lineBreak":true},{"text":"kodwa kangisazuzanga obekungifanele.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Wawuhlenga umphefumulo wami ukuze ungayi egodini,","poem":1},{"text":"ngakho ngizaphila ukuze ngikholise ukukhanya.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"UNkulunkulu uyazenza zonke lezizinto emuntwini","poem":1},{"text":"kabili, noma kathathu","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ukubuyisa umphefumulo wakhe ungayi egodini,","poem":1},{"text":"ukuthi isibane sokuphila sikhanye kuye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Nanzelela, Jobe, ulalele kimi;","poem":1},{"text":"thula kukhulume mina.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Nxa ulolutho lokutsho, ngiphendula;","poem":1},{"text":"khuluma sibili, ngoba ngifuna ukuthi ugezwe umlandu.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Kodwa nxa lungekho lalela kimi;","poem":1},{"text":"thula zwi mina ngizakufundisa ukuhlakanipha.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}