{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":34,"content":[{"type":"heading","content":["U-Elihu Uqhubeka Ekhuluma"]},{"type":"verse","number":1,"content":["U-Elihu waqhubeka esithi:"]},{"type":"verse","number":2,"content":[{"text":"“Zwanini amazwi ami, lina madoda ahlakaniphileyo;","poem":1},{"text":"lalelani kimi, lina madoda ayizifundiswa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Phela indlebe iyawahlola amazwi","poem":1},{"text":"njengolimi lunambitha ukudla.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Asizihluzeleni thina okulungileyo;","poem":1},{"text":"kasifundeni ndawonye okuhle.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"UJobe uthi, ‘Kangilacala,","poem":1},{"text":"kodwa uNkulunkulu kangahluleli ngokulunga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Loba mina ngiqondile,","poem":1},{"text":"kuthiwa ngilamanga;","poem":2},{"text":"loba ngingelacala,","poem":1},{"text":"umtshoko wakhe ungihlaba isilonda esingelaphekiyo.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"UJobe kanti ungumuntu bani,","poem":1},{"text":"onatha ukuklolodela njengamanzi?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Uzwanana labantu abenza ububi;","poem":1},{"text":"uhambisana labantu ababi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngoba uthi, ‘Umuntu kakumsizi ngalutho","poem":1},{"text":"ukuzama ukuthokozisa uNkulunkulu.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ngakho lalelani kimi lina madoda azwisisayo.","poem":1},{"text":"Kakube khatshana laye uNkulunkulu","poem":2},{"lineBreak":true},{"text":"ukwenza ububi, khatshana kukaSomandla ukona.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Uyamphindisela umuntu ngalokho akwenzileyo;","poem":1},{"text":"umehlisela lokho okufanele ukuziphatha kwakhe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kakungeni engqondweni","poem":1},{"text":"ukuthi uNkulunkulu angenza ububi,","poem":2},{"lineBreak":true},{"text":"ukuthi uSomandla","poem":2},{"lineBreak":true},{"text":"angakutshila ukwahlulela ngokulunga.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngubani owambekayo phezu komhlaba na?","poem":1},{"text":"Ngubani owathi kalawule umhlaba wonke na?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Aluba wayengathanda","poem":1},{"text":"asuse umoya wakhe lokuphefumula,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"bonke abantu babengatshabalala kanyekanye,","poem":1},{"text":"umuntu wayezabuyela othulini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nxa lilokuzwisisa, zwanini lokhu;","poem":1},{"text":"lalelani lokhu engikutshoyo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kambe lowo ozonda ukwahlulela ngokulunga angabusa na?","poem":1},{"text":"Liyamlahla yini Yena oqotho njalo olamandla?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kayisuye yini othi emakhosini, ‘Kalisizi lutho,’","poem":1},{"text":"athi kwabayizikhulu, ‘Libabi,’","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ongatshengisi ukwazisa amakhosana kulabanye","poem":1},{"text":"loba athande abanothileyo kulabayanga,","poem":2},{"lineBreak":true},{"text":"ngoba bonke bangumsebenzi wezandla zakhe?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bayafa nje masinyane, loba phakathi kobusuku;","poem":1},{"text":"abantu bayanyikinywa bedlule;","poem":2},{"lineBreak":true},{"text":"abalamandla bayasuswa kungelasandla somuntu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Amehlo akhe aphezu kwezindlela zabantu;","poem":1},{"text":"ubona zonke izinyathelo zabo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Akulandawo emnyama loba ithunzi elisithileyo,","poem":1},{"text":"lapho abenzi bobubi abangacatsha khona.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"UNkulunkulu kasweli ukuthi aphinde abahlolisise abantu,","poem":1},{"text":"ukuze abalethe ekwahlulelweni phambi kwakhe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Engaqalanga wahlola uyabaphahlaza abalamandla","poem":1},{"text":"abeke abanye endaweni yabo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ngoba ezinanzelela izenzo zabo,","poem":1},{"text":"uyabagenqula ebusuku bahlifizeke.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Uyabajezisa ngenxa yobubi babo","poem":1},{"text":"kube segcekeni emuntwini wonke,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ngoba baphambuka ekumlandeleni","poem":1},{"text":"abaze banaka layiphi indlela yakhe.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Benza ukukhala kwabayanga kweza phambi kwakhe,","poem":1},{"text":"laye wakuzwa ukukhala kwabasweleyo.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kodwa nxa elokhu ezithulele, ngubani ongamsola na?","poem":1},{"text":"Angafihla ubuso bakhe ngubani ongambona na?","poem":2},{"text":"Kanti uphezu komuntu lesizwe ngokufanayo,","poem":1}]},{"type":"verse","number":30,"content":[{"text":"ukwalela ongamesabiyo uNkulunkulu ukuthi abuse,","poem":2},{"lineBreak":true},{"text":"ukuze angafakeli abantu izifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Akesithi umuntu athi kuNkulunkulu,","poem":1},{"text":"‘Ngilecala kodwa kangisayikona njalo.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ngifundisa lokho engingakuboniyo;","poem":1},{"text":"nxa ngenze okubi, kangisayikuphinda ngikwenze.’","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Pho uNkulunkulu akuvuze ngokwentando yakho na,","poem":1},{"text":"wena usala ukuphenduka?","poem":2},{"text":"Kumele ukhethe wena, hatshi mina;","poem":1},{"text":"ngakho ngitshela lokho okwaziyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Amadoda alokuqedisisa azakutsho,","poem":1},{"text":"amadoda ahlakaniphileyo abangizwayo ngisithi kini,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"‘UJobe ukhuluma engelalwazi;","poem":1},{"text":"amazwi akhe kawalambono.’","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Oh, uJobe angasake alingwe ngokweqileyo","poem":1},{"text":"ngoba uphendule njengomuntu omubi!","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Phezu kwesono sakhe wengeza ukuhlamuka;","poem":1},{"text":"uyakloloda ngokuqakeza izandla zakhe phakathi kwethu","poem":2},{"lineBreak":true},{"text":"andise amazwi akhe aphikisa uNkulunkulu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}