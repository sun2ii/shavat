{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":35,"content":[{"type":"heading","content":["U-Elihu Uqhubeka Ekhuluma"]},{"type":"verse","number":1,"content":["U-Elihu wasesithi:"]},{"type":"verse","number":2,"content":[{"text":"“Ukhumbula ukuthi lokhu kulungile yini?","poem":1},{"text":"Uthi, ‘Ngizagezwa nguNkulunkulu.’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kodwa uyambuza uthi, ‘Kungisiza ngani lokhu na,","poem":1},{"text":"njalo ngizuzani ngokungenzi isono?’","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ngithanda ukukuphendula","poem":1},{"text":"kanye labangane bakho abalapha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ake ukhangele emazulwini ubone;","poem":1},{"text":"khangela amayezi aphakeme kangaka ngaphezu kwakho.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ungaze wenze isono, lokho kumthinta ngani na?","poem":1},{"text":"Nxa izono zakho zizinengi, kwenzani lokho kuye na?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nxa ulungile, kuyini omnika khona wena na,","poem":1},{"text":"kumbe yena wamukelani esandleni sakho?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ububi bakho bulimaza kuphela umuntu onjengawe,","poem":1},{"text":"lokulunga kwakho kuthinta amadodana abantu kuphela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abantu bayakhala ngomthwalo wokuncindezelwa;","poem":1},{"text":"bacela ukuphunyuzwa ezingalweni zalabo abalamandla.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kodwa kakho othi, ‘Ungaphi uNkulunkulu uMenzi wami na,","poem":1},{"text":"opha amahubo ebusuku,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"osifundisayo thina kulezinyamazana zalapha emhlabeni","poem":1},{"text":"asenze sihlakaniphe kulezinyoni zasemoyeni?’","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kaphenduli nxa abantu bebiza","poem":1},{"text":"ngenxa yokuziphakamisa kwababi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngempela uNkulunkulu kakulaleli ukuncenga kwabo kwamanga;","poem":1},{"text":"uSomandla kayilaleli into enjalo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kuzakuba njani pho, angakulalela","poem":1},{"text":"nxa usithi kawumboni,","poem":2},{"text":"usithi indaba yakho iphambi kwakhe","poem":1},{"text":"ngakho kuzamele ulinde yena,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"njalo futhi, ukuthi ulaka lwakhe kalujezisi","poem":1},{"text":"njalo akabunanzi lakancane ububi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yikho uJobe evula umlomo wakhe ekhuluma ize;","poem":1},{"text":"ngokuswela ulwazi wandisa amazwi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}