{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":36,"content":[{"type":"heading","content":["U-Elihu Uqhubeka Ekhuluma"]},{"type":"verse","number":1,"content":["U-Elihu waqhubeka esithi:"]},{"type":"verse","number":2,"content":[{"text":"“Ake lingibekezelele okwesikhatshana ukuze ngilitshengise","poem":1},{"text":"ukuthi kunengi okumele kutshiwo ngobuhle bukaNkulunkulu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngiluzuza kude ulwazi lwami;","poem":1},{"text":"ngithi ukwahlulela okulungileyo ngokukaMenzi wami.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yiba leqiniso ukuthi amazwi ami aqinisile;","poem":1},{"text":"yena opheleleyo elwazini ulawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"UNkulunkulu ulamandla, kodwa keyisi muntu;","poem":1},{"text":"ulamandla njalo katshedi ezimisweni zakhe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ababi kabayekeli bephila","poem":1},{"text":"kodwa abahluphekayo uyabapha okubafaneleyo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kawasusi amehlo akhe kwabalungileyo;","poem":1},{"text":"ubakhweza esihlalweni kanye lamakhosi","poem":2},{"lineBreak":true},{"text":"abaphakamise nini lanini.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kodwa nxa abantu bebotshwe ngamaketane,","poem":1},{"text":"bethiwe nko ngezibopho zezinhlupheko,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"uyabatshela lokho abakwenzileyo,","poem":1},{"text":"ukuthi benze isono ngokuziphakamisa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ubenza balalele ukuqondiswa","poem":1},{"text":"abalaye ukuthi baphenduke ebubini babo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nxa bemlalela bamkhonze,","poem":1},{"text":"zonke insuku zabo eziseleyo zizaphumelela,","poem":2},{"lineBreak":true},{"text":"leminyaka yabo ibe ngeyokusuthiseka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kodwa nxa bengalaleli,","poem":1},{"text":"bazabhubha ngenkemba,","poem":2},{"lineBreak":true},{"text":"bafe bengelalwazi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Abangamesabiyo uNkulunkulu bagodle ukusola enhliziyweni;","poem":1},{"text":"loba angaze ababophe kabaceli ukusizwa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bafa besesebatsha,","poem":1},{"text":"bephakathi kweziphingi ezingamadoda,","poem":2},{"lineBreak":true},{"text":"ezihlala ezindaweni zokukhonzela.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kodwa labo abahluphekayo","poem":1},{"text":"uyabakhulula ekuhluphekeni kwabo;","poem":2},{"lineBreak":true},{"text":"ukhuluma labo besezinkathazweni zabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Uyakulimukisa ukuthi uphume emihlathini yosizi","poem":1},{"text":"uye endaweni ebanzi,","poem":2},{"text":"ekhululekileyo njalo engelazibopho,","poem":1},{"text":"ebumnandini betafula yakho igcwele izidlo ezimnandi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kodwa manje usindwa yikwahlulelwa okulungele ababi;","poem":1},{"text":"ukuthonisiswa lokwahlulelwa ngokulunga","poem":2},{"lineBreak":true},{"text":"yikho osekukuduba.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Qaphela kungabikhona okulingayo ngenotho;","poem":1},{"text":"ungavumeli ukuthengwa ngemali kukususe endleleni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kambe inotho yakho loba konke ukutshikatshika kwakho","poem":1},{"text":"kungakusekela ukuze ungangeni osizini na?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ungalangazeleli ubusuku,","poem":1},{"text":"ukuze uyohudula abantu ezindaweni zabo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Qaphela ungangeni kokubi,","poem":1},{"text":"okukhanya ingathi uyakuthanda kulokuhlupheka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"UNkulunkulu uphakeme ngamandla akhe.","poem":1},{"text":"Ngubani ongafundisa njengaye na?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ngubani omisele izindlela zakhe na,","poem":1},{"text":"loba othe kuye, ‘Usuwenze okungalunganga?’","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Khumbula ukukhulisa umsebenzi wakhe,","poem":1},{"text":"abantu abawudumisileyo ngengoma.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bonke abantu jikelele bakubonile lokhu;","poem":1},{"text":"abantu bakukhangela bemi khatshana.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ubukhulu bukaNkulunkulu bungaphezulu kokuzwisisa kwethu!","poem":1},{"text":"Iminyaka yakhe ingezake yaziwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Uyawadonsa amathonsi amanzi,","poem":1},{"text":"aqulungane abe lizulu elingena ezifuleni;","poem":2}]},{"type":"verse","number":28,"content":[{"text":"amayezi athulula amanzi awo","poem":1},{"text":"kune izulu elikhulu ebantwini.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ngubani ongakuzwisisa ukuthi uwendlala njani amayezi na,","poem":1},{"text":"ukuthi ukhwaza njani esesiqongweni sakhe na?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ake libone ukuthi uwuhlakaza njani umbane wakhe azizingelezele ngawo,","poem":1},{"text":"abhukutshe ezinzikini zolwandle.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Yiyo indlela abusa ngayo izizwe","poem":1},{"text":"aziphe ukudla okunengi.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ugcwalisa izandla zakhe ngombane","poem":1},{"text":"awukhombise lapho omele utshaye khona.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ukuduma kwakhe kubika isiphepho esizayo;","poem":1},{"text":"lenkomo ziyatshengisa ukuza kwaso.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}