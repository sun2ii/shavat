{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":37,"content":[{"type":"heading","content":["U-Elihu Uqhubeka Ekhuluma"]},{"type":"verse","number":1,"content":[{"text":"“Konke lokhu kwenza inhliziyo yami itshaye","poem":1},{"text":"ize itshede endaweni yayo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lalela! Lalela ukubhonga kwelizwi lakhe,","poem":1},{"text":"ukuzamazama okuphuma emlonyeni wakhe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Uyawukhulula umbane wakhe ngaphansi kwawo wonke amazulu","poem":1},{"text":"awuthumele emikhawulweni yomhlaba.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngemva kwalokho kuza umdumo wokubhonga kwakhe;","poem":1},{"text":"uduma ngelizwi lakhe lobukhosi.","poem":2},{"text":"Nxa ilizwi lakhe seliqaqamba","poem":1},{"text":"ulikhulula lonke angaligodli.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ilizwi likaNkulunkulu liduma ngezindlela ezimangalisayo;","poem":1},{"text":"wenza izinto ezinkulu ngaphezu kokuzwisisa kwethu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Utshela ungqwaqwane athi, ‘Khithika phezu komhlaba,’","poem":1},{"text":"lezulu athi kulo, ‘Thululeka ube yisihlambo esikhulu.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ukuze kuthi bonke abantu abadalayo bakwazi ukusebenza kwakhe,","poem":1},{"text":"uyamisa umuntu wonke emsebenzini wakhe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Izinyamazana ziyacatsha;","poem":1},{"text":"zihlale ezikhundleni zazo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isiphepho siyaphuma ekamelweni laso,","poem":1},{"text":"umqando uphume entshongolweni esikayo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ukuphefumula kukaNkulunkulu kukhupha iliqhwa,","poem":1},{"text":"amanzi aluwaca ajiye abe yilitshe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ugcwalisa amayezi ngamanzi;","poem":1},{"text":"ahlakaze umbane wakhe ngawo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngokuqondisa kwakhe ayaqhela embese umhlaba wonke","poem":1},{"text":"ukuze enze loba yini awalaya yona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Uyawaletha amayezi ajezise ngawo abantu,","poem":1},{"text":"loba ukuthelezela umhlaba wakhe ukuze atshengise uthando lwakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Lalela lokhu, Jobe;","poem":1},{"text":"akume ukhumbule izimangaliso zikaNkulunkulu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Uyakwazi na ukuthi uNkulunkulu uwalawula njani amayezi","poem":1},{"text":"enze umbane wakhe ulavuke?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Uyakwazi na ukuthi amayezi emi njani elengile,","poem":1},{"text":"leyomimangaliso yakhe yena lowo opheleleyo elwazini?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wena oginqiswa yikutshisa kwezigqoko zakho","poem":1},{"text":"nxa umhlaba uthule zwi kubetha umoya waseningizimu,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ungamncedisa yini ukwendlala isibhakabhaka,","poem":1},{"text":"esilukhuni njengesibuko sensimbi yethusi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ake usitshele ukuthi pho sithini kuye;","poem":1},{"text":"ngeke siyimise kuhle indaba yethu ngoba kumnyama nje lapha kithi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Atshelwe kambe ukuthi ngifuna ukukhuluma?","poem":1},{"text":"Ukhona umuntu ongacela ukuthi aginywe?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Phela kakho ongalikhangela ilanga,","poem":1},{"text":"njengoba licazimula kangaka esibhakabhakeni","poem":2},{"lineBreak":true},{"text":"nxa umoya uwaphephule wonke amayezi kwacethula.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Esuka enyakatho uqhamuka ngenkazimulo enjengegolide;","poem":1},{"text":"uNkulunkulu uqhamuka ngobukhosi obesabekayo.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"USomandla asingeke simfinyelele njalo uphakeme ulamandla;","poem":1},{"text":"ekwahluleleni kwakhe okuhle lokulunga okukhulu kancindezeli.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ngakho-ke abantu bayamhlonipha,","poem":1},{"text":"ngoba kanti kabanaki yini bonke abahlakaniphileyo enhliziyweni?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}