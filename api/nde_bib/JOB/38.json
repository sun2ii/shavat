{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":38,"content":[{"type":"heading","content":["UThixo Uyakhuluma"]},{"type":"verse","number":1,"content":["UThixo wasekhuluma loJobe ephakathi kwesiphepho. Wathi:"]},{"type":"verse","number":2,"content":[{"text":"“Ngubani na lowo odunga amacebo ami","poem":1},{"text":"ngamazwi okungazi?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Qina njengendoda;","poem":1},{"text":"ngizakubuza,","poem":2},{"lineBreak":true},{"text":"lawe uzangiphendula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wawungaphi lapho ngibeka izisekelo zomhlaba na?","poem":1},{"text":"Ngitshela nxa uqedisisa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngubani owamisa izilinganiso zawo na? Phela angithi uyazi!","poem":1},{"text":"Ngubani owayidonsayo intambo yokulinganisa kuwo na?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Izinsika zawo zamiswa phezu kwani na,","poem":1},{"text":"loba ngubani owamisa ilitshe lawo lekhoneni na","poem":2}]},{"type":"verse","number":7,"content":[{"text":"lapho izinkanyezi zokusa zazihlabelela kanyekanye","poem":1},{"text":"lezingilosi zonke zamemeza ngentokozo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ngubani owavalela ulwandle ngemva kwezivalo","poem":1},{"text":"lapho selufohla esiswini na,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"lapho ngisenza amayezi aba yisembatho salo na","poem":1},{"text":"ngalugoqela ngomnyama omkhulu,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"lapho ngalubekela imikhawulo","poem":1},{"text":"ngamisa iminyango yalo lemigoqo endaweni yayo,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"lapho engathi, ‘Ungeza uze ufike lapha kodwa ungedluli;","poem":1},{"text":"kulapha amagagasi akho azigqajayo aphelela khona?’","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Sewake wabekela ikuseni umthetho na,","poem":1},{"text":"loba watshengisa ukusa indawo yakho","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ukuba kuphakamise umhlaba ngemiphetho","poem":1},{"text":"kuthintithe ababi abakuwo?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Umhlaba ubumbeka isimo njengebumba ufakwe uphawu;","poem":1},{"text":"imibala yawo ikhanye ithi bha njengelembu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ababi bayacitshelwa ukukhanya,","poem":1},{"text":"lengalo yabo ephakanyisiweyo iyephulwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Sewake wahamba emithonjeni yolwandle na","poem":1},{"text":"loba wahamba ezingoxweni zenziki yalo na?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Amasango okufa aseke abonakaliswa kuwe na?","poem":1},{"text":"Usuke wawabona amasango ethunzi lokufa na?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ubuqedisisile na ubukhulu bobubanzi bomhlaba?","poem":1},{"text":"Ngitshela nxa ukwazi konke lokhu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yiphi indlela eya ekhaya elihlala ukukhanya na?","poem":1},{"text":"Ubumnyama bona buhlala ngaphi?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ungakusa ezindaweni zakho na?","poem":1},{"text":"Uyazazi izindlela eziya emizini yazo na?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ye uyakwazi, ngoba wawuvele usuzelwe!","poem":1},{"text":"Usuphile iminyaka yonke le!","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Sewake wangena eziphaleni zikangqwaqwane","poem":1},{"text":"loba wabona iziphala zesiqhotho na,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"engizilindisele izikhathi zohlupho,","poem":1},{"text":"insuku zempi lokuhlasela na?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ingaphi indlela eya esigodlweni sokwaba umbane,","poem":1},{"text":"loba indawo yokuhlakaza umoya wempumalanga phezu komhlaba na?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ngubani ogubhe intshukuntshu yezihlambo zezulu,","poem":1},{"text":"lendlela yomdumo wesiphepho;","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ukuthelezela ilizwe elingahlali muntu,","poem":1},{"text":"inkangala okungelamuntu kuyo,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ukusuthisa ilizwe elilugwadule","poem":1},{"text":"kulenze lihlume utshani na?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Izulu elinayo liloyise na?","poem":1},{"text":"Ngubani onguyise wamathonsi amazolo na?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ngesikabani isisu esizala iliqhwa na?","poem":1},{"text":"Ngubani ozala umtshazo ovela phezulu na","poem":2}]},{"type":"verse","number":30,"content":[{"text":"lapho amanzi abalukhuni njengelitshe,","poem":1},{"text":"lapho iphezulu yolwandle ijiyile?","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ungasibopha na isiLimela lesi esihle?","poem":1},{"text":"Ungazithukulula yini izintambo zeziNja?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ungawuletha na uMthala ngesikhathi sawo","poem":1},{"text":"loba ukhuphe inkanyezi ethiwa yiNgulube lemidlwane yayo?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Uyayazi imithetho yasezulwini na?","poem":1},{"text":"Ungawakha yini umbuso kaNkulunkulu emhlabeni?","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Ungawamemeza yini amayezi","poem":1},{"text":"uthi akunethise ngesihlambo samanzi?","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Uyakuthuma yini ukuphazima kombane?","poem":1},{"text":"Uyabika kuwe yini uthi, ‘Ngilapha’?","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ngubani owapha inhliziyo ukuhlakanipha","poem":1},{"text":"kumbe owapha ingqondo ukuzwisisa na?","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Ngubani ololwazi lokubala amayezi na?","poem":1},{"text":"Ngubani ongagenqula amaqhaga asezulwini na","poem":2}]},{"type":"verse","number":38,"content":[{"text":"nxa uthuli seluqina","poem":1},{"text":"lamagade omhlabathi esebumbene?","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Uyasizingelela na isilwanekazi ukudla kwaso,","poem":1},{"text":"uyiqede indlala yezilwane","poem":2}]},{"type":"verse","number":40,"content":[{"text":"lapho zilele ezikhundleni zazo","poem":1},{"text":"kumbe zicwathile ezixukwini?","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Ngubani opha iwabayi ukudla","poem":1},{"text":"lapho amatsiyane alo ekhala kuNkulunkulu","poem":2},{"lineBreak":true},{"text":"ezulazula ehayila ngendlala na?”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/37.json","previousChapterAudioLinks":{},"numberOfVerses":41}