{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":39,"content":[{"type":"heading","content":["UThixo Uqhubeka Ekhuluma"]},{"type":"verse","number":1,"content":[{"text":"“Uyakwazi na ukuthi amagogo azala nini?","poem":1},{"text":"Uyawubukele yini nxa impalakazi izala izinyane layo?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Uyawuzibale yini izinyanga zize zizale?","poem":1},{"text":"Uyasazi isikhathi ezizazala ngaso na?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ziyalala phansi zizale abantwana bazo;","poem":1},{"text":"kube sekuphela ubuhlungu bokuhelelwa kwazo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amazinyane azo ayaqina akhule abe lamandla egangeni;","poem":1},{"text":"ayasuka ahambe angabuyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ngubani owakhulula ubabhemi weganga na?","poem":1},{"text":"Ngubani owathukulula igoda lakhe na?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngamupha ugwadule lwaba likhaya lakhe,","poem":1},{"text":"lenkangala yetswayi ibe ngumango wakhe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Uyazincifela iziphithiphithi zedolobho;","poem":1},{"text":"kakuzwa ukukhahlanyezwa ngumtshayeli.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Uyazihambela abhode izintaba emadlelweni akhe","poem":1},{"text":"edinga loba yini eluhlaza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Inyathi kambe izavuma ukukusebenzela na?","poem":1},{"text":"Izahlala esibayeni sakho ebusuku na?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ungayibamba ngomchilo ulime ngayo na?","poem":1},{"text":"Ingazilima na izigodi zakho?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ungayithemba yini ngenxa yamandla ayo amakhulu na?","poem":1},{"text":"Ungawuyekelela yona umsebenzi wakho onzima na?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ungayithemba ukuthi izalayitsha amabele akho na","poem":1},{"text":"iwase esizeni?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Impiko zentshe zitshaya kakuhle,","poem":1},{"text":"kodwa ngeke zilinganiswe","poem":2},{"lineBreak":true},{"text":"lempiko kanye lezinsiba zengabuzane.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ibekela amaqanda ayo emhlabathini","poem":1},{"text":"iwayekele afudumale etshebetshebeni,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"inganakananga ukuthi unyawo oluthile lungawahlifiza,","poem":1},{"text":"ukuthi inyamazana yeganga ethile ingawanyathela.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Amatsiyane ayo iyawakhahlameza, kube sengathi akusi wayo;","poem":1},{"text":"ingakhathali ukuthi ukubekela kwayo kwaba yize,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ngoba uNkulunkulu kayiphanga ukuhlakanipha","poem":1},{"text":"loba ingqondo yokubona okufaneleyo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kodwa nxa isiselula impiko zayo ukuthi igijime,","poem":1},{"text":"iyalihleka ibhiza lomgadi walo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Uyalipha na wena ibhiza amandla","poem":1},{"text":"kumbe ugqokise intamo yalo ngomhlonga na?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Uyalenza leqe njengentethe na,","poem":1},{"text":"lingethuse ngokuhwabha kwalo kokuziqenya?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Liyaphanda ngenkani, lithokoziswa ngamandla alo,","poem":1},{"text":"lidlubulunde lihlasela isitha.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Liyakuhleka ukwesaba, kalesabi lutho;","poem":1},{"text":"kaliyikhekhelezi inkemba.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Umxhaka wemitshoko ukhehlezela emhlubulweni walo,","poem":1},{"text":"ndawonye lomkhonto obenyezelayo kanye lomdikadika.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Liyafuthelana ngamadlabuzane ligijime limbe phansi;","poem":1},{"text":"kakulivumeli ukuma nxa icilongo selikhala.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Konela ukuthi likhale icilongo lihwabhe lithi, ‘Aha!’","poem":1},{"text":"Lihle lilizwe iphunga lempi isesekhatshana,","poem":2},{"lineBreak":true},{"text":"ukukhwaza kwezinduna lomkhosi wempi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ukhozi luphatshiswa yikuhlakanipha kwakho na","poem":1},{"text":"lwelule impiko zalo ziqonde eningizimu?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ukhozi luntweza ngokutshelwa nguwe yini","poem":1},{"text":"kanye lokwakhela isidleke salo esiqongweni?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Luhlala eliweni, lulale khona ebusuku;","poem":1},{"text":"idwala elililiwa yilo inqaba yalo.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ludinga ukudla kwayo lusuka khona;","poem":1},{"text":"amehlo alo akubona ekude.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Amatsiyane alo azitika ngegazi,","poem":1},{"text":"kuthi lapho okulokubuleweyo khona lalo lukhona.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}