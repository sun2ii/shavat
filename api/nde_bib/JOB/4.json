{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":4,"content":[{"type":"heading","content":["Impendulo Ka-Elifazi"]},{"type":"verse","number":1,"content":["Wasephendula u-Elifazi umThemani wathi:"]},{"type":"verse","number":2,"content":[{"text":"“Nxa umuntu angaphosa ilizwi nje kuwe uzacunuka na?","poem":1},{"text":"Kodwa ngubani ongathula angakhulumi na?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Khumbula ukuthi sewabafundisa njani abanengi,","poem":1},{"text":"ukuthi ubaqinise njani abalezandla ezibuthakathaka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amazwi akho abasekele labo abakhubekayo;","poem":1},{"text":"uwaqinisile amadolo axegayo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kodwa manje uhlupho luze kuwe, usuphela amandla;","poem":1},{"text":"lukutshaya ubusudela ithemba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kungani ukukholwa kwakho kungabi yiso isibindi sakho na","poem":1},{"text":"lezindlela zakho ezimsulwa zibe lithemba lakho na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Khumbula manje: Ngubani owathi engelacala wabhubha na?","poem":1},{"text":"Kungaphi lapho abaqotho abake babhujiswa khona na?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngokubona kwami labo abalima okubi","poem":1},{"text":"lalabo abahlanyela ububi bavuna bona.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngokuphefumula kukaNkulunkulu bayabhubha;","poem":1},{"text":"ngokukhwaza kolaka lwakhe bayafa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Izilwane zingabhonga zihwabhe,","poem":1},{"text":"kodwa amazinyo ezilwane ezinkulu ayephuka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Isilwane siyafa ngokuswela ukudla","poem":1},{"text":"besekuthi imidlwane yesilwanekazi ihlakazeke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kulethwe ilizwi kimi ngasese,","poem":1},{"text":"indlebe zami zilizwile linyenyezwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Phakathi kwamaphupho adungayo ebusuku,","poem":1},{"text":"lapho abantu belele obukabhuka,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ukwesaba lokuthuthumela kwangifikela","poem":1},{"text":"kwenza wonke amathambo ami aqhaqhazela.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kwathi tshazi umoya emehlweni ami,","poem":1},{"text":"wahlasimula umzimba wami lenwele zami zema.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Umoya lowo wema,","poem":1},{"text":"kodwa kangikwazanga ukuthi kuyini.","poem":2},{"text":"Kwakumi into phambi kwamehlo ami,","poem":1},{"text":"ngasengisizwa ilizwi elihelezayo:","poem":2}]},{"type":"verse","number":17,"content":[{"text":"‘Kambe umuntu angalunga ukwedlula uNkulunkulu na?","poem":1},{"text":"Umuntu angahlanzeka kuloMenzi wakhe na?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nxa uNkulunkulu engazethembi izinceku zakhe,","poem":1},{"text":"nxa ebeka izingilosi zakhe umlandu ngokona,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"pho-ke kuzakuba njani kulabo abahlala ezindlini zodaka,","poem":1},{"text":"ozisekelo zazo zisothulini,","poem":2},{"lineBreak":true},{"text":"abahlifizeka lula njengenondo!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Phakathi kokusa lokuhlwa bayabhidlizwa babe yizicucu;","poem":1},{"text":"bengananzwa langubani, bayabhubha kokuphela.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Izintambo zamatende abo kazidonswa na,","poem":1},{"text":"bafe bengelalwazi?’ ”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}