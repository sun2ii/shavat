{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":40,"content":[{"type":"heading","content":["UThixo Uqhubeka Ekhuluma"]},{"type":"verse","number":1,"content":["UThixo wathi kuJobe:"]},{"type":"verse","number":2,"content":[{"text":"“Lowo ophikisana loSomandla angamqondisa na?","poem":1},{"text":"Yena lowo obeka uNkulunkulu icala kamphendule!”","poem":2}]},{"type":"verse","number":3,"content":["Ngakho uJobe wasephendula uThixo wathi:"]},{"type":"verse","number":4,"content":[{"text":"“Kakungilingananga, ngingakuphendula njani na?","poem":1},{"text":"Ngivala umlomo wami ngesandla sami.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngikhulumile kanye, kodwa kangilampendulo,","poem":1},{"text":"kabili, kodwa kangisayikukhuluma njalo.”","poem":2}]},{"type":"verse","number":6,"content":["UThixo wasekhuluma loJobe ephakathi kwesiphepho wathi:"]},{"type":"verse","number":7,"content":[{"text":"“Qina njengendoda;","poem":1},{"text":"ngizakubuza,","poem":2},{"lineBreak":true},{"text":"wena uzangiphendula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ungakusola na ukwahlulela kwami ngokulunga?","poem":1},{"text":"Ungangilahla ukuze uzigeze na?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ulayo ingalo enjengekaNkulunkulu na,","poem":1},{"text":"njalo ilizwi lakho lingaduma njengelakhe yini?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nxa kunjalo zicecise ngobukhosi langenkazimulo,","poem":1},{"text":"uzembathise ngodumo lobukhosi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Khulula ukuvutha kolaka lwakho,","poem":1},{"text":"khangela wonke umuntu ozigqajayo umthobise,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"khangela wonke umuntu ozigqajayo umbeke phansi,","poem":1},{"text":"ubacobodise ababi khonapho abakhona.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bambele bonke ndawonye othulini;","poem":1},{"text":"goqela ubuso babo engcwabeni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Lapho-ke lami ngizavuma kuwe","poem":1},{"text":"ukuthi isandla sakho sokunene singakusindisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Khangela imvubu,","poem":1},{"text":"engayidala kanye lawe","poem":2},{"lineBreak":true},{"text":"njalo edla utshani njengenkomo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ilamandla amangalisayo okhalweni lwayo,","poem":1},{"text":"amandla angaka emisipheni yesisu sayo!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Umsila wayo uyazunguza njengomsedari;","poem":1},{"text":"imisipha yemilenze yayo yalukene.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Amathambo ayo alezimbobo zethusi,","poem":1},{"text":"lezitho zayo zinjengemiqwayi yensimbi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Iyingqala yezidalwa zikaNkulunkulu,","poem":1},{"text":"kodwa uMenzi wayo angayehlula ngenkemba yakhe.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Izintaba zimlethela izithelo zazo,","poem":1},{"text":"kuthi zonke izilo zeganga zidlalele eduze.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ilala ngaphansi kwezihlahla ezibukekayo,","poem":1},{"text":"isithekile phakathi kwemihlanga exhaphozini.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Izihlahla ezinhle ziyayisitha ngemithunzi yazo;","poem":1},{"text":"imidubu okhunjini lomfula iyihonqolozele.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nxa umfula uthwele izikhukhula kayethuki;","poem":1},{"text":"kayithi thiki lokuba iJodani ithululela impophoma emlonyeni wayo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ukhona yini ongayibamba ngamehlo,","poem":1},{"text":"kumbe ayithiye ayibhoboze amakhala na?”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}