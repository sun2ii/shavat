{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":41,"content":[{"type":"heading","content":["UThixo Uqhubeka Ekhuluma"]},{"type":"verse","number":1,"content":[{"text":"“Ungambamba na uLeviyathani ngewuka","poem":1},{"text":"loba uhitshele ulimi lwakhe ngentambo na?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ungawufaka umkhala yini emakhaleni akhe","poem":1},{"text":"kumbe ubhoboze umhlathi wakhe ngewuka na?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Uzabe elokhu ekuncenga yini ukuthi umzwele?","poem":1},{"text":"Uzakhuluma lawe ngamazwi apholileyo yini?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Uzakwenza isivumelwano lawe na","poem":1},{"text":"ukuthi abe yisichaka sakho kokuphela?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ungamenza abe yisifuyo sokudlalisa njengenyoni na","poem":1},{"text":"kumbe umfake umkhungo adlaliswe ngamantombazana na?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Abathengi bazabhejelana ngentengo yakhe na?","poem":1},{"text":"Bazakwahlukaniselana ngaye na abathengi?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ungasibhoboza yini isikhumba sakhe ngenhlendla","poem":1},{"text":"loba ikhanda lakhe ngemikhonto yokuciba inhlanzi?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ungabeka isandla phezu kwakhe,","poem":1},{"text":"uzahlala ukukhumbula ukutshukana kwenu ungaphindi futhi!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ukucabanga ukuthi ungamehlula kuyize;","poem":1},{"text":"ukumbona nje kodwa kuqeda amandla.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kakho ongaba lesibindi sokuthi alwe laye.","poem":1},{"text":"Pho ngubani ongamelana lami na?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngubani engilomlandu kuye othi kangihlawule na?","poem":1},{"text":"Konke okukhona ngaphansi kwezulu ngokwami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kangisoze ngikhawule ukubabaza izitho zakhe,","poem":1},{"text":"amandla akhe langesimo sakhe esihle.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngubani ongaxebula isikhumba sakhe na?","poem":1},{"text":"Ngubani ongasondela kuye ngamatomu na?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngubani ongaqunga isibindi avule iminyango yomlomo wakhe,","poem":1},{"text":"ogqagqelwe zingavula zamazinyo na?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Umhlane wakhe ulezinhlu zamahawu","poem":1},{"text":"abophene silikici;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"yilelo lithe mba kwelinye","poem":1},{"text":"okuthi kakungeni moya phakathi kwawo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Anamathelene ndawonye;","poem":1},{"text":"abambene okokuthi angeke ehlukaniswe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ukuthimula kwakhe kukhupha inhlansi zomlilo;","poem":1},{"text":"amehlo akhe anjengemisebe yokusa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Amalangabi omlilo alavuka emlonyeni wakhe;","poem":1},{"text":"inhlansi zomlilo ziqhatsha ziphuma khona.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Intuthu ithunqa iphuma emakhaleni akhe","poem":1},{"text":"kungathi isuka embizeni ebilayo phezu komlilo wemihlanga.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ukuphefumula kwakhe kulumathisa amalahle,","poem":1},{"text":"njalo kulavuka amalangabi emlonyeni wakhe.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Amandla akhe asentanyeni yakhe;","poem":1},{"text":"okuphambi kwakhe kuhle kuphele amandla.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Amavinqo enyama yakhe abambene nki;","poem":1},{"text":"aqine nko kawehlukaniseki.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Isifuba sakhe silukhuni njengelitshe,","poem":1},{"text":"siqine njengengaphansi kwembokodo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Uthi nxa ephakama kwesabe amaqhawe ngokwawo;","poem":1},{"text":"atshede ebalekela ukubhula komsila wakhe.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Inkemba leyo emfikelayo kayenzi lutho,","poem":1},{"text":"kumbe umkhonto, loba umtshoko loba isijula.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Insimbi uyithatha njengotshani","poem":1},{"text":"lethusi kungathi luluthi olubolileyo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Imitshoko kayimenzi abaleke;","poem":1},{"text":"lamatshe esavutha anjengomule kuye.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Induku kuye ingumuca wotshani;","poem":1},{"text":"uyahleka esizwa ukukhenceza komdikadika.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ingaphansi yomzimba wakhe injengendengezi ezibukhali,","poem":1},{"text":"itshiya umzila odakeni kungathi yisileyi esizunguzekayo.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Udunga inziki zamanzi ayabuke njengembiza enkulu ibila,","poem":1},{"text":"aluvube ulwandle njengembiza yamagcobo.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ngemva kwakhe utshiya umzila okhazimulayo;","poem":1},{"text":"umuntu angazathi ulwandle luloboya obumhlophe.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Kakukho emhlabeni okulingana laye,","poem":1},{"text":"isidalwa esingesabiyo.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ubakhangelela phansi bonke abathi bazithembile;","poem":1},{"text":"uyinkosi phezu kwabo bonke abazigqajayo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":34}