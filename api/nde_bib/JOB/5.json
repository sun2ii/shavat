{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":5,"content":[{"type":"heading","content":["U-Elifazi Uqhubeka Ekhuluma"]},{"type":"verse","number":1,"content":[{"text":"“Memeza nxa uthanda, kodwa ngubani ozakuphendula na?","poem":1},{"text":"Uzaphendukela kuwuphi wabangcwele na?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ukucaphuka kuyasibulala isiwula","poem":1},{"text":"lomhawu uyamqeda oyisithutha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mina ngokwami sengasibona isiwula siphumelela,","poem":1},{"text":"kodwa masinyane nje indlu yaso yayisiqalekisiwe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abantwabaso kabavikelekanga lakancinyane,","poem":1},{"text":"baphoselwa entolongweni bengelamvikeli.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Abalambileyo bayazidlela isivuno sakhe,","poem":1},{"text":"besithatha kanye lasemeveni,","poem":2},{"lineBreak":true},{"text":"labomileyo bahahabela inotho yakhe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngoba ubunzima kabugobhozi emhlabathini,","poem":1},{"text":"loba uhlupho luhlume phansi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kodwa umuntu uzalelwa ukuhlupheka","poem":1},{"text":"njengoba ngeqiniso inhlansi zomlilo ziqhatshela phezulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kodwa aluba ubuyimi, bengizamncenga uNkulunkulu;","poem":1},{"text":"bengizakwethula udubo lwami kuye.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uyazenza izimanga ezingelakulinganiswa,","poem":1},{"text":"imimangaliso engelakubalwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Uyanisa izulu emhlabeni;","poem":1},{"text":"uthumela amanzi elizweni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abaphansi uyabakhweza phezulu,","poem":1},{"text":"lalabo abakhalayo ubaphakamisela ekuphepheni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Uyawafubisa amacebo amaqili,","poem":1},{"text":"ukuze izandla zawo zingaphumeleli.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Uyababamba abahlakaniphileyo ebuqilini babo,","poem":1},{"text":"kuthi amaqhinga eziphoxo achitheke.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ubumnyama buyabehlela emini;","poem":1},{"text":"phakathi kwemini bayaphumputha kungathi kusebusuku.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Uyabasindisa abaswelayo baphephe inkemba emlonyeni wabo;","poem":1},{"text":"uyabasindisa ekubanjweni ngabalamandla.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngakho abayanga balalo ithemba,","poem":1},{"text":"ukwahlulela kubi kuvala owakho umlomo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ubusisiwe umuntu oqondiswa nguNkulunkulu;","poem":1},{"text":"ngakho ungaseyisi isijeziso sikaSomandla.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngoba uyagwaza, kodwa aphinde abophe amanxeba;","poem":1},{"text":"uyalimaza kodwa izandla zakhe njalo ziyapholisa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Uzakuhlenga ezinhluphekweni eziyisithupha;","poem":1},{"text":"kweziyisikhombisa kawuyikuwelwa yingozi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ngesikhathi sendlala uzakuhlenga ekufeni,","poem":1},{"text":"lasempini akuhlenge ekugaleleni kwenkemba.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Uzavikelwa ekuhletshweni,","poem":1},{"text":"ungaze wesaba nxa kufika incithakalo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Uzakuhleka ukuchithakala kanye lendlala,","poem":1},{"text":"njalo ungaze wazesaba izilo zomhlaba.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ngoba uzakuba lesivumelwano lamatshe eganga,","poem":1},{"text":"lezinyamazana zeganga zizahlalisana kuhle lawe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Uzakwazi ukuthi ithente lakho livikelekile;","poem":1},{"text":"uzahlolisisa impahla yakho uthole kungelalutho olungekho.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Uzakwazi ukuthi abantwabakho bazakuba banengi,","poem":1},{"text":"lesizukulwane sakho sibe ngangotshani bomhlaba.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Uzakuza engcwabeni usukhulile okugcweleyo","poem":1},{"text":"njengezikhwebu zamabele eziqoqwa seziphelele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Sesikuhlolile lokhu, kuliqiniso.","poem":1},{"text":"Ngakho kuzwisise, ukulandele wena ngokwakho.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}