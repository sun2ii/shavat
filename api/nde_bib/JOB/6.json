{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":6,"content":[{"type":"heading","content":["Impendulo KaJobe"]},{"type":"verse","number":1,"content":["Wasephendula uJobe wathi:"]},{"type":"verse","number":2,"content":[{"text":"“Nxa ubuhlungu bami bungalinganiswa","poem":1},{"text":"lokuhlupheka kwami konke kufakwe esikalini!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngempela bungasinda ukwedlula itshebetshebe yolwandle,","poem":1},{"text":"akungamangalisi ukuthi amazwi ami abhede kanje.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Imitshoko kaSomandla iphakathi kwami,","poem":1},{"text":"umoya wami unatha itshefu yayo;","poem":2},{"lineBreak":true},{"text":"inhlupho zokuhlukuluza zikaNkulunkulu ziqondiswe kimi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kambe ubabhemi weganga uyakhala yini utshani bukhona,","poem":1},{"text":"loba inkabi ikhonye yona ukudla ilakho?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ukudla okuduma kuyadleka na kungelatswayi,","poem":1},{"text":"kumbe okumhlophe kweqanda kuyanambitheka yini?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngiyala ukukuthinta;","poem":1},{"text":"ukudla okunjalo kubuyisa inhliziyo yami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Oh, aluba ngingazuza isicelo sami,","poem":1},{"text":"uNkulunkulu angiphe lokho engikufisayo,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ukuthi uNkulunkulu avume ukungichoboza,","poem":1},{"text":"ekele nje isandla sakhe singiqede!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lalapho ngizabe ngilokhu ngilale induduzo","poem":1},{"text":"intokozo yami ebuhlungwini obungadediyo,","poem":2},{"lineBreak":true},{"text":"ukuthi bengingawaphikanga amazwi akhe oNgcwele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ngilamandla bani okuthi ngibe lokhu ngithemba?","poem":1},{"text":"Ngisamelelwe yini ukuba ngibe ngilokhu ngibekezela?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngilamandla elitshe yini?","poem":1},{"text":"Inyama yami ilithusi na?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngilawo yini amandla okuzisiza,","poem":1},{"text":"manje njengoba sengemukwe impumelelo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Iloba ngubani ogodla umusa kumkhula wakhe","poem":1},{"text":"udela ukwesaba uSomandla.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kodwa abafowethu kabathenjwa","poem":1},{"text":"njengemifula egeleza icitsha,","poem":2},{"lineBreak":true},{"text":"njengemifula echithayo","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ileliqhwa eselincibilika,","poem":1},{"text":"njalo igcwele ngongqwaqwane osencibilikile,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"kodwa ikhawule ukugeleza ngesikhathi sokoma,","poem":1},{"text":"kuthi sekutshisa amanzi anyamalale ezindleleni zawo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Indwendwe zamakamela ziyaphambuka ezindleleni zazo;","poem":1},{"text":"zintule enkangala zifele khona.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Indwendwe zamakamela aseThema zidinga amanzi,","poem":1},{"text":"abathengisi baseShebha balinde bethembile.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bayadana ngoba bebekade bethembile;","poem":1},{"text":"bayafika khonale bafike badane.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Lani selitshengise ukuthi kalilancedo;","poem":1},{"text":"libona into eyesabekayo beselisesaba.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Sengake ngatsho yini ukuthi, ‘Ake lingihlawulele lokhu,","poem":1},{"text":"ngihlengani ngempahla yenu,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ngikhululani esandleni sesitha,","poem":1},{"text":"ngihlengani ekufithizelweni ngabalesihluku’?","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ngifundisani, ngizathula;","poem":1},{"text":"ake lingitshengise lapho engiphambanise khona.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Abuhlungu kanganani amazwi eqiniso!","poem":1},{"text":"Kodwa ukuphikisa kwenu kutshengisani?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Lizama ukuqondisa engikutshoyo,","poem":1},{"text":"amazwi omuntu oselahlekelwe lithemba liwathethe njengomoya nje na?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Lina lingenza inkatho ngezintandane,","poem":1},{"text":"lithengise lomngane wenu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Kodwa okwamanje wobani lomusa lingizwele.","poem":1},{"text":"Ngingaqamba amanga phambi kwenu na?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Dedani, lingenzi okungaqondanga;","poem":1},{"text":"khumbulani kutsha, phela ubuqotho bami busengozini.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kukhona okubi na okusezindebeni zami?","poem":1},{"text":"Kambe umlomo wami kawukwehlukanisi okubi na?”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}