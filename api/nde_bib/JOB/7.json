{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":7,"content":[{"type":"heading","content":["UJobe Uqhubeka Ekhuluma"]},{"type":"verse","number":1,"content":[{"text":"“Umuntu kakho ekutshikatshikeni okunzima yini emhlabeni?","poem":1},{"text":"Insuku zakhe kazifani lezomuntu oqhatshiweyo na?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Njengesigqili siloyisa amathunzi okuhlwa,","poem":1},{"text":"lanjengoqhatshiweyo elindele umholo wakhe,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"kanjalo ngibekelwe izinyanga ezingelambadalo,","poem":1},{"text":"lobusuku bosizi sebabelwe mina.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngithi nxa ngilala ngicabange ngithi, ‘Kuzakusa nini na’?","poem":1},{"text":"Ubusuku buyadonsa ngiqwayize kuze kuse.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Umzimba wami uphihlika impethu lamathuthuva,","poem":1},{"text":"isikhumba sami siyobukile siyabhibhidla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Insuku zami ziyaphangisa kulosungulo lomaluki,","poem":1},{"text":"zisuka ziphele kungekho ithemba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Khumbula, Oh Nkulunkulu, ukuthi impilo yami ngumoya nje;","poem":1},{"text":"amehlo ami kawayikufa akubona njalo ukuthokoza.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ilihlo elingibonayo khathesi alisayikuphinde lingibone futhi;","poem":1},{"text":"lizangidinga, kodwa ngizakuba ngingasekho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Njengeyezi elinyamalalayo liphele,","poem":1},{"text":"kanjalo lowo ongena engcwabeni kaphenduki.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kasoze lanini aphinde angene endlini yakhe;","poem":1},{"text":"indawo yakhe kayisayikubuye imazi lanini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ngakho-ke kangizukuthula;","poem":1},{"text":"ngizakhuluma ubuhlungu obusemoyeni wami,","poem":2},{"lineBreak":true},{"text":"ngizasola ngokudabuka komphefumulo wami.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngilulwandle yini, kumbe ngiyisilo semanzini","poem":1},{"text":"okungaze lihlale lingilindile?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngithi lapho ngicabanga ukuthi umbheda wami uzangiduduza","poem":1},{"text":"lecansi lami liphungule ukusola kwami,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"lakhona lapho liyangethusa ngamaphupho","poem":1},{"text":"njalo lingethusele ngemibono,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"okwenza ngiqome ukuklinywa lokufa,","poem":1},{"text":"kulalo umzimba wami.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngiyayeyisa impilo yami; kangiloyisi ukuphila okwaphakade.","poem":1},{"text":"Ngiyekelani; insuku zami kazisatsho lutho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Umuntu uyini ongaze uzihluphe kangaka ngaye,","poem":1},{"text":"ungaze umnake kangaka,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"uze umhlole ekuseni insuku zonke","poem":1},{"text":"njalo umlinge imizuzwana yonke na?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kawusoze uke ukhangele eceleni kwami na,","poem":1},{"text":"loba uke ungixekele okomzuzwana yini?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Aluba ngenze isono, kuyini engikwenzileyo kuwe,","poem":1},{"text":"wena mlindi wabantu?","poem":2},{"text":"Kungani ukhethe ukuhlukuluza mina na?","poem":1},{"text":"Sengingumthwalo kuwe na?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kungani ungaxoleli iziphambeko zami na,","poem":1},{"text":"uthethelele izono zami?","poem":2},{"text":"Ngoba kakusekhatshana ukuthi ngilale othulini;","poem":1},{"text":"uzangidinga, kanti ngizabe ngingasekho.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}