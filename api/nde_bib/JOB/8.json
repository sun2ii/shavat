{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":8,"content":[{"type":"heading","content":["Inkulumo KaBhilidadi"]},{"type":"verse","number":1,"content":["UBhilidadi umShuhi wasephendula wathi:"]},{"type":"verse","number":2,"content":[{"text":"“Koze kube nini ukhuluma izinto ezinjalo?","poem":1},{"text":"Amazwi akho angumoya ophenquzayo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kambe uNkulunkulu uyakuhlanekela ukulunga na?","poem":1},{"text":"Kambe uSomandla uyakuhlanekela okuhle na?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lapho abantwabakho besona kuye,","poem":1},{"text":"wabapha isijeziso sokona kwabo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kanti nxa wena uzakhangela kuNkulunkulu","poem":1},{"text":"uncenge kuSomandla,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"nxa umsulwa ulungile,","poem":1},{"text":"lamanje nje uzaphakama akusize","poem":2},{"lineBreak":true},{"text":"akubuyisele esimeni sakho.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lapho owaqalisa khona kuzakhanya sekukuncinyane,","poem":1},{"text":"ngoba ngezinsuku ezizayo uzabe usuphumelela kakhulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Buza izizukulwane ezingaphambili","poem":1},{"text":"udinge ukuthi okhokho babo bafundani,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ngoba thina sizelwe izolo nje, kasazi lutho,","poem":1},{"text":"lezinsuku zethu emhlabeni zilithunzi kuphela.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kambe kaziyikukulaya zikutshele na?","poem":1},{"text":"Kaziyikuletha amazwi okuzwisisa na?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Konje imihlanga ingakhula ibe mide ingekho exhaphozini na?","poem":1},{"text":"Imizi ingaphila kungelamanzi na?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nxa leyonqodi isakhula ingakaqunywa","poem":1},{"text":"imane ibune masinyane kulotshani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sinjalo isiphetho sabo bonke abakhohlwa uNkulunkulu;","poem":1},{"text":"litshabalala kanjalo ithemba lalowo ongakholwayo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Lokho akuthembayo kufohlozeka lula;","poem":1},{"text":"lokho eyeme kukho yibulembu besayobe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Uyeyama kulobubulembu bakhe, kodwa bubhidlike;","poem":1},{"text":"uyabambelela kubo, kodwa bukhithike.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Unjengesihlahla esithelelwa kakhulu sikhula elangeni,","poem":1},{"text":"esisabalalisa ingatsha zaso esivandeni;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"sinxibanise impande zaso enqunjini yamatshe,","poem":1},{"text":"sizama ukuzuza ukugxila kuhle ematsheni.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kodwa singasitshulwa kuleyondawo,","poem":1},{"text":"leyondawo isisilandula ithi, ‘Angikaze ngikubone.’","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ngeqiniso impilo yaso iyabuna,","poem":1},{"text":"ezinye izihlahla zibe zilokhu zikhula emhlabathini lowo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ngeqiniso uNkulunkulu kamlahli umuntu ongelasici","poem":1},{"text":"futhi kaqinisi izandla zezigangi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Usazogcwalisa umlomo wakho ngohleko","poem":1},{"text":"lezindebe zakho ngokumemeza ngentokozo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Izitha zakho zizakwembathiswa ngehlazo,","poem":1},{"text":"lamathente ababi azatshabalala.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}