{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOB","translationId":"nde_bib","name":"UJobe","commonName":"UJobe","title":"UJobe","order":18,"numberOfChapters":42,"sha256":"de82379ba726f1d564ae13bd50695b9c25a118c7b4a3261039946d54b7189683","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/nde_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":9,"content":[{"type":"heading","content":["Impendulo KaJobe"]},{"type":"verse","number":1,"content":["Wasephendula uJobe wathi:"]},{"type":"verse","number":2,"content":[{"text":"“Ngeqiniso ngiyazi ukuthi lokhu kuliqiniso.","poem":1},{"text":"Kodwa umuntu wenyama angalunga yini kuNkulunkulu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Loba umuntu ubengafisa ukuphikisana laye","poem":1},{"text":"ngeke amphendule lakanye emibuzweni eyinkulungwane.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ukuhlakanipha kwakhe kujulile, amandla akhe makhulu.","poem":1},{"text":"Ngubani kambe oke wamelana laye wasinda?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Uyazidudula izintaba zona zingazi lutho,","poem":1},{"text":"azigenqule nxa esezondile.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Uyawunyikinya umhlaba endaweni yawo,","poem":1},{"text":"axukuxe izinsika zawo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Uyalitshela ilanga ukuba lingakhanyi;","poem":1},{"text":"asibekele ukukhanya kwezinkanyezi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nguye kuphela owelula amazulu,","poem":1},{"text":"ohamba phezu kwamagagasi olwandle.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"UnguMenzi wezinkanyezi iNgulube leZinja,","poem":1},{"text":"iSilimela lomthala waseningizimu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wenza imimangaliso engafinyelelekiyo,","poem":1},{"text":"izimanga ezingelakubalwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Uthi nxa esedlula kimi, ngingamboni;","poem":1},{"text":"ahambe khonapho ngingezwa lutho.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nxa ehluthuna, ngubani ongamalela?","poem":1},{"text":"Ngubani ongathi kuye, ‘Wenzani wena?’","poem":2}]},{"type":"verse","number":13,"content":[{"text":"UNkulunkulu kalunqandi ulaka lwakhe;","poem":1},{"text":"labasekeli bakaRahabi besaba bawela ezinyaweni zakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Pho mina ngingaphikisana laye njani?","poem":1},{"text":"Ngingawathatha ngaphi amazwi okujijana laye?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Laloba ngingelamlandu, ngeke ngimphendule;","poem":1},{"text":"ngingancenga uMahluleli wami kuphela ukuthi angihawukele.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Lanxa bengingambiza asabele,","poem":1},{"text":"angikholwa ukuthi ubengangilalela.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ubengangicobodisa ngesiphepho","poem":1},{"text":"andise amanxeba ami kungelasizatho.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ubengasoze angiphe ithuba lokukhokha umoya","poem":1},{"text":"kodwa ubezahle angincindezele ngosizi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nxa kungokwamandla, alamandla amakhulu!","poem":1},{"text":"Nxa kungokokwahlulela ngokulunga, ngubani ongamthonisisa?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Loba ngingabe ngimsulwa, umlomo wami ubungangilahla;","poem":1},{"text":"lanxa ngimsulwa wona ubuzakuthi ngilecala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Lanxa ngingelacala,","poem":1},{"text":"angizihluphi ngami;","poem":2},{"lineBreak":true},{"text":"ngiyayeyisa impilo yami.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kuyafanana konke; yikho ngisithi,","poem":1},{"text":"‘Ubhubhisa bonke abangelacala lababi.’","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nxa isifo esibi sibulala ngokuphangisa,","poem":1},{"text":"uyabahleka abangelacala ngokulahla kwabo ithemba.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nxa ilizwe liwela ezandleni zababi,","poem":1},{"text":"wembesa amehlo abahluleli balo.","poem":2},{"lineBreak":true},{"text":"Nxa kungayisuye, pho ngubani?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Amalanga ami alesiqubu esidlula esesithunywa;","poem":1},{"text":"ayaphapha anyamalale kungela mthonselanyana wokuthokoza.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Antweza edlule njengezikepe zelala,","poem":1},{"text":"njengenkozi zisehla zihwitha ezikudlayo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nxa ngingathi, ‘Ngizakubeka eceleni ukusola kwami,","poem":1},{"text":"ngicitshe ukunyukubala kwami, ngibobotheke,’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ngilokhu ngihemahema ngezinhlupho zami,","poem":1},{"text":"ngoba ngiyazi ukuthi kawuzukungigeza.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Njengoba ngivele sengibekwe icala,","poem":1},{"text":"ngizazihluphelani ngokulwela ize na?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Loba ngingaze ngigeze ngesepa","poem":1},{"text":"lezandla zami ngesoda yokuhlambulula,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"uzavele ungiphosele emgodini olodaka","poem":1},{"text":"ngize ngenyanywe yizigqoko zami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Akasumuntu njengami ukuthi ngingamphendula,","poem":1},{"text":"ukuthi singamisana emthethwandaba.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Aluba ubengabakhona osilamulayo,","poem":1},{"text":"abeke isandla sakhe phezu kwethu sobabili,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"omunye nje ongasusa uswazi lukaNkulunkulu kimi,","poem":1},{"text":"ukuze ngingatshukunyiswa yikwesaba lokhu.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Lapho-ke bengizakhuluma ngingesabi yena,","poem":1},{"text":"kodwa okwakhathesi kunje, ngeke.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}