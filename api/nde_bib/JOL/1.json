{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOL","translationId":"nde_bib","name":"UJoweli","commonName":"UJoweli","title":"UJoweli","order":29,"numberOfChapters":3,"sha256":"0964432e2ed2a51be56986c249a50d3916af125fd906c1fbac29efcc53888074","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nde_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Ilizwi likaThixo lafika kuJoweli indodana kaPhethuweli."]},{"type":"line_break"},{"type":"heading","content":["Ukuhlasela Kwesikhongwane"]},{"type":"verse","number":2,"content":[{"text":"Zwanini lokhu, lina badala;","poem":1},{"text":"lalelani lonke lina elihlala elizweni.","poem":2},{"text":"Into enjengale seyake yenzakala na ensukwini zenu","poem":1},{"text":"loba ensukwini zabokhokho benu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kutsheleni abantwabenu,","poem":1},{"text":"abantwabenu labo batshele ababantwababo,","poem":2},{"lineBreak":true},{"text":"abantwababo batshele isizukulwane esilandelayo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lokho okutshiywe ngumtshitshi wezintethe","poem":1},{"text":"kudliwe yisikhongwane;","poem":2},{"text":"okutshiywe yisikhongwane","poem":1},{"text":"kudliwe yibuyane;","poem":2},{"text":"okutshiywe yibuyane","poem":1},{"text":"kudliwe ngezinye intethe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vukani lina zidakwa likhale!","poem":1},{"text":"Lilani lonke lina banathi bewayini;","poem":2},{"text":"lilani ngenxa yewayini elitsha,","poem":1},{"text":"ngoba lihluthunwe ezindebeni zenu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isizwe sihlasele ilizwe lami,","poem":1},{"text":"silamandla asingeke sibalwe,","poem":2},{"text":"silamazinyo esilwane,","poem":1},{"text":"ingavula zesilwanekazi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sesitshabalalise izivini zami,","poem":1},{"text":"saqothula lezihlahla zami zemikhiwa.","poem":2},{"text":"Sebule amaxolo azo","poem":1},{"text":"sawaphosela khatshana,","poem":2},{"lineBreak":true},{"text":"ingatsha zazo zasala sezimhlophe nke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lilani njengentombi egqoke isaka","poem":1},{"text":"idabukele umyeni wobutsha bayo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Umnikelo wamabele lomnikelo wokunathwa","poem":1},{"text":"kususiwe endlini kaThixo.","poem":2},{"text":"Abaphristi bayalila,","poem":1},{"text":"bona abakhonzayo phambi kukaThixo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Amasimu atshabalele,","poem":1},{"text":"umhlabathi womile;","poem":2},{"text":"amabele onakele,","poem":1},{"text":"iwayini elitsha liphelile,","poem":2},{"lineBreak":true},{"text":"amafutha kawasekho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Delani, lina balimi,","poem":1},{"text":"lilani, lina balimi bamavini;","poem":2},{"text":"bubulelani ingqoloyi lebhali,","poem":1},{"text":"ngoba isivuno sensimu sitshabalalisiwe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ivini lomile","poem":1},{"text":"lomkhiwa ubunile;","poem":2},{"text":"iphomegranathi, lelala lesihlahla sama-aphula,","poem":1},{"text":"zonke izihlahla zeganga, zomile.","poem":2},{"text":"Impela ukuthokoza kwabantu","poem":1},{"text":"kuphelile.","poem":2}]},{"type":"heading","content":["Isimemezelo Sokuphenduka"]},{"type":"verse","number":13,"content":[{"text":"Vunulani amasaka, lina baphristi, likhale.","poem":1},{"text":"Lilani lina elikhonzayo phambi kwe-alithari.","poem":2},{"text":"Wozani, lilale lembethe amasaka ebusuku,","poem":1},{"text":"lina elikhonzayo phambi kukaNkulunkulu wami,","poem":2},{"text":"ngoba iminikelo yamabele leminikelo yokunathwayo igodliwe,","poem":1},{"text":"kayanikelwa endlini kaNkulunkulu wenu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Memezelani ukuzila okungcwele;","poem":1},{"text":"bizani ibandla elingcwele.","poem":2},{"text":"Memani abadala","poem":1},{"text":"labo bonke abahlala elizweni,","poem":2},{"text":"baye endlini kaThixo uNkulunkulu wenu,","poem":1},{"text":"likhale kuThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Maye ngalolosuku!","poem":1},{"text":"Ngoba usuku lukaThixo seluseduze;","poem":2},{"lineBreak":true},{"text":"luzafika njengencithakalo evela kuSomandla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ukudla akuzange kuphele","poem":1},{"text":"phambi kwamehlo ethu,","poem":2},{"text":"lokuthokoza kanye lokuthaba","poem":1},{"text":"endlini kaNkulunkulu wethu na?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Inhlanyelo itshwabhene","poem":1},{"text":"ngaphansi kwamagade.","poem":2},{"text":"Izindlu zamabele zingamanxiwa,","poem":1},{"text":"iziphala zidiliziwe,","poem":2},{"lineBreak":true},{"text":"ngoba amabele kawasekho.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yeka ukukhala kwezinkomo!","poem":1},{"text":"Imihlambi yenkomo iyaphithizela","poem":2},{"text":"ngoba kayilamadlelo;","poem":1},{"text":"lemihlambi yezimvu iyahlupheka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ngiyakhala kuwe Thixo,","poem":1},{"text":"ngoba umlilo usuqede amadlelo","poem":2},{"lineBreak":true},{"text":"lamalangabi asetshise zonke izihlahla zeganga.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Lezinyamazana zeganga zifuna wena;","poem":1},{"text":"izifula zamanzi sezicitshile njalo","poem":2},{"lineBreak":true},{"text":"lomlilo usuqede amadlelo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}