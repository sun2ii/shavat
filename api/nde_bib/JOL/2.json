{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOL","translationId":"nde_bib","name":"UJoweli","commonName":"UJoweli","title":"UJoweli","order":29,"numberOfChapters":3,"sha256":"0964432e2ed2a51be56986c249a50d3916af125fd906c1fbac29efcc53888074","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nde_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["Umtshitshi Wentethe"]},{"type":"verse","number":1,"content":[{"text":"Vuthelani icilongo eZiyoni;","poem":1},{"text":"hlabani umkhosi entabeni yami engcwele.","poem":2},{"lineBreak":true},{"text":"Bonke abahlala elizweni kabathuthumele,","poem":1},{"text":"ngoba usuku lukaThixo luyeza.","poem":2},{"text":"Selusondele, selufikile,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"usuku lomnyama lokudana,","poem":2},{"lineBreak":true},{"text":"usuku lwamayezi lobumnyama.","poem":2},{"text":"Njengokusa kusendlaleka phezu kwezintaba,","poem":1},{"text":"liyeza ibutho elikhulu elilamandla","poem":2},{"text":"elingazange libe khona endulo","poem":1},{"text":"kumbe libe khona eminyakeni ezayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Phambi kwabo umlilo uyatshisa,","poem":1},{"text":"ngemva kwabo amalangabi ayavutha.","poem":2},{"text":"Phambi kwabo ilizwe linjengensimu yase-Edeni","poem":1},{"text":"ngemva kwabo yinkangala elugwadule,","poem":2},{"lineBreak":true},{"text":"akukho okubaphunyukayo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bakhangeleka benjengamabhiza;","poem":1},{"text":"bamatha njengamabhiza empi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngomsindo onjengowezinqola zempi,","poem":1},{"text":"beqa phezu kwezingqongo zezintaba,","poem":2},{"text":"njengamabibi omlilo etshisa inhlanga,","poem":1},{"text":"njengebutho elilamandla selilungele impi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ekubaboneni nje, izizwe zizwa ubuhlungu;","poem":1},{"text":"ubuso bonke buyadana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bahlasela njengamaqhawe;","poem":1},{"text":"bakhwele imiduli njengamabutho.","poem":2},{"text":"Bonke bahamba beludwendwe","poem":1},{"text":"bengaphambuki endleleni yabo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kabasunduzani;","poem":1},{"text":"lowo lalowo uhamba eqonde phambili.","poem":2},{"text":"Badabula phakathi kwezivikelo","poem":1},{"text":"kungekho kwehlukana kubo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Baya ngesiqubu edolobheni;","poem":1},{"text":"bagijima besekele umduli.","poem":2},{"text":"Bayakhwela bangene ezindlini;","poem":1},{"text":"bangena ngamawindi njengamasela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Umhlaba uyanyikinyeka phambi kwabo;","poem":1},{"text":"umkhathi uyaqhaqhazela,","poem":2},{"text":"ilanga lenyanga kube mnyama,","poem":1},{"text":"lezinkanyezi kazisakhanyisi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"UThixo uyakhwaza","poem":1},{"text":"phambi kwebutho lakhe;","poem":2},{"text":"amabutho akhe angeke abalwe,","poem":1},{"text":"njalo balamandla labo abalalela ukulaya kwakhe.","poem":2},{"text":"Usuku lukaThixo lukhulu;","poem":1},{"text":"luyesabeka.","poem":2},{"lineBreak":true},{"text":"Ngubani ongalumela na?","poem":2}]},{"type":"heading","content":["Guqulani Inhliziyo Zenu"]},{"type":"verse","number":12,"content":[{"text":"“Lakhathesi,” kutsho uThixo,","poem":1},{"text":"“phendukelani kimi ngenhliziyo zenu zonke,","poem":2},{"lineBreak":true},{"text":"ngokuzila langokukhala lokulila.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dabulani inhliziyo zenu","poem":1},{"text":"hatshi izigqoko zenu.","poem":2},{"text":"Buyelani kuThixo uNkulunkulu wenu,","poem":1},{"text":"ngoba ulomusa lesihawu,","poem":2},{"text":"uyaphuza ukuthukuthela, ulothando olukhulu,","poem":1},{"text":"njalo uyaxola ukuthumela umonakalo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngubani owaziyo? Engxenye angaphenduka abe lesihawu","poem":1},{"text":"atshiye isibusiso,","poem":2},{"text":"iminikelo yamabele leminikelo yokunathwayo","poem":1},{"text":"kaThixo uNkulunkulu wenu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Vuthelani icilongo eZiyoni,","poem":1},{"text":"memezelani ukuzila okungcwele,","poem":2},{"lineBreak":true},{"text":"bizani ibandla elingcwele.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Buthanisani abantu,","poem":1},{"text":"ngcwelisani ibandla;","poem":2},{"text":"hlanganisani abadala,","poem":1},{"text":"buthanisani abantwana","poem":2},{"lineBreak":true},{"text":"labo abamunyayo.","poem":2},{"text":"Umyeni katshiye indlu yakhe","poem":1},{"text":"lomlobokazi atshiye ikamelo lakhe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abaphristi abakhonzayo phambi kukaThixo,","poem":1},{"text":"kabakhale bephakathi laphakathi kwentuba le-alithari.","poem":2},{"text":"Kabathi, “Awu Thixo, zwela abantu bakho.","poem":1},{"text":"Ungenzi ilifa lakho libe yinto yokuhlekwa,","poem":2},{"lineBreak":true},{"text":"isiga phakathi kwezizwe.","poem":2},{"text":"Kungani phakathi kwezizwe kumele bathi,","poem":1},{"text":"‘Ungaphi uNkulunkulu wabo?’ ”","poem":2}]},{"type":"heading","content":["Impendulo KaThixo"]},{"type":"verse","number":18,"content":[{"text":"Lapho-ke uThixo uzakuba lobukhwele ngelizwe lakhe","poem":1},{"text":"abe lesihawu ebantwini bakhe.","poem":2}]},{"type":"verse","number":19,"content":["UThixo uzabaphendula athi:",{"text":"“Ngiyalithumela amabele lewayini elitsha lamafutha,","poem":1},{"text":"okwaneleyo ukulisuthisa ngokugcweleyo;","poem":2},{"text":"angiyikuphinda futhi ukulenza","poem":1},{"text":"into yokuhlekisa ezizweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ibutho lasenyakatho ngizalixotshela khatshana lani,","poem":1},{"text":"ngilifuqele elizweni elomileyo elilugwadule,","poem":2},{"text":"amaviyo alo aphambili esiya olwandle lwasempumalanga","poem":1},{"text":"lawo angemuva esiya olwandle lwasentshonalanga.","poem":2},{"text":"Iphunga lalo elibi lizakuya phezulu,","poem":1},{"text":"umnuko walo uzaphakama.”","poem":2},{"lineBreak":true},{"text":"Ngempela wenze izinto ezinkulu ezimangalisayo.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Ungesabi, wena lizwe;","poem":2},{"lineBreak":true},{"text":"thaba uthokoze.","poem":2},{"text":"Impela uThixo wenze izinto ezinkulu.","poem":1}]},{"type":"verse","number":22,"content":[{"text":"Lingesabi, lina zinyamazana zeganga,","poem":2},{"lineBreak":true},{"text":"ngoba amadlelo asesiba luhlaza.","poem":2},{"text":"Izihlahla sezithela izithelo zazo;","poem":1},{"text":"imikhiwa lemivini kuthela kakhulu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Thabani, lina bantu baseZiyoni,","poem":1},{"text":"thokozani kuThixo uNkulunkulu wenu","poem":2},{"text":"ngoba ulinike izulu lekwindla","poem":1},{"text":"ngokulunga.","poem":2},{"text":"Ulilethela izulu elinengi","poem":1},{"text":"kanye lezulu lekwindla lelentwasa, njengakuqala.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Iziza zizagcwala amabele;","poem":1},{"text":"izikhamelo zizaphuphuma iwayini lamafutha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Ngizalihlawula okwaleyo minyaka lokho okwadliwa zintethe,","poem":1},{"text":"lesikhonyane lobuyane,","poem":2},{"lineBreak":true},{"text":"ezinye izintethe kanye lemitshitshi yezintethe,","poem":2},{"text":"ibutho lami elikhulu engalithumela kini.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Lizakuba lokudla okunengi lize lisuthe,","poem":1},{"text":"njalo lizadumisa ibizo likaThixo uNkulunkulu wenu,","poem":2},{"lineBreak":true},{"text":"olenzele izimangaliso;","poem":2},{"text":"abantu bami kabayikuphinda bayangeke futhi.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ngakho lizakwazi ukuthi ngiko-Israyeli,","poem":1},{"text":"lokuthi mina nginguThixo uNkulunkulu wenu,","poem":2},{"lineBreak":true},{"text":"kanye lokuthi kakho omunye;","poem":2},{"text":"abantu bami kabayikuphinda bayangeke futhi.”","poem":1}]},{"type":"heading","content":["Usuku LukaThixo"]},{"type":"verse","number":28,"content":[{"text":"“Emva kwalokho,","poem":1},{"text":"ngizathululela uMoya wami kubo bonke abantu.","poem":2},{"text":"Amadodana lamadodakazi enu azaphrofitha,","poem":1},{"text":"izinsizwa zenu zizabona imibono,","poem":2},{"lineBreak":true},{"text":"lamaxhegu enu azaphupha amaphupho.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Lasezincekwini zami, ezesilisa lezesifazane,","poem":1},{"text":"ngizawuthulula uMoya wami ngalezonsuku.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ngizabonakalisa izimangaliso emazulwini","poem":1},{"text":"lasemhlabeni,","poem":2},{"lineBreak":true},{"text":"igazi lomlilo lezikhatha zentuthu.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ilanga lizaphendulwa libe yibumnyama","poem":1},{"text":"lenyanga ibeligazi","poem":2},{"lineBreak":true},{"text":"phambi kokuba kufike","poem":2},{"lineBreak":true},{"text":"usuku olukhulu lukaThixo, olwesabekayo.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Njalo wonke obiza","poem":1},{"text":"ibizo likaThixo uzasindiswa;","poem":2},{"text":"ngoba eNtabeni iZiyoni laseJerusalema","poem":1},{"text":"kuzakuba lokukhululwa,","poem":2},{"lineBreak":true},{"text":"njengoba uThixo etshilo,","poem":2},{"text":"iloba phakathi kwabasindileyo","poem":1},{"text":"labo ababizwa nguThixo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}