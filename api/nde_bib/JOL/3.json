{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JOL","translationId":"nde_bib","name":"UJoweli","commonName":"UJoweli","title":"UJoweli","order":29,"numberOfChapters":3,"sha256":"0964432e2ed2a51be56986c249a50d3916af125fd906c1fbac29efcc53888074","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nde_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["Izizwe Ziyahlulelwa"]},{"type":"verse","number":1,"content":[{"text":"“Ngalezonsuku langalesosikhathi,","poem":1},{"text":"lapho sengibuyisela inotho kaJuda leJerusalema,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ngizaqoqa izizwe zonke","poem":1},{"text":"ngizehlisele eSigodini sikaJehoshafathi.","poem":2},{"text":"Lapho-ke ngizazahlulela","poem":1},{"text":"mayelana lelifa lami, abantu bami u-Israyeli","poem":2},{"text":"ngoba zahlakazela abantu bami phakathi kwezizwe,","poem":1},{"text":"zabelana ilizwe lami.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Zenza inkatho ngabantu bami,","poem":1},{"text":"zathenga izifebe ngabafana;","poem":2},{"lineBreak":true},{"text":"zathengisa amankazana ngewayini ukuze zinathe.","poem":2}]},{"type":"verse","number":4,"content":["Manje-ke lisolani ngami, wena Thire loSidoni lani lonke zifunda zaseFilistiya? Liyangiphindisela ngolutho engilwenzileyo na? Nxa lingiphindisela, ngizaphanga ngibuyisele elakwenzayo phezu kwamakhanda enu ngokuphangisa."]},{"type":"verse","number":5,"content":["Ngoba lathatha isiliva sami legolide lami lathwalela lenotho yami eligugu emathempelini enu."]},{"type":"verse","number":6,"content":["Lathengisa abantu bakoJuda laseJerusalema kumaGrikhi, ukuze libase khatshana lelizwe labo."]},{"type":"verse","number":7,"content":["Khangelani, ngizabavusa ezindaweni elabathengisa kuzo, njalo ngizabuyisela phezu kwamakhanda enu lokho elakwenzayo."]},{"type":"verse","number":8,"content":["Ngizathengisa amadodana enu lamadodakazi enu ebantwini bakoJuda, njalo labo bazawathengisa kumaSabhini, isizwe esikhatshana.” UThixo usekhulumile."]},{"type":"verse","number":9,"content":[{"text":"Memezelani lokhu ezizweni lithi:","poem":1},{"text":"Lungiselani impi!","poem":2},{"text":"Vusani amabutho!","poem":1},{"text":"Wonke amadoda empi kasondele ahlasele.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Khandani amakhuba enu abe zinkemba","poem":1},{"text":"lemihedla yenu yokuthena izihlahla ibe yimikhonto.","poem":2},{"text":"Obuthakathaka kathi,","poem":1},{"text":"“Ngiqinile!”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wozani ngokuphangisa, lonke lina zizwe zasezinhlangothini zonke,","poem":1},{"text":"libuthane khonapho.","poem":2},{"lineBreak":true},{"text":"Yehlisa amabutho akho, Oh Thixo!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Izizwe kazivuswe;","poem":1},{"text":"kaziye eSigodini sikaJehoshafathi","poem":2},{"text":"ngoba ngizahlala khona","poem":1},{"text":"ukwehlulela izizwe zonke zasezinhlangothini zonke.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hehethani ngesikela","poem":1},{"text":"ngoba okuvunwayo sekuvuthiwe.","poem":2},{"text":"Wozani, gxobani amavini,","poem":1},{"text":"ngoba isikhamelo sewayini sesigcwele","poem":2},{"lineBreak":true},{"text":"lezimbizakazi seziphuphuma,","poem":2},{"text":"bukhulu kangaka ububi bazo!","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Amaxuku, amaxuku","poem":1},{"text":"esigodini sesinqumo!","poem":2},{"text":"Ngoba usuku lukaThixo luseduze","poem":1},{"text":"esigodini sezinqumo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ilanga lenyanga kuzakuba mnyama,","poem":1},{"text":"lezinkanyezi zingabe zisakhanya.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"UThixo uzavungama eseZiyoni","poem":1},{"text":"aphinde akhwaze eseJerusalema;","poem":2},{"lineBreak":true},{"text":"umhlaba lomkhathi kuzagedezela.","poem":2},{"text":"Kodwa uThixo uzakuba yisiphephelo sabantu bakhe,","poem":1},{"text":"inqaba yabantu bako-Israyeli.”","poem":2}]},{"type":"heading","content":["Izibusiso Zabantu BakaNkulunkulu"]},{"type":"verse","number":17,"content":[{"text":"“Ngakho lizakwazi ukuthi mina, uThixo uNkulunkulu wenu,","poem":1},{"text":"ngihlala eZiyoni, intaba yami engcwele.","poem":2},{"text":"IJerusalema izakuba ngcwele;","poem":1},{"text":"kayiyikuphinda ihlaselwe ngabezizweni futhi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ngalolosuku izintaba zizagobhoza iwayini elitsha,","poem":1},{"text":"lamaqaqa ageleze uchago;","poem":2},{"lineBreak":true},{"text":"zonke indonga zakoJuda zizageleza amanzi.","poem":2},{"text":"Umthombo uzantuntuza endlini kaThixo","poem":1},{"text":"uthambise isigodi saseShithima.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kodwa iGibhithe izachithakala,","poem":1},{"text":"i-Edomi ibe yinkangala elugwadule,","poem":2},{"text":"ngenxa yodlakela olwenziwa ebantwini bakoJuda","poem":1},{"text":"lapho bachitha khona igazi elingelacala elizweni labo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"KoJuda kuzahlalwa khona kuze kube nininini","poem":1},{"text":"laseJerusalema kuzahlala izizukulwane zonke.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Umlandu wabo wegazi, engingakaxoli ngawo,","poem":1},{"text":"ngizabaxolela ngawo.”","poem":2},{"lineBreak":true},"UThixo uhlala eZiyoni!"]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}