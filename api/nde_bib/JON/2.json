{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"JON","translationId":"nde_bib","name":"UJona","commonName":"UJona","title":"UJona","order":32,"numberOfChapters":4,"sha256":"b910eb5870a4cb21c64adcd57224e602feb4dde33692d3e6cf5ac0db1f13b026","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/nde_bib/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Ephakathi kwenhlanzi uJona wakhuleka kuThixo uNkulunkulu wakhe."]},{"type":"verse","number":2,"content":["Wathi:",{"text":"“Ekuhluphekeni kwami ngambiza uThixo,","poem":1},{"text":"wangiphendula.","poem":2},{"text":"Ngisekujuleni kwengcwaba ngacela uncedo,","poem":1},{"text":"wena wakulalela ukukhala kwami.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wangiphosela ezinzikini,","poem":1},{"text":"phakathi emathunjini enlwandle,","poem":2},{"lineBreak":true},{"text":"amagagasi agubhazela emaceleni wonke;","poem":2},{"text":"wonke amagagasi akho","poem":1},{"text":"lezimpophoma zawo kwangisibekela.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngathi, ‘Sengixotshiwe","poem":1},{"text":"ebusweni bakho;","poem":2},{"text":"kodwa ngizakhangela njalo","poem":1},{"text":"ethempelini lakho elingcwele.’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Indonga zamanzi zaziqonde ukungimbokotha,","poem":1},{"text":"ngangihanqwe yinziki;","poem":2},{"lineBreak":true},{"text":"inkunkuma yotshani bolwandle yangithandela ekhanda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngagalula ngatshona empandeni zezintaba;","poem":1},{"text":"umhlaba ongaphansi wangivalela okwaphakade.","poem":2},{"text":"Kodwa wena wayikhupha impilo yami egodini,","poem":1},{"text":"wena Thixo, Nkulunkulu wami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lapho impilo yami yayisincipha,","poem":1},{"text":"ngakhumbula wena, Thixo,","poem":2},{"text":"umkhuleko wami waphakamela kuwe,","poem":1},{"text":"ethempelini lakho elingcwele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Labo ababambelela ezithombeni","poem":1},{"text":"ezingelamsebenzi balahlekelwa ngumusa ongaba ngowabo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kodwa mina, ngizakuthi ngihlabela ingoma yokubonga","poem":1},{"text":"ngenze umhlatshelo kuwe.","poem":2},{"text":"Engikufungileyo ngizakugcwalisa.","poem":1},{"text":"Insindiso ivela kuThixo.”","poem":2}]},{"type":"verse","number":10,"content":["UThixo walaya inhlanzi, yona yase imhlanza uJona emhlabathini owomileyo."]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}