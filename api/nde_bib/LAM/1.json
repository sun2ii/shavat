{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"LAM","translationId":"nde_bib","name":"Izililo","commonName":"Izililo","title":"Izililo","order":25,"numberOfChapters":5,"sha256":"18d524acc1b8904dfdbd73bc350b89b34cf2a8a14b1a5f55f376050bc087a657","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/nde_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Kuthule kuthe cwaka!","poem":1},{"text":"Yeka lelidolobho elalinyakazela abantu!","poem":2},{"text":"Selinjengomfelokazi,","poem":1},{"text":"kanti lalilodumo phakathi kwezizwe.","poem":2},{"text":"Lona elaliyindlovukazi phakathi kwezigodi,","poem":1},{"text":"khathesi seliyisigqili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Linjengowesifazane okhala kabuhlungu ebusuku,","poem":1},{"text":"inyembezi zithe hlikilili ezihlathini.","poem":2},{"text":"Kakho phakathi kwazo","poem":1},{"text":"zonke izithandwa zakhe ongamduduza.","poem":2},{"text":"Bonke abangane bakhe bamhlamukele;","poem":1},{"text":"sebeyizitha zakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"UJuda useye ebugqilini","poem":1},{"text":"ngemva kokuhlupheka lokudonsa nzima.","poem":2},{"text":"Usehlala phakathi kwabezizwe;","poem":1},{"text":"akatholi ndawo yokuphumula.","poem":2},{"text":"Bonke abamzingelayo bamxhumile","poem":1},{"text":"ephakathi kokuhlupheka kwakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Iyalila imigwaqo eya eZiyoni,","poem":1},{"text":"ngoba kasekho ozayo emikhosini yalo emisiweyo.","poem":2},{"text":"Wonke amasango alo asekhohlakele,","poem":1},{"text":"abaphristi balo bayabubula,","poem":2},{"text":"amantombazana alo ayagomela,","poem":1},{"text":"lona lidabukile kakhulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Izitha zalo sezingababusi balo;","poem":1},{"text":"ziyaklamasa.","poem":2},{"text":"UThixo ulehlisele usizi","poem":1},{"text":"ngenxa yezono zalo ezinengi.","poem":2},{"text":"Abantwabalo bathunjiwe,","poem":1},{"text":"baba yizigqili zezitha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kuphelile konke ukubenyezela","poem":1},{"text":"kweNdodakazi yaseZiyoni.","poem":2},{"text":"Amakhosana ayo asenjengezimpala","poem":1},{"text":"ezingatholi amadlelo;","poem":2},{"text":"zibalekile zilambile zingelamandla","poem":1},{"text":"zibalekela umzingeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ngezinsuku zokuhlupheka lokuntula,","poem":1},{"text":"iJerusalema iyayikhumbula inotho","poem":2},{"lineBreak":true},{"text":"eyayingeyayo ngensuku zayo.","poem":2},{"text":"Kuthe abantu bayo sebewela ezandleni zezitha,","poem":1},{"text":"akubanga khona ongayinceda.","poem":2},{"text":"Zayikhangela nje izitha zayo","poem":1},{"text":"zahleka ukuchitheka kwayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"IJerusalema yonile kakhulu,","poem":1},{"text":"ngakho isingcolile.","poem":2},{"text":"Bonke ababeyihlonipha sebeyidelela,","poem":1},{"text":"ngoba sebebonile ubuze bayo;","poem":2},{"text":"yona ngokwayo ibubula","poem":1},{"text":"ize ifulathele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ukungcola kwayo kwabhixa izidwaba zayo;","poem":1},{"text":"kayinakanga ikusasa yayo.","poem":2},{"text":"Ukuwa kwayo kwesabeka,","poem":1},{"text":"kungekho oyiduduzayo.","poem":2},{"text":"“Oh Thixo, ake ukhangele ukuhlupheka kwami,","poem":1},{"text":"ngoba isitha sesinqobile.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Isitha saphanga","poem":1},{"text":"yonke inotho yayo;","poem":2},{"text":"yabona izizwe ezingakholwayo","poem":1},{"text":"zingena endlini yayo engcwele,","poem":2},{"text":"bona labo owabanqabela","poem":1},{"text":"ukungena phakathi kwebandla lakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bonke abantu bayo bayagomela","poem":1},{"text":"behamba bedinga ukudla;","poem":2},{"text":"bathengisa inotho yabo eligugu ngokudla","poem":1},{"text":"ukuze bangafi.","poem":2},{"text":"“Oh Thixo, ake ungihawukele","poem":1},{"text":"ngoba sengidelelwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Kakusilutho kini yini lina lonke elidlula lapha?","poem":1},{"text":"Ake likhangele nje libone.","poem":2},{"text":"Kambe kukhona ukuhlupheka okulingana lokwami,","poem":1},{"text":"khona lokhu engakwehliselwayo, nguThixo","poem":2},{"lineBreak":true},{"text":"ngosuku lokuvutha kolaka lwakhe?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Wehlisa umlilo uvela phezulu,","poem":1},{"text":"wawehlisela phakathi kwamathambo ami.","poem":2},{"text":"Wangithiya ezinyaweni ngomambule,","poem":1},{"text":"wangibuyisela emuva.","poem":2},{"text":"Wangenza ngaba lesizungu,","poem":1},{"text":"ngaswela amandla ilanga lonke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Izono zami zisongwe zaba lijogwe;","poem":1},{"text":"ngezandla zakhe wazelukela ndawonye.","poem":2},{"text":"Zetheswe entanyeni yami,","poem":1},{"text":"uThixo wangiqeda amandla.","poem":2},{"text":"Usengifuqele kulabo","poem":1},{"text":"engingeke ngimelane labo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"UThixo kabemukelanga","poem":1},{"text":"bonke abangabebutho lami;","poem":2},{"text":"usebize impi ukuthi ingihlasele,","poem":1},{"text":"ichoboze zonke izinsizwa zami.","poem":2},{"text":"Esihluzweni sakhe sewayini, uThixo unyathelele phansi","poem":1},{"text":"iNdodakazi yakoJuda eGcweleyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yikho ngilila,","poem":1},{"text":"amehlo ami empompoza inyembezi.","poem":2},{"text":"Kakho oseduze ongangiduduza,","poem":1},{"text":"kakho ongavusa umphefumulo wami.","poem":2},{"text":"Abantwabami sebeswela","poem":1},{"text":"ngoba isitha sinqobile.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"IZiyoni yelulile isandla sayo","poem":1},{"text":"kodwa kakho oyiduduzayo.","poem":2},{"text":"UThixo usekumisile ngoJakhobe","poem":1},{"text":"ukuthi abakhelene laye babe yizitha zakhe;","poem":2},{"text":"iJerusalema isiphenduke","poem":1},{"text":"yaba yinto engcolileyo kubo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“UThixo ulungile,","poem":1},{"text":"kodwa ngaphikisana lomlayo wakhe.","poem":2},{"text":"Lalelani bantu lonke;","poem":1},{"text":"khangelani ukuhawula kwami.","poem":2},{"text":"Izinsizwa lezintombi zami zonke","poem":1},{"text":"sezaya ekuthunjweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ngakhala kulabo engidlelana labo,","poem":1},{"text":"kodwa banginina.","poem":2},{"text":"Abaphristi bami labadala bami","poem":1},{"text":"babhubhela phakathi kwedolobho","poem":2},{"text":"besadinga ukudla,","poem":1},{"text":"ukuze baziphilise.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ake ubone, Oh Thixo, ukuthi ngihlupheka njani!","poem":1},{"text":"Ngiyatsha ngaphakathi kwami,","poem":2},{"text":"ngidungekile enhliziyweni yami,","poem":1},{"text":"ngoba bengilihlongandlebe.","poem":2},{"text":"Ngaphandle, inkemba iyadabukisa;","poem":1},{"text":"ngaphakathi, yikufa kodwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Abantu bakuzwile ukububula kwami,","poem":1},{"text":"kodwa kakho ongangiduduza.","poem":2},{"text":"Zonke izitha zami zikuzwile ukuhlupheka kwami;","poem":1},{"text":"ziyathokoza ngalokhu okwenzileyo.","poem":2},{"text":"Sengathi ungalufikisa lolusuku owalumisayo,","poem":1},{"text":"ukuze labo babe njengami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Abuvele kuwe bonke ububi babo;","poem":1},{"text":"yenza kubo konke","poem":2},{"text":"okwenzileyo kimi","poem":1},{"text":"ngenxa yezono zami zonke.","poem":2},{"text":"Kunengi ukububula kwami,","poem":1},{"text":"lenhliziyo yami iphela amandla.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}