{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"LAM","translationId":"nde_bib","name":"Izililo","commonName":"Izililo","title":"Izililo","order":25,"numberOfChapters":5,"sha256":"18d524acc1b8904dfdbd73bc350b89b34cf2a8a14b1a5f55f376050bc087a657","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/nde_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"UThixo wembese iNdodakazi yeZiyoni","poem":1},{"text":"ngeyezi lolaka lwakhe!","poem":2},{"text":"Ubutaklazele phansi ubunkanyankanya buka-Israyeli","poem":1},{"text":"busuka ezulwini busiya emhlabeni;","poem":2},{"text":"kasinakanga isenabelo sakhe","poem":1},{"text":"mhla wentukuthelo yakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"UThixo kabanga lozwelo lapho eginya","poem":1},{"text":"yonke imizi kaJakhobe;","poem":2},{"text":"ngolaka lwakhe udilizele phansi","poem":1},{"text":"izinqaba zeNdodakazi kaJuda.","poem":2},{"text":"Usewuchithile umbuso wakhe,","poem":1},{"text":"lababusi bawo wababhuqa phansi, baba lehlazo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngolaka lwakhe olwesabekayo,","poem":1},{"text":"usegumule zonke impondo zika-Israyeli.","poem":2},{"text":"Usegodle isandla sakhe sokunene","poem":1},{"text":"lapho kuqhamuka isitha.","poem":2},{"text":"Utshise koJakhobe njengelangabi","poem":1},{"text":"elihangula konke okuseduze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Usethiye idandili lakhe njengesitha;","poem":1},{"text":"isandla sakhe sokunene sesiqaphile.","poem":2},{"text":"Njengesitha usebabulele bonke","poem":1},{"text":"ababebahle ebusweni;","poem":2},{"text":"usethele ulaka lwakhe olungumlilo","poem":1},{"text":"phezu kwethente leNdodakazi yeZiyoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"UThixo unjengesitha;","poem":1},{"text":"usemginyile u-Israyeli.","poem":2},{"text":"Useziginyile zonke izigodlo zakhe,","poem":1},{"text":"wabhidliza zonke izinqaba zakhe.","poem":2},{"text":"Usekwandisile ukukhala lokulilela","poem":1},{"text":"iNdodakazi kaJuda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Usetshaye wakhukhula umuzi wakhe njengensimu;","poem":1},{"text":"usebhidlize indawo yakhe yokuhlanganela.","poem":2},{"text":"UThixo usenze iZiyoni yakhohlwa","poem":1},{"text":"imikhosi yayo emisiweyo lamaSabatha ayo;","poem":2},{"text":"olakeni lwakhe olwesabekayo,","poem":1},{"text":"ukhukhulele khatshana oyinkosi longumphristi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"UThixo uselikhalele i-alithari lakhe,","poem":1},{"text":"wafulathela indlu yakhe engcwele.","poem":2},{"text":"Usenikele imithangala yezigodlo zakhe","poem":1},{"text":"ezandleni zesitha;","poem":2},{"text":"seziklabalala endlini kaThixo","poem":1},{"text":"sengathi lilanga lomkhosi omisiweyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"UThixo wazimisela ukudilizela phansi","poem":1},{"text":"umthangala ohonqolozele iNdodakazi yeZiyoni.","poem":2},{"text":"Welula intambo yesilinganiso sakhe,","poem":1},{"text":"akaze agodla isandla sakhe esibhidlizayo.","poem":2},{"text":"Wenza izinsika lemithangala kwalila;","poem":1},{"text":"kanyekanye kwatshabalala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Amasango akhe asegqibelekile;","poem":1},{"text":"izinti zawo zephulwe zabhidlizwa.","poem":2},{"text":"Inkosi yayo lamakhosana ayo achithizelwe kwabezizwe,","poem":1},{"text":"umthetho kawusekho,","poem":2},{"text":"labaphrofethi bakhe kabasayamukeli","poem":1},{"text":"imibono evela kuThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Abadala beNdodakazi yeZiyoni","poem":1},{"text":"bahlezi emhlabathini bathule zwi;","poem":2},{"text":"bazithele ngothuli emakhanda abo,","poem":1},{"text":"bazembathisa amasaka.","poem":2},{"text":"Izintombi zeJerusalema","poem":1},{"text":"zimbozele amakhanda azo phansi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Amehlo ami ayehluleka ngokukhala,","poem":1},{"text":"ngiyatsha ngaphakathi kwami,","poem":2},{"text":"inhliziyo yami idabukile,","poem":1},{"text":"ngoba abantu bakithi babhujisiwe,","poem":2},{"text":"njalo abantwana lensane ziyaqaleka","poem":1},{"text":"emigwaqweni yomuzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Zithi kubonina,","poem":1},{"text":"“Singaphi isinkwa lewayini?”","poem":2},{"text":"zilokhu ziqaleka njengamadoda alimeleyo","poem":1},{"text":"emigwaqweni yomuzi,","poem":2},{"text":"ziphela umphefumulo","poem":1},{"text":"ezandleni zabonina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kambe ngingathini kuwe na?","poem":1},{"text":"Ngingakulinganisa lani,","poem":2},{"lineBreak":true},{"text":"wena Ndodakazi yaseJerusalema?","poem":2},{"text":"Kambe ngingakufanisa lani","poem":1},{"text":"ukuze ngikududuze,","poem":2},{"lineBreak":true},{"text":"wena Ndodakazi eGcweleyo yaseZiyoni?","poem":2},{"text":"Inxeba lakho lizike njengolwandle.","poem":1},{"text":"Ngubani ongakwelapha na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Imibono yabaphrofethi bakho","poem":1},{"text":"yayikhohlisa ingasizi lutho;","poem":2},{"text":"kabasivezanga obala isono sakho","poem":1},{"text":"ukuze ungehlelwa yikuthunjwa.","poem":2},{"text":"Ukuvumisa abalenzela khona","poem":1},{"text":"kwakungamanga, kulikhohlisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Bonke abedlula eceleni kwakho","poem":1},{"text":"batshaya izandla ngawe;","poem":2},{"text":"bahleka iNdodakazi yaseJerusalema","poem":1},{"text":"baze banikine amakhanda besithi,","poem":2},{"text":"“Kambe yiwo yini umuzi lo","poem":1},{"text":"owawuthiwa yibuhle obupheleleyo,","poem":2},{"lineBreak":true},{"text":"igugu lomhlaba wonke jikelele?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Zonke izitha zakho zikukhamisele imilomo;","poem":1},{"text":"ziyakuhleka zikugedlela amazinyo","poem":2},{"text":"zisithi, “Sesimnqobile.","poem":1},{"text":"Selize lafika ilanga esasililindele;","poem":2},{"lineBreak":true},{"text":"kade salilindela.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"UThixo usekwenzile ayekuhlosile;","poem":1},{"text":"useligcwalisile ilizwi lakhe,","poem":2},{"lineBreak":true},{"text":"alikhuluma kudala.","poem":2},{"text":"Ukuwisile engakuzweli usizi,","poem":1},{"text":"uvumele isitha santela phezu kwakho,","poem":2},{"lineBreak":true},{"text":"uluphakamisile uphondo lwezitha zakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Inhliziyo zabantu","poem":1},{"text":"ziyakhala eNkosini.","poem":2},{"text":"Awu, mthangala weNdodakazi yaseZiyoni,","poem":1},{"text":"kazigeleze njengomfula inyembezi zakho,","poem":2},{"lineBreak":true},{"text":"ebusuku lemini;","poem":2},{"text":"ungaziphi ikhefu,","poem":1},{"text":"lamehlo akho ungawaphi ukuphumula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Phakama, nqongoloza ebusuku,","poem":1},{"text":"lapho kuqalisa imilindo yebusuku;","poem":2},{"text":"thulula inhliziyo yakho njengamanzi","poem":1},{"text":"phambi kukaThixo.","poem":2},{"text":"Phakamisela izandla zakho kuye,","poem":1},{"text":"uncengela impilo yabantwabakho,","poem":2},{"text":"abaqalekiswa yindlala","poem":1},{"text":"ekuqaliseni kwemigwaqo yonke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ake ukhangele, Thixo, ube lozwelo:","poem":1},{"text":"Ngubani osewake wamphatha kanje?","poem":2},{"text":"Abesifazane badle inzalo yabo yini,","poem":1},{"text":"abantwana ababondlileyo na?","poem":2},{"text":"Umphristi lomphrofethi","poem":1},{"text":"babulawe endlini engcwele kaThixo na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Abatsha labadala babhazalele ndawonye","poem":1},{"text":"ebhuqwini lwemigwaqo;","poem":2},{"text":"izinsizwa zami lezintombi","poem":1},{"text":"zibulewe ngenkemba.","poem":2},{"text":"Ubabulele ngosuku lokuthukuthela kwakho;","poem":1},{"text":"awaze waba lesihawu lapho ubabulala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Njengokunxusela idili,","poem":1},{"text":"wanginxusela izitha inxa zonke.","poem":2},{"text":"Ngosuku lolaka lukaThixo,","poem":1},{"text":"kakho owaphunyukayo loba owasilayo;","poem":2},{"text":"bonke engangibanakekela lengabondlayo","poem":1},{"text":"babulewe yisitha sami.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}