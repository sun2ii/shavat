{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"LAM","translationId":"nde_bib","name":"Izililo","commonName":"Izililo","title":"Izililo","order":25,"numberOfChapters":5,"sha256":"18d524acc1b8904dfdbd73bc350b89b34cf2a8a14b1a5f55f376050bc087a657","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/nde_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Yimi umuntu olubonileyo usizi","poem":1},{"text":"ngenxa yoswazi lokuthukuthela kukaThixo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ungixotshile, wangiphumputhekisa","poem":1},{"text":"emnyameni hatshi ekukhanyeni;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ngempela usengiphakamisele isandla sakhe,","poem":1},{"text":"waphindaphinda ilanga lonke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Usenze ijwabu lami laluphala,","poem":1},{"text":"wangephula amathambo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ungihanqile wangihonqolozela","poem":1},{"text":"ngosizi langobunzima.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ungenze ngahlala emnyameni","poem":1},{"text":"njengalabo abafa kudala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ungihonqolozele ngenqaba ukuze ngingaphunyuki;","poem":1},{"text":"ungibophe nko ngamaketane.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kuthi lanxa ngimemeza loba ngidinga usizo,","poem":1},{"text":"awuvalele phandle umkhuleko wami.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uvale indlela yami ngamatshe;","poem":1},{"text":"waphambukisa izindlela zami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Njengebhele licathamile,","poem":1},{"text":"njengesilwane sicatshile,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"wangihudulela eceleni kwendlela, wangifohloza,","poem":1},{"text":"wangitshiya ngingelamsizi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wadonsa idandili lakhe,","poem":1},{"text":"ngaba yikudla kwemitshoko yakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Wangiciba enhliziyweni","poem":1},{"text":"ngemitshoko evela emxhakeni wakhe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngaba yinhlekisa ebantwini bakithi bonke;","poem":1},{"text":"sengitshona ngiyingoma eyinhlekisa kubo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ungigqibe ngemithi ebabayo,","poem":1},{"text":"wanginathisa inyongo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ungihlafunise ukhethe ngamazinyo;","poem":1},{"text":"wangigiqa ebhuqwini.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngincitshiwe ukuthula;","poem":1},{"text":"angisakwazi ingabe iyini impumelelo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngakho ngithi, “Sebuphelile ubucwazicwazi bami,","poem":1},{"text":"lakho konke engangikulindele kuThixo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ngikhumbula ukuhlupheka lokuntula kwami,","poem":1},{"text":"ubumunyu lenyongo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Konke ngikukhumbula kamhlophe,","poem":1},{"text":"umoya wami wephukile.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kodwa ngikhumbula lokhu","poem":1},{"text":"ngibe lethemba:","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ngenxa yothando olukhulu lukaThixo kasibhujiswanga,","poem":1},{"text":"ngoba isihawu sakhe kasipheli.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Siba sitsha ukusa kwamalanga;","poem":1},{"text":"kukhulu ukuthembeka kwakho.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ngiyazitshela ngithi, “UThixo uyisabelo sami;","poem":1},{"text":"ngakho ngizalindela yena.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"UThixo ulungile kulowo omethembayo,","poem":1},{"text":"kulowo omdingayo;","poem":2}]},{"type":"verse","number":26,"content":[{"text":"kuhle ukulinda ngokuthula,","poem":1},{"text":"ukulindela insindiso kaThixo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kuhle ukuthi umuntu alithwale ijogwe","poem":1},{"text":"ngesikhathi esesemutsha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Kahlale yedwa ngokuthula,","poem":1},{"text":"ngoba uThixo ulibeke phezu kwakhe.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kembele ubuso bakhe ethulini,","poem":1},{"text":"mhlawumbe ithemba lizakuba khona.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kaphe isihlathi sakhe kulowo ofuna ukumhlankala,","poem":1},{"text":"agcwale ihlazo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ngoba uThixo kabalahli abantu","poem":1},{"text":"kuze kube nini lanini.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Loba engaletha ubuhlungu, uzatshengisa uzwelo,","poem":1},{"text":"lukhulu kakhulu uthando lwakhe olungapheliyo.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ngoba kehliseli ukuhlupheka","poem":1},{"text":"losizi ebantwini ngokuthanda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Ukuhlifiza ngezinyawo","poem":1},{"text":"zonke izibotshwa elizweni,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ukuncitsha umuntu amalungelo akhe","poem":1},{"text":"phambi koPhezukonke,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ukungahluleli kuhle,","poem":1},{"text":"kambe uThixo uyabe engaziboni izinto ezinjalo na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Ngubani ongatsho ulutho lwenzakale","poem":1},{"text":"nxa lungavunyelwanga nguThixo na?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Akuveli emlonyeni woPhezukonke","poem":1},{"text":"ukuthi kuyehla inhlupheko lezinto ezinhle na?","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Pho kungani umuntu ophilayo esola","poem":1},{"text":"nxa ejeziselwa izono zakhe na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Kasilingeni njalo sihlole izindlela zethu,","poem":1},{"text":"sibuyele kuThixo.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Asiphakamiseleni inhliziyo lezandla zethu","poem":1},{"text":"kuNkulunkulu ezulwini sithi:","poem":2}]},{"type":"verse","number":42,"content":[{"text":"“Sonile sahlamuka,","poem":1},{"text":"njalo kawusithethelelanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Uzigubuzele ngolaka waxhumana lathi;","poem":1},{"text":"ubhubhisile ungelazwelo.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Uzisibekele ngeyezi","poem":1},{"text":"ukuze kungafinyeleli mkhuleko kuwe.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Usenze saba ngamanyala lengcekeza","poem":1},{"text":"phakathi kwezizwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"Izitha zethu zonke zivule imilomo yazo","poem":1},{"text":"zezwakala zisihoza.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Sesihlukuluzwe yikuthuthumela lokukhilikithela,","poem":1},{"text":"ukudilika lokubhidlika.”","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Imifula yezinyembezi iyajuluka emehlweni ami","poem":1},{"text":"ngoba abantu bakithi babhujisiwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Amehlo ami azajuluka kokuphela,","poem":1},{"text":"engelakuphumula,","poem":2}]},{"type":"verse","number":50,"content":[{"text":"UThixo aze akhangele phansi","poem":1},{"text":"esezulwini, angibone.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Engikubonayo kuthelela usizi emphefumulweni wami","poem":1},{"text":"ngenxa yabesifazane bonke bomuzi wakithi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Labo ababa yizitha zami kungelasizatho,","poem":1},{"text":"bangizingela njengenyoni.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Bazama ukuquma impilo yami emgodini","poem":1},{"text":"bangijikijela ngamatshe;","poem":2}]},{"type":"verse","number":54,"content":[{"text":"amanzi asibekela ikhanda lami,","poem":1},{"text":"ngabona ukuthi okwami sekuphelile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"Ngalimemezela ibizo lakho, Oh Thixo,","poem":1},{"text":"ngisekujuleni komgodi.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Wezwa ukuncenga kwami: “Ungavali indlebe zakho","poem":1},{"text":"nxa ngikhalela ukwenyulwa.”","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Wasondela lapho ngikumemeza,","poem":1},{"text":"wathi kimi, “Ungesabi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"Oh Thixo, wasamukela isikhalazo sami;","poem":1},{"text":"wahlenga ukuphila kwami.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Ububonile Thixo, ububi obenziwe kimi.","poem":1},{"text":"Ngisekela kulobubunzima!","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Usubonile ukujula kokusonga kwabo,","poem":1},{"text":"lamacebo abo wonke ngami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"Awu Thixo, uzwile inhlamba zabo,","poem":1},{"text":"wonke amacebo abo ngami,","poem":2}]},{"type":"verse","number":62,"content":[{"text":"ukunyenyeza lokungunguna kwabo ngami","poem":1},{"text":"ukusa kwamalanga.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Ake ubabone! Bahlezi kumbe bajamile,","poem":1},{"text":"bayangihleka ngezingoma zabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"Awu Thixo, akubaphindisele ngokubafaneleyo,","poem":1},{"text":"ngalokho okwenziwe yizandla zabo.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Basibekele ngelembu ezinhliziyweni zabo,","poem":1},{"text":"isiqalekiso sakho sehlele phezu kwabo!","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Xhumana labo ngolaka, ubabhubhise","poem":1},{"text":"ngaphansi kwamazulu kaThixo.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}