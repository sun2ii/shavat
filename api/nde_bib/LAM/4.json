{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"LAM","translationId":"nde_bib","name":"Izililo","commonName":"Izililo","title":"Izililo","order":25,"numberOfChapters":5,"sha256":"18d524acc1b8904dfdbd73bc350b89b34cf2a8a14b1a5f55f376050bc087a657","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/nde_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Yeka igolide eselilahlekelwe yikukhazimula kwalo,","poem":1},{"text":"igolide elicolekileyo selijujukile!","poem":2},{"text":"Amatshe aligugu angcwele aselahliwe","poem":1},{"text":"ekuqaliseni kwemigwaqo yonke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yeka izinsizwa zaseZiyoni ezincomekayo,","poem":1},{"text":"ezake zaba lesisindo njengegolide,","poem":2},{"text":"okwamanje sezingathi zimbiza zebumba,","poem":1},{"text":"umsebenzi wezandla zombumbi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngitsho lamakhanka asemunyisa","poem":1},{"text":"abantwabawo emabeleni awo,","poem":2},{"text":"kodwa abantu bami kabaselazwelo","poem":1},{"text":"njengezintshe enkangala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ngenxa yokoma, ulimi losane","poem":1},{"text":"lunamathele elwangeni lomlomo;","poem":2},{"text":"abantwana bancenga becela isinkwa","poem":1},{"text":"kodwa kakho obaphayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Labo ababesidla izibiliboco","poem":1},{"text":"sebeyiziceli emigwaqweni.","poem":2},{"text":"Labo abondliwa ebutifitifini","poem":1},{"text":"sebelala esilotheni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Isijeziso sabantu bakithi","poem":1},{"text":"sikhulu kuleseSodoma,","poem":2},{"text":"yona eyabhujiswa ngomzuzwana,","poem":1},{"text":"akwaze kwaba lasandla esazama ukunceda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Amakhosana abo ayekhazimula kulongqwaqwane,","poem":1},{"text":"emhlophe nke kulochago,","poem":2},{"text":"imizimba yabo ibomvana njengamatshe ohlobo lwerubhi,","poem":1},{"text":"ukubukeka kwabo kunjengelitshe elikhazimulayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kodwa manje sebemnyama kulomsizi;","poem":1},{"text":"kabasananzwa langubani emigwaqweni.","poem":2},{"text":"Isikhumba sabo sesinamathele emathanjeni abo;","poem":1},{"text":"sesome okogodo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bangcono labo ababulawa ngenkemba,","poem":1},{"text":"kulalabo abafa ngendlala;","poem":2},{"text":"bazaca baphele, bekhukhuzwa yindlala","poem":1},{"text":"ngoba kungelakudla okuvela emasimini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ngezandla zabo abesifazane abalesihelo,","poem":1},{"text":"bapheke abantwababo,","poem":2},{"text":"babenza ukudla kwabo","poem":1},{"text":"ngesikhathi abantu bakithi bebulawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"UThixo ubhodlisile intukuthelo yakhe;","poem":1},{"text":"uluthulule ulaka lwakhe olwesabekayo.","poem":2},{"text":"Uwulumathisile umlilo eZiyoni,","poem":1},{"text":"watshisa izisekelo zayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Amakhosi omhlaba ayengakholwa,","poem":1},{"text":"labantu basemhlabeni babengakholwa","poem":2},{"text":"ukuthi izitha labahlaseli bangangena","poem":1},{"text":"emasangweni eJerusalema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kodwa kwenzakala ngenxa yezono zabaphrofethi bakhona,","poem":1},{"text":"lamanyala abaphristi bakhona,","poem":2},{"text":"abachitha igazi labalungileyo","poem":1},{"text":"ngaphakathi kwalo iJerusalema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Manje sebephumputha emigwaqweni","poem":1},{"text":"njengabantu abayiziphofu.","poem":2},{"text":"Sebengcoliswe ligazi","poem":1},{"text":"kakuselamuntu ongathinta izembatho zabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Abantu bayabaxotsha bathi, “Sukani! Lingcolile!","poem":1},{"text":"Sukani! Sukani! Lingasithinti!”","poem":2},{"text":"Nxa bebaleka bentula,","poem":1},{"text":"abantu bezizwe bathi,","poem":2},{"lineBreak":true},{"text":"“Ngeke bahlale lapha njalo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"UThixo ngokwakhe ubahlakazile;","poem":1},{"text":"kasabalondolozi.","poem":2},{"text":"Abaphristi kabasahlonitshwa,","poem":1},{"text":"labadala kabasananzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Phezu kwalokho, amehlo ethu afiphala","poem":1},{"text":"elindele ize engaboni sizo;","poem":2},{"text":"siseziqongweni zethu zokulinda,","poem":1},{"text":"salinda silindele isizwe esasingelancedo kithi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Abantu babesicwathela indawo zonke,","poem":1},{"text":"ngakho sasesisesaba ukuhamba emigwaqweni yethu.","poem":2},{"text":"Sasesiphelelwe, insuku zethu sezibaliwe,","poem":1},{"text":"ngoba isiphetho sethu sesifikile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Abasixotshayo babelejubane","poem":1},{"text":"kulengqungqulu emkhathini;","poem":2},{"text":"baxotshana lathi ezintabeni","poem":1},{"text":"njalo basicathamela enkangala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ogcotshiweyo kaThixo, oyikuphila kwethu uqobo,","poem":1},{"text":"wabanjwa emijibileni yabo.","poem":2},{"text":"Sakhumbula ukuthi ngaphansi kwesithunzi sakhe","poem":1},{"text":"sizahlala phakathi kwezizwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Jabula uthokoze, wena Ndodakazi yase-Edomi,","poem":1},{"text":"wena ohlala elizweni lase-Uzi.","poem":2},{"text":"Kodwa lakuwe izafika inkezo le;","poem":1},{"text":"uzanatha udakwe, unqunulwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ndodakazi yaseZiyoni, isijeziso sakho sizaphela;","poem":1},{"text":"akayikwelula isikhathi sokuthunjwa kwakho.","poem":2},{"text":"Kodwa, maye kuwe Ndodakazi yase-Edomi, uzakujezisa ngesono sakho,","poem":1},{"text":"achaye obala ububi bakho.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}