{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"LAM","translationId":"nde_bib","name":"Izililo","commonName":"Izililo","title":"Izililo","order":25,"numberOfChapters":5,"sha256":"18d524acc1b8904dfdbd73bc350b89b34cf2a8a14b1a5f55f376050bc087a657","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/nde_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Oh Thixo, khumbula okusehleleyo","poem":1},{"text":"khangela ubone ukuyangeka kwethu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ilifa lethu seliphiwe abezizweni,","poem":1},{"text":"imizi yethu yathathwa ngabemzini.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sesizintandane ezingelaboyise,","poem":1},{"text":"omama sebenjengabafelokazi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amanzi okunatha siyawathenga;","poem":1},{"text":"inkuni zethu zikhutshelwa imali.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Labo abasixotshayo basihlezi ezithende;","poem":1},{"text":"sikhathele asilakuphumula.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sazinikela kwabeGibhithe labe-Asiriya","poem":1},{"text":"ukuze sizuze isinkwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Okhokho benza isono kodwa kabasekho,","poem":1},{"text":"thina yithi esesijeziswa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sibuswa yizigqili,","poem":1},{"text":"kakho osikhululayo ezandleni zazo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isinkwa sisithola ngendlela eyingozi","poem":1},{"text":"ngenxa yenkemba ekhona enkangala.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Isikhumba sethu sitshisa njengeziko,","poem":1},{"text":"silomkhuhlane wendlala.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abesifazane bayahlukuluzwa eZiyoni","poem":1},{"text":"kanye lezintombi ezigcweleyo emadolobheni akoJuda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Amakhosi alengisiwe ngezandla zawo;","poem":1},{"text":"abadala abasahlonitshwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Izinsizwa ziyahoqiswa ematsheni okuchola;","poem":1},{"text":"abafana babhensiswa yimithwalo yenkuni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Abadala sebesukile esangweni lomuzi;","poem":1},{"text":"izinsizwa sezithule ukuhlabelela.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ukuthokoza akusekho ezinhliziyweni zethu;","poem":1},{"text":"ukugida kwethu sekuphenduke ukukhala.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Umqhele usuwile ekhanda lethu.","poem":1},{"text":"Maye thina, ngoba sonile!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngenxa yalokhu inhliziyo zethu zibuthakathaka;","poem":1},{"text":"ngenxa yalezizinto amehlo ethu ayafiphala,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ngoba intaba iZiyoni silugwadule,","poem":1},{"text":"sekucathama amakhanka kuyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Wena, Oh Thixo, busa nini lanini;","poem":1},{"text":"ubukhosi bakho buhlezi kuzozonke izizukulwane.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kungani uhlezi usikhohlwa?","poem":1},{"text":"Usifulathelelani isikhathi eside kangaka na?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Sibuyisele kuwe, Oh Thixo, ukuze siphenduke;","poem":1},{"text":"buyisa kabutsha insuku zethu njengezakudala,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ngaphandle kokuba nxa ususilahle kokuphela","poem":1},{"text":"wasizondela ngokungalinganisekiyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}