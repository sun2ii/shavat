{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"MIC","translationId":"nde_bib","name":"UMikha","commonName":"UMikha","title":"UMikha","order":33,"numberOfChapters":7,"sha256":"3b833275a2daacc078f6fd4c4aedc3544669554f408296909e6cea5bf6d73c93","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/nde_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Ilizwi likaThixo elafika kuMikha waseMoreshethi ensukwini zemibuso kaJothamu, loka-Ahazi loHezekhiya, amakhosi akoJuda, umbono awubonayo mayelana leSamariya leJerusalema."]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Zwanini lonke lina bantu,","poem":1},{"text":"lalelani, awu wena mhlaba labo bonke abakuwo,","poem":2},{"text":"ukuze uThixo Wobukhosi afakaze ngawe ekulahla,","poem":1},{"text":"uThixo esethempelini lakhe elingcwele.","poem":2}]},{"type":"heading","content":["Ukwahlulelwa KweSamariya LeJerusalema"]},{"type":"verse","number":3,"content":[{"text":"Khangelani! UThixo uyeza evela lapho ahlala khona;","poem":1},{"text":"wehlela phansi njalo enyathela ezindaweni eziphakemeyo zomhlaba.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Izintaba ziyancibilika ngaphansi kwakhe,","poem":1},{"text":"lezigodi ziyaqhekezeka phakathi","poem":2},{"text":"njengengcino phansi komlilo,","poem":1},{"text":"lanjengamanzi esehla ngamandla emthezukweni.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Konke lokhu kungenxa yokona kukaJakhobe,","poem":1},{"text":"ngenxa yezono zendlu ka-Israyeli.","poem":2},{"text":"Kuyini ukona kukaJakhobe na?","poem":1},{"text":"AkusiSamariya na?","poem":2},{"text":"Iyini indawo kaJuda ephakemeyo na?","poem":1},{"text":"AkusiJerusalema na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Ngakho iSamariya ngizayenza ibe yinqumbi yemfucuza,","poem":1},{"text":"indawo yokuhlanyela izivini.","poem":2},{"text":"Amatshe ayo ngizawathela esigodini","poem":1},{"text":"ngiphendle lezisekelo zayo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Zonke izithombe zayo zizaphohlozwa;","poem":1},{"text":"zonke izipho zayo zasethempelini zizatshiswa ngomlilo;","poem":2},{"lineBreak":true},{"text":"ngizaphahlaza zonke izifanekiso zayo.","poem":2},{"text":"Njengoba yaqoqa izipho zayo","poem":1},{"text":"ngeholo lezifebe,","poem":2},{"text":"zizasetshenziswa njengeholo","poem":1},{"text":"lezifebe futhi.”","poem":2}]},{"type":"heading","content":["Ukukhala Lokulila"]},{"type":"verse","number":8,"content":[{"text":"Ngenxa yalokhu ngizakhala ngilile;","poem":1},{"text":"ngizahamba ngezinyawo phansi njalo nginqunu.","poem":2},{"text":"Ngizahlaba umkhulungwane njengekhanka,","poem":1},{"text":"ngikhale njengesikhova.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngoba inxeba layo kalelapheki;","poem":1},{"text":"selifikile koJuda.","poem":2},{"text":"Selifike kulo kanye isango labantu bami,","poem":1},{"text":"kanye laseJerusalema uqobo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lingakukhulumi eGathi;","poem":1},{"text":"lingakhali lakancane.","poem":2},{"text":"Giqikani ethulini","poem":1},{"text":"eBhethi Ofira.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dlulani linqunu njalo lilenhloni","poem":1},{"text":"lina elihlala eShafiri.","poem":2},{"text":"Labo abahlala eZawanani","poem":1},{"text":"kabayikuphuma.","poem":2},{"text":"IBhethi-Ezeli iphakathi kokulila;","poem":1},{"text":"ukuvikelwa kwayo kususiwe kini.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Labo abahlala eMarothi bayazijanqa ngobuhlungu,","poem":1},{"text":"belindele usizo","poem":2},{"text":"ngoba umonakalo uvele kuThixo,","poem":1},{"text":"wafika lasesangweni leJerusalema.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lina elihlala eLakhishi,","poem":1},{"text":"bophelani amabhiza agijimayo enqoleni.","poem":2},{"text":"Yini elaba yisisusa sesono eNdodakazini yeZiyoni,","poem":1},{"text":"ngoba ukona kuka-Israyeli kwafunyanwa kini.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngakho-ke lizanika iMoreshethi Gathi","poem":1},{"text":"izipho zokwehlukana.","poem":2},{"text":"Idolobho lase-Akhizibhi lizabonakalisa inkohliso","poem":1},{"text":"emakhosini ako-Israyeli.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngizalilethela umnqobi","poem":1},{"text":"lina elihlala eMaresha.","poem":2},{"text":"Lowo olodumo luka-Israyeli","poem":1},{"text":"uzakuza e-Adulami.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Phucani amakhanda enu likhalela","poem":1},{"text":"abantwabenu elibathandayo;","poem":2},{"text":"ziphuceni libe njengelinqe","poem":1},{"text":"ngoba bazasuka kini baye ekuthunjweni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}