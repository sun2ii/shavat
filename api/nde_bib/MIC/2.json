{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"MIC","translationId":"nde_bib","name":"UMikha","commonName":"UMikha","title":"UMikha","order":33,"numberOfChapters":7,"sha256":"3b833275a2daacc078f6fd4c4aedc3544669554f408296909e6cea5bf6d73c93","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/nde_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"heading","content":["Amacebo Abantu LakaNkulunkulu"]},{"type":"verse","number":1,"content":[{"text":"Maye kulabo abaceba ububi,","poem":1},{"text":"kulabo abaceba ukwenza okubi emibhedeni yabo!","poem":2},{"text":"Ekudabukeni kokusa bayakwenza","poem":1},{"text":"ngoba kusemandleni abo ukukwenza.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bahawukela amasimu bawathumbe,","poem":1},{"text":"kanye lezindlu, bazithathe.","poem":2},{"text":"Badlelezela umuntu ngomuzi wakhe,","poem":1},{"text":"lomuntu wakibo ngelifa lakhe.","poem":2}]},{"type":"verse","number":3,"content":["Ngakho uThixo uthi:",{"text":"“Ngiceba ukwenza umonakalo kulababantu,","poem":1},{"text":"elingeke liziphephise kuwo.","poem":2},{"text":"Kalisayikuhamba ngokuziqhenya,","poem":1},{"text":"ngoba kuzakuba yisikhathi sencithakalo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngalolosuku abantu bazalihleka;","poem":1},{"text":"bazaliklolodela ngale ingoma yokulila bathi:","poem":2},{"text":"‘Thina sichithwe okupheleleyo;","poem":1},{"text":"ilifa labantu bami labiwe.","poem":2},{"text":"Uyangithathela!","poem":1},{"text":"Amasimu ethu uwanika abathengisi.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ngakho-ke kawuzukuba laye ebandleni likaThixo","poem":1},{"text":"ozalabela ilizwe ngenkatho.","poem":2}]},{"type":"heading","content":["Abaphrofethi Bamanga"]},{"type":"verse","number":6,"content":[{"text":"Abaphrofethi babo bathi, “Lingaphrofethi.","poem":1},{"text":"Lingaphrofethi ngalezizinto;","poem":2},{"lineBreak":true},{"text":"ihlazo kaliyikusehlela.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wena ndlu kaJakhobe, kufanele yini ukuba kuthiwe,","poem":1},{"text":"“UMoya kaThixo uzondile na?","poem":2},{"lineBreak":true},{"text":"Uyazenza izinto ezinje na?”","poem":2},{"lineBreak":true},{"text":"“Amazwi ami kawenzi okulungileyo","poem":1},{"text":"kuye ozindlela zakhe ziqondile na?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Okwamanje abantu bami sebehlamuke","poem":1},{"text":"njengesitha.","poem":2},{"text":"Lihlubula ingubo eligugu","poem":1},{"text":"kulabo abedlulayo linganakile,","poem":2},{"lineBreak":true},{"text":"njengabantu abavela empini.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Abesifazane babantu bami liyabaxotsha","poem":1},{"text":"emizini yabo emihle.","poem":2},{"text":"Lisusa isibusiso sami","poem":1},{"text":"kokuphela ebantwaneni babo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sukani lihambe!","poem":1},{"text":"Ngoba le akusindawo yenu yokuphumula,","poem":2},{"text":"ngoba ingcolile,","poem":1},{"text":"ichithekile, okungeke kulungiswe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nxa umqambi wamanga lomkhohlisi efika athi,","poem":1},{"text":"‘Ngizaliphrofethela iwayini elinengi lotshwala,’","poem":2},{"lineBreak":true},{"text":"uyabe engumphrofethi walababantu nje kuphela!”","poem":2}]},{"type":"heading","content":["Isithembiso Sokukhululwa"]},{"type":"verse","number":12,"content":[{"text":"“Impela ngizalibutha lonke, wena Jakhobe;","poem":1},{"text":"impela ngizabaqoqela ndawonye abako-Israyeli abasalayo.","poem":2},{"text":"Ngizabaqoqela ndawonye njengezimvu esibayeni,","poem":1},{"text":"njengomhlambi wezimvu emadlelweni awo;","poem":2},{"lineBreak":true},{"text":"indawo ibe lokuphithizela kwabantu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lowo ozavula indlela uzahamba phambi kwabo;","poem":1},{"text":"bazafohla isango baphume.","poem":2},{"text":"Inkosi yabo izadlulela phambi kwabo,","poem":1},{"text":"uThixo abe phambi kwabo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}