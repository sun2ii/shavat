"text":"Ngalesosikhathi uzabafihlela ubuso bakhe","poem":1},{"text":"ngenxa yobubi ababenzileyo.","poem":2}]},{"type":"verse","number":5,"content":["Nanku okutshiwo nguThixo:",{"text":"“Okunjengabaphrofethi,","poem":1},{"text":"abedukisa abantu bami,","poem":2},{"text":"umuntu angabapha ukudla,","poem":1},{"text":"bamemezela ‘ukuthula’","poem":2},{"text":"nxa engabaphi balungisela","poem":1},{"text":"ukumhlasela ngempi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngakho ubusuku buzakwehlela phezu kwenu, kungekho mibono,","poem":1},{"text":"kanye lomnyama, kungekho kuhlahlula.","poem":2},{"text":"Ilanga lizabatshonela abaphrofethi,","poem":1},{"text":"losuku luzakuba mnyama kubo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ababonisayo bazayangeka","poem":1},{"text":"labahlahluli babe lenhloni.","poem":2},{"text":"Bonke bazamboza ubuso babo","poem":1},{"text":"ngoba kungelampendulo evela kuNkulunkulu.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kodwa mina ngiphiwe amandla,","poem":1},{"text":"loMoya kaThixo,","poem":2},{"lineBreak":true},{"text":"lokulunga kanye lesibindi,","poem":2},{"text":"ukuba ngitshele uJakhobe ukona kwakhe","poem":1},{"text":"lo-Israyeli isono sakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Zwanini lokhu lina bakhokheli bendlu kaJakhobe,","poem":1},{"text":"lani babusi bendlu ka-Israyeli,","poem":2},{"text":"eleyisa ukulunga","poem":1},{"text":"lihlanekele konke okuqondileyo;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"elakha iZiyoni ngokuchitha igazi;","poem":1},{"text":"leJerusalema ngobubi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abakhokheli bayo bahlulela ngokufunjathiswa,","poem":1},{"text":"abaphristi bayo bafundisela inhlawulo,","poem":2},{"lineBreak":true},{"text":"labaphrofethi bayo baphrofithela imali;","poem":2},{"text":"ikanti bathembele kuThixo njalo bathi,","poem":1},{"text":"“Kanti uThixo kakho phakathi kwethu na?","poem":2},{"lineBreak":true},{"text":"Akulancithakalo engasehlela.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngakho-ke ngenxa yenu,","poem":1},{"text":"iZiyoni izalinywa njengensimu,","poem":2},{"text":"iJerusalema izakuba yinqwaba yemfucuza,","poem":1},{"text":"intaba yethempeli ibe yindunduma eyande izixukwana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}