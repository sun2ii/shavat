{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"MIC","translationId":"nde_bib","name":"UMikha","commonName":"UMikha","title":"UMikha","order":33,"numberOfChapters":7,"sha256":"3b833275a2daacc078f6fd4c4aedc3544669554f408296909e6cea5bf6d73c93","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/nde_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["INtaba KaThixo"]},{"type":"verse","number":1,"content":["Ngezinsuku zokucina",{"text":"intaba yethempeli likaThixo izamiswa","poem":1},{"text":"njengenhloko phakathi kwezintaba;","poem":2},{"text":"izaphakanyiselwa phezu kwezintaba","poem":1},{"text":"njalo izizwe zizabekelela zisiya kuyo.","poem":2}]},{"type":"verse","number":2,"content":["Izizwe ezinengi zizafika zithi,",{"text":"“Wozani siye phezu kwentaba kaThixo,","poem":1},{"text":"siye ethempelini likaNkulunkulu kaJakhobe.","poem":2},{"text":"Uzasifundisa izindlela zakhe,","poem":1},{"text":"ukuze sihambe emikhondweni yakhe.”","poem":2},{"text":"Umthetho uzavela eZiyoni,","poem":1},{"text":"ilizwi likaThixo livele eJerusalema.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Uzakwahlulela phakathi kwezizwe ezinengi","poem":1},{"text":"alamule lezingxabano zezizwe ezilamandla ezindaweni ezikhatshana.","poem":2},{"text":"Bazakhanda izinkemba zabo zibe yimihlathi yamakhuba,","poem":1},{"text":"lemikhonto yabo ibe zingqamu zokuthena izihlahla.","poem":2},{"text":"Isizwe asiyikuhlomela isizwe ngenkemba","poem":1},{"text":"loba sifundele ukulwa impi futhi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Umuntu wonke uzahlala ngaphansi kwesihlahla sakhe sevini","poem":1},{"text":"langaphansi kwesihlahla sakhe somkhiwa,","poem":2},{"text":"njalo kakho ozabenza besabe,","poem":1},{"text":"ngoba uThixo uSomandla usekhulumile.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zonke izizwe zingahamba","poem":1},{"text":"ebizweni labonkulunkulu bazo;","poem":2},{"text":"thina sizahamba ebizweni likaThixo","poem":1},{"text":"uNkulunkulu wethu kuze kube laphakade.","poem":2}]},{"type":"heading","content":["Icebo LikaThixo"]},{"type":"verse","number":6,"content":[{"text":"“Ngalolosuku,” kutsho uThixo,","poem":1},{"text":"“ngizabutha abaqhulayo;","poem":2},{"text":"ngizaqoqa abathunjwayo","poem":1},{"text":"lalabo engabehlisela usizi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngizakwenza abaqhulayo babe yinsalela,","poem":1},{"text":"abaxotshwayo babe yisizwe esilamandla.","poem":2},{"text":"UThixo uzababusa eNtabeni iZiyoni,","poem":1},{"text":"kusukela ngalolosuku kuze kube nininini.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wena nqaba yokulinda yomhlambi,","poem":1},{"text":"wena nqaba yeNdodakazi yeZiyoni,","poem":2},{"text":"umbuso wakuqala uzabuyiselwa kuwe;","poem":1},{"text":"ubukhosi buzakuza eNdodakazini yaseJerusalema.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kungani khathesi usukhala kakhulu,","poem":1},{"text":"kawulankosi na?","poem":2},{"text":"Umeluleki wakho usebhubhile na,","poem":1},{"text":"ukuba uphathwe yibuhlungu obunjengowesifazane ohelelwayo?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Janqula ngobuhlungu, wena Ndodakazi yeZiyoni,","poem":1},{"text":"njengowesifazane ohelelwayo,","poem":2},{"text":"ngoba khathesi sekumele usuke kulelidolobho","poem":1},{"text":"uyehlala egangeni.","poem":2},{"text":"Uzakuya eBhabhiloni;","poem":1},{"text":"lapho ozahlengwa khona.","poem":2},{"text":"Khonale uThixo uzakukhulula","poem":1},{"text":"ezandleni zezitha zakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kodwa khathesi izizwe","poem":1},{"text":"ezinengi zikujamele.","poem":2},{"text":"Zithi, “Kangcoliswe,","poem":1},{"text":"lamehlo ethu kawahawukele iZiyoni!”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kodwa kabayazi","poem":1},{"text":"imicabango kaThixo;","poem":2},{"text":"kabaliqedisisi icebo lakhe,","poem":1},{"text":"yena obabutha njengezixha zamabele esizeni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Sukuma ubhule, wena Ndodakazi yeZiyoni,","poem":1},{"text":"ngoba ngizakupha impondo zensimbi;","poem":2},{"text":"ngizakunika amasondo ethusi,","poem":1},{"text":"njalo uzachoboza izizwe ezinengi.”","poem":2},{"text":"Uzanikela kuThixo inzuzo yabo eyatholwa ngobuqili","poem":1},{"text":"inotho yabo kuThixo womhlaba wonke.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}