oem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Uzakuma eluse umhlambi wakhe","poem":1},{"text":"ngamandla kaThixo,","poem":2},{"lineBreak":true},{"text":"ngobukhosi bebizo likaThixo uNkulunkulu wakhe.","poem":2},{"text":"Bazahlala ngokuvikeleka, ngoba lapho","poem":1},{"text":"udumo lwakhe luzafika emikhawulweni yomhlaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Uzakuba yikuthula kwabo.","poem":1},"Ukukhululwa Lokuchithwa",{"text":"Lapho umʼAsiriya ehlasela ilizwe lethu","poem":2},{"lineBreak":true},{"text":"edabula phakathi kwezinqaba zethu,","poem":2},{"text":"sizamvusela abelusi abayisikhombisa,","poem":1},{"text":"kanye labakhokheli babantu abayisificaminwembili.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bazabusa ilizwe lase-Asiriya ngenkemba,","poem":1},{"text":"ilizwe likaNimrodi behlome ngenkemba,","poem":2},{"text":"uzasikhulula kumʼAsiriya","poem":1},{"text":"lapho ehlasela ilizwe lethu","poem":2},{"lineBreak":true},{"text":"engena phakathi kwemingcele yethu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Insalela zabakoJakhobe zizakuba","poem":1},{"text":"phakathi kwezizwe ezinengi","poem":2},{"text":"njengamazolo avela kuThixo,","poem":1},{"text":"lanjengemkhizo phezu kotshani,","poem":2},{"text":"okungalindeli muntu","poem":1},{"text":"kumbe kuhlalele abantu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Insalela zabakoJakhobe zizakuba phakathi kwezizwe,","poem":1},{"text":"phakathi kwabantu abanengi,","poem":2},{"text":"njengesilwane phakathi kwezinyamazana zegusu,","poem":1},{"text":"lanjengeguqa lesilwane phakathi komhlambi wezimvu,","poem":2},{"text":"esidlithizayo sidabule ekuhambeni kwaso,","poem":1},{"text":"kungekho ongahlenga.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Isandla sakho sizaphakanyiselwa phezulu ngokunqoba izitha zakho,","poem":1},{"text":"njalo zonke izitha zakho zizachithwa.","poem":2}]},{"type":"verse","number":10,"content":["“Ngalolosuku,” kutsho uThixo,",{"text":"“ngizabhubhisa amabhiza enu phakathi kwenu","poem":1},{"text":"ngibhidlize lezinqola zenu zempi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngizachitha amadolobho elizwe lenu","poem":1},{"text":"ngibhidlize lezinqaba zenu zonke.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngizachitha ubuthakathi benu","poem":1},{"text":"njalo kalisayikukhunkula futhi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngizachitha izithombe zenu ezabazwayo","poem":1},{"text":"lamatshe enu okukhonza phakathi kwenu;","poem":2},{"text":"kalisayi kuwukhothamela futhi","poem":1},{"text":"umsebenzi wezandla zenu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngizasiphula phakathi kwenu izinsika zenu zika-Ashera,","poem":1},{"text":"ngidilize lamadolobho enu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngizaphindisela ngentukuthelo","poem":1},{"text":"langolaka ezizweni ezingangilalelanga.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}