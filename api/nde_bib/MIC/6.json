{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"MIC","translationId":"nde_bib","name":"UMikha","commonName":"UMikha","title":"UMikha","order":33,"numberOfChapters":7,"sha256":"3b833275a2daacc078f6fd4c4aedc3544669554f408296909e6cea5bf6d73c93","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/nde_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":6,"content":[{"type":"heading","content":["Icala Lika-Israyeli KuThixo"]},{"type":"verse","number":1,"content":["Lalelani okutshiwo nguThixo ukuthi:",{"text":"“Sukumani lilandise indaba yenu phambi kwezintaba;","poem":1},{"text":"amaqaqa kawezwe lokho elikutshoyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Zwanini, lina zintaba, icala elethulwa nguThixo;","poem":1},{"text":"lalelani lina zisekelo zomhlaba ezingulaphakade.","poem":2},{"text":"Ngoba kulecala uThixo alibeka ebantwini bakhe,","poem":1},{"text":"wethesa u-Israyeli icala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bantu bami, ngenzeni kini na?","poem":1},{"text":"Ngilihluphe ngani na? Ngiphendulani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngalikhupha eGibhithe","poem":1},{"text":"ngalikhulula elizweni lobugqili.","poem":2},{"text":"Ngathuma uMosi ukuba alikhokhele","poem":1},{"text":"kanye lo-Aroni loMiriyemu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bantu bami, khumbulani","poem":1},{"text":"izicebiso zikaBhalaki inkosi yaseMowabi","poem":2},{"lineBreak":true},{"text":"lokuthi uBhalamu indodana kaBheyori waphendula wathini.","poem":2},{"text":"Khumbulani uhambo lwenu kusukela eShithima kusiya eGiligali,","poem":1},{"text":"ukuze lazi imisebenzi elungileyo kaThixo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kuyini engizakuza lakho phambi kukaThixo","poem":1},{"text":"ngikhothame phambi kukaNkulunkulu ophakemeyo na?","poem":2},{"text":"Ngizakuza phambi kwakhe ngilomnikelo wokutshiswa,","poem":1},{"text":"ngilamathole alomnyaka owodwa na?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"UThixo angathokoziswa zinqama eziyizinkulungwane,","poem":1},{"text":"izinkulungwane ezilitshumi zemifula yamafutha na?","poem":2},{"text":"Ngizanikela izibulo lami ngenxa yokona kwami,","poem":1},{"text":"isithelo somzimba wami ngenxa yesono somphefumulo wami na?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ukutshengisile wena muntu okuhle.","poem":1},{"text":"UThixo ufunani kuwe na?","poem":2},{"text":"Ukwenza okulungileyo lokuthanda umusa","poem":1},{"text":"kanye lokuhamba ngokuzithoba loNkulunkulu wakho.","poem":2}]},{"type":"heading","content":["Icala Lika-Israyeli Lesijeziso"]},{"type":"verse","number":9,"content":[{"text":"Lalelani! UThixo umemezela kulo idolobho,","poem":1},{"text":"lokwesaba ibizo lakho kuyikuhlakanipha,","poem":2},{"lineBreak":true},{"text":"“Qaphelani umqwayi laLowo owubekileyo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wena ndlu yobubi, kufanele lakhathesi ngiyikhohlwe inotho yakho eyazuzwa ngobubi,","poem":1},{"text":"lehefa elinganelanga, eliqalekisiweyo na?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngizamkhulula yini ecaleni umuntu olezilinganiso zobuqili,","poem":1},{"text":"lesaka lezilinganiso zamanga na?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Abantu bakhona abanothileyo balochuku;","poem":1},{"text":"abantu bakhona ngabaqambi bamanga,","poem":2},{"lineBreak":true},{"text":"lezilimi zabo zikhuluma inkohliso.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngakho sengiqalisile ukukuchitha,","poem":1},{"text":"ukukuqothula ngenxa yezono zakho.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Uzakudla kodwa ungasuthi;","poem":1},{"text":"isisu sakho sizakuba silokhu singelalutho.","poem":2},{"text":"Uzabuthelela kodwa ungalondolozi lutho,","poem":1},{"text":"ngoba lokho okulondolozayo ngizakupha inkemba.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Uzalima kodwa ungavuni;","poem":1},{"text":"uzakhama ama-oliva kodwa amafutha awo ungawagcobi,","poem":2},{"lineBreak":true},{"text":"uzakhama amavini kodwa iwayini lawo ungalinathi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ugcinile imithetho ka-Omri","poem":1},{"text":"layo yonke imikhutshana yasendlini ka-Ahabi,","poem":2},{"lineBreak":true},{"text":"walandela lamasiko abo.","poem":2},{"text":"Ngakho-ke ngizakunikela ekubhujisweni,","poem":1},{"text":"labantu bakho ekubeni yinhlekisa;","poem":2},{"lineBreak":true},{"text":"uzathwala ihlazo lezizwe.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/MIC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/MIC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/MIC/5.json","previousChapterAudioLinks":{},"numberOfVerses":16}