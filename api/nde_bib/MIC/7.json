{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"MIC","translationId":"nde_bib","name":"UMikha","commonName":"UMikha","title":"UMikha","order":33,"numberOfChapters":7,"sha256":"3b833275a2daacc078f6fd4c4aedc3544669554f408296909e6cea5bf6d73c93","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/nde_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["Usizi Luka-Israyeli"]},{"type":"verse","number":1,"content":[{"text":"Maye ngosizi lwami!","poem":1},{"lineBreak":true},{"text":"Nginjengomuntu obutha izithelo zehlobo","poem":1},{"text":"senginjengevini eselivunwe laphela;","poem":2},{"text":"akuselasixha samavini okudliwa,","poem":1},{"text":"kayisekho lemikhiwa yakuqala engiyikhanukayo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abathembekileyo babhujisiwe elizweni,","poem":1},{"text":"kakho lamunye umuntu olungileyo oseleyo.","poem":2},{"text":"Abantu bonke bacathamela ukuchitha igazi;","poem":1},{"text":"lowo lalowo uzingela umfowabo ngombule.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Izandla zombili zizingcitshi ekwenzeni okubi;","poem":1},{"text":"umbusi ufuna izipho ngamandla,","poem":2},{"text":"umahluleli wamukela isivalamlomo,","poem":1},{"text":"abalamandla babiza abakufisayo,","poem":2},{"lineBreak":true},{"text":"bonke baceba okubi bendawonye.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ongcono wabo unjengesihlahla sameva,","poem":1},{"text":"oqotho kakhulu mubi kulothango lwameva.","poem":2},{"text":"Usuku uNkulunkulu alethekelela ngalo selufikile,","poem":1},{"text":"usuku lokukhala kophondo lwabalindi.","poem":2},{"lineBreak":true},{"text":"Manje sekuyisikhathi sokuphumputheka kwabo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ungamethembi umakhelwane;","poem":1},{"text":"ungagwabi ngomngane wakho.","poem":2},{"text":"Lalowo olala umgonile,","poem":1},{"text":"qaphela amazwi akho.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngoba indodana idumaza uyise,","poem":1},{"text":"indodakazi ivukela unina,","poem":2},{"text":"umalukazana avukele uninazala,","poem":1},{"text":"izitha zomuntu ngamalunga endlu yakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kodwa mina ngilindele uThixo ngethemba,","poem":1},{"text":"ngilindele uNkulunkulu uMsindisi wami;","poem":2},{"lineBreak":true},{"text":"uNkulunkulu wami uzangizwa.","poem":2}]},{"type":"heading","content":["U-Israyeli Uzavuka"]},{"type":"verse","number":8,"content":[{"text":"Ungaklolodi wena sitha sami!","poem":1},{"text":"Lanxa ngiwile, ngizavuka.","poem":2},{"text":"Lanxa ngihlezi emnyameni,","poem":1},{"text":"uThixo uzakuba yikukhanya kwami.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngenxa yokuba ngonile kuye,","poem":1},{"text":"ngizalumela ulaka lukaThixo,","poem":2},{"text":"aze angincengele endabeni yami,","poem":1},{"text":"aveze ukungabi lacala kwami.","poem":2},{"text":"Uzangikhuphela phandle ekukhanyeni;","poem":1},{"text":"ngizabona ukulunga kwakhe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lapho-ke isitha sami sizakubona,","poem":1},{"text":"njalo sibanjwe zinhloni,","poem":2},{"text":"lowo owathi kimi,","poem":1},{"text":"“Ungaphi uThixo uNkulunkulu wakho?”","poem":2},{"text":"Lakhathesi uzagxotshwa","poem":1},{"text":"ngezinyawo njengodaka emigwaqweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Usuku lokwakhiwa kwemiduli yakho luzafika,","poem":1},{"text":"usuku lokuqhelisa imingcele yakho.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngalolosuku abantu bazakuza kuwe","poem":1},{"text":"bevela e-Asiriya lasemadolobheni aseGibhithe,","poem":2},{"text":"njalo kusukela eGibhithe kusiya kuYufrathe,","poem":1},{"text":"kusukela olwandle kusiya olwandle,","poem":2},{"lineBreak":true},{"text":"lakusukela entabeni kusiya entabeni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Umhlaba uzachitheka ngenxa yabahlezi kuwo,","poem":1},{"text":"ngenxa yezenzo zabo.","poem":2}]},{"type":"heading","content":["Ukukhuleka Lokudumisa"]},{"type":"verse","number":14,"content":[{"text":"Beluse abantu bakho ngentonga yakho,","poem":1},{"text":"umhlambi welifa lakho,","poem":2},{"text":"ohlala wodwa ehlathini","poem":1},{"text":"emadlelweni avundileyo.","poem":2},{"text":"Kawudle eBhashani laseGiliyadi","poem":1},{"text":"njengasezinsukwini zokuphuma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Njengasezinsukwini zokuphuma kwenu eGibhithe,","poem":1},{"text":"ngizabatshengisa izimangaliso zami.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Izizwe zizabona ziyangeke,","poem":1},{"text":"zemukwe wonke amandla azo.","poem":2},{"text":"Zizabamba imilomo yazo ngezandla,","poem":1},{"text":"lezindlebe zazo zingabe zisezwa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Zizakhotha uthuli njengenyoka,","poem":1},{"text":"njengezinanakazana ezihuquzela emhlabathini.","poem":2},{"text":"Zizakuza ziqhaqhazela ziphuma emihomeni yazo;","poem":1},{"text":"zizaphendukela kuThixo uNkulunkulu wethu ngokwesaba,","poem":2},{"lineBreak":true},{"text":"njalo lawe zizakwesaba.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngubani onguNkulunkulu njengawe,","poem":1},{"text":"oxolela izono athethelele iziphambeko","poem":2},{"lineBreak":true},{"text":"zensalela zelifa lakhe na?","poem":2},{"text":"Kawuthukutheli kokuphela","poem":1},{"text":"kodwa uthokoza ngokutshengisa isihawu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Uzakuba lesihawu kithi futhi;","poem":1},{"text":"uzanyathela izono zethu ngezinyawo","poem":2},{"lineBreak":true},{"text":"uphosele bonke ububi bethu ezinzikini zolwandle.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Uzakuba qotho kuJakhobe,","poem":1},{"text":"ubonakalise isihawu sakho ku-Abhrahama,","poem":2},{"text":"njengokuthembisa kwakho ngesifungo kubokhokho bethu","poem":1},{"text":"ensukwini zasendulo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}