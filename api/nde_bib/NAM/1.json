{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"NAM","translationId":"nde_bib","name":"UNahume","commonName":"UNahume","title":"UNahume","order":34,"numberOfChapters":3,"sha256":"0b805f222713c43a87f358f6ddacd9fb50c750875d1ca239f75c3e9437c292a9","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nde_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Isiqalekiso ngeNiniva. Incwadi yombono kaNahume umʼElikhoshi."]},{"type":"line_break"},{"type":"heading","content":["Ulaka LukaThixo NgeNiniva"]},{"type":"verse","number":2,"content":[{"text":"UThixo uNkulunkulu olobukhwele lophindiselayo;","poem":1},{"text":"uThixo uyaphindisela njalo ulolaka olukhulu.","poem":2},{"text":"UThixo uyaphindisela ezitheni zakhe","poem":1},{"text":"lolaka lwakhe lukhulu ezitheni zakhe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"UThixo uyaphuza ukuthukuthela njalo ulamandla amakhulu;","poem":1},{"text":"uThixo kayikumyekela olecala engajeziswanga.","poem":2},{"text":"Indlela yakhe iphakathi kwesivunguzane lesiphepho,","poem":1},{"text":"amayezi aluthuli lwezinyawo zakhe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ukhuza ulwandle alomise;","poem":1},{"text":"wenza yonke imifula itshe.","poem":2},{"text":"IBhashani leKhameli kuyabuna","poem":1},{"text":"lemiqhakazo yaseLebhanoni ibune.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Izintaba ziyanyikinyeka phambi kwakhe,","poem":1},{"text":"lamaqaqa ayancibilika.","poem":2},{"text":"Umhlaba uyagedezela ngobukhona bakhe,","poem":1},{"text":"umhlaba labo bonke abahlala kuwo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngubani ongamelana lentukuthelo yakhe na?","poem":1},{"text":"Ngubani ongalumela ulaka lwakhe oluvuthayo na?","poem":2},{"text":"Ulaka lwakhe luthululeka njengomlilo;","poem":1},{"text":"amadwala ayaqhekezeka phambi kwakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"UThixo ulungile,","poem":1},{"text":"uyisiphephelo ezikhathini zokuhlupheka.","poem":2},{"text":"Uyabakhathalela abathembele kuye,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"kodwa ngesikhukhula esikhulu","poem":2},{"text":"uzatshabalalisa iNiniva;","poem":1},{"text":"uzaxotshela izitha zakhe emnyameni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Loba engamacebo bani abawenza ngoThixo,","poem":1},{"text":"uzawaqeda;","poem":2},{"lineBreak":true},{"text":"ukuhlupheka akuyikubuya kabili.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bazathandeleka phakathi kwameva,","poem":1},{"text":"bedakwe liwayini labo;","poem":2},{"lineBreak":true},{"text":"bazaqothulwa njengenhlanga ezomileyo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wena Nineve, kuwe sekufike lowo","poem":1},{"text":"oceba okubi ngoThixo,","poem":2},{"lineBreak":true},{"text":"eluleke okubi.","poem":2}]},{"type":"verse","number":12,"content":["Nanku okutshiwo nguThixo:",{"text":"“Lanxa belababambene labo njalo bebanengi,","poem":1},{"text":"bazaqothulwa banyamalale.","poem":2},{"text":"Lanxa ngikuhluphile, wena Juda,","poem":1},{"text":"kangisayikukuhlupha futhi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Khathesi ngizakwephula ijogwe labo elisentanyeni yakho,","poem":1},{"text":"ngiqamule lamaketane akho.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"UThixo usekhuphe ilizwi ngawe Nineve elithi,","poem":1},{"text":"“Kawuyikuba lezizukulwane ezibizwa ngebizo lakho.","poem":2},{"text":"Ngizachitha izifanekiso ezibaziweyo lezithombe ezibunjiweyo","poem":1},{"text":"ezisethempelini labonkulunkulu bakho.","poem":2},{"text":"Ngizalungisa ingcwaba lakho,","poem":1},{"text":"ngoba ungcolile.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Khangela ezintabeni le,","poem":1},{"text":"inyawo zalowo oletha izindaba ezinhle,","poem":2},{"lineBreak":true},{"text":"omemezela ukuthula!","poem":2},{"text":"Thakazelela imikhosi yakho we Juda,","poem":1},{"text":"ugcwalise lezifungo zakho.","poem":2},{"text":"Ababi kabasayikukuhlasela futhi;","poem":1},{"text":"bazachithwa ngokupheleleyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}