{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"NAM","translationId":"nde_bib","name":"UNahume","commonName":"UNahume","title":"UNahume","order":34,"numberOfChapters":3,"sha256":"0b805f222713c43a87f358f6ddacd9fb50c750875d1ca239f75c3e9437c292a9","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nde_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["INiniva Izachitheka"]},{"type":"verse","number":1,"content":[{"text":"Umhlaseli uyasondela kuwe, Nineve.","poem":1},{"text":"Vikela inqaba,","poem":2},{"lineBreak":true},{"text":"linda umgwaqo,","poem":2},{"lineBreak":true},{"text":"zilungiselele,","poem":2},{"lineBreak":true},{"text":"qoqa wonke amandla akho!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"UThixo uzabuyisela ubuhle bukaJakhobe","poem":1},{"text":"njengobuhle buka-Israyeli,","poem":2},{"text":"lanxa abachithi bebaqothule","poem":1},{"text":"batshabalalisa lezivini zabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Amahawu amabutho akhe abomvu,","poem":1},{"text":"amabutho agqoke okubomvu gebhu.","poem":2},{"text":"Insimbi ezinqoleni zempi iyaphazima","poem":1},{"text":"ngosuku ezilungiselwe ngalo;","poem":2},{"lineBreak":true},{"text":"imikhonto yesihlahla sephayini iyazunguzwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Izinqola zempi zihlasela ngesiqubu emigwaqweni,","poem":1},{"text":"zisiya emuva laphambili ezigcawini.","poem":2},{"text":"Zinjengezibane ezikhanyisiweyo;","poem":1},{"text":"ziyaphaziphazima njengombane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ubiza amabutho akhe akhethiweyo","poem":1},{"text":"kodwa ayakhubeka endleleni yawo.","poem":2},{"text":"Agijimela emdulini wedolobho;","poem":1},{"text":"isivikelo silungiswe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amasango omfula ayavulwa,","poem":1},{"text":"indlu yobukhosi ibhidlike.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kumiswe ukuthi idolobho lizathunjwa,","poem":1},{"text":"abantu balo basiwe ebugqilini.","poem":2},{"text":"Izintombi zalo eziyizigqili zikhala njengamajuba","poem":1},{"text":"zizitshaya amabele azo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"INiniva injengesiziba,","poem":1},{"text":"njalo amanzi aso ageleza ehamba.","poem":2},{"text":"Bayaklabalala besithi, “Mana! Mana!”","poem":1},{"text":"Kodwa kakho onyemukulayo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Phangani isiliva!","poem":1},{"text":"Phangani igolide!","poem":2},{"text":"Umthapho kawupheli,","poem":1},{"text":"inotho evela eziphaleni zayo zonke!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ibhuqiwe, iphangiwe, iphundliwe!","poem":1},{"text":"Inhliziyo ziphela amandla, amadolo ayaxega,","poem":2},{"lineBreak":true},{"text":"imizimba iyaqhaqhazela, ubuso bonke bunyukubele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Khathesi-ke ungaphi umhome wezilwane,","poem":1},{"text":"lapho ezinikela khona abantwana bazo ukudla,","poem":2},{"text":"lapho okwaya khona isilwane lesilwanekazi,","poem":1},{"text":"kanye lemidlwane, kungekho lutho olwesatshwayo na?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Isilwane sibulalele imidlwane yaso okwaneleyo","poem":1},{"text":"sabambela lesilwanekazi saso okwenyama yokudliwa,","poem":2},{"text":"sagcwalisa isikhundla saso ngesikujimbileyo","poem":1},{"text":"lomhome waso ngenyama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Ngimelane lawe,”","poem":1},{"text":"kutsho uThixo uSomandla.","poem":2},{"text":"“Ngizazitshisa izinqola zakho zempi zibe yintuthu;","poem":1},{"text":"lenkemba izakudla izilwane zakho ezisakhulayo.","poem":2},{"lineBreak":true},{"text":"Kangiyikukutshiyela ongakubamba ukudle njengenyama emhlabeni.","poem":2},{"text":"Amazwi ezithunywa zakho","poem":1},{"text":"kawasayikuzwakala futhi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}