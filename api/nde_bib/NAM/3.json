{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"NAM","translationId":"nde_bib","name":"UNahume","commonName":"UNahume","title":"UNahume","order":34,"numberOfChapters":3,"sha256":"0b805f222713c43a87f358f6ddacd9fb50c750875d1ca239f75c3e9437c292a9","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/nde_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["Maye Kuyo INiniva"]},{"type":"verse","number":1,"content":[{"text":"Maye kulo idolobho legazi,","poem":1},{"text":"ligcwele amanga,","poem":2},{"text":"ligcwele ukuphanga,","poem":1},{"text":"kasweleki ohlutshwayo lanini!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ukukhala kwezaswebhu,","poem":1},{"text":"ukugodlozela kwamavili,","poem":2},{"text":"ukumatha kwamabhiza","poem":1},{"text":"lokugedlezela kwezinqola zempi!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ukuhlasela kwabagadi bamabhiza","poem":1},{"text":"ukuphazima kwezinkemba","poem":2},{"lineBreak":true},{"text":"lokubenyezela kwemikhonto.","poem":2},{"text":"Zinengi izinkubela,","poem":1},{"text":"izinqwaba zabafileyo,","poem":2},{"text":"izidumbu ezingabalwayo,","poem":1},{"text":"abantu abakhubeka ezidunjini,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"konke ngenxa yenkanuko embi yesifebe,","poem":1},{"text":"siyakhanga, siyinkosikazi ephethe ubuthakathi,","poem":2},{"text":"esifaka izizwe ebugqilini ngobufebe baso","poem":1},{"text":"labantu ngobuthakathi baso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Ngimelana lawe,” kutsho uThixo uSomandla.","poem":1},{"text":"“Ngizakwembulela izidwaba zakho ebusweni bakho.","poem":2},{"text":"Ngizatshengisa izizwe ubunqunu bakho,","poem":1},{"text":"lemibuso ihlazo lakho.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngizakujikijela ngamanyala,","poem":1},{"text":"ngizakweyisa,","poem":2},{"lineBreak":true},{"text":"njalo ngikwenze ube ngumbukiso.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bonke abakubonayo bazakubalekela bathi,","poem":1},{"text":"‘iNiniva isichithekile, ngubani ozayililela na?’","poem":2},{"lineBreak":true},{"text":"Ngingamthola ngaphi ongakududuza na?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wena ungcono na kuleThebesi","poem":1},{"text":"engaseNayili,","poem":2},{"lineBreak":true},{"text":"ehonqolozelwe ngamanzi?","poem":2},{"text":"Umfula wawuyisivikelo sayo,","poem":1},{"text":"amanzi engumduli wayo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"IKhushi leGibhithe kwakungamandla ayo angapheliyo.","poem":1},{"text":"IPhuthi leLibhiya kwakungabanye abancedisi bayo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kodwa yathunjwa","poem":1},{"text":"yaya ebugqilini.","poem":2},{"text":"Izingane zayo zapaklazwa zaba yizicucu","poem":1},{"text":"ekuqaliseni kwemigwaqo yonke.","poem":2},{"text":"Kwenziwa inkatho ngezikhulu zayo,","poem":1},{"text":"wonke amadoda aphakemeyo abotshwa ngamaketane.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Lawe futhi uzadakwa;","poem":1},{"text":"uzakuyacatsha","poem":2},{"lineBreak":true},{"text":"udinge ukuphephela esitheni sakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Zonke izinqola zakho zinjengezihlahla zemikhiwa","poem":1},{"text":"ezilezithelo zazo zakuqala ezivuthiweyo;","poem":2},{"text":"lapho zinyikinywa,","poem":1},{"text":"imikhiwa iwela emlonyeni womudli.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Khangela amabutho akho wonke,","poem":1},{"text":"ngawesifazane!","poem":2},{"text":"Amasango elizwe lakho","poem":1},{"text":"avulekele izitha zakho aba banzi;","poem":2},{"lineBreak":true},{"text":"umlilo uyiqedile imigoqo yawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Donsa amanzi ulungele ukuvimbezela,","poem":1},{"text":"qinisa inqaba zakho.","poem":2},{"text":"Voxa udaka,","poem":1},{"text":"nyathela ibumba,","poem":2},{"lineBreak":true},{"text":"lungisa okwakhiwe ngezitina.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Khonapho umlilo uzakuqeda;","poem":1},{"text":"inkemba izakucakazela phansi,","poem":2},{"lineBreak":true},{"text":"ikudle njengesikhongwane.","poem":2},{"text":"Zandise njengesikhongwane,","poem":1},{"text":"uzandise njengentethe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Usulandisile inani labathengisi bakho.","poem":1},{"text":"Baze bedlula izinkanyezi zasemkhathini,","poem":2},{"text":"kodwa njengentethe baphundla ilizwe","poem":1},{"text":"basuke bahambe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abalindi bakho banjengentethe,","poem":1},{"text":"izikhulu zakho zinjengemitshitshi yentethe","poem":2},{"lineBreak":true},{"text":"ezihlala emidulini mhla kuqanda","poem":2},{"text":"kodwa ilanga lingaphuma ziyaphapha zihambe,","poem":1},{"text":"njalo kakho okwaziyo ukuthi ngaphi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Wena nkosi yase-Asiriya, abelusi bakho bayawozela,","poem":1},{"text":"izikhulu zakho zilala phansi ziphumule.","poem":2},{"text":"Abantu bakho bahlakazekile ezintabeni","poem":1},{"text":"kungekho obaqoqayo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Akukho okungapholisa amanxeba akho;","poem":1},{"text":"ukulimala kwakho ngokokufa.","poem":2},{"text":"Bonke abezwa izindaba ngawe","poem":1},{"text":"batshaya izandla ngokuwa kwakho,","poem":2},{"text":"ngoba ngubani ongafuthelwanga","poem":1},{"text":"yisihluku sakho esingapheliyo na?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}