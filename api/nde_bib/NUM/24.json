{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"NUM","translationId":"nde_bib","name":"AmaNani","commonName":"AmaNani","title":"AmaNani","order":4,"numberOfChapters":36,"sha256":"fc1655ece39cfe5ff4ad7660a3ac19a9bb8eec298d4988e6d34a98e06efe1c99","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/nde_bib/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["Kwathi uBhalamu esebonile ukuthi kuyamthokozisa uThixo ukubusisa u-Israyeli, kasadinganga njalo imilingo njengakuqala, kodwa waphenduka wakhangela enkangala."]},{"type":"verse","number":2,"content":["Kwathi uBhalamu ekhangela wabona u-Israyeli emise izihonqo zakhe ngokwezizwe zakhe, uMoya kaNkulunkulu wehlela phezu kwakhe"]},{"type":"verse","number":3,"content":["wasesitsho isambulelo sakhe:",{"text":"“Isambulelo sikaBhalamu indodana kaBheyori,","poem":1},{"text":"isambulelo salowo omehlo akhe abonisisa kuhle,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"isambulelo salowo ozwa amazwi kaNkulunkulu,","poem":1},{"text":"lowo obona umbono ovela kuSomandla,","poem":2},{"text":"lowo owela phansi ngokuzehlisa,","poem":1},{"text":"njalo omehlo akhe avulekile:","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aze aba mahle amathente akho, Oh Jakhobe,","poem":1},{"text":"izindawo zakho zokuhlala, Oh Israyeli!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Njengezigodi zisabalele,","poem":1},{"text":"njengezivande zisekele umfula,","poem":2},{"text":"sanhlaba ehlanyelwe nguThixo,","poem":1},{"text":"njengezihlahla zomsedari ezingasemanzini.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Amanzi azageleza emigqonyeni yabo;","poem":1},{"text":"inhlanyelo yabo ibe semanzini amanengi.","poem":2},{"lineBreak":true},{"text":"Inkosi yabo izakuba nkulu kulo-Agagi;","poem":1},{"text":"umbuso wabo uzakuba ngophakemeyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"UNkulunkulu wabakhupha eGibhithe;","poem":1},{"text":"balamandla anjengawenyathi.","poem":2},{"text":"Bayazitshwabadela izizwe eziyizitha","poem":1},{"text":"njalo bephule amathambo azo abe yizicucu;","poem":2},{"lineBreak":true},{"text":"ngemitshoko yabo babacibe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Njengesilwane bayaqutha bacathame phansi,","poem":1},{"text":"njengesilwanekazi, ngubani olesibindi sokubavusa na?","poem":2},{"lineBreak":true},{"text":"Akuthi labo abakubusisayo babusiswe","poem":1},{"text":"njalo lalabo abakuqalekisayo baqalekiswe!”","poem":2}]},{"type":"verse","number":10,"content":["Ngakho uBhalaki wamthukuthelela kakhulu uBhalamu. Watshaya izandla zakhe wathi, “Ngikubizele ukuthi uzengiqalekisela izitha zami, kodwa wena usubabusise okwamahlandla la amathathu."]},{"type":"verse","number":11,"content":["Wohle usuke nje khathesi ubuyele kini! Ngithe ngizakupha umvuzo omuhle kakhulu, pho-ke uThixo usekuvimbele ukwamukeliswa umvuzo.”"]},{"type":"verse","number":12,"content":["UBhalamu wamphendula uBhalaki wathi, “Kanti kangizitshelanga yini izithunywa zakho owazithuma kimi ukuthi,"]},{"type":"verse","number":13,"content":["‘Loba uBhalaki enganginika isigodlo sakhe sigcwele isiliva legolide, akulalutho lolulodwa ebengizalwenza ngokwentando yami, okuhle kumbe okubi, okuphambene lomlayo kaThixo, kufanele ngitsho lokho kuphela uThixo akutshoyo na’?"]},{"type":"verse","number":14,"content":["Khathesi sengibuyela ebantwini bakithi, kodwa woza, ngikuxwayise ukuthi kuyini okuzakwenziwa ngabantu laba ebantwini bakho ensukwini ezilandelayo.”"]},{"type":"heading","content":["Isambulo Sesine SikaBhalamu"]},{"type":"verse","number":15,"content":["Ngakho uBhalamu wasesitsho isambulelo sakhe:",{"text":"“Isambulelo sikaBhalamu indodana kaBheyori,","poem":1},{"text":"isambulelo salowo omehlo akhe abonisisa kuhle,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"isambulelo salowo olalela ezwe amazwi kaNkulunkulu,","poem":1},{"text":"ololwazi oluvela koPhezukonke,","poem":2},{"text":"obona umbono ovela kuSomandla, owela phansi ngokuzehlisa,","poem":1},{"text":"njalo omehlo akhe avulekile:","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ngiyambona, kodwa hatshi khathesi;","poem":1},{"text":"ngiyambona, kodwa kungesikho eduze.","poem":2},{"text":"Inkanyezi izaphuma ivela kuJakhobe;","poem":1},{"text":"intonga yobukhosi izaphakama ivela ku-Israyeli.","poem":2},{"text":"Uzacobodisa amabunzi kaMowabi,","poem":1},{"text":"inkakhayi zamadodana wonke kaSethi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"I-Edomi izanqotshwa;","poem":1},{"text":"uSeyiri, oyisitha sakhe, uzanqotshwa,","poem":2},{"lineBreak":true},{"text":"kodwa u-Israyeli uzakhula abe lamandla.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Umbusi uzavela kuJakhobe","poem":1},{"text":"njalo uzabhubhisa abaseleyo balelodolobho.”","poem":2}]},{"type":"heading","content":["Isambulelo Sesihlanu SikaBhalamu"]},{"type":"verse","number":20,"content":["Ngakho uBhalamu wabona u-Amaleki wasesitsho isambulelo sakhe:",{"text":"“U-Amaleki wayengowokuqala ezizweni,","poem":1},{"text":"kodwa ekucineni uzakuba lunxiwa.”","poem":2}]},{"type":"heading","content":["Isambulelo Sesithupha SikaBhalamu"]},{"type":"verse","number":21,"content":["Ngakho wasebona amaKheni wasesitsho isambulelo sakhe njalo:",{"text":"“Indawo yakho yokuhlala ivikelekile,","poem":1},{"text":"isidleke sakho sakhelwe edwaleni;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"kanti-ke lina maKheni lizabhujiswa","poem":1},{"text":"ekuthunjweni kwenu yi-Asiriya.”","poem":2}]},{"type":"heading","content":["Isambulelo Sesikhombisa SikaBhalamu"]},{"type":"verse","number":23,"content":["Ngakho wasitsho isambulelo sakhe:",{"text":"“Kambe ngubani ongaphila nxa uNkulunkulu esenza lokhu na?","poem":1}]},{"type":"verse","number":24,"content":[{"text":"Imikhumbi izakuza ivela okhunjini lwaseKhithimi;","poem":2},{"text":"bazayehlula u-Asiriya kanye le-Ebha,","poem":1},{"text":"kodwa laba bazachithwa babe ngamanxiwa.”","poem":2}]},{"type":"verse","number":25,"content":["Ngakho uBhalamu wasukuma wasebuyela kibo loBhalaki wahamba ngeyakhe indlela."]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/NUM/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}