{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"OBA","translationId":"nde_bib","name":"U-Obhadaya","commonName":"U-Obhadaya","title":"U-Obhadaya","order":31,"numberOfChapters":1,"sha256":"9e15cceb7abbdd01f719cb0a33d3ede877b18f5f7a19c6a09d7ab03026c7b0a8","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/OBA/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/nde_bib/OBA/1.json","totalNumberOfVerses":21},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Umbono Ka-Obhadaya.",{"lineBreak":true},{"lineBreak":true},"Nanku okutshiwo nguThixo Wobukhosi nge-Edomi:",{"text":"Sesizwe ilizwi elivela kuThixo:","poem":1},{"text":"Kuthunywe isithunywa ezizweni ukuba sithi,","poem":2},{"text":"“Phakamani, asihambeni silwe laye impi”:","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Khangela, ngizakwenza ube mncinyane phakathi kwezizwe;","poem":1},{"text":"uzakweyiswa kakhulu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ukuzigqaja kwenhliziyo yakho sekukukhohlisile,","poem":1},{"text":"wena ohlala ezingoxweni zamadwala wakhe","poem":2},{"lineBreak":true},{"text":"umuzi wakho eziqongweni,","poem":2},{"text":"wena ozitshela uthi,","poem":1},{"text":"‘Ngubani ongangiwisela phansi enhlabathini na?’","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lanxa uqonga njengengqungqulu","poem":1},{"text":"wakhe isidleke sakho phakathi kwezinkanyezi,","poem":2},{"lineBreak":true},{"text":"ngizakwethula khonale,”","poem":2},{"lineBreak":true},{"text":"kutsho uThixo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Nxa amasela efike kuwe,","poem":1},{"text":"nxa abaphangi ebusuku,","poem":2},{"text":"Awu, yeka ubukhulu bomonakalo okulindeleyo,","poem":1},{"text":"kabayikuntshontsha kuphela lokho okwanele abakufunayo na?","poem":2},{"text":"Nxa abavuni bamavini befike kuwe,","poem":1},{"text":"kabangeke batshiye amalutshwana na?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kodwa yeka ukuphangwa okuzakwenziwa u-Esawu,","poem":1},{"text":"inotho yakhe efihliweyo izathunjwa!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bonke abamanyane lawe bazakuxotshela emngceleni;","poem":1},{"text":"abangane bakho bazakukhohlisa bakunqobe;","poem":2},{"text":"labo abadla ukudla kwakho bazakuthiya ngomjibila,","poem":1},{"text":"kodwa wena kawuyikuwubona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ngalolosuku,” kutsho uThixo,","poem":1},{"text":"“kangiyikuwabhubhisa yini amadoda ahlakaniphileyo ase-Edomi,","poem":2},{"lineBreak":true},{"text":"amadoda aqedisisayo ezintabeni zako-Esawu na?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Amabutho akho, wena Themani, azathuthumela,","poem":1},{"text":"njalo bonke abasezintabeni zako-Esawu","poem":2},{"lineBreak":true},{"text":"bazacakazelwa phansi ekubulaweni kwabanengi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngenxa yodlakela kumfowenu uJakhobe,","poem":1},{"text":"uzakwembeswa lihlazo;","poem":2},{"lineBreak":true},{"text":"uzachithwa nini lanini.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngosuku owema ngalo khatshana","poem":1},{"text":"mhla izihambi zithumba inotho yakhe","poem":2},{"text":"labezizweni bengena emasangweni akhe","poem":1},{"text":"bephosa inkatho ngeJerusalema,","poem":2},{"lineBreak":true},{"text":"wawunjengomunye wabo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Akumelanga weyise umfowenu","poem":1},{"text":"ngosuku lokuhlupheka kwakhe,","poem":2},{"text":"loba uthokoze ngabantu bakoJuda","poem":1},{"text":"ngosuku lokubhujiswa kwabo,","poem":2},{"text":"loba uklamase kangaka","poem":1},{"text":"ngosuku lokuhlupheka kwabo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Akumelanga ungene ngamasango abantu bami","poem":1},{"text":"ngosuku lomonakalo wabo,","poem":2},{"text":"loba ubeyise osizini lwabo","poem":1},{"text":"ngosuku lomonakalo wabo,","poem":2},{"text":"loba uthumbe inotho yabo","poem":1},{"text":"ngosuku lomonakalo wabo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Akumelanga ume emahlukanandlela","poem":1},{"text":"ukuba ubulale ababalekayo babo,","poem":2},{"text":"loba unikele abaphephileyo babo","poem":1},{"text":"ngosuku lokuhlupheka kwabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Usuku lukaThixo selusondele","poem":1},{"text":"ezizweni zonke.","poem":2},{"text":"Njengalokho okwenzileyo,","poem":1},{"text":"yikho okuzakwenziwa kuwe;","poem":2},{"lineBreak":true},{"text":"izenzo zakho zizaphendukela","poem":2},{"lineBreak":true},{"text":"phezu kwekhanda lakho.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Njengokunatha elakwenzayo entabeni yami,","poem":1},{"text":"ngokunjalo izizwe zonke zizanatha njalonjalo;","poem":2},{"text":"zizanatha, zinathe kuze kube","poem":1},{"text":"angathi kazizange zivele zibe khona.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kodwa phezu kweNtaba iZiyoni kuzakuba lokusindiswa;","poem":1},{"text":"kuzakuba ngcwele,","poem":2},{"lineBreak":true},{"text":"lendlu kaJakhobe izazuza ilifa layo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Indlu kaJakhobe izakuba ngumlilo","poem":1},{"text":"lendlu kaJosefa ibe lilangabi;","poem":2},{"text":"indlu ka-Esawu izakuba libibi,","poem":1},{"text":"njalo bazayithungela ngomlilo ozayiqothula.","poem":2},{"text":"Akuyikuba khona abasilayo","poem":1},{"text":"endlini ka-Esawu.”","poem":2},{"text":"UThixo usekhulumile.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Abantu abavela eNegebi","poem":1},{"text":"bazathumba izintaba zako-Esawu,","poem":2},{"text":"labantu abavela emawatheni ezintaba","poem":1},{"text":"bazathumba ilizwe lamaFilistiya.","poem":2},{"text":"Bazathumba amasimu ako-Efrayimi lawaseSamariya,","poem":1},{"text":"loBhenjamini uzathumba iGiliyadi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Lelibutho labako-Israyeli abathunjwayo abaseKhenani","poem":1},{"text":"lizalithatha ilizwe kusiyafika eZarefathi;","poem":2},{"text":"abathunjwa eJerusalema abaseSefaradi","poem":1},{"text":"bazathatha amadolobho aseNegebi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Abakhululi bazakhwela iNtaba iZiyoni","poem":1},{"text":"ukuba babuse izintaba zako-Esawu.","poem":2},{"lineBreak":true},{"text":"Njalo umbuso uzakuba ngokaThixo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/OBA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/AMO/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}