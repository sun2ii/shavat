{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Izaga zikaSolomoni indodana kaDavida, inkosi yako-Israyeli:"]},{"type":"verse","number":2,"content":[{"text":"ukuba abantu bazuze ukuhlakanipha lokuzithiba;","poem":1},{"text":"ukuba bazwisise amazwi okuqedisisa;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ukuba bazuze impilo yokuzithiba lobuqotho,","poem":1},{"text":"besenza okulungileyo, okufaneleyo lokuqondileyo;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ukunika ulwazi kwabayizithutha,","poem":1},{"text":"ulwazi lokukhetha okuqondileyo kwabatsha","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ukuthi ohlakaniphileyo alalele engeze ukufunda kwakhe,","poem":1},{"text":"kuthi obonisisayo azuze izeluleko,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ukuba abantu bazwisise izaga lemizekeliso,","poem":1},{"text":"izitsho lamalibho abahlakaniphileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ukwesaba uThixo kuyikuqala kwenhlakanipho,","poem":1},{"text":"kodwa iziwula ziyakweyisa ukuqedisisa lokuzithiba.","poem":2}]},{"type":"heading","content":["Isixwayiso Ngokukhangwa Yizoni"]},{"type":"verse","number":8,"content":[{"text":"Lalela, ndodana yami, izeluleko zikayihlo","poem":1},{"text":"njalo ungadeli imfundiso kanyoko.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kuzakuba ngumqhele omuhle ekhanda lakho","poem":1},{"text":"lomgaxo wokucecisa intamo yakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ndodana yami, aluba izoni zikuhuga,","poem":1},{"text":"ungaze wavuma.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nxa zisithi, “Woza sihambe;","poem":1},{"text":"kasicathamele abantu sichithe igazi,","poem":2},{"lineBreak":true},{"text":"kasicwathele omunye umuntu ongelacala;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"kasibaginye bephila njengengcwaba,","poem":1},{"text":"sibajwamule njengabawele emgodini;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"sizazuza impahla ezinhle ezehlukeneyo","poem":1},{"text":"sigcwalise izindlu zethu ngempango;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"phathisana lathi","poem":1},{"text":"ukuze sibelesikhwama sinye”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ndodana yami, ungahambi lazo,","poem":1},{"text":"ungalugxobi olwakho ezindleleni zazo;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ngoba ezabo inyawo zigijima ekoneni,","poem":1},{"text":"bachitha igazi lula.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kakusizi ukuthiya ngembule","poem":1},{"text":"lithe dandalazi emehlweni ezinyoni!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Abantu laba bacathamela ukuchitheka kwelabo igazi;","poem":1},{"text":"bajuma okwabo ukuphila.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sinjalo isiphetho salabo abadinga inzuzo ngobugebenga;","poem":1},{"text":"kuyayichitha impilo yalabo abayitholayo.","poem":2}]},{"type":"heading","content":["Isixwayiso Ngokufulathela Inhlakanipho"]},{"type":"verse","number":20,"content":[{"text":"Ukuhlakanipha kuyamemeza emgwaqweni,","poem":1},{"text":"kuphakamisa ilizwi lakho ezinkundleni;","poem":2}]},{"type":"verse","number":21,"content":[{"text":"kuyanqongoloza lezindleleni okuxokozela khona,","poem":1},{"text":"kuyatshumayela emasangweni omuzi kuthi:","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Koze kube nini lina zithutha lithanda ubuthutha benu na?","poem":1},{"text":"Koze kube nini izideleli zikholisa ukudelela","poem":2},{"lineBreak":true},{"text":"leziphukuphuku zizonda ulwazi na?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Lalelani ukukhuza kwami liphenduke!","poem":1},{"text":"Ngizalivulela isifuba sami,","poem":2},{"lineBreak":true},{"text":"ngilivezele imicabango yami.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kodwa ngenxa yokuthi langifulathela ngilibiza,","poem":1},{"text":"kwangabi khona onginanzayo ngiselula isandla sami,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"njengoba lala izeluleko zami","poem":1},{"text":"njalo kalavuma ukukhuza kwami,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ngakho lami ngizahleka selihlupheka;","poem":1},{"text":"ngizaliklolodela nxa lisehlelwa lusizi,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"nxa usizi lulehlela njengesiphepho;","poem":1},{"text":"nxa incithakalo ilikhukhula njengesivunguzane,","poem":2},{"lineBreak":true},{"text":"nxa usizi lezinhlupheko ziligabhela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Lapho-ke bazangibiza kodwa kangiyikusabela;","poem":1},{"text":"bazangidinga bangangitholi.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ngoba babeluzonda ulwazi","poem":1},{"text":"kabaze bakhetha ukwesaba uThixo","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ngoba kabavumanga iseluleko sami,","poem":1},{"text":"badelela ukukhuza kwami,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"bazakudla izithelo zokuhamba kwabo","poem":1},{"text":"basuthiswe ngezithelo zamacebo abo.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Phela ubuhlongandlebe bezithutha buzazibulala,","poem":1},{"text":"lokungananzi kweziphukuphuku kuzazibhubhisa;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"kodwa lowo ongilalelayo uzahlala evikelekile ekhululekile,","poem":1},{"text":"engesabi lutho olungamlimaza.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}