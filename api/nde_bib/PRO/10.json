{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":["Izaga zikaSolomoni:",{"text":"Indodana ehlakaniphileyo iletha ukuthokoza kuyise,","poem":1},{"text":"kodwa indoda eyisiwula iletha ukudabuka kunina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Inotho ezuzwe ngobuqili kayisizi lutho,","poem":1},{"text":"kodwa ukulunga kukhulula ekufeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"UThixo kayekeli abalungileyo belambile","poem":1},{"text":"kodwa uyavimbela izinkanuko zezixhwali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Izandla ezivilaphayo ziletha ubuyanga,","poem":1},{"text":"kodwa izandla ezikhutheleyo ziletha inotho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lowo obutha amabele ngesikhathi sawo yindodana ehlakaniphileyo,","poem":1},{"text":"kodwa olalayo ngesikhathi sokuvuna yindodana ehlazisayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Izibusiso zingumqhele womuntu olungileyo.","poem":1},{"text":"Kodwa ubudlwangudlwangu bugcwele emlonyeni womubi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Umkhumbulo ngomuntu olungileyo ubusisekile","poem":1},{"text":"kodwa ibizo lesigangi lizabola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Abahlakaniphileyo enhliziyweni bayalalela izeluleko,","poem":1},{"text":"kodwa isiphukuphuku esivala ngomsindo siyadilika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Umuntu oqotho uhamba engelakwesaba,","poem":1},{"text":"kodwa ohamba ngezindlela ezigobileyo uzadaluleka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Lowo oqwayiza ngomona uletha usizi,","poem":1},{"text":"lesiphukuphuku esivala ngomsindo siyadilika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Umlomo womuntu olungileyo ungumthombo wokuphila,","poem":1},{"text":"kodwa ubudlwangudlwangu bugcwele emlonyeni womubi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Inzondo idunga ingxabano,","poem":1},{"text":"kodwa uthando lusibekela bonke ububi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ukuhlakanipha kufunyanwa ezindebeni zalowo oqedisisayo;","poem":1},{"text":"kodwa uswazi lwehla emhlane walowo ongezwayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Abantu abahlakaniphileyo bayaluqoqa ulwazi,","poem":1},{"text":"kodwa umlomo wesiwula ugwegwa ukubhidlika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Inotho yezikhulu ingumuzi wazo ovikelweyo;","poem":1},{"text":"kodwa ubuyanga buyikudilika kwabampofu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Inzuzo yabalungileyo iyabaphilisa,","poem":1},{"text":"kodwa umholo wababi ubalethela ukujeziswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Lowo olalela ukuqondiswa utshengisa indlela yokuphila,","poem":1},{"text":"kodwa lowo oyala ukwelulekwa wedukisa abanye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Lowo ofihla inzondo yakhe ulendebe ezilamanga,","poem":1},{"text":"kuthi lowo onyeyayo yisiwula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Lapho okwande khona amazwi, isono kasisweleki,","poem":1},{"text":"kodwa lowo ogcina ulimi lwakhe uhlakaniphile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ulimi lomuntu olungileyo luyisiliva esikhethiweyo,","poem":1},{"text":"kodwa inhliziyo yesigangi kayisilutho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Izindebe zolungileyo ziphilisa abanengi;","poem":1},{"text":"kodwa iziwula ziyafa ngokuswela ingqondo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Isibusiso sikaThixo siletha inotho,","poem":1},{"text":"leyonotho ingabi lahlupho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Isiwula siyajabula ezenzweni zobubi,","poem":1},{"text":"kodwa umuntu ozwisisayo uthokoza ngokuhlakanipha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Lokho akwesabayo omubi kuzamfumana;","poem":1},{"text":"kodwa lokho akuloyisayo olungileyo uzakuphiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Nxa isiphepho sesikhukhule sedlula,","poem":1},{"text":"ababi sebedlule, kodwa abalungileyo bagxilile lanini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Njengeviniga emlonyeni, lentuthu emehlweni,","poem":1},{"text":"unjalo olesidensi kulabo abamthumayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ukumesaba uThixo kuyengeza ubude bempilo,","poem":1},{"text":"kodwa iminyaka yababi iyafinyezwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ikusasa yabalungileyo iyikuthokoza,","poem":1},{"text":"kodwa amathemba ababi aphelela ezeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Indlela kaThixo yisiphephelo sabalungileyo,","poem":1},{"text":"kodwa iyikubhidlika kwalabo abenza okubi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Abalungileyo kabasiphuleki,","poem":1},{"text":"kodwa ababi kabayikusala elizweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Umlomo womuntu olungileyo ukhupha inhlakanipho,","poem":1},{"text":"kodwa ulimi oluxhwalileyo luzaqunywa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Izindebe zabalungileyo ziyakwazi okufaneleyo,","poem":1},{"text":"kodwa umlomo wezigangi ukhupha izibozi.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}