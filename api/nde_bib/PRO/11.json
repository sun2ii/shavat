{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"UThixo uyazenyanya izilinganiso zokudlelezela,","poem":1},{"text":"kodwa uthokoza ngezilinganiso eziqondileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nxa kungena ukuzigqaja kungena lokweyisa,","poem":1},{"text":"kodwa ukuzithoba kuhamba lenhlakanipho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ubuqotho kwabaqondileyo buyabakhokhela,","poem":1},{"text":"kodwa abangathembekanga","poem":2},{"lineBreak":true},{"text":"babulawa yibumenemene babo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Inotho kayisizi lutho ngosuku lweziphithiphithi","poem":1},{"text":"kodwa ukulunga kuyaphephisa ekufeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ukulunga kwabangelacala kuqondisa indlela yabo,","poem":1},{"text":"kodwa ababi bawiswa yibubi babo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ukulunga kwabaqondileyo kuyabakhulula,","poem":1},{"text":"kodwa abangathembekanga","poem":2},{"lineBreak":true},{"text":"bagwenxwa yizinkanuko zabo ezimbi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Umuntu omubi angafa ithemba lakhe liyaphela;","poem":1},{"text":"konke abesithi uzakuzuza ngamandla akhe","poem":2},{"lineBreak":true},{"text":"kuphelela ezeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Umuntu olungileyo uyakhululwa enkathazweni,","poem":1},{"text":"kusuke kuyewela komubi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ngomlomo wakhe umuntu ongakholwayo uyamchitha umakhelwane,","poem":1},{"text":"kodwa ngolwazi abalungileyo bayaphepha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nxa kuphumelela abalungileyo umuzi uyathokoza;","poem":1},{"text":"nxa kusifa omubi kuba lokujabula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ngokubusiswa ngabalungileyo omubi ubalodumo,","poem":1},{"text":"kodwa ngomlomo wezigangi uyachitheka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Umuntu ongelangqondo weyisa umakhelwane wakhe,","poem":1},{"text":"kodwa umuntu ozwisisayo uthiba ulimi lwakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Onyeyayo wehluleka ukuvala isifuba sakhe,","poem":1},{"text":"kodwa othembekileyo uyayigcina imfihlo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Isizwe esingelabukhokheli obuqondileyo siyachitheka,","poem":1},{"text":"kodwa ngobunengi babeluleki siyanqoba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Lowo okhuphela omunye umuntu isibambiso uzahlupheka,","poem":1},{"text":"kodwa owalayo ukupha isibambiso uvikelekile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Umfazi olomusa uyahlonitshwa,","poem":1},{"text":"kodwa amadoda alesihluku azuza inotho kuphela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Umuntu olomusa uyazisiza,","poem":1},{"text":"kodwa umuntu ololunya uyazilimaza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Umuntu omubi uhola umvuzo wobuqili,","poem":1},{"text":"kodwa lowo ohlanyela ukulunga uvuna umvuzo omuhle.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Lowo omiyo ekulungeni uzuza ukuphila,","poem":1},{"text":"kodwa oxotshana lobubi uya ekufeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"UThixo uyabazonda abantu abalenhliziyo embi,","poem":1},{"text":"kodwa uyathokoza ngalabo abandlela zabo zilungile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kodwa yazi lokhu, ababi bazajeziswa","poem":1},{"text":"kodwa abalungileyo bazahlala bekhululekile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Njengesongo legolide lifakwe emakhaleni engulube,","poem":1},{"text":"unjalo umfazi omuhle kodwa ongelambeko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Izifiso zabalungileyo zizuza okuhle","poem":1},{"text":"kodwa ithemba lababi liphelela osizini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ophayo ngesihle uyazuza okunengi kulakuqala,","poem":1},{"text":"lowo ogodlayo ungenelwa yibuyanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Lowo ophayo uzaphumelela;","poem":1},{"text":"owonga abanye laye uzakongiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Abantu bayamqalekisa lowo ogodla amabele,","poem":1},{"text":"kodwa izibusiso zingumqhele walowo ovuma ukuwathengisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Lowo odinga ukulunga uzuza umusa,","poem":1},{"text":"kodwa okubi kwehlela lowo okudingayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Othembele enothweni yakhe uzakuwa;","poem":1},{"text":"kodwa olungileyo uzaphila njengehlamvu eliluhlaza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Olethela abendlu yakhe uhlupho ilifa lakhe yize,","poem":1},{"text":"lesihawu sizakuba yinceku yohlakaniphileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Izithelo zolungileyo ziyisihlahla sokuphila,","poem":1},{"text":"njalo lowo ozuza imiphefumulo uhlakaniphile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Nxa abalungileyo bezuza ukujeziswa emhlabeni","poem":1},{"text":"pho kuzakuba njani kwabangakholwayo labayizoni!","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/10.json","previousChapterAudioLinks":{},"numberOfVerses":31}