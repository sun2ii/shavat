{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Othanda ukuqondiswa uthanda ulwazi,","poem":1},{"text":"kodwa ozonda ukukhuzwa uyisithutha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Umuntu olungileyo uthola umusa kuThixo,","poem":1},{"text":"kodwa uThixo uyamlahla owakha amacebo amabi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Umuntu angazake amiswe yibubi,","poem":1},{"text":"kodwa olungileyo angeke aquphuke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Umfazi olesimilo ungumqhele womkakhe,","poem":1},{"text":"kodwa umfazi oyangisayo unjengokubola kwamathambo akhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Izimiso zabalungileyo ziqondile,","poem":1},{"text":"kodwa izeluleko zababi ziyinkohliso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Amazwi ababi alindele ukuchitha igazi,","poem":1},{"text":"kodwa inkulumo yabalungileyo iyabakhulula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Abantu ababi bayachithwa bangabe besaba khona,","poem":1},{"text":"kodwa indlu yolungileyo imi izinzile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Umuntu udunyiswa ngokuhlakanipha kwakhe,","poem":1},{"text":"kodwa abantu abalengqondo ezimbi bayeyiswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kungcono ukungabi ngubani kodwa ulesisebenzi,","poem":1},{"text":"kulokuzitshaya ulutho kodwa uswela lokudla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Umuntu olungileyo uyayinanzelela imfuyo yakhe","poem":1},{"text":"kodwa okuhle komuntu omubi yilunya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Lowo osebenza nzima emasimini akhe uzathola ukudla okunengi,","poem":1},{"text":"kodwa lowo ophika ngezifiso eziyize akalangqondo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ababi bahawukela impango yezigangi,","poem":1},{"text":"kodwa impande yabalungileyo imi iqinile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Umuntu omubi uthiyeka ngenkulumo yakhe yesono,","poem":1},{"text":"kodwa umuntu olungileyo uyaphepha enkathazweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Umuntu uzuza okuhle ngamazwi omlomo wakhe,","poem":1},{"text":"umsebenzi wezandla zakhe umnika inzuzo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Indlela yesiwula ikhanya iqondile kuso,","poem":1},{"text":"kodwa umuntu ohlakaniphileyo uyalalela izeluleko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Isiwula siyaphangisa ukuthukuthela,","poem":1},{"text":"kodwa umuntu olengqondo kananzi loba ethukwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Umfakazi oleqiniso upha ubufakazi obuqondileyo,","poem":1},{"text":"kodwa umfakazi ongathembekanga ukhuluma amanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Amazwi okubhuda agwaza njengenkemba,","poem":1},{"text":"kodwa ulimi lohlakaniphileyo luyelapha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Izindebe zeqiniso zimi lanini,","poem":1},{"text":"kodwa ulimi olulamanga luma umzuzwana nje.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Inhliziyo zabaceba ububi zigcwele inkohliso,","poem":1},{"text":"kodwa kulokuthokoza kwabaletha ukuthula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Akukho ngozi ewela abalungileyo,","poem":1},{"text":"kodwa izigangi zikhulelwa zinhlupho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"UThixo uyazenyanya izindlela ezilamanga,","poem":1},{"text":"kodwa uyathokoza ngabantu abaleqiniso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Umuntu olengqondo kazitshengiseli ulwazi lwakhe,","poem":1},{"text":"kodwa iziwula ziyabutshengisela ubuthutha bazo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Izandla ezikhutheleyo zizaletha inhlalakahle,","poem":1},{"text":"kodwa ubuvila budonsela ekugqilazweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Inhliziyo ekhathazekileyo iyamcakisa umuntu,","poem":1},{"text":"kodwa ilizwi elilomusa liyamthokozisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Umuntu olungileyo ukhetha abangane ngonanzelelo,","poem":1},{"text":"kodwa indlela yababi iyabaphumputhekisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Umzingeli olivila kazuzi nyama yokosa,","poem":1},{"text":"kodwa umuntu okhutheleyo uyazibula ngenotho yakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Endleleni yokulunga kulokuphila,","poem":1},{"text":"kuleyondlela kulokuphila okungapheliyo.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}