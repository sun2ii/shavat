{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"Indodana ehlakaniphileyo iyemukela izeluleko zikayise,","poem":1},{"text":"kodwa ihlongandlebe kalilaleli nxa likhuzwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Umuntu uzuza okuhle ngamazwi omlomo wakhe,","poem":1},{"text":"kodwa ababi batshisekela udlakela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Lowo olinda izindebe zakhe ulinda impilo yakhe,","poem":1},{"text":"kodwa lowo osuka abhede nje uyazibulala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ivila liyafisa kodwa lingazuzi lutho,","poem":1},{"text":"kodwa izifiso zokhutheleyo ziyagcwaliseka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Abalungileyo bayakuzonda okungamanga,","poem":1},{"text":"kodwa izigangi ziletha ihlazo lesigcono.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ukulunga kuyamlinda umuntu oqotho,","poem":1},{"text":"kodwa ububi buyamchitha oyisoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Umuntu angazenza onothileyo, yena engelalutho,","poem":1},{"text":"omunye azitshaye umyanga, kanti elenotho enengi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Inotho yomuntu ingahlenga impilo yakhe,","poem":1},{"text":"kodwa umyanga uvele kasongelwa muntu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Isibane sabalungileyo sikhanya sithi kla!","poem":1},{"text":"Kodwa isibane sezigangi siyafiphala ngentuthu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ukuziqakisa kukhokhelela engxabanweni,","poem":1},{"text":"kodwa ukuhlakanipha kufunyanwa kwabemukela ukwelulekwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Imali ezuzwe ngobuqili iyanyamalala,","poem":1},{"text":"kodwa lowo oyizuza ngokuqogelela uyayandisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ithemba eliphuzayo ligulisa inhliziyo,","poem":1},{"text":"kodwa isifiso esigcwalisiweyo siyisihlahla sokuphila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Lowo oweyisa izeluleko uzibizela ingozi,","poem":1},{"text":"kodwa othobela umlayo uzaphiwa umvuzo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Imfundiso yabahlakaniphileyo ingumthombo wokuphila,","poem":1},{"text":"iphephisa umuntu emijibileni yokufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ukuzwisisa okuhle kuletha ukuthandeka,","poem":1},{"text":"kodwa indlela yabakhohlisayo inzima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Wonke umuntu ohlakaniphileyo wenza konke ngolwazi,","poem":1},{"text":"kodwa isiwula sitshengisa ubuthutha baso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Isithunywa esibi siwela phakathi kohlupho,","poem":1},{"text":"kodwa isithunywa esithembekileyo siletha ukusila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ongananzi ukuqondiswa wehlelwa yibuyanga lehlazo,","poem":1},{"text":"kodwa onanza ukukhuzwa uyadunyiswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Simnandi emphefumulweni isifiso singagcwaliseka,","poem":1},{"text":"kodwa iziwula kazifuni ukutshiya ububi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ohamba lezihlakaniphi uyahlakanipha,","poem":1},{"text":"kodwa othandana leziwula uwela engozini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Umnyama ulandelana loyisoni,","poem":1},{"text":"kodwa impumelelo ingumvuzo wabalungileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Umuntu olungileyo utshiyela izizukulwane sakhe ilifa,","poem":1},{"text":"kodwa inotho yesoni ibekelwa abalungileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Insimu yomyanga ingathela ukudla okunengi,","poem":1},{"text":"kodwa umona wabalamandla uyayikhukhula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Lowo ongasebenzisi uswazi uyayizonda indodana yakhe,","poem":1},{"text":"kodwa lowo oyithandayo unqinekela ukuyiqondisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Olungileyo uyadla asuthe ntintinini,","poem":1},{"text":"kodwa isisu somubi sihlala silambile.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}