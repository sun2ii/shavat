{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Umfazi ohlakaniphileyo uyakha indlu yakhe,","poem":1},{"text":"kodwa lowo oyisiwula uyayibhidliza ngezandla zakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Lowo ohamba ngobuqotho uyamesaba uThixo,","poem":1},{"text":"kodwa lowo ondlela zakhe zigobile uyameyisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Inkulumo yesiwula isikhothisa ngoswazi emhlane,","poem":1},{"text":"kodwa indebe zalowo ohlakaniphileyo ziyamvikela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lapho okungelankabi khona isibaya siyize,","poem":1},{"text":"kodwa amandla enkabi aletha isivuno esinengi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Umfakazi oleqiniso kakhohlisi,","poem":1},{"text":"kodwa umfakazi ongelaqiniso uhutsha amanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Oweyisayo uyakudinga ukuhlakanipha kodwa kakutholi,","poem":1},{"text":"kodwa ulwazi luyazizela koqondisisayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Suka emuntwini oyisiwula,","poem":1},{"text":"ngoba awuyikuthola ulwazi ezindebeni zakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ukuhlakanipha kwabaqondayo yikuthi bayacabanga ngalokho abakwenzayo,","poem":1},{"text":"kodwa ubuthutha beziwula buyinkohliso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Iziwula zikwenza ubuthutha ukuphenduka ezonweni,","poem":1},{"text":"kodwa abaqotho bafisa ukwenza uxolo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Inhliziyo leyo laleyo iyakwazi ukudabuka kwayo,","poem":1},{"text":"njalo kakho ongakwazi ukuthokoza kwayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Indlu yomubi izadilizwa,","poem":1},{"text":"kodwa ithente loqotho lizaphumelela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kukhona indlela ebonakala ilungile emuntwini,","poem":1},{"text":"kodwa isiphetho sayo siyikufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ukuhleba kungabe kufihle ubuhlungu benhliziyo,","poem":1},{"text":"lokuthokoza kucine sekulusizi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Abangelakho bazavuzwa ngokubafaneleyo,","poem":1},{"text":"lomuntu olungileyo laye avuzwe ngokwakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Umuntu oyisithutha ukholwa loba yini,","poem":1},{"text":"kodwa olengqondo uyakucabangisisa konke akwenzayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Umuntu ohlakaniphileyo uyamesaba uThixo, axwaye okubi,","poem":1},{"text":"kodwa isiwula siliphikankani kodwa sizizwa sivikelekile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Umuntu olicaphucaphu wenza izinto zobuthutha,","poem":1},{"text":"lomuntu oliqili uyazondwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Abangazi lutho ilifa labo yibuwula,","poem":1},{"text":"kodwa abalengqondo betheswa umqhele wolwazi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Abantu ababi bazilahla phansi phambi kwabalungileyo,","poem":1},{"text":"lezixhwali ziguqa emasangweni abalungileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Abayanga bahlanyukelwa langabomakhelwane babo,","poem":1},{"text":"kodwa izinothi zilabangane abanengi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Lowo oweyisa umakhelwane wenza isono,","poem":1},{"text":"kodwa ubusisiwe olomusa kwabaswelayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kabalahleki yini abaceba ububi?","poem":1},{"text":"Kodwa abamisa ukwenza okuhle bafumana uthando lokuthembeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ukusebenza nzima konke kuletha inzuzo,","poem":1},{"text":"kodwa ukuqina ngomlomo kuthelela ubuyanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Inotho yabahlakaniphileyo ingumqhele wabo,","poem":1},{"text":"kodwa ubuphukuphuku beziwula buzala ubuthutha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Umfakazi oleqiniso uyabakhulula abantu,","poem":1},{"text":"kodwa umfakazi wamanga uyakhohlisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Lowo owesaba uThixo ulenqaba eqinileyo,","poem":1},{"text":"uzakuba yisiphephelo senzalo yakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ukumesaba uThixo kungumthombo wokuphila,","poem":1},{"text":"kuvikela umuntu emijibileni yokufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ubunengi babantu elizweni kuludumo enkosini,","poem":1},{"text":"kodwa nxa kungelabantu umbusi kasilutho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Umuntu obekezelayo uyazwisisa kakhulu,","poem":1},{"text":"kodwa ophanga ukuthukuthela uveza ubuthutha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ingqondo elokuthula iletha ukuphila emzimbeni,","poem":1},{"text":"kodwa umhawu ubolisa amathambo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Lowo oncindezela abayanga weyisa uMenzi wabo,","poem":1},{"text":"kodwa olomusa kwabaswelayo udumisa uNkulunkulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Nxa kufika ubunzima ababi bayadilika,","poem":1},{"text":"kodwa abalungileyo balesiphephelo lasekufeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Ukuhlakanipha kuzinzile enhliziyweni yabaqedisisayo,","poem":1},{"text":"kuyaziveza kanye lakwabayiziwula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Ukulunga kuyasiphakamisa isizwe,","poem":1},{"text":"kodwa isono silihlazo lakubaphi abantu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Inkosi iyathokoza ngenceku ehlakaniphileyo,","poem":1},{"text":"kodwa inceku ehlazisayo iyayithukuthelisa.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}