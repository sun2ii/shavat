{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"Impendulo ethobekileyo iyaludedisa ulaka,","poem":1},{"text":"kodwa ilizwi elilukhuni livusa ulaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ulimi lomuntu ohlakaniphileyo lukhulisa ulwazi,","poem":1},{"text":"kodwa umlomo wesiwula uphihlika ubuphukuphuku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Amehlo kaThixo asezindaweni zonke,","poem":1},{"text":"alinde ababi labalungileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ulimi oluletha ukuphola luyisihlahla sokuphila,","poem":1},{"text":"kodwa ulimi olukhohlisayo luyawephula umoya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Isiwula siyakulahla ukulaya kukayise,","poem":1},{"text":"kodwa owemukela ukuqondiswa uveza ukuhlakanipha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Indlu yolungileyo igcwele inotho,","poem":1},{"text":"kodwa inzuzo yababi ibehlisela uhlupho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Izindlela zabahlakaniphileyo ziyalwandisa ulwazi,","poem":1},{"text":"kodwa kazenzi njalo inhliziyo zeziwula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"UThixo uyawenyanya umhlatshelo wababi,","poem":1},{"text":"kodwa umkhuleko wabaqotho uyamthokozisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"UThixo uyayenyanya indlela yababi,","poem":1},{"text":"kodwa uyabathanda labo abalandela ukulunga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ukujeziswa okubuhlungu kumlindele ophambuka endleleni;","poem":1},{"text":"ozonda ukuqondiswa uzakufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"UKufa lokuBhujiswa kusobala phambi kukaThixo","poem":1},{"text":"kangakanani ke inhliziyo zabantu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Isideleli siyakuzonda ukuqondiswa;","poem":1},{"text":"kasibuzi kwabahlakaniphileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Inhliziyo ethokozayo yenza ubuso buchelese,","poem":1},{"text":"kodwa inhliziyo ebuhlungu yephula umoya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Inhliziyo eqedisisayo idinga ulwazi,","poem":1},{"text":"kodwa umlomo wesiwula wongiwa ngobuthutha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Zonke insuku zabancindezelweyo zilukhuni,","poem":1},{"text":"kodwa inhliziyo ethokozileyo ihlezi iminza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kungcono ukuba lokulutshwana umesaba uThixo","poem":1},{"text":"kulokuba lenotho enengi ulenhlupho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kungcono ukutsheba ngemibhida lapho okulothando khona,","poem":1},{"text":"kulokudla inyama enonileyo okugcwele khona inzondo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ololaka oluvuthayo ubanga ukuxabana,","poem":1},{"text":"kodwa umuntu obekezelayo uqeda inkani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Indlela yevila igcwele ameva,","poem":1},{"text":"kodwa indlela yomuntu olungileyo ikhamisile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Indodana ehlakaniphileyo iletha intokozo kuyise,","poem":1},{"text":"kodwa indoda eyisiwula yeyisa unina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ubuthutha bujabulisa umuntu ongelangqondo,","poem":1},{"text":"kodwa umuntu olokuzwisisa uhamba ngendlela eqondileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Amaqhinga ayehluleka nxa kungelazeluleko,","poem":1},{"text":"kodwa ayaphumelela ngabeluleki abanengi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Umuntu uyathokoza ngokupha impendulo eqondileyo","poem":1},{"text":"yeka kuhle kangakanani ukuzwa ilizwi elifaneleyo!","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Indlela yempilo iyimpumelelo kohlakaniphileyo","poem":1},{"text":"ukuze angalengeli engcwabeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"UThixo uyayibhidliza indlu yomuntu oziphakamisayo,","poem":1},{"text":"kodwa indawo yomfelokazi kayiyikuncitshiswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"UThixo uyayizonda imicabango yababi,","poem":1},{"text":"kodwa leyo eyabalungileyo iyamthabisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Indoda eyisihwaba iluhlupho kwabendlu yayo,","poem":1},{"text":"kodwa lowo ozonda ukufunjathiswa uzaphila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Olungileyo uyayihlolisisa impendulo engakaphenduli,","poem":1},{"text":"kodwa umlomo womubi ukhihliza okubi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"UThixo ukhatshana kwababi,","poem":1},{"text":"kodwa uyezwa umkhuleko wabalungileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ubuso obubobothekayo buletha intokozo enhliziyweni,","poem":1},{"text":"lezindaba ezinhle ziqinisa umzimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Lowo olalela ukukhuzwa okumphilisayo,","poem":1},{"text":"uzahlala kuhle labahlakaniphileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Lowo onganaki ukulaywa uyazeyisa yena ngokwakhe,","poem":1},{"text":"kodwa onanza iziqondiso uzuza ukuzwisisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Ukumesaba uThixo kufundisa umuntu ukuhlakanipha,","poem":1},{"text":"njalo ukuzithoba kwandulela udumo.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}