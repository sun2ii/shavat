{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"Umuntu angawabumba amacebo ngenhliziyo yakhe,","poem":1},{"text":"kodwa uThixo nguye omupha amazwi okuwachaza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Umuntu angabona sengathi zonke izindlela zakhe ziqondile,","poem":1},{"text":"kodwa uThixo uyazihlolisisa zonke injongo zomuntu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nikela kuThixo konke okwenzayo,","poem":1},{"text":"kuzaphumelelisa wonke amacebo akho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"UThixo uzilungisele isiphetho sakho konke","poem":1},{"text":"kanye lababi usuku lokubhujiswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"UThixo uyabazonda bonke abazikhukhumezayo.","poem":1},{"text":"Ngempela kabayikuphepha ukujeziswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Isono siyahlawulelwa ngothando langokwethembeka;","poem":1},{"text":"ngokwesaba uThixo umuntu uyaphepha ebubini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nxa izindlela zomuntu zimthokozisa uThixo,","poem":1},{"text":"uyenza lezitha zakhe zihlalisane laye ngokuthula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kungcono ukuzuza okulutshwana ngendlela elungileyo","poem":1},{"text":"kulokuzuza okunengi ngobuqili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Umuntu angalungisa indlela yakhe engqondweni yakhe,","poem":1},{"text":"kodwa uThixo nguye olawula izinyathelo zakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Izindebe zombusi zikhuluma kungathi lidlozi","poem":1},{"text":"ngakho umlomo wakhe kawungaphambuli umthetho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Izilinganiso eziqondileyo zivela kuThixo;","poem":1},{"text":"zonke izisindo ezisemgodleni zenziwa nguye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Amakhosi ayakuzonda ukwenza okubi,","poem":1},{"text":"ngoba isihlalo sobukhosi sakhelwe phezu kokulunga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Amakhosi athokoziswa yizindebe ezithembekileyo;","poem":1},{"text":"ayamazisa umuntu okhuluma iqiniso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ulaka lwenkosi luyisithunywa sokufa,","poem":1},{"text":"kodwa umuntu ohlakaniphileyo uyaluxolisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Nxa ubuso benkosi bulentokozo, kukhomba ukuphila;","poem":1},{"text":"ukuthandwa yiyo kunjengeyezi lezulu entwasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kungcono kangakanani ukuzuza ukuhlakanipha kulegolide,","poem":1},{"text":"ukukhetha ukuzwisisa kulesiliva!","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Umgwaqo womuntu oqotho uceza ububi;","poem":1},{"text":"lowo onanzelelayo indlela yakhe unanzelela impilo yakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ukuzigqaja kwandulela ukubhujiswa,","poem":1},{"text":"umoya omubi ulandelwa yikuwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kungcono umoya othobekileyo lokuhlala kwabancindezelweyo","poem":1},{"text":"kulokwabelana impango labazigqajayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Lowo olalela izeluleko uyaphumelela,","poem":1},{"text":"njalo ubusisiwe lowo othemba uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Abahlakaniphileyo enhliziyweni kuthiwa bayaqedisisa,","poem":1},{"text":"njalo amazwi amnandi aqinisa izeluleko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ukuzwisisa kungumthombo wokuphila kulabo abalakho,","poem":1},{"text":"kodwa ubuwula buletha isijeziso eziwuleni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Inhliziyo yomuntu ohlakaniphileyo ikhokhela umlomo wakhe,","poem":1},{"text":"kanti lezindebe zakhe zikhuthaza izeluleko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Amazwi amahle alikhekheba loluju,","poem":1},{"text":"amnandi emphefumulweni njalo ayelapha emathanjeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Kukhona indlela ebonakala ilungile emuntwini,","poem":1},{"text":"kodwa isiphetho sayo siyikufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Isisebenzi sifuqwa liphango ukusebenza kakhulu;","poem":1},{"text":"ukulamba yikho okusikhuthazayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Isixhwali siceba ububi,","poem":1},{"text":"lenkulumo yaso injengomlilo ohaqazayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Umuntu ongelangqondo udaza inkani,","poem":1},{"text":"njalo lomuntu onyeyayo wehlukanisa abangane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Umuntu wodlakela uhuga umakhelwane wakhe","poem":1},{"text":"amholele endleleni engalunganga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Lowo ofica ngelihlo lakhe uceba izibozi;","poem":1},{"text":"lowo oluma indebe zakhe uqonde ububi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Inwele ezimhlophe zingumqhele wobukhulu,","poem":1},{"text":"zizuzwa ngempilo elungileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Ungcono umuntu obekezelayo kuleqhawe,","poem":1},{"text":"umuntu ozinqandayo ulaka lwakhe kulalowo othumba idolobho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Inkatho iphoselwa enkundleni,","poem":1},{"text":"kodwa isinqumo sayo sisemandleni kaThixo.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}