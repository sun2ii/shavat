{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"Lungcono uqweqwe lwesinkwa umuntu elokuthula","poem":1},{"text":"kulendlu egcwele amagqibhagqibha okudla","poem":2},{"lineBreak":true},{"text":"kodwa kulengxabano.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Isisebenzi esihlakaniphileyo sizabusa indodana eyangisayo,","poem":1},{"text":"sizakwabelwa ilifa njengomunye wamadodana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Isiliva sincibilikiselwa embizeni,","poem":1},{"text":"imvutho ngeyegolide","poem":2},{"lineBreak":true},{"text":"kodwa uThixo uhlola inhliziyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Umuntu oxhwalileyo uyazilalela izindebe ezimbi;","poem":1},{"text":"lomqambimanga uyalulalela ulimi olulomona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lowo ohleka umyanga weyisa uMenzi wakhe;","poem":1},{"text":"oklolodayo nxa konakele kayikuphepha isijeziso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Abazukulu bangumqhele wabalupheleyo,","poem":1},{"text":"njalo labantwana baziqhenya ngabazali babo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Izindebe zokutshinga azisifanelanga isiwula","poem":1},{"text":"zimbi kangakanani ke izindebe zamanga kumbusi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Isivalamlomo siyintelezi kulowo osinikayo;","poem":1},{"text":"uyaphumelela kukho konke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ofihla ukona komunye uqinisa uthando,","poem":1},{"text":"kodwa okhuluma ngakho kokuphela","poem":2},{"lineBreak":true},{"text":"wehlukanisa abangane abasekhwapheni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ukukhuza kuyamqondisa umuntu olengqondo","poem":1},{"text":"kulokutshaya isiwula imvimvinya ezilikhulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Umuntu omubi udinga ukuhlamuka kuphela;","poem":1},{"text":"uzathunyelwa inxusa elilesihluku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kungcono ukuqondana lebhele","poem":1},{"text":"elithathelwe imidlwane yalo","poem":2},{"lineBreak":true},{"text":"kulokuhlangana lesiwula ebuthutheni baso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nxa umuntu ephindisela okuhle ngobubi,","poem":1},{"text":"ububi kabusoze basuka endlini yakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ukusungula inkani kunjengokubhidliza umduli wedamu;","poem":1},{"text":"ngakho yekela indaba ingakadaleki inkani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ukukhulula olecala lokugweba omsulwa","poem":1},{"text":"uThixo uyakuzonda kokubili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Isizani imali esandleni sesiwula,","poem":1},{"text":"sivele singatshisekeli ukuzuza ukuhlakanipha?","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Umngane ulothando ngezikhathi zonke,","poem":1},{"text":"lomzalwane uzalelwa izikhathi zenhlupheko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Umuntu ongananzeleliyo uyaziwisela anike isibambiso","poem":1},{"text":"enceda umakhelwane wakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Lowo othanda inkani uthanda isono;","poem":1},{"text":"lowo owakha isango eliphakemeyo udinga ukubhidlizwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Umuntu olenhliziyo exhwalileyo kaphumeleli;","poem":1},{"text":"lowo olimi lwakhe luyakhohlisa uwela ekuhluphekeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ukuba lendodana eyisiwula kuthelela usizi;","poem":1},{"text":"akulakuthokoza kuyise wesiwula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Inhliziyo ethokozayo ingumuthi omuhle,","poem":1},{"text":"kodwa umoya owephukileyo womisa amathambo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Umuntu omubi wamukela isivalamlomo ensitha","poem":1},{"text":"ukuze ahlanekele indlela yokwahlulela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Umuntu ohluzisisayo izinto ukhokhelwa yikuhlakanipha,","poem":1},{"text":"kodwa amehlo esiwula asabalala afike ekucineni komhlaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Indodana eyisiwula ithelela uyise","poem":1},{"text":"usizi lokudabuka kulowo owayizalayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Kakukuhle ukujezisa umuntu ongelacala,","poem":1},{"text":"loba ukufaka uswazi izisebenzi ngenxa yobuqotho bazo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Umuntu ololwazi ubeka amazwi akhe ngokunanzelela,","poem":1},{"text":"njalo umuntu oqedisisayo kathukutheli ngokuphangisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Lesiwula kuthiwa sihlakaniphile nxa sithule,","poem":1},{"text":"kuthiwe siyaqedisisa nxa sibamba ulimi lwaso.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/16.json","previousChapterAudioLinks":{},"numberOfVerses":28}