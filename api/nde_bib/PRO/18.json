{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"Umuntu ongelamusa uzifunela okwakhe;","poem":1},{"text":"uyazilahla zonke iziqondiso ezinhle.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Isiwula kasikuthakazeleli ukuzwisisa","poem":1},{"text":"kodwa sithokoza ngokutsho eyaso imibono.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nxa kufika ububi kufika lokweyisa,","poem":1},{"text":"njalo ihlazo liza lokudumazeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Amazwi omlomo womuntu ayinziki yamanzi,","poem":1},{"text":"kodwa umthombo wokuhlakanipha ngumfudlana ontuntuzayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kakukuhle ukulungisela ababi","poem":1},{"text":"loba ukungehluleli kuhle abangelacala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Izindebe zesiwula zisilethela ingxabano,","poem":1},{"text":"lomlomo waso unxusa ukutshaywa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Umlomo wesiwula yiwo osidilizayo,","poem":1},{"text":"lezindebe zaso zingumjibila womphefumulo waso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Amazwi omuntu onyeyayo anjengezibiliboco;","poem":1},{"text":"angena ekujuleni kwenhliziyo yomuntu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Lowo ovilaphayo emsebenzini wakhe","poem":1},{"text":"ungumfowabo walowo odilizayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ibizo likaThixo liyinqaba eqinileyo;","poem":1},{"text":"abalungileyo babalekela kulo baphephe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Inotho yezikhulu ingumuzi wazo ovikelweyo;","poem":1},{"text":"zicabanga ukuthi imiduli yawo ayikhweleki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Umuntu uyazikhukhumeza ngenhliziyo yakhe,","poem":1},{"text":"mandulo kokuba awe,","poem":2},{"lineBreak":true},{"text":"ikanti ukuzithoba kwandulela udumo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Lowo ophendulayo engaqali alalele","poem":1},{"text":"lobo yibuwula bakhe lehlazo lakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Umphefumulo womuntu uyamqinisa nxa egula,","poem":1},{"text":"kodwa ngubani ongaphila elomoya owephukileyo na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Inhliziyo yabaqedisisayo izuza ulwazi;","poem":1},{"text":"indlebe zabahlakaniphileyo ziyakudinga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Isipho siyamvulela indlela ophayo","poem":1},{"text":"azuze ithuba lokubonana labakhulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ecaleni okhuluma kuqala ubonakala enguye olungileyo,","poem":1},{"text":"kuze kuqhamuke omunye ambuzisise.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ukwenza inkatho kuyakuqeda ukulwisana,","poem":1},{"text":"kubehlukanise abaxabanayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Umzalwane owonelweyo","poem":1},{"text":"uba lukhuni kulomuzi ohonqolozelweyo,","poem":2},{"lineBreak":true},{"text":"lezingxabano zinjengamasango enqaba avaliweyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Isisu somuntu sigcwaliswa yizithelo zomlomo wakhe;","poem":1},{"text":"usuthiswa yisivuno sezindebe zakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ulimi lulamandla okuphila lokufa,","poem":1},{"text":"njalo labo abaluthandayo bazakudla izithelo zalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Lowo ozuza umfazi ufumana okuhle,","poem":1},{"text":"athole umusa kuThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Umyanga uyancenga ukuthi axolelwe,","poem":1},{"text":"kodwa isinothi siphendula ngolaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Umuntu olabangane abanengi ucina kubi,","poem":1},{"text":"kodwa kuba khona umngane othembeka okudlula umfowenu.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}