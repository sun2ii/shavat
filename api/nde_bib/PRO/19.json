{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"Ungcono umyanga ohamba ngobuqotho","poem":1},{"text":"kulesiwula esilezindebe ezingcolileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kakulunganga ukutshiseka kodwa ungelalwazi,","poem":1},{"text":"loba ukuwalazela uze ulahlekelwe yindlela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ubuwula bomuntu budiliza impilo yakhe,","poem":1},{"text":"ikanti inhliziyo yakhe ithukuthelela uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Inotho iletha abangane abanengi,","poem":1},{"text":"kodwa umyanga ufulathelwa ngumngane wakhe weduze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Umfakazi wamanga uthola isijeziso,","poem":1},{"text":"lalowo ohutshuza amanga kayikuphunyuka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Banengi abazincengela ukuthandwa ngumbusi,","poem":1},{"text":"njalo wonke umuntu ngumngane walowo ophanayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Umyanga uhlanyukelwa yizihlobo zakhe zonke,","poem":1},{"text":"pho abangane bakhe bona bamnina kangakanani!","poem":2},{"text":"Lanxa ebancenga kangakanani,","poem":1},{"text":"ngeke esabathola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lowo ozuze ukuhlakanipha uthanda umphefumulo wakhe;","poem":1},{"text":"lowo ogogosa ukuzwisisa uyaphumelela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Umfakazi wamanga uthola isijeziso,","poem":1},{"text":"njalo lowo ohutshuza amanga uzabhubha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kakusifanelanga isiwula ukuthi sihlale enothweni","poem":1},{"text":"kubi kangakanani ukuthi isigqili sibuse amakhosana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ukuhlakanipha komuntu kumupha isineke;","poem":1},{"text":"kumupha udumo ukunganaki ukuqalwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ukuthukuthela kwenkosi kunjengokubhonga kwesilwane,","poem":1},{"text":"kodwa ukuthandwa yiyo kunjengamazolo etshanini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Indodana eyisiwula iyamchitha uyise,","poem":1},{"text":"lomfazi olenkani","poem":2},{"lineBreak":true},{"text":"unjengamanzi athonta ephahleni njalonje.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Izindlu lenotho yilifa elizuzwa ebazalini,","poem":1},{"text":"kodwa umfazi ozwisisayo uvela kuThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ubuvila buletha ubuthongo obukhulu,","poem":1},{"text":"njalo umuntu owehluleka ukuzenwaya uyalamba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Lowo olalela izeluleko uvikela impilo yakhe,","poem":1},{"text":"kodwa lowo ozedelelayo uzakufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Olomusa kubayanga upha uThixo,","poem":1},{"text":"uzamupha umvuzo ngalokho akwenzayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Qondisa indodana yakho, ngoba lokho kuzayisiza;","poem":1},{"text":"ungabi lengxenye yokuyibulala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Umuntu ololaka oluphuphumayo luyamtshayisa,","poem":1},{"text":"ungamlamulela, usuzahlala umlamulela njalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Lalela ukucetshiswa, wamukele ukuqondiswa,","poem":1},{"text":"ngoba ekucineni uzahlakanipha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Inhliziyo yomuntu igcwele amacebo amanengi,","poem":1},{"text":"kodwa yisimiso sikaThixo esimayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Umuntu uloyisa uthando olungaqamukiyo;","poem":1},{"text":"kungcono ukuba ngumyanga kulokuba lamanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ukumesaba uThixo kuholela ekuphileni:","poem":1},{"text":"olakho uhlala esuthisekile, engathintwa yizinhlupheko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ivilavoxo litshonisa isandla salo emganwini,","poem":1},{"text":"liyehluleke ukubuyisa isandla emlonyeni lidle.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Thela uswazi isideleli, abathobekileyo bazafunda ukuhlakanipha;","poem":1},{"text":"khuza umuntu oqedisisayo, uzazuza ulwazi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Lowo ontshontshela uyise, axotshe unina","poem":1},{"text":"yindodana ethelela inhloni lehlazo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Nxa uyekela ukulandela izeluleko, ndodana yami,","poem":1},{"text":"uzalahleka utshiye amazwi okwazi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Umfakazi oxhwalileyo uyawudelela umthetho,","poem":1},{"text":"lomlomo womubi uminza ububi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Izijeziso zilungiselwe izideleli,","poem":1},{"text":"loswazi ngolwemihlane yeziwula.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}