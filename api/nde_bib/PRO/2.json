{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":2,"content":[{"type":"heading","content":["Imivuzo Emihle Yokuhlakanipha"]},{"type":"verse","number":1,"content":[{"text":"Ndodana yami, nxa usamukela amazwi ami","poem":1},{"text":"ugcine imilayo yami ngaphakathi kwakho,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"uvule indlebe yakho izwe ukuhlakanipha","poem":1},{"text":"unikele inhliziyo yakho ukuthi izwisise,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"njalo nxa ucela ukuqedisisa","poem":1},{"text":"ukhalela kakhulu ukuzwisisa,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"futhi ukudingisisa njengokudinga isiliva","poem":1},{"text":"ukuphenye njengento eligugu efihliweyo,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"lapho-ke uzakuzwisisa ukumesaba uThixo","poem":1},{"text":"njalo uluzuze ulwazi lukaNkulunkulu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngoba uThixo uyapha ukuhlakanipha,","poem":1},{"text":"emlonyeni wakhe kuphuma ulwazi lokuqedisisa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Abaqotho ubapha ukunqoba,","poem":1},{"text":"ulihawu lalabo abahamba bengasoleki,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ngoba uyayilinda indlela yabalungileyo","poem":1},{"text":"avikele ukuhamba kwabathembekileyo bakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yikho uzazwisisa lokho okulungileyo lokuqondileyo lokufaneleyo","poem":1},{"text":"zonke izindlela ezinhle.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngoba ukuhlakanipha kuzangena enhliziyweni yakho,","poem":1},{"text":"lolwazi lube mnandi emphefumulweni wakho.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ukwazi ukukhetha kuzakuvikela,","poem":1},{"text":"lokuzwisisa kuzakulinda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ukuhlakanipha kuzakusindisa ezindleleni zabantu ababi,","poem":1},{"text":"abantu abamazwi abolileyo,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"abatshiya izindlela eziqondileyo,","poem":1},{"text":"bahambe ngezindlela ezilamathunzi,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"abathokoza ngokwenza okubi","poem":1},{"text":"bajabule ngokungcola kokubi,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"abandlela zabo zitshekile","poem":1},{"text":"lokuhamba kwabo kakuqondakali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kuzakukhulula njalo koyisiphingikazi,","poem":1},{"text":"lasemfazini olamazwi akhohlisayo,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"osetshiye indoda yakhe yobutsha bakhe","poem":1},{"text":"wadela isifungo asenza phambi kukaNkulunkulu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngoba indlu yakhe iholela ekufeni","poem":1},{"text":"lezindlela zakhe zidonsela kwabafileyo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kakho ongena kuye obuyayo","poem":1},{"text":"kumbe aphinde azuze izindlela zokuphila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ngakho uzahamba ezindleleni zabantu abalungileyo","poem":1},{"text":"walele emikhondweni yabaqondileyo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ngoba abaqotho bazahlala elizweni,","poem":1},{"text":"labangasolekiyo bazasala kulo;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"kodwa izigangi zizasuswa elizweni,","poem":1},{"text":"labangathembekanga bazakhutshwa kulo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}