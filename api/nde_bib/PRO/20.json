{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"Iwayini lenza ukudelela lotshwala buyaxabanisa,","poem":1},{"text":"okhohliswa yilezi izinto kahlakaniphanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ulaka lwenkosi lunjengokubhonga kwesilwane;","poem":1},{"text":"lowo oyizondisayo udela impilo yakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kumupha udumo umuntu ukubalekela ukuxabana,","poem":1},{"text":"kodwa iziphukuphuku zonke ziphangisa ukuthenga inkani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ivila kalilimi ngesikhathi esifaneleyo;","poem":1},{"text":"kuthi ngesikhathi sokuvuna liswele amabele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Izifiso zenhliziyo yomuntu zingamanzi azikileyo,","poem":1},{"text":"kodwa umuntu ozwisisayo uyazifinyelela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Banengi abathi balothando olungapheliyo,","poem":1},{"text":"kodwa ngubani ongamthola umuntu othembekileyo na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Umuntu olungileyo uphila impilo encomekayo;","poem":1},{"text":"babusisiwe abantwabakhe abamfuzayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Inkosi nxa ihlezi esihlalweni sayo isahlulela,","poem":1},{"text":"iyakuhlungula konke okubi ngamehlo ayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ngubani ongathi, “Ngiyigcinile inhliziyo yami imhlophe;","poem":1},{"text":"ngihlanzekile kangilasono?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Izisindo ezitshiyanayo","poem":1},{"text":"lezilinganiso ezitshiyanayo uThixo uyakuzonda kokubili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Lomntwana waziwa ngezenzo zakhe,","poem":1},{"text":"ngokuthi isimilo sakhe sihle, siqotho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Indlebe ezizwayo lamehlo abonayo","poem":1},{"text":"kokubili kwenziwa nguThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ungathandani lobuthongo uzakuba ngumyanga,","poem":1},{"text":"hlala uvukile uzakuba lokudla okunengi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Kubi, kubi!” kutsho umthengi;","poem":1},{"text":"esuka lapho usezincoma ngakuthengileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Likhona igolide lamatshe aligugu amanengi,","poem":1},{"text":"kodwa izindebe ezikhuluma ulwazi zilivelakancane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Thatha isembatho salowo owenzela owezizweni isibambiso;","poem":1},{"text":"sigcine nxa ebambisela owesifazane ongaziphathanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ukudla okuzuzwe ngenkohliso kumnandi emuntwini,","poem":1},{"text":"kodwa kucina sekungathi udla itshebetshebe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Nxa usenza amacebo dinga izeluleko;","poem":1},{"text":"nxa usiyahlasela zuza ukuqondiswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Onyeyayo uyehluleka ukugcina imfihlo,","poem":1},{"text":"ngakho yehlukana lomuntu okhuluma angathuli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Nxa umuntu ethuka uyise loba unina,","poem":1},{"text":"isibane sakhe sizacinywa abesemnyameni omubi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ilifa elizuzwa lula ekuqaleni","poem":1},{"text":"alilakubusiswa ekucineni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ungabokuthi, “Lami ngizakulungisa ngalokhu ongenze khona!”","poem":1},{"text":"Yekela, uThixo nguye ozakusiza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"UThixo uyazizonda izilinganiso eziguquguqulwayo,","poem":1},{"text":"njalo kathokoziswa yizikali zokudlelezela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Izinyathelo zomuntu zikhokhelwa nguThixo.","poem":1},{"text":"Pho umuntu angayazi kanjani na indlela yakhe?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Yikuzithiya ukuthembisa ngokuphangisa ukupha ulutho,","poem":1},{"text":"phambili umuntu aphinde azisole ngalesosifungo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Inkosi ehlakaniphileyo iyabahlungula ababi;","poem":1},{"text":"iyabahadla njengelitshe lokuchola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Isibane sikaThixo siyawuhlolisisa umphefumulo womuntu;","poem":1},{"text":"sihlolisisa ekujuleni kwemibilini yakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Uthando lokwethembeka kuyayivikela inkosi;","poem":1},{"text":"ngothando isihlalo sayo sobukhosi sivikelekile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Udumo lwamajaha lusemandleni awo,","poem":1},{"text":"izimvu zekhanda ziyinkazimulo yabadala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Izidutshulo lamanxeba kugezisa okubi,","poem":1},{"text":"lezibhaxulo zihlambulula ingaphakathi.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":30}