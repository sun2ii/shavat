{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"Inhliziyo yenkosi isezandleni zikaThixo,","poem":1},{"text":"uyiholela lapho athanda khona njengomsele wamanzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Umuntu ubona kungathi zonke izindlela zakhe zilungile,","poem":1},{"text":"kodwa uThixo uhlola inhliziyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ukwenza okulungileyo lokufaneleyo","poem":1},{"text":"kuyathandeka kuThixo kulomhlatshelo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Amehlo okuzikhukhumeza lenhliziyo ezigqajayo,","poem":1},{"text":"okuyikho okukhokhela ababi, konke yizono!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Amalungiselelo abakhutheleyo anika umvuzo","poem":1},{"text":"njengoba nje amawala eletha ubuyanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Inotho ezuzwe ngendlela yamanga","poem":1},{"text":"iyinkungu ememethekayo lomjibila wokufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ukuhlukuluza kwababi kuzabakhukhula,","poem":1},{"text":"ngoba bayala ukwenza okulungileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Indlela yomuntu olecala iyathubezela,","poem":1},{"text":"kodwa ukwenza kongelalo kuqondile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kungcono ukuhlala ekhulusini lophahla lwendlu","poem":1},{"text":"kulokuhlala ndlu yinye lomfazi olomlomo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Umuntu omubi utshisekela ububi;","poem":1},{"text":"kalasihawu ngomakhelwane wakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nxa kujeziswa isideleli isithutha sizuza ukuhlakanipha;","poem":1},{"text":"nxa ohlakaniphileyo eqondiswa uzuza ulwazi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Olungileyo uyayinanzelela indlu yesigangi","poem":1},{"text":"kuthi lesosigangi asibhubhise.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nxa umuntu egcika indlebe zakhe ukuze angezwa ukukhala kwabayanga,","poem":1},{"text":"laye uzakuthi esekhala angalalelwa muntu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Isipho esiphiwa ensitha siyaludedisa ulaka,","poem":1},{"text":"lesivalamlomo esifihlwe emajazini siyakudedisa ukuthukuthela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ukwahlulela kuhle kuthokozisa olungileyo","poem":1},{"text":"kodwa izigangi kuzitshayisa uvalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Umuntu ophambuka endleleni yokuzwisisa","poem":1},{"text":"ucina esendawonye labafileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Lowo othanda ukuzithokozisa uzakuba ngumyanga;","poem":1},{"text":"laloba ngubani othanda iwayini lezibondlo ngeke anothe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ababi baba ngumhlawulelo wabalungileyo,","poem":1},{"text":"labangathembekanga bangumhlawulelo wabaqotho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kungcono ukuhlala enkangala","poem":1},{"text":"kulokuhlala lomfazi olenkani lothethayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Indlu yohlakaniphileyo igcwele amaqubaquba ezibiliboco lamafutha,","poem":1},{"text":"kodwa umuntu oyisithutha udla aqede du konke alakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Lowo odinga ukulunga lothando","poem":1},{"text":"uzuza ukuphila, ukuphumelela lodumo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Umuntu ohlakaniphileyo uhlasela umuzi wabalamandla","poem":1},{"text":"adilizele phansi inqaba abayithembileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Lowo oqaphela umlomo wakhe lolimi lwakhe","poem":1},{"text":"uyaziphephisa ezingozini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Umuntu ozigqajayo loyisiqholo ibizo lakhe ngu “Sideleli,”","poem":1},{"text":"wenza izinto ngokuziqakisa okukhulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Izinkanuko zevila yizo ezililimazayo,","poem":1},{"text":"ngoba izandla zalo ziyala ukusebenza.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ilanga lonke litshona lifisa okungapheliyo,","poem":1},{"text":"kodwa abalungileyo bayapha bengagodli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Umhlatshelo wababi uyisinengiso","poem":1},{"text":"kambe mubi kangakanani nxa ulethwa ngenhliziyo embi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Umfakazi wamanga uzabhubha,","poem":1},{"text":"kuthi lowo omlalelayo uzabhujiswa lanini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Umuntu omubi utshengisa isibindi samanga,","poem":1},{"text":"kodwa umuntu oqotho uyananzelela izenzo zakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Akulakuhlakanipha, akulambono, akulacebo","poem":1},{"text":"okunganqoba uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ibhiza liyalungiselelwa usuku lwempi,","poem":1},{"text":"kodwa ukunqoba kulawulwa nguThixo.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}