{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"Ibizo elihle liyathandeka kulenotho enengi;","poem":1},{"text":"ukuhlonitshwa kungcono kulesiliva kumbe igolide.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Abanothileyo labayanga bayafanana ngalokhu:","poem":1},{"text":"UThixo unguMenzi wabo bonke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Umuntu olengqondo uthi ebona ingozi acatshe,","poem":1},{"text":"kodwa isithutha siyaphikelela singena enkathazweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ukuzithoba lokwesaba uThixo","poem":1},{"text":"kuletha inotho lodumo lokuphila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Endleleni yababi kugcwele ameva lemjibila,","poem":1},{"text":"kodwa onanzelela umphefumulo wakhe unqenqela khatshana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Fundisa umntwana indlela amele ahambe ngayo,","poem":1},{"text":"kuzakuthi esemdala kayikuphambuka kuyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Abanothileyo babusa abayanga,","poem":1},{"text":"lalowo owebolekayo uyisichaka salowo omebolekayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lowo ohlanyele ububi uvuna ukuhlupheka,","poem":1},{"text":"njalo uswazi lolaka lwakhe luzakwephulwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Umuntu ophanayo uzabusiswa,","poem":1},{"text":"ngoba wabela abayanga ukudla kwakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Xotsha isideleli, lenkani ihle iphume;","poem":1},{"text":"ukuxabana lokuthukana kuyaphela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Othanda inhliziyo ehlanzekileyo, onkulumo yakhe ipholile","poem":1},{"text":"uzakuba ngumngane wombusi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Amehlo kaThixo ayaluvikela ulwazi","poem":1},{"text":"kodwa uyawadiliza amazwi abangathembekanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ivilavoxo lithi, “Kulesilwane phandle!","poem":1},{"text":"Ngizabulawa ezindleleni!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Umlomo wesifebekazi unjengomgodi otshonayo;","poem":1},{"text":"lowo othukwe nguThixo uzawobokela kuwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ubuwula bugxilile enhliziyweni yomntwana,","poem":1},{"text":"kodwa uswazi lokuqondisa luzabuxotshela khatshana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Lowo oncindezela abayanga ukuze anothe ngabo,","poem":1},{"text":"lalowo oncenga abanothileyo ngezipho,","poem":2},{"lineBreak":true},{"text":"bonke bacina sebengabayanga.","poem":2}]},{"type":"heading","content":["Ilizwi Lakuqala"]},{"type":"verse","number":17,"content":[{"text":"Lalela uzwe amazwi ezihlakaniphi;","poem":1},{"text":"nikela inhliziyo yakho ezifundweni zami,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ngoba kuyathokozisa nxa uzigcina enhliziyweni yakho,","poem":1},{"text":"uzitsho kalula ngezindebe zakho.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ukuze ithemba lakho lihlale kuThixo,","poem":1},{"text":"yikho ngikufundisa lamuhla wena ngokwakho.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kangikulobelanga yini izitsho ezingamatshumi amathathu,","poem":1},{"text":"izitsho zokweluleka lolwazi,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ezikufundisa amazwi eqiniso athembekileyo,","poem":1},{"text":"ukuze ukwazi ukupha impendulo ezilesisindo","poem":2},{"lineBreak":true},{"text":"kulowo okuthumileyo na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ungagegeleli abayanga ngoba bengabayanga","poem":1},{"text":"njalo ungaphoseli abaswelayo entolongweni,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ngoba uThixo uzakuba ngumeli wabo","poem":1},{"text":"abahlukuluze labo ababahlukuluzayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ungabi ngumngane womuntu ololaka,","poem":1},{"text":"ungahambi lomuntu ozonda masinyane,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"funa ufunde izindlela zakhe","poem":1},{"text":"uzingenise emjibileni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ungabi ngumuntu ophanga ukwenza izithembiso","poem":1},{"text":"kumbe onika isibambiso ngezikwelede;","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ungayiswela inhlawulo","poem":1},{"text":"uzakwemukwa noma ngumbheda wakho olala kuwo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ungasusi ilitshe lakudala elomngcele","poem":1},{"text":"elabekwa ngokhokho bakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Uyambona umuntu oyingcitshi emsebenzini wakhe na?","poem":1},{"text":"Uzasebenzela amakhosi;","poem":2},{"lineBreak":true},{"text":"akayikusebenzela abantukazana.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}