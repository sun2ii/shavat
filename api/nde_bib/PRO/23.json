{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"Nxa uhlala phansi usidla lombusi,","poem":1},{"text":"nanzelela ukuthi kuyini okuphambi kwakho,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ungazifaki ingqamu entanyeni","poem":1},{"text":"nxa uhugwa yibuhwaba.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ungahawukeli izibiliboco zakhe","poem":1},{"text":"ngoba lokho kudla kuyakhohlisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ungazihlukuluzi uzigugise ngomsebenzi uzama inotho;","poem":1},{"text":"hlakanipha wazi ukuzikhuza.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ungayibona manje inotho, masinyane isinyamalele,","poem":1},{"text":"ngoba ngempela izamila impiko","poem":2},{"lineBreak":true},{"text":"iphaphele emkhathini njengengqungqulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ungakudli ukudla komuntu oncitshanayo,","poem":1},{"text":"ungazihawukeli izibiliboco zakhe;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ngoba yena uhlezi ebalisa ngendleko.","poem":1},{"text":"Angathi kuwe, “Dlana unathe,”","poem":2},{"lineBreak":true},{"text":"kodwa kungasuki enhliziyweni yakhe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Uzakuhlanza okuncane lokho okudlileyo","poem":1},{"text":"ube udlalise amazwi akho okubonga.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ungakhulumi lesithutha","poem":1},{"text":"ngoba sizakweyisa inhlakanipho yamazwi akho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ungasusi ilitshe lakudala elomngcele","poem":1},{"text":"loba uzithathele amasimu ezintandane,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ngoba uMhlengi wazo ulamandla;","poem":1},{"text":"uzakuba ngumeli wazo aphikisane lawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nikela inhliziyo yakho ekufundisweni","poem":1},{"text":"lezindlebe zakho emazwini olwazi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ungayekeli ukumlaya umntwana;","poem":1},{"text":"ukumtshaya ngoswazi akuyikumbulala.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mjezise ngoswazi","poem":1},{"text":"ukuze uphephise umphefumulo wakhe ekufeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ndodana yami, aluba inhliziyo yakho ihlakaniphile,","poem":1},{"text":"inhliziyo yami layo izathokoza;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ingaphakathi yami izajabula","poem":1},{"text":"lapho izindebe zakho zikhuluma okulungileyo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Inhliziyo yakho mayingahawukeli izoni,","poem":1},{"text":"kodwa hlala utshisekela ukwesaba uThixo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngeqiniso lihle ikusasa lakho,","poem":1},{"text":"lethemba lakho kaliyikucitshwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Lalela, ndodana yami, uhlakaniphe,","poem":1},{"text":"ubeke inhliziyo yakho endleleni elungileyo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ungahlangani leziminzi zewayini","poem":1},{"text":"labazitika ngenyama,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ngoba izidakwa lezihwaba ziba ngabayanga,","poem":1},{"text":"ukuwozela kwazo kuzembese amadabudabu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Lalela uyihlo owakuletha emhlabeni,","poem":1},{"text":"njalo ungeyisi unyoko nxa eseluphele.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Thenga iqiniso ungalithengisi;","poem":1},{"text":"zuza ukuhlakanipha lokuzikhuza lokuzwisisa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Uyise womuntu olungileyo uyathokoza kakhulu;","poem":1},{"text":"lowo olendodana ehlakaniphileyo uyathokoza ngayo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Sengathi uyihlo lonyoko bangathokoza;","poem":1},{"text":"sengathi lowo owakuzalayo angajabula!","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ndodana yami, ngipha inhliziyo yakho,","poem":1},{"text":"amehlo akho ahlale ezindleleni zami,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ngoba isifebe singumgodi otshonayo","poem":1},{"text":"lomfazi olibele lendlela ungumthombo oyingozi.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Uyacathamela njengesigebenga,","poem":1},{"text":"andise amadoda angathembekanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ngubani ohlaba umkhosi?","poem":1},{"text":"Ngubani olosizi na?","poem":2},{"text":"Ngubani otshingayo?","poem":1},{"text":"Ngubani olensolo na?","poem":2},{"text":"Ngubani omahluzuhluzu ngeze?","poem":1},{"text":"Ngubani omehlo abomvu gebhu na?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Yilabo abalibala ngewayini,","poem":1},{"text":"abahamba bedinga inzwisa yewayini elidibanisiweyo.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Ungahugwa liwayini ulibona libomvu,","poem":1},{"text":"nxa likhazimula enkomitshini,","poem":2},{"lineBreak":true},{"text":"lapho lisehla kamnandi!","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ekucineni liluma njengenyoka","poem":1},{"text":"libe lobuhlungu obubulalayo njengenhlangwana.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Amehlo akho azabona izinto ezingaqedakaliyo","poem":1},{"text":"lengqondo yakho icabange izinto ezididayo.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Uzakuba njengomuntu ondendayo phakathi kolwandle,","poem":1},{"text":"olele esiqongweni sensika yomkhumbi.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Uzakuthi, “Bangitshayile kodwa kangilimalanga!","poem":1},{"text":"Bangibethile kodwa kakubuhlungu!","poem":2},{"lineBreak":true},{"text":"Ngizavuka nini bo ngiyodinga obunye utshwala?”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}