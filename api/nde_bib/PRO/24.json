{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"Ungabahawukeli abantu abaxhwalileyo,","poem":1},{"text":"ungafisi ubungane labo;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ngoba ezingqondweni zabo bahlose udlakela,","poem":1},{"text":"lezindebe zabo zikhuluma ngokuvusa umsindo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Indlu yakhiwa ngokuhlakanipha,","poem":1},{"text":"imiswe ngokuzwisisa;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"amakamelo ayo agcwaliswe ngolwazi,","poem":1},{"text":"agcwaliswe ngemiceciso yakude eligugu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Umuntu ohlakaniphileyo ulamandla amakhulu,","poem":1},{"text":"njalo umuntu ololwazi uyandisa amandla;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ukuthi unqobe empini kufunakala izeluleko,","poem":1},{"text":"lokunqoba kudinga abeluleki abanengi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ukuhlakanipha kuphakeme kakhulu koyisiwula;","poem":1},{"text":"enkundleni kalalutho angalukhuluma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lowo oceba ububi","poem":1},{"text":"uzakwaziwa njengomacebomabi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Amacebo obuwula ayisono,","poem":1},{"text":"njalo abantu bayasizonda isideleli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nxa uthikaza ngezikhathi zenhlupheko,","poem":1},{"text":"mancinyane kanganani amandla akho!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bahlangule labo abaholelwa ekufeni;","poem":1},{"text":"banqande labo abadayizela besiya ekubulaweni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nxa usithi, “Angithi besingazi lutho ngalokhu,”","poem":1},{"text":"kambe lowo ohlola inhliziyo kakuboni lokho na?","poem":2},{"text":"Kakwazi lokho yini onguye olinda ukuphila kwakho na?","poem":1},{"text":"Akayikuvuza ubani lobani ngakwenzileyo na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dlana uluju ndodana yami, ngoba lulungile;","poem":1},{"text":"uluju olujuluka ekhekhebeni lumnandi luyanambitheka.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yazi njalo ukuthi ukuhlakanipha kumnandi emphefumulweni wakho,","poem":1},{"text":"aluba ukuzuza ikusasa lakho lilethemba elihle,","poem":2},{"lineBreak":true},{"text":"njalo ithemba lakho aliyikudaniswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ungacathameli indlu yomuntu olungileyo njengesigebenga,","poem":1},{"text":"ungawuhlaseli umuzi wakhe;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ngoba loba angaze awe kasikhombisa umuntu olungileyo uyavuka futhi,","poem":1},{"text":"kodwa ababi babhazalaliswa yizinhlupheko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ungathatshiswa yikuwa kwesitha sakho;","poem":1},{"text":"nxa sikhubeka ungavumeli inhliziyo yakho ithokoze,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ngoba uThixo uzakubona lokho","poem":1},{"text":"asole abesepholisa ulaka lwakhe kuso isitha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ungazikhathazi ngenxa yabantu ababi","poem":1},{"text":"loba ubahawukele abaxhwalileyo,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ngoba umuntu omubi akalalo ithemba lakusasa,","poem":1},{"text":"njalo isibane sezixhwali sizacinywa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Yesaba uThixo lombusi, ndodana yami,","poem":1},{"text":"ungangenelani labahlamuki,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ngoba laba bobabili bazakwehlisa ulaka lubabhubhise,","poem":1},{"text":"ngoba phela ngubani kambe okwaziyo ukubhubhisa abangakwehlisa?","poem":2}]},{"type":"verse","number":23,"content":["La ngamanye amazwi ezihlakaniphi:",{"text":"Ukwahlulela ngobandlululo kakulunganga:","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Loba ngubani othi kolecala, “Umsulwa,”","poem":1},{"text":"abantu bonke bazamqalekisa","poem":2},{"lineBreak":true},{"text":"lezizwe zonke zizamhlamukela.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kodwa kuzabalungela labo abamlahlayo olecala,","poem":1},{"text":"lezibusiso ezinengi zizabehlela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Impendulo eqotho","poem":1},{"text":"injengokwangiwa ezindebeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Qeda umsebenzi wakho waphandle","poem":1},{"text":"ulungise lamasimu akho;","poem":2},{"lineBreak":true},{"text":"kuthi-ke usuqedile wakhe indlu yakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ungafakazi ngokubethela umakhelwane kungelamlandu,","poem":1},{"text":"kumbe usebenzise izindebe zakho ukhohlisa.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ungabokuthi, “Ngizakwenza kuye njengoba enze kimi;","poem":1},{"text":"ngizahlawulisa ngalokho angenze khona.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ngedlula ensimini yevilavoxo,","poem":1},{"text":"ngedlula esivinini somuntu ongelangqondo;","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ameva ayesekhula indawo yonke,","poem":1},{"text":"indawo yonke isithe phethu ukhula,","poem":2},{"lineBreak":true},{"text":"lomduli wamatshe usudilikile.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ngakunanzelela konke engangikubona","poem":1},{"text":"ngafunda isifundo kulokho engakubonayo:","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ukulala okuncane, ukuwozela okuncane,","poem":1},{"text":"ukugoqa izandla kancane uphumula,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ubuyanga buzafika kuwe njengesela","poem":1},{"text":"lokuswela njengesigebenga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}