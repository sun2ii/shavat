{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":["Lezi ngezinye njalo izaga zikaSolomoni, ezabhalwa yizinceku zikaHezekhiya inkosi yakoJuda:"]},{"type":"verse","number":2,"content":[{"text":"Kuyinkazimulo kaNkulunkulu ukufihla indaba;","poem":1},{"text":"ukuchwayisisa indaba ludumo lwababusi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Njengalokhu izulu liphakeme lomhlaba ujulile,","poem":1},{"text":"kanjalo imicabango yamakhosi kayifinyelelwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Susa amakhafutha ahlangene lesiliva","poem":1},{"text":"umkhandi athole ukulungisa isitsha sihle;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"susa abantu ababi phambi kwenkosi,","poem":1},{"text":"isihlalo sayo sizaqiniswa ngokulunga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ungaziphakamisi phambi kwenkosi,","poem":1},{"text":"ungaziphendleli indawo phakathi kwezikhulu;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kuba ngcono ukuthi yona ithi, “Woza uhlale ngapha,”","poem":1},{"text":"kulokuthi yona ikwehlise phambi kwezikhulu.","poem":2},{"lineBreak":true},{"text":"Lokho okubonileyo ngawakho amehlo","poem":1}]},{"type":"verse","number":8,"content":[{"text":"ungaphangisi ukukubika emthethwandaba,","poem":2},{"lineBreak":true},{"text":"ngoba uzathini nxa umakhelwane wakho esekuyangisa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nxa ungaya edale lomakhelwane wakho","poem":1},{"text":"ungahambi usuhlabela imfihlo yenu,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"funa lowo okuzwayo akuyangise","poem":1},{"text":"uhlale usungumuntu olebizo elibi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ilizwi elikhulunywe ngesikhathi esifaneleyo","poem":1},{"text":"linjengama-aphula egolide","poem":2},{"lineBreak":true},{"text":"ananyekwe emcepheni wesiliva.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Njengecici legolide kumbe umceciso wegolide elicengiweyo","poem":1},{"text":"kunjalo ukukhuza komuntu ohlakaniphileyo, kolalelayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Njengokuqanda kongqwaqwane ngesikhathi sokuvuna","poem":1},{"text":"sinjalo isithunywa esithembekileyo kwabasithumileyo;","poem":2},{"lineBreak":true},{"text":"sivuselela imiphefumulo yabaphathi baso.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Njengamayezi lomoya okungalethi izulu","poem":1},{"text":"unjalo umuntu ozikhukhumeza ngamandla angelawo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ngokubekezela inkosi ingancengwa ize ivume,","poem":1},{"text":"lolimi oluthambileyo lungalephula ithambo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nxa uthole inyosi, dlana okwaneleyo","poem":1},{"text":"ungedlulisi amalawulo, uzazihlanza.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ungabi ngunsukuzonke endlini kamakhelwane wakho","poem":1},{"text":"uzacina usumdaka abesekuzonda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Unjengesagila loba inkemba kumbe umtshoko obukhali","poem":1},{"text":"umuntu ofakaza amanga ngomakhelwane wakhe.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Njengezinyo elibuhlungu loba unyawo olwenyeleyo","poem":1},{"text":"kunjalo ukweyama emuntwini ongathembekanga","poem":2},{"lineBreak":true},{"text":"ngesikhathi sokuhlupheka.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Njengomuntu okhumula ibhatshi mhla kumakhaza,","poem":1},{"text":"loba njengokuthela iviniga phakathi kwesoda","poem":2},{"lineBreak":true},{"text":"unjalo ohlabelela izingoma emuntwini odabukileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Nxa isitha sakho silambile siphe ukudla sidle;","poem":1},{"text":"nxa somile siphe amanzi sinathe.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ngokwenza lokho, umokhela amalahle avuthayo ekhanda,","poem":1},{"text":"njalo uThixo uzakubusisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Njengomoya wasenyakatho uletha izulu,","poem":1},{"text":"lunjalo ulimi olulobuqili luvusa ulaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kungcono ukuhlala ekhulusini lophahla lwendlu","poem":1},{"text":"kulokuhlala ndlu yinye lomfazi olomlomo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Njengamanzi aqandayo emuntwini okhatheleyo,","poem":1},{"text":"zinjalo izindaba ezimnandi ezivela elizweni elikude.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Njengesiziba esidungekileyo loba umthombo ongcolileyo","poem":1},{"text":"unjalo umuntu olungileyo odedela umuntu omubi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Kakukuhle ukudla inyosi wedlulise,","poem":1},{"text":"njalo kakulasithunzi ukuzidingela ukudunyiswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Njengedolobho eselidilikelwe ngumthangala walo","poem":1},{"text":"unjalo umuntu ongazithintiyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":28}