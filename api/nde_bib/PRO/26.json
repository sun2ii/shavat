{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"Njengongqwaqwane ehlobo loba izulu ebusika","poem":1},{"text":"kanjalo udumo alusifanelanga isiwula.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Njengentaka ephaphazelayo loba inkonjane entwezayo,","poem":1},{"text":"sinjalo isiqalekiso esingelasizatho kasinamatheli.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isiswebhu ngesebhiza, amatomu ngakababhemi,","poem":1},{"text":"loswazi ngolwemihlane yeziwula!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ungabophendula isiwula ngendlela yobuwula baso,","poem":1},{"text":"funa ubenjengaso wena ngokwakho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Phendula isiwula ngendlela yobuwula baso,","poem":1},{"text":"sizabona kungathi sihlakaniphile.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Njengokuziquma inyawo zakho loba ukunatha itshefu,","poem":1},{"text":"kunjalo ukuthumela umlayezo ngesiwula.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Njengemilenze eqhugezelayo eyomuntu oqhulayo","poem":1},{"text":"sinjalo isaga emlonyeni wesiwula.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Njengokubophela ilitshe esavutheni","poem":1},{"text":"kunjalo ukupha udumo koyisiwula.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Njengogatsha lwameva luphethwe yisidakwa","poem":1},{"text":"sinjalo isaga emlonyeni wesiwula.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Njengomtshoko ociba loba ngubani odlulayo","poem":1},{"text":"unjalo oqhatsha isiwula loba umuntu ozedlulelayo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Njengenja ebuyela emahlanzweni ayo","poem":1},{"text":"kanjalo isiwula siyabuphinda ubuthutha baso.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Uyambona yini umuntu ozibona engohlakaniphileyo?","poem":1},{"text":"Kulethemba elingcono ngesiwula kulaye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ivilavoxo lithi, “Kulesilwane endleleni,","poem":1},{"text":"kulesilwane emigwaqweni!”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Njengesivalo esitshibilika ngamabhanti aso","poem":1},{"text":"kanjalo ivila liphenduka embhedeni walo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ivilavoxo litshonisa isandla salo emganwini;","poem":1},{"text":"livilaphe ukusa isandla emlonyeni lidle.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ivila lizibona lihlakaniphile kakhulu","poem":1},{"text":"okwedlula abantu abayisikhombisa abangaphendula ngokuhlakanipha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Njengomuntu odonsa inja ngendlebe","poem":1},{"text":"unjalo umuntu othi edlula angenele ingxabano ingesiyakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Njengohlanya luphosa izikhuni zomlilo","poem":1},{"text":"kumbe imitshoko ebulalayo,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"injalo indoda ephoxa umakhelwane wayo","poem":1},{"text":"ibisisithi, “Bengizidlalela nje!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Nxa kungaselankuni umlilo uyacima;","poem":1},{"text":"nxa kungaselakunyeya ukuxabana kuyaphela.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Njengamalahle avuthayo loba njengenkuni emlilweni,","poem":1},{"text":"unjalo umuntu othanda ingxabano ekuvuseni inkani.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Amazwi omuntu onyeyayo anjengezibiliboco;","poem":1},{"text":"angena ekujuleni kwenhliziyo yomuntu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Njengesiliva egcotshwe esitsheni sebumba sikhazimule","poem":1},{"text":"kunjalo ukuthakazelela kwezindebe zenhliziyo elobubi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Umuntu olenhliziyo embi uvala ngezindebe ezimnandi,","poem":1},{"text":"kodwa enhliziyweni yakhe ufihle inkohliso.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Loba ukukhuluma kwakhe kumnandi,","poem":1},{"text":"kodwa ungaze wamkholwa,","poem":2},{"lineBreak":true},{"text":"ngoba inhliziyo yakhe igcwele izithuko eziyisikhombisa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Inzondo yakhe angayivala ngobuqili,","poem":1},{"text":"kodwa ububi bakhe buzavezwa obala ebantwini.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Umuntu angagebha umgodi, uzawela kuwo;","poem":1},{"text":"umuntu angagiqa ilitshe,","poem":2},{"lineBreak":true},{"text":"lizaphenduka ligiqikele phezu kwakhe.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ulimi oluqamba amanga luyabazonda labo olubalimazayo,","poem":1},{"text":"lomlomo okhohlisayo uletha incithakalo.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/25.json","previousChapterAudioLinks":{},"numberOfVerses":28}