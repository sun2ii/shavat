{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"Ungazincomi ngelakusasa,","poem":1},{"text":"ngoba kawukwazi ukuthi liza lithweleni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yekela omunye akudumise, hatshi owakho umlomo;","poem":1},{"text":"akube ngomunye, kungabi ngezakho izindebe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ilitshe liyasinda, itshebetshebe ngumthwalo onzima,","poem":1},{"text":"kodwa ukucatshulwa yisiwula kunzima okudlula kokubili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ulaka lulolunya lentukuthelo iyagabha,","poem":1},{"text":"kambe ngubani ongema phambi komhawu na?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kungcono ukuthukwa obala","poem":1},{"text":"kulokuthandwa ngokufihlakeleyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ukulinyazwa ngumngane kakwesabeki,","poem":1},{"text":"kodwa isitha sikwanga sedlulise amalawulo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Osuthiyo kathakazeleli uluju oluvela ekhekhebeni,","poem":1},{"text":"kodwa kolambileyo lokubabayo kunambitheka mnandi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Njengenyoni elahleka esidlekeni sayo,","poem":1},{"text":"unjalo umuntu otshiya umuzi wakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Amakha lempepha kuletha intokozo enhliziyweni,","poem":1},{"text":"lobumnandi bomngane busuka ezelulekweni zakhe eziqinileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ungadeli umngane wakho lomngane kayihlo,","poem":1},{"text":"futhi ungayi endlini yomfowenu nxa wehlelwe yizinhlupheko","poem":2},{"lineBreak":true},{"text":"ungcono umakhelwane eduze kolomfowenu okhatshana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Hlakanipha, ndodana, ulethe intokozo enhliziyweni yami;","poem":1},{"text":"lapho ngizakwazi ukumphendula ongeyisayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Umuntu olengqondo uthi ebona ingozi acatshe,","poem":1},{"text":"kodwa isithutha siyaphikelela singena enkathazweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Thatha isigqoko salowo owenzela owemzini isibambiso;","poem":1},{"text":"sigcine njengesithembiso aluba esenzela umfazi ongelasimilo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Uba umuntu evukisa umakhelwane wakhe ngokumnqolonga ekuseni kakhulu,","poem":1},{"text":"kuzathiwa uyamqalekisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Umfazi olenkani","poem":1},{"text":"unjengamathonsi angapheliyo mhlana kusina;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ukumkhuza kufana lokukhuza umoya","poem":1},{"text":"loba lokubamba okulamagcobo ngesandla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Njengensimbi ilola insimbi,","poem":1},{"text":"kanjalo indoda ikhaliphisa enye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Lowo onakekela isihlahla somkhiwa uzakudla izithelo zawo,","poem":1},{"text":"kuthi lowo olondoloza umqhatshi wakhe abelodumo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Njengamanzi etshengisa ubuso bomuntu,","poem":1},{"text":"kanjalo inhliziyo yomuntu itshengisa ayikho khona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"UKufa leNcithakalo kakusuthi,","poem":1},{"text":"anjalo lamehlo omuntu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Isiliva sincibilikiselwa embizeni imvutho ngeyegolide,","poem":1},{"text":"kodwa abantu bahlolwa ngodumo lwabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ungaze uchole isiwula elitsheni,","poem":1},{"text":"usichole njengamabele ngembokodo","poem":2},{"lineBreak":true},{"text":"kawusoze ubususe ubuwula baso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Woba leqiniso ukuthi uhlala usazi kuhle isimo sezifuyo zakho,","poem":1},{"text":"nanzelela imihlambi yakho;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ngoba inotho kayiyikuhlala kokuphela,","poem":1},{"text":"lomqhele wobukhosi kawuyikuba ngowezizukulwane zonke.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Utshani bungaqunywa kuqalise ukuhluma obunye","poem":1},{"text":"kuthi bonke obusikiweyo ezintabeni sebubuthiwe,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"amawundlu azakupha uboya bezigqoko,","poem":1},{"text":"lembuzi zikuphe imali elingana intengo yesiqinti.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Uzakuba lochago lwembuzi olunengi","poem":1},{"text":"olwakho lolwendlu yakho lusuthise lezinceku zakho.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}