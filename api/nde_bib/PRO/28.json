{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"Umuntu omubi uyabaleka loba engaxotshaniswa muntu,","poem":1},{"text":"kodwa abalungileyo balesibindi njengesilwane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nxa ilizwe lihlamuka liba lababusi abanengi,","poem":1},{"text":"kodwa umuntu ozwisisayo lololwazi ugcina ukuthula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Umbusi oncindezela abayanga","poem":1},{"text":"unjengezulu elinengi elikhukhula amabele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Labo abaphikisa umthetho bakhuthaza izigangi,","poem":1},{"text":"kodwa labo abawugcinayo bayazenqabela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Abantu ababi kabakuzwisisi ukwahlulela kuhle,","poem":1},{"text":"kodwa labo abamdingayo uThixo bayakuzwisisa kakhulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ungcono umyanga ohamba ngokulunga","poem":1},{"text":"kulesinothi esilezindlela zokungcola.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lowo ogcina umthetho yindodana eqedisisayo,","poem":1},{"text":"kodwa umngane wezixhwali uyangisa uyise.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lowo owandisa inotho yakhe ngenzaliso","poem":1},{"text":"uyibuthela omunye ozaba lomusa kubayanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Loba ngubani ongawulaleliyo umthetho,","poem":1},{"text":"lemikhuleko yakhe izakuba yisinengiso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Lowo oholela olungileyo endleleni embi","poem":1},{"text":"uzawela emjibileni wakhe,","poem":2},{"lineBreak":true},{"text":"kodwa ongelacala uzakwamukela ilifa elihle.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Umuntu onothileyo angazibona ingathi uhlakaniphile,","poem":1},{"text":"kodwa umyanga oqedisisayo uhle abone ukuthi kasumuntu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nxa olungileyo enqoba kulokujabula okukhulu;","poem":1},{"text":"kodwa nxa omubi ethatha umbuso abantu bayacatsha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Lowo ofihla iziphambeko zakhe kayikuphumelela,","poem":1},{"text":"kodwa lowo ozivumayo azitshiye ufumana umusa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ubusisiwe umuntu ohlala emesaba uThixo,","poem":1},{"text":"kodwa lowo oyenza lukhuni inhliziyo yakhe uwela enkathazweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Njengesilwane esibhongayo loba ibhele elihlaselayo","poem":1},{"text":"unjalo umuntu omubi nxa ebusa abantu abangelamandla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Umbusi oncindezelayo wehluleka ukwahlulela kuhle,","poem":1},{"text":"kodwa lowo ozonda inzuzo yokuganga uzakuba lempilo ende.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Umuntu odliwa ngumzwangedwa wokubulala omunye","poem":1},{"text":"uzaba ngohlala ebaleka aze ayokufa;","poem":2},{"lineBreak":true},{"text":"akungabi lomuntu omsekelayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Lowo ompilo yakhe ingelacala uvikelekile,","poem":1},{"text":"kodwa ondlela zakhe zixhwalile uzakuwa masinyane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Lowo osebenza nzima emasimini akhe uzathola ukudla okunengi,","poem":1},{"text":"kodwa lowo ophika ngezifiso eziyize uzakuba ngumyanga onukayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Umuntu othembekileyo uzabusiswa ngokuphumelela,","poem":1},{"text":"kodwa ogijimela ukunotha kayikuphepha ekujezisweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ukubandlulula abantu kakulunganga","poem":1},{"text":"ikanti umuntu uyona ukuze azuze ucezu lwesinkwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Umuntu oncitshanayo utshisekela ukunotha","poem":1},{"text":"kodwa kaboni ukuthi unyenyelwa yibuyanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Lowo okhuza umuntu uzacina esethandeka","poem":1},{"text":"kulalowo ololimi olukhohlisayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Lowo ontshontshela uyise loba unina","poem":1},{"text":"athi, “Akusinto embi”","poem":2},{"lineBreak":true},{"text":"ungumngane lomuntu obhidlizayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Umuntu olomhawu ubanga ingxabano,","poem":1},{"text":"kodwa lowo omethembayo uThixo uzaphumelela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Lowo ozithembayo yena uyisiwula,","poem":1},{"text":"kodwa lowo ohamba ngenhlakanipho uvikelekile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Lowo opha abayanga kayikuswela lutho,","poem":1},{"text":"kodwa ovala amehlo ingathi kababoni uzuza iziqalekiso ezinengi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Lapho izigangi zisiba yiziphathamandla abantu bayacatsha;","poem":1},{"text":"kodwa nxa kusifa izixhwali abalungileyo bayaphumelela.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}