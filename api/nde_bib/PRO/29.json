{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"Umuntu oqinisa intamo phezu kokukhuzwa kanengi","poem":1},{"text":"uzabhujiswa ngesikhatshana kungabi lokuphepha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Lapho kuphumelela abalungileyo abantu bayajabula;","poem":1},{"text":"nxa kubusa izixhwali abantu bayabubula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Umuntu othanda ukuhlakanipha uletha intokozo kuyise,","poem":1},{"text":"kodwa ohamba lezifebe utshaphaza inotho yakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ngokubusa kuhle inkosi iyaliqinisa ilizwe layo,","poem":1},{"text":"kodwa leyo elihaga lezivalamlomo iyalibhidliza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Loba ngubani okhohlisa umakhelwane wakhe","poem":1},{"text":"uzendlalela umambule wokuzithiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Umuntu omubi uthiywa yisono sakhe,","poem":1},{"text":"kodwa umuntu olungileyo angahlabela athokoze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Olungileyo uyawananza amalungelo abayanga,","poem":1},{"text":"kodwa ababi kabazidubi ngalokho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Izideleli zingalidunga idolobho,","poem":1},{"text":"kodwa abantu abahlakaniphileyo bayaludedisa ulaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nxa umuntu ohlakaniphileyo esiya emthethwandaba lesiwula,","poem":1},{"text":"isiwula siyatshinga sibhede kube lomsindo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Abadinga ukuchitha igazi bayamzonda umuntu oqotho","poem":1},{"text":"njalo badinga ukubulala abalungileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Isiwula siyalukhihliza lonke ulaka lwaso,","poem":1},{"text":"kodwa umuntu ohlakaniphileyo uyazithiba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nxa umbusi elalela amanga,","poem":1},{"text":"zonke izikhulu zakhe ziba zimbi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Umyanga lomncindezeli bakanye kulokhu:","poem":1},{"text":"UThixo uvula amehlo abo bobabili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Nxa inkosi isahlulela abayanga kungelabandlululo,","poem":1},{"text":"isihlalo sayo sobukhosi sizaqina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Uswazi lokuqondisa lunika ukuhlakanipha,","poem":1},{"text":"kodwa umntwana oyekelwayo uhlazisa unina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nxa ababi bephumelela, lesono laso siyaphumelela,","poem":1},{"text":"kodwa abalungileyo bazabawisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Qondisa indodana yakho, izakupha ukuthula;","poem":1},{"text":"izaletha injabulo emphefumulweni wakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Lapho okungekho khona isambulelo,","poem":1},{"text":"abantu badela ukuzithiba;","poem":2},{"lineBreak":true},{"text":"kodwa ubusisiwe lowo ogcina umlayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Inceku kayiqondiswa ngamazwi nje wodwa,","poem":1},{"text":"loba izwisisa kayiyikukwenza ekutshelwayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Uyambona umuntu owalazela ukukhuluma?","poem":1},{"text":"Kulethemba elingcono esiwuleni kulaye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Umuntu ototoza inceku yakhe isakhula,","poem":1},{"text":"leyonceku izamthwalisa nzima ekucineni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Umuntu othukuthelayo udala ingxabano,","poem":1},{"text":"kodwa lowo olicaphucaphu wenza izono ezinengi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ukuzigqaja komuntu kuyamehlisa,","poem":1},{"text":"kodwa umuntu ozehlisayo uzuza udumo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Osizana lesela uyazizonda yena;","poem":1},{"text":"usezifungise kulo ngakho ngeke afakaze iqiniso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ukwesaba abantu kuba yizithiyo,","poem":1},{"text":"kodwa lowo othemba uThixo uzaphepha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Abanengi bazama ukuzisondeza kumbusi,","poem":1},{"text":"kodwa ukwahlulela okuhle kuvela kuThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Abalungileyo bayabenyanya abangathembekanga;","poem":1},{"text":"abaxhwalileyo bayabenyanya abalungileyo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":27}