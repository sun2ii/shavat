{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":3,"content":[{"type":"heading","content":["Eminye Njalo Imivuzo Emihle Yokuhlakanipha"]},{"type":"verse","number":1,"content":[{"text":"Ndodana yami, ungakhohlwa imfundiso yami,","poem":1},{"text":"kodwa ugcine imilayo yami enhliziyweni yakho,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ngoba izakwandisa impilo yakho okweminyaka eminengi,","poem":1},{"text":"ikuphe ukuthula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Akungasuki kuwe loba nini uthando lokuthembeka;","poem":1},{"text":"kubophele entanyeni yakho,","poem":2},{"lineBreak":true},{"text":"ukubhale egwalibeni lenhliziyo yakho.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngalokho uzathandeka uzuze ibizo elihle","poem":1},{"text":"emehlweni kaNkulunkulu laphambi kwabantu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Themba kuThixo ngenhliziyo yakho yonke,","poem":1},{"text":"ungathembi ekuzwisiseni kwakho;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"mvume kuzozonke izindlela zakho,","poem":1},{"text":"yena uzaqondisa zonke izindlela zakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ungazenzi ohlakaniphileyo ngokubona kwakho;","poem":1},{"text":"yesaba uThixo uxwaye okubi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lokho kuzawuphilisa umzimba wakho","poem":1},{"text":"kuwaqinise lamathambo akho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dumisa uThixo ngenotho yakho;","poem":1},{"text":"ngezithelo zakho zokuqala zonke;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ngalokho iziphala zakho zizagcwala ziphuphume,","poem":1},{"text":"lezimbiza zakho zewayini zize zichitheke ngewayini elitsha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ndodana yami, ungeyisi ukulaya kukaThixo","poem":1},{"text":"njalo ungacaphukeli ukukhuza kwakhe,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ngoba uThixo ulaya labo abathandayo,","poem":1},{"text":"njengoyise elaya indodana yakhe ayithandayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ubusisiwe umuntu ozuza ukuhlakanipha,","poem":1},{"text":"umuntu ozuza ukuqedisisa,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ngoba khona kulenzuzo eyedlula isiliva","poem":1},{"text":"lenzuzo eyedlula igolide.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kuligugu elidlula amarubhi;","poem":1},{"text":"kakukho okuloyisayo okungalinganiswa lakho.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Impilo ende isesandleni sakho sokunene;","poem":1},{"text":"kwesokhohlo kulenotho lodumo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Izindlela zakhe zilokuthokoza,","poem":1},{"text":"lemikhondo yakhe ilokuthula.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kuyisihlahla sokuphila kulabo abakwamukelayo;","poem":1},{"text":"labo abakuphathayo bazabusiswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ngokuhlakanipha uThixo wabeka izisekelo zomhlaba,","poem":1},{"text":"ngokuqedisisa wamisa izulu endaweni yalo;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ngolwazi lwakhe inlwandle zehlukaniswa,","poem":1},{"text":"lamayezi athontisa amazolo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ndodana yami, gogosa ingqondo ehlela ngolwazi,","poem":1},{"text":"ungayekeli kukucatshele;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"kuzakuba yikuphila kuwe,","poem":1},{"text":"kube ngumceciso omuhle entanyeni yakho.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Lapho-ke uzahamba ngendlela evikelweyo","poem":1},{"text":"unyawo lwakho lungakhubeki;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"nxa ulala kawuyikwesaba;","poem":1},{"text":"uzalala ubuthongo obumnandi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ungabi lovalo nxa ujunywa ngumonakalo","poem":1},{"text":"kumbe yikubhidlika lokho okwehlela ababi,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ngoba uThixo uzakuba lithemba lakho","poem":1},{"text":"avikele unyawo lwakho emjibileni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ungaze wala ukusiza labo abadinga uncedo,","poem":1},{"text":"wena ulakho ongabasiza ngakho.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ungabokuthi kumakhelwane wakho:","poem":1},{"text":"“Ubobuya kwesinye isikhathi; ngizakunika kusasa”","poem":2},{"lineBreak":true},{"text":"wena ulalo lololutho.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ungacebi okubi ngomakhelwane wakho,","poem":1},{"text":"ohlezi lawe ekwethemba.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ungaxabani lomuntu kungelasizatho","poem":1},{"text":"yena engakonelanga ngalutho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ungamhawukeli umuntu othanda ukulwa","poem":1},{"text":"loba nje ufise lakuphi ukwenza kwakhe,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ngoba uThixo uyamenyanya umuntu oxhwalileyo","poem":1},{"text":"kodwa oqotho umbeka ekhwapheni lakhe.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Isiqalekiso sikaThixo sehlela endlini yababi,","poem":1},{"text":"kodwa uyayibusisa indlu yabalungileyo.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Uyabahleka usulu abayizideleli ezizithembayo,","poem":1},{"text":"kodwa abe lomusa kwabathobekileyo.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Abahlakaniphileyo baphiwa udumo","poem":1},{"text":"kodwa abayiziwula ubathela ihlazo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}