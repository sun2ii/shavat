{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":["Amazwi ka-Aguri indodana kaJakhe, amazwi ahlakaniphileyo:",{"text":"Umuntu lo wathi ku-Ithiyeli:","poem":1},{"lineBreak":true},{"text":"“Ngikhathele, Oh Nkulunkulu,","poem":1},{"text":"kodwa ngizophumelela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Angilalwazi okudlula bonke abantu;","poem":1},{"text":"angilakho ukuzwisisa komuntu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Angikufundanga ukuhlakanipha","poem":1},{"text":"njalo kangilalwazi ngaye oNgcwele.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngubani oseke waya ezulwini waphinda wehla na?","poem":1},{"text":"Ngubani oseke wafumbatha umoya ngesandla sakhe na?","poem":2},{"text":"Ngubani oseke wagoqela amanzi ngesigqoko sakhe na?","poem":1},{"text":"Ngubani omise yonke imikhawulo yomhlaba na?","poem":2},{"text":"Lingubani ibizo lakhe, lebizo lendodana yakhe?","poem":1},{"text":"Ngitshela nxa usazi!","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wonke amazwi kaNkulunkulu akalamposiso;","poem":1},{"text":"uyisihlangu kulabo abacatsha kuye.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ungengezeleli emazwini akhe,","poem":1},{"text":"funa akukhuze akwenze umqambimanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Zimbili izinto engizicela kuwe, Oh Thixo;","poem":1},{"text":"ungangincitshi zona ngingakafi:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Susa kimi inkohliso lamanga;","poem":1},{"text":"ungangiphi ubuyanga loba inotho,","poem":2},{"lineBreak":true},{"text":"kodwa ungiphe kuphela ukudla kwami kwansukuzonke.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Phela ngingaba lokunengi kakhulu ngikuphike wena","poem":1},{"text":"ngithi, ‘Ungubani uThixo?’","poem":2},{"text":"loba ngibengumyanga ngintshontshe;","poem":1},{"text":"ngalokho ngiliyangise ibizo likaNkulunkulu wami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ungahlebi inceku enkosini yayo,","poem":1},{"text":"ngoba izakuqalekisa ungene enkathazweni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bakhona abathuka oyise,","poem":1},{"text":"abangababusisiyo onina;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"labo abazibona belungile","poem":1},{"text":"ikanti kabahlambululwanga emanyaleni abo;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"labo abamehlo abo ahlezi egcwele ulaka,","poem":1},{"text":"abakhangela ngokudelela;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"labo omazinyo abo zinkemba,","poem":1},{"text":"omihlathi yabo inanyathiselwe izingqamu","poem":2},{"text":"ukuze baginye abayanga baphele emhlabeni,","poem":1},{"text":"labaswelayo abaphakathi kwabantu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Umkhaza ulamadodakazi amabili;","poem":1},{"text":"ayamemeza athi, ‘Siphe! Siphe!’","poem":2},{"lineBreak":true},"Zintathu izinto ezingasuthiyo, zine ezingakaze zithi, ‘Sekwanele!’:"]},{"type":"verse","number":16,"content":["lingcwaba yisisu senyumba, lomhlabathi ongasuthiyo amanzi, lomlilo ongezukufa wathi, ‘Sekwanele!’"]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ilihlo elihleka uyise,","poem":1},{"text":"elidelela ukulalela unina,","poem":2},{"text":"lizakotsholwa ngamawabayi asesigodini,","poem":1},{"text":"lizadliwa ngamanqe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":["Kukhona izinto ezintathu ezingimangalisayo kakhulu, ezine engingazizwisisiyo:"]},{"type":"verse","number":19,"content":["indlela yengqungqulu emkhathini, umzila wenyoka edwaleni, indlela yomkhumbi olwandle, lendlela yejaha lentombi."]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Le yindlela yesiphingikazi:","poem":1},{"text":"siyadla sesule umlomo waso","poem":2},{"lineBreak":true},{"text":"besesisithi, ‘Angenzanga lutho olubi.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":["Zintathu izinto ezizamazamisa umhlaba, zine ongeke uzithwale:"]},{"type":"verse","number":22,"content":["yinceku ebayinkosi, yisiwula esisuthiyo,"]},{"type":"verse","number":23,"content":["ngumfazi owendileyo ongathandwayo, lencekukazi ethathela inkosikazi indoda."]},{"type":"line_break"},{"type":"verse","number":24,"content":["Kukhona emhlabeni izinto ezine ezincinyane, ikanti-ke zihlakaniphile kakhulu:"]},{"type":"verse","number":25,"content":["Ubunyonyo kabulamandla anganani, kodwa buyabuthelela ukudla kwabo ehlobo;"]},{"type":"verse","number":26,"content":["lezimbila ziyizidalwa ezilamandla angatsho lutho, kodwa zenza izikhundla zazo ezingoxweni zamadwala;"]},{"type":"verse","number":27,"content":["izintethe kazilankosi, kodwa zihamba ziludibi olwesabekayo;"]},{"type":"verse","number":28,"content":["umbankwa ungabanjwa ngesandla, kodwa ungena lasezigodlweni zamakhosi."]},{"type":"line_break"},{"type":"verse","number":29,"content":["Kulezinto ezintathu ezihamba zinqekuza kamnandi, zine ezihamba zibeka kamnandi:"]},{"type":"verse","number":30,"content":["yisilwane, esilamandla esabekayo phakathi kwezilo, esingabalekeli lutho;"]},{"type":"verse","number":31,"content":["liqhude eliditshazelayo, yimpongo, njalo lenkosi nxa ihanqwe libutho layo."]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Nxa ube yisithutha waziphakamisa,","poem":1},{"text":"kumbe nxa wakhe amacebo okwenza okubi,","poem":2},{"lineBreak":true},{"text":"vala umlomo wakho ngesandla sakho.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ngoba njengokuphehla uchago kudala iphehla,","poem":1},{"text":"lanjengoba ukugubha amakhala kubanga umungula,","poem":2},{"lineBreak":true},{"text":"kunjalo ukuvusa ulaka kudala ingxabano.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}