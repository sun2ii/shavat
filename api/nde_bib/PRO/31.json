{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["Amazwi enkosi uLemuweli, amazwi enhlakanipho awafundiswa ngunina:"]},{"type":"verse","number":2,"content":[{"text":"Oh, ndodana yami! Oh ndodana yethumbu lami!","poem":1},{"text":"Oh, ndodana yezifungo zami,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ungadlalisi amandla akho ebafazini,","poem":1},{"text":"izifutho zakho kulabo abadiliza amakhosi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kakusikho kwamakhosi, bakithi Lemuweli","poem":1},{"text":"kakusikho kwamakhosi ukunatha iwayini,","poem":2},{"lineBreak":true},{"text":"kakusikho kwababusi ukunxwanela utshwala,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"funa badakwe bakhohlwe izimiso zomthetho,","poem":1},{"text":"behluleke ukumisela kuhle abahluphekayo amalungelo abo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Phana utshwala kulabo abavele sebezifele,","poem":1},{"text":"iwayini kulabo abalosizi olukhulu;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kabanathe bakhohlwe ubuyanga babo","poem":1},{"text":"bakhohlwe nya usizi lwabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bamele labo abehlulekayo ukuzikhulumela,","poem":1},{"text":"uwamele amalungelo alabo abangelalutho.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Khuluma njalo wahlulele ngokulunga;","poem":1},{"text":"alwele amalungelo abayanga labaswelayo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngubani na ongathola umfazi olesimilo?","poem":1},{"text":"Uligugu elidlula kakhulu amatshe amahle.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Indoda yakhe iyamthemba ngokupheleleyo","poem":1},{"text":"njalo kayisweli lutho oluqakathekileyo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Uyenzela okuhle, hatshi okubi,","poem":1},{"text":"empilweni yakhe yonke.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Uyakhetha kuhle iwulu lesikusha","poem":1},{"text":"akweluke kuhle ngezandla ezikhutheleyo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Unjengemikhumbi yabathengisi,","poem":1},{"text":"eletha ukudla okuvela kude.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Uvuka ekuseni kusesemnyama;","poem":1},{"text":"alungisele abomuzi wakhe ukudla","poem":2},{"lineBreak":true},{"text":"abele lezincekukazi zakhe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Uyayihlolisisa insimu mandulo kokuyithenga;","poem":1},{"text":"ngalokho akuzuzayo uyahlanyela isivini sakhe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Uwubamba ngokukhuthala umsebenzi wakhe;","poem":1},{"text":"aqinise izingalo zakhe emsebenzini.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Uyananzelela ukuthi ukuthengisa kwakhe kulenzuzo,","poem":1},{"text":"lokuthi isibane sakhe kasicimi ebusuku.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Uphatha uluthi lokuphotha ngesandla sakhe","poem":1},{"text":"abesebamba ngeminwe yakhe isigudugudu sokweluka.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Welulela izandla zakhe kubayanga","poem":1},{"text":"njalo ulezandla ezilula kwabaswelayo.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Lapho kukhithika ungqwaqwane, kalakwesaba ngabendlu yakhe;","poem":1},{"text":"ngoba bonke bagqoke ezibomvu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Wendlala amalembu ombheda wakhe;","poem":1},{"text":"agqoke ilineni elihle lezigqoko eziyibubende.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Indoda yakhe iyahlonitshwa enkundleni","poem":1},{"text":"lapho efika ihlale khona ndawonye labadala belizwe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Uthunga izigqoko zelineni azithengise,","poem":1},{"text":"abathengi bemigaxo bayizuza kuye.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Wembethe amandla lesithunzi;","poem":1},{"text":"uyahleka loba kusiza insuku ezimbi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ukhuluma ngenhlakanipho,","poem":1},{"text":"lezeluleko eziqondileyo zisolimini lwakhe.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Unqinekela ezomuzi wakhe","poem":1},{"text":"njalo kadli isinkwa sobuvila.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Abantwabakhe bayambonga bathi ubusisiwe;","poem":1},{"text":"lendoda yakhe layo iyamdumisa ithi,","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“Banengi abafazi abenza izimangaliso zobuhle,","poem":1},{"text":"kodwa wena uyabedlula bonke.”","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ukubukeka kuyakhohlisa, lobuhle buyaphela;","poem":1},{"text":"kodwa umfazi owesaba uThixo kadunyiswe.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kaphiwe umvuzo wobuhle abenzayo,","poem":1},{"text":"imisebenzi yakhe imlethele udumo enkundleni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}