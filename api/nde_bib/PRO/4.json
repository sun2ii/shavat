{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":4,"content":[{"type":"heading","content":["Ukuhlakanipha Kuyinqaba"]},{"type":"verse","number":1,"content":[{"text":"Zwanini, madodana ami, izeluleko zikayihlo;","poem":1},{"text":"lalelani lizuze ukuqedisisa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngilipha izifundo ezipheleleyo;","poem":1},{"text":"ngakho lingalahli imfundiso yami.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngathi ngisengumfana emzini kababa,","poem":1},{"text":"ngisebuthakathaka, ngiyimi ngedwa ingane kamama,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"wangifundisa ubaba wathi,","poem":1},{"text":"“Abambe amazwi ami ngenhliziyo yakho yonke;","poem":2},{"lineBreak":true},{"text":"gcina imilayo yami ukuze uphile.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zuza ukuhlakanipha, zuza ukuqedisisa;","poem":1},{"text":"ungawakhohlwa amazwi ami, kumbe ugudluke kuwo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ungafulatheli ukuhlakanipha, kuzakuvikela;","poem":1},{"text":"kuthande, kuzakulinda.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ukuhlakanipha kuyinqaba; ngakho zuza ukuhlakanipha.","poem":1},{"text":"Zuza ukuqedisisa loba kungathatha konke olakho.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kugogose, kuzakuphakamisa;","poem":1},{"text":"kugone, kuzakunika udumo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kuzakwethesa umqhele wamaluba omusa ekhanda lakho","poem":1},{"text":"kukwethese umqhele wenkazimulo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Zwana mntanami, yamukela lokho engikutshoyo,","poem":1},{"text":"ukuze insuku zokuphila kwakho zibe zinengi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngiyakukhokhela endleleni yokuhlakanipha,","poem":1},{"text":"ngikuqondise ezindleleni eziqondileyo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nxa uhamba kawuyikuthikaza;","poem":1},{"text":"nxa ugijima kawuyikukhubeka.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bambelela iziqondiso, ungayekethisi;","poem":1},{"text":"zigcine kuhle ngoba ziyikuphila kwakho.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ungayingeni indlela yababi","poem":1},{"text":"njalo ungahambi endleleni yezigangi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ixwaye, ungahambi ngayo;","poem":1},{"text":"itshiye uqhubeke ngeyakho indlela.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Phela kabalali bengenzanga ukuganga;","poem":1},{"text":"badela ubuthongo ukuze baqale balimaze omunye umuntu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Badla isinkwa sobubi","poem":1},{"text":"banathe iwayini lobudlwangudlwangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Indlela yabalungileyo injengovivi lokusa,","poem":1},{"text":"kukhule ukukhanya kwalo kuze kuphelele emini.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kodwa indlela yababi ifana lomnyama omkhulu;","poem":1},{"text":"kabazi ukuthi kuyini okubakhubayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ndodana yami, zwana lokhu engikutshoyo;","poem":1},{"text":"lalelisisa amazwi ami.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ungawasusi emehlweni akho,","poem":1},{"text":"agcine enhliziyweni yakho;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ngoba ayikuphila kulabo abawafumanayo;","poem":1},{"text":"lokuqina komzimba wonke womuntu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Phezu kwakho konke, gcina inhliziyo yakho,","poem":1},{"text":"ngoba ingumthombo wokuphila kwakho.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Lahla izibozi zamazwi emlonyeni wakho;","poem":1},{"text":"ungakhuphi inkulumo yokuxhwala ezindebeni zakho.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Khangelisa amehlo akho nta phambili,","poem":1},{"text":"uwathi nhlo amehlo akho kulokho okuphambi kwakho.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Lungisa izindlela ukuze inyawo zakho zinyathele kuhle,","poem":1},{"text":"uhambe ngezindlela eziqinileyo kuphela.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ungaphambukeli kwesokunene loba kwesokhohlo;","poem":1},{"text":"ugcine unyawo lwakho lunganyatheli okubi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}