{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":5,"content":[{"type":"heading","content":["Isixwayiso Kwabafebayo"]},{"type":"verse","number":1,"content":[{"text":"Ndodana yami, nanzelela ukuhlakanipha kwami,","poem":1},{"text":"ulalele kuhle amazwi ami alombono,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ukuze uhlale ukwazi ukukhetha okuqondileyo","poem":1},{"text":"lokuze izindebe zakho zigcine ulwazi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Phela izindebe zesifebekazi zithonta uluju,","poem":1},{"text":"lenkulumo yaso iyatshelela kulamafutha;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"kodwa ekucineni iyababa ingathi yinyongo,","poem":1},{"text":"ibukhali njengenkemba esika nxa zombili.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Inyawo zaso zehlela ekufeni;","poem":1},{"text":"izinyathelo zaso ziqonda nta elibeni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kasikhathali ukuthi kuphilwa njani;","poem":1},{"text":"izindlela zaso ziyazombeleza, kodwa kasikuboni lokho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ngalokho-ke, madodana ami, ngilalelani;","poem":1},{"text":"lingaphambuki kulokho engikukhulumayo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hambani ngendlela ekhatshana kwaso,","poem":1},{"text":"lingasondeli emnyango wendlu yaso,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"funa unikele kwabanye amandla akho wonke","poem":1},{"text":"lobudala bakho kulowo olesihluku,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"funa abemzini bazitike ngenotho yakho","poem":1},{"text":"lokusebenza kwakho kunothise umuzi wenye indoda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ekupheleni kokuphila kwakho uzabubula,","poem":1},{"text":"lapho inyama yakho lomzimba wakho sekugugile.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Uzakuthi, “Uthi ngangikuzonda yini ukulaywa!","poem":1},{"text":"Inhliziyo yami yayikuzonda njani ukuqondiswa!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngangingafuni ukulalela abafundisi bami","poem":1},{"text":"kumbe ukulalela abeluleki bami.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngacina sengisenkingeni enkulu","poem":1},{"text":"ngiphakathi kwabantu bakaNkulunkulu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Natha amanzi kowakho umgqomo,","poem":1},{"text":"amanzi agelezayo kowakho umthombo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kambe imifudlana yakho ingayekelwa","poem":1},{"text":"igelezela emigwaqweni,","poem":2},{"text":"lezifula zakho zamanzi","poem":1},{"text":"zigelezele ezinkundleni zabantu na?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kazibe ngezakho wena wedwa,","poem":1},{"text":"ungazabelani labafokazana nje.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sengathi ungabusiswa umthombo wakho","poem":1},{"text":"njalo sengathi ungathokoza ngomfazi wobutsha bakho.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Oyimpalakazi ethandekayo, imbabala ebutshelezi","poem":1},{"text":"amabele akhe sengathi angakusuthisa lanini, nini lanini","poem":2},{"lineBreak":true},{"text":"ukhangwe luthando lwakhe.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kungani ndodana yami,","poem":1},{"text":"uthunjwa yisifebekazi?","poem":2},{"lineBreak":true},{"text":"Kungani ugona iqolo lomfazi wenye indoda?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Phela izindlela zomuntu zisobala kuThixo,","poem":1},{"text":"uyazihlola zonke izindlela zakhe.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Izenzo ezimbi zomuntu omubi ziyamthiya;","poem":1},{"text":"izibopho zesono sakhe zimuthe nko.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Uzabhubha ngoba engalayeki,","poem":1},{"text":"elahlekiswa yibuphukuphuku bakhe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}