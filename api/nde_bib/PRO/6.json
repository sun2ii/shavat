{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":6,"content":[{"type":"heading","content":["Izixwayiso Ngobuwula"]},{"type":"verse","number":1,"content":[{"text":"Ndodana yami, nxa wenzele umakhelwane wakho isibambiso,","poem":1},{"text":"nxa libambene izandla ukuba uzamhlawulela imilandu yakhe,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"aluba usuzihilele ngalokho okutshiloyo,","poem":1},{"text":"wazibambisa ngamazwi omlomo wakho,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"lapho-ke yenza lokhu, ndodana yami, ukuzikhulula,","poem":1},{"text":"njengoba usuwele ezandleni zakhe umakhelwane wakho:","poem":2},{"text":"Hamba ufike uzehlise;","poem":1},{"text":"mncengancenge umakhelwane wakho!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ungabuvumeli ubuthongo emehlweni akho,","poem":1},{"text":"ungavumeli ukuwozela enkopheni zakho.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zikhulule njengempala ezandleni zomzingeli,","poem":1},{"text":"njengenyoni esifini somthiyi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Khangela ubunyonyo, wena vila;","poem":1},{"text":"hlolisisa ukwenza kwabo uhlakaniphe!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kabulamphathi,","poem":1},{"text":"kabula mkhangeli loba umbusi,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"kodwa buyaqoqa umphako wabo ehlobo","poem":1},{"text":"bubuthe ukudla kwabo nxa kuvunwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Uzalala khonapho kuze kube nini, vila ndini?","poem":1},{"text":"Uzavuka nini ebuthongweni bakho?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ukulala okuncane, ukuwozela okuncane,","poem":1},{"text":"ukugoqa izandla kancane uphumula,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ubuyanga buzafika kuwe njengesela","poem":1},{"text":"lokuswela njengesigebenga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Isigangi lesixhwali","poem":1},{"text":"esihamba sikhuluma amanyala,","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"esiqhweba ngelihlo","poem":2},{"lineBreak":true},{"text":"sitshengise ngezinyawo zaso","poem":2},{"lineBreak":true},{"text":"njalo sitshengise ngeminwe yaso,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"esiceba ububi ngenkohliso enhliziyweni yaso","poem":2},{"lineBreak":true},{"text":"sithanda ukuvusa inkani kokuphela.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngakho lowo uzawelwa yingozi ngokuphazima;","poem":1},{"text":"uzabhidlizwa ngokuphangisa","poem":2},{"lineBreak":true},{"text":"kungasekho okungenziwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":["Ziyisithupha izinto uThixo azizondayo, eziyisikhombisa eziyisinengiso kuye:"]},{"type":"verse","number":17,"content":["amehlo atshengisa ukudelela, ulimi oluqamba amanga, izandla ezichitha igazi elingelacala,"]},{"type":"verse","number":18,"content":["inhliziyo egaya izibozi, inyawo eziphangisa ukuya ebubini,"]},{"type":"verse","number":19,"content":["umfakazi wamanga, okhuluma inkohliso lomuntu oletha ukuxabana kubazalwane."]},{"type":"heading","content":["Isixwayiso Ngokuphinga"]},{"type":"verse","number":20,"content":[{"text":"Ndodana yami, gcina imilayo kayihlo","poem":1},{"text":"ungadeli imfundiso kanyoko.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kubophele enhliziyweni yakho nini lanini;","poem":1},{"text":"kugqize entanyeni yakho.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nxa uhamba, lezizinto zizakukhokhela;","poem":1},{"text":"lanxa ulele zizakulinda;","poem":2},{"lineBreak":true},{"text":"uthi uvuka zikukhulumise.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ngoba imilayo le iyisibane,","poem":1},{"text":"imfundiso le iyikukhanya,","poem":2},{"lineBreak":true},{"text":"leziqondiso zokuzithiba ziyindlela yokuphila,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"zikuvikela kowesifazane ongaziphathanga,","poem":1},{"text":"laselimini olumnandi lomfazi ongelambeko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ungasuki umfise ngenhliziyo yakho ngenxa yobuhle bakhe","poem":1},{"text":"kumbe akuhuge ngamehlo akhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ngoba isifebe siyakululazisa ufane lesinkwa,","poem":1},{"text":"kodwa umfazi womuntu uyayibhidliza impilo yakho uqobo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kambe umuntu angokhela umlilo emathangazini akhe na","poem":1},{"text":"zingaze zatsha izigqoko zakhe?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kambe umuntu angahamba phezu kwamalahle","poem":1},{"text":"inyawo zakhe zingaze zatsha na?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kunjalo kulowo olala lomfazi wenye indoda;","poem":1},{"text":"kakho omthintayo ongayikujeziswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Abantu kabalithuki isela","poem":1},{"text":"nxa lintshontsha ngoba lifuqwa liphango.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kodwa lingabanjwa lihlawuliswa kasikhombisa,","poem":1},{"text":"lanxa inhlawulo ilithathela yonke impahla yendlu yalo.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Kodwa indoda efebayo kayilangqondo;","poem":1},{"text":"lowo okwenzayo lokho uyazibulala yena ngokwakhe.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Izidutshulo lehlazo kuyisabelo sakhe,","poem":1},{"text":"ukuyangeka kwakhe kakusoze kwafa kwaphela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Ngoba ubukhwele bendoda yalowomfazi buyiqubula ulaka,","poem":1},{"text":"ingabe isaba lozwelo lapho isiphindisela.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Kayizukuvuma inhlawulo;","poem":1},{"text":"kayiyikwamukela isivalamlomo loba singakanani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}