{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":7,"content":[{"type":"heading","content":["Isixwayiso Emfazini Oyisifebe"]},{"type":"verse","number":1,"content":[{"text":"Ndodana yami, agcine amazwi ami","poem":1},{"text":"ulondoloze imilayo yami ngaphakathi kwakho.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gcina imilayo yami ukuze uphile;","poem":1},{"text":"ulinde imfundiso yami njengegugu lakho elikhulu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ibophele eminweni yakho;","poem":1},{"text":"uyilobe enhliziyweni yakho.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tshela ukuhlakanipha uthi, “Ungudadewethu wena,”","poem":1},{"text":"uthi ukuqedisisa kuyisihlobo sakho;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"lezizinto zizakuvikela emfazini oyisifebe,","poem":1},{"text":"lakumkakho ongelambeko ngamazwi akhe adukisayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ngema ewindini lendlu yami","poem":1},{"text":"ngalunguza ngesikhala.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngabona phakathi kwabayizithutha,","poem":1},{"text":"ngananzelela phakathi kwamajaha","poem":2},{"lineBreak":true},{"text":"ngabona ijaha elingelangqondo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lalisehla ngomgwaqo liseduze lejiko,","poem":1},{"text":"liqonda endlini yowesifazane","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ntambama sekunqunda amehlo,","poem":1},{"text":"umnyama wobusuku usujiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Khonokho nje kwaqhamuka owesifazane elihlangabeza","poem":1},{"text":"egqoke okwesifebe ngoba eqophile.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"(Umfazi lowo, ngumuntu womsindo uyisiqholo,","poem":1},{"text":"inyawo zakhe kazihlali phansi;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"khathesi nangu emgwaqweni, njalo nangu enkundleni,","poem":1},{"text":"utshobatshoba izindawana zonke.)","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wafika waligona lelijaha walanga","poem":1},{"text":"wakhuluma engelanhloni wathi:","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Ngenzile umnikelo wobudlelwano ngekhaya;","poem":1},{"text":"lamuhla ngizigcwalisile izifungo zami.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yikho ngilapha ukukuhlangabeza;","poem":1},{"text":"sengikudinge ngaze ngakuthola!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Sengiwendlele umbheda wami","poem":1},{"text":"ngamalineni eGibhithe awemibalabala.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sengiwuqholile umbheda wami ngemure,","poem":1},{"text":"ngenhlaba langesinamoni.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Woza sizitike ngothando kuze kuse;","poem":1},{"text":"kasizijabulise ngothando!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Indoda yami kayikho ekhaya;","poem":1},{"text":"ihambile iye khatshana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ithwele isikhwama sayo sigcwele imali,","poem":1},{"text":"ngakho kayibuyi kuze kube phakathi kwenyanga.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ngamazwi akhe amnandi waledukisa ijaha lelo;","poem":1},{"text":"walihuga ijaha lelo ngolimi olumnandi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Khonokho nje lahle lamlandela","poem":1},{"text":"njengenkabi idonselwa ukuyabulawa,","poem":2},{"text":"njengomziki uzingenisa emjibileni,","poem":1}]},{"type":"verse","number":23,"content":[{"text":"umtshoko uze uyehlaba isibindi,","poem":2},{"text":"njengenyoni ithothela ngaphansi kwesifu,","poem":1},{"text":"ingaboni ukuthi isizingenise ekufeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ngakho-ke madodana ami, ngilalelani;","poem":1},{"text":"zwanini lokhu engikutshoyo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Lingayivumeli inhliziyo ikhangwe yizindlela zakhe,","poem":1},{"text":"langabe iphumputhekele emikhubeni yakhe.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Banengi labo asebadilizile;","poem":1},{"text":"izinkubela zakhe zilucaca olwesabekayo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Indlu yakhe ingumgudu oya engcwabeni,","poem":1},{"text":"iholela phansi ezindongeni zokufa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}