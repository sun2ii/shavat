{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":8,"content":[{"type":"heading","content":["Ubizo Lokuhlakanipha"]},{"type":"verse","number":1,"content":[{"text":"Ukuhlakanipha kakumemezi yini?","poem":1},{"text":"Ukuqedisisa kakuphakamisi ilizwi lakho na?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Emiqolweni yezindlela,","poem":1},{"text":"emahlanganweni ezindlela kulapho okujame khona;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"emasangweni angena phakathi kwedolobho,","poem":1},{"text":"ezintubeni kuyamemeza kakhulu kusithi:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Ngimemeza lina, madoda;","poem":1},{"text":"ilizwi lami libiza bonke abantu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lina eliyizithutha, zuzani ukuqonda;","poem":1},{"text":"lina ziphukuphuku, zuzani ukuqedisisa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lalelani ngoba ngilitshela izinto eziqakathekileyo;","poem":1},{"text":"ngivula izindebe zami ngikhuluma okuqondileyo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Umlomo wami ukhuluma okuliqiniso,","poem":1},{"text":"ngoba izindebe zami ziyabenyanya ububi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wonke amazwi omlomo wami aqondile;","poem":1},{"text":"kalikho lelilodwa elitshekileyo loba elingcolileyo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kulowo ozwisisayo wonke alungile;","poem":1},{"text":"akulankohliso kulabo abalolwazi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Khetha iseluleko sami kulesiliva,","poem":1},{"text":"ulwazi kulegolide elikhethiweyo,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ngoba ukuhlakanipha kuligugu okudlula amarubhi,","poem":1},{"text":"njalo akulanto ongayifisa ezifisweni zakho okulingana lakho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mina, kuhlakanipha, ngihlala ndawonye lokuqondisisa;","poem":1},{"text":"ngilolwazi lokukhetha kuhle.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ukwesaba uThixo yikuzonda ububi;","poem":1},{"text":"ngiyakuzonda ukuzazisa lobuqholo,","poem":2},{"lineBreak":true},{"text":"ukuziphatha kubi lenkulumo ebolileyo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ukweluleka lokwahlulela okuhle kungokwami;","poem":1},{"text":"ngilokuzwisisa lamandla.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Amakhosi abusa ngenxa yami","poem":1},{"text":"lababusi balakho ukutshaya imithetho elungileyo;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"amakhosana abusa ngami,","poem":1},{"text":"lazozonke izikhulu ezibusa emhlabeni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ngiyabathanda labo abangithandayo,","poem":1},{"text":"labo abangidingayo bayangithola.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kimi kukhona inotho lodumo,","poem":1},{"text":"inotho engapheliyo lokuphumelela.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Izithelo zami zingcono kulegolide elicengiweyo;","poem":1},{"text":"okuphuma kimi kwedlula isiliva sekhethelo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ngihamba ngendlela yokulunga,","poem":1},{"text":"ngilandela umkhondo wokuqonda,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ngiyabela inotho kulabo abangithandayo","poem":1},{"text":"ngigcwalise iziphala zabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"UThixo wangenza ngaba khona","poem":1},{"text":"ngaqalela konke okukhona,","poem":2},{"lineBreak":true},{"text":"kuqala kokwenza ezinye izinto;","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ngaba khona ekudabukeni kwezinto,","poem":1},{"text":"kwasekuqaleni, umhlaba ungakabi khona.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kungakabi lezilwandle, ngasengizelwe,","poem":1},{"text":"kungakabi khona izihotsha ezigcwele amanzi;","poem":2}]},{"type":"verse","number":25,"content":[{"text":"izintaba zingakamiswa ensikeni zazo,","poem":1},{"text":"engakabi khona amaqaqa, ngasengizelwe,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"uThixo engakawenzi umhlaba lamaganga,","poem":1},{"text":"loba lonke uthuli lomhlaba.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ngangikhona uThixo ehlela kuhle izulu,","poem":1},{"text":"ephawula kuhle imingcele yomkhathi lolwandle,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"esenza amayezi emkhathini","poem":1},{"text":"wazizinzisa inziki zolwandle,","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ebeka imingcele yolwandle","poem":1},{"text":"ukuze amanzi angedluli izimiso zakhe,","poem":2},{"text":"ngesikhathi lapho emisa izisekelo zomhlaba.","poem":1}]},{"type":"verse","number":30,"content":[{"text":"Ngalesosikhathi ngangingumbumbi eceleni kwakhe.","poem":2},{"text":"Ngangilenjabulo enkulu insuku ngensuku,","poem":1},{"text":"ngithokoza ukuba laye kokuphela,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ngithokoza ngomhlaba wakhe wonke","poem":1},{"text":"ngijabuliswa yibukhona babantu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Ngakho-ke, madodana ami, ngilalelani;","poem":1},{"text":"babusisekile labo abalondoloza izindlela zami.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Lalelani imfundiso yami ukuze lihlakaniphe;","poem":1},{"text":"lingaqali ukuyidela.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ubusisiwe lowomuntu ongilalelayo,","poem":1},{"text":"olinda imihla yonke eminyango yami,","poem":2},{"lineBreak":true},{"text":"elindile entubeni yami.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ngoba lowo ongifumanayo uzuza ukuphila","poem":1},{"text":"emukeliswe ukuthandwa nguThixo.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Kodwa lowo owehlulekayo ukungifumana uyazilimaza;","poem":1},{"text":"bonke abangizondayo bathanda ukufa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}