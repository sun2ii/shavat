{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PRO","translationId":"nde_bib","name":"Izaga","commonName":"Izaga","title":"Izaga","order":20,"numberOfChapters":31,"sha256":"fd986217a4362cbfc99bdae769527996ffed86d0961aea73a81d8f20397d1b1a","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/nde_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"heading","content":["Ukunxusa Kwenhlakanipho Lokobuwula"]},{"type":"verse","number":1,"content":[{"text":"Ukuhlakanipha sekuzakhele indlu yakho,","poem":1},{"text":"imisiwe ngezinsika eziyisikhombisa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isiphekiwe inyama yakho kwalungiswa lewayini;","poem":1},{"text":"konke sekudekiwe etafuleni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Usewathumile amantombazana,","poem":1},{"text":"uyanxusa emi ezindaweni eziphakemeyo zedolobho.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"“Akuthi bonke abayizithutha beze lapha!”","poem":2},{"text":"Esitsho kulabo abangaqedisisiyo.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"“Wozani lidle ukudla kwami","poem":2},{"lineBreak":true},{"text":"linathe iwayini esengililungisile.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lahlani izindlela zenu zobuthutha lizaphila;","poem":1},{"text":"hambani ngendlela yokuzwisisa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lowo oweluleka oklolodayo ubiza inhlamba;","poem":1},{"text":"okhuza umuntu oxhwalileyo ucina ethethiswa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ungakhuzi isiqholo ngoba sizakuzonda;","poem":1},{"text":"khuza ohlakaniphileyo uzakuthanda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yeluleka umuntu ohlakaniphileyo","poem":1},{"text":"uzakwandisa ukuhlakanipha kwakhe;","poem":2},{"lineBreak":true},{"text":"fundisa umuntu olungileyo, uzakwengeza ulwazi lwakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ukumesaba uThixo kuyikuqala kwenhlakanipho,","poem":1},{"text":"njalo ulwazi ngaLowo oNgcwele luyikuqedisisa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngoba ngami zizakuba zinengi insuku zakho,","poem":1},{"text":"kwandiswe iminyaka yokuphila kwakho.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nxa uhlakaniphile, ukuhlakanipha kwakho kuzakusiza;","poem":1},{"text":"aluba uyisiqholo, uzahlupheka wedwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Umfazi othiwa nguBuwula ulomsindo;","poem":1},{"text":"kagobeki njalo kazi lutho.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Uthanda ukuhlala emnyango wendlu yakhe,","poem":1},{"text":"esihlalweni endaweni esesiqongweni sedolobho,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"abe ehuga labo abedlulayo,","poem":1},{"text":"abahamba beqonde lapho abaya khona.","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"“Abeze lapha bonke abayizithutha!”","poem":2},{"text":"Esitsho kulabo abangacabangiyo.","poem":1}]},{"type":"verse","number":17,"content":[{"text":"“Ulutho lokuntshontshwa lumnandi;","poem":2},{"lineBreak":true},{"text":"ukudla okudlelwa ensitha kuyahlabusa!”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kodwa kabazi ukuthi kuyafiwa, kuleyondawo,","poem":1},{"text":"ukuthi izethekeli zalowomfazi sezaphelela ekujuleni kwengcwaba.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}