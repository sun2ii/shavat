{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Kungani, Oh Thixo, umela khatshana?","poem":1},{"text":"Kungani uzifihla ngezikhathi zokuhlupheka?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngobuqholo bakhe umuntu omubi uzingela ababuthakathaka,","poem":1},{"text":"abayengeka ngamacebo awakhayo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Uzikhukhumeza ngezinkanuko zenhliziyo yakhe;","poem":1},{"text":"ubusisa abayizihwaba athuke uThixo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngenxa yokuzigqaja kwakhe omubi kamdingi uThixo;","poem":1},{"text":"kuyo yonke imicabango yakhe akulandawo kaNkulunkulu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Izindlela zakhe ziyaphumelela;","poem":1},{"text":"uyadelela njalo lemithetho yakho ikhatshana laye","poem":2},{"lineBreak":true},{"text":"aneme lapho ebona izitha zakhe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Uthi, “Akulalutho olungangixukuxa;","poem":1},{"text":"ukuthokoza ngokwami lanini,","poem":2},{"lineBreak":true},{"text":"angiyikufa ngahlupheka.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Umlomo wakhe ugcwele amanga lenhlamba lezithuko;","poem":1},{"text":"ulimi lwakhe luqukethe uhlupho lobubi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ucathama ngaphandle kwemizi;","poem":1},{"text":"avumbuluke lapho abulale abantu abamsulwa,","poem":2},{"lineBreak":true},{"text":"ahlale ecatheme ekusithekeni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uyacathama njengesilwane ekusithekeni;","poem":1},{"text":"ucathamela labo abangelamandla;","poem":2},{"text":"uyabadumela abahudulele emambuleni akhe.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Ababambileyo uyabachoboza baphangalale;","poem":1},{"text":"uyabawisa ngamandla akhe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Uzitshela athi, “UNkulunkulu usekhohliwe;","poem":1},{"text":"uyabugubuzela ubuso bakhe angabe esabona.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Vuka, Thixo! Phakamisa isandla sakho,","poem":1},{"text":"Oh Nkulunkulu. Ungabakhohlwa abazihluphekelayo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kungani umuntu omubi ethuka uNkulunkulu na?","poem":1},{"text":"Kungani na ezitshela esithi,","poem":2},{"lineBreak":true},{"text":"“Kazukungithonisisa?”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kodwa wena, Oh Nkulunkulu, uyalubona uhlupho losizi;","poem":1},{"text":"uyakunanzelela ukuze ulamule.","poem":2},{"text":"Ongelamandla uzilahla kuwe;","poem":1},{"text":"wena ungumsizi wezintandane.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yephula ingalo yomuntu oxhwalileyo;","poem":1},{"text":"mthonisise ngokuganga kwakhe","poem":2},{"lineBreak":true},{"text":"obekuzahlala kungaziwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"UThixo ungumbusi kuze kube nini lanini;","poem":1},{"text":"izizwe zizabhubha elizweni lakhe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Uyazizwa, Oh Thixo, izifiso zabancindezelweyo;","poem":1},{"text":"uyabaqinisa, ulalele ukukhala kwabo,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ulamulele izintandane labancindezelweyo,","poem":1},{"text":"ukuze kuthi umuntu, ongowasemhlabeni,","poem":2},{"lineBreak":true},{"text":"angabe esesabeka futhi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}