{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["ElikaDavida. Ihubo."]},{"type":"verse","number":1,"content":[{"text":"Ngizahlabelela ngothando lwakho lokwahlulela kwakho okuhle;","poem":1},{"text":"kuwe, Oh Thixo, ngizahlabelela indumiso.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ngizananzelela ukuthi ngiphile impilo engasolekiyo","poem":1},{"text":"uzakuza nini kimi na?","poem":2},{"lineBreak":true},{"text":"Ngizahamba endlini","poem":1},{"text":"yami ngenhliziyo engasolekiyo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Phambi kwamehlo ami","poem":1},{"text":"angiyikubeka lutho olungcolileyo.","poem":2},{"lineBreak":true},{"text":"Izenzo zabantu abangakholwayo ngiyazizonda;","poem":1},{"text":"kazizukunginamathela.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Abantu abalenhliziyo exhwalileyo bazakuba khatshana lami;","poem":1},{"text":"angiyikuhambelana lobubi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lowo ochothoza umakhelwane wakhe ngasese,","poem":1},{"text":"lowo ngizamthulisa;","poem":2},{"text":"olamehlo asesiphundu lenhliziyo ezigqajayo,","poem":1},{"text":"lowo kangilasikhathi laye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Amehlo ami azakuba kwabathembekileyo elizweni,","poem":1},{"text":"ukuthi bahlale lami;","poem":2},{"text":"lowo okuhamba kwakhe kakulansolo","poem":1},{"text":"uzangisebenzela ekhonza kimi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kakho othanda ukwenza inkohliso","poem":1},{"text":"ozahlala endlini yami;","poem":2},{"text":"kakho okhuluma amanga","poem":1},{"text":"ozakuma phambi kwami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Zonke insuku ekuseni ngizabathulisa","poem":1},{"text":"bonke ababi phakathi kwelizwe;","poem":2},{"text":"ngizamlahla phansi wonke umuntu oyisigangi","poem":1},{"text":"edolobheni likaThixo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}