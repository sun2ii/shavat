{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":102,"content":[{"type":"hebrew_subtitle","content":["Umkhuleko womuntu okhathazekileyo. Lapho esephela umoya eseqhinqa isililo phambi kukaThixo."]},{"type":"verse","number":1,"content":[{"text":"Zwana umkhuleko wami, Oh Thixo;","poem":1},{"text":"ukukhala kwami ngicela uncedo kakufike kuwe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ungangifihleli ubuso bakho","poem":1},{"text":"nxa ngikhathazekile.","poem":2},{"text":"Ngipha indlebe yakho;","poem":1},{"text":"nxa ngibiza ngiphendula masinyane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngoba insuku zami ziyanyamalala njengentuthu;","poem":1},{"text":"amathambo ami ayavutha njengamalahle abhebhayo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Inhliziyo yami yonakele, ibunile njengotshani;","poem":1},{"text":"ngiyakhohlwa ukudla kwami.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngenxa yokububula kwami okukhulu sengiphelile,","poem":1},{"text":"isikhumba sesinamathela emathanjeni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sengifana lesikhova senkangala,","poem":1},{"text":"njengesikhova semanxiweni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngilala ngikhangele;","poem":1},{"text":"senginjengenyoni ehlezi yodwa ephahleni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ilanga lonke izitha zami ziyangichukuluza;","poem":1},{"text":"labo abangichothozayo badlala ngebizo lami njengesethuko.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngoba ngidla umlotha njengokudla kwami,","poem":1},{"text":"ngixube okunathwayo kwami ngezinyembezi","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ngenxa yokuthukuthela kwakho okukhulu,","poem":1},{"text":"ngoba ungiqukule wangilahlela eceleni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Insuku zami zifana lesithunzi sakusihlwa;","poem":1},{"text":"ngiyabuna njengotshani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kodwa wena, Oh Thixo, uhlezi ebukhosini lanininini;","poem":1},{"text":"udumo lwakho lumi ezizukulwaneni zonke.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Uzaphakama uzwele iZiyoni isihawu,","poem":1},{"text":"ngoba sekuyisikhathi sokutshengisa umusa kuyo,","poem":2},{"lineBreak":true},{"text":"isikhathi esimisiweyo sesifikile.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ngoba amatshe ayo aligugu ezincekwini zakho;","poem":1},{"text":"othuli lwayo nje lubalethela usizi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Izizwe zizalesaba ibizo likaThixo,","poem":1},{"text":"wonke amakhosi omhlaba azahlonipha inkazimulo yakhe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ngoba uThixo uzayakha kutsha iZiyoni","poem":1},{"text":"avele enkazimulweni yakhe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Uzaphendula imikhuleko yabahluphekayo;","poem":1},{"text":"kazukweyisa isicelo sabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Lokhu kakulotshwe phansi kube ngokwesizukulwane sakusasa,","poem":1},{"text":"ukuze abantu abangakadalwa bamdumise uThixo :","poem":2}]},{"type":"verse","number":19,"content":[{"text":"“UThixo wakhangela phansi ephezulu endlini yakhe engcwele,","poem":1},{"text":"esezulwini wawuhlola umhlaba,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ukuze ezwe ukububula kwezibotshwa","poem":1},{"text":"lokukhulula labo ababegwetshelwe ukufa.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ngalokho-ke ibizo likaThixo lizamenyezelwa eZiyoni","poem":1},{"text":"lodumo lwakhe eJerusalema,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"lapha izizwe lemibuso","poem":1},{"text":"sekuhlangana ndawonye ukukhonza uThixo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Wawanciphisa amandla ami ngisaphila;","poem":1},{"text":"waziphungula insuku zami.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Yikho ngasengisithi,","poem":1},{"lineBreak":true},{"text":"“Ungangithathi, Oh Nkulunkulu wami,","poem":1},{"text":"ngilokhu ngisephakathi kwensuku zami;","poem":2},{"lineBreak":true},{"text":"iminyaka yakho ihlala ikhona ezizukulwaneni zonke.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ekuqaleni wabeka izisekelo zomhlaba,","poem":1},{"text":"lamazulu angumsebenzi wezandla zakho.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Konke kuzabhubha, kodwa wena uzasala;","poem":1},{"text":"konke kuzaguga njengesigqoko.","poem":2},{"text":"Njengesivunulo uzakuguqula","poem":1},{"text":"kucine sekulahlwa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kodwa wena uhlala unjalo,","poem":1},{"text":"leminyaka yakho kayiyikuphela.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Abantwana bezinceku zakho bazahlala besemehlweni akho;","poem":1},{"text":"izizukulwane zazo zizaqiniswa phambi kwakho.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}