{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":103,"content":[{"type":"hebrew_subtitle","content":["ElikaDavida."]},{"type":"verse","number":1,"content":[{"text":"Dumisa uThixo, Oh mphefumulo wami;","poem":1},{"text":"konke okuphakathi kwami,","poem":2},{"lineBreak":true},{"text":"kakudumise ibizo lakhe elingcwele.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dumisa uThixo, Oh mphefumulo wami,","poem":1},{"text":"ungaze wakhohlwa konke okuhle okuthola kuye","poem":2}]},{"type":"verse","number":3,"content":[{"text":"othethelelayo zonke izono zakho","poem":1},{"text":"akusilise kuzozonke izifo zakho,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ohlenga impilo yakho egodini","poem":1},{"text":"akwethese uthando lesihawu,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"osuthisa izifiso zakho ngezinto ezinhle","poem":1},{"text":"ukuze ubutsha bakho buvuselelwe njengengqungqulu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"UThixo ubenzela ukulunga","poem":1},{"text":"lokwahlulela okuhle labo abancindezelweyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Izindlela zakhe wazazisa uMosi,","poem":1},{"text":"izenzo zakhe wazazisa abantu bako-Israyeli;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"uThixo ulesihawu njalo ulomusa,","poem":1},{"text":"uyaphuza ukuthukuthela, kodwa uyanda ngothando.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kahlali ebeka imilandu","poem":1},{"text":"futhi kagcini ulaka lwakhe kokuphela;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"kasiphathi ngokufanele izono zethu","poem":1},{"text":"kumbe asijezise ngokulingene iziphambeko zethu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ngoba njengokuphakama komkhathi ngaphezu komhlaba,","poem":1},{"text":"lukhulu kangako uthando lwakhe kulabo abamesabayo;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"njengobukhatshana bempumalanga kuyo intshonalanga","poem":1},{"text":"kanjalo ususile iziphambeko zethu kithi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ngendlela ubaba elozwelo ebantwaneni bakhe,","poem":1},{"text":"kanjalo uThixo ulozwelo kulabo abamesabayo;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ngoba uyakwazi ukuthi sibunjwe njani,","poem":1},{"text":"uyakhumbula ukuthi siluthuli.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Umuntu yena insuku zakhe zinjengotshani,","poem":1},{"text":"ukhula amemetheke njengembali yeganga;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"umoya uyayiphephetha ihle inyamalale,","poem":1},{"text":"indawo yakhe ingabe isayikhumbula lanini.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kodwa kusukela phakade kusiya phakade","poem":1},{"text":"uthando lukaThixo lukulabo abamesabayo,","poem":2},{"lineBreak":true},{"text":"lokulunga Kwakhe ebantwaneni babantwana","poem":2}]},{"type":"verse","number":18,"content":[{"text":"kulabo abagcina isivumelwano Sakhe","poem":1},{"text":"njalo bakhumbule ukulalela izimiso zakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"UThixo usemisile isihlalo sakhe sobukhosi ezulwini,","poem":1},{"text":"njalo ubukhosi bakhe buphezu kwakho konke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dumisani uThixo, lina zingilosi,","poem":1},{"text":"lina zinceku zakhe elenza intando yakhe,","poem":2},{"lineBreak":true},{"text":"elilalela ilizwi lakhe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Dumisani uThixo, lonke mabutho akhe asezulwini,","poem":1},{"text":"lina zinceku zakhe elenza intando yakhe.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Dumisani uThixo, imisebenzi yakhe yonke","poem":1},{"text":"ezindaweni zonke embusweni wakhe.","poem":2},{"lineBreak":true},{"text":"Dumisa uThixo, Oh mphefumulo wami.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}