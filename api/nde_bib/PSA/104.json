{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":104,"content":[{"type":"verse","number":1,"content":[{"text":"Dumisa uThixo, Oh mphefumulo wami.","poem":1},{"lineBreak":true},{"text":"Oh Thixo Nkulunkulu wami, umkhulu kakhulu;","poem":1},{"text":"ugqoke inkazimulo lobukhosi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Uyazigoqela ngokukhanya kungathi njengesivunulo;","poem":1},{"text":"amazulu uyawelula njengethente","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"anqumise intungo zezindlu zangaphezulu zilale phezu kwamanzi.","poem":2},{"text":"Wenza amayezi inqola yakhe yamabhiza,","poem":1},{"text":"undiza ngezimpiko zomoya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wenza izikhatha zomoya zibe yizithunywa zakhe,","poem":1},{"text":"amalangabi omlilo izinceku zakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wawugxilisa umhlaba ezisekelweni zawo;","poem":1},{"text":"ungeke wagudlulwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wawembesa ngolwandle njengesivunulo;","poem":1},{"text":"amanzi ema ngaphezu kwezintaba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kodwa wathi ngokukhwaza amanzi abaleka,","poem":1},{"text":"ngomsindo wokuduma kwakho asibathela;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ageleza phezu kwezintaba,","poem":1},{"text":"ehlela ezigodini","poem":2},{"lineBreak":true},{"text":"endaweni owamisele kuyo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wamisa umkhawulo angeke aweqe;","poem":1},{"text":"kasayikubuya awugubuzele njalo umhlaba lanini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wenza imithombo impompozele amanzi ezindongeni;","poem":1},{"text":"ageleza phakathi kwezintaba,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"zipha amanzi kuzozonke izinyamazana zeganga;","poem":1},{"text":"labobabhemi beganga bacitsha lapho ukoma.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Izinyoni zomoya zakhela eduze kwamanzi;","poem":1},{"text":"ziyatshiloza phakathi kwezingatsha.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Uyazithelezela izintaba esezindlini zakhe eziphezulu;","poem":1},{"text":"umhlaba uyawusuthisa ngezithelo zomsebenzi wakhe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Umilisela inkomo utshani,","poem":1},{"text":"ahlanyelele abantu bona bahlakule","poem":2},{"lineBreak":true},{"text":"kuzuzakale ukudla emhlabathini:","poem":2}]},{"type":"verse","number":15,"content":[{"text":"iwayini elijabulisa inhliziyo yomuntu,","poem":1},{"text":"amagcobo enza ubuso bakhe bukhazimule,","poem":2},{"lineBreak":true},{"text":"lesinkwa esilulamisa inhliziyo yakhe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Izihlahla zikaThixo ziyathelelwa okwaneleyo,","poem":1},{"text":"imisedari yeLebhanoni ayihlanyelayo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Izinyoni zakhela kuyo izidleke zazo;","poem":1},{"text":"ingabuzane lakha indlu yalo ezihlahleni zephayini.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Izintaba eziphakemeyo ngezamagogo,","poem":1},{"text":"amawa ayisiphephelo sezimbila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Inyanga yehlukanisa izibanga zomnyaka,","poem":1},{"text":"lelanga liyazi ukuthi litshona nini.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Uletha umnyama, kube sebusuku,","poem":1},{"text":"lapho zonke izinyamazana zeganga zizingele.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Izilwane ziyabhonga zifuna inyama yazo","poem":1},{"text":"zidinga ukudla kwazo kuNkulunkulu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ilanga liyaphuma, zibe sezicatsha;","poem":1},{"text":"ziyabuyela ezikhundleni zazo zilale.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Umuntu abe esephuma aye emsebenzini wakhe,","poem":1},{"text":"ayotshikatshika kuze kube ntambama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Minengi kanganani imisebenzi yakho, Oh Thixo!","poem":1},{"text":"Zonke wazenza ngenhlakanipho;","poem":2},{"lineBreak":true},{"text":"umhlaba ugcwele izidalwa zakho.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nantuyana ulwandle, uthwaca olungakaya,","poem":1},{"text":"olunyakazela ngezidalwa ezingelakubalwa","poem":2},{"lineBreak":true},{"text":"izinto eziphilayo ezinkulu lezincinyane.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kulapho imikhumbi endenda khona isiyale lale,","poem":1},{"text":"loleviyathani, isilo owasenza ukuthi sidlale khona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Zonke lezi zikhangele kuwe","poem":1},{"text":"ukuthi uziphe ukudla ngesikhathi esifaneleyo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Uthi ungazipha bese zikubuthela ndawonye;","poem":1},{"text":"uthi ungavula isandla sakho,","poem":2},{"lineBreak":true},{"text":"zisuthiswe ngezinto ezinhle.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Uthi ungafihla ubuso bakho zitshaywe luvalo;","poem":1},{"text":"uthi ungathatha umphefumulo wazo,","poem":2},{"lineBreak":true},{"text":"zife zibuyele othulini.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Uthi ungathumela uMoya","poem":1},{"text":"wakho zidalwe,","poem":2},{"lineBreak":true},{"text":"uwenze ube muhle umhlaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Sengathi inkazimulo kaThixo ingema lanini;","poem":1},{"text":"sengathi uThixo angathokoza ngemisebenzi yakhe","poem":2}]},{"type":"verse","number":32,"content":[{"text":"yena okhangela umhlaba uthuthumele,","poem":1},{"text":"othinta izintaba zithunqe intuthu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Ngizahlabelela kuThixo impilo yami yonke;","poem":1},{"text":"ngizahlabelela indumiso kuNkulunkulu wami lanini nxa ngisaphila.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Sengathi iminakano yami ingamthokozisa,","poem":1},{"text":"ngoba ngiyathokoza kuThixo.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Kodwa sengathi izoni zinganyamalala emhlabeni","poem":1},{"text":"lezigangi zingabe zisaba khona.","poem":2},{"lineBreak":true},{"text":"Dumisa uThixo, Oh Mphefumulo wami.","poem":1},{"lineBreak":true},{"text":"Dumisa uThixo, Oh Mphefumulo wami.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}