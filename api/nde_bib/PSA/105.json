{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":105,"content":[{"type":"verse","number":1,"content":[{"text":"Bongani uThixo, memezani ibizo lakhe;","poem":1},{"text":"lizazise phakathi kwabantu izenzo zakhe","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hlabelelani kuye, hlabelelani indumiso kuye;","poem":1},{"text":"likhulume ngezenzo zakhe zonke ezimangalisayo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jabulani ebizweni lakhe elingcwele;","poem":1},{"text":"kazithokoze inhliziyo zabo abamdingayo uThixo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dingani uThixo lamandla akhe,","poem":1},{"text":"limdinge yena njalonjalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Khumbulani izenzo zakhe ezimangalisayo azenzayo,","poem":1},{"text":"izimangaliso azenzayo, lezahlulelo azikhulumayo,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"lina zizukulwane zika-Abhrahama inceku yakhe,","poem":1},{"text":"lina madodana kaJakhobe, abakhethiweyo bakhe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"UnguThixo uNkulunkulu wethu;","poem":1},{"text":"izahlulelo zakhe zisemhlabeni wonke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Uyasikhumbula isivumelwano sakhe nini lanini,","poem":1},{"text":"ilizwi lomlayo wakhe, okwezizukulwane ezizinkulungwane,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"isivumelwano asenza lo-Abhrahama,","poem":1},{"text":"isifungo asifungayo ku-Isaka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wakuqinisa lokhu kuJakhobe","poem":1},{"text":"kwaba yisimiso ku-Israyeli njengesivumelwano saphakade:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"wathi “Ngizalinika ilizwe laseKhenani","poem":1},{"text":"njengesabelo selifa lenu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kwathi besesebalutshwana,","poem":1},{"text":"bebalutshwana kakhulu, beyizihambi kulo,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"bezula kuzizwe ngezizwe","poem":1},{"text":"besuka komunye umbuso besiya komunye.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kavumelanga loba ngubani ukubancindezela;","poem":1},{"text":"wawakhuza amakhosi ngenxa yabo:","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Lingabathinti abagcotshiweyo bami;","poem":1},{"text":"lingahlukuluzi abaphrofethi bami.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Waletha indlala elizweni","poem":1},{"text":"wachitha zonke iziphala zokudla;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"wathumela indoda yabandulela","poem":1},{"text":"uJosefa owathengiswa waba yisigqili.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bambhonxula inyawo zakhe ngezibopho,","poem":1},{"text":"wabotshwa intamo ngezinsimbi,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"kwaze kwathi lokho ayekutsho ngaphambili kwagcwaliseka,","poem":1},{"text":"kwaze kwathi ilizwi likaThixo","poem":2},{"lineBreak":true},{"text":"latshengisa ukuthi wayeqinisile.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Inkosi yathumela ukuthi akhululwe,","poem":1},{"text":"umbusi wezizwe wamkhulula.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wamenza umbusi wendlu yakhe,","poem":1},{"text":"umbusi wakho konke okwakungokwakhe,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ukuqondisa amakhosana akhe njengokubona kwakhe","poem":1},{"text":"lokufundisa abadala bakhe inhlakanipho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kwathi-ke u-Israyeli wayangena eGibhithe;","poem":1},{"text":"uJakhobe wahlala njengowezizweni elizweni likaHamu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"UThixo wenza abantu bakhe banda kakhulu;","poem":1},{"text":"wabenza baba banengi kakhulu bandela izitha zabo,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"kwathi inhliziyo zabo wazenza zazonda abantu bakhe,","poem":1},{"text":"bakha amacebo amabi ngezinceku zakhe.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Wathuma uMosi inceku yakhe,","poem":1},{"text":"lo-Aroni ayebakhethile.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Benza iziboniso zakhe ezimangalisayo phakathi kwabo,","poem":1},{"text":"izimanga zakhe elizweni likaHamu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Wathumela umnyama wenza ilizwe laba mnyama","poem":1},{"text":"kanti angithi babewahlamukele amazwi akhe?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Waguqula amanzi abo aba ligazi,","poem":1},{"text":"okwenza inhlanzi zawo zafa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ilizwe labo lanyakazela ngamaxoxo,","poem":1},{"text":"angena ezindlini zokulala ezababusi babo.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Wakhuluma, kwavela umtshitshi wezibawu,","poem":1},{"text":"lenswintila elizweni labo lonke.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Wenza izulu labo laba yisiqhotho,","poem":1},{"text":"laba lombane elizweni labo lonke;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"wacakazela phansi amavini abo lemikhiwa,","poem":1},{"text":"waphundla izihlahla zelizwe labo.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Wakhuluma zatheleka izintethe,","poem":1},{"text":"izintethe ezingelakubalwa;","poem":2}]},{"type":"verse","number":35,"content":[{"text":"zadla yonke into eluhlaza elizweni labo,","poem":1},{"text":"zadla izithelo zomhlabathi wabo.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ngemva kwalokho wasebulala amazibulo wonke elizweni labo,","poem":1},{"text":"izithelo zokuqala zobulisa babo.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Wamkhupha u-Israyeli, ethwele esisitheka isiliva legolide,","poem":1},{"text":"kakwaba lamunye phakathi kwezizwana zabo owehlulwa yikufa.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"IGibhithe yathokoza ngokusuka kwabo,","poem":1},{"text":"ngoba base bemesaba kubi u-Israyeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Wendlala iyezi lagubuzela,","poem":1},{"text":"lomlilo ukukhanyisa ebusuku.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Bacela wabalethela izagwaca,","poem":1},{"text":"wabasuthisa ngesinkwa sasezulwini.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Wavula ilitshe amanzi antshaza;","poem":1},{"text":"njengomfula ageleza enkangala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":42,"content":[{"text":"Ngoba wakhumbula isithembiso sakhe esingcwele","poem":1},{"text":"esaphiwa inceku yakhe u-Abhrahama.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Wabakhupha abantu bakhe ngokuthokoza,","poem":1},{"text":"abakhethiweyo bakhe ngenhlokomo yentokozo.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Wabapha amazwe ezizwe,","poem":1},{"text":"badla ilifa lalokho okwakuginqelwe ngabanye,","poem":2}]},{"type":"verse","number":45,"content":[{"text":"ukuze bagcine iziqondiso zakhe","poem":1},{"text":"njalo balalele imithetho yakhe.","poem":2},{"lineBreak":true},{"text":"Dumisani uThixo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":45}