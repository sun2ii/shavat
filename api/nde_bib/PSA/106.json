{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":106,"content":[{"type":"verse","number":1,"content":[{"text":"Dumisani uThixo.","poem":1},{"lineBreak":true},{"text":"Bongani uThixo, ngoba ulungile;","poem":1},{"text":"uthando lwakhe lumi lanini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ngubani ongamemezela imisebenzi emikhulu kaThixo","poem":1},{"text":"loba atsho ngokugcweleyo udumo lwakhe na?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Babusisiwe labo abahlala besenza ngendlela enhle,","poem":1},{"text":"abahlezi besenza okulungileyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ungikhumbule, Thixo, nxa usuveza umusa ebantwini bakho,","poem":1},{"text":"woza ungisize nxatshana usubasindisa,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ukuze lami ngikholise ukuphumelela kwalabo obakhethileyo,","poem":1},{"text":"ukuze ngabelwe entokozweni yesizwe sakho","poem":2},{"lineBreak":true},{"text":"ngihlanganyele lelifa lakho ekudumiseni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sonile, njengalokho abakwenzayo okhokho bethu;","poem":1},{"text":"senzile okubi senza izinto ezimbi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lapho okhokho bethu beseGibhithe,","poem":1},{"text":"kabayinakanga imimangaliso yakho;","poem":2},{"text":"kabazikhumbulanga izenzo zakho zomusa ezinengi,","poem":1},{"text":"bahlamuka besolwandle, uLwandle oluBomvu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kodwa wabasindisa ngenxa yebizo lakhe,","poem":1},{"text":"ukuze amandla akhe amakhulu aziwe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Walukhuza uLwandle oluBomvu, loma qha;","poem":1},{"text":"wabahola badabula ezinzikini njengasenkangala.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wabasindisa esandleni sesitha;","poem":1},{"text":"wabahlenga esandleni sesitha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amanzi asibekela izitha zabo,","poem":1},{"text":"kakho loyedwa wazo owasindayo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lapho-ke base bezikholwa izithembiso zakhe","poem":1},{"text":"bahlabelela indumiso yakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kodwa baphanga bakukhohlwa lokho ayekwenzile","poem":1},{"text":"kabaze balindela ukweluleka kwakhe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Enkangala bakhulelwa yizinkanuko zabo;","poem":1},{"text":"khona emqothwini bamlinga uNkulunkulu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngakho wabapha lokho abakucelayo,","poem":1},{"text":"kodwa wabathela ngomkhuhlane ocikizayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ezihonqweni basuka babalomhawu loMosi njalo lango-Aroni,","poem":1},{"text":"owayengcwelisiwe kuThixo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Umhlaba wavuleka waginya uDathani;","poem":1},{"text":"wagqibela ixuku lika-Abhiramu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Umlilo walavuza phakathi kwabalandeli babo;","poem":1},{"text":"ilangabi labatshisa ababi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"EHorebhi benza ithole,","poem":1},{"text":"bakhonza isithombe esenziwe ngensimbi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Badela ukuKhazimula kwabo","poem":1},{"text":"bakhetha isithombe senkunzi edla utshani.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bakhohlwa uNkulunkulu owabasindisayo,","poem":1},{"text":"owayenze izinto ezinkulu eGibhithe,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"imimangaliso elizweni likaHamu","poem":1},{"text":"lezenzo ezibabazekayo ngasoLwandle oluBomvu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ngakho wathi uzababhubhisa","poem":1},{"text":"aluba kungesuMosi, owakhethwayo wakhe,","poem":2},{"text":"owema phambi kwakhe","poem":1},{"text":"ukuvalela ulaka lwakhe ukuze angababhubhisi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kwathi njalo baleyisa ilizwe elihle;","poem":1},{"text":"kabasikholwanga isithembiso sakhe.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bakhonona besemathenteni abo","poem":1},{"text":"kabaze bamlalela uThixo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ngakho wafunga kubo ephakamise isandla sakhe","poem":1},{"text":"ukuthi wayezabenza bafele enkangala,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"enze izizukulwane zabo ziqedwe ngabezizwe","poem":1},{"text":"zihlakazeke emazweni wonke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Bazibopha ingathi kusejogweni kuBhali wasePheyori","poem":1},{"text":"badla imihlatshelo eyayinikelwe kubonkulunkulu abangaphiliyo;","poem":2}]},{"type":"verse","number":29,"content":[{"text":"bamthukuthelisa uThixo ngezenzo zabo ezimbi;","poem":1},{"text":"kwavela isifo phakathi kwabo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kodwa uFinehasi wema wancenga","poem":1},{"text":"isifo sadeda.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Lokhu kwenza kuthiwe wayelungile","poem":1},{"text":"kwaziswa izizukulwane zonke ezizayo.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Bamzondisa uThixo ngasemthonjeni weMeribha,","poem":1},{"text":"uhlupho lwase lusehlela uMosi ngenxa yabo;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ngoba bahlamukela uMoya kaNkulunkulu,","poem":1},{"text":"uMosi waze wakhupha amazwi amabi ngezindebe zakhe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Kabababhubhisanga abantu bezizwe","poem":1},{"text":"njengalokhu ababekulaywe nguThixo,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"kodwa baphithikana labezizwe","poem":1},{"text":"bathatha imikhuba yazo.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Bakhonza izithombe zazo,","poem":1},{"text":"kwaba yisifu kubo.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Benza imihlatshelo ngamadodana abo","poem":1},{"text":"lamadodakazi abo emadimonini.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Bachitha igazi elalingelacala,","poem":1},{"text":"igazi lamadodana lamadodakazi abo,","poem":2},{"text":"abenza ngabo imihlatshelo yezithombe zaseKhenani,","poem":1},{"text":"ilizwe langcola ngegazi labo.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Bazingcolisa ngalokho abakwenzayo;","poem":1},{"text":"ngezenzo zabo baziphatha njengeziphingi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Ngakho uThixo wabathukuthelela abantu bakhe","poem":1},{"text":"wanengwa yilifa lakhe.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Wabanikela kwabezizwe,","poem":1},{"text":"izitha zabo zabusa phezu kwabo.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Izitha zabo zabancindezela","poem":1},{"text":"zababeka ngaphansi kwamandla azo.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Izikhathi ezinengi wabakhulula,","poem":1},{"text":"kodwa babezimisele ukuhlamuka","poem":2},{"lineBreak":true},{"text":"bacikizeka ngenxa yesono sabo.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Kodwa wananzelela ukuhlupheka kwabo","poem":1},{"text":"esezwile ukukhala kwabo;","poem":2}]},{"type":"verse","number":45,"content":[{"text":"ngenxa yokubahawukela wakhumbula isivumelwano sakhe,","poem":1},{"text":"kwathi ngothando lwakhe olukhulu wadeda.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Wenza bonke labo ababebathumbile","poem":1},{"text":"ukuthi babelesihawu kubo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Sisindise, Oh Thixo Nkulunkulu wethu,","poem":1},{"text":"usiqoqe usikhulule phakathi kwezizwe,","poem":2},{"text":"ukuze silibonge ibizo lakho elingcwele","poem":1},{"text":"sijabule ekukudumiseni.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"Kabongwe uThixo, uNkulunkulu ka-Israyeli,","poem":1},{"text":"kusukela nini kuze kube nininini.","poem":2},{"lineBreak":true},{"text":"Akuthi bonke abantu bathi, “Ameni!”","poem":1},{"lineBreak":true},{"text":"Dumisani uThixo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}