"wasebakhulula osizini lwabo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wabahola ngendlela eqondileyo","poem":1},{"text":"baya edolobheni lapho ababengahlala khona.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngakho kabambonge uThixo ngothando lwakhe olungaphuthiyo","poem":1},{"text":"lezenzo zakhe ezimangalisayo azenzela abantu,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ngoba ubenza bakholwe abomileyo","poem":1},{"text":"asuthise abalambileyo ngezinto ezinhle.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Abanye bahlala emnyameni lasethunzini elinzima","poem":1},{"text":"beyizibotshwa ezihluphekayo zibotshwe ngamaketane ensimbi,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ngoba babewahlamukele amazwi kaNkulunkulu","poem":1},{"text":"beyisa iseluleko soPhezukonke.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ngakho wabathwalisa umsebenzi onzima;","poem":1},{"text":"bawa kodwa kungekho ongabasiza.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ngakho basebekhala kuThixo besekuhluphekeni kwabo","poem":1},{"text":"wabasindisa osizini lwabo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wabakhupha emnyameni lethunzini elinzima","poem":1},{"text":"waqamula amaketane abo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ngakho kabambonge uThixo ngothando lwakhe olungaphuthiyo","poem":1},{"text":"lezenzo zakhe ezimangalisayo azenzela abantu,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ngoba uyawafohloza amasango ethusi","poem":1},{"text":"ephule imigoqo yensimbi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Abanye baba yiziwula ngenxa yezindlela zabo zokuhlamuka","poem":1},{"text":"badliwa yizinhlupheko ngenxa yokuxhwala kwabo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Benyanya konke ukudla","poem":1},{"text":"balengela emasangweni okufa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bakhala kuThixo besekuhluphekeni kwabo,","poem":1},{"text":"wabasindisa osizini lwabo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wathumela ilizwi lakhe labasilisa;","poem":1},{"text":"wabahlenga engcwabeni.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kabambonge uThixo ngothando lwakhe olungaphuthiyo","poem":1},{"text":"lezenzo zakhe ezimangalisayo ebantwini.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kabenze imihlatshelo yeminikelo yokubonga","poem":1},{"text":"bafakaze ngezenzo zakhe zonke ngezingoma zokuthokoza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Abanye bawela olwandle ngemikhumbi;","poem":1},{"text":"babengabathengisi emanzini abanzi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bayibona imisebenzi kaThixo,","poem":1},{"text":"izenzo zakhe ezimangalisayo ekujuleni.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ngoba wakhuluma kwaqubuka isiphepho","poem":1},{"text":"esasukumisa amagagasi aba laphaya.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Akhwela athinta emazulwini, ehla ayatshona ezinzikini;","poem":1},{"text":"bekuleyongozi isibindi sabo samemetheka saphela.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bazigxobagxoba badiyazela njengabantu abadakiweyo;","poem":1},{"text":"baphelelwa lulwazi.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Basebekhala kuThixo besekuhluphekeni kwabo,","poem":1},{"text":"wabakhupha esizini lwabo.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Wasethulisa isiphepho ngokunyenyeza;","poem":1},{"text":"amagagasi olwandle aphola athi cwaka.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Bajabula bonke sekudedile,","poem":1},{"text":"wabahola wabasa ethekwini ababelifuna.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kabambonge uThixo ngothando lwakhe olungaphuthiyo","poem":1},{"text":"lezenzo zakhe ezimangalisayo ebantwini.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Kabamphakamise emhlanganweni wabantu","poem":1},{"text":"bamdumise enkundleni yabadala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Waguqula imifula yaba yinkangala,","poem":1},{"text":"imithombo egelezayo yaba ngumhlabathi owomileyo,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"lomhlabathi olezithelo waba lugwadule oluletshwayi,","poem":1},{"text":"ngenxa yobubi balabo ababehlala khona.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Waguqula inkangala yaba ngamachibi amanzi","poem":1},{"text":"lomhlabathi owomileyo waba yimithombo egelezayo;","poem":2}]},{"type":"verse","number":36,"content":[{"text":"lapho waletha abalambileyo ukuba bahlale khona,","poem":1},{"text":"khonapho basungula umuzi ababezahlala kuwo.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Bahlanyela amasimu,","poem":1},{"text":"bagxumeka amavini athela isivuno esikhulu;","poem":2}]},{"type":"verse","number":38,"content":[{"text":"wababusisa banda baba banengi kakhulu,","poem":1},{"text":"akaze ayekela imihlambi yabo inciphe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Kwasekusithi ubunengi babo sebunciphile,","poem":1},{"text":"bathotshiswa ngokuncindezelwa, ngokuhlupheka langosizi;","poem":2}]},{"type":"verse","number":40,"content":[{"text":"kwathi yena othela ihlazo ezikhulwini","poem":1},{"text":"wabantulisa egwaduleni olungakhanyi mzila.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Kodwa abaswelayo wabakhupha ekuhluphekeni kwabo","poem":1},{"text":"wandisa izimuli zabo njengemihlambi yezimvu.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Abaqotho bayabona bathokoze,","poem":1},{"text":"kodwa bonke ababi bagcike imilomo yabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Lowo ohlakaniphileyo, kaqaphele lezizinto","poem":1},{"text":"anakane ngothando olukhulu lukaThixo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":43}