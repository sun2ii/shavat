{"translation":{"id":"nde_bib","name":"Biblica® IBhayibhili Elingcwele LesiNdebele Elifinyelelekayo","website":"https://ebible.org/Scriptures/details.php?id=nde","licenseUrl":"https://ebible.org/Scriptures/details.php?id=nde","licenseNotes":null,"shortName":"BIB","englishName":"Ndebele Bible","language":"nde","textDirection":"ltr","sha256":"5e5b383fb620981f6d3e4edddc4dd0fc3982d2e2e71c4fe5321f173de2ce88d6","availableFormats":["json"],"listOfBooksApiLink":"/api/nde_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"isiNdebele","languageEnglishName":"North Ndebele"},"book":{"id":"PSA","translationId":"nde_bib","name":"AmaHubo","commonName":"AmaHubo","title":"AmaHubo","order":19,"numberOfChapters":150,"sha256":"3187d315256105f73abed7fd65524361ca48ec18d113adcb30f363e06a5be158","firstChapterNumber":1,"firstChapterApiLink":"/api/nde_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/nde_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"hebrew_subtitle","content":["Ingoma. Ihubo likaDavida."]},{"type":"verse","number":1,"content":[{"text":"Inhliziyo yami ibambelele, kayiguquki, Oh Nkulunkulu;","poem":1},{"text":"ngizahlabela ngenze iculo elimnandi","poem":2},{"lineBreak":true},{"text":"ngomoya wami wonke.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Vuka, mhubhe lechacho!","poem":1},{"text":"Ngizayivusa intathakusa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngizakudumisa, yebo Thixo, phakathi kwezizwe;","poem":1},{"text":"ngizahlabela ngawe phakathi kwabantu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ngoba lukhulu uthando lwakho, luphakame kulamazulu;","poem":1},{"text":"ukwethembeka kwakho kufinyelela emkhathini.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kawuphakanyiswe, yebo Nkulunkulu, ngaphezu kwamazulu,","poem":1},{"text":"akuthi inkazimulo yakho ibe khona emhlabeni wonke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sisindise usisize ngesandla sakho sokunene,","poem":1},{"text":"ukuze kuthi laba obathandayo bakhululwe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"UNkulunkulu usekhulumile esendlini yakhe engcwele:","poem":1},{"text":"“Ngokunqoba ngizayaba iShekhemu","poem":2},{"lineBreak":true},{"text":"ngihlole leSigodi saseSukhothi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ngeyami iGiliyadi, loManase ngowami;","poem":1},{"text":"u-Efrayimi yisivikelo sekhanda lami,","poem":2},{"lineBreak":true},{"text":"uJuda uyintonga yami yobukhosi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"IMowabi ngumganu wami wokugezela,","poem":1},{"text":"phezu kuka-Edomi ngiphosela amanyathelo ami;","poem":2},{"lineBreak":true},{"text":"phezu kweFilistiya ngihalalisa umkhosi wokunqoba.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ngubani ozangisa emzini olenqaba na?","poem":1},{"text":"Ngubani ozangiholela e-Edomi na?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kakusuwe na, Oh Nkulunkulu, wena osusikhalele,","poem":1},{"text":"ongasaphumi lathi ezimpini zethu?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ake usisize ezitheni zethu,","poem":1},{"text":"ngoba usizo lomuntu luyize.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nxa siloNkulunkulu sizanqoba,","poem":1},{"text":"njalo uzazinyathelela phansi izitha zethu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/nde_bib/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/nde_bib/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/nde_bib/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}